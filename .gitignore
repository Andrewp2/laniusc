/target
**/target/
/fuzz-cases
.VSCodeCounter/
/traces/
__pycache__/
*.pyc
node_modules/
tools/perf-viewer/public/performance-data.js

# Generated benchmark workspaces and derived indexes. Canonical, reviewable
# measurements live in benchmark_artifacts/performance/*.json.
benchmark_artifacts/compile_performance_*/
benchmark_artifacts/performance/catalog.json
benchmark_artifacts/performance-viewer/

# Reproducible benchmark intermediates. Keep compact results, manifests,
# machine information, summaries, and visualizations under benchmark_artifacts/.
benchmark_artifacts/**/bin/
benchmark_artifacts/**/sources/
benchmark_artifacts/**/*.ngfx-gputrace
benchmark_artifacts/**/BASE_UNLOCKED/EVENT_METRICS.*
benchmark_artifacts/**/BASE_UNLOCKED/FRAME_METRICS.*
benchmark_artifacts/**/BASE_UNLOCKED/PASS_METRICS.*
benchmark_artifacts/**/BASE_UNLOCKED/GPUTRACE_REGIMES.*
benchmark_artifacts/profiles/cpu_profiles/**/benchmark
benchmark_artifacts/profiles/cpu_profiles/**/benchmark-warm-only
