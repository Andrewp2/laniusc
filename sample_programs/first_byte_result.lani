// Read one byte into caller storage and report its value, or -1 at EOF.
module app::main;
import core::mem;
import core::option;
import core::result;
import std::io_byte;

fn read_first(destination: ptr) -> core::result::Result<ptr, i32> {
    let byte: i32 = std::io_byte::read_stdin_byte_or(-1, -2);
    if (byte < 0) { return core::result::Err(byte); }
    let cells: [i32] = core::mem::i32_slice_from_raw_parts(destination, 1);
    cells[0] = byte;
    return core::result::Ok(destination);
}

fn main() -> i32 {
    let storage: [i32; 1] = [0];
    let destination: ptr = core::mem::i32_array_data_ptr(storage);
    let read: core::result::Result<ptr, i32> = read_first(destination);
    let address: core::option::Option<ptr> = core::option::ok(read);
    if (core::option::is_some(address)) {
        let pointer: ptr = core::option::unwrap_or(address, destination);
        let cells: [i32] = core::mem::i32_slice_from_raw_parts(pointer, 1);
        print(cells[0]);
        return 0;
    }
    let error: core::option::Option<i32> = core::option::err(read);
    if (core::option::unwrap_or(error, -2) == -1) {
        print(-1);
        return 0;
    }
    return 2;
}
