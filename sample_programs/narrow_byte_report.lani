// Read one signed decimal value and report its explicit byte conversions.
// At most 12 input bytes; surrounding ASCII space, tab, CR and LF are accepted.
module app::main;
import core::option;
import core::u8;
import core::decimal;
import core::mem;
import core::result;
import std::io;

fn main() -> i32 {
    let data: [u8;12] = [0;12]; let cell: [i32;1] = [0];
    let count: i32 = 0;
    while (true) {
        cell[0] = 0;
        let received: i32 = std::io::read_stdin(core::mem::i32_array_data_ptr(cell),1);
        if (received == 0) { break; }
        if (received != 1 || count == 12) { return 2; }
        data[count] = cell[0] as u8; count += 1;
    }
    let start: i32 = 0; let end: i32 = count;
    while (start < end && (data[start] == 32 || data[start] == 9 || data[start] == 10 || data[start] == 13)) { start += 1; }
    while (end > start && (data[end-1] == 32 || data[end-1] == 9 || data[end-1] == 10 || data[end-1] == 13)) { end -= 1; }
    let parsed: core::result::Result<i32,core::decimal::ParseError> = core::decimal::parse_i32_range(data,start,end-start);
    if (core::result::is_err(parsed)) { return 2; }
    let value: i32 = core::result::unwrap(parsed);
    let wrapped: u8 = core::u8::wrapping_from_i32(value);
    let saturated: u8 = core::u8::saturating_from_i32(value);
    let checked: u8 = core::option::unwrap_or(core::u8::checked_from_i32(value), 17);
    let total: u8 = core::u8::wrapping_add(wrapped, checked);
    let wrapped_i32: i32 = wrapped as i32;
    let saturated_i32: i32 = saturated as i32;
    let total_i32: i32 = total as i32;
    print(wrapped_i32);
    print(saturated_i32);
    print(total_i32);
    return 0;
}
