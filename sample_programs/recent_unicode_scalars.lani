// Print the last three valid UTF-8 scalars received on stdin.
// A malformed sequence returns 2, host input error 3, allocation or
// output failure 4. Empty input writes one newline.
module app::main;
import core::char;
import alloc::deque;
import core::result;
import std::io_utf8;

fn main() -> i32 {
    let made: core::result::Result<alloc::deque::Deque<char>, alloc::deque::Error> = alloc::deque::with_capacity(3);
    if (core::result::is_err(made)) { return 4; }
    let recent: alloc::deque::Deque<char> = core::result::unwrap(made);
    while (true) {
        let code: u32 = std::io_utf8::read_stdin_scalar_or(1114112, 1114113, 1114114);
        if (code == 1114112) { break; }
        if (code == 1114113) {
            recent.destroy();
            return 2;
        }
        if (code == 1114114) {
            recent.destroy();
            return 3;
        }
        if (recent.len() == 3) {
            recent.pop_front();
        }
        // The reader returns only scalar values below its sentinels.
        let scalar: char = core::char::from_u32_or(code, '\0');
        let added: core::result::Result<i32, alloc::deque::Error> = recent.try_push_back(scalar);
        if (core::result::is_err(added)) {
            recent.destroy();
            return 4;
        }
    }
    let index: i32 = 0;
    while (index < recent.len()) {
        let scalar: char = recent.get_or(index, '\0');
        let code: u32 = scalar as u32;
        if (!std::io_utf8::write_stdout_scalar(code)) {
            recent.destroy();
            return 4;
        }
        index += 1;
    }
    recent.destroy();
    if (!std::io_utf8::write_stdout_scalar(10)) { return 4; }
    return 0;
}
