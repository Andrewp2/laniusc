module app::main;
import core::u8;
import core::mem;
import core::i32;
import core::range;
import core::slice;
fn main() -> i32 {
    // A packet marker must be one ASCII hex digit before its readings count.
    let marker: u8 = 70;
    if (!core::u8::is_ascii_hexdigit(marker)) {
        return 1;
    }
    let readings:[i32; 4] =[18, 42, 24, 30];
    let sorted:[i32; 4] =[0, 0, 0, 0];
    let readings_view:[i32] = core::mem::i32_slice_from_raw_parts(core::mem::i32_array_data_ptr(readings), 4);
    let view:[i32] = core::mem::i32_slice_from_raw_parts(core::mem::i32_array_data_ptr(sorted), 4);
    if (!core::slice::copy_nonoverlapping_range(view, 4, 0, readings_view, 4, 0, 4)) {
        return 2;
    }
    if (core::slice::sort(view, 4) != 4 || !core::slice::is_sorted(view, 4)) {
        return 3;
    }
    let first: i32 = core::slice::lower_bound(view, 4, 24);
    let end: i32 = core::slice::upper_bound(view, 4, 42);
    let window: core::range::Range<i32> = core::range::range(first, end);
    let index: i32 = 0;
    let checksum: i32 = 0;
    while (index<4) {
        if (core::range::contains(window, index)) {
            let reading: i32 = core::slice::get_or(view, 4, index, 0);
            checksum = core::i32::saturating_add(checksum, reading);
        }
        index += 1;
    }
    print(checksum);
    return 0;
}
