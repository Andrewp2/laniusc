// Read signed decimal lines and print values and wrapping counts in first-seen order.
// Allocation errors release both owners and return 4 before emitting a report.
module app::main;
import alloc::tree_map;
import alloc::vec;
import core::i64;
import core::decimal;
import core::option;
import core::result;
import std::io_byte;
import std::io_decimal;
import std::io_line;
import std::signal;

fn main() -> i32 {
    if (std::signal::set_disposition(std::signal::Signal::BrokenPipe,std::signal::Disposition::Ignore).is_err()) { return 5; }
    let data: [i32; 20] = [0; 20]; let packed: [u8;20] = [0;20];
    let counts: alloc::tree_map::TreeMap<i64, i64> = alloc::tree_map::new();
    let order: alloc::vec::Vec<i64> = alloc::vec::new();
    let zero: i64 = 0;
    let one: i64 = 1;
    while (true) {
        let length: i32 = std::io_line::read_stdin_lf_line_into_i32(data, 20);
        if (length == -1) { break; }
        if (length <= 0) { counts.destroy(); order.destroy(); return 2; }
        let index: i32 = 0; while (index < length) { packed[index] = data[index] as u8; index += 1; }
        let parsed: core::result::Result<i64,core::decimal::ParseError> = core::decimal::parse_i64(packed,length);
        if (core::result::is_err(parsed)) { counts.destroy(); order.destroy(); return 3; }
        let key: i64 = core::result::unwrap(parsed);
        let previous: i64 = core::option::unwrap_or(counts.get(key), zero);
        let next: i64 = core::i64::wrapping_add(previous, one);
        if (!counts.contains_key(key)) {
            if (core::result::is_err(order.try_push(key))) { counts.destroy(); order.destroy(); return 4; }
        }
        if (core::result::is_err(counts.try_insert(key, next))) { counts.destroy(); order.destroy(); return 4; }
    }
    let index: i32 = 0;
    while (index < order.len()) {
        let key: i64 = order.at(index);
        let amount: i64 = core::option::unwrap(counts.get(key));
        if (std::io_decimal::write_i64(1, key) <= 0 || !std::io_byte::write_stdout_byte(32) ||
            std::io_decimal::write_i64(1, amount) <= 0 || !std::io_byte::write_stdout_byte(10)) {
            counts.destroy(); order.destroy(); return 5;
        }
        index += 1;
    }
    counts.destroy(); order.destroy(); return 0;
}
