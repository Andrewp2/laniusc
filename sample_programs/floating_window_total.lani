module app::main;
import core::f32;
import core::float_order;
import core::option;
import core::range;
import core::slice;

fn main() -> i32 {
    let readings: [f32; 3] = [3.0, 1.5, 2.5];
    let keys: [core::float_order::TotalF32; 3] = [core::float_order::from_f32(readings[0]), core::float_order::from_f32(readings[1]), core::float_order::from_f32(readings[2])];
    if (core::slice::sort(keys, 3) != 3 ||
        core::slice::binary_search_first_or(keys, 3, core::float_order::from_f32(2.5), -1) != 1) {
        return 1;
    }
    let raw_total: f32 = core::slice::sum(readings, 3, 0.0);
    let acceptable: core::range::RangeInclusive<f32> =
        core::range::range_inclusive(0.0, 100.0);
    if (!core::f32::is_finite(raw_total) ||
        !acceptable.contains(raw_total)) { return 3; }
    let bounded: f32 = core::f32::clamp_or(raw_total, 0.0, 100.0, -1.0);
    let result: core::option::Option<f32> = core::option::Some(bounded);
    let total: f32 = core::option::unwrap_or(result, -1.0);
    if (total != 7.0) { return 2; }
    let matched_index: i32 = core::slice::binary_search_last_or(keys, 3, core::float_order::from_f32(3.0), -1);
    print(matched_index);
    return 0;
}
