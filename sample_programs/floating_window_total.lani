module app::main;
import core::f32;
import core::option_f32;
import core::slice_f32;

fn main() -> i32 {
    let readings: [f32; 3] = [3.0, 1.5, 2.5];
    if (!core::slice_f32::sort_finite(readings, 3) ||
        core::slice_f32::binary_search_first_finite_or(readings, 3, 2.5, -1) != 1) {
        return 1;
    }
    let raw_total: f32 = core::slice_f32::sum_or(readings, 3, -1.0);
    if (!core::f32::is_finite(raw_total)) { return 3; }
    let bounded: f32 = core::f32::clamp_or(raw_total, 0.0, 100.0, -1.0);
    let result: core::option_f32::OptionF32 = core::option_f32::some(bounded);
    let total: f32 = core::option_f32::unwrap_or(result, -1.0);
    if (total != 7.0) { return 2; }
    let matched_index: i32 = core::slice_f32::binary_search_last_finite_or(readings, 3, 3.0, -1);
    print(matched_index);
    return 0;
}
