module app::main;
import core::byte;
import core::number_u32;
import core::range;
import core::slice_u8;

fn main() -> i32 {
    // The payload of this seven-byte packet is four hexadecimal digits.
    let l: u8 = 76;
    let n: u8 = 78;
    let colon: u8 = 58;
    let one: u8 = 49;
    let a: u8 = 65;
    let two: u8 = 50;
    let f: u8 = 70;
    let packet: [u8; 7] = [l, n, colon, one, a, two, f];
    let header: [u8; 3] = [l, n, colon];
    if (!core::slice_u8::starts_with(packet, 7, header, 3)) {
        return 1;
    }
    let payload: core::range::Range<i32> = core::range::range_i32(3, 7);
    let index: i32 = 0;
    let checksum: u32 = 0;
    while (index < 7) {
        if (core::range::contains_i32(payload, index)) {
            let ascii: u8 = core::slice_u8::get_or(packet, 7, index, 0);
            if (!core::byte::is_ascii_hexdigit(ascii)) {
                return 2;
            }
            let digit: u8 = core::byte::ascii_hexdigit_value_or(ascii, 0);
            checksum = core::number_u32::saturating_add(checksum, digit as u32);
        }
        index += 1;
    }
    print(checksum as i32);
    return 0;
}
