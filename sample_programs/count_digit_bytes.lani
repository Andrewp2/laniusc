// Print the number of ASCII digit bytes, then all other bytes, from stdin.
module app::main;
import core::u8;
import std::io;
import std::io_byte;
import std::io_decimal;

fn main() -> i32 {
    let digits: u32 = 0;
    let others: u32 = 0;
    while (true) {
        let code: i32 = std::io_byte::read_stdin_byte_or(-1, -2);
        if (code == -1) { break; }
        if (code == -2) { return 2; }
        if (core::u8::is_ascii_digit(code as u8)) {
            if (digits == 4294967295) { return 3; }
            digits += 1;
        } else {
            if (others == 4294967295) { return 3; }
            others += 1;
        }
    }
    if (std::io_decimal::write_u32(1, digits) < 0 || std::io::write_byte(1, 10) != 1 ||
        std::io_decimal::write_u32(1, others) < 0 || std::io::write_byte(1, 10) != 1) { return 4; }
    return 0;
}
