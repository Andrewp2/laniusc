module app::main;
import core::number_i8;
import core::option_i8;
import std::vec;

fn main() -> i32 {
    let values: std::vec::Vec<i8> = std::vec::new();
    values = std::vec::try_push(values, -128);
    values = std::vec::try_push(values, 2);
    values = std::vec::try_push(values, 127);
    if (std::vec::len(values) != 3) {
        std::vec::destroy(values);
        return 1;
    }

    let checksum: i8 = 0;
    let index: i32 = 0;
    while (index < std::vec::len(values)) {
        checksum = core::number_i8::wrapping_add(
            checksum, std::vec::get_or(values, index, 0));
        index += 1;
    }
    std::vec::destroy(values);
    let result: core::option_i8::OptionI8 = core::option_i8::some(checksum);
    let byte_result: i8 = core::option_i8::unwrap_or(result, 0);
    let printable: i32 = byte_result as i32;
    print(printable);
    return 0;
}
