module app::main;
import core::number_i16;
import core::option;
import std::vec;

fn main() -> i32 {
    let values: std::vec::Vec<i16> = std::vec::new();
    values = std::vec::try_push(values, -32768);
    values = std::vec::try_push(values, 2);
    values = std::vec::try_push(values, 32767);
    if (std::vec::len(values) != 3) {
        std::vec::destroy(values);
        return 1;
    }

    let checksum: i16 = 0;
    let index: i32 = 0;
    while (index < std::vec::len(values)) {
        checksum = core::number_i16::wrapping_add(
            checksum, std::vec::get_or(values, index, 0));
        index += 1;
    }
    std::vec::destroy(values);
    let result: core::option::Option<i16> = core::option::Some(checksum);
    let byte_result: i16 = core::option::unwrap_or(result, 0);
    let printable: i32 = byte_result as i32;
    print(printable);
    return 0;
}
