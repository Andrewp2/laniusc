module app::main;
import core::number_i16;
import core::option_i16;
import std::vec_i16;

fn main() -> i32 {
    let values: std::vec_i16::VecI16 = std::vec_i16::new();
    values = std::vec_i16::try_push(values, -32768);
    values = std::vec_i16::try_push(values, 2);
    values = std::vec_i16::try_push(values, 32767);
    if (std::vec_i16::len(values) != 3) {
        std::vec_i16::destroy(values);
        return 1;
    }

    let checksum: i16 = 0;
    let index: i32 = 0;
    while (index < std::vec_i16::len(values)) {
        checksum = core::number_i16::wrapping_add(
            checksum, std::vec_i16::get_or(values, index, 0));
        index += 1;
    }
    std::vec_i16::destroy(values);
    let result: core::option_i16::OptionI16 = core::option_i16::some(checksum);
    let byte_result: i16 = core::option_i16::unwrap_or(result, 0);
    let printable: i32 = byte_result as i32;
    print(printable);
    return 0;
}
