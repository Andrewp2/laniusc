// Maintain a small ordered sequence and report its checksum after two edits.
module app::main;
import core::number_i32;
import core::option;
import std::io;
import std::vec;

fn main() -> i32 {
    let readings: std::vec::Vec<i32> = std::vec::new();
    let initial: [i32; 3] = [3, 7, 11];
    readings = std::vec::try_extend_from_slice(readings, initial, 3);
    if (std::vec::len(readings) != 3) {
        std::vec::destroy(readings);
        return 1;
    }
    readings = std::vec::try_insert(readings, 1, 5);
    if (std::vec::len(readings) != 4) {
        std::vec::destroy(readings);
        return 2;
    }
    readings = std::vec::try_remove(readings, 2);
    if (std::vec::len(readings) != 3) {
        std::vec::destroy(readings);
        return 3;
    }
    let total: i32 = 0;
    let index: i32 = 0;
    while (index < std::vec::len(readings)) {
        total = core::number_i32::saturating_add(
            total, std::vec::get_or(readings, index, 0));
        index += 1;
    }
    std::vec::destroy(readings);
    let result: core::option::Option<i32> = core::option::Some(total);
    std::io::print_i32(core::option::unwrap_or(result, -1));
    return 0;
}
