// Compile with --source-root extended --stdlib-root stdlib.
// Read UTF-8 CSV from stdin and emit quoted fields with CRLF record endings.
module app::main;
import alloc::string;
import alloc::io;
import core::io;
import core::result;
import ext::csv;
import std::io;
import std::stream;

fn normalize(input: alloc::string::String) -> i32 {
    let options: ext::csv::Options = ext::csv::default_options();
    let parsed: core::result::Result<ext::csv::Table, ext::csv::Error> = ext::csv::parse(input, options);
    return match (parsed) { Ok(table) -> write_table(table), Err(error) -> csv_error(error) };
}

fn csv_error(error: ext::csv::Error) -> i32 {
    let allocation: bool = match (error) { ext::csv::Error::AllocationFailed -> true, _ -> false };
    if (allocation) { std::io::eprintln("allocation failed"); return 4; }
    std::io::eprintln("invalid CSV input");
    return 2;
}

fn write_table(table: ext::csv::Table) -> i32 {
    let encoded: core::result::Result<alloc::string::String, ext::csv::Error> = ext::csv::encode(table);
    table.destroy();
    return match (encoded) { Ok(text) -> write_text(text), Err(error) -> csv_error(error) };
}

fn write_text(text: alloc::string::String) -> i32 {
    let bytes: [u8] = text.as_bytes();
    let output: std::stream::Descriptor = std::stream::stdout();
    let written: core::result::Result<i32, core::io::Failure> = core::io::write_all(output.borrow(), bytes, 0, text.byte_len());
    text.destroy();
    if (core::result::is_err(written)) { return 3; }
    return 0;
}

fn main() -> i32 {
    let input: alloc::io::Buffer = alloc::io::new();
    let source: std::stream::Descriptor = std::stream::stdin();
    let received: core::result::Result<u64, core::io::CopyFailure> = std::stream::copy(source.borrow(), input.borrow());
    if (core::result::is_err(received)) {
        let failure: core::io::CopyFailure = core::result::unwrap_err(received);
        input.destroy();
        return input_error(failure.cause);
    }
    let bytes: [u8] = input.as_bytes();
    let decoded: core::result::Result<alloc::string::String, alloc::string::Error> =
        alloc::string::from_utf8(bytes, input.len());
    input.destroy();
    return match (decoded) { Ok(text) -> finish(text), Err(error) -> invalid_text(error) };
}

fn input_error(error: core::io::Error) -> i32 {
    let capacity: bool = match (error) { core::io::Error::AllocationFailed -> true, core::io::Error::LimitExceeded -> true, _ -> false };
    if (capacity) { std::io::eprintln("allocation failed"); return 4; }
    return 3;
}

fn finish(text: alloc::string::String) -> i32 {
    let result: i32 = normalize(text);
    text.destroy();
    return result;
}

fn invalid_text(error: alloc::string::Error) -> i32 {
    let allocation: bool = match (error) { alloc::string::Error::AllocationFailed -> true, _ -> false };
    if (allocation) { std::io::eprintln("allocation failed"); return 4; }
    std::io::eprintln("invalid UTF-8 input");
    return 2;
}
