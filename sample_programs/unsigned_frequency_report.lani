// Count repeated unsigned readings, including values above i32::MAX.
module app::main;
import core::number_u32;
import std::io;
import std::io_decimal;
import std::map_u32_u32;

fn main() -> i32 {
    let high: u32 = 2147483648;
    let one: u32 = 1;
    let maximum: u32 = 4294967295;
    let readings: [u32; 6] = [high, one, high, maximum, one, high];
    let counts: std::map_u32_u32::MapU32U32 = std::map_u32_u32::new();
    let index: i32 = 0;
    while (index < 6) {
        let key: u32 = readings[index];
        if (std::map_u32_u32::contains_key(counts, key)) {
            let prior: u32 = std::map_u32_u32::get_or(counts, key, 0);
            let next: u32 = core::number_u32::wrapping_add(prior, 1);
            if (!std::map_u32_u32::try_set(counts, key, next)) {
                std::map_u32_u32::destroy(counts);
                return 1;
            }
        } else {
            let before: i32 = std::map_u32_u32::len(counts);
            counts = std::map_u32_u32::try_insert(counts, key, 1);
            if (std::map_u32_u32::len(counts) != before + 1) {
                std::map_u32_u32::destroy(counts);
                return 2;
            }
        }
        index += 1;
    }
    let high_count: u32 = std::map_u32_u32::get_or(counts, high, 0);
    let one_count: u32 = std::map_u32_u32::get_or(counts, one, 0);
    let max_count: u32 = std::map_u32_u32::get_or(counts, maximum, 0);
    std::map_u32_u32::destroy(counts);
    if (std::io_decimal::write_u32(1, high_count) < 0 || std::io::write_byte(1, 32) != 1 ||
        std::io_decimal::write_u32(1, one_count) < 0 || std::io::write_byte(1, 32) != 1 ||
        std::io_decimal::write_u32(1, max_count) < 0 || std::io::write_byte(1, 10) != 1) {
        return 3;
    }
    return 0;
}
