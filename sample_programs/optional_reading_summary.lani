// A caller-owned view is summarized into an optional record without allocation.
module app::main;
import core::option;
import core::slice;
import core::range;
import core::number_i32;

struct Summary { count: i32, total: i32 }

fn summarize(values: [i32], len: i32) -> core::option::Option<Summary> {
    if (len <= 0) {
        let absent: core::option::Option<Summary> = core::option::None();
        return absent;
    }
    let allowed: core::range::Range<i32> = core::range::range_i32(-100, 101);
    let total: i32 = 0;
    let index: i32 = 0;
    while (index < len) {
        let value: i32 = core::slice::get_or(values, len, index, 0);
        if (!core::range::contains_i32(allowed, value)) {
            let absent: core::option::Option<Summary> = core::option::None();
            return absent;
        }
        total = core::number_i32::saturating_add(total, value);
        index += 1;
    }
    let summary: Summary = Summary { count: len, total: total };
    let present: core::option::Option<Summary> = core::option::Some(summary);
    return present;
}

fn main() -> i32 {
    let readings: [i32; 4] = [7, -2, 11, 4];
    let optional: core::option::Option<Summary> = summarize(readings, 4);
    if (!optional.is_some()) { return 1; }
    let empty: core::option::Option<Summary> = summarize(readings, 0);
    if (!empty.is_none()) { return 2; }
    let fallback: Summary = Summary { count: 0, total: 0 };
    let summary: Summary = match (optional) {
        core::option::Some(inner) -> inner,
        core::option::None -> fallback,
    };
    print(summary.count);
    print(summary.total);
    return 0;
}
