// Sum distinct signed decimal lines modulo 2^64.
// Each line contains one integer without surrounding whitespace.
module app::main;
import alloc::tree_set;
import core::i64;
import core::decimal;
import core::result;
import std::io_byte;
import std::io_decimal;
import std::io_line;
import std::signal;

fn main() -> i32 {
    if (std::signal::set_disposition(std::signal::Signal::BrokenPipe,std::signal::Disposition::Ignore).is_err()) { return 5; }
    let data: [i32; 20] = [0; 20]; let packed: [u8;20] = [0;20];
    let values: alloc::tree_set::TreeSet<i64> = alloc::tree_set::new();
    let total: i64 = 0;
    while (true) {
        let length: i32 = std::io_line::read_stdin_lf_line_into_i32(data, 20);
        if (length == -1) { break; }
        if (length <= 0) { values.destroy(); return 2; }
        let index: i32 = 0; while (index < length) { packed[index] = data[index] as u8; index += 1; }
        let parsed: core::result::Result<i64,core::decimal::ParseError> = core::decimal::parse_i64(packed,length);
        if (core::result::is_err(parsed)) { values.destroy(); return 3; }
        let value: i64 = core::result::unwrap(parsed);
        if (!values.contains(value)) {
            if (core::result::is_err(values.try_insert(value))) { values.destroy(); return 4; }
            total = core::i64::wrapping_add(total, value);
        }
    }
    values.destroy();
    if (std::io_decimal::write_i64(1, total) <= 0 || !std::io_byte::write_stdout_byte(10)) { return 5; }
    return 0;
}
