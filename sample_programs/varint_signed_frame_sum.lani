// Encode and decode signed telemetry, then print the full-width sum.
module app::main;
import core::varint;
import core::varint_wide_u64;
import core::varint_wide_i64;
import core::wide_i64;
import std::io_byte;
import std::io_decimal;

fn main() -> i32 {
    let b0: u8 = 0;
    let frame: [u8; 16] = [b0, b0, b0, b0, b0, b0, b0, b0,
        b0, b0, b0, b0, b0, b0, b0, b0];
    let end: i32 = core::varint::write_u32(frame, 16, 0, 3);
    end = core::varint_wide_i64::write_wide_i64(
        frame, 16, end, core::wide_i64::from_i32(-50));
    end = core::varint_wide_i64::write_wide_i64(
        frame, 16, end, core::wide_i64::from_i32(25));
    end = core::varint_wide_i64::write_wide_i64(
        frame, 16, end, core::wide_i64::from_words(4294967295, 0));
    if (end != 8) { return 1; }

    let header: core::varint::ReadU32 = core::varint::read_u32(frame, end, 0);
    if (core::varint::status_u32(header) != core::varint::OK ||
        core::varint::value_u32_or(header, 0) != 3) { return 2; }
    let position: i32 = core::varint::next_u32_or(header, -1);
    let total: core::wide_i64::WideI64 = core::wide_i64::zero();
    let count: i32 = 0;
    while (count < 3) {
        let item: core::varint_wide_u64::ReadWideU64 =
            core::varint_wide_i64::read_wide_i64(frame, end, position);
        if (core::varint_wide_u64::status_wide_u64(item) != core::varint::OK) { return 3; }
        total = core::wide_i64::wrapping_add(total,
            core::varint_wide_i64::value_wide_i64_or(item, core::wide_i64::zero()));
        position = core::varint_wide_u64::next_wide_u64_or(item, -1);
        count += 1;
    }
    if (position != end ||
        std::io_decimal::write_wide_i64(1, total) != 11 ||
        !std::io_byte::write_stdout_byte(10)) { return 4; }
    return 0;
}
