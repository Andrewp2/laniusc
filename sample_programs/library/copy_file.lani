// Bounded regular-file copy through the real descriptor library.
// Admitted x86_64 Linux ELF through the GPU compiler; see docs/stdlib-copy-file.md.
module app::main;
import core::decimal;
import core::io;
import core::mem;
import core::option;
import core::path;
import core::result;
import core::slice;
import std::args;
import std::file;
import std::file_copy;
import std::file_ops;

// close retires ownership before its single host attempt. A close failure
// overrides the earlier status, including a quota failure, and is not retried.
fn close_status(file: &std::file::File, status: i32) -> i32 {
    let closed: core::result::Result<i32,core::io::Error> = file.close();
    if (closed.is_err()) { return 3; }
    return status;
}

fn copy_paths(source_path: core::path::Path, destination_path: core::path::Path,
    max_bytes: u64) -> i32 {
    // 1,024 packed bytes backed by stack storage, with no copy allocation.
    let storage: [i32;256] = [0;256];
    let bytes: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(storage),1024);
    let scratch_result: core::result::Result<core::slice::View<u8>,core::slice::ViewError> = core::slice::view(bytes,1024);
    if (scratch_result.is_err()) { return 3; }
    let scratch: core::slice::View<u8> = scratch_result.unwrap();

    // Nonblocking opens avoid waiting for a FIFO peer. The copy operation
    // checks both opened descriptors are regular files before any truncation.
    let source_options: std::file_ops::OpenOptions = std::file_ops::options();
    source_options.access = std::file_ops::Access::Read;
    source_options.no_follow = true;
    source_options.nonblocking = true;
    source_options.close_on_exec = true;
    let opened_source: core::result::Result<std::file::File,core::io::Error> = std::file_ops::open(source_path,source_options);
    if (opened_source.is_err()) { return 3; }
    let source: std::file::File = opened_source.unwrap();

    let destination_options: std::file_ops::OpenOptions = std::file_ops::options();
    destination_options.access = std::file_ops::Access::Write;
    destination_options.create = true;
    destination_options.truncate = false;
    destination_options.no_follow = true;
    destination_options.nonblocking = true;
    destination_options.close_on_exec = true;
    destination_options.mode = 438; // 0666, filtered by the process umask.
    let opened_destination: core::result::Result<std::file::File,core::io::Error> = std::file_ops::open(destination_path,destination_options);
    if (opened_destination.is_err()) { return close_status(source.borrow(),3); }
    let destination: std::file::File = opened_destination.unwrap();

    let copied: core::result::Result<u64,core::io::CopyFailure> = std::file_copy::copy_regular(source.borrow(),destination.borrow(),scratch,max_bytes);
    let status: i32 = 0;
    if (copied.is_err()) {
        let failure: core::io::CopyFailure = copied.unwrap_err();
        status = match (failure.cause) { core::io::Error::LimitExceeded -> 5, _ -> 3 };
    }
    let destination_status: i32 = close_status(destination.borrow(),status);
    return close_status(source.borrow(),destination_status);
}

// A shallow, read-only argument handle. Main keeps its sole active allocation
// owner and destroys it after every processing result, including open errors.
fn process(arguments: std::args::Arguments) -> i32 {
    if (arguments.len() != 3) { return 2; }
    let first: core::option::Option<core::slice::View<u8>> = arguments.get(0);
    let second: core::option::Option<core::slice::View<u8>> = arguments.get(1);
    let third: core::option::Option<core::slice::View<u8>> = arguments.get(2);
    let source_text: core::slice::View<u8> = first.unwrap();
    let destination_text: core::slice::View<u8> = second.unwrap();
    let limit_text: core::slice::View<u8> = third.unwrap();
    if (source_text.len() <= 0 || source_text.len() > 4095
        || destination_text.len() <= 0 || destination_text.len() > 4095) { return 2; }
    let source_path: core::result::Result<core::path::Path,core::path::Error> = core::path::from_view(source_text);
    let destination_path: core::result::Result<core::path::Path,core::path::Error> = core::path::from_view(destination_text);
    let parsed_limit: core::result::Result<u64,core::decimal::ParseError> = core::decimal::parse_u64_range(limit_text.values,limit_text.start,limit_text.length);
    if (source_path.is_err() || destination_path.is_err() || parsed_limit.is_err()) { return 2; }
    let max_bytes: u64 = parsed_limit.unwrap();
    if (max_bytes > 9223372036854775807) { return 2; }
    return copy_paths(source_path.unwrap(),destination_path.unwrap(),max_bytes);
}

fn main() -> i32 {
    // Exclude argv[0]. Limits count raw bytes without their terminating NULs.
    let captured: core::result::Result<std::args::Arguments,std::args::Error> = std::args::snapshot(1,3,8210);
    if (captured.is_err()) {
        return match (captured.unwrap_err()) { std::args::Error::AllocationFailed -> 4, std::args::Error::HostRead(index) -> 3, _ -> 2 };
    }
    let arguments: std::args::Arguments = captured.unwrap();
    let status: i32 = process(arguments);
    arguments.destroy();
    return status;
}
