struct Options { first: i32, clear: bool, append: bool, status: bool, help: bool, sigpipe: std::command::ChildSigpipe, cwd: core::option::Option<core::slice::View<u8>>, input: core::option::Option<core::slice::View<u8>>, output: core::option::Option<core::slice::View<u8>>, error: core::option::Option<core::slice::View<u8>>, entries: alloc::vec::Vec<core::slice::View<u8>> }
