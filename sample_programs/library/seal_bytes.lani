// Bounded authenticated binary envelope using real ChaCha20-Poly1305.
// Accepted native execution evidence: docs/extended-seal-bytes.md.
module app::main;
import alloc::io;
import alloc::vec;
import core::io;
import core::mem;
import core::path;
import core::result;
import core::slice;
import ext::chacha20_poly1305;
import std::args;
import std::file;
import std::file_ops;
import std::signal;
import std::stream;

const MAX_PAYLOAD: i32 = 1048576;
struct Budget { remaining: i32 }
impl Budget {
    fn borrow(&self) -> &Budget { return self; }
    fn charge(&self) -> bool { if (self.remaining == 0) { return false; } self.remaining -= 1; return true; }
}
fn io_status(error: core::io::Error) -> i32 {
    return match (error) { core::io::Error::AllocationFailed -> 4, core::io::Error::LimitExceeded -> 7, _ -> 3 };
}
fn same(value: core::slice::View<u8>, literal: str, count: i32) -> bool {
    if (value.length != count) { return false; }
    let expected: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::string_data_ptr(literal),count);
    let index: i32 = 0;
    while (index < count) { if (value.values[value.start+index] != expected[index]) { return false; } index += 1; }
    return true;
}
fn nibble(value: u8) -> i32 {
    if (value >= 48 && value <= 57) { return (value-48) as i32; }
    if (value >= 65 && value <= 70) { return (value-55) as i32; }
    if (value >= 97 && value <= 102) { return (value-87) as i32; }
    return -1;
}
fn decode(value: core::slice::View<u8>, output: core::slice::View<u8>) -> bool {
    if (value.length % 2 != 0 || value.length/2 > output.length) { return false; }
    let index: i32 = 0;
    while (index < value.length/2) {
        let high: i32 = nibble(value.values[value.start+index*2]);
        let low: i32 = nibble(value.values[value.start+index*2+1]);
        if (high < 0 || low < 0) { return false; }
        output.values[output.start+index] = (high*16+low) as u8;
        index += 1;
    }
    return true;
}

fn key_contents(file: &std::file::File, key: [u8], budget: &Budget) -> i32 {
    let completed: i32 = 0;
    while (completed < 32) {
        if (!budget.charge()) { return 7; }
        let read: core::result::Result<i32,core::io::Error> = file.read(key,completed,32-completed);
        if (read.is_err()) { if (core::io::is_interrupted(read.unwrap_err())) { continue; } return 3; }
        let count: i32 = read.unwrap();
        if (count < 0 || count > 32-completed) { return 3; }
        if (count == 0) { return 2; }
        completed += count;
    }
    let storage: [i32;1] = [0];
    let probe: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(storage),1);
    while (true) {
        if (!budget.charge()) { return 7; }
        let read: core::result::Result<i32,core::io::Error> = file.read(probe,0,1);
        if (read.is_err()) { if (core::io::is_interrupted(read.unwrap_err())) { continue; } return 3; }
        let count: i32 = read.unwrap();
        if (count == 0) { return 0; }
        if (count == 1) { return 2; }
        return 3;
    }
    return 3;
}
fn read_key(path: core::path::Path, key: [u8], budget: &Budget) -> i32 {
    let options: std::file_ops::OpenOptions = std::file_ops::options();
    options.access = std::file_ops::Access::Read;
    options.no_follow = true; options.nonblocking = true; options.close_on_exec = true;
    let opened: core::result::Result<std::file::File,core::io::Error> = std::file_ops::open(path,options);
    if (opened.is_err()) { return 3; }
    let file: std::file::File = opened.unwrap();
    let status: i32 = key_contents(file.borrow(),key,budget);
    // Invalidate and attempt close exactly once, before any stdin read. Its
    // failure overrides key format/limit errors and is never retried.
    let closed: core::result::Result<i32,core::io::Error> = file.close();
    if (closed.is_err()) { return 3; }
    return status;
}
fn read_input(input: &alloc::io::Buffer, maximum: i32, budget: &Budget) -> i32 {
    let source: std::stream::Descriptor = std::stream::stdin();
    let storage: [i32;256] = [0;256];
    let bytes: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(storage),1024);
    let total: i32 = 0;
    while (true) {
        let request: i32 = maximum-total;
        if (request > 1024) { request = 1024; }
        if (request == 0) { request = 1; }
        if (!budget.charge()) { return 7; }
        let read: core::result::Result<i32,core::io::Error> = source.read(bytes,0,request);
        if (read.is_err()) { if (core::io::is_interrupted(read.unwrap_err())) { continue; } return 3; }
        let count: i32 = read.unwrap();
        if (count < 0 || count > request) { return 3; }
        if (count == 0) { return 0; }
        if (count > maximum-total) { return 7; }
        let appended: core::result::Result<i32,core::io::Error> = input.write(bytes,0,count);
        if (appended.is_err()) { return io_status(appended.unwrap_err()); }
        if (appended.unwrap() != count) { return 3; }
        total += count;
    }
    return 3;
}
fn publish(bytes: core::slice::View<u8>, budget: &Budget) -> i32 {
    let sink: std::stream::Descriptor = std::stream::stdout();
    let completed: i32 = 0;
    while (completed < bytes.length) {
        if (!budget.charge()) { return 7; }
        let written: core::result::Result<i32,core::io::Error> = sink.write(bytes.values,bytes.start+completed,bytes.length-completed);
        if (written.is_err()) { if (core::io::is_interrupted(written.unwrap_err())) { continue; } return 3; }
        let count: i32 = written.unwrap();
        if (count <= 0 || count > bytes.length-completed) { return 3; }
        completed += count;
    }
    return 0;
}

fn transform(input: &alloc::io::Buffer, sealing: bool, key: core::slice::View<u8>, aad_bytes: [u8], aad_length: i32, budget: &Budget) -> i32 {
    let length: i32 = input.len();
    let message_length: i32 = length;
    if (sealing) {
        aad_bytes[0] = 76; aad_bytes[1] = 78; aad_bytes[2] = 67; aad_bytes[3] = 49;
    } else {
        if (length < 32) { return 2; }
        let source: [u8] = input.as_bytes();
        if (source[0] != 76 || source[1] != 78 || source[2] != 67 || source[3] != 49) { return 2; }
        let index: i32 = 0; while (index < 16) { aad_bytes[index] = source[index]; index += 1; }
        message_length = length-32;
    }
    let output_length: i32 = message_length;
    if (sealing) { output_length += 32; }
    let made: core::result::Result<alloc::vec::Vec<u8>,alloc::vec::Error> = alloc::vec::with_capacity<u8>(output_length);
    if (made.is_err()) { return 4; }
    let output: alloc::vec::Vec<u8> = made.unwrap();
    let initialized: core::result::Result<i32,alloc::vec::Error> = output.try_resize(output_length,0);
    if (initialized.is_err()) { output.destroy(); return 4; }
    let destination: core::slice::View<u8> = output.as_view();
    let source: core::slice::View<u8> = core::slice::View { values: input.as_bytes(), start: 0, length: length };
    let nonce: core::slice::View<u8> = core::slice::View { values: aad_bytes, start: 4, length: 12 };
    let aad: core::slice::View<u8> = core::slice::View { values: aad_bytes, start: 0, length: 16+aad_length };
    let status: i32 = 0;
    if (sealing) {
        let target: [u8] = output.as_slice();
        let index: i32 = 0; while (index < 16) { target[index] = aad_bytes[index]; index += 1; }
        let ciphertext: core::slice::View<u8> = destination.subview(16,16+message_length).unwrap();
        let tag: core::slice::View<u8> = destination.subview(16+message_length,32+message_length).unwrap();
        let sealed: core::result::Result<i32,ext::chacha20_poly1305::Error> = ext::chacha20_poly1305::seal_into(key,nonce,aad,source,ciphertext,tag);
        if (sealed.is_err()) { status = 7; }
        else { if (sealed.unwrap() != message_length) { status = 7; } }
    } else {
        let ciphertext: core::slice::View<u8> = source.subview(16,length-16).unwrap();
        let tag: core::slice::View<u8> = source.subview(length-16,length).unwrap();
        let opened: core::result::Result<i32,ext::chacha20_poly1305::Error> = ext::chacha20_poly1305::open_into(key,nonce,aad,ciphertext,tag,destination);
        if (opened.is_err()) { status = match (opened.unwrap_err()) { ext::chacha20_poly1305::Error::AuthenticationFailed -> 5, _ -> 7 }; }
        else { if (opened.unwrap() != message_length) { status = 7; } }
    }
    if (status == 0) { status = publish(destination,budget); }
    output.destroy();
    return status;
}

fn process(arguments: std::args::Arguments) -> i32 {
    if (arguments.len() < 3 || arguments.len() > 4) { return 2; }
    let command: core::slice::View<u8> = arguments.get(0).unwrap();
    let sealing: bool = same(command,"seal",4);
    if (!sealing && !same(command,"open",4)) { return 2; }
    if ((sealing && arguments.len() != 4) || (!sealing && arguments.len() != 3)) { return 2; }
    let path_text: core::slice::View<u8> = arguments.get(1).unwrap();
    if (path_text.length <= 0 || path_text.length > 4095) { return 2; }
    let parsed_path: core::result::Result<core::path::Path,core::path::Error> = core::path::from_view(path_text);
    if (parsed_path.is_err()) { return 2; }
    let aad_text: core::slice::View<u8> = arguments.get(2).unwrap();
    if (sealing) { aad_text = arguments.get(3).unwrap(); }
    if (aad_text.length > 512 || aad_text.length % 2 != 0) { return 2; }
    let storage: [i32;68] = [0;68];
    let aad_bytes: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(storage),272);
    let caller_aad: core::slice::View<u8> = core::slice::View { values: aad_bytes, start: 16, length: 256 };
    if (!decode(aad_text,caller_aad)) { return 2; }
    if (sealing) {
        let nonce_text: core::slice::View<u8> = arguments.get(2).unwrap();
        if (nonce_text.length != 24) { return 2; }
        let nonce: core::slice::View<u8> = core::slice::View { values: aad_bytes, start: 4, length: 12 };
        if (!decode(nonce_text,nonce)) { return 2; }
    }
    let key_storage: [i32;8] = [0;8];
    let key_bytes: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(key_storage),32);
    let key: core::slice::View<u8> = core::slice::view(key_bytes,32).unwrap();
    let budget: Budget = Budget { remaining: 131072 };
    let key_status: i32 = read_key(parsed_path.unwrap(),key_bytes,budget.borrow());
    if (key_status != 0) { return key_status; }
    let maximum: i32 = MAX_PAYLOAD;
    if (!sealing) { maximum += 32; }
    let made: core::result::Result<alloc::io::Buffer,core::io::Error> = alloc::io::with_limit(maximum);
    if (made.is_err()) { return io_status(made.unwrap_err()); }
    let input: alloc::io::Buffer = made.unwrap();
    let reserved: core::result::Result<i32,core::io::Error> = input.try_reserve(maximum);
    if (reserved.is_err()) { let status: i32 = io_status(reserved.unwrap_err()); input.destroy(); return status; }
    let status: i32 = read_input(input.borrow(),maximum,budget.borrow());
    if (status == 0) { status = transform(input.borrow(),sealing,key,aad_bytes,aad_text.length/2,budget.borrow()); }
    input.destroy();
    return status;
}
fn main() -> i32 {
    if (std::signal::set_disposition(std::signal::Signal::BrokenPipe,std::signal::Disposition::Ignore).is_err()) { return 3; }
    // Excludes argv[0]; counts four raw user arguments and their 4,635-byte sum.
    let captured: core::result::Result<std::args::Arguments,std::args::Error> = std::args::snapshot(1,4,4635);
    if (captured.is_err()) { return match (captured.unwrap_err()) { std::args::Error::AllocationFailed -> 4, std::args::Error::HostRead(index) -> 3, _ -> 2 }; }
    let arguments: std::args::Arguments = captured.unwrap();
    let status: i32 = process(arguments);
    arguments.destroy();
    return status;
}
