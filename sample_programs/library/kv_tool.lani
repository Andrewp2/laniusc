fn completion(values:core::slice::View<core::slice::View<u8>>,schema:core::slice::View<ext::cli_commands::Command>,scratch:core::slice::View<ext::cli::Spec>) -> Outcome {
    if(values.length<4 || values.length>12) { return ordinary(2); }
    let ending=values.values[values.start+1]; let end:bool=same(ending,literal("1",1));
    if(!end && !same(ending,literal("0",1))) { return ordinary(2); }
    let rawtrim=values.values[values.start+2]; let prefix=values.values[values.start+3];
    if(rawtrim.length>prefix.length) { return ordinary(2); }
    if(!same(rawtrim,prefix.subview(0,rawtrim.length).unwrap())) { return ordinary(2); }
    let trimmed=ext::bash_words::measure(rawtrim,ext::bash_words::Mode::Prefix);
    if(trimmed.is_err()) { return ordinary(2); } let trimshape=trimmed.unwrap();
    if(trimshape.incomplete_escape || trimshape.bytes>4096) { return ordinary(2); }
    let total:i32=trimshape.bytes; let index:i32=4;
    while(index<values.length) {
        let shape=ext::bash_words::measure(values.values[values.start+index],ext::bash_words::Mode::Complete);
        if(shape.is_err()) { return ordinary(2); } let size=shape.unwrap().bytes;
        if(size>4096 || total>32768-size) { return ordinary(2); } total+=size; index+=1;
    }
    let shape=ext::bash_words::measure(prefix,ext::bash_words::Mode::Prefix);
    if(shape.is_err()) { return ordinary(2); } let active=shape.unwrap();
    if(active.bytes>4096 || total>32768-active.bytes) { return ordinary(2); } total+=active.bytes;
    let decoded:alloc::vec::Vec<u8> =alloc::vec::new();
    if(decoded.try_resize(total,0).is_err()) { decoded.destroy(); return ordinary(4); }
    let empty=literal("",0); let slots:[core::slice::View<u8>;9]=[empty;9];
    let offset:i32=0; let count:i32=0; index=4;
    while(index<values.length) {
        let output=core::slice::View { values:decoded.as_slice(),start:offset,length:total-offset };
        let parsed=ext::bash_words::decode_into(values.values[values.start+index],ext::bash_words::Mode::Complete,output);
        if(parsed.is_err()) { decoded.destroy(); return ordinary(2); } let size=parsed.unwrap().bytes;
        slots[count]=core::slice::View { values:decoded.as_slice(),start:offset,length:size }; count+=1; offset+=size; index+=1;
    }
    let output=core::slice::View { values:decoded.as_slice(),start:offset,length:active.bytes };
    let parsed=ext::bash_words::decode_into(prefix,ext::bash_words::Mode::Prefix,output);
    if(parsed.is_err()) { decoded.destroy(); return ordinary(2); }
    slots[count]=output; count+=1; offset+=active.bytes;
    let trim=core::slice::View { values:decoded.as_slice(),start:offset,length:trimshape.bytes };
    let parsedtrim=ext::bash_words::decode_into(rawtrim,ext::bash_words::Mode::Prefix,trim);
    if(parsedtrim.is_err()) { decoded.destroy(); return ordinary(2); }
    let bridge=CompletionBridge { quote:trimshape.quote,continuation:active.quote,trim:trim,end:end };
    let outcome=completion_decoded(core::slice::View { values:slots,start:0,length:count },active.incomplete_escape,bridge,schema,scratch);
    decoded.destroy(); return outcome;
}
fn arguments(args:std::args::Arguments) -> Outcome {
    let help_spec=ext::cli::Spec { id:100,long:literal("help",4),short:104,arity:ext::cli::Arity::Flag };
    let options:[ext::cli_commands::OptionSpec;1]=[ext::cli_commands::OptionSpec { spec:help_spec,global:true,value_name:literal("",0),help:literal("Show command help",17) }];
    let globals=core::slice::View { values:options,start:0,length:1 };
    let empty=core::slice::View { values:options,start:0,length:0 };
    let commands:[ext::cli_commands::Command;7]=[
        ext::cli_commands::Command { id:0,parent:-1,name:literal("kv-tool",7),summary:literal("Bounded byte-key snapshot store",31),operands:literal("",0),ordering:ext::cli::Ordering::Intermixed,options:globals },
        node(1,literal("init",4),literal("Create an empty database",24),literal("DB",2),empty),
        node(2,literal("put",3),literal("Insert or replace a byte value",30),literal("DB KEY_HEX VALUE_HEX",20),empty),
        node(3,literal("remove",6),literal("Remove a byte key",17),literal("DB KEY_HEX",10),empty),
        node(4,literal("get",3),literal("Write the exact stored value",28),literal("DB KEY_HEX",10),empty),
        node(5,literal("list",4),literal("List sorted hexadecimal entries",31),literal("DB",2),empty),
        node(6,literal("check",5),literal("Validate the complete snapshot",30),literal("DB",2),empty)
    ];
    let schema=core::slice::View { values:commands,start:0,length:7 };
    let scratch:[ext::cli::Spec;1]=[help_spec];
    if(ext::cli_commands::validate(schema).is_err()) { return ordinary(2); }
    if(args.len()>0 && same(args.get(0).unwrap(),literal("--lanius-complete-bash",22))) { return completion(args.as_view(),schema,core::slice::View { values:scratch,start:0,length:1 }); }
    if(args.len()>8) { return ordinary(2); }
    // This single-threaded program never changes cwd. Merely admitting Files
    // performs no filesystem operation; only explicit @ directives load files.
    let made=ext::cli_response_files::files(-100,4096,false);
    if(made.is_err()) { return response_file_error(made.unwrap_err()); }
    let provider=made.unwrap(); let expansion=ext::cli_response::empty();
    let bounds=ext::cli_response::Limits { max_arguments:8,max_tokens:256,max_argument_bytes:262144,max_output_bytes:262144,max_file_bytes:262144,max_source_bytes:1048576,max_files:16,max_depth:8,max_path_bytes:4095,max_work:8388608 };
    let prepared=expansion.prepare<ext::cli_response_files::Files,ext::cli_response_files::Error>(args.as_view(),provider.borrow(),bounds);
    if(prepared.is_err()) { let outcome=response_error(prepared.unwrap_err()); expansion.destroy(); return outcome; }
    let outcome=dispatch(expansion.arguments().unwrap(),schema,core::slice::View { values:scratch,start:0,length:1 });
    expansion.destroy(); return outcome;
}
fn report(outcome: Outcome) -> i32 {
    let okay: bool = !outcome.diagnostic_failed;
    let notice: i32 = match(outcome.notice) {
        Notice::None -> 0, Notice::Invalid -> 1, Notice::Io -> 2,
        Notice::Allocation -> 3, Notice::Exists -> 4,
        Notice::PublishedUnsynced -> 5, Notice::Unconfirmed -> 6
    };
    if (notice == 1) { if (!write(literal("kv-tool: invalid input or resource limit\n",41),true)) { okay = false; } }
    if (notice == 2) { if (!write(literal("kv-tool: I/O failure\n",21),true)) { okay = false; } }
    if (notice == 3) { if (!write(literal("kv-tool: allocation failed\n",27),true)) { okay = false; } }
    if (notice == 4) { if (!write(literal("kv-tool: database already exists\n",33),true)) { okay = false; } }
    if (notice == 5) { if (!write(literal("kv-tool: snapshot published; directory sync unconfirmed\n",56),true)) { okay = false; } }
    if (notice == 6) { if (!write(literal("kv-tool: publication visibility unconfirmed\n",44),true)) { okay = false; } }
    if (outcome.cleanup_failed) {
        let published: bool = match(outcome.visibility) { std::atomic_file::Visibility::Published -> true, _ -> false };
        let unsynced: bool = match(outcome.notice) { Notice::PublishedUnsynced -> true, _ -> false };
        if (published && !unsynced) {
            if (!write(literal("kv-tool: snapshot published; cleanup failed\n",44),true)) { okay = false; }
        } else {
            if (!write(literal("kv-tool: cleanup failed\n",24),true)) { okay = false; }
        }
    }
    // Failed stderr cannot erase an already known publication/cleanup outcome.
    if (!okay && outcome.code == 0) { return 3; }
    return outcome.code;
}
fn main() -> i32 {
    if(std::signal::set_disposition(std::signal::Signal::BrokenPipe,std::signal::Disposition::Ignore).is_err()) { return 3; }
    let captured: core::result::Result<std::args::Arguments,std::args::Error> = std::args::snapshot(1,12,262144);
    let outcome: Outcome = ordinary(0);
    if (captured.is_err()) {
        let status: i32 = match(captured.unwrap_err()) { std::args::Error::AllocationFailed -> 4, std::args::Error::HostRead(at) -> 3, _ -> 2 };
        outcome = ordinary(status);
    } else {
        let args: std::args::Arguments = captured.unwrap();
        outcome = arguments(args);
        args.destroy();
    }
    return report(outcome);
}
