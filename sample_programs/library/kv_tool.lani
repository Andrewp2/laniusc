    let slots:[core::slice::View<u8>;32]=[empty;32];
    let count:i32=0; let used:i32=0; let append_space:bool=bridge.end;
    while(true) {
        let available=32768-used; if(available>4096) { available=4096; }
        let output=core::slice::View { values:backing.as_slice(),start:used,length:available };
        let found=candidates.next(output);
