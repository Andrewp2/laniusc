        let item=found.unwrap(); if(item.is_none()) { break; }
        if(count==32) { backing.destroy(); return ordinary(2); }
        let suggestion=item.unwrap();
        slots[count]=core::slice::View { values:backing.as_slice(),start:used,length:suggestion.bytes };
        used+=suggestion.bytes; count+=1;
        if(!suggestion.append_space) { append_space=false; }
    }
    let outcome=completion_reply(ext::cli_bash::Reply { mode:ext::cli_bash::Mode::Candidates,append_space:append_space,quote:bridge.quote,continuation:bridge.continuation,trim:bridge.trim,stem:empty,prefix:empty,candidates:core::slice::View { values:slots,start:0,length:count } });
    backing.destroy(); return outcome;
}
fn completion_decoded(words:core::slice::View<core::slice::View<u8>>,incomplete:bool,bridge:CompletionBridge,schema:core::slice::View<ext::cli_commands::Command>,scratch:core::slice::View<ext::cli::Spec>) -> Outcome {
