    if(inspected.is_err()) { return ordinary(2); } let context=inspected.unwrap();
    if(incomplete) { return completion_none(bridge); }
    if(response) { return completion_files(literal("@",1),prefix.subview(1,prefix.length).unwrap(),bridge); }
    let operand=match(context.kind()) { ext::cli_complete::Kind::Operand->true,_ ->false };
    if(operand) {
        if(context.command()!=0 && context.operand_index()==0) { return completion_files(context.stem(),context.prefix(),bridge); }
