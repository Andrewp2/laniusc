// Checked dot product through real borrowed Zip, Take, Map, and Enumerate.
// Native x86_64 Linux; see docs/stdlib-range-dot.md for acceptance checkpoints.
module app::main;
import core::decimal::format_u64;
import core::decimal::format_i64;
import core::decimal::parse_i32_range;
import core::decimal::parse_u64_range;
import core::i64::checked_add;
import core::io::write_all;
import core::iter::Mapper;
import core::iter::range_i32_inclusive;
import core::iter::zip;
import core::iter::take;
import core::iter::map;
import core::iter::enumerate;
import core::mem::typed_slice_from_raw_parts;
import core::mem::i32_array_data_ptr;
import core::pair::Pair;
import core::range::range_inclusive;
import std::args::Arguments;
import std::args::Error;
import std::args::snapshot;
import std::signal::set_disposition;
import std::signal::Signal;
import std::signal::Disposition;
import std::stream::stdout;

struct Product {}
impl Product {
    fn borrow(&self) -> &Product { return self; }
}
pub impl Mapper<Pair<i32,i32>,i64> for Product {
    pub fn apply(&self, value: Pair<i32,i32>) -> i64 {
        // Widen both operands before multiplication. Every i32 product fits
        // i64, including MIN * MIN = 2^62; the accumulated prefixes may not.
        let left = value.first as i64;
        let right = value.second as i64;
        return left * right;
    }
}

fn output(count: u64, dot: i64) -> i32 {
    // Header 10, u64 at most 20, comma 1, i64 at most 20, newline 1:
    // every valid summary fits 52 of these 64 packed logical stack bytes.
    let storage: [i32;16] = [0;16];
    let bytes: [u8] = typed_slice_from_raw_parts(i32_array_data_ptr(storage),64);
    bytes[0] = 99; bytes[1] = 111; bytes[2] = 117; bytes[3] = 110; bytes[4] = 116;
    bytes[5] = 44; bytes[6] = 100; bytes[7] = 111; bytes[8] = 116; bytes[9] = 10;
    let formatted_count = format_u64(bytes,10,54,count);
    if (formatted_count.is_err()) { return 3; }
    let comma = 10 + formatted_count.unwrap();
    bytes[comma] = 44;
    let start = comma + 1;
    let formatted_dot = format_i64(bytes,start,63-start,dot);
    if (formatted_dot.is_err()) { return 3; }
    let newline = start + formatted_dot.unwrap();
    bytes[newline] = 10;
    let sink = stdout();
    let written = write_all(sink.borrow(),bytes,0,newline+1);
    if (written.is_err()) { return 3; }
    return 0;
}

fn calculate(left_start: i32, left_end: i32, right_start: i32, right_end: i32,
    limit: u64) -> i32 {
    let left_bounds = range_inclusive(left_start,left_end);
    let right_bounds = range_inclusive(right_start,right_end);
    let left = range_i32_inclusive(left_bounds);
    let right = range_i32_inclusive(right_bounds);
    let paired = zip(left.borrow(),right.borrow());
    let selected = take(paired.borrow(),limit);
    let product = Product {};
    let products = map(selected.borrow(),product.borrow());
    let indexed = enumerate(products.borrow());
    let count: u64 = 0;
    let dot: i64 = 0;
    while (true) {
        let next = indexed.next();
        if (next.is_none()) { break; }
        let value = next.unwrap();
        let added = checked_add(dot,value.second);
        if (added.is_none()) { return 5; }
        dot = added.unwrap();
        // Take yields at most 1,000,000 items. Enumerate starts at zero,
        // so every index and index + 1 fit u64 without an overflow branch.
        count = value.first + 1;
    }
    return output(count,dot);
}

// Main retains the active snapshot owner. This shallow read-only handle and
// every argument view finish before main destroys that owner on all branches.
fn process(arguments: Arguments) -> i32 {
    if (arguments.len() != 5) { return 2; }
    let first = arguments.get(0);
    let second = arguments.get(1);
    let third = arguments.get(2);
    let fourth = arguments.get(3);
    let fifth = arguments.get(4);
    let left_start_text = first.unwrap();
    let left_end_text = second.unwrap();
    let right_start_text = third.unwrap();
    let right_end_text = fourth.unwrap();
    let limit_text = fifth.unwrap();
    let parsed_left_start = parse_i32_range(left_start_text.values,left_start_text.start,left_start_text.length);
    let parsed_left_end = parse_i32_range(left_end_text.values,left_end_text.start,left_end_text.length);
    let parsed_right_start = parse_i32_range(right_start_text.values,right_start_text.start,right_start_text.length);
    let parsed_right_end = parse_i32_range(right_end_text.values,right_end_text.start,right_end_text.length);
    let parsed_limit = parse_u64_range(limit_text.values,limit_text.start,limit_text.length);
    if (parsed_left_start.is_err() || parsed_left_end.is_err() || parsed_right_start.is_err()
        || parsed_right_end.is_err() || parsed_limit.is_err()) { return 2; }
    let limit = parsed_limit.unwrap();
    if (limit > 1000000) { return 2; }
    return calculate(parsed_left_start.unwrap(),parsed_left_end.unwrap(),parsed_right_start.unwrap(),parsed_right_end.unwrap(),limit);
}

fn main() -> i32 {
    // Install explicit process-wide SIGPIPE policy before any allocation.
    // A closed stdout pipe then reports an error and permits owner cleanup.
    if (set_disposition(Signal::BrokenPipe,Disposition::Ignore).is_err()) { return 3; }
    let captured = snapshot(1,5,160);
    if (captured.is_err()) {
        return match (captured.unwrap_err()) { Error::AllocationFailed -> 4, Error::HostRead(index) -> 3, _ -> 2 };
    }
    let arguments = captured.unwrap();
    let status = process(arguments);
    arguments.destroy();
    return status;
}
