// Validate TOML 1.1 stdin and write a deterministic, type-preserving encoding.
// Exit 2: arguments/input/limits; 3: host I/O; 4: allocation.
module app::main;
import alloc::io;
import alloc::vec;
import core::decimal;
import core::fmt;
import core::io;
import core::mem;
import core::option;
import core::result;
import core::slice;
import core::text;
import ext::cli;
import ext::toml;
import std::args;
import std::stream;

struct Options { toml: ext::toml::Options, check: bool, help: bool }
impl Options { fn borrow(&self) -> &Options { return self; } }
struct Diagnostic { stage: i32, reason: i32, offset: i32, kind: core::option::Option<ext::toml::ErrorKind> }
impl Diagnostic { fn borrow(&self) -> &Diagnostic { return self; } }
fn literal(value: str, count: i32) -> core::slice::View<u8> {
    let bytes: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::string_data_ptr(value),count);
    return core::result::unwrap(core::slice::view(bytes,count));
}
fn text(value: str, count: i32) -> core::text::Text {
    let bytes: core::slice::View<u8> = literal(value,count);
    return core::text::from_utf8_unchecked(bytes.values,bytes.start,count);
}
fn fail(diagnostic: &Diagnostic, status: i32, stage: i32, reason: i32) -> i32 {
    diagnostic.stage = stage; diagnostic.reason = reason; return status;
}
fn input_error(error: core::io::Error, diagnostic: &Diagnostic) -> i32 {
    return match (error) { core::io::Error::LimitExceeded -> fail(diagnostic,2,1,2), core::io::Error::AllocationFailed -> fail(diagnostic,4,1,4), _ -> fail(diagnostic,3,1,3) };
}
fn toml_error(error: ext::toml::Error, stage: i32, diagnostic: &Diagnostic) -> i32 {
    diagnostic.offset = error.offset; diagnostic.kind = core::option::Some(error.kind);
    let allocated: bool = match (error.kind) { ext::toml::ErrorKind::AllocationFailed -> true, _ -> false };
    if (allocated) { return fail(diagnostic,4,stage,4); } return fail(diagnostic,2,stage,5);
}
fn option(options: &Options, item: ext::cli::Occurrence) -> bool {
    if (item.id == 8) { options.check = true; return true; }
    if (item.id == 9) { options.help = true; return true; }
    let argument: ext::cli::Argument = core::option::unwrap(item.value); let bytes: core::slice::View<u8> = argument.bytes;
    let parsed: core::result::Result<u64,core::decimal::ParseError> = core::decimal::parse_u64_range(bytes.values,bytes.start,bytes.len());
    if (core::result::is_err(parsed)) { return false; } let value: u64 = core::result::unwrap(parsed);
    if (item.id == 7) { options.toml.max_work = value; return true; }
    if (value > 67108864 as u64) { return false; }
    if (item.id == 1) { options.toml.max_input_bytes = value as i32; }
    if (item.id == 2) { options.toml.max_output_bytes = value as i32; }
    if (item.id == 3) { if (value > 1000000 as u64) { return false; } options.toml.max_nodes = value as i32; }
    if (item.id == 4) { if (value > 4096 as u64) { return false; } options.toml.max_depth = value as i32; }
    if (item.id == 5) { options.toml.max_string_bytes = value as i32; }
    if (item.id == 6) { options.toml.max_number_bytes = value as i32; }
    return true;
}
fn encode(document: ext::toml::Document, diagnostic: &Diagnostic) -> i32 {
    let measured: core::result::Result<i32,ext::toml::Error> = ext::toml::measure(document);
    if (core::result::is_err(measured)) { return toml_error(core::result::unwrap_err(measured),3,diagnostic); }
    let count: i32 = core::result::unwrap(measured);
    let allocated: core::result::Result<alloc::vec::Vec<u8>,alloc::vec::Error> = alloc::vec::with_capacity<u8>(count);
    if (core::result::is_err(allocated)) { return fail(diagnostic,4,3,4); }
    let bytes: alloc::vec::Vec<u8> = core::result::unwrap(allocated); core::result::unwrap(bytes.try_resize(count,0));
    let encoded: core::result::Result<i32,ext::toml::Error> = ext::toml::encode_into(document,bytes.as_view());
    if (core::result::is_err(encoded)) { bytes.destroy(); return toml_error(core::result::unwrap_err(encoded),3,diagnostic); }
    let sink: std::stream::Descriptor = std::stream::stdout();
    let written: core::result::Result<i32,core::io::Failure> = core::io::write_all(sink.borrow(),bytes.as_slice(),0,core::result::unwrap(encoded));
    bytes.destroy(); if (core::result::is_err(written)) { return fail(diagnostic,3,4,3); } return 0;
}
fn convert(buffer: &alloc::io::Buffer, options: Options, diagnostic: &Diagnostic) -> i32 {
    let checked: core::result::Result<core::text::Text,core::text::Error> = core::text::from_utf8(buffer.as_bytes(),buffer.len());
    if (core::result::is_err(checked)) {
        let error: core::text::Error = core::result::unwrap_err(checked);
        diagnostic.offset = match (error) { core::text::Error::InvalidUtf8(offset) -> offset, _ -> -1 }; return fail(diagnostic,2,1,1);
    }
    let parsed: core::result::Result<ext::toml::Document,ext::toml::Error> = ext::toml::parse_text(core::result::unwrap(checked),options.toml);
    if (core::result::is_err(parsed)) { return toml_error(core::result::unwrap_err(parsed),2,diagnostic); }
    let document: ext::toml::Document = core::result::unwrap(parsed); let status: i32 = 0;
    if (!options.check) { status = encode(document,diagnostic); }
    document.destroy(); return status;
}
fn process(arguments: std::args::Arguments, diagnostic: &Diagnostic) -> i32 {
    let specs: [ext::cli::Spec;9] = [
        ext::cli::Spec { id: 1, long: literal("max-input-bytes",15), short: 0, arity: ext::cli::Arity::Required },
        ext::cli::Spec { id: 2, long: literal("max-output-bytes",16), short: 0, arity: ext::cli::Arity::Required },
        ext::cli::Spec { id: 3, long: literal("max-nodes",9), short: 0, arity: ext::cli::Arity::Required },
        ext::cli::Spec { id: 4, long: literal("max-depth",9), short: 0, arity: ext::cli::Arity::Required },
        ext::cli::Spec { id: 5, long: literal("max-string-bytes",16), short: 0, arity: ext::cli::Arity::Required },
        ext::cli::Spec { id: 6, long: literal("max-number-bytes",16), short: 0, arity: ext::cli::Arity::Required },
        ext::cli::Spec { id: 7, long: literal("max-work",8), short: 0, arity: ext::cli::Arity::Required },
        ext::cli::Spec { id: 8, long: literal("check",5), short: 0, arity: ext::cli::Arity::Flag },
        ext::cli::Spec { id: 9, long: literal("help",4), short: 104, arity: ext::cli::Arity::Flag }
    ];
    let specification: core::slice::View<ext::cli::Spec> = core::result::unwrap(core::slice::view(specs,9));
    let parser: ext::cli::Parser = core::result::unwrap(ext::cli::parser(arguments.as_view(),specification,ext::cli::Ordering::Intermixed));
    let options: Options = Options { toml: ext::toml::default_options(), check: false, help: false };
    while (true) {
        let event: core::result::Result<core::option::Option<ext::cli::Event>,ext::cli::Error> = parser.next();
        if (core::result::is_err(event)) { return fail(diagnostic,2,0,0); }
        let next: core::option::Option<ext::cli::Event> = core::result::unwrap(event); if (core::option::is_none(next)) { break; }
        let valid: bool = match (core::option::unwrap(next)) { ext::cli::Event::Option(item) -> option(options.borrow(),item), _ -> false };
        if (!valid) { return fail(diagnostic,2,0,0); }
    }
    if (options.help) {
        let usage: core::slice::View<u8> = literal("Usage: toml-normalize [--check] [--max-input-bytes N] [--max-output-bytes N] [--max-nodes N] [--max-depth N] [--max-string-bytes N] [--max-number-bytes N] [--max-work N]\n",170);
        let sink: std::stream::Descriptor = std::stream::stdout();
        if (core::result::is_err(core::io::write_all(sink.borrow(),usage.values,usage.start,usage.len()))) { return fail(diagnostic,3,0,3); } return 0;
    }
    let buffer: alloc::io::Buffer = core::result::unwrap(alloc::io::with_limit(options.toml.max_input_bytes)); let source: std::stream::Descriptor = std::stream::stdin();
    let copied: core::result::Result<u64,core::io::CopyFailure> = std::stream::copy(source.borrow(),buffer.borrow());
    if (core::result::is_err(copied)) { let failure: core::io::CopyFailure = core::result::unwrap_err(copied); buffer.destroy(); return input_error(failure.cause,diagnostic); }
    let status: i32 = convert(buffer.borrow(),options,diagnostic); buffer.destroy(); return status;
}
fn diagnostic(value: Diagnostic) -> bool {
    let storage: [i32;48] = [0;48]; let bytes: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(storage),192);
    let format: core::fmt::Formatter = core::result::unwrap(core::fmt::buffer(bytes,0,192));
    format.write_text(text("toml-normalize: ",16));
    if (value.reason == 0) { format.write_text(text("invalid-arguments",17)); }
    if (value.reason == 1) { format.write_text(text("invalid-utf8",12)); }
    if (value.reason == 2) { format.write_text(text("resource-limit",14)); }
    if (value.reason == 3) { format.write_text(text("io-failure",10)); }
    if (value.reason == 4) { format.write_text(text("allocation-failure",18)); }
    if (value.reason == 5) { format.write_text(text("toml-error",10)); }
    format.write_text(text(" stage=",7));
    if (value.stage == 0) { format.write_text(text("arguments",9)); }
    if (value.stage == 1) { format.write_text(text("input",5)); }
    if (value.stage == 2) { format.write_text(text("parse",5)); }
    if (value.stage == 3) { format.write_text(text("encode",6)); }
    if (value.stage == 4) { format.write_text(text("output",6)); }
    if (core::option::is_some(value.kind)) { format.write_text(text(" kind=",6)); format.write_text(ext::toml::error_kind_text(core::option::unwrap(value.kind))); }
    if (value.offset >= 0) { format.write_text(text(" byte=",6)); format.write_signed(value.offset as i64,core::fmt::decimal()); }
    format.write_text(text("\n",1)); let size: i32 = core::result::unwrap(format.finish()); let sink: std::stream::Descriptor = std::stream::stderr();
    return core::result::is_ok(core::io::write_all(sink.borrow(),bytes,0,size));
}
fn main() -> i32 {
    let detail: Diagnostic = Diagnostic { stage: 0, reason: 0, offset: -1, kind: core::option::None() };
    let captured: core::result::Result<std::args::Arguments,std::args::Error> = std::args::snapshot(1,32,8192); let status: i32 = 0;
    if (core::result::is_err(captured)) {
        status = match (core::result::unwrap_err(captured)) { std::args::Error::AllocationFailed -> fail(detail.borrow(),4,0,4), std::args::Error::HostRead(index) -> fail(detail.borrow(),3,0,3), _ -> fail(detail.borrow(),2,0,0) };
    } else { let arguments: std::args::Arguments = core::result::unwrap(captured); status = process(arguments,detail.borrow()); arguments.destroy(); }
    if (status != 0 && !diagnostic(detail)) { return 3; } return status;
}
