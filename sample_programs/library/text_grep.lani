fn directory_skipped(globs: &Globs, name: core::slice::View<u8>, command_line: bool) -> bool {
    let i: i32 = 0;
    while (i < globs.items.len()) { let glob: Glob = globs.items.at(i); i += 1; if (glob.kind == 3 && glob_match(glob.bytes,name,command_line)) { return true; } }
