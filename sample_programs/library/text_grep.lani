fn option(options: &Options, item: ext::cli::Occurrence, diagnostic: &Diagnostic) -> bool {
    diagnostic.argument = item.at.argument; diagnostic.offset = item.at.byte;
    if (item.id == 1) { options.invert = true; return true; } if (item.id == 2) { options.numbers = true; return true; }
    if (item.id == 3) { options.count = true; return true; } if (item.id == 9) { options.help = true; return true; }
    let value: ext::cli::Argument = core::option::unwrap(item.value); diagnostic.argument = value.at.argument; diagnostic.offset = value.at.byte;
    let parsed: core::result::Result<u64,core::decimal::ParseError> = core::decimal::parse_u64_range(value.bytes.values,value.bytes.start,value.bytes.len());
    if (core::result::is_err(parsed)) { return false; } let number: u64 = core::result::unwrap(parsed);
    if (number > 2147483647 as u64) { return false; }
    if (item.id == 4) { if (number > 67108864 as u64) { return false; } options.max_line = number as i32; }
    if (item.id == 5) { if (number > 65536 as u64) { return false; } options.regex.max_pattern_bytes = number as i32; }
    if (item.id == 6) { if (number < 4 || number > 65536 as u64) { return false; } options.regex.max_states = number as i32; }
    if (item.id == 7) { if (number > 128 as u64) { return false; } options.regex.max_captures = number as i32; }
