            // --invert writes most of the file, so its NULs are settled first.
            let clean: bool = first == -1;
            if (!clean && options.invert) { clean = core::search::find_byte(bytes,first,length,0) < 0; }
            if (clean || !options.invert) {
                let used: i32 = output.used;
                let status: i32 = hits(bytes,length,first,clean,regex,matcher,filter,options,progress,output,diagnostic);
                if (status != BINARY) { return status; }
                output.used = used; progress.selected = 0; progress.hidden = false; diagnostic.line = 1;
            }
        }
        return binary(bytes,length,true,regex,matcher,filter,options,progress,output,diagnostic);
    }
    if (bounded) { if (find_pair(bytes,0,length,filter) < 0 && !options.invert) { return 0; } }
    let nul: bool = core::search::find_byte(bytes,0,length,0) >= 0;
    if (nul || newlines_if_valid(bytes,0,length) < 0) { return binary(bytes,length,nul,regex,matcher,filter,options,progress,output,diagnostic); }
    let position: i32 = 0; let cursor: Cursor = Cursor { start: 0 };
    while (position < length) {
        let end: i32 = position + 65536;
        if (end >= length) { end = length; } else { let newline: i32 = core::search::find_byte(bytes,end,length,10); if (newline < 0) { end = length; } else { end = newline + 1; } }
        filter.hit = -1; filter.end = end;
        let status: i32 = block(bytes,position,end,regex,matcher,filter,options,progress,output,diagnostic,cursor.borrow());
        if (status != 0) { return status; }
        if (end == length) { position = cursor.start; break; }
        position = cursor.start;
    }
    if (length - position > options.max_line) { diagnostic.stage = 2; diagnostic.offset = options.max_line; return fail(diagnostic,2,9); }
    if (length > position) { filter.hit = -1; filter.end = length; return line(bytes,position,length,false,regex,matcher,filter,options,progress,output,diagnostic); }
    return 0;
}
// run.buffer is used through its capacity only (its length stays 0), so
// growing it neither fills nor copies more than the bytes read so far.
// Room for a 64 KiB read after length bytes: 0, 4 or (-1) past the limit.
fn room(run: &Run, length: i32) -> i32 {
    if (run.buffer.capacity() >= length + 65536) { return 0; }
    if (length > 2147483647 - 131072) { return -1; }
    let made: core::result::Result<alloc::vec::Vec<u8>,alloc::vec::Error> = alloc::vec::with_capacity(grown_size(run.buffer.capacity(),length));
    if (core::result::is_err(made)) { return 4; }
    let fresh: alloc::vec::Vec<u8> = core::result::unwrap(made);
    if (length > 0) { copy(stored(run.buffer),0,stored(fresh),0,length); }
    run.buffer.destroy(); run.buffer = fresh; return 0;
}
// The whole capacity of a byte buffer as a slice.
fn stored(buffer: alloc::vec::Vec<u8>) -> [u8] { return core::mem::typed_slice_from_storage<u8>(buffer.storage, buffer.capacity()); }
// Searches the open file fd, shown as path. Returns 0, or a status that
// ends the whole search.
fn search_file(run: &Run, fd: i32, path: core::slice::View<u8>, named: bool, regex: &ext::regex::Regex, matcher: &Matcher, filter: &Filter, options: Options, output: &Output, diagnostic: &Diagnostic) -> i32 {
    let length: i32 = 0; let failed: bool = false;
    while (true) {
        let space: i32 = room(run,length);
        if (space < 0) { failed = true; break; }
        if (space > 0) { std::fs::close(fd); return fail(diagnostic,4,8); }
        let count: i32 = std::fs::read(fd, run.buffer.storage + (length as usize), 65536 as usize);
        if (count == -4) { continue; }
        if (count < 0 || count > 65536) { failed = true; break; }
        if (count == 0) { break; }
        length += count;
    }
    std::fs::close(fd);
    if (failed) { diagnostic.stage = 2; diagnostic.offset = length; return file_failure(run,path,fail(diagnostic,3,7),diagnostic,output); }
    output.label_length = 0;
    if (named) {
        output.label.clear();
        if (core::result::is_err(output.label.try_extend(path)) || core::result::is_err(output.label.try_push(58))) { return fail(diagnostic,4,8); }
        output.label_length = path.length + 1;
    }
    let progress: Progress = Progress { selected: 0, hidden: false }; diagnostic.line = 1;
    let status: i32 = contents(stored(run.buffer),length,regex,matcher,filter,options,progress.borrow(),output,diagnostic);
    if (status != 0) { diagnostic.line = 0; let ended: i32 = file_failure(run,path,status,diagnostic,output); output.label_length = 0; return ended; }
    if (options.count) { diagnostic.stage = 4; let written: i32 = put_count(output,progress.selected,diagnostic); if (written != 0) { return written; } }
    output.label_length = 0; diagnostic.line = 0;
    if (progress.selected > 0) { run.any = true; }
    if (progress.hidden && !options.count) {
        if (output.used > 0 && !flush(output)) { diagnostic.stage = 4; return fail(diagnostic,3,7); }
        if (!notice(path,literal("binary file matches\n",20))) { return 3; }
    }
    return 0;
}
fn open_failure(run: &Run, path: core::slice::View<u8>, diagnostic: &Diagnostic, output: &Output) -> i32 {
    diagnostic.stage = 2; diagnostic.offset = -1; return file_failure(run,path,fail(diagnostic,3,7),diagnostic,output);
}
// A directory that could not be opened: its read buffer not allocated
// ends the search, anything else is reported for its path.
fn directory_failure(run: &Run, path: core::slice::View<u8>, error: std::directory::Error, diagnostic: &Diagnostic, output: &Output) -> i32 {
    let allocation: bool = match (error) { std::directory::Error::AllocationFailed -> true, _ -> false };
    if (allocation) { return fail(diagnostic,4,8); }
    return open_failure(run,path,diagnostic,output);
}
// The bytes of the .gitignore in the directory fd, added with paths of
// that directory starting at base. A missing file adds nothing.
fn load_rules(run: &Run, fd: i32, base: i32, diagnostic: &Diagnostic, output: &Output) -> i32 {
    let name: core::path::Path = core::result::unwrap(core::path::from_view(literal(".gitignore",10)));
    let opened = std::file_ops::open_at(fd,name,std::file_ops::options());
    if (core::result::is_err(opened)) { return 0; }
    let file: std::file::File = core::result::unwrap(opened); let handle: i32 = core::option::unwrap(file.raw_handle());
    let length: i32 = 0; let failed: bool = false;
    while (true) {
        // length stays at most 16 MiB, so only allocation can fail.
        if (room(run,length) != 0) { std::fs::close(handle); return fail(diagnostic,4,8); }
        let count: i32 = std::fs::read(handle, run.buffer.storage + (length as usize), 65536 as usize);
        if (count == -4) { continue; }
        if (count < 0 || count > 65536) { failed = true; break; }
        if (count == 0) { break; }
        length += count;
        if (length > 16777216) { break; }
    }
    std::fs::close(handle);
    // An unreadable .gitignore is reported like an unreadable file, and
    // none of its rules apply.
    if (failed) {
        let shown: alloc::vec::Vec<u8> = alloc::vec::new(); let base_length: i32 = run.path.len();
        let built: bool = core::result::is_ok(shown.try_extend(run.path.as_view()));
        if (built && base_length > 0 && run.path.at(base_length - 1) != 47) { built = core::result::is_ok(shown.try_push(47)); }
        if (built) { built = core::result::is_ok(shown.try_extend(literal(".gitignore",10))); }
        if (!built) { shown.destroy(); return fail(diagnostic,4,8); }
        diagnostic.stage = 2; diagnostic.offset = length;
        let status: i32 = file_failure(run,shown.as_view(),fail(diagnostic,3,7),diagnostic,output); shown.destroy(); return status;
    }
    let added = run.rules.add(core::slice::View { values: stored(run.buffer), start: 0, length: length },base);
    if (core::result::is_err(added)) { return fail(diagnostic,4,8); }
    return 0;
}
// Walks the directory at root (shown with the prefix display) depth first,
// entries in the order the filesystem returns them, as GNU grep's fts walk
// does. Symbolic links and special files below root are skipped.
fn walk(run: &Run, root: core::slice::View<u8>, display: core::slice::View<u8>, regex: &ext::regex::Regex, matcher: &Matcher, filter: &Filter, options: Options, globs: &Globs, output: &Output, diagnostic: &Diagnostic) -> i32 {
    run.path.clear();
    if (core::result::is_err(run.path.try_extend(root)) || core::result::is_err(run.path.try_extend(literal("/.",2)))) { return fail(diagnostic,4,8); }
    let reader: std::directory::Reader = std::directory::empty_directory();
    let target = core::path::from_view(run.path.as_view());
    if (core::result::is_err(target)) { return open_failure(run,display,diagnostic,output); }
    let opened = std::directory::open_into(core::result::unwrap(target),32768,reader.borrow());
    if (core::result::is_err(opened)) { return directory_failure(run,display,core::result::unwrap_err(opened),diagnostic,output); }
    run.path.clear(); if (core::result::is_err(run.path.try_extend(display))) { return fail(diagnostic,4,8); }
    // A display that is empty or ends with '/' takes names without a '/'.
    let rules_before: i32 = run.rules.len();
    if (options.gitignore) {
        let base: i32 = run.path.len(); if (base > 0 && run.path.at(base - 1) != 47) { base += 1; }
        let status: i32 = load_rules(run,core::option::unwrap(reader.raw_handle()),base,diagnostic,output); if (status != 0) { let closed = reader.close(); return status; }
    }
    if (core::result::is_err(run.levels.try_push(Level { reader: reader, length: run.path.len(), rules: rules_before }))) { let closed = reader.close(); return fail(diagnostic,4,8); }
    while (run.levels.len() > 0) {
        let index: i32 = run.levels.len() - 1; let level: Level = run.levels.at(index);
        let current: std::directory::Reader = level.reader; let next = current.next(); level.reader = current; core::result::unwrap(run.levels.set(index,level));
        let finished: bool = core::result::is_err(next);
        if (finished) {
            core::result::unwrap(run.path.truncate(level.length));
            let status: i32 = open_failure(run,run.path.as_view(),diagnostic,output); if (status != 0) { close_levels(run); return status; }
        } else { if (core::option::is_none(core::result::unwrap(next))) { finished = true; } }
        if (finished) {
            let popped: Level = core::option::unwrap(run.levels.pop()); let closing: std::directory::Reader = popped.reader; let closed = closing.close();
            run.rules.truncate(popped.rules);
            if (run.levels.len() > 0) { let parent: Level = run.levels.at(run.levels.len() - 1); core::result::unwrap(run.path.truncate(parent.length)); }
            continue;
        }
        let entry: std::directory::Entry = core::option::unwrap(core::result::unwrap(next));
        core::result::unwrap(run.path.truncate(level.length));
        let parent_length: i32 = run.path.len();
        if (parent_length > 0 && run.path.at(parent_length - 1) != 47) { if (core::result::is_err(run.path.try_push(47))) { close_levels(run); return fail(diagnostic,4,8); } }
        if (core::result::is_err(run.path.try_extend(entry.name))) { close_levels(run); return fail(diagnostic,4,8); }
        let fd: i32 = core::option::unwrap(current.raw_handle());
        let name: core::path::Path = core::result::unwrap(core::path::from_view(entry.name));
        let kind: std::file_ops::Kind = entry.kind;
        let unknown: bool = match (kind) { std::file_ops::Kind::Unknown -> true, _ -> false };
        if (unknown) {
            let metadata: std::file_ops::Metadata = std::file_ops::empty_metadata();
            if (core::result::is_err(std::file_ops::metadata_at_into(fd,name,false,metadata.borrow()))) { let status: i32 = open_failure(run,run.path.as_view(),diagnostic,output); if (status != 0) { close_levels(run); return status; } continue; }
            kind = std::file_ops::kind(metadata.mode);
        }
        let directory: bool = match (kind) { std::file_ops::Kind::Directory -> true, _ -> false };
        let regular: bool = match (kind) { std::file_ops::Kind::Regular -> true, _ -> false };
        if (directory) {
            if (directory_skipped(globs,entry.name,false)) { continue; }
            if (options.gitignore) {
                if (entry.name.length == 4 && entry.name.values[entry.name.start] == 46 && entry.name.values[entry.name.start + 1] == 103 && entry.name.values[entry.name.start + 2] == 105 && entry.name.values[entry.name.start + 3] == 116) { continue; }
                if (run.rules.check(run.path.as_view(),true) == ext::gitignore::IGNORED) { continue; }
            }
            if (run.levels.len() >= 512) { diagnostic.stage = 2; let status: i32 = file_failure(run,run.path.as_view(),fail(diagnostic,2,5),diagnostic,output); if (status != 0) { close_levels(run); return status; } continue; }
            let child: std::directory::Reader = std::directory::empty_directory();
            let entered = std::directory::open_at_into(fd,name,32768,child.borrow());
            if (core::result::is_err(entered)) { let status: i32 = directory_failure(run,run.path.as_view(),core::result::unwrap_err(entered),diagnostic,output); if (status != 0) { close_levels(run); return status; } continue; }
            let before: i32 = run.rules.len();
            if (options.gitignore) { let status: i32 = load_rules(run,core::option::unwrap(child.raw_handle()),run.path.len() + 1,diagnostic,output); if (status != 0) { let closed = child.close(); close_levels(run); return status; } }
            if (core::result::is_err(run.levels.try_push(Level { reader: child, length: run.path.len(), rules: before }))) { let closed = child.close(); close_levels(run); return fail(diagnostic,4,8); }
            continue;
        }
        if (!regular) { continue; }
        if (file_skipped(globs,entry.name,false)) { continue; }
        if (options.gitignore && run.rules.check(run.path.as_view(),false) == ext::gitignore::IGNORED) { continue; }
        let options_read: std::file_ops::OpenOptions = std::file_ops::options(); options_read.no_follow = true;
        let file = std::file_ops::open_at(fd,name,options_read);
        if (core::result::is_err(file)) { let status: i32 = open_failure(run,run.path.as_view(),diagnostic,output); if (status != 0) { close_levels(run); return status; } continue; }
        let opened_file: std::file::File = core::result::unwrap(file);
        let status: i32 = search_file(run,core::option::unwrap(opened_file.raw_handle()),run.path.as_view(),true,regex,matcher,filter,options,output,diagnostic);
        if (status != 0) { close_levels(run); return status; }
    }
    return 0;
}
fn close_levels(run: &Run) {
    while (run.levels.len() > 0) { let popped: Level = core::option::unwrap(run.levels.pop()); let closing: std::directory::Reader = popped.reader; let closed = closing.close(); }
}
// One command-line operand: a file is searched, a directory walked with -r.
fn operand_path(run: &Run, path: core::slice::View<u8>, implicit: bool, regex: &ext::regex::Regex, matcher: &Matcher, filter: &Filter, options: Options, globs: &Globs, output: &Output, diagnostic: &Diagnostic) -> i32 {
    let checked = core::path::from_view(path);
    if (core::result::is_err(checked)) { return open_failure(run,path,diagnostic,output); }
    let metadata: std::file_ops::Metadata = std::file_ops::empty_metadata();
    if (core::result::is_err(std::file_ops::metadata_into(core::result::unwrap(checked),true,metadata.borrow()))) { return open_failure(run,path,diagnostic,output); }
    let directory: bool = match (std::file_ops::kind(metadata.mode)) { std::file_ops::Kind::Directory -> true, _ -> false };
    if (directory) {
        if (!options.recursive) { diagnostic.stage = 2; diagnostic.offset = -1; return file_failure(run,path,fail(diagnostic,2,10),diagnostic,output); }
        if (!implicit && directory_skipped(globs,path,true)) { return 0; }
        let display: core::slice::View<u8> = path; if (implicit) { display = core::slice::View { values: path.values, start: path.start, length: 0 }; }
        return walk(run,path,display,regex,matcher,filter,options,globs,output,diagnostic);
    }
    if (file_skipped(globs,path,true)) { return 0; }
    let file = std::file_ops::open(core::result::unwrap(checked),std::file_ops::options());
    if (core::result::is_err(file)) { return open_failure(run,path,diagnostic,output); }
    let opened_file: std::file::File = core::result::unwrap(file);
    return search_file(run,core::option::unwrap(opened_file.raw_handle()),path,run.names,regex,matcher,filter,options,output,diagnostic);
}
fn files(regex: &ext::regex::Regex, matcher: &Matcher, filter: &Filter, options: Options, pattern: &Pattern, globs: &Globs, diagnostic: &Diagnostic) -> i32 {
    // As in GNU grep, --invert with an empty pattern selects nothing and
    // reads nothing.
    let source: ext::cli::Argument = core::option::unwrap(pattern.value);
    if (options.invert && source.bytes.length == 0) { return 1; }
    // Whole files are in memory: records may reach the accepted maximum
    // unless --max-line says otherwise.
    let limits: Options = options; if (!limits.line_set) { limits.max_line = 67108864; }
    let output: Output = Output { bytes: alloc::vec::new(), used: 0, number: 0, width: 0, label: alloc::vec::new(), label_length: 0, close: true };
    let run: Run = Run { buffer: alloc::vec::new(), path: alloc::vec::new(), levels: alloc::vec::new(), rules: ext::gitignore::rules(), names: pattern.files.len() > 1, any: false, failed: false };
    let status: i32 = 0;
    if (pattern.files.len() == 0) { status = operand_path(run.borrow(),literal(".",1),true,regex,matcher,filter,limits,globs,output.borrow(),diagnostic); }
    let i: i32 = 0;
    while (status == 0 && i < pattern.files.len()) {
        let item: ext::cli::Argument = pattern.files.at(i); i += 1;
        status = operand_path(run.borrow(),item.bytes,false,regex,matcher,filter,limits,globs,output.borrow(),diagnostic);
    }
    if (status == 0 && output.used > 0 && !flush(output.borrow())) { diagnostic.stage = 4; status = fail(diagnostic,3,7); }
    output.bytes.destroy(); output.label.destroy(); run.buffer.destroy(); run.path.destroy(); run.levels.destroy(); run.rules.destroy();
    if (status != 0) { return status; }
    if (run.failed) { diagnostic.reason = -1; return 2; }
    if (run.any) { return 0; } return 1;
}
// Selects (for --invert) every record in bytes[from, to), which match_lines
// found valid and not matching; to is a record start.
// --invert --count over n selected records: only the totals move.
// --count over a block of `lines` records of which `chosen` are selected.
fn count_block(progress: &Progress, chosen: u64, lines: u64, diagnostic: &Diagnostic) -> i32 {
    if (progress.selected > 18446744073709551615 - chosen || diagnostic.line > 18446744073709551615 - lines) { return fail(diagnostic,2,5); }
    progress.selected += chosen; diagnostic.line += lines; return 0;
}
fn tally(progress: &Progress, n: u64, diagnostic: &Diagnostic) -> i32 {
    if (progress.selected > 18446744073709551615 - n || diagnostic.line > 18446744073709551615 - n) { return fail(diagnostic,2,5); }
    progress.selected += n; diagnostic.line += n; return 0;
}
// Selects (for --invert) the n records of bytes[from, to), which a scan
// found valid and not matching; to is a record start. Without -n the block
// is one copy or one direct write; with -n each record gets its number on
// the way.
fn gap(bytes: [u8], from: i32, to: i32, n: u64, options: Options, progress: &Progress, output: &Output, diagnostic: &Diagnostic) -> i32 {
    if (options.count) { return tally(progress,n,diagnostic); }
    diagnostic.stage = 4; diagnostic.offset = 0;
    if (options.numbers || output.label_length > 0) { return numbered(bytes,from,to,options.numbers,progress,output,diagnostic); }
    if (progress.selected > 18446744073709551615 - n || diagnostic.line > 18446744073709551615 - n) { return fail(diagnostic,2,5); }
    // A block of 4 KiB or more is written straight from the input buffer.
    if (to - from >= 4096) {
        if (output.used > 0 && !flush(output)) { return fail(diagnostic,3,7); }
        if (!write_range(core::mem::i32_slice_data_ptr(bytes),from,to - from)) { return fail(diagnostic,3,7); }
    } else { let status: i32 = put(output,bytes,from,to - from,diagnostic); if (status != 0) { return status; } }
    progress.selected += n; diagnostic.line += n; return 0;
}
// "N:record\n" for each record of bytes[from, to), N from diagnostic.line,
// in one loop: the line number advances by one increment with carry in the
// digits kept in front of the output area.
fn numbered(bytes: [u8], from: i32, to: i32, numbers: bool, progress: &Progress, output: &Output, diagnostic: &Diagnostic) -> i32 {
    let label: [u8] = output.label.as_slice(); let named: i32 = output.label_length;
    let status: i32 = reserve(output,0,diagnostic); if (status != 0) { return status; }
    let target: [u8] = output.bytes.as_slice(); let at: i32 = 32 + output.used;
    let position: i32 = from;
    while (position < to) {
        let newline: i32 = core::search::find_byte(bytes,position,to,10); let length: i32 = newline + 1 - position;
        if (progress.selected == 18446744073709551615) { output.used = at - 32; return fail(diagnostic,2,5); } progress.selected += 1;
        if (at + 21 + named + length > 65568) { output.used = at - 32; if (!flush(output)) { return fail(diagnostic,3,7); } at = 32; }
        if (named > 0) { copy(label,0,target,at,named); at += named; }
        let value: u64 = diagnostic.line;
        if (numbers) {
        if (output.width > 0 && value == output.number + 1) {
            let i: i32 = 19; let carrying: bool = true;
            while (carrying) {
                if (i < 20 - output.width) { target[i] = 49; output.width += 1; carrying = false; }
                else { if (target[i] == 57) { target[i] = 48; i -= 1; } else { let digit: u8 = target[i] + 1; target[i] = digit; carrying = false; } }
            }
        } else {
            let d: i32 = 20; let rest: u64 = value;
            while (d == 20 || rest > 0) { d -= 1; target[d] = (48 + rest % 10) as u8; rest = rest / 10; }
            output.width = 20 - d;
        }
        output.number = value;
        let k: i32 = 20 - output.width; while (k < 20) { target[at] = target[k]; at += 1; k += 1; }
        target[at] = 58; at += 1;
        }
        if (length > 65536 - 21 - named) {
            output.used = at - 32; if (!flush(output)) { return fail(diagnostic,3,7); } at = 32;
            if (!write_range(core::mem::i32_slice_data_ptr(bytes),position,length)) { return fail(diagnostic,3,7); }
        } else { copy(bytes,position,target,at,length); at += length; }
        if (diagnostic.line == 18446744073709551615) { output.used = at - 32; return fail(diagnostic,2,5); } diagnostic.line += 1;
        position = newline + 1;
    }
    output.used = at - 32; return 0;
}
// The records of bytes[from, length): complete ones through the fast paths
// below, then record by record. cursor.start gets the start of the
// unterminated tail. Returns 0 or a failure status.
struct Cursor { start: i32 }
impl Cursor { fn borrow(&self) -> &Cursor { return self; } }
fn block(bytes: [u8], from: i32, length: i32, regex: &ext::regex::Regex, matcher: &Matcher, filter: &Filter, options: Options, progress: &Progress, output: &Output, diagnostic: &Diagnostic, cursor: &Cursor) -> i32 {
    let start: i32 = from;
    // Fast path: find the required literal across the complete records
    // and run the matcher only on the records containing it. Valid when
    // no record here can exceed the line limit or let the matcher reach
    // WorkLimit. Each gap between hit records gets one pass that checks
    // UTF-8 and counts its lines; at an invalid gap the record-by-record
    // loop below takes over, which locates the error. record() checks
    // the hit records themselves. With --invert the gap records are the
    // selected ones.
    let region: i32 = core::search::rfind_byte(bytes,from,length,10) + 1; if (region < from) { region = from; }
    let dense: bool = false;
    if (filter.length > 0 && region - from <= options.max_line && (((region - from) as i64) + 2) * filter.cost <= filter.limit) {
        let position: i32 = from; let hits: i32 = 0;
        let hit: i32 = find_pair(bytes,from,region,filter);
        // Counting a pure literal: one validating line count for the
        // whole region, then only the hits, each skipped to its LF.
        if (options.count && filter.exact) {
            let total: i64 = newlines_if_valid(bytes,from,region);
            if (total >= 0) {
