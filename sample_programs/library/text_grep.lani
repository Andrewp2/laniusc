        if (count == 0) { break; }
        length += count; filter.hit = -1; filter.end = length;
        // A read without LF only extends the unfinished record in front.
        if (core::search::find_byte(bytes,length - count,length,10) < 0) {
            if (length > options.max_line) { buffer.destroy(); diagnostic.stage = 2; diagnostic.offset = options.max_line; return fail(diagnostic,2,9); }
            continue;
        }
