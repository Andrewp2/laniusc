// gitignore rules of the open directories, and the outcome so far.
struct Run { buffer: alloc::vec::Vec<u8>, path: alloc::vec::Vec<u8>, levels: alloc::vec::Vec<Level>, rules: ext::gitignore::Rules, names: bool, any: bool, failed: bool }
impl Run { fn borrow(&self) -> &Run { return self; } }
fn view_of(bytes: alloc::vec::Vec<u8>) -> core::slice::View<u8> { return bytes.as_view(); }
// "text-grep: PATH: message" on stderr.
fn notice(path: core::slice::View<u8>, message: core::slice::View<u8>) -> bool {
    let sink: std::stream::Descriptor = std::stream::stderr();
    if (core::result::is_err(core::io::write_all(sink.borrow(),literal("text-grep: ",11).values,0,11))) { return false; }
    if (core::result::is_err(core::io::write_all(sink.borrow(),path.values,path.start,path.length))) { return false; }
    if (core::result::is_err(core::io::write_all(sink.borrow(),literal(": ",2).values,0,2))) { return false; }
    return core::result::is_ok(core::io::write_all(sink.borrow(),message.values,message.start,message.length));
