// "label count\n" into the output area.
fn put_count(output: &Output, value: u64, diagnostic: &Diagnostic) -> i32 {
    if (output.label_length > 0) { let status: i32 = put(output,output.label.as_slice(),0,output.label_length,diagnostic); if (status != 0) { return status; } }
    let status: i32 = reserve(output,21,diagnostic); if (status != 0) { return status; }
