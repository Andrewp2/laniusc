// 0, 2 for an invalid argument or 4 when a list could not grow.
fn option(options: &Options, globs: &Globs, item: ext::cli::Occurrence, diagnostic: &Diagnostic) -> i32 {
    diagnostic.argument = item.at.argument; diagnostic.offset = item.at.byte;
    if (item.id == 1) { options.invert = true; return 0; } if (item.id == 2) { options.numbers = true; return 0; }
    if (item.id == 3) { options.count = true; return 0; } if (item.id == 9) { options.help = true; return 0; }
    if (item.id == 10) { options.recursive = true; return 0; } if (item.id == 14) { options.gitignore = true; return 0; }
    let value: ext::cli::Argument = core::option::unwrap(item.value); diagnostic.argument = value.at.argument; diagnostic.offset = value.at.byte;
    if (item.id >= 11 && item.id <= 13) { if (core::result::is_err(globs.items.try_push(Glob { kind: item.id - 10, bytes: value.bytes }))) { return 4; } return 0; }
    let parsed: core::result::Result<u64,core::decimal::ParseError> = core::decimal::parse_u64_range(value.bytes.values,value.bytes.start,value.bytes.len());
    if (core::result::is_err(parsed)) { return 2; } let number: u64 = core::result::unwrap(parsed);
    if (number > 2147483647 as u64) { return 2; }
    if (item.id == 4) { if (number > 67108864 as u64) { return 2; } options.max_line = number as i32; options.line_set = true; }
    if (item.id == 5) { if (number > 65536 as u64) { return 2; } options.regex.max_pattern_bytes = number as i32; }
    if (item.id == 6) { if (number < 4 || number > 65536 as u64) { return 2; } options.regex.max_states = number as i32; }
    if (item.id == 7) { if (number > 128 as u64) { return 2; } options.regex.max_captures = number as i32; }
    if (item.id == 8) { if (number == 0) { return 2; } options.regex.max_work = number as i32; options.work_set = true; } return 0;
}
fn operand(pattern: &Pattern, item: ext::cli::Argument, diagnostic: &Diagnostic) -> i32 {
    diagnostic.argument = item.at.argument; diagnostic.offset = item.at.byte;
    if (core::option::is_some(pattern.value)) { if (core::result::is_err(pattern.files.try_push(item))) { return 4; } return 0; } pattern.value = core::option::Some(item); return 0;
}
fn process(arguments: std::args::Arguments, diagnostic: &Diagnostic) -> i32 {
    let pattern: Pattern = Pattern { value: core::option::None(), files: alloc::vec::new() };
    let globs: Globs = Globs { items: alloc::vec::new() };
    let status: i32 = parsed(arguments,pattern.borrow(),globs.borrow(),diagnostic);
    pattern.files.destroy(); globs.items.destroy(); return status;
}
fn parsed(arguments: std::args::Arguments, pattern: &Pattern, globs: &Globs, diagnostic: &Diagnostic) -> i32 {
    let specs: [ext::cli::Spec;14] = [
        ext::cli::Spec { id: 1, long: literal("invert",6), short: 118, arity: ext::cli::Arity::Flag },
        ext::cli::Spec { id: 2, long: literal("line-number",11), short: 110, arity: ext::cli::Arity::Flag },
        ext::cli::Spec { id: 3, long: literal("count",5), short: 99, arity: ext::cli::Arity::Flag },
        ext::cli::Spec { id: 4, long: literal("max-line",8), short: 0, arity: ext::cli::Arity::Required },
        ext::cli::Spec { id: 5, long: literal("max-pattern",11), short: 0, arity: ext::cli::Arity::Required },
        ext::cli::Spec { id: 6, long: literal("max-states",10), short: 0, arity: ext::cli::Arity::Required },
        ext::cli::Spec { id: 7, long: literal("max-groups",10), short: 0, arity: ext::cli::Arity::Required },
        ext::cli::Spec { id: 8, long: literal("max-work",8), short: 0, arity: ext::cli::Arity::Required },
        ext::cli::Spec { id: 9, long: literal("help",4), short: 104, arity: ext::cli::Arity::Flag },
        ext::cli::Spec { id: 10, long: literal("recursive",9), short: 114, arity: ext::cli::Arity::Flag },
        ext::cli::Spec { id: 11, long: literal("include",7), short: 0, arity: ext::cli::Arity::Required },
        ext::cli::Spec { id: 12, long: literal("exclude",7), short: 0, arity: ext::cli::Arity::Required },
        ext::cli::Spec { id: 13, long: literal("exclude-dir",11), short: 0, arity: ext::cli::Arity::Required },
        ext::cli::Spec { id: 14, long: literal("gitignore",9), short: 0, arity: ext::cli::Arity::Flag }
    ];
    let schema: core::slice::View<ext::cli::Spec> = core::result::unwrap(core::slice::view(specs,14));
    let parser: ext::cli::Parser = core::result::unwrap(ext::cli::parser(arguments.as_view(),schema,ext::cli::Ordering::Intermixed));
    let options: Options = Options { invert: false, numbers: false, count: false, max_line: 1048576, regex: ext::regex::options(), help: false, recursive: false, gitignore: false, line_set: false, work_set: false };
    while (true) {
        let event: core::result::Result<core::option::Option<ext::cli::Event>,ext::cli::Error> = parser.next();
        if (core::result::is_err(event)) {
            let location: ext::cli::Location = match (core::result::unwrap_err(event)) { ext::cli::Error::UnknownOption(at) -> at, ext::cli::Error::MissingValue(at) -> at, ext::cli::Error::UnexpectedValue(at) -> at, _ -> ext::cli::Location { argument: -1, byte: -1 } };
            diagnostic.argument = location.argument; diagnostic.offset = location.byte; return fail(diagnostic,2,0);
        }
        let next: core::option::Option<ext::cli::Event> = core::result::unwrap(event); if (core::option::is_none(next)) { break; }
        let valid: i32 = match (core::option::unwrap(next)) { ext::cli::Event::Option(value) -> option(options.borrow(),globs,value,diagnostic), ext::cli::Event::Operand(value) -> operand(pattern,value,diagnostic) };
        if (valid == 4) { return fail(diagnostic,4,8); } if (valid != 0) { return fail(diagnostic,2,0); }
    }
    if (options.help) {
        let usage: core::slice::View<u8> = literal("Usage: text-grep [-v|--invert] [-n|--line-number] [-c|--count] [-r|--recursive] [--include GLOB] [--exclude GLOB] [--exclude-dir GLOB] [--gitignore] [--max-line N] [--max-pattern N] [--max-states N] [--max-groups N] [--max-work N] [--] PATTERN [FILE...]\n",254);
        diagnostic.stage = 4; if (!write_part(usage)) { return fail(diagnostic,3,7); } return 0;
    }
    if (core::option::is_none(pattern.value)) { diagnostic.argument = -1; diagnostic.offset = -1; return fail(diagnostic,2,0); }
    let argument: ext::cli::Argument = core::option::unwrap(pattern.value); diagnostic.argument = argument.at.argument; diagnostic.stage = 1; diagnostic.offset = 0;
    if (argument.bytes.len() > options.regex.max_pattern_bytes) { return fail(diagnostic,2,5); }
    let checked: core::result::Result<core::text::Text,core::text::Error> = core::text::from_utf8_range(argument.bytes.values,argument.bytes.start,argument.bytes.len());
    if (core::result::is_err(checked)) { diagnostic.offset = match (core::result::unwrap_err(checked)) { core::text::Error::InvalidUtf8(at) -> at, _ -> -1 }; return fail(diagnostic,2,2); }
    // File operands are searched whole, so without --max-work a record's
    // budget is the accepted maximum.
    if ((options.recursive || pattern.files.len() > 0) && !options.work_set) { options.regex.max_work = 2147483647; }
    let compiled: core::result::Result<ext::regex::Regex,ext::regex::Error> = ext::regex::compile(core::result::unwrap(checked),options.regex);
    if (core::result::is_err(compiled)) { return regex_error(core::result::unwrap_err(compiled),diagnostic); }
    let regex: ext::regex::Regex = core::result::unwrap(compiled); diagnostic.argument = -1;
    let status: i32 = search(regex.borrow(),options,pattern,globs,diagnostic); regex.destroy(); return status;
}
fn write_diagnostic(diagnostic: &Diagnostic) -> bool {
    if (diagnostic.named) {
        let sink: std::stream::Descriptor = std::stream::stderr();
        if (core::result::is_err(core::io::write_all(sink.borrow(),literal("text-grep: ",11).values,0,11)) || core::result::is_err(core::io::write_all(sink.borrow(),diagnostic.path.values,diagnostic.path.start,diagnostic.path.length))) { return false; }
    }
    let storage: [i32;64] = [0;64]; let bytes: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(storage),256);
    let format: core::fmt::Formatter = core::result::unwrap(core::fmt::buffer(bytes,0,256)); if (diagnostic.named) { format.write_text(text(": ",2)); } else { format.write_text(text("text-grep: ",11)); }
    if (diagnostic.reason == 0) { format.write_text(text("invalid-arguments",17)); } if (diagnostic.reason == 2) { format.write_text(text("invalid-utf8",12)); }
    if (diagnostic.reason == 3) { format.write_text(text("invalid-regex",13)); } if (diagnostic.reason == 4) { format.write_text(text("unsupported-regex",17)); }
    if (diagnostic.reason == 5) { format.write_text(text("resource-limit",14)); } if (diagnostic.reason == 6) { format.write_text(text("work-limit",10)); }
    if (diagnostic.reason == 7) { format.write_text(text("io-failure",10)); } if (diagnostic.reason == 8) { format.write_text(text("allocation-failure",18)); }
    if (diagnostic.reason == 9) { format.write_text(text("line-limit",10)); } if (diagnostic.reason == 10) { format.write_text(text("is-a-directory",14)); }
    format.write_text(text(" stage=",7)); if (diagnostic.stage == 0) { format.write_text(text("arguments",9)); } if (diagnostic.stage == 1) { format.write_text(text("pattern",7)); }
    if (diagnostic.stage == 2) { format.write_text(text("input",5)); } if (diagnostic.stage == 3) { format.write_text(text("search",6)); } if (diagnostic.stage == 4) { format.write_text(text("output",6)); }
    if (diagnostic.line != 0) { format.write_text(text(" line=",6)); format.write_unsigned(diagnostic.line,core::fmt::decimal()); }
    if (diagnostic.argument >= 0) { format.write_text(text(" argument=",10)); format.write_signed(diagnostic.argument as i64,core::fmt::decimal()); }
    if (diagnostic.offset >= 0) { format.write_text(text(" byte=",6)); format.write_signed(diagnostic.offset as i64,core::fmt::decimal()); }
    format.write_text(text("\n",1)); let count: i32 = core::result::unwrap(format.finish()); let sink: std::stream::Descriptor = std::stream::stderr();
    return core::result::is_ok(core::io::write_all(sink.borrow(),bytes,0,count));
}
fn main() -> i32 {
    let diagnostic: Diagnostic = Diagnostic { stage: 0, reason: 0, line: 0, offset: -1, argument: -1, path: literal("",0), named: false };
    let captured: core::result::Result<std::args::Arguments,std::args::Error> = std::args::snapshot(1,64,69632); let status: i32 = 0;
    if (core::result::is_err(captured)) { status = match (core::result::unwrap_err(captured)) { std::args::Error::AllocationFailed -> fail(diagnostic.borrow(),4,8), std::args::Error::HostRead(at) -> fail(diagnostic.borrow(),3,7), _ -> fail(diagnostic.borrow(),2,0) }; }
    else { let arguments: std::args::Arguments = core::result::unwrap(captured); status = process(arguments,diagnostic.borrow()); arguments.destroy(); }
    // A file search reports each failure itself.
    if (status > 1 && diagnostic.reason >= 0 && !write_diagnostic(diagnostic.borrow())) { return 3; } return status;
}
