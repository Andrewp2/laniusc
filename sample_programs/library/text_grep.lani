            let status: i32 = 0;
            if (scan.status == 1 && valid_utf8(bytes,position,newline)) {
                diagnostic.stage = 3; diagnostic.offset = 0;
                if (!options.invert) { status = emit(bytes,position,newline,true,options,progress,output,diagnostic); }
            } else { status = record(bytes,position,newline,true,regex,matcher,options,progress,output,diagnostic); }
            if (status != 0) { return status; }
            if (diagnostic.line == 18446744073709551615) { return fail(diagnostic,2,5); } diagnostic.line += 1;
            position = newline + 1;
        }
        start = position;
    }
    while (true) {
        let newline: i32 = core::search::find_byte(bytes,start,length,10); if (newline < 0) { break; }
        if (newline - start > options.max_line) { diagnostic.stage = 2; diagnostic.offset = options.max_line; return fail(diagnostic,2,9); }
        let status: i32 = line(bytes,start,newline,true,regex,matcher,filter,options,progress,output,diagnostic);
        if (status != 0) { return status; }
        if (diagnostic.line == 18446744073709551615) { return fail(diagnostic,2,5); } diagnostic.line += 1;
        start = newline + 1;
    }
    cursor.start = start; return 0;
}
// The required-literal prefilter of regex, its literal in needle (256 bytes).
fn prepare(regex: &ext::regex::Regex, needle: [u8], filter: &Filter, diagnostic: &Diagnostic) -> i32 {
    let required: core::result::Result<i32,ext::regex::Error> = core::result::Ok(0);
    if (!regex.has_lookbehind()) { required = regex.required_literal(needle,256); }
    if (core::result::is_err(required)) { return regex_error(core::result::unwrap_err(required),diagnostic); }
    filter.needle = needle; filter.length = core::result::unwrap(required); filter.cost = regex.boundary_cost(); filter.limit = regex.search_work_limit() as i64;
    filter.hit = -1; filter.end = 0; filter.exact = false; filter.rare = 0; filter.other = 0;
    // Probe offsets as core::search::find chooses them.
    if (filter.length >= 2) {
        let k: i32 = 1;
        while (k < filter.length) { if (core::search::rank(needle[k]) < core::search::rank(needle[filter.rare])) { filter.rare = k; } k += 1; }
        filter.other = -1; k = 0;
        while (k < filter.length) {
            if (needle[k] != needle[filter.rare] && (filter.other < 0 || core::search::rank(needle[k]) < core::search::rank(needle[filter.other]))) { filter.other = k; }
            k += 1;
        }
        if (filter.other < 0) { filter.other = filter.length - 1; if (filter.other == filter.rare) { filter.other = 0; } }
    }
    // plain: the literal has no NUL, CR or LF, so a hit lies inside one
    // record's searched text.
    filter.dual = filter.length >= 2 && core::search::rank(needle[filter.rare]) >= 140;
    filter.plain = filter.length > 0; let p: i32 = 0;
    while (p < filter.length) { if (needle[p] == 0 || needle[p] == 10 || needle[p] == 13) { filter.plain = false; } p += 1; }
