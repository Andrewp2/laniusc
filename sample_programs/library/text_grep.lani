fn text_match(bytes: [u8], start: i32, end: i32, regex: &ext::regex::Regex, matcher: &Matcher) -> core::result::Result<bool,ext::regex::Error> {
    let input: core::text::Text = core::text::from_utf8_unchecked(bytes,start,end - start);
