// Bounded UTF-8 line search; compile the pattern once and reuse its owner.
// See docs/extended-text-grep.md for record, limit and failure semantics.
module app::main;
import alloc::vec;
import core::decimal;
import core::fmt;
import core::io;
import core::mem;
import core::option;
import core::result;
import core::search;
import core::slice;
import core::text;
import core::utf8;
import ext::cli;
import ext::regex;
import std::args;
import std::fs;
import std::stream;

struct Options { invert: bool, numbers: bool, count: bool, max_line: i32, regex: ext::regex::Options, help: bool }
impl Options { fn borrow(&self) -> &Options { return self; } }
struct Diagnostic { stage: i32, reason: i32, line: u64, offset: i32, argument: i32 }
impl Diagnostic { fn borrow(&self) -> &Diagnostic { return self; } }
struct Pattern { value: core::option::Option<ext::cli::Argument> }
impl Pattern { fn borrow(&self) -> &Pattern { return self; } }
struct Progress { selected: u64 }
impl Progress { fn borrow(&self) -> &Progress { return self; } }
fn literal(value: str, count: i32) -> core::slice::View<u8> {
    let bytes: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::string_data_ptr(value),count);
    return core::result::unwrap(core::slice::view(bytes,count));
}
fn text(value: str, count: i32) -> core::text::Text { let bytes: core::slice::View<u8> = literal(value,count); return core::text::from_utf8_unchecked(bytes.values,bytes.start,count); }
fn fail(diagnostic: &Diagnostic, status: i32, reason: i32) -> i32 { diagnostic.reason = reason; return status; }
fn write_part(value: core::slice::View<u8>) -> bool {
    let sink: std::stream::Descriptor = std::stream::stdout();
    return core::result::is_ok(core::io::write_all(sink.borrow(),value.values,value.start,value.len()));
}
fn write_number(value: u64, ending: core::text::Text) -> bool {
    let storage: [i32;16] = [0;16]; let bytes: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(storage),64);
    let format: core::fmt::Formatter = core::result::unwrap(core::fmt::buffer(bytes,0,64));
    format.write_unsigned(value,core::fmt::decimal()); format.write_text(ending);
    let count: i32 = core::result::unwrap(format.finish()); let view: core::slice::View<u8> = core::result::unwrap(core::slice::view(bytes,count));
    return write_part(view);
}
fn regex_error(error: ext::regex::Error, diagnostic: &Diagnostic) -> i32 {
    let status: i32 = 2; let reason: i32 = 3;
    diagnostic.offset = match (error) { ext::regex::Error::Syntax(at) -> at, ext::regex::Error::Unsupported(at) -> at, ext::regex::Error::InvalidUtf8(at) -> at, _ -> -1 };
    reason = match (error) { ext::regex::Error::Unsupported(at) -> 4, ext::regex::Error::Limit(at) -> 5, ext::regex::Error::WorkLimit -> 6, ext::regex::Error::AllocationFailed -> 8, ext::regex::Error::InvalidUtf8(at) -> 2, _ -> 3 };
    if (reason == 8) { status = 4; } return fail(diagnostic,status,reason);
}
// Record output goes straight from the packed Vec<u8> input buffer to fd 1,
// with write_all's rules: EINTR retries, a short write continues after the
// transferred bytes, zero progress or another error fails.
fn write_range(base: ptr, start: i32, count: i32) -> bool {
    let done: i32 = 0;
    while (done < count) {
        let sent: i32 = std::fs::write(1, base + ((start + done) as usize), (count - done) as usize);
        if (sent == -4) { continue; }
        if (sent <= 0 || sent > count - done) { return false; }
        done += sent;
    }
    return true;
}
// Index of the first byte >= 128 in [from, to), or to; eight bytes per step.
fn first_non_ascii(bytes: [u8], from: i32, to: i32) -> i32 {
    let i: i32 = from; let words: i32 = (to - from) / 8;
    if (words > 0) {
        // As in core::search, storage views of u64 run downward: the word at
        // byte from + 8k is element words - 1 - k.
        let view: [u64] = core::mem::typed_slice_from_storage<u64>(core::mem::i32_slice_data_ptr(bytes) + (from as usize), words);
        let k: i32 = words - 1;
        while (k >= 0) { if ((view[k] & 9259542123273814144) != 0) { break; } k -= 1; }
        i = from + (words - 1 - k) * 8;
    }
    while (i < to && bytes[i] < 128) { i += 1; }
    return i;
}
// LF count of [from, to) when the range is valid UTF-8, else -1, in one
// pass. ASCII runs go sixteen bytes per step: per-byte 0/1 flags for the
// bytes that are not LF add up in the eight byte lanes of acc, folded into
// the total every 255 words before a lane can overflow. Each non-ASCII
// sequence is checked as in valid_utf8.
fn newlines_if_valid(bytes: [u8], from: i32, to: i32) -> i64 {
    let total: u64 = 0; let i: i32 = from; let low: u64 = 9187201950435737471;
    while (true) {
        let words: i32 = (to - i) / 8;
        if (words > 0) {
            let view: [u64] = core::mem::typed_slice_from_storage<u64>(core::mem::i32_slice_data_ptr(bytes) + (i as usize), words);
            let j: i32 = words - 1; let ascii: bool = true;
            while (ascii && j >= 0) {
                let stop: i32 = j - 255; if (stop < -1) { stop = -1; }
                let top: i32 = j; let acc: u64 = 0;
                // In an ASCII word w, ((w ^ LFs) + 0x7f..7f) carries into a
                // byte's high bit exactly when that byte is not LF, and no
                // lane carries into the next; acc counts those bytes.
                while (j > stop + 1) {
                    let w: u64 = view[j]; let v: u64 = view[j - 1];
                    if (((w | v) & 9259542123273814144) != 0) { break; }
                    acc += (((w ^ 723401728380766730) + low) & 9259542123273814144) >> 7;
                    acc += (((v ^ 723401728380766730) + low) & 9259542123273814144) >> 7; j -= 2;
                }
                while (j > stop) {
                    let w: u64 = view[j];
                    if ((w & 9259542123273814144) != 0) { ascii = false; break; }
                    acc += (((w ^ 723401728380766730) + low) & 9259542123273814144) >> 7; j -= 1;
                }
                acc = (acc & 71777214294589695) + ((acc >> 8) & 71777214294589695);
                acc = acc + (acc >> 16); acc = acc + (acc >> 32);
                total += ((top - j) as u64) * 8 - (acc & 65535);
            }
            i = i + (words - 1 - j) * 8;
        }
        while (i < to && bytes[i] < 128) { if (bytes[i] == 10) { total += 1; } i += 1; }
        if (i >= to) { return total as i64; }
        let width: i32 = core::utf8::sequence_len_or(bytes[i], 0) as i32;
        if (width == 0 || width > to - i || core::result::is_err(core::text::from_utf8_range(bytes, i, width))) { return -1; }
        i += width;
    }
    return -1;
}
fn valid_utf8(bytes: [u8], from: i32, to: i32) -> bool {
    let i: i32 = first_non_ascii(bytes, from, to);
    while (i < to) {
        let width: i32 = core::utf8::sequence_len_or(bytes[i], 0) as i32;
        if (width == 0 || width > to - i || core::result::is_err(core::text::from_utf8_range(bytes, i, width))) { return false; }
        i = first_non_ascii(bytes, i + width, to);
    }
    return true;
}
// Selected records collect in one fixed 64 KiB output area, allocated at
// the first selected record and written when the next piece would not fit,
// at the end, and before any error is reported. A piece of 64 KiB or more is
// written straight from the input buffer. The 32 bytes before the area hold
// the last line number in decimal, right-aligned in [0, 20) with `width`
// digits, so the next number is usually one carry away.
struct Output { bytes: alloc::vec::Vec<u8>, used: i32, number: u64, width: i32 }
impl Output { fn borrow(&self) -> &Output { return self; } }
fn flush(output: &Output) -> bool {
    let ok: bool = write_range(output.bytes.storage,32,output.used); output.used = 0; return ok;
}
// Room for count more bytes: allocate on first use, flush when full.
fn reserve(output: &Output, count: i32, diagnostic: &Diagnostic) -> i32 {
    if (output.bytes.is_empty()) {
        let grown: core::result::Result<i32,alloc::vec::Error> = output.bytes.try_resize(65568,0);
        if (core::result::is_err(grown)) {
            let allocation: bool = match (core::result::unwrap_err(grown)) { alloc::vec::Error::AllocationFailed -> true, _ -> false };
            if (allocation) { return fail(diagnostic,4,8); } return fail(diagnostic,2,5);
        }
    }
    if (count > 65536 - output.used && output.used > 0 && !flush(output)) { return fail(diagnostic,3,7); }
    return 0;
}
// bytes[at, at + count) to target[into ..], eight bytes per step. Both are
// packed Vec<u8> storage; u64 views of equal length index alike.
fn copy(bytes: [u8], at: i32, target: [u8], into: i32, count: i32) {
    let words: i32 = count / 8;
    if (words > 0) {
        let from: [u64] = core::mem::typed_slice_from_storage<u64>(core::mem::i32_slice_data_ptr(bytes) + (at as usize), words);
        let to: [u64] = core::mem::typed_slice_from_storage<u64>(core::mem::i32_slice_data_ptr(target) + (into as usize), words);
        let k: i32 = 0; while (k < words) { to[k] = from[k]; k += 1; }
    }
    let i: i32 = words * 8; while (i < count) { target[into + i] = bytes[at + i]; i += 1; }
}
// bytes is the packed input buffer.
fn put(output: &Output, bytes: [u8], start: i32, count: i32, diagnostic: &Diagnostic) -> i32 {
    let status: i32 = reserve(output,count,diagnostic); if (status != 0) { return status; }
    if (count >= 65536) { if (!write_range(core::mem::i32_slice_data_ptr(bytes),start,count)) { return fail(diagnostic,3,7); } return 0; }
    copy(bytes,start,output.bytes.as_slice(),32 + output.used,count); output.used += count; return 0;
}
// The decimal value and a colon. The next line number increments the
// stored digits; any other value is converted afresh.
fn put_number(output: &Output, value: u64, diagnostic: &Diagnostic) -> i32 {
    let status: i32 = reserve(output,21,diagnostic); if (status != 0) { return status; }
    let target: [u8] = output.bytes.as_slice();
    if (output.width > 0 && value == output.number + 1) {
        let i: i32 = 19; let carrying: bool = true;
        while (carrying) {
            if (i < 20 - output.width) { target[i] = 49; output.width += 1; carrying = false; }
            else { if (target[i] == 57) { target[i] = 48; i -= 1; } else { let digit: u8 = target[i] + 1; target[i] = digit; carrying = false; } }
        }
    } else {
        let at: i32 = 20; let rest: u64 = value;
        while (at == 20 || rest > 0) { at -= 1; target[at] = (48 + rest % 10) as u8; rest = rest / 10; }
        output.width = 20 - at;
    }
    output.number = value;
    let into: i32 = 32 + output.used; let k: i32 = 20 - output.width;
    while (k < 20) { target[into] = target[k]; into += 1; k += 1; }
    target[into] = 58; output.used = into + 1 - 32; return 0;
}
// Selected-record bookkeeping; a terminated record keeps its LF.
fn emit(bytes: [u8], start: i32, end: i32, terminated: bool, options: Options, progress: &Progress, output: &Output, diagnostic: &Diagnostic) -> i32 {
    if (progress.selected == 18446744073709551615) { return fail(diagnostic,2,5); } progress.selected += 1;
    if (options.count) { return 0; }
    diagnostic.stage = 4;
    if (options.numbers) { let status: i32 = put_number(output,diagnostic.line,diagnostic); if (status != 0) { return status; } }
    let count: i32 = end - start; if (terminated) { count += 1; }
    return put(output,bytes,start,count,diagnostic);
}
fn record(bytes: [u8], start: i32, end: i32, terminated: bool, regex: &ext::regex::Regex, matcher: &Matcher, options: Options, progress: &Progress, output: &Output, diagnostic: &Diagnostic) -> i32 {
    diagnostic.stage = 2; diagnostic.offset = 0;
    // The word-at-a-time check decides validity; core::text locates an error.
    if (!valid_utf8(bytes,start,end)) {
        let checked: core::result::Result<core::text::Text,core::text::Error> = core::text::from_utf8_range(bytes,start,end - start);
        diagnostic.offset = match (core::result::unwrap_err(checked)) { core::text::Error::InvalidUtf8(at) -> at, _ -> -1 };
        return fail(diagnostic,2,2);
    }
    let length: i32 = end - start; if (terminated && length > 0 && bytes[end-1] == 13) { length -= 1; }
    let input: core::text::Text = core::text::from_utf8_unchecked(bytes,start,length);
    diagnostic.stage = 3;
    // The lazy DFA answers exactly what the VM would, falling back to it when needed.
    let matched: core::result::Result<bool,ext::regex::Error> = core::result::Ok(false);
    if (matcher.ready) { matched = matcher.dfa.is_match_input(regex,ext::regex::input_unchecked(input)); } else { matched = regex.is_match(input); }
    if (core::result::is_err(matched)) { return regex_error(core::result::unwrap_err(matched),diagnostic); }
    let selected: bool = core::result::unwrap(matched); if (options.invert) { selected = !selected; }
    if (!selected) { return 0; }
    return emit(bytes,start,end,terminated,options,progress,output,diagnostic);
}
// Prefilter: every match contains needle[0..length]. A record without it is
// decided without the matcher when the matcher provably could not have
// reported WorkLimit on it, the same bound the DFA uses. hit caches the next
// occurrence at or after the last search start within [.., end), or end.
// exact: the pattern is that literal alone and the literal has no CR or LF,
// so a valid record containing it matches.
struct Filter { needle: [u8], length: i32, cost: i64, limit: i64, hit: i32, end: i32, exact: bool }
impl Filter { fn borrow(&self) -> &Filter { return self; } }
fn line(bytes: [u8], start: i32, end: i32, terminated: bool, regex: &ext::regex::Regex, matcher: &Matcher, filter: &Filter, options: Options, progress: &Progress, output: &Output, diagnostic: &Diagnostic) -> i32 {
    if (filter.length > 0 && ((end - start) as i64 + 2) * filter.cost <= filter.limit) {
        if (filter.hit < start) {
            filter.hit = core::search::find(bytes,start,filter.end,filter.needle,0,filter.length);
            if (filter.hit < 0) { filter.hit = filter.end; }
        }
        if (filter.hit + filter.length > end && valid_utf8(bytes,start,end)) {
            diagnostic.stage = 3;
            if (!options.invert) { return 0; }
            return emit(bytes,start,end,terminated,options,progress,output,diagnostic);
        }
    }
    return record(bytes,start,end,terminated,regex,matcher,options,progress,output,diagnostic);
}
// A pattern without lookbehind gets a capture-free lazy DFA. Only
// Unsupported (lookbehind) leaves the VM path; a failed cache allocation is
// an allocation failure like any other, reported at the pattern stage.
struct Matcher { dfa: ext::regex::Dfa, ready: bool }
impl Matcher { fn borrow(&self) -> &Matcher { return self; } }
fn search(regex: &ext::regex::Regex, options: Options, diagnostic: &Diagnostic) -> i32 {
    let built = ext::regex::dfa(regex);
    let matcher: Matcher = Matcher { dfa: ext::regex::Dfa { set: ext::regex::prefix_set(), cost: 0, limit: 0 }, ready: false };
    if (core::result::is_ok(built)) { matcher.dfa = core::result::unwrap(built); matcher.ready = true; }
    else { let error: ext::regex::Error = core::result::unwrap_err(built); let unsupported: bool = match (error) { ext::regex::Error::Unsupported(at) -> true, _ -> false }; if (!unsupported) { return regex_error(error,diagnostic); } }
    let status: i32 = scan(regex, matcher.borrow(), options, diagnostic);
    matcher.dfa.destroy(); return status;
}
// Records are cut from one buffer filled 64 KiB at a time; the unfinished
// tail moves to the front before the next read.
fn scan(regex: &ext::regex::Regex, matcher: &Matcher, options: Options, diagnostic: &Diagnostic) -> i32 {
    let output: Output = Output { bytes: alloc::vec::new(), used: 0, number: 0, width: 0 };
    let status: i32 = records(regex,matcher,options,output.borrow(),diagnostic);
    if (output.used > 0 && !flush(output.borrow())) { diagnostic.stage = 4; status = fail(diagnostic,3,7); }
    output.bytes.destroy(); return status;
}
// Selects (for --invert) every record in bytes[from, to), which match_lines
// found valid and not matching; to is a record start.
// --invert --count over n selected records: only the totals move.
fn tally(progress: &Progress, n: u64, diagnostic: &Diagnostic) -> i32 {
    if (progress.selected > 18446744073709551615 - n || diagnostic.line > 18446744073709551615 - n) { return fail(diagnostic,2,5); }
    progress.selected += n; diagnostic.line += n; return 0;
}
// Selects (for --invert) the n records of bytes[from, to), which a scan
// found valid and not matching; to is a record start. Without -n the block
// is one copy or one direct write; with -n each record gets its number on
// the way.
fn gap(bytes: [u8], from: i32, to: i32, n: u64, options: Options, progress: &Progress, output: &Output, diagnostic: &Diagnostic) -> i32 {
    if (options.count) { return tally(progress,n,diagnostic); }
    diagnostic.stage = 4; diagnostic.offset = 0;
    if (options.numbers) { return numbered(bytes,from,to,progress,output,diagnostic); }
    if (progress.selected > 18446744073709551615 - n || diagnostic.line > 18446744073709551615 - n) { return fail(diagnostic,2,5); }
    // A block of 4 KiB or more is written straight from the input buffer.
    if (to - from >= 4096) {
        if (output.used > 0 && !flush(output)) { return fail(diagnostic,3,7); }
        if (!write_range(core::mem::i32_slice_data_ptr(bytes),from,to - from)) { return fail(diagnostic,3,7); }
    } else { let status: i32 = put(output,bytes,from,to - from,diagnostic); if (status != 0) { return status; } }
    progress.selected += n; diagnostic.line += n; return 0;
}
// "N:record\n" for each record of bytes[from, to), N from diagnostic.line,
// in one loop: the line number advances by one increment with carry in the
// digits kept in front of the output area.
fn numbered(bytes: [u8], from: i32, to: i32, progress: &Progress, output: &Output, diagnostic: &Diagnostic) -> i32 {
    let status: i32 = reserve(output,0,diagnostic); if (status != 0) { return status; }
    let target: [u8] = output.bytes.as_slice(); let at: i32 = 32 + output.used;
    let position: i32 = from;
    while (position < to) {
        let newline: i32 = core::search::find_byte(bytes,position,to,10); let length: i32 = newline + 1 - position;
        if (progress.selected == 18446744073709551615) { output.used = at - 32; return fail(diagnostic,2,5); } progress.selected += 1;
        if (at + 21 + length > 65568) { output.used = at - 32; if (!flush(output)) { return fail(diagnostic,3,7); } at = 32; }
        let value: u64 = diagnostic.line;
        if (output.width > 0 && value == output.number + 1) {
            let i: i32 = 19; let carrying: bool = true;
            while (carrying) {
                if (i < 20 - output.width) { target[i] = 49; output.width += 1; carrying = false; }
                else { if (target[i] == 57) { target[i] = 48; i -= 1; } else { let digit: u8 = target[i] + 1; target[i] = digit; carrying = false; } }
            }
        } else {
            let d: i32 = 20; let rest: u64 = value;
            while (d == 20 || rest > 0) { d -= 1; target[d] = (48 + rest % 10) as u8; rest = rest / 10; }
            output.width = 20 - d;
        }
        output.number = value;
        let k: i32 = 20 - output.width; while (k < 20) { target[at] = target[k]; at += 1; k += 1; }
        target[at] = 58; at += 1;
        if (length > 65536 - 21) {
            output.used = at - 32; if (!flush(output)) { return fail(diagnostic,3,7); } at = 32;
            if (!write_range(core::mem::i32_slice_data_ptr(bytes),position,length)) { return fail(diagnostic,3,7); }
        } else { copy(bytes,position,target,at,length); at += length; }
        if (diagnostic.line == 18446744073709551615) { output.used = at - 32; return fail(diagnostic,2,5); } diagnostic.line += 1;
        position = newline + 1;
    }
    output.used = at - 32; return 0;
}
fn records(regex: &ext::regex::Regex, matcher: &Matcher, options: Options, output: &Output, diagnostic: &Diagnostic) -> i32 {
    let storage: [i32;64] = [0;64]; let needle: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(storage),256);
    let required: core::result::Result<i32,ext::regex::Error> = core::result::Ok(0);
    if (!regex.has_lookbehind()) { required = regex.required_literal(needle,256); }
    if (core::result::is_err(required)) { return regex_error(core::result::unwrap_err(required),diagnostic); }
    let filter: Filter = Filter { needle: needle, length: core::result::unwrap(required), cost: regex.boundary_cost(), limit: regex.search_work_limit() as i64, hit: -1, end: 0, exact: false };
    if (filter.length > 0 && regex.literal_length() == filter.length) {
        filter.exact = true; let k: i32 = 0;
        while (k < filter.length) { if (needle[k] == 10 || needle[k] == 13) { filter.exact = false; } k += 1; }
    }
    let buffer: alloc::vec::Vec<u8> = alloc::vec::new();
    let source: std::stream::Descriptor = std::stream::stdin(); let progress: Progress = Progress { selected: 0 }; diagnostic.line = 1;
    let length: i32 = 0;
    while (true) {
        diagnostic.stage = 2; diagnostic.offset = length;
        // The buffer only grows; its bytes beyond length are scratch.
        let grown: core::result::Result<i32,alloc::vec::Error> = core::result::Ok(0);
        if (buffer.len() < length + 65536) { grown = buffer.try_resize(length + 65536, 0); }
        if (core::result::is_err(grown)) {
            let allocation: bool = match (core::result::unwrap_err(grown)) { alloc::vec::Error::AllocationFailed -> true, _ -> false }; buffer.destroy();
            if (allocation) { return fail(diagnostic,4,8); } return fail(diagnostic,2,5);
        }
        let bytes: [u8] = buffer.as_slice();
        // Vec<u8> storage is packed bytes, so the host reads straight into it.
        let count: i32 = std::fs::read(source.raw_handle(), buffer.storage + (length as usize), 65536 as usize);
        if (count == -4) { continue; }
        if (count < 0 || count > 65536) { buffer.destroy(); return fail(diagnostic,3,7); }
        if (count == 0) { break; }
        length += count; filter.hit = -1; filter.end = length; let start: i32 = 0;
        // Fast path: find the required literal across the complete records
        // and run the matcher only on the records containing it. Valid when
        // no record here can exceed the line limit or let the matcher reach
        // WorkLimit. Each gap between hit records gets one pass that checks
        // UTF-8 and counts its lines; at an invalid gap the record-by-record
        // loop below takes over, which locates the error. record() checks
        // the hit records themselves. With --invert the gap records are the
        // selected ones.
        let region: i32 = length; while (region > 0 && bytes[region - 1] != 10) { region -= 1; }
        let dense: bool = false;
        if (filter.length > 0 && region <= options.max_line && ((region as i64) + 2) * filter.cost <= filter.limit) {
            let position: i32 = 0; let hits: i32 = 0;
            let hit: i32 = core::search::find(bytes,0,region,filter.needle,0,filter.length);
            while (true) {
                // Hit records denser than one per 256 bytes cost more one by one
                // than one DFA pass; the line scan below takes the rest.
                if (!filter.exact && matcher.ready && hits >= 32 && (hits as i64) * 256 > position as i64) { dense = true; break; }
                let first: i32 = region;
                if (hit >= 0) { first = core::search::rfind_byte(bytes,position,hit,10) + 1; if (first < position) { first = position; } }
                let skipped: i64 = newlines_if_valid(bytes,position,first);
                if (skipped < 0) { break; }
                if (options.invert) {
                    // The records between hits lack the literal: all selected.
                    let selected: i32 = gap(bytes,position,first,skipped as u64,options,progress.borrow(),output,diagnostic);
                    if (selected != 0) { buffer.destroy(); return selected; }
                } else {
                    if (diagnostic.line > 18446744073709551615 - (skipped as u64)) { buffer.destroy(); return fail(diagnostic,2,5); } diagnostic.line += skipped as u64;
                }
