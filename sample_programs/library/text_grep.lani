fn main() -> i32 {
    let diagnostic: Diagnostic = Diagnostic { stage: 0, reason: 0, line: 0, offset: -1, argument: -1 };
    let captured: core::result::Result<std::args::Arguments,std::args::Error> = std::args::snapshot(1,64,69632); let status: i32 = 0;
    if (core::result::is_err(captured)) { status = match (core::result::unwrap_err(captured)) { std::args::Error::AllocationFailed -> fail(diagnostic.borrow(),4,8), std::args::Error::HostRead(at) -> fail(diagnostic.borrow(),3,7), _ -> fail(diagnostic.borrow(),2,0) }; }
