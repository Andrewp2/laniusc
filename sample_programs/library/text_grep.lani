fn file_failure(run: &Run, path: core::slice::View<u8>, status: i32, diagnostic: &Diagnostic, output: &Output) -> i32 {
    if (status == 4 || (status == 3 && diagnostic.stage == 4)) { return status; }
    if (output.used > 0 && !flush(output)) { diagnostic.stage = 4; return fail(diagnostic,3,7); }
    run.failed = true; diagnostic.path = path; diagnostic.named = true;
