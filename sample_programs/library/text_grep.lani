        let status: i32 = block(bytes,0,length,regex,matcher,filter,options,progress.borrow(),output,diagnostic,cursor.borrow());
        if (status != 0) { buffer.destroy(); return status; }
        let start: i32 = cursor.start;
        if (length - start > options.max_line) { buffer.destroy(); diagnostic.stage = 2; diagnostic.offset = options.max_line; return fail(diagnostic,2,9); }
        let i: i32 = start; while (i < length) { bytes[i - start] = bytes[i]; i += 1; }
        length -= start;
