    let length: i32 = 0;
    while (true) {
        diagnostic.stage = 2; diagnostic.offset = length;
        // The buffer only grows; its bytes beyond length are scratch.
        let grown: core::result::Result<i32,alloc::vec::Error> = core::result::Ok(0);
        if (buffer.len() < length + 65536) { grown = buffer.try_resize(grown_size(buffer.len(),length), 0); }
        if (core::result::is_err(grown)) {
