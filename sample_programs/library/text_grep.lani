    while (count == 0 || rest > 0) { digits[count] = (48 + rest % 10) as u8; rest = rest / 10; count += 1; }
    let at: i32 = 32 + output.used; while (count > 0) { count -= 1; target[at] = digits[count]; at += 1; }
