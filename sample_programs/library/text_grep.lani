                    let verdict: i32 = 2; let status: i32 = 0;
                    if (filter.exact) { verdict = 1; } else { if (matcher.ready) { verdict = matcher.dfa.match_lines(bytes,first,ending + 1).status; } }
                    if (verdict == 1) { diagnostic.stage = 3; diagnostic.offset = 0; status = emit(bytes,first,ending,true,options,progress,output,diagnostic); }
                    else { if (verdict == 2) { status = record(bytes,first,ending,true,regex,matcher,options,progress,output,diagnostic); } }
                    hits += 1;
                    if (status != 0) { return status; }
