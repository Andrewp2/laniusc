            let decided: i32 = 2;
            if (filter.exact) { decided = 1; } else { if (matcher.ready) { decided = matcher.dfa.match_lines(bytes,first,newline + 1).status; } }
            if (decided != 2 && valid_utf8(bytes,first,newline)) {
                diagnostic.stage = 3; diagnostic.offset = 0;
                if ((decided == 1) != options.invert) { status = emit(bytes,first,newline,true,options,progress,output,diagnostic); }
            }
            else { status = record(bytes,first,newline,true,regex,matcher,options,progress,output,diagnostic); }
            hits += 1;
