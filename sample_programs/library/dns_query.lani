// Numeric nameserver DNS query with bounded UDP/TCP transport.
module app::main;
import alloc::vec;
import core::decimal;
import core::fmt;
import core::io;
import core::mem;
import core::net;
import core::option;
import core::result;
import core::slice;
import core::text;
import core::time;
import ext::dns;
import ext::dns_client;
import std::args;
import std::clock;
import std::signal;
import std::stream;
struct Output { bytes: alloc::vec::Vec<u8>, maximum: i32, failure: i32 }
impl Output { fn borrow(&self) -> &Output { return self; } }
fn literal(value: str, count: i32) -> core::slice::View<u8> { let raw: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::string_data_ptr(value),count); return core::result::unwrap(core::slice::view(raw,count)); }
fn text(value: str, count: i32) -> core::text::Text { let raw: core::slice::View<u8> = literal(value,count); return core::text::from_utf8_unchecked(raw.values,raw.start,raw.len()); }
fn eq(v: core::slice::View<u8>, s: str, n: i32) -> bool { let other: core::slice::View<u8> = literal(s,n); if (v.len() != n) { return false; } let i: i32 = 0; while (i < n) { if (core::option::unwrap(v.get(i)) != core::option::unwrap(other.get(i))) { return false; } i += 1; } return true; }
fn write(v: core::slice::View<u8>, descriptor: i32) -> bool { let sink: std::stream::Descriptor = std::stream::from_handle(descriptor); return core::result::is_ok(core::io::write_all(sink.borrow(),v.values,v.start,v.len())); }
fn add(out: &Output, v: core::slice::View<u8>) -> bool { if (out.failure != 0) { return false; } if (v.len() > out.maximum-out.bytes.len()) { out.failure = 3; return false; } if (core::result::is_err(out.bytes.try_extend(v))) { out.failure = 4; return false; } return true; }
fn word(out: &Output, s: str, n: i32) -> bool { return add(out,literal(s,n)); }
fn number(out: &Output, n: u64) -> bool { let scratch: [u8;32] = [0;32]; let f: core::fmt::Formatter = core::result::unwrap(core::fmt::buffer(scratch,0,32)); f.write_unsigned(n,core::fmt::decimal()); let count: i32 = core::result::unwrap(f.finish()); return add(out,core::result::unwrap(core::slice::view(scratch,count))); }
fn hex_digit(n: u8) -> u8 { if (n < 10) { return n+48; } return n+87; }
fn hex(out: &Output, v: core::slice::View<u8>) -> bool { let i: i32 = 0; while (i < v.len()) { let c: u8 = core::option::unwrap(v.get(i)); let pair: [u8;2] = [hex_digit(c/16),hex_digit(c%16)]; if (!add(out,core::result::unwrap(core::slice::view(pair,2)))) { return false; } i += 1; } return true; }
fn name(out: &Output, n: ext::dns::Name) -> bool { let scratch: [u8;255] = [0;255]; let raw: core::slice::View<u8> = core::result::unwrap(core::slice::view(scratch,255)); let count: i32 = core::result::unwrap(ext::dns::expand_into(n,raw)); return hex(out,core::result::unwrap(raw.subview(0,count))); }
fn domain(out: &Output, value: ext::dns::Name) -> bool { return word(out," domain=",8) && name(out,value); }
fn mx(out: &Output, value: ext::dns::Mx) -> bool { return word(out," preference=",12) && number(out,value.preference as u64) && word(out," exchange=",10) && name(out,value.exchange); }
fn soa(out: &Output, v: ext::dns::Soa) -> bool { return word(out," primary=",9) && name(out,v.primary) && word(out," mailbox=",9) && name(out,v.mailbox) && word(out," serial=",8) && number(out,v.serial as u64) && word(out," refresh=",9) && number(out,v.refresh as u64) && word(out," retry=",7) && number(out,v.retry as u64) && word(out," expire=",8) && number(out,v.expire as u64) && word(out," minimum=",9) && number(out,v.minimum as u64); }
fn strings(out: &Output, values: ext::dns::Strings) -> bool { while (true) { let next = values.next(); if (core::option::is_none(next)) { break; } if (!word(out," txt=",5) || !hex(out,core::option::unwrap(next))) { return false; } } return true; }
fn edns(out: &Output, v: ext::dns::Edns) -> bool { if (!word(out," udp=",5) || !number(out,v.udp_size as u64) || !word(out," version=",9) || !number(out,v.version as u64) || !word(out," ext_rcode=",11) || !number(out,v.extended_rcode as u64) || !word(out," edns_flags=",12) || !number(out,v.flags as u64)) { return false; } let options: ext::dns::Options = v.option_iter(); while (true) { let next = options.next(); if (core::option::is_none(next)) { break; } let item: ext::dns::EdnsOption = core::option::unwrap(next); if (!word(out," option=",8) || !number(out,item.code as u64) || !word(out,":",1) || !hex(out,item.data)) { return false; } } return true; }
fn details(out: &Output, r: ext::dns::Record) -> bool { return match (ext::dns::data(r)) { ext::dns::Data::A(v) -> word(out," A=",3) && hex(out,v), ext::dns::Data::Aaaa(v) -> word(out," AAAA=",6) && hex(out,v), ext::dns::Data::Domain(v) -> domain(out,v), ext::dns::Data::Mail(v) -> mx(out,v), ext::dns::Data::Authority(v) -> soa(out,v), ext::dns::Data::Text(v) -> strings(out,v), ext::dns::Data::Opt(v) -> edns(out,v), ext::dns::Data::Unknown(v) -> true }; }
fn inspect(out: &Output, message: ext::dns::Message) -> bool {
    let h: ext::dns::Header = message.header;
    if (!word(out,"id=",3) || !number(out,h.id as u64) || !word(out," flags=",7) || !number(out,h.flags as u64) || !word(out," qd=",4) || !number(out,h.questions as u64) || !word(out," an=",4) || !number(out,h.answers as u64) || !word(out," ns=",4) || !number(out,h.authorities as u64) || !word(out," ar=",4) || !number(out,h.additionals as u64) || !word(out," rcode=",7) || !number(out,message.rcode() as u64) || !word(out,"\n",1)) { return false; }
    let questions: ext::dns::Questions = message.questions(); while (true) { let next = questions.next(); if (core::option::is_none(next)) { break; } let q: ext::dns::Question = core::option::unwrap(next); if (!word(out,"Q name=",7) || !name(out,q.name) || !word(out," type=",6) || !number(out,q.qtype as u64) || !word(out," class=",7) || !number(out,q.qclass as u64) || !word(out,"\n",1)) { return false; } }
    let section: i32 = 1; while (section <= 3) { let records: ext::dns::Records = message.records(section); while (true) { let next = records.next(); if (core::option::is_none(next)) { break; } let r: ext::dns::Record = core::option::unwrap(next); if (!word(out,"R section=",10) || !number(out,section as u64) || !word(out," name=",6) || !name(out,r.name) || !word(out," type=",6) || !number(out,r.rrtype as u64) || !word(out," class=",7) || !number(out,r.rrclass as u64) || !word(out," ttl=",5) || !number(out,r.ttl as u64) || !word(out," data=",6) || !hex(out,r.data) || !details(out,r) || !word(out,"\n",1)) { return false; } } section += 1; } return true;
}
fn read(input: &alloc::vec::Vec<u8>, maximum: i32) -> i32 { let source: std::stream::Descriptor = std::stream::stdin(); let storage: [i32;256] = [0;256]; let scratch: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(storage),1024); while (true) { let got = source.read(scratch,0,1024); if (core::result::is_err(got)) { if (core::io::is_interrupted(core::result::unwrap_err(got))) { continue; } return 5; } let count: i32 = core::result::unwrap(got); if (count == 0) { return 0; } if (count > maximum-input.len()) { return 3; } if (core::result::is_err(input.try_extend(core::result::unwrap(core::slice::view(scratch,count))))) { return 4; } } return 0; }
fn dotted(value: core::slice::View<u8>, owner: &alloc::vec::Vec<u8>) -> i32 {
    if (value.is_empty() || eq(value,".",1)) { if (core::result::is_err(owner.try_push(0 as u8))) { return 4; } return 0; }
    let start: i32 = 0; let pos: i32 = 0; while (pos <= value.len()) { if (pos == value.len() || core::option::unwrap(value.get(pos)) == 46) { let count: i32 = pos-start; if (count < 1 || count > 63 || count+2 > 255-owner.len()) { return 2; } if (core::result::is_err(owner.try_push(count as u8)) || core::result::is_err(owner.try_extend(core::result::unwrap(value.subview(start,pos))))) { return 4; } start = pos+1; if (start == value.len()) { break; } } pos += 1; } if (core::result::is_err(owner.try_push(0 as u8))) { return 4; } return 0;
}
fn number_arg(v: core::slice::View<u8>, maximum: u32) -> core::option::Option<i32> {
    let parsed = core::decimal::parse_u32_range(v.values,v.start,v.len()); if (parsed.is_err() || v.is_empty()) { return core::option::None(); }
    let value: u32 = parsed.unwrap(); if (value > maximum) { return core::option::None(); } return core::option::Some(value as i32);
}
fn reason(cause: ext::dns_client::Cause) -> core::text::Text { return match(cause) {
    ext::dns_client::Cause::InvalidOptions -> text("invalid-options",15), ext::dns_client::Cause::UnsupportedQuery -> text("unsupported-query",17), ext::dns_client::Cause::AllocationFailed -> text("allocation-failure",18), ext::dns_client::Cause::Timeout -> text("timeout",7), ext::dns_client::Cause::Clock(e) -> text("clock",5), ext::dns_client::Cause::Entropy(e) -> text("entropy",7), ext::dns_client::Cause::Io(e) -> text("socket",6), ext::dns_client::Cause::Dns(e) -> text("dns",3), ext::dns_client::Cause::DatagramLimit -> text("packet-limit",12), ext::dns_client::Cause::ReceivedLimit -> text("received-limit",14), ext::dns_client::Cause::WorkLimit -> text("work-limit",10), ext::dns_client::Cause::ResponseLimit -> text("response-limit",14), ext::dns_client::Cause::Correlation -> text("correlation",11), ext::dns_client::Cause::Truncated -> text("truncated",9), ext::dns_client::Cause::FrameLength(n) -> text("frame-length",12), ext::dns_client::Cause::UnexpectedEof(n) -> text("unexpected-eof",14) }; }
fn diagnostic(f: ext::dns_client::Failure) -> i32 {
    let status: i32 = match(f.cause) { ext::dns_client::Cause::AllocationFailed -> 4, ext::dns_client::Cause::Dns(e) -> match(e) { ext::dns::Error::AllocationFailed -> 4, _ -> 3 }, _ -> 3 };
    let scratch: [u8;255] = [0;255]; let out: core::fmt::Formatter = core::fmt::buffer(scratch,0,255).unwrap();
    out.write_text(text("dns-query: ",11)); out.write_text(reason(f.cause)); out.write_text(text(" stage=",7)); out.write_text(match(f.stage) { ext::dns_client::Stage::Prepare -> text("prepare",7), ext::dns_client::Stage::Entropy -> text("entropy",7), ext::dns_client::Stage::Open -> text("open",4), ext::dns_client::Stage::Connect -> text("connect",7), ext::dns_client::Stage::Send -> text("send",4), ext::dns_client::Stage::Receive -> text("receive",7), ext::dns_client::Stage::ReceivePrefix -> text("prefix",6), ext::dns_client::Stage::ReceiveBody -> text("body",4), ext::dns_client::Stage::Validate -> text("validate",8), ext::dns_client::Stage::Close -> text("close",5) }); out.write_text(text(" attempts=",10)); out.write_unsigned(f.stats.attempts as u64,core::fmt::decimal()); out.write_text(text(" packets=",9)); out.write_unsigned(f.stats.datagrams as u64,core::fmt::decimal()); if (f.cleanup.is_some()) { out.write_text(text(" cleanup-error",14)); } out.write_text(text("\n",1));
    let count: i32 = out.finish().unwrap(); if (!write(core::slice::view(scratch,count).unwrap(),2)) { return 5; } return status;
}
fn process(args: std::args::Arguments) -> i32 {
    if (args.len() == 1 && eq(args.get(0).unwrap(),"--help",6)) { if (!write(literal("Usage: dns-query ADDRESS NAME [OPTIONS]\nUse NAME - with --wire-name for binary wire name stdin.\n",96),1)) { return 5; } return 0; }
    if (args.len() < 2) { return 2; }
    let parsed = core::net::parse_socket(args.get(0).unwrap()); if (parsed.is_err()) { return 2; } let server: core::net::SocketAddr = parsed.unwrap();
    let options: ext::dns_client::Options = ext::dns_client::default_options(); let qtype: i32 = 1; let qclass: i32 = 1; let timeout: i32 = 5000; let selected: ext::dns_client::Id = ext::dns_client::Id::Random; let dnssec: bool = false; let wire: bool = false; let raw: bool = false; let max_output: i32 = 262144;
    let i: i32 = 2;
    while (i < args.len()) {
        let key: core::slice::View<u8> = args.get(i).unwrap(); i += 1;
        if (eq(key,"--wire-name",11)) { wire = true; continue; } if (eq(key,"--raw",5)) { raw = true; continue; } if (eq(key,"--dnssec",8)) { dnssec = true; continue; }
        if (i == args.len()) { return 2; } let value: core::slice::View<u8> = args.get(i).unwrap(); i += 1;
        if (eq(key,"--mode",6)) { if (eq(value,"udp",3)) { options.mode = ext::dns_client::Mode::UdpOnly; } else { if (eq(value,"tcp",3)) { options.mode = ext::dns_client::Mode::TcpOnly; } else { if (eq(value,"auto",4)) { options.mode = ext::dns_client::Mode::UdpThenTcp; } else { return 2; } } } continue; }
        let n = number_arg(value,2147483647); if (n.is_none()) { return 2; } let v: i32 = n.unwrap();
        if (eq(key,"--type",6)) { qtype = v; continue; } if (eq(key,"--class",7)) { qclass = v; continue; } if (eq(key,"--id",4)) { selected = ext::dns_client::Id::Fixed(v); continue; }
        if (eq(key,"--timeout",9)) { if (v > 60000) { return 2; } timeout = v; continue; } if (eq(key,"--attempts",10)) { options.attempts = v; continue; } if (eq(key,"--retry",7)) { options.retry_ms = v; continue; } if (eq(key,"--udp-size",10)) { options.udp_payload = v; continue; } if (eq(key,"--max-bytes",11)) { options.response_bytes = v; continue; } if (eq(key,"--max-packets",13)) { options.datagrams = v; continue; } if (eq(key,"--max-received",14)) { options.received_bytes = v as u64; continue; } if (eq(key,"--max-work",10)) { options.work = v as u64; continue; } if (eq(key,"--max-records",13)) { options.wire.records = v; continue; } if (eq(key,"--max-output",12)) { if (v > 1048576) { return 2; } max_output = v; continue; } return 2;
    }
    if (wire && !eq(args.get(1).unwrap(),"-",1)) { return 2; }
    let input: alloc::vec::Vec<u8> = alloc::vec::new(); let status: i32 = 0; if (wire) { status = read(input.borrow(),255); } else { status = dotted(args.get(1).unwrap(),input.borrow()); }
    if (status != 0) { input.destroy(); return status; }
    let now: core::result::Result<core::time::Instant,std::clock::Error> = std::clock::monotonic_now(); if (now.is_err()) { input.destroy(); return 3; }
    let shifted: core::result::Result<core::time::Instant,core::time::Error> = now.unwrap().checked_add(core::time::from_millis(timeout as u64)); if (shifted.is_err()) { input.destroy(); return 3; }
    let deadline: core::time::Deadline = core::time::deadline_at(shifted.unwrap());
    let q: ext::dns_client::Question = ext::dns_client::Question { name:input.as_view(),qtype:qtype,qclass:qclass,dnssec:dnssec,id:selected };
    let queried: core::result::Result<ext::dns_client::Response,ext::dns_client::Failure> = ext::dns_client::query_until(server,q,options,deadline); input.destroy();
    if (queried.is_err()) { return diagnostic(queried.unwrap_err()); }
    let response: ext::dns_client::Response = queried.unwrap(); let output: Output = Output { bytes:alloc::vec::new(),maximum:max_output,failure:0 };
    let ok: bool = true;
    if (raw) { ok = add(output.borrow(),response.as_view()); }
    else {
        let tcp: bool = match(response.transport) { ext::dns_client::Transport::Tcp -> true, _ -> false };
        ok = word(output.borrow(),"transport=",10); if (tcp) { ok = ok && word(output.borrow(),"tcp",3); } else { ok = ok && word(output.borrow(),"udp",3); }
        ok = ok && word(output.borrow()," attempts=",10) && number(output.borrow(),response.stats.attempts as u64) && word(output.borrow()," packets=",9) && number(output.borrow(),response.stats.datagrams as u64) && word(output.borrow()," discarded=",11) && number(output.borrow(),response.stats.discarded as u64) && word(output.borrow(),"\n",1) && inspect(output.borrow(),response.message());
    }
    response.destroy(); if (!ok) { status = output.failure; } if (status == 0 && !write(output.bytes.as_view(),1)) { status = 5; } output.bytes.destroy(); return status;
}
fn main() -> i32 {
    if (std::signal::set_disposition(std::signal::Signal::BrokenPipe,std::signal::Disposition::Ignore).is_err()) { return 5; }
    let got = std::args::snapshot(1,40,8192); if (got.is_err()) { return match(got.unwrap_err()) { std::args::Error::AllocationFailed -> 4, std::args::Error::HostRead(at) -> 5, _ -> 2 }; }
    let args: std::args::Arguments = got.unwrap(); let status: i32 = process(args); args.destroy(); return status;
}
