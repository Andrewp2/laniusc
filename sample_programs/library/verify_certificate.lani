// Explicit-anchor Ed25519 certificate path, service identity and UTC checks.
// No implicit trust store, host clock, network lookup or TLS transcript claim.
module app::main;
import alloc::io;
import core::io;
import core::mem;
import core::net;
import core::option;
import core::path;
import core::result;
import core::slice;
import ext::der;
import ext::service_identity;
import ext::x509_path;
import std::args;
import std::file;
import std::file_ops;
import std::signal;
import std::stream;

const MAX_INPUT: i32 = 1048576;
struct IoBudget { remaining: i32 }
impl IoBudget {
    fn borrow(&self) -> &IoBudget { return self; }
    fn charge(&self) -> bool { if (self.remaining==0) { return false; } self.remaining-=1; return true; }
}
fn view(bytes:[u8],start:i32,length:i32)->core::slice::View<u8>{return core::slice::View<u8>{values:bytes,start:start,length:length};}
fn same(value:core::slice::View<u8>,literal:str,count:i32)->bool{
    if(value.length!=count){return false;}let bytes:[u8]=core::mem::typed_slice_from_raw_parts(core::mem::string_data_ptr(literal),count);let i:i32=0;
    while(i<count){if(value.values[value.start+i]!=bytes[i]){return false;}i+=1;}return true;
}
fn io_status(error:core::io::Error)->i32{return match(error){core::io::Error::AllocationFailed->4,core::io::Error::LimitExceeded->7,_->3};}
fn path_status(error:ext::x509_path::Error)->i32{
    return match(error.kind){ext::x509_path::ErrorKind::ChainLimit->7,ext::x509_path::ErrorKind::AnchorLimit->7,
        ext::x509_path::ErrorKind::InputLimit->7,ext::x509_path::ErrorKind::ItemLimit->7,ext::x509_path::ErrorKind::WorkLimit->7,
        ext::x509_path::ErrorKind::SignatureLimit->7,ext::x509_path::ErrorKind::ScratchTooSmall->7,_->5};
}
// Signed decimal seconds, bounded to UTC years 1..9999 before any host I/O.
fn unix_time(value:core::slice::View<u8>)->core::option::Option<i64>{
    if(value.length==0||value.length>20){return core::option::None();}let i:i32=0;let negative:bool=false;
    if(value.values[value.start]==45){negative=true;i=1;}if(i==value.length){return core::option::None();}
    let maximum:u64=253402300799;if(negative){maximum=62135596800;}let total:u64=0;
    while(i<value.length){let byte:u8=value.values[value.start+i];if(byte<48||byte>57){return core::option::None();}
        let digit:u64=(byte-48) as u64;if(total>(maximum-digit)/10){return core::option::None();}total=total*10+digit;i+=1;}
    let signed:i64=total as i64;if(negative){signed=0-signed;}return core::option::Some(signed);
}
fn reference(mode:core::slice::View<u8>,identity:core::slice::View<u8>)->core::result::Result<ext::service_identity::Reference,ext::service_identity::Error>{
    if(same(mode,"dns",3)){return ext::service_identity::dns_reference(identity);}
    if(!same(mode,"ip",2)){return core::result::Err(ext::service_identity::Error::InvalidReference);}
    let parsed:core::result::Result<core::net::IpAddr,core::net::Error> = core::net::parse_ip(identity);
    if(parsed.is_err()){return core::result::Err(ext::service_identity::Error::InvalidIp);}let address:core::net::IpAddr=parsed.unwrap();
    let bytes:[u8;16]=[0;16];let written:core::result::Result<i32,core::net::Error> = address.write_octets(view(bytes,0,16));
    if(written.is_err()){return core::result::Err(ext::service_identity::Error::InvalidIp);}return ext::service_identity::ip_reference(view(bytes,0,written.unwrap()));
}
fn read_all<R>(source:&R,input:&alloc::io::Buffer,budget:&IoBudget)->i32 where R:core::io::Read{
    let storage:[i32;256]=[0;256];let bytes:[u8]=core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(storage),1024);
    while(true){let request:i32=MAX_INPUT-input.len();if(request>1024){request=1024;}if(request==0){request=1;}
        if(!budget.charge()){return 7;}let read:core::result::Result<i32,core::io::Error> = source.read(bytes,0,request);
        if(read.is_err()){if(core::io::is_interrupted(read.unwrap_err())){continue;}return 3;}let count:i32=read.unwrap();
        if(count<0||count>request){return 3;}if(count==0){return 0;}if(count>MAX_INPUT-input.len()){return 7;}
        let appended:core::result::Result<i32,core::io::Error> = input.write(bytes,0,count);if(appended.is_err()){return io_status(appended.unwrap_err());}if(appended.unwrap()!=count){return 3;}}
    return 3;
}
fn read_anchor(path:core::path::Path,input:&alloc::io::Buffer,budget:&IoBudget)->i32{
    let options:std::file_ops::OpenOptions=std::file_ops::options();options.access=std::file_ops::Access::Read;
    options.no_follow=true;options.nonblocking=true;options.close_on_exec=true;
    let opened:core::result::Result<std::file::File,core::io::Error> = std::file_ops::open(path,options);if(opened.is_err()){return 3;}
    let file:std::file::File=opened.unwrap();let status:i32=read_all(file.borrow(),input,budget);
    // Exactly one invalidating close attempt, before stdin; a close failure
    // overrides any read/byte/call failure, and Interrupted close is not retried.
    let closed:core::result::Result<i32,core::io::Error> = file.close();if(closed.is_err()){return 3;}return status;
}
fn validate(input:&alloc::io::Buffer,anchor_length:i32,identity:ext::service_identity::Reference,time:i64)->i32{
    let bytes:[u8]=input.as_bytes();let anchor:core::slice::View<u8> = view(bytes,0,anchor_length);
    let peer:core::slice::View<u8> = view(bytes,anchor_length,input.len()-anchor_length);
    let made:core::result::Result<ext::der::Reader,ext::der::Error> = ext::der::reader(peer);if(made.is_err()){return 5;}let reader:ext::der::Reader=made.unwrap();
    let empty:core::slice::View<u8> = view(bytes,0,0);let chain:[core::slice::View<u8>;8]=[empty;8];let count:i32=0;
    while(true){let next:core::result::Result<core::option::Option<ext::der::Element>,ext::der::Error> = reader.next();if(next.is_err()){return 5;}
        let item:core::option::Option<ext::der::Element> = next.unwrap();if(item.is_none()){break;}let element:ext::der::Element=item.unwrap();
        if(!element.tag.matches(ext::der::Class::Universal,true,16)){return 5;}if(count==8){return 7;}chain[count]=element.encoded;count+=1;}
    let anchors:[core::slice::View<u8>;1]=[anchor;1];let slot:ext::x509_path::Slot=ext::x509_path::empty_slot();let scratch:[ext::x509_path::Slot;9]=[slot;9];
    let budget_result:core::result::Result<ext::x509_path::Budget,ext::x509_path::Error> = ext::x509_path::budget(ext::x509_path::default_limits());
    if(budget_result.is_err()){return path_status(budget_result.unwrap_err());}let budget:ext::x509_path::Budget=budget_result.unwrap();
    let checked:core::result::Result<ext::x509_path::ValidatedServer,ext::x509_path::Error> = ext::x509_path::validate_server(
        core::slice::View{values:chain,start:0,length:count},core::slice::View{values:anchors,start:0,length:1},identity,time,
        core::slice::View{values:scratch,start:0,length:9},budget.borrow());
    if(checked.is_err()){return path_status(checked.unwrap_err());}
    // Only this complete path+identity+time result authorizes publication.
    // The independent copied key is intentionally not exported by this CLI.
    return 0;
}
fn process(arguments:std::args::Arguments,budget:&IoBudget)->i32{
    if(arguments.len()!=4){return 2;}let path_bytes:core::slice::View<u8> = arguments.get(0).unwrap();if(path_bytes.length==0||path_bytes.length>4095){return 2;}
    let path:core::result::Result<core::path::Path,core::path::Error> = core::path::from_view(path_bytes);if(path.is_err()){return 2;}
    let identity:core::result::Result<ext::service_identity::Reference,ext::service_identity::Error> = reference(arguments.get(1).unwrap(),arguments.get(2).unwrap());if(identity.is_err()){return 2;}
    let time:core::option::Option<i64> = unix_time(arguments.get(3).unwrap());if(time.is_none()){return 2;}
    if(std::signal::set_disposition(std::signal::Signal::BrokenPipe,std::signal::Disposition::Ignore).is_err()){return 3;}
    let made:core::result::Result<alloc::io::Buffer,core::io::Error> = alloc::io::with_limit(MAX_INPUT);if(made.is_err()){return io_status(made.unwrap_err());}let input:alloc::io::Buffer=made.unwrap();
    let reserved:core::result::Result<i32,core::io::Error> = input.try_reserve(MAX_INPUT);if(reserved.is_err()){let status:i32=io_status(reserved.unwrap_err());input.destroy();return status;}
    let status:i32=read_anchor(path.unwrap(),input.borrow(),budget);let anchor_length:i32=input.len();
    if(status==0){let source:std::stream::Descriptor=std::stream::stdin();status=read_all(source.borrow(),input.borrow(),budget);}
    if(status==0){status=validate(input.borrow(),anchor_length,identity.unwrap(),time.unwrap());}
    // No borrowed certificate/argument data survives this process result.
    input.destroy();return status;
}
fn publish(budget:&IoBudget)->i32{
    let source:[u8]=core::mem::typed_slice_from_raw_parts(core::mem::string_data_ptr("verified\n"),9);let output:std::stream::Descriptor=std::stream::stdout();let completed:i32=0;
    while(completed<9){if(!budget.charge()){return 7;}let written:core::result::Result<i32,core::io::Error> = output.write(source,completed,9-completed);
        if(written.is_err()){if(core::io::is_interrupted(written.unwrap_err())){continue;}return 3;}let count:i32=written.unwrap();if(count<=0||count>9-completed){return 3;}completed+=count;}return 0;
}
fn main()->i32{
    // Four selected args: path<=4095, mode<=3, DNS<=254, signed time<=20.
    let captured:core::result::Result<std::args::Arguments,std::args::Error> = std::args::snapshot(1,4,4372);
    if(captured.is_err()){return match(captured.unwrap_err()){std::args::Error::AllocationFailed->4,std::args::Error::HostRead(index)->3,_->2};}
    let arguments:std::args::Arguments=captured.unwrap();let budget:IoBudget=IoBudget{remaining:131072};let status:i32=process(arguments,budget.borrow());arguments.destroy();
    if(status==0){return publish(budget.borrow());}return status;
}
