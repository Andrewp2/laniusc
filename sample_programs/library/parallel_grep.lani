// Parallel fixed-string grep: `parallel_grep PATTERN < input` prints, in
// input order, every line of stdin (at most 64 MiB) that contains PATTERN,
// like `grep -F -e PATTERN`. Exit 0 when a line matched, 1 when none did,
// 2 on errors. Eight workers scan 64 KiB chunks with std::parallel::for_each;
// a line belongs to the chunk holding its first byte and is marked in a
// shared per-byte flag array, which the parent then prints sequentially.
// Build: laniusc --native-link --native-library atomic --stdlib-root stdlib
module app::main;
import core::mem;
import core::option;
import core::result;
import core::slice;
import std::args;
import std::io;
import std::parallel;
import std::sync;

const MAX_INPUT: i64 = 67108864;

struct Grep { input: ptr, length: i32, flags: ptr, pattern: core::slice::View<u8> }
impl Grep { pub fn borrow(&self) -> &Grep { return self; } }

fn contains(text: [u8], from: i32, to: i32, pattern: core::slice::View<u8>) -> bool {
    let n: i32 = pattern.length;
    let i: i32 = from;
    while (i + n <= to) {
        let k: i32 = 0;
        while (k < n && text[i + k] == pattern.values[pattern.start + k]) { k += 1; }
        if (k == n) { return true; }
        i += 1;
    }
    return false;
}

pub impl std::parallel::ChunkBody for Grep {
    pub fn run(&self, start: i32, end: i32) -> i32 {
        let text: [u8] = core::mem::typed_slice_from_raw_parts<u8>(self.input, self.length);
        let marks: [u8] = core::mem::typed_slice_from_raw_parts<u8>(self.flags, self.length);
        let s: i32 = start;
        // Skip the tail of a line that began in an earlier chunk.
        if (s > 0 && text[s - 1] != 10) { while (s < end && text[s - 1] != 10) { s += 1; } }
        while (s < end) {
            let e: i32 = s;
            while (e < self.length && text[e] != 10) { e += 1; }
            if (contains(text, s, e, self.pattern)) { marks[s] = 1; }
            s = e + 1;
        }
        return 0;
    }
}

fn main() -> i32 {
    let arguments: core::result::Result<std::args::Arguments, std::args::Error> = std::args::snapshot(1, 1, 65536);
    if (arguments.is_err() || arguments.unwrap().len() != 1) { std::io::eprintln("usage: parallel_grep PATTERN < input"); return 2; }
    let pattern: core::slice::View<u8> = arguments.unwrap().get(0).unwrap();
    let region: std::sync::Region = std::sync::map_shared((MAX_INPUT as usize) * 2 + 1048576).unwrap();
    let data: ptr = region.allocate(MAX_INPUT as usize).unwrap();
    let flags: ptr = region.allocate(MAX_INPUT as usize).unwrap();
    let length: i64 = 0;
    while (true) {
        let got: i32 = std::io::read_stdin(data + (length as usize), (MAX_INPUT - length) as usize);
        if (got < 0) { std::io::eprintln("parallel_grep: read failed"); return 2; }
        if (got == 0) { break; }
        length += got as i64;
        if (length == MAX_INPUT) { std::io::eprintln("parallel_grep: input exceeds 64 MiB"); return 2; }
    }
    let grep: Grep = Grep { input: data, length: length as i32, flags: flags, pattern: pattern };
    let plan: std::parallel::Plan = std::parallel::plan(region.borrow(), 8, 65536, std::sync::token(region.borrow()).unwrap()).unwrap();
    if (std::parallel::for_each(plan, length as i32, grep.borrow()).is_err()) { std::io::eprintln("parallel_grep: worker failed"); return 2; }
    // Print flagged lines in order, coalescing adjacent matches into one write.
    let text: [u8] = core::mem::typed_slice_from_raw_parts<u8>(data, length as i32);
    let marks: [u8] = core::mem::typed_slice_from_raw_parts<u8>(flags, length as i32);
    let n: i32 = length as i32; let s: i32 = 0; let run: i32 = -1; let matched: bool = false;
    while (s < n) {
        let e: i32 = s;
        while (e < n && text[e] != 10) { e += 1; }
        if (marks[s] == 1) { matched = true; if (run < 0) { run = s; } }
        else { if (run >= 0) { std::io::write_stdout(data + (run as usize), (s - run) as usize); run = -1; } }
        s = e + 1;
    }
    if (run >= 0) {
        let stop: i32 = n;
        std::io::write_stdout(data + (run as usize), (stop - run) as usize);
        if (text[n - 1] != 10) { std::io::write_newline(1); }
    }
    region.unmap();
    if (matched) { return 0; }
    return 1;
}
