// Bounded undirected graph diffusion via sparse Jacobi-preconditioned CG.
module app::main;
import alloc::io;
import alloc::vec;
import alloc::vec::Vec;
import core::decimal;
import core::f64;
import core::float_decimal;
import core::io;
import core::mem;
import core::option;
import core::option::Option;
import core::result;
import core::result::Result;
import core::slice;
import core::slice::View;
import core::text;
import ext::cli;
import ext::csv;
import ext::csv_write;
import ext::sparse;
import ext::sparse_matrix;
import ext::sparse_cg;
import std::args;
import std::signal;
import std::stream;

struct Input { edge:bool, node:i32, target:i32, value:f64 }
struct Options {
    nodes:i32, iterations:i32, lambda:f64, rtol:f64, atol:f64, help:bool,
    nodes_set:bool, iterations_set:bool, lambda_set:bool, rtol_set:bool, atol_set:bool
}
impl Options { fn borrow(&self) -> &Options { return self; } }
struct Writes { bytes:u64, calls:u64 }
impl Writes { fn borrow(&self) -> &Writes { return self; } }
fn literal(value:str, count:i32) -> View<u8> {
    let raw:[u8] = core::mem::typed_slice_from_raw_parts<u8>(core::mem::string_data_ptr(value),count);
    return core::slice::view(raw,count).unwrap();
}
fn text(value:View<u8>) -> core::text::Text { return core::text::from_utf8_unchecked(value.values,value.start,value.length); }
fn bytes(value:core::text::Text) -> View<u8> { return View { values:value.bytes,start:value.start,length:value.length }; }
fn equal(left:View<u8>, right:View<u8>) -> bool {
    if (left.length != right.length) { return false; } let index:i32 = 0;
    while(index < left.length) { if (left.get(index).unwrap() != right.get(index).unwrap()) { return false; } index += 1; } return true;
}
fn write(bytes:View<u8>, handle:i32, maximum:i32) -> bool {
    let sink = std::stream::from_handle(handle); let completed:i32 = 0; let calls:i32 = 0;
    while(completed < bytes.length) {
        if (calls == maximum) { return false; } calls += 1;
        let sent:core::result::Result<i32,core::io::Error> = sink.write(bytes.values,bytes.start+completed,bytes.length-completed);
        if (sent.is_err()) { if (core::io::is_interrupted(sent.unwrap_err())) { continue; } return false; }
        let count = sent.unwrap(); if (count <= 0 || count > bytes.length-completed) { return false; } completed += count;
    }
    return true;
}
fn report(status:i32) -> i32 { write(literal("graph-diffuse: operation failed\n",32),2,8); return status; }
fn csv_status(error:ext::csv::Error) -> i32 { return match(error) { ext::csv::Error::AllocationFailed -> 4, _ -> 2 }; }
fn read(input:&Vec<u8>) -> i32 {
    let source = std::stream::stdin(); let scratch:[u8;4096] = [0;4096]; let calls:i32 = 0;
    while(true) {
        if (calls == 16384) { return 2; } calls += 1;
        let remaining:i32 = 4194304-input.len(); let count:i32 = remaining;
        if (count > 4096) { count = 4096; } if (count == 0) { count = 1; }
        let received:core::result::Result<i32,core::io::Error> = source.read(scratch,0,count);
        if (received.is_err()) { if (core::io::is_interrupted(received.unwrap_err())) { continue; } return 3; }
        let got = received.unwrap(); if (got < 0 || got > count) { return 3; }
        if (got == 0) { return 0; } if (got > remaining) { return 2; }
        if (input.try_extend(core::slice::view(scratch,got).unwrap()).is_err()) { return 4; }
    }
    return 3;
}

fn limits() -> ext::sparse::Limits { return ext::sparse::Limits { max_dimension:4096,max_entries:327680,max_work:100000000 }; }
fn sparse_kind_status(kind:ext::sparse::ErrorKind) -> i32 {
    return match(kind) {
        ext::sparse::ErrorKind::AllocationFailed -> 4,
        ext::sparse::ErrorKind::NonFinite -> 6,
        ext::sparse::ErrorKind::NumericalFailure -> 6,
        _ -> 2
    };
}
fn cg_status(error:ext::sparse_cg::Error) -> i32 {
    return match(error.kind) {
        ext::sparse_cg::ErrorKind::Sparse(kind) -> sparse_kind_status(kind),
        ext::sparse_cg::ErrorKind::AllocationFailed -> 4,
        ext::sparse_cg::ErrorKind::InvalidOptions -> 2,
        ext::sparse_cg::ErrorKind::Shape -> 2,
        ext::sparse_cg::ErrorKind::Bounds -> 2,
        ext::sparse_cg::ErrorKind::EntryLimit -> 2,
        ext::sparse_cg::ErrorKind::WorkLimit -> 2,
        _ -> 6
    };
}
fn collect(input:&Vec<u8>, records:&Vec<Input>, options:&Options) -> i32 {
    let dialect = ext::csv::default_options(); dialect.max_records = 65537; dialect.max_fields = 4;
    dialect.max_field_bytes = 128; dialect.max_record_bytes = 512;
    let parsed = ext::csv::parse_bytes(input.as_slice(),0,input.len(),dialect);
    if (parsed.is_err()) { return csv_status(parsed.unwrap_err()); }
    let table = parsed.unwrap(); let status:i32 = 0;
    if (table.row_count() < 1 || table.field_count(0).unwrap() != 4) { status = 2; }
    if (status == 0 && (!equal(bytes(table.field(0,0).unwrap()),literal("kind",4)) || !equal(bytes(table.field(0,1).unwrap()),literal("source",6)) || !equal(bytes(table.field(0,2).unwrap()),literal("target",6)) || !equal(bytes(table.field(0,3).unwrap()),literal("value",5)))) { status = 2; }
    let scratch:[u32;864] = [0;864]; let workspace = core::slice::view(scratch,864).unwrap();
    let parse_limits = core::float_decimal::default_limits(); parse_limits.max_input = 128; parse_limits.max_digits = 128;
    let index:i32 = 1;
    while(status == 0 && index < table.row_count()) {
        if (table.field_count(index).unwrap() != 4) { status = 2; break; }
        let kind = bytes(table.field(index,0).unwrap()); let edge:bool = equal(kind,literal("edge",4));
        if (!edge && !equal(kind,literal("source",6))) { status = 2; break; }
        let node_bytes = bytes(table.field(index,1).unwrap());
        let node = core::decimal::parse_u64_range(node_bytes.values,node_bytes.start,node_bytes.length);
        let target_bytes = bytes(table.field(index,2).unwrap()); let target:i32 = 0;
        if (edge) {
            let parsed_target = core::decimal::parse_u64_range(target_bytes.values,target_bytes.start,target_bytes.length);
            if (parsed_target.is_err() || parsed_target.unwrap() >= (options.nodes as u64)) { status = 2; break; }
            target = parsed_target.unwrap() as i32;
        } else { if (target_bytes.length != 0) { status = 2; break; } }
        let value:Result<f64,core::float_decimal::Error> = core::float_decimal::parse_f64(bytes(table.field(index,3).unwrap()),workspace,parse_limits);
        if (node.is_err() || node.unwrap() >= (options.nodes as u64) || value.is_err()) { status = 2; break; }
        if (!core::f64::is_finite(value.unwrap()) || (edge && value.unwrap() < 0.0)) { status = 2; break; }
        if (records.try_push(Input { edge:edge,node:node.unwrap() as i32,target:target,value:value.unwrap() }).is_err()) { status = 4; break; }
        index += 1;
    }
    table.destroy(); return status;
}
fn push(triplets:&Vec<ext::sparse::Triplet>, item:ext::sparse::Triplet) -> i32 {
    if (triplets.len() == 327680) { return 2; }
    if (triplets.try_push(item).is_err()) { return 4; } return 0;
}
fn assemble(records:&Vec<Input>, options:&Options, triplets:&Vec<ext::sparse::Triplet>, rhs:&Vec<f64>) -> i32 {
    if (rhs.try_resize(options.nodes,0.0).is_err()) { return 4; }
    let node:i32 = 0;
    // Identity entries precede all edge contributions in the coalescing order.
    while(node < options.nodes) {
        let status = push(triplets,ext::sparse::Triplet { row:node,column:node,value:1.0 });
        if (status != 0) { return status; } node += 1;
    }
    let index:i32 = 0;
    while(index < records.len()) {
        let item = records.at(index);
        if (item.edge) {
            // A validated self-loop contributes zero; it needs no scaling product.
            if (item.node != item.target) {
                let scaled:f64 = options.lambda*item.value;
                if (!core::f64::is_finite(scaled)) { return 6; }
                if (scaled != 0.0) {
                    let negative:f64 = 0.0-scaled;
                    let entries:[ext::sparse::Triplet;4] = [
                        ext::sparse::Triplet { row:item.node,column:item.node,value:scaled },
                        ext::sparse::Triplet { row:item.target,column:item.target,value:scaled },
                        ext::sparse::Triplet { row:item.node,column:item.target,value:negative },
                        ext::sparse::Triplet { row:item.target,column:item.node,value:negative }
                    ];
                    let part:i32 = 0; while(part < 4) {
                        let status = push(triplets,entries[part]); if (status != 0) { return status; } part += 1;
                    }
                }
            }
        } else {
            let total:f64 = rhs.at(item.node)+item.value; if (!core::f64::is_finite(total)) { return 6; }
            if (rhs.set(item.node,total).is_err()) { return 2; }
        }
        index += 1;
    }
    return 0;
}
fn emit(output:&alloc::io::Buffer, record:&ext::csv::Record, state:&Writes, fields:View<View<u8>>) -> i32 {
    record.clear(); let index:i32 = 0;
    while(index < fields.length) {
        let pushed = record.try_push_field(text(fields.get(index).unwrap()));
        if (pushed.is_err()) { return csv_status(pushed.unwrap_err()); } index += 1;
    }
    let bounds = ext::csv_write::Limits { max_output:1048576-state.bytes,max_write_calls:65536-state.calls };
    let sent:Result<ext::csv_write::Progress,ext::csv_write::Failure> = ext::csv_write::write_record(output,record,bounds);
    if (sent.is_err()) {
        let failure = sent.unwrap_err(); state.bytes += failure.written; state.calls += failure.write_calls;
        return match(failure.cause) {
            ext::csv_write::Cause::Csv(detail) -> csv_status(detail),
            ext::csv_write::Cause::Io(detail) -> match(detail) { core::io::Error::AllocationFailed -> 4, _ -> 2 },
            _ -> 2
        };
    }
    let progress = sent.unwrap(); state.bytes += progress.written; state.calls += progress.write_calls; return 0;
}
fn render(mass:&Vec<f64>, output:&alloc::io::Buffer) -> i32 {
    let record = ext::csv::new(); let state = Writes { bytes:0,calls:0 };
    let header:[View<u8>;2] = [literal("node",4),literal("value",5)];
    let status:i32 = emit(output,record.borrow(),state.borrow(),core::slice::view(header,2).unwrap());
    let scratch:[u32;864] = [0;864]; let workspace = core::slice::view(scratch,864).unwrap(); let row:i32 = 0;
    while(status == 0 && row < mass.len()) {
        let value = mass.at(row); if (!core::f64::is_finite(value)) { status = 6; break; }
        let node:[u8;10] = [0;10]; let number:[u8;32] = [0;32];
        let node_count = core::decimal::format_u32(node,0,10,row as u32);
        let value_count = core::float_decimal::format_f64_into(value,core::slice::view(number,32).unwrap(),workspace,1000000);
        if (node_count.is_err() || value_count.is_err()) { status = 6; break; }
        let fields:[View<u8>;2] = [core::slice::view(node,node_count.unwrap()).unwrap(),core::slice::view(number,value_count.unwrap()).unwrap()];
        status = emit(output,record.borrow(),state.borrow(),core::slice::view(fields,2).unwrap()); row += 1;
    }
    record.destroy(); return status;
}
fn solve(records:&Vec<Input>, options:&Options, output:&alloc::io::Buffer) -> i32 {
    let triplets:Vec<ext::sparse::Triplet> = alloc::vec::new(); let rhs:Vec<f64> = alloc::vec::new();
    let status:i32 = assemble(records,options,triplets.borrow(),rhs.borrow());
    if (status != 0) { triplets.destroy(); rhs.destroy(); return status; }
    let made:Result<ext::sparse_matrix::Matrix,ext::sparse::Error> = ext::sparse_matrix::from_triplets(options.nodes,options.nodes,triplets.as_view(),limits());
    triplets.destroy(); if (made.is_err()) { rhs.destroy(); return sparse_kind_status(made.unwrap_err().kind); }
    let matrix = made.unwrap(); let initial:Vec<f64> = alloc::vec::new();
    if (initial.try_resize(options.nodes,0.0).is_err()) { initial.destroy(); matrix.destroy(); rhs.destroy(); return 4; }
    let cg_options = ext::sparse_cg::Options { max_iterations:options.iterations,rtol:options.rtol,atol:options.atol,preconditioner:ext::sparse_cg::Preconditioner::Jacobi };
    let solved:Result<ext::sparse_cg::Solution,ext::sparse_cg::Error> = ext::sparse_cg::solve(matrix.view(),rhs.as_view(),initial.as_view(),cg_options,limits());
    initial.destroy(); matrix.destroy(); rhs.destroy();
    if (solved.is_err()) { return cg_status(solved.unwrap_err()); } let solution = solved.unwrap();
    let converged:bool = match(solution.stop) { ext::sparse_cg::Stop::Converged -> true, _ -> false };
    status = 6;
    if (converged && core::f64::is_finite(solution.residual_norm) && core::f64::is_finite(solution.rhs_norm)) { status = render(solution.x.borrow(),output); }
    solution.destroy(); return status;
}
fn run(options:&Options) -> i32 {
    let input:Vec<u8> = alloc::vec::new(); let records:Vec<Input> = alloc::vec::new();
    let status:i32 = read(input.borrow());
    if (status == 0) { status = collect(input.borrow(),records.borrow(),options); } input.destroy();
    if (status != 0) { records.destroy(); return status; }
    let made = alloc::io::with_limit(1048576); if (made.is_err()) { records.destroy(); return 4; }
    let output = made.unwrap(); status = solve(records.borrow(),options,output.borrow()); records.destroy();
    if (status == 0 && !write(core::slice::view(output.as_bytes(),output.len()).unwrap(),1,8192)) { status = 5; }
    output.destroy(); return status;
}
fn arguments(values:View<View<u8>>) -> i32 {
    let specs:[ext::cli::Spec;6] = [
        ext::cli::Spec { id:1,long:literal("help",4),short:104,arity:ext::cli::Arity::Flag },
        ext::cli::Spec { id:2,long:literal("nodes",5),short:110,arity:ext::cli::Arity::Required },
        ext::cli::Spec { id:3,long:literal("iterations",10),short:107,arity:ext::cli::Arity::Required },
        ext::cli::Spec { id:4,long:literal("lambda",6),short:0,arity:ext::cli::Arity::Required },
        ext::cli::Spec { id:5,long:literal("rtol",4),short:0,arity:ext::cli::Arity::Required },
        ext::cli::Spec { id:6,long:literal("atol",4),short:0,arity:ext::cli::Arity::Required }
    ];
    let made = ext::cli::parser(values,core::slice::view(specs,6).unwrap(),ext::cli::Ordering::Intermixed); if (made.is_err()) { return report(2); }
    let parser = made.unwrap();
    let options = Options { nodes:0,iterations:100,lambda:1.0,rtol:0.0000000001,atol:0.0,help:false,nodes_set:false,iterations_set:false,lambda_set:false,rtol_set:false,atol_set:false };
    let scratch:[u32;864] = [0;864]; let workspace = core::slice::view(scratch,864).unwrap();
    let parse_limits = core::float_decimal::default_limits(); parse_limits.max_input = 128; parse_limits.max_digits = 128;
    while(true) {
        let event = parser.next(); if (event.is_err()) { return report(2); } let next = event.unwrap(); if (next.is_none()) { break; }
        let item:Option<ext::cli::Occurrence> = match(next.unwrap()) { ext::cli::Event::Option(value) -> core::option::Some(value), _ -> core::option::None() };
        if (item.is_none()) { return report(2); } let found = item.unwrap();
        if (found.id == 1) { if (options.help) { return report(2); } options.help = true; }
        if (found.id == 2 || found.id == 3) {
            let value = found.value.unwrap().bytes; let parsed = core::decimal::parse_u64_range(value.values,value.start,value.length);
            if (parsed.is_err()) { return report(2); } let number:u64 = parsed.unwrap();
            if (found.id == 2) { if (options.nodes_set || number < 1 || number > 4096) { return report(2); } options.nodes_set = true; options.nodes = number as i32; }
            if (found.id == 3) { if (options.iterations_set || number > 1000) { return report(2); } options.iterations_set = true; options.iterations = number as i32; }
        }
        if (found.id == 4 || found.id == 5 || found.id == 6) {
            let value = found.value.unwrap().bytes;
            let parsed:Result<f64,core::float_decimal::Error> = core::float_decimal::parse_f64(value,workspace,parse_limits);
            if (parsed.is_err() || !core::f64::is_finite(parsed.unwrap()) || parsed.unwrap() < 0.0) { return report(2); }
            let number:f64 = parsed.unwrap();
            if (found.id == 4) { if (options.lambda_set) { return report(2); } options.lambda_set = true; options.lambda = number; }
            if (found.id == 5) { if (options.rtol_set) { return report(2); } options.rtol_set = true; options.rtol = number; }
            if (found.id == 6) { if (options.atol_set) { return report(2); } options.atol_set = true; options.atol = number; }
        }
    }
    if (options.help) {
        let help = literal("Usage: graph-diffuse --nodes N [--lambda V] [--iterations K] [--rtol V] [--atol V] [--help]\nRead CSV kind,source,target,value: edge,u,v,weight or source,node,,value.\nSolve (I + lambda*L)x=b with Jacobi CG; edge weights are finite and nonnegative.\nNodes: 1..4096; iterations: 0..1000 (default 100); lambda: finite >=0 (default 1).\nTolerances: finite >=0; rtol default 1e-10, atol default 0. Sources may be signed.\nShort options: -n N, -k K, -h. Limits: 4 MiB input, 65536 records, 1 MiB staged output.\n",501);
        if (!write(help,1,64)) { return report(5); } return 0;
    }
    if (!options.nodes_set) { return report(2); }
    let status = run(options.borrow()); if (status != 0) { return report(status); } return 0;
}
fn main() -> i32 {
    if (std::signal::set_disposition(std::signal::Signal::BrokenPipe,std::signal::Disposition::Ignore).is_err()) { return 5; }
    let captured = std::args::snapshot(1,24,1024);
    if (captured.is_err()) { return report(match(captured.unwrap_err()) { std::args::Error::AllocationFailed -> 4, std::args::Error::HostRead(index) -> 3, _ -> 2 }); }
    let values = captured.unwrap(); let status = arguments(values.as_view()); values.destroy(); return status;
}
