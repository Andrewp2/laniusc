// Persist byte keys and binary stdin values through prepared SQLite statements.
// Exit 2: arguments/limits; 3: I/O; 4: SQLite/allocation; 5: key not found.
module app::main;
import alloc::vec;
import core::decimal;
import core::io;
import core::mem;
import core::option;
import core::result;
import core::slice;
import core::text;
import ext::cli;
import ext::sqlite;
import std::args;
import std::stream;

enum Command { Missing, Put, Get, Delete, Count }
enum AppError { InputLimit, OutputLimit, CallLimit, InputIo, OutputIo, Allocation, Busy, Constraint, ReadOnly, Database, NotFound }
struct Budget { remaining: i32 }
impl Budget { fn borrow(&self) -> &Budget { return self; } }
struct Options { database: core::slice::View<u8>, command: Command, key: core::slice::View<u8>, operands: i32, help: bool, max_input: i32, max_output: i32, max_io_calls: i32 }
impl Options { fn borrow(&self) -> &Options { return self; } }
fn literal(text: str, count: i32) -> core::slice::View<u8> {
    let bytes: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::string_data_ptr(text),count);
    return core::result::unwrap(core::slice::view(bytes,count));
}
fn equal(left: core::slice::View<u8>, right: core::slice::View<u8>) -> bool {
    if (left.len() != right.len()) { return false; }
    let index: i32 = 0;
    while (index < left.len()) {
        if (core::option::unwrap(left.get(index)) != core::option::unwrap(right.get(index))) { return false; }
        index += 1;
    }
    return true;
}
fn sqlite_error(error: ext::sqlite::Error) -> AppError {
    let allocation: bool = match (error.cause) { ext::sqlite::Cause::AllocationFailed -> true, _ -> false };
    if (allocation) { return AppError::Allocation; }
    if (ext::sqlite::is_busy(error)) { return AppError::Busy; }
    let readonly: bool = match (error.cause) { ext::sqlite::Cause::ReadOnly -> true, _ -> false };
    let code: i32 = ext::sqlite::primary_code(error);
    if (code == 6) { return AppError::Busy; }
    if (readonly || code == 8) { return AppError::ReadOnly; }
    if (code == 19) { return AppError::Constraint; }
    return AppError::Database;
}
fn column_error(error: ext::sqlite::Error) -> AppError {
    let limited: bool = match (error.cause) { ext::sqlite::Cause::Limit -> true, ext::sqlite::Cause::OutputTooSmall -> true, _ -> false };
    if (limited) { return AppError::OutputLimit; }
    return sqlite_error(error);
}
fn write_bounded<W>(writer: &W, bytes: core::slice::View<u8>, budget: &Budget) -> core::result::Result<i32,AppError>
    where W: core::io::Write {
    let completed: i32 = 0;
    while (completed < bytes.len()) {
        if (budget.remaining == 0) { return core::result::Err(AppError::CallLimit); }
        budget.remaining -= 1;
        let attempt: core::result::Result<i32,core::io::Error> = writer.write(bytes.values,bytes.start + completed,bytes.len() - completed);
        if (core::result::is_err(attempt)) {
            if (core::io::is_interrupted(core::result::unwrap_err(attempt))) { continue; }
            return core::result::Err(AppError::OutputIo);
        }
        let written: i32 = core::result::unwrap(attempt);
        if (written <= 0 || written > bytes.len() - completed) { return core::result::Err(AppError::OutputIo); }
        completed += written;
    }
    return core::result::Ok(completed);
}
// A one-byte EOF probe distinguishes an exact limit from excess input. Every
// attempt spends budget, including EINTR. Errors destroy the partial value.
fn read_input<R>(reader: &R, maximum: i32, budget: &Budget) -> core::result::Result<alloc::vec::Vec<u8>,AppError>
    where R: core::io::Read {
    let value: alloc::vec::Vec<u8> = alloc::vec::new();
    let scratch: [u8; 1024] = [0; 1024];
    while (true) {
        if (budget.remaining == 0) { value.destroy(); return core::result::Err(AppError::CallLimit); }
        budget.remaining -= 1;
        let amount: i32 = 1024;
        if (maximum - value.len() < 1024) { amount = maximum - value.len() + 1; }
        let attempt: core::result::Result<i32,core::io::Error> = reader.read(scratch,0,amount);
        if (core::result::is_err(attempt)) {
            if (core::io::is_interrupted(core::result::unwrap_err(attempt))) { continue; }
            value.destroy(); return core::result::Err(AppError::InputIo);
        }
        let received: i32 = core::result::unwrap(attempt);
        if (received < 0 || received > amount) { value.destroy(); return core::result::Err(AppError::InputIo); }
        if (received == 0) { return core::result::Ok(value); }
        if (received > maximum - value.len()) { value.destroy(); return core::result::Err(AppError::InputLimit); }
        let chunk: core::slice::View<u8> = core::result::unwrap(core::slice::view(scratch,received));
        if (core::result::is_err(value.try_extend(chunk))) { value.destroy(); return core::result::Err(AppError::Allocation); }
    }
    return core::result::Ok(value);
}
fn report(status: i32, message: core::slice::View<u8>) -> i32 {
    let sink: std::stream::Descriptor = std::stream::stderr();
    let budget: Budget = Budget { remaining: 8 };
    write_bounded(sink.borrow(),message,budget.borrow());
    return status;
}
fn report_error(error: AppError) -> i32 {
    return match (error) {
        AppError::InputLimit -> report(2,literal("sqlite-kv: input limit exceeded\n",32)),
        AppError::OutputLimit -> report(2,literal("sqlite-kv: output limit exceeded\n",33)),
        AppError::CallLimit -> report(2,literal("sqlite-kv: I/O call limit exceeded\n",35)),
        AppError::InputIo -> report(3,literal("sqlite-kv: input I/O failed\n",28)),
        AppError::OutputIo -> report(3,literal("sqlite-kv: output I/O failed\n",29)),
        AppError::Allocation -> report(4,literal("sqlite-kv: allocation failed\n",29)),
        AppError::Busy -> report(4,literal("sqlite-kv: database busy or locked\n",35)),
        AppError::Constraint -> report(4,literal("sqlite-kv: database constraint failed\n",38)),
        AppError::ReadOnly -> report(4,literal("sqlite-kv: database is read-only\n",33)),
        AppError::Database -> report(4,literal("sqlite-kv: database operation failed\n",37)),
        AppError::NotFound -> report(5,literal("sqlite-kv: key not found\n",25))
    };
}
fn done(step: ext::sqlite::Step) -> bool {
    return match (step) { ext::sqlite::Step::Done -> true, ext::sqlite::Step::Row -> false };
}
// Finalize consumes the statement even if the preceding step failed. Preserve
// that first error; otherwise report finalization errors before publishing.
fn finish(statement: &ext::sqlite::Statement, result: core::result::Result<i32,AppError>) -> core::result::Result<i32,AppError> {
    let finalized: core::result::Result<i32,ext::sqlite::Error> = statement.finalize();
    if (core::result::is_err(result)) { return result; }
    if (core::result::is_err(finalized)) { return core::result::Err(sqlite_error(core::result::unwrap_err(finalized))); }
    return result;
}
fn execute(database: &ext::sqlite::Database, sql: core::slice::View<u8>) -> core::result::Result<i32,AppError> {
    let prepared: core::result::Result<ext::sqlite::Statement,ext::sqlite::Error> = database.prepare(sql);
    if (core::result::is_err(prepared)) { return core::result::Err(sqlite_error(core::result::unwrap_err(prepared))); }
    let statement: ext::sqlite::Statement = core::result::unwrap(prepared);
    let stepped: core::result::Result<ext::sqlite::Step,ext::sqlite::Error> = statement.step();
    let result: core::result::Result<i32,AppError> = core::result::Ok(0);
    if (core::result::is_err(stepped)) { result = core::result::Err(sqlite_error(core::result::unwrap_err(stepped))); }
    else { if (!done(core::result::unwrap(stepped))) { result = core::result::Err(AppError::Database); } }
    return finish(statement.borrow(),result);
}
fn mutate(database: &ext::sqlite::Database, command: Command, key: core::slice::View<u8>, value: core::slice::View<u8>) -> core::result::Result<i32,AppError> {
    let putting: bool = match (command) { Command::Put -> true, _ -> false };
    let sql: core::slice::View<u8> = literal("DELETE FROM kv WHERE key = ?1",29);
    if (putting) { sql = literal("INSERT INTO kv (key,value) VALUES (?1,?2) ON CONFLICT(key) DO UPDATE SET value=excluded.value",93); }
    let prepared: core::result::Result<ext::sqlite::Statement,ext::sqlite::Error> = database.prepare(sql);
    if (core::result::is_err(prepared)) { return core::result::Err(sqlite_error(core::result::unwrap_err(prepared))); }
    let statement: ext::sqlite::Statement = core::result::unwrap(prepared);
    let bound: core::result::Result<i32,ext::sqlite::Error> = statement.bind_blob(1,key);
    if (core::result::is_err(bound)) { return finish(statement.borrow(),core::result::Err(sqlite_error(core::result::unwrap_err(bound)))); }
    if (putting) {
        bound = statement.bind_blob(2,value);
        if (core::result::is_err(bound)) { return finish(statement.borrow(),core::result::Err(sqlite_error(core::result::unwrap_err(bound)))); }
    }
    let stepped: core::result::Result<ext::sqlite::Step,ext::sqlite::Error> = statement.step();
    if (core::result::is_err(stepped)) { return finish(statement.borrow(),core::result::Err(sqlite_error(core::result::unwrap_err(stepped)))); }
    if (!done(core::result::unwrap(stepped))) { return finish(statement.borrow(),core::result::Err(AppError::Database)); }
    let finalized: core::result::Result<i32,AppError> = finish(statement.borrow(),core::result::Ok(0));
    if (core::result::is_err(finalized)) { return finalized; }
    if (!putting) {
        let changes: core::result::Result<i64,ext::sqlite::Error> = database.changes();
        if (core::result::is_err(changes)) { return core::result::Err(sqlite_error(core::result::unwrap_err(changes))); }
        if (core::result::unwrap(changes) == 0) { return core::result::Err(AppError::NotFound); }
    }
    return core::result::Ok(0);
}
fn query_row(statement: &ext::sqlite::Statement, counting: bool, maximum: i32) -> core::result::Result<alloc::vec::Vec<u8>,AppError> {
    let stepped: core::result::Result<ext::sqlite::Step,ext::sqlite::Error> = statement.step();
    if (core::result::is_err(stepped)) { return core::result::Err(sqlite_error(core::result::unwrap_err(stepped))); }
    if (done(core::result::unwrap(stepped))) { return core::result::Err(AppError::NotFound); }
    let length: i32 = 0;
    let count: i64 = 0;
    if (counting) {
        let column: core::result::Result<i64,ext::sqlite::Error> = statement.column_i64(0);
        if (core::result::is_err(column)) { return core::result::Err(column_error(core::result::unwrap_err(column))); }
        count = core::result::unwrap(column);
        if (count < 0) { return core::result::Err(AppError::Database); }
        length = (core::decimal::len_i64(count) as i32) + 1;
    } else {
        let column: core::result::Result<i32,ext::sqlite::Error> = statement.column_blob_len(0);
        if (core::result::is_err(column)) { return core::result::Err(column_error(core::result::unwrap_err(column))); }
        length = core::result::unwrap(column);
    }
    if (length > maximum) { return core::result::Err(AppError::OutputLimit); }
    let allocated: core::result::Result<alloc::vec::Vec<u8>,alloc::vec::Error> = alloc::vec::with_capacity<u8>(length);
    if (core::result::is_err(allocated)) { return core::result::Err(AppError::Allocation); }
    let output: alloc::vec::Vec<u8> = core::result::unwrap(allocated);
    if (core::result::is_err(output.try_resize(length,0))) { output.destroy(); return core::result::Err(AppError::Allocation); }
    if (counting) {
        let index: i32 = 0;
        while (index < length - 1) { core::result::unwrap(output.set(index,core::decimal::byte_at_or_i64(count,index as u32,0))); index += 1; }
        core::result::unwrap(output.set(length - 1,10 as u8));
    } else {
        let copied: core::result::Result<i32,ext::sqlite::Error> = statement.column_blob_copy(0,output.as_view());
        if (core::result::is_err(copied)) { output.destroy(); return core::result::Err(column_error(core::result::unwrap_err(copied))); }
        if (core::result::unwrap(copied) != length) { output.destroy(); return core::result::Err(AppError::Database); }
    }
    stepped = statement.step();
    if (core::result::is_err(stepped)) { output.destroy(); return core::result::Err(sqlite_error(core::result::unwrap_err(stepped))); }
    if (!done(core::result::unwrap(stepped))) { output.destroy(); return core::result::Err(AppError::Database); }
    return core::result::Ok(output);
}
fn query(database: &ext::sqlite::Database, command: Command, key: core::slice::View<u8>, maximum: i32) -> core::result::Result<alloc::vec::Vec<u8>,AppError> {
    let counting: bool = match (command) { Command::Count -> true, _ -> false };
    let sql: core::slice::View<u8> = literal("SELECT value FROM kv WHERE key = ?1",35);
    if (counting) { sql = literal("SELECT count(*) FROM kv",23); }
    let prepared: core::result::Result<ext::sqlite::Statement,ext::sqlite::Error> = database.prepare(sql);
    if (core::result::is_err(prepared)) { return core::result::Err(sqlite_error(core::result::unwrap_err(prepared))); }
    let statement: ext::sqlite::Statement = core::result::unwrap(prepared);
    if (!counting) {
        let bound: core::result::Result<i32,ext::sqlite::Error> = statement.bind_blob(1,key);
        if (core::result::is_err(bound)) { statement.finalize(); return core::result::Err(sqlite_error(core::result::unwrap_err(bound))); }
    }
    let queried: core::result::Result<alloc::vec::Vec<u8>,AppError> = query_row(statement.borrow(),counting,maximum);
    let finalized: core::result::Result<i32,ext::sqlite::Error> = statement.finalize();
    if (core::result::is_err(queried)) { return queried; }
    if (core::result::is_err(finalized)) {
        let output: alloc::vec::Vec<u8> = core::result::unwrap(queried); output.destroy();
        return core::result::Err(sqlite_error(core::result::unwrap_err(finalized)));
    }
    return queried;
}
fn database_operation(database: &ext::sqlite::Database, options: &Options, input: core::slice::View<u8>) -> core::result::Result<alloc::vec::Vec<u8>,AppError> {
    let putting: bool = match (options.command) { Command::Put -> true, _ -> false };
    let deleting: bool = match (options.command) { Command::Delete -> true, _ -> false };
    if (putting) {
        let created: core::result::Result<i32,AppError> = execute(database,literal("CREATE TABLE IF NOT EXISTS kv (key BLOB PRIMARY KEY NOT NULL,value BLOB NOT NULL) WITHOUT ROWID",95));
        if (core::result::is_err(created)) { return core::result::Err(core::result::unwrap_err(created)); }
    }
    if (putting || deleting) {
        let changed: core::result::Result<i32,AppError> = mutate(database,options.command,options.key,input);
        if (core::result::is_err(changed)) { return core::result::Err(core::result::unwrap_err(changed)); }
        let empty: alloc::vec::Vec<u8> = alloc::vec::new(); return core::result::Ok(empty);
    }
    return query(database,options.command,options.key,options.max_output);
}
fn process(options: &Options) -> i32 {
    let budget: Budget = Budget { remaining: options.max_io_calls };
    let input: alloc::vec::Vec<u8> = alloc::vec::new();
    let putting: bool = match (options.command) { Command::Put -> true, _ -> false };
    let deleting: bool = match (options.command) { Command::Delete -> true, _ -> false };
    if (putting) {
        let source: std::stream::Descriptor = std::stream::stdin();
        let captured: core::result::Result<alloc::vec::Vec<u8>,AppError> = read_input(source.borrow(),options.max_input,budget.borrow());
        if (core::result::is_err(captured)) { return report_error(core::result::unwrap_err(captured)); }
        input = core::result::unwrap(captured);
    }
    let mode: ext::sqlite::Mode = ext::sqlite::Mode::ReadOnly;
    if (putting) { mode = ext::sqlite::Mode::Create; }
    if (deleting) { mode = ext::sqlite::Mode::ReadWrite; }
    let opened: core::result::Result<ext::sqlite::Database,ext::sqlite::Error> = ext::sqlite::open(options.database,mode,ext::sqlite::default_limits());
    if (core::result::is_err(opened)) { input.destroy(); return report_error(sqlite_error(core::result::unwrap_err(opened))); }
    let database: ext::sqlite::Database = core::result::unwrap(opened);
    let result: core::result::Result<alloc::vec::Vec<u8>,AppError> = database_operation(database.borrow(),options,input.as_view());
    input.destroy();
    let closed: core::result::Result<i32,ext::sqlite::Error> = database.close();
    if (core::result::is_err(result)) { return report_error(core::result::unwrap_err(result)); }
    let output: alloc::vec::Vec<u8> = core::result::unwrap(result);
    if (core::result::is_err(closed)) { output.destroy(); return report_error(sqlite_error(core::result::unwrap_err(closed))); }
    let sink: std::stream::Descriptor = std::stream::stdout();
    let written: core::result::Result<i32,AppError> = write_bounded(sink.borrow(),output.as_view(),budget.borrow());
    output.destroy();
    if (core::result::is_err(written)) { return report_error(core::result::unwrap_err(written)); }
    return 0;
}
fn apply(options: &Options, item: ext::cli::Occurrence) -> bool {
    if (item.id == 1) { options.help = true; return true; }
    let argument: ext::cli::Argument = core::option::unwrap(item.value);
    let bytes: core::slice::View<u8> = argument.bytes;
    let parsed: core::result::Result<u64,core::decimal::ParseError> = core::decimal::parse_u64_range(bytes.values,bytes.start,bytes.len());
    if (core::result::is_err(parsed)) { return false; }
    let value: u64 = core::result::unwrap(parsed);
    if (value > 2147483647 as u64) { return false; }
    if (item.id == 2 || item.id == 3) { if (value > 16777216 as u64) { return false; } }
    if (item.id == 2) { options.max_input = value as i32; }
    if (item.id == 3) { options.max_output = value as i32; }
    if (item.id == 4) { options.max_io_calls = value as i32; }
    return true;
}
fn operand(options: &Options, bytes: core::slice::View<u8>) -> bool {
    if (options.operands == 0) { options.database = bytes; }
    if (options.operands == 1) {
        if (equal(bytes,literal("put",3))) { options.command = Command::Put; }
        else { if (equal(bytes,literal("get",3))) { options.command = Command::Get; }
        else { if (equal(bytes,literal("delete",6))) { options.command = Command::Delete; }
        else { if (equal(bytes,literal("count",5))) { options.command = Command::Count; }
        else { return false; } } } }
    }
    if (options.operands == 2) { options.key = bytes; }
    if (options.operands >= 3) { return false; }
    options.operands += 1;
    return true;
}
fn arguments(values: std::args::Arguments) -> i32 {
    let specs: [ext::cli::Spec; 4] = [
        ext::cli::Spec { id: 1, long: literal("help",4), short: 104, arity: ext::cli::Arity::Flag },
        ext::cli::Spec { id: 2, long: literal("max-input",9), short: 0, arity: ext::cli::Arity::Required },
        ext::cli::Spec { id: 3, long: literal("max-output",10), short: 0, arity: ext::cli::Arity::Required },
        ext::cli::Spec { id: 4, long: literal("max-io-calls",12), short: 0, arity: ext::cli::Arity::Required }
    ];
    let schema: core::slice::View<ext::cli::Spec> = core::result::unwrap(core::slice::view(specs,4));
    let parser: ext::cli::Parser = core::result::unwrap(ext::cli::parser(values.as_view(),schema,ext::cli::Ordering::Intermixed));
    let options: Options = Options { database: literal("",0), command: Command::Missing, key: literal("",0), operands: 0, help: false, max_input: 1048576, max_output: 1048576, max_io_calls: 65536 };
    while (true) {
        let parsed: core::result::Result<core::option::Option<ext::cli::Event>,ext::cli::Error> = parser.next();
        if (core::result::is_err(parsed)) { return report(2,literal("sqlite-kv: invalid arguments\n",29)); }
        let next: core::option::Option<ext::cli::Event> = core::result::unwrap(parsed);
        if (core::option::is_none(next)) { break; }
        let valid: bool = match (core::option::unwrap(next)) {
            ext::cli::Event::Option(item) -> apply(options.borrow(),item),
            ext::cli::Event::Operand(item) -> operand(options.borrow(),item.bytes)
        };
        if (!valid) { return report(2,literal("sqlite-kv: invalid arguments\n",29)); }
    }
    if (options.help) {
        let usage: core::slice::View<u8> = literal("Usage: sqlite-kv DB put|get|delete KEY | sqlite-kv DB count\nOptions: --max-input N --max-output N --max-io-calls N\n",115);
        let sink: std::stream::Descriptor = std::stream::stdout();
        let budget: Budget = Budget { remaining: options.max_io_calls };
        let written: core::result::Result<i32,AppError> = write_bounded(sink.borrow(),usage,budget.borrow());
        if (core::result::is_err(written)) { return report_error(core::result::unwrap_err(written)); }
        return 0;
    }
    let needed: i32 = 3;
    let counting: bool = match (options.command) { Command::Count -> true, _ -> false };
    if (counting) { needed = 2; }
    let uri: bool = false;
    if (options.database.len() >= 5) { uri = equal(core::result::unwrap(options.database.subview(0,5)),literal("file:",5)); }
    if (options.operands != needed || options.database.len() == 0 || options.database.len() > 4096 || options.key.len() > 4096 || uri || equal(options.database,literal(":memory:",8))) {
        return report(2,literal("sqlite-kv: invalid arguments\n",29));
    }
    if (core::result::is_err(core::text::from_utf8_range(options.database.values,options.database.start,options.database.len()))) {
        return report(2,literal("sqlite-kv: database path must be UTF-8\n",39));
    }
    return process(options.borrow());
}
fn main() -> i32 {
    let captured: core::result::Result<std::args::Arguments,std::args::Error> = std::args::snapshot(1,16,16384);
    if (core::result::is_err(captured)) {
        let status: i32 = match (core::result::unwrap_err(captured)) { std::args::Error::AllocationFailed -> 4, std::args::Error::HostRead(index) -> 3, _ -> 2 };
        return report(status,literal("sqlite-kv: cannot capture arguments\n",36));
    }
    let values: std::args::Arguments = core::result::unwrap(captured);
    let status: i32 = arguments(values);
    values.destroy();
    return status;
}
