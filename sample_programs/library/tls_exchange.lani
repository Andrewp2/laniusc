// Bounded binary TLS1.3 client and one-connection anonymous-client echo server.
// Explicit trust/provisioned server seed; OS ephemeral entropy and host UTC.
module app::main;
import alloc::io;
import core::io;
import core::mem;
import core::net;
import core::option;
import core::path;
import core::result;
import core::slice;
import core::time;
import ext::der;
import ext::service_identity;
import ext::tls_connection;
import ext::tls_negotiation;
import ext::tls_record;
import ext::tls_tcp;
import ext::x509_path;
import std::args;
import std::clock;
import std::entropy;
import std::file;
import std::file_ops;
import std::poll;
import std::signal;
import std::socket;
import std::stream;

const MAX_BYTES:i32=1048576;
const TIMEOUT_MS:u64=5000;
struct Outcome { primary:i32,stage:i32,cause:core::option::Option<ext::tls_tcp::Error>,cleanup:core::option::Option<core::io::Error>,diagnostics:bool }
fn outcome()->Outcome{return Outcome{primary:0,stage:0,cause:core::option::None(),cleanup:core::option::None(),diagnostics:false};}
fn io_status(error:core::io::Error)->i32{return match(error){core::io::Error::AllocationFailed->4,core::io::Error::LimitExceeded->7,core::io::Error::CountOverflow->7,_->3};}
fn engine_status(error:ext::tls_connection::Error)->i32{if(ext::tls_connection::is_resource_limit(error)){return 7;}return 5;}
fn error_status(error:ext::tls_tcp::Error)->i32{
    return match(error){ext::tls_tcp::Error::Allocation->4,ext::tls_tcp::Error::Deadline->7,ext::tls_tcp::Error::CallLimit->7,
        ext::tls_tcp::Error::Io(inner)->io_status(inner),ext::tls_tcp::Error::Engine(inner)->engine_status(inner),
        ext::tls_tcp::Error::Poll(inner)->match(inner){std::poll::Error::AllocationFailed->4,std::poll::Error::Limit->7,_->3},_->3};
}
impl Outcome {
    fn borrow(&self)->&Outcome{return self;}
    fn ok(&self)->bool{return self.primary==0&&self.cleanup.is_none();}
    fn fail(&self,stage:i32,error:ext::tls_tcp::Error){if(self.primary==0){self.primary=error_status(error);self.stage=stage;self.cause=core::option::Some(error);}}
    fn local(&self,stage:i32,status:i32){if(self.primary==0){self.primary=status;self.stage=stage;}}
    fn close_error(&self,error:core::io::Error){if(self.cleanup.is_none()){self.cleanup=core::option::Some(error);}}
    fn code(&self)->i32{if(self.cleanup.is_some()){return 3;}return self.primary;}
}
fn view(bytes:[u8],start:i32,length:i32)->core::slice::View<u8>{return core::slice::View<u8>{values:bytes,start:start,length:length};}
fn same(value:core::slice::View<u8>,text:str,count:i32)->bool{
    if(value.length!=count){return false;}let bytes:[u8]=core::mem::typed_slice_from_raw_parts(core::mem::string_data_ptr(text),count);let i:i32=0;
    while(i<count){if(value.values[value.start+i]!=bytes[i]){return false;}i+=1;}return true;
}
fn parse_path(value:core::slice::View<u8>)->core::result::Result<core::path::Path,core::path::Error>{
    if(value.length<1||value.length>4095){return core::result::Err(core::path::Error::Bounds);}return core::path::from_view(value);
}
fn make_reference(mode:core::slice::View<u8>,identity:core::slice::View<u8>)->core::result::Result<ext::service_identity::Reference,ext::service_identity::Error>{
    if(same(mode,"dns",3)){return ext::service_identity::dns_reference(identity);}if(!same(mode,"ip",2)){return core::result::Err(ext::service_identity::Error::InvalidReference);}
    let parsed:core::result::Result<core::net::IpAddr,core::net::Error> = core::net::parse_ip(identity);if(parsed.is_err()){return core::result::Err(ext::service_identity::Error::InvalidIp);}
    let address:core::net::IpAddr=parsed.unwrap();let bytes:[u8;16]=[0;16];let written:core::result::Result<i32,core::net::Error> = address.write_octets(view(bytes,0,16));
    if(written.is_err()){return core::result::Err(ext::service_identity::Error::InvalidIp);}return ext::service_identity::ip_reference(view(bytes,0,written.unwrap()));
}
fn check(deadline:core::time::Deadline,budget:&ext::tls_tcp::HostBudget,out:&Outcome,stage:i32)->bool{
    let checked:core::result::Result<core::time::Instant,ext::tls_tcp::Error> = budget.check(deadline);if(checked.is_err()){out.fail(stage,checked.unwrap_err());return false;}return true;
}
fn permit(deadline:core::time::Deadline,budget:&ext::tls_tcp::HostBudget,out:&Outcome,stage:i32)->bool{
    if(!check(deadline,budget,out,stage)){return false;}let paid:core::result::Result<i32,ext::tls_tcp::Error> = budget.permit();if(paid.is_err()){out.fail(stage,paid.unwrap_err());return false;}return true;
}
fn reserve(calls:u64,budget:&ext::tls_tcp::HostBudget,out:&Outcome,stage:i32)->bool{
    let paid:core::result::Result<i32,ext::tls_tcp::Error> = budget.reserve(calls);if(paid.is_err()){out.fail(stage,paid.unwrap_err());return false;}return true;
}
fn read_all<R>(reader:&R,buffer:&alloc::io::Buffer,deadline:core::time::Deadline,budget:&ext::tls_tcp::HostBudget,out:&Outcome,stage:i32) where R:core::io::Read{
    let storage:[i32;256]=[0;256];let bytes:[u8]=core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(storage),1024);
    while(out.ok()){
        let request:i32=MAX_BYTES-buffer.len();if(request>1024){request=1024;}if(request==0){request=1;}
        if(!permit(deadline,budget,out,stage)){return;}let result:core::result::Result<i32,core::io::Error> = reader.read(bytes,0,request);
        let after:core::result::Result<core::time::Instant,ext::tls_tcp::Error> = budget.check(deadline);
        if(result.is_err()&&!core::io::is_interrupted(result.unwrap_err())){out.fail(stage,ext::tls_tcp::Error::Io(result.unwrap_err()));return;}
        if(after.is_err()){out.fail(stage,after.unwrap_err());return;}if(result.is_err()){continue;}
        let count:i32=result.unwrap();if(count<0||count>request){out.fail(stage,ext::tls_tcp::Error::Io(core::io::Error::InvalidCount));return;}if(count==0){return;}
        if(count>MAX_BYTES-buffer.len()){out.local(stage,7);return;}let appended:core::result::Result<i32,core::io::Error> = buffer.write(bytes,0,count);
        if(appended.is_err()){out.fail(stage,ext::tls_tcp::Error::Io(appended.unwrap_err()));return;}if(appended.unwrap()!=count){out.fail(stage,ext::tls_tcp::Error::Io(core::io::Error::InvalidCount));return;}
    }
}
fn load(path:core::path::Path,buffer:&alloc::io::Buffer,deadline:core::time::Deadline,budget:&ext::tls_tcp::HostBudget,out:&Outcome){
    if(!reserve(1,budget,out,2)||!permit(deadline,budget,out,2)){return;}
    let options:std::file_ops::OpenOptions=std::file_ops::options();options.access=std::file_ops::Access::Read;options.no_follow=true;options.nonblocking=true;options.close_on_exec=true;
    let opened:core::result::Result<std::file::File,core::io::Error> = std::file_ops::open(path,options);let after:core::result::Result<core::time::Instant,ext::tls_tcp::Error> = budget.check(deadline);
    if(opened.is_err()){out.fail(2,ext::tls_tcp::Error::Io(opened.unwrap_err()));return;}let file:std::file::File=opened.unwrap();
    if(after.is_err()){out.fail(2,after.unwrap_err());}if(out.ok()){read_all(file.borrow(),buffer,deadline,budget,out,2);}
    // The close attempt was prepaid before open. Never skip it after expiry
    // or a failed read; keep its error separate from the original cause.
    let closed:core::result::Result<i32,core::io::Error> = file.close();if(closed.is_err()){out.close_error(closed.unwrap_err());}
}
fn load_seed(path:core::path::Path,seed:[u8],deadline:core::time::Deadline,budget:&ext::tls_tcp::HostBudget,out:&Outcome){
    if(!reserve(1,budget,out,2)||!permit(deadline,budget,out,2)){return;}
    let options:std::file_ops::OpenOptions=std::file_ops::options();options.access=std::file_ops::Access::Read;options.no_follow=true;options.nonblocking=true;options.close_on_exec=true;
    let opened:core::result::Result<std::file::File,core::io::Error> = std::file_ops::open(path,options);let after:core::result::Result<core::time::Instant,ext::tls_tcp::Error> = budget.check(deadline);
    if(opened.is_err()){out.fail(2,ext::tls_tcp::Error::Io(opened.unwrap_err()));return;}let file:std::file::File=opened.unwrap();if(after.is_err()){out.fail(2,after.unwrap_err());}
    let completed:i32=0;let scratch:[u8;1]=[0;1];
    while(out.ok()){
        let request:i32=32-completed;let bytes:[u8]=seed;let offset:i32=completed;if(request==0){request=1;bytes=scratch;offset=0;}
        if(!permit(deadline,budget,out,2)){break;}let result:core::result::Result<i32,core::io::Error> = file.read(bytes,offset,request);
        let checked:core::result::Result<core::time::Instant,ext::tls_tcp::Error> = budget.check(deadline);
        if(result.is_err()&&!core::io::is_interrupted(result.unwrap_err())){out.fail(2,ext::tls_tcp::Error::Io(result.unwrap_err()));break;}
        if(checked.is_err()){out.fail(2,checked.unwrap_err());break;}if(result.is_err()){continue;}let count:i32=result.unwrap();
        if(count<0||count>request){out.fail(2,ext::tls_tcp::Error::Io(core::io::Error::InvalidCount));break;}
        if(completed==32){if(count!=0){out.local(2,2);}break;}if(count==0){out.local(2,2);break;}completed+=count;
    }
    let closed:core::result::Result<i32,core::io::Error> = file.close();if(closed.is_err()){out.close_error(closed.unwrap_err());}
}
fn publish(bytes:core::slice::View<u8>,deadline:core::time::Deadline,budget:&ext::tls_tcp::HostBudget,out:&Outcome){
    let writer:std::stream::Descriptor=std::stream::stdout();let completed:i32=0;
    while(completed<bytes.length&&out.ok()){
        if(!permit(deadline,budget,out,8)){return;}let result:core::result::Result<i32,core::io::Error> = writer.write(bytes.values,bytes.start+completed,bytes.length-completed);
        let after:core::result::Result<core::time::Instant,ext::tls_tcp::Error> = budget.check(deadline);
        if(result.is_err()&&!core::io::is_interrupted(result.unwrap_err())){out.fail(8,ext::tls_tcp::Error::Io(result.unwrap_err()));return;}
        if(after.is_err()){out.fail(8,after.unwrap_err());return;}if(result.is_err()){continue;}let count:i32=result.unwrap();
        if(count<=0||count>bytes.length-completed){out.fail(8,ext::tls_tcp::Error::Io(core::io::Error::InvalidCount));return;}completed+=count;
    }
}
fn close_socket(socket:&std::socket::Socket,out:&Outcome){let closed:core::result::Result<i32,core::io::Error> = socket.close();if(closed.is_err()){out.close_error(closed.unwrap_err());}}
fn wait_ready(socket:&std::socket::Socket,writing:bool,deadline:core::time::Deadline,budget:&ext::tls_tcp::HostBudget,out:&Outcome)->bool{
    while(out.ok()){
        let now:core::result::Result<core::time::Instant,ext::tls_tcp::Error> = budget.check(deadline);if(now.is_err()){out.fail(4,now.unwrap_err());return false;}
        let remaining:core::time::Duration=deadline.remaining(now.unwrap());let milliseconds:i32=(remaining.seconds*1000+((remaining.nanos as u64)+999999)/1000000) as i32;
        if(!reserve(1,budget,out,4)){return false;}let result:core::result::Result<std::socket::Ready,core::io::Error> = socket.wait_ms(!writing,writing,milliseconds);
        let after:core::result::Result<core::time::Instant,ext::tls_tcp::Error> = budget.check(deadline);
        if(result.is_err()&&!core::io::is_interrupted(result.unwrap_err())){out.fail(4,ext::tls_tcp::Error::Io(result.unwrap_err()));return false;}
        if(after.is_err()){out.fail(4,after.unwrap_err());return false;}if(result.is_err()){continue;}if(!result.unwrap().timed_out){return true;}
    }return false;
}
fn connected(socket:&std::socket::Socket,endpoint:core::net::SocketAddr,deadline:core::time::Deadline,budget:&ext::tls_tcp::HostBudget,out:&Outcome){
    if(!permit(deadline,budget,out,4)){return;}let started:core::result::Result<std::socket::Connection,core::io::Error> = socket.connect(endpoint);
    let after:core::result::Result<core::time::Instant,ext::tls_tcp::Error> = budget.check(deadline);if(started.is_err()){out.fail(4,ext::tls_tcp::Error::Io(started.unwrap_err()));return;}if(after.is_err()){out.fail(4,after.unwrap_err());return;}
    let complete:bool=match(started.unwrap()){std::socket::Connection::Connected->true,std::socket::Connection::InProgress->false};if(complete){return;}
    if(!wait_ready(socket,true,deadline,budget,out)||!permit(deadline,budget,out,4)){return;}
    let finished:core::result::Result<core::option::Option<i32>,core::io::Error> = socket.take_error();let checked:core::result::Result<core::time::Instant,ext::tls_tcp::Error> = budget.check(deadline);
    if(finished.is_err()){out.fail(4,ext::tls_tcp::Error::Io(finished.unwrap_err()));return;}if(finished.unwrap().is_some()){out.fail(4,ext::tls_tcp::Error::Io(core::io::Error::Host(finished.unwrap().unwrap())));return;}if(checked.is_err()){out.fail(4,checked.unwrap_err());return;}
    if(!permit(deadline,budget,out,4)){return;}let peer:core::result::Result<core::net::SocketAddr,core::io::Error> = socket.peer_addr();let end:core::result::Result<core::time::Instant,ext::tls_tcp::Error> = budget.check(deadline);
    if(peer.is_err()){out.fail(4,ext::tls_tcp::Error::Io(peer.unwrap_err()));return;}if(end.is_err()){out.fail(4,end.unwrap_err());}
}
fn open_socket(endpoint:core::net::SocketAddr,server:bool,deadline:core::time::Deadline,budget:&ext::tls_tcp::HostBudget,out:&Outcome)->core::option::Option<std::socket::Socket>{
    if(!reserve(1,budget,out,4)||!permit(deadline,budget,out,4)){return core::option::None();}
    let family:std::socket::Family=match(endpoint){core::net::SocketAddr::V4(value)->std::socket::Family::Ipv4,core::net::SocketAddr::V6(value)->std::socket::Family::Ipv6};
    let made:core::result::Result<std::socket::Socket,core::io::Error> = std::socket::create(family,std::socket::Kind::Tcp,true);
    let after:core::result::Result<core::time::Instant,ext::tls_tcp::Error> = budget.check(deadline);if(made.is_err()){out.fail(4,ext::tls_tcp::Error::Io(made.unwrap_err()));return core::option::None();}let socket:std::socket::Socket=made.unwrap();
    if(after.is_err()){out.fail(4,after.unwrap_err());}if(!server&&out.ok()){connected(socket.borrow(),endpoint,deadline,budget,out);}
    if(!server){if(!out.ok()){close_socket(socket.borrow(),out);return core::option::None();}return core::option::Some(socket);}
    if(out.ok()&&permit(deadline,budget,out,4)){
        let result:core::result::Result<i32,core::io::Error> = socket.set_option(std::socket::Setting::ReuseAddress,1);let checked:core::result::Result<core::time::Instant,ext::tls_tcp::Error> = budget.check(deadline);
        if(result.is_err()){out.fail(4,ext::tls_tcp::Error::Io(result.unwrap_err()));}if(checked.is_err()){out.fail(4,checked.unwrap_err());}
    }
    if(out.ok()&&permit(deadline,budget,out,4)){
        let result:core::result::Result<i32,core::io::Error> = socket.bind(endpoint);let checked:core::result::Result<core::time::Instant,ext::tls_tcp::Error> = budget.check(deadline);
        if(result.is_err()){out.fail(4,ext::tls_tcp::Error::Io(result.unwrap_err()));}if(checked.is_err()){out.fail(4,checked.unwrap_err());}
    }
    if(out.ok()&&permit(deadline,budget,out,4)){
        let result:core::result::Result<i32,core::io::Error> = socket.listen(1);let checked:core::result::Result<core::time::Instant,ext::tls_tcp::Error> = budget.check(deadline);
        if(result.is_err()){out.fail(4,ext::tls_tcp::Error::Io(result.unwrap_err()));}if(checked.is_err()){out.fail(4,checked.unwrap_err());}
    }
    while(out.ok()){
        if(!wait_ready(socket.borrow(),false,deadline,budget,out)||!reserve(1,budget,out,4)||!permit(deadline,budget,out,4)){break;}
        let accepted:core::result::Result<std::socket::Accepted,std::socket::AcceptFailure> = socket.accept(true);let checked:core::result::Result<core::time::Instant,ext::tls_tcp::Error> = budget.check(deadline);
        if(accepted.is_err()){
            let failed:std::socket::AcceptFailure=accepted.unwrap_err();if(failed.cleanup_error.is_some()){out.close_error(failed.cleanup_error.unwrap());}
            let retry:bool=match(failed.cause){core::io::Error::Interrupted->true,core::io::Error::WouldBlock->true,_->false};if(!retry){out.fail(4,ext::tls_tcp::Error::Io(failed.cause));}
            if(checked.is_err()){out.fail(4,checked.unwrap_err());}continue;
        }
        let peer:std::socket::Socket=accepted.unwrap().socket;if(checked.is_err()){out.fail(4,checked.unwrap_err());}close_socket(socket.borrow(),out);
        if(!out.ok()){close_socket(peer.borrow(),out);return core::option::None();}return core::option::Some(peer);
    }
    close_socket(socket.borrow(),out);return core::option::None();
}
fn new_buffer(deadline:core::time::Deadline,budget:&ext::tls_tcp::HostBudget,out:&Outcome)->core::option::Option<alloc::io::Buffer>{
    if(!check(deadline,budget,out,2)||!reserve(2,budget,out,2)){return core::option::None();}
    let made:core::result::Result<alloc::io::Buffer,core::io::Error> = alloc::io::with_limit(MAX_BYTES);if(made.is_err()){out.fail(2,ext::tls_tcp::Error::Io(made.unwrap_err()));return core::option::None();}let buffer:alloc::io::Buffer=made.unwrap();
    let reserved:core::result::Result<i32,core::io::Error> = buffer.try_reserve(MAX_BYTES);let after:core::result::Result<core::time::Instant,ext::tls_tcp::Error> = budget.check(deadline);
    if(reserved.is_err()){out.fail(2,ext::tls_tcp::Error::Io(reserved.unwrap_err()));}if(after.is_err()){out.fail(2,after.unwrap_err());}
    if(!out.ok()){buffer.destroy();return core::option::None();}return core::option::Some(buffer);
}
struct Chain { parts:[core::slice::View<u8>;8],count:i32 }
fn certificate_chain(buffer:&alloc::io::Buffer)->core::result::Result<Chain,i32>{
    let input:core::slice::View<u8> = view(buffer.as_bytes(),0,buffer.len());let reader:ext::der::Reader=ext::der::reader(input).unwrap();
    let empty:core::slice::View<u8> = view(buffer.as_bytes(),0,0);let result:Chain=Chain{parts:[empty;8],count:0};
    while(true){let next:core::result::Result<core::option::Option<ext::der::Element>,ext::der::Error> = reader.next();if(next.is_err()){return core::result::Err(5);}let item:core::option::Option<ext::der::Element> = next.unwrap();if(item.is_none()){break;}
        if(!item.unwrap().tag.matches(ext::der::Class::Universal,true,16)){return core::result::Err(5);}if(result.count==8){return core::result::Err(7);}result.parts[result.count]=item.unwrap().encoded;result.count+=1;}
    if(result.count==0){return core::result::Err(5);}return core::result::Ok(result);
}
fn cleanup(report:ext::tls_tcp::CloseReport,out:&Outcome){if(report.primary.is_some()){out.fail(6,report.primary.unwrap());}if(report.close_error.is_some()){out.close_error(report.close_error.unwrap());}}
fn failure(failed:ext::tls_tcp::Failure,out:&Outcome,stage:i32){out.fail(stage,failed.cause);if(failed.cleanup.is_some()){cleanup(failed.cleanup.unwrap(),out);}}
fn backpressure(error:ext::tls_tcp::Error)->bool{
    return match(error){ext::tls_tcp::Error::Engine(inner)->match(inner){ext::tls_connection::Error::WantInput->true,ext::tls_connection::Error::WantOutput->true,ext::tls_connection::Error::WantRead->true,_->false},_->false};
}
fn exchange(connection:&ext::tls_tcp::Connection,input:core::slice::View<u8>,server:bool,deadline:core::time::Deadline,budget:&ext::tls_tcp::HostBudget,out:&Outcome){
    let bytes:[u8;1024]=[0;1024];let sent:i32=0;let received:i32=0;let echo_at:i32=0;let echo_length:i32=0;let peer_eof:bool=false;
    while(out.ok()){
        if(!check(deadline,budget,out,7)){break;}let progress:ext::tls_tcp::Progress=connection.progress();
        if(progress.established){
            if((!server||echo_at==echo_length)&&!peer_eof){
                let amount:i32=MAX_BYTES-received;if(amount>1024){amount=1024;}if(amount==0){amount=1;}
                let read:core::result::Result<ext::tls_connection::Read,ext::tls_tcp::Failure> = connection.read_plaintext(view(bytes,0,amount),deadline,budget);
                if(read.is_err()){let failed:ext::tls_tcp::Failure=read.unwrap_err();if(failed.cleanup.is_some()||!backpressure(failed.cause)){failure(failed,out,7);break;}}
                else{let part:ext::tls_connection::Read=read.unwrap();if(part.written<0||part.written>amount){out.fail(7,ext::tls_tcp::Error::Io(core::io::Error::InvalidCount));break;}
                    if(part.written>MAX_BYTES-received){out.local(7,7);break;}received+=part.written;peer_eof=part.eof;
                    if(part.written>0){publish(view(bytes,0,part.written),deadline,budget,out);if(!out.ok()){break;}if(server){echo_at=0;echo_length=part.written;}}
                }
            }
            if(peer_eof&&!server&&sent<input.length){out.local(7,5);break;}
            let current:ext::tls_tcp::Progress=connection.progress();
            if(current.pending_wire==0&&!connection.close_requested()){
                let count:i32=0;let source:core::slice::View<u8> = input;
                if(server){count=echo_length-echo_at;source=view(bytes,echo_at,count);}else{count=input.length-sent;if(count>16384){count=16384;}source=view(input.values,input.start+sent,count);}
                if(count>0){let queued:core::result::Result<i32,ext::tls_tcp::Failure> = connection.queue_plaintext(source,deadline,budget);
                    if(queued.is_err()){let failed:ext::tls_tcp::Failure=queued.unwrap_err();if(failed.cleanup.is_some()||!backpressure(failed.cause)){failure(failed,out,7);break;}}
                    else{let accepted:i32=queued.unwrap();if(accepted<0||accepted>count){out.fail(7,ext::tls_tcp::Error::Io(core::io::Error::InvalidCount));break;}if(server){echo_at+=accepted;}else{sent+=accepted;}}
                }
            }
            let done_sending:bool=sent==input.length;if(server){done_sending=peer_eof&&echo_at==echo_length;}
            if(done_sending&&!connection.close_requested()&&connection.progress().pending_wire==0){
                let ended:core::result::Result<i32,ext::tls_tcp::Error> = connection.begin_close();if(ended.is_err()&&!backpressure(ended.unwrap_err())){out.fail(7,ended.unwrap_err());break;}
            }
            if(peer_eof&&done_sending&&connection.close_requested()){
                let finished:core::result::Result<ext::tls_tcp::CloseReport,ext::tls_tcp::Error> = connection.try_finish();
                if(finished.is_ok()){cleanup(finished.unwrap(),out);return;}let error:ext::tls_tcp::Error=finished.unwrap_err();let pending:bool=match(error){ext::tls_tcp::Error::Remaining->true,_->false};if(!pending){out.fail(7,error);break;}
            }
        }
        let progressed:core::result::Result<ext::tls_tcp::Progress,ext::tls_tcp::Failure> = connection.step(deadline,budget);if(progressed.is_err()){failure(progressed.unwrap_err(),out,6);break;}
    }
    cleanup(connection.destroy(),out);
}
fn client_session(socket:&std::socket::Socket,anchor:&alloc::io::Buffer,input:&alloc::io::Buffer,reference:ext::service_identity::Reference,dns:bool,utc:i64,deadline:core::time::Deadline,budget:&ext::tls_tcp::HostBudget,out:&Outcome){
    let trusted:core::slice::View<u8> = view(anchor.as_bytes(),0,anchor.len());let anchors:[core::slice::View<u8>;1]=[trusted;1];
    let server_name:core::slice::View<u8> = view(reference.bytes,0,0);if(dns){let candidate:core::slice::View<u8> = view(reference.bytes,0,reference.length);
        let numeric:core::result::Result<core::net::IpAddr,core::net::Error> = core::net::parse_ip(candidate);if(numeric.is_err()){server_name.length=reference.length;}}
    let config:ext::tls_connection::ClientConfig=ext::tls_connection::ClientConfig{anchors:core::slice::View{values:anchors,start:0,length:1},reference:reference,unix_time:utc,server_name:server_name,
        alpn:view(reference.bytes,0,0),require_alpn:false,prefer_suite:ext::tls_record::Suite::ChaCha20Poly1305Sha256,groups:ext::tls_negotiation::default_groups(),initial_share:core::option::Some(ext::tls_negotiation::Group::X25519),limits:ext::tls_connection::default_limits()};
    let made:core::result::Result<ext::tls_tcp::Connection,ext::tls_tcp::Failure> = ext::tls_tcp::attach_client(socket,config,deadline,budget);
    if(made.is_err()){failure(made.unwrap_err(),out,5);return;}let connection:ext::tls_tcp::Connection=made.unwrap();exchange(connection.borrow(),view(input.as_bytes(),0,input.len()),false,deadline,budget,out);
}
fn server_session(socket:&std::socket::Socket,certificates:Chain,seed:[u8],deadline:core::time::Deadline,budget:&ext::tls_tcp::HostBudget,out:&Outcome){
    let config:ext::tls_connection::ServerConfig=ext::tls_connection::ServerConfig{chain:core::slice::View{values:certificates.parts,start:0,length:certificates.count},seed:view(seed,0,32),alpn:view(seed,0,0),
        require_alpn:false,prefer_suite:ext::tls_record::Suite::ChaCha20Poly1305Sha256,groups:ext::tls_negotiation::default_groups(),require_cookie:false,limits:ext::tls_connection::default_limits()};
    let made:core::result::Result<ext::tls_tcp::Connection,ext::tls_tcp::Failure> = ext::tls_tcp::attach_server(socket,config,deadline,budget);
    if(made.is_err()){failure(made.unwrap_err(),out,5);return;}let connection:ext::tls_tcp::Connection=made.unwrap();exchange(connection.borrow(),view(seed,0,0),true,deadline,budget,out);
