    let observed:core::result::Result<core::time::Instant,ext::tls_tcp::Error> = budget.check(deadline);if(ignored.is_err()){out.fail(1,ext::tls_tcp::Error::Io(ignored.unwrap_err()));return;}out.diagnostics=true;if(observed.is_err()){out.fail(1,observed.unwrap_err());return;}
