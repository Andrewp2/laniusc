    while(completed<d.length&&attempts<8){attempts+=1;let written:core::result::Result<i32,core::io::Error> = writer.write(d.bytes,completed,d.length-completed);if(written.is_err()){if(core::io::is_interrupted(written.unwrap_err())){continue;}return;}let count:i32=written.unwrap();if(count<=0||count>d.length-completed){return;}completed+=count;}
