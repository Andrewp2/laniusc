        let frames:core::result::Result<Chain,i32> = certificate_chain(certificates.borrow());if(frames.is_err()){out.local(2,frames.unwrap_err());certificates.destroy();return;}
        let opened:core::option::Option<std::socket::Socket> = open_socket(endpoint,true,deadline,budget,out);if(opened.is_some()){let socket:std::socket::Socket=opened.unwrap();server_session(socket.borrow(),frames.unwrap(),seed,deadline,budget,out);close_socket(socket.borrow(),out);}
