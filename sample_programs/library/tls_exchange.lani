fn process(arguments:std::args::Arguments,budget:&ext::tls_tcp::HostBudget,out:&Outcome){
    if(arguments.len()!=4&&arguments.len()!=5){out.local(0,2);return;}let server:bool=same(arguments.get(0).unwrap(),"serve",5);
    if((!server&&!same(arguments.get(0).unwrap(),"client",6))||(server&&arguments.len()!=4)||(!server&&arguments.len()!=5)){out.local(0,2);return;}
    let parsed:core::result::Result<core::net::SocketAddr,core::net::Error> = core::net::parse_socket(arguments.get(1).unwrap());if(parsed.is_err()){out.local(0,2);return;}let endpoint:core::net::SocketAddr=parsed.unwrap();
    let port:u16=match(endpoint){core::net::SocketAddr::V4(value)->value.port,core::net::SocketAddr::V6(value)->value.port};if(port==0){out.local(0,2);return;}
    let first_index:i32=4;if(server){first_index=2;}let first_path:core::result::Result<core::path::Path,core::path::Error> = parse_path(arguments.get(first_index).unwrap());if(first_path.is_err()){out.local(0,2);return;}
    let second_path:core::result::Result<core::path::Path,core::path::Error> = first_path;if(server){second_path=parse_path(arguments.get(3).unwrap());if(second_path.is_err()){out.local(0,2);return;}}
    let label:[u8]=core::mem::typed_slice_from_raw_parts(core::mem::string_data_ptr("unused"),6);let reference:ext::service_identity::Reference=ext::service_identity::dns_reference(view(label,0,6)).unwrap();let dns:bool=false;
    if(!server){let made:core::result::Result<ext::service_identity::Reference,ext::service_identity::Error> = make_reference(arguments.get(2).unwrap(),arguments.get(3).unwrap());if(made.is_err()){out.local(0,2);return;}reference=made.unwrap();dns=same(arguments.get(2).unwrap(),"dns",3);}
