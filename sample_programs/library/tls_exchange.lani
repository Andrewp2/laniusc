    let source:std::stream::Descriptor=std::stream::stdin();read_all(source.borrow(),input.borrow(),deadline,budget,out,2);
    let utc:i64=0;
    if(out.ok()&&permit(deadline,budget,out,3)){
        // Exactly one charged wall-clock sample sets certificate-time policy.
        // Failure has no fallback, and monotonic time remains the I/O clock.
        let system:core::result::Result<core::time::SystemTime,std::clock::Error> = std::clock::system_now();let after:core::result::Result<core::time::Instant,ext::tls_tcp::Error> = budget.check(deadline);
        if(system.is_err()){out.fail(3,ext::tls_tcp::Error::Clock(system.unwrap_err()));}else{utc=system.unwrap().seconds;if(utc<(-62135596800)||utc>253402300799){out.fail(3,ext::tls_tcp::Error::Clock(std::clock::Error::InvalidTimestamp));}}
        if(after.is_err()){out.fail(3,after.unwrap_err());}
    }
    if(out.ok()){let opened:core::option::Option<std::socket::Socket> = open_socket(endpoint,false,deadline,budget,out);if(opened.is_some()){let socket:std::socket::Socket=opened.unwrap();client_session(socket.borrow(),certificates.borrow(),input.borrow(),reference,dns,utc,deadline,budget,out);close_socket(socket.borrow(),out);}}
    input.destroy();certificates.destroy();
}
struct Diagnostic { bytes:[u8],length:i32 }
impl Diagnostic {
    fn borrow(&self)->&Diagnostic{return self;}
    fn literal(&self,text:str,count:i32){let raw:[u8]=core::mem::typed_slice_from_raw_parts(core::mem::string_data_ptr(text),count);let i:i32=0;while(i<count&&self.length<256){self.bytes[self.length]=raw[i];self.length+=1;i+=1;}}
    fn number(&self,value:i32){let wide:i64=value as i64;if(wide<0){self.literal("-",1);wide=0-wide;}let remaining:u64=wide as u64;let digits:[u8;20]=[0;20];let count:i32=0;while(true){digits[count]=(48+remaining%10) as u8;count+=1;remaining/=10;if(remaining==0){break;}}while(count>0&&self.length<256){count-=1;self.bytes[self.length]=digits[count];self.length+=1;}}
}
fn io_errno(error:core::io::Error)->i32{return match(error){core::io::Error::Host(code)->code,core::io::Error::Interrupted->4,core::io::Error::WouldBlock->11,_->0};}
fn describe_clock(error:std::clock::Error,d:&Diagnostic){d.literal("clock",5);let code:i32=match(error){std::clock::Error::Host(value)->value,_->0};d.literal(" errno=",7);d.number(code);}
fn describe_io(error:core::io::Error,d:&Diagnostic){d.literal("io errno=",9);d.number(io_errno(error));}
fn describe_entropy(error:std::entropy::Error,d:&Diagnostic){d.literal("entropy errno=",14);let code:i32=match(error){std::entropy::Error::Host(value)->value,_->0};d.number(code);}
fn describe_alert(value:u8,d:&Diagnostic){d.literal(" alert=",7);d.number(value as i32);}
fn describe_nothing(){return;}
fn describe_engine(error:ext::tls_connection::Error,d:&Diagnostic){
    d.literal("tls",3);if(ext::tls_connection::is_resource_limit(error)){d.literal("-limit",6);}
    match(error){ext::tls_connection::Error::PeerAlert(value)->describe_alert(value,d),ext::tls_connection::Error::Authentication(value)->d.literal("-authentication",15),ext::tls_connection::Error::Credential->d.literal("-credential",11),ext::tls_connection::Error::Truncated->d.literal("-truncated",10),_->describe_nothing()};
}
fn describe(error:ext::tls_tcp::Error,d:&Diagnostic){
    match(error){ext::tls_tcp::Error::Clock(inner)->describe_clock(inner,d),
        ext::tls_tcp::Error::Io(inner)->describe_io(inner,d),ext::tls_tcp::Error::Deadline->d.literal("deadline",8),ext::tls_tcp::Error::CallLimit->d.literal("call-limit",10),
        ext::tls_tcp::Error::Allocation->d.literal("allocation",10),ext::tls_tcp::Error::Entropy(inner)->describe_entropy(inner,d),
        ext::tls_tcp::Error::Engine(inner)->describe_engine(inner,d),
        ext::tls_tcp::Error::Poll(inner)->d.literal("poll",4),_->d.literal("transport",9)};
}
fn diagnose(out:&Outcome){
    if(out.code()==0||!out.diagnostics){return;}let bytes:[u8;256]=[0;256];let d:Diagnostic=Diagnostic{bytes:bytes,length:0};d.literal("tls-exchange primary=",21);d.number(out.primary);d.literal(" stage=",7);d.number(out.stage);d.literal(" cause=",7);
    if(out.cause.is_some()){describe(out.cause.unwrap(),d.borrow());}else{d.literal("application",11);}d.literal(" cleanup=",9);if(out.cleanup.is_some()){d.literal("io errno=",9);d.number(io_errno(out.cleanup.unwrap()));}else{d.literal("none",4);}d.literal("\n",1);
