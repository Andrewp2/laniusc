fn main()->i32{
    let budget:ext::tls_tcp::HostBudget=ext::tls_tcp::host_budget(131072);
    // At most two argv allocations + their releases, and eight diagnostics.
    let prepaid:core::result::Result<i32,ext::tls_tcp::Error> = budget.reserve(12);if(prepaid.is_err()){return 7;}
    let captured:core::result::Result<std::args::Arguments,std::args::Error> = std::args::snapshot(1,5,8259);
    if(captured.is_err()){return match(captured.unwrap_err()){std::args::Error::AllocationFailed->4,std::args::Error::HostRead(index)->3,_->2};}
    let arguments:std::args::Arguments=captured.unwrap();let out:Outcome=outcome();process(arguments,budget.borrow(),out.borrow());arguments.destroy();diagnose(out.borrow());return out.code();
