// Scripted WebSocket client over ext::websocket_client: connects to one ws://
// or wss:// URL, then runs the commands on stdin, one per line:
//   send text|binary DATA     one message (DATA escapes: \xHH, \\)
//   gen text|binary N         one message of N generated bytes
//   frag text|binary K DATA   DATA as K fragments
//   fragping K DATA           text DATA as K fragments with a Ping between each
//   ping DATA                 a Ping
//   recv MS                   wait up to MS for one message and print it
//                             ("timeout" when none arrives; the script goes on)
//   close CODE REASON         close handshake; prints the peer's code
// Output: "open secure=S protocol=P", then per received message
// "KIND LENGTH FNV1A32 [DATA]" (DATA escaped, only up to 200 bytes) or
// "close CODE REASON", and "closed CODE" after close; "error NAME" on failure.
// --deflate offers permessage-deflate (context takeover allowed both ways);
// --deflate-no-context offers it with both sides resetting per message. The
// open line then ends " deflate=1" when the server accepted it.
module app::main;
import alloc::vec;
import core::io;
import core::mem;
import core::option;
import core::result;
import core::slice;
import ext::http;
import ext::http_agent;
import ext::http_url;
import ext::openssl_tls;
import ext::websocket;
import ext::websocket_client;
import std::args;
import std::signal;
import std::stream;

fn literal(s: str, n: i32) -> core::slice::View<u8> { let raw: [u8] = core::mem::typed_slice_from_raw_parts<u8>(core::mem::string_data_ptr(s),n); return core::slice::view<u8>(raw,n).unwrap(); }
fn byte(v: core::slice::View<u8>, i: i32) -> u8 { return v.values[v.start+i]; }
fn part(v: core::slice::View<u8>, start: i32, end: i32) -> core::slice::View<u8> { return v.subview(start,end).unwrap(); }
fn eq(v: core::slice::View<u8>, s: str, n: i32) -> bool {
    let w: core::slice::View<u8> = literal(s,n); if (v.len() != n) { return false; }
    let i: i32 = 0; while (i < n) { if (byte(v,i) != byte(w,i)) { return false; } i += 1; } return true;
}
fn write_to(fd: i32, bytes: core::slice::View<u8>) -> bool {
    let sink: std::stream::Descriptor = std::stream::from_handle(fd); let completed: i32 = 0;
    while (completed < bytes.len()) {
        let sent = sink.write(bytes.values,bytes.start + completed,bytes.len() - completed);
        if (sent.is_err()) { if (core::io::is_interrupted(sent.unwrap_err())) { continue; } return false; }
        let count: i32 = sent.unwrap(); if (count <= 0) { return false; } completed += count;
    }
    return true;
}
fn put(out: &alloc::vec::Vec<u8>, s: str, n: i32) -> bool { return out.try_extend(literal(s,n)).is_ok(); }
fn push_number(out: &alloc::vec::Vec<u8>, value: i32) -> bool {
    let digits: [u8;12] = [0;12]; let i: i32 = 12; let v: i32 = value; let negative: bool = v < 0; if (negative) { v = 0 - v; }
    while (true) { i -= 1; digits[i] = (48 + v % 10) as u8; v = v / 10; if (v == 0) { break; } }
    if (negative && out.try_push(45 as u8).is_err()) { return false; }
    while (i < 12) { if (out.try_push(digits[i]).is_err()) { return false; } i += 1; }
    return true;
}
fn hex_digit(d: u32) -> u8 { if (d < 10) { return (48 + d) as u8; } return (87 + d) as u8; }
fn push_hex32(out: &alloc::vec::Vec<u8>, value: u32) -> bool {
    let i: i32 = 7; while (i >= 0) { if (out.try_push(hex_digit((value >> ((i * 4) as u32)) & 15)).is_err()) { return false; } i -= 1; } return true;
}
fn fnv(v: core::slice::View<u8>) -> u32 {
    let h: u32 = 2166136261; let i: i32 = 0; while (i < v.len()) { h = (h ^ (byte(v,i) as u32)) * 16777619; i += 1; } return h;
}
fn push_escaped(out: &alloc::vec::Vec<u8>, v: core::slice::View<u8>) -> bool {
    let i: i32 = 0;
    while (i < v.len()) {
        let c: u8 = byte(v,i);
        if (c > 32 && c < 127 && c != 92) { if (out.try_push(c).is_err()) { return false; } }
        else { if (!put(out,"\\x",2) || out.try_push(hex_digit(((c >> 4) & 15) as u32)).is_err() || out.try_push(hex_digit((c & 15) as u32)).is_err()) { return false; } }
        i += 1;
    }
    return true;
}
fn hex_value(c: u8) -> i32 {
    if (c >= 48 && c <= 57) { return (c - 48) as i32; } if (c >= 97 && c <= 102) { return (c - 87) as i32; }
    if (c >= 65 && c <= 70) { return (c - 55) as i32; } return -1;
}
fn unescape(v: core::slice::View<u8>, out: &alloc::vec::Vec<u8>) -> bool {
    out.clear(); let i: i32 = 0;
    while (i < v.len()) {
        let c: u8 = byte(v,i);
        if (c == 92 && i + 1 < v.len() && byte(v,i+1) == 92) { if (out.try_push(92 as u8).is_err()) { return false; } i += 2; continue; }
        if (c == 92 && i + 3 < v.len() && byte(v,i+1) == 120) {
            let a: i32 = hex_value(byte(v,i+2)); let b: i32 = hex_value(byte(v,i+3));
            if (a < 0 || b < 0) { return false; }
            if (out.try_push((a * 16 + b) as u8).is_err()) { return false; } i += 4; continue;
        }
        if (out.try_push(c).is_err()) { return false; } i += 1;
    }
    return true;
}
fn number(v: core::slice::View<u8>) -> i32 {
    if (v.len() == 0 || v.len() > 9) { return -1; } let n: i32 = 0; let i: i32 = 0;
    while (i < v.len()) { let c: u8 = byte(v,i); if (c < 48 || c > 57) { return -1; } n = n * 10 + ((c - 48) as i32); i += 1; }
    return n;
}
fn error_name(e: ext::websocket_client::Error) -> core::slice::View<u8> {
    return match(e) {
        ext::websocket_client::Error::InvalidRequest -> literal("invalid-request",15), ext::websocket_client::Error::BadUrl -> literal("bad-url",7),
        ext::websocket_client::Error::Url(k) -> literal("bad-url",7), ext::websocket_client::Error::UnsupportedScheme -> literal("unsupported-scheme",18),
        ext::websocket_client::Error::Connect(c) -> match(c) {
            ext::http_agent::Error::Tls(t) -> match(t.cause) { ext::openssl_tls::Cause::Verification -> literal("certificate",11), ext::openssl_tls::Cause::PeerCertificate -> literal("certificate",11), _ -> literal("tls",3) },
            ext::http_agent::Error::Timeout -> literal("timeout",7), _ -> literal("connect",7) },
        ext::websocket_client::Error::Rejected(s) -> literal("rejected",8), ext::websocket_client::Error::Handshake(h) -> literal("handshake",9),
        ext::websocket_client::Error::Io(i) -> literal("io",2), ext::websocket_client::Error::Timeout -> literal("timeout",7),
        ext::websocket_client::Error::Eof -> literal("eof",3),
        ext::websocket_client::Error::Wire(w) -> match(w) {
            ext::websocket::Error::InvalidUtf8(n) -> literal("wire-utf8",9), ext::websocket::Error::Limit(n) -> literal("wire-limit",10),
            ext::websocket::Error::InvalidClose(n) -> literal("wire-close",10), _ -> literal("wire-protocol",13) },
        ext::websocket_client::Error::Closed -> literal("closed",6), ext::websocket_client::Error::Entropy -> literal("entropy",7),
        ext::websocket_client::Error::AllocationFailed -> literal("out-of-memory",13), ext::websocket_client::Error::Clock -> literal("clock",5), ext::websocket_client::Error::Inflate -> literal("inflate",7)
    };
}
fn fail(e: ext::websocket_client::Error) -> i32 {
    let line: alloc::vec::Vec<u8> = alloc::vec::new<u8>(); put(line.borrow(),"error ",6); line.try_extend(error_name(e));
    let status: i32 = match(e) { ext::websocket_client::Error::Rejected(s) -> s, _ -> -1 };
    if (status >= 0) { put(line.borrow()," ",1); push_number(line.borrow(),status); }
    put(line.borrow(),"\n",1); write_to(1,line.as_view()); line.destroy(); return 1;
}
fn report(m: ext::websocket_client::Message) -> bool {
    let line: alloc::vec::Vec<u8> = alloc::vec::new<u8>();
    let ok: bool = match(m.kind) {
        ext::websocket_client::Kind::Text -> put(line.borrow(),"text ",5), ext::websocket_client::Kind::Binary -> put(line.borrow(),"binary ",7),
        ext::websocket_client::Kind::Ping -> put(line.borrow(),"ping ",5), ext::websocket_client::Kind::Pong -> put(line.borrow(),"pong ",5),
        ext::websocket_client::Kind::Close -> put(line.borrow(),"close ",6)
    };
    let closing: bool = match(m.kind) { ext::websocket_client::Kind::Close -> true, _ -> false };
    if (closing) {
        ok = ok && push_number(line.borrow(),m.close_code) && put(line.borrow()," ",1);
        if (m.data.len() > 2) { ok = ok && push_escaped(line.borrow(),part(m.data,2,m.data.len())); }
    } else {
        ok = ok && push_number(line.borrow(),m.data.len()) && put(line.borrow()," ",1) && push_hex32(line.borrow(),fnv(m.data));
        if (m.data.len() <= 200) { ok = ok && put(line.borrow()," ",1) && push_escaped(line.borrow(),m.data); }
    }
    ok = ok && put(line.borrow(),"\n",1) && write_to(1,line.as_view()); line.destroy(); return ok;
}
fn generate(kind_text: bool, n: i32, out: &alloc::vec::Vec<u8>) -> bool {
    out.clear(); let i: i32 = 0;
    while (i < n) {
        let c: u8 = ((i * 73 + 7) % 256) as u8; if (kind_text) { c = (97 + i % 26) as u8; }
        if (out.try_push(c).is_err()) { return false; } i += 1;
    }
    return true;
}
// Split at spaces into at most limit words; the last word keeps the rest.
fn words(line: core::slice::View<u8>, limit: i32, out: &alloc::vec::Vec<core::slice::View<u8>>) {
    out.clear(); let start: i32 = 0; let i: i32 = 0;
    while (i < line.len() && out.len() + 1 < limit) {
        if (byte(line,i) == 32) { out.try_push(part(line,start,i)); start = i + 1; }
        i += 1;
    }
    out.try_push(part(line,start,line.len()));
}
fn opcode_of(v: core::slice::View<u8>) -> i32 { if (eq(v,"text",4)) { return 1; } if (eq(v,"binary",6)) { return 2; } return -1; }
fn send_fragments(c: &ext::websocket_client::Client, opcode: i32, k: i32, data: core::slice::View<u8>, pings: bool) -> core::result::Result<i32,ext::websocket_client::Error> {
    if (k < 1) { return core::result::Err(ext::websocket_client::Error::InvalidRequest); }
    let size: i32 = data.len() / k; let at: i32 = 0; let j: i32 = 0;
    while (j < k) {
        let end: i32 = at + size; if (j == k - 1) { end = data.len(); }
        let op: i32 = 0; if (j == 0) { op = opcode; }
        let sent = c.send_fragment(j == k - 1,op,part(data,at,end)); if (sent.is_err()) { return sent; }
        if (pings && j < k - 1) { let p = c.ping(literal("between",7)); if (p.is_err()) { return p; } }
        at = end; j += 1;
    }
    return core::result::Ok(0);
}
fn script(c: &ext::websocket_client::Client, input: core::slice::View<u8>) -> i32 {
    let w: alloc::vec::Vec<core::slice::View<u8>> = alloc::vec::new<core::slice::View<u8>>(); let data: alloc::vec::Vec<u8> = alloc::vec::new<u8>();
    let start: i32 = 0; let status: i32 = 0;
    while (start < input.len() && status == 0) {
        let end: i32 = start; while (end < input.len() && byte(input,end) != 10) { end += 1; }
        let line: core::slice::View<u8> = part(input,start,end); start = end + 1;
        if (line.len() == 0) { continue; }
        words(line,2,w.borrow()); let command: core::slice::View<u8> = w.at(0);
        let result: core::result::Result<i32,ext::websocket_client::Error> = core::result::Ok(0);
        if (eq(command,"send",4) || eq(command,"gen",3)) {
            words(line,3,w.borrow());
            let op: i32 = -1; if (w.len() == 3) { op = opcode_of(w.at(1)); }
            let ok: bool = op > 0;
            if (ok && eq(command,"send",4)) { ok = unescape(w.at(2),data.borrow()); }
            if (ok && eq(command,"gen",3)) { let n: i32 = number(w.at(2)); ok = n >= 0 && generate(op == 1,n,data.borrow()); }
            if (!ok) { status = 2; break; }
            if (op == 1) { result = c.send_text(data.as_view()); } else { result = c.send_binary(data.as_view()); }
        } else {
            if (eq(command,"frag",4)) {
                words(line,4,w.borrow());
                if (w.len() != 4 || opcode_of(w.at(1)) < 0 || number(w.at(2)) < 1 || !unescape(w.at(3),data.borrow())) { status = 2; break; }
                result = send_fragments(c,opcode_of(w.at(1)),number(w.at(2)),data.as_view(),false);
            } else {
                if (eq(command,"fragping",8)) {
                    words(line,3,w.borrow());
                    if (w.len() != 3 || number(w.at(1)) < 1 || !unescape(w.at(2),data.borrow())) { status = 2; break; }
                    result = send_fragments(c,1,number(w.at(1)),data.as_view(),true);
                } else {
                    if (eq(command,"ping",4)) {
                        let payload: core::slice::View<u8> = literal("",0); if (w.len() == 2) { payload = w.at(1); }
                        if (!unescape(payload,data.borrow())) { status = 2; break; }
                        result = c.ping(data.as_view());
                    } else {
                        if (eq(command,"recv",4)) {
                            let ms: i32 = 5000; if (w.len() == 2) { ms = number(w.at(1)); }
                            let got = c.receive(ms);
                            let late: bool = got.is_err() && match(got.unwrap_err()) { ext::websocket_client::Error::Timeout -> true, _ -> false };
                            // A receive timeout leaves the client usable.
                            if (late) { write_to(1,literal("timeout\n",8)); }
                            else { if (got.is_err()) { result = core::result::Err(got.unwrap_err()); } }
                            if (!late && got.is_ok())
                            { if (!report(got.unwrap())) { status = 3; } }
                        } else {
                            if (eq(command,"close",5)) {
                                words(line,3,w.borrow()); let code: i32 = -1; let reason: core::slice::View<u8> = literal("",0);
                                if (w.len() >= 2) { code = number(w.at(1)); if (code < 0) { status = 2; break; } }
                                if (w.len() == 3) { if (!unescape(w.at(2),data.borrow())) { status = 2; break; } reason = data.as_view(); }
                                let closed = c.close(code,reason);
                                if (closed.is_err()) { result = core::result::Err(closed.unwrap_err()); }
                                else {
                                    let out: alloc::vec::Vec<u8> = alloc::vec::new<u8>();
                                    put(out.borrow(),"closed ",7); push_number(out.borrow(),closed.unwrap()); put(out.borrow(),"\n",1);
                                    write_to(1,out.as_view()); out.destroy();
                                }
                            } else { status = 2; break; }
                        }
                    }
                }
            }
        }
        if (result.is_err()) { status = fail(result.unwrap_err()); }
    }
    w.destroy(); data.destroy(); return status;
}
fn read_stdin(out: &alloc::vec::Vec<u8>) -> bool {
    let source = std::stream::stdin(); let scratch: [u8;4096] = [0;4096];
    while (out.len() < 16777216) {
        let got = source.read(scratch,0,4096);
        if (got.is_err()) { if (core::io::is_interrupted(got.unwrap_err())) { continue; } return false; }
        let n: i32 = got.unwrap(); if (n <= 0) { return true; }
        if (out.try_extend(core::slice::view<u8>(scratch,n).unwrap()).is_err()) { return false; }
    }
    return false;
}
fn usage() -> i32 {
    write_to(2,literal("Usage: ws-cat [--cacert FILE] [--protocol LIST] [-H 'Name: value']... [--timeout MS] [--max-message N] [--deflate|--deflate-no-context] URL < SCRIPT\n",149));
    return 2;
}
fn run(args: std::args::Arguments) -> i32 {
    let options: ext::websocket_client::Options = ext::websocket_client::default_options();
    let headers: alloc::vec::Vec<ext::http::Field> = alloc::vec::new<ext::http::Field>(); let url: core::option::Option<core::slice::View<u8>> = core::option::None();
    let i: i32 = 0;
    while (i < args.len()) {
        let a: core::slice::View<u8> = args.get(i).unwrap(); i += 1;
        if (eq(a,"--deflate",9)) { options.deflate = true; continue; }
        if (eq(a,"--deflate-no-context",20)) { options.deflate = true; options.deflate_no_context = true; continue; }
        if (a.len() > 0 && byte(a,0) == 45) {
            if (i >= args.len()) { headers.destroy(); return usage(); }
            let v: core::slice::View<u8> = args.get(i).unwrap(); i += 1;
            if (eq(a,"--cacert",8)) { options.agent.trust = ext::openssl_tls::Trust::CaFile(v); continue; }
            if (eq(a,"--protocol",10)) { options.protocols = v; continue; }
            if (eq(a,"--timeout",9) && number(v) > 0) { options.timeout_ms = number(v); continue; }
            if (eq(a,"--max-message",13) && number(v) > 0) { options.wire.message_bytes = number(v); options.wire.frame_bytes = number(v); continue; }
            if (eq(a,"-H",2)) {
                let c: i32 = 0; while (c < v.len() && byte(v,c) != 58) { c += 1; }
                if (c == 0 || c == v.len()) { headers.destroy(); return usage(); }
                let s: i32 = c + 1; while (s < v.len() && byte(v,s) == 32) { s += 1; }
                headers.try_push(ext::http::Field { raw: v, name: part(v,0,c), value: part(v,s,v.len()), offset: 0 }); continue;
            }
            headers.destroy(); return usage();
        }
        if (url.is_some()) { headers.destroy(); return usage(); }
        url = core::option::Some(a);
    }
    if (url.is_none()) { headers.destroy(); return usage(); }
    options.headers = headers.as_view();
    let input: alloc::vec::Vec<u8> = alloc::vec::new<u8>();
    if (!read_stdin(input.borrow())) { input.destroy(); headers.destroy(); return usage(); }
    let opened = ext::websocket_client::connect(url.unwrap(),options);
    if (opened.is_err()) { input.destroy(); headers.destroy(); return fail(opened.unwrap_err()); }
    let client: ext::websocket_client::Client = opened.unwrap();
    let line: alloc::vec::Vec<u8> = alloc::vec::new<u8>(); let secure: i32 = 0; if (client.is_secure()) { secure = 1; }
    put(line.borrow(),"open secure=",12); push_number(line.borrow(),secure); put(line.borrow()," protocol=",10);
    let p = client.protocol(); if (p.is_some()) { line.try_extend(p.unwrap()); } else { put(line.borrow(),"-",1); }
    if (client.compressed()) { put(line.borrow()," deflate=1",10); }
    put(line.borrow(),"\n",1); write_to(1,line.as_view()); line.destroy();
    let status: i32 = script(client.borrow(),input.as_view());
    client.destroy(); input.destroy(); headers.destroy(); return status;
}
fn main() -> i32 {
    if (std::signal::set_disposition(std::signal::Signal::BrokenPipe,std::signal::Disposition::Ignore).is_err()) { return 2; }
    let got = std::args::snapshot(1,64,65536); if (got.is_err()) { return 2; }
    let args = got.unwrap(); let status = run(args); args.destroy(); return status;
}
