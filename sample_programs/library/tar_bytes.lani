// Binary ustar creation, NUL-delimited listing and exact member reads.
// Validate the complete archive before stdout; never extract to the filesystem.
// Exit 2: arguments/format/limits; 3: I/O; 4: allocation. Diagnostics are best effort.
module app::main;
import alloc::io;
import alloc::vec;
import core::decimal;
import core::io;
import core::mem;
import core::option;
import core::result;
import core::slice;
import ext::cli;
import ext::compression;
import ext::tar;
import std::args;
import std::stream;

struct Options { mode: i32, mode_set: bool, name: core::slice::View<u8>, gzip: bool, max_input: i32, max_archive: i32, max_output: i32, max_entries: i32, help: bool }
impl Options { fn borrow(&self) -> &Options { return self; } }
enum Error { ArchiveLimit, OutputLimit, EntryLimit, NotFound, Duplicate, NotRegular, TarArchive, TarMember, Compression, AllocationFailed }
fn literal(value: str, count: i32) -> core::slice::View<u8> {
    let bytes: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::string_data_ptr(value),count); return core::result::unwrap(core::slice::view(bytes,count));
}
fn equal(left: core::slice::View<u8>, right: core::slice::View<u8>) -> bool {
    if (left.len() != right.len()) { return false; } let index: i32 = 0;
    while (index < left.len()) { if (core::option::unwrap(left.get(index)) != core::option::unwrap(right.get(index))) { return false; } index += 1; } return true;
}
fn report(status: i32, message: core::slice::View<u8>) -> i32 {
    let sink: std::stream::Descriptor = std::stream::stderr(); core::io::write_all(sink.borrow(),message.values,message.start,message.len()); return status;
}
fn failed(error: Error) -> i32 {
    let status: i32 = match (error) { Error::AllocationFailed -> 4, _ -> 2 };
    let message: core::slice::View<u8> = match (error) {
        Error::ArchiveLimit -> literal("tar-bytes: archive limit exceeded\n",34),
        Error::OutputLimit -> literal("tar-bytes: output limit exceeded\n",33),
        Error::EntryLimit -> literal("tar-bytes: entry limit exceeded\n",32),
        Error::NotFound -> literal("tar-bytes: member not found\n",28),
        Error::Duplicate -> literal("tar-bytes: duplicate member name\n",33),
        Error::NotRegular -> literal("tar-bytes: member is not a regular file\n",40),
        Error::TarArchive -> literal("tar-bytes: invalid tar archive\n",31),
        Error::TarMember -> literal("tar-bytes: invalid tar member\n",30),
        Error::Compression -> literal("tar-bytes: invalid compressed archive\n",38),
        Error::AllocationFailed -> literal("tar-bytes: allocation failed\n",29)
    }; return report(status,message);
}
fn input_error(error: core::io::Error) -> i32 {
    let limited: bool = match (error) { core::io::Error::LimitExceeded -> true, _ -> false };
    if (limited) { return report(2,literal("tar-bytes: input limit exceeded\n",32)); }
    let allocation: bool = match (error) { core::io::Error::AllocationFailed -> true, _ -> false };
    if (allocation) { return failed(Error::AllocationFailed); }
    return report(3,literal("tar-bytes: input I/O failed\n",28));
}
fn compression_error(error: ext::compression::Error, decoding: bool) -> Error {
    let mapped: Error = match (error) {
        ext::compression::Error::AllocationFailed -> Error::AllocationFailed,
        ext::compression::Error::OutputLimit -> Error::OutputLimit,
        _ -> Error::Compression
    };
    let capacity: bool = match (error) { ext::compression::Error::OutputLimit -> true, _ -> false };
    if (decoding && capacity) { return Error::ArchiveLimit; } return mapped;
}
fn apply(options: &Options, item: ext::cli::Occurrence) -> bool {
    if (item.id >= 1 && item.id <= 3) {
        if (options.mode_set) { return false; } options.mode_set = true; options.mode = item.id - 1;
        if (item.id != 1) { options.name = core::option::unwrap(item.value).bytes; if (options.name.is_empty()) { return false; } } return true;
    }
    if (item.id == 4) { options.gzip = true; return true; }
    if (item.id == 9) { options.help = true; return true; }
    let argument: ext::cli::Argument = core::option::unwrap(item.value); let bytes: core::slice::View<u8> = argument.bytes;
    let parsed: core::result::Result<u64,core::decimal::ParseError> = core::decimal::parse_u64_range(bytes.values,bytes.start,bytes.len());
    if (core::result::is_err(parsed)) { return false; } let value: u64 = core::result::unwrap(parsed); if (value > 2147483647 as u64) { return false; }
    if (item.id == 5) { options.max_input = value as i32; }
    if (item.id == 6) { options.max_archive = value as i32; }
    if (item.id == 7) { options.max_output = value as i32; }
    if (item.id == 8) { options.max_entries = value as i32; } return true;
}
fn read_tar(options: Options, input: core::slice::View<u8>) -> core::result::Result<alloc::vec::Vec<u8>,Error> {
    if (input.len() > options.max_archive) { return core::result::Err(Error::ArchiveLimit); }
    let opened: core::result::Result<ext::tar::Reader,ext::tar::Error> = ext::tar::reader(input);
    if (core::result::is_err(opened)) { return core::result::Err(Error::TarArchive); }
    let reader: ext::tar::Reader = core::result::unwrap(opened);
    let count: i32 = 0; let size: i32 = 0; let found: bool = false; let selected: core::slice::View<u8> = literal("",0);
    let words: [i32;64] = [0;64]; let path: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(words),256);
    let path_view: core::slice::View<u8> = core::result::unwrap(core::slice::view(path,256));
    while (true) {
        let parsed: core::result::Result<core::option::Option<ext::tar::Entry>,ext::tar::Error> = reader.next();
        if (core::result::is_err(parsed)) { return core::result::Err(Error::TarArchive); }
        let next: core::option::Option<ext::tar::Entry> = core::result::unwrap(parsed); if (core::option::is_none(next)) { break; }
        if (count >= options.max_entries) { return core::result::Err(Error::EntryLimit); } count += 1;
        let entry: ext::tar::Entry = core::option::unwrap(next); let length: i32 = core::result::unwrap(entry.copy_path(path_view));
        let name: core::slice::View<u8> = core::result::unwrap(path_view.subview(0,length));
        if (options.mode == 0) {
            if (length >= options.max_output - size) { return core::result::Err(Error::OutputLimit); } size += length + 1;
        } else {
            if (equal(name,options.name)) {
                if (found) { return core::result::Err(Error::Duplicate); }
                let regular: bool = match (entry.kind) { ext::tar::Kind::Regular -> true, ext::tar::Kind::Contiguous -> true, _ -> false };
                if (!regular) { return core::result::Err(Error::NotRegular); }
                if (entry.data.len() > options.max_output) { return core::result::Err(Error::OutputLimit); }
                found = true; selected = entry.data; size = selected.len();
            }
        }
    }
    if (options.mode == 1) {
        if (!found) { return core::result::Err(Error::NotFound); }
        let copied: core::result::Result<alloc::vec::Vec<u8>,alloc::vec::Error> = alloc::vec::from_view(selected);
        if (core::result::is_err(copied)) { return core::result::Err(Error::AllocationFailed); } return core::result::Ok(core::result::unwrap(copied));
    }
    let allocated: core::result::Result<alloc::vec::Vec<u8>,alloc::vec::Error> = alloc::vec::with_capacity(size);
    if (core::result::is_err(allocated)) { return core::result::Err(Error::AllocationFailed); }
    let output: alloc::vec::Vec<u8> = core::result::unwrap(allocated); let again: ext::tar::Reader = core::result::unwrap(ext::tar::reader(input));
    while (true) {
        let next: core::option::Option<ext::tar::Entry> = core::result::unwrap(again.next()); if (core::option::is_none(next)) { break; }
        let entry: ext::tar::Entry = core::option::unwrap(next); let length: i32 = core::result::unwrap(entry.copy_path(path_view)); let index: i32 = 0;
        while (index < length) { core::result::unwrap(output.try_push(core::option::unwrap(path_view.get(index)))); index += 1; } core::result::unwrap(output.try_push(0));
    } return core::result::Ok(output);
}
fn create_tar(options: Options, input: core::slice::View<u8>) -> core::result::Result<alloc::vec::Vec<u8>,Error> {
    if (options.max_entries < 1) { return core::result::Err(Error::EntryLimit); }
    let length: u64 = ((input.len() as u64 + 511) / 512) * 512 + 1536;
    if (length > options.max_archive as u64) { return core::result::Err(Error::ArchiveLimit); }
    if (!options.gzip && length > options.max_output as u64) { return core::result::Err(Error::OutputLimit); }
    let allocated: core::result::Result<alloc::vec::Vec<u8>,alloc::vec::Error> = alloc::vec::with_capacity(length as i32);
    if (core::result::is_err(allocated)) { return core::result::Err(Error::AllocationFailed); } let archive: alloc::vec::Vec<u8> = core::result::unwrap(allocated);
    core::result::unwrap(archive.try_resize(length as i32,0)); let writer: ext::tar::Writer = core::result::unwrap(ext::tar::writer(archive.as_view()));
    let meta: ext::tar::Metadata = ext::tar::metadata(options.name,ext::tar::Kind::Regular);
    if (core::result::is_err(writer.add(meta,input))) { archive.destroy(); return core::result::Err(Error::TarMember); }
    core::result::unwrap(writer.finish()); return core::result::Ok(archive);
}
fn convert(options: Options, input: core::slice::View<u8>) -> core::result::Result<alloc::vec::Vec<u8>,Error> {
    if (options.mode == 2) {
        let created: core::result::Result<alloc::vec::Vec<u8>,Error> = create_tar(options,input); if (core::result::is_err(created)) { return created; }
        let archive: alloc::vec::Vec<u8> = core::result::unwrap(created); if (!options.gzip) { return core::result::Ok(archive); }
        let encoded: core::result::Result<alloc::vec::Vec<u8>,ext::compression::Error> = ext::compression::encode(archive.as_view(),ext::compression::Format::Gzip,options.max_output); archive.destroy();
        if (core::result::is_err(encoded)) { return core::result::Err(compression_error(core::result::unwrap_err(encoded),false)); } return core::result::Ok(core::result::unwrap(encoded));
    }
    if (!options.gzip) { return read_tar(options,input); }
    let limits: ext::compression::Limits = ext::compression::Limits { max_input: options.max_input, max_output: options.max_archive, max_members: 1024 };
    let decoded: core::result::Result<alloc::vec::Vec<u8>,ext::compression::Error> = ext::compression::decode(input,ext::compression::Format::Gzip,limits);
    if (core::result::is_err(decoded)) { return core::result::Err(compression_error(core::result::unwrap_err(decoded),true)); }
    let archive: alloc::vec::Vec<u8> = core::result::unwrap(decoded); let result: core::result::Result<alloc::vec::Vec<u8>,Error> = read_tar(options,archive.as_view()); archive.destroy(); return result;
}
fn process(options: Options) -> i32 {
    let input: alloc::io::Buffer = core::result::unwrap(alloc::io::with_limit(options.max_input)); let source: std::stream::Descriptor = std::stream::stdin();
    let copied: core::result::Result<u64,core::io::CopyFailure> = std::stream::copy(source.borrow(),input.borrow());
    if (core::result::is_err(copied)) { let failure: core::io::CopyFailure = core::result::unwrap_err(copied); input.destroy(); return input_error(failure.cause); }
    let bytes: core::slice::View<u8> = core::result::unwrap(core::slice::view(input.as_bytes(),input.len())); let converted: core::result::Result<alloc::vec::Vec<u8>,Error> = convert(options,bytes); input.destroy();
    if (core::result::is_err(converted)) { return failed(core::result::unwrap_err(converted)); }
    let output: alloc::vec::Vec<u8> = core::result::unwrap(converted); let sink: std::stream::Descriptor = std::stream::stdout();
    let written: core::result::Result<i32,core::io::Failure> = core::io::write_all(sink.borrow(),output.as_slice(),0,output.len()); output.destroy();
    if (core::result::is_err(written)) { return report(3,literal("tar-bytes: output I/O failed\n",29)); } return 0;
}
fn arguments(values: std::args::Arguments) -> i32 {
    let specs: [ext::cli::Spec;9] = [
        ext::cli::Spec { id: 1, long: literal("list",4), short: 116, arity: ext::cli::Arity::Flag },
        ext::cli::Spec { id: 2, long: literal("get",3), short: 103, arity: ext::cli::Arity::Required },
        ext::cli::Spec { id: 3, long: literal("create",6), short: 99, arity: ext::cli::Arity::Required },
        ext::cli::Spec { id: 4, long: literal("gzip",4), short: 122, arity: ext::cli::Arity::Flag },
        ext::cli::Spec { id: 5, long: literal("max-input",9), short: 0, arity: ext::cli::Arity::Required },
        ext::cli::Spec { id: 6, long: literal("max-archive",11), short: 0, arity: ext::cli::Arity::Required },
        ext::cli::Spec { id: 7, long: literal("max-output",10), short: 0, arity: ext::cli::Arity::Required },
        ext::cli::Spec { id: 8, long: literal("max-entries",11), short: 0, arity: ext::cli::Arity::Required },
        ext::cli::Spec { id: 9, long: literal("help",4), short: 104, arity: ext::cli::Arity::Flag }
    ];
    let schema: core::slice::View<ext::cli::Spec> = core::result::unwrap(core::slice::view(specs,9)); let parser: ext::cli::Parser = core::result::unwrap(ext::cli::parser(values.as_view(),schema,ext::cli::Ordering::Intermixed));
    let options: Options = Options { mode: 0, mode_set: false, name: literal("",0), gzip: false, max_input: 16777216, max_archive: 67108864, max_output: 67108864, max_entries: 4096, help: false };
    while (true) {
        let parsed: core::result::Result<core::option::Option<ext::cli::Event>,ext::cli::Error> = parser.next(); if (core::result::is_err(parsed)) { return report(2,literal("tar-bytes: invalid arguments\n",29)); }
        let next: core::option::Option<ext::cli::Event> = core::result::unwrap(parsed); if (core::option::is_none(next)) { break; }
        let valid: bool = match (core::option::unwrap(next)) { ext::cli::Event::Option(item) -> apply(options.borrow(),item), ext::cli::Event::Operand(item) -> false };
        if (!valid) { return report(2,literal("tar-bytes: invalid arguments\n",29)); }
    }
    if (options.help) {
        let usage: core::slice::View<u8> = literal("Usage: tar-bytes [--list|--get NAME|--create NAME] [--gzip] [--max-input N] [--max-archive N] [--max-output N] [--max-entries N]\n",129); let sink: std::stream::Descriptor = std::stream::stdout();
        if (core::result::is_err(core::io::write_all(sink.borrow(),usage.values,0,usage.len()))) { return report(3,literal("tar-bytes: output I/O failed\n",29)); } return 0;
    } return process(options);
}
fn main() -> i32 {
    let captured: core::result::Result<std::args::Arguments,std::args::Error> = std::args::snapshot(1,32,4096);
    if (core::result::is_err(captured)) {
        let error: std::args::Error = core::result::unwrap_err(captured); let status: i32 = match (error) { std::args::Error::AllocationFailed -> 4, std::args::Error::HostRead(index) -> 3, _ -> 2 };
        return report(status,literal("tar-bytes: cannot capture arguments\n",36));
    } let values: std::args::Arguments = core::result::unwrap(captured); let status: i32 = arguments(values); values.destroy(); return status;
}
