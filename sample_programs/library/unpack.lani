fn main() -> i32 {
    // Turn a closed report pipe into a counted write error, preserving the
    // extraction outcome instead of terminating before explicit cleanup.
    if(std::signal::set_disposition(std::signal::Signal::BrokenPipe,std::signal::Disposition::Ignore).is_err()) { return 3; }
    let captured=std::args::snapshot(1,128,262144);
    if(captured.is_err()) { return match(captured.unwrap_err()) { std::args::Error::AllocationFailed->4,std::args::Error::HostRead(index)->3,_ ->2 }; }
    let args=captured.unwrap();
    if(args.len()==1 && same(args.get(0).unwrap(),literal("--help",6))) {
        let made=output(16384,64); if(made.is_err()) { args.destroy(); return 4; }
        let out=made.unwrap(); out.text(literal("Usage: unpack --format tar|zip --root OUTPUT_DIRECTORY [--NAME VALUE ...] -- ARCHIVE_FILE\nContent only: ownership, permissions, timestamps, links, and other archive metadata are ignored or rejected by the profile.\nExisting root; regular no-follow nonblocking input is fully read and closed before output mutation.\nNoReplace publication in a cooperative stable namespace; failures can leave partial output. No directory transaction or hard wall-clock limit.\nAll numbers are unsigned decimal. Each option occurs once. No short options or --name=value syntax.\nLimits: --input-bytes --input-reads --entries --nodes --depth --path-bytes --component-bytes --path-storage-bytes --entry-bytes --decoded-bytes --plan-work --zip-work --metadata-work --source-owned-bytes --run-owned-bytes --program-owned-bytes --host-calls --cleanup-calls --write-calls --sync-calls --entropy-calls --name-attempts --steps --report-bytes --report-writes\nReports use canonical path hex, node/ordinal identities, current publication/sync/cleanup facts, and kept recovery names. Report failure is nonzero and can obscure recovery diagnostics.\n",1114)); out.emit(false); let failed=out.failed; out.destroy(); args.destroy(); if(failed) { return 7; } return 0;
    }
    let parsed=parse(args);
    if(parsed.is_err()) {
        let made=output(16384,64); if(made.is_ok()) { let out=made.unwrap(); early(out.borrow(),2,literal("arguments",9),0,-1,0,0,0); out.destroy(); } args.destroy(); return 2;
    }
    let config=parsed.unwrap();
    if(!owned_preflight(args,config)) { args.destroy(); return 2; }
    // Validate source reservations without reading/opening anything, then
    // reserve every report byte before any potential output namespace effect.
    let reserved=ext::archive_source::reservation_bytes(source_limits(config));
    if(reserved.is_err()) { let code=source_code(reserved.unwrap_err().cause); args.destroy(); return code; }
    let made=output(config.limits[23],config.limits[24]);
    if(made.is_err()) { args.destroy(); return 4; }
    let out=made.unwrap(); let code=execute(config,out.borrow()); out.destroy(); args.destroy(); return code;
}
