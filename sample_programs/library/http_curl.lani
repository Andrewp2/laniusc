// curl-like HTTP/1.1 client over ext::http_agent: fetches each URL in turn
// through one keep-alive pool, optionally following redirects, sending a
// fixed (-d) or streamed chunked (-T) body, and reporting pool statistics.
module app::main;
import alloc::vec;
import core::io;
import core::mem;
import core::option;
import core::path;
import core::result;
import core::slice;
import ext::http;
import ext::http_agent;
import ext::openssl_tls;
import std::args;
import std::clock;
import std::file;
import std::file_ops;
import std::signal;
import std::stream;

fn literal(s: str, n: i32) -> core::slice::View<u8> { let raw: [u8] = core::mem::typed_slice_from_raw_parts<u8>(core::mem::string_data_ptr(s),n); return core::slice::view<u8>(raw,n).unwrap(); }
fn byte(v: core::slice::View<u8>, i: i32) -> u8 { return v.values[v.start+i]; }
fn part(v: core::slice::View<u8>, start: i32, end: i32) -> core::slice::View<u8> { return v.subview(start,end).unwrap(); }
fn eq(v: core::slice::View<u8>, s: str, n: i32) -> bool {
    let w: core::slice::View<u8> = literal(s,n); if (v.len() != n) { return false; }
    let i: i32 = 0; while (i < n) { if (byte(v,i) != byte(w,i)) { return false; } i += 1; } return true;
}
fn write_to(fd: i32, bytes: core::slice::View<u8>) -> bool {
    let sink: std::stream::Descriptor = std::stream::from_handle(fd); let completed: i32 = 0;
    while (completed < bytes.len()) {
        let sent = sink.write(bytes.values,bytes.start + completed,bytes.len() - completed);
        if (sent.is_err()) { if (core::io::is_interrupted(sent.unwrap_err())) { continue; } return false; }
        let count: i32 = sent.unwrap(); if (count <= 0) { return false; } completed += count;
    }
    return true;
}
fn say(s: str, n: i32) { write_to(2,literal(s,n)); }
fn push(out: &alloc::vec::Vec<u8>, v: core::slice::View<u8>) -> bool { return out.try_extend(v).is_ok(); }
fn put(out: &alloc::vec::Vec<u8>, s: str, n: i32) -> bool { return out.try_extend(literal(s,n)).is_ok(); }
fn push_number(out: &alloc::vec::Vec<u8>, value: i32) -> bool {
    let digits: [u8;12] = [0;12]; let i: i32 = 12; let v: i32 = value; if (v < 0) { v = 0; }
    while (true) { i -= 1; digits[i] = (48 + v % 10) as u8; v = v / 10; if (v == 0) { break; } }
    while (i < 12) { if (out.try_push(digits[i]).is_err()) { return false; } i += 1; }
    return true;
}
fn field(out: &alloc::vec::Vec<u8>, s: str, n: i32, value: i32) -> bool { return put(out,s,n) && push_number(out,value); }
fn number(v: core::slice::View<u8>) -> i32 {
    if (v.len() == 0 || v.len() > 9) { return -1; } let n: i32 = 0; let i: i32 = 0;
    while (i < v.len()) { let c: u8 = byte(v,i); if (c < 48 || c > 57) { return -1; } n = n * 10 + ((c - 48) as i32); i += 1; }
    return n;
}
// curl's exit codes for the matching failures.
fn code(e: ext::http_agent::Error) -> i32 {
    return match(e) {
        ext::http_agent::Error::InvalidRequest -> 2, ext::http_agent::Error::InvalidHeader -> 2, ext::http_agent::Error::Url(k) -> 3,
        ext::http_agent::Error::UnsupportedScheme -> 1, ext::http_agent::Error::Connect(c) -> 7, ext::http_agent::Error::Io(i) -> 56,
        ext::http_agent::Error::Timeout -> 28, ext::http_agent::Error::Truncated(n) -> match(n) { 0 -> 52, _ -> 18 },
        ext::http_agent::Error::Parse(p) -> 8, ext::http_agent::Error::TooLarge -> 63, ext::http_agent::Error::TooManyRedirects(n) -> 47,
        ext::http_agent::Error::BadLocation -> 3, ext::http_agent::Error::UnreplayableBody(s) -> 65, ext::http_agent::Error::UnexpectedUpgrade -> 8,
        ext::http_agent::Error::Source(i) -> 26, ext::http_agent::Error::AllocationFailed -> 27, ext::http_agent::Error::Clock -> 2,
        ext::http_agent::Error::Tls(t) -> match(t.cause) { ext::openssl_tls::Cause::Verification -> 60, ext::openssl_tls::Cause::PeerCertificate -> 60, _ -> 35 }
    };
}
fn name(e: ext::http_agent::Error) -> core::slice::View<u8> {
    return match(e) {
        ext::http_agent::Error::InvalidRequest -> literal("invalid request",15), ext::http_agent::Error::InvalidHeader -> literal("invalid header",14),
        ext::http_agent::Error::Url(k) -> literal("bad URL",7), ext::http_agent::Error::UnsupportedScheme -> literal("unsupported scheme",18),
        ext::http_agent::Error::Connect(c) -> literal("connect failed",14), ext::http_agent::Error::Io(i) -> literal("connection error",16),
        ext::http_agent::Error::Timeout -> literal("timed out",9), ext::http_agent::Error::Truncated(n) -> match(n) { 0 -> literal("empty reply",11), _ -> literal("truncated response",18) },
        ext::http_agent::Error::Parse(p) -> literal("malformed response",18), ext::http_agent::Error::TooLarge -> literal("response too large",18),
        ext::http_agent::Error::TooManyRedirects(n) -> literal("too many redirects",18), ext::http_agent::Error::BadLocation -> literal("bad redirect location",21),
        ext::http_agent::Error::UnreplayableBody(s) -> literal("redirect needs the streamed body again",38), ext::http_agent::Error::UnexpectedUpgrade -> literal("unexpected upgrade",18),
        ext::http_agent::Error::Source(i) -> literal("upload read error",17), ext::http_agent::Error::AllocationFailed -> literal("out of memory",13),
        ext::http_agent::Error::Clock -> literal("clock error",11),
        ext::http_agent::Error::Tls(t) -> match(t.cause) { ext::openssl_tls::Cause::Verification -> literal("certificate verification failed",31), ext::openssl_tls::Cause::PeerCertificate -> literal("certificate verification failed",31), _ -> literal("TLS error",9) }
    };
}
fn report(r: &ext::http_agent::Response) -> bool {
    let line: alloc::vec::Vec<u8> = alloc::vec::new<u8>(); let reused: i32 = 0; let kept: i32 = 0; if (r.reused) { reused = 1; } if (r.kept) { kept = 1; }
    let ok: bool = field(line.borrow(),"response status=",16,r.status) && field(line.borrow()," redirects=",11,r.redirects) && field(line.borrow()," reused=",8,reused)
        && field(line.borrow()," kept=",6,kept) && field(line.borrow()," bytes=",7,r.body().len()) && put(line.borrow()," url=",5) && push(line.borrow(),r.url()) && put(line.borrow(),"\n",1);
    ok = ok && write_to(2,line.as_view()); line.destroy(); return ok;
}
fn totals(agent: &ext::http_agent::Agent) -> bool {
    let s: ext::http_agent::Stats = agent.stats(); let line: alloc::vec::Vec<u8> = alloc::vec::new<u8>();
    let ok: bool = field(line.borrow(),"pool connections=",17,s.connections) && field(line.borrow()," reused=",8,s.reused) && field(line.borrow()," requests=",10,s.requests)
        && field(line.borrow()," redirects=",11,s.redirects) && field(line.borrow()," retries=",9,s.retries) && field(line.borrow()," stale=",7,s.stale)
        && field(line.borrow()," evicted=",9,s.evicted) && field(line.borrow()," expired=",9,s.expired) && field(line.borrow()," early=",7,s.early)
        && field(line.borrow()," idle=",6,agent.idle()) && put(line.borrow(),"\n",1);
    ok = ok && write_to(2,line.as_view()); line.destroy(); return ok;
}
fn usage() -> i32 {
    say("Usage: http-curl [-X METHOD] [-H 'Name: value']... [-d DATA | -T FILE|-] [-L] [--max-redirs N] [-i] [-I] [-f] [--max-time MS]\n",126);
    say("       [--cacert FILE] [--no-https]\n",36);
    say("       [--max-idle-per-host N] [--max-idle N] [--idle-timeout MS] [--max-uses N] [--preconnect N] [--pause MS] [--no-retry] [--stats] URL...\n",141);
    return 2;
}
fn open_upload(path: core::slice::View<u8>) -> core::option::Option<std::file::File> {
    if (eq(path,"-",1)) { return core::option::Some(std::file::File { handle: 0 }); }
    let p = core::path::from_bytes_range(path.values,path.start,path.len()); if (p.is_err()) { return core::option::None(); }
    let opened = std::file_ops::open(p.unwrap(),std::file_ops::options()); if (opened.is_err()) { return core::option::None(); }
    return core::option::Some(opened.unwrap());
}

fn run(args: std::args::Arguments) -> i32 {
    let options: ext::http_agent::Options = ext::http_agent::default_options(); options.follow_redirects = false;
    let headers: alloc::vec::Vec<ext::http::Field> = alloc::vec::new<ext::http::Field>(); let urls: alloc::vec::Vec<core::slice::View<u8>> = alloc::vec::new<core::slice::View<u8>>();
    let method: core::option::Option<core::slice::View<u8>> = core::option::None(); let data: core::option::Option<core::slice::View<u8>> = core::option::None();
    let upload: core::option::Option<core::slice::View<u8>> = core::option::None();
    let include: bool = false; let head_only: bool = false; let fail: bool = false; let stats: bool = false; let pause: i32 = 0; let preconnect: i32 = 0;
    let i: i32 = 0;
    while (i < args.len()) {
        let a: core::slice::View<u8> = args.get(i).unwrap(); i += 1;
        if (eq(a,"-L",2)) { options.follow_redirects = true; continue; }
        if (eq(a,"-i",2)) { include = true; continue; }
        if (eq(a,"-I",2)) { head_only = true; continue; }
        if (eq(a,"-f",2)) { fail = true; continue; }
        if (eq(a,"--stats",7)) { stats = true; continue; }
        if (eq(a,"--no-retry",10)) { options.retry_stale = false; continue; }
        if (eq(a,"--no-https",10)) { options.https = false; continue; }
        if (a.len() > 0 && byte(a,0) == 45) {
            if (i >= args.len()) { headers.destroy(); urls.destroy(); return usage(); }
            let v: core::slice::View<u8> = args.get(i).unwrap(); i += 1; let n: i32 = number(v);
            if (eq(a,"-X",2)) { method = core::option::Some(v); continue; }
            if (eq(a,"-d",2)) { data = core::option::Some(v); continue; }
            if (eq(a,"-T",2)) { upload = core::option::Some(v); continue; }
            if (eq(a,"--cacert",8)) { options.trust = ext::openssl_tls::Trust::CaFile(v); continue; }
            if (eq(a,"-H",2)) {
                let c: i32 = 0; while (c < v.len() && byte(v,c) != 58) { c += 1; }
                if (c == 0 || c == v.len()) { headers.destroy(); urls.destroy(); return usage(); }
                let s: i32 = c + 1; while (s < v.len() && (byte(v,s) == 32 || byte(v,s) == 9)) { s += 1; }
                headers.try_push(ext::http::Field { raw: v, name: part(v,0,c), value: part(v,s,v.len()), offset: 0 }); continue;
            }
            if (n < 0) { headers.destroy(); urls.destroy(); return usage(); }
            if (eq(a,"--max-redirs",12)) { options.max_redirects = n; continue; }
            if (eq(a,"--max-time",10) && n > 0) { options.timeout_ms = n; continue; }
            if (eq(a,"--max-idle-per-host",19)) { options.max_idle_per_host = n; continue; }
            if (eq(a,"--max-idle",10)) { options.max_idle_total = n; continue; }
            if (eq(a,"--idle-timeout",14)) { options.idle_timeout_ms = n; continue; }
            if (eq(a,"--max-uses",10) && n > 0) { options.max_uses = n; continue; }
            if (eq(a,"--preconnect",12)) { preconnect = n; continue; }
            if (eq(a,"--pause",7)) { pause = n; continue; }
            headers.destroy(); urls.destroy(); return usage();
        }
        urls.try_push(a);
    }
    if (urls.len() == 0 || (data.is_some() && upload.is_some())) { headers.destroy(); urls.destroy(); return usage(); }
    let verb: core::slice::View<u8> = literal("GET",3);
    if (head_only) { verb = literal("HEAD",4); } if (data.is_some()) { verb = literal("POST",4); } if (upload.is_some()) { verb = literal("PUT",3); }
    if (method.is_some()) { verb = method.unwrap(); }
    let made: core::result::Result<ext::http_agent::Agent,ext::http_agent::Error> = ext::http_agent::agent(options);
    if (made.is_err()) { headers.destroy(); urls.destroy(); return usage(); }
    let agent: ext::http_agent::Agent = made.unwrap(); let status: i32 = 0;
    if (preconnect > 0) {
        let warmed = agent.preconnect(urls.at(0),preconnect);
        if (warmed.is_err()) { let e = warmed.unwrap_err(); say("http-curl: ",11); write_to(2,name(e)); say("\n",1); status = code(e); }
    }
    let u: i32 = 0; let clock = std::clock::native();
    while (status == 0 && u < urls.len()) {
        if (u > 0 && pause > 0) { clock.pause_ms(pause); }
        let body: core::slice::View<u8> = literal("",0); if (data.is_some()) { body = data.unwrap(); }
        let request: ext::http_agent::Request = ext::http_agent::Request { method: verb, url: urls.at(u), headers: headers.as_view(), body: body };
        let got: core::result::Result<ext::http_agent::Response,ext::http_agent::Error> = core::result::Err(ext::http_agent::Error::InvalidRequest);
        if (upload.is_some()) {
            let source = open_upload(upload.unwrap());
            if (source.is_none()) { say("http-curl: cannot open upload\n",30); status = 26; break; }
            let file: std::file::File = source.unwrap();
            got = ext::http_agent::fetch_stream<std::file::File>(agent.borrow(),request,file.borrow());
            if (file.handle != 0) { file.close(); }
        } else { got = agent.fetch(request); }
        if (got.is_err()) { let e = got.unwrap_err(); say("http-curl: ",11); write_to(2,name(e)); say("\n",1); status = code(e); break; }
        let r: ext::http_agent::Response = got.unwrap();
        if (stats) { report(r.borrow()); }
        if (fail && r.status >= 400) { say("http-curl: HTTP error\n",22); status = 22; r.destroy(); break; }
        if ((include || head_only) && !write_to(1,r.head())) { status = 23; }
        if (status == 0 && !write_to(1,r.body())) { status = 23; }
        r.destroy(); u += 1;
    }
    if (stats) { totals(agent.borrow()); }
    agent.close(); headers.destroy(); urls.destroy(); return status;
}
fn main() -> i32 {
    if (std::signal::set_disposition(std::signal::Signal::BrokenPipe,std::signal::Disposition::Ignore).is_err()) { return 2; }
    let got = std::args::snapshot(1,64,65536); if (got.is_err()) { return 2; }
    let args = got.unwrap(); let status = run(args); args.destroy(); return status;
}
