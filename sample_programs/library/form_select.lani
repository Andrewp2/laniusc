// Select decoded byte keys and stream canonical ordered form pairs.
module app::main;
import alloc::io;
import alloc::string;
import alloc::vec;
import core::io;
import core::iter;
import core::option;
import core::result;
import core::result::Result;
import core::slice;
import ext::form;
import ext::form_owned;
import std::args;
import std::signal;
import std::stream;

fn form_failure(error:ext::form_owned::Error) -> i32 {
    return match (error) {
        ext::form_owned::Error::AllocationFailed -> 4,
        _ -> 2
    };
}

fn same(left:core::slice::View<u8>, right:core::slice::View<u8>) -> bool {
    if (left.length != right.length) { return false; }
    let index:i32 = 0;
    while (index < left.length) {
        if (left.values[left.start+index] != right.values[right.start+index]) { return false; }
        index += 1;
    }
    return true;
}

fn read_failure(error:alloc::io::ReadError) -> i32 {
    return match (error) {
        alloc::io::ReadError::InvalidLimits -> 2,
        alloc::io::ReadError::CallLimit -> 2,
        alloc::io::ReadError::ByteLimit -> 2,
        alloc::io::ReadError::Io(cause) -> match (cause) {
            core::io::Error::AllocationFailed -> 4,
            core::io::Error::LimitExceeded -> 2,
            _ -> 3
        },
        alloc::io::ReadError::Storage(cause) -> match (cause) {
            alloc::vec::Error::AllocationFailed -> 4,
            _ -> 2
        },
        alloc::io::ReadError::Text(cause) -> match (cause) {
            alloc::string::Error::AllocationFailed -> 4,
            _ -> 2
        }
    };
}

fn publish(selected:&alloc::vec::Vec<ext::form::Pair>) -> i32 {
    // Exact output admission completes before the first stdout operation.
    let prepared:Result<ext::form::Encoding,ext::form::Error> =
        ext::form::encoding(ext::form::PairSource::Views(selected.as_view()),1048576);
    if (prepared.is_err()) { return 2; }
    let encoding:ext::form::Encoding = prepared.unwrap();
    let output:std::stream::Descriptor = std::stream::stdout();
    let scratch:[u8;1024] = [0;1024];
    let prepared_copy:Result<core::io::Copier<ext::form::Encoding,std::stream::Descriptor>,core::io::Error> =
        core::io::copier<ext::form::Encoding,std::stream::Descriptor>(encoding.borrow(),output.borrow(),core::slice::view(scratch,1024).unwrap());
    if (prepared_copy.is_err()) { return 3; }
    let transfer:core::io::Copier<ext::form::Encoding,std::stream::Descriptor> = prepared_copy.unwrap();
    let calls:u64 = 0;
    while (true) {
        // Both encoder reads and descriptor writes spend this global budget.
        // A fresh read quota after ReadLimit permits the real final EOF read.
        let result:Result<core::io::CopyStep,core::io::CopyStepFailure> = transfer.step(4096,131072-calls);
        if (result.is_err()) { transfer.abort(); return 3; }
        let step:core::io::CopyStep = result.unwrap();
        calls += step.calls;
        let status:i32 = match (step.stop) {
            core::io::CopyStop::Eof -> 0,
            core::io::CopyStop::ReadLimit -> 1,
            core::io::CopyStop::CallLimit -> 2,
            _ -> 3
        };
        if (status != 1) { transfer.abort(); return status; }
    }
    return 3;
}

fn select(input:&alloc::vec::Vec<u8>, key:core::slice::View<u8>) -> i32 {
    // Complete admission and decoding precede matching, even if no key matches.
    let parsed:Result<ext::form_owned::Form,ext::form_owned::Error> =
        ext::form_owned::parse(input.as_view(),ext::form::Limits {
            max_input_bytes:1048576,max_pairs:65536,
            max_component_bytes:1048576,max_decoded_bytes:1048576
        });
    if (parsed.is_err()) { return form_failure(parsed.unwrap_err()); }
    let form:ext::form_owned::Form = parsed.unwrap();
    let selected:alloc::vec::Vec<ext::form::Pair> = alloc::vec::new();
    let cursor:ext::form_owned::Pairs = form.pairs();
    let status:i32 = 0;
    while (true) {
        let next:core::option::Option<ext::form::Pair> = cursor.next();
        if (next.is_none()) { break; }
        let pair:ext::form::Pair = next.unwrap();
        if (same(pair.name,key)) {
            let added:Result<i32,alloc::vec::Error> = selected.try_push(pair);
            if (added.is_err()) {
                status = match (added.unwrap_err()) { alloc::vec::Error::AllocationFailed -> 4, _ -> 2 };
                break;
            }
        }
    }
    if (status == 0) { status = publish(selected.borrow()); }
    // The descriptor vector borrows decoded Form bytes. End every encoding
    // and cursor use before releasing descriptors, then the packed owner.
    selected.destroy();
    form.destroy();
    return status;
}

fn main() -> i32 {
    // Failed setup remains quiet even if stderr is itself a closed pipe.
    if (std::signal::set_disposition(std::signal::Signal::BrokenPipe,std::signal::Disposition::Ignore).is_err()) { return 3; }
    let captured = std::args::snapshot(1,1,4096);
    if (captured.is_err()) {
        return match (captured.unwrap_err()) {
            std::args::Error::AllocationFailed -> 4,
            std::args::Error::HostRead(index) -> 3,
            _ -> 2
        };
    }
    let arguments = captured.unwrap();
    if (arguments.len() != 1) { arguments.destroy(); return 2; }
    let selected_key:core::option::Option<core::slice::View<u8>> = arguments.get(0);
    let key:core::slice::View<u8> = selected_key.unwrap();
    let source:std::stream::Descriptor = std::stream::stdin();
    let collected:Result<alloc::vec::Vec<u8>,alloc::io::ReadFailure> =
        alloc::io::read_to_end<std::stream::Descriptor>(source.borrow(),alloc::io::ReadLimits { max_bytes:1048576,max_calls:16384 });
    if (collected.is_err()) {
        let failure:alloc::io::ReadFailure = collected.unwrap_err();
        let status:i32 = read_failure(failure.cause);
        failure.destroy();
        arguments.destroy();
        return status;
    }
    let input:alloc::vec::Vec<u8> = collected.unwrap();
    let status:i32 = select(input.borrow(),key);
    input.destroy();
    arguments.destroy();
    return status;
}
