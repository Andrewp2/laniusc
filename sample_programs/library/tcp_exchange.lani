// Bounded binary TCP exchange. See docs/stdlib-tcp-exchange.md.
module app::main;
import alloc::vec;
import core::decimal;
import core::io;
import core::mem;
import core::net;
import core::option;
import core::result;
import core::slice;
import core::time;
import std::args;
import std::clock;
import std::signal;
import std::socket;
import std::stream;

fn bytes(value: str, count: i32) -> core::slice::View<u8> {
    let raw: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::string_data_ptr(value),count);
    return core::slice::view(raw,count).unwrap();
}
fn equal(value: core::slice::View<u8>, literal: str, count: i32) -> bool {
    if (value.len() != count) { return false; }
    let other: core::slice::View<u8> = bytes(literal,count); let index: i32 = 0;
    while (index < count) { if (value.get(index).unwrap() != other.get(index).unwrap()) { return false; } index += 1; }
    return true;
}
fn number(value: core::slice::View<u8>, maximum: u32) -> core::option::Option<i32> {
    let parsed: core::result::Result<u32,core::decimal::ParseError> = core::decimal::parse_u32_range(value.values,value.start,value.len());
    if (parsed.is_err()) { return core::option::None(); }
    let result: u32 = parsed.unwrap(); if (result > maximum) { return core::option::None(); }
    return core::option::Some(result as i32);
}
fn read_input(input: &alloc::vec::Vec<u8>, maximum: i32) -> i32 {
    let source: std::stream::Descriptor = std::stream::stdin();
    let storage: [i32;256] = [0;256];
    let scratch: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(storage),1024);
    while (true) {
        let result: core::result::Result<i32,core::io::Error> = source.read(scratch,0,1024);
        if (result.is_err()) { if (core::io::is_interrupted(result.unwrap_err())) { continue; } return 3; }
        let count: i32 = result.unwrap(); if (count == 0) { return 0; }
        if (count > maximum-input.len()) { return 2; }
        if (input.try_extend(core::slice::view(scratch,count).unwrap()).is_err()) { return 4; }
    }
    return 0;
}
fn active(deadline: core::time::Deadline) -> bool {
    let now: core::result::Result<core::time::Instant,std::clock::Error> = std::clock::monotonic_now();
    if (now.is_err()) { return false; }
    return !deadline.is_expired(now.unwrap());
}
fn exchange(socket: &std::socket::Socket, input: core::slice::View<u8>, response: &alloc::vec::Vec<u8>, maximum: i32, deadline: core::time::Deadline) -> i32 {
    let sent: i32 = 0;
    while (sent < input.len()) {
        if (!active(deadline)) { return 3; }
        let result: core::result::Result<i32,core::io::Error> = socket.send_until(input.subview(sent,input.len()).unwrap(),deadline);
        if (result.is_err()) { return 3; }
        let count: i32 = result.unwrap(); if (count <= 0 || count > input.len()-sent) { return 3; }
        sent += count;
    }
    if (!active(deadline) || socket.shutdown(std::socket::Shutdown::Write).is_err()) { return 3; }
    let storage: [i32;256] = [0;256];
    let scratch: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(storage),1024);
    let buffer: core::slice::View<u8> = core::slice::view(scratch,1024).unwrap();
    while (true) {
        if (!active(deadline)) { return 3; }
        let result: core::result::Result<i32,core::io::Error> = socket.receive_until(buffer,deadline);
        if (result.is_err()) { return 3; }
        if (!active(deadline)) { return 3; }
        let count: i32 = result.unwrap(); if (count == 0) { return 0; }
        if (count > maximum-response.len()) { return 2; }
        if (response.try_extend(buffer.subview(0,count).unwrap()).is_err()) { return 4; }
    }
    return 0;
}
fn process(arguments: std::args::Arguments) -> i32 {
    if (arguments.len() == 1 && equal(arguments.get(0).unwrap(),"--help",6)) {
        let usage: core::slice::View<u8> = bytes("Usage: tcp-exchange ADDRESS [TIMEOUT_MS [MAX_BYTES]]\n",53);
        let sink: std::stream::Descriptor = std::stream::stdout();
        if (core::io::write_all(sink.borrow(),usage.values,usage.start,usage.len()).is_err()) { return 3; } return 0;
    }
    if (arguments.len() < 1 || arguments.len() > 3) { return 2; }
    let address: core::result::Result<core::net::SocketAddr,core::net::Error> = core::net::parse_socket(arguments.get(0).unwrap());
    if (address.is_err()) { return 2; }
    let endpoint: core::net::SocketAddr = address.unwrap();
    let timeout: i32 = 5000; let maximum: i32 = 1048576;
    if (arguments.len() > 1) { let value: core::option::Option<i32> = number(arguments.get(1).unwrap(),60000); if (value.is_none()) { return 2; } timeout = value.unwrap(); }
    if (arguments.len() > 2) { let value: core::option::Option<i32> = number(arguments.get(2).unwrap(),16777216); if (value.is_none()) { return 2; } maximum = value.unwrap(); }
    let input: alloc::vec::Vec<u8> = alloc::vec::new();
    let status: i32 = read_input(input.borrow(),maximum);
    if (status != 0) { input.destroy(); return status; }
    let start: core::result::Result<core::time::Instant,std::clock::Error> = std::clock::monotonic_now();
    if (start.is_err()) { input.destroy(); return 3; }
    let shifted: core::result::Result<core::time::Instant,core::time::Error> = start.unwrap().checked_add(core::time::from_millis(timeout as u64));
    if (shifted.is_err()) { input.destroy(); return 3; }
    let deadline: core::time::Deadline = core::time::deadline_at(shifted.unwrap());
    let family: std::socket::Family = match (endpoint) { core::net::SocketAddr::V4(value) -> std::socket::Family::Ipv4, core::net::SocketAddr::V6(value) -> std::socket::Family::Ipv6 };
    let opened: core::result::Result<std::socket::Socket,core::io::Error> = std::socket::create(family,std::socket::Kind::Tcp,true);
    if (opened.is_err()) { input.destroy(); return 3; }
    let socket: std::socket::Socket = opened.unwrap();
    let response: alloc::vec::Vec<u8> = alloc::vec::new();
    if (socket.connect_until(endpoint,deadline).is_err()) { status = 3; }
    if (status == 0) { status = exchange(socket.borrow(),input.as_view(),response.borrow(),maximum,deadline); }
    let closed: core::result::Result<i32,core::io::Error> = socket.close();
    if (status == 0 && closed.is_err()) { status = 3; }
    input.destroy();
    if (status == 0) {
        let sink: std::stream::Descriptor = std::stream::stdout();
        let output: core::slice::View<u8> = response.as_view();
        if (core::io::write_all(sink.borrow(),output.values,output.start,output.len()).is_err()) { status = 3; }
    }
    response.destroy(); return status;
}
fn main() -> i32 {
    if (std::signal::set_disposition(std::signal::Signal::BrokenPipe,std::signal::Disposition::Ignore).is_err()) { return 3; }
    let snapshot: core::result::Result<std::args::Arguments,std::args::Error> = std::args::snapshot(1,3,256);
    if (snapshot.is_err()) { return match (snapshot.unwrap_err()) { std::args::Error::AllocationFailed -> 4, std::args::Error::HostRead(at) -> 3, _ -> 2 }; }
    let arguments: std::args::Arguments = snapshot.unwrap(); let status: i32 = process(arguments); arguments.destroy(); return status;
}
