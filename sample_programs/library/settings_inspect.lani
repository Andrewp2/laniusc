struct FileArg { toml: bool, path: core::slice::View<u8> }
struct Config { files: alloc::vec::Vec<FileArg>, path: alloc::vec::Vec<core::text::Text>, host: core::option::Option<ext::settings::Value>, port: core::option::Option<ext::settings::Value>, enabled: core::option::Option<ext::settings::Value>, max_input: i32, max_output: i32, max_nodes: i32, max_work: u64, help: bool }
struct Output { bytes: alloc::io::Buffer, status: i32 }
fn lit(value: str, count: i32) -> core::text::Text { return core::text::from_utf8_unchecked(core::mem::typed_slice_from_raw_parts<u8>(core::mem::string_data_ptr(value),count),0,count); }
fn view(value: core::text::Text) -> core::slice::View<u8> { return core::slice::View<u8> { values:value.bytes,start:value.start,length:value.length }; }
fn input(value: core::slice::View<u8>) -> core::result::Result<core::text::Text,i32> { let r = core::text::from_utf8_range(value.values,value.start,value.length); if (core::result::is_err(r)) { return core::result::Err(2); } return core::result::Ok(core::result::unwrap(r)); }
fn io_status(error: core::io::Error) -> i32 { return match(error) { core::io::Error::AllocationFailed -> 4, core::io::Error::LimitExceeded -> 6, _ -> 5 }; }
fn value_status(error: ext::settings::Error) -> i32 { return match(error) { ext::settings::Error::WorkLimit -> 6, ext::settings::Error::SourceLimit -> 6, ext::settings::Error::BindingLimit -> 6, ext::settings::Error::NodeLimit -> 6, ext::settings::Error::DepthLimit -> 6, ext::settings::Error::KeyLimit -> 6, ext::settings::Error::TextLimit -> 6, ext::settings::Error::PathLimit -> 6, _ -> 3 }; }
fn toml_status(error: ext::toml::Error) -> i32 { return match(error.kind) { ext::toml::ErrorKind::AllocationFailed -> 4, ext::toml::ErrorKind::InputLimit -> 6, ext::toml::ErrorKind::NodeLimit -> 6, ext::toml::ErrorKind::DepthLimit -> 6, ext::toml::ErrorKind::StringLimit -> 6, ext::toml::ErrorKind::NumberLimit -> 6, ext::toml::ErrorKind::WorkLimit -> 6, _ -> 3 }; }
fn config_status(error: ext::config::Error) -> i32 { if (ext::config::is_allocation_failure(error)) { return 4; } return match(error) { ext::config::Error::InputLimit -> 6, ext::config::Error::Io(v) -> 5, ext::config::Error::Json(v) -> json_status(v), _ -> 3 }; }
fn json_status(error: ext::json::Error) -> i32 { return match(error.kind) { ext::json::ErrorKind::NodeLimit -> 6, ext::json::ErrorKind::DepthLimit -> 6, ext::json::ErrorKind::StringLimit -> 6, ext::json::ErrorKind::NumberLimit -> 6, _ -> 3 }; }
pub impl Output {
    fn borrow(&self) -> &Output { return self; }
    fn text(&self, value: core::text::Text) { if (self.status != 0) { return; } let written = core::io::write_all(self.bytes.borrow(),value.bytes,value.start,value.length); if (core::result::is_err(written)) { self.status = io_status(core::result::unwrap_err(written).cause); } }
    fn byte(&self, value: u8) { let bytes: [u8;1] = [value]; if (self.status != 0) { return; } let written = core::io::write_all(self.bytes.borrow(),bytes,0,1); if (core::result::is_err(written)) { self.status = io_status(core::result::unwrap_err(written).cause); } }
    fn integer(&self, value: i64) { let bytes: [u8;32] = [0;32]; let count: i32 = core::result::unwrap(core::decimal::format_i64(bytes,0,32,value)); self.text(core::text::from_utf8_unchecked(bytes,0,count)); }
    fn unsigned(&self, value: u64) { let bytes: [u8;32] = [0;32]; let count: i32 = core::result::unwrap(core::decimal::format_u64(bytes,0,32,value)); self.text(core::text::from_utf8_unchecked(bytes,0,count)); }
    fn hex(&self, value: core::text::Text) { let i: i32 = 0; while (i < value.byte_len() && self.status == 0) { let v: u8 = core::option::unwrap(value.byte_at(i)); self.digit(v/16); self.digit(v%16); i += 1; } }
    fn digit(&self, value: u8) { let byte: u8 = 48+value; if (value > 9) { byte = 87+value; } self.byte(byte); }
}
pub impl Config { fn borrow(&self) -> &Config { return self; } }
fn configure(args: std::args::Arguments, config: &Config, work: &ext::settings::Budget) -> i32 {
    let specs: [ext::cli::Spec;11] = [
        ext::cli::Spec { id:0,long:view(lit("json",4)),short:0,arity:ext::cli::Arity::Required }, ext::cli::Spec { id:1,long:view(lit("toml",4)),short:0,arity:ext::cli::Arity::Required },
        ext::cli::Spec { id:2,long:view(lit("host",4)),short:0,arity:ext::cli::Arity::Required }, ext::cli::Spec { id:3,long:view(lit("port",4)),short:0,arity:ext::cli::Arity::Required }, ext::cli::Spec { id:4,long:view(lit("enabled",7)),short:0,arity:ext::cli::Arity::Required },
        ext::cli::Spec { id:5,long:view(lit("get",3)),short:0,arity:ext::cli::Arity::Required }, ext::cli::Spec { id:6,long:view(lit("member",6)),short:0,arity:ext::cli::Arity::Required },
        ext::cli::Spec { id:7,long:view(lit("max-input",9)),short:0,arity:ext::cli::Arity::Required }, ext::cli::Spec { id:8,long:view(lit("max-output",10)),short:0,arity:ext::cli::Arity::Required }, ext::cli::Spec { id:9,long:view(lit("max-nodes",9)),short:0,arity:ext::cli::Arity::Required }, ext::cli::Spec { id:10,long:view(lit("help",4)),short:104,arity:ext::cli::Arity::Flag }
    ];
    let parser: ext::cli::Parser = core::result::unwrap(ext::cli::parser(args.as_view(),core::result::unwrap(core::slice::view(specs,11)),ext::cli::Ordering::Intermixed));
    while (true) {
        let next = parser.next(); if (core::result::is_err(next)) { return 2; } let event: core::option::Option<ext::cli::Event> = core::result::unwrap(next); if (core::option::is_none(event)) { break; }
        let occurrence: core::option::Option<ext::cli::Occurrence> = match(core::option::unwrap(event)) { ext::cli::Event::Option(v) -> core::option::Some(v), _ -> core::option::None() }; if (core::option::is_none(occurrence)) { return 2; }
        let option: ext::cli::Occurrence = core::option::unwrap(occurrence); if (option.id == 10) { config.help = true; continue; }
        let raw: core::slice::View<u8> = core::option::unwrap(option.value).bytes;
        if (option.id <= 1) { if (config.files.len() >= 8) { return 6; } if (core::result::is_err(config.files.try_push(FileArg { toml:option.id == 1,path:raw }))) { return 4; } continue; }
        let decoded = input(raw); if (core::result::is_err(decoded)) { return 2; } let text: core::text::Text = core::result::unwrap(decoded);
        if (option.id == 2) { config.host = core::option::Some(ext::settings::scalar(ext::settings::Scalar::Text(text))); }
        if (option.id == 3 || option.id == 4) { let parsed: core::result::Result<ext::settings::Value,ext::settings::Error> = core::result::Err(ext::settings::Error::InvalidScalar); if (option.id == 3) { parsed = ext::settings::parse_integer(text,work); } else { parsed = ext::settings::parse_boolean(text,work); } if (core::result::is_err(parsed)) { return 2; } if (option.id == 3) { config.port = core::option::Some(core::result::unwrap(parsed)); } else { config.enabled = core::option::Some(core::result::unwrap(parsed)); } }
        if (option.id == 5 || option.id == 6) { if ((option.id == 5 && !config.path.is_empty()) || (option.id == 6 && config.path.is_empty())) { return 2; } if (config.path.len() >= 32) { return 6; } if (core::result::is_err(config.path.try_push(text))) { return 4; } }
        if (option.id >= 7 && option.id <= 9) { let parsed = text.parse_i32(); if (core::result::is_err(parsed)) { return 2; } let value: i32 = core::result::unwrap(parsed); if (value < 0 || value > 16777216) { return 2; } if (option.id == 7) { config.max_input = value; } if (option.id == 8) { config.max_output = value; } if (option.id == 9) { config.max_nodes = value; } }
    }
    return 0;
}
fn load_toml(path: core::path::Path, maximum: i32, nodes: i32) -> core::result::Result<ext::toml::Document,i32> {
    let opened = std::file::open(path,std::file::OpenMode::Read); if (core::result::is_err(opened)) { return core::result::Err(5); } let file: std::file::File = core::result::unwrap(opened);
    let bytes: alloc::io::Buffer = core::result::unwrap(alloc::io::with_limit(maximum)); let copied = std::stream::copy(file.borrow(),bytes.borrow()); let closed = file.close();
    if (core::result::is_err(copied)) { bytes.destroy(); return core::result::Err(io_status(core::result::unwrap_err(copied).cause)); } if (core::result::is_err(closed)) { bytes.destroy(); return core::result::Err(5); }
    let decoded = core::text::from_utf8(bytes.as_bytes(),bytes.len()); if (core::result::is_err(decoded)) { bytes.destroy(); return core::result::Err(3); }
    let options: ext::toml::Options = ext::toml::default_options(); options.max_input_bytes = maximum; options.max_nodes = nodes; options.max_depth = 64; options.max_string_bytes = maximum; options.max_number_bytes = 1024; options.max_work = 100000000;
    let parsed = ext::toml::parse_text(core::result::unwrap(decoded),options); bytes.destroy(); if (core::result::is_err(parsed)) { return core::result::Err(toml_status(core::result::unwrap_err(parsed))); } return core::result::Ok(core::result::unwrap(parsed));
}
fn load_files(config: &Config, sources: &alloc::vec::Vec<ext::settings::Source>) -> i32 {
    let i: i32 = 0; while (i < config.files.len()) {
        let arg: FileArg = config.files.at(i); let decoded = core::path::from_view(arg.path); if (core::result::is_err(decoded)) { return 2; } let path: core::path::Path = core::result::unwrap(decoded);
        let source: core::option::Option<ext::settings::Source> = core::option::None();
        if (arg.toml) { let loaded = load_toml(path,config.max_input,config.max_nodes); if (core::result::is_err(loaded)) { return core::result::unwrap_err(loaded); } source = core::option::Some(ext::settings::Source::Toml(core::result::unwrap(loaded))); }
        else { let options: ext::json::Options = ext::json::default_options(); options.max_nodes = config.max_nodes; options.max_depth = 64; options.max_string_bytes = config.max_input; options.max_number_bytes = 1024; let loaded = ext::config::load(path,config.max_input,options); if (core::result::is_err(loaded)) { return config_status(core::result::unwrap_err(loaded)); } source = core::option::Some(ext::settings::Source::Json(core::result::unwrap(loaded))); }
        let owner: ext::settings::Source = core::option::unwrap(source); if (core::result::is_err(sources.try_push(owner))) { destroy_source(owner); return 4; } i += 1;
    }
    return 0;
}
fn destroy_source(source: ext::settings::Source) { let kind: i32 = match(source) { ext::settings::Source::Json(v) -> 1, ext::settings::Source::Toml(v) -> 2, _ -> 0 }; if (kind == 1) { destroy_json(source); } if (kind == 2) { destroy_toml(source); } }
fn destroy_json(source: ext::settings::Source) { let owner: core::option::Option<ext::config::Config> = match(source) { ext::settings::Source::Json(v) -> core::option::Some(v), _ -> core::option::None() }; if (core::option::is_some(owner)) { core::option::unwrap(owner).destroy(); } }
fn destroy_toml(source: ext::settings::Source) { let owner: core::option::Option<ext::toml::Document> = match(source) { ext::settings::Source::Toml(v) -> core::option::Some(v), _ -> core::option::None() }; if (core::option::is_some(owner)) { core::option::unwrap(owner).destroy(); } }
fn destroy_sources(sources: &alloc::vec::Vec<ext::settings::Source>) { while (!sources.is_empty()) { destroy_source(core::option::unwrap(sources.pop())); } sources.destroy(); }
fn binding(key: core::text::Text, value: ext::settings::Value) -> ext::settings::Binding { return ext::settings::Binding { key:key,value:value }; }
fn report_value(value: ext::settings::Value, output: &Output, work: &ext::settings::Budget) {
    if (output.status != 0) { return; } if (core::result::is_err(work.charge(1))) { output.status = 6; return; }
    output.text(ext::settings::kind_text(value.kind())); output.byte(32);
    let k: i32 = match(value.kind()) { ext::settings::Kind::Null -> 0, ext::settings::Kind::Boolean -> 1, ext::settings::Kind::Text -> 2, ext::settings::Kind::Array -> 3, ext::settings::Kind::Table -> 4, ext::settings::Kind::ExactDecimal -> 5, ext::settings::Kind::Integer -> 6, ext::settings::Kind::UnsignedInteger -> 7, ext::settings::Kind::Float64 -> 8, _ -> 9 };
    if (k == 1) { if (core::result::unwrap(value.boolean())) { output.byte(49); } else { output.byte(48); } }
    if (k == 2) { output.hex(core::result::unwrap(value.text())); } if (k == 5) { output.hex(core::result::unwrap(value.decimal_text())); }
    if (k == 6) { let r = value.integer_i64(work); if (core::result::is_err(r)) { output.status = value_status(core::result::unwrap_err(r)); return; } output.integer(core::result::unwrap(r)); }
    if (k == 7) { let r = value.integer_u64(work); if (core::result::is_err(r)) { output.status = value_status(core::result::unwrap_err(r)); return; } output.unsigned(core::result::unwrap(r)); }
    if (k == 8) { output.unsigned(core::f64::to_bits(core::result::unwrap(value.float64()))); }
    if (k == 9) { output.hex(core::result::unwrap(value.temporal_text())); }
    if (k == 3 || k == 4) { output.integer(core::result::unwrap(value.len()) as i64); output.byte(10); let children: ext::settings::Children = core::result::unwrap(value.children()); while (output.status == 0) { let next = children.next(work); if (core::result::is_err(next)) { output.status = value_status(core::result::unwrap_err(next)); break; } let child: core::option::Option<ext::settings::Value> = core::result::unwrap(next); if (core::option::is_none(child)) { break; } let item: ext::settings::Value = core::option::unwrap(child); if (k == 4) { output.text(lit("key ",4)); output.hex(core::result::unwrap(item.key())); output.byte(10); } report_value(item,output,work); } return; }
    output.byte(10);
}
fn report(layers: ext::settings::Layers, config: &Config, output: &Output, work: &ext::settings::Budget) {
    if (!config.path.is_empty()) { let found = layers.lookup(config.path.as_view(),work); if (core::result::is_err(found)) { output.status = value_status(core::result::unwrap_err(found)); return; } let item: core::option::Option<ext::settings::Resolved> = core::result::unwrap(found); if (core::option::is_none(item)) { output.text(lit("missing\n",8)); return; } let resolved: ext::settings::Resolved = core::option::unwrap(item); output.text(lit("source ",7)); output.integer(resolved.source_index as i64); output.byte(10); report_value(resolved.value,output,work); return; }
    let keys: [core::text::Text;3] = [lit("host",4),lit("port",4),lit("enabled",7)]; let i: i32 = 0;
    while (i < 3 && output.status == 0) { let key: core::text::Text = keys[i]; let found = layers.get(key,work); if (core::result::is_err(found)) { output.status = value_status(core::result::unwrap_err(found)); return; } let resolved: ext::settings::Resolved = core::option::unwrap(core::result::unwrap(found)); output.text(key); output.byte(32);
        if (i == 0) { let v = resolved.value.text(); if (core::result::is_err(v)) { output.status = 3; return; } let text: core::text::Text = core::result::unwrap(v); if (text.is_empty() || text.byte_len() > 256) { output.status = 3; return; } output.hex(text); }
        if (i == 1) { let v = resolved.value.integer_i64(work); if (core::result::is_err(v)) { output.status = value_status(core::result::unwrap_err(v)); return; } let number: i64 = core::result::unwrap(v); if (number < 1 || number > 65535) { output.status = 3; return; } output.integer(number); }
        if (i == 2) { let v = resolved.value.boolean(); if (core::result::is_err(v)) { output.status = 3; return; } if (core::result::unwrap(v)) { output.byte(49); } else { output.byte(48); } }
        output.text(lit(" source ",8)); output.integer(resolved.source_index as i64); output.byte(10); i += 1;
    }
}
fn execute(config: &Config, work: &ext::settings::Budget) -> i32 {
    let defaults: [ext::settings::Binding;3] = [binding(lit("host",4),ext::settings::scalar(ext::settings::Scalar::Text(lit("localhost",9)))),binding(lit("port",4),ext::settings::scalar(ext::settings::Scalar::Integer(8080))),binding(lit("enabled",7),ext::settings::scalar(ext::settings::Scalar::Boolean(true)))];
    let sources: alloc::vec::Vec<ext::settings::Source> = alloc::vec::new(); if (core::result::is_err(sources.try_push(ext::settings::Source::Bindings(core::result::unwrap(core::slice::view(defaults,3)))))) { sources.destroy(); return 4; }
    let status: i32 = load_files(config,sources.borrow()); if (status != 0) { destroy_sources(sources.borrow()); return status; }
    let specs: [ext::settings_env::Spec;3] = [ext::settings_env::Spec { environment:lit("SETTINGS_HOST",13),setting:lit("host",4),parse:ext::settings_env::Parse::Text },ext::settings_env::Spec { environment:lit("SETTINGS_PORT",13),setting:lit("port",4),parse:ext::settings_env::Parse::Integer },ext::settings_env::Spec { environment:lit("SETTINGS_ENABLED",16),setting:lit("enabled",7),parse:ext::settings_env::Parse::Boolean }];
    let snapshot = ext::settings_env::snapshot(core::result::unwrap(core::slice::view(specs,3)),3,4096,12288,work);
    if (core::result::is_err(snapshot)) { destroy_sources(sources.borrow()); return match(core::result::unwrap_err(snapshot)) { ext::settings_env::Error::AllocationFailed -> 4, ext::settings_env::Error::ValueLimit(at) -> 6, ext::settings_env::Error::Value(at,cause) -> value_status(cause), ext::settings_env::Error::HostRead(at) -> 5, ext::settings_env::Error::Unavailable -> 5, _ -> 3 }; }
    let environment: ext::settings_env::Snapshot = core::result::unwrap(snapshot); if (core::result::is_err(sources.try_push(environment.as_source()))) { environment.destroy(); destroy_sources(sources.borrow()); return 4; }
    let bindings: alloc::vec::Vec<ext::settings::Binding> = alloc::vec::new(); let names: [core::text::Text;3] = [lit("host",4),lit("port",4),lit("enabled",7)]; let values: [core::option::Option<ext::settings::Value>;3] = [config.host,config.port,config.enabled]; let i: i32 = 0;
    while (i < 3) { if (core::option::is_some(values[i]) && core::result::is_err(bindings.try_push(binding(names[i],core::option::unwrap(values[i]))))) { bindings.destroy(); environment.destroy(); destroy_sources(sources.borrow()); return 4; } i += 1; }
    if (core::result::is_err(sources.try_push(ext::settings::Source::Bindings(bindings.as_view())))) { bindings.destroy(); environment.destroy(); destroy_sources(sources.borrow()); return 4; }
    let limits: ext::settings::Limits = ext::settings::default_limits(); limits.max_nodes = config.max_nodes; limits.max_depth = 64; limits.max_key_bytes = 8192; limits.max_text_bytes = config.max_input; if (limits.max_text_bytes < 8192) { limits.max_text_bytes = 8192; } limits.max_path = 32;
    let checked = ext::settings::layers(sources.as_view(),limits,work); let status: i32 = 0;
    if (core::result::is_err(checked)) { status = value_status(core::result::unwrap_err(checked)); }
    else { let output: Output = Output { bytes:core::result::unwrap(alloc::io::with_limit(config.max_output)),status:0 }; report(core::result::unwrap(checked),config,output.borrow(),work); status = output.status; if (status == 0) { let stdout: std::stream::Descriptor = std::stream::stdout(); let written = core::io::write_all(stdout.borrow(),output.bytes.as_bytes(),0,output.bytes.len()); if (core::result::is_err(written)) { status = 5; } } output.bytes.destroy(); }
    bindings.destroy(); environment.destroy(); destroy_sources(sources.borrow()); return status;
}
fn process(args: std::args::Arguments) -> i32 {
    let config: Config = Config { files:alloc::vec::new(),path:alloc::vec::new(),host:core::option::None(),port:core::option::None(),enabled:core::option::None(),max_input:1048576,max_output:4194304,max_nodes:100000,max_work:100000000,help:false };
    let work: ext::settings::Budget = ext::settings::budget(config.max_work); let status: i32 = configure(args,config.borrow(),work.borrow());
    if (status == 0) { if (config.help) { let out: std::stream::Descriptor = std::stream::stdout(); let help: core::text::Text = lit("settings_inspect [--json FILE|--toml FILE]... [--host TEXT --port INTEGER --enabled true|false] [--get KEY [--member KEY]...] [--max-input N --max-output N --max-nodes N]\n",171); if (core::result::is_err(core::io::write_all(out.borrow(),help.bytes,help.start,help.length))) { status = 5; } } else { status = execute(config.borrow(),work.borrow()); } }
    config.files.destroy(); config.path.destroy(); return status;
}
fn main() -> i32 {
    if (core::result::is_err(std::signal::set_disposition(std::signal::Signal::BrokenPipe,std::signal::Disposition::Ignore))) { return 5; }
    let snapshot = std::args::snapshot(1,64,8192); let status: i32 = 0;
    if (core::result::is_err(snapshot)) { status = match(core::result::unwrap_err(snapshot)) { std::args::Error::AllocationFailed -> 4, std::args::Error::HostRead(at) -> 5, _ -> 2 }; }
    else { let args: std::args::Arguments = core::result::unwrap(snapshot); status = process(args); args.destroy(); }
    if (status != 0) { let stderr: std::stream::Descriptor = std::stream::stderr(); let message: core::text::Text = lit("settings_inspect: error\n",24); if (core::result::is_err(core::io::write_all(stderr.borrow(),message.bytes,message.start,message.length))) { return 5; } } return status;
}
