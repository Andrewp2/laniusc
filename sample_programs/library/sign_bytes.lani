// Bounded pure Ed25519 detached signatures over complete binary stdin.
// Execution evidence and target limits: docs/extended-sign-bytes.md.
module app::main;
import alloc::io;
import core::io;
import core::mem;
import core::path;
import core::result;
import core::slice;
import ext::ed25519;
import std::args;
import std::file;
import std::file_ops;
import std::signal;
import std::stream;

const MAX_MESSAGE: i32 = 1048576;
struct Budget { remaining: i32 }
impl Budget {
    fn borrow(&self) -> &Budget { return self; }
    fn charge(&self) -> bool { if (self.remaining == 0) { return false; } self.remaining -= 1; return true; }
}
fn io_status(error: core::io::Error) -> i32 {
    return match (error) { core::io::Error::AllocationFailed -> 4, core::io::Error::LimitExceeded -> 7, _ -> 3 };
}
fn same(value: core::slice::View<u8>, literal: str, count: i32) -> bool {
    if (value.length != count) { return false; }
    let expected: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::string_data_ptr(literal),count);
    let index: i32 = 0;
    while (index < count) { if (value.values[value.start+index] != expected[index]) { return false; } index += 1; }
    return true;
}
fn fixed_contents(file: &std::file::File, bytes: [u8], required: i32, budget: &Budget) -> i32 {
    let completed: i32 = 0;
    while (completed < required) {
        if (!budget.charge()) { return 7; }
        let read: core::result::Result<i32,core::io::Error> = file.read(bytes,completed,required-completed);
        if (read.is_err()) { if (core::io::is_interrupted(read.unwrap_err())) { continue; } return 3; }
        let count: i32 = read.unwrap();
        if (count < 0 || count > required-completed) { return 3; }
        if (count == 0) { return 2; }
        completed += count;
    }
    let storage: [i32;1] = [0];
    let probe: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(storage),1);
    while (true) {
        if (!budget.charge()) { return 7; }
        let read: core::result::Result<i32,core::io::Error> = file.read(probe,0,1);
        if (read.is_err()) { if (core::io::is_interrupted(read.unwrap_err())) { continue; } return 3; }
        let count: i32 = read.unwrap();
        if (count == 0) { return 0; }
        if (count == 1) { return 2; }
        return 3;
    }
    return 3;
}
fn read_fixed(path: core::path::Path, bytes: [u8], required: i32, budget: &Budget) -> i32 {
    let options: std::file_ops::OpenOptions = std::file_ops::options();
    options.access = std::file_ops::Access::Read;
    options.no_follow = true; options.nonblocking = true; options.close_on_exec = true;
    let opened: core::result::Result<std::file::File,core::io::Error> = std::file_ops::open(path,options);
    if (opened.is_err()) { return 3; }
    let file: std::file::File = opened.unwrap();
    let status: i32 = fixed_contents(file.borrow(),bytes,required,budget);
    // Invalidate and attempt close exactly once, before any stdin read. Its
    // failure overrides fixed-file format/limit errors and is never retried.
    let closed: core::result::Result<i32,core::io::Error> = file.close();
    if (closed.is_err()) { return 3; }
    return status;
}
fn read_input(input: &alloc::io::Buffer, maximum: i32, budget: &Budget) -> i32 {
    let source: std::stream::Descriptor = std::stream::stdin();
    let storage: [i32;256] = [0;256];
    let bytes: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(storage),1024);
    let total: i32 = 0;
    while (true) {
        let request: i32 = maximum-total;
        if (request > 1024) { request = 1024; }
        if (request == 0) { request = 1; }
        if (!budget.charge()) { return 7; }
        let read: core::result::Result<i32,core::io::Error> = source.read(bytes,0,request);
        if (read.is_err()) { if (core::io::is_interrupted(read.unwrap_err())) { continue; } return 3; }
        let count: i32 = read.unwrap();
        if (count < 0 || count > request) { return 3; }
        if (count == 0) { return 0; }
        if (count > maximum-total) { return 7; }
        let appended: core::result::Result<i32,core::io::Error> = input.write(bytes,0,count);
        if (appended.is_err()) { return io_status(appended.unwrap_err()); }
        if (appended.unwrap() != count) { return 3; }
        total += count;
    }
    return 3;
}
fn publish(bytes: core::slice::View<u8>, budget: &Budget) -> i32 {
    let sink: std::stream::Descriptor = std::stream::stdout();
    let completed: i32 = 0;
    while (completed < bytes.length) {
        if (!budget.charge()) { return 7; }
        let written: core::result::Result<i32,core::io::Error> = sink.write(bytes.values,bytes.start+completed,bytes.length-completed);
        if (written.is_err()) { if (core::io::is_interrupted(written.unwrap_err())) { continue; } return 3; }
        let count: i32 = written.unwrap();
        if (count <= 0 || count > bytes.length-completed) { return 3; }
        completed += count;
    }
    return 0;
}

fn transform(input: &alloc::io::Buffer, signing: bool, key: core::slice::View<u8>, signature: core::slice::View<u8>, budget: &Budget) -> i32 {
    let message: core::slice::View<u8> = core::slice::View { values: input.as_bytes(), start: 0, length: input.len() };
    if (signing) {
        let signed: core::result::Result<ext::ed25519::Signature64,ext::ed25519::Error> = ext::ed25519::sign(key,message);
        if (signed.is_err()) { return 7; }
        let result: ext::ed25519::Signature64 = signed.unwrap();
        let bytes: core::slice::View<u8> = core::slice::view(result.bytes,64).unwrap();
        return publish(bytes,budget);
    }
    let verified: core::result::Result<bool,ext::ed25519::Error> = ext::ed25519::verify(key,message,signature);
    if (verified.is_err()) { return 7; }
    if (verified.unwrap()) { return 0; }
    return 5;
}
fn process(arguments: std::args::Arguments) -> i32 {
    if (arguments.len() < 2 || arguments.len() > 3) { return 2; }
    let command: core::slice::View<u8> = arguments.get(0).unwrap();
    let signing: bool = same(command,"sign",4);
    if (!signing && !same(command,"verify",6)) { return 2; }
    if ((signing && arguments.len() != 2) || (!signing && arguments.len() != 3)) { return 2; }
    let key_text: core::slice::View<u8> = arguments.get(1).unwrap();
    if (key_text.length <= 0 || key_text.length > 4095) { return 2; }
    let parsed_key: core::result::Result<core::path::Path,core::path::Error> = core::path::from_view(key_text);
    if (parsed_key.is_err()) { return 2; }
    let key_path: core::path::Path = parsed_key.unwrap();
    let signature_path: core::path::Path = key_path;
    if (!signing) {
        let signature_text: core::slice::View<u8> = arguments.get(2).unwrap();
        if (signature_text.length <= 0 || signature_text.length > 4095) { return 2; }
        let parsed_signature: core::result::Result<core::path::Path,core::path::Error> = core::path::from_view(signature_text);
        if (parsed_signature.is_err()) { return 2; }
        signature_path = parsed_signature.unwrap();
    }
    let key_storage: [i32;8] = [0;8];
    let key_bytes: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(key_storage),32);
    let signature_storage: [i32;16] = [0;16];
    let signature_bytes: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(signature_storage),64);
    let budget: Budget = Budget { remaining: 131072 };
    let key_status: i32 = read_fixed(key_path,key_bytes,32,budget.borrow());
    if (key_status != 0) { return key_status; }
    if (!signing) {
        let signature_status: i32 = read_fixed(signature_path,signature_bytes,64,budget.borrow());
        if (signature_status != 0) { return signature_status; }
    }
    let key: core::slice::View<u8> = core::slice::view(key_bytes,32).unwrap();
    let signature: core::slice::View<u8> = core::slice::view(signature_bytes,64).unwrap();
    let made: core::result::Result<alloc::io::Buffer,core::io::Error> = alloc::io::with_limit(MAX_MESSAGE);
    if (made.is_err()) { return io_status(made.unwrap_err()); }
    let input: alloc::io::Buffer = made.unwrap();
    let reserved: core::result::Result<i32,core::io::Error> = input.try_reserve(MAX_MESSAGE);
    if (reserved.is_err()) { let status: i32 = io_status(reserved.unwrap_err()); input.destroy(); return status; }
    let status: i32 = read_input(input.borrow(),MAX_MESSAGE,budget.borrow());
    if (status == 0) { status = transform(input.borrow(),signing,key,signature,budget.borrow()); }
    input.destroy();
    return status;
}
fn main() -> i32 {
    if (std::signal::set_disposition(std::signal::Signal::BrokenPipe,std::signal::Disposition::Ignore).is_err()) { return 3; }
    // Excludes argv[0]: verify plus two raw paths, at most 6+4095+4095 bytes.
    let captured: core::result::Result<std::args::Arguments,std::args::Error> = std::args::snapshot(1,3,8196);
    if (captured.is_err()) { return match (captured.unwrap_err()) { std::args::Error::AllocationFailed -> 4, std::args::Error::HostRead(index) -> 3, _ -> 2 }; }
    let arguments: std::args::Arguments = captured.unwrap();
    let status: i32 = process(arguments);
    arguments.destroy();
    return status;
}
