// Unified diff tool over ext::seqdiff and ext::unidiff. The default (--xdiff) and
// --histogram output follows git diff --no-index from the first hunk header,
// function names in hunk headers included; -W/--function-context is git's -W.
// --myers (minimal) and --patience print bare GNU-style hunk headers. --word-diff,
// --char-diff (git's --word-diff-regex=.) and --stat also follow git.
// usage: seq-diff [-U N] [-W|--function-context] [--xdiff|--histogram|--myers|--patience] [--word-diff|--char-diff|--stat[=W[,N[,C]]]] OLD NEW
// Options are parsed by std::cli (GNU getopt_long rules: -U3, --unified=3,
// unique prefixes such as --hist); see --help.
// Exit 0 identical, 1 different, 2 usage/limits/I/O failure.
module app::main;
import alloc::io;
import alloc::vec;
import core::decimal;
import core::io;
import core::mem;
import core::option;
import core::path;
import core::result;
import core::slice;
import ext::diffstat;
import ext::seqdiff;
import ext::unidiff;
import ext::wordiff;
import std::args;
import std::cli;
import std::file;
import std::fs;
import std::file_ops;
import std::stream;

fn literal(value: str, count: i32) -> core::slice::View<u8> {
    let bytes: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::string_data_ptr(value), count);
    return core::result::unwrap(core::slice::view(bytes, count));
}
fn same(left: core::slice::View<u8>, right: core::slice::View<u8>) -> bool {
    if (left.len() != right.len()) { return false; }
    let i: i32 = 0; while (i < left.len()) { if (left.values[left.start+i] != right.values[right.start+i]) { return false; } i += 1; } return true;
}
fn complain(text: str, count: i32) -> i32 {
    let sink: std::stream::Descriptor = std::stream::stderr(); let v: core::slice::View<u8> = literal(text, count);
    let written: core::result::Result<i32, core::io::Failure> = core::io::write_all(sink.borrow(), v.values, v.start, v.len()); return 2;
}
// Write packed bytes (a Vec<u8>) to stdout straight from their storage:
// std::stream's Descriptor stages every 1,024 bytes through a copy loop.
fn write_out(bytes: [u8], count: i32) -> bool {
    let base: ptr = core::mem::i32_slice_data_ptr(bytes); let sent: i32 = 0;
    while (sent < count) {
        let w: i32 = std::fs::write(1, base + (sent as usize), (count - sent) as usize);
        if (w == -4) { continue; }
        if (w <= 0 || w > count - sent) { return false; }
        sent += w;
    }
    return true;
}
fn read_file(name: core::slice::View<u8>, output: &alloc::io::Buffer) -> bool {
    let checked: core::result::Result<core::path::Path, core::path::Error> = core::path::from_view(name);
    if (core::result::is_err(checked)) { return false; }
    let opened: core::result::Result<std::file::File, core::io::Error> = std::file::open(core::result::unwrap(checked), std::file::OpenMode::Read);
    if (core::result::is_err(opened)) { return false; }
    let file: std::file::File = core::result::unwrap(opened);
    // Size the buffer from the file length so the read does not regrow it
    // (growth copies byte by byte). read_to_end asks for 64 KiB of room per
    // read and still reads to end of input, whatever the size was.
    let size: core::result::Result<i64, core::io::Error> = std::file_ops::seek(file.borrow(), 0, std::file_ops::Origin::End);
    let rewound: core::result::Result<i64, core::io::Error> = std::file_ops::seek(file.borrow(), 0, std::file_ops::Origin::Start);
    if (core::result::is_err(rewound)) { let ignored: core::result::Result<i32, core::io::Error> = file.close(); return false; }
    if (core::result::is_ok(size) && core::result::unwrap(size) < 268000000) { let room: core::result::Result<ptr, core::io::Error> = output.reserve_raw((core::result::unwrap(size) as i32) + 65536); }
    let copied: core::result::Result<u64, core::io::Error> = file.read_to_end(output);
    let closed: core::result::Result<i32, core::io::Error> = file.close();
    return core::result::is_ok(copied) && core::result::is_ok(closed);
}
fn view_of(buffer: &alloc::io::Buffer) -> core::slice::View<u8> { return core::result::unwrap(core::slice::view(buffer.as_bytes(), buffer.len())); }
fn report(e: ext::seqdiff::Error) -> i32 {
    return match (e) {
        ext::seqdiff::Error::WorkLimit -> complain("seq-diff: work limit\n", 21),
        ext::seqdiff::Error::ItemLimit -> complain("seq-diff: line limit\n", 21),
        ext::seqdiff::Error::AllocationFailed -> complain("seq-diff: allocation failed\n", 28),
        ext::seqdiff::Error::Bounds -> complain("seq-diff: internal bounds\n", 26),
        ext::seqdiff::Error::InvalidLimits -> complain("seq-diff: invalid limits\n", 25)
    };
}
fn run(old_name: core::slice::View<u8>, new_name: core::slice::View<u8>, context: i32, algorithm: ext::seqdiff::Algorithm, mode: i32, stat: ext::diffstat::StatOptions, function: bool) -> i32 {
    let first: alloc::io::Buffer = core::result::unwrap(alloc::io::with_limit(268435456));
    let second: alloc::io::Buffer = core::result::unwrap(alloc::io::with_limit(268435456));
    if (!read_file(old_name, first.borrow()) || !read_file(new_name, second.borrow())) { first.destroy(); second.destroy(); return complain("seq-diff: cannot read input\n", 28); }
    let limits: ext::seqdiff::Limits = ext::seqdiff::default_limits();
    let split: core::result::Result<ext::seqdiff::Split, ext::seqdiff::Error> = ext::seqdiff::split_classify(view_of(first.borrow()), view_of(second.borrow()), limits);
    if (core::result::is_err(split)) { first.destroy(); second.destroy(); return report(core::result::unwrap_err(split)); }
    let lines: ext::seqdiff::Split = core::result::unwrap(split);
    let status: i32 = 0;
    // The default/--xdiff and --histogram follow git diff, indent heuristic included.
    let git: bool = match (algorithm) { ext::seqdiff::Algorithm::Xdiff -> true, ext::seqdiff::Algorithm::Histogram -> true, _ -> false };
    let made: core::result::Result<ext::seqdiff::Script, ext::seqdiff::Error> = core::result::Err(ext::seqdiff::Error::Bounds);
    if (git) { made = ext::seqdiff::diff_split_indent(lines.borrow(), algorithm, limits); } else { made = ext::seqdiff::diff_split(lines.borrow(), algorithm, limits); }
    if (core::result::is_err(made)) {
        status = report(core::result::unwrap_err(made));
    }
    else {
        let script: ext::seqdiff::Script = core::result::unwrap(made);
        let grouped: alloc::vec::Vec<ext::seqdiff::Hunk> = alloc::vec::new();
        if (function) { grouped = core::result::unwrap(ext::seqdiff::function_hunks(lines.borrow(), script.borrow(), context)); }
        else { grouped = core::result::unwrap(ext::seqdiff::hunks(script.borrow(), context)); }
        let written: core::result::Result<alloc::vec::Vec<u8>, i32> = render(lines.borrow(), script.borrow(), grouped.as_view(), old_name, new_name, mode, stat, git || function);
        if (core::result::is_err(written)) { status = complain("seq-diff: cannot encode\n", 24); }
        else {
            let bytes: alloc::vec::Vec<u8> = core::result::unwrap(written);
            if (bytes.len() > 0) {
                status = 1; let sink: std::stream::Descriptor = std::stream::stdout();
                if (!write_out(bytes.as_slice(), bytes.len())) { status = 2; }
            }
            bytes.destroy();
        }
        grouped.destroy(); script.destroy();
    }
    lines.destroy(); first.destroy(); second.destroy(); return status;
}
// mode 0 unified, 1 word diff, 2 character diff, 3 diffstat.
fn render(lines: &ext::seqdiff::Split, script: &ext::seqdiff::Script, grouped: core::slice::View<ext::seqdiff::Hunk>, old_name: core::slice::View<u8>, new_name: core::slice::View<u8>, mode: i32, stat: ext::diffstat::StatOptions, names: bool) -> core::result::Result<alloc::vec::Vec<u8>, i32> {
    if (mode == 0) {
        let u: core::result::Result<alloc::vec::Vec<u8>, ext::unidiff::WriteError> = core::result::Err(ext::unidiff::WriteError::InvalidLine);
        if (names) { u = ext::unidiff::write_unified_split_funcnames(lines, script, grouped, old_name, new_name, 268435456); }
        else { u = ext::unidiff::write_unified_split(lines, script, grouped, old_name, new_name, 268435456); }
        if (core::result::is_err(u)) { return core::result::Err(1); } return core::result::Ok(core::result::unwrap(u));
    }
    if (mode == 3) {
        let out: alloc::vec::Vec<u8> = alloc::vec::new(); if (grouped.len() == 0) { return core::result::Ok(out); }
        let stats: ext::diffstat::Stats = ext::diffstat::new_stats(); let c: ext::diffstat::Counts = ext::diffstat::count_script(script);
        let added: core::result::Result<i32, ext::diffstat::Error> = ext::diffstat::add_pair(stats.borrow(), old_name, new_name, c.added, c.deleted);
        if (core::result::is_err(added)) { stats.destroy(); return core::result::Err(1); }
        let w: core::result::Result<alloc::vec::Vec<u8>, ext::diffstat::Error> = ext::diffstat::write_stat(stats.borrow(), stat);
        stats.destroy(); if (core::result::is_err(w)) { return core::result::Err(1); } return core::result::Ok(core::result::unwrap(w));
    }
    let options: ext::wordiff::Options = ext::wordiff::default_options(ext::wordiff::Mode::Words);
    if (mode == 2) { options = ext::wordiff::default_options(ext::wordiff::Mode::Chars); }
    let r: core::result::Result<alloc::vec::Vec<u8>, ext::wordiff::Error> = ext::wordiff::write_word_diff_split(lines, script, grouped, old_name, new_name, options);
    if (core::result::is_err(r)) { return core::result::Err(1); } return core::result::Ok(core::result::unwrap(r));
}
// "--stat=W[,N[,C]]" values after the '='.
fn stat_values(v: core::slice::View<u8>, from: i32, stat: &ext::diffstat::StatOptions) -> bool {
    let field: i32 = 0; let i: i32 = from;
    while (i <= v.len()) {
        let j: i32 = i; while (j < v.len() && v.values[v.start+j] != 44) { j += 1; }
        let parsed: core::result::Result<u64, core::decimal::ParseError> = core::decimal::parse_u64_range(v.values, v.start + i, j - i);
        if (core::result::is_err(parsed) || core::result::unwrap(parsed) > 100000 as u64 || field > 2) { return false; }
        let n: i32 = core::result::unwrap(parsed) as i32;
        if (field == 0) { stat.width = n; } if (field == 1) { stat.name_width = n; } if (field == 2) { stat.count = n; }
        field += 1; i = j + 1;
    }
    return true;
}
fn main() -> i32 {
    let captured: core::result::Result<std::args::Arguments, std::args::Error> = std::args::snapshot(1, 32, 16384);
    if (core::result::is_err(captured)) { return complain("seq-diff: bad arguments\n", 24); }
    let arguments: std::args::Arguments = core::result::unwrap(captured);
    let cli: std::cli::Command = std::cli::command(literal("seq-diff", 8), literal("Compare OLD and NEW line by line in unified diff format.", 56));
    cli.option(1, 85, literal("unified", 7), literal("NUM", 3), literal("output NUM (default 3) lines of context", 39));
    cli.flag(2, 87, literal("function-context", 16), literal("show whole functions as context (git -W)", 40));
    cli.flag(3, 0, literal("xdiff", 5), literal("git's default algorithm (default)", 33));
    cli.flag(4, 0, literal("histogram", 9), literal("git's histogram algorithm", 25));
    cli.flag(5, 0, literal("myers", 5), literal("minimal Myers diff, GNU hunk headers", 36));
    cli.flag(6, 0, literal("patience", 8), literal("patience diff, GNU hunk headers", 31));
    cli.optional(7, 0, literal("word-diff", 9), literal("plain", 5), literal("show changed words (only the plain mode)", 40));
    cli.option(8, 0, literal("word-diff-regex", 15), literal("REGEX", 5), literal("only '.': show changed characters", 33));
    cli.flag(9, 0, literal("char-diff", 9), literal("show changed characters", 23));
    cli.optional(10, 0, literal("stat", 4), literal("W[,N[,C]]", 9), literal("show a diffstat: width, name width, count", 41));
    cli.help(11);
    cli.operands(literal("OLD NEW", 7), 2, 2);
    let parsed: core::result::Result<std::cli::Matches, std::cli::Error> = cli.parse(arguments.as_view());
    if (core::result::is_err(parsed)) { cli.print_error(core::result::unwrap_err(parsed), arguments.as_view()); cli.destroy(); arguments.destroy(); return 2; }
    let matches: std::cli::Matches = core::result::unwrap(parsed);
    let context: i32 = 3; let algorithm: ext::seqdiff::Algorithm = ext::seqdiff::Algorithm::Xdiff; let mode: i32 = 0; let function: bool = false; let stat: ext::diffstat::StatOptions = ext::diffstat::default_stat_options();
    let ok: bool = true; let help: bool = false; let i: i32 = 0;
    // Options apply in argument order, so a later algorithm or mode wins.
    while (i < matches.occurrences() && ok) {
        let id: i32 = matches.occurrence_id(i);
        let value: core::option::Option<core::slice::View<u8>> = matches.occurrence_value(i);
        if (id == 1) {
            let v: core::slice::View<u8> = core::option::unwrap(value);
            let number: core::result::Result<u64, core::decimal::ParseError> = core::decimal::parse_u64_range(v.values, v.start, v.len());
            if (core::result::is_err(number) || core::result::unwrap(number) > 1000000 as u64) { ok = false; } else { context = core::result::unwrap(number) as i32; }
        }
        if (id == 2) { function = true; }
        if (id == 3) { algorithm = ext::seqdiff::Algorithm::Xdiff; }
        if (id == 4) { algorithm = ext::seqdiff::Algorithm::Histogram; }
        if (id == 5) { algorithm = ext::seqdiff::Algorithm::Myers; }
        if (id == 6) { algorithm = ext::seqdiff::Algorithm::Patience; }
        if (id == 7) { mode = 1; if (value.is_some() && !same(value.unwrap(), literal("plain", 5))) { ok = false; } }
        if (id == 8) { mode = 2; if (!same(core::option::unwrap(value), literal(".", 1))) { ok = false; } }
        if (id == 9) { mode = 2; }
        if (id == 10) {
            mode = 3;
            if (value.is_some()) { ok = stat_values(value.unwrap(), 0, stat.borrow()); }
        }
        if (id == 11) { help = true; }
        i += 1;
    }
    let status: i32 = 2;
    if (help) { status = 0; if (!cli.print_help(-1)) { status = 2; } }
    else {
        if (!ok) { status = complain("seq-diff: invalid option value\nTry 'seq-diff --help' for more information.\n", 75); }
        else { status = run(matches.operand(0), matches.operand(1), context, algorithm, mode, stat, function); }
    }
    matches.destroy(); cli.destroy(); arguments.destroy(); return status;
}
