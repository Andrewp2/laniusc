// Compute RGBA pixels, sample them into a window, and poll asynchronous work.
// Escape/close exits; --frames N bounds the run. No CPU image generation.
module app::main;
import core::result;
import core::option;
import core::slice;
import core::text;
import core::mem;
import core::decimal;
import core::io;
import std::process;
import std::stream;
import ext::window;
import ext::gpu;
import shaders::work_shaders;
struct Scene { surface:core::option::Option<ext::gpu::Surface>, texture:core::option::Option<ext::gpu::Texture>, params:core::option::Option<ext::gpu::Buffer>, values:core::option::Option<ext::gpu::Buffer>, compute_layout:core::option::Option<ext::gpu::BindingLayout>, compute_group:core::option::Option<ext::gpu::BindGroup>, compute:core::option::Option<ext::gpu::ComputePipeline>, sample_layout:core::option::Option<ext::gpu::BindingLayout>, sample_group:core::option::Option<ext::gpu::BindGroup>, graphics:core::option::Option<ext::gpu::Pipeline>, work:core::option::Option<ext::gpu::Submission>, frame:core::option::Option<ext::gpu::Submission> }
fn empty_scene() -> Scene { return Scene { surface:core::option::None(),texture:core::option::None(),params:core::option::None(),values:core::option::None(),compute_layout:core::option::None(),compute_group:core::option::None(),compute:core::option::None(),sample_layout:core::option::None(),sample_group:core::option::None(),graphics:core::option::None(),work:core::option::None(),frame:core::option::None() }; }
impl Scene { fn borrow(&self) -> &Scene { return self; } }
fn setup(s:&Scene,d:&ext::gpu::Device,window:&ext::window::Window) -> core::result::Result<i32,ext::gpu::Failure> {
    s.surface=core::option::Some(d.create_surface(window)?);
    s.texture=core::option::Some(d.create_texture(64,64)?);
    s.params=core::option::Some(d.create_buffer(16)?);
    s.values=core::option::Some(d.create_buffer(16384)?);
    let texture=s.texture.unwrap(); let params=s.params.unwrap(); let values=s.values.unwrap();
    let bytes:[u8;16]=[64,0,0,0,64,0,0,0,23,0,0,0,0,0,0,0]; params.write(0,core::slice::whole(bytes))?;
    let kinds:[ext::gpu::BindingKind;3]=[ext::gpu::BindingKind::UniformBuffer,ext::gpu::BindingKind::StorageBuffer,ext::gpu::BindingKind::StorageTexture];
    s.compute_layout=core::option::Some(d.create_binding_layout(core::slice::whole(kinds))?); let layout=s.compute_layout.unwrap();
    let bindings:[ext::gpu::Binding;3]=[ext::gpu::Binding::UniformBuffer(params.borrow()),ext::gpu::Binding::StorageBuffer(values.borrow()),ext::gpu::Binding::StorageTexture(texture.borrow())];
    s.compute_group=core::option::Some(d.create_bind_group(layout.borrow(),core::slice::whole(bindings))?);
    let shader=shaders::work_shaders::comp(); s.compute=core::option::Some(d.create_compute_pipeline(core::slice::whole(shader),layout.borrow())?);
    let sampling:[ext::gpu::BindingKind;1]=[ext::gpu::BindingKind::SampledTexture];
    s.sample_layout=core::option::Some(d.create_binding_layout(core::slice::whole(sampling))?); let sample_layout=s.sample_layout.unwrap();
    let sampled:[ext::gpu::Binding;1]=[ext::gpu::Binding::SampledTexture(texture.borrow())];
    s.sample_group=core::option::Some(d.create_bind_group(sample_layout.borrow(),core::slice::whole(sampled))?);
    let vertex=shaders::work_shaders::vert(); let fragment=shaders::work_shaders::frag(); let surface=s.surface.unwrap();
    s.graphics=core::option::Some(d.create_bound_pipeline(core::slice::whole(vertex),core::slice::whole(fragment),surface.format()?,sample_layout.borrow())?);
    let encoder=d.create_encoder()?; let compute=s.compute.unwrap(); let group=s.compute_group.unwrap();
    let recorded=record(encoder.borrow(),texture.borrow(),compute.borrow(),group.borrow());
    if(recorded.is_err()) { encoder.close(); return core::result::Err(recorded.unwrap_err()); }
    let submitted=encoder.submit(); if(submitted.is_err()) { encoder.close(); return core::result::Err(submitted.unwrap_err()); }
    s.work=core::option::Some(submitted.unwrap()); return core::result::Ok(0);
}
fn record(e:&ext::gpu::CommandEncoder,t:&ext::gpu::Texture,p:&ext::gpu::ComputePipeline,g:&ext::gpu::BindGroup) -> core::result::Result<i32,ext::gpu::Failure> {
    e.clear_texture(t)?; e.dispatch(p,g,8,8,1)?; return core::result::Ok(0);
}
fn stop(value:ext::window::Event,id:u64) -> bool {
    return match(value) {
        ext::window::Event::Close(window) -> window==id,
        ext::window::Event::Key(key) -> key.window==id && key.down && match(key.key) { ext::window::Key::Escape -> true, _ -> false },
        _ -> false
    };
}
fn animate(s:&Scene,context:&ext::window::Context,window:&ext::window::Window,limit:i32) -> i32 {
    let frames:i32=0; let surface=s.surface.unwrap(); let pipeline=s.graphics.unwrap(); let group=s.sample_group.unwrap();
    while(true) {
        let events:i32=0;
        while(events<256) {
            let next=context.poll(); if(next.is_err()) { return 3; }
            if(next.unwrap().is_none()) { break; }
            if(stop(next.unwrap().unwrap(),window.id())) { return 0; } events+=1;
        }
        if(s.frame.is_none()) {
            let next=surface.submit_bound(pipeline.borrow(),group.borrow(),3); if(next.is_err()) { return 3; }
            s.frame=match(next.unwrap()) { ext::gpu::FrameSubmission::Submitted(ticket) -> core::option::Some(ticket), _ -> core::option::None() };
        }
        if(s.frame.is_some()) {
            let ticket=s.frame.unwrap(); let done=ticket.poll(); if(done.is_err()) { return 3; }
            if(done.unwrap()) {
                let outcome=ticket.frame(); if(outcome.is_err()) { return 3; }
                // Transfer destruction authority out of the optional owner.
                s.frame=core::option::None();
                let retired=ticket.close(); if(retired.is_err()) { s.frame=core::option::Some(ticket); return 3; }
                if(match(outcome.unwrap()) { ext::gpu::Frame::Presented(size) -> true, _ -> false }) { frames+=1; }
                if(limit>0 && frames>=limit) { return 0; }
            }
        }
        if(s.work.is_some()) {
            let work=s.work.unwrap(); let done=work.poll(); if(done.is_err()) { return 3; }
            if(done.unwrap()) { s.work=core::option::None(); if(work.close().is_err()) { s.work=core::option::Some(work); return 3; } }
        }
        let event=context.wait(8); if(event.is_err()) { return 3; }
        if(event.unwrap().is_some() && stop(event.unwrap().unwrap(),window.id())) { return 0; }
    }
    return 0;
}
fn cleanup(s:&Scene) -> bool {
    if(s.frame.is_some()) { let owner=s.frame.unwrap();
        let waited=owner.wait(10000000000); if(waited.is_ok() && !waited.unwrap()) { return false; }
        s.frame=core::option::None(); if(owner.close().is_err()) { s.frame=core::option::Some(owner); return false; }
    }
    if(s.work.is_some()) { let owner=s.work.unwrap();
        let waited=owner.wait(10000000000); if(waited.is_ok() && !waited.unwrap()) { return false; }
        s.work=core::option::None(); if(owner.close().is_err()) { s.work=core::option::Some(owner); return false; }
    }
    if(s.graphics.is_some()) { let owner=s.graphics.unwrap();
        s.graphics=core::option::None(); if(owner.close().is_err()) { s.graphics=core::option::Some(owner); return false; }
    }
    if(s.sample_group.is_some()) { let owner=s.sample_group.unwrap();
        s.sample_group=core::option::None(); if(owner.close().is_err()) { s.sample_group=core::option::Some(owner); return false; }
    }
    if(s.sample_layout.is_some()) { let owner=s.sample_layout.unwrap();
        s.sample_layout=core::option::None(); if(owner.close().is_err()) { s.sample_layout=core::option::Some(owner); return false; }
    }
    if(s.compute.is_some()) { let owner=s.compute.unwrap();
        s.compute=core::option::None(); if(owner.close().is_err()) { s.compute=core::option::Some(owner); return false; }
    }
    if(s.compute_group.is_some()) { let owner=s.compute_group.unwrap();
        s.compute_group=core::option::None(); if(owner.close().is_err()) { s.compute_group=core::option::Some(owner); return false; }
    }
    if(s.compute_layout.is_some()) { let owner=s.compute_layout.unwrap();
        s.compute_layout=core::option::None(); if(owner.close().is_err()) { s.compute_layout=core::option::Some(owner); return false; }
    }
    if(s.texture.is_some()) { let owner=s.texture.unwrap();
        s.texture=core::option::None(); if(owner.close().is_err()) { s.texture=core::option::Some(owner); return false; }
    }
    if(s.values.is_some()) { let owner=s.values.unwrap();
        s.values=core::option::None(); if(owner.close().is_err()) { s.values=core::option::Some(owner); return false; }
    }
    if(s.params.is_some()) { let owner=s.params.unwrap();
        s.params=core::option::None(); if(owner.close().is_err()) { s.params=core::option::Some(owner); return false; }
    }
    if(s.surface.is_some()) { let owner=s.surface.unwrap();
        s.surface=core::option::None(); if(owner.close().is_err()) { s.surface=core::option::Some(owner); return false; }
    }
    return true;
}
fn run(context:&ext::window::Context,window:&ext::window::Window,device:&ext::gpu::Device,limit:i32) -> i32 {
    let scene=empty_scene(); let initialized=setup(scene.borrow(),device,window); let status:i32=3;
    if(initialized.is_ok()) { status=animate(scene.borrow(),context,window,limit); }
    if(!cleanup(scene.borrow())) { status=3; } return status;
}
fn arguments() -> i32 {
    if(std::process::argc()==1) { return 0; }
    if(std::process::argc()!=3 || std::process::arg_len(1)!=8) { return -1; }
    let words:[i32;2]=[0;2]; let pointer=core::mem::i32_array_data_ptr(words); let bytes=core::mem::typed_slice_from_raw_parts<u8>(pointer,8);
    if(std::process::arg_read(1,pointer,8)!=8) { return -1; } let expected=core::text::from_str("--frames"); let i:i32=0;
    while(i<8) { if(bytes[i]!=expected.bytes[expected.start+i]) { return -1; } i+=1; }
    let length=std::process::arg_len(2); if(length<1 || length>3) { return -1; }
    if(std::process::arg_read(2,pointer,8)!=length) { return -1; }
    let parsed=core::decimal::parse_u32(bytes,length); if(parsed.is_err()) { return -1; }
    let count=parsed.unwrap(); if(count<1 || count>600) { return -1; } return count as i32;
}
fn message(value:str) { let text=core::text::from_str(value); let sink=std::stream::stderr(); core::io::write_all(sink.borrow(),text.bytes,text.start,text.length); }
fn main() -> i32 {
    let limit=arguments(); if(limit<0) { message("Usage: gpu-compute [--frames N], N = 1..600\n"); return 2; }
    let opened=ext::window::init(); if(opened.is_err()) { message("Could not open an X11 window context.\n"); return 3; } let context=opened.unwrap();
    let created=context.create(core::text::from_str("Computed texture"),640,480,true);
    if(created.is_err()) { context.close(); message("Could not create the window.\n"); return 3; } let window=created.unwrap();
    let gpu=ext::gpu::open(0);
    if(gpu.is_err()) { window.close(); context.close(); message("Vulkan 1.1 with swapchain maintenance is required.\n"); return 3; } let device=gpu.unwrap();
    let status=run(context.borrow(),window.borrow(),device.borrow(),limit);
    if(device.close().is_err()) { status=3; }
    if(window.close().is_err()) { status=3; }
    if(context.close().is_err()) { status=3; }
    if(status!=0) { message("GPU rendering stopped after a native failure.\n"); } return status;
}
