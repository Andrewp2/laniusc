// GNU cut under LC_ALL=C over ext::text_cut.
// usage: text-cut (-b LIST | -c LIST | -f LIST) [-d DELIM] [-s] [-n] [-z]
//        [--complement] [--output-delimiter=STRING] [FILE...]
// Options and files may be mixed (GNU getopt order; "--" ends options) and
// long options may be abbreviated. Without FILE (or with -) it reads
// standard input. Exit 0, or 1 on a usage error or an unreadable input.
module app::main;
import alloc::io;
import alloc::vec;
import core::io;
import core::mem;
import core::option;
import core::result;
import core::slice;
import ext::text_cut;
import ext::text_lines;
import std::args;
import std::stream;

fn literal(value: str, count: i32) -> core::slice::View<u8> {
    let bytes: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::string_data_ptr(value), count);
    return core::result::unwrap(core::slice::view(bytes, count));
}
fn say(v: core::slice::View<u8>) {
    let sink: std::stream::Descriptor = std::stream::stderr();
    let written: core::result::Result<i32, core::io::Failure> = core::io::write_all(sink.borrow(), v.values, v.start, v.len());
}
fn complain(text: core::slice::View<u8>) -> i32 { say(literal("text-cut: ", 10)); say(text); say(literal("\n", 1)); return 1; }

// Long options: index into NAMES, or -1 (unknown) or -2 (ambiguous). An
// exact name wins; otherwise the prefix must fit exactly one name.
fn long_index(name: core::slice::View<u8>) -> i32 {
    let names: core::slice::View<u8> = literal("bytes,characters,delimiter,fields,only-delimited,output-delimiter,complement,zero-terminated,help,version,", 106);
    let index: i32 = 0; let start: i32 = 0; let i: i32 = 0; let found: i32 = -1; let matches: i32 = 0;
    while (i < names.length) {
        if (names.values[i] == 44) {
            let len: i32 = i - start;
            if (name.length <= len) {
                let j: i32 = 0; let ok: bool = true;
                while (j < name.length && ok) { if (name.values[name.start+j] != names.values[start+j]) { ok = false; } j += 1; }
                if (ok) { if (name.length == len) { return index; } found = index; matches += 1; }
            }
            index += 1; start = i + 1;
        }
        i += 1;
    }
    if (matches > 1) { return -2; }
    return found;
}
// Whether option `index` (long) or letter (short) takes an argument.
fn long_takes(index: i32) -> bool { return index == 0 || index == 1 || index == 2 || index == 3 || index == 5; }
// A one-byte view (the default output delimiter, or NUL for an empty one).
fn one_byte(b: u8, keep: &alloc::io::Buffer) -> core::slice::View<u8> {
    let p: ptr = core::result::unwrap(keep.reserve_raw(8));
    let bytes: [u8] = core::mem::typed_slice_from_raw_parts<u8>(p, 1); bytes[0] = b;
    return core::slice::View { values: bytes, start: 0, length: 1 };
}

fn main() -> i32 {
    let captured: core::result::Result<std::args::Arguments, std::args::Error> = std::args::snapshot(1, 4096, 1048576);
    if (core::result::is_err(captured)) { return complain(literal("bad arguments", 13)); }
    let arguments: std::args::Arguments = core::result::unwrap(captured);
    let names: alloc::vec::Vec<core::slice::View<u8>> = alloc::vec::new();
    let empty: core::slice::View<u8> = literal("", 0);
    let mode: i32 = 0; let list: core::slice::View<u8> = empty; let delim: u8 = 9; let delim_given: bool = false;
    let out: core::slice::View<u8> = empty; let out_given: bool = false; let suppress: bool = false; let complement: bool = false; let eol: u8 = 10;
    let keep: alloc::io::Buffer = core::result::unwrap(alloc::io::with_limit(64));
    let plain: bool = false; let i: i32 = 0; let error: i32 = 0;
    // error: 1 usage, 2 two lists, 3 delimiter not one byte.
    while (i < arguments.len() && error == 0) {
        let arg: core::slice::View<u8> = core::option::unwrap(arguments.get(i)); i += 1;
        if (plain || arg.len() < 2 || arg.values[arg.start] != 45) { let pushed: core::result::Result<i32, alloc::vec::Error> = names.try_push(arg); continue; }
        // The option (as a short letter, or 'L' + long index) and its argument.
        let letters: i32 = 0; let opt: i32 = 0; let value: core::slice::View<u8> = empty;
        if (arg.values[arg.start+1] == 45) {
            if (arg.len() == 2) { plain = true; continue; }
            let eq: i32 = 2; while (eq < arg.len() && arg.values[arg.start+eq] != 61) { eq += 1; }
            let index: i32 = long_index(core::slice::View { values: arg.values, start: arg.start + 2, length: eq - 2 });
            if (index < 0) { error = 1; break; }
            if (eq < arg.len()) {
                if (!long_takes(index)) { error = 1; break; }
                value = core::slice::View { values: arg.values, start: arg.start + eq + 1, length: arg.len() - eq - 1 };
            } else {
                if (long_takes(index)) { if (i >= arguments.len()) { error = 1; break; } value = core::option::unwrap(arguments.get(i)); i += 1; }
            }
            opt = match (index) { 0 -> 98, 1 -> 99, 2 -> 100, 3 -> 102, 4 -> 115, 5 -> 79, 6 -> 67, 7 -> 122, _ -> 63 };
            letters = 1;
        }
        let j: i32 = 1;
        while (error == 0) {
            if (letters == 0) {
                if (j >= arg.len()) { break; }
                opt = arg.values[arg.start+j] as i32; j += 1;
                if (opt == 98 || opt == 99 || opt == 100 || opt == 102) {
                    if (j < arg.len()) { value = core::slice::View { values: arg.values, start: arg.start + j, length: arg.len() - j }; j = arg.len(); }
                    else { if (i >= arguments.len()) { error = 1; break; } value = core::option::unwrap(arguments.get(i)); i += 1; }
                }
            }
            if (opt == 98 || opt == 99 || opt == 102) {
                if (mode != 0) { error = 2; break; }
                mode = 1; if (opt == 102) { mode = 2; } list = value;
            } else { if (opt == 100) {
                if (value.len() > 1) { error = 3; break; }
                delim = 0; if (value.len() == 1) { delim = value.values[value.start]; } delim_given = true;
            } else { if (opt == 79) { out = value; out_given = true; if (value.len() == 0) { out = one_byte(0, keep.borrow()); } }
            else { if (opt == 115) { suppress = true; }
            else { if (opt == 67) { complement = true; }
            else { if (opt == 122) { eol = 0; }
            else { if (opt != 110) { error = 1; break; } } } } } } }
            if (letters != 0) { break; }
        }
    }
    let status: i32 = 0;
    if (error == 0 && mode == 0) { status = complain(literal("you must specify a list of bytes, characters, or fields", 55)); }
    if (error == 1) { status = complain(literal("invalid usage", 13)); }
    if (error == 2) { status = complain(literal("only one type of list may be specified", 38)); }
    if (error == 3) { status = complain(literal("the delimiter must be a single character", 40)); }
    if (status == 0 && delim_given && mode != 2) { status = complain(literal("an input delimiter may be specified only when operating on fields", 65)); }
    if (status == 0 && suppress && mode != 2) { status = complain(literal("suppressing non-delimited lines makes sense\n\tonly when operating on fields", 74)); }
    if (status != 0) { keep.destroy(); names.destroy(); arguments.destroy(); return status; }
    let parsed: core::result::Result<ext::text_cut::Ranges, ext::text_cut::Error> = ext::text_cut::parse_list(list, complement);
    if (core::result::is_err(parsed)) {
        status = complain(ext::text_cut::message(core::result::unwrap_err(parsed), mode == 1));
        keep.destroy(); names.destroy(); arguments.destroy(); return status;
    }
    if (!out_given) { out = one_byte(delim, keep.borrow()); }
    let s: ext::text_cut::Spec = ext::text_cut::spec(core::result::unwrap(parsed), mode == 2, delim, out, out_given, suppress, eol);
    if (names.len() == 0) { let pushed: core::result::Result<i32, alloc::vec::Error> = names.try_push(literal("-", 1)); }
    let o: ext::text_lines::Out = core::result::unwrap(ext::text_lines::out(1, 32768));
    let whole: bool = ext::text_cut::needs_whole(s.borrow());
    i = 0;
    while (i < names.len()) {
        let name: core::slice::View<u8> = core::option::unwrap(names.get(i)); i += 1;
        let fd: i32 = ext::text_lines::open_input(name);
        if (fd < 0) { say(literal("text-cut: ", 10)); say(name); say(literal(": No such file or directory\n", 28)); status = 1; continue; }
        let made: core::result::Result<ext::text_lines::Lines, ext::text_lines::Error> = ext::text_lines::lines(fd, 262144);
        if (core::result::is_err(made)) { status = complain(literal("allocation failed", 17)); ext::text_lines::close_input(fd); break; }
        let r: ext::text_lines::Lines = core::result::unwrap(made);
        while (true) {
            let v: core::slice::View<u8> = ext::text_lines::next_lines(r.borrow(), eol, whole);
            if (v.length > 0) { let done: core::result::Result<i32, ext::text_cut::Error> = ext::text_cut::cut(s.borrow(), v, o.borrow()); }
            if (r.finished()) { break; }
        }
        if (r.failed) { say(literal("text-cut: ", 10)); say(name); say(literal(": read error\n", 13)); status = 1; }
        r.destroy(); ext::text_lines::close_input(fd);
    }
    if (!ext::text_lines::finish(o.borrow())) { status = 1; }
    o.destroy(); s.destroy(); keep.destroy(); names.destroy(); arguments.destroy();
    return status;
}
