// Offline DNS QUERY message construction and inspection. No network I/O.
module app::main;
import alloc::vec;
import core::fmt;
import core::io;
import core::mem;
import core::option;
import core::result;
import core::slice;
import core::text;
import ext::cli;
import ext::dns;
import std::args;
import std::stream;

struct Config { mode: i32, name: core::option::Option<core::slice::View<u8>>, wire: bool, id: i32, qtype: i32, qclass: i32, udp: i32, dnssec: bool, limits: ext::dns::Limits, max_output: i32, query_options: bool, help: bool }
impl Config { fn borrow(&self) -> &Config { return self; } }
struct Output { bytes: alloc::vec::Vec<u8>, maximum: i32, failure: i32 }
impl Output { fn borrow(&self) -> &Output { return self; } }
fn literal(value: str, count: i32) -> core::slice::View<u8> { let raw: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::string_data_ptr(value),count); return core::result::unwrap(core::slice::view(raw,count)); }
fn text(value: str, count: i32) -> core::text::Text { let raw: core::slice::View<u8> = literal(value,count); return core::text::from_utf8_unchecked(raw.values,raw.start,raw.len()); }
fn eq(v: core::slice::View<u8>, s: str, n: i32) -> bool { let other: core::slice::View<u8> = literal(s,n); if (v.len() != n) { return false; } let i: i32 = 0; while (i < n) { if (core::option::unwrap(v.get(i)) != core::option::unwrap(other.get(i))) { return false; } i += 1; } return true; }
fn write(v: core::slice::View<u8>, descriptor: i32) -> bool { let sink: std::stream::Descriptor = std::stream::from_handle(descriptor); return core::result::is_ok(core::io::write_all(sink.borrow(),v.values,v.start,v.len())); }
fn add(out: &Output, v: core::slice::View<u8>) -> bool { if (out.failure != 0) { return false; } if (v.len() > out.maximum-out.bytes.len()) { out.failure = 3; return false; } if (core::result::is_err(out.bytes.try_extend(v))) { out.failure = 4; return false; } return true; }
fn word(out: &Output, s: str, n: i32) -> bool { return add(out,literal(s,n)); }
fn number(out: &Output, n: u64) -> bool { let scratch: [u8;32] = [0;32]; let f: core::fmt::Formatter = core::result::unwrap(core::fmt::buffer(scratch,0,32)); f.write_unsigned(n,core::fmt::decimal()); let count: i32 = core::result::unwrap(f.finish()); return add(out,core::result::unwrap(core::slice::view(scratch,count))); }
fn hex_digit(n: u8) -> u8 { if (n < 10) { return n+48; } return n+87; }
fn hex(out: &Output, v: core::slice::View<u8>) -> bool { let i: i32 = 0; while (i < v.len()) { let c: u8 = core::option::unwrap(v.get(i)); let pair: [u8;2] = [hex_digit(c/16),hex_digit(c%16)]; if (!add(out,core::result::unwrap(core::slice::view(pair,2)))) { return false; } i += 1; } return true; }
fn name(out: &Output, n: ext::dns::Name) -> bool { let scratch: [u8;255] = [0;255]; let raw: core::slice::View<u8> = core::result::unwrap(core::slice::view(scratch,255)); let count: i32 = core::result::unwrap(ext::dns::expand_into(n,raw)); return hex(out,core::result::unwrap(raw.subview(0,count))); }
fn domain(out: &Output, value: ext::dns::Name) -> bool { return word(out," domain=",8) && name(out,value); }
fn mx(out: &Output, value: ext::dns::Mx) -> bool { return word(out," preference=",12) && number(out,value.preference as u64) && word(out," exchange=",10) && name(out,value.exchange); }
fn soa(out: &Output, v: ext::dns::Soa) -> bool { return word(out," primary=",9) && name(out,v.primary) && word(out," mailbox=",9) && name(out,v.mailbox) && word(out," serial=",8) && number(out,v.serial as u64) && word(out," refresh=",9) && number(out,v.refresh as u64) && word(out," retry=",7) && number(out,v.retry as u64) && word(out," expire=",8) && number(out,v.expire as u64) && word(out," minimum=",9) && number(out,v.minimum as u64); }
fn strings(out: &Output, values: ext::dns::Strings) -> bool { while (true) { let next = values.next(); if (core::option::is_none(next)) { break; } if (!word(out," txt=",5) || !hex(out,core::option::unwrap(next))) { return false; } } return true; }
fn edns(out: &Output, v: ext::dns::Edns) -> bool { if (!word(out," udp=",5) || !number(out,v.udp_size as u64) || !word(out," version=",9) || !number(out,v.version as u64) || !word(out," ext_rcode=",11) || !number(out,v.extended_rcode as u64) || !word(out," edns_flags=",12) || !number(out,v.flags as u64)) { return false; } let options: ext::dns::Options = v.option_iter(); while (true) { let next = options.next(); if (core::option::is_none(next)) { break; } let item: ext::dns::EdnsOption = core::option::unwrap(next); if (!word(out," option=",8) || !number(out,item.code as u64) || !word(out,":",1) || !hex(out,item.data)) { return false; } } return true; }
fn details(out: &Output, r: ext::dns::Record) -> bool { return match (ext::dns::data(r)) { ext::dns::Data::A(v) -> word(out," A=",3) && hex(out,v), ext::dns::Data::Aaaa(v) -> word(out," AAAA=",6) && hex(out,v), ext::dns::Data::Domain(v) -> domain(out,v), ext::dns::Data::Mail(v) -> mx(out,v), ext::dns::Data::Authority(v) -> soa(out,v), ext::dns::Data::Text(v) -> strings(out,v), ext::dns::Data::Opt(v) -> edns(out,v), ext::dns::Data::Unknown(v) -> true }; }
fn inspect(out: &Output, message: ext::dns::Message) -> bool {
    let h: ext::dns::Header = message.header;
    if (!word(out,"id=",3) || !number(out,h.id as u64) || !word(out," flags=",7) || !number(out,h.flags as u64) || !word(out," qd=",4) || !number(out,h.questions as u64) || !word(out," an=",4) || !number(out,h.answers as u64) || !word(out," ns=",4) || !number(out,h.authorities as u64) || !word(out," ar=",4) || !number(out,h.additionals as u64) || !word(out," rcode=",7) || !number(out,message.rcode() as u64) || !word(out,"\n",1)) { return false; }
    let questions: ext::dns::Questions = message.questions(); while (true) { let next = questions.next(); if (core::option::is_none(next)) { break; } let q: ext::dns::Question = core::option::unwrap(next); if (!word(out,"Q name=",7) || !name(out,q.name) || !word(out," type=",6) || !number(out,q.qtype as u64) || !word(out," class=",7) || !number(out,q.qclass as u64) || !word(out,"\n",1)) { return false; } }
    let section: i32 = 1; while (section <= 3) { let records: ext::dns::Records = message.records(section); while (true) { let next = records.next(); if (core::option::is_none(next)) { break; } let r: ext::dns::Record = core::option::unwrap(next); if (!word(out,"R section=",10) || !number(out,section as u64) || !word(out," name=",6) || !name(out,r.name) || !word(out," type=",6) || !number(out,r.rrtype as u64) || !word(out," class=",7) || !number(out,r.rrclass as u64) || !word(out," ttl=",5) || !number(out,r.ttl as u64) || !word(out," data=",6) || !hex(out,r.data) || !details(out,r) || !word(out,"\n",1)) { return false; } } section += 1; } return true;
}
fn diagnostic(error: ext::dns::Error) -> i32 {
    let status: i32 = match (error) { ext::dns::Error::AllocationFailed -> 4, ext::dns::Error::Limit(at) -> 3, ext::dns::Error::NameLimit(at) -> 3, ext::dns::Error::WorkLimit(at) -> 3, ext::dns::Error::OutputLimit(at) -> 3, _ -> 2 };
    let reason: core::text::Text = text("malformed",9); reason = match (error) { ext::dns::Error::Bounds -> text("bounds",6), ext::dns::Error::Truncated(at) -> text("truncated",9), ext::dns::Error::Unsupported(at) -> text("unsupported",11), ext::dns::Error::Pointer(at) -> text("pointer",7), ext::dns::Error::NameLimit(at) -> text("name-limit",10), ext::dns::Error::Limit(at) -> text("limit",5), ext::dns::Error::WorkLimit(at) -> text("work-limit",10), ext::dns::Error::OutputLimit(at) -> text("output-limit",12), ext::dns::Error::AllocationFailed -> text("allocation-failure",18), ext::dns::Error::Capacity -> text("capacity",8), _ -> text("malformed",9) };
    let at: i32 = match (error) { ext::dns::Error::Truncated(at) -> at, ext::dns::Error::Malformed(at) -> at, ext::dns::Error::Unsupported(at) -> at, ext::dns::Error::Pointer(at) -> at, ext::dns::Error::NameLimit(at) -> at, ext::dns::Error::Limit(at) -> at, ext::dns::Error::WorkLimit(at) -> at, ext::dns::Error::OutputLimit(at) -> at, _ -> -1 };
    let scratch: [u8;128] = [0;128]; let f: core::fmt::Formatter = core::result::unwrap(core::fmt::buffer(scratch,0,128)); f.write_text(text("dns-message: ",13)); f.write_text(reason); f.write_text(text(" byte=",6)); f.write_signed(at as i64,core::fmt::decimal()); f.write_text(text("\n",1)); let count: i32 = core::result::unwrap(f.finish()); if (!write(core::result::unwrap(core::slice::view(scratch,count)),2)) { return 5; } return status;
}
fn numeric(v: core::slice::View<u8>, maximum: i32) -> core::option::Option<i32> { if (v.is_empty()) { return core::option::None(); } let i: i32 = 0; while (i < v.len()) { let c: u8 = core::option::unwrap(v.get(i)); if (c < 48 || c > 57) { return core::option::None(); } i += 1; } let t: core::text::Text = core::text::from_utf8_unchecked(v.values,v.start,v.len()); let parsed = t.parse_i32(); if (core::result::is_err(parsed)) { return core::option::None(); } let n: i32 = core::result::unwrap(parsed); if (n > maximum) { return core::option::None(); } return core::option::Some(n); }
fn option(c: &Config, item: ext::cli::Occurrence) -> bool {
    if (item.id <= 6) { c.query_options = true; }
    if (item.id == 11) { c.help = true; return true; } if (item.id == 5) { c.dnssec = true; return true; } if (item.id == 6) { c.wire = true; return true; }
    let maximum: i32 = 65535; if (item.id == 8) { maximum = 1048576; } if (item.id == 9) { maximum = 16777216; } if (item.id == 10) { maximum = 262140; }
    let parsed = numeric(core::option::unwrap(item.value).bytes,maximum); if (core::option::is_none(parsed)) { return false; } let n: i32 = core::option::unwrap(parsed);
    if (item.id == 1) { c.id = n; } if (item.id == 2) { c.qtype = n; } if (item.id == 3) { c.qclass = n; } if (item.id == 4) { c.udp = n; } if (item.id == 7) { c.limits.message_bytes = n; } if (item.id == 8) { c.max_output = n; c.limits.output_bytes = n; if (n > 65535) { c.limits.output_bytes = 65535; } } if (item.id == 9) { c.limits.work = n; } if (item.id == 10) { c.limits.records = n; } return true;
}
fn operand(c: &Config, item: ext::cli::Argument) -> bool { if (c.mode == 0) { if (eq(item.bytes,"inspect",7)) { c.mode = 1; return true; } if (eq(item.bytes,"query",5)) { c.mode = 2; return true; } return false; } if (c.mode != 2 || core::option::is_some(c.name)) { return false; } c.name = core::option::Some(item.bytes); return true; }
fn read(input: &alloc::vec::Vec<u8>, maximum: i32) -> i32 { let source: std::stream::Descriptor = std::stream::stdin(); let storage: [i32;256] = [0;256]; let scratch: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(storage),1024); while (true) { let got = source.read(scratch,0,1024); if (core::result::is_err(got)) { if (core::io::is_interrupted(core::result::unwrap_err(got))) { continue; } return 5; } let count: i32 = core::result::unwrap(got); if (count == 0) { return 0; } if (count > maximum-input.len()) { return 3; } if (core::result::is_err(input.try_extend(core::result::unwrap(core::slice::view(scratch,count))))) { return 4; } } return 0; }
fn dotted(value: core::slice::View<u8>, owner: &alloc::vec::Vec<u8>) -> i32 {
    if (value.is_empty() || eq(value,".",1)) { if (core::result::is_err(owner.try_push(0 as u8))) { return 4; } return 0; }
    let start: i32 = 0; let pos: i32 = 0; while (pos <= value.len()) { if (pos == value.len() || core::option::unwrap(value.get(pos)) == 46) { let count: i32 = pos-start; if (count < 1 || count > 63 || count+2 > 255-owner.len()) { return 2; } if (core::result::is_err(owner.try_push(count as u8)) || core::result::is_err(owner.try_extend(core::result::unwrap(value.subview(start,pos))))) { return 4; } start = pos+1; if (start == value.len()) { break; } } pos += 1; } if (core::result::is_err(owner.try_push(0 as u8))) { return 4; } return 0;
}
fn process(args: std::args::Arguments) -> i32 {
    let specs: [ext::cli::Spec;11] = [
        ext::cli::Spec { id: 1, long: literal("id",2), short: 0, arity: ext::cli::Arity::Required }, ext::cli::Spec { id: 2, long: literal("type",4), short: 0, arity: ext::cli::Arity::Required }, ext::cli::Spec { id: 3, long: literal("class",5), short: 0, arity: ext::cli::Arity::Required }, ext::cli::Spec { id: 4, long: literal("udp-size",8), short: 0, arity: ext::cli::Arity::Required }, ext::cli::Spec { id: 5, long: literal("dnssec",6), short: 0, arity: ext::cli::Arity::Flag }, ext::cli::Spec { id: 6, long: literal("wire-name",9), short: 0, arity: ext::cli::Arity::Flag }, ext::cli::Spec { id: 7, long: literal("max-input",9), short: 0, arity: ext::cli::Arity::Required }, ext::cli::Spec { id: 8, long: literal("max-output",10), short: 0, arity: ext::cli::Arity::Required }, ext::cli::Spec { id: 9, long: literal("max-work",8), short: 0, arity: ext::cli::Arity::Required }, ext::cli::Spec { id: 10, long: literal("max-records",11), short: 0, arity: ext::cli::Arity::Required }, ext::cli::Spec { id: 11, long: literal("help",4), short: 104, arity: ext::cli::Arity::Flag }
    ];
    let parser: ext::cli::Parser = core::result::unwrap(ext::cli::parser(args.as_view(),core::result::unwrap(core::slice::view(specs,11)),ext::cli::Ordering::Intermixed)); let c: Config = Config { mode: 0, name: core::option::None(), wire: false, id: 0, qtype: 1, qclass: 1, udp: 0, dnssec: false, limits: ext::dns::default_limits(), max_output: 262144, query_options: false, help: false };
    while (true) { let got = parser.next(); if (core::result::is_err(got)) { return 2; } let next = core::result::unwrap(got); if (core::option::is_none(next)) { break; } let ok: bool = match (core::option::unwrap(next)) { ext::cli::Event::Option(v) -> option(c.borrow(),v), ext::cli::Event::Operand(v) -> operand(c.borrow(),v) }; if (!ok) { return 2; } }
    if (c.help) { if (!write(literal("Usage: dns-message inspect [LIMITS] <PACKET\n       dns-message query [--id N] [--type N] [--class N] [--udp-size N] [--dnssec] NAME\n       dns-message query --wire-name [OPTIONS] <NAME.wire\n",190),1)) { return 5; } return 0; }
    if (c.mode == 0 || (c.mode == 1 && (c.query_options || core::option::is_some(c.name))) || (c.mode == 2 && c.wire == core::option::is_some(c.name)) || (c.dnssec && c.udp == 0)) { return 2; }
    let input: alloc::vec::Vec<u8> = alloc::vec::new(); let status: i32 = 0;
    if (c.mode == 1 || c.wire) { status = read(input.borrow(),c.limits.message_bytes); } else { status = dotted(core::option::unwrap(c.name),input.borrow()); }
    if (status != 0) { input.destroy(); return status; }
    if (c.mode == 2) { let result = ext::dns::query(c.id,c.qtype,c.qclass,input.as_view(),c.udp,c.dnssec,c.limits); input.destroy(); if (core::result::is_err(result)) { return diagnostic(core::result::unwrap_err(result)); } let wire: alloc::vec::Vec<u8> = core::result::unwrap(result); if (!write(wire.as_view(),1)) { status = 5; } wire.destroy(); return status; }
    let parsed = ext::dns::parse(input.as_view(),c.limits); if (core::result::is_err(parsed)) { let error: ext::dns::Error = core::result::unwrap_err(parsed); input.destroy(); return diagnostic(error); }
    let output: Output = Output { bytes: alloc::vec::new(), maximum: c.max_output, failure: 0 }; let ok: bool = inspect(output.borrow(),core::result::unwrap(parsed)); if (!ok) { status = output.failure; } if (status == 0 && !write(output.bytes.as_view(),1)) { status = 5; } output.bytes.destroy(); input.destroy(); return status;
}
fn main() -> i32 { let got = std::args::snapshot(1,32,8192); if (core::result::is_err(got)) { return match (core::result::unwrap_err(got)) { std::args::Error::AllocationFailed -> 4, std::args::Error::HostRead(at) -> 5, _ -> 2 }; } let args: std::args::Arguments = core::result::unwrap(got); let status: i32 = process(args); args.destroy(); return status; }
