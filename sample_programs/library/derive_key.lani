// Bounded binary-input HKDF-SHA256: streamed HMAC extraction, then real expand.
// Accepted x86_64 Linux native ELF; see docs/extended-derive-key.md.
module app::main;
import core::io;
import core::mem;
import core::result;
import core::sha256;
import core::slice;
import ext::hmac_sha256;
import ext::hkdf_sha256;
import std::fs;
import std::process;
import std::signal;

const INPUT_LIMIT: i32 = 1048576;
const IO_LIMIT: u64 = 131072;
fn digit(value: u8) -> i32 {
    if (value >= 48 && value <= 57) { return (value - 48) as i32; }
    if (value >= 65 && value <= 70) { return (value - 65 + 10) as i32; }
    if (value >= 97 && value <= 102) { return (value - 97 + 10) as i32; }
    return -1;
}
fn read_argument(index: i32, pointer: ptr) -> i32 {
    let count: i32 = std::process::arg_len(index);
    if (count < 0 || count > 512) { return -1; }
    if (std::process::arg_read(index, pointer, count as usize) != count) { return -1; }
    return count;
}
fn output_length(bytes: [u8], count: i32) -> i32 {
    if (count <= 0) { return -1; }
    let value: i32 = 0; let index: i32 = 0;
    while (index < count) {
        let next: i32 = digit(bytes[index]);
        if (next < 0 || next > 9 || value > (8160 - next) / 10) { return -1; }
        value = value * 10 + next; index += 1;
    }
    return value;
}
fn decode(bytes: [u8], count: i32, output: [u8]) -> i32 {
    if (count < 0 || count % 2 != 0) { return -1; }
    let index: i32 = 0;
    while (index < count) {
        let high: i32 = digit(bytes[index]); let low: i32 = digit(bytes[index + 1]);
        if (high < 0 || low < 0) { return -1; }
        output[index / 2] = (high * 16 + low) as u8; index += 2;
    }
    return count / 2;
}
fn hex(value: u8) -> u8 { if (value < 10) { return 48 + value; } return 97 + value - 10; }
fn main() -> i32 {
    if (std::signal::set_disposition(std::signal::Signal::BrokenPipe, std::signal::Disposition::Ignore).is_err()) { return 3; }
    if (std::process::argc() != 4) { return 2; }
    let argument_words: [i32; 128] = [0; 128]; let argument_pointer: ptr = core::mem::i32_array_data_ptr(argument_words);
    let argument: [u8] = core::mem::typed_slice_from_raw_parts(argument_pointer, 512);
    let count: i32 = read_argument(1, argument_pointer); let wanted: i32 = output_length(argument, count);
    if (wanted < 0) { return 2; }
    let salt_words: [i32; 64] = [0; 64]; let salt: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(salt_words), 256);
    count = read_argument(2, argument_pointer); let salt_length: i32 = decode(argument, count, salt); if (salt_length < 0) { return 2; }
    let info_words: [i32; 64] = [0; 64]; let info: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(info_words), 256);
    count = read_argument(3, argument_pointer); let info_length: i32 = decode(argument, count, info); if (info_length < 0) { return 2; }
    let made: core::result::Result<ext::hmac_sha256::State, ext::hmac_sha256::Error> = ext::hmac_sha256::new(core::slice::View { values: salt, start: 0, length: salt_length });
    if (made.is_err()) { return 7; } let state: ext::hmac_sha256::State = made.unwrap();
    let input_words: [i32; 256] = [0; 256]; let input_pointer: ptr = core::mem::i32_array_data_ptr(input_words);
    let input: [u8] = core::mem::typed_slice_from_raw_parts(input_pointer, 1024);
    let total: i32 = 0; let calls: u64 = 0;
    while (true) {
        if (calls == IO_LIMIT) { return 7; }
        let request: i32 = INPUT_LIMIT - total; if (request > 1024) { request = 1024; } if (request == 0) { request = 1; }
        calls += 1; let received: i32 = std::fs::read(0, input_pointer, request as usize);
        if (received == -4) { continue; }
        if (received < 0 || received > request) { return 3; }
        if (received == 0) { break; }
        if (total == INPUT_LIMIT) { return 7; }
        let updated: core::result::Result<i32, ext::hmac_sha256::Error> = state.update(core::slice::View { values: input, start: 0, length: received });
        if (updated.is_err()) { return 7; } if (updated.unwrap() != received) { return 7; } total += received;
    }
    let prk: core::sha256::Digest = state.finish(); if (prk.length != 32) { return 7; }
    let key_words: [i32; 2040] = [0; 2040]; let key: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(key_words), 8160);
    let expanded: core::result::Result<i32, ext::hkdf_sha256::Error> = ext::hkdf_sha256::expand(core::slice::View { values: prk.bytes, start: 0, length: prk.length }, core::slice::View { values: info, start: 0, length: info_length }, core::slice::View { values: key, start: 0, length: wanted });
    if (expanded.is_err()) { return 7; } if (expanded.unwrap() != wanted) { return 7; }
    let output_words: [i32; 4081] = [0; 4081]; let output_pointer: ptr = core::mem::i32_array_data_ptr(output_words);
    let output: [u8] = core::mem::typed_slice_from_raw_parts(output_pointer, 16321); let index: i32 = 0;
    while (index < wanted) { output[index * 2] = hex(key[index] >> 4); output[index * 2 + 1] = hex(key[index] & 15); index += 1; }
    let length: i32 = wanted * 2 + 1; output[length - 1] = 10; let sent: i32 = 0;
    while (sent < length) {
        if (calls == IO_LIMIT) { return 7; }
        calls += 1; let written: i32 = std::fs::write(1, output_pointer + sent, (length - sent) as usize);
        if (written == -4) { continue; }
        if (written <= 0 || written > length - sent) { return 3; } sent += written;
    }
    return 0;
}
