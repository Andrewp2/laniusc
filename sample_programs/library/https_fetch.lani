// One verified HTTPS GET over a numeric endpoint and explicit peer/CA file.
module app::main;
import alloc::vec;
import core::decimal;
import core::io;
import core::mem;
import core::net;
import core::option;
import core::result;
import core::slice;
import core::time;
import ext::cli;
import ext::http;
import ext::openssl_tls;
import ext::tls_stream;
import std::args;
import std::clock;
import std::signal;
import std::stream;

enum Error { Arguments, Limit, Allocation, Clock, Http(ext::http::Error), Tls(ext::openssl_tls::Error), Transport(ext::tls_stream::Failure), Output }
struct Options { endpoint: core::slice::View<u8>, peer: core::slice::View<u8>, ca: core::slice::View<u8>, target: core::slice::View<u8>, client_cert: core::option::Option<core::slice::View<u8>>, client_key: core::option::Option<core::slice::View<u8>>, operands: i32, help: bool, timeout: i32, max_response: i32, max_body: i32, max_output: i32, max_io: u64, max_tls: u64, max_work: u64, stdout_calls: i32 }
impl Options { fn borrow(&self) -> &Options { return self; } }
struct Work { used: u64, maximum: u64 }
impl Work { fn borrow(&self) -> &Work { return self; } }
fn literal(value: str, count: i32) -> core::slice::View<u8> { let bytes: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::string_data_ptr(value),count); return core::slice::view(bytes,count).unwrap(); }
fn eq(left: core::slice::View<u8>, value: str, count: i32) -> bool {
    let right: core::slice::View<u8> = literal(value,count); if (left.len() != count) { return false; }
    let i: i32 = 0; while (i < count) { if (left.get(i).unwrap() != right.get(i).unwrap()) { return false; } i += 1; } return true;
}
fn write_stdout(bytes: core::slice::View<u8>, calls: i32, handle: i32) -> bool {
    let sink: std::stream::Descriptor = std::stream::from_handle(handle); let completed: i32 = 0; let remaining: i32 = calls;
    while (completed < bytes.len()) {
        if (remaining == 0) { return false; } remaining -= 1;
        let sent = sink.write(bytes.values,bytes.start + completed,bytes.len() - completed);
        if (sent.is_err()) { if (core::io::is_interrupted(sent.unwrap_err())) { continue; } return false; }
        let count: i32 = sent.unwrap(); if (count <= 0 || count > bytes.len() - completed) { return false; } completed += count;
    }
    return true;
}
fn report(status: i32, text: core::slice::View<u8>) -> i32 { write_stdout(text,8,2); return status; }
fn native_tls_error(error: ext::openssl_tls::Error) -> i32 {
    return match (error.cause) {
        ext::openssl_tls::Cause::Verification -> report(3,literal("https-fetch: certificate verification failed\n",45)),
        ext::openssl_tls::Cause::PeerCertificate -> report(3,literal("https-fetch: peer certificate missing\n",38)),
        ext::openssl_tls::Cause::Truncated -> report(3,literal("https-fetch: truncated TLS stream\n",34)),
        ext::openssl_tls::Cause::AllocationFailed -> report(4,literal("https-fetch: allocation failed\n",31)),
        ext::openssl_tls::Cause::Identity -> report(2,literal("https-fetch: invalid peer identity\n",35)),
        ext::openssl_tls::Cause::Utf8 -> report(2,literal("https-fetch: invalid TLS path or identity\n",42)),
        ext::openssl_tls::Cause::Limit -> report(2,literal("https-fetch: invalid TLS configuration\n",39)),
        ext::openssl_tls::Cause::InvalidLimits -> report(2,literal("https-fetch: invalid TLS configuration\n",39)),
        ext::openssl_tls::Cause::Nul -> report(2,literal("https-fetch: invalid TLS configuration\n",39)),
        _ -> report(3,literal("https-fetch: TLS operation failed\n",34))
    };
}
fn tls_error(failure: ext::tls_stream::Failure) -> i32 {
    return match (failure.cause) {
        ext::tls_stream::Cause::InvalidLimits -> report(2,literal("https-fetch: invalid limits\n",28)),
        ext::tls_stream::Cause::AllocationFailed -> report(4,literal("https-fetch: allocation failed\n",31)),
        ext::tls_stream::Cause::Timeout -> report(3,literal("https-fetch: network timeout\n",29)),
        ext::tls_stream::Cause::IoLimit -> report(2,literal("https-fetch: network call limit exceeded\n",41)),
        ext::tls_stream::Cause::TlsLimit -> report(2,literal("https-fetch: TLS call limit exceeded\n",37)),
        ext::tls_stream::Cause::ReadLimit -> report(2,literal("https-fetch: response limit exceeded\n",37)),
        ext::tls_stream::Cause::WriteLimit -> report(2,literal("https-fetch: request limit exceeded\n",36)),
        ext::tls_stream::Cause::Tls(error) -> native_tls_error(error),
        _ -> report(3,literal("https-fetch: network operation failed\n",38))
    };
}
fn error(error: Error) -> i32 { return match (error) {
    Error::Arguments -> report(2,literal("https-fetch: invalid arguments\n",31)),
    Error::Limit -> report(2,literal("https-fetch: byte or work limit exceeded\n",41)),
    Error::Allocation -> report(4,literal("https-fetch: allocation failed\n",31)),
    Error::Clock -> report(3,literal("https-fetch: monotonic clock failed\n",36)),
    Error::Http(detail) -> match (detail) { ext::http::Error::AllocationFailed -> report(4,literal("https-fetch: allocation failed\n",31)), ext::http::Error::Limit(n) -> report(2,literal("https-fetch: HTTP limit exceeded\n",33)), _ -> report(3,literal("https-fetch: invalid or incomplete HTTP response\n",49)) },
    Error::Tls(detail) -> native_tls_error(detail),
    Error::Transport(failure) -> tls_error(failure),
    Error::Output -> report(5,literal("https-fetch: output I/O or call limit failed\n",45))
}; }
fn charge(work: &Work, amount: u64) -> bool { if (amount > work.maximum - work.used) { return false; } work.used += amount; return true; }
fn stream_error(stream: &ext::tls_stream::Stream) -> Error {
    if (stream.last_failure().is_some()) { return Error::Transport(stream.last_failure().unwrap()); }
    return Error::Output;
}
fn authority(peer: core::slice::View<u8>, endpoint: core::net::SocketAddr) -> core::result::Result<alloc::vec::Vec<u8>,Error> {
    let output: alloc::vec::Vec<u8> = alloc::vec::new();
    let parsed = core::net::parse_ip(peer); let bracket: bool = false;
    if (parsed.is_ok()) { bracket = match (parsed.unwrap()) { core::net::IpAddr::V6(v) -> true, _ -> false }; }
    if (bracket && output.try_extend(literal("[",1)).is_err()) { output.destroy(); return core::result::Err(Error::Allocation); }
    if (output.try_extend(peer).is_err()) { output.destroy(); return core::result::Err(Error::Allocation); }
    if (bracket && output.try_extend(literal("]",1)).is_err()) { output.destroy(); return core::result::Err(Error::Allocation); }
    if (endpoint.port() != 443) {
        let digits: [u8; 6] = [0; 6]; digits[0] = 58;
        let number: u32 = endpoint.port() as u32; let length: i32 = core::decimal::len_u32(number) as i32; let i: i32 = 0;
        while (i < length) { digits[i + 1] = core::decimal::byte_at_or_u32(number,i as u32,0); i += 1; }
        if (output.try_extend(core::slice::view(digits,length + 1).unwrap()).is_err()) { output.destroy(); return core::result::Err(Error::Allocation); }
    }
    return core::result::Ok(output);
}
fn request(options: &Options, endpoint: core::net::SocketAddr, limits: ext::http::Limits) -> core::result::Result<alloc::vec::Vec<u8>,Error> {
    if (options.target.is_empty() || options.target.get(0).unwrap() != 47 || options.target.len() > 8192) { return core::result::Err(Error::Arguments); }
    let named = authority(options.peer,endpoint); if (named.is_err()) { return named; }
    let host: alloc::vec::Vec<u8> = named.unwrap(); let line: alloc::vec::Vec<u8> = alloc::vec::new();
    if (line.try_extend(literal("GET ",4)).is_err() || line.try_extend(options.target).is_err() || line.try_extend(literal(" HTTP/1.1",9)).is_err()) { host.destroy(); line.destroy(); return core::result::Err(Error::Allocation); }
    let fields: [ext::http::Field; 2] = [
        ext::http::Field { raw: literal("",0), name: literal("Host",4), value: host.as_view(), offset: 0 },
        ext::http::Field { raw: literal("",0), name: literal("Connection",10), value: literal("close",5), offset: 0 }
    ];
    let encoded = ext::http::encode_request(line.as_view(),core::slice::view(fields,2).unwrap(),literal("",0),limits);
    host.destroy(); line.destroy();
    if (encoded.is_err()) {
        let failure: Error = match (encoded.unwrap_err()) { ext::http::Error::AllocationFailed -> Error::Allocation, ext::http::Error::Limit(n) -> Error::Limit, _ -> Error::Arguments };
        return core::result::Err(failure);
    }
    let bytes: alloc::vec::Vec<u8> = encoded.unwrap(); if (bytes.len() > 16384) { bytes.destroy(); return core::result::Err(Error::Limit); }
    return core::result::Ok(bytes);
}
fn receive(stream: &ext::tls_stream::Stream, options: &Options, limits: ext::http::Limits, work: &Work) -> core::result::Result<alloc::vec::Vec<u8>,Error> {
    let wire: alloc::vec::Vec<u8> = alloc::vec::new();
    let made = ext::http::cursor(ext::http::CursorMode::Response,limits,options.max_response,work.maximum - work.used);
    if (made.is_err()) { return core::result::Err(Error::Http(made.unwrap_err())); }
    let cursor: ext::http::Cursor = made.unwrap(); let charged: u64 = 0; let offset: i32 = 0; let interims: i32 = 0; let status: i32 = 0; let eof: bool = false;
    let scratch: [u8; 1024] = [0; 1024];
    while (true) {
        let checked = stream.check(); if (checked.is_err()) { wire.destroy(); return core::result::Err(Error::Transport(checked.unwrap_err())); }
        let scanned = cursor.advance(wire.as_view().subview(offset,wire.len()).unwrap(),literal("GET",3),eof);
        let used: u64 = cursor.work(); let paid: bool = charge(work,used - charged); charged = used;
        if (!paid) { wire.destroy(); return core::result::Err(Error::Limit); }
        if (scanned.is_err()) { wire.destroy(); return core::result::Err(Error::Http(scanned.unwrap_err())); }
        let event: ext::http::Scan = scanned.unwrap();
        let head: bool = match (event) { ext::http::Scan::HeadReady(v) -> true, _ -> false };
        if (head) {
            status = match (event) { ext::http::Scan::HeadReady(v) -> v.status, _ -> 0 };
            if (status == 101) { wire.destroy(); return core::result::Err(Error::Http(ext::http::Error::Unsupported(offset))); }
            continue;
        }
        let complete: bool = match (event) { ext::http::Scan::Boundary(v) -> true, _ -> false };
        if (complete) {
            let boundary: ext::http::FrameBoundary = match (event) { ext::http::Scan::Boundary(v) -> v, _ -> ext::http::FrameBoundary { consumed: 0, decoded_length: 0 } };
            let end: i32 = offset + boundary.consumed;
            if (boundary.consumed < 0 || end < offset || end > wire.len()) { wire.destroy(); return core::result::Err(Error::Http(ext::http::Error::Bounds)); }
            let selected: core::slice::View<u8> = wire.as_view().subview(offset,end).unwrap();
            let allowance: u64 = 4 * (selected.len() as u64);
            if (status >= 200) { allowance += 4 * (limits.head_bytes as u64) * ((limits.trailers as u64) + 1); }
            if (!charge(work,allowance)) { wire.destroy(); return core::result::Err(Error::Limit); }
            let parsed = ext::http::parse_response(selected,literal("GET",3),eof,limits);
            if (parsed.is_err()) { wire.destroy(); return core::result::Err(Error::Http(parsed.unwrap_err())); }
            let message: ext::http::Message = parsed.unwrap();
            if (message.consumed != boundary.consumed || message.decoded_length != boundary.decoded_length) { wire.destroy(); return core::result::Err(Error::Http(ext::http::Error::Bounds)); }
            if (status < 200) {
                interims += 1; if (interims > 8 || end > 65536) { wire.destroy(); return core::result::Err(Error::Limit); }
                offset = end;
                let next = ext::http::cursor(ext::http::CursorMode::Response,limits,options.max_response - offset,work.maximum - work.used);
                if (next.is_err()) { wire.destroy(); return core::result::Err(Error::Http(next.unwrap_err())); }
                cursor = next.unwrap(); charged = 0; continue;
            }
            if (end != wire.len()) { wire.destroy(); return core::result::Err(Error::Http(ext::http::Error::Malformed(end))); }
            if (message.decoded_length > options.max_output || !charge(work,2 * (message.decoded_length as u64))) { wire.destroy(); return core::result::Err(Error::Limit); }
            let allocated = alloc::vec::with_capacity<u8>(message.decoded_length);
            if (allocated.is_err()) { wire.destroy(); return core::result::Err(Error::Allocation); }
            let output: alloc::vec::Vec<u8> = allocated.unwrap();
            if (output.try_resize(message.decoded_length,0 as u8).is_err()) { output.destroy(); wire.destroy(); return core::result::Err(Error::Allocation); }
            let decoded = ext::http::decode_into(message,output.as_view()); wire.destroy();
            if (decoded.is_err()) { output.destroy(); return core::result::Err(Error::Http(decoded.unwrap_err())); }
            if (decoded.unwrap() != message.decoded_length) { output.destroy(); return core::result::Err(Error::Http(ext::http::Error::Bounds)); }
            let final_check = stream.check(); if (final_check.is_err()) { output.destroy(); return core::result::Err(Error::Transport(final_check.unwrap_err())); }
            return core::result::Ok(output);
        }
        let capacity: i32 = options.max_response - wire.len(); let amount: i32 = capacity;
        if (amount > 1024) { amount = 1024; } if (amount == 0) { amount = 1; }
        let got = stream.read(scratch,0,amount);
        if (got.is_err()) { wire.destroy(); return core::result::Err(stream_error(stream)); }
        let count: i32 = got.unwrap(); if (count == 0) { eof = true; continue; }
        if (count > capacity) { wire.destroy(); return core::result::Err(Error::Limit); }
        if (wire.try_extend(core::slice::view(scratch,count).unwrap()).is_err()) { wire.destroy(); return core::result::Err(Error::Allocation); }
    }
    return core::result::Err(Error::Arguments);
}
fn connect_profile(options: &Options, endpoint: core::net::SocketAddr, identity: ext::openssl_tls::Identity, limits: ext::tls_stream::Limits, deadline: core::time::Deadline) -> core::result::Result<ext::tls_stream::Stream,Error> {
    if (options.client_cert.is_none()) {
        let connected: core::result::Result<ext::tls_stream::Stream,ext::tls_stream::Failure> = ext::tls_stream::connect_until(endpoint,ext::openssl_tls::Trust::CaFile(options.ca),identity,ext::openssl_tls::default_limits(),limits,deadline);
        if (connected.is_err()) { return core::result::Err(Error::Transport(connected.unwrap_err())); } return core::result::Ok(connected.unwrap());
    }
    let created: core::result::Result<ext::openssl_tls::Context,ext::openssl_tls::Error> = ext::openssl_tls::new_with_credentials(ext::openssl_tls::Trust::CaFile(options.ca),options.client_cert.unwrap(),options.client_key.unwrap(),literal("",0),ext::openssl_tls::default_limits());
    if (created.is_err()) { return core::result::Err(Error::Tls(created.unwrap_err())); } let context = created.unwrap();
    let connected: core::result::Result<ext::tls_stream::Stream,ext::tls_stream::Failure> = ext::tls_stream::connect_with_context_until(endpoint,context.borrow(),identity,limits,deadline);
    context.destroy();
    if (connected.is_err()) { return core::result::Err(Error::Transport(connected.unwrap_err())); } return core::result::Ok(connected.unwrap());
}
fn fetch(options: &Options) -> core::result::Result<alloc::vec::Vec<u8>,Error> {
    if (options.client_cert.is_some() != options.client_key.is_some()) { return core::result::Err(Error::Arguments); }
    if (options.client_cert.is_some() && (options.client_cert.unwrap().is_empty() || options.client_key.unwrap().is_empty())) { return core::result::Err(Error::Arguments); }
    let endpoint = core::net::parse_socket(options.endpoint); if (endpoint.is_err() || endpoint.unwrap().port() == 0 || options.peer.is_empty() || options.ca.is_empty()) { return core::result::Err(Error::Arguments); }
    let limits: ext::http::Limits = ext::http::default_limits(); limits.head_bytes = 16384; limits.headers = 64; limits.trailers = 16; limits.body_bytes = options.max_body;
    let encoded = request(options,endpoint.unwrap(),limits); if (encoded.is_err()) { return encoded; }
    let request: alloc::vec::Vec<u8> = encoded.unwrap(); let work: Work = Work { used: 0, maximum: options.max_work };
    if (!charge(work.borrow(),4 * (request.len() as u64))) { request.destroy(); return core::result::Err(Error::Limit); }
    let now = std::clock::monotonic_now(); if (now.is_err()) { request.destroy(); return core::result::Err(Error::Clock); }
    let shifted = core::time::deadline_after(now.unwrap(),core::time::from_millis(options.timeout as u64));
    if (shifted.is_err()) { request.destroy(); return core::result::Err(Error::Clock); }
    let identity: ext::openssl_tls::Identity = ext::openssl_tls::Identity::Dns(options.peer);
    if (core::net::parse_ip(options.peer).is_ok()) { identity = ext::openssl_tls::Identity::Ip(options.peer); }
    let transport: ext::tls_stream::Limits = ext::tls_stream::Limits { io_calls: options.max_io, tls_calls: options.max_tls, read_bytes: (options.max_response as u64) + 1, written_bytes: request.len() as u64 };
    let connected: core::result::Result<ext::tls_stream::Stream,Error> = connect_profile(options,endpoint.unwrap(),identity,transport,shifted.unwrap());
    if (connected.is_err()) { request.destroy(); return core::result::Err(connected.unwrap_err()); }
    let stream: ext::tls_stream::Stream = connected.unwrap();
    let sent = core::io::write_all(stream.borrow(),request.as_slice(),0,request.len()); request.destroy();
    if (sent.is_err() || stream.flush().is_err()) { let failed: Error = stream_error(stream.borrow()); stream.close(); return core::result::Err(failed); }
    let received = receive(stream.borrow(),options,limits,work.borrow());
    if (received.is_err()) { stream.close(); return received; }
    let output: alloc::vec::Vec<u8> = received.unwrap();
    let stopped = stream.shutdown(); if (stopped.is_err()) { output.destroy(); stream.close(); return core::result::Err(Error::Transport(stopped.unwrap_err())); }
    let checked = stream.check(); if (checked.is_err()) { output.destroy(); stream.close(); return core::result::Err(Error::Transport(checked.unwrap_err())); }
    let closed = stream.close(); if (closed.is_err()) { output.destroy(); return core::result::Err(Error::Transport(closed.unwrap_err())); }
    return core::result::Ok(output);
}
fn apply(options: &Options, item: ext::cli::Occurrence) -> bool {
    if (item.id == 1) { options.help = true; return true; }
    let argument: ext::cli::Argument = item.value.unwrap(); let bytes: core::slice::View<u8> = argument.bytes;
    if (item.id == 10) { options.client_cert = core::option::Some(bytes); return true; }
    if (item.id == 11) { options.client_key = core::option::Some(bytes); return true; }
    let parsed = core::decimal::parse_u64_range(bytes.values,bytes.start,bytes.len());
    if (parsed.is_err() || parsed.unwrap() > 2147483647 as u64) { return false; } let value: u64 = parsed.unwrap();
    if (item.id == 2) { if (value > 60000 as u64) { return false; } options.timeout = value as i32; }
    if (item.id == 3 || item.id == 4 || item.id == 8) { if (value > 16777216 as u64) { return false; } }
    if (item.id == 3) { options.max_response = value as i32; } if (item.id == 4) { options.max_body = value as i32; }
    if (item.id == 5) { options.max_io = value; } if (item.id == 6) { options.max_tls = value; } if (item.id == 7) { options.max_work = value; }
    if (item.id == 8) { options.max_output = value as i32; } if (item.id == 9) { options.stdout_calls = value as i32; } return true;
}
fn operand(options: &Options, bytes: core::slice::View<u8>) -> bool {
    if (options.operands == 0) { options.endpoint = bytes; } if (options.operands == 1) { options.peer = bytes; }
    if (options.operands == 2) { options.ca = bytes; } if (options.operands == 3) { options.target = bytes; }
    options.operands += 1; return options.operands <= 4;
}
fn arguments(values: std::args::Arguments) -> i32 {
    let specs: [ext::cli::Spec; 11] = [
        ext::cli::Spec { id: 1, long: literal("help",4), short: 104, arity: ext::cli::Arity::Flag },
        ext::cli::Spec { id: 2, long: literal("timeout",7), short: 0, arity: ext::cli::Arity::Required },
        ext::cli::Spec { id: 3, long: literal("max-response",12), short: 0, arity: ext::cli::Arity::Required },
        ext::cli::Spec { id: 4, long: literal("max-body",8), short: 0, arity: ext::cli::Arity::Required },
        ext::cli::Spec { id: 5, long: literal("max-io",6), short: 0, arity: ext::cli::Arity::Required },
        ext::cli::Spec { id: 6, long: literal("max-tls",7), short: 0, arity: ext::cli::Arity::Required },
        ext::cli::Spec { id: 7, long: literal("max-work",8), short: 0, arity: ext::cli::Arity::Required },
        ext::cli::Spec { id: 8, long: literal("max-output",10), short: 0, arity: ext::cli::Arity::Required },
        ext::cli::Spec { id: 9, long: literal("max-stdout-calls",16), short: 0, arity: ext::cli::Arity::Required },
        ext::cli::Spec { id: 10, long: literal("client-cert",11), short: 0, arity: ext::cli::Arity::Required },
        ext::cli::Spec { id: 11, long: literal("client-key",10), short: 0, arity: ext::cli::Arity::Required }
    ];
    let parser = ext::cli::parser(values.as_view(),core::slice::view(specs,11).unwrap(),ext::cli::Ordering::Intermixed).unwrap();
    let options: Options = Options { endpoint: literal("",0), peer: literal("",0), ca: literal("",0), target: literal("",0), client_cert:core::option::None(),client_key:core::option::None(),operands: 0, help: false, timeout: 5000, max_response: 2097152, max_body: 1048576, max_output: 1048576, max_io: 65536, max_tls: 32768, max_work: 67108864, stdout_calls: 65536 };
    while (true) {
        let parsed = parser.next(); if (parsed.is_err()) { return error(Error::Arguments); }
        let next: core::option::Option<ext::cli::Event> = parsed.unwrap(); if (next.is_none()) { break; }
        let valid: bool = match (next.unwrap()) { ext::cli::Event::Option(item) -> apply(options.borrow(),item), ext::cli::Event::Operand(item) -> operand(options.borrow(),item.bytes) };
        if (!valid) { return error(Error::Arguments); }
    }
    if (options.help) {
        let usage: core::slice::View<u8> = literal("Usage: https-fetch ADDRESS PEER CA_FILE TARGET [OPTIONS]\nOptions: --timeout MS --max-response N --max-body N --max-io N --max-tls N\n         --max-work N --max-output N --max-stdout-calls N\n         --client-cert CHAIN --client-key KEY\n",236);
        if (!write_stdout(usage,options.stdout_calls,1)) { return error(Error::Output); } return 0;
    }
    if (options.operands != 4) { return error(Error::Arguments); }
    let result = fetch(options.borrow()); if (result.is_err()) { return error(result.unwrap_err()); }
    let output: alloc::vec::Vec<u8> = result.unwrap(); let written: bool = write_stdout(output.as_view(),options.stdout_calls,1); output.destroy();
    if (!written) { return error(Error::Output); } return 0;
}
fn main() -> i32 {
    if (std::signal::set_disposition(std::signal::Signal::BrokenPipe,std::signal::Disposition::Ignore).is_err()) { return report(5,literal("https-fetch: cannot ignore SIGPIPE\n",35)); }
    let captured = std::args::snapshot(1,32,16384);
    if (captured.is_err()) { return match (captured.unwrap_err()) { std::args::Error::AllocationFailed -> error(Error::Allocation), _ -> error(Error::Arguments) }; }
    let values: std::args::Arguments = captured.unwrap(); let status: i32 = arguments(values); values.destroy(); return status;
}
