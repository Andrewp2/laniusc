// zstd: compress files to .zst with streaming ext::zstd_encode at levels
// 1-3 (default 3). FILE becomes FILE.zst (kept, like zstd; -f overwrites);
// no FILE or "-" compresses standard input to standard output; -c writes to
// standard output. A failed run removes its partial output file. Decode
// with unzstd.
// Exit 2: arguments or existing output; 3: I/O; 4: allocation.
module app::main;

import alloc::vec;
import core::io;
import core::mem;
import core::option;
import core::path;
import core::result;
import core::slice;
import ext::zstd_encode;
import std::args;
import std::cli;
import std::file;
import std::file_ops;
import std::filesystem;
import std::fs;
import std::stream;

const CHUNK: i32 = 131072;
enum Error { Usage, Exists, Io, Allocation }
struct Options { stdout: bool, force: bool, help: bool, level: i32 }
impl Options { fn borrow(&self) -> &Options { return self; } }
struct Work { input: alloc::vec::Vec<u8>, output: alloc::vec::Vec<u8>, workspace: alloc::vec::Vec<i32>, window: alloc::vec::Vec<u8>, literals: alloc::vec::Vec<u8>, stage: alloc::vec::Vec<u8>, name: core::slice::View<u8>, target: alloc::vec::Vec<u8> }
impl Work { fn borrow(&self) -> &Work { return self; } }

fn literal(value: str, count: i32) -> core::slice::View<u8> {
    let bytes: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::string_data_ptr(value),count); return core::result::unwrap(core::slice::view(bytes,count));
}
fn at(view: core::slice::View<u8>, index: i32) -> u8 { return core::option::unwrap(view.get(index)); }
fn sub(view: core::slice::View<u8>, start: i32, end: i32) -> core::slice::View<u8> { return core::result::unwrap(view.subview(start,end)); }
fn say(message: core::slice::View<u8>) { let sink: std::stream::Descriptor = std::stream::stderr(); core::io::write_all(sink.borrow(),message.values,message.start,message.len()); }
fn failed(work: &Work, error: Error) -> i32 {
    say(literal("zstd: ",6)); if (work.name.len() > 0) { say(work.name); say(literal(": ",2)); }
    let text: core::slice::View<u8> = match (error) {
        Error::Usage -> literal("invalid arguments",17),
        Error::Exists -> literal("output exists (use -f)",22),
        Error::Io -> literal("I/O failed",10),
        Error::Allocation -> literal("allocation failed",17)
    };
    say(text); say(literal("\n",1));
    let status: i32 = match (error) { Error::Io -> 3, Error::Allocation -> 4, _ -> 2 };
    return status;
}
fn path_of(bytes: core::slice::View<u8>) -> core::result::Result<core::path::Path,Error> {
    let made: core::result::Result<core::path::Path,core::path::Error> = core::path::from_view(bytes);
    if (core::result::is_err(made)) { return core::result::Err(Error::Usage); } return core::result::Ok(core::result::unwrap(made));
}
fn base(view: core::slice::View<u8>) -> ptr { return core::mem::i32_slice_data_ptr(view.values)+(view.start as usize); }
fn write_fd(fd: i32, bytes: core::slice::View<u8>) -> core::result::Result<i32,Error> {
    let done: i32 = 0;
    while (done < bytes.len()) {
        let put: i32 = std::fs::write(fd,base(bytes)+(done as usize),(bytes.len()-done) as usize);
        if (put == -4) { continue; }
        if (put <= 0) { return core::result::Err(Error::Io); }
        done += put;
    }
    return core::result::Ok(done);
}
fn read_fd(fd: i32, into: core::slice::View<u8>) -> core::result::Result<i32,Error> {
    while (true) {
        let got: i32 = std::fs::read(fd,base(into),into.len() as usize);
        if (got >= 0 && got <= into.len()) { return core::result::Ok(got); }
        if (got != -4) { return core::result::Err(Error::Io); }
    } return core::result::Err(Error::Io);
}
fn handle(file: std::file::File) -> i32 { return core::option::unwrap(file.raw_handle()); }
fn close_fd(fd: i32) { if (fd > 2) { let file: std::file::File = core::result::unwrap(std::file::from_owned_handle(fd)); file.close(); } }
fn exists(path: core::path::Path) -> core::result::Result<bool,Error> {
    let meta: std::file_ops::Metadata = std::file_ops::empty_metadata();
    let queried: core::result::Result<i32,core::io::Error> = std::file_ops::metadata_into(path,false,meta.borrow());
    if (core::result::is_err(queried)) {
        let missing: bool = match (core::result::unwrap_err(queried)) { core::io::Error::Host(code) -> code == 2, _ -> false };
        if (missing) { return core::result::Ok(false); } return core::result::Err(Error::Io);
    }
    return core::result::Ok(true);
}
fn empty_work() -> Work {
    return Work { input: alloc::vec::new(), output: alloc::vec::new(), workspace: alloc::vec::new(), window: alloc::vec::new(), literals: alloc::vec::new(), stage: alloc::vec::new(), name: literal("",0), target: alloc::vec::new() };
}
fn work(level: i32) -> core::result::Result<Work,Error> {
    let w: Work = empty_work();
    let ok: bool = core::result::is_ok(w.input.try_resize(CHUNK,0)) && core::result::is_ok(w.output.try_resize(CHUNK,0))
        && core::result::is_ok(w.workspace.try_resize(ext::zstd_encode::workspace_len(level),0)) && core::result::is_ok(w.window.try_resize(ext::zstd_encode::window_len(level),0))
        && core::result::is_ok(w.literals.try_resize(ext::zstd_encode::literals_len(),0)) && core::result::is_ok(w.stage.try_resize(ext::zstd_encode::stage_len(),0));
    if (!ok) { destroy(w.borrow()); return core::result::Err(Error::Allocation); }
    return core::result::Ok(w);
}
fn destroy(w: &Work) { w.input.destroy(); w.output.destroy(); w.workspace.destroy(); w.window.destroy(); w.literals.destroy(); w.stage.destroy(); w.target.destroy(); }
fn encode(options: Options, w: &Work, fd_in: i32, fd_out: i32) -> core::result::Result<i32,Error> {
    let made: core::result::Result<ext::zstd_encode::Encoder,ext::zstd_encode::Error> = ext::zstd_encode::encoder(w.workspace.as_view(),w.window.as_view(),w.literals.as_view(),w.stage.as_view(),options.level);
    if (core::result::is_err(made)) { return core::result::Err(Error::Allocation); }
    let e: ext::zstd_encode::Encoder = core::result::unwrap(made);
    let pos: i32 = 0; let len: i32 = 0; let eof: bool = false;
    while (true) {
        if (pos == len && !eof) { len = read_fd(fd_in,w.input.as_view())?; pos = 0; if (len == 0) { eof = true; } }
        let stepped: core::result::Result<ext::zstd_encode::Step,ext::zstd_encode::Error> = e.borrow().step(sub(w.input.as_view(),pos,len),w.output.as_view(),eof);
        if (core::result::is_err(stepped)) { return core::result::Err(Error::Allocation); }
        let progress: ext::zstd_encode::Step = core::result::unwrap(stepped); pos += progress.read;
        if (progress.written > 0) { write_fd(fd_out,sub(w.output.as_view(),0,progress.written))?; }
        let done: bool = match (progress.status) { ext::zstd_encode::Status::Done -> true, _ -> false };
        if (done) { return core::result::Ok(0); }
    } return core::result::Ok(0);
}
fn is_dash(name: core::slice::View<u8>) -> bool { return name.len() == 1 && at(name,0) == 45; }
fn one(options: Options, w: &Work, name: core::slice::View<u8>) -> core::result::Result<i32,Error> {
    w.name = name;
    let fd_in: i32 = 0;
    if (!is_dash(name)) {
        let opened: core::result::Result<std::file::File,core::io::Error> = std::file::open(path_of(name)?,std::file::OpenMode::Read);
        if (core::result::is_err(opened)) { return core::result::Err(Error::Io); } fd_in = handle(core::result::unwrap(opened));
    }
    if (options.stdout || is_dash(name)) { let result: core::result::Result<i32,Error> = encode(options,w,fd_in,1); close_fd(fd_in); return result; }
    w.target.clear();
    if (core::result::is_err(w.target.try_extend(name)) || core::result::is_err(w.target.try_extend(literal(".zst",4)))) { close_fd(fd_in); return core::result::Err(Error::Allocation); }
    let target: core::path::Path = path_of(w.target.as_view())?;
    let present: core::result::Result<bool,Error> = exists(target);
    if (core::result::is_err(present)) { close_fd(fd_in); return core::result::Err(Error::Io); }
    if (core::result::unwrap(present) && !options.force) { close_fd(fd_in); return core::result::Err(Error::Exists); }
    let created: core::result::Result<std::file::File,core::io::Error> = std::file::open(target,std::file::OpenMode::Create);
    if (core::result::is_err(created)) { close_fd(fd_in); return core::result::Err(Error::Io); }
    let fd_out: i32 = handle(core::result::unwrap(created));
    let result: core::result::Result<i32,Error> = encode(options,w,fd_in,fd_out); close_fd(fd_in); close_fd(fd_out);
    if (core::result::is_err(result)) { std::filesystem::remove_file(target); }
    return result;
}
fn apply(options: &Options, id: i32) -> bool {
    if (id >= 1 && id <= 3) { options.level = id; } if (id == 4) { options.stdout = true; } if (id == 5) { options.force = true; } if (id == 9) { options.help = true; }
    return true;
}
fn arguments(values: std::args::Arguments) -> i32 {
    let none: Work = empty_work();
    let cli: std::cli::Command = std::cli::command(literal("zstd",4), literal("Compress files to zstd (.zst) at levels 1-3; unzstd decodes.",60));
    cli.flag(1, 49, literal("fast",4), literal("level 1: greedy, one probe per position",39));
    cli.flag(2, 50, literal("level2",6), literal("level 2: greedy, six-entry chains",33));
    cli.flag(3, 51, literal("level3",6), literal("level 3: lazy, 16-entry chains (the default)",44));
    cli.flag(4, 99, literal("stdout",6), literal("write to standard output",24));
    cli.flag(5, 102, literal("force",5), literal("overwrite existing output files",31));
    cli.flag(6, 107, literal("keep",4), literal("keep input files (the default)",30));
    cli.flag(7, 113, literal("quiet",5), literal("no effect",9));
    cli.help(9);
    cli.operands(literal("FILE",4), 0, -1);
    let parsed: core::result::Result<std::cli::Matches,std::cli::Error> = cli.parse(values.as_view());
    if (core::result::is_err(parsed)) { cli.print_error(core::result::unwrap_err(parsed), values.as_view()); cli.destroy(); return 2; }
    let matches: std::cli::Matches = core::result::unwrap(parsed);
    let options: Options = Options { stdout: false, force: false, help: false, level: 3 };
    let index: i32 = 0;
    while (index < matches.occurrences()) { apply(options.borrow(), matches.occurrence_id(index)); index += 1; }
    if (options.help) { let ok: bool = cli.print_help(-1); matches.destroy(); cli.destroy(); if (!ok) { return failed(none.borrow(),Error::Io); } return 0; }
    let names: alloc::vec::Vec<core::slice::View<u8>> = alloc::vec::new(); let valid: bool = true;
    index = 0;
    while (index < matches.operand_count() && valid) { valid = core::result::is_ok(names.try_push(matches.operand(index))); index += 1; }
    matches.destroy(); cli.destroy();
    if (!valid) { names.destroy(); return failed(none.borrow(),Error::Allocation); }
    if (names.len() == 0) { if (core::result::is_err(names.try_push(literal("-",1)))) { names.destroy(); return failed(none.borrow(),Error::Allocation); } }
    let made: core::result::Result<Work,Error> = work(options.level);
    if (core::result::is_err(made)) { names.destroy(); return failed(none.borrow(),Error::Allocation); }
    let w: Work = core::result::unwrap(made); let status: i32 = 0;
    index = 0;
    while (index < names.len()) {
        let name: core::slice::View<u8> = core::option::unwrap(names.get(index));
        let result: core::result::Result<i32,Error> = one(options,w.borrow(),name);
        if (core::result::is_err(result)) { let code: i32 = failed(w.borrow(),core::result::unwrap_err(result)); if (code > status) { status = code; } }
        index += 1;
    }
    destroy(w.borrow()); names.destroy(); return status;
}
fn main() -> i32 {
    let captured: core::result::Result<std::args::Arguments,std::args::Error> = std::args::snapshot(1,256,65536);
    if (core::result::is_err(captured)) { say(literal("zstd: cannot capture arguments\n",31)); return 2; }
    let values: std::args::Arguments = core::result::unwrap(captured); let status: i32 = arguments(values); values.destroy(); return status;
}
