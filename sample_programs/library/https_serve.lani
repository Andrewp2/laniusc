// Bounded concurrent verified HTTPS over the shared server Protocol/scheduler.
module app::main;
import core::clone;
import core::decimal;
import core::fmt;
import core::io;
import core::mem;
import core::net;
import core::option;
import core::result;
import core::slice;
import core::text;
import core::time;
import ext::http;
import ext::http_server;
import ext::server_poll;
import std::args;
import std::clock;
import std::poll;
import std::signal;
import std::socket;
import std::stream;
import ext::cli;
import ext::https_server;
import ext::https_server_poll;
import ext::openssl_tls;

enum Error { Arguments, Limit, Allocation, Clock, Timeout, State, Io(core::io::Error), Tls(ext::openssl_tls::Error), Protocol(ext::http_server::Failure), Rejected(ext::http_server::Rejection), Transport(ext::https_server::Failure), Service(ext::server_poll::Cause), Output }
// All alternatives contain diagnostic metadata, with no cleanup authority.
pub impl core::clone::Destroy<Error> for Error { pub fn destroy_value(owned: Error) {} }
struct Options { endpoint: core::slice::View<u8>, certificate: core::slice::View<u8>, key: core::slice::View<u8>, client_ca: core::option::Option<core::slice::View<u8>>, operands: i32, help: bool, report: bool, requests: i32, concurrency: i32, timeout: i32, service_timeout: i32, max_request: i32, max_body: i32, max_response: i32, max_head: i32, max_headers: i32, max_chunks: i32, max_io: u64, max_tls: u64, max_work: u64 }
impl Options { fn borrow(&self) -> &Options { return self; } }
struct Handler { maximum: i32 }
impl Handler { fn borrow(&self) -> &Handler { return self; } }
fn literal(s: str, n: i32) -> core::slice::View<u8> { let raw: [u8] = core::mem::typed_slice_from_raw_parts<u8>(core::mem::string_data_ptr(s),n); return core::slice::view<u8>(raw,n).unwrap(); }
fn text(s: str, n: i32) -> core::text::Text { let v: core::slice::View<u8> = literal(s,n); return core::text::from_utf8_unchecked(v.values,v.start,v.len()); }
fn eq(v: core::slice::View<u8>, s: str, n: i32) -> bool { if (v.len() != n) { return false; } let other: core::slice::View<u8> = literal(s,n); let i: i32 = 0; while (i < n) { if (v.get(i).unwrap() != other.get(i).unwrap()) { return false; } i += 1; } return true; }
fn write_output(bytes: core::slice::View<u8>, handle: i32) -> bool {
    let sink: std::stream::Descriptor = std::stream::from_handle(handle); let completed: i32 = 0; let calls: i32 = 8;
    while (completed < bytes.len()) {
        if (calls == 0) { return false; } calls -= 1;
        let sent = sink.write(bytes.values,bytes.start + completed,bytes.len() - completed);
        if (sent.is_err()) { if (core::io::is_interrupted(sent.unwrap_err())) { continue; } return false; }
        let count: i32 = sent.unwrap(); if (count <= 0 || count > bytes.len() - completed) { return false; } completed += count;
    }
    return true;
}
fn field(name: core::slice::View<u8>, value: core::slice::View<u8>) -> ext::http::Field { return ext::http::Field { raw:literal("",0),name:name,value:value,offset:0 }; }
fn allocation(cause: ext::http_server::Cause) -> bool { return match(cause) { ext::http_server::Cause::AllocationFailed -> true, ext::http_server::Cause::Http(e) -> match(e) { ext::http::Error::AllocationFailed -> true, _ -> false }, _ -> false }; }
fn status_reason(n: i32) -> core::slice::View<u8> { return match(n) { 200 -> literal("OK",2), 204 -> literal("No Content",10), 400 -> literal("Bad Request",11), 404 -> literal("Not Found",9), 405 -> literal("Method Not Allowed",18), 413 -> literal("Content Too Large",17), 414 -> literal("URI Too Long",12), 417 -> literal("Expectation Failed",18), 421 -> literal("Misdirected Request",19), 431 -> literal("Request Header Fields Too Large",31), 500 -> literal("Internal Server Error",21), _ -> literal("Not Implemented",15) }; }
fn service_limits(options: ext::http_server::Options, count: i32, concurrency: i32, timeout: i32) -> core::result::Result<ext::server_poll::ServerLimits,ext::server_poll::Cause> {
    let bytes: core::result::Result<u64,ext::http_server::Cause> = ext::http_server::reservation_bytes(options);
    if (bytes.is_err()) { return core::result::Err(ext::server_poll::Cause::Protocol(bytes.unwrap_err())); }
    let n: u64 = count as u64; let width: i32 = concurrency; if (width > count) { width = count; }
    // CLI caps count at64, all byte/count inputs at64MiB and io/work at i32MAX.
    // These conservative formulas are below u64MAX; no caller value wraps.
    let accepts: u64 = (options.io_calls + 1) * n;
    return core::result::Ok(ext::server_poll::ServerLimits {
        max_accepted:count,concurrency:width,accept_calls:accepts,
        polls:1024 + accepts + 16 * n * (options.io_calls + 1),
        operations:1024 + accepts + 32 * n * (options.io_calls + options.work + 1),
        handler_calls:3 * n,work:options.work * n,live_bytes:bytes.unwrap() * (width as u64),
        connection_timeout:core::time::from_millis(timeout as u64)
    });
}
fn report_info(info: ext::server_poll::ConnectionInfo, code: i32) -> bool {
    let s: ext::http_server::Stats = info.stats; let scratch: [u8;512] = [0;512]; let f: core::fmt::Formatter = core::fmt::buffer(scratch,0,512).unwrap();
    f.write_text(text("received=",9)); f.write_unsigned(s.received,core::fmt::decimal());
    f.write_text(text(" sent=",6)); f.write_unsigned(s.response_sent as u64,core::fmt::decimal());
    f.write_text(text(" response=",10)); f.write_unsigned(s.response_bytes as u64,core::fmt::decimal());
    f.write_text(text(" interim=",9)); f.write_unsigned(s.continue_sent as u64,core::fmt::decimal());
    f.write_text(text(" drain=",7)); f.write_unsigned(s.drain_received,core::fmt::decimal());
    f.write_text(text(" tail=",6)); f.write_unsigned(s.buffered_discarded as u64,core::fmt::decimal());
    f.write_text(text(" io=",4)); f.write_unsigned(s.io_calls,core::fmt::decimal());
    f.write_text(text(" cleanup=",9)); f.write_unsigned(s.cleanup_calls,core::fmt::decimal());
    f.write_text(text(" cleanup-errors=",16)); f.write_unsigned(s.cleanup_errors,core::fmt::decimal());
    f.write_text(text(" work=",6)); f.write_unsigned(s.work,core::fmt::decimal());
    f.write_text(text(" scan=",6)); f.write_unsigned(s.scan_work,core::fmt::decimal());
    f.write_text(text(" id=",4)); f.write_unsigned(info.id,core::fmt::decimal());
    f.write_text(text(" rejected=",10)); f.write_unsigned(info.rejection.is_some() as u64,core::fmt::decimal());
    f.write_text(text(" shutdown=",10)); f.write_unsigned(s.write_shutdown as u64,core::fmt::decimal());
    f.write_text(text(" eof=",5)); f.write_unsigned(s.peer_eof as u64,core::fmt::decimal());
    f.write_text(text(" closed=",8)); f.write_unsigned(s.closed as u64,core::fmt::decimal());
    f.write_text(text(" code=",6)); f.write_unsigned(code as u64,core::fmt::decimal());
    if (info.transport_calls.is_some()) { f.write_text(text(" tls=",5)); f.write_unsigned(info.transport_calls.unwrap(),core::fmt::decimal()); }
    f.write_text(text(" failed=",8)); f.write_unsigned((code != 0) as u64,core::fmt::decimal()); f.write_text(text("\n",1));
    let n = f.finish(); return n.is_ok() && write_output(core::slice::view(scratch,n.unwrap()).unwrap(),2);
}
fn report(status: i32, message: core::slice::View<u8>) -> i32 { write_output(message,2); return status; }
fn tls_error(detail: ext::openssl_tls::Error) -> i32 {
    return match (detail.cause) {
        ext::openssl_tls::Cause::AllocationFailed -> report(4,literal("https-serve: allocation failed\n",31)),
        ext::openssl_tls::Cause::Truncated -> report(3,literal("https-serve: truncated TLS stream\n",34)),
        ext::openssl_tls::Cause::InvalidLimits -> report(2,literal("https-serve: invalid TLS configuration\n",39)),
        ext::openssl_tls::Cause::Bounds -> report(2,literal("https-serve: invalid TLS configuration\n",39)),
        ext::openssl_tls::Cause::Limit -> report(2,literal("https-serve: invalid TLS configuration\n",39)),
        ext::openssl_tls::Cause::Utf8 -> report(2,literal("https-serve: invalid TLS configuration\n",39)),
        ext::openssl_tls::Cause::Nul -> report(2,literal("https-serve: invalid TLS configuration\n",39)),
        _ -> report(3,literal("https-serve: TLS operation failed\n",34))
    };
}
fn protocol_code(cause: ext::http_server::Cause) -> i32 {
    if (allocation(cause)) { return 4; }
    return match(cause) {
        ext::http_server::Cause::InvalidOptions -> 2, ext::http_server::Cause::RequestLimit -> 2, ext::http_server::Cause::RequestLineLimit -> 2, ext::http_server::Cause::RequestTargetLimit -> 2,
        ext::http_server::Cause::ResponseLimit -> 2, ext::http_server::Cause::BodyLimit -> 2, ext::http_server::Cause::DrainLimit -> 2, ext::http_server::Cause::IoLimit -> 2, ext::http_server::Cause::WorkLimit -> 2,
        ext::http_server::Cause::Http(detail) -> match(detail) { ext::http::Error::Limit(n) -> 2, _ -> 3 }, _ -> 3
    };
}
fn protocol_error(cause: ext::http_server::Cause) -> i32 {
    let code: i32 = protocol_code(cause); if (code == 4) { return report(4,literal("https-serve: allocation failed\n",31)); }
    if (code == 2) { return report(2,literal("https-serve: byte, call or work limit exceeded\n",47)); }
    return match(cause) {
        ext::http_server::Cause::Timeout -> report(3,literal("https-serve: network timeout\n",29)),
        ext::http_server::Cause::Clock(detail) -> report(3,literal("https-serve: monotonic clock failed\n",36)),
        ext::http_server::Cause::Io(detail) -> report(3,literal("https-serve: socket operation failed\n",37)),
        _ -> report(3,literal("https-serve: invalid or incomplete HTTP request\n",48))
    };
}
fn native_code(detail: ext::openssl_tls::Error) -> i32 { return match(detail.cause) {
    ext::openssl_tls::Cause::AllocationFailed -> 4,
    ext::openssl_tls::Cause::InvalidLimits -> 2, ext::openssl_tls::Cause::Bounds -> 2, ext::openssl_tls::Cause::Limit -> 2, ext::openssl_tls::Cause::Utf8 -> 2, ext::openssl_tls::Cause::Nul -> 2, _ -> 3
}; }
fn transport_code(failure: ext::https_server::Failure) -> i32 { return match(failure.cause) {
    ext::https_server::Cause::Http(detail) -> protocol_code(detail.cause), ext::https_server::Cause::Tls(detail) -> native_code(detail),
    ext::https_server::Cause::InvalidOptions -> 2, ext::https_server::Cause::TlsLimit -> 2, _ -> 3
}; }
fn service_code(cause: ext::server_poll::Cause) -> i32 { return match(cause) {
    ext::server_poll::Cause::AllocationFailed -> 4,
    ext::server_poll::Cause::Protocol(detail) -> protocol_code(detail),
    ext::server_poll::Cause::InvalidLimits -> 2, ext::server_poll::Cause::AcceptLimit -> 2, ext::server_poll::Cause::PollLimit -> 2, ext::server_poll::Cause::OperationLimit -> 2, ext::server_poll::Cause::HandlerLimit -> 2, ext::server_poll::Cause::WorkLimit -> 2, ext::server_poll::Cause::ByteLimit -> 2,
    ext::server_poll::Cause::Poll(detail) -> match(detail) { std::poll::Error::AllocationFailed -> 4, _ -> 3 }, _ -> 3
}; }
fn error_code(detail: Error) -> i32 { return match(detail) {
    Error::Arguments -> 2, Error::Limit -> 2, Error::Allocation -> 4, Error::Output -> 5,
    Error::Tls(detail) -> native_code(detail), Error::Protocol(detail) -> protocol_code(detail.cause), Error::Rejected(detail) -> protocol_code(detail.cause),
    Error::Transport(detail) -> transport_code(detail), Error::Service(detail) -> service_code(detail), _ -> 3
}; }
fn error(detail: Error) -> i32 { return match(detail) {
    Error::Arguments -> report(2,literal("https-serve: invalid arguments\n",31)),
    Error::Limit -> report(2,literal("https-serve: byte, call or work limit exceeded\n",47)),
    Error::Allocation -> report(4,literal("https-serve: allocation failed\n",31)),
    Error::Clock -> report(3,literal("https-serve: monotonic clock failed\n",36)),
    Error::Timeout -> report(3,literal("https-serve: network timeout\n",29)),
    Error::Output -> report(5,literal("https-serve: output I/O or call limit failed\n",45)),
    Error::Io(cause) -> report(3,literal("https-serve: socket operation failed\n",37)),
    Error::Tls(cause) -> tls_error(cause), Error::Protocol(detail) -> protocol_error(detail.cause), Error::Rejected(detail) -> protocol_error(detail.cause),
    Error::Transport(failure) -> match(failure.cause) { ext::https_server::Cause::Http(detail) -> protocol_error(detail.cause), ext::https_server::Cause::Tls(detail) -> tls_error(detail), ext::https_server::Cause::InvalidOptions -> error(Error::Limit), ext::https_server::Cause::TlsLimit -> error(Error::Limit), _ -> report(3,literal("https-serve: network operation failed\n",38)) },
    Error::Service(cause) -> match(cause) { ext::server_poll::Cause::Timeout -> error(Error::Timeout), ext::server_poll::Cause::Clock(detail) -> error(Error::Clock), ext::server_poll::Cause::Protocol(detail) -> protocol_error(detail), _ -> match(service_code(cause)) { 2 -> error(Error::Limit), 4 -> error(Error::Allocation), _ -> report(3,literal("https-serve: network operation failed\n",38)) } },
    _ -> report(3,literal("https-serve: invalid service state\n",35))
}; }
fn answer(reply: &ext::server_poll::Reply, status: i32, body: core::slice::View<u8>, allow: core::slice::View<u8>) -> core::result::Result<ext::server_poll::Decision,Error> {
    let now = std::clock::system_now(); if (now.is_err()) { return core::result::Err(Error::Clock); }
    let fields: [ext::http::Field;2] = [field(literal("Content-Type",12),literal("application/octet-stream",24)),field(literal("Allow",5),allow)]; let count: i32 = 1; if (!allow.is_empty()) { count = 2; }
    // Local field descriptors and request-borrowed body stay live during stage.
    let staged = reply.stage(ext::http_server::Response { status:status,reason:status_reason(status),headers:core::slice::view(fields,count).unwrap(),body:body,date:now.unwrap() });
    if (staged.is_err()) { return core::result::Err(Error::Protocol(staged.unwrap_err())); }
    return core::result::Ok(ext::server_poll::Decision::Responded);
}
pub impl ext::server_poll::Handler<Error> for Handler {
    pub fn head(&self, id: u64, peer: core::net::SocketAddr, head: ext::http_server::RequestHead, reply: &ext::server_poll::Reply) -> core::result::Result<ext::server_poll::Decision,Error> {
        if (id >= self.maximum as u64) { return core::result::Err(Error::State); }
        if (match(head.expectation) { ext::http_server::Expectation::Unsupported -> true, _ -> false }) { return answer(reply,417,literal("",0),literal("",0)); }
        let decision: ext::http_server::BodyDecision = ext::http_server::BodyDecision::Read;
        if (match(head.expectation) { ext::http_server::Expectation::Continue -> true, _ -> false }) { decision = ext::http_server::BodyDecision::ContinueThenRead; }
        return core::result::Ok(ext::server_poll::Decision::Read(decision));
    }
    pub fn request(&self, id: u64, request: ext::http_server::Request, reply: &ext::server_poll::Reply) -> core::result::Result<ext::server_poll::Decision,Error> {
        if (id >= self.maximum as u64 || reply.head().is_none()) { return core::result::Err(Error::State); }
        let head: ext::http_server::RequestHead = reply.head().unwrap(); let method = head.head.method; let path = head.target.path;
        let body = literal("",0); let allow = literal("",0); let status: i32 = 404;
        let origin: bool = match(head.target.form) { ext::http_server::TargetForm::Origin -> true, _ -> false };
        // Preserve this service's policy rejecting URI authority-like // paths.
        if (!origin || (path.len() >= 2 && path.get(0).unwrap() == 47 && path.get(1).unwrap() == 47)) { status = 421; }
        else {
            let health: bool = eq(path,"/health",7); let echo: bool = eq(path,"/echo",5);
            if (health || echo) {
                let get: bool = eq(method,"GET",3); let is_head: bool = eq(method,"HEAD",4); let post: bool = eq(method,"POST",4);
                if (health && (get || is_head)) { status = 200; if (!is_head) { body = literal("ok\n",3); } }
                else { if (echo && post) { status = 200; body = request.body; }
                    else { status = 405; if (health) { allow = literal("GET, HEAD",9); } else { allow = literal("POST",4); } }
                }
            }
        }
        return answer(reply,status,body,allow);
    }
    pub fn rejected(&self, id: u64, rejection: ext::http_server::Rejection, reply: &ext::server_poll::Reply) -> core::result::Result<ext::server_poll::Decision,Error> {
        // Retain the exact rejection as A; scheduler keeps abort/close E separate.
        return core::result::Err(Error::Rejected(rejection));
    }
}
fn outcome_info(item: ext::server_poll::Outcome<ext::https_server::Failure,Error>) -> core::option::Option<ext::server_poll::ConnectionInfo> { return match(item) {
    ext::server_poll::Outcome::Pending(info) -> core::option::Some(info), ext::server_poll::Outcome::Complete(info) -> core::option::Some(info), ext::server_poll::Outcome::Empty(info) -> core::option::Some(info),
    ext::server_poll::Outcome::Failed(value) -> core::option::Some(value.info), ext::server_poll::Outcome::HandlerFailed(value) -> core::option::Some(value.info), ext::server_poll::Outcome::InvalidDecision(value) -> core::option::Some(value.info),
    ext::server_poll::Outcome::Aborted(value) -> core::option::Some(value.info), ext::server_poll::Outcome::AcceptFailed(value) -> core::option::Some(value.info), ext::server_poll::Outcome::Taken -> core::option::None()
}; }
fn outcome_error(item: ext::server_poll::Outcome<ext::https_server::Failure,Error>) -> core::option::Option<Error> { return match(item) {
    ext::server_poll::Outcome::Complete(info) -> core::option::None(), ext::server_poll::Outcome::Empty(info) -> core::option::None(),
    ext::server_poll::Outcome::Failed(value) -> core::option::Some(Error::Transport(value.error)), ext::server_poll::Outcome::HandlerFailed(value) -> core::option::Some(value.error),
    ext::server_poll::Outcome::InvalidDecision(value) -> match(value.preparation.is_some()) { true -> core::option::Some(Error::Protocol(value.preparation.unwrap())), false -> core::option::Some(Error::State) },
    ext::server_poll::Outcome::AcceptFailed(value) -> core::option::Some(Error::Io(value.error.cause)), _ -> core::option::Some(Error::State)
}; }
fn review(outcomes: &ext::server_poll::Report<ext::https_server::Failure,Error>, reporting: bool) -> core::result::Result<i32,Error> {
    let first: core::option::Option<Error> = core::option::None(); let failed_output: bool = false; let i: i32 = 0;
    while (i < outcomes.len()) {
        let item = outcomes.get(i).unwrap(); let problem = outcome_error(item); let code: i32 = 0;
        if (problem.is_some()) { code = error_code(problem.unwrap()); if (first.is_none()) { first = problem; } }
        let info = outcome_info(item); if (reporting && (info.is_none() || !report_info(info.unwrap(),code))) { failed_output = true; } i += 1;
    }
    if (failed_output) { return core::result::Err(Error::Output); }
    if (first.is_some()) { return core::result::Err(first.unwrap()); } return core::result::Ok(0);
}
fn protocol_options(options: &Options) -> ext::http_server::Options {
    let shared: ext::http_server::Options = ext::http_server::default_options();
    shared.request_bytes = options.max_request; shared.response_bytes = options.max_response;
    shared.request.head_bytes = options.max_head; shared.request.headers = options.max_headers;
    shared.request.chunks = options.max_chunks; shared.request.trailers = 16; shared.request.body_bytes = options.max_body;
    shared.response.head_bytes = 16384; shared.response.headers = 64; shared.response.trailers = 16;
    shared.response.body_bytes = options.max_body; if (shared.response.body_bytes < 3) { shared.response.body_bytes = 3; }
    shared.io_calls = options.max_io; shared.work = options.max_work; return shared;
}
fn service(options: &Options) -> core::result::Result<i32,Error> {
    let endpoint = core::net::parse_socket(options.endpoint); if (endpoint.is_err() || options.certificate.is_empty() || options.key.is_empty()) { return core::result::Err(Error::Arguments); }
    if (options.client_ca.is_some() && options.client_ca.unwrap().is_empty()) { return core::result::Err(Error::Arguments); }
    let authentication: ext::openssl_tls::ClientAuthentication = ext::openssl_tls::ClientAuthentication::Unauthenticated;
    if (options.client_ca.is_some()) { authentication = ext::openssl_tls::ClientAuthentication::Required(ext::openssl_tls::Trust::CaFile(options.client_ca.unwrap())); }
    let created = ext::openssl_tls::new_server(options.certificate,options.key,literal("",0),authentication,ext::openssl_tls::default_limits());
    if (created.is_err()) { return core::result::Err(Error::Tls(created.unwrap_err())); } let server = created.unwrap();
    let family = match(endpoint.unwrap()) { core::net::SocketAddr::V4(v) -> std::socket::Family::Ipv4, core::net::SocketAddr::V6(v) -> std::socket::Family::Ipv6 };
    let opened = std::socket::create(family,std::socket::Kind::Tcp,true); if (opened.is_err()) { server.destroy(); return core::result::Err(Error::Io(opened.unwrap_err())); } let listener = opened.unwrap();
    let configured: core::result::Result<i32,core::io::Error> = core::result::Ok(0);
    if (match(family) { std::socket::Family::Ipv6 -> true, _ -> false }) { configured = listener.set_option(std::socket::Setting::Ipv6Only,1); }
    if (configured.is_ok()) { configured = listener.set_option(std::socket::Setting::ReuseAddress,1); }
    if (configured.is_ok()) { configured = listener.bind(endpoint.unwrap()); } if (configured.is_ok()) { configured = listener.listen(16); }
    if (configured.is_err()) { listener.close(); server.destroy(); return core::result::Err(Error::Io(configured.unwrap_err())); }
    let actual = listener.local_addr(); if (actual.is_err()) { listener.close(); server.destroy(); return core::result::Err(Error::Io(actual.unwrap_err())); }
    let startup: [u8;96] = [0;96]; let formatted = actual.unwrap().format_into(core::slice::view(startup,95).unwrap());
    if (formatted.is_err()) { listener.close(); server.destroy(); return core::result::Err(Error::Arguments); } let length = formatted.unwrap(); startup[length] = 10;
    if (!write_output(core::slice::view(startup,length+1).unwrap(),1)) { listener.close(); server.destroy(); return core::result::Err(Error::Output); }
    let shared = protocol_options(options); let computed = service_limits(shared,options.requests,options.concurrency,options.timeout);
    if (computed.is_err()) { listener.close(); server.destroy(); return core::result::Err(Error::Service(computed.unwrap_err())); }
    let now = std::clock::monotonic_now(); if (now.is_err()) { listener.close(); server.destroy(); return core::result::Err(Error::Clock); }
    let shifted = core::time::deadline_after(now.unwrap(),core::time::from_millis(options.service_timeout as u64)); if (shifted.is_err()) { listener.close(); server.destroy(); return core::result::Err(Error::Clock); }
    let handler: Handler = Handler { maximum:options.requests }; let tls: ext::https_server::Options = ext::https_server::Options { tls_calls:options.max_tls };
    let served: core::result::Result<ext::server_poll::Report<ext::https_server::Failure,Error>,ext::server_poll::ServiceFailure<ext::https_server::Failure,Error>> = ext::https_server_poll::serve_until<Handler,Error>(listener.borrow(),server.borrow(),handler.borrow(),shared,tls,computed.unwrap(),shifted.unwrap());
    let primary: core::option::Option<Error> = core::option::None(); if (served.is_err()) { primary = core::option::Some(Error::Service(served.unwrap_err().cause)); }
    let outcomes: ext::server_poll::Report<ext::https_server::Failure,Error> = match(served) { core::result::Ok(value) -> value, core::result::Err(value) -> value.report };
    let inspected: core::result::Result<i32,Error> = review(outcomes.borrow(),options.report); outcomes.destroy();
    let closed = listener.close(); server.destroy();
    if (inspected.is_err() && error_code(inspected.unwrap_err()) == 5) { return inspected; }
    if (primary.is_some()) { return core::result::Err(primary.unwrap()); }
    if (inspected.is_err()) { return inspected; }
    if (closed.is_err()) { return core::result::Err(Error::Io(closed.unwrap_err())); } return core::result::Ok(0);
}
fn apply(options: &Options, item: ext::cli::Occurrence) -> bool {
    if (item.id == 1) { options.help = true; return true; } if (item.id == 2) { options.report = true; return true; }
