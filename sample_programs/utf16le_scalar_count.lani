// Count Unicode scalars in at most 128 UTF-16LE bytes from stdin. Empty input
// prints zero. Odd byte counts, malformed UTF-16, and oversized input fail.
module app::main;
import core::utf16_bytes;
import std::io;
import std::io_byte;
import std::io_decimal;

fn main() -> i32 {
    let zero: u8 = 0;
    let bytes: [u8; 128] = [
        zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero,
        zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero,
        zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero,
        zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero,
        zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero,
        zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero,
        zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero,
        zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero, zero
    ];
    let length: i32 = 0;
    while (true) {
        let code: i32 = std::io_byte::read_stdin_byte_or(-1, -2);
        if (code == -1) { break; }
        if (code == -2) { return 2; }
        if (length >= 128) { return 3; }
        let byte: u8 = code as u8;
        bytes[length] = byte;
        length += 1;
    }
    let count: i32 = core::utf16_bytes::scalar_count_or_le(bytes, length, -1);
    if (count < 0) { return 3; }
    if (std::io_decimal::write_i32(1, count) < 0 ||
        std::io::write_byte(1, 10) != 1) { return 4; }
    return 0;
}
