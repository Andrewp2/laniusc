// Read decimal u16 lines and print the three most recent values in input order.
// Exit 2 for empty/overlong input, 3 for malformed/out-of-range input,
// 4 for allocation failure, and 5 for signal setup/output failure.
module app::main;
import alloc::deque;
import core::decimal;
import core::result;
import std::io_byte;
import std::io_decimal;
import std::io_line;
import std::signal;

fn main() -> i32 {
    if (std::signal::set_disposition(std::signal::Signal::BrokenPipe,std::signal::Disposition::Ignore).is_err()) { return 5; }
    let line: [i32;20] = [0;20]; let packed: [u8;20] = [0;20];
    let recent: alloc::deque::Deque<u16> = alloc::deque::new();
    while (true) {
        let length: i32 = std::io_line::read_stdin_lf_line_into_i32(line,20);
        if (length == -1) { break; }
        if (length <= 0) { recent.destroy(); return 2; }
        let index: i32 = 0; while (index < length) { packed[index] = line[index] as u8; index += 1; }
        let parsed: core::result::Result<u16,core::decimal::ParseError> = core::decimal::parse_u16(packed,length);
        if (core::result::is_err(parsed)) { recent.destroy(); return 3; }
        if (recent.len() == 3) { recent.pop_front(); }
        if (core::result::is_err(recent.try_push_back(core::result::unwrap(parsed)))) { recent.destroy(); return 4; }
    }
    let index: i32 = 0;
    while (index < recent.len()) {
        if (index > 0 && !std::io_byte::write_stdout_byte(32)) { recent.destroy(); return 5; }
        if (std::io_decimal::write_u64(1,recent.get_or(index,0) as u64) <= 0) { recent.destroy(); return 5; }
        index += 1;
    }
    if (!std::io_byte::write_stdout_byte(10)) { recent.destroy(); return 5; }
    recent.destroy(); return 0;
}
