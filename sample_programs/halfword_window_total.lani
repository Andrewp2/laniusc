module app::main;
import core::slice_u16;
import core::range_u16;
import core::number_u16;
import core::option_u16;
import core::result_u16;

fn first_in_band(values: [u16], len: i32, band: core::range_u16::RangeInclusiveU16) -> core::option_u16::OptionU16 {
    let index: i32 = 0;
    while (index < len) {
        let value: u16 = core::slice_u16::get_or(values, len, index, 0);
        if (core::range_u16::contains_inclusive(band, value)) {
            return core::option_u16::some(value);
        }
        index += 1;
    }
    return core::option_u16::none();
}

fn main() -> i32 {
    let two: u16 = 2;
    let four: u16 = 4;
    let seven: u16 = 7;
    let high: u16 = 32768;
    let maximum: u16 = 65535;
    let readings: [u16; 6] = [maximum, seven, high, four, seven, two];
    if (core::slice_u16::sort(readings, 6) != 6) { return 1; }

    let band: core::range_u16::RangeInclusiveU16 = core::range_u16::range_inclusive(four, high);
    let first: core::option_u16::OptionU16 = first_in_band(readings, 6, band);
    let chosen: core::result_u16::ResultU16 = core::option_u16::ok_or(first, maximum);
    if (!core::result_u16::contains(chosen, four)) { return 2; }

    let total: u16 = 0;
    let index: i32 = 0;
    while (index < 6) {
        let value: u16 = core::slice_u16::get_or(readings, 6, index, 0);
        if (core::range_u16::contains_inclusive(band, value)) {
            total = core::number_u16::saturating_add(total, value);
        }
        index += 1;
    }
    if (total != 32786) { return 3; }
    print(total);
    return 0;
}
