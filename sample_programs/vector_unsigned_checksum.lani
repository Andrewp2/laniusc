module app::main;
import alloc::vec;
import core::decimal;
import core::io;
import core::option;
import core::u32;
import std::signal;
import std::stream;

// Format into caller storage, then deliver digits and LF through the shared
// complete-write loop. Errors may leave a prefix; Interrupted is retried.
fn write_i32_line(value: i32) -> bool {
    let bytes: [u8; 12] = [0;12];
    let formatted = core::decimal::format_i32(bytes,0,11,value);
    if (formatted.is_err()) { return false; }
    let length: i32 = formatted.unwrap(); bytes[length] = 10;
    let sink = std::stream::stdout();
    return core::io::write_all(sink.borrow(),bytes,0,length+1).is_ok();
}

fn main() -> i32 {
    if (std::signal::set_disposition(std::signal::Signal::BrokenPipe,std::signal::Disposition::Ignore).is_err()) { return 3; }
    let values: alloc::vec::Vec<u32> = alloc::vec::new();
    if (values.try_push(4294967295).is_err()) { values.destroy(); return 1; }
    if (values.try_push(2).is_err()) { values.destroy(); return 1; }
    if (values.try_push(3).is_err()) { values.destroy(); return 1; }

    let checksum: u32 = 0;
    let index: i32 = 0;
    while (index < values.len()) {
        let item: u32 = values.at(index);
        checksum = core::u32::wrapping_add(checksum, item);
        index += 1;
    }
    values.destroy();
    let result: core::option::Option<u32> = core::option::Some(checksum);
    let unsigned_result: u32 = core::option::unwrap_or(result, 0);
    let printable: i32 = unsigned_result as i32;
    if (!write_i32_line(printable)) { return 3; }
    return 0;
}
