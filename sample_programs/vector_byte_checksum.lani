module app::main;
import alloc::vec;
import core::byte;
import core::option;
import core::result;
import std::io_byte;
import std::io_decimal;

fn main() -> i32 {
    let values: alloc::vec::Vec<u8> = alloc::vec::new();
    if (core::result::is_err(values.try_push(255)) || core::result::is_err(values.try_push(2)) ||
        core::result::is_err(values.try_push(3))) { values.destroy(); return 1; }
    let checksum: u8 = 0;
    let index: i32 = 0;
    while (index < values.len()) {
        checksum = core::byte::wrapping_add(checksum, values.at(index));
        index += 1;
    }
    values.destroy();
    let result: core::option::Option<u8> = core::option::Some(checksum);
    let byte_result: u8 = core::option::unwrap_or(result, 0);
    if (std::io_decimal::write_u32(1, byte_result as u32) < 0 || !std::io_byte::write_stdout_byte(10)) { return 2; }
    return 0;
}
