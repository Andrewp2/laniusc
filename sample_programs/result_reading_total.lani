module app::main;
import core::result;
import core::range;
import core::number_i32;
import std::io;

fn checked_total(readings: [i32]) -> core::result::Result<i32, i32> {
    let allowed: core::range::Range<i32> = core::range::range_i32(0, 101);
    let total: i32 = 0;
    for reading in readings {
        if (!core::range::contains_i32(allowed, reading)) {
            let failure: core::result::Result<i32, i32> = core::result::Err(reading);
            return failure;
        }
        total = core::number_i32::saturating_add(total, reading);
    }
    let success: core::result::Result<i32, i32> = core::result::Ok(total);
    return success;
}

fn main() -> i32 {
    let valid: [i32; 3] = [0, 7, 13];
    let invalid: [i32; 3] = [7, -2, 13];
    let success: core::result::Result<i32, i32> = checked_total(valid);
    let failure: core::result::Result<i32, i32> = checked_total(invalid);
    if (!success.is_ok() || !core::result::contains_i32(success, 20)) { return 1; }
    if (!failure.is_err() || !core::result::contains_err_i32(failure, -2)) { return 2; }
    let total: i32 = success.unwrap_or(-1);
    let rejected: i32 = failure.unwrap_err_or(0);
    std::io::print_i32(total);
    std::io::print_i32(rejected);
    return 0;
}
