module app::main;
import core::number_i32;
import core::option;
import core::result;
import core::slice;

fn main() -> i32 {
    let readings: [bool; 3] = [true, false, true];
    let window: [bool; 5] = [false, false, false, false, false];
    if (!core::slice::copy_nonoverlapping_prefix(window, 5, readings, 3)) { return 1; }
    if (!core::slice::set(window, 5, 3, true)) { return 2; }
    if (core::slice::reverse_in_place(window, 5) != 2) { return 3; }

    let first: core::option::Option<bool> =
        core::option::Some(core::slice::get_or(window, 5, 0, true));
    if (!core::option::is_some(first) || core::option::is_none(first)) { return 5; }
    let checked: core::result::Result<bool, bool> = first.ok_or(true);
    if (!core::result::contains(checked, false)) { return 4; }

    let total: i32 = 0;
    let index: i32 = 0;
    while (index < 5) {
        if (core::slice::get_or(window, 5, index, false)) {
            total = core::number_i32::saturating_add(total, 1);
        }
        index += 1;
    }
    let checksum: core::option::Option<i32> = core::option::Some(total);
    print(core::option::unwrap_or(checksum, -1));
    return 0;
}
