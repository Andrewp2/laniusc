// Report the smallest signed byte with the highest frequency, then its count.
// A caller-owned table covers all 256 values. Read, overflow and output errors fail.
module app::main;
import std::io;
import std::io_byte;
import std::io_decimal;

fn main() -> i32 {
    let values: [u32; 256] = [0; 256];
    let distinct: u32 = 0;
    while (true) {
        let code: i32 = std::io_byte::read_stdin_byte_or(-1, -2);
        if (code == -1) { break; }
        if (code == -2) { return 2; }
        let key: i32 = code;
        if (code >= 128) { key = code - 256; }
        let old: u32 = values[(key + 128)];
        if (old == 4294967295) { return 3; }
        if (old == 0) { distinct += 1; }
        values[(key + 128)] = old + 1;
    }
    let best_key: i32 = -129;
    let best_count: u32 = 0;
    let key: i32 = -128;
    while (key < 128) {
        let count: u32 = values[(key + 128)];
        if (count > best_count) { best_key = key; best_count = count; }
        key += 1;
    }
    if (std::io_decimal::write_i32(1, best_key) < 0 || std::io::write_byte(1, 10) != 1 ||
        std::io_decimal::write_u32(1, best_count) < 0 || std::io::write_byte(1, 10) != 1 ||
        std::io_decimal::write_u32(1, distinct) < 0 || std::io::write_byte(1, 10) != 1) { return 4; }
    return 0;
}
