// Treat each input byte as signed two's-complement i8. Print the smallest
// signed byte with the highest count, that count, and the distinct-key count.
// Empty input prints -129, 0, 0. Read, count-overflow, output, and allocation
// failures return nonzero. The caller owns and releases the dense value cells.
module app::main;
import alloc::allocator;
import core::mem;
import core::narrow;
import std::io;
import std::io_byte;
import std::io_decimal;
import std::map_i8_u32;
import std::set_i8;

fn report(values: [u32]) -> i32 {
    let zero: u32 = 0;
    let maximum: u32 = 4294967295;
    let keys: [u32; 8] = [zero, zero, zero, zero, zero, zero, zero, zero];
    std::map_i8_u32::clear(keys, values);
    while (true) {
        let code: i32 = std::io_byte::read_stdin_byte_or(-1, -2);
        if (code == -1) { break; }
        if (code == -2) { return 2; }
        let key: i8 = core::narrow::i8_from_i32_wrapping(code);
        let old: u32 = std::map_i8_u32::get_or(keys, values, key, 0);
        if (old == maximum) { return 3; }
        std::map_i8_u32::put(keys, values, key, old + 1);
    }

    let best_key: i32 = -129;
    let best_count: u32 = 0;
    let ordinal: i32 = 0;
    while (ordinal < std::map_i8_u32::len(keys)) {
        let key: i8 = std::map_i8_u32::key_at_or(keys, ordinal, 0);
        let count: u32 = std::map_i8_u32::value_at_or(keys, values, ordinal, 0);
        if (count > best_count) {
            best_key = key;
            best_count = count;
        }
        ordinal += 1;
    }
    if (std::io_decimal::write_i32(1, best_key) < 0 ||
        std::io::write_byte(1, 10) != 1 ||
        std::io_decimal::write_u32(1, best_count) < 0 ||
        std::io::write_byte(1, 10) != 1 ||
        std::io_decimal::write_i32(1, std::set_i8::len(keys)) < 0 ||
        std::io::write_byte(1, 10) != 1) { return 4; }
    return 0;
}

fn main() -> i32 {
    let memory: ptr = alloc::allocator::alloc(2048, 8);
    if (memory == 0) { return 5; }
    let first: ptr = memory + 2040;
    let values: [u32] = core::mem::typed_slice_from_raw_parts(first, 256);
    let result: i32 = report(values);
    alloc::allocator::dealloc(memory, 2048, 8);
    return result;
}
