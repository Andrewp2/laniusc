// Summarize a borrowed view, returning absence for empty or invalid input.
module app::main;
import core::option;
import core::mem;
import core::range;
import core::number_i32;

struct Summary { count: i32, total: i32 }

fn summarize(values: [i32]) -> core::option::Option<Summary> {
    let absent: core::option::Option<Summary> = core::option::None();
    let allowed: core::range::Range<i32> = core::range::range_i32(-100, 101);
    let count: i32 = 0;
    let total: i32 = 0;
    for value in values {
        if (!core::range::contains_i32(allowed, value)) { return absent; }
        total = core::number_i32::saturating_add(total, value);
        count = count + 1;
    }
    if (count == 0) { return absent; }
    let summary: Summary = Summary { count: count, total: total };
    let present: core::option::Option<Summary> = core::option::Some(summary);
    return present;
}

fn main() -> i32 {
    let backing: [i32; 4] = [7, -2, 11, 4];
    let data: ptr = core::mem::i32_array_data_ptr(backing);
    let values: [i32] = core::mem::i32_slice_from_raw_parts(data, 4);
    let empty: [i32] = core::mem::i32_slice_from_raw_parts(data, 0);
    let optional: core::option::Option<Summary> = summarize(values);
    if (!optional.is_some() || !summarize(empty).is_none()) { return 1; }
    let fallback: Summary = Summary { count: 0, total: 0 };
    let summary: Summary = match (optional) {
        core::option::Some(inner) -> inner,
        core::option::None -> fallback,
    };
    if (summary.count != 4 || summary.total != 20) { return 2; }
    values[2] = 101;
    if (!summarize(values).is_none()) { return 3; }
    print(summary.count);
    print(summary.total);
    return 0;
}
