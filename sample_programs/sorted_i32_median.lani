// Read decimal i32 lines, then print the upper median and its frequency.
// Exit 2 for empty/overlong input, 3 for malformed/out-of-range input,
// 4 for allocation failure, and 5 for signal setup/output failure.
module app::main;
import alloc::vec;
import core::decimal;
import core::result;
import std::io_byte;
import std::io_decimal;
import std::io_line;
import std::signal;

fn main() -> i32 {
    if (std::signal::set_disposition(std::signal::Signal::BrokenPipe,std::signal::Disposition::Ignore).is_err()) { return 5; }
    let line: [i32;20] = [0;20]; let packed: [u8;20] = [0;20];
    let values: alloc::vec::Vec<i32> = alloc::vec::new();
    while (true) {
        let length: i32 = std::io_line::read_stdin_lf_line_into_i32(line,20);
        if (length == -1) { break; }
        if (length <= 0) { values.destroy(); return 2; }
        let index: i32 = 0; while (index < length) { packed[index] = line[index] as u8; index += 1; }
        let parsed: core::result::Result<i32,core::decimal::ParseError> = core::decimal::parse_i32(packed,length);
        if (core::result::is_err(parsed)) { values.destroy(); return 3; }
        if (core::result::is_err(values.try_push(core::result::unwrap(parsed)))) { values.destroy(); return 4; }
    }
    if (values.len() == 0) { values.destroy(); return 2; }
    values.sort();
    let median: i32 = values.at(values.len()/2);
    let first: i32 = values.lower_bound(median); let after: i32 = values.upper_bound(median);
    if (std::io_decimal::write_i32(1,median) <= 0 || !std::io_byte::write_stdout_byte(32) ||
        std::io_decimal::write_i32(1,after-first) <= 0 || !std::io_byte::write_stdout_byte(10)) { values.destroy(); return 5; }
    values.destroy(); return 0;
}
