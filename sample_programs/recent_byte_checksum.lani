// Read arbitrary bytes and print the wrapping sum of the last three.
module app::main;
import core::u8;
import core::option;
import alloc::deque;
import core::result;
import std::io_byte;

fn main() -> i32 {
    let recent: alloc::deque::Deque<u8> = alloc::deque::new();
    let next: i32 = std::io_byte::read_stdin_byte_or(-1, -2);
    while (next >= 0) {
        let next_byte: u8 = next as u8;
        let added: core::result::Result<i32, alloc::deque::Error> = recent.try_push_back(next_byte);
        if (core::result::is_err(added)) {
            recent.destroy();
            return 2;
        }
        if (recent.len() > 3) {
            recent.pop_front();
        }
        next = std::io_byte::read_stdin_byte_or(-1, -2);
    }
    if (next != -1) {
        recent.destroy();
        return 3;
    }
    let checksum: u8 = 0;
    let index: i32 = 0;
    while (index < recent.len()) {
        checksum = core::u8::wrapping_add(
            checksum, recent.get_or(index, 0));
        index += 1;
    }
    recent.destroy();
    let wrapped: core::option::Option<u8> = core::option::Some(checksum);
    let result: u8 = core::option::unwrap_or(wrapped, 0);
    let printable: i32 = result as i32;
    print(printable);
    return 0;
}
