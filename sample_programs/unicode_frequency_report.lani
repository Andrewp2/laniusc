// Count UTF-8 stdin scalars and print <scalar>:<count> in first-seen order.
// Return 2 for malformed UTF-8, 3 for input failure, 4 for allocation or
// capacity failure, 5 for output failure, and 6 for count overflow.
module app::main;
import alloc::hash_map;
import alloc::vec;
import core::char;
import core::option;
import core::result;
import std::io_byte;
import std::io_decimal;
import std::io_utf8;

fn main() -> i32 {
    let counts: alloc::hash_map::HashMap<char, u32> = alloc::hash_map::new();
    let order: alloc::vec::Vec<char> = alloc::vec::new();
    while (true) {
        let code: u32 = std::io_utf8::read_stdin_scalar_or(1114112, 1114113, 1114114);
        if (code == 1114112) { break; }
        if (code == 1114113) { counts.destroy(); order.destroy(); return 2; }
        if (code == 1114114) { counts.destroy(); order.destroy(); return 3; }
        let scalar: char = core::char::from_u32_or(code, '\0');
        let prior: u32 = core::option::unwrap_or(counts.get(scalar), 0);
        if (prior == 4294967295) { counts.destroy(); order.destroy(); return 6; }
        if (!counts.contains_key(scalar)) {
            if (core::result::is_err(order.try_push(scalar))) { counts.destroy(); order.destroy(); return 4; }
        }
        if (core::result::is_err(counts.try_insert(scalar, prior + 1))) { counts.destroy(); order.destroy(); return 4; }
    }
    let index: i32 = 0;
    while (index < order.len()) {
        let scalar: char = order.at(index);
        let count: u32 = core::option::unwrap(counts.get(scalar));
        if (!std::io_utf8::write_stdout_scalar(scalar as u32) ||
            !std::io_byte::write_stdout_byte(58) || std::io_decimal::write_u32(1, count) < 0 ||
            !std::io_byte::write_stdout_byte(10)) { counts.destroy(); order.destroy(); return 5; }
        index += 1;
    }
    counts.destroy(); order.destroy(); return 0;
}
