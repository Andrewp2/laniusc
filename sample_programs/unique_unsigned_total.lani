// Count distinct unsigned readings and print their wrapping checksum.
module app::main;
import core::number_u32;
import std::io;
import std::io_decimal;
import std::set_u32;

fn main() -> i32 {
    let first: u32 = 0;
    let high: u32 = 2147483648;
    let one: u32 = 1;
    let last: u32 = 4294967295;
    let readings: [u32; 5] = [first, high, one, high, last];
    let distinct: std::set_u32::SetU32 = std::set_u32::new();
    let index: i32 = 0;
    while (index < 5) {
        let reading: u32 = readings[index];
        distinct = std::set_u32::try_insert(distinct, reading);
        index += 1;
    }
    if (std::set_u32::len(distinct) != 4) {
        std::set_u32::destroy(distinct);
        return 1;
    }
    let total: u32 = 0;
    index = 0;
    while (index < std::set_u32::len(distinct)) {
        total = core::number_u32::wrapping_add(total, std::set_u32::at_or(distinct, index, 0));
        index += 1;
    }
    std::set_u32::destroy(distinct);
    if (std::io_decimal::write_u32(1, total) < 0) {
        return 2;
    }
    if (std::io::write_byte(1, 10) != 1) {
        return 3;
    }
    return 0;
}
