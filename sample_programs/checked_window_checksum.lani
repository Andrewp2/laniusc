module app::main;
import core::byte;
import core::mem;
import core::number_i32;
import core::option;
import core::range;
import core::result;
import core::slice;

fn decode(marker: u8, readings: [i32; 4]) -> core::result::Result<[i32; 4], i32> {
    if (!core::byte::is_ascii_hexdigit(marker)) { return core::result::Err(1); }
    return core::result::Ok(readings);
}

fn main() -> i32 {
    let packet: core::option::Option<[i32; 4]> = core::option::Some([18, 42, 24, 30]);
    let readings: [i32; 4] = packet.unwrap_or([0, 0, 0, 0]);
    let decoded: core::result::Result<[i32; 4], i32> = decode(70, readings);
    if (decoded.is_err()) { return decoded.unwrap_err_or(1); }
    let sorted: [i32; 4] = decoded.unwrap_or([0, 0, 0, 0]);
    readings[0] = -100;
    let view: [i32] = core::mem::i32_slice_from_raw_parts(core::mem::i32_array_data_ptr(sorted), 4);
    if (core::slice::sort_i32(view, 4) != 4) { return 2; }
    let first: i32 = core::slice::lower_bound_i32(view, 4, 24);
    let end: i32 = core::slice::upper_bound_i32(view, 4, 42);
    let window: core::range::Range<i32> = core::range::range_i32(first, end);
    let index: i32 = 0;
    let checksum: i32 = 0;
    while (index < 4) {
        if (core::range::contains_i32(window, index)) {
            checksum = core::number_i32::saturating_add(checksum,
                core::slice::get_or(view, 4, index, 0));
        }
        index += 1;
    }
    let rejected: core::result::Result<[i32; 4], i32> = decode(71, readings);
    if (!rejected.is_err() || rejected.unwrap_err_or(0) != 1) { return 3; }
    let absent: core::option::Option<[i32; 4]> = core::option::None();
    let fallback: [i32; 4] = absent.unwrap_or([7, 0, 0, 0]);
    let original: [i32; 4] = packet.unwrap_or([0, 0, 0, 0]);
    if (fallback[0] != 7 || original[0] != 18 || checksum != 96) { return 4; }
    print(checksum);
    return 0;
}
