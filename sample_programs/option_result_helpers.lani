module app::main;

import core::option;
import core::result;

fn main() {
    let some: core::option::Option<i32> = core::option::Some(7);
    let none: core::option::Option<i32> = core::option::None();
    let successful: core::result::Result<i32, i32> = core::result::Ok(9);
    let failed: core::result::Result<i32, i32> = core::result::Err(4);

    let total: i32 = 0;
    if (some.is_some()) {
        total += some.unwrap_or(0);
    }
    if (none.is_none()) {
        total += none.unwrap_or(5);
    }
    if (successful.is_ok()) {
        total += successful.unwrap_or(0);
    }
    if (failed.is_err()) {
        total += failed.unwrap_or(6);
    }
    total += none.or(core::option::Some(11)).unwrap_or(0);

    print(total);
    return 0;
}
