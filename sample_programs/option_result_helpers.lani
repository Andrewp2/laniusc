module app::main;

import core::option_i32;
import core::result_i32;

fn main() {
    let some: core::option_i32::OptionI32 = core::option_i32::some(7);
    let none: core::option_i32::OptionI32 = core::option_i32::none();
    let successful: core::result_i32::ResultI32 = core::result_i32::ok(9);
    let failed: core::result_i32::ResultI32 = core::result_i32::err(4);

    let total: i32 = 0;
    if (core::option_i32::is_some(some)) {
        total += core::option_i32::unwrap_or(some, 0);
    }
    if (core::option_i32::is_none(none)) {
        total += core::option_i32::unwrap_or(none, 5);
    }
    if (core::result_i32::is_ok(successful)) {
        total += core::result_i32::unwrap_or(successful, 0);
    }
    if (core::result_i32::is_err(failed)) {
        total += core::result_i32::unwrap_or(failed, 6);
    }
    let chosen: core::option_i32::OptionI32 = core::option_i32::or(none, core::option_i32::some(11));
    total += core::option_i32::unwrap_or(chosen, 0);

    print(total);
    return 0;
}
