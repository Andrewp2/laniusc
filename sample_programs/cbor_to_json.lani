// cbor-to-json: stream one CBOR item (or with --seq a CBOR sequence) from
// stdin and print it as compact JSON, one document per line, following
// RFC 8949 section 6.1: integers and floats become numbers (shortest
// round-trip spelling), non-finite floats, null, undefined and other simple
// values become null, byte strings become unpadded base64url strings, tags
// are dropped in favour of their content, and indefinite strings are joined.
// Map keys must be text or integers (integers become decimal strings).
// --deterministic also rejects input that is not core deterministic CBOR.
// Limits: depth 512, 16 MiB per string, 64 MiB of input; no item count limit.
// Exit 0 ok, 1 usage, 2 invalid or unsupported CBOR, 3 I/O, 4 out of memory.
module app::main;
import alloc::vec;
import core::f64;
import core::float_decimal;
import core::io;
import core::option;
import core::result;
import core::slice;
import core::text;
import ext::cbor;
import ext::cbor_stream;
import ext::json_stream;
import std::args;
import std::signal;
import std::stream;

// Frame kinds: 1 array, 2 map, 3 tag, 4 chunked bytes, 5 chunked text.
// The innermost frame is cached in fields: `kind` (0 at the root), and for
// the nearest frame that is not a tag, `container` and `key` (1 when that
// map expects a key). `stack` keeps one packed byte per enclosing frame in
// its first depth bytes; `saved` caches stack.as_slice().
struct Convert {
    out: ext::json_stream::Writer, stack: alloc::vec::Vec<u8>, saved: [u8], depth: i32, kind: u8, container: u8, key: u8,
    chunks: alloc::vec::Vec<u8>, text: alloc::vec::Vec<u8>,
    // Views of main's float scratch and 40-byte number buffer.
    scratch: core::slice::View<u32>, number: core::slice::View<u8>,
    failure: i32, at: u64,
}

fn base64_digit(value: u8) -> u8 {
    if (value < 26) { return value + 65; }
    if (value < 52) { return value + 71; }
    if (value < 62) { return value - 4; }
    if (value == 62) { return 45; }
    return 95;
}

impl Convert {
    fn borrow(&self) -> &Convert { return self; }
    fn at_key(&self) -> bool { return self.key == 1; }
    // A complete value or key was written in the enclosing container.
    fn completed(&self) { if (self.container == 2) { self.key = 1 - self.key; } }
    fn wrote(&self, result: core::result::Result<i32, ext::json_stream::Error>) -> bool {
        if (result.is_err()) {
            self.failure = 2;
            let kind: ext::json_stream::ErrorKind = result.unwrap_err().kind;
            let memory: bool = match (kind) { ext::json_stream::ErrorKind::AllocationFailed -> true, _ -> false };
            if (memory) { self.failure = 4; }
            return false;
        }
        return true;
    }
    // A key or string from bytes[start, start+length); the writer's fast
    // forms first, and the Result forms when those decline.
    fn emit(&self, bytes: [u8], start: i32, length: i32, key: bool) -> bool {
        if (key) { return self.out.fast_key(bytes, start, length) || self.wrote(self.out.key(core::text::from_utf8_unchecked(bytes, start, length))); }
        return self.out.fast_string(bytes, start, length) || self.wrote(self.out.string(core::text::from_utf8_unchecked(bytes, start, length)));
    }
    fn plain_number(&self, bytes: [u8], start: i32, length: i32) -> bool {
        return self.out.fast_number_unchecked(bytes, start, length) || self.wrote(self.out.number_unchecked(core::text::from_utf8_unchecked(bytes, start, length)));
    }
    fn null(&self) -> bool { return self.out.fast_null() || self.wrote(self.out.null()); }
    // Integers: n, or -1 - n when negative, as decimal digits in `number`.
    fn integer(&self, value: u64, negative: bool) -> bool {
        let digits: [u8] = self.number.values; let low: i32 = 40;
        if (value == 0) { low -= 1; digits[low] = 48; }
        while (value > 0) { low -= 1; let next: u64 = value / 10; digits[low] = ((value - next * 10) as u8) + 48; value = next; }
        if (negative) {
            // -1 - n: add one to the decimal digits of n.
            let index: i32 = 39; let carry: bool = true;
            while (carry && index >= low) {
                if (digits[index] == 57) { digits[index] = 48; index -= 1; } else { digits[index] += 1; carry = false; }
            }
            if (carry) { low -= 1; digits[low] = 49; }
            low -= 1; digits[low] = 45;
        }
        let ok: bool = true;
        if (self.key == 1) { ok = self.emit(digits, low, 40 - low, true); } else { ok = self.plain_number(digits, low, 40 - low); }
        if (ok) { self.completed(); }
        return ok;
    }
    fn base64(&self, data: core::slice::View<u8>) -> bool {
        let full: i32 = data.length / 3; let rest: i32 = data.length - full * 3;
        let size: i32 = full * 4; if (rest > 0) { size += rest + 1; }
        if (self.text.try_resize(size, 0).is_err()) { self.failure = 4; return false; }
        let target: [u8] = self.text.as_slice(); let source: [u8] = data.values;
        let index: i32 = 0; let from: i32 = data.start; let to: i32 = 0;
        while (index < full) {
            let a: u8 = source[from]; let b: u8 = source[from + 1]; let c: u8 = source[from + 2];
            target[to] = base64_digit(a >> 2); target[to + 1] = base64_digit(((a & 3) << 4) | (b >> 4));
            target[to + 2] = base64_digit(((b & 15) << 2) | (c >> 6)); target[to + 3] = base64_digit(c & 63);
            index += 1; from += 3; to += 4;
        }
        if (rest == 1) {
            let a: u8 = source[from];
            target[to] = base64_digit(a >> 2); target[to + 1] = base64_digit((a & 3) << 4);
        }
        if (rest == 2) {
            let a: u8 = source[from]; let b: u8 = source[from + 1];
            target[to] = base64_digit(a >> 2); target[to + 1] = base64_digit(((a & 3) << 4) | (b >> 4)); target[to + 2] = base64_digit((b & 15) << 2);
        }
        return true;
    }
    fn string(&self, data: core::slice::View<u8>, text: bool, key: bool) -> bool {
        let ok: bool = true;
        if (text) { ok = self.emit(data.values, data.start, data.length, key); }
        else { if (!self.base64(data)) { return false; } ok = self.emit(self.text.as_slice(), 0, self.text.len(), key); }
        if (ok) { self.completed(); }
        return ok;
    }
    fn float(&self, bits: u64) -> bool {
        let ok: bool = true;
        if (((bits >> 52) & 2047) == 2047) { ok = self.null(); }
        else {
            if (self.out.fast_f64(core::f64::from_bits(bits), self.scratch)) { self.completed(); return true; }
            let written = core::float_decimal::format_f64_into(core::f64::from_bits(bits), self.number, self.scratch, core::float_decimal::default_format_work());
            if (written.is_err()) { self.failure = 4; return false; }
            ok = self.plain_number(self.number.values, 0, written.unwrap());
        }
        if (ok) { self.completed(); }
        return ok;
    }
    fn simple(&self, value: u8) -> bool {
        let ok: bool = true;
        if (value == 20 || value == 21) { ok = self.wrote(self.out.boolean(value == 21)); } else { ok = self.null(); }
        if (ok) { self.completed(); }
        return ok;
    }
    fn unsupported(&self, at: u64) -> bool { self.failure = 5; self.at = at; return false; }
    // True (after recording UnsupportedKey) when an item that cannot be a
    // JSON key sits at a key position.
    fn rejected(&self, key: bool, at: u64) -> bool { if (key) { self.unsupported(at); } return key; }
    fn open(&self, kind: u8) -> bool {
        if (self.depth == self.stack.len()) {
            let grown: i32 = 16; if (self.depth >= 8) { grown = self.depth * 2; }
            if (self.stack.try_resize(grown, 0).is_err()) { self.failure = 4; return false; }
            self.saved = self.stack.as_slice();
        }
        self.saved[self.depth] = self.kind | (self.container << 3) | (self.key << 6);
        self.depth += 1; self.kind = kind;
        if (kind != 3) { self.container = kind; self.key = 0; if (kind == 2) { self.key = 1; } }
        return true;
    }
    fn array(&self) -> bool { if (!self.out.fast_begin_array() && !self.wrote(self.out.begin_array())) { return false; } return self.open(1); }
    fn object(&self) -> bool { if (!self.out.fast_begin_object() && !self.wrote(self.out.begin_object())) { return false; } return self.open(2); }
    fn chunked(&self, kind: u8) -> bool { self.chunks.clear(); return self.open(kind); }
    fn close(&self) -> bool {
        let kind: u8 = self.kind;
        self.depth -= 1;
        let packed: u8 = self.saved[self.depth]; self.kind = packed & 7;
        // A tag leaves its container's key state to its content.
        if (kind == 3) { return true; }
        self.container = (packed >> 3) & 7; self.key = packed >> 6;
        let ok: bool = true;
        if (kind == 1) { ok = self.out.fast_end_array() || self.wrote(self.out.end_array()); }
        if (kind == 2) { ok = self.out.fast_end_object() || self.wrote(self.out.end_object()); }
        if (kind == 4 || kind == 5) {
            let joined: core::slice::View<u8> = self.chunks.as_view();
            ok = self.string(joined, kind == 5, self.key == 1);
            self.chunks.clear();
            return ok;
        }
        if (ok) { self.completed(); }
        return ok;
    }
    fn handle(&self, event: ext::cbor::Event, at: u64) -> bool {
        if (self.kind >= 4) {
            let piece: core::slice::View<u8> = match (event) {
                ext::cbor::Event::Bytes(n) -> n, ext::cbor::Event::Text(n) -> n, _ -> core::slice::View { values: self.number.values, start: 0, length: 0 },
            };
            let closing: bool = match (event) { ext::cbor::Event::End -> true, _ -> false };
            if (closing) { return self.close(); }
            if (self.chunks.try_extend(piece).is_err()) { self.failure = 4; return false; }
            return true;
        }
        // Map keys must be text or integers: other items at a key fail with
        // the offset of their head.
        let key: bool = self.key == 1;
        return match (event) {
            ext::cbor::Event::Text(n) -> self.string(n, true, key),
            ext::cbor::Event::Unsigned(n) -> self.integer(n, false),
            ext::cbor::Event::End -> self.close(),
            ext::cbor::Event::Float64(n) -> !self.rejected(key, at) && self.float(n),
            ext::cbor::Event::Map(n) -> !self.rejected(key, at) && self.object(),
            ext::cbor::Event::Array(n) -> !self.rejected(key, at) && self.array(),
            ext::cbor::Event::Negative(n) -> self.integer(n, true),
            ext::cbor::Event::Tag(n) -> self.open(3),
            ext::cbor::Event::Simple(n) -> !self.rejected(key, at) && self.simple(n),
            ext::cbor::Event::Bytes(n) -> !self.rejected(key, at) && self.string(n, false, false),
            ext::cbor::Event::Float32(n) -> !self.rejected(key, at) && self.float(ext::cbor_stream::widen_f32(n)),
            ext::cbor::Event::Float16(n) -> !self.rejected(key, at) && self.float(ext::cbor_stream::widen_f16(n)),
            ext::cbor::Event::BeginText -> self.chunked(5),
            ext::cbor::Event::BeginBytes -> !self.rejected(key, at) && self.chunked(4),
            ext::cbor::Event::BeginArray -> !self.rejected(key, at) && self.array(),
            ext::cbor::Event::BeginMap -> !self.rejected(key, at) && self.object(),
        };
    }
}

fn put_all(target: std::stream::Descriptor, bytes: [u8], count: i32) -> bool {
    return core::io::write_all<std::stream::Descriptor>(target.borrow(), bytes, 0, count).is_ok();
}
fn report(name: core::text::Text, offset: u64) {
    let failure: std::stream::Descriptor = std::stream::stderr();
    let prefix: [u8; 14] = [99, 98, 111, 114, 45, 116, 111, 45, 106, 115, 111, 110, 58, 32];
    put_all(failure, prefix, 14);
    core::io::write_all<std::stream::Descriptor>(failure.borrow(), name.bytes, name.start, name.length);
    let digits: [u8; 32] = [0; 32]; let reversed: [u8; 24] = [0; 24];
    let count: i32 = 0; let value: u64 = offset;
    if (value == 0) { reversed[0] = 48; count = 1; }
    while (value > 0) { reversed[count] = ((value % 10) as u8) + 48; value = value / 10; count += 1; }
    digits[0] = 32; digits[1] = 97; digits[2] = 116; digits[3] = 32;
    let index: i32 = 0;
    while (index < count) { digits[4 + index] = reversed[count - 1 - index]; index += 1; }
    digits[4 + count] = 10;
    put_all(failure, digits, 5 + count);
}
fn cbor_failure(cause: ext::cbor_stream::Error) -> i32 {
    report(ext::cbor_stream::kind_name(cause.kind), cause.offset);
    let status: i32 = match (cause.kind) { ext::cbor_stream::ErrorKind::AllocationFailed -> 4, _ -> 2 };
    return status;
}

fn run(convert: &Convert, options: ext::cbor_stream::Options) -> i32 {
    let made = ext::cbor_stream::decoder(options);
    if (made.is_err()) { return 4; }
    let decoder: ext::cbor_stream::Decoder = made.unwrap();
    let source: std::stream::Descriptor = std::stream::stdin();
    let target: std::stream::Descriptor = std::stream::stdout();
    let buffer: [u8; 4096] = [0; 4096];
    let opened = ext::cbor_stream::event_reader<std::stream::Descriptor>(source.borrow(), decoder.borrow(), core::result::unwrap(core::slice::view(buffer, 4096)));
    if (opened.is_err()) { decoder.destroy(); return 4; }
    let reader: ext::cbor_stream::EventReader<std::stream::Descriptor> = opened.unwrap();
    let status: i32 = 0; let roots: u64 = 0;
    while (status == 0) {
        let step: i32 = reader.advance();
        if (step < 0) {
            status = match (reader.last_error()) {
                ext::cbor_stream::StreamError::Cbor(cause) -> cbor_failure(cause),
                ext::cbor_stream::StreamError::Io(cause) -> 3,
            };
            break;
        }
        if (step == 0) { break; }
        if (convert.depth == 0 && roots > 0) {
            if (convert.out.next_document().is_err()) { status = 4; break; }
        }
        if (!convert.handle(decoder.event(), decoder.event_offset())) {
            status = convert.failure;
            if (status == 5) {
                let name: [u8; 14] = [85, 110, 115, 117, 112, 112, 111, 114, 116, 101, 100, 75, 101, 121];
                report(core::text::from_utf8_unchecked(name, 0, 14), convert.at); status = 2;
            }
            break;
        }
        if (convert.depth == 0) { roots += 1; }
        if (convert.out.len() > 65536) {
            if (convert.out.flush_to<std::stream::Descriptor>(target.borrow()).is_err()) { status = 3; }
        }
    }
    decoder.destroy();
    if (status != 0) { return status; }
    if (convert.out.flush_to<std::stream::Descriptor>(target.borrow()).is_err()) { return 3; }
    if (roots > 0) { let newline: [u8; 1] = [10]; if (!put_all(target, newline, 1)) { return 3; } }
    return 0;
}

fn flag(view: core::slice::View<u8>, letter: u8) -> bool {
    return view.length > 3 && view.values[view.start] == 45 && view.values[view.start + 1] == 45 && view.values[view.start + 2] == letter;
}

fn main() -> i32 {
    if (std::signal::set_disposition(std::signal::Signal::BrokenPipe, std::signal::Disposition::Ignore).is_err()) { return 3; }
    let captured = std::args::snapshot(1, 2, 256);
    if (captured.is_err()) { return 1; }
    let arguments = captured.unwrap();
    let options: ext::cbor_stream::Options = ext::cbor_stream::default_options();
    options.max_depth = 512;
    options.max_items = 18446744073709551615;
    let valid: bool = true; let index: i32 = 0;
    while (index < arguments.len()) {
        let view: core::slice::View<u8> = core::option::unwrap(arguments.get(index));
        if (flag(view, 115)) { options.sequence = true; } else { if (flag(view, 100)) { options.deterministic = true; } else { valid = false; } }
        index += 1;
    }
    arguments.destroy();
    if (!valid) {
        let usage: [u8; 51] = [117, 115, 97, 103, 101, 58, 32, 99, 98, 111, 114, 95, 116, 111, 95, 106, 115, 111, 110, 32, 91, 45, 45, 115, 101, 113, 93, 32, 91, 45, 45, 100, 101, 116, 101, 114, 109, 105, 110, 105, 115, 116, 105, 99, 93, 32, 60, 32, 73, 78, 10];
        put_all(std::stream::stderr(), usage, 51);
        return 1;
    }
    let made = ext::json_stream::writer(1024, 67108864);
    if (made.is_err()) { return 4; }
    let scratch: [u32; 864] = [0; 864]; let number: [u8; 40] = [0; 40];
    let stack: alloc::vec::Vec<u8> = alloc::vec::new();
    let convert: Convert = Convert { out: made.unwrap(), stack: stack, saved: stack.as_slice(), depth: 0, kind: 0, container: 0, key: 0,
        chunks: alloc::vec::new(), text: alloc::vec::new(), scratch: core::result::unwrap(core::slice::view(scratch, 864)), number: core::result::unwrap(core::slice::view(number, 40)), failure: 0, at: 0 };
    let status: i32 = run(convert.borrow(), options);
    convert.out.destroy(); convert.stack.destroy(); convert.chunks.destroy(); convert.text.destroy();
    return status;
}
