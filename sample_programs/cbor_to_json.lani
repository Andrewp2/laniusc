// cbor-to-json: stream one CBOR item (or with --seq a CBOR sequence) from
// stdin and print it as compact JSON, one document per line, following
// RFC 8949 section 6.1: integers and floats become numbers (shortest
// round-trip spelling), non-finite floats, null, undefined and other simple
// values become null, byte strings become unpadded base64url strings, tags
// are dropped in favour of their content, and indefinite strings are joined.
// Map keys must be text or integers (integers become decimal strings).
// --deterministic also rejects input that is not core deterministic CBOR.
// Limits: depth 512, 16 MiB per string, 64 MiB of input; no item count limit.
// Exit 0 ok, 1 usage, 2 invalid or unsupported CBOR, 3 I/O, 4 out of memory.
module app::main;
import alloc::vec;
import core::f64;
import core::float_decimal;
import core::io;
import core::option;
import core::result;
import core::slice;
import core::text;
import ext::cbor;
import ext::cbor_stream;
import ext::json_stream;
import std::args;
import std::signal;
import std::stream;

// Frame kinds: 1 array, 2 map, 3 tag, 4 chunked bytes, 5 chunked text.
struct Convert {
    out: ext::json_stream::Writer, kinds: alloc::vec::Vec<u8>, key_next: alloc::vec::Vec<u8>,
    chunks: alloc::vec::Vec<u8>, text: alloc::vec::Vec<u8>, scratch: [u32; 864], number: [u8; 40],
    failure: i32, at: u64,
}

fn base64_digit(value: u8) -> u8 {
    if (value < 26) { return value + 65; }
    if (value < 52) { return value + 71; }
    if (value < 62) { return value - 4; }
    if (value == 62) { return 45; }
    return 95;
}

impl Convert {
    fn borrow(&self) -> &Convert { return self; }
    fn text_of(&self) -> core::text::Text { return core::text::from_utf8_unchecked(self.text.as_slice(), 0, self.text.len()); }
    fn grow(&self, value: u8) -> bool { return self.text.try_push(value).is_ok(); }
    // Nearest non-tag frame index, or -1 at the root.
    fn container(&self) -> i32 {
        let index: i32 = self.kinds.len() - 1;
        while (index >= 0 && self.kinds.at(index) == 3) { index -= 1; }
        return index;
    }
    fn at_key(&self) -> bool {
        let index: i32 = self.container();
        return index >= 0 && self.kinds.at(index) == 2 && self.key_next.at(index) == 1;
    }
    // A complete value or key was written in the enclosing container.
    fn completed(&self) {
        let index: i32 = self.container();
        if (index >= 0 && self.kinds.at(index) == 2) {
            let flag: u8 = 1; if (self.key_next.at(index) == 1) { flag = 0; }
            core::result::unwrap(self.key_next.set(index, flag));
        }
    }
    fn wrote(&self, result: core::result::Result<i32, ext::json_stream::Error>) -> bool {
        if (result.is_err()) {
            self.failure = 2;
            let kind: ext::json_stream::ErrorKind = result.unwrap_err().kind;
            let memory: bool = match (kind) { ext::json_stream::ErrorKind::AllocationFailed -> true, _ -> false };
            if (memory) { self.failure = 4; }
            return false;
        }
        return true;
    }
    fn decimal(&self, value: u64, negative: bool) {
        self.text.clear();
        let digits: [u8; 24] = [0; 24]; let count: i32 = 0;
        if (value == 0) { digits[0] = 48; count = 1; }
        while (value > 0) { digits[count] = ((value % 10) as u8) + 48; value = value / 10; count += 1; }
        if (negative) {
            // -1 - n: add one to the decimal digits of n.
            let index: i32 = 0; let carry: bool = true;
            while (carry && index < count) {
                if (digits[index] == 57) { digits[index] = 48; index += 1; } else { digits[index] += 1; carry = false; }
            }
            if (carry) { digits[count] = 49; count += 1; }
            self.grow(45);
        }
        while (count > 0) { count -= 1; self.grow(digits[count]); }
    }
    fn emit_string(&self, key: bool) -> bool {
        if (key) { return self.wrote(self.out.key(self.text_of())); }
        return self.wrote(self.out.string(self.text_of()));
    }
    fn base64(&self, data: core::slice::View<u8>) {
        let index: i32 = 0;
        while (index + 2 < data.length) {
            let a: u8 = data.values[data.start + index]; let b: u8 = data.values[data.start + index + 1]; let c: u8 = data.values[data.start + index + 2];
            self.grow(base64_digit(a >> 2)); self.grow(base64_digit(((a & 3) << 4) | (b >> 4)));
            self.grow(base64_digit(((b & 15) << 2) | (c >> 6))); self.grow(base64_digit(c & 63));
            index += 3;
        }
        if (data.length - index == 1) {
            let a: u8 = data.values[data.start + index];
            self.grow(base64_digit(a >> 2)); self.grow(base64_digit((a & 3) << 4));
        }
        if (data.length - index == 2) {
            let a: u8 = data.values[data.start + index]; let b: u8 = data.values[data.start + index + 1];
            self.grow(base64_digit(a >> 2)); self.grow(base64_digit(((a & 3) << 4) | (b >> 4))); self.grow(base64_digit((b & 15) << 2));
        }
    }
    fn float(&self, bits: u64) -> bool {
        if (((bits >> 52) & 2047) == 2047) { return self.wrote(self.out.null()); }
        let scratch: core::slice::View<u32> = core::result::unwrap(core::slice::view(self.scratch, 864));
        let output: core::slice::View<u8> = core::result::unwrap(core::slice::view(self.number, 40));
        let written = core::float_decimal::format_f64_into(core::f64::from_bits(bits), output, scratch, core::float_decimal::default_format_work());
        if (written.is_err()) { self.failure = 4; return false; }
        let spelled: core::text::Text = core::text::from_utf8_unchecked(self.number, 0, written.unwrap());
        return self.wrote(self.out.number(spelled));
    }
    fn unsupported(&self, at: u64) -> bool { self.failure = 5; self.at = at; return false; }
    fn open(&self, kind: u8) -> bool {
        let flag: u8 = 0; if (kind == 2) { flag = 1; }
        if (self.kinds.try_push(kind).is_err() || self.key_next.try_push(flag).is_err()) { self.failure = 4; return false; }
        return true;
    }
    fn handle(&self, event: ext::cbor::Event, at: u64) -> bool {
        let key: bool = self.at_key();
        let tag: i32 = match (event) {
            ext::cbor::Event::Unsigned(n) -> 0, ext::cbor::Event::Negative(n) -> 1, ext::cbor::Event::Bytes(n) -> 2,
            ext::cbor::Event::Text(n) -> 3, ext::cbor::Event::Array(n) -> 4, ext::cbor::Event::Map(n) -> 5,
            ext::cbor::Event::Tag(n) -> 6, ext::cbor::Event::Simple(n) -> 7, ext::cbor::Event::Float16(n) -> 8,
            ext::cbor::Event::Float32(n) -> 9, ext::cbor::Event::Float64(n) -> 10, ext::cbor::Event::BeginBytes -> 11,
            ext::cbor::Event::BeginText -> 12, ext::cbor::Event::BeginArray -> 13, ext::cbor::Event::BeginMap -> 14,
            ext::cbor::Event::End -> 15,
        };
        let number: u64 = match (event) {
            ext::cbor::Event::Unsigned(n) -> n, ext::cbor::Event::Negative(n) -> n, ext::cbor::Event::Simple(n) -> n as u64,
            ext::cbor::Event::Float16(n) -> ext::cbor_stream::widen_f16(n), ext::cbor::Event::Float32(n) -> ext::cbor_stream::widen_f32(n),
            ext::cbor::Event::Float64(n) -> n, _ -> 0,
        };
        let data: core::slice::View<u8> = match (event) { ext::cbor::Event::Bytes(n) -> n, ext::cbor::Event::Text(n) -> n, _ -> core::slice::View { values: self.number, start: 0, length: 0 } };
        let depth: i32 = self.kinds.len();
        if (depth > 0 && self.kinds.at(depth - 1) >= 4 && tag != 15) {
            if (self.chunks.try_extend(data).is_err()) { self.failure = 4; return false; }
            return true;
        }
        if (tag == 6) { return self.open(3); }
        if (tag == 15) {
            let kind: u8 = self.kinds.at(depth - 1);
            self.kinds.pop(); self.key_next.pop();
            if (kind == 3) { return true; }
            let closing_key: bool = self.at_key();
            let ok: bool = true;
            if (kind == 1) { ok = self.wrote(self.out.end_array()); }
            if (kind == 2) { ok = self.wrote(self.out.end_object()); }
            if (kind == 4 || kind == 5) {
                let joined: core::slice::View<u8> = self.chunks.as_view();
                self.text.clear();
                if (kind == 5) { if (self.text.try_extend(joined).is_err()) { self.failure = 4; return false; } } else { self.base64(joined); }
                self.chunks.clear();
                ok = self.emit_string(closing_key);
            }
            if (ok) { self.completed(); }
            return ok;
        }
        if (key && tag != 0 && tag != 1 && tag != 3 && tag != 12) { return self.unsupported(at); }
        let ok: bool = true;
        if (tag == 0 || tag == 1) {
            self.decimal(number, tag == 1);
            if (key) { ok = self.emit_string(true); } else { ok = self.wrote(self.out.number(self.text_of())); }
        }
        if (tag == 2 || tag == 3) {
            self.text.clear();
            if (tag == 3) { if (self.text.try_extend(data).is_err()) { self.failure = 4; return false; } } else { self.base64(data); }
            ok = self.emit_string(key);
        }
        if (tag == 4 || tag == 13) { if (!self.wrote(self.out.begin_array())) { return false; } return self.open(1); }
        if (tag == 5 || tag == 14) { if (!self.wrote(self.out.begin_object())) { return false; } return self.open(2); }
        if (tag == 11) { self.chunks.clear(); return self.open(4); }
        if (tag == 12) { self.chunks.clear(); return self.open(5); }
        if (tag == 7) {
            if (number == 20 || number == 21) { ok = self.wrote(self.out.boolean(number == 21)); } else { ok = self.wrote(self.out.null()); }
        }
        if (tag >= 8 && tag <= 10) { ok = self.float(number); }
        if (ok) { self.completed(); }
        return ok;
    }
}

fn put_all(target: std::stream::Descriptor, bytes: [u8], count: i32) -> bool {
    return core::io::write_all<std::stream::Descriptor>(target.borrow(), bytes, 0, count).is_ok();
}
fn report(name: core::text::Text, offset: u64) {
    let failure: std::stream::Descriptor = std::stream::stderr();
    let prefix: [u8; 14] = [99, 98, 111, 114, 45, 116, 111, 45, 106, 115, 111, 110, 58, 32];
    put_all(failure, prefix, 14);
    core::io::write_all<std::stream::Descriptor>(failure.borrow(), name.bytes, name.start, name.length);
    let digits: [u8; 32] = [0; 32]; let reversed: [u8; 24] = [0; 24];
    let count: i32 = 0; let value: u64 = offset;
    if (value == 0) { reversed[0] = 48; count = 1; }
    while (value > 0) { reversed[count] = ((value % 10) as u8) + 48; value = value / 10; count += 1; }
    digits[0] = 32; digits[1] = 97; digits[2] = 116; digits[3] = 32;
    let index: i32 = 0;
    while (index < count) { digits[4 + index] = reversed[count - 1 - index]; index += 1; }
    digits[4 + count] = 10;
    put_all(failure, digits, 5 + count);
}
fn cbor_failure(cause: ext::cbor_stream::Error) -> i32 {
    report(ext::cbor_stream::kind_name(cause.kind), cause.offset);
    let status: i32 = match (cause.kind) { ext::cbor_stream::ErrorKind::AllocationFailed -> 4, _ -> 2 };
    return status;
}

fn run(convert: &Convert, options: ext::cbor_stream::Options) -> i32 {
    let made = ext::cbor_stream::decoder(options);
    if (made.is_err()) { return 4; }
    let decoder: ext::cbor_stream::Decoder = made.unwrap();
    let source: std::stream::Descriptor = std::stream::stdin();
    let target: std::stream::Descriptor = std::stream::stdout();
    let buffer: [u8; 4096] = [0; 4096];
    let opened = ext::cbor_stream::event_reader<std::stream::Descriptor>(source.borrow(), decoder.borrow(), core::result::unwrap(core::slice::view(buffer, 4096)));
    if (opened.is_err()) { decoder.destroy(); return 4; }
    let reader: ext::cbor_stream::EventReader<std::stream::Descriptor> = opened.unwrap();
    let status: i32 = 0; let roots: u64 = 0;
    while (status == 0) {
        let step = reader.next();
        if (step.is_err()) {
            status = match (step.unwrap_err()) {
                ext::cbor_stream::StreamError::Cbor(cause) -> cbor_failure(cause),
                ext::cbor_stream::StreamError::Io(cause) -> 3,
            };
            break;
        }
        if (!step.unwrap()) { break; }
        if (convert.kinds.len() == 0 && roots > 0) {
            if (convert.out.next_document().is_err()) { status = 4; break; }
        }
        if (!convert.handle(decoder.event(), decoder.event_offset())) {
            status = convert.failure;
            if (status == 5) {
                let name: [u8; 14] = [85, 110, 115, 117, 112, 112, 111, 114, 116, 101, 100, 75, 101, 121];
                report(core::text::from_utf8_unchecked(name, 0, 14), convert.at); status = 2;
            }
            break;
        }
        if (convert.kinds.len() == 0) { roots += 1; }
        if (convert.out.len() > 65536) {
            if (convert.out.flush_to<std::stream::Descriptor>(target.borrow()).is_err()) { status = 3; }
        }
    }
    decoder.destroy();
    if (status != 0) { return status; }
    if (convert.out.flush_to<std::stream::Descriptor>(target.borrow()).is_err()) { return 3; }
    if (roots > 0) { let newline: [u8; 1] = [10]; if (!put_all(target, newline, 1)) { return 3; } }
    return 0;
}

fn flag(view: core::slice::View<u8>, letter: u8) -> bool {
    return view.length > 3 && view.values[view.start] == 45 && view.values[view.start + 1] == 45 && view.values[view.start + 2] == letter;
}

fn main() -> i32 {
    if (std::signal::set_disposition(std::signal::Signal::BrokenPipe, std::signal::Disposition::Ignore).is_err()) { return 3; }
    let captured = std::args::snapshot(1, 2, 256);
    if (captured.is_err()) { return 1; }
    let arguments = captured.unwrap();
    let options: ext::cbor_stream::Options = ext::cbor_stream::default_options();
    options.max_depth = 512;
    options.max_items = 18446744073709551615;
    let valid: bool = true; let index: i32 = 0;
    while (index < arguments.len()) {
        let view: core::slice::View<u8> = core::option::unwrap(arguments.get(index));
        if (flag(view, 115)) { options.sequence = true; } else { if (flag(view, 100)) { options.deterministic = true; } else { valid = false; } }
        index += 1;
    }
    arguments.destroy();
    if (!valid) {
        let usage: [u8; 51] = [117, 115, 97, 103, 101, 58, 32, 99, 98, 111, 114, 95, 116, 111, 95, 106, 115, 111, 110, 32, 91, 45, 45, 115, 101, 113, 93, 32, 91, 45, 45, 100, 101, 116, 101, 114, 109, 105, 110, 105, 115, 116, 105, 99, 93, 32, 60, 32, 73, 78, 10];
        put_all(std::stream::stderr(), usage, 51);
        return 1;
    }
    let made = ext::json_stream::writer(1024, 67108864);
    if (made.is_err()) { return 4; }
    let convert: Convert = Convert { out: made.unwrap(), kinds: alloc::vec::new(), key_next: alloc::vec::new(),
        chunks: alloc::vec::new(), text: alloc::vec::new(), scratch: [0; 864], number: [0; 40], failure: 0, at: 0 };
    let status: i32 = run(convert.borrow(), options);
    convert.out.destroy(); convert.kinds.destroy(); convert.key_next.destroy(); convert.chunks.destroy(); convert.text.destroy();
    return status;
}
