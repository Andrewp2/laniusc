// Build a growable sequence of the first ten squares and print their sum.
module app::main;
import std::vec_i32;
import core::number_i32;
import std::io;

fn main() -> i32 {
    let squares: std::vec_i32::VecI32 = std::vec_i32::new();
    let number: i32 = 0;
    while (number < 10) {
        let before: i32 = std::vec_i32::len(squares);
        squares = std::vec_i32::try_push(squares, number * number);
        if (std::vec_i32::len(squares) != before + 1) {
            std::vec_i32::destroy(squares);
            return 1;
        }
        number = number + 1;
    }

    let sum: i32 = 0;
    let index: i32 = 0;
    while (index < std::vec_i32::len(squares)) {
        sum = core::number_i32::saturating_add(
            sum, std::vec_i32::get_or(squares, index, 0));
        index = index + 1;
    }
    std::vec_i32::destroy(squares);
    std::io::print_i32(sum);
    return 0;
}
