module app::main;
import core::bitset;
import core::number_i32;

fn main() -> i32 {
    // Mark composite numbers through 100 in four caller-owned words.
    let zero: u32 = 0;
    let composite: [u32; 4] = [zero, zero, zero, zero];
    let candidate: i32 = 2;
    while (candidate * candidate <= 100) {
        if (!core::bitset::get_or(composite, 101, candidate, false)) {
            let multiple: i32 = candidate * candidate;
            while (multiple <= 100) {
                if (!core::bitset::set(composite, 101, multiple)) { return 1; }
                multiple += candidate;
            }
        }
        candidate += 1;
    }

    let count: i32 = 0;
    let sum: i32 = 0;
    candidate = 2;
    while (candidate <= 100) {
        if (!core::bitset::get_or(composite, 101, candidate, false)) {
            count = core::number_i32::saturating_add(count, 1);
            sum = core::number_i32::saturating_add(sum, candidate);
        }
        candidate += 1;
    }
    print(count);
    print(sum);
    return 0;
}
