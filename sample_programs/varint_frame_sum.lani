// Build and read a checked compact frame, then print its native u64 sum.
module app::main;
import core::decimal;
import core::option;
import core::result;
import core::slice;
import core::u64;
import core::varint;
import std::io_byte;

fn main() -> i32 {
    let frame:[u8;32] = [99;32];
    let storage:core::slice::View<u8> = core::slice::View { values:frame,start:2,length:28 };
    let payloads:[u64;3] = [300,4294967296,10];
    let written:core::result::Result<i32,core::varint::Error> = core::varint::write_u32(storage,0,3);
    if (written.is_err()) { return 1; }
    let end:i32 = written.unwrap();
    let expected:i32 = core::varint::len_u32(3);
    let index:i32 = 0;
    while (index < 3) {
        let appended:core::result::Result<i32,core::varint::Error> = core::varint::write_u64(storage,end,payloads[index]);
        if (appended.is_err()) { return 1; }
        end = appended.unwrap();
        expected += core::varint::len_u64(payloads[index]);
        index += 1;
    }
    if (end != expected || end != 9) { return 1; }
    if (frame[0] != 99 || frame[1] != 99 || frame[2+end] != 99 || frame[31] != 99) { return 1; }
    let bytes:core::slice::View<u8> = core::slice::View { values:frame,start:2,length:end };
    let decoded:core::result::Result<core::varint::Decoded<u32>,core::varint::Error> = core::varint::read_u32(bytes,0);
    if (decoded.is_err()) { return 2; }
    let header:core::varint::Decoded<u32> = decoded.unwrap();
    if (header.value != 3) { return 2; }
    let position:i32 = header.next;
    let total:u64 = 0;
    let count:i32 = 0;
    while (count < 3) {
        let parsed:core::result::Result<core::varint::Decoded<u64>,core::varint::Error> = core::varint::read_u64(bytes,position);
        if (parsed.is_err()) { return 3; }
        let item:core::varint::Decoded<u64> = parsed.unwrap();
        let added:core::option::Option<u64> = core::u64::checked_add(total,item.value);
        if (added.is_none()) { return 3; }
        total = added.unwrap(); position = item.next; count += 1;
    }
    if (position != end || total != 4294967606) { return 3; }
    let output:[u8;21] = [0;21];
    let formatted:core::result::Result<i32,core::decimal::FormatError> = core::decimal::format_u64(output,0,20,total);
    if (formatted.is_err()) { return 4; }
    let length:i32 = formatted.unwrap();
    if (length != 10) { return 4; }
    output[length] = 10;
    index = 0;
    // One byte per checked host call; at most 21 attempts, with no retry.
    while (index <= length) {
        if (!std::io_byte::write_stdout_byte(output[index] as i32)) { return 4; }
        index += 1;
    }
    return 0;
}
