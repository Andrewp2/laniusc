module app::main;
import alloc::string;
import core::result;
import core::utf8;
import std::io_utf8;
import std::io_byte;
import std::io_decimal;

fn main() -> i32 {
    let bytes: [u8; 7] = [65, 194, 162, 65, 194, 162, 66];
    let copied: core::result::Result<alloc::string::String, alloc::string::Error> = alloc::string::from_utf8(bytes, 7);
    if (core::result::is_err(copied)) { return 1; }
    let text: alloc::string::String = core::result::unwrap(copied);
    let owned: [u8] = text.as_bytes();
    if (text.byte_len() != 7 || text.scalar_count() != 5 ||
        core::utf8::byte_view_scalar_at_or(owned, 7, 1, 4294967295) != 162 ||
        core::utf8::byte_view_offset_of_scalar_or(owned, 7, 4, -1) != 6) { text.destroy(); return 1; }
    let count: i32 = text.scalar_count();
    if (!std::io_utf8::write_stdout_bytes(owned, text.byte_len())) { text.destroy(); return 2; }
    text.destroy();
    if (std::io_decimal::write_i32(1, count) < 0 || !std::io_byte::write_stdout_byte(10)) { return 2; }
    return 0;
}
