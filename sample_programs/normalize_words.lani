// Normalize ASCII whitespace in UTF-8 stdin to single spaces, with optional
// indentation (0..256). Non-ASCII whitespace and NUL are preserved as text.
// Limits: 1 MiB input, 65536 words. Empty/whitespace-only input emits nothing.
// Exit 2 invalid input/limit, 3 I/O, 4 allocation. No output until validation.
module app::main;
import alloc::io;
import alloc::string;
import core::decimal;
import core::io;
import core::mem;
import core::option;
import core::result;
import core::slice;
import core::text;
import std::args_checked;
import std::stream;
import std::vec;

fn input_status(error: core::io::Error) -> i32 {
    let code: i32 = match (error) { core::io::Error::LimitExceeded -> 2, core::io::Error::AllocationFailed -> 4, _ -> 3 };
    return code;
}

fn main() -> i32 {
    let arguments: i32 = std::args_checked::argument_count_or(0);
    if (arguments < 1 || arguments > 2) { return 2; }
    let indent: i32 = 0;
    if (arguments == 2) {
        let length: i32 = std::args_checked::argument_len_or(1, -1);
        if (length < 1 || length > 3) { return 2; }
        let storage: [i32; 1] = [0];
        let pointer: ptr = core::mem::i32_array_data_ptr(storage);
        if (!std::args_checked::read_exact_into(1, pointer, 4)) { return 2; }
        let bytes: [u8] = core::mem::typed_slice_from_raw_parts(pointer, length);
        let parsed: core::result::Result<u16, core::decimal::ParseError> = core::decimal::parse_u16(bytes, length);
        if (core::result::is_err(parsed)) { return 2; }
        indent = core::result::unwrap(parsed) as i32;
        if (indent > 256) { return 2; }
    }
    let input: alloc::io::Buffer = core::result::unwrap(alloc::io::with_limit(1048576));
    let source: std::stream::Descriptor = std::stream::stdin();
    let received: core::result::Result<u64, core::io::CopyFailure> = std::stream::copy(source.borrow(), input.borrow());
    if (core::result::is_err(received)) {
        let failure: core::io::CopyFailure = core::result::unwrap_err(received);
        input.destroy(); return input_status(failure.cause);
    }
    let checked: core::result::Result<core::text::Text, core::text::Error> = core::text::from_utf8(input.as_bytes(), input.len());
    if (core::result::is_err(checked)) { input.destroy(); return 2; }
    let text: core::text::Text = core::result::unwrap(checked);
    let cursor: core::text::SplitAsciiWhitespace = text.split_ascii_whitespace();
    let words: std::vec::Vec<core::text::Text> = std::vec::new();
    while (true) {
        let word: core::option::Option<core::text::Text> = cursor.next();
        if (core::option::is_none(word)) { break; }
        let length: i32 = std::vec::len(words);
        if (length == 65536) { std::vec::destroy(words); input.destroy(); return 2; }
        let grown: std::vec::Vec<core::text::Text> = std::vec::try_push(words, core::option::unwrap(word));
        if (std::vec::len(grown) == length) { std::vec::destroy(words); input.destroy(); return 4; }
        words = grown;
    }
    let count: i32 = std::vec::len(words);
    if (count == 0) { std::vec::destroy(words); input.destroy(); return 0; }
    let space_bytes: [u8; 1] = [32];
    let space: core::text::Text = core::result::unwrap(core::text::from_utf8(space_bytes, 1));
    let built: core::result::Result<alloc::string::String, alloc::string::Error> = alloc::string::repeat(space, indent);
    if (core::result::is_err(built)) { std::vec::destroy(words); input.destroy(); return 4; }
    let output: alloc::string::String = core::result::unwrap(built);
    let view: core::slice::View<core::text::Text> = core::result::unwrap(core::slice::view(std::vec::as_slice(words), count));
    let joined: core::result::Result<i32, alloc::string::Error> = output.try_append_joined(view, space);
    std::vec::destroy(words); input.destroy();
    if (core::result::is_err(joined)) { output.destroy(); return 4; }
    if (core::result::is_err(output.try_push_scalar(10))) { output.destroy(); return 4; }
    let sink: std::stream::Descriptor = std::stream::stdout();
    let sent: core::result::Result<i32, core::io::Failure> = core::io::write_all(sink.borrow(), output.as_bytes(), 0, output.byte_len());
    output.destroy();
    if (core::result::is_err(sent)) { return 3; }
    return 0;
}
