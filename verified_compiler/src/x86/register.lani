module x86::register;

pub const RAX: i32 = 0;
pub const RCX: i32 = 1;
pub const RDX: i32 = 2;
pub const RBX: i32 = 3;
pub const RSP: i32 = 4;
pub const RBP: i32 = 5;
pub const RSI: i32 = 6;
pub const RDI: i32 = 7;
pub const R8: i32 = 8;
pub const R9: i32 = 9;
pub const R10: i32 = 10;
pub const R11: i32 = 11;
pub const R12: i32 = 12;
pub const R13: i32 = 13;
pub const R14: i32 = 14;
pub const R15: i32 = 15;

pub const WIDTH_32: i32 = 32;
pub const WIDTH_64: i32 = 64;
const REGISTER_COUNT: i32 = 16;
const LEGACY_REGISTER_COUNT: i32 = 8;
const REX_BASE: i32 = 64;
const REX_W: i32 = 8;
const REX_R: i32 = 4;

pub fn valid(value: i32) -> bool {
    return value >= 0 && value < REGISTER_COUNT;
}
pub fn width_valid(width: i32) -> bool {
    return width == WIDTH_32 || width == WIDTH_64;
}

// Intel SDM volume 2, section 2.2.1: 0100WRXB. No indexed SIB operand
// is used here, so X is zero. A zero return means no prefix is needed.
pub fn rex(width: i32, reg: i32, base: i32, byte_register: bool) -> i32 {
    let value: i32 = REX_BASE + (reg / LEGACY_REGISTER_COUNT) * REX_R
        + base / LEGACY_REGISTER_COUNT;
    if (width == WIDTH_64) { value += REX_W; }
    if (value == REX_BASE && !byte_register) { return 0; }
    return value;
}
