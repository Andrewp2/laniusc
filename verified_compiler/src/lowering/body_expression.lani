module lowering::body_expression;

import backend::syntax;
import lowering::allocation;
import lowering::body_context;
import ir::body_events;
import ir::type_ref;
import lowering::body_event_write;
import lowering::body_lookup;
import lowering::declarations;
import lowering::locals;
import lowering::signatures;
import lowering::signature_index;
import lowering::string_literal;
import lowering::token_names;
import lowering::value_catalog;
import verified::surface_expr;
import verified::host;

type BodyContext = lowering::body_context::BodyContext;
type EnumVariant = lowering::body_lookup::EnumVariant;
type VariantTarget = lowering::value_catalog::VariantTarget;
type Region = ir::body_events::Region;
type TypeRef = ir::type_ref::TypeRef;

pub enum ExpressionStatus {
    KnownExpression,
    InvalidExpression,
    UnsupportedExpression,
}

pub struct ExpressionKind {
    status: ExpressionStatus,
    kind: TypeRef,
}

fn invalid_kind() -> ExpressionKind {
    return ExpressionKind {
        status: InvalidExpression,
        kind: ir::type_ref::Invalid,
    };
}

fn unsupported_kind() -> ExpressionKind {
    return ExpressionKind {
        status: UnsupportedExpression,
        kind: ir::type_ref::Invalid,
    };
}

fn known_kind(kind: ir::type_ref::TypeRef) -> ExpressionKind {
    if (!ir::type_ref::valid_result(kind)) { return unsupported_kind(); }
    return ExpressionKind { status: KnownExpression, kind: kind };
}

pub fn kind_type(result: ExpressionKind) -> ir::type_ref::TypeRef {
    if (result.status == KnownExpression) { return result.kind; }
    return ir::type_ref::Invalid;
}

fn kind_failure(result: ExpressionKind) -> i32 {
    if (result.status == UnsupportedExpression) {
        return lowering::body_context::unsupported();
    }
    return lowering::body_context::invalid();
}

fn nominal_id(result: ExpressionKind) -> i32 {
    let kind: ir::type_ref::TypeRef = kind_type(result);
    return match (kind) {
        ir::type_ref::Nominal(id) -> id,
        _ -> -1,
    };
}

fn emit_resolved_enum_variant(context: BodyContext, arena_count: i32,
    variant: VariantTarget, first: i32, output: Region,
    position: i32, depth: i32) -> i32 {
    let arena: verified::surface_expr::ExpressionArena = context.expression_arena;
    let nodes: [verified::surface_expr::ExpressionNode] = arena.data;
    let count: i32 = 0;
    let current: i32 = first;
    let fuel: i32 = arena_count;
    while (current >= 0 && fuel > 0) {
        if (current >= arena_count) { return lowering::body_context::invalid(); }
        count += 1;
        current = nodes[current].next;
        fuel -= 1;
    }
    if (current >= 0 || count != variant.field_count) {
        return lowering::body_context::invalid();
    }
    let next: i32 = lowering::body_event_write::expression_enumeration(output,
        position, ir::body_events::EnumVariant {
            type_id: variant.type_id,
            ordinal: variant.ordinal,
            payload_count: variant.field_count,
        });
    current = first;
    let field_index: i32 = 0;
    while (current >= 0) {
        let field_kind: TypeRef = lowering::body_lookup::enum_variant_field_kind(
            context, variant, field_index);
        next = expression_expected(context, arena_count, current,
            field_kind, output, next, depth - 1);
        if (next <= -1) { return lowering::body_context::invalid(); }
        current = nodes[current].next;
        field_index += 1;
    }
    return next;
}

fn emit_enum_variant(context: BodyContext, arena_count: i32,
    variant: EnumVariant, first: i32, output: Region,
    position: i32, depth: i32) -> i32 {
    return match (variant) {
        lowering::body_lookup::EnumResolved(value) ->
            emit_resolved_enum_variant(context, arena_count, value, first,
                output, position, depth),
        _ -> lowering::body_context::invalid(),
    };
}

fn bind_pattern_payload(context: BodyContext, arena_count: i32,
    pattern: i32, variant: VariantTarget) -> i32 {
    let arena: verified::surface_expr::ExpressionArena = context.expression_arena;
    let nodes: [verified::surface_expr::ExpressionNode] = arena.data;
    let locals: lowering::locals::Table = context.locals;
    let first: i32 = nodes[pattern].right;
    if (lowering::body_lookup::pattern_payload_count(context, arena_count, first)
        != variant.field_count) {
        return lowering::body_context::invalid();
    }
    let saved: i32 = lowering::locals::save(locals);
    let current: i32 = first;
    let payload_index: i32 = 0;
    let field_count: i32 = variant.field_count;
    while (payload_index != field_count) {
        if (current <= -1 || current >= arena_count
            || nodes[current].right != -1) {
            lowering::locals::restore(locals, saved);
            return lowering::body_context::unsupported();
        }
        let name: i32 = lowering::body_lookup::pattern_path_token(context, arena_count, current,
            true);
        if (name <= -1) {
            lowering::locals::restore(locals, saved);
            return lowering::body_context::unsupported();
        }
        let binding: i32 = saved;
        while (binding < lowering::locals::save(locals)) {
            if (lowering::body_context::same_identifier(context,
                    lowering::locals::name_at(locals, binding), name)) {
                lowering::locals::restore(locals, saved);
                return lowering::body_context::invalid();
            }
            binding += 1;
        }
        let field_kind: TypeRef = lowering::body_lookup::enum_variant_field_kind(
            context, variant, payload_index);
        if (!ir::type_ref::valid(field_kind)
            || !lowering::locals::bind(context.locals, name, field_kind)) {
            lowering::locals::restore(locals, saved);
            return lowering::body_context::invalid();
        }
        current = nodes[current].next;
        payload_index += 1;
    }
    return variant.field_count;
}

fn bind_pattern_variant(context: BodyContext, arena_count: i32,
    pattern: i32, variant: EnumVariant) -> i32 {
    return match (variant) {
        lowering::body_lookup::EnumResolved(value) ->
            bind_pattern_payload(context, arena_count, pattern, value),
        _ -> lowering::body_context::invalid(),
    };
}

fn match_result_kind(context: BodyContext, arena_count: i32, node: i32,
    depth: i32) -> ExpressionKind {
    let arena: verified::surface_expr::ExpressionArena = context.expression_arena;
    let nodes: [verified::surface_expr::ExpressionNode] = arena.data;
    let locals: lowering::locals::Table = context.locals;
    if (node <= -1 || node >= arena_count
        || !verified::surface_expr::has_kind(nodes[node].kind,
            verified::surface_expr::MatchValue)) { return unsupported_kind(); }
    let scrutinee_kind: ExpressionKind = expression_kind(context, arena_count,
        nodes[node].left, depth - 1);
    let type_id: i32 = nominal_id(scrutinee_kind);
    if (type_id <= -1) { return unsupported_kind(); }
    if (!lowering::body_lookup::has_signature(context, type_id,
        lowering::signatures::EnumerationShape)) {
        return unsupported_kind();
    }
    let first: i32 = nodes[node].right;
    let arm: i32 = first;
    let arms: i32 = 0;
    let wildcard: bool = false;
    let result_kind: ir::type_ref::TypeRef = ir::type_ref::Invalid;
    let fuel: i32 = arena_count;
    while (arm >= 0 && fuel > 0) {
        if (arm >= arena_count
            || !verified::surface_expr::has_kind(nodes[arm].kind,
                verified::surface_expr::MatchArm)) { return invalid_kind(); }
        let pattern: i32 = nodes[arm].left;
        let is_wildcard: bool = lowering::body_lookup::wildcard_pattern(
            context, arena_count, pattern);
        if (is_wildcard) {
            if (nodes[arm].next != -1) { return invalid_kind(); }
            wildcard = true;
        } else {
            let variant: EnumVariant = lowering::body_lookup::enum_pattern_variant(
                context, arena_count, pattern, type_id);
            if (!lowering::body_lookup::is_resolved(variant)) {
                return invalid_kind();
            }
            let prior: i32 = first;
            while (prior >= 0 && prior != arm) {
                let prior_variant: EnumVariant = lowering::body_lookup::enum_pattern_variant(
                    context, arena_count, nodes[prior].left, type_id);
                if (!lowering::body_lookup::is_resolved(prior_variant)
                    || lowering::body_lookup::ordinal(prior_variant)
                        == lowering::body_lookup::ordinal(variant)) {
                    return invalid_kind();
                }
                prior = nodes[prior].next;
            }
        }
        let saved: i32 = lowering::locals::save(locals);
        if (!is_wildcard) {
            let variant: EnumVariant = lowering::body_lookup::enum_pattern_variant(
                context, arena_count, pattern, type_id);
            if (bind_pattern_variant(context, arena_count, pattern, variant)
                <= -1) {
                lowering::locals::restore(locals, saved);
                return invalid_kind();
            }
        }
        let arm_result: ExpressionKind = expression_kind(context, arena_count,
            nodes[arm].right, depth - 1);
        lowering::locals::restore(locals, saved);
        let arm_kind: ir::type_ref::TypeRef = kind_type(arm_result);
        if (!ir::type_ref::valid(arm_kind)) { return unsupported_kind(); }
        if (arms > 0 && !ir::type_ref::same(result_kind, arm_kind)) {
            return unsupported_kind();
        }
        result_kind = arm_kind;
        arm = nodes[arm].next;
        arms += 1;
        fuel -= 1;
    }
    let signature_record: lowering::signatures::SignatureRecord =
        lowering::signature_index::record_at(context.signature_index,
            type_id);
    if (arm >= 0 || fuel == 0 || arms <= 0
        || (!wildcard
            && arms != lowering::signatures::record_arity(signature_record))) {
        return invalid_kind();
    }
    return known_kind(result_kind);
}

fn structure_field(context: BodyContext, type_id: i32, name: i32) -> i32 {
    if (name <= -1 || !lowering::body_lookup::has_signature(context,
        type_id, lowering::signatures::StructureShape)) {
        return lowering::body_context::invalid();
    }
    let record: lowering::signatures::SignatureRecord =
        lowering::signature_index::record_at(context.signature_index,
            type_id);
    if (!lowering::signatures::record_has_shape(record,
            lowering::signatures::StructureShape)) { return lowering::body_context::invalid(); }
    let allocated: lowering::allocation::Table = context.allocated;
    let owner: i32 = -1;
    let row: i32 = 0;
    let rows: i32 = lowering::allocation::table_header(allocated).rows;
    while (row < rows) {
        let declaration: lowering::allocation::AllocationRow =
            lowering::allocation::table_row(allocated, row);
        if (lowering::allocation::row_has_kind(declaration,
                lowering::declarations::Structure)
            && lowering::allocation::row_declaration_id(declaration) == type_id) {
            if (owner >= 0) { return lowering::body_context::invalid(); }
            owner = lowering::allocation::row_unit(declaration);
        }
        row += 1;
    }
    if (owner <= -1) { return lowering::body_context::invalid(); }
    let catalog: lowering::token_names::Catalog =
        lowering::token_names::catalog(context.contexts,
            context.source_catalog, context.token_catalog);
    let field_index: i32 = 0;
    while (field_index != lowering::signatures::record_arity(record)) {
        let member: lowering::signatures::SignatureMember =
            lowering::signature_index::member_at(context.signature_index,
                type_id, field_index);
        let field_name: i32 = member.name;
        if (lowering::token_names::same(catalog, context.owner_unit,
            name, owner, field_name)) { return field_index; }
        field_index += 1;
    }
    return lowering::body_context::invalid();
}

fn struct_literal_field(context: BodyContext, arena_count: i32, first: i32,
    expected_owner: i32, expected_name: i32) -> i32 {
    let arena: verified::surface_expr::ExpressionArena = context.expression_arena;
    let nodes: [verified::surface_expr::ExpressionNode] = arena.data;
    let catalog: lowering::token_names::Catalog =
        lowering::token_names::catalog(context.contexts,
            context.source_catalog, context.token_catalog);
    let current: i32 = first;
    let found: i32 = -1;
    let fuel: i32 = arena_count;
    while (current >= 0 && fuel > 0) {
        if (current >= arena_count
            || !verified::surface_expr::has_kind(
                nodes[current].kind,
                verified::surface_expr::StructField)) { return lowering::body_context::invalid(); }
        let name: i32 = nodes[current].token;
        if (lowering::token_names::same(catalog, context.owner_unit,
            name, expected_owner, expected_name)) {
            if (found >= 0) { return lowering::body_context::invalid(); }
            found = current;
        }
        current = nodes[current].next;
        fuel -= 1;
    }
    if (current >= 0 || fuel == 0) { return lowering::body_context::invalid(); }
    return found;
}

// Assignment targets are deliberately narrower than general expressions:
// only one-segment local paths and recursively indexed places have a canonical
// backend representation in this lowering stage.
fn place(context: BodyContext, arena_count: i32, node: i32,
    output: Region, position: i32, depth: i32) -> i32 {
    let arena: verified::surface_expr::ExpressionArena = context.expression_arena;
    let nodes: [verified::surface_expr::ExpressionNode] = arena.data;
    if (depth <= 0 || node <= -1 || node >= arena_count) { return lowering::body_context::invalid(); }
    let current_node: verified::surface_expr::ExpressionNode = nodes[node];
    let kind: verified::surface_expr::SurfaceExprKind = current_node.kind;
    if (verified::surface_expr::has_kind(kind,
        verified::surface_expr::PathExpression)) {
        let name: i32 = lowering::body_context::simple_path_token(context.expression_arena,
            arena_count, node);
        if (name <= -1 || name >= context.token_count) { return lowering::body_context::invalid(); }
        let binding: i32 = lowering::body_context::local_index(context, name);
        if (binding <= -1) { return lowering::body_context::invalid(); }
        let declaration: i32 = lowering::locals::name_at(context.locals,
            binding);
        return lowering::body_event_write::place_local(
            output, position,
            ir::body_events::LocalReference { id: declaration });
    }
    if (verified::surface_expr::has_kind(kind, verified::surface_expr::Index)) {
        let next: i32 = lowering::body_event_write::place_index(
            output, position);
        if (next <= -1) { return next; }
        next = place(context, arena_count,
            current_node.left, output, next,
            depth - 1);
        if (next <= -1) { return next; }
        return expression(context, arena_count,
            current_node.right, output, next,
            depth - 1);
    }
    if (verified::surface_expr::has_kind(kind, verified::surface_expr::Member)) {
        let base: i32 = current_node.left;
        let base_kind: ExpressionKind = expression_kind(context, arena_count, base,
            depth - 1);
        let type_id: i32 = nominal_id(base_kind);
        if (type_id <= -1) {
            return lowering::body_context::unsupported();
        }
        let field_index: i32 = structure_field(context,
            type_id, current_node.token);
        if (field_index <= -1) { return lowering::body_context::invalid(); }
        let next: i32 = lowering::body_event_write::place_field(
            output, position,
            ir::body_events::FieldReference { index: field_index });
        if (next <= -1) { return lowering::body_context::invalid(); }
        return place(context, arena_count, base, output, next,
            depth - 1);
    }
    return lowering::body_context::unsupported();
}

fn unary_operation(operator: verified::surface_expr::ExpressionOperator)
    -> backend::syntax::UnaryOperation {
    return match (operator) {
        verified::surface_expr::UnaryPositive -> backend::syntax::UnaryPositive,
        verified::surface_expr::UnaryNegate -> backend::syntax::UnaryNegate,
        verified::surface_expr::UnaryNot -> backend::syntax::UnaryNot,
        _ -> backend::syntax::InvalidUnaryOperation,
    };
}

fn binary_operation(operator: verified::surface_expr::ExpressionOperator)
    -> backend::syntax::BinaryOperation {
    return match (operator) {
        verified::surface_expr::BinaryOrElse -> backend::syntax::BinaryOrElse,
        verified::surface_expr::BinaryAndThen -> backend::syntax::BinaryAndThen,
        verified::surface_expr::BinaryBitOr -> backend::syntax::BinaryBitOr,
        verified::surface_expr::BinaryBitXor -> backend::syntax::BinaryBitXor,
        verified::surface_expr::BinaryBitAnd -> backend::syntax::BinaryBitAnd,
        verified::surface_expr::BinaryEqual -> backend::syntax::BinaryEqual,
        verified::surface_expr::BinaryNotEqual -> backend::syntax::BinaryNotEqual,
        verified::surface_expr::BinaryLess -> backend::syntax::BinaryLess,
        verified::surface_expr::BinaryGreater -> backend::syntax::BinaryGreater,
        verified::surface_expr::BinaryLessEqual -> backend::syntax::BinaryLessEqual,
        verified::surface_expr::BinaryGreaterEqual -> backend::syntax::BinaryGreaterEqual,
        verified::surface_expr::BinaryShiftLeft -> backend::syntax::BinaryShiftLeft,
        verified::surface_expr::BinaryShiftRight -> backend::syntax::BinaryShiftRight,
        verified::surface_expr::BinaryAdd -> backend::syntax::BinaryAdd,
        verified::surface_expr::BinarySubtract -> backend::syntax::BinarySubtract,
        verified::surface_expr::BinaryMultiply -> backend::syntax::BinaryMultiply,
        verified::surface_expr::BinaryDivide -> backend::syntax::BinaryDivide,
        verified::surface_expr::BinaryRemainder -> backend::syntax::BinaryRemainder,
        _ -> backend::syntax::InvalidBinaryOperation,
    };
}

fn pointer_null_literal(context: BodyContext, arena_count: i32,
    node: i32) -> bool {
    if (node < 0 || node >= arena_count) { return false; }
    let arena: verified::surface_expr::ExpressionArena = context.expression_arena;
    let nodes: [verified::surface_expr::ExpressionNode] = arena.data;
    let value: verified::surface_expr::ExpressionNode = nodes[node];
    return verified::surface_expr::has_kind(value.kind,
            verified::surface_expr::Literal)
        && value.operator == verified::surface_expr::LiteralInteger
        && lowering::body_context::decimal(context.source,
            context.source_length, context.tokens, context.token_count,
            value.token) == 0;
}

fn assignment_operation(operator: verified::surface_expr::ExpressionOperator)
    -> backend::syntax::AssignmentOperation {
    return match (operator) {
        verified::surface_expr::AssignmentSet -> backend::syntax::AssignmentSet,
        verified::surface_expr::AssignmentAdd -> backend::syntax::AssignmentAdd,
        verified::surface_expr::AssignmentSubtract -> backend::syntax::AssignmentSubtract,
        verified::surface_expr::AssignmentMultiply -> backend::syntax::AssignmentMultiply,
        verified::surface_expr::AssignmentDivide -> backend::syntax::AssignmentDivide,
        verified::surface_expr::AssignmentRemainder -> backend::syntax::AssignmentRemainder,
        verified::surface_expr::AssignmentBitXor -> backend::syntax::AssignmentBitXor,
        verified::surface_expr::AssignmentShiftLeft -> backend::syntax::AssignmentShiftLeft,
        verified::surface_expr::AssignmentShiftRight -> backend::syntax::AssignmentShiftRight,
        verified::surface_expr::AssignmentBitAnd -> backend::syntax::AssignmentBitAnd,
        verified::surface_expr::AssignmentBitOr -> backend::syntax::AssignmentBitOr,
        _ -> backend::syntax::InvalidAssignmentOperation,
    };
}

fn expression_untyped(context: BodyContext, arena_count: i32, node: i32,
    output: Region, position: i32, depth: i32) -> i32 {
    let arena: verified::surface_expr::ExpressionArena = context.expression_arena;
    let nodes: [verified::surface_expr::ExpressionNode] = arena.data;
    let allocation_table: lowering::allocation::Table = context.allocated;
    if (depth <= 0 || node <= -1 || node >= arena_count) { return lowering::body_context::invalid(); }
    let current_node: verified::surface_expr::ExpressionNode = nodes[node];
    let kind: verified::surface_expr::SurfaceExprKind = current_node.kind;
    if (verified::surface_expr::has_kind(kind, verified::surface_expr::Literal)) {
        let operator: verified::surface_expr::ExpressionOperator =
            current_node.operator;
        if (operator == verified::surface_expr::LiteralInteger) {
            let value: i32 = lowering::body_context::decimal(context.source, context.source_length,
                context.tokens, context.token_count,
                current_node.token);
            if (value <= -1) { return lowering::body_context::invalid(); }
            return lowering::body_event_write::expression_value(output,
                position, ir::body_events::IntegerValue(value));
        }
        if (operator == verified::surface_expr::LiteralTrue
            || operator == verified::surface_expr::LiteralFalse) {
            let value: bool =
                operator == verified::surface_expr::LiteralTrue;
            return lowering::body_event_write::expression_value(output,
                position, ir::body_events::BooleanValue(value));
        }
        if (operator == verified::surface_expr::LiteralString) {
            let memory: ptr =
                lowering::string_literal::decode(context.source,
                    context.source_length, context.tokens,
                    context.token_count, current_node.token);
            if (memory == 0) { return lowering::body_context::invalid(); }
            let header: [i32] = slice_from_raw_parts(memory, 1);
            let length: i32 = header[0];
            let value: ir::body_events::StringValue =
                ir::body_events::StringValue {
                    data: slice_from_raw_parts(
                        memory + verified::host::I32_BYTES, length),
                    length: length,
                };
            return ir::body_events::append(output, position,
                ir::body_events::ExpressionString(value));
        }
        return lowering::body_context::unsupported();
    }
    if (verified::surface_expr::has_kind(kind, verified::surface_expr::Unary)) {
        let operation: backend::syntax::UnaryOperation =
            unary_operation(current_node.operator);
        if (operation == backend::syntax::InvalidUnaryOperation) {
            return lowering::body_context::unsupported();
        }
        let next: i32 = lowering::body_event_write::expression_unary(output,
            position, operation);
        if (next <= -1) { return lowering::body_context::invalid(); }
        next = expression(context, arena_count,
            current_node.left, output, next,
            depth - 1);
        return next;
    }
    if (verified::surface_expr::has_kind(kind, verified::surface_expr::Binary)) {
        let operation: backend::syntax::BinaryOperation =
            binary_operation(current_node.operator);
        if (operation == backend::syntax::InvalidBinaryOperation) {
            return lowering::body_context::unsupported();
        }
        let next: i32 = lowering::body_event_write::expression_binary(output,
            position, operation);
        if (next <= -1) { return lowering::body_context::invalid(); }
        let pointer_comparison: bool =
            operation == backend::syntax::BinaryEqual
            || operation == backend::syntax::BinaryNotEqual;
        let left_pointer: bool = false;
        let right_pointer: bool = false;
        if (pointer_comparison) {
            left_pointer = ir::type_ref::same(kind_type(expression_kind(
                context, arena_count, current_node.left, depth - 1)),
                ir::type_ref::Pointer);
            right_pointer = ir::type_ref::same(kind_type(expression_kind(
                context, arena_count, current_node.right, depth - 1)),
                ir::type_ref::Pointer);
        }
        if (right_pointer && pointer_null_literal(context, arena_count,
                current_node.left)) {
            next = expression_expected(context, arena_count,
                current_node.left, ir::type_ref::Pointer, output, next,
                depth - 1);
        } else {
            next = expression(context, arena_count,
                current_node.left, output, next, depth - 1);
        }
        if (next <= -1) { return next; }
        if (left_pointer && pointer_null_literal(context, arena_count,
                current_node.right)) {
            return expression_expected(context, arena_count,
                current_node.right, ir::type_ref::Pointer, output, next,
                depth - 1);
        }
        return expression(context, arena_count,
            current_node.right, output, next, depth - 1);
    }
    if (verified::surface_expr::has_kind(kind, verified::surface_expr::Assign)) {
        let operation: backend::syntax::AssignmentOperation =
            assignment_operation(current_node.operator);
        if (operation == backend::syntax::InvalidAssignmentOperation) {
            return lowering::body_context::unsupported();
        }
        let target_result: ExpressionKind = expression_kind(context,
            arena_count, current_node.left, depth - 1);
        let target_kind: TypeRef = kind_type(target_result);
        if (!ir::type_ref::valid(target_kind)) {
            return kind_failure(target_result);
        }
        if (operation != backend::syntax::AssignmentSet
            && !ir::type_ref::same(target_kind, ir::type_ref::I32)
            && !ir::type_ref::same(target_kind, ir::type_ref::Usize)) {
            return lowering::body_context::unsupported();
        }
        let next: i32 = lowering::body_event_write::expression_assignment(output,
            position, operation);
        if (next <= -1) { return lowering::body_context::invalid(); }
        next = place(context, arena_count,
            current_node.left, output, next,
            depth - 1);
        if (next <= -1) { return lowering::body_context::invalid(); }
        next = expression_expected(context, arena_count,
            current_node.right, target_kind, output, next, depth - 1);
        if (next <= -1) { return lowering::body_context::invalid(); }
        return next;
    }
    if (verified::surface_expr::has_kind(kind,
        verified::surface_expr::PathExpression)) {
        let name: i32 = lowering::body_context::simple_path_token(context.expression_arena,
            arena_count, node);
        let binding: i32 = lowering::body_context::local_index(context, name);
        if (binding >= 0) {
            return lowering::body_event_write::expression_local(output, position,
                ir::body_events::LocalReference {
                    id: lowering::locals::name_at(context.locals, binding),
                });
        }
        let constant_id: i32 = lowering::body_lookup::constant_id(context,
            node);
        if (constant_id >= 0) {
            return lowering::body_event_write::expression_constant(output,
                position, constant_id);
        }
        let variant: EnumVariant = lowering::body_lookup::enum_variant(context, node);
        if (!lowering::body_lookup::is_resolved(variant)
            || lowering::body_lookup::field_count(variant) != 0) {
            return lowering::body_context::invalid();
        }
        return emit_enum_variant(context, arena_count, variant, -1, output,
            position, depth);
    }
    if (verified::surface_expr::has_kind(kind, verified::surface_expr::Index)) {
        let next: i32 = lowering::body_event_write::expression_index(output,
            position);
        next = expression(context, arena_count,
            current_node.left, output, next,
            depth - 1);
        if (next <= -1) { return lowering::body_context::invalid(); }
        next = expression(context, arena_count,
            current_node.right, output, next,
            depth - 1);
        if (next <= -1) { return lowering::body_context::invalid(); }
        return next;
    }
    if (verified::surface_expr::has_kind(kind,
        verified::surface_expr::StructValue)) {
        let path_expression: i32 = current_node.left;
        let allocation: i32 = lowering::body_lookup::nominal_allocation(context, path_expression,
            lowering::declarations::Structure);
        if (allocation <= -1) { return lowering::body_context::invalid(); }
        let allocation_row: lowering::allocation::AllocationRow =
            lowering::allocation::table_row(allocation_table, allocation);
        let type_id: i32 = lowering::allocation::row_declaration_id(
            allocation_row);
        if (!lowering::body_lookup::has_signature(context, type_id,
                lowering::signatures::StructureShape)) {
            return lowering::body_context::invalid();
        }
        let signature_row: lowering::signatures::SignatureRecord =
            lowering::signature_index::record_at(context.signature_index,
                type_id);
        let field_count: i32 = lowering::signatures::record_arity(
            signature_row);
        let first: i32 = current_node.right;
        let supplied: i32 = 0;
        let current: i32 = first;
        let fuel: i32 = arena_count;
        while (current >= 0 && fuel > 0) {
            supplied += 1;
            current = nodes[current].next;
            fuel -= 1;
        }
        if (current >= 0 || supplied != field_count) { return lowering::body_context::invalid(); }
        let next: i32 = lowering::body_event_write::expression_struct(output,
            position, ir::body_events::StructFields {
                type_id: type_id, count: field_count,
            });
        if (next <= -1) { return lowering::body_context::invalid(); }
        let field_index: i32 = 0;
        while (field_index < field_count) {
            let member: lowering::signatures::SignatureMember =
                lowering::signature_index::member_at(context.signature_index,
                    type_id, field_index);
            let field_name: i32 = member.name;
            let field_node: i32 = struct_literal_field(context, arena_count,
                first, lowering::allocation::row_unit(allocation_row),
                field_name);
            if (field_node <= -1) { return lowering::body_context::invalid(); }
            next = expression_expected(context, arena_count,
                nodes[field_node].left, member.type_tag, output, next, depth - 1);
            if (next <= -1) { return lowering::body_context::invalid(); }
            field_index += 1;
        }
        return next;
    }
    if (verified::surface_expr::has_kind(kind,
        verified::surface_expr::MatchValue)) {
        let result: ExpressionKind = match_result_kind(context, arena_count, node,
            depth - 1);
        let result_kind: ir::type_ref::TypeRef = kind_type(result);
        if (!ir::type_ref::valid(result_kind)) { return kind_failure(result); }
        let arm: i32 = current_node.right;
        let arm_count: i32 = 0;
        let fuel: i32 = arena_count;
        while (arm >= 0 && fuel > 0) {
            if (arm >= arena_count) { return lowering::body_context::invalid(); }
            arm_count += 1;
            arm = nodes[arm].next;
            fuel -= 1;
        }
        if (arm >= 0 || fuel == 0 || arm_count <= 0) { return lowering::body_context::invalid(); }
        let scrutinee_kind: ExpressionKind = expression_kind(context, arena_count,
            current_node.left, depth - 1);
        let type_id: i32 = nominal_id(scrutinee_kind);
        if (type_id <= -1) { return lowering::body_context::unsupported(); }
        let next: i32 = lowering::body_event_write::expression_match(output,
            position, ir::body_events::MatchHeader {
                result_kind: result_kind,
                scrutinee_type_id: type_id,
                arm_count: arm_count,
            });
        next = expression(context, arena_count, current_node.left,
            output, next, depth - 1);
        if (next <= -1) { return lowering::body_context::invalid(); }
        let locals: lowering::locals::Table = context.locals;
        arm = current_node.right;
        while (arm >= 0) {
            let pattern: i32 = nodes[arm].left;
            if (lowering::body_lookup::wildcard_pattern(context,
                arena_count, pattern)) {
                next = lowering::body_event_write::match_arm(output, next,
                    ir::body_events::MatchArm {
                        ordinal: -1, binding_count: 0,
                    });
                next = expression(context, arena_count,
                    nodes[arm].right, output, next, depth - 1);
                if (next <= -1) { return lowering::body_context::invalid(); }
            } else {
                let variant: EnumVariant = lowering::body_lookup::enum_pattern_variant(context,
                    arena_count, pattern, type_id);
                if (!lowering::body_lookup::is_resolved(variant)) {
                    return lowering::body_context::invalid();
                }
                next = lowering::body_event_write::match_arm(output, next,
                    ir::body_events::MatchArm {
                        ordinal: lowering::body_lookup::ordinal(variant),
                        binding_count: lowering::body_lookup::field_count(variant),
                    });
                let saved: i32 = lowering::locals::save(locals);
                if (bind_pattern_variant(context, arena_count, pattern, variant)
                    != lowering::body_lookup::field_count(variant)) {
                    lowering::locals::restore(locals, saved);
                    return lowering::body_context::invalid();
                }
                let payload: i32 = nodes[pattern].right;
                while (payload >= 0) {
                    next = lowering::body_event_write::match_binding(output, next,
                        ir::body_events::LocalReference {
                            id: lowering::body_lookup::pattern_path_token(
                                context, arena_count, payload, true),
                        });
                    payload = nodes[payload].next;
                }
                next = expression(context, arena_count,
                    nodes[arm].right, output, next,
                    depth - 1);
                lowering::locals::restore(locals, saved);
                if (next <= -1) { return lowering::body_context::invalid(); }
            }
            arm = nodes[arm].next;
        }
        return next;
    }
    if (verified::surface_expr::has_kind(kind, verified::surface_expr::Member)) {
        let base: i32 = current_node.left;
        let base_kind: ExpressionKind = expression_kind(context, arena_count, base,
            depth - 1);
        let type_id: i32 = nominal_id(base_kind);
        if (type_id <= -1) {
            return lowering::body_context::unsupported();
        }
        let field_index: i32 = structure_field(context,
            type_id, current_node.token);
        if (field_index <= -1) { return lowering::body_context::invalid(); }
        let next: i32 = lowering::body_event_write::expression_field(output,
            position, ir::body_events::FieldReference {
                index: field_index,
            });
        if (next <= -1) { return lowering::body_context::invalid(); }
        return expression(context, arena_count, base, output, next,
            depth - 1);
    }
    if (verified::surface_expr::has_kind(kind, verified::surface_expr::Call)) {
        let callee: i32 = current_node.left;
        let variant: EnumVariant = lowering::body_lookup::enum_variant(context, callee);
        if (lowering::body_lookup::is_resolved(variant)) {
            return emit_enum_variant(context, arena_count, variant,
                current_node.right, output, position,
                depth);
        }
        if (lowering::body_lookup::is_invalid(variant)) {
            return lowering::body_context::invalid();
        }
        let intrinsic: lowering::body_lookup::IntrinsicCall =
            lowering::body_lookup::intrinsic_call(context, callee);
        if (intrinsic == lowering::body_lookup::TypedSliceFromRawParts) {
            return lowering::body_context::unsupported();
        }
        let id: i32 = -1;
        if (intrinsic == lowering::body_lookup::NoIntrinsic) {
            id = lowering::body_lookup::callable_path_id(context, callee);
            if (id <= -1) { return lowering::body_context::invalid(); }
        }
        let argument: i32 = current_node.right;
        let count: i32 = 0;
        let current: i32 = argument;
        while (current >= 0) {
            if (current >= arena_count) { return lowering::body_context::invalid(); }
            count += 1;
            current = nodes[current].next;
        }
        if (intrinsic == lowering::body_lookup::NoIntrinsic) {
            if ((!lowering::body_lookup::has_signature(context, id,
                    lowering::signatures::InternalFunctionShape)
                    && !lowering::body_lookup::has_signature(context, id,
                        lowering::signatures::ExternalFunctionShape))
                || lowering::signatures::record_arity(
                    lowering::signature_index::record_at(
                        context.signature_index, id)) != count) {
                return lowering::body_context::invalid();
            }
        }
        let next: i32 = -1;
        if (intrinsic == lowering::body_lookup::NoIntrinsic) {
            next = lowering::body_event_write::expression_call(output,
                position, ir::body_events::CallHeader {
                    function_id: id, argument_count: count,
                });
        }
        if (intrinsic == lowering::body_lookup::I32SliceFromRawParts) {
            if (count != 2) { return lowering::body_context::invalid(); }
            next = ir::body_events::append(output, position,
                ir::body_events::ExpressionI32SliceFromRawParts);
        }
        if (intrinsic == lowering::body_lookup::I32SliceDataPointer) {
            if (count != 1) { return lowering::body_context::invalid(); }
            next = ir::body_events::append(output, position,
                ir::body_events::ExpressionI32SliceDataPointer);
        }
        if (intrinsic == lowering::body_lookup::StringDataPointer) {
            if (count != 1) { return lowering::body_context::invalid(); }
            next = ir::body_events::append(output, position,
                ir::body_events::ExpressionStringDataPointer);
        }
        if (next <= -1) { return lowering::body_context::invalid(); }
        current = argument;
        let argument_index: i32 = 0;
        while (current >= 0) {
            if (intrinsic == lowering::body_lookup::NoIntrinsic) {
                let parameter: lowering::signatures::SignatureMember =
                    lowering::signature_index::member_at(
                        context.signature_index, id, argument_index);
                next = expression_expected(context, arena_count, current,
                    parameter.type_tag, output, next, depth - 1);
            } else {
                let expected: TypeRef = ir::type_ref::Invalid;
                if (intrinsic == lowering::body_lookup::I32SliceFromRawParts) {
                    if (argument_index == 0) {
                        expected = ir::type_ref::Pointer;
                    } else {
                        expected = ir::type_ref::I32;
                    }
                }
                if (intrinsic == lowering::body_lookup::I32SliceDataPointer) {
                    expected = ir::type_ref::Slice;
                }
                if (intrinsic == lowering::body_lookup::StringDataPointer) {
                    expected = ir::type_ref::String;
                }
                if (!ir::type_ref::valid(expected)) {
                    return lowering::body_context::unsupported();
                }
                next = expression_expected(context, arena_count, current,
                    expected, output, next, depth - 1);
            }
            if (next <= -1) { return lowering::body_context::invalid(); }
            current = nodes[current].next;
            argument_index += 1;
        }
        return next;
    }
    return lowering::body_context::unsupported();
}

fn annotate_result(output: Region, position: i32, next: i32,
    kind: TypeRef) -> i32 {
    if (next <= -1) { return next; }
    if (!ir::body_events::record_result_type(output, position, kind)) {
        return lowering::body_context::invalid();
    }
    return next;
}

// Retain the type inferred while lowering this exact source expression. The
// event writer and the x86 backend still consume one shared body tree; the
// annotation is not a second source parse or a serialized certificate.
pub fn expression(context: BodyContext, arena_count: i32, node: i32,
    output: Region, position: i32, depth: i32) -> i32 {
    let arena: verified::surface_expr::ExpressionArena = context.expression_arena;
    let nodes: [verified::surface_expr::ExpressionNode] = arena.data;
    if (node <= -1 || node >= arena_count) {
        return lowering::body_context::invalid();
    }
    let kind: TypeRef = ir::type_ref::Invalid;
    if (verified::surface_expr::has_kind(nodes[node].kind,
            verified::surface_expr::Assign)) {
        kind = ir::type_ref::Void;
    } else {
        kind = kind_type(expression_kind(context, arena_count, node, depth));
    }
    let next: i32 = expression_untyped(context, arena_count, node,
        output, position, depth);
    if (next <= -1 || !ir::type_ref::valid_result(kind)) { return next; }
    return annotate_result(output, position, next, kind);
}

// Reuse a successful inference only for the same extracted expression and
// at least the depth budget under which it was checked. Failed inferences
// are never cached, so malformed inputs keep their original failure path.
pub fn expression_kind(context: BodyContext, arena_count: i32, node: i32,
    depth: i32) -> ExpressionKind {
    if (depth <= 0 || node <= -1 || node >= arena_count
        || node >= context.expression_arena.capacity) {
        return invalid_kind();
    }
    let codes: [i32] = context.expression_kind_codes;
    let depths: [i32] = context.expression_kind_depths;
    if (codes[node] >= 0 && depths[node] <= depth) {
        return known_kind(ir::type_ref::from_code(codes[node]));
    }
    let inferred: ExpressionKind = expression_kind_uncached(
        context, arena_count, node, depth);
    if (inferred.status == KnownExpression) {
        let code: i32 = ir::type_ref::code(inferred.kind);
        if (code >= 0) {
            codes[node] = code;
            depths[node] = depth;
        }
    }
    return inferred;
}

// Infer a typed result for local declarations and match arms. Bindings,
// signatures, and nominal declarations come from the lowering context;
// serialized type codes are not part of this query.
fn expression_kind_uncached(context: BodyContext, arena_count: i32, node: i32,
    depth: i32) -> ExpressionKind {
    let arena: verified::surface_expr::ExpressionArena = context.expression_arena;
    let nodes: [verified::surface_expr::ExpressionNode] = arena.data;
    let allocation_table: lowering::allocation::Table = context.allocated;
    if (depth <= 0 || node <= -1 || node >= arena_count) {
        return invalid_kind();
    }
    let current_node: verified::surface_expr::ExpressionNode = nodes[node];
    let kind: verified::surface_expr::SurfaceExprKind = current_node.kind;
    if (verified::surface_expr::has_kind(kind, verified::surface_expr::Literal)) {
        let operator: verified::surface_expr::ExpressionOperator =
            current_node.operator;
        if (operator == verified::surface_expr::LiteralInteger) {
            return known_kind(ir::type_ref::I32);
        }
        if (operator == verified::surface_expr::LiteralTrue
            || operator == verified::surface_expr::LiteralFalse) {
            return known_kind(ir::type_ref::Bool);
        }
        if (operator == verified::surface_expr::LiteralString) {
            return known_kind(ir::type_ref::String);
        }
        return unsupported_kind();
    }
    if (verified::surface_expr::has_kind(kind, verified::surface_expr::Unary)) {
        let operation: backend::syntax::UnaryOperation =
            unary_operation(current_node.operator);
        if (operation == backend::syntax::InvalidUnaryOperation) {
            return unsupported_kind();
        }
        let operand_result: ExpressionKind = expression_kind(context, arena_count,
            current_node.left, depth - 1);
        let operand: ir::type_ref::TypeRef = kind_type(operand_result);
        if (!ir::type_ref::valid(operand)) { return operand_result; }
        if (operation == backend::syntax::UnaryNot) {
            if (ir::type_ref::same(operand, ir::type_ref::Bool)) {
                return known_kind(ir::type_ref::Bool);
            }
            return unsupported_kind();
        }
        if ((operation == backend::syntax::UnaryPositive
                || operation == backend::syntax::UnaryNegate)
            && ir::type_ref::same(operand, ir::type_ref::I32)) {
            return known_kind(ir::type_ref::I32);
        }
        return unsupported_kind();
    }
    if (verified::surface_expr::has_kind(kind, verified::surface_expr::Binary)) {
        let operation: backend::syntax::BinaryOperation =
            binary_operation(current_node.operator);
        if (operation == backend::syntax::InvalidBinaryOperation) {
            return unsupported_kind();
        }
        let left_result: ExpressionKind = expression_kind(context, arena_count,
            current_node.left, depth - 1);
        let right_result: ExpressionKind = expression_kind(context, arena_count,
            current_node.right, depth - 1);
        let left: ir::type_ref::TypeRef = kind_type(left_result);
        let right: ir::type_ref::TypeRef = kind_type(right_result);
        if (!ir::type_ref::valid(left)) { return left_result; }
        if (!ir::type_ref::valid(right)) { return right_result; }
        if (operation == backend::syntax::BinaryAndThen
            || operation == backend::syntax::BinaryOrElse) {
            if (ir::type_ref::same(left, ir::type_ref::Bool)
                && ir::type_ref::same(right, ir::type_ref::Bool)) {
                return known_kind(ir::type_ref::Bool);
            }
            return unsupported_kind();
        }
        if (backend::syntax::binary_is_comparison(operation)) {
            let equality: bool = operation == backend::syntax::BinaryEqual
                || operation == backend::syntax::BinaryNotEqual;
            let same_kinds: bool = ir::type_ref::same(left, right);
            if (equality && same_kinds
                && (ir::type_ref::same(left, ir::type_ref::I32)
                    || ir::type_ref::same(left, ir::type_ref::Usize)
                    || ir::type_ref::same(left, ir::type_ref::Bool)
                    || ir::type_ref::same(left, ir::type_ref::Pointer))) {
                return known_kind(ir::type_ref::Bool);
            }
            if (equality && same_kinds) {
                let type_id: i32 = nominal_id(left_result);
                if (type_id >= 0 && lowering::body_lookup::has_signature(
                        context, type_id,
                        lowering::signatures::EnumerationShape)) {
                    return known_kind(ir::type_ref::Bool);
                }
            }
            if (equality
                && ((ir::type_ref::same(left, ir::type_ref::Pointer)
                        && pointer_null_literal(context, arena_count,
                            current_node.right))
                    || (ir::type_ref::same(right, ir::type_ref::Pointer)
                        && pointer_null_literal(context, arena_count,
                            current_node.left)))) {
                return known_kind(ir::type_ref::Bool);
            }
            if (same_kinds
                && (ir::type_ref::same(left, ir::type_ref::I32)
                    || ir::type_ref::same(left, ir::type_ref::Usize))) {
                return known_kind(ir::type_ref::Bool);
            }
            return unsupported_kind();
        }
        if ((operation == backend::syntax::BinaryAdd
                || operation == backend::syntax::BinarySubtract)
            && ir::type_ref::same(left, ir::type_ref::Pointer)
            && (ir::type_ref::same(right, ir::type_ref::I32)
                || ir::type_ref::same(right, ir::type_ref::Usize))) {
            return known_kind(ir::type_ref::Pointer);
        }
        if (ir::type_ref::same(left, ir::type_ref::I32)
            && ir::type_ref::same(right, ir::type_ref::I32)) {
            return known_kind(ir::type_ref::I32);
        }
        if (ir::type_ref::same(left, ir::type_ref::Usize)
            && ir::type_ref::same(right, ir::type_ref::Usize)) {
            return known_kind(ir::type_ref::Usize);
        }
        return unsupported_kind();
    }
    if (verified::surface_expr::has_kind(kind,
        verified::surface_expr::PathExpression)) {
        let name: i32 = lowering::body_context::simple_path_token(context.expression_arena,
            arena_count, node);
        let binding: i32 = lowering::body_context::local_index(context, name);
        if (binding >= 0) {
            return known_kind(lowering::locals::kind_at(context.locals,
                binding));
        }
        let constant_id: i32 = lowering::body_lookup::constant_id(context,
            node);
        if (constant_id >= 0
            && lowering::signature_index::has_shape(
                context.signature_index, constant_id,
                lowering::signatures::ConstantShape)) {
            let record: lowering::signatures::SignatureRecord =
                lowering::signature_index::record_at(
                    context.signature_index, constant_id);
            return known_kind(
                lowering::signatures::record_result_type(record));
        }
        let variant: EnumVariant = lowering::body_lookup::enum_variant(context, node);
        if (lowering::body_lookup::is_resolved(variant)
            && lowering::body_lookup::field_count(variant) == 0) {
            return known_kind(ir::type_ref::Nominal(
                lowering::body_lookup::type_id(variant)));
        }
        return unsupported_kind();
    }
    if (verified::surface_expr::has_kind(kind,
        verified::surface_expr::StructValue)) {
        let allocation: i32 = lowering::body_lookup::nominal_allocation(context,
            current_node.left,
            lowering::declarations::Structure);
        if (allocation <= -1) { return unsupported_kind(); }
        let allocation_row: lowering::allocation::AllocationRow =
            lowering::allocation::table_row(allocation_table, allocation);
        return known_kind(ir::type_ref::Nominal(
            lowering::allocation::row_declaration_id(allocation_row)));
    }
    if (verified::surface_expr::has_kind(kind,
        verified::surface_expr::MatchValue)) {
        return match_result_kind(context, arena_count, node, depth - 1);
    }
    if (verified::surface_expr::has_kind(kind, verified::surface_expr::Member)) {
        let base_kind: ExpressionKind = expression_kind(context, arena_count,
            current_node.left, depth - 1);
        let type_id: i32 = nominal_id(base_kind);
        if (type_id <= -1) { return unsupported_kind(); }
        let field_index: i32 = structure_field(context,
            type_id, current_node.token);
        if (field_index <= -1) { return unsupported_kind(); }
        let member: lowering::signatures::SignatureMember =
            lowering::signature_index::member_at(context.signature_index,
                type_id,
                field_index);
        return known_kind(member.type_tag);
    }
    if (verified::surface_expr::has_kind(kind, verified::surface_expr::Index)) {
        let base_kind: ExpressionKind = expression_kind(context, arena_count,
            current_node.left, depth - 1);
        let slice_kind: ir::type_ref::TypeRef = kind_type(base_kind);
        if (ir::type_ref::same(slice_kind, ir::type_ref::Slice)) {
            return known_kind(ir::type_ref::I32);
        }
        let nominal_element: i32 = match (slice_kind) {
            ir::type_ref::NominalSlice(id) -> id,
            _ -> -1,
        };
        if (nominal_element >= 0) {
            return known_kind(ir::type_ref::Nominal(nominal_element));
        }
        return unsupported_kind();
    }
    if (verified::surface_expr::has_kind(kind, verified::surface_expr::Call)) {
        let callee: i32 = current_node.left;
        let variant: EnumVariant = lowering::body_lookup::enum_variant(context, callee);
        if (lowering::body_lookup::is_resolved(variant)) {
            return known_kind(ir::type_ref::Nominal(
                lowering::body_lookup::type_id(variant)));
        }
        if (lowering::body_lookup::is_invalid(variant)) {
            return unsupported_kind();
        }
        let intrinsic: lowering::body_lookup::IntrinsicCall =
            lowering::body_lookup::intrinsic_call(context, callee);
        if (intrinsic == lowering::body_lookup::TypedSliceFromRawParts) {
            return unsupported_kind();
        }
        if (intrinsic == lowering::body_lookup::I32SliceFromRawParts) {
            return known_kind(ir::type_ref::Slice);
        }
        if (intrinsic == lowering::body_lookup::I32SliceDataPointer
            || intrinsic == lowering::body_lookup::StringDataPointer) {
            return known_kind(ir::type_ref::Pointer);
        }
        let id: i32 = lowering::body_lookup::callable_path_id(context, callee);
        if (id <= -1) { return unsupported_kind(); }
        if (!lowering::body_lookup::has_signature(context, id,
                lowering::signatures::InternalFunctionShape)
            && !lowering::body_lookup::has_signature(context, id,
                lowering::signatures::ExternalFunctionShape)) {
            return unsupported_kind();
        }
        let signature_row: lowering::signatures::SignatureRecord =
            lowering::signature_index::record_at(context.signature_index,
                id);
        return known_kind(
            lowering::signatures::record_result_type(signature_row));
    }
    return unsupported_kind();
}

pub fn expression_expected(context: BodyContext, arena_count: i32, node: i32,
    expected: TypeRef, output: Region, position: i32, depth: i32) -> i32 {
    let arena: verified::surface_expr::ExpressionArena = context.expression_arena;
    let nodes: [verified::surface_expr::ExpressionNode] = arena.data;
    if (depth <= 0 || node <= -1 || node >= arena_count) {
        return lowering::body_context::invalid();
    }
    let current_node: verified::surface_expr::ExpressionNode = nodes[node];
    if (ir::type_ref::same(expected, ir::type_ref::Pointer)
        && pointer_null_literal(context, arena_count, node)) {
        let next: i32 = ir::body_events::append(output, position,
            ir::body_events::ExpressionPointerNull);
        return annotate_result(output, position, next, expected);
    }
    if (ir::type_ref::same(expected, ir::type_ref::Usize)
        && verified::surface_expr::has_kind(current_node.kind,
            verified::surface_expr::Literal)
        && current_node.operator == verified::surface_expr::LiteralInteger) {
        let usize_literal: i32 = lowering::body_context::decimal(context.source,
            context.source_length, context.tokens, context.token_count,
            current_node.token);
        if (usize_literal <= -1) { return lowering::body_context::invalid(); }
        let next: i32 = ir::body_events::append(output, position,
            ir::body_events::ExpressionUsize(usize_literal));
        return annotate_result(output, position, next, expected);
    }
    if (ir::type_ref::same(expected, ir::type_ref::Usize)
        && verified::surface_expr::has_kind(current_node.kind,
            verified::surface_expr::Binary)) {
        let operation: backend::syntax::BinaryOperation =
            binary_operation(current_node.operator);
        if (operation == backend::syntax::InvalidBinaryOperation
            || backend::syntax::binary_is_comparison(operation)
            || operation == backend::syntax::BinaryAndThen
            || operation == backend::syntax::BinaryOrElse) {
            return lowering::body_context::unsupported();
        }
        let next: i32 = lowering::body_event_write::expression_binary(output,
            position, operation);
        if (next <= -1) { return lowering::body_context::invalid(); }
        next = expression_expected(context, arena_count, current_node.left,
            ir::type_ref::Usize, output, next, depth - 1);
        if (next <= -1) { return next; }
        next = expression_expected(context, arena_count, current_node.right,
            ir::type_ref::Usize, output, next, depth - 1);
        return annotate_result(output, position, next, expected);
    }
    if (!verified::surface_expr::has_kind(current_node.kind,
            verified::surface_expr::Call)
        || lowering::body_lookup::intrinsic_call(context, current_node.left)
            != lowering::body_lookup::TypedSliceFromRawParts) {
        let inferred: ExpressionKind = expression_kind(context,
            arena_count, node, depth);
        let actual: TypeRef = kind_type(inferred);
        if (!ir::type_ref::valid(actual)) {
            return kind_failure(inferred);
        }
        if (!ir::type_ref::same(actual, expected)) {
            if (ir::type_ref::same(expected, ir::type_ref::Usize)
                && ir::type_ref::same(actual, ir::type_ref::I32)) {
                let target: ir::body_events::CastTarget =
                    ir::body_events::CastTarget {
                        kind: ir::type_ref::Usize,
                    };
                let next: i32 = ir::body_events::append(output, position,
                    ir::body_events::ExpressionCast(target));
                if (next <= -1) {
                    return lowering::body_context::invalid();
                }
                next = expression(context, arena_count, node, output,
                    next, depth);
                return annotate_result(output, position, next, expected);
            }
            return lowering::body_context::unsupported();
        }
        let next: i32 = expression(context, arena_count, node,
            output, position, depth);
        return annotate_result(output, position, next, expected);
    }
    let element: ir::body_events::SliceElement = ir::body_events::SliceElement {
        kind: ir::body_events::I32Slice, id: 0,
    };
    if (!ir::type_ref::same(expected, ir::type_ref::Slice)) {
        let id: i32 = match (expected) {
            ir::type_ref::NominalSlice(value) -> value,
            _ -> -1,
        };
        if (id <= -1) { return lowering::body_context::unsupported(); }
        if (lowering::body_lookup::has_signature(context, id,
                lowering::signatures::StructureShape)) {
            element = ir::body_events::SliceElement {
                kind: ir::body_events::StructureSlice, id: id,
            };
        } else {
            if (!lowering::body_lookup::has_signature(context, id,
                    lowering::signatures::EnumerationShape)) {
                return lowering::body_context::unsupported();
            }
            element = ir::body_events::SliceElement {
                kind: ir::body_events::EnumerationSlice, id: id,
            };
        }
    }
    let first: i32 = current_node.right;
    if (first <= -1 || first >= arena_count
        || nodes[first].next <= -1 || nodes[first].next >= arena_count
        || nodes[nodes[first].next].next >= 0) {
        return lowering::body_context::invalid();
    }
    // Both source spellings have the same packed-i32 semantics. Keep one
    // canonical IR constructor so Lean and x86 share the implemented path.
    let next: i32 = -1;
    if (ir::type_ref::same(expected, ir::type_ref::Slice)) {
        next = ir::body_events::append(output, position,
            ir::body_events::ExpressionI32SliceFromRawParts);
    } else {
        next = ir::body_events::append(output, position,
            ir::body_events::ExpressionTypedSliceFromRawParts(element));
    }
    if (next <= -1) { return lowering::body_context::invalid(); }
    next = expression_expected(context, arena_count, first,
        ir::type_ref::Pointer, output, next, depth - 1);
    if (next <= -1) { return next; }
    next = expression_expected(context, arena_count, nodes[first].next,
        ir::type_ref::I32, output, next, depth - 1);
    return annotate_result(output, position, next, expected);
}

pub fn extract_expression(context: BodyContext, surface: i32, depth: i32) -> i32 {
    let input: verified::surface_expr::ExpressionInput =
        verified::surface_expr::ExpressionInput {
            tree: context.tree,
            root: surface,
            depth: depth,
        };
    let root: i32 = verified::surface_expr::extract(input,
        context.expression_arena);
    if (root < 0) { return root; }
    let count: i32 = verified::surface_expr::node_count(
        context.expression_arena);
    if (count <= 0 || count > context.expression_arena.capacity) {
        return lowering::body_context::invalid();
    }
    let codes: [i32] = context.expression_kind_codes;
    let index: i32 = 0;
    while (index < count) {
        codes[index] = -1;
        index += 1;
    }
    return root;
}

pub fn expression_from_surface(context: BodyContext, surface: i32,
    output: Region, position: i32, depth: i32) -> i32 {
    let arena: verified::surface_expr::ExpressionArena = context.expression_arena;
    let root: i32 = extract_expression(context, surface, depth);
    if (root <= -1
        || verified::surface_expr::node_count(arena) <= 0) {
        return lowering::body_context::invalid();
    }
    let count: i32 = verified::surface_expr::node_count(arena);
    let nodes: [verified::surface_expr::ExpressionNode] = arena.data;
    if (!verified::surface_expr::has_kind(nodes[root].kind,
            verified::surface_expr::Assign)) {
        let inferred: ExpressionKind = expression_kind(context, count,
            root, depth);
        if (!ir::type_ref::valid_result(kind_type(inferred))) {
            return kind_failure(inferred);
        }
    }
    return expression(context,
        count, root, output,
        position, depth);
}

pub fn expression_from_surface_expected(context: BodyContext, surface: i32,
    expected: TypeRef, output: Region, position: i32, depth: i32) -> i32 {
    let arena: verified::surface_expr::ExpressionArena = context.expression_arena;
    let root: i32 = extract_expression(context, surface, depth);
    if (root <= -1 || verified::surface_expr::node_count(arena) <= 0) {
        return lowering::body_context::invalid();
    }
    return expression_expected(context,
        verified::surface_expr::node_count(arena), root, expected, output,
        position, depth);
}
