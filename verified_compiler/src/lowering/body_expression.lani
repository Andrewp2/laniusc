module lowering::body_expression;

import verified::production;
import backend::syntax;
import lowering::allocation;
import lowering::body_context;
import lowering::body_lookup;
import lowering::declarations;
import lowering::locals;
import lowering::signatures;
import lowering::signature_index;
import verified::surface_expr;

type BodyContext = lowering::body_context::BodyContext;
type EnumVariant = lowering::body_lookup::EnumVariant;

fn emit_enum_variant(context: BodyContext, arena_count: i32,
    variant: EnumVariant, first: i32, output: [i32], capacity: i32,
    position: i32, depth: i32) -> i32 {
    if (!lowering::body_lookup::enum_lookup_is(variant.state, lowering::body_lookup::EnumResolved)) { return lowering::body_context::invalid(); }
    let arena: verified::surface_expr::ExpressionArena = context.expression_arena;
    let nodes: [verified::surface_expr::ExpressionNode] = arena.data;
    let count: i32 = 0;
    let current: i32 = first;
    let fuel: i32 = arena_count;
    while (current >= 0 && fuel > 0) {
        if (current >= arena_count) { return lowering::body_context::invalid(); }
        count += 1;
        current = nodes[current].next;
        fuel -= 1;
    }
    if (current >= 0 || count != variant.field_count) { return lowering::body_context::invalid(); }
    let next: i32 = lowering::body_context::append(output, capacity, position,
        backend::syntax::expression_code(backend::syntax::ExprEnumeration));
    next = lowering::body_context::append(output, capacity, next,
        backend::syntax::NOMINAL_TYPE_BASE + variant.type_id);
    next = lowering::body_context::append(output, capacity, next, variant.ordinal);
    next = lowering::body_context::append(output, capacity, next, variant.field_count);
    current = first;
    while (current >= 0) {
        next = expression(context, arena_count, current, output, capacity,
            next, depth - 1);
        if (next <= -1) { return lowering::body_context::invalid(); }
        current = nodes[current].next;
    }
    return next;
}

fn bind_pattern_payload(context: BodyContext, arena_count: i32,
    pattern: i32, variant: EnumVariant) -> i32 {
    let arena: verified::surface_expr::ExpressionArena = context.expression_arena;
    let nodes: [verified::surface_expr::ExpressionNode] = arena.data;
    let locals: lowering::locals::Table = context.locals;
    let first: i32 = nodes[pattern].right;
    if (lowering::body_lookup::pattern_payload_count(context, arena_count, first)
        != variant.field_count) { return lowering::body_context::invalid(); }
    let saved: i32 = lowering::locals::save(locals);
    let current: i32 = first;
    let payload_index: i32 = 0;
    let field_count: i32 = variant.field_count;
    while (payload_index != field_count) {
        if (current <= -1 || current >= arena_count
            || nodes[current].right != -1) {
            lowering::locals::restore(locals, saved);
            return lowering::body_context::unsupported();
        }
        let name: i32 = lowering::body_lookup::pattern_path_token(context, arena_count, current,
            true);
        if (name <= -1) {
            lowering::locals::restore(locals, saved);
            return lowering::body_context::unsupported();
        }
        let binding: i32 = saved;
        while (binding < lowering::locals::save(locals)) {
            if (lowering::body_context::same_token(context.source, context.source_length,
                    context.tokens, context.token_count,
                    lowering::locals::name_at(locals, binding), name)) {
                lowering::locals::restore(locals, saved);
                return lowering::body_context::invalid();
            }
            binding += 1;
        }
        let field_kind: i32 = lowering::body_lookup::enum_variant_field_kind(context, variant,
            payload_index);
        if (field_kind <= -1 || !lowering::locals::bind(context.locals, name, field_kind)) {
            lowering::locals::restore(locals, saved);
            return lowering::body_context::invalid();
        }
        current = nodes[current].next;
        payload_index += 1;
    }
    return variant.field_count;
}

fn match_result_kind(context: BodyContext, arena_count: i32, node: i32,
    depth: i32) -> i32 {
    let arena: verified::surface_expr::ExpressionArena = context.expression_arena;
    let nodes: [verified::surface_expr::ExpressionNode] = arena.data;
    let locals: lowering::locals::Table = context.locals;
    if (node <= -1 || node >= arena_count
        || !verified::surface_expr::has_kind(nodes[node].kind,
            verified::surface_expr::MatchValue)) { return lowering::body_context::unsupported(); }
    let scrutinee_kind: i32 = expression_kind(context, arena_count,
        nodes[node].left, depth - 1);
    if (scrutinee_kind < backend::syntax::NOMINAL_TYPE_BASE) {
        return lowering::body_context::unsupported();
    }
    let type_id: i32 = scrutinee_kind - backend::syntax::NOMINAL_TYPE_BASE;
    if (!lowering::body_lookup::has_signature(context, type_id,
        lowering::signatures::EnumerationShape)) {
        return lowering::body_context::unsupported();
    }
    let first: i32 = nodes[node].right;
    let arm: i32 = first;
    let arms: i32 = 0;
    let result_kind: i32 = -1;
    let fuel: i32 = arena_count;
    while (arm >= 0 && fuel > 0) {
        if (arm >= arena_count
            || !verified::surface_expr::has_kind(nodes[arm].kind,
                verified::surface_expr::MatchArm)) { return lowering::body_context::invalid(); }
        let pattern: i32 = nodes[arm].left;
        let variant: EnumVariant = lowering::body_lookup::enum_pattern_variant(context, arena_count,
            pattern, type_id);
        if (!lowering::body_lookup::enum_lookup_is(variant.state, lowering::body_lookup::EnumResolved)) { return lowering::body_context::invalid(); }
        let prior: i32 = first;
        while (prior >= 0 && prior != arm) {
            let prior_variant: EnumVariant = lowering::body_lookup::enum_pattern_variant(context,
                arena_count, nodes[prior].left, type_id);
            if (!lowering::body_lookup::enum_lookup_is(prior_variant.state, lowering::body_lookup::EnumResolved)
                || prior_variant.ordinal == variant.ordinal) {
                return lowering::body_context::invalid();
            }
            prior = nodes[prior].next;
        }
        let saved: i32 = lowering::locals::save(locals);
        if (bind_pattern_payload(context, arena_count, pattern, variant)
            <= -1) {
            lowering::locals::restore(locals, saved);
            return lowering::body_context::invalid();
        }
        let arm_kind: i32 = expression_kind(context, arena_count,
            nodes[arm].right, depth - 1);
        lowering::locals::restore(locals, saved);
        if (arm_kind <= -1 || (result_kind >= 0 && result_kind != arm_kind)) {
            return lowering::body_context::unsupported();
        }
        result_kind = arm_kind;
        arm = nodes[arm].next;
        arms += 1;
        fuel -= 1;
    }
    let signature_record: lowering::signatures::SignatureRecord =
        lowering::signature_index::record_at(context.signature_index,
            type_id);
    if (arm >= 0 || fuel == 0 || arms <= 0
        || arms != lowering::signatures::record_arity(signature_record)) {
        return lowering::body_context::invalid();
    }
    return result_kind;
}

fn structure_field(context: BodyContext, type_id: i32, name: i32) -> i32 {
    if (name <= -1 || !lowering::body_lookup::has_signature(context,
        type_id, lowering::signatures::StructureShape)) {
        return lowering::body_context::invalid();
    }
    let record: lowering::signatures::SignatureRecord =
        lowering::signature_index::record_at(context.signature_index,
            type_id);
    if (!lowering::signatures::record_has_shape(record,
            lowering::signatures::StructureShape)) { return lowering::body_context::invalid(); }
    let field_index: i32 = 0;
    while (field_index != lowering::signatures::record_arity(record)) {
        let member: lowering::signatures::SignatureMember =
            lowering::signature_index::member_at(context.signature_index,
                type_id, field_index);
        let field_name: i32 = member.name;
        if (lowering::body_context::same_token(context.source, context.source_length, context.tokens,
            context.token_count, name, field_name)) { return field_index; }
        field_index += 1;
    }
    return lowering::body_context::invalid();
}

fn struct_literal_field(context: BodyContext, arena_count: i32, first: i32,
    expected_name: i32) -> i32 {
    let arena: verified::surface_expr::ExpressionArena = context.expression_arena;
    let nodes: [verified::surface_expr::ExpressionNode] = arena.data;
    let current: i32 = first;
    let found: i32 = -1;
    let fuel: i32 = arena_count;
    while (current >= 0 && fuel > 0) {
        if (current >= arena_count
            || !verified::surface_expr::has_kind(
                nodes[current].kind,
                verified::surface_expr::StructField)) { return lowering::body_context::invalid(); }
        let name: i32 = nodes[current].token;
        if (lowering::body_context::same_token(context.source, context.source_length, context.tokens,
            context.token_count, name, expected_name)) {
            if (found >= 0) { return lowering::body_context::invalid(); }
            found = current;
        }
        current = nodes[current].next;
        fuel -= 1;
    }
    if (current >= 0 || fuel == 0) { return lowering::body_context::invalid(); }
    return found;
}

// Assignment targets are deliberately narrower than general expressions:
// only one-segment local paths and recursively indexed places have a canonical
// backend representation in this lowering stage.
fn place(context: BodyContext, arena_count: i32, node: i32,
    output: [i32], capacity: i32, position: i32, depth: i32) -> i32 {
    let arena: verified::surface_expr::ExpressionArena = context.expression_arena;
    let nodes: [verified::surface_expr::ExpressionNode] = arena.data;
    if (depth <= 0 || node <= -1 || node >= arena_count) { return lowering::body_context::invalid(); }
    let current_node: verified::surface_expr::ExpressionNode = nodes[node];
    let kind: verified::surface_expr::SurfaceExprKind = current_node.kind;
    if (verified::surface_expr::has_kind(kind,
        verified::surface_expr::PathExpression)) {
        let name: i32 = lowering::body_context::simple_path_token(context.expression_arena,
            arena_count, node);
        if (name <= -1 || name >= context.token_count) { return lowering::body_context::invalid(); }
        let binding: i32 = lowering::body_context::local_index(context, name);
        if (binding <= -1) { return lowering::body_context::invalid(); }
        let declaration: i32 = lowering::locals::name_at(context.locals,
            binding);
        let next: i32 = lowering::body_context::append(output, capacity, position, backend::syntax::place_code(backend::syntax::PlaceLocal));
        next = lowering::body_context::append(output, capacity, next, declaration);
        return next;
    }
    if (verified::surface_expr::has_kind(kind, verified::surface_expr::Index)) {
        let next: i32 = lowering::body_context::append(output, capacity, position, backend::syntax::place_code(backend::syntax::PlaceIndex));
        if (next <= -1) { return next; }
        next = place(context, arena_count,
            current_node.left, output, capacity, next,
            depth - 1);
        if (next <= -1) { return next; }
        return expression(context, arena_count,
            current_node.right, output, capacity, next,
            depth - 1);
    }
    if (verified::surface_expr::has_kind(kind, verified::surface_expr::Member)) {
        let base: i32 = current_node.left;
        let base_kind: i32 = expression_kind(context, arena_count, base,
            depth - 1);
        if (base_kind <= backend::syntax::NOMINAL_TYPE_BASE - 1) {
            return lowering::body_context::unsupported();
        }
        let field_index: i32 = structure_field(context,
            base_kind - backend::syntax::NOMINAL_TYPE_BASE,
            current_node.token);
        if (field_index <= -1) { return lowering::body_context::invalid(); }
        let next: i32 = lowering::body_context::append(output, capacity, position,
            backend::syntax::place_code(backend::syntax::PlaceField));
        next = lowering::body_context::append(output, capacity, next, field_index);
        if (next <= -1) { return lowering::body_context::invalid(); }
        return place(context, arena_count, base, output, capacity, next,
            depth - 1);
    }
    return lowering::body_context::unsupported();
}

fn unary_operation(production: i32) -> i32 {
    if (production == verified::production::POS) {
        return backend::syntax::unary_code(
            backend::syntax::UnaryPositive);
    }
    if (production == verified::production::NEG) {
        return backend::syntax::unary_code(
            backend::syntax::UnaryNegate);
    }
    if (production == verified::production::NOT) {
        return backend::syntax::unary_code(
            backend::syntax::UnaryNot);
    }
    return lowering::body_context::unsupported();
}

pub fn expression(context: BodyContext, arena_count: i32, node: i32,
    output: [i32], capacity: i32, position: i32, depth: i32) -> i32 {
    let arena: verified::surface_expr::ExpressionArena = context.expression_arena;
    let nodes: [verified::surface_expr::ExpressionNode] = arena.data;
    let allocation_table: lowering::allocation::Table = context.allocated;
    if (depth <= 0 || node <= -1 || node >= arena_count) { return lowering::body_context::invalid(); }
    let current_node: verified::surface_expr::ExpressionNode = nodes[node];
    let kind: verified::surface_expr::SurfaceExprKind = current_node.kind;
    if (verified::surface_expr::has_kind(kind, verified::surface_expr::Literal)) {
        let next: i32 = lowering::body_context::append(output, capacity, position, backend::syntax::expression_code(backend::syntax::ExprValue));
        if (next <= -1) { return lowering::body_context::invalid(); }
        let production: i32 = current_node.production;
        if (production == verified::production::INT) {
            let value: i32 = lowering::body_context::decimal(context.source, context.source_length,
                context.tokens, context.token_count,
                current_node.token);
            if (value <= -1) { return lowering::body_context::invalid(); }
            next = lowering::body_context::append(output, capacity, next, backend::syntax::type_code(backend::syntax::TypeI32));
            next = lowering::body_context::append(output, capacity, next, value);
            return next;
        }
        if (production == verified::production::TRUE || production == verified::production::FALSE) {
            next = lowering::body_context::append(output, capacity, next, backend::syntax::type_code(backend::syntax::TypeBool));
            let value: i32 = 0;
            if (production == verified::production::TRUE) { value = 1; }
            next = lowering::body_context::append(output, capacity, next, value);
        return next;
    }
        return lowering::body_context::unsupported();
}
    if (verified::surface_expr::has_kind(kind, verified::surface_expr::Unary)) {
        let operation: i32 = unary_operation(current_node.production);
        if (operation <= -1) { return lowering::body_context::unsupported(); }
        let next: i32 = lowering::body_context::append(output, capacity, position, backend::syntax::expression_code(backend::syntax::ExprUnary));
        next = lowering::body_context::append(output, capacity, next, operation);
        if (next <= -1) { return lowering::body_context::invalid(); }
        next = expression(context, arena_count,
            current_node.left, output, capacity, next,
            depth - 1);
        return next;
    }
    if (verified::surface_expr::has_kind(kind, verified::surface_expr::Binary)) {
        let production: i32 = current_node.production;
        let operation: i32 = -1;
        if (production == verified::production::OR_TAIL) { operation = backend::syntax::binary_code(backend::syntax::BinaryOrElse); }
        if (production == verified::production::AND_TAIL) { operation = backend::syntax::binary_code(backend::syntax::BinaryAndThen); }
        if (production == verified::production::BOR_TAIL) { operation = backend::syntax::binary_code(backend::syntax::BinaryBitOr); }
        if (production == verified::production::XOR_TAIL) { operation = backend::syntax::binary_code(backend::syntax::BinaryBitXor); }
        if (production == verified::production::BAND_TAIL) { operation = backend::syntax::binary_code(backend::syntax::BinaryBitAnd); }
        if (production == verified::production::EQ_TAIL) { operation = backend::syntax::binary_code(backend::syntax::BinaryEqual); }
        if (production == verified::production::NE_TAIL) { operation = backend::syntax::binary_code(backend::syntax::BinaryNotEqual); }
        if (production == verified::production::LT_TAIL) { operation = backend::syntax::binary_code(backend::syntax::BinaryLess); }
        if (production == verified::production::GT_TAIL) { operation = backend::syntax::binary_code(backend::syntax::BinaryGreater); }
        if (production == verified::production::LE_TAIL) { operation = backend::syntax::binary_code(backend::syntax::BinaryLessEqual); }
        if (production == verified::production::GE_TAIL) { operation = backend::syntax::binary_code(backend::syntax::BinaryGreaterEqual); }
        if (production == verified::production::SHL_TAIL) { operation = backend::syntax::binary_code(backend::syntax::BinaryShiftLeft); }
        if (production == verified::production::SHR_TAIL) { operation = backend::syntax::binary_code(backend::syntax::BinaryShiftRight); }
        if (production == verified::production::ADD_TAIL) { operation = backend::syntax::binary_code(backend::syntax::BinaryAdd); }
        if (production == verified::production::SUB_TAIL) { operation = backend::syntax::binary_code(backend::syntax::BinarySubtract); }
        if (production == verified::production::MUL_TAIL) { operation = backend::syntax::binary_code(backend::syntax::BinaryMultiply); }
        if (production == verified::production::DIV_TAIL) { operation = backend::syntax::binary_code(backend::syntax::BinaryDivide); }
        if (production == verified::production::MOD_TAIL) { operation = backend::syntax::binary_code(backend::syntax::BinaryRemainder); }
        if (operation <= -1) { return lowering::body_context::unsupported(); }
        let next: i32 = lowering::body_context::append(output, capacity, position, backend::syntax::expression_code(backend::syntax::ExprBinary));
        next = lowering::body_context::append(output, capacity, next, operation);
        if (next <= -1) { return lowering::body_context::invalid(); }
        next = expression(context, arena_count,
            current_node.left, output, capacity, next,
            depth - 1);
        return expression(context, arena_count,
            current_node.right, output, capacity, next,
            depth - 1);
    }
    if (verified::surface_expr::has_kind(kind, verified::surface_expr::Assign)) {
        let operation: i32 = current_node.production
            - verified::production::ASSIGN_SET;
        if (!backend::syntax::valid_assignment_code(operation)) {
            return lowering::body_context::unsupported();
        }
        let next: i32 = lowering::body_context::append(output, capacity, position, backend::syntax::expression_code(backend::syntax::ExprAssign));
        next = lowering::body_context::append(output, capacity, next, operation);
        if (next <= -1) { return lowering::body_context::invalid(); }
        next = place(context, arena_count,
            current_node.left, output, capacity, next,
            depth - 1);
        if (next <= -1) { return lowering::body_context::invalid(); }
        next = expression(context, arena_count,
            current_node.right, output, capacity, next,
            depth - 1);
        if (next <= -1) { return lowering::body_context::invalid(); }
        return next;
    }
    if (verified::surface_expr::has_kind(kind,
        verified::surface_expr::PathExpression)) {
        let name: i32 = lowering::body_context::simple_path_token(context.expression_arena,
            arena_count, node);
        let binding: i32 = lowering::body_context::local_index(context, name);
        if (binding >= 0) {
            let next: i32 = lowering::body_context::append(output, capacity, position,
                backend::syntax::expression_code(backend::syntax::ExprLocal));
            return lowering::body_context::append(output, capacity, next,
                lowering::locals::name_at(context.locals, binding));
        }
        let variant: EnumVariant = lowering::body_lookup::enum_variant(context, node);
        if (!lowering::body_lookup::enum_lookup_is(variant.state, lowering::body_lookup::EnumResolved)
            || variant.field_count != 0) { return lowering::body_context::invalid(); }
        return emit_enum_variant(context, arena_count, variant, -1, output,
            capacity, position, depth);
    }
    if (verified::surface_expr::has_kind(kind, verified::surface_expr::Index)) {
        let next: i32 = lowering::body_context::append(output, capacity, position, backend::syntax::expression_code(backend::syntax::ExprIndex));
        next = expression(context, arena_count,
            current_node.left, output, capacity, next,
            depth - 1);
        if (next <= -1) { return lowering::body_context::invalid(); }
        next = expression(context, arena_count,
            current_node.right, output, capacity, next,
            depth - 1);
        if (next <= -1) { return lowering::body_context::invalid(); }
        return next;
    }
    if (verified::surface_expr::has_kind(kind,
        verified::surface_expr::StructValue)) {
        let path_expression: i32 = current_node.left;
        let allocation: i32 = lowering::body_lookup::nominal_allocation(context, path_expression,
            lowering::declarations::Structure);
        if (allocation <= -1) { return lowering::body_context::invalid(); }
        let allocation_row: lowering::allocation::AllocationRow =
            lowering::allocation::table_row(allocation_table, allocation);
        let type_id: i32 = lowering::allocation::row_declaration_id(
            allocation_row);
        if (!lowering::body_lookup::has_signature(context, type_id,
            lowering::signatures::StructureShape)) {
            return lowering::body_context::invalid();
        }
        let signature_row: lowering::signatures::SignatureRecord =
            lowering::signature_index::record_at(context.signature_index,
                type_id);
        let field_count: i32 = lowering::signatures::record_arity(
            signature_row);
        let first: i32 = current_node.right;
        let supplied: i32 = 0;
        let current: i32 = first;
        let fuel: i32 = arena_count;
        while (current >= 0 && fuel > 0) {
            supplied += 1;
            current = nodes[current].next;
            fuel -= 1;
        }
        if (current >= 0 || supplied != field_count) { return lowering::body_context::invalid(); }
        let next: i32 = lowering::body_context::append(output, capacity, position,
            backend::syntax::expression_code(backend::syntax::ExprStruct));
        next = lowering::body_context::append(output, capacity, next,
            backend::syntax::NOMINAL_TYPE_BASE + type_id);
        next = lowering::body_context::append(output, capacity, next, field_count);
        if (next <= -1) { return lowering::body_context::invalid(); }
        let field_index: i32 = 0;
        while (field_index < field_count) {
            let member: lowering::signatures::SignatureMember =
                lowering::signature_index::member_at(context.signature_index,
                    type_id, field_index);
            let field_name: i32 = member.name;
            let field_node: i32 = struct_literal_field(context, arena_count,
                first, field_name);
            if (field_node <= -1) { return lowering::body_context::invalid(); }
            next = expression(context, arena_count,
                nodes[field_node].left, output,
                capacity, next, depth - 1);
            if (next <= -1) { return lowering::body_context::invalid(); }
            field_index += 1;
        }
        return next;
    }
    if (verified::surface_expr::has_kind(kind,
        verified::surface_expr::MatchValue)) {
        let result_kind: i32 = match_result_kind(context, arena_count, node,
            depth - 1);
        if (result_kind <= -1) { return result_kind; }
        let arm: i32 = current_node.right;
        let arm_count: i32 = 0;
        let fuel: i32 = arena_count;
        while (arm >= 0 && fuel > 0) {
            if (arm >= arena_count) { return lowering::body_context::invalid(); }
            arm_count += 1;
            arm = nodes[arm].next;
            fuel -= 1;
        }
        if (arm >= 0 || fuel == 0 || arm_count <= 0) { return lowering::body_context::invalid(); }
        let next: i32 = lowering::body_context::append(output, capacity, position,
            backend::syntax::expression_code(backend::syntax::ExprMatch));
        next = lowering::body_context::append(output, capacity, next, result_kind);
        next = lowering::body_context::append(output, capacity, next, arm_count);
        next = expression(context, arena_count, current_node.left,
            output, capacity, next, depth - 1);
        if (next <= -1) { return lowering::body_context::invalid(); }
        let scrutinee_kind: i32 = expression_kind(context, arena_count,
            current_node.left, depth - 1);
        let type_id: i32 = scrutinee_kind
            - backend::syntax::NOMINAL_TYPE_BASE;
        let locals: lowering::locals::Table = context.locals;
        arm = current_node.right;
        while (arm >= 0) {
            let pattern: i32 = nodes[arm].left;
            let variant: EnumVariant = lowering::body_lookup::enum_pattern_variant(context,
                arena_count, pattern, type_id);
            if (!lowering::body_lookup::enum_lookup_is(variant.state, lowering::body_lookup::EnumResolved)) {
                return lowering::body_context::invalid();
            }
            next = lowering::body_context::append(output, capacity, next, variant.ordinal);
            next = lowering::body_context::append(output, capacity, next, variant.field_count);
            let saved: i32 = lowering::locals::save(locals);
            if (bind_pattern_payload(context, arena_count, pattern, variant)
                != variant.field_count) {
                lowering::locals::restore(locals, saved);
                return lowering::body_context::invalid();
            }
            let payload: i32 = nodes[pattern].right;
            while (payload >= 0) {
                next = lowering::body_context::append(output, capacity, next,
                    lowering::body_lookup::pattern_path_token(context, arena_count, payload, true));
                payload = nodes[payload].next;
            }
            next = expression(context, arena_count,
                nodes[arm].right, output, capacity, next,
                depth - 1);
            lowering::locals::restore(locals, saved);
            if (next <= -1) { return lowering::body_context::invalid(); }
            arm = nodes[arm].next;
        }
        return next;
    }
    if (verified::surface_expr::has_kind(kind, verified::surface_expr::Member)) {
        let base: i32 = current_node.left;
        let base_kind: i32 = expression_kind(context, arena_count, base,
            depth - 1);
        if (base_kind <= backend::syntax::NOMINAL_TYPE_BASE - 1) {
            return lowering::body_context::unsupported();
        }
        let field_index: i32 = structure_field(context,
            base_kind - backend::syntax::NOMINAL_TYPE_BASE,
            current_node.token);
        if (field_index <= -1) { return lowering::body_context::invalid(); }
        let next: i32 = lowering::body_context::append(output, capacity, position,
            backend::syntax::expression_code(backend::syntax::ExprField));
        next = lowering::body_context::append(output, capacity, next, field_index);
        if (next <= -1) { return lowering::body_context::invalid(); }
        return expression(context, arena_count, base, output, capacity, next,
            depth - 1);
    }
    if (verified::surface_expr::has_kind(kind, verified::surface_expr::Call)) {
        let callee: i32 = current_node.left;
        let variant: EnumVariant = lowering::body_lookup::enum_variant(context, callee);
        if (lowering::body_lookup::enum_lookup_is(variant.state, lowering::body_lookup::EnumResolved)) {
            return emit_enum_variant(context, arena_count, variant,
                current_node.right, output, capacity, position,
                depth);
        }
        if (lowering::body_lookup::enum_lookup_is(variant.state, lowering::body_lookup::EnumInvalid)) { return lowering::body_context::invalid(); }
        let qualified: bool = lowering::body_context::path_is_qualified(context.expression_arena,
            arena_count, callee);
        let name: i32 = lowering::body_context::qualified_path_token(context.expression_arena,
            arena_count, callee);
        if (name <= -1 || name >= context.token_count) { return lowering::body_context::invalid(); }
        let id: i32 = lowering::body_lookup::callable_id(context, qualified, name);
        if (id <= -1) { return lowering::body_context::invalid(); }
        let next: i32 = lowering::body_context::append(output, capacity, position, backend::syntax::expression_code(backend::syntax::ExprCall));
        next = lowering::body_context::append(output, capacity, next, id);
        let argument: i32 = current_node.right;
        let count: i32 = 0;
        let current: i32 = argument;
        while (current >= 0) {
            if (current >= arena_count) { return lowering::body_context::invalid(); }
            count += 1;
            current = nodes[current].next;
        }
        next = lowering::body_context::append(output, capacity, next, count);
        current = argument;
        while (current >= 0) {
            next = expression(context, arena_count, current, output, capacity,
                next, depth - 1);
            if (next <= -1) { return lowering::body_context::invalid(); }
            current = nodes[current].next;
        }
        return next;
    }
    return lowering::body_context::unsupported();
}

// Inferred lets need the scalar kind before their initializer is serialized.
// Keep this query aligned with the expression emitter and deliberately close:
// literals and scalar unary/binary expressions have a syntax-local result kind;
// paths, calls, aggregates, and assignments require a lexical type environment
// which this transport boundary does not carry.
pub fn expression_kind(context: BodyContext, arena_count: i32, node: i32,
    depth: i32) -> i32 {
    let arena: verified::surface_expr::ExpressionArena = context.expression_arena;
    let nodes: [verified::surface_expr::ExpressionNode] = arena.data;
    let allocation_table: lowering::allocation::Table = context.allocated;
    if (depth <= 0 || node <= -1 || node >= arena_count) { return lowering::body_context::invalid(); }
    let current_node: verified::surface_expr::ExpressionNode = nodes[node];
    let kind: verified::surface_expr::SurfaceExprKind = current_node.kind;
    if (verified::surface_expr::has_kind(kind, verified::surface_expr::Literal)) {
        let production: i32 = current_node.production;
        if (production == verified::production::INT) { return backend::syntax::type_code(backend::syntax::TypeI32); }
        if (production == verified::production::TRUE || production == verified::production::FALSE) { return backend::syntax::type_code(backend::syntax::TypeBool); }
        return lowering::body_context::unsupported();
    }
    if (verified::surface_expr::has_kind(kind, verified::surface_expr::Unary)) {
        let operation: i32 = unary_operation(current_node.production);
        if (operation <= -1) { return lowering::body_context::unsupported(); }
        let operand: i32 = expression_kind(context, arena_count,
            current_node.left, depth - 1);
        if (operand <= -1) { return operand; }
        if (operation == backend::syntax::unary_code(backend::syntax::UnaryNot)) {
            if (operand == backend::syntax::type_code(backend::syntax::TypeBool)) { return backend::syntax::type_code(backend::syntax::TypeBool); }
            return lowering::body_context::unsupported();
        }
        if ((operation == backend::syntax::unary_code(backend::syntax::UnaryPositive) || operation == backend::syntax::unary_code(backend::syntax::UnaryNegate))
            && operand == backend::syntax::type_code(backend::syntax::TypeI32)) { return backend::syntax::type_code(backend::syntax::TypeI32); }
        return lowering::body_context::unsupported();
    }
    if (verified::surface_expr::has_kind(kind, verified::surface_expr::Binary)) {
        let operation: i32 = -1;
        let production: i32 = current_node.production;
        if (production == verified::production::OR_TAIL) { operation = backend::syntax::binary_code(backend::syntax::BinaryOrElse); }
        if (production == verified::production::AND_TAIL) { operation = backend::syntax::binary_code(backend::syntax::BinaryAndThen); }
        if (production == verified::production::BOR_TAIL) { operation = backend::syntax::binary_code(backend::syntax::BinaryBitOr); }
        if (production == verified::production::XOR_TAIL) { operation = backend::syntax::binary_code(backend::syntax::BinaryBitXor); }
        if (production == verified::production::BAND_TAIL) { operation = backend::syntax::binary_code(backend::syntax::BinaryBitAnd); }
        if (production == verified::production::EQ_TAIL) { operation = backend::syntax::binary_code(backend::syntax::BinaryEqual); }
        if (production == verified::production::NE_TAIL) { operation = backend::syntax::binary_code(backend::syntax::BinaryNotEqual); }
        if (production == verified::production::LT_TAIL) { operation = backend::syntax::binary_code(backend::syntax::BinaryLess); }
        if (production == verified::production::GT_TAIL) { operation = backend::syntax::binary_code(backend::syntax::BinaryGreater); }
        if (production == verified::production::LE_TAIL) { operation = backend::syntax::binary_code(backend::syntax::BinaryLessEqual); }
        if (production == verified::production::GE_TAIL) { operation = backend::syntax::binary_code(backend::syntax::BinaryGreaterEqual); }
        if (production == verified::production::SHL_TAIL) { operation = backend::syntax::binary_code(backend::syntax::BinaryShiftLeft); }
        if (production == verified::production::SHR_TAIL) { operation = backend::syntax::binary_code(backend::syntax::BinaryShiftRight); }
        if (production == verified::production::ADD_TAIL) { operation = backend::syntax::binary_code(backend::syntax::BinaryAdd); }
        if (production == verified::production::SUB_TAIL) { operation = backend::syntax::binary_code(backend::syntax::BinarySubtract); }
        if (production == verified::production::MUL_TAIL) { operation = backend::syntax::binary_code(backend::syntax::BinaryMultiply); }
        if (production == verified::production::DIV_TAIL) { operation = backend::syntax::binary_code(backend::syntax::BinaryDivide); }
        if (production == verified::production::MOD_TAIL) { operation = backend::syntax::binary_code(backend::syntax::BinaryRemainder); }
        if (operation <= -1) { return lowering::body_context::unsupported(); }
        let left: i32 = expression_kind(context, arena_count,
            current_node.left, depth - 1);
        let right: i32 = expression_kind(context, arena_count,
            current_node.right, depth - 1);
        if (left <= -1) { return left; }
        if (right <= -1) { return right; }
        if (operation == backend::syntax::binary_code(backend::syntax::BinaryAndThen) || operation == backend::syntax::binary_code(backend::syntax::BinaryOrElse)) {
            if (left == backend::syntax::type_code(backend::syntax::TypeBool) && right == backend::syntax::type_code(backend::syntax::TypeBool)) {
                return backend::syntax::type_code(backend::syntax::TypeBool);
            }
            return lowering::body_context::unsupported();
        }
        if (operation >= backend::syntax::binary_code(backend::syntax::BinaryEqual)
            && operation <= backend::syntax::binary_code(backend::syntax::BinaryGreaterEqual)) {
            if (left == backend::syntax::type_code(backend::syntax::TypeI32) && right == backend::syntax::type_code(backend::syntax::TypeI32)) {
                return backend::syntax::type_code(backend::syntax::TypeBool);
            }
            return lowering::body_context::unsupported();
        }
        if (left == backend::syntax::type_code(backend::syntax::TypeI32) && right == backend::syntax::type_code(backend::syntax::TypeI32)) {
            return backend::syntax::type_code(backend::syntax::TypeI32);
        }
        return lowering::body_context::unsupported();
    }
    if (verified::surface_expr::has_kind(kind,
        verified::surface_expr::PathExpression)) {
        let name: i32 = lowering::body_context::simple_path_token(context.expression_arena,
            arena_count, node);
        let binding: i32 = lowering::body_context::local_index(context, name);
        if (binding >= 0) {
            return lowering::locals::kind_at(context.locals, binding);
        }
        let variant: EnumVariant = lowering::body_lookup::enum_variant(context, node);
        if (lowering::body_lookup::enum_lookup_is(variant.state, lowering::body_lookup::EnumResolved)
            && variant.field_count == 0) {
            return backend::syntax::NOMINAL_TYPE_BASE + variant.type_id;
        }
        return lowering::body_context::unsupported();
    }
    if (verified::surface_expr::has_kind(kind,
        verified::surface_expr::StructValue)) {
        let allocation: i32 = lowering::body_lookup::nominal_allocation(context,
            current_node.left,
            lowering::declarations::Structure);
        if (allocation <= -1) { return lowering::body_context::unsupported(); }
        let allocation_row: lowering::allocation::AllocationRow =
            lowering::allocation::table_row(allocation_table, allocation);
        return backend::syntax::NOMINAL_TYPE_BASE
            + lowering::allocation::row_declaration_id(allocation_row);
    }
    if (verified::surface_expr::has_kind(kind,
        verified::surface_expr::MatchValue)) {
        return match_result_kind(context, arena_count, node, depth - 1);
    }
    if (verified::surface_expr::has_kind(kind, verified::surface_expr::Member)) {
        let base_kind: i32 = expression_kind(context, arena_count,
            current_node.left, depth - 1);
        if (base_kind <= backend::syntax::NOMINAL_TYPE_BASE - 1) {
            return lowering::body_context::unsupported();
        }
        let field_index: i32 = structure_field(context,
            base_kind - backend::syntax::NOMINAL_TYPE_BASE,
            current_node.token);
        if (field_index <= -1) { return lowering::body_context::unsupported(); }
        let member: lowering::signatures::SignatureMember =
            lowering::signature_index::member_at(context.signature_index,
                base_kind - backend::syntax::NOMINAL_TYPE_BASE,
                field_index);
        return member.type_tag;
    }
    if (verified::surface_expr::has_kind(kind, verified::surface_expr::Index)) {
        let base_kind: i32 = expression_kind(context, arena_count,
            current_node.left, depth - 1);
        if (base_kind == backend::syntax::type_code(backend::syntax::TypeSlice)) { return backend::syntax::type_code(backend::syntax::TypeI32); }
        return lowering::body_context::unsupported();
    }
    if (verified::surface_expr::has_kind(kind, verified::surface_expr::Call)) {
        let callee: i32 = current_node.left;
        let variant: EnumVariant = lowering::body_lookup::enum_variant(context, callee);
        if (lowering::body_lookup::enum_lookup_is(variant.state, lowering::body_lookup::EnumResolved)) {
            return backend::syntax::NOMINAL_TYPE_BASE + variant.type_id;
        }
        if (lowering::body_lookup::enum_lookup_is(variant.state, lowering::body_lookup::EnumInvalid)) {
            return lowering::body_context::unsupported();
        }
        let name: i32 = lowering::body_context::qualified_path_token(context.expression_arena,
            arena_count, callee);
        let id: i32 = lowering::body_lookup::callable_id(context,
            lowering::body_context::path_is_qualified(context.expression_arena, arena_count, callee),
            name);
        if (id <= -1) { return lowering::body_context::unsupported(); }
        if (!lowering::body_lookup::has_signature(context, id,
                lowering::signatures::InternalFunctionShape)
            && !lowering::body_lookup::has_signature(context, id,
                lowering::signatures::ExternalFunctionShape)) {
            return lowering::body_context::unsupported();
        }
        let signature_row: lowering::signatures::SignatureRecord =
            lowering::signature_index::record_at(context.signature_index,
                id);
        return lowering::signatures::record_result_type(signature_row);
    }
    return lowering::body_context::unsupported();
}

pub fn extract_expression(context: BodyContext, surface: i32, depth: i32) -> i32 {
    let input: verified::surface_expr::ExpressionInput =
        verified::surface_expr::ExpressionInput {
            tree: context.tree,
            root: surface,
            depth: depth,
        };
    return verified::surface_expr::extract(input,
        context.expression_arena);
}

pub fn expression_from_surface(context: BodyContext, surface: i32, output: [i32],
    capacity: i32, position: i32, depth: i32) -> i32 {
    let arena: verified::surface_expr::ExpressionArena = context.expression_arena;
    let root: i32 = extract_expression(context, surface, depth);
    if (root <= -1
        || verified::surface_expr::node_count(arena) <= 0) {
        return lowering::body_context::invalid();
    }
    return expression(context,
        verified::surface_expr::node_count(arena), root, output,
        capacity, position, depth);
}
