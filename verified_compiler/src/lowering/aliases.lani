module lowering::aliases;
import lowering::declarations;
import lowering::builtin;
import ir::type_ref;
import verified::host;
import verified::surface_path;
import verified::surface_type;
import verified::syntax_tree;
import verified::token;

type TypeRef = ir::type_ref::TypeRef;

const RESULT_SLOT: i32 = 0;

// One source unit owns one module path and a typed symbol table. This is
// private compiler state, not a Core wire format. A Nominal payload is a
// stable symbol ordinal, not a guessed Core ID.
const NATIVE_FIELD_BYTES: i32 = 8;
const ALIAS_TARGET_WORDS: i32 = 1 + ir::type_ref::STORAGE_WORDS;
pub const SYMBOL_ALIGNMENT: i32 = NATIVE_FIELD_BYTES;
pub const SYMBOL_RECORD_BYTES: i32 = (1 + ALIAS_TARGET_WORDS)
    * NATIVE_FIELD_BYTES;
pub const CATALOG_RECORD_BYTES: i32 = 6 * NATIVE_FIELD_BYTES;
pub const CATALOG_ALIGNMENT: i32 = NATIVE_FIELD_BYTES;
const FIRST_PATH_TOKEN: i32 = 0;
const WORK_FIELDS_PER_RECORD: i32 = 3 + ALIAS_TARGET_WORDS;
pub const WORK_RECORD_BYTES: i32 = WORK_FIELDS_PER_RECORD
    * NATIVE_FIELD_BYTES;
pub const WORK_ALIGNMENT: i32 = NATIVE_FIELD_BYTES;
pub const RESOLUTION_RECORD_BYTES: i32 = ALIAS_TARGET_WORDS
    * NATIVE_FIELD_BYTES;

enum ResolutionState {
    Unvisited,
    Visiting,
    Resolved,
}

struct AliasWork {
    declaration: i32,
    declaration_kind: lowering::declarations::DeclarationKind,
    state: ResolutionState,
    target: AliasTarget,
}

fn alias_work_slice(data: ptr, length: i32) -> [AliasWork] {
    return slice_from_raw_parts(data, length);
}

pub enum AliasTarget {
    Unresolved,
    Scalar(TypeRef),
    Nominal(i32),
    DeferredNominal,
}

pub struct AliasSymbol {
    name_token: i32,
    target: AliasTarget,
}

pub struct Catalog {
    module_tokens: [i32],
    module_segments: i32,
    symbols: [AliasSymbol],
    symbol_count: i32,
}

pub struct Table {
    data: [Catalog],
    count: i32,
}

pub fn from_raw_parts(memory: ptr, count: i32) -> Table {
    let first: ptr = memory;
    if (count > 0) {
        first = memory + count * CATALOG_RECORD_BYTES
            - NATIVE_FIELD_BYTES;
    }
    return Table { data: slice_from_raw_parts(first, count), count: count };
}

pub fn empty() -> Catalog {
    let null_pointer: ptr = 0;
    return Catalog {
        module_tokens: verified::host::i32_slice_from_raw_parts(
            null_pointer, 0),
        module_segments: 0,
        symbols: slice_from_raw_parts(null_pointer, 0),
        symbol_count: 0,
    };
}

fn symbol_view(memory: ptr, count: i32) -> [AliasSymbol] {
    let first: ptr = memory;
    if (count > 0) {
        first = memory + count * SYMBOL_RECORD_BYTES
            - NATIVE_FIELD_BYTES;
    }
    return slice_from_raw_parts(first, count);
}

pub struct AliasResolution {
    target: AliasTarget,
}

fn unresolved(target: AliasTarget) -> bool {
    return match (target) {
        Unresolved -> true,
        _ -> false,
    };
}

fn valid_target(target: AliasTarget) -> bool {
    return match (target) {
        Unresolved -> false,
        Scalar(kind) -> ir::type_ref::primitive(kind),
        Nominal(ordinal) -> ordinal >= 0,
        DeferredNominal -> true,
    };
}

pub enum AliasError {
    Invalid,
    Unsupported,
    Ambiguous,
    Cycle,
}

pub fn error_code(error: AliasError) -> i32 {
    return match (error) {
        Invalid -> 1,
        Unsupported -> 2,
        Ambiguous -> 3,
        Cycle -> 4,
    };
}

pub fn failure(error: AliasError) -> i32 {
    return 0 - error_code(error);
}

pub fn failed_with(value: i32, error: AliasError) -> bool {
    return value == failure(error);
}

fn scalar_slice_kind(kind: TypeRef) -> TypeRef {
    if (ir::type_ref::same(kind, ir::type_ref::I32)) {
        return ir::type_ref::Slice;
    }
    return ir::type_ref::Invalid;
}

fn valid_token(source: [i32], source_length: i32,
    tokens: verified::token::TokenTable,
    token_count: i32, token: i32) -> bool {
    if (!identifier_token(tokens, token_count, token)) {
        return false;
    }
    let rows: [verified::token::TokenRow] = tokens.data;
    let start: i32 = rows[token].start;
    let finish: i32 = rows[token].finish;
    return start > -1 && finish > start && finish <= source_length;
}

fn identifier_token(tokens: verified::token::TokenTable, token_count: i32,
    token: i32) -> bool {
    let rows: [verified::token::TokenRow] = tokens.data;
    return token > -1 && token <= token_count - 1
        && rows[token].kind == verified::token::Identifier;
}

// Keep builtin recognition typed until the scalar-lowering API boundary.
fn builtin(source: [i32], source_length: i32,
    tokens: verified::token::TokenTable, token_count: i32,
    token: i32) -> lowering::builtin::Lookup {
    if (!valid_token(source, source_length, tokens, token_count, token)) {
        return lowering::builtin::UnknownName;
    }
    let rows: [verified::token::TokenRow] = tokens.data;
    let start: i32 = rows[token].start;
    let finish: i32 = rows[token].finish;
    return lowering::builtin::lookup(source, source_length, start, finish);
}

// Materialize a plain parse-tree path into token IDs. Generic path segments
// are rejected: aliases are monomorphic and the catalog never erases args.
struct ParsePathContext {
    source: [i32],
    source_length: i32,
    tree: verified::syntax_tree::Tree,
    tokens: verified::token::TokenTable,
    token_count: i32,
    output: [i32],
    capacity: i32,
}

fn parse_path(context: ParsePathContext, root: i32) -> i32 {
    let source: [i32] = context.source;
    let source_length: i32 = context.source_length;
    let tree: verified::syntax_tree::Tree = context.tree;
    let tokens: verified::token::TokenTable = context.tokens;
    let token_count: i32 = context.token_count;
    let output: [i32] = context.output;
    let capacity: i32 = context.capacity;
    if (capacity <= 0) { return failure(Invalid); }
    let segment: verified::surface_path::Segment =
        verified::surface_path::first(tree, root);
    let written: i32 = 0;
    let previous: i32 = -1;
    while (segment.valid) {
        let name: i32 = segment.token;
        if (!valid_token(source, source_length, tokens, token_count, name)) {
            return failure(Invalid);
        }
        if (written >= capacity || name <= previous) { return failure(Invalid); }
        output[written] = name;
        written += 1;
        previous = name;
        if (segment.last) { return written; }
        segment = verified::surface_path::next(tree, segment);
    }
    return failure(Invalid);
}

fn copy_arena_path(arena: verified::surface_type::TypeArena,
    count: i32, path: i32, output: [i32],
    capacity: i32) -> i32 {
    let nodes: [verified::surface_type::TypeNode] = arena.data;
    if (count <= 0 || count > arena.capacity || path <= -1
        || path >= count || capacity <= 0
        || !verified::surface_type::kind_is(nodes[path].kind,
            verified::surface_type::Path)) { return failure(Invalid); }
    let segment: i32 = nodes[path].first;
    let written: i32 = 0;
    while (segment != -1) {
        if (segment <= -1 || segment >= path || written >= capacity
            || !verified::surface_type::kind_is(nodes[segment].kind,
                verified::surface_type::Segment)) { return failure(Invalid); }
        output[written] = nodes[segment].token;
        written += 1;
        let next: i32 = nodes[segment].next;
        if (next != -1 && next <= segment) { return failure(Invalid); }
        segment = next;
    }
    return written;
}

fn row_matches(context: verified::token::SpellingView, catalog: Catalog,
    symbol: AliasSymbol, path: [i32], path_count: i32) -> bool {
    let module_count: i32 = catalog.module_segments;
    let module_tokens: [i32] = catalog.module_tokens;
    if (path_count == 1) {
        return verified::token::same_identifier(context,
            path[FIRST_PATH_TOKEN], symbol.name_token);
    }
    if (path_count != module_count + 1) { return false; }
    let index: i32 = 0;
    while (index <= module_count - 1) {
        if (!verified::token::same_identifier(context,
            path[index], module_tokens[index])) {
            return false;
        }
        index += 1;
    }
    return verified::token::same_identifier(context,
        path[module_count], symbol.name_token);
}

fn lookup_symbol(context: verified::token::SpellingView, catalog: Catalog,
    path: [i32], path_count: i32) -> i32 {
    let rows: i32 = catalog.symbol_count;
    if (path_count <= 0 || rows <= -1 || catalog.module_segments <= 0) {
        return failure(Invalid);
    }
    let symbols: [AliasSymbol] = catalog.symbols;
    let found: i32 = -1;
    let row: i32 = 0;
    while (row <= rows - 1) {
        if (row_matches(context, catalog, symbols[row], path, path_count)) {
            if (found != -1) { return failure(Ambiguous); }
            found = row;
        }
        row += 1;
    }
    return found;
}

struct AliasContext {
    source: [i32],
    source_length: i32,
    tokens: verified::token::TokenTable,
    token_count: i32,
    tree: verified::syntax_tree::Tree,
    catalog: Catalog,
    work: [AliasWork],
    work_capacity: i32,
    stack: [i32],
    stack_capacity: i32,
    type_arena: verified::surface_type::TypeArena,
    scratch: [i32],
    scratch_capacity: i32,
    result: [AliasResolution],
}

fn resolve_arena(context: AliasContext, root: i32, stack_depth: i32,
    depth: i32) -> i32 {
    let source: [i32] = context.source;
    let tokens: verified::token::TokenTable = context.tokens;
    let catalog: Catalog = context.catalog;
    let work: [AliasWork] = context.work;
    let type_arena: verified::surface_type::TypeArena = context.type_arena;
    let nodes: [verified::surface_type::TypeNode] = type_arena.data;
    let arena_count: [verified::surface_type::CountCell] = type_arena.count;
    let scratch: [i32] = context.scratch;
    let result: [AliasResolution] = context.result;
    let source_length: i32 = context.source_length;
    let token_count: i32 = context.token_count;
    let work_capacity: i32 = context.work_capacity;
    let scratch_capacity: i32 = context.scratch_capacity;
    if (depth <= 0 || root <= -1
        || root >= arena_count[0].value) {
        return failure(Invalid);
    }
    let kind: verified::surface_type::SurfaceTypeKind = nodes[root].kind;
    if (verified::surface_type::kind_is(kind, verified::surface_type::PathType)) {
        let path: i32 = nodes[root].first;
        if (path <= -1 || path >= root || !verified::surface_type::kind_is(
            nodes[path].kind,
            verified::surface_type::Path)) { return failure(Invalid); }
        let segments: i32 = nodes[path].first;
        let segment: i32 = segments;
        while (segment != -1) {
            if (segment <= -1 || segment >= root || !verified::surface_type::kind_is(
                    nodes[segment].kind,
                    verified::surface_type::Segment)
                || nodes[segment].first != -1) {
                return failure(Unsupported);
            }
            segment = nodes[segment].next;
        }
        let path_count: i32 = copy_arena_path(type_arena,
            arena_count[0].value, path,
            scratch, scratch_capacity);
        if (path_count <= 0) { return failure(Invalid); }
        if (path_count == 1) {
            let token: i32 = scratch[FIRST_PATH_TOKEN];
            let found: lowering::builtin::Lookup = builtin(source,
                source_length, tokens, token_count, token);
            let invalid_kind: TypeRef = ir::type_ref::Invalid;
            let builtin_kind: TypeRef = match (found) {
                lowering::builtin::Supported(kind) -> kind,
                _ -> invalid_kind,
            };
            if (ir::type_ref::primitive(builtin_kind)) {
                result[RESULT_SLOT].target = Scalar(builtin_kind);
                return 0;
            }
            let unsupported: bool = match (found) {
                lowering::builtin::UnsupportedType -> true,
                _ -> false,
            };
            if (unsupported) { return failure(Unsupported); }
        }
        let token_context: verified::token::SpellingView =
            verified::token::spellings(source, source_length,
                tokens, token_count);
        let symbol: i32 = lookup_symbol(token_context, catalog,
            scratch, path_count);
        if (failed_with(symbol, Ambiguous)) { return failure(Ambiguous); }
        if (symbol <= -1 || symbol >= work_capacity) {
            return failure(Invalid);
        }
        let nested: i32 = resolve_symbol(context, symbol, stack_depth,
            depth - 1);
        if (nested <= -1) { return nested; }
        return 0;
    }
    if (verified::surface_type::kind_is(kind, verified::surface_type::Slice)) {
        let child: i32 = nodes[root].first;
        if (child <= -1 || child >= root) { return failure(Invalid); }
        let nested: i32 = resolve_arena(context, child, stack_depth,
            depth - 1);
        if (nested <= -1) { return nested; }
        let slice_kind: TypeRef = match (result[RESULT_SLOT].target) {
            Scalar(kind) -> scalar_slice_kind(kind),
            Nominal(id) -> ir::type_ref::NominalSlice(id),
            _ -> ir::type_ref::Invalid,
        };
        if (!ir::type_ref::valid(slice_kind)) {
            return failure(Unsupported);
        }
        result[RESULT_SLOT].target = Scalar(slice_kind);
        return 0;
    }
    if (verified::surface_type::kind_is(kind, verified::surface_type::Array)
        || verified::surface_type::kind_is(kind, verified::surface_type::Reference)) {
        return failure(Unsupported);
    }
    return failure(Invalid);
}

fn resolve_symbol(context: AliasContext, index: i32, stack_depth: i32,
    depth: i32) -> i32 {
    let work: [AliasWork] = context.work;
    let stack: [i32] = context.stack;
    let type_arena: verified::surface_type::TypeArena = context.type_arena;
    let result: [AliasResolution] = context.result;
    let work_capacity: i32 = context.work_capacity;
    let stack_capacity: i32 = context.stack_capacity;
    if (index <= -1 || index >= work_capacity || depth <= 0
        || stack_depth <= -1 || stack_depth >= stack_capacity) { return failure(Invalid); }
    if (work[index].state == Resolved) {
        result[RESULT_SLOT].target = work[index].target;
        return 0;
    }
    if (work[index].state == Visiting) { return failure(Cycle); }
    work[index].state = Visiting;
    stack[stack_depth] = index;
    if (lowering::declarations::same_kind(
            work[index].declaration_kind,
            lowering::declarations::Structure)
        || lowering::declarations::same_kind(
            work[index].declaration_kind,
            lowering::declarations::Enumeration)) {
        work[index].target = Nominal(index);
    } else {
        let declaration: i32 = work[index].declaration;
        let type_input: verified::surface_type::TypeInput =
            verified::surface_type::TypeInput {
                tree: context.tree,
                root: declaration,
                depth: depth,
            };
        let root: i32 = verified::surface_type::extract(type_input,
            type_arena);
        let arena_count: [verified::surface_type::CountCell] =
            type_arena.count;
        if (root <= -1 || arena_count[0].value <= 0) {
            return failure(Invalid);
        }
        let resolved: i32 = resolve_arena(context, root, stack_depth + 1,
            depth - 1);
        if (resolved <= -1) { return resolved; }
        let target: AliasTarget = result[RESULT_SLOT].target;
        if (unresolved(target)) { return failure(Invalid); }
        work[index].target = target;
    }
    work[index].state = Resolved;
    result[RESULT_SLOT].target = work[index].target;
    return 0;
}

fn duplicate_key(spellings: verified::token::SpellingView,
    symbols: [AliasSymbol], name: i32, prior: i32) -> bool {
    return verified::token::same_identifier(spellings,
        name, symbols[prior].name_token);
}

fn initialize_work(work: [AliasWork], index: i32,
    declaration: lowering::declarations::DeclarationRow) {
    work[index].declaration = lowering::declarations::row_target(declaration);
    work[index].declaration_kind = lowering::declarations::row_kind(declaration);
    work[index].state = Unvisited;
    work[index].target = Unresolved;
}

pub struct WordRegion {
    data: [i32],
    words: i32,
}

pub fn region(data: [i32], words: i32) -> WordRegion {
    return WordRegion { data: data, words: words };
}

pub struct AliasWorkRegion {
    data: [AliasWork],
    capacity: i32,
}

pub struct AliasResolutionRegion {
    data: [AliasResolution],
}

pub fn result_region(data: ptr) -> AliasResolutionRegion {
    let first: ptr = data + RESOLUTION_RECORD_BYTES - NATIVE_FIELD_BYTES;
    return AliasResolutionRegion {
        data: slice_from_raw_parts(first, 1),
    };
}

pub fn work_region(data: ptr, capacity: i32) -> AliasWorkRegion {
    // Typed aggregate slices use descending machine words, so their data
    // pointer is the last word inside the caller-owned record allocation.
    let first: ptr = data;
    if (capacity > 0) {
        first = data + capacity * WORK_RECORD_BYTES - NATIVE_FIELD_BYTES;
    }
    return AliasWorkRegion {
        data: alias_work_slice(first, capacity),
        capacity: capacity,
    };
}

pub struct AliasBuildInputs {
    source: WordRegion,
    tokens: verified::token::TokenTable,
    tree: verified::syntax_tree::Tree,
    declarations: lowering::declarations::Table,
    depth: i32,
}

pub struct AliasBuildWorkspace {
    type_arena: verified::surface_type::TypeArena,
    work: AliasWorkRegion,
    stack: WordRegion,
    scratch: WordRegion,
    result: AliasResolutionRegion,
    output: Table,
    output_slot: i32,
}

// Build one source-unit catalog. `work` contains one typed record per
// alias/structure; `result` is one typed descriptor, and `stack` is the explicit
// cycle bound. Path and symbol storage is sized after the declaration/path
// count is known, so malformed or unexpectedly deep input fails closed.
pub fn build(input: AliasBuildInputs, workspace: AliasBuildWorkspace) -> i32 {
    let source_region: WordRegion = input.source;
    let token_region: verified::token::TokenTable = input.tokens;
    let tree: verified::syntax_tree::Tree = input.tree;
    let declaration_table: lowering::declarations::Table =
        input.declarations;
    let type_arena: verified::surface_type::TypeArena =
        workspace.type_arena;
    let work_region: AliasWorkRegion = workspace.work;
    let stack_region: WordRegion = workspace.stack;
    let scratch_region: WordRegion = workspace.scratch;
    let resolution_region: AliasResolutionRegion = workspace.result;
    let output_table: Table = workspace.output;
    let output_slot: i32 = workspace.output_slot;
    let source: [i32] = source_region.data;
    let source_length: i32 = source_region.words;
    let tokens: verified::token::TokenTable = token_region;
    let token_count: i32 = token_region.count;
    let work: [AliasWork] = work_region.data;
    let work_capacity: i32 = work_region.capacity;
    let stack: [i32] = stack_region.data;
    let stack_capacity: i32 = stack_region.words;
    let scratch: [i32] = scratch_region.data;
    let scratch_capacity: i32 = scratch_region.words;
    let result: [AliasResolution] = resolution_region.data;
    let depth: i32 = input.depth;
    if (source_length <= -1 || token_count <= -1 || tree.node_count <= 0
        || declaration_table.count <= 0
        || type_arena.capacity <= 0 || work_capacity <= 0 || stack_capacity <= 0
        || scratch_capacity <= 0 || depth <= 0
        || output_slot <= -1 || output_slot >= output_table.count) {
        return failure(Invalid);
    }
    let rows: i32 = lowering::declarations::count_rows(
        lowering::declarations::table_header(declaration_table));
    if (rows <= 0 || rows != declaration_table.count) {
        return failure(Invalid);
    }
    let module_path: i32 = -1;
    let expected_symbols: i32 = 0;
    let row: i32 = 0;
    while (row <= rows - 1) {
        let declaration: lowering::declarations::DeclarationRow =
            lowering::declarations::table_row(declaration_table, row);
        if (lowering::declarations::row_has_kind(declaration,
                lowering::declarations::Module)) {
            if (module_path != -1) { return failure(Ambiguous); }
            module_path = lowering::declarations::row_target(declaration);
        }
        if (lowering::declarations::row_has_kind(declaration,
                lowering::declarations::Alias)
            || lowering::declarations::row_has_kind(declaration,
                lowering::declarations::Structure)
            || lowering::declarations::row_has_kind(declaration,
                lowering::declarations::Enumeration)) {
            expected_symbols += 1;
        }
        row += 1;
    }
    if (module_path <= -1) { return failure(Invalid); }
    let path_context: ParsePathContext = ParsePathContext {
        source: source,
        source_length: source_length,
        tree: tree,
        tokens: tokens,
        token_count: token_count,
        output: scratch,
        capacity: scratch_capacity,
    };
    let module_segments: i32 = parse_path(path_context, module_path);
    if (module_segments <= 0 || module_segments > scratch_capacity
        || module_segments > verified::host::I32_MAX
            / verified::host::I32_BYTES) { return failure(Invalid); }
    if (expected_symbols > stack_capacity
        || expected_symbols > work_capacity
        || expected_symbols > verified::host::I32_MAX
            / SYMBOL_RECORD_BYTES) { return failure(Invalid); }
    let module_memory: ptr = verified::host::alloc_i32(module_segments);
    let symbol_bytes: i32 = SYMBOL_RECORD_BYTES;
    if (expected_symbols > 0) {
        symbol_bytes = expected_symbols * SYMBOL_RECORD_BYTES;
    }
    let symbol_memory: ptr = verified::host::alloc(symbol_bytes,
        SYMBOL_ALIGNMENT);
    if (module_memory == 0 || symbol_memory == 0) {
        return failure(Invalid);
    }
    let module_tokens: [i32] = verified::host::i32_slice_from_raw_parts(
        module_memory, module_segments);
    let symbols: [AliasSymbol] = symbol_view(symbol_memory,
        expected_symbols);
    let module_token: i32 = 0;
    while (module_token <= module_segments - 1) {
        module_tokens[module_token] = scratch[module_token];
        module_token += 1;
    }
    let catalog: Catalog = Catalog {
        module_tokens: module_tokens,
        module_segments: module_segments,
        symbols: symbols,
        symbol_count: expected_symbols,
    };
    let spellings: verified::token::SpellingView =
        verified::token::spellings(source, source_length,
            tokens, token_count);
    let symbol_count: i32 = 0;
    let source_row: i32 = 0;
    while (source_row <= rows - 1) {
        let declaration: lowering::declarations::DeclarationRow =
            lowering::declarations::table_row(declaration_table, source_row);
        if (lowering::declarations::row_has_kind(declaration,
                lowering::declarations::Alias)
            || lowering::declarations::row_has_kind(declaration,
                lowering::declarations::Structure)
            || lowering::declarations::row_has_kind(declaration,
                lowering::declarations::Enumeration)) {
            if (symbol_count >= expected_symbols) {
                return failure(Invalid);
            }
            let name: i32 = lowering::declarations::row_name(declaration);
            if (!valid_token(source, source_length, tokens, token_count, name)) { return failure(Invalid); }
            let builtin_name: lowering::builtin::Lookup = builtin(source,
                source_length, tokens, token_count, name);
            let ordinary_name: bool = match (builtin_name) {
                lowering::builtin::UnknownName -> true,
                _ -> false,
            };
            if (!ordinary_name) { return failure(Ambiguous); }
            let prior: i32 = 0;
            while (prior <= symbol_count - 1) {
                if (duplicate_key(spellings, symbols,
                    name, prior)) { return failure(Ambiguous); }
                prior += 1;
            }
            symbols[symbol_count] = AliasSymbol {
                name_token: name,
                target: Unresolved,
            };
            initialize_work(work, symbol_count, declaration);
            symbol_count += 1;
        }
        source_row += 1;
    }
    if (symbol_count != expected_symbols) { return failure(Invalid); }
    let context: AliasContext = AliasContext {
        source: source,
        source_length: source_length,
        tokens: tokens,
        token_count: token_count,
        tree: input.tree,
        catalog: catalog,
        work: work,
        work_capacity: work_capacity,
        stack: stack,
        stack_capacity: stack_capacity,
        type_arena: type_arena,
        scratch: scratch,
        scratch_capacity: scratch_capacity,
        result: result,
    };
    let symbol: i32 = 0;
    while (symbol <= symbol_count - 1) {
        let resolved: i32 = resolve_symbol(context, symbol, 0, depth);
        // A qualified target may name a declaration from another source unit.
        // Keep that row nominal until the aggregate allocator supplies the
        // cross-unit type map; ambiguity, unsupported forms, and cycles still
        // reject here.
        if (resolved <= -1) {
            if (!failed_with(resolved, Invalid)) { return resolved; }
            work[symbol].target = DeferredNominal;
        }
        symbols[symbol].target = work[symbol].target;
        symbol += 1;
    }
    let output_rows: [Catalog] = output_table.data;
    output_rows[output_slot] = catalog;
    return symbol_count;
}

// Validate the native symbol span before type lowering trusts it.
pub fn valid(catalog: Catalog,
    tokens: verified::token::TokenTable) -> bool {
    let token_count: i32 = tokens.count;
    if (token_count <= -1 || catalog.module_segments <= 0
        || catalog.symbol_count <= -1) {
        return false;
    }
    let module_count: i32 = catalog.module_segments;
    let rows: i32 = catalog.symbol_count;
    let module_tokens: [i32] = catalog.module_tokens;
    let symbols: [AliasSymbol] = catalog.symbols;
    let index: i32 = 0;
    while (index <= module_count - 1) {
        let token: i32 = module_tokens[index];
        if (!identifier_token(tokens, token_count, token)) {
            return false;
        }
        index += 1;
    }
    let row: i32 = 0;
    while (row <= rows - 1) {
        let symbol: AliasSymbol = symbols[row];
        if (!identifier_token(tokens, token_count, symbol.name_token)
            || !valid_target(symbol.target)) {
            return false;
        }
        row += 1;
    }
    return true;
}

pub fn valid_or_empty(catalog: Catalog,
    tokens: verified::token::TokenTable) -> bool {
    if (catalog.module_segments == 0) {
        return catalog.symbol_count == 0;
    }
    return valid(catalog, tokens);
}

pub struct AliasLookupInput {
    source: WordRegion,
    tokens: verified::token::TokenTable,
    catalog: Catalog,
    arena: verified::surface_type::TypeArena,
    root: i32,
}

pub struct AliasLookupWorkspace {
    scratch: WordRegion,
}

pub enum ScalarLookup {
    ScalarFound(TypeRef),
    ScalarMissing,
    ScalarInvalid,
    ScalarUnsupported,
    ScalarAmbiguous,
}

// Resolve an arena path against a catalog. Nominal rows are left for the
// allocation-authenticated resolution table; scalar() reports them as a
// non-scalar miss so types.lower can continue to nominal resolution.
pub fn scalar(input: AliasLookupInput,
    workspace: AliasLookupWorkspace) -> ScalarLookup {
    let source: [i32] = input.source.data;
    let source_length: i32 = input.source.words;
    let tokens: verified::token::TokenTable = input.tokens;
    let token_count: i32 = input.tokens.count;
    let catalog: Catalog = input.catalog;
    let arena: verified::surface_type::TypeArena = input.arena;
    let nodes: [verified::surface_type::TypeNode] = arena.data;
    let arena_count: [verified::surface_type::CountCell] = arena.count;
    let root: i32 = input.root;
    let scratch: [i32] = workspace.scratch.data;
    let scratch_capacity: i32 = workspace.scratch.words;
    if (arena.capacity <= 0 || arena_count[0].value <= 0
        || arena_count[0].value > arena.capacity || root <= -1
        || root >= arena_count[0].value) {
        return ScalarInvalid;
    }
    if (catalog.module_segments == 0 && catalog.symbol_count == 0) {
        return ScalarMissing;
    }
    if (!valid(catalog, tokens)) { return ScalarInvalid; }
    let path: i32 = root;
    let root_kind: verified::surface_type::SurfaceTypeKind = nodes[root].kind;
    if (verified::surface_type::kind_is(root_kind, verified::surface_type::PathType)) {
        path = nodes[root].first;
        if (path <= -1 || path >= root) { return ScalarInvalid; }
    } else {
        if (!verified::surface_type::kind_is(root_kind,
            verified::surface_type::Path)) { return ScalarInvalid; }
    }
    if (!verified::surface_type::kind_is(nodes[path].kind,
        verified::surface_type::Path)) { return ScalarInvalid; }
    let count: i32 = copy_arena_path(arena,
        arena_count[0].value, path, scratch, scratch_capacity);
    if (count <= 0) { return ScalarInvalid; }
    let segment: i32 = nodes[path].first;
    while (segment != -1) {
        if (segment <= -1 || segment >= root
            || !verified::surface_type::kind_is(nodes[segment].kind,
                verified::surface_type::Segment)
            || nodes[segment].first != -1) {
            return ScalarUnsupported;
        }
        segment = nodes[segment].next;
    }
    let rows: i32 = catalog.symbol_count;
    let symbols: [AliasSymbol] = catalog.symbols;
    let row: i32 = 0;
    let first_match: i32 = -1;
    let token_context: verified::token::SpellingView =
        verified::token::spellings(source, source_length,
            tokens, token_count);
    while (row <= rows - 1) {
        let symbol: AliasSymbol = symbols[row];
        if (row_matches(token_context, catalog, symbol, scratch, count)) {
            if (first_match >= 0) { return ScalarAmbiguous; }
            first_match = row;
        }
        row += 1;
    }
    if (first_match < 0) { return ScalarMissing; }
    return match (symbols[first_match].target) {
        Scalar(kind) -> ScalarFound(kind),
        _ -> ScalarMissing,
    };
}
