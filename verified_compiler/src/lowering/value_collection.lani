module lowering::value_collection;

import verified::token;
import verified::host;

import lowering::allocation;
import lowering::declarations;
import lowering::signature_index;
import lowering::signatures;
import lowering::token_names;
import lowering::unit_context;
import lowering::value_catalog;

type ValueTarget = lowering::value_catalog::ValueTarget;

pub struct WordRegion {
    data: [i32],
    words: i32,
}

pub fn region(data: [i32], words: i32) -> WordRegion {
    return WordRegion { data: data, words: words };
}

enum ValueCandidate {
    Missing,
    Unique(ValueTarget),
    Ambiguous,
}

const NAME_BUCKETS: i32 = 8192;
const NAME_ENTRY_BYTES: i32 = 7 * 8;

struct NameEntry {
    owner: i32,
    token: i32,
    target: ValueTarget,
    next: i32,
}

pub struct NameIndex {
    names: lowering::token_names::Catalog,
    entries: [NameEntry],
    buckets: [i32],
    capacity: i32,
    count: i32,
}

fn name_index(capacity: i32, names: lowering::token_names::Catalog) -> NameIndex {
    let empty: NameIndex = NameIndex {
        names: names,
        entries: slice_from_raw_parts(0, 0),
        buckets: verified::host::i32_slice_from_raw_parts(0, 0),
        capacity: -1,
        count: 0,
    };
    if (capacity <= 0 || capacity > verified::host::I32_MAX
        / NAME_ENTRY_BYTES) { return empty; }
    let entries_memory: ptr = verified::host::alloc(
        capacity * NAME_ENTRY_BYTES, 8);
    let buckets_memory: ptr = verified::host::alloc_i32(NAME_BUCKETS);
    if (entries_memory == 0 || buckets_memory == 0) { return empty; }
    let entries: [NameEntry] = slice_from_raw_parts(
        entries_memory + capacity * NAME_ENTRY_BYTES - 8,
        capacity);
    let buckets: [i32] = verified::host::i32_slice_from_raw_parts(
        buckets_memory, NAME_BUCKETS);
    let bucket_count: i32 = NAME_BUCKETS;
    let bucket: i32 = 0;
    while (bucket != bucket_count) {
        buckets[bucket] = -1;
        bucket += 1;
    }
    return NameIndex {
        names: names, entries: entries, buckets: buckets, capacity: capacity,
        count: 0,
    };
}

fn is_callable(target: ValueTarget) -> bool {
    return match (target) {
        lowering::value_catalog::Callable(id) -> true,
        _ -> false,
    };
}

fn insert_name(index: NameIndex, names: lowering::token_names::Catalog,
    slot: i32, owner: i32, token: i32, target: ValueTarget) -> i32 {
    let bucket: i32 = lowering::token_names::spelling_bucket(names,
        owner, token, NAME_BUCKETS);
    if (bucket <= -1) { return slot; }
    if (slot <= -1 || slot >= index.capacity) {
        return -1;
    }
    let entries: [NameEntry] = index.entries;
    let buckets: [i32] = index.buckets;
    // Declarations must be unique even when no body refers to the name.
    // Variants from different enums may share a spelling; callable overloads
    // are not supported. Imports remain separate from this unit-local check.
    if (is_callable(target)) {
        let prior: i32 = buckets[bucket];
        while (prior >= 0) {
            let entry: NameEntry = entries[prior];
            if (is_callable(entry.target) && entry.owner == owner
                && lowering::token_names::same(names, owner, token,
                    entry.owner, entry.token)) { return -1; }
            prior = entry.next;
        }
    }
    entries[slot] = NameEntry {
        owner: owner, token: token, target: target,
        next: buckets[bucket],
    };
    buckets[bucket] = slot;
    return slot + 1;
}

fn add_value_candidate(candidate: ValueCandidate,
    target: ValueTarget) -> ValueCandidate {
    // Once ambiguous, the payload is never read. Additional matches cannot
    // change that state or overflow an integer match count.
    return match (candidate) {
        Missing -> Unique(target),
        _ -> Ambiguous,
    };
}

fn append_value_candidate(output: lowering::value_catalog::ValueTable,
    position: i32,
    token: i32, scope: lowering::value_catalog::ValueBindingScope,
    candidate: ValueCandidate) -> i32 {
    return match (candidate) {
        Unique(target) ->
            lowering::value_catalog::write_binding(output, position,
                lowering::value_catalog::binding(token, scope, target)),
        _ -> position,
    };
}

pub struct ValueCatalogInput {
    contexts: lowering::unit_context::Table,
    sources: WordRegion,
    tokens: verified::token::TokenTable,
    allocations: lowering::allocation::Table,
    signature_index: lowering::signature_index::Table,
}

// Build the global callable/variant index once. All caller-local maps share
// these immutable candidates and the same source/token ownership metadata.
pub fn build_name_index(input: ValueCatalogInput) -> NameIndex {
    let context_table: lowering::unit_context::Table = input.contexts;
    let source_catalog: [i32] = input.sources.data;
    let token_catalog: verified::token::TokenTable = input.tokens;
    let allocated: lowering::allocation::Table = input.allocations;
    let signatures: lowering::signature_index::Table = input.signature_index;
    let token_names: lowering::token_names::Catalog =
        lowering::token_names::catalog(context_table, source_catalog,
            token_catalog);
    let invalid: NameIndex = name_index(-1, token_names);
    if (context_table.count <= 0 || signatures.count <= 0
        || !lowering::allocation::table_has_exact_rows(allocated)) {
        return invalid;
    }
    let allocation_rows: i32 = lowering::allocation::table_header(
        allocated).rows;
    if (signatures.variant_count <= -1
        || allocation_rows > verified::host::I32_MAX
            - signatures.variant_count) { return invalid; }
    let index: NameIndex = name_index(allocation_rows
        + signatures.variant_count, token_names);
    if (index.capacity <= -1) { return invalid; }
    let used: i32 = 0;
    let row: i32 = 0;
    while (row < allocation_rows) {
        let allocation: lowering::allocation::AllocationRow =
            lowering::allocation::table_row(allocated, row);
        let owner: i32 = lowering::allocation::row_unit(allocation);
        if (lowering::allocation::row_has_kind(allocation,
                lowering::declarations::Function)
            || lowering::allocation::row_has_kind(allocation,
                lowering::declarations::External)) {
            used = insert_name(index, token_names, used, owner,
                lowering::allocation::row_name(allocation),
                lowering::value_catalog::Callable(
                    lowering::allocation::row_core_id(allocation)));
            if (used <= -1) { return invalid; }
        }
        if (lowering::allocation::row_has_kind(allocation,
                lowering::declarations::Enumeration)) {
            let type_id: i32 = lowering::allocation::row_declaration_id(
                allocation);
            if (!lowering::signature_index::has_shape(signatures,
                type_id, lowering::signatures::EnumerationShape)) {
                return invalid;
            }
            let record: lowering::signatures::SignatureRecord =
                lowering::signature_index::record_at(signatures, type_id);
            let variant: i32 = 0;
            while (variant < lowering::signatures::record_arity(record)) {
                let native: lowering::signature_index::Variant =
                    lowering::signature_index::variant_at(signatures,
                        type_id, variant);
                if (native.name <= -1 || native.field_count <= -1) {
                    return invalid;
                }
                let variant_target:
                    lowering::value_catalog::VariantTarget =
                    lowering::value_catalog::VariantTarget {
                        type_id: type_id,
                        ordinal: variant,
                        field_count: native.field_count,
                    };
                let target: ValueTarget =
                    lowering::value_catalog::Variant(variant_target);
                used = insert_name(index, token_names, used, owner,
                    native.name, target);
                if (used <= -1) { return invalid; }
                variant += 1;
            }
        }
        row += 1;
    }
    index.count = used;
    return index;
}

pub struct NameMatch {
    found: bool,
    next: i32,
    target: ValueTarget,
}

// Walk only one spelling bucket, retaining all equal names across modules.
// A match is a candidate, not a visibility decision or a unique resolution.
pub fn next_match(index: NameIndex, unit: i32, token: i32,
    position: i32) -> NameMatch {
    let entries: [NameEntry] = index.entries;
    let remaining: i32 = index.count;
    while (position >= 0 && position < index.count && remaining > 0) {
        let entry: NameEntry = entries[position];
        if (lowering::token_names::same(index.names, unit, token,
                entry.owner, entry.token)) {
            return NameMatch {
                found: true, next: entry.next, target: entry.target,
            };
        }
        position = entry.next;
        remaining -= 1;
    }
    return NameMatch {
        found: false, next: -1, target: lowering::value_catalog::InvalidTarget,
    };
}

pub fn first_match(index: NameIndex, unit: i32, token: i32) -> NameMatch {
    let position: i32 = -1;
    if (index.capacity >= 0) {
        let bucket: i32 = lowering::token_names::spelling_bucket(index.names,
            unit, token, NAME_BUCKETS);
        if (bucket >= 0) { position = index.buckets[bucket]; }
    }
    return next_match(index, unit, token, position);
}

// Construct one caller-local map without rescanning the global declarations.
// Local and imported candidates stay separate; ambiguous spellings are omitted.
pub fn build_value_catalog(index: NameIndex, unit: i32,
    output: lowering::value_catalog::ValueTable) -> i32 {
    let token_names: lowering::token_names::Catalog = index.names;
    let context_table: lowering::unit_context::Table = token_names.contexts;
    if (index.capacity <= -1 || unit <= -1 || unit >= context_table.count
        || output.count <= -1) { return -1; }
    let contexts: [lowering::unit_context::UnitContext] = context_table.data;
    let token_count: i32 = contexts[unit].token_count;
    let token: i32 = 0;
    let written: i32 = 0;
    let entries: [NameEntry] = index.entries;
    let buckets: [i32] = index.buckets;
    while (token < token_count) {
        let local: ValueCandidate = Missing;
        let imported: ValueCandidate = Missing;
        let bucket: i32 = lowering::token_names::spelling_bucket(
            token_names, unit, token, NAME_BUCKETS);
        let candidate: i32 = -1;
        if (bucket >= 0) { candidate = buckets[bucket]; }
        while (candidate >= 0) {
            let entry: NameEntry = entries[candidate];
            if (lowering::token_names::same(token_names, unit, token,
                    entry.owner, entry.token)) {
                if (entry.owner == unit) {
                    local = add_value_candidate(local, entry.target);
                } else {
                    imported = add_value_candidate(imported, entry.target);
                }
            }
            candidate = entry.next;
        }
        let next: i32 = append_value_candidate(output, written,
            token, lowering::value_catalog::LocalBinding, local);
        if (next <= -1) { return -1; }
        written = next;
        next = append_value_candidate(output, written, token,
            lowering::value_catalog::ImportedBinding, imported);
        if (next <= -1) { return -1; }
        written = next;
        token += 1;
    }
    return written;
}
