module lowering::body_statement;
import backend::syntax;
import ir::body_events;
import ir::type_ref;
import lowering::body_context;
import lowering::body_event_write;
import lowering::body_expression;
import lowering::locals;
import lowering::types;
import verified::surface_expr;
import verified::surface_statement;
import verified::surface_type;
import verified::token;
type BodyContext = lowering::body_context::BodyContext;
type Region = ir::body_events::Region;
type Binding = verified::surface_statement::Binding;
fn bind_local(context: BodyContext, name: i32, kind: ir::type_ref::TypeRef, next: i32) -> i32 {
    if (next <= -1 || !lowering::locals::bind(context.locals, name, kind)) {
        return lowering::body_context::invalid();
    }
    return next;
}
fn explicit_let(context: BodyContext, name: i32, type_surface: i32, initializer: verified::surface_statement::Initializer, output: Region, position: i32, depth: i32) -> i32 {
    let surface_type_input: verified::surface_type::TypeInput = verified::surface_type::TypeInput {
        tree: context.tree,
        root: type_surface,
        depth: depth - 1,
    };
    let surface_type_output: verified::surface_type::TypeArena = context.type_arena;
    let type_root: i32 = verified::surface_type::extract(surface_type_input, surface_type_output);
    if (type_root <= -1) {
        return lowering::body_context::invalid();
    }
    let type_input: lowering::types::TypeInput = lowering::types::TypeInput {
        source: lowering::types::region(context.source, context.source_length),
        tokens: context.tokens,
        arena: surface_type_output,
        root: type_root,
        resolutions: context.resolutions,
        aliases: context.alias_catalog,
    };
    let type_workspace: lowering::types::TypeWorkspace = lowering::types::TypeWorkspace {
        alias_scratch: lowering::types::region(context.alias_scratch, context.alias_scratch_capacity),
        output: context.type_output,
    };
    let lowered: lowering::types::TypeLowerResult = lowering::types::lower(type_input, type_workspace);
    let missing: ir::type_ref::TypeRef = ir::type_ref::Invalid;
    let kind: ir::type_ref::TypeRef = match (lowered) {
        lowering::types::Lowered(value) -> value,
        _ -> missing,
    };
    if (!ir::type_ref::valid(kind)) {
        return lowering::body_context::unsupported();
    }
    let declaration: ir::body_events::LocalDeclaration = ir::body_events::LocalDeclaration {
        id: name,
        kind: kind
    };
    return match (initializer) {
        verified::surface_statement::Uninitialized -> bind_local(context, name, kind, lowering::body_event_write::statement_let_uninitialized(output, position, declaration)),
        verified::surface_statement::Initialized(surface) -> explicit_initialized(context, name, kind, surface, output, position, depth),
    };
}
fn explicit_initialized(context: BodyContext, name: i32, kind: ir::type_ref::TypeRef, surface: i32, output: Region, position: i32, depth: i32) -> i32 {
    let next: i32 = lowering::body_event_write::statement_let(output, position, ir::body_events::LocalDeclaration {
        id: name, kind: kind,
    }
    );
    if (next <= -1) {
        return lowering::body_context::invalid();
    }
    next = lowering::body_expression::expression_from_surface_expected(
        context, surface, kind, output, next, depth - 1);
    return bind_local(context, name, kind, next);
}
fn inferred_initialized(context: BodyContext, name: i32, surface: i32, output: Region, position: i32, depth: i32) -> i32 {
    let arena: verified::surface_expr::ExpressionArena = context.expression_arena;
    let root: i32 = lowering::body_expression::extract_expression(context, surface, depth - 1);
    if (root <= -1 || verified::surface_expr::node_count(arena) <= 0) {
        return lowering::body_context::invalid();
    }
    let inferred: lowering::body_expression::ExpressionKind = lowering::body_expression::expression_kind(context, verified::surface_expr::node_count(arena), root, depth - 1);
    let kind: ir::type_ref::TypeRef = lowering::body_expression::kind_type(inferred);
    if (!ir::type_ref::valid(kind)) {
        return lowering::body_context::unsupported();
    }
    let next: i32 = lowering::body_event_write::statement_let(output, position, ir::body_events::LocalDeclaration {
        id: name, kind: kind,
    }
    );
    if (next <= -1) {
        return lowering::body_context::invalid();
    }
    next = lowering::body_expression::expression(context, verified::surface_expr::node_count(arena), root, output, next, depth - 1);
    return bind_local(context, name, kind, next);
}
fn inferred_let(context: BodyContext, name: i32, initializer: verified::surface_statement::Initializer, output: Region, position: i32, depth: i32) -> i32 {
    return match (initializer) {
        verified::surface_statement::Initialized(surface) -> inferred_initialized(context, name, surface, output, position, depth),
        verified::surface_statement::Uninitialized -> lowering::body_context::unsupported(),
    };
}
fn lower_let(context: BodyContext, binding: Binding, output: Region, position: i32, depth: i32) -> i32 {
    return match (binding.annotation) {
        verified::surface_statement::Explicit(type_surface) -> explicit_let(context, binding.name, type_surface, binding.initializer, output, position, depth),
        verified::surface_statement::Inferred -> inferred_let(context, binding.name, binding.initializer, output, position, depth),
    };
}
fn return_value(context: BodyContext, surface: i32, output: Region, position: i32, depth: i32) -> i32 {
    let next: i32 = lowering::body_event_write::statement_return(output, position, backend::syntax::Present);
    return lowering::body_expression::expression_from_surface_expected(
        context, surface, context.return_kind, output, next, depth - 1);
}
fn expression_statement(context: BodyContext, surface: i32, output: Region, position: i32, depth: i32) -> i32 {
    let next: i32 = lowering::body_event_write::statement_expression(output, position);
    return lowering::body_expression::expression_from_surface(context, surface, output, next, depth - 1);
}
fn while_statement(context: BodyContext, loop: verified::surface_statement::ConditionalBlock, output: Region, position: i32, depth: i32) -> i32 {
    let next: i32 = lowering::body_event_write::statement_while(output, position);
    next = lowering::body_expression::expression_from_surface(context, loop.condition, output, next, depth - 1);
    if (next <= -1) {
        return next;
    }
    return block_statements(context, loop.body, output, next, depth - 1);
}
fn else_branch(context: BodyContext, otherwise: verified::surface_statement::ElseBranch, output: Region, next: i32, depth: i32) -> i32 {
    return match (otherwise) {
        verified::surface_statement::ElseBlock(block) -> block_statements(context, block, output, next, depth - 1),
        verified::surface_statement::NoElse -> lowering::body_event_write::statement_skip(output, next),
    };
}
fn if_statement(context: BodyContext, branch: verified::surface_statement::Branch, output: Region, position: i32, depth: i32) -> i32 {
    let next: i32 = lowering::body_event_write::statement_if(output, position);
    next = lowering::body_expression::expression_from_surface(context, branch.condition, output, next, depth - 1);
    if (next <= -1) {
        return next;
    }
    next = block_statements(context, branch.then_block, output, next, depth - 1);
    if (next <= -1) {
        return next;
    }
    return else_branch(context, branch.otherwise, output, next, depth);
}
fn statement(context: BodyContext, node: i32, output: Region, position: i32, depth: i32) -> i32 {
    if (depth <= 0) {
        return lowering::body_context::invalid();
    }
    let parsed: verified::surface_statement::Statement = verified::surface_statement::read(context.tree, node);
    return match (parsed) {
        verified::surface_statement::ReturnVoid -> lowering::body_event_write::statement_return(output, position, backend::syntax::Absent),
        verified::surface_statement::ReturnValue(surface) -> return_value(context, surface, output, position, depth),
        verified::surface_statement::Expression(expression_surface) -> expression_statement(context, expression_surface, output, position, depth),
        verified::surface_statement::Let(binding) -> lower_let(context, binding, output, position, depth),
        verified::surface_statement::Block(block) -> block_statements(context, block, output, position, depth - 1),
        verified::surface_statement::While(loop) -> while_statement(context, loop, output, position, depth),
        verified::surface_statement::If(branch) -> if_statement(context, branch, output, position, depth),
        verified::surface_statement::Unsupported -> lowering::body_context::unsupported(),
    };
}
pub fn block_statements(context: BodyContext, block: i32, output: Region, position: i32, depth: i32) -> i32 {
    if (depth <= 0) {
        return lowering::body_context::invalid();
    }
    let list: i32 = verified::surface_statement::block_statements(context.tree, block);
    if (list <= -1) {
        return lowering::body_context::invalid();
    }
    let locals: lowering::locals::Table = context.locals;
    let outer_local_count: i32 = lowering::locals::save(locals);
    let result: i32 = statement_list(context, list, output, position, depth - 1);
    lowering::locals::restore(locals, outer_local_count);
    return result;
}
fn lower_list_entry(context: BodyContext, entry: verified::surface_statement::ListEntry, output: Region, position: i32, depth: i32) -> i32 {
    let first: verified::surface_statement::Statement = verified::surface_statement::read(context.tree, entry.first);
    let is_return: bool = match (first) {
        verified::surface_statement::ReturnVoid -> true,
        verified::surface_statement::ReturnValue(value) -> true,
        _ -> false,
    };
    if (is_return) {
        let terminal: bool = match (
            verified::surface_statement::statement_list(context.tree,
                entry.rest)) {
            verified::surface_statement::ListEnd -> true,
            _ -> false,
        };
        if (terminal) {
            return statement(context, entry.first, output, position,
                depth - 1);
        }
    }
    let is_let: bool = match (first) {
        verified::surface_statement::Let(binding) -> true,
        _ -> false,
    }; // Core LET owns its continuation; other statements need SEQUENCE.
    let next: i32 = position;
    if (!is_let) {
        next = lowering::body_event_write::statement_sequence(output, position);
    }
    next = statement(context, entry.first, output, next, depth - 1);
    if (next <= -1) {
        return next;
    }
    return statement_list(context, entry.rest, output, next, depth - 1);
}
fn statement_list(context: BodyContext, list: i32, output: Region, position: i32, depth: i32) -> i32 {
    if (depth <= 0) {
        return lowering::body_context::invalid();
    }
    let parsed: verified::surface_statement::StatementList = verified::surface_statement::statement_list(context.tree, list);
    return match (parsed) {
        verified::surface_statement::ListEnd -> lowering::body_event_write::statement_skip(output, position),
        verified::surface_statement::ListMore(entry) -> lower_list_entry(context, entry, output, position, depth),
        verified::surface_statement::InvalidList -> lowering::body_context::invalid(),
    };
}
