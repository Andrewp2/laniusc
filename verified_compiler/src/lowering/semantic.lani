module lowering::semantic;

import lowering::declarations;
import lowering::aliases;
import lowering::types;
import verified::parser;
import verified::surface_tree;
import verified::surface_type;

// The syntax extractor deliberately stops before semantic reconstruction.
// This small producer is the boundary used by the bootstrap compiler: it
// finds the zero-argument `main` declaration, reconstructs its return type
// from the authenticated parse tree, and proves that that type is one of the
// builtin transport types.  Named paths are not guessed; they remain an
// explicit future resolver input and therefore fail closed here and in the
// later lowering passes.
pub const SUCCESS: i32 = 0;
pub const BAD_INPUT: i32 = 1;
pub const NO_MAIN_RETURN: i32 = 2;
pub const TYPE: i32 = 3;

fn child(records: [i32], length: i32, offsets: [i32], count: i32,
    node: i32, index: i32) -> i32 {
    return verified::surface_tree::child(records, length, offsets, count,
        node, index, verified::parser::CHILD_STATE, 0);
}

fn same_name(source: [i32], source_length: i32, tokens: [i32],
    token_count: i32, token: i32, a: i32, b: i32, c: i32, d: i32) -> bool {
    if (token <= -1 || token >= token_count || source_length <= -1) { return false; }
    if (tokens[token * 3] != 1) { return false; }
    let start: i32 = tokens[token * 3 + 1];
    let finish: i32 = tokens[token * 3 + 2];
    if (start <= -1 || finish - start != 4 || finish > source_length) { return false; }
    return source[start] == a && source[start + 1] == b
        && source[start + 2] == c && source[start + 3] == d;
}

// Reconstruct the semantic input required by lowering::program.  The caller
// supplies the declaration table so the same authenticated rows can be reused
// by the program composition pass.  A zero resolution length is meaningful:
// it certifies that this supported unit uses only builtin type spellings.
pub fn prepare(source: [i32], source_length: i32, tokens: [i32],
    token_count: i32, records: [i32], record_length: i32,
    offsets: [i32], node_count: i32, root: i32, declaration_table: [i32],
    declaration_capacity: i32, type_arena: [i32], type_capacity: i32,
    alias_catalog: [i32], alias_catalog_capacity: i32, alias_work: [i32],
    alias_work_capacity: i32, alias_stack: [i32], alias_stack_capacity: i32,
    alias_scratch: [i32], alias_scratch_capacity: i32, alias_result: [i32],
    alias_result_capacity: i32, type_output: [i32], type_output_capacity: i32,
    depth: i32) -> i32 {
    if (source_length <= -1 || token_count <= -1 || record_length <= -1
        || node_count <= 0 || root <= -1 || root >= node_count
        || declaration_capacity <= lowering::declarations::HEADER - 1
        || type_capacity <= 0 || type_output_capacity <= 0 || depth <= 0) {
        return -BAD_INPUT;
    }
    let declaration_words: i32 = lowering::declarations::collect(records, record_length,
        offsets, node_count, token_count, root, 0, declaration_table,
        declaration_capacity);
    if (declaration_words <= -1) { return -BAD_INPUT; }
    let alias_words: i32 = lowering::aliases::build(source, source_length,
        tokens, token_count, records, record_length, offsets, node_count,
        declaration_table, declaration_words, type_output, type_output_capacity,
        alias_work, alias_work_capacity, alias_stack, alias_stack_capacity,
        alias_scratch, alias_scratch_capacity, alias_result, alias_result_capacity,
        alias_catalog, alias_catalog_capacity, depth);
    if (alias_words <= -1) { return -TYPE; }
    let rows: i32 = declaration_table[0];
    let row: i32 = 0;
    let main_declaration: i32 = -1;
    while (row < rows) {
        let slot: i32 = lowering::declarations::HEADER + row * lowering::declarations::ROW;
        if (declaration_table[slot + 1] == lowering::declarations::FUNCTION
            && same_name(source, source_length, tokens, token_count,
                declaration_table[slot + 5], 109, 97, 105, 110)) {
            if (main_declaration != -1) { return -NO_MAIN_RETURN; }
            main_declaration = declaration_table[slot + 4];
        }
        row += 1;
    }
    if (main_declaration <= -1) { return -NO_MAIN_RETURN; }
    let return_optional: i32 = child(records, record_length, offsets,
        node_count, main_declaration, 6);
    let return_offset: i32 = verified::surface_tree::record(records,
        record_length, offsets, node_count, return_optional);
    // `35` is the grammar's no-return alternative.  The backend transport
    // currently requires a scalar result for an executable entrypoint.
    if (return_offset <= -1 || records[return_offset] == 35) {
        return -NO_MAIN_RETURN;
    }
    if (records[return_offset] != 34) { return -NO_MAIN_RETURN; }
    let type_node: i32 = child(records, record_length, offsets, node_count,
        return_optional, 1);
    let type_root: i32 = verified::surface_type::extract(records, record_length,
        offsets, node_count, token_count, type_node, type_arena,
        type_capacity, depth);
    if (type_root <= -1 || type_arena[0] <= 0) { return -TYPE; }
    let lowered_type: i32 = lowering::types::lower(source, source_length, tokens, token_count, type_arena,
        type_capacity, type_root, type_output, 0, alias_catalog, alias_words,
        alias_scratch, alias_scratch_capacity, type_output,
        type_output_capacity);
    if (lowered_type <= 0) { return -TYPE; }
    return type_root;
}
