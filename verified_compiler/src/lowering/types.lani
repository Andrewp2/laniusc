module lowering::types;

import lowering::aliases;
import lowering::builtin;
import ir::type_ref;
import verified::host;
import verified::surface_type;
import verified::token;

type TypeRef = ir::type_ref::TypeRef;

// This is the type boundary between the existing Surface type arena and the
// structural Core transport consumed by backend::program. A successful result
// means representable by that transport, not that every Lanius type is supported.
// Errors are distinct from successful native type values.
const RESOLUTION_FIELD_BYTES: i32 = 8;
pub const RESOLUTION_RECORD_BYTES: i32 =
    (1 + ir::type_ref::STORAGE_WORDS) * RESOLUTION_FIELD_BYTES;
pub const RESOLUTION_ALIGNMENT: i32 = RESOLUTION_FIELD_BYTES;
const RESULT_FIELD_BYTES: i32 = 8;
pub const RESULT_BYTES: i32 =
    ir::type_ref::STORAGE_WORDS * RESULT_FIELD_BYTES;
pub const RESULT_ALIGNMENT: i32 = RESULT_FIELD_BYTES;

// Resolution keys have two deliberately different domains. Surface-unit
// lowering can key a row by an arena node, while whole-program lowering keys
// it by an identifier token so independently extracted arenas can share the
// same table. Keep that distinction in the type instead of encoding it as a
// magic word inside the row buffer.
pub enum ResolutionKeyKind {
    ArenaNode,
    IdentifierToken,
}

pub struct WordRegion {
    data: [i32],
    words: i32,
}

pub fn region(data: [i32], words: i32) -> WordRegion {
    return WordRegion { data: data, words: words };
}

// One semantic type per Surface arena node. No Core type code is retained in
// this native workspace; only lower's result and the Core writer encode it.
pub struct Results {
    data: [ir::type_ref::TypeRef],
    count: i32,
}

pub fn results(data: [ir::type_ref::TypeRef], count: i32) -> Results {
    return Results { data: data, count: count };
}

pub fn result_allocation_bytes(count: i32) -> i32 {
    if (count <= -1 || count > verified::host::I32_MAX / RESULT_BYTES) {
        return -1;
    }
    if (count == 0) { return RESULT_BYTES; }
    return count * RESULT_BYTES;
}

pub fn results_from_raw_parts(memory: ptr, count: i32) -> Results {
    let first: ptr = memory;
    if (count > 0) {
        first = memory + count * RESULT_BYTES - RESULT_FIELD_BYTES;
    }
    return results(slice_from_raw_parts(first, count), count);
}

pub struct ResolutionRow {
    key: i32,
    type_tag: ir::type_ref::TypeRef,
}

pub struct ResolutionTable {
    data: [ResolutionRow],
    count: i32,
    keys: ResolutionKeyKind,
}

pub fn resolutions(data: [ResolutionRow], count: i32,
    keys: ResolutionKeyKind) -> ResolutionTable {
    return ResolutionTable { data: data, count: count, keys: keys };
}

pub fn from_raw_parts(memory: ptr, count: i32,
    keys: ResolutionKeyKind) -> ResolutionTable {
    let first: ptr = memory;
    if (count > 0) {
        first = memory + count * RESOLUTION_RECORD_BYTES
            - RESOLUTION_FIELD_BYTES;
    }
    return resolutions(slice_from_raw_parts(first, count), count, keys);
}

pub fn copy_rows(input: ResolutionTable, offset: i32, count: i32,
    output: ResolutionTable) -> bool {
    if (token_keyed(input.keys) != token_keyed(output.keys)
        || offset <= -1 || count <= -1 || offset > input.count
        || count > input.count - offset || count > output.count) {
        return false;
    }
    let source: [ResolutionRow] = input.data;
    let destination: [ResolutionRow] = output.data;
    let row: i32 = 0;
    while (row <= count - 1) {
        destination[row] = source[offset + row];
        row += 1;
    }
    return true;
}

pub struct TypeInput {
    source: WordRegion,
    tokens: verified::token::TokenTable,
    arena: verified::surface_type::TypeArena,
    root: i32,
    resolutions: ResolutionTable,
    aliases: lowering::aliases::Catalog,
}

pub struct TypeWorkspace {
    alias_scratch: WordRegion,
    output: Results,
}

pub enum TypeLowerResult {
    Lowered(TypeRef),
    InvalidInput,
    UnsupportedFeature,
}

fn invalid() -> TypeLowerResult {
    return InvalidInput;
}

fn unsupported() -> TypeLowerResult {
    return UnsupportedFeature;
}

fn type_expression_kind(kind: verified::surface_type::SurfaceTypeKind) -> bool {
    return verified::surface_type::kind_is(kind,
            verified::surface_type::PathType)
        || verified::surface_type::kind_is(kind,
            verified::surface_type::Array)
        || verified::surface_type::kind_is(kind,
            verified::surface_type::Slice)
        || verified::surface_type::kind_is(kind,
            verified::surface_type::Reference);
}

// Name resolution is an independent compiler pass. ArenaNode tables contain
// a path-arena-node key. IdentifierToken tables contain the exact source-token
// key of a resolved type use, so qualified paths with the same final spelling
// can denote different declarations. Rows are sorted and duplicate keys fail.
fn resolved_arena(resolutions: [ResolutionRow], count: i32,
    node: i32) -> ir::type_ref::TypeRef {
    let missing: ir::type_ref::TypeRef = ir::type_ref::Invalid;
    let match_index: i32 = -1;
    let position: i32 = 0;
    while (position <= count - 1) {
        if (resolutions[position].key == node) {
            if (match_index >= 0) { return missing; }
            match_index = position;
        }
        position += 1;
    }
    if (match_index < 0) { return missing; }
    return resolutions[match_index].type_tag;
}

fn resolved_token(resolutions: [ResolutionRow], count: i32,
    token: i32) -> ir::type_ref::TypeRef {
    let missing: ir::type_ref::TypeRef = ir::type_ref::Invalid;
    let match_index: i32 = -1;
    let position: i32 = 0;
    while (position <= count - 1) {
        if (token == resolutions[position].key) {
            if (match_index >= 0) { return missing; }
            match_index = position;
        }
        position += 1;
    }
    if (match_index < 0) { return missing; }
    return resolutions[match_index].type_tag;
}

fn token_keyed(kind: ResolutionKeyKind) -> bool {
    return match (kind) {
        ArenaNode -> false,
        IdentifierToken -> true,
    };
}

// Buffers are disjoint and lengths describe their actual storage, as at the
// existing extractor boundary. Token rows here are native records decoded
// once from the frontend's canonical [kind,start,end] format.
// The caller supplies the native Surface type arena, not its byte carrier.
// Output has one slot per arena node; only type-node slots are Core type tags.
// Failure leaves a partial output which the caller must discard. This pass
// does not mutate source syntax or perform parsing, name lookup, or emission.
pub fn lower(input: TypeInput, workspace: TypeWorkspace) -> TypeLowerResult {
    let source: [i32] = input.source.data;
    let source_length: i32 = input.source.words;
    let tokens: [verified::token::TokenRow] = input.tokens.data;
    let token_count: i32 = input.tokens.count;
    let spellings: verified::token::SpellingView =
        verified::token::spellings(source, source_length,
            input.tokens, token_count);
    let arena: verified::surface_type::TypeArena =
        input.arena;
    let nodes: [verified::surface_type::TypeNode] = arena.data;
    let arena_count: [verified::surface_type::CountCell] = arena.count;
    let root: i32 = input.root;
    let resolution_table: ResolutionTable = input.resolutions;
    let resolutions: [ResolutionRow] = resolution_table.data;
    let resolution_count: i32 = resolution_table.count;
    let nominal_table: bool = token_keyed(resolution_table.keys);
    let alias_catalog: lowering::aliases::Catalog = input.aliases;
    let alias_scratch: [i32] = workspace.alias_scratch.data;
    let alias_scratch_capacity: i32 = workspace.alias_scratch.words;
    let output: [ir::type_ref::TypeRef] = workspace.output.data;
    let capacity: i32 = workspace.output.count;
    if (source_length <= -1 || token_count <= -1
        || arena.capacity <= 0 || resolution_count <= -1
        || alias_scratch_capacity <= -1) {
        return invalid();
    }
    if (!lowering::aliases::valid_or_empty(alias_catalog,
            input.tokens)) { return invalid(); }
    let count: i32 = arena_count[0].value;
    if (count <= 0
        || count > arena.capacity
        || capacity <= count - 1
        || root <= -1 || root >= count) { return invalid(); }
    let position: i32 = 0;
    let previous: i32 = -1;
    while (position <= resolution_count - 1) {
        let key: i32 = resolutions[position].key;
        if (nominal_table) {
            if (key <= previous || key <= -1 || key >= token_count
                || !ir::type_ref::is_nominal(
                    resolutions[position].type_tag)) {
                return invalid();
            }
            previous = key;
        } else {
            if (key <= previous || key <= -1 || key >= count
                || !verified::surface_type::kind_is(
                    nodes[key].kind,
                    verified::surface_type::Path)
                || !ir::type_ref::valid(resolutions[position].type_tag)) {
                return invalid();
            }
            previous = key;
        }
        position += 1;
    }
    let node: i32 = 0;
    while (node <= count - 1) {
        let kind: verified::surface_type::SurfaceTypeKind = nodes[node].kind;
        let first: i32 = nodes[node].first;
        output[node] = ir::type_ref::Invalid;
        if (verified::surface_type::kind_is(kind,
                verified::surface_type::Segment)) {
            if (first != -1) { return unsupported(); }
            let token: i32 = nodes[node].token;
            if (token <= -1 || token >= token_count) { return invalid(); }
            let start: i32 = tokens[token].start;
            let finish: i32 = tokens[token].finish;
            if (start <= -1 || finish <= start || finish > source_length) { return invalid(); }
            let next: i32 = nodes[node].next;
            if (next != -1 && (next <= node || next >= count
                || !verified::surface_type::kind_is(
                    nodes[next].kind,
                    verified::surface_type::Segment))) {
                return invalid();
            }
        } else {
            if (first <= -1 || first >= node) { return invalid(); }
            if (verified::surface_type::kind_is(kind,
                    verified::surface_type::Path)) {
                let segment: i32 = first;
                let segments: i32 = 0;
                while (segment != -1) {
                    if (segment <= -1 || segment >= node
                        || !verified::surface_type::kind_is(
                            nodes[segment].kind,
                            verified::surface_type::Segment)) {
                        return invalid();
                    }
                    segments += 1;
                    segment = nodes[segment].next;
                }
                if (segments == 1) {
                    let token: i32 = nodes[first].token;
                    let builtin_result: lowering::builtin::Lookup =
                        lowering::builtin::lookup(source, source_length,
                            tokens[token].start, tokens[token].finish);
                    let builtin_unsupported: bool = match (builtin_result) {
                        lowering::builtin::UnsupportedType -> true,
                        _ -> false,
                    };
                    if (builtin_unsupported) { return unsupported(); }
                    let missing: ir::type_ref::TypeRef = ir::type_ref::Invalid;
                    let builtin_type: ir::type_ref::TypeRef = match (builtin_result) {
                        lowering::builtin::Supported(kind) -> kind,
                        _ -> missing,
                    };
                    if (ir::type_ref::valid(builtin_type)) {
                        output[node] = builtin_type;
                    }
                }
                if (!ir::type_ref::valid(output[node])) {
                    let alias_input: lowering::aliases::AliasLookupInput =
                        lowering::aliases::AliasLookupInput {
                            source: lowering::aliases::region(source,
                                source_length),
                            tokens: input.tokens,
                            catalog: alias_catalog,
                            arena: arena,
                            root: node,
                        };
                    let alias_workspace:
                        lowering::aliases::AliasLookupWorkspace =
                        lowering::aliases::AliasLookupWorkspace {
                            scratch: lowering::aliases::region(alias_scratch,
                                alias_scratch_capacity),
                        };
                    let alias_result: lowering::aliases::ScalarLookup =
                        lowering::aliases::scalar(
                        alias_input, alias_workspace);
                    let alias_ambiguous: bool = match (alias_result) {
                        lowering::aliases::ScalarAmbiguous -> true,
                        _ -> false,
                    };
                    let alias_unsupported: bool = match (alias_result) {
                        lowering::aliases::ScalarUnsupported -> true,
                        _ -> false,
                    };
                    let alias_invalid: bool = match (alias_result) {
                        lowering::aliases::ScalarInvalid -> true,
                        _ -> false,
                    };
                    if (alias_ambiguous) { return invalid(); }
                    if (alias_unsupported) { return unsupported(); }
                    if (alias_invalid) { return invalid(); }
                    let missing: ir::type_ref::TypeRef = ir::type_ref::Invalid;
                    let alias_type: ir::type_ref::TypeRef = match (alias_result) {
                        lowering::aliases::ScalarFound(kind) -> kind,
                        _ -> missing,
                    };
                    if (ir::type_ref::valid(alias_type)) {
                        output[node] = alias_type;
                    }
                    else {
                        if (nominal_table) {
                            // The resolver keys each qualified or unqualified
                            // type use by its own final identifier token.
                            let nominal_segment: i32 = first;
                            while (nodes[nominal_segment].next != -1) {
                                nominal_segment = nodes[nominal_segment].next;
                            }
                            let nominal_token: i32 = nodes[nominal_segment].token;
                            output[node] = resolved_token(
                                resolutions, resolution_count, nominal_token);
                        } else {
                            output[node] = resolved_arena(
                                resolutions, resolution_count, node);
                        }
                    }
                }
                if (!ir::type_ref::valid(output[node])) {
                    return invalid();
                }
            } else {
                if (verified::surface_type::kind_is(kind,
                        verified::surface_type::PathType)) {
                    if (!verified::surface_type::kind_is(
                            nodes[first].kind,
                            verified::surface_type::Path)) { return invalid(); }
                    output[node] = output[first];
                } else {
                    if (verified::surface_type::kind_is(kind,
                            verified::surface_type::Slice)) {
                        if (!type_expression_kind(nodes[first].kind)) {
                            return invalid();
                        }
                        let element: ir::type_ref::TypeRef = output[first];
                        if (ir::type_ref::same(element, ir::type_ref::I32)) {
                            output[node] = ir::type_ref::Slice;
                        } else {
                            let id: i32 = match (element) {
                                ir::type_ref::Nominal(value) -> value,
                                _ -> -1,
                            };
                            if (id <= -1) { return unsupported(); }
                            output[node] = ir::type_ref::NominalSlice(id);
                        }
                    } else {
                        if (verified::surface_type::kind_is(kind,
                                verified::surface_type::Array)
                            || verified::surface_type::kind_is(kind,
                                verified::surface_type::Reference)) {
                            return unsupported();
                        }
                        return invalid();
                    }
                }
            }
        }
        node += 1;
    }
    if (!type_expression_kind(nodes[root].kind)) { return invalid(); }
    let result: ir::type_ref::TypeRef = output[root];
    return Lowered(result);
}
