module lowering::modules;
import verified::production;

import lowering::declarations;
import verified::parser;
import verified::surface_path;
import verified::syntax_tree;
import verified::token;

pub struct ModuleInput {
    tokens: verified::token::TokenTable,
    source_length: i32,
    tree: verified::syntax_tree::Tree,
    declarations: lowering::declarations::Table,
}

struct ModuleContext {
    tokens: verified::token::TokenTable,
    token_count: i32,
    source_length: i32,
    tree: verified::syntax_tree::Tree,
}

fn child(tree: verified::syntax_tree::Tree, node: i32,
    index: i32) -> i32 {
    return verified::syntax_tree::child(tree, node, index,
        verified::parser::StateChild);
}

// Validate plain paths against the materialized tree and canonical tokens.
// Generic segments are rejected, as in Declarations.plainPath?.
fn path(context: ModuleContext, root: i32) -> bool {
    let tokens: [verified::token::TokenRow] = context.tokens.data;
    let tree: verified::syntax_tree::Tree = context.tree;
    let token_count: i32 = context.token_count;
    let source_length: i32 = context.source_length;
    let segment: verified::surface_path::Segment =
        verified::surface_path::first(tree, root);
    let previous_token: i32 = -1;
    let previous_finish: i32 = 0;
    while (segment.valid) {
        let name: i32 = segment.token;
        if (name <= -1 || name >= token_count || name <= previous_token
            || tokens[name].kind != verified::token::Identifier) {
            return false;
        }
        let start: i32 = tokens[name].start;
        let finish: i32 = tokens[name].finish;
        if (start <= previous_finish - 1 || finish <= start
            || finish > source_length) { return false; }
        previous_token = name;
        previous_finish = finish;
        if (segment.last) { return true; }
        segment = verified::surface_path::next(tree, segment);
    }
    return false;
}

// Project module/import paths from one successful declaration collector table.
// Tokens are native records decoded once from canonical frontend rows;
// the source bytes are retained by the caller, not copied or rescanned here.
// Lengths match real storage, and all input/output buffers are disjoint.
//
// Like declaredModulePath?, the module must be the first source item. The
// collector's stronger exactly-one-module contract is checked too. Generic
// paths and string imports are unsupported. The latter already fail in the
// collector; their tail production is also rejected defensively here.
// Path records are not needed after this check; only the verdict advances.
pub fn validate(input: ModuleInput) -> bool {
    let tokens: verified::token::TokenTable = input.tokens;
    let token_count: i32 = input.tokens.count;
    let source_length: i32 = input.source_length;
    let tree: verified::syntax_tree::Tree = input.tree;
    let table: lowering::declarations::Table = input.declarations;
    if (token_count <= -1
        || source_length <= -1 || tree.node_count <= 0) {
        return false;
    }
    if (table.count <= 0) { return false; }
    let header: lowering::declarations::DeclarationCounts =
        lowering::declarations::table_header(table);
    let rows: i32 = lowering::declarations::count_rows(header);
    if (rows <= 0 || rows != table.count
        || lowering::declarations::kind_count(header,
            lowering::declarations::Module) != 1
        || lowering::declarations::kind_count(header,
            lowering::declarations::Import) <= -1
        || lowering::declarations::kind_count(header,
            lowering::declarations::Import) >= rows) { return false; }
    let first: lowering::declarations::DeclarationRow =
        lowering::declarations::table_row(table, 0);
    if (lowering::declarations::row_unit(first) <= -1
        || !lowering::declarations::row_has_kind(first,
            lowering::declarations::Module)) { return false; }
    let unit: i32 = lowering::declarations::row_unit(first);
    let paths: i32 = 0;
    let context: ModuleContext = ModuleContext {
        tokens: tokens,
        token_count: token_count,
        source_length: source_length,
        tree: tree,
    };
    let row: i32 = 0;
    while (row <= rows - 1) {
        let declaration_row: lowering::declarations::DeclarationRow =
            lowering::declarations::table_row(table, row);
        if (lowering::declarations::row_unit(declaration_row) != unit
            || lowering::declarations::row_has_kind(declaration_row,
                lowering::declarations::Invalid)) { return false; }
        if (lowering::declarations::row_has_kind(declaration_row,
                lowering::declarations::Module)
            || lowering::declarations::row_has_kind(declaration_row,
                lowering::declarations::Import)) {
            if (lowering::declarations::row_is_public(declaration_row)
                || lowering::declarations::row_name(declaration_row) != -1) {
                return false;
            }
            let item: i32 = lowering::declarations::row_item(declaration_row);
            let declaration: i32 = lowering::declarations::row_declaration(
                declaration_row);
            let target: i32 = lowering::declarations::row_target(
                declaration_row);
            let item_production: i32 =
                verified::syntax_tree::production(tree, item);
            let declaration_production: i32 =
                verified::syntax_tree::production(tree, declaration);
            if (item_production <= -1 || declaration_production <= -1
                || child(tree, item, 0) != declaration) {
                return false;
            }
            let actual: i32 = child(tree, declaration, 1);
            if (lowering::declarations::row_has_kind(declaration_row,
                    lowering::declarations::Module)) {
                if (row != 0 || paths != 0
                    || lowering::declarations::row_ordinal(declaration_row) != 0
                    || item_production != verified::production::ITEM_MODULE
                    || declaration_production != verified::production::MODULE) {
                    return false;
                }
            } else {
                if (paths <= 0
                    || lowering::declarations::row_ordinal(declaration_row)
                        != paths - 1
                    || item_production != verified::production::ITEM_IMPORT
                    || declaration_production != verified::production::IMPORT) {
                    return false;
                }
                if (verified::syntax_tree::production(tree, actual)
                        != verified::production::IMPORT_PATH) {
                    return false;
                }
                actual = child(tree, actual, 0);
            }
            if (actual != target || !path(context, target)) { return false; }
            paths += 1;
        }
        row += 1;
    }
    if (paths != lowering::declarations::kind_count(header,
            lowering::declarations::Module)
            + lowering::declarations::kind_count(header,
                lowering::declarations::Import)) { return false; }
    return true;
}
