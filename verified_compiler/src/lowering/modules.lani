module lowering::modules;

import lowering::declarations;
import verified::surface_tree;
import verified::parser;
import verified::token;

pub const HEADER: i32 = 4;
pub const SEGMENT: i32 = 4;

fn child(records: [i32], length: i32, offsets: [i32], count: i32,
    node: i32, index: i32) -> i32 {
    return verified::surface_tree::child(records, length, offsets, count,
        node, index, verified::parser::CHILD_STATE, 0);
}

// This is the plain-path projection of surface_path_output's existing
// materialized-tree traversal, not a token parser. Generic segments (49)
// are rejected, as in Declarations.plainPath?.
fn path(tokens: [i32], token_count: i32, source_length: i32,
    records: [i32], length: i32, offsets: [i32], count: i32,
    root: i32, output: [i32], capacity: i32, position: i32) -> i32 {
    let root_offset: i32 = verified::surface_tree::record(records, length, offsets, count, root);
    if (root_offset < 0 || records[root_offset] != 47 || records[root_offset + 3] != 2
        || position < 0 || position >= capacity) { return -1; }
    let segment: i32 = child(records, length, offsets, count, root, 0);
    let tail: i32 = child(records, length, offsets, count, root, 1);
    let written: i32 = position + 1;
    let segments: i32 = 0;
    let previous_token: i32 = -1;
    let previous_finish: i32 = 0;
    while (segment >= 0) {
        let offset: i32 = verified::surface_tree::record(records, length, offsets, count, segment);
        if (offset < 0 || records[offset] != 48 || records[offset + 3] != 1
            || capacity - written < SEGMENT) { return -1; }
        let name: i32 = verified::surface_tree::child(records, length, offsets, count,
            segment, 0, verified::parser::CHILD_TOKEN, token_count);
        if (name < 0 || name <= previous_token || tokens[name * 3] != verified::token::IDENTIFIER) { return -1; }
        let start: i32 = tokens[name * 3 + 1];
        let finish: i32 = tokens[name * 3 + 2];
        if (start < previous_finish || finish <= start || finish > source_length) { return -1; }
        output[written] = segment;
        output[written + 1] = name;
        output[written + 2] = start;
        output[written + 3] = finish - start;
        written += SEGMENT;
        segments += 1;
        previous_token = name;
        previous_finish = finish;
        let tail_offset: i32 = verified::surface_tree::record(records, length, offsets, count, tail);
        if (tail_offset < 0) { return -1; }
        if (records[tail_offset] == 51) {
            if (records[tail_offset + 3] != 0) { return -1; }
            output[position] = segments;
            return written;
        }
        if (records[tail_offset] != 50 || records[tail_offset + 3] != 4) { return -1; }
        segment = child(records, length, offsets, count, tail, 2);
        tail = child(records, length, offsets, count, tail, 3);
    }
    return -1;
}

// Project module/import paths from one successful declaration collector table.
// Tokens are authenticated canonical [kind,start,end] rows into the source;
// the source bytes are retained by the caller, not copied or rescanned here.
// Lengths match real storage, and all input/output buffers are disjoint.
//
// Output header: [unit, path-count, total-segments, total-output-words].
// Each variable-size path record is the original eight-word collector row,
// followed by its segment count and four words per segment:
//   [segment-node, name-token, source-byte-start, source-byte-length].
// Spans preserve exact spelling and origin; no host-assigned name IDs occur.
// Import order and duplicates are preserved. This does not resolve imports
// to modules, reject self/missing imports, or check global module uniqueness.
//
// Like declaredModulePath?, the module must be the first source item. The
// collector's stronger exactly-one-module contract is checked too. Generic
// paths and string imports are unsupported. The latter already fail in the
// collector; their tail production is also rejected defensively here.
// Return output word count, or -1; failure output is partial and discarded.
pub fn materialize(tokens: [i32], token_count: i32, source_length: i32,
    records: [i32], length: i32, offsets: [i32], count: i32,
    table: [i32], table_length: i32, output: [i32], capacity: i32) -> i32 {
    if (token_count < 0 || token_count > 715827882 || source_length < 0
        || length < 0 || count <= 0 || table_length < 16 || capacity < HEADER) { return -1; }
    let rows: i32 = table[0];
    if (rows <= 0 || rows > (table_length - 8) / 8 || table_length != 8 + rows * 8
        || table[6] != 1 || table[7] < 0 || table[7] >= rows
        || table[8] < 0 || table[9] != lowering::declarations::MODULE) { return -1; }
    let unit: i32 = table[8];
    let paths: i32 = 0;
    let segments: i32 = 0;
    let written: i32 = HEADER;
    let row: i32 = 0;
    while (row < rows) {
        let slot: i32 = 8 + row * 8;
        let kind: i32 = table[slot + 1];
        if (table[slot] != unit || kind < 1 || kind > 7) { return -1; }
        if (kind >= lowering::declarations::MODULE) {
            if (capacity - written < 9 || table[slot + 2] != 0 || table[slot + 5] != -1) { return -1; }
            let item: i32 = table[slot + 3];
            let declaration: i32 = table[slot + 4];
            let target: i32 = table[slot + 6];
            let item_offset: i32 = verified::surface_tree::record(records, length, offsets, count, item);
            let declaration_offset: i32 = verified::surface_tree::record(records, length, offsets, count, declaration);
            if (item_offset < 0 || declaration_offset < 0
                || child(records, length, offsets, count, item, 0) != declaration) { return -1; }
            let actual: i32 = child(records, length, offsets, count, declaration, 1);
            if (kind == lowering::declarations::MODULE) {
                if (row != 0 || paths != 0 || table[slot + 7] != 0
                    || records[item_offset] != 7 || records[declaration_offset] != 46) { return -1; }
            } else {
                if (paths <= 0 || table[slot + 7] != paths - 1
                    || records[item_offset] != 6 || records[declaration_offset] != 43) { return -1; }
                let tail_offset: i32 = verified::surface_tree::record(records, length, offsets, count, actual);
                if (tail_offset < 0 || records[tail_offset] != 44) { return -1; }
                actual = child(records, length, offsets, count, actual, 0);
            }
            if (actual != target) { return -1; }
            let index: i32 = 0;
            while (index < 8) { output[written + index] = table[slot + index]; index += 1; }
            let next: i32 = path(tokens, token_count, source_length, records, length,
                offsets, count, target, output, capacity, written + 8);
            if (next < 0) { return -1; }
            segments += output[written + 8];
            written = next;
            paths += 1;
        }
        row += 1;
    }
    if (paths != table[7] + 1) { return -1; }
    output[0] = unit;
    output[1] = paths;
    output[2] = segments;
    output[3] = written;
    return written;
}
