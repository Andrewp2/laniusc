module lowering::transport;

import backend::syntax;
import ir::function_catalog;
import ir::body_catalog;
import ir::body_events;
import ir::type_ref;
import lowering::body_serialization;
import lowering::allocation;
import lowering::declarations;
import lowering::error;
import lowering::signature_index;
import lowering::signature_validation;
import lowering::signatures;
import lowering::unit_descriptor;
import runtime::service;
import verified::host;
import verified::token;

// Certificate transport is position independent: all IDs are Core IDs and
// records are copied in a fixed order. Native codegen also receives the typed
// catalogs retained alongside this serialization.
pub const VERSION: i32 = backend::syntax::PROGRAM_VERSION;
pub const POINTER_BITS: i32 = backend::syntax::POINTER_BITS;
pub const HEADER: i32 = backend::syntax::PROGRAM_HEADER_WORDS;
const FUNCTION_RECORD_HEADER_WORDS: i32 =
    backend::syntax::FUNCTION_RECORD_PREFIX_WORDS
        + backend::syntax::FUNCTION_HEADER_WORDS;

pub fn header_format_valid(input: [i32], length: i32) -> bool {
    if (length < HEADER) { return false; }
    let header: backend::syntax::ProgramHeader =
        backend::syntax::read_program_header(input);
    return header.version == VERSION && header.pointer_bits == POINTER_BITS;
}
fn invalid() -> i32 {
    return lowering::error::failure(lowering::error::InvalidInput);
}

fn unsupported() -> i32 {
    return lowering::error::failure(lowering::error::UnsupportedFeature);
}

// A multi-unit caller supplies one typed descriptor per source unit, in unit
// order. It points into flat source, token, and body catalogs. Signatures are
// already decoded into a native index keyed by canonical allocation IDs.

fn append(output: [i32], capacity: i32, position: i32, word: i32) -> i32 {
    if (position <= -1 || position >= capacity) { return -1; }
    output[position] = word;
    return position + 1;
}

fn append_type_layout(signatures: lowering::signature_index::Table,
    id: i32, output: [i32],
    capacity: i32, position: i32) -> i32 {
    let record: lowering::signatures::SignatureRecord =
        lowering::signature_index::record_at(signatures, id);
    let start: i32 = position;
    let written: i32 = append(output, capacity, position, 0);
    let arity: i32 = lowering::signatures::record_arity(record);
    if (written <= -1) { return invalid(); }
    written = append(output, capacity, written, id);
    if (written <= -1) { return invalid(); }
    if (lowering::signatures::record_has_shape(record,
        lowering::signatures::StructureShape)) {
        written = append(output, capacity, written,
            backend::syntax::layout_code(backend::syntax::StructureLayout));
        if (written <= -1) { return invalid(); }
        written = append(output, capacity, written, arity);
        if (written <= -1) { return invalid(); }
        let field: i32 = 0;
        while (field != arity) {
            let member: lowering::signatures::SignatureMember =
                lowering::signature_index::member_at(signatures, id, field);
            if (!ir::type_ref::valid(member.type_tag)) {
                return invalid();
            }
            written = append(output, capacity, written,
                ir::type_ref::code(member.type_tag));
            if (written <= -1) { return invalid(); }
            field += 1;
        }
    } else {
        if (!lowering::signatures::record_has_shape(record,
            lowering::signatures::EnumerationShape)) { return invalid(); }
        written = append(output, capacity, written,
            backend::syntax::layout_code(backend::syntax::EnumerationLayout));
        if (written <= -1) { return invalid(); }
        written = append(output, capacity, written, arity);
        if (written <= -1) { return invalid(); }
        let variant: i32 = 0;
        while (variant < arity) {
            let entry: lowering::signature_index::Variant =
                lowering::signature_index::variant_at(signatures, id,
                    variant);
            if (entry.field_count <= -1) { return invalid(); }
            written = append(output, capacity, written, entry.field_count);
            if (written <= -1) { return invalid(); }
            let field: i32 = 0;
            while (field < entry.field_count) {
                let type_ref: ir::type_ref::TypeRef = lowering::signature_index::enum_field_type(
                    signatures, id, variant, field);
                if (!ir::type_ref::valid(type_ref)) { return invalid(); }
                written = append(output, capacity, written,
                    ir::type_ref::code(type_ref));
                if (written <= -1) { return invalid(); }
                field += 1;
            }
            variant += 1;
        }
    }
    if (written <= -1) { return invalid(); }
    output[start] = written - start - 1;
    return written;
}

struct SourceTokens {
    source: [i32],
    source_length: i32,
    source_offset: i32,
    tokens: verified::token::TokenTable,
    token_count: i32,
    token_offset: i32,
}

enum TypeEmissionPass {
    StructuresPass,
    EnumerationsPass,
    TypesFinished,
}

enum FunctionEmissionPass {
    EntryPass,
    RemainingPass,
    FunctionsFinished,
}

fn matches_spelling(context: SourceTokens, token_index: i32,
    expected: str, expected_length: i32) -> bool {
    let tokens: [verified::token::TokenRow] = context.tokens.data;
    let source: [i32] = context.source;
    if (token_index <= -1 || token_index >= context.token_count
        || expected_length <= 0) { return false; }
    let token: i32 = context.token_offset + token_index;
    if (tokens[token].kind != verified::token::Identifier) { return false; }
    let start: i32 = tokens[token].start;
    let finish: i32 = tokens[token].finish;
    if (start <= -1 || finish <= start || finish > context.source_length
        || finish - start != expected_length) { return false; }
    let expected_words: [i32] = verified::host::i32_slice_from_raw_parts(
        verified::host::string_data_ptr(expected),
        (expected_length + verified::host::I32_BYTES - 1)
            / verified::host::I32_BYTES);
    let index: i32 = 0;
    while (index < expected_length) {
        let byte: i32 = (expected_words[index / verified::host::I32_BYTES]
            >> ((index % verified::host::I32_BYTES)
                * verified::host::BITS_PER_BYTE)) & verified::host::BYTE_MASK;
        if (source[context.source_offset + start + index] != byte) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn valid_range(offset: i32, words: i32, length: i32) -> bool {
    if (offset <= -1 || words <= -1 || length <= -1 || offset > length
        || words > length - offset) { return false; }
    return true;
}

fn append_defined_function(signatures: lowering::signature_index::Table,
    bodies: ir::body_catalog::Catalog, id: i32,
    output: [i32], capacity: i32, position: i32) -> i32 {
    let body_index: i32 = ir::body_catalog::find(bodies, id);
    if (body_index <= -1 || !lowering::signature_index::has_shape(
            signatures, id, lowering::signatures::InternalFunctionShape)) {
        return invalid();
    }
    let body: ir::body_catalog::FunctionBody =
        ir::body_catalog::at(bodies, body_index);
    let signature: lowering::signatures::SignatureRecord =
        lowering::signature_index::record_at(signatures, id);
    let parameters: i32 = lowering::signatures::record_arity(signature);
    if (parameters <= -1 || body.count <= 0
        || ir::type_ref::code(body.signature.result_type)
            != ir::type_ref::code(
                lowering::signatures::record_result_type(signature))
        || body.signature.parameters != parameters
        || position <= -1
        || position > capacity
            - FUNCTION_RECORD_HEADER_WORDS - 1
        || parameters > (capacity - position
            - FUNCTION_RECORD_HEADER_WORDS - 1)
            / backend::syntax::PARAMETER_ROW_WORDS) { return invalid(); }
    let first: i32 = append(output, capacity, position, 0);
    if (first <= -1) { return invalid(); }
    let header: backend::syntax::FunctionHeader =
        backend::syntax::FunctionHeader {
            kind: backend::syntax::DefinedFunction,
            pointer_bits: backend::syntax::POINTER_BITS,
            id: id,
            result_type:
                lowering::signatures::record_result_type(signature),
            parameters: parameters,
            body_words: 0,
        };
    backend::syntax::write_function_header(output, first, header);
    let written: i32 = first + backend::syntax::FUNCTION_HEADER_WORDS;
    let parameter: i32 = 0;
    while (parameter < parameters) {
        let member: lowering::signatures::SignatureMember =
            lowering::signature_index::member_at(signatures, id,
                parameter);
        written = append(output, capacity, written, member.name);
        written = append(output, capacity, written,
            ir::type_ref::code(member.type_tag));
        if (written <= -1) { return invalid(); }
        parameter += 1;
    }
    let body_start: i32 = written;
    written = lowering::body_serialization::serialize(
        ir::body_events::region(body.events, body.count), body.count,
        lowering::body_serialization::word_region(output, capacity),
        body_start);
    if (written <= body_start) { return invalid(); }
    backend::syntax::set_function_body_words_at(output, first,
        written - body_start);
    output[position] = written - first;
    return written;
}

fn valid_unit_descriptor(
    descriptors: [lowering::unit_descriptor::UnitDescriptor],
    descriptor_count: i32, unit: i32,
    source_length: i32, token_length: i32) -> bool {
    if (unit <= -1 || unit >= descriptor_count) { return false; }
    let source_offset: i32 = descriptors[unit].source_offset;
    let local_source_length: i32 = descriptors[unit].source_length;
    let token_offset: i32 = descriptors[unit].token_offset;
    let token_count: i32 = descriptors[unit].token_count;
    if (token_count <= -1
        || local_source_length <= -1) { return false; }
    if (!valid_range(source_offset, local_source_length, source_length)
        || !valid_range(token_offset, token_count, token_length)) {
        return false;
    }
    return true;
}

fn service_at(context: SourceTokens, name: i32)
    -> runtime::service::RuntimeService {
    if (matches_spelling(context, name, "alloc", 5)) {
        return runtime::service::Allocate;
    }
    if (matches_spelling(context, name, "open_read", 9)) {
        return runtime::service::OpenRead;
    }
    if (matches_spelling(context, name, "close", 5)) {
        return runtime::service::Close;
    }
    if (matches_spelling(context, name, "read", 4)) {
        return runtime::service::Read;
    }
    if (matches_spelling(context, name, "write_stdout", 12)) {
        return runtime::service::WriteStdout;
    }
    if (matches_spelling(context, name, "write_byte", 10)) {
        return runtime::service::WriteByte;
    }
    if (matches_spelling(context, name, "argc", 4)) {
        return runtime::service::ArgumentCount;
    }
    if (matches_spelling(context, name, "arg_len", 7)) {
        return runtime::service::ArgumentLength;
    }
    if (matches_spelling(context, name, "arg_read", 8)) {
        return runtime::service::ArgumentRead;
    }
    return runtime::service::NoService;
}

// Assemble one backend program from globally allocated declarations, the
// typed signature index, and independently lowered body tables per unit.
// Emission scans global allocation rows for each backend category.
// Return the number of Core words actually emitted (zero in NativeOnly mode);
// output is partial on error.
pub struct WordRegion {
    data: [i32],
    words: i32,
}

pub fn region(data: [i32], words: i32) -> WordRegion {
    return WordRegion { data: data, words: words };
}

pub struct TransportInput {
    unit_count: i32,
    sources: WordRegion,
    tokens: verified::token::TokenTable,
    descriptors: lowering::unit_descriptor::Table,
    declarations: lowering::declarations::Table,
    allocations: lowering::allocation::Table,
    signature_index: lowering::signature_index::Table,
    bodies: ir::body_catalog::Catalog,
    functions: ir::function_catalog::Table,
}

pub enum OutputMode {
    NativeOnly,
    NativeAndCore,
}

pub fn lower(input: TransportInput, destination: WordRegion,
    mode: OutputMode) -> i32 {
    let emit_core: bool = mode == NativeAndCore;
    let source_catalog: [i32] = input.sources.data;
    let source_catalog_length: i32 = input.sources.words;
    let token_catalog: verified::token::TokenTable = input.tokens;
    let token_catalog_length: i32 = input.tokens.count;
    let descriptor_table: lowering::unit_descriptor::Table =
        input.descriptors;
    let descriptors: [lowering::unit_descriptor::UnitDescriptor] =
        descriptor_table.data;
    let descriptor_count: i32 = descriptor_table.count;
    let unit_count: i32 = input.unit_count;
    let declaration_table: lowering::declarations::Table =
        input.declarations;
    let allocated: lowering::allocation::Table = input.allocations;
    let signature_index: lowering::signature_index::Table =
        input.signature_index;
    let native_functions: [ir::function_catalog::Function] =
        input.functions.functions;
    let native_parameters: [ir::function_catalog::Parameter] =
        input.functions.parameters;
    let bodies: ir::body_catalog::Catalog = input.bodies;
    let body_count: i32 = ir::body_catalog::length(bodies);
    let output: [i32] = destination.data;
    let capacity: i32 = destination.words;
    if (source_catalog_length <= -1 || token_catalog_length <= -1
        || unit_count <= 0 || descriptor_count != unit_count
        || !lowering::declarations::table_has_exact_rows(
            declaration_table)
        || !lowering::allocation::table_has_exact_rows(allocated)
        || body_count <= -1 || body_count > bodies.capacity
        || (emit_core && capacity <= HEADER - 1)) { return invalid(); }
    let rows: i32 = lowering::declarations::count_rows(
        lowering::declarations::table_header(declaration_table));
    let allocation_header: lowering::allocation::AllocationHeader =
        lowering::allocation::table_header(allocated);
    if (rows <= 0
        || rows > (verified::host::I32_MAX - lowering::allocation::HEADER)
            / lowering::allocation::ROW
        || allocation_header.units != unit_count
        || allocation_header.rows != rows
        || signature_index.count != allocation_header.declarations
        || allocation_header.aliases != 0
        || allocation_header.structures <= -1
        || allocation_header.enumerations <= -1
        || allocation_header.constants <= -1
        || allocation_header.functions <= 0
        || allocation_header.externals <= -1
        || allocation_header.structures > rows
        || allocation_header.enumerations > rows
        || allocation_header.constants > rows
        || allocation_header.functions > rows
        || allocation_header.externals > rows) {
        return invalid();
    }
    if (allocation_header.functions > verified::host::I32_MAX
            - allocation_header.externals
        || input.functions.count != allocation_header.functions
            + allocation_header.externals
        || input.functions.parameter_count <= -1
        || body_count != allocation_header.functions) {
        return invalid();
    }
    let nominal_types: i32 = allocation_header.structures
        + allocation_header.enumerations;

    // The declaration and allocation rows are the shared source of truth.
    // Check their copied source-origin fields and require descriptor order to
    // agree with the allocator's unit order before touching any output.
    let row: i32 = 0;
    let previous_unit: i32 = -1;
    while (row != rows) {
        let allocation: lowering::allocation::AllocationRow =
            lowering::allocation::table_row(allocated, row);
        if (!lowering::declarations::same_row(
                lowering::declarations::table_row(declaration_table, row),
                lowering::allocation::row_source(allocation))) {
            return invalid();
        }
        let unit: i32 = lowering::allocation::row_unit(allocation);
        let kind: i32 = lowering::declarations::kind_code(
            lowering::allocation::row_kind(allocation));
        if (unit <= -1 || unit >= unit_count || unit <= previous_unit - 1
            || (unit != previous_unit && unit != previous_unit + 1)
            || kind <= 0 || kind > lowering::declarations::kind_code(lowering::declarations::Import)) { return invalid(); }
        previous_unit = unit;
        row += 1;
    }

    let signature_validation: lowering::signature_validation::Input =
        lowering::signature_validation::Input {
            index: signature_index,
            allocations: allocated,
            descriptors: descriptor_table,
            nominal_types: nominal_types,
        };
    if (!lowering::signature_validation::valid(signature_validation)) {
        return invalid();
    }

    let unit: i32 = 0;
    while (unit != unit_count) {
        if (!valid_unit_descriptor(descriptors, descriptor_count, unit,
            source_catalog_length, token_catalog_length)) {
            return invalid();
        }
        unit += 1;
    }
    row = 0;
    while (row < rows) {
        let allocation: lowering::allocation::AllocationRow =
            lowering::allocation::table_row(allocated, row);
        if (lowering::allocation::row_has_kind(allocation,
                lowering::declarations::Function)) {
            let id: i32 = lowering::allocation::row_core_id(allocation);
            let body_index: i32 = ir::body_catalog::find(bodies, id);
            if (body_index <= -1) { return invalid(); }
            let body: ir::body_catalog::FunctionBody =
                ir::body_catalog::at(bodies, body_index);
            let signature: lowering::signatures::SignatureRecord =
                lowering::signature_index::record_at(signature_index, id);
            if (body.count <= 0
                || ir::type_ref::code(body.signature.result_type)
                    != ir::type_ref::code(
                        lowering::signatures::record_result_type(signature))
                || body.signature.parameters
                    != lowering::signatures::record_arity(signature)) {
                return invalid();
            }
        }
        row += 1;
    }

    // Find the unique zero-argument `main` using the source/token slice named
    // by its allocation row.  The backend entry is a canonical function ID,
    // not a unit-local ordinal.
    let entry: i32 = -1;
    row = 0;
    while (row != rows) {
        let allocation: lowering::allocation::AllocationRow =
            lowering::allocation::table_row(allocated, row);
        if (lowering::allocation::row_has_kind(allocation,
                lowering::declarations::Function)) {
            let unit: i32 = lowering::allocation::row_unit(allocation);
            let token_count: i32 = descriptors[unit].token_count;
            let name: i32 = lowering::allocation::row_name(allocation);
            if (!lowering::signature_index::has_shape(signature_index,
                    lowering::allocation::row_core_id(allocation),
                    lowering::signatures::InternalFunctionShape)) {
                return invalid();
            }
            let signature_record: lowering::signatures::SignatureRecord =
                lowering::signature_index::record_at(signature_index,
                    lowering::allocation::row_core_id(allocation));
            let unit_names: SourceTokens = SourceTokens {
                source: source_catalog,
                source_length: descriptors[unit].source_length,
                source_offset: descriptors[unit].source_offset,
                tokens: token_catalog,
                token_count: token_count,
                token_offset: descriptors[unit].token_offset,
            };
            if (lowering::signatures::record_arity(signature_record) == 0
                && matches_spelling(unit_names, name, "main", 4)) {
                if (entry >= 0) { return invalid(); }
                entry = lowering::allocation::row_core_id(allocation);
            }
        }
        row += 1;
    }
    if (entry <= -1) { return invalid(); }

    let written: i32 = 0;
    if (emit_core) {
    written = HEADER;
    let program_header: backend::syntax::ProgramHeader =
        backend::syntax::ProgramHeader {
            version: VERSION,
            pointer_bits: POINTER_BITS,
            entry: entry,
            types: nominal_types,
            constants: allocation_header.constants,
            functions: allocation_header.functions
                + allocation_header.externals,
        };
    backend::syntax::write_program_header(output, program_header);
    // Nominal types, constants, internal bodies, and external services are the
    // four sections expected by backend::program. The allocator assigns all
    // structure IDs first, then enumeration IDs, independent of source order.
    // Emit each category in allocation-row order to match those IDs.
    let type_id: i32 = 0;
    let type_pass: TypeEmissionPass = StructuresPass;
    while (type_pass != TypesFinished) {
        let kind: lowering::declarations::DeclarationKind =
            lowering::declarations::Structure;
        let shape: lowering::signatures::SignatureShape =
            lowering::signatures::StructureShape;
        if (type_pass == EnumerationsPass) {
            kind = lowering::declarations::Enumeration;
            shape = lowering::signatures::EnumerationShape;
        }
        row = 0;
        while (row != rows) {
            let allocation: lowering::allocation::AllocationRow =
                lowering::allocation::table_row(allocated, row);
            if (lowering::allocation::row_has_kind(allocation, kind)) {
                if (lowering::allocation::row_core_id(allocation) != type_id) {
                    return invalid();
                }
                if (!lowering::signature_index::has_shape(signature_index,
                        lowering::allocation::row_declaration_id(allocation),
                        shape)) { return invalid(); }
                written = append_type_layout(signature_index,
                    lowering::allocation::row_declaration_id(allocation),
                    output, capacity, written);
                if (written <= -1) { return written; }
                type_id += 1;
            }
            row += 1;
        }
        if (type_pass == StructuresPass) {
            type_pass = EnumerationsPass;
        } else {
            type_pass = TypesFinished;
        }
    }
    if (type_id != nominal_types) { return invalid(); }
    row = 0;
    while (row != rows) {
        let allocation: lowering::allocation::AllocationRow =
            lowering::allocation::table_row(allocated, row);
        if (lowering::allocation::row_has_kind(allocation,
                lowering::declarations::Constant)) {
            if (!lowering::signature_index::has_shape(signature_index,
                    lowering::allocation::row_declaration_id(allocation),
                    lowering::signatures::ConstantShape)) {
                return invalid();
            }
            let signature_record: lowering::signatures::SignatureRecord =
                lowering::signature_index::record_at(signature_index,
                    lowering::allocation::row_declaration_id(allocation));
            let constant: lowering::signature_index::ConstantValue =
                lowering::signature_index::constant_at(signature_index,
                    lowering::allocation::row_declaration_id(allocation));
            let result_type: i32 = ir::type_ref::code(
                lowering::signatures::record_result_type(signature_record));
            written = append(output, capacity, written,
                lowering::signatures::record_id(signature_record));
            if (written <= -1) { return invalid(); }
            written = append(output, capacity, written, result_type);
            if (written <= -1) { return invalid(); }
            if (result_type == backend::syntax::type_code(backend::syntax::TypeString)) {
                if (constant.encoding
                        != lowering::signature_index::StringConstant
                    || constant.byte_count <= -1) { return invalid(); }
                written = append(output, capacity, written,
                    constant.byte_count);
                if (written <= -1) { return invalid(); }
                let count: i32 = constant.byte_count;
                let byte: i32 = 0;
                while (byte <= count - 1) {
                    let value: i32 = lowering::signature_index::constant_byte(
                        signature_index,
                        lowering::allocation::row_declaration_id(allocation),
                        byte);
                    if (value <= -1) { return invalid(); }
                    written = append(output, capacity, written, value);
                    if (written <= -1) { return invalid(); }
                    byte += 1;
                }
            } else {
                if (constant.encoding
                        != lowering::signature_index::ScalarConstant) {
                    return invalid();
                }
                written = append(output, capacity, written, constant.low);
                if (written <= -1) { return invalid(); }
                written = append(output, capacity, written, constant.high);
                if (written <= -1) { return invalid(); }
            }
        }
        row += 1;
    }
    }
    // The backend program and image use the entrypoint as their first
    // function.  Keep the remaining functions in canonical allocation-row
    // order; this is deterministic and lets the authenticated direct-call
    // checker identify the caller before its callee.
    let function_cursor: i32 = 0;
    let parameter_cursor: i32 = 0;
    let pass: FunctionEmissionPass = EntryPass;
    while (pass != FunctionsFinished) {
        row = 0;
        while (row != rows) {
            let allocation: lowering::allocation::AllocationRow =
                lowering::allocation::table_row(allocated, row);
            let core_id: i32 = lowering::allocation::row_core_id(allocation);
            if (lowering::allocation::row_has_kind(allocation,
                    lowering::declarations::Function)
                && ((pass == EntryPass && core_id == entry)
                    || (pass == RemainingPass && core_id != entry))) {
                if (function_cursor >= input.functions.count) {
                    return invalid();
                }
                let signature: lowering::signatures::SignatureRecord =
                    lowering::signature_index::record_at(signature_index,
                        core_id);
                let parameters: i32 =
                    lowering::signatures::record_arity(signature);
                if (parameters <= -1
                    || parameters > input.functions.parameter_count
                        - parameter_cursor) { return invalid(); }
                let body_words: i32 = 0;
                if (emit_core) {
                    let function_first: i32 = written
                        + backend::syntax::FUNCTION_RECORD_PREFIX_WORDS;
                    written = append_defined_function(signature_index, bodies,
                        core_id, output, capacity, written);
                    if (written <= -1) { return invalid(); }
                    body_words = written - function_first
                        - backend::syntax::FUNCTION_HEADER_WORDS
                        - parameters
                            * backend::syntax::PARAMETER_ROW_WORDS;
                    if (body_words <= 0) { return invalid(); }
                }
                native_functions[function_cursor] =
                    ir::function_catalog::Function {
                        kind: ir::function_catalog::DefinedFunction,
                        id: core_id,
                        result_type: lowering::signatures::record_result_type(
                            signature),
                        parameters: parameters,
                        parameter_start: parameter_cursor,
                        service: runtime::service::NoService,
                    };
                let parameter: i32 = 0;
                while (parameter < parameters) {
                    let member: lowering::signatures::SignatureMember =
                        lowering::signature_index::member_at(signature_index,
                            core_id, parameter);
                    native_parameters[parameter_cursor] =
                        ir::function_catalog::Parameter {
                            id: member.name,
                            type_tag: member.type_tag,
                        };
                    parameter_cursor += 1;
                    parameter += 1;
                }
                function_cursor += 1;
            }
            row += 1;
        }
        if (pass == EntryPass) {
            pass = RemainingPass;
        } else {
            pass = FunctionsFinished;
        }
    }
    row = 0;
    while (row != rows) {
        let allocation: lowering::allocation::AllocationRow =
            lowering::allocation::table_row(allocated, row);
        if (lowering::allocation::row_has_kind(allocation,
                lowering::declarations::External)) {
            let unit: i32 = lowering::allocation::row_unit(allocation);
            if (!lowering::signature_index::has_shape(signature_index,
                    lowering::allocation::row_core_id(allocation),
                    lowering::signatures::ExternalFunctionShape)) {
                return invalid();
            }
            let signature_record: lowering::signatures::SignatureRecord =
                lowering::signature_index::record_at(signature_index,
                    lowering::allocation::row_core_id(allocation));
            let name: i32 = lowering::allocation::row_name(allocation);
            let service_names: SourceTokens = SourceTokens {
                source: source_catalog,
                source_length: descriptors[unit].source_length,
                source_offset: descriptors[unit].source_offset,
                tokens: token_catalog,
                token_count: descriptors[unit].token_count,
                token_offset: descriptors[unit].token_offset,
            };
            let service: runtime::service::RuntimeService =
                service_at(service_names, name);
            if (service == runtime::service::NoService) {
                return unsupported();
            }
            let parameters: i32 = lowering::signatures::record_arity(
                signature_record);
            if (function_cursor >= input.functions.count
                || parameters > input.functions.parameter_count
                    - parameter_cursor) { return invalid(); }
            let count: i32 = FUNCTION_RECORD_HEADER_WORDS
                + parameters * backend::syntax::PARAMETER_ROW_WORDS;
            if (emit_core) {
                if (parameters <= -1 || parameters > (capacity - written
                        - backend::syntax::FUNCTION_RECORD_PREFIX_WORDS
                        - FUNCTION_RECORD_HEADER_WORDS)
                        / backend::syntax::PARAMETER_ROW_WORDS) {
                    return invalid();
                }
                let function_header: backend::syntax::FunctionHeader =
                    backend::syntax::FunctionHeader {
                        kind: backend::syntax::RuntimeFunction,
                        pointer_bits: backend::syntax::POINTER_BITS,
                        id: lowering::signatures::record_id(signature_record),
                        result_type:
                            lowering::signatures::record_result_type(
                                signature_record),
                        parameters: parameters,
                        body_words:
                            runtime::service::RUNTIME_SERVICE_BODY_WORDS,
                    };
                written = append(output, capacity, written, count);
                if (written <= -1) { return invalid(); }
                backend::syntax::write_function_header(output, written,
                    function_header);
                written += backend::syntax::FUNCTION_HEADER_WORDS;
            }
            let parameter: i32 = 0;
            while (parameter != parameters) {
                let signature_member: lowering::signatures::SignatureMember =
                    lowering::signature_index::member_at(signature_index,
                        lowering::allocation::row_core_id(allocation),
                        parameter);
                if (signature_member.name <= -1
                    || !ir::type_ref::valid(signature_member.type_tag)) {
                    return invalid();
                }
                if (emit_core) {
                    written = append(output, capacity, written,
                        signature_member.name);
                    written = append(output, capacity, written,
                        ir::type_ref::code(signature_member.type_tag));
                    if (written <= -1) { return invalid(); }
                }
                native_parameters[parameter_cursor] =
                    ir::function_catalog::Parameter {
                        id: signature_member.name,
                        type_tag: signature_member.type_tag,
                    };
                parameter_cursor += 1;
                parameter += 1;
            }
            if (emit_core) {
                written = append(output, capacity, written,
                    runtime::service::service_code(service));
                if (written <= -1 || !runtime::service::valid(output,
                        written - count, count)) { return invalid(); }
            }
            native_functions[function_cursor] =
                ir::function_catalog::Function {
                    kind: ir::function_catalog::RuntimeFunction,
                    id: lowering::signatures::record_id(signature_record),
                    result_type: lowering::signatures::record_result_type(
                        signature_record),
                    parameters: parameters,
                    parameter_start: parameter_cursor - parameters,
                    service: service,
                };
            function_cursor += 1;
        }
        row += 1;
    }
    if (function_cursor != input.functions.count
        || parameter_cursor != input.functions.parameter_count) {
        return invalid();
    }
    if (emit_core) { backend::syntax::set_program_entry(output, entry); }
    return written;
}
