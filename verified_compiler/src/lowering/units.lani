module lowering::units;

import lowering::allocation;
import lowering::declarations;
import verified::host;

pub enum UnitsStage {
    Success,
    BadInput,
    Declarations,
    Allocation,
}

pub fn stage_code(stage: UnitsStage) -> i32 {
    return match (stage) {
        Success -> 0,
        BadInput -> 1,
        Declarations -> 2,
        Allocation -> 3,
    };
}

pub fn stage_succeeded(stage: UnitsStage) -> bool {
    return stage == Success;
}

pub struct UnitsResult {
    stage: UnitsStage,
    detail: i32,
    units: i32,
    declaration_words: i32,
    allocation_words: i32,
}

pub fn units_stage(value: UnitsResult) -> UnitsStage { return value.stage; }
pub fn units_detail(value: UnitsResult) -> i32 { return value.detail; }
pub fn units_count(value: UnitsResult) -> i32 { return value.units; }
pub fn units_declaration_words(value: UnitsResult) -> i32 {
    return value.declaration_words;
}
pub fn units_allocation_words(value: UnitsResult) -> i32 {
    return value.allocation_words;
}

fn result(stage: UnitsStage, detail: i32, units: i32,
    declaration_words: i32, allocation_words: i32) -> UnitsResult {
    return UnitsResult {
        stage: stage,
        detail: detail,
        units: units,
        declaration_words: declaration_words,
        allocation_words: allocation_words,
    };
}

// The unit boundary validates each collector table before global ID
// allocation. The allocator checks the stronger kind and ordinal invariants.
pub fn accumulate(catalog: lowering::declarations::Catalog,
    output: lowering::allocation::Table) -> UnitsResult {
    let unit_count: i32 = catalog.count;
    if (unit_count <= 0 || lowering::allocation::table_capacity(output) <= 0) {
        return result(BadInput, 0, 0, 0, 0);
    }
    let declaration_words: i32 = 0;
    let unit: i32 = 0;
    while (unit != unit_count) {
        let table: lowering::declarations::Table =
            lowering::declarations::catalog_table(catalog, unit);
        if (!lowering::declarations::table_has_exact_rows(table)) {
            return result(Declarations, -1, unit, declaration_words, 0);
        }
        let rows: i32 = lowering::declarations::count_rows(
            lowering::declarations::table_header(table));
        if (rows <= 0 || rows > (verified::host::I32_MAX
                - lowering::declarations::HEADER)
                / lowering::declarations::ROW) {
            return result(Declarations, -1, unit, declaration_words, 0);
        }
        let local_words: i32 = lowering::declarations::HEADER
            + rows * lowering::declarations::ROW;
        if (local_words > verified::host::I32_MAX - declaration_words) {
            return result(Declarations, -1, unit, declaration_words, 0);
        }
        let row: i32 = 0;
        while (row != rows) {
            if (lowering::declarations::row_unit(
                    lowering::declarations::table_row(table, row)) != unit) {
                return result(Declarations, -1, unit, declaration_words, 0);
            }
            row += 1;
        }
        declaration_words += local_words;
        unit += 1;
    }
    let allocation_words: i32 = lowering::allocation::allocate(catalog,
        output);
    if (allocation_words <= -1) {
        return result(Allocation, allocation_words, unit_count,
            declaration_words, 0);
    }
    return result(Success, 0, unit_count, declaration_words,
        allocation_words);
}
