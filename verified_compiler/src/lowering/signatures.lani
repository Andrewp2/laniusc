module lowering::signatures;

import lowering::declarations;

pub enum SignatureShape {
    InvalidShape,
    StructureShape,
    EnumerationShape,
    InternalFunctionShape,
    ExternalFunctionShape,
    ConstantShape,
}

pub struct SignatureMember {
    name: i32,
    type_tag: i32,
}

pub struct SignatureRecord {
    id: i32,
    declaration_kind: lowering::declarations::DeclarationKind,
    shape: SignatureShape,
    arity: i32,
    result_type: i32,
}

pub fn record_id(record: SignatureRecord) -> i32 { return record.id; }

pub fn record_declaration_kind(record: SignatureRecord)
    -> lowering::declarations::DeclarationKind {
    return record.declaration_kind;
}

pub fn record_shape(record: SignatureRecord) -> SignatureShape {
    return record.shape;
}

pub fn record_has_declaration_kind(record: SignatureRecord,
    expected: lowering::declarations::DeclarationKind) -> bool {
    return lowering::declarations::same_kind(record.declaration_kind,
        expected);
}

pub fn record_has_shape(record: SignatureRecord,
    expected: SignatureShape) -> bool {
    return record.shape == expected;
}

pub fn record_arity(record: SignatureRecord) -> i32 { return record.arity; }

pub fn record_result_type(record: SignatureRecord) -> i32 {
    return record.result_type;
}
