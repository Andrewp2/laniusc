module lowering::token_names;

import lowering::unit_context;
import verified::token;

// Compare identifier spellings across source units without copying or
// truncating their source bytes. The contexts own each unit's source/token
// ranges; this view owns no storage.
pub struct Catalog {
    contexts: lowering::unit_context::Table,
    sources: [i32],
    tokens: verified::token::TokenTable,
}

pub fn catalog(contexts: lowering::unit_context::Table,
    sources: [i32], tokens: verified::token::TokenTable) -> Catalog {
    return Catalog {
        contexts: contexts,
        sources: sources,
        tokens: tokens,
    };
}

pub fn same(catalog: Catalog, unit: i32, token: i32,
    other_unit: i32, other_token: i32) -> bool {
    let source: [i32] = catalog.sources;
    let tokens: [verified::token::TokenRow] = catalog.tokens.data;
    let context_table: lowering::unit_context::Table = catalog.contexts;
    let contexts: [lowering::unit_context::UnitContext] =
        context_table.data;
    if (unit <= -1 || unit >= context_table.count
        || other_unit <= -1 || other_unit >= context_table.count) {
        return false;
    }
    let context: i32 = unit;
    let other_context: i32 = other_unit;
    let source_offset: i32 = contexts[context].source_offset;
    let source_length: i32 = contexts[context].source_length;
    let token_offset: i32 = contexts[context].token_offset;
    let token_count: i32 = contexts[context].token_count;
    let other_source_offset: i32 = contexts[other_context].source_offset;
    let other_source_length: i32 = contexts[other_context].source_length;
    let other_token_offset: i32 = contexts[other_context].token_offset;
    let other_count: i32 = contexts[other_context].token_count;
    let token_capacity: i32 = catalog.tokens.count;
    if (token_offset <= -1 || other_token_offset <= -1
        || token_count <= -1 || other_count <= -1
        || token_offset > token_capacity
        || other_token_offset > token_capacity
        || token_count > token_capacity - token_offset
        || other_count > token_capacity - other_token_offset
        || token <= -1 || token >= token_count
        || other_token <= -1 || other_token >= other_count) {
        return false;
    }
    let left: i32 = token_offset + token;
    let right: i32 = other_token_offset + other_token;
    let first_source: verified::token::SourceSpan =
        verified::token::source_span(source, source_offset, source_length);
    let second_source: verified::token::SourceSpan =
        verified::token::source_span(source, other_source_offset,
            other_source_length);
    return verified::token::same_spelling(
        verified::token::identifier_spelling(first_source, tokens[left]),
        verified::token::identifier_spelling(second_source, tokens[right]));
}

// A coarse bucket key only: users of this key must still compare the entire
// spelling. Equal valid identifiers always have equal keys.
pub fn spelling_bucket(catalog: Catalog, unit: i32, token: i32,
    bucket_count: i32) -> i32 {
    let context_table: lowering::unit_context::Table = catalog.contexts;
    let contexts: [lowering::unit_context::UnitContext] =
        context_table.data;
    if (unit <= -1 || unit >= context_table.count || bucket_count <= 0) {
        return -1;
    }
    let context: lowering::unit_context::UnitContext = contexts[unit];
    if (context.token_offset <= -1 || context.token_count <= -1
        || context.token_offset > catalog.tokens.count
        || context.token_count > catalog.tokens.count
            - context.token_offset
        || token <= -1 || token >= context.token_count) {
        return -1;
    }
    let rows: [verified::token::TokenRow] = catalog.tokens.data;
    let spelling: verified::token::IdentifierSpelling =
        verified::token::identifier_spelling(
            verified::token::source_span(catalog.sources,
                context.source_offset, context.source_length),
            rows[context.token_offset + token]);
    if (!spelling.valid) { return -1; }
    let first: i32 = spelling.source[spelling.start];
    let last: i32 = spelling.source[spelling.start + spelling.length - 1];
    let key: i32 = (spelling.length * 131 + first * 31 + last)
        % bucket_count;
    if (key <= -1) { return key + bucket_count; }
    return key;
}
