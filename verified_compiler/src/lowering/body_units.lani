module lowering::body_units;
import backend::syntax;
import lowering::allocation;
import lowering::bodies;
import lowering::body_context;
import lowering::value_catalog;
import lowering::declarations;
import lowering::aliases;
import lowering::error;
import lowering::signature_index;
import lowering::signature_producer;
import lowering::signatures;
import lowering::types;
import lowering::unit_descriptor;
import lowering::unit_context;
import verified::host;
import verified::surface_expr;
import verified::surface_type;
import verified::syntax_tree;
import verified::token;

pub struct WordRegion {
    data: [i32],
    words: i32,
}

pub fn region(data: [i32], words: i32) -> WordRegion {
    return WordRegion { data: data, words: words };
}

fn invalid() -> i32 {
    return lowering::error::failure(lowering::error::InvalidInput);
}
fn valid_range(offset: i32, words: i32, length: i32) -> bool {
    if (offset <= -1 || words <= -1 || length <= -1 || offset>length || words>length - offset) {
        return false;
    }
    return true;
}
fn rows_range(offset: i32, rows: i32, stride: i32, length: i32) -> bool {
    if (rows <= -1 || stride <= 0
        || rows > verified::host::I32_MAX / stride) {
        return false;
    }
    return valid_range(offset, rows * stride, length);
}
fn overlap(first: i32, first_words: i32, second: i32, second_words: i32) -> bool {
    if (first_words <= 0 || second_words <= 0) {
        return false;
    }
    if (first <= second) {
        return second - first <= first_words - 1;
    }
    return first - second <= second_words - 1;
}
fn valid_declaration_table(table: lowering::declarations::Table,
    unit: i32) -> bool {
    if (!lowering::declarations::table_has_exact_rows(table)) {
        return false;
    }
    let rows: i32 = lowering::declarations::count_rows(
        lowering::declarations::table_header(table));
    if (rows <= 0 || rows > (verified::host::I32_MAX
            - lowering::declarations::HEADER)
            / lowering::declarations::ROW) {
        return false;
    }
    let row: i32 = 0;
    while (row <= rows - 1) {
        let declaration: lowering::declarations::DeclarationRow =
            lowering::declarations::table_row(table, row);
        if (lowering::declarations::row_unit(declaration) != unit) {
            return false;
        }
        row += 1;
    }
    return true;
}
// Value-name resolution is a separate tagged catalog from nominal types.
// Rows distinguish local/imported scope and callable/enum-variant bindings.
struct ValueCatalogValidation {
    catalog: lowering::value_catalog::ValueTable,
    offset: i32,
    count: i32,
    token_count: i32,
    allocations: lowering::allocation::Table,
    signature_index: lowering::signature_index::Table,
}

fn valid_value_catalog(validation: ValueCatalogValidation) -> bool {
    let input: lowering::value_catalog::ValueTable = validation.catalog;
    let offset: i32 = validation.offset;
    let count: i32 = validation.count;
    let allocation_table: lowering::allocation::Table =
        validation.allocations;
    let signature_index: lowering::signature_index::Table =
        validation.signature_index;
    if (!lowering::value_catalog::valid_slice(input, offset, count,
            validation.token_count, allocation_table)) {
        return false;
    }
    let position: i32 = offset;
    let finish: i32 = offset + count;
    while (position < finish) {
        let binding: lowering::value_catalog::ValueBinding =
            lowering::value_catalog::read_binding(input, position);
        let id: i32 = lowering::value_catalog::binding_id(binding);
        let member: i32 = lowering::value_catalog::binding_member(binding);
        let arity: i32 = lowering::value_catalog::binding_arity(binding);
        if (!lowering::signature_index::contains(signature_index, id)) {
            return false;
        }
        let record: lowering::signatures::SignatureRecord =
            lowering::signature_index::record_at(signature_index, id);
        let signature_found: bool = false;
        if (lowering::value_catalog::binding_is_kind(binding,
                lowering::value_catalog::CallableBinding)) {
            if (lowering::signatures::record_has_shape(record,
                    lowering::signatures::InternalFunctionShape)
                || lowering::signatures::record_has_shape(record,
                    lowering::signatures::ExternalFunctionShape)) {
                signature_found = true;
            }
        } else {
            if (lowering::signatures::record_has_shape(record,
                    lowering::signatures::EnumerationShape)
                && member < lowering::signatures::record_arity(record)) {
                let selected: lowering::signature_index::Variant =
                    lowering::signature_index::variant_at(signature_index,
                        id, member);
                if (selected.field_count == arity) {
                    signature_found = true;
                }
            }
        }
        if (!signature_found) { return false; }
        position += 1;
    }
    return position == finish;
}

struct OwnedContextValidation {
    context: lowering::unit_context::UnitContext,
    values: lowering::value_catalog::ValueTable,
    token_count: i32,
    allocations: lowering::allocation::Table,
    signature_index: lowering::signature_index::Table,
}

fn valid_owned_context(validation: OwnedContextValidation) -> bool {
    let context: lowering::unit_context::UnitContext = validation.context;
    let value_validation: ValueCatalogValidation = ValueCatalogValidation {
        catalog: validation.values,
        offset: context.value_row_offset,
        count: context.value_count,
        token_count: validation.token_count,
        allocations: validation.allocations,
        signature_index: validation.signature_index,
    };
    return valid_value_catalog(value_validation);
}
fn prior_body_id(body_catalog:[i32], written: i32, id: i32) -> bool {
    let table: i32 = 0;
    while (table <= written - 1) {
        let words: i32 = lowering::body_context::header_words_at(
            body_catalog, table);
        if (words <= lowering::body_context::HEADER - 1 || table + words>written) {
            return true;
        }
        let position: i32 = table + lowering::body_context::HEADER;
        let finish: i32 = table + words;
        while (position <= finish - 1) {
            let span: lowering::body_context::FunctionSpan =
                lowering::body_context::read_function_span(body_catalog,
                    position);
            if (!lowering::body_context::span_fits(span, finish,
                    lowering::body_context::RECORD_HEADER)) {
                return true;
            }
            if (backend::syntax::function_id_at(body_catalog,
                    span.function) == id) {
                return true;
            }
            position = lowering::body_context::span_end(span);
        }
        if (position != finish) {
            return true;
        }
        table += words;
    }
    return false;
}
fn valid_global_declarations(input: lowering::declarations::Table,
    unit_count: i32) -> bool {
    if (!lowering::declarations::table_has_exact_rows(input)) {
        return false;
    }
    let rows: i32 = lowering::declarations::count_rows(
        lowering::declarations::table_header(input));
    if (rows <= 0) { return false; }
    let row: i32 = 0;
    while (row <= rows - 1) {
        let declaration: lowering::declarations::DeclarationRow =
            lowering::declarations::table_row(input, row);
        if (lowering::declarations::row_unit(declaration) <= -1
            || lowering::declarations::row_unit(declaration) >= unit_count) {
            return false;
        }
        row += 1;
    }
    return true;
}

fn valid_global_allocation(input: lowering::allocation::Table,
    unit_count: i32) -> bool {
    if (!lowering::allocation::table_has_exact_rows(input)) {
        return false;
    }
    let header: lowering::allocation::AllocationHeader =
        lowering::allocation::table_header(input);
    if (header.units != unit_count || header.rows <= 0) { return false; }
    let row: i32 = 0;
    while (row <= header.rows - 1) {
        let allocation: lowering::allocation::AllocationRow =
            lowering::allocation::table_row(input, row);
        if (lowering::allocation::row_unit(allocation) <= -1
            || lowering::allocation::row_unit(allocation) >= unit_count) {
            return false;
        }
        row += 1;
    }
    return true;
}

// Body lowering resolves functions through the native signature index.
pub struct BodyUnitInputs {
    unit_count: i32,
    contexts: lowering::unit_context::Table,
    transport_descriptors: lowering::unit_descriptor::Table,
    unit_declarations: lowering::declarations::Catalog,
    global_declarations: lowering::declarations::Table,
    sources: WordRegion,
    tokens: verified::token::TokenTable,
    trees: verified::syntax_tree::Catalog,
    resolutions: lowering::types::ResolutionTable,
    values: lowering::value_catalog::ValueTable,
    signature_index: lowering::signature_index::Table,
    allocations: lowering::allocation::Table,
    aliases: lowering::aliases::Table,
}

pub struct BodyUnitWorkspace {
    type_arena: verified::surface_type::TypeArena,
    resolutions: lowering::types::ResolutionTable,
    values: lowering::value_catalog::ValueTable,
    expressions: verified::surface_expr::ExpressionArena,
    type_output: WordRegion,
    body: WordRegion,
    body_catalog: WordRegion,
    alias_work: WordRegion,
}

// Global body boundary. Declaration and allocation tables are passed intact;
// only the unit-owned allocation rows are emitted against decoded syntax
// trees. The aggregate signature stream has already been decoded
// into `signature_index`; value-name spans use local tokens and global IDs.
pub fn lower_units_owned(input: BodyUnitInputs,
    workspace: BodyUnitWorkspace) -> i32 {
    let unit_count: i32 = input.unit_count;
    let context_region: lowering::unit_context::Table = input.contexts;
    let transport_region: lowering::unit_descriptor::Table =
        input.transport_descriptors;
    let unit_declarations: lowering::declarations::Catalog =
        input.unit_declarations;
    let global_declarations: lowering::declarations::Table =
        input.global_declarations;
    let source_region: WordRegion = input.sources;
    let token_region: verified::token::TokenTable = input.tokens;
    let tree_catalog: verified::syntax_tree::Catalog = input.trees;
    let trees: [verified::syntax_tree::Tree] = tree_catalog.data;
    let resolution_region: lowering::types::ResolutionTable =
        input.resolutions;
    let value_region: lowering::value_catalog::ValueTable = input.values;
    let allocation_table: lowering::allocation::Table = input.allocations;
    let alias_region: lowering::aliases::Table = input.aliases;
    let descriptor_count: i32 = unit_declarations.count;
    let contexts: [lowering::unit_context::UnitContext] =
        context_region.data;
    let context_count: i32 = context_region.count;
    let transport_descriptors: [lowering::unit_descriptor::UnitDescriptor] =
        transport_region.data;
    let transport_descriptor_count: i32 = transport_region.count;
    let source_catalog: [i32] = source_region.data;
    let source_catalog_length: i32 = source_region.words;
    let token_catalog: verified::token::TokenTable = token_region;
    let token_catalog_length: i32 = token_region.count;
    let lexical_catalogs: lowering::unit_context::LexicalCatalogs =
        lowering::unit_context::LexicalCatalogs {
            sources: source_catalog,
            source_words: source_catalog_length,
            tokens: token_catalog,
        };
    let resolution_catalog_length: i32 = resolution_region.count;
    let value_catalog_count: i32 = value_region.count;
    let alias_catalog: [lowering::aliases::Catalog] = alias_region.data;
    let alias_catalog_count: i32 = alias_region.count;
    let type_arena_work: verified::surface_type::TypeArena =
        workspace.type_arena;
    let resolution_work: lowering::types::ResolutionTable =
        workspace.resolutions;
    let value_work: lowering::value_catalog::ValueTable = workspace.values;
    let signature_index: lowering::signature_index::Table =
        input.signature_index;
    let expression_work: verified::surface_expr::ExpressionArena =
        workspace.expressions;
    let type_output_work: WordRegion = workspace.type_output;
    let body_work: WordRegion = workspace.body;
    let body_catalog_region: WordRegion = workspace.body_catalog;
    let alias_resolution_work: WordRegion = workspace.alias_work;
    let type_arena_capacity: i32 = type_arena_work.capacity;
    let resolution_scratch: [lowering::types::ResolutionRow] =
        resolution_work.data;
    let resolution_capacity: i32 = resolution_work.count;
    let value_scratch: lowering::value_catalog::ValueTable = value_work;
    let value_scratch_capacity: i32 = value_work.count;
    let expression_capacity: i32 = expression_work.capacity;
    let type_output: [i32] = type_output_work.data;
    let type_output_capacity: i32 = type_output_work.words;
    let body_scratch: [i32] = body_work.data;
    let body_scratch_capacity: i32 = body_work.words;
    let body_catalog: [i32] = body_catalog_region.data;
    let body_capacity: i32 = body_catalog_region.words;
    let alias_work: [i32] = alias_resolution_work.data;
    let alias_work_capacity: i32 = alias_resolution_work.words;
    if (unit_count <= 0 || descriptor_count != unit_count
        || context_count != unit_count
        || transport_descriptor_count != unit_count
        || tree_catalog.count != unit_count
        || source_catalog_length <= -1
        || token_catalog_length <= -1
        || resolution_catalog_length <= -1 || value_catalog_count <= -1
        || (alias_catalog_count != 0 && alias_catalog_count != unit_count)
        || type_arena_capacity <= 0 || resolution_capacity <= -1
        || value_scratch_capacity <= -1
        || expression_capacity <= 0 || type_output_capacity <= 0
        || body_scratch_capacity <= lowering::body_context::HEADER
        || body_capacity <= lowering::body_context::HEADER
        || alias_work_capacity <= -1) {
        return invalid();
    }
    if (!valid_global_declarations(global_declarations, unit_count)) {
        return invalid();
    }
    if (!valid_global_allocation(allocation_table, unit_count)) {
        return invalid();
    }
    let allocation_header: lowering::allocation::AllocationHeader =
        lowering::allocation::table_header(allocation_table);
    let expected_index_count: i32 =
        allocation_header.declarations;
    if (expected_index_count <= 0
        || expected_index_count > allocation_header.rows
        || signature_index.count != expected_index_count) {
        return invalid();
    }
    let catalog_lengths: lowering::signature_producer::ContextCatalogLengths =
        lowering::signature_producer::context_catalog_lengths(source_catalog_length,
            token_catalog_length, resolution_catalog_length);
    let unit: i32 = 0;
    while (unit <= unit_count - 1) {
        let context: i32 = unit;
        let declaration_table: lowering::declarations::Table =
            lowering::declarations::catalog_table(unit_declarations, unit);
        let owned_validation: OwnedContextValidation =
            OwnedContextValidation {
                context: contexts[context],
                values: value_region,
                token_count: contexts[context].token_count,
                allocations: allocation_table,
                signature_index: signature_index,
            };
        if (!valid_declaration_table(declaration_table, unit)
            || !lowering::signature_producer::context_valid(contexts[context],
                catalog_lengths)
            || !valid_owned_context(owned_validation)) {
            return invalid();
        }
        let source_offset: i32 = contexts[context].source_offset;
        let source_words: i32 = contexts[context].source_length;
        let token_offset: i32 = contexts[context].token_offset;
        let token_count: i32 = contexts[context].token_count;
        if (transport_descriptors[unit].source_offset != source_offset
            || transport_descriptors[unit].source_length != source_words
            || transport_descriptors[unit].token_offset != token_offset
            || transport_descriptors[unit].token_count != token_count) {
            return invalid();
        }
        unit += 1;
    }
    let check: i32 = 0;
    while (check <= unit_count - 1) {
        let context: i32 = check;
        let source_offset: i32 = contexts[context].source_offset;
        let source_words: i32 = contexts[context].source_length;
        let token_offset: i32 = contexts[context].token_offset;
        let token_rows: i32 = contexts[context].token_count;
        let previous: i32 = 0;
        while (previous <= check - 1) {
            let previous_context: i32 = previous;
            if (overlap(source_offset, source_words,
                    contexts[previous_context].source_offset,
                    contexts[previous_context].source_length)) { return invalid(); }
            if (overlap(token_offset, token_rows,
                    contexts[previous_context].token_offset,
                    contexts[previous_context].token_count)) { return invalid(); }
            if (overlap(contexts[context].value_row_offset,
                    contexts[context].value_count,
                    contexts[previous_context].value_row_offset,
                    contexts[previous_context].value_count)) { return invalid(); }
            previous += 1;
        }
        check += 1;
    }
    let written: i32 = 0;
    unit = 0;
    while (unit <= unit_count - 1) {
        let context: i32 = unit;
        let lexical: lowering::unit_context::UnitLexical =
            lowering::unit_context::lexical(lexical_catalogs,
                contexts[context]);
        let unit_tree: verified::syntax_tree::Tree = trees[unit];
        if (!lexical.valid
            || unit_tree.node_count != contexts[context].node_count
            || !lowering::types::copy_rows(resolution_region,
                contexts[context].resolution_row_offset,
                contexts[context].resolution_count,
                resolution_work)
            || !lowering::value_catalog::copy_rows(value_region,
                contexts[context].value_row_offset,
                contexts[context].value_count, value_scratch)) {
            return invalid();
        }
        let unit_source: [i32] = lexical.source;
        let unit_tokens: verified::token::TokenTable = lexical.tokens;
        let aliases: lowering::aliases::Catalog = lowering::aliases::empty();
        if (alias_catalog_count == unit_count) { aliases = alias_catalog[unit]; }
        let value_count: i32 = contexts[context].value_count;
        if (alias_catalog_count == unit_count
            && !lowering::aliases::valid(aliases, unit_tokens)) {
            return invalid();
        }
        let body_inputs: lowering::body_context::BodyLoweringInputs =
            lowering::body_context::BodyLoweringInputs {
                owner_unit: unit,
                source: lowering::body_context::region(unit_source,
                    contexts[context].source_length),
                tokens: unit_tokens,
                tree: unit_tree,
                allocations: allocation_table,
                signature_index: signature_index,
                resolutions: lowering::types::resolutions(resolution_scratch,
                    contexts[context].resolution_count,
                    lowering::types::IdentifierToken),
                aliases: aliases,
                values: lowering::value_catalog::table(value_scratch.data,
                    value_count),
            };
        let body_workspace: lowering::body_context::BodyLoweringWorkspace =
            lowering::body_context::BodyLoweringWorkspace {
                expressions: expression_work,
                types: type_arena_work,
                alias_scratch: lowering::body_context::region(alias_work,
                    alias_work_capacity),
                type_output: lowering::body_context::region(type_output,
                    type_output_capacity),
                output: lowering::body_context::region(body_scratch,
                    body_scratch_capacity),
            };
        let local_body_words: i32 = lowering::bodies::lower_owned(
            body_inputs, body_workspace);
        if (local_body_words <= lowering::body_context::HEADER - 1
            || lowering::body_context::header_words_at(body_scratch, 0)
                != local_body_words
            || local_body_words > body_scratch_capacity) {
            return local_body_words;
        }
        let local_position: i32 = lowering::body_context::HEADER;
        while (local_position <= local_body_words - 1) {
            let span: lowering::body_context::FunctionSpan =
                lowering::body_context::read_function_span(body_scratch,
                    local_position);
            if (!lowering::body_context::span_fits(span, local_body_words,
                    lowering::body_context::RECORD_HEADER)
                || backend::syntax::function_id_at(body_scratch,
                    span.function) <= -1
                || prior_body_id(body_catalog, written,
                    backend::syntax::function_id_at(body_scratch,
                        span.function))) {
                return invalid();
            }
            local_position = lowering::body_context::span_end(span);
        }
        if (local_position != local_body_words) {
            return invalid();
        }
        if (!(local_body_words <= body_capacity - written)) {
            return invalid();
        }
        let word: i32 = 0;
        while (word <= local_body_words - 1) {
            body_catalog[written + word] = body_scratch[word];
            word += 1;
        }
        transport_descriptors[unit].body_offset = written;
        transport_descriptors[unit].body_words = local_body_words;
        written += local_body_words;
        unit += 1;
    }
    return written;
}
