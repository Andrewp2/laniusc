fn lower_units_context(descriptors:[i32], descriptor_length: i32, unit_count: i32, contexts:[i32], context_length: i32, transport_descriptors:[i32], transport_descriptor_length: i32, declaration_catalog:[i32], declaration_catalog_length: i32, source_catalog:[i32], source_catalog_length: i32, token_catalog:[i32], token_catalog_length: i32, record_catalog:[i32], record_catalog_length: i32, offsets_catalog:[i32], offsets_catalog_length: i32, type_arena_catalog:[i32], type_arena_catalog_length: i32, resolution_catalog:[i32], resolution_catalog_length: i32, signature_catalog:[i32], signature_catalog_length: i32, allocated:[i32], allocation_words: i32, declaration_words: i32, source_scratch:[i32], source_capacity: i32, token_scratch:[i32], token_capacity: i32, record_scratch:[i32], record_capacity: i32, offsets_scratch:[i32], offsets_capacity: i32, type_arena_scratch:[i32], type_arena_capacity: i32, resolution_scratch:[i32], resolution_capacity: i32, declaration_scratch:[i32], declaration_capacity: i32, allocation_scratch:[i32], allocation_capacity: i32, signature_scratch:[i32], signature_capacity: i32, expression_arena:[i32], expression_capacity: i32, type_output:[i32], type_output_capacity: i32, body_scratch:[i32], body_scratch_capacity: i32, body_catalog:[i32], body_capacity: i32, context_words: i32, alias_catalog:[i32], alias_catalog_length: i32, alias_scratch:[i32], alias_scratch_capacity: i32, alias_work:[i32], alias_work_capacity: i32) -> i32 {
    if (unit_count <= 0 || descriptor_length <= -1 || unit_count>descriptor_length / lowering::units::DESCRIPTOR_WORDS || descriptor_length != unit_count * lowering::units::DESCRIPTOR_WORDS || context_length <= -1 || context_words <= 0 || unit_count>context_length / context_words || context_length != unit_count * context_words || transport_descriptor_length <= -1 || unit_count>transport_descriptor_length / DESCRIPTOR_WORDS || transport_descriptor_length != unit_count * DESCRIPTOR_WORDS || declaration_catalog_length <= -1 || source_catalog_length <= -1 || token_catalog_length <= -1 || record_catalog_length <= -1 || offsets_catalog_length <= -1 || type_arena_catalog_length <= -1 || resolution_catalog_length <= -1 || alias_catalog_length <= -1 || signature_catalog_length <= -1 || allocation_words <= lowering::declarations::HEADER - 1 || declaration_words <= lowering::declarations::HEADER - 1 || source_capacity <= -1 || token_capacity <= -1 || record_capacity <= -1 || offsets_capacity <= -1 || type_arena_capacity <= 0 || resolution_capacity <= -1 || alias_scratch_capacity <= -1 || alias_work_capacity <= -1 || declaration_capacity <= lowering::declarations::HEADER - 1 || allocation_capacity <= lowering::declarations::HEADER - 1 || signature_capacity <= lowering::signatures::HEADER - 1 || expression_capacity <= 0 || type_output_capacity <= 0 || body_scratch_capacity <= lowering::bodies::HEADER || body_capacity <= lowering::bodies::HEADER) {
