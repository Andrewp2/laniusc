    return position == offset + words && count == records;
}

// The owned body pass does not consume transport signature partitions.  It
// only checks that each descriptor names a bounded, header-bearing partition;
// the transport pass remains responsible for validating its records.
fn valid_transport_signature_slice(input:[i32], offset: i32, words: i32,
    length: i32) -> bool {
    return valid_range(offset, words, length)
        && words >= lowering::signatures::HEADER
        && input[offset] == lowering::signatures::VERSION
        && input[offset + 2] == words;
}

// Value-name resolution is a separate tagged catalog from the nominal type
// pairs in each signature context.  Keys are token indices in the owning
// unit; values are already allocated global function IDs.
fn valid_value_catalog(input:[i32], offset: i32, words: i32, length: i32,
    token_count: i32, allocated:[i32], allocation_words: i32,
    signatures:[i32], signature_words: i32) -> bool {
    if (!valid_range(offset, words, length) || words < lowering::bodies::VALUE_HEADER
        || input[offset] != lowering::bodies::VALUE_MAGIC
        || input[offset + 1] <= -1 || input[offset + 2] != words
        || words != lowering::bodies::VALUE_HEADER
            + input[offset + 1] * lowering::bodies::VALUE_ROW
        || token_count <= -1) { return false; }
    let position: i32 = offset + lowering::bodies::VALUE_HEADER;
    let finish: i32 = offset + words;
    while (position < finish) {
        let token: i32 = input[position];
        let id: i32 = input[position + 1];
        if (token <= -1 || token >= token_count || id <= -1) { return false; }
        let previous: i32 = offset + lowering::bodies::VALUE_HEADER;
        while (previous < position) {
            if (input[previous] == token) {
                return false;
            }
            previous += lowering::bodies::VALUE_ROW;
        }
        let allocation: i32 = lowering::declarations::HEADER;
        let found: bool = false;
        while (allocation < allocation_words) {
            if (allocated[allocation + 9] == id
                && (allocated[allocation + 1] == lowering::declarations::FUNCTION
                    || allocated[allocation + 1] == lowering::declarations::EXTERNAL)) {
                found = true;
            }
            allocation += 10;
        }
        if (!found) { return false; }
        let signature: i32 = lowering::signatures::HEADER;
        let signature_found: bool = false;
        while (signature < signature_words) {
            if (signature > signature_words - lowering::signatures::RECORD) {
                return false;
            }
            if (signatures[signature] == id
                && (signatures[signature + 1] == lowering::declarations::FUNCTION
                    || signatures[signature + 1] == lowering::declarations::EXTERNAL)) {
                signature_found = true;
            }
            signature += lowering::signatures::RECORD + signatures[signature + 5];
        }
        if (!signature_found) { return false; }
        position += lowering::bodies::VALUE_ROW;
    }
    return position == finish;
}

fn valid_owned_context(contexts:[i32], position: i32,
    alias_length: i32, value_input:[i32], value_length: i32,
    token_count: i32, allocated:[i32], allocation_words: i32,
    signatures:[i32], signature_words: i32) -> bool {
    if (!valid_range(contexts[position + ALIAS_OFFSET],
            contexts[position + ALIAS_WORDS], alias_length)) {
        return false;
    }
    return valid_value_catalog(value_input,
        contexts[position + VALUE_OFFSET],
        contexts[position + VALUE_WORDS], value_length, token_count,
        allocated, allocation_words, signatures, signature_words);
}
fn prior_signature_id(signatures_catalog:[i32], descriptors:[i32], unit: i32, id: i32) -> bool {
    let previous: i32 = 0;
    while (previous <= unit - 1) {
        let descriptor: i32 = previous * DESCRIPTOR_WORDS;
        let begin: i32 = descriptors[descriptor + SIGNATURE_OFFSET] + lowering::signatures::HEADER;
        let finish: i32 = descriptors[descriptor + SIGNATURE_OFFSET] + descriptors[descriptor + SIGNATURE_WORDS];
        let position: i32 = begin;
        while (position <= finish - 1) {
            if (signatures_catalog[position] == id) {
                return true;
            }
            position += lowering::signatures::RECORD + signatures_catalog[position + 5];
        }
        previous += 1;
    }
    return false;
}
fn prior_signature_ids(signatures_catalog:[i32], descriptors:[i32], unit: i32, offset: i32, words: i32) -> bool {
    let position: i32 = offset + lowering::signatures::HEADER;
    let finish: i32 = offset + words;
    while (position <= finish - 1) {
        if (prior_signature_id(signatures_catalog, descriptors, unit, signatures_catalog[position])) {
            return true;
        }
        position += lowering::signatures::RECORD + signatures_catalog[position + 5];
    }
    return false;
}
fn prior_body_id(body_catalog:[i32], written: i32, id: i32) -> bool {
    let table: i32 = 0;
    while (table <= written - 1) {
        let words: i32 = body_catalog[table + lowering::bodies::HEADER - 1];
        if (words <= lowering::bodies::HEADER - 1 || table + words>written) {
            return true;
        }
        let position: i32 = table + lowering::bodies::HEADER;
        let finish: i32 = table + words;
        while (position <= finish - 1) {
            let record_words: i32 = body_catalog[position];
            if (record_words <= lowering::bodies::RECORD_HEADER - 1 || position + 1 + record_words>finish) {
                return true;
            }
            if (body_catalog[position + 3] == id) {
                return true;
            }
            position += 1 + record_words;
        }
        if (position != finish) {
            return true;
        }
        table += words;
    }
    return false;
}
// Lower body records for every unit in descriptor order. `transport_descriptors`
