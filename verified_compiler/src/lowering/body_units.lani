        }
        let local_allocation_words: i32 = lowering::declarations::HEADER + rows * 10;
        let local_body_words: i32 = lowering::bodies::lower(source_scratch, contexts[context + lowering::signatures::SOURCE_LENGTH], token_scratch, contexts[context + lowering::signatures::TOKEN_COUNT], record_scratch, contexts[context + lowering::signatures::RECORD_LENGTH], offsets_scratch, contexts[context + lowering::signatures::NODE_COUNT], declaration_scratch, local_declaration_words, allocation_scratch, local_allocation_words, signature_scratch, transport_descriptors[transport + SIGNATURE_WORDS], expression_arena, expression_capacity, type_arena_scratch, contexts[context + lowering::signatures::TYPE_ARENA_LENGTH], resolution_scratch, contexts[context + lowering::signatures::RESOLUTION_LENGTH], alias_scratch, alias_words, alias_work, alias_work_capacity, type_output, type_output_capacity, body_scratch, body_scratch_capacity);
        if (local_body_words <= lowering::bodies::HEADER - 1 || body_scratch[3] != local_body_words || local_body_words>body_scratch_capacity) {
            return -1;
        }
        let local_position: i32 = lowering::bodies::HEADER;
        while (local_position <= local_body_words - 1) {
            let record_words: i32 = body_scratch[local_position];
            if (record_words <= lowering::bodies::RECORD_HEADER - 1 || record_words>local_body_words - local_position - 1 || body_scratch[local_position + 3] <= -1 || prior_body_id(body_catalog, written, body_scratch[local_position + 3])) {
                return -1;
            }
            local_position += record_words + 1;
        }
        if (local_position != local_body_words || body_capacity - written<local_body_words) {
            return -1;
        }
        let word: i32 = 0;
        while (word <= local_body_words - 1) {
            body_catalog[written + word] = body_scratch[word];
            word += 1;
        }
        transport_descriptors[transport + BODY_OFFSET] = written;
        transport_descriptors[transport + BODY_WORDS] = local_body_words;
        written += local_body_words;
        allocation_row += rows;
        unit += 1;
    }
    return written;
}

// Preserve the established twelve-word context API for callers whose units
// have no alias catalog. The widened entrypoint below adds two per-unit words.
pub fn lower_units(descriptors:[i32], descriptor_length: i32, unit_count: i32, contexts:[i32], context_length: i32, transport_descriptors:[i32], transport_descriptor_length: i32, declaration_catalog:[i32], declaration_catalog_length: i32, source_catalog:[i32], source_catalog_length: i32, token_catalog:[i32], token_catalog_length: i32, record_catalog:[i32], record_catalog_length: i32, offsets_catalog:[i32], offsets_catalog_length: i32, type_arena_catalog:[i32], type_arena_catalog_length: i32, resolution_catalog:[i32], resolution_catalog_length: i32, signature_catalog:[i32], signature_catalog_length: i32, allocated:[i32], allocation_words: i32, declaration_words: i32, source_scratch:[i32], source_capacity: i32, token_scratch:[i32], token_capacity: i32, record_scratch:[i32], record_capacity: i32, offsets_scratch:[i32], offsets_capacity: i32, type_arena_scratch:[i32], type_arena_capacity: i32, resolution_scratch:[i32], resolution_capacity: i32, declaration_scratch:[i32], declaration_capacity: i32, allocation_scratch:[i32], allocation_capacity: i32, signature_scratch:[i32], signature_capacity: i32, expression_arena:[i32], expression_capacity: i32, type_output:[i32], type_output_capacity: i32, body_scratch:[i32], body_scratch_capacity: i32, body_catalog:[i32], body_capacity: i32) -> i32 {
    return lower_units_context(descriptors, descriptor_length, unit_count, contexts,
        context_length, transport_descriptors, transport_descriptor_length,
        declaration_catalog, declaration_catalog_length, source_catalog,
        source_catalog_length, token_catalog, token_catalog_length, record_catalog,
        record_catalog_length, offsets_catalog, offsets_catalog_length,
        type_arena_catalog, type_arena_catalog_length, resolution_catalog,
        resolution_catalog_length, signature_catalog, signature_catalog_length,
        allocated, allocation_words, declaration_words, source_scratch,
        source_capacity, token_scratch, token_capacity, record_scratch,
        record_capacity, offsets_scratch, offsets_capacity, type_arena_scratch,
        type_arena_capacity, resolution_scratch, resolution_capacity,
        declaration_scratch, declaration_capacity, allocation_scratch,
        allocation_capacity, signature_scratch, signature_capacity,
        expression_arena, expression_capacity, type_output, type_output_capacity,
        body_scratch, body_scratch_capacity, body_catalog, body_capacity,
        CONTEXT_WORDS, resolution_scratch, 0, resolution_scratch, 0,
        resolution_scratch, 0);
}

// Widened unit/context entrypoint. Context words 12 and 13 are the validated
// alias-catalog offset and length for each unit; all other slices retain the
// existing signatures.lower_units layout and disjointness checks.
pub fn lower_units_aliases(descriptors:[i32], descriptor_length: i32, unit_count: i32, contexts:[i32], context_length: i32, transport_descriptors:[i32], transport_descriptor_length: i32, declaration_catalog:[i32], declaration_catalog_length: i32, source_catalog:[i32], source_catalog_length: i32, token_catalog:[i32], token_catalog_length: i32, record_catalog:[i32], record_catalog_length: i32, offsets_catalog:[i32], offsets_catalog_length: i32, type_arena_catalog:[i32], type_arena_catalog_length: i32, resolution_catalog:[i32], resolution_catalog_length: i32, signature_catalog:[i32], signature_catalog_length: i32, allocated:[i32], allocation_words: i32, declaration_words: i32, source_scratch:[i32], source_capacity: i32, token_scratch:[i32], token_capacity: i32, record_scratch:[i32], record_capacity: i32, offsets_scratch:[i32], offsets_capacity: i32, type_arena_scratch:[i32], type_arena_capacity: i32, resolution_scratch:[i32], resolution_capacity: i32, declaration_scratch:[i32], declaration_capacity: i32, allocation_scratch:[i32], allocation_capacity: i32, signature_scratch:[i32], signature_capacity: i32, expression_arena:[i32], expression_capacity: i32, type_output:[i32], type_output_capacity: i32, body_scratch:[i32], body_scratch_capacity: i32, body_catalog:[i32], body_capacity: i32, alias_catalog:[i32], alias_catalog_length: i32, alias_scratch:[i32], alias_scratch_capacity: i32, alias_work:[i32], alias_work_capacity: i32) -> i32 {
    return lower_units_context(descriptors, descriptor_length, unit_count, contexts,
        context_length, transport_descriptors, transport_descriptor_length,
        declaration_catalog, declaration_catalog_length, source_catalog,
        source_catalog_length, token_catalog, token_catalog_length, record_catalog,
        record_catalog_length, offsets_catalog, offsets_catalog_length,
        type_arena_catalog, type_arena_catalog_length, resolution_catalog,
        resolution_catalog_length, signature_catalog, signature_catalog_length,
        allocated, allocation_words, declaration_words, source_scratch,
        source_capacity, token_scratch, token_capacity, record_scratch,
        record_capacity, offsets_scratch, offsets_capacity, type_arena_scratch,
        type_arena_capacity, resolution_scratch, resolution_capacity,
        declaration_scratch, declaration_capacity, allocation_scratch,
        allocation_capacity, signature_scratch, signature_capacity,
        expression_arena, expression_capacity, type_output, type_output_capacity,
        body_scratch, body_scratch_capacity, body_catalog, body_capacity,
        ALIAS_CONTEXT_WORDS, alias_catalog, alias_catalog_length, alias_scratch,
        alias_scratch_capacity, alias_work, alias_work_capacity);
}

fn valid_global_declarations(input:[i32], length: i32, words: i32,
    unit_count: i32) -> bool {
    if (!valid_range(0, words, length) || words <= lowering::declarations::HEADER - 1
        || input[0] <= 0
        || words != lowering::declarations::HEADER
            + input[0] * lowering::declarations::ROW) {
        return false;
    }
    let row: i32 = 0;
    while (row <= input[0] - 1) {
        let slot: i32 = lowering::declarations::HEADER
            + row * lowering::declarations::ROW;
        if (input[slot] < 0 || input[slot] >= unit_count) { return false; }
        row += 1;
    }
    return true;
}

fn valid_global_allocation(input:[i32], length: i32, words: i32,
    unit_count: i32) -> bool {
    if (!valid_range(0, words, length) || words <= lowering::declarations::HEADER - 1
        || input[0] != unit_count || input[1] <= 0
        || words != lowering::declarations::HEADER + input[1] * 10) {
        return false;
    }
    let row: i32 = 0;
    while (row <= input[1] - 1) {
        let slot: i32 = lowering::declarations::HEADER + row * 10;
        if (input[slot] < 0 || input[slot] >= unit_count) { return false; }
        row += 1;
    }
    return true;
}

// Validate one record range inside the aggregate signature table. Transport
// descriptors retain per-unit record partitions, while bodies.lower_owned
// resolves every function against the complete table at offset zero.
fn valid_signature_records(input:[i32], offset: i32, words: i32,
    length: i32) -> bool {
    if (!valid_range(offset, words, length) || words < lowering::signatures::RECORD) {
        return false;
    }
    let position: i32 = offset;
    let finish: i32 = offset + words;
    while (position <= finish - 1) {
        if (position > finish - lowering::signatures::RECORD
            || input[position] < 0 || input[position + 5] < 0
            || input[position + 5] > finish - position
                - lowering::signatures::RECORD) {
            return false;
        }
        position += lowering::signatures::RECORD + input[position + 5];
    }
    return position == finish;
}

// Global body boundary. Declaration and allocation tables are passed intact;
// only the unit-owned allocation rows are emitted against the copied local
// syntax arenas. Signature offsets in transport descriptors identify each
// unit's header-bearing partition for transport only. `global_signatures` is
// the one aggregate header-bearing table used by every owned body. Each
// sixteen-word context adds a tagged value-name slice at words 14 and 15;
// those keys are local token indices and values are global function IDs.
pub fn lower_units_owned(descriptors:[i32], descriptor_length: i32,
    unit_count: i32, contexts:[i32], context_length: i32,
    transport_descriptors:[i32], transport_descriptor_length: i32,
    unit_declarations:[i32], unit_declaration_length: i32,
    global_declarations:[i32], global_declaration_words: i32,
    source_catalog:[i32], source_catalog_length: i32,
    token_catalog:[i32], token_catalog_length: i32,
    record_catalog:[i32], record_catalog_length: i32,
    offsets_catalog:[i32], offsets_catalog_length: i32,
    type_arena_catalog:[i32], type_arena_catalog_length: i32,
    resolution_catalog:[i32], resolution_catalog_length: i32,
    value_catalog:[i32], value_catalog_length: i32,
    signature_catalog:[i32], signature_catalog_length: i32,
    global_signatures:[i32], global_signature_words: i32,
    allocated:[i32], allocation_words: i32,
    source_scratch:[i32], source_capacity: i32,
    token_scratch:[i32], token_capacity: i32,
    record_scratch:[i32], record_capacity: i32,
    offsets_scratch:[i32], offsets_capacity: i32,
    type_arena_scratch:[i32], type_arena_capacity: i32,
    resolution_scratch:[i32], resolution_capacity: i32,
    value_scratch:[i32], value_scratch_capacity: i32,
    expression_arena:[i32], expression_capacity: i32,
    type_output:[i32], type_output_capacity: i32,
    body_scratch:[i32], body_scratch_capacity: i32,
    body_catalog:[i32], body_capacity: i32,
    alias_catalog:[i32], alias_catalog_length: i32,
    alias_scratch:[i32], alias_scratch_capacity: i32,
    alias_work:[i32], alias_work_capacity: i32) -> i32 {
    if (unit_count <= 0 || descriptor_length <= -1
        || descriptor_length != unit_count * lowering::units::DESCRIPTOR_WORDS
        || context_length <= -1
        || context_length != unit_count * VALUE_CONTEXT_WORDS
        || transport_descriptor_length <= -1
        || transport_descriptor_length != unit_count * DESCRIPTOR_WORDS
        || unit_declaration_length <= -1 || source_catalog_length <= -1
        || token_catalog_length <= -1 || record_catalog_length <= -1
        || offsets_catalog_length <= -1 || type_arena_catalog_length <= -1
        || resolution_catalog_length <= -1 || value_catalog_length <= -1
        || signature_catalog_length <= -1
        || global_signature_words <= -1
        || alias_catalog_length <= -1 || allocation_words <= 7
        || source_capacity <= -1 || token_capacity <= -1
        || record_capacity <= -1 || offsets_capacity <= -1
        || type_arena_capacity <= 0 || resolution_capacity <= -1
        || value_scratch_capacity <= -1
        || expression_capacity <= 0 || type_output_capacity <= 0
        || body_scratch_capacity <= lowering::bodies::HEADER
        || body_capacity <= lowering::bodies::HEADER
        || alias_scratch_capacity <= -1 || alias_work_capacity <= -1) {
        return -1;
    }
    if (!valid_global_declarations(global_declarations,
            global_declaration_words, global_declaration_words, unit_count)) {
        return -1;
    }
    if (!valid_global_allocation(allocated, allocation_words,
            allocation_words, unit_count)) {
        return -1;
    }
    if (!valid_signature_table(global_signatures, 0,
            global_signature_words, global_signature_words)) {
        return -1;
    }
    let unit: i32 = 0;
    while (unit <= unit_count - 1) {
        let descriptor: i32 = unit * lowering::units::DESCRIPTOR_WORDS;
        let context: i32 = unit * VALUE_CONTEXT_WORDS;
        let transport: i32 = unit * DESCRIPTOR_WORDS;
        let declaration_offset: i32 = descriptors[descriptor
            + lowering::units::DECLARATION_OFFSET];
        let declaration_words: i32 = descriptors[descriptor
            + lowering::units::DECLARATION_WORDS];
        if (!valid_declaration_table(unit_declarations, unit_declaration_length,
                declaration_offset, declaration_words, unit)
            || !valid_context(contexts, context, source_catalog_length,
                token_catalog_length, record_catalog_length,
                offsets_catalog_length, type_arena_catalog_length,
                resolution_catalog_length)
            || !valid_owned_context(contexts, context, alias_catalog_length,
                value_catalog, value_catalog_length,
                contexts[context + lowering::signatures::TOKEN_COUNT],
                allocated, allocation_words, global_signatures,
            global_signature_words)) {
            return -1;
        }
        let source_offset: i32 = contexts[context + lowering::signatures::SOURCE_OFFSET];
        let source_words: i32 = contexts[context + lowering::signatures::SOURCE_LENGTH];
        let token_offset: i32 = contexts[context + lowering::signatures::TOKEN_OFFSET];
        let token_count: i32 = contexts[context + lowering::signatures::TOKEN_COUNT];
        if (transport_descriptors[transport + SOURCE_OFFSET] != source_offset
            || transport_descriptors[transport + SOURCE_LENGTH] != source_words
            || transport_descriptors[transport + TOKEN_OFFSET] != token_offset
            || transport_descriptors[transport + TOKEN_COUNT] != token_count
            || !valid_transport_signature_slice(signature_catalog,
                transport_descriptors[transport + SIGNATURE_OFFSET],
                transport_descriptors[transport + SIGNATURE_WORDS],
                signature_catalog_length)) {
            return -1;
        }
        unit += 1;
    }
    let check: i32 = 0;
    while (check <= unit_count - 1) {
        let context: i32 = check * VALUE_CONTEXT_WORDS;
        let declaration: i32 = check * lowering::units::DESCRIPTOR_WORDS;
        let transport: i32 = check * DESCRIPTOR_WORDS;
        let source_offset: i32 = contexts[context + lowering::signatures::SOURCE_OFFSET];
        let source_words: i32 = contexts[context + lowering::signatures::SOURCE_LENGTH];
        let token_offset: i32 = contexts[context + lowering::signatures::TOKEN_OFFSET];
        let token_words: i32 = contexts[context + lowering::signatures::TOKEN_COUNT] * 3;
        let record_offset: i32 = contexts[context + lowering::signatures::RECORD_OFFSET];
        let record_words: i32 = contexts[context + lowering::signatures::RECORD_LENGTH];
        let offsets_offset: i32 = contexts[context + lowering::signatures::OFFSETS_OFFSET];
        let offsets_words: i32 = contexts[context + lowering::signatures::NODE_COUNT];
        let type_offset: i32 = contexts[context + lowering::signatures::TYPE_ARENA_OFFSET];
        let type_words: i32 = contexts[context + lowering::signatures::TYPE_ARENA_LENGTH];
        let alias_offset: i32 = contexts[context + ALIAS_OFFSET];
        let alias_words: i32 = contexts[context + ALIAS_WORDS];
        let signature_offset: i32 = transport_descriptors[transport + SIGNATURE_OFFSET];
        let signature_words: i32 = transport_descriptors[transport + SIGNATURE_WORDS];
        let previous: i32 = 0;
        while (previous <= check - 1) {
            let previous_context: i32 = previous * VALUE_CONTEXT_WORDS;
            let previous_descriptor: i32 = previous * lowering::units::DESCRIPTOR_WORDS;
            let previous_transport: i32 = previous * DESCRIPTOR_WORDS;
            if (overlap(source_offset, source_words,
                    contexts[previous_context + lowering::signatures::SOURCE_OFFSET],
                    contexts[previous_context + lowering::signatures::SOURCE_LENGTH])) { return -132001001; }
            if (overlap(token_offset, token_words,
                    contexts[previous_context + lowering::signatures::TOKEN_OFFSET],
                    contexts[previous_context + lowering::signatures::TOKEN_COUNT] * 3)) { return -132001002; }
            if (overlap(record_offset, record_words,
                    contexts[previous_context + lowering::signatures::RECORD_OFFSET],
                    contexts[previous_context + lowering::signatures::RECORD_LENGTH])) { return -132001003; }
            if (overlap(offsets_offset, offsets_words,
                    contexts[previous_context + lowering::signatures::OFFSETS_OFFSET],
                    contexts[previous_context + lowering::signatures::NODE_COUNT])) { return -132001004; }
            if (overlap(type_offset, type_words,
                    contexts[previous_context + lowering::signatures::TYPE_ARENA_OFFSET],
                    contexts[previous_context + lowering::signatures::TYPE_ARENA_LENGTH])) { return -132001005; }
            if (overlap(alias_offset, alias_words,
                    contexts[previous_context + ALIAS_OFFSET],
                    contexts[previous_context + ALIAS_WORDS])) { return -132001006; }
            if (overlap(contexts[context + VALUE_OFFSET],
                    contexts[context + VALUE_WORDS],
                    contexts[previous_context + VALUE_OFFSET],
                    contexts[previous_context + VALUE_WORDS])) { return -132001007; }
            if (overlap(signature_offset, signature_words,
                    transport_descriptors[previous_transport + SIGNATURE_OFFSET],
                    transport_descriptors[previous_transport + SIGNATURE_WORDS])) { return -132001008; }
            previous += 1;
        }
        check += 1;
    }
    let written: i32 = 0;
    unit = 0;
    while (unit <= unit_count - 1) {
        let context: i32 = unit * VALUE_CONTEXT_WORDS;
        let transport: i32 = unit * DESCRIPTOR_WORDS;
        if (!copy_words(source_catalog,
                contexts[context + lowering::signatures::SOURCE_OFFSET],
                contexts[context + lowering::signatures::SOURCE_LENGTH],
                source_scratch, source_capacity)
            || !copy_words(token_catalog,
                contexts[context + lowering::signatures::TOKEN_OFFSET],
                contexts[context + lowering::signatures::TOKEN_COUNT] * 3,
                token_scratch, token_capacity)
            || !copy_words(record_catalog,
                contexts[context + lowering::signatures::RECORD_OFFSET],
                contexts[context + lowering::signatures::RECORD_LENGTH],
                record_scratch, record_capacity)
            || !copy_words(offsets_catalog,
                contexts[context + lowering::signatures::OFFSETS_OFFSET],
                contexts[context + lowering::signatures::NODE_COUNT],
                offsets_scratch, offsets_capacity)
            || !copy_words(type_arena_catalog,
                contexts[context + lowering::signatures::TYPE_ARENA_OFFSET],
                contexts[context + lowering::signatures::TYPE_ARENA_LENGTH],
                type_arena_scratch, type_arena_capacity)
            || !copy_words(resolution_catalog,
                contexts[context + lowering::signatures::RESOLUTION_OFFSET],
                contexts[context + lowering::signatures::RESOLUTION_LENGTH],
                resolution_scratch, resolution_capacity)
            || !copy_words(value_catalog,
                contexts[context + VALUE_OFFSET],
                contexts[context + VALUE_WORDS], value_scratch,
                value_scratch_capacity)) {
            return -1;
        }
        let alias_offset: i32 = contexts[context + ALIAS_OFFSET];
        let alias_words: i32 = contexts[context + ALIAS_WORDS];
        let value_words: i32 = contexts[context + VALUE_WORDS];
        if (!copy_words(alias_catalog, alias_offset, alias_words,
                alias_scratch, alias_scratch_capacity)
            || !lowering::aliases::valid(alias_scratch, alias_words,
                token_scratch, contexts[context + lowering::signatures::TOKEN_COUNT])) {
            return -1;
        }
        let node: i32 = 0;
        while (node <= contexts[context + lowering::signatures::NODE_COUNT] - 1) {
            if (offsets_scratch[node] <= -1
                || offsets_scratch[node] > contexts[context + lowering::signatures::RECORD_LENGTH] - 4) {
                return -1;
            }
            node += 1;
        }
        let local_body_words: i32 = lowering::bodies::lower_owned(unit,
            source_scratch, contexts[context + lowering::signatures::SOURCE_LENGTH],
            token_scratch, contexts[context + lowering::signatures::TOKEN_COUNT],
            record_scratch, contexts[context + lowering::signatures::RECORD_LENGTH],
            offsets_scratch, contexts[context + lowering::signatures::NODE_COUNT],
            global_declarations, global_declaration_words, allocated,
            allocation_words, global_signatures, global_signature_words,
            expression_arena, expression_capacity, type_arena_scratch,
            contexts[context + lowering::signatures::TYPE_ARENA_LENGTH],
            resolution_scratch, contexts[context + lowering::signatures::RESOLUTION_LENGTH],
            alias_scratch, alias_words, alias_work, alias_work_capacity,
            type_output, type_output_capacity, value_scratch, value_words,
            body_scratch,
            body_scratch_capacity);
        if (local_body_words <= lowering::bodies::HEADER - 1
            || body_scratch[3] != local_body_words
            || local_body_words > body_scratch_capacity) {
            return local_body_words;
        }
        let local_position: i32 = lowering::bodies::HEADER;
        while (local_position <= local_body_words - 1) {
            let record_words: i32 = body_scratch[local_position];
            if (record_words <= lowering::bodies::RECORD_HEADER - 1
                || record_words > local_body_words - local_position - 1
                || body_scratch[local_position + 3] <= -1
                || prior_body_id(body_catalog, written,
                    body_scratch[local_position + 3])) {
                return -1;
            }
            local_position += record_words + 1;
        }
        if (local_position != local_body_words
            || body_capacity - written < local_body_words) {
            return -1;
        }
        let word: i32 = 0;
        while (word <= local_body_words - 1) {
            body_catalog[written + word] = body_scratch[word];
            word += 1;
        }
        transport_descriptors[transport + BODY_OFFSET] = written;
        transport_descriptors[transport + BODY_WORDS] = local_body_words;
        written += local_body_words;
        unit += 1;
    }
    return written;
}
