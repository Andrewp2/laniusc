        let source_offset: i32 = contexts[context + lowering::signatures::SOURCE_OFFSET];
        let source_words: i32 = contexts[context + lowering::signatures::SOURCE_LENGTH];
        let token_offset: i32 = contexts[context + lowering::signatures::TOKEN_OFFSET];
        let token_count: i32 = contexts[context + lowering::signatures::TOKEN_COUNT];
        if (transport_descriptors[transport + SOURCE_OFFSET] != source_offset || transport_descriptors[transport + SOURCE_LENGTH] != source_words || transport_descriptors[transport + TOKEN_OFFSET] != token_offset || transport_descriptors[transport + TOKEN_COUNT] != token_count) {
            return -1;
        }
        let signature_offset: i32 = transport_descriptors[transport + SIGNATURE_OFFSET];
        let signature_words: i32 = transport_descriptors[transport + SIGNATURE_WORDS];
