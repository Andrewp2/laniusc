module lowering::body_units;
import lowering::bodies;
import lowering::declarations;
import lowering::aliases;
import lowering::signatures;
import lowering::units; // This descriptor is intentionally identical to transport's multi-unit
// descriptor. Source/token fields must agree with the richer signature
// context; signature fields name one already-lowered unit table. This pass
// fills the final two fields with offsets into body_catalog.
pub const DESCRIPTOR_WORDS: i32 = 8;
pub const SOURCE_OFFSET: i32 = 0;
pub const SOURCE_LENGTH: i32 = 1;
pub const TOKEN_OFFSET: i32 = 2;
pub const TOKEN_COUNT: i32 = 3;
pub const SIGNATURE_OFFSET: i32 = 4;
pub const SIGNATURE_WORDS: i32 = 5;
pub const BODY_OFFSET: i32 = 6;
pub const BODY_WORDS: i32 = 7;
pub const CONTEXT_WORDS: i32 = 12;
pub const ALIAS_OFFSET: i32 = 12;
pub const ALIAS_WORDS: i32 = 13;
pub const ALIAS_CONTEXT_WORDS: i32 = 14;
// Owned body lowering also consumes a caller-local value-name resolution
// slice.  Keep it after the nominal type-resolution pair so the two formats
// cannot be confused: [value offset, value words].
pub const VALUE_OFFSET: i32 = 14;
pub const VALUE_WORDS: i32 = 15;
pub const VALUE_CONTEXT_WORDS: i32 = 16;
fn valid_range(offset: i32, words: i32, length: i32) -> bool {
    if (offset <= -1 || words <= -1 || length <= -1 || offset>length || words>length - offset) {
        return false;
    }
    return true;
}
fn rows_range(offset: i32, rows: i32, stride: i32, length: i32) -> bool {
    if (rows <= -1 || stride <= 0 || rows>715827882) {
        return false;
    }
    return valid_range(offset, rows * stride, length);
}
fn overlap(first: i32, first_words: i32, second: i32, second_words: i32) -> bool {
    if (first_words <= 0 || second_words <= 0) {
        return false;
    }
    if (first <= second) {
        return second - first <= first_words - 1;
    }
    return first - second <= second_words - 1;
}
fn copy_words(input:[i32], offset: i32, words: i32, output:[i32], capacity: i32) -> bool {
    if (offset <= -1 || words <= -1 || capacity <= -1 || words>capacity) {
        return false;
    }
    let index: i32 = 0;
    while (index <= words - 1) {
        output[index] = input[offset + index];
        index += 1;
    }
    return true;
}
fn valid_declaration_table(input:[i32], length: i32, offset: i32, words: i32, unit: i32) -> bool {
    if (!valid_range(offset, words, length) || words <= lowering::declarations::HEADER - 1) {
        return false;
    }
    let rows: i32 = input[offset];
    if (rows <= 0 || rows>(words - lowering::declarations::HEADER) / lowering::declarations::ROW || words != lowering::declarations::HEADER + rows * lowering::declarations::ROW) {
        return false;
    }
    let row: i32 = 0;
    while (row <= rows - 1) {
        let slot: i32 = offset + lowering::declarations::HEADER + row * lowering::declarations::ROW;
        if (input[slot] != unit) {
            return false;
        }
        row += 1;
    }
    return true;
}
fn valid_context(contexts:[i32], position: i32, source_length: i32, token_length: i32, record_length: i32, offsets_length: i32, arena_length: i32, resolution_length: i32) -> bool {
    let source_offset: i32 = contexts[position + lowering::signatures::SOURCE_OFFSET];
    let source_words: i32 = contexts[position + lowering::signatures::SOURCE_LENGTH];
    let token_offset: i32 = contexts[position + lowering::signatures::TOKEN_OFFSET];
    let token_count: i32 = contexts[position + lowering::signatures::TOKEN_COUNT];
    let record_offset: i32 = contexts[position + lowering::signatures::RECORD_OFFSET];
    let records: i32 = contexts[position + lowering::signatures::RECORD_LENGTH];
    let offsets_offset: i32 = contexts[position + lowering::signatures::OFFSETS_OFFSET];
    let nodes: i32 = contexts[position + lowering::signatures::NODE_COUNT];
    let type_offset: i32 = contexts[position + lowering::signatures::TYPE_ARENA_OFFSET];
    let type_words: i32 = contexts[position + lowering::signatures::TYPE_ARENA_LENGTH];
    let resolution_offset: i32 = contexts[position + lowering::signatures::RESOLUTION_OFFSET];
    let resolution_words: i32 = contexts[position + lowering::signatures::RESOLUTION_LENGTH];
    if (!valid_range(source_offset, source_words, source_length) || !rows_range(token_offset, token_count, 3, token_length) || !valid_range(record_offset, records, record_length) || !rows_range(offsets_offset, nodes, 1, offsets_length) || !valid_range(type_offset, type_words, arena_length) || !valid_range(resolution_offset, resolution_words, resolution_length)) {
        return false;
    }
    if (token_count <= -1 || nodes <= 0 || type_words <= 0 || resolution_words <= -1 || resolution_words % 2 != 0) {
        return false;
    }
    return true;
}
fn valid_alias_context(contexts:[i32], position: i32, context_words: i32, alias_length: i32) -> bool {
    if (context_words == CONTEXT_WORDS) {
        return true;
    }
    if (context_words != ALIAS_CONTEXT_WORDS) {
        return false;
    }
    return valid_range(contexts[position + ALIAS_OFFSET],
        contexts[position + ALIAS_WORDS], alias_length);
}
fn valid_signature_table(input:[i32], offset: i32, words: i32, length: i32) -> bool {
    if (!valid_range(offset, words, length) || words <= lowering::signatures::HEADER - 1 || input[offset] != lowering::signatures::VERSION || input[offset + 2] != words) {
        return false;
    }
    let records: i32 = input[offset + 1];
    if (records <= -1 || records>(words - lowering::signatures::HEADER) / lowering::signatures::RECORD) {
        return false;
    }
    let position: i32 = offset + lowering::signatures::HEADER;
    let count: i32 = 0;
    while (position <= offset + words - 1) {
        if (position>offset + words - lowering::signatures::RECORD) {
            return false;
        }
        let payload: i32 = input[position + 5];
        if (input[position] <= -1 || payload <= -1 || payload>offset + words - position - lowering::signatures::RECORD) {
            return false;
        }
        let previous: i32 = offset + lowering::signatures::HEADER;
        while (previous <= position - 1) {
            if (input[previous] == input[position]) {
                return false;
            }
            previous += lowering::signatures::RECORD + input[previous + 5];
        }
        count += 1;
        position += lowering::signatures::RECORD + payload;
