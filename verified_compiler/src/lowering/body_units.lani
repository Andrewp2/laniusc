        let descriptor: i32 = unit * lowering::units::DESCRIPTOR_WORDS;
        let context: i32 = unit * context_words;
        let transport: i32 = unit * DESCRIPTOR_WORDS;
        let declaration_offset: i32 = descriptors[descriptor + lowering::units::DECLARATION_OFFSET];
        let local_declaration_words: i32 = descriptors[descriptor + lowering::units::DECLARATION_WORDS];
