module lowering::allocation;

import lowering::declarations;

pub const HEADER: i32 = 8;
pub const ROW: i32 = 10;

// Validate one exact collector table and count its rows independently of the
// claimed header. The eight scratch words belong to allocate's output buffer.
fn validate_unit(input: [i32], length: i32, position: i32, unit: i32,
    scratch: [i32]) -> i32 {
    if (position < 0 || position > length || length - position < 8) { return -1; }
    let rows: i32 = input[position];
    if (rows <= 0 || rows > (length - position - 8) / 8) { return -1; }
    let index: i32 = 0;
    while (index < 8) { scratch[index] = 0; index += 1; }
    let row: i32 = 0;
    while (row < rows) {
        let slot: i32 = position + 8 + row * 8;
        let kind: i32 = input[slot + 1];
        if (input[slot] != unit || kind < 1 || kind > 7
            || input[slot + 2] < 0 || input[slot + 2] > 1
            || input[slot + 3] < 0 || input[slot + 4] < 0
            || input[slot + 4] >= input[slot + 3]) { return -1; }
        if (kind >= lowering::declarations::MODULE) {
            if (input[slot + 2] != 0 || input[slot + 5] != -1) { return -1; }
        } else { if (input[slot + 5] < 0) { return -1; } }
        if (kind == lowering::declarations::ALIAS || kind >= lowering::declarations::MODULE) {
            if (input[slot + 6] < 0 || input[slot + 6] >= input[slot + 4]) { return -1; }
        } else { if (input[slot + 6] != -1) { return -1; } }
        if (input[slot + 7] != scratch[kind]) { return -1; }
        scratch[kind] += 1;
        row += 1;
    }
    if (scratch[lowering::declarations::MODULE] != 1) { return -1; }
    index = 1;
    while (index < 8) {
        if (input[position + index] != scratch[index]) { return -1; }
        index += 1;
    }
    return position + 8 + rows * 8;
}

// Input is the exact concatenation of `units` declaration-collector tables,
// ordered by source unit. Unit IDs must be 0..units-1, as in Program.allocate.
// The allocator derives every category base and prefix itself; no declaration
// or Core IDs are accepted from the host or from an extractor's claims.
//
// Output header:
//   [units, rows, structures, aliases, constants, functions, externs, declarations]
// Each row preserves its eight source-origin words verbatim, then appends
//   [declaration ID, Core ID].
// Aliases have no Core ID; module/import rows have neither ID (marked -1).
// Structures use their Core type ID, constants their constant ID, and both
// callable kinds their function ID. Within each unit all functions precede
// its externs in the ID namespace, irrespective of source-item order.
//
// Returns the number of output words, or -1. Failure output is partial and
// must be discarded. Buffers must be disjoint and lengths match real storage.
pub fn allocate(input: [i32], length: i32, units: i32,
    output: [i32], capacity: i32) -> i32 {
    if (length < 0 || units < 0 || units > length / 16 || capacity < HEADER) { return -1; }
    let position: i32 = 0;
    let unit: i32 = 0;
    let rows: i32 = 0;
    let structures: i32 = 0;
    let aliases: i32 = 0;
    let constants: i32 = 0;
    let functions: i32 = 0;
    let externs: i32 = 0;
    while (unit < units) {
        let next: i32 = validate_unit(input, length, position, unit, output);
        if (next < 0) { return -1; }
        if (input[position] > 2147483647 - rows
            || input[position + 1] > 2147483647 - structures
            || input[position + 2] > 2147483647 - aliases
            || input[position + 3] > 2147483647 - constants
            || input[position + 4] > 2147483647 - functions
            || input[position + 5] > 2147483647 - externs) { return -1; }
        rows += input[position];
        structures += input[position + 1];
        aliases += input[position + 2];
        constants += input[position + 3];
        functions += input[position + 4];
        externs += input[position + 5];
        position = next;
        unit += 1;
    }
    if (position != length || rows > (capacity - HEADER) / ROW
        || aliases > 2147483647 - structures) { return -1; }
    let constant_base: i32 = structures + aliases;
    if (constants > 2147483647 - constant_base) { return -1; }
    let function_base: i32 = constant_base + constants;
    if (functions > 2147483647 - function_base
        || externs > 2147483647 - function_base - functions) { return -1; }

    let structure_cursor: i32 = 0;
    let alias_cursor: i32 = 0;
    let constant_cursor: i32 = 0;
    let function_cursor: i32 = 0;
    let written: i32 = HEADER;
    position = 0;
    unit = 0;
    while (unit < units) {
        let row: i32 = 0;
        while (row < input[position]) {
            let slot: i32 = position + 8 + row * 8;
            let index: i32 = 0;
            while (index < 8) { output[written + index] = input[slot + index]; index += 1; }
            let kind: i32 = input[slot + 1];
            let ordinal: i32 = input[slot + 7];
            let declaration: i32 = -1;
            let core: i32 = -1;
            if (kind == lowering::declarations::STRUCTURE) {
                core = structure_cursor + ordinal;
                declaration = core;
            }
            if (kind == lowering::declarations::ALIAS) { declaration = structures + alias_cursor + ordinal; }
            if (kind == lowering::declarations::CONSTANT) {
                core = constant_cursor + ordinal;
                declaration = constant_base + core;
            }
            if (kind == lowering::declarations::FUNCTION) {
                core = function_cursor + ordinal;
                declaration = function_base + core;
            }
            if (kind == lowering::declarations::EXTERNAL) {
                core = function_cursor + input[position + 4] + ordinal;
                declaration = function_base + core;
            }
            output[written + 8] = declaration;
            output[written + 9] = core;
            written += ROW;
            row += 1;
        }
        structure_cursor += input[position + 1];
        alias_cursor += input[position + 2];
        constant_cursor += input[position + 3];
        function_cursor += input[position + 4] + input[position + 5];
        position += 8 + input[position] * 8;
        unit += 1;
    }
    output[0] = units;
    output[1] = rows;
    output[2] = structures;
    output[3] = aliases;
    output[4] = constants;
    output[5] = functions;
    output[6] = externs;
    output[7] = function_base + functions + externs;
    return written;
}
