module lowering::program_transport;

import lowering::semantic;
import lowering::program;
import lowering::transport;
import lowering::aliases;
import lowering::body_units;
import lowering::bodies;
import lowering::declarations;
import lowering::modules;
import lowering::signatures;
import lowering::units;
import lowering::types;
import verified::host;
import verified::surface_type;

// The native compiler crosses this module with one owned, bounded catalog
// bundle.  Each unit owns fixed-capacity slots; logical lengths live in the
// authenticated contexts below, so the lowering APIs can retain their exact
// range checks without a slice-valued native ABI.
pub const BUNDLE_MAGIC: i32 = 1296649550;
pub const BUNDLE_HEADER: i32 = 16;
// Per-unit lengths live in their own section.  Keeping this metadata ahead of
// descriptors is essential: descriptor/context slots are written while the
// catalogs are prepared and must never alias another unit's lengths.
pub const BUNDLE_METADATA_WORDS: i32 = 7;
pub const BUNDLE_UNIT_LIMIT: i32 = 64;
pub const BUNDLE_DECL_CAP: i32 = 65536;
pub const BUNDLE_MODULE_CAP: i32 = 65536;
pub const BUNDLE_SOURCE_CAP: i32 = 65536;
pub const BUNDLE_TOKEN_CAP: i32 = 196608;
pub const BUNDLE_RECORD_CAP: i32 = 1048576;
pub const BUNDLE_OFFSETS_CAP: i32 = 131072;
pub const BUNDLE_TYPE_CAP: i32 = 65536;
pub const BUNDLE_VALUE_CAP: i32 = 65536;
pub const BUNDLE_ALIAS_CAP: i32 = 65536;
pub const BUNDLE_RESOLUTION_CAP: i32 = 65536;
pub const BUNDLE_SIGNATURE_CAP: i32 = 262144;
pub const BUNDLE_BODY_CAP: i32 = 1048576;

fn bundle_metadata_base(unit_count: i32) -> i32 {
    return BUNDLE_HEADER;
}
fn bundle_descriptors_base(unit_count: i32) -> i32 {
    return bundle_metadata_base(unit_count) + unit_count * BUNDLE_METADATA_WORDS;
}
fn bundle_contexts_base(unit_count: i32) -> i32 {
    return bundle_descriptors_base(unit_count) + unit_count * 4;
}
fn bundle_declarations_base(unit_count: i32) -> i32 {
    return bundle_contexts_base(unit_count) + unit_count * 16;
}
fn bundle_modules_base(unit_count: i32) -> i32 {
    return bundle_declarations_base(unit_count) + unit_count * BUNDLE_DECL_CAP;
}
fn bundle_sources_base(unit_count: i32) -> i32 {
    return bundle_modules_base(unit_count) + unit_count * BUNDLE_MODULE_CAP;
}
fn bundle_tokens_base(unit_count: i32) -> i32 {
    return bundle_sources_base(unit_count) + unit_count * BUNDLE_SOURCE_CAP;
}
fn bundle_records_base(unit_count: i32) -> i32 {
    return bundle_tokens_base(unit_count) + unit_count * BUNDLE_TOKEN_CAP;
}
fn bundle_offsets_base(unit_count: i32) -> i32 {
    return bundle_records_base(unit_count) + unit_count * BUNDLE_RECORD_CAP;
}
fn bundle_types_base(unit_count: i32) -> i32 {
    return bundle_offsets_base(unit_count) + unit_count * BUNDLE_OFFSETS_CAP;
}
fn bundle_values_base(unit_count: i32) -> i32 {
    return bundle_types_base(unit_count) + unit_count * BUNDLE_TYPE_CAP;
}
fn bundle_aliases_base(unit_count: i32) -> i32 {
    return bundle_values_base(unit_count) + unit_count * BUNDLE_VALUE_CAP;
}
fn bundle_resolutions_base(unit_count: i32) -> i32 {
    return bundle_aliases_base(unit_count) + unit_count * BUNDLE_ALIAS_CAP;
}
pub fn bundle_descriptors_offset(unit_count: i32) -> i32 {
    return bundle_descriptors_base(unit_count);
}
pub fn bundle_metadata_offset(unit_count: i32) -> i32 {
    return bundle_metadata_base(unit_count);
}
pub fn bundle_contexts_offset(unit_count: i32) -> i32 {
    return bundle_contexts_base(unit_count);
}
pub fn bundle_sources_offset(unit_count: i32) -> i32 {
    return bundle_sources_base(unit_count);
}
pub fn bundle_tokens_offset(unit_count: i32) -> i32 {
    return bundle_tokens_base(unit_count);
}
pub fn bundle_records_offset(unit_count: i32) -> i32 {
    return bundle_records_base(unit_count);
}
pub fn bundle_offsets_offset(unit_count: i32) -> i32 {
    return bundle_offsets_base(unit_count);
}
pub fn bundle_resolutions_offset(unit_count: i32) -> i32 {
    return bundle_resolutions_base(unit_count);
}
pub fn bundle_words(unit_count: i32) -> i32 {
    if (unit_count <= 0 || unit_count > BUNDLE_UNIT_LIMIT) { return -1; }
    return bundle_resolutions_base(unit_count) + unit_count * BUNDLE_RESOLUTION_CAP;
}

fn same_catalog_token(source:[i32], source_offset:i32, source_length:i32,
    tokens:[i32], token_offset:i32, token_count:i32, token:i32,
    other_source_offset:i32, other_source_length:i32,
    other_token_offset:i32, other_count:i32, other_token:i32) -> bool {
    if (token <= -1 || token >= token_count || other_token <= -1
        || other_token >= other_count) { return false; }
    let left: i32 = token_offset + token * 3;
    let right: i32 = other_token_offset + other_token * 3;
    if (tokens[left] != 1 || tokens[right] != 1) { return false; }
    let left_start: i32 = tokens[left + 1];
    let left_finish: i32 = tokens[left + 2];
    let right_start: i32 = tokens[right + 1];
    let right_finish: i32 = tokens[right + 2];
    if (left_start <= -1 || left_finish <= left_start
        || right_start <= -1 || right_finish <= right_start
        || left_finish - left_start != right_finish - right_start) { return false; }
    let count: i32 = left_finish - left_start;
    if (left_finish > source_length || right_finish > other_source_length) {
        return false;
    }
    let index: i32 = 0;
    while (index < count) {
        if (source[source_offset + left_start + index]
            != source[other_source_offset + right_start + index]) { return false; }
        index += 1;
    }
    return true;
}

// Construct the caller-local value map required by owned body lowering.  A
// token is admitted only when it has exactly one authenticated global callable
// spelling; duplicate callable names are rejected instead of guessed.
pub fn build_value_catalog(unit:i32, contexts:[i32], source_catalog:[i32],
    token_catalog:[i32], allocated:[i32], allocation_words:i32,
    output:[i32], capacity:i32) -> i32 {
    if (unit <= -1 || capacity < lowering::bodies::VALUE_HEADER
        || allocation_words <= lowering::declarations::HEADER - 1) { return -1; }
    let context: i32 = unit * lowering::body_units::VALUE_CONTEXT_WORDS;
    let source_offset: i32 = contexts[context + lowering::signatures::SOURCE_OFFSET];
    let source_length: i32 = contexts[context + lowering::signatures::SOURCE_LENGTH];
    let token_offset: i32 = contexts[context + lowering::signatures::TOKEN_OFFSET];
    let token_count: i32 = contexts[context + lowering::signatures::TOKEN_COUNT];
    output[0] = lowering::bodies::VALUE_MAGIC;
    output[1] = 0;
    output[2] = lowering::bodies::VALUE_HEADER;
    output[3] = 0;
    let token: i32 = 0;
    let written: i32 = lowering::bodies::VALUE_HEADER;
    while (token < token_count) {
        let local_id: i32 = -1;
        let local_matches: i32 = 0;
        let global_id: i32 = -1;
        let global_matches: i32 = 0;
        let row: i32 = 0;
        while (row <= allocated[1] - 1) {
            let slot: i32 = lowering::declarations::HEADER + row * 10;
            let kind: i32 = allocated[slot + 1];
            if (kind == lowering::declarations::FUNCTION
                || kind == lowering::declarations::EXTERNAL) {
                let owner: i32 = allocated[slot];
                let owner_context: i32 = owner * lowering::body_units::VALUE_CONTEXT_WORDS;
                let owner_source_offset: i32 = contexts[owner_context + lowering::signatures::SOURCE_OFFSET];
                let owner_source_length: i32 = contexts[owner_context + lowering::signatures::SOURCE_LENGTH];
                let owner_token_offset: i32 = contexts[owner_context + lowering::signatures::TOKEN_OFFSET];
                let owner_token_count: i32 = contexts[owner_context + lowering::signatures::TOKEN_COUNT];
                if (same_catalog_token(source_catalog, source_offset, source_length,
                        token_catalog, token_offset, token_count, token,
                        owner_source_offset, owner_source_length,
                        owner_token_offset, owner_token_count,
                        allocated[slot + 5])) {
                    if (owner == unit) {
                        if (local_matches != 0 && local_id != allocated[slot + 9]) { return -1; }
                        local_id = allocated[slot + 9];
                        local_matches += 1;
                    } else {
                        if (global_matches > 0 && global_id != allocated[slot + 9]) {
                            global_id = -1;
                            global_matches = -1;
                        } else {
                            if (global_matches == 0) { global_id = allocated[slot + 9]; }
                            if (global_matches >= 0) { global_matches += 1; }
                        }
                    }
                }
            }
            row += 1;
        }
        let match_id: i32 = local_id;
        let matches: i32 = local_matches;
        if (matches == 0) {
            match_id = global_id;
            matches = global_matches;
        }
        if (matches > 0) {
            if (written > capacity - lowering::bodies::VALUE_ROW) { return -1; }
            output[written] = token;
            output[written + 1] = match_id;
            written += lowering::bodies::VALUE_ROW;
            output[1] += 1;
            output[2] = written;
        }
        token += 1;
    }
    return written;
}

// Resolve a spelling against the allocated structure namespace.  A local
// declaration wins over an imported one; otherwise exactly one global
// structure spelling is accepted.  This keeps qualified cross-unit names
// conservative when the final component is ambiguous.
fn structure_tag(unit:i32, token:i32, contexts:[i32], source_catalog:[i32],
    token_catalog:[i32], allocated:[i32]) -> i32 {
    let local_tag: i32 = -1;
    let local_matches: i32 = 0;
    let global_tag: i32 = -1;
    let global_matches: i32 = 0;
    let context: i32 = unit * 16;
    let source_offset: i32 = contexts[context + lowering::signatures::SOURCE_OFFSET];
    let source_length: i32 = contexts[context + lowering::signatures::SOURCE_LENGTH];
    let token_offset: i32 = contexts[context + lowering::signatures::TOKEN_OFFSET];
    let token_count: i32 = contexts[context + lowering::signatures::TOKEN_COUNT];
    let row: i32 = 0;
    while (row < allocated[1]) {
        let slot: i32 = lowering::declarations::HEADER + row * 10;
        if (allocated[slot + 1] == lowering::declarations::STRUCTURE) {
            let owner: i32 = allocated[slot];
            let owner_context: i32 = owner * 16;
            if (same_catalog_token(source_catalog, source_offset, source_length,
                    token_catalog, token_offset, token_count, token,
                    contexts[owner_context + lowering::signatures::SOURCE_OFFSET],
                    contexts[owner_context + lowering::signatures::SOURCE_LENGTH],
                    contexts[owner_context + lowering::signatures::TOKEN_OFFSET],
                    contexts[owner_context + lowering::signatures::TOKEN_COUNT],
                    allocated[slot + 5])) {
                if (owner == unit) {
                    local_tag = lowering::types::STRUCTURE_BASE + allocated[slot + 9];
                    local_matches += 1;
                } else {
                    global_tag = lowering::types::STRUCTURE_BASE + allocated[slot + 9];
                    global_matches += 1;
                }
            }
        }
        row += 1;
    }
    if (local_matches > 1 || global_matches > 1) { return -2; }
    if (local_matches == 1) { return local_tag; }
    if (global_matches == 1) { return global_tag; }
    return -1;
}

fn alias_target_token(records:[i32], record_length:i32, offsets:[i32],
    node_count:i32, token_count:i32, target:i32, arena:[i32], capacity:i32) -> i32 {
    let root: i32 = verified::surface_type::extract(records, record_length,
        offsets, node_count, token_count, target, arena, capacity, node_count);
    if (root <= -1) { return -1; }
    let path: i32 = root;
    if (arena[1 + root * 8] == 2) {
        path = arena[1 + root * 8 + 2];
    } else {
        if (arena[1 + root * 8] != 1) { return -1; }
    }
    if (path <= -1 || path >= root || arena[1 + path * 8] != 1) { return -1; }
    let segment: i32 = arena[1 + path * 8 + 2];
    let answer: i32 = -1;
    while (segment != -1) {
        if (segment <= -1 || segment >= root || arena[1 + segment * 8] != 0) { return -1; }
        answer = arena[1 + segment * 8 + 4];
        segment = arena[1 + segment * 8 + 7];
    }
    return answer;
}

// The existing nominal resolution table is keyed by the source unit's token
// IDs.  Populate one such table from the global allocation and declaration
// catalogs; no second symbol format is introduced.
fn build_resolution_catalog(unit:i32, contexts:[i32], source_catalog:[i32],
    token_catalog:[i32], records_catalog:[i32], offsets_catalog:[i32],
    declarations:[i32], allocated:[i32], output:[i32], capacity:i32,
    type_arena:[i32]) -> i32 {
    let context: i32 = unit * 16;
    let token_count: i32 = contexts[context + lowering::signatures::TOKEN_COUNT];
    let record_offset: i32 = contexts[context + lowering::signatures::RECORD_OFFSET];
    let record_length: i32 = contexts[context + lowering::signatures::RECORD_LENGTH];
    let offsets_offset: i32 = contexts[context + lowering::signatures::OFFSETS_OFFSET];
    let node_count: i32 = contexts[context + lowering::signatures::NODE_COUNT];
    if (capacity <= 1 || token_count <= 0) { return -1; }
    output[0] = lowering::types::NOMINAL_MAGIC;
    output[1] = 0;
    let written: i32 = 2;
    let token: i32 = 0;
    while (token < token_count) {
        let tag: i32 = structure_tag(unit, token, contexts, source_catalog,
            token_catalog, allocated);
        let resolved: i32 = tag;
        if (resolved <= -100000) { return resolved; }
        if (resolved == -2) { return -1; }
        let row: i32 = 0;
        while (row < declarations[0]) {
            let slot: i32 = lowering::declarations::HEADER
                + row * lowering::declarations::ROW;
            if (declarations[slot] == unit
                && declarations[slot + 1] == lowering::declarations::ALIAS
                && declarations[slot + 5] == token) {
                let target_token: i32 = alias_target_token(records_catalog,
                    record_length, offsets_catalog, node_count, token_count,
                    declarations[slot + 6], type_arena, 65536);
                if (target_token >= 0) {
                    let alias_tag: i32 = structure_tag(unit, target_token,
                        contexts, source_catalog, token_catalog, allocated);
                    if (alias_tag == -2) { return -1; }
                    if (alias_tag > 0) { resolved = alias_tag; }
                }
            }
            row += 1;
        }
        if (resolved > 0) {
            let duplicate: bool = false;
            let prior: i32 = 0;
            while (prior < output[1]) {
                if (same_catalog_token(source_catalog,
                        contexts[context + lowering::signatures::SOURCE_OFFSET],
                        contexts[context + lowering::signatures::SOURCE_LENGTH],
                        token_catalog,
                        contexts[context + lowering::signatures::TOKEN_OFFSET],
                        token_count, token, contexts[context + lowering::signatures::SOURCE_OFFSET],
                        contexts[context + lowering::signatures::SOURCE_LENGTH],
                        contexts[context + lowering::signatures::TOKEN_OFFSET],
                        token_count, output[2 + prior * 2])) { duplicate = true; }
                prior += 1;
            }
            if (!duplicate) {
                if (written > capacity - 2) { return -1; }
                output[written] = token;
                output[written + 1] = resolved;
                written += 2;
                output[1] += 1;
            }
        }
        token += 1;
    }
    return written;
}

fn signature_owner(aggregate:[i32], position:i32, allocated:[i32],
    allocation_words:i32, unit_count:i32) -> i32 {
    if (position <= lowering::signatures::HEADER - 1
        || allocation_words <= lowering::declarations::HEADER - 1) { return -1; }
    let id: i32 = aggregate[position];
    let kind: i32 = aggregate[position + 1];
    let owner: i32 = -1;
    let row: i32 = 0;
    while (row <= allocated[1] - 1) {
        let slot: i32 = lowering::declarations::HEADER + row * 10;
        if (allocated[slot + 1] == kind && allocated[slot + 9] == id) {
            if (owner != -1) { return -1; }
            owner = allocated[slot];
        }
        row += 1;
    }
    if (owner <= -1 || owner >= unit_count) { return -1; }
    return owner;
}

// Partition the header-bearing aggregate signature table into disjoint
// descriptor ranges.  The aggregate remains the body resolver's source of
// truth; these copies exist only for transport's per-unit descriptors.
fn partition_signatures(aggregate:[i32], aggregate_words:i32,
    allocated:[i32], allocation_words:i32, unit_count:i32,
    descriptors:[i32], catalog:[i32], catalog_capacity:i32,
    scratch:[i32], scratch_capacity:i32) -> i32 {
    if (aggregate_words <= lowering::signatures::HEADER - 1
        || aggregate[0] != lowering::signatures::VERSION
        || aggregate[2] != aggregate_words || unit_count <= 0
        || scratch_capacity < unit_count * 3) { return -1; }
    let unit: i32 = 0;
    while (unit < unit_count) {
        scratch[unit * 3] = 0;
        scratch[unit * 3 + 1] = lowering::signatures::HEADER;
        scratch[unit * 3 + 2] = 0;
        unit += 1;
    }
    let position: i32 = lowering::signatures::HEADER;
    let records: i32 = 0;
    while (position <= aggregate_words - 1) {
        if (position > aggregate_words - lowering::signatures::RECORD) { return -1; }
        let payload: i32 = aggregate[position + 5];
        if (payload <= -1 || payload > aggregate_words - position - lowering::signatures::RECORD) { return -1; }
        let owner: i32 = signature_owner(aggregate, position, allocated,
            allocation_words, unit_count);
        if (owner <= -1 || scratch[owner * 3 + 1] > 2147483647
            - lowering::signatures::RECORD - payload) { return -1; }
        scratch[owner * 3] += 1;
        scratch[owner * 3 + 1] += lowering::signatures::RECORD + payload;
        records += 1;
        position += lowering::signatures::RECORD + payload;
    }
    if (position != aggregate_words || records != aggregate[1]) { return -1; }
    let catalog_words: i32 = 0;
    unit = 0;
    while (unit < unit_count) {
        let offset: i32 = catalog_words;
        let words: i32 = scratch[unit * 3 + 1];
        if (offset > catalog_capacity || words > catalog_capacity - offset) { return -1; }
        let descriptor: i32 = unit * lowering::transport::UNIT_DESCRIPTOR_WORDS;
        descriptors[descriptor + lowering::transport::SIGNATURE_OFFSET] = offset;
        descriptors[descriptor + lowering::transport::SIGNATURE_WORDS] = words;
        catalog[offset] = lowering::signatures::VERSION;
        catalog[offset + 1] = scratch[unit * 3];
        catalog[offset + 2] = words;
        catalog[offset + 3] = 0;
        catalog[offset + 4] = 0;
        catalog[offset + 5] = 0;
        catalog[offset + 6] = 0;
        catalog[offset + 7] = 0;
        let row: i32 = 0;
        while (row <= allocated[1] - 1) {
            let slot: i32 = lowering::declarations::HEADER + row * 10;
            if (allocated[slot] == unit) {
                if (allocated[slot + 1] == lowering::declarations::STRUCTURE) { catalog[offset + 3] += 1; }
                if (allocated[slot + 1] == lowering::declarations::FUNCTION) { catalog[offset + 4] += 1; }
                if (allocated[slot + 1] == lowering::declarations::EXTERNAL) { catalog[offset + 5] += 1; }
                if (allocated[slot + 1] == lowering::declarations::CONSTANT) { catalog[offset + 6] += 1; }
            }
            row += 1;
        }
        scratch[unit * 3 + 2] = offset + lowering::signatures::HEADER;
        catalog_words += words;
        unit += 1;
    }
    position = lowering::signatures::HEADER;
    while (position <= aggregate_words - 1) {
        let payload: i32 = aggregate[position + 5];
        let owner: i32 = signature_owner(aggregate, position, allocated,
            allocation_words, unit_count);
        if (owner <= -1) { return -1; }
        let target: i32 = scratch[owner * 3 + 2];
        let words: i32 = lowering::signatures::RECORD + payload;
        let index: i32 = 0;
        while (index < words) {
            catalog[target + index] = aggregate[position + index];
            index += 1;
        }
        scratch[owner * 3 + 2] += words;
        position += words;
    }
    unit = 0;
    while (unit < unit_count) {
        let descriptor: i32 = unit * lowering::transport::UNIT_DESCRIPTOR_WORDS;
        if (scratch[unit * 3 + 2] != descriptors[descriptor + lowering::transport::SIGNATURE_OFFSET]
            + descriptors[descriptor + lowering::transport::SIGNATURE_WORDS]) { return -1; }
        unit += 1;
    }
    return catalog_words;
}

fn prepare_catalogs_raw(bundle_pointer:ptr, unit_count:i32,
    declarations_pointer:ptr, modules_pointer:ptr, allocated_pointer:ptr,
    status_pointer:ptr) -> i32 {
    let bundle:[i32] = verified::host::i32_slice_from_raw_parts(
        bundle_pointer, bundle_words(unit_count));
    let descriptors:[i32] = verified::host::i32_slice_from_raw_parts(
        bundle_pointer + bundle_descriptors_base(unit_count) * 4, unit_count * 4);
    let contexts:[i32] = verified::host::i32_slice_from_raw_parts(
        bundle_pointer + bundle_contexts_base(unit_count) * 4, unit_count * 16);
    let declaration_catalog:[i32] = verified::host::i32_slice_from_raw_parts(
        bundle_pointer + bundle_declarations_base(unit_count) * 4,
        unit_count * BUNDLE_DECL_CAP);
    let module_catalog:[i32] = verified::host::i32_slice_from_raw_parts(
        bundle_pointer + bundle_modules_base(unit_count) * 4,
        unit_count * BUNDLE_MODULE_CAP);
    let source_catalog:[i32] = verified::host::i32_slice_from_raw_parts(
        bundle_pointer + bundle_sources_base(unit_count) * 4,
        unit_count * BUNDLE_SOURCE_CAP);
    let token_catalog:[i32] = verified::host::i32_slice_from_raw_parts(
        bundle_pointer + bundle_tokens_base(unit_count) * 4,
        unit_count * BUNDLE_TOKEN_CAP);
    let record_catalog:[i32] = verified::host::i32_slice_from_raw_parts(
        bundle_pointer + bundle_records_base(unit_count) * 4,
        unit_count * BUNDLE_RECORD_CAP);
    let offsets_catalog:[i32] = verified::host::i32_slice_from_raw_parts(
        bundle_pointer + bundle_offsets_base(unit_count) * 4,
        unit_count * BUNDLE_OFFSETS_CAP);
    let declarations:[i32] = verified::host::i32_slice_from_raw_parts(
        declarations_pointer, unit_count * BUNDLE_DECL_CAP);
    let modules:[i32] = verified::host::i32_slice_from_raw_parts(
        modules_pointer, unit_count * BUNDLE_MODULE_CAP);
    let allocated:[i32] = verified::host::i32_slice_from_raw_parts(
        allocated_pointer, unit_count * BUNDLE_DECL_CAP);
    let alias_work_memory:ptr = verified::host::alloc(BUNDLE_ALIAS_CAP * 4, 4);
    let alias_stack_memory:ptr = verified::host::alloc(BUNDLE_ALIAS_CAP * 4, 4);
    let alias_scratch_memory:ptr = verified::host::alloc(BUNDLE_ALIAS_CAP * 4, 4);
    let alias_result_memory:ptr = verified::host::alloc(8, 4);
    if (alias_work_memory == 0 || alias_stack_memory == 0
        || alias_scratch_memory == 0 || alias_result_memory == 0) { return -1; }
    let alias_work:[i32] = verified::host::i32_slice_from_raw_parts(
        alias_work_memory, BUNDLE_ALIAS_CAP);
    let alias_stack:[i32] = verified::host::i32_slice_from_raw_parts(
        alias_stack_memory, BUNDLE_ALIAS_CAP);
    let alias_scratch:[i32] = verified::host::i32_slice_from_raw_parts(
        alias_scratch_memory, BUNDLE_ALIAS_CAP);
    let alias_result:[i32] = verified::host::i32_slice_from_raw_parts(
        alias_result_memory, 2);
    let unit: i32 = 0;
    while (unit < unit_count) {
        let metadata_base: i32 = bundle_metadata_base(unit_count) + unit * BUNDLE_METADATA_WORDS;
        let source_length: i32 = bundle[metadata_base];
        let token_count: i32 = bundle[metadata_base + 1];
        let node_count: i32 = bundle[metadata_base + 2];
        if (source_length <= -1 || source_length > BUNDLE_SOURCE_CAP
            || token_count <= -1 || token_count > BUNDLE_TOKEN_CAP / 3
            || node_count <= 0 || node_count > BUNDLE_OFFSETS_CAP) { return -1; }
        let source:[i32] = verified::host::i32_slice_from_raw_parts(
            bundle_pointer + (bundle_sources_base(unit_count)
                + unit * BUNDLE_SOURCE_CAP) * 4, BUNDLE_SOURCE_CAP);
        let tokens:[i32] = verified::host::i32_slice_from_raw_parts(
            bundle_pointer + (bundle_tokens_base(unit_count)
                + unit * BUNDLE_TOKEN_CAP) * 4, BUNDLE_TOKEN_CAP);
        let records:[i32] = verified::host::i32_slice_from_raw_parts(
            bundle_pointer + (bundle_records_base(unit_count)
                + unit * BUNDLE_RECORD_CAP) * 4, BUNDLE_RECORD_CAP);
        let offsets:[i32] = verified::host::i32_slice_from_raw_parts(
            bundle_pointer + (bundle_offsets_base(unit_count)
                + unit * BUNDLE_OFFSETS_CAP) * 4, BUNDLE_OFFSETS_CAP);
        let declaration:[i32] = verified::host::i32_slice_from_raw_parts(
            bundle_pointer + (bundle_declarations_base(unit_count)
                + unit * BUNDLE_DECL_CAP) * 4, BUNDLE_DECL_CAP);
        let module_table:[i32] = verified::host::i32_slice_from_raw_parts(
            bundle_pointer + (bundle_modules_base(unit_count)
                + unit * BUNDLE_MODULE_CAP) * 4, BUNDLE_MODULE_CAP);
        let type_arena:[i32] = verified::host::i32_slice_from_raw_parts(
            bundle_pointer + (bundle_types_base(unit_count)
                + unit * BUNDLE_TYPE_CAP) * 4, BUNDLE_TYPE_CAP);
        let alias:[i32] = verified::host::i32_slice_from_raw_parts(
            bundle_pointer + (bundle_aliases_base(unit_count)
                + unit * BUNDLE_ALIAS_CAP) * 4, BUNDLE_ALIAS_CAP);
        let declaration_words: i32 = lowering::declarations::collect(
            records, BUNDLE_RECORD_CAP, offsets, node_count, token_count,
            node_count - 1, unit, declaration, BUNDLE_DECL_CAP);
        if (declaration_words <= -1) { return -1; }
        let module_words: i32 = lowering::modules::materialize(
            tokens, token_count, source_length, records, BUNDLE_RECORD_CAP,
            offsets, node_count, declaration, declaration_words, module_table,
            BUNDLE_MODULE_CAP);
        if (module_words <= -1) { return -1; }
        let alias_words: i32 = lowering::aliases::build(
            source, source_length, tokens, token_count, records,
            BUNDLE_RECORD_CAP, offsets, node_count, declaration,
            declaration_words, type_arena, BUNDLE_TYPE_CAP, alias_work,
            BUNDLE_ALIAS_CAP, alias_stack, BUNDLE_ALIAS_CAP, alias_scratch,
            BUNDLE_ALIAS_CAP, alias_result, 2, alias, BUNDLE_ALIAS_CAP,
            node_count);
        if (alias_words <= -1) { return -1; }
        let descriptor: i32 = unit * 4;
        descriptors[descriptor] = unit * BUNDLE_DECL_CAP;
        descriptors[descriptor + 1] = declaration_words;
        descriptors[descriptor + 2] = unit * BUNDLE_MODULE_CAP;
        descriptors[descriptor + 3] = module_words;
        let context: i32 = unit * 16;
        contexts[context] = unit * BUNDLE_SOURCE_CAP;
        contexts[context + 1] = source_length;
        contexts[context + 2] = unit * BUNDLE_TOKEN_CAP;
        contexts[context + 3] = token_count;
        contexts[context + 4] = unit * BUNDLE_RECORD_CAP;
        contexts[context + 5] = BUNDLE_RECORD_CAP;
        contexts[context + 6] = unit * BUNDLE_OFFSETS_CAP;
        contexts[context + 7] = node_count;
        contexts[context + 8] = unit * BUNDLE_TYPE_CAP;
        contexts[context + 9] = BUNDLE_TYPE_CAP;
        contexts[context + 10] = 0;
        contexts[context + 11] = 0;
        contexts[context + 12] = unit * BUNDLE_ALIAS_CAP;
        contexts[context + 13] = alias_words;
        contexts[context + 14] = unit * BUNDLE_VALUE_CAP;
        contexts[context + 15] = 0;
        unit += 1;
    }
    let collected = lowering::units::accumulate(descriptors, unit_count * 4,
        unit_count, declaration_catalog, unit_count * BUNDLE_DECL_CAP,
        module_catalog, unit_count * BUNDLE_MODULE_CAP, declarations,
        unit_count * BUNDLE_DECL_CAP, modules, unit_count * BUNDLE_MODULE_CAP,
        allocated, unit_count * BUNDLE_DECL_CAP);
    if (lowering::units::units_stage(collected) != lowering::units::SUCCESS) { return -1; }
    let status:[i32] = verified::host::i32_slice_from_raw_parts(status_pointer, 2);
    // `units.accumulate` deliberately preserves the concatenated local
    // collector tables for allocation.  Bodies consume one canonical global
    // declaration table, so materialize that table from the authenticated
    // allocation rows after allocation has assigned the global namespace.
    let total_rows: i32 = allocated[1];
    if (total_rows <= 0
        || total_rows > (unit_count * BUNDLE_DECL_CAP - lowering::declarations::HEADER)
            / lowering::declarations::ROW) { return -1; }
    declarations[0] = total_rows;
    let kind: i32 = 1;
    while (kind < 8) {
        declarations[kind] = 0;
        kind += 1;
    }
    let row: i32 = 0;
    while (row < total_rows) {
        let source_slot: i32 = lowering::declarations::HEADER + row * 10;
        let target_slot: i32 = lowering::declarations::HEADER
            + row * lowering::declarations::ROW;
        let field: i32 = 0;
        while (field < lowering::declarations::ROW) {
            declarations[target_slot + field] = allocated[source_slot + field];
            field += 1;
        }
        let declaration_kind: i32 = declarations[target_slot + 1];
        if (declaration_kind <= 0 || declaration_kind >= 8) { return -1; }
        declarations[declaration_kind] += 1;
        row += 1;
    }
    let resolution_unit: i32 = 0;
    while (resolution_unit < unit_count) {
        let resolution_unit_catalog:[i32] = verified::host::i32_slice_from_raw_parts(
            bundle_pointer + (bundle_resolutions_base(unit_count)
                + resolution_unit * BUNDLE_RESOLUTION_CAP) * 4,
            BUNDLE_RESOLUTION_CAP);
        let type_unit_catalog:[i32] = verified::host::i32_slice_from_raw_parts(
            bundle_pointer + (bundle_types_base(unit_count)
                + resolution_unit * BUNDLE_TYPE_CAP) * 4,
            BUNDLE_TYPE_CAP);
        let record_unit_catalog:[i32] = verified::host::i32_slice_from_raw_parts(
            bundle_pointer + (bundle_records_base(unit_count)
                + resolution_unit * BUNDLE_RECORD_CAP) * 4,
            BUNDLE_RECORD_CAP);
        let offset_unit_catalog:[i32] = verified::host::i32_slice_from_raw_parts(
            bundle_pointer + (bundle_offsets_base(unit_count)
                + resolution_unit * BUNDLE_OFFSETS_CAP) * 4,
            BUNDLE_OFFSETS_CAP);
        let resolution_words: i32 = build_resolution_catalog(resolution_unit,
            contexts, source_catalog, token_catalog, record_unit_catalog,
            offset_unit_catalog, declarations, allocated, resolution_unit_catalog,
            BUNDLE_RESOLUTION_CAP, type_unit_catalog);
        if (resolution_words <= -1) { return -1; }
        let resolution_context: i32 = resolution_unit * 16;
        contexts[resolution_context + 10] = resolution_unit * BUNDLE_RESOLUTION_CAP;
        contexts[resolution_context + 11] = resolution_words;
        resolution_unit += 1;
    }
    status[0] = lowering::units::units_declaration_words(collected);
    status[1] = lowering::units::units_allocation_words(collected);
    return 0;
}

fn lower_signatures_raw(bundle_pointer:ptr, unit_count:i32,
    declarations_pointer:ptr, allocated_pointer:ptr,
    signature_output_pointer:ptr, status_pointer:ptr) -> i32 {
    let descriptors:[i32] = verified::host::i32_slice_from_raw_parts(
        bundle_pointer + bundle_descriptors_base(unit_count) * 4, unit_count * 4);
    let contexts:[i32] = verified::host::i32_slice_from_raw_parts(
        bundle_pointer + bundle_contexts_base(unit_count) * 4, unit_count * 16);
    let declaration_catalog:[i32] = verified::host::i32_slice_from_raw_parts(
        bundle_pointer + bundle_declarations_base(unit_count) * 4,
        unit_count * BUNDLE_DECL_CAP);
    let source_catalog:[i32] = verified::host::i32_slice_from_raw_parts(
        bundle_pointer + bundle_sources_base(unit_count) * 4,
        unit_count * BUNDLE_SOURCE_CAP);
    let token_catalog:[i32] = verified::host::i32_slice_from_raw_parts(
        bundle_pointer + bundle_tokens_base(unit_count) * 4,
        unit_count * BUNDLE_TOKEN_CAP);
    let record_catalog:[i32] = verified::host::i32_slice_from_raw_parts(
        bundle_pointer + bundle_records_base(unit_count) * 4,
        unit_count * BUNDLE_RECORD_CAP);
    let offsets_catalog:[i32] = verified::host::i32_slice_from_raw_parts(
        bundle_pointer + bundle_offsets_base(unit_count) * 4,
        unit_count * BUNDLE_OFFSETS_CAP);
    let type_arena_catalog:[i32] = verified::host::i32_slice_from_raw_parts(
        bundle_pointer + bundle_types_base(unit_count) * 4,
        unit_count * BUNDLE_TYPE_CAP);
    let resolution_catalog:[i32] = verified::host::i32_slice_from_raw_parts(
        bundle_pointer + bundle_resolutions_base(unit_count) * 4,
        unit_count * BUNDLE_RESOLUTION_CAP);
    let alias_catalog:[i32] = verified::host::i32_slice_from_raw_parts(
        bundle_pointer + bundle_aliases_base(unit_count) * 4,
        unit_count * BUNDLE_ALIAS_CAP);
    let declarations:[i32] = verified::host::i32_slice_from_raw_parts(
        declarations_pointer, unit_count * BUNDLE_DECL_CAP);
    let allocated:[i32] = verified::host::i32_slice_from_raw_parts(
        allocated_pointer, unit_count * BUNDLE_DECL_CAP);
    let signature_output:[i32] = verified::host::i32_slice_from_raw_parts(
        signature_output_pointer, unit_count * BUNDLE_SIGNATURE_CAP);
    let status:[i32] = verified::host::i32_slice_from_raw_parts(status_pointer, 3);
    let signature_context_memory:ptr = verified::host::alloc(
        unit_count * lowering::signatures::CONTEXT_WORDS * 4, 4);
    let type_output_memory:ptr = verified::host::alloc(65536 * 4, 4);
    let source_scratch_memory:ptr = verified::host::alloc(BUNDLE_SOURCE_CAP * 4, 4);
    let token_scratch_memory:ptr = verified::host::alloc(BUNDLE_TOKEN_CAP * 4, 4);
    let record_scratch_memory:ptr = verified::host::alloc(BUNDLE_RECORD_CAP * 4, 4);
    let offsets_scratch_memory:ptr = verified::host::alloc(BUNDLE_OFFSETS_CAP * 4, 4);
    let type_scratch_memory:ptr = verified::host::alloc(BUNDLE_TYPE_CAP * 4, 4);
    let resolution_scratch_memory:ptr = verified::host::alloc(BUNDLE_RESOLUTION_CAP * 4, 4);
    let alias_scratch_memory:ptr = verified::host::alloc(BUNDLE_ALIAS_CAP * 4, 4);
    let declaration_scratch_memory:ptr = verified::host::alloc(BUNDLE_DECL_CAP * 4, 4);
    let allocation_scratch_memory:ptr = verified::host::alloc(BUNDLE_DECL_CAP * 4, 4);
    let signature_scratch_memory:ptr = verified::host::alloc(BUNDLE_SIGNATURE_CAP * 4, 4);
    if (signature_context_memory == 0 || type_output_memory == 0
        || source_scratch_memory == 0 || token_scratch_memory == 0
        || record_scratch_memory == 0 || offsets_scratch_memory == 0
        || type_scratch_memory == 0 || resolution_scratch_memory == 0
        || alias_scratch_memory == 0
        || declaration_scratch_memory == 0 || allocation_scratch_memory == 0
        || signature_scratch_memory == 0) { return -1; }
    let signature_contexts:[i32] = verified::host::i32_slice_from_raw_parts(
        signature_context_memory, unit_count * 12);
    let type_output:[i32] = verified::host::i32_slice_from_raw_parts(
        type_output_memory, 65536);
    let source_scratch:[i32] = verified::host::i32_slice_from_raw_parts(
        source_scratch_memory, BUNDLE_SOURCE_CAP);
    let token_scratch:[i32] = verified::host::i32_slice_from_raw_parts(
        token_scratch_memory, BUNDLE_TOKEN_CAP);
    let record_scratch:[i32] = verified::host::i32_slice_from_raw_parts(
        record_scratch_memory, BUNDLE_RECORD_CAP);
    let offsets_scratch:[i32] = verified::host::i32_slice_from_raw_parts(
        offsets_scratch_memory, BUNDLE_OFFSETS_CAP);
    let type_scratch:[i32] = verified::host::i32_slice_from_raw_parts(
        type_scratch_memory, BUNDLE_TYPE_CAP);
    let resolution_scratch:[i32] = verified::host::i32_slice_from_raw_parts(
        resolution_scratch_memory, BUNDLE_RESOLUTION_CAP);
    let alias_scratch:[i32] = verified::host::i32_slice_from_raw_parts(
        alias_scratch_memory, BUNDLE_ALIAS_CAP);
    let declaration_scratch:[i32] = verified::host::i32_slice_from_raw_parts(
        declaration_scratch_memory, BUNDLE_DECL_CAP);
    let allocation_scratch:[i32] = verified::host::i32_slice_from_raw_parts(
        allocation_scratch_memory, BUNDLE_DECL_CAP);
    let signature_scratch:[i32] = verified::host::i32_slice_from_raw_parts(
        signature_scratch_memory, BUNDLE_SIGNATURE_CAP);
    let unit: i32 = 0;
    while (unit < unit_count) {
        let source_context: i32 = unit * 16;
        let target_context: i32 = unit * 12;
        let word: i32 = 0;
        while (word < 12) {
            signature_contexts[target_context + word] = contexts[source_context + word];
            word += 1;
        }
        unit += 1;
    }
    let aggregate_words: i32 = lowering::signatures::lower_units(
        descriptors, unit_count * 4, unit_count, signature_contexts,
        unit_count * 12, declaration_catalog, unit_count * BUNDLE_DECL_CAP,
        source_catalog, unit_count * BUNDLE_SOURCE_CAP, token_catalog,
        unit_count * BUNDLE_TOKEN_CAP, record_catalog,
        unit_count * BUNDLE_RECORD_CAP, offsets_catalog,
        unit_count * BUNDLE_OFFSETS_CAP, type_arena_catalog,
        unit_count * BUNDLE_TYPE_CAP, resolution_catalog,
        unit_count * BUNDLE_RESOLUTION_CAP, alias_catalog,
        unit_count * BUNDLE_ALIAS_CAP, BUNDLE_ALIAS_CAP, alias_scratch,
        BUNDLE_ALIAS_CAP, allocated, status[1], status[0], type_output,
        65536, source_scratch, BUNDLE_SOURCE_CAP, token_scratch,
        BUNDLE_TOKEN_CAP, record_scratch, BUNDLE_RECORD_CAP, offsets_scratch,
        BUNDLE_OFFSETS_CAP, type_scratch, BUNDLE_TYPE_CAP, resolution_scratch,
        BUNDLE_RESOLUTION_CAP, declaration_scratch, BUNDLE_DECL_CAP, allocation_scratch,
        BUNDLE_DECL_CAP, signature_scratch, BUNDLE_SIGNATURE_CAP,
        signature_output, unit_count * BUNDLE_SIGNATURE_CAP);
    if (aggregate_words <= lowering::signatures::HEADER - 1) { return aggregate_words; }
    status[2] = aggregate_words;
    return 0;
}

fn lower_bodies_raw(bundle_pointer:ptr, unit_count:i32,
    declarations_pointer:ptr, allocated_pointer:ptr,
    signature_output_pointer:ptr, signature_catalog_pointer:ptr,
    transport_pointer:ptr, body_catalog_pointer:ptr,
    status_pointer:ptr) -> i32 {
    let descriptors:[i32] = verified::host::i32_slice_from_raw_parts(
        bundle_pointer + bundle_descriptors_base(unit_count) * 4, unit_count * 4);
    let contexts:[i32] = verified::host::i32_slice_from_raw_parts(
        bundle_pointer + bundle_contexts_base(unit_count) * 4, unit_count * 16);
    let declaration_catalog:[i32] = verified::host::i32_slice_from_raw_parts(
        bundle_pointer + bundle_declarations_base(unit_count) * 4,
        unit_count * BUNDLE_DECL_CAP);
    let source_catalog:[i32] = verified::host::i32_slice_from_raw_parts(
        bundle_pointer + bundle_sources_base(unit_count) * 4,
        unit_count * BUNDLE_SOURCE_CAP);
    let token_catalog:[i32] = verified::host::i32_slice_from_raw_parts(
        bundle_pointer + bundle_tokens_base(unit_count) * 4,
        unit_count * BUNDLE_TOKEN_CAP);
    let record_catalog:[i32] = verified::host::i32_slice_from_raw_parts(
        bundle_pointer + bundle_records_base(unit_count) * 4,
        unit_count * BUNDLE_RECORD_CAP);
    let offsets_catalog:[i32] = verified::host::i32_slice_from_raw_parts(
        bundle_pointer + bundle_offsets_base(unit_count) * 4,
        unit_count * BUNDLE_OFFSETS_CAP);
    let type_arena_catalog:[i32] = verified::host::i32_slice_from_raw_parts(
        bundle_pointer + bundle_types_base(unit_count) * 4,
        unit_count * BUNDLE_TYPE_CAP);
    let resolution_catalog:[i32] = verified::host::i32_slice_from_raw_parts(
        bundle_pointer + bundle_resolutions_base(unit_count) * 4,
        unit_count * BUNDLE_RESOLUTION_CAP);
    let value_catalog:[i32] = verified::host::i32_slice_from_raw_parts(
        bundle_pointer + bundle_values_base(unit_count) * 4,
        unit_count * BUNDLE_VALUE_CAP);
    let alias_catalog:[i32] = verified::host::i32_slice_from_raw_parts(
        bundle_pointer + bundle_aliases_base(unit_count) * 4,
        unit_count * BUNDLE_ALIAS_CAP);
    let declarations:[i32] = verified::host::i32_slice_from_raw_parts(
        declarations_pointer, unit_count * BUNDLE_DECL_CAP);
    let allocated:[i32] = verified::host::i32_slice_from_raw_parts(
        allocated_pointer, unit_count * BUNDLE_DECL_CAP);
    let signature_output:[i32] = verified::host::i32_slice_from_raw_parts(
        signature_output_pointer, unit_count * BUNDLE_SIGNATURE_CAP);
    let signature_catalog:[i32] = verified::host::i32_slice_from_raw_parts(
        signature_catalog_pointer, unit_count * BUNDLE_SIGNATURE_CAP);
    let transport_descriptors:[i32] = verified::host::i32_slice_from_raw_parts(
        transport_pointer, unit_count * 8);
    let body_catalog:[i32] = verified::host::i32_slice_from_raw_parts(
        body_catalog_pointer, unit_count * BUNDLE_BODY_CAP);
    let status:[i32] = verified::host::i32_slice_from_raw_parts(status_pointer, 5);
    if (status[2] <= lowering::signatures::HEADER - 1
        || signature_output[0] != lowering::signatures::VERSION
        || signature_output[2] != status[2]) { return -1; }
    let value_scratch_memory:ptr = verified::host::alloc(BUNDLE_VALUE_CAP * 4, 4);
    let source_scratch_memory:ptr = verified::host::alloc(BUNDLE_SOURCE_CAP * 4, 4);
    let token_scratch_memory:ptr = verified::host::alloc(BUNDLE_TOKEN_CAP * 4, 4);
    let record_scratch_memory:ptr = verified::host::alloc(BUNDLE_RECORD_CAP * 4, 4);
    let offsets_scratch_memory:ptr = verified::host::alloc(BUNDLE_OFFSETS_CAP * 4, 4);
    let type_scratch_memory:ptr = verified::host::alloc(BUNDLE_TYPE_CAP * 4, 4);
    let resolution_scratch_memory:ptr = verified::host::alloc(BUNDLE_RESOLUTION_CAP * 4, 4);
    let expression_memory:ptr = verified::host::alloc(262144 * 4, 4);
    let type_output_memory:ptr = verified::host::alloc(65536 * 4, 4);
    let body_scratch_memory:ptr = verified::host::alloc(BUNDLE_BODY_CAP * 4, 4);
    let alias_scratch_memory:ptr = verified::host::alloc(BUNDLE_ALIAS_CAP * 4, 4);
    let alias_work_memory:ptr = verified::host::alloc(BUNDLE_ALIAS_CAP * 4, 4);
    if (value_scratch_memory == 0 || source_scratch_memory == 0
        || token_scratch_memory == 0 || record_scratch_memory == 0
        || offsets_scratch_memory == 0 || type_scratch_memory == 0
        || resolution_scratch_memory == 0 || expression_memory == 0
        || type_output_memory == 0 || body_scratch_memory == 0
        || alias_scratch_memory == 0 || alias_work_memory == 0) { return -1; }
    let value_scratch:[i32] = verified::host::i32_slice_from_raw_parts(
        value_scratch_memory, BUNDLE_VALUE_CAP);
    let source_scratch:[i32] = verified::host::i32_slice_from_raw_parts(
        source_scratch_memory, BUNDLE_SOURCE_CAP);
    let token_scratch:[i32] = verified::host::i32_slice_from_raw_parts(
        token_scratch_memory, BUNDLE_TOKEN_CAP);
    let record_scratch:[i32] = verified::host::i32_slice_from_raw_parts(
        record_scratch_memory, BUNDLE_RECORD_CAP);
    let offsets_scratch:[i32] = verified::host::i32_slice_from_raw_parts(
        offsets_scratch_memory, BUNDLE_OFFSETS_CAP);
    let type_scratch:[i32] = verified::host::i32_slice_from_raw_parts(
        type_scratch_memory, BUNDLE_TYPE_CAP);
    let resolution_scratch:[i32] = verified::host::i32_slice_from_raw_parts(
        resolution_scratch_memory, BUNDLE_RESOLUTION_CAP);
    let expression_arena:[i32] = verified::host::i32_slice_from_raw_parts(
        expression_memory, 262144);
    let type_output:[i32] = verified::host::i32_slice_from_raw_parts(
        type_output_memory, 65536);
    let body_scratch:[i32] = verified::host::i32_slice_from_raw_parts(
        body_scratch_memory, BUNDLE_BODY_CAP);
    let alias_scratch:[i32] = verified::host::i32_slice_from_raw_parts(
        alias_scratch_memory, BUNDLE_ALIAS_CAP);
    let alias_work:[i32] = verified::host::i32_slice_from_raw_parts(
        alias_work_memory, BUNDLE_ALIAS_CAP);
    let global_declaration_words: i32 = lowering::declarations::HEADER
        + allocated[1] * lowering::declarations::ROW;
    let unit: i32 = 0;
    while (unit < unit_count) {
        let context: i32 = unit * 16;
        let values:[i32] = verified::host::i32_slice_from_raw_parts(
            bundle_pointer + (bundle_values_base(unit_count)
                + unit * BUNDLE_VALUE_CAP) * 4, BUNDLE_VALUE_CAP);
        let value_words: i32 = build_value_catalog(unit, contexts,
            source_catalog, token_catalog, allocated, status[1], values,
            BUNDLE_VALUE_CAP);
        if (value_words <= -1) { return -1; }
        contexts[context + 15] = value_words;
        let descriptor: i32 = unit * 8;
        transport_descriptors[descriptor] = contexts[context];
        transport_descriptors[descriptor + 1] = contexts[context + 1];
        transport_descriptors[descriptor + 2] = contexts[context + 2];
        transport_descriptors[descriptor + 3] = contexts[context + 3];
        transport_descriptors[descriptor + 6] = 0;
        transport_descriptors[descriptor + 7] = 0;
        unit += 1;
    }
    let partition_scratch_memory:ptr = verified::host::alloc(unit_count * 3 * 4, 4);
    if (partition_scratch_memory == 0) { return -1; }
    let partition_scratch:[i32] = verified::host::i32_slice_from_raw_parts(
        partition_scratch_memory, unit_count * 3);
    let signature_words: i32 = partition_signatures(signature_output,
        status[2], allocated, status[1], unit_count, transport_descriptors,
        signature_catalog, unit_count * BUNDLE_SIGNATURE_CAP,
        partition_scratch, unit_count * 3);
    if (signature_words <= lowering::signatures::HEADER - 1) { return -1; }
    let body_words: i32 = lowering::body_units::lower_units_owned(
        descriptors, unit_count * 4, unit_count, contexts, unit_count * 16,
        transport_descriptors, unit_count * 8, declaration_catalog,
        unit_count * BUNDLE_DECL_CAP, declarations, global_declaration_words, source_catalog,
        unit_count * BUNDLE_SOURCE_CAP, token_catalog,
        unit_count * BUNDLE_TOKEN_CAP, record_catalog,
        unit_count * BUNDLE_RECORD_CAP, offsets_catalog,
        unit_count * BUNDLE_OFFSETS_CAP, type_arena_catalog,
        unit_count * BUNDLE_TYPE_CAP, resolution_catalog,
        unit_count * BUNDLE_RESOLUTION_CAP, value_catalog,
        unit_count * BUNDLE_VALUE_CAP, signature_catalog,
        unit_count * BUNDLE_SIGNATURE_CAP, signature_output, status[2],
        allocated, status[1], source_scratch, BUNDLE_SOURCE_CAP,
        token_scratch, BUNDLE_TOKEN_CAP, record_scratch, BUNDLE_RECORD_CAP,
        offsets_scratch, BUNDLE_OFFSETS_CAP, type_scratch, BUNDLE_TYPE_CAP,
        resolution_scratch, BUNDLE_RESOLUTION_CAP, value_scratch, BUNDLE_VALUE_CAP,
        expression_arena, 262144, type_output, 65536, body_scratch,
        BUNDLE_BODY_CAP, body_catalog, unit_count * BUNDLE_BODY_CAP,
        alias_catalog, unit_count * BUNDLE_ALIAS_CAP, alias_scratch,
        BUNDLE_ALIAS_CAP, alias_work, BUNDLE_ALIAS_CAP);
    if (body_words <= lowering::bodies::HEADER) { return body_words; }
    status[3] = signature_words;
    status[4] = body_words;
    return 0;
}

// Authoritative multi-unit lowering entrypoint. The bundle contains only
// authenticated lexer/parser outputs; declaration, alias, allocation, value,
// signature, body, and transport tables are rebuilt here in unit order.
pub fn lower_units_raw(bundle_pointer:ptr, unit_count:i32,
    output_pointer:ptr) -> i32 {
    if (unit_count <= 0 || unit_count > BUNDLE_UNIT_LIMIT
        || bundle_words(unit_count) <= 0) { return -1; }
    let declarations_memory:ptr = verified::host::alloc(
        unit_count * BUNDLE_DECL_CAP * 4, 4);
    let modules_memory:ptr = verified::host::alloc(
        unit_count * BUNDLE_MODULE_CAP * 4, 4);
    let allocated_memory:ptr = verified::host::alloc(
        unit_count * BUNDLE_DECL_CAP * 4, 4);
    let signature_output_memory:ptr = verified::host::alloc(
        unit_count * BUNDLE_SIGNATURE_CAP * 4, 4);
    let signature_catalog_memory:ptr = verified::host::alloc(
        unit_count * BUNDLE_SIGNATURE_CAP * 4, 4);
    let transport_memory:ptr = verified::host::alloc(unit_count * 8 * 4, 4);
    let body_catalog_memory:ptr = verified::host::alloc(
        unit_count * BUNDLE_BODY_CAP * 4, 4);
    let status_memory:ptr = verified::host::alloc(20, 4);
    if (declarations_memory == 0 || modules_memory == 0 || allocated_memory == 0
        || signature_output_memory == 0 || signature_catalog_memory == 0
        || transport_memory == 0 || body_catalog_memory == 0
        || status_memory == 0) { return -1; }
    let prepare_status: i32 = prepare_catalogs_raw(bundle_pointer, unit_count,
        declarations_memory, modules_memory, allocated_memory, status_memory);
    if (prepare_status != 0) { return prepare_status; }
    let signature_status: i32 = lower_signatures_raw(bundle_pointer, unit_count, declarations_memory,
            allocated_memory, signature_output_memory, status_memory);
    if (signature_status != 0) { return signature_status; }
    let body_status: i32 = lower_bodies_raw(bundle_pointer, unit_count,
        declarations_memory, allocated_memory, signature_output_memory,
        signature_catalog_memory, transport_memory, body_catalog_memory,
        status_memory);
    if (body_status != 0) { return body_status; }
    let source_catalog:[i32] = verified::host::i32_slice_from_raw_parts(
        bundle_pointer + bundle_sources_base(unit_count) * 4,
        unit_count * BUNDLE_SOURCE_CAP);
    let token_catalog:[i32] = verified::host::i32_slice_from_raw_parts(
        bundle_pointer + bundle_tokens_base(unit_count) * 4,
        unit_count * BUNDLE_TOKEN_CAP);
    let declarations:[i32] = verified::host::i32_slice_from_raw_parts(
        declarations_memory, unit_count * BUNDLE_DECL_CAP);
    let allocated:[i32] = verified::host::i32_slice_from_raw_parts(
        allocated_memory, unit_count * BUNDLE_DECL_CAP);
    let signature_catalog:[i32] = verified::host::i32_slice_from_raw_parts(
        signature_catalog_memory, unit_count * BUNDLE_SIGNATURE_CAP);
    let body_catalog:[i32] = verified::host::i32_slice_from_raw_parts(
        body_catalog_memory, unit_count * BUNDLE_BODY_CAP);
    let transport_descriptors:[i32] = verified::host::i32_slice_from_raw_parts(
        transport_memory, unit_count * 8);
    let status:[i32] = verified::host::i32_slice_from_raw_parts(status_memory, 5);
    allocated[3] = 0;
    let global_declaration_words: i32 = lowering::declarations::HEADER
        + allocated[1] * lowering::declarations::ROW;
    let output:[i32] = verified::host::i32_slice_from_raw_parts(
        output_pointer, 262144);
    let final_words: i32 = lowering::transport::lower_multi(source_catalog,
        unit_count * BUNDLE_SOURCE_CAP, token_catalog,
        unit_count * BUNDLE_TOKEN_CAP, transport_descriptors, unit_count * 8,
        unit_count, declarations, global_declaration_words, allocated, status[1],
        signature_catalog, status[3], body_catalog, status[4], output, 262144);
    if (final_words <= lowering::transport::HEADER - 1) { return final_words; }
    return final_words;
}


// Authoritative native handoff for one source unit. All structured lowering
// results remain inside this module; the entry point receives only the source
// tree slices and a caller-owned canonical transport buffer. N=1 uses the
// multi-unit transport validator and emitter, so the production path does not
// have a separate one-unit transport format.
pub fn lower(source:[i32], source_length: i32, tokens:[i32], token_count: i32,
    records:[i32], record_length: i32, offsets:[i32], offsets_length: i32,
    node_count: i32, root: i32, output:[i32], capacity: i32) -> i32 {
    if (capacity <= lowering::transport::HEADER - 1) { return -1; }
    let type_arena_memory: ptr = verified::host::alloc(1048576, 4);
    let type_output_memory: ptr = verified::host::alloc(262144, 4);
    let alias_catalog_memory: ptr = verified::host::alloc(262144, 4);
    let alias_work_memory: ptr = verified::host::alloc(262144, 4);
    let alias_stack_memory: ptr = verified::host::alloc(262144, 4);
    let alias_scratch_memory: ptr = verified::host::alloc(262144, 4);
    let alias_result_memory: ptr = verified::host::alloc(16, 4);
    let declarations_memory: ptr = verified::host::alloc(262144, 4);
    let modules_memory: ptr = verified::host::alloc(262144, 4);
    let allocated_memory: ptr = verified::host::alloc(262144, 4);
    let signatures_memory: ptr = verified::host::alloc(1048576, 4);
    let bodies_memory: ptr = verified::host::alloc(4194304, 4);
    let result_memory: ptr = verified::host::alloc(40, 4);
    let descriptor_memory: ptr = verified::host::alloc(32, 4);
    if (type_arena_memory == 0 || type_output_memory == 0
        || alias_catalog_memory == 0 || alias_work_memory == 0
        || alias_stack_memory == 0 || alias_scratch_memory == 0
        || alias_result_memory == 0 || declarations_memory == 0
        || modules_memory == 0 || allocated_memory == 0
        || signatures_memory == 0 || bodies_memory == 0
        || result_memory == 0 || descriptor_memory == 0) { return -1; }
    let type_arena:[i32] = verified::host::i32_slice_from_raw_parts(type_arena_memory, 262144);
    let type_output:[i32] = verified::host::i32_slice_from_raw_parts(type_output_memory, 65536);
    let alias_catalog:[i32] = verified::host::i32_slice_from_raw_parts(alias_catalog_memory, 65536);
    let alias_work:[i32] = verified::host::i32_slice_from_raw_parts(alias_work_memory, 65536);
    let alias_stack:[i32] = verified::host::i32_slice_from_raw_parts(alias_stack_memory, 65536);
    let alias_scratch:[i32] = verified::host::i32_slice_from_raw_parts(alias_scratch_memory, 65536);
    let alias_result:[i32] = verified::host::i32_slice_from_raw_parts(alias_result_memory, 4);
    let declarations:[i32] = verified::host::i32_slice_from_raw_parts(declarations_memory, 65536);
    let modules:[i32] = verified::host::i32_slice_from_raw_parts(modules_memory, 65536);
    let allocated:[i32] = verified::host::i32_slice_from_raw_parts(allocated_memory, 65536);
    let signatures:[i32] = verified::host::i32_slice_from_raw_parts(signatures_memory, 262144);
    let bodies:[i32] = verified::host::i32_slice_from_raw_parts(bodies_memory, 1048576);
    let result:[i32] = verified::host::i32_slice_from_raw_parts(result_memory, 10);
    let semantic_root: i32 = lowering::semantic::prepare(source, source_length,
        tokens, token_count, records, record_length, offsets, node_count, root,
        declarations, 65536, type_arena, 262144, alias_catalog, 65536,
        alias_work, 65536, alias_stack, 65536, alias_scratch, 65536,
        alias_result, 4, type_output, 65536, 1048576);
    if (semantic_root <= -1) { return -1; }
    let lowered_stage: i32 = lowering::program::program_into(source, source_length, tokens,
        token_count, records, record_length, offsets, offsets_length, node_count,
        root, 0, type_arena, 262144, semantic_root, type_output, 0,
        alias_catalog, 65536, alias_work, 65536, alias_stack, 65536,
        alias_scratch, 65536, alias_result, 4, declarations, 65536, modules,
        65536, type_output, 65536, allocated, 65536, signatures, 262144,
        bodies, 1048576, output, capacity, result, 10);
    if (lowered_stage != lowering::program::SUCCESS) { return -1; }
    let descriptor:[i32] = verified::host::i32_slice_from_raw_parts(descriptor_memory, 8);
    descriptor[0] = 0;
    descriptor[1] = source_length;
    descriptor[2] = 0;
    descriptor[3] = token_count;
    descriptor[4] = 0;
    descriptor[5] = result[6];
    descriptor[6] = 0;
    descriptor[7] = result[7];
    let words: i32 = lowering::transport::lower_multi(source, source_length,
        tokens, token_count * 3, descriptor, 8, 1, declarations,
        result[2], allocated, result[5], signatures, result[6], bodies,
        result[7], output, capacity);
    if (words <= lowering::transport::HEADER - 1) { return -1; }
    return words;
}

// Native entrypoints use this bounded pointer ABI; keeping reconstruction at
// the authoritative handoff avoids importing a slice-valued lowering call.
pub fn lower_raw(source_pointer: ptr, source_length: i32, tokens_pointer: ptr,
    token_count: i32, records_pointer: ptr, record_length: i32,
    offsets_pointer: ptr, node_count: i32, root: i32, output_pointer: ptr,
    capacity: i32) -> i32 {
    let source:[i32] = verified::host::i32_slice_from_raw_parts(source_pointer, 65536);
    let tokens:[i32] = verified::host::i32_slice_from_raw_parts(tokens_pointer, 65536);
    let records:[i32] = verified::host::i32_slice_from_raw_parts(records_pointer, 1048576);
    let offsets:[i32] = verified::host::i32_slice_from_raw_parts(offsets_pointer, BUNDLE_OFFSETS_CAP);
    let output:[i32] = verified::host::i32_slice_from_raw_parts(output_pointer, capacity);
    return lower(source, source_length, tokens, token_count, records, record_length,
        offsets, BUNDLE_OFFSETS_CAP, node_count, root, output, capacity);
}

// Owned native descriptor boundary.  The workspace is laid out in canonical
// source/token/record/offset order, so the application crosses this module
// with six scalar arguments while all phase validation remains in `lower`.
pub fn lower_owned_raw(source_pointer: ptr, tokens_pointer: ptr,
    records_pointer: ptr, offsets_pointer: ptr, metadata_pointer: ptr,
    output_pointer: ptr) -> i32 {
    let source:[i32] = verified::host::i32_slice_from_raw_parts(source_pointer, 65536);
    let tokens:[i32] = verified::host::i32_slice_from_raw_parts(tokens_pointer, 65536);
    let records:[i32] = verified::host::i32_slice_from_raw_parts(records_pointer, 1048576);
    let offsets:[i32] = verified::host::i32_slice_from_raw_parts(offsets_pointer, BUNDLE_OFFSETS_CAP);
    let metadata:[i32] = verified::host::i32_slice_from_raw_parts(metadata_pointer, 7);
    let output:[i32] = verified::host::i32_slice_from_raw_parts(output_pointer, 262144);
    let source_length: i32 = metadata[0];
    let token_count: i32 = metadata[1];
    let node_count: i32 = metadata[2];
    if (source_length <= -1 || token_count <= -1 || node_count <= 0) { return -1; }
    return lower(source, source_length, tokens, token_count, records, 1048576,
        offsets, BUNDLE_OFFSETS_CAP, node_count, node_count - 1, output, 262144);
}
