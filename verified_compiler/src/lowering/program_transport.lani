module lowering::program_transport;

import lowering::allocation;
import lowering::error;
import lowering::transport;
import lowering::aliases;
import lowering::body_units;
import lowering::ir_catalogs;
import lowering::ir_names;
import ir::body_catalog;
import ir::function_catalog;
import ir::program;
import ir::symbol_catalog;
import ir::body_events;
import verified::surface_expr;
import lowering::value_catalog;
import lowering::declarations;
import lowering::modules;
import lowering::resolution_catalog;
import lowering::constant_catalog;
import lowering::signature_index;
import lowering::signature_producer;
import lowering::signatures;
import lowering::units;
import lowering::types;
import lowering::unit_descriptor;
import lowering::unit_context;
import lowering::value_collection;
import verified::host;
import verified::core_transport;
import verified::extraction;
import verified::surface_type;
import verified::syntax_tree;
import verified::token;

// The native compiler owns one bounded catalog allocation. Its layout is
// private storage policy; stages exchange typed tables and slices, not a
// serialized bundle header or offsets into an i32 protocol.
// Per-unit lengths live in a typed section ahead of descriptors. Keeping
// them separate is essential: descriptor/context slots are written while
// catalogs are prepared and must never alias another unit's lengths.
const METADATA_FIELD_BYTES: i32 = 8;
pub const BUNDLE_ALIGNMENT: i32 = METADATA_FIELD_BYTES;
const METADATA_FIELD_COUNT: i32 = 3;
const METADATA_RECORD_BYTES: i32 =
    METADATA_FIELD_COUNT * METADATA_FIELD_BYTES;
const METADATA_RECORD_WORDS: i32 =
    METADATA_RECORD_BYTES / verified::host::I32_BYTES;

struct UnitMetadata {
    source_length: i32,
    token_count: i32,
    node_count: i32,
}

fn metadata_view(memory: ptr, unit_count: i32) -> [UnitMetadata] {
    let first: ptr = memory;
    if (unit_count > 0) {
        first = first + unit_count * METADATA_RECORD_BYTES
            - METADATA_FIELD_BYTES;
    }
    return slice_from_raw_parts(first, unit_count);
}
pub const BUNDLE_UNIT_LIMIT: i32 = 128;
const CATALOG_WORD_BUDGET: i32 = 65536;
// A native i32 field occupies an eight-byte slot. Each catalog gets the
// same row budget it had when its fields occupied packed four-byte words.
pub const BUNDLE_DECL_CAP: i32 = CATALOG_WORD_BUDGET
    * lowering::declarations::ALIGNMENT / verified::host::I32_BYTES;
pub const BUNDLE_ALLOCATION_CAP: i32 = CATALOG_WORD_BUDGET
    * lowering::allocation::ALIGNMENT / verified::host::I32_BYTES;
pub const BUNDLE_SOURCE_CAP: i32 = 65536;
// Extraction bounds the canonical token buffer in packed words. Native
// lowering needs at most that many complete token rows per source unit.
pub const BUNDLE_TOKEN_CAP: i32 =
    verified::token::TOKEN_WORD_CAPACITY / verified::token::ROW_WORDS;
const BUNDLE_TOKEN_STORAGE_WORDS: i32 = BUNDLE_TOKEN_CAP
    * verified::token::RECORD_BYTES / verified::host::I32_BYTES;
// One reusable type arena has room for 8191 native nodes and its count.
// Semantic result storage needs one typed entry per possible arena node.
const TYPE_ARENA_WORK_WORD_CAP: i32 = 65536;
const TYPE_ARENA_NODE_CAPACITY: i32 =
    (TYPE_ARENA_WORK_WORD_CAP * verified::host::I32_BYTES
        - verified::surface_type::COUNT_BYTES)
        / verified::surface_type::NODE_BYTES;
pub const BUNDLE_VALUE_ROW_CAP: i32 = 10922;
const BUNDLE_VALUE_WORD_CAP: i32 = BUNDLE_VALUE_ROW_CAP
    * lowering::value_catalog::RECORD_BYTES / verified::host::I32_BYTES;
const BUNDLE_ALIAS_WORK_RECORDS: i32 =
    BUNDLE_DECL_CAP / lowering::declarations::ROW;
pub const BUNDLE_RESOLUTION_ROW_CAP: i32 = 32768;
const BUNDLE_RESOLUTION_WORD_CAP: i32 = BUNDLE_RESOLUTION_ROW_CAP
    * lowering::types::RESOLUTION_RECORD_BYTES / verified::host::I32_BYTES;
const BODY_EVENT_CAPACITY: i32 = 1048576;
pub const BUNDLE_TRANSPORT_CAP: i32 = 262144;
// Preserve the previous arena's node capacity when moving from seven-word
// records to typed expression nodes.
const EXPRESSION_NODE_CAPACITY: i32 =
    BUNDLE_TRANSPORT_CAP / verified::surface_expr::NODE_FIELDS;
const CONSTANT_EXPRESSION_NODE_CAPACITY: i32 = 131072;
const STATUS_FIELD_BYTES: i32 = 8;
const STATUS_FIELD_COUNT: i32 = 2;
const STATUS_RECORD_BYTES: i32 = STATUS_FIELD_COUNT * STATUS_FIELD_BYTES;

struct PipelineStatus {
    declaration_words: i32,
    allocation_words: i32,
}

fn status_view(memory: ptr) -> [PipelineStatus] {
    // Aggregate fields descend from the first word, which is inside—not
    // immediately after—the allocated record.
    let first: ptr = memory + STATUS_RECORD_BYTES - STATUS_FIELD_BYTES;
    return slice_from_raw_parts(first, 1);
}

pub struct WordRegion {
    data: [i32],
    words: i32,
}

pub fn region(data: [i32], words: i32) -> WordRegion {
    return WordRegion { data: data, words: words };
}

pub struct NativeUnit {
    source: WordRegion,
    token_count: i32,
    tree: verified::syntax_tree::Tree,
}

pub fn native_token_storage(bundle: Bundle, unit: i32)
    -> verified::token::TokenTable {
    if (unit <= -1 || unit >= bundle.unit_count) {
        return verified::token::from_raw_parts(0, 0);
    }
    return verified::token::subtable(bundle.tokens,
        unit * BUNDLE_TOKEN_CAP, BUNDLE_TOKEN_CAP);
}

pub struct Bundle {
    unit_count: i32,
    metadata: [UnitMetadata],
    trees: verified::syntax_tree::Catalog,
    descriptors: lowering::declarations::Catalog,
    contexts: lowering::unit_context::Table,
    declaration_storage: ptr,
    sources: [i32],
    tokens: verified::token::TokenTable,
    values: lowering::value_catalog::ValueTable,
    value_storage: ptr,
    aliases: lowering::aliases::Table,
    resolutions: lowering::types::ResolutionTable,
}

fn bundle_trees_base(unit_count: i32) -> i32 {
    return unit_count * METADATA_RECORD_WORDS;
}
fn bundle_descriptors_base(unit_count: i32) -> i32 {
    return bundle_trees_base(unit_count)
        + unit_count * verified::syntax_tree::TREE_BYTES
            / verified::host::I32_BYTES;
}
fn tree_catalog(memory: ptr, unit_count: i32)
    -> verified::syntax_tree::Catalog {
    let tree_memory: ptr = memory
        + bundle_trees_base(unit_count) * verified::host::I32_BYTES;
    return verified::syntax_tree::catalog_from_raw_parts(
        tree_memory, unit_count);
}
fn bundle_contexts_base(unit_count: i32) -> i32 {
    return bundle_descriptors_base(unit_count)
        + unit_count * (lowering::declarations::TABLE_REF_BYTES
            / verified::host::I32_BYTES);
}

fn catalog_contexts(memory: ptr, unit_count: i32)
    -> lowering::unit_context::Table {
    let context_memory: ptr = memory
        + bundle_contexts_base(unit_count) * verified::host::I32_BYTES;
    return lowering::unit_context::from_raw_parts(context_memory,
        unit_count);
}

fn catalog_units(memory: ptr, unit_count: i32)
    -> lowering::declarations::Catalog {
    let unit_memory: ptr = memory
        + bundle_descriptors_base(unit_count) * verified::host::I32_BYTES;
    return lowering::declarations::catalog_from_raw_parts(unit_memory,
        unit_count);
}
fn bundle_declarations_base(unit_count: i32) -> i32 {
    return bundle_contexts_base(unit_count)
        + unit_count * lowering::unit_context::RECORD_WORDS;
}
fn bundle_sources_base(unit_count: i32) -> i32 {
    return bundle_declarations_base(unit_count)
        + unit_count * BUNDLE_DECL_CAP;
}
fn bundle_tokens_base(unit_count: i32) -> i32 {
    return bundle_sources_base(unit_count) + unit_count * BUNDLE_SOURCE_CAP;
}
fn bundle_values_base(unit_count: i32) -> i32 {
    return bundle_tokens_base(unit_count)
        + unit_count * BUNDLE_TOKEN_STORAGE_WORDS;
}
fn bundle_aliases_base(unit_count: i32) -> i32 {
    return bundle_values_base(unit_count) + unit_count * BUNDLE_VALUE_WORD_CAP;
}
fn value_catalog(memory: ptr, unit_count: i32)
    -> lowering::value_catalog::ValueTable {
    let value_memory: ptr = memory
        + bundle_values_base(unit_count) * verified::host::I32_BYTES;
    return lowering::value_catalog::from_raw_parts(value_memory,
        unit_count * BUNDLE_VALUE_ROW_CAP);
}
fn bundle_resolutions_base(unit_count: i32) -> i32 {
    return bundle_aliases_base(unit_count)
        + unit_count * lowering::aliases::CATALOG_RECORD_BYTES
            / verified::host::I32_BYTES;
}
fn alias_catalog(memory: ptr, unit_count: i32)
    -> lowering::aliases::Table {
    let alias_memory: ptr = memory
        + bundle_aliases_base(unit_count) * verified::host::I32_BYTES;
    return lowering::aliases::from_raw_parts(alias_memory, unit_count);
}
fn resolution_catalog(memory: ptr, unit_count: i32)
    -> lowering::types::ResolutionTable {
    let resolution_memory: ptr = memory
        + bundle_resolutions_base(unit_count) * verified::host::I32_BYTES;
    return lowering::types::from_raw_parts(resolution_memory,
        unit_count * BUNDLE_RESOLUTION_ROW_CAP,
        lowering::types::IdentifierToken);
}
pub fn bundle_words(unit_count: i32) -> i32 {
    if (unit_count <= 0 || unit_count > BUNDLE_UNIT_LIMIT) { return -1; }
    return bundle_resolutions_base(unit_count)
        + unit_count * BUNDLE_RESOLUTION_WORD_CAP;
}

pub fn from_raw_parts(memory: ptr, unit_count: i32) -> Bundle {
    let metadata: [UnitMetadata] = metadata_view(memory, unit_count);
    let unit: i32 = 0;
    while (unit < unit_count) {
        metadata[unit] = UnitMetadata {
            source_length: -1,
            token_count: -1,
            node_count: -1,
        };
        unit += 1;
    }
    let declaration_storage: ptr = memory
        + bundle_declarations_base(unit_count) * verified::host::I32_BYTES;
    let value_storage: ptr = memory
        + bundle_values_base(unit_count) * verified::host::I32_BYTES;
    let token_storage: ptr = memory
        + bundle_tokens_base(unit_count) * verified::host::I32_BYTES;
    return Bundle {
        unit_count: unit_count,
        metadata: metadata,
        trees: tree_catalog(memory, unit_count),
        descriptors: catalog_units(memory, unit_count),
        contexts: catalog_contexts(memory, unit_count),
        declaration_storage: declaration_storage,
        sources: verified::host::i32_slice_from_raw_parts(memory
            + bundle_sources_base(unit_count) * verified::host::I32_BYTES,
            unit_count * BUNDLE_SOURCE_CAP),
        tokens: verified::token::from_raw_parts(token_storage,
            unit_count * BUNDLE_TOKEN_CAP),
        values: value_catalog(memory, unit_count),
        value_storage: value_storage,
        aliases: alias_catalog(memory, unit_count),
        resolutions: resolution_catalog(memory, unit_count),
    };
}

fn append_tree_and_source(bundle: Bundle, unit: i32,
    source: WordRegion, token_count: i32,
    tree: verified::syntax_tree::Tree) -> bool {
    let source_data: [i32] = source.data;
    let source_words: i32 = source.words;
    if (bundle.unit_count <= 0 || bundle.unit_count > BUNDLE_UNIT_LIMIT
        || unit <= -1 || unit >= bundle.unit_count
        || source_words <= -1 || source_words > BUNDLE_SOURCE_CAP
        || token_count <= -1
        || token_count > BUNDLE_TOKEN_CAP
        || tree.node_count <= 0
        || tree.node_count > verified::extraction::PARSE_NODE_CAPACITY) {
        return false;
    }
    let source_base: i32 = unit * BUNDLE_SOURCE_CAP;
    let source_catalog: [i32] = bundle.sources;
    let word: i32 = 0;
    while (word != source_words) {
        source_catalog[source_base + word] = source_data[word];
        word += 1;
    }
    let trees: [verified::syntax_tree::Tree] = bundle.trees.data;
    trees[unit] = tree;
    let metadata: [UnitMetadata] = bundle.metadata;
    metadata[unit].source_length = source_words;
    metadata[unit].token_count = token_count;
    metadata[unit].node_count = tree.node_count;
    return true;
}

pub fn append_native_unit(bundle: Bundle, unit: i32,
    parsed: NativeUnit) -> bool {
    return append_tree_and_source(bundle, unit, parsed.source,
        parsed.token_count, parsed.tree);
}

fn prepare_catalogs(bundle: Bundle,
    declarations_pointer:ptr, allocated_pointer:ptr,
    status_pointer:ptr) -> i32 {
    let unit_count: i32 = bundle.unit_count;
    let metadata: [UnitMetadata] = bundle.metadata;
    let descriptor_table: lowering::declarations::Catalog =
        bundle.descriptors;
    let context_table: lowering::unit_context::Table =
        bundle.contexts;
    let contexts: [lowering::unit_context::UnitContext] =
        context_table.data;
    let source_catalog: [i32] = bundle.sources;
    let token_catalog: verified::token::TokenTable = bundle.tokens;
    let trees: [verified::syntax_tree::Tree] = bundle.trees.data;
    let alias_catalog: lowering::aliases::Table = bundle.aliases;
    let alias_work_bytes: usize = BUNDLE_ALIAS_WORK_RECORDS
        * lowering::aliases::WORK_RECORD_BYTES;
    let alias_work_alignment: usize = lowering::aliases::WORK_ALIGNMENT;
    let alias_work_memory:ptr = verified::host::alloc(
        alias_work_bytes, alias_work_alignment);
    let alias_stack_memory:ptr = verified::host::alloc_i32(
        BUNDLE_ALIAS_WORK_RECORDS);
    let alias_scratch_memory:ptr = verified::host::alloc(
        BUNDLE_TOKEN_CAP * verified::host::I32_BYTES,
        lowering::aliases::SYMBOL_ALIGNMENT);
    let alias_result_memory:ptr = verified::host::alloc(
        lowering::aliases::RESOLUTION_RECORD_BYTES,
        lowering::aliases::WORK_ALIGNMENT);
    // Surface type nodes are extraction scratch, not per-unit catalog data.
    // Each extraction resets its count, so one workspace serves every unit.
    let type_arena_memory:ptr = verified::host::alloc(
        verified::surface_type::allocation_bytes(TYPE_ARENA_NODE_CAPACITY),
        verified::surface_type::ALIGNMENT);
    if (alias_work_memory == 0 || alias_stack_memory == 0
        || alias_scratch_memory == 0 || alias_result_memory == 0
        || type_arena_memory == 0) { return -1; }
    let alias_stack:[i32] = verified::host::i32_slice_from_raw_parts(
        alias_stack_memory, BUNDLE_ALIAS_WORK_RECORDS);
    let alias_scratch:[i32] = verified::host::i32_slice_from_raw_parts(
        alias_scratch_memory, BUNDLE_TOKEN_CAP);
    let type_arena: verified::surface_type::TypeArena =
        verified::surface_type::from_raw_parts(type_arena_memory,
            TYPE_ARENA_NODE_CAPACITY);
    let unit: i32 = 0;
    while (unit < unit_count) {
        let source_length: i32 = metadata[unit].source_length;
        let token_count: i32 = metadata[unit].token_count;
        let nodes_in_unit: i32 = metadata[unit].node_count;
        if (source_length <= -1 || source_length > BUNDLE_SOURCE_CAP
            || token_count <= -1
            || token_count > BUNDLE_TOKEN_CAP) {
            return -1;
        }
        if (nodes_in_unit <= 0
            || nodes_in_unit > verified::extraction::PARSE_NODE_CAPACITY) {
            return -1;
        }
        let source:[i32] = verified::host::i32_slice_from_raw_parts(
            verified::host::i32_slice_data_ptr(source_catalog)
                + unit * BUNDLE_SOURCE_CAP * verified::host::I32_BYTES,
            BUNDLE_SOURCE_CAP);
        let tokens: verified::token::TokenTable = verified::token::subtable(
            token_catalog, unit * BUNDLE_TOKEN_CAP, BUNDLE_TOKEN_CAP);
        let tree: verified::syntax_tree::Tree = trees[unit];
        if (tree.node_count != nodes_in_unit) { return -1; }
        let declaration_memory: ptr = bundle.declaration_storage
            + unit * BUNDLE_DECL_CAP * verified::host::I32_BYTES;
        let declaration_input: lowering::declarations::DeclarationInput =
            lowering::declarations::DeclarationInput {
                tree: tree,
                token_count: token_count,
                root: nodes_in_unit - 1,
                unit: unit,
            };
        let declaration_output: lowering::declarations::Table =
            lowering::declarations::from_raw_parts(declaration_memory,
                (BUNDLE_DECL_CAP - lowering::declarations::HEADER)
                    / lowering::declarations::ROW);
        let declaration_words: i32 = lowering::declarations::collect(
            declaration_input, declaration_output);
        if (declaration_words <= lowering::declarations::HEADER
            || declaration_words > BUNDLE_DECL_CAP) { return -1; }
        let declaration_table: lowering::declarations::Table =
            lowering::declarations::from_raw_parts(declaration_memory,
                (declaration_words - lowering::declarations::HEADER)
                    / lowering::declarations::ROW);
        let module_input: lowering::modules::ModuleInput =
            lowering::modules::ModuleInput {
                tokens: verified::token::subtable(tokens, 0, token_count),
                source_length: source_length,
                tree: tree,
                declarations: declaration_table,
            };
        if (!lowering::modules::validate(module_input)) { return -1; }
        let alias_inputs: lowering::aliases::AliasBuildInputs =
            lowering::aliases::AliasBuildInputs {
                source: lowering::aliases::region(source, source_length),
                tokens: verified::token::subtable(tokens, 0, token_count),
                tree: tree,
                declarations: declaration_table,
                depth: nodes_in_unit,
            };
        let alias_workspace: lowering::aliases::AliasBuildWorkspace =
            lowering::aliases::AliasBuildWorkspace {
                type_arena: type_arena,
                work: lowering::aliases::work_region(alias_work_memory,
                    BUNDLE_ALIAS_WORK_RECORDS),
                stack: lowering::aliases::region(alias_stack,
                    BUNDLE_ALIAS_WORK_RECORDS),
                scratch: lowering::aliases::region(alias_scratch,
                    BUNDLE_TOKEN_CAP),
                result: lowering::aliases::result_region(alias_result_memory),
                output: alias_catalog,
                output_slot: unit,
            };
        let alias_symbols: i32 = lowering::aliases::build(
            alias_inputs, alias_workspace);
        if (alias_symbols <= -1) { return -1; }
        lowering::declarations::catalog_write_table(descriptor_table, unit,
            declaration_table);
        contexts[unit] = lowering::unit_context::UnitContext {
            source_offset: unit * BUNDLE_SOURCE_CAP,
            source_length: source_length,
            token_offset: unit * BUNDLE_TOKEN_CAP,
            token_count: token_count,
            node_count: nodes_in_unit,
            resolution_row_offset: 0,
            resolution_count: 0,
            value_row_offset: unit * BUNDLE_VALUE_ROW_CAP,
            value_count: 0,
            declaration_start: -1,
            declaration_count: 0,
            module_target: -1,
        };
        unit += 1;
    }
    let allocation_output: lowering::allocation::Table =
        lowering::allocation::from_raw_parts(allocated_pointer,
            (unit_count * BUNDLE_ALLOCATION_CAP - lowering::allocation::HEADER)
                / lowering::allocation::ROW);
    let collected = lowering::units::accumulate(descriptor_table,
        allocation_output);
    if (!lowering::units::stage_succeeded(
        lowering::units::units_stage(collected))) { return -1; }
    let status:[PipelineStatus] = status_view(status_pointer);
    // Bodies consume one canonical global declaration table, so materialize
    // it from the authenticated allocation rows after ID assignment.
    let allocation_table: lowering::allocation::Table =
        lowering::allocation::from_raw_parts(allocated_pointer,
            (unit_count * BUNDLE_ALLOCATION_CAP - lowering::allocation::HEADER)
                / lowering::allocation::ROW);
    let total_rows: i32 = lowering::allocation::table_header(
        allocation_table).rows;
    if (total_rows <= 0
        || total_rows > (unit_count * BUNDLE_DECL_CAP - lowering::declarations::HEADER)
            / lowering::declarations::ROW) { return -1; }
    let global_declarations: lowering::declarations::Table =
        lowering::declarations::from_raw_parts(declarations_pointer,
            total_rows);
    let declaration_counts: lowering::declarations::DeclarationCounts =
        lowering::declarations::empty_counts();
    let row: i32 = 0;
    while (row != total_rows) {
        let allocation: lowering::allocation::AllocationRow =
            lowering::allocation::table_row(allocation_table, row);
        let declaration: lowering::declarations::DeclarationRow =
            lowering::allocation::row_source(allocation);
        let owner: i32 = lowering::declarations::row_unit(declaration);
        if (owner <= -1 || owner >= unit_count) { return -1; }
        if (contexts[owner].declaration_count == 0) {
            contexts[owner].declaration_start = row;
        } else {
            if (row != contexts[owner].declaration_start
                    + contexts[owner].declaration_count) {
                return -1;
            }
        }
        contexts[owner].declaration_count += 1;
        lowering::declarations::table_write_row(global_declarations,
            row, declaration);
        let declaration_kind: lowering::declarations::DeclarationKind =
            lowering::declarations::row_kind(declaration);
        if (lowering::declarations::same_kind(declaration_kind,
            lowering::declarations::Invalid)) { return -1; }
        if (lowering::declarations::same_kind(declaration_kind,
                lowering::declarations::Module)) {
            if (contexts[owner].module_target >= 0) { return -1; }
            contexts[owner].module_target =
                lowering::declarations::row_target(declaration);
        }
        declaration_counts = lowering::declarations::add_kind(
            declaration_counts, declaration_kind);
        row += 1;
    }
    let span_end: i32 = 0;
    let span_unit: i32 = 0;
    while (span_unit < unit_count) {
        if (contexts[span_unit].declaration_start != span_end
            || contexts[span_unit].declaration_count <= 0
            || contexts[span_unit].module_target <= -1) { return -1; }
        span_end += contexts[span_unit].declaration_count;
        span_unit += 1;
    }
    if (span_end != total_rows) { return -1; }
    lowering::declarations::table_write_header(global_declarations,
        declaration_counts);
    let resolution_unit: i32 = 0;
    let resolution_rows: [lowering::types::ResolutionRow] =
        bundle.resolutions.data;
    while (resolution_unit < unit_count) {
        let resolution_input: lowering::resolution_catalog::ResolutionInput =
            lowering::resolution_catalog::ResolutionInput {
            unit: resolution_unit,
            contexts: context_table,
            sources: source_catalog,
            tokens: token_catalog,
            tree: trees[resolution_unit],
            trees: bundle.trees,
            declarations: global_declarations,
            allocations: allocation_table,
        };
        let resolution_workspace: lowering::resolution_catalog::ResolutionWorkspace =
            lowering::resolution_catalog::ResolutionWorkspace {
            output: resolution_rows,
            output_offset: resolution_unit * BUNDLE_RESOLUTION_ROW_CAP,
            output_capacity: BUNDLE_RESOLUTION_ROW_CAP,
            type_arena: type_arena,
        };
        let resolution_count: i32 = lowering::resolution_catalog::build(
            resolution_input, resolution_workspace);
        if (resolution_count <= -1) { return -1; }
        let resolution_context: i32 = resolution_unit;
        contexts[resolution_context].resolution_row_offset
            = resolution_unit * BUNDLE_RESOLUTION_ROW_CAP;
        contexts[resolution_context].resolution_count
            = resolution_count;
        resolution_unit += 1;
    }
    status[0].declaration_words
        = lowering::units::units_declaration_words(collected);
    status[0].allocation_words
        = lowering::units::units_allocation_words(collected);
    return 0;
}

fn lower_signatures(bundle: Bundle,
    declarations_pointer:ptr, allocated_pointer:ptr,
    writer: lowering::signature_index::Writer,
    status_pointer:ptr) -> i32 {
    let unit_count: i32 = bundle.unit_count;
    let descriptor_table: lowering::declarations::Catalog =
        bundle.descriptors;
    let context_table: lowering::unit_context::Table =
        bundle.contexts;
    let source_catalog: [i32] = bundle.sources;
    let token_catalog: verified::token::TokenTable = bundle.tokens;
    let resolution_table: lowering::types::ResolutionTable =
        bundle.resolutions;
    let alias_catalog: lowering::aliases::Table = bundle.aliases;
    let status:[PipelineStatus] = status_view(status_pointer);
    let type_output_memory:ptr = verified::host::alloc(
        lowering::types::result_allocation_bytes(TYPE_ARENA_NODE_CAPACITY),
        lowering::types::RESULT_ALIGNMENT);
    let type_scratch_memory:ptr = verified::host::alloc(
        verified::surface_type::allocation_bytes(TYPE_ARENA_NODE_CAPACITY),
        verified::surface_type::ALIGNMENT);
    let resolution_scratch_memory:ptr = verified::host::alloc(
        BUNDLE_RESOLUTION_ROW_CAP * lowering::types::RESOLUTION_RECORD_BYTES,
        lowering::types::RESOLUTION_ALIGNMENT);
    let alias_path_memory:ptr = verified::host::alloc_i32(BUNDLE_TOKEN_CAP);
    let declaration_scratch_memory:ptr = verified::host::alloc(
        BUNDLE_DECL_CAP * verified::host::I32_BYTES,
        lowering::declarations::ALIGNMENT);
    let allocation_scratch_memory:ptr = verified::host::alloc(
        BUNDLE_ALLOCATION_CAP * verified::host::I32_BYTES,
        lowering::allocation::ALIGNMENT);
    let expression_memory: ptr = verified::host::alloc(
        verified::surface_expr::allocation_bytes(
            CONSTANT_EXPRESSION_NODE_CAPACITY),
        verified::surface_expr::ALIGNMENT);
    let binding_memory: ptr = verified::host::alloc_i32(
        CONSTANT_EXPRESSION_NODE_CAPACITY);
    let writer_table: lowering::signature_index::Table = writer.table;
    let constant_count: i32 = writer_table.count;
    let constant_slots: i32 = constant_count;
    let root_memory: ptr = verified::host::alloc_i32(constant_slots);
    let owner_memory: ptr = verified::host::alloc_i32(constant_slots);
    if (type_output_memory == 0
        || type_scratch_memory == 0 || resolution_scratch_memory == 0
        || alias_path_memory == 0
        || declaration_scratch_memory == 0 || allocation_scratch_memory == 0
        || expression_memory == 0 || binding_memory == 0
        || root_memory == 0 || owner_memory == 0) {
        return -1;
    }
    let type_output: lowering::types::Results =
        lowering::types::results_from_raw_parts(type_output_memory,
            TYPE_ARENA_NODE_CAPACITY);
    let type_scratch: verified::surface_type::TypeArena =
        verified::surface_type::from_raw_parts(type_scratch_memory,
            TYPE_ARENA_NODE_CAPACITY);
    let resolution_scratch: lowering::types::ResolutionTable =
        lowering::types::from_raw_parts(resolution_scratch_memory,
            BUNDLE_RESOLUTION_ROW_CAP, lowering::types::IdentifierToken);
    let alias_path_scratch:[i32] = verified::host::i32_slice_from_raw_parts(
        alias_path_memory, BUNDLE_TOKEN_CAP);
    let allocation_words: i32 = status[0].allocation_words;
    if (allocation_words < lowering::allocation::HEADER
        || allocation_words > unit_count * BUNDLE_ALLOCATION_CAP
        || (allocation_words - lowering::allocation::HEADER)
            % lowering::allocation::ROW != 0) { return -1; }
    let allocation_table: lowering::allocation::Table =
        lowering::allocation::from_raw_parts(allocated_pointer,
            (allocation_words - lowering::allocation::HEADER)
                / lowering::allocation::ROW);
    let global_declarations: lowering::declarations::Table =
        lowering::declarations::from_raw_parts(declarations_pointer,
            (allocation_words - lowering::allocation::HEADER)
                / lowering::allocation::ROW);
    let declaration_scratch: lowering::declarations::Table =
        lowering::declarations::from_raw_parts(declaration_scratch_memory,
            (BUNDLE_DECL_CAP - lowering::declarations::HEADER)
                / lowering::declarations::ROW);
    let allocation_scratch: lowering::allocation::Table =
        lowering::allocation::from_raw_parts(allocation_scratch_memory,
            (BUNDLE_ALLOCATION_CAP - lowering::allocation::HEADER)
                / lowering::allocation::ROW);
    let signature_inputs: lowering::signature_producer::SignatureUnitInputs =
        lowering::signature_producer::SignatureUnitInputs {
            unit_count: unit_count,
            unit_declarations: descriptor_table,
            contexts: context_table,
            sources: lowering::signature_producer::region(source_catalog,
                unit_count * BUNDLE_SOURCE_CAP),
            tokens: token_catalog,
            trees: bundle.trees,
            resolutions: resolution_table,
            aliases: alias_catalog,
            allocations: allocation_table,
            global_declarations: global_declarations,
            expected_declaration_words: status[0].declaration_words,
        };
    let signature_workspace: lowering::signature_producer::SignatureUnitWorkspace =
        lowering::signature_producer::SignatureUnitWorkspace {
            alias_path_scratch: lowering::signature_producer::region(
                alias_path_scratch, BUNDLE_TOKEN_CAP),
            type_output: type_output,
            type_arena: type_scratch,
            resolutions: resolution_scratch,
            declarations: declaration_scratch,
            allocations: allocation_scratch,
            writer: writer,
            constant_graph: lowering::constant_catalog::Workspace {
                arena: verified::surface_expr::from_raw_parts(
                    expression_memory, CONSTANT_EXPRESSION_NODE_CAPACITY),
                bindings: verified::host::i32_slice_from_raw_parts(
                    binding_memory, CONSTANT_EXPRESSION_NODE_CAPACITY),
                binding_count: CONSTANT_EXPRESSION_NODE_CAPACITY,
                roots: verified::host::i32_slice_from_raw_parts(
                    root_memory, constant_count),
                owners: verified::host::i32_slice_from_raw_parts(
                    owner_memory, constant_count),
                constant_count: constant_count,
                expected_constants: writer_table.constant_count,
            },
        };
    if (!lowering::signature_producer::lower_units(signature_inputs,
            signature_workspace)) { return -1; }
    return 0;
}

struct BodyInputs {
    bundle: Bundle,
    declarations: ptr,
    allocations: ptr,
    signature_index: lowering::signature_index::Table,
    transport: ptr,
    typed_bodies: ir::body_catalog::Catalog,
    status: ptr,
}

fn lower_bodies(input: BodyInputs) -> i32 {
    let bundle: Bundle = input.bundle;
    let unit_count: i32 = bundle.unit_count;
    let declarations_pointer: ptr = input.declarations;
    let allocated_pointer: ptr = input.allocations;
    let signature_index: lowering::signature_index::Table =
        input.signature_index;
    let transport_pointer: ptr = input.transport;
    let status_pointer: ptr = input.status;
    let descriptor_table: lowering::declarations::Catalog =
        bundle.descriptors;
    let context_table: lowering::unit_context::Table =
        bundle.contexts;
    let contexts: [lowering::unit_context::UnitContext] =
        context_table.data;
    let source_catalog: [i32] = bundle.sources;
    let token_catalog: verified::token::TokenTable = bundle.tokens;
    let resolution_table: lowering::types::ResolutionTable =
        bundle.resolutions;
    let values: lowering::value_catalog::ValueTable =
        bundle.values;
    let alias_catalog: lowering::aliases::Table = bundle.aliases;
    let transport_table: lowering::unit_descriptor::Table =
        lowering::unit_descriptor::from_raw_parts(transport_pointer,
            unit_count);
    let transport_descriptors:
        [lowering::unit_descriptor::UnitDescriptor] = transport_table.data;
    let status:[PipelineStatus] = status_view(status_pointer);
    let value_scratch_memory:ptr = verified::host::alloc(
        BUNDLE_VALUE_ROW_CAP * lowering::value_catalog::RECORD_BYTES,
        lowering::value_catalog::ALIGNMENT);
    let type_scratch_memory:ptr = verified::host::alloc(
        verified::surface_type::allocation_bytes(TYPE_ARENA_NODE_CAPACITY),
        verified::surface_type::ALIGNMENT);
    let resolution_scratch_memory:ptr = verified::host::alloc(
        BUNDLE_RESOLUTION_ROW_CAP * lowering::types::RESOLUTION_RECORD_BYTES,
        lowering::types::RESOLUTION_ALIGNMENT);
    let expression_memory:ptr = verified::host::alloc(
        verified::surface_expr::allocation_bytes(
            EXPRESSION_NODE_CAPACITY),
        verified::surface_expr::ALIGNMENT);
    let expression_kind_code_memory: ptr =
        verified::host::alloc_i32(EXPRESSION_NODE_CAPACITY);
    let expression_kind_depth_memory: ptr =
        verified::host::alloc_i32(EXPRESSION_NODE_CAPACITY);
    let type_output_memory:ptr = verified::host::alloc(
        lowering::types::result_allocation_bytes(TYPE_ARENA_NODE_CAPACITY),
        lowering::types::RESULT_ALIGNMENT);
    let event_memory: ptr = verified::host::alloc(
        ir::body_events::allocation_bytes(BODY_EVENT_CAPACITY),
        ir::body_events::ALIGNMENT);
    let alias_work_memory:ptr = verified::host::alloc_i32(BUNDLE_TOKEN_CAP);
    if (value_scratch_memory == 0 || type_scratch_memory == 0
        || resolution_scratch_memory == 0 || expression_memory == 0
        || expression_kind_code_memory == 0
        || expression_kind_depth_memory == 0
        || type_output_memory == 0
        || event_memory == 0
        || alias_work_memory == 0) { return -1; }
    let value_scratch: lowering::value_catalog::ValueTable =
        lowering::value_catalog::from_raw_parts(value_scratch_memory,
            BUNDLE_VALUE_ROW_CAP);
    let type_scratch: verified::surface_type::TypeArena =
        verified::surface_type::from_raw_parts(type_scratch_memory,
            TYPE_ARENA_NODE_CAPACITY);
    let resolution_scratch: lowering::types::ResolutionTable =
        lowering::types::from_raw_parts(resolution_scratch_memory,
            BUNDLE_RESOLUTION_ROW_CAP, lowering::types::IdentifierToken);
    let expression_arena: verified::surface_expr::ExpressionArena =
        verified::surface_expr::from_raw_parts(expression_memory,
            EXPRESSION_NODE_CAPACITY);
    let type_output: lowering::types::Results =
        lowering::types::results_from_raw_parts(type_output_memory,
            TYPE_ARENA_NODE_CAPACITY);
    let alias_work:[i32] = verified::host::i32_slice_from_raw_parts(
        alias_work_memory, BUNDLE_TOKEN_CAP);
    let allocation_words: i32 = status[0].allocation_words;
    if (allocation_words < lowering::allocation::HEADER
        || allocation_words > unit_count * BUNDLE_ALLOCATION_CAP
        || (allocation_words - lowering::allocation::HEADER)
            % lowering::allocation::ROW != 0) { return -1; }
    let allocation_rows: i32 = (allocation_words
        - lowering::allocation::HEADER) / lowering::allocation::ROW;
    let allocation_table: lowering::allocation::Table =
        lowering::allocation::from_raw_parts(allocated_pointer,
            allocation_rows);
    if (!lowering::allocation::table_has_exact_rows(allocation_table)) {
        return -1;
    }
    let global_declarations: lowering::declarations::Table =
        lowering::declarations::from_raw_parts(declarations_pointer,
            allocation_rows);
    let unit: i32 = 0;
    while (unit < unit_count) {
        let context: i32 = unit;
        // Native typed slices index toward lower addresses. Place unit zero
        // in the last physical slot so its row offset is zero in `values`.
        let unit_values_memory: ptr = bundle.value_storage
            + (unit_count - 1 - unit) * BUNDLE_VALUE_WORD_CAP
                * verified::host::I32_BYTES;
        let unit_values: lowering::value_catalog::ValueTable =
            lowering::value_catalog::from_raw_parts(unit_values_memory,
                BUNDLE_VALUE_ROW_CAP);
        let value_input: lowering::value_collection::ValueCatalogInput =
            lowering::value_collection::ValueCatalogInput {
            unit: unit,
            contexts: context_table,
            sources: lowering::value_collection::region(source_catalog,
                unit_count * BUNDLE_SOURCE_CAP),
            tokens: token_catalog,
            allocations: allocation_table,
            signature_index: signature_index,
        };
        let value_count: i32 = lowering::value_collection::build_value_catalog(value_input,
            unit_values);
        if (value_count <= -1) { return -1; }
        contexts[context].value_count = value_count;
        transport_descriptors[unit].source_offset
            = contexts[context].source_offset;
        transport_descriptors[unit].source_length
            = contexts[context].source_length;
        transport_descriptors[unit].token_offset
            = contexts[context].token_offset;
        transport_descriptors[unit].token_count
            = contexts[context].token_count;
        unit += 1;
    }
    let body_inputs: lowering::body_units::BodyUnitInputs =
        lowering::body_units::BodyUnitInputs {
            unit_count: unit_count,
            contexts: context_table,
            transport_descriptors: transport_table,
            unit_declarations: descriptor_table,
            global_declarations: global_declarations,
            sources: lowering::body_units::region(source_catalog,
                unit_count * BUNDLE_SOURCE_CAP),
            tokens: token_catalog,
            trees: bundle.trees,
            resolutions: resolution_table,
            values: values,
            signature_index: signature_index,
            allocations: allocation_table,
            aliases: alias_catalog,
        };
    let body_workspace: lowering::body_units::BodyUnitWorkspace =
        lowering::body_units::BodyUnitWorkspace {
            type_arena: type_scratch,
            resolutions: resolution_scratch,
            values: value_scratch,
            expressions: expression_arena,
            expression_kind_codes: verified::host::i32_slice_from_raw_parts(
                expression_kind_code_memory, EXPRESSION_NODE_CAPACITY),
            expression_kind_depths: verified::host::i32_slice_from_raw_parts(
                expression_kind_depth_memory, EXPRESSION_NODE_CAPACITY),
            type_output: type_output,
            events: ir::body_events::from_raw_parts(event_memory,
                BODY_EVENT_CAPACITY),
            catalog: input.typed_bodies,
            alias_work: lowering::body_units::region(alias_work,
                BUNDLE_TOKEN_CAP),
        };
    let body_count: i32 = lowering::body_units::lower_units_owned(
        body_inputs, body_workspace);
    if (body_count != lowering::allocation::table_header(
            allocation_table).functions) { return -1; }
    return 0;
}

// Authoritative multi-unit lowering entrypoint. The bundle contains only
// authenticated lexer/parser outputs; declaration, alias, allocation, value,
// signature, body, and transport tables are rebuilt here in unit order.
fn signature_capacity(bundle: Bundle,
    allocated: lowering::allocation::Table)
    -> lowering::signature_index::Requirements {
    let required: lowering::signature_index::Requirements =
        lowering::signature_index::Requirements {
            entries: 0, members: 0, variants: 0, fields: 0,
            constants: 0, bytes: 0, valid: false,
        };
    let table: lowering::unit_context::Table =
        bundle.contexts;
    let contexts: [lowering::unit_context::UnitContext] = table.data;
    if (table.count != bundle.unit_count || bundle.unit_count <= 0) {
        return required;
    }
    let tokens: i32 = 0;
    let bytes: i32 = 0;
    let unit: i32 = 0;
    while (unit < bundle.unit_count) {
        let token_count: i32 = contexts[unit].token_count;
        let source_length: i32 = contexts[unit].source_length;
        if (token_count <= -1 || source_length <= -1
            || token_count > verified::host::I32_MAX - tokens
            || source_length > verified::host::I32_MAX - bytes) {
            return required;
        }
        tokens += token_count;
        bytes += source_length;
        unit += 1;
    }
    let allocation_header: lowering::allocation::AllocationHeader =
        lowering::allocation::table_header(allocated);
    required.entries = allocation_header.declarations;
    required.members = tokens;
    required.variants = tokens;
    required.fields = tokens;
    required.constants = allocation_header.constants;
    required.bytes = bytes;
    required.valid = required.entries > 0
        && required.constants >= 0;
    return required;
}

fn function_parameter_count(allocated: lowering::allocation::Table,
    signatures: lowering::signature_index::Table) -> i32 {
    let rows: i32 = lowering::allocation::table_header(allocated).rows;
    let total: i32 = 0;
    let row: i32 = 0;
    while (row < rows) {
        let allocation: lowering::allocation::AllocationRow =
            lowering::allocation::table_row(allocated, row);
        let shape: lowering::signatures::SignatureShape =
            lowering::signatures::InternalFunctionShape;
        let function: bool = lowering::allocation::row_has_kind(allocation,
            lowering::declarations::Function);
        let external: bool = lowering::allocation::row_has_kind(allocation,
            lowering::declarations::External);
        if (external) {
            shape = lowering::signatures::ExternalFunctionShape;
        }
        if (function || external) {
            let id: i32 = lowering::allocation::row_core_id(allocation);
            if (!lowering::signature_index::has_shape(signatures, id,
                    shape)) { return -1; }
            let signature: lowering::signatures::SignatureRecord =
                lowering::signature_index::record_at(signatures, id);
            let arity: i32 = lowering::signatures::record_arity(signature);
            if (arity <= -1 || arity > verified::host::I32_MAX - total) {
                return -1;
            }
            total += arity;
        }
        row += 1;
    }
    return total;
}

pub enum LoweringStatus {
    Ready,
    InvalidInput,
    UnsupportedFeature,
}

pub fn succeeded(status: LoweringStatus) -> bool {
    return match (status) {
        Ready -> true,
        InvalidInput -> false,
        UnsupportedFeature -> false,
    };
}

pub fn error_code(status: LoweringStatus) -> i32 {
    return match (status) {
        Ready -> 0,
        InvalidInput -> lowering::error::error_code(
            lowering::error::InvalidInput),
        UnsupportedFeature -> lowering::error::error_code(
            lowering::error::UnsupportedFeature),
    };
}

pub struct LoweredProgram {
    status: LoweringStatus,
    transport_words: i32,
    program: ir::program::Program,
}

fn failure(status: i32) -> LoweredProgram {
    let reason: LoweringStatus = InvalidInput;
    if (lowering::error::failed_with(status,
            lowering::error::UnsupportedFeature)) {
        reason = UnsupportedFeature;
    }
    return LoweredProgram {
        status: reason,
        transport_words: 0,
        program: ir::program::empty(),
    };
}

pub fn lower_units(bundle: Bundle,
    output_pointer:ptr,
    mode: lowering::transport::OutputMode) -> LoweredProgram {
    let unit_count: i32 = bundle.unit_count;
    if ((mode == lowering::transport::NativeAndCore
            && output_pointer == 0)
        || unit_count <= 0 || unit_count > BUNDLE_UNIT_LIMIT
        || bundle_words(unit_count) <= 0) { return failure(-1); }
    let declarations_memory:ptr = verified::host::alloc(
        unit_count * BUNDLE_DECL_CAP * verified::host::I32_BYTES,
        lowering::declarations::ALIGNMENT);
    let allocated_memory:ptr = verified::host::alloc(
        unit_count * BUNDLE_ALLOCATION_CAP * verified::host::I32_BYTES,
        lowering::allocation::ALIGNMENT);
    let transport_memory:ptr = verified::host::alloc(
        unit_count * lowering::unit_descriptor::RECORD_BYTES,
        lowering::unit_descriptor::ALIGNMENT);
    let status_memory:ptr = verified::host::alloc(STATUS_RECORD_BYTES,
        STATUS_FIELD_BYTES);
    if (declarations_memory == 0 || allocated_memory == 0
        || transport_memory == 0
        || status_memory == 0) { return failure(-1); }
    let prepare_status: i32 = prepare_catalogs(bundle,
        declarations_memory, allocated_memory, status_memory);
    if (prepare_status != 0) {
        return failure(prepare_status);
    }
    let allocated_for_signatures: lowering::allocation::Table =
        lowering::allocation::from_raw_parts(allocated_memory,
            (unit_count * BUNDLE_ALLOCATION_CAP
                - lowering::allocation::HEADER)
                / lowering::allocation::ROW);
    let required: lowering::signature_index::Requirements =
        signature_capacity(bundle, allocated_for_signatures);
    let bytes: i32 = lowering::signature_index::allocation_bytes(required);
    if (bytes <= 0) { return failure(-1); }
    let index_memory: ptr = verified::host::alloc(bytes,
        lowering::signature_index::ALIGNMENT);
    let cursor_memory: ptr = verified::host::alloc(
        lowering::signature_index::WRITER_BYTES,
        lowering::signature_index::ALIGNMENT);
    if (index_memory == 0 || cursor_memory == 0) { return failure(-1); }
    let index_storage: lowering::signature_index::Table =
        lowering::signature_index::from_raw_parts(index_memory, required);
    let writer: lowering::signature_index::Writer =
        lowering::signature_index::writer(index_storage, cursor_memory);
    let signature_status: i32 = lower_signatures(bundle,
        declarations_memory, allocated_memory, writer,
        status_memory);
    if (signature_status != 0) {
        return failure(signature_status);
    }
    if (!lowering::signature_index::complete(writer)) { return failure(-1); }
    let signature_index: lowering::signature_index::Table =
        lowering::signature_index::finish(writer);
    let body_catalog_bytes: i32 =
        ir::body_catalog::allocation_bytes(required.entries);
    if (body_catalog_bytes <= 0) { return failure(-1); }
    let typed_body_memory: ptr = verified::host::alloc(body_catalog_bytes,
        ir::body_catalog::ALIGNMENT);
    if (typed_body_memory == 0) { return failure(-1); }
    let typed_bodies: ir::body_catalog::Catalog =
        ir::body_catalog::from_raw_parts(typed_body_memory,
            required.entries);
    let body_input: BodyInputs = BodyInputs {
        bundle: bundle,
        declarations: declarations_memory,
        allocations: allocated_memory,
        signature_index: signature_index,
        transport: transport_memory,
        typed_bodies: typed_bodies,
        status: status_memory,
    };
    let body_status: i32 = lower_bodies(body_input);
    if (body_status != 0) {
        return failure(body_status);
    }
    let source_catalog: [i32] = bundle.sources;
    let token_catalog: verified::token::TokenTable = bundle.tokens;
    let transport_table: lowering::unit_descriptor::Table =
        lowering::unit_descriptor::from_raw_parts(transport_memory,
            unit_count);
    let status:[PipelineStatus] = status_view(status_memory);
    let allocation_words: i32 = status[0].allocation_words;
    if (allocation_words < lowering::allocation::HEADER
        || allocation_words > unit_count * BUNDLE_ALLOCATION_CAP
        || (allocation_words - lowering::allocation::HEADER)
            % lowering::allocation::ROW != 0) { return failure(-1); }
    let allocation_rows: i32 = (allocation_words
        - lowering::allocation::HEADER) / lowering::allocation::ROW;
    if (allocation_rows <= 0
        || allocation_rows > (unit_count * BUNDLE_DECL_CAP
            - lowering::declarations::HEADER)
                / lowering::declarations::ROW) { return failure(-1); }
    let allocation_table: lowering::allocation::Table =
        lowering::allocation::from_raw_parts(allocated_memory,
            allocation_rows);
    if (!lowering::allocation::table_has_exact_rows(allocation_table)) {
        return failure(-1);
    }
    lowering::allocation::clear_aliases(allocation_table);
    let global_declaration_words: i32 = lowering::declarations::HEADER
        + allocation_rows
            * lowering::declarations::ROW;
    let declaration_table: lowering::declarations::Table =
        lowering::declarations::from_raw_parts(declarations_memory,
            allocation_rows);
    let allocation_header: lowering::allocation::AllocationHeader =
        lowering::allocation::table_header(allocation_table);
    if (allocation_header.functions <= 0
        || allocation_header.externals <= -1
        || allocation_header.functions > verified::host::I32_MAX
            - allocation_header.externals) { return failure(-1); }
    let function_count: i32 = allocation_header.functions
        + allocation_header.externals;
    let parameter_count: i32 = function_parameter_count(allocation_table,
        signature_index);
    let function_bytes: i32 = ir::function_catalog::allocation_bytes(
        function_count, parameter_count);
    if (function_bytes <= 0) { return failure(-1); }
    let function_memory: ptr = verified::host::alloc(function_bytes,
        ir::function_catalog::ALIGNMENT);
    if (function_memory == 0) { return failure(-1); }
    let functions: ir::function_catalog::Table =
        ir::function_catalog::from_raw_parts(function_memory,
            function_count, parameter_count);
    let output_capacity: i32 = 0;
    if (mode == lowering::transport::NativeAndCore) {
        output_capacity = BUNDLE_TRANSPORT_CAP;
    }
    let output:[i32] = verified::host::i32_slice_from_raw_parts(
        output_pointer, output_capacity);
    let transport_input: lowering::transport::TransportInput =
        lowering::transport::TransportInput {
            unit_count: unit_count,
            sources: lowering::transport::region(source_catalog,
                unit_count * BUNDLE_SOURCE_CAP),
            tokens: token_catalog,
            descriptors: transport_table,
            declarations: declaration_table,
            allocations: allocation_table,
            signature_index: signature_index,
            bodies: typed_bodies,
            functions: functions,
        };
    let final_words: i32 = lowering::transport::lower(transport_input,
        lowering::transport::region(output, output_capacity),
        lowering::transport::NativeOnly);
    if (final_words <= -1) {
        return failure(final_words);
    }
    let semantic: lowering::ir_catalogs::Catalogs =
        lowering::ir_catalogs::build(signature_index, allocation_table);
    if (!semantic.valid) { return failure(-1); }
    let names: ir::symbol_catalog::Catalog = lowering::ir_names::build(
        lowering::ir_names::Input {
            sources: source_catalog,
            source_count: unit_count * BUNDLE_SOURCE_CAP,
            tokens: token_catalog,
            descriptors: transport_table,
            allocations: allocation_table,
            signatures: signature_index,
            types: semantic.types,
            functions: functions,
        });
    if (names.unit_count != unit_count) { return failure(-1); }
    let program: ir::program::Program = ir::program::Program {
        entrypoint: ir::function_catalog::at(functions, 0).id,
        types: semantic.types,
        constants: semantic.constants,
        functions: functions,
        bodies: typed_bodies,
        names: names,
    };
    let transport_words: i32 = 0;
    if (mode == lowering::transport::NativeAndCore) {
        transport_words = verified::core_transport::serialize(program,
            output, output_capacity);
        if (transport_words < lowering::transport::HEADER) {
            return failure(-1);
        }
    }
    return LoweredProgram {
        status: Ready,
        transport_words: transport_words,
        program: program,
    };
}
