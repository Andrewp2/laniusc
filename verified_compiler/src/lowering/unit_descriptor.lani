module lowering::unit_descriptor;

// This table is private to multi-unit lowering. It names each unit's source
// and token slices; bodies and signatures live in separate native catalogs.
pub const FIELD_BYTES: i32 = 8;
pub const FIELD_COUNT: i32 = 4;
pub const RECORD_BYTES: i32 = FIELD_COUNT * FIELD_BYTES;
pub const ALIGNMENT: i32 = FIELD_BYTES;

pub struct UnitDescriptor {
    source_offset: i32,
    source_length: i32,
    token_offset: i32,
    token_count: i32,
}

pub struct Table {
    data: [UnitDescriptor],
    count: i32,
}

pub fn from_raw_parts(memory: ptr, count: i32) -> Table {
    // Typed aggregate slices start at the last word within their allocation.
    let first: ptr = memory;
    if (count > 0) {
        first = memory + count * RECORD_BYTES - FIELD_BYTES;
    }
    return Table {
        data: slice_from_raw_parts(first, count),
        count: count,
    };
}
