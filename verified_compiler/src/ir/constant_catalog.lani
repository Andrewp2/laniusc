module ir::constant_catalog;

import ir::type_ref;
import verified::host;

const SLOT_BYTES: i32 = 8;
const CONSTANT_BYTES: i32 = 8 * SLOT_BYTES;
pub const ALIGNMENT: i32 = SLOT_BYTES;

pub enum Encoding {
    Scalar,
    StringBytes,
}

pub struct Constant {
    id: i32,
    kind: ir::type_ref::TypeRef,
    encoding: Encoding,
    low: i32,
    high: i32,
    byte_start: i32,
    byte_count: i32,
}

pub struct Table {
    constants: [Constant],
    count: i32,
    bytes: [i32],
    byte_count: i32,
}

pub fn allocation_bytes(constants: i32, bytes: i32) -> i32 {
    if (constants <= -1 || bytes <= -1
        || constants > verified::host::I32_MAX / CONSTANT_BYTES) {
        return -1;
    }
    let row_bytes: i32 = constants * CONSTANT_BYTES;
    if (bytes > (verified::host::I32_MAX - row_bytes)
            / verified::host::I32_BYTES) { return -1; }
    let total: i32 = row_bytes + bytes * verified::host::I32_BYTES;
    if (total == 0) { return SLOT_BYTES; }
    return total;
}

pub fn from_raw_parts(memory: ptr, constants: i32, bytes: i32) -> Table {
    let first: ptr = memory;
    if (constants > 0) {
        first = memory + constants * CONSTANT_BYTES - SLOT_BYTES;
    }
    return Table {
        constants: slice_from_raw_parts(first, constants),
        count: constants,
        bytes: verified::host::i32_slice_from_raw_parts(
            memory + constants * CONSTANT_BYTES, bytes),
        byte_count: bytes,
    };
}

pub fn empty() -> Table {
    return from_raw_parts(0, 0, 0);
}

pub fn valid(table: Table) -> bool {
    if (table.count <= -1 || table.byte_count <= -1) { return false; }
    let constants: [Constant] = table.constants;
    let bytes: [i32] = table.bytes;
    let byte_cursor: i32 = 0;
    let index: i32 = 0;
    while (index != table.count) {
        let constant: Constant = constants[index];
        let type_code: i32 = ir::type_ref::code(constant.kind);
        if (constant.id <= -1 || type_code <= 0 || type_code > 5) {
            return false;
        }
        let prior: i32 = 0;
        while (prior != index) {
            if (constants[prior].id == constant.id) { return false; }
            prior += 1;
        }
        if (constant.encoding == StringBytes) {
            if (type_code != 5 || constant.byte_start != byte_cursor
                || constant.byte_count <= -1
                || constant.byte_count > table.byte_count - byte_cursor) {
                return false;
            }
            let byte: i32 = 0;
            while (byte != constant.byte_count) {
                let value: i32 = bytes[byte_cursor];
                if (value <= -1 || value > verified::host::BYTE_MASK) {
                    return false;
                }
                byte_cursor += 1;
                byte += 1;
            }
        } else {
            if (constant.encoding != Scalar || type_code == 5
                || constant.byte_start != -1 || constant.byte_count != 0
                || (type_code <= 2 && constant.high != 0)
                || (type_code == 2
                    && constant.low != 0 && constant.low != 1)) {
                return false;
            }
        }
        index += 1;
    }
    return byte_cursor == table.byte_count;
}

pub fn contains(table: Table, id: i32) -> bool {
    let constants: [Constant] = table.constants;
    if (table.count <= 0) { return false; }
    let index: i32 = 0;
    while (index != table.count) {
        if (constants[index].id == id) { return true; }
        index += 1;
    }
    return false;
}
