module ir::function_catalog;

import runtime::service;
import ir::type_ref;
import verified::host;

// Semantic function order, parameter metadata, and runtime services retained
// alongside Core serialization. Wire headers and body lengths do not belong
// to a native function.
const FIELD_BYTES: i32 = 8;
const FUNCTION_FIELDS: i32 = 7;
const PARAMETER_FIELDS: i32 = 3;
const FUNCTION_BYTES: i32 = FUNCTION_FIELDS * FIELD_BYTES;
const PARAMETER_BYTES: i32 = PARAMETER_FIELDS * FIELD_BYTES;
pub const ALIGNMENT: i32 = FIELD_BYTES;

pub enum FunctionKind {
    DefinedFunction,
    RuntimeFunction,
}

pub struct Parameter {
    id: i32,
    type_tag: ir::type_ref::TypeRef,
}

pub struct Function {
    kind: FunctionKind,
    id: i32,
    result_type: ir::type_ref::TypeRef,
    parameters: i32,
    parameter_start: i32,
    service: runtime::service::RuntimeService,
}

pub struct Table {
    functions: [Function],
    count: i32,
    parameters: [Parameter],
    parameter_count: i32,
}

// A borrowed ID-to-slot index. IDs need not be dense or match declaration
// order. Build once after lowering; the catalog must remain unchanged while
// the index is in use. Slots contain table positions, not copied functions.
pub struct Index {
    table: Table,
    slots: [i32],
    capacity: i32,
}

fn invalid_index(table: Table) -> Index {
    let nowhere: ptr = 0;
    return Index { table: table,
        slots: verified::host::i32_slice_from_raw_parts(nowhere, 0),
        capacity: 0 };
}

pub fn build_index(table: Table) -> Index {
    if (table.count <= 0
        || table.count > (verified::host::I32_MAX / 4 - 1) / 2) {
        return invalid_index(table);
    }
    let capacity: i32 = table.count * 2 + 1;
    let memory: ptr = verified::host::alloc_i32(capacity);
    if (memory == 0) { return invalid_index(table); }
    let slots: [i32] = verified::host::i32_slice_from_raw_parts(memory, capacity);
    let position: i32 = 0;
    while (position != capacity) {
        slots[position] = -1;
        position += 1;
    }
    let functions: [Function] = table.functions;
    let row: i32 = 0;
    while (row != table.count) {
        let id: i32 = functions[row].id;
        if (id <= -1) { return invalid_index(table); }
        let slot: i32 = id % capacity;
        let probes: i32 = 0;
        while (slots[slot] >= 0) {
            if (functions[slots[slot]].id == id) { return invalid_index(table); }
            probes += 1;
            if (probes == capacity) { return invalid_index(table); }
            slot += 1;
            if (slot == capacity) { slot = 0; }
        }
        slots[slot] = row;
        row += 1;
    }
    return Index { table: table, slots: slots, capacity: capacity };
}

pub fn find(index: Index, id: i32) -> i32 {
    if (index.capacity <= 0 || id <= -1) { return -1; }
    let slots: [i32] = index.slots;
    let functions: [Function] = index.table.functions;
    let slot: i32 = id % index.capacity;
    let probes: i32 = 0;
    while (probes != index.capacity) {
        let row: i32 = slots[slot];
        if (row <= -1 || row >= index.table.count) { return -1; }
        if (functions[row].id == id) { return row; }
        probes += 1;
        slot += 1;
        if (slot == index.capacity) { slot = 0; }
    }
    return -1;
}

fn slice_first(base: ptr, count: i32, bytes: i32) -> ptr {
    if (count <= 0) { return base; }
    return base + count * bytes - FIELD_BYTES;
}

pub fn allocation_bytes(functions: i32, parameters: i32) -> i32 {
    if (functions <= 0 || parameters <= -1
        || functions > verified::host::I32_MAX / FUNCTION_BYTES) {
        return -1;
    }
    let bytes: i32 = functions * FUNCTION_BYTES;
    if (parameters > (verified::host::I32_MAX - bytes)
            / PARAMETER_BYTES) { return -1; }
    return bytes + parameters * PARAMETER_BYTES;
}

pub fn from_raw_parts(memory: ptr, functions: i32,
    parameters: i32) -> Table {
    let parameter_base: ptr = memory + functions * FUNCTION_BYTES;
    return Table {
        functions: slice_from_raw_parts(
            slice_first(memory, functions, FUNCTION_BYTES), functions),
        count: functions,
        parameters: slice_from_raw_parts(
            slice_first(parameter_base, parameters, PARAMETER_BYTES),
            parameters),
        parameter_count: parameters,
    };
}

pub fn at(table: Table, index: i32) -> Function {
    let functions: [Function] = table.functions;
    return functions[index];
}

pub fn has_call(table: Table, id: i32, argument_count: i32) -> bool {
    let functions: [Function] = table.functions;
    if (table.count <= 0) { return false; }
    let index: i32 = 0;
    while (index != table.count) {
        if (functions[index].id == id) {
            return functions[index].parameters == argument_count;
        }
        index += 1;
    }
    return false;
}

pub fn id_occurrences(table: Table, id: i32) -> i32 {
    let functions: [Function] = table.functions;
    if (table.count <= 0) { return 0; }
    let count: i32 = 0;
    let index: i32 = 0;
    while (index != table.count) {
        if (functions[index].id == id) { count += 1; }
        index += 1;
    }
    return count;
}
