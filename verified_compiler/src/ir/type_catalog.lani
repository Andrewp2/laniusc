module ir::type_catalog;

import ir::type_ref;
import verified::host;

// Resolved nominal declarations in Core ID order. These rows contain no
// source tokens, declaration ordinals, or transport offsets.
const SLOT_BYTES: i32 = 8;
const TYPE_BYTES: i32 = 6 * SLOT_BYTES;
const VARIANT_BYTES: i32 = 2 * SLOT_BYTES;
const FIELD_BYTES: i32 = ir::type_ref::STORAGE_WORDS * SLOT_BYTES;
pub const ALIGNMENT: i32 = SLOT_BYTES;

pub enum TypeKind {
    Structure,
    Enumeration,
}

pub struct TypeDecl {
    kind: TypeKind,
    id: i32,
    field_start: i32,
    field_count: i32,
    variant_start: i32,
    variant_count: i32,
}

pub struct Variant {
    field_start: i32,
    field_count: i32,
}

pub struct Field {
    type_tag: ir::type_ref::TypeRef,
}

pub struct Table {
    types: [TypeDecl],
    type_count: i32,
    variants: [Variant],
    variant_count: i32,
    fields: [Field],
    field_count: i32,
}

fn first(base: ptr, count: i32, bytes: i32) -> ptr {
    if (count <= 0) { return base; }
    return base + count * bytes - SLOT_BYTES;
}

pub fn allocation_bytes(types: i32, variants: i32, fields: i32) -> i32 {
    if (types <= -1 || variants <= -1 || fields <= -1
        || types > verified::host::I32_MAX / TYPE_BYTES) { return -1; }
    let bytes: i32 = types * TYPE_BYTES;
    if (variants > (verified::host::I32_MAX - bytes) / VARIANT_BYTES) {
        return -1;
    }
    bytes += variants * VARIANT_BYTES;
    if (fields > (verified::host::I32_MAX - bytes) / FIELD_BYTES) {
        return -1;
    }
    bytes += fields * FIELD_BYTES;
    if (bytes == 0) { return SLOT_BYTES; }
    return bytes;
}

pub fn from_raw_parts(memory: ptr, types: i32, variants: i32,
    fields: i32) -> Table {
    let variant_base: ptr = memory + types * TYPE_BYTES;
    let field_base: ptr = variant_base + variants * VARIANT_BYTES;
    return Table {
        types: slice_from_raw_parts(first(memory, types, TYPE_BYTES), types),
        type_count: types,
        variants: slice_from_raw_parts(first(variant_base, variants,
            VARIANT_BYTES), variants),
        variant_count: variants,
        fields: slice_from_raw_parts(first(field_base, fields, FIELD_BYTES),
            fields),
        field_count: fields,
    };
}

pub fn empty() -> Table {
    return from_raw_parts(0, 0, 0, 0);
}

pub fn valid_type(table: Table, type_tag: ir::type_ref::TypeRef) -> bool {
    let code: i32 = ir::type_ref::code(type_tag);
    if (code <= 0) { return false; }
    if (code >= ir::type_ref::NOMINAL_SLICE_BASE) {
        let id: i32 = code - ir::type_ref::NOMINAL_SLICE_BASE;
        let limit: i32 = table.type_count;
        return id >= 0 && id <= limit - 1;
    }
    if (code >= ir::type_ref::NOMINAL_BASE) {
        let id: i32 = code - ir::type_ref::NOMINAL_BASE;
        let limit: i32 = table.type_count;
        return id >= 0 && id <= limit - 1;
    }
    return true;
}

pub fn valid_result(table: Table, type_tag: ir::type_ref::TypeRef) -> bool {
    return ir::type_ref::code(type_tag) == 0
        || valid_type(table, type_tag);
}

pub fn valid(table: Table) -> bool {
    if (table.type_count <= -1 || table.variant_count <= -1
        || table.field_count <= -1) { return false; }
    let types: [TypeDecl] = table.types;
    let variants: [Variant] = table.variants;
    let fields: [Field] = table.fields;
    let field_cursor: i32 = 0;
    let variant_cursor: i32 = 0;
    let index: i32 = 0;
    while (index != table.type_count) {
        let declaration: TypeDecl = types[index];
        if (declaration.id != index) { return false; }
        if (declaration.kind == Structure) {
            if (declaration.variant_start != -1
                || declaration.variant_count != 0
                || declaration.field_start != field_cursor
                || declaration.field_count <= -1
                || declaration.field_count > table.field_count
                    - field_cursor) { return false; }
            let field: i32 = 0;
            while (field != declaration.field_count) {
                if (!valid_type(table, fields[field_cursor].type_tag)) {
                    return false;
                }
                field_cursor += 1;
                field += 1;
            }
        } else {
            if (declaration.kind != Enumeration
                || declaration.field_start != -1
                || declaration.field_count != 0
                || declaration.variant_start != variant_cursor
                || declaration.variant_count <= -1
                || declaration.variant_count > table.variant_count
                    - variant_cursor) { return false; }
            let ordinal: i32 = 0;
            while (ordinal != declaration.variant_count) {
                let variant: Variant = variants[variant_cursor];
                if (variant.field_start != field_cursor
                    || variant.field_count <= -1
                    || variant.field_count > table.field_count
                        - field_cursor) { return false; }
                let variant_fields: i32 = variant.field_count;
                let field: i32 = 0;
                while (field != variant_fields) {
                    if (!valid_type(table, fields[field_cursor].type_tag)) {
                        return false;
                    }
                    field_cursor += 1;
                    field += 1;
                }
                variant_cursor += 1;
                ordinal += 1;
            }
        }
        index += 1;
    }
    return field_cursor == table.field_count
        && variant_cursor == table.variant_count;
}
