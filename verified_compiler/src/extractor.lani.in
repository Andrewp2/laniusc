module app::main;
import verified::extraction;
import verified::byte_io;
import verified::semantic_tokens;
import verified::artifact_output;
import alloc::allocator;
import core::mem;
import std::fs;
import std::process;

fn hex_nibble(byte: i32) -> i32 {
    if (byte >= 48 && byte <= 57) { return byte - 48; }
    return byte - 87;
}

// Bootstrap syntax extractor. Inputs are argv[1..]; output is one Lean
// ArtifactPack expression. Nonzero exit means all partial output must be
// discarded. Buffers are allocated once and reused sequentially across units.
fn main() -> i32 {
    let argument_count: i32 = std::process::argc();
    if (argument_count <= 1) { return 1; }
    let packed_path: [i32] = core::mem::i32_slice_from_raw_parts(
        alloc::allocator::alloc(@PATH_PACKED_BYTES@, 4), 256);
    let path: [i32] = core::mem::i32_slice_from_raw_parts(
        alloc::allocator::alloc(@PATH_BYTES@, 4), 1024);
    let source: [i32] = core::mem::i32_slice_from_raw_parts(
        alloc::allocator::alloc(@SOURCE_BYTES@, 4), @SOURCE_CAP@);
    let grammar: [i32] = core::mem::i32_slice_from_raw_parts(
        alloc::allocator::alloc(@GRAMMAR_BYTES@, 4), @GRAMMAR_LEN@);
    let raw: [i32] = core::mem::i32_slice_from_raw_parts(
        alloc::allocator::alloc(@TOKEN_BYTES@, 4), @TOKEN_CAP@);
    let canonical: [i32] = core::mem::i32_slice_from_raw_parts(
        alloc::allocator::alloc(@TOKEN_BYTES@, 4), @TOKEN_CAP@);
    let kinds: [i32] = core::mem::i32_slice_from_raw_parts(
        alloc::allocator::alloc(@TOKEN_BYTES@, 4), @TOKEN_CAP@);
    let workspace: [i32] = core::mem::i32_slice_from_raw_parts(
        alloc::allocator::alloc(@WORK_BYTES@, 4), @WORK_CAP@);
    let records: [i32] = core::mem::i32_slice_from_raw_parts(
        alloc::allocator::alloc(@RECORD_BYTES@, 4), @RECORD_CAP@);
    let offsets: [i32] = core::mem::i32_slice_from_raw_parts(
        alloc::allocator::alloc(@NODE_BYTES@, 4), @NODE_CAP@);
    let semantic: [i32] = core::mem::i32_slice_from_raw_parts(
        alloc::allocator::alloc(@SEMANTIC_BYTES@, 4), @SEMANTIC_CAP@);
    let expression_arena: [i32] = core::mem::i32_slice_from_raw_parts(
        alloc::allocator::alloc(@SURFACE_EXPR_BYTES@, 4), @SURFACE_EXPR_CAP@);
    let type_arena: [i32] = core::mem::i32_slice_from_raw_parts(
        alloc::allocator::alloc(@SURFACE_TYPE_BYTES@, 4), @SURFACE_TYPE_CAP@);
    let output: [i32] = core::mem::i32_slice_from_raw_parts(
        alloc::allocator::alloc(@OUTPUT_BYTES@, 4), @OUTPUT_CAP@);
    let packed_path_pointer: ptr = core::mem::i32_slice_data_ptr(packed_path);
    if (packed_path_pointer == 0 || core::mem::i32_slice_data_ptr(path) == 0
        || core::mem::i32_slice_data_ptr(source) == 0
        || core::mem::i32_slice_data_ptr(grammar) == 0
        || core::mem::i32_slice_data_ptr(raw) == 0
        || core::mem::i32_slice_data_ptr(canonical) == 0
        || core::mem::i32_slice_data_ptr(kinds) == 0
        || core::mem::i32_slice_data_ptr(workspace) == 0
        || core::mem::i32_slice_data_ptr(records) == 0
        || core::mem::i32_slice_data_ptr(offsets) == 0
        || core::mem::i32_slice_data_ptr(semantic) == 0
        || core::mem::i32_slice_data_ptr(expression_arena) == 0
        || core::mem::i32_slice_data_ptr(type_arena) == 0
        || core::mem::i32_slice_data_ptr(output) == 0) { return 3; }
    // The exact grammar remains embedded, but as one lexical token rather
    // than thousands of array-element productions. Four hexadecimal bytes
    // encode each unsigned 16-bit grammar word from most to least significant.
    let encoded_grammar: str = "@GRAMMAR_ENCODED@";
    let encoded_words: [i32] = core::mem::i32_slice_from_raw_parts(
        core::mem::string_data_ptr(encoded_grammar), @GRAMMAR_LEN@);
    let grammar_index: i32 = 0;
    while (grammar_index != @GRAMMAR_LEN@) {
        let encoded_word: i32 = encoded_words[grammar_index];
        grammar[grammar_index] =
            (hex_nibble(encoded_word & 255) << 12)
            | (hex_nibble((encoded_word >> 8) & 255) << 8)
            | (hex_nibble((encoded_word >> 16) & 255) << 4)
            | hex_nibble((encoded_word >> 24) & 255);
        grammar_index += 1;
    }
    let pack_start: [i32; 67] = [76,97,110,105,117,115,46,69,120,116,114,97,99,116,105,111,110,46,65,114,116,105,102,97,99,116,80,97,99,107,46,109,107,32,76,97,110,105,117,115,46,69,120,116,114,97,99,116,105,111,110,46,115,99,104,101,109,97,86,101,114,115,105,111,110,32,91];
    let separator: [i32; 1] = [44];
    let pack_end: [i32; 1] = [93];
    if (verified::byte_io::write_stdout(pack_start, 67) != 67) { return 23; }
    let argument: i32 = 1;
    while (argument != argument_count) {
        let path_length: i32 = std::process::arg_len(argument);
        if (path_length <= 0 || path_length >= 1025) { return 2; }
        if (std::process::arg_read(argument, packed_path_pointer, path_length) != path_length) {
            return 4;
        }
        let index: i32 = 0;
        while (index != path_length) {
            path[index] = (packed_path[index / 4] >> ((index % 4) * 8)) & 255;
            index += 1;
        }
        let handle: i32 = std::fs::open_read(packed_path_pointer, path_length);
        if (handle <= -1) { return 5; }
        let source_length: i32 = verified::byte_io::read_file(handle, source, @SOURCE_CAP@);
        let closed: i32 = std::fs::close(handle);
        if (source_length <= -1 || closed <= -1) { return 6; }
        let extracted = verified::extraction::extract_syntax(source, source_length,
            grammar, @GRAMMAR_LEN@, raw, @TOKEN_CAP@, canonical, @TOKEN_CAP@,
            kinds, @TOKEN_CAP@, workspace, @WORK_CAP@, records, @RECORD_CAP@,
            offsets, @NODE_CAP@, @DEPTH@);
        if (verified::extraction::extraction_stage(extracted) != 0) {
            verified::byte_io::write_stderr_natural(argument);
            verified::byte_io::write_stderr_natural(
                verified::extraction::extraction_stage(extracted));
            verified::byte_io::write_stderr_natural(
                verified::extraction::extraction_detail(extracted));
            verified::byte_io::write_stderr_natural(
                verified::extraction::error_position(extracted));
            verified::byte_io::write_stderr_natural(
                verified::extraction::node_count(extracted));
            verified::byte_io::write_stderr_natural(
                verified::extraction::tree_words(extracted));
            return 1000 + verified::extraction::extraction_stage(extracted) * 10
                + verified::extraction::extraction_detail(extracted);
        }
        let nodes: i32 = verified::extraction::node_count(extracted);
        let tokens: i32 = verified::extraction::token_count(extracted);
        if (verified::semantic_tokens::collect(grammar, @GRAMMAR_LEN@, kinds, tokens,
            records, @RECORD_CAP@, offsets, nodes, semantic, @SEMANTIC_CAP@) != 0) {
            return 20;
        }
        let written: i32 = -1;
        if (@EMIT_SURFACE@) {
            written = verified::artifact_output::emit_surface(path, path_length,
                source, source_length, grammar, @GRAMMAR_LEN@, raw, @TOKEN_CAP@,
                verified::extraction::raw_count(extracted), canonical, @TOKEN_CAP@,
                tokens, semantic, @SEMANTIC_CAP@, records, @RECORD_CAP@, offsets,
                nodes, expression_arena, @SURFACE_EXPR_CAP@, type_arena,
                @SURFACE_TYPE_CAP@, @DEPTH@, output, @OUTPUT_CAP@);
        } else {
            written = verified::artifact_output::emit_syntax(path, path_length,
                source, source_length, grammar, @GRAMMAR_LEN@, raw, @TOKEN_CAP@,
                verified::extraction::raw_count(extracted), canonical, @TOKEN_CAP@,
                tokens, semantic, @SEMANTIC_CAP@, records, @RECORD_CAP@, offsets,
                nodes, output, @OUTPUT_CAP@);
        }
        if (written <= -1) { return 21; }
        if (argument != 1
            && verified::byte_io::write_stdout(separator, 1) != 1) { return 24; }
        if (verified::byte_io::write_stdout(output, written) != written) { return 22; }
        argument += 1;
    }
    if (verified::byte_io::write_stdout(pack_end, 1) != 1) { return 25; }
    return 0;
}
