module backend::parameter;
import x86::register;
import x86::encode;
import x86::control;
import x86::buffer;
import backend::syntax;
import ir::body_events;
import ir::type_ref;

const DIRECT_RETURN_WORDS: i32 = 4;
const SEQUENCED_RETURN_WORDS: i32 = 6;
pub const INTEGER_ARGUMENT_REGISTERS: i32 = 6;
pub const STACK_ARGUMENT_BASE_BYTES: i32 = 16;
const SEQUENCE_PREFIX_WORDS: i32 = 1;
const RETURN_STATEMENT_FIELD: i32 = 0;
const RETURN_PRESENCE_FIELD: i32 = 1;
const RETURN_EXPRESSION_FIELD: i32 = 2;
const RETURN_LOCAL_FIELD: i32 = 3;
const SEQUENCE_SKIP_FIELD: i32 = 5;
const FIRST_EXTENDED_ARGUMENT: i32 = 4;
const LEGACY_ARGUMENT_RETURN_BYTES: i32 = 3;
const EXTENDED_ARGUMENT_RETURN_BYTES: i32 = 4;

// The function header and parameter rows are already typed. Body constructors
// are preorder Core syntax: a sequence may lead, followed by a return with
// a present local expression and an optional trailing skip.
// This first lowering accepts return-of-parameter bodies, with or without
// the frontend's trailing skip. Other Core forms are explicitly unsupported.
// The transport is input data, not a new language or an assumed proof.
pub fn select(input: [i32], length: i32,
    parameters: backend::syntax::FunctionParameters) -> i32 {
    let header: backend::syntax::FunctionHeader = parameters.header;
    if (header.kind != backend::syntax::DefinedFunction
        || header.pointer_bits != backend::syntax::POINTER_BITS
        || header.id <= -1
        || !ir::type_ref::same(header.result_type,
            ir::type_ref::I32)) { return -1; }
    let count: i32 = header.parameters;
    let body_length: i32 = header.body_words;
    if (parameters.start < 0 || parameters.start > parameters.length
        || count > parameters.length - parameters.start
        || count <= 0 || count > INTEGER_ARGUMENT_REGISTERS
        || (body_length != DIRECT_RETURN_WORDS
            && body_length != SEQUENCED_RETURN_WORDS)) { return -1; }
    if (length != body_length) { return -1; }
    let first: i32 = 0;
    if (body_length == SEQUENCED_RETURN_WORDS) {
        if (backend::syntax::statement_from_code(input[0])
                != backend::syntax::StatementSequence) { return -1; }
        if (backend::syntax::statement_from_code(
                input[SEQUENCE_SKIP_FIELD])
                != backend::syntax::StatementSkip) { return -1; }
        first += SEQUENCE_PREFIX_WORDS;
    }
    if (backend::syntax::statement_from_code(
            input[first + RETURN_STATEMENT_FIELD])
            != backend::syntax::StatementReturn) { return -1; }
    if (backend::syntax::presence_from_code(
            input[first + RETURN_PRESENCE_FIELD])
            != backend::syntax::Present) { return -1; }
    if (backend::syntax::expression_from_code(
            input[first + RETURN_EXPRESSION_FIELD])
            != backend::syntax::ExprLocal) { return -1; }
    let returned: i32 = input[first + RETURN_LOCAL_FIELD];
    return select_id(parameters, returned);
}

fn select_id(parameters: backend::syntax::FunctionParameters,
    returned: i32) -> i32 {
    let header: backend::syntax::FunctionHeader = parameters.header;
    let count: i32 = header.parameters;
    if (header.kind != backend::syntax::DefinedFunction
        || header.pointer_bits != backend::syntax::POINTER_BITS
        || header.id <= -1
        || !ir::type_ref::same(header.result_type,
            ir::type_ref::I32)
        || parameters.start <= -1 || parameters.start > parameters.length
        || count <= 0 || count > INTEGER_ARGUMENT_REGISTERS
        || count > parameters.length - parameters.start
        || returned <= -1) { return -1; }
    let selected: i32 = -1;
    let index: i32 = 0;
    let values: [backend::syntax::Parameter] = parameters.data;
    while (index != count) {
        let parameter: backend::syntax::Parameter =
            values[parameters.start + index];
        let id: i32 = parameter.id;
        if (id <= -1 || !ir::type_ref::same(parameter.kind,
            ir::type_ref::I32)) {
            return -1;
        }
        let earlier: i32 = 0;
        while (earlier <= index - 1) {
            let prior: backend::syntax::Parameter =
                values[parameters.start + earlier];
            if (prior.id == id) { return -1; }
            earlier += 1;
        }
        if (id == returned) { selected = index; }
        index += 1;
    }
    return selected;
}

pub fn select_event(body: ir::body_events::Region,
    parameters: backend::syntax::FunctionParameters) -> i32 {
    let count: i32 = body.capacity;
    if (count != 2 && count != 4) { return -1; }
    let events: [ir::body_events::Event] = body.events;
    let first: i32 = 0;
    if (count == 4) {
        let sequence: bool = match (events[0]) {
            ir::body_events::StatementSequence -> true,
            _ -> false,
        };
        let skip: bool = match (events[3]) {
            ir::body_events::StatementSkip -> true,
            _ -> false,
        };
        if (!sequence || !skip) { return -1; }
        first = 1;
    }
    let present: bool = match (events[first]) {
        ir::body_events::StatementReturnValue -> true,
        _ -> false,
    };
    if (!present) { return -1; }
    let returned_event: ir::body_events::Event = events[first + 1];
    let returned: i32 = match (returned_event) {
        ir::body_events::ExpressionLocal(reference) -> reference.id + 0,
        _ -> -1,
    };
    return select_id(parameters, returned);
}

// SysV integer arguments, not DWARF register numbers.
pub fn argument_register(position: i32) -> x86::register::Register {
    if (position == 0) { return x86::register::RDI; }
    if (position == 1) { return x86::register::RSI; }
    if (position == 2) { return x86::register::RDX; }
    if (position == 3) { return x86::register::RCX; }
    if (position == 4) { return x86::register::R8; }
    if (position == 5) { return x86::register::R9; }
    return x86::register::InvalidRegister;
}

pub fn compile(input: [i32], length: i32,
    parameters: backend::syntax::FunctionParameters,
    output: [i32], capacity: i32, cursor: i32) -> i32 {
    let selected: i32 = select(input, length, parameters);
    return compile_selected(selected, output, capacity, cursor);
}

pub fn compile_event(body: ir::body_events::Region,
    parameters: backend::syntax::FunctionParameters,
    output: [i32], capacity: i32, cursor: i32) -> i32 {
    let selected: i32 = select_event(body, parameters);
    return compile_selected(selected, output, capacity, cursor);
}

fn compile_selected(selected: i32, output: [i32], capacity: i32,
    cursor: i32) -> i32 {
    if (selected <= -1) { return -1; }
    let source: x86::register::Register = argument_register(selected);
    let size: i32 = LEGACY_ARGUMENT_RETURN_BYTES;
    if (selected >= FIRST_EXTENDED_ARGUMENT) {
        size = EXTENDED_ARGUMENT_RETURN_BYTES;
    }
    // Reserve the entire function before emitting any bytes.
    if (!x86::buffer::fits(capacity, cursor, size)) { return -1; }
    let next: i32 = x86::encode::move_register(output, capacity, cursor,
        x86::register::WIDTH_32, x86::register::RAX, source);
    if (next <= -1) { return -1; }
    return x86::control::return_near(output, capacity, next);
}
