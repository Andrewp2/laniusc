module backend::constant_index;

import backend::literal;
import backend::syntax;
import lowering::allocation;
import lowering::declarations;
import lowering::signature_index;
import lowering::signatures;
import ir::type_ref;
import verified::host;

// Decode Core constants once. A string keeps a span into immutable Core input;
// its bytes are copied to machine code only when a reference is emitted.
const FIELD_BYTES: i32 = 8;
const ROW_BYTES: i32 = 6 * FIELD_BYTES;
pub const ALIGNMENT: i32 = FIELD_BYTES;

pub struct Row {
    id: i32,
    kind: backend::syntax::ValueType,
    low: i32,
    high: i32,
    byte_start: i32,
    byte_count: i32,
}

pub struct Table {
    rows: [Row],
    count: i32,
    bytes: [i32],
    byte_count: i32,
}

pub fn allocation_bytes(count: i32) -> i32 {
    if (count <= -1 || count > verified::host::I32_MAX / ROW_BYTES) {
        return -1;
    }
    if (count == 0) { return FIELD_BYTES; }
    return count * ROW_BYTES;
}

pub fn from_raw_parts(memory: ptr, count: i32,
    bytes: [i32], byte_count: i32) -> Table {
    let first: ptr = memory;
    if (count > 0) { first = memory + count * ROW_BYTES - FIELD_BYTES; }
    return Table {
        rows: slice_from_raw_parts(first, count),
        count: count,
        bytes: bytes,
        byte_count: byte_count,
    };
}

fn find_prefix(table: Table, limit: i32, id: i32) -> i32 {
    let rows: [Row] = table.rows;
    let index: i32 = 0;
    while (index < limit) {
        if (rows[index].id == id) { return index; }
        index += 1;
    }
    return -1;
}

pub fn find(table: Table, id: i32) -> i32 {
    return find_prefix(table, table.count, id);
}

pub fn at(table: Table, index: i32) -> Row {
    let rows: [Row] = table.rows;
    return rows[index];
}

pub fn build(input: [i32], length: i32, start: i32,
    table: Table) -> i32 {
    if (start <= -1 || start > length || table.count <= -1
        || table.count > (length - start)
            / backend::literal::CONSTANT_HEADER_WORDS) { return -1; }
    let rows: [Row] = table.rows;
    let position: i32 = start;
    let index: i32 = 0;
    while (index < table.count) {
        let size: i32 = backend::literal::constant_size(input, length,
            position);
        if (size <= -1) { return -1; }
        let id: i32 = input[position
            + backend::literal::CONSTANT_ID_FIELD];
        if (find_prefix(table, index, id) >= 0) { return -1; }
        let encoded: i32 = input[position
            + backend::literal::CONSTANT_KIND_FIELD];
        let kind: backend::syntax::ValueType = backend::syntax::TypeI32;
        if (backend::syntax::type_is(encoded,
                backend::syntax::TypeBool)) {
            kind = backend::syntax::TypeBool;
        }
        if (backend::syntax::type_is(encoded,
                backend::syntax::TypeUsize)) {
            kind = backend::syntax::TypeUsize;
        }
        if (backend::syntax::type_is(encoded,
                backend::syntax::TypePointer)) {
            kind = backend::syntax::TypePointer;
        }
        if (backend::syntax::type_is(encoded,
                backend::syntax::TypeString)) {
            kind = backend::syntax::TypeString;
        }
        let low: i32 = 0;
        let high: i32 = 0;
        let byte_start: i32 = -1;
        let byte_count: i32 = 0;
        if (kind == backend::syntax::TypeString) {
            byte_start = position
                + backend::literal::CONSTANT_HEADER_WORDS;
            byte_count = input[position
                + backend::literal::CONSTANT_PAYLOAD_FIELD];
        } else {
            low = input[position
                + backend::literal::CONSTANT_PAYLOAD_FIELD];
            high = input[position
                + backend::literal::SCALAR_CONSTANT_HIGH_FIELD];
        }
        rows[index] = Row {
            id: id, kind: kind, low: low, high: high,
            byte_start: byte_start, byte_count: byte_count,
        };
        position += size;
        index += 1;
    }
    return position;
}

pub fn build_native(signatures: lowering::signature_index::Table,
    allocations: lowering::allocation::Table, table: Table) -> bool {
    if (!lowering::allocation::table_has_exact_rows(allocations)
        || table.byte_count != signatures.byte_count) {
        return false;
    }
    let header: lowering::allocation::AllocationHeader =
        lowering::allocation::table_header(allocations);
    if (header.constants != table.count) { return false; }
    let rows: [Row] = table.rows;
    let index: i32 = 0;
    let allocation_index: i32 = 0;
    while (allocation_index < header.rows) {
        let allocation: lowering::allocation::AllocationRow =
            lowering::allocation::table_row(allocations, allocation_index);
        if (lowering::allocation::row_has_kind(allocation,
                lowering::declarations::Constant)) {
            if (index >= table.count) { return false; }
            let declaration: i32 =
                lowering::allocation::row_declaration_id(allocation);
            if (!lowering::signature_index::has_shape(signatures,
                    declaration, lowering::signatures::ConstantShape)) {
                return false;
            }
            let record: lowering::signatures::SignatureRecord =
                lowering::signature_index::record_at(signatures,
                    declaration);
            let id: i32 = lowering::signatures::record_id(record);
            let encoded: i32 = ir::type_ref::code(
                lowering::signatures::record_result_type(record));
            if (id <= -1 || find_prefix(table, index, id) >= 0
                || encoded < backend::syntax::type_code(
                    backend::syntax::TypeI32)
                || encoded > backend::syntax::type_code(
                    backend::syntax::TypeString)) { return false; }
            let kind: backend::syntax::ValueType = backend::syntax::TypeI32;
            if (backend::syntax::type_is(encoded,
                    backend::syntax::TypeBool)) {
                kind = backend::syntax::TypeBool;
            }
            if (backend::syntax::type_is(encoded,
                    backend::syntax::TypeUsize)) {
                kind = backend::syntax::TypeUsize;
            }
            if (backend::syntax::type_is(encoded,
                    backend::syntax::TypePointer)) {
                kind = backend::syntax::TypePointer;
            }
            if (backend::syntax::type_is(encoded,
                    backend::syntax::TypeString)) {
                kind = backend::syntax::TypeString;
            }
            let constant: lowering::signature_index::ConstantValue =
                lowering::signature_index::constant_at(signatures,
                    declaration);
            let low: i32 = 0;
            let high: i32 = 0;
            let byte_start: i32 = -1;
            let byte_count: i32 = 0;
            if (kind == backend::syntax::TypeString) {
                if (constant.encoding
                        != lowering::signature_index::StringConstant
                    || constant.byte_start <= -1
                    || constant.byte_count <= -1
                    || constant.byte_start > signatures.byte_count
                        - constant.byte_count) {
                    return false;
                }
                byte_start = constant.byte_start;
                byte_count = constant.byte_count;
                let byte: i32 = 0;
                while (byte < byte_count) {
                    let value: i32 =
                        lowering::signature_index::constant_byte(signatures,
                            declaration, byte);
                    if (value <= -1 || value > verified::host::BYTE_MASK) {
                        return false;
                    }
                    byte += 1;
                }
            } else {
                if (constant.encoding
                        != lowering::signature_index::ScalarConstant
                    || (kind == backend::syntax::TypeBool
                        && !backend::syntax::valid_boolean(constant.low))
                    || ((kind == backend::syntax::TypeI32
                            || kind == backend::syntax::TypeBool)
                        && constant.high != 0)) {
                    return false;
                }
                low = constant.low;
                high = constant.high;
            }
            rows[index] = Row {
                id: id, kind: kind, low: low, high: high,
                byte_start: byte_start, byte_count: byte_count,
            };
            index += 1;
        }
        allocation_index += 1;
    }
    return index == table.count;
}
