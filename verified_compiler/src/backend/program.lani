module backend::program;
import backend::compile;
import backend::frame;
import backend::layout_index;
import backend::constant_index;
import backend::function_index;
import backend::call;
import backend::syntax;
import backend::literal;
import ir::body_events;
import ir::body_catalog;
import ir::constant_catalog;
import ir::function_catalog;
import ir::program;
import ir::type_catalog;
import x86::control;
import runtime::service;
import runtime::string;
import verified::host;

type ProgramIR = ir::program::Program;

// A standalone backend invocation reads serialized Core. The compiler instead
// supplies typed catalogs and events; serialized Core is only a certificate
// output in that path. Keep this choice explicit rather than inferring it from
// an empty catalog or a dummy Core region.
pub struct CoreSource {
    program: backend::compile::WordRegion,
    function_workspace: backend::compile::WordRegion,
}

pub enum Source {
    SerializedCore(CoreSource),
    TypedProgram(ProgramIR),
}

pub fn core(program: backend::compile::WordRegion,
    function_workspace: backend::compile::WordRegion) -> Source {
    let input: CoreSource = CoreSource {
        program: program, function_workspace: function_workspace,
    };
    return SerializedCore(input);
}

pub fn typed(program: ir::program::Program) -> Source {
    return TypedProgram(program);
}

pub fn is_typed(source: Source) -> bool {
    return match (source) {
        SerializedCore(core_value) -> false,
        TypedProgram(typed_value) -> true,
    };
}

fn core_input(source: Source) -> CoreSource {
    let nowhere: ptr = 0;
    let empty_words: [i32] = slice_from_raw_parts(nowhere, 0);
    let absent: CoreSource = CoreSource {
        program: backend::compile::region(empty_words, 0),
        function_workspace: backend::compile::region(empty_words, 0),
    };
    return match (source) {
        SerializedCore(core_value) -> core_value,
        TypedProgram(typed_value) -> absent,
    };
}

fn typed_input(source: Source) -> ir::program::Program {
    return match (source) {
        SerializedCore(core_value) -> ir::program::empty(),
        TypedProgram(typed_value) -> typed_value,
    };
}
fn native_stride(bodies: ir::body_catalog::Catalog,
    functions: ir::function_catalog::Table) -> i32 {
    // One event can create at most one local binding, call fixup, or break
    // patch. Parameters and function positions occupy their own regions.
    let remaining: i32 = backend::compile::MAX_WORDS
        - backend::syntax::PROGRAM_HEADER_WORDS;
    if (functions.count <= 0 || functions.count > remaining
        || functions.parameter_count <= -1) { return -1; }
    remaining -= functions.count;
    if (functions.parameter_count > remaining) { return -1; }
    remaining -= functions.parameter_count;
    let count: i32 = ir::body_catalog::length(bodies);
    let index: i32 = 0;
    while (index < count) {
        let body: ir::body_catalog::FunctionBody =
            ir::body_catalog::at(bodies, index);
        if (body.tree.count <= 0 || body.tree.count > remaining) {
            return -1;
        }
        remaining -= body.tree.count;
        index += 1;
    }
    return backend::compile::MAX_WORDS - remaining;
}

pub fn compile(source: Source, workspace: backend::frame::Workspace,
    destination: backend::compile::CodeCursor) -> i32 {
    let native_mode: bool = is_typed(source);
    let core_data: CoreSource = core_input(source);
    let typed_data: ir::program::Program = typed_input(source);
    let input: [i32] = core_data.program.data;
    let length: i32 = core_data.program.words;
    let function_input: [i32] = core_data.function_workspace.data;
    let function_capacity: i32 = core_data.function_workspace.words;
    let bodies: ir::body_catalog::Catalog = typed_data.bodies;
    let work: backend::frame::Workspace = workspace;
    let state: [backend::frame::State] = backend::frame::state_view(work);
    let work_length: i32 = workspace.words;
    let output: [i32] = destination.data;
    let capacity: i32 = destination.capacity;
    let cursor: i32 = destination.position;
    let typed_count: i32 = ir::body_catalog::length(bodies);
    if (native_mode && (typed_count <= 0 || typed_count > bodies.capacity
        || !ir::program::valid(typed_data))) { return -1; }
    let native_types: ir::type_catalog::Table = typed_data.types;
    let native_constants: ir::constant_catalog::Table =
        typed_data.constants;
    let native_functions: ir::function_catalog::Table = typed_data.functions;
    let stride: i32 = length;
    if (native_mode) {
        stride = native_stride(bodies, native_functions);
    } else {
        if (length <= backend::syntax::PROGRAM_HEADER_WORDS - 1
            || length > backend::compile::MAX_WORDS
            || length > function_capacity) { return -1; }
    }
    if (stride <= backend::syntax::PROGRAM_HEADER_WORDS - 1
        || stride > backend::compile::MAX_WORDS
        || backend::frame::HEADER + stride
            * backend::frame::WORK_WORDS_PER_STRIDE
        > work_length) { return -1; }
    let header: backend::syntax::ProgramHeader;
    if (native_mode) {
        header = backend::syntax::ProgramHeader {
            version: backend::syntax::PROGRAM_VERSION,
            pointer_bits: backend::syntax::POINTER_BITS,
            entry: typed_data.entrypoint,
            types: native_types.type_count,
            constants: native_constants.count,
            functions: native_functions.count,
        };
    } else {
        header = backend::syntax::read_program_header(input);
    }
    let entry_id: i32 = header.entry;
    let type_count: i32 = header.types;
    let constant_count: i32 = header.constants;
    let function_count: i32 = header.functions;
    if (header.version != backend::syntax::PROGRAM_VERSION
        || header.pointer_bits != backend::syntax::POINTER_BITS
        || entry_id <= -1 || type_count <= -1 || constant_count <= -1
        || function_count <= 0) { return -1; }
    state[0].stride = stride;
    state[0].fixup_count = 0;
    state[0].function_count = 0;
    let required: backend::layout_index::Requirements;
    if (native_mode) {
        required = backend::layout_index::measure_typed(native_types);
    } else {
        required = backend::layout_index::measure(input, length);
    }
    if (!required.valid) { return -1; }
    if (required.types != type_count) { return -1; }
    let position: i32 = 0;
    if (!native_mode) { position = required.type_end; }
    let index: i32 = 0;
    let constant_bytes: i32 =
        backend::constant_index::allocation_bytes(constant_count);
    if (constant_bytes <= 0
        || (!native_mode
            && constant_count > (length - position)
                / backend::literal::CONSTANT_HEADER_WORDS)) { return -1; }
    let constant_memory: ptr = verified::host::alloc(constant_bytes,
        backend::constant_index::ALIGNMENT);
    if (constant_memory == 0) { return -1; }
    let constants: backend::constant_index::Table;
    if (native_mode) {
        constants = backend::constant_index::from_raw_parts(
            constant_memory, constant_count, native_constants.bytes,
            native_constants.byte_count);
        if (!backend::constant_index::build_typed(native_constants,
                constants)) { return -1; }
    } else {
        constants = backend::constant_index::from_raw_parts(
            constant_memory, constant_count, input, length);
        position = backend::constant_index::build(input, length, position,
            constants);
    }
    if (!native_mode && position <= -1) { return -1; }
    let function_requirements: backend::function_index::Requirements;
    if (native_mode) {
        function_requirements = backend::function_index::measure_native(
            native_functions);
    } else {
        function_requirements = backend::function_index::measure(input,
            length, position, function_count);
    }
    if (!function_requirements.valid
        || (!native_mode
            && function_requirements.end != length)) { return -1; }
    let function_bytes: i32 = backend::function_index::allocation_bytes(
        function_requirements);
    if (function_bytes <= 0) { return -1; }
    let function_memory: ptr = verified::host::alloc(function_bytes,
        backend::function_index::ALIGNMENT);
    if (function_memory == 0) { return -1; }
    let functions: backend::function_index::Table =
        backend::function_index::from_raw_parts(function_memory,
            function_requirements);
    if (native_mode) {
        if (!backend::function_index::build_native(native_functions,
                functions)) { return -1; }
    } else {
        if (!backend::function_index::build(input, length, position,
                functions)) { return -1; }
    }
    state[0].function_count = function_count;
    if (!native_mode) {
        index = 0;
        while (index < function_count) {
            let function: backend::function_index::Function =
                backend::function_index::at(functions, index);
            backend::frame::set_function_input_offset(work, index,
                function.input_offset);
            index += 1;
        }
    }
    let entry: i32 = backend::function_index::find(functions, entry_id);
    if (entry <= -1) { return -1; }
    state[0].entry_index = entry;
    let layout_bytes: i32 = backend::layout_index::allocation_bytes(required);
    if (layout_bytes <= 0) { return -1; }
    let layout_memory: ptr = verified::host::alloc(layout_bytes,
        backend::layout_index::ALIGNMENT);
    if (layout_memory == 0) { return -1; }
    let layout: backend::layout_index::Table =
        backend::layout_index::from_raw_parts(layout_memory, required);
    if (native_mode) {
        if (!backend::layout_index::build_typed(native_types, layout)) {
            return -1;
        }
    } else {
        if (!backend::layout_index::build(input, length, layout)) {
            return -1;
        }
    }
    let next: i32 = x86::control::jump(output, capacity, cursor, 0);
    let used_bodies: i32 = 0;
    index = 0;
    while (index != state[0].function_count) {
        if (next <= -1) { return -1; }
        let function: backend::function_index::Function =
            backend::function_index::at(functions, index);
        let first: i32 = function.input_offset;
        backend::frame::set_function_code_start(work, index, next);
        let header: backend::syntax::FunctionHeader = function.header;
        if (header.kind == backend::syntax::RuntimeFunction) {
            next = runtime::service::emit(output, capacity, next,
                function.service);
        } else {
            let emitted: i32 = -1;
            if (native_mode) {
                let body_index: i32 = ir::body_catalog::find(bodies,
                    header.id);
                if (body_index <= -1) { return -1; }
                let body: ir::body_catalog::FunctionBody =
                    ir::body_catalog::at(bodies, body_index);
                let events: ir::body_events::Region =
                    ir::body_events::region(body.tree.events,
                        body.tree.count);
                emitted = backend::compile::function_events(events,
                    function, workspace,
                    backend::compile::cursor(output, capacity, next),
                    layout, constants, functions);
                used_bodies += 1;
            } else {
                let body_start: i32 = first
                    + backend::syntax::FUNCTION_HEADER_WORDS
                    + header.parameters
                        * backend::syntax::PARAMETER_ROW_WORDS;
                let word: i32 = 0;
                while (word != header.body_words) {
                    function_input[word] = input[body_start + word];
                    word += 1;
                }
                emitted = backend::compile::function(
                    backend::compile::region(function_input,
                        header.body_words), function, workspace,
                    backend::compile::cursor(output, capacity, next),
                    layout, constants, functions);
            }
            next = emitted;
        }
        index += 1;
    }
    if (native_mode && used_bodies != typed_count) { return -1; }
    if (next <= -1) { return -1; }
    // Keep the function region boundary before any runtime data is appended.
    // Certificate mode derives ordered start/length pairs from these slots.
    state[0].function_end = next;
    let string_pointer: i32 = -1;
    index = 0;
    while (index != state[0].fixup_count) {
        let fixup: backend::call::CallFixup = backend::call::read_fixup(
            work, index);
        if (fixup.target == -1
            && string_pointer <= -1) {
            string_pointer = next;
            next = runtime::string::pointer(output, capacity, next);
            if (next <= -1) { return -1; }
        }
        index += 1;
    }
    let entry_code: i32 = backend::frame::function_code_start(work, entry);
    if (x86::control::patch_relative(output, next, cursor + 1, entry_code) <= -1) { return -1; }
    index = 0;
    while (index != state[0].fixup_count) {
        let fixup: backend::call::CallFixup = backend::call::read_fixup(
            work, index);
        let id: i32 = fixup.target;
        let target_code: i32 = string_pointer;
        if (id != -1) {
            let target: i32 = backend::function_index::find(functions, id);
            if (target <= -1) { return -1; }
            target_code = backend::frame::function_code_start(work, target);
        }
        if (x86::control::patch_relative(output, next, fixup.field,
            target_code) <= -1) { return -1; }
        index += 1;
    }
    return next;
}
