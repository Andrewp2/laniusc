module backend::call;
import backend::frame;
import backend::layout;
import backend::parameter;
import backend::value;
import x86::register;
import x86::encode;
import x86::control;

pub struct CallFixup {
    field: i32,
    target: i32,
}

fn slice_from_raw_parts(data: ptr, length: i32) -> [CallFixup] {
    return slice_from_raw_parts(data, length);
}

fn fixup_table(work: backend::frame::Workspace) -> [CallFixup] {
    let state: [backend::frame::State] = backend::frame::state_view(work);
    return slice_from_raw_parts(backend::frame::call_fixup_first(work),
        state[0].stride);
}

pub fn read_fixup(work: backend::frame::Workspace, index: i32) -> CallFixup {
    let fixups: [CallFixup] = fixup_table(work);
    return CallFixup {
        field: fixups[index].field,
        target: fixups[index].target,
    };
}

// Arguments are already in ABI locations. Nonnegative targets are Core IDs;
// -1 names the backend-generated fresh string-data helper, not a Core function.
pub fn relative(output: [i32], capacity: i32, work: backend::frame::Workspace, target: i32) -> i32 {
    let state: [backend::frame::State] = backend::frame::state_view(work);
    let fixup: i32 = state[0].fixup_count;
    if (fixup >= state[0].stride
        || state[0].code <= -1) {
        state[0].failed = 1;
        return -1;
    }
    let fixups: [CallFixup] = fixup_table(work);
    fixups[fixup].field = state[0].code + 1;
    fixups[fixup].target = target;
    state[0].fixup_count = fixup + 1;
    state[0].code = x86::control::call(output, capacity, state[0].code, 0);
    return state[0].code;
}

// All arguments are evaluated and copied before assigning ABI registers.
// Each scalar or aggregate-address argument occupies one ABI word. Padding
// precedes reversed stack arguments, keeping RSP aligned immediately at CALL.
pub fn emit(output: [i32], capacity: i32, work: backend::frame::Workspace, slot: i32, count: i32, target: i32) -> i32 {
    let state: [backend::frame::State] = backend::frame::state_view(work);
    let extras: i32 = 0;
    if (count > backend::parameter::INTEGER_ARGUMENT_REGISTERS) {
        extras = count - backend::parameter::INTEGER_ARGUMENT_REGISTERS;
    }
    let padding: i32 = (extras % 2) * backend::layout::VALUE_WORD_BYTES;
    if (padding != 0) {
        let next: i32 = x86::encode::immediate(output, capacity, state[0].code, x86::register::WIDTH_32, x86::register::R11, padding, 0);
        state[0].code = x86::encode::binary(output, capacity, next, x86::register::WIDTH_64, x86::encode::Subtract, x86::register::RSP, x86::register::R11);
    }
    let index: i32 = count;
    while (index > backend::parameter::INTEGER_ARGUMENT_REGISTERS) {
        index -= 1;
        backend::value::load_word(output, capacity, work, slot - index, x86::register::RAX);
        state[0].code = x86::control::push(output, capacity, state[0].code, x86::register::RAX);
    }
    index = 0;
    while (index < count
        && index < backend::parameter::INTEGER_ARGUMENT_REGISTERS) {
        backend::value::load_word(output, capacity, work, slot - index, backend::parameter::argument_register(index));
        index += 1;
    }
    if (relative(output, capacity, work, target) <= -1) { return -1; }
    let reclaimed: i32 = extras * backend::layout::VALUE_WORD_BYTES + padding;
    if (reclaimed != 0) {
        let next: i32 = x86::encode::immediate(output, capacity, state[0].code, x86::register::WIDTH_32, x86::register::R11, reclaimed, 0);
        state[0].code = x86::encode::binary(output, capacity, next, x86::register::WIDTH_64, x86::encode::Add, x86::register::RSP, x86::register::R11);
    }
    return state[0].code;
}
