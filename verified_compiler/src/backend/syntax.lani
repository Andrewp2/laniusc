module backend::syntax;

import ir::body_events;
import ir::type_ref;

// Core is serialized into i32 buffers at the lowering/backend boundary. The
// compiler uses enums for every semantic category and converts to an integer
// only when it reads or writes that representation.
pub const NOMINAL_TYPE_BASE: i32 = ir::type_ref::NOMINAL_BASE;
pub fn nominal_type(type_id: i32) -> i32 {
    let nominal: ir::type_ref::TypeRef = ir::type_ref::Nominal(type_id);
    return ir::type_ref::code(nominal);
}
pub const PROGRAM_VERSION: i32 = 3;
pub const FUNCTION_VERSION: i32 = 1;
pub const POINTER_BITS: i32 = 64;
pub const PROGRAM_HEADER_WORDS: i32 = 6;
pub const FUNCTION_HEADER_WORDS: i32 = 6;
pub const PARAMETER_ROW_WORDS: i32 = 2;
pub const FUNCTION_RECORD_PREFIX_WORDS: i32 = 1;
const PROGRAM_VERSION_FIELD: i32 = 0;
const PROGRAM_POINTER_BITS_FIELD: i32 = 1;
const PROGRAM_ENTRY_FIELD: i32 = 2;
const PROGRAM_TYPE_COUNT_FIELD: i32 = 3;
const PROGRAM_CONSTANT_COUNT_FIELD: i32 = 4;
const PROGRAM_FUNCTION_COUNT_FIELD: i32 = 5;
const FUNCTION_KIND_FIELD: i32 = 0;
const FUNCTION_POINTER_BITS_FIELD: i32 = 1;
const FUNCTION_ID_FIELD: i32 = 2;
const FUNCTION_RESULT_TYPE_FIELD: i32 = 3;
const FUNCTION_PARAMETER_COUNT_FIELD: i32 = 4;
const FUNCTION_BODY_WORDS_FIELD: i32 = 5;
pub const PARAMETER_ID_FIELD: i32 = 0;
pub const PARAMETER_TYPE_FIELD: i32 = 1;

pub struct ProgramHeader {
    version: i32,
    pointer_bits: i32,
    entry: i32,
    types: i32,
    constants: i32,
    functions: i32,
}

pub fn read_program_header(input: [i32]) -> ProgramHeader {
    let version: i32 = input[PROGRAM_VERSION_FIELD];
    let pointer_bits: i32 = input[PROGRAM_POINTER_BITS_FIELD];
    let entry: i32 = input[PROGRAM_ENTRY_FIELD];
    let types: i32 = input[PROGRAM_TYPE_COUNT_FIELD];
    let constants: i32 = input[PROGRAM_CONSTANT_COUNT_FIELD];
    let functions: i32 = input[PROGRAM_FUNCTION_COUNT_FIELD];
    return ProgramHeader {
        version: version, pointer_bits: pointer_bits, entry: entry,
        types: types, constants: constants, functions: functions,
    };
}

pub fn write_program_header(output: [i32], header: ProgramHeader) {
    output[PROGRAM_VERSION_FIELD] = header.version;
    output[PROGRAM_POINTER_BITS_FIELD] = header.pointer_bits;
    output[PROGRAM_ENTRY_FIELD] = header.entry;
    output[PROGRAM_TYPE_COUNT_FIELD] = header.types;
    output[PROGRAM_CONSTANT_COUNT_FIELD] = header.constants;
    output[PROGRAM_FUNCTION_COUNT_FIELD] = header.functions;
}

pub fn program_type_count(input: [i32]) -> i32 {
    return input[PROGRAM_TYPE_COUNT_FIELD];
}

pub fn program_entry(input: [i32]) -> i32 {
    return input[PROGRAM_ENTRY_FIELD];
}

pub fn set_program_entry(output: [i32], entry: i32) {
    output[PROGRAM_ENTRY_FIELD] = entry;
}

pub enum FunctionRecordKind {
    InvalidFunction,
    DefinedFunction,
    RuntimeFunction,
}

pub fn function_code(kind: FunctionRecordKind) -> i32 {
    return match (kind) {
        InvalidFunction -> 0,
        DefinedFunction -> 1,
        RuntimeFunction -> 2,
    };
}

pub fn function_is(encoded: i32, expected: FunctionRecordKind) -> bool {
    return encoded == function_code(expected);
}

pub fn function_from_code(encoded: i32) -> FunctionRecordKind {
    if (function_is(encoded, DefinedFunction)) { return DefinedFunction; }
    if (function_is(encoded, RuntimeFunction)) { return RuntimeFunction; }
    return InvalidFunction;
}

pub struct FunctionHeader {
    kind: FunctionRecordKind,
    pointer_bits: i32,
    id: i32,
    result_type: ir::type_ref::TypeRef,
    parameters: i32,
    body_words: i32,
}

pub struct Parameter {
    id: i32,
    kind: ir::type_ref::TypeRef,
}

// A decoded function's parameter span in the native parameter catalog.
pub struct FunctionParameters {
    header: FunctionHeader,
    data: [Parameter],
    start: i32,
    length: i32,
}

pub fn read_function_header(input: [i32], position: i32)
    -> FunctionHeader {
    let kind: FunctionRecordKind = function_from_code(
        input[position + FUNCTION_KIND_FIELD]);
    let pointer_bits: i32 = input[position + FUNCTION_POINTER_BITS_FIELD];
    let id: i32 = input[position + FUNCTION_ID_FIELD];
    let result_type: ir::type_ref::TypeRef = ir::type_ref::from_code(
        input[position + FUNCTION_RESULT_TYPE_FIELD]);
    let parameters: i32 = input[position + FUNCTION_PARAMETER_COUNT_FIELD];
    let body_words: i32 = input[position + FUNCTION_BODY_WORDS_FIELD];
    return FunctionHeader {
        kind: kind, pointer_bits: pointer_bits, id: id,
        result_type: result_type, parameters: parameters,
        body_words: body_words,
    };
}

pub fn write_function_header(output: [i32], position: i32,
    header: FunctionHeader) {
    output[position + FUNCTION_KIND_FIELD] = function_code(header.kind);
    output[position + FUNCTION_POINTER_BITS_FIELD] = header.pointer_bits;
    output[position + FUNCTION_ID_FIELD] = header.id;
    output[position + FUNCTION_RESULT_TYPE_FIELD] =
        ir::type_ref::code(header.result_type);
    output[position + FUNCTION_PARAMETER_COUNT_FIELD] = header.parameters;
    output[position + FUNCTION_BODY_WORDS_FIELD] = header.body_words;
}

pub fn function_id_at(input: [i32], position: i32) -> i32 {
    return input[position + FUNCTION_ID_FIELD];
}

pub fn set_function_body_words_at(output: [i32], position: i32,
    body_words: i32) {
    output[position + FUNCTION_BODY_WORDS_FIELD] = body_words;
}

pub enum Presence {
    InvalidPresence,
    Absent,
    Present,
}

pub fn presence_code(value: Presence) -> i32 {
    return match (value) {
        InvalidPresence -> -1,
        Absent -> 0,
        Present -> 1,
    };
}

pub fn presence_from_code(encoded: i32) -> Presence {
    if (encoded == presence_code(Absent)) { return Absent; }
    if (encoded == presence_code(Present)) { return Present; }
    return InvalidPresence;
}

pub fn valid_boolean(encoded: i32) -> bool {
    return encoded == 0 || encoded == 1;
}

pub fn boolean_code(value: bool) -> i32 {
    if (value) { return 1; }
    return 0;
}

pub enum TypeLayoutKind {
    StructureLayout,
    EnumerationLayout,
}

pub fn layout_code(kind: TypeLayoutKind) -> i32 {
    return match (kind) {
        StructureLayout -> 0,
        EnumerationLayout -> 1,
    };
}

pub fn layout_is(encoded: i32, expected: TypeLayoutKind) -> bool {
    return encoded == layout_code(expected);
}

pub enum ValueType {
    TypeI32,
    TypeBool,
    TypeUsize,
    TypePointer,
    TypeString,
    TypeSlice,
}

pub fn value_type_ref(kind: ValueType) -> ir::type_ref::TypeRef {
    return match (kind) {
        TypeI32 -> ir::type_ref::I32,
        TypeBool -> ir::type_ref::Bool,
        TypeUsize -> ir::type_ref::Usize,
        TypePointer -> ir::type_ref::Pointer,
        TypeString -> ir::type_ref::String,
        TypeSlice -> ir::type_ref::Slice,
    };
}

pub fn type_code(kind: ValueType) -> i32 {
    return ir::type_ref::code(value_type_ref(kind));
}

pub fn type_is(encoded: i32, expected: ValueType) -> bool {
    return encoded == type_code(expected);
}

pub fn scalar(encoded: i32) -> bool {
    return type_is(encoded, TypeI32) || type_is(encoded, TypeBool);
}

pub enum ExpressionKind {
    InvalidExpression,
    ExprValue,
    ExprLocal,
    ExprCast,
    ExprUnary,
    ExprBinary,
    ExprIndex,
    ExprStruct,
    ExprField,
    ExprAssign,
    ExprConstant,
    ExprCall,
    ExprSliceFromRawParts,
    ExprSliceDataPointer,
    ExprStringDataPointer,
    ExprEnumeration,
    ExprEnumTag,
    ExprEnumField,
    ExprMatch,
    ExprTypedSliceFromRawParts,
}

pub fn expression_code(kind: ExpressionKind) -> i32 {
    return match (kind) {
        InvalidExpression -> -1,
        ExprValue -> 0,
        ExprLocal -> 1,
        ExprCast -> 2,
        ExprUnary -> 3,
        ExprBinary -> 4,
        ExprIndex -> 7,
        ExprStruct -> 8,
        ExprField -> 9,
        ExprAssign -> 12,
        ExprConstant -> 13,
        ExprCall -> 14,
        ExprSliceFromRawParts -> 15,
        ExprSliceDataPointer -> 16,
        ExprStringDataPointer -> 17,
        ExprEnumeration -> 18,
        ExprEnumTag -> 19,
        ExprEnumField -> 20,
        ExprMatch -> 21,
        ExprTypedSliceFromRawParts -> 22,
    };
}

pub fn expression_from_code(encoded: i32) -> ExpressionKind {
    if (encoded == expression_code(ExprValue)) { return ExprValue; }
    if (encoded == expression_code(ExprLocal)) { return ExprLocal; }
    if (encoded == expression_code(ExprCast)) { return ExprCast; }
    if (encoded == expression_code(ExprUnary)) { return ExprUnary; }
    if (encoded == expression_code(ExprBinary)) { return ExprBinary; }
    if (encoded == expression_code(ExprIndex)) { return ExprIndex; }
    if (encoded == expression_code(ExprStruct)) { return ExprStruct; }
    if (encoded == expression_code(ExprField)) { return ExprField; }
    if (encoded == expression_code(ExprAssign)) { return ExprAssign; }
    if (encoded == expression_code(ExprConstant)) { return ExprConstant; }
    if (encoded == expression_code(ExprCall)) { return ExprCall; }
    if (encoded == expression_code(ExprSliceFromRawParts)) { return ExprSliceFromRawParts; }
    if (encoded == expression_code(ExprSliceDataPointer)) { return ExprSliceDataPointer; }
    if (encoded == expression_code(ExprStringDataPointer)) { return ExprStringDataPointer; }
    if (encoded == expression_code(ExprEnumeration)) { return ExprEnumeration; }
    if (encoded == expression_code(ExprEnumTag)) { return ExprEnumTag; }
    if (encoded == expression_code(ExprEnumField)) { return ExprEnumField; }
    if (encoded == expression_code(ExprMatch)) { return ExprMatch; }
    if (encoded == expression_code(ExprTypedSliceFromRawParts)) { return ExprTypedSliceFromRawParts; }
    return InvalidExpression;
}

pub enum PlaceKind {
    InvalidPlace,
    PlaceLocal,
    PlaceField,
    PlaceIndex,
}

pub fn place_code(kind: PlaceKind) -> i32 {
    return match (kind) {
        InvalidPlace -> -1,
        PlaceLocal -> 0,
        PlaceField -> 1,
        PlaceIndex -> 2,
    };
}

pub fn place_from_code(encoded: i32) -> PlaceKind {
    if (encoded == place_code(PlaceLocal)) { return PlaceLocal; }
    if (encoded == place_code(PlaceField)) { return PlaceField; }
    if (encoded == place_code(PlaceIndex)) { return PlaceIndex; }
    return InvalidPlace;
}

pub enum StatementKind {
    InvalidStatement,
    StatementSkip,
    StatementExpression,
    StatementSequence,
    StatementLet,
    StatementLetUninitialized,
    StatementIf,
    StatementWhile,
    StatementReturn,
    StatementBreak,
    StatementContinue,
}

pub fn statement_code(kind: StatementKind) -> i32 {
    return match (kind) {
        InvalidStatement -> -1,
        StatementSkip -> 0,
        StatementExpression -> 1,
        StatementSequence -> 2,
        StatementLet -> 3,
        StatementLetUninitialized -> 4,
        StatementIf -> 5,
        StatementWhile -> 6,
        StatementReturn -> 10,
        StatementBreak -> 11,
        StatementContinue -> 12,
    };
}

pub fn statement_from_code(encoded: i32) -> StatementKind {
    if (encoded == statement_code(StatementSkip)) { return StatementSkip; }
    if (encoded == statement_code(StatementExpression)) { return StatementExpression; }
    if (encoded == statement_code(StatementSequence)) { return StatementSequence; }
    if (encoded == statement_code(StatementLet)) { return StatementLet; }
    if (encoded == statement_code(StatementLetUninitialized)) { return StatementLetUninitialized; }
    if (encoded == statement_code(StatementIf)) { return StatementIf; }
    if (encoded == statement_code(StatementWhile)) { return StatementWhile; }
    if (encoded == statement_code(StatementReturn)) { return StatementReturn; }
    if (encoded == statement_code(StatementBreak)) { return StatementBreak; }
    if (encoded == statement_code(StatementContinue)) { return StatementContinue; }
    return InvalidStatement;
}

pub enum UnaryOperation {
    UnaryPositive,
    UnaryNot,
    UnaryNegate,
    InvalidUnaryOperation,
}

pub fn unary_code(operation: UnaryOperation) -> i32 {
    return match (operation) {
        UnaryPositive -> 0,
        UnaryNot -> 1,
        UnaryNegate -> 2,
        InvalidUnaryOperation -> -1,
    };
}

pub fn unary_from_code(encoded: i32) -> UnaryOperation {
    if (encoded == unary_code(UnaryPositive)) { return UnaryPositive; }
    if (encoded == unary_code(UnaryNot)) { return UnaryNot; }
    if (encoded == unary_code(UnaryNegate)) { return UnaryNegate; }
    return InvalidUnaryOperation;
}

pub enum BinaryOperation {
    BinaryAndThen,
    BinaryOrElse,
    BinaryEqual,
    BinaryNotEqual,
    BinaryLess,
    BinaryLessEqual,
    BinaryGreater,
    BinaryGreaterEqual,
    BinaryAdd,
    BinarySubtract,
    BinaryMultiply,
    BinaryDivide,
    BinaryRemainder,
    BinaryBitAnd,
    BinaryBitOr,
    BinaryBitXor,
    BinaryShiftLeft,
    BinaryShiftRight,
    InvalidBinaryOperation,
}

pub fn binary_code(operation: BinaryOperation) -> i32 {
    return match (operation) {
        BinaryAndThen -> 0,
        BinaryOrElse -> 1,
        BinaryEqual -> 2,
        BinaryNotEqual -> 3,
        BinaryLess -> 4,
        BinaryLessEqual -> 5,
        BinaryGreater -> 6,
        BinaryGreaterEqual -> 7,
        BinaryAdd -> 8,
        BinarySubtract -> 9,
        BinaryMultiply -> 10,
        BinaryDivide -> 11,
        BinaryRemainder -> 12,
        BinaryBitAnd -> 13,
        BinaryBitOr -> 14,
        BinaryBitXor -> 15,
        BinaryShiftLeft -> 16,
        BinaryShiftRight -> 17,
        InvalidBinaryOperation -> -1,
    };
}

pub fn binary_from_code(encoded: i32) -> BinaryOperation {
    if (encoded == binary_code(BinaryAndThen)) { return BinaryAndThen; }
    if (encoded == binary_code(BinaryOrElse)) { return BinaryOrElse; }
    if (encoded == binary_code(BinaryEqual)) { return BinaryEqual; }
    if (encoded == binary_code(BinaryNotEqual)) { return BinaryNotEqual; }
    if (encoded == binary_code(BinaryLess)) { return BinaryLess; }
    if (encoded == binary_code(BinaryLessEqual)) { return BinaryLessEqual; }
    if (encoded == binary_code(BinaryGreater)) { return BinaryGreater; }
    if (encoded == binary_code(BinaryGreaterEqual)) { return BinaryGreaterEqual; }
    if (encoded == binary_code(BinaryAdd)) { return BinaryAdd; }
    if (encoded == binary_code(BinarySubtract)) { return BinarySubtract; }
    if (encoded == binary_code(BinaryMultiply)) { return BinaryMultiply; }
    if (encoded == binary_code(BinaryDivide)) { return BinaryDivide; }
    if (encoded == binary_code(BinaryRemainder)) { return BinaryRemainder; }
    if (encoded == binary_code(BinaryBitAnd)) { return BinaryBitAnd; }
    if (encoded == binary_code(BinaryBitOr)) { return BinaryBitOr; }
    if (encoded == binary_code(BinaryBitXor)) { return BinaryBitXor; }
    if (encoded == binary_code(BinaryShiftLeft)) { return BinaryShiftLeft; }
    if (encoded == binary_code(BinaryShiftRight)) { return BinaryShiftRight; }
    return InvalidBinaryOperation;
}

pub fn binary_is_comparison(operation: BinaryOperation) -> bool {
    return operation == BinaryEqual || operation == BinaryNotEqual
        || operation == BinaryLess || operation == BinaryLessEqual
        || operation == BinaryGreater || operation == BinaryGreaterEqual;
}

pub enum AssignmentOperation {
    AssignmentSet,
    AssignmentAdd,
    AssignmentSubtract,
    AssignmentMultiply,
    AssignmentDivide,
    AssignmentRemainder,
    AssignmentBitXor,
    AssignmentShiftLeft,
    AssignmentShiftRight,
    AssignmentBitAnd,
    AssignmentBitOr,
    InvalidAssignmentOperation,
}

pub fn assignment_code(operation: AssignmentOperation) -> i32 {
    return match (operation) {
        AssignmentSet -> 0,
        AssignmentAdd -> 1,
        AssignmentSubtract -> 2,
        AssignmentMultiply -> 3,
        AssignmentDivide -> 4,
        AssignmentRemainder -> 5,
        AssignmentBitXor -> 6,
        AssignmentShiftLeft -> 7,
        AssignmentShiftRight -> 8,
        AssignmentBitAnd -> 9,
        AssignmentBitOr -> 10,
        InvalidAssignmentOperation -> -1,
    };
}

pub fn assignment_from_code(encoded: i32) -> AssignmentOperation {
    if (encoded == assignment_code(AssignmentSet)) { return AssignmentSet; }
    if (encoded == assignment_code(AssignmentAdd)) { return AssignmentAdd; }
    if (encoded == assignment_code(AssignmentSubtract)) { return AssignmentSubtract; }
    if (encoded == assignment_code(AssignmentMultiply)) { return AssignmentMultiply; }
    if (encoded == assignment_code(AssignmentDivide)) { return AssignmentDivide; }
    if (encoded == assignment_code(AssignmentRemainder)) { return AssignmentRemainder; }
    if (encoded == assignment_code(AssignmentBitXor)) { return AssignmentBitXor; }
    if (encoded == assignment_code(AssignmentShiftLeft)) { return AssignmentShiftLeft; }
    if (encoded == assignment_code(AssignmentShiftRight)) { return AssignmentShiftRight; }
    if (encoded == assignment_code(AssignmentBitAnd)) { return AssignmentBitAnd; }
    if (encoded == assignment_code(AssignmentBitOr)) { return AssignmentBitOr; }
    return InvalidAssignmentOperation;
}

pub fn unary_event_operation(event: ir::body_events::Event)
    -> UnaryOperation {
    return match (event) {
        ir::body_events::ExpressionUnaryPositive -> UnaryPositive,
        ir::body_events::ExpressionUnaryNot -> UnaryNot,
        ir::body_events::ExpressionUnaryNegate -> UnaryNegate,
        _ -> InvalidUnaryOperation,
    };
}

pub fn binary_event_operation(event: ir::body_events::Event)
    -> BinaryOperation {
    return match (event) {
        ir::body_events::ExpressionBinaryAndThen -> BinaryAndThen,
        ir::body_events::ExpressionBinaryOrElse -> BinaryOrElse,
        ir::body_events::ExpressionBinaryEqual -> BinaryEqual,
        ir::body_events::ExpressionBinaryNotEqual -> BinaryNotEqual,
        ir::body_events::ExpressionBinaryLess -> BinaryLess,
        ir::body_events::ExpressionBinaryLessEqual -> BinaryLessEqual,
        ir::body_events::ExpressionBinaryGreater -> BinaryGreater,
        ir::body_events::ExpressionBinaryGreaterEqual -> BinaryGreaterEqual,
        ir::body_events::ExpressionBinaryAdd -> BinaryAdd,
        ir::body_events::ExpressionBinarySubtract -> BinarySubtract,
        ir::body_events::ExpressionBinaryMultiply -> BinaryMultiply,
        ir::body_events::ExpressionBinaryDivide -> BinaryDivide,
        ir::body_events::ExpressionBinaryRemainder -> BinaryRemainder,
        ir::body_events::ExpressionBinaryBitAnd -> BinaryBitAnd,
        ir::body_events::ExpressionBinaryBitOr -> BinaryBitOr,
        ir::body_events::ExpressionBinaryBitXor -> BinaryBitXor,
        ir::body_events::ExpressionBinaryShiftLeft -> BinaryShiftLeft,
        ir::body_events::ExpressionBinaryShiftRight -> BinaryShiftRight,
        _ -> InvalidBinaryOperation,
    };
}

pub fn assignment_event_operation(event: ir::body_events::Event)
    -> AssignmentOperation {
    return match (event) {
        ir::body_events::ExpressionAssignmentSet -> AssignmentSet,
        ir::body_events::ExpressionAssignmentAdd -> AssignmentAdd,
        ir::body_events::ExpressionAssignmentSubtract -> AssignmentSubtract,
        ir::body_events::ExpressionAssignmentMultiply -> AssignmentMultiply,
        ir::body_events::ExpressionAssignmentDivide -> AssignmentDivide,
        ir::body_events::ExpressionAssignmentRemainder -> AssignmentRemainder,
        ir::body_events::ExpressionAssignmentBitXor -> AssignmentBitXor,
        ir::body_events::ExpressionAssignmentShiftLeft -> AssignmentShiftLeft,
        ir::body_events::ExpressionAssignmentShiftRight -> AssignmentShiftRight,
        ir::body_events::ExpressionAssignmentBitAnd -> AssignmentBitAnd,
        ir::body_events::ExpressionAssignmentBitOr -> AssignmentBitOr,
        _ -> InvalidAssignmentOperation,
    };
}

// Numeric operation tags exist only at the serialized Core boundary.
pub fn binary_event_code(event: ir::body_events::Event) -> i32 {
    return binary_code(binary_event_operation(event));
}

pub fn assignment_event_code(event: ir::body_events::Event) -> i32 {
    return assignment_code(assignment_event_operation(event));
}

pub fn assignment_binary(operation: AssignmentOperation) -> BinaryOperation {
    if (operation == AssignmentAdd) {
        return BinaryAdd;
    }
    if (operation == AssignmentSubtract) {
        return BinarySubtract;
    }
    if (operation == AssignmentMultiply) {
        return BinaryMultiply;
    }
    if (operation == AssignmentDivide) {
        return BinaryDivide;
    }
    if (operation == AssignmentRemainder) {
        return BinaryRemainder;
    }
    if (operation == AssignmentBitXor) {
        return BinaryBitXor;
    }
    if (operation == AssignmentShiftLeft) {
        return BinaryShiftLeft;
    }
    if (operation == AssignmentShiftRight) {
        return BinaryShiftRight;
    }
    if (operation == AssignmentBitAnd) {
        return BinaryBitAnd;
    }
    if (operation == AssignmentBitOr) {
        return BinaryBitOr;
    }
    return InvalidBinaryOperation;
}
