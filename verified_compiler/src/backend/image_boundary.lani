module backend::image_boundary;

import backend::image;
import backend::program;
import backend::compile;
import backend::frame;
import ir::body_catalog;
import ir::program;
import verified::host;

pub const WORK_CAPACITY: i32 = backend::frame::HEADER
    + backend::compile::MAX_WORDS
        * backend::frame::WORK_WORDS_PER_STRIDE;
pub const WORK_ALIGNMENT: i32 = backend::frame::WORK_ALIGNMENT;
pub const OUTPUT_CAPACITY: i32 = 2097152;
pub const FUNCTION_INPUT_CAPACITY: i32 = backend::compile::MAX_WORDS;

// Raw-pointer entry avoids passing slice values across the application/backend
// native boundary. The views are reconstructed only inside this module.
pub fn compile_raw(work: ptr, output: ptr, body_memory: ptr,
    body_capacity: i32,
    native: ir::program::Storage) -> i32 {
    let workspace: backend::frame::Workspace =
        backend::frame::from_raw_parts(work, WORK_CAPACITY);
    let output_view:[i32] = verified::host::i32_slice_from_raw_parts(output,
        OUTPUT_CAPACITY);
    let bodies: ir::body_catalog::Catalog =
        ir::body_catalog::view_from_raw_parts(body_memory, body_capacity);
    if (ir::body_catalog::length(bodies) <= 0) { return -1; }
    return backend::image::compile(backend::program::typed(bodies, native),
        workspace, backend::compile::region(output_view, OUTPUT_CAPACITY));
}
