module backend::layout;
import backend::syntax;

// Native value storage uses eight-byte words. Structures concatenate fields;
// enumerations contain a tag and the largest variant payload. Slices and
// strings contain a pointer and length. This is not the platform C ABI.
pub const MAX_VALUE_WORDS: i32 = 4096;
pub const VALUE_WORD_BYTES: i32 = 8;
pub const INTEGER_WIDTH: i32 = 32;
pub const MACHINE_WIDTH: i32 = 64;

// Core type records are serialized input. backend::layout_index decodes them
// into typed rows once, then owns all nominal-width and field-offset queries.
pub const TYPE_RECORD_HEADER_WORDS: i32 = 4;
pub const TYPE_RECORD_WORD_COUNT_FIELD: i32 = 0;
pub const TYPE_RECORD_ID_FIELD: i32 = 1;
pub const TYPE_RECORD_KIND_FIELD: i32 = 2;
pub const TYPE_RECORD_MEMBER_COUNT_FIELD: i32 = 3;

pub fn aggregate(kind: i32) -> bool {
    return backend::syntax::type_is(kind, backend::syntax::TypeSlice)
        || backend::syntax::type_is(kind, backend::syntax::TypeString)
        || kind >= backend::syntax::NOMINAL_TYPE_BASE;
}

pub fn width(kind: i32) -> i32 {
    if (backend::syntax::type_is(kind, backend::syntax::TypeI32)
        || backend::syntax::type_is(kind, backend::syntax::TypeBool)) {
        return INTEGER_WIDTH;
    }
    return MACHINE_WIDTH;
}
