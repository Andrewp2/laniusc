module backend::index;
import backend::frame;
import backend::value;
import backend::syntax;
import backend::layout;
import x86::encode;
import x86::control;
import x86::register;

// RAX holds the evaluated index; slot holds the saved address of the captured
// descriptor. Compare all 64 length bits before loading any array element.
// A live nonwrapping packed i32 allocation has at most 2^62 elements. Thus a
// negative sign-extended i32 always fails the same unsigned length check.
pub fn address(output: [i32], capacity: i32, work: backend::frame::Workspace, slot: i32, kind: i32) -> i32 {
    let state: [backend::frame::State] = backend::frame::state_view(work);
    if (kind != backend::syntax::type_code(backend::syntax::TypeI32) && kind != backend::syntax::type_code(backend::syntax::TypeUsize)) { return -1; }
    let next: i32 = state[0].code;
    if (kind == backend::syntax::type_code(backend::syntax::TypeI32)) {
        next = x86::encode::sign_extend_i32(output, capacity, next, x86::register::RAX, x86::register::RAX);
    }
    state[0].code = next;
    backend::value::load_word(output, capacity, work, slot, x86::register::R11);
    next = x86::encode::load(output, capacity, state[0].code,
        x86::register::WIDTH_64, x86::register::R10, x86::register::R11,
        backend::layout::VALUE_WORD_BYTES);
    next = x86::encode::load(output, capacity, next, x86::register::WIDTH_64, x86::register::R11, x86::register::R11, 0);
    next = x86::encode::binary(output, capacity, next, x86::register::WIDTH_64, x86::encode::Compare, x86::register::RAX, x86::register::R10);
    next = x86::control::branch_over_trap(output, capacity, next,
        x86::control::Below);
    state[0].code = x86::encode::indexed_address(output, capacity, next,
        x86::register::RAX, x86::register::R11, x86::register::RAX, 2, 0);
    return state[0].code;
}
