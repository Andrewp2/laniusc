module backend::literal;
import backend::syntax;
import x86::buffer;
import x86::encode;
import x86::control;
import x86::register;

// Scalar constants contain id, kind, low, high. A string instead contains
// id, STRING, byte_count, UTF-8 bytes. Layout is selected here in Lanius.
pub fn constant_size(input: [i32], length: i32, position: i32) -> i32 {
    if (position <= -1 || position > length - 3) { return -1; }
    let kind: i32 = input[position + 1];
    if (input[position] <= -1 || kind < backend::syntax::I32 || kind > backend::syntax::STRING) { return -1; }
    if (kind == backend::syntax::STRING) {
        let count: i32 = input[position + 2];
        if (count <= -1 || count > length - position - 3) { return -1; }
        let index: i32 = 0;
        while (index <= count - 1) {
            let byte: i32 = input[position + 3 + index];
            if (byte <= -1 || byte > 255) { return -1; }
            index += 1;
        }
        return 3 + count;
    }
    if (position > length - 4) { return -1; }
    if (kind == backend::syntax::BOOL && input[position + 2] != 0 && input[position + 2] != 1) { return -1; }
    if ((kind == backend::syntax::I32 || kind == backend::syntax::BOOL) && input[position + 3] != 0) { return -1; }
    return 4;
}

// Return a position-independent pointer in RAX and skip over the exact UTF-8
// bytes in the instruction stream. The enclosing code image is four-byte
// aligned. Padding before the data aligns raw i32 views; it is not string data.
pub fn string(input: [i32], length: i32, start: i32, count: i32,
    output: [i32], capacity: i32, cursor: i32) -> i32 {
    if (start <= -1 || start > length || count <= -1 || count > length - start ||
        !x86::buffer::fits(capacity, cursor, 12)) { return -1; }
    let padding: i32 = (4 - cursor % 4) % 4;
    if (!x86::buffer::fits(capacity, cursor + 12, padding) ||
        !x86::buffer::fits(capacity, cursor + 12 + padding, count)) { return -1; }
    let index: i32 = 0;
    while (index <= count - 1) {
        if (input[start + index] <= -1 || input[start + index] > 255) { return -1; }
        index += 1;
    }
    let data: i32 = cursor + 12 + padding;
    let next: i32 = x86::encode::relative_address(output, capacity, cursor, x86::register::RAX, 5 + padding);
    next = x86::control::jump(output, capacity, next, data + count);
    index = 0;
    while (index <= padding - 1) { output[next + index] = 0; index += 1; }
    index = 0;
    while (index <= count - 1) { output[data + index] = input[start + index]; index += 1; }
    return data + count;
}

// Exact literal-return fragment authenticated by the Lean x86 checker.  The
// body does not inspect its parameters, so this compact path is valid for any
// parameter count; the parameter rows remain in the frontend input but do not
// need machine moves.  Its header is
// [version=1, pointer_bits=64, id, result_type, parameter_count,
//  body_word_count=5, returnValue, some, value, literal_type, value] or the
// exact frontend-trailing form with body_word_count=7 and
// [sequence, returnValue, some, value, literal_type, value, skip].
// Keeping this path ahead of generic frame lowering makes the emitted bytes
// equal the compact machine contract (mov eax,imm32; ret), including for an
// unused aggregate parameter.
pub fn return_value(input: [i32], length: i32, output: [i32], capacity: i32,
    cursor: i32) -> i32 {
    if (length <= 5 || input[0] != 1 || input[1] != 64 || input[2] <= -1 ||
        (input[3] != backend::syntax::I32 && input[3] != backend::syntax::BOOL)) {
        return -1;
    }
    let count: i32 = input[4];
    if (count <= -1 || count > (length - 6) / 2) { return -1; }
    let body_start: i32 = 6 + count * 2;
    let body_length: i32 = input[5];
    if ((body_length != 5 && body_length != 7) ||
        body_length != length - body_start) { return -1; }
    if (body_length == 5 &&
        (input[body_start] != 10 || input[body_start + 1] != 1 ||
            input[body_start + 2] != 0 || input[body_start + 3] != input[3])) {
        return -1;
    }
    if (body_length == 7 &&
        (input[body_start] != 2 || input[body_start + 1] != 10 ||
            input[body_start + 2] != 1 || input[body_start + 3] != 0 ||
            input[body_start + 4] != input[3] ||
            input[body_start + 6] != 0)) {
        return -1;
    }
    let value: i32 = input[body_start + 4];
    if (body_length == 7) { value = input[body_start + 5]; }
    if (input[3] == backend::syntax::BOOL && value != 0 && value != 1) { return -1; }
    if (!x86::buffer::fits(capacity, cursor, 6)) { return -1; }
    let next: i32 = x86::encode::immediate(output, capacity, cursor, 32,
        x86::register::RAX, value, 0);
    if (next <= -1) { return -1; }
    return x86::control::return_near(output, capacity, next);
}
