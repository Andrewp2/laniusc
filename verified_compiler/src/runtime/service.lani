module runtime::service;

import ir::type_ref;

// Semantic runtime identities and signatures shared by both output paths.
// Native instruction emission and wire decoding belong to the backend.
pub enum RuntimeService {
    NoService,
    Allocate,
    OpenRead,
    Close,
    Read,
    WriteStdout,
    WriteByte,
    ArgumentCount,
    ArgumentLength,
    ArgumentRead,
}

struct ServiceSignature {
    result_type: ir::type_ref::TypeRef,
    arity: i32,
    first_type: ir::type_ref::TypeRef,
    second_type: ir::type_ref::TypeRef,
    third_type: ir::type_ref::TypeRef,
}

fn signature(service: RuntimeService) -> ServiceSignature {
    if (service == Allocate) {
        return ServiceSignature {
            result_type: ir::type_ref::Pointer,
            arity: 2,
            first_type: ir::type_ref::Usize,
            second_type: ir::type_ref::Usize,
            third_type: ir::type_ref::Invalid,
        };
    }
    if (service == OpenRead || service == WriteStdout) {
        return ServiceSignature {
            result_type: ir::type_ref::I32,
            arity: 2,
            first_type: ir::type_ref::Pointer,
            second_type: ir::type_ref::Usize,
            third_type: ir::type_ref::Invalid,
        };
    }
    if (service == Close || service == ArgumentLength) {
        return ServiceSignature {
            result_type: ir::type_ref::I32,
            arity: 1,
            first_type: ir::type_ref::I32,
            second_type: ir::type_ref::Invalid,
            third_type: ir::type_ref::Invalid,
        };
    }
    if (service == Read || service == ArgumentRead) {
        return ServiceSignature {
            result_type: ir::type_ref::I32,
            arity: 3,
            first_type: ir::type_ref::I32,
            second_type: ir::type_ref::Pointer,
            third_type: ir::type_ref::Usize,
        };
    }
    if (service == WriteByte) {
        return ServiceSignature {
            result_type: ir::type_ref::I32,
            arity: 2,
            first_type: ir::type_ref::I32,
            second_type: ir::type_ref::I32,
            third_type: ir::type_ref::Invalid,
        };
    }
    return ServiceSignature {
        result_type: ir::type_ref::I32,
        arity: 0,
        first_type: ir::type_ref::Invalid,
        second_type: ir::type_ref::Invalid,
        third_type: ir::type_ref::Invalid,
    };
}

pub fn accepts_signature(service: RuntimeService,
    result_type: ir::type_ref::TypeRef, arity: i32) -> bool {
    let expected: ServiceSignature = signature(service);
    return service != NoService && arity == expected.arity
        && ir::type_ref::same(result_type, expected.result_type);
}

pub fn accepts_parameter(service: RuntimeService, index: i32,
    type_tag: ir::type_ref::TypeRef) -> bool {
    let expected: ServiceSignature = signature(service);
    if (index <= -1 || index >= expected.arity) { return false; }
    if (index == 0) { return ir::type_ref::same(type_tag, expected.first_type); }
    if (index == 1) { return ir::type_ref::same(type_tag, expected.second_type); }
    return ir::type_ref::same(type_tag, expected.third_type);
}
