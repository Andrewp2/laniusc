module verified::lean_program;

import ir::body_catalog;
import ir::body_tree;
import ir::body_events;
import ir::constant_catalog;
import ir::function_catalog;
import ir::program;
import ir::symbol_catalog;
import ir::type_catalog;
import ir::type_ref;
import verified::host;
import verified::lean_named_types;
import verified::lean_typed_body;
import verified::lean_body_shape;
import verified::lean_syntax;
import verified::lean_output;

const LIST_CHUNK: i32 = 64;

fn chunk_name(output: [i32], capacity: i32, position: i32,
    name: str, name_length: i32, index: i32) -> i32 {
    let next: i32 = verified::lean_output::text(output, capacity,
        position, name, name_length);
    return verified::lean_output::natural(output, capacity, next, index);
}

fn chunk_header(output: [i32], capacity: i32, position: i32,
    name: str, name_length: i32, index: i32,
    element_type: str, type_length: i32) -> i32 {
    let next: i32 = verified::lean_output::text(output, capacity, position,
        "\nprivate def ", 13);
    next = chunk_name(output, capacity, next, name, name_length, index);
    next = verified::lean_output::text(output, capacity, next,
        " : List ", 8);
    next = verified::lean_output::text(output, capacity, next,
        element_type, type_length);
    return verified::lean_output::text(output, capacity, next,
        " :=\n  [", 7);
}

fn chunk_collection(output: [i32], capacity: i32, position: i32,
    name: str, name_length: i32, element_type: str, type_length: i32,
    count: i32) -> i32 {
    let next: i32 = verified::lean_output::text(output, capacity, position,
        "\nprivate def ", 13);
    next = verified::lean_output::text(output, capacity, next,
        name, name_length);
    next = verified::lean_output::text(output, capacity, next,
        " : List ", 8);
    next = verified::lean_output::text(output, capacity, next,
        element_type, type_length);
    next = verified::lean_output::text(output, capacity, next,
        " :=\n  Lanius.Data.List.flatten [", 32);
    let chunk: i32 = 0;
    while (chunk < count) {
        if (chunk != 0) {
            next = verified::lean_output::text(output, capacity, next,
                ", ", 2);
        }
        next = chunk_name(output, capacity, next,
            name, name_length, chunk);
        if (next < 0) { return -1; }
        chunk += 1;
    }
    return verified::lean_output::text(output, capacity, next, "]\n", 2);
}

fn nominal_types(output: [i32], capacity: i32, position: i32,
    types: ir::type_catalog::Table,
    names: ir::symbol_catalog::Catalog) -> i32 {
    let next: i32 = verified::lean_output::byte(output, capacity, position, 91);
    let rows: [ir::type_catalog::TypeDecl] = types.types;
    let index: i32 = 0;
    while (index < types.type_count) {
        if (index > 0) {
            next = verified::lean_output::text(output, capacity, next, ", ", 2);
        }
        next = verified::lean_syntax::type_identifier(output, capacity, next,
            names, rows[index].id);
        if (next < 0) { return -1; }
        index += 1;
    }
    return verified::lean_output::byte(output, capacity, next, 93);
}

fn constant_value(output: [i32], capacity: i32, position: i32,
    table: ir::constant_catalog::Table,
    value: ir::constant_catalog::Constant) -> i32 {
    if (value.encoding == ir::constant_catalog::StringBytes) {
        return verified::lean_syntax::string_bytes(output, capacity, position,
            table.bytes, table.byte_count,
            value.byte_start, value.byte_count);
    }
    if (value.encoding != ir::constant_catalog::Scalar) { return -1; }
    if (ir::type_ref::same(value.kind, ir::type_ref::I32)) {
        return verified::lean_syntax::signed(output, capacity, position,
            value.low);
    }
    if (ir::type_ref::same(value.kind, ir::type_ref::Bool)) {
        if (value.low == 0) {
            return verified::lean_output::text(output, capacity, position,
                "false", 5);
        }
        if (value.low == 1) {
            return verified::lean_output::text(output, capacity, position,
                "true", 4);
        }
        return -1;
    }
    if (ir::type_ref::same(value.kind, ir::type_ref::Usize)) {
        return verified::lean_syntax::unsigned64(output, capacity, position,
            value.low, value.high);
    }
    if (ir::type_ref::same(value.kind, ir::type_ref::Pointer)
        && value.low == 0 && value.high == 0) {
        return verified::lean_output::text(output, capacity, position,
            "0", 1);
    }
    return -1;
}

fn constant_list(output: [i32], capacity: i32, position: i32,
    program: ir::program::Program) -> i32 {
    let next: i32 = position;
    let constants: ir::constant_catalog::Table = program.constants;
    let rows: [ir::constant_catalog::Constant] = constants.constants;
    let index: i32 = 0;
    while (index < constants.count) {
        if (index % LIST_CHUNK == 0) {
            next = chunk_header(output, capacity, next,
                "extractedConstants", 18, index / LIST_CHUNK,
                "Lanius.Core.Constant", 20);
        } else {
            next = verified::lean_output::text(output, capacity, next,
                ", ", 2);
        }
        next = verified::lean_syntax::constant_identifier(output, capacity,
            next, program.names, rows[index].id);
        next = verified::lean_output::text(output, capacity, next, ".pack", 5);
        if (next < 0) { return -1; }
        index += 1;
        if (index % LIST_CHUNK == 0) {
            next = verified::lean_output::text(output, capacity, next,
                "]\n", 2);
        }
    }
    if (index % LIST_CHUNK != 0) {
        next = verified::lean_output::text(output, capacity, next, "]\n", 2);
    }
    return chunk_collection(output, capacity, next,
        "extractedConstants", 18, "Lanius.Core.Constant", 20,
        (constants.count + LIST_CHUNK - 1) / LIST_CHUNK);
}

fn constant_definitions(output: [i32], capacity: i32,
    position: i32, program: ir::program::Program) -> i32 {
    let next: i32 = position;
    let rows: [ir::constant_catalog::Constant] =
        program.constants.constants;
    let index: i32 = 0;
    while (index < program.constants.count) {
        let constant: ir::constant_catalog::Constant = rows[index];
        next = verified::lean_output::text(output, capacity, next,
            "\ndef ", 5);
        next = verified::lean_syntax::constant_identifier(
            output, capacity, next, program.names, constant.id);
        next = verified::lean_output::text(output, capacity, next,
            " : Lanius.TypedIR.Surface.Constant ", 35);
        next = typed_type_ref(output, capacity, next,
            program.types, program.names, constant.kind);
        next = verified::lean_output::text(output, capacity, next,
            " :=\n  constant (id := ", 22);
        next = verified::lean_output::natural(output, capacity,
            next, constant.id);
        next = verified::lean_output::text(output, capacity, next, ") ", 2);
        next = constant_value(output, capacity, next,
            program.constants, constant);
        next = verified::lean_output::text(output, capacity,
            next, "\n", 1);
        if (next < 0) { return -1; }
        index += 1;
    }
    return next;
}

fn typed_type_ref(output: [i32], capacity: i32, position: i32,
    types: ir::type_catalog::Table,
    names: ir::symbol_catalog::Catalog,
    kind: ir::type_ref::TypeRef) -> i32 {
    return verified::lean_syntax::named_type_ref(output, capacity, position,
        types, names, kind);
}

fn parameter_types(output: [i32], capacity: i32, position: i32,
    types: ir::type_catalog::Table,
    names: ir::symbol_catalog::Catalog,
    functions: ir::function_catalog::Table,
    function: ir::function_catalog::Function) -> i32 {
    let next: i32 = verified::lean_output::text(output, capacity, position,
        "[", 1);
    let rows: [ir::function_catalog::Parameter] = functions.parameters;
    let ordinal: i32 = 0;
    while (ordinal < function.parameters) {
        if (ordinal != 0) {
            next = verified::lean_output::text(output, capacity, next,
                ", ", 2);
        }
        let parameter: ir::function_catalog::Parameter =
            rows[function.parameter_start + ordinal];
        next = typed_type_ref(output, capacity, next,
            types, names, parameter.type_tag);
        if (next < 0) { return -1; }
        ordinal += 1;
    }
    return verified::lean_output::text(output, capacity, next, "]", 1);
}

fn function_source_name(output: [i32], capacity: i32, position: i32,
    names: ir::symbol_catalog::Catalog, index: i32) -> i32 {
    if (names.unit_count == 0) {
        return verified::lean_output::text(output, capacity,
            position, "\"\"", 2);
    }
    if (index < 0 || index >= names.function_count) { return -1; }
    let references: [ir::symbol_catalog::Ref] = names.functions;
    return verified::lean_syntax::source_name(output, capacity, position,
        names, references[index]);
}

fn parameter_identifier(output: [i32], capacity: i32, position: i32,
    names: ir::symbol_catalog::Catalog, unit: i32, token: i32) -> i32 {
    let next: i32 = verified::lean_output::byte(output, capacity,
        position, 194);
    next = verified::lean_output::byte(output, capacity, next, 171);
    next = verified::lean_syntax::source_identifier(output, capacity, next,
        names, ir::symbol_catalog::Ref { unit: unit, token: token });
    next = verified::lean_output::byte(output, capacity, next, 194);
    return verified::lean_output::byte(output, capacity, next, 187);
}

fn surface_parameters(output: [i32], capacity: i32,
    position: i32, program: ir::program::Program,
    function: ir::function_catalog::Function, index: i32) -> i32 {
    let references: [ir::symbol_catalog::Ref] = program.names.functions;
    let unit: i32 = references[index].unit;
    let rows: [ir::function_catalog::Parameter] = program.functions.parameters;
    let next: i32 = verified::lean_output::byte(output, capacity, position, 91);
    let ordinal: i32 = 0;
    while (ordinal < function.parameters) {
        let parameter: ir::function_catalog::Parameter =
            rows[function.parameter_start + ordinal];
        if (ordinal > 0) {
            next = verified::lean_output::text(output, capacity, next, ", ", 2);
        }
        next = parameter_identifier(output, capacity, next,
            program.names, unit, parameter.id);
        next = verified::lean_output::text(output, capacity, next, " := ", 4);
        next = verified::lean_output::natural(output, capacity, next, parameter.id);
        if (next < 0) { return -1; }
        ordinal += 1;
    }
    return verified::lean_output::byte(output, capacity, next, 93);
}

fn parameter_variables(output: [i32], capacity: i32, position: i32,
    functions: ir::function_catalog::Table,
    names: ir::symbol_catalog::Catalog,
    function: ir::function_catalog::Function, index: i32) -> i32 {
    let next: i32 = position;
    let rows: [ir::function_catalog::Parameter] = functions.parameters;
    let unit: i32 = -1;
    if (names.unit_count > 0) {
        if (index < 0 || index >= names.function_count) { return -1; }
        let references: [ir::symbol_catalog::Ref] = names.functions;
        unit = references[index].unit;
    }
    let ordinal: i32 = 0;
    while (ordinal < function.parameters) {
        let parameter: ir::function_catalog::Parameter =
            rows[function.parameter_start + ordinal];
        next = verified::lean_output::text(output, capacity, next,
            "(.cons (Lanius.TypedIR.Surface.Var.named ", 41);
        next = verified::lean_output::natural(output, capacity, next,
            parameter.id);
        next = verified::lean_output::byte(output, capacity, next, 32);
        if (unit < 0) {
            next = verified::lean_output::text(output, capacity,
                next, "\"\"", 2);
        } else {
            next = verified::lean_syntax::source_name(output, capacity, next, names,
                ir::symbol_catalog::Ref { unit: unit, token: parameter.id });
        }
        next = verified::lean_output::text(output, capacity, next,
            ") ", 2);
        if (next < 0) { return -1; }
        ordinal += 1;
    }
    next = verified::lean_output::text(output, capacity, next,
        ".nil", 4);
    ordinal = 0;
    while (ordinal < function.parameters) {
        next = verified::lean_output::byte(output, capacity, next, 41);
        if (next < 0) { return -1; }
        ordinal += 1;
    }
    return next;
}

fn function(output: [i32], capacity: i32, position: i32,
    program: ir::program::Program,
    function_lookup: ir::function_catalog::Index,
    value: ir::function_catalog::Function, index: i32) -> i32 {
    if (value.kind == ir::function_catalog::DefinedFunction
        && program.names.unit_count > 0) {
        let body_index: i32 = ir::body_catalog::find(program.bodies,
            value.id);
        if (body_index < 0) { return -1; }
        let body: ir::body_catalog::FunctionBody =
            ir::body_catalog::at(program.bodies, body_index);
        if (verified::lean_body_shape::surface_supported(body.tree)) {
            let surface: i32 = verified::lean_output::text(output, capacity,
                position, "function (id := ", 16);
            surface = verified::lean_output::natural(output, capacity,
                surface, value.id);
            surface = verified::lean_output::text(output, capacity,
                surface, ", name := ", 10);
            surface = function_source_name(output, capacity, surface,
                program.names, index);
            surface = verified::lean_output::text(output, capacity,
                surface, ", arguments := ", 15);
            surface = surface_parameters(output, capacity,
                surface, program, value, index);
            surface = verified::lean_output::text(output, capacity,
                surface, ", bindings := ", 14);
            surface = verified::lean_typed_body::surface_bindings(body.tree,
                output, capacity, surface);
            surface = verified::lean_output::text(output, capacity,
                surface, ") do\n", 5);
            return verified::lean_typed_body::emit_surface(body.tree,
                program.types, program.names, function_lookup, index,
                output, capacity, surface);
        }
    }
    if (value.kind != ir::function_catalog::RuntimeFunction) { return -1; }
    let next: i32 = verified::lean_output::text(output, capacity, position,
        "Lanius.TypedIR.Surface.Function.external (id := ", 48);
    next = verified::lean_output::natural(output, capacity, next, value.id);
    next = verified::lean_output::text(output, capacity, next, ") (name := ", 11);
    next = function_source_name(output, capacity, next, program.names, index);
    next = verified::lean_output::text(output, capacity, next, ") (arguments := ", 16);
    next = parameter_variables(output, capacity, next, program.functions, program.names, value, index);
    next = verified::lean_output::text(output, capacity, next, ") (behavior := ", 15);
    next = verified::lean_syntax::service(output, capacity, next, value.service);
    return verified::lean_output::text(output, capacity, next, ")", 1);
}

fn function_definitions(output: [i32], capacity: i32, position: i32,
    program: ir::program::Program) -> i32 {
    if (program.functions.count == 0) { return position; }
    let function_lookup: ir::function_catalog::Index =
        ir::function_catalog::build_index(program.functions);
    if (function_lookup.capacity <= 0) { return -1; }
    let next: i32 = verified::lean_output::text(output, capacity, position,
        "\nmutual functions\n", 18);
    let functions: [ir::function_catalog::Function] =
        program.functions.functions;
    let index: i32 = 0;
    while (index < program.functions.count) {
        next = verified::lean_output::text(output, capacity, next,
            "\ndef ", 5);
        next = verified::lean_syntax::function_identifier(output, capacity, next,
            program.names, index);
        next = verified::lean_output::text(output, capacity, next,
            " : Lanius.TypedIR.Surface.Function ", 35);
        next = parameter_types(output, capacity, next,
            program.types, program.names, program.functions,
            functions[index]);
        next = verified::lean_output::byte(output, capacity, next, 32);
        next = typed_type_ref(output, capacity, next,
            program.types, program.names, functions[index].result_type);
        next = verified::lean_output::text(output, capacity, next,
            " :=\n  ", 6);
        next = function(output, capacity, next, program, function_lookup, functions[index],
            index);
        if (next < 0) { return -1; }
        next = verified::lean_output::byte(output, capacity, next, 10);
        if (next < 0) { return -1; }
        index += 1;
    }
    return verified::lean_output::text(output, capacity, next, "\nend\n", 5);
}

fn function_list(output: [i32], capacity: i32, position: i32,
    program: ir::program::Program) -> i32 {
    let next: i32 = position;
    let index: i32 = 0;
    while (index < program.functions.count) {
        if (index % LIST_CHUNK == 0) {
            next = chunk_header(output, capacity, next,
                "extractedFunctions", 18, index / LIST_CHUNK,
                "Lanius.Core.Function", 20);
        } else {
            next = verified::lean_output::text(output, capacity, next,
                ", ", 2);
        }
        next = verified::lean_syntax::function_identifier(output, capacity, next,
            program.names, index);
        next = verified::lean_output::text(output, capacity, next,
            ".pack", 5);
        if (next < 0) { return -1; }
        index += 1;
        if (index % LIST_CHUNK == 0) {
            next = verified::lean_output::text(output, capacity, next,
                "]\n", 2);
        }
    }
    if (index % LIST_CHUNK != 0) {
        next = verified::lean_output::text(output, capacity, next, "]\n", 2);
    }
    return function_groups(output, capacity, next, program);
}

fn function_groups(output: [i32], capacity: i32, position: i32,
    program: ir::program::Program) -> i32 {
    return chunk_collection(output, capacity, position,
        "extractedFunctions", 18, "Lanius.Core.Function", 20,
        (program.functions.count + LIST_CHUNK - 1) / LIST_CHUNK);
}

pub fn emit_declarations(program: ir::program::Program,
    output: [i32], capacity: i32, position: i32) -> i32 {
    if (!ir::program::valid(program)
        || position < 0 || position >= capacity) { return -1; }
    // These definitions build syntax once. Skip optional let rewriting and
    // closed-subterm caches; kernel checking and code generation stay enabled.
    let next: i32 = verified::lean_output::text(output, capacity, position,
        "\nset_option cleanup.letToHave false\nset_option compiler.extract_closed false\n\ndef extractedEntrypoint : Lanius.FunctionId := ", 125);
    next = verified::lean_output::natural(output, capacity, next,
        program.entrypoint);
    next = verified::lean_named_types::emit(output, capacity, next,
        program.types, program.names);
    if (next < 0) { return -1; }
    next = constant_definitions(output, capacity, next, program);
    if (next < 0) { return -1; }
    next = constant_list(output, capacity, next, program);
    if (next < 0) { return -1; }
    next = function_definitions(output, capacity, next, program);
    if (next < 0) { return -1; }
    next = function_list(output, capacity, next, program);
    if (next < 0) { return -1; }
    next = verified::lean_output::text(output, capacity, next,
        "\n\ndef extractedProgram : Lanius.Core.Program :=\n  link (types := ", 65);
    next = nominal_types(output, capacity, next, program.types, program.names);
    return verified::lean_output::text(output, capacity, next,
        ", constants := extractedConstants, functions := extractedFunctions)\n", 68);
}

pub fn emit(program: ir::program::Program,
    output: [i32], capacity: i32, position: i32) -> i32 {
    let next: i32 = verified::lean_output::text(output, capacity, position,
        "import Lanius.TypedIR.Surface.Link\n", 35);
    next = verified::lean_output::text(output, capacity, next,
        "import Lanius.Core\n\nopen Lanius.Core\nopen scoped Lanius.TypedIR.Surface\n", 72);
    return emit_declarations(program, output, capacity, next);
}
