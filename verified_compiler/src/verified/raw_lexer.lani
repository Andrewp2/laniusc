module verified::raw_lexer;

import verified::lexer;
import verified::number;
import verified::symbol;
import verified::ascii;
import verified::token;
import verified::token_scan;

pub enum LexStage {
    Lexed,
    LexicalError,
    TokenStorageFull,
}

pub fn stage_code(stage: LexStage) -> i32 {
    return match (stage) {
        Lexed -> 0,
        LexicalError -> 1,
        TokenStorageFull -> 2,
    };
}

pub struct LexResult {
    stage: LexStage,
    token_count: i32,
    error_offset: i32,
}

pub fn lex_stage_code(result: LexResult) -> i32 {
    return stage_code(result.stage);
}

pub fn lex_has_stage(result: LexResult, expected: LexStage) -> bool {
    return stage_code(result.stage) == stage_code(expected);
}

pub fn lex_succeeded(result: LexResult) -> bool {
    return lex_has_stage(result, Lexed);
}

pub fn lex_token_count(result: LexResult) -> i32 {
    return result.token_count;
}

pub fn lex_error_offset(result: LexResult) -> i32 {
    return result.error_offset;
}

fn completed(token_count: i32) -> LexResult {
    return LexResult {
        stage: Lexed,
        token_count: token_count,
        error_offset: 0,
    };
}

fn lexical_failure(token_count: i32, error_offset: i32) -> LexResult {
    return LexResult {
        stage: LexicalError,
        token_count: token_count,
        error_offset: error_offset,
    };
}

fn output_full(token_count: i32, source_offset: i32) -> LexResult {
    return LexResult {
        stage: TokenStorageFull,
        token_count: token_count,
        error_offset: source_offset,
    };
}

// Recognizes exactly one raw token beginning at `start`. Successful scans
// always return an exclusive end greater than `start`; failures identify the
// first byte required by the committed token form but not accepted by it.
pub fn scan_one(
    source: [i32],
    source_length: i32,
    start: i32,
) -> verified::token_scan::TokenScan {
    if (start >= source_length) {
        return verified::token_scan::failed(start);
    }

    let byte: i32 = source[start];
    let start_class: verified::lexer::StartClass =
        verified::lexer::classify_start(byte);
    if (verified::lexer::start_is(
            start_class, verified::lexer::IdentifierStart)) {
        return verified::token_scan::successful(
            verified::token::Identifier,
            verified::lexer::scan_identifier_end(source, source_length, start),
        );
    }
    if (verified::lexer::start_is(
            start_class, verified::lexer::DecimalNumberStart)) {
        return verified::number::scan_number(source, source_length, start);
    }
    if (verified::lexer::start_is(
            start_class, verified::lexer::WhitespaceStart)) {
        return verified::token_scan::successful(
            verified::token::Whitespace,
            verified::lexer::scan_whitespace_end(source, source_length, start),
        );
    }
    if (verified::lexer::start_is(
            start_class, verified::lexer::StringLiteralStart)) {
        let quoted = verified::lexer::scan_string_end(source, source_length, start);
        if (!verified::lexer::scan_succeeded(quoted)) {
            return verified::token_scan::failed(
                verified::lexer::scan_error_offset(quoted));
        }
        return verified::token_scan::successful(
            verified::token::StringLiteral,
            verified::lexer::scan_end_offset(quoted),
        );
    }
    if (verified::lexer::start_is(
            start_class, verified::lexer::CharacterLiteralStart)) {
        let quoted = verified::lexer::scan_character_end(source, source_length, start);
        if (!verified::lexer::scan_succeeded(quoted)) {
            return verified::token_scan::failed(
                verified::lexer::scan_error_offset(quoted));
        }
        return verified::token_scan::successful(
            verified::token::CharacterLiteral,
            verified::lexer::scan_end_offset(quoted),
        );
    }
    if (verified::lexer::start_is(
            start_class, verified::lexer::SymbolStart)) {
        if (byte == verified::ascii::DOT && start + 1 < source_length) {
            let following: i32 = source[start + 1];
            if (verified::lexer::is_decimal_digit(following)) {
                return verified::number::scan_leading_dot_number(
                    source, source_length, start);
            }
        }

        let matched = verified::symbol::match_symbol_head(
            source, source_length, start);
        let kind: verified::token::TokenKind =
            verified::symbol::token_match_token_kind(matched);
        if (verified::symbol::token_match_is_kind(
                matched, verified::token::LineComment)) {
            return verified::token_scan::successful(
                kind,
                verified::lexer::scan_line_comment_end(source, source_length, start),
            );
        }
        if (verified::symbol::token_match_is_kind(
                matched, verified::token::BlockComment)) {
            let comment = verified::lexer::scan_block_comment_end(
                source, source_length, start);
            if (!verified::lexer::scan_succeeded(comment)) {
                return verified::token_scan::failed(
                    verified::lexer::scan_error_offset(comment));
            }
            return verified::token_scan::successful(
                kind,
                verified::lexer::scan_end_offset(comment),
            );
        }
        return verified::token_scan::successful(
            kind,
            start + verified::symbol::token_match_length(matched),
        );
    }
    return verified::token_scan::failed(start);
}

// Writes the complete raw token stream into caller-owned storage. The source
// length is always a sufficient output capacity because every token consumes
// at least one byte. Returning the accepted prefix on failure makes the first
// lexical failure observable without inventing a partial token.
pub fn lex_into(
    source: [i32],
    source_length: i32,
    output_records: [i32],
    output_capacity: i32,
) -> LexResult {
    let offset: i32 = 0;
    let token_count: i32 = 0;
    while (offset < source_length) {
        let scanned = scan_one(source, source_length, offset);
        if (!verified::token_scan::succeeded(scanned)) {
            return lexical_failure(
                token_count,
                verified::token_scan::error_offset(scanned),
            );
        }
        if (token_count >= output_capacity) {
            return output_full(token_count, offset);
        }

        let row: i32 = token_count * verified::token::ROW_WORDS;
        output_records[row + verified::token::KIND_FIELD]
            = verified::token_scan::encoded_kind(scanned);
        output_records[row + verified::token::START_FIELD] = offset;
        output_records[row + verified::token::END_FIELD]
            = verified::token_scan::end_offset(scanned);
        offset = verified::token_scan::end_offset(scanned);
        token_count += 1;
    }
    return completed(token_count);
}
