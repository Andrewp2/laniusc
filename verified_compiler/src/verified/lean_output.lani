module verified::lean_output;

import verified::ascii;
import verified::host;

const DECIMAL_RADIX: i32 = 10;
const NIBBLE_BITS: i32 = 4;
const NIBBLE_MASK: i32 = 15;

// The logical capacity and cursor are byte offsets. Storage is packed four
// bytes per i32 word so the finished Lean file can be written directly.
pub struct Cursor {
    data: [i32],
    capacity: i32,
    position: i32,
}

pub fn cursor(data: [i32], capacity: i32, position: i32) -> Cursor {
    return Cursor { data: data, capacity: capacity, position: position };
}

pub fn byte(output: [i32], capacity: i32, position: i32,
    value: i32) -> i32 {
    if (position < 0 || position >= capacity
        || value < 0 || value > verified::host::BYTE_MASK) { return -1; }
    let word: i32 = position / verified::host::I32_BYTES;
    let shift: i32 = (position % verified::host::I32_BYTES)
        * verified::host::BITS_PER_BYTE;
    let mask: i32 = verified::host::BYTE_MASK << shift;
    output[word] = (output[word] & (mask ^ -1)) | (value << shift);
    return position + 1;
}

fn hex_digit(value: i32) -> i32 {
    if (value < DECIMAL_RADIX) { return verified::ascii::ZERO + value; }
    return verified::ascii::LOWER_A + value - DECIMAL_RADIX;
}

const HEX_DIGITS: i32 = 8;

pub fn hex_word(destination: Cursor, value: i32) -> i32 {
    let index: i32 = 0;
    while (index < HEX_DIGITS) {
        let nibble: i32 =
            (value >> ((HEX_DIGITS - 1 - index) * NIBBLE_BITS)) & NIBBLE_MASK;
        if (byte(destination.data, destination.capacity,
                destination.position + index, hex_digit(nibble)) < 0) { return -1; }
        index += 1;
    }
    return destination.position + HEX_DIGITS;
}

// Nonnegative i32 values have at most ten decimal digits. Four comparisons
// suffice; this avoids a counting loop and repeated integer division.
fn decimal_width(value: i32) -> i32 {
    if (value < 100000) {
        if (value < 100) {
            if (value < 10) { return 1; }
            return 2;
        }
        if (value < 1000) { return 3; }
        if (value < 10000) { return 4; }
        return 5;
    }
    if (value < 10000000) {
        if (value < 1000000) { return 6; }
        return 7;
    }
    if (value < 100000000) { return 8; }
    if (value < 1000000000) { return 9; }
    return 10;
}

pub fn natural(output: [i32], capacity: i32, position: i32,
    value: i32) -> i32 {
    if (value < 0 || position < 0 || position > capacity) { return -1; }
    let digits: i32 = decimal_width(value);
    if (digits > capacity - position) { return -1; }
    let remaining: i32 = value;
    let index: i32 = position + digits;
    while (index != position) {
        index -= 1;
        if (byte(output, capacity, index,
                verified::ascii::ZERO + remaining % DECIMAL_RADIX) < 0) {
            return -1;
        }
        remaining = remaining / DECIMAL_RADIX;
    }
    return position + digits;
}

pub fn text(output: [i32], capacity: i32, position: i32,
    input: str, length: i32) -> i32 {
    if (length < 0 || position < 0 || position > capacity
        || length > capacity - position) { return -1; }
    let words: [i32] = verified::host::i32_slice_from_raw_parts(
        verified::host::string_data_ptr(input),
        verified::host::packed_words(length));
    let index: i32 = 0;
    while (index != length) {
        let value: i32 =
            (words[index / verified::host::I32_BYTES]
                >> ((index % verified::host::I32_BYTES)
                    * verified::host::BITS_PER_BYTE))
            & verified::host::BYTE_MASK;
        // The entry guard establishes room for the whole string; masking
        // establishes the byte range. This call cannot reject those values.
        byte(output, capacity, position + index, value);
        index += 1;
    }
    return position + length;
}
