module verified::core_output;

import verified::output;
import verified::ascii;

const I32_MIN: i32 = -2147483648;
const I32_MIN_TEXT_LENGTH: i32 = 11;
const CHUNK_WORDS: i32 = 1024;

// Emit the canonical transport as Lean data and let the existing verified
// decoder reconstruct Core.Program. The generated subtype witness is `⟨_, rfl⟩`:
// if the transport is not accepted by decodeProgram, Lean rejects the emitted
// source instead of selecting a default program.
fn integer(output:[i32], capacity: i32, position: i32, value: i32) -> i32 {
    if (value == I32_MIN) {
        let min_value: str = "-2147483648";
        return verified::output::text(output, capacity, position, min_value,
            I32_MIN_TEXT_LENGTH);
    }
    if (value <= -1) {
        let next: i32 = verified::output::byte(output, capacity, position,
            verified::ascii::MINUS);
        return verified::output::natural(output, capacity, next, 0 - value);
    }
    return verified::output::natural(output, capacity, position, value);
}

pub fn emit_program(transport_words: i32, transport:[i32], output:[i32],
    capacity: i32, position: i32) -> i32 {
    if (transport_words <= 0 || capacity <= 0 || position <= -1 || position >= capacity) {
        return -1;
    }
    let prefix: str = "import Lanius.X86.TransportDecode\n\ndef extractedTransportChunk";
    let next: i32 = verified::output::text(output, capacity, position,
        prefix, 62);
    next = verified::output::natural(output, capacity, next, 0);
    next = verified::output::text(output, capacity, next,
        " : List Int :=\n  [", 18);
    if (next <= -1) { return -1; }
    let chunk: i32 = 0;
    let index: i32 = 0;
    while (index != transport_words) {
        if (index != 0) {
            if (index % CHUNK_WORDS == 0) {
                chunk += 1;
                next = verified::output::text(output, capacity, next,
                    "]\n\ndef extractedTransportChunk", 30);
                next = verified::output::natural(output, capacity, next,
                    chunk);
                next = verified::output::text(output, capacity, next,
                    " : List Int :=\n  [", 18);
            } else {
                next = verified::output::text(output, capacity, next,
                    ", ", 2);
            }
        }
        next = integer(output, capacity, next, transport[index]);
        if (next <= -1) { return -1; }
        index += 1;
    }
    next = verified::output::text(output, capacity, next,
        "]\n\ndef extractedTransportWords : List Int :=\n  extractedTransportChunk",
        70);
    next = verified::output::natural(output, capacity, next, 0);
    let following: i32 = 1;
    while (following <= chunk) {
        next = verified::output::text(output, capacity, next,
            " ++\n  extractedTransportChunk", 29);
        next = verified::output::natural(output, capacity, next,
            following);
        if (next <= -1) { return -1; }
        following += 1;
    }
    // Keep the generated computation's recursion allowance local to its
    // witness; it must not change the surrounding project's proof settings.
    let suffix: str = "\n\nset_option maxRecDepth 2048 in\ndef extractedDecoded : { value : Nat × Lanius.Core.Program // Lanius.X86.Transport.decodeProgram extractedTransportWords = some value } :=\n  ⟨_, rfl⟩\n\ndef extractedProgram : Lanius.Core.Program := extractedDecoded.val.2\n";
    return verified::output::text(output, capacity, next, suffix, 258);
}
