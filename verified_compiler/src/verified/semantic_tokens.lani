module verified::semantic_tokens;
import verified::parser;
import verified::output;

// Recover semantic token assignments from materialized records. Two slots
// per physical token hold [ordinary_or_inner_kind, outer_kind_or_minus_one].
// Lattice positions, not postorder visitation order, distinguish split uses.
// This avoids signed-i32 overflow from prematurely packing the u32 high bit.
// Return 0 on success, -1 for malformed evidence, -2 for output capacity.
pub fn collect(grammar:[i32], grammar_length: i32, kinds:[i32], token_count: i32,
    records:[i32], records_length: i32, offsets:[i32], node_count: i32,
    assignments:[i32], assignments_length: i32,) -> i32 {
    if (grammar_length <= 16 || token_count <= -1 || token_count >= 1073741824
        || node_count <= -1 || records_length <= -1) { return -1; }
    if (assignments_length <= -1 || !(token_count <= assignments_length / 2)) { return -2; }
    let kind_count: i32 = grammar[1];
    let canonical: i32 = grammar[7];
    if (kind_count <= 0 || kind_count >= 32769 || canonical <= -1
        || !(canonical <= grammar_length) || !(kind_count <= grammar_length - canonical)) { return -1; }
    let index: i32 = 0;
    while (index != token_count * 2) { assignments[index] = -1; index += 1; }
    let node: i32 = 0;
    while (node != node_count) {
        let record: i32 = offsets[node];
        if (record <= -1 || !(record <= records_length) || records_length - record <= 3) { return -1; }
        let count: i32 = records[record + 3];
        let position: i32 = records[record + 1];
        if (count <= -1 || !(count <= (records_length - record - 4) / 3)
            || position <= -1 || !(position <= token_count * 2)) { return -1; }
        let child: i32 = 0;
        while (child != count) {
            let slot: i32 = record + 4 + child * 3;
            let payload: i32 = records[slot + 1];
            if (payload <= -1) { return -1; }
            if (records[slot] == verified::parser::CHILD_TOKEN) {
                let kind: i32 = records[slot + 2];
                if (payload >= token_count || payload != position / 2
                    || kind <= -1 || kind >= kind_count) { return -1; }
                let raw: i32 = kinds[payload];
                let canonical_kind: i32 = grammar[canonical + kind];
                let assignment: i32 = payload * 2 + position % 2;
                if (assignments[assignment] != -1) { return -1; }
                assignments[assignment] = kind;
                if (position % 2 == 1) {
                    if (raw != grammar[5] || canonical_kind != grammar[6]) { return -1; }
                    position += 1;
                } else {
                    if (raw == canonical_kind) { position += 2; }
                    else {
                        if (raw != grammar[5] || canonical_kind != grammar[6]) { return -1; }
                        position += 1;
                    }
                }
            } else {
                if (records[slot] != verified::parser::CHILD_STATE || payload >= node) { return -1; }
                let nested: i32 = offsets[payload];
                if (nested <= -1 || !(nested <= records_length) || records_length - nested <= 3) { return -1; }
                if (records[nested + 1] != position || !(position <= records[nested + 2])
                    || !(records[nested + 2] <= token_count * 2)) { return -1; }
                position = records[nested + 2];
            }
            child += 1;
        }
        if (position != records[record + 2]) { return -1; }
        node += 1;
    }
    index = 0;
    while (index != token_count) {
        let first: i32 = assignments[index * 2];
        let second: i32 = assignments[index * 2 + 1];
        if (first <= -1) { return -1; }
        if (second == -1) {
            if (grammar[canonical + first] != kinds[index]) { return -1; }
        } else {
            if (kinds[index] != grammar[5] || grammar[canonical + first] != grammar[6]
                || grammar[canonical + second] != grammar[6]) { return -1; }
        }
        index += 1;
    }
    return 0;
}

// Emit packed semantic codes as List Nat. Split codes are expressed in Lean
// arithmetic so no unsigned value is ever forced through a signed i32.
pub fn emit(assignments:[i32], assignments_length: i32, token_count: i32,
    output:[i32], capacity: i32, position: i32,) -> i32 {
    if (assignments_length <= -1 || token_count <= -1
        || !(token_count <= assignments_length / 2)) { return -1; }
    let prefix: str = "(2147483648+";
    let suffix: str = "*32768)";
    let next: i32 = verified::output::byte(output, capacity, position, 91);
    let token: i32 = 0;
    while (token != token_count) {
        let first: i32 = assignments[token * 2];
        let second: i32 = assignments[token * 2 + 1];
        if (first <= -1 || first >= 32768 || second <= -2 || second >= 32768) { return -1; }
        if (token != 0) { next = verified::output::byte(output, capacity, next, 44); }
        if (second != -1) { next = verified::output::text(output, capacity, next, prefix, 12); }
        next = verified::output::natural(output, capacity, next, first);
        if (second != -1) {
            next = verified::output::byte(output, capacity, next, 43);
            next = verified::output::natural(output, capacity, next, second);
            next = verified::output::text(output, capacity, next, suffix, 7);
        }
        if (next == -1) { return -1; }
        token += 1;
    }
    return verified::output::byte(output, capacity, next, 93);
}
