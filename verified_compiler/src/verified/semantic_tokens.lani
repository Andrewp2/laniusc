module verified::semantic_tokens;
import verified::parser;
import verified::host;
import verified::token;
import verified::syntax_tree;

const FIELD_BYTES: i32 = 8;
pub const ASSIGNMENT_BYTES: i32 = 2 * FIELD_BYTES;
pub const ALIGNMENT: i32 = FIELD_BYTES;
pub const SEMANTIC_KIND_RADIX: i32 = 32768;

pub struct AssignmentBuffer {
    data: [Assignment],
    capacity: i32,
}

pub struct Assignment {
    inner: i32,
    outer: i32,
}

pub fn allocation_bytes(capacity: i32) -> i32 {
    if (capacity <= -1
        || capacity > verified::host::I32_MAX / ASSIGNMENT_BYTES) {
        return -1;
    }
    return capacity * ASSIGNMENT_BYTES;
}

pub fn from_raw_parts(memory: ptr, capacity: i32) -> AssignmentBuffer {
    let first: ptr = memory;
    if (capacity > 0) {
        first = memory + capacity * ASSIGNMENT_BYTES - FIELD_BYTES;
    }
    return AssignmentBuffer {
        data: slice_from_raw_parts(first, capacity),
        capacity: capacity,
    };
}

// Assign semantic kinds from the retained native tree. This traverses typed
// node/child records once and does not consume serialized parse records.
pub fn collect_native(grammar: [i32], grammar_length: i32,
    kinds: [i32], token_count: i32,
    tree: verified::syntax_tree::Tree, output: AssignmentBuffer) -> i32 {
    let assignments: [Assignment] = output.data;
    let node_count: i32 = tree.node_count;
    if (grammar_length <= verified::parser::GRAMMAR_HEADER_WORDS - 1
        || token_count <= -1
        || token_count > verified::host::I32_MAX
            / verified::parser::LATTICE_POSITIONS_PER_TOKEN
        || node_count <= 0 || tree.child_count <= -1) { return -1; }
    if (output.capacity <= -1 || token_count > output.capacity) {
        return -2;
    }
    let kind_count: i32 = grammar[verified::parser::HEADER_KIND_COUNT];
    let canonical: i32 = grammar[
        verified::parser::HEADER_CANONICAL_KINDS_OFFSET];
    if (kind_count <= 0 || kind_count > SEMANTIC_KIND_RADIX
        || canonical <= -1 || canonical > grammar_length
        || kind_count > grammar_length - canonical) { return -1; }
    let index: i32 = 0;
    while (index != token_count) {
        assignments[index] = Assignment { inner: -1, outer: -1 };
        index += 1;
    }
    let nodes: [verified::syntax_tree::Node] = tree.nodes;
    let children: [verified::syntax_tree::Child] = tree.children;
    let node: i32 = 0;
    while (node != node_count) {
        let current: verified::syntax_tree::Node = nodes[node];
        let count: i32 = current.child_count;
        let first: i32 = current.first_child;
        let position: i32 = current.origin;
        if (count <= -1 || first <= -1 || first > tree.child_count
            || count > tree.child_count - first || position <= -1
            || position > token_count
                * verified::parser::LATTICE_POSITIONS_PER_TOKEN) {
            return -1;
        }
        let child_index: i32 = 0;
        while (child_index != count) {
            let item: verified::syntax_tree::Child =
                children[first + child_index];
            let payload: i32 = item.payload;
            if (payload <= -1) { return -1; }
            if (item.kind == verified::parser::TokenChild) {
                let kind: i32 = item.semantic_kind;
                if (payload >= token_count
                    || payload != position
                        / verified::parser::LATTICE_POSITIONS_PER_TOKEN
                    || kind <= -1 || kind >= kind_count) { return -1; }
                let raw: i32 = kinds[payload];
                let canonical_kind: i32 = grammar[canonical + kind];
                if (position % verified::parser::LATTICE_POSITIONS_PER_TOKEN
                        == 1) {
                    if (assignments[payload].outer != -1) { return -1; }
                    assignments[payload].outer = kind;
                } else {
                    if (assignments[payload].inner != -1) { return -1; }
                    assignments[payload].inner = kind;
                }
                if (position % verified::parser::LATTICE_POSITIONS_PER_TOKEN
                        == 1) {
                    if (raw != grammar[
                            verified::parser::HEADER_SPLIT_TOKEN_KIND]
                        || canonical_kind != grammar[
                            verified::parser::HEADER_SPLIT_COMPONENT_KIND]) {
                        return -1;
                    }
                    position += 1;
                } else {
                    if (verified::token::raw_matches_canonical(raw,
                            canonical_kind)) { position += 2; }
                    else {
                        if (raw != grammar[
                                verified::parser::HEADER_SPLIT_TOKEN_KIND]
                            || canonical_kind != grammar[
                                verified::parser::HEADER_SPLIT_COMPONENT_KIND]) {
                            return -1;
                        }
                        position += 1;
                    }
                }
            } else {
                if (item.kind != verified::parser::StateChild
                    || payload >= node) { return -1; }
                let nested: verified::syntax_tree::Node = nodes[payload];
                if (nested.origin != position || nested.end < position
                    || nested.end > token_count
                        * verified::parser::LATTICE_POSITIONS_PER_TOKEN) {
                    return -1;
                }
                position = nested.end;
            }
            child_index += 1;
        }
        if (position != current.end) { return -1; }
        node += 1;
    }
    index = 0;
    while (index != token_count) {
        let first_kind: i32 = assignments[index].inner;
        let second_kind: i32 = assignments[index].outer;
        if (first_kind <= -1) { return -1; }
        if (second_kind == -1) {
            if (!verified::token::raw_matches_canonical(kinds[index],
                    grammar[canonical + first_kind])) { return -1; }
        } else {
            if (kinds[index] != grammar[
                    verified::parser::HEADER_SPLIT_TOKEN_KIND]
                || grammar[canonical + first_kind] != grammar[
                    verified::parser::HEADER_SPLIT_COMPONENT_KIND]
                || grammar[canonical + second_kind] != grammar[
                    verified::parser::HEADER_SPLIT_COMPONENT_KIND]) {
                return -1;
            }
        }
        index += 1;
    }
    return 0;
}
