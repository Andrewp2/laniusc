module verified::symbol;

import verified::token;
import verified::ascii;

pub struct TokenMatch {
    kind: verified::token::TokenKind,
    length: i32,
}

pub fn token_match_is_kind(result: TokenMatch,
    expected: verified::token::TokenKind) -> bool {
    return result.kind == expected;
}

pub fn token_match_token_kind(result: TokenMatch) -> verified::token::TokenKind {
    return result.kind;
}

pub fn token_match_length(result: TokenMatch) -> i32 {
    return result.length;
}

fn token_match(kind: verified::token::TokenKind, length: i32) -> TokenMatch {
    return TokenMatch {
        kind: kind,
        length: length,
    };
}

// Matches the longest fixed punctuation/operator prefix. For `//` and `/*`,
// this returns the two-byte opener; the comment scanner extends it to the
// complete raw token or reports EOF for an unterminated block comment.
pub fn match_symbol_head(source: [i32], source_length: i32, start: i32) -> TokenMatch {
    let first: i32 = source[start];
    let second: i32 = -1;
    let third: i32 = -1;
    if (start + 1 < source_length) {
        second = source[start + 1];
    }
    if (start + 2 < source_length) {
        third = source[start + 2];
    }

    if (first == verified::ascii::LESS) {
        if (second == verified::ascii::LESS) {
            if (third == verified::ascii::EQUAL) {
                return token_match(verified::token::ShiftLeftAssign, 3);
            }
            return token_match(verified::token::ShiftLeft, 2);
        }
        if (second == verified::ascii::EQUAL) {
            return token_match(verified::token::LessEqual, 2);
        }
        if (second == verified::ascii::GREATER) {
            return token_match(verified::token::AngleGeneric, 2);
        }
        return token_match(verified::token::Less, 1);
    }
    if (first == verified::ascii::GREATER) {
        if (second == verified::ascii::GREATER) {
            if (third == verified::ascii::EQUAL) {
                return token_match(verified::token::ShiftRightAssign, 3);
            }
            return token_match(verified::token::ShiftRight, 2);
        }
        if (second == verified::ascii::EQUAL) {
            return token_match(verified::token::GreaterEqual, 2);
        }
        return token_match(verified::token::Greater, 1);
    }
    if (first == verified::ascii::PLUS) {
        if (second == verified::ascii::EQUAL) {
            return token_match(verified::token::PlusAssign, 2);
        }
        if (second == verified::ascii::PLUS) {
            return token_match(verified::token::Increment, 2);
        }
        return token_match(verified::token::Plus, 1);
    }
    if (first == verified::ascii::MINUS) {
        if (second == verified::ascii::EQUAL) {
            return token_match(verified::token::MinusAssign, 2);
        }
        if (second == verified::ascii::MINUS) {
            return token_match(verified::token::Decrement, 2);
        }
        if (second == verified::ascii::GREATER) {
            return token_match(verified::token::Arrow, 2);
        }
        return token_match(verified::token::Minus, 1);
    }
    if (first == verified::ascii::EQUAL) {
        if (second == verified::ascii::EQUAL) {
            return token_match(verified::token::Equal, 2);
        }
        if (second == verified::ascii::GREATER) {
            return token_match(verified::token::MatchArrow, 2);
        }
        return token_match(verified::token::Assign, 1);
    }
    if (first == verified::ascii::SLASH) {
        if (second == verified::ascii::SLASH) {
            return token_match(verified::token::LineComment, 2);
        }
        if (second == verified::ascii::ASTERISK) {
            return token_match(verified::token::BlockComment, 2);
        }
        if (second == verified::ascii::EQUAL) {
            return token_match(verified::token::SlashAssign, 2);
        }
        return token_match(verified::token::Slash, 1);
    }
    if (first == verified::ascii::AMPERSAND) {
        if (second == verified::ascii::AMPERSAND) {
            return token_match(verified::token::LogicalAnd, 2);
        }
        if (second == verified::ascii::EQUAL) {
            return token_match(verified::token::AmpersandAssign, 2);
        }
        return token_match(verified::token::Ampersand, 1);
    }
    if (first == verified::ascii::PIPE) {
        if (second == verified::ascii::PIPE) {
            return token_match(verified::token::LogicalOr, 2);
        }
        if (second == verified::ascii::EQUAL) {
            return token_match(verified::token::PipeAssign, 2);
        }
        return token_match(verified::token::Pipe, 1);
    }
    if (first == verified::ascii::EXCLAMATION) {
        if (second == verified::ascii::EQUAL) {
            return token_match(verified::token::NotEqual, 2);
        }
        return token_match(verified::token::Not, 1);
    }
    if (first == verified::ascii::ASTERISK) {
        if (second == verified::ascii::EQUAL) {
            return token_match(verified::token::StarAssign, 2);
        }
        return token_match(verified::token::Star, 1);
    }
    if (first == verified::ascii::PERCENT) {
        if (second == verified::ascii::EQUAL) {
            return token_match(verified::token::PercentAssign, 2);
        }
        return token_match(verified::token::Percent, 1);
    }
    if (first == verified::ascii::CARET) {
        if (second == verified::ascii::EQUAL) {
            return token_match(verified::token::CaretAssign, 2);
        }
        return token_match(verified::token::Caret, 1);
    }
    if (first == verified::ascii::DOT) {
        if (second == verified::ascii::DOT) {
            return token_match(verified::token::DotDot, 2);
        }
        return token_match(verified::token::Dot, 1);
    }
    if (first == verified::ascii::LEFT_PAREN) {
        return token_match(verified::token::LeftParen, 1);
    }
    if (first == verified::ascii::RIGHT_PAREN) {
        return token_match(verified::token::RightParen, 1);
    }
    if (first == verified::ascii::LEFT_BRACKET) {
        return token_match(verified::token::LeftBracket, 1);
    }
    if (first == verified::ascii::RIGHT_BRACKET) {
        return token_match(verified::token::RightBracket, 1);
    }
    if (first == verified::ascii::LEFT_BRACE) {
        return token_match(verified::token::LeftBrace, 1);
    }
    if (first == verified::ascii::RIGHT_BRACE) {
        return token_match(verified::token::RightBrace, 1);
    }
    if (first == verified::ascii::TILDE) {
        return token_match(verified::token::Tilde, 1);
    }
    if (first == verified::ascii::COMMA) {
        return token_match(verified::token::Comma, 1);
    }
    if (first == verified::ascii::SEMICOLON) {
        return token_match(verified::token::Semicolon, 1);
    }
    if (first == verified::ascii::COLON) {
        return token_match(verified::token::Colon, 1);
    }
    return token_match(verified::token::Question, 1);
}
