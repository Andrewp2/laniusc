module verified::decimal;

import verified::token;
import verified::digits;
import verified::token_scan;
import verified::ascii;

const DECIMAL_RADIX: i32 = 10;

pub type Scan = verified::token_scan::TokenScan;

pub fn integer_scan(end_offset: i32) -> Scan {
    return verified::token_scan::successful(
        verified::token::Integer, end_offset);
}

pub fn float_scan(end_offset: i32) -> Scan {
    return verified::token_scan::successful(
        verified::token::FloatLiteral, end_offset);
}

pub fn number_failure(error_offset: i32) -> Scan {
    return verified::token_scan::failed(error_offset);
}

pub fn scan_exponent(
    source: [i32],
    source_length: i32,
    exponent_start: i32,
) -> Scan {
    let digits_start: i32 = exponent_start + 1;
    if (digits_start <= source_length - 1) {
        let sign: i32 = source[digits_start];
        if (sign == verified::ascii::PLUS || sign == verified::ascii::MINUS) {
            digits_start += 1;
        }
    }

    let digits = verified::digits::scan_digit_run(
        source, source_length, digits_start, DECIMAL_RADIX);
    if (!verified::digits::digit_scan_succeeded(digits)) {
        return number_failure(verified::digits::digit_scan_error_offset(digits));
    }
    return float_scan(verified::digits::digit_scan_end_offset(digits));
}

pub fn finish_decimal(
    source: [i32],
    source_length: i32,
    integer_end: i32,
) -> Scan {
    if (integer_end >= source_length) {
        return integer_scan(integer_end);
    }

    let next: i32 = source[integer_end];
    if (next == verified::ascii::LOWER_E
        || next == verified::ascii::UPPER_E) {
        return scan_exponent(source, source_length, integer_end);
    }
    if (next != verified::ascii::DOT) {
        return integer_scan(integer_end);
    }

    if (integer_end + 1 <= source_length - 1) {
        if (source[integer_end + 1] == verified::ascii::DOT) {
            return integer_scan(integer_end);
        }
    }

    let fraction_start: i32 = integer_end + 1;
    if (fraction_start <= source_length - 1) {
        if (verified::digits::is_digit_for_base(
                source[fraction_start], DECIMAL_RADIX)) {
            let fraction = verified::digits::scan_digit_run(
                source, source_length, fraction_start, DECIMAL_RADIX);
            if (!verified::digits::digit_scan_succeeded(fraction)) {
                return number_failure(verified::digits::digit_scan_error_offset(fraction));
            }
            let fraction_end: i32 = verified::digits::digit_scan_end_offset(fraction);
            if (fraction_end <= source_length - 1) {
                let exponent: i32 = source[fraction_end];
                if (exponent == verified::ascii::LOWER_E
                    || exponent == verified::ascii::UPPER_E) {
                    return scan_exponent(source, source_length, fraction_end);
                }
            }
            return float_scan(fraction_end);
        }
        let exponent: i32 = source[fraction_start];
        if (exponent == verified::ascii::LOWER_E
            || exponent == verified::ascii::UPPER_E) {
            return scan_exponent(source, source_length, fraction_start);
        }
    }
    return float_scan(fraction_start);
}
