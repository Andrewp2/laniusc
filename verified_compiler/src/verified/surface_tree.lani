module verified::surface_tree;
import verified::parser;

// Bounds-checked access to materialized parse records. Callers supply actual
// buffer lengths. These checks do not replace grammar validation.
pub fn record(records:[i32], length: i32, offsets:[i32], count: i32, node: i32) -> i32 {
    if (node <= -1 || node >= count || length <= -1) { return -1; }
    let offset: i32 = offsets[node];
    if (offset <= -1 || !(offset <= length) || length - offset <= 3) { return -1; }
    let children: i32 = records[offset + 3];
    if (children <= -1 || !(children <= (length - offset - 4) / 3)) { return -1; }
    return offset;
}

pub fn child(records:[i32], length: i32, offsets:[i32], count: i32,
    node: i32, index: i32, tag: i32, token_count: i32) -> i32 {
    let offset: i32 = record(records, length, offsets, count, node);
    if (offset <= -1 || index <= -1) { return -1; }
    if (index >= records[offset + 3]) { return -1; }
    let slot: i32 = offset + 4 + index * 3;
    if (records[slot] != tag) { return -1; }
    let payload: i32 = records[slot + 1];
    if (payload <= -1) { return -1; }
    if (tag == verified::parser::CHILD_TOKEN) {
        if (payload >= token_count) { return -1; }
    } else {
        if (tag != verified::parser::CHILD_STATE || payload >= node) { return -1; }
    }
    return payload;
}
