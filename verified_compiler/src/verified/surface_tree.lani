module verified::surface_tree;
import verified::parser;

// Bounds-checked access to materialized parse records. Callers supply actual
// buffer lengths. These checks do not replace grammar validation.
pub fn record(records:[i32], length: i32, offsets:[i32], count: i32, node: i32) -> i32 {
    if (node <= -1 || node >= count || length <= -1) { return -1; }
    let offset: i32 = offsets[node];
    if (offset <= -1 || !(offset <= length) || length - offset
        <= verified::parser::DERIVATION_HEADER_WORDS - 1) { return -1; }
    let children: i32 = records[offset
        + verified::parser::DERIVATION_CHILD_COUNT_FIELD];
    if (children <= -1 || !(children <= (length - offset
            - verified::parser::DERIVATION_HEADER_WORDS)
        / verified::parser::DERIVATION_CHILD_WORDS)) { return -1; }
    return offset;
}

pub fn child(records:[i32], length: i32, offsets:[i32], count: i32,
    node: i32, index: i32, tag: i32, token_count: i32) -> i32 {
    let offset: i32 = record(records, length, offsets, count, node);
    if (offset <= -1 || index <= -1) { return -1; }
    if (index >= records[offset
            + verified::parser::DERIVATION_CHILD_COUNT_FIELD]) { return -1; }
    let slot: i32 = offset + verified::parser::DERIVATION_HEADER_WORDS
        + index * verified::parser::DERIVATION_CHILD_WORDS;
    if (records[slot + verified::parser::DERIVATION_CHILD_TAG_FIELD]
        != tag) { return -1; }
    let payload: i32 = records[slot
        + verified::parser::DERIVATION_CHILD_PAYLOAD_FIELD];
    if (payload <= -1) { return -1; }
    if (tag == verified::parser::child_code(verified::parser::TokenChild)) {
        if (payload >= token_count) { return -1; }
    } else {
        if (tag != verified::parser::child_code(verified::parser::StateChild) || payload >= node) { return -1; }
    }
    return payload;
}
