module verified::surface_struct_output;
import verified::output;
import verified::surface_tree;
import verified::surface_atoms;
import verified::surface_type;
import verified::surface_type_output;
import verified::parser;

pub struct EmitResult {
    position: i32,
    next_id: i32,
}

pub fn emit_position(value: EmitResult) -> i32 { return value.position; }
pub fn emit_next_id(value: EmitResult) -> i32 { return value.next_id; }

fn result(position: i32, next_id: i32) -> EmitResult {
    return EmitResult { position: position, next_id: next_id };
}

fn failed(next_id: i32) -> EmitResult { return result(-1, next_id); }

fn node_child(records:[i32], records_length: i32, offsets:[i32],
    node_count: i32, node: i32, index: i32) -> i32 {
    return verified::surface_tree::child(records, records_length, offsets,
        node_count, node, index, verified::parser::CHILD_STATE, 0);
}

fn field(source:[i32], source_length: i32, tokens:[i32], token_count: i32,
    records:[i32], records_length: i32, offsets:[i32], node_count: i32,
    node: i32, type_arena:[i32], type_arena_length: i32, depth: i32,
    output:[i32], capacity: i32, state: EmitResult) -> EmitResult {
    if (state.position <= -1 || depth <= 0) { return failed(state.next_id); }
    let offset: i32 = verified::surface_tree::record(records, records_length,
        offsets, node_count, node);
    if (offset <= -1 || records[offset] != 261) { return failed(state.next_id); }
    let type_node: i32 = node_child(records, records_length, offsets,
        node_count, node, 2);
    let root: i32 = verified::surface_type::extract(records, records_length,
        offsets, node_count, token_count, type_node, type_arena,
        type_arena_length, depth - 1);
    if (root <= -1 || type_arena[0] <= 0
        || type_arena[0] >= 2147483647 - state.next_id) {
        return failed(state.next_id);
    }
    let opening: str = "⟨";
    let closing: str = "⟩";
    let next: i32 = verified::output::text(output, capacity,
        state.position, opening, 3);
    next = verified::output::natural(output, capacity, next,
        state.next_id + type_arena[0]);
    next = verified::output::byte(output, capacity, next, 44);
    next = verified::output::natural(output, capacity, next, node);
    next = verified::output::byte(output, capacity, next, 44);
    let name_token: i32 = verified::surface_tree::child(records,
        records_length, offsets, node_count, node, 0,
        verified::parser::CHILD_TOKEN, token_count);
    next = verified::surface_atoms::name(source, source_length, tokens,
        token_count, name_token, output, capacity, next);
    next = verified::output::byte(output, capacity, next, 44);
    next = verified::surface_type_output::emit(source, source_length, tokens,
        token_count, type_arena, type_arena_length, root, state.next_id,
        output, capacity, next);
    next = verified::output::text(output, capacity, next, closing, 3);
    if (next <= -1) { return failed(state.next_id); }
    return result(next, state.next_id + type_arena[0] + 1);
}

fn fields(source:[i32], source_length: i32, tokens:[i32], token_count: i32,
    records:[i32], records_length: i32, offsets:[i32], node_count: i32,
    node: i32, type_arena:[i32], type_arena_length: i32, depth: i32,
    output:[i32], capacity: i32, state: EmitResult) -> EmitResult {
    if (state.position <= -1 || depth <= 0) { return failed(state.next_id); }
    let offset: i32 = verified::surface_tree::record(records, records_length,
        offsets, node_count, node);
    if (offset <= -1) { return failed(state.next_id); }
    let next: i32 = verified::output::byte(output, capacity, state.position, 91);
    if (records[offset] == 259) {
        next = verified::output::byte(output, capacity, next, 93);
        if (next <= -1) { return failed(state.next_id); }
        return result(next, state.next_id);
    }
    if (records[offset] != 260) { return failed(state.next_id); }
    let current: EmitResult = field(source, source_length, tokens,
        token_count, records, records_length, offsets, node_count,
        node_child(records, records_length, offsets, node_count, node, 0),
        type_arena, type_arena_length, depth - 1, output, capacity,
        result(next, state.next_id));
    let tail: i32 = node_child(records, records_length, offsets, node_count,
        node, 1);
    let remaining: i32 = depth;
    while (remaining != 0) {
        remaining -= 1;
        let tail_offset: i32 = verified::surface_tree::record(records,
            records_length, offsets, node_count, tail);
        if (tail_offset <= -1) { return failed(current.next_id); }
        if (records[tail_offset] == 263) {
            next = verified::output::byte(output, capacity, current.position, 93);
            if (next <= -1) { return failed(current.next_id); }
            return result(next, current.next_id);
        }
        if (records[tail_offset] != 262) { return failed(current.next_id); }
        let after: i32 = node_child(records, records_length, offsets,
            node_count, tail, 1);
        let after_offset: i32 = verified::surface_tree::record(records,
            records_length, offsets, node_count, after);
        if (after_offset <= -1) { return failed(current.next_id); }
        if (records[after_offset] == 265) {
            next = verified::output::byte(output, capacity, current.position, 93);
            if (next <= -1) { return failed(current.next_id); }
            return result(next, current.next_id);
        }
        if (records[after_offset] != 264) { return failed(current.next_id); }
        next = verified::output::byte(output, capacity, current.position, 44);
        current = field(source, source_length, tokens, token_count, records,
            records_length, offsets, node_count,
            node_child(records, records_length, offsets, node_count, after, 0),
            type_arena, type_arena_length, depth - 1, output, capacity,
            result(next, current.next_id));
        if (current.position <= -1) { return current; }
        tail = node_child(records, records_length, offsets, node_count, after, 1);
    }
    return failed(current.next_id);
}

// Emit the exact nongeneric struct reconstructed by Lean.
pub fn emit(source:[i32], source_length: i32, tokens:[i32], token_count: i32,
    records:[i32], records_length: i32, offsets:[i32], node_count: i32,
    node: i32, is_public: bool, type_arena:[i32],
    type_arena_length: i32, depth: i32, first_id: i32, output:[i32],
    capacity: i32, position: i32) -> EmitResult {
    if (first_id <= -1 || depth <= 0) { return failed(first_id); }
    let offset: i32 = verified::surface_tree::record(records, records_length,
        offsets, node_count, node);
    if (offset <= -1 || records[offset] != 258) { return failed(first_id); }
    let generic_node: i32 = node_child(records, records_length, offsets,
        node_count, node, 2);
    let generic_offset: i32 = verified::surface_tree::record(records,
        records_length, offsets, node_count, generic_node);
    let where_node: i32 = node_child(records, records_length, offsets,
        node_count, node, 3);
    let where_offset: i32 = verified::surface_tree::record(records,
        records_length, offsets, node_count, where_node);
    if (generic_offset <= -1 || records[generic_offset] != 232
        || where_offset <= -1 || records[where_offset] != 36) {
        return failed(first_id);
    }
    let name_start: str = "{ name := ";
    let public_start: str = ", is_public := ";
    let fields_start: str = ", fields := ";
    let record_end: str = " }";
    let yes: str = "true";
    let no: str = "false";
    let next: i32 = verified::output::text(output, capacity, position,
        name_start, 10);
    let name_token: i32 = verified::surface_tree::child(records,
        records_length, offsets, node_count, node, 1,
        verified::parser::CHILD_TOKEN, token_count);
    next = verified::surface_atoms::name(source, source_length, tokens,
        token_count, name_token, output, capacity, next);
    next = verified::output::text(output, capacity, next, public_start, 15);
    if (is_public) { next = verified::output::text(output, capacity, next, yes, 4); }
    else { next = verified::output::text(output, capacity, next, no, 5); }
    next = verified::output::text(output, capacity, next, fields_start, 12);
    let current: EmitResult = fields(source, source_length, tokens,
        token_count, records, records_length, offsets, node_count,
        node_child(records, records_length, offsets, node_count, node, 5),
        type_arena, type_arena_length, depth - 1, output, capacity,
        result(next, first_id));
    next = verified::output::text(output, capacity, current.position,
        record_end, 2);
    if (next <= -1) { return failed(current.next_id); }
    return result(next, current.next_id);
}
