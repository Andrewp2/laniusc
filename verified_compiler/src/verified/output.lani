module verified::output;

import verified::host;
import verified::ascii;

const DECIMAL_RADIX: i32 = 10;
const HEX_RADIX: i32 = 16;
const NIBBLE_BITS: i32 = 4;
const NIBBLE_MASK: i32 = HEX_RADIX - 1;
const WORD_HIGH_SHIFT: i32 = 28;
pub const HEX_BYTE_CHARACTERS: i32 = 2;
pub const HEX_WORD_CHARACTERS: i32 = 8;

pub struct Cursor {
    data: [i32],
    capacity: i32,
    position: i32,
}

pub fn cursor(data: [i32], capacity: i32, position: i32) -> Cursor {
    return Cursor {
        data: data,
        capacity: capacity,
        position: position,
    };
}

// Append operations return the next byte offset, or -1. Errors are sticky;
// callers must discard partial output after an error. Bytes occupy i32 slots.
pub fn byte(output:[i32], capacity: i32, position: i32, value: i32) -> i32 {
    if (position <= -1 || position >= capacity || value <= -1
        || value > verified::host::BYTE_MASK) {
        return -1;
    }
    output[position] = value;
    return position + 1;
}

fn hex_digit(value: i32) -> i32 {
    if (value < DECIMAL_RADIX) {
        return verified::ascii::ZERO + value;
    }
    return verified::ascii::LOWER_A + value - DECIMAL_RADIX;
}

pub fn hex_byte(destination: Cursor, value: i32) -> i32 {
    if (value <= -1 || value > verified::host::BYTE_MASK) { return -1; }
    let next: i32 = byte(destination.data, destination.capacity,
        destination.position,
        hex_digit((value >> NIBBLE_BITS) & NIBBLE_MASK));
    return byte(destination.data, destination.capacity, next,
        hex_digit(value & NIBBLE_MASK));
}

// Encode all 32 bits, including negative i32 values used by serialized Core.
pub fn hex_word(destination: Cursor, value: i32) -> i32 {
    let next: i32 = destination.position;
    let shift: i32 = WORD_HIGH_SHIFT;
    while (shift >= 0) {
        next = byte(destination.data, destination.capacity, next,
            hex_digit((value >> shift) & NIBBLE_MASK));
        if (next <= -1) { return -1; }
        shift -= NIBBLE_BITS;
    }
    return next;
}

pub fn hex_natural_word(destination: Cursor, value: i32) -> i32 {
    if (value <= -1) { return -1; }
    return hex_word(destination, value);
}

pub fn natural(output:[i32], capacity: i32, position: i32, value: i32) -> i32 {
    if (value <= -1 || position <= -1 || !(position <= capacity)) { return -1; }
    let digits: i32 = 1;
    let remaining: i32 = value;
    while (remaining >= DECIMAL_RADIX) {
        remaining = remaining / DECIMAL_RADIX;
        digits += 1;
    }
    if (!(digits <= capacity - position)) { return -1; }
    remaining = value;
    let index: i32 = position + digits;
    while (index != position) {
        index -= 1;
        output[index] = verified::ascii::ZERO + remaining % DECIMAL_RADIX;
        remaining = remaining / DECIMAL_RADIX;
    }
    return position + digits;
}

pub fn bytes(output:[i32], capacity: i32, position: i32,
    input:[i32], length: i32,) -> i32 {
    if (length <= -1) { return -1; }
    let next: i32 = position;
    let index: i32 = 0;
    while (index != length) {
        next = byte(output, capacity, next, input[index]);
        if (next == -1) { return -1; }
        index += 1;
    }
    return next;
}

// Append the first `length` UTF-8 bytes of a compact string. Native strings
// store four bytes in each little-endian i32 word. Callers use literal byte
// lengths, making emitted Lean syntax readable without expanding it into a
// separate Lanius integer expression for every byte.
// Input storage must include padding through the last four-byte word; strings
// do not promise readable bytes beyond their contents. Padding is not emitted.
pub fn text(output:[i32], capacity: i32, position: i32,
    input: str, length: i32,) -> i32 {
    if (length <= -1) { return -1; }
    let words: [i32] = verified::host::i32_slice_from_raw_parts(
        verified::host::string_data_ptr(input),
        verified::host::packed_words(length));
    let next: i32 = position;
    let index: i32 = 0;
    while (index != length) {
        let value: i32 =
            (words[index / verified::host::I32_BYTES]
                >> ((index % verified::host::I32_BYTES)
                    * verified::host::BITS_PER_BYTE))
            & verified::host::BYTE_MASK;
        next = byte(output, capacity, next, value);
        if (next == -1) { return -1; }
        index += 1;
    }
    return next;
}
