module verified::semantic_token_output;

import verified::output;
import verified::semantic_tokens;
import verified::ascii;

// Emit packed semantic codes as List Nat. Split codes are expressed in Lean
// arithmetic so no unsigned value is ever forced through a signed i32.
pub fn emit(assignments: verified::semantic_tokens::AssignmentBuffer,
    token_count: i32,
    destination: verified::output::Cursor) -> i32 {
    let assignments_capacity: i32 = assignments.capacity;
    let output: [i32] = destination.data;
    let capacity: i32 = destination.capacity;
    let position: i32 = destination.position;
    if (assignments_capacity <= -1 || token_count <= -1
        || token_count > assignments_capacity) {
        return -1;
    }
    let prefix: str = "(2147483648+";
    let suffix: str = "*32768)";
    let next: i32 = verified::output::byte(output, capacity, position,
        verified::ascii::LEFT_BRACKET);
    let token: i32 = 0;
    let data: [verified::semantic_tokens::Assignment] = assignments.data;
    while (token != token_count) {
        let first: i32 = data[token].inner;
        let second: i32 = data[token].outer;
        if (first <= -1
            || first >= verified::semantic_tokens::SEMANTIC_KIND_RADIX
            || second <= -2
            || second >= verified::semantic_tokens::SEMANTIC_KIND_RADIX) {
            return -1;
        }
        if (token != 0) {
            next = verified::output::byte(output, capacity, next,
                verified::ascii::COMMA);
        }
        if (second != -1) {
            next = verified::output::text(output, capacity, next, prefix, 12);
        }
        next = verified::output::natural(output, capacity, next, first);
        if (second != -1) {
            next = verified::output::byte(output, capacity, next,
                verified::ascii::PLUS);
            next = verified::output::natural(output, capacity, next, second);
            next = verified::output::text(output, capacity, next, suffix, 7);
        }
        if (next == -1) { return -1; }
        token += 1;
    }
    return verified::output::byte(output, capacity, next,
        verified::ascii::RIGHT_BRACKET);
}
