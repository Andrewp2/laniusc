module verified::certificate_output;

import verified::output;
import verified::host;
import backend::frame;

// The certificate envelope is an ASCII transport around the existing compact
// pack, canonical Core transport, and the exact emitted ELF.  Version 3 adds
// an ELF byte count and ordered start/length pairs for every backend function.
const VERSION: i32 = 3;
const HEADER_WORDS: i32 = 2;
pub const HEADER_BYTES: i32 =
    HEADER_WORDS * verified::output::HEX_WORD_CHARACTERS;

// Reserve/write the two outer fields. The compact payload is emitted after
// HEADER_BYTES, so callers can provide its exact length once extraction ends.
pub fn emit_header(compact_length: i32, output:[i32], capacity: i32, position: i32) -> i32 {
    if (compact_length <= -1) { return -1; }
    let next: i32 = verified::output::hex_word(
        verified::output::cursor(output, capacity, position), VERSION);
    return verified::output::hex_word(
        verified::output::cursor(output, capacity, next), compact_length);
}

pub fn emit_transport(words:[i32], words_length: i32, count: i32,
    output:[i32], capacity: i32, position: i32,) -> i32 {
    if (words_length <= -1 || count <= -1 || count > words_length) { return -1; }
    let next: i32 = verified::output::hex_word(
        verified::output::cursor(output, capacity, position), count);
    if (next <= -1) { return -1; }
    let index: i32 = 0;
    while (index != count) {
        next = verified::output::hex_word(
            verified::output::cursor(output, capacity, next), words[index]);
        if (next <= -1) { return -1; }
        index += 1;
    }
    return next;
}

// Emit the complete ELF as canonical lower-case hex.  The source image is
// kept separate from the certificate workspace until every backend pass has
// succeeded, so the certificate cannot contain a partial executable.
pub fn emit_image(image:[i32], image_length: i32,
    output:[i32], capacity: i32, position: i32) -> i32 {
    if (image_length <= -1) { return -1; }
    let next: i32 = verified::output::hex_word(
        verified::output::cursor(output, capacity, position), image_length);
    if (next <= -1) { return -1; }
    let index: i32 = 0;
    while (index != image_length) {
        next = verified::output::hex_byte(
            verified::output::cursor(output, capacity, next), image[index]);
        if (next <= -1) { return -1; }
        index += 1;
    }
    return next;
}

// Work-table function starts are absolute output offsets. The explicit
// `function_end` state field is captured before runtime data is appended, so
// the final length ends exactly at the last function byte.
pub fn emit_functions(work: backend::frame::Workspace, stride: i32, count: i32,
    output:[i32], capacity: i32, position: i32) -> i32 {
    let state: [backend::frame::State] = backend::frame::state_view(work);
    if (work.words <= backend::frame::HEADER - 1 || stride <= -1
        || state[0].stride != stride || count <= -1 ||
        backend::frame::HEADER + stride
            * backend::frame::WORK_WORDS_PER_STRIDE
            > work.words ||
        count > stride) { return -1; }
    let end: i32 = state[0].function_end;
    if (end <= -1) { return -1; }
    let next: i32 = verified::output::hex_word(
        verified::output::cursor(output, capacity, position), count);
    if (next <= -1) { return -1; }
    let index: i32 = 0;
    while (index != count) {
        let start: i32 = backend::frame::function_code_start(work, index);
        let finish: i32 = end;
        if (index + 1 < count) {
            finish = backend::frame::function_code_start(work, index + 1);
        }
        if (start <= -1 || finish <= start) { return -1; }
        next = verified::output::hex_word(
            verified::output::cursor(output, capacity, next), start);
        next = verified::output::hex_word(
            verified::output::cursor(output, capacity, next), finish - start);
        if (next <= -1) { return -1; }
        index += 1;
    }
    return next;
}

pub fn emit_empty_functions(output:[i32], capacity: i32,
    position: i32) -> i32 {
    return verified::output::hex_word(
        verified::output::cursor(output, capacity, position), 0);
}

// Compact output occupies one i32 slot per byte until the whole pipeline has
// succeeded.  Pack those bytes in place, reading each four-byte group before
// overwriting its destination word.  This keeps certificate mode single-store
// and avoids a second large output allocation.
pub fn pack_in_place(output:[i32], length: i32) -> i32 {
    if (length <= -1) { return -1; }
    let word_count: i32 = verified::host::packed_words(length);
    let word: i32 = 0;
    while (word != word_count) {
        let base: i32 = word * verified::host::I32_BYTES;
        let first: i32 = output[base + verified::host::I32_BYTE_0];
        let second: i32 = 0;
        let third: i32 = 0;
        let fourth: i32 = 0;
        if (length > base + verified::host::I32_BYTE_1) {
            second = output[base + verified::host::I32_BYTE_1];
        }
        if (length > base + verified::host::I32_BYTE_2) {
            third = output[base + verified::host::I32_BYTE_2];
        }
        if (length > base + verified::host::I32_BYTE_3) {
            fourth = output[base + verified::host::I32_BYTE_3];
        }
        output[word] = first
            | (second << verified::host::BITS_PER_BYTE)
            | (third << (verified::host::BITS_PER_BYTE
                * verified::host::I32_BYTE_2))
            | (fourth << (verified::host::BITS_PER_BYTE
                * verified::host::I32_BYTE_3));
        word += 1;
    }
    return word_count;
}
