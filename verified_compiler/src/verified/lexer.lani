module verified::lexer;

import verified::ascii;

// The lexical categories used to select the scanner for the next raw token.
// Trivia is classified here because raw-token scanning must consume it even
// though the parser-facing token stream later filters it out.
pub enum StartClass {
    IdentifierStart,
    DecimalNumberStart,
    WhitespaceStart,
    SymbolStart,
    StringLiteralStart,
    CharacterLiteralStart,
    InvalidStart,
}

pub fn start_code(class: StartClass) -> i32 {
    return match (class) {
        IdentifierStart -> 0,
        DecimalNumberStart -> 1,
        WhitespaceStart -> 2,
        SymbolStart -> 3,
        StringLiteralStart -> 4,
        CharacterLiteralStart -> 5,
        InvalidStart -> 6,
    };
}

pub fn start_is(class: StartClass, expected: StartClass) -> bool {
    return start_code(class) == start_code(expected);
}

pub fn is_identifier_start(byte: i32) -> bool {
    return byte >= verified::ascii::LOWER_A
        && byte <= verified::ascii::LOWER_Z
        || byte >= verified::ascii::UPPER_A
        && byte <= verified::ascii::UPPER_Z
        || byte == verified::ascii::UNDERSCORE;
}


pub fn is_identifier_continue(byte: i32) -> bool {
    return is_identifier_start(byte) || is_decimal_digit(byte);
}

pub fn is_decimal_digit(byte: i32) -> bool {
    return byte >= verified::ascii::ZERO && byte <= verified::ascii::NINE;
}

pub fn is_whitespace(byte: i32) -> bool {
    return byte == verified::ascii::SPACE
        || byte == verified::ascii::TAB
        || byte == verified::ascii::LINE_FEED
        || byte == verified::ascii::CARRIAGE_RETURN;
}

pub fn is_symbol_start(byte: i32) -> bool {
    return byte == verified::ascii::LEFT_PAREN
        || byte == verified::ascii::RIGHT_PAREN
        || byte == verified::ascii::PLUS
        || byte == verified::ascii::ASTERISK
        || byte == verified::ascii::EQUAL
        || byte == verified::ascii::MINUS
        || byte == verified::ascii::SLASH
        || byte == verified::ascii::EXCLAMATION
        || byte == verified::ascii::LEFT_BRACKET
        || byte == verified::ascii::RIGHT_BRACKET
        || byte == verified::ascii::LEFT_BRACE
        || byte == verified::ascii::RIGHT_BRACE
        || byte == verified::ascii::LESS
        || byte == verified::ascii::GREATER
        || byte == verified::ascii::AMPERSAND
        || byte == verified::ascii::PIPE
        || byte == verified::ascii::PERCENT
        || byte == verified::ascii::CARET
        || byte == verified::ascii::TILDE
        || byte == verified::ascii::COMMA
        || byte == verified::ascii::SEMICOLON
        || byte == verified::ascii::COLON
        || byte == verified::ascii::QUESTION
        || byte == verified::ascii::DOT;
}

pub fn classify_start(byte: i32) -> StartClass {
    if (is_identifier_start(byte)) {
        return IdentifierStart;
    } else {
        if (is_decimal_digit(byte)) {
            return DecimalNumberStart;
        } else {
            if (is_whitespace(byte)) {
                return WhitespaceStart;
            } else {
                if (byte == verified::ascii::QUOTE) {
                    return StringLiteralStart;
                } else {
                    if (byte == verified::ascii::APOSTROPHE) {
                        return CharacterLiteralStart;
                    } else {
                        if (is_symbol_start(byte)) {
                            return SymbolStart;
                        } else {
                            return InvalidStart;
                        }
                    }
                }
            }
        }
    }
}

// Returns the exclusive end of an identifier whose first byte is at `start`.
// The caller establishes that `start` is in bounds and starts an identifier.
pub fn scan_identifier_end(source: [i32], source_length: i32, start: i32) -> i32 {
    let end: i32 = start + 1;
    while (end <= source_length - 1 && is_identifier_continue(source[end])) {
        end += 1;
    }
    return end;
}

// Returns the exclusive end of a nonempty whitespace run beginning at
// `start`. The caller establishes that the first byte is whitespace.
pub fn scan_whitespace_end(source: [i32], source_length: i32, start: i32) -> i32 {
    let end: i32 = start + 1;
    while (end <= source_length - 1 && is_whitespace(source[end])) {
        end += 1;
    }
    return end;
}

pub struct ScanEnd {
    success: bool,
    end_offset: i32,
    error_offset: i32,
}

pub fn scan_succeeded(result: ScanEnd) -> bool {
    return result.success;
}

pub fn scan_end_offset(result: ScanEnd) -> i32 {
    return result.end_offset;
}

pub fn scan_error_offset(result: ScanEnd) -> i32 {
    return result.error_offset;
}

fn successful_scan(end_offset: i32) -> ScanEnd {
    return ScanEnd { success: true, end_offset: end_offset, error_offset: 0 };
}

fn failed_scan(error_offset: i32) -> ScanEnd {
    return ScanEnd { success: false, end_offset: 0, error_offset: error_offset };
}

// The opening quote at `start` has already been classified. A raw newline is
// the first invalid byte; missing closing quotes fail at the EOF byte offset.
fn scan_quoted_end(
    source: [i32],
    source_length: i32,
    start: i32,
    delimiter: i32,
) -> ScanEnd {
    let offset: i32 = start + 1;
    let escaping: bool = false;
    while (offset <= source_length - 1) {
        let byte: i32 = source[offset];
        if (escaping) {
            escaping = false;
            offset += 1;
        } else {
            if (byte == verified::ascii::LINE_FEED) {
                return failed_scan(offset);
            }
            if (byte == delimiter) {
                return successful_scan(offset + 1);
            }
            if (byte == verified::ascii::BACKSLASH) {
                escaping = true;
            }
            offset += 1;
        }
    }
    return failed_scan(source_length);
}


pub fn scan_string_end(source: [i32], source_length: i32, start: i32) -> ScanEnd {
    return scan_quoted_end(source, source_length, start,
        verified::ascii::QUOTE);
}

pub fn scan_character_end(source: [i32], source_length: i32, start: i32) -> ScanEnd {
    return scan_quoted_end(source, source_length, start,
        verified::ascii::APOSTROPHE);
}

pub fn scan_line_comment_end(source: [i32], source_length: i32, start: i32) -> i32 {
    let end: i32 = start + 2;
    while (end <= source_length - 1
        && source[end] != verified::ascii::LINE_FEED) {
        end += 1;
    }
    return end;
}

pub fn scan_block_comment_end(source: [i32], source_length: i32, start: i32) -> ScanEnd {
    let offset: i32 = start + 2;
    while (offset <= source_length - 1) {
        if (source[offset] == verified::ascii::ASTERISK
            && offset + 1 <= source_length - 1
            && source[offset + 1] == verified::ascii::SLASH) {
            return successful_scan(offset + 2);
        }
        offset += 1;
    }
    return failed_scan(source_length);
}
