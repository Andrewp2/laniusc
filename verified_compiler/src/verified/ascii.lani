module verified::ascii;

// Named UTF-8/ASCII bytes used by the lexer and textual serializers. Numeric
// representation is confined to this byte-boundary module.
pub const TAB: i32 = 9;
pub const LINE_FEED: i32 = 10;
pub const CARRIAGE_RETURN: i32 = 13;
pub const SPACE: i32 = 32;
pub const EXCLAMATION: i32 = 33;
pub const QUOTE: i32 = 34;
pub const PERCENT: i32 = 37;
pub const AMPERSAND: i32 = 38;
pub const APOSTROPHE: i32 = 39;
pub const LEFT_PAREN: i32 = 40;
pub const RIGHT_PAREN: i32 = 41;
pub const ASTERISK: i32 = 42;
pub const PLUS: i32 = 43;
pub const COMMA: i32 = 44;
pub const MINUS: i32 = 45;
pub const DOT: i32 = 46;
pub const SLASH: i32 = 47;
pub const ZERO: i32 = 48;
pub const NINE: i32 = 57;
pub const COLON: i32 = 58;
pub const SEMICOLON: i32 = 59;
pub const LESS: i32 = 60;
pub const EQUAL: i32 = 61;
pub const GREATER: i32 = 62;
pub const QUESTION: i32 = 63;
pub const UPPER_A: i32 = 65;
pub const UPPER_B: i32 = 66;
pub const UPPER_E: i32 = 69;
pub const UPPER_F: i32 = 70;
pub const UPPER_O: i32 = 79;
pub const UPPER_X: i32 = 88;
pub const UPPER_Z: i32 = 90;
pub const LEFT_BRACKET: i32 = 91;
pub const BACKSLASH: i32 = 92;
pub const RIGHT_BRACKET: i32 = 93;
pub const CARET: i32 = 94;
pub const UNDERSCORE: i32 = 95;
pub const LOWER_A: i32 = 97;
pub const LOWER_B: i32 = 98;
pub const LOWER_E: i32 = 101;
pub const LOWER_F: i32 = 102;
pub const LOWER_N: i32 = 110;
pub const LOWER_O: i32 = 111;
pub const LOWER_R: i32 = 114;
pub const LOWER_T: i32 = 116;
pub const LOWER_X: i32 = 120;
pub const LOWER_Z: i32 = 122;
pub const LEFT_BRACE: i32 = 123;
pub const PIPE: i32 = 124;
pub const RIGHT_BRACE: i32 = 125;
pub const TILDE: i32 = 126;
