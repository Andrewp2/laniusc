module verified::parse_tree;

import verified::parser;
import verified::syntax_tree;

pub enum TreeStage {
    Materialized,
    InvalidInput,
    OutputStorageFull,
    DepthLimitReached,
}

pub fn stage_code(stage: TreeStage) -> i32 {
    return match (stage) {
        Materialized -> 0,
        InvalidInput -> 1,
        OutputStorageFull -> 2,
        DepthLimitReached -> 3,
    };
}

pub struct TreeResult {
    stage: TreeStage,
    node_count: i32,
    words_used: i32,
}

pub struct TreeStorage {
    records: [i32],
    record_capacity: i32,
    offsets: [i32],
    offset_capacity: i32,
}

pub fn storage(records: [i32], record_capacity: i32, offsets: [i32],
    offset_capacity: i32) -> TreeStorage {
    return TreeStorage { records: records, record_capacity: record_capacity,
        offsets: offsets, offset_capacity: offset_capacity };
}

pub fn tree_stage_code(result: TreeResult) -> i32 { return stage_code(result.stage); }
pub fn tree_has_stage(result: TreeResult, expected: TreeStage) -> bool {
    return result.stage == expected;
}
pub fn tree_succeeded(result: TreeResult) -> bool {
    return tree_has_stage(result, Materialized);
}
pub fn tree_node_count(result: TreeResult) -> i32 { return result.node_count; }
pub fn tree_words_used(result: TreeResult) -> i32 { return result.words_used; }
pub fn tree_root(result: TreeResult) -> i32 {
    if (!tree_succeeded(result)) { return -1; }
    return result.node_count - 1;
}
fn result(stage: TreeStage, node_count: i32, words_used: i32) -> TreeResult {
    return TreeResult { stage: stage, node_count: node_count,
        words_used: words_used };
}

// The artifact encoding is preorder, while native node IDs are postorder.
// Serialize the retained native tree without returning to parser states.
fn write_native(tree: verified::syntax_tree::Tree, node: i32,
    token_count: i32, storage: TreeStorage, position: i32,
    depth: i32) -> TreeResult {
    if (depth <= 0) { return result(DepthLimitReached, 0, position); }
    if (node <= -1 || node >= tree.node_count) {
        return result(InvalidInput, 0, position);
    }
    let records: [i32] = storage.records;
    let offsets: [i32] = storage.offsets;
    if (offsets[node] != -1) { return result(InvalidInput, 0, position); }
    let nodes: [verified::syntax_tree::Node] = tree.nodes;
    let children: [verified::syntax_tree::Child] = tree.children;
    let current: verified::syntax_tree::Node = nodes[node];
    let count: i32 = current.child_count;
    if (current.production <= -1 || current.origin <= -1
        || current.end <= current.origin - 1
        || current.first_child <= -1
        || count <= -1 || current.first_child > tree.child_count
        || count > tree.child_count - current.first_child) {
        return result(InvalidInput, 0, position);
    }
    if (position <= -1 || position > storage.record_capacity) {
        return result(OutputStorageFull, 0, position);
    }
    let remaining: i32 = storage.record_capacity - position;
    if (remaining <= verified::parser::DERIVATION_HEADER_WORDS - 1
        || count > (remaining - verified::parser::DERIVATION_HEADER_WORDS)
            / verified::parser::DERIVATION_CHILD_WORDS) {
        return result(OutputStorageFull, 0, position);
    }
    records[position + verified::parser::DERIVATION_PRODUCTION_FIELD]
        = current.production;
    records[position + verified::parser::DERIVATION_ORIGIN_FIELD]
        = current.origin;
    records[position + verified::parser::DERIVATION_END_FIELD]
        = current.end;
    records[position + verified::parser::DERIVATION_CHILD_COUNT_FIELD]
        = count;
    let next: i32 = position + verified::parser::DERIVATION_HEADER_WORDS
        + count * verified::parser::DERIVATION_CHILD_WORDS;
    let child: i32 = 0;
    while (child != count) {
        let item: verified::syntax_tree::Child =
            children[current.first_child + child];
        if ((item.kind == verified::parser::StateChild
                && (item.payload <= -1 || item.payload >= node))
            || (item.kind == verified::parser::TokenChild
                && (item.payload <= -1 || item.payload >= token_count))
            || item.kind == verified::parser::NoChild) {
            return result(InvalidInput, 0, position);
        }
        let slot: i32 = position
            + verified::parser::DERIVATION_HEADER_WORDS
            + child * verified::parser::DERIVATION_CHILD_WORDS;
        records[slot + verified::parser::DERIVATION_CHILD_TAG_FIELD]
            = verified::parser::child_code(item.kind);
        records[slot + verified::parser::DERIVATION_CHILD_PAYLOAD_FIELD]
            = item.payload;
        records[slot + verified::parser::DERIVATION_CHILD_KIND_FIELD]
            = item.semantic_kind;
        child += 1;
    }
    let visited: i32 = 1;
    child = 0;
    while (child != count) {
        let item: verified::syntax_tree::Child =
            children[current.first_child + child];
        if (item.kind == verified::parser::StateChild) {
            let nested: TreeResult = write_native(tree, item.payload,
                token_count, storage, next, depth - 1);
            if (!tree_succeeded(nested)) { return nested; }
            visited += nested.node_count;
            next = nested.words_used;
        }
        child += 1;
    }
    offsets[node] = position;
    return result(Materialized, visited, next);
}

pub fn serialize_native(tree: verified::syntax_tree::Tree,
    token_count: i32, storage: TreeStorage, depth_limit: i32) -> TreeResult {
    if (tree.node_count <= 0 || tree.child_count <= -1
        || token_count <= -1 || storage.record_capacity <= -1
        || storage.offset_capacity <= -1) {
        return result(InvalidInput, 0, 0);
    }
    if (tree.node_count > storage.offset_capacity) {
        return result(OutputStorageFull, 0, 0);
    }
    let offsets: [i32] = storage.offsets;
    let node: i32 = 0;
    let total_nodes: i32 = tree.node_count;
    while (node != total_nodes) {
        offsets[node] = -1;
        node += 1;
    }
    let written: TreeResult = write_native(tree, tree.node_count - 1,
        token_count, storage, 0, depth_limit);
    if (!tree_succeeded(written)) { return written; }
    if (written.node_count != tree.node_count) {
        return result(InvalidInput, written.node_count, written.words_used);
    }
    return written;
}
