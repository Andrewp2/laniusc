module verified::parse_tree;

import verified::parser;

pub enum TreeStage {
    Materialized,
    InvalidInput,
    OutputStorageFull,
    DepthLimitReached,
}

pub fn stage_code(stage: TreeStage) -> i32 {
    return match (stage) {
        Materialized -> 0,
        InvalidInput -> 1,
        OutputStorageFull -> 2,
        DepthLimitReached -> 3,
    };
}

pub struct TreeResult {
    stage: TreeStage,
    node_count: i32,
    words_used: i32,
}

pub struct TreeInput {
    workspace: verified::parser::WorkspaceStorage,
    token_count: i32,
    depth_limit: i32,
}

pub fn input(workspace: verified::parser::WorkspaceStorage, token_count: i32,
    depth_limit: i32) -> TreeInput {
    return TreeInput { workspace: workspace,
        token_count: token_count, depth_limit: depth_limit };
}

pub struct TreeStorage {
    records: [i32],
    record_capacity: i32,
    offsets: [i32],
    offset_capacity: i32,
}

pub fn storage(records: [i32], record_capacity: i32, offsets: [i32],
    offset_capacity: i32) -> TreeStorage {
    return TreeStorage { records: records, record_capacity: record_capacity,
        offsets: offsets, offset_capacity: offset_capacity };
}

struct TreeContext {
    workspace: verified::parser::WorkspaceStorage,
    token_count: i32,
    state_count: i32,
    records: [i32],
    record_capacity: i32,
    offsets: [i32],
    offset_capacity: i32,
}
pub fn tree_stage_code(result: TreeResult) -> i32 { return stage_code(result.stage); }
pub fn tree_has_stage(result: TreeResult, expected: TreeStage) -> bool {
    return stage_code(result.stage) == stage_code(expected);
}
pub fn tree_succeeded(result: TreeResult) -> bool {
    return tree_has_stage(result, Materialized);
}
pub fn tree_node_count(result: TreeResult) -> i32 { return result.node_count; }
pub fn tree_words_used(result: TreeResult) -> i32 { return result.words_used; }
pub fn tree_root(result: TreeResult) -> i32 {
    if (!tree_succeeded(result)) { return -1; }
    return result.node_count - 1;
}
fn result(stage: TreeStage, node_count: i32, words_used: i32) -> TreeResult {
    return TreeResult { stage: stage, node_count: node_count,
        words_used: words_used };
}

// A record has the copy_derivation header followed by child triples.
// Its state children are rewritten to dense output node IDs. offsets[node]
// locates the record; IDs are postorder even though record storage is preorder.
// Shared derivation states are expanded per occurrence, matching a syntax tree.
fn visit(context: TreeContext, state_id: i32, node_count: i32,
    words_used: i32, depth: i32) -> TreeResult {
    let records: [i32] = context.records;
    let offsets: [i32] = context.offsets;
    if (depth <= 0) { return result(DepthLimitReached, node_count, words_used); }
    if (node_count >= context.offset_capacity) {
        return result(OutputStorageFull, node_count, words_used);
    }
    let derivation_input: verified::parser::DerivationInput =
        verified::parser::DerivationInput {
            workspace: context.workspace,
            token_count: context.token_count,
            state_count: context.state_count,
            state_id: state_id,
        };
    let derivation_output: verified::parser::DerivationOutput =
        verified::parser::DerivationOutput {
            data: records,
            capacity: context.record_capacity,
            offset: words_used,
        };
    let count: i32 = verified::parser::copy_derivation(
        derivation_input, derivation_output);
    if (count == -2) { return result(OutputStorageFull, node_count, words_used); }
    if (count <= -1) { return result(InvalidInput, node_count, words_used); }
    let next_word: i32 = words_used
        + verified::parser::DERIVATION_HEADER_WORDS
        + count * verified::parser::DERIVATION_CHILD_WORDS;
    let next_node: i32 = node_count;
    let child: i32 = 0;
    while (child != count) {
        let slot: i32 = words_used
            + verified::parser::DERIVATION_HEADER_WORDS
            + child * verified::parser::DERIVATION_CHILD_WORDS;
        if (records[slot + verified::parser::DERIVATION_CHILD_TAG_FIELD]
                == verified::parser::child_code(
                    verified::parser::StateChild)) {
            let nested: TreeResult = visit(context, records[slot
                    + verified::parser::DERIVATION_CHILD_PAYLOAD_FIELD],
                next_node, next_word, depth - 1);
            if (!tree_succeeded(nested)) { return nested; }
            records[slot + verified::parser::DERIVATION_CHILD_PAYLOAD_FIELD]
                = nested.node_count - 1;
            next_node = nested.node_count;
            next_word = nested.words_used;
        }
        child += 1;
    }
    if (next_node >= context.offset_capacity) {
        return result(OutputStorageFull, next_node, next_word);
    }
    offsets[next_node] = words_used;
    return result(Materialized, next_node + 1, next_word);
}

// Consume an unchanged successful recognizer workspace. Buffers must be
// disjoint, and the supplied lengths must describe their actual storage.
// No allocation, token scanning, or grammar search occurs here. Partial
// output after failure is not an accepted tree and must not be serialized.
pub fn materialize(parsed: verified::parser::ParseResult, tree_input: TreeInput,
    tree_storage: TreeStorage) -> TreeResult {
    if (!verified::parser::parse_succeeded(parsed)
        || tree_storage.record_capacity <= -1
        || tree_storage.offset_capacity <= -1) {
        return result(InvalidInput, 0, 0);
    }
    let context: TreeContext = TreeContext {
        workspace: tree_input.workspace,
        token_count: tree_input.token_count,
        state_count: verified::parser::parse_state_count(parsed),
        records: tree_storage.records,
        record_capacity: tree_storage.record_capacity,
        offsets: tree_storage.offsets,
        offset_capacity: tree_storage.offset_capacity,
    };
    return visit(context,
        verified::parser::parse_root_state(parsed), 0, 0,
        tree_input.depth_limit);
}
