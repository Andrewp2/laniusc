module verified::parser;

import verified::host;
import verified::token;

// A generic Earley recognizer over a physical-token lattice. The caller owns
// both immutable grammar storage and the reusable workspace; recognizing a
// source allocates no parser-owned memory.
pub enum ParseStage {
    Parsed,
    Rejected,
    StateStorageFull,
    InvalidGrammar,
    InvalidInput,
}

pub fn stage_code(stage: ParseStage) -> i32 {
    return match (stage) {
        Parsed -> 0,
        Rejected -> 1,
        StateStorageFull -> 2,
        InvalidGrammar -> 3,
        InvalidInput -> 4,
    };
}
const GRAMMAR_VERSION: i32 = 1;
pub const GRAMMAR_HEADER_WORDS: i32 = 17;
pub const HEADER_VERSION: i32 = 0;
pub const HEADER_KIND_COUNT: i32 = 1;
pub const HEADER_PRODUCTION_COUNT: i32 = 2;
pub const HEADER_NONTERMINAL_COUNT: i32 = 3;
pub const HEADER_START_NONTERMINAL: i32 = 4;
pub const HEADER_SPLIT_TOKEN_KIND: i32 = 5;
pub const HEADER_SPLIT_COMPONENT_KIND: i32 = 6;
pub const HEADER_CANONICAL_KINDS_OFFSET: i32 = 7;
pub const HEADER_PRODUCTION_LHS_OFFSET: i32 = 8;
pub const HEADER_RHS_OFFSETS_OFFSET: i32 = 9;
pub const HEADER_RHS_LENGTHS_OFFSET: i32 = 10;
pub const HEADER_RHS_SYMBOLS_OFFSET: i32 = 11;
pub const HEADER_RHS_SYMBOL_COUNT: i32 = 12;
pub const HEADER_LHS_OFFSETS_OFFSET: i32 = 13;
pub const HEADER_LHS_COUNTS_OFFSET: i32 = 14;
pub const HEADER_LHS_PRODUCTIONS_OFFSET: i32 = 15;
pub const HEADER_LHS_PRODUCTION_COUNT: i32 = 16;
pub const DERIVATION_HEADER_WORDS: i32 = 4;
pub const DERIVATION_PRODUCTION_FIELD: i32 = 0;
pub const DERIVATION_ORIGIN_FIELD: i32 = 1;
pub const DERIVATION_END_FIELD: i32 = 2;
pub const DERIVATION_CHILD_COUNT_FIELD: i32 = 3;
pub const DERIVATION_CHILD_WORDS: i32 = 3;
pub const DERIVATION_CHILD_TAG_FIELD: i32 = 0;
pub const DERIVATION_CHILD_PAYLOAD_FIELD: i32 = 1;
pub const DERIVATION_CHILD_KIND_FIELD: i32 = 2;
pub const LATTICE_POSITIONS_PER_TOKEN: i32 = 2;
const MAX_TOKEN_COUNT: i32 = 536870911;
// A state records one recognized prefix. `previous_state` and the child fields
// retain a derivation for later parse-tree materialization; deduplication keeps
// the first derivation for each (production, dot, origin) at a chart position.
const VALUE_BYTES: i32 = 8;
const CHART_FIELDS: i32 = 2;
const STATE_FIELDS: i32 = 13;
const CHART_RECORD_BYTES: i32 = CHART_FIELDS * VALUE_BYTES;
const STATE_RECORD_BYTES: i32 = STATE_FIELDS * VALUE_BYTES;
const CHART_RECORD_WORDS: i32 = CHART_RECORD_BYTES
    / verified::host::I32_BYTES;
const STATE_BUCKETS: i32 = 16;
const ACTION_BUCKETS: i32 = 16;
const CHART_STORAGE_WORDS: i32 = CHART_RECORD_WORDS + STATE_BUCKETS
    + ACTION_BUCKETS * 2;
const STATE_RECORD_WORDS: i32 = STATE_RECORD_BYTES
    / verified::host::I32_BYTES;
pub enum ChildKind {
    NoChild,
    TokenChild,
    StateChild,
}

struct Chart {
    head: i32,
    tail: i32,
}

// Derived once from the immutable grammar, then reused by chart scans.
enum StateAction {
    Expect(i32),
    Complete(i32),
}

struct State {
    production: i32,
    dot: i32,
    origin: i32,
    position: i32,
    next: i32,
    bucket_next: i32,
    action_next: i32,
    previous: i32,
    child: ChildKind,
    child_payload: i32,
    semantic_kind: i32,
    action: StateAction,
}

struct ParserWorkspace {
    charts: [Chart],
    state_heads: [i32],
    action_heads: [i32],
    action_tails: [i32],
    states: [State],
    state_capacity: i32,
}

pub struct WorkspaceStorage {
    memory: ptr,
    words: i32,
}

pub fn storage(memory: ptr, words: i32) -> WorkspaceStorage {
    return WorkspaceStorage { memory: memory, words: words };
}

fn chart_slice(data: ptr, length: i32) -> [Chart] {
    return slice_from_raw_parts(data, length);
}

fn state_slice(data: ptr, length: i32) -> [State] {
    return slice_from_raw_parts(data, length);
}

fn workspace_view(storage: WorkspaceStorage, chart_count: i32,
    state_capacity: i32) -> ParserWorkspace {
    let base: ptr = storage.memory;
    // Aggregate slices address the first field at their pointer and later
    // fields/elements at descending machine words. Point to the last word of
    // each region, not one byte past it.
    let index_start: ptr = base + chart_count * CHART_RECORD_BYTES;
    let state_start: ptr = base
        + chart_count * CHART_STORAGE_WORDS * verified::host::I32_BYTES;
    let chart_first: ptr = index_start - VALUE_BYTES;
    let state_first: ptr = state_start
        + state_capacity * STATE_RECORD_BYTES - VALUE_BYTES;
    return ParserWorkspace {
        charts: chart_slice(chart_first, chart_count),
        state_heads: verified::host::i32_slice_from_raw_parts(index_start,
            chart_count * STATE_BUCKETS),
        action_heads: verified::host::i32_slice_from_raw_parts(
            index_start + chart_count * STATE_BUCKETS * verified::host::I32_BYTES,
            chart_count * ACTION_BUCKETS),
        action_tails: verified::host::i32_slice_from_raw_parts(
            index_start + chart_count * (STATE_BUCKETS + ACTION_BUCKETS)
                * verified::host::I32_BYTES,
            chart_count * ACTION_BUCKETS),
        states: state_slice(state_first, state_capacity),
        state_capacity: state_capacity,
    };
}

pub fn child_code(kind: ChildKind) -> i32 {
    return match (kind) {
        NoChild -> 0,
        TokenChild -> 1,
        StateChild -> 2,
    };
}

pub fn encoded_child_is(encoded: i32, expected: ChildKind) -> bool {
    return encoded == child_code(expected);
}
enum AppendStage {
    Appended,
    StorageFull,
}
pub struct ParseResult {
    stage: ParseStage,
    state_count: i32,
    root_state: i32,
    error_position: i32,
}

pub struct DerivationInput {
    workspace: WorkspaceStorage,
    token_count: i32,
    state_count: i32,
    state_id: i32,
}

pub struct DerivationOutput {
    data: [i32],
    capacity: i32,
    offset: i32,
}

// Native consumers read the retained derivation directly from typed parser
// states. The packed copy_derivation output remains the certificate format.
pub struct DerivationHeader {
    valid: bool,
    production: i32,
    origin: i32,
    end: i32,
    child_count: i32,
}

pub struct DerivationChild {
    valid: bool,
    kind: ChildKind,
    payload: i32,
    semantic_kind: i32,
}

pub struct DerivationReader {
    states: [State],
    token_count: i32,
    state_count: i32,
    valid: bool,
}

fn invalid_derivation_header() -> DerivationHeader {
    return DerivationHeader {
        valid: false, production: -1, origin: -1, end: -1,
        child_count: 0,
    };
}

fn invalid_derivation_child() -> DerivationChild {
    return DerivationChild {
        valid: false, kind: NoChild, payload: -1, semantic_kind: -1,
    };
}

fn derivation_view_valid(input: DerivationInput) -> bool {
    let workspace: WorkspaceStorage = input.workspace;
    let workspace_length: i32 = workspace.words;
    if (input.token_count <= -1 || input.token_count > MAX_TOKEN_COUNT
        || workspace.memory == 0 || workspace_length <= -1
        || workspace_length > verified::host::I32_MAX
            / verified::host::I32_BYTES
        || input.state_count <= -1 || input.state_id <= -1
        || input.state_id >= input.state_count) {
        return false;
    }
    let chart_count: i32 = input.token_count
        * LATTICE_POSITIONS_PER_TOKEN + 1;
    if (chart_count > workspace_length / CHART_STORAGE_WORDS) {
        return false;
    }
    let chart_words: i32 = chart_count * CHART_STORAGE_WORDS;
    let state_capacity: i32 = (workspace_length - chart_words)
        / STATE_RECORD_WORDS;
    return input.state_count <= state_capacity;
}

fn derivation_states(input: DerivationInput) -> [State] {
    let chart_count: i32 = input.token_count
        * LATTICE_POSITIONS_PER_TOKEN + 1;
    let state_capacity: i32 = (input.workspace.words
        - chart_count * CHART_STORAGE_WORDS) / STATE_RECORD_WORDS;
    let work: ParserWorkspace = workspace_view(input.workspace, chart_count,
        state_capacity);
    return work.states;
}

pub fn derivation_reader(input: DerivationInput) -> DerivationReader {
    let nowhere: ptr = 0;
    if (!derivation_view_valid(input)) {
        return DerivationReader {
            states: state_slice(nowhere, 0), token_count: 0,
            state_count: 0, valid: false,
        };
    }
    return DerivationReader {
        states: derivation_states(input), token_count: input.token_count,
        state_count: input.state_count, valid: true,
    };
}

pub fn read_derivation_header(reader: DerivationReader,
    state_id: i32) -> DerivationHeader {
    let invalid: DerivationHeader = invalid_derivation_header();
    if (!reader.valid || state_id <= -1 || state_id >= reader.state_count) {
        return invalid;
    }
    let states: [State] = reader.states;
    let state: State = states[state_id];
    if (state.dot <= -1 || state.dot > reader.state_count
        || state.production <= -1 || state.origin <= -1
        || state.position < state.origin) { return invalid; }
    if (state.dot == 0 && (state.previous != -1
        || state.child != NoChild)) { return invalid; }
    return DerivationHeader {
        valid: true, production: state.production,
        origin: state.origin, end: state.position,
        child_count: state.dot,
    };
}

// Children are returned in grammar order. A retained prefix chain is walked
// backwards to the requested slot, validating every traversed link.
pub fn read_derivation_child(reader: DerivationReader,
    state_id: i32, index: i32) -> DerivationChild {
    let invalid: DerivationChild = invalid_derivation_child();
    let header: DerivationHeader = read_derivation_header(reader, state_id);
    if (!header.valid || index <= -1 || index >= header.child_count) {
        return invalid;
    }
    let states: [State] = reader.states;
    let current: i32 = state_id;
    let remaining: i32 = header.child_count;
    while (remaining > index + 1) {
        let step: State = states[current];
        if (step.dot != remaining || step.production != header.production
            || step.origin != header.origin || step.previous <= -1
            || step.previous >= current) { return invalid; }
        current = step.previous;
        remaining -= 1;
    }
    let selected: State = states[current];
    let previous: i32 = selected.previous;
    if (selected.dot != remaining
        || selected.production != header.production
        || selected.origin != header.origin
        || previous <= -1 || previous >= current
        || selected.child_payload <= -1) { return invalid; }
    if (selected.child == TokenChild) {
        if (selected.child_payload >= reader.token_count) { return invalid; }
    } else {
        if (selected.child != StateChild
            || selected.child_payload >= current) { return invalid; }
    }
    if (index == 0) {
        let base: State = states[previous];
        if (base.dot != 0 || base.production != header.production
            || base.origin != header.origin || base.previous != -1
            || base.child != NoChild) { return invalid; }
    }
    return DerivationChild {
        valid: true, kind: selected.child,
        payload: selected.child_payload,
        semantic_kind: selected.semantic_kind,
    };
}
pub fn parse_stage_code(result: ParseResult) -> i32 {
    return stage_code(result.stage);
}
pub fn parse_has_stage(result: ParseResult, expected: ParseStage) -> bool {
    return result.stage == expected;
}
pub fn parse_succeeded(result: ParseResult) -> bool {
    return parse_has_stage(result, Parsed);
}
pub fn parse_state_count(result: ParseResult) -> i32 {
    return result.state_count;
}
pub fn parse_root_state(result: ParseResult) -> i32 {
    return result.root_state;
}
pub fn parse_error_position(result: ParseResult) -> i32 {
    return result.error_position;
}
fn parse_result(stage: ParseStage, state_count: i32, root_state: i32,
    error_position: i32,) -> ParseResult {
    return ParseResult {
        stage: stage,
        state_count: state_count,
        root_state: root_state,
        error_position: error_position,
    };
}
struct StateSeed {
    production: i32,
    dot: i32,
    origin: i32,
    previous_state: i32,
    child: ChildKind,
    child_payload: i32,
    semantic_kind: i32,
}
fn state_seed(production: i32, dot: i32, origin: i32, previous_state: i32,
    child: ChildKind, child_payload: i32, semantic_kind: i32,) -> StateSeed {
    return StateSeed {
        production: production,
        dot: dot,
        origin: origin,
        previous_state: previous_state,
        child: child,
        child_payload: child_payload,
        semantic_kind: semantic_kind,
    };
}
struct AppendResult {
    stage: AppendStage,
    state_count: i32,
}
fn append_storage_full(result: AppendResult) -> bool {
    return match (result.stage) {
        Appended -> false,
        StorageFull -> true,
    };
}
fn range_valid(offset: i32, count: i32, length: i32) -> bool {
    return offset >= GRAMMAR_HEADER_WORDS && count >= 0 && offset <= length && count <= length - offset;
}
fn grammar_is_valid(grammar:[i32], grammar_length: i32) -> bool {
    if (grammar_length <= GRAMMAR_HEADER_WORDS - 1) {
        return false;
    }
    if (grammar[HEADER_VERSION] != GRAMMAR_VERSION) {
        return false;
    }
    let kind_count: i32 = grammar[HEADER_KIND_COUNT];
    let production_count: i32 = grammar[HEADER_PRODUCTION_COUNT];
    let nonterminal_count: i32 = grammar[HEADER_NONTERMINAL_COUNT];
    let start_nonterminal: i32 = grammar[HEADER_START_NONTERMINAL];
    let rhs_symbol_count: i32 = grammar[HEADER_RHS_SYMBOL_COUNT];
    let lhs_production_count: i32 = grammar[HEADER_LHS_PRODUCTION_COUNT];
    if (kind_count <= 0 || production_count <= 0 || nonterminal_count <= 0 || start_nonterminal <= -1 || start_nonterminal >= nonterminal_count) {
        return false;
    }
    if (!range_valid(grammar[HEADER_CANONICAL_KINDS_OFFSET], kind_count, grammar_length) || !range_valid(grammar[HEADER_PRODUCTION_LHS_OFFSET], production_count, grammar_length) || !range_valid(grammar[HEADER_RHS_OFFSETS_OFFSET], production_count, grammar_length) || !range_valid(grammar[HEADER_RHS_LENGTHS_OFFSET], production_count, grammar_length) || !range_valid(grammar[HEADER_RHS_SYMBOLS_OFFSET], rhs_symbol_count, grammar_length) || !range_valid(grammar[HEADER_LHS_OFFSETS_OFFSET], nonterminal_count, grammar_length) || !range_valid(grammar[HEADER_LHS_COUNTS_OFFSET], nonterminal_count, grammar_length) || !range_valid(grammar[HEADER_LHS_PRODUCTIONS_OFFSET], lhs_production_count, grammar_length)) {
        return false;
    }
    let production_lhs_offset: i32 = grammar[HEADER_PRODUCTION_LHS_OFFSET];
    let rhs_offsets_offset: i32 = grammar[HEADER_RHS_OFFSETS_OFFSET];
    let rhs_lengths_offset: i32 = grammar[HEADER_RHS_LENGTHS_OFFSET];
    let rhs_symbols_offset: i32 = grammar[HEADER_RHS_SYMBOLS_OFFSET];
    let production: i32 = 0;
    while (production <= production_count - 1) {
        let lhs: i32 = grammar[production_lhs_offset + production];
        let rhs_offset: i32 = grammar[rhs_offsets_offset + production];
        let rhs_length: i32 = grammar[rhs_lengths_offset + production];
        if (lhs <= -1 || lhs >= nonterminal_count || rhs_offset <= -1 || rhs_length <= -1 || rhs_offset > rhs_symbol_count || rhs_length > rhs_symbol_count - rhs_offset) {
            return false;
        }
        let rhs_index: i32 = 0;
        while (rhs_index <= rhs_length - 1) {
            let symbol: i32 = grammar[rhs_symbols_offset + rhs_offset + rhs_index];
            if (symbol <= -1 || symbol >= kind_count + nonterminal_count) {
                return false;
            }
            rhs_index += 1;
        }
        production += 1;
    }
    let lhs_offsets_offset: i32 = grammar[HEADER_LHS_OFFSETS_OFFSET];
    let lhs_counts_offset: i32 = grammar[HEADER_LHS_COUNTS_OFFSET];
    let lhs_productions_offset: i32 = grammar[HEADER_LHS_PRODUCTIONS_OFFSET];
    let nonterminal: i32 = 0;
    while (nonterminal <= nonterminal_count - 1) {
        let first: i32 = grammar[lhs_offsets_offset + nonterminal];
        let count: i32 = grammar[lhs_counts_offset + nonterminal];
        if (first <= -1 || count <= -1 || first > lhs_production_count || count > lhs_production_count - first) {
            return false;
        }
        let index: i32 = 0;
        while (index <= count - 1) {
            let listed: i32 = grammar[lhs_productions_offset + first + index];
        if (listed <= -1 || listed >= production_count || grammar[production_lhs_offset + listed] != nonterminal) {
                return false;
            }
            index += 1;
        }
        nonterminal += 1;
    }
    return true;
}
fn state_bucket(position: i32, seed: StateSeed) -> i32 {
    // Reduce before mixing so even large valid grammar/state IDs cannot
    // overflow. Collisions are resolved by comparing the complete state key.
    let key: i32 = seed.production % STATE_BUCKETS
        + (seed.dot % STATE_BUCKETS) * 3
        + (seed.origin % STATE_BUCKETS) * 5;
    return position * STATE_BUCKETS + key % STATE_BUCKETS;
}

fn find_state(workspace: ParserWorkspace, bucket: i32,
    seed: StateSeed) -> i32 {
    let heads: [i32] = workspace.state_heads;
    let states: [State] = workspace.states;
    let current: i32 = heads[bucket];
    while (current >= 0) {
        if (states[current].production == seed.production
            && states[current].dot == seed.dot
            && states[current].origin == seed.origin) {
            return current;
        }
        current = states[current].bucket_next;
    }
    return -1;
}

// Each queue is a stable subsequence of the chart: expecting parents and
// zero-width completions use disjoint buckets. Hash collisions still compare
// the exact action, and appends remain visible to a scan already in progress.
fn action_bucket(position: i32, nonterminal: i32, nullable: bool) -> i32 {
    let bucket: i32 = (nonterminal % (ACTION_BUCKETS / 2)) * 2;
    if (nullable) { bucket += 1; }
    return position * ACTION_BUCKETS + bucket;
}

fn append_state(workspace: ParserWorkspace, grammar: [i32], position: i32,
    seed: StateSeed, state_count: i32) -> AppendResult {
    let bucket: i32 = state_bucket(position, seed);
    let existing: i32 = find_state(workspace, bucket, seed);
    if (existing >= 0) {
        return AppendResult { stage: Appended, state_count: state_count };
    }
    if (state_count >= workspace.state_capacity) {
        return AppendResult { stage: StorageFull, state_count: state_count };
    }
    let charts: [Chart] = workspace.charts;
    let states: [State] = workspace.states;
    let heads: [i32] = workspace.state_heads;
    let state_id: i32 = state_count;
    states[state_id].production = seed.production;
    states[state_id].dot = seed.dot;
    states[state_id].origin = seed.origin;
    states[state_id].position = position;
    states[state_id].next = -1;
    states[state_id].previous = seed.previous_state;
    states[state_id].child = seed.child;
    states[state_id].child_payload = seed.child_payload;
    states[state_id].semantic_kind = seed.semantic_kind;
    let action: StateAction;
    let indexed_nonterminal: i32 = -1;
    let nullable: bool = false;
    if (seed.dot < production_rhs_length(grammar, seed.production)) {
        let symbol: i32 = production_rhs_symbol(grammar, seed.production, seed.dot);
        action = Expect(symbol);
        if (symbol >= grammar[HEADER_KIND_COUNT]) {
            indexed_nonterminal = symbol - grammar[HEADER_KIND_COUNT];
        }
    } else {
        let lhs: i32 = production_lhs(grammar, seed.production);
        action = Complete(lhs);
        if (seed.origin == position) {
            indexed_nonterminal = lhs;
            nullable = true;
        }
    }
    states[state_id].action = action;
    states[state_id].action_next = -1;
    if (indexed_nonterminal >= 0) {
        let slot: i32 = action_bucket(position, indexed_nonterminal, nullable);
        let action_heads: [i32] = workspace.action_heads;
        let action_tails: [i32] = workspace.action_tails;
        let previous_tail: i32 = action_tails[slot];
        if (previous_tail < 0) {
            action_heads[slot] = state_id;
        } else {
            states[previous_tail].action_next = state_id;
        }
        action_tails[slot] = state_id;
    }
    // This reverse link serves lookup only. The separate chart queue below
    // retains insertion order and therefore the first retained derivation.
    states[state_id].bucket_next = heads[bucket];
    heads[bucket] = state_id;
    let tail: i32 = charts[position].tail;
    if (tail <= -1) {
        charts[position].head = state_id;
    } else {
        states[tail].next = state_id;
    }
    charts[position].tail = state_id;
    return AppendResult { stage: Appended, state_count: state_count + 1 };
}
fn production_rhs_length(grammar:[i32], production: i32) -> i32 {
    return grammar[grammar[HEADER_RHS_LENGTHS_OFFSET] + production];
}
fn production_rhs_symbol(grammar:[i32], production: i32, dot: i32) -> i32 {
    let relative: i32 = grammar[grammar[HEADER_RHS_OFFSETS_OFFSET] + production];
    return grammar[grammar[HEADER_RHS_SYMBOLS_OFFSET] + relative + dot];
}
fn production_lhs(grammar:[i32], production: i32) -> i32 {
    return grammar[grammar[HEADER_PRODUCTION_LHS_OFFSET] + production];
}
// Returns the next lattice position, or -1 when the terminal cannot consume
// the physical token. Even positions are token boundaries; odd positions are
// between the two virtual components of one configured split token.
fn scan_terminal(grammar:[i32], tokens:[i32], token_count: i32, position: i32, semantic_kind: i32,) -> i32 {
    let token_index: i32 = position / LATTICE_POSITIONS_PER_TOKEN;
    if (token_index >= token_count) {
        return -1;
    }
    let raw_kind: i32 = tokens[token_index];
    let canonical_kind: i32 = grammar[grammar[HEADER_CANONICAL_KINDS_OFFSET] + semantic_kind];
    if (position % LATTICE_POSITIONS_PER_TOKEN == 1) {
        if (raw_kind == grammar[HEADER_SPLIT_TOKEN_KIND] && canonical_kind == grammar[HEADER_SPLIT_COMPONENT_KIND]) {
            return position + 1;
        }
        return -1;
    }
    if (verified::token::raw_matches_canonical(raw_kind, canonical_kind)) {
        return position + 2;
    }
    if (raw_kind == grammar[HEADER_SPLIT_TOKEN_KIND] && canonical_kind == grammar[HEADER_SPLIT_COMPONENT_KIND]) {
        return position + 1;
    }
    return -1;
}
fn append_or_full(appended: AppendResult, error_position: i32,) -> ParseResult {
    return parse_result(StateStorageFull, appended.state_count, -1, error_position,);
}
// Recognizes one token stream. Grammar symbols encode terminals as
// [0, kind_count) and nonterminals as kind_count + nonterminal. The workspace
// requires a chart and bucket heads per lattice position, plus one typed
// record per available Earley state, all in the caller-owned allocation.
pub fn recognize(grammar:[i32], grammar_length: i32, tokens:[i32],
    token_count: i32, workspace: WorkspaceStorage) -> ParseResult {
    let workspace_length: i32 = workspace.words;
    if (!grammar_is_valid(grammar, grammar_length)) {
        return parse_result(InvalidGrammar, 0, -1, 0);
    }
    // The chart prefix for every physical-token lattice position must remain a
    // nonnegative i32 before it is compared with the caller's workspace.
    if (token_count <= -1 || token_count > MAX_TOKEN_COUNT
        || workspace.memory == 0
        || workspace_length <= -1
        || workspace_length > verified::host::I32_MAX
            / verified::host::I32_BYTES) {
        return parse_result(InvalidInput, 0, -1, 0);
    }
    let final_position: i32 = token_count * LATTICE_POSITIONS_PER_TOKEN;
    let chart_count: i32 = final_position + 1;
    if (chart_count > workspace_length / CHART_STORAGE_WORDS) {
        return parse_result(StateStorageFull, 0, -1, 0);
    }
    let chart_words: i32 = chart_count * CHART_STORAGE_WORDS;
    let state_capacity: i32 = (workspace_length - chart_words)
        / STATE_RECORD_WORDS;
    let work: ParserWorkspace = workspace_view(workspace, chart_count,
        state_capacity);
    let charts: [Chart] = work.charts;
    let states: [State] = work.states;
    let heads: [i32] = work.state_heads;
    let action_heads: [i32] = work.action_heads;
    let action_tails: [i32] = work.action_tails;
    let chart: i32 = 0;
    while (chart < chart_count) {
        charts[chart].head = -1;
        charts[chart].tail = -1;
        let bucket: i32 = 0;
        while (bucket < STATE_BUCKETS) {
            heads[chart * STATE_BUCKETS + bucket] = -1;
            bucket += 1;
        }
        bucket = 0;
        while (bucket < ACTION_BUCKETS) {
            action_heads[chart * ACTION_BUCKETS + bucket] = -1;
            action_tails[chart * ACTION_BUCKETS + bucket] = -1;
            bucket += 1;
        }
        chart += 1;
    }
    let kind_count: i32 = grammar[HEADER_KIND_COUNT];
    let start_nonterminal: i32 = grammar[HEADER_START_NONTERMINAL];
    let lhs_offsets_offset: i32 = grammar[HEADER_LHS_OFFSETS_OFFSET];
    let lhs_counts_offset: i32 = grammar[HEADER_LHS_COUNTS_OFFSET];
    let lhs_productions_offset: i32 = grammar[HEADER_LHS_PRODUCTIONS_OFFSET];
    let start_first: i32 = grammar[lhs_offsets_offset + start_nonterminal];
    let start_count: i32 = grammar[lhs_counts_offset + start_nonterminal];
    let state_count: i32 = 0;
    let start_index: i32 = 0;
    while (start_index <= start_count - 1) {
        let production: i32 = grammar[lhs_productions_offset + start_first + start_index];
        let appended: AppendResult = append_state(work, grammar, 0,
            state_seed(production, 0, 0, -1, NoChild, -1, -1), state_count);
        if (append_storage_full(appended)) {
            return append_or_full(appended, 0);
        }
        state_count = appended.state_count;
        start_index += 1;
    }
    let furthest_position: i32 = 0;
    let position: i32 = 0;
    while (position <= final_position) {
        if (charts[position].head >= 0) {
            furthest_position = position;
        }
        let state_id: i32 = charts[position].head;
        while (state_id >= 0) {
            let production: i32 = states[state_id].production;
            let dot: i32 = states[state_id].dot;
            let origin: i32 = states[state_id].origin;
            let symbol: i32 = match (states[state_id].action) {
                Expect(value) -> value,
                _ -> -1,
            };
            if (symbol >= 0) {
                if (symbol <= kind_count - 1) {
                    let next_position: i32 = scan_terminal(grammar, tokens, token_count, position, symbol);
                    if (next_position >= 0) {
                        let appended: AppendResult = append_state(work, grammar,
                            next_position, state_seed(production, dot + 1,
                                origin, state_id, TokenChild,
                                position / LATTICE_POSITIONS_PER_TOKEN,
                                symbol), state_count);
                        if (append_storage_full(appended)) {
                            return append_or_full(appended, position);
                        }
                        state_count = appended.state_count;
                    }
                } else {
                    let expected_nonterminal: i32 = symbol - kind_count;
                    let first: i32 = grammar[lhs_offsets_offset + expected_nonterminal];
                    let count: i32 = grammar[lhs_counts_offset + expected_nonterminal];
                    let predicted_index: i32 = 0;
                    while (predicted_index <= count - 1) {
                        let predicted: i32 = grammar[lhs_productions_offset + first + predicted_index];
                        let appended: AppendResult = append_state(work, grammar,
                            position, state_seed(predicted, 0, position, -1,
                                NoChild, -1, -1), state_count);
                        if (append_storage_full(appended)) {
                            return append_or_full(appended, position);
                        }
                        state_count = appended.state_count;
                        predicted_index += 1;
                    }
                    // A nullable completion may predate this parent state, so
                    // replay already-completed zero-width children here.
                    let candidate: i32 = action_heads[
                        action_bucket(position, expected_nonterminal, true)];
                    while (candidate >= 0) {
                        let candidate_origin: i32 = states[candidate].origin;
                        let candidate_matches: bool = match (states[candidate].action) {
                            Complete(candidate_lhs) -> candidate_lhs == expected_nonterminal,
                            _ -> false,
                        };
                        if (candidate_origin == position && candidate_matches) {
                            let appended: AppendResult = append_state(work, grammar,
                                position, state_seed(production, dot + 1,
                                    origin, state_id, StateChild, candidate,
                                    -1), state_count);
                            if (append_storage_full(appended)) {
                                return append_or_full(appended, position);
                            }
                            state_count = appended.state_count;
                        }
                        candidate = states[candidate].action_next;
                    }
                }
            } else {
                let completed_lhs: i32 = match (states[state_id].action) {
                    Complete(current_lhs) -> current_lhs,
                    _ -> -1,
                };
                let parent: i32 = action_heads[
                    action_bucket(origin, completed_lhs, false)];
                while (parent >= 0) {
                    let parent_matches: bool = match (states[parent].action) {
                        Expect(expected) -> expected == kind_count + completed_lhs,
                        _ -> false,
                    };
                    if (parent_matches) {
                        let parent_production: i32 = states[parent].production;
                        let parent_dot: i32 = states[parent].dot;
                        let parent_origin: i32 = states[parent].origin;
                        let appended: AppendResult = append_state(work, grammar,
                            position, state_seed(parent_production,
                                parent_dot + 1, parent_origin, parent,
                                StateChild, state_id, -1), state_count);
                        if (append_storage_full(appended)) {
                            return append_or_full(appended, position);
                        }
                        state_count = appended.state_count;
                    }
                    parent = states[parent].action_next;
                }
            }
            // Read after processing: appending to the current chart can update
            // this state's next link, and those new states must be processed.
            state_id = states[state_id].next;
        }
        position += 1;
    }
    let root_state: i32 = charts[final_position].head;
    while (root_state >= 0) {
        let production: i32 = states[root_state].production;
        if (states[root_state].origin == 0
            && production_lhs(grammar, production) == start_nonterminal
            && states[root_state].dot
                == production_rhs_length(grammar, production)) {
            return parse_result(Parsed, state_count, root_state, 0);
        }
        root_state = states[root_state].next;
    }
    return parse_result(Rejected, state_count, -1, furthest_position);
}

// Copies a retained derivation without recognizing the token stream again.
// The caller supplies the unchanged workspace of a successful recognition.
// Header: production, origin, end position, child count. Each child occupies
// three words: tag, token/state payload, semantic token kind (-1 for a state).
// Records start at output_offset. Children are written in grammar order.
// Returns child count, -1 for invalid metadata, or -2 for insufficient output.
// Output is unspecified on failure. Slice lengths must match their storage,
// as for recognize. This is a derivation reader, not a grammar validator.
pub fn copy_derivation(input: DerivationInput,
    destination: DerivationOutput) -> i32 {
    let token_count: i32 = input.token_count;
    let state_count: i32 = input.state_count;
    let state_id: i32 = input.state_id;
    let output: [i32] = destination.data;
    let output_length: i32 = destination.capacity;
    let output_offset: i32 = destination.offset;
    if (!derivation_view_valid(input)) { return -1; }
    let states: [State] = derivation_states(input);
    let count: i32 = states[state_id].dot;
    if (count <= -1 || !(count <= state_count)) {
        return -1;
    }
    if (output_offset <= -1 || !(output_offset <= output_length)) { return -2; }
    if (output_length - output_offset <= DERIVATION_HEADER_WORDS - 1
        || !(count <= (output_length - output_offset
                - DERIVATION_HEADER_WORDS) / DERIVATION_CHILD_WORDS)) {
        return -2;
    }
    let production: i32 = states[state_id].production;
    let origin: i32 = states[state_id].origin;
    output[output_offset + DERIVATION_PRODUCTION_FIELD] = production;
    output[output_offset + DERIVATION_ORIGIN_FIELD] = origin;
    output[output_offset + DERIVATION_END_FIELD] = states[state_id].position;
    output[output_offset + DERIVATION_CHILD_COUNT_FIELD] = count;
    let current: i32 = state_id;
    let remaining: i32 = count;
    while (remaining != 0) {
        if (states[current].dot != remaining
            || states[current].production != production
            || states[current].origin != origin) {
            return -1;
        }
        let previous: i32 = states[current].previous;
        let tag: i32 = child_code(states[current].child);
        let payload: i32 = states[current].child_payload;
        if (previous <= -1 || previous >= current || payload <= -1) {
            return -1;
        }
        if (encoded_child_is(tag, TokenChild)) {
            if (payload >= token_count) { return -1; }
        } else {
            if (!encoded_child_is(tag, StateChild) || payload >= current) { return -1; }
        }
        let slot: i32 = output_offset + DERIVATION_HEADER_WORDS
            + (remaining - 1) * DERIVATION_CHILD_WORDS;
        output[slot + DERIVATION_CHILD_TAG_FIELD] = tag;
        output[slot + DERIVATION_CHILD_PAYLOAD_FIELD] = payload;
        output[slot + DERIVATION_CHILD_KIND_FIELD] =
            states[current].semantic_kind;
        current = previous;
        remaining -= 1;
    }
    if (states[current].dot != 0
        || states[current].production != production
        || states[current].origin != origin
        || !encoded_child_is(child_code(states[current].child), NoChild)
        || states[current].previous != -1) {
        return -1;
    }
    return count;
}
