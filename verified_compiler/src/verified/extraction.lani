module verified::extraction;

import verified::raw_lexer;
import verified::canonical_tokens;
import verified::parser;
import verified::token;

// Canonical in-memory capacities shared by the native frontend entrypoints.
// Source bytes are stored one byte per i32 slot; token rows and parse records
// use word counts. This module owns the profile consumed by compiler,
// extractor, semantic collection, and aggregate lowering.
pub const SOURCE_BYTE_CAPACITY: i32 = 65536;
pub const TOKEN_KIND_CAPACITY: i32 = 65536;
pub const PARSER_WORK_WORD_CAPACITY: i32 = 16777216;
pub const PARSE_RECORD_WORD_CAPACITY: i32 = 1048576;
pub const PARSE_NODE_CAPACITY: i32 = 131072;
pub const DEFAULT_PARSE_DEPTH_LIMIT: i32 = 1024;

pub enum ExtractionStage {
    Recognized,
    InvalidInput,
    LexingFailed,
    TokenStorageFull,
    ParsingFailed,
}

pub struct SyntaxRecognition {
    stage: ExtractionStage,
    detail: i32,
    raw_count: i32,
    token_count: i32,
    error_position: i32,
    state_count: i32,
    root_state: i32,
}

pub fn recognition_succeeded(value: SyntaxRecognition) -> bool {
    return value.stage == Recognized;
}

pub fn recognition_has_stage(value: SyntaxRecognition,
    stage: ExtractionStage) -> bool {
    return value.stage == stage;
}

pub fn recognition_detail(value: SyntaxRecognition) -> i32 {
    return value.detail;
}

pub fn recognition_raw_count(value: SyntaxRecognition) -> i32 {
    return value.raw_count;
}

pub fn recognition_error_position(value: SyntaxRecognition) -> i32 {
    return value.error_position;
}

pub fn recognition_token_count(value: SyntaxRecognition) -> i32 {
    return value.token_count;
}

pub fn recognition_parse(value: SyntaxRecognition)
    -> verified::parser::ParseResult {
    return verified::parser::ParseResult {
        stage: verified::parser::Parsed,
        state_count: value.state_count,
        root_state: value.root_state,
        error_position: 0,
    };
}

fn recognition_result(stage: ExtractionStage, detail: i32,
    raw_count: i32, token_count: i32, error_position: i32,
    parse: verified::parser::ParseResult) -> SyntaxRecognition {
    return SyntaxRecognition {
        stage: stage, detail: detail, raw_count: raw_count,
        token_count: token_count, error_position: error_position,
        state_count: verified::parser::parse_state_count(parse),
        root_state: verified::parser::parse_root_state(parse),
    };
}

fn empty_parse() -> verified::parser::ParseResult {
    return verified::parser::ParseResult {
        stage: verified::parser::InvalidInput,
        state_count: 0, root_state: -1, error_position: 0,
    };
}

pub struct WordBuffer {
    data: [i32],
    length: i32,
}

pub fn buffer(data: [i32], length: i32) -> WordBuffer {
    return WordBuffer { data: data, length: length };
}

pub struct SyntaxInput {
    source: WordBuffer,
    grammar: WordBuffer,
}

pub struct NativeRecognitionWorkspace {
    tokens: verified::token::TokenTable,
    raw_tokens: WordBuffer,
    canonical_tokens: WordBuffer,
    token_kinds: WordBuffer,
    parser_workspace: verified::parser::WorkspaceStorage,
}

fn parse_recognized(grammar: [i32], grammar_length: i32,
    kinds: [i32], workspace: verified::parser::WorkspaceStorage,
    raw_count: i32, token_count: i32) -> SyntaxRecognition {
    let parsed: verified::parser::ParseResult =
        verified::parser::recognize(grammar, grammar_length, kinds,
            token_count, workspace);
    if (!verified::parser::parse_succeeded(parsed)) {
        return recognition_result(ParsingFailed,
            verified::parser::parse_stage_code(parsed), raw_count,
            token_count, verified::parser::parse_error_position(parsed),
            parsed);
    }
    return recognition_result(Recognized, 0, raw_count, token_count, 0,
        parsed);
}

// All modes keep token rows native; optional artifact buffers are serialized
// from those rows before compaction overwrites the raw stream.
pub fn recognize_native_syntax(input: SyntaxInput,
    buffers: NativeRecognitionWorkspace) -> SyntaxRecognition {
    let source: [i32] = input.source.data;
    let source_length: i32 = input.source.length;
    let grammar: [i32] = input.grammar.data;
    let grammar_length: i32 = input.grammar.length;
    let tokens: verified::token::TokenTable = buffers.tokens;
    let raw: WordBuffer = buffers.raw_tokens;
    let canonical: WordBuffer = buffers.canonical_tokens;
    let kinds: [i32] = buffers.token_kinds.data;
    let kinds_length: i32 = buffers.token_kinds.length;
    let workspace: verified::parser::WorkspaceStorage =
        buffers.parser_workspace;
    let no_parse: verified::parser::ParseResult = empty_parse();
    if (source_length <= -1) {
        return recognition_result(InvalidInput, 1, 0, 0, 0, no_parse);
    }
    if (grammar_length <= -1) {
        return recognition_result(InvalidInput, 2, 0, 0, 0, no_parse);
    }
    if (tokens.count <= -1) {
        return recognition_result(InvalidInput, 3, 0, 0, 0, no_parse);
    }
    if (raw.length <= -1 || canonical.length <= -1
        || (raw.length == 0 && canonical.length != 0)
        || (raw.length != 0 && canonical.length == 0)) {
        return recognition_result(InvalidInput, 4, 0, 0, 0, no_parse);
    }
    if (kinds_length <= -1) {
        return recognition_result(InvalidInput, 5, 0, 0, 0, no_parse);
    }
    if (workspace.words <= -1) {
        return recognition_result(InvalidInput, 6, 0, 0, 0, no_parse);
    }
    let lexed: verified::raw_lexer::LexResult =
        verified::raw_lexer::lex_into_rows(source, source_length, tokens);
    let raw_count: i32 = verified::raw_lexer::lex_token_count(lexed);
    if (!verified::raw_lexer::lex_succeeded(lexed)) {
        return recognition_result(LexingFailed,
            verified::raw_lexer::lex_stage_code(lexed), raw_count, 0,
            verified::raw_lexer::lex_error_offset(lexed), no_parse);
    }
    if (raw.length > 0 && !verified::token::encode_packed(tokens,
            raw_count, raw.data, raw.length)) {
        return recognition_result(TokenStorageFull, 0, raw_count, 0, 0,
            no_parse);
    }
    let token_count: i32 =
        verified::canonical_tokens::canonicalize_rows_in_place(source,
            tokens, raw_count);
    if (canonical.length > 0 && !verified::token::encode_packed(
            tokens, token_count, canonical.data, canonical.length)) {
        return recognition_result(TokenStorageFull, 1, raw_count,
            token_count, 0, no_parse);
    }
    if (token_count > kinds_length) {
        return recognition_result(TokenStorageFull, 1, raw_count,
            token_count, 0, no_parse);
    }
    let rows: [verified::token::TokenRow] = tokens.data;
    let token: i32 = 0;
    while (token < token_count) {
        kinds[token] = verified::token::kind_code(rows[token].kind);
        token += 1;
    }
    return parse_recognized(grammar, grammar_length, kinds, workspace,
        raw_count, token_count);
}
