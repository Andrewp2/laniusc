module verified::extraction;

import verified::raw_lexer;
import verified::canonical_tokens;
import verified::parser;
import verified::parse_tree;
import verified::token;

// Canonical in-memory capacities shared by the native frontend entrypoints.
// Source bytes are stored one byte per i32 slot; token rows and parse records
// use word counts. This module owns the profile consumed by compiler,
// extractor, semantic collection, and aggregate lowering.
pub const SOURCE_BYTE_CAPACITY: i32 = 65536;
pub const TOKEN_KIND_CAPACITY: i32 = 65536;
pub const PARSER_WORK_WORD_CAPACITY: i32 = 16777216;
pub const PARSE_RECORD_WORD_CAPACITY: i32 = 1048576;
pub const PARSE_NODE_CAPACITY: i32 = 131072;
pub const DEFAULT_PARSE_DEPTH_LIMIT: i32 = 1024;

pub enum ExtractionStage {
    Extracted,
    InvalidInput,
    LexingFailed,
    TokenStorageFull,
    ParsingFailed,
    TreeMaterializationFailed,
}

pub fn stage_code(stage: ExtractionStage) -> i32 {
    return match (stage) {
        Extracted -> 0,
        InvalidInput -> 1,
        LexingFailed -> 2,
        TokenStorageFull -> 3,
        ParsingFailed -> 4,
        TreeMaterializationFailed -> 5,
    };
}

pub struct SyntaxResult {
    stage: ExtractionStage,
    detail: i32,
    raw_count: i32,
    token_count: i32,
    node_count: i32,
    tree_words: i32,
    error_position: i32,
}

pub struct WordBuffer {
    data: [i32],
    length: i32,
}

pub fn buffer(data: [i32], length: i32) -> WordBuffer {
    return WordBuffer { data: data, length: length };
}

pub struct SyntaxInput {
    source: WordBuffer,
    grammar: WordBuffer,
}

pub struct SyntaxWorkspace {
    raw_tokens: WordBuffer,
    canonical_tokens: WordBuffer,
    token_kinds: WordBuffer,
    parser_workspace: verified::parser::WorkspaceStorage,
    parse_records: WordBuffer,
    node_offsets: WordBuffer,
    depth_limit: i32,
}
pub fn extraction_stage_code(value: SyntaxResult) -> i32 { return stage_code(value.stage); }
pub fn extraction_has_stage(value: SyntaxResult,
    expected: ExtractionStage) -> bool {
    return stage_code(value.stage) == stage_code(expected);
}
pub fn extraction_detail(value: SyntaxResult) -> i32 { return value.detail; }
pub fn raw_count(value: SyntaxResult) -> i32 { return value.raw_count; }
pub fn token_count(value: SyntaxResult) -> i32 { return value.token_count; }
pub fn node_count(value: SyntaxResult) -> i32 { return value.node_count; }
pub fn tree_words(value: SyntaxResult) -> i32 { return value.tree_words; }
pub fn error_position(value: SyntaxResult) -> i32 { return value.error_position; }
fn result(stage: ExtractionStage, detail: i32, raw: i32, tokens: i32,
    nodes: i32, words: i32, position: i32,) -> SyntaxResult {
    return SyntaxResult { stage: stage, detail: detail, raw_count: raw,
        token_count: tokens, node_count: nodes, tree_words: words, error_position: position };
}

// Extract syntax evidence using only the Lanius frontend. All lengths below
// are in i32 words except source_length, which counts source bytes held in
// i32 slots. Buffers must be disjoint and lengths must match actual storage.
// Preserve raw rows; canonicalization compacts a separate copy. Tree records
// retain per-terminal semantic kinds, including virtual split-token uses.
// Only Extracted authorizes consuming the full output as a certificate.
// This stage does not yet reconstruct Surface syntax or lower to Core.
pub fn extract_syntax(input: SyntaxInput,
    buffers: SyntaxWorkspace) -> SyntaxResult {
    let source: [i32] = input.source.data;
    let source_length: i32 = input.source.length;
    let grammar: [i32] = input.grammar.data;
    let grammar_length: i32 = input.grammar.length;
    let raw: [i32] = buffers.raw_tokens.data;
    let raw_length: i32 = buffers.raw_tokens.length;
    let canonical: [i32] = buffers.canonical_tokens.data;
    let canonical_length: i32 = buffers.canonical_tokens.length;
    let kinds: [i32] = buffers.token_kinds.data;
    let kinds_length: i32 = buffers.token_kinds.length;
    let workspace: verified::parser::WorkspaceStorage =
        buffers.parser_workspace;
    let workspace_length: i32 = workspace.words;
    let records: [i32] = buffers.parse_records.data;
    let records_length: i32 = buffers.parse_records.length;
    let offsets: [i32] = buffers.node_offsets.data;
    let offsets_length: i32 = buffers.node_offsets.length;
    let depth_limit: i32 = buffers.depth_limit;
    if (source_length <= -1) {
        return result(InvalidInput, 1, 0, 0, 0, 0, 0);
    }
    if (grammar_length <= -1) {
        return result(InvalidInput, 2, 0, 0, 0, 0, 0);
    }
    if (raw_length <= -1) {
        return result(InvalidInput, 3, 0, 0, 0, 0, 0);
    }
    if (canonical_length <= -1) {
        return result(InvalidInput, 4, 0, 0, 0, 0, 0);
    }
    if (kinds_length <= -1) {
        return result(InvalidInput, 5, 0, 0, 0, 0, 0);
    }
    if (workspace_length <= -1) {
        return result(InvalidInput, 6, 0, 0, 0, 0, 0);
    }
    if (records_length <= -1) {
        return result(InvalidInput, 7, 0, 0, 0, 0, 0);
    }
    if (offsets_length <= -1) {
        return result(InvalidInput, 8, 0, 0, 0, 0, 0);
    }
    let lexed = verified::raw_lexer::lex_into(source, source_length, raw,
        raw_length / verified::token::ROW_WORDS);
    let raw_count: i32 = verified::raw_lexer::lex_token_count(lexed);
    if (!verified::raw_lexer::lex_succeeded(lexed)) {
        return result(LexingFailed, verified::raw_lexer::lex_stage_code(lexed), raw_count,
            0, 0, 0, verified::raw_lexer::lex_error_offset(lexed));
    }
    if (!(raw_count <= canonical_length / verified::token::ROW_WORDS)) {
        return result(TokenStorageFull, 0, raw_count, 0, 0, 0, 0);
    }
    let word: i32 = 0;
    while (word != raw_count * verified::token::ROW_WORDS) {
        canonical[word] = raw[word];
        word += 1;
    }
    let token_count: i32 = verified::canonical_tokens::canonicalize_in_place(source, canonical, raw_count);
    if (!(token_count <= kinds_length)) {
        return result(TokenStorageFull, 1, raw_count, token_count, 0, 0, 0);
    }
    let token: i32 = 0;
    while (token != token_count) {
        kinds[token] = canonical[token * verified::token::ROW_WORDS
            + verified::token::KIND_FIELD];
        token += 1;
    }
    let parsed = verified::parser::recognize(grammar, grammar_length, kinds,
        token_count, workspace);
    if (!verified::parser::parse_succeeded(parsed)) {
        return result(ParsingFailed, verified::parser::parse_stage_code(parsed), raw_count,
            token_count, 0, 0, verified::parser::parse_error_position(parsed));
    }
    let tree = verified::parse_tree::materialize(
        parsed, verified::parse_tree::input(workspace, token_count,
            depth_limit),
        verified::parse_tree::storage(records, records_length, offsets,
            offsets_length));
    let stage: ExtractionStage = Extracted;
    if (!verified::parse_tree::tree_succeeded(tree)) {
        stage = TreeMaterializationFailed;
    }
    return result(stage, verified::parse_tree::tree_stage_code(tree), raw_count, token_count,
        verified::parse_tree::tree_node_count(tree), verified::parse_tree::tree_words_used(tree), 0);
}
