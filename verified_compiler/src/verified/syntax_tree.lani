module verified::syntax_tree;

import verified::host;
import verified::parser;

// Native compiler view of a parser derivation. All modes build this tree
// directly from typed parser states; artifact records are serialized only
// when an output format requests them.
const FIELD_BYTES: i32 = 8;
pub const NODE_BYTES: i32 = 5 * FIELD_BYTES;
pub const CHILD_BYTES: i32 = 3 * FIELD_BYTES;
pub const TREE_BYTES: i32 = 6 * FIELD_BYTES;
pub const ALIGNMENT: i32 = FIELD_BYTES;

pub struct Node {
    production: i32,
    origin: i32,
    end: i32,
    first_child: i32,
    child_count: i32,
}

pub struct Child {
    kind: verified::parser::ChildKind,
    payload: i32,
    semantic_kind: i32,
}

pub struct Tree {
    nodes: [Node],
    children: [Child],
    node_count: i32,
    child_count: i32,
}

pub struct Catalog {
    data: [Tree],
    count: i32,
}

pub fn catalog_from_raw_parts(memory: ptr, count: i32) -> Catalog {
    let first: ptr = memory;
    if (count > 0) { first = memory + count * TREE_BYTES - FIELD_BYTES; }
    return Catalog { data: slice_from_raw_parts(first, count), count: count };
}

pub fn empty() -> Tree {
    let zero: ptr = 0;
    return Tree {
        nodes: slice_from_raw_parts(zero, 0),
        children: slice_from_raw_parts(zero, 0),
        node_count: 0,
        child_count: 0,
    };
}

fn node_view(memory: ptr, count: i32) -> [Node] {
    let first: ptr = memory;
    if (count > 0) { first = memory + count * NODE_BYTES - FIELD_BYTES; }
    return slice_from_raw_parts(first, count);
}

fn child_view(memory: ptr, count: i32) -> [Child] {
    let first: ptr = memory;
    if (count > 0) { first = memory + count * CHILD_BYTES - FIELD_BYTES; }
    return slice_from_raw_parts(first, count);
}

struct NativeShape {
    valid: bool,
    nodes: i32,
    children: i32,
    record_words: i32,
}

fn measure_derivation(reader: verified::parser::DerivationReader,
    state_id: i32, depth: i32,
    node_limit: i32, record_limit: i32,
    previous: NativeShape) -> NativeShape {
    let result: NativeShape = previous;
    if (!previous.valid || depth <= 0 || previous.nodes >= node_limit) {
        result.valid = false;
        return result;
    }
    let header: verified::parser::DerivationHeader =
        verified::parser::read_derivation_header(reader, state_id);
    if (!header.valid || previous.record_words > record_limit
        - verified::parser::DERIVATION_HEADER_WORDS
        || header.child_count >
        (record_limit - previous.record_words
            - verified::parser::DERIVATION_HEADER_WORDS)
            / verified::parser::DERIVATION_CHILD_WORDS) {
        result.valid = false;
        return result;
    }
    result.record_words += verified::parser::DERIVATION_HEADER_WORDS
        + header.child_count * verified::parser::DERIVATION_CHILD_WORDS;
    result.children += header.child_count;
    let child: i32 = 0;
    while (child < header.child_count) {
        let selected: verified::parser::DerivationChild =
            verified::parser::read_derivation_child(reader, state_id, child);
        if (!selected.valid) {
            result.valid = false;
            return result;
        }
        if (selected.kind == verified::parser::StateChild) {
            result = measure_derivation(reader, selected.payload,
                depth - 1, node_limit,
                record_limit, result);
            if (!result.valid) { return result; }
        }
        child += 1;
    }
    if (result.nodes >= node_limit) { result.valid = false; return result; }
    result.nodes += 1;
    return result;
}

struct NativeCursor {
    valid: bool,
    nodes: i32,
    children: i32,
}

fn write_derivation(reader: verified::parser::DerivationReader,
    state_id: i32, depth: i32,
    output: Tree, previous: NativeCursor) -> NativeCursor {
    let result: NativeCursor = previous;
    if (!previous.valid || depth <= 0) { result.valid = false; return result; }
    let header: verified::parser::DerivationHeader =
        verified::parser::read_derivation_header(reader, state_id);
    if (!header.valid || previous.children > output.child_count
        || header.child_count > output.child_count - previous.children) {
        result.valid = false;
        return result;
    }
    let first_child: i32 = previous.children;
    result.children += header.child_count;
    let children: [Child] = output.children;
    let child: i32 = 0;
    while (child < header.child_count) {
        let selected: verified::parser::DerivationChild =
            verified::parser::read_derivation_child(reader, state_id, child);
        if (!selected.valid) { result.valid = false; return result; }
        let payload: i32 = selected.payload;
        if (selected.kind == verified::parser::StateChild) {
            result = write_derivation(reader, selected.payload,
                depth - 1, output, result);
            if (!result.valid) { return result; }
            payload = result.nodes - 1;
        }
        children[first_child + child] = Child {
            kind: selected.kind, payload: payload,
            semantic_kind: selected.semantic_kind,
        };
        child += 1;
    }
    if (result.nodes >= output.node_count) {
        result.valid = false;
        return result;
    }
    let nodes: [Node] = output.nodes;
    nodes[result.nodes] = Node {
        production: header.production, origin: header.origin,
        end: header.end, first_child: first_child,
        child_count: header.child_count,
    };
    result.nodes += 1;
    return result;
}

// Binary compilation materializes the typed syntax tree directly from the
// recognizer workspace. It observes the same depth, node and packed-record
// budgets as certificate materialization, but never builds packed records.
pub fn materialize_native(parsed: verified::parser::ParseResult,
    workspace: verified::parser::WorkspaceStorage, token_count: i32,
    depth_limit: i32, node_limit: i32, record_limit: i32) -> Tree {
    let invalid: Tree = empty();
    if (!verified::parser::parse_succeeded(parsed)
        || node_limit <= 0 || record_limit <= 0
        || node_limit > verified::host::I32_MAX / NODE_BYTES) {
        return invalid;
    }
    let derivation: verified::parser::DerivationInput =
        verified::parser::DerivationInput {
            workspace: workspace, token_count: token_count,
            state_count: verified::parser::parse_state_count(parsed),
            state_id: verified::parser::parse_root_state(parsed),
        };
    let reader: verified::parser::DerivationReader =
        verified::parser::derivation_reader(derivation);
    let shape: NativeShape = measure_derivation(reader,
        verified::parser::parse_root_state(parsed), depth_limit,
        node_limit, record_limit,
        NativeShape { valid: true, nodes: 0, children: 0,
            record_words: 0 });
    if (!shape.valid || shape.nodes <= 0
        || shape.children > verified::host::I32_MAX / CHILD_BYTES) {
        return invalid;
    }
    let node_memory: ptr = verified::host::alloc(
        shape.nodes * NODE_BYTES, ALIGNMENT);
    let child_bytes: i32 = CHILD_BYTES;
    if (shape.children > 0) { child_bytes = shape.children * CHILD_BYTES; }
    let child_memory: ptr = verified::host::alloc(child_bytes, ALIGNMENT);
    if (node_memory == 0 || child_memory == 0) { return invalid; }
    let output: Tree = Tree {
        nodes: node_view(node_memory, shape.nodes),
        children: child_view(child_memory, shape.children),
        node_count: shape.nodes, child_count: shape.children,
    };
    let written: NativeCursor = write_derivation(reader,
        verified::parser::parse_root_state(parsed), depth_limit, output,
        NativeCursor { valid: true, nodes: 0, children: 0 });
    if (!written.valid || written.nodes != shape.nodes
        || written.children != shape.children) { return invalid; }
    return output;
}

pub fn production(tree: Tree, node: i32) -> i32 {
    if (node <= -1 || node >= tree.node_count) { return -1; }
    let nodes: [Node] = tree.nodes;
    return nodes[node].production;
}

pub fn child_count(tree: Tree, node: i32) -> i32 {
    if (node <= -1 || node >= tree.node_count) { return -1; }
    let nodes: [Node] = tree.nodes;
    return nodes[node].child_count;
}

pub fn child(tree: Tree, node: i32, index: i32,
    expected: verified::parser::ChildKind) -> i32 {
    if (node <= -1 || node >= tree.node_count || index <= -1) {
        return -1;
    }
    let nodes: [Node] = tree.nodes;
    let record: Node = nodes[node];
    if (index >= record.child_count) { return -1; }
    let children: [Child] = tree.children;
    let selected: Child = children[record.first_child + index];
    if (verified::parser::child_code(selected.kind)
        != verified::parser::child_code(expected)) { return -1; }
    return selected.payload;
}
