module verified::parse_output;

import verified::output;
import verified::parser;

// Emit a Lean expression of type List Lanius.Extraction.ParseNode.
// The record format comes from parse_tree.materialize. Node references are
// dense postorder IDs; offsets identify their possibly noncontiguous records.
// Grammar production numbers have exactly the packed grammar's meaning.
// Return next byte offset or -1; never use partial output after failure.
pub fn emit_nodes(grammar:[i32], grammar_length: i32, records:[i32],
    records_length: i32, offsets:[i32], node_count: i32, token_count: i32,
    output:[i32], capacity: i32, position: i32,) -> i32 {
    if (grammar_length <= 16 || node_count <= -1 || token_count <= -1) { return -1; }
    let lhs: i32 = grammar[8];
    let production_count: i32 = grammar[2];
    if (lhs <= -1 || !(lhs <= grammar_length) || production_count <= -1
        || !(production_count <= grammar_length - lhs)) { return -1; }
    let open_tuple: [i32; 3] = [226, 159, 168];
    let close_tuple: [i32; 3] = [226, 159, 169];
    let token_name: [i32; 7] = [46, 116, 111, 107, 101, 110, 32];
    let node_name: [i32; 6] = [46, 110, 111, 100, 101, 32];
    let next: i32 = verified::output::byte(output, capacity, position, 91);
    let node: i32 = 0;
    while (node != node_count) {
        let record: i32 = offsets[node];
        if (record <= -1 || !(record <= records_length)
            || records_length - record <= 3) { return -1; }
        let production: i32 = records[record];
        let children: i32 = records[record + 3];
        if (production <= -1 || production >= production_count || children <= -1
            || !(children <= (records_length - record - 4) / 3)) { return -1; }
        if (node != 0) { next = verified::output::byte(output, capacity, next, 44); }
        next = verified::output::bytes(output, capacity, next, open_tuple, 3);
        next = verified::output::natural(output, capacity, next, production);
        next = verified::output::byte(output, capacity, next, 44);
        next = verified::output::natural(output, capacity, next, grammar[lhs + production]);
        next = verified::output::byte(output, capacity, next, 44);
        next = verified::output::natural(output, capacity, next, records[record + 1]);
        next = verified::output::byte(output, capacity, next, 44);
        next = verified::output::natural(output, capacity, next, records[record + 2]);
        next = verified::output::byte(output, capacity, next, 44);
        next = verified::output::byte(output, capacity, next, 91);
        let child: i32 = 0;
        while (child != children) {
            let slot: i32 = record + 4 + child * 3;
            let tag: i32 = records[slot];
            let payload: i32 = records[slot + 1];
            if (payload <= -1) { return -1; }
            if (child != 0) { next = verified::output::byte(output, capacity, next, 44); }
            if (tag == verified::parser::CHILD_TOKEN) {
                if (payload >= token_count) { return -1; }
                next = verified::output::bytes(output, capacity, next, token_name, 7);
            } else {
                if (tag != verified::parser::CHILD_STATE || payload >= node) { return -1; }
                next = verified::output::bytes(output, capacity, next, node_name, 6);
            }
            next = verified::output::natural(output, capacity, next, payload);
            if (next == -1) { return -1; }
            child += 1;
        }
        next = verified::output::byte(output, capacity, next, 93);
        next = verified::output::bytes(output, capacity, next, close_tuple, 3);
        if (next == -1) { return -1; }
        node += 1;
    }
    return verified::output::byte(output, capacity, next, 93);
}
