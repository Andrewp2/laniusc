module verified::lean_syntax;

import ir::type_catalog;
import ir::type_ref;
import ir::symbol_catalog;
import runtime::service;
import verified::ascii;
import verified::lean_output;
import verified::host;
import verified::utf8;


// Small, checked Lean-syntax atoms. The caller owns a packed-byte output
// buffer; every writer returns its next byte offset or -1. No Core transport
// words are constructed or interpreted here.
pub fn signed(output: [i32], capacity: i32, position: i32,
    value: i32) -> i32 {
    if (value == 0 - verified::host::I32_MAX - 1) {
        return verified::lean_output::text(output, capacity, position,
            "-2147483648", 11);
    }
    if (value < 0) {
        let next: i32 = verified::lean_output::byte(output, capacity,
            position, verified::ascii::MINUS);
        return verified::lean_output::natural(output, capacity, next, 0 - value);
    }
    return verified::lean_output::natural(output, capacity, position, value);
}

// The two signed i32 storage limbs denote an unsigned 64-bit machine value.
// Hex numerals preserve their bit patterns without a decoder computation in
// generated Lean. The surrounding constructor gives this expression type Nat.
pub fn unsigned64(output: [i32], capacity: i32, position: i32,
    low: i32, high: i32) -> i32 {
    let next: i32 = verified::lean_output::text(output, capacity, position,
        "0x", 2);
    next = verified::lean_output::hex_word(
        verified::lean_output::cursor(output, capacity, next), high);
    return verified::lean_output::hex_word(
        verified::lean_output::cursor(output, capacity, next), low);
}

fn nominal(output: [i32], capacity: i32, position: i32,
    types: ir::type_catalog::Table, id: i32) -> i32 {
    if (id < 0 || id >= types.type_count) { return -1; }
    let rows: [ir::type_catalog::TypeDecl] = types.types;
    let next: i32 = position;
    if (rows[id].kind == ir::type_catalog::Structure) {
        next = verified::lean_output::text(output, capacity, next,
            "(.structure ", 12);
    } else {
        if (rows[id].kind != ir::type_catalog::Enumeration) { return -1; }
        next = verified::lean_output::text(output, capacity, next,
            "(.enumeration ", 14);
    }
    next = verified::lean_output::natural(output, capacity, next, id);
    return verified::lean_output::byte(output, capacity, next,
        verified::ascii::RIGHT_PAREN);
}

fn nominal_slice(output: [i32], capacity: i32, position: i32,
    types: ir::type_catalog::Table, id: i32) -> i32 {
    let next: i32 = verified::lean_output::text(output, capacity,
        position, "(.slice ", 8);
    next = nominal(output, capacity, next, types, id);
    return verified::lean_output::byte(output, capacity, next,
        verified::ascii::RIGHT_PAREN);
}

pub fn type_ref(output: [i32], capacity: i32, position: i32,
    types: ir::type_catalog::Table,
    value: ir::type_ref::TypeRef) -> i32 {
    return match (value) {
        ir::type_ref::Void -> verified::lean_output::text(output, capacity,
            position, ".unit", 5),
        ir::type_ref::I32 -> verified::lean_output::text(output, capacity,
            position, "(.scalar (.signed .i32))", 24),
        ir::type_ref::Bool -> verified::lean_output::text(output, capacity,
            position, "(.scalar .bool)", 15),
        ir::type_ref::Usize -> verified::lean_output::text(output, capacity,
            position, "(.scalar (.unsigned .usize))", 28),
        ir::type_ref::Pointer -> verified::lean_output::text(output, capacity,
            position, "(.scalar .rawPtr)", 17),
        ir::type_ref::String -> verified::lean_output::text(output, capacity,
            position, "(.scalar .string)", 17),
        ir::type_ref::Slice -> verified::lean_output::text(output, capacity,
            position, "(.slice (.scalar (.signed .i32)))", 33),
        ir::type_ref::Nominal(id) -> nominal(output, capacity, position,
            types, id),
        ir::type_ref::NominalSlice(slice_id) -> nominal_slice(output,
            capacity, position, types, slice_id),
        _ -> -1,
    };
}

// Source identifiers have already been validated by the Lanius lexer. The
// same spelling is emitted into Lean without rereading the source file.
pub fn source_identifier(output: [i32], capacity: i32, position: i32,
    names: ir::symbol_catalog::Catalog,
    reference: ir::symbol_catalog::Ref) -> i32 {
    let spelling: ir::symbol_catalog::Spelling =
        ir::symbol_catalog::spelling(names, reference);
    if (!spelling.valid) { return -1; }
    let bytes: [i32] = spelling.source;
    let next: i32 = position;
    let index: i32 = 0;
    while (index < spelling.length) {
        next = verified::lean_output::byte(output, capacity, next,
            bytes[spelling.start + index]);
        if (next < 0) { return -1; }
        index += 1;
    }
    return next;
}

pub fn escaped_identifier(output: [i32], capacity: i32, position: i32,
    names: ir::symbol_catalog::Catalog, reference: ir::symbol_catalog::Ref) -> i32 {
    let next: i32 = verified::lean_output::text(output, capacity, position, "«", 2);
    next = source_identifier(output, capacity, next, names, reference);
    return verified::lean_output::text(output, capacity, next, "»", 2);
}

// Source namespaces are semantic metadata retained by lowering. IDs remain
// in the Core embedding, but are not part of its public Lean declaration names.
enum DeclarationSpace { TypeSpace, FunctionSpace, ConstantSpace }

fn declaration_identifier(output: [i32], capacity: i32, position: i32,
    names: ir::symbol_catalog::Catalog, reference: ir::symbol_catalog::Ref,
    space: DeclarationSpace) -> i32 {
    if (reference.unit < 0 || reference.unit >= names.unit_count) { return -1; }
    let units: [ir::symbol_catalog::Unit] = names.units;
    let path: ir::symbol_catalog::ModulePath = units[reference.unit].module_path;
    let segments: [ir::symbol_catalog::Ref] = path.segments;
    if (path.count <= 0 || path.count > units[reference.unit].token_count) { return -1; }
    // Keep the module path one name component. Type and function namespaces
    // in Lanius are distinct; neither can collide with a nested source module
    // or Lean's generated inductive declarations.
    let next: i32 = verified::lean_output::text(output, capacity, position, "Extracted.«", 12);
    let index: i32 = 0;
    while (index < path.count) {
        if (index != 0) { next = verified::lean_output::text(output, capacity, next, "::", 2); }
        next = source_identifier(output, capacity, next, names, segments[index]);
        if (next < 0) { return -1; }
        index += 1;
    }
    next = verified::lean_output::text(output, capacity, next, "»", 2);
    if (space == TypeSpace) {
        next = verified::lean_output::text(output, capacity, next, ".Types.", 7);
    } else {
        if (space == ConstantSpace) {
            next = verified::lean_output::text(output, capacity, next, ".Constants.", 11);
        } else {
            next = verified::lean_output::text(output, capacity, next, ".Functions.", 11);
        }
    }
    return escaped_identifier(output, capacity, next, names, reference);
}

pub fn function_identifier(output: [i32], capacity: i32, position: i32,
    names: ir::symbol_catalog::Catalog, index: i32) -> i32 {
    if (index < 0) { return -1; }
    if (names.unit_count == 0) {
        let next: i32 = verified::lean_output::text(output, capacity, position,
            "Extracted.function", 18);
        return verified::lean_output::natural(output, capacity, next, index);
    }
    if (index >= names.function_count) { return -1; }
    let references: [ir::symbol_catalog::Ref] = names.functions;
    return declaration_identifier(output, capacity, position, names, references[index], FunctionSpace);
}

pub fn constant_identifier(output: [i32], capacity: i32,
    position: i32, names: ir::symbol_catalog::Catalog, id: i32) -> i32 {
    if (id < 0) { return -1; }
    if (names.unit_count == 0) {
        let next: i32 = verified::lean_output::text(output, capacity,
            position, "Extracted.Constants.constant", 28);
        return verified::lean_output::natural(output, capacity, next, id);
    }
    return declaration_identifier(output, capacity, position, names,
        ir::symbol_catalog::constant_source(names, id), ConstantSpace);
}

// Qualified source names distinguish identically named types in different units.
pub fn type_identifier(output: [i32], capacity: i32, position: i32,
    names: ir::symbol_catalog::Catalog, id: i32) -> i32 {
    if (id < 0 || (names.unit_count > 0 && id >= names.type_count)) {
        return -1;
    }
    if (names.unit_count == 0) {
        let next: i32 = verified::lean_output::text(output, capacity, position,
            "Extracted.Type", 14);
        return verified::lean_output::natural(output, capacity, next, id);
    }
    let references: [ir::symbol_catalog::Ref] = names.types;
    return declaration_identifier(output, capacity, position, names, references[id], TypeSpace);
}

pub fn constructor_identifier(output: [i32], capacity: i32, position: i32,
    names: ir::symbol_catalog::Catalog, slot: i32, ordinal: i32) -> i32 {
    if (slot < 0 || (names.unit_count > 0 && slot >= names.variant_count)) {
        return -1;
    }
    if (names.unit_count == 0) {
        let next: i32 = verified::lean_output::text(output, capacity, position, "variant", 7);
        return verified::lean_output::natural(output, capacity, next, ordinal);
    }
    let references: [ir::symbol_catalog::Ref] = names.variants;
    return escaped_identifier(output, capacity, position, names, references[slot]);
}

fn starts_with(spelling: ir::symbol_catalog::Spelling, prefix: str, length: i32) -> bool {
    if (!spelling.valid || spelling.length < length) { return false; }
    let source: [i32] = spelling.source;
    let words: [i32] = verified::host::i32_slice_from_raw_parts(
        verified::host::string_data_ptr(prefix), verified::host::packed_words(length));
    let index: i32 = 0;
    while (index < length) {
        let expected: i32 = (words[index / verified::host::I32_BYTES]
            >> ((index % verified::host::I32_BYTES) * verified::host::BITS_PER_BYTE))
            & verified::host::BYTE_MASK;
        if (source[spelling.start + index] != expected) { return false; }
        index += 1;
    }
    return true;
}

// Lean 4.33's inductive elaborator owns these auxiliary-name families,
// including numbered recursors and sizeOf helpers. A colon cannot occur in
// a Lanius identifier, so the escaped constructor namespace is disjoint.
fn auxiliary_constructor_name(spelling: ir::symbol_catalog::Spelling) -> bool {
    return starts_with(spelling, "rec", 3)
        || starts_with(spelling, "casesOn", 7)
        || starts_with(spelling, "ctor", 4)
        || starts_with(spelling, "toCtor", 6)
        || starts_with(spelling, "noConfusion", 11)
        || starts_with(spelling, "below", 5)
        || starts_with(spelling, "ibelow", 6)
        || starts_with(spelling, "brecOn", 6)
        || starts_with(spelling, "binductionOn", 12)
        || starts_with(spelling, "_", 1);
}

pub fn native_constructor_identifier(output: [i32], capacity: i32, position: i32,
    names: ir::symbol_catalog::Catalog, slot: i32, ordinal: i32) -> i32 {
    if (names.unit_count == 0) {
        return constructor_identifier(output, capacity, position, names, slot, ordinal);
    }
    if (slot < 0 || slot >= names.variant_count) { return -1; }
    let references: [ir::symbol_catalog::Ref] = names.variants;
    let reference: ir::symbol_catalog::Ref = references[slot];
    let spelling: ir::symbol_catalog::Spelling = ir::symbol_catalog::spelling(names, reference);
    if (!auxiliary_constructor_name(spelling)) {
        return escaped_identifier(output, capacity, position, names, reference);
    }
    let next: i32 = verified::lean_output::text(output, capacity, position, "«constructor:", 14);
    next = source_identifier(output, capacity, next, names, reference);
    return verified::lean_output::text(output, capacity, next, "»", 2);
}

fn variant_slot(types: ir::type_catalog::Table, type_id: i32, ordinal: i32) -> i32 {
    if (type_id < 0 || type_id >= types.type_count) { return -1; }
    let declarations: [ir::type_catalog::TypeDecl] = types.types;
    let declaration: ir::type_catalog::TypeDecl = declarations[type_id];
    if (declaration.kind != ir::type_catalog::Enumeration
        || ordinal < 0 || ordinal >= declaration.variant_count) { return -1; }
    let slot: i32 = declaration.variant_start + ordinal;
    if (slot < 0 || slot >= types.variant_count) { return -1; }
    return slot;
}

pub fn constructor_surface(output: [i32], capacity: i32, position: i32,
    types: ir::type_catalog::Table, names: ir::symbol_catalog::Catalog,
    type_id: i32, ordinal: i32) -> i32 {
    let slot: i32 = variant_slot(types, type_id, ordinal);
    if (slot < 0) { return -1; }
    let next: i32 = verified::lean_output::byte(output, capacity, position, 46);
    return constructor_identifier(output, capacity, next, names, slot, ordinal);
}

pub fn named_type_ref(output: [i32], capacity: i32, position: i32,
    types: ir::type_catalog::Table,
    names: ir::symbol_catalog::Catalog,
    value: ir::type_ref::TypeRef) -> i32 {
    // Source declarations can themselves be named Bool, String, or Unit.
    // Primitive labels must not resolve to those declarations in Lean.
    return match (value) {
        ir::type_ref::Void -> verified::lean_output::text(output, capacity,
            position, "_root_.Unit", 11),
        ir::type_ref::I32 -> verified::lean_output::text(output, capacity,
            position, "Lanius.TypedIR.Surface.I32", 26),
        ir::type_ref::Bool -> verified::lean_output::text(output, capacity,
            position, "_root_.Bool", 11),
        ir::type_ref::Usize -> verified::lean_output::text(output, capacity,
            position, "Lanius.TypedIR.Surface.Usize", 28),
        ir::type_ref::Pointer -> verified::lean_output::text(output, capacity,
            position, "Lanius.TypedIR.Surface.RawPtr", 29),
        ir::type_ref::String -> verified::lean_output::text(output, capacity,
            position, "_root_.String", 13),
        ir::type_ref::Slice -> verified::lean_output::text(output, capacity,
            position, "(Lanius.TypedIR.Surface.Slice Lanius.TypedIR.Surface.I32)", 57),
        ir::type_ref::Nominal(id) -> type_identifier(output, capacity,
            position, names, id),
        ir::type_ref::NominalSlice(slice_id) -> named_nominal_slice(output,
            capacity, position, names, slice_id),
        _ -> -1,
    };
}

fn named_nominal_slice(output: [i32], capacity: i32, position: i32,
    names: ir::symbol_catalog::Catalog, id: i32) -> i32 {
    let next: i32 = verified::lean_output::text(output, capacity, position,
        "(Lanius.TypedIR.Surface.Slice ", 30);
    next = type_identifier(output, capacity, next, names, id);
    return verified::lean_output::byte(output, capacity, next, 41);
}

fn hex_digit(value: i32) -> i32 {
    if (value < 10) { return verified::ascii::ZERO + value; }
    return verified::ascii::LOWER_A + value - 10;
}

// Emit a byte-preserving UTF-8 Lean string literal from typed IR bytes.
// ASCII controls, the quote, and backslash use fixed-width hex escapes;
// multibyte UTF-8 is copied verbatim after validating the whole string.
pub fn string_bytes(output: [i32], capacity: i32, position: i32,
    bytes: [i32], byte_capacity: i32, start: i32, count: i32) -> i32 {
    if (start < 0 || count < 0 || start > byte_capacity
        || count > byte_capacity - start
        || !verified::utf8::valid_interval(bytes, byte_capacity,
            start, start + count)) {
        return -1;
    }
    let next: i32 = verified::lean_output::byte(output, capacity,
        position, 34);
    let index: i32 = 0;
    while (index < count) {
        let byte: i32 = bytes[start + index];
        if (byte < 0 || byte > verified::host::BYTE_MASK) { return -1; }
        if (byte < 32 || byte == 34 || byte == 92 || byte == 127) {
            next = verified::lean_output::byte(output, capacity, next, 92);
            next = verified::lean_output::byte(output, capacity, next, 120);
            next = verified::lean_output::byte(output, capacity, next,
                hex_digit(byte >> 4));
            next = verified::lean_output::byte(output, capacity, next,
                hex_digit(byte & 15));
        } else {
            next = verified::lean_output::byte(output, capacity, next, byte);
        }
        if (next <= -1) { return -1; }
        index += 1;
    }
    return verified::lean_output::byte(output, capacity, next, 34);
}

pub fn source_name(output: [i32], capacity: i32, position: i32,
    names: ir::symbol_catalog::Catalog,
    reference: ir::symbol_catalog::Ref) -> i32 {
    let spelling: ir::symbol_catalog::Spelling =
        ir::symbol_catalog::spelling(names, reference);
    if (!spelling.valid) { return -1; }
    return string_bytes(output, capacity, position,
        spelling.source, names.source_count,
        spelling.start, spelling.length);
}

pub fn service(output: [i32], capacity: i32, position: i32,
    value: runtime::service::RuntimeService) -> i32 {
    return match (value) {
        runtime::service::Allocate -> verified::lean_output::text(output,
            capacity, position, "(.host .alloc)", 14),
        runtime::service::OpenRead -> verified::lean_output::text(output,
            capacity, position, "(.host .openRead)", 17),
        runtime::service::Close -> verified::lean_output::text(output,
            capacity, position, "(.host .close)", 14),
        runtime::service::Read -> verified::lean_output::text(output,
            capacity, position, "(.host .read)", 13),
        runtime::service::WriteStdout -> verified::lean_output::text(output,
            capacity, position, "(.host .writeStdout)", 20),
        runtime::service::WriteByte -> verified::lean_output::text(output,
            capacity, position, "(.host .writeByte)", 18),
        runtime::service::ArgumentCount -> verified::lean_output::text(output,
            capacity, position, "(.host .argc)", 13),
        runtime::service::ArgumentLength -> verified::lean_output::text(output,
            capacity, position, "(.host .argLen)", 15),
        runtime::service::ArgumentRead -> verified::lean_output::text(output,
            capacity, position, "(.host .argRead)", 16),
        _ -> -1,
    };
}
