module verified::grammar;
import verified::host;
import verified::ascii;

pub const WORDS: i32 = 2179;
const NIBBLE_BITS: i32 = 4;
fn hex_nibble(byte: i32) -> i32 {
    if (byte >= verified::ascii::ZERO && byte <= verified::ascii::NINE) {
        return byte - verified::ascii::ZERO;
    }
    return byte - verified::ascii::LOWER_A + 10;
}
// The grammar is the same authenticated artifact used by extractor.lani.
// Keeping its decoding in a pure Lanius producer lets later entrypoints share
// the exact frontend grammar without host-side parsing or generated tables.
pub fn load(output:[i32], capacity: i32) -> i32 {
    if (capacity<WORDS) {
        return -1;
    }
    let encoded: str = "";
    let words:[i32] = verified::host::i32_slice_from_raw_parts(verified::host::string_data_ptr(encoded), WORDS);
    let index: i32 = 0;
    while (index<WORDS) {
        let value: i32 = words[index];
        output[index] =
            (hex_nibble(value & verified::host::BYTE_MASK)
                << (NIBBLE_BITS * verified::host::I32_BYTE_3))
            | (hex_nibble((value >> verified::host::BITS_PER_BYTE)
                & verified::host::BYTE_MASK)
                    << (NIBBLE_BITS * verified::host::I32_BYTE_2))
            | (hex_nibble((value >> (verified::host::BITS_PER_BYTE
                * verified::host::I32_BYTE_2))
                & verified::host::BYTE_MASK) << NIBBLE_BITS)
            | hex_nibble((value >> (verified::host::BITS_PER_BYTE
                * verified::host::I32_BYTE_3))
                & verified::host::BYTE_MASK);
        index += 1;
    }
    return WORDS;
}
