module verified::lean_typed_body;

import ir::body_events;
import ir::body_tree;
import ir::function_catalog;
import ir::symbol_catalog;
import ir::type_catalog;
import ir::type_ref;
import verified::lean_operations;
import verified::lean_body_shape;
import verified::lean_output;
import verified::lean_syntax;
import verified::host;

// Readable constructors erase directly to the same Core tree as the x86 IR.
// Unsupported nodes are rejected; there is no unchecked Core escape hatch.
// Native records use eight-byte slots. Tree: 8, Table: 9, Catalog: 25,
// function index: 9, function/unit: 2, output/capacity: 3. Reserve 64 slots for the 56-slot
// context; recursive writers pass its slice handle instead of the value.
const VIEW_BYTES: i32 = 64 * 8;

struct View {
    tree: ir::body_tree::Tree,
    types: ir::type_catalog::Table,
    names: ir::symbol_catalog::Catalog,
    functions: ir::function_catalog::Index,
    function_index: i32,
    unit: i32,
    output: [i32],
    capacity: i32,
}

fn type_name(views: [View], kind: ir::type_ref::TypeRef,
    position: i32) -> i32 {
    let view: View = views[0];
    let output: [i32] = view.output;
    let capacity: i32 = view.capacity;
    return verified::lean_syntax::named_type_ref(output, capacity, position,
        view.types, view.names, kind);
}

fn surface_variant(views: [View], type_id: i32, ordinal: i32, position: i32) -> i32 {
    let view: View = views[0];
    return verified::lean_syntax::constructor_surface(view.output, view.capacity, position,
        view.types, view.names, type_id, ordinal);
}

fn surface_name(views: [View], token: i32,
    position: i32) -> i32 {
    let view: View = views[0];
    if (view.unit < 0) { return -1; }
    return surface_reference(views,
        ir::symbol_catalog::Ref { unit: view.unit, token: token }, position);
}

fn surface_reference(views: [View], reference: ir::symbol_catalog::Ref,
    position: i32) -> i32 {
    let view: View = views[0];
    return verified::lean_syntax::escaped_identifier(view.output,
        view.capacity, position, view.names, reference);
}

pub fn surface_bindings(tree: ir::body_tree::Tree,
    output: [i32], capacity: i32, position: i32) -> i32 {
    if (!verified::lean_body_shape::surface_supported(tree)) { return -1; }
    let next: i32 = verified::lean_output::byte(output, capacity,
        position, 91);
    let events: [ir::body_events::Event] = tree.events;
    let index: i32 = 0;
    let count: i32 = 0;
    while (index < tree.count) {
        let id: i32 = match (events[index]) {
            ir::body_events::StatementLet(declaration) ->
                verified::lean_body_shape::statement_let_id(events[index]),
            ir::body_events::StatementLetUninitialized(uninitialized_declaration) ->
                verified::lean_body_shape::statement_let_id(events[index]),
            ir::body_events::MatchBinding(binding) ->
                verified::lean_body_shape::match_binding_id(events[index]),
            _ -> -1,
        };
        if (id >= 0) {
            if (count > 0) {
                next = verified::lean_output::text(output, capacity,
                    next, ", ", 2);
            }
            next = verified::lean_output::natural(output, capacity,
                next, id);
            count += 1;
        }
        if (next < 0) { return -1; }
        index += 1;
    }
    return verified::lean_output::byte(output, capacity, next, 93);
}

fn surface_atom_output(views: [View], index: i32,
    position: i32) -> i32 {
    let view: View = views[0];
    let events: [ir::body_events::Event] = view.tree.events;
    return match (events[index]) {
        ir::body_events::ExpressionBoolean(boolean_value) ->
            surface_boolean_output(views, boolean_value, position),
        ir::body_events::ExpressionString(string_value) ->
            surface_string_output(views, events[index], position),
        ir::body_events::ExpressionInteger(value) ->
            verified::lean_syntax::signed(view.output, view.capacity,
                position, value),
        ir::body_events::ExpressionUsize(usize_value) ->
            surface_typed_numeral(views, usize_value, ir::type_ref::Usize, position),
        ir::body_events::ExpressionPointerNull ->
            surface_typed_numeral(views, 0, ir::type_ref::Pointer, position),
        ir::body_events::ExpressionConstant(id) ->
            verified::lean_syntax::constant_identifier(
                view.output, view.capacity, position, view.names, id),
        ir::body_events::ExpressionLocal(reference) ->
            surface_name(views, verified::lean_body_shape::expression_local_id(events[index]), position),
        _ -> -1,
    };
}

fn surface_typed_numeral(views: [View], value: i32,
    kind: ir::type_ref::TypeRef, position: i32) -> i32 {
    let view: View = views[0];
    let next: i32 = verified::lean_output::byte(view.output, view.capacity, position, 40);
    next = verified::lean_output::natural(view.output, view.capacity, next, value);
    next = verified::lean_output::text(view.output, view.capacity, next, " : ", 3);
    next = type_name(views, kind, next);
    return verified::lean_output::byte(view.output, view.capacity, next, 41);
}

fn surface_boolean_output(views: [View], value: bool, position: i32) -> i32 {
    let view: View = views[0];
    if (value) {
        return verified::lean_output::text(view.output, view.capacity, position, "true", 4);
    }
    return verified::lean_output::text(view.output, view.capacity, position, "false", 5);
}

fn surface_string_output(views: [View], event: ir::body_events::Event,
    position: i32) -> i32 {
    let view: View = views[0];
    return match (event) {
        ir::body_events::ExpressionString(value) ->
            verified::lean_syntax::string_bytes(view.output, view.capacity,
                position, value.data, value.length, 0, value.length),
        _ -> -1,
    };
}

fn surface_expression_output(views: [View], index: i32,
    position: i32) -> i32 {
    let view: View = views[0];
    let events: [ir::body_events::Event] = view.tree.events;
    if (verified::lean_body_shape::surface_atom(view.tree, index)) {
        return surface_atom_output(views, index, position);
    }
    let binary: verified::lean_operations::Name = verified::lean_operations::binary_symbol(events[index]);
    if (binary.length > 0) {
        return surface_binary_output(views, index, position);
    }
    let intrinsic: verified::lean_operations::Name = verified::lean_operations::intrinsic_name(events[index]);
    if (intrinsic.length > 0) { return surface_intrinsic_output(views, index, position); }
    return match (events[index]) {
        ir::body_events::ExpressionCast(target) -> surface_intrinsic_output(views, index, position),
        ir::body_events::ExpressionUnaryPositive -> surface_unary_output(views, index, position),
        ir::body_events::ExpressionUnaryNot -> surface_unary_output(views, index, position),
        ir::body_events::ExpressionUnaryNegate -> surface_unary_output(views, index, position),
        ir::body_events::ExpressionField(field) ->
            surface_field_output(views, index, position),
        ir::body_events::ExpressionIndex ->
            surface_index_output(views, index, position),
        ir::body_events::ExpressionEnumeration(constructor) ->
            surface_constructor_output(views, index, position),
        ir::body_events::ExpressionStruct(record) ->
            surface_structure_output(views, index, position),
        ir::body_events::ExpressionCall(call) ->
            surface_call_output(views, index, position),
        ir::body_events::ExpressionMatch(header) ->
            surface_match_output(views, index, position, true),
        _ -> -1,
    };
}

fn surface_unary_output(views: [View], index: i32, position: i32) -> i32 {
    let view: View = views[0];
    let events: [ir::body_events::Event] = view.tree.events;
    let symbol: i32 = match (events[index]) {
        ir::body_events::ExpressionUnaryPositive -> 43,
        ir::body_events::ExpressionUnaryNot -> 33,
        ir::body_events::ExpressionUnaryNegate -> 45,
        _ -> -1,
    };
    if (symbol < 0) { return -1; }
    let next: i32 = verified::lean_output::byte(view.output, view.capacity, position, 40);
    next = verified::lean_output::byte(view.output, view.capacity, next, symbol);
    next = verified::lean_output::byte(view.output, view.capacity, next, 40);
    next = surface_expression_output(views, ir::body_tree::first_child(view.tree, index), next);
    return verified::lean_output::text(view.output, view.capacity, next, "))", 2);
}

fn surface_field_output(views: [View], index: i32,
    position: i32) -> i32 {
    let view: View = views[0];
    let slot: i32 = verified::lean_body_shape::field_slot(view.tree, view.types, index);
    if (slot < 0 || slot >= view.names.field_count) { return -1; }
    let references: [ir::symbol_catalog::Ref] = view.names.fields;
    let next: i32 = verified::lean_output::byte(view.output,
        view.capacity, position, 40);
    next = surface_expression_output(views,
        ir::body_tree::first_child(view.tree, index), next);
    next = verified::lean_output::text(view.output, view.capacity,
        next, ").", 2);
    return surface_reference(views, references[slot], next);
}

fn surface_index_output(views: [View], index: i32,
    position: i32) -> i32 {
    let view: View = views[0];
    let base: i32 = ir::body_tree::first_child(view.tree, index);
    let offset: i32 = ir::body_tree::next_sibling(view.tree, index, base);
    let next: i32 = position;
    if (!verified::lean_body_shape::surface_atom(view.tree, base)) {
        next = verified::lean_output::byte(view.output,
            view.capacity, next, 40);
    }
    next = surface_expression_output(views, base, next);
    if (!verified::lean_body_shape::surface_atom(view.tree, base)) {
        next = verified::lean_output::byte(view.output,
            view.capacity, next, 41);
    }
    next = verified::lean_output::byte(view.output,
        view.capacity, next, 91);
    next = surface_expression_output(views, offset, next);
    return verified::lean_output::byte(view.output,
        view.capacity, next, 93);
}

fn surface_binary_output(views: [View], index: i32,
    position: i32) -> i32 {
    let view: View = views[0];
    if (verified::lean_body_shape::pointer_binary_supported(view.tree, index)) {
        return surface_intrinsic_output(views, index, position);
    }
    let events: [ir::body_events::Event] = view.tree.events;
    let symbol: verified::lean_operations::Name = verified::lean_operations::binary_symbol(events[index]);
    if (symbol.length == 0) { return -1; }
    let next: i32 = verified::lean_output::byte(view.output,
        view.capacity, position, 40);
    let left: i32 = ir::body_tree::first_child(view.tree, index);
    let right: i32 = ir::body_tree::next_sibling(view.tree, index, left);
    next = surface_expression_output(views, left, next);
    next = verified::lean_output::byte(view.output, view.capacity, next, 32);
    next = verified::lean_output::text(view.output, view.capacity, next, symbol.spelling, symbol.length);
    next = verified::lean_output::byte(view.output, view.capacity, next, 32);
    next = surface_expression_output(views, right, next);
    return verified::lean_output::byte(view.output,
        view.capacity, next, 41);
}

fn surface_intrinsic_output(views: [View], index: i32, position: i32) -> i32 {
    let view: View = views[0];
    let events: [ir::body_events::Event] = view.tree.events;
    let element: ir::body_events::SliceElement = ir::body_events::typed_slice_fields(events[index]);
    if (element.id >= 0 && !verified::lean_body_shape::typed_slice_supported(view.types, element)) {
        return -1;
    }
    let next: i32 = verified::lean_output::text(view.output, view.capacity, position,
        "(Lanius.TypedIR.Surface.Builtin.", 32);
    let intrinsic: verified::lean_operations::Name = verified::lean_operations::intrinsic_name(events[index]);
    if (intrinsic.length == 0) {
        intrinsic = verified::lean_operations::pointer_binary_name(events[index]);
    }
    if (intrinsic.length > 0) {
        next = verified::lean_output::text(view.output, view.capacity, next, intrinsic.spelling, intrinsic.length);
    } else {
        if (ir::type_ref::same(ir::body_tree::result_type(view.tree, index), ir::type_ref::Usize)) {
            next = verified::lean_output::text(view.output, view.capacity, next, "toUsize", 7);
        } else {
            next = verified::lean_output::text(view.output, view.capacity, next, "toI32", 5);
        }
    }
    let child: i32 = ir::body_tree::first_child(view.tree, index);
    while (child >= 0) {
        next = verified::lean_output::text(view.output, view.capacity, next, " (", 2);
        next = surface_expression_output(views, child, next);
        next = verified::lean_output::byte(view.output, view.capacity, next, 41);
        if (next < 0) { return -1; }
        child = ir::body_tree::next_sibling(view.tree, index, child);
    }
    // Make the nominal element type explicit even when surrounding inference
    // has not yet selected the field or local receiving this expression.
    if (element.id >= 0) {
        next = verified::lean_output::text(view.output, view.capacity, next, " : ", 3);
        next = type_name(views, ir::type_ref::NominalSlice(element.id), next);
    }
    return verified::lean_output::byte(view.output, view.capacity, next, 41);
}

fn surface_constructor_output(views: [View], index: i32,
    position: i32) -> i32 {
    let view: View = views[0];
    let events: [ir::body_events::Event] = view.tree.events;
    let constructor: ir::body_events::EnumVariant =
        ir::body_events::enumeration_fields(events[index]);
    let next: i32 = verified::lean_output::byte(view.output, view.capacity, position, 40);
    next = surface_variant(views, constructor.type_id, constructor.ordinal, next);
    let child: i32 = ir::body_tree::first_child(view.tree, index);
    let ordinal: i32 = 0;
    while (ordinal < constructor.payload_count) {
        next = verified::lean_output::text(view.output, view.capacity,
            next, " (", 2);
        next = surface_expression_output(views, child, next);
        next = verified::lean_output::byte(view.output,
            view.capacity, next, 41);
        if (next < 0) { return -1; }
        child = ir::body_tree::next_sibling(view.tree, index, child);
        ordinal += 1;
    }
    next = verified::lean_output::text(view.output, view.capacity, next, " : ", 3);
    next = type_name(views, ir::type_ref::Nominal(constructor.type_id), next);
    return verified::lean_output::byte(view.output, view.capacity, next, 41);
}

fn surface_structure_output(views: [View], index: i32,
    position: i32) -> i32 {
    let view: View = views[0];
    if (!verified::lean_body_shape::record_supported(view.tree, view.types, index)) { return -1; }
    let events: [ir::body_events::Event] = view.tree.events;
    let record: ir::body_events::StructFields =
        ir::body_events::structure_fields(events[index]);
    let declarations: [ir::type_catalog::TypeDecl] = view.types.types;
    let declaration: ir::type_catalog::TypeDecl = declarations[record.type_id];
    let references: [ir::symbol_catalog::Ref] = view.names.fields;
    let next: i32 = verified::lean_output::text(view.output, view.capacity,
        position, "({ ", 3);
    let child: i32 = ir::body_tree::first_child(view.tree, index);
    let ordinal: i32 = 0;
    while (ordinal < record.count) {
        let slot: i32 = declaration.field_start + ordinal;
        if (slot < 0 || slot >= view.names.field_count) { return -1; }
        if (ordinal > 0) {
            next = verified::lean_output::text(view.output, view.capacity, next, ", ", 2);
        }
        next = surface_reference(views, references[slot], next);
        next = verified::lean_output::text(view.output, view.capacity, next, " := ", 4);
        next = surface_expression_output(views, child, next);
        if (next < 0) { return -1; }
        child = ir::body_tree::next_sibling(view.tree, index, child);
        ordinal += 1;
    }
    next = verified::lean_output::text(view.output, view.capacity, next, " : ", 3);
    next = type_name(views, ir::type_ref::Nominal(record.type_id), next);
    return verified::lean_output::text(view.output, view.capacity, next, " })", 3);
}

fn surface_call_output(views: [View], index: i32,
    position: i32) -> i32 {
    let view: View = views[0];
    let events: [ir::body_events::Event] = view.tree.events;
    let call: ir::body_events::CallHeader =
        ir::body_events::call_fields(events[index]);
    let target: i32 = ir::function_catalog::find(view.functions, call.function_id);
    if (target <= -1) { return -1; }
    let next: i32 = verified::lean_syntax::function_identifier(
        view.output, view.capacity, position, view.names, target);
    if (call.argument_count == 0) {
        return verified::lean_output::text(view.output,
            view.capacity, next, " ()", 3);
    }
    let child: i32 = ir::body_tree::first_child(view.tree, index);
    let ordinal: i32 = 0;
    while (ordinal < call.argument_count) {
        next = verified::lean_output::text(view.output, view.capacity,
            next, " (", 2);
        next = surface_expression_output(views, child, next);
        next = verified::lean_output::byte(view.output,
            view.capacity, next, 41);
        if (next < 0) { return -1; }
        child = ir::body_tree::next_sibling(view.tree, index, child);
        ordinal += 1;
    }
    return next;
}

fn surface_match_output(views: [View], index: i32,
    position: i32, enclosed: bool) -> i32 {
    let view: View = views[0];
    let events: [ir::body_events::Event] = view.tree.events;
    let header: ir::body_events::MatchHeader =
        ir::body_events::matching_fields(events[index]);
    let next: i32 = position;
    if (enclosed) { next = verified::lean_output::byte(view.output, view.capacity, next, 40); }
    next = verified::lean_output::text(view.output,
        view.capacity, next, "match ", 6);
    let child: i32 = ir::body_tree::first_child(view.tree, index);
    if (!verified::lean_body_shape::surface_atom(view.tree, child)) {
        next = verified::lean_output::byte(view.output,
            view.capacity, next, 40);
    }
    next = surface_expression_output(views, child, next);
    if (!verified::lean_body_shape::surface_atom(view.tree, child)) {
        next = verified::lean_output::byte(view.output,
            view.capacity, next, 41);
    }
    next = verified::lean_output::text(view.output, view.capacity,
        next, " with\n", 6);
    child = ir::body_tree::next_sibling(view.tree, index, child);
    let ordinal: i32 = 0;
    while (ordinal < header.arm_count) {
        let arm: ir::body_events::MatchArm =
            ir::body_events::matching_arm_fields(events[child]);
        next = verified::lean_output::text(view.output, view.capacity,
            next, "      | ", 8);
        if (arm.ordinal == -1) {
            next = verified::lean_output::byte(view.output, view.capacity, next, 95);
        } else {
            next = surface_variant(views, header.scrutinee_type_id,
                arm.ordinal, next);
        }
        let body: i32 = ir::body_tree::first_child(view.tree, child);
        let binding: i32 = 0;
        while (binding < arm.binding_count) {
            let reference: ir::body_events::LocalReference =
                ir::body_events::matching_binding_fields(events[body]);
            next = verified::lean_output::byte(view.output,
                view.capacity, next, 32);
            next = surface_name(views, reference.id, next);
            body = ir::body_tree::next_sibling(view.tree, child, body);
            binding += 1;
        }
        next = verified::lean_output::text(view.output, view.capacity,
            next, " => ", 4);
        next = surface_expression_output(views, body, next);
        next = verified::lean_output::byte(view.output,
            view.capacity, next, 10);
        if (next < 0) { return -1; }
        child = ir::body_tree::next_sibling(view.tree, index, child);
        ordinal += 1;
    }
    if (enclosed) { next = verified::lean_output::byte(view.output, view.capacity, next, 41); }
    return next;
}

fn surface_indent(views: [View], indentation: i32,
    position: i32) -> i32 {
    let view: View = views[0];
    let next: i32 = position;
    let space: i32 = 0;
    while (space < indentation) {
        next = verified::lean_output::byte(view.output,
            view.capacity, next, 32);
        if (next < 0) { return -1; }
        space += 1;
    }
    return next;
}

fn surface_statement_output(views: [View], index: i32,
    indentation: i32, position: i32) -> i32 {
    let view: View = views[0];
    let events: [ir::body_events::Event] = view.tree.events;
    return match (events[index]) {
        ir::body_events::StatementSkip ->
            surface_skip_output(views, indentation, position),
        ir::body_events::StatementSequence ->
            surface_sequence_output(views, index, indentation, position),
        ir::body_events::StatementIf ->
            surface_if_output(views, index, indentation, position),
        ir::body_events::StatementWhile -> surface_while_output(views, index, indentation, position),
        ir::body_events::StatementExpression -> surface_effect_output(views, index, indentation, position),
        ir::body_events::StatementLet(declaration) ->
            surface_let_output(views, index, indentation, position),
        ir::body_events::StatementLetUninitialized(uninitialized_declaration) ->
            surface_let_output(views, index, indentation, position),
        ir::body_events::StatementReturnVoid ->
            surface_return_output(views, index, indentation, position),
        ir::body_events::StatementReturnValue ->
            surface_return_output(views, index, indentation, position),
        _ -> -1,
    };
}

fn surface_place_output(views: [View], index: i32, position: i32) -> i32 {
    let view: View = views[0];
    let events: [ir::body_events::Event] = view.tree.events;
    let local: ir::body_events::LocalReference = ir::body_events::local_reference(events[index]);
    if (local.id >= 0) { return surface_name(views, local.id, position); }
    let base: i32 = ir::body_tree::first_child(view.tree, index);
    let next: i32 = verified::lean_output::byte(view.output, view.capacity, position, 40);
    next = surface_place_output(views, base, next);
    next = verified::lean_output::byte(view.output, view.capacity, next, 41);
    let slot: i32 = verified::lean_body_shape::field_slot(view.tree, view.types, index);
    if (slot >= 0) {
        let references: [ir::symbol_catalog::Ref] = view.names.fields;
        if (slot >= view.names.field_count) { return -1; }
        next = verified::lean_output::byte(view.output, view.capacity, next, 46);
        return surface_reference(views, references[slot], next);
    }
    let indexed: bool = match (events[index]) {
        ir::body_events::PlaceIndex -> true,
        _ -> false,
    };
    if (!indexed) { return -1; }
    next = verified::lean_output::byte(view.output, view.capacity, next, 91);
    next = surface_expression_output(views,
        ir::body_tree::next_sibling(view.tree, index, base), next);
    return verified::lean_output::byte(view.output, view.capacity, next, 93);
}

fn surface_effect_output(views: [View], index: i32,
    indentation: i32, position: i32) -> i32 {
    let view: View = views[0];
    let child: i32 = ir::body_tree::first_child(view.tree, index);
    let events: [ir::body_events::Event] = view.tree.events;
    let operation: verified::lean_operations::Name = verified::lean_operations::assignment_symbol(events[child]);
    let next: i32 = surface_indent(views, indentation, position);
    if (operation.length > 0) {
        let target: i32 = ir::body_tree::first_child(view.tree, child);
        let value: i32 = ir::body_tree::next_sibling(view.tree, child, target);
        next = surface_place_output(views, target, next);
        next = verified::lean_output::byte(view.output, view.capacity, next, 32);
        next = verified::lean_output::text(view.output, view.capacity, next,
            operation.spelling, operation.length);
        next = verified::lean_output::byte(view.output, view.capacity, next, 32);
        next = surface_expression_output(views, value, next);
    } else {
        next = surface_expression_output(views, child, next);
    }
    return verified::lean_output::byte(view.output, view.capacity, next, 10);
}

fn surface_while_output(views: [View], index: i32,
    indentation: i32, position: i32) -> i32 {
    let view: View = views[0];
    let condition: i32 = ir::body_tree::first_child(view.tree, index);
    let body: i32 = ir::body_tree::next_sibling(view.tree, index, condition);
    let next: i32 = surface_indent(views, indentation, position);
    next = verified::lean_output::text(view.output, view.capacity, next, "while ", 6);
    next = surface_expression_output(views, condition, next);
    next = verified::lean_output::text(view.output, view.capacity, next, " do\n", 4);
    return surface_statement_output(views, body, indentation + 2, next);
}

fn surface_skip_output(views: [View], indentation: i32,
    position: i32) -> i32 {
    let view: View = views[0];
    let next: i32 = surface_indent(views, indentation, position);
    return verified::lean_output::text(view.output,
        view.capacity, next, "skip\n", 5);
}

fn surface_sequence_output(views: [View], index: i32,
    indentation: i32, position: i32) -> i32 {
    let view: View = views[0];
    let first: i32 = ir::body_tree::first_child(view.tree, index);
    let second: i32 = ir::body_tree::next_sibling(view.tree,
        index, first);
    let events: [ir::body_events::Event] = view.tree.events;
    let scoped: bool = match (events[first]) {
        ir::body_events::StatementSequence -> true,
        ir::body_events::StatementLet(local) -> true,
        ir::body_events::StatementLetUninitialized(uninitialized_local) -> true,
        ir::body_events::StatementReturnValue -> true,
        ir::body_events::StatementReturnVoid -> true,
        _ -> false,
    };
    let next: i32 = position;
    let first_indentation: i32 = indentation;
    if (scoped) {
        next = surface_indent(views, indentation, next);
        next = verified::lean_output::text(view.output, view.capacity, next,
            "do\n", 3);
        first_indentation += 2;
    }
    next = surface_statement_output(views, first, first_indentation, next);
    return surface_statement_output(views, second, indentation, next);
}

fn surface_if_output(views: [View], index: i32,
    indentation: i32, position: i32) -> i32 {
    let view: View = views[0];
    let condition: i32 = ir::body_tree::first_child(view.tree, index);
    let then_branch: i32 = ir::body_tree::next_sibling(view.tree,
        index, condition);
    let else_branch: i32 = ir::body_tree::next_sibling(view.tree,
        index, then_branch);
    let next: i32 = surface_indent(views, indentation, position);
    next = verified::lean_output::text(view.output,
        view.capacity, next, "if ", 3);
    next = surface_expression_output(views, condition, next);
    next = verified::lean_output::text(view.output,
        view.capacity, next, " then\n", 6);
    next = surface_statement_output(views,
        then_branch, indentation + 2, next);
    next = surface_indent(views, indentation, next);
    next = verified::lean_output::text(view.output,
        view.capacity, next, "else\n", 5);
    return surface_statement_output(views,
        else_branch, indentation + 2, next);
}

fn surface_let_output(views: [View], index: i32,
    indentation: i32, position: i32) -> i32 {
    let view: View = views[0];
    let events: [ir::body_events::Event] = view.tree.events;
    let local: ir::body_events::LocalDeclaration =
        ir::body_events::local_declaration(events[index]);
    let next: i32 = surface_indent(views, indentation, position);
    next = verified::lean_output::text(view.output,
        view.capacity, next, "let ", 4);
    next = surface_name(views, local.id, next);
    next = verified::lean_output::text(view.output, view.capacity,
        next, " : ", 3);
    next = type_name(views, local.kind, next);
    let first: i32 = ir::body_tree::first_child(view.tree, index);
    let uninitialized: bool = match (events[index]) {
        ir::body_events::StatementLetUninitialized(declaration) -> true,
        _ -> false,
    };
    if (uninitialized) {
        next = verified::lean_output::byte(view.output, view.capacity, next, 10);
        return surface_statement_output(views, first, indentation, next);
    }
    next = verified::lean_output::text(view.output, view.capacity,
        next, " := ", 4);
    next = surface_expression_output(views, first, next);
    next = verified::lean_output::byte(view.output, view.capacity,
        next, 10);
    let body: i32 = ir::body_tree::next_sibling(view.tree,
        index, first);
    return surface_statement_output(views, body, indentation, next);
}

fn surface_return_output(views: [View], index: i32,
    indentation: i32, position: i32) -> i32 {
    let view: View = views[0];
    let next: i32 = surface_indent(views, indentation, position);
    next = verified::lean_output::text(view.output,
        view.capacity, next, "return", 6);
    let value: i32 = ir::body_tree::first_child(view.tree, index);
    if (value >= 0) {
        next = verified::lean_output::byte(view.output, view.capacity, next, 32);
        let events: [ir::body_events::Event] = view.tree.events;
        let matching: bool = match (events[value]) {
            ir::body_events::ExpressionMatch(header) -> true,
            _ -> false,
        };
        if (matching) {
            next = surface_match_output(views, value, next, false);
        } else {
            next = surface_expression_output(views, value, next);
        }
    }
    return verified::lean_output::byte(view.output,
        view.capacity, next, 10);
}

pub fn emit_surface(tree: ir::body_tree::Tree,
    types: ir::type_catalog::Table, names: ir::symbol_catalog::Catalog,
    function_lookup: ir::function_catalog::Index,
    function_index: i32, output: [i32], capacity: i32,
    position: i32) -> i32 {
    if (!verified::lean_body_shape::surface_supported(tree)
        || function_index < 0 || function_index >= names.function_count) {
        return -1;
    }
    let functions: [ir::symbol_catalog::Ref] = names.functions;
    let memory: ptr = verified::host::alloc(VIEW_BYTES, 8);
    if (memory == 0) { return -1; }
    let views: [View] = slice_from_raw_parts(memory + VIEW_BYTES - 8, 1);
    views[0] = View { tree: tree, types: types, names: names, functions: function_lookup,
        function_index: function_index, unit: functions[function_index].unit,
        output: output, capacity: capacity };
    return surface_statement_output(views, 0, 4, position);
}
