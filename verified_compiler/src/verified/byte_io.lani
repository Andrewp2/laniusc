module verified::byte_io;
import verified::host;
const PACKED_IO_WORDS: i32 = 16384; // Bridge byte-oriented host I/O to the extractor's i32-per-byte buffers.
// Native `[i32]` storage has a coherent packed four-byte raw view. Callers
// provide one reusable packed scratch buffer so large files and artifacts need
// one host call per chunk rather than one host call per byte.
// Handles remain caller-owned. Return byte count, -1 for I/O failure, -2 for
// capacity or invalid scratch storage.
pub fn read_file(handle: i32, output:[i32], capacity: i32, packed:[i32],) -> i32 {
    if (capacity <= -1) {
        return -2;
    }
    let packed_pointer: ptr = verified::host::i32_slice_data_ptr(packed);
    if (packed_pointer == 0) {
        return -2;
    }
    let total: i32 = 0;
    while (true) {
        let request: i32 = PACKED_IO_WORDS * 4;
        let remaining: i32 = capacity - total;
        if (remaining<request) {
            request = remaining + 1;
        }
        let request_size: usize = request;
        let count: i32 = verified::host::read(handle, packed_pointer, request_size);
        if (count <= -1 || count>request) {
            return -1;
        }
        if (count == 0) {
            return total;
        }
        if (count>remaining) {
            return -2;
        }
        let index: i32 = 0;
        while (index != count) {
            output[total + index] =(packed[index / 4] >>((index % 4) * 8))&255;
            index += 1;
        }
        total += count;
    }
    return total;
}
pub fn write_stdout(input:[i32], length: i32, packed_pointer: ptr,) -> i32 {
    if (length <= -1) {
        return -1;
    }
    if (packed_pointer == 0) {
        return -1;
    }
    let packed:[i32] = verified::host::i32_slice_from_raw_parts(packed_pointer, PACKED_IO_WORDS);
    let total: i32 = 0;
    while (total != length) {
        let chunk_length: i32 = length - total;
        if (chunk_length>PACKED_IO_WORDS * 4) {
            chunk_length = PACKED_IO_WORDS * 4;
        }
        let word_count: i32 =(chunk_length + 3) / 4;
        let word: i32 = 0;
        while (word != word_count) {
            packed[word] = 0;
            word += 1;
        }
        let index: i32 = 0;
        while (index != chunk_length) {
            let value: i32 = input[total + index];
            if (value <= -1 || value >= 256) {
                return -1;
            }
            packed[index / 4] = packed[index / 4]|(value <<((index % 4) * 8));
            index += 1;
        }
        let chunk_size: usize = chunk_length;
        let written: i32 = verified::host::write_stdout(packed_pointer, chunk_size);
        if (written <= 0 || written>chunk_length) {
            return -1;
        }
        total += written;
    }
    return total;
}
// Write the first `length` UTF-8 bytes of a compact string. Native strings
// store four bytes in each little-endian i32 word.
pub fn write_stdout_text(input: str, length: i32) -> i32 {
    if (length <= -1) {
        return -1;
    }
    let words:[i32] = verified::host::i32_slice_from_raw_parts(verified::host::string_data_ptr(input), (length + 3) / 4);
    let total: i32 = 0;
    while (total != length) {
        let value: i32 =(words[total / 4] >>((total % 4) * 8))&255;
        if (verified::host::write_byte(1, value) != 1) {
            return -1;
        }
        total += 1;
    }
    return total;
}
// Write one nonnegative diagnostic integer without allocating or borrowing
// the certificate output buffer. This keeps bootstrap failures observable even
// though Unix process exit statuses retain only eight bits.
pub fn write_stderr_natural(value: i32) -> i32 {
    if (value <= -1) {
        return -1;
    }
    let divisor: i32 = 1;
    while (value / divisor >= 10) {
        divisor *= 10;
    }
    let written: i32 = 0;
    while (divisor != 0) {
        if (verified::host::write_byte(2, 48 +(value / divisor) % 10) != 1) {
            return -1;
        }
        written += 1;
        divisor /= 10;
    }
    if (verified::host::write_byte(2, 10) != 1) {
        return -1;
    }
    return written + 1;
}
