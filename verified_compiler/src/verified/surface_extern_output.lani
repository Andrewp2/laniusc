module verified::surface_extern_output;
import verified::output;
import verified::surface_tree;
import verified::surface_atoms;
import verified::surface_function_output;
import verified::surface_type;
import verified::surface_type_output;
import verified::parser;

pub fn emit(source:[i32], source_length: i32, tokens:[i32], token_count: i32,
    records:[i32], records_length: i32, offsets:[i32], node_count: i32,
    node: i32, is_public: bool, type_arena:[i32],
    type_arena_length: i32, depth: i32, first_id: i32, output:[i32],
    capacity: i32, position: i32) -> verified::surface_function_output::EmitResult {
    let failed = verified::surface_function_output::EmitResult {
        position: -1, next_id: first_id };
    if (first_id <= -1 || depth <= 0) { return failed; }
    let offset: i32 = verified::surface_tree::record(records, records_length,
        offsets, node_count, node);
    if (offset <= -1 || records[offset] != 15) { return failed; }
    let generic_node: i32 = verified::surface_tree::child(records,
        records_length, offsets, node_count, node, 4,
        verified::parser::CHILD_STATE, 0);
    let generic_offset: i32 = verified::surface_tree::record(records,
        records_length, offsets, node_count, generic_node);
    let where_node: i32 = verified::surface_tree::child(records,
        records_length, offsets, node_count, node, 9,
        verified::parser::CHILD_STATE, 0);
    let where_offset: i32 = verified::surface_tree::record(records,
        records_length, offsets, node_count, where_node);
    if (generic_offset <= -1 || records[generic_offset] != 232
        || where_offset <= -1 || records[where_offset] != 36) { return failed; }

    let name_start: [i32; 10] = [123,32,110,97,109,101,32,58,61,32];
    let public_start: [i32; 15] = [44,32,105,115,95,112,117,98,108,105,99,32,58,61,32];
    let abi_start: [i32; 9] = [44,32,97,98,105,32,58,61,32];
    let parameters_start: [i32; 16] = [44,32,112,97,114,97,109,101,116,101,114,115,32,58,61,32];
    let return_start: [i32; 17] = [44,32,114,101,116,117,114,110,95,116,121,112,101,32,58,61,32];
    let record_end: [i32; 2] = [32,125];
    let yes: [i32; 4] = [116,114,117,101];
    let no: [i32; 5] = [102,97,108,115,101];
    let none: [i32; 4] = [110,111,110,101];
    let some: [i32; 5] = [115,111,109,101,32];

    let next: i32 = verified::output::bytes(output, capacity, position,
        name_start, 10);
    let name_token: i32 = verified::surface_tree::child(records,
        records_length, offsets, node_count, node, 3,
        verified::parser::CHILD_TOKEN, token_count);
    next = verified::surface_atoms::name(source, source_length, tokens,
        token_count, name_token, output, capacity, next);
    next = verified::output::bytes(output, capacity, next, public_start, 15);
    if (is_public) { next = verified::output::bytes(output, capacity, next, yes, 4); }
    else { next = verified::output::bytes(output, capacity, next, no, 5); }
    next = verified::output::bytes(output, capacity, next, abi_start, 9);
    let abi_node: i32 = verified::surface_tree::child(records,
        records_length, offsets, node_count, node, 1,
        verified::parser::CHILD_STATE, 0);
    let abi_offset: i32 = verified::surface_tree::record(records,
        records_length, offsets, node_count, abi_node);
    if (abi_offset <= -1) { return failed; }
    if (records[abi_offset] == 32) {
        next = verified::output::bytes(output, capacity, next, some, 5);
        let abi_token: i32 = verified::surface_tree::child(records,
            records_length, offsets, node_count, abi_node, 0,
            verified::parser::CHILD_TOKEN, token_count);
        next = verified::surface_atoms::name(source, source_length, tokens,
            token_count, abi_token, output, capacity, next);
    } else {
        if (records[abi_offset] != 33) { return failed; }
        next = verified::output::bytes(output, capacity, next, none, 4);
    }
    next = verified::output::bytes(output, capacity, next,
        parameters_start, 16);
    let current = verified::surface_function_output::emit_parameters(source,
        source_length, tokens, token_count, records, records_length, offsets,
        node_count, verified::surface_tree::child(records, records_length,
            offsets, node_count, node, 6, verified::parser::CHILD_STATE, 0),
        type_arena, type_arena_length, depth - 1, output, capacity,
        verified::surface_function_output::EmitResult {
            position: next, next_id: first_id });
    if (verified::surface_function_output::emit_position(current) <= -1) {
        return current;
    }
    next = verified::output::bytes(output, capacity,
        verified::surface_function_output::emit_position(current),
        return_start, 17);
    let return_node: i32 = verified::surface_tree::child(records,
        records_length, offsets, node_count, node, 8,
        verified::parser::CHILD_STATE, 0);
    let return_offset: i32 = verified::surface_tree::record(records,
        records_length, offsets, node_count, return_node);
    if (return_offset <= -1) { return failed; }
    let final_id: i32 = verified::surface_function_output::emit_next_id(current);
    if (records[return_offset] == 34) {
        let option_some: [i32; 6] = [40,115,111,109,101,32];
        next = verified::output::bytes(output, capacity, next, option_some, 6);
        let type_node: i32 = verified::surface_tree::child(records,
            records_length, offsets, node_count, return_node, 1,
            verified::parser::CHILD_STATE, 0);
        let root: i32 = verified::surface_type::extract(records,
            records_length, offsets, node_count, token_count, type_node,
            type_arena, type_arena_length, depth - 1);
        if (root <= -1 || type_arena[0] <= 0
            || type_arena[0] > 2147483647 - final_id) { return failed; }
        next = verified::surface_type_output::emit(source, source_length,
            tokens, token_count, type_arena, type_arena_length, root,
            final_id, output, capacity, next);
        next = verified::output::byte(output, capacity, next, 41);
        final_id += type_arena[0];
    } else {
        if (records[return_offset] != 35) { return failed; }
        next = verified::output::bytes(output, capacity, next, none, 4);
    }
    next = verified::output::bytes(output, capacity, next, record_end, 2);
    if (next <= -1) {
        return verified::surface_function_output::EmitResult { position: -1,
            next_id: final_id };
    }
    return verified::surface_function_output::EmitResult { position: next,
        next_id: final_id };
}
