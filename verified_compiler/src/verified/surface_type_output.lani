module verified::surface_type_output;
import verified::output;
import verified::surface_atoms;

fn reference(index: i32, output:[i32], capacity: i32, position: i32) -> i32 {
    let next: i32 = verified::output::byte(output, capacity, position, 116);
    return verified::output::natural(output, capacity, next, index);
}

fn references(arena:[i32], count: i32, first: i32, required_kind: i32,
    output:[i32], capacity: i32, position: i32) -> i32 {
    let next: i32 = verified::output::byte(output, capacity, position, 91);
    let current: i32 = first;
    while (current != -1) {
        if (current <= -1 || current >= count) { return -1; }
        let slot: i32 = 1 + current * 8;
        if (required_kind >= 0 && arena[slot] != required_kind) { return -1; }
        if (required_kind == -2 && arena[slot] <= 1) { return -1; }
        if (current != first) { next = verified::output::byte(output, capacity, next, 44); }
        next = reference(current, output, capacity, next);
        let following: i32 = arena[slot + 7];
        if (following != -1 && following <= current) { return -1; }
        current = following;
    }
    return verified::output::byte(output, capacity, next, 93);
}

// Emit let-bound nodes in arena/Surface-ID order and return one SurfaceTypeExpr.
pub fn emit(source:[i32], source_length: i32, tokens:[i32], token_count: i32,
    arena:[i32], arena_length: i32, root: i32, first_id: i32,
    output:[i32], capacity: i32, position: i32) -> i32 {
    if (arena_length <= 0 || first_id <= -1) { return -1; }
    let count: i32 = arena[0];
    if (count <= 0 || !(count <= (arena_length - 1) / 8) || root <= -1
        || root >= count || !(count <= 2147483647 - first_id)) { return -1; }
    let binding: str = "let t";
    let segment_type: str = " : Lanius.Extraction.SurfacePathSegment := ";
    let path_type: str = " : Lanius.Extraction.SurfacePath := ";
    let type_type: str = " : Lanius.Extraction.SurfaceTypeExpr := ";
    let segments: str = ", { segments := ";
    let structure_end: str = " }";
    let path_value: str = ", .path ";
    let array_value: str = ", .array ";
    let slice_value: str = ", .slice ";
    let reference_value: str = ", .reference ";
    let literal_length: str = "(.literal ";
    let parameter_length: str = "(.parameter ";
    let opening: str = "⟨";
    let closing: str = "⟩";
    let next: i32 = verified::output::byte(output, capacity, position, 40);
    let index: i32 = 0;
    while (index != count) {
        let slot: i32 = 1 + index * 8;
        let kind: i32 = arena[slot];
        next = verified::output::text(output, capacity, next, binding, 5);
        next = verified::output::natural(output, capacity, next, index);
        if (kind == 0) { next = verified::output::text(output, capacity, next, segment_type, 43); }
        else {
            if (kind == 1) { next = verified::output::text(output, capacity, next, path_type, 36); }
            else { next = verified::output::text(output, capacity, next, type_type, 40); }
        }
        next = verified::output::text(output, capacity, next, opening, 3);
        next = verified::output::natural(output, capacity, next, first_id + index);
        next = verified::output::byte(output, capacity, next, 44);
        next = verified::output::natural(output, capacity, next, arena[slot + 1]);
        if (kind == 0) {
            next = verified::output::byte(output, capacity, next, 44);
            next = verified::surface_atoms::name(source, source_length, tokens,
                token_count, arena[slot + 4], output, capacity, next);
            next = verified::output::byte(output, capacity, next, 44);
            next = references(arena, index, arena[slot + 2], -2,
                output, capacity, next);
        } else {
        if (kind == 1) {
            next = verified::output::text(output, capacity, next, segments, 16);
            next = references(arena, index, arena[slot + 2], 0,
                output, capacity, next);
            next = verified::output::text(output, capacity, next, structure_end, 2);
        } else {
            let child: i32 = arena[slot + 2];
            if (child <= -1 || child >= index) { return -1; }
            if (kind == 2) {
                if (arena[1 + child * 8] != 1) { return -1; }
                next = verified::output::text(output, capacity, next, path_value, 8);
                next = reference(child, output, capacity, next);
            } else {
            if (kind == 3) {
                next = verified::output::text(output, capacity, next, array_value, 9);
                next = reference(child, output, capacity, next);
                next = verified::output::byte(output, capacity, next, 32);
                if (arena[slot + 3] == 0) {
                    next = verified::output::text(output, capacity, next, literal_length, 10);
                    next = verified::output::natural(output, capacity, next, arena[slot + 4]);
                    next = verified::output::byte(output, capacity, next, 32);
                    next = verified::surface_atoms::token_text(source, source_length,
                        tokens, token_count, arena[slot + 4], output, capacity, next);
                } else {
                    if (arena[slot + 3] != 1) { return -1; }
                    next = verified::output::text(output, capacity, next, parameter_length, 12);
                    next = verified::surface_atoms::name(source, source_length,
                        tokens, token_count, arena[slot + 4], output, capacity, next);
                }
                next = verified::output::byte(output, capacity, next, 41);
            } else {
                if (kind == 4) { next = verified::output::text(output, capacity, next, slice_value, 9); }
                else {
                    if (kind != 5) { return -1; }
                    next = verified::output::text(output, capacity, next, reference_value, 13);
                }
                next = reference(child, output, capacity, next);
            }
            }
        }
        }
        next = verified::output::text(output, capacity, next, closing, 3);
        next = verified::output::byte(output, capacity, next, 59);
        next = verified::output::byte(output, capacity, next, 32);
        if (next <= -1) { return -1; }
        index += 1;
    }
    if (arena[1 + root * 8] <= 1) { return -1; }
    next = reference(root, output, capacity, next);
    return verified::output::byte(output, capacity, next, 41);
}
