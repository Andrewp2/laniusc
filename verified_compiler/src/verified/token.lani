module verified::token;

// These stable tags deliberately match the production GPU compiler's
// generated token IDs. Parser-context retags live outside the raw lexer.
pub type TokenKind = i32;

pub const IDENTIFIER: TokenKind = 1;
pub const INTEGER: TokenKind = 2;
pub const WHITESPACE: TokenKind = 3;
pub const LEFT_PAREN: TokenKind = 4;
pub const RIGHT_PAREN: TokenKind = 5;
pub const PLUS: TokenKind = 6;
pub const STAR: TokenKind = 7;
pub const ASSIGN: TokenKind = 8;
pub const SLASH: TokenKind = 9;
pub const LINE_COMMENT: TokenKind = 10;
pub const BLOCK_COMMENT: TokenKind = 11;
pub const LESS: TokenKind = 12;
pub const GREATER: TokenKind = 13;
pub const LESS_EQUAL: TokenKind = 14;
pub const GREATER_EQUAL: TokenKind = 15;
pub const EQUAL: TokenKind = 16;
pub const LOGICAL_AND: TokenKind = 17;
pub const LOGICAL_OR: TokenKind = 18;
pub const NOT: TokenKind = 19;
pub const LEFT_BRACKET: TokenKind = 20;
pub const RIGHT_BRACKET: TokenKind = 21;
pub const LEFT_BRACE: TokenKind = 22;
pub const RIGHT_BRACE: TokenKind = 23;
pub const ANGLE_GENERIC: TokenKind = 24;
pub const AMPERSAND: TokenKind = 25;
pub const PIPE: TokenKind = 26;
pub const MINUS: TokenKind = 27;
pub const STRING: TokenKind = 32;
pub const FLOAT: TokenKind = 33;
pub const CHARACTER: TokenKind = 34;
pub const DOT: TokenKind = 35;
pub const COMMA: TokenKind = 36;
pub const SEMICOLON: TokenKind = 37;
pub const COLON: TokenKind = 38;
pub const QUESTION: TokenKind = 39;
pub const NOT_EQUAL: TokenKind = 40;
pub const PERCENT: TokenKind = 41;
pub const CARET: TokenKind = 42;
pub const SHIFT_LEFT: TokenKind = 43;
pub const SHIFT_RIGHT: TokenKind = 44;
pub const TILDE: TokenKind = 45;
pub const PLUS_ASSIGN: TokenKind = 46;
pub const MINUS_ASSIGN: TokenKind = 47;
pub const STAR_ASSIGN: TokenKind = 48;
pub const SLASH_ASSIGN: TokenKind = 49;
pub const PERCENT_ASSIGN: TokenKind = 50;
pub const CARET_ASSIGN: TokenKind = 51;
pub const SHIFT_LEFT_ASSIGN: TokenKind = 52;
pub const SHIFT_RIGHT_ASSIGN: TokenKind = 53;
pub const AMPERSAND_ASSIGN: TokenKind = 54;
pub const PIPE_ASSIGN: TokenKind = 55;
pub const INCREMENT: TokenKind = 56;
pub const DECREMENT: TokenKind = 57;
pub const PUB: TokenKind = 66;
pub const FN: TokenKind = 67;
pub const LET: TokenKind = 68;
pub const RETURN: TokenKind = 69;
pub const IF: TokenKind = 70;
pub const ELSE: TokenKind = 71;
pub const WHILE: TokenKind = 72;
pub const BREAK: TokenKind = 73;
pub const CONTINUE: TokenKind = 74;
pub const ARROW: TokenKind = 75;
pub const TRUE: TokenKind = 90;
pub const FALSE: TokenKind = 91;
pub const CONST: TokenKind = 92;
pub const ENUM: TokenKind = 93;
pub const STRUCT: TokenKind = 94;
pub const MATCH: TokenKind = 95;
pub const IMPORT: TokenKind = 96;
pub const MODULE: TokenKind = 97;
pub const IMPL: TokenKind = 98;
pub const TRAIT: TokenKind = 99;
pub const FOR: TokenKind = 100;
pub const IN: TokenKind = 101;
pub const EXTERN: TokenKind = 102;
pub const TYPE: TokenKind = 103;
pub const WHERE: TokenKind = 104;
pub const SELF_VALUE: TokenKind = 105;
pub const MATCH_ARROW: TokenKind = 113;
pub const DOT_DOT: TokenKind = 182;
