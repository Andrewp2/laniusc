module verified::token;

pub const ROW_WORDS: i32 = 3;
pub const TOKEN_WORD_CAPACITY: i32 = 65536;
pub const KIND_FIELD: i32 = 0;
pub const START_FIELD: i32 = 1;
pub const END_FIELD: i32 = 2;

// Canonical token triples are a frontend interchange format. Lowering keeps
// native records so token identity and spans are read by field, not by packed
// word offsets. The encoded kind is retained at this boundary because its
// stable parser code is distinct from the native enum discriminant.
const NATIVE_FIELD_BYTES: i32 = 8;
pub const RECORD_BYTES: i32 = 3 * NATIVE_FIELD_BYTES;
pub const ALIGNMENT: i32 = NATIVE_FIELD_BYTES;

pub struct TokenRow {
    kind: i32,
    start: i32,
    finish: i32,
}

pub struct TokenTable {
    data: [TokenRow],
    count: i32,
    storage: ptr,
}

pub fn from_raw_parts(storage: ptr, count: i32) -> TokenTable {
    let first: ptr = storage;
    if (count > 0) {
        first = storage + count * RECORD_BYTES - NATIVE_FIELD_BYTES;
    }
    return TokenTable {
        data: slice_from_raw_parts(first, count),
        count: count,
        storage: storage,
    };
}

pub fn subtable(table: TokenTable, offset: i32, count: i32) -> TokenTable {
    let storage: ptr = table.storage;
    if (offset < 0 || count < 0 || offset > table.count
        || count > table.count - offset) {
        return from_raw_parts(storage, 0);
    }
    let first: ptr = storage
        + (table.count - offset - count) * RECORD_BYTES;
    return from_raw_parts(first, count);
}

pub fn decode_packed(input: [i32], input_words: i32, count: i32,
    output: TokenTable, offset: i32) -> bool {
    if (input_words < 0 || count < 0 || offset < 0
        || offset > output.count
        || count > output.count - offset
        || count > input_words / ROW_WORDS) { return false; }
    let rows: [TokenRow] = output.data;
    let index: i32 = 0;
    while (index < count) {
        let word: i32 = index * ROW_WORDS;
        rows[offset + index] = TokenRow {
            kind: input[word + KIND_FIELD],
            start: input[word + START_FIELD],
            finish: input[word + END_FIELD],
        };
        index += 1;
    }
    return true;
}

// Token kinds are semantic values inside the lexer. Their stable integer IDs
// exist only where token rows cross the generated-parser boundary.
pub enum TokenKind {
    Identifier,
    Integer,
    Whitespace,
    LeftParen,
    RightParen,
    Plus,
    Star,
    Assign,
    Slash,
    LineComment,
    BlockComment,
    Less,
    Greater,
    LessEqual,
    GreaterEqual,
    Equal,
    LogicalAnd,
    LogicalOr,
    Not,
    LeftBracket,
    RightBracket,
    LeftBrace,
    RightBrace,
    AngleGeneric,
    Ampersand,
    Pipe,
    Minus,
    StringLiteral,
    FloatLiteral,
    CharacterLiteral,
    Dot,
    Comma,
    Semicolon,
    Colon,
    Question,
    NotEqual,
    Percent,
    Caret,
    ShiftLeft,
    ShiftRight,
    Tilde,
    PlusAssign,
    MinusAssign,
    StarAssign,
    SlashAssign,
    PercentAssign,
    CaretAssign,
    ShiftLeftAssign,
    ShiftRightAssign,
    AmpersandAssign,
    PipeAssign,
    Increment,
    Decrement,
    PubKeyword,
    FnKeyword,
    LetKeyword,
    ReturnKeyword,
    IfKeyword,
    ElseKeyword,
    WhileKeyword,
    BreakKeyword,
    ContinueKeyword,
    Arrow,
    TrueKeyword,
    FalseKeyword,
    ConstKeyword,
    EnumKeyword,
    StructKeyword,
    MatchKeyword,
    ImportKeyword,
    ModuleKeyword,
    ImplKeyword,
    TraitKeyword,
    ForKeyword,
    InKeyword,
    ExternKeyword,
    TypeKeyword,
    WhereKeyword,
    SelfValueKeyword,
    MatchArrow,
    DotDot,
    DotDotEqual,
}

pub fn kind_code(kind: TokenKind) -> i32 {
    return match (kind) {
        Identifier -> 1,
        Integer -> 2,
        Whitespace -> 3,
        LeftParen -> 4,
        RightParen -> 5,
        Plus -> 6,
        Star -> 7,
        Assign -> 8,
        Slash -> 9,
        LineComment -> 10,
        BlockComment -> 11,
        Less -> 12,
        Greater -> 13,
        LessEqual -> 14,
        GreaterEqual -> 15,
        Equal -> 16,
        LogicalAnd -> 17,
        LogicalOr -> 18,
        Not -> 19,
        LeftBracket -> 20,
        RightBracket -> 21,
        LeftBrace -> 22,
        RightBrace -> 23,
        AngleGeneric -> 24,
        Ampersand -> 25,
        Pipe -> 26,
        Minus -> 27,
        StringLiteral -> 32,
        FloatLiteral -> 33,
        CharacterLiteral -> 34,
        Dot -> 35,
        Comma -> 36,
        Semicolon -> 37,
        Colon -> 38,
        Question -> 39,
        NotEqual -> 40,
        Percent -> 41,
        Caret -> 42,
        ShiftLeft -> 43,
        ShiftRight -> 44,
        Tilde -> 45,
        PlusAssign -> 46,
        MinusAssign -> 47,
        StarAssign -> 48,
        SlashAssign -> 49,
        PercentAssign -> 50,
        CaretAssign -> 51,
        ShiftLeftAssign -> 52,
        ShiftRightAssign -> 53,
        AmpersandAssign -> 54,
        PipeAssign -> 55,
        Increment -> 56,
        Decrement -> 57,
        PubKeyword -> 66,
        FnKeyword -> 67,
        LetKeyword -> 68,
        ReturnKeyword -> 69,
        IfKeyword -> 70,
        ElseKeyword -> 71,
        WhileKeyword -> 72,
        BreakKeyword -> 73,
        ContinueKeyword -> 74,
        Arrow -> 75,
        TrueKeyword -> 90,
        FalseKeyword -> 91,
        ConstKeyword -> 92,
        EnumKeyword -> 93,
        StructKeyword -> 94,
        MatchKeyword -> 95,
        ImportKeyword -> 96,
        ModuleKeyword -> 97,
        ImplKeyword -> 98,
        TraitKeyword -> 99,
        ForKeyword -> 100,
        InKeyword -> 101,
        ExternKeyword -> 102,
        TypeKeyword -> 103,
        WhereKeyword -> 104,
        SelfValueKeyword -> 105,
        MatchArrow -> 113,
        DotDot -> 182,
        DotDotEqual -> 189,
    };
}

pub fn kind_is(encoded: i32, expected: TokenKind) -> bool {
    return encoded == kind_code(expected);
}

// The GPU frontend accepts `->` as a match-arm arrow as well as `=>`.
// The grammar decides when Arrow may carry MatchArrow semantics, so this
// alias does not turn `=>` into a function return arrow.
pub fn raw_matches_canonical(raw_kind: i32, canonical_kind: i32) -> bool {
    return raw_kind == canonical_kind
        || (kind_is(raw_kind, Arrow)
            && kind_is(canonical_kind, MatchArrow));
}
