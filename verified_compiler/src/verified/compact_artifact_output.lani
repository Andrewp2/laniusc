module verified::compact_artifact_output;
import verified::output;
import verified::parser;
import verified::token;
import verified::semantic_tokens;

const FORMAT_VERSION: i32 = 1;

pub struct WordRegion {
    data: [i32],
    length: i32,
}

pub struct TokenRows {
    data: [i32],
    length: i32,
    count: i32,
}

pub struct ArtifactUnit {
    path: WordRegion,
    source: WordRegion,
    raw_tokens: TokenRows,
    canonical_tokens: TokenRows,
    semantic_kinds: verified::semantic_tokens::AssignmentBuffer,
    parse_records: WordRegion,
    node_offsets: [i32],
    node_count: i32,
}

struct ParseRows {
    records: WordRegion,
    parse_node_offsets: [i32],
    count: i32,
    token_count: i32,
}

fn bytes(input: WordRegion, destination: verified::output::Cursor) -> i32 {
    let data: [i32] = input.data;
    let length: i32 = input.length;
    if (length <= -1) {
        return -1;
    }
    let next: i32 = destination.position;
    let index: i32 = 0;
    while (index != length) {
        next = verified::output::hex_byte(verified::output::cursor(destination.data,
            destination.capacity, next), data[index]);
        if (next <= -1) {
            return -1;
        }
        index += 1;
    }
    return next;
}
fn tokens(rows: TokenRows, source_length: i32,
    destination: verified::output::Cursor) -> i32 {
    let data: [i32] = rows.data;
    if (rows.count <= -1
        || !(rows.count <= rows.length / verified::token::ROW_WORDS)) {
        return -1;
    }
    let next: i32 = destination.position;
    let token: i32 = 0;
    while (token != rows.count) {
        let row: i32 = token * verified::token::ROW_WORDS;
        let start: i32 = data[row + verified::token::START_FIELD];
        let finish: i32 = data[row + verified::token::END_FIELD];
        if (data[row + verified::token::KIND_FIELD] <= -1 || start <= -1
            || !(start <= finish) || !(finish <= source_length)) {
            return -1;
        }
        next = verified::output::hex_natural_word(verified::output::cursor(destination.data,
            destination.capacity, next),
            data[row + verified::token::KIND_FIELD]);
        next = verified::output::hex_natural_word(verified::output::cursor(destination.data,
            destination.capacity, next), start);
        next = verified::output::hex_natural_word(verified::output::cursor(destination.data,
            destination.capacity, next), finish);
        if (next <= -1) {
            return -1;
        }
        token += 1;
    }
    return next;
}
fn semantic(assignments: verified::semantic_tokens::AssignmentBuffer,
    count: i32,
    destination: verified::output::Cursor) -> i32 {
    let data: [verified::semantic_tokens::Assignment] = assignments.data;
    if (count <= -1 || count > assignments.capacity) {
        return -1;
    }
    let next: i32 = destination.position;
    let token: i32 = 0;
    while (token != count) {
        let first: i32 = data[token].inner;
        let second: i32 = data[token].outer;
        if (first <= -1
            || first >= verified::semantic_tokens::SEMANTIC_KIND_RADIX
            || second <= -2
            || second >= verified::semantic_tokens::SEMANTIC_KIND_RADIX) {
            return -1;
        }
        next = verified::output::hex_natural_word(verified::output::cursor(destination.data,
            destination.capacity, next), first);
        next = verified::output::hex_natural_word(verified::output::cursor(destination.data,
            destination.capacity, next), second + 1);
        if (next <= -1) {
            return -1;
        }
        token += 1;
    }
    return next;
}
fn nodes(input: ParseRows, destination: verified::output::Cursor) -> i32 {
    let records: [i32] = input.records.data;
    let offsets: [i32] = input.parse_node_offsets;
    if (input.count <= -1 || input.token_count <= -1) {
        return -1;
    }
    let next: i32 = destination.position;
    let node: i32 = 0;
    while (node != input.count) {
        let record: i32 = offsets[node];
        if (record <= -1 || !(record <= input.records.length)
            || !(verified::parser::DERIVATION_HEADER_WORDS
                <= input.records.length - record)) {
            return -1;
        }
        let production: i32 = records[record
            + verified::parser::DERIVATION_PRODUCTION_FIELD];
        let children: i32 = records[record
            + verified::parser::DERIVATION_CHILD_COUNT_FIELD];
        if (production <= -1 || children <= -1
            || !(children <= (input.records.length - record
                    - verified::parser::DERIVATION_HEADER_WORDS)
                / verified::parser::DERIVATION_CHILD_WORDS)) {
            return -1;
        }
        next = verified::output::hex_natural_word(verified::output::cursor(destination.data,
            destination.capacity, next), production);
        next = verified::output::hex_natural_word(verified::output::cursor(destination.data,
            destination.capacity, next), records[record
                + verified::parser::DERIVATION_ORIGIN_FIELD]);
        next = verified::output::hex_natural_word(verified::output::cursor(destination.data,
            destination.capacity, next), records[record
                + verified::parser::DERIVATION_END_FIELD]);
        next = verified::output::hex_natural_word(verified::output::cursor(destination.data,
            destination.capacity, next), children);
        if (next <= -1) {
            return -1;
        }
        let child: i32 = 0;
        while (child != children) {
            let slot: i32 = record + verified::parser::DERIVATION_HEADER_WORDS
                + child * verified::parser::DERIVATION_CHILD_WORDS;
            let tag: i32 = records[slot
                + verified::parser::DERIVATION_CHILD_TAG_FIELD];
            let payload: i32 = records[slot
                + verified::parser::DERIVATION_CHILD_PAYLOAD_FIELD];
            if (payload <= -1) {
                return -1;
            }
            if (tag == verified::parser::child_code(verified::parser::TokenChild)) {
                if (payload >= input.token_count) {
                    return -1;
                }
            } else {
                if (tag != verified::parser::child_code(verified::parser::StateChild) || payload >= node) {
                    return -1;
                }
            }
            next = verified::output::hex_natural_word(verified::output::cursor(destination.data,
                destination.capacity, next), tag);
            next = verified::output::hex_natural_word(verified::output::cursor(destination.data,
                destination.capacity, next), payload);
            if (next <= -1) {
                return -1;
            }
            child += 1;
        }
        node += 1;
    }
    return next;
}
pub fn emit_header(unit_count: i32,
    destination: verified::output::Cursor) -> i32 {
    let next: i32 = verified::output::hex_natural_word(destination, FORMAT_VERSION);
    return verified::output::hex_natural_word(verified::output::cursor(destination.data,
        destination.capacity, next), unit_count);
}
pub fn emit_unit(unit: ArtifactUnit,
    destination: verified::output::Cursor) -> i32 {
    if (unit.path.length <= -1 || unit.source.length <= -1
        || unit.node_count <= 0) {
        return -1;
    }
    let next: i32 = verified::output::hex_natural_word(destination, unit.path.length);
    next = bytes(unit.path, verified::output::cursor(destination.data,
        destination.capacity, next));
    next = verified::output::hex_natural_word(verified::output::cursor(destination.data,
        destination.capacity, next), unit.source.length);
    next = bytes(unit.source, verified::output::cursor(destination.data,
        destination.capacity, next));
    next = verified::output::hex_natural_word(verified::output::cursor(destination.data,
        destination.capacity, next), unit.raw_tokens.count);
    next = tokens(unit.raw_tokens, unit.source.length,
        verified::output::cursor(destination.data, destination.capacity, next));
    next = verified::output::hex_natural_word(verified::output::cursor(destination.data,
        destination.capacity, next), unit.canonical_tokens.count);
    next = tokens(unit.canonical_tokens, unit.source.length,
        verified::output::cursor(destination.data, destination.capacity, next));
    next = semantic(unit.semantic_kinds, unit.canonical_tokens.count,
        verified::output::cursor(destination.data, destination.capacity, next));
    next = verified::output::hex_natural_word(verified::output::cursor(destination.data,
        destination.capacity, next), unit.node_count);
    let parse_rows: ParseRows = ParseRows {
        records: unit.parse_records,
        parse_node_offsets: unit.node_offsets,
        count: unit.node_count,
        token_count: unit.canonical_tokens.count,
    };
    return nodes(parse_rows, verified::output::cursor(destination.data,
        destination.capacity, next));
}
