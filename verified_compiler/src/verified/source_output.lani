module verified::source_output;

import verified::output;
import verified::ascii;
import verified::host;
import verified::token;

pub struct ByteRegion {
    data: [i32],
    length: i32,
}

pub struct TokenRows {
    data: [i32],
    length: i32,
    count: i32,
    source_length: i32,
    file_id: i32,
}

// Emit an exact List Nat representation of the input bytes. No UTF-8
// decoding or newline normalization is performed on the source itself.
pub fn emit_bytes(source: ByteRegion, destination: verified::output::Cursor) -> i32 {
    let output: [i32] = destination.data;
    let capacity: i32 = destination.capacity;
    let position: i32 = destination.position;
    let source_length: i32 = source.length;
    if (source_length <= -1) { return -1; }
    let next: i32 = verified::output::byte(
        output, capacity, position, verified::ascii::LEFT_BRACKET);
    let index: i32 = 0;
    while (index != source_length) {
        let value: i32 = source.data[index];
        if (value <= -1 || value > verified::host::BYTE_MASK) { return -1; }
        if (index != 0) {
            next = verified::output::byte(
                output, capacity, next, verified::ascii::COMMA);
        }
        next = verified::output::natural(output, capacity, next, value);
        if (next == -1) { return -1; }
        index += 1;
    }
    return verified::output::byte(
        output, capacity, next, verified::ascii::RIGHT_BRACKET);
}

// Emit List Lanius.Extraction.Token for either raw or canonical rows.
// Span bounds are checked here; lexical correctness remains the lexer's
// responsibility and is not established by serialization.
pub fn emit_tokens(rows: TokenRows,
    destination: verified::output::Cursor) -> i32 {
    let output: [i32] = destination.data;
    let data: [i32] = rows.data;
    let capacity: i32 = destination.capacity;
    let position: i32 = destination.position;
    let rows_length: i32 = rows.length;
    let token_count: i32 = rows.count;
    let source_length: i32 = rows.source_length;
    let file_id: i32 = rows.file_id;
    if (rows_length <= -1 || token_count <= -1 || source_length <= -1
        || file_id <= -1 || !(token_count <= rows_length
            / verified::token::ROW_WORDS)) { return -1; }
    let opening: str = "⟨";
    let closing: str = "⟩";
    let next: i32 = verified::output::byte(
        output, capacity, position, verified::ascii::LEFT_BRACKET);
    let token: i32 = 0;
    while (token != token_count) {
        let row: i32 = token * verified::token::ROW_WORDS;
        let start: i32 = data[row + verified::token::START_FIELD];
        let finish: i32 = data[row + verified::token::END_FIELD];
        if (start <= -1 || !(start <= finish) || !(finish <= source_length)) { return -1; }
        if (token != 0) {
            next = verified::output::byte(
                output, capacity, next, verified::ascii::COMMA);
        }
        next = verified::output::text(output, capacity, next, opening, 3);
        next = verified::output::natural(output, capacity, next,
            data[row + verified::token::KIND_FIELD]);
        next = verified::output::byte(
            output, capacity, next, verified::ascii::COMMA);
        next = verified::output::text(output, capacity, next, opening, 3);
        next = verified::output::natural(output, capacity, next, file_id);
        next = verified::output::byte(
            output, capacity, next, verified::ascii::COMMA);
        next = verified::output::natural(output, capacity, next, start);
        next = verified::output::byte(
            output, capacity, next, verified::ascii::COMMA);
        next = verified::output::natural(output, capacity, next, finish);
        next = verified::output::text(output, capacity, next, closing, 3);
        next = verified::output::text(output, capacity, next, closing, 3);
        if (next == -1) { return -1; }
        token += 1;
    }
    return verified::output::byte(
        output, capacity, next, verified::ascii::RIGHT_BRACKET);
}
