module verified::canonical_tokens;

import verified::token;
import verified::host;

pub fn is_trivia(kind: verified::token::TokenKind) -> bool {
    return kind == verified::token::Whitespace
        || kind == verified::token::LineComment
        || kind == verified::token::BlockComment;
}

fn matches_ascii(source: [i32], start: i32, length: i32,
    expected: str) -> bool {
    let words: [i32] = verified::host::i32_slice_from_raw_parts(
        verified::host::string_data_ptr(expected),
        (length + verified::host::I32_BYTES - 1)
            / verified::host::I32_BYTES);
    let index: i32 = 0;
    while (index != length) {
        let byte: i32 = (words[index / verified::host::I32_BYTES]
            >> ((index % verified::host::I32_BYTES)
                * verified::host::BITS_PER_BYTE)) & verified::host::BYTE_MASK;
        if (source[start + index] != byte) { return false; }
        index += 1;
    }
    return true;
}

// Retags an identifier span only when its complete spelling is a keyword.
// Length dispatch prevents prefix matches such as `letter` becoming `let` and
// limits the number of literal comparisons performed for each identifier.
pub fn keyword_token(
    source: [i32],
    start: i32,
    end: i32,
) -> verified::token::TokenKind {
    let length: i32 = end - start;
    if (length == 2) {
        if (matches_ascii(source, start, length, "fn")) {
            return verified::token::FnKeyword;
        }
        if (matches_ascii(source, start, length, "if")) {
            return verified::token::IfKeyword;
        }
        if (matches_ascii(source, start, length, "in")) {
            return verified::token::InKeyword;
        }
    }
    if (length == 3) {
        if (matches_ascii(source, start, length, "pub")) {
            return verified::token::PubKeyword;
        }
        if (matches_ascii(source, start, length, "let")) {
            return verified::token::LetKeyword;
        }
        if (matches_ascii(source, start, length, "for")) {
            return verified::token::ForKeyword;
        }
    }
    if (length == 4) {
        if (matches_ascii(source, start, length, "else")) {
            return verified::token::ElseKeyword;
        }
        if (matches_ascii(source, start, length, "true")) {
            return verified::token::TrueKeyword;
        }
        if (matches_ascii(source, start, length, "enum")) {
            return verified::token::EnumKeyword;
        }
        if (matches_ascii(source, start, length, "impl")) {
            return verified::token::ImplKeyword;
        }
        if (matches_ascii(source, start, length, "self")) {
            return verified::token::SelfValueKeyword;
        }
        if (matches_ascii(source, start, length, "type")) {
            return verified::token::TypeKeyword;
        }
    }
    if (length == 5) {
        if (matches_ascii(source, start, length, "false")) {
            return verified::token::FalseKeyword;
        }
        if (matches_ascii(source, start, length, "const")) {
            return verified::token::ConstKeyword;
        }
        if (matches_ascii(source, start, length, "match")) {
            return verified::token::MatchKeyword;
        }
        if (matches_ascii(source, start, length, "trait")) {
            return verified::token::TraitKeyword;
        }
        if (matches_ascii(source, start, length, "where")) {
            return verified::token::WhereKeyword;
        }
        if (matches_ascii(source, start, length, "while")) {
            return verified::token::WhileKeyword;
        }
        if (matches_ascii(source, start, length, "break")) {
            return verified::token::BreakKeyword;
        }
    }
    if (length == 6) {
        if (matches_ascii(source, start, length, "return")) {
            return verified::token::ReturnKeyword;
        }
        if (matches_ascii(source, start, length, "struct")) {
            return verified::token::StructKeyword;
        }
        if (matches_ascii(source, start, length, "extern")) {
            return verified::token::ExternKeyword;
        }
        if (matches_ascii(source, start, length, "import")) {
            return verified::token::ImportKeyword;
        }
        if (matches_ascii(source, start, length, "module")) {
            return verified::token::ModuleKeyword;
        }
    }
    if (length == 8) {
        if (matches_ascii(source, start, length, "continue")) {
            return verified::token::ContinueKeyword;
        }
    }
    return verified::token::Identifier;
}

// Each row keeps its kind and span together; only artifact output packs
// the canonical stream into triples.
pub fn canonicalize_rows_in_place(source: [i32],
    table: verified::token::TokenTable, raw_token_count: i32) -> i32 {
    let rows: [verified::token::TokenRow] = table.data;
    let input_index: i32 = 0;
    let output_count: i32 = 0;
    while (input_index < raw_token_count) {
        let row: verified::token::TokenRow = rows[input_index];
        if (!is_trivia(row.kind)) {
            let kind: verified::token::TokenKind = row.kind;
            if (kind == verified::token::Identifier) {
                kind = keyword_token(source, row.start, row.finish);
            }
            rows[output_count] = verified::token::TokenRow {
                kind: kind,
                start: row.start, finish: row.finish,
            };
            output_count += 1;
        }
        input_index += 1;
    }
    let range_index: i32 = 0;
    while (range_index + 1 < output_count) {
        if (rows[range_index].kind == verified::token::DotDot
            && rows[range_index + 1].kind == verified::token::Assign
            && rows[range_index + 1].start
                == rows[range_index].finish) {
            rows[range_index].kind = verified::token::DotDotEqual;
        }
        range_index += 1;
    }
    return output_count;
}
