module verified::canonical_tokens;

import verified::token;

pub fn is_trivia(kind: i32) -> bool {
    return kind == verified::token::WHITESPACE
        || kind == verified::token::LINE_COMMENT
        || kind == verified::token::BLOCK_COMMENT;
}

// Retags an identifier span only when its complete spelling is a keyword.
// Length dispatch prevents prefix matches such as `letter` becoming `let`.
pub fn keyword_kind(
    source: [i32],
    start: i32,
    end: i32,
) -> i32 {
    let length: i32 = end - start;
    if (length == 2) {
        let a: i32 = source[start];
        let b: i32 = source[start + 1];
        if (a == 102 && b == 110) { return verified::token::FN; }
        if (a == 105 && b == 102) { return verified::token::IF; }
        if (a == 105 && b == 110) { return verified::token::IN; }
    }
    if (length == 3) {
        let a: i32 = source[start];
        let b: i32 = source[start + 1];
        let c: i32 = source[start + 2];
        if (a == 112 && b == 117 && c == 98) { return verified::token::PUB; }
        if (a == 108 && b == 101 && c == 116) { return verified::token::LET; }
        if (a == 102 && b == 111 && c == 114) { return verified::token::FOR; }
    }
    if (length == 4) {
        let a: i32 = source[start];
        let b: i32 = source[start + 1];
        let c: i32 = source[start + 2];
        let d: i32 = source[start + 3];
        if (a == 101 && b == 108 && c == 115 && d == 101) {
            return verified::token::ELSE;
        }
        if (a == 116 && b == 114 && c == 117 && d == 101) {
            return verified::token::TRUE;
        }
        if (a == 101 && b == 110 && c == 117 && d == 109) {
            return verified::token::ENUM;
        }
        if (a == 105 && b == 109 && c == 112 && d == 108) {
            return verified::token::IMPL;
        }
        if (a == 115 && b == 101 && c == 108 && d == 102) {
            return verified::token::SELF_VALUE;
        }
        if (a == 116 && b == 121 && c == 112 && d == 101) {
            return verified::token::TYPE;
        }
    }
    if (length == 5) {
        let a: i32 = source[start];
        let b: i32 = source[start + 1];
        let c: i32 = source[start + 2];
        let d: i32 = source[start + 3];
        let e: i32 = source[start + 4];
        if (a == 102 && b == 97 && c == 108 && d == 115 && e == 101) {
            return verified::token::FALSE;
        }
        if (a == 99 && b == 111 && c == 110 && d == 115 && e == 116) {
            return verified::token::CONST;
        }
        if (a == 109 && b == 97 && c == 116 && d == 99 && e == 104) {
            return verified::token::MATCH;
        }
        if (a == 116 && b == 114 && c == 97 && d == 105 && e == 116) {
            return verified::token::TRAIT;
        }
        if (a == 119 && b == 104 && c == 101 && d == 114 && e == 101) {
            return verified::token::WHERE;
        }
        if (a == 119 && b == 104 && c == 105 && d == 108 && e == 101) {
            return verified::token::WHILE;
        }
        if (a == 98 && b == 114 && c == 101 && d == 97 && e == 107) {
            return verified::token::BREAK;
        }
    }
    if (length == 6) {
        let a: i32 = source[start];
        let b: i32 = source[start + 1];
        let c: i32 = source[start + 2];
        let d: i32 = source[start + 3];
        let e: i32 = source[start + 4];
        let f: i32 = source[start + 5];
        if (a == 114 && b == 101 && c == 116 && d == 117 && e == 114 && f == 110) {
            return verified::token::RETURN;
        }
        if (a == 115 && b == 116 && c == 114 && d == 117 && e == 99 && f == 116) {
            return verified::token::STRUCT;
        }
        if (a == 101 && b == 120 && c == 116 && d == 101 && e == 114 && f == 110) {
            return verified::token::EXTERN;
        }
        if (a == 105 && b == 109 && c == 112 && d == 111 && e == 114 && f == 116) {
            return verified::token::IMPORT;
        }
        if (a == 109 && b == 111 && c == 100 && d == 117 && e == 108 && f == 101) {
            return verified::token::MODULE;
        }
    }
    if (length == 8) {
        let a: i32 = source[start];
        let b: i32 = source[start + 1];
        let c: i32 = source[start + 2];
        let d: i32 = source[start + 3];
        let e: i32 = source[start + 4];
        let f: i32 = source[start + 5];
        let g: i32 = source[start + 6];
        let h: i32 = source[start + 7];
        if (a == 99 && b == 111 && c == 110 && d == 116
            && e == 105 && f == 110 && g == 117 && h == 101) {
            return verified::token::CONTINUE;
        }
    }
    return verified::token::IDENTIFIER;
}

pub fn canonical_kind(
    source: [i32],
    raw_kind: i32,
    start: i32,
    end: i32,
) -> i32 {
    if (raw_kind == verified::token::IDENTIFIER) {
        return keyword_kind(source, start, end);
    }
    return raw_kind;
}

// Compacts non-trivia records in place. Each input and output row is
// `{ kind, start, exclusive_end }`; output never overtakes unread input.
pub fn canonicalize_in_place(
    source: [i32],
    records: [i32],
    raw_token_count: i32,
) -> i32 {
    let input_index: i32 = 0;
    let output_count: i32 = 0;
    while (input_index < raw_token_count) {
        let input_row: i32 = input_index * 3;
        let kind: i32 = records[input_row];
        if (!is_trivia(kind)) {
            let start: i32 = records[input_row + 1];
            let end: i32 = records[input_row + 2];
            let output_row: i32 = output_count * 3;
            records[output_row] = canonical_kind(source, kind, start, end);
            records[output_row + 1] = start;
            records[output_row + 2] = end;
            output_count += 1;
        }
        input_index += 1;
    }
    let range_index: i32 = 0;
    while (range_index + 1 < output_count) {
        let current_row: i32 = range_index * 3;
        let next_row: i32 = current_row + 3;
        if (records[current_row] == verified::token::DOT_DOT
            && records[next_row] == verified::token::ASSIGN
            && records[next_row + 1] == records[current_row + 2]) {
            records[current_row] = verified::token::DOT_DOT_EQUAL;
        }
        range_index += 1;
    }
    return output_count;
}
