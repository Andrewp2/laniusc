module verified::canonical_tokens;

import verified::token;
import verified::host;

pub fn is_trivia(kind: i32) -> bool {
    return kind == verified::token::WHITESPACE
        || kind == verified::token::LINE_COMMENT
        || kind == verified::token::BLOCK_COMMENT;
}

// Compare a source-byte span with one compact ASCII string literal. Native
// word loads consume four bytes each. Callers explicitly pad spellings to a
// whole number of words; `length` excludes that padding. Ordinary native
// strings do not promise readable padding beyond their contents. Keeping
// spellings compact avoids a separate expression for every character.
fn matches_ascii(
    source: [i32],
    start: i32,
    spelling: str,
    length: i32,
) -> bool {
    let words: [i32] = verified::host::i32_slice_from_raw_parts(
        verified::host::string_data_ptr(spelling), (length + 3) / 4);
    let index: i32 = 0;
    while (index != length) {
        let expected: i32 =
            (words[index / 4] >> ((index % 4) * 8)) & 255;
        if (source[start + index] != expected) { return false; }
        index += 1;
    }
    return true;
}

// Retags an identifier span only when its complete spelling is a keyword.
// Length dispatch prevents prefix matches such as `letter` becoming `let` and
// limits the number of literal comparisons performed for each identifier.
pub fn keyword_kind(
    source: [i32],
    start: i32,
    end: i32,
) -> i32 {
    let length: i32 = end - start;
    if (length == 2) {
        if (matches_ascii(source, start, "fn\0\0", 2)) { return verified::token::FN; }
        if (matches_ascii(source, start, "if\0\0", 2)) { return verified::token::IF; }
        if (matches_ascii(source, start, "in\0\0", 2)) { return verified::token::IN; }
    }
    if (length == 3) {
        if (matches_ascii(source, start, "pub\0", 3)) { return verified::token::PUB; }
        if (matches_ascii(source, start, "let\0", 3)) { return verified::token::LET; }
        if (matches_ascii(source, start, "for\0", 3)) { return verified::token::FOR; }
    }
    if (length == 4) {
        if (matches_ascii(source, start, "else", 4)) { return verified::token::ELSE; }
        if (matches_ascii(source, start, "true", 4)) { return verified::token::TRUE; }
        if (matches_ascii(source, start, "enum", 4)) { return verified::token::ENUM; }
        if (matches_ascii(source, start, "impl", 4)) { return verified::token::IMPL; }
        if (matches_ascii(source, start, "self", 4)) { return verified::token::SELF_VALUE; }
        if (matches_ascii(source, start, "type", 4)) { return verified::token::TYPE; }
    }
    if (length == 5) {
        if (matches_ascii(source, start, "false\0\0\0", 5)) { return verified::token::FALSE; }
        if (matches_ascii(source, start, "const\0\0\0", 5)) { return verified::token::CONST; }
        if (matches_ascii(source, start, "match\0\0\0", 5)) { return verified::token::MATCH; }
        if (matches_ascii(source, start, "trait\0\0\0", 5)) { return verified::token::TRAIT; }
        if (matches_ascii(source, start, "where\0\0\0", 5)) { return verified::token::WHERE; }
        if (matches_ascii(source, start, "while\0\0\0", 5)) { return verified::token::WHILE; }
        if (matches_ascii(source, start, "break\0\0\0", 5)) { return verified::token::BREAK; }
    }
    if (length == 6) {
        if (matches_ascii(source, start, "return\0\0", 6)) { return verified::token::RETURN; }
        if (matches_ascii(source, start, "struct\0\0", 6)) { return verified::token::STRUCT; }
        if (matches_ascii(source, start, "extern\0\0", 6)) { return verified::token::EXTERN; }
        if (matches_ascii(source, start, "import\0\0", 6)) { return verified::token::IMPORT; }
        if (matches_ascii(source, start, "module\0\0", 6)) { return verified::token::MODULE; }
    }
    if (length == 8) {
        if (matches_ascii(source, start, "continue", 8)) {
            return verified::token::CONTINUE;
        }
    }
    return verified::token::IDENTIFIER;
}

pub fn canonical_kind(
    source: [i32],
    raw_kind: i32,
    start: i32,
    end: i32,
) -> i32 {
    if (raw_kind == verified::token::IDENTIFIER) {
        return keyword_kind(source, start, end);
    }
    return raw_kind;
}

// Compacts non-trivia records in place. Each input and output row is
// `{ kind, start, exclusive_end }`; output never overtakes unread input.
pub fn canonicalize_in_place(
    source: [i32],
    records: [i32],
    raw_token_count: i32,
) -> i32 {
    let input_index: i32 = 0;
    let output_count: i32 = 0;
    while (input_index < raw_token_count) {
        let input_row: i32 = input_index * 3;
        let kind: i32 = records[input_row];
        if (!is_trivia(kind)) {
            let start: i32 = records[input_row + 1];
            let end: i32 = records[input_row + 2];
            let output_row: i32 = output_count * 3;
            records[output_row] = canonical_kind(source, kind, start, end);
            records[output_row + 1] = start;
            records[output_row + 2] = end;
            output_count += 1;
        }
        input_index += 1;
    }
    let range_index: i32 = 0;
    while (range_index + 1 < output_count) {
        let current_row: i32 = range_index * 3;
        let next_row: i32 = current_row + 3;
        if (records[current_row] == verified::token::DOT_DOT
            && records[next_row] == verified::token::ASSIGN
            && records[next_row + 1] == records[current_row + 2]) {
            records[current_row] = verified::token::DOT_DOT_EQUAL;
        }
        range_index += 1;
    }
    return output_count;
}
