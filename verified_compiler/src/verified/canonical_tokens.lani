module verified::canonical_tokens;

import verified::token;

pub fn is_trivia(kind: i32) -> bool {
    return kind == verified::token::WHITESPACE
        || kind == verified::token::LINE_COMMENT
        || kind == verified::token::BLOCK_COMMENT;
}

// Compare a source-byte span with up to two little-endian packed ASCII words.
// The packed values keep keyword dispatch compact while this helper owns the
// byte extraction and avoids spelling each keyword as a numeric chain.
fn matches_ascii(
    source: [i32],
    start: i32,
    length: i32,
    first: i32,
    second: i32,
) -> bool {
    let index: i32 = 0;
    while (index != length) {
        let word: i32 = first;
        if (index >= 4) { word = second; }
        let expected: i32 = (word >> ((index % 4) * 8)) & 255;
        if (source[start + index] != expected) { return false; }
        index += 1;
    }
    return true;
}

// Retags an identifier span only when its complete spelling is a keyword.
// Length dispatch prevents prefix matches such as `letter` becoming `let` and
// limits the number of literal comparisons performed for each identifier.
pub fn keyword_kind(
    source: [i32],
    start: i32,
    end: i32,
) -> i32 {
    let length: i32 = end - start;
    if (length == 2) {
        if (matches_ascii(source, start, 2, 28262, 0)) { return verified::token::FN; } // fn
        if (matches_ascii(source, start, 2, 26217, 0)) { return verified::token::IF; } // if
        if (matches_ascii(source, start, 2, 28265, 0)) { return verified::token::IN; } // in
    }
    if (length == 3) {
        if (matches_ascii(source, start, 3, 6452592, 0)) { return verified::token::PUB; } // pub
        if (matches_ascii(source, start, 3, 7628140, 0)) { return verified::token::LET; } // let
        if (matches_ascii(source, start, 3, 7499622, 0)) { return verified::token::FOR; } // for
    }
    if (length == 4) {
        if (matches_ascii(source, start, 4, 1702063205, 0)) { return verified::token::ELSE; } // else
        if (matches_ascii(source, start, 4, 1702195828, 0)) { return verified::token::TRUE; } // true
        if (matches_ascii(source, start, 4, 1836412517, 0)) { return verified::token::ENUM; } // enum
        if (matches_ascii(source, start, 4, 1819307369, 0)) { return verified::token::IMPL; } // impl
        if (matches_ascii(source, start, 4, 1718379891, 0)) { return verified::token::SELF_VALUE; } // self
        if (matches_ascii(source, start, 4, 1701869940, 0)) { return verified::token::TYPE; } // type
    }
    if (length == 5) {
        if (matches_ascii(source, start, 5, 1936482662, 101)) { return verified::token::FALSE; } // false
        if (matches_ascii(source, start, 5, 1936617315, 116)) { return verified::token::CONST; } // const
        if (matches_ascii(source, start, 5, 1668571501, 104)) { return verified::token::MATCH; } // match
        if (matches_ascii(source, start, 5, 1767993972, 116)) { return verified::token::TRAIT; } // trait
        if (matches_ascii(source, start, 5, 1919248503, 101)) { return verified::token::WHERE; } // where
        if (matches_ascii(source, start, 5, 1818847351, 101)) { return verified::token::WHILE; } // while
        if (matches_ascii(source, start, 5, 1634038370, 107)) { return verified::token::BREAK; } // break
    }
    if (length == 6) {
        if (matches_ascii(source, start, 6, 1970562418, 28274)) { return verified::token::RETURN; } // return
        if (matches_ascii(source, start, 6, 1970435187, 29795)) { return verified::token::STRUCT; } // struct
        if (matches_ascii(source, start, 6, 1702131813, 28274)) { return verified::token::EXTERN; } // extern
        if (matches_ascii(source, start, 6, 1869639017, 29810)) { return verified::token::IMPORT; } // import
        if (matches_ascii(source, start, 6, 1969516397, 25964)) { return verified::token::MODULE; } // module
    }
    if (length == 8) {
        if (matches_ascii(source, start, 8, 1953394531, 1702194793)) { // continue
            return verified::token::CONTINUE;
        }
    }
    return verified::token::IDENTIFIER;
}

pub fn canonical_kind(
    source: [i32],
    raw_kind: i32,
    start: i32,
    end: i32,
) -> i32 {
    if (raw_kind == verified::token::IDENTIFIER) {
        return keyword_kind(source, start, end);
    }
    return raw_kind;
}

// Compacts non-trivia records in place. Each input and output row is
// `{ kind, start, exclusive_end }`; output never overtakes unread input.
pub fn canonicalize_in_place(
    source: [i32],
    records: [i32],
    raw_token_count: i32,
) -> i32 {
    let input_index: i32 = 0;
    let output_count: i32 = 0;
    while (input_index < raw_token_count) {
        let input_row: i32 = input_index * 3;
        let kind: i32 = records[input_row];
        if (!is_trivia(kind)) {
            let start: i32 = records[input_row + 1];
            let end: i32 = records[input_row + 2];
            let output_row: i32 = output_count * 3;
            records[output_row] = canonical_kind(source, kind, start, end);
            records[output_row + 1] = start;
            records[output_row + 2] = end;
            output_count += 1;
        }
        input_index += 1;
    }
    let range_index: i32 = 0;
    while (range_index + 1 < output_count) {
        let current_row: i32 = range_index * 3;
        let next_row: i32 = current_row + 3;
        if (records[current_row] == verified::token::DOT_DOT
            && records[next_row] == verified::token::ASSIGN
            && records[next_row + 1] == records[current_row + 2]) {
            records[current_row] = verified::token::DOT_DOT_EQUAL;
        }
        range_index += 1;
    }
    return output_count;
}
