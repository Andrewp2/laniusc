module verified::canonical_tokens;

import verified::token;
import verified::host;

pub fn is_trivia(kind: i32) -> bool {
    return verified::token::kind_is(kind, verified::token::Whitespace)
        || verified::token::kind_is(kind, verified::token::LineComment)
        || verified::token::kind_is(kind, verified::token::BlockComment);
}

fn matches_ascii(source: [i32], start: i32, length: i32,
    expected: str) -> bool {
    let words: [i32] = verified::host::i32_slice_from_raw_parts(
        verified::host::string_data_ptr(expected),
        (length + verified::host::I32_BYTES - 1)
            / verified::host::I32_BYTES);
    let index: i32 = 0;
    while (index != length) {
        let byte: i32 = (words[index / verified::host::I32_BYTES]
            >> ((index % verified::host::I32_BYTES)
                * verified::host::BITS_PER_BYTE)) & verified::host::BYTE_MASK;
        if (source[start + index] != byte) { return false; }
        index += 1;
    }
    return true;
}

// Retags an identifier span only when its complete spelling is a keyword.
// Length dispatch prevents prefix matches such as `letter` becoming `let` and
// limits the number of literal comparisons performed for each identifier.
pub fn keyword_kind(
    source: [i32],
    start: i32,
    end: i32,
) -> i32 {
    let length: i32 = end - start;
    if (length == 2) {
        if (matches_ascii(source, start, length, "fn")) {
            return verified::token::kind_code(verified::token::FnKeyword);
        }
        if (matches_ascii(source, start, length, "if")) {
            return verified::token::kind_code(verified::token::IfKeyword);
        }
        if (matches_ascii(source, start, length, "in")) {
            return verified::token::kind_code(verified::token::InKeyword);
        }
    }
    if (length == 3) {
        if (matches_ascii(source, start, length, "pub")) {
            return verified::token::kind_code(verified::token::PubKeyword);
        }
        if (matches_ascii(source, start, length, "let")) {
            return verified::token::kind_code(verified::token::LetKeyword);
        }
        if (matches_ascii(source, start, length, "for")) {
            return verified::token::kind_code(verified::token::ForKeyword);
        }
    }
    if (length == 4) {
        if (matches_ascii(source, start, length, "else")) {
            return verified::token::kind_code(verified::token::ElseKeyword);
        }
        if (matches_ascii(source, start, length, "true")) {
            return verified::token::kind_code(verified::token::TrueKeyword);
        }
        if (matches_ascii(source, start, length, "enum")) {
            return verified::token::kind_code(verified::token::EnumKeyword);
        }
        if (matches_ascii(source, start, length, "impl")) {
            return verified::token::kind_code(verified::token::ImplKeyword);
        }
        if (matches_ascii(source, start, length, "self")) {
            return verified::token::kind_code(verified::token::SelfValueKeyword);
        }
        if (matches_ascii(source, start, length, "type")) {
            return verified::token::kind_code(verified::token::TypeKeyword);
        }
    }
    if (length == 5) {
        if (matches_ascii(source, start, length, "false")) {
            return verified::token::kind_code(verified::token::FalseKeyword);
        }
        if (matches_ascii(source, start, length, "const")) {
            return verified::token::kind_code(verified::token::ConstKeyword);
        }
        if (matches_ascii(source, start, length, "match")) {
            return verified::token::kind_code(verified::token::MatchKeyword);
        }
        if (matches_ascii(source, start, length, "trait")) {
            return verified::token::kind_code(verified::token::TraitKeyword);
        }
        if (matches_ascii(source, start, length, "where")) {
            return verified::token::kind_code(verified::token::WhereKeyword);
        }
        if (matches_ascii(source, start, length, "while")) {
            return verified::token::kind_code(verified::token::WhileKeyword);
        }
        if (matches_ascii(source, start, length, "break")) {
            return verified::token::kind_code(verified::token::BreakKeyword);
        }
    }
    if (length == 6) {
        if (matches_ascii(source, start, length, "return")) {
            return verified::token::kind_code(verified::token::ReturnKeyword);
        }
        if (matches_ascii(source, start, length, "struct")) {
            return verified::token::kind_code(verified::token::StructKeyword);
        }
        if (matches_ascii(source, start, length, "extern")) {
            return verified::token::kind_code(verified::token::ExternKeyword);
        }
        if (matches_ascii(source, start, length, "import")) {
            return verified::token::kind_code(verified::token::ImportKeyword);
        }
        if (matches_ascii(source, start, length, "module")) {
            return verified::token::kind_code(verified::token::ModuleKeyword);
        }
    }
    if (length == 8) {
        if (matches_ascii(source, start, length, "continue")) {
            return verified::token::kind_code(verified::token::ContinueKeyword);
        }
    }
    return verified::token::kind_code(verified::token::Identifier);
}

pub fn canonical_kind(
    source: [i32],
    raw_kind: i32,
    start: i32,
    end: i32,
) -> i32 {
    if (verified::token::kind_is(raw_kind, verified::token::Identifier)) {
        return keyword_kind(source, start, end);
    }
    return raw_kind;
}

// Compacts non-trivia records in place. Each input and output row is
// `{ kind, start, exclusive_end }`; output never overtakes unread input.
pub fn canonicalize_in_place(
    source: [i32],
    records: [i32],
    raw_token_count: i32,
) -> i32 {
    let input_index: i32 = 0;
    let output_count: i32 = 0;
    while (input_index < raw_token_count) {
        let input_row: i32 = input_index * verified::token::ROW_WORDS;
        let kind: i32 = records[input_row + verified::token::KIND_FIELD];
        if (!is_trivia(kind)) {
            let start: i32 = records[input_row + verified::token::START_FIELD];
            let end: i32 = records[input_row + verified::token::END_FIELD];
            let output_row: i32 = output_count * verified::token::ROW_WORDS;
            records[output_row + verified::token::KIND_FIELD]
                = canonical_kind(source, kind, start, end);
            records[output_row + verified::token::START_FIELD] = start;
            records[output_row + verified::token::END_FIELD] = end;
            output_count += 1;
        }
        input_index += 1;
    }
    let range_index: i32 = 0;
    while (range_index + 1 < output_count) {
        let current_row: i32 = range_index * verified::token::ROW_WORDS;
        let next_row: i32 = current_row + verified::token::ROW_WORDS;
        if (verified::token::kind_is(
                records[current_row + verified::token::KIND_FIELD],
                verified::token::DotDot)
            && verified::token::kind_is(
                records[next_row + verified::token::KIND_FIELD],
                verified::token::Assign)
            && records[next_row + verified::token::START_FIELD]
                == records[current_row + verified::token::END_FIELD]) {
            records[current_row + verified::token::KIND_FIELD]
                = verified::token::kind_code(
                verified::token::DotDotEqual);
        }
        range_index += 1;
    }
    return output_count;
}
