module app::main;

import lowering::program_transport;
import lowering::transport;
import verified::byte_io;
import verified::certificate_output_native;
import verified::compact_artifact_output;
import verified::extraction;
import verified::grammar;
import verified::host;
import verified::output;
import verified::parser;
import verified::semantic_tokens;
import verified::token;
import backend::image_boundary;
import driver::arguments;

const PATH_BYTE_CAPACITY: i32 = 1024;
const PACKED_PATH_WORD_CAPACITY: i32 =
    PATH_BYTE_CAPACITY / verified::host::I32_BYTES;
const TRANSPORT_WORD_CAPACITY: i32 = 262144;
const COMPACT_OUTPUT_CAPACITY: i32 =
    verified::extraction::PARSER_WORK_WORD_CAPACITY;
const CERTIFICATE_OPTION_LENGTH: i32 = 13;

enum CompilerMode {
    BinaryMode,
    CertificateMode,
}

enum CompilerExit {
    Success,
    InvalidArguments,
    PathTooLong,
    AllocationFailed,
    ArgumentReadFailed,
    OpenFailed,
    ReadFailed,
    GrammarFailed,
    ExtractionFailed,
    BundleFailed,
    CoreLoweringFailure,
    BackendFailed,
    OutputFailed,
    SemanticFailed,
    CompactFailed,
    CertificateHeaderFailed,
    CertificateTransportFailed,
    CertificateImageFailed,
    CertificateFunctionsFailed,
    CertificatePackingFailed,
    CertificateWriteFailed,
}

fn exit_code(status: CompilerExit) -> i32 {
    return match (status) {
        Success -> 0,
        InvalidArguments -> 1,
        PathTooLong -> 2,
        AllocationFailed -> 3,
        ArgumentReadFailed -> 4,
        OpenFailed -> 5,
        ReadFailed -> 6,
        GrammarFailed -> 7,
        ExtractionFailed -> 8,
        BundleFailed -> 9,
        CoreLoweringFailure -> 10,
        BackendFailed -> 11,
        OutputFailed -> 12,
        SemanticFailed -> 13,
        CompactFailed -> 14,
        CertificateHeaderFailed -> 15,
        CertificateTransportFailed -> 16,
        CertificateImageFailed -> 17,
        CertificateFunctionsFailed -> 18,
        CertificatePackingFailed -> 19,
        CertificateWriteFailed -> 20,
    };
}

fn emits_certificate(mode: CompilerMode) -> bool {
    return match (mode) {
        BinaryMode -> false,
        CertificateMode -> true,
    };
}

// The compiler entrypoint accepts one or more source paths. All paths are
// parsed into one owned lowering bundle before any backend image is emitted;
// one-unit input therefore uses the same aggregate namespace as N>1.
fn main() -> i32 {
    let argument_count: i32 = driver::arguments::count();
    if (argument_count < 2) { return exit_code(InvalidArguments); }
    let mode: CompilerMode = BinaryMode;

    let packed_path:[i32];
    {
        let allocation: ptr = verified::host::alloc_i32(
            PACKED_PATH_WORD_CAPACITY);
        if (allocation == 0) { return exit_code(AllocationFailed); }
        packed_path = verified::host::i32_slice_from_raw_parts(
            allocation, PACKED_PATH_WORD_CAPACITY);
    }
    let source:[i32];
    {
        let allocation: ptr = verified::host::alloc_i32(
            verified::extraction::SOURCE_BYTE_CAPACITY);
        if (allocation == 0) { return exit_code(AllocationFailed); }
        source = verified::host::i32_slice_from_raw_parts(allocation,
            verified::extraction::SOURCE_BYTE_CAPACITY);
    }
    let grammar:[i32];
    {
        let allocation: ptr = verified::host::alloc_i32(
            verified::grammar::WORDS);
        if (allocation == 0) { return exit_code(AllocationFailed); }
        grammar = verified::host::i32_slice_from_raw_parts(
            allocation, verified::grammar::WORDS);
    }
    let raw:[i32];
    {
        let allocation: ptr = verified::host::alloc_i32(
            verified::token::TOKEN_WORD_CAPACITY);
        if (allocation == 0) { return exit_code(AllocationFailed); }
        raw = verified::host::i32_slice_from_raw_parts(allocation,
            verified::token::TOKEN_WORD_CAPACITY);
    }
    let canonical:[i32];
    {
        let allocation: ptr = verified::host::alloc_i32(
            verified::token::TOKEN_WORD_CAPACITY);
        if (allocation == 0) { return exit_code(AllocationFailed); }
        canonical = verified::host::i32_slice_from_raw_parts(allocation,
            verified::token::TOKEN_WORD_CAPACITY);
    }
    let kinds:[i32];
    {
        let allocation: ptr = verified::host::alloc_i32(
            verified::extraction::TOKEN_KIND_CAPACITY);
        if (allocation == 0) { return exit_code(AllocationFailed); }
        kinds = verified::host::i32_slice_from_raw_parts(allocation,
            verified::extraction::TOKEN_KIND_CAPACITY);
    }
    let extraction_workspace:[i32];
    {
        let allocation: ptr = verified::host::alloc_i32(
            verified::extraction::PARSER_WORK_WORD_CAPACITY);
        if (allocation == 0) { return exit_code(AllocationFailed); }
        extraction_workspace = verified::host::i32_slice_from_raw_parts(
            allocation,
            verified::extraction::PARSER_WORK_WORD_CAPACITY);
    }
    let records:[i32];
    {
        let allocation: ptr = verified::host::alloc_i32(
            verified::extraction::PARSE_RECORD_WORD_CAPACITY);
        if (allocation == 0) { return exit_code(AllocationFailed); }
        records = verified::host::i32_slice_from_raw_parts(allocation,
            verified::extraction::PARSE_RECORD_WORD_CAPACITY);
    }
    let offsets:[i32];
    {
        let allocation: ptr = verified::host::alloc_i32(
            verified::extraction::PARSE_NODE_CAPACITY);
        if (allocation == 0) { return exit_code(AllocationFailed); }
        offsets = verified::host::i32_slice_from_raw_parts(allocation,
            verified::extraction::PARSE_NODE_CAPACITY);
    }
    let transport:[i32];
    {
        let allocation: ptr = verified::host::alloc_i32(
            TRANSPORT_WORD_CAPACITY);
        if (allocation == 0) { return exit_code(AllocationFailed); }
        transport = verified::host::i32_slice_from_raw_parts(
            allocation, TRANSPORT_WORD_CAPACITY);
    }
    let function_input:[i32];
    {
        let allocation: ptr = verified::host::alloc_i32(
            backend::image_boundary::FUNCTION_INPUT_CAPACITY);
        if (allocation == 0) { return exit_code(AllocationFailed); }
        function_input = verified::host::i32_slice_from_raw_parts(
            allocation, backend::image_boundary::FUNCTION_INPUT_CAPACITY);
    }
    let backend_work:[i32];
    {
        let bytes: usize = backend::image_boundary::WORK_CAPACITY
            * verified::host::I32_BYTES;
        let alignment: usize = backend::image_boundary::WORK_ALIGNMENT;
        let allocation: ptr = verified::host::alloc(bytes, alignment);
        if (allocation == 0) { return exit_code(AllocationFailed); }
        backend_work = verified::host::i32_slice_from_raw_parts(
            allocation, backend::image_boundary::WORK_CAPACITY);
    }
    let code:[i32];
    {
        let allocation: ptr = verified::host::alloc_i32(
            backend::image_boundary::OUTPUT_CAPACITY);
        if (allocation == 0) { return exit_code(AllocationFailed); }
        code = verified::host::i32_slice_from_raw_parts(
            allocation, backend::image_boundary::OUTPUT_CAPACITY);
    }
    let packed_io:[i32];
    {
        let allocation: ptr = verified::host::alloc_i32(
            verified::byte_io::PACKED_IO_WORDS);
        if (allocation == 0) { return exit_code(AllocationFailed); }
        packed_io = verified::host::i32_slice_from_raw_parts(
            allocation, verified::byte_io::PACKED_IO_WORDS);
    }
    let path_pointer: ptr = verified::host::i32_slice_data_ptr(packed_path);
    let path_index: i32 = 1;
    if (driver::arguments::matches(1, packed_path, "--certificate",
        CERTIFICATE_OPTION_LENGTH)) {
        mode = CertificateMode;
        path_index = 2;
    }
    let compact_bundle: [i32] = verified::host::i32_slice_from_raw_parts(
        path_pointer, 0);
    if (emits_certificate(mode)) {
        // Compact output has the same final certificate budget as the
        // workspace into which it is copied, independent of Core storage.
        let allocation: ptr = verified::host::alloc_i32(
            COMPACT_OUTPUT_CAPACITY);
        if (allocation == 0) { return exit_code(AllocationFailed); }
        compact_bundle = verified::host::i32_slice_from_raw_parts(
            allocation, COMPACT_OUTPUT_CAPACITY);
    }
    let unit_count: i32 = argument_count - path_index;
    if (unit_count <= 0 || unit_count > lowering::program_transport::BUNDLE_UNIT_LIMIT) {
        return exit_code(InvalidArguments);
    }
    let bundle_word_count: i32 = lowering::program_transport::bundle_words(unit_count);
    if (bundle_word_count <= 0) { return exit_code(AllocationFailed); }
    let bundle_memory: ptr = verified::host::alloc(
        bundle_word_count * verified::host::I32_BYTES,
        lowering::program_transport::BUNDLE_ALIGNMENT);
    if (bundle_memory == 0) { return exit_code(AllocationFailed); }
    let bundle: lowering::program_transport::Bundle =
        lowering::program_transport::from_raw_parts(bundle_memory,
            unit_count);
    {
        if (verified::grammar::load(grammar, verified::grammar::WORDS)
            != verified::grammar::WORDS) { return exit_code(GrammarFailed); }
        let compact_position: i32 =
            verified::certificate_output_native::HEADER_BYTES;
        let unit: i32 = 0;
        while (unit < unit_count) {
            let path_length: i32 = driver::arguments::length(path_index + unit);
            if (path_length <= 0 || path_length > PATH_BYTE_CAPACITY) {
                return exit_code(PathTooLong);
            }
            if (driver::arguments::read(path_index + unit, path_pointer, path_length)
                != path_length) { return exit_code(ArgumentReadFailed); }
            let path_word: i32 = 0;
            while (path_word < path_length) {
                packed_io[path_word] =
                    (packed_path[path_word / verified::host::I32_BYTES]
                        >> ((path_word % verified::host::I32_BYTES)
                            * verified::host::BITS_PER_BYTE))
                    & verified::host::BYTE_MASK;
                path_word += 1;
            }
            let handle: i32 = verified::host::open_read(path_pointer, path_length);
            if (handle <= -1) { return exit_code(OpenFailed); }
            let source_length: i32 = verified::byte_io::read_file(
                handle, source,
                verified::extraction::SOURCE_BYTE_CAPACITY, packed_io);
            if (verified::host::close(handle) <= -1 || source_length <= -1) { return exit_code(ReadFailed); }
            path_word = 0;
            while (path_word < path_length) {
                packed_io[path_word] =
                    (packed_path[path_word / verified::host::I32_BYTES]
                        >> ((path_word % verified::host::I32_BYTES)
                            * verified::host::BITS_PER_BYTE))
                    & verified::host::BYTE_MASK;
                path_word += 1;
            }
            let syntax_input: verified::extraction::SyntaxInput =
                verified::extraction::SyntaxInput {
                    source: verified::extraction::buffer(source,
                        source_length),
                    grammar: verified::extraction::buffer(grammar,
                        verified::grammar::WORDS),
                };
            let syntax_workspace: verified::extraction::SyntaxWorkspace =
                verified::extraction::SyntaxWorkspace {
                    raw_tokens: verified::extraction::buffer(raw,
                        verified::token::TOKEN_WORD_CAPACITY),
                    canonical_tokens: verified::extraction::buffer(canonical,
                        verified::token::TOKEN_WORD_CAPACITY),
                    token_kinds: verified::extraction::buffer(kinds,
                        verified::extraction::TOKEN_KIND_CAPACITY),
                    parser_workspace: verified::parser::storage(
                        verified::host::i32_slice_data_ptr(
                            extraction_workspace),
                        verified::extraction::PARSER_WORK_WORD_CAPACITY),
                    parse_records: verified::extraction::buffer(records,
                        verified::extraction::PARSE_RECORD_WORD_CAPACITY),
                    node_offsets: verified::extraction::buffer(offsets,
                        verified::extraction::PARSE_NODE_CAPACITY),
                    depth_limit: verified::extraction::DEFAULT_PARSE_DEPTH_LIMIT,
                };
            let extracted: verified::extraction::SyntaxResult =
                verified::extraction::extract_syntax(syntax_input,
                    syntax_workspace);
            if (!verified::extraction::extraction_has_stage(extracted,
                    verified::extraction::Extracted)) {
                return exit_code(ExtractionFailed);
            }
            let raw_count: i32 = verified::extraction::raw_count(extracted);
            let token_count: i32 = verified::extraction::token_count(extracted);
            let node_count: i32 = verified::extraction::node_count(extracted);
            let record_words: i32 = verified::extraction::tree_words(extracted);
            let source_region: lowering::program_transport::WordRegion =
                lowering::program_transport::region(source, source_length);
            let canonical_tokens: lowering::program_transport::PackedTokenRows =
                lowering::program_transport::PackedTokenRows {
                    data: canonical,
                    words: verified::token::TOKEN_WORD_CAPACITY,
                    count: token_count,
                };
            let offset_region: lowering::program_transport::WordRegion =
                lowering::program_transport::region(offsets, node_count);
            let parsed_unit: lowering::program_transport::ParsedUnit =
                lowering::program_transport::ParsedUnit {
                    source: source_region,
                    canonical_tokens: canonical_tokens,
                    parse_records: records,
                    node_offsets: offset_region,
                    record_words: record_words,
                    raw_token_count: raw_count,
                    path_length: path_length,
                };
            if (!lowering::program_transport::append_parsed_unit(
                bundle, unit, parsed_unit)) { return exit_code(BundleFailed); }
            if (emits_certificate(mode)) {
                if (verified::semantic_tokens::collect_raw(
                    verified::host::i32_slice_data_ptr(grammar),
                    verified::host::i32_slice_data_ptr(kinds),
                    token_count, node_count,
                    verified::host::i32_slice_data_ptr(records),
                    verified::host::i32_slice_data_ptr(offsets),
                    verified::host::i32_slice_data_ptr(backend_work)) != 0) {
                    return exit_code(SemanticFailed);
                }
                let path_region: verified::compact_artifact_output::WordRegion =
                    verified::compact_artifact_output::WordRegion {
                        data: packed_io, length: path_length };
                let source_region: verified::compact_artifact_output::WordRegion =
                    verified::compact_artifact_output::WordRegion {
                        data: source, length: source_length };
                let raw_tokens: verified::compact_artifact_output::TokenRows =
                    verified::compact_artifact_output::TokenRows {
                        data: raw,
                        length: verified::token::TOKEN_WORD_CAPACITY,
                        count: raw_count };
                let canonical_tokens: verified::compact_artifact_output::TokenRows =
                    verified::compact_artifact_output::TokenRows {
                        data: canonical,
                        length: verified::token::TOKEN_WORD_CAPACITY,
                        count: token_count };
                let semantic_region: verified::semantic_tokens::AssignmentBuffer =
                    verified::semantic_tokens::from_raw_parts(
                        verified::host::i32_slice_data_ptr(backend_work),
                        verified::extraction::TOKEN_KIND_CAPACITY);
                let parse_region: verified::compact_artifact_output::WordRegion =
                    verified::compact_artifact_output::WordRegion {
                        data: records,
                        length: record_words };
                let compact_unit: verified::compact_artifact_output::ArtifactUnit =
                    verified::compact_artifact_output::ArtifactUnit {
                        path: path_region,
                        source: source_region,
                        raw_tokens: raw_tokens,
                        canonical_tokens: canonical_tokens,
                        semantic_kinds: semantic_region,
                        parse_records: parse_region,
                        node_offsets: offsets,
                        node_count: node_count,
                    };
                let compact_output: verified::output::Cursor =
                    verified::output::cursor(
                        compact_bundle,
                        COMPACT_OUTPUT_CAPACITY,
                        compact_position);
                let next_compact: i32 =
                    verified::compact_artifact_output::emit_unit(
                        compact_unit, compact_output);
                if (next_compact <= -1) { return exit_code(CompactFailed); }
                compact_position = next_compact;
            }
            unit += 1;
        }
        if (emits_certificate(mode)) {
            if (verified::compact_artifact_output::emit_header(
                unit_count, verified::output::cursor(
                    compact_bundle,
                    COMPACT_OUTPUT_CAPACITY,
                    0)) <= -1) { return exit_code(CompactFailed); }
            let compact_copy: i32 = 0;
            while (compact_copy < compact_position) {
                extraction_workspace[
                    verified::certificate_output_native::HEADER_BYTES
                        + compact_copy] =
                    compact_bundle[compact_copy];
                compact_copy += 1;
            }
        }
        let transport_words: i32 = lowering::program_transport::lower_units(
            bundle,
            verified::host::i32_slice_data_ptr(transport));
        if (transport_words <= lowering::transport::HEADER - 1) {
            return exit_code(CoreLoweringFailure);
        }
        let emitted: i32 = backend::image_boundary::compile_raw(
            verified::host::i32_slice_data_ptr(transport), transport_words,
            verified::host::i32_slice_data_ptr(function_input),
            verified::host::i32_slice_data_ptr(backend_work),
            verified::host::i32_slice_data_ptr(code));
        if (emitted <= 0) { return exit_code(BackendFailed); }
        if (emits_certificate(mode)) {
            let certificate_length: i32 =
                verified::certificate_output_native::HEADER_BYTES
                    + compact_position;
            let compact_length: i32 = compact_position;
            let header_end: i32 = verified::certificate_output_native::emit_header_raw(
                compact_length, verified::host::i32_slice_data_ptr(extraction_workspace),
                verified::extraction::PARSER_WORK_WORD_CAPACITY, 0);
            if (header_end <= -1) { return exit_code(CertificateHeaderFailed); }
            certificate_length = verified::certificate_output_native::emit_transport_raw(
                verified::host::i32_slice_data_ptr(transport),
                TRANSPORT_WORD_CAPACITY,
                transport_words, verified::host::i32_slice_data_ptr(extraction_workspace),
                verified::extraction::PARSER_WORK_WORD_CAPACITY,
                certificate_length);
            if (certificate_length <= -1) { return exit_code(CertificateTransportFailed); }
            certificate_length = verified::certificate_output_native::emit_image_raw(
                verified::host::i32_slice_data_ptr(code), emitted,
                verified::host::i32_slice_data_ptr(extraction_workspace),
                verified::extraction::PARSER_WORK_WORD_CAPACITY,
                certificate_length);
            if (certificate_length <= -1) { return exit_code(CertificateImageFailed); }
            let function_count: i32 =
                backend::image_boundary::function_count_raw(
                    verified::host::i32_slice_data_ptr(backend_work));
            certificate_length = verified::certificate_output_native::emit_functions_raw(
                verified::host::i32_slice_data_ptr(backend_work),
                backend::image_boundary::WORK_CAPACITY, transport_words,
                function_count,
                verified::host::i32_slice_data_ptr(extraction_workspace),
                verified::extraction::PARSER_WORK_WORD_CAPACITY,
                certificate_length);
            if (certificate_length <= -1) { return exit_code(CertificateFunctionsFailed); }
            if (verified::certificate_output_native::pack_in_place_raw(
                verified::host::i32_slice_data_ptr(extraction_workspace),
                certificate_length) <= -1) { return exit_code(CertificatePackingFailed); }
            let certificate_size: usize = certificate_length;
            if (verified::host::write_stdout(
                verified::host::i32_slice_data_ptr(extraction_workspace),
                certificate_size) != certificate_length) { return exit_code(CertificateWriteFailed); }
            return exit_code(Success);
        }
        let word_count: i32 = verified::host::packed_words(emitted);
        let word: i32 = 0;
        while (word < word_count) { extraction_workspace[word] = 0; word += 1; }
        let byte: i32 = 0;
        while (byte < emitted) {
            extraction_workspace[byte / verified::host::I32_BYTES] =
                extraction_workspace[byte / verified::host::I32_BYTES]
                | (code[byte] << ((byte % verified::host::I32_BYTES)
                    * verified::host::BITS_PER_BYTE));
            byte += 1;
        }
        let output_size: usize = emitted;
        if (verified::host::write_stdout(
            verified::host::i32_slice_data_ptr(extraction_workspace), output_size)
            != emitted) { return exit_code(OutputFailed); }
        return exit_code(Success);
    }
}
