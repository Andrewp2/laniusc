module app::main;
import verified::extraction;
import verified::byte_io;
import verified::semantic_tokens;
import verified::compact_artifact_output;
import verified::host;
import verified::output;
fn hex_nibble(byte: i32) -> i32 {
    if (byte >= 48 && byte <= 57) {
        return byte - 48;
    }
    return byte - 87;
}
// Bootstrap syntax extractor. Inputs are argv[1..]; output is one complete Lean
// module containing a compact certificate and an executable verified check.
// Nonzero exit means all partial output must be discarded. Buffers are
// allocated once and reused sequentially across units.
fn main() -> i32 {
    let argument_count: i32 = verified::host::argc();
    if (argument_count <= 1) {
        return 1;
    }
    let packed_path:[i32] = verified::host::i32_slice_from_raw_parts(verified::host::alloc(1024, 4), 256);
    let path:[i32] = verified::host::i32_slice_from_raw_parts(verified::host::alloc(4096, 4), 1024);
    let source:[i32] = verified::host::i32_slice_from_raw_parts(verified::host::alloc(262144, 4), 65536);
    let grammar:[i32] = verified::host::i32_slice_from_raw_parts(verified::host::alloc(8716, 4), 2179);
    let raw:[i32] = verified::host::i32_slice_from_raw_parts(verified::host::alloc(262144, 4), 65536);
    let canonical:[i32] = verified::host::i32_slice_from_raw_parts(verified::host::alloc(262144, 4), 65536);
    let kinds:[i32] = verified::host::i32_slice_from_raw_parts(verified::host::alloc(262144, 4), 65536);
    let workspace:[i32] = verified::host::i32_slice_from_raw_parts(verified::host::alloc(16777216, 4), 4194304);
    let records:[i32] = verified::host::i32_slice_from_raw_parts(verified::host::alloc(4194304, 4), 1048576);
    let offsets:[i32] = verified::host::i32_slice_from_raw_parts(verified::host::alloc(262144, 4), 65536);
    let semantic:[i32] = verified::host::i32_slice_from_raw_parts(verified::host::alloc(524288, 4), 131072);
    let output:[i32] = verified::host::i32_slice_from_raw_parts(verified::host::alloc(33554432, 4), 8388608);
    let packed_io:[i32] = verified::host::i32_slice_from_raw_parts(verified::host::alloc(65536, 4), 16384);
    let packed_path_pointer: ptr = verified::host::i32_slice_data_ptr(packed_path);
    let packed_io_pointer: ptr = verified::host::i32_slice_data_ptr(packed_io);
    let workspace_pointer: ptr = verified::host::i32_slice_data_ptr(workspace);
    if (packed_path_pointer == 0 || verified::host::i32_slice_data_ptr(path) == 0 || verified::host::i32_slice_data_ptr(source) == 0 || verified::host::i32_slice_data_ptr(grammar) == 0 || verified::host::i32_slice_data_ptr(raw) == 0 || verified::host::i32_slice_data_ptr(canonical) == 0 || verified::host::i32_slice_data_ptr(kinds) == 0 || workspace_pointer == 0 || verified::host::i32_slice_data_ptr(records) == 0 || verified::host::i32_slice_data_ptr(offsets) == 0 || verified::host::i32_slice_data_ptr(semantic) == 0 || verified::host::i32_slice_data_ptr(output) == 0 || packed_io_pointer == 0) {
        return 3;
    }
    // The exact grammar remains embedded, but as one lexical token rather
    // than thousands of array-element productions. Four hexadecimal bytes
    // encode each unsigned 16-bit grammar word from most to least significant.
    let encoded_grammar: str = "";
    let encoded_words:[i32] = verified::host::i32_slice_from_raw_parts(verified::host::string_data_ptr(encoded_grammar), 2179);
    let grammar_index: i32 = 0;
    while (grammar_index != 2179) {
        let encoded_word: i32 = encoded_words[grammar_index];
        grammar[grammar_index] =(hex_nibble(encoded_word&255) << 12)|(hex_nibble((encoded_word >> 8)&255) << 8)|(hex_nibble((encoded_word >> 16)&255) << 4)|hex_nibble((encoded_word >> 24)&255);
        grammar_index += 1;
    }
    let pack_start: str = "import Lanius.Extraction.CoreSynthesis.Program\n\nopen Lanius.Extraction\nopen Lanius.Extraction.CoreSynthesis.Program\n\ndef encodedPack : String := \"";
    let pack_end: str = "\"\n\ndef readExpectedSources (paths : List String) : IO (List SourceFile) :=\n  paths.mapM fun (path : String) =>\n    IO.FS.readBinFile path >>= fun contents =>\n      pure { path, bytes := contents.toList.map UInt8.toNat }\n\ndef main (paths : List String) : IO UInt32 :=\n  readExpectedSources paths >>= fun sources =>\n    match checkCompactCoreSourcePack encodedPack sources with\n    | .success _ => do\n      IO.println \"source, syntax, Surface, and synthesized x86 Core certificates accepted for the exact input files\"\n      pure 0\n    | .failure stage => do\n      IO.eprintln (\"compact source, Surface, or synthesized Core certificate checking failed at \" ++ stage)\n      pure 1\n";
    let output_length: i32 = verified::output::text(output, 8388608, 0, pack_start, 146);
    if (output_length != 146) {
        return 23;
    }
    output_length = verified::compact_artifact_output::emit_header(argument_count - 1, output, 8388608, output_length);
    if (output_length <= -1) {
        return 26;
    }
    let argument: i32 = 1;
    while (argument != argument_count) {
        let path_length: i32 = verified::host::arg_len(argument);
        if (path_length <= 0 || path_length >= 1025) {
            return 2;
        }
        if (verified::host::arg_read(argument, packed_path_pointer, path_length) != path_length) {
            return 4;
        }
        let index: i32 = 0;
        while (index != path_length) {
            path[index] =(packed_path[index / 4] >>((index % 4) * 8))&255;
            index += 1;
        }
        let handle: i32 = verified::host::open_read(packed_path_pointer, path_length);
        if (handle <= -1) {
            return 5;
        }
        let source_length: i32 = verified::byte_io::read_file(handle, source, 65536, packed_io);
        let closed: i32 = verified::host::close(handle);
        if (source_length <= -1 || closed <= -1) {
            verified::byte_io::write_stderr_natural(argument);
            if (source_length <= -1) {
                verified::byte_io::write_stderr_natural(0 - source_length);
            } else {
                verified::byte_io::write_stderr_natural(0);
            }
            return 6;
        }
        let extracted = verified::extraction::extract_syntax(source, source_length, grammar, 2179, raw, 65536, canonical, 65536, kinds, 65536, workspace, 4194304, records, 1048576, offsets, 65536, 1024);
        if (verified::extraction::extraction_stage(extracted) != 0) {
            verified::byte_io::write_stderr_natural(argument);
            verified::byte_io::write_stderr_natural(verified::extraction::extraction_stage(extracted));
            verified::byte_io::write_stderr_natural(verified::extraction::extraction_detail(extracted));
            verified::byte_io::write_stderr_natural(verified::extraction::error_position(extracted));
            verified::byte_io::write_stderr_natural(verified::extraction::node_count(extracted));
            verified::byte_io::write_stderr_natural(verified::extraction::tree_words(extracted));
            // Exact stage/detail remain in stderr; use one stable process code
            // so native exit status and the formal failure contract agree.
            return 28;
        }
        let nodes: i32 = verified::extraction::node_count(extracted);
        let tokens: i32 = verified::extraction::token_count(extracted);
        if (verified::semantic_tokens::collect(grammar, 2179, kinds, tokens, records, 1048576, offsets, nodes, semantic, 131072) != 0) {
            return 20;
        }
        output_length = verified::compact_artifact_output::emit_unit(path, path_length, source, source_length, raw, 65536, verified::extraction::raw_count(extracted), canonical, 65536, tokens, semantic, 131072, records, 1048576, offsets, nodes, output, 8388608, output_length);
        if (output_length <= -1) {
            return 21;
        }
        argument += 1;
    }
    let before_suffix: i32 = output_length;
    output_length = verified::output::text(output, 8388608, output_length, pack_end, 677);
    if (output_length != before_suffix + 677) {
        return 25;
    }
    // Extraction is complete, so its 16 MiB workspace can become the packed
    // byte buffer for one atomic logical host write.
    let output_words: i32 = (output_length + 3) / 4;
    let output_word: i32 = 0;
    while (output_word != output_words) {
        workspace[output_word] = 0;
        output_word += 1;
    }
    let output_index: i32 = 0;
    while (output_index != output_length) {
        workspace[output_index / 4] = workspace[output_index / 4] | (output[output_index] << ((output_index % 4) * 8));
        output_index += 1;
    }
    let output_size: usize = output_length;
    if (verified::host::write_stdout(workspace_pointer, output_size) != output_length) {
        return 22;
    }
    return 0;
}
