module app::main;
import verified::extraction;
import verified::parser;
import verified::syntax_tree;
import verified::byte_io;
import verified::semantic_tokens;
import verified::token;
import verified::host;
import verified::grammar;
import verified::lean_frontend;
import lowering::program_transport;
import driver::arguments;
import lowering::transport;
import verified::lean_program;

const PATH_BYTE_CAPACITY: i32 = 1024;
const PACKED_PATH_WORD_CAPACITY: i32 =
    PATH_BYTE_CAPACITY / verified::host::I32_BYTES;
const LEAN_CHECKED_OPTION_LENGTH: i32 = 14;
const MODE_SCRATCH_WORDS: i32 = 4;
const OUTPUT_BYTE_CAPACITY: i32 = 83886080;
// The parser needs 64 MiB of scratch; ordinary Lean output reuses it after
// parsing, while checked Lean output uses a separate buffer.
const WORK_WORD_CAPACITY: i32 =
    OUTPUT_BYTE_CAPACITY / verified::host::I32_BYTES;

enum ExtractorMode {
    LeanCoreMode,
    LeanCheckedMode,
}

enum ExtractorExit {
    Success,
    InvalidArguments,
    PathTooLong,
    AllocationFailed,
    ArgumentReadFailed,
    OpenFailed,
    ReadFailed,
    SemanticFailed,
    OutputWriteFailed,
    GrammarLoadFailed,
    ExtractionFailed,
    BundleFailed,
    LoweringFailed,
    LeanCoreOutputFailed,
}

fn exit_code(status: ExtractorExit) -> i32 {
    return match (status) {
        Success -> 0,
        InvalidArguments -> 1,
        PathTooLong -> 2,
        AllocationFailed -> 3,
        ArgumentReadFailed -> 4,
        OpenFailed -> 5,
        ReadFailed -> 6,
        SemanticFailed -> 20,
        OutputWriteFailed -> 22,
        GrammarLoadFailed -> 23,
        ExtractionFailed -> 28,
        BundleFailed -> 30,
        LoweringFailed -> 30,
        LeanCoreOutputFailed -> 30,
    };
}

fn emits_typed_frontend(mode: ExtractorMode) -> bool {
    return mode == LeanCheckedMode;
}

fn selected_mode(scratch: [i32]) -> ExtractorMode {
    let option_length: i32 = driver::arguments::length(1);
    if (option_length == LEAN_CHECKED_OPTION_LENGTH
        && driver::arguments::matches(
            1, scratch, "--lean-checked", LEAN_CHECKED_OPTION_LENGTH)) {
        return LeanCheckedMode;
    }
    return LeanCoreMode;
}

fn main() -> i32 {
    let argument_count: i32 = driver::arguments::count();
    if (argument_count <= 1) {
        return exit_code(InvalidArguments);
    }
    // Ordinary output is Core.Program from the semantic IR consumed by x86.
    // `--lean-checked` additionally emits structured frontend evidence for
    // bootstrap validation; it is much larger on the full compiler closure.
    let mode_memory: ptr = verified::host::alloc_i32(MODE_SCRATCH_WORDS);
    if (mode_memory == 0) { return exit_code(AllocationFailed); }
    let mode_scratch: [i32] = verified::host::i32_slice_from_raw_parts(
        mode_memory, MODE_SCRATCH_WORDS);
    let mode: ExtractorMode = selected_mode(mode_scratch);
    let first_argument: i32 = match (mode) {
        LeanCoreMode -> 1,
        LeanCheckedMode -> 2,
    };
    let unit_count: i32 = argument_count - first_argument;
    if (unit_count <= 0
        || unit_count > lowering::program_transport::BUNDLE_UNIT_LIMIT) {
        return exit_code(InvalidArguments);
    }
    let packed_path:[i32];
    {
        let allocation: ptr = verified::host::alloc_i32(
            PACKED_PATH_WORD_CAPACITY);
        if (allocation == 0) { return exit_code(AllocationFailed); }
        packed_path = verified::host::i32_slice_from_raw_parts(
            allocation, PACKED_PATH_WORD_CAPACITY);
    }
    let source:[i32];
    {
        let allocation: ptr = verified::host::alloc_i32(
            verified::extraction::SOURCE_BYTE_CAPACITY);
        if (allocation == 0) { return exit_code(AllocationFailed); }
        source = verified::host::i32_slice_from_raw_parts(allocation,
            verified::extraction::SOURCE_BYTE_CAPACITY);
    }
    let grammar:[i32];
    {
        let allocation: ptr = verified::host::alloc_i32(
            verified::grammar::WORDS);
        if (allocation == 0) { return exit_code(AllocationFailed); }
        grammar = verified::host::i32_slice_from_raw_parts(
            allocation, verified::grammar::WORDS);
    }
    let raw:[i32];
    {
        let allocation: ptr = verified::host::alloc_i32(
            verified::token::TOKEN_WORD_CAPACITY);
        if (allocation == 0) { return exit_code(AllocationFailed); }
        raw = verified::host::i32_slice_from_raw_parts(allocation,
            verified::token::TOKEN_WORD_CAPACITY);
    }
    let canonical:[i32];
    {
        let allocation: ptr = verified::host::alloc_i32(
            verified::token::TOKEN_WORD_CAPACITY);
        if (allocation == 0) { return exit_code(AllocationFailed); }
        canonical = verified::host::i32_slice_from_raw_parts(allocation,
            verified::token::TOKEN_WORD_CAPACITY);
    }
    let kinds:[i32];
    {
        let allocation: ptr = verified::host::alloc_i32(
            verified::extraction::TOKEN_KIND_CAPACITY);
        if (allocation == 0) { return exit_code(AllocationFailed); }
        kinds = verified::host::i32_slice_from_raw_parts(allocation,
            verified::extraction::TOKEN_KIND_CAPACITY);
    }
    let workspace_memory: ptr = verified::host::alloc_i32(
        WORK_WORD_CAPACITY);
    if (workspace_memory == 0) { return exit_code(AllocationFailed); }
    let workspace:[i32] = verified::host::i32_slice_from_raw_parts(
        workspace_memory, WORK_WORD_CAPACITY);
    let semantic_memory: ptr = verified::host::alloc(
        verified::semantic_tokens::allocation_bytes(
            verified::extraction::TOKEN_KIND_CAPACITY),
        verified::semantic_tokens::ALIGNMENT);
    if (semantic_memory == 0) { return exit_code(AllocationFailed); }
    let output:[i32];
    if (mode == LeanCoreMode) {
        output = verified::host::i32_slice_from_raw_parts(
            workspace_memory, WORK_WORD_CAPACITY);
    } else {
        // Checked Lean output starts while parser scratch is still in use.
        let allocation: ptr = verified::host::alloc_i32(OUTPUT_BYTE_CAPACITY);
        if (allocation == 0) { return exit_code(AllocationFailed); }
        output = verified::host::i32_slice_from_raw_parts(
            allocation, OUTPUT_BYTE_CAPACITY);
    }
    let node_counts_memory: ptr = verified::host::alloc_i32(
        lowering::program_transport::BUNDLE_UNIT_LIMIT);
    if (node_counts_memory == 0) { return exit_code(AllocationFailed); }
    let node_counts: [i32] = verified::host::i32_slice_from_raw_parts(
        node_counts_memory, lowering::program_transport::BUNDLE_UNIT_LIMIT);
    let packed_io:[i32];
    {
        let allocation: ptr = verified::host::alloc_i32(
            verified::byte_io::PACKED_IO_WORDS);
        if (allocation == 0) { return exit_code(AllocationFailed); }
        packed_io = verified::host::i32_slice_from_raw_parts(
            allocation, verified::byte_io::PACKED_IO_WORDS);
    }
    let bundle_word_count: i32 =
        lowering::program_transport::bundle_words(unit_count);
    if (bundle_word_count <= 0) { return exit_code(AllocationFailed); }
    let bundle_memory: ptr = verified::host::alloc(
        bundle_word_count * verified::host::I32_BYTES,
        lowering::program_transport::BUNDLE_ALIGNMENT);
    if (bundle_memory == 0) { return exit_code(AllocationFailed); }
    let bundle: lowering::program_transport::Bundle =
        lowering::program_transport::from_raw_parts(bundle_memory, unit_count);
    let packed_path_pointer: ptr = verified::host::i32_slice_data_ptr(packed_path);
    let packed_io_pointer: ptr = verified::host::i32_slice_data_ptr(packed_io);
    if (verified::grammar::load(grammar, verified::grammar::WORDS)
        != verified::grammar::WORDS) {
        return exit_code(GrammarLoadFailed);
    }
    let output_length: i32 = 0;
    if (emits_typed_frontend(mode)) {
        output_length = verified::lean_frontend::begin(
            output, OUTPUT_BYTE_CAPACITY, 0);
        if (output_length < 0) { return exit_code(LeanCoreOutputFailed); }
    }
    let argument: i32 = first_argument;
    while (argument != argument_count) {
        let path_length: i32 = driver::arguments::length(argument);
        if (path_length <= 0 || path_length > PATH_BYTE_CAPACITY) {
            return exit_code(PathTooLong);
        }
        if (driver::arguments::read(argument, packed_path_pointer, path_length)
            != path_length) {
            return exit_code(ArgumentReadFailed);
        }
        let handle: i32 = verified::host::open_read(packed_path_pointer, path_length);
        if (handle <= -1) {
            return exit_code(OpenFailed);
        }
        let source_length: i32 = verified::byte_io::read_file(handle, source,
            verified::extraction::SOURCE_BYTE_CAPACITY, packed_io);
        let closed: i32 = verified::host::close(handle);
        if (source_length <= -1 || closed <= -1) {
            verified::byte_io::write_stderr_natural(argument);
            if (source_length <= -1) {
                verified::byte_io::write_stderr_natural(0 - source_length);
            } else {
                verified::byte_io::write_stderr_natural(0);
            }
            return exit_code(ReadFailed);
        }
        let syntax_input: verified::extraction::SyntaxInput =
            verified::extraction::SyntaxInput {
                source: verified::extraction::buffer(source, source_length),
                grammar: verified::extraction::buffer(grammar,
                    verified::grammar::WORDS),
            };
        let unit: i32 = argument - first_argument;
        let native_tokens: verified::token::TokenTable =
            lowering::program_transport::native_token_storage(bundle, unit);
        let parser_storage: verified::parser::WorkspaceStorage =
            verified::parser::storage(
                verified::host::i32_slice_data_ptr(workspace),
                verified::extraction::PARSER_WORK_WORD_CAPACITY);
        let artifact_token_words: i32 = 0;
        if (emits_typed_frontend(mode)) {
            artifact_token_words = verified::token::TOKEN_WORD_CAPACITY;
        }
        let recognition_workspace:
            verified::extraction::NativeRecognitionWorkspace =
            verified::extraction::NativeRecognitionWorkspace {
                tokens: native_tokens,
                raw_tokens: verified::extraction::buffer(raw,
                    artifact_token_words),
                canonical_tokens: verified::extraction::buffer(canonical,
                    artifact_token_words),
                token_kinds: verified::extraction::buffer(kinds,
                    verified::extraction::TOKEN_KIND_CAPACITY),
                parser_workspace: parser_storage,
            };
        let recognized: verified::extraction::SyntaxRecognition =
            verified::extraction::recognize_native_syntax(syntax_input,
                recognition_workspace);
        if (!verified::extraction::recognition_succeeded(recognized)) {
            return exit_code(ExtractionFailed);
        }
        let raw_count: i32 = recognized.raw_count;
        let tokens: i32 =
            verified::extraction::recognition_token_count(recognized);
        let tree: verified::syntax_tree::Tree =
            verified::syntax_tree::materialize_native(
                verified::extraction::recognition_parse(recognized),
                parser_storage, tokens,
                verified::extraction::DEFAULT_PARSE_DEPTH_LIMIT,
                verified::extraction::PARSE_NODE_CAPACITY,
                verified::extraction::PARSE_RECORD_WORD_CAPACITY);
        if (tree.node_count <= 0) { return exit_code(ExtractionFailed); }
        let nodes: i32 = tree.node_count;
        let semantic_output:
            verified::semantic_tokens::AssignmentBuffer =
            verified::semantic_tokens::from_raw_parts(semantic_memory,
                verified::extraction::TOKEN_KIND_CAPACITY);
        if (emits_typed_frontend(mode)) {
            if (verified::semantic_tokens::collect_native(grammar,
                    verified::grammar::WORDS, kinds, tokens,
                    tree, semantic_output) != 0) {
                return exit_code(SemanticFailed);
            }
        }
        let source_region: lowering::program_transport::WordRegion =
            lowering::program_transport::region(source, source_length);
        let native_unit: lowering::program_transport::NativeUnit =
            lowering::program_transport::NativeUnit {
                source: source_region,
                token_count: tokens,
                tree: tree,
            };
        if (!lowering::program_transport::append_native_unit(
            bundle, unit, native_unit)) {
            return exit_code(BundleFailed);
        }
        if (emits_typed_frontend(mode)) {
            node_counts[unit] = nodes;
            let frontend_unit: verified::lean_frontend::Unit =
                verified::lean_frontend::Unit {
                    raw: verified::lean_frontend::token_trace(raw, raw_count),
                    canonical: native_tokens,
                    token_count: tokens,
                    semantic: semantic_output,
                    tree: tree,
                    grammar: grammar,
                    grammar_length: verified::grammar::WORDS,
                    source_length: source_length,
                };
            output_length = verified::lean_frontend::emit_unit(frontend_unit,
                unit, output, OUTPUT_BYTE_CAPACITY, output_length);
            if (output_length < 0) { return exit_code(LeanCoreOutputFailed); }
        }
        argument += 1;
    }
    if (emits_typed_frontend(mode)) {
        output_length = verified::lean_frontend::finish(unit_count,
            node_counts, output, OUTPUT_BYTE_CAPACITY, output_length);
        if (output_length < 0) { return exit_code(LeanCoreOutputFailed); }
    }
    let lowered: lowering::program_transport::LoweredProgram =
        lowering::program_transport::lower_units(
            bundle, 0, lowering::transport::NativeOnly);
    if (!lowering::program_transport::succeeded(lowered.status)) {
        let error: i32 = lowering::program_transport::error_code(
            lowered.status);
        if (error > 0) {
            verified::byte_io::write_stderr_natural(error);
        }
        return exit_code(LoweringFailed);
    }
    if (emits_typed_frontend(mode)) {
        output_length = verified::lean_program::emit_declarations(
            lowered.program, output, OUTPUT_BYTE_CAPACITY, output_length);
    } else {
        output_length = verified::lean_program::emit(lowered.program,
            output, OUTPUT_BYTE_CAPACITY, output_length);
    }
    if (output_length <= -1) { return exit_code(LeanCoreOutputFailed); }
    let output_size: usize = output_length;
    let output_pointer: ptr = verified::host::i32_slice_data_ptr(output);
    if (verified::host::write_stdout(output_pointer, output_size) != output_length) {
        return exit_code(OutputWriteFailed);
    }
    return exit_code(Success);
}
