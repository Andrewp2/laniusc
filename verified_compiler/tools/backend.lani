module app::main;
import backend::compile;
import backend::program;
import backend::image;
import backend::image_boundary;
import backend::frame;
import driver::arguments;
import verified::host;
import verified::byte_io;

const RAW_OPTION_LENGTH: i32 = 5;
const PATH_BYTE_CAPACITY: i32 = 1024;
const PACKED_PATH_WORD_CAPACITY: i32 =
    PATH_BYTE_CAPACITY / verified::host::I32_BYTES;
const INPUT_BYTE_CAPACITY: i32 =
    backend::compile::MAX_WORDS * verified::host::I32_BYTES;

// Read Core syntax and emit a complete Linux x86-64 ELF. --raw emits the same
// linked program without process startup, for focused ABI/machine tests.
fn main() -> i32 {
    let arguments: i32 = driver::arguments::count();
    if (arguments != 2 && arguments != 3) { return 1; }
    let path_index: i32 = arguments - 1;
    let path_length: i32 = driver::arguments::length(path_index);
    if (path_length <= 0 || path_length > PATH_BYTE_CAPACITY) { return 2; }
    let path: ptr = verified::host::alloc_i32(PACKED_PATH_WORD_CAPACITY);
    let raw: ptr = verified::host::alloc_i32(INPUT_BYTE_CAPACITY);
    let packed: ptr = verified::host::alloc_i32(
        verified::byte_io::PACKED_IO_WORDS);
    let words: ptr = verified::host::alloc_i32(backend::compile::MAX_WORDS);
    let function_words: ptr = verified::host::alloc_i32(
        backend::compile::MAX_WORDS);
    let work: ptr = verified::host::alloc(
        backend::image_boundary::WORK_CAPACITY
            * verified::host::I32_BYTES,
        backend::frame::WORK_ALIGNMENT);
    let code: ptr = verified::host::alloc_i32(
        backend::image_boundary::OUTPUT_CAPACITY);
    if (path == 0 || raw == 0 || packed == 0 || words == 0 || function_words == 0 || work == 0 || code == 0) { return 3; }
    if (arguments == 3) {
        let option: [i32] = verified::host::i32_slice_from_raw_parts(
            path, PACKED_PATH_WORD_CAPACITY);
        if (!driver::arguments::matches(
                1, option, "--raw", RAW_OPTION_LENGTH)) { return 1; }
    }
    let size: usize = path_length;
    if (driver::arguments::read(path_index, path, path_length)
        != path_length) { return 4; }
    let handle: i32 = verified::host::open_read(path, size);
    if (handle < 0) { return 5; }
    let bytes: [i32] = verified::host::i32_slice_from_raw_parts(
        raw, INPUT_BYTE_CAPACITY);
    let scratch: [i32] = verified::host::i32_slice_from_raw_parts(
        packed, verified::byte_io::PACKED_IO_WORDS);
    let length: i32 = verified::byte_io::read_file(
        handle, bytes, INPUT_BYTE_CAPACITY, scratch);
    let closed: i32 = verified::host::close(handle);
    if (length < 0 || length % verified::host::I32_BYTES != 0
        || closed < 0) { return 6; }
    let input: [i32] = verified::host::i32_slice_from_raw_parts(
        words, backend::compile::MAX_WORDS);
    let index: i32 = 0;
    while (index < length / verified::host::I32_BYTES) {
        let byte: i32 = index * verified::host::I32_BYTES;
        input[index] = bytes[byte]
            | (bytes[byte + 1] << verified::host::BITS_PER_BYTE)
            | (bytes[byte + 2] << (verified::host::BITS_PER_BYTE * 2))
            | (bytes[byte + 3] << (verified::host::BITS_PER_BYTE * 3));
        index += 1;
    }
    let function_input: [i32] = verified::host::i32_slice_from_raw_parts(
        function_words, backend::compile::MAX_WORDS);
    let workspace: backend::frame::Workspace =
        backend::frame::from_raw_parts(
            work, backend::image_boundary::WORK_CAPACITY);
    let output: [i32] = verified::host::i32_slice_from_raw_parts(
        code, backend::image_boundary::OUTPUT_CAPACITY);
    let emitted: i32 = -1;
    if (arguments == 3) {
        emitted = backend::program::compile(
            backend::compile::region(
                input, length / verified::host::I32_BYTES),
            backend::compile::region(
                function_input, backend::compile::MAX_WORDS),
            workspace,
            backend::compile::cursor(
                output, backend::image_boundary::OUTPUT_CAPACITY, 0));
    } else {
        emitted = backend::image::compile(
            backend::compile::region(
                input, length / verified::host::I32_BYTES),
            backend::compile::region(
                function_input, backend::compile::MAX_WORDS),
            workspace,
            backend::compile::region(
                output, backend::image_boundary::OUTPUT_CAPACITY));
    }
    if (emitted < 0) { return 7; }
    if (verified::byte_io::write_stdout(output, emitted, packed) != emitted) { return 8; }
    return 0;
}
