module lexer_canonical_tokens;

import verified::canonical_tokens;
import verified::host;
import verified::token;

fn main() -> i32 {
    let source: [i32; 14] = [
        108, 101, 116, 32, 108, 101, 116, 116, 101, 114, 32, 102, 110, 0,
    ];
    if (verified::canonical_tokens::keyword_token(source, 0, 3)
        != verified::token::LetKeyword) {
        return 1;
    }
    if (verified::canonical_tokens::keyword_token(source, 4, 10)
        != verified::token::Identifier) {
        return 2;
    }
    if (verified::canonical_tokens::keyword_token(source, 11, 13)
        != verified::token::FnKeyword) {
        return 3;
    }
    if (!verified::canonical_tokens::is_trivia(
            verified::token::Whitespace)) {
        return 4;
    }
    if (verified::canonical_tokens::is_trivia(
            verified::token::Integer)) {
        return 5;
    }

    let range_source: [i32; 5] = [49, 46, 46, 61, 50];
    let memory: ptr = verified::host::alloc(
        4 * verified::token::RECORD_BYTES,
        verified::token::ALIGNMENT);
    if (memory == 0) { return 8; }
    let table: verified::token::TokenTable =
        verified::token::from_raw_parts(memory, 4);
    let rows: [verified::token::TokenRow] = table.data;
    rows[0] = verified::token::TokenRow {
        kind: verified::token::Integer, start: 0, finish: 1,
    };
    rows[1] = verified::token::TokenRow {
        kind: verified::token::DotDot, start: 1, finish: 3,
    };
    rows[2] = verified::token::TokenRow {
        kind: verified::token::Assign, start: 3, finish: 4,
    };
    rows[3] = verified::token::TokenRow {
        kind: verified::token::Integer, start: 4, finish: 5,
    };
    let range_count: i32 =
        verified::canonical_tokens::canonicalize_rows_in_place(
            range_source, table, 4);
    if (range_count != 4) { return 6; }
    if (rows[1].kind != verified::token::DotDotEqual) { return 7; }
    return 0;
}
