fn record(records:[i32], base: i32, node: i32, production: i32, children: i32) {
    let offset: i32 = base + node * 32;
    records[offset] = production;
    records[offset + 3] = children;
}
fn state(records:[i32], base: i32, node: i32, index: i32, child: i32) {
    let offset: i32 = base + node * 32 + 4 + index * 3;
    records[offset] = verified::parser::CHILD_STATE;
    records[offset + 1] = child;
}
fn make_tree(records:[i32], offsets:[i32], record_base: i32, offset_base: i32) {
    let node: i32 = 0;
    while (node <= 11) {
        offsets[offset_base + node] = node * 32;
        record(records, record_base, node, 0, 0);
        node += 1;
    }
    // The body lowerer only needs a valid function declaration, block, and
    // empty statement list. Other nodes are inert but remain bounded records.
    record(records, record_base, 9, 74, 0);
    record(records, record_base, 10, 12, 2);
    state(records, record_base, 10, 0, 9);
    state(records, record_base, 10, 1, 9);
    record(records, record_base, 11, 11, 9);
    let index: i32 = 0;
    while (index <= 8) {
        state(records, record_base, 11, index, 9);
        index += 1;
    }
    state(records, record_base, 11, 8, 10);
}
fn lower(descriptors:[i32], contexts:[i32], transports:[i32], declarations_catalog:[i32], source_catalog:[i32], token_catalog:[i32], record_catalog:[i32], offsets_catalog:[i32], type_arena_catalog:[i32], resolution_catalog:[i32], signatures_catalog:[i32], allocated:[i32], source_scratch:[i32], token_scratch:[i32], record_scratch:[i32], offsets_scratch:[i32], type_arena_scratch:[i32], resolution_scratch:[i32], declaration_scratch:[i32], allocation_scratch:[i32], signature_scratch:[i32], expression_arena:[i32], type_output:[i32], body_scratch:[i32], body_catalog:[i32]) -> i32 {
    return lowering::body_units::lower_units(descriptors, 8, 2, contexts, 24, transports, 16, declarations_catalog, 48, source_catalog, 18, token_catalog, 12, record_catalog, 768, offsets_catalog, 24, type_arena_catalog, 128, resolution_catalog, 0, signatures_catalog, 28, allocated, 48, 48, source_scratch, 16, token_scratch, 12, record_scratch, 384, offsets_scratch, 12, type_arena_scratch, 64, resolution_scratch, 1, declaration_scratch, 24, allocation_scratch, 28, signature_scratch, 14, expression_arena, 128, type_output, 64, body_scratch, 32, body_catalog, 32);
}
