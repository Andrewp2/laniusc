module app::main;

enum Choice {
    C0, C1, C2, C3, C4, C5, C6, C7,
    C8, C9, C10, C11, C12, C13, C14, C15,
    Invalid,
}

fn code(choice: Choice) -> i32 {
    return match (choice) {
        C0 -> 0, C1 -> 1, C2 -> 2, C3 -> 3,
        C4 -> 4, C5 -> 5, C6 -> 6, C7 -> 7,
        C8 -> 8, C9 -> 9, C10 -> 10, C11 -> 11,
        C12 -> 12, C13 -> 13, C14 -> 14, C15 -> 15,
        Invalid -> -1,
    };
}

fn main() -> i32 {
    return code(C4) - 4;
}
