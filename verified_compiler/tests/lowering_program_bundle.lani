module app::main;

import lowering::program_transport;
import verified::host;
import verified::token;

fn main() -> i32 {
    let count: i32 = 2;
    let words: i32 = lowering::program_transport::bundle_words(count);
    if (words <= 0) { return 1; }
    let memory: ptr = verified::host::alloc(
        words * verified::host::I32_BYTES,
        lowering::program_transport::BUNDLE_ALIGNMENT);
    if (memory == 0) { return 2; }
    let bundle: lowering::program_transport::Bundle =
        lowering::program_transport::from_raw_parts(memory, count);
    let source: [i32] = verified::host::i32_slice_from_raw_parts(
        verified::host::alloc_i32(2), 2);
    let tokens: [i32] = verified::host::i32_slice_from_raw_parts(
        verified::host::alloc_i32(verified::token::ROW_WORDS),
        verified::token::ROW_WORDS);
    let records: [i32] = verified::host::i32_slice_from_raw_parts(
        verified::host::alloc_i32(4), 4);
    let offsets: [i32] = verified::host::i32_slice_from_raw_parts(
        verified::host::alloc_i32(1), 1);
    source[0] = 11;
    source[1] = 12;
    tokens[0] = 13;
    tokens[1] = 1;
    tokens[2] = 2;
    records[0] = 14;
    offsets[0] = 15;
    let source_region: lowering::program_transport::WordRegion =
        lowering::program_transport::region(source, 2);
    let token_rows: lowering::program_transport::PackedTokenRows =
        lowering::program_transport::PackedTokenRows {
            data: tokens, words: verified::token::ROW_WORDS, count: 1 };
    let offset_region: lowering::program_transport::WordRegion =
        lowering::program_transport::region(offsets, 1);
    let parsed: lowering::program_transport::ParsedUnit =
        lowering::program_transport::ParsedUnit {
            source: source_region,
            canonical_tokens: token_rows,
            parse_records: records,
            node_offsets: offset_region,
            record_words: 4,
            raw_token_count: 1,
            path_length: 1,
        };
    if (!lowering::program_transport::append_parsed_unit(bundle, 0,
            parsed)) { return 3; }
    source[0] = 21;
    tokens[0] = 23;
    tokens[1] = 0;
    tokens[2] = 1;
    records[0] = 24;
    offsets[0] = 25;
    if (!lowering::program_transport::append_parsed_unit(bundle, 1,
            parsed)) { return 4; }
    let stored_sources: [i32] = bundle.sources;
    let stored_tokens: [verified::token::TokenRow] = bundle.tokens.data;
    let stored_records: [i32] = bundle.records;
    let stored_offsets: [i32] = bundle.offsets;
    if (stored_sources[0] != 11 || stored_sources[1] != 12
        || stored_sources[lowering::program_transport::BUNDLE_SOURCE_CAP] != 21) {
        return 5;
    }
    if (stored_tokens[0].kind != 13 || stored_tokens[0].start != 1
        || stored_tokens[0].finish != 2
        || stored_tokens[lowering::program_transport::BUNDLE_TOKEN_CAP].kind != 23
        || stored_tokens[lowering::program_transport::BUNDLE_TOKEN_CAP].start != 0
        || stored_tokens[lowering::program_transport::BUNDLE_TOKEN_CAP].finish != 1) {
        return 6;
    }
    if (stored_records[0] != 14
        || stored_records[lowering::program_transport::BUNDLE_RECORD_CAP] != 24) {
        return 7;
    }
    if (stored_offsets[0] != 15
        || stored_offsets[lowering::program_transport::BUNDLE_OFFSETS_CAP] != 25) {
        return 8;
    }
    if (lowering::program_transport::append_parsed_unit(bundle, count,
            parsed)) { return 9; }
    parsed.canonical_tokens.words = verified::token::ROW_WORDS - 1;
    if (lowering::program_transport::append_parsed_unit(bundle, 1,
            parsed)) { return 10; }
    return 0;
}
