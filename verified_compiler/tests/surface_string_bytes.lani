module app::main;

fn word(value: str, words: i32, index: i32) -> i32 {
    let bytes: [i32] = i32_slice_from_raw_parts(string_data_ptr(value), words);
    return bytes[index];
}

fn main() -> i32 {
    // All length residues, a word boundary, UTF-8, and embedded NUL. Checking
    // complete words also checks that unused high bytes are zero.
    if (word("%", 1, 0) != 37) { return 1; }
    if (word("AB", 1, 0) != 16961) { return 2; }
    if (word("ABC", 1, 0) != 4407873) { return 3; }
    if (word("ABCD", 1, 0) != 1145258561) { return 4; }
    if (word("ABCDE", 2, 0) != 1145258561
        || word("ABCDE", 2, 1) != 69) { return 5; }
    if (word("ABCDEFGH", 2, 1) != 1212630597
        || word("ABCDEFGHI", 3, 2) != 73) { return 6; }
    if (word("é", 1, 0) != 43459 || word("\0", 1, 0) != 0) { return 7; }
    let text: str = "AB";
    let first: ptr = string_data_ptr(text);
    let second: ptr = string_data_ptr(text);
    if (first == second) { return 8; }
    let a: [i32] = i32_slice_from_raw_parts(first, 1);
    let b: [i32] = i32_slice_from_raw_parts(second, 1);
    a[0] = -1;
    if (b[0] != 16961 || word(text, 1, 0) != 16961) { return 9; }
    let empty: ptr = string_data_ptr("");
    let other: ptr = string_data_ptr("");
    if (empty == 0 || other == 0 || empty == other) { return 10; }
    let empty_view: [i32] = i32_slice_from_raw_parts(empty, 0);
    return 37;
}
