fn record(records:[i32], base: i32, node: i32, production: i32, children: i32) {
    let offset: i32 = base + node * 28;
    records[offset] = production;
    records[offset + 3] = children;
}
fn state(records:[i32], base: i32, node: i32, index: i32, child: i32) {
    let offset: i32 = base + node * 28 + 4 + index * 3;
    records[offset] = verified::parser::CHILD_STATE;
    records[offset + 1] = child;
}
fn token(records:[i32], base: i32, node: i32, index: i32, value: i32) {
    let offset: i32 = base + node * 28 + 4 + index * 3;
    records[offset] = verified::parser::CHILD_TOKEN;
    records[offset + 1] = value;
}
fn make_tree(records:[i32], offsets:[i32], record_base: i32, offset_base: i32) {
    let node: i32 = 0;
    while (node <= 9) {
        offsets[offset_base + node] = node * 28;
        node += 1;
    }
    // i32 path type: segment, path tail, path, empty arguments, type.
    record(records, record_base, 0, 57, 1);
    token(records, record_base, 0, 0, 0);
    record(records, record_base, 1, 59, 0);
    record(records, record_base, 2, 56, 2);
    state(records, record_base, 2, 0, 0);
    state(records, record_base, 2, 1, 1);
    record(records, record_base, 3, 226, 0);
    record(records, record_base, 4, 69, 2);
    state(records, record_base, 4, 0, 2);
    state(records, record_base, 4, 1, 3); // The function declaration only needs the children read by signatures.
    record(records, record_base, 5, 232, 0);
    record(records, record_base, 6, 60, 0);
    record(records, record_base, 7, 36, 0);
    record(records, record_base, 8, 34, 2);
    state(records, record_base, 8, 0, 4);
    state(records, record_base, 8, 1, 4);
    record(records, record_base, 9, 11, 8);
    state(records, record_base, 9, 0, 5);
    token(records, record_base, 9, 1, 1);
    state(records, record_base, 9, 2, 5);
    state(records, record_base, 9, 3, 5);
    state(records, record_base, 9, 4, 6);
    state(records, record_base, 9, 5, 5);
    state(records, record_base, 9, 6, 8);
    state(records, record_base, 9, 7, 7);
}
