module app::main;

struct AnswerBox {
    value: i32,
}

enum Adjustment {
    Add(i32),
    Hold,
}

fn unbox(value: AnswerBox) -> i32 {
    return value.value;
}

fn apply(adjustment: Adjustment) -> i32 {
    return match (adjustment) {
        Add(amount) -> amount,
        Hold -> 0,
    };
}

fn main() -> i32 {
    let box: AnswerBox = AnswerBox { value: 42 };
    let adjustment: Adjustment = Add(unbox(box));
    if (apply(adjustment) != 42) { return 1; }
    if (apply(Hold) != 0) { return 2; }
    return 0;
}
