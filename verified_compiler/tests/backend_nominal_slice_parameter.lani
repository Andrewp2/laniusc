module app::main;

pub extern "lanius_alloc" fn alloc(size: usize, align: usize) -> ptr;

struct Pair {
    left: i32,
    right: i32,
}

fn first(values: [Pair]) -> i32 {
    return values[0].left;
}

fn main() -> i32 {
    let memory: ptr = alloc(16, 8);
    if (memory == 0) { return 1; }
    let values: [Pair] = slice_from_raw_parts(memory + 8, 1);
    values[0].left = 42;
    return first(values);
}
