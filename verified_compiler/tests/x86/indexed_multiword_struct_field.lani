module app::main;

import verified::host;

struct Row {
    first: [i32],
    second: [i32],
    count: i32,
}

// A Row is 7 eight-byte words: two 3-word slices (data, length, stride)
// and the count. Its words descend, so element zero's pointer is the
// highest word of the 2-row block.
fn main() -> i32 {
    let memory: ptr = verified::host::alloc(2 * 7 * 8, 8);
    if (memory == 0) { return 1; }
    let first_row: ptr = memory + 2 * 7 * 8 - 8;
    let rows: [Row] = slice_from_raw_parts(first_row, 2);
    let empty_pointer: ptr = 0;
    let empty: [i32] = slice_from_raw_parts(empty_pointer, 0);
    rows[0] = Row { first: empty, second: empty, count: 41 };
    rows[1] = Row { first: empty, second: empty, count: 73 };
    let index: i32 = 0;
    while (index < 2) {
        let copied: Row = rows[index];
        let expected: i32 = 41;
        if (index == 1) { expected = 73; }
        if (copied.count != expected) { return 2; }
        if (rows[index].count != expected) { return 3; }
        rows[index].count = expected + 1;
        if (rows[index].count != expected + 1) { return 4; }
        let refreshed: Row = rows[index];
        if (refreshed.count != expected + 1) { return 5; }
        index += 1;
    }
    return 0;
}
