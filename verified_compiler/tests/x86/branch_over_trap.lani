module app::main;

import x86::control;

// A taken Jcc skips the two-byte UD2; rejected encodings write no bytes.
fn main() -> i32 {
    let output: [i32; 8] = [90, 90, 90, 90, 90, 90, 90, 90];
    if (x86::control::branch_over_trap(output, 7, 0,
        x86::control::Equal) != -1) { return 1; }
    let index: i32 = 0;
    while (index < 8) {
        if (output[index] != 90) { return 2; }
        index += 1;
    }
    if (x86::control::branch_over_trap(output, 8, 0,
        x86::control::InvalidCondition) != -1) { return 3; }
    index = 0;
    while (index < 8) {
        if (output[index] != 90) { return 4; }
        index += 1;
    }
    if (x86::control::branch_over_trap(output, 8, 0,
        x86::control::Equal) != 8) { return 5; }
    if (output[0] != 15 || output[1] != 132 || output[2] != 2
        || output[3] != 0 || output[4] != 0 || output[5] != 0
        || output[6] != 15 || output[7] != 11) { return 6; }
    return 0;
}
