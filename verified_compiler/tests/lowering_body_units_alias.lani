module app::main;

import backend::syntax;
import lowering::aliases;
import lowering::allocation;
import lowering::body_context;
import lowering::body_units;
import lowering::declarations;
import lowering::signature_index;
import lowering::units;
import lowering::unit_descriptor;
import lowering::unit_context;
import lowering::signatures;
import lowering::types;
import lowering::value_catalog;
import verified::host;
import verified::parser;
import verified::surface_expr;
import verified::surface_type;
import verified::syntax_tree;
import verified::token;

const EXPRESSION_NODE_CAPACITY: i32 = 128
    / verified::surface_expr::NODE_FIELDS;
const ALLOCATION_WORDS: i32 = lowering::allocation::HEADER
    + 6 * lowering::allocation::ROW;
const UNIT_DECLARATION_WORDS: i32 = lowering::declarations::HEADER
    + 3 * lowering::declarations::ROW;
const CATALOG_DECLARATION_WORDS: i32 = 2 * UNIT_DECLARATION_WORDS;
const GLOBAL_DECLARATION_WORDS: i32 = lowering::declarations::HEADER
    + 6 * lowering::declarations::ROW;

fn record(records:[i32], offsets:[i32], base: i32, node: i32,
    production: i32, children: i32) {
    offsets[node] = node * 32;
    records[base + node * 32] = production;
    records[base + node * 32 + 1] = 0;
    records[base + node * 32 + 2] = 0;
    records[base + node * 32 + 3] = children;
    let index: i32 = 0;
    while (index <= children - 1) {
        token_child(records, base, node, index, 0);
        index += 1;
    }
}

fn state(records:[i32], base: i32, node: i32, index: i32, child_node: i32) {
    records[base + node * 32 + 4 + index * 3] = verified::parser::child_code(verified::parser::StateChild);
    records[base + node * 32 + 5 + index * 3] = child_node;
}

fn token_child(records:[i32], base: i32, node: i32, index: i32, token_id: i32) {
    records[base + node * 32 + 4 + index * 3] = verified::parser::child_code(verified::parser::TokenChild);
    records[base + node * 32 + 5 + index * 3] = token_id;
}

// A function body containing `let x: Alias = 0`. The type path is deliberately
// present in the surface tree so the body lowerer must resolve the unit alias.
fn make_tree(records:[i32], offsets:[i32], base: i32, offset_base: i32, unit: i32) {
    let node: i32 = 0;
    while (node <= 22) {
        offsets[offset_base + node] = node * 32;
        records[base + node * 32] = 0;
        records[base + node * 32 + 3] = 0;
        node += 1;
    }
    record(records, offsets, base, 0, 57, 1);
    token_child(records, base, 0, 0, 0);
    record(records, offsets, base, 1, 59, 0);
    record(records, offsets, base, 2, 56, 2);
    state(records, base, 2, 0, 0);
    state(records, base, 2, 1, 1);
    record(records, offsets, base, 3, 226, 0);
    record(records, offsets, base, 4, 69, 2);
    state(records, base, 4, 0, 2);
    state(records, base, 4, 1, 3);
    record(records, offsets, base, 5, 175, 1);
    token_child(records, base, 5, 0, 1);
    record(records, offsets, base, 6, 88, 2);
    state(records, base, 6, 1, 5);
    record(records, offsets, base, 7, 86, 2);
    state(records, base, 7, 1, 4);
    record(records, offsets, base, 8, 74, 0);
    record(records, offsets, base, 9, 75, 4);
    token_child(records, base, 9, 1, 2);
    state(records, base, 9, 2, 7);
    state(records, base, 9, 3, 6);
    record(records, offsets, base, 10, 48, 1);
    if (unit == 0) {
        token_child(records, base, 10, 0, 4);
    } else {
        token_child(records, base, 10, 0, 3);
    }
    record(records, offsets, base, 11, 51, 0);
    record(records, offsets, base, 12, 47, 2);
    state(records, base, 12, 0, 10);
    state(records, base, 12, 1, 11);
    record(records, offsets, base, 13, 165, 0);
    record(records, offsets, base, 14, 164, 0);
    record(records, offsets, base, 15, 161, 4);
    state(records, base, 15, 1, 13);
    state(records, base, 15, 3, 14);
    record(records, offsets, base, 16, 160, 2);
    state(records, base, 16, 0, 12);
    state(records, base, 16, 1, 15);
    record(records, offsets, base, 17, 85, 1);
    state(records, base, 17, 0, 16);
    record(records, offsets, base, 18, 73, 2);
    state(records, base, 18, 0, 17);
    state(records, base, 18, 1, 8);
    record(records, offsets, base, 19, 73, 2);
    state(records, base, 19, 0, 9);
    state(records, base, 19, 1, 18);
    record(records, offsets, base, 20, 12, 2);
    state(records, base, 20, 0, 8);
    if (unit == 0) {
        state(records, base, 20, 1, 19);
    } else {
        state(records, base, 20, 1, 8);
    }
    record(records, offsets, base, 21, 11, 9);
    let field: i32 = 0;
    while (field <= 7) {
        state(records, base, 21, field, 8);
        field += 1;
    }
    state(records, base, 21, 8, 20);
    record(records, offsets, base, 22, 73, 2);
    state(records, base, 22, 0, 17);
    state(records, base, 22, 1, 18);
}

fn declarations(table: lowering::declarations::Table, unit: i32) {
    lowering::declarations::table_write_header(table,
        lowering::declarations::DeclarationCounts {
        rows: 3, structures: 0, enumerations: 0, aliases: 1,
        constants: 0, functions: 1, externals: 0, modules: 1,
        imports: 0,
    });
    lowering::declarations::table_write_row(table, 0,
        lowering::declarations::DeclarationRow {
            unit: unit, kind: lowering::declarations::Module,
            is_public: false, item: 4, declaration: 1,
            name: -1, target: 0, ordinal: 0,
        });
    lowering::declarations::table_write_row(table, 1,
        lowering::declarations::DeclarationRow {
            unit: unit, kind: lowering::declarations::Alias,
            is_public: false, item: 3, declaration: 2,
            name: 1, target: 0, ordinal: 0,
        });
    let function_name: i32 = 3;
    if (unit == 0) {
        function_name = 5;
    }
    lowering::declarations::table_write_row(table, 2,
        lowering::declarations::DeclarationRow {
            unit: unit, kind: lowering::declarations::Function,
            is_public: false, item: 22, declaration: 21,
            name: function_name, target: -1, ordinal: 0,
        });
}

fn aliases(catalog: lowering::aliases::Table, unit: i32) {
    let module_memory: ptr = verified::host::alloc_i32(1);
    let symbol_memory: ptr = verified::host::alloc(
        lowering::aliases::SYMBOL_RECORD_BYTES,
        lowering::aliases::SYMBOL_ALIGNMENT);
    let module_tokens: [i32] = verified::host::i32_slice_from_raw_parts(
        module_memory, 1);
    let symbols: [lowering::aliases::AliasSymbol] = slice_from_raw_parts(
        symbol_memory + lowering::aliases::SYMBOL_RECORD_BYTES - 8, 1);
    module_tokens[0] = 0;
    symbols[0] = lowering::aliases::AliasSymbol {
        name_token: 0,
        target_kind: lowering::aliases::Scalar,
        target_value: 1,
    };
    catalog.data[unit] = lowering::aliases::Catalog {
        module_tokens: module_tokens,
        module_segments: 1,
        symbols: symbols,
        symbol_count: 1,
    };
}

fn source_and_tokens(source:[i32], tokens:[i32], unit: i32) {
    if (unit == 0) {
        let source_base: i32 = 0;
        source[source_base] = 65;
        source[source_base + 1] = 108;
        source[source_base + 2] = 105;
        source[source_base + 3] = 97;
        source[source_base + 4] = 115;
        source[source_base + 5] = 48;
        source[source_base + 6] = 120;
        source[source_base + 7] = 80;
        source[source_base + 8] = 97;
        source[source_base + 9] = 100;
        source[source_base + 10] = 84;
        source[source_base + 11] = 97;
        source[source_base + 12] = 114;
        source[source_base + 13] = 103;
        source[source_base + 14] = 101;
        source[source_base + 15] = 116;
        source[source_base + 16] = 67;
        source[source_base + 17] = 97;
        source[source_base + 18] = 108;
        source[source_base + 19] = 108;
        source[source_base + 20] = 101;
        source[source_base + 21] = 114;
        tokens[0] = verified::token::kind_code(verified::token::Identifier);
        tokens[1] = 0;
        tokens[2] = 5;
        tokens[3] = verified::token::kind_code(verified::token::Integer);
        tokens[4] = 5;
        tokens[5] = 6;
        tokens[6] = verified::token::kind_code(verified::token::Identifier);
        tokens[7] = 6;
        tokens[8] = 7;
        tokens[9] = verified::token::kind_code(verified::token::Identifier);
        tokens[10] = 7;
        tokens[11] = 10;
        tokens[12] = verified::token::kind_code(verified::token::Identifier);
        tokens[13] = 10;
        tokens[14] = 16;
        tokens[15] = verified::token::kind_code(verified::token::Identifier);
        tokens[16] = 16;
        tokens[17] = 22;
    } else {
        let source_base: i32 = 22;
        source[source_base] = 65;
        source[source_base + 1] = 108;
        source[source_base + 2] = 105;
        source[source_base + 3] = 97;
        source[source_base + 4] = 115;
        source[source_base + 5] = 48;
        source[source_base + 6] = 120;
        source[source_base + 7] = 84;
        source[source_base + 8] = 97;
        source[source_base + 9] = 114;
        source[source_base + 10] = 103;
        source[source_base + 11] = 101;
        source[source_base + 12] = 116;
        source[source_base + 13] = 67;
        source[source_base + 14] = 97;
        source[source_base + 15] = 108;
        source[source_base + 16] = 108;
        source[source_base + 17] = 101;
        source[source_base + 18] = 114;
        let token_base: i32 = 18;
        tokens[token_base] = verified::token::kind_code(
            verified::token::Identifier);
        tokens[token_base + 1] = 22;
        tokens[token_base + 2] = 27;
        tokens[token_base + 3] = verified::token::kind_code(
            verified::token::Integer);
        tokens[token_base + 4] = 27;
        tokens[token_base + 5] = 28;
        tokens[token_base + 6] = verified::token::kind_code(
            verified::token::Identifier);
        tokens[token_base + 7] = 28;
        tokens[token_base + 8] = 29;
        tokens[token_base + 9] = verified::token::kind_code(
            verified::token::Identifier);
        tokens[token_base + 10] = 29;
        tokens[token_base + 11] = 35;
        tokens[token_base + 12] = verified::token::kind_code(
            verified::token::Identifier);
        tokens[token_base + 13] = 35;
        tokens[token_base + 14] = 41;
    }
}

fn main() -> i32 {
    let descriptors_memory: ptr = verified::host::alloc(
        2 * lowering::declarations::TABLE_REF_BYTES,
        lowering::declarations::TABLE_REF_ALIGNMENT);
    let contexts_memory: ptr = verified::host::alloc(
        2 * lowering::unit_context::RECORD_BYTES,
        lowering::unit_context::ALIGNMENT);
    let transports_memory: ptr = verified::host::alloc(
        2 * lowering::unit_descriptor::RECORD_BYTES,
        lowering::unit_descriptor::ALIGNMENT);
    let declarations_catalog_memory: ptr = verified::host::alloc(
        CATALOG_DECLARATION_WORDS * verified::host::I32_BYTES,
        lowering::declarations::ALIGNMENT);
    let global_declarations_memory: ptr = verified::host::alloc(
        GLOBAL_DECLARATION_WORDS * verified::host::I32_BYTES,
        lowering::declarations::ALIGNMENT);
    let allocated_memory: ptr = verified::host::alloc(
        ALLOCATION_WORDS * verified::host::I32_BYTES,
        lowering::allocation::ALIGNMENT);
    let source_memory: ptr = verified::host::alloc(164, 4);
    let token_memory: ptr = verified::host::alloc(132, 4);
    let native_token_memory: ptr = verified::host::alloc(
        11 * verified::token::RECORD_BYTES, verified::token::ALIGNMENT);
    let record_memory: ptr = verified::host::alloc(5888, 4);
    let offsets_memory: ptr = verified::host::alloc(184, 4);
    let tree_memory: ptr = verified::host::alloc(
        2 * verified::syntax_tree::TREE_BYTES,
        verified::syntax_tree::ALIGNMENT);
    let value_catalog_memory: ptr = verified::host::alloc(
        3 * lowering::value_catalog::RECORD_BYTES,
        lowering::value_catalog::ALIGNMENT);
    let alias_catalog_memory: ptr = verified::host::alloc(
        2 * lowering::aliases::CATALOG_RECORD_BYTES,
        lowering::aliases::CATALOG_ALIGNMENT);
    let type_arena_scratch_memory: ptr = verified::host::alloc(
        verified::surface_type::allocation_bytes(7),
        verified::surface_type::ALIGNMENT);
    let resolution_scratch_memory: ptr = verified::host::alloc(
        lowering::types::RESOLUTION_RECORD_BYTES,
        lowering::types::RESOLUTION_ALIGNMENT);
    let value_scratch_memory: ptr = verified::host::alloc(
        2 * lowering::value_catalog::RECORD_BYTES,
        lowering::value_catalog::ALIGNMENT);
    let alias_work_memory: ptr = verified::host::alloc(64, 4);
    let expression_arena_memory: ptr = verified::host::alloc(
        verified::surface_expr::allocation_bytes(EXPRESSION_NODE_CAPACITY),
        verified::surface_expr::ALIGNMENT);
    let type_output_memory: ptr = verified::host::alloc(256, 4);
    let body_scratch_memory: ptr = verified::host::alloc(512, 4);
    let body_catalog_memory: ptr = verified::host::alloc(1024, 4);
    if (descriptors_memory == 0 || contexts_memory == 0 || transports_memory == 0
        || declarations_catalog_memory == 0
        || global_declarations_memory == 0
        || allocated_memory == 0 || source_memory == 0
        || token_memory == 0 || native_token_memory == 0
        || record_memory == 0 || offsets_memory == 0 || tree_memory == 0
        || value_catalog_memory == 0
        || alias_catalog_memory == 0 || type_arena_scratch_memory == 0
        || resolution_scratch_memory == 0 || value_scratch_memory == 0
        || alias_work_memory == 0
        || expression_arena_memory == 0 || type_output_memory == 0
        || body_scratch_memory == 0 || body_catalog_memory == 0) { return 1; }
    let descriptor_table: lowering::declarations::Catalog =
        lowering::declarations::catalog_from_raw_parts(descriptors_memory, 2);
    let context_table: lowering::unit_context::Table =
        lowering::unit_context::from_raw_parts(contexts_memory, 2);
    let contexts: [lowering::unit_context::UnitContext] =
        context_table.data;
    let transport_table: lowering::unit_descriptor::Table =
        lowering::unit_descriptor::from_raw_parts(transports_memory, 2);
    let transports: [lowering::unit_descriptor::UnitDescriptor] =
        transport_table.data;
    let global_declarations: lowering::declarations::Table =
        lowering::declarations::from_raw_parts(global_declarations_memory, 6);
    let allocation_table: lowering::allocation::Table =
        lowering::allocation::from_raw_parts(allocated_memory, 6);
    let source_catalog:[i32] = verified::host::i32_slice_from_raw_parts(source_memory, 41);
    let token_catalog:[i32] = verified::host::i32_slice_from_raw_parts(token_memory, 33);
    let record_catalog:[i32] = verified::host::i32_slice_from_raw_parts(record_memory, 1472);
    let offsets_catalog:[i32] = verified::host::i32_slice_from_raw_parts(offsets_memory, 46);
    let tree_catalog: verified::syntax_tree::Catalog =
        verified::syntax_tree::catalog_from_raw_parts(tree_memory, 2);
    let trees: [verified::syntax_tree::Tree] = tree_catalog.data;
    let resolution_catalog: lowering::types::ResolutionTable =
        lowering::types::from_raw_parts(resolution_scratch_memory, 0,
            lowering::types::IdentifierToken);
    let value_catalog: lowering::value_catalog::ValueTable =
        lowering::value_catalog::from_raw_parts(value_catalog_memory, 3);
    let alias_catalog: lowering::aliases::Table =
        lowering::aliases::from_raw_parts(alias_catalog_memory, 2);
    let type_arena_scratch: verified::surface_type::TypeArena =
        verified::surface_type::from_raw_parts(type_arena_scratch_memory, 7);
    let resolution_scratch: lowering::types::ResolutionTable =
        lowering::types::from_raw_parts(resolution_scratch_memory, 1,
            lowering::types::IdentifierToken);
    let value_scratch: lowering::value_catalog::ValueTable =
        lowering::value_catalog::from_raw_parts(value_scratch_memory, 2);
    let alias_work:[i32] = verified::host::i32_slice_from_raw_parts(alias_work_memory, 16);
    let expression_arena: verified::surface_expr::ExpressionArena =
        verified::surface_expr::from_raw_parts(expression_arena_memory,
            EXPRESSION_NODE_CAPACITY);
    let type_output:[i32] = verified::host::i32_slice_from_raw_parts(type_output_memory, 64);
    let body_scratch:[i32] = verified::host::i32_slice_from_raw_parts(body_scratch_memory, 128);
    let body_catalog:[i32] = verified::host::i32_slice_from_raw_parts(body_catalog_memory, 256);
    let unit: i32 = 0;
    while (unit <= 1) {
        let unit_declarations_memory: ptr = declarations_catalog_memory
            + unit * UNIT_DECLARATION_WORDS * verified::host::I32_BYTES;
        declarations(lowering::declarations::from_raw_parts(
            unit_declarations_memory, 3), unit);
        aliases(alias_catalog, unit);
        source_and_tokens(source_catalog, token_catalog, unit);
        make_tree(record_catalog, offsets_catalog, unit * 736, unit * 23, unit);
        if (unit == 0) {
            contexts[unit].source_offset = 0;
            contexts[unit].source_length = 22;
            contexts[unit].token_offset = 0;
            contexts[unit].token_count = 6;
        } else {
            contexts[unit].source_offset = 22;
            contexts[unit].source_length = 19;
            contexts[unit].token_offset = 6;
            contexts[unit].token_count = 5;
        }
        contexts[unit].node_count = 23;
        let unit_records: [i32] = verified::host::i32_slice_from_raw_parts(
            record_memory + unit * 736 * verified::host::I32_BYTES, 736);
        let unit_offsets: [i32] = verified::host::i32_slice_from_raw_parts(
            offsets_memory + unit * 23 * verified::host::I32_BYTES, 23);
        let decoded: verified::syntax_tree::Tree =
            verified::syntax_tree::decode(unit_records, 736,
                unit_offsets, 23, contexts[unit].token_count);
        if (decoded.node_count != 23) { return 38 + unit; }
        trees[unit] = decoded;
        let stored: verified::syntax_tree::Tree = trees[unit];
        if (stored.node_count != 23) { return 48 + unit; }
        contexts[unit].resolution_row_offset = 0;
        contexts[unit].resolution_count = 0;
        if (unit == 0) {
            contexts[unit].value_row_offset = 0;
            contexts[unit].value_count = 2;
        } else {
            contexts[unit].value_row_offset = 2;
            contexts[unit].value_count = 1;
        }
        transports[unit].source_offset = contexts[unit].source_offset;
        transports[unit].source_length = contexts[unit].source_length;
        transports[unit].token_offset = contexts[unit].token_offset;
        transports[unit].token_count = contexts[unit].token_count;
        unit += 1;
    }
    if (lowering::value_catalog::write_binding(value_catalog, 0,
            lowering::value_catalog::binding(4,
                lowering::value_catalog::CallableBinding,
                lowering::value_catalog::ImportedBinding, 3, -1, -1)) != 1
        || lowering::value_catalog::write_binding(value_catalog, 1,
            lowering::value_catalog::binding(5,
                lowering::value_catalog::CallableBinding,
                lowering::value_catalog::LocalBinding, 2, -1, -1)) != 2
        || lowering::value_catalog::write_binding(value_catalog, 2,
            lowering::value_catalog::binding(3,
                lowering::value_catalog::CallableBinding,
                lowering::value_catalog::LocalBinding, 3, -1, -1)) != 3) {
        return 20;
    }
    lowering::declarations::table_write_header(global_declarations,
        lowering::declarations::DeclarationCounts {
            rows: 6, structures: 0, enumerations: 0, aliases: 2,
            constants: 0, functions: 2, externals: 0, modules: 2,
            imports: 0,
        });
    let global_unit: i32 = 0;
    while (global_unit <= 1) {
        let local_row: i32 = 0;
        while (local_row <= 2) {
            let unit_memory: ptr = declarations_catalog_memory
                + global_unit * UNIT_DECLARATION_WORDS
                    * verified::host::I32_BYTES;
            let unit_table: lowering::declarations::Table =
                lowering::declarations::from_raw_parts(unit_memory, 3);
            lowering::declarations::table_write_row(global_declarations,
                global_unit * 3 + local_row,
                lowering::declarations::table_row(unit_table, local_row));
            local_row += 1;
        }
        global_unit += 1;
    }
    lowering::declarations::catalog_write_table(descriptor_table, 0,
        lowering::declarations::from_raw_parts(
            declarations_catalog_memory, 3));
    let second_declaration_memory: ptr = declarations_catalog_memory
        + UNIT_DECLARATION_WORDS * verified::host::I32_BYTES;
    lowering::declarations::catalog_write_table(descriptor_table, 1,
        lowering::declarations::from_raw_parts(
            second_declaration_memory, 3));
    let collected = lowering::units::accumulate(descriptor_table,
        allocation_table);
    if (!lowering::units::stage_succeeded(lowering::units::units_stage(collected))) {
        return 10 + lowering::units::stage_code(lowering::units::units_stage(collected));
    }
    let allocated_header: lowering::allocation::AllocationHeader =
        lowering::allocation::table_header(allocation_table);
    if (allocated_header.units != 2) { return 20; }
    if (allocated_header.rows != 6) { return 21; }
    if (allocated_header.declarations != 4) { return 22; }
    let first_allocation: lowering::allocation::AllocationRow =
        lowering::allocation::table_row(allocation_table, 1);
    let second_allocation: lowering::allocation::AllocationRow =
        lowering::allocation::table_row(allocation_table, 2);
    let last_allocation: lowering::allocation::AllocationRow =
        lowering::allocation::table_row(allocation_table, 5);
    if (lowering::allocation::row_declaration_id(first_allocation) != 0) { return 23; }
    if (lowering::allocation::row_declaration_id(second_allocation) != 2) { return 24; }
    if (lowering::allocation::row_core_id(second_allocation) != 2) { return 25; }
    if (lowering::allocation::row_declaration_id(last_allocation) != 3) { return 26; }
    if (lowering::allocation::row_core_id(last_allocation) != 3) { return 27; }
    let signature_requirements: lowering::signature_index::Requirements =
        lowering::signature_index::Requirements {
            entries: 4, members: 0, variants: 0, fields: 0,
            constants: 0, bytes: 0, valid: true,
        };
    let signature_index_bytes: usize =
        lowering::signature_index::allocation_bytes(signature_requirements);
    let signature_index_alignment: usize =
        lowering::signature_index::ALIGNMENT;
    let signature_index_memory: ptr = verified::host::alloc(
        signature_index_bytes, signature_index_alignment);
    let cursor_memory: ptr = verified::host::alloc(
        lowering::signature_index::WRITER_BYTES,
        lowering::signature_index::ALIGNMENT);
    if (signature_index_memory == 0 || cursor_memory == 0) { return 28; }
    let signature_storage: lowering::signature_index::Table =
        lowering::signature_index::from_raw_parts(signature_index_memory,
            signature_requirements);
    let writer: lowering::signature_index::Writer =
        lowering::signature_index::writer(signature_storage, cursor_memory);
    let first_signature: lowering::signatures::SignatureRecord =
        lowering::signatures::SignatureRecord {
            id: 2, declaration_kind: lowering::declarations::Function,
            shape: lowering::signatures::InternalFunctionShape,
            arity: 0, result_type: 1,
        };
    let second_signature: lowering::signatures::SignatureRecord =
        first_signature;
    second_signature.id = 3;
    if (!lowering::signature_index::push_record(writer, first_signature,
            0, -1, -1)
        || !lowering::signature_index::push_record(writer, second_signature,
            0, -1, -1)
        || !lowering::signature_index::complete(writer)) { return 29; }
    let signature_index: lowering::signature_index::Table =
        lowering::signature_index::finish(writer);
    let native_tokens: verified::token::TokenTable =
        verified::token::from_raw_parts(native_token_memory, 11);
    if (!verified::token::decode_packed(token_catalog, 33, 11,
            native_tokens, 0)) { return 1; }
    let inputs: lowering::body_units::BodyUnitInputs =
        lowering::body_units::BodyUnitInputs {
            unit_count: 2,
            contexts: context_table,
            transport_descriptors: transport_table,
            unit_declarations: descriptor_table,
            global_declarations: global_declarations,
            sources: lowering::body_units::region(source_catalog, 41),
            tokens: native_tokens,
            trees: tree_catalog,
            resolutions: resolution_catalog,
            values: value_catalog,
            signature_index: signature_index,
            allocations: allocation_table,
            aliases: alias_catalog,
        };
    let workspace: lowering::body_units::BodyUnitWorkspace =
        lowering::body_units::BodyUnitWorkspace {
            type_arena: type_arena_scratch,
            resolutions: resolution_scratch,
            values: value_scratch,
            expressions: expression_arena,
            type_output: lowering::body_units::region(type_output, 64),
            body: lowering::body_units::region(body_scratch, 128),
            body_catalog: lowering::body_units::region(body_catalog, 256),
            alias_work: lowering::body_units::region(alias_work, 16),
        };
    let words: i32 = lowering::body_units::lower_units_owned(inputs, workspace);
    if (words <= 0) { return 30; }
    if (transports[0].body_offset != 0) { return 31; }
    if (transports[0].body_words <= 12) { return 32; }
    if (transports[1].body_offset != transports[0].body_words) { return 33; }
    if (body_catalog[7] != 2) { return 34; }
    if (body_catalog[18] != backend::syntax::statement_code(backend::syntax::StatementExpression)
        || body_catalog[19] != backend::syntax::expression_code(backend::syntax::ExprCall)
        || body_catalog[20] != 3) { return 36; }
    let calls: i32 = 0;
    let scan: i32 = lowering::body_context::HEADER;
    while (scan <= transports[0].body_words - 1) {
        if (body_catalog[scan] == backend::syntax::expression_code(backend::syntax::ExprCall)) {
            if (body_catalog[scan + 1] != 3) { return 37; }
            calls += 1;
        }
        scan += 1;
    }
    if (calls != 1) { return 38; }
    if (body_catalog[transports[1].body_offset + 7] != 3) { return 35; }
    inputs.allocations = lowering::allocation::table_with_rows(
        allocation_table, 5);
    if (lowering::body_units::lower_units_owned(inputs, workspace) >= 0) {
        return 48;
    }
    inputs.allocations = allocation_table;
    let full_declarations: lowering::declarations::Table =
        inputs.global_declarations;
    inputs.global_declarations = lowering::declarations::table_with_rows(
        full_declarations, 5);
    if (lowering::body_units::lower_units_owned(inputs, workspace) >= 0) {
        return 49;
    }
    inputs.global_declarations = full_declarations;
    let first_binding: lowering::value_catalog::ValueBinding =
        lowering::value_catalog::read_binding(value_catalog, 0);
    let second_binding: lowering::value_catalog::ValueBinding =
        lowering::value_catalog::read_binding(value_catalog, 1);
    if (lowering::value_catalog::write_binding(value_catalog, 0,
            lowering::value_catalog::binding(4,
                lowering::value_catalog::CallableBinding,
                lowering::value_catalog::LocalBinding, 2, -1, -1)) != 1
        || lowering::value_catalog::write_binding(value_catalog, 1,
            lowering::value_catalog::binding(4,
                lowering::value_catalog::CallableBinding,
                lowering::value_catalog::ImportedBinding, 3, -1, -1)) != 2
        || !lowering::value_catalog::valid_slice(value_catalog, 0, 2,
            6, allocation_table)) { return 44; }
    if (lowering::value_catalog::write_binding(value_catalog, 0,
            first_binding) != 1
        || lowering::value_catalog::write_binding(value_catalog, 1,
            second_binding) != 2) { return 45; }
    let valid_binding: lowering::value_catalog::ValueBinding =
        lowering::value_catalog::read_binding(value_catalog, 2);
    let invalid_binding: lowering::value_catalog::ValueBinding =
        lowering::value_catalog::binding(3,
            lowering::value_catalog::InvalidBinding,
            lowering::value_catalog::LocalBinding, 3, -1, -1);
    if (lowering::value_catalog::write_binding(value_catalog, 2,
            invalid_binding) != 3
        || lowering::body_units::lower_units_owned(inputs, workspace) >= 0) {
        return 39;
    }
    if (lowering::value_catalog::write_binding(value_catalog, 2,
            valid_binding) != 3) { return 40; }
    if (lowering::value_catalog::write_binding(value_catalog, 1,
            lowering::value_catalog::binding(4,
                lowering::value_catalog::CallableBinding,
                lowering::value_catalog::ImportedBinding, 2, -1, -1)) != 2
        || lowering::body_units::lower_units_owned(inputs, workspace) >= 0) {
        return 42;
    }
    if (lowering::value_catalog::write_binding(value_catalog, 1,
            second_binding) != 2) { return 43; }
    if (lowering::value_catalog::write_binding(value_catalog, 1,
            lowering::value_catalog::binding(3,
                lowering::value_catalog::CallableBinding,
                lowering::value_catalog::LocalBinding, 2, -1, -1)) != 2
        || lowering::value_catalog::valid_slice(value_catalog, 0, 2,
            6, allocation_table)) { return 46; }
    if (lowering::value_catalog::write_binding(value_catalog, 1,
            second_binding) != 2) { return 47; }
    contexts[1].value_row_offset = 1;
    if (lowering::body_units::lower_units_owned(inputs, workspace) >= 0) {
        return 41;
    }
    return 0;
}
