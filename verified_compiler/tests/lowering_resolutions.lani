module app::main;

import lowering::resolutions;
import lowering::types;
import verified::host;

// Focused one-unit resolution contract: allocation rows are authenticated
// against declaration rows and produce a deterministic nominal tag; malformed
// declaration-name order fails closed.
fn main() -> i32 {
    let source_memory: ptr = verified::host::alloc(32, 4);
    let token_memory: ptr = verified::host::alloc(32, 4);
    let arena_memory: ptr = verified::host::alloc(128, 4);
    let declaration_memory: ptr = verified::host::alloc(128, 4);
    let allocation_memory: ptr = verified::host::alloc(160, 4);
    let output_memory: ptr = verified::host::alloc(32, 4);
    let result_memory: ptr = verified::host::alloc(32, 4);
    if (source_memory == 0 || token_memory == 0 || arena_memory == 0
        || declaration_memory == 0 || allocation_memory == 0
        || output_memory == 0 || result_memory == 0) { return 1; }
    let source: [i32] = verified::host::i32_slice_from_raw_parts(source_memory, 8);
    let tokens: [i32] = verified::host::i32_slice_from_raw_parts(token_memory, 12);
    let declarations: [i32] = verified::host::i32_slice_from_raw_parts(declaration_memory, 32);
    let allocated: [i32] = verified::host::i32_slice_from_raw_parts(allocation_memory, 40);
    let output: [i32] = verified::host::i32_slice_from_raw_parts(output_memory, 8);
    let result: [i32] = verified::host::i32_slice_from_raw_parts(result_memory, 8);
    let arena: [i32] = verified::host::i32_slice_from_raw_parts(arena_memory, 32);
    source[0] = 80;
    source[1] = 111;
    source[2] = 105;
    source[3] = 110;
    source[4] = 116;
    tokens[0] = 1;
    tokens[1] = 0;
    tokens[2] = 5;
    declarations[0] = 1;
    declarations[1] = 1;
    declarations[2] = 0;
    declarations[3] = 0;
    declarations[4] = 0;
    declarations[5] = 0;
    declarations[6] = 0;
    declarations[7] = 1;
    declarations[8] = 0;
    declarations[9] = 1;
    declarations[10] = 0;
    declarations[11] = 10;
    declarations[12] = 11;
    declarations[13] = 0;
    declarations[14] = -1;
    declarations[15] = 0;
    allocated[0] = 1;
    allocated[1] = 1;
    allocated[2] = 1;
    allocated[3] = 0;
    allocated[4] = 0;
    allocated[5] = 0;
    allocated[6] = 0;
    allocated[7] = 1;
    let index: i32 = 0;
    while (index < 8) {
        allocated[8 + index] = declarations[8 + index];
        index += 1;
    }
    allocated[16] = 0;
    allocated[17] = 0;
    if (lowering::resolutions::build(source, 5, tokens, 1, declarations, 16,
        allocated, 18, output, 8) != 4) { return 2; }
    if (output[0] != lowering::resolutions::MAGIC || output[1] != 1
        || output[2] != 0 || output[3] != lowering::types::STRUCTURE_BASE) { return 3; }
    tokens[3] = 1;
    tokens[4] = 0;
    tokens[5] = 5;
    arena[0] = 3;
    arena[1] = 0;
    arena[3] = -1;
    arena[5] = 0;
    arena[8] = -1;
    arena[9] = 1;
    arena[11] = 0;
    arena[16] = -1;
    arena[17] = 2;
    arena[19] = 1;
    if (lowering::types::lower(source, 5, tokens, 2, arena, 32, 2,
        output, 2, output, 0, output, 4, result, 8)
        != 0 - lowering::types::INVALID) { return 5; }
    output[0] = lowering::resolutions::MAGIC;
    output[1] = 2;
    output[2] = 0;
    output[3] = lowering::types::STRUCTURE_BASE;
    output[4] = 1;
    output[5] = lowering::types::STRUCTURE_BASE;
    if (lowering::types::lower(source, 5, tokens, 2, arena, 32, 2,
        output, 6, output, 0, output, 4, result, 8)
        != 0 - lowering::types::INVALID) { return 6; }
    declarations[13] = -1;
    allocated[8 + 5] = 1;
    if (lowering::resolutions::build(source, 5, tokens, 1, declarations, 16,
        allocated, 18, output, 8) >= 0) { return 4; }
    return 0;
}
