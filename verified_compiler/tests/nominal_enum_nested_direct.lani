module app::main;

enum Inner { Empty, Number(i32) }
enum Outer { Nothing, Wrapped(Inner) }

fn inner_value(value: Inner) -> i32 {
    return match (value) {
        Number(number) -> number,
        Empty -> -1,
    };
}

fn main() -> i32 {
    let inner: Inner = Number(7);
    let outer: Outer = Wrapped(inner);
    return match (outer) {
        Wrapped(payload) -> inner_value(payload) - 7,
        Nothing -> 1,
    };
}
