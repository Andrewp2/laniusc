module app::main;

import lowering::allocation;
import ir::type_ref;
import lowering::declarations;
import lowering::signature_index;
import lowering::signatures;
import lowering::value_collection;
import lowering::unit_context;
import lowering::value_catalog;
import verified::host;
import verified::token;

const ALLOCATION_WORDS: i32 = lowering::allocation::HEADER
    + lowering::allocation::ROW;

// A variant name belongs to the declaring unit's token arena.  The catalog
// must authenticate its spelling against the caller's token and retain the
// enum type, variant ordinal, payload arity, and imported scope.
fn main() -> i32 {
    let source: [i32; 9] = [83,111,109,101,0,83,111,109,101];
    let token_memory: ptr = verified::host::alloc(
        2 * verified::token::RECORD_BYTES, verified::token::ALIGNMENT);
    if (token_memory == 0) { return 2; }
    let token_table: verified::token::TokenTable =
        verified::token::from_raw_parts(token_memory, 2);
    let token_rows: [verified::token::TokenRow] = token_table.data;
    token_rows[0] = verified::token::TokenRow {
        kind: verified::token::Identifier, start: 0, finish: 4,
    };
    token_rows[1] = token_rows[0];
    let context_memory: ptr = verified::host::alloc(
        2 * lowering::unit_context::RECORD_BYTES,
        lowering::unit_context::ALIGNMENT);
    if (context_memory == 0) { return 2; }
    let context_table: lowering::unit_context::Table =
        lowering::unit_context::from_raw_parts(context_memory, 2);
    let contexts: [lowering::unit_context::UnitContext] =
        context_table.data;
    contexts[0] = lowering::unit_context::empty();
    contexts[0].source_offset = 0;
    contexts[0].source_length = 4;
    contexts[0].token_offset = 0;
    contexts[0].token_count = 1;
    contexts[1] = lowering::unit_context::empty();
    contexts[1].source_offset = 5;
    contexts[1].source_length = 4;
    contexts[1].token_offset = 1;
    contexts[1].token_count = 1;
    let allocation_memory: ptr = verified::host::alloc(
        ALLOCATION_WORDS * verified::host::I32_BYTES,
        lowering::allocation::ALIGNMENT);
    if (allocation_memory == 0) { return 4; }
    let allocation_table: lowering::allocation::Table =
        lowering::allocation::from_raw_parts(allocation_memory, 1);
    lowering::allocation::table_write_header(allocation_table,
        lowering::allocation::AllocationHeader {
        units: 2, rows: 1, structures: 0, enumerations: 1,
        aliases: 0, constants: 0, functions: 0, externals: 0,
        declarations: 1,
    });
    let source_row: lowering::declarations::DeclarationRow =
        lowering::declarations::DeclarationRow {
            unit: 1, kind: lowering::declarations::Enumeration,
            is_public: false, item: 0, declaration: 0, name: 0,
            target: -1, ordinal: 0,
        };
    let allocation_row: lowering::allocation::AllocationRow =
        lowering::allocation::AllocationRow {
            source: source_row, declaration_id: 0, core_id: 0,
        };
    lowering::allocation::table_write_row(allocation_table, 0,
        allocation_row);
    let requirements: lowering::signature_index::Requirements =
        lowering::signature_index::Requirements {
            entries: 1, members: 0, variants: 1, fields: 1,
            constants: 0, bytes: 0, valid: true,
        };
    let signature_memory: ptr = verified::host::alloc(
        lowering::signature_index::allocation_bytes(requirements),
        lowering::signature_index::ALIGNMENT);
    let cursor_memory: ptr = verified::host::alloc(
        lowering::signature_index::WRITER_BYTES,
        lowering::signature_index::ALIGNMENT);
    if (signature_memory == 0 || cursor_memory == 0) { return 5; }
    let signature_storage: lowering::signature_index::Table =
        lowering::signature_index::from_raw_parts(signature_memory,
            requirements);
    let writer: lowering::signature_index::Writer =
        lowering::signature_index::writer(signature_storage, cursor_memory);
    let variant_start: i32 = lowering::signature_index::variant_position(
        writer);
    let variant: i32 = lowering::signature_index::push_variant(writer, 0);
    let field_kind: ir::type_ref::TypeRef = ir::type_ref::I32;
    if (variant != variant_start
        || !lowering::signature_index::push_field(writer, variant, field_kind)
        || !lowering::signature_index::push_record(writer,
            lowering::signatures::SignatureRecord {
                id: 0,
                declaration_kind: lowering::declarations::Enumeration,
                shape: lowering::signatures::EnumerationShape,
                arity: 1, result_type: ir::type_ref::Invalid,
            }, -1, variant_start, -1)
        || !lowering::signature_index::complete(writer)) { return 6; }
    let signature_index: lowering::signature_index::Table =
        lowering::signature_index::finish(writer);
    let value_memory: ptr = verified::host::alloc(
        2 * lowering::value_catalog::RECORD_BYTES,
        lowering::value_catalog::ALIGNMENT);
    if (value_memory == 0) { return 3; }
    let output: lowering::value_catalog::ValueTable =
        lowering::value_catalog::from_raw_parts(value_memory, 2);
    let input: lowering::value_collection::ValueCatalogInput =
        lowering::value_collection::ValueCatalogInput {
            unit: 0,
            contexts: context_table,
            sources: lowering::value_collection::region(source, 9),
            tokens: token_table,
            allocations: allocation_table,
            signature_index: signature_index,
        };
    let rows: i32 = lowering::value_collection::build_value_catalog(input,
        output);
    let found: lowering::value_catalog::ValueBinding =
        lowering::value_catalog::read_binding(output, 0);
    let variant: bool = match (found.target) {
        lowering::value_catalog::Variant(value) -> value.type_id == 0
            && value.ordinal == 0 && value.field_count == 1,
        _ -> false,
    };
    if (rows != 1 || lowering::value_catalog::binding_token(found) != 0
        || !lowering::value_catalog::binding_is_kind(found,
            lowering::value_catalog::EnumVariantBinding)
        || !lowering::value_catalog::binding_is_scope(found,
            lowering::value_catalog::ImportedBinding)
        || !variant
        || !lowering::value_catalog::valid_slice(output, 0, rows, 1,
            allocation_table)) {
        return 1;
    }
    return 0;
}
