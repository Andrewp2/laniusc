import verified_compiler.tests.direct_byte_io_read_interface_step
import Lanius.Semantics.Representation

namespace ByteIoReadInterface

open Lanius Lanius.Core Lanius.Memory Lanius.Semantics ByteIoReadProof

/-- The original reader's storage domain and caller-visible geometry. -/
structure Configuration where
  address : Nat
  words : Nat
  destination : Nat
  capacity : Nat
  handle : Int

def Configuration.mutable (config : Configuration) (address : Address) : Prop :=
  (config.address ≤ address ∧ address < config.address + config.words * 4) ∨
  (config.destination ≤ address ∧ address < config.destination + config.capacity * 4)

def Configuration.values (config : Configuration) : LocalValues :=
  (((LocalValues.empty.set (reader.argumentId 0) (.signed .i32 config.handle)).set
    (reader.argumentId 1) (.rawSlice (.scalar (.signed .i32)) config.destination config.capacity)).set
    (reader.argumentId 2) (.signed .i32 config.capacity)).set
    (reader.argumentId 3) (.rawSlice (.scalar (.signed .i32)) config.address config.words)

def Configuration.readyValues (config : Configuration) : LocalValues :=
  config.values.set (reader.bindingId 0) (.pointer config.address)

def Configuration.loopValues (config : Configuration) (total : Nat) : LocalValues :=
  config.readyValues.set (reader.bindingId 1) (.signed .i32 total)

def Configuration.buffers (config : Configuration) : Rep :=
  Rep.and (Rep.readable config.address (config.words * 4))
    (Rep.readable config.destination (config.capacity * 4))

structure Context (origin base : State) extends Configuration where
  env : LocalEnv origin base toConfiguration.readyValues
  capacityFits : capacity < 2 ^ 31
  scratchSize : 16384 ≤ words
  separate : destination + capacity * 4 ≤ address ∨ address + words * 4 ≤ destination
  heap : base.heap = origin.heap
  world : base.world = origin.world
  views : base.i32ArrayViews = origin.i32ArrayViews

variable {origin base before after state : State} {context : Context origin base}
  {total : Nat} {completion : Completion}

structure Invariant (context : Context origin base) (state : State) (total : Nat) : Prop where
  env : LocalEnv origin state (context.toConfiguration.loopValues total)
  bounded : total ≤ context.capacity
  buffers : context.toConfiguration.buffers.holds state.heap
  unique : HeapBlockBasesUnique state.heap
  noViews : state.i32ArrayViews = []
  written : HeapWritesOn origin.heap state.heap context.toConfiguration.mutable

theorem Invariant.inputRoom (current : Invariant context state total) :
    state.heap.Readable context.address (context.words * 4) := current.buffers.1

theorem Invariant.outputRoom (current : Invariant context state total) :
    state.heap.Readable context.destination (context.capacity * 4) := current.buffers.2

def specification (config : Configuration) (total : Nat) : ReadStep.Specification :=
  ⟨config.address, config.destination, config.capacity, total, config.handle,
    if config.capacity - total < 65536 then config.capacity - total + 1 else 65536⟩

private def adjustment : Stmt := match reader.bindingStatement 3 with
  | .letLocal _ _ _ (.sequence first _) => first
  | _ => .skip

private def requestValues (config : Configuration) (total request : Nat) : LocalValues :=
  ((config.loopValues total).set (reader.bindingId 2) (.signed .i32 request)).set
    (reader.bindingId 3) (.signed .i32 (config.capacity - total : Nat))

/-- The legacy inner-copy boundary consumes ordinary facts from the shared
environment. Size scope construction and closing are generated by the WP rule. -/
private theorem read (current : Invariant context before total)
    (env : LocalEnv origin ready (requestValues context.toConfiguration total
      (specification context.toConfiguration total).request))
    (frame : DataFrame before ready) :
    EnvStmt extractedProgram origin ready (reader.bindingStatement 4)
      (fun next : Nat => (requestValues context.toConfiguration total
        (specification context.toConfiguration total).request).set (reader.bindingId 1) (.signed .i32 next))
      (fun next completion after => Step.Result (specification context.toConfiguration total) before completion after next) := by
  let request := (specification context.toConfiguration total).request
  have fits : request < 2 ^ 31 := by
    dsimp [request, specification]; split <;> have := context.capacityFits <;> have := current.bounded <;> omega
  have room : request ≤ context.words * 4 := by
    dsimp [request, specification]; split <;> have := context.scratchSize <;> omega
  have sizeFits : request < unsignedModulus extractedProgram.target .usize := by change request < 2 ^ 64; omega
  core_env_scopes env
  rename_i readEnv
  let input : ReadStep.Input _ := {
    address := context.address, words := context.words, destination := context.destination
    capacity := context.capacity, total := total, handle := context.handle, request := request
    capacityFits := context.capacityFits, totalBound := current.bounded, requestFits := fits, requestRoom := room
    inputRoom := by change ready.heap.Readable _ _; rw [frame.heap]; exact current.inputRoom
    outputRoom := by change ready.heap.Readable _ _; rw [frame.heap]; exact current.outputRoom
    separate := context.separate, formed := readEnv.formed
    unique := by change HeapBlockBasesUnique ready.heap; rw [frame.heap]; exact current.unique
    noViews := frame.views.trans current.noViews
    packed := readEnv.read rfl, output := readEnv.read rfl, cursor := readEnv.read rfl
    handleFound := readEnv.read rfl, pointerFound := readEnv.read rfl, sizeFound := readEnv.read rfl
    requestFound := readEnv.read rfl, remainingFound := readEnv.read rfl }
  apply EnvStmt.mono (Step.run input readEnv rfl rfl rfl)
  · intro next completion after finalEnv result
    exact result.prepend frame
  all_goals
    dsimp only [request, requestValues, Configuration.loopValues]
    core_env_values

private theorem adjustedRead (current : Invariant context before total)
    (env : LocalEnv origin ready (requestValues context.toConfiguration total 65536))
    (frame : DataFrame before ready) :
    EnvStmt extractedProgram origin ready (.sequence adjustment (reader.bindingStatement 4))
      (fun next : Nat => (requestValues context.toConfiguration total
        (specification context.toConfiguration total).request).set (reader.bindingId 1) (.signed .i32 next))
      (fun next completion after => Step.Result (specification context.toConfiguration total) before completion after next) := by
  have remaining := env.read (show requestValues context.toConfiguration total 65536 (reader.bindingId 3) =
    some (.signed .i32 (context.capacity - total : Nat)) from rfl)
  have request := env.read (show requestValues context.toConfiguration total 65536 (reader.bindingId 2) =
    some (.signed .i32 65536) from rfl)
  by_cases short : context.capacity - total < 65536
  · obtain ⟨changed, assigned, changedEnv, effect⟩ := env.assignI32 (program := extractedProgram)
      (id := reader.bindingId 2) (op := .set) (operand := ((context.capacity - total + 1 : Nat) : Int))
      (replacement := ((context.capacity - total + 1 : Nat) : Int)) rfl
      (show RunsExpr extractedProgram ready
        (match reader.effectExpression 0 with | .assign _ _ rhs => rhs | _ => .value .unit)
        (.signed .i32 (context.capacity - total + 1 : Nat)) ready from by
          have := context.capacityFits; have := current.bounded; core_run) rfl
    have maps : (requestValues context.toConfiguration total 65536).set (reader.bindingId 2)
        (.signed .i32 (context.capacity - total + 1 : Nat)) =
        requestValues context.toConfiguration total (specification context.toConfiguration total).request := by
      simp only [requestValues, specification, if_pos short]
      core_env_values
    exact EnvStmt.sequenceNext (by core_stmt) (read current (maps ▸ changedEnv) (frame.trans effect))
  · exact EnvStmt.sequenceNext (by core_stmt)
      (read current (by simpa only [specification, if_neg short] using env) frame)

/-- The actual two-let prelude is discharged by the generic scope spine;
the consumer supplies the stateful branch and read contract once. -/
theorem iteration (current : Invariant context before total) :
    EnvStmt extractedProgram origin before (reader.whileLoop 0).2 context.toConfiguration.loopValues
      (fun next completion after => Step.Result (specification context.toConfiguration total) before completion after next) := by
  have bounded := current.bounded
  have fits := context.capacityFits
  have env := current.env
  core_env_scopes env
  rename_i requestEnv
  exact adjustedRead current requestEnv (.refl before)
  all_goals
    dsimp only [requestValues, Configuration.loopValues]
    core_env_values

#print axioms iteration

def Ends (completion : Completion) (total : Nat) : Prop :=
  completion = .returned (some (.signed .i32 (-1))) ∨
  completion = .returned (some (.signed .i32 (-2))) ∨
  completion = .returned (some (.signed .i32 total))

theorem Step.Result.classify (result : Step.Result spec before completion after next)
    (bounded : spec.total ≤ spec.capacity) :
    next ≤ spec.capacity ∧ ((completion = .next ∧ spec.total < next) ∨ Ends completion next) := by
  obtain ⟨value, heap, world, read, _, _, outcome⟩ := result
  cases reading : World.readFileBytes (World.record before.world .read) spec.handle spec.request with
  | none =>
    simp only [reading] at outcome
    rcases outcome with ⟨rfl, returned, _⟩
    exact ⟨bounded, Or.inr (Or.inl returned)⟩
  | some pair =>
    rcases pair with ⟨bytes, updated⟩
    simp only [reading] at outcome
    by_cases empty : bytes = []
    · simp only [if_pos empty] at outcome
      rcases outcome with ⟨rfl, returned, _⟩
      exact ⟨bounded, Or.inr (Or.inr (Or.inr returned))⟩
    · by_cases fits : spec.total + bytes.length ≤ spec.capacity
      · simp only [if_neg empty, if_pos fits] at outcome
        rcases outcome with ⟨rfl, returned, _⟩
        exact ⟨fits, Or.inl ⟨returned, by have := List.length_pos_iff.mpr empty; omega⟩⟩
      · simp only [if_neg empty, if_neg fits] at outcome
        rcases outcome with ⟨rfl, returned, _⟩
        exact ⟨bounded, Or.inr (Or.inr (Or.inl returned))⟩

/-- Both buffer permissions are one compositional representation. Its
certified metadata frame survives scratch reads and output writes together. -/
theorem Invariant.advance (current : Invariant context before total)
    (env : LocalEnv origin after (context.toConfiguration.loopValues next))
    (result : Step.Result (specification context.toConfiguration total) before completion after next) :
    Invariant context after next := by
  have footprint := result.footprint current.unique
  have writes : HeapWritesOn before.heap after.heap context.toConfiguration.mutable := footprint.weaken (by
    intro location inside
    rcases inside with scratch | output
    · apply Or.inl
      have room : (specification context.toConfiguration total).request ≤ context.words * 4 := by
        dsimp [specification]; split <;> have := context.scratchSize <;> omega
      exact ⟨scratch.1, Nat.lt_of_lt_of_le scratch.2 (Nat.add_le_add_left room _)⟩
    · exact Or.inr output)
  have frame := HeapFrame.ofWrites (footprint := context.toConfiguration.buffers.footprint) writes (by
    intro address inside
    change False ∨ False at inside
    exact inside.elim False.elim False.elim)
  obtain ⟨value, heap, world, read, worldEq, views, outcome⟩ := result
  exact ⟨env, (Step.Result.classify ⟨value, heap, world, read, worldEq, views, outcome⟩ current.bounded).1,
    context.toConfiguration.buffers.stable frame current.buffers, writes.unique,
    views.trans current.noViews, current.written.trans writes⟩

structure Tracker (context : Context origin base) where
  Inv : Nat → Heap → World.State → Prop
  Done : Completion → Heap → World.State → Prop
  observe : ∀ {before after total next completion},
    Invariant context before total → Inv total before.heap before.world →
    Step.Result (specification context.toConfiguration total) before completion after next →
    (completion = .next → Inv next after.heap after.world) ∧
    (Ends completion next → Done completion after.heap after.world)

def Tracker.unobserved : Tracker context := {
  Inv := fun _ _ _ => True, Done := fun _ _ _ => True
  observe := by intros; exact ⟨fun _ => True.intro, fun _ => True.intro⟩ }

/-- Positive reads strictly reduce remaining capacity; all other actual
branches return. No future read, successful execution, or file is assumed. -/
theorem runTracked (current : Invariant context before total) (tracker : Tracker context)
    (tracked : tracker.Inv total before.heap before.world) :
    ∃ next completion after, RunsStmt extractedProgram before
      (.whileLoop (reader.whileLoop 0).1 (reader.whileLoop 0).2) completion after ∧
      Invariant context after next ∧ Ends completion next ∧ tracker.Done completion after.heap after.world := by
  generalize measure : context.capacity - total = remaining
  induction remaining using Nat.strongRecOn generalizing before total with
  | ind remaining induction =>
    obtain ⟨next, completion, after, body, env, result⟩ := iteration current
    have nextInvariant := current.advance env result
    have observations := tracker.observe current tracked result
    have classified := result.classify current.bounded
    dsimp only [specification] at classified
    rcases classified.2 with ⟨rfl, increased⟩ | returned
    · obtain ⟨last, completion, final, rest, invariant, returned, done⟩ :=
        induction (context.capacity - next) (by have := nextInvariant.bounded; omega)
          nextInvariant (observations.1 rfl) rfl
      exact ⟨last, completion, final, RunsStmt.whileStep (.ofStable .value rfl) body (Or.inl rfl) rest,
        invariant, returned, done⟩
    · have done := observations.2 returned
      rcases returned with rfl | rfl | rfl
      all_goals exact ⟨next, _, after, RunsStmt.whileReturn (.ofStable .value rfl) body,
        nextInvariant, by simp [Ends], done⟩

/-- Same safety observation as the original whole-reader theorem. -/
def Result (config : Configuration) (origin : State) (value : Value) (after : State) : Prop :=
  ∃ total, total ≤ config.capacity ∧ FreshCellFrame origin after ∧
    after.heap.Readable config.address (config.words * 4) ∧
    after.heap.Readable config.destination (config.capacity * 4) ∧
    HeapBlockBasesUnique after.heap ∧ after.i32ArrayViews = [] ∧
    (value = .signed .i32 (-1) ∨ value = .signed .i32 (-2) ∨ value = .signed .i32 total) ∧
    HeapWritesOn origin.heap after.heap config.mutable

theorem declarationTracked (context : Context origin base) (tracker : Tracker context)
    (tracked : tracker.Inv 0 base.heap base.world)
    (buffers : context.toConfiguration.buffers.holds base.heap)
    (unique : HeapBlockBasesUnique base.heap) (noViews : base.i32ArrayViews = []) :
    ∃ value after, RunsStmt extractedProgram base (reader.bindingStatement 1) (.returned (some value)) after ∧
      LocalEnv origin after context.toConfiguration.readyValues ∧
      Result context.toConfiguration origin value after ∧
      tracker.Done (.returned (some value)) after.heap after.world := by
  have start : Invariant context (base.bindLocal (reader.bindingId 1) (.signed .i32 0)) 0 :=
    ⟨context.env.bind _ _, Nat.zero_le _, buffers, unique, noViews,
      by change HeapWritesOn origin.heap base.heap _
         rw [← context.heap]
         exact HeapWritesOn.refl unique⟩
  obtain ⟨total, completion, after, loop, current, returned, done⟩ := runTracked start tracker tracked
  have returns : ∃ value, completion = .returned (some value) := by
    rcases returned with first | second | third
    · exact ⟨_, first⟩
    · exact ⟨_, second⟩
    · exact ⟨_, third⟩
  obtain ⟨value, rfl⟩ := returns
  have initial : RunsExpr extractedProgram base (reader.bindingInitializer 1) (.signed .i32 0) base := by core_run
  have rest := RunsStmt.sequenceCompleted loop (by simp)
    (match reader.bindingStatement 1 with | .letLocal _ _ _ (.sequence _ rest) => rest | _ => .skip)
  have executed : RunsStmt extractedProgram base (reader.bindingStatement 1)
      (.returned (some value)) (restoreLocals base after) :=
    RunsStmt.letLocal (id := reader.bindingId 1) (type := .scalar (.signed .i32)) initial rest
  have retained := current.env.restoreScope (values := context.toConfiguration.readyValues)
    (by rfl) rest.choose_spec.2
  have finalEnv : LocalEnv origin (restoreLocals base after) context.toConfiguration.readyValues := by
    simpa only [Configuration.loopValues, LocalValues.restrict_set_fresh
      context.toConfiguration.readyValues context.toConfiguration.readyValues
      (reader.bindingId 1) (.signed .i32 total) (by rfl), LocalValues.restrict_self] using retained
  refine ⟨value, restoreLocals base after, executed, finalEnv, ?_, done⟩
  simp only [Ends, Completion.returned.injEq, Option.some.injEq] at returned
  exact ⟨total, current.bounded, current.env.cells, current.inputRoom, current.outputRoom,
    current.unique, current.noViews, returned, current.written⟩

