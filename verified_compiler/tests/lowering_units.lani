module app::main;
import lowering::allocation;
import lowering::declarations;
import lowering::units;
import verified::host; // The unit tables are supplied from a flat declaration
// catalog in descriptor order. Both units must reach allocation.
const ALLOCATION_WORDS: i32 = lowering::allocation::HEADER
    + 4 * lowering::allocation::ROW;
const UNIT_DECLARATION_WORDS: i32 = lowering::declarations::HEADER
    + 2 * lowering::declarations::ROW;
const DECLARATION_WORDS: i32 = 2 * UNIT_DECLARATION_WORDS;
fn main() -> i32 {
    let descriptor_memory: ptr = verified::host::alloc(
        2 * lowering::declarations::TABLE_REF_BYTES,
        lowering::declarations::TABLE_REF_ALIGNMENT);
    let declaration_memory: ptr = verified::host::alloc(
        DECLARATION_WORDS * verified::host::I32_BYTES,
        lowering::declarations::ALIGNMENT);
    let allocated_memory: ptr = verified::host::alloc(
        ALLOCATION_WORDS * verified::host::I32_BYTES,
        lowering::allocation::ALIGNMENT);
    if (descriptor_memory == 0 || declaration_memory == 0
        || allocated_memory == 0) {
        return 1;
    }
    let descriptor_table: lowering::declarations::Catalog =
        lowering::declarations::catalog_from_raw_parts(descriptor_memory, 2);
    let allocated: lowering::allocation::Table =
        lowering::allocation::from_raw_parts(allocated_memory, 4);
    let unit: i32 = 0;
    while (unit <= 1) {
        let unit_memory: ptr = declaration_memory
            + unit * UNIT_DECLARATION_WORDS * verified::host::I32_BYTES;
        let table: lowering::declarations::Table =
            lowering::declarations::from_raw_parts(unit_memory, 2);
        lowering::declarations::table_write_header(table,
            lowering::declarations::DeclarationCounts {
            rows: 2, structures: 0, enumerations: 0, aliases: 0,
            constants: 0, functions: 1, externals: 0, modules: 1,
            imports: 0,
        });
        lowering::declarations::table_write_row(table, 0,
            lowering::declarations::DeclarationRow {
                unit: unit, kind: lowering::declarations::Module,
                is_public: false, item: 2, declaration: 1,
                name: -1, target: 0, ordinal: 0,
            });
        lowering::declarations::table_write_row(table, 1,
            lowering::declarations::DeclarationRow {
                unit: unit, kind: lowering::declarations::Function,
                is_public: false, item: 3, declaration: 2,
                name: 3, target: -1, ordinal: 0,
            });
        unit += 1;
    }
    lowering::declarations::catalog_write_table(descriptor_table, 0,
        lowering::declarations::from_raw_parts(declaration_memory, 2));
    let second_memory: ptr = declaration_memory
        + UNIT_DECLARATION_WORDS * verified::host::I32_BYTES;
    lowering::declarations::catalog_write_table(descriptor_table, 1,
        lowering::declarations::from_raw_parts(second_memory, 2));
    let second_table: lowering::declarations::Table =
        lowering::declarations::from_raw_parts(second_memory, 2);
    let second_unit_row: lowering::declarations::DeclarationRow =
        lowering::declarations::table_row(second_table, 0);
    second_unit_row.unit = 0;
    lowering::declarations::table_write_row(second_table, 0,
        second_unit_row);
    let rejected = lowering::units::accumulate(descriptor_table,
        allocated);
    if (lowering::units::stage_code(lowering::units::units_stage(rejected))
            != lowering::units::stage_code(lowering::units::Declarations)
        || lowering::units::units_count(rejected) != 1) { return 5; }
    second_unit_row.unit = 1;
    lowering::declarations::table_write_row(second_table, 0,
        second_unit_row);
    let result = lowering::units::accumulate(descriptor_table,
        allocated);
    if (!lowering::units::stage_succeeded(lowering::units::units_stage(result)) || lowering::units::units_count(result) != 2 || lowering::units::units_declaration_words(result) != DECLARATION_WORDS || lowering::units::units_allocation_words(result) != ALLOCATION_WORDS) {
        return 2;
    }
    let header: lowering::allocation::AllocationHeader =
        lowering::allocation::table_header(allocated);
    if (header.units != 2 || header.rows != 4
        || header.functions != 2 || header.externals != 0) {
        return 3;
    }
    if (lowering::allocation::row_core_id(
            lowering::allocation::table_row(allocated, 1)) != 0
        || lowering::allocation::row_core_id(
            lowering::allocation::table_row(allocated, 3)) != 1) {
        return 4;
    }
    return 0;
}
