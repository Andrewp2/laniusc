module app::main;

fn finish() {
    return;
}

fn fallthrough() {
    let ignored: i32 = 3;
}

fn early(stop: bool) {
    if (stop) { return; }
    while (true) {}
}

fn choose(first: bool) -> i32 {
    let result: i32;
    if (first) {
        result = 7;
    } else {
        result = 9;
    }
    return result;
}

fn main() -> i32 {
    finish();
    fallthrough();
    early(true);
    return choose(true) + choose(false);
}
