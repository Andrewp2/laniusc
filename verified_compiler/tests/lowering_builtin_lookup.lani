module app::main;

import ir::type_ref;
import lowering::builtin;
import verified::host;

fn lookup_spelling(spelling: str, length: i32)
    -> lowering::builtin::Lookup {
    let packed: [i32] = verified::host::i32_slice_from_raw_parts(
        verified::host::string_data_ptr(spelling),
        (length + verified::host::I32_BYTES - 1)
            / verified::host::I32_BYTES);
    let source: [i32; 6] = [0, 0, 0, 0, 0, 0];
    let index: i32 = 0;
    while (index < length) {
        source[index] = (packed[index / verified::host::I32_BYTES]
            >> ((index % verified::host::I32_BYTES)
                * verified::host::BITS_PER_BYTE)) & verified::host::BYTE_MASK;
        index += 1;
    }
    return lowering::builtin::lookup(source, length, 0, length);
}

fn check_supported(spelling: str, length: i32,
    expected: ir::type_ref::TypeRef) -> bool {
    let found: lowering::builtin::Lookup = lookup_spelling(spelling, length);
    return match (found) {
        lowering::builtin::Supported(actual) ->
            ir::type_ref::code(actual) == ir::type_ref::code(expected),
        _ -> false,
    };
}

fn check_unsupported(spelling: str, length: i32) -> bool {
    return match (lookup_spelling(spelling, length)) {
        lowering::builtin::UnsupportedType -> true,
        _ -> false,
    };
}

fn check_unknown(spelling: str, length: i32) -> bool {
    return match (lookup_spelling(spelling, length)) {
        lowering::builtin::UnknownName -> true,
        _ -> false,
    };
}

fn main() -> i32 {
    if (!check_supported("i32", 3, ir::type_ref::I32)) { return 1; }
    if (!check_supported("bool", 4, ir::type_ref::Bool)) { return 2; }
    if (!check_supported("usize", 5, ir::type_ref::Usize)) { return 3; }
    if (!check_supported("ptr", 3, ir::type_ref::Pointer)) { return 4; }
    if (!check_supported("str", 3, ir::type_ref::String)) { return 5; }
    if (!check_unsupported("i8", 2)) { return 6; }
    if (!check_unsupported("i16", 3)) { return 7; }
    if (!check_unsupported("i64", 3)) { return 8; }
    if (!check_unsupported("isize", 5)) { return 9; }
    if (!check_unsupported("u8", 2)) { return 10; }
    if (!check_unsupported("u16", 3)) { return 11; }
    if (!check_unsupported("u32", 3)) { return 12; }
    if (!check_unsupported("u64", 3)) { return 13; }
    if (!check_unsupported("f32", 3)) { return 14; }
    if (!check_unsupported("f64", 3)) { return 15; }
    if (!check_unsupported("char", 4)) { return 16; }
    if (!check_unknown("i3x", 3)) { return 17; }
    if (!check_unknown("i32x", 4)) { return 18; }
    if (!check_unknown("Answer", 6)) { return 19; }
    return 0;
}
