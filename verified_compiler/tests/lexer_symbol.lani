module app::main;

import verified::symbol;
import verified::token;

fn main() -> i32 {
    let source: [i32; 4] = [60, 60, 61, 0];
    let result: verified::symbol::TokenMatch =
        verified::symbol::match_symbol_head(source, 3, 0);
    if (verified::symbol::token_match_token_kind(result)
        != verified::token::ShiftLeftAssign) {
        return 1;
    }
    if (verified::symbol::token_match_length(result) != 3) {
        return 2;
    }
    return 0;
}
