module app::main;

enum Choice {
    One,
    Two,
}

fn number(choice: Choice) -> i32 {
    return match (choice) {
        One -> (6 & 3) + (1 << 2),
        Two -> 9 - 2,
    };
}

fn accepted(choice: Choice) -> bool {
    return match (choice) {
        One -> 5 <= 6 && 2 != 3,
        Two -> 7 > 8 || 4 == 4,
    };
}

fn main() -> i32 {
    if (accepted(One) && accepted(Two)) {
        return number(One) + number(Two);
    }
    return 1;
}
