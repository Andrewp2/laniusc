        };
    if (verified::semantic_tokens::collect(nested_semantic_input,
            assignments) != 0 || semantic[0].inner != 0
            || semantic[0].outer != 1) {
        return 27;
    }
    let packed:[i32; 23] =[91, 40, 50, 49, 52, 55, 52, 56, 51, 54, 52, 56, 43, 48, 43, 49, 42, 51, 50, 55, 54, 56, 41];
    source_cursor.capacity = 64;
    source_cursor.position = 0;
    let packed_length: i32 = verified::semantic_token_output::emit(
        assignments, 1, source_cursor);
    if (packed_length != 24 || source_bytes[23] != 93) {
        return 28;
    }
    let packed_index: i32 = 0;
    while (packed_index != 23) {
        if (source_bytes[packed_index] != packed[packed_index]) {
            return 29;
        }
        packed_index += 1;
    }
    source_cursor.capacity = 23;
    if (verified::semantic_token_output::emit(assignments, 1,
            source_cursor) != -1) {
        return 30;
    }
    semantic[0].outer = -1;
    source_cursor.capacity = 64;
    if (verified::semantic_token_output::emit(assignments, 1,
            source_cursor) != 3 || source_bytes[0] != 91 || source_bytes[1] != 48 || source_bytes[2] != 93) {
        return 31;
    }
    // Keyword matching reads compact packed string literals across word
    // boundaries and still requires a complete spelling match.
    let struct_keyword:[i32; 6] =[115, 116, 114, 117, 99, 116];
    let struct_prefix:[i32; 7] =[115, 116, 114, 117, 99, 116, 115];
    let continue_keyword:[i32; 8] =[99, 111, 110, 116, 105, 110, 117, 101];
    if (verified::canonical_tokens::keyword_kind(struct_keyword, 0, 6)
            != verified::token::kind_code(verified::token::StructKeyword)
        || verified::canonical_tokens::keyword_kind(struct_prefix, 0, 7)
            != verified::token::kind_code(verified::token::Identifier)
        || verified::canonical_tokens::keyword_kind(continue_keyword, 0, 8)
            != verified::token::kind_code(
                verified::token::ContinueKeyword)) {
        return 35;
    }
    return 0;
}
