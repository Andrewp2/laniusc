module app::main;

extern "lanius_std" fn argc() -> i32;

fn array_walk(rounds: i32, salt: i32) -> i32 {
    let values: [i32; 64] = [3, 20, 37, 54, 71, 88, 105, 122, 139, 156, 173, 190, 207, 224, 241, 258, 275, 292, 309, 326, 343, 360, 377, 394, 411, 428, 445, 462, 479, 496, 513, 530, 547, 564, 581, 598, 615, 632, 649, 666, 683, 700, 717, 734, 751, 768, 785, 802, 819, 836, 853, 870, 887, 904, 921, 938, 955, 972, 989, 1006, 1023, 1040, 1057, 1074];
    let checksum: i32 = 0;
    let round: i32 = 0;
    while (round < rounds) {
        let index: i32 = 0;
        while (index < 64) {
            let value: i32 = (values[index] * 33 + round + index + salt) % 10007;
            values[index] = value;
            checksum = (checksum + value) % 1000003;
            index += 1;
        }
        round += 1;
    }
    return checksum;
}

fn main() -> i32 {
    let argument_count: i32 = argc();
    print(array_walk(100000 + argument_count, argument_count));
    return 0;
}
