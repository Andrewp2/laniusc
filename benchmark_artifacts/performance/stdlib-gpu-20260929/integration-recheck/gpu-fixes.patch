+// Concrete enum return types need their instantiated width before function
+// lowering. A generic declaration has no fixed layout; derive this only when
+// every substituted payload is a direct scalar. Compound layouts remain with
+// the backend's aggregate layout pass and must never default to one word.
+uint local_scalar_enum_words(uint instance)
+{
+    if (!valid_token(instance) || type_instance_arg_count[instance] == 0u)
+        return 0u;
+    uint declaration = type_instance_decl_token[instance];
+    uint owner = valid_token(declaration)
+        ? type_decl_hir_node_by_token[declaration] : INVALID;
+    if (!valid_hir(owner) || compact_hir_core[owner].kind != HIR_ENUM_ITEM)
+        return 0u;
+    uint maximum = 0u;
+    uint variant_count = min(compact_variant_count[0u], gParams.n_hir_nodes);
+    uint payload_count = min(compact_variant_payload_row_count[0u], gParams.n_hir_nodes);
+    for (uint row = 0u; row < variant_count; row += 1u)
+    {
+        if (compact_variants[row].owner != owner) continue;
+        uint start = compact_variant_payload_start[row];
+        uint count = compact_variant_payload_count[row];
+        if (count != 0u && (start >= payload_count || count > payload_count - start))
+            return 0u;
+        uint words = 1u; // discriminant, including empty variants
+        for (uint ordinal = 0u; ordinal < count; ordinal += 1u)
+        {
+            HirVariantPayload item = compact_variant_payloads[start + ordinal];
+            if (item.variant != row || item.ordinal != ordinal || !valid_hir(item.type_node))
+                return 0u;
+            uint token = type_head_token(item.type_node);
+            if (!valid_token(token)) return 0u;
+            uint tag = type_expr_ref_tag[token];
+            uint payload = type_expr_ref_payload[token];
+            if (tag == 2u) // generic parameter
+            {
+                if (!valid_token(payload)) return 0u;
+                uint slot = type_generic_param_slot_by_token[payload];
+                if (slot >= type_instance_arg_count[instance]) return 0u;
+                uint row_start = type_instance_arg_row_start[instance];
+                uint row_count = type_instance_arg_row_count_out[0u];
+                if (row_start < row_count && slot < row_count - row_start)
+                {
+                    tag = type_instance_arg_row_ref_tag[row_start + slot];
+                    payload = type_instance_arg_row_ref_payload[row_start + slot];
+                }
+                else
+                {
+                    uint legacy_start = type_instance_arg_start[instance];
+                    if (slot >= 4u || legacy_start >= gParams.n_tokens * 4u ||
+                        slot >= gParams.n_tokens * 4u - legacy_start)
