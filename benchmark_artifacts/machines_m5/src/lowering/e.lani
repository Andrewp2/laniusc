import core::option;
const LIMIT: i64 = 200000000;
enum S { Start, Y0, Done }
struct G { limit: i64, gi: i64, st: S }
impl G {
    fn next(&mut self) -> core::option::Option<i64> {
        return match (self.st) {
            S::Start -> { let limit: i64 = self.limit; let i: i64 = 0; while (i < limit) { if (i % 2 == 1) { self.gi = i; self.st = S::Y0; return core::option::Some(i * i); } i += 1; } self.st = S::Done; return core::option::None(); },
            S::Y0 -> { let limit: i64 = self.limit; let i: i64 = self.gi; { { } i += 1; } while (i < limit) { if (i % 2 == 1) { self.gi = i; self.st = S::Y0; return core::option::Some(i * i); } i += 1; } self.st = S::Done; return core::option::None(); },
            S::Done -> { return core::option::None(); },
        };
    }
}
fn main() -> i32 {
    let it: G = G { limit: LIMIT, gi: 0, st: S::Start };
    let total: i64 = 0;
    while (true) {
        match (it.next()) {
            Some(v) -> { total += v; continue; },
            None -> { break; },
        };
    }
    print(total);
    return 0;
}
