import core::option;
const LIMIT: i64 = 200000000;
struct G { limit: i64, gi: i64 }
impl G {
    fn next(&mut self) -> core::option::Option<i64> {
        let limit: i64 = self.limit; let i: i64 = self.gi;
        while (i < limit) { if (i % 2 == 1) { self.gi = i + 1; return core::option::Some(i * i); } i += 1; }
        self.gi = i; return core::option::None();
    }
}
fn main() -> i32 {
    let it: G = G { limit: LIMIT, gi: 0 };
    let total: i64 = 0;
    while (true) {
        match (it.next()) {
            Some(v) -> { total += v; continue; },
            None -> { break; },
        };
    }
    print(total);
    return 0;
}
