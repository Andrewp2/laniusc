// The scanner as a machine run by a loop around `step`: the code M1's
// `machine` elaborates to, and the baseline M3's `run` must beat.
import alloc::allocator;
import core::mem;
const BYTES: i32 = 67108864;

// Deterministic text: runs of digits, words, spaces and `#` comments to the end
// of a line. The same bytes in every version.
fn fill(bytes: [u8]) {
    let seed: u32 = 12345;
    let at: i32 = 0;
    while (at < BYTES) {
        seed = seed * 1103515245 + 12345;
        let pick: u32 = (seed >> 16) % 8;
        let length: i32 = (((seed >> 8) % 7) + 1) as i32;
        let base: u8 = 32;
        if (pick < 3) { base = 48; }
        if (pick == 3 || pick == 4) { base = 97; }
        if (pick == 5) { base = 35; }
        let k: i32 = 0;
        while (k < length && at < BYTES) {
            let byte: u8 = base;
            if (base == 48) { byte = (48 + ((seed >> (k as u32)) % 10)) as u8; }
            if (base == 97) { byte = (97 + ((seed >> (k as u32)) % 26)) as u8; }
            if (base == 35 && k == length - 1) { byte = 10; }
            bytes[at] = byte;
            at += 1; k += 1;
        }
    }
}

enum Scan { Between, InNumber(i64), InComment }
struct Scanner { state: Scan, total: i64 }
impl Scanner { fn exclusive(&mut self) -> &mut Scanner { return self; } }

fn digit(c: u8) -> bool { return c >= 48 && c <= 57; }

fn between(c: u8) -> Scan {
    if (digit(c)) { return Scan::InNumber((c - 48) as i64); }
    if (c == 35) { return Scan::InComment; }
    return Scan::Between;
}
fn in_number(m: &mut Scanner, value: i64, c: u8) -> Scan {
    if (digit(c)) { return Scan::InNumber(value * 10 + (c - 48) as i64); }
    m.total += value;
    if (c == 35) { return Scan::InComment; }
    return Scan::Between;
}
fn in_comment(c: u8) -> Scan {
    if (c == 10) { return Scan::Between; }
    return Scan::InComment;
}
fn step(m: &mut Scanner, c: u8) {
    let next: Scan = match (m.state) {
        Between -> between(c),
        InNumber(value) -> in_number(m, value, c),
        InComment -> in_comment(c),
    };
    m.state = next;
}

fn main() -> i32 {
    let storage: ptr = alloc::allocator::alloc(BYTES as usize, 8);
    let bytes: [u8] = core::mem::typed_slice_from_storage<u8>(storage, BYTES);
    fill(bytes);
    let m: Scanner = Scanner { state: Scan::Between, total: 0 };
    let at: i32 = 0;
    while (at < BYTES) { step(m.exclusive(), bytes[at]); at += 1; }
    let last: i64 = match (m.state) { Between -> 0, InNumber(value) -> value, InComment -> 0 };
    print(m.total + last);
    return 0;
}
