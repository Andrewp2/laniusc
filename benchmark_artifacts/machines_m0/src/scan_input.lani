// Input generation alone, to subtract from the other versions' times.
import alloc::allocator;
import core::mem;
const BYTES: i32 = 67108864;

// Deterministic text: runs of digits, words, spaces and `#` comments to the end
// of a line. The same bytes in every version.
fn fill(bytes: [u8]) {
    let seed: u32 = 12345;
    let at: i32 = 0;
    while (at < BYTES) {
        seed = seed * 1103515245 + 12345;
        let pick: u32 = (seed >> 16) % 8;
        let length: i32 = (((seed >> 8) % 7) + 1) as i32;
        let base: u8 = 32;
        if (pick < 3) { base = 48; }
        if (pick == 3 || pick == 4) { base = 97; }
        if (pick == 5) { base = 35; }
        let k: i32 = 0;
        while (k < length && at < BYTES) {
            let byte: u8 = base;
            if (base == 48) { byte = (48 + ((seed >> (k as u32)) % 10)) as u8; }
            if (base == 97) { byte = (97 + ((seed >> (k as u32)) % 26)) as u8; }
            if (base == 35 && k == length - 1) { byte = 10; }
            bytes[at] = byte;
            at += 1; k += 1;
        }
    }
}

fn main() -> i32 {
    let storage: ptr = alloc::allocator::alloc(BYTES as usize, 8);
    let bytes: [u8] = core::mem::typed_slice_from_storage<u8>(storage, BYTES);
    fill(bytes);
    let check: i64 = 0;
    let at: i32 = 0;
    while (at < BYTES) { check += bytes[at] as i64; at += 4096; }
    print(check);
    return 0;
}
