// GPU-generated CRT-facing bridge. The readable assembly is crt_entry.s.
// Version 4 x86 objects always append these bytes to Text, including library
// objects. Only an object with one checked language entrypoint may export it
// as C main. The original raw entry wrapper and function offsets stay fixed.
import codegen.lowering_ir;
import codegen.lir.x86.runtime_abi;

static const uint X86_CRT_ENTRY_BYTES = 225u;
static const uint X86_CRT_ENTRY_CALL_OFFSET = 181u;
static const uint X86_CRT_RUNTIME_LENGTH = X86_RUNTIME_LENGTH + X86_CRT_ENTRY_BYTES;

uint x86_crt_entry_byte(uint pos, X86ArtifactLayout layout)
{
    // The bridge calls within the same Text section, so its displacement stays
    // valid when an ELF linker moves that whole section. No host code synthesis
    // or additional object relocation is involved.
    uint call_next = layout.runtime_offset + X86_RUNTIME_LENGTH +
        X86_CRT_ENTRY_CALL_OFFSET + 5u;
    uint entry = layout.body_offset + layout.entrypoint_body_offset;
    if (pos > X86_CRT_ENTRY_CALL_OFFSET && pos < X86_CRT_ENTRY_CALL_OFFSET + 5u)
        return ((entry - call_next) >> ((pos - X86_CRT_ENTRY_CALL_OFFSET - 1u) * 8u)) & 0xffu;
    static const uint crt_entry_bytes[225] = {
        0x55u, 0x53u, 0x41u, 0x54u, 0x41u, 0x55u, 0x41u, 0x56u, 0x41u, 0x57u, 0x48u, 0x83u,
        0xecu, 0x08u, 0x85u, 0xffu, 0x0fu, 0x88u, 0xb7u, 0x00u, 0x00u, 0x00u, 0x81u, 0xffu,
        0xfdu, 0xffu, 0x0fu, 0x00u, 0x0fu, 0x87u, 0xabu, 0x00u, 0x00u, 0x00u, 0x89u, 0xfbu,
        0x49u, 0x89u, 0xf4u, 0x49u, 0x89u, 0xd5u, 0x31u, 0xedu, 0x4du, 0x85u, 0xe4u, 0x75u,
        0x08u, 0x85u, 0xdbu, 0x0fu, 0x85u, 0x94u, 0x00u, 0x00u, 0x00u, 0x4du, 0x85u, 0xedu,
        0x74u, 0x1bu, 0x8du, 0x44u, 0x2bu, 0x03u, 0x3du, 0x00u, 0x00u, 0x10u, 0x00u, 0x0fu,
        0x87u, 0x80u, 0x00u, 0x00u, 0x00u, 0x49u, 0x83u, 0x7cu, 0xedu, 0x00u, 0x00u, 0x74u,
        0x04u, 0xffu, 0xc5u, 0xebu, 0xe5u, 0x4cu, 0x8du, 0x74u, 0x2bu, 0x03u, 0x49u, 0xc1u,
        0xe6u, 0x03u, 0x31u, 0xffu, 0x4cu, 0x89u, 0xf6u, 0xbau, 0x03u, 0x00u, 0x00u, 0x00u,
        0x41u, 0xbau, 0x22u, 0x00u, 0x00u, 0x00u, 0x49u, 0xc7u, 0xc0u, 0xffu, 0xffu, 0xffu,
        0xffu, 0x45u, 0x31u, 0xc9u, 0xb8u, 0x09u, 0x00u, 0x00u, 0x00u, 0x0fu, 0x05u, 0x48u,
        0x85u, 0xc0u, 0x78u, 0x45u, 0x49u, 0x89u, 0xc7u, 0x49u, 0x89u, 0x1fu, 0x49u, 0x8du,
        0x7fu, 0x08u, 0x4cu, 0x89u, 0xe6u, 0x89u, 0xd9u, 0xfcu, 0xf3u, 0x48u, 0xa5u, 0x48u,
        0xc7u, 0x07u, 0x00u, 0x00u, 0x00u, 0x00u, 0x48u, 0x83u, 0xc7u, 0x08u, 0x4cu, 0x89u,
        0xeeu, 0x89u, 0xe9u, 0xf3u, 0x48u, 0xa5u, 0x48u, 0xc7u, 0x07u, 0x00u, 0x00u, 0x00u,
        0x00u, 0xe8u, 0x00u, 0x00u, 0x00u, 0x00u, 0x89u, 0xc3u, 0x4cu, 0x89u, 0xffu, 0x4cu,
        0x89u, 0xf6u, 0xb8u, 0x0bu, 0x00u, 0x00u, 0x00u, 0x0fu, 0x05u, 0x89u, 0xd8u, 0xebu,
        0x05u, 0xb8u, 0x7fu, 0x00u, 0x00u, 0x00u, 0x48u, 0x83u, 0xc4u, 0x08u, 0x41u, 0x5fu,
        0x41u, 0x5eu, 0x41u, 0x5du, 0x41u, 0x5cu, 0x5bu, 0x5du, 0xc3u,
    };
    return pos < X86_CRT_ENTRY_BYTES ? crt_entry_bytes[pos] : 0u;
}
