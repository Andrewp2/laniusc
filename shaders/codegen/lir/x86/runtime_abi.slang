            0xc3u, 0x48u, 0x81u, 0xecu, 0x00u, 0x10u, 0x00u, 0x00u, 0x48u, 0x89u,
            0xe2u, 0xe8u, 0xd8u, 0xfeu, 0xffu, 0xffu, 0x85u, 0xc0u, 0x78u, 0x0au,
            0x48u, 0x89u, 0xe7u, 0xb8u, 0x54u, 0x00u, 0x00u, 0x00u, 0x0fu, 0x05u,
            0x48u, 0x81u, 0xc4u, 0x00u, 0x10u, 0x00u, 0x00u, 0xc3u, 0x48u, 0x81u,
            0xecu, 0x10u, 0x20u, 0x00u, 0x00u, 0x48u, 0x89u, 0x94u, 0x24u, 0x00u,
            0x20u, 0x00u, 0x00u, 0x48u, 0x89u, 0x8cu, 0x24u, 0x08u, 0x20u, 0x00u,
            0x00u, 0x48u, 0x89u, 0xe2u, 0xe8u, 0xa3u, 0xfeu, 0xffu, 0xffu, 0x85u,
            0xc0u, 0x78u, 0x33u, 0x48u, 0x8bu, 0xbcu, 0x24u, 0x00u, 0x20u, 0x00u,
            0x00u, 0x48u, 0x8bu, 0xb4u, 0x24u, 0x08u, 0x20u, 0x00u, 0x00u, 0x48u,
            0x8du, 0x94u, 0x24u, 0x00u, 0x10u, 0x00u, 0x00u, 0xe8u, 0x82u, 0xfeu,
            0xffu, 0xffu, 0x85u, 0xc0u, 0x78u, 0x12u, 0x48u, 0x89u, 0xe7u, 0x48u,
            0x8du, 0xb4u, 0x24u, 0x00u, 0x10u, 0x00u, 0x00u, 0xb8u, 0x52u, 0x00u,
            0x00u, 0x00u, 0x0fu, 0x05u, 0x48u, 0x81u, 0xc4u, 0x10u, 0x20u, 0x00u,
            0x00u, 0xc3u
        };
        return path_ops_bytes[pos - X86_RUNTIME_PATH_COPY_OFFSET];
    }
    // Called with the asserted bool in EDI. A false value raises SIGILL;
    // a true value returns to the caller without changing its state.
    if (pos >= X86_RUNTIME_ASSERT_OFFSET && pos < X86_RUNTIME_LINUX_SYSCALL6_OFFSET)
    {
        static const uint assert_bytes[7] = {
            0x85u, 0xffu, 0x75u, 0x02u, 0x0fu, 0x0bu, 0xc3u
        };
        return assert_bytes[pos - X86_RUNTIME_ASSERT_OFFSET];
    }
    // Raw Linux x86-64 syscall bridge; see runtime_linux_syscall.s.
    if (pos >= X86_RUNTIME_LINUX_SYSCALL6_OFFSET && pos < X86_RUNTIME_LENGTH)
    {
        static const uint linux_syscall6_bytes[32] = {
            0x48u, 0x89u, 0xf8u, 0x49u, 0x89u, 0xf3u, 0x49u, 0x8bu,
            0x3bu, 0x49u, 0x8bu, 0x73u, 0x08u, 0x49u, 0x8bu, 0x53u,
            0x10u, 0x4du, 0x8bu, 0x53u, 0x18u, 0x4du, 0x8bu, 0x43u,
            0x20u, 0x4du, 0x8bu, 0x4bu, 0x28u, 0x0fu, 0x05u, 0xc3u,
        };
        return linux_syscall6_bytes[pos - X86_RUNTIME_LINUX_SYSCALL6_OFFSET];
    }
    return pos < X86_RUNTIME_LENGTH
        ? print_i32_bytes[pos - X86_RUNTIME_PRINT_I32_OFFSET] : 0u;
}
