fn tree_set_contract() {
    let events:[Event;64]=[guard();64]; let log:Log=Log { events:events,used:0 }; let saved:[Event;64]=[guard();64]; let live:[bool;16]=[false;16]; let policy:Policy=Policy {};
    let owner:alloc::tree_set::TreeSet<Key> =alloc::tree_set::with_capacity<Key>(16).unwrap(); let storage:ptr=owner.state.storage; let capacity:i32=owner.capacity(); let ask:Query=query(4,log.borrow());
    assert(!owner.contains_by(ask,policy.borrow())); inspect(log.borrow(),ask,false,false,live); log.reset();
    let ranks:[i32;7]=[4,2,6,1,3,5,7]; let i:i32=0; while(i<7) { owner.try_insert(key(ranks[i])).unwrap(); live[ranks[i]]=true; i+=1; } owner.remove(key(2)).unwrap(); owner.remove(key(6)).unwrap(); live[2]=false; live[6]=false; owner.try_insert(key(8)).unwrap(); owner.try_insert(key(9)).unwrap(); live[8]=true; live[9]=true;
    let queries:[i32;5]=[4,6,8,15,7]; i=0; while(i<5) { let rank:i32=queries[i]; ask=query(rank,log.borrow()); log.reset(); let found:core::option::Option<Key> =owner.get_by(ask,policy.borrow()); assert(found.is_some()==live[rank]); if(found.is_some()) { assert(found.unwrap().tag==1000+rank as u64); } inspect(log.borrow(),ask,false,live[rank],live); let count:i32=log.used; save(log.borrow(),saved); log.reset(); assert(owner.contains_by(ask,policy.borrow())==live[rank]); prefix(log.borrow(),saved,count,false,0); check_tree_set(owner.borrow(),live,storage,capacity); i+=1; }
    let removals:[i32;8]=[6,4,9,1,7,3,8,5]; i=0; while(i<8) { let rank:i32=removals[i]; ask=query(rank,log.borrow()); log.reset(); let found:core::option::Option<Key> =owner.get_by(ask,policy.borrow()); let present:bool=live[rank]; assert(found.is_some()==present); inspect(log.borrow(),ask,false,present,live); let count:i32=log.used; save(log.borrow(),saved); log.reset();
        let removed:core::option::Option<Key> =owner.remove_by(ask,policy.borrow()); assert(removed.is_some()==present); if(present) { assert(removed.unwrap().rank==rank && removed.unwrap().tag==1000+rank as u64); live[rank]=false; } prefix(log.borrow(),saved,count,false,0); check_tree_set(owner.borrow(),live,storage,capacity); i+=1;
    }
    log.reset(); assert(owner.get_by(ask,policy.borrow()).is_none()); inspect(log.borrow(),ask,false,false,live); owner.try_insert(key(6)).unwrap(); live[6]=true; check_tree_set(owner.borrow(),live,storage,capacity); log.reset(); assert(owner.get_by(query(6,log.borrow()),policy.borrow()).unwrap().tag==1006); owner.destroy();
}
fn main() -> i32 { hash_map_contract(); tree_map_contract(); hash_set_contract(); tree_set_contract(); return 0; }
