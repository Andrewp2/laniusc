module app::main;
import alloc::hash_map;
import alloc::hash_set;
import alloc::tree_map;
import alloc::tree_set;
import alloc::string;
import core::cmp;
import core::function;
import core::hash;
import core::option;
import core::ordering;
import core::pair;
import core::result;
import core::slice;
import core::text;
struct Key { rank:i32,wide:[u64;2] }
pub impl core::hash::Hash<Key> for Key { pub fn hash(key:Key) -> u32 { return key.rank as u32; } }
pub impl core::cmp::Eq<Key> for Key {
    pub fn eq(left:Key,right:Key) -> bool { return left.rank==right.rank; }
    pub fn ne(left:Key,right:Key) -> bool { return left.rank!=right.rank; }
}
pub impl core::cmp::Ord<Key> for Key {
    pub fn lt(left:Key,right:Key) -> bool { return left.rank<right.rank; }
    pub fn le(left:Key,right:Key) -> bool { return left.rank<=right.rank; }
    pub fn gt(left:Key,right:Key) -> bool { return left.rank>right.rank; }
    pub fn ge(left:Key,right:Key) -> bool { return left.rank>=right.rank; }
}
// This enum intentionally has no Eq or Ord implementation.
enum Query { Number(i32,core::slice::View<u8>), Missing(core::slice::View<u8>) }
fn view_check(view:core::slice::View<u8>) -> i32 { assert(view.start==1 && view.length==3); assert(view.values[view.start]==0 && view.values[view.start+1]==128 && view.values[view.start+2]==255); return 0; }
fn query_rank(query:Query) -> i32 { return match(query) { Number(rank,view) -> rank+view_check(view), Missing(view) -> 99+view_check(view), }; }
pub impl core::hash::Hash<Query> for Query { pub fn hash(query:Query) -> u32 { return query_rank(query) as u32; } }
struct Policy { calls:i32 }
impl Policy { fn borrow(&self) -> &Policy { return self; } }
fn stored(key:Key) -> i32 { assert(key.wide[0]==9223372036854775808 && key.wide[1]==18446744073709551615); return key.rank; }
pub impl core::function::Mapper<core::pair::Pair<Key,Query>,bool> for Policy {
    pub fn apply(&self,pair:core::pair::Pair<Key,Query>) -> bool { self.calls+=1; return stored(pair.first)==query_rank(pair.second); }
}
pub impl core::ordering::Comparator<Key,Query> for Policy {
    pub fn compare(&self,key:Key,query:Query) -> core::ordering::Ordering { self.calls+=1; return core::ordering::compare_i32(stored(key),query_rank(query)); }
}
struct ScalarPolicy { calls:i32 }
impl ScalarPolicy { fn borrow(&self) -> &ScalarPolicy { return self; } }
pub impl core::function::Mapper<core::pair::Pair<Key,u32>,bool> for ScalarPolicy {
    pub fn apply(&self,pair:core::pair::Pair<Key,u32>) -> bool { self.calls+=1; return (stored(pair.first) as u32)==pair.second; }
}
pub impl core::ordering::Comparator<Key,u32> for ScalarPolicy {
    pub fn compare(&self,key:Key,query:u32) -> core::ordering::Ordering { self.calls+=1; return core::ordering::compare_u32(stored(key) as u32,query); }
}
struct Change { calls:i32 }
impl Change { fn borrow(&self) -> &Change { return self; } }
pub impl core::function::Mapper<[u64;2],core::pair::Pair<[u64;2],core::option::Option<bool>>> for Change {
    pub fn apply(&self,value:[u64;2]) -> core::pair::Pair<[u64;2],core::option::Option<bool>> { self.calls+=1; assert(value[0]==4294967297 && value[1]==9223372036854775808); let next:[u64;2]=[18446744073709551615,4294967297]; let report:core::option::Option<bool> =core::option::Some(false); return core::pair::Pair { first:next,second:report }; }
}
// The forwarding signatures intentionally require no stored-key capabilities.
fn hash_get<K,V,Q,P>(map:&alloc::hash_map::HashMap<K,V>,query:Q,policy:&P) -> core::option::Option<V> where Q:core::hash::Hash<Q>,P:core::function::Mapper<core::pair::Pair<K,Q>,bool> { return map.get_by<Q,P>(query,policy); }
fn tree_get<K,V,Q,P>(map:&alloc::tree_map::TreeMap<K,V>,query:Q,policy:&P) -> core::option::Option<V> where P:core::ordering::Comparator<K,Q> { return map.get_by<Q,P>(query,policy); }
fn hash_update<K,V,Q,P,M,R>(map:&alloc::hash_map::HashMap<K,V>,query:Q,policy:&P,change:&M) -> core::option::Option<R> where Q:core::hash::Hash<Q>,P:core::function::Mapper<core::pair::Pair<K,Q>,bool>,M:core::function::Mapper<V,core::pair::Pair<V,R>> { return map.update_value_by<Q,P,M,R>(query,policy,change); }
fn tree_update<K,V,Q,P,M,R>(map:&alloc::tree_map::TreeMap<K,V>,query:Q,policy:&P,change:&M) -> core::option::Option<R> where P:core::ordering::Comparator<K,Q>,M:core::function::Mapper<V,core::pair::Pair<V,R>> { return map.update_value_by<Q,P,M,R>(query,policy,change); }
fn generic_shapes() -> i32 {
    let backing:[u8;5]=[77,0,128,255,88]; let view:core::slice::View<u8> =core::slice::view_range<u8>(backing,1,3).unwrap(); let query:Query=Number(3,view); let absent:Query=Missing(view); let policy:Policy=Policy { calls:0 }; let scalar:ScalarPolicy=ScalarPolicy { calls:0 }; let change:Change=Change { calls:0 };
    let wide:[u64;2]=[9223372036854775808,18446744073709551615]; let key:Key=Key { rank:3,wide:wide }; let initial:[u64;2]=[4294967297,9223372036854775808];
    let hash:alloc::hash_map::HashMap<Key,[u64;2]> =alloc::hash_map::new<Key,[u64;2]>(); hash.try_reserve(4).unwrap(); hash.try_insert(key,initial).unwrap();
    let value:core::option::Option<[u64;2]> =hash_get<Key,[u64;2],Query,Policy>(hash.borrow(),query,policy.borrow()); let bytes:[u64;2]=value.unwrap(); assert(bytes[0]==4294967297 && bytes[1]==9223372036854775808);
    let missing:core::option::Option<[u64;2]> =hash_get<Key,[u64;2],Query,Policy>(hash.borrow(),absent,policy.borrow()); assert(missing.is_none());
    let result:core::option::Option<core::option::Option<bool>> =hash_update<Key,[u64;2],Query,Policy,Change,core::option::Option<bool>>(hash.borrow(),query,policy.borrow(),change.borrow()); let inner:core::option::Option<bool> =result.unwrap(); assert(!inner.unwrap() && change.calls==1);
    let removed:alloc::hash_map::Entry<Key,[u64;2]> =hash.remove_by(query,policy.borrow()).unwrap(); assert(stored(removed.key)==3 && removed.value[0]==18446744073709551615 && removed.value[1]==4294967297); hash.destroy();
    let tree:alloc::tree_map::TreeMap<Key,[u64;2]> =alloc::tree_map::with_capacity<Key,[u64;2]>(4).unwrap(); tree.try_insert(key,initial).unwrap();
    value=tree_get<Key,[u64;2],Query,Policy>(tree.borrow(),query,policy.borrow()); bytes=value.unwrap(); assert(bytes[0]==4294967297 && bytes[1]==9223372036854775808); missing=tree_get<Key,[u64;2],Query,Policy>(tree.borrow(),absent,policy.borrow()); assert(missing.is_none());
    result=tree_update<Key,[u64;2],Query,Policy,Change,core::option::Option<bool>>(tree.borrow(),query,policy.borrow(),change.borrow()); inner=result.unwrap(); assert(!inner.unwrap() && change.calls==2); let tree_removed:alloc::tree_map::Entry<Key,[u64;2]> =tree.remove_by(query,policy.borrow()).unwrap(); assert(stored(tree_removed.key)==3 && tree_removed.value[0]==18446744073709551615 && tree_removed.value[1]==4294967297); tree.destroy();
    let hash_set:alloc::hash_set::HashSet<Key> =alloc::hash_set::with_capacity<Key>(4).unwrap(); hash_set.try_insert(key).unwrap(); let three:u32=3; let four:u32=4; assert(hash_set.contains_by(three,scalar.borrow()) && !hash_set.contains_by(four,scalar.borrow())); assert(stored(hash_set.get_by(query,policy.borrow()).unwrap())==3); assert(stored(hash_set.remove_by(three,scalar.borrow()).unwrap())==3); hash_set.destroy();
    let tree_set:alloc::tree_set::TreeSet<Key> =alloc::tree_set::with_capacity<Key>(4).unwrap(); tree_set.try_insert(key).unwrap(); assert(tree_set.contains_by(three,scalar.borrow()) && !tree_set.contains_by(four,scalar.borrow())); assert(stored(tree_set.get_by(query,policy.borrow()).unwrap())==3); assert(stored(tree_set.remove_by(three,scalar.borrow()).unwrap())==3); tree_set.destroy();
    assert(policy.calls==9 && scalar.calls==5 && change.calls==2); assert(backing[0]==77 && backing[1]==0 && backing[2]==128 && backing[3]==255 && backing[4]==88); return 0;
}
// No Hash/Eq/Ord for Opaque, and no Hash/Eq/Ord for TreeQuery.
struct Opaque { payload:[u64;2] }
struct TreeQuery { ignored:bool }
struct Never {}
impl Never { fn borrow(&self) -> &Never { return self; } }
pub impl core::function::Mapper<core::pair::Pair<Opaque,u32>,bool> for Never { pub fn apply(&self,pair:core::pair::Pair<Opaque,u32>) -> bool { assert(false); return false; } }
pub impl core::ordering::Comparator<Opaque,TreeQuery> for Never { pub fn compare(&self,key:Opaque,query:TreeQuery) -> core::ordering::Ordering { assert(false); return core::ordering::Equal; } }
struct NeverUpdate {}
impl NeverUpdate { fn borrow(&self) -> &NeverUpdate { return self; } }
pub impl core::function::Mapper<i32,core::pair::Pair<i32,i32>> for NeverUpdate { pub fn apply(&self,value:i32) -> core::pair::Pair<i32,i32> { assert(false); return core::pair::Pair { first:value,second:value }; } }
fn minimal_bounds() -> i32 {
    let policy:Never=Never {}; let update:NeverUpdate=NeverUpdate {}; let query:u32=9; let tree_query:TreeQuery=TreeQuery { ignored:true }; let hash:alloc::hash_map::HashMap<Opaque,i32> =alloc::hash_map::new<Opaque,i32>();
    assert(!hash.contains_key_by(query,policy.borrow()) && hash.get_by(query,policy.borrow()).is_none() && hash.get_entry_by(query,policy.borrow()).is_none() && hash.remove_by(query,policy.borrow()).is_none()); let h:core::option::Option<i32> =hash.update_value_by<u32,Never,NeverUpdate,i32>(query,policy.borrow(),update.borrow()); assert(h.is_none()); hash.destroy();
    let tree:alloc::tree_map::TreeMap<Opaque,i32> =alloc::tree_map::new<Opaque,i32>(); assert(!tree.contains_key_by(tree_query,policy.borrow()) && tree.get_by(tree_query,policy.borrow()).is_none() && tree.get_entry_by(tree_query,policy.borrow()).is_none() && tree.remove_by(tree_query,policy.borrow()).is_none()); let t:core::option::Option<i32> =tree.update_value_by<TreeQuery,Never,NeverUpdate,i32>(tree_query,policy.borrow(),update.borrow()); assert(t.is_none()); tree.destroy();
    let hs:alloc::hash_set::HashSet<Opaque> =alloc::hash_set::new<Opaque>(); assert(!hs.contains_by(query,policy.borrow()) && hs.get_by(query,policy.borrow()).is_none() && hs.remove_by(query,policy.borrow()).is_none()); hs.destroy();
    let ts:alloc::tree_set::TreeSet<Opaque> =alloc::tree_set::new<Opaque>(); assert(!ts.contains_by(tree_query,policy.borrow()) && ts.get_by(tree_query,policy.borrow()).is_none() && ts.remove_by(tree_query,policy.borrow()).is_none()); ts.destroy(); return 0;
}
fn text_policy() -> i32 {
    let source:[u8;4]=[195,169,0,65]; let owner:alloc::string::String=alloc::string::from_utf8(source,4).unwrap(); let policy:alloc::string::TextKey=alloc::string::TextKey {};
    let backing:[u8;6]=[77,195,169,0,65,88]; let text:core::text::Text=core::text::from_utf8_range(backing,1,4).unwrap(); assert(policy.apply(core::pair::Pair { first:owner,second:text })); assert(match(policy.compare(owner,text)) { core::ordering::Equal -> true,_ -> false, }); assert(alloc::string::String::hash(owner)==core::text::Text::hash(text));
    let lower:[u8;4]=[195,169,0,97]; let lower_text:core::text::Text=core::text::from_utf8(lower,4).unwrap(); assert(!policy.apply(core::pair::Pair { first:owner,second:lower_text })); assert(match(policy.compare(owner,lower_text)) { core::ordering::Less -> true,_ -> false, });
    let prefix:core::text::Text=core::text::from_utf8_range(backing,1,3).unwrap(); assert(!policy.apply(core::pair::Pair { first:owner,second:prefix })); assert(match(policy.compare(owner,prefix)) { core::ordering::Greater -> true,_ -> false, });
    let empty:core::text::Text=core::text::from_utf8(backing,0).unwrap(); assert(!policy.apply(core::pair::Pair { first:owner,second:empty })); assert(match(policy.compare(owner,empty)) { core::ordering::Greater -> true,_ -> false, });
    let decomposed:[u8;5]=[101,204,129,0,65]; let decomposed_text:core::text::Text=core::text::from_utf8(decomposed,5).unwrap(); assert(!policy.apply(core::pair::Pair { first:owner,second:decomposed_text })); assert(match(policy.compare(owner,decomposed_text)) { core::ordering::Greater -> true,_ -> false, });
    let i:i32=0; while(i<4) { assert(owner.as_bytes()[i]==source[i]); let expected:u8=source[i]; if(i==3) { expected=97; } assert(lower[i]==expected); i+=1; } assert(backing[0]==77 && backing[1]==195 && backing[2]==169 && backing[3]==0 && backing[4]==65 && backing[5]==88); assert(decomposed[0]==101 && decomposed[1]==204 && decomposed[2]==129 && decomposed[3]==0 && decomposed[4]==65); owner.destroy(); return 0;
}
struct NaturalKey { rank:i32,tag:i32,events:[i32] }
pub impl core::cmp::Ord<NaturalKey> for NaturalKey {
    pub fn lt(left:NaturalKey,right:NaturalKey) -> bool { let count:i32=left.events[0]; left.events[count+1]=left.tag*10+right.tag; left.events[0]=count+1; return left.rank<right.rank; }
    pub fn le(left:NaturalKey,right:NaturalKey) -> bool { return left.rank<=right.rank; }
    pub fn gt(left:NaturalKey,right:NaturalKey) -> bool { return left.rank>right.rank; }
    pub fn ge(left:NaturalKey,right:NaturalKey) -> bool { return left.rank>=right.rank; }
}
fn natural_order() -> i32 {
    let events:[i32;5]=[0,77,77,77,77]; let key:NaturalKey=NaturalKey { rank:3,tag:1,events:events }; let tree:alloc::tree_map::TreeMap<NaturalKey,i32> =alloc::tree_map::with_capacity<NaturalKey,i32>(2).unwrap(); tree.try_insert(key,90).unwrap();
    let equal:NaturalKey=NaturalKey { rank:3,tag:2,events:events }; assert(tree.get_entry(equal).unwrap().key.tag==1 && events[0]==2 && events[1]==21 && events[2]==12 && events[3]==77 && events[4]==77);
    events[0]=0; events[1]=77; events[2]=77; let smaller:NaturalKey=NaturalKey { rank:1,tag:2,events:events }; assert(tree.get_entry(smaller).is_none() && events[0]==1 && events[1]==21 && events[2]==77 && events[3]==77 && events[4]==77);
    events[0]=0; events[1]=77; let larger:NaturalKey=NaturalKey { rank:5,tag:2,events:events }; assert(tree.get_entry(larger).is_none() && events[0]==2 && events[1]==21 && events[2]==12 && events[3]==77 && events[4]==77); tree.destroy(); return 0;
}
fn main() -> i32 { generic_shapes(); minimal_bounds(); text_policy(); natural_order(); return 0; }
