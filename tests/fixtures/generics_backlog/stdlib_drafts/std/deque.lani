// DRAFT, not in the stdlib yet: a generic owned ring-buffer deque.
// It replaces std::deque_{bool,char,i16,i32,i8,u16,u32,u8,wide_i64,wide_u64}
// (DequeI32 and friends become Deque<T>).
// Blockers are listed by backlog id in tests/fixtures/generics_backlog/README.md.
//
// Both ends push and pop in O(1) except when growth copies existing elements
// into a larger allocation. The allocation holds capacity * size_of<T>()
// bytes; slot i is the size_of<T>() bytes at storage + i * size_of<T>(), read
// and written at type T through core::mem::typed_slice_from_storage. contains
// compares through core::cmp::Eq.
// Ownership is linear by convention: keep only the newest returned Deque and
// destroy each independent deque exactly once.
module std::deque;
import alloc::allocator;
import core::cmp;
import core::mem;

pub struct Deque<T> {
    storage: ptr,
    length: i32,
    reserved: i32,
    head: i32,
}

// Doubled capacities fit signed i32. Byte counts are computed as usize.
// Allocations use eight-byte alignment, the largest native scalar alignment.
pub const MAX_CAPACITY: i32 = 536870911;

fn byte_size<T>(value: Deque<T>, count: i32) -> usize {
    return core::mem::size_of<T>() * (count as usize);
}

// One-element views keep the address of element i independent of any view
// length, whichever direction the native layout runs.
// Reads physical slot index of value's allocation.
fn load<T>(value: Deque<T>, index: i32) -> T {
    let offset: usize = core::mem::size_of<T>() * (index as usize);
    let element: [T] = core::mem::typed_slice_from_storage(value.storage + offset, 1);
    return element[0];
}

fn store<T>(storage: ptr, index: i32, item: T) {
    let offset: usize = core::mem::size_of<T>() * (index as usize);
    let element: [T] = core::mem::typed_slice_from_storage(storage + offset, 1);
    element[0] = item;
}

fn physical_index<T>(value: Deque<T>, ordinal: i32) -> i32 {
    let slot: i32 = value.head + ordinal;
    if (slot >= value.reserved) { slot -= value.reserved; }
    return slot;
}

pub fn new<T>() -> Deque<T> {
    let empty: ptr = 0;
    return Deque { storage: empty, length: 0, reserved: 0, head: 0 };
}

pub fn len<T>(value: Deque<T>) -> i32 {
    return value.length;
}

pub fn capacity<T>(value: Deque<T>) -> i32 {
    return value.reserved;
}

pub fn is_empty<T>(value: Deque<T>) -> bool {
    return value.length == 0;
}

// Invalid requests or allocation failure return the original owner unchanged.
// Successful reservation reorders physical storage so the first item is at
// slot zero; logical order is retained. Compare capacity with the request.
pub fn try_reserve<T>(value: Deque<T>, minimum_capacity: i32) -> Deque<T> {
    if (minimum_capacity < 0 || minimum_capacity > MAX_CAPACITY ||
        minimum_capacity <= value.reserved) { return value; }
    let next: ptr = alloc::allocator::alloc(byte_size(value, minimum_capacity), 8);
    if (next == 0) { return value; }
    let index: i32 = 0;
    while (index < value.length) {
        store(next, index, load(value, physical_index(value, index)));
        index += 1;
    }
    if (value.storage != 0) {
        alloc::allocator::dealloc(value.storage, byte_size(value, value.reserved), 8);
    }
    return Deque { storage: next, length: value.length, reserved: minimum_capacity, head: 0 };
}

// On invalid capacity or allocation failure return an empty zero-capacity
// deque. Compare capacity(result) with the request to distinguish failure.
pub fn try_with_capacity<T>(initial_capacity: i32) -> Deque<T> {
    let empty: Deque<T> = new();
    return try_reserve(empty, initial_capacity);
}

// Return an independent copy in logical order. Allocation failure for a
// nonempty source returns an empty deque; the source stays owned and intact.
pub fn try_clone<T>(value: Deque<T>) -> Deque<T> {
    let empty: Deque<T> = new();
    if (value.length == 0) { return empty; }
    let copy: Deque<T> = try_with_capacity(value.length);
    if (copy.reserved < value.length) { return empty; }
    let index: i32 = 0;
    while (index < value.length) {
        store(copy.storage, index, load(value, physical_index(value, index)));
        index += 1;
    }
    return Deque { storage: copy.storage, length: value.length, reserved: copy.reserved, head: 0 };
}

// Push success increments len; capacity limit or allocation failure returns
// the original deque unchanged. Growth preserves logical order.
pub fn try_push_back<T>(value: Deque<T>, item: T) -> Deque<T> {
    if (value.length >= MAX_CAPACITY) { return value; }
    let grown: Deque<T> = value;
    if (grown.length == grown.reserved) {
        let target: i32 = 4;
        if (grown.reserved > 0) {
            if (grown.reserved > MAX_CAPACITY / 2) { target = MAX_CAPACITY; }
            else { target = grown.reserved * 2; }
        }
        grown = try_reserve(grown, target);
        if (grown.length == grown.reserved) { return value; }
    }
    store(grown.storage, physical_index(grown, grown.length), item);
    return Deque {
        storage: grown.storage, length: grown.length + 1,
        reserved: grown.reserved, head: grown.head,
    };
}

pub fn try_push_front<T>(value: Deque<T>, item: T) -> Deque<T> {
    if (value.length >= MAX_CAPACITY) { return value; }
    let grown: Deque<T> = value;
    if (grown.length == grown.reserved) {
        let target: i32 = 4;
        if (grown.reserved > 0) {
            if (grown.reserved > MAX_CAPACITY / 2) { target = MAX_CAPACITY; }
            else { target = grown.reserved * 2; }
        }
        grown = try_reserve(grown, target);
        if (grown.length == grown.reserved) { return value; }
    }
    let next_head: i32 = grown.head - 1;
    if (grown.head == 0) { next_head = grown.reserved - 1; }
    store(grown.storage, next_head, item);
    return Deque {
        storage: grown.storage, length: grown.length + 1,
        reserved: grown.reserved, head: next_head,
    };
}

// Fallbacks are returned on empty or out-of-range access. A stored value may
// equal the fallback; use len to distinguish empty or invalid ordinals.
pub fn at_or<T>(value: Deque<T>, ordinal: i32, fallback: T) -> T {
    if (ordinal < 0 || ordinal >= value.length) { return fallback; }
    return load(value, physical_index(value, ordinal));
}

pub fn front_or<T>(value: Deque<T>, fallback: T) -> T {
    return at_or(value, 0, fallback);
}

pub fn back_or<T>(value: Deque<T>, fallback: T) -> T {
    return at_or(value, value.length - 1, fallback);
}

pub fn contains<T>(value: Deque<T>, item: T) -> bool where T: core::cmp::Eq<T> {
    let index: i32 = 0;
    while (index < value.length) {
        let stored: T = load(value, physical_index(value, index));
        if (T::eq(stored, item)) { return true; }
        index += 1;
    }
    return false;
}

// In-place mutation is limited to valid logical ordinals.
pub fn try_set<T>(value: Deque<T>, ordinal: i32, item: T) -> bool {
    if (ordinal < 0 || ordinal >= value.length) { return false; }
    store(value.storage, physical_index(value, ordinal), item);
    return true;
}

pub fn try_swap<T>(value: Deque<T>, left: i32, right: i32) -> bool {
    if (left < 0 || right < 0 || left >= value.length || right >= value.length) {
        return false;
    }
    let left_slot: i32 = physical_index(value, left);
    let right_slot: i32 = physical_index(value, right);
    let saved: T = load(value, left_slot);
    store(value.storage, left_slot, load(value, right_slot));
    store(value.storage, right_slot, saved);
    return true;
}

// Popping an empty deque returns it unchanged. Read front_or/back_or first if
// the removed item is needed. The allocation remains available for reuse.
pub fn try_pop_front<T>(value: Deque<T>) -> Deque<T> {
    if (value.length == 0) { return value; }
    let next_head: i32 = value.head + 1;
    if (next_head == value.reserved) { next_head = 0; }
    return Deque {
        storage: value.storage, length: value.length - 1,
        reserved: value.reserved, head: next_head,
    };
}

pub fn try_pop_back<T>(value: Deque<T>) -> Deque<T> {
    if (value.length == 0) { return value; }
    return Deque {
        storage: value.storage, length: value.length - 1,
        reserved: value.reserved, head: value.head,
    };
}

pub fn clear<T>(value: Deque<T>) -> Deque<T> {
    return Deque { storage: value.storage, length: 0, reserved: value.reserved, head: 0 };
}

// Reduce capacity to len, preserving logical order. Empty deques release
// their allocation. A failed allocation leaves the source unchanged.
pub fn try_shrink_to_fit<T>(value: Deque<T>) -> Deque<T> {
    if (value.length == value.reserved) { return value; }
    if (value.length == 0) {
        destroy(value);
        let empty: Deque<T> = new();
        return empty;
    }
    let next: ptr = alloc::allocator::alloc(byte_size(value, value.length), 8);
    if (next == 0) { return value; }
    let index: i32 = 0;
    while (index < value.length) {
        store(next, index, load(value, physical_index(value, index)));
        index += 1;
    }
    alloc::allocator::dealloc(value.storage, byte_size(value, value.reserved), 8);
    return Deque { storage: next, length: value.length, reserved: value.length, head: 0 };
}

pub fn destroy<T>(value: Deque<T>) {
    if (value.storage != 0) {
        alloc::allocator::dealloc(value.storage, byte_size(value, value.reserved), 8);
    }
}
