// DRAFT, not in the stdlib yet: the generic form of stdlib/core/range.lani.
// It replaces core::range_{char,f32,i16,i8,u16,u8} (RangeChar and friends become Range<T>).
// Blockers are listed by backlog id in tests/fixtures/generics_backlog/README.md.
// Declaration seeds for core range values.
module core::range;
import core::cmp;
pub struct Range<T> {
    start: T,
    end: T,
}
pub struct RangeInclusive<T> {
    start: T,
    end: T,
}
pub struct RangeFrom<T> {
    start: T,
}
pub struct RangeTo<T> {
    end: T,
}
pub struct RangeFull {
}
pub fn range_i32(start: i32, end: i32) -> Range<i32> {
    return Range {
        start: start,
        end: end,
    };
}
pub fn start_i32(range: Range<i32>) -> i32 {
    return range.start;
}
pub fn end_i32(range: Range<i32>) -> i32 {
    return range.end;
}
pub fn is_empty_i32(range: Range<i32>) -> bool {
    return range.start >= range.end;
}
pub fn contains_i32(range: Range<i32>, value: i32) -> bool {
    return value >= range.start && value<range.end;
}
pub fn overlaps_i32(left: Range<i32>, right: Range<i32>) -> bool {
    return left.start<left.end && right.start<right.end && left.start<right.end && right.start<left.end;
}
pub fn range_inclusive_i32(start: i32, end: i32) -> RangeInclusive<i32> {
    return RangeInclusive {
        start: start,
        end: end,
    };
}
pub fn start_inclusive_i32(range: RangeInclusive<i32>) -> i32 {
    return range.start;
}
pub fn end_inclusive_i32(range: RangeInclusive<i32>) -> i32 {
    return range.end;
}
pub fn is_empty_inclusive_i32(range: RangeInclusive<i32>) -> bool {
    return range.start>range.end;
}
pub fn contains_inclusive_i32(range: RangeInclusive<i32>, value: i32) -> bool {
    return value >= range.start && value <= range.end;
}
pub fn overlaps_inclusive_i32(left: RangeInclusive<i32>, right: RangeInclusive<i32>) -> bool {
    return left.start <= left.end && right.start <= right.end && left.start <= right.end && right.start <= left.end;
}
pub fn range_from_i32(start: i32) -> RangeFrom<i32> {
    return RangeFrom {
        start: start,
    };
}
pub fn start_from_i32(range: RangeFrom<i32>) -> i32 {
    return range.start;
}
pub fn contains_from_i32(range: RangeFrom<i32>, value: i32) -> bool {
    return value >= range.start;
}
pub fn range_to_i32(end: i32) -> RangeTo<i32> {
    return RangeTo {
        end: end,
    };
}
pub fn end_to_i32(range: RangeTo<i32>) -> i32 {
    return range.end;
}
pub fn contains_to_i32(range: RangeTo<i32>, value: i32) -> bool {
    return value<range.end;
}
pub fn range_full() -> RangeFull {
    return RangeFull {
    };
}
pub fn contains_full_i32(range: RangeFull, value: i32) -> bool {
    return true;
}
// Unsigned range operations mirror the signed forms, including their
// concrete receiver methods.
pub fn range_u32(start: u32, end: u32) -> Range<u32> {
    return Range {
        start: start,
        end: end,
    };
}
pub fn start_u32(range: Range<u32>) -> u32 {
    return range.start;
}
pub fn end_u32(range: Range<u32>) -> u32 {
    return range.end;
}
pub fn is_empty_u32(range: Range<u32>) -> bool {
    return range.start >= range.end;
}
pub fn contains_u32(range: Range<u32>, value: u32) -> bool {
    return value >= range.start && value<range.end;
}
pub fn overlaps_u32(left: Range<u32>, right: Range<u32>) -> bool {
    return left.start<left.end && right.start<right.end && left.start<right.end && right.start<left.end;
}
pub fn range_inclusive_u32(start: u32, end: u32) -> RangeInclusive<u32> {
    return RangeInclusive {
        start: start,
        end: end,
    };
}
pub fn start_inclusive_u32(range: RangeInclusive<u32>) -> u32 {
    return range.start;
}
pub fn end_inclusive_u32(range: RangeInclusive<u32>) -> u32 {
    return range.end;
}
pub fn is_empty_inclusive_u32(range: RangeInclusive<u32>) -> bool {
    return range.start>range.end;
}
pub fn contains_inclusive_u32(range: RangeInclusive<u32>, value: u32) -> bool {
    return value >= range.start && value <= range.end;
}
pub fn overlaps_inclusive_u32(left: RangeInclusive<u32>, right: RangeInclusive<u32>) -> bool {
    return left.start <= left.end && right.start <= right.end && left.start <= right.end && right.start <= left.end;
}
pub fn range_from_u32(start: u32) -> RangeFrom<u32> {
    return RangeFrom {
        start: start,
    };
}
pub fn start_from_u32(range: RangeFrom<u32>) -> u32 {
    return range.start;
}
pub fn contains_from_u32(range: RangeFrom<u32>, value: u32) -> bool {
    return value >= range.start;
}
pub fn range_to_u32(end: u32) -> RangeTo<u32> {
    return RangeTo {
        end: end,
    };
}
pub fn end_to_u32(range: RangeTo<u32>) -> u32 {
    return range.end;
}
pub fn contains_to_u32(range: RangeTo<u32>, value: u32) -> bool {
    return value<range.end;
}
pub fn contains_full_u32(range: RangeFull, value: u32) -> bool {
    return true;
}
pub impl RangeFull {
    pub fn contains_i32(&self, value: i32) -> bool {
        return true;
    }
    pub fn contains_u32(&self, value: u32) -> bool {
        return true;
    }
}

// ---- Generic forms of the per-type range modules. ----
// Construction and field reads need no bound.

pub fn range<T>(start: T, end: T) -> Range<T> {
    return Range { start: start, end: end };
}
pub fn start<T>(value: Range<T>) -> T { return value.start; }
pub fn end<T>(value: Range<T>) -> T { return value.end; }

pub fn range_inclusive<T>(start: T, end: T) -> RangeInclusive<T> {
    return RangeInclusive { start: start, end: end };
}
pub fn start_inclusive<T>(value: RangeInclusive<T>) -> T { return value.start; }
pub fn end_inclusive<T>(value: RangeInclusive<T>) -> T { return value.end; }

pub fn range_from<T>(start: T) -> RangeFrom<T> {
    return RangeFrom { start: start };
}
pub fn start_from<T>(value: RangeFrom<T>) -> T { return value.start; }

pub fn range_to<T>(end: T) -> RangeTo<T> {
    return RangeTo { end: end };
}
pub fn end_to<T>(value: RangeTo<T>) -> T { return value.end; }

// Every value is in the full range.
pub fn full_contains<T>(value: T) -> bool {
    return true;
}

// ---- Bounds-only forms (range_<type>::half_open_* and friends). ----

// Half-open [start, end). Equal or reversed bounds are empty.
pub fn half_open_is_empty<T>(start: T, end: T) -> bool where T: core::cmp::Ord<T> {
    return T::ge(start, end);
}

pub fn half_open_contains<T>(start: T, end: T, value: T) -> bool where T: core::cmp::Ord<T> {
    return T::ge(value, start) && T::lt(value, end);
}

pub fn half_open_overlaps<T>(left_start: T, left_end: T, right_start: T, right_end: T) -> bool where T: core::cmp::Ord<T> {
    return T::lt(left_start, left_end) && T::lt(right_start, right_end) &&
        T::lt(left_start, right_end) && T::lt(right_start, left_end);
}

// Inclusive [start, end]. Equal bounds contain exactly one value.
pub fn inclusive_is_empty<T>(start: T, end: T) -> bool where T: core::cmp::Ord<T> {
    return T::gt(start, end);
}

pub fn inclusive_contains<T>(start: T, end: T, value: T) -> bool where T: core::cmp::Ord<T> {
    return T::ge(value, start) && T::le(value, end);
}

pub fn inclusive_overlaps<T>(left_start: T, left_end: T, right_start: T, right_end: T) -> bool where T: core::cmp::Ord<T> {
    return T::le(left_start, left_end) && T::le(right_start, right_end) &&
        T::le(left_start, right_end) && T::le(right_start, left_end);
}

pub fn from_contains<T>(start: T, value: T) -> bool where T: core::cmp::Ord<T> {
    return T::ge(value, start);
}

pub fn to_contains<T>(end: T, value: T) -> bool where T: core::cmp::Ord<T> {
    return T::lt(value, end);
}

// ---- Range value forms. ----

pub fn is_empty<T>(value: Range<T>) -> bool where T: core::cmp::Ord<T> {
    return half_open_is_empty(value.start, value.end);
}
pub fn contains<T>(value: Range<T>, item: T) -> bool where T: core::cmp::Ord<T> {
    return half_open_contains(value.start, value.end, item);
}
pub fn overlaps<T>(left: Range<T>, right: Range<T>) -> bool where T: core::cmp::Ord<T> {
    return half_open_overlaps(left.start, left.end, right.start, right.end);
}

pub fn is_empty_inclusive<T>(value: RangeInclusive<T>) -> bool where T: core::cmp::Ord<T> {
    return inclusive_is_empty(value.start, value.end);
}
pub fn contains_inclusive<T>(value: RangeInclusive<T>, item: T) -> bool where T: core::cmp::Ord<T> {
    return inclusive_contains(value.start, value.end, item);
}
pub fn overlaps_inclusive<T>(left: RangeInclusive<T>, right: RangeInclusive<T>) -> bool where T: core::cmp::Ord<T> {
    return inclusive_overlaps(left.start, left.end, right.start, right.end);
}

pub fn contains_from<T>(value: RangeFrom<T>, item: T) -> bool where T: core::cmp::Ord<T> {
    return from_contains(value.start, item);
}

pub fn contains_to<T>(value: RangeTo<T>, item: T) -> bool where T: core::cmp::Ord<T> {
    return to_contains(value.end, item);
}

// ---- Methods. These replace the concrete Range<i32> and Range<u32> impls. ----

pub impl<T> Range<T> {
    pub fn start(self) -> T { return self.start; }
    pub fn end(self) -> T { return self.end; }
}

pub impl<T> Range<T> where T: core::cmp::Ord<T> {
    pub fn is_empty(self) -> bool {
        return half_open_is_empty(self.start, self.end);
    }
    pub fn contains(self, item: T) -> bool {
        return half_open_contains(self.start, self.end, item);
    }
    pub fn overlaps(self, other: Range<T>) -> bool {
        return half_open_overlaps(self.start, self.end, other.start, other.end);
    }
}

pub impl<T> RangeInclusive<T> {
    pub fn start(self) -> T { return self.start; }
    pub fn end(self) -> T { return self.end; }
}

pub impl<T> RangeInclusive<T> where T: core::cmp::Ord<T> {
    pub fn is_empty(self) -> bool {
        return inclusive_is_empty(self.start, self.end);
    }
    pub fn contains(self, item: T) -> bool {
        return inclusive_contains(self.start, self.end, item);
    }
    pub fn overlaps(self, other: RangeInclusive<T>) -> bool {
        return inclusive_overlaps(self.start, self.end, other.start, other.end);
    }
}

pub impl<T> RangeFrom<T> {
    pub fn start(self) -> T { return self.start; }
}

pub impl<T> RangeFrom<T> where T: core::cmp::Ord<T> {
    pub fn contains(self, item: T) -> bool {
        return from_contains(self.start, item);
    }
}

pub impl<T> RangeTo<T> {
    pub fn end(self) -> T { return self.end; }
}

pub impl<T> RangeTo<T> where T: core::cmp::Ord<T> {
    pub fn contains(self, item: T) -> bool {
        return to_contains(self.end, item);
    }
}
