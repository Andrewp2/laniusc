// IEEE comparisons, as the f32 modules use today: NaN equals nothing and is
// unordered, so generic sort and search need NaN-free input. core::slice_f32
// keeps the *_finite_or forms that check for NaN.
pub impl Eq<f32> for f32 {
    pub fn eq(left: f32, right: f32) -> bool { return left == right; }
    pub fn ne(left: f32, right: f32) -> bool { return left != right; }
}

pub impl Ord<f32> for f32 {
    pub fn lt(left: f32, right: f32) -> bool { return left < right; }
    pub fn le(left: f32, right: f32) -> bool { return left <= right; }
    pub fn gt(left: f32, right: f32) -> bool { return left > right; }
    pub fn ge(left: f32, right: f32) -> bool { return left >= right; }
}

// Address identity only; pointers have no order here.
pub impl Eq<ptr> for ptr {
    pub fn eq(left: ptr, right: ptr) -> bool { return left == right; }
    pub fn ne(left: ptr, right: ptr) -> bool { return left != right; }
}

pub impl Eq<core::wide_u64::WideU64> for core::wide_u64::WideU64 {
    pub fn eq(left: core::wide_u64::WideU64, right: core::wide_u64::WideU64) -> bool {
        return core::wide_u64::eq(left, right);
    }
    pub fn ne(left: core::wide_u64::WideU64, right: core::wide_u64::WideU64) -> bool {
        return !core::wide_u64::eq(left, right);
    }
}

pub impl Ord<core::wide_u64::WideU64> for core::wide_u64::WideU64 {
    pub fn lt(left: core::wide_u64::WideU64, right: core::wide_u64::WideU64) -> bool {
        return core::wide_u64::compare(left, right) < 0;
    }
    pub fn le(left: core::wide_u64::WideU64, right: core::wide_u64::WideU64) -> bool {
        return core::wide_u64::compare(left, right) <= 0;
    }
    pub fn gt(left: core::wide_u64::WideU64, right: core::wide_u64::WideU64) -> bool {
        return core::wide_u64::compare(left, right) > 0;
    }
    pub fn ge(left: core::wide_u64::WideU64, right: core::wide_u64::WideU64) -> bool {
        return core::wide_u64::compare(left, right) >= 0;
    }
}

pub impl Eq<core::wide_i64::WideI64> for core::wide_i64::WideI64 {
    pub fn eq(left: core::wide_i64::WideI64, right: core::wide_i64::WideI64) -> bool {
