// Test-only raw binary adapter. Each accepted input prefix is immediately poisoned.
module app::main;
import core::mem;
import core::result;
import core::slice;
import ext::deflate;
import ext::compression;
import std::io;

fn read_exact(pointer:ptr,count:i32,allow_eof:bool) -> bool {
    let done:i32=0;
    while(done<count) {
        let got:i32=std::io::read_stdin(pointer+(done as usize),(count-done) as usize);
        assert(got>=0);
        if(got==0) { assert(allow_eof && done==0); return false; }
        done+=got;
    }
    return true;
}
fn write_all(pointer:ptr,count:i32) {
    let done:i32=0;
    while(done<count) {
        let got:i32=std::io::write_stdout(pointer+(done as usize),(count-done) as usize);
        assert(got>0); done+=got;
    }
}
fn get64(bytes:[u8],offset:i32) -> u64 {
    let value:u64=0; let index:i32=0;
    while(index<8) { value|=(bytes[offset+index] as u64)<<(index*8); index+=1; }
    return value;
}
struct Output { bytes:[u8],pointer:ptr,used:i32 }
impl Output {
    fn borrow(&self) -> &Output { return self; }
    fn flush(&self) { write_all(self.pointer,self.used); self.used=0; }
    fn byte(&self,value:u8) {
        if(self.used==4096) { self.flush(); }
        self.bytes[self.used]=value; self.used+=1;
    }
    fn word(&self,value:u64) {
        let index:i32=0;
        while(index<8) { self.byte(((value>>(index*8))&255) as u8); index+=1; }
    }
}
fn raw_code(error:ext::deflate::Error) -> i32 {
    return match(error) { ext::deflate::Error::Bounds -> 1,
        ext::deflate::Error::ScratchTooSmall(count) -> 2,
        ext::deflate::Error::Capacity(count) -> 3,ext::deflate::Error::SizeOverflow -> 4 };
}
fn frame_code(error:ext::compression::Error) -> i32 {
    return match(error) { ext::compression::Error::Bounds -> 1,
        ext::compression::Error::InputLimit -> 2,ext::compression::Error::OutputLimit -> 3,
        ext::compression::Error::Encode(error) -> 100+raw_code(error), _ -> 200 };
}
fn status(value:ext::deflate::Status) -> i32 {
    return match(value) { ext::deflate::Status::NeedInput -> 1,
        ext::deflate::Status::NeedOutput -> 2,ext::deflate::Status::Done -> 3 };
}
struct Observation { read:i32,written:i32,status:i32,error:i32 }
struct Harness { raw:ext::deflate::Encoder,framed:ext::compression::Encoder,kind:i32 }
impl Harness {
    fn borrow(&self) -> &Harness { return self; }
    fn step(&self,input:core::slice::View<u8>,output:core::slice::View<u8>,final_input:bool) -> Observation {
        if(self.kind==0) {
            let result:core::result::Result<ext::deflate::Step,ext::deflate::Failure> = self.raw.step(input,output,final_input);
            if(result.is_err()) { let failure:ext::deflate::Failure=result.unwrap_err(); return Observation { read:failure.read,written:failure.written,status:0,error:raw_code(failure.error) }; }
            let step:ext::deflate::Step=result.unwrap(); return Observation { read:step.read,written:step.written,status:status(step.status),error:0 };
        }
        let result:core::result::Result<ext::deflate::Step,ext::compression::EncodeFailure> = self.framed.step(input,output,final_input);
        if(result.is_err()) { let failure:ext::compression::EncodeFailure=result.unwrap_err(); return Observation { read:failure.read,written:failure.written,status:0,error:frame_code(failure.error) }; }
        let step:ext::deflate::Step=result.unwrap(); return Observation { read:step.read,written:step.written,status:status(step.status),error:0 };
    }
    fn done(&self) -> bool { if(self.kind==0) { return self.raw.is_done(); } return self.framed.is_done(); }
    fn failed(&self) -> bool { if(self.kind==0) { return false; } return self.framed.is_failed(); }
    fn counters(&self,output:&Output) {
        if(self.kind==0) { output.word(0); output.word(0); }
        else { output.word(self.framed.total_read()); output.word(self.framed.total_written()); }
    }
}
fn output_capacity(pass:i32,call:i32) -> i32 {
    if(pass==0) { return 2048; }
    if(pass==2) { let sizes:[i32;5]=[0,1,1,0,1]; return sizes[call%5]; }
    let sizes:[i32;8]=[0,1,0,7,31,2048,509,0]; return sizes[call%8];
}
fn next_frontier(pass:i32,frontier:i32,length:i32,turn:i32) -> i32 {
    let amount:i32=1;
    if(pass==1) { let sizes:[i32;9]=[0,1,13,4093,32767,2,0,8191,257]; amount=sizes[turn%9]; }
    if(amount>length-frontier) { amount=length-frontier; }
    return frontier+amount;
}
fn fill_output(destination:[u8],call:i32) {
    let index:i32=0;
    while(index<2056) { destination[index]=((193+call%29+index*7)&255) as u8; index+=1; }
}
fn emit(record:i32,pass:i32,call:i32,offered:i32,capacity:i32,final_input:bool,value:Observation,harness:&Harness,destination:[u8],output:&Output) {
    output.word(record as u64); output.word(pass as u64); output.word(call as u64);
    output.word(offered as u64); output.word(capacity as u64); output.word(final_input as u64);
    output.word(value.read as u64); output.word(value.written as u64); output.word(value.status as u64); output.word(value.error as u64);
    output.word(harness.done() as u64); output.word(harness.failed() as u64); harness.counters(output);
    let index:i32=0; while(index<2056) { output.byte(destination[index]); index+=1; }
}
fn stream(harness:&Harness,original:[u8],source:[u8],destination:[u8],length:i32,pass:i32,output:&Output) {
    output.word(10); output.word(pass as u64); output.word(harness.done() as u64); output.word(harness.failed() as u64); harness.counters(output);
    let frontier:i32=0; if(pass==0) { frontier=length; }
    let final_input:bool=pass==0;
    let position:i32=0; let call:i32=0; let input_turn:i32=0; let finished:bool=false;
    let index:i32=0;
    while(index<length+8) { source[index]=((81+index*11)&255) as u8; index+=1; }
    index=0; while(index<length) { source[4+index]=original[index]; index+=1; }
    while(!finished) {
        assert(call<2000); let offered:i32=frontier-position; let capacity:i32=output_capacity(pass,call);
        fill_output(destination,call);
        let input:core::slice::View<u8> = core::slice::View { values:source,start:4+position,length:offered };
        let target:core::slice::View<u8> = core::slice::View { values:destination,start:4,length:capacity };
        let value:Observation=harness.step(input,target,final_input);
        assert(value.read>=0 && value.read<=offered && value.written>=0 && value.written<=capacity);
        index=position; while(index<frontier) { assert(source[4+index]==original[index]); index+=1; }
        emit(0,pass,call,offered,capacity,final_input,value,harness,destination,output);
        index=position; while(index<position+value.read) { source[4+index]=((index*17+43)&255) as u8; index+=1; }
        position+=value.read;
        if(value.error!=0 || value.status==3) { finished=true; }
        else {
            assert(value.status==1 || value.status==2);
            if(value.status==1) {
                if(frontier==length) { final_input=true; }
                else {
                    frontier=next_frontier(pass,frontier,length,input_turn); input_turn+=1;
                    if(pass==2 && frontier==length) { final_input=true; }
                }
            }
        }
        call+=1;
    }
    fill_output(destination,call);
    let empty:core::slice::View<u8> = core::slice::View { values:source,start:4+position,length:0 };
    let target:core::slice::View<u8> = core::slice::View { values:destination,start:4,length:0 };
    emit(1,pass,call,0,0,true,harness.step(empty,target,true),harness,destination,output); call+=1;
    fill_output(destination,call);
    let invalid:core::slice::View<u8> = core::slice::View { values:source,start:-1,length:0 };
    emit(2,pass,call,0,0,true,harness.step(invalid,target,true),harness,destination,output);
    output.word(4); output.word(pass as u64); output.word(position as u64); output.word(length as u64);
    index=0; while(index<length+8) { output.byte(source[index]); index+=1; }
}
fn guards(block:[u8],pending:[u8],scratch:[i32],output:&Output) {
    output.word(5); let index:i32=0;
    while(index<4) { output.byte(block[index]); output.byte(block[32772+index]); index+=1; }
    index=0; while(index<4) { output.byte(pending[index]); index+=1; }
    index=32777; while(index<32784) { output.byte(pending[index]); index+=1; }
    index=0; while(index<4) { output.word(scratch[index] as i64 as u64); output.word(scratch[32772+index] as i64 as u64); index+=1; }
}
fn run(header:[u8],original:[u8],output:&Output) {
    let kind:i32=get64(header,0) as i32; let layout:u64=get64(header,8);
    let length:i32=get64(header,16) as i32; let passes:i32=get64(header,24) as i32;
    let source_native:[u8;70008]=[0;70008]; let source_words:[i32;17502]=[0;17502];
    let destination_native:[u8;2056]=[0;2056]; let destination_words:[i32;514]=[0;514];
    let block_native:[u8;32776]=[0;32776]; let block_words:[i32;8194]=[0;8194];
    let pending_native:[u8;32784]=[0;32784]; let pending_words:[i32;8196]=[0;8196];
    let scratch:[i32;32776]=[0;32776];
    let source:[u8]=source_native; let destination:[u8]=destination_native;
    let block:[u8]=block_native; let pending:[u8]=pending_native;
    if((layout&1)!=0) { source=core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(source_words),70008); }
    if((layout&2)!=0) { destination=core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(destination_words),2056); }
    if((layout&4)!=0) { block=core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(block_words),32776); }
    if((layout&1)==0) { pending=core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(pending_words),32784); }
    output.word(0x6465666c61746531); output.word(kind as u64); output.word(layout); output.word(length as u64); output.word(passes as u64);
    output.word(core::mem::slice_stride(source) as i64 as u64); output.word(core::mem::slice_stride(destination) as i64 as u64);
    output.word(core::mem::slice_stride(block) as i64 as u64); output.word(core::mem::slice_stride(pending) as i64 as u64);
    output.word(core::mem::slice_stride(scratch) as i64 as u64);
    let index:i32=0;
    while(index<4) { block[index]=(211+index) as u8; block[32772+index]=(231+index) as u8;
        scratch[index]=-131-index; scratch[32772+index]=-151-index; pending[index]=(171+index) as u8; index+=1; }
    index=32777; while(index<32784) { pending[index]=((index+57)&255) as u8; index+=1; }
    let block_view:core::slice::View<u8> = core::slice::View { values:block,start:4,length:32768 };
    let pending_view:core::slice::View<u8> = core::slice::View { values:pending,start:4,length:32773 };
    let workspace:core::slice::View<i32> = core::slice::View { values:scratch,start:4,length:32768 };
    let format:ext::compression::Format=ext::compression::Format::RawDeflate;
    if(kind==2) { format=ext::compression::Format::Zlib; }
    if(kind==3) { format=ext::compression::Format::Gzip; }
    let limits:ext::compression::EncodeLimits=ext::compression::EncodeLimits { max_input:length as u64,max_output:18446744073709551615 };
    let harness:Harness=Harness { raw:ext::deflate::encoder(block_view,pending_view,workspace).unwrap(),
        framed:ext::compression::encoder(block_view,pending_view,workspace,format,limits).unwrap(),kind:kind };
    let pass:i32=0;
    while(pass<passes) {
        if(pass!=0) { if(kind==0) { harness.raw.reset(); } else { harness.framed.reset(format,limits); } }
        stream(harness.borrow(),original,source,destination,length,pass,output);
        guards(block,pending,scratch,output); pass+=1;
    }
    output.word(99);
}
fn main() -> i32 {
    let header_words:[i32;8]=[0;8]; let header_pointer:ptr=core::mem::i32_array_data_ptr(header_words);
    let header:[u8]=core::mem::typed_slice_from_raw_parts<u8>(header_pointer,32);
    let input_words:[i32;17500]=[0;17500]; let input_pointer:ptr=core::mem::i32_array_data_ptr(input_words);
    let input:[u8]=core::mem::typed_slice_from_raw_parts<u8>(input_pointer,70000);
    let output_words:[i32;1024]=[0;1024]; let output_pointer:ptr=core::mem::i32_array_data_ptr(output_words);
    let output:Output=Output { bytes:core::mem::typed_slice_from_raw_parts<u8>(output_pointer,4096),pointer:output_pointer,used:0 };
    while(read_exact(header_pointer,32,true)) {
        assert(get64(header,0)<=3 && get64(header,8)<=7 && get64(header,16)<=70000);
        assert(get64(header,24)==2 || (get64(header,24)==3 && get64(header,16)<=64));
        assert(read_exact(input_pointer,get64(header,16) as i32,false)); run(header,input,output.borrow());
    }
    output.flush(); return 0;
}
