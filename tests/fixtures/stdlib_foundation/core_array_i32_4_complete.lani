module app::main;
import core::array_i32_4;
fn main() -> i32 {
    let values:[i32; 4] =[3, -2, 3, 8];
    if (core::array_i32_4::len() != 4 || core::array_i32_4::is_empty()) {
        return 1;
    }
    if (core::array_i32_4::first(values) != 3 || core::array_i32_4::last(values) != 8) {
        return 2;
    }
    if (core::array_i32_4::sum(values) != 12) {
        return 3;
    }
    let overflowing:[i32; 4] =[2147483647, 1, 1, 1];
    if (core::array_i32_4::sum(overflowing) != 2147483647) {
        return 9;
    }
    let underflowing:[i32; 4] =[-2147483648, -1, -1, -1];
    if (core::array_i32_4::sum(underflowing) != -2147483648) {
        return 10;
    }
    if (core::array_i32_4::min(values) != -2 || core::array_i32_4::max(values) != 8) {
        return 4;
    }
    if (core::array_i32_4::get_or(values, 2, 99) != 3 || core::array_i32_4::get_or(values, -1, 99) != 99 || core::array_i32_4::get_or(values, 4, 99) != 99) {
        return 5;
    }
    if (!core::array_i32_4::contains(values, -2) || core::array_i32_4::contains(values, 7)) {
        return 6;
    }
    if (core::array_i32_4::count(values, 3) != 2 || core::array_i32_4::count(values, 7) != 0) {
        return 7;
    }
    if (core::array_i32_4::index_of_or(values, 3, 99) != 0 || core::array_i32_4::index_of_or(values, 7, 99) != 99) {
        return 8;
    }
    let destination:[i32; 4] =[0, 0, 0, 0];
    if (core::array_i32_4::copy_into(values, destination, 3) ||
        destination[0] != 0 ||
        !core::array_i32_4::copy_into(values, destination, 4) ||
        destination[0] != 3 || destination[1] != -2 ||
        destination[2] != 3 || destination[3] != 8) { return 11; }
    if (core::array_i32_4::fill(9, destination, -1) ||
        destination[0] != 3 ||
        !core::array_i32_4::fill(9, destination, 4) ||
        destination[0] != 9 || destination[1] != 9 ||
        destination[2] != 9 || destination[3] != 9) { return 12; }
    if (core::array_i32_4::reverse_into(values, destination, 0) ||
        destination[0] != 9 ||
        !core::array_i32_4::reverse_into(values, destination, 4) ||
        destination[0] != 8 || destination[1] != 3 ||
        destination[2] != -2 || destination[3] != 3) { return 13; }
    if (!core::array_i32_4::reverse_into(values, values, 4) ||
        values[0] != 8 || values[1] != 3 ||
        values[2] != -2 || values[3] != 3) { return 14; }
    return 0;
}
