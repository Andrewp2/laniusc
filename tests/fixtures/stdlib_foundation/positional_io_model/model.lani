// Binary test adapter for bounded portable positional-I/O helpers.
// Header: operation, layout, offset, count, position, budget, script length, id.
// Script words encode provider outcomes; all actual calls and bytes are emitted.
module app::main;

import core::io;
import core::mem;
import core::result;
import std::io;

fn read_exact(pointer: ptr, count: i32, allow_eof: bool) -> bool {
    let done: i32 = 0;
    while (done < count) {
        let got: i32 = std::io::read_stdin(pointer + (done as usize), (count - done) as usize);
        assert(got >= 0);
        if (got == 0) { assert(allow_eof && done == 0); return false; }
        done += got;
    }
    return true;
}

fn write_all(pointer: ptr, count: i32) {
    let done: i32 = 0;
    while (done < count) {
        let got: i32 = std::io::write_stdout(pointer + (done as usize), (count - done) as usize);
        assert(got > 0);
        done += got;
    }
}

fn get64(bytes: [u8], offset: i32) -> u64 {
    let result: u64 = 0;
    let index: i32 = 0;
    while (index < 8) {
        result |= (bytes[offset + index] as u64) << (index * 8);
        index += 1;
    }
    return result;
}

struct Output { bytes: [u8], pointer: ptr, used: i32 }
impl Output {
    fn borrow(&self) -> &Output { return self; }
    fn flush(&self) { write_all(self.pointer, self.used); self.used = 0; }
    fn word(&self, value: u64) {
        if (self.used == 4096) { self.flush(); }
        let index: i32 = 0;
        while (index < 8) {
            self.bytes[self.used + index] = ((value >> (index * 8)) & 255) as u8;
            index += 1;
        }
        self.used += 8;
    }
}

fn byte_at(position: u64) -> u8 {
    let mixed: u64 = (position ^ (position >> 32) ^ (position >> 55)) & 255;
    return ((mixed * 37 + 23) & 255) as u8;
}

fn response(event: i64, remaining: i32) -> core::result::Result<i32, core::io::Error> {
    if (event >= 0) { return core::result::Ok(event as i32); }
    if (event == -1) { return core::result::Err(core::io::Error::Interrupted); }
    if (event == -2) { return core::result::Err(core::io::Error::WouldBlock); }
    if (event == -3) { return core::result::Err(core::io::Error::Host(5)); }
    if (event == -4) { return core::result::Ok(-1); }
    if (event == -5) { return core::result::Ok(remaining + 1); }
    if (event == -6) { return core::result::Ok(remaining); }
    if (event == -7) { return core::result::Err(core::io::Error::InvalidInput); }
    if (event == -8) { return core::result::Err(core::io::Error::Host(2147483647)); }
    if (event == -9) { return core::result::Err(core::io::Error::Host(-123)); }
    if (event == -10) { return core::result::Err(core::io::Error::AllocationFailed); }
    if (event == -11) { return core::result::Err(core::io::Error::CountOverflow); }
    if (event == -12) { return core::result::Err(core::io::Error::LimitExceeded); }
    if (event == -13) { return core::result::Err(core::io::Error::UnexpectedEof); }
    if (event == -14) { return core::result::Err(core::io::Error::WriteZero); }
    if (event == -15) { return core::result::Err(core::io::Error::InvalidCount); }
    if (event == -16) { return core::result::Ok(-2147483648); }
    if (event == -17) { return core::result::Ok(2147483647); }
    assert(event == -18);
    return core::result::Err(core::io::Error::Host(0));
}

struct Provider {
    script: [i64], length: i32, calls: i32,
    offsets: [i64], counts: [i64], positions: [u64], events: [i64],
    sink: [u8], sent: i32
}
impl Provider {
    fn borrow(&self) -> &Provider { return self; }
    fn begin(&self, offset: i32, count: i32, position: u64)
        -> core::result::Result<i32, core::io::Error> {
        // Any invalid helper call should fail the fixture before array access.
        assert(offset >= 0 && count >= 0 && offset <= 32 - count);
        assert(self.calls < 16);
        let event: i64 = 0;
        if (self.calls < self.length) { event = self.script[self.calls]; }
        self.offsets[self.calls] = offset as i64;
        self.counts[self.calls] = count as i64;
        self.positions[self.calls] = position;
        self.events[self.calls] = event;
        self.calls += 1;
        return response(event, count);
    }
}

pub impl core::io::ReadAt for Provider {
    pub fn read_at(&self, destination: [u8], offset: i32, count: i32, position: u64)
        -> core::result::Result<i32, core::io::Error> {
        let result: core::result::Result<i32, core::io::Error> = self.begin(offset, count, position);
        if (result.is_ok()) {
            let amount: i32 = result.unwrap();
            // Malformed count controls intentionally publish no bytes.
            if (amount > 0 && amount <= count) {
                let index: i32 = 0;
                while (index < amount) {
                    destination[offset + index] = byte_at(position + (index as u64));
                    index += 1;
                }
            }
        }
        return result;
    }
}

pub impl core::io::WriteAt for Provider {
    pub fn write_at(&self, source: [u8], offset: i32, count: i32, position: u64)
        -> core::result::Result<i32, core::io::Error> {
        let result: core::result::Result<i32, core::io::Error> = self.begin(offset, count, position);
        if (result.is_ok()) {
            let amount: i32 = result.unwrap();
            if (amount > 0 && amount <= count) {
                assert(self.sent <= 256 - amount);
                let index: i32 = 0;
                while (index < amount) {
                    self.sink[self.sent + index] = source[offset + index];
                    index += 1;
                }
                self.sent += amount;
            }
        }
        return result;
    }
}

fn error_code(error: core::io::Error) -> i32 {
    return match (error) {
        core::io::Error::InvalidInput -> 1,
        core::io::Error::UnexpectedEof -> 2,
        core::io::Error::WriteZero -> 3,
        core::io::Error::InvalidCount -> 4,
        core::io::Error::CountOverflow -> 5,
        core::io::Error::LimitExceeded -> 6,
        core::io::Error::Interrupted -> 7,
        core::io::Error::WouldBlock -> 8,
        core::io::Error::AllocationFailed -> 9,
        core::io::Error::Host(code) -> 10,
    };
}

fn host_code(error: core::io::Error) -> i32 {
    return match (error) { core::io::Error::Host(code) -> code, _ -> 0 };
}

fn run(bytes: [u8], output: &Output) {
    let operation: u64 = get64(bytes, 0);
    let layout: u64 = get64(bytes, 8);
    let offset: i32 = get64(bytes, 16) as i32;
    let count: i32 = get64(bytes, 24) as i32;
    let position: u64 = get64(bytes, 32);
    let budget: i32 = get64(bytes, 40) as i32;
    let length: i32 = get64(bytes, 48) as i32;
    let identity: u64 = get64(bytes, 56);
    let script: [i64; 8] = [0; 8];
    let offsets: [i64; 16] = [0; 16];
    let counts: [i64; 16] = [0; 16];
    let positions: [u64; 16] = [0; 16];
    let events: [i64; 16] = [0; 16];
    let sink: [u8; 256] = [0; 256];
    let index: i32 = 0;
    while (index < length) { script[index] = get64(bytes, 64 + index * 8) as i64; index += 1; }
    let provider: Provider = Provider {
        script: script, length: length, calls: 0,
        offsets: offsets, counts: counts, positions: positions, events: events,
        sink: sink, sent: 0
    };
    let native: [u8; 32] = [0; 32];
    let packed_words: [i32; 8] = [0; 8];
    let packed: [u8] = core::mem::typed_slice_from_raw_parts<u8>(
        core::mem::i32_array_data_ptr(packed_words), 32);
    let buffer: [u8] = native;
    if (layout == 1) { buffer = packed; }
    if (layout == 0) { assert(core::mem::slice_stride(buffer) < 0); }
    else { assert(core::mem::slice_stride(buffer) == 1); }
    index = 0;
    while (index < 32) {
        buffer[index] = (160 + index) as u8;
        if (operation == 1) { buffer[index] = ((identity * 13 + (index as u64) * 17) & 255) as u8; }
        index += 1;
    }
    let result: core::result::Result<i32, core::io::Failure> = core::result::Ok(0);
    if (operation == 0) {
        result = core::io::read_exact_at<Provider>(provider.borrow(), buffer, offset, count, position, budget);
    } else {
        result = core::io::write_all_at<Provider>(provider.borrow(), buffer, offset, count, position, budget);
    }
    let tag: u64 = 0;
    let code: i32 = 0;
    let host: i32 = 0;
    let completed: i32 = 0;
    if (result.is_ok()) { completed = result.unwrap(); }
    else {
        let failure: core::io::Failure = result.unwrap_err();
        tag = 1;
        code = error_code(failure.cause);
        host = host_code(failure.cause);
        completed = failure.completed;
    }
    output.word(operation);
    output.word(layout);
    output.word(tag);
    output.word(code as u64);
    output.word(host as i64 as u64);
    output.word(completed as i64 as u64);
    output.word(provider.calls as u64);
    output.word(provider.sent as u64);
    output.word(core::io::valid_range(offset, count) as u64);
    output.word(core::io::valid_position(position, count) as u64);
    index = 0;
    while (index < 32) { output.word(buffer[index] as u64); index += 1; }
    index = 0;
    while (index < provider.sent) { output.word(sink[index] as u64); index += 1; }
    index = 0;
    while (index < provider.calls) {
        output.word(offsets[index] as u64);
        output.word(counts[index] as u64);
        output.word(positions[index]);
        output.word(events[index] as u64);
        index += 1;
    }
}

fn main() -> i32 {
    let input_words: [i32; 32] = [0; 32];
    let input_pointer: ptr = core::mem::i32_array_data_ptr(input_words);
    let input: [u8] = core::mem::typed_slice_from_raw_parts<u8>(input_pointer, 128);
    let output_words: [i32; 1024] = [0; 1024];
    let output_pointer: ptr = core::mem::i32_array_data_ptr(output_words);
    let output_bytes: [u8] = core::mem::typed_slice_from_raw_parts<u8>(output_pointer, 4096);
    let output: Output = Output { bytes: output_bytes, pointer: output_pointer, used: 0 };
    while (read_exact(input_pointer, 64, true)) {
        assert(get64(input, 0) <= 1 && get64(input, 8) <= 1 && get64(input, 48) <= 8);
        assert(read_exact(input_pointer + 64, (get64(input, 48) * 8) as i32, false));
        run(input, output.borrow());
    }
    output.flush();
    return 0;
}
