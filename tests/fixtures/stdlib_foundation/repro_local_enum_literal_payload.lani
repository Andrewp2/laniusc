enum Packet<T> { Data(T), Missing }
fn main() -> i32 {
    let packet: Packet<[i32; 2]> = Data([40, 2]);
    let fallback: [i32; 2] = [0, 0];
    let values: [i32; 2] = match (packet) { Data(value) -> value, Missing -> fallback };
    if (values[0] != 40 || values[1] != 2) { return 1; }
    return 0;
}
