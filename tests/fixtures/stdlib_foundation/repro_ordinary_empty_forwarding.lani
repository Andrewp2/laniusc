module app::main;
import core::mem;
struct Empty {}
fn copy_empty(value: Empty) -> Empty { return value; }
fn copy_array(value: [i32; 0]) -> [i32; 0] { return value; }
fn main() -> i32 {
    let seed: Empty = Empty {};
    let copied: Empty = copy_empty(seed);
    let nothing: [i32; 0] = [];
    let array: [i32; 0] = copy_array(nothing);
    if (check_empty(copied, -7) != -7 || check_array(array, 42) != 42) { return 1; }
    return 0;
}
fn check_empty(value: Empty, sentinel: i32) -> i32 { return sentinel; }
fn check_array(value: [i32; 0], sentinel: i32) -> i32 { return sentinel; }
