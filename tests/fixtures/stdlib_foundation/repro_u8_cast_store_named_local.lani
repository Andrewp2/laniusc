module app::main;

fn write_two(output: [u8], first: i32, second: i32) -> i32 {
    let index: i32 = 0;
    let first_byte: u8 = first as u8;
    output[index] = first_byte;
    index += 1;
    if (second > 0) {
        let second_byte: u8 = second as u8;
        output[index] = second_byte;
        index += 1;
    }
    return index;
}

fn main() -> i32 {
    let zero: u8 = 0;
    let expected_first: u8 = 102;
    let expected_second: u8 = 111;
    let output: [u8; 2] = [zero, zero];
    if (write_two(output, 102, 111) != 2) { return 2; }
    if (output[0] != expected_first || output[1] != expected_second) { return 1; }
    return 0;
}
