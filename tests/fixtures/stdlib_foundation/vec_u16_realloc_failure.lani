module app::main;
import std::vec_u16;

fn main() -> i32 {
    let value: std::vec_u16::VecU16 = std::vec_u16::try_with_capacity(1);
    if (std::vec_u16::capacity(value) != 1) { return 2; }
    value = std::vec_u16::try_push(value, 65535);
    if (std::vec_u16::len(value) != 1) { return 3; }
    value = std::vec_u16::try_push(value, 32768);
    if (std::vec_u16::len(value) != 1 || std::vec_u16::capacity(value) != 1) { return 4; }
    if (std::vec_u16::get_or(value, 0, 0) != 65535) { return 5; }
    std::vec_u16::destroy(value);
    return 0;
}
