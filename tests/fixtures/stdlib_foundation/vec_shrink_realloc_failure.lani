module app::main;
import std::vec_i32;

fn main() -> i32 {
    let value: std::vec_i32::VecI32 = std::vec_i32::try_with_capacity(5);
    if (std::vec_i32::capacity(value) != 5) { return 2; }
    value = std::vec_i32::try_push(value, 41);
    value = std::vec_i32::try_push(value, 42);
    if (std::vec_i32::len(value) != 2) { return 3; }
    value = std::vec_i32::try_shrink_to_fit(value);
    if (std::vec_i32::len(value) == 2 && std::vec_i32::capacity(value) == 5 &&
        std::vec_i32::get_or(value, 0, -1) == 41 &&
        std::vec_i32::get_or(value, 1, -1) == 42) {
        std::vec_i32::destroy(value);
        return 0;
    }
    if (std::vec_i32::len(value) == 2 && std::vec_i32::capacity(value) == 2 &&
        std::vec_i32::get_or(value, 0, -1) == 41 &&
        std::vec_i32::get_or(value, 1, -1) == 42) {
        std::vec_i32::destroy(value);
        return 4;
    }
    std::vec_i32::destroy(value);
    return 5;
}
