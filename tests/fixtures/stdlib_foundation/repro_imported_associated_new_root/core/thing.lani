module core::thing;

pub struct Thing { value: i32 }

impl Thing {
    pub fn new() -> Thing {
        return Thing { value: 7 };
    }
    pub fn get(&self) -> i32 {
        return self.value;
    }
}

pub fn make() -> Thing {
    return Thing { value: 7 };
}

pub fn read(value: Thing) -> i32 {
    return value.value;
}
