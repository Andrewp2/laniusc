module app::main;
import std::set;

fn main() -> i32 {
    let value: std::set::Set<i32> = std::set::try_reserve(std::set::new(), 1);
    if (std::set::capacity(value) != 1) { return 2; }
    value = std::set::try_insert(value, -7);
    if (std::set::len(value) != 1) { return 3; }
    value = std::set::try_insert(value, 42);
    if (std::set::len(value) == 1 &&
        std::set::capacity(value) == 1 &&
        std::set::at_or(value, 0, 0) == -7 &&
        !std::set::contains(value, 42)) {
        std::set::destroy(value);
        return 0;
    }
    if (std::set::len(value) == 2 &&
        std::set::capacity(value) == 2 &&
        std::set::at_or(value, 0, 0) == -7 &&
        std::set::at_or(value, 1, 0) == 42) {
        std::set::destroy(value);
        return 4;
    }
    std::set::destroy(value);
    return 5;
}
