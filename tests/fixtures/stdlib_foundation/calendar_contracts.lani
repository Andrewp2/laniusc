module app::main;
import core::calendar;
import core::result;
import core::slice;
import core::time;

fn untouched(bytes: [u8], count: i32) { let i: i32 = 0;while (i < count) { assert(bytes[i] == 63);i += 1; } }

fn main() -> i32 {
    let epoch: core::calendar::Date = core::result::unwrap(core::calendar::date(1970,1,1));
    assert(epoch.day_number() == 0 && epoch.weekday() == 4 && epoch.ordinal() == 1);
    let leap: core::calendar::Date = core::result::unwrap(core::calendar::date(2000,2,29));
    assert(core::calendar::is_leap_year(0) && core::calendar::is_leap_year(-400));
    assert(!core::calendar::is_leap_year(1900) && core::calendar::is_leap_year(2000));
    assert(leap.ordinal() == 60 && core::result::is_err(core::calendar::date(1900,2,29)));
    assert(core::result::is_err(core::calendar::date(1,0,1)) && core::result::is_err(core::calendar::date(1,13,1)));
    assert(core::result::is_err(core::calendar::date(1,1,0)) && core::result::is_err(core::calendar::date(1,4,31)));
    assert(core::result::is_err(core::calendar::date_from_ordinal(1900,366)));
    assert(core::result::is_err(core::calendar::date_from_ordinal(2000,0)));
    assert(core::result::unwrap(core::calendar::date_from_ordinal(2000,60)).compare(leap) == 0);
    assert(core::result::is_err(leap.checked_add_years(1)));
    assert(core::result::unwrap(leap.checked_add_years(400)).year == 2400);
    assert(core::result::is_err(core::result::unwrap(core::calendar::date(2023,1,31)).checked_add_months(1)));
    assert(core::result::unwrap(epoch.checked_add_months(-1)).year == 1969);
    assert(core::result::unwrap(epoch.checked_add_months(-1)).month == 12);
    let minimum: core::calendar::Date = core::calendar::minimum_date();let maximum: core::calendar::Date = core::calendar::maximum_date();
    assert(core::result::is_err(minimum.checked_add_days(-1)) && core::result::is_err(maximum.checked_add_days(1)));
    assert(core::result::is_err(minimum.checked_sub_days(1)) && core::result::is_err(maximum.checked_sub_days(-1)));
    assert(core::result::is_err(epoch.checked_add_days(9223372036854775807)));
    assert(core::result::is_err(epoch.checked_sub_days(-9223372036854775808)));
    assert(core::result::is_err(epoch.checked_add_months(-9223372036854775808)));
    assert(core::result::is_err(epoch.checked_add_years(9223372036854775807)));
    assert(core::result::is_err(minimum.checked_add_months(-1)) && core::result::is_err(maximum.checked_add_months(1)));
    assert(core::result::is_err(core::calendar::date_from_day_number(-9223372036854775808)));
    assert(core::result::is_err(core::calendar::date_from_day_number(9223372036854775807)));
    assert(core::result::is_err(core::calendar::date_from_iso_week(2021,53,1)));
    assert(core::result::is_err(core::calendar::date_from_iso_week(2020,1,0)));
    assert(core::result::is_err(core::calendar::date_from_iso_week(9223372036854775807,1,1)));
    let i: core::calendar::IsoWeek = core::result::unwrap(core::calendar::date(2021,1,1)).iso_week();
    assert(i.year == 2020 && i.week == 53 && i.weekday == 5);
    assert(core::result::unwrap(core::calendar::date_from_iso_week(i.year,i.week,i.weekday)).day == 1);
    assert(core::result::is_err(core::calendar::time_of_day(24,0,0,0)));
    assert(core::result::is_err(core::calendar::time_of_day(-1,0,0,0)));
    assert(core::result::is_err(core::calendar::time_of_day(0,60,0,0)));
    assert(core::result::is_err(core::calendar::time_of_day(0,0,61,0)));
    assert(core::result::is_err(core::calendar::time_of_day(0,0,0,1000000000)));
    assert(core::result::is_err(core::calendar::utc_offset(1440)) && core::result::is_err(core::calendar::utc_offset(-1440)));
    let stamp: core::time::SystemTime = core::result::unwrap(core::time::system_time(-1,999999999));
    let value: core::calendar::OffsetDateTime = core::result::unwrap(core::calendar::from_system_time(stamp,core::calendar::utc()));
    assert(value.local.date.year == 1969 && value.local.date.month == 12 && value.local.date.day == 31);
    assert(value.local.time.hour == 23 && value.local.time.minute == 59 && value.local.time.second == 59);
    assert(core::result::unwrap(value.to_system_time()).compare(stamp) == 0);
    let east: core::calendar::OffsetDateTime = core::result::unwrap(value.to_offset(core::result::unwrap(core::calendar::utc_offset(60))));
    assert(east.local.date.year == 1970 && east.local.date.month == 1 && east.local.date.day == 1 && east.local.time.hour == 0);
    assert(core::result::unwrap(core::calendar::to_system_time(east)).compare(stamp) == 0);
    assert(core::result::is_err(core::calendar::from_system_time(stamp,core::calendar::unknown_offset())));
    assert(core::result::is_err(core::calendar::from_system_time(core::result::unwrap(core::time::system_time(9223372036854775807,0)),core::result::unwrap(core::calendar::utc_offset(1)))));
    assert(core::result::is_err(core::calendar::from_system_time(core::result::unwrap(core::time::system_time(-9223372036854775808,0)),core::result::unwrap(core::calendar::utc_offset(-1)))));
    assert(core::result::is_err(core::calendar::from_system_time(core::result::unwrap(core::time::system_time(9223372036854775807,0)),core::calendar::utc())));
    let text: [u8;35] = [50,48,50,48,45,48,50,45,50,57,116,50,51,58,53,57,58,54,48,46,49,50,51,52,53,54,55,56,57,45,48,48,58,48,48];
    let parsed: core::calendar::ParsedDateTime = core::result::unwrap(core::calendar::parse_rfc3339(core::result::unwrap(core::slice::view(text,35))));
    assert(parsed.fraction_digits == 9 && parsed.value.local.time.nanos == 123456789);
    assert(parsed.value.local.time.is_leap_second() && !parsed.value.offset.known);
    assert(core::result::is_err(parsed.value.to_system_time()));
    let output: [u8;40] = [63;40];let out: core::slice::View<u8> = core::result::unwrap(core::slice::view_range(output,2,35));
    assert(core::result::unwrap(core::calendar::measure_rfc3339(parsed.value,9)) == 35);
    assert(core::result::unwrap(core::calendar::format_rfc3339(parsed.value,9,out)) == 35);
    assert(output[0] == 63 && output[1] == 63 && output[37] == 63 && output[10+2] == 84);
    assert(core::result::is_err(core::calendar::format_rfc3339(parsed.value,8,out)));
    assert(output[2] == 50 && output[36] == 48);
    let padded: [u8;42] = [63;42];let p: i32 = 0;
    while (p < 35) { padded[p+5] = text[p];p += 1; }
    let input: core::slice::View<u8> = core::result::unwrap(core::slice::view_range(padded,5,35));
    assert(core::result::unwrap(core::calendar::parse_rfc3339(input)).value.local.time.nanos == 123456789);
    let prefix: i32 = 0;while (prefix < 35) { assert(core::result::is_err(core::calendar::parse_rfc3339(core::result::unwrap(input.subview(0,prefix)))));prefix += 1; }
    let all: core::slice::View<u8> = core::result::unwrap(core::slice::view(output,40));all.fill(63);
    let width: i32 = 0;
    while (width < 35) { assert(core::result::is_err(core::calendar::format_rfc3339(parsed.value,9,core::result::unwrap(all.subview(1,width+1)))));untouched(output,40);width += 1; }
    assert(core::result::is_err(core::calendar::format_rfc3339(parsed.value,8,all)));untouched(output,40);
    assert(core::result::is_err(core::calendar::format_rfc3339(parsed.value,-1,all)));untouched(output,40);
    assert(core::result::is_err(core::calendar::format_rfc3339(parsed.value,10,all)));untouched(output,40);
    let ordinary: core::calendar::TimeOfDay = core::result::unwrap(core::calendar::time_of_day(0,0,0,0));
    let local: core::calendar::LocalDateTime = core::result::unwrap(core::calendar::local_date_time(epoch,ordinary));
    let unknown: core::calendar::OffsetDateTime = core::result::unwrap(core::calendar::offset_date_time(local,core::calendar::unknown_offset()));
    let unknown_code: i32 = match (core::result::unwrap_err(unknown.to_system_time())) { core::calendar::Error::UnknownOffset -> 1,_ -> 0 };assert(unknown_code == 1);
    let leap_time: core::calendar::TimeOfDay = core::result::unwrap(core::calendar::time_of_day(23,59,60,0));
    let leap_local: core::calendar::LocalDateTime = core::result::unwrap(core::calendar::local_date_time(epoch,leap_time));
    let leap_value: core::calendar::OffsetDateTime = core::result::unwrap(core::calendar::offset_date_time(leap_local,core::calendar::utc()));
    let leap_code: i32 = match (core::result::unwrap_err(leap_value.to_system_time())) { core::calendar::Error::LeapSecond -> 1,_ -> 0 };assert(leap_code == 1);
    let wide: core::calendar::LocalDateTime = core::result::unwrap(core::calendar::local_date_time(minimum,ordinary));
    let wide_value: core::calendar::OffsetDateTime = core::result::unwrap(core::calendar::offset_date_time(wide,core::calendar::utc()));
    assert(core::result::is_err(core::calendar::format_rfc3339(wide_value,0,all)));untouched(output,40);
    let bad_offset: core::calendar::UtcOffset = core::calendar::UtcOffset { minutes: 60, known: false };
    let bad: core::calendar::OffsetDateTime = core::calendar::OffsetDateTime { local: local, offset: bad_offset };
    assert(core::result::is_err(core::calendar::offset_date_time(local,bad_offset)));
    assert(core::result::is_err(core::calendar::format_rfc3339(bad,0,all)));untouched(output,40);
    let bad_day: core::calendar::Date = core::calendar::Date { year: 2023, month: 2, day: 29 };
    let bad_local: core::calendar::LocalDateTime = core::calendar::LocalDateTime { date: bad_day, time: ordinary };
    let bad_value: core::calendar::OffsetDateTime = core::calendar::OffsetDateTime { local: bad_local, offset: core::calendar::utc() };
    assert(core::result::is_err(core::calendar::format_rfc3339(bad_value,0,all)));untouched(output,40);
    assert(core::result::is_err(core::calendar::to_system_time(bad_value)));
    let utc_value: core::calendar::OffsetDateTime = core::result::unwrap(core::calendar::offset_date_time(local,core::calendar::utc()));
    assert(core::result::is_err(core::calendar::format_rfc3339(utc_value,0,core::result::unwrap(all.subview(0,19)))));untouched(output,40);
    assert(core::result::unwrap(core::calendar::format_rfc3339(utc_value,0,all)) == 20);
    assert(output[19] == 90 && output[20] == 63);
    let utc_back: core::calendar::ParsedDateTime = core::result::unwrap(core::calendar::parse_rfc3339(core::result::unwrap(all.subview(0,20))));
    assert(utc_back.fraction_digits == 0 && utc_back.value.offset.known && utc_back.value.offset.minutes == 0);
    return 0;
}
