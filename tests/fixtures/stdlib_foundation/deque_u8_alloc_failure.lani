module app::main;
import std::deque_u8;

fn main() -> i32 {
    let value: std::deque_u8::DequeU8 = std::deque_u8::try_with_capacity(3);
    let failure: bool = std::deque_u8::capacity(value) == 0 && std::deque_u8::len(value) == 0;
    let success: bool = std::deque_u8::capacity(value) == 3 && std::deque_u8::len(value) == 0;
    std::deque_u8::destroy(value);
    if (failure) { return 0; }
    if (success) { return 4; }
    return 5;
}
