module app::main;
import core::slice_i8;

fn main() -> i32 {
    let zero: i8 = 0;
    let one: i8 = 1;
    let two: i8 = 2;
    let three: i8 = 3;
    let four: i8 = 4;
    let five: i8 = 5;
    let nine: i8 = 9;
    let upper_half: i8 = 64;
    let high: i8 = 127;
    let almost: i8 = 120;

    let a: [i8; 5] = [three, one, two, one, high];
    if (core::slice_i8::first(a) != three ||
        core::slice_i8::first_or(a, 0, nine) != nine ||
        core::slice_i8::first_or(a, 5, nine) != three ||
        core::slice_i8::swap(a, 5, -1, 0) ||
        core::slice_i8::swap(a, 5, 0, 5) ||
        a[0] != three || !core::slice_i8::swap(a, 5, 0, 4) ||
        a[0] != high || a[4] != three) { return 1; }

    let rotated: [i8; 5] = [one, two, three, four, five];
    if (core::slice_i8::rotate_left(rotated, 5, -1) ||
        core::slice_i8::rotate_right(rotated, 5, 6) ||
        rotated[0] != one ||
        !core::slice_i8::rotate_left(rotated, 5, 2) ||
        rotated[0] != three || rotated[1] != four || rotated[4] != two ||
        !core::slice_i8::rotate_right(rotated, 5, 2) ||
        rotated[0] != one || rotated[4] != five ||
        !core::slice_i8::rotate_left(rotated, 0, 0)) { return 2; }

    let destination: [i8; 5] = [zero, zero, zero, zero, nine];
    let source: [i8; 3] = [one, high, three];
    if (core::slice_i8::copy_nonoverlapping_prefix(destination, 2, source, 3) ||
        core::slice_i8::copy_nonoverlapping_prefix(destination, -1, source, 0) ||
        destination[0] != zero || destination[4] != nine ||
        !core::slice_i8::copy_nonoverlapping_prefix(destination, 5, source, 3) ||
        destination[0] != one || destination[1] != high ||
        destination[2] != three || destination[4] != nine) { return 3; }

    let compact: [i8; 7] = [one, one, high, high, two, two, one];
    if (core::slice_i8::dedup_adjacent(compact, -1) != 0 ||
        core::slice_i8::dedup_adjacent(compact, 7) != 4 ||
        compact[0] != one || compact[1] != high ||
        compact[2] != two || compact[3] != one ||
        core::slice_i8::retain_not_equal(compact, 4, high) != 3 ||
        compact[0] != one || compact[1] != two || compact[2] != one ||
        !core::slice_i8::remove_at(compact, 3, 1) ||
        compact[0] != one || compact[1] != one ||
        core::slice_i8::remove_at(compact, 2, 2)) { return 4; }

    let insertion: [i8; 5] = [one, three, five, zero, nine];
    if (core::slice_i8::insert(insertion, 3, 3, 1, two) ||
        core::slice_i8::insert(insertion, -1, 5, 0, two) ||
        core::slice_i8::push(insertion, 5, 5, two) ||
        insertion[1] != three ||
        !core::slice_i8::insert(insertion, 3, 5, 1, two) ||
        insertion[0] != one || insertion[1] != two ||
        insertion[2] != three || insertion[3] != five ||
        !core::slice_i8::push(insertion, 4, 5, high) ||
        insertion[4] != high) { return 5; }

    let same: [i8; 3] = [one, two, three];
    let greater: [i8; 3] = [one, high, zero];
    let prefix: [i8; 2] = [one, two];
    if (core::slice_i8::compare_lexicographic(same, 3, same, 3) != 0 ||
        core::slice_i8::compare_lexicographic(same, 3, greater, 3) != -1 ||
        core::slice_i8::compare_lexicographic(greater, 3, same, 3) != 1 ||
        core::slice_i8::compare_lexicographic(prefix, 2, same, 3) != -1 ||
        core::slice_i8::compare_lexicographic(same, -1, same, 3) != -2) { return 6; }

    let sequence: [i8; 6] = [one, two, one, two, three, high];
    let needle: [i8; 2] = [one, two];
    let missing: [i8; 2] = [high, one];
    if (core::slice_i8::index_of_subslice(sequence, 6, needle, 2) != 0 ||
        core::slice_i8::last_index_of_subslice(sequence, 6, needle, 2) != 2 ||
        core::slice_i8::index_of_subslice(sequence, 6, missing, 2) != -1 ||
        core::slice_i8::last_index_of_subslice(sequence, 6, missing, 2) != -1 ||
        core::slice_i8::index_of_subslice(sequence, 6, needle, 0) != 0 ||
        core::slice_i8::last_index_of_subslice(sequence, 6, needle, 0) != 6 ||
        core::slice_i8::index_of_subslice(sequence, -1, needle, 0) != -1 ||
        core::slice_i8::last_index_of_subslice(sequence, 6, needle, -1) != -1) { return 7; }

    if (!core::slice_i8::contains(sequence, 6, high) ||
        core::slice_i8::contains(sequence, 6, nine) ||
        core::slice_i8::count(sequence, 6, one) != 2 ||
        core::slice_i8::count(sequence, -1, one) != 0 ||
        core::slice_i8::min_or(sequence, 6, nine) != one ||
        core::slice_i8::max_or(sequence, 6, nine) != high ||
        core::slice_i8::min_or(sequence, 0, nine) != nine ||
        core::slice_i8::max_or(sequence, -1, nine) != nine ||
        core::slice_i8::is_sorted(sequence, 6) ||
        !core::slice_i8::is_sorted(sequence, 0)) { return 8; }

    let sortable: [i8; 7] = [high, two, one, two, zero, high, three];
    if (core::slice_i8::sort(sortable, -1) != 0 ||
        core::slice_i8::sort(sortable, 7) != 7 ||
        !core::slice_i8::is_sorted(sortable, 7) ||
        sortable[0] != zero || sortable[1] != one ||
        sortable[2] != two || sortable[3] != two ||
        sortable[4] != three || sortable[5] != high ||
        sortable[6] != high) { return 9; }
    if (core::slice_i8::lower_bound(sortable, 7, two) != 2 ||
        core::slice_i8::upper_bound(sortable, 7, two) != 4 ||
        core::slice_i8::lower_bound(sortable, 7, high) != 5 ||
        core::slice_i8::upper_bound(sortable, 7, high) != 7 ||
        core::slice_i8::binary_search_first_or(sortable, 7, two, -9) != 2 ||
        core::slice_i8::binary_search_last_or(sortable, 7, two, -9) != 3 ||
        core::slice_i8::binary_search_first_or(sortable, 7, nine, -9) != -9 ||
        core::slice_i8::binary_search_last_or(sortable, 0, two, -9) != -9) { return 10; }

    let partition: [i8; 5] = [high, one, two, zero, three];
    let boundary: i32 = core::slice_i8::partition_lt(partition, 5, three);
    if (boundary != 3 || partition[0] >= three || partition[1] >= three ||
        partition[2] >= three || partition[3] < three || partition[4] < three ||
        core::slice_i8::partition_lt(partition, -1, three) != 0) { return 11; }
    let small_sum: [i8; 2] = [three, nine];
    let large_sum: [i8; 2] = [almost, nine];
    if (core::slice_i8::sum(small_sum, 2) != 12 ||
        core::slice_i8::sum(large_sum, 2) != high ||
        core::slice_i8::sum(large_sum, -1) != zero) { return 12; }
    let positive_order: [i8; 3] = [high, upper_half, zero];
    if (core::slice_i8::sort(positive_order, 3) != 3 ||
        positive_order[0] != zero || positive_order[1] != upper_half ||
        positive_order[2] != high ||
        core::slice_i8::lower_bound(positive_order, 3, upper_half) != 1 ||
        core::slice_i8::upper_bound(positive_order, 3, upper_half) != 2) { return 13; }
    let minimum: i8 = -128;
    let negative: i8 = -1;
    let signed_order: [i8; 5] = [high, negative, zero, minimum, negative];
    if (core::slice_i8::sort(signed_order, 5) != 5 ||
        signed_order[0] != minimum || signed_order[1] != negative ||
        signed_order[2] != negative || signed_order[3] != zero ||
        signed_order[4] != high ||
        core::slice_i8::lower_bound(signed_order, 5, negative) != 1 ||
        core::slice_i8::upper_bound(signed_order, 5, negative) != 3 ||
        core::slice_i8::binary_search_first_or(signed_order, 5, negative, -9) != 1 ||
        core::slice_i8::binary_search_last_or(signed_order, 5, negative, -9) != 2) { return 14; }
    let low_sum: [i8; 2] = [minimum, negative];
    let recovering_sum: [i8; 3] = [high, one, negative];
    let negative_sum: [i8; 2] = [negative, negative];
    if (core::slice_i8::sum(low_sum, 2) != minimum ||
        core::slice_i8::sum(recovering_sum, 3) != 126 ||
        core::slice_i8::sum(negative_sum, 2) != -2) { return 15; }
    let signed_partition: [i8; 4] = [one, minimum, zero, negative];
    let boundary_signed: i32 = core::slice_i8::partition_lt(signed_partition, 4, zero);
    let less: [i8; 1] = [negative];
    let zero_only: [i8; 1] = [zero];
    if (boundary_signed != 2 || signed_partition[0] >= zero ||
        signed_partition[1] >= zero || signed_partition[2] < zero ||
        signed_partition[3] < zero ||
        core::slice_i8::compare_lexicographic(less, 1, zero_only, 1) != -1) { return 16; }
    return 0;
}
