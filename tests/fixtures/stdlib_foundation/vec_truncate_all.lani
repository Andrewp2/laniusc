fn check_bool() -> i32 {
    let first: bool = false;
    let second: bool = true;
    let third: bool = false;
    let again: bool = true;
    let fallback: bool = false;
    let value: std::vec_bool::VecBool = std::vec_bool::new();
    value = std::vec_bool::try_push(value, first);
    value = std::vec_bool::try_push(value, second);
    value = std::vec_bool::try_push(value, third);
    let held_capacity: i32 = std::vec_bool::capacity(value);
    if (std::vec_bool::len(value) != 3 || held_capacity < 3) { return 1; }
    value = std::vec_bool::truncate(value, -1);
    value = std::vec_bool::truncate(value, 4);
    if (std::vec_bool::len(value) != 3 || std::vec_bool::capacity(value) != held_capacity ||
        std::vec_bool::get_or(value, 2, fallback) != third) { return 2; }
    value = std::vec_bool::truncate(value, 2);
    if (std::vec_bool::len(value) != 2 || std::vec_bool::capacity(value) != held_capacity ||
        std::vec_bool::get_or(value, 0, fallback) != first ||
        std::vec_bool::get_or(value, 1, fallback) != second) { return 3; }
    value = std::vec_bool::try_push(value, again);
    if (std::vec_bool::len(value) != 3 || std::vec_bool::get_or(value, 2, fallback) != again) { return 4; }
    value = std::vec_bool::truncate(value, 0);
    if (!std::vec_bool::is_empty(value) || std::vec_bool::capacity(value) != held_capacity ||
        std::vec_bool::get_or(value, 0, fallback) != fallback) { return 5; }
    value = std::vec_bool::try_push(value, first);
    if (std::vec_bool::len(value) != 1 || std::vec_bool::get_or(value, 0, fallback) != first) { return 6; }
    std::vec_bool::destroy(value);
    return 0;
}

fn main() -> i32 {
    if (check_i32() != 0) { return 1; }
    if (check_u32() != 0) { return 2; }
    if (check_u8() != 0) { return 3; }
    if (check_i8() != 0) { return 4; }
    if (check_u16() != 0) { return 5; }
    if (check_i16() != 0) { return 6; }
    if (check_bool() != 0) { return 7; }
    return 0;
}
