    if (std::vec_u32::len(value) != 3 || std::vec_u32::capacity(value) != held_capacity ||
        std::vec_u32::get_or(value, 2, fallback) != third) { return 2; }
    value = std::vec_u32::truncate(value, 2);
    if (std::vec_u32::len(value) != 2 || std::vec_u32::capacity(value) != held_capacity ||
        std::vec_u32::get_or(value, 0, fallback) != first ||
        std::vec_u32::get_or(value, 1, fallback) != second) { return 3; }
    value = std::vec_u32::try_push(value, again);
    if (std::vec_u32::len(value) != 3 || std::vec_u32::get_or(value, 2, fallback) != again) { return 4; }
    value = std::vec_u32::truncate(value, 0);
    if (!std::vec_u32::is_empty(value) || std::vec_u32::capacity(value) != held_capacity ||
        std::vec_u32::get_or(value, 0, fallback) != fallback) { return 5; }
    value = std::vec_u32::try_push(value, first);
    if (std::vec_u32::len(value) != 1 || std::vec_u32::get_or(value, 0, fallback) != first) { return 6; }
    std::vec_u32::destroy(value);
    return 0;
}

