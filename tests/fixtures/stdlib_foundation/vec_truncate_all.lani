module app::main;
import std::vec_i32;
import std::vec_u32;
import std::vec_u8;
import std::vec_i8;
import std::vec_u16;
import std::vec_i16;
import std::vec_bool;

fn check_i32() -> i32 {
    let first: i32 = 7;
    let second: i32 = -2;
    let third: i32 = 9;
    let again: i32 = 44;
    let fallback: i32 = 123;
    let value: std::vec_i32::VecI32 = std::vec_i32::new();
    value = std::vec_i32::try_push(value, first);
    value = std::vec_i32::try_push(value, second);
    value = std::vec_i32::try_push(value, third);
    let held_capacity: i32 = std::vec_i32::capacity(value);
    if (std::vec_i32::len(value) != 3 || held_capacity < 3) { return 1; }
    value = std::vec_i32::truncate(value, -1);
    value = std::vec_i32::truncate(value, 4);
    if (std::vec_i32::len(value) != 3 || std::vec_i32::capacity(value) != held_capacity ||
        std::vec_i32::get_or(value, 2, fallback) != third) { return 2; }
    value = std::vec_i32::truncate(value, 2);
    if (std::vec_i32::len(value) != 2 || std::vec_i32::capacity(value) != held_capacity ||
        std::vec_i32::get_or(value, 0, fallback) != first ||
        std::vec_i32::get_or(value, 1, fallback) != second) { return 3; }
    value = std::vec_i32::try_push(value, again);
    if (std::vec_i32::len(value) != 3 || std::vec_i32::get_or(value, 2, fallback) != again) { return 4; }
    value = std::vec_i32::truncate(value, 0);
    if (!std::vec_i32::is_empty(value) || std::vec_i32::capacity(value) != held_capacity ||
        std::vec_i32::get_or(value, 0, fallback) != fallback) { return 5; }
    value = std::vec_i32::try_push(value, first);
    if (std::vec_i32::len(value) != 1 || std::vec_i32::get_or(value, 0, fallback) != first) { return 6; }
    std::vec_i32::destroy(value);
    return 0;
}

fn check_u32() -> i32 {
    let first: u32 = 7;
    let second: u32 = 2147483648;
    let third: u32 = 4294967295;
