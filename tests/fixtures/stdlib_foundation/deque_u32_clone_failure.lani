module app::main;
import std::deque_u32;

fn main() -> i32 {
    let value: std::deque_u32::DequeU32 = std::deque_u32::try_with_capacity(3);
    if (std::deque_u32::capacity(value) != 3) { return 5; }
    value = std::deque_u32::try_push_back(value, 7);
    value = std::deque_u32::try_push_back(value, 8);
    value = std::deque_u32::try_push_back(value, 9);
    value = std::deque_u32::try_pop_front(value);
    value = std::deque_u32::try_push_back(value, 10);
    let copy: std::deque_u32::DequeU32 = std::deque_u32::try_clone(value);
    let intact: bool = std::deque_u32::len(value) == 3 &&
        std::deque_u32::at_or(value, 0, 0) == 8 &&
        std::deque_u32::at_or(value, 1, 0) == 9 &&
        std::deque_u32::at_or(value, 2, 0) == 10;
    let failure: bool = intact && std::deque_u32::len(copy) == 0 &&
        std::deque_u32::capacity(copy) == 0;
    let success: bool = intact && std::deque_u32::len(copy) == 3 &&
        std::deque_u32::capacity(copy) == 3 &&
        std::deque_u32::at_or(copy, 0, 0) == 8 &&
        std::deque_u32::at_or(copy, 1, 0) == 9 &&
        std::deque_u32::at_or(copy, 2, 0) == 10;
    std::deque_u32::destroy(copy);
    std::deque_u32::destroy(value);
    if (failure) { return 0; }
    if (success) { return 4; }
    return 5;
}
