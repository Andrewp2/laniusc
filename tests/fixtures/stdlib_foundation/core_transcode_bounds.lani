module app::main;
import core::transcode;
fn main() -> i32 {
    let first: u8 = 194;
    let source: [u8; 1] = [first];
    let zero: u16 = 0;
    let output: [u16; 1] = [zero];
    let result: core::transcode::TranscodeResult =
        core::transcode::utf8_to_utf16(source, 2, output, 1);
    if (core::transcode::succeeded(result)) { return 1; }
    return 0;
}
