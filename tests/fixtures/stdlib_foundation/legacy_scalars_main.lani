// Concatenated after the legacy stdlib/bool.lani and stdlib/i32.lani sources.
fn main() -> i32 {
    let minimum: i32 = -2147483648;
    let maximum: i32 = 2147483647;
    if (lstd_bool_not(true) || !lstd_bool_not(false)) { return 1; }
    if (!lstd_bool_and(true, true) || lstd_bool_and(true, false)) { return 2; }
    if (!lstd_bool_or(false, true) || lstd_bool_or(false, false)) { return 3; }
    if (!lstd_bool_xor(true, false) || lstd_bool_xor(true, true)) { return 4; }
    if (!lstd_bool_eq(true, true) || lstd_bool_eq(true, false)) { return 5; }
    if (!lstd_bool_ne(true, false) || lstd_bool_ne(false, false)) { return 6; }
    if (lstd_bool_to_i32(true) != 1 || lstd_bool_to_i32(false) != 0) { return 7; }
    if (lstd_i32_to_bool(0) || !lstd_i32_to_bool(-3) || !lstd_i32_to_bool(3)) { return 8; }
    if (lstd_bool_select_i32(true, 7, 9) != 7 || lstd_bool_select_i32(false, 7, 9) != 9) { return 9; }

    if (lstd_i32_abs(-7) != 7 || lstd_i32_abs(0) != 0 || lstd_i32_abs(7) != 7) { return 10; }
    if (lstd_i32_saturating_abs(minimum) != maximum || lstd_i32_saturating_abs(-7) != 7) { return 11; }
    if (lstd_i32_min(-3, 7) != -3 || lstd_i32_max(-3, 7) != 7) { return 12; }
    if (lstd_i32_clamp(-2, 0, 4) != 0 || lstd_i32_clamp(2, 0, 4) != 2 || lstd_i32_clamp(7, 0, 4) != 4) { return 13; }
    if (lstd_i32_signum(-7) != -1 || lstd_i32_signum(0) != 0 || lstd_i32_signum(7) != 1) { return 14; }
    if (!lstd_i32_is_zero(0) || lstd_i32_is_zero(1)) { return 15; }
    if (!lstd_i32_is_negative(-1) || lstd_i32_is_negative(0) || lstd_i32_is_negative(1)) { return 16; }
    if (!lstd_i32_is_positive(1) || lstd_i32_is_positive(0) || lstd_i32_is_positive(-1)) { return 17; }
    if (!lstd_i32_between_inclusive(0, 0, 4) || !lstd_i32_between_inclusive(4, 0, 4) || lstd_i32_between_inclusive(5, 0, 4)) { return 18; }
    if (lstd_i32_compare_as_i32(-3, 7) != -1 || lstd_i32_compare_as_i32(7, 7) != 0 || lstd_i32_compare_as_i32(7, -3) != 1) { return 20; }
    if (lstd_i32_wrapping_add(2, 3) != 5 || lstd_i32_wrapping_add(maximum, 1) != minimum) { return 21; }
    if (lstd_i32_wrapping_sub(5, 2) != 3 || lstd_i32_wrapping_sub(minimum, 1) != maximum) { return 22; }
    if (lstd_i32_wrapping_mul(-7, 9) != -63 || lstd_i32_wrapping_mul(65536, 65536) != 0) { return 23; }
    if (!lstd_i32_is_power_of_two(1) || !lstd_i32_is_power_of_two(1073741824) || lstd_i32_is_power_of_two(0) || lstd_i32_is_power_of_two(maximum)) { return 24; }
    if (lstd_i32_next_power_of_two(-7) != 1 || lstd_i32_next_power_of_two(7) != 8 || lstd_i32_next_power_of_two(maximum) != 0) { return 25; }
    return 0;
}
