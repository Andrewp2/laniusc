// FIPS197 (2001) appendixC; ordinary imported results, no Error projection.
module app::main;
import core::aes;
import core::slice;
fn view(bytes: [u8], start: i32, length: i32) -> core::slice::View<u8> { return core::slice::View { values: bytes, start: start, length: length }; }
fn main() -> i32 {
    let key: [u8; 32] = [0; 32]; let index: i32 = 0;
    while (index < 32) { key[index] = index as u8; index += 1; }
    let input: [u8; 16] = [0,17,34,51,68,85,102,119,136,153,170,187,204,221,238,255];
    let expected: [u8; 16] = [142,162,183,202,81,103,69,191,234,252,73,144,75,73,96,137];
    let schedule: core::aes::Schedule = core::aes::new(view(key, 0, 32)).unwrap();
    let copied: core::aes::Schedule = schedule;
    index = 0; while (index < 32) { key[index] = 255; index += 1; }
    schedule = core::aes::new(view(key, 0, 16)).unwrap();
    let output: [u8; 20] = [165; 20];
    assert(copied.encrypt_into(view(input, 0, 16), view(output, 1, 18)).unwrap() == 16);
    index = 0; while (index < 16) { assert(output[index+1] == expected[index]); index += 1; }
    // Shift overlapping block one byte forwards, then back, with sentinels.
    assert(copied.decrypt_into(view(output, 1, 16), view(output, 2, 16)).unwrap() == 16);
    index = 0; while (index < 16) { assert(output[index+2] == input[index]); index += 1; }
    assert(copied.encrypt_into(view(output, 2, 16), view(output, 1, 16)).unwrap() == 16);
    index = 0; while (index < 16) { assert(output[index+1] == expected[index]); index += 1; }
    assert(output[0] == 165 && output[18] == 165 && output[19] == 165);
    return 0;
}
