module app::main;
import std::vec_char;

fn main() -> i32 {
    let high_code: u32 = 2147483648;
    let max_code: u32 = 4294967295;
    let high_bit: char = high_code;
    let maximum: char = max_code;
    let first: char = high_bit;
    let second: char = 1;
    let third: char = maximum;
    let fallback: char = 0;
    let additions: [char; 2] = [second, third];
    let value: std::vec_char::VecChar = std::vec_char::try_with_capacity(1);
    if (std::vec_char::capacity(value) != 1) { return 2; }
    value = std::vec_char::try_push(value, first);
    if (std::vec_char::len(value) != 1) { return 3; }
    value = std::vec_char::try_extend_from_slice(value, additions, 2);
    if (std::vec_char::len(value) == 3) {
        if (std::vec_char::get_or(value, 0, fallback) != first ||
            std::vec_char::get_or(value, 1, fallback) != second ||
            std::vec_char::get_or(value, 2, fallback) != third) { return 6; }
        std::vec_char::destroy(value);
        return 4;
    }
    if (std::vec_char::len(value) != 1 ||
        std::vec_char::capacity(value) != 1 ||
        std::vec_char::get_or(value, 0, fallback) != first) { return 5; }
    std::vec_char::destroy(value);
    return 0;
}
