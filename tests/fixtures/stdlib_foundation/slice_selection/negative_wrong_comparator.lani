module app::main;
import core::ordering;
import core::result;
import core::slice;
struct Wrong {}
impl Wrong { fn borrow(&self) -> &Wrong { return self; } }
pub impl core::ordering::Comparator<i32,u8> for Wrong {
    pub fn compare(&self,left:i32,right:u8) -> core::ordering::Ordering { return core::ordering::Ordering::Equal; }
}
fn main() -> i32 {
    let data:[i32;2]=[2,1]; let order:Wrong=Wrong {};
    let view:core::slice::View<i32> =core::slice::view_range<i32>(data,0,2).unwrap();
    let selected:core::result::Result<core::slice::View<i32>,core::slice::ViewError> =core::slice::select_nth_unstable_by<i32,Wrong>(view,0,order.borrow()); // rejected_selection_bound
    return 0;
}
