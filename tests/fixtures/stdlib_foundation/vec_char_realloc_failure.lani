module app::main;
import std::vec_char;

fn main() -> i32 {
    // A char holds a Unicode scalar, so U+F0000 and U+10FFFF (the largest
    // scalar) stand in for high code points.
    let high_bit: char = '󰀀';
    let maximum: char = '􏿿';
    let value: std::vec_char::VecChar = std::vec_char::try_with_capacity(1);
    if (std::vec_char::capacity(value) != 1) { return 2; }
    value = std::vec_char::try_push(value, maximum);
    if (std::vec_char::len(value) != 1) { return 3; }
    value = std::vec_char::try_push(value, high_bit);
    if (std::vec_char::len(value) != 1 || std::vec_char::capacity(value) != 1) { return 4; }
    if (std::vec_char::get_or(value, 0, '\0') != maximum) { return 5; }
    std::vec_char::destroy(value);
    return 0;
}
