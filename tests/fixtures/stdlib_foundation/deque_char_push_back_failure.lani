module app::main;
import std::deque_char;

fn main() -> i32 {
    let value: std::deque_char::DequeChar = std::deque_char::try_with_capacity(2);
    if (std::deque_char::capacity(value) != 2) { return 5; }
    value = std::deque_char::try_push_back(value, '①');
    value = std::deque_char::try_push_back(value, '②');
    value = std::deque_char::try_push_back(value, '③');
    let failure: bool = std::deque_char::capacity(value) == 2 &&
        std::deque_char::len(value) == 2 &&
        std::deque_char::at_or(value, 0, '\0') == '①' &&
        std::deque_char::at_or(value, 1, '\0') == '②';
    let success: bool = std::deque_char::capacity(value) == 4 &&
        std::deque_char::len(value) == 3 &&
        std::deque_char::at_or(value, 0, '\0') == '①' &&
        std::deque_char::at_or(value, 1, '\0') == '②' &&
        std::deque_char::at_or(value, 2, '\0') == '③';
    std::deque_char::destroy(value);
    if (failure) { return 0; }
    if (success) { return 4; }
    return 5;
}
