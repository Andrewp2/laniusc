fn keep(value: f32) -> f32 { return value; }
fn last(a: f32, b: f32, c: f32, d: f32, e: f32, f: f32, g: f32) -> f32 { return g; }
fn main() -> i32 {
    let adjacent: f32 = keep(1.00000011920928955078125);
    let one: f32 = keep(1.0);
    if (adjacent - one != 1.1920928955078125e-7) { return 1; }
    let value: f32 = (keep(1.25) + keep(2.5)) * keep(2.0);
    if (value != 7.5 || last(value, value, value, value, value, value, -value) != -7.5) { return 2; }
    let zero: f32 = 0.0;
    let negative_zero: f32 = -zero;
    let nan: f32 = zero / zero;
    let ne: bool = nan != nan;
    let le: bool = nan <= one;
    if (!ne || le || nan >= one || nan < one || nan > one || nan == one) { return 3; }
    if (one / negative_zero >= zero || one / (-negative_zero) <= zero) { return 4; }
    let values: [f32; 2] = [adjacent, negative_zero];
    values[0] = value;
    if (values[0] != 7.5 || one / values[1] >= zero) { return 5; }
    return 0;
}
