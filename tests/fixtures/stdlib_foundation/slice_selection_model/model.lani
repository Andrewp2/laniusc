// Test-only sorted-reference selection adapter, with alias mutation observations.
module app::main;

import core::mem;
import core::option;
import core::ordering;
import core::result;
import core::slice;
import std::io;

fn read_exact(pointer: ptr, count: i32, allow_eof: bool) -> bool {
    let done: i32 = 0;
    while (done < count) {
        let got: i32 = std::io::read_stdin(pointer + (done as usize), (count - done) as usize);
        assert(got >= 0);
        if (got == 0) { assert(allow_eof && done == 0); return false; }
        done += got;
    }
    return true;
}

fn write_all(pointer: ptr, count: i32) {
    let done: i32 = 0;
    while (done < count) {
        let got: i32 = std::io::write_stdout(pointer + (done as usize), (count - done) as usize);
        assert(got > 0);
        done += got;
    }
}

fn get64(bytes: [u8], offset: i32) -> u64 {
    let result: u64 = 0;
    let index: i32 = 0;
    while (index < 8) {
        result |= (bytes[offset + index] as u64) << (index * 8);
        index += 1;
    }
    return result;
}

struct Output { bytes: [u8], pointer: ptr, used: i32 }
impl Output {
    fn borrow(&self) -> &Output { return self; }
    fn flush(&self) { write_all(self.pointer, self.used); self.used = 0; }
    fn word(&self, value: u64) {
        if (self.used == 4096) { self.flush(); }
        let index: i32 = 0;
        while (index < 8) {
            self.bytes[self.used + index] = ((value >> (index * 8)) & 255) as u8;
            index += 1;
        }
        self.used += 8;
    }
}

struct Payload { marker: u64, parts: [i64; 2], flag: core::option::Option<bool> }
struct Row { key: i64, id: u64, payload: Payload }
fn row(key: i64, id: u64) -> Row {
    let flag: core::option::Option<bool> = core::option::None();
    if (id % 3 != 0) { flag = core::option::Some(id % 2 == 0); }
    return Row {
        key: key,
        id: id,
        payload: Payload {
            marker: 18446744073709551615 - id * 17,
            parts: [(id as i64) * 97 + 3, 4294967296 + (id as i64) * 131],
            flag: flag
        }
    };
}

fn emit_rows(values: [Row], output: &Output) {
    let index: i32 = 0;
    while (index < 48) { emit_row(values[index], output); index += 1; }
}

fn emit_row(item: Row, output: &Output) {
    output.word(item.key as u64); output.word(item.id); output.word(item.payload.marker);
    output.word(item.payload.parts[0] as u64); output.word(item.payload.parts[1] as u64);
    let flag: u64 = 0;
    if (item.payload.flag.is_some()) {
        flag = 1;
        if (item.payload.flag.unwrap()) { flag = 2; }
    }
    output.word(flag);
}

struct Policy { mode: i32, calls: u64 }
impl Policy { fn borrow(&self) -> &Policy { return self; } }
pub impl core::ordering::Comparator<Row, Row> for Policy {
    pub fn compare(&self, left: Row, right: Row) -> core::ordering::Ordering {
        self.calls += 1;
        let a: i64 = left.key;
        let b: i64 = right.key;
        if (self.mode == 2) { a = ((left.key as u64) & 3) as i64; b = ((right.key as u64) & 3) as i64; }
        let result: core::ordering::Ordering = core::ordering::Equal;
        if (a < b) { result = core::ordering::Less; }
        if (a > b) { result = core::ordering::Greater; }
        if (self.mode == 1) {
            if (a < b) { result = core::ordering::Greater; }
            if (a > b) { result = core::ordering::Less; }
        }
        return result;
    }
}

fn selected<T>(values: [T], input: [u8]) -> core::slice::View<T> {
    let count: i32 = get64(input, 16) as i32;
    let start: i32 = get64(input, 24) as i32;
    let length: i32 = get64(input, 32) as i32;
    let result: core::slice::View<T> = core::slice::View { values: values, start: start, length: length };
    // Valid small intervals are constructed through a genuine nested subview.
    // Forged logical metadata is passed directly to the checked operation.
    if (start >= 2 && length >= 0 && length <= count + 4) {
        if (start <= count + 6 - length) {
            let parent_result: core::result::Result<core::slice::View<T>, core::slice::ViewError> =
                core::slice::view_range<T>(values, 2, count + 4);
            let parent: core::slice::View<T> = parent_result.unwrap();
            let child_result: core::result::Result<core::slice::View<T>, core::slice::ViewError> =
                parent.subview(start - 2, start - 2 + length);
            result = child_result.unwrap();
        }
    }
    return result;
}

fn error_code(error: core::slice::ViewError) -> u64 {
    return match (error) { core::slice::ViewError::Bounds -> 1, core::slice::ViewError::InvalidSize -> 2 };
}

fn header(input: [u8], tag: u64, error: u64, start: i32, length: i32,
          before: u64, after: u64, stride: isize, returned_stride: isize, output: &Output) {
    output.word(get64(input, 0)); output.word(get64(input, 8));
    output.word(tag); output.word(error); output.word(start as i64 as u64); output.word(length as i64 as u64);
    output.word(before); output.word(after); output.word(stride as u64); output.word(returned_stride as u64);
}

fn byte_run(input: [u8], output: &Output) {
    let native: [u8; 48] = [0; 48];
    let storage_words: [i32; 12] = [0; 12];
    let values: [u8] = native;
    if (get64(input, 8) == 1) {
        values = core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(storage_words), 48);
    }
    if (get64(input, 8) == 0) { assert(core::mem::slice_stride(values) < 0); }
    else { assert(core::mem::slice_stride(values) == 1); }
    let index: i32 = 0;
    while (index < 48) { values[index] = (160 + index) as u8; index += 1; }
    index = 0;
    while (index < get64(input, 16) as i32) {
        values[4 + index] = get64(input, 64 + index * 8) as u8; index += 1;
    }
    let view: core::slice::View<u8> = selected<u8>(values, input);
    let result: core::result::Result<core::slice::View<u8>, core::slice::ViewError> =
        core::slice::select_nth_unstable<u8>(view, get64(input, 40) as i32);
    let item: u8 = 0;
    let returned: core::slice::View<u8> = core::slice::View { values: values, start: 0, length: 0 };
    if (result.is_ok()) {
        returned = result.unwrap();
        let found: core::option::Option<u8> = returned.get(0);
        item = found.unwrap();
        header(input, 0, 0, returned.start, returned.length, 0, 0,
               core::mem::slice_stride(values), core::mem::slice_stride(returned.values), output);
    } else {
        header(input, 1, error_code(result.unwrap_err()), 0, 0, 0, 0, core::mem::slice_stride(values), 0, output);
    }
    output.word(item as u64);
    index = 0;
    while (index < 48) { output.word(values[index] as u64); index += 1; }
    if (result.is_ok()) { returned.values[returned.start] = item ^ 128; }
    index = 0;
    while (index < 48) { output.word(values[index] as u64); index += 1; }
}

fn integer_run(input: [u8], output: &Output) {
    let native: [i64; 48] = [0; 48];
    let storage_words: [i32; 96] = [0; 96];
    let values: [i64] = native;
    if (get64(input, 8) == 1) {
        values = core::mem::typed_slice_from_storage<i64>(core::mem::i32_array_data_ptr(storage_words), 48);
    }
    assert(core::mem::slice_stride(values) < 0);
    let index: i32 = 0;
    while (index < 48) { values[index] = 100000 + index as i64; index += 1; }
    index = 0;
    while (index < get64(input, 16) as i32) {
        values[4 + index] = get64(input, 64 + index * 8) as i64; index += 1;
    }
    let view: core::slice::View<i64> = selected<i64>(values, input);
    let result: core::result::Result<core::slice::View<i64>, core::slice::ViewError> =
        core::slice::select_nth_unstable<i64>(view, get64(input, 40) as i32);
    let item: i64 = 0;
    let returned: core::slice::View<i64> = core::slice::View { values: values, start: 0, length: 0 };
    if (result.is_ok()) {
        returned = result.unwrap();
        let found: core::option::Option<i64> = returned.get(0);
        item = found.unwrap();
        header(input, 0, 0, returned.start, returned.length, 0, 0,
               core::mem::slice_stride(values), core::mem::slice_stride(returned.values), output);
    } else {
        header(input, 1, error_code(result.unwrap_err()), 0, 0, 0, 0, core::mem::slice_stride(values), 0, output);
    }
    output.word(item as u64);
    index = 0;
    while (index < 48) { output.word(values[index] as u64); index += 1; }
    if (result.is_ok()) { returned.values[returned.start] = ((item as u64) ^ 9223372036854775808) as i64; }
    index = 0;
    while (index < 48) { output.word(values[index] as u64); index += 1; }
}

fn record_run(input: [u8], output: &Output) {
    let native: [Row; 48] = [row(0, 0); 48];
    let storage_words: [i32; 2048] = [0; 2048];
    assert(core::mem::size_of<Row>() * 48 <= 8192);
    let values: [Row] = native;
    if (get64(input, 8) == 1) {
        values = core::mem::typed_slice_from_storage<Row>(core::mem::i32_array_data_ptr(storage_words), 48);
    }
    assert(core::mem::slice_stride(values) < 0);
    let index: i32 = 0;
    while (index < 48) { values[index] = row(100000 + index as i64, 4000000000 + index as u64); index += 1; }
    index = 0;
    while (index < get64(input, 16) as i32) {
        values[4 + index] = row(get64(input, 64 + index * 8) as i64,
                               get64(input, 56) * 64 + index as u64 + 1);
        index += 1;
    }
    let view: core::slice::View<Row> = selected<Row>(values, input);
    let policy: Policy = Policy { mode: get64(input, 48) as i32, calls: 17 + get64(input, 56) % 7 };
    let before: u64 = policy.calls;
    let result: core::result::Result<core::slice::View<Row>, core::slice::ViewError> =
        core::slice::select_nth_unstable_by<Row, Policy>(view, get64(input, 40) as i32, policy.borrow());
    let returned: core::slice::View<Row> = core::slice::View { values: values, start: 0, length: 0 };
    let item: Row = row(0, 0);
    if (result.is_ok()) {
        returned = result.unwrap();
        let found: core::option::Option<Row> = returned.get(0);
        item = found.unwrap();
        header(input, 0, 0, returned.start, returned.length, before, policy.calls,
               core::mem::slice_stride(values), core::mem::slice_stride(returned.values), output);
    } else {
        header(input, 1, error_code(result.unwrap_err()), 0, 0, before, policy.calls, core::mem::slice_stride(values), 0, output);
    }
    emit_row(item, output);
    emit_rows(values, output);
    if (result.is_ok()) {
        item.payload.marker ^= 9223372036854775808;
        returned.values[returned.start] = item;
    }
    emit_rows(values, output);
}

fn main() -> i32 {
    let input_words: [i32; 96] = [0; 96];
    let input_pointer: ptr = core::mem::i32_array_data_ptr(input_words);
    let input: [u8] = core::mem::typed_slice_from_raw_parts<u8>(input_pointer, 384);
    let output_words: [i32; 1024] = [0; 1024];
    let output_pointer: ptr = core::mem::i32_array_data_ptr(output_words);
    let output_bytes: [u8] = core::mem::typed_slice_from_raw_parts<u8>(output_pointer, 4096);
    let output: Output = Output { bytes: output_bytes, pointer: output_pointer, used: 0 };
    while (read_exact(input_pointer, 64, true)) {
        assert(get64(input, 0) <= 2 && get64(input, 8) <= 1 && get64(input, 16) <= 40 && get64(input, 48) <= 2);
        assert(read_exact(input_pointer + 64, (get64(input, 16) * 8) as i32, false));
        if (get64(input, 0) == 0) { byte_run(input, output.borrow()); }
        if (get64(input, 0) == 1) { integer_run(input, output.borrow()); }
        if (get64(input, 0) == 2) { record_run(input, output.borrow()); }
    }
    output.flush();
    return 0;
}
