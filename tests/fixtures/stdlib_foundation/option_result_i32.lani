module app::main;
import core::option_i32;
import core::result_i32;

fn main() -> i32 {
    let present: core::option_i32::OptionI32 = core::option_i32::some(-7);
    let absent: core::option_i32::OptionI32 = core::option_i32::none();
    if (!core::option_i32::is_some(present) || core::option_i32::is_some(absent) ||
        core::option_i32::is_none(present) || !core::option_i32::is_none(absent)) { return 1; }
    if (!core::option_i32::contains(present, -7) ||
        core::option_i32::contains(present, 7) ||
        core::option_i32::contains(absent, 0)) { return 2; }
    if (core::option_i32::unwrap_or(present, 99) != -7 ||
        core::option_i32::unwrap_or(absent, 99) != 99) { return 3; }
    if (core::option_i32::unwrap_or(core::option_i32::or(present, absent), 0) != -7 ||
        core::option_i32::unwrap_or(core::option_i32::or(absent, present), 0) != -7 ||
        !core::option_i32::is_none(core::option_i32::or(absent, absent))) { return 4; }
    if (core::option_i32::unwrap_or(core::option_i32::and(present, core::option_i32::some(3)), 0) != 3 ||
        !core::option_i32::is_none(core::option_i32::and(absent, present)) ||
        !core::option_i32::is_none(core::option_i32::and(present, absent))) { return 5; }
    if (!core::option_i32::is_none(core::option_i32::xor(present, present)) ||
        !core::option_i32::is_none(core::option_i32::xor(absent, absent)) ||
        core::option_i32::unwrap_or(core::option_i32::xor(present, absent), 0) != -7 ||
        core::option_i32::unwrap_or(core::option_i32::xor(absent, present), 0) != -7) { return 6; }

    let success: core::result_i32::ResultI32 = core::result_i32::ok(42);
    let failure: core::result_i32::ResultI32 = core::result_i32::err(-5);
    if (!core::result_i32::is_ok(success) || core::result_i32::is_ok(failure) ||
        core::result_i32::is_err(success) || !core::result_i32::is_err(failure)) { return 7; }
    if (!core::result_i32::contains(success, 42) ||
        core::result_i32::contains(success, 0) ||
        core::result_i32::contains(failure, 0) ||
        !core::result_i32::contains_err(failure, -5) ||
        core::result_i32::contains_err(failure, 0) ||
        core::result_i32::contains_err(success, 0)) { return 8; }
    if (core::result_i32::unwrap_or(success, 99) != 42 ||
        core::result_i32::unwrap_or(failure, 99) != 99 ||
        core::result_i32::unwrap_err_or(success, 99) != 99 ||
        core::result_i32::unwrap_err_or(failure, 99) != -5) { return 9; }
    if (core::result_i32::unwrap_or(core::result_i32::or(success, failure), 0) != 42 ||
        core::result_i32::unwrap_or(core::result_i32::or(failure, success), 0) != 42 ||
        !core::result_i32::is_err(core::result_i32::or(failure, failure))) { return 10; }
    if (core::result_i32::unwrap_err_or(core::result_i32::and(success, failure), 0) != -5 ||
        core::result_i32::unwrap_err_or(core::result_i32::and(failure, success), 0) != -5 ||
        core::result_i32::unwrap_or(core::result_i32::and(success, success), 0) != 42) { return 11; }
    if (core::option_i32::unwrap_or(core::option_i32::some(0), 9) != 0 ||
        !core::result_i32::contains_err(core::result_i32::err(0), 0) ||
        !core::result_i32::contains(core::result_i32::ok(-2147483648), -2147483648)) { return 12; }
    let converted_success: core::result_i32::ResultI32 = core::option_i32::ok_or(present, 99);
    let converted_failure: core::result_i32::ResultI32 = core::option_i32::ok_or(absent, 99);
    if (!core::result_i32::contains(converted_success, -7) ||
        !core::result_i32::contains_err(converted_failure, 99) ||
        !core::result_i32::contains_err(core::option_i32::ok_or(absent, 0), 0)) { return 13; }
    if (!core::option_i32::contains(core::option_i32::ok(success), 42) ||
        !core::option_i32::is_none(core::option_i32::ok(failure)) ||
        !core::option_i32::contains(core::option_i32::ok(core::result_i32::ok(0)), 0)) { return 14; }
    if (!core::option_i32::is_none(core::option_i32::err(success)) ||
        !core::option_i32::contains(core::option_i32::err(failure), -5) ||
        !core::option_i32::contains(core::option_i32::err(core::result_i32::err(0)), 0)) { return 15; }
    if (!present.is_some() || present.is_none() ||
        absent.is_some() || !absent.is_none() ||
        !present.contains(-7) || present.contains(0) || absent.contains(0) ||
        present.unwrap_or(99) != -7 || absent.unwrap_or(99) != 99) { return 16; }
    let option_or_present: core::option_i32::OptionI32 = present.or(absent);
    let option_or_fallback: core::option_i32::OptionI32 = absent.or(present);
    let option_and_next: core::option_i32::OptionI32 = present.and(core::option_i32::some(3));
    let option_and_absent: core::option_i32::OptionI32 = absent.and(present);
    if (!option_or_present.contains(-7) || !option_or_fallback.contains(-7) ||
        !option_and_next.contains(3) || !option_and_absent.is_none()) { return 17; }
    let option_xor_left: core::option_i32::OptionI32 = present.xor(absent);
    let option_xor_right: core::option_i32::OptionI32 = absent.xor(present);
    let option_xor_both: core::option_i32::OptionI32 = present.xor(present);
    if (!option_xor_left.contains(-7) || !option_xor_right.contains(-7) ||
        !option_xor_both.is_none()) { return 18; }
    let method_ok: core::result_i32::ResultI32 = present.ok_or(99);
    let method_err: core::result_i32::ResultI32 = absent.ok_or(-9);
    if (!core::result_i32::contains(method_ok, -7) ||
        !core::result_i32::contains_err(method_err, -9)) { return 19; }
    if (!success.is_ok() || success.is_err() ||
        failure.is_ok() || !failure.is_err() ||
        !success.contains(42) || success.contains(0) || failure.contains(0) ||
        !failure.contains_err(-5) || failure.contains_err(0) ||
        success.contains_err(0)) { return 20; }
    if (success.unwrap_or(99) != 42 || failure.unwrap_or(99) != 99 ||
        success.unwrap_err_or(99) != 99 || failure.unwrap_err_or(99) != -5) { return 21; }
    let result_or_success: core::result_i32::ResultI32 = success.or(failure);
    let result_or_fallback: core::result_i32::ResultI32 = failure.or(success);
    let result_and_next: core::result_i32::ResultI32 = success.and(failure);
    let result_and_failure: core::result_i32::ResultI32 = failure.and(success);
    if (!result_or_success.contains(42) || !result_or_fallback.contains(42) ||
        !result_and_next.contains_err(-5) ||
        !result_and_failure.contains_err(-5)) { return 22; }
    return 0;
}
