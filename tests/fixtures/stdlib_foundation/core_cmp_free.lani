// Every Eq and Ord impl in core, called through a T: Eq<T> + Ord<T> bound,
// with each type's extreme values. Exits 0; any other code names the type.
module app::main;
import core::cmp;
import core::wide_u64;
import core::wide_i64;

// low < high: all ten relations must agree.
fn ordered<T>(low: T, high: T) -> bool where T: core::cmp::Eq<T>, T: core::cmp::Ord<T>, T: core::cmp::PartialEq<T>, T: core::cmp::PartialOrd<T> {
    let relation: core::cmp::PartialOrdering = T::partial_cmp(low, high);
    let correct: bool = match (relation) { core::cmp::Less -> true, _ -> false };
    if (!correct || T::partial_eq(low, high) || !T::partial_eq(low, low) ||
        !T::partial_ne(low, high) || T::partial_ne(low, low) ||
        !T::partial_lt(low, high) || T::partial_lt(high, low) ||
        !T::partial_le(low, low) || T::partial_le(high, low) ||
        !T::partial_gt(high, low) || T::partial_gt(low, high) ||
        !T::partial_ge(high, high) || T::partial_ge(low, high)) { return false; }
    return T::eq(low, low) && !T::eq(low, high) && T::ne(low, high) && !T::ne(high, high) &&
        T::lt(low, high) && !T::lt(high, low) && !T::lt(low, low) &&
        T::le(low, high) && T::le(high, high) && !T::le(high, low) &&
        T::gt(high, low) && !T::gt(low, high) && !T::gt(high, high) &&
        T::ge(high, low) && T::ge(low, low) && !T::ge(low, high);
}

fn main() -> i32 {
    if (!ordered(-2147483648, 2147483647) || !ordered(-7, 7)) { return 1; }
    let low_u32: u32 = 2147483647;
    let high_u32: u32 = 2147483648;
    let max_u32: u32 = 4294967295;
    if (!ordered(low_u32, high_u32) || !ordered(high_u32, max_u32)) { return 2; }
    let low_i8: i8 = -128;
    let high_i8: i8 = 127;
    if (!ordered(low_i8, high_i8)) { return 3; }
    let low_i16: i16 = -32768;
    let high_i16: i16 = 32767;
    if (!ordered(low_i16, high_i16)) { return 4; }
    let low_u8: u8 = 0;
    let high_u8: u8 = 255;
    if (!ordered(low_u8, high_u8)) { return 5; }
    let low_u16: u16 = 0;
    let high_u16: u16 = 65535;
    if (!ordered(low_u16, high_u16)) { return 6; }
    let low_i64: i64 = -9223372036854775808;
    let high_i64: i64 = 9223372036854775807;
    if (!ordered(low_i64, high_i64)) { return 7; }
    let low_u64: u64 = 9223372036854775807;
    let high_u64: u64 = 18446744073709551615;
    if (!ordered(low_u64, high_u64)) { return 8; }
    let low_isize: isize = -9223372036854775808;
    let high_isize: isize = 9223372036854775807;
    if (!ordered(low_isize, high_isize)) { return 9; }
    let low_usize: usize = 0;
    let high_usize: usize = 18446744073709551615;
    if (!ordered(low_usize, high_usize)) { return 10; }
    if (!ordered(false, true)) { return 11; }
    if (!ordered('A', 'é') || !ordered('é', '😀')) { return 12; }
    let zero_wide_u: core::wide_u64::WideU64 = core::wide_u64::zero();
    let high_wide_u: core::wide_u64::WideU64 = core::wide_u64::from_words(2147483648, 0);
    let max_wide_u: core::wide_u64::WideU64 = core::wide_u64::max_value();
    if (!ordered(zero_wide_u, high_wide_u) || !ordered(high_wide_u, max_wide_u)) { return 13; }
    let min_wide_i: core::wide_i64::WideI64 = core::wide_i64::min_value();
    let neg_wide_i: core::wide_i64::WideI64 = core::wide_i64::from_i32(-1);
    let zero_wide_i: core::wide_i64::WideI64 = core::wide_i64::zero();
    let max_wide_i: core::wide_i64::WideI64 = core::wide_i64::max_value();
    if (!ordered(min_wide_i, neg_wide_i) || !ordered(neg_wide_i, zero_wide_i) ||
        !ordered(zero_wide_i, max_wide_i)) { return 14; }
    return 0;
}
