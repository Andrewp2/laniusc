// Infallible retirement and inner item agree; mapper returns Result<J,u64>, not J.
module app::main;
import core::function;
import core::clone_values;
import core::iter;
import core::option;
import core::result;
import core::slice;

struct FallibleMapper { inner:core::slice::Iter<i32> }
impl FallibleMapper { fn borrow(&self) -> &FallibleMapper { return self; } }
pub impl core::function::Mapper<i32,core::result::Result<core::slice::Iter<i32>,u64>> for FallibleMapper {
    pub fn apply(&self, value:i32) -> core::result::Result<core::slice::Iter<i32>,u64> {
        if(value==0) {
            let error: u64 = 19;
            let failure: core::result::Result<core::slice::Iter<i32>,u64> = core::result::Err(error);
            return failure;
        }
        let mapped: core::result::Result<core::slice::Iter<i32>,u64> = core::result::Ok(self.inner);
        return mapped;
    }
}
struct InfallibleRetirement {}
impl InfallibleRetirement { fn borrow(&self) -> &InfallibleRetirement { return self; } }
// The borrowed slice cursor owns no backing to release.
pub impl core::iter::InnerRetirement<core::slice::Iter<i32>,core::clone_values::Infallible> for InfallibleRetirement {
    pub fn try_retire(&self, inner:core::slice::Iter<i32>) -> core::option::Option<core::iter::RetireFailure<core::slice::Iter<i32>,core::clone_values::Infallible>> {
        let retired: core::option::Option<core::iter::RetireFailure<core::slice::Iter<i32>,core::clone_values::Infallible>> = core::option::None();
        return retired;
    }
}
fn main() -> i32 {
    let values: [i32;1] = [7];
    let inner: core::slice::Iter<i32> = core::iter::from_slice<i32>(values,1).unwrap();
    let inputs: [i32;1] = [0];
    let source: core::slice::Iter<i32> = core::iter::from_slice<i32>(inputs,1).unwrap();
    let mapper: FallibleMapper = FallibleMapper { inner:inner };
    let retirement: InfallibleRetirement = InfallibleRetirement {};
    let rejected: core::iter::FlatMap<core::slice::Iter<i32>,FallibleMapper,InfallibleRetirement,i32,core::slice::Iter<i32>,i32> = core::iter::flat_map<core::slice::Iter<i32>,FallibleMapper,InfallibleRetirement,i32,core::slice::Iter<i32>,i32>(source.borrow(),mapper.borrow(),retirement.borrow());
    return 0;
}
