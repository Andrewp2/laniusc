// Iterator types agree; only retirement's u64 error is not real Infallible.
module app::main;
import core::iter;
import core::option;
import core::slice;

struct FallibleRetirement {}
impl FallibleRetirement { fn borrow(&self) -> &FallibleRetirement { return self; } }
pub impl core::iter::InnerRetirement<core::slice::Iter<i32>,u64> for FallibleRetirement {
    pub fn try_retire(&self, inner:core::slice::Iter<i32>) -> core::option::Option<core::iter::RetireFailure<core::slice::Iter<i32>,u64>> {
        let error: u64 = 17;
        let failure: core::iter::RetireFailure<core::slice::Iter<i32>,u64> = core::iter::RetireFailure { inner:inner,error:error };
        return core::option::Some(failure);
    }
}
fn main() -> i32 {
    let values: [i32;1] = [7];
    let inner: core::slice::Iter<i32> = core::iter::from_slice<i32>(values,1).unwrap();
    let inners: [core::slice::Iter<i32>;1] = [inner];
    let source: core::slice::Iter<core::slice::Iter<i32>> = core::iter::from_slice<core::slice::Iter<i32>>(inners,1).unwrap();
    let retirement: FallibleRetirement = FallibleRetirement {};
    let rejected: core::iter::Flatten<core::slice::Iter<core::slice::Iter<i32>>,core::slice::Iter<i32>,FallibleRetirement,i32> = core::iter::flatten<core::slice::Iter<core::slice::Iter<i32>>,core::slice::Iter<i32>,FallibleRetirement,i32>(source.borrow(),retirement.borrow());
    return 0;
}
