module app::main;
import std::set;

fn main() -> i32 {
    let value: std::set::Set<i32> = std::set::try_insert(std::set::new(), -41);
    if (std::set::len(value) != 1) { return 2; }
    let copy: std::set::Set<i32> = std::set::try_clone(value);
    if (std::set::len(copy) == 0 &&
        std::set::capacity(copy) == 0 &&
        std::set::at_or(value, 0, 0) == -41) {
        std::set::destroy(copy);
        std::set::destroy(value);
        return 0;
    }
    if (std::set::len(copy) == 1 &&
        std::set::at_or(copy, 0, 0) == -41 &&
        std::set::at_or(value, 0, 0) == -41) {
        std::set::destroy(copy);
        std::set::destroy(value);
        return 4;
    }
    std::set::destroy(copy);
    std::set::destroy(value);
    return 5;
}
