module app::main;
import core::i32;
import core::option_i32;

fn main() -> i32 {
    let minimum: i32 = -2147483648;
    let maximum: i32 = 2147483647;
    if (core::i32::MIN != minimum || core::i32::MAX != maximum ||
        core::i32::BITS != 32 || core::i32::BYTES != 4 ||
        core::i32::abs(-7) != 7 || core::i32::abs(minimum) != maximum ||
        core::i32::saturating_abs(minimum) != maximum ||
        !core::option_i32::contains(core::i32::checked_abs(-7), 7) ||
        !core::option_i32::is_none(core::i32::checked_abs(minimum))) {
        return 1;
    }
    if (core::i32::min(3, -5) != -5 || core::i32::max(3, -5) != 3 ||
        core::i32::clamp(12, 2, 10) != 10 ||
        core::i32::clamp(5, 10, 3) != 5 ||
        core::i32::signum(-7) != -1 || core::i32::signum(0) != 0 ||
        core::i32::signum(7) != 1 ||
        core::i32::compare_as_i32(3, 5) != -1 ||
        core::i32::compare_as_i32(5, 5) != 0 ||
        core::i32::compare_as_i32(7, 5) != 1) {
        return 2;
    }
    if (!core::i32::is_zero(0) || core::i32::is_zero(1) ||
        !core::i32::is_nonzero(-1) || core::i32::is_nonzero(0) ||
        !core::i32::is_even(-4) || core::i32::is_even(-3) ||
        !core::i32::is_odd(-3) || core::i32::is_odd(-4) ||
        !core::i32::is_negative(-1) || core::i32::is_negative(0) ||
        !core::i32::is_positive(1) || core::i32::is_positive(0)) {
        return 3;
    }
    if (!core::i32::is_nonnegative(0) || core::i32::is_nonnegative(-1) ||
        !core::i32::is_nonpositive(0) || core::i32::is_nonpositive(1) ||
        !core::i32::between_inclusive(-3, -3, 2) ||
        core::i32::between_inclusive(-4, -3, 2) ||
        !core::i32::between_exclusive(0, -3, 2) ||
        core::i32::between_exclusive(-3, -3, 2)) {
        return 4;
    }
    if (core::i32::wrapping_add(maximum, 1) != minimum ||
        core::i32::wrapping_sub(minimum, 1) != maximum ||
        core::i32::wrapping_mul(maximum, 2) != -2 ||
        core::i32::saturating_add(maximum, 1) != maximum ||
        core::i32::saturating_sub(minimum, 1) != minimum ||
        core::i32::saturating_abs_diff(minimum, maximum) != maximum) {
        return 5;
    }
    if (!core::option_i32::contains(core::i32::checked_add(3, 5), 8) ||
        !core::option_i32::is_none(core::i32::checked_add(maximum, 1)) ||
        !core::option_i32::contains(core::i32::checked_sub(5, 3), 2) ||
        !core::option_i32::is_none(core::i32::checked_sub(minimum, 1))) {
        return 6;
    }
    if (!core::i32::is_power_of_two(1073741824) ||
        core::i32::is_power_of_two(maximum) ||
        core::i32::is_power_of_two(0) ||
        core::i32::next_power_of_two(7) != 8 ||
        core::i32::next_power_of_two(maximum) != 0) {
        return 7;
    }
    return 0;
}
