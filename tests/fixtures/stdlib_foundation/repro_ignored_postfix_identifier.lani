// Compiler dependency: the two unknown identifiers after `x` are ignored.
// `laniusc check` accepts this file, and its native executable exits zero.
// Correct behavior is a diagnostic at `not_a_cast`.
module app::main;
fn main() -> i32 {
    let x: u32 = 4294967295;
    let y: i32 = x not_a_cast NotAType;
    if (y == -1) { return 0; }
    return 1;
}
