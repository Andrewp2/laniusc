module app::main;
import std::vec_bool;

fn main() -> i32 {
    let first: bool = false;
    let last: bool = true;
    let fallback: bool = false;
    let value: std::vec_bool::VecBool = std::vec_bool::try_with_capacity(4);
    if (std::vec_bool::capacity(value) != 4) { return 2; }
    value = std::vec_bool::try_push(value, first);
    value = std::vec_bool::try_push(value, last);
    if (std::vec_bool::len(value) != 2) { return 3; }
    let copy: std::vec_bool::VecBool = std::vec_bool::try_clone(value);
    if (std::vec_bool::len(copy) == 2) {
        std::vec_bool::destroy(copy);
        std::vec_bool::destroy(value);
        return 4;
    }
    if (std::vec_bool::len(copy) != 0 ||
        std::vec_bool::capacity(copy) != 0 ||
        std::vec_bool::len(value) != 2 ||
        std::vec_bool::capacity(value) != 4 ||
        std::vec_bool::get_or(value, 0, fallback) != first ||
        std::vec_bool::get_or(value, 1, fallback) != last) { return 5; }
    std::vec_bool::destroy(copy);
    std::vec_bool::destroy(value);
    return 0;
}
