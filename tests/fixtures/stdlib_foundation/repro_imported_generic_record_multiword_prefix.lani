module app::main;
import core::five;
struct Pair { number: i32, text: str }
fn view(values: [i32]) -> [i32] { return values; }
fn main() -> i32 {
    let data: [i32; 2] = [-7, 42];
    let wide: core::five::Five<str, Pair, [str; 2], [i32], i32> = core::five::Five {
        fifth: 99, fourth: view(data), third: ["Ω", ""], second: Pair { number: -7, text: "Ω" }, first: "Ω",
    };
    if (wide.fifth != 99) { return 1; }
    return 0;
}
