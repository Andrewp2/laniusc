module app::main;
import std::vec_char;

fn main() -> i32 {
    let fallback: char = '?';
    let value: std::vec_char::VecChar = std::vec_char::try_with_capacity(1);
    if (std::vec_char::capacity(value) != 1) { return 2; }
    value = std::vec_char::try_push(value, 'Ω');
    if (std::vec_char::len(value) != 1) { return 3; }
    value = std::vec_char::try_resize(value, 3, '😀');
    if (std::vec_char::len(value) == 3 &&
        std::vec_char::get_or(value, 0, fallback) == 'Ω' &&
        std::vec_char::get_or(value, 1, fallback) == '😀' &&
        std::vec_char::get_or(value, 2, fallback) == '😀') {
        std::vec_char::destroy(value);
        return 4;
    }
    if (std::vec_char::len(value) != 1 || std::vec_char::capacity(value) != 1 ||
        std::vec_char::get_or(value, 0, fallback) != 'Ω') { return 5; }
    std::vec_char::destroy(value);
    return 0;
}
