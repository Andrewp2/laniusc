module app::main;
import core::option_f32;
import core::result_f32;

fn main() -> i32 {
    let present: core::option_f32::OptionF32 = core::option_f32::some(1.5);
    let zero_value: core::option_f32::OptionF32 = core::option_f32::some(0.0);
    let absent: core::option_f32::OptionF32 = core::option_f32::none();
    if (!core::option_f32::is_some(present) ||
        !core::option_f32::is_some(zero_value) ||
        core::option_f32::is_some(absent) ||
        core::option_f32::is_none(present) ||
        !core::option_f32::is_none(absent)) { return 1; }
    if (!core::option_f32::contains(present, 1.5) ||
        !core::option_f32::contains(zero_value, 0.0) ||
        core::option_f32::contains(present, 2.5) ||
        core::option_f32::contains(absent, 0.0)) { return 2; }
    if (core::option_f32::unwrap_or(present, 9.0) != 1.5 ||
        core::option_f32::unwrap_or(zero_value, 9.0) != 0.0 ||
        core::option_f32::unwrap_or(absent, 9.0) != 9.0) { return 3; }
    if (!core::option_f32::contains(core::option_f32::or(present, absent), 1.5) ||
        !core::option_f32::contains(core::option_f32::or(absent, zero_value), 0.0) ||
        !core::option_f32::is_none(core::option_f32::or(absent, absent))) { return 4; }
    if (!core::option_f32::contains(core::option_f32::and(present, zero_value), 0.0) ||
        !core::option_f32::is_none(core::option_f32::and(absent, present)) ||
        !core::option_f32::is_none(core::option_f32::and(present, absent))) { return 5; }
    if (!core::option_f32::is_none(core::option_f32::xor(present, zero_value)) ||
        !core::option_f32::is_none(core::option_f32::xor(absent, absent)) ||
        !core::option_f32::contains(core::option_f32::xor(zero_value, absent), 0.0) ||
        !core::option_f32::contains(core::option_f32::xor(absent, present), 1.5)) { return 6; }

    let success: core::result_f32::ResultF32 = core::result_f32::ok(-2.5);
    let zero_success: core::result_f32::ResultF32 = core::result_f32::ok(0.0);
    let failure: core::result_f32::ResultF32 = core::result_f32::err(3.5);
    let zero_failure: core::result_f32::ResultF32 = core::result_f32::err(0.0);
    if (!core::result_f32::is_ok(success) ||
        !core::result_f32::is_ok(zero_success) ||
        core::result_f32::is_ok(failure) ||
        core::result_f32::is_err(success) ||
        !core::result_f32::is_err(zero_failure)) { return 7; }
    if (!core::result_f32::contains(success, -2.5) ||
        !core::result_f32::contains(zero_success, 0.0) ||
        core::result_f32::contains(failure, 0.0) ||
        !core::result_f32::contains_err(failure, 3.5) ||
        !core::result_f32::contains_err(zero_failure, 0.0) ||
        core::result_f32::contains_err(success, 0.0)) { return 8; }
    if (core::result_f32::unwrap_or(success, 9.0) != -2.5 ||
        core::result_f32::unwrap_or(failure, 9.0) != 9.0 ||
        core::result_f32::unwrap_err_or(success, 9.0) != 9.0 ||
        core::result_f32::unwrap_err_or(failure, 9.0) != 3.5) { return 9; }
    if (!core::result_f32::contains(core::result_f32::or(success, failure), -2.5) ||
        !core::result_f32::contains(core::result_f32::or(failure, zero_success), 0.0) ||
        !core::result_f32::is_err(core::result_f32::or(zero_failure, failure))) { return 10; }
    if (!core::result_f32::contains_err(core::result_f32::and(success, failure), 3.5) ||
        !core::result_f32::contains_err(core::result_f32::and(zero_failure, success), 0.0) ||
        !core::result_f32::contains(core::result_f32::and(success, zero_success), 0.0)) { return 11; }

    if (!core::result_f32::contains(core::option_f32::ok_or(present, 8.5), 1.5) ||
        !core::result_f32::contains(core::option_f32::ok_or(zero_value, 8.5), 0.0) ||
        !core::result_f32::contains_err(core::option_f32::ok_or(absent, 8.5), 8.5)) { return 12; }
    if (!core::option_f32::contains(core::option_f32::ok(success), -2.5) ||
        !core::option_f32::contains(core::option_f32::ok(zero_success), 0.0) ||
        !core::option_f32::is_none(core::option_f32::ok(failure)) ||
        !core::option_f32::is_none(core::option_f32::err(success)) ||
        !core::option_f32::contains(core::option_f32::err(failure), 3.5) ||
        !core::option_f32::contains(core::option_f32::err(zero_failure), 0.0)) { return 13; }

    let zero: f32 = 0.0;
    let nan: f32 = zero / zero;
    let nan_option: core::option_f32::OptionF32 = core::option_f32::some(nan);
    let nan_ok: core::result_f32::ResultF32 = core::result_f32::ok(nan);
    let nan_error: core::result_f32::ResultF32 = core::result_f32::err(nan);
    if (!core::option_f32::is_some(nan_option) ||
        core::option_f32::contains(nan_option, nan) ||
        core::option_f32::unwrap_or(nan_option, 0.0) == core::option_f32::unwrap_or(nan_option, 0.0) ||
        !core::result_f32::is_ok(nan_ok) ||
        core::result_f32::contains(nan_ok, nan) ||
        core::result_f32::unwrap_or(nan_ok, 0.0) == core::result_f32::unwrap_or(nan_ok, 0.0) ||
        !core::result_f32::is_err(nan_error) ||
        core::result_f32::contains_err(nan_error, nan) ||
        core::result_f32::unwrap_err_or(nan_error, 0.0) == core::result_f32::unwrap_err_or(nan_error, 0.0)) { return 14; }
    return 0;
}
