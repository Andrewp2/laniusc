// expect: 0
// stdin: 00 80 ff 2a; stdout: 00 80 ff
module app::main;
import core::io;
import core::result;
import std::stream;

fn host_code(result: core::result::Result<i32, core::io::Error>) -> i32 {
    if (core::result::is_ok(result)) { return 0; }
    let error: core::io::Error = core::result::unwrap_err(result);
    let code: i32 = match (error) { Host(value) -> value, _ -> -1 };
    return code;
}

fn main() -> i32 {
    let bytes: [u8; 5] = [99; 5];
    let invalid: std::stream::Descriptor = std::stream::from_handle(-1);
    if (invalid.raw_handle() != -1 || host_code(invalid.read(bytes, 0, 1)) != 9) { return 1; }
    if (host_code(invalid.write(bytes, 0, 1)) != 9) { return 2; }
    if (core::result::unwrap(invalid.read(bytes, 0, 0)) != 0 || core::result::unwrap(invalid.write(bytes, 0, 0)) != 0) { return 3; }
    if (!core::result::is_err(invalid.read(bytes, -1, 0)) || !core::result::is_err(invalid.write(bytes, 2147483647, 1))) { return 4; }
    let input: std::stream::Descriptor = std::stream::stdin();
    let read: core::result::Result<i32, core::io::Failure> = core::io::read_exact(input.borrow(), bytes, 1, 3);
    if (core::result::unwrap(read) != 3 || bytes[0] != 99 || bytes[1] != 0 || bytes[2] != 128 || bytes[3] != 255 || bytes[4] != 99) { return 5; }
    let output: std::stream::Descriptor = std::stream::stdout();
    let written: core::result::Result<i32, core::io::Failure> = core::io::write_all(output.borrow(), bytes, 1, 3);
    if (core::result::unwrap(written) != 3 || core::result::unwrap(output.flush()) != 0) { return 6; }
    let short: core::result::Result<i32, core::io::Failure> = core::io::read_exact(input.borrow(), bytes, 1, 2);
    if (core::result::is_ok(short)) { return 7; }
    let failure: core::io::Failure = core::result::unwrap_err(short);
    let eof: bool = match (failure.cause) { UnexpectedEof -> true, _ -> false };
    if (!eof || failure.completed != 1 || bytes[1] != 42 || bytes[2] != 128) { return 8; }
    return 0;
}
