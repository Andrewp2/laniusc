module app::main;
import std::vec_i8;

fn main() -> i32 {
    let first: i8 = -128;
    let last: i8 = 127;
    let fallback: i8 = 0;
    let value: std::vec_i8::VecI8 = std::vec_i8::try_with_capacity(4);
    if (std::vec_i8::capacity(value) != 4) { return 2; }
    value = std::vec_i8::try_push(value, first);
    value = std::vec_i8::try_push(value, last);
    if (std::vec_i8::len(value) != 2) { return 3; }
    let copy: std::vec_i8::VecI8 = std::vec_i8::try_clone(value);
    if (std::vec_i8::len(copy) == 2) {
        std::vec_i8::destroy(copy);
        std::vec_i8::destroy(value);
        return 4;
    }
    if (std::vec_i8::len(copy) != 0 ||
        std::vec_i8::capacity(copy) != 0 ||
        std::vec_i8::len(value) != 2 ||
        std::vec_i8::capacity(value) != 4 ||
        std::vec_i8::get_or(value, 0, fallback) != first ||
        std::vec_i8::get_or(value, 1, fallback) != last) { return 5; }
    std::vec_i8::destroy(copy);
    std::vec_i8::destroy(value);
    return 0;
}
