module app::main;
import std::set_u8;

fn main() -> i32 {
    let zero: u32 = 0;
    let empty: [u32; 8] = [zero, zero, zero, zero, zero, zero, zero, zero];
    let all: [u32; 8] = [zero, zero, zero, zero, zero, zero, zero, zero];
    std::set_u8::fill(all, true);
    if (!std::set_u8::is_empty(empty) || std::set_u8::is_full(empty) ||
        std::set_u8::len(empty) != 0 || std::set_u8::is_empty(all) ||
        !std::set_u8::is_full(all) || std::set_u8::len(all) != 256 ||
        std::set_u8::at_or(empty, 0, 251) != 251) { return 1; }

    let left: [u32; 8] = [zero, zero, zero, zero, zero, zero, zero, zero];
    let right: [u32; 8] = [zero, zero, zero, zero, zero, zero, zero, zero];
    let index: i32 = 0;
    while (index < 256) {
        let byte: u8 = index;
        if (index % 3 == 0 && !std::set_u8::insert(left, byte)) { return 2; }
        if (index % 5 == 0 && !std::set_u8::insert(right, byte)) { return 3; }
        index += 1;
    }
    if (std::set_u8::len(left) != 86 || std::set_u8::len(right) != 52 ||
        std::set_u8::at_or(left, 0, 251) != 0 ||
        std::set_u8::at_or(left, 1, 251) != 3 ||
        std::set_u8::at_or(left, 85, 251) != 255 ||
        std::set_u8::at_or(left, -1, 251) != 251 ||
        std::set_u8::at_or(left, 86, 251) != 251 ||
        std::set_u8::insert(left, 0) ||
        std::set_u8::remove(left, 1)) { return 4; }

    let joined: [u32; 8] = [zero, zero, zero, zero, zero, zero, zero, zero];
    let common: [u32; 8] = [zero, zero, zero, zero, zero, zero, zero, zero];
    let only_left: [u32; 8] = [zero, zero, zero, zero, zero, zero, zero, zero];
    let exclusive: [u32; 8] = [zero, zero, zero, zero, zero, zero, zero, zero];
    std::set_u8::union_into(joined, left, right);
    std::set_u8::intersection_into(common, left, right);
    std::set_u8::difference_into(only_left, left, right);
    std::set_u8::symmetric_difference_into(exclusive, left, right);
    if (std::set_u8::len(joined) != 120 ||
        std::set_u8::len(common) != 18 ||
        std::set_u8::len(only_left) != 68 ||
        std::set_u8::len(exclusive) != 102 ||
        !std::set_u8::is_subset(common, left) ||
        std::set_u8::is_subset(left, common) ||
        !std::set_u8::is_disjoint(only_left, right) ||
        std::set_u8::is_disjoint(left, right) ||
        !std::set_u8::is_subset(left, all) ||
        !std::set_u8::is_disjoint(empty, all)) { return 5; }

    index = 0;
    while (index < 256) {
        let byte: u8 = index;
        let in_left: bool = index % 3 == 0;
        let in_right: bool = index % 5 == 0;
        if (std::set_u8::contains(empty, byte) ||
            !std::set_u8::contains(all, byte) ||
            std::set_u8::contains(left, byte) != in_left ||
            std::set_u8::contains(right, byte) != in_right ||
            std::set_u8::contains(joined, byte) != (in_left || in_right) ||
            std::set_u8::contains(common, byte) != (in_left && in_right) ||
            std::set_u8::contains(only_left, byte) != (in_left && !in_right) ||
            std::set_u8::contains(exclusive, byte) != (in_left != in_right)) {
            return 6;
        }
        index += 1;
    }

    let alias: [u32; 8] = [zero, zero, zero, zero, zero, zero, zero, zero];
    std::set_u8::union_into(alias, left, right);
    std::set_u8::difference_into(alias, alias, right);
    if (std::set_u8::len(alias) != 68 ||
        std::set_u8::at_or(alias, 0, 251) != 3) { return 7; }
    std::set_u8::intersection_into(alias, alias, left);
    if (std::set_u8::len(alias) != 68) { return 10; }
    std::set_u8::symmetric_difference_into(alias, alias, right);
    if (std::set_u8::len(alias) != 120 ||
        !std::set_u8::is_subset(joined, alias)) { return 11; }
    if (!std::set_u8::remove(left, 0) || std::set_u8::remove(left, 0) ||
        std::set_u8::contains(left, 0) || std::set_u8::len(left) != 85) {
        return 8;
    }
    std::set_u8::clear(left);
    std::set_u8::fill(right, false);
    if (!std::set_u8::is_empty(left) || !std::set_u8::is_empty(right) ||
        !std::set_u8::contains(all, 255)) { return 9; }
    return 0;
}
