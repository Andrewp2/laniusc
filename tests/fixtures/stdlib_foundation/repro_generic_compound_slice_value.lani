module app::main;
import core::mem;

struct Pair { left: i32, right: i32 }

fn keep<T>(value: T) -> T { return core::mem::identity(value); }
fn count(values: [Pair]) -> i32 {
    let result: i32 = 0;
    for value in values { result += 1; }
    return result;
}

// Whole borrowed values retain their runtime length, element layout, and aliases
// through imported selection and local-to-imported generic forwarding.
fn inspect(values: [Pair], fallback: [Pair]) -> i32 {
    let copied: [Pair] = core::mem::identity(values);
    if (copied[0].left != -7 || copied[0].right != 42) { return 1; }
    if (copied[1].left != 99 || copied[1].right != -11) { return 2; }
    let forwarded: [Pair] = keep(copied);
    let selected: [Pair] = core::mem::select(false, forwarded, fallback);
    let first: [Pair] = core::mem::first(forwarded, fallback);
    let second: [Pair] = core::mem::second(forwarded, fallback);
    if (count(copied) != 2 || count(forwarded) != 2 || count(first) != 2 || count(selected) != 3 || count(second) != 3) { return 3; }
    selected[2].right = 123;
    forwarded[0].left = -99;
    if (fallback[2].right != 123 || second[2].right != 123 || values[0].left != -99 || first[0].left != -99 || copied[0].right != 42) { return 4; }
    let empty: [Pair] = core::mem::typed_slice_from_raw_parts(core::mem::i32_slice_data_ptr(values), 0);
    let empty_forwarded: [Pair] = keep(empty);
    let empty_selected: [Pair] = core::mem::select(true, empty_forwarded, fallback);
    if (count(empty_forwarded) != 0 || count(empty_selected) != 0 || fallback[2].left != 55) { return 5; }
    return 0;
}

fn main() -> i32 {
    let first: Pair = Pair { left: -7, right: 42 };
    let second: Pair = Pair { left: 99, right: -11 };
    let rows: [Pair; 2] = [first, second];
    let third: Pair = Pair { left: 55, right: -100 };
    let fallback: [Pair; 3] = [second, first, third];
    let status: i32 = inspect(rows, fallback);
    if (status != 0) { return status; }
    if (rows[0].left != -99 || rows[0].right != 42 || rows[1].right != -11 || fallback[2].right != 123 || third.right != -100) { return 6; }
    return 0;
}
