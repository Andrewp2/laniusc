    pub fn next(&self) -> core::option::Option<i32> { return core::option::None(); }
}
fn main() -> i32 {
    let source:Forward=Forward {};
    let rejected:core::iter::Rev<Forward,i32> =core::iter::rev<Forward,i32>(source.borrow());
    return 0;
