module app::main;
import std::map_bool_u32;

fn main() -> i32 {
    let empty: std::map_bool_u32::MapBoolU32 = std::map_bool_u32::new();
    let fallback: u32 = 77;
    let high: u32 = 2147483648;
    let maximum: u32 = 4294967295;
    if (!std::map_bool_u32::is_empty(empty) ||
        std::map_bool_u32::len(empty) != 0 ||
        std::map_bool_u32::contains_key(empty, false) ||
        std::map_bool_u32::contains_key(empty, true) ||
        std::map_bool_u32::get_or(empty, false, fallback) != fallback ||
        std::map_bool_u32::get_or(empty, true, fallback) != fallback ||
        std::map_bool_u32::key_at_or(empty, 0, true) != true ||
        std::map_bool_u32::value_at_or(empty, 0, fallback) != fallback) { return 1; }

    let false_first: std::map_bool_u32::MapBoolU32 =
        std::map_bool_u32::put(empty, false, 0);
    if (std::map_bool_u32::is_empty(false_first) ||
        std::map_bool_u32::len(false_first) != 1 ||
        !std::map_bool_u32::contains_key(false_first, false) ||
        std::map_bool_u32::contains_key(false_first, true) ||
        std::map_bool_u32::get_or(false_first, false, fallback) != 0 ||
        std::map_bool_u32::key_at_or(false_first, 0, true) != false ||
        std::map_bool_u32::value_at_or(false_first, 0, fallback) != 0) { return 2; }

    let both: std::map_bool_u32::MapBoolU32 =
        std::map_bool_u32::put(false_first, true, maximum);
    if (std::map_bool_u32::len(both) != 2 ||
        !std::map_bool_u32::contains_key(both, true) ||
        std::map_bool_u32::get_or(both, true, fallback) != maximum ||
        std::map_bool_u32::key_at_or(both, 0, true) != false ||
        std::map_bool_u32::key_at_or(both, 1, false) != true ||
        std::map_bool_u32::value_at_or(both, 0, fallback) != 0 ||
        std::map_bool_u32::value_at_or(both, 1, fallback) != maximum ||
        std::map_bool_u32::key_at_or(both, -1, true) != true ||
        std::map_bool_u32::key_at_or(both, 2, false) != false ||
        std::map_bool_u32::value_at_or(both, -1, fallback) != fallback ||
        std::map_bool_u32::value_at_or(both, 2, fallback) != fallback) { return 3; }

    let updated: std::map_bool_u32::MapBoolU32 =
        std::map_bool_u32::put(both, false, high);
    updated = std::map_bool_u32::put(updated, true, 0);
    if (std::map_bool_u32::len(updated) != 2 ||
        std::map_bool_u32::key_at_or(updated, 0, true) != false ||
        std::map_bool_u32::key_at_or(updated, 1, false) != true ||
        std::map_bool_u32::get_or(updated, false, fallback) != high ||
        std::map_bool_u32::get_or(updated, true, fallback) != 0 ||
        std::map_bool_u32::get_or(both, false, fallback) != 0 ||
        std::map_bool_u32::get_or(both, true, fallback) != maximum) { return 4; }

    let true_first: std::map_bool_u32::MapBoolU32 =
        std::map_bool_u32::put(empty, true, high);
    let reverse: std::map_bool_u32::MapBoolU32 =
        std::map_bool_u32::put(true_first, false, maximum);
    if (std::map_bool_u32::key_at_or(reverse, 0, false) != true ||
        std::map_bool_u32::key_at_or(reverse, 1, true) != false ||
        std::map_bool_u32::value_at_or(reverse, 0, fallback) != high ||
        std::map_bool_u32::value_at_or(reverse, 1, fallback) != maximum) { return 5; }

    let without_first: std::map_bool_u32::MapBoolU32 =
        std::map_bool_u32::remove(reverse, true);
    let without_second: std::map_bool_u32::MapBoolU32 =
        std::map_bool_u32::remove(reverse, false);
    let missing: std::map_bool_u32::MapBoolU32 =
        std::map_bool_u32::remove(true_first, false);
    let readded: std::map_bool_u32::MapBoolU32 =
        std::map_bool_u32::put(without_first, true, high);
    if (std::map_bool_u32::len(without_first) != 1 ||
        std::map_bool_u32::key_at_or(without_first, 0, true) != false ||
        std::map_bool_u32::get_or(without_first, false, fallback) != maximum ||
        std::map_bool_u32::len(without_second) != 1 ||
        std::map_bool_u32::key_at_or(without_second, 0, false) != true ||
        std::map_bool_u32::get_or(without_second, true, fallback) != high ||
        std::map_bool_u32::len(missing) != 1 ||
        std::map_bool_u32::get_or(missing, true, fallback) != high ||
        std::map_bool_u32::len(reverse) != 2 ||
        std::map_bool_u32::len(readded) != 2 ||
        std::map_bool_u32::key_at_or(readded, 0, true) != false ||
        std::map_bool_u32::key_at_or(readded, 1, false) != true) { return 6; }

    let cleared: std::map_bool_u32::MapBoolU32 = std::map_bool_u32::clear(reverse);
    let reinserted: std::map_bool_u32::MapBoolU32 =
        std::map_bool_u32::put(cleared, false, maximum);
    if (!std::map_bool_u32::is_empty(cleared) ||
        std::map_bool_u32::len(cleared) != 0 ||
        std::map_bool_u32::len(reinserted) != 1 ||
        std::map_bool_u32::key_at_or(reinserted, 0, true) != false ||
        std::map_bool_u32::value_at_or(reinserted, 0, fallback) != maximum) { return 7; }
    return 0;
}
