module app::main;
import std::vec;
import std::vec_i32;

fn main() -> i32 {
    if (std::vec::vec_runtime_abi_version() != 1 ||
        std::vec::vec_service_id() != 13 ||
        !std::vec::vec_service_is_known() ||
        std::vec::vec_service_status() != std::vec::VEC_SERVICE_STATUS_UNAVAILABLE ||
        std::vec::vec_is_available() ||
        !std::vec::vec_requires_runtime_binding()) { return 1; }

    let values: std::vec_i32::VecI32 = std::vec_i32::new();
    values = std::vec_i32::try_push(values, 41);
    values = std::vec_i32::try_push(values, 42);
    let correct: bool = std::vec_i32::len(values) == 2 &&
        std::vec_i32::get_or(values, 0, -1) == 41 &&
        std::vec_i32::get_or(values, 1, -1) == 42;
    std::vec_i32::destroy(values);
    if (!correct) { return 2; }
    return 0;
}
