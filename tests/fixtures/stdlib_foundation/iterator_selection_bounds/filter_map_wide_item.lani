module app::main;
import core::iter;
import core::option;
import core::range;

struct WideMapper {}
impl WideMapper { fn borrow(&self) -> &WideMapper { return self; } }
pub impl core::iter::Mapper<i32, core::option::Option<u64>> for WideMapper {
    pub fn apply(&self, value: i32) -> core::option::Option<u64> {
        let widened: u64 = value as u64;
        let result: core::option::Option<u64> = core::option::Some(widened);
        return result;
    }
}
fn main() -> i32 {
    let bounds: core::range::Range<i32> = core::range::range<i32>(0, 1);
    let source: core::iter::RangeI32 = core::iter::range_i32(bounds);
    let mapper: WideMapper = WideMapper {};
    let rejected: core::iter::FilterMap<core::iter::RangeI32, WideMapper, i32, i32> = core::iter::filter_map<core::iter::RangeI32, WideMapper, i32, i32>(source.borrow(), mapper.borrow());
    return 0;
}
