// Concatenated after the legacy stdlib/array_i32_4.lani source.
fn main() -> i32 {
    let values:[i32; 4] = [3, -1, 3, 8];
    if (lstd_i32x4_len() != 4 || lstd_i32x4_is_empty()) { return 1; }
    if (lstd_i32x4_first(values) != 3 || lstd_i32x4_last(values) != 8) { return 2; }
    if (lstd_i32x4_sum(values) != 13 || lstd_i32x4_min(values) != -1 || lstd_i32x4_max(values) != 8) { return 3; }
    if (lstd_i32x4_get_or(values, 2, 99) != 3 || lstd_i32x4_get_or(values, -1, 99) != 99 || lstd_i32x4_get_or(values, 4, 99) != 99) { return 4; }
    if (!lstd_i32x4_contains(values, -1) || lstd_i32x4_contains(values, 7)) { return 5; }
    if (lstd_i32x4_count(values, 3) != 2 || lstd_i32x4_count(values, 7) != 0) { return 6; }
    if (lstd_i32x4_index_of_or(values, 3, 99) != 0 || lstd_i32x4_index_of_or(values, 8, 99) != 3 || lstd_i32x4_index_of_or(values, 7, 99) != 99) { return 7; }
    let destination:[i32; 4] = [0, 0, 0, 0];
    if (lstd_i32x4_copy_into(values, destination, 3) ||
        destination[0] != 0 ||
        !lstd_i32x4_copy_into(values, destination, 4) ||
        destination[0] != 3 || destination[1] != -1 ||
        destination[2] != 3 || destination[3] != 8) { return 8; }
    if (lstd_i32x4_fill(7, destination, -1) ||
        destination[0] != 3 ||
        !lstd_i32x4_fill(7, destination, 4) ||
        destination[0] != 7 || destination[1] != 7 ||
        destination[2] != 7 || destination[3] != 7) { return 9; }
    if (lstd_i32x4_reverse_into(values, destination, 0) ||
        destination[0] != 7 ||
        !lstd_i32x4_reverse_into(values, destination, 4) ||
        destination[0] != 8 || destination[1] != 3 ||
        destination[2] != -1 || destination[3] != 3) { return 10; }
    if (!lstd_i32x4_reverse_into(values, values, 4) ||
        values[0] != 8 || values[1] != 3 ||
        values[2] != -1 || values[3] != 3) { return 11; }
    return 0;
}
