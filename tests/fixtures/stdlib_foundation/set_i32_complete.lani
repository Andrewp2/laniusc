module app::main;
import std::set_i32;

fn main() -> i32 {
    let value: std::set_i32::SetI32 = std::set_i32::new();
    if (std::set_i32::MAX_CAPACITY != 536870911 ||
        !std::set_i32::is_empty(value) ||
        std::set_i32::len(value) != 0 ||
        std::set_i32::capacity(value) != 0 ||
        std::set_i32::contains(value, 0) ||
        std::set_i32::at_or(value, 0, 91) != 91) { return 1; }

    value = std::set_i32::try_reserve(value, 3);
    if (std::set_i32::capacity(value) != 3) { return 2; }
    value = std::set_i32::try_reserve(value, -1);
    value = std::set_i32::try_reserve(value, 536870912);
    if (std::set_i32::capacity(value) != 3) { return 3; }

    value = std::set_i32::try_insert(value, 0);
    value = std::set_i32::try_insert(value, -2147483648);
    value = std::set_i32::try_insert(value, 2147483647);
    if (std::set_i32::len(value) != 3 ||
        std::set_i32::is_empty(value) ||
        !std::set_i32::contains(value, 0) ||
        !std::set_i32::contains(value, -2147483648) ||
        !std::set_i32::contains(value, 2147483647) ||
        std::set_i32::contains(value, 42) ||
        std::set_i32::at_or(value, 0, 91) != 0 ||
        std::set_i32::at_or(value, 1, 91) != -2147483648 ||
        std::set_i32::at_or(value, 2, 91) != 2147483647 ||
        std::set_i32::at_or(value, -1, 91) != 91 ||
        std::set_i32::at_or(value, 3, 91) != 91) { return 4; }

    value = std::set_i32::try_insert(value, 0);
    if (std::set_i32::len(value) != 3) { return 5; }
    let copy: std::set_i32::SetI32 = std::set_i32::try_clone(value);
    if (std::set_i32::len(copy) != 3 ||
        std::set_i32::capacity(copy) != 3 ||
        std::set_i32::at_or(copy, 1, 91) != -2147483648) { return 6; }
    copy = std::set_i32::try_remove(copy, 0);
    if (std::set_i32::len(copy) != 2 ||
        std::set_i32::contains(copy, 0) ||
        !std::set_i32::contains(value, 0) ||
        std::set_i32::at_or(copy, 0, 91) != -2147483648) { return 7; }
    std::set_i32::destroy(copy);

    value = std::set_i32::try_remove(value, -2147483648);
    if (std::set_i32::len(value) != 2 ||
        std::set_i32::capacity(value) != 3 ||
        std::set_i32::at_or(value, 1, 91) != 2147483647) { return 8; }
    value = std::set_i32::try_remove(value, 42);
    if (std::set_i32::len(value) != 2) { return 9; }
    value = std::set_i32::try_shrink_to_fit(value);
    if (std::set_i32::capacity(value) != 2 ||
        std::set_i32::at_or(value, 0, 91) != 0 ||
        std::set_i32::at_or(value, 1, 91) != 2147483647) { return 10; }

    value = std::set_i32::try_insert(value, 17);
    if (std::set_i32::len(value) != 3 ||
        std::set_i32::at_or(value, 2, 91) != 17) { return 11; }
    value = std::set_i32::clear(value);
    if (!std::set_i32::is_empty(value) ||
        std::set_i32::contains(value, 17) ||
        std::set_i32::capacity(value) != 4) { return 12; }
    let empty_copy: std::set_i32::SetI32 = std::set_i32::try_clone(value);
    if (std::set_i32::len(empty_copy) != 0 ||
        std::set_i32::capacity(empty_copy) != 0) { return 13; }
    std::set_i32::destroy(empty_copy);
    value = std::set_i32::try_shrink_to_fit(value);
    if (std::set_i32::capacity(value) != 0) { return 14; }
    std::set_i32::destroy(value);
    return 0;
}
