// Checked code-point conversion into char across returns, calls, locals,
// fields, enum payloads and raw cells, and char-to-integer casts back out.
module app::main;
import core::char;
import core::mem;

struct Holder { value: char }
enum MaybeChar { Some(char), None }

fn from_signed(value: i32) -> char { return core::char::from_u32_or(value as u32, 'x'); }
fn from_unsigned(value: u32) -> char { return core::char::from_u32_or(value, 'x'); }
fn is_omega(value: char) -> bool { return value == 'Ω'; }

fn main() -> i32 {
    let omega_code: i32 = 937;
    let omega: char = from_signed(omega_code);
    if (omega != 'Ω' || !is_omega(from_signed(omega_code)) ||
        (omega as i32) != omega_code) { return 1; }
    let face_code: u32 = 128512;
    let face: char = from_unsigned(face_code);
    if (face != '😀' || (face as u32) != face_code) { return 2; }
    if (!core::char::is_ascii_digit(from_signed(53)) ||
        core::char::is_ascii_digit(omega)) { return 3; }
    let held: Holder = Holder { value: from_signed(omega_code) };
    if (held.value != 'Ω') { return 4; }
    let tagged: MaybeChar = Some(from_unsigned(face_code));
    let extracted: char = match (tagged) { Some(value) -> value, None -> 'x' };
    if (extracted != '😀') { return 5; }
    let cells: [i32; 1] = [0];
    let address: ptr = core::mem::i32_array_data_ptr(cells);
    let view: [i32] = core::mem::i32_slice_from_raw_parts(address, 1);
    view[0] = 128512;
    let from_cell: char = from_signed(view[0]);
    if (from_cell != '😀') { return 6; }
    let surrogate: u32 = 57343;
    let all_bits: u32 = 4294967295;
    if (from_unsigned(surrogate) != 'x' || from_unsigned(all_bits) != 'x' ||
        from_signed(-1) != 'x') { return 7; }
    let byte: u8 = 233;
    if ((byte as char) != 'é' || from_unsigned(1114111) as u32 != 1114111) { return 8; }
    return 0;
}
