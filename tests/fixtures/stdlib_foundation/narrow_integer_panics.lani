    if (kind == 1 && operation == 8) { let unused: u8 = core::u8::next_power_of_two(core::u8::MAX); return 0; }
    if (kind == 1 && operation == 9) { let unused: u8 = core::u8::div_euclid(1,0); return 0; }
    if (kind == 1 && operation == 10) { let unused: u8 = core::u8::rem_euclid(1,0); return 0; }
    if (kind == 1 && operation == 11) { let unused: u8 = core::u8::align_up(1,0); return 0; }
    if (kind == 1 && operation == 12) { let unused: u8 = core::u8::align_down(1,0); return 0; }
    if (kind == 1 && operation == 13) { let unused: u8 = core::u8::align_up(core::u8::MAX,2); return 0; }
    if (kind == 2 && operation == 0) { let unused: i16 = core::i16::clamp(0,1,0); return 0; }
