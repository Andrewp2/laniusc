import core::mem;
import std::io_checked;
fn main() -> i32 {
    let words: [i32;2] = [0;2]; let pointer: ptr = core::mem::i32_array_data_ptr(words);
    if (!std::io_checked::read_exact_stdin(pointer,8)) { return 1; }
    let kind: i32 = words[0]; let operation: i32 = words[1];
    if (kind == 0 && operation == 0) { let unused: i8 = core::i8::clamp(0,1,0); return 0; }
    if (kind == 0 && operation == 1) { let unused: i8 = core::i8::div(1,0); return 0; }
    if (kind == 0 && operation == 2) { let unused: i8 = core::i8::rem(1,0); return 0; }
