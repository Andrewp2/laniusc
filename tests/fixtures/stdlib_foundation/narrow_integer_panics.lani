    if (kind == 3 && operation == 3) { let unused: u16 = core::u16::wrapping_div(1,0); return 0; }
    if (kind == 3 && operation == 4) { let unused: u16 = core::u16::wrapping_rem(1,0); return 0; }
    if (kind == 3 && operation == 5) { let unused: u16 = core::u16::saturating_div(1,0); return 0; }
    if (kind == 3 && operation == 6) { let unused: u16 = core::u16::shl(1,16); return 0; }
    if (kind == 3 && operation == 7) { let unused: u16 = core::u16::shr(1,16); return 0; }
    if (kind == 3 && operation == 8) { let unused: u16 = core::u16::next_power_of_two(core::u16::MAX); return 0; }
    if (kind == 3 && operation == 9) { let unused: u16 = core::u16::div_euclid(1,0); return 0; }
    if (kind == 3 && operation == 10) { let unused: u16 = core::u16::rem_euclid(1,0); return 0; }
