    if (kind == 4 && operation == 6) { let unused: i32 = core::i32::shl(1,32); return 0; }
    if (kind == 4 && operation == 7) { let unused: i32 = core::i32::shr(1,32); return 0; }
    if (kind == 4 && operation == 8) { let unused: i32 = core::i32::next_power_of_two(core::i32::MAX); return 0; }
    if (kind == 4 && operation == 9) { let unused: i32 = core::i32::div_euclid(1,0); return 0; }
    if (kind == 4 && operation == 10) { let unused: i32 = core::i32::rem_euclid(1,0); return 0; }
    if (kind == 4 && operation == 11) { let unused: i32 = core::i32::abs(core::i32::MIN); return 0; }
    if (kind == 4 && operation == 12) { let unused: i32 = core::i32::div(core::i32::MIN,-1); return 0; }
    if (kind == 4 && operation == 13) { let unused: i32 = core::i32::rem(core::i32::MIN,-1); return 0; }
    if (kind == 4 && operation == 14) { let unused: i32 = core::i32::div_euclid(core::i32::MIN,-1); return 0; }
    if (kind == 4 && operation == 15) { let unused: i32 = core::i32::rem_euclid(core::i32::MIN,-1); return 0; }
    if (kind == 5 && operation == 0) { let unused: u32 = core::u32::clamp(0,1,0); return 0; }
    if (kind == 5 && operation == 1) { let unused: u32 = core::u32::div(1,0); return 0; }
    if (kind == 5 && operation == 2) { let unused: u32 = core::u32::rem(1,0); return 0; }
    if (kind == 5 && operation == 3) { let unused: u32 = core::u32::wrapping_div(1,0); return 0; }
    if (kind == 5 && operation == 4) { let unused: u32 = core::u32::wrapping_rem(1,0); return 0; }
    if (kind == 5 && operation == 5) { let unused: u32 = core::u32::saturating_div(1,0); return 0; }
    if (kind == 5 && operation == 6) { let unused: u32 = core::u32::shl(1,32); return 0; }
    if (kind == 5 && operation == 7) { let unused: u32 = core::u32::shr(1,32); return 0; }
    if (kind == 5 && operation == 8) { let unused: u32 = core::u32::next_power_of_two(core::u32::MAX); return 0; }
    if (kind == 5 && operation == 9) { let unused: u32 = core::u32::div_euclid(1,0); return 0; }
    if (kind == 5 && operation == 10) { let unused: u32 = core::u32::rem_euclid(1,0); return 0; }
    if (kind == 5 && operation == 11) { let unused: u32 = core::u32::align_up(1,0); return 0; }
    if (kind == 5 && operation == 12) { let unused: u32 = core::u32::align_down(1,0); return 0; }
    if (kind == 5 && operation == 13) { let unused: u32 = core::u32::align_up(core::u32::MAX,2); return 0; }
    return 2;
