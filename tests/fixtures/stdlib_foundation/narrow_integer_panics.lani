    if (kind == 0 && operation == 6) { let unused: i8 = core::i8::shl(1,8); return 0; }
    if (kind == 0 && operation == 7) { let unused: i8 = core::i8::shr(1,8); return 0; }
    if (kind == 0 && operation == 8) { let unused: i8 = core::i8::next_power_of_two(core::i8::MAX); return 0; }
    if (kind == 0 && operation == 9) { let unused: i8 = core::i8::div_euclid(1,0); return 0; }
