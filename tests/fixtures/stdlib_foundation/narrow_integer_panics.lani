    if (kind == 0 && operation == 12) { let unused: i8 = core::i8::div(core::i8::MIN,-1); return 0; }
    if (kind == 0 && operation == 13) { let unused: i8 = core::i8::rem(core::i8::MIN,-1); return 0; }
    if (kind == 0 && operation == 14) { let unused: i8 = core::i8::div_euclid(core::i8::MIN,-1); return 0; }
    if (kind == 0 && operation == 15) { let unused: i8 = core::i8::rem_euclid(core::i8::MIN,-1); return 0; }
    if (kind == 1 && operation == 0) { let unused: u8 = core::u8::clamp(0,1,0); return 0; }
