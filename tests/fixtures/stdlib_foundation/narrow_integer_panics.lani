    if (kind == 2 && operation == 14) { let unused: i16 = core::i16::div_euclid(core::i16::MIN,-1); return 0; }
    if (kind == 2 && operation == 15) { let unused: i16 = core::i16::rem_euclid(core::i16::MIN,-1); return 0; }
    if (kind == 3 && operation == 0) { let unused: u16 = core::u16::clamp(0,1,0); return 0; }
    if (kind == 3 && operation == 1) { let unused: u16 = core::u16::div(1,0); return 0; }
