module app::main;
import std::vec_u8;

fn main() -> i32 {
    let first: u8 = 128;
    let second: u8 = 1;
    let third: u8 = 255;
    let fallback: u8 = 0;
    let additions: [u8; 2] = [second, third];
    let value: std::vec_u8::VecU8 = std::vec_u8::try_with_capacity(1);
    if (std::vec_u8::capacity(value) != 1) { return 2; }
    value = std::vec_u8::try_push(value, first);
    if (std::vec_u8::len(value) != 1) { return 3; }
    value = std::vec_u8::try_extend_from_slice(value, additions, 2);
    if (std::vec_u8::len(value) == 3) {
        if (std::vec_u8::get_or(value, 0, fallback) != first ||
            std::vec_u8::get_or(value, 1, fallback) != second ||
            std::vec_u8::get_or(value, 2, fallback) != third) { return 6; }
        std::vec_u8::destroy(value);
        return 4;
    }
    if (std::vec_u8::len(value) != 1 ||
        std::vec_u8::capacity(value) != 1 ||
        std::vec_u8::get_or(value, 0, fallback) != first) { return 5; }
    std::vec_u8::destroy(value);
    return 0;
}
