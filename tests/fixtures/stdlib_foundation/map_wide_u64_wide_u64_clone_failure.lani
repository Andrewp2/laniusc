module app::main;
import core::wide_u64;
import std::map_wide_u64_wide_u64;
fn same(left: core::wide_u64::WideU64, right: core::wide_u64::WideU64) -> bool {
    return core::wide_u64::eq(left, right);
}
fn main() -> i32 {
    let key: core::wide_u64::WideU64 = core::wide_u64::from_words(2147483648, 7);
    let other: core::wide_u64::WideU64 = core::wide_u64::from_words(1, 7);
    let item: core::wide_u64::WideU64 = core::wide_u64::max_value();
    let fallback: core::wide_u64::WideU64 = core::wide_u64::zero();
    let value: std::map_wide_u64_wide_u64::MapWideU64WideU64 = std::map_wide_u64_wide_u64::try_insert(std::map_wide_u64_wide_u64::new(), key, item);
    if (std::map_wide_u64_wide_u64::len(value) != 1) { return 2; }
    let copy: std::map_wide_u64_wide_u64::MapWideU64WideU64 = std::map_wide_u64_wide_u64::try_clone(value);
    if (std::map_wide_u64_wide_u64::len(copy) == 0 &&
        std::map_wide_u64_wide_u64::capacity(copy) == 0 &&
        same(std::map_wide_u64_wide_u64::get_or(value, key, fallback), item)) {
        std::map_wide_u64_wide_u64::destroy(copy);
        std::map_wide_u64_wide_u64::destroy(value);
        return 0;
    }
    if (std::map_wide_u64_wide_u64::len(copy) == 1 &&
        same(std::map_wide_u64_wide_u64::get_or(copy, key, fallback), item) &&
        same(std::map_wide_u64_wide_u64::get_or(value, key, fallback), item)) {
        std::map_wide_u64_wide_u64::destroy(copy);
        std::map_wide_u64_wide_u64::destroy(value);
        return 4;
    }
    std::map_wide_u64_wide_u64::destroy(copy);
    std::map_wide_u64_wide_u64::destroy(value);
    return 5;
}
