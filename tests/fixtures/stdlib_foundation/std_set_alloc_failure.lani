module app::main;
import std::set;

fn main() -> i32 {
    let value: std::set::Set<i32> = std::set::new();
    value = std::set::try_insert(value, 41);
    if (std::set::len(value) == 0 &&
        std::set::capacity(value) == 0 &&
        !std::set::contains(value, 41)) {
        std::set::destroy(value);
        return 0;
    }
    if (std::set::len(value) == 1 &&
        std::set::contains(value, 41)) {
        std::set::destroy(value);
        return 4;
    }
    std::set::destroy(value);
    return 5;
}
