module app::main;
import std::vec_bool;

fn main() -> i32 {
    let first: bool = true;
    let second: bool = false;
    let third: bool = true;
    let fallback: bool = false;
    let additions: [bool; 2] = [second, third];
    let value: std::vec_bool::VecBool = std::vec_bool::try_with_capacity(1);
    if (std::vec_bool::capacity(value) != 1) { return 2; }
    value = std::vec_bool::try_push(value, first);
    if (std::vec_bool::len(value) != 1) { return 3; }
    value = std::vec_bool::try_extend_from_slice(value, additions, 2);
    if (std::vec_bool::len(value) == 3) {
        if (std::vec_bool::get_or(value, 0, fallback) != first ||
            std::vec_bool::get_or(value, 1, fallback) != second ||
            std::vec_bool::get_or(value, 2, fallback) != third) { return 6; }
        std::vec_bool::destroy(value);
        return 4;
    }
    if (std::vec_bool::len(value) != 1 ||
        std::vec_bool::capacity(value) != 1 ||
        std::vec_bool::get_or(value, 0, fallback) != first) { return 5; }
    std::vec_bool::destroy(value);
    return 0;
}
