module app::main;
import core::slice;

fn main() -> i32 {
    let zero_byte: i8 = 0;
    let zero_halfword: i16 = 0;
    let bytes: [i8; 5] = [zero_byte, zero_byte, zero_byte, zero_byte, zero_byte];
    let halfwords: [i16; 5] = [zero_halfword, zero_halfword, zero_halfword, zero_halfword, zero_halfword];
    let code: i32 = 0;
    while (code < 243) {
        let digits: i32 = code;
        let negative_count: i32 = 0;
        let zero_count: i32 = 0;
        let index: i32 = 0;
        while (index < 5) {
            let digit: i32 = digits % 3;
            digits = digits / 3;
            let byte_digit: i8 = -1;
            let halfword_digit: i16 = -1;
            if (digit == 1) {
                byte_digit = 0;
                halfword_digit = 0;
                zero_count += 1;
            }
            if (digit == 2) {
                byte_digit = 1;
                halfword_digit = 1;
            }
            if (digit == 0) { negative_count += 1; }
            bytes[index] = byte_digit;
            halfwords[index] = halfword_digit;
            index += 1;
        }
        if (core::slice::sort(bytes, 5) != 5 ||
            core::slice::sort(halfwords, 5) != 5) { return 1; }
        index = 0;
        while (index < 5) {
            let expected_byte: i8 = 1;
            let expected_halfword: i16 = 1;
            if (index < negative_count) {
                expected_byte = -1;
                expected_halfword = -1;
            } else {
                if (index < negative_count + zero_count) {
                    expected_byte = 0;
                    expected_halfword = 0;
                }
            }
            if (bytes[index] != expected_byte ||
                halfwords[index] != expected_halfword) { return 2; }
            index += 1;
        }
        code += 1;
    }
    return 0;
}
