module app::main;
import std::utf8_vec;
import std::vec_u8;

fn main() -> i32 {
    let a: u8 = 65;
    let c2: u8 = 194;
    let a2: u8 = 162;
    let e2: u8 = 226;
    let cont82: u8 = 130;
    let ac: u8 = 172;
    let f0: u8 = 240;
    let cont9f: u8 = 159;
    let cont99: u8 = 153;
    let valid: [u8; 10] = [a, c2, a2, e2, cont82, ac, f0, cont9f, cont99, cont82];
    let text: std::vec_u8::VecU8 = std::utf8_vec::new();
    text = std::utf8_vec::try_append_bytes(text, valid, 10);
    if (std::utf8_vec::byte_len(text) != 10 ||
        std::utf8_vec::scalar_count_or(text, -9) != 4 ||
        std::utf8_vec::scalar_at_or(text, 0, 4294967295) != 65 ||
        std::utf8_vec::scalar_at_or(text, 1, 4294967295) != 162 ||
        std::utf8_vec::scalar_at_or(text, 2, 4294967295) != 8364 ||
        std::utf8_vec::scalar_at_or(text, 3, 4294967295) != 128578) { return 1; }

    let low: u8 = 128;
    let malformed: [u8; 2] = [a, low];
    let truncated: [u8; 2] = [e2, cont82];
    text = std::utf8_vec::try_append_bytes(text, valid, 0);
    text = std::utf8_vec::try_append_bytes(text, valid, -1);
    text = std::utf8_vec::try_append_bytes(text, malformed, 2);
    text = std::utf8_vec::try_append_bytes(text, truncated, 2);
    text = std::utf8_vec::try_append_bytes(text, valid, 4);
    if (std::utf8_vec::byte_len(text) != 10 ||
        std::utf8_vec::scalar_count_or(text, -9) != 4 ||
        std::vec_u8::get_or(text, 9, 0) != cont82) { return 2; }

    text = std::utf8_vec::try_append_bytes(text, valid, 3);
    if (std::utf8_vec::byte_len(text) != 13 ||
        std::utf8_vec::scalar_count_or(text, -9) != 6 ||
        std::utf8_vec::scalar_at_or(text, 5, 4294967295) != 162) { return 3; }

    let invalid: std::vec_u8::VecU8 = std::vec_u8::new();
    invalid = std::vec_u8::try_push(invalid, a);
    invalid = std::vec_u8::try_push(invalid, low);
    invalid = std::utf8_vec::try_append_bytes(invalid, valid, 3);
    if (std::utf8_vec::byte_len(invalid) != 2 ||
        std::vec_u8::get_or(invalid, 0, 0) != a ||
        std::vec_u8::get_or(invalid, 1, 0) != low) { return 4; }
    std::utf8_vec::destroy(invalid);
    std::utf8_vec::destroy(text);
    return 0;
}
