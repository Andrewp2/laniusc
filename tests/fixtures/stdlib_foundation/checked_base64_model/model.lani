// Test-only checked Base64 profile, wire and whole-backing adapter.
module app::main;

import core::mem;
import core::option;
import core::base64;
import core::result;
import core::slice;
import std::io;

fn read_exact(pointer: ptr, count: i32, allow_eof: bool) -> bool {
    let done: i32 = 0;
    while (done < count) {
        let got: i32 = std::io::read_stdin(pointer + (done as usize), (count - done) as usize);
        assert(got >= 0);
        if (got == 0) { assert(allow_eof && done == 0); return false; }
        done += got;
    }
    return true;
}

fn write_all(pointer: ptr, count: i32) {
    let done: i32 = 0;
    while (done < count) {
        let got: i32 = std::io::write_stdout(pointer + (done as usize), (count - done) as usize);
        assert(got > 0);
        done += got;
    }
}

fn get64(bytes: [u8], offset: i32) -> u64 {
    let result: u64 = 0;
    let index: i32 = 0;
    while (index < 8) {
        result |= (bytes[offset + index] as u64) << (index * 8);
        index += 1;
    }
    return result;
}

struct Output { bytes: [u8], pointer: ptr, used: i32 }
impl Output {
    fn borrow(&self) -> &Output { return self; }
    fn flush(&self) { write_all(self.pointer, self.used); self.used = 0; }
    fn word(&self, value: u64) {
        if (self.used == 4096) { self.flush(); }
        let index: i32 = 0;
        while (index < 8) {
            self.bytes[self.used + index] = ((value >> (index * 8)) & 255) as u8;
            index += 1;
        }
        self.used += 8;
    }
}

fn profile(code: u64) -> core::base64::Profile {
    return match (code) {
        0 -> core::base64::Profile::Standard,
        1 -> core::base64::Profile::StandardUnpadded,
        2 -> core::base64::Profile::UrlSafe,
        _ -> core::base64::Profile::UrlSafeUnpadded,
    };
}

fn error_code(error: core::base64::Error) -> u64 {
    return match (error) {
        core::base64::Error::Bounds -> 1,
        core::base64::Error::LengthOverflow -> 2,
        core::base64::Error::InvalidLength -> 3,
        core::base64::Error::InvalidByte(index) -> 4,
        core::base64::Error::InvalidPadding(index) -> 5,
        core::base64::Error::NonCanonical(index) -> 6,
        core::base64::Error::BufferTooSmall(count) -> 7,
    };
}

fn error_payload(error: core::base64::Error) -> i32 {
    return match (error) {
        core::base64::Error::InvalidByte(index) -> index,
        core::base64::Error::InvalidPadding(index) -> index,
        core::base64::Error::NonCanonical(index) -> index,
        core::base64::Error::BufferTooSmall(count) -> count,
        _ -> 0,
    };
}

fn run(input: [u8], output: &Output) {
    let operation: u64 = get64(input, 0);
    let kind: core::base64::Profile = profile(get64(input, 8));
    let layout: u64 = get64(input, 16);
    let alias: u64 = get64(input, 24);
    let source_native: [u8; 80] = [0; 80];
    let target_native: [u8; 80] = [0; 80];
    let source_words: [i32; 20] = [0; 20];
    let target_words: [i32; 20] = [0; 20];
    let source: [u8] = source_native;
    let target: [u8] = target_native;
    if ((layout & 1) != 0) {
        source = core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(source_words), 80);
    }
    if ((layout & 2) != 0) {
        target = core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(target_words), 80);
    }
    if ((layout & 1) == 0) { assert(core::mem::slice_stride(source) < 0); }
    else { assert(core::mem::slice_stride(source) == 1); }
    if ((layout & 2) == 0) { assert(core::mem::slice_stride(target) < 0); }
    else { assert(core::mem::slice_stride(target) == 1); }
    let index: i32 = 0;
    while (index < 80) {
        source[index] = (64 + index) as u8;
        target[index] = (160 + index) as u8;
        index += 1;
    }
    index = 0;
    while (index < get64(input, 80) as i32) {
        source[get64(input, 72) as i32 + index] = get64(input, 96 + index * 8) as u8;
        index += 1;
    }
    if (alias == 1) { target = source; }
    let source_view: core::slice::View<u8> = core::slice::View {
        values: source, start: get64(input, 32) as i32, length: get64(input, 40) as i32
    };
    let target_view: core::slice::View<u8> = core::slice::View {
        values: target, start: get64(input, 48) as i32, length: get64(input, 56) as i32
    };
    let result: core::result::Result<i32, core::base64::Error> = core::result::Ok(0);
    if (operation == 0) { result = core::base64::encoded_len(get64(input, 64) as i32, kind); }
    if (operation == 1) { result = core::base64::decoded_len(source_view, kind); }
    if (operation == 2) { result = core::base64::encode_into(source_view, target_view, kind); }
    if (operation == 3) { result = core::base64::decode_into(source_view, target_view, kind); }
    let tag: u64 = 0;
    let error: u64 = 0;
    let payload: i32 = 0;
    let written: i32 = 0;
    if (result.is_ok()) { written = result.unwrap(); }
    else {
        let cause: core::base64::Error = result.unwrap_err();
        tag = 1; error = error_code(cause); payload = error_payload(cause);
    }
    output.word(operation); output.word(get64(input, 8)); output.word(layout); output.word(alias);
    output.word(tag); output.word(error); output.word(payload as i64 as u64); output.word(written as i64 as u64);
    output.word(core::mem::slice_stride(source) as u64); output.word(core::mem::slice_stride(target) as u64);
    index = 0;
    while (index < 80) { output.word(source[index] as u64); index += 1; }
    index = 0;
    while (index < 80) { output.word(target[index] as u64); index += 1; }
}

fn main() -> i32 {
    let input_words: [i32; 160] = [0; 160];
    let input_pointer: ptr = core::mem::i32_array_data_ptr(input_words);
    let input: [u8] = core::mem::typed_slice_from_raw_parts<u8>(input_pointer, 640);
    let output_words: [i32; 1024] = [0; 1024];
    let output_pointer: ptr = core::mem::i32_array_data_ptr(output_words);
    let output_bytes: [u8] = core::mem::typed_slice_from_raw_parts<u8>(output_pointer, 4096);
    let output: Output = Output { bytes: output_bytes, pointer: output_pointer, used: 0 };
    while (read_exact(input_pointer, 96, true)) {
        assert(get64(input, 0) <= 3 && get64(input, 8) <= 3 && get64(input, 16) <= 3 && get64(input, 24) <= 1);
        assert(get64(input, 80) <= 68 && get64(input, 72) <= 80 - get64(input, 80));
        assert(read_exact(input_pointer + 96, (get64(input, 80) * 8) as i32, false));
        run(input, output.borrow());
    }
    output.flush();
    return 0;
}
