module app::main;
import core::transcode;

fn main() -> i32 {
    let a: u8 = 65;
    let source: [u8; 1] = [a];
    let zero: u8 = 0;
    let output: [u8; 4] = [zero, zero, zero, zero];
    let result: core::transcode::TranscodeResult =
        core::transcode::utf8_to_utf16le(source, 2, output, 4);
    if (core::transcode::succeeded(result)) { return 1; }
    return 2;
}
