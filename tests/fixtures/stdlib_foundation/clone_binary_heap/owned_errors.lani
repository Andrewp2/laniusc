module app::main;
import alloc::binary_heap;
import alloc::clone_binary_heap;
import alloc::string;
import core::result;
import fixture::types;
import std::vec;

fn inspect(fault: fixture::types::Fault, index: i32, expected_index: i32, id: i32, stage: i32) -> i32 {
    return match(fault) { fixture::types::Fault::Allocation(value) -> 4, fixture::types::Fault::Injected(found_id,found_stage,message) -> message_result(message,index,expected_index,found_id,id,found_stage,stage) };
}
fn message_result(message: alloc::string::String, index: i32, expected_index: i32, id: i32, expected_id: i32, stage: i32, expected_stage: i32) -> i32 {
    let correct: bool = index==expected_index && id==expected_id && stage==expected_stage && message.byte_len()==5 && message.byte_at(0).unwrap()==69 && message.byte_at(1).unwrap()==0 && message.byte_at(2).unwrap()==(48+id) as u8 && message.byte_at(3).unwrap()==(48+stage) as u8 && message.byte_at(4).unwrap()==85;
    message.destroy(); if (!correct) { return 1; } return 0;
}
fn check(error: alloc::clone_binary_heap::Error<fixture::types::Fault>, index: i32, id: i32, stage: i32) -> i32 {
    return match(error) { alloc::clone_binary_heap::Error::Storage(value) -> 4, alloc::clone_binary_heap::Error::Element(found,fault) -> inspect(fault,found,index,id,stage) };
}
fn run(order: alloc::binary_heap::Order, physical: i32, stage: i32) -> i32 {
    let bytes: [u8;4] = [83,0,195,169]; let made = alloc::string::from_utf8(bytes,4);
    if (made.is_err()) { return 4; } let original: alloc::string::String = made.unwrap();
    let allocated = alloc::binary_heap::with_capacity<fixture::types::Leaf>(4,order);
    if (allocated.is_err()) { original.destroy(); return 4; }
    let initial = allocated.unwrap(); let keys: [i32;4] = [2,-1,2,0]; let index: i32 = 0;
    while (index<4) { initial.try_push(fixture::types::Leaf { priority:keys[index],id:index+1,fail:-1,text:original }).unwrap(); index+=1; }
    // Transfer first; never mutate a borrowed heap view or a priority field.
    let items: std::vec::Vec<fixture::types::Leaf> = initial.take_vec();
    let selected: fixture::types::Leaf = std::vec::at(items,physical);
    items = std::vec::try_set(items,physical,fixture::types::Leaf { priority:selected.priority,id:selected.id,fail:stage,text:original });
    let source: alloc::binary_heap::BinaryHeap<fixture::types::Leaf> = alloc::binary_heap::from_vec<fixture::types::Leaf>(items,order);
    let expected: i32 = -1; let view = source.as_view(); index=0;
    while (index<4) { if (view.get(index).unwrap().id==selected.id) { expected=index; } index+=1; }
    assert(expected>=0 && expected<4 && initial.is_empty() && initial.capacity()==0);
    let result = alloc::clone_binary_heap::try_clone<fixture::types::Leaf,fixture::types::Fault>(source.borrow());
    assert(source.len()==4 && source.capacity()==4 && original.byte_len()==4 && original.byte_at(1).unwrap()==0 && view.get(expected).unwrap().fail==stage);
    // E is retained while both the failed destination prefix and every source
    // allocation are released. Only inspect/release its message afterward.
    source.destroy(); initial.destroy(); original.destroy();
    if (result.is_ok()) { let unexpected=result.unwrap(); alloc::clone_binary_heap::destroy_heap<fixture::types::Leaf>(unexpected.borrow()); return 1; }
    return check(result.unwrap_err(),expected,selected.id,stage);
}
fn main() -> i32 {
    let order: i32 = 0;
    while (order<2) {
        let selected: alloc::binary_heap::Order = alloc::binary_heap::Order::Min; if (order==1) { selected=alloc::binary_heap::Order::Max; }
        let index: i32 = 0;
        while (index<4) { let stage: i32 = 0; while (stage<2) { let status: i32 = run(selected,index,stage); if (status!=0) { return status; } stage+=1; } index+=1; }
        order+=1;
    }
    return 0;
}
