module app::main;
import std::vec_i32;

fn main() -> i32 {
    let first: i32 = -42;
    let last: i32 = 2147483647;
    let fallback: i32 = 0;
    let value: std::vec_i32::VecI32 = std::vec_i32::try_with_capacity(4);
    if (std::vec_i32::capacity(value) != 4) { return 2; }
    value = std::vec_i32::try_push(value, first);
    value = std::vec_i32::try_push(value, last);
    if (std::vec_i32::len(value) != 2) { return 3; }
    let copy: std::vec_i32::VecI32 = std::vec_i32::try_clone(value);
    if (std::vec_i32::len(copy) == 2) {
        std::vec_i32::destroy(copy);
        std::vec_i32::destroy(value);
        return 4;
    }
    if (std::vec_i32::len(copy) != 0 ||
        std::vec_i32::capacity(copy) != 0 ||
        std::vec_i32::len(value) != 2 ||
        std::vec_i32::capacity(value) != 4 ||
        std::vec_i32::get_or(value, 0, fallback) != first ||
        std::vec_i32::get_or(value, 1, fallback) != last) { return 5; }
    std::vec_i32::destroy(copy);
    std::vec_i32::destroy(value);
    return 0;
}
