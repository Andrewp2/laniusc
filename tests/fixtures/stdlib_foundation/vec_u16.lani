module app::main;
import std::vec_u16;

fn main() -> i32 {
    let zero: u16 = 0;
    let one: u16 = 1;
    let high_bit: u16 = 32768;
    let maximum: u16 = 65535;
    let fallback: u16 = 177;
    let value: std::vec_u16::VecU16 = std::vec_u16::new();
    let empty_edited: std::vec_u16::VecU16 = std::vec_u16::new();
    empty_edited = std::vec_u16::try_insert(empty_edited, 0, one);
    if (std::vec_u16::len(empty_edited) != 1 || std::vec_u16::capacity(empty_edited) != 4 ||
        std::vec_u16::get_or(empty_edited, 0, fallback) != one) { return 35; }
    empty_edited = std::vec_u16::try_remove(empty_edited, 0);
    if (std::vec_u16::len(empty_edited) != 0 || std::vec_u16::capacity(empty_edited) != 4) { return 36; }
    std::vec_u16::destroy(empty_edited);
    let empty_copy: std::vec_u16::VecU16 = std::vec_u16::try_clone(value);
    if (std::vec_u16::len(empty_copy) != 0 || std::vec_u16::capacity(empty_copy) != 0) { return 22; }
    std::vec_u16::destroy(empty_copy);
    if (std::vec_u16::len(value) != 0 ||
        std::vec_u16::capacity(value) != 0 ||
        !std::vec_u16::is_empty(value) ||
        std::vec_u16::get_or(value, 0, fallback) != fallback ||
        std::vec_u16::try_set(value, 0, maximum)) { return 1; }
    value = std::vec_u16::try_pop(value);
    if (std::vec_u16::len(value) != 0) { return 2; }

    value = std::vec_u16::try_push(value, zero);
    value = std::vec_u16::try_push(value, high_bit);
    value = std::vec_u16::try_push(value, maximum);
    value = std::vec_u16::try_push(value, one);
    if (std::vec_u16::len(value) != 4 ||
        std::vec_u16::capacity(value) != 4 ||
        std::vec_u16::get_or(value, 0, fallback) != zero ||
        std::vec_u16::get_or(value, 1, fallback) != high_bit ||
        std::vec_u16::get_or(value, 2, fallback) != maximum ||
        std::vec_u16::get_or(value, -1, fallback) != fallback ||
        std::vec_u16::get_or(value, 4, fallback) != fallback) { return 3; }
    value = std::vec_u16::try_push(value, high_bit);
    if (std::vec_u16::len(value) != 5 ||
        std::vec_u16::capacity(value) != 8 ||
        std::vec_u16::get_or(value, 4, fallback) != high_bit) { return 4; }
    let copy: std::vec_u16::VecU16 = std::vec_u16::try_clone(value);
    if (std::vec_u16::len(copy) != 5 || std::vec_u16::capacity(copy) != 5 ||
        std::vec_u16::get_or(copy, 1, fallback) != high_bit ||
        std::vec_u16::get_or(copy, 2, fallback) != maximum) { return 23; }
    if (!std::vec_u16::try_set(copy, 1, one) ||
        std::vec_u16::get_or(copy, 1, fallback) != one ||
        std::vec_u16::get_or(value, 1, fallback) != high_bit) { return 24; }
    std::vec_u16::destroy(copy);
    let edited: std::vec_u16::VecU16 = std::vec_u16::try_clone(value);
    edited = std::vec_u16::try_insert(edited, -1, one);
    edited = std::vec_u16::try_insert(edited, 6, one);
    edited = std::vec_u16::try_remove(edited, -1);
    edited = std::vec_u16::try_remove(edited, 5);
    if (std::vec_u16::len(edited) != 5 || std::vec_u16::capacity(edited) != 5 ||
        std::vec_u16::get_or(edited, 1, fallback) != high_bit) { return 30; }
    edited = std::vec_u16::try_insert(edited, 0, one);
    if (std::vec_u16::len(edited) != 6 || std::vec_u16::capacity(edited) != 10 ||
        std::vec_u16::get_or(edited, 0, fallback) != one ||
        std::vec_u16::get_or(edited, 1, fallback) != zero ||
        std::vec_u16::get_or(edited, 2, fallback) != high_bit) { return 31; }
    edited = std::vec_u16::try_insert(edited, 3, high_bit);
    if (std::vec_u16::len(edited) != 7 ||
        std::vec_u16::get_or(edited, 3, fallback) != high_bit ||
        std::vec_u16::get_or(edited, 4, fallback) != maximum) { return 32; }
    edited = std::vec_u16::try_insert(edited, 7, one);
    if (std::vec_u16::len(edited) != 8 ||
        std::vec_u16::get_or(edited, 7, fallback) != one ||
        std::vec_u16::get_or(edited, 6, fallback) != high_bit) { return 33; }
    edited = std::vec_u16::try_remove(edited, 0);
    edited = std::vec_u16::try_remove(edited, 2);
    edited = std::vec_u16::try_remove(edited, 5);
    if (std::vec_u16::len(edited) != 5 || std::vec_u16::capacity(edited) != 10 ||
        std::vec_u16::get_or(edited, 0, fallback) != zero ||
        std::vec_u16::get_or(edited, 1, fallback) != high_bit ||
        std::vec_u16::get_or(edited, 2, fallback) != maximum ||
        std::vec_u16::get_or(edited, 4, fallback) != high_bit ||
        std::vec_u16::get_or(value, 1, fallback) != high_bit) { return 34; }
    std::vec_u16::destroy(edited);
    if (std::vec_u16::try_set(value, -1, maximum) ||
        std::vec_u16::try_set(value, 5, maximum) ||
        !std::vec_u16::try_set(value, 1, maximum) ||
        std::vec_u16::get_or(value, 1, fallback) != maximum) { return 5; }

    value = std::vec_u16::try_reserve(value, -1);
    value = std::vec_u16::try_reserve(value, 536870912);
    value = std::vec_u16::try_reserve(value, 2);
    if (std::vec_u16::capacity(value) != 8) { return 6; }
    value = std::vec_u16::try_reserve(value, 11);
    if (std::vec_u16::capacity(value) != 11 ||
        std::vec_u16::get_or(value, 1, fallback) != maximum ||
        std::vec_u16::get_or(value, 4, fallback) != high_bit) { return 7; }
    value = std::vec_u16::try_pop(value);
    if (std::vec_u16::len(value) != 4 ||
        std::vec_u16::get_or(value, 4, fallback) != fallback) { return 8; }
    value = std::vec_u16::clear(value);
    if (std::vec_u16::len(value) != 0 ||
        std::vec_u16::capacity(value) != 11 ||
        !std::vec_u16::is_empty(value)) { return 9; }
    value = std::vec_u16::try_push(value, maximum);
    if (std::vec_u16::get_or(value, 0, fallback) != maximum) { return 10; }
    std::vec_u16::destroy(value);

    let preallocated: std::vec_u16::VecU16 = std::vec_u16::try_with_capacity(2);
    if (std::vec_u16::capacity(preallocated) != 2) { return 11; }
    preallocated = std::vec_u16::try_push(preallocated, high_bit);
    if (std::vec_u16::get_or(preallocated, 0, fallback) != high_bit) { return 12; }
    std::vec_u16::destroy(preallocated);
    let invalid: std::vec_u16::VecU16 = std::vec_u16::try_with_capacity(-1);
    if (std::vec_u16::capacity(invalid) != 0) { return 13; }
    std::vec_u16::destroy(invalid);
    if (std::vec_u16::MAX_CAPACITY != 536870911) { return 14; }
    return 0;
}
