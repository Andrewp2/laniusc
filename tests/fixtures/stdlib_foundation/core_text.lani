// expect: 0
module app::main;
import alloc::hash_map;
import alloc::string;
import core::cmp;
import core::byte;
import core::u8;
import core::char;
import core::decimal;
import core::hash;
import core::option;
import core::result;
import core::text;

fn invalid_at(bytes: [u8], start: i32, count: i32, expected: i32) -> bool {
    let checked: core::result::Result<core::text::Text, core::text::Error> = core::text::from_utf8_range(bytes, start, count);
    if (core::result::is_ok(checked)) { return false; }
    let correct: bool = match (core::result::unwrap_err(checked)) {
        core::text::Error::InvalidUtf8(at) -> at == expected,
        _ -> false,
    };
    return correct;
}
fn main() -> i32 {
    // A strided stack array, with invalid bytes outside the requested range.
    let bytes: [u8; 12] = [255, 32, 65, 195, 169, 240, 159, 153, 130, 0, 9, 255];
    let text: core::text::Text = core::result::unwrap(core::text::from_utf8_range(bytes, 1, 10));
    if (text.byte_len() != 10 || text.scalar_count() != 6 || text.is_empty()) { return 1; }
    if (core::option::is_some(text.byte_at(-1)) || core::option::is_some(text.byte_at(10))) { return 2; }
    if (core::option::unwrap(text.byte_at(9)) != 9 || !text.is_char_boundary(10) || text.is_char_boundary(3) ||
        text.is_char_boundary(-1) || text.is_char_boundary(11)) { return 3; }
    if (core::option::is_some(text.scalar_at_byte(3)) || core::option::is_some(text.scalar_at_byte(10)) ||
        core::option::unwrap(text.scalar_at_byte(4)) != 128578) { return 4; }
    let trimmed: core::text::Text = text.trim_ascii();
    if (trimmed.byte_len() != 8 || trimmed.scalar_count() != 4 || core::option::unwrap(trimmed.byte_at(7)) != 0) { return 5; }
    let middle: core::text::Text = core::result::unwrap(trimmed.slice(1, 7));
    if (middle.byte_len() != 6 || middle.scalar_count() != 2 || core::option::unwrap(middle.scalar_at_byte(0)) != 233) { return 6; }
    let boundary: core::text::Error = core::result::unwrap_err(text.slice(3, 4));
    let boundary_ok: bool = match (boundary) { core::text::Error::NotCharBoundary -> true, _ -> false };
    if (!boundary_ok || core::result::is_ok(text.slice(0, 11)) || core::result::is_ok(text.slice(4, 2))) { return 7; }
    if (core::result::is_ok(core::text::from_utf8_range(bytes, -1, 0)) ||
        core::result::is_ok(core::text::from_utf8_range(bytes, 2147483647, 1)) ||
        core::result::is_ok(core::text::from_utf8(bytes, -1))) { return 8; }
    if (!invalid_at(bytes, 3, 1, 0) || !invalid_at(bytes, 2, 2, 1)) { return 9; }
    let owned: alloc::string::String = core::result::unwrap(alloc::string::from_text(trimmed));
    let packed: core::text::Text = owned.as_text();
    if (!packed.equals(trimmed) || !core::text::Text::eq(packed, trimmed) || core::text::Text::ne(packed, trimmed) ||
        core::text::Text::hash(packed) != core::text::Text::hash(trimmed) ||
        core::text::Text::hash(packed) != alloc::string::String::hash(owned)) { return 10; }
    let prefix: core::text::Text = core::result::unwrap(packed.slice(0, 1));
    let suffix: core::text::Text = core::result::unwrap(packed.slice(7, 8));
    let empty: core::text::Text = core::result::unwrap(packed.slice(8, 8));
    if (!empty.is_empty() || empty.scalar_count() != 0 || !packed.starts_with(prefix) || !packed.ends_with(suffix) ||
        !packed.starts_with(empty) || !packed.ends_with(empty) || prefix.starts_with(packed) || suffix.ends_with(packed)) { return 11; }
    if (core::option::unwrap(packed.find(middle)) != 1 || core::option::unwrap(packed.rfind(middle)) != 1 ||
        core::option::unwrap(packed.find(empty)) != 0 || core::option::unwrap(packed.rfind(empty)) != 8 ||
        core::option::is_some(middle.find(packed)) || core::option::is_some(prefix.rfind(middle))) { return 12; }
    if (packed.compare(trimmed) != 0 || !core::text::Text::lt(prefix, packed) || !core::text::Text::le(prefix, packed) ||
        !core::text::Text::gt(packed, prefix) || !core::text::Text::ge(packed, packed)) { return 13; }
    let empty_owner: alloc::string::String = core::result::unwrap(alloc::string::from_text(empty));
    if (!empty_owner.is_empty() || empty_owner.capacity() != 0 || core::result::unwrap(empty_owner.try_append_text(empty)) != 0) { return 24; }
    empty_owner.destroy();
    let scalars: core::text::Scalars = middle.scalars();
    let scalar_copy: core::text::Scalars = scalars;
    let first: core::text::Scalar = core::option::unwrap(scalars.next());
    let second: core::text::Scalar = core::option::unwrap(scalars.next());
    if (core::option::unwrap(scalar_copy.next()).byte_index != 0 || core::option::unwrap(scalar_copy.next()).byte_index != 2) { return 25; }
    if (first.byte_index != 0 || first.value != 233 || second.byte_index != 2 || second.value != 128578 ||
        core::option::is_some(scalars.next()) || core::option::is_some(scalars.next())) { return 14; }
    let parts: core::text::Split = middle.split(empty);
    if (!core::option::unwrap(parts.next()).is_empty() || core::option::unwrap(parts.next()).byte_len() != 2 ||
        core::option::unwrap(parts.next()).byte_len() != 4 || !core::option::unwrap(parts.next()).is_empty() ||
        core::option::is_some(parts.next()) || core::option::is_some(parts.next())) { return 15; }
    let nonempty: core::text::Split = middle.split(middle);
    let split_copy: core::text::Split = nonempty;
    if (!core::option::unwrap(nonempty.next()).is_empty() || !core::option::unwrap(nonempty.next()).is_empty() ||
        core::option::is_some(nonempty.next()) || core::option::is_some(nonempty.next()) ||
        !core::option::unwrap(split_copy.next()).is_empty()) { return 26; }
    let no_text: core::text::Split = empty.split(empty);
    if (!core::option::unwrap(no_text.next()).is_empty() || !core::option::unwrap(no_text.next()).is_empty() ||
        core::option::is_some(no_text.next())) { return 16; }
    let map: alloc::hash_map::HashMap<core::text::Text, i32> = alloc::hash_map::new();
    if (core::result::is_err(map.try_insert(packed, 42)) || core::option::unwrap_or(map.get(trimmed), 0) != 42) { return 17; }
    map.destroy();
    // A subview remains readable during both growing and in-capacity append.
    if (core::result::unwrap(owned.try_append_text(middle)) != 14 || owned.scalar_count() != 6) { return 18; }
    core::result::unwrap(owned.try_reserve(40));
    let tail: core::text::Text = core::result::unwrap(owned.as_text().slice(8, 14));
    if (core::result::unwrap(owned.try_append_text(tail)) != 20 || owned.scalar_count() != 8) { return 19; }
    owned.destroy();
    let digits: [u8; 7] = [255, 43, 48, 49, 50, 51, 255];
    let number: core::text::Text = core::result::unwrap(core::text::from_utf8_range(digits, 1, 5));
    let unsigned: core::text::Text = core::result::unwrap(number.slice(1, 5));
    if (core::result::unwrap(number.parse_i8()) != 123 || core::result::unwrap(number.parse_i16()) != 123 ||
        core::result::unwrap(number.parse_i32()) != 123 || core::result::unwrap(unsigned.parse_u8()) != 123 ||
        core::result::unwrap(unsigned.parse_u16()) != 123 || core::result::unwrap(unsigned.parse_u32()) != 123) { return 20; }
    let trusted: core::text::Text = core::text::from_utf8_unchecked(digits, 2, 4);
    if (!trusted.equals(unsigned)) { return 21; }
    let ascii: i32 = 0;
    while (ascii <= 255) {
        let expected: bool = ascii == 32 || ascii == 9 || ascii == 10 || ascii == 11 || ascii == 12 || ascii == 13;
        if (core::byte::is_ascii_whitespace(ascii as u8) != expected || core::u8::is_ascii_whitespace(ascii as u8) != expected ||
            core::char::is_ascii_whitespace((ascii as u8) as char) != expected) { return 22; }
        ascii += 1;
    }
    let overflow: core::decimal::ParseError = core::result::unwrap_err(core::decimal::parse_i32_range(digits, 2147483647, 1));
    let bounds: bool = match (overflow.kind) { core::decimal::ParseErrorKind::Bounds -> true, _ -> false };
    if (!bounds || overflow.offset != -1 || core::result::is_ok(core::decimal::parse_u8_range(digits, -1, 1)) ||
        core::result::is_ok(core::decimal::parse_u32_range(digits, 1, -1))) { return 23; }
    return 0;
}
