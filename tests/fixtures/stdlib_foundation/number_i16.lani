    }
    if (core::number_i16::rem_or(-7, 3, fallback) != -1 || core::number_i16::rem_or(7, -3, fallback) != 1 || core::number_i16::rem_or(7, 0, fallback) != fallback || core::number_i16::rem_or(low, -1, fallback) != fallback) {
