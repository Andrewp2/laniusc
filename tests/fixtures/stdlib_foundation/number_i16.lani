        return 12;
    }
    if (!core::number_i16::is_zero(0) || core::number_i16::is_zero(1) || core::number_i16::signum(low) != -1 || core::number_i16::signum(0) != 0 || core::number_i16::signum(high) != 1) {
        return 13;
    }
    if (!core::number_i16::is_multiple_of(12, 3) || core::number_i16::is_multiple_of(13, 3) || core::number_i16::is_multiple_of(0, 0) || !core::number_i16::is_multiple_of(low, -1)) {
        return 14;
    }
    if (core::number_i16::div_or(-7, 3, fallback) != -2 || core::number_i16::div_or(7, -3, fallback) != -2 || core::number_i16::div_or(7, 0, fallback) != fallback || core::number_i16::div_or(low, -1, fallback) != fallback) {
