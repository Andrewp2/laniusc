        return 8;
    }
    if (core::number_i16::wrapping_add(2, 3) != 5 || core::number_i16::wrapping_add(high, 1) != low || core::number_i16::wrapping_add(low, -1) != high) {
        return 22;
    }
    if (core::number_i16::wrapping_sub(5, 2) != 3 || core::number_i16::wrapping_sub(low, 1) != high || core::number_i16::wrapping_sub(high, -1) != low) {
        return 23;
    }
    if (core::number_i16::wrapping_mul(-7, 9) != -63 || core::number_i16::wrapping_mul(high, 2) != -2 || core::number_i16::wrapping_mul(low, -1) != low || core::number_i16::wrapping_mul(256, 256) != 0) {
