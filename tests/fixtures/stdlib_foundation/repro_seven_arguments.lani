module app::main;
import core::args;
fn main() -> i32 {
    if (core::args::sum7(1, 2, 3, 4, 5, 6, 7) != 28) { return 1; }
    if (core::args::weighted8(1, 2, 3, 4, 5, 6, 7, 8) != 204) { return 2; }
    if (core::args::weighted9(1, 2, 3, 4, 5, 6, 7, 8, 9) != 285) { return 3; }
    if (core::args::weighted9(9, 8, 7, 6, 5, 4, 3, 2, 1) != 165) { return 4; }
    let repeats: i32 = 0;
    while (repeats < 600000) {
        if (core::args::sum7(repeats, 2, 3, 4, 5, 6, 7) != repeats + 27) {
            return 5;
        }
        repeats += 1;
    }
    return 0;
}
