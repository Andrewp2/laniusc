module app::main;
import std::deque_i8;

fn main() -> i32 {
    let value: std::deque_i8::DequeI8 = std::deque_i8::try_with_capacity(3);
    let failure: bool = std::deque_i8::capacity(value) == 0 && std::deque_i8::len(value) == 0;
    let success: bool = std::deque_i8::capacity(value) == 3 && std::deque_i8::len(value) == 0;
    std::deque_i8::destroy(value);
    if (failure) { return 0; }
    if (success) { return 4; }
    return 5;
}
