module app::main;
import core::transcode;
fn main() -> i32 {
    let first: u8 = 240;
    let second: u8 = 159;
    let third: u8 = 152;
    let fourth: u8 = 128;
    let source: [u8; 4] = [first, second, third, fourth];
    let zero: u16 = 0;
    let output: [u16; 1] = [zero];
    let result: core::transcode::TranscodeResult =
        core::transcode::utf8_to_utf16(source, 4, output, 2);
    if (core::transcode::succeeded(result)) { return 1; }
    return 0;
}
