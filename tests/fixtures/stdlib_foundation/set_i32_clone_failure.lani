module app::main;
import std::set_i32;

fn main() -> i32 {
    let value: std::set_i32::SetI32 = std::set_i32::try_insert(std::set_i32::new(), -41);
    if (std::set_i32::len(value) != 1) { return 2; }
    let copy: std::set_i32::SetI32 = std::set_i32::try_clone(value);
    if (std::set_i32::len(copy) == 0 &&
        std::set_i32::capacity(copy) == 0 &&
        std::set_i32::at_or(value, 0, 0) == -41) {
        std::set_i32::destroy(copy);
        std::set_i32::destroy(value);
        return 0;
    }
    if (std::set_i32::len(copy) == 1 &&
        std::set_i32::at_or(copy, 0, 0) == -41 &&
        std::set_i32::at_or(value, 0, 0) == -41) {
        std::set_i32::destroy(copy);
        std::set_i32::destroy(value);
        return 4;
    }
    std::set_i32::destroy(copy);
    std::set_i32::destroy(value);
    return 5;
}
