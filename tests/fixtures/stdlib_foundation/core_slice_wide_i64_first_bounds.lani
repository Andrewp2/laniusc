module app::main;
import core::slice_wide_i64;
import core::wide_i64;
fn main() -> i32 {
    let word_zero: u32 = 0;
    let values: [u32; 1] = [word_zero];
    let item: core::wide_i64::WideI64 = core::slice_wide_i64::first(values);
    let low: u32 = core::wide_i64::low_word(item);
    return low as i32;
}
