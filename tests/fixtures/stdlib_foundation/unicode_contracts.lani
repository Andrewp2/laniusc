module app::main;
import core::unicode;
import core::mem;
import core::slice;
import core::result;
fn error_code(error: core::unicode::Error) -> i32 { let code: i32 = match (error) { core::unicode::Error::InvalidScalar -> 1, core::unicode::Error::Bounds -> 2, core::unicode::Error::Capacity(count) -> 10+count }; return code; }
fn main() -> i32 {
    assert(core::unicode::VERSION_MAJOR == 17 && core::unicode::VERSION_MINOR == 0 && core::unicode::VERSION_UPDATE == 0);
    assert(core::unicode::is_code_point(55296) && !core::unicode::is_scalar(55296));
    assert(core::unicode::is_scalar(1114111) && !core::unicode::is_code_point(1114112));
    assert(core::unicode::general_category(65) == core::unicode::GC_LU);
    assert(core::unicode::general_category(55296) == core::unicode::GC_CS);
    assert(core::unicode::general_category(57344) == core::unicode::GC_CO);
    assert(core::unicode::general_category(888) == core::unicode::GC_CN);
    assert(core::unicode::general_category(4294967295) == core::unicode::GC_INVALID);
    assert(core::unicode::canonical_combining_class(769) == 230);
    assert(core::unicode::canonical_combining_class(4294967295) == 0);
    assert(core::unicode::is_alphabetic(120782) == false);
    assert(core::unicode::is_lowercase(170) && core::unicode::general_category(170) == core::unicode::GC_LO);
    assert(core::unicode::is_uppercase(8544) && core::unicode::is_cased(8544));
    assert(core::unicode::is_case_ignorable(39) && core::unicode::is_white_space(133));
    assert(core::unicode::is_xid_start(66560) && core::unicode::is_xid_continue(769));
    assert(core::unicode::is_default_ignorable(917760));
    assert(!core::unicode::is_alphabetic(55296) && !core::unicode::is_white_space(4294967295));
    assert(core::unicode::decimal_digit_value_or(120791,99) == 9 && core::unicode::decimal_digit_value_or(178,99) == 99);
    let properties: core::unicode::Properties = core::unicode::properties(1637);
    assert(properties.category == core::unicode::GC_ND && properties.combining_class == 0 && properties.decimal_digit == 5);
    assert((properties.flags & core::unicode::XID_CONTINUE) != 0);
    assert(core::result::unwrap(core::unicode::simple_lowercase(66560)) == 66600 && core::result::unwrap(core::unicode::simple_uppercase(66600)) == 66560);
    assert(core::result::unwrap(core::unicode::simple_titlecase(452)) == 453 && core::result::unwrap(core::unicode::simple_uppercase(223)) == 223);
    assert(core::result::unwrap(core::unicode::simple_lowercase(304)) == 105 && error_code(core::result::unwrap_err(core::unicode::simple_lowercase(55296))) == 1);
    assert(core::result::unwrap(core::unicode::simple_case_fold(7838,false)) == 223 && core::result::unwrap(core::unicode::simple_case_fold(73,true)) == 305);
    assert(core::result::unwrap(core::unicode::case_fold_len(304,false)) == 2 && core::result::unwrap(core::unicode::case_fold_len(304,true)) == 1);
    assert(core::unicode::case_fold_at_or(304,0,false,999) == 105 && core::unicode::case_fold_at_or(304,1,false,999) == 775);
    assert(core::unicode::case_fold_at_or(304,2,false,999) == 999 && core::unicode::case_fold_at_or(55296,0,false,999) == 999);
    assert(core::unicode::case_fold_at_or(65,4294967295,false,999) == 999);
    assert(error_code(core::result::unwrap_err(core::unicode::simple_mappings(1114112))) == 1);
    assert(error_code(core::result::unwrap_err(core::unicode::simple_uppercase(4294967295))) == 1);
    assert(error_code(core::result::unwrap_err(core::unicode::simple_titlecase(55296))) == 1);
    assert(error_code(core::result::unwrap_err(core::unicode::simple_case_fold(55296,true))) == 1);
    assert(error_code(core::result::unwrap_err(core::unicode::case_fold_len(55296,false))) == 1);
    assert(error_code(core::result::unwrap_err(core::unicode::case_folding(55296,false))) == 1);
    let output: [u32;5] = [777;5];
    let view: core::slice::View<u32> = core::result::unwrap(core::slice::view_range(output,1,3));
    let short: core::slice::View<u32> = core::result::unwrap(view.subview(0,2));
    assert(error_code(core::result::unwrap_err(core::unicode::case_fold_into(64259,false,short))) == 13 && output[1] == 777 && output[2] == 777);
    assert(error_code(core::result::unwrap_err(core::unicode::case_fold_into(55296,false,view))) == 1 && output[1] == 777);
    let bad: core::slice::View<u32> = view; bad.start = -1;
    assert(error_code(core::result::unwrap_err(core::unicode::case_fold_into(64259,false,bad))) == 2 && output[1] == 777);
    bad.start = 2147483647;
    assert(error_code(core::result::unwrap_err(core::unicode::case_fold_into(64259,false,bad))) == 2 && output[1] == 777);
    bad.start = 0; bad.length = -1;
    assert(error_code(core::result::unwrap_err(core::unicode::case_fold_into(64259,false,bad))) == 2 && output[1] == 777);
    assert(core::result::unwrap(core::unicode::case_fold_into(64259,false,view)) == 3 && output[0] == 777 && output[1] == 102 && output[2] == 102 && output[3] == 105 && output[4] == 777);
    let cells: [i32;10] = [777;10];
    let raw: [u32] = core::mem::typed_slice_from_storage(core::mem::i32_array_data_ptr(cells),5);
    let raw_view: core::slice::View<u32> = core::result::unwrap(core::slice::view(raw,5));
    assert(core::result::unwrap(core::unicode::case_fold_into(64259,false,raw_view)) == 3 && raw[0] == 102 && raw[1] == 102 && raw[2] == 105);
    assert(cells[0] == 777 && cells[1] == 777 && cells[2] == 777 && cells[3] == 777);
    return 0;
}
