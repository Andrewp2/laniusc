module app::main;
import core::wide_i64;
import core::wide_i64_range;
fn matches(value: core::wide_i64::WideI64, high: u32, low: u32) -> bool {
    return core::wide_i64::high_word(value) == high && core::wide_i64::low_word(value) == low;
}
fn main() -> i32 {
    let min: core::wide_i64::WideI64 = core::wide_i64::min_value();
    let negative_two: core::wide_i64::WideI64 = core::wide_i64::from_i32(-2);
    let negative_one: core::wide_i64::WideI64 = core::wide_i64::from_i32(-1);
    let zero: core::wide_i64::WideI64 = core::wide_i64::zero();
    let one: core::wide_i64::WideI64 = core::wide_i64::from_i32(1);
    let max: core::wide_i64::WideI64 = core::wide_i64::max_value();
    let half: core::wide_i64_range::Range = core::wide_i64_range::range(negative_one, one);
    if (!matches(core::wide_i64_range::start(half), 4294967295, 4294967295) || !matches(core::wide_i64_range::end(half), 0, 1) || core::wide_i64_range::is_empty(half)) {
        return 1;
    }
    if (!core::wide_i64_range::contains(half, negative_one) || !core::wide_i64_range::contains(half, zero) || core::wide_i64_range::contains(half, one) || core::wide_i64_range::contains(half, min)) {
        return 2;
    }
    let overlapping: core::wide_i64_range::Range = core::wide_i64_range::range(zero, max);
    let touching: core::wide_i64_range::Range = core::wide_i64_range::range(one, max);
    let empty: core::wide_i64_range::Range = core::wide_i64_range::range(zero, zero);
    let reversed: core::wide_i64_range::Range = core::wide_i64_range::range(one, negative_one);
    if (!core::wide_i64_range::overlaps(half, overlapping) || core::wide_i64_range::overlaps(half, touching) || !core::wide_i64_range::is_empty(empty) || !core::wide_i64_range::is_empty(reversed) || core::wide_i64_range::contains(empty, zero) || core::wide_i64_range::overlaps(empty, overlapping)) {
        return 3;
    }
    if (!matches(half.start(), 4294967295, 4294967295) || !matches(half.end(), 0, 1) || half.is_empty() || !half.contains(zero) || half.contains(one) || !half.overlaps(overlapping) || half.overlaps(touching)) {
        return 10;
    }
    let extremes: core::wide_i64_range::Range = core::wide_i64_range::range(min, max);
    if (!core::wide_i64_range::contains(extremes, min) || !core::wide_i64_range::contains(extremes, negative_one) || !core::wide_i64_range::contains(extremes, one) || core::wide_i64_range::contains(extremes, max)) {
        return 15;
    }
    let negative_half: core::wide_i64_range::Range = core::wide_i64_range::range(negative_two, zero);
    if (core::wide_i64_range::is_empty(negative_half) || !core::wide_i64_range::contains(negative_half, negative_two) || !core::wide_i64_range::contains(negative_half, negative_one) || core::wide_i64_range::contains(negative_half, zero) || !core::wide_i64_range::overlaps(negative_half, half)) {
        return 18;
    }
    let inclusive: core::wide_i64_range::RangeInclusive = core::wide_i64_range::range_inclusive(negative_one, zero);
    if (!matches(core::wide_i64_range::start_inclusive(inclusive), 4294967295, 4294967295) || !matches(core::wide_i64_range::end_inclusive(inclusive), 0, 0) || core::wide_i64_range::is_empty_inclusive(inclusive)) {
        return 4;
    }
    if (!core::wide_i64_range::contains_inclusive(inclusive, negative_one) || !core::wide_i64_range::contains_inclusive(inclusive, zero) || core::wide_i64_range::contains_inclusive(inclusive, one)) {
        return 5;
    }
    let inclusive_touch: core::wide_i64_range::RangeInclusive = core::wide_i64_range::range_inclusive(zero, max);
    let inclusive_after: core::wide_i64_range::RangeInclusive = core::wide_i64_range::range_inclusive(one, max);
    let inclusive_single: core::wide_i64_range::RangeInclusive = core::wide_i64_range::range_inclusive(zero, zero);
    let inclusive_empty: core::wide_i64_range::RangeInclusive = core::wide_i64_range::range_inclusive(one, negative_one);
    if (!core::wide_i64_range::overlaps_inclusive(inclusive, inclusive_touch) || core::wide_i64_range::overlaps_inclusive(inclusive, inclusive_after) || !core::wide_i64_range::contains_inclusive(inclusive_single, zero) || core::wide_i64_range::is_empty_inclusive(inclusive_single) || !core::wide_i64_range::is_empty_inclusive(inclusive_empty) || core::wide_i64_range::overlaps_inclusive(inclusive_empty, inclusive_touch)) {
        return 6;
    }
    if (!matches(inclusive.start(), 4294967295, 4294967295) || !matches(inclusive.end(), 0, 0) || inclusive.is_empty() || !inclusive.contains(zero) || inclusive.contains(one) || !inclusive.overlaps(inclusive_touch) || inclusive.overlaps(inclusive_after)) {
        return 11;
    }
    let negative_inclusive: core::wide_i64_range::RangeInclusive = core::wide_i64_range::range_inclusive(min, negative_one);
    if (core::wide_i64_range::is_empty_inclusive(negative_inclusive) || !core::wide_i64_range::contains_inclusive(negative_inclusive, min) || !core::wide_i64_range::contains_inclusive(negative_inclusive, negative_two) || !core::wide_i64_range::contains_inclusive(negative_inclusive, negative_one) || core::wide_i64_range::contains_inclusive(negative_inclusive, zero)) {
        return 19;
    }
    let from: core::wide_i64_range::RangeFrom = core::wide_i64_range::range_from(zero);
    if (!matches(core::wide_i64_range::start_from(from), 0, 0) || !core::wide_i64_range::contains_from(from, zero) || !core::wide_i64_range::contains_from(from, max) || core::wide_i64_range::contains_from(from, negative_one)) {
        return 7;
    }
    if (!matches(from.start(), 0, 0) || !from.contains(max) || from.contains(negative_one)) {
        return 12;
    }
    let from_max: core::wide_i64_range::RangeFrom = core::wide_i64_range::range_from(max);
    if (!core::wide_i64_range::contains_from(from_max, max) || core::wide_i64_range::contains_from(from_max, one)) {
        return 16;
    }
    let to: core::wide_i64_range::RangeTo = core::wide_i64_range::range_to(zero);
    if (!matches(core::wide_i64_range::end_to(to), 0, 0) || !core::wide_i64_range::contains_to(to, negative_one) || !core::wide_i64_range::contains_to(to, min) || core::wide_i64_range::contains_to(to, zero)) {
        return 8;
    }
    if (!matches(to.end(), 0, 0) || !to.contains(negative_one) || to.contains(zero)) {
        return 13;
    }
    let to_min: core::wide_i64_range::RangeTo = core::wide_i64_range::range_to(min);
    if (core::wide_i64_range::contains_to(to_min, min)) {
        return 17;
    }
    if (!core::wide_i64_range::full_contains(min) || !core::wide_i64_range::full_contains(zero) || !core::wide_i64_range::full_contains(max)) {
        return 14;
    }
    return 0;
}
