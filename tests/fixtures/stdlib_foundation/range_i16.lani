module app::main;
import core::range_i16;

fn main() -> i32 {
    if (core::range_i16::half_open_is_empty(-32768, 32767) ||
        !core::range_i16::half_open_is_empty(-5, -5) ||
        !core::range_i16::half_open_is_empty(5, -5)) {
        return 1;
    }
    if (!core::range_i16::half_open_contains(-32768, 32767, -32768) ||
        !core::range_i16::half_open_contains(-32768, 32767, 32766) ||
        core::range_i16::half_open_contains(-32768, 32767, 32767) ||
        core::range_i16::half_open_contains(-3, 3, -4)) {
        return 2;
    }
    if (!core::range_i16::half_open_overlaps(-10, 0, -1, 10) ||
        core::range_i16::half_open_overlaps(-10, 0, 0, 10) ||
        core::range_i16::half_open_overlaps(-10, 0, -5, -5) ||
        core::range_i16::half_open_overlaps(5, -5, -3, 3)) {
        return 3;
    }
    if (core::range_i16::inclusive_is_empty(-32768, 32767) ||
        core::range_i16::inclusive_is_empty(32767, 32767) ||
        !core::range_i16::inclusive_is_empty(32767, -32768)) {
        return 4;
    }
    if (!core::range_i16::inclusive_contains(-32768, 32767, 32767) ||
        !core::range_i16::inclusive_contains(-32768, -32768, -32768) ||
        core::range_i16::inclusive_contains(-3, 3, -4) ||
        core::range_i16::inclusive_contains(3, -3, 0)) {
        return 5;
    }
    if (!core::range_i16::inclusive_overlaps(-10, 0, 0, 10) ||
        core::range_i16::inclusive_overlaps(-10, -1, 0, 10) ||
        core::range_i16::inclusive_overlaps(10, -10, -5, 5)) {
        return 6;
    }
    if (!core::range_i16::from_contains(-10, -10) ||
        !core::range_i16::from_contains(-10, 32767) ||
        core::range_i16::from_contains(-10, -11)) {
        return 7;
    }
    if (!core::range_i16::to_contains(0, -32768) ||
        core::range_i16::to_contains(0, 0) ||
        core::range_i16::to_contains(-32768, -32768)) {
        return 8;
    }
    if (!core::range_i16::full_contains(-32768) || !core::range_i16::full_contains(32767)) {
        return 9;
    }
    return 0;
}
