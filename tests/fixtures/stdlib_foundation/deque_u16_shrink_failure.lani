module app::main;
import std::deque_u16;

fn main() -> i32 {
    let value: std::deque_u16::DequeU16 = std::deque_u16::try_with_capacity(4);
    if (std::deque_u16::capacity(value) != 4) { return 5; }
    value = std::deque_u16::try_push_back(value, 1);
    value = std::deque_u16::try_push_back(value, 32768);
    value = std::deque_u16::try_push_back(value, 3);
    value = std::deque_u16::try_pop_front(value);
    value = std::deque_u16::try_shrink_to_fit(value);
    let intact: bool = std::deque_u16::len(value) == 2 &&
        std::deque_u16::at_or(value, 0, 0) == 32768 &&
        std::deque_u16::at_or(value, 1, 0) == 3;
    let failure: bool = intact && std::deque_u16::capacity(value) == 4;
    let success: bool = intact && std::deque_u16::capacity(value) == 2;
    std::deque_u16::destroy(value);
    if (failure) { return 0; }
    if (success) { return 4; }
    return 5;
}
