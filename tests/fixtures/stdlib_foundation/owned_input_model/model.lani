// Test-only owned-input finite reader and recovery adapter.
module app::main;

import core::io;
import core::mem;
import core::result;
import core::option;
import core::slice;
import std::io;
import alloc::io;
import alloc::vec;
import alloc::string;

fn read_exact(pointer: ptr, count: i32, allow_eof: bool) -> bool {
    let done: i32 = 0;
    while (done < count) {
        let got: i32 = std::io::read_stdin(pointer + (done as usize), (count - done) as usize);
        assert(got >= 0);
        if (got == 0) { assert(allow_eof && done == 0); return false; }
        done += got;
    }
    return true;
}

fn write_all(pointer: ptr, count: i32) {
    let done: i32 = 0;
    while (done < count) {
        let got: i32 = std::io::write_stdout(pointer + (done as usize), (count - done) as usize);
        assert(got > 0);
        done += got;
    }
}

fn get64(bytes: [u8], offset: i32) -> u64 {
    let result: u64 = 0;
    let index: i32 = 0;
    while (index < 8) {
        result |= (bytes[offset + index] as u64) << (index * 8);
        index += 1;
    }
    return result;
}

struct Output { bytes: [u8], pointer: ptr, used: i32 }
impl Output {
    fn borrow(&self) -> &Output { return self; }
    fn flush(&self) { write_all(self.pointer, self.used); self.used = 0; }
    fn word(&self, value: u64) {
        if (self.used == 4096) { self.flush(); }
        let index: i32 = 0;
        while (index < 8) {
            self.bytes[self.used + index] = ((value >> (index * 8)) & 255) as u8;
            index += 1;
        }
        self.used += 8;
    }
}

fn error_code(error: core::io::Error) -> i32 {
    return match (error) {
        core::io::Error::InvalidInput -> 1,
        core::io::Error::UnexpectedEof -> 2,
        core::io::Error::WriteZero -> 3,
        core::io::Error::InvalidCount -> 4,
        core::io::Error::CountOverflow -> 5,
        core::io::Error::LimitExceeded -> 6,
        core::io::Error::Interrupted -> 7,
        core::io::Error::WouldBlock -> 8,
        core::io::Error::AllocationFailed -> 9,
        core::io::Error::Host(code) -> 10,
    };
}

fn host_code(error: core::io::Error) -> i32 {
    return match (error) { core::io::Error::Host(code) -> code, _ -> 0 };
}

fn provider_error(event: i64) -> core::io::Error {
    if (event == -1) { return core::io::Error::Interrupted; }
    if (event == -2) { return core::io::Error::WouldBlock; }
    if (event == -3) { return core::io::Error::Host(-123); }
    if (event == -8) { return core::io::Error::InvalidInput; }
    if (event == -9) { return core::io::Error::UnexpectedEof; }
    if (event == -10) { return core::io::Error::WriteZero; }
    if (event == -11) { return core::io::Error::InvalidCount; }
    if (event == -12) { return core::io::Error::CountOverflow; }
    if (event == -13) { return core::io::Error::LimitExceeded; }
    if (event == -14) { return core::io::Error::AllocationFailed; }
    if (event == -15) { return core::io::Error::Host(2147483647); }
    if (event == -16) { return core::io::Error::Host(-2147483648); }
    return core::io::Error::Host(0);
}

struct Reader {
    bytes: [u8], length: i32, cursor: i32, script: [i64], script_length: i32,
    index: i32, calls: i32, requests: [i64], events: [i64], positions: [i64]
}
impl Reader { fn borrow(&self) -> &Reader { return self; } }
pub impl core::io::Read for Reader {
    pub fn read(&self, destination: [u8], offset: i32, count: i32) -> core::result::Result<i32, core::io::Error> {
        assert(core::io::valid_range(offset, count) && count > 0 && count <= 1024 && self.calls < 64);
        let event: i64 = 1024;
        if (self.index < self.script_length) { event = self.script[self.index]; self.index += 1; }
        self.requests[self.calls] = count as i64;
        self.events[self.calls] = event;
        self.positions[self.calls] = self.cursor as i64;
        self.calls += 1;
        // Malformed count controls deterministically publish/consume nothing.
        // Broken-provider state is not a general public rollback guarantee.
        if (event == -4) { return core::result::Ok(-1); }
        if (event == -5) { return core::result::Ok(count + 1); }
        if (event == -6) { return core::result::Ok(-2147483648); }
        if (event == -7) { return core::result::Ok(2147483647); }
        if (event < 0) { return core::result::Err(provider_error(event)); }
        let amount: i32 = count;
        if (event < amount as i64) { amount = event as i32; }
        if (amount > self.length - self.cursor) { amount = self.length - self.cursor; }
        let index: i32 = 0;
        while (index < amount) {
            destination[offset + index] = self.bytes[self.cursor + index];
            index += 1;
        }
        self.cursor += amount;
        return core::result::Ok(amount);
    }
}

struct Cause { kind: u64, detail: u64, payload: i32 }
fn io_cause(value: core::io::Error) -> Cause {
    return Cause { kind: 4, detail: error_code(value) as u64, payload: host_code(value) };
}
fn storage_cause(value: alloc::vec::Error) -> Cause {
    let detail: u64 = match (value) {
        alloc::vec::Error::Bounds -> 1, alloc::vec::Error::InvalidCapacity -> 2,
        alloc::vec::Error::CapacityOverflow -> 3, alloc::vec::Error::AllocationFailed -> 4,
    };
    return Cause { kind: 5, detail: detail, payload: 0 };
}
fn text_cause(value: alloc::string::Error) -> Cause {
    let detail: u64 = match (value) {
        alloc::string::Error::InvalidUtf8(index) -> 1,
        alloc::string::Error::InvalidScalar -> 2, alloc::string::Error::Bounds -> 3,
        alloc::string::Error::NotCharBoundary -> 4, alloc::string::Error::CapacityOverflow -> 5,
        alloc::string::Error::AllocationFailed -> 6,
    };
    let payload: i32 = match (value) { alloc::string::Error::InvalidUtf8(index) -> index, _ -> 0 };
    return Cause { kind: 6, detail: detail, payload: payload };
}
fn cause(error: alloc::io::ReadError) -> Cause {
    return match (error) {
        alloc::io::ReadError::InvalidLimits -> Cause { kind: 1, detail: 0, payload: 0 },
        alloc::io::ReadError::CallLimit -> Cause { kind: 2, detail: 0, payload: 0 },
        alloc::io::ReadError::ByteLimit -> Cause { kind: 3, detail: 0, payload: 0 },
        alloc::io::ReadError::Io(value) -> io_cause(value),
        alloc::io::ReadError::Storage(value) -> storage_cause(value),
        alloc::io::ReadError::Text(value) -> text_cause(value),
    };
}

fn emit(reader: &Reader, before: i32, tag: u64, error: Cause, bytes: [u8], length: i32,
        reported: u64, extra: core::option::Option<u8>, output: &Output) {
    output.word(tag); output.word(error.kind); output.word(error.detail); output.word(error.payload as i64 as u64);
    output.word(length as u64); output.word(reported);
    output.word(extra.is_some() as u64);
    let extra_byte: u64 = 0;
    if (extra.is_some()) { extra_byte = extra.unwrap() as u64; }
    output.word(extra_byte); output.word((reader.calls - before) as u64);
    output.word(reader.calls as u64); output.word(reader.cursor as u64); output.word(reader.index as u64);
    let index: i32 = 0;
    while (index < length) { output.word(bytes[index] as u64); index += 1; }
    index = 0;
    while (index < reader.calls) {
        output.word(reader.requests[index] as u64); output.word(reader.events[index] as u64);
        output.word(reader.positions[index] as u64); index += 1;
    }
}

fn emit_failure(reader: &Reader, before: i32, failure: &alloc::io::ReadFailure, output: &Output) {
    let error: Cause = cause(failure.cause);
    emit(reader, before, 1, error, failure.bytes.as_slice(), failure.bytes.len(), failure.calls, failure.extra, output);
}

fn collect(reader: &Reader, limits: alloc::io::ReadLimits, text: bool, output: &Output) {
    let before: i32 = reader.calls;
    let no_error: Cause = Cause { kind: 0, detail: 0, payload: 0 };
    if (text) {
        let result: core::result::Result<alloc::string::String, alloc::io::ReadFailure> =
            alloc::io::read_to_string<Reader>(reader, limits);
        if (result.is_ok()) {
            let value: alloc::string::String = result.unwrap();
            emit(reader, before, 0, no_error, value.as_bytes(), value.byte_len(), 0, core::option::None(), output);
            value.destroy();
        } else {
            let failure: alloc::io::ReadFailure = result.unwrap_err();
            emit_failure(reader, before, failure.borrow(), output);
            failure.destroy();
        }
    } else {
        let result: core::result::Result<alloc::vec::Vec<u8>, alloc::io::ReadFailure> =
            alloc::io::read_to_end<Reader>(reader, limits);
        if (result.is_ok()) {
            let value: alloc::vec::Vec<u8> = result.unwrap();
            emit(reader, before, 0, no_error, value.as_slice(), value.len(), 0, core::option::None(), output);
            value.destroy();
        } else {
            let failure: alloc::io::ReadFailure = result.unwrap_err();
            emit_failure(reader, before, failure.borrow(), output);
            failure.destroy();
        }
    }
}

fn run(input: [u8], output: &Output) {
    let native: [u8; 2052] = [0; 2052];
    let storage: [i32; 513] = [0; 513];
    let bytes: [u8] = native;
    if (get64(input, 8) == 1) { bytes = core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(storage), 2052); }
    if (get64(input, 8) == 0) { assert(core::mem::slice_stride(bytes) < 0); }
    else { assert(core::mem::slice_stride(bytes) == 1); }
    let script: [i64; 16] = [0; 16];
    let requests: [i64; 64] = [0; 64];
    let events: [i64; 64] = [0; 64];
    let positions: [i64; 64] = [0; 64];
    let script_length: i32 = get64(input, 48) as i32;
    let length: i32 = get64(input, 56) as i32;
    let index: i32 = 0;
    while (index < script_length) { script[index] = get64(input, 64 + index * 8) as i64; index += 1; }
    index = 0;
    while (index < length) { bytes[index] = get64(input, 64 + script_length * 8 + index * 8) as u8; index += 1; }
    let reader: Reader = Reader {
        bytes: bytes, length: length, cursor: 0, script: script, script_length: script_length,
        index: 0, calls: 0, requests: requests, events: events, positions: positions
    };
    let first: alloc::io::ReadLimits = alloc::io::ReadLimits { max_bytes: get64(input, 16) as i32, max_calls: get64(input, 24) };
    let second: alloc::io::ReadLimits = alloc::io::ReadLimits { max_bytes: get64(input, 32) as i32, max_calls: get64(input, 40) };
    collect(reader.borrow(), first, get64(input, 0) == 1, output);
    collect(reader.borrow(), second, false, output);
}

fn main() -> i32 {
    let input_words: [i32; 4152] = [0; 4152];
    let input_pointer: ptr = core::mem::i32_array_data_ptr(input_words);
    let input: [u8] = core::mem::typed_slice_from_raw_parts<u8>(input_pointer, 16608);
    let output_words: [i32; 1024] = [0; 1024];
    let output_pointer: ptr = core::mem::i32_array_data_ptr(output_words);
    let output_bytes: [u8] = core::mem::typed_slice_from_raw_parts<u8>(output_pointer, 4096);
    let output: Output = Output { bytes: output_bytes, pointer: output_pointer, used: 0 };
    while (read_exact(input_pointer, 64, true)) {
        assert(get64(input, 0) <= 1 && get64(input, 8) <= 1 && get64(input, 48) <= 16 && get64(input, 56) <= 2052);
        assert(read_exact(input_pointer + 64, ((get64(input, 48) + get64(input, 56)) * 8) as i32, false));
        run(input, output.borrow());
    }
    output.flush();
    return 0;
}
