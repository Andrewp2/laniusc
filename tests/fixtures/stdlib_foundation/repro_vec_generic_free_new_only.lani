module app::main;
import std::vec;

fn main() -> i32 {
    let value: std::vec::Vec<i32> = std::vec::new();
    if (value.len() != 0 || !value.is_empty()) { return 1; }
    let flags: std::vec::Vec<bool> = std::vec::new();
    if (flags.len() != 0 || !flags.is_empty()) { return 2; }
    return 0;
}
