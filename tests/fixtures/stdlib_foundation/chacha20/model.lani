// Five-u64 header: operation,counter,length,schedule,layout; key32,nonce12,payload.
// Stream copies below test value storage only; they grant no nonce-reuse authority.
module app::main;
import core::chacha20;
import core::io;
import core::mem;
import core::result;
import core::slice;
import std::stream;
fn view(bytes: [u8], start: i32, length: i32) -> core::slice::View<u8> { return core::slice::View<u8> { values: bytes, start: start, length: length }; }
fn code(error: core::chacha20::Error) -> i32 {
    return match (error) { core::chacha20::Error::Bounds -> 1, core::chacha20::Error::InvalidKeyLength -> 2,
        core::chacha20::Error::InvalidNonceLength -> 3, core::chacha20::Error::BufferTooSmall -> 4, core::chacha20::Error::CounterOverflow -> 5 };
}
fn equal(left: [u8], right: [u8], count: i32) { let index: i32=0; while (index<count) { assert(left[index]==right[index]); index+=1; } }
fn copy(source: [u8], destination: [u8], count: i32) { let index: i32=0; while (index<count) { destination[index]=source[index]; index+=1; } }
// Independent numeric storage, not another potentially aliased State copy.
fn snapshot(state: &core::chacha20::State, saved: [u64]) {
    let index: i32=0; while (index<16) { saved[index]=state.words[index] as u64; index+=1; }
    index=0; while (index<64) { saved[16+index]=state.block[index] as u64; index+=1; }
    saved[80]=state.used as u64; saved[81]=state.next;
}
fn unchanged(state: &core::chacha20::State, saved: [u64]) {
    let after: [u64;82]=[0;82]; snapshot(state,after); let index: i32=0;
    while (index<82) { assert(saved[index]==after[index]); index+=1; }
}
fn contracts() {
    let key: [u8;32]=[0;32]; let nonce: [u8;12]=[0;12]; let input: [u8;130]=[0;130];
    let output: [u8;130]=[165;130]; let before: [u8;130]=[0;130]; let saved: [u64;82]=[0;82];
    let k: core::slice::View<u8> = view(key,0,32); let n: core::slice::View<u8> = view(nonce,0,12);
    let bad: core::slice::View<u8> = k; bad.start=-1;
    assert(code(core::chacha20::new(bad,n,0).unwrap_err())==1);
    bad=k; bad.length=-1; assert(code(core::chacha20::new(bad,n,0).unwrap_err())==1);
    bad=n; bad.start=2147483647; bad.length=1; assert(code(core::chacha20::new(k,bad,0).unwrap_err())==1);
    assert(code(core::chacha20::new(view(key,0,31),n,0).unwrap_err())==2);
    assert(code(core::chacha20::new(k,view(nonce,0,11),0).unwrap_err())==3);
    copy(output,before,130);
    assert(code(core::chacha20::block(k,n,0,view(output,0,63)).unwrap_err())==4); equal(output,before,130);
    assert(code(core::chacha20::block(view(key,0,31),n,0,view(output,0,0)).unwrap_err())==2); equal(output,before,130);
    assert(code(core::chacha20::block(k,bad,0,view(output,0,0)).unwrap_err())==1); equal(output,before,130);
    assert(code(core::chacha20::xor_into(k,n,4294967295,view(input,0,65),view(output,0,64)).unwrap_err())==4); equal(output,before,130);
    assert(code(core::chacha20::xor_into(k,n,4294967295,view(input,0,65),view(output,0,65)).unwrap_err())==5); equal(output,before,130);
    assert(code(core::chacha20::xor_into(k,n,0,bad,view(output,0,0)).unwrap_err())==1); equal(output,before,130);
    assert(code(core::chacha20::xor_into(view(key,0,31),n,0,view(input,0,0),view(output,0,0)).unwrap_err())==2); equal(output,before,130);
    assert(code(core::chacha20::xor_into(k,view(nonce,0,11),0,view(input,0,0),view(output,0,0)).unwrap_err())==3); equal(output,before,130);
    assert(code(core::chacha20::xor_in_place(k,n,4294967295,view(output,0,65)).unwrap_err())==5); equal(output,before,130);

    // Reject65 atomically, consume1, reject64 without discarding cached63,
    // drain those63, reject1, then allow empty even at terminal exhaustion.
    let terminal: core::chacha20::State=core::chacha20::new(k,n,4294967295).unwrap(); snapshot(terminal.borrow(),saved);
    assert(code(terminal.xor_into(view(input,0,65),view(output,0,65)).unwrap_err())==5); unchanged(terminal.borrow(),saved); equal(output,before,130);
    assert(code(terminal.xor_into(view(input,0,1),view(output,0,0)).unwrap_err())==4); unchanged(terminal.borrow(),saved); equal(output,before,130);
    assert(terminal.xor_into(view(input,0,1),view(output,1,1)).unwrap()==1);
    assert(terminal.next==4294967296 && terminal.used==1); snapshot(terminal.borrow(),saved); copy(output,before,130);
    assert(code(terminal.xor_into(view(input,0,64),view(output,2,64)).unwrap_err())==5); unchanged(terminal.borrow(),saved); equal(output,before,130);
    bad=view(input,-1,0); assert(code(terminal.xor_into(bad,view(output,0,0)).unwrap_err())==1); unchanged(terminal.borrow(),saved); equal(output,before,130);
    bad=view(output,2147483647,1); assert(code(terminal.xor_into(view(input,0,0),bad).unwrap_err())==1); unchanged(terminal.borrow(),saved); equal(output,before,130);
    assert(terminal.xor_into(view(input,1,63),view(output,2,63)).unwrap()==63);
    assert(terminal.next==4294967296 && terminal.used==64); snapshot(terminal.borrow(),saved); copy(output,before,130);
    assert(code(terminal.xor_in_place(view(output,0,1)).unwrap_err())==5); unchanged(terminal.borrow(),saved); equal(output,before,130);
    assert(terminal.xor_into(view(input,130,0),view(output,130,0)).unwrap()==0); unchanged(terminal.borrow(),saved); equal(output,before,130);
    assert(terminal.xor_in_place(view(output,0,0)).unwrap()==0); unchanged(terminal.borrow(),saved); equal(output,before,130);
    let last: [u8;64]=[0;64]; core::chacha20::block(k,n,4294967295,view(last,0,64)).unwrap();
    let index: i32=0; while (index<64) { assert(output[index+1]==last[index]); index+=1; }
    let penultimate: core::chacha20::State=core::chacha20::new(k,n,4294967294).unwrap(); snapshot(penultimate.borrow(),saved);
    assert(code(penultimate.xor_into(view(input,0,129),view(output,0,129)).unwrap_err())==5); unchanged(penultimate.borrow(),saved); equal(output,before,130);
    assert(core::chacha20::xor_into(k,n,4294967295,view(input,0,0),view(output,0,0)).unwrap()==0);

    // Divergent plaintexts and differently sized interleaved continuations
    // expose sharing of cached bytes, counter words, or local stream position.
    let plain: [u8;128]=[0;128]; let alternative: [u8;128]=[0;128]; index=0;
    while (index<128) { plain[index]=((index*37+11)%256) as u8; alternative[index]=plain[index]; if (index>=17) { alternative[index]^=255; } index+=1; }
    let expected: [u8;128]=[0;128]; let other_expected: [u8;128]=[0;128]; let actual: [u8;128]=[0;128]; let other: [u8;128]=[0;128];
    core::chacha20::xor_into(k,n,7,view(plain,0,128),view(expected,0,128)).unwrap();
    core::chacha20::xor_into(k,n,7,view(alternative,0,128),view(other_expected,0,128)).unwrap();
    let current: core::chacha20::State=core::chacha20::new(k,n,7).unwrap(); current.xor_into(view(plain,0,17),view(actual,0,17)).unwrap();
    let fork: core::chacha20::State=current; let retained: core::chacha20::State=current; snapshot(retained.borrow(),saved);
    index=0; while (index<17) { other[index]=actual[index]; index+=1; }
    fork.xor_into(view(alternative,17,70),view(other,17,70)).unwrap();
    current.xor_into(view(plain,17,111),view(actual,17,111)).unwrap();
    fork.xor_into(view(alternative,87,41),view(other,87,41)).unwrap();
    equal(actual,expected,128); equal(other,other_expected,128); unchanged(retained.borrow(),saved);
    let retained_output: [u8;111]=[0;111]; retained.xor_into(view(plain,17,111),view(retained_output,0,111)).unwrap();
    index=0; while (index<111) { assert(retained_output[index]==expected[index+17]); index+=1; }
}
fn feed(state: &core::chacha20::State, input: core::slice::View<u8>, output: core::slice::View<u8>, schedule: i32, inplace: bool) {
    let widths: [i32;6]=[0,1,63,64,7,65]; let position: i32=0; let step: i32=0;
    assert(state.xor_into(view(input.values,input.start,0),view(output.values,output.start,0)).unwrap()==0);
    while (position<input.length) {
        let count: i32=input.length-position;
        if (schedule==1) { count=1; }
        if (schedule==2 && count>widths[step%6]) { count=widths[step%6]; }
        if (schedule==3 && count>65) { count=65; }
        let source: core::slice::View<u8> = view(input.values,input.start+position,count);
        let destination: core::slice::View<u8> = view(output.values,output.start+position,count);
        if (inplace) { assert(state.xor_in_place(source).unwrap()==count); }
        else { assert(state.xor_into(source,destination).unwrap()==count); }
        position+=count; step+=1;
    }
    assert(state.xor_into(view(input.values,input.start+input.length,0),view(output.values,output.start+input.length,0)).unwrap()==0);
}
fn decode(bytes: [u8], offset: i32) -> u64 { let value: u64=0; let index: i32=0; while (index<8) { value|=(bytes[offset+index] as u64)<<(index*8); index+=1; } return value; }
fn emit(output: core::slice::View<u8>, count: i32) {
    let sink: std::stream::Descriptor=std::stream::stdout(); let header: [u8;8]=[0;8]; let index: i32=0;
    while (index<8) { header[index]=(((count as u64)>>(index*8))&255) as u8; index+=1; }
    core::io::write_all(sink.borrow(),header,0,8).unwrap(); core::io::write_all(sink.borrow(),output.values,output.start,count).unwrap();
}
fn guards(bytes: [u8], start: i32, count: i32, size: i32) {
    let index: i32=0; while (index<start) { assert(bytes[index]==165); index+=1; }
    index=start+count; while (index<size) { assert(bytes[index]==165); index+=1; }
}
fn main() -> i32 {
    contracts(); let source: std::stream::Descriptor=std::stream::stdin(); let header: [u8;40]=[0;40];
    let key_storage: [i32;10]=[0;10]; let nonce_storage: [i32;5]=[0;5]; let input_storage: [i32;260]=[0;260]; let output_storage: [i32;260]=[0;260];
    let pk: [u8]=core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(key_storage),40);
    let pn: [u8]=core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(nonce_storage),20);
    let pi: [u8]=core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(input_storage),1040);
    let po: [u8]=core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(output_storage),1040);
    let sk: [u8;40]=[0;40]; let sn: [u8;20]=[0;20]; let si: [u8;1040]=[0;1040]; let so: [u8;1040]=[0;1040];
    while (true) {
        let received: i32=source.read(header,0,40).unwrap(); if (received==0) { return 0; }
        if (received<40) { core::io::read_exact(source.borrow(),header,received,40-received).unwrap(); }
        let mode: u64=decode(header,0); let counter: u64=decode(header,8); let length: u64=decode(header,16); let schedule: u64=decode(header,24); let layout: u64=decode(header,32);
        assert(mode<=4 && counter<=4294967295 && length<=1024 && schedule<=3 && layout<=3); let count: i32=length as i32;
        let index: i32=0; while (index<1040) { pi[index]=165; po[index]=165; si[index]=165; so[index]=165; index+=1; }
        index=0; while (index<40) { pk[index]=165; sk[index]=165; index+=1; } index=0; while (index<20) { pn[index]=165; sn[index]=165; index+=1; }
        core::io::read_exact(source.borrow(),pk,3,32).unwrap(); core::io::read_exact(source.borrow(),pn,2,12).unwrap(); core::io::read_exact(source.borrow(),pi,3,count).unwrap();
        copy(pk,sk,40); copy(pn,sn,20); copy(pi,si,1040);
        let k: core::slice::View<u8> = view(sk,3,32); let n: core::slice::View<u8> = view(sn,2,12);
        let input: core::slice::View<u8> = view(si,3,count); let output: core::slice::View<u8> = view(so,5,count+2);
        if ((layout&1)!=0) { k=view(pk,3,32); input=view(pi,3,count); }
        if ((layout&2)!=0) { n=view(pn,2,12); output=view(po,5,count+2); }
        if (mode==0) { assert(core::chacha20::xor_into(k,n,counter as u32,input,output).unwrap()==count); }
        if (mode==1) { let state: core::chacha20::State=core::chacha20::new(k,n,counter as u32).unwrap(); feed(state.borrow(),input,output,schedule as i32,false); }
        if (mode==2) { assert(core::chacha20::xor_in_place(k,n,counter as u32,input).unwrap()==count); output=input; }
        if (mode==3) { let state: core::chacha20::State=core::chacha20::new(k,n,counter as u32).unwrap(); feed(state.borrow(),input,input,schedule as i32,true); output=input; }
        if (mode==4) { assert(count==64); assert(core::chacha20::block(k,n,counter as u32,output).unwrap()==64); }
        emit(output,count); equal(pk,sk,40); equal(pn,sn,20);
        guards(pi,3,count,1040); guards(si,3,count,1040); guards(pk,3,32,40); guards(sk,3,32,40); guards(pn,2,12,20); guards(sn,2,12,20);
        if (mode==2 || mode==3) { guards(po,0,0,1040); guards(so,0,0,1040); }
        else { guards(po,5,count,1040); guards(so,5,count,1040); equal(pi,si,1040); }
    }
    return 0;
}
