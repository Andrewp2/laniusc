module app::main;
import core::char;
import core::option;
fn check_ascii_pair(upper: char, lower: char) -> bool {
    return core::char::to_ascii_lowercase(upper) == lower && core::char::to_ascii_uppercase(lower) == upper && core::char::eq_ignore_ascii_case(upper, lower);
}
fn main() -> i32 {
    let non_ascii: char = 'é';
    if (!core::char::is_ascii('A') || !core::char::is_ascii('~') || core::char::is_ascii(non_ascii)) {
        return 13;
    }
    if (!core::char::is_ascii_control('\n') || !core::char::is_ascii_control('\t') || core::char::is_ascii_control(' ') || core::char::is_ascii_control(non_ascii)) {
        return 14;
    }
    if (core::char::to_ascii_lowercase('A') != 'a' || core::char::to_ascii_lowercase('Z') != 'z' || core::char::to_ascii_lowercase('a') != 'a' || core::char::to_ascii_lowercase('0') != '0' || core::char::to_ascii_lowercase(non_ascii) != non_ascii) {
        return 15;
    }
    if (core::char::to_ascii_uppercase('a') != 'A' || core::char::to_ascii_uppercase('z') != 'Z' || core::char::to_ascii_uppercase('A') != 'A' || core::char::to_ascii_uppercase('0') != '0' || core::char::to_ascii_uppercase(non_ascii) != non_ascii) {
        return 16;
    }
    if (!check_ascii_pair('A', 'a') || !check_ascii_pair('B', 'b') || !check_ascii_pair('C', 'c') || !check_ascii_pair('D', 'd') || !check_ascii_pair('E', 'e') || !check_ascii_pair('F', 'f') || !check_ascii_pair('G', 'g') || !check_ascii_pair('H', 'h') || !check_ascii_pair('I', 'i') || !check_ascii_pair('J', 'j') || !check_ascii_pair('K', 'k') || !check_ascii_pair('L', 'l') || !check_ascii_pair('M', 'm') || !check_ascii_pair('N', 'n') || !check_ascii_pair('O', 'o') || !check_ascii_pair('P', 'p') || !check_ascii_pair('Q', 'q') || !check_ascii_pair('R', 'r') || !check_ascii_pair('S', 's') || !check_ascii_pair('T', 't') || !check_ascii_pair('U', 'u') || !check_ascii_pair('V', 'v') || !check_ascii_pair('W', 'w') || !check_ascii_pair('X', 'x') || !check_ascii_pair('Y', 'y') || !check_ascii_pair('Z', 'z')) {
        return 17;
    }
    if (!core::char::is_ascii_digit('5') || core::char::is_ascii_digit('/')) {
        return 1;
    }
    if (!core::char::is_ascii_lowercase('q') || core::char::is_ascii_lowercase('Q')) {
        return 2;
    }
    if (!core::char::is_ascii_uppercase('Q') || core::char::is_ascii_uppercase('q')) {
        return 3;
    }
    if (!core::char::is_ascii_alphabetic('Q') || !core::char::is_ascii_alphabetic('q') || core::char::is_ascii_alphabetic('5')) {
        return 4;
    }
    if (!core::char::is_ascii_alphanumeric('5') || !core::char::is_ascii_alphanumeric('q') || core::char::is_ascii_alphanumeric('_')) {
        return 5;
    }
    if (!core::char::is_ascii_word('_') || !core::char::is_ascii_word('z') || core::char::is_ascii_word('-')) {
        return 6;
    }
    if (!core::char::eq_ignore_ascii_case('A', 'a') || !core::char::eq_ignore_ascii_case('z', 'Z') || !core::char::eq_ignore_ascii_case('7', '7') || !core::char::eq_ignore_ascii_case(non_ascii, non_ascii) || core::char::eq_ignore_ascii_case(non_ascii, 'e') || core::char::eq_ignore_ascii_case('A', 'b')) {
        return 7;
    }
    if (!core::char::is_ascii_hexdigit('F') || !core::char::is_ascii_hexdigit('f') || core::char::is_ascii_hexdigit('g')) {
        return 8;
    }
    if (!core::char::is_ascii_whitespace(' ') || !core::char::is_ascii_whitespace('\n') || core::char::is_ascii_whitespace('_')) {
        return 9;
    }
    if (!core::char::is_ascii_punctuation('!') || !core::char::is_ascii_punctuation('[') || !core::char::is_ascii_punctuation('~') || core::char::is_ascii_punctuation('A')) {
        return 10;
    }
    if (!core::char::is_ascii_graphic('!') || !core::char::is_ascii_graphic('~') || core::char::is_ascii_graphic(' ')) {
        return 11;
    }
    if (!core::char::is_ascii_printable(' ') || !core::char::is_ascii_printable('~') || core::char::is_ascii_printable('\n')) {
        return 12;
    }
    let all_bits: u32 = 4294967295;
    if (!core::char::is_scalar_value(0) || !core::char::is_scalar_value(55295) ||
        core::char::is_scalar_value(55296) || core::char::is_scalar_value(57343) ||
        !core::char::is_scalar_value(57344) || !core::char::is_scalar_value(1114111) ||
        core::char::is_scalar_value(1114112) || core::char::is_scalar_value(all_bits)) {
        return 18;
    }
    let omega_code: u32 = 937;
    let last_code: u32 = 1114111;
    let omega: char = core::option::unwrap_or(core::char::from_u32(omega_code), '?');
    let last: char = core::char::from_u32_or(last_code, '?');
    if (omega != 'Ω' || !(omega > 'A') || core::char::from_u32_or(128512, '?') != '😀' ||
        core::char::from_u32_or(65, '?') != 'A' || core::char::from_u32_or(0, '?') != '\0' ||
        (last as u32) != last_code || !(last > '😀')) {
        return 19;
    }
    if (core::char::from_u32_or(55296, '?') != '?' ||
        core::char::from_u32_or(1114112, '?') != '?' ||
        core::char::from_u32_or(all_bits, '?') != '?' ||
        core::option::is_some(core::char::from_u32(57343)) ||
        core::option::is_none(core::char::from_u32(57344))) {
        return 20;
    }
    return 0;
}
