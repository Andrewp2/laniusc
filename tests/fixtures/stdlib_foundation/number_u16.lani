    }
    if (!core::u16::is_multiple_of(12, 3) || core::u16::is_multiple_of(13, 3) || core::u16::is_multiple_of(0, 0) || !core::u16::is_multiple_of(0, 7)) {
        return 15;
    }
    if (core::option::unwrap_or(core::u16::checked_div(13, 5), fallback) != 2 || core::option::unwrap_or(core::u16::checked_div(13, 0), fallback) != fallback || core::option::unwrap_or(core::u16::checked_rem(13, 5), fallback) != 3 || core::option::unwrap_or(core::u16::checked_rem(13, 0), fallback) != fallback) {
