        return 19;
    }
    if (core::option::unwrap_or(core::u16::checked_align_up(5, 4), fallback) != 8 || core::option::unwrap_or(core::u16::checked_align_up(8, 4), fallback) != 8 || core::option::unwrap_or(core::u16::checked_align_up(high, 2), fallback) != fallback || core::option::unwrap_or(core::u16::checked_align_up(1, 0), fallback) != fallback || core::option::unwrap_or(core::u16::checked_align_up(high, high), fallback) != high) {
