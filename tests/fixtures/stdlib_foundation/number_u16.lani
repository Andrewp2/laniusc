        return 3;
    }
    if (core::u16::saturating_add(3, 4) != 7 || core::u16::saturating_add(high, 1) != high || core::u16::saturating_add(0, 0) != 0) {
        return 4;
    }
    if (core::u16::saturating_sub(9, 4) != 5 || core::u16::saturating_sub(4, 9) != 0 || core::u16::saturating_sub(high, high) != 0) {
        return 5;
    }
    if (core::u16::saturating_mul(256, 255) != 65280 || core::u16::saturating_mul(256, 256) != high || core::u16::saturating_mul(high, high) != high || core::u16::saturating_mul(high, 0) != 0) {
        return 6;
    }
    if (core::u16::wrapping_add(high, 1) != 0 || core::u16::wrapping_add(60000, 6000) != 464 || core::u16::wrapping_add(3, 4) != 7) {
        return 7;
    }
    if (core::u16::wrapping_sub(0, 1) != high || core::u16::wrapping_sub(3, 5) != 65534 || core::u16::wrapping_sub(9, 4) != 5) {
        return 8;
    }
    if (core::u16::wrapping_mul(high, high) != 1 || core::u16::wrapping_mul(256, 256) != 0 || core::u16::wrapping_mul(7, 9) != 63) {
        return 9;
    }
    if (core::u16::abs_diff(3, 9) != 6 || core::u16::abs_diff(9, 3) != 6 || core::u16::abs_diff(high, 0) != high) {
        return 10;
    }
    if (core::u16::gcd(24, 18) != 6 || core::u16::gcd(0, 0) != 0 || core::u16::gcd(high, high) != high) {
        return 11;
    }
    if (core::option::unwrap_or(core::u16::checked_lcm(6, 8), fallback) != 24 || core::option::unwrap_or(core::u16::checked_lcm(0, high), fallback) != 0 || core::option::unwrap_or(core::u16::checked_lcm(high, 2), fallback) != fallback || core::option::unwrap_or(core::u16::checked_lcm(high, 1), fallback) != high) {
        return 12;
    }
    if (core::option::unwrap_or(core::u16::checked_pow(3, 4), fallback) != 81 || core::option::unwrap_or(core::u16::checked_pow(0, 0), fallback) != 1 || core::option::unwrap_or(core::u16::checked_pow(2, 15), fallback) != 32768 || core::option::unwrap_or(core::u16::checked_pow(2, 16), fallback) != fallback || core::option::unwrap_or(core::u16::checked_pow(high, 2), fallback) != fallback) {
        return 13;
    }
    if (!core::u16::is_zero(0) || core::u16::is_zero(1) || !core::u16::is_nonzero(high) || core::u16::is_nonzero(0) || !core::u16::is_even(2) || core::u16::is_even(3) || !core::u16::is_odd(3) || core::u16::is_odd(2)) {
