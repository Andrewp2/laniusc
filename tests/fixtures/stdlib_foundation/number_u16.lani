    }
    if (!core::u16::is_power_of_two(1) || !core::u16::is_power_of_two(32768) || core::u16::is_power_of_two(0) || core::u16::is_power_of_two(high)) {
        return 17;
    }
    if (core::option::unwrap_or(core::u16::checked_next_power_of_two(0), 0) != 1 || core::option::unwrap_or(core::u16::checked_next_power_of_two(1), 0) != 1 || core::option::unwrap_or(core::u16::checked_next_power_of_two(3), 0) != 4 || core::option::unwrap_or(core::u16::checked_next_power_of_two(32768), 0) != 32768 || core::option::unwrap_or(core::u16::checked_next_power_of_two(32769), 0) != 0) {
