module app::main;
import core::option;
import core::u16;
fn main() -> i32 {
    let zero: u16 = 0;
    let high: u16 = 65535;
    let fallback: u16 = 123;
    if (core::u16::MIN != zero || core::u16::MAX != high) {
        return 1;
    }
    if (core::u16::min(3, 9) != 3 || core::u16::max(3, 9) != 9 || core::u16::min(high, zero) != zero) {
        return 2;
    }
