module app::main;
import alloc::vec;
import core::option;
import core::result;
import core::slice;
fn allocation(error: alloc::vec::Error) -> bool {
    let yes: bool = match (error) { alloc::vec::Error::AllocationFailed -> true, _ -> false }; return yes;
}
fn main() -> i32 {
    let data: [i32; 4] = [1, 4, 2, 3];
    let view: core::slice::View<i32> = core::result::unwrap(core::slice::view(data, 4));
    let built: core::result::Result<alloc::vec::Vec<i32>, alloc::vec::Error> = alloc::vec::from_view(view);
    if (core::result::is_err(built)) { if (!allocation(core::result::unwrap_err(built))) { return 1; } return 0; }
    let values: alloc::vec::Vec<i32> = core::result::unwrap(built);
    let operation: i32 = 0;
    while (operation < 9) {
        let before: core::slice::View<i32> = values.as_view();
        let length: i32 = values.len(); let capacity: i32 = values.capacity();
        let snapshot: [i32; 64] = [0; 64]; let index: i32 = 0;
        while (index < length) { snapshot[index] = core::option::unwrap(before.get(index)); index += 1; }
        let edited: core::result::Result<i32, alloc::vec::Error> = core::result::Ok(0);
        if (operation == 0) { edited = values.try_push(9); }
        else { if (operation == 1) { edited = values.try_reserve(32); }
        else { if (operation == 2) { edited = values.try_shrink_to_fit(); }
        else { if (operation == 3) { edited = values.try_extend(before); }
        else { if (operation == 4) {
            let cloned: core::result::Result<alloc::vec::Vec<i32>, alloc::vec::Error> = values.try_clone();
            if (core::result::is_err(cloned)) { edited = core::result::Err(core::result::unwrap_err(cloned)); }
            else { let copy: alloc::vec::Vec<i32> = core::result::unwrap(cloned); copy.destroy(); }
        } else { if (operation == 5) { edited = values.try_insert(0, 17); }
        else { if (operation == 6) { edited = values.try_resize(30, 6); }
        else { if (operation == 7) { edited = values.try_reserve(128); }
        else {
            let made: core::result::Result<alloc::vec::Vec<i32>, alloc::vec::Error> = alloc::vec::with_capacity(4);
            if (core::result::is_err(made)) { edited = core::result::Err(core::result::unwrap_err(made)); }
            else { let empty: alloc::vec::Vec<i32> = core::result::unwrap(made); empty.destroy(); }
        } } } } } } } }
        if (core::result::is_err(edited)) {
            if (!allocation(core::result::unwrap_err(edited)) || values.len() != length || values.capacity() != capacity) { return 2; }
            index = 0;
            while (index < length) {
                if (core::option::unwrap(before.get(index)) != snapshot[index] || values.at(index) != snapshot[index]) { return 3; }
                index += 1;
            }
        }
        operation += 1;
    }
    values.destroy(); return 0;
}
