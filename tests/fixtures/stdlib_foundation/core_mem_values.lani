module app::main;
import core::mem;
fn main() -> i32 {
    if (core::mem::identity(7) != 7) {
        return 1;
    }
    if (core::mem::first(7, 9) != 7) {
        return 2;
    }
    if (core::mem::second(7, 9) != 9) {
        return 3;
    }
    if (core::mem::select(true, 7, 9) != 7 || core::mem::select(false, 7, 9) != 9) {
        return 4;
    }
    if (!core::mem::identity(true) || core::mem::identity(false)) {
        return 5;
    }
    return 0;
}
