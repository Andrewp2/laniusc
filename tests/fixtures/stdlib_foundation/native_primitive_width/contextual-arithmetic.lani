struct Wide { value: u64 }
fn take(value: u64) -> u64 { return value; }
fn choose<T>(left: T, right: T, first: bool) -> T { if (first) { return left; } return right; }
fn from_return() -> u64 { return (4294967296 + 7) * 3 - 2; }
fn main() -> i32 {
    let wide: u64 = 10000000000;
    if (take((4294967296 + 7) * 3 - 2) != 12884901907 || from_return() != 12884901907) { return 1; }
    if (choose(1 + 2, wide, true) != 3 || choose(1 + 2, wide, false) != wide) { return 2; }
    if (choose(wide, (1 + 2) * (3 + 4), false) != 21) { return 3; }
    let record: Wide = Wide { value: (4294967296 + 3) * 2 };
