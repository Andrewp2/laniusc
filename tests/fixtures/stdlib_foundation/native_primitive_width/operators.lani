    if (signed_maximum + 1 != minimum || minimum - 1 != signed_maximum) { return 12; }
    let signed_word: i64 = 4294967296;
    if ((signed_word << 31) != minimum || signed_word * 3 != 12884901888) { return 13; }
    return 0;
}
