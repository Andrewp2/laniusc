module app::main;
import core::wide_u64;
import std::vec_wide_u64;
fn main() -> i32 {
    let minimum: core::wide_u64::WideU64 = core::wide_u64::from_words(2147483648, 0);
    let value: std::vec_wide_u64::VecWideU64 = std::vec_wide_u64::try_with_capacity(1);
    value = std::vec_wide_u64::try_push(value, minimum);
    value = std::vec_wide_u64::try_insert(value, 0, core::wide_u64::max_value());
    if (std::vec_wide_u64::len(value) == 1 && std::vec_wide_u64::capacity(value) == 1 && core::wide_u64::eq(std::vec_wide_u64::get_or(value, 0, core::wide_u64::zero()), minimum)) {
        std::vec_wide_u64::destroy(value);
        return 0;
    }
    std::vec_wide_u64::destroy(value);
    return 1;
}
