module app::main;
import std::vec_i32;

fn main() -> i32 {
    let value: std::vec_i32::VecI32 = std::vec_i32::new();
    let empty_edited: std::vec_i32::VecI32 = std::vec_i32::new();
    empty_edited = std::vec_i32::try_insert(empty_edited, 0, 99);
    if (std::vec_i32::len(empty_edited) != 1 || std::vec_i32::capacity(empty_edited) != 4 ||
        std::vec_i32::get_or(empty_edited, 0, -1) != 99) { return 35; }
    empty_edited = std::vec_i32::try_remove(empty_edited, 0);
    if (std::vec_i32::len(empty_edited) != 0 || std::vec_i32::capacity(empty_edited) != 4) { return 36; }
    std::vec_i32::destroy(empty_edited);
    let empty_copy: std::vec_i32::VecI32 = std::vec_i32::try_clone(value);
    if (std::vec_i32::len(empty_copy) != 0 || std::vec_i32::capacity(empty_copy) != 0) { return 22; }
    std::vec_i32::destroy(empty_copy);
    if (std::vec_i32::len(value) != 0 || std::vec_i32::capacity(value) != 0) { return 1; }
    if (!std::vec_i32::is_empty(value)) { return 2; }
    if (std::vec_i32::get_or(value, 0, 77) != 77) { return 3; }
    if (std::vec_i32::try_set(value, 0, 5)) { return 4; }
    let unchanged: std::vec_i32::VecI32 = std::vec_i32::try_pop(value);
    if (std::vec_i32::len(unchanged) != 0) { return 5; }

    value = std::vec_i32::try_push(value, 10);
    if (std::vec_i32::len(value) != 1 || std::vec_i32::capacity(value) != 4) { return 6; }
    value = std::vec_i32::try_push(value, 20);
    value = std::vec_i32::try_push(value, 30);
    value = std::vec_i32::try_push(value, 40);
    value = std::vec_i32::try_push(value, 50);
    if (std::vec_i32::len(value) != 5 || std::vec_i32::capacity(value) != 8) { return 7; }
    let copy: std::vec_i32::VecI32 = std::vec_i32::try_clone(value);
    if (std::vec_i32::len(copy) != 5 || std::vec_i32::capacity(copy) != 5 ||
        std::vec_i32::get_or(copy, 1, -1) != 20 ||
        std::vec_i32::get_or(copy, 2, -1) != 30) { return 23; }
    if (!std::vec_i32::try_set(copy, 1, 99) ||
        std::vec_i32::get_or(copy, 1, -1) != 99 ||
        std::vec_i32::get_or(value, 1, -1) != 20) { return 24; }
    std::vec_i32::destroy(copy);
    let edited: std::vec_i32::VecI32 = std::vec_i32::try_clone(value);
    edited = std::vec_i32::try_insert(edited, -1, 99);
    edited = std::vec_i32::try_insert(edited, 6, 99);
    edited = std::vec_i32::try_remove(edited, -1);
    edited = std::vec_i32::try_remove(edited, 5);
    if (std::vec_i32::len(edited) != 5 || std::vec_i32::capacity(edited) != 5 ||
        std::vec_i32::get_or(edited, 1, -1) != 20) { return 30; }
    edited = std::vec_i32::try_insert(edited, 0, 99);
    if (std::vec_i32::len(edited) != 6 || std::vec_i32::capacity(edited) != 10 ||
        std::vec_i32::get_or(edited, 0, -1) != 99 ||
        std::vec_i32::get_or(edited, 1, -1) != 10 ||
        std::vec_i32::get_or(edited, 2, -1) != 20) { return 31; }
    edited = std::vec_i32::try_insert(edited, 3, 20);
    if (std::vec_i32::len(edited) != 7 ||
        std::vec_i32::get_or(edited, 3, -1) != 20 ||
        std::vec_i32::get_or(edited, 4, -1) != 30) { return 32; }
    edited = std::vec_i32::try_insert(edited, 7, 99);
    if (std::vec_i32::len(edited) != 8 ||
        std::vec_i32::get_or(edited, 7, -1) != 99 ||
        std::vec_i32::get_or(edited, 6, -1) != 50) { return 33; }
    edited = std::vec_i32::try_remove(edited, 0);
    edited = std::vec_i32::try_remove(edited, 2);
    edited = std::vec_i32::try_remove(edited, 5);
    if (std::vec_i32::len(edited) != 5 || std::vec_i32::capacity(edited) != 10 ||
        std::vec_i32::get_or(edited, 0, -1) != 10 ||
        std::vec_i32::get_or(edited, 1, -1) != 20 ||
        std::vec_i32::get_or(edited, 2, -1) != 30 ||
        std::vec_i32::get_or(edited, 4, -1) != 50 ||
        std::vec_i32::get_or(value, 1, -1) != 20) { return 34; }
    std::vec_i32::destroy(edited);
    if (std::vec_i32::is_empty(value)) { return 8; }
    if (std::vec_i32::get_or(value, 0, -1) != 10 || std::vec_i32::get_or(value, 4, -1) != 50) { return 9; }
    if (std::vec_i32::get_or(value, -1, 88) != 88 || std::vec_i32::get_or(value, 5, 88) != 88) { return 10; }
    if (std::vec_i32::try_set(value, -1, 99) || std::vec_i32::try_set(value, 5, 99)) { return 11; }
    if (!std::vec_i32::try_set(value, 2, 33) || std::vec_i32::get_or(value, 2, -1) != 33) { return 12; }

    value = std::vec_i32::try_reserve(value, 11);
    if (std::vec_i32::capacity(value) != 11 || std::vec_i32::get_or(value, 2, -1) != 33) { return 13; }
    value = std::vec_i32::try_reserve(value, -1);
    value = std::vec_i32::try_reserve(value, 536870912);
    value = std::vec_i32::try_reserve(value, 5);
    if (std::vec_i32::capacity(value) != 11) { return 14; }
    value = std::vec_i32::try_pop(value);
    if (std::vec_i32::len(value) != 4 || std::vec_i32::get_or(value, 4, 91) != 91) { return 15; }
    value = std::vec_i32::clear(value);
    if (std::vec_i32::len(value) != 0 || std::vec_i32::capacity(value) != 11) { return 16; }
    value = std::vec_i32::try_push(value, -2147483648);
    if (std::vec_i32::get_or(value, 0, 0) != -2147483648) { return 17; }
    std::vec_i32::destroy(value);

    let preallocated: std::vec_i32::VecI32 = std::vec_i32::try_with_capacity(2);
    if (std::vec_i32::capacity(preallocated) != 2) { return 18; }
    preallocated = std::vec_i32::try_push(preallocated, 2147483647);
    if (std::vec_i32::get_or(preallocated, 0, 0) != 2147483647) { return 19; }
    std::vec_i32::destroy(preallocated);
    let invalid: std::vec_i32::VecI32 = std::vec_i32::try_with_capacity(-1);
    if (std::vec_i32::capacity(invalid) != 0) { return 20; }
    std::vec_i32::destroy(invalid);
    if (std::vec_i32::MAX_CAPACITY != 536870911) { return 21; }
    return 0;
}
