// Ordinary bounded-scratch stream consumer: all four variants, no heap storage.
module app::main;
import core::io;
import core::mem;
import core::result;
import core::sha512;
import core::slice;
import std::stream;
fn publish(sink: &std::stream::Descriptor, value: core::sha512::Digest) { core::io::write_all(sink,value.bytes,0,value.length).unwrap(); }
fn main() -> i32 {
    let sha512: core::sha512::State=core::sha512::new(); let sha384: core::sha512::State=core::sha512::new384();
    let sha224: core::sha512::State=core::sha512::new512_224(); let sha256: core::sha512::State=core::sha512::new512_256();
    let source: std::stream::Descriptor=std::stream::stdin(); let sink: std::stream::Descriptor=std::stream::stdout();
    let storage: [i32;257]=[0;257]; let bytes: [u8]=core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(storage),1028);
    while (true) {
        let received: i32=source.read(bytes,3,1024).unwrap(); if (received == 0) { break; }
        let input: core::slice::View<u8> = core::slice::view_range(bytes,3,received).unwrap();
        assert(sha512.update(input).unwrap() == received && sha384.update(input).unwrap() == received && sha224.update(input).unwrap() == received && sha256.update(input).unwrap() == received);
    }
    publish(sink.borrow(),sha512.finish()); publish(sink.borrow(),sha384.finish()); publish(sink.borrow(),sha224.finish()); publish(sink.borrow(),sha256.finish()); return 0;
}
