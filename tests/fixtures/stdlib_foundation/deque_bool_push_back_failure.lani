module app::main;
import std::deque_bool;

fn main() -> i32 {
    let value: std::deque_bool::DequeBool = std::deque_bool::try_with_capacity(2);
    if (std::deque_bool::capacity(value) != 2) { return 5; }
    value = std::deque_bool::try_push_back(value, true);
    value = std::deque_bool::try_push_back(value, false);
    value = std::deque_bool::try_push_back(value, true);
    let failure: bool = std::deque_bool::capacity(value) == 2 &&
        std::deque_bool::len(value) == 2 &&
        std::deque_bool::at_or(value, 0, false) == true &&
        std::deque_bool::at_or(value, 1, false) == false;
    let success: bool = std::deque_bool::capacity(value) == 4 &&
        std::deque_bool::len(value) == 3 &&
        std::deque_bool::at_or(value, 0, false) == true &&
        std::deque_bool::at_or(value, 1, false) == false &&
        std::deque_bool::at_or(value, 2, false) == true;
    std::deque_bool::destroy(value);
    if (failure) { return 0; }
    if (success) { return 4; }
    return 5;
}
