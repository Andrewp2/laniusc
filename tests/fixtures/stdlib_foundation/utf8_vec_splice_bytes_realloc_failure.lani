module app::main;
import std::utf8_vec;
import std::vec_u8;

fn main() -> i32 {
    let f0: u8 = 240;
    let cont9f: u8 = 159;
    let cont99: u8 = 153;
    let cont82: u8 = 130;
    let smile: [u8; 4] = [f0, cont9f, cont99, cont82];
    let value: std::vec_u8::VecU8 = std::vec_u8::try_with_capacity(4);
    if (std::vec_u8::capacity(value) != 4) { return 2; }
    value = std::utf8_vec::try_append_scalar(value, 65);
    value = std::utf8_vec::try_append_scalar(value, 162);
    value = std::utf8_vec::try_append_scalar(value, 66);
    if (std::utf8_vec::byte_len(value) != 4) { return 3; }
    value = std::utf8_vec::try_splice_bytes(value, 1, 1, smile, 4);
    if (std::utf8_vec::byte_len(value) == 6) {
        std::utf8_vec::destroy(value);
        return 4;
    }
    if (std::utf8_vec::byte_len(value) != 4 ||
        std::vec_u8::capacity(value) != 4 ||
        std::utf8_vec::scalar_count_or(value, -9) != 3 ||
        std::vec_u8::get_or(value, 0, 0) != 65 ||
        std::vec_u8::get_or(value, 1, 0) != 194 ||
        std::vec_u8::get_or(value, 2, 0) != 162 ||
        std::vec_u8::get_or(value, 3, 0) != 66) { return 5; }
    std::utf8_vec::destroy(value);
    return 0;
}
