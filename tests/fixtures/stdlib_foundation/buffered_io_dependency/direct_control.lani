module app::main;
import core::io;
import core::result;
import core::buffer_probe;
fn main() -> i32 {
    let bytes: [u8; 3] = [1, 2, 3];
    let output: [u8; 3] = [0; 3];
    let sink: core::io::SliceWriter = core::result::unwrap(core::io::slice_writer(output, 3));
    let adapter: core::buffer_probe::Forward<core::io::SliceWriter> = core::buffer_probe::forward(sink.borrow());
    let result: core::result::Result<i32, core::io::Error> = adapter.write(bytes, 0, 3);
    if (core::result::unwrap(result) != 3 || sink.position() != 3 || output[2] != 3) { return 1; }
    return 0;
}
