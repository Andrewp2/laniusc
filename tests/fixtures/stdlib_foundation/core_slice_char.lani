module app::main;
import core::slice_char;

fn main() -> i32 {
    let a: char = 'a';
    let z: char = 'z';
    let e: char = 'é';
    let enye: char = 'ñ';
    let omega: char = 'Ω';
    let smile: char = '😀';
    let newline: char = '\n';
    let digit: char = '0';
    if (e as i32 != 233 || enye as i32 != 241 ||
        omega as i32 != 937 || smile as i32 != 128512 ||
        newline as i32 != 10 ||
        e == enye || !(e < enye) || !(enye < omega) ||
        !(omega < smile)) { return 17; }
    let unicode_order: [char; 4] = [smile, omega, enye, e];
    if (!core::slice_char::sort(unicode_order, 4) ||
        unicode_order[0] != e || unicode_order[1] != enye ||
        unicode_order[2] != omega || unicode_order[3] != smile ||
        core::slice_char::lower_bound_or(unicode_order, 4, omega, -1) != 2) {
        return 18;
    }
    let values: [char; 5] = [z, a, e, a, z];
    if (core::slice_char::get_or(values, 5, 0, digit) != z ||
        core::slice_char::get_or(values, 5, 2, digit) != e ||
        core::slice_char::get_or(values, 5, -1, digit) != digit ||
        core::slice_char::get_or(values, 0, 0, digit) != digit ||
        core::slice_char::get_or(values, 5, 5, digit) != digit) { return 1; }
    if (core::slice_char::set(values, -1, 0, a) ||
        core::slice_char::set(values, 5, -1, a) ||
        core::slice_char::set(values, 5, 5, a) ||
        values[0] != z ||
        !core::slice_char::set(values, 5, 1, e) || values[1] != e) { return 2; }
    if (core::slice_char::fill(values, -1, a) != 0 ||
        core::slice_char::fill(values, 0, a) != 0 || values[0] != z ||
        core::slice_char::fill(values, 5, z) != 5 ||
        values[0] != z || values[4] != z) { return 3; }
    values[0] = a;
    if (core::slice_char::swap(values, 5, -1, 0) ||
        core::slice_char::swap(values, 5, 0, 5) ||
        values[0] != a || !core::slice_char::swap(values, 5, 0, 1) ||
        values[0] != z || values[1] != a) { return 4; }

    let moved: [char; 5] = [a, z, e, omega, z];
    if (core::slice_char::copy_within(moved, 5, 0, 6, 0) ||
        core::slice_char::copy_within(moved, 5, 3, 2, 0) ||
        core::slice_char::copy_within(moved, 5, 0, 4, 2) ||
        core::slice_char::copy_within(moved, -1, 0, 0, 0) ||
        moved[0] != a || moved[3] != omega ||
        !core::slice_char::copy_within(moved, 5, 0, 3, 2) ||
        moved[0] != a || moved[1] != z || moved[2] != a ||
        moved[3] != z || moved[4] != e ||
        !core::slice_char::copy_within(moved, 5, 2, 5, 0) ||
        moved[0] != a || moved[1] != z || moved[2] != e) { return 5; }
    if (core::slice_char::reverse(moved, -1) != 0 ||
        core::slice_char::reverse(moved, 0) != 0 ||
        core::slice_char::reverse(moved, 5) != 5 ||
        moved[0] != e || moved[1] != z || moved[2] != e ||
        moved[3] != z || moved[4] != a) { return 6; }
    let copied: [char; 5] = [digit, digit, digit, digit, digit];
    if (core::slice_char::copy_prefix(moved, -1, copied, 5) != -1 ||
        core::slice_char::copy_prefix(moved, 5, copied, -1) != -1 ||
        copied[0] != digit ||
        core::slice_char::copy_prefix(moved, 0, copied, 5) != 0 ||
        core::slice_char::copy_prefix(moved, 5, copied, 3) != 3 ||
        copied[0] != e || copied[1] != z || copied[2] != e ||
        copied[3] != digit ||
        core::slice_char::copy_prefix(moved, 5, moved, 5) != 5) { return 7; }

    let text: [char; 5] = [a, e, a, e, z];
    let same: [char; 5] = [a, e, a, e, z];
    let different: [char; 5] = [a, e, a, e, omega];
    let pair: [char; 2] = [a, e];
    let absent: [char; 2] = [z, omega];
    if (!core::slice_char::contains(text, 5, e) ||
        core::slice_char::contains(text, 5, omega) ||
        core::slice_char::contains(text, -1, a) ||
        core::slice_char::count(text, 5, e) != 2 ||
        core::slice_char::count(text, 0, e) != 0 ||
        core::slice_char::count(text, -1, e) != -1 ||
        core::slice_char::first_index_or(text, 5, e, -7) != 1 ||
        core::slice_char::last_index_or(text, 5, e, -7) != 3 ||
        core::slice_char::first_index_or(text, 5, omega, -7) != -7 ||
        core::slice_char::last_index_or(text, 0, e, -7) != -7) { return 8; }
    if (!core::slice_char::equal(text, 5, same, 5) ||
        core::slice_char::equal(text, 5, different, 5) ||
        core::slice_char::equal(text, 5, same, 4) ||
        core::slice_char::equal(text, -1, same, -1) ||
        !core::slice_char::equal(text, 0, different, 0) ||
        !core::slice_char::starts_with(text, 5, pair, 2) ||
        !core::slice_char::starts_with(text, 5, absent, 0) ||
        core::slice_char::starts_with(text, 5, absent, 2) ||
        core::slice_char::starts_with(text, -1, pair, 0) ||
        !core::slice_char::ends_with(text, 5, pair, 0) ||
        core::slice_char::ends_with(text, 5, pair, 2) ||
        core::slice_char::ends_with(text, 1, pair, 2)) { return 9; }
    let suffix: [char; 2] = [e, z];
    if (!core::slice_char::ends_with(text, 5, suffix, 2) ||
        core::slice_char::compare_lexicographic_or(text, 5, same, 5, -7) != 0 ||
        core::slice_char::compare_lexicographic_or(text, 5, different, 5, -7) != -1 ||
        core::slice_char::compare_lexicographic_or(different, 5, text, 5, -7) != 1 ||
        core::slice_char::compare_lexicographic_or(text, 2, same, 5, -7) != -1 ||
        core::slice_char::compare_lexicographic_or(text, -1, same, 5, -7) != -7) { return 10; }
    if (core::slice_char::index_of_subslice_or(text, 5, pair, 2, -7) != 0 ||
        core::slice_char::last_index_of_subslice_or(text, 5, pair, 2, -7) != 2 ||
        core::slice_char::index_of_subslice_or(text, 5, pair, 0, -7) != 0 ||
        core::slice_char::last_index_of_subslice_or(text, 5, pair, 0, -7) != 5 ||
        core::slice_char::index_of_subslice_or(text, 5, absent, 2, -7) != -7 ||
        core::slice_char::last_index_of_subslice_or(text, 5, absent, 2, -7) != -7 ||
        core::slice_char::index_of_subslice_or(text, -1, pair, 2, -7) != -7 ||
        core::slice_char::last_index_of_subslice_or(text, 5, pair, -1, -7) != -7) { return 11; }

    let ordered: [char; 5] = [e, z, a, z, a];
    if (core::slice_char::is_sorted(ordered, 5) ||
        core::slice_char::is_sorted(ordered, -1) ||
        !core::slice_char::sort(ordered, 5) ||
        !core::slice_char::is_sorted(ordered, 5) ||
        ordered[0] != a || ordered[1] != a || ordered[2] != z ||
        ordered[3] != z || ordered[4] != e ||
        core::slice_char::sort(ordered, -1) ||
        !core::slice_char::sort(ordered, 0)) { return 12; }
    if (core::slice_char::lower_bound_or(ordered, 5, a, -7) != 0 ||
        core::slice_char::upper_bound_or(ordered, 5, a, -7) != 2 ||
        core::slice_char::lower_bound_or(ordered, 5, z, -7) != 2 ||
        core::slice_char::upper_bound_or(ordered, 5, z, -7) != 4 ||
        core::slice_char::lower_bound_or(ordered, 5, omega, -7) != 5 ||
        core::slice_char::upper_bound_or(ordered, 5, digit, -7) != 0 ||
        core::slice_char::binary_search_first_or(ordered, 5, z, -7) != 2 ||
        core::slice_char::binary_search_last_or(ordered, 5, z, -7) != 3 ||
        core::slice_char::binary_search_first_or(ordered, 5, omega, -7) != -7 ||
        core::slice_char::binary_search_last_or(ordered, 5, digit, -7) != -7) { return 13; }
    let unsorted: [char; 2] = [z, a];
    if (core::slice_char::lower_bound_or(unsorted, 2, a, -7) != -7 ||
        core::slice_char::upper_bound_or(unsorted, 2, a, -7) != -7 ||
        core::slice_char::binary_search_first_or(unsorted, 2, a, -7) != -7 ||
        core::slice_char::binary_search_last_or(unsorted, 2, a, -7) != -7 ||
        core::slice_char::lower_bound_or(ordered, -1, a, -7) != -7 ||
        core::slice_char::upper_bound_or(ordered, 0, a, -7) != 0) { return 14; }

    let work: [char; 5] = [a, a, a, a, a];
    let code: i32 = 0;
    while (code < 243) {
        let digits: i32 = code;
        let a_count: i32 = 0;
        let z_count: i32 = 0;
        let index: i32 = 0;
        while (index < 5) {
            let current: i32 = digits % 3;
            digits = digits / 3;
            let character: char = e;
            if (current == 0) { character = a; a_count += 1; }
            if (current == 1) { character = z; z_count += 1; }
            work[index] = character;
            index += 1;
        }
        if (!core::slice_char::sort(work, 5) || !core::slice_char::is_sorted(work, 5)) {
            return 15;
        }
        index = 0;
        while (index < 5) {
            let expected: char = e;
            if (index < a_count) { expected = a; }
            else { if (index < a_count + z_count) { expected = z; } }
            if (work[index] != expected) { return 16; }
            index += 1;
        }
        code += 1;
    }
    return 0;
}
