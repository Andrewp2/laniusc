module app::main;
import alloc::slice;
import core::ordering;
import core::result;
import core::slice;
struct Wrong {}
impl Wrong { fn borrow(&self) -> &Wrong { return self; } }
pub impl core::ordering::Comparator<i32,u64> for Wrong {
    pub fn compare(&self,left:i32,right:u64) -> core::ordering::Ordering { return core::ordering::Ordering::Equal; }
}
fn main() -> i32 {
    let data:[i32;2]=[2,1]; let order:Wrong=Wrong {};
    let view:core::slice::View<i32> = core::slice::view<i32>(data,2).unwrap();
    let rejected:core::result::Result<i32,alloc::slice::Error> = alloc::slice::sort_by<i32,Wrong>(view,order.borrow()); // rejected_stable_bound
    return 0;
}
