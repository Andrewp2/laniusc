module app::main;
import core::range_u8;

fn main() -> i32 {
    let start: u8 = 128;
    let middle: u8 = 200;
    let end: u8 = 250;
    let maximum: u8 = 255;
    let half: core::range_u8::RangeU8 = core::range_u8::range(start, end);
    let overlap: core::range_u8::RangeU8 = core::range_u8::range(middle, maximum);
    let touch: core::range_u8::RangeU8 = core::range_u8::range(end, maximum);
    let reversed: core::range_u8::RangeU8 = core::range_u8::range(end, start);
    if (core::range_u8::start(half) != start ||
        core::range_u8::end(half) != end) { return 1; }
    if (core::range_u8::is_empty(half) ||
        !core::range_u8::is_empty(reversed)) { return 2; }
    if (!core::range_u8::contains(half, start) ||
        !core::range_u8::contains(half, middle) ||
        core::range_u8::contains(half, end)) { return 3; }
    if (!core::range_u8::overlaps(half, overlap) ||
        core::range_u8::overlaps(half, touch) ||
        core::range_u8::overlaps(half, reversed)) { return 4; }

    let closed: core::range_u8::RangeInclusiveU8 = core::range_u8::range_inclusive(start, end);
    let closed_touch: core::range_u8::RangeInclusiveU8 = core::range_u8::range_inclusive(end, maximum);
    let closed_reversed: core::range_u8::RangeInclusiveU8 = core::range_u8::range_inclusive(end, start);
    if (core::range_u8::start_inclusive(closed) != start ||
        core::range_u8::end_inclusive(closed) != end) { return 5; }
    if (core::range_u8::is_empty_inclusive(closed) ||
        !core::range_u8::is_empty_inclusive(closed_reversed)) { return 6; }
    if (!core::range_u8::contains_inclusive(closed, start) ||
        !core::range_u8::contains_inclusive(closed, end) ||
        core::range_u8::contains_inclusive(closed, maximum)) { return 7; }
    if (!core::range_u8::overlaps_inclusive(closed, closed_touch) ||
        core::range_u8::overlaps_inclusive(closed, closed_reversed)) { return 8; }

    let from: core::range_u8::RangeFromU8 = core::range_u8::range_from(middle);
    if (core::range_u8::start_from(from) != middle ||
        core::range_u8::contains_from(from, start) ||
        !core::range_u8::contains_from(from, maximum)) { return 9; }
    let to: core::range_u8::RangeToU8 = core::range_u8::range_to(end);
    if (core::range_u8::end_to(to) != end ||
        !core::range_u8::contains_to(to, middle) ||
        core::range_u8::contains_to(to, end)) { return 10; }
    return 0;
}
