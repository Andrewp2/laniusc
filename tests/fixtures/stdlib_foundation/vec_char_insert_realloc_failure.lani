module app::main;
import std::vec_char;

fn main() -> i32 {
    let high_code: u32 = 2147483648;
    let max_code: u32 = 4294967295;
    let high_bit: char = high_code;
    let maximum: char = max_code;
    let first: char = high_bit;
    let second: char = maximum;
    let inserted: char = 1;
    let fallback: char = 0;
    let value: std::vec_char::VecChar = std::vec_char::try_with_capacity(2);
    if (std::vec_char::capacity(value) != 2) { return 2; }
    value = std::vec_char::try_push(value, first);
    value = std::vec_char::try_push(value, second);
    if (std::vec_char::len(value) != 2) { return 3; }
    value = std::vec_char::try_insert(value, 1, inserted);
    if (std::vec_char::len(value) == 3) {
        if (std::vec_char::get_or(value, 0, fallback) != first ||
            std::vec_char::get_or(value, 1, fallback) != inserted ||
            std::vec_char::get_or(value, 2, fallback) != second) { return 6; }
        std::vec_char::destroy(value);
        return 4;
    }
    if (std::vec_char::len(value) != 2 ||
        std::vec_char::capacity(value) != 2 ||
        std::vec_char::get_or(value, 0, fallback) != first ||
        std::vec_char::get_or(value, 1, fallback) != second) { return 5; }
    std::vec_char::destroy(value);
    return 0;
}
