// Test-only native varint wire and scalar adapter.
module app::main;

import core::mem;
import core::option;
import core::varint;
import core::result;
import core::slice;
import std::io;

fn read_exact(pointer: ptr, count: i32, allow_eof: bool) -> bool {
    let done: i32 = 0;
    while (done < count) {
        let got: i32 = std::io::read_stdin(pointer + (done as usize), (count - done) as usize);
        assert(got >= 0);
        if (got == 0) { assert(allow_eof && done == 0); return false; }
        done += got;
    }
    return true;
}

fn write_all(pointer: ptr, count: i32) {
    let done: i32 = 0;
    while (done < count) {
        let got: i32 = std::io::write_stdout(pointer + (done as usize), (count - done) as usize);
        assert(got > 0);
        done += got;
    }
}

fn get64(bytes: [u8], offset: i32) -> u64 {
    let result: u64 = 0;
    let index: i32 = 0;
    while (index < 8) {
        result |= (bytes[offset + index] as u64) << (index * 8);
        index += 1;
    }
    return result;
}

struct Output { bytes: [u8], pointer: ptr, used: i32 }
impl Output {
    fn borrow(&self) -> &Output { return self; }
    fn flush(&self) { write_all(self.pointer, self.used); self.used = 0; }
    fn word(&self, value: u64) {
        if (self.used == 4096) { self.flush(); }
        let index: i32 = 0;
        while (index < 8) {
            self.bytes[self.used + index] = ((value >> (index * 8)) & 255) as u8;
            index += 1;
        }
        self.used += 8;
    }
}

struct Answer { tag: u64, error: u64, payload: i32, value: u64, next: i32 }
struct Scalar { length: i32, encoded: u64, decoded: i64 }

fn failed(error: core::varint::Error) -> Answer {
    let code: u64 = match (error) {
        core::varint::Error::Bounds -> 1,
        core::varint::Error::BufferTooSmall(count) -> 2,
        core::varint::Error::Truncated -> 3,
        core::varint::Error::Overflow -> 4,
        core::varint::Error::NonCanonical -> 5,
    };
    let payload: i32 = match (error) { core::varint::Error::BufferTooSmall(count) -> count, _ -> 0 };
    return Answer { tag: 1, error: code, payload: payload, value: 0, next: 0 };
}

fn read32(bytes: core::slice::View<u8>, offset: i32, signed: bool) -> Answer {
    if (signed) {
        let result: core::result::Result<core::varint::Decoded<i32>, core::varint::Error> = core::varint::read_i32(bytes, offset);
        if (result.is_err()) { return failed(result.unwrap_err()); }
        let item: core::varint::Decoded<i32> = result.unwrap();
        return Answer { tag: 0, error: 0, payload: 0, value: item.value as i64 as u64, next: item.next };
    }
    let result: core::result::Result<core::varint::Decoded<u32>, core::varint::Error> = core::varint::read_u32(bytes, offset);
    if (result.is_err()) { return failed(result.unwrap_err()); }
    let item: core::varint::Decoded<u32> = result.unwrap();
    return Answer { tag: 0, error: 0, payload: 0, value: item.value as u64, next: item.next };
}

fn read64(bytes: core::slice::View<u8>, offset: i32, signed: bool) -> Answer {
    if (signed) {
        let result: core::result::Result<core::varint::Decoded<i64>, core::varint::Error> = core::varint::read_i64(bytes, offset);
        if (result.is_err()) { return failed(result.unwrap_err()); }
        let item: core::varint::Decoded<i64> = result.unwrap();
        return Answer { tag: 0, error: 0, payload: 0, value: item.value as u64, next: item.next };
    }
    let result: core::result::Result<core::varint::Decoded<u64>, core::varint::Error> = core::varint::read_u64(bytes, offset);
    if (result.is_err()) { return failed(result.unwrap_err()); }
    let item: core::varint::Decoded<u64> = result.unwrap();
    return Answer { tag: 0, error: 0, payload: 0, value: item.value, next: item.next };
}

fn write(bytes: core::slice::View<u8>, offset: i32, family: u64, value: u64) -> Answer {
    let result: core::result::Result<i32, core::varint::Error> = core::result::Ok(0);
    if (family == 0) { result = core::varint::write_u32(bytes, offset, value as u32); }
    if (family == 1) { result = core::varint::write_u64(bytes, offset, value); }
    if (family == 2) { result = core::varint::write_i32(bytes, offset, value as i32); }
    if (family == 3) { result = core::varint::write_i64(bytes, offset, value as i64); }
    if (result.is_err()) { return failed(result.unwrap_err()); }
    return Answer { tag: 0, error: 0, payload: 0, value: 0, next: result.unwrap() };
}

fn scalar(family: u64, value: u64) -> Scalar {
    let result: Scalar = Scalar { length: 0, encoded: 0, decoded: 0 };
    if (family == 0 || family == 2) {
        result.encoded = core::varint::zigzag_encode_i32(value as i32) as u64;
        result.decoded = core::varint::zigzag_decode_i32(value as u32) as i64;
        if (family == 0) { result.length = core::varint::len_u32(value as u32); }
        else { result.length = core::varint::len_i32(value as i32); }
    } else {
        result.encoded = core::varint::zigzag_encode_i64(value as i64);
        result.decoded = core::varint::zigzag_decode_i64(value);
        if (family == 1) { result.length = core::varint::len_u64(value); }
        else { result.length = core::varint::len_i64(value as i64); }
    }
    return result;
}

fn run(input: [u8], output: &Output) {
    let operation: u64 = get64(input, 0);
    let family: u64 = get64(input, 8);
    let layout: u64 = get64(input, 16);
    let native: [u8; 32] = [0; 32];
    let storage: [i32; 8] = [0; 8];
    let bytes: [u8] = native;
    if (layout == 1) { bytes = core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(storage), 32); }
    if (layout == 0) { assert(core::mem::slice_stride(bytes) < 0); }
    else { assert(core::mem::slice_stride(bytes) == 1); }
    let index: i32 = 0;
    while (index < 32) { bytes[index] = (160 + index) as u8; index += 1; }
    index = 0;
    while (index < get64(input, 56) as i32) { bytes[4 + index] = get64(input, 64 + index * 8) as u8; index += 1; }
    let view: core::slice::View<u8> = core::slice::View {
        values: bytes, start: get64(input, 24) as i32, length: get64(input, 32) as i32
    };
    let offset: i32 = get64(input, 40) as i32;
    let value: u64 = get64(input, 48);
    let answer: Answer = Answer { tag: 0, error: 0, payload: 0, value: 0, next: 0 };
    if (operation == 1) { answer = write(view, offset, family, value); }
    else {
        if (family == 0 || family == 2) { answer = read32(view, offset, family == 2); }
        else { answer = read64(view, offset, family == 3); }
    }
    let observations: Scalar = scalar(family, value);
    output.word(operation); output.word(family); output.word(layout);
    output.word(answer.tag); output.word(answer.error); output.word(answer.payload as i64 as u64);
    output.word(answer.value); output.word(answer.next as i64 as u64);
    output.word(observations.length as u64); output.word(observations.encoded);
    output.word(observations.decoded as u64); output.word(core::mem::slice_stride(bytes) as u64);
    index = 0;
    while (index < 32) { output.word(bytes[index] as u64); index += 1; }
}

fn main() -> i32 {
    let input_words: [i32; 40] = [0; 40];
    let input_pointer: ptr = core::mem::i32_array_data_ptr(input_words);
    let input: [u8] = core::mem::typed_slice_from_raw_parts<u8>(input_pointer, 160);
    let output_words: [i32; 1024] = [0; 1024];
    let output_pointer: ptr = core::mem::i32_array_data_ptr(output_words);
    let output_bytes: [u8] = core::mem::typed_slice_from_raw_parts<u8>(output_pointer, 4096);
    let output: Output = Output { bytes: output_bytes, pointer: output_pointer, used: 0 };
    while (read_exact(input_pointer, 64, true)) {
        assert(get64(input, 0) <= 1 && get64(input, 8) <= 3 && get64(input, 16) <= 1 && get64(input, 56) <= 12);
        assert(read_exact(input_pointer + 64, (get64(input, 56) * 8) as i32, false));
        run(input, output.borrow());
    }
    output.flush();
    return 0;
}
