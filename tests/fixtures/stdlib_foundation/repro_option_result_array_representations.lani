module app::main;
import core::option;
import core::result;
import std::io;
fn main() -> i32 {
    let data: [str; 2] = ["Ω", ""];
    let backup: [str; 2] = ["backup", "other"];
    let floats: [f32; 2] = [-2.5, -0.0];
    let other_floats: [f32; 2] = [99.0, 7.5];
    let some: core::option::Option<[str; 2]> = core::option::Some(data);
    let none: core::option::Option<[str; 2]> = core::option::None();
    let selected: [str; 2] = some.unwrap_or(backup);
    let missing: [str; 2] = core::option::unwrap_or(none, backup);
    let first: str = selected[0];
    let empty: str = selected[1];
    let fallback: str = missing[0];
    if (std::io::println(first) != 3 || std::io::println(empty) != 1 ||
        std::io::println(fallback) != 7) { return 1; }
    selected[0] = "changed";
    let ok: core::result::Result<[str; 2], [f32; 2]> = core::result::Ok(data);
    let err: core::result::Result<[str; 2], [f32; 2]> = core::result::Err(floats);
    let success: [str; 2] = core::result::unwrap_or(ok, backup);
    let error: [f32; 2] = err.unwrap_err_or(other_floats);
    let absent_error: [f32; 2] = core::result::unwrap_err_or(ok, other_floats);
    let original_first: str = success[0];
    let original_empty: str = success[1];
    if (std::io::println(original_first) != 3 || std::io::println(original_empty) != 1) { return 2; }
    if (error[0] != -2.5 || error[1] != 0.0 || 1.0 / error[1] >= 0.0) { return 3; }
    if (absent_error[0] != 99.0 || absent_error[1] != 7.5) { return 4; }
    error[0] = 123.0;
    let preserved: [f32; 2] = err.unwrap_err_or(other_floats);
    if (preserved[0] != -2.5 || floats[0] != -2.5) { return 5; }
    return 0;
}
