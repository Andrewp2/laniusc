module app::main;
import std::vec_u16;

fn main() -> i32 {
    let first: u16 = 32768;
    let last: u16 = 65535;
    let fallback: u16 = 0;
    let value: std::vec_u16::VecU16 = std::vec_u16::try_with_capacity(4);
    if (std::vec_u16::capacity(value) != 4) { return 2; }
    value = std::vec_u16::try_push(value, first);
    value = std::vec_u16::try_push(value, last);
    if (std::vec_u16::len(value) != 2) { return 3; }
    let copy: std::vec_u16::VecU16 = std::vec_u16::try_clone(value);
    if (std::vec_u16::len(copy) == 2) {
        std::vec_u16::destroy(copy);
        std::vec_u16::destroy(value);
        return 4;
    }
    if (std::vec_u16::len(copy) != 0 ||
        std::vec_u16::capacity(copy) != 0 ||
        std::vec_u16::len(value) != 2 ||
        std::vec_u16::capacity(value) != 4 ||
        std::vec_u16::get_or(value, 0, fallback) != first ||
        std::vec_u16::get_or(value, 1, fallback) != last) { return 5; }
    std::vec_u16::destroy(copy);
    std::vec_u16::destroy(value);
    return 0;
}
