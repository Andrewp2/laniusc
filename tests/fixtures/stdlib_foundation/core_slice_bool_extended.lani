module app::main;
import core::slice_bool;

fn main() -> i32 {
    let values: [bool; 5] = [true, false, false, true, false];
    if (!core::slice_bool::first_or(values, 5, false) ||
        core::slice_bool::first_or(values, 0, false) ||
        !core::slice_bool::first_or(values, -1, true)) { return 1; }
    if (core::slice_bool::rotate_left(values, 5, -1) ||
        core::slice_bool::rotate_right(values, 5, 6) ||
        !values[0] || values[1] ||
        !core::slice_bool::rotate_left(values, 5, 2) ||
        values[0] || !values[1] || values[2] || !values[3] || values[4] ||
        !core::slice_bool::rotate_right(values, 5, 2) ||
        !values[0] || values[1] || values[2] || !values[3] || values[4] ||
        !core::slice_bool::rotate_left(values, 0, 0) ||
        !core::slice_bool::rotate_right(values, 5, 5) ||
        core::slice_bool::rotate_left(values, -1, 0)) { return 2; }

    let source: [bool; 4] = [true, true, false, true];
    let destination: [bool; 5] = [false, false, false, true, true];
    if (core::slice_bool::copy_nonoverlapping_range(destination, 5, -1, source, 4, 0, 1) ||
        core::slice_bool::copy_nonoverlapping_range(destination, 5, 4, source, 4, 0, 2) ||
        core::slice_bool::copy_nonoverlapping_range(destination, 5, 0, source, 4, 3, 2) ||
        core::slice_bool::copy_nonoverlapping_range(destination, -1, 0, source, 4, 0, 1) ||
        core::slice_bool::copy_nonoverlapping_range(destination, 5, 0, source, 4, 0, -1) ||
        destination[0] || destination[2] || !destination[3] ||
        !core::slice_bool::copy_nonoverlapping_range(destination, 5, 2, source, 4, 1, 2) ||
        destination[0] || destination[1] || !destination[2] ||
        destination[3] || !destination[4] ||
        !core::slice_bool::copy_nonoverlapping_range(destination, 5, 5, source, 4, 4, 0)) {
        return 3;
    }

    let compact: [bool; 6] = [true, true, false, false, true, true];
    if (core::slice_bool::dedup_adjacent(compact, -1) != -1 ||
        !compact[0] || !compact[1] ||
        core::slice_bool::dedup_adjacent(compact, 6) != 3 ||
        !compact[0] || compact[1] || !compact[2] ||
        core::slice_bool::dedup_adjacent(compact, 0) != 0) { return 4; }
    let retained: [bool; 5] = [true, false, true, false, true];
    if (core::slice_bool::retain_not_equal(retained, -1, true) != -1 ||
        retained[1] ||
        core::slice_bool::retain_not_equal(retained, 5, true) != 2 ||
        retained[0] || retained[1] ||
        core::slice_bool::retain_not_equal(retained, 0, false) != 0) { return 5; }
    let removal: [bool; 3] = [true, false, true];
    if (core::slice_bool::remove_at(removal, 3, -1) ||
        core::slice_bool::remove_at(removal, 3, 3) ||
        !removal[0] || removal[1] ||
        !core::slice_bool::remove_at(removal, 3, 0) ||
        removal[0] || !removal[1] ||
        core::slice_bool::remove_at(removal, 0, 0)) { return 6; }

    let insertion: [bool; 4] = [true, false, false, false];
    if (core::slice_bool::insert(insertion, 2, 2, 0, false) ||
        core::slice_bool::insert(insertion, -1, 4, 0, false) ||
        core::slice_bool::insert(insertion, 2, 4, 3, false) ||
        core::slice_bool::push(insertion, 4, 4, true) ||
        !insertion[0] || insertion[1] ||
        !core::slice_bool::insert(insertion, 2, 4, 0, false) ||
        insertion[0] || !insertion[1] || insertion[2] ||
        !core::slice_bool::push(insertion, 3, 4, true) ||
        !insertion[3] ||
        core::slice_bool::push(insertion, 4, 4, false)) { return 7; }

    let query: [bool; 4] = [true, false, true, false];
    let prefix: [bool; 2] = [true, false];
    let suffix: [bool; 2] = [true, false];
    let other: [bool; 2] = [false, true];
    if (!core::slice_bool::contains(query, 4, true) ||
        !core::slice_bool::contains(query, 4, false) ||
        core::slice_bool::contains(query, -1, true) ||
        core::slice_bool::contains(query, 0, false) ||
        !core::slice_bool::starts_with(query, 4, prefix, 2) ||
        !core::slice_bool::starts_with(query, 4, other, 0) ||
        core::slice_bool::starts_with(query, 4, other, 2) ||
        core::slice_bool::starts_with(query, -1, prefix, 0) ||
        !core::slice_bool::ends_with(query, 4, suffix, 2) ||
        !core::slice_bool::ends_with(query, 4, other, 0) ||
        core::slice_bool::ends_with(query, 4, other, 2) ||
        core::slice_bool::ends_with(query, 1, suffix, 2)) { return 8; }
    return 0;
}
