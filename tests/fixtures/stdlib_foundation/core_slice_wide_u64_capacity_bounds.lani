module app::main;
import core::slice_wide_u64;
import core::wide_u64;
fn main() -> i32 {
    let word_zero: u32 = 0;
    let values: [u32; 2] = [word_zero, word_zero];
    let item: core::wide_u64::WideU64 = core::wide_u64::from_u32(7);
    if (core::slice_wide_u64::insert(values, 1, 2, 1, item)) { return 0; }
    return 1;
}
