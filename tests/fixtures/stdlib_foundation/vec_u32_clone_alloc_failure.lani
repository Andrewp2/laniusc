module app::main;
import std::vec_u32;

fn main() -> i32 {
    let first: u32 = 2147483648;
    let last: u32 = 4294967295;
    let fallback: u32 = 0;
    let value: std::vec_u32::VecU32 = std::vec_u32::try_with_capacity(4);
    if (std::vec_u32::capacity(value) != 4) { return 2; }
    value = std::vec_u32::try_push(value, first);
    value = std::vec_u32::try_push(value, last);
    if (std::vec_u32::len(value) != 2) { return 3; }
    let copy: std::vec_u32::VecU32 = std::vec_u32::try_clone(value);
    if (std::vec_u32::len(copy) == 2) {
        std::vec_u32::destroy(copy);
        std::vec_u32::destroy(value);
        return 4;
    }
    if (std::vec_u32::len(copy) != 0 ||
        std::vec_u32::capacity(copy) != 0 ||
        std::vec_u32::len(value) != 2 ||
        std::vec_u32::capacity(value) != 4 ||
        std::vec_u32::get_or(value, 0, fallback) != first ||
        std::vec_u32::get_or(value, 1, fallback) != last) { return 5; }
    std::vec_u32::destroy(copy);
    std::vec_u32::destroy(value);
    return 0;
}
