module app::main;
import core::mem;

fn main() -> i32 {
    let values: [i32; 3] = [1, 2, 3];
    let data: ptr = core::mem::i32_array_data_ptr(values);
    let view: [i32] = slice_from_raw_parts(data, 3);
    if (view[0] != 1 || view[2] != 3) { return 1; }
    view[1] = 9;
    if (values[1] != 9) { return 2; }
    return 0;
}
