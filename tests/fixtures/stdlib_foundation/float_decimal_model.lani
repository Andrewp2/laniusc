module app::main;
import core::decimal;
import core::f32;
import core::f64;
import core::float_decimal;
import core::mem;
import core::result;
import core::slice;
import std::io;
import std::io_decimal;
import std::process;
fn code(error: core::float_decimal::Error) -> i32 { let value: i32 = match (error) { core::float_decimal::Error::Bounds -> 1, core::float_decimal::Error::ScratchTooSmall(count) -> 2, core::float_decimal::Error::InputLimit -> 3, core::float_decimal::Error::DigitLimit -> 4, core::float_decimal::Error::WorkLimit -> 5, core::float_decimal::Error::Invalid(at) -> 100+at, core::float_decimal::Error::Capacity(count) -> 10000+count }; return value; }
fn failed(error: core::float_decimal::Error) { assert(std::io::write_byte(1,69) == 1); assert(std::io_decimal::write_i32(1,code(error)) > 0); assert(std::io::write_byte(1,10) == 1); }
fn main() -> i32 {
    let input_words: [i32;512] = [0;512]; let pointer: ptr = core::mem::i32_array_data_ptr(input_words); let raw: [u8] = core::mem::typed_slice_from_raw_parts(pointer,2048);
    assert(std::process::argc() >= 2 && std::process::arg_len(1) == 3 && std::process::arg_read(1,pointer,3) == 3); let format: bool = raw[0] == 102; let single: bool = raw[1] == 51;
    let stack: [u32;864] = [0;864]; let scratch: core::slice::View<u32> = core::result::unwrap(core::slice::view(stack,864));
    let output_words: [i32;16] = [0;16]; let output_pointer: ptr = core::mem::i32_array_data_ptr(output_words); let output_bytes: [u8] = core::mem::typed_slice_from_raw_parts(output_pointer,64); let output: core::slice::View<u8> = core::result::unwrap(core::slice::view(output_bytes,64));
    let limits: core::float_decimal::Limits = core::float_decimal::default_limits(); let index: i32 = 2;
    while (index < std::process::argc()) {
        let count: i32 = std::process::arg_len(index); assert(count >= 0 && count <= 2048); assert(std::process::arg_read(index,pointer,count as usize) == count); let input: core::slice::View<u8> = core::result::unwrap(core::slice::view(raw,count));
        if (format) {
            let bits: u64 = core::result::unwrap(core::decimal::parse_u64_range(raw,0,count));
            let written: core::result::Result<i32,core::float_decimal::Error> = core::result::Err(core::float_decimal::Error::Bounds);
            if (single) { written = core::float_decimal::format_f32_into(core::f32::from_bits(bits as u32),output,scratch,1000000); }
            else { written = core::float_decimal::format_f64_into(core::f64::from_bits(bits),output,scratch,1000000); }
            if (core::result::is_err(written)) { failed(core::result::unwrap_err(written)); }
            else { let size: i32 = core::result::unwrap(written); assert(std::io::write_stdout(output_pointer,size as usize) == size && std::io::write_byte(1,10) == 1); }
        } else {
            if (single) {
                let parsed: core::result::Result<f32,core::float_decimal::Error> = core::float_decimal::parse_f32(input,scratch,limits);
                if (core::result::is_err(parsed)) { failed(core::result::unwrap_err(parsed)); }
                else { assert(std::io_decimal::write_u64(1,core::f32::to_bits(core::result::unwrap(parsed)) as u64) > 0 && std::io::write_byte(1,10) == 1); }
            } else {
                let parsed: core::result::Result<f64,core::float_decimal::Error> = core::float_decimal::parse_f64(input,scratch,limits);
                if (core::result::is_err(parsed)) { failed(core::result::unwrap_err(parsed)); }
                else { assert(std::io_decimal::write_u64(1,core::f64::to_bits(core::result::unwrap(parsed))) > 0 && std::io::write_byte(1,10) == 1); }
            }
        }
        index += 1;
    } return 0;
}
