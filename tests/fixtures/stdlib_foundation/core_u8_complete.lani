module app::main;
import core::u8;
import core::option;

fn main() -> i32 {
    let maximum: u8 = 255;
    let zero: u8 = 0;
    if (core::u8::MIN != zero || core::u8::MAX != maximum ||
        core::u8::BITS != 8 || core::u8::BYTES != 1 ||
        core::u8::min(9, 3) != 3 || core::u8::max(9, 3) != 9 ||
        core::u8::clamp(12, 2, 10) != 10 ||
        core::u8::clamp_or(5, 10, 3, 5) != 5) {
        return 1;
    }
    if (core::u8::wrapping_add(250, 10) != 4 ||
        core::u8::wrapping_sub(3, 5) != 254 ||
        core::u8::wrapping_mul(maximum, maximum) != 1 ||
        core::u8::saturating_add(250, 10) != maximum ||
        core::u8::saturating_sub(3, 5) != zero ||
        core::u8::saturating_mul(20, 20) != maximum ||
        core::u8::abs_diff(3, 9) != 6) {
        return 2;
    }
    if (!core::option::contains(core::u8::checked_add(250, 5), maximum) ||
        !core::option::is_none(core::u8::checked_add(250, 6)) ||
        !core::option::contains(core::u8::checked_sub(5, 3), 2) ||
        !core::option::is_none(core::u8::checked_sub(3, 5))) {
        return 3;
    }
    if (!core::u8::is_zero(zero) || core::u8::is_zero(1) ||
        !core::u8::is_nonzero(maximum) || core::u8::is_nonzero(zero) ||
        !core::u8::is_even(4) || core::u8::is_even(3) ||
        !core::u8::is_odd(3) || core::u8::is_odd(4) ||
        !core::u8::is_multiple_of(12, 3) || core::u8::is_multiple_of(12, 0)) {
        return 4;
    }
    if (!core::u8::is_power_of_two(128) || core::u8::is_power_of_two(129) ||
        core::u8::is_power_of_two(zero) ||
        core::u8::next_power_of_two(7) != 8 ||
        !core::option::is_none(core::u8::checked_next_power_of_two(129)) ||
        !core::u8::between_inclusive(3, 3, 9) ||
        core::u8::between_inclusive(2, 3, 9) ||
        !core::u8::between_exclusive(4, 3, 9) ||
        core::u8::between_exclusive(3, 3, 9)) {
        return 5;
    }
    if (!core::u8::is_ascii(127) || core::u8::is_ascii(128) ||
        !core::u8::is_ascii_digit(53) || core::u8::is_ascii_digit(65) ||
        !core::u8::is_ascii_lowercase(97) || core::u8::is_ascii_lowercase(65) ||
        !core::u8::is_ascii_uppercase(65) || core::u8::is_ascii_uppercase(97) ||
        !core::u8::is_ascii_alphabetic(65) || core::u8::is_ascii_alphabetic(53) ||
        !core::u8::is_ascii_alphanumeric(53) || core::u8::is_ascii_alphanumeric(33)) {
        return 6;
    }
    if (core::u8::to_ascii_lowercase(65) != 97 ||
        core::u8::to_ascii_uppercase(97) != 65 ||
        !core::u8::eq_ignore_ascii_case(65, 97) ||
        core::u8::eq_ignore_ascii_case(65, 98) ||
        !core::u8::is_ascii_hexdigit(70) || core::u8::is_ascii_hexdigit(71) ||
        core::u8::ascii_hexdigit_value_or(70, maximum) != 15 ||
        core::u8::ascii_hexdigit_value_or(71, maximum) != maximum) {
        return 7;
    }
    if (!core::u8::is_ascii_whitespace(32) || core::u8::is_ascii_whitespace(65) ||
        !core::u8::is_ascii_control(127) || core::u8::is_ascii_control(32) ||
        !core::u8::is_ascii_punctuation(33) || core::u8::is_ascii_punctuation(65) ||
        !core::u8::is_ascii_graphic(33) || core::u8::is_ascii_graphic(32) ||
        !core::u8::is_ascii_printable(32) || core::u8::is_ascii_printable(127)) {
        return 8;
    }
    return 0;
}
