// Valid logical View; deliberately invalid physical caller precondition.
module app::main;
import core::result;
import core::slice;
import core::varint;
fn main() -> i32 {
    let short:[u8;1]=[128];
    let view:core::slice::View<u8> =core::slice::View { values:short,start:0,length:2 };
    let decoded:core::result::Result<core::varint::Decoded<u32>,core::varint::Error> =core::varint::read_u32(view,0);
    if(decoded.is_err()) { return 2; } return 0;
}
