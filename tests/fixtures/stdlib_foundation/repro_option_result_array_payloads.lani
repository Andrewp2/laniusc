module app::main;
import core::option;
import core::result;
fn main() -> i32 {
    let data: [i32; 3] = [-7, 0, 42];
    let backup: [i32; 3] = [99, -11, 123];
    let errors: [i32; 2] = [-9, 57];
    let other_errors: [i32; 2] = [5, 6];
    let some: core::option::Option<[i32; 3]> = core::option::Some(data);
    let none: core::option::Option<[i32; 3]> = core::option::None();
    let selected: [i32; 3] = core::option::unwrap_or(some, backup);
    let missing: [i32; 3] = none.unwrap_or(backup);
    if (selected[0] != -7 || selected[1] != 0 || selected[2] != 42) { return 1; }
    if (missing[0] != 99 || missing[1] != -11 || missing[2] != 123) { return 2; }
    selected[1] = 777;
    let original: [i32; 3] = some.unwrap_or(backup);
    if (original[1] != 0 || data[1] != 0 || selected[1] != 777) { return 3; }
    let ok: core::result::Result<[i32; 3], [i32; 2]> = core::result::Ok(data);
    let err: core::result::Result<[i32; 3], [i32; 2]> = core::result::Err(errors);
    let success: [i32; 3] = core::result::unwrap_or(ok, backup);
    let failed: [i32; 3] = err.unwrap_or(backup);
    let error_value: [i32; 2] = core::result::unwrap_err_or(err, other_errors);
    let error_fallback: [i32; 2] = ok.unwrap_err_or(other_errors);
    if (success[0] != -7 || success[2] != 42 || failed[0] != 99 || failed[2] != 123) { return 4; }
    if (error_value[0] != -9 || error_value[1] != 57 ||
        error_fallback[0] != 5 || error_fallback[1] != 6) { return 5; }
    error_value[0] = 123;
    let preserved: [i32; 2] = err.unwrap_err_or(other_errors);
    if (preserved[0] != -9 || errors[0] != -9 || other_errors[0] != 5) { return 6; }
    return 0;
}
