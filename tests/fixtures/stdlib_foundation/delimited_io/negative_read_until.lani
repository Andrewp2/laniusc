module app::main;
import core::io;
import core::result;
struct Sequential {}
impl Sequential { fn borrow(&self) -> &Sequential { return self; } }
pub impl core::io::Read for Sequential {
    pub fn read(&self,destination:[u8],offset:i32,count:i32) -> core::result::Result<i32,core::io::Error> { return core::result::Ok(0); }
}
fn main() -> i32 {
    let reader:Sequential=Sequential {}; let bytes:[u8;1]=[99];
    let rejected:core::result::Result<core::io::Delimited,core::io::DelimiterFailure> =core::io::read_until<Sequential>(reader.borrow(),0,bytes,0,1,2); // rejected_bufread_bound
    return 0;
