module app::main;
import core::slice_generic;

fn main() -> i32 {
    let a: u8 = 10;
    let b: u8 = 20;
    let c: u8 = 30;
    let d: u8 = 40;
    let z: u8 = 0;
    let bytes: [u8; 4] = [a, b, c, d];
    if (core::slice_generic::get_or(bytes, 4, 2, z) != c ||
        core::slice_generic::get_or(bytes, 4, -1, z) != z ||
        core::slice_generic::get_or(bytes, 0, 0, z) != z ||
        core::slice_generic::get_or(bytes, -1, 0, z) != z ||
        core::slice_generic::get_or(bytes, 4, 4, z) != z) {
        return 1;
    }
    if (core::slice_generic::set(bytes, 4, -1, z) ||
        core::slice_generic::set(bytes, 4, 4, z) ||
        core::slice_generic::set(bytes, 0, 0, z) ||
        core::slice_generic::set(bytes, -1, 0, z) ||
        bytes[0] != a || bytes[3] != d) {
        return 2;
    }
    if (!core::slice_generic::set(bytes, 4, 0, d) || bytes[0] != d) {
        return 3;
    }
    if (core::slice_generic::fill(bytes, -1, z) != 0 || bytes[0] != d ||
        core::slice_generic::fill(bytes, 4, a) != 4 ||
        bytes[0] != a || bytes[3] != a) {
        return 4;
    }

    let big: u32 = 4294967295;
    let high: u32 = 2147483648;
    let zero: u32 = 0;
    let words: [u32; 3] = [zero, high, big];
    if (core::slice_generic::get_or(words, 3, 2, zero) != big ||
        !core::slice_generic::set(words, 3, 0, big) || words[0] != big ||
        core::slice_generic::fill(words, 2, high) != 2 ||
        words[0] != high || words[1] != high || words[2] != big) {
        return 5;
    }

    let flags: [bool; 3] = [true, false, true];
    if (!core::slice_generic::get_or(flags, 3, 0, false) ||
        core::slice_generic::get_or(flags, 3, 3, false) ||
        !core::slice_generic::set(flags, 3, 1, true) || !flags[1] ||
        core::slice_generic::fill(flags, 3, false) != 3 ||
        flags[0] || flags[2]) {
        return 6;
    }
    return 0;
}
