module app::main;
import std::deque_char;

fn main() -> i32 {
    let value: std::deque_char::DequeChar = std::deque_char::try_with_capacity(4);
    if (std::deque_char::capacity(value) != 4) { return 5; }
    value = std::deque_char::try_push_back(value, '①');
    value = std::deque_char::try_push_back(value, '②');
    value = std::deque_char::try_push_back(value, '③');
    value = std::deque_char::try_pop_front(value);
    value = std::deque_char::try_shrink_to_fit(value);
    let intact: bool = std::deque_char::len(value) == 2 &&
        std::deque_char::at_or(value, 0, '\0') == '②' &&
        std::deque_char::at_or(value, 1, '\0') == '③';
    let failure: bool = intact && std::deque_char::capacity(value) == 4;
    let success: bool = intact && std::deque_char::capacity(value) == 2;
    std::deque_char::destroy(value);
    if (failure) { return 0; }
    if (success) { return 4; }
    return 5;
}
