module app::main;
import std::map_char_u32;

fn main() -> i32 {
    let value: std::map_char_u32::MapCharU32 = std::map_char_u32::new();
    value = std::map_char_u32::try_insert(value, '③', 5);
    if (std::map_char_u32::len(value) != 1) { return 2; }
    let copy: std::map_char_u32::MapCharU32 = std::map_char_u32::try_clone(value);
    if (std::map_char_u32::len(copy) == 0 &&
        std::map_char_u32::capacity(copy) == 0 &&
        std::map_char_u32::get_or(value, '③', 4294967295) == 5) {
        std::map_char_u32::destroy(copy);
        std::map_char_u32::destroy(value);
        return 0;
    }
    if (std::map_char_u32::len(copy) == 1 &&
        std::map_char_u32::get_or(copy, '③', 4294967295) == 5 &&
        std::map_char_u32::get_or(value, '③', 4294967295) == 5) {
        std::map_char_u32::destroy(copy);
        std::map_char_u32::destroy(value);
        return 4;
    }
    std::map_char_u32::destroy(copy);
    std::map_char_u32::destroy(value);
    return 5;
}
