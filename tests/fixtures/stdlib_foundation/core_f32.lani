    }
    if (!core::f32::between_inclusive(0.0, 0.0, 2.0) || !core::f32::between_inclusive(2.0, 0.0, 2.0) || core::f32::between_inclusive(3.0, 0.0, 2.0)) {
        return 14;
    }
    let zero: f32 = 0.0;
    let nan: f32 = zero / zero;
    if (core::f32::min(nan, 2.0) != 2.0 || core::f32::min(2.0, nan) != 2.0 ||
        core::f32::max(nan, 2.0) != 2.0 || core::f32::max(2.0, nan) != 2.0) {
        return 18;
    }
    if (core::f32::min(nan, nan) == core::f32::min(nan, nan) ||
