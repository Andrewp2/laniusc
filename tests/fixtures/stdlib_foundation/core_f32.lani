        return 4;
    }
    if (core::f32::clamp(1.5, 2.0, 1.0) != 1.5 ||
        core::f32::clamp_or(1.5, 2.0, 1.0, -7.0) != -7.0 ||
        core::f32::clamp_or(-3.0, -1.0, 2.0, -7.0) != -1.0 ||
        core::f32::clamp_or(4.0, -1.0, 2.0, -7.0) != 2.0 ||
