    if (core::f32::clamp_or(1.0, nan, 2.0, -7.0) != -7.0 ||
        core::f32::clamp_or(1.0, 0.0, nan, -7.0) != -7.0 ||
        core::f32::clamp(1.0, nan, 2.0) != 1.0 ||
        core::f32::clamp_or(nan, 0.0, 2.0, -7.0) ==
