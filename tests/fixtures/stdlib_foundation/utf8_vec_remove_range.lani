module app::main;
import std::utf8_vec;
import std::vec_u8;

fn main() -> i32 {
    let a: u32 = 65;
    let cent: u32 = 162;
    let euro: u32 = 8364;
    let smile: u32 = 128578;
    let b: u32 = 66;
    let c: u32 = 67;
    let scalars: [u32; 6] = [a, cent, euro, smile, b, c];
    let text: std::vec_u8::VecU8 = std::utf8_vec::new();
    text = std::utf8_vec::try_append_scalars(text, scalars, 6);
    if (std::utf8_vec::byte_len(text) != 12 ||
        std::utf8_vec::scalar_count_or(text, -9) != 6) { return 1; }
    let capacity: i32 = std::vec_u8::capacity(text);

    text = std::utf8_vec::try_remove_scalar_range(text, -1, 1);
    text = std::utf8_vec::try_remove_scalar_range(text, 0, -1);
    text = std::utf8_vec::try_remove_scalar_range(text, 7, 0);
    text = std::utf8_vec::try_remove_scalar_range(text, 5, 2);
    text = std::utf8_vec::try_remove_scalar_range(text, 1, 2147483647);
    text = std::utf8_vec::try_remove_scalar_range(text, 6, 0);
    text = std::utf8_vec::try_remove_scalar_range(text, 0, 0);
    if (std::utf8_vec::byte_len(text) != 12 ||
        std::vec_u8::capacity(text) != capacity ||
        std::utf8_vec::scalar_at_or(text, 1, 4294967295) != 162 ||
        std::utf8_vec::scalar_at_or(text, 3, 4294967295) != 128578 ||
        std::vec_u8::get_or(text, 11, 0) != 67) { return 2; }

    text = std::utf8_vec::try_remove_scalar_range(text, 1, 3);
    if (std::utf8_vec::byte_len(text) != 3 ||
        std::utf8_vec::scalar_count_or(text, -9) != 3 ||
        std::vec_u8::capacity(text) != capacity ||
        std::vec_u8::get_or(text, 0, 0) != 65 ||
        std::vec_u8::get_or(text, 1, 0) != 66 ||
        std::vec_u8::get_or(text, 2, 0) != 67) { return 3; }
    text = std::utf8_vec::try_remove_scalar_range(text, 0, 1);
    text = std::utf8_vec::try_remove_scalar_range(text, 1, 1);
    if (std::utf8_vec::byte_len(text) != 1 ||
        std::utf8_vec::scalar_at_or(text, 0, 4294967295) != 66) { return 4; }
    text = std::utf8_vec::try_remove_scalar_range(text, 0, 1);
    text = std::utf8_vec::try_remove_scalar_range(text, 0, 0);
    text = std::utf8_vec::try_remove_scalar_range(text, 0, 1);
    if (std::utf8_vec::byte_len(text) != 0 ||
        !std::utf8_vec::is_valid(text) ||
        std::vec_u8::capacity(text) != capacity) { return 5; }

    let invalid: std::vec_u8::VecU8 = std::vec_u8::new();
    invalid = std::vec_u8::try_push(invalid, 65);
    invalid = std::vec_u8::try_push(invalid, 128);
    invalid = std::utf8_vec::try_remove_scalar_range(invalid, 0, 1);
    if (std::utf8_vec::byte_len(invalid) != 2 ||
        std::vec_u8::get_or(invalid, 0, 0) != 65 ||
        std::vec_u8::get_or(invalid, 1, 0) != 128) { return 6; }

    std::utf8_vec::destroy(invalid);
    std::utf8_vec::destroy(text);
    return 0;
}
