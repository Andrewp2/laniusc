module app::main;
import alloc::clone;
import alloc::string;
import alloc::vec;
import core::clone;
import core::mem;
import core::result;
import core::slice;
import fixture::owners;

struct ReleaseOnly { bytes: alloc::vec::Vec<u8> }
pub impl core::clone::Destroy<ReleaseOnly> for ReleaseOnly { pub fn destroy_value(owned: ReleaseOnly) { owned.bytes.destroy(); } }
enum Never { Unreachable }
pub impl core::clone::TryClone<u8,Never> for u8 { pub fn try_clone_value(source: u8) -> core::result::Result<u8,Never> { return core::result::Ok(source); } }
pub impl core::clone::Destroy<u8> for u8 { pub fn destroy_value(owned: u8) {} }

fn strings() {
    let source = fixture::owners::text("A\0é",4).unwrap(); let empty = alloc::string::new();
    let aliases: [alloc::string::String;5] = [empty,source,source,source,empty];
    let input = core::slice::view_range(aliases,1,3).unwrap();
    let cloned: core::result::Result<alloc::vec::Vec<alloc::string::String>,alloc::clone::Error<alloc::string::Error>> = alloc::clone::from_view<alloc::string::String,alloc::string::Error>(input);
    let owner = cloned.unwrap(); assert(owner.len() == 3);
    let last: alloc::string::String = owner.pop().unwrap(); source.destroy();
    assert(owner.at(0).byte_at(0).unwrap() == 65 && owner.at(1).byte_at(1).unwrap() == 0 && last.byte_at(3).unwrap() == 169);
    last.try_push_scalar(33).unwrap(); assert(owner.at(0).byte_at(3).unwrap() == 169 && owner.at(1).byte_len() == 4);
    last.destroy(); assert(owner.at(0).byte_at(2).unwrap() == 195 && owner.at(1).byte_at(3).unwrap() == 169);
    alloc::clone::destroy_vec<alloc::string::String>(owner.borrow()); assert(owner.len() == 0 && owner.capacity() == 0);
    alloc::clone::destroy_vec<alloc::string::String>(owner.borrow());
}
fn pairs() {
    let source = fixture::owners::pair().unwrap();
    let values: [fixture::owners::Pair;3] = [source,source,source];
    let cloned: core::result::Result<alloc::vec::Vec<fixture::owners::Pair>,alloc::clone::Error<fixture::owners::Fault>> = alloc::clone::from_view<fixture::owners::Pair,fixture::owners::Fault>(core::slice::view(values,3).unwrap());
    let owner = cloned.unwrap(); fixture::owners::Pair::destroy_value(source);
    assert(owner.len() == 3 && fixture::owners::valid(owner.at(0)) && fixture::owners::valid(owner.at(1)) && fixture::owners::valid(owner.at(2)));
    alloc::clone::destroy_vec<fixture::owners::Pair>(owner.borrow()); assert(owner.is_empty() && owner.capacity() == 0);
}
fn main() -> i32 {
    strings(); pairs();
    let bytes = alloc::vec::from_view<u8>(core::slice::view([1 as u8,2 as u8,3 as u8],3).unwrap()).unwrap();
    let owner: alloc::vec::Vec<ReleaseOnly> = alloc::vec::new(); owner.try_push(ReleaseOnly { bytes:bytes }).unwrap();
    alloc::clone::destroy_vec<ReleaseOnly>(owner.borrow()); assert(owner.len() == 0 && owner.capacity() == 0);
    let packed: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::string_data_ptr("A\0é"),4); assert(core::mem::slice_stride(packed) == 1);
    let copied: core::result::Result<alloc::vec::Vec<u8>,alloc::clone::Error<Never>> = alloc::clone::from_view<u8,Never>(core::slice::view_range(packed,1,3).unwrap());
    let bytes = copied.unwrap(); assert(bytes.len() == 3 && bytes.at(0) == 0 && bytes.at(1) == 195 && bytes.at(2) == 169); alloc::clone::destroy_vec<u8>(bytes.borrow());
    return 0;
}
