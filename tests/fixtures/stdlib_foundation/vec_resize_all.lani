module app::main;
import std::vec_i32;
import std::vec_u32;
import std::vec_u8;
import std::vec_i8;
import std::vec_u16;
import std::vec_i16;
import std::vec_bool;

fn check_i32() -> i32 {
    let fill: i32 = -7;
    let different: i32 = 44;
    let fallback: i32 = 123;
    let value: std::vec_i32::VecI32 = std::vec_i32::new();
    value = std::vec_i32::try_resize(value, 3, fill);
    if (std::vec_i32::len(value) != 3 || std::vec_i32::capacity(value) < 3 ||
        std::vec_i32::get_or(value, 0, fallback) != fill ||
        std::vec_i32::get_or(value, 2, fallback) != fill) { return 1; }
    if (!std::vec_i32::try_set(value, 1, different)) { return 2; }
    value = std::vec_i32::try_resize(value, 5, fill);
    let held_capacity: i32 = std::vec_i32::capacity(value);
    if (std::vec_i32::len(value) != 5 || held_capacity < 5 ||
        std::vec_i32::get_or(value, 1, fallback) != different ||
        std::vec_i32::get_or(value, 3, fallback) != fill) { return 3; }
    if (!std::vec_i32::try_set(value, 4, different)) { return 4; }
    value = std::vec_i32::try_resize(value, 2, fill);
    if (std::vec_i32::len(value) != 2 || std::vec_i32::capacity(value) != held_capacity ||
        std::vec_i32::get_or(value, 1, fallback) != different) { return 5; }
    value = std::vec_i32::try_resize(value, -1, fill);
    value = std::vec_i32::try_resize(value, 536870912, fill);
    if (std::vec_i32::len(value) != 2 || std::vec_i32::capacity(value) != held_capacity ||
        std::vec_i32::get_or(value, 1, fallback) != different) { return 6; }
    value = std::vec_i32::try_resize(value, 5, fill);
    if (std::vec_i32::len(value) != 5 || std::vec_i32::capacity(value) != held_capacity ||
        std::vec_i32::get_or(value, 4, fallback) != fill) { return 7; }
    value = std::vec_i32::try_resize(value, 0, fill);
    if (!std::vec_i32::is_empty(value) || std::vec_i32::capacity(value) != held_capacity) { return 8; }
    std::vec_i32::destroy(value);
    return 0;
}

fn check_u32() -> i32 {
    let fill: u32 = 4294967295;
    let different: u32 = 2147483648;
    let fallback: u32 = 123;
    let value: std::vec_u32::VecU32 = std::vec_u32::new();
    value = std::vec_u32::try_resize(value, 3, fill);
    if (std::vec_u32::len(value) != 3 || std::vec_u32::capacity(value) < 3 ||
        std::vec_u32::get_or(value, 0, fallback) != fill ||
        std::vec_u32::get_or(value, 2, fallback) != fill) { return 1; }
