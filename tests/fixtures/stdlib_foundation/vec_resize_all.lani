    value = std::vec_u32::try_resize(value, 5, fill);
    let held_capacity: i32 = std::vec_u32::capacity(value);
    if (std::vec_u32::len(value) != 5 || held_capacity < 5 ||
        std::vec_u32::get_or(value, 1, fallback) != different ||
        std::vec_u32::get_or(value, 3, fallback) != fill) { return 3; }
    if (!std::vec_u32::try_set(value, 4, different)) { return 4; }
    value = std::vec_u32::try_resize(value, 2, fill);
    if (std::vec_u32::len(value) != 2 || std::vec_u32::capacity(value) != held_capacity ||
        std::vec_u32::get_or(value, 1, fallback) != different) { return 5; }
    value = std::vec_u32::try_resize(value, -1, fill);
    value = std::vec_u32::try_resize(value, 536870912, fill);
    if (std::vec_u32::len(value) != 2 || std::vec_u32::capacity(value) != held_capacity ||
        std::vec_u32::get_or(value, 1, fallback) != different) { return 6; }
    value = std::vec_u32::try_resize(value, 5, fill);
    if (std::vec_u32::len(value) != 5 || std::vec_u32::capacity(value) != held_capacity ||
        std::vec_u32::get_or(value, 4, fallback) != fill) { return 7; }
    value = std::vec_u32::try_resize(value, 0, fill);
    if (!std::vec_u32::is_empty(value) || std::vec_u32::capacity(value) != held_capacity) { return 8; }
    std::vec_u32::destroy(value);
    return 0;
}

