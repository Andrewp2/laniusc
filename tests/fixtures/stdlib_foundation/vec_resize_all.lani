fn check_bool() -> i32 {
    let fill: bool = false;
    let different: bool = true;
    let fallback: bool = true;
    let value: std::vec_bool::VecBool = std::vec_bool::new();
    value = std::vec_bool::try_resize(value, 3, fill);
    if (std::vec_bool::len(value) != 3 || std::vec_bool::capacity(value) < 3 ||
        std::vec_bool::get_or(value, 0, fallback) != fill ||
        std::vec_bool::get_or(value, 2, fallback) != fill) { return 1; }
    if (!std::vec_bool::try_set(value, 1, different)) { return 2; }
    value = std::vec_bool::try_resize(value, 5, fill);
    let held_capacity: i32 = std::vec_bool::capacity(value);
    if (std::vec_bool::len(value) != 5 || held_capacity < 5 ||
        std::vec_bool::get_or(value, 1, fallback) != different ||
        std::vec_bool::get_or(value, 3, fallback) != fill) { return 3; }
    if (!std::vec_bool::try_set(value, 4, different)) { return 4; }
    value = std::vec_bool::try_resize(value, 2, fill);
    if (std::vec_bool::len(value) != 2 || std::vec_bool::capacity(value) != held_capacity ||
        std::vec_bool::get_or(value, 1, fallback) != different) { return 5; }
    value = std::vec_bool::try_resize(value, -1, fill);
    value = std::vec_bool::try_resize(value, 536870912, fill);
    if (std::vec_bool::len(value) != 2 || std::vec_bool::capacity(value) != held_capacity ||
        std::vec_bool::get_or(value, 1, fallback) != different) { return 6; }
    value = std::vec_bool::try_resize(value, 5, fill);
    if (std::vec_bool::len(value) != 5 || std::vec_bool::capacity(value) != held_capacity ||
        std::vec_bool::get_or(value, 4, fallback) != fill) { return 7; }
    value = std::vec_bool::try_resize(value, 0, fill);
    if (!std::vec_bool::is_empty(value) || std::vec_bool::capacity(value) != held_capacity) { return 8; }
    std::vec_bool::destroy(value);
    return 0;
}

fn main() -> i32 {
    if (check_i32() != 0) { return 1; }
    if (check_u32() != 0) { return 2; }
    if (check_u8() != 0) { return 3; }
    if (check_i8() != 0) { return 4; }
    if (check_u16() != 0) { return 5; }
    if (check_i16() != 0) { return 6; }
    if (check_bool() != 0) { return 7; }
    return 0;
}
