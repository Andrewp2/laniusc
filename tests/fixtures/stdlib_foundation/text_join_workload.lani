// Native runtime/allocation comparison, not a GPU compiler throughput test.
// No argument: one join. Any extra argument: repeated append of the same parts.
module app::main;
import alloc::string;
import core::io;
import core::result;
import core::slice;
import core::text;
import std::args_checked;
import std::stream;
import std::vec;

fn main() -> i32 {
    let bytes: [u8; 8] = [195, 169, 0, 240, 159, 153, 130, 122];
    let space_byte: [u8; 1] = [32];
    let word: core::text::Text = core::result::unwrap(core::text::from_utf8(bytes, 8));
    let space: core::text::Text = core::result::unwrap(core::text::from_utf8(space_byte, 1));
    let parts: std::vec::Vec<core::text::Text> = std::vec::try_with_capacity(65536);
    if (std::vec::capacity(parts) != 65536) { return 4; }
    let index: i32 = 0;
    while (index < 65536) { parts = std::vec::push(parts, word); index += 1; }
    let output: alloc::string::String = alloc::string::new();
    if (std::args_checked::argument_count_or(0) == 1) {
        let view: core::slice::View<core::text::Text> = core::result::unwrap(core::slice::view(std::vec::as_slice(parts), 65536));
        output = core::result::unwrap(alloc::string::join(view, space));
    } else {
        index = 0;
        while (index < 65536) {
            if (index > 0) { core::result::unwrap(output.try_append_text(space)); }
            core::result::unwrap(output.try_append_text(std::vec::at(parts, index)));
            index += 1;
        }
    }
    let sink: std::stream::Descriptor = std::stream::stdout();
    let written: core::result::Result<i32, core::io::Failure> = core::io::write_all(sink.borrow(), output.as_bytes(), 0, output.byte_len());
    output.destroy(); std::vec::destroy(parts);
    if (core::result::is_err(written)) { return 3; }
    return 0;
}
