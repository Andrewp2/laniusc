module app::main;
import std::deque_bool;

fn main() -> i32 {
    let value: std::deque_bool::DequeBool = std::deque_bool::try_with_capacity(3);
    if (std::deque_bool::capacity(value) != 3) { return 5; }
    value = std::deque_bool::try_push_back(value, true);
    value = std::deque_bool::try_push_back(value, false);
    value = std::deque_bool::try_push_back(value, true);
    value = std::deque_bool::try_pop_front(value);
    value = std::deque_bool::try_push_back(value, false);
    let copy: std::deque_bool::DequeBool = std::deque_bool::try_clone(value);
    let intact: bool = std::deque_bool::len(value) == 3 &&
        std::deque_bool::at_or(value, 0, false) == false &&
        std::deque_bool::at_or(value, 1, false) == true &&
        std::deque_bool::at_or(value, 2, false) == false;
    let failure: bool = intact && std::deque_bool::len(copy) == 0 &&
        std::deque_bool::capacity(copy) == 0;
    let success: bool = intact && std::deque_bool::len(copy) == 3 &&
        std::deque_bool::capacity(copy) == 3 &&
        std::deque_bool::at_or(copy, 0, false) == false &&
        std::deque_bool::at_or(copy, 1, false) == true &&
        std::deque_bool::at_or(copy, 2, false) == false;
    std::deque_bool::destroy(copy);
    std::deque_bool::destroy(value);
    if (failure) { return 0; }
    if (success) { return 4; }
    return 5;
}
