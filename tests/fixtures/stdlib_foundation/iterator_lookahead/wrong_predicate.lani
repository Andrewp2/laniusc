module app::main;
import core::iter;
import core::option;
struct Predicate {}
impl Predicate { fn borrow(&self) -> &Predicate { return self; } }
pub impl core::iter::Mapper<i32,i32> for Predicate { pub fn apply(&self,value: i32) -> i32 { return value; } }
fn main() -> i32 {
    let source: core::iter::Once<i32> =core::iter::once<i32>(1); let predicate: Predicate=Predicate {};
    let value: core::option::Option<u64> =core::iter::position<core::iter::Once<i32>,Predicate,i32>(source.borrow(),predicate.borrow());
    return 0;
}
