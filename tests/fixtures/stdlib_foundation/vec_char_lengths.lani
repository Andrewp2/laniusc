module app::main;
import std::vec_char;

fn main() -> i32 {
    let max_code: u32 = 4294967295;
    let maximum: char = max_code;
    let fallback: char = '?';
    let value: std::vec_char::VecChar = std::vec_char::try_with_capacity(5);
    if (std::vec_char::capacity(value) != 5) { return 1; }
    value = std::vec_char::try_push(value, 'Ω');
    value = std::vec_char::try_push(value, maximum);
    value = std::vec_char::try_push(value, '😀');
    value = std::vec_char::truncate(value, -1);
    value = std::vec_char::truncate(value, 4);
    if (std::vec_char::len(value) != 3 || std::vec_char::capacity(value) != 5 ||
        std::vec_char::get_or(value, 2, fallback) != '😀') { return 2; }
    value = std::vec_char::truncate(value, 2);
    if (std::vec_char::len(value) != 2 ||
        std::vec_char::get_or(value, 1, fallback) != maximum) { return 3; }
    value = std::vec_char::try_resize(value, 4, 'é');
    if (std::vec_char::len(value) != 4 || std::vec_char::capacity(value) != 5 ||
        std::vec_char::get_or(value, 2, fallback) != 'é' ||
        std::vec_char::get_or(value, 3, fallback) != 'é') { return 4; }
    value = std::vec_char::try_resize(value, -1, 'x');
    value = std::vec_char::try_resize(value, 536870912, 'x');
    if (std::vec_char::len(value) != 4 ||
        std::vec_char::get_or(value, 3, fallback) != 'é') { return 5; }
    value = std::vec_char::try_resize(value, 2, 'x');
    if (std::vec_char::len(value) != 2 || std::vec_char::capacity(value) != 5 ||
        std::vec_char::get_or(value, 1, fallback) != maximum) { return 6; }
    value = std::vec_char::try_shrink_to_fit(value);
    if (std::vec_char::len(value) != 2 || std::vec_char::capacity(value) != 2 ||
        std::vec_char::get_or(value, 0, fallback) != 'Ω' ||
        std::vec_char::get_or(value, 1, fallback) != maximum) { return 7; }
    value = std::vec_char::try_shrink_to_fit(value);
    if (std::vec_char::capacity(value) != 2) { return 8; }
    value = std::vec_char::try_resize(value, 3, '中');
    if (std::vec_char::len(value) != 3 || std::vec_char::capacity(value) != 3 ||
        std::vec_char::get_or(value, 2, fallback) != '中') { return 9; }
    value = std::vec_char::truncate(value, 0);
    if (!std::vec_char::is_empty(value) || std::vec_char::capacity(value) != 3) { return 10; }
    value = std::vec_char::try_shrink_to_fit(value);
    if (std::vec_char::len(value) != 0 || std::vec_char::capacity(value) != 0) { return 11; }
    value = std::vec_char::try_push(value, '😀');
    if (std::vec_char::get_or(value, 0, fallback) != '😀') { return 12; }
    std::vec_char::destroy(value);
    return 0;
}
