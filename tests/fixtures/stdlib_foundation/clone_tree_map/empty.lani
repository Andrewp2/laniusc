module app::main;
import alloc::clone_tree_map;
import alloc::string;
import alloc::tree_map;
import core::result;
fn main() -> i32 {
    let empty: alloc::tree_map::TreeMap<alloc::string::String,alloc::string::String> = alloc::tree_map::new();
    let result: core::result::Result<alloc::tree_map::TreeMap<alloc::string::String,alloc::string::String>,alloc::clone_tree_map::Error<alloc::string::Error,alloc::string::Error>> =
        alloc::clone_tree_map::try_clone<alloc::string::String,alloc::string::String,alloc::string::Error,alloc::string::Error>(empty.borrow());
    let copy = result.unwrap(); assert(copy.is_empty() && copy.capacity()==0 && empty.capacity()==0);
    alloc::clone_tree_map::destroy_tree_map<alloc::string::String,alloc::string::String>(copy.borrow());
    alloc::clone_tree_map::destroy_tree_map<alloc::string::String,alloc::string::String>(copy.borrow());
    empty.destroy(); return 0;
}
