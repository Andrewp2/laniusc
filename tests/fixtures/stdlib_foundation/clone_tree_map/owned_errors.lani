module app::main;
import alloc::clone_tree_map;
import alloc::string;
import alloc::tree_map;
import core::result;
import fixture::leaf;

fn number(index: i32) -> i32 { if (index==0) {return 10;} if(index==1){return 30;} return 40; }
fn message(error: fixture::leaf::Fault, expected: i32, stage: i32) -> i32 {
    return match(error) {fixture::leaf::Fault::Allocation(ignored) -> 4,fixture::leaf::Fault::Injected(id,at,owned) -> inspect(owned,id,at,expected,stage)};
}
fn inspect(owned: alloc::string::String, id: i32, at: i32, expected: i32, stage: i32) -> i32 {
    assert(id==expected && at==stage && owned.byte_len()==5 && owned.byte_at(0).unwrap()==69 && owned.byte_at(1).unwrap()==0
        && owned.byte_at(2).unwrap()==(id as u8) && owned.byte_at(3).unwrap()==(at as u8) && owned.byte_at(4).unwrap()==85);
    owned.destroy(); return 0;
}
fn keyed(index: i32,error: fixture::leaf::Fault,expected: i32,stage: i32,kind: i32) -> i32 { assert(kind==0 && index==expected); return message(error,number(expected),stage); }
fn valued(index: i32,error: fixture::leaf::Fault,expected: i32,stage: i32,kind: i32) -> i32 { assert(kind==1 && index==expected); return message(error,number(expected),stage); }
fn changed(index: i32,expected: i32,kind: i32) -> i32 { assert(kind==2 && index==expected); return 0; }
fn run_case(kind: i32,failed_index: i32,stage: i32) -> i32 {
    let bytes: [u8;4] = [83,0,195,169]; let original = alloc::string::from_utf8(bytes,4).unwrap();
    let trace: [i32;40] = [0;40];
    let source = alloc::tree_map::with_capacity<fixture::leaf::Key,fixture::leaf::Value>(6).unwrap();
    let order: [i32;4] = [30,10,20,40]; let i: i32 = 0;
    while (i<4) {
        let id: i32 = order[i]; let key_fail: i32 = -1; let value_fail: i32 = -1;
        if (id==number(failed_index)) {
            if (kind==0) {key_fail=stage;} if(kind==1){value_fail=stage;} if(kind==2){key_fail=2;}
        }
        source.try_insert(fixture::leaf::Key {number:id,text:original,fail:key_fail,trace:trace},fixture::leaf::Value {number:id,text:original,fail:value_fail,trace:trace}).unwrap();
        i+=1;
    }
    let lookup = fixture::leaf::Key {number:20,text:original,fail:-1,trace:trace}; source.remove(lookup).unwrap();
    let result: core::result::Result<alloc::tree_map::TreeMap<fixture::leaf::Key,fixture::leaf::Value>,alloc::clone_tree_map::Error<fixture::leaf::Fault,fixture::leaf::Fault>> =
        alloc::clone_tree_map::try_clone<fixture::leaf::Key,fixture::leaf::Value,fixture::leaf::Fault,fixture::leaf::Fault>(source.borrow());
    assert(result.is_err() && trace[1]==0 && trace[2]==0 && trace[3]==failed_index+1);
    let value_calls: i32 = failed_index; let reached: i32 = 1;
    if (kind==1) {value_calls+=1;reached=2;}
    assert(trace[4]==value_calls && trace[0]==2*failed_index+reached);
    i=0;
    while(i<failed_index){assert(trace[8+2*i]==100+number(i) && trace[9+2*i]==200+number(i));i+=1;}
    assert(trace[8+2*failed_index]==100+number(failed_index));
    if(kind==1){assert(trace[9+2*failed_index]==200+number(failed_index));}
    // Borrowed source aliases are still intact after every rollback. Only
    // their outer tree and the one separate original String are owners.
    assert(source.len()==3 && source.capacity()==6 && original.byte_len()==4 && original.byte_at(1).unwrap()==0);
    let first = source.first().unwrap(); let last = source.last().unwrap();
    assert(first.key.number==10 && last.key.number==40 && first.value.text.byte_at(3).unwrap()==169);
    source.destroy(); original.destroy();
    // Inspect/release E only after all source and destination mappings ended.
    return match(result.unwrap_err()) {
        alloc::clone_tree_map::Error::Key(index,error) -> keyed(index,error,failed_index,stage,kind),
        alloc::clone_tree_map::Error::Value(index,error) -> valued(index,error,failed_index,stage,kind),
        alloc::clone_tree_map::Error::ChangedKey(index) -> changed(index,failed_index,kind),
        alloc::clone_tree_map::Error::Storage(ignored) -> 4
    };
}
fn main() -> i32 {
    let kind: i32 = 0;
    while(kind<3){let index: i32=0;while(index<3){let stage:i32=0;let stages:i32=2;if(kind==2){stages=1;}while(stage<stages){let status=run_case(kind,index,stage);if(status!=0){return status;}stage+=1;}index+=1;}kind+=1;}
    return 0;
}
