// Exercise sorting and searching the owned allocation, including logical
// empty vectors with and without allocated capacity.
module app::main;
import std::vec_i32;

fn main() -> i32 {
    let empty: std::vec_i32::VecI32 = std::vec_i32::new();
    if (std::vec_i32::sort_in_place(empty) != 0 ||
        std::vec_i32::reverse_in_place(empty) != 0 ||
        std::vec_i32::lower_bound(empty, 4) != 0 ||
        std::vec_i32::upper_bound(empty, 4) != 0 ||
        std::vec_i32::binary_search_first_or(empty, 4, -9) != -9 ||
        std::vec_i32::binary_search_last_or(empty, 4, -7) != -7) { return 1; }
    std::vec_i32::destroy(empty);

    let reserved: std::vec_i32::VecI32 = std::vec_i32::try_with_capacity(3);
    if (std::vec_i32::capacity(reserved) != 3 ||
        std::vec_i32::sort_in_place(reserved) != 0 ||
        std::vec_i32::lower_bound(reserved, 0) != 0 ||
        std::vec_i32::binary_search_last_or(reserved, 0, 12) != 12) { return 2; }
    std::vec_i32::destroy(reserved);

    let single: std::vec_i32::VecI32 = std::vec_i32::new();
    single = std::vec_i32::try_push(single, -2147483648);
    if (std::vec_i32::len(single) != 1 ||
        std::vec_i32::sort_in_place(single) != 1 ||
        std::vec_i32::reverse_in_place(single) != 0 ||
        std::vec_i32::lower_bound(single, -2147483648) != 0 ||
        std::vec_i32::upper_bound(single, -2147483648) != 1 ||
        std::vec_i32::binary_search_first_or(single, -2147483648, -1) != 0 ||
        std::vec_i32::binary_search_last_or(single, 4, -1) != -1) { return 3; }
    std::vec_i32::destroy(single);

    let values: [i32; 8] = [2147483647, 3, -2147483648, 3, 0, -4, 3, 2147483647];
    let owned: std::vec_i32::VecI32 = std::vec_i32::new();
    owned = std::vec_i32::try_extend_from_slice(owned, values, 8);
    if (std::vec_i32::len(owned) != 8 || std::vec_i32::capacity(owned) != 8) { return 4; }
    if (std::vec_i32::sort_in_place(owned) != 8 || std::vec_i32::capacity(owned) != 8 ||
        std::vec_i32::get_or(owned, 0, 99) != -2147483648 ||
        std::vec_i32::get_or(owned, 1, 99) != -4 ||
        std::vec_i32::get_or(owned, 2, 99) != 0 ||
        std::vec_i32::get_or(owned, 3, 99) != 3 ||
        std::vec_i32::get_or(owned, 4, 99) != 3 ||
        std::vec_i32::get_or(owned, 5, 99) != 3 ||
        std::vec_i32::get_or(owned, 6, 99) != 2147483647 ||
        std::vec_i32::get_or(owned, 7, 99) != 2147483647) { return 5; }
    if (std::vec_i32::lower_bound(owned, -2147483648) != 0 ||
        std::vec_i32::upper_bound(owned, -2147483648) != 1 ||
        std::vec_i32::lower_bound(owned, -3) != 2 ||
        std::vec_i32::upper_bound(owned, 3) != 6 ||
        std::vec_i32::lower_bound(owned, 3) != 3 ||
        std::vec_i32::lower_bound(owned, 2147483647) != 6 ||
        std::vec_i32::upper_bound(owned, 2147483647) != 8) { return 6; }
    if (std::vec_i32::binary_search_first_or(owned, 3, -1) != 3 ||
        std::vec_i32::binary_search_last_or(owned, 3, -1) != 5 ||
        std::vec_i32::binary_search_first_or(owned, 2147483647, -1) != 6 ||
        std::vec_i32::binary_search_last_or(owned, 2147483647, -1) != 7 ||
        std::vec_i32::binary_search_first_or(owned, 4, -12) != -12 ||
        std::vec_i32::binary_search_last_or(owned, -3, -13) != -13) { return 7; }
    if (std::vec_i32::reverse_in_place(owned) != 4 ||
        std::vec_i32::get_or(owned, 0, 99) != 2147483647 ||
        std::vec_i32::get_or(owned, 1, 99) != 2147483647 ||
        std::vec_i32::get_or(owned, 5, 99) != 0 ||
        std::vec_i32::get_or(owned, 6, 99) != -4 ||
        std::vec_i32::get_or(owned, 7, 99) != -2147483648) { return 8; }
    if (std::vec_i32::sort_in_place(owned) != 8 ||
        std::vec_i32::binary_search_last_or(owned, 3, -1) != 5 ||
        std::vec_i32::capacity(owned) != 8) { return 9; }
    std::vec_i32::destroy(owned);
    return 0;
}
