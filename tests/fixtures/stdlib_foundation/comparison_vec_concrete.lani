// Concrete float-key Vec callers include element-returning methods.
module app::main;
import alloc::vec;
import core::cmp;
import core::f32;
import core::f64;
import core::float_order;
import core::option;
import core::result;
fn main() -> i32 {
    let single: alloc::vec::Vec<core::float_order::TotalF32> = alloc::vec::new();
    core::result::unwrap(single.try_push(core::float_order::from_f32(core::f32::from_bits(2143289345))));
    core::result::unwrap(single.try_push(core::float_order::from_f32(0.0)));
    core::result::unwrap(single.try_push(core::float_order::from_f32(-0.0)));
    single.sort();
    let first: core::float_order::TotalF32 = single.at(0);
    let last: core::float_order::TotalF32 = core::option::unwrap(single.get(2));
    if (first.to_bits() != 2147483648 || last.to_bits() != 2143289345 || single.binary_search(first) != 0) { return 1; }
    single.destroy();
    let double: alloc::vec::Vec<core::float_order::TotalF64> = alloc::vec::new();
    core::result::unwrap(double.try_push(core::float_order::from_f64(core::f64::from_bits(9221120237041090561))));
    let positive_zero: f64 = 0.0; let negative_zero: f64 = -0.0;
    core::result::unwrap(double.try_push(core::float_order::from_f64(positive_zero)));
    core::result::unwrap(double.try_push(core::float_order::from_f64(negative_zero)));
    double.sort();
    let low: core::float_order::TotalF64 = double.at(0);
    let high: core::float_order::TotalF64 = core::option::unwrap(double.get(2));
    if (low.to_bits() != 9223372036854775808 || high.to_bits() != 9221120237041090561 || double.binary_search(low) != 0) { return 2; }
    double.destroy(); return 0;
}
