module app::main;
import std::vec_i32;

fn main() -> i32 {
    let value: std::vec_i32::VecI32 = std::vec_i32::try_with_capacity(1);
    if (std::vec_i32::capacity(value) != 1) { return 2; }
    value = std::vec_i32::try_push(value, 41);
    if (std::vec_i32::len(value) != 1) { return 3; }
    value = std::vec_i32::try_resize(value, 3, 9);
    if (std::vec_i32::len(value) == 1 && std::vec_i32::capacity(value) == 1 &&
        std::vec_i32::get_or(value, 0, -1) == 41) {
        std::vec_i32::destroy(value);
        return 0;
    }
    if (std::vec_i32::len(value) == 3 && std::vec_i32::capacity(value) == 3 &&
        std::vec_i32::get_or(value, 0, -1) == 41 &&
        std::vec_i32::get_or(value, 1, -1) == 9 &&
        std::vec_i32::get_or(value, 2, -1) == 9) {
        std::vec_i32::destroy(value);
        return 4;
    }
    std::vec_i32::destroy(value);
    return 5;
}
