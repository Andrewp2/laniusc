module app::main;
import std::vec_i32;

fn main() -> i32 {
    let first: i32 = 41;
    let second: i32 = 42;
    let third: i32 = 43;
    let fallback: i32 = -1;
    let additions: [i32; 2] = [second, third];
    let value: std::vec_i32::VecI32 = std::vec_i32::try_with_capacity(1);
    if (std::vec_i32::capacity(value) != 1) { return 2; }
    value = std::vec_i32::try_push(value, first);
    if (std::vec_i32::len(value) != 1) { return 3; }
    value = std::vec_i32::try_extend_from_slice(value, additions, 2);
    if (std::vec_i32::len(value) == 3) {
        if (std::vec_i32::get_or(value, 0, fallback) != first ||
            std::vec_i32::get_or(value, 1, fallback) != second ||
            std::vec_i32::get_or(value, 2, fallback) != third) { return 6; }
        std::vec_i32::destroy(value);
        return 4;
    }
    if (std::vec_i32::len(value) != 1 ||
        std::vec_i32::capacity(value) != 1 ||
        std::vec_i32::get_or(value, 0, fallback) != first) { return 5; }
    std::vec_i32::destroy(value);
    return 0;
}
