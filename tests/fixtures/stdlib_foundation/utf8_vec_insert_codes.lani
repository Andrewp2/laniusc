module app::main;
import std::utf8_vec;
import std::vec_u8;

fn main() -> i32 {
    let source: [i32; 3] = [65, 194, 162];
    let euro: [i32; 3] = [226, 130, 172];
    let smile: [i32; 4] = [240, 159, 153, 130];
    let bang: [i32; 1] = [33];
    let truncated: [i32; 2] = [226, 130];
    let malformed: [i32; 2] = [65, 128];
    let high_code: [i32; 2] = [65, 256];

    let text: std::vec_u8::VecU8 = std::utf8_vec::new();
    text = std::utf8_vec::try_insert_codes(text, 0, source, 3);
    if (std::utf8_vec::byte_len(text) != 3 ||
        std::utf8_vec::scalar_count_or(text, -9) != 2 ||
        std::utf8_vec::scalar_at_or(text, 0, 4294967295) != 65 ||
        std::utf8_vec::scalar_at_or(text, 1, 4294967295) != 162) { return 1; }

    text = std::utf8_vec::try_insert_codes(text, 1, euro, 3);
    text = std::utf8_vec::try_insert_codes(text, 0, smile, 4);
    text = std::utf8_vec::try_insert_codes(text, 4, bang, 1);
    if (std::utf8_vec::byte_len(text) != 11 ||
        std::utf8_vec::scalar_count_or(text, -9) != 5 ||
        std::utf8_vec::scalar_at_or(text, 0, 4294967295) != 128578 ||
        std::utf8_vec::scalar_at_or(text, 1, 4294967295) != 65 ||
        std::utf8_vec::scalar_at_or(text, 2, 4294967295) != 8364 ||
        std::utf8_vec::scalar_at_or(text, 3, 4294967295) != 162 ||
        std::utf8_vec::scalar_at_or(text, 4, 4294967295) != 33 ||
        std::vec_u8::get_or(text, 0, 0) != 240 ||
        std::vec_u8::get_or(text, 9, 0) != 162 ||
        std::vec_u8::get_or(text, 10, 0) != 33) { return 2; }

    text = std::utf8_vec::try_insert_codes(text, -1, source, 3);
    text = std::utf8_vec::try_insert_codes(text, 6, source, 3);
    text = std::utf8_vec::try_insert_codes(text, 2, source, 0);
    text = std::utf8_vec::try_insert_codes(text, 2, source, -1);
    text = std::utf8_vec::try_insert_codes(text, 2, source, 2);
    text = std::utf8_vec::try_insert_codes(text, 2, truncated, 2);
    text = std::utf8_vec::try_insert_codes(text, 2, malformed, 2);
    text = std::utf8_vec::try_insert_codes(text, 2, high_code, 2);
    if (std::utf8_vec::byte_len(text) != 11 ||
        std::utf8_vec::scalar_count_or(text, -9) != 5 ||
        std::utf8_vec::scalar_at_or(text, 2, 4294967295) != 8364 ||
        std::vec_u8::get_or(text, 10, 0) != 33) { return 3; }

    let invalid: std::vec_u8::VecU8 = std::vec_u8::new();
    invalid = std::vec_u8::try_push(invalid, 65);
    invalid = std::vec_u8::try_push(invalid, 128);
    invalid = std::utf8_vec::try_insert_codes(invalid, 0, source, 3);
    if (std::utf8_vec::byte_len(invalid) != 2 ||
        std::vec_u8::get_or(invalid, 0, 0) != 65 ||
        std::vec_u8::get_or(invalid, 1, 0) != 128) { return 4; }

    std::utf8_vec::destroy(invalid);
    std::utf8_vec::destroy(text);
    return 0;
}
