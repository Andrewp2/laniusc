// Native imported generic admission: nested adapters, consumer and payloads.
module app::main;
import core::iter;
import core::option;
import core::range;
import core::result;

struct Payload { wide: u64, flags: core::option::Option<bool>, cells: [i32; 2] }
struct Local { value: i32, ended: bool }
impl Local { fn borrow(&self) -> &Local { return self; } }
pub impl core::iter::Iterator<i32> for Local {
    pub fn next(&self) -> core::option::Option<i32> {
        if (self.ended) { return core::option::None(); }
        self.ended = true;
        return core::option::Some(self.value);
    }
}
fn pull<I, T>(source: &I) -> core::option::Option<T> where I: core::iter::Iterator<T> {
    let item: core::option::Option<T> = source.next();
    return item;
}
fn main() -> i32 {
    let values: [i32; 4] = [3, 5, 7, 9];
    let source: core::iter::SliceIter<i32> = core::result::unwrap(core::iter::from_slice<i32>(values, 4));
    let first: core::iter::Take<core::iter::SliceIter<i32>, i32> =
        core::iter::take<core::iter::SliceIter<i32>, i32>(source.borrow(), 3);
    let second: core::iter::Take<core::iter::Take<core::iter::SliceIter<i32>, i32>, i32> =
        core::iter::take<core::iter::Take<core::iter::SliceIter<i32>, i32>, i32>(first.borrow(), 2);
    let local: Local = Local { value: 40, ended: false };
    let joined: core::iter::Chain<core::iter::Take<core::iter::Take<core::iter::SliceIter<i32>, i32>, i32>, Local, i32> =
        core::iter::chain<core::iter::Take<core::iter::Take<core::iter::SliceIter<i32>, i32>, i32>, Local, i32>(second.borrow(), local.borrow());
    let picked: core::option::Option<i32> = pull<core::iter::Chain<core::iter::Take<core::iter::Take<core::iter::SliceIter<i32>, i32>, i32>, Local, i32>, i32>(joined.borrow());
    if (core::option::unwrap(picked) != 3) { return 1; }
    let progress: core::iter::Advance = core::iter::advance_up_to<core::iter::Chain<core::iter::Take<core::iter::Take<core::iter::SliceIter<i32>, i32>, i32>, Local, i32>, i32>(joined.borrow(), 2);
    if (progress.advanced != 2 || progress.exhausted || source.remaining() != 2) { return 2; }
    let ended: core::option::Option<i32> = joined.next();
    if (core::option::is_some(ended) || !local.ended) { return 3; }
    let third: core::option::Option<i32> = first.next();
    if (core::option::unwrap(third) != 7 || source.remaining() != 1) { return 4; }

    let one: Payload = Payload { wide: 18446744073709551615, flags: core::option::Some(false), cells: [19, 23] };
    let data: [Payload; 1] = [one];
    let nested: core::iter::SliceIter<Payload> = core::result::unwrap(core::iter::from_slice<Payload>(data, 1));
    let take_payload: core::iter::Take<core::iter::SliceIter<Payload>, Payload> =
        core::iter::take<core::iter::SliceIter<Payload>, Payload>(nested.borrow(), 1);
    let found_option: core::option::Option<Payload> = pull<core::iter::Take<core::iter::SliceIter<Payload>, Payload>, Payload>(take_payload.borrow());
    let found: Payload = core::option::unwrap(found_option);
    if (found.wide != 18446744073709551615 || core::option::unwrap(found.flags) || found.cells[1] != 23) { return 5; }

    let bounds: core::range::RangeInclusive<i32> = core::range::range_inclusive<i32>(2147483646, 2147483647);
    let range: core::iter::RangeI32 = core::iter::range_i32_inclusive(bounds);
    let range_progress: core::iter::Advance = core::iter::advance_up_to<core::iter::RangeI32, i32>(range.borrow(), 3);
    if (range_progress.advanced != 2 || !range_progress.exhausted || range.remaining() != 0) { return 6; }
    return 0;
}
