module app::main;
import std::map_i32_i32;

fn main() -> i32 {
    let value: std::map_i32_i32::MapI32I32 =
        std::map_i32_i32::try_reserve(std::map_i32_i32::new(), 3);
    if (std::map_i32_i32::capacity(value) != 3) { return 2; }
    value = std::map_i32_i32::try_insert(value, -7, 41);
    if (std::map_i32_i32::len(value) != 1) { return 3; }
    value = std::map_i32_i32::try_shrink_to_fit(value);
    if (std::map_i32_i32::len(value) == 1 &&
        std::map_i32_i32::capacity(value) == 3 &&
        std::map_i32_i32::get_or(value, -7, 0) == 41) {
        std::map_i32_i32::destroy(value);
        return 0;
    }
    if (std::map_i32_i32::len(value) == 1 &&
        std::map_i32_i32::capacity(value) == 1 &&
        std::map_i32_i32::get_or(value, -7, 0) == 41) {
        std::map_i32_i32::destroy(value);
        return 4;
    }
    std::map_i32_i32::destroy(value);
    return 5;
}
