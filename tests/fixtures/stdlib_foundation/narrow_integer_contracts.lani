module app::main;
import core::i8;
import core::u8;
import core::i16;
import core::u16;
import core::i32;
import core::u32;
import core::option;
fn main() -> i32 {
    assert(core::i8::MIN == -128);
    assert(core::i8::MAX == 127);
    assert(core::i8::BITS == 8);
    assert(core::i8::BYTES == 1);
    assert(core::i8::clamp(7,2,5) == 5);
    assert(core::i8::clamp(1,2,5) == 2);
    assert(core::i8::clamp(3,2,5) == 3);
    assert(core::i8::div(21,3) == 7);
    assert(core::i8::rem(22,3) == 1);
    assert(core::i8::div_euclid(22,3) == 7);
    assert(core::i8::rem_euclid(22,3) == 1);
    assert(core::i8::shl(3,1) == 6);
    assert(core::i8::shr(6,1) == 3);
    assert(core::i8::next_power_of_two(7) == 8);
    assert(core::i8::is_zero(0));
    assert(!core::i8::is_zero(1));
    assert(core::i8::is_nonzero(1));
    assert(!core::i8::is_nonzero(0));
    assert(core::i8::is_odd(3));
    assert(!core::i8::is_odd(2));
    assert(core::i8::between_inclusive(2,2,5));
    assert(!core::i8::between_inclusive(3,5,2));
    assert(core::i8::between_exclusive(3,2,5));
    assert(!core::i8::between_exclusive(2,2,5));
    assert(core::option::contains(core::i8::checked_lcm(6,8),24));
    assert(core::i8::gcd(6,8) == 2);
    assert(core::i8::gcd(0,0) == 0);
    assert(core::i8::abs(-7) == 7);
    assert(core::i8::compare_as_i32(-2,1) == -1);
    assert(core::i8::compare_as_i32(1,1) == 0);
    assert(core::i8::compare_as_i32(1,-2) == 1);
    assert(core::i8::is_negative(-1));
    assert(!core::i8::is_negative(0));
    assert(core::i8::is_positive(1));
    assert(!core::i8::is_positive(0));
    assert(core::i8::is_nonnegative(0));
    assert(!core::i8::is_nonnegative(-1));
    assert(core::i8::is_nonpositive(0));
    assert(!core::i8::is_nonpositive(1));
    assert(core::i8::from_i8(7) == 7);
    assert(core::u8::MIN == 0);
    assert(core::u8::MAX == 255);
    assert(core::u8::BITS == 8);
    assert(core::u8::BYTES == 1);
    assert(core::u8::clamp(7,2,5) == 5);
    assert(core::u8::clamp(1,2,5) == 2);
    assert(core::u8::clamp(3,2,5) == 3);
    assert(core::u8::div(21,3) == 7);
    assert(core::u8::rem(22,3) == 1);
    assert(core::u8::div_euclid(22,3) == 7);
    assert(core::u8::rem_euclid(22,3) == 1);
    assert(core::u8::shl(3,1) == 6);
    assert(core::u8::shr(6,1) == 3);
    assert(core::u8::next_power_of_two(7) == 8);
    assert(core::u8::is_zero(0));
    assert(!core::u8::is_zero(1));
    assert(core::u8::is_nonzero(1));
    assert(!core::u8::is_nonzero(0));
    assert(core::u8::is_odd(3));
    assert(!core::u8::is_odd(2));
    assert(core::u8::between_inclusive(2,2,5));
    assert(!core::u8::between_inclusive(3,5,2));
    assert(core::u8::between_exclusive(3,2,5));
    assert(!core::u8::between_exclusive(2,2,5));
    assert(core::option::contains(core::u8::checked_lcm(6,8),24));
    assert(core::u8::gcd(6,8) == 2);
    assert(core::u8::gcd(0,0) == 0);
    assert(core::u8::align_up(17,8) == 24);
    assert(core::u8::align_down(26,8) == 24);
    assert(core::u8::align_up(17,3) == 18);
    assert(core::u8::align_down(17,3) == 15);
    assert(core::option::contains(core::u8::checked_align_down(3,8),0));
    assert(core::option::contains(core::u8::checked_align_up(0,8),0));
    assert(core::option::is_none(core::u8::checked_align_up(core::u8::MAX,2)));
    assert(core::option::is_none(core::u8::checked_align_up(1,0)));
    assert(core::option::is_none(core::u8::checked_align_down(1,0)));
    assert(core::u8::from_u8(7) == 7);
    assert(core::i16::MIN == -32768);
    assert(core::i16::MAX == 32767);
    assert(core::i16::BITS == 16);
    assert(core::i16::BYTES == 2);
    assert(core::i16::clamp(7,2,5) == 5);
    assert(core::i16::clamp(1,2,5) == 2);
    assert(core::i16::clamp(3,2,5) == 3);
    assert(core::i16::div(21,3) == 7);
    assert(core::i16::rem(22,3) == 1);
    assert(core::i16::div_euclid(22,3) == 7);
    assert(core::i16::rem_euclid(22,3) == 1);
    assert(core::i16::shl(3,1) == 6);
    assert(core::i16::shr(6,1) == 3);
    assert(core::i16::next_power_of_two(7) == 8);
    assert(core::i16::is_zero(0));
    assert(!core::i16::is_zero(1));
    assert(core::i16::is_nonzero(1));
    assert(!core::i16::is_nonzero(0));
    assert(core::i16::is_odd(3));
    assert(!core::i16::is_odd(2));
    assert(core::i16::between_inclusive(2,2,5));
    assert(!core::i16::between_inclusive(3,5,2));
    assert(core::i16::between_exclusive(3,2,5));
    assert(!core::i16::between_exclusive(2,2,5));
    assert(core::option::contains(core::i16::checked_lcm(6,8),24));
    assert(core::i16::gcd(6,8) == 2);
    assert(core::i16::gcd(0,0) == 0);
    assert(core::i16::abs(-7) == 7);
    assert(core::i16::compare_as_i32(-2,1) == -1);
    assert(core::i16::compare_as_i32(1,1) == 0);
    assert(core::i16::compare_as_i32(1,-2) == 1);
    assert(core::i16::is_negative(-1));
    assert(!core::i16::is_negative(0));
    assert(core::i16::is_positive(1));
    assert(!core::i16::is_positive(0));
    assert(core::i16::is_nonnegative(0));
    assert(!core::i16::is_nonnegative(-1));
    assert(core::i16::is_nonpositive(0));
    assert(!core::i16::is_nonpositive(1));
    assert(core::i16::from_i8(7) == 7);
    assert(core::i16::from_u8(7) == 7);
    assert(core::i16::from_i16(7) == 7);
    assert(core::u16::MIN == 0);
    assert(core::u16::MAX == 65535);
    assert(core::u16::BITS == 16);
    assert(core::u16::BYTES == 2);
    assert(core::u16::clamp(7,2,5) == 5);
    assert(core::u16::clamp(1,2,5) == 2);
    assert(core::u16::clamp(3,2,5) == 3);
    assert(core::u16::div(21,3) == 7);
    assert(core::u16::rem(22,3) == 1);
    assert(core::u16::div_euclid(22,3) == 7);
    assert(core::u16::rem_euclid(22,3) == 1);
    assert(core::u16::shl(3,1) == 6);
    assert(core::u16::shr(6,1) == 3);
    assert(core::u16::next_power_of_two(7) == 8);
    assert(core::u16::is_zero(0));
    assert(!core::u16::is_zero(1));
    assert(core::u16::is_nonzero(1));
    assert(!core::u16::is_nonzero(0));
    assert(core::u16::is_odd(3));
    assert(!core::u16::is_odd(2));
    assert(core::u16::between_inclusive(2,2,5));
    assert(!core::u16::between_inclusive(3,5,2));
    assert(core::u16::between_exclusive(3,2,5));
    assert(!core::u16::between_exclusive(2,2,5));
    assert(core::option::contains(core::u16::checked_lcm(6,8),24));
    assert(core::u16::gcd(6,8) == 2);
    assert(core::u16::gcd(0,0) == 0);
    assert(core::u16::align_up(17,8) == 24);
    assert(core::u16::align_down(26,8) == 24);
    assert(core::u16::align_up(17,3) == 18);
    assert(core::u16::align_down(17,3) == 15);
    assert(core::option::contains(core::u16::checked_align_down(3,8),0));
    assert(core::option::contains(core::u16::checked_align_up(0,8),0));
    assert(core::option::is_none(core::u16::checked_align_up(core::u16::MAX,2)));
    assert(core::option::is_none(core::u16::checked_align_up(1,0)));
    assert(core::option::is_none(core::u16::checked_align_down(1,0)));
    assert(core::u16::from_u8(7) == 7);
    assert(core::u16::from_u16(7) == 7);
    assert(core::i32::MIN == -2147483648);
    assert(core::i32::MAX == 2147483647);
    assert(core::i32::BITS == 32);
    assert(core::i32::BYTES == 4);
    assert(core::i32::clamp(7,2,5) == 5);
    assert(core::i32::clamp(1,2,5) == 2);
    assert(core::i32::clamp(3,2,5) == 3);
    assert(core::i32::div(21,3) == 7);
    assert(core::i32::rem(22,3) == 1);
    assert(core::i32::div_euclid(22,3) == 7);
    assert(core::i32::rem_euclid(22,3) == 1);
    assert(core::i32::shl(3,1) == 6);
    assert(core::i32::shr(6,1) == 3);
    assert(core::i32::next_power_of_two(7) == 8);
    assert(core::i32::is_zero(0));
    assert(!core::i32::is_zero(1));
    assert(core::i32::is_nonzero(1));
    assert(!core::i32::is_nonzero(0));
    assert(core::i32::is_odd(3));
    assert(!core::i32::is_odd(2));
    assert(core::i32::between_inclusive(2,2,5));
    assert(!core::i32::between_inclusive(3,5,2));
    assert(core::i32::between_exclusive(3,2,5));
    assert(!core::i32::between_exclusive(2,2,5));
    assert(core::option::contains(core::i32::checked_lcm(6,8),24));
    assert(core::i32::gcd(6,8) == 2);
    assert(core::i32::gcd(0,0) == 0);
    assert(core::i32::abs(-7) == 7);
    assert(core::i32::compare_as_i32(-2,1) == -1);
    assert(core::i32::compare_as_i32(1,1) == 0);
    assert(core::i32::compare_as_i32(1,-2) == 1);
    assert(core::i32::is_negative(-1));
    assert(!core::i32::is_negative(0));
    assert(core::i32::is_positive(1));
    assert(!core::i32::is_positive(0));
    assert(core::i32::is_nonnegative(0));
    assert(!core::i32::is_nonnegative(-1));
    assert(core::i32::is_nonpositive(0));
    assert(!core::i32::is_nonpositive(1));
    assert(core::i32::from_i8(7) == 7);
    assert(core::i32::from_u8(7) == 7);
    assert(core::i32::from_i16(7) == 7);
    assert(core::i32::from_u16(7) == 7);
    assert(core::i32::from_i32(7) == 7);
    assert(core::u32::MIN == 0);
    assert(core::u32::MAX == 4294967295);
    assert(core::u32::BITS == 32);
    assert(core::u32::BYTES == 4);
    assert(core::u32::clamp(7,2,5) == 5);
    assert(core::u32::clamp(1,2,5) == 2);
    assert(core::u32::clamp(3,2,5) == 3);
    assert(core::u32::div(21,3) == 7);
    assert(core::u32::rem(22,3) == 1);
    assert(core::u32::div_euclid(22,3) == 7);
    assert(core::u32::rem_euclid(22,3) == 1);
    assert(core::u32::shl(3,1) == 6);
    assert(core::u32::shr(6,1) == 3);
    assert(core::u32::next_power_of_two(7) == 8);
    assert(core::u32::is_zero(0));
    assert(!core::u32::is_zero(1));
    assert(core::u32::is_nonzero(1));
    assert(!core::u32::is_nonzero(0));
    assert(core::u32::is_odd(3));
    assert(!core::u32::is_odd(2));
    assert(core::u32::between_inclusive(2,2,5));
    assert(!core::u32::between_inclusive(3,5,2));
    assert(core::u32::between_exclusive(3,2,5));
    assert(!core::u32::between_exclusive(2,2,5));
    assert(core::option::contains(core::u32::checked_lcm(6,8),24));
    assert(core::u32::gcd(6,8) == 2);
    assert(core::u32::gcd(0,0) == 0);
    assert(core::u32::align_up(17,8) == 24);
    assert(core::u32::align_down(26,8) == 24);
    assert(core::u32::align_up(17,3) == 18);
    assert(core::u32::align_down(17,3) == 15);
    assert(core::option::contains(core::u32::checked_align_down(3,8),0));
    assert(core::option::contains(core::u32::checked_align_up(0,8),0));
    assert(core::option::is_none(core::u32::checked_align_up(core::u32::MAX,2)));
    assert(core::option::is_none(core::u32::checked_align_up(1,0)));
    assert(core::option::is_none(core::u32::checked_align_down(1,0)));
    assert(core::u32::from_u8(7) == 7);
    assert(core::u32::from_u16(7) == 7);
    assert(core::u32::from_u32(7) == 7);
    let index: i32 = 0;
    while (index < 256) {
        let v: u8 = index as u8;
        let digit: bool = index >= 48 && index <= 57;
        let lower: bool = index >= 97 && index <= 122;
        let upper: bool = index >= 65 && index <= 90;
        let alphabetic: bool = lower || upper;
        let alnum: bool = alphabetic || digit;
        let graphic: bool = index >= 33 && index <= 126;
        let hex: bool = digit || (index >= 65 && index <= 70) || (index >= 97 && index <= 102);
        assert(core::u8::is_ascii(v) == (index < 128));
        assert(core::u8::is_ascii_digit(v) == digit);
        assert(core::u8::is_ascii_lowercase(v) == lower);
        assert(core::u8::is_ascii_uppercase(v) == upper);
        assert(core::u8::is_ascii_alphabetic(v) == alphabetic);
        assert(core::u8::is_ascii_alphanumeric(v) == alnum);
        assert(core::u8::is_ascii_word(v) == (alnum || index == 95));
        assert(core::u8::is_ascii_hexdigit(v) == hex);
        assert(core::u8::is_ascii_whitespace(v) == (index == 32 || index == 9 || index == 10 || index == 11 || index == 12 || index == 13));
        assert(core::u8::is_ascii_control(v) == (index < 32 || index == 127));
        assert(core::u8::is_ascii_graphic(v) == graphic);
        assert(core::u8::is_ascii_printable(v) == (index >= 32 && index <= 126));
        assert(core::u8::is_ascii_punctuation(v) == (graphic && !alnum));
        let expected_lower: u8 = v; if (upper) { expected_lower = (index+32) as u8; }
        let expected_upper: u8 = v; if (lower) { expected_upper = (index-32) as u8; }
        assert(core::u8::to_ascii_lowercase(v) == expected_lower);
        assert(core::u8::to_ascii_uppercase(v) == expected_upper);
        assert(core::u8::high_nibble(v) == (index/16) as u8);
        assert(core::u8::low_nibble(v) == (index%16) as u8);
        assert(core::u8::join_nibbles_or((index/16) as u8,(index%16) as u8,0) == v);
        let expected_hex: u8 = 255;
        if (digit) { expected_hex = (index-48) as u8; }
        if (index >= 65 && index <= 70) { expected_hex = (index-55) as u8; }
        if (index >= 97 && index <= 102) { expected_hex = (index-87) as u8; }
        assert(core::u8::ascii_hexdigit_value_or(v,255) == expected_hex);
        let lower_digit: u8 = 255; let upper_digit: u8 = 255;
        if (index < 10) { lower_digit = (index+48) as u8; upper_digit = lower_digit; }
        if (index >= 10 && index < 16) { lower_digit = (index+87) as u8; upper_digit = (index+55) as u8; }
        assert(core::u8::ascii_lower_hex_digit_or(v,255) == lower_digit);
        assert(core::u8::ascii_upper_hex_digit_or(v,255) == upper_digit);
        assert(core::u8::join_nibbles_or(v,16,255) == 255);
        assert(core::u8::join_nibbles_or(16,v,255) == 255);
        let other: i32 = 0;
        while (other < 256) {
            let expected: i32 = other;
            if (other >= 65 && other <= 90) { expected += 32; }
            assert(core::u8::eq_ignore_ascii_case(v,other as u8) == (expected_lower == expected as u8));
            other += 1;
        }
        index += 1;
    }
    return 0;
}
