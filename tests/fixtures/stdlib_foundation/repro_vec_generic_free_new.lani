module app::main;
import std::vec;

fn main() -> i32 {
    let value: std::vec::Vec<i32> = std::vec::new();
    if (std::vec::len(value) != 0 || !std::vec::is_empty(value)) { return 1; }
    let flags: std::vec::Vec<bool> = std::vec::new();
    if (std::vec::len(flags) != 0 || !std::vec::is_empty(flags)) { return 2; }
    return 0;
}
