module app::main;
import std::deque_u32;

fn main() -> i32 {
    let value: std::deque_u32::DequeU32 = std::deque_u32::try_with_capacity(2);
    if (std::deque_u32::capacity(value) != 2) { return 5; }
    value = std::deque_u32::try_push_back(value, 1);
    value = std::deque_u32::try_push_back(value, 2);
    value = std::deque_u32::try_pop_front(value);
    value = std::deque_u32::try_push_back(value, 3);
    value = std::deque_u32::try_push_front(value, 0);
    let failure: bool = std::deque_u32::capacity(value) == 2 &&
        std::deque_u32::len(value) == 2 &&
        std::deque_u32::at_or(value, 0, 9) == 2 &&
        std::deque_u32::at_or(value, 1, 9) == 3;
    let success: bool = std::deque_u32::capacity(value) == 4 &&
        std::deque_u32::len(value) == 3 &&
        std::deque_u32::at_or(value, 0, 9) == 0 &&
        std::deque_u32::at_or(value, 1, 9) == 2 &&
        std::deque_u32::at_or(value, 2, 9) == 3;
    std::deque_u32::destroy(value);
    if (failure) { return 0; }
    if (success) { return 4; }
    return 5;
}
