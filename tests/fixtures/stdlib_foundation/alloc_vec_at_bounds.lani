module app::main;
import alloc::vec;
import core::result;
import std::args_checked;
fn main() -> i32 {
    let values: alloc::vec::Vec<i32> = alloc::vec::new();
    let mode: i32 = std::args_checked::argument_count_or(0);
    if (mode == 1) { return values.at(0); }
    core::result::unwrap(values.try_push(7));
    if (mode == 2) { return values.at(-1); }
    return values.at(1);
}
