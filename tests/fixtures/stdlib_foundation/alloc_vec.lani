module app::main;
import alloc::vec;
import core::option;
import core::result;
import core::slice;

fn kind(error: alloc::vec::Error) -> i32 {
    let k: i32 = match (error) { alloc::vec::Error::Bounds -> 1, alloc::vec::Error::InvalidCapacity -> 2, alloc::vec::Error::CapacityOverflow -> 3, _ -> 4 }; return k;
}
fn append<T>(items: &alloc::vec::Vec<T>, item: T) -> core::result::Result<i32, alloc::vec::Error> {
    return items.try_push(item);
}
fn main() -> i32 {
    let values: alloc::vec::Vec<i32> = alloc::vec::new();
    if (!values.is_empty() || values.len() != 0 || values.capacity() != 0 || core::option::is_some(values.pop())) { return 1; }
    if (kind(core::result::unwrap_err(values.try_reserve(-1))) != 2 || kind(core::result::unwrap_err(values.try_reserve(2147483647))) != 3) { return 2; }
    let invalid: core::result::Result<alloc::vec::Vec<i32>, alloc::vec::Error> = alloc::vec::with_capacity(-1);
    if (kind(core::result::unwrap_err(invalid)) != 2) { return 16; }
    if (kind(core::result::unwrap_err(values.set(0, 9))) != 1 || kind(core::result::unwrap_err(values.remove(-1))) != 1 || kind(core::result::unwrap_err(values.swap_remove(0))) != 1) { return 3; }
    if (kind(core::result::unwrap_err(values.try_insert(1, 9))) != 1 || kind(core::result::unwrap_err(values.truncate(-1))) != 1 || kind(core::result::unwrap_err(values.try_resize(-1, 0))) != 1) { return 4; }
    core::result::unwrap(values.try_push(3)); core::result::unwrap(values.try_push(7));
    core::result::unwrap(values.try_insert(1, 5)); core::result::unwrap(values.try_insert(0, 1));
    if (core::result::unwrap(values.set(3, 9)) != 7 || core::result::unwrap(values.remove(1)) != 3 || core::result::unwrap(values.swap_remove(0)) != 1) { return 5; }
    if (values.len() != 2 || values.at(0) != 9 || values.at(1) != 5 || values.get_or(2, 17) != 17) { return 6; }
    core::result::unwrap(values.try_resize(7, 2));
    if (values.len() != 7 || values.at(6) != 2) { return 7; }
    core::result::unwrap(values.truncate(99)); core::result::unwrap(values.truncate(3));
    if (values.len() != 3 || core::option::unwrap(values.first()) != 9 || core::option::unwrap(values.last()) != 2) { return 8; }
    values.reverse(); if (values.at(0) != 2 || values.at(2) != 9) { return 9; }
    core::result::unwrap(values.try_shrink_to_fit());
    let alias: core::slice::View<i32> = values.as_view(); core::result::unwrap(values.try_extend(alias));
    let capacity: i32 = core::result::unwrap(values.try_reserve(20));
    let alias2: core::slice::View<i32> = values.as_view(); core::result::unwrap(values.try_extend(alias2));
    if (values.len() != 12 || values.capacity() != capacity) { return 10; }
    values.sort();
    if (!values.is_sorted() || values.lower_bound(5) != 4 || values.upper_bound(5) != 8 || values.binary_search(5) != 4 || values.binary_search(6) != -1 || !values.contains(9) || values.index_of(9) != 8) { return 11; }
    let cloned: core::result::Result<alloc::vec::Vec<i32>, alloc::vec::Error> = values.try_clone();
    let copy: alloc::vec::Vec<i32> = core::result::unwrap(cloned);
    core::result::unwrap(copy.set(0, 77));
    if (values.at(0) != 2 || copy.at(0) != 77 || core::result::unwrap(values.try_shrink_to_fit()) != 12) { return 12; }
    copy.destroy(); values.clear();
    if (!values.is_empty() || values.capacity() != 12 || core::result::unwrap(values.try_shrink_to_fit()) != 0) { return 13; }
    values.destroy(); values.destroy();
    core::result::unwrap(append(values.borrow(), 42)); if (core::option::unwrap(values.pop()) != 42) { return 14; } values.destroy();
    let data: [u8; 3] = [0, 128, 255];
    let view: core::slice::View<u8> = core::result::unwrap(core::slice::view(data, 3));
    let made: core::result::Result<alloc::vec::Vec<u8>, alloc::vec::Error> = alloc::vec::from_view(view);
    let bytes: alloc::vec::Vec<u8> = core::result::unwrap(made);
    if (bytes.len() != 3 || bytes.at(1) != 128) { return 15; } bytes.destroy();
    let inner: alloc::vec::Vec<i32> = alloc::vec::new(); core::result::unwrap(inner.try_push(7));
    let outer: alloc::vec::Vec<alloc::vec::Vec<i32>> = alloc::vec::new();
    core::result::unwrap(outer.try_push(inner));
    let removed: alloc::vec::Vec<i32> = core::option::unwrap(outer.pop());
    core::result::unwrap(removed.try_push(9));
    if (removed.len() != 2 || removed.at(0) != 7 || removed.at(1) != 9 || !outer.is_empty()) { return 17; }
    removed.destroy(); outer.destroy();
    return 0;
}
