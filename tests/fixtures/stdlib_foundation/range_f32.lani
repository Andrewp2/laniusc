module app::main;
import core::f32;
import core::range_f32;

fn main() -> i32 {
    let zero: f32 = 0.0;
    let nan: f32 = zero / zero;
    let positive_infinity: f32 = 1.0 / zero;
    let negative_infinity: f32 = -1.0 / zero;

    if (core::range_f32::half_open_is_empty(-1.0, 2.0) ||
        !core::range_f32::half_open_is_empty(2.0, 2.0) ||
        !core::range_f32::half_open_is_empty(2.0, -1.0) ||
        !core::range_f32::half_open_is_empty(nan, 2.0) ||
        !core::range_f32::half_open_is_empty(-1.0, nan) ||
        core::range_f32::half_open_is_empty(negative_infinity, positive_infinity) ||
        !core::range_f32::half_open_is_empty(-0.0, 0.0)) { return 1; }
    if (!core::range_f32::half_open_contains(-1.0, 2.0, -1.0) ||
        !core::range_f32::half_open_contains(-1.0, 2.0, 1.5) ||
        core::range_f32::half_open_contains(-1.0, 2.0, 2.0) ||
        core::range_f32::half_open_contains(-1.0, 2.0, nan) ||
        core::range_f32::half_open_contains(nan, 2.0, 1.0) ||
        core::range_f32::half_open_contains(2.0, -1.0, 1.0) ||
        !core::range_f32::half_open_contains(negative_infinity, positive_infinity, 1.0) ||
        core::range_f32::half_open_contains(negative_infinity, positive_infinity, positive_infinity)) {
        return 2;
    }
    if (!core::range_f32::half_open_overlaps(-1.0, 2.0, 1.5, 4.0) ||
        core::range_f32::half_open_overlaps(-1.0, 2.0, 2.0, 4.0) ||
        core::range_f32::half_open_overlaps(-1.0, 2.0, 1.0, 1.0) ||
        core::range_f32::half_open_overlaps(nan, 2.0, 1.0, 4.0) ||
        core::range_f32::half_open_overlaps(-1.0, 2.0, 1.0, nan)) { return 3; }

    if (core::range_f32::inclusive_is_empty(-1.0, 2.0) ||
        core::range_f32::inclusive_is_empty(2.0, 2.0) ||
        !core::range_f32::inclusive_is_empty(2.0, -1.0) ||
        !core::range_f32::inclusive_is_empty(nan, 2.0) ||
        !core::range_f32::inclusive_is_empty(0.0, nan) ||
        core::range_f32::inclusive_is_empty(positive_infinity, positive_infinity) ||
        core::range_f32::inclusive_is_empty(-0.0, 0.0)) { return 4; }
    if (!core::range_f32::inclusive_contains(-1.0, 2.0, 2.0) ||
        !core::range_f32::inclusive_contains(-0.0, 0.0, -0.0) ||
        !core::range_f32::inclusive_contains(-0.0, 0.0, 0.0) ||
        !core::range_f32::inclusive_contains(positive_infinity, positive_infinity, positive_infinity) ||
        core::range_f32::inclusive_contains(2.0, -1.0, 1.0) ||
        core::range_f32::inclusive_contains(-1.0, 2.0, nan) ||
        core::range_f32::inclusive_contains(nan, 2.0, 1.0)) { return 5; }
    if (!core::range_f32::inclusive_overlaps(-1.0, 2.0, 2.0, 4.0) ||
        core::range_f32::inclusive_overlaps(-1.0, 1.0, 2.0, 4.0) ||
        core::range_f32::inclusive_overlaps(nan, 2.0, 1.0, 4.0) ||
        core::range_f32::inclusive_overlaps(-1.0, 2.0, 1.0, nan)) { return 6; }
    if (!core::range_f32::from_contains(1.0, 1.0) ||
        !core::range_f32::from_contains(1.0, positive_infinity) ||
        core::range_f32::from_contains(1.0, nan) ||
        core::range_f32::from_contains(nan, 1.0) ||
        !core::range_f32::to_contains(1.0, negative_infinity) ||
        core::range_f32::to_contains(1.0, 1.0) ||
        core::range_f32::to_contains(nan, 0.0) ||
        core::range_f32::to_contains(1.0, nan) ||
        !core::range_f32::full_contains(nan) ||
        !core::range_f32::full_contains(positive_infinity) ||
        !core::range_f32::full_contains(0.0)) { return 7; }

    let half: core::range_f32::RangeF32 = core::range_f32::range(-1.0, 2.0);
    let overlap: core::range_f32::RangeF32 = core::range_f32::range(1.5, 4.0);
    let touch: core::range_f32::RangeF32 = core::range_f32::range(2.0, 4.0);
    let invalid: core::range_f32::RangeF32 = core::range_f32::range(nan, 2.0);
    if (core::range_f32::start(half) != -1.0 ||
        core::range_f32::end(half) != 2.0 ||
        core::range_f32::is_empty(half) ||
        !core::range_f32::is_empty(invalid) ||
        !core::range_f32::contains(half, 1.5) ||
        core::range_f32::contains(half, 2.0) ||
        core::range_f32::contains(half, nan) ||
        !core::range_f32::overlaps(half, overlap) ||
        core::range_f32::overlaps(half, touch) ||
        core::range_f32::overlaps(half, invalid)) { return 8; }

    let closed: core::range_f32::RangeInclusiveF32 =
        core::range_f32::range_inclusive(-1.0, 2.0);
    let closed_touch: core::range_f32::RangeInclusiveF32 =
        core::range_f32::range_inclusive(2.0, 4.0);
    let closed_invalid: core::range_f32::RangeInclusiveF32 =
        core::range_f32::range_inclusive(2.0, nan);
    if (core::range_f32::start_inclusive(closed) != -1.0 ||
        core::range_f32::end_inclusive(closed) != 2.0 ||
        core::range_f32::is_empty_inclusive(closed) ||
        !core::range_f32::is_empty_inclusive(closed_invalid) ||
        !core::range_f32::contains_inclusive(closed, 2.0) ||
        core::range_f32::contains_inclusive(closed, nan) ||
        !core::range_f32::overlaps_inclusive(closed, closed_touch) ||
        core::range_f32::overlaps_inclusive(closed, closed_invalid)) { return 9; }

    let from: core::range_f32::RangeFromF32 = core::range_f32::range_from(-1.0);
    if (core::range_f32::start_from(from) != -1.0 ||
        !core::range_f32::contains_from(from, 0.0) ||
        core::range_f32::contains_from(from, -2.0) ||
        core::range_f32::contains_from(from, nan)) { return 10; }
    let to: core::range_f32::RangeToF32 = core::range_f32::range_to(2.0);
    if (core::range_f32::end_to(to) != 2.0 ||
        !core::range_f32::contains_to(to, 1.0) ||
        core::range_f32::contains_to(to, 2.0) ||
        core::range_f32::contains_to(to, nan)) { return 11; }
    if (!core::f32::is_nan(core::range_f32::start(invalid)) ||
        !core::f32::is_nan(core::range_f32::end_inclusive(closed_invalid))) { return 12; }
    return 0;
}
