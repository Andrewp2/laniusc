// Ordinary counterpart of the remaining generic-body array failure.
// Inline record arrays use native words; standalone i32 arrays are packed.
struct Container { values: [i32; 2] }
fn keep(values: [i32; 2]) -> [i32; 2] { return values; }
fn main() -> i32 {
    let container: Container = Container { values: [11, 22] };
    let copied: [i32; 2] = keep(container.values);
    if (copied[0] != 11) { return 1; }
    if (copied[1] != 22) { return 2; }
    copied[0] = 99;
    if (container.values[0] != 11) { return 3; }
    return 0;
}
