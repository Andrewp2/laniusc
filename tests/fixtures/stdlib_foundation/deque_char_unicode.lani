module app::main;
import std::deque_char;

fn main() -> i32 {
    let fallback: char = '?';
    let queue: std::deque_char::DequeChar = std::deque_char::try_with_capacity(3);
    if (std::deque_char::capacity(queue) != 3) { return 1; }
    queue = std::deque_char::try_push_back(queue, 'Ω');
    queue = std::deque_char::try_push_back(queue, '😀');
    queue = std::deque_char::try_push_back(queue, '中');
    queue = std::deque_char::try_pop_front(queue);
    queue = std::deque_char::try_push_back(queue, '\0');
    if (std::deque_char::len(queue) != 3 ||
        std::deque_char::front_or(queue, fallback) != '😀' ||
        std::deque_char::at_or(queue, 1, fallback) != '中' ||
        std::deque_char::back_or(queue, fallback) != '\0') { return 2; }
    queue = std::deque_char::try_push_front(queue, 'é');
    if (std::deque_char::capacity(queue) != 6 ||
        std::deque_char::len(queue) != 4 ||
        std::deque_char::at_or(queue, 0, fallback) != 'é' ||
        std::deque_char::at_or(queue, 1, fallback) != '😀' ||
        std::deque_char::at_or(queue, 3, fallback) != '\0') { return 3; }
    let copy: std::deque_char::DequeChar = std::deque_char::try_clone(queue);
    if (std::deque_char::len(copy) != 4 ||
        std::deque_char::at_or(copy, 2, fallback) != '中') { return 4; }
    if (!std::deque_char::try_set(copy, 2, 'A') ||
        !std::deque_char::try_swap(copy, 0, 3) ||
        std::deque_char::front_or(copy, fallback) != '\0' ||
        std::deque_char::at_or(copy, 2, fallback) != 'A' ||
        std::deque_char::at_or(queue, 2, fallback) != '中') { return 5; }
    std::deque_char::destroy(copy);
    queue = std::deque_char::try_pop_back(queue);
    queue = std::deque_char::try_shrink_to_fit(queue);
    if (std::deque_char::len(queue) != 3 ||
        std::deque_char::capacity(queue) != 3 ||
        std::deque_char::at_or(queue, 0, fallback) != 'é' ||
        std::deque_char::at_or(queue, 1, fallback) != '😀' ||
        std::deque_char::at_or(queue, 2, fallback) != '中') { return 6; }
    std::deque_char::destroy(queue);
    return 0;
}
