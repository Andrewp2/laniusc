    if (operation == 111) { return value(core::u32::wrapping_from_usize(raw_a as usize) as u64); }
    if (operation == 112) { return value(core::u32::gcd(a,b) as u64); }
    if (operation == 113) { return answer_u32(core::u32::checked_lcm(a,b)); }
    if (operation == 114) { return answer_u32(core::u32::checked_align_up(a,b)); }
    if (operation == 115) { return answer_u32(core::u32::checked_align_down(a,b)); }
    if (operation == 116) { if (core::u32::is_aligned(a,b)) { return value(1); } return value(0); }
    if (operation == 118) { return answer_u32(core::u32::checked_clamp(a,b,amount as u32)); }
    if (operation == 119) { return value(core::u32::clamp_or(a,b,amount as u32,3) as u64); }
    assert(false); return value(0);
}
fn decode(bytes: [u8], offset: i32, count: i32) -> u64 {
    let result: u64 = 0; let at: i32 = 0;
    while (at < count) { result |= (bytes[offset+at] as u64) << (at*8); at += 1; }
    return result;
}
fn main() -> i32 {
    let header: [i32;1] = [0]; let hp: ptr = core::mem::i32_array_data_ptr(header);
    if (!std::io_checked::read_exact_stdin(hp,4)) { return 1; }
    let count: i32 = header[0]; if (count < 0 || count > 1000000) { return 2; }
    let record: [i32;6] = [0;6]; let pointer: ptr = core::mem::i32_array_data_ptr(record);
    let bytes: [u8] = core::mem::typed_slice_from_raw_parts(pointer,24);
    let output: [i32;3] = [0;3]; let out: ptr = core::mem::i32_array_data_ptr(output);
    let at: i32 = 0;
    while (at < count) {
        if (!std::io_checked::read_exact_stdin(pointer,24)) { return 3; }
        let kind: i32 = bytes[0] as i32; let operation: i32 = bytes[1] as i32;
        let a: u64 = decode(bytes,4,8); let b: u64 = decode(bytes,12,8); let amount: u32 = decode(bytes,20,4) as u32;
        let answer: Answer = value(0);
        if (kind == 0) { answer = evaluate_i8(operation,a,b,amount); }
        if (kind == 1) { answer = evaluate_u8(operation,a,b,amount); }
        if (kind == 2) { answer = evaluate_i16(operation,a,b,amount); }
        if (kind == 3) { answer = evaluate_u16(operation,a,b,amount); }
        if (kind == 4) { answer = evaluate_i32(operation,a,b,amount); }
        if (kind == 5) { answer = evaluate_u32(operation,a,b,amount); }
        output[0] = 0; if (answer.valid) { output[0] = 1; }
        output[1] = answer.value as i32; output[2] = (answer.value >> 32) as i32;
        if (!std::io_checked::write_all_stdout(out,12)) { return 4; }
        at += 1;
    }
    return 0;
}
