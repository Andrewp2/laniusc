module app::main;
import std::set_wide_u64;
import core::wide_u64;
fn same(left: core::wide_u64::WideU64, right: core::wide_u64::WideU64) -> bool {
    return core::wide_u64::eq(left, right);
}

fn main() -> i32 {
    let large: core::wide_u64::WideU64 = core::wide_u64::from_words(1, 4294967289);
    let small: core::wide_u64::WideU64 = core::wide_u64::from_u32(42);
    let forty_one: core::wide_u64::WideU64 = core::wide_u64::from_u32(41);
    let zero_value: core::wide_u64::WideU64 = core::wide_u64::zero();
    let value: std::set_wide_u64::SetWideU64 = std::set_wide_u64::try_reserve(std::set_wide_u64::new(), 1);
    if (std::set_wide_u64::capacity(value) != 1) { return 2; }
    value = std::set_wide_u64::try_insert(value, large);
    if (std::set_wide_u64::len(value) != 1) { return 3; }
    value = std::set_wide_u64::try_insert(value, small);
    if (std::set_wide_u64::len(value) == 1 &&
        std::set_wide_u64::capacity(value) == 1 &&
        same(std::set_wide_u64::at_or(value, 0, zero_value), large) &&
        !std::set_wide_u64::contains(value, small)) {
        std::set_wide_u64::destroy(value);
        return 0;
    }
    if (std::set_wide_u64::len(value) == 2 &&
        std::set_wide_u64::capacity(value) == 2 &&
        same(std::set_wide_u64::at_or(value, 0, zero_value), large) &&
        same(std::set_wide_u64::at_or(value, 1, zero_value), small)) {
        std::set_wide_u64::destroy(value);
        return 4;
    }
    std::set_wide_u64::destroy(value);
    return 5;
}
