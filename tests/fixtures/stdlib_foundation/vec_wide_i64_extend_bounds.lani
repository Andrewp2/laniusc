module app::main;
import std::vec_wide_i64;
fn main() -> i32 {
    let words:[i32; 3] =[0, 1, 2];
    let value: std::vec_wide_i64::VecWideI64 = std::vec_wide_i64::new();
    value = std::vec_wide_i64::try_extend_from_word_pairs(value, words, 2);
    std::vec_wide_i64::destroy(value);
    return 0;
}
