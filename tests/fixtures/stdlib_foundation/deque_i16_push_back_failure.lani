module app::main;
import std::deque_i16;

fn main() -> i32 {
    let value: std::deque_i16::DequeI16 = std::deque_i16::try_with_capacity(2);
    if (std::deque_i16::capacity(value) != 2) { return 5; }
    value = std::deque_i16::try_push_back(value, 1);
    value = std::deque_i16::try_push_back(value, -2);
    value = std::deque_i16::try_push_back(value, 3);
    let failure: bool = std::deque_i16::capacity(value) == 2 &&
        std::deque_i16::len(value) == 2 &&
        std::deque_i16::at_or(value, 0, 0) == 1 &&
        std::deque_i16::at_or(value, 1, 0) == -2;
    let success: bool = std::deque_i16::capacity(value) == 4 &&
        std::deque_i16::len(value) == 3 &&
        std::deque_i16::at_or(value, 0, 0) == 1 &&
        std::deque_i16::at_or(value, 1, 0) == -2 &&
        std::deque_i16::at_or(value, 2, 0) == 3;
    std::deque_i16::destroy(value);
    if (failure) { return 0; }
    if (success) { return 4; }
    return 5;
}
