module app::main;
import std::vec_i16;

fn main() -> i32 {
    let first: i16 = -32768;
    let second: i16 = 1;
    let third: i16 = 32767;
    let fallback: i16 = 0;
    let additions: [i16; 2] = [second, third];
    let value: std::vec_i16::VecI16 = std::vec_i16::try_with_capacity(1);
    if (std::vec_i16::capacity(value) != 1) { return 2; }
    value = std::vec_i16::try_push(value, first);
    if (std::vec_i16::len(value) != 1) { return 3; }
    value = std::vec_i16::try_extend_from_slice(value, additions, 2);
    if (std::vec_i16::len(value) == 3) {
        if (std::vec_i16::get_or(value, 0, fallback) != first ||
            std::vec_i16::get_or(value, 1, fallback) != second ||
            std::vec_i16::get_or(value, 2, fallback) != third) { return 6; }
        std::vec_i16::destroy(value);
        return 4;
    }
    if (std::vec_i16::len(value) != 1 ||
        std::vec_i16::capacity(value) != 1 ||
        std::vec_i16::get_or(value, 0, fallback) != first) { return 5; }
    std::vec_i16::destroy(value);
    return 0;
}
