module app::main;
import std::vec_char;

fn main() -> i32 {
    // A char holds a Unicode scalar, so U+F0000 and U+10FFFF (the largest
    // scalar) stand in for high code points.
    let high_bit: char = '󰀀';
    let maximum: char = '􏿿';
    let first: char = high_bit;
    let last: char = maximum;
    let fallback: char = '\0';
    let value: std::vec_char::VecChar = std::vec_char::try_with_capacity(4);
    if (std::vec_char::capacity(value) != 4) { return 2; }
    value = std::vec_char::try_push(value, first);
    value = std::vec_char::try_push(value, last);
    if (std::vec_char::len(value) != 2) { return 3; }
    let copy: std::vec_char::VecChar = std::vec_char::try_clone(value);
    if (std::vec_char::len(copy) == 2) {
        std::vec_char::destroy(copy);
        std::vec_char::destroy(value);
        return 4;
    }
    if (std::vec_char::len(copy) != 0 ||
        std::vec_char::capacity(copy) != 0 ||
        std::vec_char::len(value) != 2 ||
        std::vec_char::capacity(value) != 4 ||
        std::vec_char::get_or(value, 0, fallback) != first ||
        std::vec_char::get_or(value, 1, fallback) != last) { return 5; }
    std::vec_char::destroy(copy);
    std::vec_char::destroy(value);
    return 0;
}
