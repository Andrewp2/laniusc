module app::main;
import core::slice_u16;

fn main() -> i32 {
    let zero: u16 = 0;
    let three: u16 = 3;
    let nine: u16 = 9;
    let high: u16 = 65535;
    let fallback: u16 = 17;
    let values: [u16; 5] = [three, high, zero, three, nine];
    let same: [u16; 5] = [three, high, zero, three, nine];
    let different: [u16; 5] = [three, high, nine, three, nine];
    let prefix: [u16; 2] = [three, high];
    let suffix: [u16; 2] = [three, nine];

    if (core::slice_u16::get_or(values, 5, 0, fallback) != three ||
        core::slice_u16::get_or(values, 5, 1, fallback) != high ||
        core::slice_u16::get_or(values, 5, 4, fallback) != nine ||
        core::slice_u16::get_or(values, 5, -1, fallback) != fallback ||
        core::slice_u16::get_or(values, 5, 5, fallback) != fallback ||
        core::slice_u16::get_or(values, 0, 0, fallback) != fallback ||
        core::slice_u16::get_or(values, -1, 0, fallback) != fallback) {
        return 1;
    }
    if (core::slice_u16::index_of_or(values, 5, three, -9) != 0 ||
        core::slice_u16::last_index_of_or(values, 5, three, -9) != 3 ||
        core::slice_u16::index_of_or(values, 5, high, -9) != 1 ||
        core::slice_u16::last_index_of_or(values, 5, high, -9) != 1 ||
        core::slice_u16::index_of_or(values, 5, fallback, -9) != -9 ||
        core::slice_u16::last_index_of_or(values, 5, fallback, -9) != -9 ||
        core::slice_u16::index_of_or(values, 0, three, -9) != -9 ||
        core::slice_u16::last_index_of_or(values, -1, three, -9) != -9) {
        return 2;
    }
    if (!core::slice_u16::equals(values, 5, same, 5) ||
        core::slice_u16::equals(values, 5, different, 5) ||
        core::slice_u16::equals(values, 5, prefix, 2) ||
        !core::slice_u16::equals(values, 0, prefix, 0) ||
        core::slice_u16::equals(values, -1, same, -1) ||
        !core::slice_u16::starts_with(values, 5, prefix, 2) ||
        core::slice_u16::starts_with(values, 5, suffix, 2) ||
        !core::slice_u16::starts_with(values, 5, prefix, 0) ||
        core::slice_u16::starts_with(values, 5, prefix, -1) ||
        !core::slice_u16::ends_with(values, 5, suffix, 2) ||
        core::slice_u16::ends_with(values, 5, prefix, 2) ||
        !core::slice_u16::ends_with(values, 5, suffix, 0) ||
        core::slice_u16::ends_with(values, -1, suffix, 0)) {
        return 3;
    }

    if (core::slice_u16::set(values, 5, -1, high) ||
        core::slice_u16::set(values, 5, 5, high) ||
        core::slice_u16::set(values, -1, 0, high) ||
        values[0] != three || values[4] != nine ||
        !core::slice_u16::set(values, 5, 2, high) || values[2] != high) {
        return 4;
    }
    let filled: [u16; 4] = [three, high, nine, zero];
    if (core::slice_u16::fill(filled, -1, high) != 0 || filled[0] != three ||
        core::slice_u16::fill(filled, 0, high) != 0 || filled[1] != high ||
        core::slice_u16::fill(filled, 3, nine) != 3 ||
        filled[0] != nine || filled[1] != nine || filled[2] != nine || filled[3] != zero) {
        return 5;
    }

    let copied: [u16; 5] = [three, high, zero, nine, high];
    if (core::slice_u16::copy_within(copied, 5, -1, 2, 0) ||
        core::slice_u16::copy_within(copied, 5, 3, 2, 0) ||
        core::slice_u16::copy_within(copied, 5, 0, 3, 3) ||
        core::slice_u16::copy_within(copied, -1, 0, 0, 0) ||
        copied[0] != three || copied[4] != high ||
        !core::slice_u16::copy_within(copied, 5, 0, 3, 2) ||
        copied[0] != three || copied[1] != high || copied[2] != three ||
        copied[3] != high || copied[4] != zero ||
        !core::slice_u16::copy_within(copied, 5, 2, 5, 0) ||
        copied[0] != three || copied[1] != high || copied[2] != zero ||
        !core::slice_u16::copy_within(copied, 5, 0, 0, 5)) {
        return 6;
    }
    if (core::slice_u16::reverse_in_place(copied, -1) != 0 ||
        core::slice_u16::reverse_in_place(copied, 0) != 0 ||
        core::slice_u16::reverse_in_place(copied, 1) != 0 ||
        core::slice_u16::reverse_in_place(copied, 5) != 2 ||
        copied[0] != zero || copied[1] != high || copied[2] != zero ||
        copied[3] != high || copied[4] != three) {
        return 7;
    }
    let below_sign_bit: u16 = 32767;
    let above_sign_bit: u16 = 32768;
    let boundary: [u16; 3] = [below_sign_bit, above_sign_bit, high];
    if (core::slice_u16::get_or(boundary, 3, 1, fallback) != above_sign_bit ||
        core::slice_u16::index_of_or(boundary, 3, above_sign_bit, -9) != 1 ||
        core::slice_u16::last_index_of_or(boundary, 3, high, -9) != 2 ||
        !core::slice_u16::set(boundary, 3, 0, high) ||
        boundary[0] != high || boundary[1] != above_sign_bit) {
        return 8;
    }
    return 0;
}
