module app::main;
import std::vec_i16;

fn main() -> i32 {
    let value: std::vec_i16::VecI16 = std::vec_i16::try_with_capacity(1);
    if (std::vec_i16::capacity(value) != 1) { return 2; }
    value = std::vec_i16::try_push(value, -32768);
    if (std::vec_i16::len(value) != 1) { return 3; }
    value = std::vec_i16::try_push(value, 32767);
    if (std::vec_i16::len(value) != 1 || std::vec_i16::capacity(value) != 1) { return 4; }
    if (std::vec_i16::get_or(value, 0, 0) != -32768) { return 5; }
    std::vec_i16::destroy(value);
    return 0;
}
