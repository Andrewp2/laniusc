module app::main;
import core::cmp;
import core::ordering;
import core::range_char;
import core::slice_char;

fn literal_before_char(value: char) -> bool { return '😀' < value; }
fn literal_before_u32(value: u32) -> bool { return 1 < value; }

fn main() -> i32 {
    let sign_bits: u32 = 2147483648;
    let max_bits: u32 = 4294967295;
    // Plane-15 and plane-16 private-use scalars, above every BMP and emoji
    // code point. A char holds only Unicode scalar values, so the u32 sign
    // bit is exercised by the u32 comparisons below.
    let high: char = '󰀀';
    let last: char = '􏿽';

    // A literal on the left must compare in unsigned code-point order.
    if (!('😀' < high) || !('😀' <= high) || '😀' > high || '😀' >= high ||
        !(high > '😀') || !(high >= '😀') || high < '😀' || high <= '😀' ||
        !('😀' < last) || !('😀' <= last) || last <= '😀' ||
        !('😀' == '😀') || '😀' != '😀') { return 1; }
    let character_result: bool = literal_before_char(high);
    if (!character_result || literal_before_char('a')) { return 10; }
    if (!core::ordering::is_greater(core::ordering::compare_char(high, '😀')) ||
        !core::ordering::is_greater(core::ordering::compare_char(last, high))) { return 2; }
    if (!core::cmp::lt_char('😀', high) || !core::cmp::gt_char(last, high) ||
        !core::cmp::le_char(high, last) || !core::cmp::ge_char(last, high)) { return 3; }
    if (!core::range_char::half_open_contains('😀', last, high) ||
        core::range_char::half_open_contains(high, last, '😀') ||
        core::range_char::half_open_is_empty('😀', high) ||
        !core::range_char::half_open_is_empty(last, high)) { return 4; }
    let values: [char; 4] = [last, '😀', high, '\0'];
    if (core::slice_char::min_or(values, 4, '?') != '\0' ||
        core::slice_char::max_or(values, 4, '?') != last) { return 5; }
    if (!core::slice_char::sort(values, 4) ||
        !core::slice_char::is_sorted(values, 4) ||
        values[0] != '\0' || values[1] != '😀' ||
        values[2] != high || values[3] != last) { return 6; }
    if (core::slice_char::lower_bound_or(values, 4, high, -1) != 2 ||
        core::slice_char::upper_bound_or(values, 4, high, -1) != 3) { return 7; }
    if (!(1 < sign_bits) || !(1 <= sign_bits) ||
        1 > sign_bits || 1 >= sign_bits ||
        !(1 < max_bits) || max_bits <= 1) { return 8; }
    let integer_result: bool = literal_before_u32(sign_bits);
    if (!integer_result || literal_before_u32(0)) { return 11; }
    if (!core::cmp::lt_u32(1, sign_bits) ||
        !core::cmp::gt_u32(max_bits, sign_bits)) { return 9; }
    return 0;
}
