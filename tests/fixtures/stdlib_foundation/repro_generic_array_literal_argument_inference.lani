fn choose_element<T>(values: [T; 2], fallback: T, first: bool) -> T {
    if (first) { return values[0]; }
    return fallback;
}

fn main() -> i32 {
    let unsigned: u32 = 4294967295;
    let value = choose_element([2147483648, 1], unsigned, true);
    if (value / 2 != 1073741824) { return 1; }
    return 0;
}
