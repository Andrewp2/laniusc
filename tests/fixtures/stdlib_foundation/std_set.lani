// expect: 0
// Every std::set function through one generic checker over four distinct
// values: duplicates, order-preserving removal, reserve, shrink, clone, and
// the set algebra in left-then-right order. It runs for every integer width,
// char, total float keys, both wide integers and a record. Exits 0. On a failure it
// prints 100 * row + the failing check and exits with the row.
module app::main;

import core::cmp;
import core::float_order;
import core::wide_i64;
import core::wide_u64;
import std::set;

struct Point { x: i32, y: i32, z: i32 }

pub impl core::cmp::Eq<Point> for Point {
    pub fn eq(left: Point, right: Point) -> bool {
        return left.x == right.x && left.y == right.y && left.z == right.z;
    }
    pub fn ne(left: Point, right: Point) -> bool {
        return !Point::eq(left, right);
    }
}

fn of<T>(a: T, b: T) -> std::set::Set<T> where T: core::cmp::Eq<T> {
    let items: std::set::Set<T> = std::set::new();
    items = std::set::try_insert(items, a);
    return std::set::try_insert(items, b);
}

// The set holds exactly the given items in order.
fn holds<T>(items: std::set::Set<T>, count: i32, a: T, b: T, c: T, fallback: T) -> bool
    where T: core::cmp::Eq<T> {
    if (std::set::len(items) != count) {
        return false;
    }
    if (count > 0 && !T::eq(std::set::at_or(items, 0, fallback), a)) { return false; }
    if (count > 1 && !T::eq(std::set::at_or(items, 1, fallback), b)) { return false; }
    if (count > 2 && !T::eq(std::set::at_or(items, 2, fallback), c)) { return false; }
    return true;
}

// a, b, c, d are distinct.
fn set_checks<T>(a: T, b: T, c: T, d: T) -> i32 where T: core::cmp::Eq<T> {
    let empty: std::set::Set<T> = std::set::new();
    if (!std::set::is_empty(empty) || std::set::len(empty) != 0 || std::set::capacity(empty) != 0 ||
        std::set::contains(empty, a) || !T::eq(std::set::at_or(empty, 0, d), d)) {
        return 1;
    }
    empty = std::set::try_reserve(empty, -1);
    empty = std::set::try_remove(empty, a);
    if (std::set::capacity(empty) != 0) { return 2; }

    let items: std::set::Set<T> = std::set::try_reserve(empty, 2);
    if (std::set::capacity(items) != 2) { return 3; }
    items = std::set::try_insert(items, c);
    items = std::set::try_insert(items, a);
    items = std::set::try_insert(items, c);
    items = std::set::try_insert(items, b);
    if (!holds(items, 3, c, a, b, d) || std::set::capacity(items) != 4 ||
        !std::set::contains(items, b) || std::set::contains(items, d) ||
        !T::eq(std::set::at_or(items, 3, d), d) || !T::eq(std::set::at_or(items, -1, d), d)) {
        return 4;
    }
    items = std::set::try_remove(items, d);
    items = std::set::try_remove(items, c);
    if (!holds(items, 2, a, b, b, d)) { return 5; }
    items = std::set::try_shrink_to_fit(items);
    if (std::set::capacity(items) != 2 || !holds(items, 2, a, b, b, d)) { return 6; }

    let copy: std::set::Set<T> = std::set::try_clone(items);
    copy = std::set::try_insert(copy, d);
    if (!holds(copy, 3, a, b, d, c) || !holds(items, 2, a, b, b, d)) { return 7; }

    // items = {a, b}, copy = {a, b, d}, other = {d, c}.
    let other: std::set::Set<T> = of(d, c);
    if (!std::set::is_subset(items, copy) || std::set::is_subset(copy, items) ||
        !std::set::is_subset(empty, items)) {
        return 8;
    }
    if (!std::set::is_disjoint(items, other) || std::set::is_disjoint(copy, other) ||
        !std::set::is_disjoint(empty, empty)) {
        return 9;
    }
    let joined: std::set::Set<T> = std::set::try_union(items, other);
    if (!holds(joined, 4, a, b, d, c) || !T::eq(std::set::at_or(joined, 3, a), c)) { return 10; }
    let both: std::set::Set<T> = std::set::try_intersection(copy, other);
    if (!holds(both, 1, d, d, d, a)) { return 11; }
    let only: std::set::Set<T> = std::set::try_difference(copy, other);
    if (!holds(only, 2, a, b, b, d)) { return 12; }
    let either: std::set::Set<T> = std::set::try_symmetric_difference(copy, other);
    if (!holds(either, 3, a, b, c, d)) { return 13; }
    let none: std::set::Set<T> = std::set::try_intersection(items, other);
    if (!std::set::is_empty(none) || std::set::capacity(none) != 0) { return 14; }

    items = std::set::clear(items);
    if (!std::set::is_empty(items) || std::set::capacity(items) != 2) { return 15; }
    items = std::set::try_shrink_to_fit(items);
    if (std::set::capacity(items) != 0) { return 16; }
    std::set::destroy(items);
    std::set::destroy(copy);
    std::set::destroy(other);
    std::set::destroy(joined);
    std::set::destroy(both);
    std::set::destroy(only);
    std::set::destroy(either);
    std::set::destroy(none);
    return 0;
}

fn row(index: i32, code: i32) -> i32 {
    if (code == 0) { return 0; }
    print(index * 100 + code);
    return index;
}

fn main() -> i32 {
    let i8_a: i8 = -128;
    let i8_b: i8 = -1;
    let i8_c: i8 = 1;
    let i8_d: i8 = 127;
    let i16_a: i16 = -32768;
    let i16_b: i16 = -1;
    let i16_c: i16 = 1;
    let i16_d: i16 = 32767;
    let i64_a: i64 = -9223372036854775808;
    let i64_b: i64 = 0;
    let i64_c: i64 = 4294967296;
    let i64_d: i64 = 9223372036854775807;
    let u8_a: u8 = 0;
    let u8_b: u8 = 1;
    let u8_c: u8 = 128;
    let u8_d: u8 = 255;
    let u16_a: u16 = 0;
    let u16_b: u16 = 255;
    let u16_c: u16 = 32768;
    let u16_d: u16 = 65535;
    let u32_a: u32 = 0;
    let u32_b: u32 = 7;
    let u32_c: u32 = 2147483648;
    let u32_d: u32 = 4294967295;
    let u64_a: u64 = 0;
    let u64_b: u64 = 4294967295;
    let u64_c: u64 = 4294967296;
    let u64_d: u64 = 18446744073709551615;
    let checks: [i32; 13] = [
        row(1, set_checks(-2147483648, -1, 0, 2147483647)),
        row(2, set_checks(i8_a, i8_b, i8_c, i8_d)),
        row(3, set_checks(i16_a, i16_b, i16_c, i16_d)),
        row(4, set_checks(i64_a, i64_b, i64_c, i64_d)),
        row(5, set_checks(u8_a, u8_b, u8_c, u8_d)),
        row(6, set_checks(u16_a, u16_b, u16_c, u16_d)),
        row(7, set_checks(u32_a, u32_b, u32_c, u32_d)),
        row(8, set_checks(u64_a, u64_b, u64_c, u64_d)),
        row(9, set_checks('\0', 'A', 'é', '😀')),
        row(10, set_checks(core::float_order::from_f32(-2.5), core::float_order::from_f32(-0.5), core::float_order::from_f32(1.0), core::float_order::from_f32(3.5))),
        row(11, set_checks(core::wide_i64::min_value(), core::wide_i64::from_i32(-1),
            core::wide_i64::from_words(1, 0), core::wide_i64::max_value())),
        row(12, set_checks(core::wide_u64::zero(), core::wide_u64::from_u32(7),
            core::wide_u64::from_words(1, 0), core::wide_u64::max_value())),
        row(13, set_checks(Point { x: 1, y: 2, z: 3 }, Point { x: -1, y: 0, z: 0 },
            Point { x: 0, y: 0, z: 7 }, Point { x: 9, y: 9, z: 9 })),
    ];
    let index: i32 = 0;
    while (index < 13) {
        if (checks[index] != 0) { return checks[index]; }
        index += 1;
    }
    return 0;
}
