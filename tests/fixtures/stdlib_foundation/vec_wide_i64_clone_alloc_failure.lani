module app::main;
import core::wide_i64;
import std::vec_wide_i64;
fn main() -> i32 {
    let minimum: core::wide_i64::WideI64 = core::wide_i64::min_value();
    let value: std::vec_wide_i64::VecWideI64 = std::vec_wide_i64::new();
    value = std::vec_wide_i64::try_push(value, minimum);
    let copy: std::vec_wide_i64::VecWideI64 = std::vec_wide_i64::try_clone(value);
    if (std::vec_wide_i64::len(copy) == 0 && std::vec_wide_i64::capacity(copy) == 0 && std::vec_wide_i64::len(value) == 1 && core::wide_i64::eq(std::vec_wide_i64::get_or(value, 0, core::wide_i64::zero()), minimum)) {
        std::vec_wide_i64::destroy(copy);
        std::vec_wide_i64::destroy(value);
        return 0;
    }
    std::vec_wide_i64::destroy(copy);
    std::vec_wide_i64::destroy(value);
    return 1;
}
