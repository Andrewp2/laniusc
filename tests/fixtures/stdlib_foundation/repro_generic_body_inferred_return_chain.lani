// Both inferred call results are introduced inside a generic body.
fn duplicate<T>(value: T) -> [T; 2] { return [value, value]; }
fn keep<T>(value: T) -> T { return value; }
fn produce<T>(value: T) -> [T; 2] {
    let values = duplicate(value);
    let copied = keep(values);
    return copied;
}
fn main() -> i32 {
    let values: [i32; 2] = produce(42);
    if (values[0] != 42 || values[1] != 42) { return 1; }
    values[0] = -7;
    if (values[0] != -7 || values[1] != 42) { return 2; }
    return 0;
}
