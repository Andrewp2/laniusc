module app::main;
import core::iter;
import core::option;
struct WideOnly {}
impl WideOnly { fn borrow(&self) -> &WideOnly { return self; } }
pub impl core::iter::Iterator<u64> for WideOnly {
    pub fn next(&self) -> core::option::Option<u64> { return core::option::None(); }
}
struct Sum {}
impl Sum { fn borrow(&self) -> &Sum { return self; } }
pub impl core::iter::Folder<i32,i32> for Sum { pub fn apply(&self,accumulator:i32,value:i32) -> i32 { return accumulator+value; } }
fn main() -> i32 {
    let source:WideOnly=WideOnly {}; let folder:Sum=Sum {};
    let rejected:core::option::Option<i32> =core::iter::reduce<WideOnly,Sum,i32>(source.borrow(),folder.borrow()); // rejected_fold_bound
    return 0;
}
