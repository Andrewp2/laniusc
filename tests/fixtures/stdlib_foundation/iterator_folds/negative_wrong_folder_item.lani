module app::main;
import core::iter;
struct WrongFolder {}
impl WrongFolder { fn borrow(&self) -> &WrongFolder { return self; } }
pub impl core::iter::Folder<i64,u64> for WrongFolder { pub fn apply(&self,accumulator:i64,value:u64) -> i64 { return accumulator+(value as i64); } }
fn main() -> i32 {
    let source:core::iter::Once<i32> =core::iter::once<i32>(1); let folder:WrongFolder=WrongFolder {};
    let rejected:core::iter::FoldProgress<i64> =core::iter::rfold_up_to<core::iter::Once<i32>,WrongFolder,i32,i64>(source.borrow(),0,folder.borrow(),1); // rejected_fold_bound
    return 0;
}
