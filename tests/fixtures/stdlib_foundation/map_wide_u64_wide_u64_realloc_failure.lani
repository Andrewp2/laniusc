module app::main;
import core::wide_u64;
import std::map_wide_u64_wide_u64;
fn same(left: core::wide_u64::WideU64, right: core::wide_u64::WideU64) -> bool {
    return core::wide_u64::eq(left, right);
}
fn main() -> i32 {
    let key: core::wide_u64::WideU64 = core::wide_u64::from_words(2147483648, 7);
    let other: core::wide_u64::WideU64 = core::wide_u64::from_words(1, 7);
    let item: core::wide_u64::WideU64 = core::wide_u64::max_value();
    let fallback: core::wide_u64::WideU64 = core::wide_u64::zero();
    let value: std::map_wide_u64_wide_u64::MapWideU64WideU64 = std::map_wide_u64_wide_u64::try_reserve(std::map_wide_u64_wide_u64::new(), 1);
    if (std::map_wide_u64_wide_u64::capacity(value) != 1) { return 2; }
    value = std::map_wide_u64_wide_u64::try_insert(value, key, item);
    if (std::map_wide_u64_wide_u64::len(value) != 1) { return 3; }
    value = std::map_wide_u64_wide_u64::try_insert(value, other, key);
    if (std::map_wide_u64_wide_u64::len(value) == 1 &&
        std::map_wide_u64_wide_u64::capacity(value) == 1 &&
        same(std::map_wide_u64_wide_u64::get_or(value, key, fallback), item) &&
        !std::map_wide_u64_wide_u64::contains_key(value, other)) {
        std::map_wide_u64_wide_u64::destroy(value);
        return 0;
    }
    if (std::map_wide_u64_wide_u64::len(value) == 2 &&
        std::map_wide_u64_wide_u64::capacity(value) == 2 &&
        same(std::map_wide_u64_wide_u64::get_or(value, key, fallback), item) &&
        same(std::map_wide_u64_wide_u64::get_or(value, other, fallback), key)) {
        std::map_wide_u64_wide_u64::destroy(value);
        return 4;
    }
    std::map_wide_u64_wide_u64::destroy(value);
    return 5;
}
