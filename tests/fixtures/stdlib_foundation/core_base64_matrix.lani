module app::main;
import core::base64;

fn main() -> i32 {
    let zero: u8 = 0;
    let input: [u8; 1] = [zero];
    let high: u8 = 255;
    let input_two: [u8; 2] = [high, zero];
    let input_three: [u8; 3] = [high, zero, zero];
    let encoded: [u8; 4] = [zero, zero, zero, zero];
    let decoded: [u8; 1] = [zero];
    let decoded_two: [u8; 2] = [zero, zero];
    let decoded_three: [u8; 3] = [zero, zero, zero];
    let value: i32 = 0;
    while (value <= 255) {
        let byte: u8 = value as u8;
        input[0] = byte;
        if (core::base64::encode_into(input, 1, encoded, 4) != 4 ||
            core::base64::decoded_len_or(encoded, 4, -1) != 1 ||
            core::base64::decode_into(encoded, 4, decoded, 1) != 1 ||
            decoded[0] != byte) { return 1; }
        input_two[1] = byte;
        if (core::base64::encode_into(input_two, 2, encoded, 4) != 4 ||
            core::base64::decoded_len_or(encoded, 4, -1) != 2 ||
            core::base64::decode_into(encoded, 4, decoded_two, 2) != 2 ||
            decoded_two[0] != high || decoded_two[1] != byte) { return 2; }
        input_three[2] = byte;
        if (core::base64::encode_into(input_three, 3, encoded, 4) != 4 ||
            core::base64::decoded_len_or(encoded, 4, -1) != 3 ||
            core::base64::decode_into(encoded, 4, decoded_three, 3) != 3 ||
            decoded_three[0] != high || decoded_three[1] != zero ||
            decoded_three[2] != byte) { return 3; }
        value += 1;
    }
    return 0;
}
