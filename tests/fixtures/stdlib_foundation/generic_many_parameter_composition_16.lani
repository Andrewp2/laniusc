// Executable 16-parameter composition with generated inner applications.
module app::main;
import std::io;
struct Pair { number: i32, text: str }
struct Wide<A0, A1, A2, A3, A4, A5, A6, A7, A8, A9, A10, A11, A12, A13, A14, A15> {
    f0: A0,
    f1: A1,
    f2: A2,
    f3: A3,
    f4: A4,
    f5: A5,
    f6: A6,
    f7: A7,
    f8: A8,
    f9: A9,
    f10: A10,
    f11: A11,
    f12: A12,
    f13: A13,
    f14: A14,
    f15: A15,
}
struct Holder<T> { child: Wide<i32, bool, str, [i32; 2], Pair, [i32], i32, bool, str, [i32; 2], Pair, [i32], i32, bool, str, T>, sentinel: i32 }
fn build<T>(input: T, views: [i32]) -> Holder<T> {
    return Holder {
        child: Wide {
            f0: -1000,
            f1: false,
            f2: "Ω",
            f3: [-7, 42],
            f4: Pair { number: 4, text: "Ω" },
            f5: views,
            f6: -994,
            f7: false,
            f8: "Ω",
            f9: [-7, 42],
            f10: Pair { number: 10, text: "Ω" },
            f11: views,
            f12: -988,
            f13: false,
            f14: "Ω",
            f15: input,
        }, sentinel: 1234
    };
}
fn last<A0, A1, A2, A3, A4, A5, A6, A7, A8, A9, A10, A11, A12, A13, A14, A15>(input: Wide<A0, A1, A2, A3, A4, A5, A6, A7, A8, A9, A10, A11, A12, A13, A14, A15>) -> A15 { return input.f15; }
fn main() -> i32 {
    let words: [str; 2] = ["Ω", ""];
    let numbers: [i32; 2] = [-7, 42];
    let value: Holder<[str; 2]> = build(words, numbers);
    if (value.child.f0 != -1000) { return 1; }
    if (value.child.f1) { return 2; }
    if (std::io::println(value.child.f2) != 3) { return 3; }
    if (value.child.f3[0] != -7 || value.child.f3[1] != 42) { return 4; }
    if (value.child.f4.number != 4) { return 5; }
    if (std::io::println(value.child.f4.text) != 3) { return 6; }
    if (value.child.f5[0] != -7 || value.child.f5[1] != 42) { return 7; }
    if (value.child.f6 != -994) { return 1; }
    if (value.child.f7) { return 2; }
    if (std::io::println(value.child.f8) != 3) { return 3; }
    if (value.child.f9[0] != -7 || value.child.f9[1] != 42) { return 4; }
    if (value.child.f10.number != 10) { return 5; }
    if (std::io::println(value.child.f10.text) != 3) { return 6; }
    if (value.child.f11[0] != -7 || value.child.f11[1] != 42) { return 7; }
    if (value.child.f12 != -988) { return 1; }
    if (value.child.f13) { return 2; }
    if (std::io::println(value.child.f14) != 3) { return 3; }
    let selected: [str; 2] = last(value.child);
    if (std::io::println(selected[0]) != 3) { return 8; }
    if (std::io::println(selected[1]) != 1) { return 9; }
    selected[0] = "changed";
    if (std::io::println(value.child.f15[0]) != 3) { return 10; }
    let duplicate: Holder<[str; 2]> = value;
    duplicate.child.f0 = 999;
    duplicate.child.f15[0] = "changed";
    if (value.child.f0 != -1000 || value.sentinel != 1234) { return 11; }
    if (std::io::println(value.child.f15[0]) != 3) { return 13; }
    value.child.f5[0] = 9;
    if (numbers[0] != 9 || value.child.f11[0] != 9) { return 12; }
    return 0;
}
