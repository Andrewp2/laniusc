module app::main;
import core::mem;
import core::random;
import core::result;
import core::text;
import std::io;
import std::io_decimal;
import std::process;
fn argument(index: i32, pointer: ptr, bytes: [u8]) -> u64 {
    let count: i32 = std::process::arg_len(index); assert(count >= 1 && count <= 32);
    assert(std::process::arg_read(index,pointer,count as usize) == count);
    let text: core::text::Text = core::result::unwrap(core::text::from_utf8(bytes,count)); return core::result::unwrap(text.parse_u64());
}
fn output(value: u64) { assert(std::io_decimal::write_u64(1,value) > 0 && std::io::write_byte(1,10) == 1); }
fn snapshot(rng: &core::random::Xoshiro256PlusPlus) { let state: core::random::State = rng.snapshot(); output(state.s0);output(state.s1);output(state.s2);output(state.s3); }
fn mixed(rng: &core::random::Xoshiro256PlusPlus, index: i32) -> u64 {
    let mode: i32 = index % 7;
    if (mode == 0) { return core::result::unwrap(core::random::below(rng,3)); }
    if (mode == 1) { return core::result::unwrap(core::random::below(rng,9223372036854775809)); }
    if (mode == 2) { return core::result::unwrap(core::random::inclusive_i64(rng,-1000,1000)) as u64; }
    if (mode == 3) { let value: f32 = core::result::unwrap(core::random::unit_f32(rng)); return (value * 16777216.0) as u64; }
    if (mode == 4) { let value: f64 = core::result::unwrap(core::random::unit_f64(rng)); return (value * 9007199254740992.0) as u64; }
    if (mode == 5) { return rng.next_u32() as u64; }
    let bytes: [u8; 13] = [0;13]; core::result::unwrap(core::random::fill(rng,bytes,0,13));
    let hash: u64 = 0xcbf29ce484222325; let i: i32 = 0; while (i < 13) { hash = (hash ^ (bytes[i] as u64)) * 0x100000001b3; i += 1; } return hash;
}
fn main() -> i32 {
    let storage: [i32; 8] = [0;8]; let pointer: ptr = core::mem::i32_array_data_ptr(storage); let bytes: [u8] = core::mem::typed_slice_from_raw_parts(pointer,32);
    let seed: u64 = argument(1,pointer,bytes); let mode: u64 = argument(2,pointer,bytes); let count: i32 = argument(3,pointer,bytes) as i32; assert(count >= 0 && count <= 16384);
    let rng: core::random::Xoshiro256PlusPlus = core::random::from_seed(seed);
    if (mode == 1 || mode == 3) { rng.jump(); } if (mode == 2 || mode == 3) { rng.long_jump(); } if (mode == 3) { rng.jump(); }
    snapshot(rng.borrow()); let index: i32 = 0;
    if (mode == 5) {
        while (index < 4) { output(rng.next_u64()); index += 1; } rng.jump(); output(rng.next_u64()); output(rng.next_u64()); rng.long_jump(); output(rng.next_u64()); output(rng.next_u64());
    } else {
        while (index < count) { if (mode == 4) { output(mixed(rng.borrow(),index)); } else { output(rng.next_u64()); } index += 1; }
    }
    snapshot(rng.borrow()); return 0;
}
