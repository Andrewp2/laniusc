module app::main;
import std::vec_i32;

struct Wrap { cells: std::vec_i32::VecI32 }

fn make() -> Wrap {
    return Wrap { cells: std::vec_i32::new() };
}

fn main() -> i32 {
    let wrapped: Wrap = make();
    let cells: std::vec_i32::VecI32 = wrapped.cells;
    if (std::vec_i32::len(cells) != 0) { return 1; }
    return 0;
}
