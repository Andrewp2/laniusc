module app::main;
import std::vec;

struct Wrap { cells: std::vec::Vec<i32> }

fn make() -> Wrap {
    return Wrap { cells: std::vec::new() };
}

fn main() -> i32 {
    let wrapped: Wrap = make();
    let cells: std::vec::Vec<i32> = wrapped.cells;
    if (std::vec::len(cells) != 0) { return 1; }
    return 0;
}
