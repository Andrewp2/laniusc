// Real native locking state adapter. argv[1] is an existing private test file.
// Each input program is (identity, action_count), then action quadruples.
// Failed nonblocking acquisitions are explicitly unlocked before continuing.
module app::main;

import core::io;
import core::mem;
import core::option;
import core::path;
import core::result;
import core::slice;
import std::file;
import std::file_ops;
import std::io;
import std::process;

fn read_exact(pointer: ptr, count: i32, allow_eof: bool) -> bool {
    let done: i32 = 0;
    while (done < count) {
        let got: i32 = std::io::read_stdin(pointer + (done as usize), (count - done) as usize);
        assert(got >= 0);
        if (got == 0) { assert(allow_eof && done == 0); return false; }
        done += got;
    }
    return true;
}

fn write_all(pointer: ptr, count: i32) {
    let done: i32 = 0;
    while (done < count) {
        let got: i32 = std::io::write_stdout(pointer + (done as usize), (count - done) as usize);
        assert(got > 0);
        done += got;
    }
}

fn get64(bytes: [u8], offset: i32) -> u64 {
    let result: u64 = 0;
    let index: i32 = 0;
    while (index < 8) {
        result |= (bytes[offset + index] as u64) << (index * 8);
        index += 1;
    }
    return result;
}

struct Output { bytes: [u8], pointer: ptr, used: i32 }
impl Output {
    fn borrow(&self) -> &Output { return self; }
    fn flush(&self) { write_all(self.pointer, self.used); self.used = 0; }
    fn word(&self, value: u64) {
        if (self.used == 4096) { self.flush(); }
        let index: i32 = 0;
        while (index < 8) {
            self.bytes[self.used + index] = ((value >> (index * 8)) & 255) as u8;
            index += 1;
        }
        self.used += 8;
    }
}

fn slot(a: &std::file::File, b: &std::file::File, c: &std::file::File,
        d: &std::file::File, index: i32) -> &std::file::File {
    if (index == 0) { return a; }
    if (index == 1) { return b; }
    if (index == 2) { return c; }
    assert(index == 3);
    return d;
}

fn error_code(error: core::io::Error) -> i32 {
    return match (error) {
        core::io::Error::InvalidInput -> 1,
        core::io::Error::UnexpectedEof -> 2,
        core::io::Error::WriteZero -> 3,
        core::io::Error::InvalidCount -> 4,
        core::io::Error::CountOverflow -> 5,
        core::io::Error::LimitExceeded -> 6,
        core::io::Error::Interrupted -> 7,
        core::io::Error::WouldBlock -> 8,
        core::io::Error::AllocationFailed -> 9,
        core::io::Error::Host(code) -> 10,
    };
}

fn host_code(error: core::io::Error) -> i32 {
    return match (error) { core::io::Error::Host(code) -> code, _ -> 0 };
}

fn emit_result(result: core::result::Result<i32, core::io::Error>, output: &Output) {
    let failed: bool = result.is_err();
    let code: i32 = 0;
    let host: i32 = 0;
    let value: i32 = 0;
    if (failed) {
        let cause: core::io::Error = result.unwrap_err();
        code = error_code(cause);
        host = host_code(cause);
    } else { value = result.unwrap(); }
    output.word(failed as u64);
    output.word(code as u64);
    output.word((host as i64) as u64);
    output.word((value as i64) as u64);
}

struct Action { operation: i32, index: i32, other: i32, argument: i64 }

fn perform(file: &std::file::File, target: &std::file::File,
           path: core::path::Path, action: Action) -> core::result::Result<i32, core::io::Error> {
    if (action.operation == 0) {
        assert(!file.is_open());
        let options: std::file_ops::OpenOptions = std::file_ops::options();
        options.access = std::file_ops::Access::ReadWrite;
        options.append = (action.other & 1) != 0;
        options.nonblocking = (action.other & 2) != 0;
        let opened: core::result::Result<std::file::File, core::io::Error> = std::file_ops::open(path, options);
        if (opened.is_err()) {
            let cause: core::io::Error = opened.unwrap_err();
            return core::result::Err(cause);
        }
        let owner: std::file::File = opened.unwrap();
        // Explicit transfer into a closed logical slot: no shallow alias owns
        // the transferred descriptor, and every actual owner is later closed.
        file.handle = owner.take_handle().unwrap();
        let moved: core::result::Result<i64, core::io::Error> =
            std::file_ops::seek(file, action.argument, std::file_ops::Origin::Start);
        if (moved.is_err()) {
            let cause: core::io::Error = moved.unwrap_err();
            return core::result::Err(cause);
        }
        assert(moved.unwrap() == action.argument);
        return core::result::Ok(0);
    }
    if (action.operation == 1) {
        assert(!target.is_open());
        let copied: core::result::Result<std::file::File, core::io::Error> =
            std::file_ops::duplicate(file, 0, action.argument != 0);
        if (copied.is_err()) {
            let cause: core::io::Error = copied.unwrap_err();
            return core::result::Err(cause);
        }
        let owner: std::file::File = copied.unwrap();
        target.handle = owner.take_handle().unwrap();
        return core::result::Ok(0);
    }
    if (action.operation == 2) { return file.close(); }
    if (action.operation == 3) {
        return std::file_ops::lock(file, std::file_ops::LockMode::Shared,
                                  std::file_ops::LockWait::Nonblocking);
    }
    if (action.operation == 4) {
        return std::file_ops::lock(file, std::file_ops::LockMode::Exclusive,
                                  std::file_ops::LockWait::Nonblocking);
    }
    if (action.operation == 5) { return std::file_ops::unlock(file); }
    assert(action.operation == 6);
    let moved: core::result::Result<i64, core::io::Error> =
        std::file_ops::seek(file, action.argument, std::file_ops::Origin::Start);
    if (moved.is_err()) {
        let cause: core::io::Error = moved.unwrap_err();
        return core::result::Err(cause);
    }
    return core::result::Ok(moved.unwrap() as i32);
}

fn emit_owner(file: &std::file::File, output: &Output) {
    output.word(file.is_open() as u64);
    let raw: core::option::Option<i32> = file.raw_handle();
    if (raw.is_none()) {
        output.word(18446744073709551615);
        output.word(18446744073709551615);
        output.word(18446744073709551615);
        output.word(18446744073709551615);
        return;
    }
    let position: i64 = std::file_ops::position(file).unwrap();
    let status: i32 = std::file_ops::status_flags(file).unwrap();
    let close_on_exec: bool = std::file_ops::close_on_exec(file).unwrap();
    output.word(raw.unwrap() as u64);
    output.word(position as u64);
    output.word((status & 3072) as u64);
    output.word(close_on_exec as u64);
}

fn emit_content(file: &std::file::File, output: &Output) {
    let bytes: [u8; 32] = [0; 32];
    let destination: core::slice::View<u8> = core::slice::view<u8>(bytes, 32).unwrap();
    let got: core::result::Result<i32, core::io::Error> = std::file_ops::read_at(file, destination, 0);
    assert(got.is_ok() && got.unwrap() == 32);
    output.word(32);
    let index: i32 = 0;
    while (index < 32) { output.word(bytes[index] as u64); index += 1; }
}

fn run(bytes: [u8], path: core::path::Path, witness: &std::file::File, output: &Output) {
    let actions: i32 = get64(bytes, 8) as i32;
    let a: std::file::File = std::file::File { handle: -1 };
    let b: std::file::File = std::file::File { handle: -1 };
    let c: std::file::File = std::file::File { handle: -1 };
    let d: std::file::File = std::file::File { handle: -1 };
    let step: i32 = 0;
    while (step < actions) {
        let at: i32 = 16 + step * 32;
        let action: Action = Action {
            operation: get64(bytes, at) as i32, index: get64(bytes, at + 8) as i32,
            other: get64(bytes, at + 16) as i32, argument: get64(bytes, at + 24) as i64
        };
        assert(action.operation >= 0 && action.operation <= 6 && action.index >= 0 && action.index < 4);
        assert(action.other >= 0 && action.other < 4 && action.argument >= 0 && action.argument <= 31);
        let subject: &std::file::File = slot(a.borrow(), b.borrow(), c.borrow(), d.borrow(), action.index);
        let target: &std::file::File = slot(a.borrow(), b.borrow(), c.borrow(), d.borrow(), action.other);
        let result: core::result::Result<i32, core::io::Error> = perform(subject, target, path, action);
        let normalized: bool = false;
        let normalization: core::result::Result<i32, core::io::Error> = core::result::Ok(0);
        if ((action.operation == 3 || action.operation == 4) && result.is_err()) {
            let cause: core::io::Error = result.unwrap_err();
            if (error_code(cause) == 8) {
                normalized = true;
                normalization = std::file_ops::unlock(subject);
            }
        }
        output.word(action.operation as u64);
        output.word(action.index as u64);
        output.word(action.other as u64);
        output.word(action.argument as u64);
        emit_result(result, output);
        output.word(normalized as u64);
        emit_result(normalization, output);
        emit_content(witness, output);
        emit_owner(a.borrow(), output);
        emit_owner(b.borrow(), output);
        emit_owner(c.borrow(), output);
        emit_owner(d.borrow(), output);
        step += 1;
    }
    assert(a.close().is_ok() && b.close().is_ok() && c.close().is_ok() && d.close().is_ok());
}

fn main() -> i32 {
    let path_size: i32 = std::process::arg_len(1);
    assert(path_size > 0 && path_size <= 4095);
    let path_words: [i32; 1024] = [0; 1024];
    let path_pointer: ptr = core::mem::i32_array_data_ptr(path_words);
    assert(std::process::arg_read(1, path_pointer, 4096) == path_size);
    let path_bytes: [u8] = core::mem::typed_slice_from_raw_parts<u8>(path_pointer, path_size);
    let path: core::path::Path = core::path::from_bytes(path_bytes, path_size).unwrap();
    let witness: std::file::File = std::file_ops::open(path, std::file_ops::options()).unwrap();
    let input_words: [i32; 1024] = [0; 1024];
    let input_pointer: ptr = core::mem::i32_array_data_ptr(input_words);
    let input: [u8] = core::mem::typed_slice_from_raw_parts<u8>(input_pointer, 4096);
    let output_words: [i32; 1024] = [0; 1024];
    let output_pointer: ptr = core::mem::i32_array_data_ptr(output_words);
    let output_bytes: [u8] = core::mem::typed_slice_from_raw_parts<u8>(output_pointer, 4096);
    let output: Output = Output { bytes: output_bytes, pointer: output_pointer, used: 0 };
    while (read_exact(input_pointer, 16, true)) {
        let actions: u64 = get64(input, 8);
        assert(actions <= 64);
        assert(read_exact(input_pointer + 16, (actions * 32) as i32, false));
        run(input, path, witness.borrow(), output.borrow());
    }
    assert(witness.close().is_ok());
    output.flush();
    return 0;
}
