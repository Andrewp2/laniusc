module app::main;
import core::ordering;
import core::slice;
struct Wrong {}
impl Wrong { fn borrow(&self) -> &Wrong { return self; } }
pub impl core::ordering::Comparator<i64,i32> for Wrong {
    pub fn compare(&self,left:i64,right:i32) -> core::ordering::Ordering { return core::ordering::Ordering::Equal; }
}
fn main() -> i32 {
    let data:[i32;2]=[2,1]; let order:Wrong=Wrong {};
    let view:core::slice::View<i32> =core::slice::view<i32>(data,2).unwrap();
    let rejected:i32=core::slice::sort_unstable_by<i32,Wrong>(view,order.borrow()).unwrap(); // rejected_ordering_bound
    return 0;
}
