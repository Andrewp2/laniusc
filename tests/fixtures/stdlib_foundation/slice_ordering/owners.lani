// Sorting rearranges shallow owned records; cleanup authority stays in the slots.
// P/p delimit phases that must perform no allocation or release service.
module app::main;
import alloc::string;
import alloc::vec;
import core::mem;
import core::option;
import core::ordering;
import core::result;
import core::slice;
import std::io;

struct Leaf { text: alloc::string::String, serial: u64 }
struct Pair<T> { first: T, second: T, flags: [i32;3] }
struct Record<T> { id: i32, key: i32, payload: T, seal: u64 }
struct Order { calls: u64, descending: bool, broken: i32 }
struct Lookup { calls: u64, descending: bool }

fn mark(value: i32) {
    let storage: [i32;1] = [value];
    assert(std::io::write_stderr(core::mem::i32_array_data_ptr(storage),1) == 1);
}
fn key(id: i32) -> i32 {
    if (id == 0) { return -100; }
    if (id == 13) { return 100; }
    return (((id-1)*5)%12)/3;
}
fn leaf(id: i32, side: i32) -> Leaf {
    let bytes: [u8;6] = [78,(65+id) as u8,0,194,162,(48+side) as u8];
    return Leaf { text: alloc::string::from_utf8(bytes,6).unwrap(), serial: (1000+2*id+side) as u64 };
}
fn check_leaf(value: Leaf, id: i32, side: i32) {
    assert(value.serial == (1000+2*id+side) as u64 && value.text.byte_len() == 6);
    assert(value.text.byte_at(0).unwrap() == 78 && value.text.byte_at(1).unwrap() == (65+id) as u8);
    assert(value.text.byte_at(2).unwrap() == 0 && value.text.byte_at(3).unwrap() == 194);
    assert(value.text.byte_at(4).unwrap() == 162 && value.text.byte_at(5).unwrap() == (48+side) as u8);
}
fn check(value: Record<Pair<Leaf>>) {
    assert(value.id >= 0 && value.id < 14 && value.key == key(value.id));
    assert(value.seal == (987654321+104729*value.id) as u64);
    assert(value.payload.flags[0] == value.id && value.payload.flags[1] == -value.id && value.payload.flags[2] == 77);
    check_leaf(value.payload.first,value.id,0); check_leaf(value.payload.second,value.id,1);
    assert(value.payload.first.text.bytes.storage != value.payload.second.text.bytes.storage);
}
fn permutation(values: &alloc::vec::Vec<Record<Pair<Leaf>>>) {
    assert(values.len() == 14 && values.at(0).id == 0 && values.at(13).id == 13);
    let seen: [i32;14] = [0;14]; let index: i32 = 0;
    while (index < 14) {
        let value: Record<Pair<Leaf>> = values.at(index); check(value);
        assert(seen[value.id] == 0); seen[value.id] = 1; index += 1;
    }
    index = 0; while (index < 14) { assert(seen[index] == 1); index += 1; }
}
impl Order { fn borrow(&self) -> &Order { return self; } }
impl Lookup { fn borrow(&self) -> &Lookup { return self; } }
pub impl core::ordering::Comparator<Record<Pair<Leaf>>,Record<Pair<Leaf>>> for Order {
    pub fn compare(&self, left: Record<Pair<Leaf>>, right: Record<Pair<Leaf>>) -> core::ordering::Ordering {
        self.calls += 1; check(left); check(right);
        if (self.broken == 1) { return core::ordering::Ordering::Equal; }
        if (self.broken == 2) { return core::ordering::Ordering::Less; }
        if (self.descending) { return core::ordering::compare_i32(right.key,left.key); }
        return core::ordering::compare_i32(left.key,right.key);
    }
}
pub impl core::ordering::Comparator<Record<Pair<Leaf>>,i32> for Lookup {
    pub fn compare(&self, left: Record<Pair<Leaf>>, right: i32) -> core::ordering::Ordering {
        self.calls += 1; check(left);
        if (self.descending) { return core::ordering::compare_i32(right,left.key); }
        return core::ordering::compare_i32(left.key,right);
    }
}
fn clamp(value: i32) -> i32 { if (value < 0) { return 0; } if (value > 12) { return 12; } return value; }
fn searches(view: core::slice::View<Record<Pair<Leaf>>>, context: &Lookup) {
    let needle: i32 = -1;
    while (needle <= 4) {
        let low: i32 = clamp(needle*3); let high: i32 = clamp((needle+1)*3);
        if (context.descending) { low = clamp((3-needle)*3); high = clamp((4-needle)*3); }
        assert(core::slice::lower_bound_by<Record<Pair<Leaf>>,i32,Lookup>(view,needle,context).unwrap() == low);
        assert(core::slice::upper_bound_by<Record<Pair<Leaf>>,i32,Lookup>(view,needle,context).unwrap() == high);
        let first: core::option::Option<i32> = core::slice::binary_search_first_by<Record<Pair<Leaf>>,i32,Lookup>(view,needle,context).unwrap();
        let last: core::option::Option<i32> = core::slice::binary_search_last_by<Record<Pair<Leaf>>,i32,Lookup>(view,needle,context).unwrap();
        if (needle >= 0 && needle <= 3) { assert(first.unwrap() == low && last.unwrap() == high-1); }
        else { assert(first.is_none() && last.is_none()); }
        needle += 1;
    }
}
fn main() -> i32 {
    let values: alloc::vec::Vec<Record<Pair<Leaf>>> = alloc::vec::with_capacity<Record<Pair<Leaf>>>(14).unwrap();
    let index: i32 = 0;
    while (index < 14) {
        let payload: Pair<Leaf> = Pair { first: leaf(index,0), second: leaf(index,1), flags: [index,-index,77] };
        values.try_push(Record { id: index, key: key(index), payload: payload, seal: (987654321+104729*index) as u64 }).unwrap();
        index += 1;
    }
    assert(core::mem::slice_stride(values.as_slice()) < 0);
    let view: core::slice::View<Record<Pair<Leaf>>> = values.as_view().subview(1,13).unwrap();
    let order: Order = Order { calls: 0, descending: false, broken: 0 };
    let lookup: Lookup = Lookup { calls: 0, descending: false };
    permutation(values.borrow());
    mark(80);
    let empty: core::slice::View<Record<Pair<Leaf>>> = view.subview(0,0).unwrap();
    assert(core::slice::sort_unstable_by<Record<Pair<Leaf>>,Order>(empty,order.borrow()).unwrap() == 0);
    assert(core::slice::sort_unstable_by<Record<Pair<Leaf>>,Order>(view.subview(0,1).unwrap(),order.borrow()).unwrap() == 1);
    assert(core::slice::is_sorted_by<Record<Pair<Leaf>>,Order>(empty,order.borrow()).unwrap());
    assert(core::slice::partition_lt_by<Record<Pair<Leaf>>,i32,Lookup>(empty,2,lookup.borrow()).unwrap() == 0);
    assert(core::slice::lower_bound_by<Record<Pair<Leaf>>,i32,Lookup>(empty,2,lookup.borrow()).unwrap() == 0);
    assert(core::slice::upper_bound_by<Record<Pair<Leaf>>,i32,Lookup>(empty,2,lookup.borrow()).unwrap() == 0);
    assert(core::slice::binary_search_first_by<Record<Pair<Leaf>>,i32,Lookup>(empty,2,lookup.borrow()).unwrap().is_none());
    assert(core::slice::binary_search_last_by<Record<Pair<Leaf>>,i32,Lookup>(empty,2,lookup.borrow()).unwrap().is_none());
    assert(order.calls == 0 && lookup.calls == 0);
    assert(core::slice::sort_unstable_by<Record<Pair<Leaf>>,Order>(view,order.borrow()).unwrap() == 12);
    assert(core::slice::is_sorted_by<Record<Pair<Leaf>>,Order>(view,order.borrow()).unwrap()); mark(112);
    permutation(values.borrow()); index = 0;
    while (index < 12) { assert(view.get(index).unwrap().key == index/3); index += 1; }
    mark(80); searches(view,lookup.borrow()); mark(112); permutation(values.borrow());
    view.reverse();
    mark(80);
    let boundary: i32 = core::slice::partition_lt_by<Record<Pair<Leaf>>,i32,Lookup>(view,2,lookup.borrow()).unwrap(); mark(112);
    assert(boundary == 6); index = 0;
    while (index < 12) { assert((view.get(index).unwrap().key < 2) == (index < boundary)); index += 1; }
    permutation(values.borrow()); order.descending = true; lookup.descending = true;
    mark(80); assert(core::slice::sort_unstable_by<Record<Pair<Leaf>>,Order>(view,order.borrow()).unwrap() == 12);
    assert(core::slice::is_sorted_by<Record<Pair<Leaf>>,Order>(view,order.borrow()).unwrap()); mark(112);
    permutation(values.borrow()); index = 0;
    while (index < 12) { assert(view.get(index).unwrap().key == 3-index/3); index += 1; }
    mark(80); searches(view,lookup.borrow()); mark(112); permutation(values.borrow());
    // Equivalent answers and deliberately unlawful answers retain whole owners.
    // The unlawful case claims only bounded termination and permutation.
    order.broken = 1; order.calls = 0;
    mark(80); assert(core::slice::sort_unstable_by<Record<Pair<Leaf>>,Order>(view,order.borrow()).unwrap() == 12); mark(112);
    assert(order.calls <= 8*12*5); permutation(values.borrow());
    order.broken = 2; order.calls = 0;
    mark(80); assert(core::slice::sort_unstable_by<Record<Pair<Leaf>>,Order>(view,order.borrow()).unwrap() == 12); mark(112);
    assert(order.calls <= 8*12*5); permutation(values.borrow());
    while (true) {
        let next: core::option::Option<Record<Pair<Leaf>>> = values.pop(); if (next.is_none()) { break; }
        let value: Record<Pair<Leaf>> = next.unwrap(); check(value);
        value.payload.first.text.destroy(); value.payload.second.text.destroy();
    }
    values.destroy(); mark(68); return 0;
}
