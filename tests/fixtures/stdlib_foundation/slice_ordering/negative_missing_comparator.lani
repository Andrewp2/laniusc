module app::main;
import core::ordering;
import core::slice;
struct Missing {}
impl Missing { fn borrow(&self) -> &Missing { return self; } }
fn main() -> i32 {
    let data:[i32;2]=[2,1]; let order:Missing=Missing {};
    let view:core::slice::View<i32> =core::slice::view<i32>(data,2).unwrap();
    let rejected:i32=core::slice::sort_unstable_by<i32,Missing>(view,order.borrow()).unwrap(); // rejected_ordering_bound
    return 0;
}
