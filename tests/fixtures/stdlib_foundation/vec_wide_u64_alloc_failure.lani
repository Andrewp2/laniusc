module app::main;
import core::wide_u64;
import std::vec_wide_u64;
fn main() -> i32 {
    let value: std::vec_wide_u64::VecWideU64 = std::vec_wide_u64::new();
    value = std::vec_wide_u64::try_push(value, core::wide_u64::from_words(2147483648, 0));
    if (std::vec_wide_u64::len(value) == 0 && std::vec_wide_u64::capacity(value) == 0) {
        return 0;
    }
    std::vec_wide_u64::destroy(value);
    return 1;
}
