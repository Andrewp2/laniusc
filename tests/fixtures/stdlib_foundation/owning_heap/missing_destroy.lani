module app::main;
import alloc::binary_heap;
import alloc::clone_binary_heap;
struct Item {}
fn main() -> i32 {
    let heap: alloc::binary_heap::BinaryHeap<Item> =alloc::binary_heap::new<Item>(alloc::binary_heap::Order::Max);
    let cursor: alloc::binary_heap::IntoIter<Item> =heap.take_iter();
    alloc::clone_binary_heap::destroy_binary_heap_iter<Item>(cursor.borrow());
    return 0;
}
