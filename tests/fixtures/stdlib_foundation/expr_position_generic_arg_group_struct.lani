// expect: 0
// Expression form and position: a parenthesized struct value as a generic argument.
module app::main;
struct W { v: i32 }
fn keep<T>(value: T) -> T { return value; }
fn main() -> i32 {
    let w: W = W { v: 7 };
    let k: W = keep((w));
    if (k.v != 7) { return 1; }
    return 0;
}
