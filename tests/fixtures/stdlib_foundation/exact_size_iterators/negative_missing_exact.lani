module app::main;
import core::iter;
import core::option;
struct Forward {}
impl Forward { fn borrow(&self) -> &Forward { return self; } }
pub impl core::iter::Iterator<i32> for Forward {
    pub fn next(&self) -> core::option::Option<i32> { return core::option::None(); }
}
fn require_exact<I,T>(source:&I) -> u64
    where I:core::iter::Iterator<T>, I:core::iter::ExactSizeIterator<T> {
    return source.remaining_count();
}
fn main() -> i32 {
    let source:Forward=Forward {};
    let rejected:u64=require_exact<Forward,i32>(source.borrow()); // rejected_exact_count
    return 0;
}
