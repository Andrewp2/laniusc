module app::main;
import core::iter;
import core::option;
struct WrongItem {}
impl WrongItem { fn borrow(&self) -> &WrongItem { return self; } }
pub impl core::iter::Iterator<u64> for WrongItem {
    pub fn next(&self) -> core::option::Option<u64> { return core::option::None(); }
}
pub impl core::iter::ExactSizeIterator<i32> for WrongItem {
    pub fn remaining_count(&self) -> u64 { return 0; }
}
fn require_exact<I,T>(source:&I) -> u64
    where I:core::iter::Iterator<T>, I:core::iter::ExactSizeIterator<T> {
    return source.remaining_count();
}
fn main() -> i32 {
    let source:WrongItem=WrongItem {};
    let rejected:u64=require_exact<WrongItem,u64>(source.borrow()); // rejected_exact_count
    return 0;
}
