module app::main;
import core::iter;
struct Keep {}
impl Keep { fn borrow(&self) -> &Keep { return self; } }
pub impl core::iter::Mapper<i32,bool> for Keep {
    pub fn apply(&self,value:i32) -> bool { return value==7; }
}
fn require_exact<I,T>(source:&I) -> u64
    where I:core::iter::Iterator<T>, I:core::iter::ExactSizeIterator<T> {
    return source.remaining_count();
}
fn main() -> i32 {
    let source:core::iter::Once<i32> =core::iter::once<i32>(7); let keep:Keep=Keep {};
    let filtered:core::iter::Filter<core::iter::Once<i32>,Keep,i32> =core::iter::filter<core::iter::Once<i32>,Keep,i32>(source.borrow(),keep.borrow());
    let rejected:u64=require_exact<core::iter::Filter<core::iter::Once<i32>,Keep,i32>,i32>(filtered.borrow()); // rejected_exact_count
    return 0;
}
