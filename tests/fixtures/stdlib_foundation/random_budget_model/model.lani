// Test-only adapter for shared random source budgets and byte-state sequences.
module app::main;

import core::mem;
import core::option;
import core::random;
import core::f32;
import core::f64;
import core::result;
import core::slice;
import std::io;

fn read_exact(pointer: ptr, count: i32, allow_eof: bool) -> bool {
    let done: i32 = 0;
    while (done < count) {
        let got: i32 = std::io::read_stdin(pointer + (done as usize), (count - done) as usize);
        assert(got >= 0);
        if (got == 0) { assert(allow_eof && done == 0); return false; }
        done += got;
    }
    return true;
}

fn write_all(pointer: ptr, count: i32) {
    let done: i32 = 0;
    while (done < count) {
        let got: i32 = std::io::write_stdout(pointer + (done as usize), (count - done) as usize);
        assert(got > 0);
        done += got;
    }
}

fn get64(bytes: [u8], offset: i32) -> u64 {
    let result: u64 = 0;
    let index: i32 = 0;
    while (index < 8) {
        result |= (bytes[offset + index] as u64) << (index * 8);
        index += 1;
    }
    return result;
}

struct Output { bytes: [u8], pointer: ptr, used: i32 }
impl Output {
    fn borrow(&self) -> &Output { return self; }
    fn flush(&self) { write_all(self.pointer, self.used); self.used = 0; }
    fn word(&self, value: u64) {
        if (self.used == 4096) { self.flush(); }
        let index: i32 = 0;
        while (index < 8) {
            self.bytes[self.used + index] = ((value >> (index * 8)) & 255) as u8;
            index += 1;
        }
        self.used += 8;
    }
}

fn error_code(error: core::random::Error) -> u64 {
    return match (error) {
        core::random::Error::Bounds -> 1,
        core::random::Error::InvalidBound -> 2,
        core::random::Error::InvalidRange -> 3,
        core::random::Error::ZeroState -> 4,
        core::random::Error::Host(code) -> 5,
        core::random::Error::NoProgress -> 6,
        core::random::Error::InvalidCount -> 7,
        core::random::Error::DrawLimit -> 8,
    };
}

fn host_code(error: core::random::Error) -> i32 {
    return match (error) { core::random::Error::Host(code) -> code, _ -> 0 };
}

fn error_value(code: u64, payload: u64) -> core::random::Error {
    return match (code) {
        1 -> core::random::Error::Bounds,
        2 -> core::random::Error::InvalidBound,
        3 -> core::random::Error::InvalidRange,
        4 -> core::random::Error::ZeroState,
        5 -> core::random::Error::Host(payload as i32),
        6 -> core::random::Error::NoProgress,
        7 -> core::random::Error::InvalidCount,
        _ -> core::random::Error::DrawLimit,
    };
}

struct Script { input: [u8], length: i32, index: i32, calls: i32 }
impl Script { fn borrow(&self) -> &Script { return self; } }
pub impl core::random::Source64 for Script {
    pub fn draw(&self) -> core::result::Result<u64, core::random::Error> {
        self.calls += 1;
        if (self.index == self.length) { return core::result::Err(core::random::Error::NoProgress); }
        let at: i32 = 64 + self.index * 16;
        let event: u64 = get64(self.input, at);
        let value: u64 = get64(self.input, at + 8);
        self.index += 1;
        if (event == 0) { return core::result::Ok(value); }
        return core::result::Err(error_value(event, value));
    }
}

struct Answer { tag: u64, error: u64, host: i32, value: u64, completed: i32 }
fn success(value: u64) -> Answer { return Answer { tag: 0, error: 0, host: 0, value: value, completed: 0 }; }
fn failure(error: core::random::Error, completed: i32) -> Answer {
    return Answer { tag: 1, error: error_code(error), host: host_code(error), value: 0, completed: completed };
}
fn scalar(result: core::result::Result<u64, core::random::Error>) -> Answer {
    if (result.is_ok()) { return success(result.unwrap()); }
    return failure(result.unwrap_err(), 0);
}
fn transfer(result: core::result::Result<i32, core::random::Failure>) -> Answer {
    if (result.is_ok()) { return success(result.unwrap() as u64); }
    let error: core::random::Failure = result.unwrap_err();
    return failure(error.cause, error.completed);
}

fn scalar_operation<R>(source: &R, operation: u64, a: u64, b: u64) -> Answer where R: core::random::Source64 {
    if (operation == 0) { return scalar(source.draw()); }
    if (operation == 1) {
        let result: core::result::Result<u64, core::random::Error> = core::random::below<R>(source, a);
        return scalar(result);
    }
    if (operation == 2) {
        let result: core::result::Result<u64, core::random::Error> = core::random::inclusive_u64<R>(source, a, b);
        return scalar(result);
    }
    if (operation == 3) {
        let result: core::result::Result<i64, core::random::Error> = core::random::inclusive_i64<R>(source, a as i64, b as i64);
        if (result.is_ok()) { return success(result.unwrap() as u64); }
        return failure(result.unwrap_err(), 0);
    }
    if (operation == 4) {
        let result: core::result::Result<bool, core::random::Error> = core::random::boolean<R>(source);
        if (result.is_ok()) { return success(result.unwrap() as u64); }
        return failure(result.unwrap_err(), 0);
    }
    if (operation == 5) {
        let result: core::result::Result<f32, core::random::Error> = core::random::unit_f32<R>(source);
        if (result.is_ok()) { return success(core::f32::to_bits(result.unwrap()) as u64); }
        return failure(result.unwrap_err(), 0);
    }
    assert(operation == 6);
    let result: core::result::Result<f64, core::random::Error> = core::random::unit_f64<R>(source);
    if (result.is_ok()) { return success(core::f64::to_bits(result.unwrap())); }
    return failure(result.unwrap_err(), 0);
}

fn buffer_operation<R>(source: &R, operation: u64, a: u64, b: u64, bytes: [u8]) -> Answer where R: core::random::Source64 {
    if (operation == 7) {
        let result: core::result::Result<i32, core::random::Failure> =
            core::random::fill<R>(source, bytes, a as i32, b as i32);
        return transfer(result);
    }
    let values: core::slice::View<u8> = core::slice::View { values: bytes, start: a as i32, length: b as i32 };
    if (operation == 8) {
        let result: core::result::Result<core::option::Option<u8>, core::random::Error> =
            core::random::choose<R, u8>(source, values);
        if (result.is_err()) { return failure(result.unwrap_err(), 0); }
        let item: core::option::Option<u8> = result.unwrap();
        if (item.is_some()) { return success(item.unwrap() as u64); }
        return Answer { tag: 2, error: 0, host: 0, value: 0, completed: 0 };
    }
    assert(operation == 9);
    let result: core::result::Result<i32, core::random::Failure> = core::random::shuffle<R, u8>(source, values);
    return transfer(result);
}

fn apply<R>(source: &R, operation: u64, a: u64, b: u64, bytes: [u8]) -> Answer where R: core::random::Source64 {
    if (operation <= 6) { return scalar_operation<R>(source, operation, a, b); }
    return buffer_operation<R>(source, operation, a, b, bytes);
}

fn run(input: [u8], output: &Output) {
    let budget_a: core::random::DrawBudget = core::random::draw_budget(get64(input, 8));
    // Copying the counter is independent; copying an adapter below shares refs.
    let budget_b: core::random::DrawBudget = budget_a;
    let script: Script = Script { input: input, length: get64(input, 16) as i32, index: 0, calls: 0 };
    let first: core::random::Budgeted<Script> = core::random::budgeted<Script>(script.borrow(), budget_a.borrow());
    let copied: core::random::Budgeted<Script> = first;
    let independent: core::random::Budgeted<Script> = core::random::budgeted<Script>(script.borrow(), budget_b.borrow());
    let nested: core::random::Budgeted<core::random::Budgeted<Script>> =
        core::random::budgeted<core::random::Budgeted<Script>>(first.borrow(), budget_b.borrow());
    let same_nested: core::random::Budgeted<core::random::Budgeted<Script>> =
        core::random::budgeted<core::random::Budgeted<Script>>(first.borrow(), budget_a.borrow());
    let native: [u8; 32] = [0; 32];
    let words: [i32; 8] = [0; 8];
    let bytes: [u8] = native;
    if (get64(input, 0) == 1) {
        bytes = core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(words), 32);
    }
    if (get64(input, 0) == 0) { assert(core::mem::slice_stride(bytes) < 0); }
    else { assert(core::mem::slice_stride(bytes) == 1); }
    let index: i32 = 0;
    while (index < 32) { bytes[index] = (160 + index) as u8; index += 1; }
    index = 0;
    while (index < get64(input, 24) as i32) {
        let at: i32 = 64 + script.length * 16 + index * 32;
        let operation: u64 = get64(input, at);
        let adapter: u64 = get64(input, at + 8);
        let a: u64 = get64(input, at + 16);
        let b: u64 = get64(input, at + 24);
        assert(operation <= 9 && adapter <= 4);
        let answer: Answer = success(0);
        if (adapter == 0) { answer = apply<core::random::Budgeted<Script>>(first.borrow(), operation, a, b, bytes); }
        if (adapter == 1) { answer = apply<core::random::Budgeted<Script>>(copied.borrow(), operation, a, b, bytes); }
        if (adapter == 2) { answer = apply<core::random::Budgeted<Script>>(independent.borrow(), operation, a, b, bytes); }
        if (adapter == 3) { answer = apply<core::random::Budgeted<core::random::Budgeted<Script>>>(nested.borrow(), operation, a, b, bytes); }
        if (adapter == 4) { answer = apply<core::random::Budgeted<core::random::Budgeted<Script>>>(same_nested.borrow(), operation, a, b, bytes); }
        output.word(operation); output.word(adapter); output.word(answer.tag); output.word(answer.error);
        output.word(answer.host as i64 as u64); output.word(answer.value); output.word(answer.completed as i64 as u64);
        output.word(budget_a.remaining()); output.word(budget_b.remaining());
        output.word(script.calls as u64); output.word(script.index as u64);
        let byte: i32 = 0;
        while (byte < 32) { output.word(bytes[byte] as u64); byte += 1; }
        index += 1;
    }
}

fn main() -> i32 {
    let input_words: [i32; 144] = [0; 144];
    let input_pointer: ptr = core::mem::i32_array_data_ptr(input_words);
    let input: [u8] = core::mem::typed_slice_from_raw_parts<u8>(input_pointer, 576);
    let output_words: [i32; 1024] = [0; 1024];
    let output_pointer: ptr = core::mem::i32_array_data_ptr(output_words);
    let output_bytes: [u8] = core::mem::typed_slice_from_raw_parts<u8>(output_pointer, 4096);
    let output: Output = Output { bytes: output_bytes, pointer: output_pointer, used: 0 };
    while (read_exact(input_pointer, 64, true)) {
        assert(get64(input, 0) <= 1 && get64(input, 16) <= 16 && get64(input, 24) <= 8);
        let payload: i32 = (get64(input, 16) * 16 + get64(input, 24) * 32) as i32;
        assert(read_exact(input_pointer + 64, payload, false));
        run(input, output.borrow());
    }
    output.flush();
    return 0;
}
