module app::main;
import alloc::allocator;
import core::mem;
import std::fs;
import std::process;

fn main() -> i32 {
    let source_len: i32 = std::process::arg_len(1);
    if (source_len != 271) { return 1; }
    let buffer: ptr = alloc::allocator::alloc(272, 1);
    if (buffer == 0) { return 2; }
    if (std::process::arg_read(1, buffer, 272) != 271) { return 3; }
    // The argument ends in ".ignored"; use exactly the preceding 263 bytes.
    let bounded_len: usize = 263;
    let output: i32 = std::fs::open_write(buffer, bounded_len);
    if (output < 0) { return 4; }
    if (std::fs::write(output, core::mem::string_data_ptr("long"), 4) != 4) { return 5; }
    if (std::fs::close(output) != 0) { return 6; }
    let input: i32 = std::fs::open_read(buffer, bounded_len);
    if (input < 0) { return 7; }
    if (std::fs::close(input) != 0) { return 8; }
    alloc::allocator::dealloc(buffer, 272, 1);
    return 0;
}
