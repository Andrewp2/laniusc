// expect: 0
// Every std::map function through one generic checker over three distinct
// keys and three distinct values: existing-key insert, in-place set,
// order-preserving removal, reserve, shrink and clone. Keys and values of
// different types run for every integer width, char, total float keys, both wide integers
// and a record. Exits 0. On a failure it prints 100 * row + the failing check
// and exits with the row.
module app::main;

import core::cmp;
import core::float_order;
import core::wide_i64;
import core::wide_u64;
import std::map;

struct Point { x: i32, y: i32, z: i32 }

pub impl core::cmp::Eq<Point> for Point {
    pub fn eq(left: Point, right: Point) -> bool {
        return left.x == right.x && left.y == right.y && left.z == right.z;
    }
    pub fn ne(left: Point, right: Point) -> bool {
        return !Point::eq(left, right);
    }
}

// Ordinal `at` holds key and item.
fn entry<K, V>(items: std::map::Map<K, V>, at: i32, key: K, item: V, other_key: K, other: V) -> bool
    where K: core::cmp::Eq<K>, V: core::cmp::Eq<V> {
    return K::eq(std::map::key_at_or(items, at, other_key), key) &&
        V::eq(std::map::value_at_or(items, at, other), item);
}

// The keys are distinct and so are the values.
fn map_checks<K, V>(k1: K, k2: K, k3: K, v1: V, v2: V, v3: V) -> i32
    where K: core::cmp::Eq<K>, V: core::cmp::Eq<V> {
    let empty: std::map::Map<K, V> = std::map::new();
    if (!std::map::is_empty(empty) || std::map::len(empty) != 0 || std::map::capacity(empty) != 0 ||
        std::map::contains_key(empty, k1) || !V::eq(std::map::get_or(empty, k1, v3), v3) ||
        !K::eq(std::map::key_at_or(empty, 0, k2), k2) || !V::eq(std::map::value_at_or(empty, 0, v2), v2)) {
        return 1;
    }
    if (std::map::try_set(empty, k1, v1)) { return 2; }
    empty = std::map::try_remove(empty, k1);
    empty = std::map::try_reserve(empty, -1);
    if (std::map::capacity(empty) != 0) { return 3; }

    let items: std::map::Map<K, V> = std::map::try_reserve(empty, 1);
    if (std::map::capacity(items) != 1) { return 4; }
    items = std::map::try_insert(items, k2, v1);
    items = std::map::try_insert(items, k1, v2);
    items = std::map::try_insert(items, k2, v3);
    items = std::map::try_insert(items, k3, v3);
    if (std::map::len(items) != 3 || std::map::capacity(items) != 4 ||
        !entry(items, 0, k2, v1, k3, v3) || !entry(items, 1, k1, v2, k3, v3) ||
        !entry(items, 2, k3, v3, k1, v1)) {
        return 5;
    }
    if (!std::map::contains_key(items, k3) || !V::eq(std::map::get_or(items, k1, v3), v2) ||
        !K::eq(std::map::key_at_or(items, 3, k1), k1) || !V::eq(std::map::value_at_or(items, -1, v2), v2)) {
        return 6;
    }
    if (!std::map::try_set(items, k2, v2) || !V::eq(std::map::get_or(items, k2, v3), v2)) { return 7; }

    let copy: std::map::Map<K, V> = std::map::try_clone(items);
    if (std::map::len(copy) != 3 || std::map::capacity(copy) != 3 ||
        !std::map::try_set(copy, k1, v1) || !V::eq(std::map::get_or(items, k1, v3), v2)) {
        return 8;
    }
    std::map::destroy(copy);

    items = std::map::try_remove(items, k2);
    if (std::map::len(items) != 2 || std::map::contains_key(items, k2) ||
        !entry(items, 0, k1, v2, k3, v3) || !entry(items, 1, k3, v3, k1, v1)) {
        return 9;
    }
    items = std::map::try_shrink_to_fit(items);
    if (std::map::capacity(items) != 2 || !entry(items, 1, k3, v3, k1, v1)) { return 10; }
    items = std::map::clear(items);
    if (!std::map::is_empty(items) || std::map::capacity(items) != 2) { return 11; }
    items = std::map::try_shrink_to_fit(items);
    if (std::map::capacity(items) != 0) { return 12; }
    std::map::destroy(items);
    return 0;
}

fn row(index: i32, code: i32) -> i32 {
    if (code == 0) { return 0; }
    print(index * 100 + code);
    return index;
}

fn main() -> i32 {
    let i8_a: i8 = -128;
    let i8_b: i8 = 0;
    let i8_c: i8 = 127;
    let i16_a: i16 = -32768;
    let i16_b: i16 = 0;
    let i16_c: i16 = 32767;
    let i64_a: i64 = -9223372036854775808;
    let i64_b: i64 = 4294967296;
    let i64_c: i64 = 9223372036854775807;
    let u8_a: u8 = 0;
    let u8_b: u8 = 128;
    let u8_c: u8 = 255;
    let u16_a: u16 = 0;
    let u16_b: u16 = 32768;
    let u16_c: u16 = 65535;
    let u32_a: u32 = 0;
    let u32_b: u32 = 2147483648;
    let u32_c: u32 = 4294967295;
    let u64_a: u64 = 0;
    let u64_b: u64 = 4294967296;
    let u64_c: u64 = 18446744073709551615;
    let checks: [i32; 9] = [
        row(1, map_checks(-2147483648, 0, 2147483647, u8_a, u8_b, u8_c)),
        row(2, map_checks(i8_a, i8_b, i8_c, i16_a, i16_b, i16_c)),
        row(3, map_checks(i64_a, i64_b, i64_c, u64_a, u64_b, u64_c)),
        row(4, map_checks(u16_a, u16_b, u16_c, u32_a, u32_b, u32_c)),
        row(5, map_checks('\0', 'é', '😀', core::float_order::from_f32(-2.5), core::float_order::from_f32(0.0), core::float_order::from_f32(3.5))),
        row(6, map_checks(core::wide_i64::min_value(), core::wide_i64::zero(),
            core::wide_i64::max_value(), core::wide_u64::zero(), core::wide_u64::from_words(1, 0),
            core::wide_u64::max_value())),
        row(7, map_checks(Point { x: 1, y: 2, z: 3 }, Point { x: -1, y: 0, z: 0 },
            Point { x: 9, y: 9, z: 9 }, 'a', 'b', 'c')),
        row(8, map_checks(u32_a, u32_b, u32_c, Point { x: 1, y: 2, z: 3 }, Point { x: 4, y: 5, z: 6 },
            Point { x: 7, y: 8, z: 9 })),
        row(9, map_checks(u8_a, u8_b, u8_c, i64_a, i64_b, i64_c)),
    ];
    let index: i32 = 0;
    while (index < 9) {
        if (checks[index] != 0) { return checks[index]; }
        index += 1;
    }
    return 0;
}
