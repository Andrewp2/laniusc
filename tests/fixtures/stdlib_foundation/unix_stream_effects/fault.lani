// Finite injected failures. Invented positive transfer results are invalid,
// never evidence that bytes or descriptors actually crossed the kernel.
module app::main;
import core::io;
import core::mem;
import core::path;
import core::result;
import core::slice;
import std::io;
import std::socket;
struct Report { code:i32, value:i32, active:i32 }
fn error(value:core::io::Error) -> i32 {
    return match(value) { core::io::Error::InvalidInput->1,core::io::Error::InvalidCount->2,core::io::Error::Interrupted->3,core::io::Error::WouldBlock->4,core::io::Error::Host(n)->1000+n,_ ->9 };
}
fn result(value:core::result::Result<i32,core::io::Error>) -> Report {
    if(value.is_err()) { return Report { code:error(value.unwrap_err()),value:0,active:1 }; }
    return Report { code:0,value:value.unwrap(),active:1 };
}
fn close(stream:&std::socket::UnixStream) { stream.close().unwrap(); stream.close().unwrap(); assert(!stream.is_open()); }
fn endpoint(missing:bool) -> std::socket::UnixAddress {
    if(missing) {
        let bytes:[u8]=core::mem::typed_slice_from_raw_parts<u8>(core::mem::string_data_ptr("missing"),7);
        return std::socket::UnixAddress::Pathname(core::path::from_bytes(bytes,7).unwrap());
    }
    let bytes:[u8]=core::mem::typed_slice_from_raw_parts<u8>(core::mem::string_data_ptr("endpoint"),8);
    return std::socket::UnixAddress::Pathname(core::path::from_bytes(bytes,8).unwrap());
}
fn creation(pair:bool) -> Report {
    if(pair) {
        let created:core::result::Result<std::socket::UnixPair,core::io::Error> =std::socket::unix_pair(true);
        if(created.is_err()) { return Report { code:error(created.unwrap_err()),value:0,active:0 }; }
        let actual:std::socket::UnixPair=created.unwrap(); assert(actual.first.is_open() && actual.second.is_open());
        close(actual.first.borrow()); close(actual.second.borrow()); return Report { code:0,value:2,active:1 };
    }
    let created:core::result::Result<std::socket::UnixStream,core::io::Error> =std::socket::unix_stream(true);
    if(created.is_err()) { return Report { code:error(created.unwrap_err()),value:0,active:0 }; }
    let actual:std::socket::UnixStream=created.unwrap(); assert(actual.is_open()); close(actual.borrow()); return Report { code:0,value:1,active:1 };
}
fn clone_pair() -> Report {
    let pair:std::socket::UnixPair=std::socket::unix_pair(true).unwrap();
    let cloned:core::result::Result<std::socket::UnixStream,core::io::Error> =pair.first.try_clone();
    let out:Report=Report { code:0,value:1,active:1 };
    if(cloned.is_err()) { out.code=error(cloned.unwrap_err()); out.value=0; }
    else { let actual:std::socket::UnixStream=cloned.unwrap(); assert(actual.raw_handle().unwrap()!=pair.first.raw_handle().unwrap()); close(actual.borrow()); }
    assert(pair.first.is_open() && pair.second.is_open()); close(pair.first.borrow()); close(pair.second.borrow()); return out;
}
fn single(mode:i32) -> Report {
    let stream:std::socket::UnixStream=std::socket::unix_stream(true).unwrap();
    let out:Report=Report { code:0,value:0,active:1 };
    if(mode==3) { out=result(stream.connect(endpoint(true))); }
    if(mode==4) { out=result(stream.bind(endpoint(false))); }
    if(mode==5 || mode==6) {
        stream.bind(endpoint(false)).unwrap();
        if(mode==5) { out=result(stream.listen(2)); }
        else {
            stream.listen(2).unwrap();
            let accepted:core::result::Result<std::socket::UnixStream,core::io::Error> =stream.accept(true);
            // There is no connecting client. Only real WouldBlock or an
            // injected error/malformed full-width descriptor may be returned.
            assert(accepted.is_err()); out.code=error(accepted.unwrap_err());
        }
    }
    if(mode==9) {
        out=result(stream.close()); out.active=0;
        assert(!stream.is_open() && stream.raw_handle().is_none() && stream.take_handle().is_none());
        assert(stream.close().unwrap()==0 && error(stream.try_clone().unwrap_err())==1009);
        let empty:[u8;1]=[211]; assert(error(stream.send(core::slice::view<u8>(empty,0).unwrap()).unwrap_err())==1009);
        // Injected close errors/statuses skip the kernel call. The wrapper is
        // still retired, and the actual descriptor lives until process exit.
        return out;
    }
    if(mode==10) {
        let flags:core::result::Result<bool,core::io::Error> =stream.is_nonblocking();
        if(flags.is_err()) { out.code=error(flags.unwrap_err()); }
        else { assert(flags.unwrap()); out.value=1; }
    }
    assert(stream.is_open()); close(stream.borrow()); return out;
}
fn data(mode:i32) -> Report {
    let pair:std::socket::UnixPair=std::socket::unix_pair(true).unwrap();
    let source:[u8;8]=[211,211,0,128,255,7,211,211]; let destination:[u8;8]=[211;8];
    let input:core::slice::View<u8> =core::slice::view_range<u8>(source,2,4).unwrap();
    let output:core::slice::View<u8> =core::slice::view_range<u8>(destination,2,4).unwrap();
    let out:Report=Report { code:0,value:0,active:1 };
    if(mode==7) {
        out=result(pair.first.send(input));
        let observed:core::result::Result<i32,core::io::Error> =pair.second.receive(output);
        if(out.code==0) { assert(out.value==4 && observed.unwrap()==4); }
        else { assert(error(observed.unwrap_err())==4); }
    }
    if(mode==8) {
        assert(pair.second.send(input).unwrap()==4);
        out=result(pair.first.receive(output));
        if(out.code==0) { assert(out.value==4); }
        else {
            let i:i32=0; while(i<8) { assert(destination[i]==211); i+=1; }
            // The injection skipped the first receive; explicitly verify
            // its queued bytes using a separate, subsequent call and buffer.
            let recovered:[u8;8]=[211;8];
            assert(pair.first.receive(core::slice::view_range<u8>(recovered,2,4).unwrap()).unwrap()==4);
            i=0; while(i<8) { assert(recovered[i]==source[i] && destination[i]==211); i+=1; }
        }
    }
    if(mode==11) {
        out=result(pair.first.shutdown(std::socket::Shutdown::Write));
        let observed:core::result::Result<i32,core::io::Error> =pair.second.receive(output);
        if(out.code==0) { assert(observed.unwrap()==0); }
        else { assert(error(observed.unwrap_err())==4); }
    }
    if(mode==12) {
        let ready:core::result::Result<std::socket::Ready,core::io::Error> =pair.first.wait_ms(false,true,0);
        if(ready.is_err()) { out.code=error(ready.unwrap_err()); }
        else { assert(ready.unwrap().writable && !ready.unwrap().timed_out); out.value=1; }
    }
    let i:i32=0; while(i<8) {
        let expected:u8=211;
        if((mode==7 || mode==8) && out.code==0) { expected=source[i]; }
        assert(destination[i]==expected); i+=1;
    }
    assert(source[0]==211 && source[1]==211 && source[2]==0 && source[3]==128 && source[4]==255 && source[5]==7 && source[6]==211 && source[7]==211);
    assert(pair.first.is_open() && pair.second.is_open()); close(pair.first.borrow()); close(pair.second.borrow()); return out;
}
fn main() -> i32 {
    let input:[i32;1]=[0]; assert(std::io::read_stdin(core::mem::i32_array_data_ptr(input),1)==1);
    let mode:i32=input[0]; assert(mode>=0 && mode<=12);
    let out:Report=Report { code:0,value:0,active:0 };
    if(mode==0 || mode==1) { out=creation(mode==1); }
    else { if(mode==2) { out=clone_pair(); }
    else { if(mode==7 || mode==8 || mode==11 || mode==12) { out=data(mode); }
    else { out=single(mode); } } }
    let report:[i32;3]=[out.code,out.value,out.active];
    assert(std::io::write_stdout(core::mem::i32_array_data_ptr(report),12)==12); return 0;
}
