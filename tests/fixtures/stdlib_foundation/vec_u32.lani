module app::main;
import std::vec_u32;

fn main() -> i32 {
    let zero: u32 = 0;
    let one: u32 = 1;
    let high_bit: u32 = 2147483648;
    let maximum: u32 = 4294967295;
    let fallback: u32 = 777;
    let value: std::vec_u32::VecU32 = std::vec_u32::new();
    let empty_copy: std::vec_u32::VecU32 = std::vec_u32::try_clone(value);
    if (std::vec_u32::len(empty_copy) != 0 || std::vec_u32::capacity(empty_copy) != 0) { return 22; }
    std::vec_u32::destroy(empty_copy);
    if (std::vec_u32::len(value) != 0 ||
        std::vec_u32::capacity(value) != 0 ||
        !std::vec_u32::is_empty(value) ||
        std::vec_u32::get_or(value, 0, fallback) != fallback ||
        std::vec_u32::try_set(value, 0, maximum)) { return 1; }
    value = std::vec_u32::try_pop(value);
    if (std::vec_u32::len(value) != 0) { return 2; }

    value = std::vec_u32::try_push(value, zero);
    value = std::vec_u32::try_push(value, high_bit);
    value = std::vec_u32::try_push(value, maximum);
    value = std::vec_u32::try_push(value, one);
    if (std::vec_u32::len(value) != 4 ||
        std::vec_u32::capacity(value) != 4 ||
        std::vec_u32::get_or(value, 0, fallback) != zero ||
        std::vec_u32::get_or(value, 1, fallback) != high_bit ||
        std::vec_u32::get_or(value, 2, fallback) != maximum ||
        std::vec_u32::get_or(value, -1, fallback) != fallback ||
        std::vec_u32::get_or(value, 4, fallback) != fallback) { return 3; }
    value = std::vec_u32::try_push(value, high_bit);
    if (std::vec_u32::len(value) != 5 ||
        std::vec_u32::capacity(value) != 8 ||
        std::vec_u32::get_or(value, 4, fallback) != high_bit) { return 4; }
    let copy: std::vec_u32::VecU32 = std::vec_u32::try_clone(value);
    if (std::vec_u32::len(copy) != 5 || std::vec_u32::capacity(copy) != 5 ||
        std::vec_u32::get_or(copy, 1, fallback) != high_bit ||
        std::vec_u32::get_or(copy, 2, fallback) != maximum) { return 23; }
    if (!std::vec_u32::try_set(copy, 1, one) ||
        std::vec_u32::get_or(copy, 1, fallback) != one ||
        std::vec_u32::get_or(value, 1, fallback) != high_bit) { return 24; }
    std::vec_u32::destroy(copy);
    if (std::vec_u32::try_set(value, -1, maximum) ||
        std::vec_u32::try_set(value, 5, maximum) ||
        !std::vec_u32::try_set(value, 1, maximum) ||
        std::vec_u32::get_or(value, 1, fallback) != maximum) { return 5; }

    value = std::vec_u32::try_reserve(value, -1);
    value = std::vec_u32::try_reserve(value, 536870912);
    value = std::vec_u32::try_reserve(value, 2);
    if (std::vec_u32::capacity(value) != 8) { return 6; }
    value = std::vec_u32::try_reserve(value, 11);
    if (std::vec_u32::capacity(value) != 11 ||
        std::vec_u32::get_or(value, 1, fallback) != maximum ||
        std::vec_u32::get_or(value, 4, fallback) != high_bit) { return 7; }
    value = std::vec_u32::try_pop(value);
    if (std::vec_u32::len(value) != 4 ||
        std::vec_u32::get_or(value, 4, fallback) != fallback) { return 8; }
    value = std::vec_u32::clear(value);
    if (std::vec_u32::len(value) != 0 ||
        std::vec_u32::capacity(value) != 11 ||
        !std::vec_u32::is_empty(value)) { return 9; }
    value = std::vec_u32::try_push(value, maximum);
    if (std::vec_u32::get_or(value, 0, fallback) != maximum) { return 10; }
    std::vec_u32::destroy(value);

    let preallocated: std::vec_u32::VecU32 = std::vec_u32::try_with_capacity(2);
    if (std::vec_u32::capacity(preallocated) != 2) { return 11; }
    preallocated = std::vec_u32::try_push(preallocated, high_bit);
    if (std::vec_u32::get_or(preallocated, 0, fallback) != high_bit) { return 12; }
    std::vec_u32::destroy(preallocated);
    let invalid: std::vec_u32::VecU32 = std::vec_u32::try_with_capacity(-1);
    if (std::vec_u32::capacity(invalid) != 0) { return 13; }
    std::vec_u32::destroy(invalid);
    if (std::vec_u32::MAX_CAPACITY != 536870911) { return 14; }
    return 0;
}
