// A successful leaf owns its String; rejected leaves free their own partial.
module fixture::leaf;
import alloc::string;
import core::clone;
import core::result;

pub struct Leaf { text: alloc::string::String, tag: i32, fail: i32 }
pub struct Payload { wide: u64, cells: [i32;2], message: alloc::string::String }
pub enum Fault<P> { Allocation(alloc::string::Error), Rejected(i32,i32,P) }

fn failure(tag: i32, stage: i32) -> Fault<Payload> {
    let bytes: [u8;5] = [69,0,(48+tag) as u8,(48+stage) as u8,85];
    let made = alloc::string::from_utf8(bytes,5);
    if (made.is_err()) { return Fault::Allocation(made.unwrap_err()); }
    let cells: [i32;2] = [tag,stage];
    return Fault::Rejected(tag,stage,Payload { wide: 18446744073709551615-(tag as u64), cells: cells, message: made.unwrap() });
}
pub impl core::clone::TryClone<Leaf,Fault<Payload>> for Leaf {
    pub fn try_clone_value(source: Leaf) -> core::result::Result<Leaf,Fault<Payload>> {
        if (source.fail == 0) { return core::result::Err(failure(source.tag,0)); }
        let made = source.text.try_clone();
        if (made.is_err()) { return core::result::Err(Fault::Allocation(made.unwrap_err())); }
        let partial: alloc::string::String = made.unwrap();
        if (source.fail == 1) {
            let error: Fault<Payload> = failure(source.tag,1);
            partial.destroy();
            return core::result::Err(error);
        }
        return core::result::Ok(Leaf { text: partial, tag: source.tag, fail: -1 });
    }
}
pub impl core::clone::Destroy<Leaf> for Leaf {
    pub fn destroy_value(owned: Leaf) { owned.text.destroy(); }
}
