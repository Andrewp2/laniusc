module app::main;
import core::option_i32;
import core::option_wide_u64;
import core::result_wide_u64;
import core::wide_u64;

fn main() -> i32 {
    let zero: core::wide_u64::WideU64 = core::wide_u64::zero();
    let ordinary: core::wide_u64::WideU64 = core::wide_u64::from_u32(42);
    let maximum: core::wide_u64::WideU64 = core::wide_u64::max_value();
    let high: core::wide_u64::WideU64 = core::wide_u64::from_words(2147483648, 0);
    let present: core::option_wide_u64::OptionWideU64 =
        core::option_wide_u64::some(maximum);
    let absent: core::option_wide_u64::OptionWideU64 = core::option_wide_u64::none();
    if (!core::option_wide_u64::is_some(present) ||
        core::option_wide_u64::is_some(absent) ||
        core::option_wide_u64::is_none(present) ||
        !core::option_wide_u64::is_none(absent) ||
        !core::option_wide_u64::contains(present, maximum) ||
        core::option_wide_u64::contains(present, high) ||
        core::option_wide_u64::contains(absent, zero) ||
        !core::option_wide_u64::contains(
            core::option_wide_u64::some(ordinary), ordinary)) { return 1; }
    if (!core::wide_u64::eq(core::option_wide_u64::unwrap_or(present, zero), maximum) ||
        !core::wide_u64::eq(core::option_wide_u64::unwrap_or(absent, high), high) ||
        !core::option_wide_u64::contains(core::option_wide_u64::some(zero), zero)) {
        return 2;
    }
    if (!core::option_wide_u64::contains(
            core::option_wide_u64::or(present, absent), maximum) ||
        !core::option_wide_u64::contains(
            core::option_wide_u64::or(absent, present), maximum) ||
        !core::option_wide_u64::is_none(
            core::option_wide_u64::or(absent, absent)) ||
        !core::option_wide_u64::contains(
            core::option_wide_u64::and(present, core::option_wide_u64::some(high)), high) ||
        !core::option_wide_u64::is_none(
            core::option_wide_u64::and(absent, present)) ||
        !core::option_wide_u64::is_none(
            core::option_wide_u64::and(present, absent))) { return 3; }
    if (!core::option_wide_u64::is_none(
            core::option_wide_u64::xor(present, present)) ||
        !core::option_wide_u64::is_none(
            core::option_wide_u64::xor(absent, absent)) ||
        !core::option_wide_u64::contains(
            core::option_wide_u64::xor(present, absent), maximum) ||
        !core::option_wide_u64::contains(
            core::option_wide_u64::xor(absent, present), maximum)) { return 4; }

    let success: core::result_wide_u64::ResultWideU64 =
        core::result_wide_u64::ok(maximum);
    let failure: core::result_wide_u64::ResultWideU64 =
        core::result_wide_u64::err(-123);
    if (!core::result_wide_u64::is_ok(success) ||
        core::result_wide_u64::is_ok(failure) ||
        core::result_wide_u64::is_err(success) ||
        !core::result_wide_u64::is_err(failure) ||
        !core::result_wide_u64::contains(success, maximum) ||
        core::result_wide_u64::contains(success, high) ||
        core::result_wide_u64::contains(failure, zero) ||
        !core::result_wide_u64::contains(
            core::result_wide_u64::ok(ordinary), ordinary) ||
        !core::result_wide_u64::contains_err(failure, -123) ||
        core::result_wide_u64::contains_err(failure, 0) ||
        core::result_wide_u64::contains_err(success, 0)) { return 5; }
    if (!core::wide_u64::eq(
            core::result_wide_u64::unwrap_or(success, zero), maximum) ||
        !core::wide_u64::eq(
            core::result_wide_u64::unwrap_or(failure, high), high) ||
        core::result_wide_u64::unwrap_err_or(success, 77) != 77 ||
        core::result_wide_u64::unwrap_err_or(failure, 77) != -123 ||
        !core::result_wide_u64::contains(core::result_wide_u64::ok(zero), zero) ||
        !core::result_wide_u64::contains_err(core::result_wide_u64::err(0), 0)) {
        return 6;
    }
    if (!core::result_wide_u64::contains(
            core::result_wide_u64::or(success, failure), maximum) ||
        !core::result_wide_u64::contains(
            core::result_wide_u64::or(failure, success), maximum) ||
        !core::result_wide_u64::contains_err(
            core::result_wide_u64::or(failure, failure), -123) ||
        !core::result_wide_u64::contains_err(
            core::result_wide_u64::and(success, failure), -123) ||
        !core::result_wide_u64::contains_err(
            core::result_wide_u64::and(failure, success), -123) ||
        !core::result_wide_u64::contains(
            core::result_wide_u64::and(success, success), maximum)) { return 7; }
    if (!core::result_wide_u64::contains(
            core::option_wide_u64::ok_or(present, 9), maximum) ||
        !core::result_wide_u64::contains_err(
            core::option_wide_u64::ok_or(absent, -9), -9) ||
        !core::option_wide_u64::contains(
            core::option_wide_u64::ok(success), maximum) ||
        !core::option_wide_u64::is_none(core::option_wide_u64::ok(failure)) ||
        !core::option_i32::is_none(core::option_wide_u64::err(success)) ||
        !core::option_i32::contains(core::option_wide_u64::err(failure), -123)) {
        return 8;
    }
    return 0;
}
