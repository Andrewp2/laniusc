module app::main;
import core::wide_i64;
import std::vec_wide_i64;
fn main() -> i32 {
    let value: std::vec_wide_i64::VecWideI64 = std::vec_wide_i64::new();
    value = std::vec_wide_i64::try_push(value, core::wide_i64::min_value());
    if (std::vec_wide_i64::len(value) == 0 && std::vec_wide_i64::capacity(value) == 0) {
        return 0;
    }
    std::vec_wide_i64::destroy(value);
    return 1;
}
