// Full-width signed order over owned paired-word storage.
module app::main;
import core::wide_i64;
import core::wide_word_cells;
import std::vec_wide_i64;

fn main() -> i32 {
    let direct: [i32; 6] = [-1, -1, 0, 0, 0, -2147483648];
    if (core::wide_word_cells::sort(direct, 3, true) != 3 ||
        direct[0] != 0 || direct[1] != -2147483648 ||
        direct[2] != -1 || direct[3] != -1 ||
        direct[4] != 0 || direct[5] != 0) { return 1; }
    if (core::wide_word_cells::lower_bound(direct, 3, -1, -1, true) != 1 ||
        core::wide_word_cells::upper_bound(direct, 3, -1, -1, true) != 2) { return 2; }
    if (core::wide_word_cells::reverse_in_place(direct, 3) != 1 ||
        direct[0] != 0 || direct[1] != 0 ||
        direct[4] != 0 || direct[5] != -2147483648) { return 3; }

    let high_bit: u32 = 2147483648;
    let maximum_word: u32 = 4294967295;
    let zero: core::wide_i64::WideI64 = core::wide_i64::zero();
    let minimum: core::wide_i64::WideI64 = core::wide_i64::from_words(high_bit, 0);
    let negative_one: core::wide_i64::WideI64 = core::wide_i64::from_words(maximum_word, maximum_word);
    let boundary: core::wide_i64::WideI64 = core::wide_i64::from_words(1, 0);
    let maximum: core::wide_i64::WideI64 = core::wide_i64::from_words(2147483647, maximum_word);
    let empty: std::vec_wide_i64::VecWideI64 = std::vec_wide_i64::new();
    if (std::vec_wide_i64::sort_in_place(empty) != 0 ||
        std::vec_wide_i64::reverse_in_place(empty) != 0 ||
        std::vec_wide_i64::lower_bound(empty, minimum) != 0 ||
        std::vec_wide_i64::upper_bound(empty, minimum) != 0 ||
        std::vec_wide_i64::binary_search_first_or(empty, minimum, -9) != -9 ||
        std::vec_wide_i64::binary_search_last_or(empty, minimum, -7) != -7) { return 4; }
    std::vec_wide_i64::destroy(empty);

    let single: std::vec_wide_i64::VecWideI64 = std::vec_wide_i64::try_with_capacity(2);
    single = std::vec_wide_i64::try_push(single, minimum);
    if (std::vec_wide_i64::len(single) != 1 ||
        std::vec_wide_i64::sort_in_place(single) != 1 ||
        std::vec_wide_i64::reverse_in_place(single) != 0 ||
        std::vec_wide_i64::lower_bound(single, minimum) != 0 ||
        std::vec_wide_i64::upper_bound(single, minimum) != 1 ||
        std::vec_wide_i64::binary_search_first_or(single, minimum, -1) != 0 ||
        std::vec_wide_i64::binary_search_last_or(single, maximum, -1) != -1 ||
        std::vec_wide_i64::capacity(single) != 2) { return 5; }
    std::vec_wide_i64::destroy(single);

    let owned: std::vec_wide_i64::VecWideI64 = std::vec_wide_i64::new();
    owned = std::vec_wide_i64::try_push(owned, maximum);
    owned = std::vec_wide_i64::try_push(owned, minimum);
    owned = std::vec_wide_i64::try_push(owned, negative_one);
    owned = std::vec_wide_i64::try_push(owned, zero);
    owned = std::vec_wide_i64::try_push(owned, negative_one);
    owned = std::vec_wide_i64::try_push(owned, boundary);
    owned = std::vec_wide_i64::try_push(owned, minimum);
    owned = std::vec_wide_i64::try_push(owned, maximum);
    if (std::vec_wide_i64::len(owned) != 8 ||
        std::vec_wide_i64::capacity(owned) != 8) { return 6; }
    if (std::vec_wide_i64::sort_in_place(owned) != 8 ||
        !core::wide_i64::eq(std::vec_wide_i64::get_or(owned, 0, zero), minimum) ||
        !core::wide_i64::eq(std::vec_wide_i64::get_or(owned, 1, zero), minimum) ||
        !core::wide_i64::eq(std::vec_wide_i64::get_or(owned, 2, zero), negative_one) ||
        !core::wide_i64::eq(std::vec_wide_i64::get_or(owned, 3, zero), negative_one) ||
        !core::wide_i64::eq(std::vec_wide_i64::get_or(owned, 4, minimum), zero) ||
        !core::wide_i64::eq(std::vec_wide_i64::get_or(owned, 5, zero), boundary) ||
        !core::wide_i64::eq(std::vec_wide_i64::get_or(owned, 6, zero), maximum) ||
        !core::wide_i64::eq(std::vec_wide_i64::get_or(owned, 7, zero), maximum)) { return 7; }
    if (std::vec_wide_i64::lower_bound(owned, minimum) != 0 ||
        std::vec_wide_i64::upper_bound(owned, minimum) != 2 ||
        std::vec_wide_i64::lower_bound(owned, negative_one) != 2 ||
        std::vec_wide_i64::upper_bound(owned, negative_one) != 4 ||
        std::vec_wide_i64::lower_bound(owned, zero) != 4 ||
        std::vec_wide_i64::upper_bound(owned, zero) != 5 ||
        std::vec_wide_i64::upper_bound(owned, maximum) != 8) { return 8; }
    if (std::vec_wide_i64::binary_search_first_or(owned, negative_one, -1) != 2 ||
        std::vec_wide_i64::binary_search_last_or(owned, negative_one, -1) != 3 ||
        std::vec_wide_i64::binary_search_first_or(owned, maximum, -1) != 6 ||
        std::vec_wide_i64::binary_search_last_or(owned, maximum, -1) != 7 ||
        std::vec_wide_i64::binary_search_first_or(owned, core::wide_i64::from_i32(1), -12) != -12 ||
        std::vec_wide_i64::binary_search_last_or(owned, core::wide_i64::from_i32(-2), -13) != -13) { return 9; }
    if (std::vec_wide_i64::reverse_in_place(owned) != 4 ||
        !core::wide_i64::eq(std::vec_wide_i64::get_or(owned, 0, zero), maximum) ||
        !core::wide_i64::eq(std::vec_wide_i64::get_or(owned, 7, zero), minimum)) { return 10; }
    if (std::vec_wide_i64::sort_in_place(owned) != 8 ||
        std::vec_wide_i64::binary_search_last_or(owned, negative_one, -1) != 3 ||
        std::vec_wide_i64::capacity(owned) != 8) { return 11; }
    std::vec_wide_i64::destroy(owned);
    return 0;
}
