module app::main;
import core::five;
import std::io;

struct Pair { number: i32, text: str }
fn first<T>(value: core::five::ArrayField<T>) -> T { return value.items[0]; }
fn first_view<T>(value: core::five::SliceField<T>) -> T { return value.items[0]; }
fn fixed_first<A, B>(value: core::five::ReorderedFields<A, B>) -> B { return value.fixed[0]; }
fn borrowed_first<A, B>(value: core::five::ReorderedFields<A, B>) -> A { return value.borrowed[0]; }
fn integer_view(value: [i32]) -> [i32] { return value; }
fn text_view(value: [str]) -> [str] { return value; }

fn main() -> i32 {
    let numbers: core::five::ArrayField<i32> = core::five::ArrayField { items: [-7, 42] };
    if (first(numbers) != -7 || numbers.items[1] != 42) { return 1; }
    let original: core::five::ArrayField<i32> = numbers;
    let replacement: [i32; 2] = [42, -7];
    numbers.items = replacement;
    if (numbers.items[0] != 42 || numbers.items[1] != -7 || original.items[0] != -7) { return 2; }
    replacement[0] = 99;
    if (numbers.items[0] != 42) { return 3; }

    let flags: core::five::ArrayField<bool> = core::five::ArrayField { items: [false, true] };
    if (first(flags) || !flags.items[1]) { return 4; }
    flags.items = [true, false];
    if (!first(flags) || flags.items[1]) { return 5; }
    let high: u32 = 4294967295;
    let zero: u32 = 0;
    let unsigned: core::five::ArrayField<u32> = core::five::ArrayField { items: [high, zero] };
    if (first(unsigned) != 4294967295 || unsigned.items[1] != 0) { return 6; }
    let floating: core::five::ArrayField<f32> = core::five::ArrayField { items: [2.5, -0.0] };
    if (first(floating) != 2.5 || floating.items[1] != 0.0) { return 7; }
    let characters: core::five::ArrayField<char> = core::five::ArrayField { items: ['Ω', 'x'] };
    if (first(characters) != 'Ω' || characters.items[1] != 'x') { return 8; }

    let strings: core::five::ArrayField<str> = core::five::ArrayField { items: ["Ω", ""] };
    if (std::io::println(first(strings)) != 3 || std::io::println(strings.items[1]) != 1) { return 9; }
    let string_original: core::five::ArrayField<str> = strings;
    strings.items = ["", "changed"];
    if (std::io::println(strings.items[0]) != 1 || std::io::println(strings.items[1]) != 8 ||
        std::io::println(string_original.items[0]) != 3) { return 10; }

    let one: Pair = Pair { number: -7, text: "Ω" };
    let two: Pair = Pair { number: 42, text: "" };
    let pairs: core::five::ArrayField<Pair> = core::five::ArrayField { items: [one, two] };
    let selected: Pair = first(pairs);
    if (selected.number != -7 || std::io::println(selected.text) != 3 || pairs.items[1].number != 42) { return 11; }
    selected.text = "changed";
    selected.number = 99;
    if (pairs.items[0].number != -7 || std::io::println(pairs.items[0].text) != 3) { return 12; }
    let swapped_pairs: [Pair; 2] = [two, one];
    pairs.items = swapped_pairs;
    if (pairs.items[0].number != 42 || pairs.items[1].number != -7 || std::io::println(pairs.items[1].text) != 3) { return 13; }

    let words: [str; 2] = ["Ω", ""];
    let other_words: [str; 2] = ["", "Ω"];
    let arrays: core::five::ArrayField<[str; 2]> = core::five::ArrayField { items: [words, other_words] };
    let selected_array: [str; 2] = first(arrays);
    if (std::io::println(selected_array[0]) != 3 || std::io::println(selected_array[1]) != 1 ||
        std::io::println(arrays.items[1][1]) != 3) { return 14; }
    selected_array[0] = "changed";
    if (std::io::println(arrays.items[0][0]) != 3) { return 15; }

    let data: [i32; 2] = [-7, 42];
    let empty_data: [i32; 0] = [];
    let views: core::five::ArrayField<[i32]> = core::five::ArrayField {
        items: [integer_view(data), integer_view(empty_data)]
    };
    let selected_view: [i32] = first(views);
    if (selected_view[0] != -7 || selected_view[1] != 42) { return 16; }
    selected_view[0] = 9;
    if (data[0] != 9 || views.items[0][0] != 9) { return 17; }

    let borrowed: core::five::SliceField<i32> = core::five::SliceField {
        items: integer_view(data), sentinel: 123
    };
    if (first_view(borrowed) != 9 || borrowed.items[1] != 42 || borrowed.sentinel != 123) { return 18; }
    borrowed.items[1] = -9;
    if (data[1] != -9) { return 19; }
    borrowed.items = integer_view(empty_data);
    if (borrowed.sentinel != 123) { return 20; }

    let borrowed_text: core::five::SliceField<str> = core::five::SliceField {
        items: text_view(words), sentinel: -456
    };
    if (std::io::println(first_view(borrowed_text)) != 3 || borrowed_text.sentinel != -456) { return 21; }
    borrowed_text.items[1] = "changed";
    if (std::io::println(words[1]) != 8) { return 22; }

    let nested: core::five::NestedField<str> = core::five::NestedField {
        child: core::five::ArrayField { items: ["Ω", ""] }, sentinel: 789
    };
    if (std::io::println(nested.child.items[0]) != 3 || nested.sentinel != 789) { return 23; }
    nested.child.items = ["", "Ω"];
    if (std::io::println(nested.child.items[1]) != 3 || nested.sentinel != 789) { return 24; }

    let reordered: core::five::ReorderedFields<str, i32> = core::five::ReorderedFields {
        fixed: [-7, 42], borrowed: text_view(words), sentinel: -987
    };
    if (reordered.fixed[0] != -7 || reordered.fixed[1] != 42 ||
        std::io::println(reordered.borrowed[1]) != 8 || reordered.sentinel != -987) { return 25; }
    let fixed_copy: [i32; 2] = reordered.fixed;
    if (fixed_first(reordered) != -7 || fixed_copy[0] != -7 || fixed_copy[1] != 42 ||
        std::io::println(borrowed_first(reordered)) != 3) { return 27; }
    fixed_copy[0] = 99;
    if (reordered.fixed[0] != -7) { return 28; }
    reordered.fixed = [42, -7];
    reordered.borrowed[0] = "changed";
    if (reordered.fixed[1] != -7 || std::io::println(words[0]) != 8 || reordered.sentinel != -987) { return 26; }
    return 0;
}
