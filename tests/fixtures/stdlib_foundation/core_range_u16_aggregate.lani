module app::main;
import core::range;

fn main() -> i32 {
    let start: u16 = 32768;
    let middle: u16 = 50000;
    let end: u16 = 60000;
    let maximum: u16 = 65535;
    let half: core::range::Range<u16> = core::range::range(start, end);
    let overlap: core::range::Range<u16> = core::range::range(middle, maximum);
    let touch: core::range::Range<u16> = core::range::range(end, maximum);
    let reversed: core::range::Range<u16> = core::range::range(end, start);
    if (core::range::start(half) != start ||
        core::range::end(half) != end) { return 1; }
    if (core::range::is_empty(half) ||
        !core::range::is_empty(reversed)) { return 2; }
    if (!core::range::contains(half, start) ||
        !core::range::contains(half, middle) ||
        core::range::contains(half, end)) { return 3; }
    if (!core::range::overlaps(half, overlap) ||
        core::range::overlaps(half, touch) ||
        core::range::overlaps(half, reversed)) { return 4; }

    let closed: core::range::RangeInclusive<u16> = core::range::range_inclusive(start, end);
    let closed_touch: core::range::RangeInclusive<u16> = core::range::range_inclusive(end, maximum);
    let closed_reversed: core::range::RangeInclusive<u16> = core::range::range_inclusive(end, start);
    if (core::range::start_inclusive(closed) != start ||
        core::range::end_inclusive(closed) != end) { return 5; }
    if (core::range::is_empty_inclusive(closed) ||
        !core::range::is_empty_inclusive(closed_reversed)) { return 6; }
    if (!core::range::contains_inclusive(closed, start) ||
        !core::range::contains_inclusive(closed, end) ||
        core::range::contains_inclusive(closed, maximum)) { return 7; }
    if (!core::range::overlaps_inclusive(closed, closed_touch) ||
        core::range::overlaps_inclusive(closed, closed_reversed)) { return 8; }

    let from: core::range::RangeFrom<u16> = core::range::range_from(middle);
    if (core::range::start_from(from) != middle ||
        core::range::contains_from(from, start) ||
        !core::range::contains_from(from, maximum)) { return 9; }
    let to: core::range::RangeTo<u16> = core::range::range_to(end);
    if (core::range::end_to(to) != end ||
        !core::range::contains_to(to, middle) ||
        core::range::contains_to(to, end)) { return 10; }
    if (half.start() != start || half.end() != end ||
        half.is_empty() || !reversed.is_empty()) { return 11; }
    if (!half.contains(start) || !half.contains(middle) ||
        half.contains(end) || !half.overlaps(overlap) ||
        half.overlaps(touch) || half.overlaps(reversed)) { return 12; }
    if (closed.start() != start || closed.end() != end ||
        closed.is_empty() || !closed_reversed.is_empty()) { return 13; }
    if (!closed.contains(start) || !closed.contains(end) ||
        closed.contains(maximum) || !closed.overlaps(closed_touch) ||
        closed.overlaps(closed_reversed)) { return 14; }
    if (from.start() != middle || from.contains(start) ||
        !from.contains(maximum)) { return 15; }
    if (to.end() != end || !to.contains(middle) ||
        to.contains(end)) { return 16; }
    return 0;
}
