module app::main;
import std::deque;

fn main() -> i32 {
    let value: std::deque::Deque<i32> = std::deque::try_with_capacity(3);
    if (std::deque::capacity(value) != 3) { return 5; }
    value = std::deque::try_push_back(value, 7);
    value = std::deque::try_push_back(value, 8);
    value = std::deque::try_push_back(value, 9);
    value = std::deque::try_pop_front(value);
    value = std::deque::try_push_back(value, 10);
    let copy: std::deque::Deque<i32> = std::deque::try_clone(value);
    let intact: bool = std::deque::len(value) == 3 &&
        std::deque::at_or(value, 0, 0) == 8 &&
        std::deque::at_or(value, 1, 0) == 9 &&
        std::deque::at_or(value, 2, 0) == 10;
    let failure: bool = intact && std::deque::len(copy) == 0 &&
        std::deque::capacity(copy) == 0;
    let success: bool = intact && std::deque::len(copy) == 3 &&
        std::deque::capacity(copy) == 3 &&
        std::deque::at_or(copy, 0, 0) == 8 &&
        std::deque::at_or(copy, 1, 0) == 9 &&
        std::deque::at_or(copy, 2, 0) == 10;
    std::deque::destroy(copy);
    std::deque::destroy(value);
    if (failure) { return 0; }
    if (success) { return 4; }
    return 5;
}
