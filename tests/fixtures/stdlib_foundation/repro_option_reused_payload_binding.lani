module app::main;
import core::option;
fn main() -> i32 {
    let first: core::option::Option<i32> = core::option::Some(7);
    let second: core::option::Option<i32> = core::option::Some(9);
    let left: i32 = match (first) { core::option::Some(inner) -> inner, core::option::None -> 0 };
    let right: i32 = match (second) { core::option::Some(inner) -> inner, core::option::None -> 0 };
    if (left != 7 || right != 9) { return 1; }
    return 0;
}
