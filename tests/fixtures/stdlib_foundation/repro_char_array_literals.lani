module app::main;
import core::slice;
fn main() -> i32 {
    let values:[char; 3] =['A', 'é', '🦀'];
    if (values[0] != 'A' || values[1] != 'é' || values[2] != '🦀') {
        return 1;
    }
    if (core::slice::get_or(values, 3, 1, '?') != 'é') {
        return 2;
    }
    if (!core::slice::set(values, 3, 0, '𝄞')) {
        return 3;
    }
    if (values[0] != '𝄞' || core::slice::get_or(values, 3, 0, '?') != '𝄞') {
        return 4;
    }
    return 0;
}
