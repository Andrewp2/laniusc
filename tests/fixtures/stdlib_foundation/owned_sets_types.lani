    core::result::unwrap(tree.try_insert(low)); core::result::unwrap(tree.try_insert(high));
    let valid: bool = hash.len() == 2 && tree.len() == 2 && T::eq(core::option::unwrap(tree.first()), low) && T::eq(core::option::unwrap(tree.last()), high) && T::eq(core::option::unwrap(hash.remove(low)), low) && T::eq(core::option::unwrap(tree.pop_first()), low) && hash.contains(high) && tree.contains(high);
    hash.destroy(); tree.destroy(); return valid;
}
