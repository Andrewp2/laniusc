module app::main;
import core::relay;
import std::io;

struct Pair { number: i32, text: str }
fn borrow(words: [str]) -> [str] { return words; }

fn main() -> i32 {
    let pair: Pair = Pair { number: 42, text: "Ω" };
    let words: [str; 2] = ["Ω", ""];
    let numbers: [i32; 2] = [-7, 42];
    let view: [str] = borrow(words);
    let empty_words: [str; 0] = [];
    let empty: [str] = borrow(empty_words);

    let texts = core::relay::duplicate("Ω");
    if (std::io::println(texts[0]) != 3 || std::io::println(texts[1]) != 3) { return 1; }
    texts[0] = "";
    if (std::io::println(texts[0]) != 1 || std::io::println(texts[1]) != 3) { return 2; }

    let records = core::relay::duplicate(pair);
    records[0].number = -99;
    records[0].text = "";
    if (pair.number != 42 || records[1].number != 42 || records[0].number != -99) { return 3; }
    if (std::io::println(records[0].text) != 1 || std::io::println(records[1].text) != 3) { return 4; }

    let arrays = core::relay::duplicate(words);
    arrays[0][0] = "";
    if (std::io::println(arrays[0][0]) != 1 || std::io::println(arrays[1][0]) != 3 ||
        std::io::println(words[0]) != 3) { return 5; }
    let integer_arrays = core::relay::duplicate(numbers);
    integer_arrays[0][0] = 99;
    if (integer_arrays[0][0] != 99 || integer_arrays[1][0] != -7 || numbers[0] != -7) { return 6; }

    let views = core::relay::duplicate(view);
    views[0][0] = "";
    if (std::io::println(words[0]) != 1 || std::io::println(views[1][0]) != 1) { return 7; }
    views[0] = empty;
    if (std::io::println(views[1][1]) != 1) { return 8; }

    let wrapped_record = core::relay::wrap(pair);
    if (wrapped_record.sentinel != 1234 || wrapped_record.value.number != 42) { return 9; }
    wrapped_record.value.number = -3;
    if (pair.number != 42 || wrapped_record.value.number != -3) { return 10; }
    if (std::io::println(wrapped_record.value.text) != 3) { return 11; }

    let wrapped_array = core::relay::wrap(numbers);
    if (wrapped_array.sentinel != 1234 || wrapped_array.value[0] != -7 || wrapped_array.value[1] != 42) { return 12; }
    wrapped_array.value[0] = 77;
    if (numbers[0] != -7 || wrapped_array.value[0] != 77) { return 13; }
    return 0;
}
