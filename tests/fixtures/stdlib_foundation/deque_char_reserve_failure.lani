module app::main;
import std::deque_char;

fn main() -> i32 {
    let value: std::deque_char::DequeChar = std::deque_char::try_with_capacity(3);
    if (std::deque_char::capacity(value) != 3) { return 5; }
    value = std::deque_char::try_push_back(value, 1);
    value = std::deque_char::try_push_back(value, 2);
    value = std::deque_char::try_push_back(value, 3);
    value = std::deque_char::try_pop_front(value);
    value = std::deque_char::try_push_back(value, 4);
    value = std::deque_char::try_reserve(value, 5);
    let intact: bool = std::deque_char::len(value) == 3 &&
        std::deque_char::at_or(value, 0, 0) == 2 &&
        std::deque_char::at_or(value, 1, 0) == 3 &&
        std::deque_char::at_or(value, 2, 0) == 4;
    let failure: bool = intact && std::deque_char::capacity(value) == 3;
    let success: bool = intact && std::deque_char::capacity(value) == 5;
    std::deque_char::destroy(value);
    if (failure) { return 0; }
    if (success) { return 4; }
    return 5;
}
