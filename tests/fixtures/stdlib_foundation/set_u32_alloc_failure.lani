module app::main;
import std::set_u32;

fn main() -> i32 {
    let value: std::set_u32::SetU32 = std::set_u32::new();
    value = std::set_u32::try_insert(value, 41);
    if (std::set_u32::len(value) == 0 &&
        std::set_u32::capacity(value) == 0 &&
        !std::set_u32::contains(value, 41)) {
        std::set_u32::destroy(value);
        return 0;
    }
    if (std::set_u32::len(value) == 1 &&
        std::set_u32::contains(value, 41)) {
        std::set_u32::destroy(value);
        return 4;
    }
    std::set_u32::destroy(value);
    return 5;
}
