module app::main;
import core::io;
import core::mem;
import core::path;
import core::result;
import core::slice;
import std::file;
import std::file_ops;
import std::linux;

fn path() -> core::path::Path {
    let raw: [u8] = core::mem::typed_slice_from_raw_parts<u8>(core::mem::string_data_ptr("input"),5);
    return core::path::from_view(core::slice::view<u8>(raw,5).unwrap()).unwrap();
}
fn host(error: core::io::Error, number: i32) -> bool { return match(error) { core::io::Error::Host(n) -> n == number, _ -> false }; }
fn invalid(error: core::io::Error) -> bool { return match(error) { core::io::Error::InvalidInput -> true, _ -> false }; }
fn close(file: &std::file::File) { file.close().unwrap(); file.close().unwrap(); assert(!file.is_open()); }
fn main() -> i32 {
    let options: std::file_ops::OpenOptions = std::file_ops::options(); options.access = std::file_ops::Access::ReadWrite;
    let file: std::file::File = std::file_ops::open(path(),options).unwrap();
    let duplicate: std::file::File = std::file_ops::duplicate(file.borrow(),40,true).unwrap();
    std::file_ops::set_status(file.borrow(),true,false).unwrap();
    assert((std::file_ops::status_flags(duplicate.borrow()).unwrap()&1024) != 0);
    let storage: [u8;8] = [211;8]; let source: [u8;5] = [211,44,45,211,211];
    assert(duplicate.read_at(storage,2,2,0).unwrap() == 2 && storage[2] == 19 && storage[3] == 92);
    assert(invalid(file.write_at(source,1,2,2).unwrap_err()));
    assert(storage[0] == 211 && storage[1] == 211 && storage[4] == 211);
    std::file_ops::set_status(duplicate.borrow(),false,false).unwrap();
    assert(file.write_at(source,1,2,2).unwrap() == 2);
    let read_only: std::file::File = std::file_ops::open(path(),std::file_ops::options()).unwrap();
    assert(host(read_only.write_at(source,1,2,0).unwrap_err(),9));
    assert(read_only.read_at(storage,2,2,2).unwrap() == 2 && storage[2] == 44 && storage[3] == 45);
    options.access = std::file_ops::Access::Write;
    let write_only: std::file::File = std::file_ops::open(path(),options).unwrap();
    assert(host(write_only.read_at(storage,2,2,0).unwrap_err(),9));
    assert(write_only.write_at(source,1,2,4).unwrap() == 2);
    assert(std::file_ops::position(file.borrow()).unwrap() == 0 && std::file_ops::position(duplicate.borrow()).unwrap() == 0);
    close(read_only.borrow()); close(write_only.borrow()); close(duplicate.borrow()); close(file.borrow());
    // pipe2 writes two packed i32 handles; adopt each once, then close once.
    let pair: [i32;2] = [-1,-1];
    let args: [std::linux::Argument;2] = [std::linux::Argument::Address(core::mem::i32_array_data_ptr(pair)),std::linux::Argument::Word(524288)];
    assert(std::linux::call(293,core::slice::view<std::linux::Argument>(args,2).unwrap()).unwrap() == 0);
    let reader: std::file::File = std::file::from_owned_handle(pair[0]).unwrap();
    let writer: std::file::File = std::file::from_owned_handle(pair[1]).unwrap();
    assert(host(reader.read_at(storage,2,2,0).unwrap_err(),29));
    assert(host(writer.write_at(source,1,2,0).unwrap_err(),29));
    close(reader.borrow()); close(writer.borrow()); return 0;
}
