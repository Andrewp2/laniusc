// Test-only sequence consumer adapter; all payloads and wire framing are finite.
module app::main;
import core::function;
import core::cmp;
import core::f64;
import core::iter;
import core::mem;
import core::option;
import core::ordering;
import core::pair;
import core::slice;
import std::io;

fn read_exact(pointer: ptr, count: i32, allow_eof: bool) -> bool {
    let done: i32 = 0;
    while (done < count) {
        let got: i32 = std::io::read_stdin(pointer + (done as usize), (count - done) as usize);
        assert(got >= 0);
        if (got == 0) { assert(allow_eof && done == 0); return false; }
        done += got;
    }
    return true;
}

fn write_all(pointer: ptr, count: i32) {
    let done: i32 = 0;
    while (done < count) {
        let got: i32 = std::io::write_stdout(pointer + (done as usize), (count - done) as usize);
        assert(got > 0);
        done += got;
    }
}

fn get64(bytes: [u8], offset: i32) -> u64 {
    let result: u64 = 0;
    let index: i32 = 0;
    while (index < 8) {
        result |= (bytes[offset + index] as u64) << (index * 8);
        index += 1;
    }
    return result;
}

struct Output { bytes: [u8], pointer: ptr, used: i32 }
impl Output {
    fn borrow(&self) -> &Output { return self; }
    fn flush(&self) { write_all(self.pointer, self.used); self.used = 0; }
    fn word(&self, value: u64) {
        if (self.used == 4096) { self.flush(); }
        let index: i32 = 0;
        while (index < 8) {
            self.bytes[self.used + index] = ((value >> (index * 8)) & 255) as u8;
            index += 1;
        }
        self.used += 8;
    }
}

struct Log { words: [u64], used: i32, enabled: bool, policy: i32, strict: bool }
impl Log {
    fn borrow(&self) -> &Log { return self; }
    fn add(&self, kind: u64, a: u64, b: u64, x: i64, y: i64, p: u64, q: u64, result: u64) {
        if (!self.enabled) { return; }
        assert(self.used < 64);
        let at: i32 = self.used * 8;
        self.words[at] = kind; self.words[at+1] = a; self.words[at+2] = b;
        self.words[at+3] = x as u64; self.words[at+4] = y as u64;
        self.words[at+5] = p; self.words[at+6] = q; self.words[at+7] = result;
        self.used += 1;
    }
}
struct Atom { key: i64, id: u64, bits: u64, marker: u64, flag: core::option::Option<bool>, log: &Log }
struct Other { id: u64, number: i64, bits: u64, extra: [u64; 2] }
struct BuildAtom { keys: [i64], bits: [u64], base: u64, log: &Log }
struct BuildOther { keys: [i64], bits: [u64], base: u64 }
impl BuildAtom { fn borrow(&self) -> &BuildAtom { return self; } }
impl BuildOther { fn borrow(&self) -> &BuildOther { return self; } }
pub impl core::function::Mapper<u8,Atom> for BuildAtom {
    pub fn apply(&self, index: u8) -> Atom {
        let id: u64 = self.base + (index as u64) + 1;
        let flag: core::option::Option<bool> = core::option::None();
        if (id % 3 != 0) { flag = core::option::Some(id % 2 == 0); }
        return Atom { key: self.keys[index as i32], id: id, bits: self.bits[index as i32],
            marker: 18446744073709551615-id*17, flag: flag, log: self.log };
    }
}
pub impl core::function::Mapper<u8,Other> for BuildOther {
    pub fn apply(&self, index: u8) -> Other {
        let id: u64 = self.base + (index as u64) + 1;
        return Other { id: id, number: self.keys[index as i32], bits: self.bits[index as i32],
            extra: [id*97+3,9223372036854775808+id*131] };
    }
}

fn relation(policy: i32, left: i64, right: i64, left_bits: u64, right_bits: u64) -> u64 {
    if (policy == 3) {
        let a: f64 = core::f64::from_bits(left_bits);
        let b: f64 = core::f64::from_bits(right_bits);
        if (a < b) { return 0; }
        if (a > b) { return 2; }
        if (a != b) { return 3; }
        return 1;
    }
    let a: i64 = left;
    let b: i64 = right;
    if (policy == 2) { a /= 3; b /= 3; }
    let result: u64 = 1;
    if (a < b) { result = 0; }
    if (a > b) { result = 2; }
    if (policy == 1 && result != 1) { result = 2-result; }
    return result;
}
fn total(value: u64) -> core::ordering::Ordering {
    if (value == 0) { return core::ordering::Less; }
    if (value == 2) { return core::ordering::Greater; }
    assert(value == 1);
    return core::ordering::Equal;
}
fn partial(value: u64) -> core::cmp::PartialOrdering {
    if (value == 0) { return core::cmp::PartialOrdering::Less; }
    if (value == 2) { return core::cmp::PartialOrdering::Greater; }
    if (value == 3) { return core::cmp::PartialOrdering::Unordered; }
    return core::cmp::PartialOrdering::Equal;
}
fn partial_code(value: core::cmp::PartialOrdering) -> u64 {
    return match (value) { core::cmp::PartialOrdering::Less -> 0, core::cmp::PartialOrdering::Equal -> 1,
        core::cmp::PartialOrdering::Greater -> 2, core::cmp::PartialOrdering::Unordered -> 3 };
}
fn total_code(value: core::ordering::Ordering) -> u64 {
    return match (value) { core::ordering::Less -> 0, core::ordering::Equal -> 1, core::ordering::Greater -> 2 };
}
fn atom_relation(left: Atom, right: Atom) -> u64 {
    let log: &Log = left.log;
    return relation(log.policy,left.key,right.key,left.bits,right.bits);
}
fn atom_log(kind: u64, left: Atom, right: Atom, result: u64) {
    let log: &Log = left.log;
    log.add(kind,left.id,right.id,left.key,right.key,left.bits,right.bits,result);
}
pub impl core::cmp::PartialEq<Atom> for Atom {
    pub fn partial_eq(left: Atom, right: Atom) -> bool {
        let result: bool = atom_relation(left,right) == 1;
        atom_log(7,left,right,result as u64); return result;
    }
    pub fn partial_ne(left: Atom, right: Atom) -> bool { return atom_relation(left,right) != 1; }
}
pub impl core::cmp::Ord<Atom> for Atom {
    // Natural<T>'s internal lt strategy is not part of this model's trace.
    pub fn lt(left: Atom, right: Atom) -> bool { return atom_relation(left,right) == 0; }
    pub fn le(left: Atom, right: Atom) -> bool { return atom_relation(left,right) != 2; }
    pub fn gt(left: Atom, right: Atom) -> bool { return atom_relation(left,right) == 2; }
    pub fn ge(left: Atom, right: Atom) -> bool { return atom_relation(left,right) != 0; }
}
pub impl core::cmp::PartialOrd<Atom> for Atom {
    pub fn partial_cmp(left: Atom, right: Atom) -> core::cmp::PartialOrdering {
        let result: u64 = atom_relation(left,right);
        atom_log(9,left,right,result); return partial(result);
    }
    pub fn partial_le(left: Atom, right: Atom) -> bool {
        let order: u64 = atom_relation(left,right);
        let result: bool = order == 0 || order == 1;
        atom_log(10,left,right,result as u64); return result;
    }
    pub fn partial_lt(left: Atom, right: Atom) -> bool { return atom_relation(left,right) == 0; }
    pub fn partial_gt(left: Atom, right: Atom) -> bool { return atom_relation(left,right) == 2; }
    pub fn partial_ge(left: Atom, right: Atom) -> bool { let order:u64=atom_relation(left,right); return order==1 || order==2; }
}
struct Equality { log: &Log }
struct Compare { log: &Log }
struct PartialCompare { log: &Log }
struct Sorted { log: &Log }
impl Equality { fn borrow(&self) -> &Equality { return self; } }
impl Compare { fn borrow(&self) -> &Compare { return self; } }
impl PartialCompare { fn borrow(&self) -> &PartialCompare { return self; } }
impl Sorted { fn borrow(&self) -> &Sorted { return self; } }
pub impl core::function::Mapper<core::pair::Pair<Atom,Other>,bool> for Equality {
    pub fn apply(&self, pair: core::pair::Pair<Atom,Other>) -> bool {
        let log: &Log = self.log; let a: Atom=pair.first; let b: Other=pair.second;
        let result: bool=relation(log.policy,a.key,b.number,a.bits,b.bits)==1;
        log.add(3,a.id,b.id,a.key,b.number,a.bits,b.bits,result as u64); return result;
    }
}
pub impl core::ordering::Comparator<Atom,Other> for Compare {
    pub fn compare(&self, a: Atom, b: Other) -> core::ordering::Ordering {
        let log: &Log=self.log; let result:u64=relation(log.policy,a.key,b.number,a.bits,b.bits);
        log.add(4,a.id,b.id,a.key,b.number,a.bits,b.bits,result); return total(result);
    }
}
pub impl core::function::Mapper<core::pair::Pair<Atom,Other>,core::cmp::PartialOrdering> for PartialCompare {
    pub fn apply(&self, pair: core::pair::Pair<Atom,Other>) -> core::cmp::PartialOrdering {
        let log:&Log=self.log; let a:Atom=pair.first; let b:Other=pair.second;
        let result:u64=relation(log.policy,a.key,b.number,a.bits,b.bits);
        log.add(5,a.id,b.id,a.key,b.number,a.bits,b.bits,result); return partial(result);
    }
}
pub impl core::function::Mapper<core::pair::Pair<Atom,Atom>,bool> for Sorted {
    pub fn apply(&self, pair: core::pair::Pair<Atom,Atom>) -> bool {
        let log:&Log=self.log; let a:Atom=pair.first; let b:Atom=pair.second;
        let order:u64=relation(log.policy,a.key,b.key,a.bits,b.bits);
        let result:bool=order==0 || (!log.strict && order==1);
        log.add(6,a.id,b.id,a.key,b.key,a.bits,b.bits,result as u64); return result;
    }
}
struct Meter<I,T> { source: &I, log: &Log, side: u64 }
impl<I,T> Meter<I,T> { fn borrow(&self) -> &Meter<I,T> { return self; } }
pub impl<I,T> core::iter::Iterator<T> for Meter<I,T> where I: core::iter::Iterator<T> {
    pub fn next(&self) -> core::option::Option<T> {
        let source:&I=self.source; let value:core::option::Option<T> =source.next();
        let log:&Log=self.log; log.add(self.side,value.is_some() as u64,0,0,0,0,0,0); return value;
    }
}
fn emit_trace(log: &Log, result: u64, output: &Output) {
    output.word(result); output.word(log.used as u64);
    let index:i32=0;
    while(index<log.used*8) { output.word(log.words[index]); index+=1; }
    log.enabled=false;
}
fn drain_atom<I>(source: &I, output: &Output) where I: core::iter::Iterator<Atom> {
    while(true) {
        let item:core::option::Option<Atom> =source.next();
        if(item.is_none()) { output.word(0); return; }
        let value:Atom=item.unwrap(); output.word(1); output.word(value.id); output.word(value.key as u64);
        output.word(value.bits); output.word(value.marker);
        let flag:u64=0; if(value.flag.is_some()) { flag=1; if(value.flag.unwrap()) { flag=2; } }
        output.word(flag);
    }
}
fn drain_other<I>(source: &I, output: &Output) where I: core::iter::Iterator<Other> {
    while(true) {
        let item:core::option::Option<Other> =source.next();
        if(item.is_none()) { output.word(0); return; }
        let value:Other=item.unwrap(); output.word(1); output.word(value.id); output.word(value.number as u64);
        output.word(value.bits); output.word(value.extra[0]); output.word(value.extra[1]);
    }
}
fn observe_natural<A,B>(left: &A, right: &B, operation: u64, log: &Log, output: &Output)
    where A:core::iter::Iterator<Atom>, B:core::iter::Iterator<Atom> {
    let result:u64=0;
    if(operation==0) { result=core::iter::eq<A,B,Atom>(left,right) as u64; }
    if(operation==2) { result=total_code(core::iter::cmp<A,B,Atom>(left,right)); }
    if(operation==4) { result=partial_code(core::iter::partial_cmp<A,B,Atom>(left,right)); }
    if(operation==6) { result=core::iter::is_sorted<A,Atom>(left) as u64; }
    emit_trace(log,result,output); drain_atom<A>(left,output); drain_atom<B>(right,output);
}
fn observe_custom<A,B>(left: &A, right: &B, operation: u64, log: &Log, output: &Output)
    where A:core::iter::Iterator<Atom>, B:core::iter::Iterator<Other> {
    let equal:Equality=Equality { log:log }; let compare:Compare=Compare { log:log };
    let partial_compare:PartialCompare=PartialCompare { log:log }; let sorted:Sorted=Sorted { log:log };
    let result:u64=0;
    if(operation==1) { result=core::iter::eq_by<A,B,Equality,Atom,Other>(left,right,equal.borrow()) as u64; }
    if(operation==3) { result=total_code(core::iter::cmp_by<A,B,Compare,Atom,Other>(left,right,compare.borrow())); }
    if(operation==5) { result=partial_code(core::iter::partial_cmp_by<A,B,PartialCompare,Atom,Other>(left,right,partial_compare.borrow())); }
    if(operation==7) { result=core::iter::is_sorted_by<A,Sorted,Atom>(left,sorted.borrow()) as u64; }
    emit_trace(log,result,output); drain_atom<A>(left,output); drain_other<B>(right,output);
}
fn with_sources<I>(left: &I, right: &I, operation: u64, alias: u64, keys_left:[i64],bits_left:[u64],
                  keys_right:[i64],bits_right:[u64],log:&Log,output:&Output) where I:core::iter::Iterator<u8> {
    let actual_right:&I=right; let keys:[i64]=keys_right; let bits:[u64]=bits_right; let base:u64=200;
    if(alias!=0) { actual_right=left; keys=keys_left; bits=bits_left; base=100; }
    let build_left:BuildAtom=BuildAtom { keys:keys_left,bits:bits_left,base:100,log:log };
    let mapped_left:core::iter::Map<I,BuildAtom,u8,Atom> =core::iter::map<I,BuildAtom,u8,Atom>(left,build_left.borrow());
    let meter_left:Meter<core::iter::Map<I,BuildAtom,u8,Atom>,Atom> =Meter { source:mapped_left.borrow(),log:log,side:1 };
    if(operation%2==0) {
        let build_right:BuildAtom=BuildAtom { keys:keys,bits:bits,base:base,log:log };
        let mapped_right:core::iter::Map<I,BuildAtom,u8,Atom> =core::iter::map<I,BuildAtom,u8,Atom>(actual_right,build_right.borrow());
        let meter_right:Meter<core::iter::Map<I,BuildAtom,u8,Atom>,Atom> =Meter { source:mapped_right.borrow(),log:log,side:2 };
        let selected_right:&Meter<core::iter::Map<I,BuildAtom,u8,Atom>,Atom> =meter_right.borrow();
        if(alias==2) { selected_right=meter_left.borrow(); }
        observe_natural<Meter<core::iter::Map<I,BuildAtom,u8,Atom>,Atom>,Meter<core::iter::Map<I,BuildAtom,u8,Atom>,Atom>>(
            meter_left.borrow(),selected_right,operation,log,output);
    } else {
        let build_right:BuildOther=BuildOther { keys:keys,bits:bits,base:base };
        let mapped_right:core::iter::Map<I,BuildOther,u8,Other> =core::iter::map<I,BuildOther,u8,Other>(actual_right,build_right.borrow());
        let meter_right:Meter<core::iter::Map<I,BuildOther,u8,Other>,Other> =Meter { source:mapped_right.borrow(),log:log,side:2 };
        observe_custom<Meter<core::iter::Map<I,BuildAtom,u8,Atom>,Atom>,Meter<core::iter::Map<I,BuildOther,u8,Other>,Other>>(
            meter_left.borrow(),meter_right.borrow(),operation,log,output);
    }
}
fn prepare(source:&core::slice::Iter<u8>,front:i32,back:i32) {
    let index:i32=0;
    while(index<front) { let item:core::option::Option<u8> =source.next(); assert(item.is_some()); index+=1; }
    index=0;
    while(index<back) { let item:core::option::Option<u8> =source.next_back(); assert(item.is_some()); index+=1; }
}
fn run(input:[u8],output:&Output) {
    let operation:u64=get64(input,0); let layout:u64=get64(input,8); let policy:i32=get64(input,16) as i32;
    let alias:u64=get64(input,32); let kind:u64=get64(input,40); let nl:i32=get64(input,48) as i32; let nr:i32=get64(input,56) as i32;
    let native_left:[u8;16]=[0;16]; let native_right:[u8;16]=[0;16];
    let packed_left:[i32;4]=[0;4]; let packed_right:[i32;4]=[0;4];
    let left:[u8]=native_left; let right:[u8]=native_right;
    if(layout==1) {
        left=core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(packed_left),16);
        right=core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(packed_right),16);
    }
    if(layout==0) { assert(core::mem::slice_stride(left)<0 && core::mem::slice_stride(right)<0); }
    else { assert(core::mem::slice_stride(left)==1 && core::mem::slice_stride(right)==1); }
    let keys_left:[i64;12]=[0;12]; let keys_right:[i64;12]=[0;12]; let bits_left:[u64;12]=[0;12]; let bits_right:[u64;12]=[0;12];
    let index:i32=0;
    while(index<16) { left[index]=(200+index) as u8; right[index]=(220+index) as u8; index+=1; }
    index=0;
    while(index<12) { keys_left[index]=-700-(index as i64); keys_right[index]=-900-(index as i64);
        bits_left[index]=18364758544493064720+(index as u64); bits_right[index]=81985529216486895+(index as u64); index+=1; }
    index=0;
    while(index<nl) { keys_left[index]=get64(input,112+index*16) as i64; bits_left[index]=get64(input,120+index*16); left[index+2]=index as u8; index+=1; }
    index=0;
    while(index<nr) { keys_right[index]=get64(input,112+nl*16+index*16) as i64; bits_right[index]=get64(input,120+nl*16+index*16); right[index+2]=index as u8; index+=1; }
    let lv:core::slice::View<u8> =core::slice::View { values:left,start:2,length:nl };
    let rv:core::slice::View<u8> =core::slice::View { values:right,start:2,length:nr };
    let lc:core::slice::Iter<u8> =lv.iter(); let rc:core::slice::Iter<u8> =rv.iter();
    prepare(lc.borrow(),get64(input,64) as i32,get64(input,72) as i32);
    prepare(rc.borrow(),get64(input,80) as i32,get64(input,88) as i32);
    let words:[u64;512]=[0;512]; let log:Log=Log { words:words,used:0,enabled:true,policy:policy,strict:get64(input,24)!=0 };
    if(kind==0) { with_sources<core::slice::Iter<u8>>(lc.borrow(),rc.borrow(),operation,alias,keys_left,bits_left,keys_right,bits_right,log.borrow(),output); }
    if(kind==1) {
        let lr:core::iter::Rev<core::slice::Iter<u8>,u8> =core::iter::rev<core::slice::Iter<u8>,u8>(lc.borrow());
        let rr:core::iter::Rev<core::slice::Iter<u8>,u8> =core::iter::rev<core::slice::Iter<u8>,u8>(rc.borrow());
        with_sources<core::iter::Rev<core::slice::Iter<u8>,u8>>(lr.borrow(),rr.borrow(),operation,alias,keys_left,bits_left,keys_right,bits_right,log.borrow(),output);
    }
    if(kind==2) {
        let lt:core::iter::Take<core::slice::Iter<u8>,u8> =core::iter::take<core::slice::Iter<u8>,u8>(lc.borrow(),get64(input,96));
        let rt:core::iter::Take<core::slice::Iter<u8>,u8> =core::iter::take<core::slice::Iter<u8>,u8>(rc.borrow(),get64(input,104));
        with_sources<core::iter::Take<core::slice::Iter<u8>,u8>>(lt.borrow(),rt.borrow(),operation,alias,keys_left,bits_left,keys_right,bits_right,log.borrow(),output);
    }
    index=0; while(index<16) { output.word(left[index] as u64); output.word(right[index] as u64); index+=1; }
    index=0; while(index<12) { output.word(keys_left[index] as u64); output.word(bits_left[index]); output.word(keys_right[index] as u64); output.word(bits_right[index]); index+=1; }
}
fn main() -> i32 {
    let input_words:[i32;128]=[0;128]; let pointer:ptr=core::mem::i32_array_data_ptr(input_words);
    let input:[u8]=core::mem::typed_slice_from_raw_parts<u8>(pointer,512);
    let output_words:[i32;1024]=[0;1024]; let output_pointer:ptr=core::mem::i32_array_data_ptr(output_words);
    let output_bytes:[u8]=core::mem::typed_slice_from_raw_parts<u8>(output_pointer,4096);
    let output:Output=Output { bytes:output_bytes,pointer:output_pointer,used:0 };
    while(read_exact(pointer,112,true)) {
        let op:u64=get64(input,0); let nl:u64=get64(input,48); let nr:u64=get64(input,56);
        assert(op<=7 && get64(input,8)<=1 && get64(input,16)<=3 && get64(input,32)<=2 && get64(input,40)<=2 && nl<=12 && nr<=12);
        assert(get64(input,64)+get64(input,72)<=nl && get64(input,80)+get64(input,88)<=nr);
        assert(!(get64(input,16)==3 && (op==2 || op==3)));
        assert(!(get64(input,32)==2 && op%2!=0));
        assert(read_exact(pointer+112,((nl+nr)*16) as i32,false)); run(input,output.borrow());
    }
    output.flush(); return 0;
}
