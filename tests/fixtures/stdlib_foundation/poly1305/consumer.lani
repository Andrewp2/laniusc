// Ordinary consumer: first32 input bytes are one public test key; the remaining
// bytes are its one message. No error enum projection or reset is needed.
module app::main;
import core::io;
import core::mem;
import core::poly1305;
import core::result;
import core::slice;
import std::stream;
fn main() -> i32 {
    let source:std::stream::Descriptor=std::stream::stdin(); let sink:std::stream::Descriptor=std::stream::stdout(); let key:[u8;32]=[0;32];
    core::io::read_exact(source.borrow(),key,0,32).unwrap();
    let state:core::poly1305::State=core::poly1305::new(core::slice::view(key,32).unwrap()).unwrap();
    let backing:[i32;257]=[0;257]; let bytes:[u8]=core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(backing),1028);
    while (true) { let received:i32=source.read(bytes,3,1024).unwrap(); if (received == 0) { break; } assert(state.update(core::slice::view_range(bytes,3,received).unwrap()).unwrap() == received); }
    let tag:core::poly1305::Tag=state.finish(); core::io::write_all(sink.borrow(),tag.bytes,0,16).unwrap(); return 0;
}
