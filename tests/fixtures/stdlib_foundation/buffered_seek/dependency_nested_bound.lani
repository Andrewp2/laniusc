// Isolates the same nested generic trait-bound shape without Vec/core::iter.
module app::main;
import core::option;
pub trait Project<T,U> { pub fn project(&self,value:T) -> U; }
pub fn nested<M,T,U>(mapper:&M) -> bool where M:Project<T,core::option::Option<U>> { return true; }
fn main() -> i32 { return 0; }
