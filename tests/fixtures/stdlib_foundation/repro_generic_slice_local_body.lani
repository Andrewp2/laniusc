module app::main;

pub fn reverse<T>(values: [T], length: i32) -> i32 {
    let left: i32 = 0;
    let right: i32 = length - 1;
    let swaps: i32 = 0;
    while (left < right) {
        let previous: T = values[left];
        values[left] = values[right];
        values[right] = previous;
        left += 1;
        right -= 1;
        swaps += 1;
    }
    return swaps;
}

fn main() -> i32 {
    let values: [i32; 3] = [-7, 0, 99];
    if (reverse(values, 3) != 1 || values[0] != 99 || values[1] != 0 || values[2] != -7) {
        return 1;
    }
    return 0;
}
