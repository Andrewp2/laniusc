module app::main;
import core::mem;
import core::slice;

fn main() -> i32 {
    let backing: [i32; 6] = [2, 4, 6, 99, 99, 99];
    let values: [i32] = core::mem::i32_slice_from_raw_parts(core::mem::i32_array_data_ptr(backing), 6);
    if (!core::slice::insert_i32(values, 3, 6, 0, 1) || backing[0] != 1 || backing[1] != 2 || backing[2] != 4 || backing[3] != 6 || backing[4] != 99) {
        return 1;
    }
    if (!core::slice::insert_i32(values, 4, 6, 2, 3) || backing[0] != 1 || backing[1] != 2 || backing[2] != 3 || backing[3] != 4 || backing[4] != 6 || backing[5] != 99) {
        return 2;
    }
    if (!core::slice::push_i32(values, 5, 6, 7) || backing[5] != 7) {
        return 3;
    }
    if (core::slice::push_i32(values, 6, 6, 8) || core::slice::insert_i32(values, 6, 6, 3, 8)) {
        return 4;
    }
    if (core::slice::insert_i32(values, -1, 6, 0, 8) || core::slice::insert_i32(values, 7, 6, 0, 8) || core::slice::insert_i32(values, 5, 6, -1, 8) || core::slice::insert_i32(values, 5, 6, 6, 8)) {
        return 5;
    }
    if (core::slice::push_i32(values, -1, 6, 8) || core::slice::push_i32(values, 0, 0, 8) || core::slice::insert_i32(values, 0, -1, 0, 8)) {
        return 6;
    }
    if (backing[0] != 1 || backing[1] != 2 || backing[2] != 3 || backing[3] != 4 || backing[4] != 6 || backing[5] != 7) {
        return 7;
    }
    let empty_backing: [i32; 3] = [0, 0, 0];
    let empty: [i32] = core::mem::i32_slice_from_raw_parts(core::mem::i32_array_data_ptr(empty_backing), 3);
    if (!core::slice::push_i32(empty, 0, 3, -2147483648) || !core::slice::insert_i32(empty, 1, 3, 1, 2147483647)) {
        return 8;
    }
    if (empty_backing[0] != -2147483648 || empty_backing[1] != 2147483647 || empty_backing[2] != 0) {
        return 9;
    }
    return 0;
}
