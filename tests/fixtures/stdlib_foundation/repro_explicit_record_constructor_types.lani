import std::io;
import core::record_context;
import core::option;
struct Cell<T> { value: T }
struct Envelope<T> { child: Cell<T> }
fn make<T>(value: T) -> Cell<T> { return Cell<T> { value: value }; }
fn main() -> i32 {
    let number = Cell<u32> { value: 4294967295 };
    if (number.value / 2 != 2147483647) { return 1; }
    let words = Cell<[str; 2]> { value: ["Ω", ""] };
    std::io::println(words.value[0]);
    let nested = Envelope<[str; 2]> { child: Cell<[str; 2]> { value: words.value } };
    nested.child.value[0] = "changed";
    std::io::println(words.value[0]);
    let imported = core::record_context::ImportedEnvelope<str> {
        child: core::record_context::ImportedCell<str> { value: "λ" }
    };
    std::io::println(imported.child.value);
    let flags: [Cell<bool>; 2] = [Cell<bool> { value: false }, Cell<bool> { value: true }];
    if (flags[0].value || !flags[1].value) { return 2; }
    let picked: core::option::Option<Cell<bool>> = core::option::Some(Cell<bool> { value: false });
    let stopped: bool = match (picked) { core::option::Some(v) -> v.value, core::option::None -> true };
    if (stopped || make(false).value) { return 3; }
    let copied = make(words.value);
    std::io::println(copied.value[0]);
    return 0;
}
