module app::main;
import core::mem;
import core::slice;

fn main() -> i32 {
    let values:[i32; 5] = [1, 2, 1, 2, 3];
    let equal:[i32; 5] = [1, 2, 1, 2, 3];
    let later:[i32; 5] = [1, 2, 1, 2, 4];
    let pair:[i32; 2] = [1, 2];
    let tail:[i32; 2] = [2, 3];
    let missing:[i32; 2] = [2, 2];
    let longer:[i32; 6] = [1, 2, 1, 2, 3, 4];
    let repeated:[i32; 4] = [1, 1, 1, 1];
    let repeated_pair:[i32; 2] = [1, 1];
    let extremes:[i32; 2] = [-2147483648, 2147483647];
    let middle:[i32; 2] = [0, -2147483648];
    let view:[i32] = core::mem::i32_slice_from_raw_parts(core::mem::i32_array_data_ptr(values), 5);
    let equal_view:[i32] = core::mem::i32_slice_from_raw_parts(core::mem::i32_array_data_ptr(equal), 5);
    let later_view:[i32] = core::mem::i32_slice_from_raw_parts(core::mem::i32_array_data_ptr(later), 5);
    let pair_view:[i32] = core::mem::i32_slice_from_raw_parts(core::mem::i32_array_data_ptr(pair), 2);
    let tail_view:[i32] = core::mem::i32_slice_from_raw_parts(core::mem::i32_array_data_ptr(tail), 2);
    let missing_view:[i32] = core::mem::i32_slice_from_raw_parts(core::mem::i32_array_data_ptr(missing), 2);
    let longer_view:[i32] = core::mem::i32_slice_from_raw_parts(core::mem::i32_array_data_ptr(longer), 6);
    let repeated_view:[i32] = core::mem::i32_slice_from_raw_parts(core::mem::i32_array_data_ptr(repeated), 4);
    let repeated_pair_view:[i32] = core::mem::i32_slice_from_raw_parts(core::mem::i32_array_data_ptr(repeated_pair), 2);
    let extremes_view:[i32] = core::mem::i32_slice_from_raw_parts(core::mem::i32_array_data_ptr(extremes), 2);
    let middle_view:[i32] = core::mem::i32_slice_from_raw_parts(core::mem::i32_array_data_ptr(middle), 2);
    let empty:[i32] = core::mem::i32_slice_from_raw_parts(core::mem::i32_array_data_ptr(values), 0);

    if (core::slice::compare_lexicographic_i32(view, 5, equal_view, 5) != 0 ||
        core::slice::compare_lexicographic_i32(view, 5, later_view, 5) != -1 ||
        core::slice::compare_lexicographic_i32(later_view, 5, view, 5) != 1 ||
        core::slice::compare_lexicographic_i32(pair_view, 2, view, 5) != -1 ||
        core::slice::compare_lexicographic_i32(view, 5, pair_view, 2) != 1) {
        return 1;
    }
    if (core::slice::compare_lexicographic_i32(empty, 0, empty, 0) != 0 ||
        core::slice::compare_lexicographic_i32(view, -1, pair_view, -2) != 0 ||
        core::slice::compare_lexicographic_i32(empty, 0, view, 5) != -1 ||
        core::slice::compare_lexicographic_i32(view, 5, empty, 0) != 1 ||
        core::slice::compare_lexicographic_i32(extremes_view, 2, middle_view, 2) != -1 ||
        core::slice::compare_lexicographic_i32(middle_view, 2, extremes_view, 2) != 1) {
        return 2;
    }
    if (core::slice::index_of_subslice_i32(view, 5, pair_view, 2) != 0 ||
        core::slice::last_index_of_subslice_i32(view, 5, pair_view, 2) != 2 ||
        core::slice::index_of_subslice_i32(view, 5, tail_view, 2) != 3 ||
        core::slice::last_index_of_subslice_i32(view, 5, tail_view, 2) != 3 ||
        core::slice::index_of_subslice_i32(view, 5, equal_view, 5) != 0 ||
        core::slice::last_index_of_subslice_i32(view, 5, equal_view, 5) != 0) {
        return 3;
    }
    if (core::slice::index_of_subslice_i32(repeated_view, 4, repeated_pair_view, 2) != 0 ||
        core::slice::last_index_of_subslice_i32(repeated_view, 4, repeated_pair_view, 2) != 2 ||
        core::slice::index_of_subslice_i32(view, 5, missing_view, 2) != -1 ||
        core::slice::last_index_of_subslice_i32(view, 5, missing_view, 2) != -1 ||
        core::slice::index_of_subslice_i32(view, 5, longer_view, 6) != -1 ||
        core::slice::last_index_of_subslice_i32(view, 5, longer_view, 6) != -1) {
        return 4;
    }
    if (core::slice::index_of_subslice_i32(view, 5, empty, 0) != 0 ||
        core::slice::last_index_of_subslice_i32(view, 5, empty, 0) != 5 ||
        core::slice::index_of_subslice_i32(empty, 0, empty, 0) != 0 ||
        core::slice::last_index_of_subslice_i32(empty, 0, empty, 0) != 0 ||
        core::slice::index_of_subslice_i32(view, -1, empty, -1) != 0 ||
        core::slice::last_index_of_subslice_i32(view, -1, empty, -1) != 0 ||
        core::slice::index_of_subslice_i32(empty, 0, pair_view, 2) != -1 ||
        core::slice::last_index_of_subslice_i32(empty, 0, pair_view, 2) != -1) {
        return 5;
    }
    return 0;
}
