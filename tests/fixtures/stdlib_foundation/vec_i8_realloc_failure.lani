module app::main;
import std::vec_i8;

fn main() -> i32 {
    let value: std::vec_i8::VecI8 = std::vec_i8::try_with_capacity(1);
    if (std::vec_i8::capacity(value) != 1) { return 2; }
    value = std::vec_i8::try_push(value, -128);
    if (std::vec_i8::len(value) != 1) { return 3; }
    value = std::vec_i8::try_push(value, 127);
    if (std::vec_i8::len(value) != 1 || std::vec_i8::capacity(value) != 1) { return 4; }
    if (std::vec_i8::get_or(value, 0, 0) != -128) { return 5; }
    std::vec_i8::destroy(value);
    return 0;
}
