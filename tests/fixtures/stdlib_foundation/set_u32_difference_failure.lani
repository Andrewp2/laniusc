module app::main;
import std::set_u32;

fn main() -> i32 {
    let left: std::set_u32::SetU32 = std::set_u32::try_insert(std::set_u32::new(), 4294967289);
    let right: std::set_u32::SetU32 = std::set_u32::try_insert(std::set_u32::new(), 42);
    if (std::set_u32::len(left) != 1 || std::set_u32::len(right) != 1) { return 2; }
    let result: std::set_u32::SetU32 = std::set_u32::try_difference(left, right);
    let failed: bool = std::set_u32::len(result) == 0 &&
        std::set_u32::capacity(result) == 0 &&
        std::set_u32::contains(left, 4294967289) && std::set_u32::contains(right, 42);
    let succeeded: bool = std::set_u32::len(result) == 1 &&
        std::set_u32::at_or(result, 0, 0) == 4294967289;
    std::set_u32::destroy(result);
    std::set_u32::destroy(right);
    std::set_u32::destroy(left);
    if (failed) { return 0; }
    if (succeeded) { return 4; }
    return 5;
}
