// Four-u64 headers: variant, byte length, chunk schedule, physical layout;
// payload follows. One process checks lifecycle contracts and all oracle cases.
module app::main;
import core::io;
import core::mem;
import core::result;
import core::sha256;
import core::slice;
import std::stream;

fn view(bytes: [u8], start: i32, length: i32) -> core::slice::View<u8> {
    return core::slice::View<u8> { values: bytes, start: start, length: length };
}
fn state(variant: i32) -> core::sha256::State {
    if (variant == 1) { return core::sha256::new224(); }
    assert(variant == 0); return core::sha256::new();
}
fn one_shot(variant: i32, input: core::slice::View<u8>) -> core::sha256::Digest {
    if (variant == 1) { return core::sha256::digest224(input).unwrap(); }
    return core::sha256::digest(input).unwrap();
}
fn code(error: core::sha256::Error) -> i32 {
    return match (error) { core::sha256::Error::Bounds -> 1, core::sha256::Error::LengthOverflow -> 2, core::sha256::Error::Finished -> 3 };
}
fn equal(left: core::sha256::Digest, right: core::sha256::Digest) {
    assert(left.length == right.length); let index: i32 = 0;
    while (index < 32) { assert(left.bytes[index] == right.bytes[index]); if (index >= left.length) { assert(left.bytes[index] == 0); } index += 1; }
}
// Store scalar values and each byte into a distinct array. A State value copy
// alone would be an insufficient rejection oracle if its block were aliased.
fn snapshot(value: &core::sha256::State, saved: [u64]) {
    saved[0] = value.h0 as u64; saved[1] = value.h1 as u64; saved[2] = value.h2 as u64; saved[3] = value.h3 as u64;
    saved[4] = value.h4 as u64; saved[5] = value.h5 as u64; saved[6] = value.h6 as u64; saved[7] = value.h7 as u64;
    saved[8] = value.count; saved[9] = value.used as u64; saved[10] = 0; saved[11] = 0;
    if (value.finished) { saved[10] = 1; } if (value.is224) { saved[11] = 1; }
    let index: i32 = 0; while (index < 64) { saved[12+index] = value.block[index] as u64; index += 1; }
}
fn unchanged(value: &core::sha256::State, saved: [u64]) {
    let after: [u64; 76] = [0; 76]; snapshot(value, after); let index: i32 = 0;
    while (index < 76) { assert(saved[index] == after[index]); index += 1; }
}
fn contracts() {
    let bytes: [u8; 65] = [97; 65]; let input: core::slice::View<u8> = view(bytes, 0, 3);
    let empty: core::slice::View<u8> = view(bytes, 2, 0); let saved: [u64; 76] = [0; 76];
    let variant: i32 = 0;
    while (variant < 2) {
        let current: core::sha256::State = state(variant); current.update(input).unwrap(); snapshot(current.borrow(), saved);
        let malformed: core::slice::View<u8> = input; malformed.start = -1;
        assert(code(current.update(malformed).unwrap_err()) == 1); unchanged(current.borrow(), saved);
        malformed = input; malformed.length = -1;
        assert(code(current.update(malformed).unwrap_err()) == 1); unchanged(current.borrow(), saved);
        malformed = input; malformed.start = 2147483647; malformed.length = 1;
        assert(code(current.update(malformed).unwrap_err()) == 1); unchanged(current.borrow(), saved);
        assert(code(core::sha256::digest(malformed).unwrap_err()) == 1);
        assert(code(core::sha256::digest224(malformed).unwrap_err()) == 1);
        let retained: core::sha256::Digest = current.finish(); snapshot(current.borrow(), saved);
        assert(code(current.update(malformed).unwrap_err()) == 1); unchanged(current.borrow(), saved);
        assert(code(current.update(empty).unwrap_err()) == 3); unchanged(current.borrow(), saved);
        assert(code(current.update(input).unwrap_err()) == 3); unchanged(current.borrow(), saved);
        equal(retained, current.finish()); current.reset();
        assert(current.count == 0 && current.used == 0 && !current.finished && current.is224 == (variant == 1));
        let index: i32 = 0; while (index < 64) { assert(current.block[index] == 0); index += 1; }
        equal(current.finish(), one_shot(variant, empty)); equal(retained, one_shot(variant, input));

        // Fabricate only count, preserving used=count%64 and the pending
        // bytes. This probes count arithmetic, not a digest of an enormous
        // real prefix: the chaining words do not encode that fake history.
        current.reset(); current.update(view(bytes, 0, 62)).unwrap();
        current.count = 2305843009213693950;
        assert(current.update(view(bytes, 62, 1)).unwrap() == 1);
        assert(current.count == 2305843009213693951 && current.used == 63);
        snapshot(current.borrow(), saved);
        assert(code(current.update(view(bytes, 63, 1)).unwrap_err()) == 2); unchanged(current.borrow(), saved);
        assert(code(current.update(malformed).unwrap_err()) == 1); unchanged(current.borrow(), saved);
        assert(current.update(empty).unwrap() == 0); unchanged(current.borrow(), saved);
        current.reset(); equal(current.finish(), one_shot(variant, empty)); variant += 1;
    }
    // Two constructors/variants remain active with interleaved pending bytes.
    let left: core::sha256::State = core::sha256::new(); let right: core::sha256::State = core::sha256::new224();
    left.update(view(bytes, 0, 1)).unwrap(); right.update(view(bytes, 0, 2)).unwrap();
    left.update(view(bytes, 1, 2)).unwrap(); right.update(view(bytes, 2, 1)).unwrap();
    equal(left.finish(), one_shot(0, input)); equal(right.finish(), one_shot(1, input));
}
fn feed(value: &core::sha256::State, input: core::slice::View<u8>, schedule: i32) {
    let widths: [i32; 6] = [1, 55, 0, 64, 2, 7]; let position: i32 = 0; let step: i32 = 0;
    assert(value.update(view(input.values, input.start, 0)).unwrap() == 0);
    while (position < input.length) {
        let count: i32 = input.length - position;
        if (schedule == 1) { count = 1; }
        if (schedule == 2 && count > 2) { count = 2; }
        if (schedule == 3 && count > 7) { count = 7; }
        if (schedule == 4 && count > 63) { count = 63; }
        if (schedule == 5 && count > 64) { count = 64; }
        if (schedule == 6 && count > 65) { count = 65; }
        if (schedule == 7 && count > widths[step%6]) { count = widths[step%6]; }
        assert(value.update(view(input.values, input.start+position, count)).unwrap() == count);
        position += count; step += 1;
    }
    assert(value.update(view(input.values, input.start+input.length, 0)).unwrap() == 0);
}
fn check_case(variant: i32, schedule: i32, input: core::slice::View<u8>) -> core::sha256::Digest {
    let reference: core::sha256::Digest = one_shot(variant, input);
    let current: core::sha256::State = state(variant); let split: i32 = input.length; if (split > 65) { split = 65; }
    current.update(view(input.values, input.start, split)).unwrap();
    let fork: core::sha256::State = current;
    // Diverge both partial copies before either finishes. Construct the fork's
    // expected message in independent storage, then hash it from a fresh state.
    feed(current.borrow(), view(input.values, input.start+split, input.length-split), schedule);
    let extension: [u8; 3] = [255, 0, 17]; fork.update(view(extension, 0, 3)).unwrap();
    let alternative: [u8; 68] = [0; 68]; let index: i32 = 0;
    while (index < split) { alternative[index] = input.values[input.start+index]; index += 1; }
    alternative[split] = 255; alternative[split+1] = 0; alternative[split+2] = 17;
    let actual: core::sha256::Digest = current.finish(); let forked: core::sha256::Digest = fork.finish();
    equal(actual, reference); equal(forked, one_shot(variant, view(alternative, 0, split+3)));
    let repeated: core::sha256::Digest = current.finish(); equal(actual, repeated);
    let first: u8 = actual.bytes[0]; reference.bytes[0] ^= 255;
    assert(actual.bytes[0] == first && repeated.bytes[0] == first && current.finish().bytes[0] == first);
    let retained: core::sha256::Digest = actual;
    current.reset(); feed(current.borrow(), input, schedule); let reset: core::sha256::Digest = current.finish();
    equal(actual, reset); equal(actual, retained); equal(actual, repeated);
    let unrelated: core::sha256::Digest = one_shot(variant, view(extension, 0, 3)); assert(unrelated.length == actual.length);
    retained.bytes[1] ^= 255;
    assert(actual.bytes[1] == reset.bytes[1] && repeated.bytes[1] == reset.bytes[1] && current.finish().bytes[1] == reset.bytes[1]);
    equal(actual, reset); return actual;
}
fn decode(bytes: [u8], offset: i32) -> u64 {
    let value: u64 = 0; let index: i32 = 0;
    while (index < 8) { value |= (bytes[offset+index] as u64) << (index*8); index += 1; } return value;
}
fn emit(value: core::sha256::Digest) {
    let output: std::stream::Descriptor = std::stream::stdout(); let bytes: [u8; 40] = [0; 40];
    let index: i32 = 0; let length: u64 = value.length as u64;
    while (index < 8) { bytes[index] = ((length >> (index*8)) & 255) as u8; index += 1; }
    index = 0; while (index < 32) { bytes[8+index] = value.bytes[index]; index += 1; }
    core::io::write_all(output.borrow(), bytes, 0, 40).unwrap();
}
fn main() -> i32 {
    contracts(); let input: std::stream::Descriptor = std::stream::stdin(); let header: [u8; 32] = [0; 32];
    let backing: [i32; 1025] = [0; 1025];
    let packed: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(backing), 4100);
    let strided: [u8; 4100] = [0; 4100];
    while (true) {
        let received: i32 = input.read(header, 0, 32).unwrap(); if (received == 0) { return 0; }
        if (received < 32) { core::io::read_exact(input.borrow(), header, received, 32-received).unwrap(); }
        let variant: u64 = decode(header, 0); let length: u64 = decode(header, 8);
        let schedule: u64 = decode(header, 16); let layout: u64 = decode(header, 24);
        assert(variant <= 1 && length <= 4096 && schedule <= 7 && layout <= 1); let count: i32 = length as i32;
        packed[0] = 165; packed[count+1] = 90; strided[0] = 165; strided[count+1] = 90;
        core::io::read_exact(input.borrow(), packed, 1, count).unwrap(); let index: i32 = 0;
        while (index < count) { strided[index+1] = packed[index+1]; index += 1; }
        let selected: core::slice::View<u8> = view(strided, 1, count); if (layout == 1) { selected = view(packed, 1, count); }
        emit(check_case(variant as i32, schedule as i32, selected));
        assert(packed[0] == 165 && packed[count+1] == 90 && strided[0] == 165 && strided[count+1] == 90);
        index = 0; while (index < count) { assert(packed[index+1] == strided[index+1]); index += 1; }
    }
    return 0;
}
