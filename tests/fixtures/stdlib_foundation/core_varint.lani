module app::main;
import core::varint;
import core::varint_wide_u64;
import core::wide_u64;

fn main() -> i32 {
    if (core::varint::OK != 0 || core::varint::INVALID_BOUNDS != 1 ||
        core::varint::TRUNCATED != 2 || core::varint::OVERFLOW != 3 ||
        core::varint::NON_CANONICAL != 4) { return 1; }
    let max: core::wide_u64::WideU64 = core::wide_u64::max_value();
    if (core::varint::len_u32(0) != 1 || core::varint::len_u32(127) != 1 ||
        core::varint::len_u32(128) != 2 ||
        core::varint::len_u32(4294967295) != 5 ||
        core::varint_wide_u64::len_wide_u64(core::wide_u64::zero()) != 1 ||
        core::varint_wide_u64::len_wide_u64(core::wide_u64::from_words(1, 0)) != 5 ||
        core::varint_wide_u64::len_wide_u64(max) != 10) { return 2; }

    let marker: u8 = 170;
    let bytes: [u8; 20] = [
        marker, marker, marker, marker, marker,
        marker, marker, marker, marker, marker,
        marker, marker, marker, marker, marker,
        marker, marker, marker, marker, marker];
    if (core::varint::write_u32(bytes, 20, 1, 300) != 3 ||
        bytes[0] != marker || bytes[1] != 172 || bytes[2] != 2 ||
        bytes[3] != marker) { return 3; }
    if (core::varint_wide_u64::write_wide_u64(bytes, 20, 3, max) != 13 ||
        bytes[3] != 255 || bytes[4] != 255 || bytes[5] != 255 ||
        bytes[6] != 255 || bytes[7] != 255 || bytes[8] != 255 ||
        bytes[9] != 255 || bytes[10] != 255 || bytes[11] != 255 ||
        bytes[12] != 1 || bytes[13] != marker) { return 4; }

    let small: core::varint::ReadU32 = core::varint::read_u32(bytes, 20, 1);
    if (core::varint::status_u32(small) != core::varint::OK ||
        core::varint::value_u32_or(small, 99) != 300 ||
        core::varint::next_u32_or(small, 99) != 3) { return 5; }
    let wide: core::varint_wide_u64::ReadWideU64 = core::varint_wide_u64::read_wide_u64(bytes, 20, 3);
    if (core::varint_wide_u64::status_wide_u64(wide) != core::varint::OK) { return 61; }
    let decoded_wide: core::wide_u64::WideU64 =
        core::varint_wide_u64::value_wide_u64_or(wide, core::wide_u64::zero());
    if (core::wide_u64::high_word(decoded_wide) != 4294967295) { return 62; }
    if (core::wide_u64::low_word(decoded_wide) != 4294967295) { return 63; }
    if (core::varint_wide_u64::next_wide_u64_or(wide, 99) != 13) { return 64; }

    if (core::varint::write_u32(bytes, 20, -1, 7) != -1 ||
        core::varint::write_u32(bytes, 20, 19, 128) != -1 ||
        core::varint_wide_u64::write_wide_u64(bytes, 20, 11, max) != -1 ||
        core::varint_wide_u64::write_wide_u64(bytes, -1, 0, max) != -1 ||
        bytes[0] != marker || bytes[13] != marker || bytes[19] != marker) { return 7; }

    let invalid: core::varint::ReadU32 = core::varint::read_u32(bytes, 20, -1);
    let truncated: core::varint::ReadU32 = core::varint::read_u32(bytes, 2, 1);
    if (core::varint::status_u32(invalid) != core::varint::INVALID_BOUNDS ||
        core::varint::status_u32(truncated) != core::varint::TRUNCATED ||
        core::varint::value_u32_or(truncated, 77) != 77 ||
        core::varint::next_u32_or(truncated, 88) != 88) { return 8; }

    let b128: u8 = 128;
    let b0: u8 = 0;
    let b255: u8 = 255;
    let b16: u8 = 16;
    let b2: u8 = 2;
    let bad: [u8; 11] = [b128, b0, b255, b255, b255, b255, b16,
        b255, b255, b255, b255];
    let noncanonical: core::varint::ReadU32 = core::varint::read_u32(bad, 11, 0);
    let overflow: core::varint::ReadU32 = core::varint::read_u32(bad, 11, 2);
    if (core::varint::status_u32(noncanonical) != core::varint::NON_CANONICAL ||
        core::varint::status_u32(overflow) != core::varint::OVERFLOW) { return 9; }
    let wide_invalid: core::varint_wide_u64::ReadWideU64 = core::varint_wide_u64::read_wide_u64(bytes, 20, 21);
    let wide_truncated: core::varint_wide_u64::ReadWideU64 = core::varint_wide_u64::read_wide_u64(bytes, 12, 3);
    if (core::varint_wide_u64::status_wide_u64(wide_invalid) != core::varint::INVALID_BOUNDS ||
        core::varint_wide_u64::status_wide_u64(wide_truncated) != core::varint::TRUNCATED ||
        !core::wide_u64::eq(core::varint_wide_u64::value_wide_u64_or(wide_truncated,
            core::wide_u64::from_u32(77)), core::wide_u64::from_u32(77)) ||
        core::varint_wide_u64::next_wide_u64_or(wide_truncated, 88) != 88) { return 10; }

    let overlong: [u8; 10] = [b128, b128, b128, b128, b128,
        b128, b128, b128, b128, b0];
    if (core::varint_wide_u64::status_wide_u64(core::varint_wide_u64::read_wide_u64(overlong, 10, 0)) !=
        core::varint::NON_CANONICAL) { return 11; }
    let too_large: [u8; 10] = [b255, b255, b255, b255, b255,
        b255, b255, b255, b255, b2];
    if (core::varint_wide_u64::status_wide_u64(core::varint_wide_u64::read_wide_u64(too_large, 10, 0)) !=
        core::varint::OVERFLOW) { return 12; }

    if (core::varint::write_u32(bytes, 20, 0, 0) != 1 || bytes[0] != 0 ||
        core::varint_wide_u64::write_wide_u64(bytes, 20, 13, core::wide_u64::zero()) != 14 ||
        bytes[13] != 0 ||
        core::varint::value_u32_or(core::varint::read_u32(bytes, 20, 0), 99) != 0 ||
        !core::wide_u64::eq(core::varint_wide_u64::value_wide_u64_or(
            core::varint_wide_u64::read_wide_u64(bytes, 20, 13), max), core::wide_u64::zero())) {
        return 13;
    }
    return 0;
}
