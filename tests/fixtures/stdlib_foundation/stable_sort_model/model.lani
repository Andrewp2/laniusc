// Test-only stable-sort binary adapter; no host sorting implementation.
module app::main;
import core::cmp;
import core::mem;
import core::option;
import core::ordering;
import core::result;
import core::slice;
import alloc::slice;
import alloc::vec;
import std::io;

fn read_exact(pointer: ptr, count: i32, allow_eof: bool) -> bool {
    let done: i32 = 0;
    while (done < count) {
        let got: i32 = std::io::read_stdin(pointer + (done as usize), (count - done) as usize);
        assert(got >= 0);
        if (got == 0) { assert(allow_eof && done == 0); return false; }
        done += got;
    }
    return true;
}

fn write_all(pointer: ptr, count: i32) {
    let done: i32 = 0;
    while (done < count) {
        let got: i32 = std::io::write_stdout(pointer + (done as usize), (count - done) as usize);
        assert(got > 0);
        done += got;
    }
}

fn get64(bytes: [u8], offset: i32) -> u64 {
    let result: u64 = 0;
    let index: i32 = 0;
    while (index < 8) {
        result |= (bytes[offset + index] as u64) << (index * 8);
        index += 1;
    }
    return result;
}

struct Output { bytes: [u8], pointer: ptr, used: i32 }
impl Output {
    fn borrow(&self) -> &Output { return self; }
    fn flush(&self) { write_all(self.pointer, self.used); self.used = 0; }
    fn word(&self, value: u64) {
        if (self.used == 4096) { self.flush(); }
        let index: i32 = 0;
        while (index < 8) {
            self.bytes[self.used + index] = ((value >> (index * 8)) & 255) as u8;
            index += 1;
        }
        self.used += 8;
    }
}

struct Counts { calls:u64 }
impl Counts { fn borrow(&self) -> &Counts { return self; } }
pub struct Payload { marker:u64, parts:[u64;2], flag:core::option::Option<bool>, event:core::result::Result<u64,[i64;2]> }
pub struct Row<P> { key:i64, secondary:i64, id:u64, payload:P, counts:&Counts }
fn row(key:i64,secondary:i64,id:u64,counts:&Counts) -> Row<Payload> {
    let flag:core::option::Option<bool> = core::option::None();
    if(id%3!=0) { flag=core::option::Some(id%2==0); }
    let event:core::result::Result<u64,[i64;2]> = core::result::Ok(id*19+7);
    if(id%3!=0) { event=core::result::Err([(id*23+3) as i64,(4611686018427387904+id*29) as i64]); }
    return Row { key:key,secondary:secondary,id:id,counts:counts,payload:Payload {
        marker:18446744073709551615-id*17,parts:[id*97+3,9223372036854775808+id*131],flag:flag,event:event
    } };
}
pub impl<P> core::cmp::Ord<Row<P>> for Row<P> {
    pub fn lt(left:Row<P>,right:Row<P>) -> bool { let counts:&Counts=left.counts; counts.calls+=1; return left.key<right.key; }
    pub fn le(left:Row<P>,right:Row<P>) -> bool { return left.key<=right.key; }
    pub fn gt(left:Row<P>,right:Row<P>) -> bool { return left.key>right.key; }
    pub fn ge(left:Row<P>,right:Row<P>) -> bool { return left.key>=right.key; }
}
struct Compare { mode:i32,counts:&Counts }
struct BytesCompare { mode:i32,counts:&Counts }
impl Compare { fn borrow(&self) -> &Compare { return self; } }
impl BytesCompare { fn borrow(&self) -> &BytesCompare { return self; } }
fn relation(a:i64,b:i64,mode:i32) -> core::ordering::Ordering {
    let left:i64=a; let right:i64=b;
    if(mode==2) { left&=3; right&=3; }
    let order:core::ordering::Ordering=core::ordering::Equal;
    if(left<right) { order=core::ordering::Less; }
    if(left>right) { order=core::ordering::Greater; }
    if(mode==1 || mode==4) { return core::ordering::reverse(order); }
    return order;
}
pub impl core::ordering::Comparator<Row<Payload>,Row<Payload>> for Compare {
    pub fn compare(&self,left:Row<Payload>,right:Row<Payload>) -> core::ordering::Ordering {
        let counts:&Counts=self.counts; counts.calls+=1;
        let a:i64=left.key; let b:i64=right.key;
        if(self.mode==3 || self.mode==4) { a=left.secondary; b=right.secondary; }
        return relation(a,b,self.mode);
    }
}
pub impl core::ordering::Comparator<u8,u8> for BytesCompare {
    pub fn compare(&self,left:u8,right:u8) -> core::ordering::Ordering {
        let counts:&Counts=self.counts; counts.calls+=1;
        return relation(left as i64,right as i64,self.mode);
    }
}
fn storage_code(error:alloc::vec::Error) -> u64 {
    return match(error) { alloc::vec::Error::Bounds -> 2,alloc::vec::Error::InvalidCapacity -> 3,
        alloc::vec::Error::CapacityOverflow -> 4,alloc::vec::Error::AllocationFailed -> 5 };
}
fn error_code(error:alloc::slice::Error) -> u64 {
    return match(error) { alloc::slice::Error::Bounds -> 1,alloc::slice::Error::Storage(value) -> storage_code(value) };
}
fn emit_result(result:core::result::Result<i32,alloc::slice::Error>,before:u64,counts:&Counts,size:usize,stride:isize,output:&Output) {
    let tag:u64=0; let code:u64=0; let count:i32=0;
    if(result.is_ok()) { count=result.unwrap(); }
    else { tag=1; code=error_code(result.unwrap_err()); }
    output.word(tag); output.word(code); output.word(count as i64 as u64);
    output.word(before); output.word(counts.calls); output.word(size as u64); output.word(stride as i64 as u64);
}
fn length<T>(input:[u8]) -> i32 {
    let selected:i32=get64(input,32) as i32;
    if(get64(input,40)==1) {
        let size:usize=core::mem::size_of<T>(); assert(size>1);
        selected=(2147483647/size) as i32; selected+=1;
    }
    return selected;
}
fn bytes_run(input:[u8],output:&Output) {
    let native:[u8;72]=[0;72]; let words:[i32;18]=[0;18]; let values:[u8]=native;
    if(get64(input,8)==1) { values=core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(words),72); }
    if(get64(input,8)==0) { assert(core::mem::slice_stride(values)<0); }
    else { assert(core::mem::slice_stride(values)==1); }
    let index:i32=0; while(index<72) { values[index]=(160+index) as u8; index+=1; }
    let count:i32=get64(input,16) as i32; index=0;
    while(index<count) { values[4+index]=get64(input,64+index*16) as u8; index+=1; }
    let view:core::slice::View<u8> = core::slice::View { values:values,start:get64(input,24) as i32,length:length<u8>(input) };
    let counts:Counts=Counts { calls:11+get64(input,56)%7 }; index=0;
    while(index<get64(input,48) as i32) {
        let at:i32=64+count*16+index*16; let operation:u64=get64(input,at); let mode:i32=get64(input,at+8) as i32;
        let compare:BytesCompare=BytesCompare { mode:mode,counts:counts.borrow() }; let before:u64=counts.calls;
        let result:core::result::Result<i32,alloc::slice::Error> = core::result::Ok(0);
        if(operation==0) { result=alloc::slice::sort<u8>(view); }
        else { result=alloc::slice::sort_by<u8,BytesCompare>(view,compare.borrow()); }
        emit_result(result,before,counts.borrow(),core::mem::size_of<u8>(),core::mem::slice_stride(values),output);
        let cell:i32=0; while(cell<72) { output.word(values[cell] as u64); cell+=1; } index+=1;
    }
}
fn emit_rows(values:[Row<Payload>],output:&Output) {
    let index:i32=0;
    while(index<72) {
        let value:Row<Payload> = values[index]; output.word(value.key as u64); output.word(value.secondary as u64); output.word(value.id);
        output.word(value.payload.marker); output.word(value.payload.parts[0]); output.word(value.payload.parts[1]);
        let flag:u64=0; if(value.payload.flag.is_some()) { flag=1; if(value.payload.flag.unwrap()) { flag=2; } }
        output.word(flag); let tag:u64=0; let first:u64=0; let second:u64=0;
        if(value.payload.event.is_ok()) { first=value.payload.event.unwrap(); }
        else { tag=1; let parts:[i64;2]=value.payload.event.unwrap_err(); first=parts[0] as u64; second=parts[1] as u64; }
        output.word(tag); output.word(first); output.word(second); index+=1;
    }
}
fn records_run(input:[u8],output:&Output) {
    let counts:Counts=Counts { calls:11+get64(input,56)%7 };
    let native:[Row<Payload>;72]=[row(0,0,0,counts.borrow());72]; let words:[i32;2048]=[0;2048];
    assert(core::mem::size_of<Row<Payload>>()*72<=8192);
    let values:[Row<Payload>]=native;
    if(get64(input,8)==1) { values=core::mem::typed_slice_from_storage<Row<Payload>>(core::mem::i32_array_data_ptr(words),72); }
    assert(core::mem::slice_stride(values)<0);
    let index:i32=0;
    while(index<72) { values[index]=row(10000+index as i64,-10000-index as i64,4000000000+index as u64,counts.borrow()); index+=1; }
    let count:i32=get64(input,16) as i32; index=0;
    while(index<count) { values[4+index]=row(get64(input,64+index*16) as i64,get64(input,72+index*16) as i64,
        get64(input,56)*128+index as u64+1,counts.borrow()); index+=1; }
    let view:core::slice::View<Row<Payload>> = core::slice::View { values:values,start:get64(input,24) as i32,length:length<Row<Payload>>(input) };
    index=0;
    while(index<get64(input,48) as i32) {
        let at:i32=64+count*16+index*16; let operation:u64=get64(input,at); let mode:i32=get64(input,at+8) as i32;
        let compare:Compare=Compare { mode:mode,counts:counts.borrow() }; let before:u64=counts.calls;
        let result:core::result::Result<i32,alloc::slice::Error> = core::result::Ok(0);
        if(operation==0) { result=alloc::slice::sort<Row<Payload>>(view); }
        else { result=alloc::slice::sort_by<Row<Payload>,Compare>(view,compare.borrow()); }
        emit_result(result,before,counts.borrow(),core::mem::size_of<Row<Payload>>(),core::mem::slice_stride(values),output);
        emit_rows(values,output); index+=1;
    }
}
fn main() -> i32 {
    let input_words:[i32;300]=[0;300]; let pointer:ptr=core::mem::i32_array_data_ptr(input_words);
    let input:[u8]=core::mem::typed_slice_from_raw_parts<u8>(pointer,1200);
    let output_words:[i32;1024]=[0;1024]; let output_pointer:ptr=core::mem::i32_array_data_ptr(output_words);
    let output_bytes:[u8]=core::mem::typed_slice_from_raw_parts<u8>(output_pointer,4096);
    let output:Output=Output { bytes:output_bytes,pointer:output_pointer,used:0 };
    while(read_exact(pointer,64,true)) {
        assert(get64(input,0)<=1 && get64(input,8)<=1 && get64(input,16)<=65 && get64(input,40)<=1 && get64(input,48)>=1 && get64(input,48)<=4);
        assert(!(get64(input,0)==0 && get64(input,40)!=0));
        let tail:i32=(get64(input,16)*16+get64(input,48)*16) as i32;
        assert(read_exact(pointer+64,tail,false));
        if(get64(input,0)==0) { bytes_run(input,output.borrow()); }
        else { records_run(input,output.borrow()); }
    }
    output.flush(); return 0;
}
