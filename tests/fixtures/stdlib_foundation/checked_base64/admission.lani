module app::main;
import core::base64;
import core::result;
import core::slice;

fn profile(mode:i32) -> core::base64::Profile {
    return match(mode) { 0 -> core::base64::Profile::Standard,1 -> core::base64::Profile::StandardUnpadded,2 -> core::base64::Profile::UrlSafe,_ -> core::base64::Profile::UrlSafeUnpadded };
}
fn main() -> i32 {
    let raw:[u8;5]=[99,102,111,111,98]; let out:[u8;8]=[199;8];
    let input:core::slice::View<u8> =core::slice::view_range<u8>(raw,1,3).unwrap();
    let output:core::slice::View<u8> =core::slice::view_range<u8>(out,1,6).unwrap();
    assert(core::base64::encoded_len(3,core::base64::Profile::Standard).unwrap()==4);
    assert(core::base64::encode_into(input,output,core::base64::Profile::Standard).unwrap()==4);
    assert(out[0]==199 && out[1]==90 && out[2]==109 && out[3]==57 && out[4]==118 && out[5]==199 && out[7]==199);
    let wire:core::slice::View<u8> =core::slice::view_range<u8>(out,1,4).unwrap();
    assert(core::base64::decoded_len(wire,core::base64::Profile::Standard).unwrap()==3);
    let decoded:[u8;5]=[199;5]; let destination:core::slice::View<u8> =core::slice::view_range<u8>(decoded,1,3).unwrap();
    assert(core::base64::decode_into(wire,destination,core::base64::Profile::Standard).unwrap()==3);
    assert(decoded[0]==199 && decoded[1]==102 && decoded[2]==111 && decoded[3]==111 && decoded[4]==199);
    let mode:i32=0;
    while(mode<4) {
        let data:[u8;12]=[199;12]; data[2]=251; data[3]=255; let selected:core::base64::Profile=profile(mode);
        let raw_view:core::slice::View<u8> =core::slice::view_range<u8>(data,2,2).unwrap();
        let room:core::slice::View<u8> =core::slice::view_range<u8>(data,2,6).unwrap();
        let count:i32=4; if(mode%2==1) { count=3; }
        assert(core::base64::encoded_len(2,selected).unwrap()==count && core::base64::encode_into(raw_view,room,selected).unwrap()==count);
        if(mode<2) { assert(data[2]==43 && data[3]==47); } else { assert(data[2]==45 && data[3]==95); }
        assert(data[4]==56); if(count==4) { assert(data[5]==61); } else { assert(data[5]==199); }
        let encoded:core::slice::View<u8> =core::slice::view_range<u8>(data,2,count).unwrap();
        assert(core::base64::decoded_len(encoded,selected).unwrap()==2);
        assert(core::base64::decode_into(encoded,raw_view,selected).unwrap()==2);
        assert(data[2]==251 && data[3]==255 && data[4]==56 && data[0]==199 && data[1]==199 && data[8]==199 && data[11]==199);
        mode+=1;
    }
    let invalid:[u8;4]=[43,47,56,61]; let invalid_view:core::slice::View<u8> =core::slice::view_range<u8>(invalid,0,4).unwrap();
    let rejected:core::result::Result<i32,core::base64::Error> =core::base64::decoded_len(invalid_view,core::base64::Profile::UrlSafe);
    assert(match(rejected.unwrap_err()) { core::base64::Error::InvalidByte(index) -> index==0, _ -> false });
    assert(invalid[0]==43 && invalid[1]==47 && invalid[2]==56 && invalid[3]==61);
    return 0;
}
