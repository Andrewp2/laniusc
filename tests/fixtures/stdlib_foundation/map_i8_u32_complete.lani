module app::main;
import std::map_i8_u32;
import core::mem;
import alloc::allocator;

fn check(values: [u32]) -> i32 {
    let zero: u32 = 0;
    let maximum: u32 = 4294967295;
    let keys: [u32; 8] = [zero, zero, zero, zero, zero, zero, zero, zero];
    std::map_i8_u32::clear(keys, values);
    if (!std::map_i8_u32::is_empty(keys) || std::map_i8_u32::is_full(keys) ||
        std::map_i8_u32::len(keys) != 0 ||
        std::map_i8_u32::contains_key(keys, -128) ||
        std::map_i8_u32::get_or(keys, values, -128, maximum) != maximum ||
        std::map_i8_u32::key_at_or(keys, 0, -7) != -7 ||
        std::map_i8_u32::value_at_or(keys, values, 0, maximum) != maximum) {
        return 1;
    }

    if (!std::map_i8_u32::insert(keys, values, -128, maximum) ||
        !std::map_i8_u32::insert(keys, values, -1, 0) ||
        !std::map_i8_u32::insert(keys, values, 0, 17) ||
        !std::map_i8_u32::insert(keys, values, 127, 23) ||
        std::map_i8_u32::insert(keys, values, -128, 1)) { return 2; }
    if (std::map_i8_u32::len(keys) != 4 ||
        std::map_i8_u32::key_at_or(keys, 0, 3) != -128 ||
        std::map_i8_u32::key_at_or(keys, 1, 3) != -1 ||
        std::map_i8_u32::key_at_or(keys, 2, 3) != 0 ||
        std::map_i8_u32::key_at_or(keys, 3, 3) != 127 ||
        std::map_i8_u32::key_at_or(keys, -1, 3) != 3 ||
        std::map_i8_u32::key_at_or(keys, 4, 3) != 3 ||
        std::map_i8_u32::value_at_or(keys, values, 0, 1) != maximum ||
        std::map_i8_u32::value_at_or(keys, values, 1, 1) != 0 ||
        std::map_i8_u32::value_at_or(keys, values, 4, 1) != 1 ||
        std::map_i8_u32::get_or(keys, values, -128, 1) != maximum) {
        return 3;
    }

    if (std::map_i8_u32::put(keys, values, -1, 9) ||
        !std::map_i8_u32::put(keys, values, 7, 42) ||
        !std::map_i8_u32::set(keys, values, 0, 0) ||
        std::map_i8_u32::set(keys, values, 6, 99) ||
        !std::map_i8_u32::remove(keys, values, 127) ||
        std::map_i8_u32::remove(keys, values, 127) ||
        std::map_i8_u32::len(keys) != 4 ||
        std::map_i8_u32::get_or(keys, values, -1, 1) != 9 ||
        std::map_i8_u32::get_or(keys, values, 0, 1) != 0 ||
        std::map_i8_u32::get_or(keys, values, 7, 1) != 42 ||
        std::map_i8_u32::get_or(keys, values, 127, 1) != 1 ||
        values[255] != 0) { return 4; }

    let ordinal: i32 = 0;
    while (ordinal < 256) {
        let key: i8 = (ordinal - 128) as i8;
        let value: u32 = ordinal as u32;
        std::map_i8_u32::put(keys, values, key, value);
        ordinal += 1;
    }
    if (!std::map_i8_u32::is_full(keys) || std::map_i8_u32::len(keys) != 256) {
        return 5;
    }
    ordinal = 0;
    while (ordinal < 256) {
        let key: i8 = (ordinal - 128) as i8;
        let value: u32 = ordinal as u32;
        if (!std::map_i8_u32::contains_key(keys, key) ||
            std::map_i8_u32::get_or(keys, values, key, maximum) != value ||
            std::map_i8_u32::key_at_or(keys, ordinal, 0) != key ||
            std::map_i8_u32::value_at_or(keys, values, ordinal, maximum) != value) {
            return 6;
        }
        ordinal += 1;
    }
    std::map_i8_u32::clear(keys, values);
    if (!std::map_i8_u32::is_empty(keys) || std::map_i8_u32::len(keys) != 0 ||
        values[0] != 0 || values[127] != 0 || values[128] != 0 ||
        values[255] != 0) { return 7; }
    return 0;
}

fn main() -> i32 {
    let memory: ptr = alloc::allocator::alloc(2048, 8);
    if (memory == 0) { return 8; }
    let first: ptr = memory + 2040;
    let values: [u32] = core::mem::typed_slice_from_raw_parts(first, 256);
    let result: i32 = check(values);
    alloc::allocator::dealloc(memory, 2048, 8);
    return result;
}
