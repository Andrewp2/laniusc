module app::main;
import std::vec_u32;

fn main() -> i32 {
    let value: std::vec_u32::VecU32 = std::vec_u32::try_with_capacity(1);
    if (std::vec_u32::capacity(value) != 1) { return 2; }
    value = std::vec_u32::try_push(value, 4294967295);
    if (std::vec_u32::len(value) != 1) { return 3; }
    value = std::vec_u32::try_push(value, 2147483648);
    if (std::vec_u32::len(value) != 1 || std::vec_u32::capacity(value) != 1) { return 4; }
    if (std::vec_u32::get_or(value, 0, 0) != 4294967295) { return 5; }
    std::vec_u32::destroy(value);
    return 0;
}
