module app::main;
import std::map_char_u32;

fn main() -> i32 {
    let value: std::map_char_u32::MapCharU32 = std::map_char_u32::new();
    value = std::map_char_u32::try_insert(value, 3, 5);
    if (std::map_char_u32::len(value) == 0 &&
        std::map_char_u32::capacity(value) == 0 &&
        !std::map_char_u32::contains_key(value, 3)) {
        std::map_char_u32::destroy(value);
        return 0;
    }
    if (std::map_char_u32::len(value) == 1 &&
        std::map_char_u32::get_or(value, 3, 4294967295) == 5) {
        std::map_char_u32::destroy(value);
        return 4;
    }
    std::map_char_u32::destroy(value);
    return 5;
}
