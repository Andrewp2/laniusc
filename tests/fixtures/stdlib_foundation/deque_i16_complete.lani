module app::main;
import std::deque_i16;

fn main() -> i32 {
    let value: std::deque_i16::DequeI16 = std::deque_i16::new();
    if (std::deque_i16::MAX_CAPACITY != 536870911 ||
        !std::deque_i16::is_empty(value) ||
        std::deque_i16::len(value) != 0 ||
        std::deque_i16::capacity(value) != 0 ||
        std::deque_i16::front_or(value, 77) != 77 ||
        std::deque_i16::back_or(value, 78) != 78 ||
        std::deque_i16::at_or(value, 0, 79) != 79 ||
        std::deque_i16::contains(value, 0) ||
        std::deque_i16::try_set(value, 0, 7) ||
        std::deque_i16::try_swap(value, 0, 0)) { return 1; }
    value = std::deque_i16::try_pop_front(value);
    value = std::deque_i16::try_pop_back(value);
    if (std::deque_i16::len(value) != 0) { return 2; }
    value = std::deque_i16::try_reserve(value, -1);
    value = std::deque_i16::try_reserve(value, 536870912);
    if (std::deque_i16::capacity(value) != 0) { return 3; }
    std::deque_i16::destroy(value);

    let items: std::deque_i16::DequeI16 = std::deque_i16::try_with_capacity(3);
    if (std::deque_i16::capacity(items) != 3 || !std::deque_i16::is_empty(items)) { return 4; }
    items = std::deque_i16::try_push_back(items, 10);
    items = std::deque_i16::try_push_back(items, 20);
    items = std::deque_i16::try_push_back(items, 30);
    if (std::deque_i16::len(items) != 3 || std::deque_i16::capacity(items) != 3 ||
        std::deque_i16::front_or(items, 99) != 10 ||
        std::deque_i16::back_or(items, 99) != 30) { return 5; }
    items = std::deque_i16::try_pop_front(items);
    items = std::deque_i16::try_push_back(items, 40);
    if (std::deque_i16::len(items) != 3 ||
        std::deque_i16::at_or(items, 0, 99) != 20 ||
        std::deque_i16::at_or(items, 1, 99) != 30 ||
        std::deque_i16::at_or(items, 2, 99) != 40) { return 6; }
    items = std::deque_i16::try_pop_front(items);
    items = std::deque_i16::try_push_front(items, 25);
    if (std::deque_i16::len(items) != 3 ||
        std::deque_i16::at_or(items, 0, 99) != 25 ||
        std::deque_i16::at_or(items, 1, 99) != 30 ||
        std::deque_i16::at_or(items, 2, 99) != 40) { return 7; }
    items = std::deque_i16::try_push_back(items, 50);
    if (std::deque_i16::len(items) != 4 || std::deque_i16::capacity(items) != 6 ||
        std::deque_i16::front_or(items, 99) != 25 ||
        std::deque_i16::back_or(items, 99) != 50 ||
        std::deque_i16::at_or(items, 1, 99) != 30 ||
        std::deque_i16::at_or(items, 2, 99) != 40 ||
        std::deque_i16::at_or(items, -1, 77) != 77 ||
        std::deque_i16::at_or(items, 4, 78) != 78 ||
        !std::deque_i16::contains(items, 40) ||
        std::deque_i16::contains(items, 60)) { return 8; }
    if (std::deque_i16::try_set(items, -1, 2) ||
        std::deque_i16::try_set(items, 4, 2) ||
        !std::deque_i16::try_set(items, 1, -32768) ||
        std::deque_i16::at_or(items, 1, 0) != -32768 ||
        !std::deque_i16::contains(items, -32768) ||
        std::deque_i16::try_swap(items, 0, 4) ||
        !std::deque_i16::try_swap(items, 0, 3) ||
        std::deque_i16::front_or(items, 99) != 50 ||
        std::deque_i16::back_or(items, 99) != 25 ||
        !std::deque_i16::try_swap(items, 0, 3)) { return 9; }

    let copy: std::deque_i16::DequeI16 = std::deque_i16::try_clone(items);
    if (std::deque_i16::len(copy) != 4 || std::deque_i16::capacity(copy) != 4 ||
        std::deque_i16::at_or(copy, 1, 0) != -32768) { return 10; }
    if (!std::deque_i16::try_set(copy, 1, -1) ||
        std::deque_i16::at_or(copy, 1, 0) != -1 ||
        std::deque_i16::at_or(items, 1, 0) != -32768) { return 11; }
    std::deque_i16::destroy(copy);

    items = std::deque_i16::try_pop_back(items);
    items = std::deque_i16::try_pop_front(items);
    if (std::deque_i16::len(items) != 2 ||
        std::deque_i16::front_or(items, 0) != -32768 ||
        std::deque_i16::back_or(items, 0) != 40) { return 12; }
    items = std::deque_i16::try_shrink_to_fit(items);
    if (std::deque_i16::capacity(items) != 2 ||
        std::deque_i16::at_or(items, 0, 0) != -32768 ||
        std::deque_i16::at_or(items, 1, 0) != 40) { return 13; }
    items = std::deque_i16::try_shrink_to_fit(items);
    if (std::deque_i16::capacity(items) != 2) { return 14; }
    items = std::deque_i16::clear(items);
    if (!std::deque_i16::is_empty(items) || std::deque_i16::capacity(items) != 2 ||
        std::deque_i16::contains(items, 40)) { return 15; }
    let empty_copy: std::deque_i16::DequeI16 = std::deque_i16::try_clone(items);
    if (std::deque_i16::len(empty_copy) != 0 ||
        std::deque_i16::capacity(empty_copy) != 0) { return 16; }
    std::deque_i16::destroy(empty_copy);
    items = std::deque_i16::try_push_front(items, -1);
    if (std::deque_i16::front_or(items, 0) != -1) { return 17; }
    items = std::deque_i16::try_pop_front(items);
    items = std::deque_i16::try_shrink_to_fit(items);
    if (std::deque_i16::capacity(items) != 0) { return 18; }
    std::deque_i16::destroy(items);

    let wrapped: std::deque_i16::DequeI16 = std::deque_i16::try_with_capacity(3);
    wrapped = std::deque_i16::try_push_back(wrapped, 1);
    wrapped = std::deque_i16::try_push_back(wrapped, 2);
    wrapped = std::deque_i16::try_push_back(wrapped, 3);
    wrapped = std::deque_i16::try_pop_front(wrapped);
    wrapped = std::deque_i16::try_push_back(wrapped, -1);
    wrapped = std::deque_i16::try_reserve(wrapped, 5);
    if (std::deque_i16::capacity(wrapped) != 5 ||
        std::deque_i16::len(wrapped) != 3 ||
        std::deque_i16::at_or(wrapped, 0, 0) != 2 ||
        std::deque_i16::at_or(wrapped, 1, 0) != 3 ||
        std::deque_i16::at_or(wrapped, 2, 0) != -1) { return 19; }
    std::deque_i16::destroy(wrapped);

    // Repeated wraparound must preserve every possible signed halfword value.
    let sweep: std::deque_i16::DequeI16 = std::deque_i16::try_with_capacity(3);
    if (std::deque_i16::capacity(sweep) != 3) { return 20; }
    let raw: i32 = -32768;
    while (raw <= 32767) {
        let halfword_value: i16 = raw as i16;
        sweep = std::deque_i16::try_push_back(sweep, halfword_value);
        if (std::deque_i16::len(sweep) != 1 ||
            std::deque_i16::front_or(sweep, 0) != halfword_value ||
            std::deque_i16::back_or(sweep, 0) != halfword_value) { return 21; }
        sweep = std::deque_i16::try_pop_front(sweep);
        if (std::deque_i16::len(sweep) != 0) { return 22; }
        raw += 1;
    }
    std::deque_i16::destroy(sweep);
    return 0;
}
