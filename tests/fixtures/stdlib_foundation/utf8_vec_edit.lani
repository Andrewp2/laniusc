module app::main;
import std::utf8_vec;
import std::vec_u8;

fn main() -> i32 {
    let empty: std::vec_u8::VecU8 = std::utf8_vec::new();
    empty = std::utf8_vec::try_remove_scalar(empty, 0);
    if (std::utf8_vec::byte_len(empty) != 0) { return 1; }
    empty = std::utf8_vec::try_insert_scalar(empty, 0, 65);
    if (std::utf8_vec::byte_len(empty) != 1 ||
        std::utf8_vec::scalar_at_or(empty, 0, 4294967295) != 65) { return 2; }
    empty = std::utf8_vec::try_remove_scalar(empty, 0);
    if (std::utf8_vec::byte_len(empty) != 0 ||
        !std::utf8_vec::is_valid(empty)) { return 3; }

    let text: std::vec_u8::VecU8 = std::utf8_vec::new();
    text = std::utf8_vec::try_append_scalar(text, 65);
    text = std::utf8_vec::try_append_scalar(text, 162);
    text = std::utf8_vec::try_append_scalar(text, 66);
    if (std::utf8_vec::byte_len(text) != 4 ||
        std::utf8_vec::scalar_count_or(text, -9) != 3) { return 4; }
    text = std::utf8_vec::try_insert_scalar(text, -1, 8364);
    text = std::utf8_vec::try_insert_scalar(text, 4, 8364);
    text = std::utf8_vec::try_insert_scalar(text, 1, 55296);
    if (std::utf8_vec::byte_len(text) != 4 ||
        std::vec_u8::get_or(text, 1, 0) != 194 ||
        std::vec_u8::get_or(text, 2, 0) != 162) { return 5; }

    text = std::utf8_vec::try_insert_scalar(text, 1, 8364);
    if (std::utf8_vec::byte_len(text) != 7 ||
        std::utf8_vec::scalar_count_or(text, -9) != 4 ||
        std::utf8_vec::scalar_at_or(text, 0, 4294967295) != 65 ||
        std::utf8_vec::scalar_at_or(text, 1, 4294967295) != 8364 ||
        std::utf8_vec::scalar_at_or(text, 2, 4294967295) != 162 ||
        std::utf8_vec::scalar_at_or(text, 3, 4294967295) != 66 ||
        std::vec_u8::get_or(text, 1, 0) != 226 ||
        std::vec_u8::get_or(text, 2, 0) != 130 ||
        std::vec_u8::get_or(text, 3, 0) != 172 ||
        std::vec_u8::get_or(text, 4, 0) != 194 ||
        std::vec_u8::get_or(text, 5, 0) != 162) { return 6; }
    text = std::utf8_vec::try_insert_scalar(text, 0, 128578);
    if (std::utf8_vec::byte_len(text) != 11 ||
        std::utf8_vec::scalar_at_or(text, 0, 4294967295) != 128578 ||
        std::utf8_vec::scalar_at_or(text, 1, 4294967295) != 65) { return 7; }
    text = std::utf8_vec::try_insert_scalar(text, 5, 90);
    if (std::utf8_vec::byte_len(text) != 12 ||
        std::utf8_vec::scalar_count_or(text, -9) != 6 ||
        std::utf8_vec::scalar_at_or(text, 5, 4294967295) != 90) { return 8; }

    text = std::utf8_vec::try_remove_scalar(text, 0);
    if (std::utf8_vec::byte_len(text) != 8 ||
        std::utf8_vec::scalar_at_or(text, 0, 4294967295) != 65) { return 9; }
    text = std::utf8_vec::try_remove_scalar(text, 1);
    if (std::utf8_vec::byte_len(text) != 5 ||
        std::utf8_vec::scalar_at_or(text, 1, 4294967295) != 162) { return 10; }
    text = std::utf8_vec::try_remove_scalar(text, 3);
    if (std::utf8_vec::byte_len(text) != 4 ||
        std::utf8_vec::scalar_count_or(text, -9) != 3 ||
        std::vec_u8::get_or(text, 0, 0) != 65 ||
        std::vec_u8::get_or(text, 1, 0) != 194 ||
        std::vec_u8::get_or(text, 2, 0) != 162 ||
        std::vec_u8::get_or(text, 3, 0) != 66) { return 11; }
    text = std::utf8_vec::try_remove_scalar(text, -1);
    text = std::utf8_vec::try_remove_scalar(text, 3);
    text = std::utf8_vec::try_remove_scalar(text, 4);
    if (std::utf8_vec::byte_len(text) != 4 ||
        std::utf8_vec::scalar_count_or(text, -9) != 3) { return 12; }
    text = std::utf8_vec::try_remove_scalar(text, 1);
    if (std::utf8_vec::byte_len(text) != 2 ||
        std::utf8_vec::scalar_count_or(text, -9) != 2 ||
        std::vec_u8::get_or(text, 1, 0) != 66) { return 14; }
    text = std::utf8_vec::try_insert_scalar(text, 1, 162);
    if (std::utf8_vec::byte_len(text) != 4 ||
        std::utf8_vec::scalar_count_or(text, -9) != 3 ||
        std::vec_u8::get_or(text, 1, 0) != 194 ||
        std::vec_u8::get_or(text, 2, 0) != 162) { return 15; }

    let malformed: std::vec_u8::VecU8 = std::vec_u8::new();
    malformed = std::vec_u8::try_push(malformed, 65);
    malformed = std::vec_u8::try_push(malformed, 128);
    malformed = std::utf8_vec::try_insert_scalar(malformed, 0, 66);
    malformed = std::utf8_vec::try_remove_scalar(malformed, 0);
    if (std::utf8_vec::byte_len(malformed) != 2 ||
        std::vec_u8::get_or(malformed, 0, 0) != 65 ||
        std::vec_u8::get_or(malformed, 1, 0) != 128) { return 13; }

    std::utf8_vec::destroy(malformed);
    std::utf8_vec::destroy(text);
    std::utf8_vec::destroy(empty);
    return 0;
}
