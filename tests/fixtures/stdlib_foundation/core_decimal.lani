module app::main;
import core::decimal;

fn main() -> i32 {
    if (core::decimal::len_u32(0) != 1 || core::decimal::len_u32(9) != 1 || core::decimal::len_u32(10) != 2 || core::decimal::len_u32(4294967295) != 10) {
        return 1;
    }
    if (core::decimal::byte_at_or_u32(0, 0, 88) != 48 || core::decimal::byte_at_or_u32(7, 0, 88) != 55 || core::decimal::byte_at_or_u32(12, 0, 88) != 49 || core::decimal::byte_at_or_u32(12, 1, 88) != 50) {
        return 2;
    }
    if (core::decimal::byte_at_or_u32(12, 2, 88) != 88 || core::decimal::byte_at_or_u32(12, 4294967295, 89) != 89) {
        return 3;
    }
    let unsigned_digits: [i32; 10] = [52, 50, 57, 52, 57, 54, 55, 50, 57, 53];
    let index: u32 = 0;
    while (index < 10) {
        let array_index: i32 = index;
        let actual: i32 = core::decimal::byte_at_or_u32(4294967295, index, 0);
        if (actual != unsigned_digits[array_index]) {
            return 4;
        }
        index += 1;
    }
    if (core::decimal::len_i32(0) != 1 || core::decimal::len_i32(9) != 1 || core::decimal::len_i32(-9) != 2 || core::decimal::len_i32(2147483647) != 10 || core::decimal::len_i32(-2147483648) != 11) {
        return 5;
    }
    if (core::decimal::byte_at_or_i32(0, 0, 88) != 48 || core::decimal::byte_at_or_i32(-7, 0, 88) != 45 || core::decimal::byte_at_or_i32(-7, 1, 88) != 55 || core::decimal::byte_at_or_i32(42, 0, 88) != 52 || core::decimal::byte_at_or_i32(42, 1, 88) != 50) {
        return 6;
    }
    if (core::decimal::byte_at_or_i32(-7, 2, 88) != 88 || core::decimal::byte_at_or_i32(-7, 4294967295, 89) != 89) {
        return 7;
    }
    let signed_digits: [i32; 11] = [45, 50, 49, 52, 55, 52, 56, 51, 54, 52, 56];
    let position: u32 = 0;
    while (position < 11) {
        let array_index: i32 = position;
        let actual: i32 = core::decimal::byte_at_or_i32(-2147483648, position, 0);
        if (actual != signed_digits[array_index]) {
            return 8;
        }
        position += 1;
    }
    if (!core::decimal::can_append_ascii_digit_u32(0, 48, 4294967295) || !core::decimal::can_append_ascii_digit_u32(429496729, 53, 4294967295) || core::decimal::can_append_ascii_digit_u32(429496729, 54, 4294967295)) {
        return 9;
    }
    if (!core::decimal::can_append_ascii_digit_u32(214748364, 55, 2147483647) || core::decimal::can_append_ascii_digit_u32(214748364, 56, 2147483647) || !core::decimal::can_append_ascii_digit_u32(214748364, 56, 2147483648) || core::decimal::can_append_ascii_digit_u32(214748364, 57, 2147483648)) {
        return 10;
    }
    if (core::decimal::can_append_ascii_digit_u32(0, 47, 4294967295) || core::decimal::can_append_ascii_digit_u32(0, 58, 4294967295) || !core::decimal::can_append_ascii_digit_u32(0, 48, 0) || core::decimal::can_append_ascii_digit_u32(0, 49, 0) || core::decimal::can_append_ascii_digit_u32(10, 48, 9)) {
        return 11;
    }
    if (core::decimal::append_ascii_digit_or_u32(0, 48, 4294967295, 99) != 0 || core::decimal::append_ascii_digit_or_u32(429496729, 53, 4294967295, 99) != 4294967295 || core::decimal::append_ascii_digit_or_u32(429496729, 54, 4294967295, 99) != 99 || core::decimal::append_ascii_digit_or_u32(12, 65, 4294967295, 99) != 99) {
        return 12;
    }
    let digits: [i32; 3] = [49, 50, 51];
    let parsed: u32 = 0;
    let digit_index: i32 = 0;
    while (digit_index < 3) {
        let ascii_number: i32 = digits[digit_index];
        let ascii: u8 = ascii_number as u8;
        if (!core::decimal::can_append_ascii_digit_u32(parsed, ascii, 1000)) {
            return 13;
        }
        parsed = core::decimal::append_ascii_digit_or_u32(parsed, ascii, 1000, 9999);
        digit_index += 1;
    }
    if (parsed != 123) {
        return 14;
    }
    return 0;
}
