module app::main;
import core::decimal;
import core::mem;

fn main() -> i32 {
    if (core::decimal::len_u32(0) != 1 || core::decimal::len_u32(9) != 1 || core::decimal::len_u32(10) != 2 || core::decimal::len_u32(4294967295) != 10) {
        return 1;
    }
    if (core::decimal::byte_at_or_u32(0, 0, 88) != 48 || core::decimal::byte_at_or_u32(7, 0, 88) != 55 || core::decimal::byte_at_or_u32(12, 0, 88) != 49 || core::decimal::byte_at_or_u32(12, 1, 88) != 50) {
        return 2;
    }
    if (core::decimal::byte_at_or_u32(12, 2, 88) != 88 || core::decimal::byte_at_or_u32(12, 4294967295, 89) != 89) {
        return 3;
    }
    let unsigned_digits: [i32; 10] = [52, 50, 57, 52, 57, 54, 55, 50, 57, 53];
    let index: u32 = 0;
    while (index < 10) {
        let array_index: i32 = index;
        let actual: i32 = core::decimal::byte_at_or_u32(4294967295, index, 0);
        if (actual != unsigned_digits[array_index]) {
            return 4;
        }
        index += 1;
    }
    if (core::decimal::len_i32(0) != 1 || core::decimal::len_i32(9) != 1 || core::decimal::len_i32(-9) != 2 || core::decimal::len_i32(2147483647) != 10 || core::decimal::len_i32(-2147483648) != 11) {
        return 5;
    }
    if (core::decimal::byte_at_or_i32(0, 0, 88) != 48 || core::decimal::byte_at_or_i32(-7, 0, 88) != 45 || core::decimal::byte_at_or_i32(-7, 1, 88) != 55 || core::decimal::byte_at_or_i32(42, 0, 88) != 52 || core::decimal::byte_at_or_i32(42, 1, 88) != 50) {
        return 6;
    }
    if (core::decimal::byte_at_or_i32(-7, 2, 88) != 88 || core::decimal::byte_at_or_i32(-7, 4294967295, 89) != 89) {
        return 7;
    }
    let signed_digits: [i32; 11] = [45, 50, 49, 52, 55, 52, 56, 51, 54, 52, 56];
    let position: u32 = 0;
    while (position < 11) {
        let array_index: i32 = position;
        let actual: i32 = core::decimal::byte_at_or_i32(-2147483648, position, 0);
        if (actual != signed_digits[array_index]) {
            return 8;
        }
        position += 1;
    }
    if (!core::decimal::can_append_ascii_digit_u32(0, 48, 4294967295) || !core::decimal::can_append_ascii_digit_u32(429496729, 53, 4294967295) || core::decimal::can_append_ascii_digit_u32(429496729, 54, 4294967295)) {
        return 9;
    }
    if (!core::decimal::can_append_ascii_digit_u32(214748364, 55, 2147483647) || core::decimal::can_append_ascii_digit_u32(214748364, 56, 2147483647) || !core::decimal::can_append_ascii_digit_u32(214748364, 56, 2147483648) || core::decimal::can_append_ascii_digit_u32(214748364, 57, 2147483648)) {
        return 10;
    }
    if (core::decimal::can_append_ascii_digit_u32(0, 47, 4294967295) || core::decimal::can_append_ascii_digit_u32(0, 58, 4294967295) || !core::decimal::can_append_ascii_digit_u32(0, 48, 0) || core::decimal::can_append_ascii_digit_u32(0, 49, 0) || core::decimal::can_append_ascii_digit_u32(10, 48, 9)) {
        return 11;
    }
    if (core::decimal::append_ascii_digit_or_u32(0, 48, 4294967295, 99) != 0 || core::decimal::append_ascii_digit_or_u32(429496729, 53, 4294967295, 99) != 4294967295 || core::decimal::append_ascii_digit_or_u32(429496729, 54, 4294967295, 99) != 99 || core::decimal::append_ascii_digit_or_u32(12, 65, 4294967295, 99) != 99) {
        return 12;
    }
    let digits: [i32; 3] = [49, 50, 51];
    let parsed: u32 = 0;
    let digit_index: i32 = 0;
    while (digit_index < 3) {
        let ascii_number: i32 = digits[digit_index];
        let ascii: u8 = ascii_number as u8;
        if (!core::decimal::can_append_ascii_digit_u32(parsed, ascii, 1000)) {
            return 13;
        }
        parsed = core::decimal::append_ascii_digit_or_u32(parsed, ascii, 1000, 9999);
        digit_index += 1;
    }
    if (parsed != 123) {
        return 14;
    }
    let max_u8: u8 = 255;
    let max_u16: u16 = 65535;
    let min_i8: i8 = -128;
    let max_i8: i8 = 127;
    let min_i16: i16 = -32768;
    let max_i16: i16 = 32767;
    if (core::decimal::len_u8(0) != 1 || core::decimal::len_u8(max_u8) != 3 ||
        core::decimal::len_u16(0) != 1 || core::decimal::len_u16(max_u16) != 5 ||
        core::decimal::len_i8(0) != 1 || core::decimal::len_i8(min_i8) != 4 || core::decimal::len_i8(max_i8) != 3 ||
        core::decimal::len_i16(0) != 1 || core::decimal::len_i16(min_i16) != 6 || core::decimal::len_i16(max_i16) != 5) {
        return 15;
    }
    if (core::decimal::byte_at_or_u8(0, 0, 88) != 48 || core::decimal::byte_at_or_u8(max_u8, 3, 88) != 88 ||
        core::decimal::byte_at_or_u16(0, 0, 88) != 48 || core::decimal::byte_at_or_u16(max_u16, 5, 88) != 88 ||
        core::decimal::byte_at_or_i8(0, 0, 88) != 48 || core::decimal::byte_at_or_i8(min_i8, 4, 88) != 88 ||
        core::decimal::byte_at_or_i16(0, 0, 88) != 48 || core::decimal::byte_at_or_i16(min_i16, 6, 88) != 88) {
        return 16;
    }
    let expected_u8: [i32; 3] = [50, 53, 53];
    let index_u8: u32 = 0;
    while (index_u8 < 3) {
        let slot: i32 = index_u8;
        let actual: i32 = core::decimal::byte_at_or_u8(max_u8, index_u8, 0);
        if (actual != expected_u8[slot]) { return 17; }
        index_u8 += 1;
    }
    let expected_u16: [i32; 5] = [54, 53, 53, 51, 53];
    let index_u16: u32 = 0;
    while (index_u16 < 5) {
        let slot: i32 = index_u16;
        let actual: i32 = core::decimal::byte_at_or_u16(max_u16, index_u16, 0);
        if (actual != expected_u16[slot]) { return 18; }
        index_u16 += 1;
    }
    let expected_i8: [i32; 4] = [45, 49, 50, 56];
    let index_i8: u32 = 0;
    while (index_i8 < 4) {
        let slot: i32 = index_i8;
        let actual: i32 = core::decimal::byte_at_or_i8(min_i8, index_i8, 0);
        if (actual != expected_i8[slot]) { return 19; }
        index_i8 += 1;
    }
    let expected_i16: [i32; 6] = [45, 51, 50, 55, 54, 56];
    let index_i16: u32 = 0;
    while (index_i16 < 6) {
        let slot: i32 = index_i16;
        let actual: i32 = core::decimal::byte_at_or_i16(min_i16, index_i16, 0);
        if (actual != expected_i16[slot]) { return 20; }
        index_i16 += 1;
    }
    let max_u32_view:[i32] = core::mem::i32_slice_from_raw_parts(core::mem::i32_array_data_ptr(unsigned_digits), 10);
    let min_i32_view:[i32] = core::mem::i32_slice_from_raw_parts(core::mem::i32_array_data_ptr(signed_digits), 11);
    let overflow_u32:[i32; 10] = [52, 50, 57, 52, 57, 54, 55, 50, 57, 54];
    let overflow_u32_view:[i32] = core::mem::i32_slice_from_raw_parts(core::mem::i32_array_data_ptr(overflow_u32), 10);
    let max_i32:[i32; 11] = [43, 50, 49, 52, 55, 52, 56, 51, 54, 52, 55];
    let max_i32_view:[i32] = core::mem::i32_slice_from_raw_parts(core::mem::i32_array_data_ptr(max_i32), 11);
    let overflow_i32:[i32; 11] = [45, 50, 49, 52, 55, 52, 56, 51, 54, 52, 57];
    let overflow_i32_view:[i32] = core::mem::i32_slice_from_raw_parts(core::mem::i32_array_data_ptr(overflow_i32), 11);
    let digits_view:[i32] = core::mem::i32_slice_from_raw_parts(core::mem::i32_array_data_ptr(digits), 3);
    let malformed:[i32; 3] = [49, 50, 65];
    let malformed_view:[i32] = core::mem::i32_slice_from_raw_parts(core::mem::i32_array_data_ptr(malformed), 3);
    let invalid_code:[i32; 2] = [49, 256];
    let invalid_code_view:[i32] = core::mem::i32_slice_from_raw_parts(core::mem::i32_array_data_ptr(invalid_code), 2);
    let leading_zeroes:[i32; 3] = [48, 48, 49];
    let leading_zeroes_view:[i32] = core::mem::i32_slice_from_raw_parts(core::mem::i32_array_data_ptr(leading_zeroes), 3);
    let minus:[i32; 1] = [45];
    let minus_view:[i32] = core::mem::i32_slice_from_raw_parts(core::mem::i32_array_data_ptr(minus), 1);
    let plus:[i32; 1] = [43];
    let plus_view:[i32] = core::mem::i32_slice_from_raw_parts(core::mem::i32_array_data_ptr(plus), 1);
    let negative:[i32; 3] = [45, 52, 50];
    let negative_view:[i32] = core::mem::i32_slice_from_raw_parts(core::mem::i32_array_data_ptr(negative), 3);
    let negative_zero:[i32; 2] = [45, 48];
    let negative_zero_view:[i32] = core::mem::i32_slice_from_raw_parts(core::mem::i32_array_data_ptr(negative_zero), 2);
    let spaced:[i32; 2] = [32, 49];
    let spaced_view:[i32] = core::mem::i32_slice_from_raw_parts(core::mem::i32_array_data_ptr(spaced), 2);
    if (core::decimal::parse_ascii_u32_or(digits_view, 3, 99) != 123 ||
        core::decimal::parse_ascii_u32_or(digits_view, 2, 99) != 12 ||
        core::decimal::parse_ascii_u32_or(max_u32_view, 10, 99) != 4294967295 ||
        core::decimal::parse_ascii_u32_or(leading_zeroes_view, 3, 99) != 1 ||
        core::decimal::parse_ascii_u32_or(negative_zero_view, 2, 99) != 99) {
        return 21;
    }
    if (core::decimal::parse_ascii_u32_or(overflow_u32_view, 10, 99) != 99 ||
        core::decimal::parse_ascii_u32_or(malformed_view, 3, 99) != 99 ||
        core::decimal::parse_ascii_u32_or(invalid_code_view, 2, 99) != 99 ||
        core::decimal::parse_ascii_u32_or(spaced_view, 2, 99) != 99 ||
        core::decimal::parse_ascii_u32_or(digits_view, 0, 99) != 99 ||
        core::decimal::parse_ascii_u32_or(digits_view, -1, 99) != 99) {
        return 22;
    }
    if (core::decimal::parse_ascii_i32_or(digits_view, 3, 99) != 123 ||
        core::decimal::parse_ascii_i32_or(max_i32_view, 11, 99) != 2147483647 ||
        core::decimal::parse_ascii_i32_or(min_i32_view, 11, 99) != -2147483648 ||
        core::decimal::parse_ascii_i32_or(negative_view, 3, 99) != -42 ||
        core::decimal::parse_ascii_i32_or(leading_zeroes_view, 3, 99) != 1 ||
        core::decimal::parse_ascii_i32_or(negative_zero_view, 2, 99) != 0) {
        return 23;
    }
    if (core::decimal::parse_ascii_i32_or(overflow_i32_view, 11, 99) != 99 ||
        core::decimal::parse_ascii_i32_or(max_u32_view, 10, 99) != 99 ||
        core::decimal::parse_ascii_i32_or(malformed_view, 3, 99) != 99 ||
        core::decimal::parse_ascii_i32_or(invalid_code_view, 2, 99) != 99 ||
        core::decimal::parse_ascii_i32_or(spaced_view, 2, 99) != 99 ||
        core::decimal::parse_ascii_i32_or(minus_view, 1, 99) != 99 ||
        core::decimal::parse_ascii_i32_or(plus_view, 1, 99) != 99 ||
        core::decimal::parse_ascii_i32_or(digits_view, 0, 99) != 99) {
        return 24;
    }
    return 0;
}
