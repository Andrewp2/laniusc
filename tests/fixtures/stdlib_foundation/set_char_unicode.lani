module app::main;
import std::set_char;

fn main() -> i32 {
    let fallback: char = '?';
    let left: std::set_char::SetChar = std::set_char::new();
    left = std::set_char::try_insert(left, 'Ω');
    left = std::set_char::try_insert(left, '😀');
    left = std::set_char::try_insert(left, 'é');
    left = std::set_char::try_insert(left, '\0');
    left = std::set_char::try_insert(left, 'Ω');
    let right: std::set_char::SetChar = std::set_char::new();
    right = std::set_char::try_insert(right, '😀');
    right = std::set_char::try_insert(right, '中');
    right = std::set_char::try_insert(right, '\0');
    if (std::set_char::len(left) != 4 || std::set_char::len(right) != 3 ||
        std::set_char::at_or(left, 0, fallback) != 'Ω' ||
        std::set_char::at_or(left, 1, fallback) != '😀' ||
        std::set_char::at_or(left, 3, fallback) != '\0' ||
        !std::set_char::contains(left, '\0') ||
        std::set_char::is_disjoint(left, right)) { return 1; }
    let joined: std::set_char::SetChar = std::set_char::try_union(left, right);
    let common: std::set_char::SetChar = std::set_char::try_intersection(left, right);
    let only_left: std::set_char::SetChar = std::set_char::try_difference(left, right);
    let exclusive: std::set_char::SetChar = std::set_char::try_symmetric_difference(left, right);
    if (std::set_char::len(joined) != 5 ||
        std::set_char::at_or(joined, 4, fallback) != '中' ||
        !std::set_char::is_subset(left, joined) ||
        !std::set_char::is_subset(right, joined) ||
        std::set_char::len(common) != 2 ||
        std::set_char::at_or(common, 0, fallback) != '😀' ||
        std::set_char::at_or(common, 1, fallback) != '\0' ||
        std::set_char::len(only_left) != 2 ||
        std::set_char::at_or(only_left, 0, fallback) != 'Ω' ||
        std::set_char::at_or(only_left, 1, fallback) != 'é' ||
        std::set_char::len(exclusive) != 3 ||
        std::set_char::at_or(exclusive, 0, fallback) != 'Ω' ||
        std::set_char::at_or(exclusive, 1, fallback) != 'é' ||
        std::set_char::at_or(exclusive, 2, fallback) != '中') { return 2; }
    std::set_char::destroy(joined);
    std::set_char::destroy(common);
    std::set_char::destroy(only_left);
    std::set_char::destroy(exclusive);
    std::set_char::destroy(left);
    std::set_char::destroy(right);
    return 0;
}
