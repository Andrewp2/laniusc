module app::main;
import core::varint;
import core::varint_wide_u64;
import core::varint_wide_i64;
import core::wide_u64;
import core::wide_i64;

fn roundtrip(value: core::wide_i64::WideI64) -> bool {
    let b0: u8 = 0;
    let bytes: [u8; 10] = [b0, b0, b0, b0, b0,
        b0, b0, b0, b0, b0];
    let end: i32 = core::varint_wide_i64::write_wide_i64(bytes, 10, 0, value);
    if (end != core::varint_wide_i64::len_wide_i64(value)) { return false; }
    let decoded: core::varint_wide_u64::ReadWideU64 =
        core::varint_wide_i64::read_wide_i64(bytes, end, 0);
    return core::varint_wide_u64::status_wide_u64(decoded) == core::varint::OK &&
        core::varint_wide_u64::next_wide_u64_or(decoded, -1) == end &&
        core::wide_i64::eq(
            core::varint_wide_i64::value_wide_i64_or(decoded, core::wide_i64::zero()), value);
}

fn main() -> i32 {
    if (!core::wide_u64::eq(
            core::varint_wide_i64::zigzag_encode(core::wide_i64::from_i32(-1)),
            core::wide_u64::from_u32(1)) ||
        !core::wide_u64::eq(
            core::varint_wide_i64::zigzag_encode(core::wide_i64::min_value()),
            core::wide_u64::max_value()) ||
        !core::wide_u64::eq(
            core::varint_wide_i64::zigzag_encode(core::wide_i64::max_value()),
            core::wide_u64::from_words(4294967295, 4294967294))) { return 1; }
    if (!core::wide_i64::eq(
            core::varint_wide_i64::zigzag_decode(core::wide_u64::from_u32(1)),
            core::wide_i64::from_i32(-1)) ||
        !core::wide_i64::eq(
            core::varint_wide_i64::zigzag_decode(core::wide_u64::max_value()),
            core::wide_i64::min_value()) ||
        !core::wide_i64::eq(
            core::varint_wide_i64::zigzag_decode(
                core::wide_u64::from_words(4294967295, 4294967294)),
            core::wide_i64::max_value())) { return 2; }
    if (!roundtrip(core::wide_i64::zero()) ||
        !roundtrip(core::wide_i64::from_i32(-1)) ||
        !roundtrip(core::wide_i64::from_i32(1)) ||
        !roundtrip(core::wide_i64::from_i32(-64)) ||
        !roundtrip(core::wide_i64::from_i32(-65)) ||
        !roundtrip(core::wide_i64::from_words(0, 4294967295)) ||
        !roundtrip(core::wide_i64::from_words(4294967295, 0)) ||
        !roundtrip(core::wide_i64::min_value()) ||
        !roundtrip(core::wide_i64::max_value())) { return 3; }
    let marker: u8 = 170;
    let bytes: [u8; 11] = [marker, marker, marker, marker, marker,
        marker, marker, marker, marker, marker, marker];
    if (core::varint_wide_i64::write_wide_i64(
            bytes, 11, 1, core::wide_i64::min_value()) != 11 ||
        bytes[0] != marker || bytes[1] != 255 || bytes[2] != 255 ||
        bytes[3] != 255 || bytes[4] != 255 || bytes[5] != 255 ||
        bytes[6] != 255 || bytes[7] != 255 || bytes[8] != 255 ||
        bytes[9] != 255 || bytes[10] != 1) { return 4; }
    let minimum: core::varint_wide_u64::ReadWideU64 =
        core::varint_wide_i64::read_wide_i64(bytes, 11, 1);
    if (core::varint_wide_u64::status_wide_u64(minimum) != core::varint::OK ||
        core::varint_wide_u64::next_wide_u64_or(minimum, -1) != 11 ||
        !core::wide_i64::eq(core::varint_wide_i64::value_wide_i64_or(
            minimum, core::wide_i64::zero()), core::wide_i64::min_value())) { return 5; }
    if (core::varint_wide_i64::write_wide_i64(
            bytes, 10, 1, core::wide_i64::min_value()) != -1 ||
        bytes[0] != marker || bytes[10] != 1) { return 6; }
    let truncated: core::varint_wide_u64::ReadWideU64 =
        core::varint_wide_i64::read_wide_i64(bytes, 10, 1);
    if (core::varint_wide_u64::status_wide_u64(truncated) != core::varint::TRUNCATED ||
        !core::wide_i64::eq(core::varint_wide_i64::value_wide_i64_or(
            truncated, core::wide_i64::from_i32(77)), core::wide_i64::from_i32(77))) {
        return 7;
    }
    return 0;
}
