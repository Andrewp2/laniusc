module app::main;
import core::i64;
import core::u64;
import core::isize;
import core::usize;
import core::option;
fn main() -> i32 {
    assert(core::i64::MIN == -9223372036854775808 && core::i64::MAX == 9223372036854775807);
    assert(core::u64::MAX == 18446744073709551615 && core::u64::BITS == 64 && core::u64::BYTES == 8);
    assert(core::isize::BITS == 64 && core::usize::BITS == 64 && core::usize::BYTES == 8);
    assert(core::i64::wrapping_add(core::i64::MAX,1) == core::i64::MIN);
    assert(core::u64::wrapping_add(core::u64::MAX,1) == 0);
    assert(core::i64::saturating_mul(core::i64::MIN,-1) == core::i64::MAX);
    assert(core::option::is_none(core::i64::checked_mul(core::i64::MIN,-1)));
    assert(core::i64::unsigned_abs(core::i64::MIN) == 9223372036854775808);
    assert(core::i64::abs_diff(core::i64::MIN,core::i64::MAX) == core::u64::MAX);
    assert(core::i64::saturating_abs_diff(core::i64::MIN,core::i64::MAX) == core::i64::MAX);
    assert(core::i64::abs(-7) == 7 && core::i64::saturating_abs(core::i64::MIN) == core::i64::MAX);
    assert(core::i64::wrapping_abs(core::i64::MIN) == core::i64::MIN);
    assert(core::option::is_none(core::i64::checked_abs(core::i64::MIN)));
    assert(core::i64::clamp_or(5,10,0,77) == 77);
    assert(core::option::is_none(core::i64::checked_clamp(5,10,0)));
    assert(core::i64::clamp(5,0,10) == 5);
    assert(core::u64::clamp(11,0,10) == 10 && core::u64::clamp(0,1,10) == 1);
    assert(core::i64::checked_add(1,2).unwrap() == 3);
    assert(core::i64::checked_sub(1,2).unwrap() == -1);
    assert(core::isize::checked_mul(-3,4).unwrap() == -12);
    assert(core::usize::checked_mul(3,4).unwrap() == 12);
    assert(core::i64::div(-7,3) == -2 && core::i64::rem(-7,3) == -1);
    assert(core::i64::div_euclid(-7,3) == -3 && core::i64::rem_euclid(-7,3) == 2);
    assert(core::i64::div_euclid(-7,-3) == 3 && core::i64::rem_euclid(-7,-3) == 2);
    assert(core::i64::div_euclid(-1,core::i64::MIN) == 1 && core::i64::rem_euclid(-1,core::i64::MIN) == core::i64::MAX);
    assert(core::i64::wrapping_div(core::i64::MIN,-1) == core::i64::MIN);
    assert(core::i64::wrapping_rem(core::i64::MIN,-1) == 0);
    assert(core::i64::saturating_div(core::i64::MIN,-1) == core::i64::MAX);
    assert(core::option::is_none(core::i64::checked_rem(core::i64::MIN,-1)));
    assert(core::i64::checked_pow(-2,63).unwrap() == core::i64::MIN);
    assert(core::option::is_none(core::i64::checked_pow(-2,64)));
    assert(core::i64::saturating_pow(-2,65) == core::i64::MIN);
    assert(core::u64::checked_pow(0,0).unwrap() == 1);
    assert(core::u64::checked_shl(16,63).unwrap() == 0);
    assert(core::option::is_none(core::u64::checked_shl(16,64)));
    assert(core::u64::rotate_left(1,64) == 1 && core::u64::rotate_right(1,1) == 9223372036854775808);
    assert(core::i64::shr(-1,63) == -1);
    assert(core::u64::shr(core::u64::MAX,63) == 1);
    assert(core::u64::count_ones(core::u64::MAX) == 64 && core::u64::count_zeros(0) == 64);
    assert(core::u64::leading_zeros(0) == 64 && core::u64::trailing_zeros(0) == 64);
    assert(core::isize::unsigned_abs(core::isize::MIN) == 9223372036854775808);
    assert(core::usize::reverse_bits(1) == 9223372036854775808);
    assert(core::i64::is_multiple_of(core::i64::MIN,-1) && !core::u64::is_multiple_of(1,0));
    assert(core::i64::next_power_of_two(-7) == 1 && core::u64::next_power_of_two(0) == 1);
    assert(core::u64::next_power_of_two(9223372036854775808) == 9223372036854775808);
    assert(core::option::is_none(core::u64::checked_next_power_of_two(core::u64::MAX)));
    assert(core::i64::saturating_to_u8(-1) == 0 && core::i64::saturating_to_i8(128) == 127);
    assert(core::i64::wrapping_to_u8(-1) == 255 && core::u64::wrapping_to_i8(255) == -1);
    assert(core::option::is_none(core::u64::checked_to_i64(core::u64::MAX)));
    assert(core::option::is_none(core::u64::checked_from_i64(-1)));
    assert(core::option::is_none(core::i64::checked_from_u64(core::u64::MAX)));
    assert(core::isize::saturating_from_u64(core::u64::MAX) == core::isize::MAX);
    assert(core::usize::checked_from_i64(0).unwrap() == 0);
    assert(core::i64::is_zero(0) && core::i64::is_nonzero(1) && core::i64::is_odd(3));
    assert(core::i64::between_inclusive(2,1,2) && !core::i64::between_exclusive(2,1,2));
    assert(!core::i64::between_inclusive(2,3,1));
    assert(core::i64::is_negative(-1) && core::i64::is_positive(1));
    assert(core::i64::from_u8(255) == 255);
    assert(core::i64::from_u16(65535) == 65535);
    assert(core::i64::from_u32(4294967295) == 4294967295);
    assert(core::i64::from_i8(-128) == -128);
    assert(core::i64::from_i16(-32768) == -32768);
    assert(core::i64::from_i32(-2147483648) == -2147483648);
    assert(core::u64::is_zero(0) && core::u64::is_nonzero(1) && core::u64::is_odd(3));
    assert(core::u64::between_inclusive(2,1,2) && !core::u64::between_exclusive(2,1,2));
    assert(!core::u64::between_inclusive(2,3,1));
    assert(core::u64::from_u8(255) == 255);
    assert(core::u64::from_u16(65535) == 65535);
    assert(core::u64::from_u32(4294967295) == 4294967295);
    assert(core::isize::is_zero(0) && core::isize::is_nonzero(1) && core::isize::is_odd(3));
    assert(core::isize::between_inclusive(2,1,2) && !core::isize::between_exclusive(2,1,2));
    assert(!core::isize::between_inclusive(2,3,1));
    assert(core::isize::is_negative(-1) && core::isize::is_positive(1));
    assert(core::isize::from_u8(255) == 255);
    assert(core::isize::from_u16(65535) == 65535);
    assert(core::isize::from_u32(4294967295) == 4294967295);
    assert(core::isize::from_i8(-128) == -128);
    assert(core::isize::from_i16(-32768) == -32768);
    assert(core::isize::from_i32(-2147483648) == -2147483648);
    assert(core::usize::is_zero(0) && core::usize::is_nonzero(1) && core::usize::is_odd(3));
    assert(core::usize::between_inclusive(2,1,2) && !core::usize::between_exclusive(2,1,2));
    assert(!core::usize::between_inclusive(2,3,1));
    assert(core::usize::from_u8(255) == 255);
    assert(core::usize::from_u16(65535) == 65535);
    assert(core::usize::from_u32(4294967295) == 4294967295);
    return 0;
}
