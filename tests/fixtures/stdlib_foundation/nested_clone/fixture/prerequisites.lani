module fixture::prerequisites;
import core::clone;
import core::result;
pub struct CloneOnly { value: i32 }
pub struct ReleaseOnly { value: i32 }
pub enum Never { Unreachable }
pub impl core::clone::TryClone<CloneOnly,Never> for CloneOnly {
    pub fn try_clone_value(source: CloneOnly) -> core::result::Result<CloneOnly,Never> {
        return core::result::Ok(source);
    }
}
pub impl core::clone::Destroy<ReleaseOnly> for ReleaseOnly {
    pub fn destroy_value(owned: ReleaseOnly) {}
}
