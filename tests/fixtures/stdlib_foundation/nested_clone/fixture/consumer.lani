// Accepted native Linux x86-64 consumer. Explicit implementation import.
module fixture::consumer;
import alloc::clone_vec;
import core::clone;
import core::result;

pub fn duplicate<T,E>(source: T) -> core::result::Result<T,E>
    where T: core::clone::TryClone<T,E> {
    return T::try_clone_value(source);
}
