module app::main;

pub struct Small<T> { value: T, }

pub impl Small<i32> {
    pub fn get(self) -> i32 { return self.value; }
}
pub impl Small<u32> {
    pub fn get(self) -> u32 { return self.value; }
}
pub impl Small<i8> {
    pub fn get(self) -> i8 { return self.value; }
}

fn main() -> i32 {
    let one: i8 = 1;
    let value: Small<i8> = Small { value: one };
    if (value.get() != one) { return 1; }
    return 0;
}
