module app::main;
import core::utf8_view;

fn main() -> i32 {
    let a: u8 = 65;
    let b: u8 = 66;
    let c2: u8 = 194;
    let a2: u8 = 162;
    let e2: u8 = 226;
    let cont82: u8 = 130;
    let ac: u8 = 172;
    let f0: u8 = 240;
    let cont9f: u8 = 159;
    let cont99: u8 = 153;
    let low: u8 = 128;
    let values: [u8; 13] = [a, c2, a2, e2, cont82, ac, f0, cont9f, cont99,
                            cont82, a, c2, a2];
    let prefix: [u8; 3] = [a, c2, a2];
    let euro: [u8; 3] = [e2, cont82, ac];
    let missing: [u8; 1] = [b];
    let malformed: [u8; 2] = [a, low];

    if (!core::utf8_view::byte_view_equal(values, 13, values, 13) ||
        !core::utf8_view::byte_view_equal(values, 3, prefix, 3) ||
        core::utf8_view::byte_view_equal(values, 10, values, 13) ||
        core::utf8_view::byte_view_equal(malformed, 2, malformed, 2) ||
        core::utf8_view::byte_view_equal(values, -1, values, -1) ||
        !core::utf8_view::byte_view_equal(values, 0, values, 0)) { return 1; }
    if (!core::utf8_view::byte_view_starts_with(values, 13, prefix, 3) ||
        !core::utf8_view::byte_view_ends_with(values, 13, prefix, 3) ||
        !core::utf8_view::byte_view_starts_with(values, 13, prefix, 0) ||
        !core::utf8_view::byte_view_ends_with(values, 13, prefix, 0) ||
        core::utf8_view::byte_view_starts_with(values, 13, euro, 3) ||
        core::utf8_view::byte_view_ends_with(values, 13, euro, 3) ||
        core::utf8_view::byte_view_starts_with(malformed, 2, prefix, 1) ||
        core::utf8_view::byte_view_ends_with(malformed, 2, prefix, 0) ||
        core::utf8_view::byte_view_starts_with(values, 13, malformed, 2) ||
        core::utf8_view::byte_view_ends_with(values, 13, malformed, 2) ||
        core::utf8_view::byte_view_starts_with(values, 3, values, 13) ||
        core::utf8_view::byte_view_ends_with(values, -1, prefix, 0)) { return 2; }
    if (core::utf8_view::byte_view_compare_or(values, 13, values, 13, 9) != 0 ||
        core::utf8_view::byte_view_compare_or(prefix, 3, missing, 1, 9) != -1 ||
        core::utf8_view::byte_view_compare_or(missing, 1, prefix, 3, 9) != 1 ||
        core::utf8_view::byte_view_compare_or(values, 10, values, 13, 9) != -1 ||
        core::utf8_view::byte_view_compare_or(values, 13, values, 10, 9) != 1 ||
        core::utf8_view::byte_view_compare_or(malformed, 2, values, 13, 9) != 9 ||
        core::utf8_view::byte_view_compare_or(values, -1, values, 13, 9) != 9) { return 3; }
    if (core::utf8_view::byte_view_index_of_bytes_or(values, 13, prefix, 3, -9) != 0 ||
        core::utf8_view::byte_view_last_index_of_bytes_or(values, 13, prefix, 3, -9) != 10 ||
        core::utf8_view::byte_view_index_of_bytes_or(values, 13, euro, 3, -9) != 3 ||
        core::utf8_view::byte_view_last_index_of_bytes_or(values, 13, euro, 3, -9) != 3 ||
        core::utf8_view::byte_view_index_of_bytes_or(values, 13, prefix, 0, -9) != 0 ||
        core::utf8_view::byte_view_last_index_of_bytes_or(values, 13, prefix, 0, -9) != 13 ||
        core::utf8_view::byte_view_index_of_bytes_or(values, 0, prefix, 0, -9) != 0 ||
        core::utf8_view::byte_view_last_index_of_bytes_or(values, 0, prefix, 0, -9) != 0 ||
        core::utf8_view::byte_view_index_of_bytes_or(values, 13, missing, 1, -9) != -9 ||
        core::utf8_view::byte_view_last_index_of_bytes_or(values, 13, missing, 1, -9) != -9) { return 4; }
    if (core::utf8_view::byte_view_index_of_bytes_or(malformed, 2, prefix, 1, -9) != -9 ||
        core::utf8_view::byte_view_last_index_of_bytes_or(malformed, 2, prefix, 0, -9) != -9 ||
        core::utf8_view::byte_view_index_of_bytes_or(values, 13, malformed, 2, -9) != -9 ||
        core::utf8_view::byte_view_last_index_of_bytes_or(values, 13, malformed, 2, -9) != -9 ||
        core::utf8_view::byte_view_index_of_bytes_or(values, -1, prefix, 0, -9) != -9 ||
        core::utf8_view::byte_view_last_index_of_bytes_or(values, 13, prefix, -1, -9) != -9 ||
        core::utf8_view::byte_view_index_of_bytes_or(values, 3, values, 13, -9) != -9) { return 5; }
    if (core::utf8_view::byte_view_index_of_scalar_or(values, 13, 65, -9) != 0 ||
        core::utf8_view::byte_view_last_index_of_scalar_or(values, 13, 65, -9) != 4 ||
        core::utf8_view::byte_view_index_of_scalar_or(values, 13, 162, -9) != 1 ||
        core::utf8_view::byte_view_last_index_of_scalar_or(values, 13, 162, -9) != 5 ||
        core::utf8_view::byte_view_index_of_scalar_or(values, 13, 8364, -9) != 2 ||
        core::utf8_view::byte_view_last_index_of_scalar_or(values, 13, 128578, -9) != 3 ||
        core::utf8_view::byte_view_index_of_scalar_or(values, 13, 66, -9) != -9 ||
        core::utf8_view::byte_view_last_index_of_scalar_or(values, 13, 66, -9) != -9) { return 6; }
    if (core::utf8_view::byte_view_index_of_scalar_or(values, 13, 55296, -9) != -9 ||
        core::utf8_view::byte_view_last_index_of_scalar_or(values, 13, 1114112, -9) != -9 ||
        core::utf8_view::byte_view_index_of_scalar_or(malformed, 2, 65, -9) != -9 ||
        core::utf8_view::byte_view_last_index_of_scalar_or(malformed, 2, 65, -9) != -9 ||
        core::utf8_view::byte_view_index_of_scalar_or(values, -1, 65, -9) != -9 ||
        core::utf8_view::byte_view_last_index_of_scalar_or(values, 0, 65, -9) != -9) { return 7; }
    return 0;
}
