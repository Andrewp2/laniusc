module app::main;
import alloc::clone_tree_map;
import alloc::clone_tree_set;
import alloc::string;
import alloc::tree_map;
import alloc::tree_set;
import core::clone_values;
import core::iter;
import core::result;
fn text(first:u8)->alloc::string::String{let bytes:[u8;4]=[first,0,195,169];return alloc::string::from_utf8(bytes,4).unwrap();}
fn duplicate(error:alloc::tree_map::SinkError)->bool{return match(error){alloc::tree_map::SinkError::Duplicate->true,_ ->false};}
fn maps(){
    let source=alloc::tree_map::with_capacity<i32,alloc::string::String>(4).unwrap();source.try_insert(1,text(65)).unwrap();source.try_insert(2,text(66)).unwrap();source.try_insert(3,text(67)).unwrap();
    let sink=alloc::tree_map::with_capacity<i32,alloc::string::String>(4).unwrap();sink.try_insert(2,text(88)).unwrap();let cursor=source.take_iter();
    let result=core::iter::try_transfer_up_to<alloc::tree_map::IntoIter<i32,alloc::string::String>,alloc::tree_map::TreeMap<i32,alloc::string::String>,alloc::tree_map::Entry<i32,alloc::string::String>,alloc::tree_map::SinkError>(cursor.borrow(),sink.borrow(),3);
    let failure=result.unwrap_err();assert(failure.accepted==1&&failure.rejected.key==2&&failure.rejected.value.byte_at(0).unwrap()==66&&duplicate(failure.error));
    assert(cursor.remaining()==1&&cursor.capacity()==4&&source.capacity()==0&&sink.len()==2&&sink.get(2).unwrap().byte_at(0).unwrap()==88);
    let resumed=core::iter::try_transfer_up_to<alloc::tree_map::IntoIter<i32,alloc::string::String>,alloc::tree_map::TreeMap<i32,alloc::string::String>,alloc::tree_map::Entry<i32,alloc::string::String>,alloc::tree_map::SinkError>(cursor.borrow(),sink.borrow(),1).unwrap();
    assert(resumed.accepted==1&&!resumed.exhausted&&cursor.remaining()==0&&cursor.capacity()==4&&sink.get(3).unwrap().byte_at(0).unwrap()==67);
    assert(cursor.try_finish().is_none()&&cursor.capacity()==0);alloc::clone_tree_map::destroy_tree_map<i32,alloc::string::String>(sink.borrow());source.destroy();
    assert(failure.rejected.value.byte_at(0).unwrap()==66&&failure.rejected.value.byte_at(1).unwrap()==0);failure.rejected.value.destroy();
}
fn sets(){
    let source=alloc::tree_set::with_capacity<alloc::string::String>(4).unwrap();source.try_insert(text(65)).unwrap();source.try_insert(text(66)).unwrap();source.try_insert(text(67)).unwrap();
    let sink=alloc::tree_set::with_capacity<alloc::string::String>(4).unwrap();sink.try_insert(text(66)).unwrap();let cursor=source.take_iter();
    let result=core::iter::try_transfer_up_to<alloc::tree_set::IntoIter<alloc::string::String>,alloc::tree_set::TreeSet<alloc::string::String>,alloc::string::String,alloc::tree_map::SinkError>(cursor.borrow(),sink.borrow(),3);
    let failure=result.unwrap_err();assert(failure.accepted==1&&failure.rejected.byte_at(0).unwrap()==66&&duplicate(failure.error));
    assert(cursor.remaining()==1&&cursor.capacity()==4&&sink.len()==2);
    let resumed=core::iter::try_transfer_up_to<alloc::tree_set::IntoIter<alloc::string::String>,alloc::tree_set::TreeSet<alloc::string::String>,alloc::string::String,alloc::tree_map::SinkError>(cursor.borrow(),sink.borrow(),1).unwrap();
    assert(resumed.accepted==1&&!resumed.exhausted&&cursor.remaining()==0&&cursor.capacity()==4&&sink.len()==3);
    assert(cursor.try_finish().is_none());alloc::clone_tree_set::destroy_tree_set<alloc::string::String>(sink.borrow());source.destroy();
    assert(failure.rejected.byte_len()==4&&failure.rejected.byte_at(1).unwrap()==0);failure.rejected.destroy();
}
fn main()->i32{maps();sets();return 0;}
