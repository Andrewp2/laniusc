module app::main;
import std::utf8_vec;
import std::vec_u8;

fn main() -> i32 {
    let source: [i32; 4] = [65, 194, 162, 66];
    let euro: [i32; 3] = [226, 130, 172];
    let truncated: [i32; 2] = [226, 130];
    let malformed: [i32; 2] = [65, 128];
    let high_code: [i32; 2] = [65, 256];
    let text: std::vec_u8::VecU8 = std::utf8_vec::new();
    text = std::utf8_vec::try_append_codes(text, source, 4);
    if (std::utf8_vec::byte_len(text) != 4 ||
        std::utf8_vec::scalar_count_or(text, -9) != 3 ||
        std::utf8_vec::scalar_at_or(text, 0, 4294967295) != 65 ||
        std::utf8_vec::scalar_at_or(text, 1, 4294967295) != 162 ||
        std::utf8_vec::scalar_at_or(text, 2, 4294967295) != 66) { return 1; }
    text = std::utf8_vec::try_append_codes(text, source, 4);
    text = std::utf8_vec::try_append_codes(text, euro, 3);
    if (std::utf8_vec::byte_len(text) != 11 ||
        std::utf8_vec::scalar_count_or(text, -9) != 7 ||
        std::utf8_vec::scalar_at_or(text, 3, 4294967295) != 65 ||
        std::utf8_vec::scalar_at_or(text, 6, 4294967295) != 8364 ||
        std::vec_u8::get_or(text, 8, 0) != 226 ||
        std::vec_u8::get_or(text, 9, 0) != 130 ||
        std::vec_u8::get_or(text, 10, 0) != 172) { return 2; }

    text = std::utf8_vec::try_append_codes(text, source, 0);
    text = std::utf8_vec::try_append_codes(text, source, -1);
    text = std::utf8_vec::try_append_codes(text, truncated, 2);
    text = std::utf8_vec::try_append_codes(text, malformed, 2);
    text = std::utf8_vec::try_append_codes(text, high_code, 2);
    text = std::utf8_vec::try_append_codes(text, source, 2);
    if (std::utf8_vec::byte_len(text) != 11 ||
        std::utf8_vec::scalar_count_or(text, -9) != 7 ||
        std::vec_u8::get_or(text, 10, 0) != 172) { return 3; }
    text = std::utf8_vec::try_append_codes(text, source, 3);
    if (std::utf8_vec::byte_len(text) != 14 ||
        std::utf8_vec::scalar_count_or(text, -9) != 9 ||
        std::utf8_vec::scalar_at_or(text, 8, 4294967295) != 162) { return 4; }

    let invalid: std::vec_u8::VecU8 = std::vec_u8::new();
    invalid = std::vec_u8::try_push(invalid, 65);
    invalid = std::vec_u8::try_push(invalid, 128);
    invalid = std::utf8_vec::try_append_codes(invalid, source, 4);
    if (std::utf8_vec::byte_len(invalid) != 2 ||
        std::vec_u8::get_or(invalid, 0, 0) != 65 ||
        std::vec_u8::get_or(invalid, 1, 0) != 128) { return 5; }

    std::utf8_vec::destroy(invalid);
    std::utf8_vec::destroy(text);
    return 0;
}
