// Shared Text iterator contracts over real packed and strided backing.
module app::main;
import core::function;
import core::iter;
import core::mem;
import core::option;
import core::result;
import core::text;

struct ByteCount { calls: i32 }
impl ByteCount { fn borrow(&self) -> &ByteCount { return self; } }
pub impl core::function::Mapper<core::text::Text, i32> for ByteCount {
    pub fn apply(&self, value: core::text::Text) -> i32 {
        self.calls += 1;
        return value.byte_len();
    }
}

fn pull<I, T>(source: &I) -> core::option::Option<T> where I: core::iter::Iterator<T> {
    let item: core::option::Option<T> = source.next();
    return item;
}
fn ended<I, T>(source: &I) where I: core::iter::Iterator<T> {
    let first: core::option::Option<T> = pull<I, T>(source);
    let second: core::option::Option<T> = pull<I, T>(source);
    assert(core::option::is_none(first) && core::option::is_none(second));
}
fn literal(value: str, length: i32) -> core::text::Text {
    let bytes: [u8] = core::mem::typed_slice_from_raw_parts<u8>(core::mem::string_data_ptr(value), length);
    return core::result::unwrap(core::text::from_utf8(bytes, length));
}
fn field(value: core::option::Option<core::text::Text>, expected: core::text::Text) -> core::text::Text {
    assert(core::option::is_some(value));
    let actual: core::text::Text = core::option::unwrap(value);
    assert(actual.equals(expected));
    return actual;
}
fn range(value: core::text::Text, original: core::text::Text, start: i32, length: i32) {
    assert(value.start == original.start + start && value.byte_len() == length);
    assert(core::mem::slice_stride(value.bytes) == core::mem::slice_stride(original.bytes));
}

fn split_contracts(text: core::text::Text, separator: core::text::Text) {
    // Input is ,A,é,,🙂, and keeps all six fields, including both ends.
    let empty: core::text::Text = literal("", 0);
    let a: core::text::Text = literal("A", 1);
    let e: core::text::Text = literal("é", 2);
    let face: core::text::Text = literal("🙂", 4);
    let source: core::text::Split = text.split(separator);
    let zero: core::iter::Take<core::text::Split, core::text::Text> =
        core::iter::take<core::text::Split, core::text::Text>(source.borrow(), 0);
    ended<core::iter::Take<core::text::Split, core::text::Text>, core::text::Text>(zero.borrow());
    let head: core::text::Text = field(pull<core::text::Split, core::text::Text>(source.borrow()), empty);
    range(head, text, 0, 0);
    let fork: core::text::Split = source;
    let first: core::text::Text = field(pull<core::text::Split, core::text::Text>(source.borrow()), a);
    range(first, text, 1, 1);
    field(pull<core::text::Split, core::text::Text>(fork.borrow()), a);
    let selected: core::iter::Take<core::text::Split, core::text::Text> =
        core::iter::take<core::text::Split, core::text::Text>(source.borrow(), 2);
    let accent: core::text::Text = field(selected.next(), e);
    range(accent, text, 3, 2);
    let interior: core::text::Text = field(selected.next(), empty);
    range(interior, text, 6, 0);
    ended<core::iter::Take<core::text::Split, core::text::Text>, core::text::Text>(selected.borrow());
    let emoji: core::text::Text = field(source.next(), face);
    range(emoji, text, 7, 4);
    let tail: core::text::Text = field(source.next(), empty);
    range(tail, text, 12, 0);
    ended<core::text::Split, core::text::Text>(source.borrow());
    field(fork.next(), e);

    // Leaf copies fork positions. Adapter copies share their borrowed source.
    let shared: core::text::Split = text.split(separator);
    let left: core::iter::Take<core::text::Split, core::text::Text> =
        core::iter::take<core::text::Split, core::text::Text>(shared.borrow(), 2);
    let right: core::iter::Take<core::text::Split, core::text::Text> = left;
    field(left.next(), empty); field(right.next(), a);
    field(left.next(), e); field(right.next(), empty);
    ended<core::iter::Take<core::text::Split, core::text::Text>, core::text::Text>(left.borrow());
    ended<core::iter::Take<core::text::Split, core::text::Text>, core::text::Text>(right.borrow());
    field(shared.next(), face);

    // A copied Text descriptor can be reassigned without changing the cursor's
    // captured view. Its physical backing remains live and unchanged.
    let descriptor: core::text::Text = text;
    let captured: core::text::Split = descriptor.split(separator);
    descriptor = literal("other", 5);
    field(captured.next(), empty);
    field(captured.next(), a);
    assert(descriptor.byte_len() == 5);

    let chain_left: core::text::Split = text.split(separator);
    let suffix: core::text::Text = literal(" \tq\n", 4);
    let chain_right: core::text::SplitAsciiWhitespace = suffix.split_ascii_whitespace();
    let joined: core::iter::Chain<core::text::Split, core::text::SplitAsciiWhitespace, core::text::Text> =
        core::iter::chain<core::text::Split, core::text::SplitAsciiWhitespace, core::text::Text>(chain_left.borrow(), chain_right.borrow());
    let counter: ByteCount = ByteCount { calls: 0 };
    let lengths: core::iter::Map<core::iter::Chain<core::text::Split, core::text::SplitAsciiWhitespace, core::text::Text>, ByteCount, core::text::Text, i32> =
        core::iter::map<core::iter::Chain<core::text::Split, core::text::SplitAsciiWhitespace, core::text::Text>, ByteCount, core::text::Text, i32>(joined.borrow(), counter.borrow());
    let expected: [i32; 7] = [0, 1, 2, 0, 4, 0, 1];
    let index: i32 = 0;
    while (index < 7) {
        let item: core::option::Option<i32> = pull<core::iter::Map<core::iter::Chain<core::text::Split, core::text::SplitAsciiWhitespace, core::text::Text>, ByteCount, core::text::Text, i32>, i32>(lengths.borrow());
        assert(core::option::unwrap(item) == expected[index]); index += 1;
    }
    ended<core::iter::Map<core::iter::Chain<core::text::Split, core::text::SplitAsciiWhitespace, core::text::Text>, ByteCount, core::text::Text, i32>, i32>(lengths.borrow());
    assert(counter.calls == 7);

    let scalar_text: core::text::Text = literal("Aé🙂", 7);
    let scalars: core::text::Split = scalar_text.split(empty);
    field(scalars.next(), empty); field(scalars.next(), a);
    field(scalars.next(), e); field(scalars.next(), face); field(scalars.next(), empty);
    ended<core::text::Split, core::text::Text>(scalars.borrow());
    let no_text: core::text::Split = empty.split(empty);
    field(pull<core::text::Split, core::text::Text>(no_text.borrow()), empty);
    field(pull<core::text::Split, core::text::Text>(no_text.borrow()), empty);
    ended<core::text::Split, core::text::Text>(no_text.borrow());
}

fn whitespace_contracts(text: core::text::Text) {
    let first_bytes: [u8; 4] = [65, 0, 195, 169];
    let first: core::text::Text = core::result::unwrap(core::text::from_utf8(first_bytes, 4));
    let second: core::text::Text = literal(" B", 3);
    let source: core::text::SplitAsciiWhitespace = text.split_ascii_whitespace();
    let fork: core::text::SplitAsciiWhitespace = source;
    let mapper: ByteCount = ByteCount { calls: 0 };
    let mapped: core::iter::Map<core::text::SplitAsciiWhitespace, ByteCount, core::text::Text, i32> =
        core::iter::map<core::text::SplitAsciiWhitespace, ByteCount, core::text::Text, i32>(source.borrow(), mapper.borrow());
    let zero: core::iter::Take<core::iter::Map<core::text::SplitAsciiWhitespace, ByteCount, core::text::Text, i32>, i32> =
        core::iter::take<core::iter::Map<core::text::SplitAsciiWhitespace, ByteCount, core::text::Text, i32>, i32>(mapped.borrow(), 0);
    ended<core::iter::Take<core::iter::Map<core::text::SplitAsciiWhitespace, ByteCount, core::text::Text, i32>, i32>, i32>(zero.borrow());
    assert(mapper.calls == 0);
    let selected: core::iter::Take<core::iter::Map<core::text::SplitAsciiWhitespace, ByteCount, core::text::Text, i32>, i32> =
        core::iter::take<core::iter::Map<core::text::SplitAsciiWhitespace, ByteCount, core::text::Text, i32>, i32>(mapped.borrow(), 1);
    let one: core::option::Option<i32> = selected.next(); assert(core::option::unwrap(one) == 4);
    ended<core::iter::Take<core::iter::Map<core::text::SplitAsciiWhitespace, ByteCount, core::text::Text, i32>, i32>, i32>(selected.borrow());
    assert(mapper.calls == 1);
    let next_word: core::text::Text = field(pull<core::text::SplitAsciiWhitespace, core::text::Text>(source.borrow()), second);
    range(next_word, text, 11, 3);
    ended<core::text::SplitAsciiWhitespace, core::text::Text>(source.borrow());
    ended<core::iter::Map<core::text::SplitAsciiWhitespace, ByteCount, core::text::Text, i32>, i32>(mapped.borrow());
    assert(mapper.calls == 1);
    let fork_first: core::text::Text = field(fork.next(), first);
    range(fork_first, text, 6, 4);
    field(fork.next(), second);
    ended<core::text::SplitAsciiWhitespace, core::text::Text>(fork.borrow());
    let empty: core::text::Text = literal("", 0);
    let empty_source: core::text::SplitAsciiWhitespace = empty.split_ascii_whitespace();
    ended<core::text::SplitAsciiWhitespace, core::text::Text>(empty_source.borrow());
    let whitespace_bytes: [u8; 6] = [9, 10, 11, 12, 13, 32];
    let whitespace: core::text::Text = core::result::unwrap(core::text::from_utf8(whitespace_bytes, 6));
    let none: core::text::SplitAsciiWhitespace = whitespace.split_ascii_whitespace();
    ended<core::text::SplitAsciiWhitespace, core::text::Text>(none.borrow());
}

fn main() -> i32 {
    let explicit: [u8; 16] = [255, 255, 44, 65, 44, 195, 169, 44, 44, 240, 159, 153, 130, 44, 255, 255];
    let delimiter: [u8; 3] = [255, 44, 255];
    let separator: core::text::Text = core::result::unwrap(core::text::from_utf8_range(delimiter, 1, 1));
    let selected: core::text::Text = core::result::unwrap(core::text::from_utf8_range(explicit, 2, 12));
    split_contracts(selected, separator);
    let ascii: [u8; 18] = [255, 9, 10, 11, 12, 13, 32, 65, 0, 195, 169, 11, 194, 160, 66, 32, 13, 255];
    let words: core::text::Text = core::result::unwrap(core::text::from_utf8_range(ascii, 1, 16));
    whitespace_contracts(words);
    let raw: [i32; 12] = [0; 12];
    let packed: [u8] = core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(raw), 48);
    let index: i32 = 0;
    while (index < 16) { packed[index + 1] = explicit[index]; index += 1; }
    index = 0;
    while (index < 18) { packed[index + 21] = ascii[index]; index += 1; }
    let packed_text: core::text::Text = core::result::unwrap(core::text::from_utf8_range(packed, 3, 12));
    split_contracts(packed_text, separator);
    let packed_words: core::text::Text = core::result::unwrap(core::text::from_utf8_range(packed, 22, 16));
    whitespace_contracts(packed_words);
    assert(explicit[0] == 255 && explicit[15] == 255 && ascii[0] == 255 && ascii[17] == 255);
    return 0;
}
