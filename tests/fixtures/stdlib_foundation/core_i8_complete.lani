module app::main;
import core::i8;
import core::option;

fn main() -> i32 {
    let minimum: i8 = -128;
    let maximum: i8 = 127;
    if (core::i8::MIN != minimum || core::i8::MAX != maximum ||
        core::i8::BITS != 8 || core::i8::BYTES != 1 ||
        core::i8::abs(-7) != 7 || core::i8::abs(minimum) != maximum ||
        core::i8::saturating_abs(minimum) != maximum ||
        !core::option::contains(core::i8::checked_abs(-7), 7) ||
        !core::option::is_none(core::i8::checked_abs(minimum))) {
        return 1;
    }
    if (core::i8::min(3, -5) != -5 || core::i8::max(3, -5) != 3 ||
        core::i8::clamp(12, 2, 10) != 10 ||
        core::i8::clamp(5, 10, 3) != 5 ||
        core::i8::signum(-7) != -1 || core::i8::signum(0) != 0 ||
        core::i8::signum(7) != 1 ||
        core::i8::compare_as_i32(minimum, maximum) != -1 ||
        core::i8::compare_as_i32(5, 5) != 0 ||
        core::i8::compare_as_i32(maximum, minimum) != 1) {
        return 2;
    }
    if (!core::i8::is_zero(0) || core::i8::is_zero(1) ||
        !core::i8::is_nonzero(-1) || core::i8::is_nonzero(0) ||
        !core::i8::is_even(-4) || core::i8::is_even(-3) ||
        !core::i8::is_odd(-3) || core::i8::is_odd(-4) ||
        !core::i8::is_negative(minimum) || core::i8::is_negative(0) ||
        !core::i8::is_positive(maximum) || core::i8::is_positive(0)) {
        return 3;
    }
    if (!core::i8::is_nonnegative(0) || core::i8::is_nonnegative(-1) ||
        !core::i8::is_nonpositive(0) || core::i8::is_nonpositive(1) ||
        !core::i8::between_inclusive(-3, -3, 2) ||
        core::i8::between_inclusive(-4, -3, 2) ||
        core::i8::between_inclusive(0, 2, -3) ||
        !core::i8::between_exclusive(0, -3, 2) ||
        core::i8::between_exclusive(-3, -3, 2)) {
        return 4;
    }
    if (core::i8::wrapping_add(maximum, 1) != minimum ||
        core::i8::wrapping_sub(minimum, 1) != maximum ||
        core::i8::wrapping_mul(maximum, 2) != -2 ||
        core::i8::saturating_add(maximum, 1) != maximum ||
        core::i8::saturating_sub(minimum, 1) != minimum ||
        core::i8::saturating_abs_diff(minimum, maximum) != maximum ||
        core::i8::saturating_abs_diff(9, 3) != 6) {
        return 5;
    }
    if (!core::option::contains(core::i8::checked_add(3, 5), 8) ||
        !core::option::contains(core::i8::checked_add(minimum, 0), minimum) ||
        !core::option::is_none(core::i8::checked_add(maximum, 1)) ||
        !core::option::is_none(core::i8::checked_add(minimum, -1)) ||
        !core::option::contains(core::i8::checked_sub(5, 3), 2) ||
        !core::option::contains(core::i8::checked_sub(-3, 5), -8) ||
        !core::option::is_none(core::i8::checked_sub(minimum, 1)) ||
        !core::option::is_none(core::i8::checked_sub(maximum, -1))) {
        return 6;
    }
    if (!core::i8::is_power_of_two(64) ||
        core::i8::is_power_of_two(maximum) ||
        core::i8::is_power_of_two(0) ||
        core::i8::is_power_of_two(-2) ||
        core::i8::next_power_of_two(0) != 1 ||
        core::i8::next_power_of_two(7) != 8 ||
        core::i8::next_power_of_two(64) != 64 ||
        core::i8::next_power_of_two(maximum) != 0) {
        return 7;
    }
    return 0;
}
