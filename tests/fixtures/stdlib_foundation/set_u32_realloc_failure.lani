module app::main;
import std::set_u32;

fn main() -> i32 {
    let value: std::set_u32::SetU32 = std::set_u32::try_reserve(std::set_u32::new(), 1);
    if (std::set_u32::capacity(value) != 1) { return 2; }
    value = std::set_u32::try_insert(value, 4294967289);
    if (std::set_u32::len(value) != 1) { return 3; }
    value = std::set_u32::try_insert(value, 42);
    if (std::set_u32::len(value) == 1 &&
        std::set_u32::capacity(value) == 1 &&
        std::set_u32::at_or(value, 0, 0) == 4294967289 &&
        !std::set_u32::contains(value, 42)) {
        std::set_u32::destroy(value);
        return 0;
    }
    if (std::set_u32::len(value) == 2 &&
        std::set_u32::capacity(value) == 2 &&
        std::set_u32::at_or(value, 0, 0) == 4294967289 &&
        std::set_u32::at_or(value, 1, 0) == 42) {
        std::set_u32::destroy(value);
        return 4;
    }
    std::set_u32::destroy(value);
    return 5;
}
