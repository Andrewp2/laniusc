module app::main;
import core::io;
import core::result;
struct SequentialReaderAndPositionalWriter {}
impl SequentialReaderAndPositionalWriter {
    fn borrow(&self) -> &SequentialReaderAndPositionalWriter { return self; }
}
pub impl core::io::Read for SequentialReaderAndPositionalWriter {
    pub fn read(&self,destination:[u8],offset:i32,count:i32) -> core::result::Result<i32,core::io::Error> { return core::result::Ok(0); }
}
pub impl core::io::WriteAt for SequentialReaderAndPositionalWriter {
    pub fn write_at(&self,source:[u8],offset:i32,count:i32,position:u64) -> core::result::Result<i32,core::io::Error> { return core::result::Ok(count); }
}
fn main() -> i32 {
    let data:[u8;1]=[99]; let source:SequentialReaderAndPositionalWriter=SequentialReaderAndPositionalWriter {};
    let rejected=core::io::read_exact_at<SequentialReaderAndPositionalWriter>(source.borrow(),data,0,1,0,1); // rejected_positional_bound
    return 0;
}
