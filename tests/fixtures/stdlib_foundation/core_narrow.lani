module app::main;
import core::option;
import core::i8;
import core::u8;
import core::i16;
import core::u16;

fn main() -> i32 {
    // i8 from i32
    if (core::i8::wrapping_from_i32(42) != 42) { return 1; }
    if (core::i8::wrapping_from_i32(257) != 1) { return 2; }
    if (core::i8::wrapping_from_i32(-1) != -1) { return 3; }
    if (core::option::unwrap_or(core::i8::checked_from_i32(42), 17) != 42) { return 4; }
    if (core::option::unwrap_or(core::i8::checked_from_i32(128), 17) != 17) { return 5; }
    if (core::i8::saturating_from_i32(42) != 42) { return 6; }
    if (core::i8::saturating_from_i32(128) != 127) { return 7; }
    if (core::option::unwrap_or(core::i8::checked_from_i32(-129), 17) != 17) { return 8; }
    if (core::i8::saturating_from_i32(-129) != -128) { return 9; }

    // i8 from u32
    if (core::i8::wrapping_from_u32(42) != 42) { return 10; }
    if (core::i8::wrapping_from_u32(257) != 1) { return 11; }
    if (core::i8::wrapping_from_u32(4294967295) != -1) { return 12; }
    if (core::option::unwrap_or(core::i8::checked_from_u32(42), 17) != 42) { return 13; }
    if (core::option::unwrap_or(core::i8::checked_from_u32(128), 17) != 17) { return 14; }
    if (core::i8::saturating_from_u32(42) != 42) { return 15; }
    if (core::i8::saturating_from_u32(128) != 127) { return 16; }
    if (core::option::unwrap_or(core::i8::checked_from_u32(4294967295), 17) != 17) { return 17; }
    if (core::i8::saturating_from_u32(4294967295) != 127) { return 18; }

    // u8 from i32
    if (core::u8::wrapping_from_i32(42) != 42) { return 19; }
    if (core::u8::wrapping_from_i32(257) != 1) { return 20; }
    if (core::u8::wrapping_from_i32(-1) != 255) { return 21; }
    if (core::option::unwrap_or(core::u8::checked_from_i32(42), 17) != 42) { return 22; }
    if (core::option::unwrap_or(core::u8::checked_from_i32(256), 17) != 17) { return 23; }
    if (core::u8::saturating_from_i32(42) != 42) { return 24; }
    if (core::u8::saturating_from_i32(256) != 255) { return 25; }
    if (core::option::unwrap_or(core::u8::checked_from_i32(-1), 17) != 17) { return 26; }
    if (core::u8::saturating_from_i32(-1) != 0) { return 27; }

    // u8 from u32
    if (core::u8::wrapping_from_u32(42) != 42) { return 28; }
    if (core::u8::wrapping_from_u32(257) != 1) { return 29; }
    if (core::u8::wrapping_from_u32(4294967295) != 255) { return 30; }
    if (core::option::unwrap_or(core::u8::checked_from_u32(42), 17) != 42) { return 31; }
    if (core::option::unwrap_or(core::u8::checked_from_u32(256), 17) != 17) { return 32; }
    if (core::u8::saturating_from_u32(42) != 42) { return 33; }
    if (core::u8::saturating_from_u32(256) != 255) { return 34; }
    if (core::option::unwrap_or(core::u8::checked_from_u32(4294967295), 17) != 17) { return 35; }
    if (core::u8::saturating_from_u32(4294967295) != 255) { return 36; }

    // i16 from i32
    if (core::i16::wrapping_from_i32(42) != 42) { return 37; }
    if (core::i16::wrapping_from_i32(65537) != 1) { return 38; }
    if (core::i16::wrapping_from_i32(-1) != -1) { return 39; }
    if (core::option::unwrap_or(core::i16::checked_from_i32(42), 17) != 42) { return 40; }
    if (core::option::unwrap_or(core::i16::checked_from_i32(32768), 17) != 17) { return 41; }
    if (core::i16::saturating_from_i32(42) != 42) { return 42; }
    if (core::i16::saturating_from_i32(32768) != 32767) { return 43; }
    if (core::option::unwrap_or(core::i16::checked_from_i32(-32769), 17) != 17) { return 44; }
    if (core::i16::saturating_from_i32(-32769) != -32768) { return 45; }

    // i16 from u32
    if (core::i16::wrapping_from_u32(42) != 42) { return 46; }
    if (core::i16::wrapping_from_u32(65537) != 1) { return 47; }
    if (core::i16::wrapping_from_u32(4294967295) != -1) { return 48; }
    if (core::option::unwrap_or(core::i16::checked_from_u32(42), 17) != 42) { return 49; }
    if (core::option::unwrap_or(core::i16::checked_from_u32(32768), 17) != 17) { return 50; }
    if (core::i16::saturating_from_u32(42) != 42) { return 51; }
    if (core::i16::saturating_from_u32(32768) != 32767) { return 52; }
    if (core::option::unwrap_or(core::i16::checked_from_u32(4294967295), 17) != 17) { return 53; }
    if (core::i16::saturating_from_u32(4294967295) != 32767) { return 54; }

    // u16 from i32
    if (core::u16::wrapping_from_i32(42) != 42) { return 55; }
    if (core::u16::wrapping_from_i32(65537) != 1) { return 56; }
    if (core::u16::wrapping_from_i32(-1) != 65535) { return 57; }
    if (core::option::unwrap_or(core::u16::checked_from_i32(42), 17) != 42) { return 58; }
    if (core::option::unwrap_or(core::u16::checked_from_i32(65536), 17) != 17) { return 59; }
    if (core::u16::saturating_from_i32(42) != 42) { return 60; }
    if (core::u16::saturating_from_i32(65536) != 65535) { return 61; }
    if (core::option::unwrap_or(core::u16::checked_from_i32(-1), 17) != 17) { return 62; }
    if (core::u16::saturating_from_i32(-1) != 0) { return 63; }

    // u16 from u32
    if (core::u16::wrapping_from_u32(42) != 42) { return 64; }
    if (core::u16::wrapping_from_u32(65537) != 1) { return 65; }
    if (core::u16::wrapping_from_u32(4294967295) != 65535) { return 66; }
    if (core::option::unwrap_or(core::u16::checked_from_u32(42), 17) != 42) { return 67; }
    if (core::option::unwrap_or(core::u16::checked_from_u32(65536), 17) != 17) { return 68; }
    if (core::u16::saturating_from_u32(42) != 42) { return 69; }
    if (core::u16::saturating_from_u32(65536) != 65535) { return 70; }
    if (core::option::unwrap_or(core::u16::checked_from_u32(4294967295), 17) != 17) { return 71; }
    if (core::u16::saturating_from_u32(4294967295) != 65535) { return 72; }

    // Full-width input boundaries retain only the documented target bits.
    if (core::i8::wrapping_from_i32(-2147483648) != 0) { return 73; }
    if (core::i16::wrapping_from_i32(2147483647) != -1) { return 74; }
    if (core::u8::wrapping_from_i32(2147483647) != 255) { return 75; }
    if (core::u16::wrapping_from_i32(-2147483648) != 0) { return 76; }
    if (core::option::unwrap_or(core::i8::checked_from_i32(-2147483648), 17) != 17) { return 77; }
    if (core::u8::saturating_from_i32(-2147483648) != 0) { return 78; }
    return 0;
}
