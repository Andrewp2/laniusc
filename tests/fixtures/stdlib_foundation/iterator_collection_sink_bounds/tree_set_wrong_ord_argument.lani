module app::main;
import alloc::hash_map;
import alloc::hash_set;
import alloc::tree_map;
import alloc::tree_set;
import alloc::binary_heap;
import core::cmp;
import core::hash;
import core::iter;
import core::option;
import core::result;
import core::slice;
struct Key { id: i32 }
pub impl core::cmp::Ord<i32> for Key {
    pub fn lt(left: i32, right: i32) -> bool { return left < right; }
    pub fn le(left: i32, right: i32) -> bool { return left <= right; }
    pub fn gt(left: i32, right: i32) -> bool { return left > right; }
    pub fn ge(left: i32, right: i32) -> bool { return left >= right; }
}
fn main() -> i32 {
    let value: Key = Key { id: 1 };
    let values: [Key; 1] = [value];
    let source: core::slice::Iter<Key> = core::result::unwrap(core::iter::from_slice<Key>(values, 1));
    let sink: alloc::tree_set::TreeSet<Key> = alloc::tree_set::new<Key>();
    let rejected: core::result::Result<core::iter::Transfer, core::iter::TransferError<Key, alloc::tree_map::SinkError>> = core::iter::try_transfer_up_to<core::slice::Iter<Key>, alloc::tree_set::TreeSet<Key>, Key, alloc::tree_map::SinkError>(source.borrow(), sink.borrow(), 1);
    return 0;
}
