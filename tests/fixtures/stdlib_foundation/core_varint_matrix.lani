module app::main;
import core::varint;
import core::varint_wide_u64;
import core::wide_u64;

fn roundtrip_wide(value: core::wide_u64::WideU64) -> bool {
    let zero: u8 = 0;
    let bytes: [u8; 10] = [zero, zero, zero, zero, zero,
        zero, zero, zero, zero, zero];
    let end: i32 = core::varint_wide_u64::write_wide_u64(bytes, 10, 0, value);
    if (end != core::varint_wide_u64::len_wide_u64(value)) { return false; }
    let decoded: core::varint_wide_u64::ReadWideU64 =
        core::varint_wide_u64::read_wide_u64(bytes, end, 0);
    return core::varint_wide_u64::status_wide_u64(decoded) == core::varint::OK &&
        core::varint_wide_u64::next_wide_u64_or(decoded, -1) == end &&
        core::wide_u64::eq(
            core::varint_wide_u64::value_wide_u64_or(decoded, core::wide_u64::zero()), value);
}

fn main() -> i32 {
    let zero: u8 = 0;
    let bytes: [u8; 5] = [zero, zero, zero, zero, zero];
    let value: u32 = 0;
    while (value < 256) {
        let end: i32 = core::varint::write_u32(bytes, 5, 0, value);
        if (end != core::varint::len_u32(value)) { return 1; }
        let decoded: core::varint::ReadU32 = core::varint::read_u32(bytes, end, 0);
        if (core::varint::status_u32(decoded) != core::varint::OK ||
            core::varint::value_u32_or(decoded, 4294967295) != value ||
            core::varint::next_u32_or(decoded, -1) != end) { return 2; }
        value += 1;
    }
    if (!roundtrip_wide(core::wide_u64::zero()) ||
        !roundtrip_wide(core::wide_u64::from_u32(127)) ||
        !roundtrip_wide(core::wide_u64::from_u32(128)) ||
        !roundtrip_wide(core::wide_u64::from_words(0, 4294967295)) ||
        !roundtrip_wide(core::wide_u64::from_words(1, 0)) ||
        !roundtrip_wide(core::wide_u64::from_words(2147483648, 0)) ||
        !roundtrip_wide(core::wide_u64::max_value())) { return 3; }
    if (core::varint::write_u32(bytes, 5, 0, 4294967295) != 5 ||
        bytes[0] != 255 || bytes[1] != 255 || bytes[2] != 255 ||
        bytes[3] != 255 || bytes[4] != 15) { return 4; }
    let maximum: core::varint::ReadU32 = core::varint::read_u32(bytes, 5, 0);
    if (core::varint::status_u32(maximum) != core::varint::OK ||
        core::varint::value_u32_or(maximum, 0) != 4294967295) { return 5; }
    let overflow: core::varint::ReadU32 = core::varint::read_u32(bytes, 4, 0);
    if (core::varint::status_u32(overflow) != core::varint::TRUNCATED) { return 6; }
    return 0;
}
