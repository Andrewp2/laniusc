module app::main;
import std::deque;

fn main() -> i32 {
    let value: std::deque::Deque<i32> = std::deque::try_with_capacity(2);
    if (std::deque::capacity(value) != 2) { return 5; }
    value = std::deque::try_push_back(value, 1);
    value = std::deque::try_push_back(value, 2);
    value = std::deque::try_push_back(value, 3);
    let failure: bool = std::deque::capacity(value) == 2 &&
        std::deque::len(value) == 2 &&
        std::deque::at_or(value, 0, 0) == 1 &&
        std::deque::at_or(value, 1, 0) == 2;
    let success: bool = std::deque::capacity(value) == 4 &&
        std::deque::len(value) == 3 &&
        std::deque::at_or(value, 0, 0) == 1 &&
        std::deque::at_or(value, 1, 0) == 2 &&
        std::deque::at_or(value, 2, 0) == 3;
    std::deque::destroy(value);
    if (failure) { return 0; }
    if (success) { return 4; }
    return 5;
}
