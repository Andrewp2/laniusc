module app::main;

fn main() -> i32 {
    let divisor: u32 = 10;
    let from_literal: u32 = 4294967295 % divisor;
    let maximum: u32 = 4294967295;
    let from_typed_value: u32 = maximum % divisor;
    if (from_typed_value != 5) {
        return 2;
    }
    if (from_literal != 5) {
        return 1;
    }
    return 0;
}
