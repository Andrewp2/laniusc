module app::main;
import core::slice_wide_i64;
import core::wide_i64;
fn main() -> i32 {
    let word_zero: u32 = 0;
    let values: [u32; 2] = [word_zero, word_zero];
    let fallback: core::wide_i64::WideI64 = core::wide_i64::zero();
    let item: core::wide_i64::WideI64 = core::slice_wide_i64::get_or(values, 2, 1, fallback);
    let low: u32 = core::wide_i64::low_word(item);
    return low as i32;
}
