// Returns 1 after a successful allocation, or 0 when mmap fails and alloc
// correctly reports null. The fault-injection test checks both paths.
module app::main;
import alloc::allocator;

fn main() -> i32 {
    let storage: ptr = alloc::allocator::alloc(12, 4);
    if (storage == 0) {
        return 0;
    }
    return 1;
}
