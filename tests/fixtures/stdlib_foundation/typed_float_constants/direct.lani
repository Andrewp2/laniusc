fn narrow<const V: f32>() -> f32 { return V; }
fn wide<const V: f64>() -> f64 { return V; }
fn forward<const V: f64>() -> f64 { return wide<V>(); }
fn main() -> i32 {
    let one32: f32 = 1.0;
    let even32: f32 = narrow<1.000000059604644775390625>();
    let above32: f32 = narrow<1.000000059604644775390626>();
    if (even32 != one32 || above32 - one32 != 1.1920928955078125e-7) { return 1; }
    let one64: f64 = 1.0;
    let precise: f64 = wide<1.0000000000000002>();
    if (precise - one64 != 2.220446049250313e-16) { return 2; }
    let large: f64 = wide<1.0e300>();
    if (!(large > 1.0e299 && large < 1.1e300) || forward<1.0e300>() != large) { return 3; }
    let tiny: f64 = wide<4.9406564584124654e-324>();
    if (tiny <= 0.0 || tiny + tiny != 9.8813129168249309e-324) { return 4; }
    let positive: f64 = wide<0.0>();
    let negative: f64 = wide<-0.0>();
    if (positive != 0.0 || negative != 0.0 || one64 / positive <= 0.0 || one64 / negative >= 0.0) { return 5; }
    if (wide<1.0000000000000002>() == wide<1.0>()) { return 6; }
    return 0;
}
