import core::float_constants;
fn main() -> i32 {
    let named = core::float_constants::forward<core::float_constants::LARGE, core::float_constants::NARROW>();
    let precise = core::float_constants::forward<core::float_constants::PRECISE, 1.0>();
    let zero = core::float_constants::forward<core::float_constants::NEGATIVE_ZERO, -0.0>();
    let direct = core::float_constants::forward<1.0000000000000002, 1.000000059604644775390626>();
    let one64: f64 = 1.0;
    let one32: f32 = 1.0;
    if (!(named.nested.value > 1.0e299 && named.nested.value < 1.1e300) ||
        named.small - one32 != 1.1920928955078125e-7) { return 1; }
    if (precise.nested.value - one64 != 2.220446049250313e-16 || precise.small != one32) { return 2; }
    if (zero.nested.value != 0.0 || zero.small != 0.0 ||
        one64 / zero.nested.value >= 0.0 || one32 / zero.small >= 0.0) { return 3; }
    if (direct.nested.value != precise.nested.value || direct.small != named.small) { return 4; }
    if (core::float_constants::wide<core::float_constants::LARGE>() != named.nested.value) { return 5; }
    return 0;
}
