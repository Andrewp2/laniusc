module app::main;
import std::utf8_vec;
import std::vec_u8;

fn main() -> i32 {
    let a: u8 = 65;
    let b: u8 = 66;
    let z: u8 = 90;
    let c2: u8 = 194;
    let a2: u8 = 162;
    let e2: u8 = 226;
    let cont82: u8 = 130;
    let ac: u8 = 172;
    let rupee_tail: u8 = 185;
    let f0: u8 = 240;
    let cont9f: u8 = 159;
    let cont99: u8 = 153;
    let low: u8 = 128;
    let source: [u8; 4] = [a, c2, a2, b];
    let euro: [u8; 3] = [e2, cont82, ac];
    let rupee: [u8; 3] = [e2, cont82, rupee_tail];
    let smile: [u8; 4] = [f0, cont9f, cont99, cont82];
    let z_bytes: [u8; 1] = [z];
    let empty_bytes: [u8; 1] = [a];
    let malformed: [u8; 2] = [a, low];
    let truncated: [u8; 2] = [e2, cont82];

    let text: std::vec_u8::VecU8 = std::utf8_vec::new();
    text = std::utf8_vec::try_insert_bytes(text, 0, source, 4);
    if (std::utf8_vec::byte_len(text) != 4 ||
        std::utf8_vec::scalar_count_or(text, -9) != 3 ||
        std::utf8_vec::scalar_at_or(text, 0, 4294967295) != 65 ||
        std::utf8_vec::scalar_at_or(text, 1, 4294967295) != 162 ||
        std::utf8_vec::scalar_at_or(text, 2, 4294967295) != 66) { return 1; }

    text = std::utf8_vec::try_insert_bytes(text, 1, euro, 3);
    if (std::utf8_vec::byte_len(text) != 7 ||
        std::utf8_vec::scalar_count_or(text, -9) != 4 ||
        std::utf8_vec::scalar_at_or(text, 1, 4294967295) != 8364 ||
        std::utf8_vec::scalar_at_or(text, 2, 4294967295) != 162) { return 2; }

    text = std::utf8_vec::try_splice_bytes(text, 2, 1, smile, 4);
    if (std::utf8_vec::byte_len(text) != 9 ||
        std::utf8_vec::scalar_at_or(text, 2, 4294967295) != 128578 ||
        std::utf8_vec::scalar_at_or(text, 3, 4294967295) != 66) { return 3; }
    text = std::utf8_vec::try_splice_bytes(text, 1, 1, rupee, 3);
    if (std::utf8_vec::byte_len(text) != 9 ||
        std::utf8_vec::scalar_at_or(text, 1, 4294967295) != 8377 ||
        std::utf8_vec::scalar_at_or(text, 2, 4294967295) != 128578) { return 4; }
    text = std::utf8_vec::try_splice_bytes(text, 2, 1, z_bytes, 1);
    if (std::utf8_vec::byte_len(text) != 6 ||
        std::utf8_vec::scalar_at_or(text, 2, 4294967295) != 90 ||
        std::utf8_vec::scalar_at_or(text, 3, 4294967295) != 66) { return 5; }
    text = std::utf8_vec::try_splice_bytes(text, 1, 2, empty_bytes, 0);
    if (std::utf8_vec::byte_len(text) != 2 ||
        std::utf8_vec::scalar_count_or(text, -9) != 2 ||
        std::vec_u8::get_or(text, 0, 0) != a ||
        std::vec_u8::get_or(text, 1, 0) != b) { return 6; }
    text = std::utf8_vec::try_insert_bytes(text, 2, euro, 3);
    if (std::utf8_vec::byte_len(text) != 5 ||
        std::utf8_vec::scalar_at_or(text, 2, 4294967295) != 8364) { return 7; }

    text = std::utf8_vec::try_insert_bytes(text, -1, euro, 3);
    text = std::utf8_vec::try_insert_bytes(text, 4, euro, 3);
    text = std::utf8_vec::try_insert_bytes(text, 1, malformed, 2);
    text = std::utf8_vec::try_insert_bytes(text, 1, truncated, 2);
    text = std::utf8_vec::try_insert_bytes(text, 1, euro, -1);
    text = std::utf8_vec::try_insert_bytes(text, 1, euro, 2147483647);
    text = std::utf8_vec::try_splice_bytes(text, 1, -1, z_bytes, 1);
    text = std::utf8_vec::try_splice_bytes(text, 1, 3, z_bytes, 1);
    text = std::utf8_vec::try_splice_bytes(text, 1, 1, malformed, 2);
    text = std::utf8_vec::try_splice_bytes(text, 1, 1, truncated, 2);
    text = std::utf8_vec::try_splice_bytes(text, 1, 1, euro, -1);
    text = std::utf8_vec::try_splice_bytes(text, 1, 1, euro, 2147483647);
    text = std::utf8_vec::try_splice_bytes(text, 3, 0, empty_bytes, 0);
    if (std::utf8_vec::byte_len(text) != 5 ||
        std::utf8_vec::scalar_count_or(text, -9) != 3 ||
        std::vec_u8::get_or(text, 0, 0) != a ||
        std::vec_u8::get_or(text, 1, 0) != b ||
        std::vec_u8::get_or(text, 2, 0) != e2 ||
        std::vec_u8::get_or(text, 3, 0) != cont82 ||
        std::vec_u8::get_or(text, 4, 0) != ac) { return 8; }

    let invalid: std::vec_u8::VecU8 = std::vec_u8::new();
    invalid = std::vec_u8::try_push(invalid, a);
    invalid = std::vec_u8::try_push(invalid, low);
    invalid = std::utf8_vec::try_insert_bytes(invalid, 0, euro, 3);
    invalid = std::utf8_vec::try_splice_bytes(invalid, 0, 1, euro, 3);
    if (std::utf8_vec::byte_len(invalid) != 2 ||
        std::vec_u8::get_or(invalid, 0, 0) != a ||
        std::vec_u8::get_or(invalid, 1, 0) != low) { return 9; }
    std::utf8_vec::destroy(invalid);
    std::utf8_vec::destroy(text);
    return 0;
}
