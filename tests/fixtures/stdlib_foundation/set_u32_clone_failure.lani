module app::main;
import std::set_u32;

fn main() -> i32 {
    let value: std::set_u32::SetU32 = std::set_u32::try_insert(std::set_u32::new(), 4294967255);
    if (std::set_u32::len(value) != 1) { return 2; }
    let copy: std::set_u32::SetU32 = std::set_u32::try_clone(value);
    if (std::set_u32::len(copy) == 0 &&
        std::set_u32::capacity(copy) == 0 &&
        std::set_u32::at_or(value, 0, 0) == 4294967255) {
        std::set_u32::destroy(copy);
        std::set_u32::destroy(value);
        return 0;
    }
    if (std::set_u32::len(copy) == 1 &&
        std::set_u32::at_or(copy, 0, 0) == 4294967255 &&
        std::set_u32::at_or(value, 0, 0) == 4294967255) {
        std::set_u32::destroy(copy);
        std::set_u32::destroy(value);
        return 4;
    }
    std::set_u32::destroy(copy);
    std::set_u32::destroy(value);
    return 5;
}
