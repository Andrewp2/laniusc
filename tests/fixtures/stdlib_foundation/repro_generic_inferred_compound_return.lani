// The result introduces a concrete array application without an annotation.
fn duplicate<T>(value: T) -> [T; 2] { return [value, value]; }
fn main() -> i32 {
    let values = duplicate(42);
    if (values[0] != 42 || values[1] != 42) { return 1; }
    values[0] = -7;
    if (values[0] != -7 || values[1] != 42) { return 2; }
    return 0;
}
