module app::main;
import core::slice_bool;

fn main() -> i32 {
    let values: [bool; 4] = [true, false, true, false];
    if (!core::slice_bool::get_or(values, 4, 0, false) ||
        core::slice_bool::get_or(values, 4, 1, true) ||
        !core::slice_bool::get_or(values, 4, -1, true) ||
        core::slice_bool::get_or(values, 0, 0, false) ||
        !core::slice_bool::get_or(values, 4, 4, true)) {
        return 1;
    }
    if (core::slice_bool::set(values, -1, 0, false) ||
        core::slice_bool::set(values, 4, -1, false) ||
        core::slice_bool::set(values, 4, 4, true) ||
        !values[0] || values[1] ||
        !core::slice_bool::set(values, 4, 1, true) || !values[1]) {
        return 2;
    }
    if (core::slice_bool::fill(values, -1, false) != 0 ||
        core::slice_bool::fill(values, 0, false) != 0 ||
        !values[0] || !values[1] ||
        core::slice_bool::fill(values, 4, false) != 4 ||
        values[0] || values[3]) {
        return 3;
    }
    values[0] = true;
    if (core::slice_bool::swap(values, 4, -1, 0) ||
        core::slice_bool::swap(values, 4, 0, 4) ||
        core::slice_bool::swap(values, 0, 0, 0) ||
        !values[0] || values[1] ||
        !core::slice_bool::swap(values, 4, 0, 1) ||
        values[0] || !values[1]) {
        return 4;
    }
    if (core::slice_bool::copy_within(values, 4, 0, 5, 0) ||
        core::slice_bool::copy_within(values, 4, 2, 1, 0) ||
        core::slice_bool::copy_within(values, 4, 0, 3, 2) ||
        core::slice_bool::copy_within(values, -1, 0, 0, 0) ||
        values[0] || !values[1]) {
        return 5;
    }
    values[0] = true;
    values[1] = false;
    values[2] = true;
    values[3] = false;
    if (!core::slice_bool::copy_within(values, 4, 0, 3, 1) ||
        !values[0] || !values[1] || values[2] || !values[3] ||
        !core::slice_bool::copy_within(values, 4, 1, 4, 0) ||
        !values[0] || values[1] || !values[2] || !values[3]) {
        return 6;
    }
    if (core::slice_bool::reverse(values, -1) != 0 ||
        core::slice_bool::reverse(values, 0) != 0 ||
        !values[0] || values[1] ||
        core::slice_bool::reverse(values, 4) != 4 ||
        !values[0] || !values[1] || values[2] || !values[3]) {
        return 7;
    }
    let copied: [bool; 4] = [false, false, false, false];
    if (core::slice_bool::copy_prefix(values, -1, copied, 4) != -1 ||
        core::slice_bool::copy_prefix(values, 4, copied, -1) != -1 ||
        copied[0] || copied[3] ||
        core::slice_bool::copy_prefix(values, 0, copied, 4) != 0 ||
        core::slice_bool::copy_prefix(values, 4, copied, 3) != 3 ||
        !copied[0] || !copied[1] || copied[2] || copied[3] ||
        core::slice_bool::copy_prefix(values, 4, values, 4) != 4 ||
        !values[0] || !values[3]) {
        return 8;
    }
    let flags: [bool; 5] = [true, false, true, false, true];
    let same: [bool; 5] = [true, false, true, false, true];
    let different: [bool; 5] = [true, false, false, false, true];
    if (core::slice_bool::count_true(flags, -1) != -1 ||
        core::slice_bool::count_true(flags, 0) != 0 ||
        core::slice_bool::count_true(flags, 5) != 3 ||
        !core::slice_bool::any(flags, 5) ||
        core::slice_bool::any(flags, 0) ||
        core::slice_bool::any(flags, -1) ||
        core::slice_bool::all(flags, 5) ||
        !core::slice_bool::all(flags, 0) ||
        core::slice_bool::all(flags, -1)) {
        return 9;
    }
    if (core::slice_bool::first_index_or(flags, 5, true, -7) != 0 ||
        core::slice_bool::first_index_or(flags, 5, false, -7) != 1 ||
        core::slice_bool::last_index_or(flags, 5, true, -7) != 4 ||
        core::slice_bool::last_index_or(flags, 5, false, -7) != 3 ||
        core::slice_bool::first_index_or(flags, 0, true, -7) != -7 ||
        core::slice_bool::last_index_or(flags, -1, false, -7) != -7 ||
        !core::slice_bool::equal(flags, 5, same, 5) ||
        core::slice_bool::equal(flags, 5, different, 5) ||
        core::slice_bool::equal(flags, 5, same, 4) ||
        core::slice_bool::equal(flags, -1, same, -1) ||
        !core::slice_bool::equal(flags, 0, same, 0)) {
        return 10;
    }
    if (core::slice_bool::sort(flags, -1) ||
        !flags[0] || flags[1] ||
        !core::slice_bool::sort(flags, 5) ||
        flags[0] || flags[1] || !flags[2] || !flags[3] || !flags[4] ||
        !core::slice_bool::sort(flags, 0) ||
        core::slice_bool::first_index_or(flags, 2, true, -7) != -7 ||
        !core::slice_bool::all(flags, 0)) {
        return 11;
    }
    let mask: i32 = 0;
    while (mask < 32) {
        let work: [bool; 5] = [false, false, false, false, false];
        let bits: i32 = mask;
        let expected_true: i32 = 0;
        let bit: i32 = 0;
        while (bit < 5) {
            if (bits % 2 == 1) {
                work[bit] = true;
                expected_true += 1;
            }
            bits = bits / 2;
            bit += 1;
        }
        if (core::slice_bool::count_true(work, 5) != expected_true ||
            !core::slice_bool::sort(work, 5)) {
            return 12;
        }
        let index: i32 = 0;
        while (index < 5) {
            let expected: bool = index >= 5 - expected_true;
            if (work[index] != expected) { return 13; }
            index += 1;
        }
        mask += 1;
    }
    return 0;
}
