module app::main;
import core::wide_u64;
import core::wide_u64_range;
fn matches(value: core::wide_u64::WideU64, high: u32, low: u32) -> bool {
    return core::wide_u64::high_word(value) == high && core::wide_u64::low_word(value) == low;
}
fn main() -> i32 {
    let zero: core::wide_u64::WideU64 = core::wide_u64::zero();
    let boundary: core::wide_u64::WideU64 = core::wide_u64::from_words(2147483647, 4294967295);
    let high: core::wide_u64::WideU64 = core::wide_u64::from_words(2147483648, 0);
    let next: core::wide_u64::WideU64 = core::wide_u64::from_words(2147483648, 1);
    let max: core::wide_u64::WideU64 = core::wide_u64::max_value();
    let half: core::wide_u64_range::Range = core::wide_u64_range::range(boundary, next);
    if (!matches(core::wide_u64_range::start(half), 2147483647, 4294967295) || !matches(core::wide_u64_range::end(half), 2147483648, 1) || core::wide_u64_range::is_empty(half)) {
        return 1;
    }
    if (!core::wide_u64_range::contains(half, boundary) || !core::wide_u64_range::contains(half, high) || core::wide_u64_range::contains(half, next) || core::wide_u64_range::contains(half, zero)) {
        return 2;
    }
    let overlapping: core::wide_u64_range::Range = core::wide_u64_range::range(high, max);
    let touching: core::wide_u64_range::Range = core::wide_u64_range::range(next, max);
    let empty: core::wide_u64_range::Range = core::wide_u64_range::range(high, high);
    let reversed: core::wide_u64_range::Range = core::wide_u64_range::range(next, boundary);
    if (!core::wide_u64_range::overlaps(half, overlapping) || core::wide_u64_range::overlaps(half, touching) || !core::wide_u64_range::is_empty(empty) || !core::wide_u64_range::is_empty(reversed) || core::wide_u64_range::contains(empty, high) || core::wide_u64_range::overlaps(empty, overlapping)) {
        return 3;
    }
    if (!matches(half.start(), 2147483647, 4294967295) || !matches(half.end(), 2147483648, 1) || half.is_empty() || !half.contains(high) || half.contains(next) || !half.overlaps(overlapping) || half.overlaps(touching)) {
        return 10;
    }
    let inclusive: core::wide_u64_range::RangeInclusive = core::wide_u64_range::range_inclusive(boundary, high);
    if (!matches(core::wide_u64_range::start_inclusive(inclusive), 2147483647, 4294967295) || !matches(core::wide_u64_range::end_inclusive(inclusive), 2147483648, 0) || core::wide_u64_range::is_empty_inclusive(inclusive)) {
        return 4;
    }
    if (!core::wide_u64_range::contains_inclusive(inclusive, boundary) || !core::wide_u64_range::contains_inclusive(inclusive, high) || core::wide_u64_range::contains_inclusive(inclusive, next)) {
        return 5;
    }
    let inclusive_touch: core::wide_u64_range::RangeInclusive = core::wide_u64_range::range_inclusive(high, max);
    let inclusive_after: core::wide_u64_range::RangeInclusive = core::wide_u64_range::range_inclusive(next, max);
    let inclusive_single: core::wide_u64_range::RangeInclusive = core::wide_u64_range::range_inclusive(high, high);
    let inclusive_empty: core::wide_u64_range::RangeInclusive = core::wide_u64_range::range_inclusive(next, boundary);
    if (!core::wide_u64_range::overlaps_inclusive(inclusive, inclusive_touch) || core::wide_u64_range::overlaps_inclusive(inclusive, inclusive_after) || !core::wide_u64_range::contains_inclusive(inclusive_single, high) || core::wide_u64_range::is_empty_inclusive(inclusive_single) || !core::wide_u64_range::is_empty_inclusive(inclusive_empty) || core::wide_u64_range::overlaps_inclusive(inclusive_empty, inclusive_touch)) {
        return 6;
    }
    if (!matches(inclusive.start(), 2147483647, 4294967295) || !matches(inclusive.end(), 2147483648, 0) || inclusive.is_empty() || !inclusive.contains(high) || inclusive.contains(next) || !inclusive.overlaps(inclusive_touch) || inclusive.overlaps(inclusive_after)) {
        return 11;
    }
    let from: core::wide_u64_range::RangeFrom = core::wide_u64_range::range_from(high);
    if (!matches(core::wide_u64_range::start_from(from), 2147483648, 0) || !core::wide_u64_range::contains_from(from, high) || !core::wide_u64_range::contains_from(from, max) || core::wide_u64_range::contains_from(from, boundary)) {
        return 7;
    }
    if (!matches(from.start(), 2147483648, 0) || !from.contains(max) || from.contains(boundary)) {
        return 12;
    }
    let to: core::wide_u64_range::RangeTo = core::wide_u64_range::range_to(high);
    if (!matches(core::wide_u64_range::end_to(to), 2147483648, 0) || !core::wide_u64_range::contains_to(to, boundary) || core::wide_u64_range::contains_to(to, high) || core::wide_u64_range::contains_to(to, max)) {
        return 8;
    }
    if (!matches(to.end(), 2147483648, 0) || !to.contains(boundary) || to.contains(high)) {
        return 13;
    }
    let to_zero: core::wide_u64_range::RangeTo = core::wide_u64_range::range_to(zero);
    if (core::wide_u64_range::contains_to(to_zero, zero)) {
        return 9;
    }
    if (!core::wide_u64_range::full_contains(zero) || !core::wide_u64_range::full_contains(high) || !core::wide_u64_range::full_contains(max)) {
        return 14;
    }
    return 0;
}
