module app::main;

fn write_two(output: [u8], first: i32, second: i32) -> i32 {
    let index: i32 = 0;
    output[index] = first as u8;
    index += 1;
    if (second > 0) {
        output[index] = second as u8;
        index += 1;
    }
    return index;
}

fn main() -> i32 {
    let zero: u8 = 0;
    let expected_first: u8 = 102;
    let expected_second: u8 = 111;
    let output: [u8; 2] = [zero, zero];
    if (write_two(output, 102, 111) != 2) { return 2; }
    if (output[0] != expected_first || output[1] != expected_second) { return 1; }
    let next: i32 = 200;
    let expected_next: u8 = 200;
    output[0] = next as u8;
    if (output[0] != expected_next || output[1] != expected_second) { return 3; }
    return 0;
}
