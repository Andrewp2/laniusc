struct Bound { value: i32 }
fn endpoint(calls: [i32]) -> i32 { calls[0] += 1; return 3; }
fn endpoints(calls: [i32]) -> [i32; 1] { calls[0] += 1; return [3]; }
fn main() -> i32 {
    let calls: [i32; 1] = [0];
    let sum: i32 = 0;
    for value in 0..endpoint(calls) { sum += value; }
    if (sum != 3 || calls[0] != 1) { return 1; }
    let bounds: [i32; 1] = [3];
    sum = 0;
    for value in 0..=bounds[0] {
        bounds[0] = 0;
        sum += value;
    }
    if (sum != 6 || bounds[0] != 0) { return 2; }
    let bound: Bound = Bound { value: 2 };
    sum = 0;
    for value in 0..bound.value {
        bound.value = 0;
        sum += value;
    }
    if (sum != 1 || bound.value != 0) { return 3; }
    sum = 0;
    for value in 0..endpoints(calls)[0] { sum += value; }
    if (sum != 3 || calls[0] != 2) { return 4; }
    return 0;
}
