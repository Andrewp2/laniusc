module app::main;
import core::mem;
import core::slice;

fn main() -> i32 {
    let backing:[i32; 5] = [0, 0, 0, 0, 0];
    let values:[i32] = core::mem::i32_slice_from_raw_parts(core::mem::i32_array_data_ptr(backing), 5);
    let a:i32 = -1;
    while (a<=1) {
        let b:i32 = -1;
        while (b<=1) {
            let c:i32 = -1;
            while (c<=1) {
                let d:i32 = -1;
                while (d<=1) {
                    let e:i32 = -1;
                    while (e<=1) {
                        backing[0] = a;
                        backing[1] = b;
                        backing[2] = c;
                        backing[3] = d;
                        backing[4] = e;
                        let negative:i32 = 0;
                        let zero:i32 = 0;
                        let index:i32 = 0;
                        while (index<5) {
                            if (backing[index] == -1) {
                                negative += 1;
                            }
                            if (backing[index] == 0) {
                                zero += 1;
                            }
                            index += 1;
                        }
                        if (core::slice::sort(values, 5) != 5) {
                            return 1;
                        }
                        index = 0;
                        while (index<5) {
                            let expected:i32 = 1;
                            if (index<negative) {
                                expected = -1;
                            } else {
                                if (index<negative + zero) {
                                    expected = 0;
                                }
                            }
                            if (backing[index] != expected) {
                                return 2;
                            }
                            index += 1;
                        }
                        e += 1;
                    }
                    d += 1;
                }
                c += 1;
            }
            b += 1;
        }
        a += 1;
    }
    return 0;
}
