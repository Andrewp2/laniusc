module app::main;
import std::deque_u16;

fn main() -> i32 {
    let value: std::deque_u16::DequeU16 = std::deque_u16::try_with_capacity(3);
    let failure: bool = std::deque_u16::capacity(value) == 0 && std::deque_u16::len(value) == 0;
    let success: bool = std::deque_u16::capacity(value) == 3 && std::deque_u16::len(value) == 0;
    std::deque_u16::destroy(value);
    if (failure) { return 0; }
    if (success) { return 4; }
    return 5;
}
