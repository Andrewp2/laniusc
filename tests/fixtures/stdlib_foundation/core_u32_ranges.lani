module app::main;
import core::range;

fn main() -> i32 {
    let high: u32 = 2147483648;
    let maximum: u32 = 4294967295;
    let low: u32 = 1;
    let zero: u32 = 0;
    let open: core::range::Range<u32> = core::range::range(high, maximum);
    let touching: core::range::Range<u32> = core::range::range(maximum, maximum);
    let overlapping: core::range::Range<u32> = core::range::range(high + 1, maximum);
    let reversed: core::range::Range<u32> = core::range::range(maximum, high);
    if (core::range::start(open) != high || core::range::end(open) != maximum || core::range::is_empty(open) || !core::range::is_empty(touching) || !core::range::is_empty(reversed)) {
        return 1;
    }
    if (!core::range::contains(open, high) || !core::range::contains(open, maximum - 1) || core::range::contains(open, maximum) || core::range::contains(open, 1) || core::range::contains(reversed, high)) {
        return 2;
    }
    if (!core::range::overlaps(open, overlapping) || core::range::overlaps(open, touching) || core::range::overlaps(open, reversed)) {
        return 3;
    }
    let closed: core::range::RangeInclusive<u32> = core::range::range_inclusive(high, maximum);
    let singleton: core::range::RangeInclusive<u32> = core::range::range_inclusive(maximum, maximum);
    let closed_reversed: core::range::RangeInclusive<u32> = core::range::range_inclusive(maximum, high);
    if (core::range::start_inclusive(closed) != high || core::range::end_inclusive(closed) != maximum || core::range::is_empty_inclusive(closed) || core::range::is_empty_inclusive(singleton) || !core::range::is_empty_inclusive(closed_reversed)) {
        return 4;
    }
    if (!core::range::contains_inclusive(closed, high) || !core::range::contains_inclusive(closed, maximum) || core::range::contains_inclusive(closed, 1) || !core::range::contains_inclusive(singleton, maximum) || core::range::contains_inclusive(closed_reversed, high)) {
        return 5;
    }
    if (!core::range::overlaps_inclusive(closed, singleton) || core::range::overlaps_inclusive(closed, closed_reversed)) {
        return 6;
    }
    let from: core::range::RangeFrom<u32> = core::range::range_from(high);
    if (core::range::start_from(from) != high || !core::range::contains_from(from, high) || !core::range::contains_from(from, maximum) || core::range::contains_from(from, 1)) {
        return 7;
    }
    let to: core::range::RangeTo<u32> = core::range::range_to(high);
    let empty_to: core::range::RangeTo<u32> = core::range::range_to(0);
    if (core::range::end_to(to) != high || !core::range::contains_to(to, high - 1) || core::range::contains_to(to, high) || core::range::contains_to(empty_to, 0)) {
        return 8;
    }
    let full: core::range::RangeFull = core::range::range_full();
    if (!core::range::contains_full(full, 0) || !core::range::contains_full(full, maximum)) {
        return 9;
    }
    if (open.start() != high || open.end() != maximum || open.is_empty() || !touching.is_empty() || !reversed.is_empty()) {
        return 10;
    }
    if (!open.contains(high) || !open.contains(maximum - 1) || open.contains(maximum) || open.contains(low) || reversed.contains(high) || !open.overlaps(overlapping) || open.overlaps(touching) || open.overlaps(reversed)) {
        return 11;
    }
    if (closed.start() != high || closed.end() != maximum || closed.is_empty() || singleton.is_empty() || !closed_reversed.is_empty() || !closed.contains(high) || !closed.contains(maximum) || closed.contains(low) || !singleton.contains(maximum) || closed_reversed.contains(high) || !closed.overlaps(singleton) || closed.overlaps(closed_reversed)) {
        return 12;
    }
    if (from.start() != high || !from.contains(high) || !from.contains(maximum) || from.contains(low) || to.end() != high || !to.contains(high - 1) || to.contains(high) || empty_to.contains(zero)) {
        return 13;
    }
    return 0;
}
