module app::main;
import std::deque_bool;

fn main() -> i32 {
    let value: std::deque_bool::DequeBool = std::deque_bool::new();
    if (std::deque_bool::MAX_CAPACITY != 536870911 ||
        !std::deque_bool::is_empty(value) ||
        std::deque_bool::len(value) != 0 ||
        std::deque_bool::capacity(value) != 0 ||
        !std::deque_bool::front_or(value, true) ||
        std::deque_bool::back_or(value, false) ||
        !std::deque_bool::at_or(value, -1, true) ||
        std::deque_bool::contains(value, false) ||
        std::deque_bool::try_set(value, 0, true) ||
        std::deque_bool::try_swap(value, 0, 0)) { return 1; }
    value = std::deque_bool::try_pop_front(value);
    value = std::deque_bool::try_pop_back(value);
    value = std::deque_bool::try_reserve(value, -1);
    value = std::deque_bool::try_reserve(value, 536870912);
    if (std::deque_bool::len(value) != 0 || std::deque_bool::capacity(value) != 0) { return 2; }
    std::deque_bool::destroy(value);

    let items: std::deque_bool::DequeBool = std::deque_bool::try_with_capacity(3);
    if (std::deque_bool::capacity(items) != 3 || !std::deque_bool::is_empty(items)) { return 3; }
    items = std::deque_bool::try_push_back(items, true);
    items = std::deque_bool::try_push_back(items, false);
    items = std::deque_bool::try_push_back(items, true);
    if (std::deque_bool::len(items) != 3 || !std::deque_bool::front_or(items, false) ||
        !std::deque_bool::back_or(items, false) || !std::deque_bool::contains(items, false)) { return 4; }
    items = std::deque_bool::try_pop_front(items);
    items = std::deque_bool::try_push_back(items, false);
    if (std::deque_bool::len(items) != 3 ||
        std::deque_bool::at_or(items, 0, true) ||
        !std::deque_bool::at_or(items, 1, false) ||
        std::deque_bool::at_or(items, 2, true)) { return 5; }
    items = std::deque_bool::try_push_front(items, true);
    if (std::deque_bool::len(items) != 4 || std::deque_bool::capacity(items) != 6 ||
        !std::deque_bool::front_or(items, false) || std::deque_bool::back_or(items, true) ||
        !std::deque_bool::at_or(items, -1, true) ||
        std::deque_bool::at_or(items, 4, false)) { return 6; }
    if (std::deque_bool::try_set(items, -1, false) ||
        std::deque_bool::try_set(items, 4, false) ||
        !std::deque_bool::try_set(items, 1, true) ||
        !std::deque_bool::at_or(items, 1, false) ||
        std::deque_bool::try_swap(items, 0, 4) ||
        !std::deque_bool::try_swap(items, 0, 3) ||
        std::deque_bool::front_or(items, true) ||
        !std::deque_bool::back_or(items, false)) { return 7; }
    let copy: std::deque_bool::DequeBool = std::deque_bool::try_clone(items);
    if (std::deque_bool::len(copy) != 4 || std::deque_bool::capacity(copy) != 4 ||
        std::deque_bool::front_or(copy, true) ||
        !std::deque_bool::try_set(copy, 0, true) ||
        !std::deque_bool::front_or(copy, false) ||
        std::deque_bool::front_or(items, true)) { return 8; }
    std::deque_bool::destroy(copy);

    items = std::deque_bool::try_pop_back(items);
    items = std::deque_bool::try_pop_front(items);
    if (std::deque_bool::len(items) != 2 ||
        !std::deque_bool::front_or(items, false) ||
        !std::deque_bool::back_or(items, false)) { return 9; }
    items = std::deque_bool::try_shrink_to_fit(items);
    if (std::deque_bool::capacity(items) != 2 ||
        !std::deque_bool::at_or(items, 0, false) ||
        !std::deque_bool::at_or(items, 1, false)) { return 10; }
    items = std::deque_bool::clear(items);
    if (!std::deque_bool::is_empty(items) || std::deque_bool::capacity(items) != 2 ||
        std::deque_bool::contains(items, true)) { return 11; }
    let empty_copy: std::deque_bool::DequeBool = std::deque_bool::try_clone(items);
    if (std::deque_bool::len(empty_copy) != 0 || std::deque_bool::capacity(empty_copy) != 0) { return 12; }
    std::deque_bool::destroy(empty_copy);
    items = std::deque_bool::try_push_front(items, false);
    if (std::deque_bool::front_or(items, true)) { return 13; }
    items = std::deque_bool::try_pop_front(items);
    items = std::deque_bool::try_shrink_to_fit(items);
    if (std::deque_bool::capacity(items) != 0) { return 14; }
    std::deque_bool::destroy(items);

    let wrapped: std::deque_bool::DequeBool = std::deque_bool::try_with_capacity(3);
    wrapped = std::deque_bool::try_push_back(wrapped, true);
    wrapped = std::deque_bool::try_push_back(wrapped, false);
    wrapped = std::deque_bool::try_push_back(wrapped, true);
    wrapped = std::deque_bool::try_pop_front(wrapped);
    wrapped = std::deque_bool::try_push_back(wrapped, false);
    wrapped = std::deque_bool::try_reserve(wrapped, 5);
    if (std::deque_bool::capacity(wrapped) != 5 || std::deque_bool::len(wrapped) != 3 ||
        std::deque_bool::at_or(wrapped, 0, true) ||
        !std::deque_bool::at_or(wrapped, 1, false) ||
        std::deque_bool::at_or(wrapped, 2, true)) { return 15; }
    std::deque_bool::destroy(wrapped);
    return 0;
}
