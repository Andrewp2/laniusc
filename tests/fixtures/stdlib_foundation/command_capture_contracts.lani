module app::main;
import alloc::vec;
import core::mem;
import core::option;
import core::slice;
import core::time;
import std::clock;
import std::command;
import std::command_raw;
import std::command_capture;
import std::signal;
fn bytes(value: str, n: i32) -> core::slice::View<u8> { let raw: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::string_data_ptr(value),n); return core::slice::view(raw,n).unwrap(); }
fn taken(result: std::command::Spawn) -> std::command::Child { return match(result) { std::command::Spawn::Child(child) -> child, std::command::Spawn::Unknown(value) -> unexpected(value.child), _ -> impossible() }; }
fn unexpected(child: std::command::Child) -> std::command::Child { child.cancel_and_wait(); assert(false); return child; }
fn impossible() -> std::command::Child { assert(false); return spawn(bytes("exit 0",6)); }
fn spawn(script: core::slice::View<u8>) -> std::command::Child { let args: [core::slice::View<u8>;3] = [bytes("/bin/sh",7),bytes("-c",2),script]; let request = std::command::request(args[0],core::slice::view(args,3).unwrap(),core::slice::view(args,0).unwrap()); request.stdin = std::command::Stdio::Pipe; request.stdout = std::command::Stdio::Pipe; request.stderr = std::command::Stdio::Pipe; return taken(std::command::spawn(request).unwrap()); }
fn deadline(ms: u64) -> core::time::Deadline { let now: core::time::Instant = std::clock::monotonic_now().unwrap(); return core::time::deadline_after(now,core::time::from_millis(ms)).unwrap(); }
fn intact(child: &std::command::Child) { assert(core::option::is_some(child.input) && core::option::is_some(child.output) && core::option::is_some(child.error)); }
fn empty(child: &std::command::Child) { assert(core::option::is_none(child.input) && core::option::is_none(child.output) && core::option::is_none(child.error)); }
fn reason(value: std::command_capture::Error) -> i32 { return match(value) { std::command_capture::Error::Bounds -> 1, std::command_capture::Error::InputLimit -> 2, std::command_capture::Error::OutputLimit -> 3, std::command_capture::Error::ErrorLimit -> 4, std::command_capture::Error::WorkLimit -> 5, std::command_capture::Error::Deadline -> 6, std::command_capture::Error::InputUnavailable -> 7, std::command_capture::Error::SigpipeNotIgnored -> 8, _ -> 99 }; }
fn forged(raw: [u8]) -> core::slice::View<u8> { return core::slice::View { values: raw, start: -1, length: 1 }; }
fn main() -> i32 {
    let raw: [u8;1] = [88]; let input = core::slice::view(raw,1).unwrap(); let none = core::slice::view(raw,0).unwrap(); let limits = std::command_capture::default_limits(); limits.max_stdout_bytes = 16; limits.max_stderr_bytes = 16;
    std::signal::set_disposition(std::signal::Signal::BrokenPipe,std::signal::Disposition::Default).unwrap(); let child = spawn(bytes("cat",3));
    let result = std::command_capture::communicate(child.borrow(),input,limits,deadline(3000)); assert(result.is_err()); let failure = result.unwrap_err(); assert(reason(failure.cause) == 8 && !failure.progress.acquired); intact(child.borrow()); failure.destroy();
    std::signal::set_disposition(std::signal::Signal::BrokenPipe,std::signal::Disposition::Ignore).unwrap(); result = std::command_capture::communicate(child.borrow(),input,limits,deadline(3000)); assert(result.is_ok()); let output = result.unwrap(); assert(output.stdout.len() == 1 && output.stdout.at(0) == 88 && output.progress.input_written == 1); output.destroy(); empty(child.borrow()); assert(core::option::is_none(child.id()));
    child = spawn(bytes("cat",3)); result = std::command_capture::communicate(child.borrow(),forged(raw),limits,deadline(3000)); assert(result.is_err()); failure = result.unwrap_err(); assert(reason(failure.cause) == 1 && !failure.progress.acquired); failure.destroy(); intact(child.borrow());
    limits.max_input_bytes = 0; result = std::command_capture::communicate(child.borrow(),input,limits,deadline(3000)); failure = result.unwrap_err(); assert(reason(failure.cause) == 2 && !failure.progress.acquired); failure.destroy(); intact(child.borrow()); limits = std::command_capture::default_limits();
    let expired: core::time::Deadline = core::time::deadline_at(core::time::instant(core::time::zero())); result = std::command_capture::communicate(child.borrow(),input,limits,expired); failure = result.unwrap_err(); assert(reason(failure.cause) == 6 && !failure.progress.acquired); failure.destroy(); intact(child.borrow());
    limits.max_operations = 0; result = std::command_capture::communicate(child.borrow(),input,limits,deadline(3000)); failure = result.unwrap_err(); assert(reason(failure.cause) == 5 && !failure.progress.acquired && failure.progress.operations == 0); failure.destroy(); intact(child.borrow()); limits = std::command_capture::default_limits();
    let taken_input = core::option::unwrap(child.take_stdin()); taken_input.close().unwrap(); result = std::command_capture::communicate(child.borrow(),input,limits,deadline(3000)); failure = result.unwrap_err(); assert(reason(failure.cause) == 7 && !failure.progress.acquired && core::option::is_some(child.output)); failure.destroy(); child.cancel_and_wait().unwrap();
    child = spawn(bytes("printf X",8)); limits.max_stdout_bytes = 0; result = std::command_capture::communicate(child.borrow(),none,limits,deadline(3000)); failure = result.unwrap_err(); assert(reason(failure.cause) == 3 && failure.stdout.len() == 0 && failure.progress.stdout_read == 1 && core::option::unwrap(failure.overflow).byte == 88 && failure.progress.acquired); empty(child.borrow()); failure.destroy(); child.cancel_and_wait().unwrap();
    child = spawn(bytes("printf Z >&2",12)); limits.max_stdout_bytes = 16; limits.max_stderr_bytes = 0; result = std::command_capture::communicate(child.borrow(),none,limits,deadline(3000)); failure = result.unwrap_err(); assert(reason(failure.cause) == 4 && failure.stderr.len() == 0 && failure.progress.stderr_read == 1 && core::option::unwrap(failure.overflow).byte == 90); failure.destroy(); child.cancel_and_wait().unwrap();
    child = spawn(bytes("printf DATA",11)); limits.max_stdout_bytes = 4; limits.max_stderr_bytes = 0; result = std::command_capture::communicate(child.borrow(),none,limits,deadline(3000)); output = result.unwrap(); assert(output.stdout.len() == 4 && output.stderr.len() == 0 && output.progress.stdout_read == 4 && core::option::unwrap(output.status.code) == 0); output.destroy();
    child = spawn(bytes("exec 0<&-; printf done",22)); let fd: i32 = core::option::unwrap(core::option::unwrap(child.input).raw_handle()); assert(std::command_raw::word(72,fd as i64,1031,4096) == 4096); let many = alloc::vec::with_capacity<u8>(8192).unwrap(); let i: i32 = 0; while (i < 8192) { many.try_push((i%251) as u8).unwrap(); i += 1; } limits = std::command_capture::default_limits(); limits.max_stdout_bytes = 4; limits.max_stderr_bytes = 0;
    result = std::command_capture::communicate(child.borrow(),many.as_view(),limits,deadline(3000)); output = result.unwrap(); let peer_closed: bool = match(output.progress.input_state) { std::command_capture::InputState::PeerClosed -> true, _ -> false }; assert(peer_closed && output.progress.input_written < 8192 && output.stdout.len() == 4); output.destroy(); many.destroy();
    child = spawn(bytes("exec 1>&- 2>&-; sleep .05; exit 7",33)); result = std::command_capture::communicate(child.borrow(),none,limits,deadline(3000)); output = result.unwrap(); assert(output.stdout.len() == 0 && output.stderr.len() == 0 && core::option::unwrap(output.status.code) == 7); output.destroy();
    child = spawn(bytes("sleep .2 & exit 9",17)); assert(core::option::unwrap(child.wait().unwrap().code) == 9); result = std::command_capture::communicate(child.borrow(),none,limits,deadline(50)); failure = result.unwrap_err(); assert(reason(failure.cause) == 6 && core::option::is_some(failure.progress.status) && core::option::unwrap(core::option::unwrap(failure.progress.status).code) == 9 && core::option::is_none(child.id())); empty(child.borrow()); failure.destroy();
    child = spawn(bytes("cat",3)); limits = std::command_capture::default_limits(); limits.max_stdout_bytes = 16; limits.max_stderr_bytes = 16; limits.max_operations = 30; result = std::command_capture::communicate(child.borrow(),input,limits,deadline(3000)); failure = result.unwrap_err(); assert(reason(failure.cause) == 5 && failure.progress.acquired && failure.progress.operations == 30); empty(child.borrow()); failure.destroy(); child.cancel_and_wait().unwrap();
    let status: [i32;1] = [0;1]; assert(std::command_raw::wait(-1,core::mem::i32_array_data_ptr(status),true) == -10); return 0;
}
