module app::main;
import std::set_wide_u64;
import core::wide_u64;
fn same(left: core::wide_u64::WideU64, right: core::wide_u64::WideU64) -> bool {
    return core::wide_u64::eq(left, right);
}

fn main() -> i32 {
    let large: core::wide_u64::WideU64 = core::wide_u64::from_words(1, 4294967289);
    let small: core::wide_u64::WideU64 = core::wide_u64::from_u32(42);
    let forty_one: core::wide_u64::WideU64 = core::wide_u64::from_u32(41);
    let zero_value: core::wide_u64::WideU64 = core::wide_u64::zero();
    let left: std::set_wide_u64::SetWideU64 = std::set_wide_u64::try_insert(std::set_wide_u64::new(), large);
    let right: std::set_wide_u64::SetWideU64 = std::set_wide_u64::try_insert(std::set_wide_u64::new(), small);
    if (std::set_wide_u64::len(left) != 1 || std::set_wide_u64::len(right) != 1) { return 2; }
    let result: std::set_wide_u64::SetWideU64 = std::set_wide_u64::try_union(left, right);
    let failed: bool = std::set_wide_u64::len(result) == 0 &&
        std::set_wide_u64::capacity(result) == 0 &&
        std::set_wide_u64::contains(left, large) && std::set_wide_u64::contains(right, small);
    let succeeded: bool = std::set_wide_u64::len(result) == 2 &&
        same(std::set_wide_u64::at_or(result, 0, zero_value), large) &&
        same(std::set_wide_u64::at_or(result, 1, zero_value), small);
    std::set_wide_u64::destroy(result);
    std::set_wide_u64::destroy(right);
    std::set_wide_u64::destroy(left);
    if (failed) { return 0; }
    if (succeeded) { return 4; }
    return 5;
}
