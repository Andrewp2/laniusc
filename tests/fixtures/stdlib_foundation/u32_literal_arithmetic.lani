module app::main;

fn main() -> i32 {
    let ten: u32 = 10;
    if (4294967295 % ten != 5) { return 1; }
    if (4294967295 / ten != 429496729) { return 2; }
    let eleven: u32 = ten + 1;
    if (4294967295 % eleven != 3) { return 3; }
    if (4294967295 % (ten + 1) != 3) { return 10; }
    if (2147483648 / ten != 214748364) { return 4; }
    if (2147483648 % ten != 8) { return 5; }
    let high: u32 = 2147483648;
    if (1 + high != 2147483649) { return 6; }
    if ((1 | high) >> 31 != 1) { return 11; }
    let wrapped: u32 = 0 - ten;
    if (wrapped / ten != 429496728) { return 12; }

    let negative: i32 = -5;
    if (13 / negative != -2) { return 7; }
    if (13 % negative != 3) { return 8; }
    let signed: i32 = -13;
    if (signed % 5 != -3) { return 9; }
    if (13 % (negative + 0) != 3) { return 13; }
    return 0;
}
