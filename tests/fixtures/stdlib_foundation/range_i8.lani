module app::main;
import core::range_i8;

fn main() -> i32 {
    if (core::range_i8::half_open_is_empty(-128, 127) ||
        !core::range_i8::half_open_is_empty(-5, -5) ||
        !core::range_i8::half_open_is_empty(5, -5)) {
        return 1;
    }
    if (!core::range_i8::half_open_contains(-128, 127, -128) ||
        !core::range_i8::half_open_contains(-128, 127, 126) ||
        core::range_i8::half_open_contains(-128, 127, 127) ||
        core::range_i8::half_open_contains(-3, 3, -4)) {
        return 2;
    }
    if (!core::range_i8::half_open_overlaps(-10, 0, -1, 10) ||
        core::range_i8::half_open_overlaps(-10, 0, 0, 10) ||
        core::range_i8::half_open_overlaps(-10, 0, -5, -5) ||
        core::range_i8::half_open_overlaps(5, -5, -3, 3)) {
        return 3;
    }
    if (core::range_i8::inclusive_is_empty(-128, 127) ||
        core::range_i8::inclusive_is_empty(127, 127) ||
        !core::range_i8::inclusive_is_empty(127, -128)) {
        return 4;
    }
    if (!core::range_i8::inclusive_contains(-128, 127, 127) ||
        !core::range_i8::inclusive_contains(-128, -128, -128) ||
        core::range_i8::inclusive_contains(-3, 3, -4) ||
        core::range_i8::inclusive_contains(3, -3, 0)) {
        return 5;
    }
    if (!core::range_i8::inclusive_overlaps(-10, 0, 0, 10) ||
        core::range_i8::inclusive_overlaps(-10, -1, 0, 10) ||
        core::range_i8::inclusive_overlaps(10, -10, -5, 5)) {
        return 6;
    }
    if (!core::range_i8::from_contains(-10, -10) ||
        !core::range_i8::from_contains(-10, 127) ||
        core::range_i8::from_contains(-10, -11)) {
        return 7;
    }
    if (!core::range_i8::to_contains(0, -128) ||
        core::range_i8::to_contains(0, 0) ||
        core::range_i8::to_contains(-128, -128)) {
        return 8;
    }
    if (!core::range_i8::full_contains(-128) || !core::range_i8::full_contains(127)) {
        return 9;
    }
    return 0;
}
