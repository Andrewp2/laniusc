module app::main;
import core::result_u32;
import core::option_u32;

fn main() -> i32 {
    let success: core::result_u32::ResultU32 = core::result_u32::ok(7);
    let failure: core::result_u32::ResultU32 = core::result_u32::err(3);
    if (!success.or(failure).contains(7)) { return 1; }
    if (!success.or(failure).or(failure).contains(7)) { return 2; }
    let present: core::option_u32::OptionU32 = core::option_u32::some(7);
    if (!present.ok_or(3).contains(7)) { return 3; }
    return 0;
}
