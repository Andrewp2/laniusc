module app::main;
import core::result;
import core::option;

fn main() -> i32 {
    let success: core::result::Result<u32, u32> = core::result::Ok(7);
    let failure: core::result::Result<u32, u32> = core::result::Err(3);
    if (!success.or(failure).contains(7)) { return 1; }
    if (!success.or(failure).or(failure).contains(7)) { return 2; }
    let present: core::option::Option<u32> = core::option::Some(7);
    if (!present.ok_or(3).contains(7)) { return 3; }
    return 0;
}
