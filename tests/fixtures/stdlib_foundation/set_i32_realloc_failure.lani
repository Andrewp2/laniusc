module app::main;
import std::set_i32;

fn main() -> i32 {
    let value: std::set_i32::SetI32 = std::set_i32::try_reserve(std::set_i32::new(), 1);
    if (std::set_i32::capacity(value) != 1) { return 2; }
    value = std::set_i32::try_insert(value, -7);
    if (std::set_i32::len(value) != 1) { return 3; }
    value = std::set_i32::try_insert(value, 42);
    if (std::set_i32::len(value) == 1 &&
        std::set_i32::capacity(value) == 1 &&
        std::set_i32::at_or(value, 0, 0) == -7 &&
        !std::set_i32::contains(value, 42)) {
        std::set_i32::destroy(value);
        return 0;
    }
    if (std::set_i32::len(value) == 2 &&
        std::set_i32::capacity(value) == 2 &&
        std::set_i32::at_or(value, 0, 0) == -7 &&
        std::set_i32::at_or(value, 1, 0) == 42) {
        std::set_i32::destroy(value);
        return 4;
    }
    std::set_i32::destroy(value);
    return 5;
}
