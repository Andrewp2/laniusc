    }
    let sliced:[i64] = core::option::unwrap(core::vec::get(slices.borrow(), 0));
    if (sliced[0] != 4294967297 || sliced[1] != -4294967297 || core::mem::slice_stride(sliced) != core::mem::slice_stride(slice)) {
        return 18;
    }
