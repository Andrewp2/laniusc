struct Z {
}
pub impl core::cmp::Ord<P>for P {
    pub fn lt(left: P, right: P) -> bool {
        return left.x<right.x;
    }
    pub fn le(left: P, right: P) -> bool {
        return left.x <= right.x;
    }
    pub fn gt(left: P, right: P) -> bool {
        return left.x>right.x;
    }
    pub fn ge(left: P, right: P) -> bool {
        return left.x >= right.x;
    }
}
struct Borrowed {
    values:[i64],
    tag: i32
}
struct Owned {
    key: i32,
    owner: alloc::vec::Vec<i32>
}
pub impl core::cmp::Eq<Owned>for Owned {
    pub fn eq(left: Owned, right: Owned) -> bool {
        return left.key == right.key;
    }
    pub fn ne(left: Owned, right: Owned) -> bool {
        return left.key != right.key;
    }
}
fn main() -> i32 {
