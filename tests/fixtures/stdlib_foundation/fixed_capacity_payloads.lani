    let f: core::vec::Vec<f64,
    2> = core::vec::from_storage([0.0, 0.0]);
    core::result::unwrap(core::vec::try_push(f.borrow(), 1.25));
    if (core::option::unwrap(core::vec::pop(e.borrow())) != -3.5 || core::option::unwrap(core::vec::pop(f.borrow())) != 1.25) {
