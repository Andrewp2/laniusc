fn count<T, const N: usize>(values: [T; N]) -> usize {
    return N;
}

fn forward<T, const M: usize>(values: [T; M]) -> usize {
    return count(values) + M;
}

fn main() -> i32 {
    let empty: [bool; 0] = [];
    let numbers: [i32; 3] = [11, 22, 33];
    if (count(empty) != 0 || count(numbers) != 3) { return 1; }
    if (forward(empty) != 0 || forward(numbers) != 6) { return 2; }
    return 0;
}
