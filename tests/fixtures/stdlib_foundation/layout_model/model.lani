// Test-only checked-layout arithmetic runner. Eight input words select an
// operation, four full-width operands, direct/mutated construction and identity.
// No backing storage or pointer is constructed from the modeled layout sizes.
module app::main;

import core::layout;
import core::mem;
import core::result;
import std::io;

fn read_exact(pointer: ptr, count: i32, allow_eof: bool) -> bool {
    let done: i32 = 0;
    while (done < count) {
        let got: i32 = std::io::read_stdin(pointer + (done as usize), (count - done) as usize);
        assert(got >= 0);
        if (got == 0) { assert(allow_eof && done == 0); return false; }
        done += got;
    }
    return true;
}

fn write_all(pointer: ptr, count: i32) {
    let done: i32 = 0;
    while (done < count) {
        let got: i32 = std::io::write_stdout(pointer + (done as usize), (count - done) as usize);
        assert(got > 0); done += got;
    }
}

fn get64(bytes: [u8], offset: i32) -> u64 {
    let value: u64 = 0; let index: i32 = 0;
    while (index < 8) { value |= (bytes[offset + index] as u64) << (index * 8); index += 1; }
    return value;
}

struct Output { bytes: [u8], pointer: ptr, used: i32 }
impl Output {
    fn borrow(&self) -> &Output { return self; }
    fn flush(&self) { write_all(self.pointer, self.used); self.used = 0; }
    fn word(&self, value: u64) {
        if (self.used == 4096) { self.flush(); }
        let index: i32 = 0;
        while (index < 8) {
            self.bytes[self.used + index] = ((value >> (index * 8)) & 255) as u8;
            index += 1;
        }
        self.used += 8;
    }
}

struct Answer { tag: u64, error: u64, size: u64, alignment: u64, extra: u64 }

fn error_code(error: core::layout::Error) -> u64 {
    return match (error) {
        core::layout::Error::InvalidAlignment -> 1,
        core::layout::Error::SizeOverflow -> 2,
    };
}

fn layout_answer(result: core::result::Result<core::layout::Layout, core::layout::Error>) -> Answer {
    if (result.is_err()) {
        let cause: core::layout::Error = result.unwrap_err();
        return Answer { tag: 1, error: error_code(cause), size: 0, alignment: 0, extra: 0 };
    }
    let value: core::layout::Layout = result.unwrap();
    return Answer { tag: 0, error: 0, size: value.size as u64, alignment: value.alignment as u64, extra: 0 };
}

fn run(bytes: [u8], output: &Output) {
    let operation: u64 = get64(bytes, 0);
    let a: usize = get64(bytes, 8) as usize;
    let b: usize = get64(bytes, 16) as usize;
    let c: usize = get64(bytes, 24) as usize;
    let d: usize = get64(bytes, 32) as usize;
    let mutation: u64 = get64(bytes, 40);
    assert(operation <= 7 && mutation <= 1);
    assert((a as u64) == get64(bytes, 8) && (b as u64) == get64(bytes, 16));
    assert((c as u64) == get64(bytes, 24) && (d as u64) == get64(bytes, 32));
    let left: core::layout::Layout = core::layout::Layout { size: 0, alignment: 1 };
    let right: core::layout::Layout = core::layout::Layout { size: 0, alignment: 1 };
    if (mutation == 0) {
        left = core::layout::Layout { size: a, alignment: b };
        right = core::layout::Layout { size: c, alignment: d };
    } else {
        left.size = a; left.alignment = b;
        right.size = c; right.alignment = d;
    }
    let answer: Answer = Answer { tag: 0, error: 0, size: 0, alignment: 0, extra: 0 };
    if (operation == 0) { answer = layout_answer(core::layout::from_size_align(a, b)); }
    if (operation == 1) { answer = layout_answer(core::layout::validate(left)); }
    if (operation == 2) {
        answer.tag = 2;
        answer.extra = core::layout::is_valid(left) as u64;
    }
    if (operation == 3) {
        let result: core::result::Result<usize, core::layout::Error> = core::layout::padding_for(a, b);
        if (result.is_err()) {
            let cause: core::layout::Error = result.unwrap_err();
            answer.tag = 1; answer.error = error_code(cause);
        } else { answer.extra = result.unwrap() as u64; }
    }
    if (operation == 4) { answer = layout_answer(core::layout::pad_to_align(left)); }
    if (operation == 5) { answer = layout_answer(core::layout::align_to(left, c)); }
    if (operation == 6) {
        let result: core::result::Result<core::layout::ArrayLayout, core::layout::Error> = core::layout::array(left, c);
        if (result.is_err()) {
            let cause: core::layout::Error = result.unwrap_err();
            answer.tag = 1; answer.error = error_code(cause);
        } else {
            let value: core::layout::ArrayLayout = result.unwrap();
            answer.size = value.layout.size as u64;
            answer.alignment = value.layout.alignment as u64;
            answer.extra = value.stride as u64;
        }
    }
    if (operation == 7) {
        let result: core::result::Result<core::layout::ExtendedLayout, core::layout::Error> = core::layout::extend(left, right);
        if (result.is_err()) {
            let cause: core::layout::Error = result.unwrap_err();
            answer.tag = 1; answer.error = error_code(cause);
        } else {
            let value: core::layout::ExtendedLayout = result.unwrap();
            answer.size = value.layout.size as u64;
            answer.alignment = value.layout.alignment as u64;
            answer.extra = value.offset as u64;
        }
    }
    output.word(operation); output.word(answer.tag); output.word(answer.error);
    output.word(answer.size); output.word(answer.alignment); output.word(answer.extra);
    output.word(left.size as u64); output.word(left.alignment as u64);
    output.word(right.size as u64); output.word(right.alignment as u64);
}

fn main() -> i32 {
    assert((core::layout::MAX_SIZE as u64) == 9223372036854775807);
    let input_words: [i32; 16] = [0; 16]; let input_pointer: ptr = core::mem::i32_array_data_ptr(input_words);
    let input: [u8] = core::mem::typed_slice_from_raw_parts<u8>(input_pointer, 64);
    let output_words: [i32; 1024] = [0; 1024]; let output_pointer: ptr = core::mem::i32_array_data_ptr(output_words);
    let output_bytes: [u8] = core::mem::typed_slice_from_raw_parts<u8>(output_pointer, 4096);
    let output: Output = Output { bytes: output_bytes, pointer: output_pointer, used: 0 };
    while (read_exact(input_pointer, 64, true)) { run(input, output.borrow()); }
    output.flush(); return 0;
}
