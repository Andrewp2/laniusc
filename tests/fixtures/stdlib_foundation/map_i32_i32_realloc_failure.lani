module app::main;
import std::map_i32_i32;

fn main() -> i32 {
    let value: std::map_i32_i32::MapI32I32 = std::map_i32_i32::new();
    value = std::map_i32_i32::try_reserve(value, 1);
    if (std::map_i32_i32::capacity(value) != 1) { return 2; }
    value = std::map_i32_i32::try_insert(value, 0, 41);
    if (std::map_i32_i32::len(value) != 1) { return 3; }
    value = std::map_i32_i32::try_insert(value, -7, 42);
    if (std::map_i32_i32::len(value) == 1 &&
        std::map_i32_i32::capacity(value) == 1 &&
        std::map_i32_i32::get_or(value, 0, -1) == 41 &&
        !std::map_i32_i32::contains_key(value, -7)) {
        std::map_i32_i32::destroy(value);
        return 0;
    }
    if (std::map_i32_i32::len(value) == 2 &&
        std::map_i32_i32::capacity(value) == 2 &&
        std::map_i32_i32::get_or(value, 0, -1) == 41 &&
        std::map_i32_i32::get_or(value, -7, -1) == 42) {
        std::map_i32_i32::destroy(value);
        return 4;
    }
    std::map_i32_i32::destroy(value);
    return 5;
}
