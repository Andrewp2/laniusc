module app::main;
import std::vec_i32;

fn main() -> i32 {
    let first: i32 = 41;
    let second: i32 = 42;
    let inserted: i32 = 99;
    let fallback: i32 = -1;
    let value: std::vec_i32::VecI32 = std::vec_i32::try_with_capacity(2);
    if (std::vec_i32::capacity(value) != 2) { return 2; }
    value = std::vec_i32::try_push(value, first);
    value = std::vec_i32::try_push(value, second);
    if (std::vec_i32::len(value) != 2) { return 3; }
    value = std::vec_i32::try_insert(value, 1, inserted);
    if (std::vec_i32::len(value) == 3) {
        if (std::vec_i32::get_or(value, 0, fallback) != first ||
            std::vec_i32::get_or(value, 1, fallback) != inserted ||
            std::vec_i32::get_or(value, 2, fallback) != second) { return 6; }
        std::vec_i32::destroy(value);
        return 4;
    }
    if (std::vec_i32::len(value) != 2 ||
        std::vec_i32::capacity(value) != 2 ||
        std::vec_i32::get_or(value, 0, fallback) != first ||
        std::vec_i32::get_or(value, 1, fallback) != second) { return 5; }
    std::vec_i32::destroy(value);
    return 0;
}
