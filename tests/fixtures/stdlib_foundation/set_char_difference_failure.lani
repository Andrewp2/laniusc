module app::main;
import std::set_char;

fn main() -> i32 {
    let left: std::set_char::SetChar = std::set_char::try_insert(std::set_char::new(), '􏿹');
    let right: std::set_char::SetChar = std::set_char::try_insert(std::set_char::new(), '*');
    if (std::set_char::len(left) != 1 || std::set_char::len(right) != 1) { return 2; }
    let result: std::set_char::SetChar = std::set_char::try_difference(left, right);
    let failed: bool = std::set_char::len(result) == 0 &&
        std::set_char::capacity(result) == 0 &&
        std::set_char::contains(left, '􏿹') && std::set_char::contains(right, '*');
    let succeeded: bool = std::set_char::len(result) == 1 &&
        std::set_char::at_or(result, 0, '\0') == '􏿹';
    std::set_char::destroy(result);
    std::set_char::destroy(right);
    std::set_char::destroy(left);
    if (failed) { return 0; }
    if (succeeded) { return 4; }
    return 5;
}
