module app::main;
import std::deque_bool;

fn main() -> i32 {
    let value: std::deque_bool::DequeBool = std::deque_bool::try_with_capacity(4);
    if (std::deque_bool::capacity(value) != 4) { return 5; }
    value = std::deque_bool::try_push_back(value, true);
    value = std::deque_bool::try_push_back(value, false);
    value = std::deque_bool::try_push_back(value, true);
    value = std::deque_bool::try_pop_front(value);
    value = std::deque_bool::try_shrink_to_fit(value);
    let intact: bool = std::deque_bool::len(value) == 2 &&
        std::deque_bool::at_or(value, 0, false) == false &&
        std::deque_bool::at_or(value, 1, false) == true;
    let failure: bool = intact && std::deque_bool::capacity(value) == 4;
    let success: bool = intact && std::deque_bool::capacity(value) == 2;
    std::deque_bool::destroy(value);
    if (failure) { return 0; }
    if (success) { return 4; }
    return 5;
}
