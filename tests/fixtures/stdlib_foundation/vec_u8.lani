module app::main;
import std::vec_u8;
import core::utf8;
import core::mem;

fn main() -> i32 {
    let zero: u8 = 0;
    let one: u8 = 1;
    let high_bit: u8 = 128;
    let maximum: u8 = 255;
    let fallback: u8 = 77;
    let value: std::vec_u8::VecU8 = std::vec_u8::new();
    if (std::vec_u8::len(value) != 0 ||
        std::vec_u8::capacity(value) != 0 ||
        !std::vec_u8::is_empty(value) ||
        std::vec_u8::get_or(value, 0, fallback) != fallback ||
        std::vec_u8::try_set(value, 0, maximum)) { return 1; }
    let empty_cells: [i32] = core::mem::i32_slice_from_raw_parts(std::vec_u8::data_ptr(value), std::vec_u8::len(value));
    if (!core::utf8::codes_are_valid(empty_cells, 0)) { return 15; }
    let empty_copy: std::vec_u8::VecU8 = std::vec_u8::try_clone(value);
    if (std::vec_u8::len(empty_copy) != 0 ||
        std::vec_u8::capacity(empty_copy) != 0) { return 17; }
    std::vec_u8::destroy(empty_copy);
    value = std::vec_u8::try_pop(value);
    if (std::vec_u8::len(value) != 0) { return 2; }

    value = std::vec_u8::try_push(value, zero);
    value = std::vec_u8::try_push(value, high_bit);
    value = std::vec_u8::try_push(value, maximum);
    value = std::vec_u8::try_push(value, one);
    if (std::vec_u8::len(value) != 4 ||
        std::vec_u8::capacity(value) != 4 ||
        std::vec_u8::get_or(value, 0, fallback) != zero ||
        std::vec_u8::get_or(value, 1, fallback) != high_bit ||
        std::vec_u8::get_or(value, 2, fallback) != maximum ||
        std::vec_u8::get_or(value, -1, fallback) != fallback ||
        std::vec_u8::get_or(value, 4, fallback) != fallback) { return 3; }
    let cells: [i32] = core::mem::i32_slice_from_raw_parts(std::vec_u8::data_ptr(value), std::vec_u8::len(value));
    if (cells[0] != 0 || cells[1] != 128 || cells[2] != 255 || cells[3] != 1) {
        return 16;
    }
    value = std::vec_u8::try_push(value, high_bit);
    if (std::vec_u8::len(value) != 5 ||
        std::vec_u8::capacity(value) != 8 ||
        std::vec_u8::get_or(value, 4, fallback) != high_bit) { return 4; }
    let copy: std::vec_u8::VecU8 = std::vec_u8::try_clone(value);
    if (std::vec_u8::len(copy) != 5 ||
        std::vec_u8::capacity(copy) != 5 ||
        std::vec_u8::get_or(copy, 1, fallback) != high_bit ||
        std::vec_u8::get_or(copy, 2, fallback) != maximum ||
        !std::vec_u8::try_set(copy, 1, one) ||
        std::vec_u8::get_or(copy, 1, fallback) != one ||
        std::vec_u8::get_or(value, 1, fallback) != high_bit) { return 18; }
    std::vec_u8::destroy(copy);
    if (std::vec_u8::try_set(value, -1, maximum) ||
        std::vec_u8::try_set(value, 5, maximum) ||
        !std::vec_u8::try_set(value, 1, maximum) ||
        std::vec_u8::get_or(value, 1, fallback) != maximum) { return 5; }

    value = std::vec_u8::try_reserve(value, -1);
    value = std::vec_u8::try_reserve(value, 536870912);
    value = std::vec_u8::try_reserve(value, 2);
    if (std::vec_u8::capacity(value) != 8) { return 6; }
    value = std::vec_u8::try_reserve(value, 11);
    if (std::vec_u8::capacity(value) != 11 ||
        std::vec_u8::get_or(value, 1, fallback) != maximum ||
        std::vec_u8::get_or(value, 4, fallback) != high_bit) { return 7; }
    value = std::vec_u8::try_pop(value);
    if (std::vec_u8::len(value) != 4 ||
        std::vec_u8::get_or(value, 4, fallback) != fallback) { return 8; }
    value = std::vec_u8::clear(value);
    if (std::vec_u8::len(value) != 0 ||
        std::vec_u8::capacity(value) != 11 ||
        !std::vec_u8::is_empty(value)) { return 9; }
    value = std::vec_u8::try_push(value, maximum);
    if (std::vec_u8::get_or(value, 0, fallback) != maximum) { return 10; }
    std::vec_u8::destroy(value);

    let preallocated: std::vec_u8::VecU8 = std::vec_u8::try_with_capacity(2);
    if (std::vec_u8::capacity(preallocated) != 2) { return 11; }
    preallocated = std::vec_u8::try_push(preallocated, high_bit);
    if (std::vec_u8::get_or(preallocated, 0, fallback) != high_bit) { return 12; }
    std::vec_u8::destroy(preallocated);
    let invalid: std::vec_u8::VecU8 = std::vec_u8::try_with_capacity(-1);
    if (std::vec_u8::capacity(invalid) != 0) { return 13; }
    std::vec_u8::destroy(invalid);
    if (std::vec_u8::MAX_CAPACITY != 536870911) { return 14; }
    let invalid_bytes: std::vec_u8::VecU8 = std::vec_u8::new();
    invalid_bytes = std::vec_u8::try_push(invalid_bytes, one);
    let raw_cells: [i32] = core::mem::i32_slice_from_raw_parts(
        std::vec_u8::data_ptr(invalid_bytes), std::vec_u8::len(invalid_bytes));
    raw_cells[0] = 256;
    let rejected_copy: std::vec_u8::VecU8 = std::vec_u8::try_clone(invalid_bytes);
    if (std::vec_u8::len(rejected_copy) != 0 ||
        std::vec_u8::capacity(rejected_copy) != 0 ||
        raw_cells[0] != 256) { return 19; }
    std::vec_u8::destroy(rejected_copy);
    std::vec_u8::destroy(invalid_bytes);
    return 0;
}
