module app::main;
import core::array_i32;

fn main() -> i32 {
    let one: [i32; 1] = [-2147483648];
    let four: [i32; 4] = [7, -2, 9, 4];
    let seven: [i32; 7] = [0, 1, 2, 3, 4, 5, 2147483647];
    if (core::array_i32::first(one) != -2147483648 ||
        core::array_i32::get_unchecked(one, 0) != -2147483648 ||
        core::array_i32::first(four) != 7 ||
        core::array_i32::get_unchecked(four, 1) != -2 ||
        core::array_i32::get_unchecked(four, 3) != 4 ||
        core::array_i32::first(seven) != 0 ||
        core::array_i32::get_unchecked(seven, 6) != 2147483647) { return 1; }
    return 0;
}
