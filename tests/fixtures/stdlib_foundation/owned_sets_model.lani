// Opcode + LE i32 key + LE i32 stamp. Compare both implementations after edits.
module app::main;
import alloc::hash_set;
import alloc::tree_set;
import alloc::hash_map;
import alloc::tree_map;
import core::cmp;
import core::hash;
import core::mem;
import core::option;
import core::result;
import std::fs;
import std::io;
import std::io_decimal;
struct Key { id: i32, stamp: i32 }
pub impl core::hash::Hash<Key> for Key { pub fn hash(key: Key) -> u32 { return 7; } }
pub impl core::cmp::Eq<Key> for Key {
    pub fn eq(a: Key, b: Key) -> bool { return a.id == b.id; }
    pub fn ne(a: Key, b: Key) -> bool { return a.id != b.id; }
}
pub impl core::cmp::Ord<Key> for Key {
    pub fn lt(a: Key, b: Key) -> bool { return a.id < b.id; }
    pub fn le(a: Key, b: Key) -> bool { return a.id <= b.id; }
    pub fn gt(a: Key, b: Key) -> bool { return a.id > b.id; }
    pub fn ge(a: Key, b: Key) -> bool { return a.id >= b.id; }
}
fn number(value: i32) { assert(std::io_decimal::write_i32(1, value) >= 0); assert(std::io::write_byte(1, 32) == 1); }
fn integer(input: [u8], offset: i32) -> i32 {
    let bits: u32 = (input[offset] as u32) | ((input[offset + 1] as u32) << 8) | ((input[offset + 2] as u32) << 16) | ((input[offset + 3] as u32) << 24); return bits as i32;
}
fn same(a: core::option::Option<Key>, b: core::option::Option<Key>) -> bool {
    if (core::option::is_some(a) != core::option::is_some(b)) { return false; }
    if (core::option::is_none(a)) { return true; }
    let x: Key = core::option::unwrap(a); let y: Key = core::option::unwrap(b); return x.id == y.id && x.stamp == y.stamp;
}
fn hash_error(error: alloc::hash_map::Error) -> i32 { let code: i32 = match (error) { alloc::hash_map::Error::InvalidCapacity -> 3, alloc::hash_map::Error::CapacityOverflow -> 4, _ -> 5 }; return code; }
fn tree_error(error: alloc::tree_map::Error) -> i32 { let code: i32 = match (error) { alloc::tree_map::Error::InvalidCapacity -> 3, alloc::tree_map::Error::CapacityOverflow -> 4, _ -> 5 }; return code; }
fn main() -> i32 {
    let storage: [i32; 16384] = [0; 16384]; let pointer: ptr = core::mem::i32_array_data_ptr(storage);
    let size: i32 = std::fs::read(0, pointer, 65536); if (size < 0 || size % 9 != 0) { return 1; }
    let input: [u8] = core::mem::typed_slice_from_raw_parts(pointer, size);
    let h: alloc::hash_set::HashSet<Key> = alloc::hash_set::new(); let t: alloc::tree_set::TreeSet<Key> = alloc::tree_set::new(); let offset: i32 = 0;
    while (offset < size) {
        let op: u8 = input[offset]; let key: i32 = integer(input, offset + 1); let stamp: i32 = integer(input, offset + 5); offset += 9;
        let item: Key = Key { id: key, stamp: stamp }; let upper: Key = Key { id: stamp, stamp: 0 };
        let tag: i32 = 0; let answer: i32 = 0; let found: core::option::Option<Key> = core::option::None(); let other: core::option::Option<Key> = core::option::None();
        let keys: [i32; 128] = [0; 128]; let stamps: [i32; 128] = [0; 128]; let count: i32 = 0;
        if (op == 0) { found = core::result::unwrap(t.try_insert(item)); other = core::result::unwrap(h.try_insert(item)); assert(same(found, other)); }
        if (op == 1) { found = core::result::unwrap(t.try_replace(item)); other = core::result::unwrap(h.try_replace(item)); assert(same(found, other)); }
        if (op == 2) { found = t.remove(item); other = h.remove(item); assert(same(found, other)); }
        if (op == 3) { found = t.get(item); other = h.get(item); assert(same(found, other)); }
        if (op == 4) { tag = 2; if (t.contains(item)) { answer = 1; } assert(t.contains(item) == h.contains(item)); }
        if (op == 5 || op == 6) {
            if (op == 5) { found = t.pop_first(); } else { found = t.pop_last(); }
            if (core::option::is_some(found)) { other = h.remove(core::option::unwrap(found)); assert(same(found, other)); }
        }
        if (op == 7) { h.clear(); t.clear(); }
        if (op == 8 || op == 9) {
            let hr: core::result::Result<i32, alloc::hash_map::Error> = core::result::Ok(0); let tr: core::result::Result<i32, alloc::tree_map::Error> = core::result::Ok(0);
            if (op == 8) { hr = h.try_reserve(key); tr = t.try_reserve(key); } else { hr = h.try_shrink_to_fit(); tr = t.try_shrink_to_fit(); }
            assert(core::result::is_err(hr) == core::result::is_err(tr));
            if (core::result::is_err(hr)) { tag = hash_error(core::result::unwrap_err(hr)); assert(tag == tree_error(core::result::unwrap_err(tr))); }
            else { assert(h.capacity() >= h.len() && t.capacity() >= t.len()); }
        }
        if (op == 10) {
            let hc: alloc::hash_set::HashSet<Key> = core::result::unwrap(h.try_clone()); let tc: alloc::tree_set::TreeSet<Key> = core::result::unwrap(t.try_clone());
            assert(hc.equals(h.borrow()) && tc.equals(t.borrow())); found = hc.remove(item); other = tc.remove(item); assert(same(found, other));
            core::result::unwrap(hc.try_replace(item)); core::result::unwrap(tc.try_replace(item)); hc.destroy(); tc.destroy();
        }
        if (op == 11) {
            let result: core::result::Result<alloc::tree_set::Cursor<Key>, alloc::tree_map::Error> = t.range(item, upper);
            if (core::result::is_err(result)) { tag = 7; }
            else {
                let cursor: alloc::tree_set::Cursor<Key> = core::result::unwrap(result);
                while (!cursor.is_empty()) { let value: Key = core::option::unwrap(cursor.next()); keys[count] = value.id; stamps[count] = value.stamp; count += 1; }
                assert(core::option::is_none(cursor.next_back()));
                let mixed: alloc::tree_set::Cursor<Key> = core::result::unwrap(t.range(item, upper)); let low: i32 = 0; let high: i32 = count - 1;
                while (low <= high) {
                    let value: Key = core::option::unwrap(mixed.next()); assert(value.id == keys[low] && value.stamp == stamps[low]); low += 1;
                    if (low <= high) { value = core::option::unwrap(mixed.next_back()); assert(value.id == keys[high] && value.stamp == stamps[high]); high -= 1; }
                }
                assert(mixed.is_empty());
            }
        }
        if (op == 12) { found = t.lower_bound(item); }
        if (op == 13) { found = t.upper_bound(item); }
        if (op == 14) { h.destroy(); t.destroy(); assert(h.capacity() == 0 && t.capacity() == 0); }
        if (op >= 15 && op <= 22) {
            let hb: alloc::hash_set::HashSet<Key> = alloc::hash_set::new(); let tb: alloc::tree_set::TreeSet<Key> = alloc::tree_set::new();
            let index: i32 = 0;
            if (op < 19) { while (index < 12) { let value: Key = Key { id: index, stamp: 1000 + index }; core::result::unwrap(hb.try_insert(value)); core::result::unwrap(tb.try_insert(value)); index += 1; } }
            let hc: alloc::hash_set::HashSet<Key> = alloc::hash_set::new(); let tc: alloc::tree_set::TreeSet<Key> = alloc::tree_set::new();
            if (op == 15) { hc = core::result::unwrap(h.try_union(hb.borrow())); tc = core::result::unwrap(t.try_union(tb.borrow())); }
            if (op == 16) { hc = core::result::unwrap(h.try_intersection(hb.borrow())); tc = core::result::unwrap(t.try_intersection(tb.borrow())); }
            if (op == 17) { hc = core::result::unwrap(h.try_difference(hb.borrow())); tc = core::result::unwrap(t.try_difference(tb.borrow())); }
            if (op == 18) { hc = core::result::unwrap(h.try_symmetric_difference(hb.borrow())); tc = core::result::unwrap(t.try_symmetric_difference(tb.borrow())); }
            if (op == 19) { hc = core::result::unwrap(h.try_union(h.borrow())); tc = core::result::unwrap(t.try_union(t.borrow())); }
            if (op == 20) { hc = core::result::unwrap(h.try_intersection(h.borrow())); tc = core::result::unwrap(t.try_intersection(t.borrow())); }
            if (op == 21) { hc = core::result::unwrap(h.try_difference(h.borrow())); tc = core::result::unwrap(t.try_difference(t.borrow())); }
            if (op == 22) { hc = core::result::unwrap(h.try_symmetric_difference(h.borrow())); tc = core::result::unwrap(t.try_symmetric_difference(t.borrow())); }
            assert(hc.len() == tc.len()); let cursor: alloc::tree_set::Cursor<Key> = tc.iter();
            while (!cursor.is_empty()) { let value: Key = core::option::unwrap(cursor.next()); assert(same(hc.get(value), core::option::Some(value))); keys[count] = value.id; stamps[count] = value.stamp; count += 1; }
            hc.destroy(); tc.destroy(); hb.destroy(); tb.destroy();
        }
        if (op == 23) { found = t.first(); } if (op == 24) { found = t.last(); } if (op > 24) { return 2; }
        let returned: i32 = 0; if (core::option::is_some(found)) { let value: Key = core::option::unwrap(found); tag = 1; returned = value.id; answer = value.stamp; }
        number(tag); number(returned); number(answer); number(count); let index: i32 = 0;
        while (index < count) { number(keys[index]); number(stamps[index]); index += 1; }
        number(t.len()); assert(h.len() == t.len() && h.capacity() >= h.len() && t.capacity() >= t.len());
        let ordered: alloc::tree_set::Cursor<Key> = t.iter(); index = 0;
        while (!ordered.is_empty()) { let value: Key = core::option::unwrap(ordered.next()); assert(same(h.get(value), core::option::Some(value))); number(value.id); number(value.stamp); index += 1; }
        assert(index == t.len()); let hashed: alloc::hash_set::Iter<Key> = h.iter(); let seen: [bool; 128] = [false; 128]; index = 0;
        while (true) {
            let value: core::option::Option<Key> = hashed.next(); if (core::option::is_none(value)) { break; }
            let key_value: Key = core::option::unwrap(value); assert(key_value.id >= -2 && key_value.id < 126 && !seen[key_value.id + 2] && same(t.get(key_value), value)); seen[key_value.id + 2] = true; index += 1;
        }
        assert(index == h.len() && core::option::is_none(hashed.next())); assert(std::io::write_byte(1, 10) == 1);
    }
    h.destroy(); t.destroy(); return 0;
}
