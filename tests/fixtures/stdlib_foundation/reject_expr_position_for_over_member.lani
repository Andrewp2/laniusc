// expect: LNC0016
// Expression form and position: a for iterable must be a path or a range (grammar/lanius.bnf for_iterable).
module app::main;
struct H { items: [i32; 3] }
fn main() -> i32 {
    let h: H = H { items: [1, 2, 3] };
    let total: i32 = 0;
    for item in h.items { total = total + item; }
    if (total != 6) { return 1; }
    return 0;
}
