module app::main;
import core::io;
import core::mem;
import core::path;
import core::result;
import std::file;
import std::filesystem;

fn main() -> i32 {
    // Selected nonzero subranges exclude NUL padding; native array bytes have
    // a signed stride, whereas the second path is packed raw storage.
    let name: [u8; 7] = [0,100,105,114,255,10,0];
    let path: core::path::Path = core::result::unwrap(core::path::from_bytes_range(name,1,5));
    assert(core::result::unwrap(std::filesystem::create_dir(path)) == 0);
    let storage: [i32;2] = [0;2];
    let packed: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(storage),8);
    packed[1] = 109; packed[2] = 111; packed[3] = 118; packed[4] = 255;
    let other: core::path::Path = core::result::unwrap(core::path::from_bytes_range(packed,1,4));
    assert(core::result::unwrap(std::filesystem::rename(path,other)) == 0);
    assert(core::result::unwrap(std::filesystem::rename(other,other)) == 0);
    assert(core::result::unwrap(std::filesystem::remove_dir(other)) == 0);
    let file: std::file::File = core::result::unwrap(std::file::open(path,std::file::OpenMode::Create));
    let data: [u8;3] = [0,128,255];
    assert(core::result::unwrap(core::io::write_all(file.borrow(),data,0,3)) == 3);
    // The open file remains usable after its filesystem name is removed.
    assert(core::result::unwrap(std::filesystem::remove_file(path)) == 0);
    assert(core::result::unwrap(file.write(data,1,2)) == 2);
    assert(core::result::unwrap(file.close()) == 0);
    return 0;
}
