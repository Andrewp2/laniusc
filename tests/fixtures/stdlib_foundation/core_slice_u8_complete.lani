module app::main;
import core::slice_u8;

fn main() -> i32 {
    let zero: u8 = 0;
    let one: u8 = 1;
    let two: u8 = 2;
    let three: u8 = 3;
    let four: u8 = 4;
    let five: u8 = 5;
    let nine: u8 = 9;
    let high: u8 = 255;
    let almost: u8 = 250;

    let a: [u8; 5] = [three, one, two, one, high];
    if (core::slice_u8::first(a) != three ||
        core::slice_u8::first_or(a, 0, nine) != nine ||
        core::slice_u8::first_or(a, 5, nine) != three ||
        core::slice_u8::swap(a, 5, -1, 0) ||
        core::slice_u8::swap(a, 5, 0, 5) ||
        a[0] != three || !core::slice_u8::swap(a, 5, 0, 4) ||
        a[0] != high || a[4] != three) { return 1; }

    let rotated: [u8; 5] = [one, two, three, four, five];
    if (core::slice_u8::rotate_left(rotated, 5, -1) ||
        core::slice_u8::rotate_right(rotated, 5, 6) ||
        rotated[0] != one ||
        !core::slice_u8::rotate_left(rotated, 5, 2) ||
        rotated[0] != three || rotated[1] != four || rotated[4] != two ||
        !core::slice_u8::rotate_right(rotated, 5, 2) ||
        rotated[0] != one || rotated[4] != five ||
        !core::slice_u8::rotate_left(rotated, 0, 0)) { return 2; }

    let destination: [u8; 5] = [zero, zero, zero, zero, nine];
    let source: [u8; 3] = [one, high, three];
    if (core::slice_u8::copy_nonoverlapping_prefix(destination, 2, source, 3) ||
        core::slice_u8::copy_nonoverlapping_prefix(destination, -1, source, 0) ||
        destination[0] != zero || destination[4] != nine ||
        !core::slice_u8::copy_nonoverlapping_prefix(destination, 5, source, 3) ||
        destination[0] != one || destination[1] != high ||
        destination[2] != three || destination[4] != nine) { return 3; }

    let compact: [u8; 7] = [one, one, high, high, two, two, one];
    if (core::slice_u8::dedup_adjacent(compact, -1) != 0 ||
        core::slice_u8::dedup_adjacent(compact, 7) != 4 ||
        compact[0] != one || compact[1] != high ||
        compact[2] != two || compact[3] != one ||
        core::slice_u8::retain_not_equal(compact, 4, high) != 3 ||
        compact[0] != one || compact[1] != two || compact[2] != one ||
        !core::slice_u8::remove_at(compact, 3, 1) ||
        compact[0] != one || compact[1] != one ||
        core::slice_u8::remove_at(compact, 2, 2)) { return 4; }

    let insertion: [u8; 5] = [one, three, five, zero, nine];
    if (core::slice_u8::insert(insertion, 3, 3, 1, two) ||
        core::slice_u8::insert(insertion, -1, 5, 0, two) ||
        core::slice_u8::push(insertion, 5, 5, two) ||
        insertion[1] != three ||
        !core::slice_u8::insert(insertion, 3, 5, 1, two) ||
        insertion[0] != one || insertion[1] != two ||
        insertion[2] != three || insertion[3] != five ||
        !core::slice_u8::push(insertion, 4, 5, high) ||
        insertion[4] != high) { return 5; }

    let same: [u8; 3] = [one, two, three];
    let greater: [u8; 3] = [one, high, zero];
    let prefix: [u8; 2] = [one, two];
    if (core::slice_u8::compare_lexicographic(same, 3, same, 3) != 0 ||
        core::slice_u8::compare_lexicographic(same, 3, greater, 3) != -1 ||
        core::slice_u8::compare_lexicographic(greater, 3, same, 3) != 1 ||
        core::slice_u8::compare_lexicographic(prefix, 2, same, 3) != -1 ||
        core::slice_u8::compare_lexicographic(same, -1, same, 3) != -2) { return 6; }

    let sequence: [u8; 6] = [one, two, one, two, three, high];
    let needle: [u8; 2] = [one, two];
    let missing: [u8; 2] = [high, one];
    if (core::slice_u8::index_of_subslice(sequence, 6, needle, 2) != 0 ||
        core::slice_u8::last_index_of_subslice(sequence, 6, needle, 2) != 2 ||
        core::slice_u8::index_of_subslice(sequence, 6, missing, 2) != -1 ||
        core::slice_u8::last_index_of_subslice(sequence, 6, missing, 2) != -1 ||
        core::slice_u8::index_of_subslice(sequence, 6, needle, 0) != 0 ||
        core::slice_u8::last_index_of_subslice(sequence, 6, needle, 0) != 6 ||
        core::slice_u8::index_of_subslice(sequence, -1, needle, 0) != -1 ||
        core::slice_u8::last_index_of_subslice(sequence, 6, needle, -1) != -1) { return 7; }

    if (!core::slice_u8::contains(sequence, 6, high) ||
        core::slice_u8::contains(sequence, 6, nine) ||
        core::slice_u8::count(sequence, 6, one) != 2 ||
        core::slice_u8::count(sequence, -1, one) != 0 ||
        core::slice_u8::min_or(sequence, 6, nine) != one ||
        core::slice_u8::max_or(sequence, 6, nine) != high ||
        core::slice_u8::min_or(sequence, 0, nine) != nine ||
        core::slice_u8::max_or(sequence, -1, nine) != nine ||
        core::slice_u8::is_sorted(sequence, 6) ||
        !core::slice_u8::is_sorted(sequence, 0)) { return 8; }

    let sortable: [u8; 7] = [high, two, one, two, zero, high, three];
    if (core::slice_u8::sort(sortable, -1) != 0 ||
        core::slice_u8::sort(sortable, 7) != 7 ||
        !core::slice_u8::is_sorted(sortable, 7) ||
        sortable[0] != zero || sortable[1] != one ||
        sortable[2] != two || sortable[3] != two ||
        sortable[4] != three || sortable[5] != high ||
        sortable[6] != high) { return 9; }
    if (core::slice_u8::lower_bound(sortable, 7, two) != 2 ||
        core::slice_u8::upper_bound(sortable, 7, two) != 4 ||
        core::slice_u8::lower_bound(sortable, 7, high) != 5 ||
        core::slice_u8::upper_bound(sortable, 7, high) != 7 ||
        core::slice_u8::binary_search_first_or(sortable, 7, two, -9) != 2 ||
        core::slice_u8::binary_search_last_or(sortable, 7, two, -9) != 3 ||
        core::slice_u8::binary_search_first_or(sortable, 7, nine, -9) != -9 ||
        core::slice_u8::binary_search_last_or(sortable, 0, two, -9) != -9) { return 10; }

    let partition: [u8; 5] = [high, one, two, zero, three];
    let boundary: i32 = core::slice_u8::partition_lt(partition, 5, three);
    if (boundary != 3 || partition[0] >= three || partition[1] >= three ||
        partition[2] >= three || partition[3] < three || partition[4] < three ||
        core::slice_u8::partition_lt(partition, -1, three) != 0) { return 11; }
    let small_sum: [u8; 2] = [three, nine];
    let large_sum: [u8; 2] = [almost, nine];
    if (core::slice_u8::sum(small_sum, 2) != 12 ||
        core::slice_u8::sum(large_sum, 2) != high ||
        core::slice_u8::sum(large_sum, -1) != zero) { return 12; }
    return 0;
}
