module app::main;
import core::wide_i64;
import std::vec_wide_i64;
fn main() -> i32 {
    let minimum: core::wide_i64::WideI64 = core::wide_i64::min_value();
    let value: std::vec_wide_i64::VecWideI64 = std::vec_wide_i64::try_with_capacity(1);
    value = std::vec_wide_i64::try_push(value, minimum);
    value = std::vec_wide_i64::try_push(value, core::wide_i64::max_value());
    if (std::vec_wide_i64::len(value) == 1 && std::vec_wide_i64::capacity(value) == 1 && core::wide_i64::eq(std::vec_wide_i64::get_or(value, 0, core::wide_i64::zero()), minimum)) {
        std::vec_wide_i64::destroy(value);
        return 0;
    }
    std::vec_wide_i64::destroy(value);
    return 1;
}
