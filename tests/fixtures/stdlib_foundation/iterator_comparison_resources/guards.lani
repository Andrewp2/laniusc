module app::main;
import alloc::allocator;
import core::cmp;
import core::iter;
import core::mem;
import core::option;
import core::ordering;
import core::pair;
import core::result;
import core::slice;
import std::io;
import std::linux;

struct Cursor<T>{values:core::slice::View<T>,position:i32,pulls:i32,ceiling:i32}
impl<T> Cursor<T>{fn borrow(&self)->&Cursor<T>{return self;}}
pub impl<T> core::iter::Iterator<T> for Cursor<T>{
    pub fn next(&self)->core::option::Option<T>{assert(self.pulls<self.ceiling);self.pulls+=1;if(self.position==self.values.length){return core::option::None();}let value:T=self.values.get(self.position).unwrap();self.position+=1;return core::option::Some(value);}
}
fn cursor<T>(values:core::slice::View<T>,ceiling:i32)->Cursor<T>{return Cursor {values:values,position:0,pulls:0,ceiling:ceiling};}
struct Count{calls:i32}
impl Count{fn borrow(&self)->&Count{return self;}}
struct Strict{count:&Count}
struct Equal{count:&Count}
struct Reverse{count:&Count}
impl Strict{fn borrow(&self)->&Strict{return self;}}
impl Equal{fn borrow(&self)->&Equal{return self;}}
impl Reverse{fn borrow(&self)->&Reverse{return self;}}
pub impl core::iter::Mapper<core::pair::Pair<u8,u8>,bool> for Strict{pub fn apply(&self,pair:core::pair::Pair<u8,u8>)->bool{self.count.calls+=1;return pair.first<pair.second;}}
pub impl core::iter::Mapper<core::pair::Pair<u8,u8>,bool> for Equal{pub fn apply(&self,pair:core::pair::Pair<u8,u8>)->bool{self.count.calls+=1;return pair.first==pair.second;}}
pub impl core::ordering::Comparator<u8,u8> for Reverse{pub fn compare(&self,left:u8,right:u8)->core::ordering::Ordering{self.count.calls+=1;return core::ordering::compare_u8(right,left);}}
struct Unit{}
pub impl core::cmp::PartialEq<Unit> for Unit{pub fn partial_eq(left:Unit,right:Unit)->bool{return true;}pub fn partial_ne(left:Unit,right:Unit)->bool{return false;}}
pub impl core::cmp::Ord<Unit> for Unit{pub fn lt(left:Unit,right:Unit)->bool{return false;}pub fn le(left:Unit,right:Unit)->bool{return true;}pub fn gt(left:Unit,right:Unit)->bool{return false;}pub fn ge(left:Unit,right:Unit)->bool{return true;}}
pub impl core::cmp::PartialOrd<Unit> for Unit{
    pub fn partial_lt(left:Unit,right:Unit)->bool{return false;}pub fn partial_le(left:Unit,right:Unit)->bool{return true;}pub fn partial_gt(left:Unit,right:Unit)->bool{return false;}pub fn partial_ge(left:Unit,right:Unit)->bool{return true;}
    pub fn partial_cmp(left:Unit,right:Unit)->core::cmp::PartialOrdering{return core::cmp::PartialOrdering::Equal;}
}
fn mark(value:i32){let byte:[i32;1]=[value];assert(std::io::write_stderr(core::mem::i32_array_data_ptr(byte),1)==1);}
fn report(phase:i32,result:i32,left:i32,right:i32,calls:i32){let words:[i32;5]=[phase,result,left,right,calls];assert(std::io::write_stdout(core::mem::i32_array_data_ptr(words),20)==20);}
fn order(value:core::ordering::Ordering)->i32{return match(value){core::ordering::Ordering::Less-> -1,core::ordering::Ordering::Equal->0,core::ordering::Ordering::Greater->1};}
fn partial(value:core::cmp::PartialOrdering)->i32{return match(value){core::cmp::PartialOrdering::Less-> -1,core::cmp::PartialOrdering::Equal->0,core::cmp::PartialOrdering::Greater->1,core::cmp::PartialOrdering::Unordered->2};}
fn tail(mapping:ptr,count:i32)->core::slice::View<u8>{let values:[u8]=core::mem::typed_slice_from_raw_parts<u8>(mapping+(4095-(count as usize)),count+1);values[0]=211;return core::slice::View {values:values,start:1,length:count};}
fn main()->i32{
    let mapping:ptr=alloc::allocator::alloc(8192,8);assert(mapping!=0);let protection:[std::linux::Argument;3]=[std::linux::Argument::Address(mapping+4096),std::linux::Argument::Word(4096),std::linux::Argument::Word(0)];
    assert(std::linux::call(10,core::slice::view(protection,3).unwrap()).unwrap()==0);
    let one:core::slice::View<u8> =tail(mapping,1);one.values[1]=1;assert(core::mem::slice_stride(one.values)==1);let native:[u8;3]=[211,2,211];assert(core::mem::slice_stride(native)<0);
    let native_view:core::slice::View<u8> =core::slice::view_range(native,1,1).unwrap();
    let a:Cursor<u8> =cursor(one,1);let b:Cursor<u8> =cursor(native_view,1);mark(80);assert(!core::iter::eq<Cursor<u8>,Cursor<u8>,u8>(a.borrow(),b.borrow()));mark(112);report(1,0,a.pulls,b.pulls,0);
    let a:Cursor<u8> =cursor(native_view,1);let b:Cursor<u8> =cursor(one,1);mark(80);let result:i32=order(core::iter::cmp<Cursor<u8>,Cursor<u8>,u8>(a.borrow(),b.borrow()));assert(result==1);mark(112);report(2,result,a.pulls,b.pulls,0);
    let a:Cursor<u8> =cursor(one,1);let b:Cursor<u8> =cursor(native_view,1);mark(80);let result:i32=partial(core::iter::partial_cmp<Cursor<u8>,Cursor<u8>,u8>(a.borrow(),b.borrow()));assert(result==-1);mark(112);report(3,result,a.pulls,b.pulls,0);
    assert(one.values[0]==211&&one.values[1]==1&&native[0]==211&&native[1]==2&&native[2]==211);
    let two:core::slice::View<u8> =tail(mapping,2);two.values[1]=2;two.values[2]=1;let a:Cursor<u8> =cursor(two,2);mark(80);assert(!core::iter::is_sorted<Cursor<u8>,u8>(a.borrow()));mark(112);report(4,0,a.pulls,0,0);
    two.values[2]=2;let count:Count=Count {calls:0};let strict:Strict=Strict {count:count.borrow()};let a:Cursor<u8> =cursor(two,2);mark(80);assert(!core::iter::is_sorted_by<Cursor<u8>,Strict,u8>(a.borrow(),strict.borrow()));mark(112);report(5,0,a.pulls,0,count.calls);assert(two.values[0]==211&&two.values[1]==2&&two.values[2]==2);
    let nowhere:ptr=0;let absent:[u8]=core::mem::typed_slice_from_raw_parts<u8>(nowhere,0);let empty:core::slice::View<u8> =core::slice::View {values:absent,start:2147483647,length:0};
    let one:core::slice::View<u8> =tail(mapping,1);one.values[1]=1;count.calls=0;let reverse:Reverse=Reverse {count:count.borrow()};let a:Cursor<u8> =cursor(empty,1);let b:Cursor<u8> =cursor(one,1);mark(80);let result:i32=order(core::iter::cmp_by<Cursor<u8>,Cursor<u8>,Reverse,u8,u8>(a.borrow(),b.borrow(),reverse.borrow()));assert(result==-1&&count.calls==0);mark(112);report(6,result,a.pulls,b.pulls,count.calls);
    let raw:[Unit]=core::mem::typed_slice_from_raw_parts<Unit>(nowhere,4);let units:[Unit;4]=[Unit {};4];assert(core::mem::size_of<Unit>()==0&&core::mem::slice_stride(raw)==0&&core::mem::slice_stride(units)==0);
    let left:core::slice::View<Unit> =core::slice::view_range(raw,1,3).unwrap();let right:core::slice::View<Unit> =core::slice::view_range(units,1,3).unwrap();
    let a:Cursor<Unit> =cursor(left,4);let b:Cursor<Unit> =cursor(right,4);mark(80);assert(core::iter::eq<Cursor<Unit>,Cursor<Unit>,Unit>(a.borrow(),b.borrow()));mark(112);report(7,1,a.pulls,b.pulls,0);
    let a:Cursor<Unit> =cursor(left.subview(0,2).unwrap(),3);let b:Cursor<Unit> =cursor(right,3);mark(80);let result:i32=order(core::iter::cmp<Cursor<Unit>,Cursor<Unit>,Unit>(a.borrow(),b.borrow()));assert(result==-1);mark(112);report(8,result,a.pulls,b.pulls,0);
    let a:Cursor<Unit> =cursor(left,4);mark(80);assert(core::iter::is_sorted<Cursor<Unit>,Unit>(a.borrow()));mark(112);report(9,1,a.pulls,0,0);
    count.calls=0;let equal:Equal=Equal {count:count.borrow()};let a:Cursor<u8> =cursor(one,1);let b:Cursor<u8> =cursor(native_view,1);mark(80);assert(!core::iter::eq_by<Cursor<u8>,Cursor<u8>,Equal,u8,u8>(a.borrow(),b.borrow(),equal.borrow()));mark(112);report(10,0,a.pulls,b.pulls,count.calls);
    assert(one.values[0]==211&&one.values[1]==1&&native[0]==211&&native[1]==2&&native[2]==211);alloc::allocator::dealloc(mapping,8192,8);mark(68);return 0;
}
