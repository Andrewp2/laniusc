module app::main;
import std::deque_char;

fn main() -> i32 {
    let value: std::deque_char::DequeChar = std::deque_char::try_with_capacity(3);
    let failure: bool = std::deque_char::capacity(value) == 0 && std::deque_char::len(value) == 0;
    let success: bool = std::deque_char::capacity(value) == 3 && std::deque_char::len(value) == 0;
    std::deque_char::destroy(value);
    if (failure) { return 0; }
    if (success) { return 4; }
    return 5;
}
