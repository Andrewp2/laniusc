// Runtime ordering over an owned unsigned halfword vector.
module app::main;
import std::vec_u16;

fn main() -> i32 {
    let zero: u16 = 0;
    let seven: u16 = 7;
    let high: u16 = 32768;
    let maximum: u16 = 65535;
    let empty: std::vec_u16::VecU16 = std::vec_u16::new();
    if (std::vec_u16::sort_in_place(empty) != 0 ||
        std::vec_u16::reverse_in_place(empty) != 0 ||
        std::vec_u16::lower_bound(empty, high) != 0 ||
        std::vec_u16::upper_bound(empty, high) != 0 ||
        std::vec_u16::binary_search_first_or(empty, high, -9) != -9 ||
        std::vec_u16::binary_search_last_or(empty, high, -7) != -7) { return 1; }
    std::vec_u16::destroy(empty);

    let single: std::vec_u16::VecU16 = std::vec_u16::try_with_capacity(2);
    single = std::vec_u16::try_push(single, maximum);
    if (std::vec_u16::len(single) != 1 ||
        std::vec_u16::sort_in_place(single) != 1 ||
        std::vec_u16::reverse_in_place(single) != 0 ||
        std::vec_u16::lower_bound(single, maximum) != 0 ||
        std::vec_u16::upper_bound(single, maximum) != 1 ||
        std::vec_u16::binary_search_first_or(single, maximum, -1) != 0 ||
        std::vec_u16::binary_search_last_or(single, high, -1) != -1 ||
        std::vec_u16::capacity(single) != 2) { return 2; }
    single = std::vec_u16::clear(single);
    if (std::vec_u16::sort_in_place(single) != 0 ||
        std::vec_u16::lower_bound(single, high) != 0 ||
        std::vec_u16::capacity(single) != 2) { return 3; }
    std::vec_u16::destroy(single);

    let values: [u16; 8] = [maximum, seven, high, seven, zero, maximum, high, seven];
    let owned: std::vec_u16::VecU16 = std::vec_u16::new();
    owned = std::vec_u16::try_extend_from_slice(owned, values, 8);
    if (std::vec_u16::len(owned) != 8 || std::vec_u16::capacity(owned) != 8) { return 4; }
    if (std::vec_u16::sort_in_place(owned) != 8 ||
        std::vec_u16::get_or(owned, 0, maximum) != zero ||
        std::vec_u16::get_or(owned, 1, zero) != seven ||
        std::vec_u16::get_or(owned, 2, zero) != seven ||
        std::vec_u16::get_or(owned, 3, zero) != seven ||
        std::vec_u16::get_or(owned, 4, zero) != high ||
        std::vec_u16::get_or(owned, 5, zero) != high ||
        std::vec_u16::get_or(owned, 6, zero) != maximum ||
        std::vec_u16::get_or(owned, 7, zero) != maximum) { return 5; }
    if (std::vec_u16::lower_bound(owned, zero) != 0 ||
        std::vec_u16::upper_bound(owned, zero) != 1 ||
        std::vec_u16::lower_bound(owned, seven) != 1 ||
        std::vec_u16::upper_bound(owned, seven) != 4 ||
        std::vec_u16::lower_bound(owned, high) != 4 ||
        std::vec_u16::upper_bound(owned, high) != 6 ||
        std::vec_u16::upper_bound(owned, maximum) != 8) { return 6; }
    if (std::vec_u16::binary_search_first_or(owned, high, -1) != 4 ||
        std::vec_u16::binary_search_last_or(owned, high, -1) != 5 ||
        std::vec_u16::binary_search_first_or(owned, maximum, -1) != 6 ||
        std::vec_u16::binary_search_last_or(owned, maximum, -1) != 7 ||
        std::vec_u16::binary_search_first_or(owned, 8, -12) != -12 ||
        std::vec_u16::binary_search_last_or(owned, 32767, -13) != -13) { return 7; }
    if (std::vec_u16::reverse_in_place(owned) != 4 ||
        std::vec_u16::get_or(owned, 0, zero) != maximum ||
        std::vec_u16::get_or(owned, 3, zero) != high ||
        std::vec_u16::get_or(owned, 7, maximum) != zero) { return 8; }
    if (std::vec_u16::sort_in_place(owned) != 8 ||
        std::vec_u16::binary_search_last_or(owned, seven, -1) != 3 ||
        std::vec_u16::capacity(owned) != 8) { return 9; }
    std::vec_u16::destroy(owned);
    return 0;
}
