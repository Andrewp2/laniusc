module app::main;
import core::slice_f32;

fn main() -> i32 {
    let zero: f32 = 0.0;
    let nan: f32 = zero / zero;
    let infinity: f32 = 1.0 / zero;
    let values: [f32; 5] = [1.0, 2.0, nan, -0.0, infinity];
    if (core::slice_f32::first_or(values, 5, -7.0) != 1.0 ||
        core::slice_f32::first_or(values, 0, -7.0) != -7.0 ||
        core::slice_f32::first_or(values, -1, -7.0) != -7.0) { return 1; }
    if (core::slice_f32::rotate_left(values, 5, -1) ||
        core::slice_f32::rotate_right(values, 5, 6) ||
        values[0] != 1.0 ||
        !core::slice_f32::rotate_left(values, 5, 2) ||
        values[0] == values[0] || values[1] != 0.0 ||
        values[2] != infinity ||
        values[3] != 1.0 || values[4] != 2.0 ||
        !core::slice_f32::rotate_right(values, 5, 2) ||
        values[0] != 1.0 || values[1] != 2.0 ||
        values[2] == values[2] || values[3] != 0.0 ||
        values[4] != infinity ||
        !core::slice_f32::rotate_left(values, 0, 0) ||
        !core::slice_f32::rotate_right(values, 5, 5) ||
        core::slice_f32::rotate_left(values, -1, 0)) { return 2; }

    let source: [f32; 4] = [1.0, nan, -0.0, infinity];
    let destination: [f32; 5] = [9.0, 9.0, 9.0, 9.0, 9.0];
    if (core::slice_f32::copy_nonoverlapping_range(destination, 5, -1, source, 4, 0, 1) ||
        core::slice_f32::copy_nonoverlapping_range(destination, 5, 4, source, 4, 0, 2) ||
        core::slice_f32::copy_nonoverlapping_range(destination, 5, 0, source, 4, 3, 2) ||
        core::slice_f32::copy_nonoverlapping_range(destination, -1, 0, source, 4, 0, 1) ||
        core::slice_f32::copy_nonoverlapping_range(destination, 5, 0, source, 4, 0, -1) ||
        destination[0] != 9.0 || destination[3] != 9.0 ||
        !core::slice_f32::copy_nonoverlapping_range(destination, 5, 2, source, 4, 1, 2) ||
        destination[0] != 9.0 || destination[1] != 9.0 ||
        destination[2] == destination[2] || destination[3] != 0.0 ||
        destination[4] != 9.0 ||
        !core::slice_f32::copy_nonoverlapping_range(destination, 5, 5, source, 4, 4, 0)) {
        return 3;
    }

    let compact: [f32; 6] = [0.0, -0.0, nan, nan, 2.0, 2.0];
    if (core::slice_f32::dedup_adjacent(compact, -1) != -1 ||
        compact[0] != 0.0 || compact[1] != 0.0 ||
        core::slice_f32::dedup_adjacent(compact, 6) != 4 ||
        compact[0] != 0.0 ||
        compact[1] == compact[1] || compact[2] == compact[2] ||
        compact[3] != 2.0 ||
        core::slice_f32::dedup_adjacent(compact, 0) != 0) { return 4; }
    let retained: [f32; 5] = [0.0, nan, -0.0, 2.0, 0.0];
    if (core::slice_f32::retain_not_equal(retained, -1, zero) != -1 ||
        retained[0] != 0.0 ||
        core::slice_f32::retain_not_equal(retained, 5, zero) != 2 ||
        retained[0] == retained[0] || retained[1] != 2.0 ||
        core::slice_f32::retain_not_equal(retained, 2, nan) != 2 ||
        retained[0] == retained[0] || retained[1] != 2.0) { return 5; }
    let removal: [f32; 3] = [1.0, nan, 2.0];
    if (core::slice_f32::remove_at(removal, 3, -1) ||
        core::slice_f32::remove_at(removal, 3, 3) ||
        removal[0] != 1.0 ||
        !core::slice_f32::remove_at(removal, 3, 1) ||
        removal[0] != 1.0 || removal[1] != 2.0 ||
        core::slice_f32::remove_at(removal, 0, 0)) { return 6; }

    let insertion: [f32; 4] = [1.0, 3.0, 9.0, 9.0];
    if (core::slice_f32::insert(insertion, 2, 2, 1, 2.0) ||
        core::slice_f32::insert(insertion, -1, 4, 0, 2.0) ||
        core::slice_f32::insert(insertion, 2, 4, 3, 2.0) ||
        core::slice_f32::push(insertion, 4, 4, nan) ||
        insertion[0] != 1.0 || insertion[1] != 3.0 ||
        !core::slice_f32::insert(insertion, 2, 4, 1, 2.0) ||
        insertion[0] != 1.0 || insertion[1] != 2.0 || insertion[2] != 3.0 ||
        !core::slice_f32::push(insertion, 3, 4, nan) ||
        insertion[3] == insertion[3] ||
        core::slice_f32::push(insertion, 4, 4, infinity)) { return 7; }

    let query: [f32; 5] = [-0.0, 1.0, 2.0, 1.0, 2.0];
    let prefix: [f32; 2] = [0.0, 1.0];
    let pair: [f32; 2] = [1.0, 2.0];
    let absent: [f32; 2] = [2.0, 2.0];
    let invalid: [f32; 2] = [nan, 1.0];
    if (core::slice_f32::count(query, 5, 0.0) != 1 ||
        core::slice_f32::count(query, 5, 1.0) != 2 ||
        core::slice_f32::count(query, 5, nan) != 0 ||
        core::slice_f32::count(query, 0, 1.0) != 0 ||
        core::slice_f32::count(query, -1, 1.0) != -1 ||
        !core::slice_f32::starts_with(query, 5, prefix, 2) ||
        !core::slice_f32::starts_with(query, 5, prefix, 0) ||
        core::slice_f32::starts_with(query, 5, invalid, 1) ||
        core::slice_f32::starts_with(query, -1, prefix, 0) ||
        !core::slice_f32::ends_with(query, 5, pair, 2) ||
        !core::slice_f32::ends_with(query, 5, invalid, 0) ||
        core::slice_f32::ends_with(query, 5, invalid, 2) ||
        core::slice_f32::ends_with(query, 1, pair, 2)) { return 8; }
    if (core::slice_f32::index_of_subslice_or(query, 5, pair, 2, -7) != 1 ||
        core::slice_f32::last_index_of_subslice_or(query, 5, pair, 2, -7) != 3 ||
        core::slice_f32::index_of_subslice_or(query, 5, pair, 0, -7) != 0 ||
        core::slice_f32::last_index_of_subslice_or(query, 5, pair, 0, -7) != 5 ||
        core::slice_f32::index_of_subslice_or(query, 5, absent, 2, -7) != -7 ||
        core::slice_f32::last_index_of_subslice_or(query, 5, absent, 2, -7) != -7 ||
        core::slice_f32::index_of_subslice_or(query, 5, invalid, 2, -7) != -7 ||
        core::slice_f32::last_index_of_subslice_or(query, 5, invalid, 2, -7) != -7 ||
        core::slice_f32::index_of_subslice_or(query, -1, pair, 2, -7) != -7 ||
        core::slice_f32::last_index_of_subslice_or(query, 5, pair, -1, -7) != -7) {
        return 9;
    }
    return 0;
}
