module app::main;
import std::vec_u8;

fn main() -> i32 {
    let first: u8 = 128;
    let second: u8 = 255;
    let inserted: u8 = 1;
    let fallback: u8 = 0;
    let value: std::vec_u8::VecU8 = std::vec_u8::try_with_capacity(2);
    if (std::vec_u8::capacity(value) != 2) { return 2; }
    value = std::vec_u8::try_push(value, first);
    value = std::vec_u8::try_push(value, second);
    if (std::vec_u8::len(value) != 2) { return 3; }
    value = std::vec_u8::try_insert(value, 1, inserted);
    if (std::vec_u8::len(value) == 3) {
        if (std::vec_u8::get_or(value, 0, fallback) != first ||
            std::vec_u8::get_or(value, 1, fallback) != inserted ||
            std::vec_u8::get_or(value, 2, fallback) != second) { return 6; }
        std::vec_u8::destroy(value);
        return 4;
    }
    if (std::vec_u8::len(value) != 2 ||
        std::vec_u8::capacity(value) != 2 ||
        std::vec_u8::get_or(value, 0, fallback) != first ||
        std::vec_u8::get_or(value, 1, fallback) != second) { return 5; }
    std::vec_u8::destroy(value);
    return 0;
}
