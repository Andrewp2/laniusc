module app::main;
import std::deque_u32;

fn main() -> i32 {
    let value: std::deque_u32::DequeU32 = std::deque_u32::try_with_capacity(3);
    let failure: bool = std::deque_u32::capacity(value) == 0 && std::deque_u32::len(value) == 0;
    let success: bool = std::deque_u32::capacity(value) == 3 && std::deque_u32::len(value) == 0;
    std::deque_u32::destroy(value);
    if (failure) { return 0; }
    if (success) { return 4; }
    return 5;
}
