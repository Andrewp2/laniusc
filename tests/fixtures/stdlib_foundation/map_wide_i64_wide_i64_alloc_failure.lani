module app::main;
import core::wide_i64;
import std::map_wide_i64_wide_i64;
fn same(left: core::wide_i64::WideI64, right: core::wide_i64::WideI64) -> bool {
    return core::wide_i64::eq(left, right);
}
fn main() -> i32 {
    let key: core::wide_i64::WideI64 = core::wide_i64::from_words(2147483648, 7);
    let other: core::wide_i64::WideI64 = core::wide_i64::from_words(1, 7);
    let item: core::wide_i64::WideI64 = core::wide_i64::max_value();
    let fallback: core::wide_i64::WideI64 = core::wide_i64::zero();
    let value: std::map_wide_i64_wide_i64::MapWideI64WideI64 = std::map_wide_i64_wide_i64::new();
    value = std::map_wide_i64_wide_i64::try_insert(value, key, item);
    if (std::map_wide_i64_wide_i64::len(value) == 0 &&
        std::map_wide_i64_wide_i64::capacity(value) == 0 &&
        !std::map_wide_i64_wide_i64::contains_key(value, key)) {
        std::map_wide_i64_wide_i64::destroy(value);
        return 0;
    }
    if (std::map_wide_i64_wide_i64::len(value) == 1 &&
        same(std::map_wide_i64_wide_i64::get_or(value, key, fallback), item)) {
        std::map_wide_i64_wide_i64::destroy(value);
        return 4;
    }
    std::map_wide_i64_wide_i64::destroy(value);
    return 5;
}
