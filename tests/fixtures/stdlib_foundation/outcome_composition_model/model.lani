// Test-only binary model of eager outcome selection and nested conversions.
// Input words: operation, free/method flavor, variant, a, b, c, d, identity.
// Four fixed observations report output, original inputs and inverse middle.
module app::main;

import core::f64;
import core::mem;
import core::option;
import core::result;
import std::io;

fn read_exact(pointer: ptr, count: i32, allow_eof: bool) -> bool {
    let done: i32 = 0;
    while (done < count) {
        let got: i32 = std::io::read_stdin(pointer + (done as usize), (count - done) as usize);
        assert(got >= 0);
        if (got == 0) { assert(allow_eof && done == 0); return false; }
        done += got;
    }
    return true;
}

fn write_all(pointer: ptr, count: i32) {
    let done: i32 = 0;
    while (done < count) {
        let got: i32 = std::io::write_stdout(pointer + (done as usize), (count - done) as usize);
        assert(got > 0);
        done += got;
    }
}

fn get64(bytes: [u8], offset: i32) -> u64 {
    let result: u64 = 0;
    let index: i32 = 0;
    while (index < 8) {
        result |= (bytes[offset + index] as u64) << (index * 8);
        index += 1;
    }
    return result;
}

struct Output { bytes: [u8], pointer: ptr, used: i32 }
impl Output {
    fn borrow(&self) -> &Output { return self; }
    fn flush(&self) { write_all(self.pointer, self.used); self.used = 0; }
    fn word(&self, value: u64) {
        if (self.used == 4096) { self.flush(); }
        let index: i32 = 0;
        while (index < 8) {
            self.bytes[self.used + index] = ((value >> (index * 8)) & 255) as u8;
            index += 1;
        }
        self.used += 8;
    }
}

struct Item { signed: i64, words: [u64; 2], floating: f64, flag: core::option::Option<bool> }
struct Fault { code: i32, stamp: u64 }
struct OtherFault { words: [u64; 2], flag: bool }
struct Observation { shape: u64, outer: u64, inner: u64, item: Item, fault: Fault, other: OtherFault }

fn item(first: u64, second: u64) -> Item {
    let flag: core::option::Option<bool> = core::option::None();
    if ((first & 3) != 0) { flag = core::option::Some((first & 1) == 0); }
    return Item { signed: first as i64, words: [first, second],
                  floating: core::f64::from_bits(second), flag: flag };
}

fn fault(first: u64, second: u64) -> Fault {
    return Fault { code: (first as u32) as i32, stamp: second };
}

fn other_fault(first: u64, second: u64) -> OtherFault {
    return OtherFault { words: [first, second], flag: (first & 1) != 0 };
}

fn empty() -> Observation {
    return Observation { shape: 0, outer: 0, inner: 0,
        item: Item { signed: 0, words: [0, 0], floating: core::f64::from_bits(0), flag: core::option::None() },
        fault: Fault { code: 0, stamp: 0 }, other: OtherFault { words: [0, 0], flag: false } };
}

fn option_item(value: core::option::Option<Item>) -> Observation {
    let result: Observation = empty(); result.shape = 1;
    if (value.is_some()) { result.outer = 1; let held: Item = value.unwrap(); result.item = held; }
    return result;
}

fn result_item(value: core::result::Result<Item, Fault>) -> Observation {
    let result: Observation = empty(); result.shape = 2;
    if (value.is_ok()) { let held: Item = value.unwrap(); result.item = held; }
    else { result.outer = 1; let held: Fault = value.unwrap_err(); result.fault = held; }
    return result;
}

fn result_other(value: core::result::Result<Item, OtherFault>) -> Observation {
    let result: Observation = empty(); result.shape = 3;
    if (value.is_ok()) { let held: Item = value.unwrap(); result.item = held; }
    else { result.outer = 1; let held: OtherFault = value.unwrap_err(); result.other = held; }
    return result;
}

fn option_result(value: core::option::Option<core::result::Result<Item, Fault>>) -> Observation {
    let result: Observation = empty(); result.shape = 4; result.inner = 2;
    if (value.is_some()) {
        result.outer = 1;
        let held: core::result::Result<Item, Fault> = value.unwrap();
        result.inner = 0;
        if (held.is_ok()) { let success: Item = held.unwrap(); result.item = success; }
        else { result.inner = 1; let failure: Fault = held.unwrap_err(); result.fault = failure; }
    }
    return result;
}

fn result_option(value: core::result::Result<core::option::Option<Item>, Fault>) -> Observation {
    let result: Observation = empty(); result.shape = 5; result.inner = 2;
    if (value.is_ok()) {
        let held: core::option::Option<Item> = value.unwrap();
        result.inner = 0;
        if (held.is_some()) { result.inner = 1; let success: Item = held.unwrap(); result.item = success; }
    } else { result.outer = 1; let failure: Fault = value.unwrap_err(); result.fault = failure; }
    return result;
}

fn option_nested(value: core::option::Option<core::option::Option<Item>>) -> Observation {
    let result: Observation = empty(); result.shape = 6; result.inner = 2;
    if (value.is_some()) {
        result.outer = 1;
        let held: core::option::Option<Item> = value.unwrap();
        result.inner = 0;
        if (held.is_some()) { result.inner = 1; let success: Item = held.unwrap(); result.item = success; }
    }
    return result;
}

fn result_nested(value: core::result::Result<core::result::Result<Item, Fault>, Fault>) -> Observation {
    let result: Observation = empty(); result.shape = 7; result.inner = 2;
    if (value.is_ok()) {
        let held: core::result::Result<Item, Fault> = value.unwrap();
        result.inner = 0;
        if (held.is_ok()) { let success: Item = held.unwrap(); result.item = success; }
        else { result.inner = 1; let failure: Fault = held.unwrap_err(); result.fault = failure; }
    } else { result.outer = 1; let failure: Fault = value.unwrap_err(); result.fault = failure; }
    return result;
}

fn option_word(value: core::option::Option<u64>) -> Observation {
    let result: Observation = empty(); result.shape = 8;
    if (value.is_some()) { result.outer = 1; result.item.words[0] = value.unwrap(); }
    return result;
}

fn result_word(value: core::result::Result<u64, Fault>) -> Observation {
    let result: Observation = empty(); result.shape = 9;
    if (value.is_ok()) { result.item.words[0] = value.unwrap(); }
    else { result.outer = 1; let failure: Fault = value.unwrap_err(); result.fault = failure; }
    return result;
}

fn emit(value: Observation, output: &Output) {
    output.word(value.shape); output.word(value.outer); output.word(value.inner);
    output.word(value.item.signed as u64);
    output.word(value.item.words[0]); output.word(value.item.words[1]);
    output.word(core::f64::to_bits(value.item.floating));
    let flag: u64 = 0;
    if (value.item.flag.is_some()) { flag = 1; if (value.item.flag.unwrap()) { flag = 2; } }
    output.word(flag);
    output.word((value.fault.code as i64) as u64); output.word(value.fault.stamp);
    output.word(value.other.words[0]); output.word(value.other.words[1]);
    output.word(value.other.flag as u64);
}

fn run(bytes: [u8], output: &Output) {
    let operation: u64 = get64(bytes, 0);
    let method: bool = get64(bytes, 8) != 0;
    let variant: u64 = get64(bytes, 16);
    let a: u64 = get64(bytes, 24); let b: u64 = get64(bytes, 32);
    let c: u64 = get64(bytes, 40); let d: u64 = get64(bytes, 48);
    assert(operation <= 8);
    if (operation <= 2) { assert(variant <= 3); } else { assert(variant <= 2); }
    let first: Item = item(a, b); let second: Item = item(c, d);
    let first_error: Fault = fault(a, b); let second_error: Fault = fault(c, d);
    let new_error: OtherFault = other_fault(c, d);
    let observed: Observation = empty();
    let before: Observation = empty(); let right: Observation = empty(); let middle: Observation = empty();
    if (operation == 0) {
        let left: core::option::Option<u64> = core::option::None();
        let next: core::option::Option<Item> = core::option::None();
        if ((variant & 1) != 0) { left = core::option::Some(a); }
        if ((variant & 2) != 0) { next = core::option::Some(second); }
        let result: core::option::Option<Item> = core::option::None();
        if (method) { result = left.and<Item>(next); }
        else { result = core::option::and<u64, Item>(left, next); }
        observed = option_item(result); before = option_word(left); right = option_item(next);
    }
    if (operation == 1) {
        let left: core::result::Result<u64, Fault> = core::result::Err(first_error);
        let next: core::result::Result<Item, Fault> = core::result::Err(second_error);
        if ((variant & 1) != 0) { left = core::result::Ok(a); }
        if ((variant & 2) != 0) { next = core::result::Ok(second); }
        let result: core::result::Result<Item, Fault> = core::result::Err(first_error);
        if (method) { result = left.and<Item>(next); }
        else { result = core::result::and<u64, Fault, Item>(left, next); }
        observed = result_item(result); before = result_word(left); right = result_item(next);
    }
    if (operation == 2) {
        let left: core::result::Result<Item, Fault> = core::result::Err(first_error);
        let next: core::result::Result<Item, OtherFault> = core::result::Err(new_error);
        if ((variant & 1) != 0) { left = core::result::Ok(first); }
        if ((variant & 2) != 0) { next = core::result::Ok(second); }
        let result: core::result::Result<Item, OtherFault> = core::result::Err(new_error);
        if (method) { result = left.or<OtherFault>(next); }
        else { result = core::result::or<Item, Fault, OtherFault>(left, next); }
        observed = result_other(result); before = result_item(left); right = result_other(next);
    }
    if (operation == 3) {
        let inner: core::result::Result<Item, Fault> = core::result::Ok(first);
        if (variant == 1) { inner = core::result::Err(first_error); }
        let source: core::result::Result<core::result::Result<Item, Fault>, Fault> = core::result::Ok(inner);
        if (variant == 2) { source = core::result::Err(second_error); }
        let result: core::result::Result<Item, Fault> = core::result::Err(first_error);
        if (method) { result = source.flatten(); }
        else { result = core::result::flatten<Item, Fault>(source); }
        observed = result_item(result); before = result_nested(source);
    }
    if (operation == 4) {
        let inner: core::option::Option<Item> = core::option::None();
        if (variant == 2) { inner = core::option::Some(first); }
        let source: core::option::Option<core::option::Option<Item>> = core::option::None();
        if (variant != 0) { source = core::option::Some(inner); }
        let result: core::option::Option<Item> = core::option::None();
        if (method) { result = source.flatten(); }
        else { result = core::option::flatten<Item>(source); }
        observed = option_item(result); before = option_nested(source);
    }
    if (operation == 5 || operation == 7) {
        let inner: core::result::Result<Item, Fault> = core::result::Ok(first);
        if (variant == 2) { inner = core::result::Err(first_error); }
        let source: core::option::Option<core::result::Result<Item, Fault>> = core::option::None();
        if (variant != 0) { source = core::option::Some(inner); }
        let result: core::result::Result<core::option::Option<Item>, Fault> = core::result::Ok(core::option::None());
        if (method) { result = source.transpose(); }
        else { result = core::option::transpose_to_result<Item, Fault>(source); }
        observed = result_option(result); before = option_result(source);
        if (operation == 7) {
            middle = observed;
            let restored: core::option::Option<core::result::Result<Item, Fault>> = core::option::None();
            if (method) { restored = result.transpose(); }
            else { restored = core::option::transpose_to_option<Item, Fault>(result); }
            observed = option_result(restored);
        }
    }
    if (operation == 6 || operation == 8) {
        let inner: core::option::Option<Item> = core::option::None();
        if (variant == 1) { inner = core::option::Some(first); }
        let source: core::result::Result<core::option::Option<Item>, Fault> = core::result::Ok(inner);
        if (variant == 2) { source = core::result::Err(first_error); }
        let result: core::option::Option<core::result::Result<Item, Fault>> = core::option::None();
        if (method) { result = source.transpose(); }
        else { result = core::option::transpose_to_option<Item, Fault>(source); }
        observed = option_result(result); before = result_option(source);
        if (operation == 8) {
            middle = observed;
            let restored: core::result::Result<core::option::Option<Item>, Fault> = core::result::Ok(core::option::None());
            if (method) { restored = result.transpose(); }
            else { restored = core::option::transpose_to_result<Item, Fault>(result); }
            observed = result_option(restored);
        }
    }
    emit(observed, output); emit(before, output); emit(right, output); emit(middle, output);
}

fn main() -> i32 {
    let input_words: [i32; 16] = [0; 16];
    let input_pointer: ptr = core::mem::i32_array_data_ptr(input_words);
    let input: [u8] = core::mem::typed_slice_from_raw_parts<u8>(input_pointer, 64);
    let output_words: [i32; 1024] = [0; 1024];
    let output_pointer: ptr = core::mem::i32_array_data_ptr(output_words);
    let output_bytes: [u8] = core::mem::typed_slice_from_raw_parts<u8>(output_pointer, 4096);
    let output: Output = Output { bytes: output_bytes, pointer: output_pointer, used: 0 };
    while (read_exact(input_pointer, 64, true)) { run(input, output.borrow()); }
    output.flush();
    return 0;
}
