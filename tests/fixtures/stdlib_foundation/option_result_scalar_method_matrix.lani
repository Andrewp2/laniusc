module app::main;
import core::option;
import core::option_char;
import core::option_f32;

fn main() -> i32 {
    let missing_bool: core::option::Option<bool> = core::option::None();
    let false_value: core::option::Option<bool> = core::option::Some(false);
    let missing_char: core::option_char::OptionChar = core::option_char::none();
    let letter: core::option_char::OptionChar = core::option_char::some('é');
    let missing_float: core::option_f32::OptionF32 = core::option_f32::none();
    let zero_float: core::option_f32::OptionF32 = core::option_f32::some(-0.0);

    if (!missing_bool.or(false_value).contains(false) ||
        !missing_char.or(letter).contains('é') ||
        !missing_float.or(zero_float).contains(0.0)) { return 1; }
    if (!false_value.ok_or(true).contains(false) ||
        !letter.ok_or('Ω').contains('é') ||
        !zero_float.ok_or(1.5).contains(0.0)) { return 2; }
    if (!missing_bool.ok_or(false).contains_err(false) ||
        !missing_char.ok_or('\0').contains_err('\0') ||
        !missing_float.ok_or(-2.5).contains_err(-2.5)) { return 3; }
    return 0;
}
