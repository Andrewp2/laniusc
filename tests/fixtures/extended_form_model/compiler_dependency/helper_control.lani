// Same observable cases; the inner match has an explicitly typed boundary.
module app::main;
import ext::form;
import ext::form_owned;

fn format_amount(cause:ext::form::Error) -> u64 {
    return match(cause) { ext::form::Error::Capacity(required) -> required, _ -> 0 };
}
fn amount(cause:ext::form_owned::Error) -> u64 {
    let result:u64=match(cause) { ext::form_owned::Error::Format(format) -> format_amount(format), _ -> 0 };
    return result;
}
fn main() -> i32 {
    assert(amount(ext::form_owned::Error::Format(ext::form::Error::Capacity(0)))==0);
    assert(amount(ext::form_owned::Error::Format(ext::form::Error::Capacity(4294967297)))==4294967297);
    assert(amount(ext::form_owned::Error::Format(ext::form::Error::Capacity(18446744073709551615)))==18446744073709551615);
    assert(amount(ext::form_owned::Error::Format(ext::form::Error::Bounds))==0);
    assert(amount(ext::form_owned::Error::AllocationFailed)==0);
    assert(amount(ext::form_owned::Error::CapacityOverflow)==0);
    return 0;
}
