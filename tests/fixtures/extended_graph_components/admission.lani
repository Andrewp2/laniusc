module app::main;
import alloc::vec;
import core::option;
import core::result;
import core::slice;
import ext::graph;
import ext::graph_algorithms;

fn main() -> i32 {
    let offsets:[i32;5]=[0,1,2,4,5]; let targets:[i32;5]=[2,0,0,3,3];
    let view:ext::graph::View=ext::graph::View {
        nodes:4, offsets:core::slice::view_range<i32>(offsets,0,5).unwrap(),
        targets:core::slice::view_range<i32>(targets,0,5).unwrap()
    };
    let limits:ext::graph::Limits=ext::graph::default_limits();
    let components:ext::graph_algorithms::StrongComponents=ext::graph_algorithms::strong_components(view,limits).unwrap();
    let condensed:ext::graph_algorithms::Condensation=ext::graph_algorithms::condensation(view,limits).unwrap();
    assert(components.is_open() && components.node_count()==4 && components.component_count()==3);
    assert(condensed.is_open() && condensed.node_count()==4 && condensed.component_count()==3);
    let expected:[i32;4]=[0,1,0,2]; let node:i32=0;
    while(node<4) { assert(components.component(node).unwrap()==expected[node] && condensed.component(node).unwrap()==expected[node]); node+=1; }
    assert(components.same_component(0,2).unwrap() && !components.same_component(0,1).unwrap());
    assert(condensed.same_component(2,0).unwrap() && !condensed.same_component(3,0).unwrap());
    let dag:ext::graph::View=condensed.view().unwrap();
    assert(dag.nodes==3 && dag.offsets.length==4 && dag.targets.length==2);
    assert(dag.offsets.values[0]==0 && dag.offsets.values[1]==1 && dag.offsets.values[2]==2 && dag.offsets.values[3]==2);
    assert(dag.targets.values[0]==2 && dag.targets.values[1]==0);
    let order:alloc::vec::Vec<i32> =ext::graph_algorithms::topological_order(dag,limits).unwrap();
    assert(order.len()==3 && order.at(0)==1 && order.at(1)==0 && order.at(2)==2); order.destroy();
    assert(offsets[0]==0 && offsets[1]==1 && offsets[2]==2 && offsets[3]==4 && offsets[4]==5);
    assert(targets[0]==2 && targets[1]==0 && targets[2]==0 && targets[3]==3 && targets[4]==3);
    assert(components.destroy() && !components.destroy()); assert(condensed.destroy() && !condensed.destroy());
    return 0;
}
