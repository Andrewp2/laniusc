module gen::lib;

enum Mode {
    Low,
    High(i32),
}

struct Depth {
    value: i32,
    inner: Mode,
}

struct Wrap {
    depth: Depth,
}

pub struct Outer {
    mode: Mode,
    wrap: Wrap,
    base: i32,
}

pub fn make(base: i32) -> Outer {
    return Outer { mode: High(1), wrap: Wrap { depth: Depth { value: 1, inner: Low } }, base: base };
}

pub fn total(o: Outer) -> i32 {
    return o.base + o.wrap.depth.value;
}

pub fn tag(o: Outer) -> i32 {
    return match (o.mode) {
        Low => 0,
        High(v) => v,
    };
}
