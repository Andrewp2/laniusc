trait Area { fn area(self) -> i32; }
struct Rect { w: i32, h: i32 }
struct Twice<T> { inner: T }
impl Area for Rect { fn area(self) -> i32 { return self.w * self.h; } }
impl<T> Area for Twice<T> where T: Area { fn area(self) -> i32 { return self.inner.area() * 2; } }
fn total<T>(a: T) -> i32 where T: Area { return a.area(); }
fn main() -> i32 {
    // Twice<T>::area's replay at T = Twice<Rect> routes self.inner.area() back
    // to Twice<T>::area: a recursive body, replayed as its own copy (f19fbab7).
    let x: Twice<Twice<Twice<Rect>>> = Twice { inner: Twice { inner: Twice { inner: Rect { w: 3, h: 7 } } } };
    let annotated: i32 = total(x) / 4;
    let inferred: i32 = total(Twice { inner: Twice { inner: Twice { inner: Rect { w: 3, h: 7 } } } }) / 4;
    if (annotated != inferred) { return 1; }
    return annotated;
}
