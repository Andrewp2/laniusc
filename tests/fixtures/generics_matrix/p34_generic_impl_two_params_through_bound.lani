trait Area { fn area(self) -> i32; }
struct Rect { w: i32, h: i32 }
struct Pair<A, B> { left: A, right: B }
impl Area for i32 { fn area(self) -> i32 { return self; } }
impl Area for Rect { fn area(self) -> i32 { return self.w * self.h; } }
impl<A, B> Area for Pair<A, B> where A: Area, B: Area { fn area(self) -> i32 { return self.left.area() + self.right.area(); } }
fn total<T>(a: T) -> i32 where T: Area { return a.area(); }
fn main() -> i32 { return total(Pair { left: Rect { w: 4, h: 10 }, right: 2 }); }
