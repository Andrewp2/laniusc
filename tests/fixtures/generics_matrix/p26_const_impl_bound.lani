// expect: 0
trait Inner<A> {}
trait Outer<A> {}
impl<const N: u8> Inner<[i32; N]> for bool {}
impl<const M: u64> Outer<[i32; M]> for bool where bool: Inner<[i32; M]> {}
fn boundary<T>(value: T) -> T where T: Outer<[i32; 255]> { return value; }
fn main() -> i32 { if (boundary(false)) { return 1; } return 0; }
