struct Point { x: i32, y: i32 }
fn count<T>(values: [T], len: i32) -> i32 { let n: i32 = 0; let i: i32 = 0; while (i < len) { let v: T = values[i]; n += 1; i += 1; } return n; }
fn main() -> i32 { let a: [Point; 3] = [Point { x: 0, y: 0 }, Point { x: 0, y: 0 }, Point { x: 0, y: 0 }]; return count(a, 3) + 39; }
