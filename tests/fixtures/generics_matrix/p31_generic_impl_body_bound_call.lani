trait Area { fn area(self) -> i32; }
struct Rect { w: i32, h: i32 }
struct Twice<T> { inner: T }
impl Area for Rect { fn area(self) -> i32 { return self.w * self.h; } }
impl<T> Area for Twice<T> where T: Area { fn area(self) -> i32 { return self.inner.area() * 2; } }
fn main() -> i32 { let t: Twice<Rect> = Twice { inner: Rect { w: 3, h: 7 } }; return t.area(); }
