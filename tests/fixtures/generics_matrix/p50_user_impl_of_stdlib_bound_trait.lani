module app::main;
import core::set;
import core::cmp;
import core::result;
struct Point {
    x: i32,
    y: i32
}
pub impl core::cmp::Eq<Point>for Point {
    pub fn eq(left: Point, right: Point) -> bool {
        return left.x == right.x && left.y == right.y;
    }
    pub fn ne(left: Point, right: Point) -> bool {
        return !Point::eq(left, right);
    }
}
fn main() -> i32 {
    let origin: Point = Point {
        x: 0,
        y: 0
    };
    let points: core::set::Set<Point,
    3> = core::set::from_storage([origin, origin, origin]);
    core::result::unwrap(core::set::try_insert(points.borrow(), Point {
        x: 1, y: 2
    }
    ));
    core::result::unwrap(core::set::try_insert(points.borrow(), Point {
        x: 1, y: 2
    }
    ));
    core::result::unwrap(core::set::try_insert(points.borrow(), Point {
        x: 3, y: 4
    }
    ));
    if (core::set::len(points.borrow()) != 2 || !core::set::contains(points.borrow(), Point {
        x: 3, y: 4
    }
    )) {
        return 1;
    }
    return 42;
}
