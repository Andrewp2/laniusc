// expect: 42
// A finite chain of 9 generic levels: past the instance closure level limit; the replay rounds compile every level.
struct Box<T> { inner: T }
fn l0<T>(value: T) -> T { return value; }
fn l1<T>(value: T) -> T { return l0(Box { inner: value }).inner; }
fn l2<T>(value: T) -> T { return l1(Box { inner: value }).inner; }
fn l3<T>(value: T) -> T { return l2(Box { inner: value }).inner; }
fn l4<T>(value: T) -> T { return l3(Box { inner: value }).inner; }
fn l5<T>(value: T) -> T { return l4(Box { inner: value }).inner; }
fn l6<T>(value: T) -> T { return l5(Box { inner: value }).inner; }
fn l7<T>(value: T) -> T { return l6(Box { inner: value }).inner; }
fn l8<T>(value: T) -> T { return l7(Box { inner: value }).inner; }
fn main() -> i32 { return l8(40) + l8(2); }
