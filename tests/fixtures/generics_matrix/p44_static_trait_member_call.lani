trait Same<T> { fn same(left: T, right: T) -> bool; }
impl Same<i32> for i32 { fn same(left: i32, right: i32) -> bool { return left == right; } }
fn count<T>(items: [T; 3], item: T) -> i32 where T: Same<T> {
    let index: i32 = 0;
    let hits: i32 = 0;
    while (index < 3) {
        if (T::same(items[index], item)) { hits += 1; }
        index += 1;
    }
    return hits;
}
fn main() -> i32 { let items: [i32; 3] = [7, 7, 4]; return count(items, 7) + 40; }
