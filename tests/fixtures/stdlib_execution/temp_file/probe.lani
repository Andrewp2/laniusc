fn repair(raw:u64){mark(81);assert(raw<2147483648);let args:[std::linux::Argument;1]=[std::linux::Argument::Word(raw as i64)];assert(core::result::unwrap(std::linux::call(3,core::slice::View{values:args,start:0,length:1}))==0);mark(113);}
fn main()->i32{
