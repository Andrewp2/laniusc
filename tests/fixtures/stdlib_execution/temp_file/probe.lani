    output[60]=state(owner.state());output[63]=owner.owns_temporary_name() as u64;let last:core::option::Option<std::temp_file::Failure> = owner.last_failure();if(core::option::is_some(last)){let failure:std::temp_file::Failure=core::option::unwrap(last);output[61]=cause(failure.cause);output[62]=stage(failure.stage);assert(!failure.cleanup.retained);}
