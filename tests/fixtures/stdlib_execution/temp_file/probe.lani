    output[2]=state(owner.state());let stats:std::temp_file::Stats=owner.stats();output[4]=stats.name_attempts as u64;output[5]=stats.open_attempts as u64;output[6]=stats.collisions as u64;output[7]=stats.excluded as u64;output[8]=stats.entropy_calls;
    output[10]=fd(owner.file());output[11]=fd(owner.directory());let named:core::slice::View<u8> = owner.name();output[12]=named.length as u64;let name:[u8;37]=[0;37];i=0;while(i<named.length){name[i]=named.values[named.start+i];i+=1;}
    if(core::result::is_ok(created)){
        assert(owner.owns_temporary_name());assert(core::result::unwrap(std::file_ops::close_on_exec(owner.file())));assert(core::result::unwrap(std::file_ops::close_on_exec(owner.directory())));
        if(mode!=11){let data:[u8;6]=[0,255,128,97,13,10];assert(core::result::unwrap(core::io::write_all(owner.file(),data,0,6))==6);
        core::result::unwrap(std::file_ops::seek(owner.file(),0,std::file_ops::Origin::Start));let copied:[u8;6]=[0;6];assert(core::result::unwrap(core::io::read_exact(owner.file(),copied,0,6))==6);i=0;while(i<6){assert(copied[i]==data[i]);i+=1;}}
