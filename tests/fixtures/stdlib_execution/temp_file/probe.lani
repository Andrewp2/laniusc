fn fd(file:&std::file::File)->u64{let value:core::option::Option<i32> = file.raw_handle();if(core::option::is_none(value)){return 18446744073709551615;}return core::option::unwrap(value) as u64;}
fn mark(value:u8){let byte:[u8;1]=[value];let stderr:std::stream::Descriptor=std::stream::stderr();assert(core::io::write_all(stderr.borrow(),byte,0,1).is_ok());}
fn receipt(output:[u64],at:i32,result:core::result::Result<std::temp_file::Cleanup,std::temp_file::Failure>){
