    if(excluded_case==11){excluded_view.start=1;excluded_view.length=37;excluded[1]=255;}if(excluded_case==12){excluded[0]=120;excluded[1]=47;excluded[2]=121;excluded_view.length=3;}
    let created:core::result::Result<bool,std::temp_file::Failure> = core::result::Ok(false);
    mark(67);if(excluded_case==0){created=owner.create_in(parent.borrow(),limits);}else{created=owner.create_in_excluding(parent.borrow(),core::path::Path{bytes:excluded_view},limits);}mark(99);
