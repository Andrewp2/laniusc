fn fd(value:core::option::Option<i32>)->u64{if(value.is_none()){return 18446744073709551615;}return value.unwrap() as u64;}
fn mark(value:u8){let raw:[u8;1]=[value];let sink=std::stream::stderr();core::io::write_all(sink.borrow(),raw,0,1).unwrap();}
fn ack(){let raw:[u8;1]=[0];let source=std::stream::stdin();core::io::read_exact(source.borrow(),raw,0,1).unwrap();assert(raw[0]==33);}
