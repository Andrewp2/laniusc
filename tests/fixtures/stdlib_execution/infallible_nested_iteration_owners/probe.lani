    assert(audit.outer==0 && audit.inner==0 && audit.retire==0 && audit.maps==0); mark(99);
    mark(84); pull(adapter.borrow(),audit,mode); mark(116);
    if(mode==1) {
        let before:i32=audit.outer+audit.inner+audit.retire+audit.maps;
        assert(adapter.has_active() && adapter.try_finish().is_some() && adapter.has_active());
        assert(audit.outer+audit.inner+audit.retire+audit.maps==before && source.values.remaining()==1 && audit.received==1);
    } else {
        let before:i32=audit.outer+audit.inner+audit.retire+audit.maps;
        assert(!adapter.has_active() && adapter.next().is_none() && adapter.next().is_none() && adapter.try_finish().is_none());
        assert(audit.outer+audit.inner+audit.retire+audit.maps==before);
    }
    report<J>(pid,1,backend,1,mode,0,audit,source.values.borrow(),adapter.has_active(),true);
