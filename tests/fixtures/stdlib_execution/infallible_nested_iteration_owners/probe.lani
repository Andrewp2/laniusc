    if(mode==1) { assert(active.is_some()); recover(active.unwrap(),policy.borrow(),audit); } else { assert(active.is_none()); }
    assert(adapter.take_active().is_none() && adapter.next().is_none() && adapter.try_finish().is_none());
    if(mode==1) {
        let resumed:core::iter::FlatMap<Rows<J>,Make<J>,Policy<J>,Row<J>,Inner<J>,alloc::string::String> = core::iter::flat_map<Rows<J>,Make<J>,Policy<J>,Row<J>,Inner<J>,alloc::string::String>(source.borrow(),mapper.borrow(),policy.borrow());
        pull(resumed.borrow(),audit,0); assert(!resumed.has_active() && resumed.next().is_none() && resumed.try_finish().is_none());
    }
    release_rows(source.values.borrow()); assert(audit.received==6 && audit.scratch_freed==3 && audit.backing_freed==3 && audit.label_freed==3); check_held(audit); mark(107);
    report<J>(pid,2,backend,1,mode,0,audit,source.values.borrow(),false,true);
    mark(75); release_held(audit); mark(107);
    report<J>(pid,3,backend,1,mode,0,audit,source.values.borrow(),false,true); return 0;
}

fn main() -> i32 {
    let request:[i32;3]=[0;3]; receive(core::mem::i32_array_data_ptr(request),12);
    let backend:i32=request[0]; let flavor:i32=request[1]; let mode:i32=request[2];
    assert(backend>=0 && backend<=1 && flavor>=0 && flavor<=1 && mode>=0 && mode<=1);
    let arguments:[std::linux::Argument;1]=[std::linux::Argument::Word(0)];
    let pid:u64=std::linux::call(39,core::slice::View { values:arguments,start:0,length:0 }).unwrap() as u64;
    let audit:Audit=Audit { outer:0,inner:0,retire:0,maps:0,received:0,scratch_freed:0,backing_freed:0,label_freed:0,held:core::option::None() };
    if(backend==0) {
        let made:core::result::Result<alloc::vec::IntoIter<Row<alloc::vec::IntoIter<alloc::string::String>>>,SetupError> =build_vector(audit.borrow());
        if(flavor==0) { return run_flat<alloc::vec::IntoIter<alloc::string::String>>(made,pid,backend,mode,audit.borrow()); }
        return run_map<alloc::vec::IntoIter<alloc::string::String>>(made,pid,backend,mode,audit.borrow());
    }
    let made:core::result::Result<alloc::vec::IntoIter<Row<alloc::deque::IntoIter<alloc::string::String>>>,SetupError> =build_ring(audit.borrow());
    if(flavor==0) { return run_flat<alloc::deque::IntoIter<alloc::string::String>>(made,pid,backend,mode,audit.borrow()); }
    return run_map<alloc::deque::IntoIter<alloc::string::String>>(made,pid,backend,mode,audit.borrow());
}
