// Copy-heavy kernels for the x86 small-copy change: 1-3 word records and
// enums passed by value, returned, and copied between array slots. Prints
// "label ms" per kernel and a checksum (58592112).
// Build: laniusc --native-link --native-library atomic --stdlib-root stdlib
module app::main;
import core::option;
import std::io;
import std::sync;

const N: i64 = 10000000;
struct One { a: i64 }
struct Two { a: i64, b: i64 }
struct Three { a: i64, b: i64, c: i64 }
enum Shape { Dot(i64), Line(i64, i64), Empty }

fn now_ms() -> i64 { let d: std::sync::Deadline = std::sync::now().unwrap(); return d.seconds * 1000 + d.nanos / 1000000; }
fn show(label: str, start: i64) { std::io::write_text(1, label); std::io::write_text(1, " "); std::io::write_i32(1, (now_ms() - start) as i32); std::io::write_newline(1); }

fn step1(v: One) -> One { return One { a: v.a + 1 }; }
fn step2(v: Two) -> Two { return Two { a: v.b, b: v.a + v.b }; }
fn step3(v: Three) -> Three { return Three { a: v.b, b: v.c, c: v.a + 1 }; }
fn grow(s: Shape, i: i64) -> Shape {
    return match (s) { Shape::Dot(x) -> Shape::Line(x, i), Shape::Line(x, y) -> Shape::Dot(x + y), Shape::Empty -> Shape::Dot(i) };
}
fn weight(s: Shape) -> i64 { return match (s) { Shape::Dot(x) -> x, Shape::Line(x, y) -> x - y, Shape::Empty -> 0 }; }
fn maybe(i: i64) -> core::option::Option<i64> { if (i % 3 == 0) { return core::option::None(); } return core::option::Some(i); }

fn main() -> i32 {
    let sum: i64 = 0;
    let start: i64 = now_ms();
    let one: One = One { a: 0 }; let i: i64 = 0;
    while (i < N) { one = step1(one); i += 1; }
    sum += one.a; show("one_word_calls", start);

    start = now_ms();
    let two: Two = Two { a: 0, b: 1 }; i = 0;
    while (i < N) { two = step2(two); two.b = two.b % 1000003; i += 1; }
    sum += two.b; show("two_word_calls", start);

    start = now_ms();
    let three: Three = Three { a: 1, b: 2, c: 3 }; i = 0;
    while (i < N) { three = step3(three); i += 1; }
    sum += three.a + three.b + three.c; show("three_word_calls", start);

    start = now_ms();
    let shape: Shape = Shape::Empty; i = 0;
    while (i < N) { shape = grow(shape, i); sum += weight(shape) % 7; i += 1; }
    show("enum_calls", start);

    start = now_ms();
    i = 0;
    while (i < N) { let m: core::option::Option<i64> = maybe(i); if (core::option::is_some(m)) { sum += core::option::unwrap(m) % 5; } i += 1; }
    show("option_returns", start);

    start = now_ms();
    let cells: [Three; 1024] = [Three { a: 0, b: 0, c: 0 }; 1024];
    i = 0;
    while (i < N) {
        let k: i32 = (i % 1024) as i32;
        let src: Three = cells[(k + 511) % 1024];
        cells[k] = Three { a: src.b + 1, b: src.c, c: src.a };
        i += 1;
    }
    sum += cells[7].a + cells[9].b; show("array_record_copies", start);

    std::io::write_text(1, "checksum "); std::io::write_i32(1, (sum % 1000000007) as i32); std::io::write_newline(1);
    return 0;
}
