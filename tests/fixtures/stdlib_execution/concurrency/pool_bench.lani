// std::pool (threads) against std::par (forked workers) on 10M i64:
//   pool_bench map|reduce|scan pool|par WORKERS
// map x -> 3x + 1, reduce a sum, scan an in-place prefix sum; grain 65,536
// for both. Prints "ms MS check VALUE".
// Build: laniusc --native-link --native-library atomic --stdlib-root stdlib
module app::main;
import core::function;
import core::iter;
import core::mem;
import core::result;
import core::slice;
import std::args;
import std::io;
import std::par;
import std::parallel;
import std::pool;
import std::sync;

const N: i32 = 10000000;
const GRAIN: i32 = 65536;

struct Affine3 { bias: i64 }
impl Affine3 { pub fn borrow(&self) -> &Affine3 { return self; } }
pub impl core::function::Mapper<i64, i64> for Affine3 { pub fn apply(&self, value: i64) -> i64 { return value * 3 + self.bias; } }
struct Add { unused: i64 }
impl Add { pub fn borrow(&self) -> &Add { return self; } }
pub impl core::iter::Folder<i64, i64> for Add { pub fn apply(&self, acc: i64, value: i64) -> i64 { return acc + value; } }

fn map_affine(arg: ptr) -> ptr { return std::pool::map_entry<i64, i64, Affine3>(arg); }
fn reduce_add(arg: ptr) -> ptr { return std::pool::reduce_entry<i64, i64, Add>(arg); }
fn scan_add(arg: ptr) -> ptr { return std::pool::scan_entry<i64, Add>(arg); }
fn now_us() -> i64 { let d: std::sync::Deadline = std::sync::now().unwrap(); return d.seconds * 1000000 + d.nanos / 1000; }

fn main() -> i32 {
    let arguments: std::args::Arguments = std::args::snapshot(1, 3, 128).unwrap();
    if (arguments.len() != 3) { std::io::write_text(2, "usage: pool_bench map|reduce|scan pool|par WORKERS\n"); return 2; }
    let test: core::slice::View<u8> = arguments.get(0).unwrap();
    let tool: core::slice::View<u8> = arguments.get(1).unwrap();
    let count: core::slice::View<u8> = arguments.get(2).unwrap();
    let workers: i32 = 0; let c: i32 = 0;
    while (c < count.length) { workers = workers * 10 + ((count.values[count.start + c] as i32) - 48); c += 1; }
    let threads: bool = tool.values[tool.start] == 112 && tool.values[tool.start + 1] == 111;
    let kind: u8 = test.values[test.start];
    let region: std::sync::Region = std::sync::map_shared(268435456).unwrap();
    let input: std::parallel::Shared<i64> = std::parallel::shared<i64>(region.borrow(), N).unwrap();
    let output: std::parallel::Shared<i64> = std::parallel::shared<i64>(region.borrow(), N).unwrap();
    let partials: std::parallel::Shared<i64> = std::parallel::shared<i64>(region.borrow(), N / GRAIN + 2).unwrap();
    let values: [i64] = input.view();
    let i: i32 = 0;
    while (i < N) { values[i] = ((i as i64) * 2654435761) % 1000003; i += 1; }
    let plan: std::par::Plan = std::par::plan(region.borrow(), workers, GRAIN).unwrap();
    let check: i64 = 0;
    let start: i64 = now_us();
    if (kind == 109) {
        if (threads) { std::pool::map<i64, i64, Affine3>(workers, input, output, Affine3 { bias: 1 }, GRAIN, map_affine).unwrap(); }
        else { let m: Affine3 = Affine3 { bias: 1 }; std::par::map(plan, input, output, m.borrow()).unwrap(); }
        let out: [i64] = output.view(); check = out[N - 1] + out[N / 2];
    }
    if (kind == 114) {
        let add: Add = Add { unused: 0 };
        if (threads) { check = std::pool::reduce<i64, i64, Add, Add>(workers, input, 0, Add { unused: 0 }, add.borrow(), GRAIN, reduce_add).unwrap(); }
        else { check = std::par::reduce(plan, input, partials, 0, add.borrow(), add.borrow()).unwrap(); }
    }
    if (kind == 115) {
        let add: Add = Add { unused: 0 };
        if (threads) { std::pool::scan<i64, Add>(workers, input, 0, Add { unused: 0 }, GRAIN, scan_add).unwrap(); }
        else { std::par::scan(plan, input, partials, 0, add.borrow()).unwrap(); }
        check = values[N - 1];
    }
    let elapsed: i64 = now_us() - start;
    std::io::write_text(1, "ms "); std::io::write_i32(1, (elapsed / 1000) as i32);
    std::io::write_text(1, " check "); std::io::write_i32(1, (check % 1000000007) as i32); std::io::write_newline(1);
    return 0;
}
