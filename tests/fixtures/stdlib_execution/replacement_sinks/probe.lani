    }
    mark(107); assert(state.pending.is_none() && source.values.remaining()==0 && state.committed==input_count as u64);
    report<R,T,E>(pid,2,backend,profile,true,destination,source.borrow(),history.borrow(),state.borrow(),input_count,setup_count);
    mark(75); cleanup<R,T,E>(destination,source.borrow(),history.borrow(),state.borrow(),true); mark(107);
    assert(state.held.is_some()); let held:T=state.held.unwrap(); held.check(); if(state.hold_wanted>=0) { assert(held.stamp()==state.hold_wanted); }
    report<R,T,E>(pid,3,backend,profile,true,destination,source.borrow(),history.borrow(),state.borrow(),input_count,setup_count);
    mark(75); state.held=core::option::None(); held.release(); state.error.destroy(); state.error.destroy(); mark(107);
    report<R,T,E>(pid,4,backend,profile,true,destination,source.borrow(),history.borrow(),state.borrow(),input_count,setup_count); return state.status;
}
fn main() -> i32 {
    let request:[i32;2]=[0;2]; read(core::mem::i32_array_data_ptr(request),8); let backend:i32=request[0]; let profile:i32=request[1];
    assert(backend>=0 && backend<=3 && profile>=0 && profile<=3);
    let arguments:[std::linux::Argument;1]=[std::linux::Argument::Word(0)];
    let pid:u64=std::linux::call(39,core::slice::View { values:arguments,start:0,length:0 }).unwrap() as u64;
