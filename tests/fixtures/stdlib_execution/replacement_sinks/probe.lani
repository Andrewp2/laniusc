struct Audit { source:i32,replacement:i32,delivery:i32 }
impl Audit { fn borrow(&self) -> &Audit { return self; } }
struct Input<T> { values:alloc::vec::IntoIter<T>,audit:&Audit }
impl<T> Input<T> { fn borrow(&self) -> &Input<T> { return self; } }
pub impl<T> core::iter::Iterator<T> for Input<T> {
    pub fn next(&self) -> core::option::Option<T> {
        mark(83); let audit:&Audit=self.audit; audit.source+=1;
        let found:core::option::Option<T> =self.values.next(); return found;
    }
}
struct Forward<R,T,E> { actual:&R,audit:&Audit }
impl<R,T,E> Forward<R,T,E> { fn borrow(&self) -> &Forward<R,T,E> { return self; } }
pub impl<R,T,E> core::iter::TryReplaceSink<T,E> for Forward<R,T,E> where R:core::iter::TryReplaceSink<T,E> {
    pub fn try_replace_item(&self,item:T) -> core::result::Result<core::option::Option<T>,E> {
        mark(82); let audit:&Audit=self.audit; audit.replacement+=1; let actual:&R=self.actual;
        let result:core::result::Result<core::option::Option<T>,E> =actual.try_replace_item(item);
        mark(114); return result;
    }
}
struct Delivery { kind:i32,text:alloc::string::String }
impl Delivery {
    fn destroy(&self) { if(self.text.capacity()>0) { mark(69); } self.text.destroy(); self.kind=0; }
    fn check(&self) {
        if(self.text.capacity()==0) { assert(self.text.byte_len()==0); return; }
        let bytes:[u8;5]=[69,0,195,169,82]; assert(self.kind==1 && self.text.byte_len()==5 && self.text.capacity()==5);
        let at:i32=0; while(at<5) { assert(self.text.byte_at(at).unwrap()==bytes[at]); at+=1; }
    }
}
fn no_error() -> Delivery { return Delivery { kind:0,text:alloc::string::new() }; }
struct History<T> { values:alloc::vec::Vec<T>,limit:i32,audit:&Audit }
impl<T> History<T> { fn borrow(&self) -> &History<T> { return self; } }
pub impl<T> core::iter::TrySink<T,Delivery> for History<T> {
    pub fn try_accept(&self,item:T) -> core::option::Option<Delivery> {
        mark(68); let audit:&Audit=self.audit; audit.delivery+=1;
        if(self.values.len()>=self.limit) {
            let bytes:[u8;5]=[69,0,195,169,82];
            let made:core::result::Result<alloc::string::String,alloc::string::Error> =alloc::string::from_utf8(bytes,5);
            if(made.is_err()) { mark(100); return core::option::Some(Delivery { kind:3,text:alloc::string::new() }); }
            mark(100); return core::option::Some(Delivery { kind:1,text:made.unwrap() });
        }
        let added:core::result::Result<i32,alloc::vec::Error> =self.values.try_push(item);
        mark(100); if(added.is_err()) { return core::option::Some(Delivery { kind:2,text:alloc::string::new() }); }
        return core::option::None();
    }
}
struct State<T> {
    status:i32,tag:i32,pending_kind:i32,pending:core::option::Option<T>,held:core::option::Option<T>,
    committed:u64,replaced:u64,error:Delivery,secondary:i32,hold_wanted:i32
}
impl<T> State<T> { fn borrow(&self) -> &State<T> { return self; } }
fn captured<T,E>(result:core::result::Result<core::iter::ReplacementTransfer,core::iter::ReplacementFailure<T,E,Delivery>>,state:&State<T>,primary:bool) -> bool
    where T:Payload<T>,E:StorageError {
    if(result.is_ok()) {
        let done:core::iter::ReplacementTransfer=result.unwrap(); assert(done.exhausted);
        state.committed+=done.progress.committed; state.replaced+=done.progress.replaced; return true;
    }
    let failure:core::iter::ReplacementFailure<T,E,Delivery> =result.unwrap_err();
    let tag:i32=match(failure) { Rejected(progress,incoming,error)->1,Undelivered(progress,old,error)->2 };
    let progress:core::iter::ReplacementProgress=match(failure) { Rejected(progress,incoming,error)->progress,Undelivered(progress,old,error)->progress };
    let item:T=match(failure) { Rejected(progress,incoming,error)->incoming,Undelivered(progress,old,error)->old };
    let rejected:core::option::Option<E> =match(failure) { Rejected(progress,incoming,error)->core::option::Some(error),Undelivered(progress,old,error)->core::option::None() };
    let undelivered:core::option::Option<Delivery> =match(failure) { Rejected(progress,incoming,error)->core::option::None(),Undelivered(progress,old,error)->core::option::Some(error) };
    let cause:Delivery=no_error();
    if(tag==1) { let error:E=rejected.unwrap(); assert(error.allocation()); cause.kind=10; }
    else { cause=undelivered.unwrap(); cause.check(); assert(cause.kind>=1 && cause.kind<=3); }
    assert(state.pending.is_none()); item.check(); state.pending=core::option::Some(item); state.pending_kind=tag;
    state.committed+=progress.committed; state.replaced+=progress.replaced;
    let allocation_failed:bool=cause.kind!=1;
    if(primary) { state.tag=tag; state.error=cause; if(tag==2) { state.hold_wanted=item.stamp(); } }
    else { state.secondary=cause.kind; cause.destroy(); }
    if(allocation_failed) { state.status=4; } return false;
}
fn input_identity(profile:i32,index:i32) -> i32 {
    if(profile!=0) { return 1; } let ids:[i32;7]=[1,2,1,3,1,4,5]; return ids[index];
}
fn release_input<T>(source:&Input<T>) where T:Payload<T> {
    let remaining:alloc::vec::Vec<T> =source.values.take_remaining();
    while(true) { let found:core::option::Option<T> =remaining.pop(); if(found.is_none()) { break; } let item:T=found.unwrap(); item.release(); }
    remaining.destroy();
}
fn cleanup<R,T,E>(destination:&R,source:&Input<T>,history:&History<T>,state:&State<T>,retain:bool)
    where T:Payload<T>,R:Store<T,E> {
    release_input(source); destination.cleanup();
    while(true) {
        let found:core::option::Option<T> =history.values.pop(); if(found.is_none()) { break; } let item:T=found.unwrap();
        if(retain && state.held.is_none() && (state.hold_wanted<0 || item.stamp()==state.hold_wanted)) { state.held=core::option::Some(item); }
        else { item.release(); }
    }
    history.values.destroy();
}
fn report<R,T,E>(pid:u64,phase:u64,backend:i32,profile:i32,ready:bool,destination:&R,source:&Input<T>,history:&History<T>,state:&State<T>,input_count:i32,setup_count:i32)
    where T:Payload<T>,R:Store<T,E> {
    state.error.check();
    word(1347621681); word(pid); word(phase); word(backend as u64); word(profile as u64); word(state.status as u64); if(ready) { word(1); } else { word(0); } word(state.tag as u64);
    word(state.committed); word(state.replaced); let audit:&Audit=source.audit; word(audit.source as u64); word(audit.replacement as u64); word(audit.delivery as u64);
    word(destination.count() as u64); word(destination.reserved() as u64); word(source.values.remaining() as u64); word(source.values.capacity() as u64);
    word(history.values.len() as u64); word(history.values.capacity() as u64);
    if(state.pending.is_some()) { let item:T=state.pending.unwrap(); word(1); word(item.identity() as u64); word(item.stamp() as u64); } else { word(0); word(0); word(0); }
    if(state.held.is_some()) { let item:T=state.held.unwrap(); word(1); word(item.identity() as u64); word(item.stamp() as u64); } else { word(0); word(0); word(0); }
    word(state.error.kind as u64); word(state.error.text.capacity() as u64); word(state.secondary as u64); word(input_count as u64); word(setup_count as u64); word(core::mem::size_of<T>() as u64); word(0);
    destination.emit();
    let index:i32=0; while(index<history.values.len()) { let item:T=history.values.at(index); emit_item(item); index+=1; }
    let view:core::slice::View<T> =source.values.as_view(); index=0; while(index<view.len()) { let item:T=view.get(index).unwrap(); emit_item(item); index+=1; }
    if(state.pending.is_some()) { emit_item(state.pending.unwrap()); } if(state.held.is_some()) { emit_item(state.held.unwrap()); } ack();
}
fn run<R,T,E>(destination:&R,backend:i32,profile:i32,pid:u64) -> i32
    where T:Payload<T>,E:StorageError,R:Store<T,E>,R:core::iter::TryReplaceSink<T,E> {
    let audit:Audit=Audit { source:0,replacement:0,delivery:0 };
    let history:History<T> =History { values:alloc::vec::new<T>(),limit:16,audit:audit.borrow() }; if(profile==3) { history.limit=1; }
    let values:alloc::vec::Vec<T> =alloc::vec::new<T>();
    let state:State<T> =State { status:0,tag:0,pending_kind:0,pending:core::option::None(),held:core::option::None(),committed:0,replaced:0,error:no_error(),secondary:0,hold_wanted:-1 };
    let failed:bool=false; let setup_count:i32=0; let input_count:i32=3; if(profile==0) { input_count=7; }
    mark(85);
    if(profile!=0) {
        mark(80); let reserved:core::result::Result<i32,E> =destination.reserve(1); mark(112);
        if(reserved.is_err()) { let error:E=reserved.unwrap_err(); assert(error.allocation()); failed=true; }
        if(!failed) {
            let wanted:i32=1; if(profile==2) { wanted=destination.reserved(); } assert(wanted>0 && wanted<=16);
            let id:i32=1; while(id<=wanted) {
                let stamp:i32=50; if(profile==2) { stamp+=id; }
                mark(66); let made:core::result::Result<T,BuildError> =T::make(id,stamp); mark(98);
                if(made.is_err()) { failed=true; break; } let item:T=made.unwrap();
                mark(80); let inserted:core::result::Result<core::option::Option<T>,E> =destination.try_replace_item(item); mark(112);
                if(inserted.is_err()) { let error:E=inserted.unwrap_err(); assert(error.allocation()); item.release(); failed=true; break; }
                assert(inserted.unwrap().is_none()); setup_count+=1; id+=1;
            }
        }
    }
    if(!failed) {
        mark(65); let made:core::result::Result<alloc::vec::Vec<T>,alloc::vec::Error> =alloc::vec::with_capacity<T>(input_count); mark(97);
        if(made.is_err()) { failed=true; } else { values=made.unwrap(); }
    }
    if(!failed) {
        let index:i32=0; while(index<input_count) {
            mark(66); let made:core::result::Result<T,BuildError> =T::make(input_identity(profile,index),65+index); mark(98);
            if(made.is_err()) { failed=true; break; } values.try_push(made.unwrap()).unwrap(); index+=1;
        }
    }
    if(!failed && (profile==2 || profile==3)) {
        let capacity:i32=1; if(profile==2) { capacity=input_count; }
        mark(72); let made:core::result::Result<alloc::vec::Vec<T>,alloc::vec::Error> =alloc::vec::with_capacity<T>(capacity); mark(104);
        if(made.is_err()) { failed=true; } else { history.values=made.unwrap(); }
    }
    mark(117);
    let source:Input<T> =Input { values:values.take_iter(),audit:audit.borrow() }; values.destroy();
    let forward:Forward<R,T,E> =Forward { actual:destination,audit:audit.borrow() };
    if(failed) {
        state.status=4; state.tag=3; mark(75); cleanup<R,T,E>(destination,source.borrow(),history.borrow(),state.borrow(),false); mark(107);
        let phase:u64=0; while(phase<5) { report<R,T,E>(pid,phase,backend,profile,false,destination,source.borrow(),history.borrow(),state.borrow(),input_count,setup_count); phase+=1; }
        return 4;
    }
    report<R,T,E>(pid,0,backend,profile,true,destination,source.borrow(),history.borrow(),state.borrow(),input_count,setup_count);
    mark(67);
    let zero:core::result::Result<core::iter::ReplacementTransfer,core::iter::ReplacementFailure<T,E,Delivery>> =core::iter::try_replace_up_to<Input<T>,Forward<R,T,E>,History<T>,T,E,Delivery>(source.borrow(),forward.borrow(),history.borrow(),0);
    assert(zero.is_ok() && zero.unwrap().progress.committed==0 && zero.unwrap().progress.replaced==0 && !zero.unwrap().exhausted);
