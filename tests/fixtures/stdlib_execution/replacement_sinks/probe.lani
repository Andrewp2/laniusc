        let destination:alloc::hash_map::HashMap<Key,alloc::string::String> =alloc::hash_map::new<Key,alloc::string::String>();
        return run<alloc::hash_map::HashMap<Key,alloc::string::String>,alloc::hash_map::Entry<Key,alloc::string::String>,alloc::hash_map::Error>(destination.borrow(),backend,profile,pid);
