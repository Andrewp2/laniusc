                assert(state.pending_kind==2);
                let error:core::option::Option<Delivery> =history.try_accept(item);
                if(error.is_some()) { let owned:Delivery=error.unwrap(); owned.check(); assert(owned.kind==2 || owned.kind==3); state.status=4; state.secondary=owned.kind; owned.destroy(); state.pending=core::option::Some(item); }
                else { state.pending_kind=0; }
            }
        }
        if(state.pending.is_none()) {
            let resumed:core::result::Result<core::iter::ReplacementTransfer,core::iter::ReplacementFailure<T,E,Delivery>> =core::iter::try_replace_up_to<Input<T>,Forward<R,T,E>,History<T>,T,E,Delivery>(source.borrow(),forward.borrow(),history.borrow(),18446744073709551615);
            finished=captured<T,E>(resumed,state.borrow(),false);
