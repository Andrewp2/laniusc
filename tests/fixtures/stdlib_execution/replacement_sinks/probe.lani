fn mark(value:u8) { let bytes:[i32;1]=[value as i32]; assert(std::io::write_stderr(core::mem::i32_array_data_ptr(bytes),1)==1); }
fn read(pointer:ptr,count:i32) { let at:i32=0; while(at<count) { let found:i32=std::io::read_stdin(pointer+(at as usize),(count-at) as usize); assert(found>0 && found<=count-at); at+=found; } }
fn word(value:u64) { let bytes:[i32;2]=[(value&4294967295) as i32,(value>>32) as i32]; let at:i32=0; let pointer:ptr=core::mem::i32_array_data_ptr(bytes); while(at<8) { let found:i32=std::io::write_stdout(pointer+(at as usize),(8-at) as usize); assert(found>0 && found<=8-at); at+=found; } }
fn ack() { let bytes:[i32;1]=[0]; read(core::mem::i32_array_data_ptr(bytes),1); assert(bytes[0]==65); }
pub enum BuildError { Allocation }
struct Key { id:i32, representative:i32, text:alloc::string::String }
pub impl core::hash::Hash<Key> for Key { pub fn hash(value:Key) -> u32 { return 1; } }
pub impl core::cmp::Eq<Key> for Key {
    pub fn eq(left:Key,right:Key) -> bool { return left.id==right.id; }
    pub fn ne(left:Key,right:Key) -> bool { return left.id!=right.id; }
}
pub impl core::cmp::Ord<Key> for Key {
    pub fn lt(left:Key,right:Key) -> bool { return left.id<right.id; }
    pub fn le(left:Key,right:Key) -> bool { return left.id<=right.id; }
    pub fn gt(left:Key,right:Key) -> bool { return left.id>right.id; }
    pub fn ge(left:Key,right:Key) -> bool { return left.id>=right.id; }
}
fn text(first:u8) -> core::result::Result<alloc::string::String,BuildError> {
    let bytes:[u8;8]=[first,0,195,169,240,159,153,130];
    let made:core::result::Result<alloc::string::String,alloc::string::Error> =alloc::string::from_utf8(bytes,8);
    if(made.is_err()) { return core::result::Err(BuildError::Allocation); } return core::result::Ok(made.unwrap());
}
fn key(id:i32,representative:i32) -> core::result::Result<Key,BuildError> {
    let made:core::result::Result<alloc::string::String,BuildError> =text(representative as u8);
    if(made.is_err()) { return core::result::Err(made.unwrap_err()); }
    return core::result::Ok(Key { id:id,representative:representative,text:made.unwrap() });
}
fn check_text(value:alloc::string::String,first:u8) {
    let bytes:[u8;8]=[first,0,195,169,240,159,153,130]; assert(value.byte_len()==8 && value.capacity()==8);
    let index:i32=0; while(index<8) { assert(value.byte_at(index).unwrap()==bytes[index]); index+=1; }
}
pub trait Payload<T> {
    pub fn make(id:i32,representative:i32) -> core::result::Result<T,BuildError>;
    pub fn identity(&self) -> i32;
    pub fn stamp(&self) -> i32;
    pub fn key_bytes(&self) -> i32;
    pub fn value_bytes(&self) -> i32;
    pub fn check(&self);
    pub fn release(&self);
}
pub impl Payload<Key> for Key {
    pub fn make(id:i32,representative:i32) -> core::result::Result<Key,BuildError> { return key(id,representative); }
    pub fn identity(&self) -> i32 { return self.id; }
    pub fn stamp(&self) -> i32 { return self.representative; }
    pub fn key_bytes(&self) -> i32 { return self.text.capacity(); }
    pub fn value_bytes(&self) -> i32 { return 0; }
    pub fn check(&self) { check_text(self.text,self.representative as u8); }
    pub fn release(&self) { mark(70); self.text.destroy(); }
}
fn emit_item<T>(item:T) where T:Payload<T> {
    item.check(); word(item.identity() as u64); word(item.stamp() as u64);
    word(item.key_bytes() as u64); word(item.value_bytes() as u64);
}
fn emit_cursor<I,T>(cursor:&I) where I:core::iter::Iterator<T>,T:Payload<T> {
    while(true) { let found:core::option::Option<T> =cursor.next(); if(found.is_none()) { break; } emit_item(found.unwrap()); }
}
fn release_cursor<I,T>(cursor:&I) where I:core::iter::Iterator<T>,T:Payload<T> {
    while(true) { let found:core::option::Option<T> =cursor.next(); if(found.is_none()) { break; } let item:T=found.unwrap(); item.release(); }
}
pub trait StorageError { pub fn allocation(&self) -> bool; }
pub impl StorageError for alloc::hash_map::Error {
    pub fn allocation(&self) -> bool { return match(self) { alloc::hash_map::Error::InvalidCapacity->false,alloc::hash_map::Error::CapacityOverflow->false,alloc::hash_map::Error::AllocationFailed->true }; }
}
pub impl StorageError for alloc::tree_map::Error {
    pub fn allocation(&self) -> bool { return match(self) { alloc::tree_map::Error::InvalidCapacity->false,alloc::tree_map::Error::CapacityOverflow->false,alloc::tree_map::Error::AllocationFailed->true,alloc::tree_map::Error::InvalidOrder->false,alloc::tree_map::Error::InvalidRange->false,alloc::tree_map::Error::NotEmpty->false }; }
}
// Only observation, reserve and cleanup; no replacement algorithm here.
pub trait Store<T,E> {
    pub fn reserve(&self,capacity:i32) -> core::result::Result<i32,E>;
    pub fn count(&self) -> i32;
    pub fn reserved(&self) -> i32;
    pub fn emit(&self);
    pub fn cleanup(&self);
}

pub impl Payload<alloc::hash_map::Entry<Key,alloc::string::String>> for alloc::hash_map::Entry<Key,alloc::string::String> {
    pub fn make(id:i32,representative:i32) -> core::result::Result<alloc::hash_map::Entry<Key,alloc::string::String>,BuildError> {
        let made_key:core::result::Result<Key,BuildError> =key(id,representative);
        if(made_key.is_err()) { return core::result::Err(made_key.unwrap_err()); } let owned_key:Key=made_key.unwrap();
        let made_value:core::result::Result<alloc::string::String,BuildError> =text((representative+32) as u8);
        if(made_value.is_err()) { mark(70); owned_key.text.destroy(); return core::result::Err(made_value.unwrap_err()); }
        return core::result::Ok(alloc::hash_map::Entry { key:owned_key,value:made_value.unwrap() });
    }
    pub fn identity(&self) -> i32 { return self.key.id; }
    pub fn stamp(&self) -> i32 { return self.key.representative; }
    pub fn key_bytes(&self) -> i32 { return self.key.text.capacity(); }
    pub fn value_bytes(&self) -> i32 { return self.value.capacity(); }
    pub fn check(&self) { check_text(self.key.text,self.key.representative as u8); check_text(self.value,(self.key.representative+32) as u8); }
    pub fn release(&self) { mark(70); self.key.text.destroy(); self.value.destroy(); }
}

pub impl Payload<alloc::tree_map::Entry<Key,alloc::string::String>> for alloc::tree_map::Entry<Key,alloc::string::String> {
    pub fn make(id:i32,representative:i32) -> core::result::Result<alloc::tree_map::Entry<Key,alloc::string::String>,BuildError> {
        let made_key:core::result::Result<Key,BuildError> =key(id,representative);
        if(made_key.is_err()) { return core::result::Err(made_key.unwrap_err()); } let owned_key:Key=made_key.unwrap();
        let made_value:core::result::Result<alloc::string::String,BuildError> =text((representative+32) as u8);
        if(made_value.is_err()) { mark(70); owned_key.text.destroy(); return core::result::Err(made_value.unwrap_err()); }
        return core::result::Ok(alloc::tree_map::Entry { key:owned_key,value:made_value.unwrap() });
    }
    pub fn identity(&self) -> i32 { return self.key.id; }
    pub fn stamp(&self) -> i32 { return self.key.representative; }
    pub fn key_bytes(&self) -> i32 { return self.key.text.capacity(); }
    pub fn value_bytes(&self) -> i32 { return self.value.capacity(); }
    pub fn check(&self) { check_text(self.key.text,self.key.representative as u8); check_text(self.value,(self.key.representative+32) as u8); }
    pub fn release(&self) { mark(70); self.key.text.destroy(); self.value.destroy(); }
}

pub impl Store<alloc::hash_map::Entry<Key,alloc::string::String>,alloc::hash_map::Error> for alloc::hash_map::HashMap<Key,alloc::string::String> {
    pub fn reserve(&self,capacity:i32) -> core::result::Result<i32,alloc::hash_map::Error> { return self.try_reserve(capacity); }
    pub fn count(&self) -> i32 { return self.len(); }
    pub fn reserved(&self) -> i32 { return self.capacity(); }
    pub fn emit(&self) {
        let cursor:alloc::hash_map::Iter<Key,alloc::string::String> =self.iter();
        emit_cursor<alloc::hash_map::Iter<Key,alloc::string::String>,alloc::hash_map::Entry<Key,alloc::string::String>>(cursor.borrow());
    }
    pub fn cleanup(&self) {
        let cursor:alloc::hash_map::IntoIter<Key,alloc::string::String> =self.take_iter();
        release_cursor<alloc::hash_map::IntoIter<Key,alloc::string::String>,alloc::hash_map::Entry<Key,alloc::string::String>>(cursor.borrow());
        assert(cursor.try_finish().is_none()); self.destroy();
    }
}

pub impl Store<alloc::tree_map::Entry<Key,alloc::string::String>,alloc::tree_map::Error> for alloc::tree_map::TreeMap<Key,alloc::string::String> {
    pub fn reserve(&self,capacity:i32) -> core::result::Result<i32,alloc::tree_map::Error> { return self.try_reserve(capacity); }
    pub fn count(&self) -> i32 { return self.len(); }
    pub fn reserved(&self) -> i32 { return self.capacity(); }
    pub fn emit(&self) {
        let cursor:alloc::tree_map::Cursor<Key,alloc::string::String> =self.iter();
        emit_cursor<alloc::tree_map::Cursor<Key,alloc::string::String>,alloc::tree_map::Entry<Key,alloc::string::String>>(cursor.borrow());
    }
    pub fn cleanup(&self) {
        let cursor:alloc::tree_map::IntoIter<Key,alloc::string::String> =self.take_iter();
        release_cursor<alloc::tree_map::IntoIter<Key,alloc::string::String>,alloc::tree_map::Entry<Key,alloc::string::String>>(cursor.borrow());
        assert(cursor.try_finish().is_none()); self.destroy();
    }
}

