module app::main;
import alloc::tree_map;
import alloc::tree_set;
import core::option;
import core::ordering;
import core::range;
struct Key { value:i32 }
struct Query { value:i32 }
struct Policy {}
impl Policy { fn borrow(&self) -> &Policy { return self; } }
pub impl core::ordering::Comparator<Query,Key> for Policy { pub fn compare(&self,query:Query,key:Key) -> core::ordering::Ordering { return core::ordering::compare_i32(key.value,query.value); } }
// The stored element comes first; a query-first comparator is rejected.
fn main() -> i32 {
    let set:alloc::tree_set::TreeSet<Key> =alloc::tree_set::new<Key>(); let policy:Policy=Policy {};
    let lower:core::range::Bound<Query> = core::range::Bound::Included(Query { value:1 }); let upper:core::range::Bound<Query> = core::range::Bound::Unbounded;
    let rejected_navigation_bound = set.range_bounds_by<Query,Policy>(lower,upper,policy.borrow());
    return 0;
}
