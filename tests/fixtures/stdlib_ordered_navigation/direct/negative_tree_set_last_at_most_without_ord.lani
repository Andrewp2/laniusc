module app::main;
import alloc::tree_map;
import alloc::tree_set;
import core::option;
import core::ordering;
import core::range;
struct Key { value:i32 }
struct Query { value:i32 }
struct Policy {}
impl Policy { fn borrow(&self) -> &Policy { return self; } }
// Same-key predecessor navigation needs T: Ord.
fn main() -> i32 {
    let set:alloc::tree_set::TreeSet<Key> =alloc::tree_set::new<Key>();
    let rejected_navigation_bound = set.last_at_most(Key { value:1 });
    return 0;
}
