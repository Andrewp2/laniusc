module app::main;
import alloc::tree_map;
import alloc::tree_set;
import core::option;
import core::ordering;
import core::range;
struct Key { value:i32 }
struct Query { value:i32 }
struct Policy {}
impl Policy { fn borrow(&self) -> &Policy { return self; } }
// Same-key bounded ranges compare K values and need K: Ord.
fn main() -> i32 {
    let map:alloc::tree_map::TreeMap<Key,i32> =alloc::tree_map::new<Key,i32>();
    let lower:core::range::Bound<Key> = core::range::Bound::Included(Key { value:1 }); let upper:core::range::Bound<Key> = core::range::Bound::Unbounded;
    let rejected_navigation_bound = map.range_bounds(lower,upper);
    return 0;
}
