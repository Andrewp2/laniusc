// Test-only adapter state/event producer, using production Take and Chain.
module app::main;

import core::io;
import core::mem;
import core::result;
import core::slice;
import std::io;

fn read_exact(pointer: ptr, count: i32, allow_eof: bool) -> bool {
    let done: i32 = 0;
    while (done < count) {
        let got: i32 = std::io::read_stdin(pointer + (done as usize), (count - done) as usize);
        assert(got >= 0);
        if (got == 0) { assert(allow_eof && done == 0); return false; }
        done += got;
    }
    return true;
}

fn write_all(pointer: ptr, count: i32) {
    let done: i32 = 0;
    while (done < count) {
        let got: i32 = std::io::write_stdout(pointer + (done as usize), (count - done) as usize);
        assert(got > 0);
        done += got;
    }
}

fn get64(bytes: [u8], offset: i32) -> u64 {
    let result: u64 = 0;
    let index: i32 = 0;
    while (index < 8) {
        result |= (bytes[offset + index] as u64) << (index * 8);
        index += 1;
    }
    return result;
}

struct Output { bytes: [u8], pointer: ptr, used: i32 }
impl Output {
    fn borrow(&self) -> &Output { return self; }
    fn flush(&self) { write_all(self.pointer, self.used); self.used = 0; }
    fn word(&self, value: u64) {
        if (self.used == 4096) { self.flush(); }
        let index: i32 = 0;
        while (index < 8) {
            self.bytes[self.used + index] = ((value >> (index * 8)) & 255) as u8;
            index += 1;
        }
        self.used += 8;
    }
}

fn code(error:core::io::Error) -> i32 {
    return match(error) { core::io::Error::InvalidInput -> 1, core::io::Error::UnexpectedEof -> 2,
        core::io::Error::WriteZero -> 3,core::io::Error::InvalidCount -> 4,core::io::Error::CountOverflow -> 5,
        core::io::Error::LimitExceeded -> 6,core::io::Error::Interrupted -> 7,core::io::Error::WouldBlock -> 8,
        core::io::Error::AllocationFailed -> 9,core::io::Error::Host(value) -> 10 };
}
fn host(error:core::io::Error) -> i32 { return match(error) { core::io::Error::Host(value) -> value,_ -> 0 }; }
fn provider_error(event:i64,id:i32) -> core::io::Error {
    // Called only for scheduled errors -1 through -12; positive literal
    // patterns are supported by the parser, unary-negative patterns are not.
    let discriminant:i64=-event;
    return match(discriminant) { 1 -> core::io::Error::InvalidInput,2 -> core::io::Error::UnexpectedEof,
        3 -> core::io::Error::WriteZero,4 -> core::io::Error::InvalidCount,5 -> core::io::Error::CountOverflow,
        6 -> core::io::Error::LimitExceeded,7 -> core::io::Error::Interrupted,8 -> core::io::Error::WouldBlock,
        9 -> core::io::Error::AllocationFailed,10 -> core::io::Error::Host(-123-id),
        11 -> core::io::Error::Host(-2147483648),_ -> core::io::Error::Host(2147483647) };
}
struct Log { words:[i64], count:i32 }
impl Log {
    fn borrow(&self) -> &Log { return self; }
    fn event(&self,id:i32,kind:i32,event:i64,offset:i32,count:i32,cursor:i32,fetched:i32) {
        assert(self.count<64); let at:i32=self.count*7;
        self.words[at]=id as i64; self.words[at+1]=kind as i64; self.words[at+2]=event;
        self.words[at+3]=offset as i64; self.words[at+4]=count as i64;
        self.words[at+5]=cursor as i64; self.words[at+6]=fetched as i64; self.count+=1;
    }
}
struct Provider { source:[u8],length:i32,cursor:i32,fetched:i32,id:i32,event:i64,reads:i32,fills:i32,consumes:i32,log:&Log }
impl Provider {
    fn borrow(&self) -> &Provider { return self; }
    fn begin(&self,kind:i32,offset:i32,count:i32) {
        self.log.event(self.id,kind,self.event,offset,count,self.cursor,self.fetched);
    }
}
pub impl core::io::Read for Provider {
    pub fn read(&self,destination:[u8],offset:i32,count:i32) -> core::result::Result<i32,core::io::Error> {
        self.begin(0,offset,count); self.reads+=1;
        if (self.event<0 && self.event>=-12) { return core::result::Err(provider_error(self.event,self.id)); }
        if (self.event==-101) { return core::result::Ok(-1); }
        if (self.event==-102) { return core::result::Ok(count+1); }
        if (self.event==-103) { return core::result::Ok(-2147483648); }
        if (self.event==-104) { return core::result::Ok(2147483647); }
        assert(self.event>=0 && core::io::valid_range(offset,count) && offset<=32-count);
        let amount:i32=self.event as i32;
        if(amount>count) { amount=count; }
        if(amount>self.length-self.cursor) { amount=self.length-self.cursor; }
        let index:i32=0;
        while(index<amount) { destination[offset+index]=self.source[2+self.cursor+index]; index+=1; }
        self.cursor+=amount; if(self.fetched<self.cursor) { self.fetched=self.cursor; }
        return core::result::Ok(amount);
    }
}
pub impl core::io::BufRead for Provider {
    pub fn fill_buf(&self) -> core::result::Result<core::slice::View<u8>,core::io::Error> {
        self.begin(1,0,0); self.fills+=1;
        if(self.event<0 && self.event>=-12) { return core::result::Err(provider_error(self.event,self.id)); }
        let view:core::slice::View<u8> = core::slice::View { values:self.source,start:2+self.cursor,length:self.fetched-self.cursor };
        if(self.event==-101) { view.start=-1; view.length=1; }
        if(self.event==-102) { view.start=2; view.length=-1; }
        if(self.event==-103) { view.start=2147483647; view.length=1; }
        if(self.event==-104) { view.start=-1; view.length=0; }
        if(self.event==-105) { view.start=2147483647; view.length=0; }
        if(self.event>=0) {
            if(self.fetched==self.cursor) {
                let amount:i32=self.event as i32;
                if(amount>self.length-self.fetched) { amount=self.length-self.fetched; }
                self.fetched+=amount;
            }
            view.length=self.fetched-self.cursor;
        }
        return core::result::Ok(view);
    }
    pub fn consume(&self,count:i32) -> core::result::Result<i32,core::io::Error> {
        self.begin(2,0,count); self.consumes+=1;
        if(self.event<0 && self.event>=-12) { return core::result::Err(provider_error(self.event,self.id)); }
        if(self.event==-101) { return core::result::Ok(-1); }
        if(self.event==-102) { return core::result::Ok(count+1); }
        if(self.event==-103) { return core::result::Ok(count-1); }
        if(self.event==-104) { return core::result::Ok(-2147483648); }
        if(count<0 || count>self.fetched-self.cursor) { return core::result::Err(core::io::Error::InvalidInput); }
        self.cursor+=count; return core::result::Ok(count);
    }
}
fn failure(error:core::io::Error,output:&Output) {
    output.word(1); output.word(code(error) as u64); output.word(host(error) as i64 as u64);
    output.word(0); output.word(0); output.word(0); output.word(0); output.word(0);
}
fn success(value:u64,output:&Output) {
    output.word(0); output.word(0); output.word(0); output.word(value);
    output.word(0); output.word(0); output.word(0); output.word(0);
}
fn number(result:core::result::Result<i32,core::io::Error>,output:&Output) {
    if(result.is_err()) { failure(result.unwrap_err(),output); return; }
    success(result.unwrap() as i64 as u64,output);
}
fn quota(result:core::result::Result<u64,core::io::Error>,output:&Output) {
    if(result.is_err()) { failure(result.unwrap_err(),output); return; }
    success(result.unwrap(),output);
}
fn operate<R>(reader:&R,operation:i32,offset:i32,count:i32,destination:[u8],output:&Output) where R:core::io::Read,R:core::io::BufRead {
    if(operation==0) { number(reader.read(destination,offset,count),output); }
    if(operation==2) { number(reader.consume(count),output); }
    if(operation==1) {
        let result:core::result::Result<core::slice::View<u8>,core::io::Error> = reader.fill_buf();
        if(result.is_err()) { failure(result.unwrap_err(),output); return; }
        let view:core::slice::View<u8> = result.unwrap();
        assert(core::io::valid_range(view.start,view.length) && view.length<=16);
        output.word(0); output.word(0); output.word(0); output.word(0);
        output.word(view.start as u64); output.word(view.length as u64);
        output.word(core::mem::slice_stride(view.values) as i64 as u64); output.word(view.length as u64);
        let index:i32=0; while(index<view.length) { output.word(view.get(index).unwrap() as u64); index+=1; }
    }
}
fn provider_state(provider:&Provider,output:&Output) {
    output.word(provider.cursor as u64); output.word(provider.fetched as u64);
    output.word(provider.reads as u64); output.word(provider.fills as u64); output.word(provider.consumes as u64);
}
fn bytes(values:[u8],output:&Output) { let index:i32=0; while(index<32) { output.word(values[index] as u64); index+=1; } }
fn run(input:[u8],output:&Output) {
    let kind:i32=get64(input,0) as i32; let layout:u64=get64(input,8);
    let a_native:[u8;32]=[0;32]; let b_native:[u8;32]=[0;32]; let d_native:[u8;32]=[0;32];
    let a_words:[i32;8]=[0;8]; let b_words:[i32;8]=[0;8]; let d_words:[i32;8]=[0;8];
    let a:[u8]=a_native; let b:[u8]=b_native; let destination:[u8]=d_native;
    if((layout&1)!=0) { a=core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(a_words),32); }
    if((layout&2)!=0) { b=core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(b_words),32); }
    if((layout&4)!=0) { destination=core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(d_words),32); }
    output.word(core::mem::slice_stride(a) as i64 as u64); output.word(core::mem::slice_stride(b) as i64 as u64);
    output.word(core::mem::slice_stride(destination) as i64 as u64);
    let index:i32=0;
    while(index<32) { a[index]=(128+index) as u8; b[index]=(160+index) as u8; destination[index]=(192+index) as u8; index+=1; }
    let length_a:i32=get64(input,16) as i32; let length_b:i32=get64(input,24) as i32;
    index=0; while(index<length_a) { a[2+index]=((index*37+13)&255) as u8; index+=1; }
    index=0; while(index<length_b) { b[2+index]=((index*53+201)&255) as u8; index+=1; }
    let log_words:[i64;448]=[0;448]; let log:Log=Log { words:log_words,count:0 };
    let first:Provider=Provider { source:a,length:length_a,cursor:0,fetched:0,id:0,event:0,reads:0,fills:0,consumes:0,log:log.borrow() };
    let second:Provider=Provider { source:b,length:length_b,cursor:0,fetched:0,id:1,event:0,reads:0,fills:0,consumes:0,log:log.borrow() };
    let left:core::io::Take<Provider> = core::io::take<Provider>(first.borrow(),get64(input,32));
    let right:core::io::Take<Provider> = core::io::take<Provider>(second.borrow(),get64(input,40));
    let joined:core::io::Chain<Provider,Provider> = core::io::chain<Provider,Provider>(first.borrow(),second.borrow());
    let capped:core::io::Take<core::io::Chain<Provider,Provider>> = core::io::take<core::io::Chain<Provider,Provider>>(joined.borrow(),get64(input,48));
    let limits:core::io::Chain<core::io::Take<Provider>,core::io::Take<Provider>> = core::io::chain<core::io::Take<Provider>,core::io::Take<Provider>>(left.borrow(),right.borrow());
    assert(log.count==0); index=0;
    while(index<get64(input,56) as i32) {
        let at:i32=64+index*48; let operation:i32=get64(input,at) as i32;
        let offset:i32=get64(input,at+8) as i32; let count:i32=get64(input,at+16) as i32;
        first.event=get64(input,at+32) as i64; second.event=get64(input,at+40) as i64;
        let before:i32=log.count;
        if(operation==3) {
            if(offset==0) { quota(left.set_limit(get64(input,at+24)),output); }
            if(offset==1) { quota(right.set_limit(get64(input,at+24)),output); }
            if(offset==2) { quota(capped.set_limit(get64(input,at+24)),output); }
        } else {
            if(kind==0) { operate<core::io::Take<Provider>>(left.borrow(),operation,offset,count,destination,output); }
            if(kind==1) { operate<core::io::Chain<Provider,Provider>>(joined.borrow(),operation,offset,count,destination,output); }
            if(kind==2) { operate<core::io::Take<core::io::Chain<Provider,Provider>>>(capped.borrow(),operation,offset,count,destination,output); }
            if(kind==3) { operate<core::io::Chain<core::io::Take<Provider>,core::io::Take<Provider>>>(limits.borrow(),operation,offset,count,destination,output); }
        }
        output.word(left.limit()); output.word(left.is_faulted() as u64); output.word(right.limit()); output.word(right.is_faulted() as u64);
        output.word(joined.is_first_done() as u64); output.word(joined.is_faulted() as u64);
        output.word(capped.limit()); output.word(capped.is_faulted() as u64);
        output.word(limits.is_first_done() as u64); output.word(limits.is_faulted() as u64);
        provider_state(first.borrow(),output); provider_state(second.borrow(),output);
        bytes(destination,output); bytes(a,output); bytes(b,output);
        output.word((log.count-before) as u64);
        let call:i32=before*7; while(call<log.count*7) { output.word(log.words[call] as u64); call+=1; }
        index+=1;
    }
}
fn main() -> i32 {
    let input_words:[i32;400]=[0;400]; let pointer:ptr=core::mem::i32_array_data_ptr(input_words);
    let input:[u8]=core::mem::typed_slice_from_raw_parts<u8>(pointer,1600);
    let output_words:[i32;1024]=[0;1024]; let output_pointer:ptr=core::mem::i32_array_data_ptr(output_words);
    let output:Output=Output { bytes:core::mem::typed_slice_from_raw_parts<u8>(output_pointer,4096),pointer:output_pointer,used:0 };
    while(read_exact(pointer,64,true)) {
        assert(get64(input,0)<=3 && get64(input,8)<=7 && get64(input,16)<=16 && get64(input,24)<=16 && get64(input,56)<=32);
        assert(read_exact(pointer+64,(get64(input,56)*48) as i32,false)); run(input,output.borrow());
    }
    output.flush(); return 0;
}
