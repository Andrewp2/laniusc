struct Unary { calls:i32, log:[i32], delimiter:u8 }
impl Unary { fn borrow(&self) -> &Unary { return self; } }
pub impl core::iter::Mapper<u8,bool> for Unary { pub fn apply(&self,value:u8) -> bool { self.log[self.calls+1]=value as i32; self.calls+=1; return value==self.delimiter; } }
struct Adjacent { calls:i32, left:[i32], right:[i32], mode:i32 }
impl Adjacent { fn borrow(&self) -> &Adjacent { return self; } }
pub impl core::iter::Mapper<core::pair::Pair<u8,u8>,bool> for Adjacent {
    pub fn apply(&self,values:core::pair::Pair<u8,u8>) -> bool { self.left[self.calls+1]=values.first as i32; self.right[self.calls+1]=values.second as i32; self.calls+=1; if(self.mode==0) { return values.first==values.second; } return values.second as i32==(values.first as i32)+1; }
}
fn view(values:[u8],start:i32,length:i32) -> core::slice::View<u8> { return core::slice::View { values:values,start:start,length:length }; }
fn pull<I>(source:&I,original:core::slice::View<u8>,start:i32,length:i32) where I:core::iter::Iterator<core::slice::View<u8>> {
    let item:core::option::Option<core::slice::View<u8>> =source.next(); assert(item.is_some()); let value:core::slice::View<u8> =item.unwrap(); assert(value.start==original.start+start && value.length==length && core::mem::slice_stride(value.values)==core::mem::slice_stride(original.values));
    let i:i32=0; while(i<length) { assert(value.values[value.start+i]==original.values[original.start+start+i]); i+=1; }
}
fn ended<I,T>(source:&I) where I:core::iter::Iterator<core::slice::View<T>> {
    let i:i32=0; while(i<3) { let value:core::option::Option<core::slice::View<T>> =source.next(); assert(match(value) { core::option::None -> true,_ -> false }); i+=1; }
}
