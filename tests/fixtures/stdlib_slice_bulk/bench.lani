// core::slice bulk operations against the element loops they replaced. Each
// phase moves 64 MiB in 4 KiB rounds, the workload of
// tests/fixtures/compiler_defects/slice_byte_copy_cost.lani. Layouts: packed
// bytes (Vec<u8>), one-word u64 (Vec<u64>), and the native [u8; 4096]
// array the defect fixture copies (one word per byte). stdout: a
// "layout phase" line, then its nanoseconds; results are checked so no
// phase can be optimized into nothing. bench.cpp runs the same phases with
// memcpy, memset, std::swap_ranges, memchr, memcmp and vector::insert.
module app::main;
import alloc::vec;
import core::mem;
import core::slice;
import core::time;
import std::clock;
import std::io;

fn now() -> core::time::Instant { return std::clock::monotonic_now().unwrap(); }
fn since(start: core::time::Instant) -> u64 { return now().duration_since(start).unwrap().as_nanos().unwrap(); }
fn emit_number(value: u64) {
    let storage: [i32; 8] = [0; 8]; let base: ptr = core::mem::i32_array_data_ptr(storage);
    let digits: [u8] = core::mem::typed_slice_from_raw_parts<u8>(base, 24);
    let n: i32 = 23; let v: u64 = value; digits[n] = 10;
    if (v == 0) { n -= 1; digits[n] = 48; }
    while (v > 0) { n -= 1; digits[n] = ((v % 10) as u8) + 48; v = v / 10; }
    assert(std::io::write_stdout(base + (n as usize), (24 - n) as usize) == 24 - n);
    assert(storage[5] == storage[5]);
}
// Two lines per phase: "layout phase", then the nanoseconds.
fn report(label: str, start: core::time::Instant) {
    let nanos: u64 = since(start);
    assert(std::io::println(label) >= 0);
    emit_number(nanos);
}

fn loop_copy<T>(to: [T], from: [T], count: i32) {
    let index: i32 = 0;
    while (index < count) { to[index] = from[index]; index += 1; }
}
fn loop_fill<T>(to: [T], count: i32, value: T) {
    let index: i32 = 0;
    while (index < count) { to[index] = value; index += 1; }
}
fn loop_find(values: [u8], count: i32, needle: u8) -> i32 {
    let index: i32 = 0;
    while (index < count) { if (values[index] == needle) { return index; } index += 1; }
    return -1;
}
fn loop_compare(left: [u8], right: [u8], count: i32) -> i32 {
    let index: i32 = 0;
    while (index < count) {
        if (left[index] != right[index]) { if (left[index] < right[index]) { return -1; } return 1; }
        index += 1;
    }
    return 0;
}

fn bytes(n: i32, seed: i32) -> alloc::vec::Vec<u8> {
    let v: alloc::vec::Vec<u8> = alloc::vec::new(); v.try_resize(n, 0).unwrap();
    let s: [u8] = v.as_slice(); let i: i32 = 0;
    while (i < n) { s[i] = ((i * 7 + seed) & 127) as u8; i += 1; }
    return v;
}

fn main() -> i32 {
    let rounds: i32 = 16384; let n: i32 = 4096; let check: i32 = 0;
    let va: alloc::vec::Vec<u8> = bytes(n, 1); let vb: alloc::vec::Vec<u8> = bytes(n, 2);
    let a: [u8] = va.as_slice(); let b: [u8] = vb.as_slice();

    let start: core::time::Instant = now(); let r: i32 = 0;
    while (r < rounds) { loop_copy(b, a, n); r += 1; }
    report("u8 copy_loop", start); check += b[4095] as i32;
    start = now(); r = 0;
    while (r < rounds) { core::slice::copy_from_slice(b, n, a, n); r += 1; }
    report("u8 copy_from_slice", start); check += b[4095] as i32;

    start = now(); r = 0;
    while (r < rounds) { loop_fill(b, n, r as u8); r += 1; }
    report("u8 fill_loop", start); check += b[17] as i32;
    start = now(); r = 0;
    while (r < rounds) { core::slice::fill(b, n, r as u8); r += 1; }
    report("u8 fill", start); check += b[17] as i32;

    start = now(); r = 0;
    while (r < rounds) { core::slice::swap_with_slice(a, n, b, n); r += 1; }
    report("u8 swap_with_slice", start); check += a[9] as i32;

    a[4000] = 255;
    start = now(); r = 0;
    while (r < rounds) { check += loop_find(a, n, 255); r += 1; }
    report("u8 find_loop", start);
    start = now(); r = 0;
    while (r < rounds) { check += core::slice::memchr(a, n, 255); r += 1; }
    report("u8 memchr", start);

    core::slice::copy_from_slice(b, n, a, n); b[4090] = 0;
    start = now(); r = 0;
    while (r < rounds) { check += loop_compare(a, b, n); r += 1; }
    report("u8 compare_loop", start);
    start = now(); r = 0;
    while (r < rounds) { check += core::slice::memcmp(a, b, n); r += 1; }
    report("u8 memcmp", start);

    start = now(); r = 0;
    let grown: alloc::vec::Vec<u8> = alloc::vec::new();
    while (r < rounds) { let i: i32 = 0; while (i < n) { grown.try_push(a[i]).unwrap(); i += 1; } r += 1; }
    report("u8 push_loop", start); check += grown.len() >> 20; grown.destroy();
    start = now(); r = 0;
    while (r < rounds) { grown.try_extend_from_slice(a, n).unwrap(); r += 1; }
    report("u8 extend_from_slice", start); check += grown.len() >> 20; grown.destroy();

    let wa: alloc::vec::Vec<u64> = alloc::vec::new(); wa.try_resize(512, 3).unwrap();
    let wb: alloc::vec::Vec<u64> = alloc::vec::new(); wb.try_resize(512, 4).unwrap();
    let x: [u64] = wa.as_slice(); let y: [u64] = wb.as_slice();
    start = now(); r = 0;
    while (r < rounds) { loop_copy(y, x, 512); r += 1; }
    report("u64 copy_loop", start); check += y[511] as i32;
    start = now(); r = 0;
    while (r < rounds) { core::slice::copy_from_slice(y, 512, x, 512); r += 1; }
    report("u64 copy_from_slice", start); check += y[511] as i32;
    start = now(); r = 0;
    while (r < rounds) { loop_fill(y, 512, r as u64); r += 1; }
    report("u64 fill_loop", start); check += y[5] as i32;
    start = now(); r = 0;
    while (r < rounds) { core::slice::fill(y, 512, r as u64); r += 1; }
    report("u64 fill", start); check += y[5] as i32;

    let na: [u8; 4096] = [7; 4096]; let nb: [u8; 4096] = [0; 4096];
    start = now(); r = 0;
    while (r < rounds) { loop_copy(nb, na, n); r += 1; }
    report("array copy_loop", start); check += nb[3] as i32;
    nb[3] = 0;
    start = now(); r = 0;
    while (r < rounds) { core::slice::copy_from_slice(nb, n, na, n); r += 1; }
    report("array copy_from_slice", start); check += nb[3] as i32;

    if (check == 0) { return 1; }
    return 0;
}
