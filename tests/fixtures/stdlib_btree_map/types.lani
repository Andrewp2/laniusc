// alloc::btree_map over every integer width, bool, char, ordered f32, owned
// strings, records (as values and, with their own Ord, as keys) and
// zero-sized keys and values. Exit 0, or the number of the failing check.
module app::main;
import alloc::btree_map;
import alloc::string;
import core::cmp;
import core::float_order;
import core::option;
import core::result;
fn keys<T>(low: T, high: T) -> bool where T: core::cmp::Ord<T> {
    let map: alloc::btree_map::BTreeMap<T, bool> = alloc::btree_map::new();
    core::result::unwrap(map.try_insert(high, true)); core::result::unwrap(map.try_insert(low, false));
    if (core::option::unwrap(map.get(low)) || !core::option::unwrap(map.get(high))) { return false; }
    let first: alloc::btree_map::Entry<T, bool> = core::option::unwrap(map.pop_first());
    if (first.value || T::lt(first.key, low) || T::lt(low, first.key)) { return false; }
    let last: alloc::btree_map::Entry<T, bool> = core::option::unwrap(map.pop_last());
    let ok: bool = last.value && !T::lt(last.key, high) && !T::lt(high, last.key) && map.is_empty() && map.first().is_none();
    map.destroy(); return ok;
}
fn values<T>(low: T, high: T) -> bool where T: core::cmp::Eq<T> {
    let map: alloc::btree_map::BTreeMap<i32, T> = alloc::btree_map::new();
    core::result::unwrap(map.try_insert(2, low)); core::result::unwrap(map.try_insert(1, high));
    let old: alloc::btree_map::Entry<i32, T> = core::option::unwrap(core::result::unwrap(map.try_insert(2, high)));
    let first: alloc::btree_map::Entry<i32, T> = core::option::unwrap(map.pop_first());
    let last: alloc::btree_map::Entry<i32, T> = core::option::unwrap(map.remove(2));
    let ok: bool = T::eq(old.value, low) && T::eq(first.value, high) && T::eq(last.value, high) && map.is_empty(); map.destroy(); return ok;
}
fn both<T>(low: T, high: T) -> bool where T: core::cmp::Ord<T>, T: core::cmp::Eq<T> { return keys(low, high) && values(low, high); }
struct Payload { wide: u64, mark: core::option::Option<bool>, bytes: [u8; 3] }
struct Identity { order: i32, id: i32 }
pub impl core::cmp::Ord<Identity> for Identity {
    pub fn lt(a: Identity, b: Identity) -> bool { return a.order < b.order; }
    pub fn le(a: Identity, b: Identity) -> bool { return a.order <= b.order; }
    pub fn gt(a: Identity, b: Identity) -> bool { return a.order > b.order; }
    pub fn ge(a: Identity, b: Identity) -> bool { return a.order >= b.order; }
}
struct Unit {}
pub impl core::cmp::Ord<Unit> for Unit {
    pub fn lt(a: Unit, b: Unit) -> bool { return false; }
    pub fn le(a: Unit, b: Unit) -> bool { return true; }
    pub fn gt(a: Unit, b: Unit) -> bool { return false; }
    pub fn ge(a: Unit, b: Unit) -> bool { return true; }
}
fn main() -> i32 {
    if (!both(-128 as i8, 127 as i8) || !both(0 as u8, 255 as u8)) { return 1; }
    if (!both(-32768 as i16, 32767 as i16) || !both(0 as u16, 65535 as u16)) { return 2; }
    let u32max: u32 = 4294967295;
    if (!both(-2147483648 as i32, 2147483647 as i32) || !both(0 as u32, u32max)) { return 3; }
    let low: i64 = -9223372036854775808; let high: i64 = 9223372036854775807; let unsigned: u64 = 18446744073709551615;
    if (!both(low, high) || !both(0 as u64, unsigned) || !both(low as isize, high as isize) || !both(0 as usize, unsigned as usize)) { return 4; }
    let fl: core::float_order::TotalF32 = core::float_order::from_f32(-1.5); let fh: core::float_order::TotalF32 = core::float_order::from_f32(3.25);
    if (!both(false, true) || !both('a', '😀') || !both(fl, fh)) { return 5; }
    let ab: [u8; 1] = [97]; let bb: [u8; 2] = [195, 169];
    let a: alloc::string::String = core::result::unwrap(alloc::string::from_utf8(ab, 1));
    let b: alloc::string::String = core::result::unwrap(alloc::string::from_utf8(bb, 2));
    if (!both(a, b)) { return 6; } a.destroy(); b.destroy();
    // 600 record values: several leaf splits and merges.
    let records: alloc::btree_map::BTreeMap<i32, Payload> = alloc::btree_map::new(); let index: i32 = 0;
    while (index < 600) {
        let bytes: [u8; 3] = [index as u8, 128, 255];
        let item: Payload = Payload { wide: (index as u64) * 4294967297, mark: core::option::Some(index % 2 == 0), bytes: bytes };
        core::result::unwrap(records.try_insert(599 - index, item)); index += 1;
    }
    index = 0;
    while (index < 600) {
        let entry: alloc::btree_map::Entry<i32, Payload> = core::option::unwrap(records.pop_last()); let item: Payload = entry.value;
        if (entry.key != 599 - index || item.wide != (index as u64) * 4294967297 || core::option::unwrap(item.mark) != (index % 2 == 0) || item.bytes[0] != index as u8 || item.bytes[1] != 128 || item.bytes[2] != 255) { return 7; }
        index += 1;
    }
    records.destroy();
    // Equivalent keys replace the stored key too.
    let identities: alloc::btree_map::BTreeMap<Identity, bool> = alloc::btree_map::new();
    core::result::unwrap(identities.try_insert(Identity { order: 7, id: 1 }, false));
    let replaced: alloc::btree_map::Entry<Identity, bool> = core::option::unwrap(core::result::unwrap(identities.try_insert(Identity { order: 7, id: 2 }, true)));
    let stored: alloc::btree_map::Entry<Identity, bool> = core::option::unwrap(identities.get_entry(Identity { order: 7, id: 999 }));
    if (identities.len() != 1 || replaced.key.id != 1 || replaced.value || stored.key.id != 2 || !stored.value) { return 8; }
    // Record keys across splits, in descending insertion order.
    index = 0;
    while (index < 500) { core::result::unwrap(identities.try_insert(Identity { order: 1000 - index, id: index }, index % 3 == 0)); index += 1; }
    let walk: alloc::btree_map::Cursor<Identity, bool> = identities.iter(); let previous: i32 = -1; let seen: i32 = 0;
    while (!walk.is_empty()) {
        let entry: alloc::btree_map::Entry<Identity, bool> = core::option::unwrap(walk.next());
        if (entry.key.order <= previous) { return 9; } previous = entry.key.order; seen += 1;
        if (entry.key.order > 500 && entry.value != ((1000 - entry.key.order) % 3 == 0)) { return 10; }
    }
    if (seen != 501) { return 11; } identities.destroy();
    // Zero-sized keys and values.
    let units: alloc::btree_map::BTreeMap<Unit, Unit> = alloc::btree_map::new();
    if (core::option::is_some(core::result::unwrap(units.try_insert(Unit {}, Unit {})))) { return 12; }
    if (core::option::is_none(core::result::unwrap(units.try_insert(Unit {}, Unit {}))) || units.len() != 1 || core::option::is_none(units.pop_first())) { return 13; } units.destroy();
    let set: alloc::btree_map::BTreeMap<u64, Unit> = alloc::btree_map::new(); index = 0;
    while (index < 5000) { core::result::unwrap(set.try_insert(((index as u64) * 2654435761) % 5003, Unit {})); index += 1; }
    if (set.len() != 5000 || !set.contains_key(0) || set.contains_key(5003)) { return 14; }
    let span: alloc::btree_map::Cursor<u64, Unit> = core::result::unwrap(set.range(100, 200)); let count: i32 = 0;
    while (span.next().is_some()) { count += 1; }
    if (count < 90 || count > 100) { return 15; }
    index = 0;
    while (index < 5000) { if (set.remove(((index as u64) * 2654435761) % 5003).is_none()) { return 16; } index += 1; }
    if (!set.is_empty()) { return 17; } set.destroy();
    return 0;
}
