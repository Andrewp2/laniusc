fn run(header:[u8],input:[u8],pointer:ptr,out:&fixture::wire::Output) {
    let route:i32=fixture::wire::get(header,8) as i32; let direction:i32=fixture::wire::get(header,16) as i32;
    let capacity:i32=fixture::wire::get(header,24) as i32; let steps:i32=fixture::wire::get(header,32) as i32;
    assert(route>=0 && route<3 && direction>=0 && direction<2 && capacity>0 && capacity<=7 && steps<=32);
    let native_scratch:[u8;32]=[0;32]; let native_argument:[u8;32]=[0;32];
    let packed_scratch:[i32;8]=[0;8]; let packed_argument:[i32;8]=[0;8];
    let scratch:[u8]=native_scratch; let argument:[u8]=native_argument; let base:i32=3;
    if(route==1) { scratch=core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(packed_scratch),32); argument=core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(packed_argument),32); base=5; }
    let i:i32=0; while(i<32) { scratch[i]=(197+i*3) as u8; i+=1; }
    let data:[u8;128]=[0;128]; i=0; while(i<128) { data[i]=(i*37+11) as u8; i+=1; }
    let calls:[i32;4]=[0;4]; let tape:[u64;512]=[0;512]; let limit:u64=19; if(direction==1) { limit=128; }
    let peer:fixture::wire::Peer=fixture::wire::Peer { data:data,position:0,limit:limit,calls:calls,tape:tape,used:0,events:0,transfers:0,seeks:0,action:fixture::wire::action(input) };
    if(route<2) {
        if(direction==0) { borrowed_reader(peer.borrow(),scratch,argument,base,capacity,steps,input,pointer,out); }
        else { borrowed_writer(peer.borrow(),scratch,argument,base,capacity,steps,input,pointer,out); }
    } else {
        if(direction==0) { owned_reader(peer.borrow(),scratch,argument,0,capacity,steps,input,pointer,out); }
        else { owned_writer(peer.borrow(),scratch,argument,0,capacity,steps,input,pointer,out); }
    }
}
fn main() -> i32 {
    let header_words:[i32;10]=[0;10]; let header_pointer:ptr=core::mem::i32_array_data_ptr(header_words); let header:[u8]=core::mem::typed_slice_from_raw_parts<u8>(header_pointer,40);
    let input_words:[i32;20]=[0;20]; let pointer:ptr=core::mem::i32_array_data_ptr(input_words); let input:[u8]=core::mem::typed_slice_from_raw_parts<u8>(pointer,80);
    let output_words:[i32;1024]=[0;1024]; let output_pointer:ptr=core::mem::i32_array_data_ptr(output_words);
    let output:fixture::wire::Output=fixture::wire::Output { bytes:core::mem::typed_slice_from_raw_parts<u8>(output_pointer,4096),pointer:output_pointer,used:0 };
    fixture::wire::read_exact(header_pointer,16); assert(fixture::wire::get(header,0)==7094689377966782001);
    let count:i32=fixture::wire::get(header,8) as i32; assert(count==144); output.word(fixture::wire::get(header,0)); output.word(count as u64);
    let index:i32=0; while(index<count) {
        fixture::wire::read_exact(header_pointer,40); let i:i32=0; while(i<5) { output.word(fixture::wire::get(header,i*8)); i+=1; }
        run(header,input,pointer,output.borrow()); index+=1;
    }
    output.word(7308889619308111409); output.flush(); return 0;
}
