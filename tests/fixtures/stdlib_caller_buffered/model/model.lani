// Execute scripted actions through the real public APIs; serialize every effect.
module app::main;
import alloc::buffered;
import alloc::vec;
import core::buffered;
import core::io;
import core::mem;
import core::result;
import core::slice;
import fixture::wire;

fn begin(input:[u8],pointer:ptr,step:i32,argument:[u8],peer:&fixture::wire::Peer,out:&fixture::wire::Output) -> fixture::wire::Action {
    fixture::wire::read_exact(pointer,80); out.word(step as u64);
    let i:i32=0; while(i<10) { out.word(fixture::wire::get(input,i*8)); i+=1; }
    i=0; while(i<32) { argument[i]=(i*29+step*41+17) as u8; i+=1; }
    let a:fixture::wire::Action=fixture::wire::action(input); peer.reset(a); return a;
}
fn tail(peer:&fixture::wire::Peer,argument:[u8],backing:[u8],length:i32,out:&fixture::wire::Output) {
    peer.state(out); out.word(core::mem::slice_stride(argument) as u64); out.bytes(argument,0,32);
    out.word(length as u64); out.bytes(backing,0,length);
}

fn borrowed_reader(peer:&fixture::wire::Peer,scratch:[u8],argument:[u8],base:i32,capacity:i32,steps:i32,input:[u8],pointer:ptr,out:&fixture::wire::Output) {
    let selected:core::slice::View<u8> =core::slice::View { values:scratch,start:base,length:capacity };
    let stream:core::buffered::Reader<fixture::wire::Peer> =core::buffered::reader<fixture::wire::Peer>(peer,selected).unwrap();
    let parts:core::buffered::Parts<fixture::wire::Peer> =core::buffered::Parts { inner:peer,buffer:core::slice::View { values:scratch,start:0,length:0 },start:0,length:0,faulted:false };
    let step:i32=0;
    while(step<steps) {
        let a:fixture::wire::Action=begin(input,pointer,step,argument,peer,out);
        let reply:fixture::wire::Reply=fixture::wire::success(0,argument);
        let extra_start:i32=0; let extra_length:i32=0; let extra_capacity:i32=0; let extra_fault:bool=false;
        if(a.op==0) { reply=fixture::wire::number(stream.read(argument,a.offset,a.count),argument); }
        if(a.op==1) { reply=fixture::wire::filled(stream.fill_buf(),argument); }
        if(a.op==2) { reply=fixture::wire::number(stream.consume(a.count),argument); }
        if(a.op==5) { reply=fixture::wire::position(stream.seek(fixture::wire::seek(a)),argument); }
        if(a.op==6) {
            let taken:core::result::Result<core::buffered::Parts<fixture::wire::Peer>,core::io::Error> =stream.take_parts();
            if(taken.is_err()) { reply=fixture::wire::failure(taken.unwrap_err(),argument); } else { parts=taken.unwrap(); }
        }
        if(a.op==7) {
            let restored:core::result::Result<core::buffered::Reader<fixture::wire::Peer>,core::io::Error> =core::buffered::reader_from_parts<fixture::wire::Peer>(parts.borrow());
            if(restored.is_err()) { reply=fixture::wire::failure(restored.unwrap_err(),argument); } else { stream=restored.unwrap(); }
        }
        if(a.op==8) {
            let saved_start:i32=parts.start; let saved_length:i32=parts.length;
            if(a.aux==0) { parts.start=-1; }
            if(a.aux==1) { parts.start=0; parts.length=capacity+1; }
            if(a.aux==2) { parts.start=capacity; parts.length=1; }
            let rejected:core::result::Result<core::buffered::Reader<fixture::wire::Peer>,core::io::Error> =core::buffered::reader_from_parts<fixture::wire::Peer>(parts.borrow());
            assert(rejected.is_err()); reply=fixture::wire::failure(rejected.unwrap_err(),argument);
            extra_start=parts.start; extra_length=parts.length; extra_capacity=parts.buffer.length; extra_fault=parts.faulted;
            parts.start=saved_start; parts.length=saved_length;
        }
        if(a.op==9) { reply=fixture::wire::success(stream.discard() as u64,argument); }
        if(a.op==10) { reply=fixture::wire::success(parts.discard() as u64,argument); }
        if(a.op==12) { assert(!stream.is_active() && parts.buffer.length==0); stream=core::buffered::reader<fixture::wire::Peer>(peer,selected).unwrap(); }
        peer.emit(out); fixture::wire::reply(reply,out);
        if(a.op==8) { out.word(4); out.word(extra_start as i64 as u64); out.word(extra_length as i64 as u64); out.word(extra_capacity as u64); out.word(extra_fault as u64); } else { out.word(0); }
        out.word(stream.is_active() as u64); out.word(stream.is_faulted() as u64); out.word(stream.capacity() as u64); out.view(stream.buffered());
        out.word(parts.buffer.length as u64); out.word(parts.start as i64 as u64); out.word(parts.length as i64 as u64); out.word(parts.faulted as u64); out.view(parts.bytes());
        tail(peer,argument,scratch,32,out);
        step+=1;
    }
    stream.discard(); parts.discard();
}

