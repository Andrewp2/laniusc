    assert(reader.read(destination,4,0).unwrap()==0 && peer.calls==0); assert(fixture::probe::cause(reader.read(destination,-1,0).unwrap_err())==4 && peer.calls==0);
    fixture::probe::bytes(reader.fill_buf().unwrap(),2,3,1971210); fixture::probe::bytes(reader.fill_buf().unwrap(),2,3,1971210); assert(peer.calls==1);
    assert(fixture::probe::cause(reader.consume(4).unwrap_err())==4 && fixture::probe::cause(reader.consume(-1).unwrap_err())==4 && peer.calls==1); assert(reader.consume(1).unwrap()==1);
