        assert(fixture::probe::cause(reader.read(destination,1,1).unwrap_err())==code && input.calls==1 && !reader.is_faulted() && reader.is_active() && reader.buffered().length==0); assert(destination[0]==155 && destination[1]==155 && destination[2]==155); assert(reader.read(destination,1,1).unwrap()==1 && destination[1]==11 && input.calls==2); assert(reader.discard()==0); let stride:isize=core::mem::slice_stride(scratch); fixture::probe::event(input.borrow(),0,1,1,3,stride,0,0,0); fixture::probe::event(input.borrow(),1,1,1,3,stride,0,0,0); input.tail();
