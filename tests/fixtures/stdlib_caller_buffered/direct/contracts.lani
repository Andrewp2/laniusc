    assert(reader.fill_buf().unwrap().length==0 && peer.calls==2 && reader.consume(0).unwrap()==0 && peer.calls==2); fixture::probe::bytes(reader.fill_buf().unwrap(),2,2,12840); assert(peer.calls==3); assert(reader.read(destination,3,1).unwrap()==1 && destination[3]==40 && peer.calls==3); assert(reader.consume(1).unwrap()==1);
    assert(reader.read(destination,4,2).unwrap()==1 && destination[4]==60 && destination[5]==199 && peer.calls==4); assert(reader.discard()==0 && !reader.is_active());
    let stride:isize=core::mem::slice_stride(scratch); fixture::probe::event(peer.borrow(),0,1,2,3,stride,0,0,0); fixture::probe::event(peer.borrow(),1,1,2,3,stride,0,3,0); fixture::probe::event(peer.borrow(),2,1,2,3,stride,0,3,0); fixture::probe::event(peer.borrow(),3,1,2,3,stride,0,5,0); peer.tail();
