        assert(fixture::probe::cause(writer.write(source,0,1).unwrap_err())==code && sink.calls==1 && !writer.is_faulted()); fixture::probe::bytes(writer.pending(),1,3,2168331); assert(fixture::probe::cause(writer.finish().unwrap_err())==code && sink.calls==3 && writer.is_active() && !writer.is_faulted() && writer.pending().length==0); assert(writer.finish().unwrap()==0 && sink.calls==4 && !writer.is_active()); assert(output[0]==11 && output[1]==22 && output[2]==33 && output[3]==199); fixture::probe::event(sink.borrow(),0,2,1,3,stride,2168331,0,0); fixture::probe::event(sink.borrow(),1,2,1,3,stride,2168331,0,0); let zero:isize=0; fixture::probe::event(sink.borrow(),2,3,0,0,zero,0,3,0); fixture::probe::event(sink.borrow(),3,3,0,0,zero,0,3,0); sink.tail();
