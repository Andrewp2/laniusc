module app::main;
import alloc::buffered;
import core::buffered;
import core::io;
import core::result;
import core::slice;
import fixture::resource;
fn main() -> i32 {
    let source=fixture::resource::owner(8,0); fixture::resource::initialize(source.borrow());
    let scratch=fixture::resource::owner(9,177); let address:ptr=scratch.storage;
    let input=fixture::resource::stream(source.as_slice(),8,5);
    let destination:[u8;10]=[199;10];
    fixture::resource::mark(80);
    let reader=core::buffered::reader(input.borrow(),core::slice::View { values:scratch.as_slice(),start:2,length:5 }).unwrap();
    assert(reader.read(destination,1,1).unwrap()==1 && input.position==5 && input.reads==1 && reader.buffered().length==4);
    fixture::resource::mark(112);
    // Only this reached owning constructor is denied. The live borrowed
    // provider already retains unread bytes and its caller owner stays live.
    let first=alloc::buffered::reader(reader.borrow(),3);
    if(first.is_err()) { assert(fixture::resource::allocation_failed(first.unwrap_err())); }
    else { let unused=first.unwrap(); assert(unused.discard()==0); }
    assert(reader.is_active() && !reader.is_faulted() && reader.capacity()==5 && reader.buffered().start==3 && reader.buffered().length==4);
    assert(input.position==5 && input.reads==1 && scratch.storage==address && scratch.len()==9 && scratch.capacity()==9);
    let i:i32=0; while(i<4) { assert(reader.buffered().get(i).unwrap()==fixture::resource::pattern(i+1)); i+=1; }
    fixture::resource::guards(scratch.borrow(),2,5,177);
    fixture::resource::mark(82);
    let retry=alloc::buffered::reader(reader.borrow(),3).unwrap();
    fixture::resource::mark(80);
    assert(input.reads==1 && reader.buffered().length==4 && retry.buffered().length==0);
    assert(core::io::read_exact(retry.borrow(),destination,2,7).unwrap()==7);
    assert(input.position==8 && input.reads==2 && reader.buffered().length==0 && retry.buffered().length==0);
    i=0; while(i<8) { assert(destination[i+1]==fixture::resource::pattern(i) && source.at(i)==fixture::resource::pattern(i)); i+=1; }
    assert(destination[0]==199 && destination[9]==199 && scratch.storage==address);
    fixture::resource::guards(scratch.borrow(),2,5,177);
    fixture::resource::mark(112);
    assert(retry.discard()==0 && reader.is_active() && reader.discard()==0);
    scratch.destroy(); source.destroy(); fixture::resource::mark(68); return 0;
}
