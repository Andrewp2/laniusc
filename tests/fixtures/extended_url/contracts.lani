// ext::url API contracts that the url-parse command line does not show:
// null versus empty query and fragment, port helpers, host kinds, clones,
// bounds and length checks. Exits with the number of the first failed check.
module app::main;
import alloc::vec;
import core::mem;
import core::option;
import core::result;
import core::slice;
import ext::idna;
import ext::url;

fn bytes(value: str, n: i32) -> core::slice::View<u8> { let raw: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::string_data_ptr(value),n); return core::slice::view(raw,n).unwrap(); }
fn equal(a: core::slice::View<u8>, b: core::slice::View<u8>) -> bool { if (a.length != b.length) { return false; } let i: i32 = 0; while (i < a.length) { if (a.values[a.start+i] != b.values[b.start+i]) { return false; } i += 1; } return true; }
fn is(a: core::slice::View<u8>, value: str, n: i32) -> bool { return equal(a,bytes(value,n)); }
fn must(value: str, n: i32) -> ext::url::Url { return ext::url::parse(bytes(value,n)).unwrap(); }
fn error_is(result: core::result::Result<ext::url::Url, ext::url::Error>, code: i32) -> bool {
    if (result.is_ok()) { let url: ext::url::Url = result.unwrap(); url.destroy(); return false; }
    let found: i32 = match (result.unwrap_err()) {
        ext::url::Error::Bounds -> 1, ext::url::Error::TooLong -> 2, ext::url::Error::InvalidUtf8 -> 3, ext::url::Error::AllocationFailed -> 4,
        ext::url::Error::MissingScheme -> 5, ext::url::Error::MissingHost -> 6, ext::url::Error::InvalidHost -> 7, ext::url::Error::InvalidPort -> 8,
        ext::url::Error::InvalidIpv4 -> 9, ext::url::Error::InvalidIpv6 -> 10, ext::url::Error::UnsupportedIdna -> 11, ext::url::Error::InvalidIdna -> 12
    };
    return found == code;
}
fn kind(url: &ext::url::Url) -> i32 {
    return match (url.host_kind()) {
        ext::url::HostKind::None -> 0, ext::url::HostKind::Empty -> 1, ext::url::HostKind::Domain -> 2, ext::url::HostKind::Ipv4 -> 3,
        ext::url::HostKind::Ipv6 -> 4, ext::url::HostKind::Opaque -> 5
    };
}

fn idna_error(domain: core::slice::View<u8>) -> i32 {
    let out: alloc::vec::Vec<u8> = alloc::vec::new();
    let result: core::result::Result<i32, ext::idna::Error> = ext::idna::to_ascii(domain,out.borrow()); out.destroy();
    if (result.is_ok()) { return 0; }
    return match (result.unwrap_err()) {
        ext::idna::Error::Bounds -> 1, ext::idna::Error::TooLong -> 2, ext::idna::Error::InvalidUtf8 -> 3, ext::idna::Error::Disallowed(v) -> 1000000 + (v as i32),
        ext::idna::Error::InvalidPunycode -> 5, ext::idna::Error::InvalidAce -> 6, ext::idna::Error::LeadingMark -> 7, ext::idna::Error::Joiner -> 8,
        ext::idna::Error::Bidi -> 9, ext::idna::Error::UnsupportedJoiner -> 10, ext::idna::Error::Normalization -> 11, ext::idna::Error::AllocationFailed -> 12
    };
}
fn status_is(value: u32, code: i32) -> bool {
    let found: i32 = match (ext::idna::status(value)) {
        ext::idna::Status::Valid -> 0, ext::idna::Status::Mapped -> 1, ext::idna::Status::Ignored -> 2, ext::idna::Status::Deviation -> 3, ext::idna::Status::Disallowed -> 4
    };
    return found == code;
}
// ext::idna: statuses, the RFC 3492 sample (L), round trips and every error.
fn idna_contracts() -> i32 {
    if (!status_is(97,0) || !status_is(65,1) || !status_is(173,2) || !status_is(223,3) || !status_is(65533,4) || !status_is(1114112,4)) { return 40; }
    let scalars: alloc::vec::Vec<u32> = alloc::vec::new();
    if (ext::idna::punycode_decode(bytes("3B-ww4c5e180e575a65lsy2b",24),scalars.borrow()).unwrap() != 8) { return 41; }
    if (scalars.at(0) != 51 || scalars.at(1) != 24180 || scalars.at(2) != 66 || scalars.at(3) != 32068 || scalars.at(7) != 29983) { return 42; }
    let ascii: alloc::vec::Vec<u8> = alloc::vec::new();
    if (ext::idna::punycode_encode(scalars.as_view(),ascii.borrow()).unwrap() != 24 || !is(ascii.as_view(),"3B-ww4c5e180e575a65lsy2b",24)) { return 43; }
    if (ext::idna::punycode_decode(bytes("a-9",3),scalars.borrow()).is_ok() || ext::idna::punycode_decode(bytes("99999999999",11),scalars.borrow()).is_ok()) { return 44; }
    if (ext::idna::to_ascii(bytes("BÜCHER.ß.。",14),ascii.borrow()).unwrap() != 23 || !is(ascii.as_view(),"xn--bcher-kva.xn--zca..",23)) { return 45; }
    if (ext::idna::to_ascii(bytes("XN--A.Example",13),ascii.borrow()).unwrap() != 13 || !is(ascii.as_view(),"xn--a.example",13)) { return 46; }
    if (idna_error(bytes("́a",3)) != 7 || idna_error(bytes("a‍b",5)) != 8 || idna_error(bytes("אa",3)) != 9) { return 47; }
    if (idna_error(bytes("xn--a.ü",8)) != 6 || idna_error(bytes("xn--zz!.ü",10)) != 5 || idna_error(bytes("︒",3)) != 1065042) { return 48; }
    if (idna_error(bytes("ب‌ب",7)) != 10 || idna_error(bytes("a‌ب",6)) != 8) { return 49; }
    let bad: [u8;2] = [195,40]; if (idna_error(core::slice::view(bad,2).unwrap()) != 3) { return 50; }
    let long: alloc::vec::Vec<u8> = alloc::vec::new(); let i: i32 = 0;
    while (i < 8192) { long.try_push(195 as u8); long.try_push(169 as u8); i += 1; }
    if (idna_error(long.as_view()) != 0) { return 51; }
    long.try_push(97 as u8); if (idna_error(long.as_view()) != 2) { return 52; }
    if (idna_error(core::slice::View { values: long.as_view().values, start: -1, length: 2 }) != 1) { return 53; }
    long.destroy(); scalars.destroy(); ascii.destroy();
    return 0;
}

fn main() -> i32 {
    let idna_status: i32 = idna_contracts(); if (idna_status != 0) { return idna_status; }
    // Null and empty query and fragment are distinct; search and hash hide both.
    let a: ext::url::Url = must("http://h/p?#",12);
    if (!a.query().is_some() || a.query().unwrap().length != 0 || !a.fragment().is_some() || a.fragment().unwrap().length != 0) { return 1; }
    if (a.search().length != 0 || a.hash().length != 0 || !is(a.href_without_fragment(),"http://h/p?",11)) { return 2; }
    let b: ext::url::Url = must("http://h/p",10);
    if (b.query().is_some() || b.fragment().is_some() || !is(b.href_without_fragment(),"http://h/p",10)) { return 3; }
    let c: ext::url::Url = must("https://h:8443/x?q=1#top",24);
    if (!is(c.query().unwrap(),"q=1",3) || !is(c.fragment().unwrap(),"top",3) || !is(c.search(),"?q=1",4) || !is(c.hash(),"#top",4)) { return 4; }
    // Ports: the default port is elided and reported as -1.
    if (c.port_number() != 8443 || c.port_or_default() != 8443 || !is(c.port(),"8443",4) || !is(c.host(),"h:8443",6)) { return 5; }
    let d: ext::url::Url = must("https://h:443/",14);
    if (d.port_number() != -1 || d.port_or_default() != 443 || d.port().length != 0 || !is(d.href(),"https://h/",10)) { return 6; }
    let e: ext::url::Url = must("sc://h:0/",9);
    if (e.port_number() != 0 || e.port_or_default() != 0 || must("sc://h/",7).port_or_default() != -1) { return 7; }
    if (ext::url::default_port(bytes("ws",2)) != 80 || ext::url::default_port(bytes("wss",3)) != 443 || ext::url::default_port(bytes("ftp",3)) != 21
        || ext::url::default_port(bytes("file",4)) != -1 || ext::url::default_port(bytes("HTTP",4)) != -1) { return 8; }
    // Host kinds, opaque paths and special schemes.
    if (kind(must("http://[::1]/",13).borrow()) != 4 || kind(must("http://0x7f.1/",14).borrow()) != 3 || kind(must("http://a.b/",11).borrow()) != 2) { return 9; }
    if (kind(must("sc://a.b/",9).borrow()) != 5 || kind(must("file:///x",9).borrow()) != 1 || kind(must("sc:x",4).borrow()) != 0 || kind(must("sc://",5).borrow()) != 1) { return 10; }
    let o: ext::url::Url = must("mailto:a@b",10);
    if (!o.has_opaque_path() || o.is_special() || !is(o.pathname(),"a@b",3) || c.has_opaque_path() || !c.is_special()) { return 11; }
    // A base can be reused and cloned; the clone outlives the original.
    let base: ext::url::Url = must("http://u:p@h/a/b?q#f",20);
    let copy: ext::url::Url = base.try_clone().unwrap(); base.destroy();
    let r1: ext::url::Url = ext::url::parse_with_base(bytes("../c",4),copy.borrow()).unwrap();
    let r2: ext::url::Url = ext::url::parse_with_base(bytes("#g",2),copy.borrow()).unwrap();
    if (!is(r1.href(),"http://u:p@h/c",14) || !is(r2.href(),"http://u:p@h/a/b?q#g",20) || !is(copy.href(),"http://u:p@h/a/b?q#f",20)) { return 12; }
    if (!is(r1.username(),"u",1) || !is(r1.password(),"p",1)) { return 13; }
    // Origins.
    let origin: alloc::vec::Vec<u8> = c.origin().unwrap(); if (!is(origin.as_view(),"https://h:8443",14)) { return 14; } origin.destroy();
    let opaque_origin: alloc::vec::Vec<u8> = must("file:///x",9).origin().unwrap(); if (!is(opaque_origin.as_view(),"null",4)) { return 15; }
    // can_parse and errors.
    if (!ext::url::can_parse(bytes("a:b",3)) || ext::url::can_parse(bytes("b",1)) || ext::url::can_parse(bytes("",0))) { return 16; }
    let bad: [u8;3] = [104,58,255];
    if (!error_is(ext::url::parse(core::slice::view(bad,3).unwrap()),3)) { return 17; }
    let surrogate: [u8;5] = [104,58,237,160,128];
    if (!error_is(ext::url::parse(core::slice::view(surrogate,5).unwrap()),3)) { return 18; }
    let raw: core::slice::View<u8> = bytes("http://h/",9);
    if (!error_is(ext::url::parse(core::slice::View { values: raw.values, start: -1, length: 3 }),1)) { return 19; }
    if (!error_is(ext::url::parse(core::slice::View { values: raw.values, start: 0, length: ext::url::MAX_INPUT_BYTES + 1 }),2)) { return 20; }
    if (!error_is(ext::url::parse(bytes("http://h:65536/",15)),8) || !error_is(ext::url::parse(bytes("http://h:1x/",12)),8)) { return 21; }
    if (!error_is(ext::url::parse(bytes("http://ب‌ب/",15)),11) || !error_is(ext::url::parse(bytes("http://︒/",11)),12)) { return 22; }
    let idn: ext::url::Url = must("http://%C3%A9.xn--zca/",22);
    if (!is(idn.hostname(),"xn--9ca.xn--zca",15) || kind(idn.borrow()) != 2) { return 27; }
    idn.destroy();
    if (!error_is(ext::url::parse(bytes("http:",5)),6) || !error_is(ext::url::parse(bytes("http://u@/",10)),6)) { return 23; }
    if (!error_is(ext::url::parse_with_base(bytes("x",1),o.borrow()),5)) { return 24; }
    // The span accessors partition the href.
    let f: ext::url::Url = must("ws://us:pw@[::ffff:1.2.3.4]:81/a?b#c",36);
    if (!is(f.href(),"ws://us:pw@[::ffff:102:304]:81/a?b#c",36) || !is(f.protocol(),"ws:",3) || !is(f.hostname(),"[::ffff:102:304]",16)) { return 25; }
    if (!is(f.scheme(),"ws",2) || !is(f.host(),"[::ffff:102:304]:81",19) || !is(f.pathname(),"/a",2)) { return 26; }
    a.destroy(); b.destroy(); c.destroy(); d.destroy(); e.destroy(); o.destroy(); copy.destroy(); r1.destroy(); r2.destroy(); f.destroy();
    return 0;
}
