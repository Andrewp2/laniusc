// Deterministic public contracts for a borrowed generic Read/Write transport.
// No sockets, TLS, entropy, native libraries, or duplicate frame encoder.
module app::main;
import core::io;
import core::mem;
import core::option;
import core::result;
import core::slice;
import ext::websocket;
import ext::websocket_stream;
import ext::websocket_upgrade;

fn bytes(value: str, count: i32) -> core::slice::View<u8> {
    let raw: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::string_data_ptr(value),count);
    return core::slice::view(raw,count).unwrap();
}
fn same(left: core::slice::View<u8>, right: core::slice::View<u8>) -> bool {
    if (left.len()!=right.len()) { return false; }
    let index: i32=0;
    while (index<left.len()) {
        if (left.get(index).unwrap()!=right.get(index).unwrap()) { return false; }
        index+=1;
    }
    return true;
}
fn empty() -> core::slice::View<u8> { return bytes("",0); }
fn request() -> core::slice::View<u8> {
    return bytes("GET /chat HTTP/1.1\r\nHost: server.example.com\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: chat, superchat\r\nSec-WebSocket-Extensions: permessage-deflate\r\n\r\n",248);
}
fn response() -> core::slice::View<u8> {
    return bytes("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\nSec-WebSocket-Protocol: chat\r\n\r\n",159);
}
fn accept() -> core::slice::View<u8> { return bytes("s3pPLMBiTxaQ9kYGzzhZRbK+xOo=",28); }

// One-shot blocks/interrupts name actual call ordinals. Persistent bad modes
// deliberately violate the trait count contract or return a native error.
// Buffers belong to each calling test, and out-of-range reads are impossible.
struct Script {
    input: core::slice::View<u8>, position: i32,
    output: [u8], output_length: i32,
    read_width: i32, write_width: i32,
    read_calls: i32, write_calls: i32, flush_calls: i32, flushed: i32,
    read_block: i32, write_block: i32, flush_block: i32,
    read_interrupt: i32, write_interrupt: i32, flush_interrupt: i32,
    read_mode: i32, write_mode: i32, flush_mode: i32,
    require_flush: bool
}
fn script(input: core::slice::View<u8>, output: [u8]) -> Script {
    return Script { input:input,position:0,output:output,output_length:0,
        read_width:1024,write_width:1024,
        read_calls:0,write_calls:0,flush_calls:0,flushed:0,
        read_block:0,write_block:0,flush_block:0,
        read_interrupt:0,write_interrupt:0,flush_interrupt:0,
        read_mode:0,write_mode:0,flush_mode:0,require_flush:false };
}
impl Script {
    fn borrow(&self) -> &Script { return self; }
    fn calls(&self) -> i32 { return self.read_calls+self.write_calls+self.flush_calls; }
    fn written(&self) -> core::slice::View<u8> { return core::slice::view(self.output,self.output_length).unwrap(); }
}
pub impl core::io::Read for Script {
    pub fn read(&self, destination:[u8], offset:i32, count:i32) -> core::result::Result<i32,core::io::Error> {
        assert(count>0 && core::io::valid_range(offset,count));
        if (self.require_flush) { assert(self.flushed>0 && self.output_length==248); }
        self.read_calls+=1;
        if (self.read_calls==self.read_block) { return core::result::Err(core::io::Error::WouldBlock); }
        if (self.read_calls==self.read_interrupt) { return core::result::Err(core::io::Error::Interrupted); }
        if (self.read_mode==1) { return core::result::Ok(count+1); }
        if (self.read_mode==2) { return core::result::Ok(-1); }
        if (self.read_mode==3) { return core::result::Err(core::io::Error::Host(55)); }
        let amount:i32=self.input.len()-self.position;
        if (amount>self.read_width) { amount=self.read_width; }
        if (amount>count) { amount=count; }
        let index:i32=0;
        while (index<amount) { destination[offset+index]=self.input.get(self.position+index).unwrap(); index+=1; }
        self.position+=amount; return core::result::Ok(amount);
    }
}
pub impl core::io::Write for Script {
    pub fn write(&self, source:[u8], offset:i32, count:i32) -> core::result::Result<i32,core::io::Error> {
        assert(count>0 && core::io::valid_range(offset,count)); self.write_calls+=1;
        if (self.write_calls==self.write_block) { return core::result::Err(core::io::Error::WouldBlock); }
        if (self.write_calls==self.write_interrupt) { return core::result::Err(core::io::Error::Interrupted); }
        if (self.write_mode==1) { return core::result::Ok(count+1); }
        if (self.write_mode==2) { return core::result::Ok(-1); }
        if (self.write_mode==3) { return core::result::Err(core::io::Error::Host(55)); }
        if (self.write_mode==4) { return core::result::Ok(0); }
        let amount:i32=count; if (amount>self.write_width) { amount=self.write_width; }
        assert(self.output_length+amount<=4096);
        let index:i32=0;
        while (index<amount) { self.output[self.output_length+index]=source[offset+index]; index+=1; }
        self.output_length+=amount; return core::result::Ok(amount);
    }
    pub fn flush(&self) -> core::result::Result<i32,core::io::Error> {
        self.flush_calls+=1;
        if (self.flush_calls==self.flush_block) { return core::result::Err(core::io::Error::WouldBlock); }
        if (self.flush_calls==self.flush_interrupt) { return core::result::Err(core::io::Error::Interrupted); }
        if (self.flush_mode==1) { return core::result::Ok(1); }
        if (self.flush_mode==2) { return core::result::Ok(-1); }
        if (self.flush_mode==3) { return core::result::Err(core::io::Error::Host(55)); }
        self.flushed+=1; return core::result::Ok(0);
    }
}

fn io_code(error:core::io::Error) -> i32 {
    return match(error) {
        core::io::Error::InvalidCount -> 1,
        core::io::Error::WriteZero -> 2,
        core::io::Error::UnexpectedEof -> 3,
        core::io::Error::Host(code) -> 100+code,
        _ -> 0
    };
}
fn wire_code(error:ext::websocket::Error) -> i32 {
    return match(error) {
        ext::websocket::Error::Closed -> 1,
        ext::websocket::Error::Failed -> 2,
        ext::websocket::Error::UncleanEof -> 3,
        ext::websocket::Error::FragmentedEof -> 4,
        ext::websocket::Error::Protocol(at) -> 5,
        ext::websocket::Error::InvalidUtf8(at) -> 6,
        ext::websocket::Error::Handshake -> 7,
        _ -> 0
    };
}
fn stream_code(failure:ext::websocket_stream::Failure) -> i32 {
    return match(failure.cause) {
        ext::websocket_stream::Cause::Bounds -> 1,
        ext::websocket_stream::Cause::InvalidLimits -> 2,
        ext::websocket_stream::Cause::Inactive -> 3,
        ext::websocket_stream::Cause::PendingWrite -> 4,
        ext::websocket_stream::Cause::BufferLimit -> 5,
        ext::websocket_stream::Cause::ReadLimit -> 6,
        ext::websocket_stream::Cause::WriteLimit -> 7,
        ext::websocket_stream::Cause::IoLimit -> 8,
        ext::websocket_stream::Cause::UnexpectedEof -> 9,
        ext::websocket_stream::Cause::Io(error) -> 100+io_code(error),
        ext::websocket_stream::Cause::Wire(error) -> 1000+wire_code(error),
        _ -> 0
    };
}
fn upgrade_code(failure:ext::websocket_upgrade::Failure) -> i32 {
    return match(failure.cause) {
        ext::websocket_upgrade::Cause::Bounds -> 1,
        ext::websocket_upgrade::Cause::InvalidLimits -> 2,
        ext::websocket_upgrade::Cause::Inactive -> 3,
        ext::websocket_upgrade::Cause::NotReady -> 4,
        ext::websocket_upgrade::Cause::RequestLimit -> 5,
        ext::websocket_upgrade::Cause::BufferLimit -> 6,
        ext::websocket_upgrade::Cause::ReadLimit -> 7,
        ext::websocket_upgrade::Cause::IoLimit -> 8,
        ext::websocket_upgrade::Cause::Io(error) -> 100+io_code(error),
        ext::websocket_upgrade::Cause::Wire(error) -> 1000+wire_code(error),
        ext::websocket_upgrade::Cause::Http(error) -> 2000,
        ext::websocket_upgrade::Cause::Stream(error) -> 3000+stream_code(error),
        _ -> 0
    };
}
fn event_code(event:ext::websocket::Event) -> i32 {
    return match(event) {
        ext::websocket::Event::Pending -> 0, ext::websocket::Event::Text -> 1,
        ext::websocket::Event::Binary -> 2, ext::websocket::Event::Ping -> 9,
        ext::websocket::Event::Pong -> 10, ext::websocket::Event::Close -> 8
    };
}
fn receive(stream:&ext::websocket_stream::Stream<Script>, event:i32, expected:core::slice::View<u8>) {
    let step:ext::websocket::Step=stream.receive().unwrap().unwrap();
    assert(event_code(step.event)==event && same(step.payload,expected));
}
fn receive_error(stream:&ext::websocket_stream::Stream<Script>, code:i32) {
    let result=stream.receive(); assert(result.is_err()); assert(stream_code(result.unwrap_err())==code);
}
fn drive(client:&ext::websocket_upgrade::Client<Script>, transport:&Script) {
    let turns:i32=0;
    while (!client.is_ready() && turns<2000) {
        let calls:i32=transport.calls(); let progress=client.step(); assert(progress.is_ok());
        assert(transport.calls()-calls<=1); turns+=1;
    }
    assert(client.is_ready() && turns<2000);
    assert(client.stats().io_calls==(transport.calls() as u64));
}

// Construct/destroy must need no I/O trait at all.
struct Opaque { marker:i32 }
impl Opaque { fn borrow(&self) -> &Opaque { return self; } }
fn constructors() {
    let opaque:Opaque=Opaque { marker:91 };
    let stream=ext::websocket_stream::new(opaque.borrow(),ext::websocket::Role::Client,empty(),ext::websocket_stream::default_limits()).unwrap();
    assert(stream.is_active() && stream.stats().io_calls==0 && stream.destroy() && !stream.destroy());
    let client=ext::websocket_upgrade::client(opaque.borrow(),request(),accept(),ext::websocket_upgrade::default_limits()).unwrap();
    assert(client.is_active() && !client.is_ready() && client.stats().io_calls==0);
    assert(upgrade_code(client.response().unwrap_err())==4);
    assert(upgrade_code(client.into_stream(ext::websocket_stream::default_limits()).unwrap_err())==4);
    assert(client.destroy() && !client.destroy() && opaque.marker==91);
    let bad:core::slice::View<u8> =empty(); bad.start=-1;
    assert(stream_code(ext::websocket_stream::new(opaque.borrow(),ext::websocket::Role::Client,bad,ext::websocket_stream::default_limits()).unwrap_err())==1);
    let small:ext::websocket_stream::Limits=ext::websocket_stream::default_limits(); small.buffer_bytes=13;
    assert(stream_code(ext::websocket_stream::new(opaque.borrow(),ext::websocket::Role::Client,empty(),small).unwrap_err())==2);
    small.buffer_bytes=14;
    assert(stream_code(ext::websocket_stream::new(opaque.borrow(),ext::websocket::Role::Client,bytes("123456789012345",15),small).unwrap_err())==5);
    assert(upgrade_code(ext::websocket_upgrade::client(opaque.borrow(),bad,accept(),ext::websocket_upgrade::default_limits()).unwrap_err())==1);
    let cap:ext::websocket_upgrade::Limits=ext::websocket_upgrade::default_limits(); cap.request_bytes=247;
    assert(upgrade_code(ext::websocket_upgrade::client(opaque.borrow(),request(),accept(),cap).unwrap_err())==5);
    cap=ext::websocket_upgrade::default_limits(); cap.buffer_bytes=0;
    assert(upgrade_code(ext::websocket_upgrade::client(opaque.borrow(),request(),accept(),cap).unwrap_err())==2);
    assert(upgrade_code(ext::websocket_upgrade::client(opaque.borrow(),request(),bytes("bad",3),ext::websocket_upgrade::default_limits()).unwrap_err())==1007);
    assert(upgrade_code(ext::websocket_upgrade::client(opaque.borrow(),empty(),accept(),ext::websocket_upgrade::default_limits()).unwrap_err())!=0);
}

fn handshake_copy_and_handoff() {
    let input:[u8;163]=[0;163]; let index:i32=0;
    while (index<159) { input[index]=response().get(index).unwrap(); index+=1; }
    input[159]=129; input[160]=2; input[161]=111; input[162]=107;
    let output:[u8;4096]=[199;4096];
    let transport:Script=script(core::slice::view(input,163).unwrap(),output); transport.require_flush=true;
    let owned_request:[u8;248]=[0;248]; index=0;
    while (index<248) { owned_request[index]=request().get(index).unwrap(); index+=1; }
    let owned_accept:[u8;28]=[0;28]; index=0;
    while (index<28) { owned_accept[index]=accept().get(index).unwrap(); index+=1; }
    let client=ext::websocket_upgrade::client(transport.borrow(),core::slice::view(owned_request,248).unwrap(),core::slice::view(owned_accept,28).unwrap(),ext::websocket_upgrade::default_limits()).unwrap();
    assert(transport.calls()==0); index=0;
    while (index<248) { owned_request[index]=0; index+=1; }
    index=0; while (index<28) { owned_accept[index]=0; index+=1; }
    drive(client.borrow(),transport.borrow());
    assert(same(transport.written(),request()) && transport.read_calls==1 && transport.flush_calls==1);
    let parsed:ext::websocket::Response=client.response().unwrap();
    assert(parsed.head.status==101 && same(parsed.protocol.unwrap(),bytes("chat",4)));
    assert(parsed.remaining.len()==4 && parsed.remaining.get(0).unwrap()==129);
    let calls:i32=transport.calls();
    let repeat:i32=0; while (repeat<3) { assert(match(client.step().unwrap()) { ext::websocket_upgrade::Progress::Ready -> true, _ -> false }); repeat+=1; }
    assert(transport.calls()==calls);
    let invalid:ext::websocket_stream::Limits=ext::websocket_stream::default_limits(); invalid.buffer_bytes=13;
    assert(upgrade_code(client.into_stream(invalid).unwrap_err())==3002 && client.is_ready());
    assert(client.response().unwrap().remaining.len()==4 && transport.calls()==calls);
    let stream=client.into_stream(ext::websocket_stream::default_limits()).unwrap();
    assert(!client.is_active() && !client.destroy());
    assert(upgrade_code(client.response().unwrap_err())==3);
    assert(upgrade_code(client.step().unwrap_err())==3);
    // All earlier Response views expire here. Use only Stream-owned bytes.
    receive(stream.borrow(),1,bytes("ok",2)); assert(transport.calls()==calls && stream.stats().read_bytes==0);
    transport.read_block=transport.read_calls+1;
    assert(stream.receive().unwrap().is_none());
    assert(stream.stats().frames_received==1 && stream.stats().io_calls==1);
    let before:i32=transport.calls(); assert(stream.destroy() && !stream.destroy()); assert(transport.calls()==before);
    assert(transport.position==163 && output[248]==199);
}

fn fragmented_handshake() {
    let output:[u8;4096]=[199;4096]; let transport:Script=script(response(),output);
    transport.read_width=1; transport.write_width=7; transport.require_flush=true;
    transport.read_block=2; transport.read_interrupt=3;
    transport.write_block=2; transport.write_interrupt=3;
    transport.flush_block=1; transport.flush_interrupt=2;
    let limits:ext::websocket_upgrade::Limits=ext::websocket_upgrade::default_limits(); limits.work=512;
    let client=ext::websocket_upgrade::client(transport.borrow(),request(),accept(),limits).unwrap();
    let need_read:i32=0; let need_write:i32=0; let turns:i32=0;
    while (!client.is_ready() && turns<600) {
        let before:i32=transport.calls(); let progress=client.step().unwrap();
        if (match(progress) { ext::websocket_upgrade::Progress::NeedRead -> true, _ -> false }) { need_read+=1; }
        if (match(progress) { ext::websocket_upgrade::Progress::NeedWrite -> true, _ -> false }) { need_write+=1; }
        assert(transport.calls()-before<=1); turns+=1;
    }
    assert(client.is_ready() && need_read==1 && need_write==2);
    assert(transport.read_calls==161 && transport.flush_calls==3);
    assert(transport.output_length==248 && same(transport.written(),request()));
    assert(client.stats().accepted_bytes==248 && client.stats().read_bytes==159);
    assert(client.stats().io_calls==(transport.calls() as u64) && client.stats().work>0 && client.stats().work<=512);
    assert(same(client.response().unwrap().protocol.unwrap(),bytes("chat",4)));
    let calls:i32=transport.calls(); assert(client.destroy() && !client.destroy() && calls==transport.calls());
}

fn prefetched_fragments_and_close() {
    // U+20AC split across Text/Continuation, with Ping interleaved; then Close.
    let frames:[u8;14]=[1,1,226,137,1,120,128,2,130,172,136,2,3,232];
    let output:[u8;4096]=[199;4096]; let transport:Script=script(empty(),output);
    let stream=ext::websocket_stream::new(transport.borrow(),ext::websocket::Role::Client,core::slice::view(frames,14).unwrap(),ext::websocket_stream::default_limits()).unwrap();
    frames[0]=255; frames[1]=255; // Prefetch is independently copied.
    receive(stream.borrow(),0,empty()); receive(stream.borrow(),9,bytes("x",1));
    let euro:[u8;3]=[226,130,172]; receive(stream.borrow(),1,core::slice::view(euro,3).unwrap());
    let closing:ext::websocket::Step=stream.receive().unwrap().unwrap();
    assert(event_code(closing.event)==8 && closing.close_code==1000);
    assert(stream.close_received() && !stream.close_sent() && !stream.is_closed());
    receive_error(stream.borrow(),1001); assert(transport.calls()==0);
    let close:[u8;2]=[3,232]; let key:[u8;4]=[1,2,3,4];
    assert(stream.send(true,8,core::slice::view(close,2).unwrap(),key).unwrap()==8);
    assert(!stream.close_sent() && !stream.is_closed() && transport.calls()==0);
    transport.flush_block=1;
    assert(!stream.flush().unwrap());
    assert(stream.pending().len()==0 && !stream.close_sent() && !stream.is_closed());
    assert(stream_code(stream.send(true,10,empty(),key).unwrap_err())==4);
    assert(stream.flush().unwrap() && stream.close_sent() && stream.is_closed());
    assert(transport.write_calls==1 && transport.flush_calls==2 && stream.stats().frames_sent==1);
    let expected:[u8;8]=[136,130,1,2,3,4,2,234];
    assert(same(transport.written(),core::slice::view(expected,8).unwrap()));
    let calls:i32=transport.calls(); assert(stream.flush().unwrap() && calls==transport.calls());
    assert(stream.stats().frames_received==4 && stream.stats().read_bytes==0);
    assert(stream.destroy() && !stream.destroy() && calls==transport.calls());
}

fn partial_frames() {
    let frames:[u8;9]=[130,3,0,255,9,137,2,111,107];
    let output:[u8;4096]=[199;4096]; let transport:Script=script(core::slice::view(frames,9).unwrap(),output);
    transport.read_width=1; transport.read_block=3; transport.read_interrupt=2;
    let stream=ext::websocket_stream::new(transport.borrow(),ext::websocket::Role::Client,empty(),ext::websocket_stream::default_limits()).unwrap();
    assert(stream.receive().unwrap().is_none());
    assert(transport.position==1 && stream.stats().frames_received==0 && stream.stats().read_bytes==1);
    let binary:[u8;3]=[0,255,9]; receive(stream.borrow(),2,core::slice::view(binary,3).unwrap());
    receive(stream.borrow(),9,bytes("ok",2));
    assert(stream.stats().frames_received==2 && stream.stats().read_bytes==9);
    receive_error(stream.borrow(),1003); let calls:i32=transport.calls();
    receive_error(stream.borrow(),1003); assert(transport.calls()==calls && stream.is_failed());
    assert(stream.destroy() && !stream.destroy());
}

fn partial_writes_and_local_rejection() {
    let output:[u8;4096]=[199;4096]; let transport:Script=script(empty(),output);
    transport.write_width=2; transport.write_block=2; transport.write_interrupt=3;
    transport.flush_block=1; transport.flush_interrupt=2;
    let stream=ext::websocket_stream::new(transport.borrow(),ext::websocket::Role::Client,empty(),ext::websocket_stream::default_limits()).unwrap();
    let payload:[u8;3]=[0,255,9]; let key:[u8;4]=[5,6,7,8];
    assert(stream.flush().unwrap() && transport.calls()==0);
    let bad:core::slice::View<u8> =empty(); bad.length=-1;
    assert(stream_code(stream.send(true,2,bad,key).unwrap_err())==1);
    assert(stream_code(stream.send(true,15,empty(),key).unwrap_err())==1005 && !stream.is_failed());
    assert(stream.send(true,2,core::slice::view(payload,3).unwrap(),key).unwrap()==9);
    payload[0]=99; assert(transport.calls()==0 && stream.pending().len()==9);
    assert(stream_code(stream.send(true,2,empty(),key).unwrap_err())==4);
    assert(!stream.flush().unwrap());
    assert(transport.output_length==2 && stream.pending().len()==7 && stream.pending().get(0).unwrap()==5);
    assert(!stream.flush().unwrap());
    assert(transport.output_length==9 && stream.pending().len()==0 && stream.stats().frames_sent==0);
    assert(stream_code(stream.send(true,9,empty(),key).unwrap_err())==4);
    assert(stream.flush().unwrap() && stream.stats().frames_sent==1 && stream.stats().accepted_bytes==9);
    let encoded:[u8;9]=[130,131,5,6,7,8,5,249,14];
    assert(same(transport.written(),core::slice::view(encoded,9).unwrap()));
    assert(transport.write_calls==7 && transport.flush_calls==3 && stream.stats().io_calls==10);
    let calls:i32=transport.calls(); assert(stream.flush().unwrap() && transport.calls()==calls);
    // A second frame uses another caller-supplied key and is not replayed.
    let next:[u8;4]=[9,10,11,12]; assert(stream.send(true,9,empty(),next).unwrap()==6);
    assert(stream.flush().unwrap() && transport.output_length==15 && stream.stats().frames_sent==2);
    let last:i32=transport.calls(); assert(stream.destroy() && !stream.destroy() && transport.calls()==last);
    assert(stream_code(stream.send(true,2,empty(),key).unwrap_err())==3);
    assert(stream_code(stream.flush().unwrap_err())==3); receive_error(stream.borrow(),3);
}

fn stream_sticky(stream:&ext::websocket_stream::Stream<Script>, transport:&Script,
    original:ext::websocket_stream::Failure) {
    let calls:i32=transport.calls();
    let repeated:ext::websocket_stream::Failure=stream.flush().unwrap_err();
    assert(stream_code(repeated)==stream_code(original) && repeated.completed==original.completed);
    assert(repeated.stats.io_calls==original.stats.io_calls && repeated.stats.read_bytes==original.stats.read_bytes);
    assert(repeated.stats.accepted_bytes==original.stats.accepted_bytes && repeated.stats.frames_received==original.stats.frames_received);
    assert(repeated.stats.frames_sent==original.stats.frames_sent);
    receive_error(stream,stream_code(original));
    let key:[u8;4]=[13,14,15,16];
    assert(stream_code(stream.send(true,2,empty(),key).unwrap_err())==stream_code(original));
    assert(transport.calls()==calls && stream.is_failed());
}
fn upgrade_failure(client:&ext::websocket_upgrade::Client<Script>, transport:&Script)
    -> ext::websocket_upgrade::Failure {
    let turns:i32=0;
    while (turns<2000) {
        let calls:i32=transport.calls(); let result=client.step();
        assert(transport.calls()-calls<=1);
        if (result.is_err()) { return result.unwrap_err(); }
        turns+=1;
    }
    assert(false); return client.step().unwrap_err();
}
fn upgrade_sticky(client:&ext::websocket_upgrade::Client<Script>, transport:&Script,
    original:ext::websocket_upgrade::Failure) {
    let calls:i32=transport.calls();
    let repeated:ext::websocket_upgrade::Failure=client.step().unwrap_err();
    assert(upgrade_code(repeated)==upgrade_code(original) && repeated.completed==original.completed);
    assert(repeated.stats.io_calls==original.stats.io_calls && repeated.stats.accepted_bytes==original.stats.accepted_bytes);
    assert(repeated.stats.read_bytes==original.stats.read_bytes && repeated.stats.work==original.stats.work);
    assert(upgrade_code(client.response().unwrap_err())==upgrade_code(original));
    assert(upgrade_code(client.into_stream(ext::websocket_stream::default_limits()).unwrap_err())==upgrade_code(original));
    assert(transport.calls()==calls && client.is_active() && !client.is_ready());
}

fn stream_io_failures() {
    let mode:i32=1;
    while (mode<=3) {
        let output:[u8;4096]=[199;4096]; let transport:Script=script(empty(),output); transport.read_mode=mode;
        let stream=ext::websocket_stream::new(transport.borrow(),ext::websocket::Role::Client,empty(),ext::websocket_stream::default_limits()).unwrap();
        let failure:ext::websocket_stream::Failure=stream.receive().unwrap_err();
        let expected:i32=101; if (mode==3) { expected=255; }
        assert(stream_code(failure)==expected && failure.completed==0 && failure.stats.io_calls==1);
        assert(transport.read_calls==1 && transport.position==0);
        stream_sticky(stream.borrow(),transport.borrow(),failure);
        let calls:i32=transport.calls(); assert(stream.destroy() && !stream.destroy() && transport.calls()==calls);
        mode+=1;
    }
    mode=1;
    while (mode<=4) {
        let output:[u8;4096]=[199;4096]; let transport:Script=script(empty(),output); transport.write_mode=mode;
        let stream=ext::websocket_stream::new(transport.borrow(),ext::websocket::Role::Client,empty(),ext::websocket_stream::default_limits()).unwrap();
        let key:[u8;4]=[17,18,19,20]; assert(stream.send(true,2,bytes("ok",2),key).unwrap()==8);
        let failure:ext::websocket_stream::Failure=stream.flush().unwrap_err();
        let expected:i32=101; if (mode==3) { expected=255; } if (mode==4) { expected=102; }
        assert(stream_code(failure)==expected && failure.completed==0 && failure.stats.accepted_bytes==0);
        assert(transport.output_length==0 && stream.pending().len()==8 && transport.flush_calls==0);
        stream_sticky(stream.borrow(),transport.borrow(),failure); assert(stream.destroy()); mode+=1;
    }
    mode=1;
    while (mode<=3) {
        let output:[u8;4096]=[199;4096]; let transport:Script=script(empty(),output); transport.flush_mode=mode;
        let stream=ext::websocket_stream::new(transport.borrow(),ext::websocket::Role::Client,empty(),ext::websocket_stream::default_limits()).unwrap();
        let key:[u8;4]=[21,22,23,24]; assert(stream.send(true,2,bytes("ok",2),key).unwrap()==8);
        let failure:ext::websocket_stream::Failure=stream.flush().unwrap_err();
        let expected:i32=101; if (mode==3) { expected=255; }
        assert(stream_code(failure)==expected && failure.completed==8 && failure.stats.accepted_bytes==8);
        assert(transport.output_length==8 && stream.pending().len()==0 && failure.stats.frames_sent==0);
        stream_sticky(stream.borrow(),transport.borrow(),failure); assert(stream.destroy()); mode+=1;
    }
}

fn stream_eof_and_protocol_failures() {
    let partial:[u8;1]=[130]; let output:[u8;4096]=[199;4096]; let transport:Script=script(empty(),output);
    let stream=ext::websocket_stream::new(transport.borrow(),ext::websocket::Role::Client,core::slice::view(partial,1).unwrap(),ext::websocket_stream::default_limits()).unwrap();
    let failure:ext::websocket_stream::Failure=stream.receive().unwrap_err();
    assert(stream_code(failure)==9 && failure.completed==0 && transport.read_calls==1);
    stream_sticky(stream.borrow(),transport.borrow(),failure); assert(stream.destroy());
    let unfinished:[u8;3]=[1,1,65];
    let fragment=ext::websocket_stream::new(transport.borrow(),ext::websocket::Role::Client,core::slice::view(unfinished,3).unwrap(),ext::websocket_stream::default_limits()).unwrap();
    receive(fragment.borrow(),0,empty());
    let ended:ext::websocket_stream::Failure=fragment.receive().unwrap_err(); assert(stream_code(ended)==1004);
    stream_sticky(fragment.borrow(),transport.borrow(),ended); assert(fragment.destroy());
    let malformed:[u8;2]=[193,0];
    let broken=ext::websocket_stream::new(transport.borrow(),ext::websocket::Role::Client,core::slice::view(malformed,2).unwrap(),ext::websocket_stream::default_limits()).unwrap();
    let calls:i32=transport.calls(); receive_error(broken.borrow(),1005); assert(broken.is_failed() && transport.calls()==calls);
    receive_error(broken.borrow(),1002);
    let key:[u8;4]=[25,26,27,28];
    assert(stream_code(broken.send(true,2,empty(),key).unwrap_err())==1002);
    let close:[u8;2]=[3,234]; assert(broken.send(true,8,core::slice::view(close,2).unwrap(),key).unwrap()==8);
    assert(broken.flush().unwrap() && broken.close_sent());
    assert(stream_code(broken.send(true,8,empty(),key).unwrap_err())==1002);
    assert(broken.destroy());
    let invalid:[u8;3]=[129,1,255];
    let utf8=ext::websocket_stream::new(transport.borrow(),ext::websocket::Role::Client,core::slice::view(invalid,3).unwrap(),ext::websocket_stream::default_limits()).unwrap();
    receive_error(utf8.borrow(),1006); assert(utf8.is_failed()); assert(utf8.destroy());
}

fn stream_quotas_and_server_role() {
    let frame:[u8;5]=[130,3,0,255,9]; let budget:i32=0;
    while (budget<=1) {
        let output:[u8;4096]=[199;4096]; let transport:Script=script(core::slice::view(frame,5).unwrap(),output); transport.read_width=1;
        let limits:ext::websocket_stream::Limits=ext::websocket_stream::default_limits(); limits.io_calls=budget as u64;
        let stream=ext::websocket_stream::new(transport.borrow(),ext::websocket::Role::Client,empty(),limits).unwrap();
        let failure:ext::websocket_stream::Failure=stream.receive().unwrap_err();
        assert(stream_code(failure)==8 && failure.completed==budget && transport.read_calls==budget);
        stream_sticky(stream.borrow(),transport.borrow(),failure); assert(stream.destroy()); budget+=1;
    }
    budget=0;
    while (budget<=1) {
        let output:[u8;4096]=[199;4096]; let transport:Script=script(core::slice::view(frame,5).unwrap(),output);
        let limits:ext::websocket_stream::Limits=ext::websocket_stream::default_limits(); limits.read_bytes=budget as u64;
        let stream=ext::websocket_stream::new(transport.borrow(),ext::websocket::Role::Client,empty(),limits).unwrap();
        let failure:ext::websocket_stream::Failure=stream.receive().unwrap_err();
        assert(stream_code(failure)==6 && failure.completed==budget && failure.stats.read_bytes==(budget as u64));
        assert(transport.position==budget && transport.read_calls==budget);
        stream_sticky(stream.borrow(),transport.borrow(),failure); assert(stream.destroy()); budget+=1;
    }
    let output:[u8;4096]=[199;4096]; let payload:[u8;13]=[0;13];
    let transport:Script=script(core::slice::view(payload,13).unwrap(),output);
    let limits:ext::websocket_stream::Limits=ext::websocket_stream::default_limits(); limits.buffer_bytes=14;
    let header:[u8;2]=[130,13];
    let stream=ext::websocket_stream::new(transport.borrow(),ext::websocket::Role::Client,core::slice::view(header,2).unwrap(),limits).unwrap();
    let failure:ext::websocket_stream::Failure=stream.receive().unwrap_err();
    assert(stream_code(failure)==5 && failure.completed==12 && transport.position==12 && transport.read_calls==1);
    stream_sticky(stream.borrow(),transport.borrow(),failure); assert(stream.destroy());
    let bounded:Script=script(empty(),output); bounded.write_width=2;
    limits=ext::websocket_stream::default_limits(); limits.io_calls=1;
    let partial=ext::websocket_stream::new(bounded.borrow(),ext::websocket::Role::Client,empty(),limits).unwrap();
    let key:[u8;4]=[29,30,31,32]; assert(partial.send(true,2,bytes("ok",2),key).unwrap()==8);
    let stopped:ext::websocket_stream::Failure=partial.flush().unwrap_err();
    assert(stream_code(stopped)==8 && stopped.completed==2 && stopped.stats.accepted_bytes==2 && partial.pending().len()==6);
    stream_sticky(partial.borrow(),bounded.borrow(),stopped); assert(partial.destroy());
    let admitted:Script=script(empty(),output);
    limits=ext::websocket_stream::default_limits(); limits.written_bytes=7;
    let small=ext::websocket_stream::new(admitted.borrow(),ext::websocket::Role::Client,empty(),limits).unwrap();
    assert(stream_code(small.send(false,1,bytes("ab",2),key).unwrap_err())==7 && !small.is_failed());
    // If rejection had advanced the fragment state, this standalone Text fails.
    assert(small.send(true,1,bytes("x",1),key).unwrap()==7 && admitted.calls()==0);
    assert(small.flush().unwrap() && admitted.output_length==7); assert(small.destroy());
    let close_test:Script=script(empty(),output);
    let retained=ext::websocket_stream::new(close_test.borrow(),ext::websocket::Role::Client,empty(),limits).unwrap();
    let close:[u8;2]=[3,232];
    assert(stream_code(retained.send(true,8,core::slice::view(close,2).unwrap(),key).unwrap_err())==7);
    assert(!retained.close_sent() && retained.send(true,2,empty(),key).unwrap()==6);
    let calls:i32=close_test.calls(); assert(retained.destroy() && !retained.destroy() && close_test.calls()==calls && close_test.output_length==0);
    // Server role receives masked frames and sends unmasked frames.
    let masked:[u8;7]=[129,129,1,2,3,4,121]; let server_io:Script=script(empty(),output);
    let server=ext::websocket_stream::new(server_io.borrow(),ext::websocket::Role::Server,core::slice::view(masked,7).unwrap(),ext::websocket_stream::default_limits()).unwrap();
    receive(server.borrow(),1,bytes("x",1)); assert(server_io.calls()==0);
    assert(server.send(true,2,bytes("x",1),key).unwrap()==3 && server.flush().unwrap());
    let unmasked:[u8;3]=[130,1,120]; assert(same(server_io.written(),core::slice::view(unmasked,3).unwrap()));
    assert(server.destroy());
}

fn upgrade_io_failures() {
    let phase:i32=0;
    while (phase<3) {
        let mode:i32=1; let maximum:i32=3; if (phase==0) { maximum=4; }
        while (mode<=maximum) {
            let output:[u8;4096]=[199;4096]; let transport:Script=script(response(),output);
            if (phase==0) { transport.write_mode=mode; }
            if (phase==1) { transport.flush_mode=mode; }
            if (phase==2) { transport.read_mode=mode; }
            let client=ext::websocket_upgrade::client(transport.borrow(),request(),accept(),ext::websocket_upgrade::default_limits()).unwrap();
            let failure:ext::websocket_upgrade::Failure=upgrade_failure(client.borrow(),transport.borrow());
            let expected:i32=101; if (mode==3) { expected=255; } if (mode==4) { expected=102; }
            assert(upgrade_code(failure)==expected);
            if (phase==0) { assert(failure.completed==0 && failure.stats.accepted_bytes==0 && transport.output_length==0); }
            if (phase==1) { assert(failure.completed==248 && transport.output_length==248 && transport.read_calls==0); }
            if (phase==2) { assert(failure.completed==0 && transport.output_length==248 && transport.flushed==1); }
            upgrade_sticky(client.borrow(),transport.borrow(),failure);
            let calls:i32=transport.calls(); assert(client.destroy() && !client.destroy() && transport.calls()==calls);
            mode+=1;
        }
        phase+=1;
    }
}

fn upgrade_limits_and_invalid_response() {
    let mode:i32=0;
    while (mode<4) {
        let output:[u8;4096]=[199;4096]; let transport:Script=script(response(),output);
        let limits:ext::websocket_upgrade::Limits=ext::websocket_upgrade::default_limits();
        limits.io_calls=mode as u64;
        if (mode==0) { transport.write_width=1; }
        if (mode==1) { transport.write_width=7; }
        if (mode==3) { transport.read_width=5; }
        let client=ext::websocket_upgrade::client(transport.borrow(),request(),accept(),limits).unwrap();
        let failure:ext::websocket_upgrade::Failure=upgrade_failure(client.borrow(),transport.borrow());
        assert(upgrade_code(failure)==8 && failure.stats.io_calls==(mode as u64) && transport.calls()==mode);
        if (mode==0) { assert(failure.completed==0 && failure.stats.accepted_bytes==0); }
        if (mode==1) { assert(failure.completed==7 && failure.stats.accepted_bytes==7); }
        if (mode==2) { assert(failure.completed==0 && failure.stats.accepted_bytes==248 && failure.stats.read_bytes==0); }
        if (mode==3) { assert(failure.completed==5 && failure.stats.read_bytes==5); }
        upgrade_sticky(client.borrow(),transport.borrow(),failure); assert(client.destroy()); mode+=1;
    }
    // Stop before flushing after a full successful request write.
    let output:[u8;4096]=[199;4096]; let flush_io:Script=script(response(),output);
    let limits:ext::websocket_upgrade::Limits=ext::websocket_upgrade::default_limits(); limits.io_calls=1;
    let flushing=ext::websocket_upgrade::client(flush_io.borrow(),request(),accept(),limits).unwrap();
    let flush_failure:ext::websocket_upgrade::Failure=upgrade_failure(flushing.borrow(),flush_io.borrow());
    assert(upgrade_code(flush_failure)==8 && flush_failure.completed==248 && flush_io.flush_calls==0);
    upgrade_sticky(flushing.borrow(),flush_io.borrow(),flush_failure); assert(flushing.destroy());
    mode=0;
    while (mode<5) {
        let wire:[u8;159]=[0;159]; let index:i32=0;
        while (index<159) { wire[index]=response().get(index).unwrap(); index+=1; }
        let count:i32=159; let expected:i32=1007;
        if (mode==0) { wire[97]=65; }
        if (mode==1) { count=158; expected=2000; }
        if (mode==2) { wire[8]=120; expected=2000; }
        let transport:Script=script(core::slice::view(wire,count).unwrap(),output);
        limits=ext::websocket_upgrade::default_limits();
        if (mode==3) { limits.read_bytes=158; expected=7; }
        if (mode==4) { limits.work=1; expected=2000; }
        let client=ext::websocket_upgrade::client(transport.borrow(),request(),accept(),limits).unwrap();
        let failure:ext::websocket_upgrade::Failure=upgrade_failure(client.borrow(),transport.borrow());
        assert(upgrade_code(failure)==expected && transport.position<=159);
        if (mode==3) { assert(failure.completed==0 && failure.stats.read_bytes==158 && transport.read_calls==1); }
        if (mode==4) { assert(failure.stats.work<=1); }
        upgrade_sticky(client.borrow(),transport.borrow(),failure); assert(client.destroy()); mode+=1;
    }
}

fn main() -> i32 {
    constructors(); handshake_copy_and_handoff(); fragmented_handshake();
    prefetched_fragments_and_close(); partial_frames(); partial_writes_and_local_rejection();
    stream_io_failures(); stream_eof_and_protocol_failures(); stream_quotas_and_server_role();
    upgrade_io_failures(); upgrade_limits_and_invalid_response();
    return 0;
}
