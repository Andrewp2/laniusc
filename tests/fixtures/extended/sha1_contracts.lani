module app::main;
import core::mem;
import core::option;
import core::result;
import core::sha1;
import core::slice;
fn bytes(value:str,count:i32) -> core::slice::View<u8> { let raw:[u8]=core::mem::typed_slice_from_raw_parts(core::mem::string_data_ptr(value),count); return core::result::unwrap(core::slice::view(raw,count)); }
fn check(value:core::sha1::Digest, expected:[u8]) -> bool { let i:i32=0; while(i<20) { if(value.bytes[i]!=expected[i]) { return false; } i+=1; } return true; }
fn main() -> i32 {
    let empty:[u8;20]=[218,57,163,238,94,107,75,13,50,85,191,239,149,96,24,144,175,216,7,9];
    let abc:[u8;20]=[169,153,62,54,71,6,129,106,186,62,37,113,120,80,194,108,156,208,216,157];
    let long:[u8;20]=[132,152,62,68,28,59,210,110,186,174,74,161,249,81,41,229,229,70,112,241];
    let million:[u8;20]=[52,170,151,60,212,196,218,164,246,30,235,43,219,173,39,49,101,52,1,111];
    let state:core::sha1::State=core::sha1::new(); assert(check(state.finish(),empty)); assert(check(state.finish(),empty)); assert(core::result::is_err(state.update(bytes("a",1))));
    state.reset(); core::result::unwrap(state.update(bytes("a",1))); core::result::unwrap(state.update(bytes("",0))); core::result::unwrap(state.update(bytes("bc",2))); assert(check(state.finish(),abc));
    let input:core::slice::View<u8> =bytes("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq",56); assert(check(core::result::unwrap(core::sha1::digest(input)),long));
    // Keep results alive across further calls, context reuse, and independent
    // contexts. Immediate checks alone cannot detect returned-array aliasing.
    let retained_abc:core::sha1::Digest=state.finish();
    state.reset(); core::result::unwrap(state.update(input));
    let retained_long:core::sha1::Digest=state.finish();
    if(!check(retained_abc,abc) || !check(retained_long,long)) { return 20; }
    let repeated_long:core::sha1::Digest=state.finish();
    state.reset(); let retained_empty:core::sha1::Digest=state.finish();
    if(!check(retained_abc,abc) || !check(retained_long,long) || !check(repeated_long,long) || !check(retained_empty,empty)) { return 21; }
    // Distinct new() calls must have independent streaming block storage even
    // when both contexts are active and updates are interleaved.
    let left:core::sha1::State=core::sha1::new();
    let right:core::sha1::State=core::sha1::new();
    core::result::unwrap(left.update(bytes("a",1)));
    core::result::unwrap(right.update(core::result::unwrap(input.subview(0,11))));
    core::result::unwrap(left.update(bytes("b",1)));
    core::result::unwrap(right.update(core::result::unwrap(input.subview(11,39))));
    core::result::unwrap(left.update(bytes("c",1)));
    core::result::unwrap(right.update(core::result::unwrap(input.subview(39,56))));
    let left_abc:core::sha1::Digest=left.finish();
    let right_long:core::sha1::Digest=right.finish();
    if(!check(left_abc,abc) || !check(right_long,long)) { return 22; }
    left.reset(); core::result::unwrap(left.update(input));
    let left_long:core::sha1::Digest=left.finish();
    right.reset(); core::result::unwrap(right.update(bytes("abc",3)));
    let right_abc:core::sha1::Digest=right.finish();
    if(!check(left_abc,abc) || !check(right_long,long) || !check(left_long,long) || !check(right_abc,abc)) { return 23; }
    if(!check(retained_abc,abc) || !check(retained_long,long) || !check(repeated_long,long) || !check(retained_empty,empty)) { return 24; }
    let split:i32=0; while(split<=56) { state.reset(); core::result::unwrap(state.update(core::result::unwrap(input.subview(0,split)))); core::result::unwrap(state.update(core::result::unwrap(input.subview(split,56)))); assert(check(state.finish(),long)); split+=1; }
    state.reset(); let block:[u8;250]=[97;250]; let view:core::slice::View<u8> =core::result::unwrap(core::slice::view(block,250)); let i:i32=0; while(i<4000) { core::result::unwrap(state.update(view)); i+=1; } assert(check(state.finish(),million));
    state.reset(); let invalid:core::slice::View<u8> =bytes("abc",3); invalid.start=-1; assert(core::result::is_err(state.update(invalid))); assert(check(state.finish(),empty));
    state.reset(); state.count=2305843009213693951; assert(core::result::is_err(state.update(bytes("x",1))) && state.count==2305843009213693951 && state.used==0);
    return 0;
}
