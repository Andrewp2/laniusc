// Ordinary composition: no Error projection or private State fields.
module app::main;
import core::slice;
import ext::tls_hash;
import ext::tls_suite;
fn view(bytes:[u8],n:i32)->core::slice::View<u8> { return core::slice::View { values:bytes,start:0,length:n }; }
fn same(a:ext::tls_hash::Digest,b:ext::tls_hash::Digest) { let i:i32=0; while(i<48) { assert(a.bytes[i]==b.bytes[i]); i+=1; } }
fn main()->i32 {
 let message:[u8;3]=[97,98,99]; let expected256:[u8;32]=[186,120,22,191,143,1,207,234,65,65,64,222,93,174,34,35,176,3,97,163,150,23,122,156,180,16,255,97,242,0,21,173];
 let expected384:[u8;48]=[203,0,117,63,69,163,94,139,181,160,61,105,154,198,80,7,39,44,50,171,14,222,209,99,26,139,96,90,67,255,91,237,128,134,7,43,161,231,204,35,88,186,236,161,52,200,37,167];
 let small:ext::tls_hash::State=ext::tls_hash::new(ext::tls_hash::Algorithm::Sha256); let wide:ext::tls_hash::State=ext::tls_hash::new(ext::tls_hash::Algorithm::Sha384); small.update(view(message,1)).unwrap(); wide.update(view(message,2)).unwrap(); small.update(core::slice::View { values:message,start:1,length:2 }).unwrap(); wide.update(core::slice::View { values:message,start:2,length:1 }).unwrap(); let s:ext::tls_hash::Digest=small.snapshot(); let w:ext::tls_hash::Digest=wide.snapshot(); let j:i32=0; while(j<48) { if(j<32) { assert(s.bytes[j]==expected256[j]); } else { assert(s.bytes[j]==0); } assert(w.bytes[j]==expected384[j]); j+=1; }
 let p:ext::tls_suite::Policy=ext::tls_suite::default_policy(); assert(ext::tls_suite::validate_policy(p).unwrap()==3); let i:i32=0;
 while(i<3) { let selected:ext::tls_suite::Suite=ext::tls_suite::from_id(ext::tls_suite::id(p.order[i])).unwrap(); let kind:ext::tls_hash::Algorithm=ext::tls_suite::hash(selected); let state:ext::tls_hash::State=ext::tls_hash::new(kind); assert(state.update(view(message,1)).unwrap()==1); let retained:ext::tls_hash::Digest=state.snapshot(); assert(state.update(core::slice::View { values:message,start:1,length:2 }).unwrap()==2); let result:ext::tls_hash::Digest=state.snapshot(); let repeated:ext::tls_hash::Digest=state.snapshot(); same(result,repeated); let copied:ext::tls_hash::Digest=ext::tls_hash::digest_from_view(kind,result.view()).unwrap(); same(copied,result);
  let n:i32=ext::tls_hash::hash_length(kind); assert(result.view().length==n); let at:i32=0; while(at<n) { if(n==32) { assert(result.bytes[at]==expected256[at]); } else { assert(result.bytes[at]==expected384[at]); } at+=1; } while(at<48) { assert(result.bytes[at]==0); at+=1; }
  let changed:ext::tls_hash::Digest=result; changed.bytes[0]^=1; assert(copied.bytes[0]!=changed.bytes[0]); let suffix:[u8;1]=[0]; state.update(view(suffix,1)).unwrap(); same(copied,result); assert(retained.view().length==n); i+=1;
 }
 return 0;
}
