// Ordinary portable bridge consumer, with no Error projection or private state.
// Test input contains a real CA/intermediate/leaf chain and signed peer flight.
module app::main;
import core::io; import core::mem; import core::result; import core::slice;
import ext::ed25519; import ext::signature; import ext::service_identity; import ext::tls_authentication; import ext::tls_hash; import ext::tls_schedule; import ext::tls_handshake; import ext::tls_transcript; import ext::x509_path;
import std::stream;
fn load(b:[u8],at:i32)->u64{let v:u64=0;let i:i32=0;while(i<8){v|=(b[at+i] as u64)<<(8*i);i+=1;}return v;}
fn read(input:&std::stream::Descriptor,b:[u8],at:i32,n:i32){core::result::unwrap(core::io::read_exact<std::stream::Descriptor>(input,b,at,n));}
fn view(b:[u8],at:i32,n:i32)->core::slice::View<u8>{return core::slice::View{values:b,start:at,length:n};}
fn main()->i32{
 let input:std::stream::Descriptor=std::stream::stdin();let output:std::stream::Descriptor=std::stream::stdout();let count:[u8;8]=[0;8];read(input.borrow(),count,0,8);let cases:u64=load(count,0);let turn:u64=0;
 while(turn<cases){
  let h:[u8;80]=[0;80];read(input.borrow(),h,0,80);let layout:i32=load(h,0) as i32;let now:i64=load(h,8) as i64;
  let root_len:i32=load(h,16) as i32;let ch_len:i32=load(h,24) as i32;let sh_len:i32=load(h,32) as i32;
  let ee_len:i32=load(h,40) as i32;let cert_len:i32=load(h,48) as i32;let cv_len:i32=load(h,56) as i32;let fin_len:i32=load(h,64) as i32;let algorithm_id:i32=load(h,72) as i32;assert(algorithm_id==0||algorithm_id==1);let algorithm:ext::tls_hash::Algorithm=ext::tls_hash::Algorithm::Sha256;if(algorithm_id==1){algorithm=ext::tls_hash::Algorithm::Sha384;}let hash_length:i32=ext::tls_hash::hash_length(algorithm);
  assert(layout>=0&&layout<=1&&root_len>0&&root_len<=4096&&ch_len>0&&ch_len<=512&&sh_len>0&&sh_len<=512&&ee_len>0&&ee_len<=200&&cert_len>0&&cert_len<=4096&&cv_len>0&&cv_len<=200&&fin_len>0&&fin_len<=200);
  let native:[u8;16384]=[0;16384];let packed:[i32;4096]=[0;4096];let bytes:[u8]=native;
  if(layout==1){bytes=core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(packed),16384);}
  read(input.borrow(),bytes,3,root_len);read(input.borrow(),bytes,4102,ch_len);read(input.borrow(),bytes,4620,sh_len);read(input.borrow(),bytes,5138,hash_length);
  read(input.borrow(),bytes,6000,ee_len);read(input.borrow(),bytes,6200,cert_len);read(input.borrow(),bytes,11000,cv_len);read(input.borrow(),bytes,11200,fin_len);read(input.borrow(),bytes,12000,292);
  let ch:ext::tls_handshake::Frame=core::result::unwrap(ext::tls_handshake::parse_frame(view(bytes,4102,ch_len)));
  let sh:ext::tls_handshake::Frame=core::result::unwrap(ext::tls_handshake::parse_frame(view(bytes,4620,sh_len)));
  assert(ch.kind==1&&sh.kind==2);core::result::unwrap(ext::tls_handshake::parse_client_hello(ch.body));let selected:ext::tls_handshake::ServerHello=core::result::unwrap(ext::tls_handshake::parse_server_hello(sh.body));let suite:u16=4867;if(algorithm_id==1){suite=4866;}assert(selected.cipher_suite==suite&&!selected.is_hello_retry_request());
  let transcript:ext::tls_transcript::State=ext::tls_transcript::new(algorithm);core::result::unwrap(transcript.update(ch.wire));core::result::unwrap(transcript.update(sh.wire));
  let reference_bytes:[u8;14]=[115,101,114,118,101,114,46,101,120,97,109,112,108,101];let reference:ext::service_identity::Reference=core::result::unwrap(ext::service_identity::dns_reference(view(reference_bytes,0,14)));
  let anchor_views:[core::slice::View<u8>;1]=[view(bytes,3,root_len)];let anchors:core::slice::View<core::slice::View<u8>> = core::slice::View{values:anchor_views,start:0,length:1};
  let config:ext::tls_authentication::Config=ext::tls_authentication::Config{anchors:anchors,reference:reference,unix_time:now,max_frame:16384,proofs:ext::signature::Policy{order:[2055,0,0,0],length:1},certificates:ext::signature::Policy{order:[2055,0,0,0],length:1}};
  let secret:ext::tls_schedule::Secret=ext::tls_schedule::secret_from_view(algorithm,view(bytes,5138,hash_length)).unwrap();
  let state:ext::tls_authentication::State=core::result::unwrap(ext::tls_authentication::server(transcript,secret,config));
  let slots:[ext::x509_path::Slot;5]=[ext::x509_path::empty_slot();5];let scratch:core::slice::View<ext::x509_path::Slot> = core::slice::View{values:slots,start:1,length:3};
  let budget:ext::x509_path::Budget=core::result::unwrap(ext::x509_path::budget(ext::x509_path::default_limits()));
  core::result::unwrap(state.feed(view(bytes,6000,ee_len),scratch,budget.borrow()));assert(!state.authenticated()&&state.peer_key().is_none()&&state.transcript().is_none());
  core::result::unwrap(state.feed(view(bytes,6200,cert_len),scratch,budget.borrow()));assert(!state.authenticated()&&state.peer_key().is_none()&&state.transcript().is_none());
  core::result::unwrap(state.feed(view(bytes,11000,cv_len),scratch,budget.borrow()));assert(!state.authenticated()&&state.peer_key().is_none()&&state.transcript().is_none());
  core::result::unwrap(state.feed(view(bytes,11200,fin_len),scratch,budget.borrow()));assert(state.authenticated()&&!state.is_poisoned());
  let key:ext::ed25519::Key32=state.peer_key().unwrap().ed25519_key().unwrap();let completed:ext::tls_transcript::State=state.transcript().unwrap();let digest:ext::tls_hash::Digest=completed.snapshot();
  assert(completed.messages()==6&&slots[0].certificate.is_none()&&slots[4].certificate.is_none());
  // Both RFC contexts are checked against independent Python bytes. Copies
  // and later snapshot mutation cannot alter either owned CV input.
  let server_input:ext::tls_authentication::CVInput=ext::tls_authentication::certificate_verify_input(ext::tls_schedule::Side::Server,digest);
  let client_input:ext::tls_authentication::CVInput=ext::tls_authentication::certificate_verify_input(ext::tls_schedule::Side::Client,digest);
  assert(server_input.length==98+hash_length&&client_input.length==98+hash_length);
  let server_view:core::slice::View<u8> = server_input.view();let client_view:core::slice::View<u8> = client_input.view();
  assert(server_view.start==0&&server_view.length==server_input.length&&client_view.start==0&&client_view.length==client_input.length);
  let changed:ext::tls_authentication::CVInput=server_input;changed.bytes[0]=0;assert(server_input.bytes[0]==32);
  let saved:ext::tls_hash::Digest=digest;digest.bytes[0]^=255;
  let again:ext::tls_hash::Digest=completed.snapshot();let i:i32=0;
  while(i<146){assert(server_input.bytes[i]==bytes[12000+i]&&client_input.bytes[i]==bytes[12146+i]);if(i<server_view.length){assert(server_view.values[i]==server_input.bytes[i]&&client_view.values[i]==client_input.bytes[i]);}i+=1;}
  i=0;while(i<48){assert(saved.bytes[i]==again.bytes[i]);i+=1;}digest=saved;
  core::result::unwrap(core::io::write_all<std::stream::Descriptor>(output.borrow(),key.bytes,0,32));core::result::unwrap(core::io::write_all<std::stream::Descriptor>(output.borrow(),digest.bytes,0,hash_length));turn+=1;
 }
 return 0;
}
