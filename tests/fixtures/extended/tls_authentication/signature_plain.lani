// Ordinary generic-key authentication consumer; no Error projection or stdin
// private-state injection. Peer bytes contain an actual CA/intermediate path.
module app::main;
import core::io; import core::mem; import core::result; import core::slice;
import ext::signature; import ext::service_identity; import ext::tls_authentication; import ext::tls_hash; import ext::tls_schedule; import ext::tls_transcript; import ext::x509_path;
import std::stream;
fn load(b:[u8],at:i32)->u64{let v:u64=0;let i:i32=0;while(i<8){v|=(b[at+i] as u64)<<(8*i);i+=1;}return v;}
fn read(input:&std::stream::Descriptor,b:[u8],at:i32,n:i32){core::result::unwrap(core::io::read_exact<std::stream::Descriptor>(input,b,at,n));}
fn view(b:[u8],at:i32,n:i32)->core::slice::View<u8>{return core::slice::View{values:b,start:at,length:n};}
fn main()->i32{
 let input:std::stream::Descriptor=std::stream::stdin();let output:std::stream::Descriptor=std::stream::stdout();let cb:[u8;8]=[0;8];read(input.borrow(),cb,0,8);let count:u64=load(cb,0);let turn:u64=0;
 while(turn<count){
  let h:[u8;152]=[0;152];read(input.borrow(),h,0,152);let layout:i32=load(h,0) as i32;let algid:i32=load(h,8) as i32;let ownid:u16=load(h,16) as u16;let now:i64=load(h,40) as i64;
  let rootn:i32=load(h,88) as i32;let chn:i32=load(h,96) as i32;let shn:i32=load(h,104) as i32;let certn:i32=load(h,112) as i32;let cvn:i32=load(h,120) as i32;let finn:i32=load(h,128) as i32;let wn:i32=load(h,136) as i32;
  assert(layout>=0&&layout<=1&&algid>=0&&algid<=1&&rootn>0&&rootn<=4096&&chn>0&&chn<=512&&shn>0&&shn<=512&&certn>0&&certn<=8192&&cvn>0&&cvn<=1024&&finn>0&&finn<=64&&wn>0&&wn<=512);
  let algorithm:ext::tls_hash::Algorithm=ext::tls_hash::Algorithm::Sha256;if(algid==1){algorithm=ext::tls_hash::Algorithm::Sha384;}let size:i32=ext::tls_hash::hash_length(algorithm);
  let native:[u8;8192]=[0;8192];let packed:[i32;2048]=[0;2048];let frames:[u8;8200]=[0;8200];let fp:[i32;2050]=[0;2050];let arena:[u8]=native;let frame:[u8]=frames;
  if(layout==1){arena=core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(packed),8192);frame=core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(fp),8200);}
  read(input.borrow(),arena,3,rootn);read(input.borrow(),arena,4102,chn);read(input.borrow(),arena,4620,shn);read(input.borrow(),arena,5138,size);read(input.borrow(),arena,5200,wn);
  let anchors:[core::slice::View<u8>;1]=[view(arena,3,rootn)];let refbytes:[u8;14]=[115,101,114,118,101,114,46,101,120,97,109,112,108,101];let reference:ext::service_identity::Reference=ext::service_identity::dns_reference(view(refbytes,0,14)).unwrap();
  let transcript:ext::tls_transcript::State=ext::tls_transcript::new(algorithm);transcript.update(view(arena,4102,chn)).unwrap();transcript.update(view(arena,4620,shn)).unwrap();let secret:ext::tls_schedule::Secret=ext::tls_schedule::secret_from_view(algorithm,view(arena,5138,size)).unwrap();
  let config:ext::tls_authentication::Config=ext::tls_authentication::Config{anchors:core::slice::View{values:anchors,start:0,length:1},reference:reference,unix_time:now,max_frame:16384,proofs:ext::signature::default_proofs(),certificates:ext::signature::Policy{order:[2055,0,0,0],length:1}};let state:ext::tls_authentication::State=ext::tls_authentication::server(transcript,secret,config).unwrap();
  let slots:[ext::x509_path::Slot;3]=[ext::x509_path::empty_slot();3];let scratch:core::slice::View<ext::x509_path::Slot> = core::slice::View{values:slots,start:0,length:3};let budget:ext::x509_path::Budget=ext::x509_path::budget(ext::x509_path::default_limits()).unwrap();let lengths:[i32;4]=[6,certn,cvn,finn];let step:i32=0;
  while(step<4){let n:i32=lengths[step];read(input.borrow(),frame,3,n);state.feed(view(frame,3,n),scratch,budget.borrow()).unwrap();if(step<3){assert(state.peer_key().is_none()&&state.transcript().is_none());}let i:i32=0;while(i<n+6){frame[i]=165;i+=1;}step+=1;}
  assert(state.authenticated()&&!state.is_poisoned());let key:ext::signature::PublicKey=state.peer_key().unwrap();let scheme:ext::signature::Scheme=ext::signature::tls_scheme(ownid,ext::signature::Use::CertificateVerify).unwrap();let allowance:ext::signature::Budget=ext::signature::budget(ext::signature::default_limits()).unwrap();let message:[u8;35]=[111,119,110,101,100,32,84,76,83,32,108,101,97,102,32,107,101,121,32,97,102,116,101,114,32,114,101,116,105,114,101,109,101,110,116];assert(ext::signature::verify(key.borrow(),ext::signature::Use::CertificateVerify,scheme,view(message,0,35),view(arena,5200,wn),allowance.borrow()).unwrap());
  let family:u64=match(key.kind()){ext::signature::Kind::Ed25519->1,ext::signature::Kind::P256->2,ext::signature::Kind::Rsae->3};let encoded:[u8;8]=[0;8];encoded[0]=family as u8;let completed:ext::tls_transcript::State=state.transcript().unwrap();let digest:ext::tls_hash::Digest=completed.snapshot();assert(completed.messages()==6);core::io::write_all<std::stream::Descriptor>(output.borrow(),encoded,0,8).unwrap();core::io::write_all<std::stream::Descriptor>(output.borrow(),digest.bytes,0,size).unwrap();turn+=1;
 }
 return 0;
}
