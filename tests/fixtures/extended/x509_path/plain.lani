// Isolated ordinary caller: no Error/ErrorKind projection or trusted shortcut.
module app::main;
import core::io;
import core::slice;
import core::result;
import ext::service_identity;
import ext::signature;
import ext::ed25519;
import ext::x509_path;
import std::stream;
fn main() -> i32 {
    let source: std::stream::Descriptor = std::stream::stdin(); let header: [u8;8] = [0;8]; let bytes: [u8;8192] = [0;8192];
    let empty: core::slice::View<u8> = core::slice::View { values: bytes, start: 0, length: 0 }; let descriptors: [core::slice::View<u8>;3] = [empty;3]; let i: i32 = 0; let used: i32 = 0;
    while (i < 3) { assert(core::io::read_exact(source.borrow(), header, 0, 8).is_ok()); let length: u64 = 0; let j: i32 = 0; while (j < 8) { length |= (header[j] as u64) << (j * 8); j += 1; }
        assert(length <= (8192 - used) as u64); assert(core::io::read_exact(source.borrow(), bytes, used, length as i32).is_ok()); descriptors[i] = core::slice::View { values: bytes, start: used, length: length as i32 }; used += length as i32; i += 1;
    }
    let expected: [u8;32] = [0;32]; assert(core::io::read_exact(source.borrow(), expected, 0, 32).is_ok());
    let dns: [u8;12] = [112,97,116,104,46,101,120,97,109,112,108,101];
    let identity: ext::service_identity::Reference = ext::service_identity::dns_reference(core::slice::View { values: dns, start: 0, length: 12 }).unwrap();
    let slots: [ext::x509_path::Slot;3] = [ext::x509_path::empty_slot();3]; let budget: ext::x509_path::Budget = ext::x509_path::budget(ext::x509_path::default_limits()).unwrap();
    let accepted: ext::x509_path::ValidatedServer = ext::x509_path::validate_server(core::slice::View { values: descriptors, start: 0, length: 2 }, core::slice::View { values: descriptors, start: 2, length: 1 }, identity, 1792843200, ext::signature::default_certificates(), core::slice::View { values: slots, start: 0, length: 3 }, budget.borrow()).unwrap();
    assert(accepted.anchor_index == 0 && accepted.chain_length == 2); let key: ext::ed25519::Key32 = accepted.public_key.ed25519_key().unwrap(); i = 0; while (i < 32) { assert(key.bytes[i] == expected[i]); i += 1; } return 0;
}
