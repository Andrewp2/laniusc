// Binary commands from the independent hashlib/hmac/OpenSSL peer. No heap.
module app::main;
import core::io;
import core::mem;
import core::result;
import core::slice;
import ext::tls_record;
import ext::tls_hash;
import ext::tls_schedule;
import ext::tls_suite;
import std::stream;
fn load(bytes: [u8], offset: i32) -> u64 {
    let value: u64 = 0; let index: i32 = 0;
    while (index < 8) { value |= (bytes[offset + index] as u64) << (index * 8); index += 1; } return value;
}
struct Output { bytes: [u8], used: i32 }
impl Output {
    fn borrow(&self) -> &Output { return self; }
    fn flush(&self) { let stdout: std::stream::Descriptor = std::stream::stdout(); core::result::unwrap(core::io::write_all<std::stream::Descriptor>(stdout.borrow(), self.bytes, 0, self.used)); self.used = 0; }
    fn byte(&self, value: u8) { if (self.used == 2048) { self.flush(); } self.bytes[self.used] = value; self.used += 1; }
    fn word(&self, value: u64) { let index: i32 = 0; while (index < 8) { self.byte(((value >> (index * 8)) & 255) as u8); index += 1; } }
    fn view(&self, value: core::slice::View<u8>) { let index: i32 = 0; while (index < value.length) { self.byte(value.values[value.start + index]); index += 1; } }
}
fn kind(error: ext::tls_record::Error) -> u64 {
    return match (error) {
        ext::tls_record::Error::Bounds -> 1, ext::tls_record::Error::HashMismatch -> 2,
        ext::tls_record::Error::InvalidType -> 3, ext::tls_record::Error::InvalidContentLength -> 4,
        ext::tls_record::Error::InvalidPadding -> 5, ext::tls_record::Error::RecordOverflow -> 6,
        ext::tls_record::Error::BufferTooSmall -> 7, ext::tls_record::Error::Exhausted -> 8,
        ext::tls_record::Error::Poisoned -> 9, ext::tls_record::Error::InvalidRecord -> 10,
        ext::tls_record::Error::Authentication -> 11, ext::tls_record::Error::InvalidInner -> 12,
        ext::tls_record::Error::Derivation -> 13
    };
}
fn flag(value: bool) -> u64 { if (value) { return 1; } return 0; }
fn bad(value: core::slice::View<u8>, variant: i32) -> core::slice::View<u8> {
    let changed: core::slice::View<u8> = value;
    if (variant == 0) { changed.start = -1; }
    if (variant == 1) { changed.length = -1; }
    if (variant == 2) { changed.start = 2147483647; changed.length = 1; } return changed;
}
fn untouched(storage: [u8], count: i32, value: u8) { let index: i32 = 0; while (index < count) { assert(storage[index] == value); index += 1; } }
fn equal(left: core::slice::View<u8>, right: core::slice::View<u8>) {
    assert(left.length == right.length); let index: i32 = 0;
    while (index < left.length) { assert(left.values[left.start + index] == right.values[right.start + index]); index += 1; }
}
fn header(output: &Output, status: u64, sequence: u64, exhausted: bool, poisoned: bool, content_type: u8, length: i32, observed: i32) {
    output.word(status); output.word(sequence); output.word(flag(exhausted)); output.word(flag(poisoned)); output.word(content_type as u64); output.word(length as u64); output.word(observed as u64);
}
fn stored(secret: core::slice::View<u8>, selected: ext::tls_suite::Suite) -> ext::tls_schedule::Secret {
    return ext::tls_schedule::secret_from_view(ext::tls_suite::hash(selected),secret).unwrap();
}
fn constructors(secret: core::slice::View<u8>, selected: ext::tls_suite::Suite) {
    let algorithm: ext::tls_hash::Algorithm=ext::tls_suite::hash(selected);
    let variant: i32=0; while(variant<3) {
        let rejected: core::result::Result<ext::tls_schedule::Secret,ext::tls_schedule::Error> = ext::tls_schedule::secret_from_view(algorithm,bad(secret,variant));
        let bounds: bool=match(rejected.unwrap_err()) { ext::tls_schedule::Error::Bounds->true,_ ->false }; assert(bounds); variant+=1;
    }
    let count: i32=0; while(count<50) {
        if(count!=ext::tls_hash::hash_length(algorithm)) {
            let candidate: core::slice::View<u8> = core::slice::View { values:secret.values,start:secret.start,length:count };
            let rejected: core::result::Result<ext::tls_schedule::Secret,ext::tls_schedule::Error> = ext::tls_schedule::secret_from_view(algorithm,candidate);
            let length_error: bool=match(rejected.unwrap_err()) { ext::tls_schedule::Error::InvalidSecretLength->true,_ ->false }; assert(length_error);
        } count+=1;
    }
    let other: ext::tls_hash::Algorithm=ext::tls_hash::Algorithm::Sha384; if(ext::tls_hash::hash_length(algorithm)==48) { other=ext::tls_hash::Algorithm::Sha256; }
    let source: [u8;48]=[91;48]; let wrong: ext::tls_schedule::Secret=ext::tls_schedule::secret_from_view(other,core::slice::View { values:source,start:0,length:ext::tls_hash::hash_length(other) }).unwrap();
    assert(kind(ext::tls_record::sealer(selected,wrong).unwrap_err())==2); assert(kind(ext::tls_record::opener(selected,wrong).unwrap_err())==2);
    assert(ext::tls_hash::hash_length(wrong.algorithm)==ext::tls_hash::hash_length(other)); count=0; while(count<48) { let expected:u8=91; if(count>=ext::tls_hash::hash_length(other)) { expected=0; } assert(wrong.bytes[count]==expected && source[count]==91); count+=1; }
}
fn run_seal(selected: ext::tls_suite::Suite, operation: i32, secret: core::slice::View<u8>, content: core::slice::View<u8>, kind_value: u8, padding: i32, sequence: u64, variant: i32, destination: core::slice::View<u8>, output: &Output) -> i32 {
    if (operation == 3) { constructors(secret,selected); }
    let state: ext::tls_record::Sealer = core::result::unwrap(ext::tls_record::sealer(selected, stored(secret,selected)));
    // Whitebox reachability only: no public import/resume/raw-key API exists.
    state.traffic.next = sequence; if (variant == 4) { state.traffic.exhausted = true; }
    assert(state.key_update_due() == (sequence >= ext::tls_record::AES_GCM_RECORD_LIMIT-1 || variant == 4));
    assert(ext::tls_suite::id(state.suite())==ext::tls_suite::id(selected));
    let source: core::slice::View<u8> = content; let target: core::slice::View<u8> = destination;
    if (variant == 1) { source = bad(content, 0); } if (variant == 2) { target = bad(destination, 0); }
    if (variant == 5) { source = bad(content, 2); } if (variant == 6) { source = bad(content, 1); }
    let result: core::result::Result<i32, ext::tls_record::Error> = state.seal(source, kind_value, padding, target);
    if (core::result::is_err(result)) {
        header(output, kind(core::result::unwrap_err(result)), state.sequence(), state.exhausted(), false, 0, 0, 0);
        untouched(destination.values, 16700, 221); return 0;
    }
    let count: i32 = core::result::unwrap(result);
    header(output, 0, state.sequence(), state.exhausted(), false, 0, count, 0);
    output.view(core::slice::View { values: destination.values, start: destination.start, length: count });
    if (state.exhausted()) {
        assert(kind(core::result::unwrap_err(state.seal(content, kind_value, padding, destination))) == 8);
        assert(kind(core::result::unwrap_err(state.seal(bad(content, 0), kind_value, padding, destination))) == 1);
        assert(state.sequence() == ext::tls_record::AES_GCM_RECORD_LIMIT && state.exhausted());
        assert(core::result::unwrap(state.key_update()) == 0); assert(state.sequence() == 0 && !state.exhausted());
    }
    return count;
}
fn run_open(selected: ext::tls_suite::Suite, operation: i32, secret: core::slice::View<u8>, record: core::slice::View<u8>, sequence: u64, variant: i32, scratch: core::slice::View<u8>, output: &Output) -> i32 {
    let state: ext::tls_record::Opener = core::result::unwrap(ext::tls_record::opener(selected, stored(secret,selected))); state.traffic.next = sequence;
    if (variant == 30) { state.traffic.exhausted = true; }
    assert(state.key_update_due() == (sequence >= ext::tls_record::AES_GCM_RECORD_LIMIT-1 || variant == 30));
    assert(ext::tls_suite::id(state.suite())==ext::tls_suite::id(selected));
    if (operation == 4) {
        let broken: i32 = 0; while (broken < 3) {
            assert(kind(core::result::unwrap_err(state.open(bad(record, broken), scratch))) == 1);
            assert(kind(core::result::unwrap_err(state.open(record, bad(scratch, broken)))) == 1);
            assert(!state.is_poisoned() && state.sequence() == sequence); untouched(scratch.values, 16700, 222); broken += 1;
        }
        let short: core::slice::View<u8> = scratch; short.length = record.length - 22;
        assert(kind(core::result::unwrap_err(state.open(record, short))) == 7);
        assert(!state.is_poisoned() && state.sequence() == sequence); untouched(scratch.values, 16700, 222);
    }
    let record_value: core::slice::View<u8> = record; let scratch_value: core::slice::View<u8> = scratch;
    if (variant == 31) { record_value = bad(record, 0); }
    if (variant == 32) { scratch_value = bad(scratch, 1); }
    let result: core::result::Result<ext::tls_record::Opened, ext::tls_record::Error> = state.open(record_value, scratch_value);
    let observed: i32 = scratch.length;
    if (core::result::is_err(result)) {
        let status: u64 = kind(core::result::unwrap_err(result));
        header(output, status, state.sequence(), state.exhausted(), state.is_poisoned(), 0, 0, observed); output.view(scratch);
        if (status != 12 && status != 6) { untouched(scratch.values, 16700, 222); }
        if (state.is_poisoned()) {
            assert(kind(core::result::unwrap_err(state.open(record, scratch))) == 9);
            assert(kind(core::result::unwrap_err(state.open(bad(record, 0), scratch))) == 1);
            assert(kind(core::result::unwrap_err(state.key_update())) == 9); assert(state.sequence() == sequence);
        } return observed;
    }
    let opened: ext::tls_record::Opened = core::result::unwrap(result);
    assert(opened.content.start == scratch.start && core::mem::slice_stride(opened.content.values) == core::mem::slice_stride(scratch.values));
    header(output, 0, state.sequence(), state.exhausted(), false, opened.content_type, opened.content.length, observed); output.view(opened.content); output.view(scratch);
    if (state.exhausted()) {
        assert(kind(core::result::unwrap_err(state.open(record, scratch))) == 8); assert(state.sequence() == ext::tls_record::AES_GCM_RECORD_LIMIT);
        assert(core::result::unwrap(state.key_update()) == 0); assert(state.sequence() == 0 && !state.exhausted());
    } else {
        // A repeated authenticated record uses the wrong implicit sequence;
        // it is fatal, and authenticate-before-decrypt preserves old scratch.
        let saved: [u8; 16700] = [0; 16700]; let index: i32 = 0;
        while (index < 16700) { saved[index] = scratch.values[index]; index += 1; }
        assert(kind(core::result::unwrap_err(state.open(record, scratch))) == 11);
        assert(state.is_poisoned()); assert(kind(core::result::unwrap_err(state.key_update())) == 9);
        index = 0; while (index < 16700) { assert(scratch.values[index] == saved[index]); index += 1; }
    }
    return record.length - 21;
}
fn lifecycle(selected: ext::tls_suite::Suite, secret: core::slice::View<u8>, content: core::slice::View<u8>, destination: core::slice::View<u8>, scratch: core::slice::View<u8>, output: &Output) {
    let send: ext::tls_record::Sealer = core::result::unwrap(ext::tls_record::sealer(selected, stored(secret,selected)));
    let receive: ext::tls_record::Opener = core::result::unwrap(ext::tls_record::opener(selected, stored(secret,selected)));
    let step: i32 = 0; while (step < 4) {
        if (step >= 2) { assert(core::result::unwrap(send.key_update()) == 0 && core::result::unwrap(receive.key_update()) == 0); assert(send.sequence() == 0 && receive.sequence() == 0); }
        let size: i32 = core::result::unwrap(send.seal(content, 23, step * 3, destination));
        let record: core::slice::View<u8> = core::slice::View { values: destination.values, start: destination.start, length: size };
        let opened: ext::tls_record::Opened = core::result::unwrap(receive.open(record, scratch)); equal(opened.content, content); assert(opened.content_type == 23);
        assert(send.sequence() == receive.sequence() && !receive.is_poisoned()); output.word(size as u64); output.view(record); step += 1;
    }
}
fn limit_lifecycle(selected: ext::tls_suite::Suite, secret: core::slice::View<u8>, content: core::slice::View<u8>, destination: core::slice::View<u8>, scratch: core::slice::View<u8>, output: &Output) {
    let send: ext::tls_record::Sealer = ext::tls_record::sealer(selected, stored(secret,selected)).unwrap();
    let receive: ext::tls_record::Opener = ext::tls_record::opener(selected, stored(secret,selected)).unwrap();
    // Private seam for reachable boundary coverage, never a public resume API.
    send.traffic.next = ext::tls_record::AES_GCM_RECORD_LIMIT-2; receive.traffic.next = ext::tls_record::AES_GCM_RECORD_LIMIT-2;
    let update_frame: [u8; 5] = [24,0,0,1,0]; let step: i32 = 0;
    while (step < 4) {
        if (step == 0) { assert(!send.key_update_due() && !receive.key_update_due()); }
        if (step == 1) { assert(send.key_update_due() && receive.key_update_due()); assert(!send.exhausted() && !receive.exhausted()); }
        if (step == 2) {
            assert(send.exhausted() && receive.exhausted() && send.key_update_due() && receive.key_update_due());
            let before: [u8; 16700] = [0; 16700]; let index: i32 = 0;
            while (index < 16700) { before[index] = destination.values[index]; index += 1; }
            assert(kind(send.seal(content, 23, 0, destination).unwrap_err()) == 8);
            index = 0; while (index < 16700) { assert(before[index] == destination.values[index]); index += 1; }
            send.key_update().unwrap(); receive.key_update().unwrap();
            assert(send.sequence() == 0 && receive.sequence() == 0 && !send.exhausted() && !receive.exhausted());
            assert(!send.key_update_due() && !receive.key_update_due());
        }
        let bytes: core::slice::View<u8> = content; let kind_value: u8 = 23; let padding: i32 = 0;
        if (step == 1) { bytes = core::slice::View { values: update_frame, start: 0, length: 5 }; kind_value = 22; }
        if (step == 2) { padding = 3; }
        let size: i32 = send.seal(bytes, kind_value, padding, destination).unwrap();
        let record: core::slice::View<u8> = core::slice::View { values: destination.values, start: destination.start, length: size };
        let opened: ext::tls_record::Opened = receive.open(record, scratch).unwrap(); equal(opened.content, bytes); assert(opened.content_type == kind_value);
        assert(send.sequence() == receive.sequence());
        assert(ext::tls_suite::id(send.suite())==ext::tls_suite::id(selected));
        output.word(size as u64); output.view(record); step += 1;
    }
}
fn main() -> i32 {
    let stdin: std::stream::Descriptor = std::stream::stdin(); let head: [u8; 8] = [0; 8];
    core::result::unwrap(core::io::read_exact<std::stream::Descriptor>(stdin.borrow(), head, 0, 8)); let cases: u64 = load(head, 0); assert(cases <= 1024);
    let output_bytes: [u8; 2048] = [0; 2048]; let output: Output = Output { bytes: output_bytes, used: 0 }; let case: u64 = 0;
    while (case < cases) {
        let frame: [u8; 72] = [0; 72]; core::result::unwrap(core::io::read_exact<std::stream::Descriptor>(stdin.borrow(), frame, 0, 72));
        let operation: i32 = load(frame, 0) as i32; let layout: i32 = load(frame, 8) as i32; let content_type: u8 = load(frame, 16) as u8;
        let padding: i32 = load(frame, 24) as i32; let sequence: u64 = load(frame, 32); let variant: i32 = load(frame, 40) as i32;
        let length: i32 = load(frame, 48) as i32; let capacity: i32 = load(frame, 56) as i32; let selected: ext::tls_suite::Suite=ext::tls_suite::from_id(load(frame,64) as u16).unwrap(); let secret_length:i32=ext::tls_hash::hash_length(ext::tls_suite::hash(selected));
        assert(operation >= 0 && operation <= 5 && layout >= 0 && layout <= 1 && length >= 0 && length <= 16650 && capacity >= 0 && capacity <= 16650);
        let raw_secret: [u8; 56] = [165; 56]; let raw_data: [u8; 16700] = [166; 16700]; let raw_destination: [u8; 16700] = [221; 16700]; let raw_scratch: [u8; 16700] = [222; 16700];
        core::result::unwrap(core::io::read_exact<std::stream::Descriptor>(stdin.borrow(), raw_secret, 3, 48)); core::result::unwrap(core::io::read_exact<std::stream::Descriptor>(stdin.borrow(), raw_data, 3, length));
        let saved_secret: [u8; 56] = raw_secret; let saved_data: [u8; 16700] = raw_data;
        let words_secret: [i32; 14] = [0; 14]; let words_data: [i32; 4175] = [0; 4175]; let words_destination: [i32; 4175] = [0; 4175]; let words_scratch: [i32; 4175] = [0; 4175];
        let secret: [u8] = raw_secret; let data: [u8] = raw_data; let destination: [u8] = raw_destination; let scratch: [u8] = raw_scratch;
        if (layout == 1) {
            secret = core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(words_secret), 56); data = core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(words_data), 16700);
            destination = core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(words_destination), 16700); scratch = core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(words_scratch), 16700);
            let index: i32 = 0; while (index < 56) { secret[index] = raw_secret[index]; index += 1; }
            index = 0; while (index < 16700) { data[index] = raw_data[index]; destination[index] = 221; scratch[index] = 222; index += 1; }
        }
        let sv: core::slice::View<u8> = core::slice::View { values: secret, start: 3, length: secret_length };
        let dv: core::slice::View<u8> = core::slice::View { values: data, start: 3, length: length };
        let target: core::slice::View<u8> = core::slice::View { values: destination, start: 3, length: capacity };
        let work: core::slice::View<u8> = core::slice::View { values: scratch, start: 3, length: capacity };
        output.word(core::mem::slice_stride(data) as u64); output.word(core::mem::slice_stride(destination) as u64);
        let allowed_destination: i32 = 0; let allowed_scratch: i32 = 0;
        if (operation == 0 || operation == 3) { allowed_destination = run_seal(selected, operation, sv, dv, content_type, padding, sequence, variant, target, output.borrow()); }
        if (operation == 1 || operation == 4) { allowed_scratch = run_open(selected, operation, sv, dv, sequence, variant, work, output.borrow()); }
        if (operation == 2) { lifecycle(selected, sv, dv, target, work, output.borrow()); allowed_destination = length + 31; allowed_scratch = length + 10; }
        if (operation == 5) { limit_lifecycle(selected, sv, dv, target, work, output.borrow()); allowed_destination = length + 31; allowed_scratch = length + 10; }
        let index: i32 = 0; while (index < 56) { assert(secret[index] == saved_secret[index]); index += 1; }
        index = 0; while (index < 16700) {
            assert(data[index] == saved_data[index]);
            if (index < 3 || index >= 3 + allowed_destination) { assert(destination[index] == 221); }
            if (index < 3 || index >= 3 + allowed_scratch) { assert(scratch[index] == 222); } index += 1;
        }
        case += 1;
    } output.flush(); return 0;
}
