// Count-prefixed fixed records: four u64 controls then 32 scalar/32 point bytes.
// Operations: public/shared/malformed/retained-copy/iterated. Errors are 1..4.
module app::main;
import core::io;
import core::mem;
import core::result;
import core::slice;
import ext::x25519;
import std::stream;
struct Output { bytes: [u8], used: i32 }
impl Output {
    fn borrow(&self) -> &Output { return self; }
    fn flush(&self) { let stdout: std::stream::Descriptor = std::stream::stdout(); assert(core::io::write_all(stdout.borrow(), self.bytes, 0, self.used).is_ok()); self.used = 0; }
    fn word(&self, value: u64) { if (self.used == 1024) { self.flush(); } let index: i32 = 0; while (index < 8) { self.bytes[self.used + index] = ((value >> (index * 8)) & 255) as u8; index += 1; } self.used += 8; }
    fn key(&self, key: ext::x25519::Key) { let index: i32 = 0; while (index < 32) { self.word(key.bytes[index] as u64); index += 1; } }
    fn result(&self, result: core::result::Result<ext::x25519::Key, ext::x25519::Error>) {
        if (result.is_ok()) { self.word(0); self.key(result.unwrap()); }
        else { self.word(match (result.unwrap_err()) { ext::x25519::Error::Bounds -> 1, ext::x25519::Error::InvalidScalarLength -> 2, ext::x25519::Error::InvalidPointLength -> 3, ext::x25519::Error::LowOrder -> 4 }); }
    }
}
fn decode(bytes: [u8], at: i32) -> u64 { let value: u64 = 0; let index: i32 = 0; while (index < 8) { value |= (bytes[at + index] as u64) << (index * 8); index += 1; } return value; }
fn run(operation: i32, packed: bool, mode: i32, repeat: i32, input: [u8], output: &Output) {
    let scalar_stack: [u8; 40] = [165; 40]; let point_stack: [u8; 40] = [221; 40];
    let scalar_words: [i32; 10] = [0; 10]; let point_words: [i32; 10] = [0; 10];
    let scalar: [u8] = scalar_stack; let point: [u8] = point_stack;
    if (packed) { scalar = core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(scalar_words), 40); point = core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(point_words), 40); }
    let index: i32 = 0; while (index < 40) { scalar[index] = 165; point[index] = 221; index += 1; }
    index = 0; while (index < 32) { scalar[3 + index] = input[index]; point[3 + index] = input[32 + index]; index += 1; }
    let scalar_view: core::slice::View<u8> = core::slice::View { values: scalar, start: 3, length: 32 };
    let point_view: core::slice::View<u8> = core::slice::View { values: point, start: 3, length: 32 };
    if (operation == 0) { output.result(ext::x25519::public_key(scalar_view)); }
    if (operation == 1) { output.result(ext::x25519::shared_secret(scalar_view, point_view)); }
    if (operation == 2) {
        if (mode == 0 || mode == 10) { scalar_view.start = -1; }
        if (mode == 1) { scalar_view.start = 2147483647; scalar_view.length = 1; }
        if (mode == 2) { scalar_view.length = -1; }
        if (mode == 3 || mode == 7 || mode == 8 || mode == 9) { scalar_view.length = 31; }
        if (mode == 4) { scalar_view.length = 33; }
        if (mode == 5 || mode == 8) { point_view.length = 31; }
        if (mode == 6) { point_view.length = 33; }
        if (mode == 7) { point_view.start = -1; }
        if (mode == 9) { point_view.start = 2147483647; }
        if (mode == 11 || mode == 13 || mode == 15) { scalar_view.length = 0; }
        if (mode == 12) { point_view.length = -1; }
        if (mode == 13 || mode == 14) { point_view.length = 0; }
        if (mode == 14) { point_view.start = 2147483647; }
        if (mode == 15) { scalar_view.start = 2147483647; }
        if (mode == 10 || mode == 11 || mode == 15) { output.result(ext::x25519::public_key(scalar_view)); }
        else { output.result(ext::x25519::shared_secret(scalar_view, point_view)); }
    }
    if (operation == 3) {
        let first: ext::x25519::Key = ext::x25519::public_key(scalar_view).unwrap(); let retained: ext::x25519::Key = first;
        first.bytes[0] ^= 255; scalar[15] ^= 1;
        let second: ext::x25519::Key = ext::x25519::public_key(scalar_view).unwrap();
        output.word(0); output.key(retained); output.key(first); output.key(second);
    }
    if (operation == 4) {
        let round: i32 = 0;
        while (round < repeat) {
            let next: ext::x25519::Key = ext::x25519::shared_secret(scalar_view, point_view).unwrap();
            index = 0; while (index < 32) { point[3 + index] = scalar[3 + index]; scalar[3 + index] = next.bytes[index]; index += 1; } round += 1;
        }
        let bytes: [u8; 32] = [0; 32]; index = 0; while (index < 32) { bytes[index] = scalar[3 + index]; index += 1; }
        output.word(0); output.key(ext::x25519::Key { bytes: bytes });
    }
    index = 0;
    while (index < 40) {
        if (index < 3 || index >= 35) { assert(scalar[index] == 165 && point[index] == 221); }
        else { if (operation != 4) {
            let expected: u8 = input[index - 3]; if (operation == 3 && index == 15) { expected ^= 1; }
            assert(scalar[index] == expected && point[index] == input[32 + index - 3]);
        } } index += 1;
    }
}
fn main() -> i32 {
    let bytes: [u8; 1024] = [0; 1024]; let output: Output = Output { bytes: bytes, used: 0 };
    let stdin: std::stream::Descriptor = std::stream::stdin(); let header: [u8; 32] = [0; 32]; let input: [u8; 64] = [0; 64];
    assert(core::io::read_exact(stdin.borrow(), header, 0, 8).is_ok()); let count: u64 = decode(header, 0); assert(count <= 1024); let index: u64 = 0;
    while (index < count) {
        assert(core::io::read_exact(stdin.borrow(), header, 0, 32).is_ok() && core::io::read_exact(stdin.borrow(), input, 0, 64).is_ok());
        let operation: u64 = decode(header, 0); let layout: u64 = decode(header, 8); let mode: u64 = decode(header, 16); let repeat: u64 = decode(header, 24);
        assert(operation <= 4 && layout <= 1 && mode <= 15 && repeat <= 1000);
        run(operation as i32, layout == 1, mode as i32, repeat as i32, input, output.borrow()); index += 1;
    }
    output.flush(); return 0;
}
