module app::main;
import alloc::vec;
import core::i64;
import core::result;
import core::slice;
import ext::weighted_graph;

fn edge(source:i32,target:i32,cost:i64) -> ext::weighted_graph::Edge { return ext::weighted_graph::Edge { source:source,target:target,cost:cost }; }
fn equal(value:ext::weighted_graph::Edge,source:i32,target:i32,cost:i64) { assert(value.source==source && value.target==target && value.cost==cost); }
fn failed<T>(value:core::result::Result<T,ext::weighted_graph::Error>,kind:ext::weighted_graph::ErrorKind,node:i32,index:i32) {
    assert(value.is_err()); let error=value.unwrap_err(); assert(error.kind==kind && error.node==node && error.edge==index);
}
fn make(nodes:i32,edges:[ext::weighted_graph::Edge],count:i32) -> ext::weighted_graph::Graph {
    return ext::weighted_graph::from_edges(nodes,core::slice::view(edges,count).unwrap(),ext::weighted_graph::default_limits()).unwrap();
}
fn multigraph_and_independent_owners() {
    let limits=ext::weighted_graph::default_limits();
    let guard=edge(-7,-8,-9);
    let raw:[ext::weighted_graph::Edge;9]=[guard,edge(2,3,2),edge(0,2,4),edge(1,2,-1),edge(0,1,2),edge(1,2,-1),edge(1,2,7),edge(4,4,0),guard];
    let graph=ext::weighted_graph::from_edges(5,core::slice::view_range(raw,1,7).unwrap(),limits).unwrap();
    assert(graph.is_open() && graph.node_count()==5 && graph.edge_count()==7);
    let view=graph.view().unwrap(); let expected:[i32;6]=[0,2,5,6,6,7]; let i:i32=0;
    while(i<6) { assert(view.offsets.get(i).unwrap()==expected[i]); i+=1; }
    let row=ext::weighted_graph::neighbors(view,1,limits).unwrap();
    assert(row.len()==3 && row.get(0).unwrap().cost==-1 && row.get(1).unwrap().cost==-1 && row.get(2).unwrap().cost==7);
    assert(ext::weighted_graph::neighbors(view,3,limits).unwrap().is_empty());
    failed(ext::weighted_graph::dijkstra(view,0,limits),ext::weighted_graph::ErrorKind::NegativeEdge,1,2);
    let copy=ext::weighted_graph::from_view(view,limits).unwrap();
    let paths=ext::weighted_graph::bellman_ford(view,0,limits).unwrap();
    assert(paths.is_open() && paths.node_count()==5 && paths.source().unwrap()==0);
    assert(paths.distance(0).unwrap().unwrap()==0 && paths.predecessor(0).unwrap().is_none());
    assert(paths.distance(1).unwrap().unwrap()==2 && paths.distance(2).unwrap().unwrap()==1 && paths.distance(3).unwrap().unwrap()==3);
    assert(paths.distance(4).unwrap().is_none() && paths.predecessor(4).unwrap().is_none() && paths.path_to(4,limits).unwrap().is_none());
    let empty=paths.path_to(0,limits).unwrap().unwrap(); assert(empty.len()==0); empty.destroy();
    let path=paths.path_to(3,limits).unwrap().unwrap(); assert(path.len()==3);
    equal(paths.predecessor(3).unwrap().unwrap(),2,3,2);
    assert(graph.destroy() && !graph.destroy() && graph.view().is_none() && graph.edge_count()==0 && graph.node_count()==0);
    assert(ext::weighted_graph::validate(copy.view().unwrap(),limits).unwrap()==7); assert(copy.destroy());
    assert(paths.distance(3).unwrap().unwrap()==3); assert(paths.destroy() && !paths.destroy() && !paths.is_open());
    assert(paths.source().is_none() && paths.node_count()==0);
    failed(paths.distance(-1),ext::weighted_graph::ErrorKind::Closed,-1,-1);
    failed(paths.predecessor(9),ext::weighted_graph::ErrorKind::Closed,-1,-1);
    failed(paths.path_to(-1,limits),ext::weighted_graph::ErrorKind::Closed,-1,-1);
    equal(path.at(0),0,1,2); equal(path.at(1),1,2,-1); equal(path.at(2),2,3,2); path.destroy();
    equal(raw[0],-7,-8,-9); equal(raw[8],-7,-8,-9); equal(raw[1],2,3,2); equal(raw[2],0,2,4); equal(raw[3],1,2,-1); equal(raw[4],0,1,2); equal(raw[5],1,2,-1); equal(raw[6],1,2,7); equal(raw[7],4,4,0);
}
fn ties_zero_cycles_and_stale_queue() {
    let limits=ext::weighted_graph::default_limits();
    let raw:[ext::weighted_graph::Edge;8]=[edge(0,2,1),edge(2,3,1),edge(0,1,1),edge(1,3,1),edge(1,2,0),edge(2,1,0),edge(0,3,9),edge(3,3,0)];
    let graph=make(4,raw,8); let view=graph.view().unwrap();
    let d=ext::weighted_graph::dijkstra(view,0,limits).unwrap(); let b=ext::weighted_graph::bellman_ford(view,0,limits).unwrap();
    equal(d.predecessor(3).unwrap().unwrap(),1,3,1); equal(b.predecessor(3).unwrap().unwrap(),1,3,1);
    assert(d.distance(3).unwrap().unwrap()==2 && b.distance(3).unwrap().unwrap()==2);
    let path=d.path_to(3,limits).unwrap().unwrap(); assert(path.len()==2); equal(path.at(0),0,1,1); equal(path.at(1),1,3,1);
    path.destroy(); d.destroy(); b.destroy(); graph.destroy();
    // The obsolete cost=10 entry for node1 must not examine its MAX-1 arc.
    let stale:[ext::weighted_graph::Edge;4]=[edge(0,1,10),edge(0,2,0),edge(2,1,1),edge(1,3,9223372036854775806)];
    let g=make(4,stale,4); let p=ext::weighted_graph::dijkstra(g.view().unwrap(),0,limits).unwrap();
    assert(p.distance(3).unwrap().unwrap()==core::i64::MAX); p.destroy(); g.destroy();
}
fn full_width_costs_and_overflow() {
    let limits=ext::weighted_graph::default_limits();
    let extremes:[ext::weighted_graph::Edge;2]=[edge(0,1,core::i64::MIN),edge(0,2,core::i64::MAX)];
    let graph=make(3,extremes,2); let p=ext::weighted_graph::bellman_ford(graph.view().unwrap(),0,limits).unwrap();
    assert(p.distance(1).unwrap().unwrap()==core::i64::MIN && p.distance(2).unwrap().unwrap()==core::i64::MAX); p.destroy(); graph.destroy();
    let positive:[ext::weighted_graph::Edge;2]=[edge(0,1,core::i64::MAX),edge(1,0,1)];
    let g=make(2,positive,2);
    // The candidate cannot improve source0; it must still fail checked addition.
    failed(ext::weighted_graph::dijkstra(g.view().unwrap(),0,limits),ext::weighted_graph::ErrorKind::Overflow,1,1);
    failed(ext::weighted_graph::bellman_ford(g.view().unwrap(),0,limits),ext::weighted_graph::ErrorKind::Overflow,1,1); g.destroy();
    let negative:[ext::weighted_graph::Edge;2]=[edge(0,1,core::i64::MIN),edge(1,2,-1)];
    let h=make(3,negative,2); failed(ext::weighted_graph::bellman_ford(h.view().unwrap(),0,limits),ext::weighted_graph::ErrorKind::Overflow,1,1); h.destroy();
    let unreachable:[ext::weighted_graph::Edge;3]=[edge(0,1,7),edge(2,3,core::i64::MAX),edge(3,2,1)];
    let k=make(4,unreachable,3); let d=ext::weighted_graph::dijkstra(k.view().unwrap(),0,limits).unwrap(); let b=ext::weighted_graph::bellman_ford(k.view().unwrap(),0,limits).unwrap();
    assert(d.distance(1).unwrap().unwrap()==7 && b.distance(2).unwrap().is_none()); d.destroy(); b.destroy(); k.destroy();
}
fn negative_cycles_and_precedence() {
    let limits=ext::weighted_graph::default_limits();
    let disconnected:[ext::weighted_graph::Edge;3]=[edge(0,1,5),edge(2,3,-2),edge(3,2,1)];
    let graph=make(4,disconnected,3);
    failed(ext::weighted_graph::dijkstra(graph.view().unwrap(),0,limits),ext::weighted_graph::ErrorKind::NegativeEdge,2,1);
    let p=ext::weighted_graph::bellman_ford(graph.view().unwrap(),0,limits).unwrap(); assert(p.distance(1).unwrap().unwrap()==5 && p.distance(3).unwrap().is_none()); p.destroy();
    failed(ext::weighted_graph::bellman_ford(graph.view().unwrap(),2,limits),ext::weighted_graph::ErrorKind::NegativeCycle,2,1); graph.destroy();
    let self_loop:[ext::weighted_graph::Edge;1]=[edge(0,0,-1)]; let one=make(1,self_loop,1);
    failed(ext::weighted_graph::bellman_ford(one.view().unwrap(),0,limits),ext::weighted_graph::ErrorKind::NegativeCycle,0,0); one.destroy();
    let underflow:[ext::weighted_graph::Edge;2]=[edge(0,1,core::i64::MIN),edge(1,1,-1)]; let g=make(2,underflow,2);
    failed(ext::weighted_graph::bellman_ford(g.view().unwrap(),0,limits),ext::weighted_graph::ErrorKind::Overflow,1,1); g.destroy();
    // Node0 first becomes reachable in the last row of the only pass. In
    // the final scan its cycle precedes the later 1+MAX overflow candidate.
    let ordering:[ext::weighted_graph::Edge;3]=[edge(0,0,-1),edge(0,1,core::i64::MAX),edge(1,0,1)]; let h=make(2,ordering,3);
    failed(ext::weighted_graph::bellman_ford(h.view().unwrap(),1,limits),ext::weighted_graph::ErrorKind::NegativeCycle,0,0); h.destroy();
    let reverse:[ext::weighted_graph::Edge;3]=[edge(0,0,core::i64::MAX),edge(0,1,-2),edge(1,0,1)]; let k=make(2,reverse,3);
    failed(ext::weighted_graph::bellman_ford(k.view().unwrap(),1,limits),ext::weighted_graph::ErrorKind::Overflow,0,0); k.destroy();
}
fn main() -> i32 { multigraph_and_independent_owners(); ties_zero_cycles_and_stale_queue(); full_width_costs_and_overflow(); negative_cycles_and_precedence(); return 0; }
