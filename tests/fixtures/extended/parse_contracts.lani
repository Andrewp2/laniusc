module app::main;
import core::mem;
import core::option;
import core::result;
import core::slice;
import core::text;
import ext::parse;
fn literal(value: str, count: i32) -> core::text::Text { let bytes: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::string_data_ptr(value),count); return core::text::from_utf8_unchecked(bytes,0,count); }
fn main() -> i32 {
    let cursor: ext::parse::Cursor = core::result::unwrap(ext::parse::new(literal("abc 123\r\nλ\0z",13),ext::parse::default_limits()));
    let mark: ext::parse::Checkpoint = cursor.checkpoint();
    let identifier: ext::parse::Span = core::result::unwrap(cursor.identifier());
    assert(identifier.text.equals(literal("abc",3))); assert(identifier.start.offset == 0 && identifier.end.column == 4);
    assert(core::result::unwrap(cursor.whitespace()).byte_len() == 1);
    assert(core::result::unwrap(cursor.integer_i64()) == 123);
    assert(core::result::unwrap(cursor.whitespace()).byte_len() == 2);
    let location: ext::parse::Location = cursor.location(); assert(location.offset == 9 && location.line == 2 && location.column == 1);
    assert(core::option::unwrap(core::result::unwrap(cursor.peek_scalar())) == 955); assert(cursor.position() == 9);
    assert(core::option::unwrap(core::result::unwrap(cursor.take_scalar())) == 955);
    assert(core::result::unwrap(cursor.take_byte(0)).byte_len() == 1);
    assert(core::result::unwrap(cursor.take_byte(122)).byte_len() == 1);
    assert(core::option::is_none(core::result::unwrap(cursor.take_scalar()))); assert(cursor.is_eof());
    assert(core::result::unwrap(cursor.restore(mark)) == 0);
    let foreign: ext::parse::Cursor = core::result::unwrap(ext::parse::new(literal("other",5),ext::parse::default_limits()));
    assert(core::result::unwrap_err(cursor.restore(foreign.checkpoint())).kind == ext::parse::ErrorKind::ForeignCheckpoint);
    assert(cursor.position() == 0);
    assert(core::result::unwrap_err(cursor.tag(literal("abd",3))).location.offset == 2); assert(cursor.position() == 0);
    assert(core::result::unwrap_err(cursor.take_text(10)).kind == ext::parse::ErrorKind::Bounds); assert(cursor.position() == 0);
    assert(core::result::unwrap(cursor.scan_until(955)).byte_len() == 9);
    assert(core::result::unwrap(cursor.take_text(2)).byte_len() == 2);
    let number: ext::parse::Cursor = core::result::unwrap(ext::parse::new(literal("-9223372036854775808+9223372036854775808",40),ext::parse::default_limits()));
    assert(core::result::unwrap(number.integer_i64()) == -9223372036854775808);
    let overflow: ext::parse::Error = core::result::unwrap_err(number.integer_i64());
    assert(overflow.kind == ext::parse::ErrorKind::Overflow && overflow.location.offset == 39); assert(number.position() == 20);
    let real: ext::parse::Cursor = core::result::unwrap(ext::parse::new(literal("+001.25e-2!",11),ext::parse::default_limits()));
    let decimal: ext::parse::Span = core::result::unwrap(real.decimal()); assert(decimal.byte_len() == 10 && decimal.bytes().length == 10);
    let invalid: ext::parse::Cursor = core::result::unwrap(ext::parse::new(literal("1e+!",4),ext::parse::default_limits()));
    assert(core::result::unwrap_err(invalid.decimal()).location.offset == 3); assert(invalid.position() == 0);
    let small: ext::parse::Cursor = core::result::unwrap(ext::parse::new(literal("abcd!",5),ext::parse::Limits { max_scan_bytes: 3, max_work: 100 }));
    assert(core::result::unwrap_err(small.identifier()).kind == ext::parse::ErrorKind::ScanLimit); assert(small.position() == 0);
    let spent: ext::parse::Cursor = core::result::unwrap(ext::parse::new(literal("ab",2),ext::parse::Limits { max_scan_bytes: 8, max_work: 3 }));
    let saved: ext::parse::Checkpoint = spent.checkpoint();
    assert(core::result::unwrap_err(spent.identifier()).kind == ext::parse::ErrorKind::WorkLimit); assert(spent.position() == 0 && spent.remaining_work() == 0);
    core::result::unwrap(spent.restore(saved)); assert(spent.remaining_work() == 0);
    let bytes: [u8;4] = [65,13,255,0];
    let bad: ext::parse::Error = core::result::unwrap_err(ext::parse::from_utf8_range(bytes,0,3,ext::parse::default_limits()));
    assert(bad.kind == ext::parse::ErrorKind::InvalidUtf8 && bad.location.offset == 2 && bad.location.line == 2 && bad.location.column == 1);
    assert(core::result::unwrap_err(ext::parse::from_utf8_range(bytes,-1,3,ext::parse::default_limits())).kind == ext::parse::ErrorKind::Bounds);
    assert(core::result::unwrap_err(ext::parse::from_utf8_range(bytes,2147483647,1,ext::parse::default_limits())).kind == ext::parse::ErrorKind::Bounds);
    assert(core::result::unwrap_err(ext::parse::from_utf8_range(bytes,0,-1,ext::parse::default_limits())).kind == ext::parse::ErrorKind::Bounds);
    assert(core::result::unwrap_err(ext::parse::from_utf8_range(bytes,0,2147483647,ext::parse::default_limits())).kind == ext::parse::ErrorKind::Bounds);
    assert(core::result::unwrap_err(ext::parse::from_utf8_range(bytes,0,1,ext::parse::Limits { max_scan_bytes: -1, max_work: 100 })).kind == ext::parse::ErrorKind::Bounds);
    let shared: [u8;3] = [97,98,99];
    let left: ext::parse::Cursor = core::result::unwrap(ext::parse::from_utf8_range(shared,0,2,ext::parse::default_limits()));
    let displaced: ext::parse::Cursor = core::result::unwrap(ext::parse::from_utf8_range(shared,1,2,ext::parse::default_limits()));
    let shorter: ext::parse::Cursor = core::result::unwrap(ext::parse::from_utf8_range(shared,0,1,ext::parse::default_limits()));
    assert(core::result::unwrap_err(left.restore(displaced.checkpoint())).kind == ext::parse::ErrorKind::ForeignCheckpoint);
    assert(core::result::unwrap_err(left.restore(shorter.checkpoint())).kind == ext::parse::ErrorKind::ForeignCheckpoint);
    let same: ext::parse::Cursor = core::result::unwrap(ext::parse::from_utf8_range(shared,0,2,ext::parse::default_limits()));
    core::result::unwrap(same.take_byte(97)); assert(core::result::unwrap(left.restore(same.checkpoint())) == 1);
    let raw: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::i32_slice_data_ptr(shared),1);
    let changed_stride: ext::parse::Cursor = core::result::unwrap(ext::parse::from_utf8_range(raw,0,1,ext::parse::default_limits()));
    assert(core::result::unwrap_err(shorter.restore(changed_stride.checkpoint())).kind == ext::parse::ErrorKind::ForeignCheckpoint);
    return 0;
}
