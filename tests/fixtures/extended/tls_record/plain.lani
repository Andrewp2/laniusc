// Ordinary use: no Error projection/match or private Traffic access.
module app::main;
import core::io;
import core::result;
import core::slice;
import ext::tls_record;
import std::stream;
fn main() -> i32 {
    let secret: [u8; 32] = [0; 32]; let secret_view: core::slice::View<u8> = core::slice::View { values: secret, start: 0, length: 32 };
    let send: ext::tls_record::Sealer = core::result::unwrap(ext::tls_record::sealer(secret_view));
    let receive: ext::tls_record::Opener = core::result::unwrap(ext::tls_record::opener(secret_view));
    // Both constructors own their key material; no borrow of secret survives.
    let index: i32 = 0; while (index < 32) { secret[index] = 255; index += 1; }
    let message: [u8; 5] = [104, 101, 108, 108, 111]; let record: [u8; 64] = [165; 64]; let scratch: [u8; 64] = [166; 64];
    let content: core::slice::View<u8> = core::slice::View { values: message, start: 0, length: 5 };
    let target: core::slice::View<u8> = core::slice::View { values: record, start: 3, length: 61 };
    let work: core::slice::View<u8> = core::slice::View { values: scratch, start: 3, length: 61 };
    let count: i32 = core::result::unwrap(send.seal(content, 23, 7, target));
    let framed: core::slice::View<u8> = core::slice::View { values: record, start: 3, length: count };
    let opened: ext::tls_record::Opened = core::result::unwrap(receive.open(framed, work));
    assert(count == 34 && opened.content_type == 23 && opened.content.length == 5);
    index = 0; while (index < 5) { assert(opened.content.values[opened.content.start + index] == message[index]); index += 1; }
    assert(send.sequence() == 1 && receive.sequence() == 1 && !send.exhausted() && !receive.is_poisoned());
    let stdout: std::stream::Descriptor = std::stream::stdout(); core::result::unwrap(core::io::write_all<std::stream::Descriptor>(stdout.borrow(), record, 3, count));
    core::result::unwrap(send.key_update()); core::result::unwrap(receive.key_update()); assert(send.sequence() == 0 && receive.sequence() == 0);
    let empty: core::slice::View<u8> = core::slice::View { values: message, start: 0, length: 0 };
    let second: i32 = core::result::unwrap(send.seal(empty, 23, 0, target));
    let next: core::slice::View<u8> = core::slice::View { values: record, start: 3, length: second };
    let decoded: ext::tls_record::Opened = core::result::unwrap(receive.open(next, work)); assert(decoded.content.length == 0 && decoded.content_type == 23);
    core::result::unwrap(core::io::write_all<std::stream::Descriptor>(stdout.borrow(), record, 3, second));
    assert(record[0] == 165 && record[1] == 165 && record[2] == 165 && record[37] == 165);
    assert(scratch[0] == 166 && scratch[1] == 166 && scratch[2] == 166 && scratch[16] == 166); return 0;
}
