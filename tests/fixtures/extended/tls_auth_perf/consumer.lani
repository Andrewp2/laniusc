fn view(bytes: [u8], start: i32, length: i32) -> core::slice::View<u8> { return core::slice::View { values: bytes, start: start, length: length }; }
fn same(a: core::slice::View<u8>, b: core::slice::View<u8>) { assert(a.length == b.length); let i:i32=0; while(i<a.length){assert(a.values[a.start+i]==b.values[b.start+i]);i+=1;} }
