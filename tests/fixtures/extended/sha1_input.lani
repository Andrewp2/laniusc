module app::main;
import core::result;
import core::sha1;
import core::slice;
import std::io_byte;
import core::io;
import std::stream;
fn main() -> i32 {
    let state:core::sha1::State=core::sha1::new(); let block:[u8;73]=[0;73]; let count:i32=0;
    while(true) { let next:i32=std::io_byte::read_stdin_byte_or(-1,-2); if(next==-2) { return 2; } if(next==-1) { break; } block[count]=next as u8; count+=1;
        if(count==73) { core::result::unwrap(state.update(core::result::unwrap(core::slice::view(block,count)))); count=0; }
    }
    core::result::unwrap(state.update(core::result::unwrap(core::slice::view(block,count)))); let digest:core::sha1::Digest=state.finish(); let sink:std::stream::Descriptor=std::stream::from_handle(1); if(core::result::is_err(core::io::write_all(sink.borrow(),digest.bytes,0,20))) { return 3; } return 0;
}
