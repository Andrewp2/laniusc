module app::main;
import core::sha512;
import core::slice;
import ext::hmac_sha384;
import ext::hkdf_sha384;
fn view(bytes:[u8],n:i32)->core::slice::View<u8>{return core::slice::View<u8>{values:bytes,start:0,length:n};}
fn equal(a:[u8],b:[u8],n:i32){let i:i32=0;while(i<n){assert(a[i]==b[i]);i+=1;}}
fn checked(d:core::sha512::Digest){assert(d.length==48);let i:i32=48;while(i<64){assert(d.bytes[i]==0);i+=1;}}
fn main()->i32{
 let key:[u8;20]=[11;20];let message:[u8;8]=[72,105,32,84,104,101,114,101];
 let expected:[u8;48]=[175,208,57,68,216,72,149,98,107,8,37,244,171,70,144,127,21,249,218,219,228,16,30,198,130,170,3,76,124,235,197,156,250,234,158,169,7,110,222,127,74,241,82,232,178,250,156,182];
 let info:[u8;5]=[108,97,98,101,108];let first:[u8;96]=[0;96];let second:[u8;96]=[0;96];
 let state:ext::hmac_sha384::State=ext::hmac_sha384::new(view(key,20)).unwrap();assert(state.update(view(message,8)).unwrap()==8);let tag:core::sha512::Digest=state.finish();checked(tag);equal(tag.bytes,expected,48);
 let retained:core::sha512::Digest=tag;tag.bytes[0]^=1;tag.bytes[63]=1;state.reset();let direct:core::sha512::Digest=ext::hmac_sha384::authenticate(view(key,20),view(message,8)).unwrap();checked(direct);equal(direct.bytes,retained.bytes,64);
 let extracted:core::sha512::Digest=ext::hkdf_sha384::extract(view(key,20),view(message,8)).unwrap();checked(extracted);equal(extracted.bytes,retained.bytes,64);
 assert(ext::hkdf_sha384::expand(view(extracted.bytes,48),view(info,5),view(first,96)).unwrap()==96);assert(ext::hkdf_sha384::derive(view(key,20),view(message,8),view(info,5),view(second,96)).unwrap()==96);equal(first,second,96);
 let hashed:core::sha512::Digest=core::sha512::digest384(view(first,96)).unwrap();checked(hashed);let composed:core::sha512::Digest=ext::hmac_sha384::authenticate(view(hashed.bytes,48),view(second,96)).unwrap();checked(composed);equal(retained.bytes,expected,48);return 0;
}
