// Ordinary imported use of both hashes without projecting either Error enum.
module app::main;
import core::result; import core::slice;
import ext::tls_hash; import ext::tls_schedule; import ext::tls_transcript;
fn exercise(algorithm:ext::tls_hash::Algorithm){
 let client:[u8;4]=[1,0,0,0];let server:[u8;4]=[2,0,0,0];let shared:[u8;32]=[7;32];
 let transcript:ext::tls_transcript::State=ext::tls_transcript::new(algorithm);transcript.update(core::slice::View{values:client,start:0,length:4}).unwrap();let first:ext::tls_hash::Digest=transcript.snapshot();
 let early:ext::tls_schedule::Early=ext::tls_schedule::no_psk(algorithm);let early_traffic:ext::tls_schedule::Secret=early.traffic(first).unwrap();
 transcript.update(core::slice::View{values:server,start:0,length:4}).unwrap();let hash:ext::tls_hash::Digest=transcript.snapshot();
 let handshake:ext::tls_schedule::Handshake=early.handshake(core::slice::View{values:shared,start:0,length:32}).unwrap();let secret:ext::tls_schedule::Secret=handshake.traffic(ext::tls_schedule::Side::Server,hash).unwrap();
 let finished:ext::tls_schedule::Secret=ext::tls_schedule::finished(secret,hash).unwrap();assert(ext::tls_schedule::verify_finished(secret,hash,finished.view()).unwrap());
 let master:ext::tls_schedule::Master=handshake.master();let application:ext::tls_schedule::Secret=master.traffic(ext::tls_schedule::Side::Client,hash).unwrap();
 assert(transcript.messages()==2&&!transcript.used_hrr());let difference:u32=0;let i:i32=0;while(i<ext::tls_hash::hash_length(algorithm)){difference|=(application.bytes[i]^early_traffic.bytes[i]) as u32;i+=1;}assert(difference!=0);
 i=ext::tls_hash::hash_length(algorithm);while(i<48){assert(application.bytes[i]==0&&finished.bytes[i]==0&&hash.bytes[i]==0);i+=1;}
}
fn main()->i32{exercise(ext::tls_hash::Algorithm::Sha256);exercise(ext::tls_hash::Algorithm::Sha384);return 0;}
