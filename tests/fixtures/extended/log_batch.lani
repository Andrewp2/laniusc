module app::main;
import core::io;
import core::mem;
import core::option;
import core::result;
import core::slice;
import core::text;
import ext::log;
import std::process;
import std::stream;
fn text(value: str, length: i32) -> core::text::Text { let pointer: ptr = core::mem::string_data_ptr(value); let bytes: [u8] = core::mem::typed_slice_from_raw_parts(pointer, length); return core::text::from_utf8_unchecked(bytes, 0, length); }
fn main() -> i32 {
    let argument: [i32; 8] = [0;8]; let pointer: ptr = core::mem::i32_array_data_ptr(argument); let bytes: [u8] = core::mem::typed_slice_from_raw_parts(pointer,32);
    let size: i32 = std::process::arg_len(1); if (size < 1 || size > 32) { return 2; } if (std::process::arg_read(1,pointer,size as usize) != size) { return 3; }
    let count_text: core::text::Text = core::result::unwrap(core::text::from_utf8(bytes,size)); let count: i32 = core::result::unwrap(count_text.parse_i32()); if (count < 0 || count > 1000000) { return 2; }
    let fields: [ext::log::Field; 1] = [ext::log::Field { key: text("n",1), value: ext::log::Value::Signed(0) }];
    let record: ext::log::Record = ext::log::Record { level: ext::log::Level::Info, target: text("batch",5), message: text("item",4), fields: core::result::unwrap(core::slice::view(fields,1)) };
    let scratch: [u8; 128] = [0;128]; let sink: std::stream::Descriptor = std::stream::stdout(); let index: i32 = 0;
    while (index < count) {
        fields[0] = ext::log::Field { key: text("n",1), value: ext::log::Value::Signed(index as i64) };
        let prepared: ext::log::Outcome = core::result::unwrap(ext::log::prepare(ext::log::Filter::AtLeast(ext::log::Level::Info),record.borrow(),scratch,128));
        let length: i32 = match (prepared) { ext::log::Outcome::Encoded(size) -> size, ext::log::Outcome::Filtered -> 0 };
        if (core::result::is_err(core::io::write_all(sink.borrow(),scratch,0,length))) { return 3; } index += 1;
    }
    return 0;
}
