fn view(b: [u8], n: i32) -> core::slice::View<u8> { return core::slice::View { values: b, start: 0, length: n }; }
fn arg(index: i32, pointer: ptr) -> i32 { let n: i32 = std::process::arg_len(index); assert(n >= 0 && n <= 16384); assert(std::process::arg_read(index, pointer, n as usize) == n); return n; }
fn number(bytes: [u8], n: i32) -> u64 { assert(n > 0 && n <= 12); let total: u64 = 0; let i: i32 = 0; while (i < n) { assert(bytes[i] >= 48 && bytes[i] <= 57); total = total * 10 + ((bytes[i] - 48) as u64); i += 1; } return total; }
fn digit(c: u8) -> i32 { if (c >= 48 && c <= 57) { return (c - 48) as i32; } if (c >= 97 && c <= 102) { return (c - 97 + 10) as i32; } return -1; }
