fn soft(e: ext::tls_tcp::Error) -> bool { return match(e) { ext::tls_tcp::Error::Engine(inner) -> match(inner) { ext::tls_connection::Error::WantInput -> true, ext::tls_connection::Error::WantRead -> true, ext::tls_connection::Error::WantOutput -> true, _ -> false }, _ -> false }; }
fn word(bytes: [u8], at: i32, n: u64) { let i: i32 = 0; while (i < 8) { bytes[at + i] = ((n >> (8 * i)) & 255) as u8; i += 1; } }
