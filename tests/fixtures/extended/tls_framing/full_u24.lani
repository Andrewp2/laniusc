// Full wire-domain boundary with one explicit owned allocation. Production
// framing remains allocation-free. Every returned status passes through destroy.
module app::main;
import alloc::vec;
import core::io;
import core::mem;
import core::result;
import core::slice;
import ext::tls_framing;
import std::stream;
fn invalid_limit(error: ext::tls_framing::Error) -> bool {
    return match (error) {
        ext::tls_framing::Error::Bounds -> false,
        ext::tls_framing::Error::InvalidLimit -> true,
        ext::tls_framing::Error::BufferTooSmall -> false,
        ext::tls_framing::Error::Ready -> false,
        ext::tls_framing::Error::NotReady -> false,
        ext::tls_framing::Error::TooLarge -> false,
        ext::tls_framing::Error::Poisoned -> false
    };
}
fn exercise(owner: &alloc::vec::Vec<u8>, summary: [u64]) -> i32 {
    let body_length: i32=16777215; let wire_length: i32=body_length+4;
    let backing: [u8]=owner.as_slice();
    let storage: core::slice::View<u8> = core::slice::View { values: backing, start: 3, length: wire_length };
    if (core::mem::slice_stride(backing) != 1) { return 2; }
    let too_big: core::result::Result<ext::tls_framing::HandshakeDecoder,ext::tls_framing::Error> = ext::tls_framing::handshake_decoder(storage,16777216);
    if (too_big.is_ok()) { return 3; }
    if (!invalid_limit(too_big.unwrap_err())) { return 4; }
    let made: core::result::Result<ext::tls_framing::HandshakeDecoder,ext::tls_framing::Error> = ext::tls_framing::handshake_decoder(storage,body_length);
    if (made.is_err()) { return 5; }
    let decoder: ext::tls_framing::HandshakeDecoder=made.unwrap();
    let header: [u8;4]=[253,255,255,255];
    let part: core::result::Result<ext::tls_framing::Progress,ext::tls_framing::FeedFailure> = decoder.feed(core::slice::View { values: header, start: 0, length: 3 });
    if (part.is_err()) { return 6; }
    let prefix: ext::tls_framing::Progress=part.unwrap();
    if (prefix.consumed != 3 || prefix.ready || decoder.buffered() != 3) { return 7; }
    part=decoder.feed(core::slice::View { values: header, start: 3, length: 1 });
    if (part.is_err()) { return 8; }
    let completed_header: ext::tls_framing::Progress=part.unwrap();
    if (completed_header.consumed != 1 || completed_header.ready || decoder.buffered() != 4) { return 9; }
    let chunk: [u8;4096]=[0;4096]; let at: i32=0;
    while (at < 4096) { chunk[at]=(at&255) as u8; at+=1; }
    let offered: core::slice::View<u8> = core::slice::View { values: chunk, start: 0, length: 4096 };
    let copied: i32=0; let calls: i32=0;
    while (copied < body_length) {
        let expected: i32=body_length-copied; if (expected > 4096) { expected=4096; }
        // The final call offers one byte of the next frame. It must remain unconsumed.
        part=decoder.feed(offered); if (part.is_err()) { return 10; }
        let progress: ext::tls_framing::Progress=part.unwrap();
        if (progress.consumed != expected || progress.ready != (copied+expected == body_length)) { return 11; }
        copied+=expected; calls+=1;
        if (decoder.buffered() != 4+copied) { return 12; }
    }
    let checked: core::result::Result<ext::tls_framing::HandshakeFrame,ext::tls_framing::Error> = decoder.frame();
    if (checked.is_err()) { return 13; }
    let frame: ext::tls_framing::HandshakeFrame=checked.unwrap();
    if (frame.kind != 253 || frame.wire.length != wire_length || frame.body.length != body_length) { return 14; }
    at=0; let sum: u64=0;
    while (at < body_length) {
        let value: u8=frame.body.values[frame.body.start+at];
        if (value != ((at&255) as u8)) { return 15; }
        sum+=value as u64; at+=1;
    }
    if (header[0] != 253 || header[1] != 255 || header[2] != 255 || header[3] != 255) { return 27; }
    at=0; while (at < 4096) { if (chunk[at] != ((at&255) as u8)) { return 16; } at+=1; }
    at=0; while (at < owner.len()) { if (at < 3 || at >= 3+wire_length) { if (backing[at] != 222) { return 17; } } at+=1; }
    let consumed: core::result::Result<i32,ext::tls_framing::Error> = decoder.consume();
    if (consumed.is_err()) { return 18; }
    if (consumed.unwrap() != wire_length || decoder.buffered() != 0 || decoder.ready() || decoder.reset() != 0) { return 19; }
    part=decoder.feed(core::slice::View { values: header, start: 0, length: 3 });
    if (part.is_err()) { return 20; }
    let truncated: ext::tls_framing::Progress=part.unwrap();
    if (truncated.consumed != 3 || truncated.ready || decoder.reset() != 3 || decoder.buffered() != 0) { return 21; }
    let zero: [u8;4]=[2,0,0,0];
    part=decoder.feed(core::slice::View { values: zero, start: 0, length: 4 });
    if (part.is_err()) { return 22; }
    let empty: ext::tls_framing::Progress=part.unwrap();
    if (empty.consumed != 4 || !empty.ready) { return 23; }
    let ended: core::result::Result<i32,ext::tls_framing::Error> = decoder.consume();
    if (ended.is_err()) { return 24; }
    if (ended.unwrap() != 4 || decoder.reset() != 0) { return 25; }
    summary[0]=body_length as u64; summary[1]=wire_length as u64; summary[2]=copied as u64;
    summary[3]=calls as u64; summary[4]=sum; summary[5]=owner.capacity() as u64; summary[6]=core::mem::slice_stride(backing) as u64;
    return 0;
}
fn main() -> i32 {
    let made: core::result::Result<alloc::vec::Vec<u8>,alloc::vec::Error> = alloc::vec::with_capacity<u8>(16777225);
    if (made.is_err()) { return 1; }
    let owner: alloc::vec::Vec<u8> = made.unwrap();
    let resized: core::result::Result<i32,alloc::vec::Error> = owner.try_resize(16777225,222);
    let status: i32=26; let summary: [u64;7]=[0;7];
    if (resized.is_ok()) { status=exercise(owner.borrow(),summary); }
    owner.destroy();
    if (status != 0) { return status; }
    let bytes: [u8;56]=[0;56]; let at: i32=0;
    while (at < 7) { let index: i32=0; while (index < 8) { bytes[8*at+index]=((summary[at]>>(8*index))&255) as u8; index+=1; } at+=1; }
    let stdout: std::stream::Descriptor=std::stream::stdout();
    core::result::unwrap(core::io::write_all<std::stream::Descriptor>(stdout.borrow(),bytes,0,56));
    return 0;
}
