// Test-only binary protocol: case count, then six LEu64 words per case:
// kind(record0/handshake1), layout(native0/packed1), max, capacity,
// malformed storage(0valid,1negative start,2negative length,3end overflow), actions.
// Each action: opcode(feed0/frame1/consume2/reset3/read-copy4/handoff-feed5),
// malformed input, byte count, then those bytes. Copies never fork writers.
module app::main;
import core::io;
import core::mem;
import core::result;
import core::slice;
import ext::tls_framing;
import std::stream;
fn load(bytes: [u8], offset: i32) -> u64 {
    let result: u64 = 0; let at: i32 = 0;
    while (at < 8) { result |= (bytes[offset+at] as u64) << (8*at); at += 1; }
    return result;
}
fn read(stdin: &std::stream::Descriptor, bytes: [u8], start: i32, length: i32) {
    core::result::unwrap(core::io::read_exact<std::stream::Descriptor>(stdin,bytes,start,length));
}
struct Output { bytes: [u8], used: i32 }
impl Output {
    fn borrow(&self) -> &Output { return self; }
    fn flush(&self) {
        let stdout: std::stream::Descriptor = std::stream::stdout();
        core::result::unwrap(core::io::write_all<std::stream::Descriptor>(stdout.borrow(),self.bytes,0,self.used)); self.used=0;
    }
    fn byte(&self, value: u8) { if (self.used == 2048) { self.flush(); } self.bytes[self.used]=value; self.used+=1; }
    fn word(&self, value: u64) { let at: i32=0; while (at < 8) { self.byte(((value>>(8*at))&255) as u8); at+=1; } }
    fn view(&self, view: core::slice::View<u8>) { let at: i32=0; while (at < view.length) { self.byte(view.values[view.start+at]); at+=1; } }
}
fn fill(bytes: [u8], value: u8) { let at: i32=0; while (at < 65568) { bytes[at]=value; at+=1; } }
fn input_fill(bytes: [u8], length: i32) { let at: i32=0; while (at < length+6) { bytes[at]=165; at+=1; } }
fn guards(bytes: [u8], length: i32, value: u8) {
    let at: i32=0; while (at < 3) { assert(bytes[at] == value && bytes[3+length+at] == value); at+=1; }
}
fn outer_storage(bytes: [u8], length: i32) {
    let at: i32=0; while (at < 65568) { if (at < 3 || at >= 3+length) { assert(bytes[at] == 222); } at+=1; }
}
fn malformed(view: core::slice::View<u8>, variant: i32) -> core::slice::View<u8> {
    let changed: core::slice::View<u8> = view;
    if (variant == 1) { changed.start=-1; }
    if (variant == 2) { changed.length=-1; }
    if (variant == 3) { changed.start=2147483647; changed.length=1; }
    return changed;
}
fn status(error: ext::tls_framing::Error) -> u64 {
    return match (error) {
        ext::tls_framing::Error::Bounds -> 1,
        ext::tls_framing::Error::InvalidLimit -> 2,
        ext::tls_framing::Error::BufferTooSmall -> 3,
        ext::tls_framing::Error::Ready -> 4,
        ext::tls_framing::Error::NotReady -> 5,
        ext::tls_framing::Error::TooLarge -> 6,
        ext::tls_framing::Error::Poisoned -> 7
    };
}
fn run_record(decoder: ext::tls_framing::RecordDecoder, actions: i32, stdin: &std::stream::Descriptor, writer: &Output, storage: core::slice::View<u8>, input: [u8]) {
    let turn: i32=0;
    while (turn < actions) {
        let header: [u8;24]=[0;24]; read(stdin,header,0,24);
        let opcode: i32=load(header,0) as i32; let variant: i32=load(header,8) as i32; let length: i32=load(header,16) as i32;
        assert(opcode >= 0 && opcode <= 5 && variant >= 0 && variant <= 3 && length >= 0 && length <= 65540);
        input_fill(input,length); read(stdin,input,3,length);
        let original: core::slice::View<u8> = core::slice::View { values: input, start: 3, length: length };
        let offered: core::slice::View<u8> = malformed(original,variant);
        let code: u64=0; let consumed: i32=0;
        if (opcode == 0 || opcode == 5) {
            let result: core::result::Result<ext::tls_framing::Progress,ext::tls_framing::FeedFailure> = core::result::Ok(ext::tls_framing::Progress { consumed: 0, ready: false });
            if (opcode == 5) {
                // Transfer the sole writable authority to a metadata copy.
                // The old copy is inspected but never fed again.
                let before: i32=decoder.buffered(); let ready: bool=decoder.ready(); let poisoned: bool=decoder.is_poisoned();
                let moved: ext::tls_framing::RecordDecoder=decoder;
                result=moved.feed(offered);
                assert(decoder.buffered() == before && decoder.ready() == ready && decoder.is_poisoned() == poisoned);
                decoder=moved;
            } else { result=decoder.feed(offered); }
            if (result.is_err()) { let failed: ext::tls_framing::FeedFailure=result.unwrap_err(); code=status(failed.cause); consumed=failed.consumed; }
            else { let progress: ext::tls_framing::Progress=result.unwrap(); consumed=progress.consumed; assert(progress.ready == decoder.ready()); }
        }
        if (opcode == 1 || opcode == 4) {
            let observed: ext::tls_framing::RecordDecoder=decoder;
            let checked: core::result::Result<ext::tls_framing::RecordFrame,ext::tls_framing::Error> = observed.frame();
            if (checked.is_err()) { code=status(checked.unwrap_err()); }
        }
        if (opcode == 2) { let result: core::result::Result<i32,ext::tls_framing::Error> = decoder.consume(); if (result.is_err()) { code=status(result.unwrap_err()); } else { consumed=result.unwrap(); } }
        if (opcode == 3) { consumed=decoder.reset(); }
        writer.word(opcode as u64); writer.word(code); writer.word(consumed as u64);
        writer.word(decoder.buffered() as u64); writer.word(decoder.ready() as u64); writer.word(decoder.is_poisoned() as u64);
        if (decoder.ready()) {
            let frame: ext::tls_framing::RecordFrame=decoder.frame().unwrap();
            writer.word(frame.content_type as u64); writer.word(frame.legacy_version as u64);
            writer.word(frame.wire.length as u64); writer.word(frame.payload.length as u64); writer.view(frame.wire);
        } else { writer.word(0); writer.word(0); writer.word(0); writer.word(0); }
        writer.view(storage); writer.view(original);
        guards(storage.values,storage.length,222); guards(input,length,165);
        turn+=1;
    }
}
fn run_handshake(decoder: ext::tls_framing::HandshakeDecoder, actions: i32, stdin: &std::stream::Descriptor, writer: &Output, storage: core::slice::View<u8>, input: [u8]) {
    let turn: i32=0;
    while (turn < actions) {
        let header: [u8;24]=[0;24]; read(stdin,header,0,24);
        let opcode: i32=load(header,0) as i32; let variant: i32=load(header,8) as i32; let length: i32=load(header,16) as i32;
        assert(opcode >= 0 && opcode <= 5 && variant >= 0 && variant <= 3 && length >= 0 && length <= 65540);
        input_fill(input,length); read(stdin,input,3,length);
        let original: core::slice::View<u8> = core::slice::View { values: input, start: 3, length: length };
        let offered: core::slice::View<u8> = malformed(original,variant);
        let code: u64=0; let consumed: i32=0;
        if (opcode == 0 || opcode == 5) {
            let result: core::result::Result<ext::tls_framing::Progress,ext::tls_framing::FeedFailure> = core::result::Ok(ext::tls_framing::Progress { consumed: 0, ready: false });
            if (opcode == 5) {
                // Transfer the sole writable authority to a metadata copy.
                // The old copy is inspected but never fed again.
                let before: i32=decoder.buffered(); let ready: bool=decoder.ready(); let poisoned: bool=decoder.is_poisoned();
                let moved: ext::tls_framing::HandshakeDecoder=decoder;
                result=moved.feed(offered);
                assert(decoder.buffered() == before && decoder.ready() == ready && decoder.is_poisoned() == poisoned);
                decoder=moved;
            } else { result=decoder.feed(offered); }
            if (result.is_err()) { let failed: ext::tls_framing::FeedFailure=result.unwrap_err(); code=status(failed.cause); consumed=failed.consumed; }
            else { let progress: ext::tls_framing::Progress=result.unwrap(); consumed=progress.consumed; assert(progress.ready == decoder.ready()); }
        }
        if (opcode == 1 || opcode == 4) {
            let observed: ext::tls_framing::HandshakeDecoder=decoder;
            let checked: core::result::Result<ext::tls_framing::HandshakeFrame,ext::tls_framing::Error> = observed.frame();
            if (checked.is_err()) { code=status(checked.unwrap_err()); }
        }
        if (opcode == 2) { let result: core::result::Result<i32,ext::tls_framing::Error> = decoder.consume(); if (result.is_err()) { code=status(result.unwrap_err()); } else { consumed=result.unwrap(); } }
        if (opcode == 3) { consumed=decoder.reset(); }
        writer.word(opcode as u64); writer.word(code); writer.word(consumed as u64);
        writer.word(decoder.buffered() as u64); writer.word(decoder.ready() as u64); writer.word(decoder.is_poisoned() as u64);
        if (decoder.ready()) {
            let frame: ext::tls_framing::HandshakeFrame=decoder.frame().unwrap();
            writer.word(frame.kind as u64); writer.word(0);
            writer.word(frame.wire.length as u64); writer.word(frame.body.length as u64); writer.view(frame.wire);
        } else { writer.word(0); writer.word(0); writer.word(0); writer.word(0); }
        writer.view(storage); writer.view(original);
        guards(storage.values,storage.length,222); guards(input,length,165);
        turn+=1;
    }
}
fn main() -> i32 {
    let stdin: std::stream::Descriptor=std::stream::stdin();
    let count_bytes: [u8;8]=[0;8]; read(stdin.borrow(),count_bytes,0,8);
    let cases: u64=load(count_bytes,0); let current: u64=0;
    let output_bytes: [u8;2048]=[0;2048]; let writer: Output=Output { bytes: output_bytes, used: 0 };
    while (current < cases) {
        let header: [u8;48]=[0;48]; read(stdin.borrow(),header,0,48);
        let kind: i32=load(header,0) as i32; let layout: i32=load(header,8) as i32;
        let maximum: i32=load(header,16) as i32; let capacity: i32=load(header,24) as i32;
        let variant: i32=load(header,32) as i32; let actions: i32=load(header,40) as i32;
        assert(kind >= 0 && kind <= 1 && layout >= 0 && layout <= 1 && capacity >= 0 && capacity <= 65540 && actions >= 0);
        let native_storage: [u8;65568]=[0;65568]; let native_input: [u8;65568]=[0;65568];
        let packed_storage: [i32;16392]=[0;16392]; let packed_input: [i32;16392]=[0;16392];
        let storage_bytes: [u8]=native_storage; let input: [u8]=native_input;
        if (layout == 1) {
            storage_bytes=core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(packed_storage),65568);
            input=core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(packed_input),65568);
        }
        fill(storage_bytes,222); fill(input,165);
        let storage: core::slice::View<u8> = core::slice::View { values: storage_bytes, start: 3, length: capacity };
        let supplied: core::slice::View<u8> = malformed(storage,variant);
        writer.word(core::mem::slice_stride(storage_bytes) as u64); writer.word(core::mem::slice_stride(input) as u64);
        if (kind == 0) {
            let result: core::result::Result<ext::tls_framing::RecordDecoder,ext::tls_framing::Error> = ext::tls_framing::record_decoder(supplied,maximum);
            if (result.is_err()) { writer.word(status(result.unwrap_err())); assert(actions == 0); outer_storage(storage_bytes,0); }
            else { writer.word(0); run_record(result.unwrap(),actions,stdin.borrow(),writer.borrow(),storage,input); }
        } else {
            let result: core::result::Result<ext::tls_framing::HandshakeDecoder,ext::tls_framing::Error> = ext::tls_framing::handshake_decoder(supplied,maximum);
            if (result.is_err()) { writer.word(status(result.unwrap_err())); assert(actions == 0); outer_storage(storage_bytes,0); }
            else { writer.word(0); run_handshake(result.unwrap(),actions,stdin.borrow(),writer.borrow(),storage,input); }
        }
        outer_storage(storage_bytes,capacity);
        current+=1;
    }
    writer.flush(); return 0;
}
