// API contracts for ext::patchset. Exit 0 or the failing check number.
module app::main;
import alloc::vec;
import core::mem;
import core::option;
import core::result;
import core::slice;
import ext::patchset;
import ext::unidiff;

fn literal(value: str, count: i32) -> core::slice::View<u8> {
    let bytes: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::string_data_ptr(value), count);
    return core::result::unwrap(core::slice::view(bytes, count));
}
fn same(left: core::slice::View<u8>, right: core::slice::View<u8>) -> bool {
    if (left.len() != right.len()) { return false; }
    let i: i32 = 0; while (i < left.len()) { if (left.values[left.start+i] != right.values[right.start+i]) { return false; } i += 1; } return true;
}
fn kind_code(k: ext::patchset::Kind) -> i32 { return match (k) { ext::patchset::Kind::Modify -> 0, ext::patchset::Kind::Create -> 1, ext::patchset::Kind::Delete -> 2, ext::patchset::Kind::Rename -> 3, ext::patchset::Kind::Copy -> 4 }; }
fn binary_code(b: ext::patchset::Binary) -> i32 { return match (b) { ext::patchset::Binary::Text -> 0, ext::patchset::Binary::Literal -> 1, ext::patchset::Binary::Marker -> 2 }; }
fn file_is(ps: &ext::patchset::PatchSet, i: i32, kind: i32, binary: i32, old: str, on: i32, new: str, nn: i32, old_mode: i32, new_mode: i32, hunks: i32) -> bool {
    let f: ext::patchset::FilePatch = core::option::unwrap(ps.get(i));
    return kind_code(f.kind) == kind && binary_code(f.binary) == binary && same(ps.old_name(i), literal(old, on)) && same(ps.new_name(i), literal(new, nn))
        && f.old_mode == old_mode && f.new_mode == new_mode && f.patch.hunks.len() == hunks;
}
fn git_applies(base: str, bn: i32, patch: str, pn: i32, expected: str, en: i32, line: i32) -> bool {
    let p: ext::unidiff::Patch = core::result::unwrap(ext::unidiff::parse(literal(patch, pn), 1000));
    let a: ext::unidiff::Applied = core::result::unwrap(ext::patchset::apply_git(literal(base, bn), p.borrow(), ext::unidiff::default_options()));
    let ok: bool = a.rejected == 0 && same(a.output.as_view(), literal(expected, en)) && a.reports.as_slice()[0].line == line;
    a.destroy(); p.destroy(); return ok;
}
fn git_rejects(base: str, bn: i32, patch: str, pn: i32, line: i32) -> bool {
    let p: ext::unidiff::Patch = core::result::unwrap(ext::unidiff::parse(literal(patch, pn), 1000));
    let a: ext::unidiff::Applied = core::result::unwrap(ext::patchset::apply_git(literal(base, bn), p.borrow(), ext::unidiff::default_options()));
    let r: ext::unidiff::HunkReport = a.reports.as_slice()[a.reports.len() - 1];
    let rejected: bool = match (r.status) { ext::unidiff::HunkStatus::Rejected -> true, _ -> false };
    let ok: bool = a.rejected == 1 && rejected && r.line == line && a.output.len() == 0;
    a.destroy(); p.destroy(); return ok;
}
fn direction_is(base: str, bn: i32, patch: str, pn: i32, fuzz: i32, expected: i32) -> bool {
    let p: ext::unidiff::Patch = core::result::unwrap(ext::unidiff::parse(literal(patch, pn), 1000));
    let o: ext::unidiff::ApplyOptions = ext::unidiff::default_options(); o.max_fuzz = fuzz;
    let d: ext::patchset::Direction = core::result::unwrap(ext::patchset::direction(literal(base, bn), p.borrow(), o));
    let code: i32 = match (d) { ext::patchset::Direction::Forward -> 0, ext::patchset::Direction::Reversed -> 1, ext::patchset::Direction::Neither -> 2 };
    p.destroy(); return code == expected;
}
fn merged_is(ours: str, on: i32, base: str, bn: i32, patch: str, pn: i32, expected: str, en: i32, conflicts: i32) -> bool {
    let p: ext::unidiff::Patch = core::result::unwrap(ext::unidiff::parse(literal(patch, pn), 1000));
    let m: ext::patchset::Merged = core::result::unwrap(ext::patchset::three_way(literal(ours, on), literal(base, bn), p.borrow(), ext::unidiff::default_options()));
    let ok: bool = m.applied && m.conflicts == conflicts && same(m.output.as_view(), literal(expected, en));
    m.destroy(); p.destroy(); return ok;
}

fn main() -> i32 {
    // Git extended headers: rename with edit, mode change, creation,
    // deletion, both binary forms, a quoted name and a copy.
    let text: core::slice::View<u8> = literal("From: someone\nSubject: x\n---\ndiff --git a/d/old.txt b/e/new.txt\nsimilarity index 90%\nrename from d/old.txt\nrename to e/new.txt\nindex 1111111..2222222 100644\n--- a/d/old.txt\n+++ b/e/new.txt\n@@ -1,3 +1,3 @@\n 1\n-2\n+two\n 3\ndiff --git a/run.sh b/run.sh\nold mode 100644\nnew mode 100755\ndiff --git a/add.txt b/add.txt\nnew file mode 100755\nindex 0000000..3333333\n--- /dev/null\n+++ b/add.txt\n@@ -0,0 +1 @@\n+hello\ndiff --git a/gone.txt b/gone.txt\ndeleted file mode 100644\nindex 4444444..0000000\n--- a/gone.txt\n+++ /dev/null\n@@ -1 +0,0 @@\n-bye\ndiff --git a/img.png b/img.png\nindex 5555555..6666666 100644\nGIT binary patch\nliteral 5\nMcmZ?wbYd`h00031\n\nliteral 0\nHcmV?d00001\n\ndiff --git a/bin b/bin\nindex 7777777..8888888 100644\nBinary files a/bin and b/bin differ\ndiff --git \"a/caf\\303\\251 x\" \"b/caf\\303\\251 x\"\nold mode 100644\nnew mode 100755\ndiff --git a/src.c b/copy.c\nsimilarity index 95%\ncopy from src.c\ncopy to copy.c\n-- \n2.43.0\n", 921);
    let parsed: core::result::Result<ext::patchset::PatchSet, ext::patchset::Error> = ext::patchset::parse(text, 1, 100, 1000);
    if (core::result::is_err(parsed)) { return 1; }
    let ps: ext::patchset::PatchSet = core::result::unwrap(parsed);
    if (ps.len() != 8) { return 2; }
    if (!file_is(ps.borrow(), 0, 3, 0, "d/old.txt", 9, "e/new.txt", 9, 0, 0, 1)) { return 3; }
    if (!file_is(ps.borrow(), 1, 0, 0, "run.sh", 6, "run.sh", 6, 33188, 33261, 0)) { return 4; }
    if (!file_is(ps.borrow(), 2, 1, 0, "", 0, "add.txt", 7, 0, 33261, 1)) { return 5; }
    if (!file_is(ps.borrow(), 3, 2, 0, "gone.txt", 8, "", 0, 33188, 0, 1)) { return 6; }
    if (!file_is(ps.borrow(), 4, 0, 1, "img.png", 7, "img.png", 7, 0, 0, 0)) { return 7; }
    if (!file_is(ps.borrow(), 5, 0, 2, "bin", 3, "bin", 3, 0, 0, 0)) { return 8; }
    let accented: [u8;6] = [99, 97, 102, 195, 169, 32];
    let f6: ext::patchset::FilePatch = core::option::unwrap(ps.get(6));
    if (ps.new_name(6).len() != 7 || !same(core::slice::View { values: ps.new_name(6).values, start: ps.new_name(6).start, length: 6 }, core::result::unwrap(core::slice::view(accented, 6))) || f6.new_mode != 33261) { return 9; }
    if (!file_is(ps.borrow(), 7, 4, 0, "src.c", 5, "copy.c", 6, 0, 0, 0)) { return 10; }
    // Reversal swaps names, modes and creation with deletion.
    let r: ext::patchset::FilePatch = core::result::unwrap(ext::patchset::reverse_file(core::option::unwrap(ps.get(2))));
    if (kind_code(r.kind) != 2 || r.old_mode != 33261 || r.new_mode != 0 || r.patch.lines.as_slice()[0].kind != 1 || r.patch.hunks.as_slice()[0].old_count != 1 || r.patch.hunks.as_slice()[0].new_start != 0) { return 11; }
    r.patch.destroy();
    ps.destroy();
    // Plain diff -u sections: /dev/null creation, -p0 keeps the whole name.
    let plain: core::slice::View<u8> = literal("Only in b: x\ndiff -ruN a/x b/x\n--- a/x\t2020-01-01 00:00:00\n+++ b/x\t2020-01-02 00:00:00\n@@ -0,0 +1 @@\n+x\n--- a/y\n+++ b/y\n@@ -1 +1 @@\n-y\n+Y\n", 138);
    let pp: ext::patchset::PatchSet = core::result::unwrap(ext::patchset::parse(plain, 0, 100, 1000));
    if (pp.len() != 2 || !file_is(pp.borrow(), 1, 0, 0, "a/y", 3, "b/y", 3, 0, 0, 1)) { return 12; }
    pp.destroy();
    pp = core::result::unwrap(ext::patchset::parse(plain, 1, 100, 1000));
    if (!file_is(pp.borrow(), 0, 0, 0, "x", 1, "x", 1, 0, 0, 1)) { return 13; }
    pp.destroy();
    // Limits and malformed input.
    if (core::result::is_ok(ext::patchset::parse(plain, 1, 1, 1000))) { return 14; }
    if (core::result::is_ok(ext::patchset::parse(literal("--- a/x\n+++ b/x\n@@ -1,2 +1,2 @@\n x\n", 35), 1, 10, 1000))) { return 15; }
    if (core::result::is_ok(ext::patchset::parse(literal("diff --git a/x b/y\nold mode 100644\nnew mode 100755\n", 51), 1, 10, 1000))) { return 16; }
    let empty: ext::patchset::PatchSet = core::result::unwrap(ext::patchset::parse(literal("just text\n", 10), 1, 10, 1000));
    if (empty.len() != 0) { return 17; }
    empty.destroy();
    // git apply placement: searched from the new-side line, +1 before -1.
    let hunk: str = "--- a/f\n+++ b/f\n@@ -3,3 +3,3 @@\n c\n-d\n+D\n e\n";
    if (!git_applies("a\nb\nc\nd\ne\nf\n", 12, hunk, 44, "a\nb\nc\nD\ne\nf\n", 12, 3)) { return 18; }
    if (!git_applies("x\na\nb\nc\nd\ne\n", 12, hunk, 44, "x\na\nb\nc\nD\ne\n", 12, 4)) { return 19; }
    if (!git_applies("c\nd\ne\nq\nc\nd\ne\n", 14, "--- a/f\n+++ b/f\n@@ -4,3 +4,3 @@\n c\n-d\n+D\n e\n", 44, "c\nd\ne\nq\nc\nD\ne\n", 14, 5)) { return 20; }
    // Exact context only, a hunk at line 1 must match at the top and one
    // without trailing context at the end; the report names the old line.
    if (!git_rejects("a\nb\nC\nd\ne\nf\n", 12, hunk, 44, 3)) { return 21; }
    if (!git_rejects("x\na\nb\nc\n", 8, "--- a/f\n+++ b/f\n@@ -1,3 +1,3 @@\n a\n b\n-c\n+C\n", 44, 1)) { return 22; }
    if (!git_rejects("a\nb\nc\nz\n", 8, "--- a/f\n+++ b/f\n@@ -1,3 +1,3 @@\n a\n b\n-c\n+C\n", 44, 1)) { return 23; }
    // GNU patch's reversed-patch check on the first hunk.
    if (!direction_is("a\nb\nc\nd\ne\n", 10, hunk, 44, 2, 0)) { return 24; }
    if (!direction_is("a\nb\nc\nD\ne\n", 10, hunk, 44, 2, 1)) { return 25; }
    if (!direction_is("q\nb\nc\nd\ne\n", 10, "--- a/f\n+++ b/f\n@@ -2,3 +2,3 @@\n b\n-c\n+C\n d\n", 44, 0, 0)) { return 26; }
    if (!direction_is("a\nb\nX\nd\nY\n", 10, "--- a/f\n+++ b/f\n@@ -2,3 +2,3 @@\n b\n-c\n+C\n d\n", 44, 2, 2)) { return 27; }
    // git apply --3way: the patch applied to the preimage, merged into ours.
    let edit: str = "--- a/f\n+++ b/f\n@@ -1,3 +1,3 @@\n 1\n-2\n+two\n 3\n";
    if (!merged_is("0\n1\n2\n3\n", 8, "1\n2\n3\n", 6, edit, 46, "0\n1\ntwo\n3\n", 10, 0)) { return 28; }
    if (!merged_is("1\nTWO\n3\n", 8, "1\n2\n3\n", 6, edit, 46, "1\n<<<<<<< ours\nTWO\n=======\ntwo\n>>>>>>> theirs\n3\n", 48, 1)) { return 29; }
    let p: ext::unidiff::Patch = core::result::unwrap(ext::unidiff::parse(literal(edit, 46), 1000));
    let m: ext::patchset::Merged = core::result::unwrap(ext::patchset::three_way(literal("1\n2\n3\n", 6), literal("x\n", 2), p.borrow(), ext::unidiff::default_options()));
    if (m.applied || m.output.len() != 0) { return 30; }
    m.destroy(); p.destroy();
    return 0;
}
