module app::main;
import core::f64;
import core::mem;
import core::random;
import core::result;
import ext::distributions;
import std::io;
fn read(p: ptr, count: i32, eof: bool) -> bool { let done: i32 = 0; while (done < count) { let n: i32 = std::io::read_stdin(p+(done as usize),(count-done) as usize); assert(n >= 0); if (n == 0) { assert(eof && done == 0); return false; } done += n; } return true; }
fn write(p: ptr, count: i32) { let done: i32 = 0; while (done < count) { let n: i32 = std::io::write_stdout(p+(done as usize),(count-done) as usize); assert(n > 0); done += n; } }
fn wide(raw: [u8], at: i32) -> u64 { let value: u64 = 0; let i: i32 = 0; while (i < 8) { value = value | ((raw[at+i] as u64) << (8*i)); i += 1; } return value; }
fn number(value: f64) { let words: [i32;2] = [0;2]; let bits: u64 = core::f64::to_bits(value); words[0] = bits as i32; words[1] = (bits >> 32) as i32; write(core::mem::i32_array_data_ptr(words),8); }
fn code(error: ext::distributions::Error) -> i32 { return match (error) { InvalidParameter -> 1, NaN -> 2, NumericalFailure -> 3, Precision -> 4, WorkLimit -> 5, DrawLimit -> 6, Random(cause) -> 7, NoConvergence -> 8 }; }
fn status(value: i32, limit: &ext::distributions::Budget) { let raw: [i32;5] = [0;5]; raw[0] = value; let draws: u64 = limit.draws(); let work: u64 = limit.work(); raw[1] = draws as i32; raw[2] = (draws >> 32) as i32; raw[3] = work as i32; raw[4] = (work >> 32) as i32; write(core::mem::i32_array_data_ptr(raw),20); }
fn main() -> i32 {
 let words: [i32;16] = [0;16]; let pointer: ptr = core::mem::i32_array_data_ptr(words); let raw: [u8] = core::mem::typed_slice_from_raw_parts(pointer,64);
 while (read(pointer,64,true)) {
  let op: i32 = words[0]; let kind: i32 = words[1]; let count: i32 = words[2]; assert(op >= 0 && op <= 3 && kind >= 0 && kind < 4 && count >= 0 && count <= 200000);
  let a: f64 = core::f64::from_bits(wide(raw,24)); let b: f64 = core::f64::from_bits(wide(raw,32)); let x: f64 = core::f64::from_bits(wide(raw,40));
  let made: core::result::Result<ext::distributions::Distribution,ext::distributions::Error> = ext::distributions::normal(a,b); if (kind == 1) { made = ext::distributions::exponential(a); } if (kind == 2) { made = ext::distributions::gamma(a,b); } if (kind == 3) { made = ext::distributions::beta(a,b); }
  let limit: ext::distributions::Budget = ext::distributions::budget(wide(raw,48),wide(raw,56)); let source: core::random::Xoshiro256PlusPlus = core::random::from_seed(wide(raw,16)); let i: i32 = 0;
  while (i < count) {
   if (made.is_err()) { status(code(made.unwrap_err()),limit.borrow()); i += 1; continue; } let value: ext::distributions::Distribution = made.unwrap();
   if (op == 2) { let evaluated: core::result::Result<ext::distributions::Tails,ext::distributions::Error> = ext::distributions::tails(value,x,limit.borrow()); if (evaluated.is_err()) { status(code(evaluated.unwrap_err()),limit.borrow()); } else { status(0,limit.borrow()); let t: ext::distributions::Tails = evaluated.unwrap(); number(t.cdf); number(t.survival); number(t.log_cdf); number(t.log_survival); } }
   else { let result: core::result::Result<f64,ext::distributions::Error> = ext::distributions::log_pdf(value,x); if (op == 1) { result = ext::distributions::pdf(value,x); } if (op == 3) { result = ext::distributions::sample(source.borrow(),value,limit.borrow()); }
    if (result.is_err()) { status(code(result.unwrap_err()),limit.borrow()); } else { status(0,limit.borrow()); number(result.unwrap()); } }
   i += 1;
  }
 } return 0;
}
