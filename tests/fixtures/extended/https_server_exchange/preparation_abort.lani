// Actual Reply.stage can fail its Protocol before the transport sees failure.
module app::main;
import alloc::vec;
import core::decimal;
import core::io;
import core::mem;
import core::net;
import core::option;
import core::slice;
import core::time;
import ext::http;
import ext::http_client;
import ext::http_server;
import ext::https_server;
import ext::openssl_tls;
import ext::server_poll;
import std::args;
import std::clock;
import std::linux;
import std::poll;
import std::signal;
import std::socket;
import std::stream;
extern "C" fn duplex_test_fd_open(fd: i32) -> i32;
extern "C" fn duplex_test_stat(index: i32, field: i32) -> i64;
fn bytes(text: str, count: i32) -> core::slice::View<u8> { return core::slice::view<u8>(core::mem::typed_slice_from_raw_parts<u8>(core::mem::string_data_ptr(text),count),count).unwrap(); }
fn number(part: core::slice::View<u8>) -> i32 { return core::decimal::parse_u32_range(part.values,part.start,part.length).unwrap() as i32; }
fn mark(text: str) { let sink = std::stream::stderr(); let part = bytes(text,1); core::io::write_all(sink.borrow(),part.values,0,1).unwrap(); }
fn hash(part: core::slice::View<u8>) -> u32 { let value: u32 = 5381; let i: i32 = 0; while (i < part.length) { value = value*33+part.get(i).unwrap() as u32; i += 1; } return value; }
fn host_five(error: core::io::Error) -> bool { return match(error) { core::io::Error::Host(value) -> value == 5, _ -> false }; }
fn http_cause(error: ext::http_server::Failure, clock_fault: bool) -> bool {
    if (clock_fault) { return match(error.cause) { ext::http_server::Cause::Clock(value) -> match(value) { std::clock::Error::Host(code) -> code == 5, _ -> false }, _ -> false }; }
    return match(error.cause) { ext::http_server::Cause::WorkLimit -> true, _ -> false };
}
fn main() -> i32 {
    std::signal::set_disposition(std::signal::Signal::BrokenPipe,std::signal::Disposition::Ignore).unwrap();
    let args = std::args::snapshot(1,7,32768).unwrap(); assert(args.len() == 7);
    let fd: i32 = number(args.get(0).unwrap()); let port: i32 = number(args.get(1).unwrap()); let clock_fault: bool = number(args.get(5).unwrap()) != 0; let close_fault: bool = number(args.get(6).unwrap()) != 0;
    let context = ext::openssl_tls::new_server(args.get(2).unwrap(),args.get(3).unwrap(),bytes("",0),ext::openssl_tls::ClientAuthentication::Unauthenticated,ext::openssl_tls::default_limits()).unwrap();
    let socket = std::socket::from_owned_handle(fd,std::socket::Family::Ipv4,std::socket::Kind::Tcp).unwrap();
    let peer = core::net::SocketAddr::V4(core::net::SocketAddrV4 { address:core::net::ipv4(127,0,0,1),port:port as u16 });
    let options = ext::http_server::default_options(); options.work = 8192; options.request.head_bytes = 4096; options.request.line_bytes = 1024; options.request.headers = 16; options.response_bytes = 131072; options.response.body_bytes = 65536;
    let deadline = core::time::deadline_after(std::clock::monotonic_now().unwrap(),core::time::from_millis(4000)).unwrap();
    mark("C"); let owner = ext::https_server::begin_connected(socket,peer,context.borrow(),options,ext::https_server::default_options(),deadline).unwrap(); mark("c"); context.destroy(); args.destroy();
    let poll = std::poll::new(1).unwrap(); let readiness = ext::http_client::Readiness { readable:false,writable:false,hangup:false,error:false }; let heads: i32 = 0; let steps: i32 = 0;
    while (heads == 0) {
        assert(steps < 10000); steps += 1; let before: i64 = duplex_test_stat(-1,3); mark("S"); let result = owner.step(readiness).unwrap(); mark("s");
        assert(duplex_test_stat(-1,3)-before <= 1); readiness = ext::http_client::Readiness { readable:false,writable:false,hangup:false,error:false };
        if (result.is_some()) { assert(match(result.unwrap()) { ext::http_server::Event::Head(value) -> true, _ -> false }); heads = 1; break; }
        let interest = owner.interest(); if (!interest.immediate) {
            mark("W"); assert(owner.before_wait().unwrap()); mark("w"); let events: u32 = 0; if (interest.readable) { events |= std::poll::READABLE; } if (interest.writable) { events |= std::poll::WRITABLE; }
            let items: [std::poll::Request;1] = [std::poll::Request { handle:owner.raw_handle().unwrap(),events:events }];
            mark("P"); poll.poll_ms(core::slice::view<std::poll::Request>(items,1).unwrap(),25).unwrap(); mark("p"); let found = poll.readiness(0).unwrap(); readiness = ext::http_client::Readiness { readable:found.readable(),writable:found.writable(),hangup:found.hangup() || found.read_closed(),error:found.error() || found.invalid() };
        }
    }
    let original_head = owner.protocol().head().unwrap().head.raw; let original_hash: u32 = hash(original_head); let version: i32 = owner.negotiated_version(); assert(version == 771 || version == 772);
    let body: alloc::vec::Vec<u8> = alloc::vec::new(); body.try_resize(65536,171).unwrap(); let fields: [ext::http::Field;0] = [];
    let reply = ext::server_poll::reply(owner.protocol()); let before_stage: i64 = duplex_test_stat(-1,3);
    mark("R"); let failed = reply.stage(ext::http_server::Response { status:413,reason:bytes("Limit",5),headers:core::slice::view<ext::http::Field>(fields,0).unwrap(),body:body.as_view(),date:core::time::system_time(0,0).unwrap() }).unwrap_err(); mark("r");
    assert(duplex_test_stat(-1,3) == before_stage && http_cause(failed,clock_fault) && !reply.is_staged() && reply.last_failure().is_some());
    assert(match(failed.stage) { ext::http_server::Stage::Prepare -> true, _ -> false });
    assert(match(owner.protocol().status()) { ext::http_server::Status::Failed -> true, _ -> false }); assert(match(owner.status()) { ext::http_server::Status::Active -> true, _ -> false });
    assert(duplex_test_stat(-1,1) == 1 && duplex_test_fd_open(fd) == 1 && owner.stats().response_sent == 0);
    body.destroy(); mark("A"); let aborted = owner.abort(); mark("a");
    if (close_fault) {
        let cleanup: ext::https_server::Failure = aborted.unwrap_err(); assert(match(cleanup.cause) { ext::https_server::Cause::Io(value) -> host_five(value), _ -> false });
        assert(match(cleanup.stage) { ext::https_server::Stage::Close -> true, _ -> false }); assert(cleanup.cleanup.is_none() && cleanup.stats.closed && cleanup.stats.cleanup_calls == 1 && cleanup.stats.cleanup_errors == 1);
        // strace skipped the actual kernel close. Repair that test descriptor
        // outside the disarmed Exchange; this does not change its receipt.
        assert(duplex_test_fd_open(fd) == 1); let items: [std::linux::Argument;1] = [std::linux::Argument::Word(fd as i64)]; std::linux::call(3,core::slice::view<std::linux::Argument>(items,1).unwrap()).unwrap();
    } else { assert(aborted.unwrap()); }
    let cached: ext::https_server::Failure = owner.last_terminal_failure().unwrap(); let original = match(cached.cause) { ext::https_server::Cause::Http(value) -> core::option::Some(value), _ -> core::option::None() }; assert(original.is_some() && http_cause(original.unwrap(),clock_fault));
    assert(match(cached.stage) { ext::https_server::Stage::Protocol -> true, _ -> false }); assert(match(original.unwrap().stage) { ext::http_server::Stage::Prepare -> true, _ -> false });
    assert(cached.cleanup.is_some() == close_fault && original.unwrap().cleanup.is_some() == close_fault); if (close_fault) { assert(host_five(cached.cleanup.unwrap()) && host_five(original.unwrap().cleanup.unwrap())); }
    assert(cached.stats.closed && cached.stats.cleanup_calls == 1 && cached.stats.cleanup_errors == (close_fault as u64)); assert(original.unwrap().stats.closed && original.unwrap().stats.cleanup_calls == 1 && original.unwrap().stats.cleanup_errors == (close_fault as u64));
    assert(hash(original_head) == original_hash && duplex_test_fd_open(fd) == 0 && duplex_test_stat(-1,0) == 0 && duplex_test_stat(-1,1) == 0 && duplex_test_stat(-1,2) == 0);
    assert(!owner.abort().unwrap()); mark("X"); owner.destroy().unwrap(); assert(!owner.destroy().unwrap()); mark("x"); poll.destroy(); assert(duplex_test_stat(-1,3) == before_stage);
    let values: [u64;16] = [1213421621,version as u64,steps as u64,before_stage as u64,cached.stats.cleanup_calls,cached.stats.cleanup_errors,cached.stats.received,cached.stats.response_sent,original_hash as u64,0,0,0,0,0,0,0]; if (clock_fault) { values[9] = 1; } if (close_fault) { values[10] = 1; }
    let output: [u8;128] = [0;128]; let i: i32 = 0; while (i < 16) { let j: i32 = 0; while (j < 8) { output[i*8+j] = (values[i]>>(j*8)) as u8; j += 1; } i += 1; }
    let sink = std::stream::stdout(); core::io::write_all(sink.borrow(),output,0,128).unwrap(); let input = std::stream::stdin(); let ack: [u8;1] = [0]; core::io::read_exact(input.borrow(),ack,0,1).unwrap(); assert(ack[0] == 33); return 0;
}
