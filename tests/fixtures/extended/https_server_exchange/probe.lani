// Direct public server Exchange consumer. Native OpenSSL is observed, not replaced.
module app::main;
import alloc::vec;
import core::decimal;
import core::io;
import core::mem;
import core::net;
import core::option;
import core::slice;
import core::time;
import ext::http;
import ext::http_client;
import ext::http_server;
import ext::https_server;
import ext::openssl_tls;
import std::args;
import std::clock;
import std::poll;
import std::signal;
import std::socket;
import std::stream;
extern "C" fn duplex_test_fd_open(fd: i32) -> i32;
extern "C" fn duplex_test_stat(index: i32, field: i32) -> i64;

fn bytes(text: str, count: i32) -> core::slice::View<u8> { return core::slice::view<u8>(core::mem::typed_slice_from_raw_parts<u8>(core::mem::string_data_ptr(text),count),count).unwrap(); }
fn number(part: core::slice::View<u8>) -> i32 { return core::decimal::parse_u32_range(part.values,part.start,part.length).unwrap() as i32; }
fn mark(text: str) { let sink = std::stream::stderr(); let part = bytes(text,1); core::io::write_all(sink.borrow(),part.values,0,1).unwrap(); }
fn ready() -> ext::http_client::Readiness { return ext::http_client::Readiness { readable:false,writable:false,hangup:false,error:false }; }
fn state(value: ext::http_server::Status) -> i32 { return match(value) { ext::http_server::Status::Active -> 0, ext::http_server::Status::Complete -> 1, ext::http_server::Status::Failed -> 2, ext::http_server::Status::Aborted -> 3 }; }
fn invalid(error: ext::https_server::Failure) -> bool { return match(error.cause) { ext::https_server::Cause::Http(value) -> match(value.cause) { ext::http_server::Cause::InvalidState -> true, _ -> false }, _ -> false }; }
fn hash(part: core::slice::View<u8>) -> u32 { let value: u32 = 5381; let i: i32 = 0; while (i < part.length) { value = value*33+part.get(i).unwrap() as u32; i += 1; } return value; }
struct Saved { head: core::option::Option<ext::http_server::RequestHead>, request: core::option::Option<ext::http_server::Request>, head_hash: u32, body_hash: u32 }
impl Saved {
    fn borrow(&self) -> &Saved { return self; }
    fn check(&self, owner: &ext::https_server::Exchange) {
        if (self.head.is_none() && owner.protocol().head().is_some()) { self.head = owner.protocol().head(); self.head_hash = hash(self.head.unwrap().head.raw); }
        if (self.request.is_none() && owner.protocol().request().is_some()) { self.request = owner.protocol().request(); self.body_hash = hash(self.request.unwrap().body); }
        if (self.head.is_some()) { assert(hash(self.head.unwrap().head.raw) == self.head_hash); }
        if (self.request.is_some()) { assert(hash(self.request.unwrap().body) == self.body_hash); }
    }
}
fn respond(owner: &ext::https_server::Exchange, early: bool) {
    let local: alloc::vec::Vec<u8> = alloc::vec::new(); let part: core::slice::View<u8> = bytes("",0); let code: i32 = 200;
    if (early) { code = 413; local.try_resize(65536,0).unwrap(); let i: i32 = 0; while (i < 65536) { local.try_set(i,((i*73+11) as u8)).unwrap(); i += 1; } part = local.as_view(); }
    else { part = owner.protocol().request().unwrap().body; }
    let name: [u8;7] = [88,45,79,119,110,101,100]; let value: [u8;6] = [115,116,97,98,108,101];
    let fields: [ext::http::Field;1] = [ext::http::Field { raw:bytes("",0),name:core::slice::view<u8>(name,7).unwrap(),value:core::slice::view<u8>(value,6).unwrap(),offset:0 }];
    let before: i64 = duplex_test_stat(-1,3); mark("R");
    owner.respond(ext::http_server::Response { status:code,reason:bytes("Result",6),headers:core::slice::view<ext::http::Field>(fields,1).unwrap(),body:part,date:core::time::system_time(0,0).unwrap() }).unwrap(); mark("r");
    assert(duplex_test_stat(-1,3) == before);
    name[0] = 89; value[0] = 88; let i: i32 = 0; while (i < local.len()) { local.try_set(i,238).unwrap(); i += 1; } local.destroy();
}
fn main() -> i32 {
    std::signal::set_disposition(std::signal::Signal::BrokenPipe,std::signal::Disposition::Ignore).unwrap();
    let args = std::args::snapshot(1,8,32768).unwrap(); assert(args.len() == 8);
    let fd: i32 = number(args.get(0).unwrap()); let port: i32 = number(args.get(1).unwrap()); let mode: i32 = number(args.get(5).unwrap()); let required: bool = number(args.get(6).unwrap()) != 0;
    let limits = ext::openssl_tls::default_limits(); limits.io_bytes = 1024;
    let authentication = ext::openssl_tls::ClientAuthentication::Unauthenticated;
    if (required) { authentication = ext::openssl_tls::ClientAuthentication::Required(ext::openssl_tls::Trust::CaFile(args.get(4).unwrap())); }
    let context = ext::openssl_tls::new_server(args.get(2).unwrap(),args.get(3).unwrap(),bytes("",0),authentication,limits).unwrap();
    let socket = std::socket::from_owned_handle(fd,std::socket::Family::Ipv4,std::socket::Kind::Tcp).unwrap();
    let peer = core::net::SocketAddr::V4(core::net::SocketAddrV4 { address:core::net::ipv4(127,0,0,1),port:port as u16 });
    let options = ext::http_server::default_options(); options.request.head_bytes = 4096; options.request.line_bytes = 1024; options.request.headers = 16; options.request_bytes = 16384; options.request.body_bytes = 8192; options.response_bytes = 131072; options.response.body_bytes = 65536; options.drain_bytes = 257;
    let tls_options = ext::https_server::default_options(); tls_options.tls_calls = number(args.get(7).unwrap()) as u64;
    let deadline = core::time::deadline_after(std::clock::monotonic_now().unwrap(),core::time::from_millis(4000)).unwrap();
    mark("C"); let owner = ext::https_server::begin_connected(socket,peer,context.borrow(),options,tls_options,deadline).unwrap(); mark("c");
    context.destroy(); args.destroy(); assert(duplex_test_stat(-1,0) == 0 && duplex_test_stat(-1,1) == 1 && duplex_test_stat(-1,3) == 0);
    let no_fields: [ext::http::Field;0] = [];
    assert(owner.negotiated_version() == 0 && owner.protocol().event().is_none());
    assert(invalid(owner.read_body(ext::http_server::BodyDecision::Read).unwrap_err()));
    assert(invalid(owner.respond(ext::http_server::Response { status:400,reason:bytes("Bad",3),headers:core::slice::view<ext::http::Field>(no_fields,0).unwrap(),body:bytes("",0),date:core::time::system_time(0,0).unwrap() }).unwrap_err()));
    assert(duplex_test_stat(-1,3) == 0 && owner.protocol().event().is_none());
    let saved: Saved = Saved { head:core::option::None(),request:core::option::None(),head_hash:0,body_hash:0 };
    let poll = std::poll::new(1).unwrap(); let readiness = ready(); let steps: i32 = 0; let heads: i32 = 0; let requests: i32 = 0; let terminal_events: i32 = 0; let tls_failure: i32 = 0; let tls_reason: u64 = 0; let maximum_delta: i32 = 0;
    while (state(owner.status()) == 0) {
        assert(steps < 20000); steps += 1;
        let before: i64 = duplex_test_stat(-1,3); let charged: u64 = owner.tls_stats().calls; let backpressure: i64 = duplex_test_stat(0,10);
        mark("S"); let result = owner.step(readiness); mark("s"); readiness = ready();
        let delta: i32 = (duplex_test_stat(-1,3)-before) as i32; assert(delta >= 0 && delta <= 1 && owner.tls_stats().calls-charged == delta as u64); if (delta > maximum_delta) { maximum_delta = delta; }
        if (duplex_test_stat(0,10) > backpressure && backpressure == 0) { mark("B"); }
        saved.check(owner.borrow());
        if (result.is_err()) {
            let error: ext::https_server::Failure = result.unwrap_err();
            assert(mode == 2 && heads == 0 && requests == 0 && owner.protocol().stats().received == 0 && owner.protocol().stats().response_sent == 0);
            assert(match(error.stage) { ext::https_server::Stage::Handshake -> true, _ -> false });
            let failed = match(error.cause) { ext::https_server::Cause::Tls(value) -> core::option::Some(value), _ -> core::option::None() }; assert(failed.is_some());
            let native = failed.unwrap(); assert(match(native.phase) { ext::openssl_tls::Phase::Handshake -> true, _ -> false }); assert(native.code != 0 && native.ssl_error == 1); tls_failure = 1; tls_reason = native.code; break;
        }
        let event = result.unwrap();
        if (event.is_some()) {
            assert(owner.negotiated_version() == 771 || owner.negotiated_version() == 772);
            let kind: i32 = match(event.unwrap()) { ext::http_server::Event::Head(value) -> 1, ext::http_server::Event::Request(value) -> 2, ext::http_server::Event::Complete(value) -> 3, ext::http_server::Event::Empty -> 4, ext::http_server::Event::Rejected(value) -> 5 };
            if (kind == 1) {
                heads += 1; assert(heads == 1 && owner.protocol().event().is_some());
                let before_decision: i64 = duplex_test_stat(-1,3); mark("H");
                if (mode == 1) { respond(owner.borrow(),true); }
                else { let expectation = owner.protocol().head().unwrap().expectation; let decision = ext::http_server::BodyDecision::Read; if (match(expectation) { ext::http_server::Expectation::Continue -> true, _ -> false }) { decision = ext::http_server::BodyDecision::ContinueThenRead; } owner.read_body(decision).unwrap(); }
                mark("h"); assert(duplex_test_stat(-1,3) == before_decision);
            }
            if (kind == 2) { requests += 1; assert(requests == 1 && mode != 1); respond(owner.borrow(),false); }
            if (kind == 3) { terminal_events += 1; assert(state(owner.status()) == 1 && owner.raw_handle().is_none()); }
            assert(kind != 4 && kind != 5);
        }
        if (state(owner.status()) != 0) { break; }
        let interest = owner.interest();
        if (!interest.immediate) {
            let before_wait: i64 = duplex_test_stat(-1,3); mark("W"); let needed = owner.before_wait().unwrap(); mark("w"); assert(duplex_test_stat(-1,3) == before_wait && needed);
            let events: u32 = 0; if (interest.readable) { events |= std::poll::READABLE; } if (interest.writable) { events |= std::poll::WRITABLE; }
            let items: [std::poll::Request;1] = [std::poll::Request { handle:owner.raw_handle().unwrap(),events:events }];
            mark("P"); poll.poll_ms(core::slice::view<std::poll::Request>(items,1).unwrap(),25).unwrap(); mark("p"); let found = poll.readiness(0).unwrap(); readiness = ext::http_client::Readiness { readable:found.readable(),writable:found.writable(),hangup:found.hangup() || found.read_closed(),error:found.error() || found.invalid() };
        }
    }
    assert((mode == 2 && tls_failure == 1 && terminal_events == 0) || (mode != 2 && terminal_events == 1 && heads == 1));
    let stats = owner.stats(); let tls = owner.tls_stats(); let version: i32 = owner.negotiated_version(); saved.check(owner.borrow()); assert(owner.raw_handle().is_none() && duplex_test_fd_open(fd) == 0);
    assert(duplex_test_stat(-1,0) == 0 && duplex_test_stat(-1,1) == 0 && duplex_test_stat(-1,2) == 0 && stats.closed && stats.cleanup_calls == 1 && stats.cleanup_errors == 0);
    let calls: i64 = duplex_test_stat(-1,3);
    if (mode != 2) { let replay: i32 = 0; while (replay < 3) { mark("S"); assert(owner.step(ready()).unwrap().is_none()); mark("s"); steps += 1; replay += 1; } assert(!owner.before_wait().unwrap()); }
    else { assert(owner.step(ready()).is_err() && owner.before_wait().is_err()); }
    assert(!owner.abort().unwrap()); saved.check(owner.borrow()); mark("X"); owner.destroy().unwrap(); assert(!owner.destroy().unwrap()); mark("x"); poll.destroy(); assert(duplex_test_stat(-1,3) == calls);
    let out: [u64;32] = [0;32]; out[0] = 1213421620; out[1] = mode as u64; out[2] = version as u64; out[3] = steps as u64; out[4] = heads as u64; out[5] = requests as u64; out[6] = terminal_events as u64; out[7] = tls_failure as u64; out[8] = tls_reason; out[9] = stats.received; out[10] = stats.drain_received; out[11] = stats.response_bytes as u64; out[12] = stats.response_sent as u64; out[13] = stats.continue_sent as u64; out[14] = tls.calls; out[15] = duplex_test_stat(-1,3) as u64; out[16] = duplex_test_stat(0,6) as u64; out[17] = duplex_test_stat(0,10) as u64; out[18] = maximum_delta as u64; out[19] = saved.head_hash as u64; out[20] = saved.body_hash as u64; out[21] = stats.cleanup_calls; out[22] = stats.cleanup_errors; out[23] = stats.buffered_discarded as u64; if (stats.write_shutdown) { out[24] = 1; } if (stats.peer_eof) { out[25] = 1; } out[26] = stats.work;
    let packed: [u8;256] = [0;256]; let i: i32 = 0; while (i < 32) { let j: i32 = 0; while (j < 8) { packed[i*8+j] = (out[i]>>(j*8)) as u8; j += 1; } i += 1; }
    let sink = std::stream::stdout(); core::io::write_all(sink.borrow(),packed,0,256).unwrap();
    let input = std::stream::stdin(); let ack: [u8;1] = [0]; core::io::read_exact(input.borrow(),ack,0,1).unwrap(); assert(ack[0] == 33); return 0;
}
