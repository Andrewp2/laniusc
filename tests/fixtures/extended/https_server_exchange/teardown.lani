import std::stream;
extern "C" fn duplex_test_fd_open(fd: i32) -> i32;
extern "C" fn duplex_test_stat(index: i32, field: i32) -> i64;
fn bytes(text: str, count: i32) -> core::slice::View<u8> { return core::slice::view<u8>(core::mem::typed_slice_from_raw_parts<u8>(core::mem::string_data_ptr(text),count),count).unwrap(); }
fn number(part: core::slice::View<u8>) -> i32 { return core::decimal::parse_u32_range(part.values,part.start,part.length).unwrap() as i32; }
fn mark(text: str) { let sink = std::stream::stderr(); let part = bytes(text,1); core::io::write_all(sink.borrow(),part.values,0,1).unwrap(); }
fn ready() -> ext::http_client::Readiness { return ext::http_client::Readiness { readable:false,writable:false,hangup:false,error:false }; }
fn hash(part: core::slice::View<u8>) -> u32 { let value: u32 = 5381; let i: i32 = 0; while (i < part.length) { value = value*33+part.get(i).unwrap() as u32; i += 1; } return value; }
fn packet(magic: u64, value: u64) {
    let output: [u8;16] = [0;16]; let j: i32 = 0; while (j < 8) { output[j] = (magic >> (j*8)) as u8; output[8+j] = (value >> (j*8)) as u8; j += 1; }
    let sink = std::stream::stdout(); core::io::write_all(sink.borrow(),output,0,16).unwrap();
}
fn control(expected: u8) { let input = std::stream::stdin(); let part: [u8;1] = [0]; core::io::read_exact(input.borrow(),part,0,1).unwrap(); assert(part[0] == expected); }
fn failure(error: ext::https_server::Failure, mode: i32, sent: i32, head: i32) -> u64 {
    assert(mode >= 0 && mode <= 2 && match(error.stage) { ext::https_server::Stage::Drain -> true, _ -> false });
    assert(error.cleanup_attempted && error.cleanup.is_none() && error.rejection.is_none());
    assert(error.stats.closed && error.stats.cleanup_calls == 1 && error.stats.cleanup_errors == 0 && error.stats.write_shutdown && !error.stats.peer_eof);
    assert(error.stats.response_bytes == sent && error.stats.response_sent == sent && sent > 9 && error.stats.continue_sent == 0 && error.stats.buffered_discarded == 0);
    let drained: u64 = 0; if (mode == 2) { drained = 258; } assert(error.stats.drain_received == drained && error.stats.received == head as u64+drained);
    if (mode == 1) {
        let tls: core::option::Option<ext::openssl_tls::Error> = match(error.cause) { ext::https_server::Cause::Tls(value) -> core::option::Some(value), _ -> core::option::None() }; assert(tls.is_some());
        assert(match(tls.unwrap().cause) { ext::openssl_tls::Cause::Truncated -> true, _ -> false }); assert(match(tls.unwrap().phase) { ext::openssl_tls::Phase::Read -> true, _ -> false });
        assert(tls.unwrap().ssl_error == 1 && tls.unwrap().code == 167772454 && tls.unwrap().verify_code == 0 && tls.unwrap().system == 0); return tls.unwrap().code;
    }
    let http: core::option::Option<ext::http_server::Failure> = match(error.cause) { ext::https_server::Cause::Http(value) -> core::option::Some(value), _ -> core::option::None() }; assert(http.is_some());
    assert(match(http.unwrap().stage) { ext::http_server::Stage::Drain -> true, _ -> false });
    if (mode == 0) { assert(match(http.unwrap().cause) { ext::http_server::Cause::Timeout -> true, _ -> false }); }
    else { assert(match(http.unwrap().cause) { ext::http_server::Cause::DrainLimit -> true, _ -> false }); }
    assert(http.unwrap().stats.closed && http.unwrap().stats.cleanup_calls == 1 && http.unwrap().stats.cleanup_errors == 0 && http.unwrap().stats.write_shutdown && !http.unwrap().stats.peer_eof);
    assert(http.unwrap().stats.received == error.stats.received && http.unwrap().stats.drain_received == drained && http.unwrap().stats.response_sent == sent && http.unwrap().stats.response_bytes == sent);
    assert(http.unwrap().cleanup_attempted && http.unwrap().cleanup.is_none() && http.unwrap().rejection.is_none()); return 0;
}
fn main() -> i32 {
    std::signal::set_disposition(std::signal::Signal::BrokenPipe,std::signal::Disposition::Ignore).unwrap();
    let args = std::args::snapshot(1,3,32768).unwrap(); assert(args.len() == 3); let mode: i32 = number(args.get(2).unwrap()); assert(mode >= 0 && mode <= 3);
    let limits = ext::openssl_tls::default_limits(); limits.io_bytes = 1024;
    let context = ext::openssl_tls::new_server(args.get(0).unwrap(),args.get(1).unwrap(),bytes("",0),ext::openssl_tls::ClientAuthentication::Unauthenticated,limits).unwrap();
    let options = ext::http_server::default_options(); options.request_bytes = 1024; options.request.head_bytes = 512; options.request.line_bytes = 256; options.request.headers = 8; options.request.body_bytes = 258; options.response_bytes = 512; options.response.head_bytes = 512; options.response.line_bytes = 256; options.response.headers = 4; options.response.body_bytes = 9; options.drain_bytes = 257; options.work = 65536;
    mark("C"); let listener = std::socket::create(std::socket::Family::Ipv4,std::socket::Kind::Tcp,true).unwrap(); listener.bind(core::net::SocketAddr::V4(core::net::SocketAddrV4 { address:core::net::ipv4(127,0,0,1),port:0 })).unwrap(); listener.listen(1).unwrap();
    let port: u64 = match(listener.local_addr().unwrap()) { core::net::SocketAddr::V4(value) -> value.port as u64, _ -> 0 }; assert(port > 0); packet(1213421622,port); control(43);
    let accepted = listener.accept(true).unwrap(); listener.close().unwrap(); let fd: i32 = accepted.socket.raw_handle().unwrap();
    let deadline = core::time::deadline_after(std::clock::monotonic_now().unwrap(),core::time::from_millis(4000)).unwrap();
    let owner = ext::https_server::begin_connected(accepted.socket,accepted.peer,context.borrow(),options,ext::https_server::default_options(),deadline).unwrap(); mark("c"); context.destroy(); args.destroy();
    let poll = std::poll::new(1).unwrap(); let readiness = ready(); let steps: u64 = 0; let waits: u64 = 0; let polls: u64 = 0; let heads: u64 = 0; let terminal_events: u64 = 0; let maximum_delta: u64 = 0; let notified: bool = false;
    let terminal_failure: core::option::Option<ext::https_server::Failure> = core::option::None(); let head: core::option::Option<core::slice::View<u8>> = core::option::None(); let head_hash: u32 = 0; let sent: i32 = 0;
    while (match(owner.status()) { ext::http_server::Status::Active -> true, _ -> false }) {
        assert(steps < 20000); steps += 1; let before: i64 = duplex_test_stat(-1,3); let charged: u64 = owner.tls_stats().calls;
        mark("S"); let result = owner.step(readiness); mark("s"); readiness = ready();
        let delta: i64 = duplex_test_stat(-1,3)-before; assert(delta >= 0 && delta <= 1 && owner.tls_stats().calls-charged == delta as u64); if (delta as u64 > maximum_delta) { maximum_delta = delta as u64; }
        if (head.is_some()) { assert(hash(head.unwrap()) == head_hash); }
        if (result.is_err()) { terminal_failure = core::option::Some(result.unwrap_err()); break; }
        if (result.unwrap().is_some()) {
            let kind: i32 = match(result.unwrap().unwrap()) { ext::http_server::Event::Head(value) -> 1, ext::http_server::Event::Empty -> 2, _ -> 99 };
            if (kind == 1) {
                assert(mode != 3 && heads == 0); heads += 1; head = core::option::Some(owner.protocol().head().unwrap().head.raw); head_hash = hash(head.unwrap());
                let fields: [ext::http::Field;0] = []; let body: [u8;9] = [0,255,17,34,51,68,85,102,119]; let before_stage: i64 = duplex_test_stat(-1,3);
                mark("R"); owner.respond(ext::http_server::Response { status:413,reason:bytes("Limit",5),headers:core::slice::view<ext::http::Field>(fields,0).unwrap(),body:core::slice::view<u8>(body,9).unwrap(),date:core::time::system_time(0,0).unwrap() }).unwrap(); mark("r");
                assert(duplex_test_stat(-1,3) == before_stage); body[0] = 238; sent = owner.stats().response_bytes; assert(sent > 9);
            }
            if (kind == 2) { assert(mode == 3 && heads == 0 && notified); terminal_events += 1; assert(terminal_events == 1 && match(owner.status()) { ext::http_server::Status::Complete -> true, _ -> false }); }
            assert(kind != 99);
        }
        if (!notified && owner.stats().write_shutdown) {
            assert(owner.negotiated_version() == 771 || owner.negotiated_version() == 772); notified = true;
            assert(owner.stats().response_sent == sent && owner.stats().response_bytes == sent && !owner.stats().closed);
            assert(owner.stats().peer_eof == (mode == 3)); packet(1213421625,mode as u64); control(71);
        }
        if (!match(owner.status()) { ext::http_server::Status::Active -> true, _ -> false }) { break; }
        let interest = owner.interest(); if (!interest.immediate) {
            let before_wait: i64 = duplex_test_stat(-1,3); mark("W"); let waiting = owner.before_wait(); mark("w"); waits += 1; assert(duplex_test_stat(-1,3) == before_wait);
            if (waiting.is_err()) { terminal_failure = core::option::Some(waiting.unwrap_err()); break; } assert(waiting.unwrap());
            let events: u32 = 0; if (interest.readable) { events |= std::poll::READABLE; } if (interest.writable) { events |= std::poll::WRITABLE; }
            let items: [std::poll::Request;1] = [std::poll::Request { handle:owner.raw_handle().unwrap(),events:events }];
            mark("P"); poll.poll_ms(core::slice::view<std::poll::Request>(items,1).unwrap(),25).unwrap(); mark("p"); polls += 1; let found = poll.readiness(0).unwrap(); readiness = ext::http_client::Readiness { readable:found.readable(),writable:found.writable(),hangup:found.hangup() || found.read_closed(),error:found.error() || found.invalid() };
        }
    }
    assert(notified); let native_code: u64 = 0; let expired: bool = false; let header_bytes: i32 = 0; if (head.is_some()) { header_bytes = head.unwrap().length; assert(hash(head.unwrap()) == head_hash); }
    let calls: i64 = duplex_test_stat(-1,3);
    if (mode == 3) {
        assert(terminal_failure.is_none() && terminal_events == 1 && heads == 0 && owner.last_terminal_failure().is_none());
        assert(owner.stats().received == 0 && owner.stats().retained == 0 && owner.stats().decoded == 0 && owner.stats().drain_received == 0 && owner.stats().response_sent == 0 && owner.stats().response_bytes == 0 && owner.stats().peer_eof && owner.stats().write_shutdown);
        mark("S"); assert(owner.step(ready()).unwrap().is_none()); mark("s"); steps += 1; mark("W"); assert(!owner.before_wait().unwrap()); mark("w"); waits += 1;
    } else {
        assert(terminal_failure.is_some() && terminal_events == 0 && heads == 1 && match(owner.status()) { ext::http_server::Status::Failed -> true, _ -> false });
        let original: ext::https_server::Failure = terminal_failure.unwrap(); native_code = failure(original,mode,sent,header_bytes);
        let cached: ext::https_server::Failure = owner.last_terminal_failure().unwrap(); assert(failure(cached,mode,sent,header_bytes) == native_code);
        mark("S"); let again: ext::https_server::Failure = owner.step(ready()).unwrap_err(); mark("s"); steps += 1; assert(failure(again,mode,sent,header_bytes) == native_code);
        mark("W"); let waited: ext::https_server::Failure = owner.before_wait().unwrap_err(); mark("w"); waits += 1; assert(failure(waited,mode,sent,header_bytes) == native_code);
        assert(again.stats.io_calls == original.stats.io_calls && waited.stats.io_calls == original.stats.io_calls && cached.stats.io_calls == original.stats.io_calls);
        assert(again.stats.work == original.stats.work && waited.stats.work == original.stats.work && cached.stats.work == original.stats.work && again.tls.calls == original.tls.calls && waited.tls.calls == original.tls.calls && cached.tls.calls == original.tls.calls);
        assert(owner.protocol().event().is_none()); if (mode == 0) { expired = deadline.is_expired(std::clock::monotonic_now().unwrap()); assert(expired); }
    }
    let stats = owner.stats(); let tls = owner.tls_stats(); let version: i32 = owner.negotiated_version();
    assert(duplex_test_stat(-1,3) == calls && stats.closed && stats.cleanup_calls == 1 && stats.cleanup_errors == 0 && stats.write_shutdown && owner.raw_handle().is_none());
    assert(duplex_test_fd_open(fd) == 0 && duplex_test_stat(-1,0) == 0 && duplex_test_stat(-1,1) == 0 && duplex_test_stat(-1,2) == 0 && !owner.abort().unwrap());
    if (head.is_some()) { assert(hash(head.unwrap()) == head_hash); } mark("X"); assert(owner.destroy().unwrap()); assert(!owner.destroy().unwrap()); mark("x"); poll.destroy(); assert(duplex_test_stat(-1,3) == calls);
    let values: [u64;32] = [1213421626,mode as u64,version as u64,steps,waits,polls,heads,0,terminal_events,stats.received,stats.drain_received,stats.response_bytes as u64,stats.response_sent as u64,stats.buffered_discarded as u64,stats.write_shutdown as u64,stats.peer_eof as u64,stats.cleanup_calls,stats.cleanup_errors,tls.calls,calls as u64,0,native_code,maximum_delta,fd as u64,header_bytes as u64,notified as u64,head_hash as u64,0,0,0,expired as u64,sent as u64]; if (mode != 3) { values[20] = mode as u64+1; }
    let output: [u8;256] = [0;256]; let i: i32 = 0; while (i < 32) { let j: i32 = 0; while (j < 8) { output[i*8+j] = (values[i]>>(j*8)) as u8; j += 1; } i += 1; }
    let sink = std::stream::stdout(); core::io::write_all(sink.borrow(),output,0,256).unwrap(); control(33); return 0;
