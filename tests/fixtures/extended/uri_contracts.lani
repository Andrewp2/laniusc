module app::main;
import core::mem;
import core::option;
import core::result;
import core::slice;
import ext::uri;
fn bytes(value: str, count: i32) -> core::slice::View<u8> { let raw: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::string_data_ptr(value),count); return core::result::unwrap(core::slice::view(raw,count)); }
fn main() -> i32 {
    let empty: ext::uri::Reference = core::result::unwrap(ext::uri::parse(bytes("",0)));
    assert(empty.is_relative() && empty.path.is_empty() && core::option::is_none(empty.scheme) && core::option::is_none(empty.authority) && core::option::is_none(empty.query) && core::option::is_none(empty.fragment));
    let value: ext::uri::Reference = core::result::unwrap(ext::uri::parse(bytes("HTTP://user:pw@[::ffff:192.0.2.1]:080/a%2Fb?x=?/#",49)));
    assert(!value.is_relative() && core::option::unwrap(value.scheme).len() == 4);
    let auth: ext::uri::Authority = core::option::unwrap(value.authority);
    assert(core::option::unwrap(auth.userinfo).len() == 7 && auth.host.len() == 18 && core::option::unwrap(auth.port).len() == 3);
    let kind: i32 = match (auth.kind) { ext::uri::HostKind::RegName -> 0, ext::uri::HostKind::Ipv4 -> 1, ext::uri::HostKind::Ipv6 -> 2, ext::uri::HostKind::IpvFuture -> 3 }; assert(kind == 2);
    assert(value.path.len() == 6 && core::option::unwrap(value.query).len() == 4 && core::option::unwrap(value.fragment).len() == 0);
    let native: [u8; 9] = [0,47,47,64,58,63,35,0,255];
    let selected: core::slice::View<u8> = core::result::unwrap(core::slice::view_range(native,1,6));
    let borrowed: ext::uri::Reference = core::result::unwrap(ext::uri::parse(selected));
    assert(borrowed.raw.start == 1 && borrowed.raw.len() == 6 && borrowed.path.is_empty());
    let authority: ext::uri::Authority = core::option::unwrap(borrowed.authority);
    assert(core::option::unwrap(authority.userinfo).is_empty() && authority.host.is_empty() && core::option::unwrap(authority.port).is_empty());
    assert(core::option::unwrap(borrowed.query).is_empty() && core::option::unwrap(borrowed.fragment).is_empty());
    let mutable: [u8; 4] = [47,97,63,98];
    let aliased: ext::uri::Reference = core::result::unwrap(ext::uri::parse(core::result::unwrap(core::slice::view(mutable,4))));
    mutable[1] = 120; mutable[3] = 121;
    assert(core::option::unwrap(aliased.path.get(1)) == 120 && core::option::unwrap(core::option::unwrap(aliased.query).get(0)) == 121);
    let invalid: core::slice::View<u8> = selected; invalid.start = -1; assert(core::result::is_err(ext::uri::parse(invalid)));
    invalid = selected; invalid.length = -1; assert(core::result::is_err(ext::uri::parse(invalid)));
    invalid = selected; invalid.start = 2147483647; assert(core::result::is_err(ext::uri::parse(invalid)));
    assert(core::result::is_err(ext::uri::parse_with_limit(selected,-1)) && core::result::is_err(ext::uri::parse_with_limit(selected,5)));
    assert(core::result::is_ok(ext::uri::parse_with_limit(selected,6)) && core::result::is_ok(ext::uri::parse_with_limit(bytes("",0),0)));
    let offset_bytes: [u8; 5] = [0,97,37,71,0]; let offset: core::slice::View<u8> = core::result::unwrap(core::slice::view_range(offset_bytes,1,3));
    let error: ext::uri::Error = core::result::unwrap_err(ext::uri::parse(offset));
    let location: i32 = match (error) { ext::uri::Error::InvalidPercent(index) -> index, _ -> -1 }; assert(location == 1);
    let nul: [u8; 3] = [47,0,47]; let nul_view: core::slice::View<u8> = core::result::unwrap(core::slice::view(nul,3));
    let nul_error: ext::uri::Error = core::result::unwrap_err(ext::uri::parse(nul_view));
    let nul_offset: i32 = match (nul_error) { ext::uri::Error::InvalidByte(index) -> index, _ -> -1 }; assert(nul_offset == 1);
    return 0;
}
