 let no_content: alloc::vec::Vec<u8> = core::result::unwrap(ext::http::encode_response(bytes("HTTP/1.1 204 No Content",23),bytes("GET",3),no_fields,bytes("",0),limits)); let response_head: ext::http::Head = core::result::unwrap(ext::http::parse_response_head(no_content.as_view(),bytes("GET",3),limits)); assert(response_head.content_length == -1 && response_head.field_count == 0 && response_head.raw.len() == no_content.len()); no_content.destroy();
 let no_content: alloc::vec::Vec<u8> = core::result::unwrap(ext::http::encode_response(bytes("HTTP/1.1 304 Not Modified",25),bytes("GET",3),no_fields,bytes("",0),limits)); let response_head: ext::http::Head = core::result::unwrap(ext::http::parse_response_head(no_content.as_view(),bytes("GET",3),limits)); assert(response_head.content_length == -1 && response_head.field_count == 0 && response_head.raw.len() == no_content.len()); no_content.destroy();
