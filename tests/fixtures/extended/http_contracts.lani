module app::main;
import alloc::vec;
import core::mem;
import core::option;
import core::result;
import core::slice;
import ext::http;
fn bytes(value: str, count: i32) -> core::slice::View<u8> { let raw: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::string_data_ptr(value),count); return core::result::unwrap(core::slice::view(raw,count)); }
fn kind(value: ext::http::BodyKind) -> i32 { return match (value) { ext::http::BodyKind::Empty -> 0, ext::http::BodyKind::Fixed -> 1, ext::http::BodyKind::Chunked -> 2, ext::http::BodyKind::Close -> 3, ext::http::BodyKind::Tunnel -> 4 }; }
fn code(value: ext::http::Error) -> i32 { return match (value) { ext::http::Error::Bounds -> 0, ext::http::Error::Incomplete(at) -> 1, ext::http::Error::Malformed(at) -> 2, ext::http::Error::Limit(at) -> 3, ext::http::Error::Unsupported(at) -> 4, ext::http::Error::Capacity -> 5, ext::http::Error::AllocationFailed -> 6 }; }
fn main() -> i32 {
 let limits: ext::http::Limits = ext::http::default_limits();
 let fixed: ext::http::Message = core::result::unwrap(ext::http::parse_request(bytes("POST /x?y HTTP/1.1\r\nHoSt: x\r\nX-A:  one \t\r\nx-a: two\r\nContent-Length: 3\r\n\r\nabcNEXT",80),false,limits));
