 headers[0].value = bytes("x\r\nBad: injection",17); assert(code(core::result::unwrap_err(ext::http::encode_request(bytes("GET / HTTP/1.1",14),core::result::unwrap(core::slice::view(headers,1)),bytes("",0),limits))) == 2);
 let offset_storage: [u8;30] = [90,90,71,69,84,32,47,32,72,84,84,80,47,49,46,49,13,10,72,111,115,116,58,32,120,13,10,13,10,90];
 let offset_source: core::slice::View<u8> = core::result::unwrap(core::slice::view_range(offset_storage,2,27)); let offset_head: ext::http::Head = core::result::unwrap(ext::http::parse_request_head(offset_source,limits)); assert(offset_head.raw.start == 2 && offset_head.raw.len() == 27);
 let offset_field: ext::http::Field = core::option::unwrap(offset_head.lookup(bytes("HOST",4))); assert(offset_field.offset == 16 && offset_field.value.start == 24); offset_storage[24] = 121; assert(core::option::unwrap(offset_field.value.get(0)) == 121);
