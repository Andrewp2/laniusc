 let short_head: core::slice::View<u8> = core::result::unwrap(core::slice::view(head_storage,26)); assert(code(core::result::unwrap_err(ext::http::write_head_into(offset_head,short_head,limits))) == 5 && head_storage[0] == 90);
 cap = limits; cap.headers = 0; assert(code(core::result::unwrap_err(ext::http::parse_request(source,false,cap))) == 3);
