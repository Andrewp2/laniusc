 assert(core::result::is_ok(ext::http::parse_request(bytes("GET //a:b/c HTTP/1.1\r\nHost: x\r\n\r\n",33),false,limits)));
 assert(core::result::is_ok(ext::http::parse_request(bytes("GET /a//?x=? HTTP/1.1\r\nHost: x\r\n\r\n",34),false,limits)));
