 let tunnel: ext::http::Message = core::result::unwrap(ext::http::parse_response(bytes("HTTP/1.1 200 Tunnel\r\nContent-Length: 5\r\nTransfer-Encoding: chunked\r\n\r\nTUNNEL",76),bytes("CONNECT",7),false,limits)); assert(kind(tunnel.head.kind) == 4 && tunnel.consumed == 70 && tunnel.head.field_count == 2 && tunnel.head.content_length == -1 && tunnel.decoded_length == 0 && tunnel.encoded_body.is_empty()); assert(core::result::unwrap(ext::http::decode_into(tunnel,view)) == 0); assert(core::result::is_err(ext::http::write_head_into(tunnel.head,head_destination,limits)));
 let tunnel: ext::http::Message = core::result::unwrap(ext::http::parse_response(bytes("HTTP/1.1 200 Tunnel\r\nContent-Length: not-a-number\r\nTransfer-Encoding: gzip, chunked\r\n\r\nTUNNEL",93),bytes("CONNECT",7),false,limits)); assert(kind(tunnel.head.kind) == 4 && tunnel.consumed == 87 && tunnel.head.field_count == 2 && tunnel.head.content_length == -1 && tunnel.decoded_length == 0 && tunnel.encoded_body.is_empty()); assert(core::result::unwrap(ext::http::decode_into(tunnel,view)) == 0); assert(core::result::is_err(ext::http::write_head_into(tunnel.head,head_destination,limits)));
