 let destination: [u8;9] = [90;9]; let view: core::slice::View<u8> = core::result::unwrap(core::slice::view_range(destination,2,5)); assert(core::result::unwrap(ext::http::decode_into(chunks,view)) == 5);
 assert(destination[0] == 90 && destination[1] == 90 && destination[2] == 97 && destination[3] == 0 && destination[4] == 98 && destination[5] == 255 && destination[6] == 122 && destination[7] == 90);
 let small: core::slice::View<u8> = core::result::unwrap(core::slice::view_range(destination,0,4)); assert(code(core::result::unwrap_err(ext::http::decode_into(chunks,small))) == 5 && destination[0] == 90);
 let invalid: core::slice::View<u8> = source; invalid.start = -1; assert(code(core::result::unwrap_err(ext::http::parse_request(invalid,false,limits))) == 0); invalid = source; invalid.length = -1; assert(code(core::result::unwrap_err(ext::http::parse_request(invalid,false,limits))) == 0); invalid = source; invalid.start = 2147483647; assert(code(core::result::unwrap_err(ext::http::parse_request(invalid,false,limits))) == 0);
 let response: ext::http::Message = core::result::unwrap(ext::http::parse_response(bytes("HTTP/1.1 200 OK\r\nContent-Length: 3\r\n\r\nabcNEXT",45),bytes("GET",3),false,limits)); assert(kind(response.head.kind) == 1 && response.consumed == 41 && response.decoded_length == 3);
 let response: ext::http::Message = core::result::unwrap(ext::http::parse_response(bytes("HTTP/1.1 200 OK\r\nContent-Length: 99999999\r\n\r\nNEXT",49),bytes("HEAD",4),false,limits)); assert(kind(response.head.kind) == 0 && response.consumed == 45 && response.decoded_length == 0);
 let response: ext::http::Message = core::result::unwrap(ext::http::parse_response(bytes("HTTP/1.1 304 OK\r\nContent-Length: 99\r\n\r\nNEXT",43),bytes("GET",3),false,limits)); assert(kind(response.head.kind) == 0 && response.consumed == 39 && response.decoded_length == 0);
 let response: ext::http::Message = core::result::unwrap(ext::http::parse_response(bytes("HTTP/1.1 204 OK\r\n\r\nNEXT",23),bytes("GET",3),false,limits)); assert(kind(response.head.kind) == 0 && response.consumed == 19 && response.decoded_length == 0);
 let response: ext::http::Message = core::result::unwrap(ext::http::parse_response(bytes("HTTP/1.1 200 OK\r\n\r\nNEXT",23),bytes("CONNECT",7),false,limits)); assert(kind(response.head.kind) == 4 && response.consumed == 19 && response.decoded_length == 0);
 let response: ext::http::Message = core::result::unwrap(ext::http::parse_response(bytes("HTTP/1.1 100 OK\r\n\r\nNEXT",23),bytes("GET",3),false,limits)); assert(kind(response.head.kind) == 0 && response.consumed == 19 && response.decoded_length == 0);
 let close: core::slice::View<u8> = bytes("HTTP/1.0 200 OK\r\n\r\nabc",22); assert(code(core::result::unwrap_err(ext::http::parse_response(close,bytes("GET",3),false,limits))) == 1); assert(core::result::unwrap(ext::http::parse_response(close,bytes("GET",3),true,limits)).decoded_length == 3);
