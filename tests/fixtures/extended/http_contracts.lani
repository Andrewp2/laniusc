 assert(core::result::is_ok(ext::http::parse_request(bytes("CONNECT [::1]:443 HTTP/1.1\r\nHost: x\r\n\r\n",39),false,limits)));
 assert(core::result::is_ok(ext::http::parse_request(bytes("OPTIONS * HTTP/1.1\r\nHost: x\r\n\r\n",31),false,limits)));
 assert(core::result::is_err(ext::http::parse_request(bytes("GET /x#f HTTP/1.1\r\nHost: x\r\n\r\n",30),false,limits)));
 assert(core::result::is_err(ext::http::parse_request(bytes("GET /x%2 HTTP/1.1\r\nHost: x\r\n\r\n",30),false,limits)));
 assert(core::result::is_err(ext::http::parse_request(bytes("GET http://u@x/ HTTP/1.1\r\nHost: x\r\n\r\n",37),false,limits)));
 assert(core::result::is_err(ext::http::parse_request(bytes("GET http://x/#f HTTP/1.1\r\nHost: x\r\n\r\n",37),false,limits)));
 assert(core::result::is_err(ext::http::parse_request(bytes("GET * HTTP/1.1\r\nHost: x\r\n\r\n",27),false,limits)));
 assert(core::result::is_err(ext::http::parse_request(bytes("CONNECT /x HTTP/1.1\r\nHost: x\r\n\r\n",32),false,limits)));
 assert(core::result::is_err(ext::http::parse_request(bytes("CONNECT x HTTP/1.1\r\nHost: x\r\n\r\n",31),false,limits)));
 assert(core::result::is_err(ext::http::parse_request(bytes("CONNECT x: HTTP/1.1\r\nHost: x\r\n\r\n",32),false,limits)));
 let cap: ext::http::Limits = limits; cap.body_bytes = 4; assert(code(core::result::unwrap_err(ext::http::parse_request(source,false,cap))) == 3); cap = limits; cap.chunks = 1; assert(code(core::result::unwrap_err(ext::http::parse_request(source,false,cap))) == 3); cap = limits; cap.trailers = 0; assert(code(core::result::unwrap_err(ext::http::parse_request(source,false,cap))) == 3); cap = limits; cap.head_bytes = 26;
 assert(code(core::result::unwrap_err(ext::http::parse_request(bytes("GET / HTTP/1.1\r\nHost: x\r\n\r\n",27),false,cap))) == 3); cap = limits; cap.head_bytes = 27; assert(core::result::is_ok(ext::http::parse_request(bytes("GET / HTTP/1.1\r\nHost: x\r\n\r\n",27),false,cap)));
