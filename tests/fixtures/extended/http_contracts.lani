 assert(code(core::result::unwrap_err(ext::http::parse_request(bytes("GET / HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\nContent-Length: 0\r\n\r\n0\r\n\r\n",79),false,limits))) == 2);
 assert(code(core::result::unwrap_err(ext::http::parse_request(bytes("GET / HTTP/1.1\r\nHost: x\r\n X: y\r\n\r\n",34),false,limits))) == 2);
