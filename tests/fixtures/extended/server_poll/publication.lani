// Separate actual-Server controls: no HTTP wire or TLS acceptance claim.
module app::main;
import core::clone;
import core::io;
import core::mem;
import core::net;
import core::option;
import core::result;
import core::slice;
import core::time;
import ext::http_client;
import ext::http_server;
import ext::server_poll;
import std::clock;
import std::poll;
import std::socket;
import std::stream;

struct ApplicationError { code: i32 }
pub impl core::clone::Destroy<ApplicationError> for ApplicationError { pub fn destroy_value(owned: ApplicationError) { assert(false); } }
struct Ledger { begun: i32, destroyed: i32, closed: i32, wakes: i32, retire_first: bool, first_fd: i32 }
struct Driver { owner: ext::http_server::Protocol, socket: std::socket::Socket, ledger: &Ledger, id: i32 }
struct Factory { options: ext::http_server::Options, ledger: &Ledger }
struct Handler { calls: i32 }
impl Ledger { fn borrow(&self) -> &Ledger { return self; } }
impl Factory { fn borrow(&self) -> &Factory { return self; } }
impl Handler { fn borrow(&self) -> &Handler { return self; } }
fn timeout(cause: ext::http_server::Cause) -> bool { return match(cause) { ext::http_server::Cause::Timeout -> true, _ -> false }; }
fn local(owner: &ext::http_server::Protocol) -> bool { return match(owner.need()) { ext::http_server::Need::Local -> true, _ -> false }; }
fn close(driver: &Driver) -> bool {
    let open: bool = driver.socket.is_open(); driver.owner.abort();
    if (open) {
        driver.socket.close().unwrap(); driver.ledger.closed += 1;
        let recorded = driver.owner.record_close(true,core::option::None()); if (recorded.is_err()) { assert(timeout(recorded.unwrap_err().cause)); }
    }
    return open;
}
pub impl ext::server_poll::Driver<ext::http_server::Failure> for Driver {
    pub fn protocol(&self) -> &ext::http_server::Protocol { return self.owner.borrow(); }
    pub fn stats(&self) -> ext::http_server::Stats { return self.owner.stats(); }
    pub fn transport_calls(&self) -> core::option::Option<u64> { return core::option::None(); }
    pub fn rejection(&self) -> core::option::Option<ext::http_server::Rejection> { return self.owner.rejection(); }
    pub fn raw_handle(&self) -> core::option::Option<i32> { return self.socket.raw_handle(); }
    pub fn interest(&self) -> ext::http_client::Interest { let immediate: bool = local(self.owner.borrow()); return ext::http_client::Interest { readable:!immediate,writable:false,immediate:immediate }; }
    pub fn before_wait(&self) -> core::result::Result<bool,ext::http_server::Failure> {
        if (self.id == 0 && self.ledger.retire_first) {
            self.owner.failure(ext::http_server::Cause::Timeout); close(self); return core::result::Err(self.owner.last_terminal_failure().unwrap());
        }
        let checked = self.owner.check(); if (checked.is_err()) { close(self); return core::result::Err(self.owner.last_terminal_failure().unwrap()); }
        if (local(self.owner.borrow())) { return core::result::Ok(false); } return self.owner.before_wait();
    }
    pub fn step(&self, ready: ext::http_client::Readiness) -> core::result::Result<core::option::Option<ext::http_server::Event>,ext::http_server::Failure> {
        if (local(self.owner.borrow())) {
            assert(!ready.readable && !ready.writable && !ready.hangup && !ready.error);
            let advanced = self.owner.advance(); if (advanced.is_err()) { let error = advanced.unwrap_err(); close(self); return core::result::Err(error); }
        } else {
            // A scripted local observation consumes advisory readiness once.
            // No receive, successful transport count or HTTP event is invented.
            assert(ready.readable && !ready.writable && !ready.hangup && !ready.error); self.ledger.wakes += 1;
        }
        return core::result::Ok(core::option::None());
    }
    pub fn read_body(&self, decision: ext::http_server::BodyDecision) -> core::result::Result<bool,ext::http_server::Failure> { return self.owner.read_body(decision); }
    pub fn abort(&self) -> core::result::Result<bool,ext::http_server::Failure> { return core::result::Ok(close(self)); }
    pub fn destroy(&self) { assert(!self.socket.is_open() && self.owner.destroy() && self.owner.logical_bytes() == 0 && !self.owner.destroy()); self.ledger.destroyed += 1; }
}
pub impl ext::server_poll::Factory<Driver,ext::http_server::Failure> for Factory {
    pub fn reservation(&self) -> core::result::Result<ext::server_poll::Reservation,ext::server_poll::Cause> { return core::result::Ok(ext::server_poll::Reservation { work:self.options.work,bytes:ext::http_server::reservation_bytes(self.options).unwrap() }); }
    pub fn begin(&self, accepted: std::socket::Accepted, deadline: core::time::Deadline) -> core::result::Result<Driver,ext::http_server::Failure> {
        let made = ext::http_server::protocol(self.options,deadline); if (made.is_err()) { accepted.socket.close().unwrap(); return core::result::Err(made.unwrap_err()); }
        let id: i32 = self.ledger.begun; if (id == 0) { self.ledger.first_fd = accepted.socket.raw_handle().unwrap(); } self.ledger.begun += 1;
        return core::result::Ok(Driver { owner:made.unwrap(),socket:accepted.socket,ledger:self.ledger,id:id });
    }
    pub fn failure_stats(&self, error: ext::http_server::Failure) -> ext::http_server::Stats { return error.stats; }
    pub fn failure_transport_calls(&self, error: ext::http_server::Failure) -> core::option::Option<u64> { return core::option::None(); }
    pub fn shared_failure(&self, error: ext::http_server::Failure) -> core::option::Option<ext::server_poll::Cause> { return match(error.cause) { ext::http_server::Cause::Clock(value) -> core::option::Some(ext::server_poll::Cause::Clock(value)), _ -> core::option::None() }; }
}
pub impl ext::server_poll::Handler<ApplicationError> for Handler {
    pub fn head(&self, id: u64, peer: core::net::SocketAddr, head: ext::http_server::RequestHead, reply: &ext::server_poll::Reply) -> core::result::Result<ext::server_poll::Decision,ApplicationError> { self.calls += 1; assert(false); return core::result::Ok(ext::server_poll::Decision::Abort); }
    pub fn request(&self, id: u64, request: ext::http_server::Request, reply: &ext::server_poll::Reply) -> core::result::Result<ext::server_poll::Decision,ApplicationError> { self.calls += 1; assert(false); return core::result::Ok(ext::server_poll::Decision::Abort); }
    pub fn rejected(&self, id: u64, rejection: ext::http_server::Rejection, reply: &ext::server_poll::Reply) -> core::result::Result<ext::server_poll::Decision,ApplicationError> { self.calls += 1; assert(false); return core::result::Ok(ext::server_poll::Decision::Abort); }
}
fn deadline() -> core::time::Deadline { return core::time::deadline_after(std::clock::monotonic_now().unwrap(),core::time::from_secs(10)).unwrap(); }
fn listener() -> std::socket::Socket {
    let owner = std::socket::create(std::socket::Family::Ipv4,std::socket::Kind::Tcp,true).unwrap(); owner.bind(core::net::SocketAddr::V4(core::net::SocketAddrV4 { address:core::net::ipv4(127,0,0,1),port:0 })).unwrap(); owner.listen(2).unwrap(); return owner;
}
fn client(listener: &std::socket::Socket, until: core::time::Deadline) -> std::socket::Socket { let owner = std::socket::create(std::socket::Family::Ipv4,std::socket::Kind::Tcp,true).unwrap(); owner.connect_until(listener.local_addr().unwrap(),until).unwrap(); return owner; }
fn eof(client: &std::socket::Socket, until: core::time::Deadline) { let buffer: [u8;1] = [0]; assert(client.receive_until(core::slice::view<u8>(buffer,1).unwrap(),until).unwrap() == 0); client.close().unwrap(); }
fn options() -> ext::http_server::Options {
    let value = ext::http_server::default_options(); value.request_bytes = 1024; value.request.head_bytes = 256; value.request.body_bytes = 0; value.request.trailers = 0; value.response_bytes = 1024; value.response.head_bytes = 256; value.response.line_bytes = 128; value.response.body_bytes = 256; value.response.headers = 8; value.work = 4096; return value;
}
fn invalid(value: core::result::Result<bool,ext::server_poll::Cause>) { assert(value.is_err() && match(value.unwrap_err()) { ext::server_poll::Cause::InvalidPublication -> true, _ -> false }); }
fn publication() {
    let until = deadline(); let listening = listener(); let settings = options();
    let ledger: Ledger = Ledger { begun:0,destroyed:0,closed:0,wakes:0,retire_first:false,first_fd:-1 }; let factory: Factory = Factory { options:settings,ledger:ledger.borrow() }; let handler: Handler = Handler { calls:0 };
    let limits = ext::server_poll::default_limits(); limits.max_accepted = 1; limits.concurrency = 1;
    let server: ext::server_poll::Server<Driver,ext::http_server::Failure,Factory,Handler,ApplicationError> = ext::server_poll::new<Driver,ext::http_server::Failure,Factory,Handler,ApplicationError>(listening.borrow(),factory.borrow(),handler.borrow(),limits,until).unwrap();
    let peer = client(listening.borrow(),until); server.step().unwrap(); server.step().unwrap();
    let first = server.prepare_wait().unwrap(); let old_epoch: u64 = first.epoch; assert(first.requests.length == 2 && old_epoch != 0 && !first.immediate && !first.complete && first.requests.get(0).unwrap().handle == -1 && first.requests.get(1).unwrap().handle == ledger.first_fd);
    let ready: [std::poll::Readiness;2] = [std::poll::Readiness { bits:std::poll::READABLE },std::poll::Readiness { bits:std::poll::READABLE }];
    let charged: u64 = server.stats().operations; invalid(server.resume(old_epoch,core::slice::view<std::poll::Readiness>(ready,1).unwrap())); assert(server.stats().operations == charged);
    invalid(server.resume(old_epoch+1,core::slice::view<std::poll::Readiness>(ready,2).unwrap())); assert(server.stats().operations == charged && ledger.wakes == 0);
    let second = server.prepare_wait().unwrap(); let current_epoch: u64 = second.epoch; assert(current_epoch != old_epoch);
    invalid(server.resume(old_epoch,core::slice::view<std::poll::Readiness>(ready,2).unwrap()));
    server.resume(current_epoch,core::slice::view<std::poll::Readiness>(ready,2).unwrap()).unwrap(); invalid(server.resume(current_epoch,core::slice::view<std::poll::Readiness>(ready,2).unwrap()));
    server.step().unwrap(); assert(ledger.wakes == 1); server.step().unwrap(); assert(ledger.wakes == 1);
    let third = server.prepare_wait().unwrap(); let invalidated: u64 = third.epoch; assert(invalidated != 0); server.stop_accepting(); invalid(server.resume(invalidated,core::slice::view<std::poll::Readiness>(ready,2).unwrap()));
    assert(server.abort_all() && !server.abort_all()); let report = server.take_report().unwrap(); assert(report.stats.aborted == 1 && report.stats.waits == 3 && report.stats.polls == 0 && report.stats.reserved_work == 0 && report.stats.reserved_bytes == 0 && report.stats.active == 0 && handler.calls == 0 && ledger.closed == 1 && ledger.destroyed == 1); report.destroy(); assert(!server.destroy()); eof(peer.borrow(),until); assert(listening.is_open()); listening.close().unwrap();
}
// profile0: active slot cap; profile1: byte reservation cap; profile2:
// cumulative work cannot be refunded after the first connection retires.
fn retirement(profile: i32) {
    let until = deadline(); let listening = listener(); let settings = options(); let bytes: u64 = ext::http_server::reservation_bytes(settings).unwrap();
    let ledger: Ledger = Ledger { begun:0,destroyed:0,closed:0,wakes:0,retire_first:false,first_fd:-1 }; let factory: Factory = Factory { options:settings,ledger:ledger.borrow() }; let handler: Handler = Handler { calls:0 };
    let limits = ext::server_poll::default_limits(); limits.max_accepted = 2; limits.concurrency = 1; limits.work = settings.work*2; limits.live_bytes = bytes*2;
    if (profile == 1) { limits.concurrency = 2; limits.live_bytes = bytes; } if (profile == 2) { limits.concurrency = 2; limits.work = settings.work; }
    let server: ext::server_poll::Server<Driver,ext::http_server::Failure,Factory,Handler,ApplicationError> = ext::server_poll::new<Driver,ext::http_server::Failure,Factory,Handler,ApplicationError>(listening.borrow(),factory.borrow(),handler.borrow(),limits,until).unwrap();
    let first = client(listening.borrow(),until); let queued = client(listening.borrow(),until); server.step().unwrap(); server.step().unwrap();
    assert(ledger.begun == 1 && server.stats().accepted == 1 && server.stats().active == 1 && server.stats().peak_active == 1 && server.stats().reserved_bytes == bytes && server.stats().work == 2048 && server.stats().reserved_work == settings.work-2048);
    let before = server.prepare_wait().unwrap(); assert(before.epoch != 0 && !before.immediate && before.requests.get(0).unwrap().handle == -1);
    let accept_calls: u64 = server.stats().accept_calls; server.step().unwrap(); assert(server.stats().accept_calls == accept_calls && ledger.begun == 1);
    ledger.retire_first = true; let freed = server.prepare_wait().unwrap(); assert(freed.immediate && !freed.complete && freed.epoch == 0 && freed.requests.length == 0 && ledger.destroyed == 1 && ledger.closed == 1 && server.stats().active == 0 && server.stats().reserved_work == 0 && server.stats().reserved_bytes == 0 && server.last_failure().is_none());
    if (profile == 2) {
        let stopped = server.step(); assert(stopped.is_err() && match(stopped.unwrap_err()) { ext::server_poll::Cause::WorkLimit -> true, _ -> false }); assert(server.is_complete() && ledger.begun == 1 && server.stats().accepted == 1 && server.stats().work == 2048); queued.close().unwrap();
    } else {
        // The next step must acquire the queued owner before any new blocking
        // publication, using the reservation just released by before_wait.
        server.step().unwrap(); assert(ledger.begun == 2 && server.stats().accepted == 2 && server.stats().active == 1 && server.stats().peak_active == 1 && server.stats().reserved_bytes == bytes && !server.is_accepting());
        assert(server.abort_all() && !server.abort_all()); eof(queued.borrow(),until); assert(server.last_failure().is_none());
    }
    let report = server.take_report().unwrap(); assert(report.stats.failed == 1 && report.stats.handler_calls == 0 && report.stats.active == 0 && report.stats.reserved_work == 0 && report.stats.reserved_bytes == 0 && handler.calls == 0 && ledger.destroyed == ledger.begun && ledger.closed == ledger.begun);
    let failed: core::option::Option<ext::server_poll::TransportFailure<ext::http_server::Failure>> = match(report.get(0).unwrap()) { ext::server_poll::Outcome::Failed(value) -> core::option::Some(value), _ -> core::option::None() };
    let failure = failed.unwrap(); assert(timeout(failure.error.cause) && failure.info.id == 0 && failure.info.stats.closed && failure.info.stats.cleanup_calls == 1 && failure.info.stats.cleanup_errors == 0 && failure.error.stats.closed && failure.error.cleanup_attempted && failure.cleanup.is_none());
    if (profile != 2) { assert(report.stats.aborted == 1 && report.stats.peak_reserved_bytes == bytes && match(report.get(1).unwrap()) { ext::server_poll::Outcome::Aborted(value) -> value.info.id == 1 && value.info.stats.closed && value.cleanup.is_none(), _ -> false }); }
    report.destroy(); report.destroy(); assert(!server.destroy()); eof(first.borrow(),until); assert(listening.is_open()); listening.close().unwrap();
}
fn main() -> i32 {
    publication(); retirement(0); retirement(1); retirement(2);
    let marker: [i32;4] = [0x53504f4c,4,6,6]; let wire: [u8] = core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(marker),16); let sink = std::stream::stdout(); core::io::write_all(sink.borrow(),wire,0,16).unwrap();
    let source = std::stream::stdin(); let ack: [u8;1] = [0]; core::io::read_exact(source.borrow(),ack,0,1).unwrap(); assert(ack[0] == 1); return 0;
}
