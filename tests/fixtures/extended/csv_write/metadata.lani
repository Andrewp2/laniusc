module app::main;
import core::io;
import core::mem;
import core::result;
import core::text;
import ext::csv;
import ext::csv_write;
struct Reject { calls: i32, flushes: i32 }
impl Reject { fn borrow(&self) -> &Reject { return self; } }
pub impl core::io::Write for Reject {
    pub fn write(&self, bytes: [u8], offset: i32, count: i32) -> core::result::Result<i32,core::io::Error> { self.calls += 1; return core::result::Ok(count); }
    pub fn flush(&self) -> core::result::Result<i32,core::io::Error> { self.flushes += 1; return core::result::Ok(0); }
}
fn literal(value: str, count: i32) -> core::text::Text { let bytes: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::string_data_ptr(value),count); return core::text::from_utf8(bytes,count).unwrap(); }
fn rejected(row: ext::csv::Record, kind: i32, at: u64) {
    let target: Reject = Reject { calls: 0, flushes: 0 };
    let error = ext::csv_write::write_record(target.borrow(),row.borrow(),ext::csv_write::default_limits()).unwrap_err();
    let csv: ext::csv::Error = match (error.cause) { ext::csv_write::Cause::Csv(error) -> error, _ -> ext::csv::Error::Finished };
    let actual: i32 = match (csv) { ext::csv::Error::Bounds -> 1, ext::csv::Error::InvalidUtf8(offset) -> offset_code(offset,at,2), ext::csv::Error::InvalidCharacter(offset) -> offset_code(offset,at,3), _ -> 0 };
    assert(actual == kind && error.written == 0 && error.write_calls == 0 && target.calls == 0 && target.flushes == 0);
    assert(ext::csv::encode_record(row).is_err());
}
fn offset_code(offset: u64, wanted: u64, code: i32) -> i32 { assert(offset == wanted); return code; }
fn main() -> i32 {
    let row: ext::csv::Record = ext::csv::new();
    row.try_push_field(literal("ab",2)).unwrap(); row.try_push_field(literal("cd",2)).unwrap();
    let span = row.fields.at(1);
    let bad = span; bad.start = -1; row.fields.set(1,bad).unwrap(); rejected(row,1,0);
    bad = span; bad.start = 1; row.fields.set(1,bad).unwrap(); rejected(row,1,0);
    bad = span; bad.start = 3; row.fields.set(1,bad).unwrap(); rejected(row,1,0);
    bad = span; bad.length = -1; row.fields.set(1,bad).unwrap(); rejected(row,1,0);
    bad = span; bad.length = 2147483647; row.fields.set(1,bad).unwrap(); rejected(row,1,0);
    bad = span; bad.length = 1; row.fields.set(1,bad).unwrap(); rejected(row,1,0);
    row.fields.set(1,span).unwrap();
    let fields: i32 = row.fields.length; let field_capacity: i32 = row.fields.reserved;
    row.fields.length = -1; rejected(row,1,0); row.fields.length = fields;
    row.fields.length = field_capacity + 1; rejected(row,1,0); row.fields.length = fields;
    row.fields.reserved = -1; rejected(row,1,0); row.fields.reserved = field_capacity;
    let bytes: i32 = row.bytes.length; let byte_capacity: i32 = row.bytes.reserved;
    row.bytes.length = -1; rejected(row,1,0); row.bytes.length = bytes;
    row.bytes.length = byte_capacity + 1; rejected(row,1,0); row.bytes.length = bytes;
    row.bytes.reserved = -1; rejected(row,1,0); row.bytes.reserved = byte_capacity;
    row.bytes.set(3,255).unwrap(); rejected(row,2,3);
    row.bytes.set(3,0).unwrap(); rejected(row,3,3);
    row.bytes.set(3,100).unwrap(); assert(row.encoded_len().unwrap() == 11);
    // Text can be forged even though ordinary Text constructors validate it.
    let source: [u8;5] = [65,195,169,240,159];
    let before: i32 = row.field_count(); let cap: i32 = row.byte_capacity();
    let failed = row.try_push_field(core::text::Text { bytes: source, start: 0, length: 5 }).unwrap_err();
    assert(match (failed) { ext::csv::Error::InvalidUtf8(at) -> at == 3, _ -> false });
    assert(row.field_count() == before && row.byte_capacity() == cap);
    row.destroy(); return 0;
}
