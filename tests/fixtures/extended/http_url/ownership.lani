// Live checkpoints make explicit cleanup, rather than process exit, observable.
module app::main;
import core::mem;
import core::io;
import core::slice;
import core::slice::View;
import core::result::Result;
import std::stream;
import std::linux;
import ext::http_url;

fn word(value: u64) -> bool {
    let bytes: [u8;8] = [0;8]; let i: i32 = 0;
    while (i < 8) { bytes[i] = ((value >> (i*8)) & 255) as u8; i += 1; }
    let output: std::stream::Descriptor = std::stream::stdout();
    assert(core::io::write_all(output.borrow(),bytes,0,8).is_ok()); return true;
}
fn payload(value: View<u8>) -> bool {
    let output: std::stream::Descriptor = std::stream::stdout();
    assert(core::io::write_all(output.borrow(),value.values,value.start,value.length).is_ok()); return true;
}
fn decode(bytes: [u8], offset: i32) -> u64 {
    let value: u64 = 0; let i: i32 = 0; while (i < 8) { value |= (bytes[offset+i] as u64) << (i*8); i += 1; } return value;
}
fn kind(value: ext::http_url::ErrorKind) -> i32 {
    return match (value) {
        ext::http_url::ErrorKind::Bounds -> 1, ext::http_url::ErrorKind::InvalidLimits -> 2,
        ext::http_url::ErrorKind::Uri -> 3, ext::http_url::ErrorKind::Scheme -> 4,
        ext::http_url::ErrorKind::Authority -> 5, ext::http_url::ErrorKind::Userinfo -> 6,
        ext::http_url::ErrorKind::Host -> 7, ext::http_url::ErrorKind::Port -> 8,
        ext::http_url::ErrorKind::TargetLimit -> 9, ext::http_url::ErrorKind::AllocationFailed -> 10
    };
}
fn ack() -> bool {
    let byte: [u8;1] = [0]; let input: std::stream::Descriptor = std::stream::stdin();
    assert(core::io::read_exact(input.borrow(),byte,0,1).is_ok() && byte[0] == 65); return true;
}
fn inactive(url: &ext::http_url::Url) -> bool {
    return !url.is_open() && url.scheme().is_none() && url.host_kind().is_none() && url.host().is_none() && url.ip().is_none() && url.port().is_none() && url.authority().is_none() && url.target().is_none();
}
fn header(pid: u64, code: i32, offset: i32, layout: i32, stride: isize, raw_length: i32, host: i32, authority: i32, target: i32) -> bool {
    assert(word((104+host+authority+target) as u64) && word(0x55524f) && word(1) && word(pid));
    assert(word((code != 0) as u64) && word(code as u64) && word(offset as u64) && word(layout as u64) && word(stride as u64));
    assert(word(3) && word(raw_length as u64) && word(host as u64) && word(authority as u64) && word(target as u64)); return true;
}
fn released(pid: u64) -> bool {
    assert(word(24) && word(0x55524f) && word(2) && word(pid) && ack()); return true;
}
fn main() -> i32 {
    let words: [i32;138] = [0;138];
    let packet: [u8] = core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(words),552);
    let descriptor: std::stream::Descriptor = std::stream::stdin(); assert(core::io::read_exact(descriptor.borrow(),packet,0,552).is_ok());
    let length: i32 = decode(packet,0) as i32; let layout: i32 = decode(packet,24) as i32; let malformed: i32 = decode(packet,32) as i32;
    assert(length >= 0 && length <= 512 && layout >= 0 && layout <= 1 && malformed >= 0 && malformed <= 3);
    let limits: ext::http_url::Limits = ext::http_url::Limits { url_bytes: decode(packet,8) as i32, target_bytes: decode(packet,16) as i32 };
    let native: [u8;520] = [90;520]; let packed_words: [i32;130] = [0;130];
    let packed: [u8] = core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(packed_words),520);
    assert(core::mem::slice_stride(native) < 0 && core::mem::slice_stride(packed) == 1);
    let backing: [u8] = native; if (layout == 1) { backing = packed; }
    let i: i32 = 0; while (i < 520) { backing[i] = 90; i += 1; }
    i = 0; while (i < length) { backing[3+i] = packet[40+i]; i += 1; }
    let input: View<u8> = View<u8> { values: backing, start: 3, length: length };
    if (malformed == 1) { input.start = -1; }
    if (malformed == 2) { input.length = -1; }
    if (malformed == 3) { input.start = 2147483647; input.length = 1; }
    let args: [std::linux::Argument;1] = [std::linux::Argument::Word(0)];
    let pid: u64 = std::linux::call(39,core::slice::view(args,0).unwrap()).unwrap() as u64;
    let result: Result<ext::http_url::Url,ext::http_url::Error> = ext::http_url::parse(input,limits);
    i = 3; while (i < 3+length) { backing[i] = 88; i += 1; }
    assert(backing[0] == 90 && backing[2] == 90 && backing[3+length] == 90 && backing[519] == 90);
    if (result.is_err()) {
        let error: ext::http_url::Error = result.unwrap_err();
        assert(header(pid,kind(error.kind),error.offset,layout,core::mem::slice_stride(backing),length,0,0,0) && ack() && released(pid)); return 0;
    }
    let url: ext::http_url::Url = result.unwrap();
    let host: View<u8> = url.host().unwrap(); let authority: View<u8> = url.authority().unwrap(); let target: View<u8> = url.target().unwrap();
    assert(header(pid,0,0,layout,core::mem::slice_stride(backing),length,host.length,authority.length,target.length));
    assert(payload(host) && payload(authority) && payload(target) && ack());
    assert(url.is_open() && url.destroy() && inactive(url.borrow()) && !url.destroy() && inactive(url.borrow()));
    assert(released(pid)); return 0;
}
