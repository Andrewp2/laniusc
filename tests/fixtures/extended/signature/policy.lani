// Public policy contracts: complete TLS ID domain, ordered subsets, invalid
// metadata/duplicates, copied values and separate certificate/proof permission.
module app::main;
import core::result;
import ext::signature;
fn id(index:i32)->u16 {
    if(index==0){return 2055;}if(index==1){return 1027;}
    if(index==2){return 2052;}if(index==3){return 1025;}
    if(index==4){return 0;}return 65535;
}
fn permitted(value:u16,proof:bool)->bool {
    return value==2055||value==1027||value==2052||(!proof&&value==1025);
}
fn purpose(proof:bool)->ext::signature::Use {
    if(proof){return ext::signature::Use::CertificateVerify;}
    return ext::signature::Use::Certificate;
}
fn main()->i32 {
    let proof_index:i32=0;
    while(proof_index<2){
        let proof:bool=proof_index==1;let use:ext::signature::Use=purpose(proof);
        let value:i32=0;
        while(value<65536){
            let selected:core::result::Result<ext::signature::Scheme,ext::signature::Error> =ext::signature::tls_scheme(value as u16,use);
            assert(selected.is_ok()==permitted(value as u16,proof));
            if(selected.is_ok()){assert(ext::signature::tls_id(selected.unwrap())==value as u16);}
            value+=1;
        }
        let encoded:i32=0;
        while(encoded<1296){
            let digits:i32=encoded;let entries:[u16;4]=[0;4];let i:i32=0;
            while(i<4){entries[i]=id(digits%6);digits/=6;i+=1;}
            let length:i32=1;
            while(length<=4){
                let expected:bool=true;i=0;
                while(i<length){
                    if(!permitted(entries[i],proof)){expected=false;}
                    let j:i32=0;while(j<i){if(entries[j]==entries[i]){expected=false;}j+=1;}i+=1;
                }
                let policy:ext::signature::Policy=ext::signature::Policy{order:entries,length:length};
                let saved:ext::signature::Policy=policy;
                let checked:core::result::Result<i32,ext::signature::Error> =ext::signature::validate_policy(policy,use);
                assert(checked.is_ok()==expected);
                let member:i32=0;
                while(member<4){
                    let scheme:ext::signature::Scheme=ext::signature::tls_scheme(id(member),ext::signature::Use::Certificate).unwrap();
                    let allowed:core::result::Result<bool,ext::signature::Error> =ext::signature::allows(policy,scheme,use);
                    assert(allowed.is_ok()==expected);
                    if(expected){
                        let present:bool=false;i=0;while(i<length){if(entries[i]==id(member)){present=true;}i+=1;}
                        assert(allowed.unwrap()==(present&&permitted(id(member),proof)));
                    }
                    member+=1;
                }
                policy.order[0]=65535;policy.length=0;
                assert(saved.length==length);i=0;while(i<4){assert(saved.order[i]==entries[i]);i+=1;}
                length+=1;
            }
            encoded+=1;
        }
        let lengths:[i32;5]=[-2147483647,-1,0,5,2147483647];let i:i32=0;
        while(i<5){
            let broken:ext::signature::Policy=ext::signature::Policy{order:[2055,1027,2052,1025],length:lengths[i]};
            let checked:core::result::Result<i32,ext::signature::Error> =ext::signature::validate_policy(broken,use);
            assert(checked.is_err());assert(match(checked.unwrap_err()){ext::signature::Error::InvalidParameters->true,_->false});
            assert(ext::signature::allows(broken,ext::signature::Scheme::Ed25519,use).is_err());i+=1;
        }
        proof_index+=1;
    }
    let proofs:ext::signature::Policy=ext::signature::default_proofs();
    let certificates:ext::signature::Policy=ext::signature::default_certificates();
    assert(proofs.length==3&&certificates.length==4);
    let i:i32=0;while(i<3){assert(proofs.order[i]==id(i));assert(certificates.order[i]==id(i));i+=1;}
    assert(certificates.order[3]==1025);
    assert(!ext::signature::allows(proofs,ext::signature::Scheme::RsaPkcs1Sha256,ext::signature::Use::CertificateVerify).unwrap());
    assert(ext::signature::allows(certificates,ext::signature::Scheme::RsaPkcs1Sha256,ext::signature::Use::Certificate).unwrap());
    assert(ext::signature::validate_policy(certificates,ext::signature::Use::CertificateVerify).is_err());
    // An invalid unused tail does not change a valid one-entry active policy.
    let short:ext::signature::Policy=ext::signature::Policy{order:[2055,65535,2055,0],length:1};
    assert(ext::signature::validate_policy(short,ext::signature::Use::CertificateVerify).is_ok());
    return 0;
}
