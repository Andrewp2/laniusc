// Closer positive control: actual mixed key records, exhaustive arms and nested branches.
// The odd modulus is a constructor-admitted arithmetic value, not a trust key.
module app::main;
import core::option;
import core::slice;
import ext::ed25519;
import ext::p256;
import ext::rsa;
enum Material { Rsae(ext::rsa::PublicKey), Ed25519(ext::ed25519::Key32), P256(ext::p256::PublicKey) }
struct Holder { material:Material }
impl Holder { fn borrow(&self)->&Holder{return self;} }
fn view(v:[u8],n:i32)->core::slice::View<u8>{return core::slice::View{values:v,start:0,length:n};}
fn pick(key:&Holder)->i32{
 let family:i32=match(key.material){Material::Ed25519(_)->0,Material::P256(_)->1,Material::Rsae(_)->2};
 if(family==2){let selected:core::option::Option<ext::rsa::PublicKey> = match (key.material) { Material::Rsae(v) -> core::option::Some(v), Material::Ed25519(_) -> core::option::None(), Material::P256(_) -> core::option::None() };let owned:ext::rsa::PublicKey=selected.unwrap();return owned.signature_length();}
 if(family==0){let selected:core::option::Option<ext::ed25519::Key32> = match (key.material) { Material::Ed25519(v) -> core::option::Some(v), Material::Rsae(_) -> core::option::None(), Material::P256(_) -> core::option::None() };let owned:ext::ed25519::Key32=selected.unwrap();return owned.bytes[0] as i32;}
 let selected:core::option::Option<ext::p256::PublicKey> = match (key.material) { Material::P256(v) -> core::option::Some(v), Material::Ed25519(_) -> core::option::None(), Material::Rsae(_) -> core::option::None() };let owned:ext::p256::PublicKey=selected.unwrap();return owned.bytes[0] as i32;
}
fn main()->i32{
 let modulus:[u8;256]=[0;256];modulus[0]=128;modulus[255]=1;let budget:ext::rsa::Budget=ext::rsa::budget(ext::rsa::default_limits()).unwrap();
 let rsa:ext::rsa::PublicKey=ext::rsa::from_components(view(modulus,256),3,budget.borrow()).unwrap();
 let ed:[u8;32]=[215,90,152,1,130,177,10,183,213,75,254,211,201,100,7,58,14,225,114,243,218,166,35,37,175,2,26,104,247,7,81,26];
 let point:[u8;65]=[4,96,254,212,186,37,90,157,49,201,97,235,116,198,53,109,104,192,73,184,146,59,97,250,108,230,105,98,46,96,242,159,182,121,3,254,16,8,184,188,153,164,26,233,233,86,40,188,100,242,241,178,12,45,126,159,81,119,163,194,148,212,70,34,153];
 let first:Holder=Holder{material:Material::Rsae(rsa)};let second:Holder=Holder{material:Material::Ed25519(ext::ed25519::Key32{bytes:ed})};let third:Holder=Holder{material:Material::P256(ext::p256::validate_public_key(view(point,65)).unwrap())};
 assert(pick(first.borrow())==256);assert(pick(second.borrow())==215);assert(pick(third.borrow())==4);return 0;
}
