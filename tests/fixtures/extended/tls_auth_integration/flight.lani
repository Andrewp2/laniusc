fn v(bytes: [u8], at: i32, length: i32) -> core::slice::View<u8> { return core::slice::View { values: bytes, start: 3+at, length: length }; }
fn part(value: core::slice::View<u8>, at: i32, length: i32) -> core::slice::View<u8> { assert(at>=0 && length>=0 && at+length<=value.length); return core::slice::View { values: value.values, start: value.start+at, length: length }; }
fn copy(source: core::slice::View<u8>, target: core::slice::View<u8>) { assert(target.length>=source.length); let i:i32=0; while(i<source.length){target.values[target.start+i]=source.values[source.start+i];i+=1;} }
fn same(a: core::slice::View<u8>, b: core::slice::View<u8>) { assert(a.length==b.length);let i:i32=0;while(i<a.length){assert(a.values[a.start+i]==b.values[b.start+i]);i+=1;} }
