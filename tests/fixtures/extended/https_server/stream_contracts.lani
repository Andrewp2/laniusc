module app::main;
import core::io;
import core::net;
import core::result;
import core::slice;
import core::time;
import ext::openssl_tls;
import ext::tls_stream;
import std::args;
import std::clock;
import std::signal;
import std::socket;
import std::stream;
fn main() -> i32 {
    assert(std::signal::set_disposition(std::signal::Signal::BrokenPipe,std::signal::Disposition::Ignore).is_ok());
    let args = std::args::snapshot(1,3,8192).unwrap(); assert(args.len() == 3); let mode: u8 = args.get(2).unwrap().get(0).unwrap();
    let empty: [u8;1] = [0;1];
    let server = ext::openssl_tls::new_server(args.get(0).unwrap(),args.get(1).unwrap(),core::slice::view(empty,0).unwrap(),ext::openssl_tls::ClientAuthentication::Unauthenticated,ext::openssl_tls::default_limits()).unwrap();
    let limits = ext::tls_stream::default_limits(); limits.written_bytes = 7;
    let now = std::clock::monotonic_now().unwrap(); let deadline = core::time::deadline_after(now,core::time::from_millis(3000)).unwrap();
    if (mode >= 52 && mode <= 55) {
        let kind = std::socket::Kind::Tcp; if (mode == 52) { kind = std::socket::Kind::Udp; }
        let socket = std::socket::create(std::socket::Family::Ipv4,kind,true).unwrap();
        if (mode == 54) { deadline = core::time::deadline_after(now,core::time::zero()).unwrap(); }
        if (mode == 55) { assert(socket.close().is_ok()); }
        // This alias remains inactive: only a borrowed fcntl query observes
        // EBADF after the consuming constructor, without closing it again.
        let result = ext::tls_stream::accept_connected_until(socket,server.borrow(),limits,deadline);
        assert(result.is_err() && socket.is_nonblocking().is_err()); server.destroy(); args.destroy(); return 0;
    }
    let endpoint_bytes: [u8;11] = [49,50,55,46,48,46,48,46,49,58,48];
    let endpoint = core::net::parse_socket(core::slice::view(endpoint_bytes,11).unwrap()).unwrap();
    let listener = std::socket::create(std::socket::Family::Ipv4,std::socket::Kind::Tcp,true).unwrap();
    assert(listener.bind(endpoint).is_ok() && listener.listen(1).is_ok());
    let address: [u8;96] = [0;96]; let n = listener.local_addr().unwrap().format_into(core::slice::view(address,95).unwrap()).unwrap(); address[n] = 10;
    let output = std::stream::from_handle(1); assert(core::io::write_all(output.borrow(),address,0,n+1).is_ok());
    assert(listener.wait_ms(true,false,3000).is_ok()); let nonblocking: bool = mode != 51; let accepted = listener.accept(nonblocking).unwrap().socket; assert(listener.close().is_ok());
    if (mode == 49) { limits.io_calls = 0; } if (mode == 50) { server.destroy(); }
    if (mode == 56) { deadline = core::time::deadline_after(std::clock::monotonic_now().unwrap(),core::time::from_millis(300)).unwrap(); limits.written_bytes = 16777216; }
    let made = ext::tls_stream::accept_connected_until(accepted,server.borrow(),limits,deadline);
    if (mode >= 49 && mode <= 51) { assert(made.is_err() && accepted.is_nonblocking().is_err()); server.destroy(); args.destroy(); return 0; }
    assert(made.is_ok()); let stream = made.unwrap(); server.destroy(); assert(!server.is_open());
    if (mode == 56) {
        let data: [u8;16384] = [99;16384]; let index: i32 = 0; let failed: bool = false;
        while (index < 1024) { if (stream.write(data,0,16384).is_err() || stream.flush().is_err()) { failed = true; break; } index += 1; }
        assert(failed && !stream.is_open() && stream.last_failure().is_some());
        let timeout: bool = match (stream.last_failure().unwrap().cause) { ext::tls_stream::Cause::Timeout -> true, _ -> false };
        assert(timeout && stream.stats().accepted_bytes >= stream.stats().written_bytes && stream.stats().written_bytes < 16777216);
        assert(stream.close().is_ok()); args.destroy(); return 0;
    }
    let data: [u8;7] = [97,98,0,255,10,0,120]; let before = stream.stats();
    assert(stream.write(data,0,7).unwrap() == 7); assert(stream.stats().accepted_bytes == 7 && stream.stats().written_bytes == 0 && stream.stats().tls_calls == before.tls_calls);
    let index: i32 = 0; while (index < 7) { data[index] = 0; index += 1; }
    let answer: [u8;3] = [199;3]; assert(core::io::read_exact(stream.borrow(),answer,0,3).is_ok()); assert(answer[0] == 65 && answer[1] == 67 && answer[2] == 75);
    assert(stream.stats().accepted_bytes == 7 && stream.stats().written_bytes == 7 && stream.check().is_ok());
    assert(stream.flush().is_ok() && stream.shutdown().is_ok() && !stream.is_open()); assert(stream.write(data,0,1).is_err() && stream.stats().accepted_bytes == 7); assert(stream.read(answer,0,1).is_err());
    assert(stream.close().is_ok() && stream.close().is_ok()); args.destroy(); return 0;
}
