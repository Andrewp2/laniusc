    if(source.is_some()) { let owner=source.unwrap(); owner.destroy(); owner.destroy(); source=Some(owner); }
    mark(80); root.close().unwrap(); mark(112);
    assert(!run.resources_remaining()); emit(3,pid,source,source_error,root.borrow(),run.borrow(),input,layout,result,action,taken,cached);
    return 0;
}
