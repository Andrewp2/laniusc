// stdin -> hex SHA-1 (ext::sha1), or with "accept" the RFC 6455 Accept
// value (ext::websocket::accept_into) of the 24-byte key on stdin.
module app::main;
import alloc::vec;
import core::io;
import core::mem;
import core::result;
import core::slice;
import ext::sha1;
import ext::websocket;
import std::args;
import std::stream;

fn write_out(v: core::slice::View<u8>) -> bool {
    let out: std::stream::Descriptor = std::stream::stdout(); let done: i32 = 0;
    while (done < v.len()) { let n = out.write(v.values, v.start + done, v.len() - done); if (n.is_err() || n.unwrap() <= 0) { return false; } done += n.unwrap(); }
    return true;
}
fn main() -> i32 {
    let captured = std::args::snapshot(1, 2, 64); let accept: bool = false;
    if (captured.is_ok()) { let a = captured.unwrap(); accept = a.len() > 0; a.destroy(); }
    let input: alloc::vec::Vec<u8> = alloc::vec::new<u8>(); let chunk: [u8;4096] = [0;4096]; let src: std::stream::Descriptor = std::stream::stdin();
    while (true) {
        let got = src.read(chunk, 0, 4096); if (got.is_err()) { return 2; } let n: i32 = got.unwrap(); if (n == 0) { break; }
        if (input.try_extend(core::slice::View { values: chunk, start: 0, length: n }).is_err()) { return 2; }
    }
    let out: [u8;41] = [0;41];
    if (accept) {
        let r = ext::websocket::accept_into(input.as_view(), core::slice::View { values: out, start: 0, length: 41 });
        if (r.is_err()) { write_out(core::slice::View { values: out, start: 0, length: 0 }); input.destroy(); return 1; }
        out[28] = 10; write_out(core::slice::View { values: out, start: 0, length: 29 }); input.destroy(); return 0;
    }
    let digest: [u8;20] = [0;20];
    let d = ext::sha1::digest_into(input.as_view(), core::slice::View { values: digest, start: 0, length: 20 });
    if (d.is_err()) { return 2; }
    let i: i32 = 0;
    while (i < 20) { let b: u8 = digest[i]; let hi: u8 = b >> 4; let lo: u8 = b & 15; let ch: u8 = 48 + hi; if (hi >= 10) { ch = 87 + hi; } out[2*i] = ch; let cl: u8 = 48 + lo; if (lo >= 10) { cl = 87 + lo; } out[2*i+1] = cl; i += 1; }
    out[40] = 10; write_out(core::slice::View { values: out, start: 0, length: 41 }); input.destroy();
    return 0;
}
