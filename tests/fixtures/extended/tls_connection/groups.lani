fn view(b:[u8],at:i32,n:i32)->core::slice::View<u8>{return core::slice::View { values:b,start:at,length:n };}
fn word(fd:&std::stream::Descriptor,n:u64){let b:[u8;8]=[0;8];let i:i32=0;while(i<8){b[i]=(n>>(8*i)) as u8;i+=1;}core::io::write_all<std::stream::Descriptor>(fd,b,0,8).unwrap();}
fn load(b:[u8],at:i32)->u64{let n:u64=0;let i:i32=0;while(i<8){n|=(b[at+i] as u64)<<(8*i);i+=1;}return n;}
fn block(fd:&std::stream::Descriptor,v:core::slice::View<u8>){word(fd,v.length as u64);core::io::write_all<std::stream::Descriptor>(fd,v.values,v.start,v.length).unwrap();}
fn fill(v:core::slice::View<u8>,value:u8){let i:i32=0;while(i<v.length){v.values[v.start+i]=value;i+=1;}}
fn same(a:[u8],b:[u8],n:i32)->bool{let i:i32=0;while(i<n){if(a[i]!=b[i]){return false;}i+=1;}return true;}
fn neg_code(e:ext::tls_negotiation::Error)->u64{return match(e){ext::tls_negotiation::Error::Unoffered->112,ext::tls_negotiation::Error::Retry->113,_ -> 190};}
fn code(e:ext::tls_connection::Error)->u64{return match(e){ext::tls_connection::Error::Bounds->1,ext::tls_connection::Error::EntropyLength->2,ext::tls_connection::Error::InvalidEphemeralScalar->3,ext::tls_connection::Error::InvalidConfig->4,ext::tls_connection::Error::Limit->5,ext::tls_connection::Error::Crypto->6,ext::tls_connection::Error::Negotiation(detail)->neg_code(detail),_ ->99};}
fn flag(value:bool)->u64{if(value){return 1;}return 0;}
fn offset(value:core::option::Option<i32>)->u64{if(value.is_none()){return 0;}return value.unwrap() as u64;}
fn main()->i32{
 let input:std::stream::Descriptor=std::stream::stdin();let out:std::stream::Descriptor=std::stream::stdout();let h:[u8;72]=[0;72];let payload:[u8;256]=[0;256];
 core::io::read_exact<std::stream::Descriptor>(input.borrow(),h,0,8).unwrap();let count:u64=load(h,0);assert(count<=96);let turn:u64=0;
 while(turn<count){
  core::io::read_exact<std::stream::Descriptor>(input.borrow(),h,0,72).unwrap();let layout:i32=load(h,0) as i32;let policy_id:i32=load(h,8) as i32;let initial_id:u16=load(h,16) as u16;let entropy_length:i32=load(h,24) as i32;let scalar_kind:i32=load(h,32) as i32;let metadata:u64=load(h,40);let max_work:u64=load(h,48);let n:i32=load(h,56) as i32;let suite_policy:i32=load(h,64) as i32;
  assert(layout<=1&&policy_id<=4&&entropy_length<=96&&n<=256);core::io::read_exact<std::stream::Descriptor>(input.borrow(),payload,0,n).unwrap();
  let native:[u8;60000]=[0;60000];let packed:[i32;15000]=[0;15000];let bytes:[u8]=native;if(layout==1){bytes=core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(packed),60000);}fill(view(bytes,0,60000),165);
  let slots:[ext::x509_path::Slot;18]=[ext::x509_path::empty_slot();18];let buffers:ext::tls_connection::Buffers=ext::tls_connection::Buffers { record:view(bytes,3,16645),decrypt:view(bytes,16654,16624),handshake:view(bytes,33284,516),hello:view(bytes,33806,1536),pending_wire:view(bytes,35348,16645),application:view(bytes,52000,32),path:core::slice::View { values:slots,start:1,length:16 } };
  let groups:ext::tls_negotiation::GroupPolicy=ext::tls_negotiation::GroupPolicy { preferred:ext::tls_negotiation::Group::X25519,fallback:core::option::None() };
  if(policy_id==1){groups.preferred=ext::tls_negotiation::Group::Secp256r1;}if(policy_id==2){groups=ext::tls_negotiation::default_groups();}if(policy_id==3){groups.preferred=ext::tls_negotiation::Group::Secp256r1;groups.fallback=core::option::Some(ext::tls_negotiation::Group::X25519);}if(policy_id==4){groups.fallback=core::option::Some(ext::tls_negotiation::Group::X25519);}
  let shape:core::result::Result<ext::tls_connection::EntropyLayout,ext::tls_connection::Error> = ext::tls_connection::entropy_layout(groups);
  let entropy:[u8;96]=[0;96];let i:i32=0;while(i<96){entropy[i]=(i+1) as u8;i+=1;}
  if(shape.is_ok()&&shape.unwrap().p256_offset.is_some()){
   let at:i32=shape.unwrap().p256_offset.unwrap();fill(view(entropy,at,32),0);entropy[at+31]=1;
   if(scalar_kind==1){entropy[at+31]=0;}if(scalar_kind==2){let order:[u8;32]=[255,255,255,255,0,0,0,0,255,255,255,255,255,255,255,255,188,230,250,173,167,23,158,132,243,185,202,194,252,99,37,81];i=0;while(i<32){entropy[at+i]=order[i];i+=1;}}if(scalar_kind==3){fill(view(entropy,at,32),255);}
  }
  let source:core::sha256::Digest=core::sha256::digest(view(entropy,0,96)).unwrap();let before:core::sha256::Digest=core::sha256::digest(view(bytes,0,60000)).unwrap();
  let anchor:[u8;1]=[0];let anchors:[core::slice::View<u8>;1]=[view(anchor,0,1)];let name:[u8;14]=[115,101,114,118,101,114,46,101,120,97,109,112,108,101];let initial:core::option::Option<ext::tls_negotiation::Group> = core::option::None();if(initial_id!=0){initial=core::option::Some(ext::tls_negotiation::group_from_id(initial_id).unwrap());}
  let limits:ext::tls_connection::Limits=ext::tls_connection::default_limits();limits.max_handshake_body=512;limits.max_hello_frame=512;limits.max_application_hold=32;limits.max_work=max_work;
  let suites:ext::tls_suite::Policy=ext::tls_suite::Policy { order:[ext::tls_suite::Suite::ChaCha20Poly1305Sha256,ext::tls_suite::Suite::Aes128GcmSha256,ext::tls_suite::Suite::ChaCha20Poly1305Sha256],length:2 };
  if(suite_policy==1){suites.order[0]=ext::tls_suite::Suite::Aes256GcmSha384;suites.length=1;}if(suite_policy==2){suites=ext::tls_suite::default_policy();}if(suite_policy==3){suites.length=0;}if(suite_policy==4){suites.order[1]=suites.order[0];}if(suite_policy==5){suites.length=4;}
  let config:ext::tls_connection::ClientConfig=ext::tls_connection::ClientConfig { anchors:core::slice::View { values:anchors,start:0,length:1 },reference:ext::service_identity::dns_reference(view(name,0,14)).unwrap(),unix_time:1792800000,server_name:view(name,0,0),alpn:view(name,0,0),require_alpn:false,suites:suites,groups:groups,initial_share:initial,limits:limits };
  let supplied:core::slice::View<u8> = view(entropy,0,entropy_length);if(metadata!=0){supplied.start=-1;}
  let made:core::result::Result<ext::tls_connection::Engine,ext::tls_connection::Error> = ext::tls_connection::client(config,buffers,supplied);
  let status:u64=0;let feed_status:u64=0;let consumed:u64=0;let work_left:u64=0;let failed:bool=false;let observed:[u8;48]=[0;48];let observed_length:i32=0;
  if(made.is_err()){
   status=code(made.unwrap_err());let after:core::sha256::Digest=core::sha256::digest(view(bytes,0,60000)).unwrap();assert(same(before.bytes,after.bytes,32));block(out.borrow(),view(payload,0,0));
  }else{
   let engine:ext::tls_connection::Engine=made.unwrap();assert(engine.selected.is_none()&&engine.transcript.is_none()&&engine.handshake_client.is_none());engine.pump().unwrap();block(out.borrow(),engine.outgoing());engine.acknowledge_written(engine.outgoing().length).unwrap();
   let at:i32=0;let stopped:bool=false;
   while(at<n&&!stopped){let accepted:core::result::Result<i32,ext::tls_connection::FeedFailure> = engine.feed_wire(view(payload,at,n-at));if(accepted.is_err()){feed_status=code(accepted.unwrap_err().cause);consumed=(at+accepted.unwrap_err().consumed) as u64;stopped=true;let repeated:core::result::Result<i32,ext::tls_connection::FeedFailure> = engine.feed_wire(view(payload,0,n));assert(repeated.is_err()&&code(repeated.unwrap_err().cause)==feed_status&&repeated.unwrap_err().consumed==0);}else{assert(accepted.unwrap()>0);at+=accepted.unwrap();consumed=at as u64;if(at<n){engine.pump().unwrap();let pending:i32=engine.outgoing().length;if(pending>0){engine.acknowledge_written(pending).unwrap();}}}}
   assert(!engine.established()&&engine.peer_key().is_none()&&engine.negotiated().is_none()&&engine.pending_plaintext()==0);work_left=engine.stats().work_left;failed=engine.failure().is_some();if(engine.transcript.is_some()){let transcript:ext::tls_transcript::State=engine.transcript.unwrap();let hash:ext::tls_hash::Digest=transcript.snapshot();observed=hash.bytes;observed_length=ext::tls_hash::hash_length(hash.algorithm);}engine.abort();
  }
  let final_source:core::sha256::Digest=core::sha256::digest(view(entropy,0,96)).unwrap();assert(same(source.bytes,final_source.bytes,32));assert(slots[0].certificate.is_none()&&slots[17].certificate.is_none());
  word(out.borrow(),status);word(out.borrow(),feed_status);word(out.borrow(),consumed);word(out.borrow(),work_left);word(out.borrow(),flag(failed));
  if(shape.is_ok()){word(out.borrow(),shape.unwrap().length as u64);word(out.borrow(),offset(shape.unwrap().x25519_offset));word(out.borrow(),offset(shape.unwrap().p256_offset));}else{word(out.borrow(),0);word(out.borrow(),0);word(out.borrow(),0);}
  block(out.borrow(),view(observed,0,observed_length));turn+=1;
 }
 return 0;
}
