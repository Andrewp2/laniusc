   let wire:core::slice::View<u8> = source.outgoing(); let before:core::sha256::Digest=core::sha256::digest(wire).unwrap(); source.pump().unwrap(); let after:core::sha256::Digest=core::sha256::digest(source.outgoing()).unwrap();
   assert(equal(view(before.bytes,0,32),view(after.bytes,0,32)) && source.outgoing().length==wire.length);
   let count:i32=wire.length; if(self.split!=0) { count=1+((self.turn*37+11)%257) as i32; if(self.turn%7==0) { count=1; } if(count>wire.length) { count=wire.length; } }
   let consumed:i32=peer.feed_wire(part(wire,0,count)).unwrap(); assert(consumed>=0 && consumed<=count); if(consumed==0) { break; }
   if(side==0 && peer.established() && !source.established()) { assert(consumed==wire.length); self.finish_witness+=1; word(self.out.borrow(),3); word(self.out.borrow(),consumed as u64); assert(source.peer_key().is_none()); }
   source.acknowledge_written(consumed).unwrap(); if(initial_hello) { assert(source.selected.is_none() && source.transcript.is_none()); } self.turn+=1; progress=true;
  }
  return progress;
 }
}
fn drain(engine:&ext::tls_connection::Engine,out:[u8],at:i32,expected:core::slice::View<u8>)->i32 {
 let used:i32=0; let turns:i32=0;
 while(used<expected.length) { engine.pump().unwrap(); let n:i32=expected.length-used; if(n>7) { n=7; } let got:ext::tls_connection::Read=engine.read_plaintext(view(out,at+used,n)).unwrap(); assert(got.written>0 && got.written<=n && !got.eof); used+=got.written; turns+=1; assert(turns<10000); }
 assert(equal(view(out,at,used),expected)); return used;
}
fn connected(client:&ext::tls_connection::Engine,server:&ext::tls_connection::Engine,trace:&Trace)->bool {
 let turns:i32=0;
 while(!client.established() || !server.established()) {
  trace.transfer(client,server,0); trace.transfer(server,client,1);
  if(trace.sign_denied) { return false; }
  assert(client.failure().is_none() && server.failure().is_none()); turns+=1; assert(turns<1000);
 }
 assert(trace.finish_witness==1 && client.peer_key().is_some() && server.peer_key().is_none());
 if(trace.signing>=11) { assert(trace.sign_checked && server.path_budget.verification.work_left==0); }
 return true;
}
fn suite_policy(h:[u8],at:i32)->ext::tls_suite::Policy { return ext::tls_suite::Policy { order:[ext::tls_suite::from_id(load(h,at) as u16).unwrap(),ext::tls_suite::from_id(load(h,at+8) as u16).unwrap(),ext::tls_suite::from_id(load(h,at+16) as u16).unwrap()],length:load(h,at+24) as i32 }; }
fn group_option(id:u16)->core::option::Option<ext::tls_negotiation::Group> { if(id==0) { return core::option::None(); } return core::option::Some(ext::tls_negotiation::group_from_id(id).unwrap()); }
fn proofs(profile:u64)->ext::signature::Policy { if(profile==1 || profile==3 || profile==8) { return ext::signature::default_proofs(); } if(profile==4) { return ext::signature::Policy { order:[1027;4],length:1 }; } return ext::signature::Policy { order:[2055;4],length:1 }; }
fn certificates(profile:u64)->core::option::Option<ext::signature::Policy> { if(profile==2 || profile==3 || profile==10) { return core::option::None(); } if(profile==1 || profile==4 || profile==8) { return core::option::Some(ext::signature::default_certificates()); } if(profile==6) { return core::option::Some(ext::signature::Policy { order:[1025;4],length:1 }); } if(profile==7) { return core::option::Some(ext::signature::Policy { order:[1027;4],length:1 }); } return core::option::Some(ext::signature::Policy { order:[2055;4],length:1 }); }
fn rejected_offer(client:&ext::tls_connection::Engine,server:&ext::tls_connection::Engine,out:&std::stream::Descriptor) {
 client.pump().unwrap(); let wire:core::slice::View<u8> =client.outgoing(); assert(wire.length>5); block(out,wire); let failed:ext::tls_connection::FeedFailure=server.feed_wire(wire).unwrap_err(); assert(failed.consumed==wire.length);
 let error:core::option::Option<ext::tls_negotiation::Error> =match(failed.cause) { ext::tls_connection::Error::Negotiation(e)->core::option::Some(e),_ ->core::option::None() }; assert(error.is_some()); let denied:bool=match(error.unwrap()) { ext::tls_negotiation::Error::NoSignature->true,_ ->false }; assert(denied);
 assert(!client.established() && !server.established() && server.failure().is_some() && client.peer_key().is_none() && server.peer_key().is_none() && server.negotiated().is_none() && server.pending_plaintext()==0); block(out,server.outgoing()); let repeated:ext::tls_connection::FeedFailure=server.feed_wire(wire).unwrap_err(); assert(repeated.consumed==0); word(out,10);
}
fn exercise(backing:ptr)->i32 {
 let input:std::stream::Descriptor=std::stream::stdin(); let output:std::stream::Descriptor=std::stream::stdout(); let raw:[u8;8]=[0;8]; read(input.borrow(),raw,0,8); let cases:u64=load(raw,0); assert(cases>0 && cases<=32); let turn:u64=0;
 while(turn<cases) {
  let header:[u8;176]=[0;176]; read(input.borrow(),header,0,176); let profile:u64=load(header,168); assert(profile<=15);
  let layout:i32=load(header,0) as i32; let suite:u64=load(header,8); let retry:u64=load(header,16); let split:i32=load(header,24) as i32;
  let now:i64=load(header,32) as i64; let root_length:i32=load(header,40) as i32; let count:i32=load(header,48) as i32; let large:u64=load(header,56);
  let client_groups:ext::tls_negotiation::GroupPolicy=ext::tls_negotiation::GroupPolicy { preferred:ext::tls_negotiation::group_from_id(load(header,64) as u16).unwrap(),fallback:group_option(load(header,72) as u16) };
  let server_groups:ext::tls_negotiation::GroupPolicy=ext::tls_negotiation::GroupPolicy { preferred:ext::tls_negotiation::group_from_id(load(header,80) as u16).unwrap(),fallback:group_option(load(header,88) as u16) };
  let initial:core::option::Option<ext::tls_negotiation::Group> = group_option(load(header,96) as u16);
  let client_suites:ext::tls_suite::Policy=suite_policy(header,104); let server_suites:ext::tls_suite::Policy=suite_policy(header,136);
  let client_layout:ext::tls_connection::EntropyLayout=ext::tls_connection::entropy_layout(client_groups).unwrap(); let server_layout:ext::tls_connection::EntropyLayout=ext::tls_connection::entropy_layout(server_groups).unwrap();
  assert(layout>=0 && layout<=1 && suite<=2 && retry<=2 && root_length>0 && root_length<=16384 && count>0 && count<=8);
  // The two layouts reuse the sole caller allocation only after both previous
  // engines have been disarmed. No huge fixed-array type/aggregate is needed.
  let bytes:[u8]=arena_bytes(backing,layout);
  fill(view(bytes,0,440000),165);
  let at:i32=3; read(input.borrow(),bytes,at,root_length); let root:core::slice::View<u8> = view(bytes,at,root_length); at+=root_length+6;
  let empty:core::slice::View<u8> = view(bytes,0,0); let chain:[core::slice::View<u8>;8]=[empty;8]; let i:i32=0;
  while(i<count) { read(input.borrow(),raw,0,8); let n:i32=load(raw,0) as i32; assert(n>0 && n<=16384 && at+n+6<110000); read(input.borrow(),bytes,at,n); chain[i]=view(bytes,at,n); at+=n+6; i+=1; }
  let source_hash:core::sha256::Digest=core::sha256::digest(view(bytes,0,110000)).unwrap();
  let anchors:[core::slice::View<u8>;1]=[root]; let name:[u8;14]=[115,101,114,118,101,114,46,101,120,97,109,112,108,101]; let reference:ext::service_identity::Reference=ext::service_identity::dns_reference(view(name,0,14)).unwrap();
  let alpn:[u8;3]=[2,104,50]; let seed:[u8;32]=[157,97,177,157,239,253,90,96,186,132,74,244,146,236,44,196,68,73,197,105,123,50,105,25,112,59,172,3,28,174,127,96];
  let client_entropy:[u8;96]=[0;96]; let server_entropy:[u8;96]=[0;96]; i=0; while(i<96) { client_entropy[i]=(i+1) as u8; server_entropy[i]=(i+101) as u8; i+=1; }
  let limits:ext::tls_connection::Limits=ext::tls_connection::default_limits(); limits.max_handshake_body=8192; limits.max_hello_frame=1024; limits.max_application_hold=23; limits.path.max_work=1073741824;
  if(large!=0) { limits.max_handshake_body=98304; }
  let sizes:ext::tls_connection::BufferSizes=ext::tls_connection::required_buffers(limits).unwrap(); let pool:Pool=Pool { bytes:view(bytes,110000,330000),at:0 };
  let slots:[ext::x509_path::Slot;36]=[ext::x509_path::empty_slot();36]; let cb:ext::tls_connection::Buffers=pool.buffers(sizes,core::slice::View { values:slots,start:1,length:16 }); let sb:ext::tls_connection::Buffers=pool.buffers(sizes,core::slice::View { values:slots,start:19,length:16 });
  let first:ext::tls_connection::Engine=ext::tls_connection::client(ext::tls_connection::ClientConfig { anchors:core::slice::View { values:anchors,start:0,length:1 },reference:reference,unix_time:now,server_name:view(name,0,14),alpn:view(alpn,0,3),proofs:proofs(profile),certificates:certificates(profile),require_alpn:true,suites:client_suites,groups:client_groups,initial_share:initial,limits:limits },cb,view(client_entropy,0,client_layout.length)).unwrap();
