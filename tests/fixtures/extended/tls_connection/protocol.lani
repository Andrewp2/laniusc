   block(self.out.borrow(),source.outgoing()); self.sign_checked=true; self.sign_denied=true; return false;
  }
  if(side==1 && self.signing>=11 && self.signing<=12 && !self.sign_checked && source.step==16) {
   // Private downward-only allowance seam after real credential import and
   // full Certificate wire acknowledgement. No fabricated transcript, key,
   // signature attempt, or refill. Both sources remain the sole live owners.
   assert(source.outgoing().length==0 && !source.established() && !peer.established() && source.stats().sent_records==3 && peer.peer_key().is_none());
   let allowance:u64=67108864; if(self.signing==12) { allowance-=1; }
   assert(source.path_budget.verification.work_left>allowance && source.path_budget.verification.work_left<1073741824 && source.path_budget.verification.signatures_left>0);
   source.path_budget.verification.work_left=allowance;
   let attempts:u64=source.path_budget.verification.signatures_left;
   let prepared:core::result::Result<bool,ext::tls_connection::Error> =source.pump();
   self.sign_checked=true;
   word(self.out.borrow(),4); word(self.out.borrow(),allowance); word(self.out.borrow(),source.path_budget.verification.work_left); word(self.out.borrow(),attempts); word(self.out.borrow(),source.path_budget.verification.signatures_left);
   if(self.signing==12) {
    assert(prepared.is_err()); let limit:bool=match(prepared.unwrap_err()) { ext::tls_connection::Error::Limit->true,_ ->false }; assert(limit);
    assert(source.path_budget.verification.work_left==allowance && source.path_budget.verification.signatures_left==attempts && source.failure().is_some() && source.negotiated().is_none() && source.peer_key().is_none() && source.pending_plaintext()==0 && peer.peer_key().is_none());
    assert(source.fatal_alert_pending() && source.outgoing().length>5); block(self.out.borrow(),source.outgoing());
    let stable:core::sha256::Digest=core::sha256::digest(source.outgoing()).unwrap(); assert(source.pump().is_err()); let after:core::sha256::Digest=core::sha256::digest(source.outgoing()).unwrap(); assert(equal(view(stable.bytes,0,32),view(after.bytes,0,32)));
    self.sign_denied=true; return false;
   }
   assert(prepared.is_ok() && source.path_budget.verification.work_left==0 && source.path_budget.verification.signatures_left==attempts-1);
  }
  source.pump().unwrap(); let first:core::slice::View<u8> = source.outgoing(); if(first.length==0) { return false; }
  let initial_hello:bool=side==0 && source.retry.is_none() && first.length>5 && first.values[first.start]==22 && first.values[first.start+5]==1;
  if(initial_hello) { assert(source.selected.is_none() && source.transcript.is_none()); }
  let stats:ext::tls_connection::Stats=source.stats(); let previous:u64=self.client; if(side==1) { previous=self.server; }
  if(stats.sent_records!=previous) { word(self.out.borrow(),1); word(self.out.borrow(),side); block(self.out.borrow(),first); if(side==0) { self.client=stats.sent_records; } else { self.server=stats.sent_records; } }
  let progress:bool=false;
