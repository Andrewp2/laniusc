// Test-only paired engines. Fresh deterministic bytes here are a scripted seam,
// never a production entropy source. Stdout deliberately includes secret-derived
// wire/exporter diagnostics for an independent peer; no host services in Engine.
module app::main;
import ext::signature;
import alloc::allocator;
import core::io; import core::mem; import core::option; import core::result; import core::sha256; import core::slice;
import ext::ed25519; import ext::service_identity; import ext::tls_connection;
import ext::tls_negotiation; import ext::tls_record; import ext::tls_suite; import ext::tls_hash; import ext::x509_path;
import std::stream;
fn view(bytes:[u8],at:i32,n:i32)->core::slice::View<u8> { return core::slice::View { values:bytes,start:at,length:n }; }
fn part(v:core::slice::View<u8>,at:i32,n:i32)->core::slice::View<u8> { return view(v.values,v.start+at,n); }
fn read(input:&std::stream::Descriptor,bytes:[u8],at:i32,n:i32) { core::result::unwrap(core::io::read_exact<std::stream::Descriptor>(input,bytes,at,n)); }
fn load(bytes:[u8],at:i32)->u64 { let n:u64=0; let i:i32=0; while(i<8) { n|=(bytes[at+i] as u64)<<(8*i); i+=1; } return n; }
fn word(out:&std::stream::Descriptor,n:u64) { let b:[u8;8]=[0;8]; let i:i32=0; while(i<8) { b[i]=((n>>(8*i))&255) as u8; i+=1; } core::result::unwrap(core::io::write_all<std::stream::Descriptor>(out,b,0,8)); }
fn block(out:&std::stream::Descriptor,v:core::slice::View<u8>) { word(out,v.length as u64); core::result::unwrap(core::io::write_all<std::stream::Descriptor>(out,v.values,v.start,v.length)); }
fn fill(v:core::slice::View<u8>,n:u8) { let i:i32=0; while(i<v.length) { v.values[v.start+i]=n; i+=1; } }
fn equal(a:core::slice::View<u8>,b:core::slice::View<u8>)->bool { if(a.length!=b.length) { return false; } let i:i32=0; while(i<a.length) { if(a.values[a.start+i]!=b.values[b.start+i]) { return false; } i+=1; } return true; }
fn guards(v:core::slice::View<u8>) { let i:i32=1; while(i<=3) { assert(v.values[v.start-i]==165 && v.values[v.start+v.length+i-1]==165); i+=1; } }
// Test-only unsafe representation seam, tied to the documented native ABI:
// shaders/native_value_layout.slang and docs/stdlib-memory.md. Both records
// occupy three descending native words: data, logical count, signed stride.
// No production API or descriptor layout is changed by this fixture.
struct RawSlice { data:ptr,length:i32,stride:isize }
struct SliceValue { bytes:[u8] }
fn arena_bytes(backing:ptr,layout:i32)->[u8] {
 let physical:[u8]=core::mem::typed_slice_from_raw_parts<u8>(backing,3520000);
 if(layout==1) { let bytes:[u8]=core::mem::typed_slice_from_raw_parts<u8>(backing,440000); assert(core::mem::slice_stride(bytes)==1); bytes[0]=17; bytes[439999]=18; assert(physical[0]==17 && physical[439999]==18); return bytes; }
 let descriptor:[RawSlice]=core::mem::typed_slice_from_storage<RawSlice>(backing,1);
 descriptor[0].data=backing+3519992; descriptor[0].length=440000; descriptor[0].stride=0-8;
 // Copy the descriptor before reusing its temporary first24physicalbytes.
 // Native element0 is the allocation's last word; element439999 is its first.
 let bytes:[u8]=core::mem::typed_slice_from_storage<SliceValue>(backing,1)[0].bytes;
 assert(core::mem::slice_stride(bytes)==-8); bytes[0]=17; bytes[439999]=18;
 assert(physical[3519992]==17 && physical[0]==18); return bytes;
}
struct Pool { bytes:core::slice::View<u8>,at:i32 }
impl Pool {
 fn borrow(&self)->&Pool { return self; }
 fn take(&self,n:i32)->core::slice::View<u8> { assert(n>0 && n<=self.bytes.length-self.at-6); let v:core::slice::View<u8> = part(self.bytes,self.at+3,n); self.at+=n+6; return v; }
 fn buffers(&self,n:ext::tls_connection::BufferSizes,path:core::slice::View<ext::x509_path::Slot>)->ext::tls_connection::Buffers { return ext::tls_connection::Buffers { record:self.take(n.record),decrypt:self.take(n.decrypt),handshake:self.take(n.handshake),hello:self.take(n.hello),pending_wire:self.take(n.pending_wire),application:self.take(n.application),path:path }; }
}
fn buffer_guards(b:ext::tls_connection::Buffers) { guards(b.record); guards(b.decrypt); guards(b.handshake); guards(b.hello); guards(b.pending_wire); guards(b.application); }
struct Trace { out:std::stream::Descriptor,client:u64,server:u64,turn:u64,split:i32,finish_witness:u64,signing:u64,sign_checked:bool,sign_denied:bool }
impl Trace {
 fn borrow(&self)->&Trace { return self; }
 fn transfer(&self,source:&ext::tls_connection::Engine,peer:&ext::tls_connection::Engine,side:u64)->bool {
  if(side==1 && self.signing>=13 && !self.sign_checked && source.step==16) {
   // Downward-only engine-work seam at the same actual Certificate ACK.
   // At exact/+1 presign credit the proof really signs and is staged, then
   // the later frame/record reservation fails. Verify those proof bytes on
   // the host, without pretending a wire record or Finished was emitted.
   assert(source.outgoing().length==0 && !source.established() && !peer.established() && source.stats().sent_records==3 && peer.peer_key().is_none());
   let required:u64=1048576; if(ext::tls_hash::hash_length(ext::tls_suite::hash(source.selected.unwrap()))==48) { required+=50688+8768; }
   let allowance:u64=required; if(self.signing==13) { allowance-=1; } if(self.signing==15) { allowance+=1; }
   assert(source.work_left>allowance && source.path_budget.verification.work_left>67108864 && source.path_budget.verification.signatures_left>0);
   source.work_left=allowance; let verification:u64=source.path_budget.verification.work_left; let attempts:u64=source.path_budget.verification.signatures_left;
   let before:core::sha256::Digest=core::sha256::digest(source.buffers.handshake).unwrap();
   let prepared:core::result::Result<bool,ext::tls_connection::Error> =source.pump();
   assert(prepared.is_err()); let limit:bool=match(prepared.unwrap_err()) { ext::tls_connection::Error::Limit->true,_ ->false }; assert(limit);
   assert(source.failure().is_some() && source.negotiated().is_none() && source.peer_key().is_none() && source.pending_plaintext()==0 && peer.peer_key().is_none());
   word(self.out.borrow(),6); word(self.out.borrow(),allowance); word(self.out.borrow(),source.work_left); word(self.out.borrow(),verification); word(self.out.borrow(),source.path_budget.verification.work_left); word(self.out.borrow(),attempts); word(self.out.borrow(),source.path_budget.verification.signatures_left);
   if(self.signing==13) {
    assert(source.path_budget.verification.work_left==verification && source.path_budget.verification.signatures_left==attempts && source.fatal_alert_pending());
    let after:core::sha256::Digest=core::sha256::digest(source.buffers.handshake).unwrap(); assert(equal(view(before.bytes,0,32),view(after.bytes,0,32))); block(self.out.borrow(),part(source.buffers.handshake,0,0));
   } else {
    assert(source.path_budget.verification.work_left==verification-67108864 && source.path_budget.verification.signatures_left==attempts-1 && source.work_left==allowance-required && !source.fatal_alert_pending() && source.outgoing().length==0);
    block(self.out.borrow(),part(source.buffers.handshake,0,72));
