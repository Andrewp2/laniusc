   let before_zero:u64=client.stats().work_left; client.export(view(label,0,8),view(context,0,3),view(zero,3,0)).unwrap(); zero_cost=before_zero-client.stats().work_left; assert(zero_cost>0);
  }
  let payload:[u8;113]=[0;113]; i=0; while(i<113) { payload[i]=((i*71+9)%256) as u8; i+=1; } let received:[u8;128]=[0;128];
