fn view(b:[u8],at:i32,n:i32)->core::slice::View<u8> { return core::slice::View { values:b,start:at,length:n }; }
fn word(out:&std::stream::Descriptor,n:u64) { let b:[u8;8]=[0;8]; let i:i32=0; while(i<8) { b[i]=((n>>(8*i))&255) as u8; i+=1; } core::io::write_all<std::stream::Descriptor>(out,b,0,8).unwrap(); }
fn block(out:&std::stream::Descriptor,v:core::slice::View<u8>) { word(out,v.length as u64); core::io::write_all<std::stream::Descriptor>(out,v.values,v.start,v.length).unwrap(); }
fn load(b:[u8],at:i32)->u64 { let n:u64=0; let i:i32=0; while(i<8) { n|=(b[at+i] as u64)<<(8*i); i+=1; } return n; }
fn fill(v:core::slice::View<u8>,value:u8) { let i:i32=0; while(i<v.length) { v.values[v.start+i]=value; i+=1; } }
fn equal(a:[u8],b:[u8],n:i32)->bool { let i:i32=0; while(i<n) { if(a[i]!=b[i]) { return false; } i+=1; } return true; }
fn flag(b:bool)->u64 { if(b) { return 1; } return 0; }
fn record_code(e:ext::tls_record::Error)->u64 { return match(e) { ext::tls_record::Error::Authentication -> 10, ext::tls_record::Error::Exhausted -> 11, ext::tls_record::Error::InvalidRecord -> 12, ext::tls_record::Error::RecordOverflow -> 13, _ -> 90 }; }
fn framing_code(e:ext::tls_framing::Error)->u64 { return match(e) { ext::tls_framing::Error::TooLarge -> 14, _ -> 91 }; }
fn code(e:ext::tls_connection::Error)->u64 { return match(e) { ext::tls_connection::Error::Bounds -> 1, ext::tls_connection::Error::InvalidAcknowledgement -> 2, ext::tls_connection::Error::NotEstablished -> 3, ext::tls_connection::Error::Limit -> 4, ext::tls_connection::Error::Truncated -> 5, ext::tls_connection::Error::UnexpectedMessage -> 6, ext::tls_connection::Error::InvalidRecord -> 7, ext::tls_connection::Error::InvalidAlert -> 8, ext::tls_connection::Error::PeerAlert(description) -> 9, ext::tls_connection::Error::Record(detail) -> record_code(detail), ext::tls_connection::Error::Framing(detail) -> framing_code(detail), ext::tls_connection::Error::WantOutput -> 15, _ -> 99 }; }
struct Observed { status:u64,consumed:u64 }
fn feed(e:&ext::tls_connection::Engine,v:core::slice::View<u8>)->Observed { let r:core::result::Result<i32,ext::tls_connection::FeedFailure> = e.feed_wire(v); if(r.is_ok()) { return Observed { status:0,consumed:r.unwrap() as u64 }; } let f:ext::tls_connection::FeedFailure=r.unwrap_err(); return Observed { status:code(f.cause),consumed:f.consumed as u64 }; }
fn guards(v:core::slice::View<u8>) { let i:i32=1; while(i<=3) { assert(v.values[v.start-i]==165 && v.values[v.start+v.length+i-1]==165); i+=1; } }
fn limit_boundaries() {
 let l:ext::tls_connection::Limits=ext::tls_connection::default_limits(); l.max_handshake_body=16777215; l.max_hello_frame=16777219; l.max_application_hold=2147483644; l.max_records=18446744073709551615; l.max_key_updates=18446744073709551615;
 let sizes:ext::tls_connection::BufferSizes=ext::tls_connection::required_buffers(l).unwrap(); assert(sizes.handshake==16777219 && sizes.hello==33619971 && sizes.application==2147483644);
 l.max_application_hold=2147483645; assert(ext::tls_connection::required_buffers(l).is_err()); l.max_application_hold=1; l.max_handshake_body=16777216; assert(ext::tls_connection::required_buffers(l).is_err());
 l.max_handshake_body=512; l.max_hello_frame=517; assert(ext::tls_connection::required_buffers(l).is_err());
}
fn main()->i32 {
