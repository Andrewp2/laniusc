   if(op==10 || op==11 || op==12) { let receiver:ext::tls_record::Opener=engine.receiver.unwrap(); receiver.traffic.next=ext::tls_record::AES_GCM_RECORD_LIMIT-1; engine.receiver=core::option::Some(receiver); engine.receive_sequence=ext::tls_record::AES_GCM_RECORD_LIMIT-1; }
