module app::main;
import core::io;
import core::mem;
import core::option;
import core::result;
import core::slice;
import ext::service_identity;
import ext::x509;
import std::stream;
struct Output{bytes:[u8],used:i32}
impl Output{
 fn borrow(&self)->&Output{return self;}
 fn flush(&self){let out:std::stream::Descriptor=std::stream::stdout();assert(core::io::write_all(out.borrow(),self.bytes,0,self.used).is_ok());self.used=0;}
 fn word(&self,n:u64){if(self.used==1024){self.flush();}let i:i32=0;while(i<8){self.bytes[self.used+i]=((n>>(i*8))&255) as u8;i+=1;}self.used+=8;}
 fn header(&self,code:u64,offset:i32,value:u64,items:u64,work:u64){self.word(code);self.word(offset as u64);self.word(value);self.word(items);self.word(work);}
 fn reference(&self,value:ext::service_identity::Reference){self.word(match(value.kind){ext::service_identity::Kind::Dns->0,ext::service_identity::Kind::Ip->1});self.word(value.length as u64);let i:i32=0;while(i<253){self.word(value.bytes[i] as u64);i+=1;}}
}
fn word(bytes:[u8],at:i32)->u64{let value:u64=0;let i:i32=0;while(i<8){value|=(bytes[at+i] as u64)<<(i*8);i+=1;}return value;}
fn xcode(value:ext::x509::ErrorKind)->u64{return match(value){ext::x509::ErrorKind::Bounds->101,ext::x509::ErrorKind::InputLimit->102,ext::x509::ErrorKind::ItemLimit->103,ext::x509::ErrorKind::WorkLimit->104,ext::x509::ErrorKind::Der->105,ext::x509::ErrorKind::Schema->106,ext::x509::ErrorKind::Version->107,ext::x509::ErrorKind::Serial->108,ext::x509::ErrorKind::Algorithm->109,ext::x509::ErrorKind::Name->110,ext::x509::ErrorKind::Validity->111,ext::x509::ErrorKind::Spki->112,ext::x509::ErrorKind::Extension->113,ext::x509::ErrorKind::DuplicateExtension->114,ext::x509::ErrorKind::NonCanonical->115};}
fn report(error:ext::service_identity::Error,items:u64,work:u64,output:&Output){
 let code:u64=match(error){ext::service_identity::Error::Bounds->1,ext::service_identity::Error::InvalidDns->2,ext::service_identity::Error::InvalidIp->3,ext::service_identity::Error::InvalidReference->4,ext::service_identity::Error::X509(error)->xcode(error.kind)};
 let offset:i32=match(error){ext::service_identity::Error::X509(error)->error.offset,_->0};output.header(code,offset,0,items,work);
}
fn boolean(result:core::result::Result<bool,ext::service_identity::Error>,items:u64,work:u64,output:&Output){if(result.is_err()){report(result.unwrap_err(),items,work,output);}else{let value:u64=0;if(result.unwrap()){value=1;}output.header(0,0,value,items,work);}}
fn reference(result:core::result::Result<ext::service_identity::Reference,ext::service_identity::Error>,output:&Output){if(result.is_err()){report(result.unwrap_err(),0,0,output);}else{let value:ext::service_identity::Reference=result.unwrap();output.header(0,0,value.length as u64,0,0);output.reference(value);}}
fn run(header:[u8],input:[u8],output:&Output){
 let op:i32=word(header,0) as i32;let layout:i32=word(header,8) as i32;let mode:i32=word(header,16) as i32;let kind:i32=word(header,24) as i32;
 let max_input:i32=word(header,32) as i32;let items:u64=word(header,40);let work:u64=word(header,48);let rn:i32=word(header,56) as i32;let pn:i32=word(header,64) as i32;let cn:i32=word(header,72) as i32;let repeat:i32=word(header,80) as i32;
 let rstack:[u8;520]=[165;520];let pstack:[u8;520]=[183;520];let cstack:[u8;8200]=[239;8200];
 let rwords:[i32;130]=[0;130];let pwords:[i32;130]=[0;130];let cwords:[i32;2050]=[0;2050];let rb:[u8]=rstack;let pb:[u8]=pstack;let cb:[u8]=cstack;
 if(layout==1){rb=core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(rwords),520);pb=core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(pwords),520);cb=core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(cwords),8200);}
 let i:i32=0;while(i<520){rb[i]=165;pb[i]=183;i+=1;}i=0;while(i<8200){cb[i]=239;i+=1;}
 i=0;while(i<rn){rb[i+3]=input[i];i+=1;}i=0;while(i<pn){pb[i+3]=input[rn+i];i+=1;}i=0;while(i<cn){cb[i+3]=input[rn+pn+i];i+=1;}
 let r:core::slice::View<u8> = core::slice::View{values:rb,start:3,length:rn};let p:core::slice::View<u8> = core::slice::View{values:pb,start:3,length:pn};let c:core::slice::View<u8> = core::slice::View{values:cb,start:3,length:cn};
 if(mode==1){r.start=-1;}if(mode==2){r.length=-1;}if(mode==3){r.start=2147483647;r.length=1;}if(mode==4){p.start=-1;}if(mode==5){p.length=-1;}if(mode==6){p.start=2147483647;p.length=1;}
 if(op==0){reference(ext::service_identity::dns_reference(r),output);}if(op==3){reference(ext::service_identity::ip_reference(r),output);}
 if(op==1||op==8){let value:core::result::Result<i32,ext::service_identity::Error> = ext::service_identity::validate_dns_presented(r);if(op==8){value=ext::service_identity::validate_dns_reference(r);}if(value.is_err()){report(value.unwrap_err(),0,0,output);}else{output.header(0,0,value.unwrap() as u64,0,0);}}
 if(op==2){boolean(ext::service_identity::match_dns(r,p),0,0,output);}if(op==4){boolean(ext::service_identity::match_ip(r,p),0,0,output);}
 if(op==6){let first:ext::service_identity::Reference=ext::service_identity::dns_reference(r).unwrap();let retained:ext::service_identity::Reference=first;first.bytes[0]=42;rb[3]^=1;
     let second:ext::service_identity::Reference=ext::service_identity::dns_reference(p).unwrap();output.header(0,0,0,0,0);output.reference(retained);output.reference(first);output.reference(second);rb[3]^=1;
 }
 if(op==5||op==9){
   let budget_result:core::result::Result<ext::x509::Budget,ext::x509::Error> = ext::x509::budget(ext::x509::Limits{max_input:max_input,max_items:items,max_work:work});
   if(budget_result.is_err()){let error:ext::x509::Error=budget_result.unwrap_err();output.header(xcode(error.kind),error.offset,0,items,work);}
   else{let budget:ext::x509::Budget=budget_result.unwrap();let built:core::result::Result<ext::service_identity::Reference,ext::service_identity::Error> = ext::service_identity::dns_reference(r);if(kind==1){built=ext::service_identity::ip_reference(r);}
     if(built.is_err()){report(built.unwrap_err(),budget.items_left,budget.work_left,output);}else{
       let expected:ext::service_identity::Reference=built.unwrap();if(mode==8){expected.length=254;}if(mode==9){expected.length=0;}if(mode==10){expected.bytes[0]=42;}if(mode==11){expected.bytes[expected.length-1]=46;}
       let parse_budget:ext::x509::Budget=ext::x509::budget(ext::x509::default_limits()).unwrap();let parse_calls:&ext::x509::Budget=parse_budget.borrow();if(op==9){parse_calls=budget.borrow();}
       let parsed:core::result::Result<ext::x509::Certificate,ext::x509::Error> = ext::x509::parse(c,parse_calls);
       if(parsed.is_err()){let error:ext::x509::Error=parsed.unwrap_err();output.header(xcode(error.kind),error.offset,0,budget.items_left,budget.work_left);}
       else{let certificate:ext::x509::Certificate=parsed.unwrap();let copy:ext::x509::Certificate=certificate;if(mode==7&&rn>0){rb[3]^=1;}
         let round:i32=0;while(round<repeat){let checked:core::result::Result<bool,ext::service_identity::Error> = ext::service_identity::match_certificate(copy,expected,budget.borrow());boolean(checked,budget.items_left,budget.work_left,output);round+=1;}
         if(mode==7&&rn>0){rb[3]^=1;}
       }
     }
   }
 }
 i=0;while(i<520){let er:u8=165;let ep:u8=183;if(i>=3&&i<3+rn){er=input[i-3];}if(i>=3&&i<3+pn){ep=input[rn+i-3];}assert(rb[i]==er&&pb[i]==ep);i+=1;}
 i=0;while(i<8200){let ec:u8=239;if(i>=3&&i<3+cn){ec=input[rn+pn+i-3];}assert(cb[i]==ec);i+=1;}
}
fn main()->i32{
 let out:[u8;1024]=[0;1024];let output:Output=Output{bytes:out,used:0};let header:[u8;88]=[0;88];let input:[u8;9216]=[0;9216];let stdin:std::stream::Descriptor=std::stream::stdin();
 assert(core::io::read_exact(stdin.borrow(),header,0,8).is_ok());let count:u64=word(header,0);assert(count<=4096);let index:u64=0;
 while(index<count){assert(core::io::read_exact(stdin.borrow(),header,0,88).is_ok());let rn:u64=word(header,56);let pn:u64=word(header,64);let cn:u64=word(header,72);
   assert(word(header,0)<=9&&word(header,8)<=1&&word(header,16)<=11&&word(header,24)<=1&&rn<=512&&pn<=512&&cn<=8192&&word(header,80)>=1&&word(header,80)<=2);
   assert(core::io::read_exact(stdin.borrow(),input,0,(rn+pn+cn) as i32).is_ok());run(header,input,output.borrow());index+=1;
 }output.flush();return 0;
}
