// Ordinary consumer: unwrap results without inspecting or projecting Error.
module app::main;
import core::result;
import core::slice;
import ext::chacha20_poly1305;
fn main() -> i32 {
    let key: [u8; 32] = [0; 32]; let nonce: [u8; 12] = [0; 12]; let aad: [u8; 1] = [7];
    let input: [u8; 3] = [1, 2, 3]; let output: [u8; 3] = [0; 3]; let tag: [u8; 16] = [0; 16];
    let kv: core::slice::View<u8> = core::slice::View { values: key, start: 0, length: 32 };
    let nv: core::slice::View<u8> = core::slice::View { values: nonce, start: 0, length: 12 };
    let av: core::slice::View<u8> = core::slice::View { values: aad, start: 0, length: 1 };
    let iv: core::slice::View<u8> = core::slice::View { values: input, start: 0, length: 3 };
    let ov: core::slice::View<u8> = core::slice::View { values: output, start: 0, length: 3 };
    let tv: core::slice::View<u8> = core::slice::View { values: tag, start: 0, length: 16 };
    assert(core::result::unwrap(ext::chacha20_poly1305::seal_into(kv, nv, av, iv, ov, tv)) == 3);
    assert(core::result::unwrap(ext::chacha20_poly1305::open_into(kv, nv, av, ov, tv, ov)) == 3);
    assert(output[0] == 1 && output[1] == 2 && output[2] == 3); return 0;
}
