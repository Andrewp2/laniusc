// Allocation-free AEAD protocol. Eleven LEu64 header words: operation (seal0,
// open1), layout (native0,packed1), in-place, key/nonce/AAD/input/tag lengths,
// output capacity, malformed-view target (0none,1key,2nonce,3AAD,4input,5tag,
// 6output), malformed variant (0negative start,1negative length,2end overflow).
// Response: input/output strides,status,count,capacity,taglength,output,tag.
module app::main;
import core::io;
import core::mem;
import core::result;
import core::slice;
import ext::chacha20_poly1305;
import std::stream;

fn load(bytes: [u8], offset: i32) -> u64 {
    let value: u64 = 0; let index: i32 = 0;
    while (index < 8) { value |= (bytes[offset+index] as u64) << (index*8); index += 1; }
    return value;
}
struct Output { bytes: [u8], used: i32 }
impl Output {
    fn borrow(&self) -> &Output { return self; }
    fn flush(&self) {
        let stdout: std::stream::Descriptor = std::stream::stdout();
        core::result::unwrap(core::io::write_all<std::stream::Descriptor>(stdout.borrow(), self.bytes, 0, self.used)); self.used = 0;
    }
    fn byte(&self, value: u8) { if (self.used == 2048) { self.flush(); } self.bytes[self.used] = value; self.used += 1; }
    fn word(&self, value: u64) { let index: i32 = 0; while (index < 8) { self.byte(((value >> (index*8)) & 255) as u8); index += 1; } }
}
fn fill(bytes: [u8], count: i32) { let index: i32 = 0; while (index < count) { bytes[index] = 222; index += 1; } }
fn copy(source: [u8], target: [u8], count: i32) { let index: i32 = 0; while (index < count) { target[index] = source[index]; index += 1; } }
fn same(left: [u8], right: [u8], count: i32) { let index: i32 = 0; while (index < count) { assert(left[index] == right[index]); index += 1; } }
fn bad(view: core::slice::View<u8>, variant: i32) -> core::slice::View<u8> {
    let broken: core::slice::View<u8> = view;
    if (variant == 0) { broken.start = -1; }
    if (variant == 1) { broken.length = -1; }
    if (variant == 2) { broken.start = 2147483647; broken.length = 1; }
    return broken;
}
fn kind(error: ext::chacha20_poly1305::Error) -> u64 {
    return match (error) {
        ext::chacha20_poly1305::Error::Bounds -> 1,
        ext::chacha20_poly1305::Error::InvalidKeyLength -> 2,
        ext::chacha20_poly1305::Error::InvalidNonceLength -> 3,
        ext::chacha20_poly1305::Error::InvalidTagLength -> 4,
        ext::chacha20_poly1305::Error::BufferTooSmall -> 5,
        ext::chacha20_poly1305::Error::AuthenticationFailed -> 6
    };
}
fn call(operation: i32, key: core::slice::View<u8>, nonce: core::slice::View<u8>, aad: core::slice::View<u8>, input: core::slice::View<u8>, tag: core::slice::View<u8>, output: core::slice::View<u8>) -> core::result::Result<i32, ext::chacha20_poly1305::Error> {
    if (operation == 0) { return ext::chacha20_poly1305::seal_into(key, nonce, aad, input, output, tag); }
    return ext::chacha20_poly1305::open_into(key, nonce, aad, input, tag, output);
}
fn read(stdin: &std::stream::Descriptor, bytes: [u8], count: i32) {
    core::result::unwrap(core::io::read_exact<std::stream::Descriptor>(stdin, bytes, 3, count));
}
fn main() -> i32 {
    let stdin: std::stream::Descriptor = std::stream::stdin();
    let count_bytes: [u8; 8] = [0; 8]; core::result::unwrap(core::io::read_exact<std::stream::Descriptor>(stdin.borrow(), count_bytes, 0, 8));
    let count: u64 = load(count_bytes, 0); let record: u64 = 0;
    let output_bytes: [u8; 2048] = [0; 2048]; let writer: Output = Output { bytes: output_bytes, used: 0 };
    while (record < count) {
        let header: [u8; 88] = [0; 88]; core::result::unwrap(core::io::read_exact<std::stream::Descriptor>(stdin.borrow(), header, 0, 88));
        let operation: i32 = load(header, 0) as i32; let layout: i32 = load(header, 8) as i32; let inplace: bool = load(header, 16) != 0;
        let klen: i32 = load(header, 24) as i32; let nlen: i32 = load(header, 32) as i32; let alen: i32 = load(header, 40) as i32;
        let ilen: i32 = load(header, 48) as i32; let tlen: i32 = load(header, 56) as i32; let capacity: i32 = load(header, 64) as i32;
        let target: i32 = load(header, 72) as i32; let variant: i32 = load(header, 80) as i32;
        assert(operation >= 0 && operation <= 1 && layout >= 0 && layout <= 1);
        assert(klen >= 0 && klen <= 40 && nlen >= 0 && nlen <= 24 && tlen >= 0 && tlen <= 24);
        assert(alen >= 0 && alen <= 1024 && ilen >= 0 && ilen <= 1024 && capacity >= 0 && capacity <= 1040);
        let raw_key: [u8; 64] = [0; 64]; let raw_nonce: [u8; 40] = [0; 40]; let raw_tag: [u8; 40] = [0; 40];
        let raw_aad: [u8; 1100] = [0; 1100]; let raw_input: [u8; 1100] = [0; 1100]; let raw_output: [u8; 1100] = [0; 1100];
        fill(raw_key, 64); fill(raw_nonce, 40); fill(raw_tag, 40); fill(raw_aad, 1100); fill(raw_input, 1100); fill(raw_output, 1100);
        read(stdin.borrow(), raw_key, klen); read(stdin.borrow(), raw_nonce, nlen); read(stdin.borrow(), raw_aad, alen);
        read(stdin.borrow(), raw_input, ilen); read(stdin.borrow(), raw_tag, tlen);
        let saved_key: [u8; 64] = raw_key; let saved_nonce: [u8; 40] = raw_nonce; let saved_tag: [u8; 40] = raw_tag;
        let saved_aad: [u8; 1100] = raw_aad; let saved_input: [u8; 1100] = raw_input;
        let key: [u8] = raw_key; let nonce: [u8] = raw_nonce; let aad: [u8] = raw_aad;
        let input: [u8] = raw_input; let tag: [u8] = raw_tag; let output: [u8] = raw_output;
        let key_words: [i32; 16] = [0; 16]; let nonce_words: [i32; 10] = [0; 10]; let tag_words: [i32; 10] = [0; 10];
        let aad_words: [i32; 275] = [0; 275]; let input_words: [i32; 275] = [0; 275]; let output_words: [i32; 275] = [0; 275];
        if (layout == 1) {
            key = core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(key_words), 64);
            nonce = core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(nonce_words), 40);
            tag = core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(tag_words), 40);
            aad = core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(aad_words), 1100);
            input = core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(input_words), 1100);
            output = core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(output_words), 1100);
            copy(raw_key, key, 64); copy(raw_nonce, nonce, 40); copy(raw_tag, tag, 40);
            copy(raw_aad, aad, 1100); copy(raw_input, input, 1100); fill(output, 1100);
        }
        if (inplace) { output = input; }
        let kv: core::slice::View<u8> = core::slice::View { values: key, start: 3, length: klen };
        let nv: core::slice::View<u8> = core::slice::View { values: nonce, start: 3, length: nlen };
        let av: core::slice::View<u8> = core::slice::View { values: aad, start: 3, length: alen };
        let iv: core::slice::View<u8> = core::slice::View { values: input, start: 3, length: ilen };
        let tv: core::slice::View<u8> = core::slice::View { values: tag, start: 3, length: tlen };
        let ov: core::slice::View<u8> = core::slice::View { values: output, start: 3, length: capacity };
        if (target == 1) { kv = bad(kv, variant); } if (target == 2) { nv = bad(nv, variant); }
        if (target == 3) { av = bad(av, variant); } if (target == 4) { iv = bad(iv, variant); }
        if (target == 5) { tv = bad(tv, variant); } if (target == 6) { ov = bad(ov, variant); }
        let result: core::result::Result<i32, ext::chacha20_poly1305::Error> = call(operation, kv, nv, av, iv, tv, ov);
        let status: u64 = 0; let written: i32 = 0;
        if (core::result::is_err(result)) { status = kind(core::result::unwrap_err(result)); }
        else { written = core::result::unwrap(result); assert(written == ilen); }
        same(key, saved_key, 64); same(nonce, saved_nonce, 40); same(aad, saved_aad, 1100);
        if (!inplace) { same(input, saved_input, 1100); }
        let index: i32 = 0;
        while (index < 1100) {
            if (index < 3 || index >= 3+written) {
                if (inplace) { assert(output[index] == saved_input[index]); } else { assert(output[index] == 222); }
            }
            index += 1;
        }
        let tag_written: i32 = 0; if (operation == 0 && status == 0) { tag_written = 16; }
        index = 0; while (index < 40) { if (index < 3 || index >= 3+tag_written) { assert(tag[index] == saved_tag[index]); } index += 1; }
        writer.word(core::mem::slice_stride(input) as u64); writer.word(core::mem::slice_stride(output) as u64);
        writer.word(status); writer.word(written as u64); writer.word(capacity as u64); writer.word(tlen as u64);
        index = 0; while (index < capacity) { writer.byte(output[3+index]); index += 1; }
        index = 0; while (index < tlen) { writer.byte(tag[3+index]); index += 1; }
        record += 1;
    }
    writer.flush(); return 0;
}
