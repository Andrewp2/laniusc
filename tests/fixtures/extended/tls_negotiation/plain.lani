module app::main;
import core::option;
import core::result;
import core::slice;
import ext::tls_handshake;
import ext::tls_negotiation;
import ext::tls_record;
fn view(bytes:[u8],n:i32)->core::slice::View<u8>{return core::slice::View<u8>{values:bytes,start:0,length:n};}
fn run(retry:bool,cookie_only:bool,suite:u16){
    let random:[u8;32]=[7;32];let peer:[u8;32]=[9;32];let session:[u8;3]=[1,2,3];let suites:[u8;4]=[19,1,19,3];let name:[u8;11]=[101,120,97,109,112,108,101,46,99,111,109];let alpn:[u8;3]=[2,104,50];let protocol:[u8;2]=[104,50];let cookie:[u8;3]=[0,99,255];
    let ch1:[u8;256]=[0;256];let ch2:[u8;256]=[0;256];let server:[u8;128]=[0;128];let ee:[u8;64]=[0;64];let b:ext::tls_negotiation::Budget=ext::tls_negotiation::budget(ext::tls_negotiation::default_limits()).unwrap();
    let share:core::slice::View<u8> = view(peer,32);if(retry&&!cookie_only){share=view(peer,0);}
    let n:i32=ext::tls_negotiation::write_client_extensions(share,view(name,11),view(alpn,3),view(cookie,0),view(ch1,256),b.borrow()).unwrap();
    let first:ext::tls_negotiation::Offer=ext::tls_negotiation::inspect_client_hello(ext::tls_handshake::ClientHello{random:view(random,32),session_id:view(session,3),cipher_suites:view(suites,4),extensions:view(ch1,n)},b.borrow()).unwrap();
    let chosen:ext::tls_negotiation::Selection=ext::tls_negotiation::choose(first,suite,b.borrow()).unwrap();assert(chosen.suite==suite&&chosen.group==29&&chosen.signature==2055&&chosen.retry==(retry&&!cookie_only));
    let offer:ext::tls_negotiation::Offer=first;let prior:core::option::Option<ext::tls_negotiation::Retry> = core::option::None();
    if(retry){let requested:u16=29;if(cookie_only){requested=0;}let m:i32=ext::tls_negotiation::write_retry_extensions(requested,view(cookie,3),view(server,128),b.borrow()).unwrap();let hrr_random:[u8;32]=ext::tls_handshake::hello_retry_random();
        let selected:ext::tls_negotiation::Selection=ext::tls_negotiation::check_server_hello(first,ext::tls_handshake::ServerHello{random:view(hrr_random,32),session_id:view(session,3),cipher_suite:suite,extensions:view(server,m)},prior,b.borrow()).unwrap();assert(selected.retry&&selected.group==requested&&selected.cookie.length==3);
        let request:ext::tls_negotiation::Retry=ext::tls_negotiation::Retry{suite:selected.suite,group:selected.group,cookie:view(cookie,3)};
        let count:i32=ext::tls_negotiation::write_client_extensions(view(peer,32),view(name,11),view(alpn,3),view(cookie,3),view(ch2,256),b.borrow()).unwrap();
        offer=ext::tls_negotiation::check_second_client_hello(first,request,ext::tls_handshake::ClientHello{random:view(random,32),session_id:view(session,3),cipher_suites:view(suites,4),extensions:view(ch2,count)},b.borrow()).unwrap();prior=core::option::Some(request);
    }
    let m:i32=ext::tls_negotiation::write_server_extensions(view(peer,32),view(server,128),b.borrow()).unwrap();let selected:ext::tls_negotiation::Selection=ext::tls_negotiation::check_server_hello(offer,ext::tls_handshake::ServerHello{random:view(random,32),session_id:view(session,3),cipher_suite:suite,extensions:view(server,m)},prior,b.borrow()).unwrap();assert(!selected.retry&&selected.peer_key.length==32);
    let selected_alpn:core::slice::View<u8> = ext::tls_negotiation::select_alpn(offer,view(protocol,2),true,b.borrow()).unwrap();assert(selected_alpn.length==2);
    let count:i32=ext::tls_negotiation::write_encrypted_extensions(selected_alpn,true,view(ee,64),b.borrow()).unwrap();let extensions:ext::tls_negotiation::NegotiatedExtensions=ext::tls_negotiation::check_encrypted_extensions(offer,ext::tls_handshake::EncryptedExtensions{extensions:view(ee,count)},view(protocol,2),b.borrow()).unwrap();assert(extensions.server_name_ack&&extensions.alpn.length==2);
    let mapped:ext::tls_record::Suite=ext::tls_negotiation::record_suite(suite).unwrap();let right:bool=match(mapped){ext::tls_record::Suite::Aes128GcmSha256->suite==4865,ext::tls_record::Suite::ChaCha20Poly1305Sha256->suite==4867};assert(right);
}
fn main()->i32{run(false,false,4865);run(false,false,4867);run(true,false,4865);run(true,false,4867);run(true,true,4865);run(true,true,4867);return 0;}
