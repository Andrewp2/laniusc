}
fn bounds_controls() {
    let at: [u8;2] = [64,65]; let empty: View<u8> = core::slice::view(at,0).unwrap();
    let args: [View<u8>;4] = [empty,core::slice::view(at,2).unwrap(),empty,empty];
    let paths: [View<u8>;1] = [empty]; let errors: [i32;1] = [0];
    let trace: [u8;128] = [90;128]; let sizes: [i32;8] = [0;8]; let maxima: [i32;8] = [0;8];
    let provider: ScriptProvider = ScriptProvider { paths: paths, contents: paths, errors: errors, count: 0, oversize: false, calls: 0, trace_bytes: trace, trace_lengths: sizes, trace_maximum: maxima };
    let owner: ext::cli_response::Expansion = ext::cli_response::empty(); let mode: i32 = 0;
    while (mode < 4) {
        let input: View<View<u8>> = core::slice::view_range(args,1,2).unwrap();
        if (mode == 0) { input = View<View<u8>> { values: args, start: -1, length: 1 }; }
        if (mode == 1) { input = View<View<u8>> { values: args, start: 2147483647, length: 1 }; }
        if (mode == 2) { args[2] = View<u8> { values: at, start: -1, length: 1 }; }
        if (mode == 3) { args[2] = View<u8> { values: at, start: 0, length: -1 }; }
        let result: Result<i32,ext::cli_response::Failure<HostError>> = owner.prepare<ScriptProvider,HostError>(input,provider.borrow(),ext::cli_response::default_limits());
        assert(result.is_err()); let failure: ext::cli_response::Failure<HostError> = result.unwrap_err();
        assert(cause_code(failure.cause).kind == 2 && failure.at.source == -1 && failure.at.start == 0 && failure.at.length == 0);
        let argument: i32 = -1; if (mode >= 2) { argument = 1; } assert(failure.at.argument == argument);
        assert(provider.calls == 0 && !owner.is_ready() && owner.arguments().is_none() && owner.original(0).is_none() && owner.source(0).is_none());
        owner.destroy(); owner.destroy(); mode += 1;
    }
}
fn main() -> i32 {
    bounds_controls();
    let defaults: ext::cli_response::Limits = ext::cli_response::default_limits();
    assert(defaults.max_arguments == 4096 && defaults.max_tokens == 8192 && defaults.max_argument_bytes == 65536 && defaults.max_output_bytes == 1048576 && defaults.max_file_bytes == 1048576 && defaults.max_source_bytes == 4194304 && defaults.max_files == 64 && defaults.max_depth == 16 && defaults.max_path_bytes == 4095 && defaults.max_work == 33554432);
    // Packed positive byte view over live stack backing avoids a repeated-u8
    // literal count dependency. All1312 bytes remain backed during each call.
    let storage: [i32;328] = [0;328]; let bytes: [u8] = core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(storage),1312);
    assert(core::mem::slice_stride(bytes) == 1);
    let input: std::stream::Descriptor = std::stream::stdin();
    while (true) {
        let result: Result<i32,core::io::Error> = input.read(bytes,0,1312); assert(result.is_ok());
        let count: i32 = result.unwrap(); if (count == 0) { return 0; }
        if (count < 1312) { assert(core::io::read_exact(input.borrow(),bytes,count,1312-count).is_ok()); }
        let mode: u64 = decode(bytes,0); assert(mode <= 1);
        if (mode == 0) { pure(bytes,decode(bytes,8) as i32); } else { expand(bytes); }
    }
    return 0;
}
