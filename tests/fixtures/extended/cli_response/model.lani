    let bad_limits: ext::cli_response::Limits = limits; bad_limits.max_arguments = -1; let calls: i32 = provider.calls;
    let second: Result<i32,ext::cli_response::Failure<HostError>> = owner.prepare<ScriptProvider,HostError>(args,provider.borrow(),bad_limits);
    assert(second.is_err()); let repeated: ext::cli_response::Failure<HostError> = second.unwrap_err();
    assert(cause_code(repeated.cause).kind == 1 && provider.calls == calls && owner.is_ready() == successful);
    // All source/argv backing supplied by the peer is now overwritten. Every
    // following diagnostic/output/path/raw view must come from owned snapshots.
    index = 0; while (index < 1312) { bytes[index] = 0; index += 1; }
    word(provider.calls as u64); index = 0;
    while (index < provider.calls) { payload(View<u8> { values: trace, start: index*16, length: trace_lengths[index] }); word(maxima[index] as u64); index += 1; }
    word(owner.is_ready() as u64); let count: i32 = 0;
