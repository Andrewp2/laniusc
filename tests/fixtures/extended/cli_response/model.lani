    }
    let trace: [u8;128] = [90;128]; let trace_lengths: [i32;8] = [0;8]; let maxima: [i32;8] = [0;8];
    let provider: ScriptProvider = ScriptProvider { paths: paths, contents: contents, errors: errors, count: files, oversize: oversize, calls: 0, trace_bytes: trace, trace_lengths: trace_lengths, trace_maximum: maxima };
    let owner: ext::cli_response::Expansion = ext::cli_response::empty();
    assert(!owner.is_ready() && owner.arguments().is_none() && owner.origin(0).is_none() && owner.original(0).is_none() && owner.source(0).is_none());
    locate_rejected(owner.borrow(),0,0,18446744073709551615,1);
    let args: View<View<u8>> = core::slice::view_range(arguments,1,argc).unwrap();
    let result: Result<i32,ext::cli_response::Failure<HostError>> = owner.prepare<ScriptProvider,HostError>(args,provider.borrow(),limits);
    let successful: bool = result.is_ok(); word(0x525350); word(1); word((!successful) as u64);
    if (!successful) {
        let failure: ext::cli_response::Failure<HostError> = result.unwrap_err(); let diagnostic: Code = cause_code(failure.cause);
        word(diagnostic.kind as u64); word(diagnostic.detail as u64); word(diagnostic.extra as u64); origin(failure.at);
        assert(!owner.is_ready() && owner.arguments().is_none() && owner.origin(0).is_none()); locate_rejected(owner.borrow(),0,0,18446744073709551615,1);
    } else { assert(owner.is_ready() && result.unwrap() == owner.arguments().unwrap().length); }
