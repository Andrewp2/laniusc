// Actual Server cap/cancel controls. Request progress is deliberately scripted.
module app::main;
import core::clone;
import core::io;
import core::mem;
import core::net;
import core::option;
import core::result;
import core::slice;
import core::time;
import ext::http_client;
import ext::http_server;
import ext::server_poll;
import std::clock;
import std::socket;
import std::stream;

struct ApplicationError { code: i32 }
pub impl core::clone::Destroy<ApplicationError> for ApplicationError { pub fn destroy_value(owned: ApplicationError) { assert(false); } }
struct Ledger { begun: i32, closed: i32, aborted: i32, destroyed: i32, backing: i32, release: bool, head: bool }
struct Driver { owner: ext::http_server::Protocol, socket: std::socket::Socket, ledger: &Ledger, revision: u64 }
struct Factory { options: ext::http_server::Options, ledger: &Ledger }
struct Handler { calls: i32 }
impl Ledger { fn borrow(&self) -> &Ledger { return self; } }
impl Factory { fn borrow(&self) -> &Factory { return self; } }
impl Handler { fn borrow(&self) -> &Handler { return self; } }
fn bytes(value: str, count: i32) -> core::slice::View<u8> { return core::slice::view<u8>(core::mem::typed_slice_from_raw_parts<u8>(core::mem::string_data_ptr(value),count),count).unwrap(); }
fn input(owner: &ext::http_server::Protocol) -> bool { return match(owner.need()) { ext::http_server::Need::Input(count) -> true, _ -> false }; }
fn immediate(driver: &Driver) -> bool {
    if (match(driver.owner.need()) { ext::http_server::Need::Local -> true, ext::http_server::Need::FinishTransport -> true, _ -> false }) { return true; }
    return input(driver.owner.borrow()) && driver.ledger.head;
}
fn close(driver: &Driver) -> bool {
    let open: bool = driver.socket.is_open();
    if (open) { driver.socket.close().unwrap(); driver.owner.record_close(true,core::option::None()).unwrap(); driver.ledger.closed += 1; }
    return open;
}
pub impl ext::server_poll::Driver<ext::http_server::Failure> for Driver {
    pub fn protocol(&self) -> &ext::http_server::Protocol { return self.owner.borrow(); }
    pub fn stats(&self) -> ext::http_server::Stats { return self.owner.stats(); }
    pub fn transport_calls(&self) -> core::option::Option<u64> { return core::option::None(); }
    pub fn rejection(&self) -> core::option::Option<ext::http_server::Rejection> { return self.owner.rejection(); }
    pub fn raw_handle(&self) -> core::option::Option<i32> { return self.socket.raw_handle(); }
    pub fn interest(&self) -> ext::http_client::Interest { let local: bool = immediate(self); return ext::http_client::Interest { readable:!local,writable:false,immediate:local }; }
    pub fn before_wait(&self) -> core::result::Result<bool,ext::http_server::Failure> {
        let checked = self.owner.check(); assert(checked.is_ok());
        if (match(self.owner.need()) { ext::http_server::Need::Decision -> true, _ -> false } || immediate(self)) { return core::result::Ok(false); }
        return self.owner.before_wait();
    }
    pub fn step(&self, ready: ext::http_client::Readiness) -> core::result::Result<core::option::Option<ext::http_server::Event>,ext::http_server::Failure> {
        if (input(self.owner.borrow()) && self.ledger.release) { assert(ready.readable || ready.hangup || ready.error); }
        else { assert(!ready.readable && !ready.writable && !ready.hangup && !ready.error); }
        let need = self.owner.need();
        if (match(need) { ext::http_server::Need::Local -> true, _ -> false }) { self.owner.advance().unwrap(); }
        else { if (input(self.owner.borrow())) {
            if (self.ledger.head) { self.owner.feed(bytes("GET / HTTP/1.1\r\nHost: local.test\r\n\r\n",36)).unwrap(); }
            else {
                assert(self.ledger.release); let one: [u8;1] = [0]; self.owner.before_io(ext::http_server::Stage::Head).unwrap();
                let received = self.socket.receive(core::slice::view<u8>(one,1).unwrap());
                if (received.is_err()) { assert(core::io::is_interrupted(received.unwrap_err()) || match(received.unwrap_err()) { core::io::Error::WouldBlock -> true, _ -> false }); self.owner.check().unwrap(); return core::result::Ok(core::option::None()); }
                assert(received.unwrap() == 0); self.owner.feed_eof().unwrap();
            }
        } else {
            assert(match(need) { ext::http_server::Need::FinishTransport -> true, _ -> false });
            assert(close(self)); self.owner.transport_finished().unwrap();
        } }
        let revision: u64 = self.owner.event_revision();
        if (revision != 0 && revision != self.revision) { self.revision = revision; return core::result::Ok(self.owner.event()); }
        return core::result::Ok(core::option::None());
    }
    pub fn read_body(&self, decision: ext::http_server::BodyDecision) -> core::result::Result<bool,ext::http_server::Failure> { return self.owner.read_body(decision); }
    pub fn abort(&self) -> core::result::Result<bool,ext::http_server::Failure> { self.owner.abort(); let open: bool = close(self); if (open) { self.ledger.aborted += 1; } return core::result::Ok(open); }
    pub fn destroy(&self) {
        assert(!self.socket.is_open());
        // Empty input can retain allocated capacity despite zero logical bytes.
        assert(self.owner.destroy() && self.owner.logical_bytes() == 0 && !self.owner.destroy()); self.ledger.backing += 1; self.ledger.destroyed += 1;
    }
}
pub impl ext::server_poll::Factory<Driver,ext::http_server::Failure> for Factory {
    pub fn reservation(&self) -> core::result::Result<ext::server_poll::Reservation,ext::server_poll::Cause> { return core::result::Ok(ext::server_poll::Reservation { work:self.options.work,bytes:ext::http_server::reservation_bytes(self.options).unwrap() }); }
    pub fn begin(&self, accepted: std::socket::Accepted, deadline: core::time::Deadline) -> core::result::Result<Driver,ext::http_server::Failure> {
        let made = ext::http_server::protocol(self.options,deadline); if (made.is_err()) { accepted.socket.close().unwrap(); return core::result::Err(made.unwrap_err()); }
        self.ledger.begun += 1; return core::result::Ok(Driver { owner:made.unwrap(),socket:accepted.socket,ledger:self.ledger,revision:0 });
    }
    pub fn failure_stats(&self, error: ext::http_server::Failure) -> ext::http_server::Stats { return error.stats; }
    pub fn failure_transport_calls(&self, error: ext::http_server::Failure) -> core::option::Option<u64> { return core::option::None(); }
    pub fn shared_failure(&self, error: ext::http_server::Failure) -> core::option::Option<ext::server_poll::Cause> { return match(error.cause) { ext::http_server::Cause::Clock(value) -> core::option::Some(ext::server_poll::Cause::Clock(value)), _ -> core::option::None() }; }
}
pub impl ext::server_poll::Handler<ApplicationError> for Handler {
    pub fn head(&self, id: u64, peer: core::net::SocketAddr, head: ext::http_server::RequestHead, reply: &ext::server_poll::Reply) -> core::result::Result<ext::server_poll::Decision,ApplicationError> { self.calls += 1; assert(false); return core::result::Ok(ext::server_poll::Decision::Abort); }
    pub fn request(&self, id: u64, request: ext::http_server::Request, reply: &ext::server_poll::Reply) -> core::result::Result<ext::server_poll::Decision,ApplicationError> { self.calls += 1; assert(false); return core::result::Ok(ext::server_poll::Decision::Abort); }
    pub fn rejected(&self, id: u64, rejection: ext::http_server::Rejection, reply: &ext::server_poll::Reply) -> core::result::Result<ext::server_poll::Decision,ApplicationError> { self.calls += 1; assert(false); return core::result::Ok(ext::server_poll::Decision::Abort); }
}
fn deadline() -> core::time::Deadline { return core::time::deadline_after(std::clock::monotonic_now().unwrap(),core::time::from_secs(20)).unwrap(); }
fn listener() -> std::socket::Socket { let owner = std::socket::create(std::socket::Family::Ipv4,std::socket::Kind::Tcp,true).unwrap(); owner.bind(core::net::SocketAddr::V4(core::net::SocketAddrV4 { address:core::net::ipv4(127,0,0,1),port:0 })).unwrap(); owner.listen(8).unwrap(); return owner; }
fn client(listener: &std::socket::Socket, until: core::time::Deadline) -> std::socket::Socket { let owner = std::socket::create(std::socket::Family::Ipv4,std::socket::Kind::Tcp,true).unwrap(); owner.connect_until(listener.local_addr().unwrap(),until).unwrap(); return owner; }
fn eof(client: &std::socket::Socket, until: core::time::Deadline) { let one: [u8;1] = [0]; assert(client.receive_until(core::slice::view<u8>(one,1).unwrap(),until).unwrap() == 0); client.close().unwrap(); }
fn options() -> ext::http_server::Options {
    let value = ext::http_server::default_options(); value.request_bytes = 1024; value.request.head_bytes = 256; value.request.body_bytes = 0; value.request.trailers = 0; value.response_bytes = 512; value.response.head_bytes = 256; value.response.line_bytes = 128; value.response.body_bytes = 0; value.response.headers = 8; value.work = 65536; return value;
}
fn cause(value: ext::server_poll::Cause) -> i32 { return match(value) { ext::server_poll::Cause::OperationLimit -> 0, ext::server_poll::Cause::PollLimit -> 1, ext::server_poll::Cause::HandlerLimit -> 2, ext::server_poll::Cause::AcceptLimit -> 3, _ -> -1 }; }
fn aborted(report: &ext::server_poll::Report<ext::http_server::Failure,ApplicationError>, count: i32) {
    assert(report.len() == count && report.stats.accepted == count && report.stats.aborted == count && report.stats.active == 0 && report.stats.reserved_work == 0 && report.stats.reserved_bytes == 0);
    assert(report.stats.complete == 0 && report.stats.empty == 0 && report.stats.failed == 0 && report.stats.handler_failed == 0 && report.stats.invalid_decisions == 0 && report.stats.accept_failures == 0);
    let index: i32 = 0; while (index < count) {
        let retained: core::option::Option<ext::server_poll::Abort<ext::http_server::Failure>> = match(report.get(index).unwrap()) { ext::server_poll::Outcome::Aborted(value) -> core::option::Some(value), _ -> core::option::None() };
        let item = retained.unwrap(); assert(item.info.id == index as u64 && item.info.stats.closed && item.info.stats.cleanup_calls == 1 && item.info.stats.cleanup_errors == 0 && item.cleanup.is_none() && item.info.transport_calls.is_none()); index += 1;
    }
}
// Four distinct global caps, each reached while at least one owner is live.
fn cap(profile: i32) {
    let until = deadline(); let listening = listener(); let settings = options();
    let ledger: Ledger = Ledger { begun:0,closed:0,aborted:0,destroyed:0,backing:0,release:false,head:profile==2 }; let factory: Factory = Factory { options:settings,ledger:ledger.borrow() }; let handler: Handler = Handler { calls:0 };
    let limits = ext::server_poll::default_limits(); limits.max_accepted = 2; limits.concurrency = 2; if (profile == 0) { limits.operations = 128; } if (profile == 1) { limits.polls = 0; } if (profile == 2) { limits.handler_calls = 0; } if (profile == 3) { limits.max_accepted = 3; limits.accept_calls = 1; }
    let server: ext::server_poll::Server<Driver,ext::http_server::Failure,Factory,Handler,ApplicationError> = ext::server_poll::new<Driver,ext::http_server::Failure,Factory,Handler,ApplicationError>(listening.borrow(),factory.borrow(),handler.borrow(),limits,until).unwrap();
    let first = client(listening.borrow(),until); let second = client(listening.borrow(),until); server.step().unwrap();
    let terminal: core::option::Option<ext::server_poll::Cause> = core::option::None(); let expected: i32 = 2;
    if (profile == 3) { expected = 1; assert(server.stats().active == 1 && ledger.begun == 1); terminal = core::option::Some(server.step().unwrap_err()); }
    else {
        server.step().unwrap(); server.step().unwrap(); assert(server.stats().active == 2 && ledger.begun == 2 && ledger.closed == 0);
        if (profile == 1) { terminal = core::option::Some(server.prepare_wait().unwrap_err()); }
        else { let turns: i32 = 0; while (terminal.is_none()) { assert(turns < 128); turns += 1; let result = server.step(); if (result.is_err()) { terminal = core::option::Some(result.unwrap_err()); } } }
    }
    assert(cause(terminal.unwrap()) == profile && cause(server.last_failure().unwrap()) == profile && server.is_complete() && !server.is_accepting());
    let charged: u64 = server.stats().operations; assert(cause(server.step().unwrap_err()) == profile && cause(server.prepare_wait().unwrap_err()) == profile && server.stats().operations == charged && !server.abort_all());
    assert(ledger.begun == expected && ledger.closed == expected && ledger.aborted == expected && ledger.destroyed == expected && ledger.backing == expected && handler.calls == 0);
    let report = server.take_report().unwrap(); aborted(report.borrow(),expected); assert(report.stats.polls == 0 && report.stats.waits == 0 && report.stats.handler_calls == 0);
    if (profile == 0) { assert(report.stats.operations <= limits.operations && limits.operations-report.stats.operations < 3); }
    if (profile == 3) { assert(report.stats.accept_calls == 1); }
    report.destroy(); report.destroy(); assert(!server.destroy()); eof(first.borrow(),until); if (expected == 2) { eof(second.borrow(),until); } else { second.close().unwrap(); }
    assert(listening.is_open()); listening.close().unwrap();
}
fn stopping() {
    let until = deadline(); let listening = listener(); let settings = options();
    let ledger: Ledger = Ledger { begun:0,closed:0,aborted:0,destroyed:0,backing:0,release:false,head:false }; let factory: Factory = Factory { options:settings,ledger:ledger.borrow() }; let handler: Handler = Handler { calls:0 };
    let limits = ext::server_poll::default_limits(); limits.max_accepted = 3; limits.concurrency = 2;
    let server: ext::server_poll::Server<Driver,ext::http_server::Failure,Factory,Handler,ApplicationError> = ext::server_poll::new<Driver,ext::http_server::Failure,Factory,Handler,ApplicationError>(listening.borrow(),factory.borrow(),handler.borrow(),limits,until).unwrap();
    let first = client(listening.borrow(),until); let second = client(listening.borrow(),until); let queued = client(listening.borrow(),until);
    server.step().unwrap(); server.step().unwrap(); server.step().unwrap(); assert(server.stats().active == 2 && ledger.begun == 2);
    let attempts: u64 = server.stats().accept_calls; assert(server.stop_accepting() && !server.stop_accepting() && !server.is_accepting() && !server.is_complete());
    server.step().unwrap(); assert(server.stats().active == 2 && ledger.closed == 0 && ledger.aborted == 0 && ledger.destroyed == 0 && server.stats().accept_calls == attempts);
    first.shutdown(std::socket::Shutdown::Write).unwrap(); second.shutdown(std::socket::Shutdown::Write).unwrap(); ledger.release = true;
    let turns: i32 = 0; while (!server.is_complete()) { assert(turns < 16); turns += 1; server.step().unwrap(); if (!server.is_complete()) { server.poll_once().unwrap(); } }
    assert(ledger.begun == 2 && ledger.closed == 2 && ledger.aborted == 0 && ledger.destroyed == 2 && ledger.backing == 2 && handler.calls == 0 && server.last_failure().is_none());
    let report = server.take_report().unwrap(); assert(report.len() == 2 && report.stats.accepted == 2 && report.stats.empty == 2 && report.stats.aborted == 0 && report.stats.failed == 0 && report.stats.active == 0 && report.stats.accept_calls == attempts && report.stats.reserved_work == 0 && report.stats.reserved_bytes == 0);
    let index: i32 = 0; while (index < 2) { assert(match(report.get(index).unwrap()) { ext::server_poll::Outcome::Empty(info) -> info.id == index as u64 && info.stats.closed && info.stats.peer_eof && info.stats.cleanup_calls == 1 && info.stats.cleanup_errors == 0, _ -> false }); index += 1; }
    report.destroy(); report.destroy(); assert(!server.destroy()); eof(first.borrow(),until); eof(second.borrow(),until); queued.close().unwrap(); assert(listening.is_open()); listening.close().unwrap();
}
fn disposal(destroy: bool) {
    let until = deadline(); let listening = listener(); let settings = options();
    let ledger: Ledger = Ledger { begun:0,closed:0,aborted:0,destroyed:0,backing:0,release:false,head:false }; let factory: Factory = Factory { options:settings,ledger:ledger.borrow() }; let handler: Handler = Handler { calls:0 };
    let limits = ext::server_poll::default_limits(); limits.max_accepted = 3; limits.concurrency = 2;
    let server: ext::server_poll::Server<Driver,ext::http_server::Failure,Factory,Handler,ApplicationError> = ext::server_poll::new<Driver,ext::http_server::Failure,Factory,Handler,ApplicationError>(listening.borrow(),factory.borrow(),handler.borrow(),limits,until).unwrap();
    let first = client(listening.borrow(),until); let second = client(listening.borrow(),until); server.step().unwrap(); server.step().unwrap(); server.step().unwrap(); assert(server.stats().active == 2 && ledger.closed == 0);
    if (destroy) { assert(server.destroy() && !server.destroy()); assert(server.len() == 0 && server.take_report().is_err() && match(server.step().unwrap_err()) { ext::server_poll::Cause::Inactive -> true, _ -> false }); }
    else { assert(server.abort_all() && !server.abort_all()); let report = server.take_report().unwrap(); aborted(report.borrow(),2); report.destroy(); report.destroy(); assert(!server.destroy()); }
    assert(server.stats().active == 0 && server.stats().aborted == 2 && server.stats().reserved_work == 0 && server.stats().reserved_bytes == 0 && server.last_failure().is_none() && handler.calls == 0);
    assert(ledger.begun == 2 && ledger.closed == 2 && ledger.aborted == 2 && ledger.destroyed == 2 && ledger.backing == 2); eof(first.borrow(),until); eof(second.borrow(),until); assert(listening.is_open()); listening.close().unwrap();
}
fn main() -> i32 {
    cap(0); cap(1); cap(2); cap(3); stopping(); disposal(false); disposal(true);
    let marker: [i32;4] = [0x534c494d,7,13,15]; let wire: [u8] = core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(marker),16); let sink = std::stream::stdout(); core::io::write_all(sink.borrow(),wire,0,16).unwrap();
    let source = std::stream::stdin(); let ack: [u8;1] = [0]; core::io::read_exact(source.borrow(),ack,0,1).unwrap(); assert(ack[0] == 1); return 0;
}
