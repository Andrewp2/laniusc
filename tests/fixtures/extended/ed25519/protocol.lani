// Binary count; records op/layout/mode/message-length, seed32/public32/signature64/message.
// Native scalar-array and packed physical layouts both use nonzero view offsets.
module app::main;
import core::io;
import core::mem;
import core::result;
import core::slice;
import ext::ed25519;
import std::stream;
struct Output { bytes: [u8], used: i32 }
impl Output {
    fn borrow(&self) -> &Output { return self; }
    fn flush(&self) { let stdout: std::stream::Descriptor = std::stream::stdout(); assert(core::io::write_all(stdout.borrow(),self.bytes,0,self.used).is_ok()); self.used=0; }
    fn word(&self, value: u64) { if (self.used == 1024) { self.flush(); } let i: i32=0; while (i<8) { self.bytes[self.used+i]=((value>>(i*8))&255) as u8; i+=1; } self.used+=8; }
    fn key(&self, value: ext::ed25519::Key32) { let i:i32=0; while(i<32) { self.word(value.bytes[i] as u64); i+=1; } }
    fn signature(&self, value: ext::ed25519::Signature64) { let i:i32=0; while(i<64) { self.word(value.bytes[i] as u64); i+=1; } }
    fn error(&self, error: ext::ed25519::Error) { self.word(match(error) { ext::ed25519::Error::Bounds->1,ext::ed25519::Error::InvalidSeedLength->2,ext::ed25519::Error::InvalidPublicKeyLength->3,ext::ed25519::Error::InvalidSignatureLength->4 }); }
    fn key_result(&self, value: core::result::Result<ext::ed25519::Key32,ext::ed25519::Error>) { if(value.is_ok()) { self.word(0); self.key(value.unwrap()); } else { self.error(value.unwrap_err()); } }
    fn signature_result(&self, value: core::result::Result<ext::ed25519::Signature64,ext::ed25519::Error>) { if(value.is_ok()) { self.word(0); self.signature(value.unwrap()); } else { self.error(value.unwrap_err()); } }
    fn verification(&self, value: core::result::Result<bool,ext::ed25519::Error>) { if(value.is_ok()) { self.word(0); if(value.unwrap()) {self.word(1);} else {self.word(0);} } else { self.error(value.unwrap_err()); } }
}
fn decode(bytes:[u8], at:i32) -> u64 { let value:u64=0; let i:i32=0; while(i<8) {value|=(bytes[at+i] as u64)<<(i*8);i+=1;}return value; }
fn run(op:i32, packed:bool, mode:i32, length:i32, input:[u8], output:&Output) {
    let seed_stack:[u8;40]=[165;40]; let public_stack:[u8;40]=[221;40]; let signature_stack:[u8;72]=[183;72]; let message_stack:[u8;2056]=[239;2056];
    let seed_words:[i32;10]=[0;10]; let public_words:[i32;10]=[0;10]; let signature_words:[i32;18]=[0;18]; let message_words:[i32;514]=[0;514];
    let seed:[u8]=seed_stack; let public:[u8]=public_stack; let signature:[u8]=signature_stack; let message:[u8]=message_stack;
    if(packed) {
        seed=core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(seed_words),40);
        public=core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(public_words),40);
        signature=core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(signature_words),72);
        message=core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(message_words),2056);
    }
    let i:i32=0; while(i<40) {seed[i]=165;public[i]=221;i+=1;} i=0;while(i<72){signature[i]=183;i+=1;}i=0;while(i<2056){message[i]=239;i+=1;}
    i=0;while(i<32){seed[i+3]=input[i];public[i+3]=input[32+i];i+=1;}i=0;while(i<64){signature[i+3]=input[64+i];i+=1;}i=0;while(i<length){message[i+3]=input[128+i];i+=1;}
    let seed_view:core::slice::View<u8> = core::slice::View{values:seed,start:3,length:32};
    let public_view:core::slice::View<u8> = core::slice::View{values:public,start:3,length:32};
    let signature_view:core::slice::View<u8> = core::slice::View{values:signature,start:3,length:64};
    let message_view:core::slice::View<u8> = core::slice::View{values:message,start:3,length:length};
    if(op==0){output.key_result(ext::ed25519::public_key(seed_view));}
    if(op==1){output.signature_result(ext::ed25519::sign(seed_view,message_view));}
    if(op==2){output.verification(ext::ed25519::verify(public_view,message_view,signature_view));}
    if(op==3){
        if(mode==0){seed_view.start=-1;} if(mode==1){seed_view.length=-1;} if(mode==2){seed_view.start=2147483647;}
        if(mode==3||mode==5||mode==21||mode==22){seed_view.length=31;} if(mode==4){seed_view.length=33;}
        if(mode==5){message_view.start=-1;} if(mode==6){message_view.length=-1;} if(mode==7){seed_view.length=0;}
        if(mode==8||mode==10||mode==11){public_view.length=31;} if(mode==9||mode==11){signature_view.length=63;}
        if(mode==10){signature_view.start=-1;} if(mode==12||mode==21){message_view.start=2147483647;message_view.length=1;}
        if(mode==13){public_view.start=2147483647;} if(mode==14){signature_view.start=2147483647;} if(mode==15){signature_view.length=-1;}
        if(mode==16||mode==17||mode==22){message_view.start=2147483647;message_view.length=0;}
        if(mode==18){seed_view.start=2147483647;seed_view.length=0;} if(mode==19){public_view.start=2147483647;public_view.length=0;}
        if(mode==20){signature_view.start=2147483647;signature_view.length=0;}
        if(mode<=4||mode==18){output.key_result(ext::ed25519::public_key(seed_view));}
        else {if(mode<=7||mode==16||mode==21||mode==22){output.signature_result(ext::ed25519::sign(seed_view,message_view));}
        else {output.verification(ext::ed25519::verify(public_view,message_view,signature_view));}}
    }
    if(op==4){
        let first_key:ext::ed25519::Key32=ext::ed25519::public_key(seed_view).unwrap(); let retained_key:ext::ed25519::Key32=first_key;
        let first_signature:ext::ed25519::Signature64=ext::ed25519::sign(seed_view,message_view).unwrap(); let retained_signature:ext::ed25519::Signature64=first_signature;
        first_key.bytes[0]^=255;first_signature.bytes[63]^=128;seed[15]^=1;if(length>0){message[3]^=128;}
        let second_key:ext::ed25519::Key32=ext::ed25519::public_key(seed_view).unwrap(); let second_signature:ext::ed25519::Signature64=ext::ed25519::sign(seed_view,message_view).unwrap();
        output.word(0);output.key(retained_key);output.key(first_key);output.key(second_key);output.signature(retained_signature);output.signature(first_signature);output.signature(second_signature);
    }
    // Check every input cell including offsets, logical contents and all guard tails.
    i=0;while(i<40){let expected_seed:u8=165;let expected_public:u8=221;if(i>=3&&i<35){expected_seed=input[i-3];expected_public=input[32+i-3];if(op==4&&i==15){expected_seed^=1;}}assert(seed[i]==expected_seed&&public[i]==expected_public);i+=1;}
    i=0;while(i<72){let expected:u8=183;if(i>=3&&i<67){expected=input[64+i-3];}assert(signature[i]==expected);i+=1;}
    i=0;while(i<2056){let expected:u8=239;if(i>=3&&i<3+length){expected=input[128+i-3];if(op==4&&i==3){expected^=128;}}assert(message[i]==expected);i+=1;}
}
fn main()->i32{
    let output_bytes:[u8;1024]=[0;1024];let output:Output=Output{bytes:output_bytes,used:0};
    let stdin:std::stream::Descriptor=std::stream::stdin();let header:[u8;32]=[0;32];let input:[u8;2176]=[0;2176];
    assert(core::io::read_exact(stdin.borrow(),header,0,8).is_ok());let count:u64=decode(header,0);assert(count<=1024);let i:u64=0;
    while(i<count){assert(core::io::read_exact(stdin.borrow(),header,0,32).is_ok());let op:u64=decode(header,0);let layout:u64=decode(header,8);let mode:u64=decode(header,16);let length:u64=decode(header,24);
        assert(op<=4&&layout<=1&&mode<=22&&length<=2048);assert(core::io::read_exact(stdin.borrow(),input,0,128+(length as i32)).is_ok());
        run(op as i32,layout==1,mode as i32,length as i32,input,output.borrow());i+=1;
    }output.flush();return 0;
}
