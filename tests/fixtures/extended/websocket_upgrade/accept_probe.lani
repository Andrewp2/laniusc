// Test-only batch protocol: u64 count, then four u64 words and key bytes.
// Case header: layout (0 native negative stride,1 packed), mode, capacity,keylen.
// Modes: 0 separate buffers,1 overlapping,2 malformed source,3 malformed target.
// Output per case: u64 status,u64 value,96 target bytes,96 source bytes.
module app::main;
import core::io;
import core::mem;
import core::result;
import core::slice;
import ext::openssl_websocket;
import std::stream;
fn decode(bytes:[u8],offset:i32) -> u64 { let value:u64=0; let i:i32=0; while(i<8) { value|=(bytes[offset+i] as u64)<<(i*8); i+=1; } return value; }
fn put(bytes:[u8],offset:i32,value:u64) { let i:i32=0; while(i<8) { bytes[offset+i]=((value>>(i*8))&255) as u8; i+=1; } }
fn run(header:[u8],payload:[u8]) {
 let layout:i32=decode(header,0) as i32; let mode:i32=decode(header,8) as i32; let capacity:i32=decode(header,16) as i32; let length:i32=decode(header,24) as i32;
 assert(layout>=0 && layout<=1 && mode>=0 && mode<=3 && capacity>=0 && capacity<=64 && length>=0 && length<=64);
 let source_native:[u8;96]=[165;96]; let target_native:[u8;96]=[221;96]; let source_words:[i32;24]=[0;24]; let target_words:[i32;24]=[0;24];
 let source_packed:[u8]=core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(source_words),96); let target_packed:[u8]=core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(target_words),96);
 assert(core::mem::slice_stride(source_native)<0 && core::mem::slice_stride(source_packed)==1);
 let source:[u8]=source_native; let target:[u8]=target_native; if(layout==1) { source=source_packed; target=target_packed; }
 let i:i32=0; while(i<96) { source[i]=165; target[i]=221; i+=1; } i=0; while(i<length) { source[3+i]=payload[i]; i+=1; }
 if(mode==1) { target=source; }
 let key:core::slice::View<u8> =core::slice::View<u8> { values:source,start:3,length:length }; let destination:core::slice::View<u8> =core::slice::View<u8> { values:target,start:5,length:capacity };
 if(mode==2) { key.start=-1; } if(mode==3) { destination.start=2147483647; destination.length=1; }
 let answer=ext::openssl_websocket::accept_into(key,destination); let status:u64=0; let value:u64=0;
 if(answer.is_ok()) { value=answer.unwrap() as u64; }
 else { let error:ext::openssl_websocket::Error=answer.unwrap_err(); status=match(error) { ext::openssl_websocket::Error::Bounds->1,ext::openssl_websocket::Error::Capacity->2,ext::openssl_websocket::Error::Key->3,ext::openssl_websocket::Error::OpenSsl(code)->4,ext::openssl_websocket::Error::UnexpectedSize(size)->5 }; value=match(error) { ext::openssl_websocket::Error::OpenSsl(code)->code,ext::openssl_websocket::Error::UnexpectedSize(size)->size,_->0 }; }
 let output:[u8;208]=[0;208]; put(output,0,status); put(output,8,value); i=0; while(i<96) { output[16+i]=target[i]; output[112+i]=source[i]; i+=1; }
 let sink:std::stream::Descriptor=std::stream::stdout(); assert(core::io::write_all(sink.borrow(),output,0,208).is_ok());
}
fn main() -> i32 {
 let input:std::stream::Descriptor=std::stream::stdin(); let header:[u8;32]=[0;32]; let payload:[u8;64]=[0;64]; assert(core::io::read_exact(input.borrow(),header,0,8).is_ok());
 let count:u64=decode(header,0); assert(count<=4096); let index:u64=0;
 while(index<count) { assert(core::io::read_exact(input.borrow(),header,0,32).is_ok()); let length:u64=decode(header,24); assert(length<=64); assert(core::io::read_exact(input.borrow(),payload,0,length as i32).is_ok()); run(header,payload); index+=1; }
 return 0;
}
