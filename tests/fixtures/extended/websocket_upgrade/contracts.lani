fn bytes(value:str,count:i32) -> core::slice::View<u8> { let raw:[u8]=core::mem::typed_slice_from_raw_parts(core::mem::string_data_ptr(value),count); return core::slice::view(raw,count).unwrap(); }
fn same(a:core::slice::View<u8>,b:core::slice::View<u8>) -> bool { if(a.len()!=b.len()) { return false; } let i:i32=0; while(i<a.len()) { if(a.get(i).unwrap()!=b.get(i).unwrap()) { return false; } i+=1; } return true; }
fn accept() -> core::slice::View<u8> { return bytes("s3pPLMBiTxaQ9kYGzzhZRbK+xOo=",28); }
fn good(input:core::slice::View<u8>,request:ext::websocket::Request,protocol:core::option::Option<core::slice::View<u8>>,tail:core::slice::View<u8>) {
 let parsed:ext::websocket::Response=ext::websocket::validate_response(input,request,accept(),ext::websocket::default_limits()).unwrap();
 assert(parsed.head.status==101 && parsed.head.version==11 && same(parsed.remaining,tail));
 assert(parsed.protocol.is_some()==protocol.is_some()); if(protocol.is_some()) { assert(same(parsed.protocol.unwrap(),protocol.unwrap())); }
 assert(request.protocol_count==2 && ext::websocket::offers(request,bytes("chat",4)) && same(request.key,bytes("dGhlIHNhbXBsZSBub25jZQ==",24)));
}
fn bad(input:core::slice::View<u8>,request:ext::websocket::Request) { assert(ext::websocket::validate_response(input,request,accept(),ext::websocket::default_limits()).is_err()); }
fn field(name:core::slice::View<u8>,value:core::slice::View<u8>) -> ext::http::Field { return ext::http::Field { raw:bytes("",0),name:name,value:value,offset:0 }; }
