module app::main;
import core::io;
import core::mem;
import core::result;
import core::slice;
import ext::p256;
import std::stream;
struct Output{bytes:[u8],used:i32}
impl Output{fn borrow(&self)->&Output{return self;}fn flush(&self){let fd:std::stream::Descriptor=std::stream::stdout();assert(core::io::write_all(fd.borrow(),self.bytes,0,self.used).is_ok());self.used=0;}fn word(&self,n:u64){if(self.used==1024){self.flush();}let i:i32=0;while(i<8){self.bytes[self.used+i]=(n>>(i*8)) as u8;i+=1;}self.used+=8;}fn value(&self,bytes:[u8],n:i32){self.word(0);self.word(n as u64);let i:i32=0;while(i<n){self.word(bytes[i] as u64);i+=1;}}fn boolean(&self,value:bool){self.word(0);self.word(1);if(value){self.word(1);}else{self.word(0);}}fn error(&self,e:ext::p256::Error){self.word(match(e){ext::p256::Error::Bounds->1,ext::p256::Error::InvalidScalarLength->2,ext::p256::Error::InvalidScalar->3,ext::p256::Error::InvalidPublicKeyLength->4,ext::p256::Error::InvalidPointEncoding->5,ext::p256::Error::InvalidPoint->6,ext::p256::Error::InvalidDigestLength->7,ext::p256::Error::InvalidSignatureLength->8,ext::p256::Error::InvalidSignatureEncoding->9});self.word(0);}}
fn word(bytes:[u8],at:i32)->u64{let n:u64=0;let i:i32=0;while(i<8){n|=(bytes[at+i] as u64)<<(i*8);i+=1;}return n;}
fn view(bytes:[u8],at:i32,n:i32)->core::slice::View<u8>{return core::slice::View<u8>{values:bytes,start:at,length:n};}
fn run(h:[u8],input:[u8],out:&Output){
 let op:i32=word(h,0) as i32;let layout:i32=word(h,8) as i32;let mode:i32=word(h,16) as i32;let an:i32=word(h,24) as i32;let bn:i32=word(h,32) as i32;let cn:i32=word(h,40) as i32;
 let stack:[u8;4096]=[165;4096];let packed:[i32;1024]=[0;1024];let bytes:[u8]=stack;if(layout==1){bytes=core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(packed),4096);}let i:i32=0;while(i<4096){bytes[i]=165;i+=1;}
 i=0;while(i<an){bytes[3+i]=input[i];i+=1;}i=0;while(i<bn){bytes[1031+i]=input[an+i];i+=1;}i=0;while(i<cn){bytes[2059+i]=input[an+bn+i];i+=1;}
 let a:core::slice::View<u8> = view(bytes,3,an);let b:core::slice::View<u8> = view(bytes,1031,bn);let c:core::slice::View<u8> = view(bytes,2059,cn);if(mode==1){a.start=-1;}if(mode==2){a.length=-1;}if(mode==3){a.start=2147483647;a.length=1;}if(mode==4){b.start=-1;}if(mode==5){c.start=-1;}
 if(op==0){let result:core::result::Result<ext::p256::PublicKey,ext::p256::Error> = ext::p256::public_key(a);if(result.is_err()){out.error(result.unwrap_err());}else{out.value(result.unwrap().bytes,65);}}
 if(op==1){let result:core::result::Result<ext::p256::PublicKey,ext::p256::Error> = ext::p256::validate_public_key(a);if(result.is_err()){out.error(result.unwrap_err());}else{out.value(result.unwrap().bytes,65);}}
 if(op==2){let result:core::result::Result<ext::p256::CompressedKey,ext::p256::Error> = ext::p256::compress_public_key(a);if(result.is_err()){out.error(result.unwrap_err());}else{out.value(result.unwrap().bytes,33);}}
 if(op==3){let result:core::result::Result<ext::p256::SharedSecret,ext::p256::Error> = ext::p256::shared_secret(a,b);if(result.is_err()){out.error(result.unwrap_err());}else{out.value(result.unwrap().bytes,32);}}
 if(op==4||op==5){let result:core::result::Result<bool,ext::p256::Error> = core::result::Ok(false);if(op==4){result=ext::p256::verify_digest(a,b,c);}if(op==5){result=ext::p256::verify_sha256(a,b,c);}if(result.is_err()){out.error(result.unwrap_err());}else{out.boolean(result.unwrap());}}
 if(op==6){let result:core::result::Result<ext::p256::Signature,ext::p256::Error> = ext::p256::parse_der_signature(a);if(result.is_err()){out.error(result.unwrap_err());}else{out.value(result.unwrap().bytes,64);}}
 i=0;while(i<4096){let expected:u8=165;if(i>=3&&i<3+an){expected=input[i-3];}if(i>=1031&&i<1031+bn){expected=input[an+i-1031];}if(i>=2059&&i<2059+cn){expected=input[an+bn+i-2059];}assert(bytes[i]==expected);i+=1;}
}
fn main()->i32{let header:[u8;48]=[0;48];let input:[u8;3072]=[0;3072];let output_bytes:[u8;1024]=[0;1024];let output:Output=Output{bytes:output_bytes,used:0};let fd:std::stream::Descriptor=std::stream::stdin();assert(core::io::read_exact(fd.borrow(),header,0,8).is_ok());let count:u64=word(header,0);assert(count<=2048);let i:u64=0;while(i<count){assert(core::io::read_exact(fd.borrow(),header,0,48).is_ok());let an:u64=word(header,24);let bn:u64=word(header,32);let cn:u64=word(header,40);assert(word(header,0)<=6&&word(header,8)<=1&&word(header,16)<=5&&an<=1024&&bn<=1024&&cn<=1024);assert(core::io::read_exact(fd.borrow(),input,0,(an+bn+cn) as i32).is_ok());run(header,input,output.borrow());i+=1;}output.flush();return 0;}
