module app::main;
import core::io;
import core::mem;
import core::result;
import core::slice;

struct Log { words:[u64], used:i32 }
impl Log {
    fn borrow(&self) -> &Log { return self; }
    fn record(&self,id:i32,event:i32,offset:i32,count:i32,position:i32,stride:i64,payload:u64) {
        assert(self.used<128); let at:i32=self.used*8;
        self.words[at]=id as u64; self.words[at+1]=event as u64; self.words[at+2]=offset as u64;
        self.words[at+3]=count as u64; self.words[at+4]=position as u64; self.words[at+5]=stride as u64;
        self.words[at+6]=payload; self.words[at+7]=self.used as u64; self.used+=1;
    }
}
fn error(event:i32) -> core::io::Error {
    return match(-event) { 1 -> core::io::Error::Interrupted,2 -> core::io::Error::WouldBlock,
        3 -> core::io::Error::Host(-731),4 -> core::io::Error::InvalidCount,5 -> core::io::Error::WriteZero,
        6 -> core::io::Error::InvalidInput,7 -> core::io::Error::CountOverflow,8 -> core::io::Error::UnexpectedEof,
        9 -> core::io::Error::LimitExceeded,_ -> core::io::Error::AllocationFailed };
}
fn cause(error:core::io::Error) -> i32 {
    return match(error) { core::io::Error::Interrupted -> 1,core::io::Error::WouldBlock -> 2,
        core::io::Error::Host(value) -> value,core::io::Error::InvalidCount -> 4,core::io::Error::WriteZero -> 5,
        core::io::Error::InvalidInput -> 6,core::io::Error::CountOverflow -> 7,core::io::Error::UnexpectedEof -> 8,
        core::io::Error::LimitExceeded -> 9,core::io::Error::AllocationFailed -> 10 };
}
fn stop(value:core::io::CopyStop) -> i32 { return match(value) { core::io::CopyStop::Eof -> 1,core::io::CopyStop::ReadLimit -> 2,core::io::CopyStop::CallLimit -> 3,core::io::CopyStop::ReadWouldBlock -> 4,core::io::CopyStop::WriteWouldBlock -> 5 }; }
fn side(value:core::io::CopySide) -> i32 { return match(value) { core::io::CopySide::Read -> 1,core::io::CopySide::Write -> 2,core::io::CopySide::State -> 3 }; }
struct Probe { bytes:[u8],length:i32,position:i32,id:i32,events:[i32],attempts:i32,log:&Log }
fn probe(bytes:[u8],length:i32,id:i32,events:[i32],log:&Log) -> Probe { return Probe { bytes:bytes,length:length,position:0,id:id,events:events,attempts:0,log:log }; }
impl Probe {
    fn borrow(&self) -> &Probe { return self; }
    fn event(&self,values:[u8],offset:i32,count:i32) -> i32 {
        assert(count>0 && count<=8 && core::io::valid_range(offset,count));
        let event:i32=99; if(self.attempts<16) { event=self.events[self.attempts]; }
        let payload:u64=0; if(self.id==2) { let i:i32=0; while(i<count) { payload|=(values[offset+i] as u64)<<(i*8); i+=1; } }
        self.log.record(self.id,event,offset,count,self.position,core::mem::slice_stride(values) as i64,payload);
        self.attempts+=1; return event;
    }
}
pub impl core::io::Read for Probe {
    pub fn read(&self,destination:[u8],offset:i32,count:i32) -> core::result::Result<i32,core::io::Error> {
        assert(self.id==1); let event:i32=self.event(destination,offset,count);
        if(event<0 && event>=-10) { return core::result::Err(error(event)); }
        if(event==-101) { return core::result::Ok(-1); } if(event==-102) { return core::result::Ok(count+1); }
        if(event==-103) { return core::result::Ok(-2147483648); } if(event==-104) { return core::result::Ok(2147483647); }
        assert(event>=0); let amount:i32=count; if(amount>event) { amount=event; } if(amount>self.length-self.position) { amount=self.length-self.position; }
        let i:i32=0; while(i<amount) { destination[offset+i]=self.bytes[2+self.position+i]; i+=1; }
        self.position+=amount; return core::result::Ok(amount);
    }
}
pub impl core::io::Write for Probe {
    pub fn write(&self,source:[u8],offset:i32,count:i32) -> core::result::Result<i32,core::io::Error> {
        assert(self.id==2); let event:i32=self.event(source,offset,count);
        if(event<0 && event>=-10) { return core::result::Err(error(event)); }
        if(event==-101) { return core::result::Ok(-1); } if(event==-102) { return core::result::Ok(count+1); }
        if(event==-103) { return core::result::Ok(-2147483648); } if(event==-104) { return core::result::Ok(2147483647); }
        assert(event>=0); let amount:i32=count; if(amount>event) { amount=event; } assert(self.position+amount<=self.length);
        let i:i32=0; while(i<amount) { self.bytes[2+self.position+i]=source[offset+i]; i+=1; }
        self.position+=amount; return core::result::Ok(amount);
    }
    pub fn flush(&self) -> core::result::Result<i32,core::io::Error> { assert(false); return core::result::Ok(0); }
}
fn checked(value:core::result::Result<core::io::CopyStep,core::io::CopyStepFailure>,read:u64,written:u64,calls:u64,ending:i32) {
    assert(value.is_ok()); let actual:core::io::CopyStep=value.unwrap(); assert(actual.read==read && actual.written==written && actual.calls==calls && stop(actual.stop)==ending);
}
fn failure(value:core::result::Result<core::io::CopyStep,core::io::CopyStepFailure>,read:u64,written:u64,calls:u64,error:i32,which_side:i32) {
    assert(value.is_err()); let actual:core::io::CopyStepFailure=value.unwrap_err(); assert(actual.read==read && actual.written==written && actual.calls==calls && cause(actual.cause)==error && side(actual.side)==which_side);
}
fn pending(copy:&core::io::Copier<Probe,Probe>,start:i32,length:i32,a:i32,b:i32) {
    let view:core::slice::View<u8> =copy.pending(); assert(view.start==start && view.length==length);
    if(length>0) { assert(view.values[start]==a as u8); } if(length>1) { assert(view.values[start+1]==b as u8); }
}
fn event(log:&Log,index:i32,id:i32,offset:i32,count:i32,position:i32,payload:u64) {
    let at:i32=index*8; assert(index<log.used && log.words[at]==id as u64 && log.words[at+2]==offset as u64 && log.words[at+3]==count as u64 && log.words[at+4]==position as u64 && log.words[at+6]==payload);
}
// END SHARED TEST PROVIDERS

fn progress() {
    let source:[u8;8]=[91,92,0,255,65,10,93,94]; let output:[u8;8]=[177;8]; let scratch:[u8;8]=[199;8];
    let r:[i32;16]=[99;16]; let w:[i32;16]=[99;16]; r[0]=-1; r[1]=2; r[2]=-2; r[3]=2;
    w[0]=-1; w[1]=1; w[2]=-2; w[3]=-3; w[4]=1; w[5]=0;
    let words:[u64;1024]=[0;1024]; let log:Log=Log { words:words,used:0 };
    let reader:Probe=probe(source,4,1,r,log.borrow()); let writer:Probe=probe(output,6,2,w,log.borrow());
    let copy:core::io::Copier<Probe,Probe> =core::io::copier(reader.borrow(),writer.borrow(),core::slice::View { values:scratch,start:2,length:3 }).unwrap();
    checked(copy.step(0,0),0,0,0,2); checked(copy.step(9,0),0,0,0,3); assert(log.used==0);
    checked(copy.step(3,1),0,0,1,3); checked(copy.step(3,2),2,0,2,3); pending(copy.borrow(),2,2,0,255);
    checked(copy.step(0,1),2,1,1,3); pending(copy.borrow(),3,1,255,0);
    checked(copy.step(0,9),2,1,1,5); failure(copy.step(0,9),2,1,1,-731,2); assert(!copy.is_faulted()); pending(copy.borrow(),3,1,255,0);
    checked(copy.step(0,9),2,2,1,2); checked(copy.step(9,9),2,2,1,4); assert(!copy.is_done());
    failure(copy.step(2,9),4,2,2,5,2); pending(copy.borrow(),2,2,65,10); assert(!copy.is_faulted());
    checked(copy.step(0,9),4,4,1,2); checked(copy.step(9,0),4,4,0,3); assert(!copy.is_done());
    checked(copy.step(9,9),4,4,1,1); checked(copy.step(0,0),4,4,0,1); assert(copy.is_done() && copy.is_active() && !copy.is_faulted());
    assert(reader.attempts==5 && writer.attempts==7 && log.used==12 && reader.position==4 && writer.position==4);
    event(log.borrow(),0,1,2,3,0,0); event(log.borrow(),1,1,2,3,0,0); event(log.borrow(),2,2,2,2,0,65280);
    event(log.borrow(),3,2,2,2,0,65280); event(log.borrow(),4,2,3,1,1,255); event(log.borrow(),5,2,3,1,1,255);
    event(log.borrow(),6,2,3,1,1,255); event(log.borrow(),7,1,2,3,2,0); event(log.borrow(),8,1,2,2,2,0);
    event(log.borrow(),9,2,2,2,2,2625); event(log.borrow(),10,2,2,2,2,2625); event(log.borrow(),11,1,2,3,4,0);
    assert(output[0]==177 && output[1]==177 && output[2]==0 && output[3]==255 && output[4]==65 && output[5]==10 && output[6]==177 && output[7]==177);
    assert(scratch[0]==199 && scratch[1]==199 && scratch[5]==199 && scratch[6]==199 && scratch[7]==199);
    let original:[u8;8]=[91,92,0,255,65,10,93,94]; let i:i32=0; while(i<8) { assert(source[i]==original[i]); i+=1; }
    let abandoned:core::slice::View<u8> =copy.abort(); assert(abandoned.length==0 && !copy.is_active() && copy.is_done()); failure(copy.step(0,0),4,4,0,6,3);
}
fn ordinary_errors() {
    let which:i32=0; while(which<2) {
        let code:i32=3; while(code<=10) {
            let source:[u8;4]=[91,92,231,94]; let output:[u8;4]=[177;4]; let scratch:[u8;4]=[199;4];
            let r:[i32;16]=[99;16]; let w:[i32;16]=[99;16]; if(which==0) { r[0]=-code; } else { w[0]=-code; }
            let words:[u64;1024]=[0;1024]; let log:Log=Log { words:words,used:0 };
            let reader:Probe=probe(source,1,1,r,log.borrow()); let writer:Probe=probe(output,2,2,w,log.borrow());
            let copy:core::io::Copier<Probe,Probe> =core::io::copier(reader.borrow(),writer.borrow(),core::slice::View { values:scratch,start:1,length:2 }).unwrap();
            let confirmed:u64=0; let attempts:u64=1; if(which==1) { confirmed=1; attempts=2; }
            let expected:i32=code; if(code==3) { expected=-731; }
            failure(copy.step(1,9),confirmed,0,attempts,expected,which+1); assert(!copy.is_faulted() && copy.is_active() && !copy.is_done());
            checked(copy.step(9,9),1,1,(3-which) as u64,1); assert(output[2]==231 && reader.position==1 && writer.position==1);
            assert(output[0]==177 && output[1]==177 && output[3]==177 && scratch[0]==199 && scratch[3]==199); code+=1;
        } which+=1;
    }
}
fn abort_pending() {
    let source:[u8;5]=[91,92,17,18,19]; let output:[u8;6]=[177;6]; let scratch:[u8;7]=[199;7];
    let r:[i32;16]=[99;16]; let w:[i32;16]=[99;16]; w[0]=1;
    let words:[u64;1024]=[0;1024]; let log:Log=Log { words:words,used:0 };
    let reader:Probe=probe(source,3,1,r,log.borrow()); let writer:Probe=probe(output,4,2,w,log.borrow());
    let copy:core::io::Copier<Probe,Probe> =core::io::copier(reader.borrow(),writer.borrow(),core::slice::View { values:scratch,start:2,length:3 }).unwrap();
    checked(copy.step(3,2),3,1,2,3); let rest:core::slice::View<u8> =copy.abort();
    assert(rest.start==3 && rest.length==2 && rest.values[3]==18 && rest.values[4]==19);
    let again:core::slice::View<u8> =copy.abort(); assert(again.start==3 && again.length==2 && !copy.is_active() && !copy.is_done() && !copy.is_faulted());
    failure(copy.step(18446744073709551615,18446744073709551615),3,1,0,6,3); failure(copy.step(0,0),3,1,0,6,3);
    assert(log.used==2 && reader.position==3 && writer.position==1 && copy.read_count()==3 && copy.written_count()==1);
    // The copier is retired. Explicitly recover only its unwritten suffix.
    assert(writer.write(rest.values,rest.start,rest.length).unwrap()==2 && writer.position==3 && output[2]==17 && output[3]==18 && output[4]==19);
}
fn main() -> i32 { progress(); ordinary_errors(); abort_pending(); return 0; }
