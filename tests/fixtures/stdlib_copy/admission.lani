module app::main;
import core::io;
import core::result;
import core::slice;

struct Input { bytes:[u8], position:i32, calls:i32 }
impl Input { fn borrow(&self) -> &Input { return self; } }
pub impl core::io::Read for Input {
    pub fn read(&self, destination:[u8], offset:i32, count:i32) -> core::result::Result<i32,core::io::Error> {
        self.calls+=1; assert(count>0); let amount:i32=3-self.position;
        if(amount>count) { amount=count; } if(amount>2) { amount=2; }
        let i:i32=0; while(i<amount) { destination[offset+i]=self.bytes[self.position+i]; i+=1; }
        self.position+=amount; return core::result::Ok(amount);
    }
}
struct Output { bytes:[u8], position:i32, calls:i32, flushes:i32 }
impl Output { fn borrow(&self) -> &Output { return self; } }
pub impl core::io::Write for Output {
    pub fn write(&self, source:[u8], offset:i32, count:i32) -> core::result::Result<i32,core::io::Error> {
        self.calls+=1; assert(count>0 && self.position<3); self.bytes[1+self.position]=source[offset]; self.position+=1;
        return core::result::Ok(1);
    }
    pub fn flush(&self) -> core::result::Result<i32,core::io::Error> { self.flushes+=1; assert(false); return core::result::Ok(0); }
}
fn step<R,W>(copy:&core::io::Copier<R,W>, bytes:u64, calls:u64) -> core::io::CopyStep where R:core::io::Read,W:core::io::Write {
    let result:core::result::Result<core::io::CopyStep,core::io::CopyStepFailure> =copy.step(bytes,calls); return result.unwrap();
}
fn main() -> i32 {
    let source:[u8;3]=[0,255,65]; let destination:[u8;5]=[97;5]; let scratch:[u8;5]=[193;5];
    let reader:Input=Input { bytes:source,position:0,calls:0 }; let writer:Output=Output { bytes:destination,position:0,calls:0,flushes:0 };
    let view:core::slice::View<u8> =core::slice::View { values:scratch,start:1,length:3 };
    let copy:core::io::Copier<Input,Output> =core::io::copier(reader.borrow(),writer.borrow(),view).unwrap();
    assert(copy.is_active() && !copy.is_done() && !copy.is_faulted() && copy.pending().length==0);
    assert(reader.calls==0 && writer.calls==0 && copy.read_count()==0 && copy.written_count()==0);
    let first:core::io::CopyStep=step(copy.borrow(),3,1);
    assert(first.read==2 && first.written==0 && first.calls==1 && match(first.stop) { core::io::CopyStop::CallLimit -> true,_ -> false });
    let pending:core::slice::View<u8> =copy.pending(); assert(pending.start==1 && pending.length==2 && pending.values[1]==0 && pending.values[2]==255);
    let second:core::io::CopyStep=step(copy.borrow(),1,1);
    assert(second.read==2 && second.written==1 && second.calls==1 && match(second.stop) { core::io::CopyStop::CallLimit -> true,_ -> false });
    let third:core::io::CopyStep=step(copy.borrow(),0,18446744073709551615);
    assert(third.read==2 && third.written==2 && third.calls==1 && match(third.stop) { core::io::CopyStop::ReadLimit -> true,_ -> false });
    let final:core::io::CopyStep=step(copy.borrow(),10,10);
    assert(final.read==3 && final.written==3 && final.calls==3 && match(final.stop) { core::io::CopyStop::Eof -> true,_ -> false });
    let again:core::io::CopyStep=step(copy.borrow(),0,0);
    assert(again.calls==0 && match(again.stop) { core::io::CopyStop::Eof -> true,_ -> false });
    assert(copy.is_done() && copy.is_active() && !copy.is_faulted() && copy.pending().length==0);
    assert(reader.calls==3 && writer.calls==3 && writer.flushes==0 && reader.position==3 && writer.position==3);
    assert(destination[0]==97 && destination[1]==0 && destination[2]==255 && destination[3]==65 && destination[4]==97);
    assert(scratch[0]==193 && scratch[4]==193 && source[0]==0 && source[1]==255 && source[2]==65);
    return 0;
}
