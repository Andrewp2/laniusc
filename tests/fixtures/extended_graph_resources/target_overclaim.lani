// A valid self-edge precedes the selected-but-unbacked second target.
module app::main;
import core::slice;
import ext::graph;
fn main() -> i32 {
    let offsets:[i32;3]=[0,2,2]; let targets:[i32;1]=[0];
    let value:ext::graph::View=ext::graph::View { nodes:2,
        offsets:core::slice::View { values:offsets,start:0,length:3 },
        targets:core::slice::View { values:targets,start:0,length:2 } };
    let result=ext::graph::validate(value,ext::graph::default_limits());
    if(result.is_err()) { return 2; } return 0;
}
