module app::main;
import ext::compression;
import ext::deflate;
import fixture::support;
fn main() -> i32 {
    fixture::support::mark(65); let workspace=fixture::support::workspace(); fixture::support::mark(83); fixture::support::mark(80);
    assert(ext::deflate::input_buffer_len()==32768 && ext::deflate::output_buffer_len()==32773 && ext::deflate::scratch_len()==32768);
    let raw=ext::deflate::encoder(workspace.input(),workspace.output(),workspace.hash()).unwrap(); workspace.pristine();
    let source:[u8;3] = [91,65,92]; let target:[u8;32] = [211;32];
    let input=fixture::support::view(source,1,1); let empty=fixture::support::view(source,1,0);
    fixture::support::progress(raw.step(input,fixture::support::view(target,2,1),true).unwrap(),1,1,2); assert(target[2]==115 && !raw.is_done());
    source[1]=255;
    fixture::support::progress(raw.step(empty,fixture::support::view(target,3,2),true).unwrap(),0,2,3); assert(target[3]==4 && target[4]==0 && raw.is_done());
    fixture::support::progress(raw.step(input,fixture::support::view(target,5,2),false).unwrap(),0,0,3);
    raw.reset(); assert(!raw.is_done()); fixture::support::progress(raw.step(empty,fixture::support::view(target,6,2),true).unwrap(),0,2,3); assert(target[6]==3 && target[7]==0);
    let zlib=ext::compression::encoder(workspace.input(),workspace.output(),workspace.hash(),ext::compression::Format::Zlib,ext::compression::default_encode_limits()).unwrap();
    fixture::support::progress(zlib.step(empty,fixture::support::view(target,2,8),true).unwrap(),0,8,3);
    let z:[u8;8] = [120,1,3,0,0,0,0,1]; let i:i32 = 0; while(i<8) { assert(target[2+i]==z[i]); i+=1; }
    assert(zlib.is_done() && !zlib.is_failed() && zlib.total_read()==0 && zlib.total_written()==8);
    let gzip=ext::compression::encoder(workspace.input(),workspace.output(),workspace.hash(),ext::compression::Format::Gzip,ext::compression::default_encode_limits()).unwrap();
    fixture::support::progress(gzip.step(empty,fixture::support::view(target,2,20),true).unwrap(),0,20,3);
    let g:[u8;20] = [31,139,8,0,0,0,0,0,0,255,3,0,0,0,0,0,0,0,0,0]; i=0; while(i<20) { assert(target[2+i]==g[i]); i+=1; }
    assert(gzip.is_done() && !gzip.is_failed() && gzip.total_read()==0 && gzip.total_written()==20);
    assert(source[0]==91 && source[1]==255 && source[2]==92 && target[0]==211 && target[1]==211 && target[22]==211 && target[31]==211);
    workspace.guards(); fixture::support::mark(112); fixture::support::mark(82); workspace.destroy(); fixture::support::mark(69); fixture::support::mark(68); return 0;
}
