module app::main;
import core::function;
import core::result;
import fixture::owners;

fn main() -> i32 {
    let mode:i32 = fixture::owners::mode(); fixture::owners::mark(65);
    let source:fixture::owners::Owner = fixture::owners::make(7);
    let data:ptr = source.payload.first.storage; let text:ptr = source.payload.second.bytes.storage;
    let build:fixture::owners::Build = fixture::owners::Build { calls:0 };
    fixture::owners::mark(83);
    // The wrapper and callback receive the only active cleanup authority.
    fixture::owners::mark(67);
    let input:core::result::Result<fixture::owners::Owner,fixture::owners::Failure> = core::result::Ok(source);
    let result:core::result::Result<fixture::owners::Owner,fixture::owners::Failure> = core::result::and_then<fixture::owners::Owner,fixture::owners::Failure,fixture::owners::Owner,fixture::owners::Build>(input,build.borrow());
    fixture::owners::mark(70);
    if(mode==1) {
        assert(result.is_err()); let failure:fixture::owners::Failure = result.unwrap_err();
        assert(failure.stage==2 && build.calls==1);
        fixture::owners::mark(80); fixture::owners::check(failure.owner,7,data,text); fixture::owners::mark(112);
        // The failed callback returned the original two owner descriptors;
        // retry transfers them again, never consulting the inactive source.
        fixture::owners::mark(67);
        let retry:core::result::Result<fixture::owners::Owner,fixture::owners::Failure> = core::result::Ok(failure.owner);
        result=retry.and_then<fixture::owners::Owner,fixture::owners::Build>(build.borrow());
        fixture::owners::mark(70);
    }
    let output:fixture::owners::Owner = result.unwrap();
    let output_data:ptr = output.payload.first.storage; let output_text:ptr = output.payload.second.bytes.storage;
    fixture::owners::mark(80); fixture::owners::check(output,17,output_data,output_text); assert(build.calls==mode+1); fixture::owners::mark(112);
    // Input retirement has already happened in the successful callback.
    fixture::owners::mark(82); fixture::owners::publish(output); fixture::owners::destroy(output);
    fixture::owners::mark(68); return 0;
}
