module app::main;
import core::mem;
import std::env;
import std::env_checked;
import std::io;
fn main() -> i32 {
    if (std::env::var_count() != 2) {
        return 1;
    }
    let words:[i32; 2] =[0, 0];
    let buffer: ptr = core::mem::i32_array_data_ptr(words);
    if (std::env_checked::var_key_read_exact_into(-1, buffer, 2) || std::env_checked::var_key_read_exact_into(2, buffer, 2)) {
        return 2;
    }
    if (std::env_checked::var_key_read_exact_into(0, 0, 2) || std::env_checked::var_key_read_exact_into(0, buffer, 0)) {
        return 3;
    }
    let too_large: usize = 2147483648;
    if (std::env_checked::var_key_read_exact_into(0, buffer, too_large)) {
        return 4;
    }
    if (words[0] != 0 || words[1] != 0) {
        return 5;
    }
    let offset: usize = 1;
    let second: ptr = buffer + offset;
    if (!std::env_checked::var_key_read_exact_into(0, buffer, 1) || !std::env_checked::var_key_read_exact_into(1, second, 1)) {
        return 6;
    }
    if (std::io::write_stdout(buffer, 2) != 2) {
        return 7;
    }
    return 0;
}
