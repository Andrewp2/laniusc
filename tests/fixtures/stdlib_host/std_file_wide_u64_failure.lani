module app::main;
import core::wide_u64;
import std::file;

fn main() -> i32 {
    let fallback: core::wide_u64::WideU64 = core::wide_u64::from_u32(777);
    let value: core::wide_u64::WideU64 =
        std::file::read_wide_u64_decimal_or("valid.txt", 64, fallback);
    if (core::wide_u64::eq(value, fallback)) { return 0; }
    if (!std::file::write_wide_u64_decimal("out.txt", value)) { return 0; }
    return 1;
}
