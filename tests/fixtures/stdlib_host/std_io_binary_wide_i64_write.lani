module app::main;
import core::wide_i64;
import std::io;
import std::io_binary_wide_i64;
fn newline() -> bool {
    return std::io::write_byte(1, 10) == 1;
}
fn main() -> i32 {
    let zero: core::wide_i64::WideI64 = core::wide_i64::zero();
    let negative_one: core::wide_i64::WideI64 = core::wide_i64::from_i32(-1);
    let negative_thirteen: core::wide_i64::WideI64 = core::wide_i64::from_i32(-13);
    let max: core::wide_i64::WideI64 = core::wide_i64::max_value();
    let min: core::wide_i64::WideI64 = core::wide_i64::min_value();
    if (std::io_binary_wide_i64::write(1, zero) != 1 || !newline()) {
        return 1;
    }
    if (std::io_binary_wide_i64::write(1, negative_one) != 2 || !newline()) {
        return 2;
    }
    if (std::io_binary_wide_i64::write(1, negative_thirteen) != 5 || !newline()) {
        return 3;
    }
    if (std::io_binary_wide_i64::write(1, max) != 63 || !newline()) {
        return 4;
    }
    if (std::io_binary_wide_i64::write(1, min) != 65 || !newline()) {
        return 5;
    }
    if (std::io_binary_wide_i64::write(-1, zero) >= 0) {
        return 6;
    }
    return 0;
}
