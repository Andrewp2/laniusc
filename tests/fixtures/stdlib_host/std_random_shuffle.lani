module app::main;
import core::mem;
import core::slice;
import std::random_checked;

fn main() -> i32 {
    let values: [i32; 8] = [7, -3, 0, 7, 2147483647, -2147483648, 4, -3];
    let view: [i32] = core::mem::i32_slice_from_raw_parts(core::mem::i32_array_data_ptr(values), 8);
    let empty: [i32] = core::mem::i32_slice_from_raw_parts(core::mem::i32_array_data_ptr(values), 0);
    if (std::random_checked::shuffle_i32(view, -1) ||
        !std::random_checked::shuffle_i32(empty, 0) ||
        !std::random_checked::shuffle_i32(view, 1) ||
        values[0] != 7 || values[1] != -3) {
        return 1;
    }
    if (!std::random_checked::shuffle_i32(view, 8)) {
        return 2;
    }
    if (core::slice::sort(view, 8) != 8 ||
        values[0] != -2147483648 || values[1] != -3 || values[2] != -3 ||
        values[3] != 0 || values[4] != 4 || values[5] != 7 ||
        values[6] != 7 || values[7] != 2147483647) {
        return 3;
    }
    return 0;
}
