module app::main;
import core::wide_i64;
import std::io_decimal;

fn main() -> i32 {
    let fallback: core::wide_i64::WideI64 = core::wide_i64::from_i32(-777);
    if (!core::wide_i64::eq(
        std::io_decimal::read_wide_i64_stdin_or(0, fallback), fallback)) { return 1; }
    let value: core::wide_i64::WideI64 =
        std::io_decimal::read_wide_i64_stdin_or(64, fallback);
    let expected: i32 = core::wide_i64::decimal_len(value);
    if (std::io_decimal::write_wide_i64(1, value) != expected) { return 2; }
    return 0;
}
