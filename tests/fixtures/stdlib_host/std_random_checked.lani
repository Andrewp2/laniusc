module app::main;
import std::random_checked;
fn main() -> i32 {
    let fallback: u32 = 4294967295;
    let negative: i32 = -1;
    if (negative as u32 != fallback) {
        return 2;
    }
    let saw_result: bool = false;
    let index: i32 = 0;
    while (index<8) {
        if (std::random_checked::secure_u32_or(fallback) != fallback) {
            saw_result = true;
        }
        index += 1;
    }
    if (!saw_result) {
        return 1;
    }
    return 0;
}
