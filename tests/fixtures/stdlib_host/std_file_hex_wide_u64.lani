module app::main;
import core::wide_u64;
import std::file_hex_wide_u64;
fn matches(value: core::wide_u64::WideU64, high: u32, low: u32) -> bool {
    return core::wide_u64::high_word(value) == high && core::wide_u64::low_word(value) == low;
}
fn main() -> i32 {
    let zero: core::wide_u64::WideU64 = core::wide_u64::zero();
    let boundary: core::wide_u64::WideU64 = core::wide_u64::from_words(1, 0);
    let pattern: core::wide_u64::WideU64 = core::wide_u64::from_words(305419896, 2596069104);
    let max: core::wide_u64::WideU64 = core::wide_u64::max_value();
    let fallback: core::wide_u64::WideU64 = core::wide_u64::from_u32(4078);
    if (!std::file_hex_wide_u64::write_lower("zero_out.txt", zero) || !std::file_hex_wide_u64::write_lower("boundary_out.txt", boundary) || !std::file_hex_wide_u64::write_lower("pattern_lower_out.txt", pattern) || !std::file_hex_wide_u64::write_upper("pattern_upper_out.txt", pattern) || !std::file_hex_wide_u64::write_upper("max_out.txt", max)) {
        return 1;
    }
    if (std::file_hex_wide_u64::write_lower("missing/child.txt", zero) || std::file_hex_wide_u64::write_upper("/dev/full", pattern)) {
        return 2;
    }
    if (!matches(std::file_hex_wide_u64::read_or("zero.txt", 1, fallback), 0, 0) || !matches(std::file_hex_wide_u64::read_or("boundary.txt", 9, fallback), 1, 0) || !matches(std::file_hex_wide_u64::read_or("pattern.txt", 18, fallback), 305419896, 2596069104) || !matches(std::file_hex_wide_u64::read_or("max.txt", 16, fallback), 4294967295, 4294967295) || !matches(std::file_hex_wide_u64::read_or("space.txt", 20, fallback), 0, 6699) || !matches(std::file_hex_wide_u64::read_or("exact32.txt", 32, fallback), 4294967295, 4294967295)) {
        return 3;
    }
    if (!core::wide_u64::eq(std::file_hex_wide_u64::read_or("excess33.txt", 32, fallback), fallback) || !core::wide_u64::eq(std::file_hex_wide_u64::read_or("overflow.txt", 32, fallback), fallback) || !core::wide_u64::eq(std::file_hex_wide_u64::read_or("prefix.txt", 32, fallback), fallback) || !core::wide_u64::eq(std::file_hex_wide_u64::read_or("bad.txt", 32, fallback), fallback) || !core::wide_u64::eq(std::file_hex_wide_u64::read_or("empty.txt", 32, fallback), fallback) || !core::wide_u64::eq(std::file_hex_wide_u64::read_or("missing.txt", 32, fallback), fallback) || !core::wide_u64::eq(std::file_hex_wide_u64::read_or("zero.txt", 0, fallback), fallback)) {
        return 4;
    }
    return 0;
}
