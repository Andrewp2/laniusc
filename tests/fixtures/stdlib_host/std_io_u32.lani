module app::main;
import std::io;
fn main() -> i32 {
    if (std::io::write_u32(1, 0) != 1 || std::io::write_newline(1) != 1) {
        return 1;
    }
    if (std::io::write_u32(1, 42) != 2 || std::io::write_newline(1) != 1) {
        return 2;
    }
    if (std::io::write_u32(1, 1000000000) != 10 || std::io::write_newline(1) != 1) {
        return 3;
    }
    if (std::io::write_u32(1, 4294967295) != 10 || std::io::write_newline(1) != 1) {
        return 4;
    }
    if (std::io::write_u32(-1, 7) >= 0) {
        return 5;
    }
    return 0;
}
