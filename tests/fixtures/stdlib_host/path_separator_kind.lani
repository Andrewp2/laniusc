module app::main;
import core::path_rules;
fn main() -> i32 {
    if (core::path_rules::path_separator_kind(47) != core::path_rules::PATH_SEPARATOR_UNIX_KIND) {
        return 1;
    }
    if (core::path_rules::path_separator_kind(92) != core::path_rules::PATH_SEPARATOR_WINDOWS_KIND) {
        return 2;
    }
    if (core::path_rules::path_separator_kind(65) != core::path_rules::PATH_SEPARATOR_NONE) {
        return 3;
    }
    return 0;
}
