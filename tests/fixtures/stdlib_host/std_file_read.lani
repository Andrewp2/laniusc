module app::main;
import alloc::allocator;
import std::file;
import std::fs;
fn exercise(buffer: ptr) -> i32 {
    let received: i32 = std::file::read_once_into_buffer("input.bin", buffer, 16);
    if (received != 16) {
        return 1;
    }
    let output: i32 = std::fs::open_write_path("prefix.bin");
    if (output<0) {
        return 2;
    }
    let received_len: usize = received as usize;
    let written: bool = std::file::write_all_bytes(output, buffer, received_len);
    let closed: i32 = std::fs::close_file(output);
    if (!written || closed<0) {
        return 3;
    }
    if (!std::file::read_exact_into_buffer("input.bin", buffer, 16)) {
        return 16;
    }
    let exact_output: i32 = std::fs::open_write_path("exact.bin");
    if (exact_output<0) {
        return 17;
    }
    let exact_written: bool = std::file::write_all_bytes(exact_output, buffer, 16);
    let exact_closed: i32 = std::fs::close_file(exact_output);
    if (!exact_written || exact_closed<0) {
        return 18;
    }
    if (std::file::read_exact_into_buffer("short.bin", buffer, 4) || !std::file::read_exact_into_buffer("empty.bin", 0, 0) || std::file::read_exact_into_buffer("missing.bin", 0, 0) || std::file::read_exact_into_buffer("input.bin", 0, 16) || std::file::read_exact_into_buffer("input.bin", buffer, 2147483648)) {
        return 19;
    }
    let short_read: i32 = std::file::read_once_into_buffer("short.bin", buffer, 16);
    if (short_read != 3) {
        return 10;
    }
    let short_output: i32 = std::fs::open_write_path("short-copy.bin");
    if (short_output<0) {
        return 11;
    }
    let short_len: usize = short_read as usize;
    let short_written: bool = std::file::write_all_bytes(short_output, buffer, short_len);
    let short_closed: i32 = std::fs::close_file(short_output);
    if (!short_written || short_closed<0) {
        return 12;
    }
    if (std::file::read_once_into_buffer("empty.bin", buffer, 16) != 0) {
        return 4;
    }
    if (std::file::read_once_into_buffer("missing.bin", buffer, 16) >= 0) {
        return 5;
    }
    if (std::file::read_once_into_buffer("input.bin", 0, 16) >= 0) {
        return 6;
    }
    if (std::file::read_once_into_buffer("input.bin", buffer, 0) >= 0) {
        return 7;
    }
    if (std::file::read_once_into_buffer("input.bin", buffer, 2147483648) >= 0) {
        return 8;
    }
    if (std::file::write_all_bytes(-1, buffer, 3) || std::file::write_all_bytes(2147483647, buffer, 3) || std::file::write_all_bytes(1, 0, 3) || std::file::write_all_bytes(1, buffer, 2147483648) || !std::file::write_all_bytes(1, 0, 0)) {
        return 13;
    }
    let full: i32 = std::fs::open_write_path("/dev/full");
    if (full<0) {
        return 14;
    }
    let full_written: bool = std::file::write_all_bytes(full, buffer, 3);
    let full_closed: i32 = std::fs::close_file(full);
    if (full_written || full_closed<0) {
        return 15;
    }
    return 0;
}
fn main() -> i32 {
    let buffer: ptr = alloc::allocator::alloc(16, 1);
    if (buffer == 0) {
        return 9;
    }
    let result: i32 = exercise(buffer);
    alloc::allocator::dealloc(buffer, 16, 1);
    return result;
}
