module app::main;
import std::io_hex;

fn main() -> i32 {
    let fallback: u8 = 7;
    if (std::io_hex::read_u8_stdin_or(0, fallback) != fallback) {
        return 1;
    }
    let value: u8 = std::io_hex::read_u8_stdin_or(16, fallback);
    if (std::io_hex::write_lower_u8(1, value) < 0) {
        return 2;
    }
    return 0;
}
