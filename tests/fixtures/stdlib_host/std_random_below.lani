module app::main;
import std::random_checked;

fn main() -> i32 {
    let fallback: u32 = 4294967295;
    if (std::random_checked::secure_u32_below_or(0, fallback) != fallback ||
        std::random_checked::secure_u32_below_or(1, fallback) != 0) {
        return 1;
    }
    let index: i32 = 0;
    while (index < 64) {
        let small: u32 = std::random_checked::secure_u32_below_or(10, fallback);
        let large: u32 = std::random_checked::secure_u32_below_or(4294967295, fallback);
        if (small >= 10 || large >= 4294967295) {
            return 2;
        }
        index += 1;
    }
    return 0;
}
