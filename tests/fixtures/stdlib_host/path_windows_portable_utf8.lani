    let b195: u8 = 195;
    let report: [u8; 10] = [b114, b101, b112, b111, b114, b116, b46, b116, b120, b116];
    let unicode: [u8; 6] = [b195, b169, b46, b116, b120, b116];
    let hidden: [u8; 7] = [b46, b99, b111, b110, b102, b105, b103];
    let com_zero: [u8; 4] = [b67, b79, b77, b48];
    let console: [u8; 7] = [b67, b79, b78, b83, b79, b76, b69];
    let com_ten: [u8; 5] = [b67, b79, b77, b49, b48];
    if (!std::path::path_component_is_windows_portable_utf8(report, 10) ||
        !std::path::path_component_is_windows_portable_utf8(unicode, 6) ||
        !std::path::path_component_is_windows_portable_utf8(hidden, 7) ||
        !std::path::path_component_is_windows_portable_utf8(com_zero, 4) ||
        !std::path::path_component_is_windows_portable_utf8(console, 7) ||
        !std::path::path_component_is_windows_portable_utf8(com_ten, 5)) { return 1; }

    let con: [u8; 3] = [b67, b79, b78];
    let prn: [u8; 3] = [b112, b82, b110];
    let aux: [u8; 3] = [b65, b85, b88];
    let nul_extension: [u8; 7] = [b110, b117, b108, b46, b116, b120, b116];
    let com_one: [u8; 4] = [b99, b111, b109, b49];
    let lpt_nine_extension: [u8; 8] = [b76, b80, b84, b57, b46, b116, b120, b116];
    let com_superscript_one: [u8; 5] = [b67, b79, b77, b194, b185];
    let lpt_superscript_three_extension: [u8; 7] = [b108, b112, b116, b194, b179, b46, b120];
    if (std::path::path_component_is_windows_portable_utf8(con, 3) ||
        std::path::path_component_is_windows_portable_utf8(prn, 3) ||
        std::path::path_component_is_windows_portable_utf8(aux, 3) ||
        std::path::path_component_is_windows_portable_utf8(nul_extension, 7) ||
        std::path::path_component_is_windows_portable_utf8(com_one, 4) ||
        std::path::path_component_is_windows_portable_utf8(lpt_nine_extension, 8) ||
        std::path::path_component_is_windows_portable_utf8(com_superscript_one, 5) ||
        std::path::path_component_is_windows_portable_utf8(lpt_superscript_three_extension, 7)) {
        return 2;
    }

    let trailing_dot: [u8; 4] = [b102, b111, b111, b46];
    let trailing_space: [u8; 4] = [b102, b111, b111, b32];
    let spaced_device: [u8; 8] = [b67, b79, b78, b32, b46, b116, b120, b116];
    let malformed_utf8: [u8; 2] = [b195, b40];
    let reserved_punctuation: [u8; 2] = [b97, b63];
    let control: [u8; 2] = [b97, b10];
    let nul_byte: [u8; 2] = [b97, b0];
    let dot: [u8; 1] = [b46];
    let parent: [u8; 2] = [b46, b46];
    let drive: [u8; 2] = [b67, b58];
    if (std::path::path_component_is_windows_portable_utf8(trailing_dot, 4) ||
