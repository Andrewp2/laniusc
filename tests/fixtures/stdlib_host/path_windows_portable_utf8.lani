        std::path::path_component_is_windows_portable_utf8(parent, 2) ||
        std::path::path_component_is_windows_portable_utf8(drive, 2) ||
        std::path::path_component_is_windows_portable_utf8(report, 0) ||
        std::path::path_component_is_windows_portable_utf8(report, -1)) { return 3; }
    return 0;
}
