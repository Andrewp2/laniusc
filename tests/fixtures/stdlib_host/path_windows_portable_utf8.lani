        std::path::path_component_is_windows_portable_utf8(spaced_device, 8) ||
        std::path::path_component_is_windows_portable_utf8(malformed_utf8, 2) ||
        std::path::path_component_is_windows_portable_utf8(reserved_punctuation, 2) ||
        std::path::path_component_is_windows_portable_utf8(control, 2) ||
