module app::main;
import std::path;

fn main() -> i32 {
    let b0: u8 = 0;
    let b10: u8 = 10;
    let b32: u8 = 32;
    let b40: u8 = 40;
    let b46: u8 = 46;
    let b48: u8 = 48;
