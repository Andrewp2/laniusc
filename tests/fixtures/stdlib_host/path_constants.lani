module app::main;
import core::path_rules;
fn main() -> i32 {
    if (core::path_rules::PATH_SEPARATOR_NONE != 0 || core::path_rules::PATH_SEPARATOR_UNIX_KIND != 1 || core::path_rules::PATH_SEPARATOR_WINDOWS_KIND != 2) {
        return 1;
    }
    if (core::path_rules::PATH_SEPARATOR_UNIX != 47 || core::path_rules::PATH_SEPARATOR_WINDOWS != 92 || core::path_rules::PATH_EXTENSION_SEPARATOR != 46 || core::path_rules::PATH_DRIVE_SEPARATOR != 58 || core::path_rules::PATH_NUL != 0 || core::path_rules::PATH_ASCII_DELETE != 127) {
        return 2;
    }
    if (core::path_rules::PATH_WINDOWS_RESERVED_DOUBLE_QUOTE != 34 || core::path_rules::PATH_WINDOWS_RESERVED_ASTERISK != 42 || core::path_rules::PATH_WINDOWS_RESERVED_LESS_THAN != 60 || core::path_rules::PATH_WINDOWS_RESERVED_GREATER_THAN != 62 || core::path_rules::PATH_WINDOWS_RESERVED_QUESTION_MARK != 63 || core::path_rules::PATH_WINDOWS_RESERVED_PIPE != 124) {
        return 3;
    }
    if (core::path_rules::PATH_HAS_ALLOCATION_API || core::path_rules::PATH_HAS_HOST_NORMALIZATION) {
        return 4;
    }
    return 0;
}
