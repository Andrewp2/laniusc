module app::main;
import core::option;
import core::wide_i64;
import std::random_wide;
fn main() -> i32 {
    let low: core::wide_i64::WideI64 = core::wide_i64::from_i32(-5);
    let high: core::wide_i64::WideI64 = core::wide_i64::from_i32(5);
    if (core::option::is_none(std::random_wide::try_secure_i64_inclusive(low, high))) {
        return 0;
    }
    return 1;
}
