module app::main;
import core::wide_i64;
import std::io_hex_wide_i64;
fn main() -> i32 {
    let fallback: core::wide_i64::WideI64 = core::wide_i64::from_i32(4078);
    let skipped: core::wide_i64::WideI64 = std::io_hex_wide_i64::read_stdin_or(0, fallback);
    if (!core::wide_i64::eq(skipped, fallback)) {
        return 1;
    }
    let value: core::wide_i64::WideI64 = std::io_hex_wide_i64::read_stdin_or(40, fallback);
    if (std::io_hex_wide_i64::write_lower(1, value) <= 0) {
        return 2;
    }
    return 0;
}
