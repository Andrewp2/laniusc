    let empty_key: ptr = core::mem::i32_array_data_ptr(empty);
    let missing_key: ptr = core::mem::i32_array_data_ptr(missing);
    let buffer: ptr = core::mem::i32_array_data_ptr(buffer_words);
    if (std::env_checked::var_read_exact_into(missing_key, 1, buffer, 8)) {
        return 1;
    }
    if (!std::env_checked::var_read_exact_into(empty_key, 1, 0, 0)) {
        return 2;
    }
    if (std::env_checked::var_read_exact_into(present_key, 1, buffer, 4)) {
        return 3;
    }
    if (std::env_checked::var_read_exact_into(present_key, 1, 0, 5)) {
