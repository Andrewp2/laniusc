module app::main;
import core::wide_u64;
import std::file_binary_wide_u64;
fn main() -> i32 {
    let fallback: core::wide_u64::WideU64 = core::wide_u64::from_u32(7);
    let value: core::wide_u64::WideU64 = std::file_binary_wide_u64::read_or("valid.txt", 8, fallback);
    if (core::wide_u64::eq(value, fallback)) {
        return 0;
    }
    return 1;
}
