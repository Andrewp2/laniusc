module app::main;
import std::io_utf8;

fn main() -> i32 {
    if (std::io_utf8::read_stdin_scalar_or(1114112, 1114113, 1114114) != 1114113) {
        return 1;
    }
    if (std::io_utf8::read_stdin_scalar_or(1114112, 1114113, 1114114) != 65) {
        return 2;
    }
    if (std::io_utf8::read_stdin_scalar_or(1114112, 1114113, 1114114) != 1114113) {
        return 3;
    }
    if (std::io_utf8::read_stdin_scalar_or(1114112, 1114113, 1114114) != 1114113) {
        return 4;
    }
    if (std::io_utf8::read_stdin_scalar_or(1114112, 1114113, 1114114) != 1114113) {
        return 5;
    }
    if (std::io_utf8::read_stdin_scalar_or(1114112, 1114113, 1114114) != 66) {
        return 6;
    }
    if (std::io_utf8::read_stdin_scalar_or(1114112, 1114113, 1114114) != 1114112) {
        return 7;
    }
    return 0;
}
