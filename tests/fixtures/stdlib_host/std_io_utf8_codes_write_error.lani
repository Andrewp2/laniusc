module app::main;
import core::mem;
import std::io_utf8;

fn main() -> i32 {
    let bytes:[i32; 3] = [65, 194, 162];
    let view:[i32] = core::mem::i32_slice_from_raw_parts(core::mem::i32_array_data_ptr(bytes), 3);
    if (std::io_utf8::write_stdout_codes(view, 3)) {
        return 1;
    }
    return 0;
}
