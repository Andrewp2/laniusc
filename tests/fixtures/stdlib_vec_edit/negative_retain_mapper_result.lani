module app::main;
import alloc::vec;
import core::clone;
import core::cmp;
import core::iter;
import core::pair;
import core::result;
import core::clone_values;
struct Policy {}
impl Policy { fn borrow(&self) -> &Policy { return self; } }
pub impl core::iter::Mapper<i32,i32> for Policy { pub fn apply(&self,value:i32) -> i32 { return 1; } }
fn main() -> i32 {
    let rejected_edit_bound:alloc::vec::Vec<i32> =alloc::vec::new<i32>(); let policy:Policy=Policy {};
    rejected_edit_bound.retain_destroy(policy.borrow());
    return 0;
}
