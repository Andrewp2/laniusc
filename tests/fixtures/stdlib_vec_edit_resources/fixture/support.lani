module fixture::support;
import core::mem;
import std::io;
pub fn mark(value:i32) { let words:[i32;1] = [value]; assert(std::io::write_stderr(core::mem::i32_array_data_ptr(words),1)==1); }
pub fn publish(pointer:ptr,count:i32) {
    let used:i32 = 0; while(used<count) { let n:i32 = std::io::write_stdout(pointer+(used as usize),(count-used) as usize); assert(n>0 && n<=count-used); used+=n; }
}
pub fn word(value:i32) { let words:[i32;1] = [value]; publish(core::mem::i32_array_data_ptr(words),4); }
pub fn number(bytes:[u8],offset:i32,value:u64,width:i32) {
    let rest:u64 = value; let i:i32 = 0; while(i<width) { bytes[offset+i]=(rest%256) as u8; rest=rest/256; i+=1; }
}
