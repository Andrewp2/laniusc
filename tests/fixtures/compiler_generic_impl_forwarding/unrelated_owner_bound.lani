module app::main;
import core::io;
import core::result;

struct ReadOnly { marker: i32 }
pub impl ReadOnly { pub fn borrow(&self) -> &ReadOnly { return self; } }
pub impl core::io::Read for ReadOnly {
    pub fn read(&self, bytes: [u8], offset: i32, count: i32) -> core::result::Result<i32,core::io::Error> {
        return core::result::Ok(0);
    }
}
fn wrong_owner<A,B>(writer: &A, unrelated: &B, source: [u8])
    -> core::result::Result<i32,core::io::Failure> where B: core::io::Write {
    return core::io::write_all(writer,source,0,3);
}
fn main() -> i32 {
    let wrong: ReadOnly = ReadOnly { marker:23 };
    let source: [u8;3] = [0,128,255]; let output: [u8;3] = [77;3];
    let witness: core::io::SliceWriter = core::io::slice_writer(output,3).unwrap();
    let rejected: core::result::Result<i32,core::io::Failure> = wrong_owner(wrong.borrow(),witness.borrow(),source);
    return 0;
}
