// Test-only ordered AST construction and borrowed JSON byte-stream observations.
module app::main;
import alloc::string;
import core::io;
import core::mem;
import core::option;
import core::result;
import core::text;
import std::io;
import ext::json;

fn read_exact(pointer: ptr, count: i32, allow_eof: bool) -> bool {
    let done: i32 = 0;
    while (done < count) {
        let got: i32 = std::io::read_stdin(pointer + (done as usize), (count - done) as usize);
        assert(got >= 0);
        if (got == 0) { assert(allow_eof && done == 0); return false; }
        done += got;
    }
    return true;
}

fn write_all(pointer: ptr, count: i32) {
    let done: i32 = 0;
    while (done < count) {
        let got: i32 = std::io::write_stdout(pointer + (done as usize), (count - done) as usize);
        assert(got > 0);
        done += got;
    }
}

fn get64(bytes: [u8], offset: i32) -> u64 {
    let result: u64 = 0;
    let index: i32 = 0;
    while (index < 8) {
        result |= (bytes[offset + index] as u64) << (index * 8);
        index += 1;
    }
    return result;
}

struct Output { bytes:[u8],pointer:ptr,used:i32 }
impl Output {
    fn borrow(&self) -> &Output { return self; }
    fn flush(&self) { write_all(self.pointer,self.used); self.used=0; }
    fn byte(&self,value:u8) {
        if(self.used==4096) { self.flush(); }
        self.bytes[self.used]=value; self.used+=1;
    }
    fn word(&self,value:u64) {
        let index:i32=0;
        while(index<8) { self.byte(((value>>(index*8))&255) as u8); index+=1; }
    }
}
fn get32(bytes:[u8],offset:i32) -> i32 {
    let value:u32=0; let index:i32=0;
    while(index<4) { value|=(bytes[offset+index] as u32)<<(index*8); index+=1; }
    return value as i32;
}
fn error_code(error:ext::json::Error) -> i32 {
    let kind:i32=match(error.kind) { ext::json::ErrorKind::NoRoot -> 1, ext::json::ErrorKind::OutputLimit -> 2, _ -> 99 };
    return kind;
}
fn error_header(error:ext::json::Error,output:&Output) { output.word(error_code(error) as u64); output.word(0); output.word(error.offset as i64 as u64); }
fn success_header(amount:u64,output:&Output) { output.word(0); output.word(amount); output.word(0); }
fn owned_bytes(doc:ext::json::Document,output:&Output) {
    let result:core::result::Result<alloc::string::String,ext::json::Error> = ext::json::encode(doc);
    if(result.is_err()) { error_header(result.unwrap_err(),output); return; }
    let value:alloc::string::String=result.unwrap(); success_header(value.byte_len() as u64,output);
    let index:i32=0; while(index<value.byte_len()) { output.byte(value.byte_at(index).unwrap()); index+=1; } value.destroy();
}
fn text_bytes(value:core::text::Text,output:&Output) {
    output.word(value.length as u64); let index:i32=0;
    while(index<value.length) { output.byte(value.bytes[value.start+index]); index+=1; }
}
fn optional_id(value:core::option::Option<i32>) -> u64 { if(value.is_none()) { return 0; } return (value.unwrap()+1) as u64; }
fn snapshot(doc:&ext::json::Document,kinds:[i32],parents:[i32],output:&Output) {
    output.word(doc.node_count() as u64); let index:i32=0;
    while(index<doc.node_count()) {
        let actual:ext::json::Kind=doc.kind(index).unwrap();
        let kind:i32=match(actual) { ext::json::Kind::Null -> 0, ext::json::Kind::Boolean -> 1,
            ext::json::Kind::Number -> 2, ext::json::Kind::Text -> 3, ext::json::Kind::Array -> 4, ext::json::Kind::Object -> 5 };
        output.word(index as u64); output.word(kind as u64);
        let sibling:core::option::Option<i32> = doc.next_sibling(index).unwrap(); output.word(optional_id(sibling));
        if(kinds[index]==1 || kinds[index]==2) { if(doc.boolean(index).unwrap()) { output.word(1); } else { output.word(0); } }
        if(kinds[index]==3) { text_bytes(doc.number_view(index).unwrap(),output); }
        if(kinds[index]==4) { text_bytes(doc.string_view(index).unwrap(),output); }
        if(kinds[index]>=5) {
            output.word(doc.child_count(index).unwrap() as u64);
            let child:core::option::Option<i32> = doc.first_child(index).unwrap(); output.word(optional_id(child));
        }
        if(parents[index]>=0) { if(kinds[parents[index]]==6) { text_bytes(doc.key_view(index).unwrap(),output); } }
        index+=1;
    }
}
struct Readers { original:ext::json::Encoding,first:ext::json::Encoding,second:ext::json::Encoding,ordinal:i32 }
impl Readers {
    fn borrow(&self) -> &Readers { return self; }
    fn perform(&self,op:i32,offset:i32,count:i32,destination:[u8],output:&Output) -> i32 {
        let index:i32=0; while(index<64) { destination[index]=((157+index*13+self.ordinal*7)&255) as u8; index+=1; }
        output.byte(op as u8); let amount:i32=0;
        if(op>=2) {
            assert(op<=5);
            if(op==2) { self.second=self.first; }
            if(op==3) { self.first=self.second; }
            if(op==4) { self.first=self.original; }
            if(op==5) { self.second=self.original; }
            output.byte(2); output.word(0);
        } else {
            let result:core::result::Result<i32,core::io::Error> = core::result::Ok(0);
            if(op==0) { result=self.first.read(destination,offset,count); } else { result=self.second.read(destination,offset,count); }
            if(result.is_err()) {
                let cause:core::io::Error=result.unwrap_err(); let code:i32=match(cause) { core::io::Error::InvalidInput -> 1, _ -> 99 };
                output.byte(1); output.word(code as u64); amount=-1;
            } else { amount=result.unwrap(); output.byte(0); output.word(amount as i64 as u64); }
        }
        output.word(self.first.remaining()); output.word(self.second.remaining());
        index=0; while(index<64) { output.byte(destination[index]); index+=1; }
        self.ordinal+=1; return amount;
    }
}
fn exercise(seed:ext::json::Encoding,actions:[u8],count:i32,layout:i32,output:&Output) {
    let readers:Readers=Readers { original:seed,first:seed,second:seed,ordinal:0 };
    let native:[u8;64]=[0;64]; let packed:[i32;16]=[0;16]; let destination:[u8]=native;
    if(layout==1) { destination=core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(packed),64); }
    output.word(core::mem::slice_stride(destination) as i64 as u64);
    let index:i32=0;
    while(index<count) { readers.perform(get32(actions,index*12),get32(actions,index*12+4),get32(actions,index*12+8),destination,output); index+=1; }
    let sizes:[i32;4]=[1,7,13,31]; let cursor:i32=0;
    while(cursor<2) {
        let turn:i32=0; let ended:bool=false;
        while(!ended) {
            assert(turn<=4096); let got:i32=readers.perform(cursor,3,sizes[turn%4],destination,output);
            assert(got>=0); ended=got==0; turn+=1;
        }
        readers.perform(cursor,2147483647,0,destination,output); readers.perform(cursor,-1,0,destination,output);
        readers.perform(cursor,2,3,destination,output); cursor+=1;
    }
    readers.perform(2,0,0,destination,output); readers.perform(1,0,1,destination,output);
}
fn owned(body:[u8],offset:i32,length:i32) -> alloc::string::String {
    let view:core::text::Text=core::text::from_utf8_range(body,offset,length).unwrap();
    return alloc::string::from_text(view).unwrap();
}
fn run(header:[u8],body:[u8],actions:[u8],output:&Output) {
    let options:ext::json::Options=ext::json::default_options(); options.max_depth=256; options.max_nodes=128;
    options.max_string_bytes=8192; options.max_number_bytes=8192; options.max_output_bytes=get64(header,16) as i32;
    let doc:ext::json::Document=ext::json::with_options(options).unwrap();
    let kinds:[i32;128]=[0;128]; let parents:[i32;128]=[0;128]; let index:i32=0; let position:i32=0;
    while(index<get64(header,0) as i32) {
        assert(position+32<=get64(header,8) as i32);
        let kind:i32=get64(body,position) as i32; let parent:i32=get64(body,position+8) as i64 as i32;
        let key_length:i32=get64(body,position+16) as i32; let value_length:i32=get64(body,position+24) as i32;
        position+=32; assert(kind>=0 && kind<=6 && parent<index && key_length>=0 && value_length>=0);
        assert(position+key_length+value_length<=get64(header,8) as i32);
        let key:alloc::string::String=owned(body,position,key_length); position+=key_length;
        let value:alloc::string::String=owned(body,position,value_length); position+=value_length;
        let at:ext::json::At=ext::json::At::Root;
        if(index>0) { assert(parent>=0); if(kinds[parent]==6) { at=ext::json::At::Member(parent,key); } else { assert(kinds[parent]==5); at=ext::json::At::Element(parent); } }
        let added:core::result::Result<i32,ext::json::Error> = core::result::Ok(-1);
        if(kind==0) { added=doc.add_null(at); }
        if(kind==1 || kind==2) { added=doc.add_bool(at,kind==2); }
        if(kind==3) { added=doc.add_number(at,value); }
        if(kind==4) { added=doc.add_string(at,value); }
        if(kind==5) { added=doc.add_array(at); }
        if(kind==6) { added=doc.add_object(at); }
        assert(added.unwrap()==index); kinds[index]=kind; parents[index]=parent;
        key.destroy(); value.destroy(); index+=1;
    }
    assert(position==get64(header,8) as i32);
    let measured:core::result::Result<u64,ext::json::Error> = doc.encoded_len();
    if(measured.is_err()) { error_header(measured.unwrap_err(),output); } else { success_header(measured.unwrap(),output); }
    let prepared:core::result::Result<ext::json::Encoding,ext::json::Error> = doc.encoding();
    if(prepared.is_err()) { error_header(prepared.unwrap_err(),output); }
    else { let reader:ext::json::Encoding=prepared.unwrap(); success_header(reader.remaining(),output); }
    owned_bytes(doc,output);
    if(prepared.is_ok()) { exercise(prepared.unwrap(),actions,get64(header,32) as i32,get64(header,24) as i32,output); }
    snapshot(doc.borrow(),kinds,parents,output); owned_bytes(doc,output); doc.destroy();
}
fn main() -> i32 {
    let header_words:[i32;10]=[0;10]; let header_pointer:ptr=core::mem::i32_array_data_ptr(header_words);
    let header:[u8]=core::mem::typed_slice_from_raw_parts<u8>(header_pointer,40);
    let body_words:[i32;4096]=[0;4096]; let body_pointer:ptr=core::mem::i32_array_data_ptr(body_words);
    let body:[u8]=core::mem::typed_slice_from_raw_parts<u8>(body_pointer,16384);
    let action_words:[i32;144]=[0;144]; let action_pointer:ptr=core::mem::i32_array_data_ptr(action_words);
    let actions:[u8]=core::mem::typed_slice_from_raw_parts<u8>(action_pointer,576);
    let output_words:[i32;1024]=[0;1024]; let output_pointer:ptr=core::mem::i32_array_data_ptr(output_words);
    let output:Output=Output { bytes:core::mem::typed_slice_from_raw_parts<u8>(output_pointer,4096),pointer:output_pointer,used:0 };
    while(read_exact(header_pointer,40,true)) {
        assert(get64(header,0)<=128 && get64(header,8)<=16384 && get64(header,16)<=8192 && get64(header,24)<=1 && get64(header,32)<=48);
        assert(read_exact(body_pointer,get64(header,8) as i32,false));
        assert(read_exact(action_pointer,12*(get64(header,32) as i32),false));
        run(header,body,actions,output.borrow());
    }
    output.flush(); return 0;
}
