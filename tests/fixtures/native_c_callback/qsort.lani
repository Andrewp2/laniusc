// A Lanius function passed to libc's qsort as its C comparator. Naming a
// function as a value gives the address of its System V entry, a `ptr`.
// Exits 0 when the eight values come back in ascending order.
module app::main;

import core::mem;

extern "C" fn qsort(base: ptr, count: usize, size: usize, compare: ptr);

fn compare_i32(left: ptr, right: ptr) -> i32 {
    let a: [i32] = core::mem::typed_slice_from_raw_parts(left, 1);
    let b: [i32] = core::mem::typed_slice_from_raw_parts(right, 1);
    if (a[0] < b[0]) { return -1; }
    if (a[0] > b[0]) { return 1; }
    return 0;
}

fn main() -> i32 {
    let values: [i32; 8] = [5, -3, 9, 0, 7, 2, -8, 4];
    let data: ptr = core::mem::i32_array_data_ptr(values);
    qsort(data, 8, 4, compare_i32);
    let sorted: [i32] = core::mem::typed_slice_from_raw_parts(data, 8);
    let expected: [i32; 8] = [-8, -3, 0, 2, 4, 5, 7, 9];
    let i: i32 = 0;
    while (i < 8) {
        if (sorted[i] != expected[i]) { return 1 + i; }
        i += 1;
    }
    return 0;
}
