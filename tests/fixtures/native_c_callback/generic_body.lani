// Taking an ordinary function's address inside two generic instances must
// preserve its C entry, even when those instances lower in separate batches.
module app::main;

extern "C" fn putchar(character: i32) -> i32;

fn callback(first: ptr, second: ptr, third: ptr) {
    putchar(65);
}

fn keep<T>(value: T) -> T {
    let entry: ptr = callback;
    call_ptr(entry, 0, 0, 0);
    return value;
}

fn main() -> i32 {
    let value: i32 = keep(42);
    if (keep(false) || value != 42) { return 1; }
    return 0;
}
