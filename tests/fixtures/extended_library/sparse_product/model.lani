// Test-only batch transport. Header8i32:m,k,n,nnzA,nnzB,layout,entrycap,reserved.
// Then A/B offsets(i32),columns(i32),values(f64), in that order for each CSR.
// Output6u64:status,row,entry,rows,cols,nnz; success adds offsets,columns,f64bits.
module app::main;
import core::f64;
import core::mem;
import core::result;
import core::slice;
import ext::sparse;
import ext::sparse_matrix;
import ext::sparse_ops;
import std::io;
fn read_exact(pointer:ptr,count:i32,eof:bool) -> bool { let done:i32=0; while(done<count) { let got:i32=std::io::read_stdin(pointer+(done as usize),(count-done) as usize); assert(got>=0); if(got==0) { assert(eof && done==0); return false; } done+=got; } return true; }
fn write_all(pointer:ptr,count:i32) { let done:i32=0; while(done<count) { let got:i32=std::io::write_stdout(pointer+(done as usize),(count-done) as usize); assert(got>0); done+=got; } }
fn get32(bytes:[u8],offset:i32) -> i32 { let value:u32=0; let i:i32=0; while(i<4) { value|=(bytes[offset+i] as u32)<<(i*8); i+=1; } return value as i32; }
fn get64(bytes:[u8],offset:i32) -> u64 { let value:u64=0; let i:i32=0; while(i<8) { value|=(bytes[offset+i] as u64)<<(i*8); i+=1; } return value; }
struct Output { bytes:[u8], pointer:ptr, used:i32 }
impl Output { fn borrow(&self) -> &Output { return self; } fn flush(&self) { write_all(self.pointer,self.used); self.used=0; } fn word(&self,value:u64) { if(self.used==4096) { self.flush(); } let i:i32=0; while(i<8) { self.bytes[self.used+i]=((value>>(i*8))&255) as u8; i+=1; } self.used+=8; } }
fn code(error:ext::sparse::Error) -> i32 { return match(error.kind) { ext::sparse::ErrorKind::InvalidLimits->1,ext::sparse::ErrorKind::Shape->2,ext::sparse::ErrorKind::Bounds->3,ext::sparse::ErrorKind::DimensionLimit->4,ext::sparse::ErrorKind::EntryLimit->5,ext::sparse::ErrorKind::WorkLimit->6,ext::sparse::ErrorKind::Offset->7,ext::sparse::ErrorKind::Column->8,ext::sparse::ErrorKind::Order->9,ext::sparse::ErrorKind::NonFinite->10,ext::sparse::ErrorKind::NumericalFailure->11,ext::sparse::ErrorKind::AllocationFailed->12 }; }
fn run(bytes:[u8],output:&Output) {
 let m:i32=get32(bytes,0); let k:i32=get32(bytes,4); let n:i32=get32(bytes,8); let na:i32=get32(bytes,12); let nb:i32=get32(bytes,16); let layout:i32=get32(bytes,20); let cap:i32=get32(bytes,24);
 let oa:[i32;11]=[-777;11]; let ob:[i32;11]=[-777;11]; let ca:[i32;66]=[-777;66]; let cb:[i32;66]=[-777;66]; let native_a:[f64;66]=[12345.0;66]; let native_b:[f64;66]=[12345.0;66]; let storage_a_words:[i32;132]=[0;132]; let storage_b_words:[i32;132]=[0;132]; let storage_a:[f64]=core::mem::typed_slice_from_storage<f64>(core::mem::i32_array_data_ptr(storage_a_words),66); let storage_b:[f64]=core::mem::typed_slice_from_storage<f64>(core::mem::i32_array_data_ptr(storage_b_words),66); assert(core::mem::slice_stride(native_a)<0 && core::mem::slice_stride(storage_a)==-8);
 let va:[f64]=native_a; let vb:[f64]=native_b; if(layout==1) { va=storage_a; vb=storage_b; } let i:i32=0; while(i<66) { va[i]=12345.0; vb[i]=12345.0; i+=1; }
 let cursor:i32=32; let a_offsets:i32=cursor; i=0; while(i<=m) { oa[i+1]=get32(bytes,cursor); cursor+=4; i+=1; } let a_columns:i32=cursor; i=0; while(i<na) { ca[i+1]=get32(bytes,cursor); cursor+=4; i+=1; } let a_values:i32=cursor; i=0; while(i<na) { va[i+1]=core::f64::from_bits(get64(bytes,cursor)); cursor+=8; i+=1; }
 let b_offsets:i32=cursor; i=0; while(i<=k) { ob[i+1]=get32(bytes,cursor); cursor+=4; i+=1; } let b_columns:i32=cursor; i=0; while(i<nb) { cb[i+1]=get32(bytes,cursor); cursor+=4; i+=1; } let b_values:i32=cursor; i=0; while(i<nb) { vb[i+1]=core::f64::from_bits(get64(bytes,cursor)); cursor+=8; i+=1; }
 let av:ext::sparse::CsrView=ext::sparse::CsrView { rows:m,cols:k,offsets:core::slice::view_range(oa,1,m+1).unwrap(),columns:core::slice::view_range(ca,1,na).unwrap(),values:core::slice::view_range(va,1,na).unwrap() }; let bv:ext::sparse::CsrView=ext::sparse::CsrView { rows:k,cols:n,offsets:core::slice::view_range(ob,1,k+1).unwrap(),columns:core::slice::view_range(cb,1,nb).unwrap(),values:core::slice::view_range(vb,1,nb).unwrap() };
 let limits:ext::sparse::Limits=ext::sparse::default_limits(); limits.max_entries=cap;
 let result:core::result::Result<ext::sparse_matrix::Matrix,ext::sparse::Error> =ext::sparse_ops::matmul(av,bv,limits);
 if(result.is_err()) { let error:ext::sparse::Error=result.unwrap_err(); output.word(code(error) as u64); output.word(error.row as u64); output.word(error.entry as u64); output.word(0); output.word(0); output.word(0); }
 else { let owner:ext::sparse_matrix::Matrix=result.unwrap(); let value:ext::sparse::CsrView=owner.view(); let entries:i32=value.values.len(); output.word(0); output.word((-1) as u64); output.word((-1) as u64); output.word(value.rows as u64); output.word(value.cols as u64); output.word(entries as u64); i=0; while(i<=value.rows) { output.word(value.offsets.get(i).unwrap() as u64); i+=1; } i=0; while(i<entries) { output.word(value.columns.get(i).unwrap() as u64); i+=1; } i=0; while(i<entries) { let element:f64=value.values.get(i).unwrap(); assert(core::f64::is_finite(element) && element!=0.0); output.word(core::f64::to_bits(element)); i+=1; } owner.destroy(); }
 i=0; while(i<=m) { assert(oa[i+1]==get32(bytes,a_offsets+i*4)); i+=1; } i=0; while(i<=k) { assert(ob[i+1]==get32(bytes,b_offsets+i*4)); i+=1; } i=0; while(i<na) { assert(ca[i+1]==get32(bytes,a_columns+i*4) && core::f64::to_bits(va[i+1])==get64(bytes,a_values+i*8)); i+=1; } i=0; while(i<nb) { assert(cb[i+1]==get32(bytes,b_columns+i*4) && core::f64::to_bits(vb[i+1])==get64(bytes,b_values+i*8)); i+=1; }
 assert(oa[0]==-777 && oa[m+2]==-777 && ob[0]==-777 && ob[k+2]==-777 && ca[0]==-777 && ca[na+1]==-777 && cb[0]==-777 && cb[nb+1]==-777 && va[0]==12345.0 && va[na+1]==12345.0 && vb[0]==12345.0 && vb[nb+1]==12345.0);
}
fn main() -> i32 {
 let input_words:[i32;1024]=[0;1024]; let pointer:ptr=core::mem::i32_array_data_ptr(input_words); let bytes:[u8]=core::mem::typed_slice_from_raw_parts<u8>(pointer,4096); let output_words:[i32;1024]=[0;1024]; let output_ptr:ptr=core::mem::i32_array_data_ptr(output_words); let output_bytes:[u8]=core::mem::typed_slice_from_raw_parts<u8>(output_ptr,4096); let output:Output=Output { bytes:output_bytes,pointer:output_ptr,used:0 };
 while(read_exact(pointer,32,true)) { let m:i32=get32(bytes,0); let k:i32=get32(bytes,4); let n:i32=get32(bytes,8); let na:i32=get32(bytes,12); let nb:i32=get32(bytes,16); let layout:i32=get32(bytes,20); let cap:i32=get32(bytes,24); assert(m>=0 && m<=8 && k>=0 && k<=8 && n>=0 && n<=8 && na>=0 && na<=64 && nb>=0 && nb<=64 && layout>=0 && layout<=1 && cap>=0); let count:i32=(m+k+2)*4+(na+nb)*12; assert(read_exact(pointer+32,count,false)); run(bytes,output.borrow()); }
 output.flush(); return 0;
}
