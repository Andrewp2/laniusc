module app::main;
import core::result;
import alloc::big_uint;
fn main() -> i32 {
    let limits: alloc::big_uint::Limits = alloc::big_uint::default_limits();
    let a: alloc::big_uint::BigUint = alloc::big_uint::from_u64(18446744073709551615,limits).unwrap();
    let b: alloc::big_uint::BigUint = alloc::big_uint::from_u64(4294967297,limits).unwrap();
    let sum: alloc::big_uint::BigUint = a.add(b.borrow(),limits).unwrap();
    let product: alloc::big_uint::BigUint = sum.mul(a.borrow(),limits).unwrap();
    let pair: alloc::big_uint::DivRem = product.div_rem(sum.borrow(),limits).unwrap();
    assert(pair.quotient.compare(a.borrow()) == 0 && pair.remainder.is_zero());
    pair.destroy(); product.destroy(); sum.destroy(); a.destroy(); b.destroy(); return 0;
}
