// Test-only binary adapter. Header:8little-endian i32s op,m,n,p,na,nb,nt,layout;
// one f64 factor; then A/B offsets,columns,values,triplets,row/col factors,x,
// dense A and dense B. Output:u64 status,row,entry,completed,tag,m,n,count;
// CSR tag0 adds offsets,columns,floatbits; dense tag1 adds floatbits.
module app::main;
import alloc::vec;
import core::f64;
import core::mem;
import core::option;
import core::result;
import core::slice;
import ext::linalg;
import ext::sparse;
import ext::sparse_matrix;
import ext::sparse_ops;
import std::io;
fn read_exact(pointer:ptr,count:i32,eof:bool) -> bool { let done:i32=0; while(done<count) { let got:i32=std::io::read_stdin(pointer+(done as usize),(count-done) as usize); assert(got>=0); if(got==0) { assert(eof && done==0); return false; } done+=got; } return true; }
fn write_all(pointer:ptr,count:i32) { let done:i32=0; while(done<count) { let got:i32=std::io::write_stdout(pointer+(done as usize),(count-done) as usize); assert(got>0); done+=got; } }
fn get32(bytes:[u8],offset:i32) -> i32 { let value:u32=0; let i:i32=0; while(i<4) { value|=(bytes[offset+i] as u32)<<(i*8); i+=1; } return value as i32; }
fn get64(bytes:[u8],offset:i32) -> u64 { let value:u64=0; let i:i32=0; while(i<8) { value|=(bytes[offset+i] as u64)<<(i*8); i+=1; } return value; }
struct Output { bytes:[u8], pointer:ptr, used:i32 }
impl Output { fn borrow(&self) -> &Output { return self; } fn flush(&self) { write_all(self.pointer,self.used); self.used=0; } fn word(&self,value:u64) { if(self.used==4096) { self.flush(); } let i:i32=0; while(i<8) { self.bytes[self.used+i]=((value>>(i*8))&255) as u8; i+=1; } self.used+=8; } }
fn code(error:ext::sparse::Error) -> i32 { return match(error.kind) { ext::sparse::ErrorKind::InvalidLimits->1,ext::sparse::ErrorKind::Shape->2,ext::sparse::ErrorKind::Bounds->3,ext::sparse::ErrorKind::DimensionLimit->4,ext::sparse::ErrorKind::EntryLimit->5,ext::sparse::ErrorKind::WorkLimit->6,ext::sparse::ErrorKind::Offset->7,ext::sparse::ErrorKind::Column->8,ext::sparse::ErrorKind::Order->9,ext::sparse::ErrorKind::NonFinite->10,ext::sparse::ErrorKind::NumericalFailure->11,ext::sparse::ErrorKind::AllocationFailed->12 }; }
fn header(output:&Output,status:i32,row:i32,entry:i32,completed:i32,tag:i32,m:i32,n:i32,count:i32) { output.word(status as u64); output.word(row as u64); output.word(entry as u64); output.word(completed as u64); output.word(tag as u64); output.word(m as u64); output.word(n as u64); output.word(count as u64); }
fn failure(output:&Output,error:ext::sparse::Error) { header(output,code(error),error.row,error.entry,-1,2,0,0,0); }
fn csr(output:&Output,value:ext::sparse::CsrView) { let count:i32=value.values.len(); header(output,0,-1,-1,-1,0,value.rows,value.cols,count); let i:i32=0; while(i<=value.rows) { output.word(value.offsets.get(i).unwrap() as u64); i+=1; } i=0; while(i<count) { output.word(value.columns.get(i).unwrap() as u64); i+=1; } i=0; while(i<count) { output.word(core::f64::to_bits(value.values.get(i).unwrap())); i+=1; } }
fn owned(output:&Output,result:core::result::Result<ext::sparse_matrix::Matrix,ext::sparse::Error>) { if(result.is_err()) { failure(output,result.unwrap_err()); return; } let owner:ext::sparse_matrix::Matrix=result.unwrap(); let view:ext::sparse::CsrView=owner.view(); csr(output,view); owner.destroy(); }
fn dense(output:&Output,result:core::result::Result<ext::linalg::Matrix,ext::sparse::Error>) { if(result.is_err()) { failure(output,result.unwrap_err()); return; } let owner:ext::linalg::Matrix=result.unwrap(); let view:ext::linalg::MatrixView=owner.view(); header(output,0,-1,-1,-1,1,view.rows,view.cols,view.rows*view.cols); let r:i32=0; while(r<view.rows) { let c:i32=0; while(c<view.cols) { let value:core::result::Result<f64,ext::linalg::Error> =view.get(r,c); output.word(core::f64::to_bits(value.unwrap())); c+=1; } r+=1; } owner.destroy(); }
fn run(bytes:[u8],output:&Output) {
 let op:i32=get32(bytes,0); let m:i32=get32(bytes,4); let n:i32=get32(bytes,8); let p:i32=get32(bytes,12); let na:i32=get32(bytes,16); let nb:i32=get32(bytes,20); let nt:i32=get32(bytes,24); let layout:i32=get32(bytes,28); let factor:f64=core::f64::from_bits(get64(bytes,32));
 let oa:[i32;11]=[-777;11]; let ob:[i32;11]=[-777;11]; let ca:[i32;66]=[-777;66]; let cb:[i32;66]=[-777;66]; let native_a:[f64;66]=[12345.0;66]; let native_b:[f64;66]=[12345.0;66]; let storage_a_words:[i32;132]=[0;132]; let storage_b_words:[i32;132]=[0;132]; let storage_a:[f64]=core::mem::typed_slice_from_storage<f64>(core::mem::i32_array_data_ptr(storage_a_words),66); let storage_b:[f64]=core::mem::typed_slice_from_storage<f64>(core::mem::i32_array_data_ptr(storage_b_words),66); assert(core::mem::slice_stride(native_a)<0 && core::mem::slice_stride(storage_a)==-8);
 let va:[f64]=native_a; let vb:[f64]=native_b; if(layout==1) { va=storage_a; vb=storage_b; } let i:i32=0; while(i<66) { va[i]=12345.0; vb[i]=12345.0; i+=1; }
 let cursor:i32=40; let a_offsets:i32=cursor; i=0; while(i<=m) { oa[i+1]=get32(bytes,cursor); cursor+=4; i+=1; } let a_columns:i32=cursor; i=0; while(i<na) { ca[i+1]=get32(bytes,cursor); cursor+=4; i+=1; } let a_values:i32=cursor; i=0; while(i<na) { va[i+1]=core::f64::from_bits(get64(bytes,cursor)); cursor+=8; i+=1; }
 let b_offsets:i32=cursor; i=0; while(i<=m) { ob[i+1]=get32(bytes,cursor); cursor+=4; i+=1; } let b_columns:i32=cursor; i=0; while(i<nb) { cb[i+1]=get32(bytes,cursor); cursor+=4; i+=1; } let b_values:i32=cursor; i=0; while(i<nb) { vb[i+1]=core::f64::from_bits(get64(bytes,cursor)); cursor+=8; i+=1; }
 let blank:ext::sparse::Triplet=ext::sparse::Triplet { row:0,column:0,value:0.0 }; let triplets:[ext::sparse::Triplet;64]=[blank;64]; let triplet_start:i32=cursor; i=0; while(i<nt) { triplets[i]=ext::sparse::Triplet { row:get32(bytes,cursor),column:get32(bytes,cursor+4),value:core::f64::from_bits(get64(bytes,cursor+8)) }; cursor+=16; i+=1; }
 let rows:[f64;8]=[0.0;8]; let columns:[f64;8]=[0.0;8]; let vector:[f64;8]=[0.0;8]; let dense_a:[f64;64]=[0.0;64]; let dense_b:[f64;64]=[0.0;64]; let factors_start:i32=cursor;
 i=0; while(i<m) { rows[i]=core::f64::from_bits(get64(bytes,cursor)); cursor+=8; i+=1; } i=0; while(i<n) { columns[i]=core::f64::from_bits(get64(bytes,cursor)); cursor+=8; i+=1; } i=0; while(i<n) { vector[i]=core::f64::from_bits(get64(bytes,cursor)); cursor+=8; i+=1; } i=0; while(i<m*n) { dense_a[i]=core::f64::from_bits(get64(bytes,cursor)); cursor+=8; i+=1; } i=0; while(i<n*p) { dense_b[i]=core::f64::from_bits(get64(bytes,cursor)); cursor+=8; i+=1; }
 let limits:ext::sparse::Limits=ext::sparse::default_limits(); let av:ext::sparse::CsrView=ext::sparse::view(m,n,core::slice::view_range(oa,1,m+1).unwrap(),core::slice::view_range(ca,1,na).unwrap(),core::slice::view_range(va,1,na).unwrap(),limits).unwrap(); let bv:ext::sparse::CsrView=ext::sparse::view(m,n,core::slice::view_range(ob,1,m+1).unwrap(),core::slice::view_range(cb,1,nb).unwrap(),core::slice::view_range(vb,1,nb).unwrap(),limits).unwrap();
 if(op==0) { owned(output,ext::sparse_matrix::from_csr(av,limits)); }
 if(op==1) { owned(output,ext::sparse_matrix::from_triplets(m,n,core::slice::view(triplets,nt).unwrap(),limits)); }
 if(op==2) { let base:ext::sparse_matrix::Matrix=ext::sparse_matrix::from_csr(av,limits).unwrap(); let copy:core::result::Result<ext::sparse_matrix::Matrix,ext::sparse::Error> =base.try_clone(limits); base.destroy(); owned(output,copy); }
 if(op==3) { owned(output,ext::sparse_matrix::transpose(av,limits)); }
 if(op==4) { let first:ext::sparse_matrix::Matrix=ext::sparse_matrix::transpose(av,limits).unwrap(); let view:ext::sparse::CsrView=first.view(); let second:core::result::Result<ext::sparse_matrix::Matrix,ext::sparse::Error> =ext::sparse_matrix::transpose(view,limits); first.destroy(); owned(output,second); }
 if(op==5) { owned(output,ext::sparse_ops::add(av,bv,limits)); }
 if(op==6) { owned(output,ext::sparse_ops::sub(av,bv,limits)); }
 if(op==7) { owned(output,ext::sparse_ops::scale(av,factor,limits)); }
 if(op==8) { owned(output,ext::sparse_ops::scale_rows(av,core::slice::view(rows,m).unwrap(),limits)); }
 if(op==9) { owned(output,ext::sparse_ops::scale_columns(av,core::slice::view(columns,n).unwrap(),limits)); }
 if(op==10) { let result:core::result::Result<alloc::vec::Vec<f64>,ext::sparse::Error> =ext::sparse_ops::matvec(av,core::slice::view(vector,n).unwrap(),limits); if(result.is_err()) { failure(output,result.unwrap_err()); } else { let owner:alloc::vec::Vec<f64> =result.unwrap(); header(output,0,-1,-1,-1,1,m,1,m); i=0; while(i<m) { output.word(core::f64::to_bits(owner.get(i).unwrap())); i+=1; } owner.destroy(); } }
 if(op==11) { dense(output,ext::sparse_ops::to_dense(av,limits)); }
 if(op==12) { let view:ext::linalg::MatrixView=ext::linalg::row_major(dense_a,m*n,m,n).unwrap(); owned(output,ext::sparse_ops::from_dense(view,limits)); }
 if(op==13) { let view:ext::linalg::MatrixView=ext::linalg::row_major(dense_b,n*p,n,p).unwrap(); dense(output,ext::sparse_ops::matmul_dense(av,view,limits)); }
 if(op==14) { let values:[f64;10]=[12345.0;10]; let destination:core::slice::View<f64> =core::slice::view_range(values,1,m).unwrap(); let result:core::result::Result<i32,ext::sparse::ProductFailure> =ext::sparse::matvec_into(av,core::slice::view(vector,n).unwrap(),destination,limits); if(result.is_err()) { let error:ext::sparse::ProductFailure=result.unwrap_err(); header(output,code(error.error),error.error.row,error.error.entry,error.completed,1,m,1,m); } else { header(output,0,-1,-1,result.unwrap(),1,m,1,m); } i=0; while(i<m) { output.word(core::f64::to_bits(values[i+1])); i+=1; } assert(values[0]==12345.0 && values[m+1]==12345.0); }
 if(op==15) { header(output,0,-1,-1,-1,1,m,n,m*n); let r:i32=0; while(r<m) { let row:ext::sparse::Row=ext::sparse::row(av,r,limits).unwrap(); assert(row.columns.len()==oa[r+2]-oa[r+1] && row.values.len()==row.columns.len()); let j:i32=0; while(j<row.columns.len()) { assert(row.columns.get(j).unwrap()==ca[oa[r+1]+j+1] && core::f64::to_bits(row.values.get(j).unwrap())==core::f64::to_bits(va[oa[r+1]+j+1])); j+=1; } let c:i32=0; while(c<n) { let value:core::result::Result<f64,ext::sparse::Error> =ext::sparse::get(av,r,c,limits); output.word(core::f64::to_bits(value.unwrap())); c+=1; } r+=1; } }
 if(op==16) { owned(output,ext::sparse_matrix::zeros(m,n,limits)); }
 i=0; while(i<=m) { assert(oa[i+1]==get32(bytes,a_offsets+i*4) && ob[i+1]==get32(bytes,b_offsets+i*4)); i+=1; } i=0; while(i<na) { assert(ca[i+1]==get32(bytes,a_columns+i*4) && core::f64::to_bits(va[i+1])==get64(bytes,a_values+i*8)); i+=1; } i=0; while(i<nb) { assert(cb[i+1]==get32(bytes,b_columns+i*4) && core::f64::to_bits(vb[i+1])==get64(bytes,b_values+i*8)); i+=1; }
 i=0; while(i<nt) { assert(triplets[i].row==get32(bytes,triplet_start+i*16) && triplets[i].column==get32(bytes,triplet_start+i*16+4) && core::f64::to_bits(triplets[i].value)==get64(bytes,triplet_start+i*16+8)); i+=1; }
 cursor=factors_start; i=0; while(i<m) { assert(core::f64::to_bits(rows[i])==get64(bytes,cursor)); cursor+=8; i+=1; } i=0; while(i<n) { assert(core::f64::to_bits(columns[i])==get64(bytes,cursor)); cursor+=8; i+=1; } i=0; while(i<n) { assert(core::f64::to_bits(vector[i])==get64(bytes,cursor)); cursor+=8; i+=1; } i=0; while(i<m*n) { assert(core::f64::to_bits(dense_a[i])==get64(bytes,cursor)); cursor+=8; i+=1; } i=0; while(i<n*p) { assert(core::f64::to_bits(dense_b[i])==get64(bytes,cursor)); cursor+=8; i+=1; }
 assert(oa[0]==-777 && oa[m+2]==-777 && ob[0]==-777 && ob[m+2]==-777 && ca[0]==-777 && ca[na+1]==-777 && cb[0]==-777 && cb[nb+1]==-777 && va[0]==12345.0 && va[na+1]==12345.0 && vb[0]==12345.0 && vb[nb+1]==12345.0);
}
fn main() -> i32 {
 let input_words:[i32;2048]=[0;2048]; let pointer:ptr=core::mem::i32_array_data_ptr(input_words); let bytes:[u8]=core::mem::typed_slice_from_raw_parts<u8>(pointer,8192); let output_words:[i32;1024]=[0;1024]; let output_ptr:ptr=core::mem::i32_array_data_ptr(output_words); let output_bytes:[u8]=core::mem::typed_slice_from_raw_parts<u8>(output_ptr,4096); let output:Output=Output { bytes:output_bytes,pointer:output_ptr,used:0 };
 while(read_exact(pointer,40,true)) { let op:i32=get32(bytes,0); let m:i32=get32(bytes,4); let n:i32=get32(bytes,8); let p:i32=get32(bytes,12); let na:i32=get32(bytes,16); let nb:i32=get32(bytes,20); let nt:i32=get32(bytes,24); let layout:i32=get32(bytes,28); assert(op>=0 && op<=16 && m>=0 && m<=8 && n>=0 && n<=8 && p>=0 && p<=8 && na>=0 && na<=64 && nb>=0 && nb<=64 && nt>=0 && nt<=64 && layout>=0 && layout<=1); let length:i32=(m+1)*8+(na+nb)*12+nt*16+m*8+n*16+m*n*8+n*p*8; assert(length<=8152 && read_exact(pointer+40,length,false)); run(bytes,output.borrow()); }
 output.flush(); return 0;
}
