        offsets:core::slice::View { values:unread_i,start:0,length:1 },
        columns:core::slice::View { values:unread_i,start:0,length:268435456 },
        values:core::slice::View { values:unread_f,start:0,length:268435456 } };
    rejected(ext::sparse_matrix::from_csr(poison,wide),5);
    // A zero-row matrix still requires inspection of every logical vector
    // element. Admit that work before attempting to inspect its backing.
    let empty:ext::sparse::CsrView=csr(0,3,off,col,vals,0);
    let unread_vector:core::slice::View<f64> =core::slice::View { values:unread_f,start:0,length:3 };
    tight=limits; tight.max_work=1;
    let denied_vector:core::result::Result<alloc::vec::Vec<f64>,ext::sparse::Error> =ext::sparse_ops::matvec(empty,unread_vector,tight);
    assert(denied_vector.is_err() && kind(denied_vector.unwrap_err())==6);
    rejected(ext::sparse_ops::scale_columns(empty,unread_vector,tight),6);
    tight=limits; tight.max_work=11; rejected(ext::sparse_matrix::from_csr(a,tight),6);
    tight.max_work=12; let admitted:ext::sparse_matrix::Matrix=ext::sparse_matrix::from_csr(a,tight).unwrap(); admitted.destroy();
    tight.max_work=27; rejected(ext::sparse_matrix::transpose(a,tight),6);
    tight.max_work=28; let transposed:ext::sparse_matrix::Matrix=ext::sparse_matrix::transpose(a,tight).unwrap(); transposed.destroy();
    rejected(ext::sparse_ops::scale(a,core::f64::nan(),limits),10);
    let factors:[f64;3]=[1.0,2.0,core::f64::nan()]; rejected(ext::sparse_ops::scale_columns(a,core::slice::view(factors,3).unwrap(),limits),10);
    assert(ext::sparse_ops::scale_rows(a,core::slice::view(factors,1).unwrap(),limits).is_err());
    let wrong:ext::sparse::CsrView=a; wrong.cols=2; rejected(ext::sparse_ops::add(a,wrong,limits),2); rejected(ext::sparse_ops::sub(a,wrong,limits),2);
    let wrong_x:[f64;2]=[1.0,2.0]; assert(ext::sparse_ops::matvec(a,core::slice::view(wrong_x,2).unwrap(),limits).is_err());
    vals[1]=core::f64::MAX; rejected(ext::sparse_ops::scale(a,2.0,limits),11); rejected(ext::sparse_ops::add(a,a,limits),11);
    let x:[f64;3]=[1.0,2.0,3.0]; let failed:core::result::Result<alloc::vec::Vec<f64>,ext::sparse::Error> =ext::sparse_ops::matvec(a,core::slice::view(x,3).unwrap(),limits); assert(failed.is_err() && kind(failed.unwrap_err())==11);
    let data:[f64;4]=[1.0,2.0,3.0,4.0]; let bad_dense:ext::linalg::MatrixView=ext::linalg::row_major(data,4,2,2).unwrap(); assert(ext::sparse_ops::matmul_dense(a,bad_dense,limits).is_err());
    let explosive_data:[f64;3]=[1.0,2.0,0.0]; let explosive:ext::linalg::MatrixView=ext::linalg::row_major(explosive_data,3,3,1).unwrap();
    let failed_dense:core::result::Result<ext::linalg::Matrix,ext::sparse::Error> =ext::sparse_ops::matmul_dense(a,explosive,limits); assert(failed_dense.is_err() && kind(failed_dense.unwrap_err())==11);
    data[0]=core::f64::infinity(); rejected(ext::sparse_ops::from_dense(bad_dense,limits),10);
