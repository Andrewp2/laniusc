module app::main;
import core::mem;
import core::result;
import core::slice;
import core::text;
import ext::unicode_normalize;

fn text(value: str, length: i32) -> core::text::Text {
    let bytes: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::string_data_ptr(value),length);
    return core::result::unwrap(core::text::from_utf8(bytes,length));
}
fn code(error: ext::unicode_normalize::Error) -> i32 {
    return match(error) {
        ext::unicode_normalize::Error::Bounds -> 1,
        ext::unicode_normalize::Error::InvalidUtf8(position) -> 1000 + position,
        ext::unicode_normalize::Error::SizeOverflow -> 2,
        ext::unicode_normalize::Error::ScratchCapacity(required) -> 100 + required,
        ext::unicode_normalize::Error::OutputCapacity(required) -> 200 + required,
        ext::unicode_normalize::Error::WorkLimit(used) -> 3
    };
}
fn main() -> i32 {
    let input: core::text::Text = text("Å",3);
    let store: [u8;40] = [77;40];
    let work: [u32;40] = [999;40];
    let output: core::slice::View<u8> = core::result::unwrap(core::slice::view_range(store,2,36));
    let scratch: core::slice::View<u32> = core::result::unwrap(core::slice::view_range(work,2,36));
    let form: ext::unicode_normalize::Form = ext::unicode_normalize::Form::Nfc;
    assert(core::result::unwrap(ext::unicode_normalize::scratch_len(input,form,1000)) == 2);
    let result: ext::unicode_normalize::Normalized = core::result::unwrap(ext::unicode_normalize::normalize_into(input,form,output,scratch,1000));
    assert(result.bytes == 2 && result.scalars == 1 && result.scratch == 2);
    assert(store[2] == 195 && store[3] == 133 && store[4] == 77);
    assert(work[0] == 999 && work[1] == 999 && work[38] == 999 && work[39] == 999);
    assert(!core::result::unwrap(ext::unicode_normalize::is_normalized(input,form,scratch,1000)));
    assert(core::result::unwrap(ext::unicode_normalize::is_normalized(text("Å",2),form,scratch,1000)));
    assert(core::result::unwrap(ext::unicode_normalize::is_normalized(text("",0),form,scratch,0)));
    let index: i32 = 0; while (index < 40) { store[index] = 77; index += 1; }
    let short: core::slice::View<u8> = core::result::unwrap(output.subview(0,1));
    assert(code(core::result::unwrap_err(ext::unicode_normalize::normalize_into(input,form,short,scratch,1000))) == 202);
    let short_scratch: core::slice::View<u32> = core::result::unwrap(scratch.subview(0,1));
    assert(code(core::result::unwrap_err(ext::unicode_normalize::normalize_into(input,form,output,short_scratch,1000))) == 102);
    assert(code(core::result::unwrap_err(ext::unicode_normalize::normalize_into(input,form,output,scratch,0))) == 3);
    let required: ext::unicode_normalize::Normalized = core::result::unwrap(ext::unicode_normalize::measure(input,form,scratch,1000));
    assert(code(core::result::unwrap_err(ext::unicode_normalize::normalize_into(input,form,output,scratch,required.work - 1))) == 3);
    let malformed: core::text::Text = input; malformed.start = -1;
    assert(code(core::result::unwrap_err(ext::unicode_normalize::normalize_into(malformed,form,output,scratch,1000))) == 1);
    malformed = input; malformed.length = -1;
    assert(code(core::result::unwrap_err(ext::unicode_normalize::scratch_len(malformed,form,1000))) == 1);
    malformed = input; malformed.start = 2147483647; malformed.length = 1;
    assert(code(core::result::unwrap_err(ext::unicode_normalize::measure(malformed,form,scratch,1000))) == 1);
    let invalid: [u8;3] = [65,192,128];
    let invalid_slice: [u8] = invalid;
    malformed = core::text::Text {bytes:invalid_slice,start:0,length:3};
    assert(code(core::result::unwrap_err(ext::unicode_normalize::normalize_into(malformed,form,output,scratch,1000))) == 1001);
    let broken: core::slice::View<u32> = scratch; broken.start = -1;
    assert(code(core::result::unwrap_err(ext::unicode_normalize::normalize_into(input,form,output,broken,1000))) == 1);
    broken = scratch; broken.length = -1;
    assert(code(core::result::unwrap_err(ext::unicode_normalize::measure(input,form,broken,1000))) == 1);
    broken = scratch; broken.start = 2147483647; broken.length = 1;
    assert(code(core::result::unwrap_err(ext::unicode_normalize::measure(input,form,broken,1000))) == 1);
    let bad_output: core::slice::View<u8> = output; bad_output.length = -1;
    assert(code(core::result::unwrap_err(ext::unicode_normalize::normalize_into(input,form,bad_output,scratch,1000))) == 1);
    index = 0; while (index < 40) { assert(store[index] == 77); index += 1; }
    // Bytes outside the selected input may be invalid and must not be read.
    let ranged: [u8;6] = [255,65,204,138,192,255];
    let selected: core::text::Text = core::result::unwrap(core::text::from_utf8_range(ranged,1,3));
    assert(core::result::unwrap(ext::unicode_normalize::normalize_into(selected,form,output,scratch,1000)).bytes == 2);
    assert(store[2] == 195 && store[3] == 133 && store[4] == 77);
    index = 0; while (index < 40) { store[index] = 77; index += 1; }
    let bad_range: [u8;6] = [255,77,65,192,128,255];
    let bad_range_slice: [u8] = bad_range;
    malformed = core::text::Text {bytes:bad_range_slice,start:2,length:3};
    assert(code(core::result::unwrap_err(ext::unicode_normalize::normalize_into(malformed,form,output,scratch,1000))) == 1001);
    assert(ext::unicode_normalize::maximum_decomposition_length(ext::unicode_normalize::Form::Nfkd) == 18);
    // A descending combining run must hit a finite budget during ordering.
    let hostile: core::text::Text = text("ạ̣̣̣̣̣̣̣̣̣́́́́́́́́́́",41);
    assert(code(core::result::unwrap_err(ext::unicode_normalize::normalize_into(hostile,ext::unicode_normalize::Form::Nfd,output,scratch,200))) == 3);
    index = 0; while (index < 40) { assert(store[index] == 77); index += 1; }
    assert(core::result::unwrap(ext::unicode_normalize::normalize_into(input,form,output,scratch,required.work)).bytes == 2);
    // Both compatibility forms exercise the largest Unicode 17 expansion
    // under the same allocation-failure injection as canonical forms.
    let compatibility_input: core::text::Text = text("ﷺ",3);
    let expanded: ext::unicode_normalize::Normalized = core::result::unwrap(ext::unicode_normalize::normalize_into(compatibility_input,ext::unicode_normalize::Form::Nfkd,output,scratch,1000));
    assert(expanded.bytes == 33 && expanded.scalars == 18 && expanded.scratch == 18);
    assert(core::result::unwrap(ext::unicode_normalize::normalize_into(compatibility_input,ext::unicode_normalize::Form::Nfkc,output,scratch,1000)).bytes == 33);
    assert(core::result::unwrap(ext::unicode_normalize::normalize_into(text("Å",2),ext::unicode_normalize::Form::Nfd,output,scratch,1000)).bytes == 3);
    return 0;
}
