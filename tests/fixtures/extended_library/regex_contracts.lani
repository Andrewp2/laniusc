module app::main;
import alloc::string;
import core::mem;
import core::option;
import core::result;
import core::text;
import ext::regex;
fn text(value: str, count: i32) -> core::text::Text {
    let bytes: [u8] = core::mem::typed_slice_from_raw_parts<u8>(core::mem::string_data_ptr(value), count);
    return core::result::unwrap(core::text::from_utf8(bytes, count));
}
fn forged(bytes: [u8], start: i32, length: i32) -> core::text::Text { return core::text::Text { bytes: bytes, start: start, length: length }; }
fn inspect(input: core::text::Text) -> bool {
    let regex: ext::regex::Regex = core::result::unwrap(ext::regex::compile(text("(é+)(🙂??)", 13), ext::regex::options()));
    let found: ext::regex::Match = core::option::unwrap(core::result::unwrap(regex.find(input)));
    let span: ext::regex::Span = core::option::unwrap(found.span(0));
    let first: ext::regex::Span = core::option::unwrap(found.span(1));
    let last: ext::regex::Span = core::option::unwrap(found.span(2));
    let okay: bool = span.start == 1 && span.end == 5 && first.start == 1 && first.end == 5 && last.start == 5 && last.end == 5 && found.group_count() == 3 &&
        core::option::is_none(found.span(-1)) && core::option::is_none(found.span(3));
    if (core::result::is_ok(regex.find_from(input, 2)) || core::result::is_ok(regex.find_from(input, -1)) || core::result::is_ok(regex.find_from(input, input.length + 1))) { return false; }
    if (!core::result::unwrap(regex.is_match(input)) || regex.group_count() != 3) { return false; }
    regex.destroy();
    // Match captures are independent storage and survive compiled-owner release.
    if (core::option::unwrap(found.span(1)).end != 5) { return false; }
    found.destroy(); return okay;
}
fn main() -> i32 {
    let bytes: [u8; 11] = [255, 120, 195, 169, 195, 169, 240, 159, 153, 130, 255];
    let input: core::text::Text = core::result::unwrap(core::text::from_utf8_range(bytes, 1, 9));
    if (!inspect(input)) { return 1; }
    let owned: alloc::string::String = core::result::unwrap(alloc::string::from_text(input));
    if (!inspect(owned.as_text())) { return 2; } owned.destroy();
    if (!inspect(text("xéé🙂", 9))) { return 3; }
    // Native strided pattern storage as well as native input storage.
    let pattern_bytes: [u8; 6] = [255, 91, 195, 169, 93, 255];
    let regex: ext::regex::Regex = core::result::unwrap(ext::regex::compile(core::result::unwrap(core::text::from_utf8_range(pattern_bytes, 1, 4)), ext::regex::options()));
    if (!core::result::unwrap(regex.is_match(input))) { return 4; }
    let invalid: core::text::Text = forged(bytes, 0, 1);
    if (core::result::is_ok(regex.find(invalid))) { return 5; }
    let negative: core::text::Text = forged(bytes, -1, 1);
    let overflow: core::text::Text = forged(bytes, 2147483647, 1);
    if (core::result::is_ok(regex.find(negative)) || core::result::is_ok(regex.find(overflow)) || core::result::is_ok(ext::regex::compile(negative, ext::regex::options()))) { return 6; }
    regex.destroy();
    let config: ext::regex::Options = ext::regex::options(); config.max_work = 1;
    let limited: ext::regex::Regex = core::result::unwrap(ext::regex::compile(text("a", 1), config));
    let cursor: ext::regex::Matches = core::result::unwrap(limited.find_iter(text("a", 1)));
    if (core::result::is_ok(cursor.next()) || core::option::is_some(core::result::unwrap(cursor.next())) || core::option::is_some(core::result::unwrap(cursor.next()))) { return 7; }
    cursor.destroy(); limited.destroy();
    // Explicit scalar progress includes the final empty match exactly once.
    let empty: ext::regex::Regex = core::result::unwrap(ext::regex::compile(text("", 0), ext::regex::options()));
    let cursor: ext::regex::Matches = core::result::unwrap(empty.find_iter(text("é🙂", 6)));
    let at: i32 = 0; let expected: [i32; 3] = [0, 2, 6];
    while (at < 3) {
        let value: ext::regex::Match = core::option::unwrap(core::result::unwrap(cursor.next()));
        let span: ext::regex::Span = core::option::unwrap(value.span(0));
        if (span.start != expected[at] || span.end != span.start) { return 8; }
        value.destroy(); at += 1;
    }
    if (core::option::is_some(core::result::unwrap(cursor.next())) || core::option::is_some(core::result::unwrap(cursor.next()))) { return 9; }
    cursor.destroy(); empty.destroy(); return 0;
}
