module app::main;
import core::f64;
import core::mem;
import core::result;
import core::slice;
import ext::statistics;
fn kind(result: core::result::Result<bool,ext::statistics::Error>) -> i32 { if (result.is_ok()) { return 0; } return match (result.unwrap_err().kind) { NonFiniteInput -> 1, Overflow -> 2, CountLimit -> 3, _ -> 4 }; }
fn main() -> i32 {
 let m: ext::statistics::Moments = ext::statistics::moments(); assert(m.mean().is_err()); assert(m.sample_variance().is_err()); m.push(1e12).unwrap(); m.push(1e12+0.25).unwrap(); let before: f64 = m.sample_variance().unwrap(); assert(before == 0.03125);
 assert(kind(m.push(core::f64::nan())) == 1); assert(kind(m.push(core::f64::infinity())) == 1); assert(m.count() == 2 && m.sample_variance().unwrap() == before);
 assert(kind(m.push(-core::f64::MAX)) == 2); assert(m.count() == 2 && m.mean().unwrap() == 1e12+0.125);
 let invalid: [f64;3] = [1.0,2.0,core::f64::nan()]; let invalid_view: core::slice::View<f64> = core::slice::view(invalid,3).unwrap(); let edit: core::result::Result<bool,ext::statistics::Error> = m.push_view(invalid_view); assert(edit.is_err() && edit.unwrap_err().index == 2); assert(m.count() == 2 && m.sample_variance().unwrap() == before);
 let empty: ext::statistics::Moments = ext::statistics::moments(); m.merge(empty).unwrap(); assert(m.count() == 2 && m.sample_variance().unwrap() == before);
 let copy: ext::statistics::Moments = m; m.merge(copy).unwrap(); assert(m.count() == 4 && m.m2().unwrap() == 0.0625); assert(copy.count() == 2);
 // Reach exact-count cap by self merging; count arithmetic never rounds.
 let huge: ext::statistics::Moments = ext::statistics::moments(); huge.push(7.0).unwrap(); let i: i32 = 0; while (i < 53) { let old: ext::statistics::Moments = huge; huge.merge(old).unwrap(); i += 1; } assert(huge.count() == ext::statistics::MAX_COUNT); assert(kind(huge.push(7.0)) == 3); assert(kind(huge.merge(copy)) == 3); assert(huge.mean().unwrap() == 7.0);
 let sum: ext::statistics::CompensatedSum = ext::statistics::sum(); sum.push(1e16).unwrap(); sum.push(1.0).unwrap(); sum.push(-1e16).unwrap(); assert(sum.value().unwrap() == 1.0); assert(kind(sum.push(core::f64::nan())) == 1 && sum.count() == 3); let overflow_sum: ext::statistics::CompensatedSum = ext::statistics::sum(); overflow_sum.push(core::f64::MAX).unwrap(); assert(kind(overflow_sum.push(core::f64::MAX)) == 2 && overflow_sum.count() == 1 && overflow_sum.value().unwrap() == core::f64::MAX);
 let large: ext::statistics::ScaledNorm = ext::statistics::scaled_norm(); large.push(3e200).unwrap(); large.push(-4e200).unwrap(); assert(large.value().unwrap() >= 4.999999999999998e200 && large.value().unwrap() <= 5.000000000000002e200); let tiny: ext::statistics::ScaledNorm = ext::statistics::scaled_norm(); tiny.push(core::f64::from_bits(3)).unwrap(); tiny.push(core::f64::from_bits(4)).unwrap(); assert(core::f64::to_bits(tiny.value().unwrap()) == 5); assert(kind(large.push(core::f64::infinity())) == 1 && large.count() == 2);
 let pair: ext::statistics::PairedMoments = ext::statistics::paired_moments(); pair.push(1.0,3.0).unwrap(); pair.push(2.0,5.0).unwrap(); assert(pair.sample_covariance().unwrap() == 1.0); assert(pair.correlation().unwrap() > 0.999999999999999); assert(kind(pair.push(3.0,core::f64::nan())) == 1 && pair.count() == 2); assert(kind(pair.push(3.0,core::f64::MAX)) == 2 && pair.count() == 2); let line: ext::statistics::LinearFit = pair.linear_fit().unwrap(); assert(line.slope == 2.0 && line.intercept == 1.0); let prior: ext::statistics::PairedMoments = pair; pair.merge(prior).unwrap(); assert(pair.count() == 4 && pair.linear_fit().unwrap().slope == 2.0); assert(prior.count() == 2);
 let constant: ext::statistics::PairedMoments = ext::statistics::paired_moments(); constant.push(1.0,9.0).unwrap(); constant.push(2.0,9.0).unwrap(); assert(constant.correlation().is_err()); assert(constant.linear_fit().unwrap().slope == 0.0 && constant.linear_fit().unwrap().r_squared == 1.0);
 let input: [f64;6] = [123.0,9.0,-0.0,0.0,2.0,456.0]; let view: core::slice::View<f64> = core::slice::view_range(input,1,4).unwrap(); let scratch: [f64;6] = [55.0;6]; let target: core::slice::View<f64> = core::slice::view_range(scratch,1,4).unwrap(); assert(ext::statistics::sorted_copy(view,target,0).is_err()); assert(scratch[1] == 55.0); let short: core::slice::View<f64> = core::slice::view(scratch,3).unwrap(); assert(ext::statistics::sorted_copy(view,short,1000).is_err() && scratch[1] == 55.0); assert(ext::statistics::sorted_copy(invalid_view,target,1000).is_err() && scratch[1] == 55.0);
 let sorted: ext::statistics::SortedSample = ext::statistics::sorted_copy(view,target,ext::statistics::sorted_work_bound(4).unwrap()).unwrap(); assert(sorted.len() == 4 && sorted.median().unwrap() == 1.0); assert(core::f64::to_bits(scratch[1]) == core::f64::SIGN_MASK && core::f64::to_bits(scratch[2]) == 0); assert(scratch[0] == 55.0 && scratch[5] == 55.0); assert(input[1] == 9.0 && input[4] == 2.0); assert(ext::statistics::quantile_sorted(view,0.5,ext::statistics::QuantileType::Type7).is_err()); assert(sorted.quantile(-0.1,ext::statistics::QuantileType::Type7).is_err()); assert(sorted.quantile(core::f64::nan(),ext::statistics::QuantileType::Type7).is_err()); assert(ext::statistics::quantile_type(0).is_err() && ext::statistics::quantile_type(10).is_err());
 let inplace: ext::statistics::SortedSample = ext::statistics::sorted_copy(view,view,1000).unwrap(); assert(inplace.median().unwrap() == 1.0 && input[0] == 123.0 && input[5] == 456.0);
 let extremes: [f64;2] = [-core::f64::MAX,core::f64::MAX]; let ev: core::slice::View<f64> = core::slice::view(extremes,2).unwrap(); assert(ext::statistics::median_sorted(ev).unwrap() == 0.0); let zero: core::slice::View<f64> = core::slice::view(extremes,0).unwrap(); assert(ext::statistics::median_sorted(zero).is_err()); assert(ext::statistics::sorted_copy(zero,zero,0).unwrap().median().is_err());
 let sx: ext::statistics::CompensatedSum = ext::statistics::sum(); sx.push(core::f64::MAX).unwrap(); let sxcopy: ext::statistics::CompensatedSum = sx; assert(kind(sx.merge(sxcopy)) == 2 && sx.count() == 1 && sx.value().unwrap() == core::f64::MAX && sxcopy.count() == 1);
 let nx: ext::statistics::ScaledNorm = ext::statistics::scaled_norm(); nx.push(core::f64::MAX).unwrap(); let nxcopy: ext::statistics::ScaledNorm = nx; assert(kind(nx.merge(nxcopy)) == 2 && nx.count() == 1 && nx.value().unwrap() == core::f64::MAX && nxcopy.count() == 1);
 let bad_pair: ext::statistics::PairedMoments = ext::statistics::paired_moments(); bad_pair.push(3.0,core::f64::MAX).unwrap(); let saved_count: u64 = pair.count(); assert(kind(pair.merge(bad_pair)) == 2 && pair.count() == saved_count && pair.linear_fit().unwrap().slope == 2.0);
 let many_sum: ext::statistics::CompensatedSum = ext::statistics::sum(); many_sum.push(0.0).unwrap(); let many_norm: ext::statistics::ScaledNorm = ext::statistics::scaled_norm(); many_norm.push(0.0).unwrap(); i = 0; while (i < 53) { let sc: ext::statistics::CompensatedSum = many_sum; let nc: ext::statistics::ScaledNorm = many_norm; many_sum.merge(sc).unwrap(); many_norm.merge(nc).unwrap(); i += 1; } let one_sum: ext::statistics::CompensatedSum = ext::statistics::sum(); one_sum.push(0.0).unwrap(); let one_norm: ext::statistics::ScaledNorm = ext::statistics::scaled_norm(); one_norm.push(0.0).unwrap(); assert(kind(many_sum.merge(one_sum)) == 3 && many_sum.count() == ext::statistics::MAX_COUNT); assert(kind(many_norm.merge(one_norm)) == 3 && many_norm.count() == ext::statistics::MAX_COUNT);
 // Typed storage views alongside native array layout.
 let words: [i32;6] = [0;6]; let ptr: ptr = core::mem::i32_array_data_ptr(words); let packed: [f64] = core::mem::typed_slice_from_storage(ptr,3); packed[0] = 5.0; packed[1] = 1.0; packed[2] = 3.0; let pv: core::slice::View<f64> = core::slice::view(packed,3).unwrap(); assert(ext::statistics::summarize(pv).unwrap().mean().unwrap() == 3.0); assert(ext::statistics::sorted_copy(pv,pv,1000).unwrap().median().unwrap() == 3.0);
 let malformed: core::slice::View<f64> = core::slice::View { values: packed, start: -1, length: 1 }; assert(ext::statistics::summarize(malformed).is_err()); assert(ext::statistics::sorted_copy(pv,malformed,1000).is_err()); assert(ext::statistics::sorted_work_bound(-1).is_err()); return 0;
}
