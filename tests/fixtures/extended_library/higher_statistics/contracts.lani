module app::main;
import core::f64;
import core::mem;
import core::result;
import core::slice;
import ext::statistics;
import ext::higher_statistics;
fn code(error:ext::statistics::Error) -> i32 { return match(error.kind) { Empty->1,InsufficientData->2,NonFiniteInput->3,Overflow->4,CountLimit->5,Bounds->6,Underflow->13,Degenerate->12,_->99 }; }
fn query(value:ext::higher_statistics::Moments,index:i32) -> core::result::Result<f64,ext::statistics::Error> { return match(index) { 0->value.mean(),1->value.minimum(),2->value.maximum(),3->value.m2(),4->value.m3(),5->value.m4(),6->value.population_variance(),7->value.sample_variance(),8->value.population_stddev(),9->value.sample_stddev(),10->value.population_skewness(),11->value.population_kurtosis(),12->value.population_excess_kurtosis(),13->value.adjusted_skewness(),_->value.adjusted_excess_kurtosis() }; }
fn same(a:ext::higher_statistics::Moments,b:ext::higher_statistics::Moments) { assert(a.count()==b.count()); let i:i32=0; while(i<15) { let x=query(a,i); let y=query(b,i); assert(x.is_ok()==y.is_ok()); if(x.is_ok()) { assert(core::f64::to_bits(x.unwrap())==core::f64::to_bits(y.unwrap())); } else { assert(code(x.unwrap_err())==code(y.unwrap_err()) && x.unwrap_err().index==y.unwrap_err().index); } i+=1; } }
fn failed(result:core::result::Result<bool,ext::statistics::Error>,kind:i32,index:i32) { assert(result.is_err() && code(result.unwrap_err())==kind && result.unwrap_err().index==index); }
fn main() -> i32 {
 let empty:ext::higher_statistics::Moments =ext::higher_statistics::moments(); assert(empty.count()==0); let i:i32=0;
 while(i<15) { let r=query(empty,i); assert(r.is_err()); let expected:i32=1; if(i==7 || i==9 || i>=13) { expected=2; } assert(code(r.unwrap_err())==expected); i+=1; }
 let value:ext::higher_statistics::Moments =ext::higher_statistics::moments(); value.push(1.0).unwrap(); assert(value.mean().unwrap()==1.0 && value.m2().unwrap()==0.0 && value.m3().unwrap()==0.0 && value.m4().unwrap()==0.0); assert(code(value.population_skewness().unwrap_err())==12 && code(value.population_kurtosis().unwrap_err())==12 && code(value.population_excess_kurtosis().unwrap_err())==12);
 assert(code(value.adjusted_skewness().unwrap_err())==2 && code(value.adjusted_excess_kurtosis().unwrap_err())==2);
 value.push(3.0).unwrap(); assert(value.mean().unwrap()==2.0 && value.minimum().unwrap()==1.0 && value.maximum().unwrap()==3.0 && value.m2().unwrap()==2.0 && value.m3().unwrap()==0.0 && value.m4().unwrap()==2.0); assert(value.population_skewness().unwrap()==0.0 && value.population_kurtosis().unwrap()==1.0 && value.population_excess_kurtosis().unwrap()==-2.0); assert(code(value.adjusted_skewness().unwrap_err())==2 && code(value.adjusted_excess_kurtosis().unwrap_err())==2);
 value.push(2.0).unwrap(); assert(value.adjusted_skewness().unwrap()==0.0 && code(value.adjusted_excess_kurtosis().unwrap_err())==2); value.push(2.0).unwrap(); assert(core::f64::is_finite(value.adjusted_excess_kurtosis().unwrap()));
 let saved:ext::higher_statistics::Moments =value; failed(value.push(core::f64::nan()),3,-1); same(value,saved); failed(value.push(core::f64::infinity()),3,-1); same(value,saved); failed(value.push(core::f64::neg_infinity()),3,-1); same(value,saved);
 let invalid:[f64;4]=[5.0,7.0,9.0,core::f64::nan()]; failed(value.push_view(core::slice::view(invalid,4).unwrap()),3,3); same(value,saved);
 let overflow:[f64;3]=[7.0,9.0,1e100]; failed(value.push_view(core::slice::view(overflow,3).unwrap()),4,2); same(value,saved); failed(value.push(1e100),4,-1); same(value,saved);
 let peer:ext::higher_statistics::Moments =ext::higher_statistics::moments(); peer.push(1e100).unwrap(); let peer_saved:ext::higher_statistics::Moments =peer; failed(value.merge(peer),4,-1); same(value,saved); same(peer,peer_saved);
 let control:ext::higher_statistics::Moments =saved; value.push(4.0).unwrap(); control.push(4.0).unwrap(); same(value,control);
 value.merge(empty).unwrap(); same(value,control); let copied:ext::higher_statistics::Moments =empty; copied.merge(value).unwrap(); same(copied,value); let duplicate:ext::higher_statistics::Moments =value; value.merge(duplicate).unwrap(); assert(value.count()==10 && duplicate.count()==5 && value.mean().unwrap()==duplicate.mean().unwrap()); assert(value.m2().unwrap()==2.0*duplicate.m2().unwrap() && value.m3().unwrap()==2.0*duplicate.m3().unwrap() && value.m4().unwrap()==2.0*duplicate.m4().unwrap());
 let huge:ext::higher_statistics::Moments =ext::higher_statistics::moments(); huge.push(7.0).unwrap(); i=0; while(i<53) { let old:ext::higher_statistics::Moments =huge; huge.merge(old).unwrap(); i+=1; } assert(huge.count()==ext::statistics::MAX_COUNT); let huge_saved:ext::higher_statistics::Moments =huge; failed(huge.push(7.0),5,-1); same(huge,huge_saved); failed(huge.merge(peer),5,-1); same(huge,huge_saved); huge.merge(empty).unwrap(); same(huge,huge_saved);
 // The old second-order accumulator still accepts finite M2 when M4 cannot fit.
 let old:ext::statistics::Moments =ext::statistics::moments(); old.push(0.0).unwrap(); old.push(1e100).unwrap(); assert(old.count()==2 && core::f64::is_finite(old.m2().unwrap()));
 let under:ext::higher_statistics::Moments =ext::higher_statistics::moments(); under.push(0.0).unwrap(); under.push(0.0).unwrap(); let under_saved:ext::higher_statistics::Moments =under; failed(under.push(1e-100),13,-1); same(under,under_saved);
 let tiny:[f64;3]=[0.0,0.0,1e-100]; failed(under.push_view(core::slice::view(tiny,3).unwrap()),13,2); same(under,under_saved); let tiny_peer:ext::higher_statistics::Moments =ext::higher_statistics::moments(); tiny_peer.push(1e-100).unwrap(); failed(under.merge(tiny_peer),13,-1); same(under,under_saved); assert(tiny_peer.count()==1 && tiny_peer.mean().unwrap()==1e-100);
 let bounded:ext::higher_statistics::Moments =ext::higher_statistics::moments(); bounded.push(0.0).unwrap(); failed(bounded.push(1e100),4,-1); assert(bounded.count()==1 && bounded.mean().unwrap()==0.0);
 let native:[f64;7]=[123.0,5.0,1.0,3.0,7.0,456.0,789.0]; let words:[i32;14]=[0;14]; let storage:[f64]=core::mem::typed_slice_from_storage<f64>(core::mem::i32_array_data_ptr(words),7); assert(core::mem::slice_stride(native)<0 && core::mem::slice_stride(storage)==-8); let layout:i32=0;
 while(layout<2) { let backing:[f64]=native; if(layout==1) { backing=storage; } backing[0]=123.0; backing[1]=5.0; backing[2]=1.0; backing[3]=3.0; backing[4]=7.0; backing[5]=456.0; backing[6]=789.0; let view:core::slice::View<f64> =core::slice::view_range(backing,1,4).unwrap(); backing[3]=9.0; let reference:ext::higher_statistics::Moments =ext::higher_statistics::moments(); reference.push(5.0).unwrap(); reference.push(1.0).unwrap(); reference.push(9.0).unwrap(); reference.push(7.0).unwrap(); same(ext::higher_statistics::summarize(view).unwrap(),reference); assert(backing[0]==123.0 && backing[5]==456.0 && backing[6]==789.0);
  let before_bounds:ext::higher_statistics::Moments =reference; let invalid:core::slice::View<f64> =view; invalid.start=-1; failed(reference.push_view(invalid),6,-1); same(reference,before_bounds); invalid=view; invalid.length=-1; failed(reference.push_view(invalid),6,-1); same(reference,before_bounds); invalid=view; invalid.start=2147483647; invalid.length=1; failed(reference.push_view(invalid),6,-1); same(reference,before_bounds); let zero:core::slice::View<f64> =core::slice::view(backing,0).unwrap(); let prior:ext::higher_statistics::Moments =reference; reference.push_view(zero).unwrap(); same(reference,prior); layout+=1;
 }
 return 0;
}
