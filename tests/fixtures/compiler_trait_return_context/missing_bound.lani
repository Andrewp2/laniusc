module app::main;
import core::result;
import probe::protocol;
import probe::values;

fn missing_bound<T,E>(source: T) -> core::result::Result<T,E> {
    return T::produce(source,false);
}
fn main() -> i32 {
    let source: probe::values::Item = probe::values::Item { word:1,signed:2 };
    let rejected: core::result::Result<probe::values::Item,probe::values::Fault> =
        missing_bound<probe::values::Item,probe::values::Fault>(source);
    return 0;
}
