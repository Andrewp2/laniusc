fn ended<I,T>(cursor:&I) where I:core::iter::Iterator<T>,I:core::iter::DoubleEndedIterator<T> {
    let i:i32=0; while(i<3) {
        let front:core::option::Option<T> =cursor.next();
        assert(match(front) { core::option::None -> true,_ -> false });
        let back:core::option::Option<T> =cursor.next_back();
        assert(match(back) { core::option::None -> true,_ -> false }); i+=1;
    }
}
fn texts<I>(cursor:&I,text:core::text::Text,starts:[i32],lengths:[i32],count:i32,schedule:i32)
    where I:core::iter::Iterator<core::text::Text>,I:core::iter::DoubleEndedIterator<core::text::Text> {
    let front:i32=0; let back:i32=count; let step:i32=0;
    while(front<back) {
        let index:i32=front; let item:core::option::Option<core::text::Text> =core::option::None();
        if(((schedule>>(step%3))&1)==0) { item=cursor.next(); front+=1; } else { back-=1; index=back; item=cursor.next_back(); }
        assert(item.is_some()); let value:core::text::Text=item.unwrap();
        assert(value.start==text.start+starts[index] && value.length==lengths[index]); assert(core::mem::slice_stride(value.bytes)==core::mem::slice_stride(text.bytes));
        let i:i32=0; while(i<value.length) { assert(value.byte_at(i).unwrap()==text.byte_at(starts[index]+i).unwrap()); i+=1; } step+=1;
    }
    ended<I,core::text::Text>(cursor);
}
fn scalars(cursor:&core::text::Scalars,starts:[i32],values:[u32],count:i32,schedule:i32) {
    let front:i32=0; let back:i32=count; let step:i32=0;
    while(front<back) {
        let index:i32=front; let item:core::option::Option<core::text::Scalar> =core::option::None();
        if(((schedule>>(step%3))&1)==0) { item=cursor.next(); front+=1; } else { back-=1; index=back; item=cursor.next_back(); }
        assert(item.is_some()); let value:core::text::Scalar=item.unwrap(); assert(value.byte_index==starts[index] && value.value==values[index]); step+=1;
    }
    ended<core::text::Scalars,core::text::Scalar>(cursor);
}
fn check(bytes:[u8],length:i32,line_starts:[i32],line_lengths:[i32],line_count:i32,word_starts:[i32],word_lengths:[i32],word_count:i32,scalar_starts:[i32],scalar_values:[u32],scalar_count:i32) {
    let native:[u8;128]=[255;128]; let words:[i32;32]=[0;32]; let packed:[u8]=core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(words),128);
    assert(length<=120 && core::mem::slice_stride(native)<0 && core::mem::slice_stride(packed)==1);
    let i:i32=0; while(i<128) { packed[i]=255; i+=1; } i=0; while(i<length) { native[i+3]=bytes[i]; packed[i+5]=bytes[i]; i+=1; }
    let layout:i32=0; while(layout<2) {
        let start:i32=3; let backing:[u8]=native; if(layout==1) { start=5; backing=packed; }
        let text:core::text::Text=core::text::from_utf8_range(backing,start,length).unwrap(); let schedule:i32=0;
        while(schedule<8) {
            let lines:core::text::Lines=text.lines(); texts<core::text::Lines>(lines.borrow(),text,line_starts,line_lengths,line_count,schedule);
            let split:core::text::SplitAsciiWhitespace=text.split_ascii_whitespace(); texts<core::text::SplitAsciiWhitespace>(split.borrow(),text,word_starts,word_lengths,word_count,schedule);
            let chars:core::text::Scalars=text.scalars(); scalars(chars.borrow(),scalar_starts,scalar_values,scalar_count,schedule); schedule+=1;
        }
        i=0; while(i<128) { let expected:u8=255; if(i>=start && i<start+length) { expected=bytes[i-start]; } assert(backing[i]==expected); i+=1; } layout+=1;
    }
}
