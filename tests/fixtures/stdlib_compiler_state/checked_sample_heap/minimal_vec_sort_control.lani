module app::main;
import alloc::vec;
fn main() -> i32 {
    let values: alloc::vec::Vec<i64> = alloc::vec::new();
    if (values.try_push(3).is_err() || values.try_push(1).is_err() || values.try_push(3).is_err()) { values.destroy(); return 1; }
    values.sort();
    let correct: bool = values.len() == 3 && values.at(0) == 1 && values.at(1) == 3 && values.at(2) == 3;
    values.destroy(); if (!correct) { return 2; } return 0;
}
