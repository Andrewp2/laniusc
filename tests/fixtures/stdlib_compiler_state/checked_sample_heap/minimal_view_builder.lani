module app::main;
import alloc::binary_heap;
import alloc::vec;
import core::result;
import core::slice;
fn main() -> i32 {
    let heap: alloc::binary_heap::BinaryHeap<i64> = alloc::binary_heap::new(alloc::binary_heap::Order::Min);
    if (heap.try_push(3).is_err() || heap.try_push(1).is_err() || heap.try_push(3).is_err()) { heap.destroy(); return 1; }
    let view: core::slice::View<i64> = heap.as_view();
    let copied: core::result::Result<alloc::vec::Vec<i64>,alloc::vec::Error> = alloc::vec::from_view<i64>(view);
    if (copied.is_err()) { heap.destroy(); return 2; }
    let values: alloc::vec::Vec<i64> = copied.unwrap(); heap.destroy(); values.sort();
    let correct: bool = values.len() == 3 && values.at(0) == 1 && values.at(1) == 3 && values.at(2) == 3;
    values.destroy(); if (!correct) { return 3; } return 0;
}
