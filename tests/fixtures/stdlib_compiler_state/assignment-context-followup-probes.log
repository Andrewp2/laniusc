import core::option;
import core::mem;

struct Slot<T> { value: T, sentinel: i32 }
enum Maybe<T> { Value(T), Missing }
fn empty<T>() -> core::option::Option<T> { return core::option::None(); }
fn present<T>(value: T) -> core::option::Option<T> { return core::option::Some(value); }
fn view<T>(values: [T]) -> [T] { return values; }
fn main() -> i32 {
    let slot: Slot<core::option::Option<i32> > = Slot { value: core::option::None(), sentinel: 97 };
    slot.value = match (true) { true -> core::option::Some(42), false -> core::option::None() };
    if (core::option::unwrap_or(slot.value, -1) != 42 || slot.sentinel != 97) { return 1; }
    slot.value = empty();
    if (!core::option::is_none(slot.value)) { return 2; }

    let values: [core::option::Option<i32>; 2] = [core::option::None(), core::option::None()];
    values[0] = core::option::Some(11);
    view(values)[1] = present(22);
    if (core::option::unwrap_or(values[0], -1) != 11 || core::option::unwrap_or(values[1], -1) != 22) { return 3; }
    values[1] = empty();
    if (!core::option::is_none(values[1]) || core::option::unwrap_or(values[0], -1) != 11) { return 4; }

    let rows: [[u32; 2]; 2] = [[1, 2], [3, 4]];
    rows[0] = [4294967295, 2147483648];
    let row: Slot<[u32; 2]> = Slot { value: [5, 6], sentinel: 91 };
    row.value = [2147483648, 4294967295];
    if (rows[0][0] != 4294967295 || rows[0][1] != 2147483648 || rows[1][0] != 3 ||
        row.value[0] != 2147483648 || row.value[1] != 4294967295 || row.sentinel != 91) { return 5; }

    let local: Slot<Maybe<bool> > = Slot { value: Missing(), sentinel: 89 };
    local.value = Value(true);
    let flag: bool = match (local.value) { Value(flag) -> flag, Missing -> false };
    if (!flag || local.sentinel != 89) { return 6; }

    let records: [Slot<core::option::Option<[i32; 2]> >; 2] = [
        Slot { value: core::option::None(), sentinel: 83 },
        Slot { value: core::option::None(), sentinel: 79 }
    ];
    records[1].value = present([31, 41]);
    let extracted: [i32; 2] = core::option::unwrap_or(records[1].value, [0, 0]);
    extracted[0] = 99;
    let original: [i32; 2] = core::option::unwrap_or(records[1].value, [0, 0]);
    if (original[0] != 31 || original[1] != 41 || records[0].sentinel != 83 || records[1].sentinel != 79) { return 7; }
    return 0;
}

