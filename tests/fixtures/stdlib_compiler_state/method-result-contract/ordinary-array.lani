fn pair(value: [i32; 2]) -> [i32; 2] { return value; }
fn empty(value: [bool; 0]) -> [bool; 0] { return value; }
fn main() -> i32 {
    let original = [19, 23]; let copy = pair(original); copy[0] = 20;
    let zero: [bool; 0] = []; let empty_copy = empty(zero);
    if (original[0] != 19 || copy[0] + copy[1] != 43) { return 1; }
    return 0;
}
