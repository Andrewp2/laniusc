module probe::model;
import core::result;
pub struct Header { f0: i32, f1: i32, f2: i32, f3: i32 }
enum Error { Bad }
fn parse() -> core::result::Result<Header,Error> { return core::result::Ok(Header { f0: 1, f1: 2, f2: 3, f3: 4 }); }
pub fn value() -> i32 { let parsed: core::result::Result<Header,Error> = parse(); let header: Header = core::result::unwrap(parsed); return header.f3; }
