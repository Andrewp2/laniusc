CASE nonrecursive_reference
SOURCE
import core::option;
struct Item { value: i32 }
impl Item { fn borrow(&self) -> &Item { return self; } }
struct Holder { next: core::option::Option<&Item> }
fn main() -> i32 { let item: Item = Item { value: 11 }; let holder: Holder = Holder { next: core::option::None() }; holder.next = core::option::Some(item.borrow()); let next: &Item = core::option::unwrap_or(holder.next, item.borrow()); item.value = 42; if (next.value != 42) { return 1; } return 0; }

