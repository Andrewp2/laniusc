CASE typed_option
SOURCE
import core::option;
struct Node<T> { value: T, next: core::option::Option<&Node<T>> }
impl<T> Node<T> { fn borrow(&self) -> &Node<T> { return self; } }
fn main() -> i32 {
 let node: Node<i32> = Node { value: 11, next: core::option::None() };
 let present: core::option::Option<&Node<i32>> = core::option::Some(node.borrow()); node.next = present;
 let next: &Node<i32> = core::option::unwrap_or(node.next, node.borrow());
 node.value = 42;
 if (next.value != 42) { return 1; }
 return 0;
}

