// Unexecuted additional controls. Each five-byte record is:
// ASCII label, is_none, is_some, source calls, predicate calls.
module app::main;
import core::io;
import core::iter;
import core::option;
import core::result;
import std::stream;

struct Counter { calls: i32 }
impl Counter { fn borrow(&self) -> &Counter { return self; } }
struct Probe { length: i32, position: i32, calls: i32 }
impl Probe { fn borrow(&self) -> &Probe { return self; } }
pub impl core::iter::Iterator<i64> for Probe {
    pub fn next(&self) -> core::option::Option<i64> {
        self.calls += 1;
        if (self.position == self.length) { return core::option::None(); }
        let value: i32 = self.position; self.position += 1;
        return core::option::Some(value as i64);
    }
}
struct Predicate { counter: &Counter }
impl Predicate { fn borrow(&self) -> &Predicate { return self; } }
pub impl core::iter::Mapper<i64, bool> for Predicate {
    pub fn apply(&self, value: i64) -> bool {
        let counter: &Counter = self.counter; counter.calls += 1;
        return true;
    }
}
fn marker(value: u8) -> bool {
    let bytes: [u8; 1] = [value];
    let output: std::stream::Descriptor = std::stream::stdout();
    let sent: core::result::Result<i32, core::io::Error> = output.write(bytes, 0, 1);
    if (core::result::is_err(sent)) { return false; }
    let count: i32 = core::result::unwrap(sent);
    return count == 1;
}
fn direct<I>(first: I) where I: core::iter::Iterator<i64> {
    let item: core::option::Option<i64> = first.next();
    let none: bool = core::option::is_none(item);
    let some: bool = core::option::is_some(item);
    if (!marker(none as u8)) { return; }
    if (!marker(some as u8)) { return; }
}
fn unconditional<I>(first: I) where I: core::iter::Iterator<i64> {
    let item: core::option::Option<i64> = core::option::None();
    item = first.next();
    let none: bool = core::option::is_none(item);
    let some: bool = core::option::is_some(item);
    if (!marker(none as u8)) { return; }
    if (!marker(some as u8)) { return; }
}
fn conditional<I>(first: I, schedule: u64) where I: core::iter::Iterator<i64> {
    let second: I = first;
    let item: core::option::Option<i64> = core::option::None();
    if ((schedule & 1) == 0) { item = first.next(); }
    else { item = second.next(); }
    let none: bool = core::option::is_none(item);
    let some: bool = core::option::is_some(item);
    if (!marker(none as u8)) { return; }
    if (!marker(some as u8)) { return; }
}
fn run(kind: i32, length: i32, schedule: u64, label: u8) {
    let probe: Probe = Probe { length: length, position: 0, calls: 0 };
    let counter: Counter = Counter { calls: 0 };
    let predicate: Predicate = Predicate { counter: counter.borrow() };
    if (!marker(label)) { return; }
    let selected: core::iter::Filter<Probe, Predicate, i64> = core::iter::filter<Probe, Predicate, i64>(probe.borrow(), predicate.borrow());
    if (kind == 0) {
        direct<core::iter::Filter<Probe, Predicate, i64>>(selected);
    } else {
        if (kind == 1) {
            unconditional<core::iter::Filter<Probe, Predicate, i64>>(selected);
        } else {
            conditional<core::iter::Filter<Probe, Predicate, i64>>(selected, schedule);
        }
    }
    if (!marker(probe.calls as u8)) { return; }
    if (!marker(counter.calls as u8)) { return; }
}
fn main() -> i32 {
    run(0, 0, 0, 65); run(1, 0, 0, 66);
    run(2, 0, 0, 67); run(2, 0, 1, 68);
    run(0, 1, 0, 69); run(1, 1, 0, 70);
    run(2, 1, 0, 71); run(2, 1, 1, 72);
    return 0;
}
