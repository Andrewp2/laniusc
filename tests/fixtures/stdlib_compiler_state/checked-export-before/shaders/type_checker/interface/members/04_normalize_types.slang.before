import semantic_interface_layout;
// Convert exact lexical parameter declarations into portable member identities.
import hir_records;
import atomics;
import type_checker.type.instances.generic_param_lookup;
struct Params { uint hir_capacity; uint decl_capacity; uint token_capacity; uint library_id; };
ConstantBuffer<Params> gParams;
StructuredBuffer<uint> compact_hir_count;
StructuredBuffer<HirCore> compact_hir_core;
StructuredBuffer<HirPayload> compact_hir_payload;
StructuredBuffer<uint> generic_decl_owner_by_node_a;
StructuredBuffer<uint> name_id_by_token;
StructuredBuffer<uint> generic_param_count_out;
StructuredBuffer<uint> generic_param_owner_token;
StructuredBuffer<uint> generic_param_name_id;
StructuredBuffer<uint> generic_param_kind;
StructuredBuffer<uint> generic_param_lookup_state;
StructuredBuffer<uint> interface_type_count;
StructuredBuffer<uint> interface_type_hir_order;
StructuredBuffer<uint> interface_type_root_owner;
StructuredBuffer<uint> interface_type_seed_owner;
StructuredBuffer<uint> interface_member_index_by_generic_row;
StructuredBuffer<uint> interface_member_total;
StructuredBuffer<uint> interface_member_words;
RWStructuredBuffer<uint> interface_types;
RWStructuredBuffer<uint> interface_status;
#define LEXICAL_HIR_CAPACITY gParams.hir_capacity
#define LEXICAL_TOKEN_CAPACITY gParams.token_capacity
#include "../../type/instances/lexical_parameter_lookup.slang"
static const uint INVALID=0xffffffffu, TYPE_WORDS=9u;
void fail(uint d){atomic_u32_or(interface_status,0u,8192u);atomic_u32_min(interface_status,1u,d);}
uint parameter_member(uint node,uint use_token,uint kind,uint owner)
{
 uint row=lexical_parameter_row(node,use_token,kind);
 if(row>=min(generic_param_count_out[0u],gParams.token_capacity))return INVALID;
 uint member=interface_member_index_by_generic_row[row];
 if(member>=interface_member_total[0u]||interface_member_words[member*SEMANTIC_INTERFACE_MEMBER_WORDS]!=owner||
    interface_member_words[member*SEMANTIC_INTERFACE_MEMBER_WORDS+1u]!=(kind==1u?2u:3u))return INVALID;
 return member;
}
[shader("compute")][numthreads(256,1,1)]
void main(uint3 dtid:SV_DispatchThreadID)
{
 uint index=dtid.x+dtid.y*65535u*256u;
 if(index>=min(interface_type_count[0u],gParams.hir_capacity))return;
 uint node=interface_type_hir_order[index];
 uint root=node<gParams.hir_capacity?interface_type_root_owner[node]:INVALID;
 uint owner=root<gParams.hir_capacity?interface_type_seed_owner[root]:INVALID;
 if(owner>=gParams.decl_capacity){fail(index);return;}
 uint base=index*TYPE_WORDS;
 if(interface_types[base]==2u)
 {
  uint member=parameter_member(node,compact_hir_core[node].token_start,1u,owner);
  if(member==INVALID){fail(index);return;}
  interface_types[base+1u]=member;
 }
 if(interface_types[base]==8u)
 {
  uint member=parameter_member(node,compact_hir_core[node].token_start,2u,owner);
  if(member==INVALID){fail(index);return;}
  interface_types[base+1u]=member;
 }
 if(interface_types[base]==4u&&interface_types[base+5u]==2u)
 {
  uint member=parameter_member(node,compact_hir_payload[node].c,2u,owner);
  if(member==INVALID){fail(index);return;}
  interface_types[base+6u]=member;
 }
}
