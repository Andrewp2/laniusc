import semantic_interface_layout;
// Publish complete checked references for imported declaration fields after
// the application producer and its index finish. Each lane owns its instance;
// consumers run in later dispatches and retain no page-local type identities.
import dependency_interface;
import atomics;
import status;
import type_checker.checked_scoped_types;
import type_checker.checked_type_graph;
import type_checker.dependencies.canonical_field_types;

struct Params { uint n_tokens; uint source_len; uint n_hir_nodes; };
ConstantBuffer<Params> gParams;
RWStructuredBuffer<uint> imported_field_ref_start;
RWStructuredBuffer<uint> imported_field_ref_count;
RWStructuredBuffer<uint> imported_field_ref_tag;
RWStructuredBuffer<uint> imported_field_ref_payload;
RWStructuredBuffer<uint> imported_field_ref_total;
RWStructuredBuffer<uint> status;

static const uint INVALID = 0xffffffffu;

[shader("compute")]
[numthreads(256, 1, 1)]
void main(uint3 dtid: SV_DispatchThreadID)
{
    uint lane = dtid.x + dtid.y * 16776960u;
    if (lane >= gParams.n_tokens) return;
    uint capacity; uint stride;
    imported_field_ref_tag.GetDimensions(capacity, stride);
    for (uint instance = lane; instance < checked_type_capacity(); instance += gParams.n_tokens)
    {
        if (type_instance_kind[instance] != 1u || type_instance_decl_token[instance] != INVALID ||
            external_type_library_id[instance] == INVALID) continue;
        uint declaration = dependency_find_declaration(external_type_library_id[instance],
            external_type_unit_id[instance], external_type_local_index[instance]);
        if (declaration >= dependency_declaration_count() ||
            dependency_declaration_word(declaration * 14u + 6u) != 6u) continue;
        uint start = dependency_declaration_word(declaration * 14u + 8u);
        uint count = dependency_declaration_word(declaration * 14u + 9u);
        if (start > dependency_member_count() || count > dependency_member_count() - start) continue;
        uint fields = 0u;
        for (uint member = start; member < start + count; member++)
            if (dependency_member_word(member * SEMANTIC_INTERFACE_MEMBER_WORDS + 1u) == 4u) fields++;
        uint target = atomic_u32_add(imported_field_ref_total, 0u, fields);
        if (target > capacity || fields > capacity - target)
        { record_min_token_error(status, min(instance, gParams.n_tokens - 1u), 6u, 0x474e0001u); return; }
        uint ordinal = 0u;
        for (uint member = start; member < start + count; member++)
        {
            if (dependency_member_word(member * SEMANTIC_INTERFACE_MEMBER_WORDS + 1u) != 4u) continue;
            uint2 reference;
            bool resolved = canonical_checked_reference<ScopedCheckedTypeGraph>(instance,
                dependency_member_word(member * SEMANTIC_INTERFACE_MEMBER_WORDS + 7u), checked_type_capacity(),
                gParams.n_tokens, type_instance_lookup_head, type_instance_lookup_next, reference);
            imported_field_ref_tag[target + ordinal] = resolved ? reference.x : 0u;
            imported_field_ref_payload[target + ordinal] = resolved ? reference.y : INVALID;
            ordinal++;
        }
        imported_field_ref_start[instance] = target;
        imported_field_ref_count[instance] = fields;
    }
}
