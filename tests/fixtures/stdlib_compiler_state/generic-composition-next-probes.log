import core::mem;
struct Wrap<T> { before: i32, value: T, after: i32 }
fn wrap<T>(value: T) -> Wrap<T> { return Wrap { before: -7, value: value, after: 99 }; }
fn make<T>(value: T) -> Wrap<Wrap<T>> { return wrap(wrap(value)); }
fn main() -> i32 { let value = make([11, 22]); let copied = core::mem::identity(value); if (copied.value.value[0] != 11 || copied.value.value[1] != 22 || copied.before != -7 || copied.value.after != 99) { return 1; } copied.value.value[0] = 33; if (value.value.value[0] != 11) { return 2; } return 0; }

