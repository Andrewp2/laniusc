CASE generic_mutually_recursive_pair
SOURCE
struct Pair { number: i32, flag: bool }
fn relay<T>(value: T, depth: i32) -> T { if (depth == 0) { return value; } return other(value, depth - 1); }
fn other<T>(value: T, depth: i32) -> T { return relay(value, depth); }
fn main() -> i32 { let original: Pair = Pair { number: 41, flag: true }; let result: Pair = relay(original, 6); if (result.number != 41 || !result.flag) { return 1; } result.number = 7; if (original.number != 41) { return 2; } return 0; }

