import core::mem;
struct Cell<T> { value: T }
fn cells<T>(value: T) -> [Cell<T>; 2] { return [Cell { value: value }, Cell { value: value }]; }
fn build<T>(value: T) -> [Cell<[Cell<T>; 2]>; 2] { return cells(cells(value)); }
fn main() -> i32 { let values = build(false); let copied = core::mem::identity(values); if (copied[0].value[1].value || copied[1].value[0].value) { return 1; } copied[0].value[1].value = true; if (values[0].value[1].value || copied[0].value[0].value || !copied[0].value[1].value) { return 2; } return 0; }

