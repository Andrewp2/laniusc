struct Cell<T> { value: T }
fn keep<T>(value: T) -> T { return value; }
fn helper(limit: i32) -> i32 {
    let sum: i32 = 0;
    let index: i32 = 0;
    while (index < limit) {
        sum = sum + index;
        index = index + 1;
    }
    return keep(sum);
}
impl<T> Cell<T> {
    fn get(&self, fallback: T) -> T {
        if (helper(4) == 6) { return self.value; }
        return fallback;
    }
    fn relay(&self, fallback: T) -> T { return self.get(fallback); }
}
fn main() -> i32 {
    let integer: Cell<i32> = Cell { value: 42 };
    let boolean: Cell<bool> = Cell { value: true };
    if (integer.get(0) != 42 || integer.relay(0) != 42) { return 1; }
    if (!boolean.get(false) || !boolean.relay(false)) { return 2; }
    return 0;
}
