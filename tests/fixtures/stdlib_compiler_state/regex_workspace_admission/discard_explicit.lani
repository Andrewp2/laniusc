// Standalone Result<bool, Error> success-discard compiler reduction.
module app::main;
import core::result::Result;
import core::result::Ok;
import core::result::Err;

pub enum Error { Failure }
pub struct Span { start: i32, end: i32 }
fn probe(kind: i32) -> Result<bool,Error> {
    if (kind < 0) { return Err(Error::Failure); }
    return Ok(kind > 0);
}
fn selected(kind: i32) -> Result<Span,Error> {
    let result = probe(kind);
    if (result.is_err()) { return Err(result.unwrap_err()); }
    return Ok(Span { start: 2, end: 3 });
}
fn main() -> i32 {
    let first = selected(0).unwrap();
    assert(first.start == 2 && first.end == 3);
    let second = selected(1).unwrap();
    assert(second.start == 2 && second.end == 3);
    assert(selected(-1).is_err());
    return 0;
}
