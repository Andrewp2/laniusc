// Ordinary callables apply their final segment. An enum constructor can apply
// its resolved parent type instead; name resolution owns that distinction.
// Method receiver arguments still belong to the separate receiver producer.
import hir_records;

public uint explicit_variant_application_token(uint leaf, uint qualifier, uint token_capacity,
    StructuredBuffer<HirRange> arguments, out bool repeated)
{
    repeated = false;
    if (qualifier >= token_capacity || arguments[qualifier].count == 0u) return leaf;
    repeated = leaf < token_capacity && arguments[leaf].count != 0u;
    return qualifier;
}

public uint explicit_callable_application_token(uint call, uint hir_count, uint token_capacity,
    StructuredBuffer<HirCore> cores, StructuredBuffer<HirLinks> links,
    StructuredBuffer<HirPayload> payloads, StructuredBuffer<uint> path_ids,
    StructuredBuffer<uint> path_count, StructuredBuffer<HirPath> paths,
    StructuredBuffer<HirPathSegment> segments, StructuredBuffer<uint> type_qualifiers,
    StructuredBuffer<HirRange> arguments, out uint leaf, out bool repeated)
{
    leaf = 0xffffffffu;
    repeated = false;
    if (call >= hir_count || cores[call].kind != 19u) return 0xffffffffu;
    uint callee = payloads[call].a;
    if (callee >= hir_count) return 0xffffffffu;
    if (cores[callee].kind == 21u) { leaf = payloads[callee].c; return leaf; }
    if (cores[callee].kind == 22u) callee = links[callee].first_child;
    if (callee >= hir_count || cores[callee].kind != 33u) return 0xffffffffu;
    uint path = path_ids[callee];
    if (path >= min(path_count[0u], hir_count)) return 0xffffffffu;
    HirPath record = paths[path];
    if (record.owner != callee || record.segment_count == 0u ||
        record.segment_start >= token_capacity ||
        record.segment_count > token_capacity - record.segment_start) return 0xffffffffu;
    leaf = segments[record.segment_start + record.segment_count - 1u].name_token;
    return explicit_variant_application_token(leaf, type_qualifiers[path], token_capacity,
        arguments, repeated);
}
