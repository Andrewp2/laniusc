// Paired control for 01: caller explicitly projects IntoIterError::Remaining.
module app::main;
import alloc::clone;
import alloc::string;
import alloc::vec;
import core::iter;
import core::option;
import core::result;
fn text(byte: u8) -> alloc::string::String { let bytes: [u8; 1] = [byte]; return alloc::string::from_utf8(bytes, 1).unwrap(); }
fn main() -> i32 {
    let batch: alloc::vec::Vec<alloc::string::String> = alloc::vec::with_capacity<alloc::string::String>(2).unwrap();
    batch.try_push(text(65)).unwrap(); batch.try_push(text(66)).unwrap();
    let cursor: alloc::vec::IntoIter<alloc::string::String> = batch.take_iter();
    assert(batch.is_empty() && batch.capacity() == 0 && cursor.remaining() == 2);
    let first: alloc::string::String = cursor.next().unwrap(); assert(first.byte_at(0).unwrap() == 65); first.destroy();
    let refusal: core::option::Option<alloc::vec::IntoIterError> = cursor.try_finish();
    let error: alloc::vec::IntoIterError = refusal.unwrap();
    assert(match (error) { alloc::vec::IntoIterError::Remaining(count) -> count == 1 });
    alloc::clone::destroy_vec_iter<alloc::string::String>(cursor.borrow());
    assert(cursor.remaining() == 0 && cursor.capacity() == 0); batch.destroy(); return 0;
}
