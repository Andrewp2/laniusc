struct Record { value : i32 , sentinel : i32 }
fn keep<T>(value:T)->T { return value; }
fn main()->i32 {
 let original:Decision = Owned(42);
 let copied:Decision = keep(original);
 let record:Record = Record{value:13,sentinel:97};
 let other:Record = keep(record);
 let got:i32 = match(copied) {Owned(value)->value, _->0};
 if(got!=42 || other.value!=13 || other.sentinel!=97) {return 1;}
 return 0;
}
