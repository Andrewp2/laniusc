// Smaller control: generic element T, concrete OwnerFailure E.
module app::main;
import alloc::string;
import alloc::vec;
import core::mem;
import core::result;
import core::slice;
import probe::owners;
import probe::vec_clone_pair_error;
fn main() -> i32 {
    let a: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::string_data_ptr("left"),4);
    let b: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::string_data_ptr("R\0!"),3);
    let left: alloc::string::String = alloc::string::from_utf8(a,4).unwrap();
    let right: alloc::string::String = alloc::string::from_utf8(b,3).unwrap();
    let first: probe::owners::Pair = probe::owners::Pair { left:left,right:right,tag:100,fail:0 };
    let second: probe::owners::Pair = probe::owners::Pair { left:left,right:right,tag:101,fail:0 };
    let bad: probe::owners::Pair = probe::owners::Pair { left:left,right:right,tag:102,fail:1 };
    let input: [probe::owners::Pair;3] = [first,second,bad];
    let result: core::result::Result<alloc::vec::Vec<probe::owners::Pair>,probe::vec_clone_pair_error::Failure<probe::owners::OwnerFailure>> = probe::vec_clone_pair_error::from_view<probe::owners::Pair>(core::slice::view(input,3).unwrap());
    assert(result.is_err());
    assert(match(result.unwrap_err()) {
        probe::vec_clone_pair_error::Failure::Storage(e) -> match(e) { alloc::vec::Error::AllocationFailed -> true, _ -> false },
        probe::vec_clone_pair_error::Failure::Element(i,e) -> match(e) {
            probe::owners::OwnerFailure::Injected(tag,phase,marker) -> i == 2 && tag == 102 && phase == 1 && marker == 18446744073709551610,
            probe::owners::OwnerFailure::Allocation(tag,phase,inner) -> i >= 0 && i <= 2 && tag == 100+i && (phase == 1 || phase == 2) && match(inner) { alloc::string::Error::AllocationFailed -> true, _ -> false }
        },
        _ -> false
    });
    assert(left.byte_at(0).unwrap() == 108 && left.byte_len() == 4 && right.byte_at(1).unwrap() == 0 && right.byte_len() == 3);
    left.destroy(); right.destroy(); return 0;
}
