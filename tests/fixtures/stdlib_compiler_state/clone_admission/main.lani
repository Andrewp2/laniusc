module app::main;
import alloc::string;
import alloc::vec;
import core::mem;
import core::result;
import core::slice;
import probe::owners;
import probe::protocol;
import probe::vec_clone;

fn text(value: str, count: i32) -> core::result::Result<alloc::string::String,alloc::string::Error> {
    let raw: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::string_data_ptr(value),count);
    return alloc::string::from_utf8(raw,count);
}
fn allocation(error: alloc::string::Error) -> bool { return match(error) { alloc::string::Error::AllocationFailed -> true, _ -> false }; }
fn vec_allocation(error: alloc::vec::Error) -> bool { return match(error) { alloc::vec::Error::AllocationFailed -> true, _ -> false }; }
fn strings() -> i32 {
    let made = text("A\0é",4); if (made.is_err()) { assert(allocation(made.unwrap_err())); return 10; }
    let source: alloc::string::String = made.unwrap();
    let empty: alloc::string::String = alloc::string::new();
    let aliases: [alloc::string::String;5] = [empty,source,source,source,empty];
    let input: core::slice::View<alloc::string::String> = core::slice::view_range(aliases,1,3).unwrap();
    let result: core::result::Result<alloc::vec::Vec<alloc::string::String>,probe::vec_clone::Failure<alloc::string::Error>> = probe::vec_clone::from_view<alloc::string::String,alloc::string::Error>(input);
    if (result.is_err()) {
        assert(source.byte_len() == 4 && source.byte_at(1).unwrap() == 0 && source.byte_at(3).unwrap() == 169);
        assert(match(result.unwrap_err()) { probe::vec_clone::Failure::Storage(e) -> vec_allocation(e), probe::vec_clone::Failure::Element(i,e) -> i >= 0 && i < 3 && allocation(e), _ -> false });
        source.destroy(); return 20;
    }
    let copy: alloc::vec::Vec<alloc::string::String> = result.unwrap(); assert(copy.len() == 3);
    let last: alloc::string::String = copy.pop().unwrap(); source.destroy();
    assert(copy.at(0).byte_len() == 4 && copy.at(1).byte_at(1).unwrap() == 0 && last.byte_at(3).unwrap() == 169);
    let edited = last.try_push_scalar(33); if (edited.is_err()) { assert(allocation(edited.unwrap_err())); }
    assert(copy.at(0).byte_at(0).unwrap() == 65 && copy.at(1).byte_at(3).unwrap() == 169);
    last.destroy(); assert(copy.at(0).byte_at(1).unwrap() == 0 && copy.at(1).byte_at(2).unwrap() == 195);
    probe::vec_clone::destroy_vec<alloc::string::String>(copy.borrow()); assert(copy.len() == 0 && copy.capacity() == 0);
    return 0;
}
fn pairs() -> i32 {
    let first = text("left",4); if (first.is_err()) { assert(allocation(first.unwrap_err())); return 40; }
    let left: alloc::string::String = first.unwrap();
    let second = text("R\0!",3); if (second.is_err()) { assert(allocation(second.unwrap_err())); left.destroy(); return 40; }
    let right: alloc::string::String = second.unwrap();
    let source: probe::owners::Pair = probe::owners::Pair { left:left,right:right,tag:100,fail:0 };
    let aliases: [probe::owners::Pair;4] = [source,source,source,source];
    aliases[1] = probe::owners::Pair { left:left,right:right,tag:101,fail:0 };
    aliases[2] = probe::owners::Pair { left:left,right:right,tag:102,fail:1 };
    aliases[3] = probe::owners::Pair { left:left,right:right,tag:103,fail:0 };
    let input = core::slice::view(aliases,4).unwrap();
    let result: core::result::Result<alloc::vec::Vec<probe::owners::Pair>,probe::vec_clone::Failure<probe::owners::OwnerFailure>> = probe::vec_clone::from_view<probe::owners::Pair,probe::owners::OwnerFailure>(input);
    assert(result.is_err());
    assert(match(result.unwrap_err()) {
        probe::vec_clone::Failure::Storage(e) -> vec_allocation(e),
        probe::vec_clone::Failure::Element(i,e) -> match(e) {
            probe::owners::OwnerFailure::Injected(tag,phase,marker) -> i == 2 && tag == 102 && phase == 1 && marker == 18446744073709551610,
            probe::owners::OwnerFailure::Allocation(tag,phase,inner) -> i >= 0 && i <= 2 && tag == 100+i && (phase == 1 || phase == 2) && allocation(inner)
        },
        _ -> false
    });
    assert(left.byte_len() == 4 && left.byte_at(0).unwrap() == 108 && right.byte_len() == 3 && right.byte_at(1).unwrap() == 0);
    left.destroy(); right.destroy(); return 0;
}
fn main() -> i32 {
    let a: i32 = strings(); if (a != 0) { return a; }
    return pairs();
}
