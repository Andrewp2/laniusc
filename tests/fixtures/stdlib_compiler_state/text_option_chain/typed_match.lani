module app::main;
import core::iter;
import core::option;
import core::result;
import core::slice;
fn ended<I,T>(source:&I) where I:core::iter::Iterator<T> {
    let value:core::option::Option<T> =source.next();
    assert(match(value) { core::option::None -> true,_ -> false });
}
fn main() -> i32 {
    let backing:[i32;1]=[7];
    let selected:core::slice::View<i32> =core::slice::view(backing,0).unwrap();
    let source:core::slice::Iter<i32> =selected.iter();
    ended<core::slice::Iter<i32>,i32>(source.borrow()); return 0;
}
