// Imported reference acquisition with symbolic capacity.
module app::main;
import core::vec;
fn count<T, const N: usize>(value: core::vec::Vec<T, N>) -> i32 {
    let borrowed: &core::vec::Vec<T,
    N> = value.borrow();
    return core::vec::len(borrowed);
}
fn main() -> i32 {
    let value: core::vec::Vec<i32,
    2> = core::vec::from_array([1, 2]);
    return count(value) - 2;
}
