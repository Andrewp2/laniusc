// Imported reference acquisition with concrete capacity.
module app::main;
import core::vec;
fn count<T>(value: core::vec::Vec<T, 2>) -> i32 {
    let borrowed: &core::vec::Vec<T,
    2> = value.borrow();
    return core::vec::len(borrowed);
}
fn main() -> i32 {
    let value: core::vec::Vec<i32,
    2> = core::vec::from_array([1, 2]);
    return count(value) - 2;
}
