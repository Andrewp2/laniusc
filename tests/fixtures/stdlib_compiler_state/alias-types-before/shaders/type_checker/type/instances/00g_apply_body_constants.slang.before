import type_checker.constant_parameter_slots;
// Install the selected body's checked constant values after generic signature
// validation and aggregate rebuilding. Source/interface signatures stay symbolic.
import hir_records;

struct Params { uint n_tokens; uint source_len; uint n_hir_nodes; };
ConstantBuffer<Params> gParams;
StructuredBuffer<uint> compact_hir_count;
StructuredBuffer<HirCore> compact_hir_core;
StructuredBuffer<HirRange> compact_generic_param_ranges;
StructuredBuffer<uint> generic_decl_owner_by_node_a;
StructuredBuffer<uint> interface_public_decl_index_by_hir;
StructuredBuffer<uint4> body_specialization_inputs;
RWStructuredBuffer<uint> type_instance_len_kind;
RWStructuredBuffer<uint> type_instance_len_payload;

uint active_hir_node_count() { return min(gParams.n_hir_nodes, compact_hir_count[0u]); }
#include "body_specialization_owner.slang"

[shader("compute")]
[numthreads(256, 1, 1)]
void main(uint3 dtid : SV_DispatchThreadID)
{
    uint count = min(body_specialization_inputs[705u].x, 32u);
    if (count == 0u) return;
    uint node = dtid.x + dtid.y * 65535u * 256u;
    if (node >= active_hir_node_count() || compact_hir_core[node].kind != 5u ||
        !body_specialization_selects_owner(generic_decl_owner_by_node_a[node])) return;
    uint token = compact_hir_core[node].token_start;
    if (token >= gParams.n_tokens || type_instance_len_kind[token] != 2u) return;
    uint parameter = type_instance_len_payload[token];
    uint slot = parameter < gParams.n_tokens ? type_const_param_slot_by_token[parameter] : 0xffffffffu;
    if (slot >= count) return;
    uint4 argument = body_specialization_inputs[706u + slot];
    if (argument.x != slot || argument.y == 0xffffffffu) return;
    type_instance_len_kind[token] = 1u;
    type_instance_len_payload[token] = argument.y;
}
