enum View<T> { Present(T, i32) }
fn main() -> i32 {
    let data: [i32; 2] = [19, 23];
    let wrapped = View<[i32]>::Present(data, 7);
    let view = match (wrapped) { View::Present(values, tail) -> values };
    let tail = match (wrapped) { View::Present(values, tail) -> tail };
    if (tail != 7) { return 2; }
    view[0] = 20;
    data[1] = 22;
    if (view[0] + view[1] != 42 || data[0] != 20) { return 1; }
    return 0;
}
