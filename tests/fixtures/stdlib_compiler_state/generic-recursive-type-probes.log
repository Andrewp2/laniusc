import core::option;
import core::mem;
struct Node<T> { value: T, next: core::option::Option<&Node<T>> }
impl<T> Node<T> { fn borrow(&self) -> &Node<T> { return self; } }
fn walk<T>(value: &Node<T>, depth: i32) -> &Node<T> {
    if (depth == 0) { return value; }
    let next: &Node<T> = core::option::unwrap_or(value.next, value);
    return walk(next, depth - 1);
}
fn main() -> i32 {
    let node: Node<i32> = Node { value: 11, next: core::option::None() };
    node.next = core::option::Some(node.borrow());
    let copied: Node<i32> = core::mem::identity(node);
    copied.value = 77;
    node.value = 42;
    let current: &Node<i32> = core::option::unwrap_or(copied.next, node.borrow());
    if (current.value != 42 || copied.value != 77 || node.value != 42) { return 1; }
