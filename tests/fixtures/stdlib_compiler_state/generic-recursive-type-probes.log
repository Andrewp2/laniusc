CASE ordinary_recursive_reference
SOURCE
import core::option;
import core::mem;
struct Node { value: i32, next: core::option::Option<&Node> }
impl Node { fn borrow(&self) -> &Node { return self; } }
fn walk(value: &Node, depth: i32) -> &Node {
    if (depth == 0) { return value; }
    let next: &Node = core::option::unwrap_or(value.next, value);
    return walk(next, depth - 1);
}
fn main() -> i32 {
    let node: Node = Node { value: 11, next: core::option::None() };
    node.next = core::option::Some(node.borrow());
    let copied: Node = core::mem::identity(node);
    copied.value = 77;
    node.value = 42;
    let current: &Node = walk(copied.borrow(), 4);
    if (current.value != 42 || copied.value != 77 || node.value != 42) { return 1; }
    return 0;
}

