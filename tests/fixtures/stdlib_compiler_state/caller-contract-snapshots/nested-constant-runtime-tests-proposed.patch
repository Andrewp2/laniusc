diff --git a/tests/fixtures/stdlib_compiler_state/caller-contract-snapshots/nested-symbolic-constant-bound-runtime.lani b/tests/fixtures/stdlib_compiler_state/caller-contract-snapshots/nested-symbolic-constant-bound-runtime.lani
new file mode 100644
