struct Cell<T> { value:T }
type Pair = [i32;2];
trait Rel<A,B,C,D,E,F> {}
impl Rel<Cell<Pair>, [bool;0], [str], &Cell<i32>, [[i32;2];2], str> for bool {}
fn keep<T>(v:T)->T where T: Rel<Cell<[i32;2]>, [bool;0], [str], &Cell<i32>, [[i32;2];2], str> {return v;}
fn main()->i32 {if(keep(false)){return 1;} return 0;}
