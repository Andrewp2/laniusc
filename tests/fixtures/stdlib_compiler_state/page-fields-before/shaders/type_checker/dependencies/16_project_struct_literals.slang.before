import semantic_interface_layout;
// Check imported record constructors while their immutable interface page is
// active. Only stable checked references and field ordinals survive the page.
import dependency_interface;
import hir_records;
import gpu_index;
import status;
import type_checker.checked_scoped_types;
import type_checker.checked_type_graph;
import type_checker.concrete_type_equality;
import type_checker.dependencies.record_fields;

struct Params { uint type_count; uint declaration_count; uint member_count; uint path_capacity; uint token_capacity; };
ConstantBuffer<Params> gParams;
StructuredBuffer<uint> compact_hir_count;
StructuredBuffer<HirCore> compact_hir_core;
StructuredBuffer<HirPayload> compact_hir_payload;
StructuredBuffer<uint> compact_field_count;
StructuredBuffer<HirField> compact_fields;
StructuredBuffer<uint> name_id_by_token;
StructuredBuffer<uint> name_hash_lo;
StructuredBuffer<uint> name_hash_hi;
StructuredBuffer<uint> struct_lit_context_instance;
StructuredBuffer<uint> type_expr_ref_tag;
StructuredBuffer<uint> type_expr_ref_payload;
RWStructuredBuffer<uint> struct_init_field_context_instance;
RWStructuredBuffer<uint> struct_init_field_expected_ref_tag;
RWStructuredBuffer<uint> struct_init_field_expected_ref_payload;
RWStructuredBuffer<uint> struct_init_field_expected_context_instance;
RWStructuredBuffer<uint> struct_init_field_ordinal;
RWStructuredBuffer<uint> struct_init_field_ordinal_by_row;
RWStructuredBuffer<uint> status;

static const uint INVALID = 0xffffffffu;

bool member_matches(uint member, uint token)
{
    uint name = name_id_by_token[token];
    return name < gParams.token_capacity &&
        dependency_member_word(member * SEMANTIC_INTERFACE_MEMBER_WORDS + 3u) == name_hash_lo[name] &&
        dependency_member_word(member * SEMANTIC_INTERFACE_MEMBER_WORDS + 4u) == name_hash_hi[name];
}

[shader("compute")]
[numthreads(256, 1, 1)]
void main(uint3 dtid: SV_DispatchThreadID)
{
    uint node = linear_dispatch_thread_id_2d(dtid, 16776960u);
    uint hir_count = min(compact_hir_count[0u], gParams.path_capacity);
    if (node >= hir_count || compact_hir_core[node].kind != 28u) return;
    uint instance = struct_lit_context_instance[node];
    if (instance >= checked_type_capacity() || type_instance_kind[instance] != 1u ||
        type_instance_decl_token[instance] != INVALID || external_type_library_id[instance] == INVALID) return;
    uint decl = dependency_find_declaration(external_type_library_id[instance],
        external_type_unit_id[instance], external_type_local_index[instance]);
    if (decl >= dependency_declaration_count() || dependency_declaration_word(decl * 14u + 6u) != 6u) return;
    uint constructor = compact_hir_core[node].token_start;
    if (constructor >= gParams.token_capacity ||
        external_type_library_id[constructor] != external_type_library_id[instance] ||
        external_type_unit_id[constructor] != external_type_unit_id[instance] ||
        external_type_local_index[constructor] != external_type_local_index[instance])
    {
        record_min_token_error(status, constructor, 3u, 0u); return;
    }
    // Explicit constructor arguments remain a checked constraint. A matching
    // nominal declaration does not authorize replacing different arguments.
    if (type_expr_ref_tag[constructor] == 3u &&
        checked_instance_is_closed(type_expr_ref_payload[constructor], gParams.token_capacity) &&
        !concrete_type_refs_equal<ScopedCheckedTypeGraph>(3u, instance,
            3u, type_expr_ref_payload[constructor], checked_type_capacity()))
    { record_min_token_error(status, constructor, 3u, 0u); return; }
    uint start = dependency_declaration_word(decl * 14u + 8u);
    uint count = dependency_declaration_word(decl * 14u + 9u);
    if (start > dependency_member_count() || count > dependency_member_count() - start) return;
    HirPayload literal = compact_hir_payload[node];
    uint fields = min(compact_field_count[0u], gParams.path_capacity);
    if (literal.c != 0u && (literal.b >= fields || literal.c > fields - literal.b)) return;
    uint ordinal = 0u;
    for (uint member = start; member < start + count; member++)
    {
        if (dependency_member_word(member * SEMANTIC_INTERFACE_MEMBER_WORDS + 1u) != 4u) continue;
        uint found = INVALID;
        for (uint field = literal.b; field < literal.b + literal.c; field++)
        {
            HirField value = compact_fields[field];
            if (value.owner != node || value.name_token >= gParams.token_capacity ||
                !member_matches(member, value.name_token)) continue;
            if (found != INVALID)
            { record_min_token_error(status, value.name_token, 8u, 4u); return; }
            found = field;
        }
        if (found == INVALID)
        { record_min_token_error(status, constructor, 8u, 3u); return; }
        HirField value = compact_fields[found];
        uint tag; uint payload;
        if (!imported_record_field_type(instance, dependency_member_word(member * SEMANTIC_INTERFACE_MEMBER_WORDS + 7u), ordinal, tag, payload))
        { record_min_token_error(status, value.name_token, 6u, 0x474e0004u); return; }
        struct_init_field_context_instance[value.name_token] = instance;
        struct_init_field_expected_ref_tag[value.name_token] = tag;
        struct_init_field_expected_ref_payload[value.name_token] = payload;
        // Dependency projection already resolves fields in caller scope.
        struct_init_field_expected_context_instance[value.name_token] = INVALID;
        struct_init_field_ordinal[value.name_token] = ordinal++;
        struct_init_field_ordinal_by_row[found] = ordinal - 1u;
    }
    if (ordinal != literal.c)
        for (uint field = literal.b; field < literal.b + literal.c; field++)
            if (struct_init_field_ordinal[compact_fields[field].name_token] == INVALID)
                record_min_token_error(status, compact_fields[field].name_token, 8u, 0u);
}
