// A reference into a machine is read before the machine steps (M4).
enum Tick { Up, Reset }
struct Log { count: i32, resets: i32 }
impl Log { fn view(&self) -> &Log { return self; } }

machine Counter on Tick {
    log: Log,
    start Counting;

    state Counting {
        Tick::Up -> { self.log.count += 1; stay; },
        Tick::Reset -> { self.log.resets += 1; goto Idle; },
    }
    state Idle {
        Tick::Up -> { self.log.count = 1; goto Counting; },
        Tick::Reset -> stay,
    }
}

fn main() -> i32 {
    let m: Counter = counter_start(Log { count: 0, resets: 0 });
    m.step(Tick::Up);
    let view: &Log = m.log.view();
    let seen: i32 = view.count;
    m.step(Tick::Up);
    // A new reference after the step sees the new value.
    let again: &Log = m.log.view();
    if (seen != 1 || again.count != 2) { return 1; }
    return 0;
}
