// The design document's SumNumbers: integer events, no output.
machine SumNumbers on u8 {
    total: i64,
    start Between;

    state Between {
        c -> {
            if (c >= 48 && c <= 57) { goto InNumber((c - 48) as i64); }
            stay;
        },
    }
    state InNumber(value: i64) {
        c -> {
            if (c >= 48 && c <= 57) { goto InNumber(value * 10 + (c - 48) as i64); }
            self.total = self.total + value;
            goto Between;
        },
    }
}

fn main() -> i32 {
    let text: [u8; 12] = [49, 50, 32, 51, 52, 53, 120, 54, 32, 32, 55, 48];
    let m: SumNumbers = sum_numbers_start(0);
    let index: i32 = 0;
    while (index < 12) { m.step(text[index]); index += 1; }
    let total: i64 = match (m.state()) {
        SumNumbersState::InNumber(v) -> m.total + v,
        SumNumbersState::Between -> m.total,
    };
    // 12 + 345 + 6 + 70
    if (total != 433) { return 1; }
    return 0;
}
