module app::main;
import core::result;

fn wide(x: i32) -> core::result::Result<i32, i64> { return core::result::Ok(x); }

// `?` never converts: the i64 error cannot leave a function whose error is i32.
fn f(x: i32) -> core::result::Result<i32, i32> {
    let y = wide(x)?;
    return core::result::Ok(y);
}

fn main() -> i32 { return f(1).unwrap(); }
