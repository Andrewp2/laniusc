// `slice_len` counts the elements of a slice or of an array passed as one.
// `string_len` counts the bytes of a `str`. Each result is a `usize`.
import core::mem;

struct Bag { items: [i32; 3], name: str }

fn total(values: [i32]) -> i32 {
    let count: i32 = slice_len(values) as i32;
    let sum = 0;
    let i = 0;
    while (i < count) { sum = sum + values[i]; i = i + 1; }
    return sum;
}

fn count<T>(values: [T]) -> usize {
    return core::mem::slice_len(values);
}

fn bytes(text: str) -> i32 {
    return string_len(text) as i32;
}

fn pass(values: [i32]) -> [i32] { return values; }

fn main() -> i32 {
    let five: [i32; 5] = [1, 2, 3, 4, 5];
    print(total(five));
    let packed: [u8; 3] = [7, 8, 9];
    let wide: [i64; 6] = [0; 6];
    print(count(packed) as i32);
    print(count(wide) as i32);
    print(bytes("hello"));
    print(bytes(""));
    print(string_len("héllo") as i32);
    let bag = Bag { items: [4, 5, 6], name: "bag" };
    print(slice_len(bag.items) as i32);
    print(core::mem::string_len(bag.name) as i32);
    let grid: [[i32; 2]; 3] = [[1, 2], [3, 4], [5, 6]];
    print(slice_len(grid) as i32);
    print(slice_len(grid[0]) as i32);
    print(slice_len(pass(bag.items)) as i32);
    let length: usize = slice_len(five);
    if (length != 5) { return 1; }
    return 0;
}
