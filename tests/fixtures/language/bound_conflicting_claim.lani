// The explicit T = i64 disagrees with Counter's Iterator<i32>.
module app::main;
import core::iter;
import core::option;

struct Counter { n: i32, end: i32 }
impl Counter {
    fn borrow(&self) -> &Counter { return self; }
}
pub impl core::iter::Iterator<i32> for Counter {
    pub fn next(&self) -> core::option::Option<i32> {
        if (self.n >= self.end) { return core::option::None(); }
        let value: i32 = self.n;
        self.n = self.n + 1;
        return core::option::Some(value);
    }
}

fn main() -> i32 {
    let counter = Counter { n: 1, end: 4 };
    let indexed = core::iter::enumerate_from<Counter,i64>(counter.borrow(), 10);
    return 0;
}
