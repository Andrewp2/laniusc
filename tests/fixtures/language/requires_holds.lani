// `requires` conditions are checked on entry; these all hold.
fn halve(n: i32) -> i32 requires (n >= 0) requires (n % 2 == 0) { return n / 2; }

struct Window { width: i32 }
impl Window {
    fn shrink(self, by: i32) -> i32 requires (by > 0 && by < self.width) {
        return self.width - by;
    }
}

fn main() -> i32 {
    let w: Window = Window { width: 10 };
    if (halve(8) + w.shrink(3) != 11) { return 1; }
    return 0;
}
