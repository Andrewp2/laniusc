// `else if` continues an `if` statement without a nested block. The first
// true condition selects its arm, and later conditions are not evaluated.
fn classify(n: i32) -> i32 {
    if (n < 0) {
        return 1;
    } else if (n == 0) {
        return 2;
    } else if (n < 10) {
        return 3;
    } else {
        return 4;
    }
}

// A chain without a final `else` runs no arm when every condition is false.
fn grade(n: i32) -> i32 {
    let result = 0;
    if (n > 90) {
        result = 5;
    } else if (n > 80) {
        result = 4;
    } else if (n > 70) {
        result = 3;
    }
    return result;
}

// Prints its tag, so the output shows which conditions were evaluated.
fn noted(tag: i32, value: bool) -> bool {
    print(tag);
    return value;
}

fn main() -> i32 {
    print(classify(-5));
    print(classify(0));
    print(classify(7));
    print(classify(70));
    print(grade(95));
    print(grade(85));
    print(grade(75));
    print(grade(10));
    let total = 0;
    for i in 0..10 {
        if (i % 3 == 0) {
            total += 100;
        } else if (i % 3 == 1) {
            let step = 10;
            total += step;
        } else {
            if (i == 8) { continue; } else if (i == 5) { total += 1000; }
            total += 1;
        }
    }
    print(total);
    if (noted(10, false)) {
        print(-1);
    } else if (noted(11, true)) {
        print(12);
    } else if (noted(13, true)) {
        print(-2);
    }
    return 0;
}
