// Distinct types: values of one distinct type mix with each other and with
// literals; a cast converts to and from the target type.
type Meters = distinct i64;
type Seconds = distinct i64;
type Span = Meters;

struct Leg { length: Meters, time: Seconds }

fn twice(m: Meters) -> Meters { return m + m; }
fn speed(leg: Leg) -> i64 { return leg.length as i64 / leg.time as i64; }

fn main() -> i32 {
    let distinct: i64 = 3;
    let a: Meters = 40;
    let b = twice(a) + 2;
    let c: Span = b;
    let total: Meters = c;
    total += a * 2;
    let leg: Leg = Leg { length: total, time: 7 };
    if (total < a) { return 2; }
    let raw: i64 = total as i64 + distinct;
    let back: Meters = raw as Meters;
    if (back != 165 || speed(leg) != 23) { return 1; }
    return 0;
}
