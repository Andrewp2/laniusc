type Meters = distinct i64;
struct Odometer { total: Meters }
impl Odometer {
    fn add(self, m: Meters) -> Meters { return self.total + m; }
}
fn main() -> i32 {
    let o: Odometer = Odometer { total: 40 };
    let step: Meters = 2;
    let m: Meters = o.add(step) + o.add(0);
    if (m as i64 != 82) { return 1; }
    return 0;
}
