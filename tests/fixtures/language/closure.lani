// Closures: a typed parameter or none, captures by value, an expression or
// a block body.
module app::main;

import core::option::Option;
import core::option::Some;

struct Item { price: i32 }

impl Item {
    fn cost(&self) -> i32 { return self.price; }
    fn borrow(&self) -> &Item { return self; }
}

fn add(a: i32, b: i32) -> i32 { return a + b; }

fn twice<M>(mapper: &M, value: i32) -> i32 where M: core::function::Mapper<i32, i32> {
    return mapper.apply(mapper.apply(value));
}

fn price<M>(mapper: &M, item: &Item) -> i32 where M: core::function::Mapper<&Item, i32> {
    return mapper.apply(item);
}

fn make<P>(producer: &P) -> i32 where P: core::function::Producer<i32> {
    return producer.produce();
}

// A closure captures a parameter of its function.
fn scaled(factor: i32, value: i32) -> i32 {
    return twice(|x: i32| x * factor, value);
}

fn main() -> i32 {
    let offset: i32 = 3;
    let item: Item = Item { price: 20 };
    let some: Option<i32> = Some(4);

    // The typed `let` fixes the result type: 4 + 3 = 7.
    let mapped: Option<i32> = some.map(|x: i32| x + offset);

    // The bound fixes the result type: (1 + 3) + 3 = 7.
    let doubled: i32 = twice(|x: i32| x + offset, 1);

    // A block body declares its own locals and returns: 20 + (3 - 1) = 22.
    let costed: i32 = price(|entry: &Item| {
        let bonus: i32 = add(offset, 0) - 1;
        if (entry.cost() > 50) { return 0; }
        return entry.cost() + bonus;
    }, item.borrow());

    // A local of the body shadows the captured one: 20 + 1 = 21.
    let shadowed: i32 = price(|entry: &Item| {
        let offset: i32 = 1;
        return entry.cost() + offset;
    }, item.borrow());

    // No parameter, with a result type: 3 * 2 = 6.
    let made: i32 = make(|| -> i32 { return offset * 2; });

    // No captures.
    let plain: i32 = twice(|x: i32| x + 1, 0);

    // 7 + 7 + 22 + 21 + 6 + 2 + 12 = 77.
    return mapped.unwrap() + doubled + costed + shadowed + made + plain + scaled(2, 3);
}
