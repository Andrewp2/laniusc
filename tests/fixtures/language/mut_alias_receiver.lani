// The receiver is a `&mut self` argument; a field of it is passed as well.
struct Counter { total: i32 }
impl Counter {
    fn borrow(&self) -> &Counter { return self; }
}
struct Pair { left: Counter, right: Counter }
impl Pair {
    fn take(&mut self, other: &Counter) { self.left.total += other.total; }
}

fn main() -> i32 {
    let p: Pair = Pair { left: Counter { total: 1 }, right: Counter { total: 2 } };
    p.take(p.right.borrow());
    return p.left.total;
}
