module app::main;
import alloc::string;
import core::io;
import core::iter;
import core::mem;
import core::option;
import core::result;
import core::slice;
import core::text;
import ext::form;
import ext::form_owned;
import ext::uri;
fn view(bytes:[u8],start:i32,length:i32) -> core::slice::View<u8> { return core::slice::View { values:bytes,start:start,length:length }; }
fn literal(text:str,length:i32) -> core::slice::View<u8> { return view(core::mem::typed_slice_from_raw_parts<u8>(core::mem::string_data_ptr(text),length),0,length); }
fn equal(actual:core::slice::View<u8>,expected:core::slice::View<u8>) { assert(actual.length==expected.length); let i:i32=0; while(i<actual.length) { assert(actual.values[actual.start+i]==expected.values[expected.start+i]); i+=1; } }
fn string_equal(actual:alloc::string::String,expected:core::slice::View<u8>) { assert(actual.byte_len()==expected.length); let i:i32=0; while(i<expected.length) { assert(actual.byte_at(i).unwrap()==expected.values[expected.start+i]); i+=1; } }
fn generic_next<I>(cursor:&I,count:u64) -> core::option::Option<ext::form::Pair> where I:core::iter::Iterator<ext::form::Pair>, I:core::iter::ExactSizeIterator<ext::form::Pair> { assert(cursor.remaining_count()==count); let value:core::option::Option<ext::form::Pair> =cursor.next(); return value; }
fn owned_error(error:ext::form_owned::Error,expected:i32) {
    let actual:i32=match(error) { ext::form_owned::Error::Format(detail) -> match(detail) { ext::form::Error::InvalidLimits -> 1, ext::form::Error::Bounds -> 2, ext::form::Error::PairLimit -> 3, ext::form::Error::ComponentLimit -> 4, ext::form::Error::DecodedLimit -> 5, ext::form::Error::OutputLimit -> 6, _ -> 0 }, _ -> 0 }; assert(actual==expected);
}
fn contents(form:&ext::form_owned::Form,count:i32) {
    assert(form.len()==count && form.byte_len()==2*count-1); assert(form.pair(-1).is_none() && form.pair(count).is_none() && form.pair(2147483647).is_none());
    let names:[u8;5]=[97,97,0,98,107]; let values:[u8;5]=[49,32,0,255,126];
    let cursor:ext::form_owned::Pairs=form.pairs(); let first=generic_next<ext::form_owned::Pairs>(cursor.borrow(),count as u64).unwrap();
    assert(first.name.length==1 && first.name.values[first.name.start]==97 && first.value.values[first.value.start]==49);
    let fork:ext::form_owned::Pairs=cursor; let i:i32=1;
    while(i<count) {
        let actual=generic_next<ext::form_owned::Pairs>(cursor.borrow(),(count-i) as u64).unwrap();
        let copied=generic_next<ext::form_owned::Pairs>(fork.borrow(),(count-i) as u64).unwrap(); let indexed:ext::form::Pair=form.pair(i).unwrap();
        let name_length:i32=1; if(i==2) { name_length=0; }
        assert(actual.name.length==name_length && actual.value.length==1 && actual.value.values[actual.value.start]==values[i]);
        if(name_length>0) { assert(actual.name.values[actual.name.start]==names[i]); }
        equal(copied.name,actual.name); equal(copied.value,actual.value); equal(indexed.name,actual.name); equal(indexed.value,actual.value);
        assert(copied.name.start==actual.name.start && indexed.value.start==actual.value.start); i+=1;
    }
    let ended:core::option::Option<ext::form::Pair> =generic_next<ext::form_owned::Pairs>(cursor.borrow(),0); assert(ended.is_none());
    let ended_again:core::option::Option<ext::form::Pair> =generic_next<ext::form_owned::Pairs>(cursor.borrow(),0); assert(ended_again.is_none());
    let fork_end:core::option::Option<ext::form::Pair> =generic_next<ext::form_owned::Pairs>(fork.borrow(),0); assert(fork_end.is_none());
}
fn copied(form:&ext::form_owned::Form,expected:core::slice::View<u8>) {
    assert(ext::form::encoded_len(form.as_pairs()).unwrap()==expected.length as u64);
    let source:ext::form::Encoding=form.encoding(expected.length as u64).unwrap(); let output:[u8;64]=[199;64];
    let writer:core::io::SliceWriter=core::io::slice_writer(output,expected.length).unwrap(); let scratch:[u8;7]=[203;7];
    let copier:core::io::Copier<ext::form::Encoding,core::io::SliceWriter> =core::io::copier<ext::form::Encoding,core::io::SliceWriter>(source.borrow(),writer.borrow(),view(scratch,2,3)).unwrap();
    let steps:i32=0; let finished:bool=false;
    while(!finished) {
        let progress:core::io::CopyStep=copier.step(4,1).unwrap(); assert(progress.calls==1 && progress.read>=progress.written && progress.read-progress.written<=3);
        let stop:i32=match(progress.stop) { core::io::CopyStop::Eof -> 1, core::io::CopyStop::CallLimit -> 2, _ -> 0 }; assert(stop>0); finished=stop==1; steps+=1; assert(steps<64);
    }
    assert(copier.is_done() && copier.read_count()==expected.length as u64 && copier.written_count()==expected.length as u64 && copier.pending().length==0 && source.remaining()==0);
    equal(view(output,0,expected.length),expected); let i:i32=expected.length; while(i<64) { assert(output[i]==199); i+=1; }
    assert(scratch[0]==203 && scratch[1]==203 && scratch[5]==203 && scratch[6]==203);
}
fn owner_lifecycle() {
    let raw:core::slice::View<u8> =literal("a=1&a=+&=%00&b=%FF",18); let source:[u8;24]=[203;24]; let i:i32=0; while(i<18) { source[i+2]=raw.values[i]; i+=1; }
    let limits:ext::form::Limits=ext::form::Limits { max_input_bytes:18,max_pairs:5,max_component_bytes:2,max_decoded_bytes:9 };
    let form:ext::form_owned::Form=ext::form_owned::parse(view(source,2,18),limits).unwrap();
    // The parse owns independent decoded bytes; all source borrows have ended.
    i=2; while(i<20) { source[i]=200; i+=1; } contents(form.borrow(),4); copied(form.borrow(),raw);
    let invalid:ext::form::Pair=ext::form::Pair { name:view(source,-1,0),value:literal("",0) };
    owned_error(form.try_append(invalid).unwrap_err(),2); contents(form.borrow(),4);
    owned_error(form.try_append(ext::form::Pair { name:literal("abc",3),value:literal("",0) }).unwrap_err(),4); contents(form.borrow(),4);
    owned_error(form.try_append(ext::form::Pair { name:literal("xy",2),value:literal("zz",2) }).unwrap_err(),5); contents(form.borrow(),4);
    assert(form.try_append(ext::form::Pair { name:literal("k",1),value:literal("~",1) }).unwrap()==5); contents(form.borrow(),5);
    owned_error(form.try_append(ext::form::Pair { name:literal("",0),value:literal("",0) }).unwrap_err(),3); contents(form.borrow(),5);
    let expected:core::slice::View<u8> =literal("a=1&a=+&=%00&b=%FF&k=%7E",24); copied(form.borrow(),expected);
    owned_error(form.encode(-1).unwrap_err(),1); owned_error(form.encode(23).unwrap_err(),6); contents(form.borrow(),5);
    let output:alloc::string::String=form.encode(24).unwrap(); string_equal(output,expected);
    let byte_capacity:i32=form.bytes.capacity(); let span_capacity:i32=form.spans.capacity(); form.clear();
    assert(form.len()==0 && form.byte_len()==0 && form.bytes.capacity()==byte_capacity && form.spans.capacity()==span_capacity);
    assert(form.try_append(ext::form::Pair { name:literal("",0),value:literal("",0) }).unwrap()==1); copied(form.borrow(),literal("=",1));
    form.destroy(); assert(form.len()==0 && form.byte_len()==0 && form.bytes.capacity()==0 && form.spans.capacity()==0);
    string_equal(output,expected); output.destroy();
    assert(form.try_append(ext::form::Pair { name:literal("k",1),value:literal("~",1) }).unwrap()==1); copied(form.borrow(),literal("k=%7E",5)); form.destroy();
    i=0; while(i<24) { if(i>=2 && i<20) { assert(source[i]==200); } else { assert(source[i]==203); } i+=1; }
    let negative:ext::form_owned::Limits=ext::form_owned::Limits { max_pairs:-1,max_component_bytes:0,max_decoded_bytes:0 };
    owned_error(ext::form_owned::new(negative).unwrap_err(),1);
    let zero:ext::form_owned::Form=ext::form_owned::new(ext::form_owned::Limits { max_pairs:0,max_component_bytes:0,max_decoded_bytes:0 }).unwrap();
    assert(zero.len()==0 && zero.byte_len()==0); let empty_string:alloc::string::String=zero.encode(0).unwrap(); assert(empty_string.byte_len()==0); empty_string.destroy(); zero.destroy();
}
fn text_and_uri() {
    let bytes:[u8;12]=[203,203,97,255,98,239,187,191,195,169,203,203];
    let pair:ext::form::Pair=ext::form::Pair { name:view(bytes,2,3),value:view(bytes,5,5) };
    let bad:core::text::Error=pair.name_text().unwrap_err(); let offset:i32=match(bad) { core::text::Error::InvalidUtf8(at) -> at, _ -> -1 }; assert(offset==1);
    let text:core::text::Text=pair.value_text().unwrap(); assert(text.start==5 && text.byte_len()==5 && text.scalar_count()==2 && text.scalar_at_byte(0).unwrap()==65279 && text.scalar_at_byte(3).unwrap()==233);
    let reversed:ext::form::Pair=ext::form::Pair { name:pair.value,value:pair.name }; assert(reversed.name_text().unwrap().scalar_count()==2);
    let bad_value:core::text::Error=reversed.value_text().unwrap_err(); let value_offset:i32=match(bad_value) { core::text::Error::InvalidUtf8(at) -> at, _ -> -1 }; assert(value_offset==1);
    let invalid:ext::form::Pair=ext::form::Pair { name:view(bytes,-1,0),value:view(bytes,2147483647,1) };
    assert(match(invalid.name_text().unwrap_err()) { core::text::Error::Bounds -> true, _ -> false }); assert(match(invalid.value_text().unwrap_err()) { core::text::Error::Bounds -> true, _ -> false });
    let saved:[u8;12]=[203,203,97,255,98,239,187,191,195,169,203,203]; let i:i32=0; while(i<12) { assert(bytes[i]==saved[i]); i+=1; }
    let bom:ext::form_owned::Form=ext::form_owned::parse(literal("%EF%BB%BF=ok",12),ext::form::default_limits()).unwrap();
    let bom_pair:ext::form::Pair=bom.pair(0).unwrap(); let bom_text:core::text::Text=bom_pair.name_text().unwrap(); assert(bom_text.byte_len()==3 && bom_text.scalar_count()==1 && bom_text.scalar_at_byte(0).unwrap()==65279);
    equal(bom_pair.value,literal("ok",2)); bom.destroy();
    let uri_text:core::slice::View<u8> =literal("https://x/p?a=+&a=%2B#frag",26); let backing:[u8;32]=[203;32]; i=0; while(i<26) { backing[3+i]=uri_text.values[i]; i+=1; }
    let uri:ext::uri::Reference=ext::uri::parse(view(backing,3,26)).unwrap(); let query:core::slice::View<u8> =uri.query.unwrap(); assert(query.start==15 && query.length==9); equal(query,literal("a=+&a=%2B",9));
    let parsed:ext::form::Parsed=ext::form::parse(query,ext::form::default_limits()).unwrap(); assert(parsed.pair_count==2 && parsed.decoded_bytes==4);
    let owned:ext::form_owned::Form=ext::form_owned::parse(query,ext::form::default_limits()).unwrap();
    let first:ext::form::Pair=owned.pair(0).unwrap(); let second:ext::form::Pair=owned.pair(1).unwrap(); equal(first.name,literal("a",1)); equal(second.name,literal("a",1)); equal(first.value,literal(" ",1)); equal(second.value,literal("+",1));
    copied(owned.borrow(),literal("a=+&a=%2B",9)); owned.destroy();
    i=0; while(i<32) { if(i>=3 && i<29) { assert(backing[i]==uri_text.values[i-3]); } else { assert(backing[i]==203); } i+=1; }
}
fn main() -> i32 { owner_lifecycle(); text_and_uri(); return 0; }
