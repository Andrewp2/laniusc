// `f()? != n` compares the wrong value. Expected exit 0; actual exit 1.
// Workaround: let v: i32 = f()?; if (v != n) ...
module app::main;
import core::result;
fn three() -> core::result::Result<i32,i32> { return core::result::Ok(3); }
fn check() -> core::result::Result<i32,i32> {
    if (three()? != 3) { return core::result::Ok(1); }
    return core::result::Ok(0);
}
fn main() -> i32 { return core::result::unwrap(check()); }
