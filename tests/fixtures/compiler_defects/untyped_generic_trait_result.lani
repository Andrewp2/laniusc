// Fixed 2026-10-31: an untyped `let` of a method result through a bound on an
// imported trait (R: core::io::Read) had no type, so the unwrap reported
// LNC0006 "type mismatch" (LNC0027 for `got.unwrap()`). Expected: compiles;
// `printf x | ./prog` exits 1.
module app::main;
import core::io;
import core::result;
import std::stream;
fn read_one<R>(reader: &R, bytes: [u8]) -> i32 where R: core::io::Read {
    let got = reader.read(bytes, 0, 1);
    return core::result::unwrap(got);
}
fn main() -> i32 {
    let bytes: [u8;4] = [0;4];
    let source: std::stream::Descriptor = std::stream::stdin();
    return read_one<std::stream::Descriptor>(source.borrow(), bytes);
}
