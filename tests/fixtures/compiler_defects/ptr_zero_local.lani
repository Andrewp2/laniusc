// `let value: ptr = 0; return value;` returned a non-null pointer after a call
// had left a stack address in the same slot: the literal's temporary was
// stored with a 32-bit `mov [rbp-8], eax` and reloaded as a 64-bit pointer,
// so its upper half was stale. std::socket's null() hit this, and every
// Socket.receive/receive_until failed with EFAULT. Fixed 2026-11-01: an
// immediate written to a stack slot now stores the whole zero-extended word.
// Expected exit 1 (was 2).
module app::main;
enum A { W(i64), P(ptr) }
fn null() -> ptr { let value: ptr = 0; return value; }
fn word(value: i64) -> A { return A::W(value); }
fn main() -> i32 { let x: A = word(5); let n: ptr = null(); if (n == 0) { return 1; } return 2; }
