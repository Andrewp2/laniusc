// Reported LNC0008 labels pointing at core/slice.lani:899 (inside
// select_nth_unstable). Real in `laniusc check` only: check rejected this at
// slice.lani:899, and that false error also hid the real label of every
// unsatisfied-bound program importing core::slice. A build always compiled it
// and it exits 1. Fixed 2026-10-31; see check_slice_import.lani.
module app::main;
import core::cmp;
import core::result;
import core::slice;
fn first<T>(view: core::slice::View<T>) -> T where T: core::cmp::Ord<T> {
    let picked: core::slice::View<T> = core::result::unwrap(core::slice::select_nth_unstable<T>(view,0));
    return picked.values[picked.start];
}
fn main() -> i32 {
    let values: [i32;3] = [3, 1, 2];
    return first<i32>(core::result::unwrap(core::slice::view(values,3)));
}
