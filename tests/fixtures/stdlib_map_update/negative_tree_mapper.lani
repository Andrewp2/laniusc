module app::main;
import alloc::hash_map;
import alloc::tree_map;
import core::cmp;
import core::hash;
import core::iter;
import core::option;
import core::pair;
struct Callback { marker:i32 }
impl Callback { fn borrow(&self) -> &Callback { return self; } }
pub impl core::iter::Mapper<u64,core::pair::Pair<bool,bool>> for Callback {
    pub fn apply(&self,value:u64) -> core::pair::Pair<bool,bool> { return core::pair::Pair { first:true,second:false }; }
}
fn main() -> i32 {
    let map:alloc::tree_map::TreeMap<i32,u64> =alloc::tree_map::new(); let callback:Callback=Callback { marker:1 };
    let rejected_update_bound:core::option::Option<bool> =map.update_value<Callback,bool>(1,callback.borrow());
    return 0;
}
