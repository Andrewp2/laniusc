module app::main;
import core::function;
import alloc::hash_map;
import alloc::tree_map;
import core::cmp;
import core::hash;
import core::iter;
import core::option;
import core::pair;
import core::result;

struct Log { words:[u64],used:i32 }
impl Log {
    fn borrow(&self) -> &Log { return self; }
    fn record(&self,op:u64,a:u64,b:u64,c:u64,d:u64) {
        assert(self.used<128); let at:i32=self.used*5; self.words[at]=op; self.words[at+1]=a; self.words[at+2]=b; self.words[at+3]=c; self.words[at+4]=d; self.used+=1;
    }
}
struct Key { rank:i32,tag:u64,log:&Log }
fn key(rank:i32,tag:u64,log:&Log) -> Key { return Key { rank:rank,tag:tag,log:log }; }
pub impl core::hash::Hash<Key> for Key {
    pub fn hash(value:Key) -> u32 { value.log.record(1,value.rank as u64,0,value.tag,0); return 13; }
}
pub impl core::cmp::Eq<Key> for Key {
    pub fn eq(left:Key,right:Key) -> bool { left.log.record(2,left.rank as u64,right.rank as u64,left.tag,right.tag); return left.rank==right.rank; }
    pub fn ne(left:Key,right:Key) -> bool { return !Key::eq(left,right); }
}
pub impl core::cmp::Ord<Key> for Key {
    pub fn lt(left:Key,right:Key) -> bool { left.log.record(3,left.rank as u64,right.rank as u64,left.tag,right.tag); return left.rank<right.rank; }
    pub fn le(left:Key,right:Key) -> bool { return !Key::lt(right,left); }
    pub fn gt(left:Key,right:Key) -> bool { return Key::lt(right,left); }
    pub fn ge(left:Key,right:Key) -> bool { return !Key::lt(left,right); }
}
struct Report { old:u64,new:u64,ordinal:i32 }
struct Update { log:&Log,calls:i32 }
impl Update { fn borrow(&self) -> &Update { return self; } }
pub impl core::function::Mapper<u64,core::pair::Pair<u64,Report>> for Update {
    pub fn apply(&self,old:u64) -> core::pair::Pair<u64,Report> {
        self.calls+=1; let next:u64=old+17; self.log.record(4,old,next,self.calls as u64,0);
        return core::pair::Pair { first:next,second:Report { old:old,new:next,ordinal:self.calls } };
    }
}
fn marker(rank:i32) -> u64 { return 1234605616436508416+(rank as u64)*256; }
// Caller-backed logical snapshots do not retain entry descriptors or depend on
// bucket/node layout, inactive payloads, scalar padding or iteration order.
struct Entries { present:[bool],tags:[u64],values:[u64],count:i32 }
impl Entries {
    fn borrow(&self) -> &Entries { return self; }
    fn reset(&self) {
        let i:i32=0; while(i<10) { self.present[i]=false; self.tags[i]=0; self.values[i]=0; i+=1; } self.count=0;
    }
    fn record(&self,stored:Key,value:u64,log:&Log) {
        let rank:i32=stored.rank; assert(rank>=0 && rank<10 && !self.present[rank]);
        self.present[rank]=true; self.tags[rank]=stored.tag; self.values[rank]=value; self.count+=1;
        // Observe this exact borrowed context through its effect on the caller's
        // Log. A copied/retargeted Log must not replace the original receiver.
        let used:i32=log.used; let at:i32=used*5;
        stored.log.record(5,rank as u64,stored.tag,value,used as u64);
        assert(log.used==used+1);
        assert(log.words[at]==5 && log.words[at+1]==rank as u64 && log.words[at+2]==stored.tag && log.words[at+3]==value && log.words[at+4]==used as u64);
    }
}
fn hash_entries(map:&alloc::hash_map::HashMap<Key,u64>,saved:&Entries,log:&Log) {
    saved.reset(); log.used=0; let cursor:alloc::hash_map::Iter<Key,u64> =map.iter();
    while(true) {
        let next:core::option::Option<alloc::hash_map::Entry<Key,u64>> =cursor.next(); if(next.is_none()) { break; }
        let item:alloc::hash_map::Entry<Key,u64> =next.unwrap(); saved.record(item.key,item.value,log);
        let found:core::option::Option<alloc::hash_map::Entry<Key,u64>> =map.get_entry(item.key); assert(found.is_some());
        let retrieved:alloc::hash_map::Entry<Key,u64> =found.unwrap();
        assert(retrieved.key.rank==item.key.rank && retrieved.key.tag==item.key.tag && retrieved.value==item.value);
    }
    assert(saved.count==6);
}
fn tree_entries(map:&alloc::tree_map::TreeMap<Key,u64>,saved:&Entries,log:&Log) {
    saved.reset(); log.used=0; let cursor:alloc::tree_map::Cursor<Key,u64> =map.iter();
    while(true) {
        let next:core::option::Option<alloc::tree_map::Entry<Key,u64>> =cursor.next(); if(next.is_none()) { break; }
        let item:alloc::tree_map::Entry<Key,u64> =next.unwrap(); saved.record(item.key,item.value,log);
        let found:core::option::Option<alloc::tree_map::Entry<Key,u64>> =map.get_entry(item.key); assert(found.is_some());
        let retrieved:alloc::tree_map::Entry<Key,u64> =found.unwrap();
        assert(retrieved.key.rank==item.key.rank && retrieved.key.tag==item.key.tag && retrieved.value==item.value);
    }
    assert(saved.count==6);
}
fn identical_except_value(saved:&Entries,actual:&Entries,rank:i32,old:u64,next:u64,changed:bool) {
    assert(saved.count==actual.count); let selected:i32=0; let i:i32=0;
    while(i<10) {
        assert(saved.present[i]==actual.present[i]);
        if(saved.present[i]) {
            assert(saved.tags[i]==actual.tags[i]); let expected:u64=saved.values[i];
            if(changed && i==rank) { assert(expected==old); expected=next; selected+=1; }
            assert(actual.values[i]==expected);
        }
        i+=1;
    }
    assert(selected==changed as i32);
}
fn lookup_prefix(log:&Log,saved:[u64],calls:i32,changed:bool,old:u64,next:u64,ordinal:i32) {
    let expected:i32=calls; if(changed) { expected+=1; } assert(log.used==expected);
    let i:i32=0; while(i<calls*5) { assert(log.words[i]==saved[i]); i+=1; }
    if(changed) { let at:i32=calls*5; assert(log.words[at]==4 && log.words[at+1]==old && log.words[at+2]==next && log.words[at+3]==ordinal as u64 && log.words[at+4]==0); }
}
fn hash_contract() {
    let words:[u64;640]=[0;640]; let log:Log=Log { words:words,used:0 };
    let map:alloc::hash_map::HashMap<Key,u64> =alloc::hash_map::new(); assert(map.try_reserve(16).is_ok());
    let ranks:[i32;7]=[4,2,6,1,3,5,7]; let i:i32=0;
    while(i<7) { let rank:i32=ranks[i]; assert(map.try_insert(key(rank,1000+rank as u64,log.borrow()),marker(rank)).is_ok()); i+=1; }
    assert(map.remove(key(2,8002,log.borrow())).is_some()); assert(map.remove(key(6,8006,log.borrow())).is_some());
    assert(map.try_insert(key(8,1008,log.borrow()),marker(8)).is_ok()); assert(map.try_insert(key(9,1009,log.borrow()),marker(9)).is_ok());
    assert(map.remove(key(1,8001,log.borrow())).is_some()); assert(map.len()==6 && map.occupied>map.length);
    let pointer:ptr=map.storage; let capacity:i32=map.capacity(); let buckets:i32=map.buckets; let occupied:i32=map.occupied;
    let before_present:[bool;10]=[false;10]; let before_tags:[u64;10]=[0;10]; let before_values:[u64;10]=[0;10];
    let after_present:[bool;10]=[false;10]; let after_tags:[u64;10]=[0;10]; let after_values:[u64;10]=[0;10];
    let before:Entries=Entries { present:before_present,tags:before_tags,values:before_values,count:0 };
    let after:Entries=Entries { present:after_present,tags:after_tags,values:after_values,count:0 }; let prefix:[u64;640]=[0;640];
    let update:Update=Update { log:log.borrow(),calls:0 }; let queries:[i32;5]=[4,6,8,99,7]; i=0;
    while(i<5) {
        hash_entries(map.borrow(),before.borrow(),log.borrow());
        let rank:i32=queries[i]; let query:Key=key(rank,9000+rank as u64,log.borrow()); log.used=0;
        let existing:core::option::Option<alloc::hash_map::Entry<Key,u64>> =map.get_entry(query); let present:bool=existing.is_some();
        let old:u64=0; if(present) { let found:alloc::hash_map::Entry<Key,u64> =existing.unwrap(); old=found.value; assert(found.key.tag==1000+rank as u64); }
        let calls:i32=log.used; let j:i32=0; while(j<calls*5) { prefix[j]=words[j]; j+=1; }
        assert(calls>=1 && prefix[0]==1); log.used=0; let previous:i32=update.calls;
        let result:core::option::Option<Report> =map.update_value(query,update.borrow()); assert(result.is_some()==present);
        let next:u64=old; if(present) { let report:Report=result.unwrap(); next=old+17; assert(report.old==old && report.new==next && report.ordinal==previous+1); }
        assert(update.calls==previous+(present as i32)); lookup_prefix(log.borrow(),prefix,calls,present,old,next,update.calls);
        hash_entries(map.borrow(),after.borrow(),log.borrow());
        identical_except_value(before.borrow(),after.borrow(),rank,old,next,present);
        assert(map.storage==pointer && map.buckets==buckets && map.occupied==occupied && map.len()==6 && map.capacity()==capacity && query.tag==9000+rank as u64);
        i+=1;
    }
    assert(update.calls==3); let cursor:alloc::hash_map::Iter<Key,u64> =map.iter(); let seen:i32=0;
    while(true) { let next:core::option::Option<alloc::hash_map::Entry<Key,u64>> =cursor.next(); if(next.is_none()) { break; }
        let item:alloc::hash_map::Entry<Key,u64> =next.unwrap(); let rank:i32=item.key.rank; assert(rank==3 || rank==4 || rank==5 || rank==7 || rank==8 || rank==9);
        let expected:u64=marker(rank); if(rank==4 || rank==7 || rank==8) { expected+=17; } assert(item.value==expected && item.key.tag==1000+rank as u64); seen+=1;
    } assert(seen==6); map.destroy();
}
fn tree_contract() {
    let words:[u64;640]=[0;640]; let log:Log=Log { words:words,used:0 };
    let map:alloc::tree_map::TreeMap<Key,u64> =alloc::tree_map::with_capacity<Key,u64>(16).unwrap(); let ranks:[i32;7]=[4,2,6,1,3,5,7]; let i:i32=0;
    while(i<7) { let rank:i32=ranks[i]; assert(map.try_insert(key(rank,1000+rank as u64,log.borrow()),marker(rank)).is_ok()); i+=1; }
    assert(map.remove(key(2,8002,log.borrow())).is_some()); assert(map.remove(key(6,8006,log.borrow())).is_some());
    assert(map.try_insert(key(8,1008,log.borrow()),marker(8)).is_ok()); assert(map.try_insert(key(9,1009,log.borrow()),marker(9)).is_ok());
    assert(map.remove(key(1,8001,log.borrow())).is_some()); assert(map.len()==6 && map.free>=0);
    let pointer:ptr=map.storage; let reserved:i32=map.reserved; let used:i32=map.used; let root:i32=map.root; let free:i32=map.free;
    let before_present:[bool;10]=[false;10]; let before_tags:[u64;10]=[0;10]; let before_values:[u64;10]=[0;10];
    let after_present:[bool;10]=[false;10]; let after_tags:[u64;10]=[0;10]; let after_values:[u64;10]=[0;10];
    let before:Entries=Entries { present:before_present,tags:before_tags,values:before_values,count:0 };
    let after:Entries=Entries { present:after_present,tags:after_tags,values:after_values,count:0 }; let prefix:[u64;640]=[0;640];
    let update:Update=Update { log:log.borrow(),calls:0 }; let queries:[i32;5]=[4,6,8,99,7]; i=0;
    while(i<5) {
        tree_entries(map.borrow(),before.borrow(),log.borrow());
        let rank:i32=queries[i]; let query:Key=key(rank,9000+rank as u64,log.borrow()); log.used=0;
        let existing:core::option::Option<alloc::tree_map::Entry<Key,u64>> =map.get_entry(query); let present:bool=existing.is_some();
        let old:u64=0; if(present) { let found:alloc::tree_map::Entry<Key,u64> =existing.unwrap(); old=found.value; assert(found.key.tag==1000+rank as u64); }
        let calls:i32=log.used; let j:i32=0; while(j<calls*5) { prefix[j]=words[j]; j+=1; } assert(calls>0 && prefix[0]==3);
        log.used=0; let previous:i32=update.calls;
        let result:core::option::Option<Report> =map.update_value(query,update.borrow()); assert(result.is_some()==present);
        let next:u64=old; if(present) { let report:Report=result.unwrap(); next=old+17; assert(report.old==old && report.new==next && report.ordinal==previous+1); }
        assert(update.calls==previous+(present as i32)); lookup_prefix(log.borrow(),prefix,calls,present,old,next,update.calls);
        tree_entries(map.borrow(),after.borrow(),log.borrow());
        identical_except_value(before.borrow(),after.borrow(),rank,old,next,present);
        assert(map.storage==pointer && map.reserved==reserved && map.used==used && map.root==root && map.free==free && map.len()==6 && query.tag==9000+rank as u64);
        i+=1;
    }
    assert(update.calls==3); let cursor:alloc::tree_map::Cursor<Key,u64> =map.iter(); let expected_ranks:[i32;6]=[3,4,5,7,8,9]; i=0;
    while(i<6) { let item:alloc::tree_map::Entry<Key,u64> =cursor.next().unwrap(); let rank:i32=expected_ranks[i]; let expected:u64=marker(rank);
        if(rank==4 || rank==7 || rank==8) { expected+=17; } assert(item.key.rank==rank && item.key.tag==1000+rank as u64 && item.value==expected); i+=1;
    }
    assert(cursor.next().is_none()); map.destroy();
}
fn main() -> i32 { hash_contract(); tree_contract(); return 0; }
