            let info: core::option::Option<ext::http::HeadInfo> = match(event.unwrap()) { ext::http::Scan::HeadReady(h) -> core::option::Some(h), _ -> core::option::None() };
            if (info.is_some()) {
                let n: i32 = info.unwrap().head_end; let paid = self.pay((n as u64)*4); if (paid.is_err()) { return core::result::Err(paid.unwrap_err()); }
                let copied = alloc::vec::from_view(self.wire.as_view().subview(0,n).unwrap()); if (copied.is_err()) { return core::result::Err(Cause::AllocationFailed); }
                let owner: alloc::vec::Vec<u8> = copied.unwrap(); let parsed = ext::http::parse_request_head(owner.as_view(),self.options.request); if (parsed.is_err()) { owner.destroy(); return core::result::Err(Cause::Http(parsed.unwrap_err())); }
                let h = parsed.unwrap(); let target = head_target(h); if (target.is_err()) { owner.destroy(); return core::result::Err(target.unwrap_err()); }
                let view = RequestHead { head:h,target:target.unwrap(),expectation:expectation(h) };
                let after = self.active(); if (after.is_err()) { owner.destroy(); return core::result::Err(after.unwrap_err()); }
                self.head_wire = owner; self.header = core::option::Some(view); self.phase = 1;
                let fixed: bool = match(h.kind) { ext::http::BodyKind::Fixed -> true, _ -> false };
                if (fixed && (h.content_length > self.options.request.body_bytes || h.content_length > self.options.request_bytes-n)) { return core::result::Err(Cause::BodyLimit); }
                return core::result::Ok(core::option::Some(view));
            }
            let received = self.receive_wire(); if (received.is_err()) { return core::result::Err(received.unwrap_err()); }
            if (!received.unwrap() && self.wire.is_empty()) { self.phase = 8; return core::result::Ok(core::option::None()); }
        }
        return core::result::Err(Cause::InvalidState);
    }
    pub fn read_head(&self) -> core::result::Result<core::option::Option<RequestHead>,Failure> {
        if (self.phase != 0) { return core::result::Err(self.failure(Cause::InvalidState)); } self.stage = Stage::Head;
        let got = self.head_inner(); if (got.is_err()) { let cause = got.unwrap_err(); self.phase = 3; if (uncertain(cause)) { self.phase = 8; self.terminal = core::option::Some(cause); } return core::result::Err(self.failure(cause)); } return core::result::Ok(got.unwrap());
    }
    fn request_inner(&self) -> core::result::Result<Request,Cause> {
        while (true) {
            let event = self.scan(); if (event.is_err()) { return core::result::Err(event.unwrap_err()); }
            let found: core::option::Option<ext::http::FrameBoundary> = match(event.unwrap()) { ext::http::Scan::Boundary(b) -> core::option::Some(b), _ -> core::option::None() };
            if (found.is_some()) {
                let b = found.unwrap(); if (b.consumed < 0 || b.consumed > self.wire.len()) { return core::result::Err(Cause::BoundaryMismatch); }
                self.progress.buffered_discarded = self.wire.len()-b.consumed;
                self.stage = Stage::Validate; let allowance: u64 = (b.consumed as u64)*4+4*(self.options.request.head_bytes as u64)*((self.options.request.trailers as u64)+1);
                let paid = self.pay(allowance); if (paid.is_err()) { return core::result::Err(paid.unwrap_err()); }
                let parsed = ext::http::parse_request(self.wire.as_view().subview(0,b.consumed).unwrap(),self.input_eof,self.options.request);
                if (parsed.is_err()) { return core::result::Err(Cause::Http(parsed.unwrap_err())); } let message = parsed.unwrap();
                if (message.consumed != b.consumed || message.decoded_length != b.decoded_length) { return core::result::Err(Cause::BoundaryMismatch); }
                let after = self.active(); if (after.is_err()) { return core::result::Err(after.unwrap_err()); }
                self.stage = Stage::Decode; let paid = self.pay(2*(message.encoded_body.len() as u64)+2*(b.decoded_length as u64)); if (paid.is_err()) { return core::result::Err(paid.unwrap_err()); }
                let storage: alloc::vec::Vec<u8> = alloc::vec::new(); if (storage.try_resize(b.decoded_length,0 as u8).is_err()) { storage.destroy(); return core::result::Err(Cause::AllocationFailed); }
                let decoded = ext::http::decode_into(message,storage.as_view()); if (decoded.is_err()) { storage.destroy(); return core::result::Err(Cause::Http(decoded.unwrap_err())); }
                let after = self.active(); if (after.is_err()) { storage.destroy(); return core::result::Err(after.unwrap_err()); }
                self.decoded = storage; self.progress.decoded = b.decoded_length; self.progress.retained = b.consumed;
                // Keep wire allocation immutable, including observed tail; Message
                // only exposes the exact selected prefix. No later growth.
                let request = Request { message:message,body:self.decoded.as_view() }; self.request = core::option::Some(request); self.phase = 2; return core::result::Ok(request);
            }
            let got = self.receive_wire(); if (got.is_err()) { return core::result::Err(got.unwrap_err()); }
        }
        return core::result::Err(Cause::InvalidState);
    }
    pub fn read_request(&self) -> core::result::Result<Request,Failure> {
        self.stage = Stage::Body;
        if (self.phase != 1 || (self.progress.continue_sent > 0 && self.progress.continue_sent < 25)) { return core::result::Err(self.failure(Cause::InvalidState)); }
        let expected: i32 = match(self.header.unwrap().expectation) { Expectation::Continue -> 1, Expectation::Unsupported -> 2, _ -> 0 };
        if (expected == 2 || (expected == 1 && self.progress.continue_sent != 25)) { return core::result::Err(self.failure(Cause::ExpectationRequired)); }
        let got = self.request_inner(); if (got.is_err()) { let cause = got.unwrap_err(); self.phase = 3; if (uncertain(cause)) { self.phase = 8; self.terminal = core::option::Some(cause); } return core::result::Err(self.failure(cause)); } return core::result::Ok(got.unwrap());
    }
}

fn uncertain(cause: Cause) -> bool { return match(cause) { Cause::Io(e) -> match(e) { core::io::Error::InvalidCount -> true, _ -> false }, _ -> false }; }
fn field(name: core::slice::View<u8>, value: core::slice::View<u8>) -> ext::http::Field { return ext::http::Field { raw:literal("",0),name:name,value:value,offset:0 }; }
fn decimal(out: &alloc::vec::Vec<u8>, value: i32) -> bool { let scratch: [u8;10] = [0;10]; let at: i32 = 10; let n: i32 = value; while (true) { at -= 1; scratch[at] = (48+n%10) as u8; n /= 10; if (n == 0) { break; } } return out.try_extend(core::slice::view_range(scratch,at,10-at).unwrap()).is_ok(); }
fn digit_count(value: i32) -> i32 { let n: i32 = value; let digits: i32 = 1; while (n >= 10) { n /= 10; digits += 1; } return digits; }
fn date_number(out: core::slice::View<u8>, at: i32, width: i32, value: i32) { let n: i32 = value; let i: i32 = width; while (i > 0) { i -= 1; out.try_set(at+i,(48+n%10) as u8).unwrap(); n /= 10; } }
fn date_into(value: core::time::SystemTime, out: core::slice::View<u8>) -> core::result::Result<bool,Cause> {
    if (!valid(out) || out.len() < 29) { return core::result::Err(Cause::Http(ext::http::Error::Bounds)); }
    let got = core::calendar::from_system_time(value,core::calendar::utc()); if (got.is_err()) { return core::result::Err(Cause::Date(got.unwrap_err())); }
    let dt = got.unwrap().local; if (dt.date.year < 0 || dt.date.year > 9999) { return core::result::Err(Cause::Date(core::calendar::Error::YearOutOfRange)); }
    let weekdays = literal("MonTueWedThuFriSatSun",21); let months = literal("JanFebMarAprMayJunJulAugSepOctNovDec",36);
    let i: i32 = 0; while (i < 3) { out.try_set(i,weekdays.get((dt.date.weekday()-1)*3+i).unwrap()).unwrap(); out.try_set(8+i,months.get((dt.date.month-1)*3+i).unwrap()).unwrap(); i += 1; }
    out.try_set(3,44).unwrap(); out.try_set(4,32).unwrap(); date_number(out,5,2,dt.date.day); out.try_set(7,32).unwrap(); out.try_set(11,32).unwrap(); date_number(out,12,4,dt.date.year); out.try_set(16,32).unwrap(); date_number(out,17,2,dt.time.hour); out.try_set(19,58).unwrap(); date_number(out,20,2,dt.time.minute); out.try_set(22,58).unwrap(); date_number(out,23,2,dt.time.second); out.try_set(25,32).unwrap(); out.try_set(26,71).unwrap(); out.try_set(27,77).unwrap(); out.try_set(28,84).unwrap(); return core::result::Ok(true);
}
pub impl Connection {
    fn send_some(&self, input: core::slice::View<u8>, interim: bool) -> core::result::Result<bool,Cause> {
        let permit = self.call(); if (permit.is_err()) { return permit; }
        if (!interim) { self.progress.final_started = true; }
        let got = self.socket.send(input);
        if (got.is_ok()) { if (interim) { self.progress.continue_sent += got.unwrap(); } else { self.progress.response_sent += got.unwrap(); } }
        let after = self.active();
        if (got.is_err() && !transient(got.unwrap_err())) { return core::result::Err(Cause::Io(got.unwrap_err())); } if (after.is_err()) { return after; }
        if (got.is_err()) { return core::result::Ok(false); } if (got.unwrap() == 0) { return core::result::Err(Cause::Io(core::io::Error::WriteZero)); } return core::result::Ok(true);
    }
    fn continue_inner(&self) -> core::result::Result<bool,Cause> {
        if (!self.continue_staged) { let paid = self.pay(25); if (paid.is_err()) { return paid; } self.continue_staged = true; }
        let wire = literal("HTTP/1.1 100 Continue\r\n\r\n",25);
        while (self.progress.continue_sent < 25) {
            let wrote = self.send_some(wire.subview(self.progress.continue_sent,25).unwrap(),true); if (wrote.is_err()) { return wrote; }
            if (!wrote.unwrap()) { let waited = self.wait(false,true); if (waited.is_err()) { return waited; } }
        }
        return core::result::Ok(true);
    }
    pub fn send_continue(&self) -> core::result::Result<Stats,Failure> {
        self.stage = Stage::Continue;
        if (self.phase != 1 || self.progress.continue_sent == 25 || !match(self.header.unwrap().expectation) { Expectation::Continue -> true, _ -> false }) { return core::result::Err(self.failure(Cause::InvalidState)); }
        let got = self.continue_inner(); if (got.is_err()) { let cause = got.unwrap_err(); if (uncertain(cause)) { self.phase = 8; self.terminal = core::option::Some(cause); } return core::result::Err(self.failure(cause)); } return core::result::Ok(self.progress);
    }
    fn prepare(&self, response: Response) -> core::result::Result<bool,Cause> {
        let observed = self.active(); if (observed.is_err()) { return observed; }
        if (!valid(response.reason) || !valid(response.headers) || !valid(response.body)) { return core::result::Err(Cause::Http(ext::http::Error::Bounds)); }
        let method = literal("GET",3); let version: i32 = 11;
        if (self.header.is_some()) { method = self.header.unwrap().head.method; version = self.header.unwrap().head.version; }
        if (response.status < 200 || response.status > 599 || (eq(method,"CONNECT",7) && response.status < 300) || (self.header.is_none() && (response.status < 400 || !response.body.is_empty())) || (self.phase != 2 && response.status < 300) || (self.phase == 3 && response.status < 400)) { return core::result::Err(Cause::UnsupportedResponse); }
        let omit: bool = eq(method,"HEAD",4) || response.status == 204 || response.status == 304;
        if ((omit || response.status == 205) && !response.body.is_empty()) { return core::result::Err(Cause::UnsupportedResponse); }
        let extra: i32 = 3; if (omit) { extra = 2; }
        let l = self.options.response;
        let head_size: u64 = 73+(response.reason.len() as u64); if (!omit) { head_size += 18+(digit_count(response.body.len()) as u64); }
        if (13+(response.reason.len() as u64) > l.line_bytes as u64 || l.line_bytes < 35 || response.headers.len() > l.headers-extra || response.body.len() > l.body_bytes) { return core::result::Err(Cause::ResponseLimit); }
        let paid = self.pay(response.headers.len() as u64); if (paid.is_err()) { return paid; }
        let i: i32 = 0;
        while (i < response.headers.len()) {
            let f = response.headers.get(i).unwrap(); if (!valid(f.name) || !valid(f.value)) { return core::result::Err(Cause::Http(ext::http::Error::Bounds)); }
            head_size += (f.name.len() as u64)+(f.value.len() as u64)+4;
            if (head_size > l.head_bytes as u64 || head_size+(response.body.len() as u64) > self.options.response_bytes as u64) { return core::result::Err(Cause::ResponseLimit); }
            if (named(f.name,"Content-Length",14) || named(f.name,"Transfer-Encoding",17) || named(f.name,"Connection",10) || named(f.name,"Trailer",7) || named(f.name,"Upgrade",7) || named(f.name,"Keep-Alive",10) || named(f.name,"Proxy-Connection",16) || named(f.name,"Date",4)) { return core::result::Err(Cause::UnsupportedHeader(i)); } i += 1;
        }
        if (head_size > l.head_bytes as u64 || head_size+(response.body.len() as u64) > self.options.response_bytes as u64) { return core::result::Err(Cause::ResponseLimit); }
        let paid = self.pay(4*(head_size+(response.body.len() as u64))+2*(method.len() as u64)+29); if (paid.is_err()) { return paid; }
        let date: [u8;29] = [0;29]; let date_view = core::slice::view(date,29).unwrap(); let formatted = date_into(response.date,date_view); if (formatted.is_err()) { return formatted; }
        let line: alloc::vec::Vec<u8> = alloc::vec::new(); let prefix = literal("HTTP/1.1 ",9); if (version == 10) { prefix = literal("HTTP/1.0 ",9); }
        if (line.try_extend(prefix).is_err() || !decimal(line.borrow(),response.status) || line.try_push(32).is_err() || line.try_extend(response.reason).is_err()) { line.destroy(); return core::result::Err(Cause::AllocationFailed); }
        let fields: alloc::vec::Vec<ext::http::Field> = alloc::vec::new();
        if (fields.try_extend(response.headers).is_err() || fields.try_push(field(literal("Date",4),date_view)).is_err() || fields.try_push(field(literal("Connection",10),literal("close",5))).is_err()) { fields.destroy(); line.destroy(); return core::result::Err(Cause::AllocationFailed); }
        let encoded = ext::http::encode_response(line.as_view(),method,fields.as_view(),response.body,l); fields.destroy(); line.destroy();
        if (encoded.is_err()) { return core::result::Err(Cause::Http(encoded.unwrap_err())); }
        let owner = encoded.unwrap(); let parsed = ext::http::parse_response(owner.as_view(),method,false,l);
        if (parsed.is_err()) { owner.destroy(); return core::result::Err(Cause::Http(parsed.unwrap_err())); }
        if (parsed.unwrap().consumed != owner.len()) { owner.destroy(); return core::result::Err(Cause::BoundaryMismatch); }
        let after = self.active(); if (after.is_err()) { owner.destroy(); return after; }
        if (self.request.is_none() && self.header.is_some()) { self.progress.buffered_discarded = self.wire.len()-self.header.unwrap().head.raw.len(); }
        self.response_wire = owner; self.progress.response_bytes = owner.len(); self.final_staged = true; self.phase = 4; return core::result::Ok(true);
    }
    fn discard_once(&self) -> core::result::Result<bool,Cause> {
        if (self.progress.peer_eof) { return core::result::Ok(false); }
        if (self.progress.drain_received > self.options.drain_bytes as u64) { return core::result::Err(Cause::DrainLimit); }
        let remaining: i32 = self.options.drain_bytes-(self.progress.drain_received as i32); let count: i32 = remaining; if (count > 1024) { count = 1024; } if (count == 0) { count = 1; }
        let storage: [i32;256] = [0;256]; let scratch: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(storage),1024);
        let permit = self.call(); if (permit.is_err()) { return permit; } let got = self.socket.receive(core::slice::view(scratch,count).unwrap());
        if (got.is_ok()) { self.progress.received += got.unwrap() as u64; self.progress.drain_received += got.unwrap() as u64; if (got.unwrap() == 0) { self.progress.peer_eof = true; } }
        let after = self.active();
        if (got.is_err() && !transient(got.unwrap_err())) { return core::result::Err(Cause::Io(got.unwrap_err())); } if (after.is_err()) { return after; }
        if (got.is_err()) { return core::result::Ok(false); } let paid = self.pay(got.unwrap() as u64); if (paid.is_err()) { return paid; }
        if (got.unwrap() > remaining) { return core::result::Err(Cause::DrainLimit); } return core::result::Ok(true);
    }
    fn finish_inner(&self) -> core::result::Result<bool,Cause> {
        if (self.phase == 4) {
            self.stage = Stage::Send;
            while (self.progress.response_sent < self.response_wire.len()) {
                let wrote = self.send_some(self.response_wire.as_view().subview(self.progress.response_sent,self.response_wire.len()).unwrap(),false); if (wrote.is_err()) { return wrote; }
                if (self.progress.response_sent == self.response_wire.len()) { break; }
                let drained = self.discard_once(); if (drained.is_err()) { return drained; }
                if (!wrote.unwrap()) { let ready = self.wait(!self.progress.peer_eof,true); if (ready.is_err()) { return ready; } }
            }
            self.phase = 5;
        }
        while (self.phase == 5) {
            self.stage = Stage::Shutdown; let permit = self.call(); if (permit.is_err()) { return permit; }
            let ended = self.socket.shutdown(std::socket::Shutdown::Write); if (ended.is_ok()) { self.progress.write_shutdown = true; self.phase = 6; }
            let after = self.active(); if (ended.is_err() && !transient(ended.unwrap_err())) { return core::result::Err(Cause::Io(ended.unwrap_err())); } if (after.is_err()) { return after; }
        }
        self.stage = Stage::Drain;
        while (!self.progress.peer_eof) { let read = self.discard_once(); if (read.is_err()) { return read; } if (!read.unwrap()) { let ready = self.wait(true,false); if (ready.is_err()) { return ready; } } }
        return core::result::Ok(true);
    }
    pub fn finish(&self) -> core::result::Result<Stats,Failure> {
        if (self.terminal.is_some()) { return core::result::Err(self.failure(self.terminal.unwrap())); }
        if (self.phase == 7 && self.final_staged && self.progress.response_sent == self.progress.response_bytes && self.progress.write_shutdown && self.progress.peer_eof) { return core::result::Ok(self.progress); }
        if (!self.final_staged || self.phase < 4 || self.phase > 6) { return core::result::Err(self.failure(Cause::InvalidState)); }
        let got = self.finish_inner();
        if (got.is_err()) { let cause = got.unwrap_err(); if (uncertain(cause)) { self.phase = 8; self.terminal = core::option::Some(cause); } return core::result::Err(self.failure(cause)); }
        self.stage = Stage::Close; let observed = self.active(); let closed = self.close();
        if (observed.is_err()) { let failure = self.failure(observed.unwrap_err()); failure.cleanup_attempted = closed.is_ok() || closed.unwrap_err().cleanup_attempted; if (closed.is_err()) { failure.cleanup = core::option::Some(match(closed.unwrap_err().cause) { Cause::Io(e) -> e, _ -> core::io::Error::InvalidInput }); } self.terminal = core::option::Some(failure.cause); return core::result::Err(failure); }
        if (closed.is_err()) { self.terminal = core::option::Some(closed.unwrap_err().cause); return closed; }
        let after = self.active(); if (after.is_err()) { self.terminal = core::option::Some(after.unwrap_err()); let failure = self.failure(after.unwrap_err()); failure.cleanup_attempted = true; return core::result::Err(failure); } return core::result::Ok(self.progress);
    }
    pub fn reply(&self, response: Response) -> core::result::Result<Stats,Failure> {
        self.stage = Stage::Prepare;
        if ((self.phase != 1 && self.phase != 2 && self.phase != 3) || self.final_staged || (self.continue_staged && self.progress.continue_sent != 25)) { return core::result::Err(self.failure(Cause::InvalidState)); }
        let staged = self.prepare(response); if (staged.is_err()) { return core::result::Err(self.failure(staged.unwrap_err())); } return self.finish();
    }
}
