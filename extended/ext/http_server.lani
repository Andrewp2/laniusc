// One bounded staged HTTP/1 connection. Caller owns the listener and policy.
module ext::http_server;
import alloc::vec;
import core::calendar;
import core::io;
import core::mem;
import core::net;
import core::option;
import core::result;
import core::slice;
import core::time;
import ext::http;
import ext::uri;
import std::clock;
import std::socket;

pub struct Options { request: ext::http::Limits, response: ext::http::Limits, request_bytes: i32, response_bytes: i32, drain_bytes: i32, io_calls: u64, work: u64 }
pub enum Stage { Accept, Head, Continue, Body, Validate, Decode, Prepare, Send, Shutdown, Drain, Close }
pub enum Cause { InvalidOptions, InvalidState, AllocationFailed, Timeout, Clock(std::clock::Error), Io(core::io::Error), Http(ext::http::Error), Date(core::calendar::Error), UnsupportedResponse, UnsupportedHeader(i32), ExpectationRequired, RequestLimit, RequestLineLimit, RequestTargetLimit, ResponseLimit, BodyLimit, DrainLimit, IoLimit, WorkLimit, BoundaryMismatch }
pub struct Stats { received: u64, retained: i32, decoded: i32, buffered_discarded: i32, drain_received: u64, response_bytes: i32, response_sent: i32, continue_sent: i32, io_calls: u64, work: u64, scan_work: u64, cleanup_calls: u64, cleanup_errors: u64, write_shutdown: bool, peer_eof: bool, final_started: bool, closed: bool }
pub struct Failure { cause: Cause, stage: Stage, stats: Stats, cleanup_attempted: bool, cleanup: core::option::Option<core::io::Error> }
pub enum TargetForm { Origin, Absolute, Authority, Asterisk }
pub struct Target { form: TargetForm, scheme: core::option::Option<core::slice::View<u8>>, authority: core::option::Option<core::slice::View<u8>>, path: core::slice::View<u8>, query: core::option::Option<core::slice::View<u8>> }
pub enum Expectation { None, Continue, Unsupported }
pub struct RequestHead { head: ext::http::Head, target: Target, expectation: Expectation }
pub struct Request { message: ext::http::Message, body: core::slice::View<u8> }
pub struct Response { status: i32, reason: core::slice::View<u8>, headers: core::slice::View<ext::http::Field>, body: core::slice::View<u8>, date: core::time::SystemTime }
// Single active owner, fields maintained by library. All published views live
// until destroy, including after close/error. No external descriptor aliases.
pub struct Connection {
    socket: std::socket::Socket, remote: core::net::SocketAddr, options: Options,
    deadline: core::time::Deadline, last: core::time::Instant, stage: Stage, phase: i32,
    progress: Stats, head_wire: alloc::vec::Vec<u8>, wire: alloc::vec::Vec<u8>, decoded: alloc::vec::Vec<u8>, response_wire: alloc::vec::Vec<u8>,
    cursor: ext::http::Cursor, header: core::option::Option<RequestHead>, request: core::option::Option<Request>,
    input_eof: bool, final_staged: bool, continue_staged: bool, terminal: core::option::Option<Cause>
}
pub fn default_options() -> Options {
    let request = ext::http::default_limits(); request.body_bytes = 1048576;
    let response = ext::http::default_limits(); response.body_bytes = 1048576;
    return Options { request:request,response:response,request_bytes:2097152,response_bytes:2097152,drain_bytes:1048576,io_calls:1048576,work:268435456 };
}
fn limits(l: ext::http::Limits) -> bool { return l.head_bytes >= 0 && l.line_bytes >= 0 && l.headers >= 0 && l.body_bytes >= 0 && l.trailer_bytes >= 0 && l.trailers >= 0 && l.chunks >= 0; }
fn options_valid(o: Options) -> bool { return limits(o.request) && limits(o.response) && o.request_bytes >= 0 && o.response_bytes >= 0 && o.drain_bytes >= 0 && o.io_calls > 0; }
fn empty_stats() -> Stats { return Stats { received:0,retained:0,decoded:0,buffered_discarded:0,drain_received:0,response_bytes:0,response_sent:0,continue_sent:0,io_calls:0,work:0,scan_work:0,cleanup_calls:0,cleanup_errors:0,write_shutdown:false,peer_eof:false,final_started:false,closed:false }; }
fn literal(s: str, n: i32) -> core::slice::View<u8> { let raw: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::string_data_ptr(s),n); return core::slice::view(raw,n).unwrap(); }
fn valid<T>(v: core::slice::View<T>) -> bool { return v.start >= 0 && v.length >= 0 && v.start <= 2147483647-v.length; }
fn eq(v: core::slice::View<u8>, s: str, n: i32) -> bool { if (v.len() != n) { return false; } let other = literal(s,n); let i: i32 = 0; while (i < n) { if (v.get(i).unwrap() != other.get(i).unwrap()) { return false; } i += 1; } return true; }
fn named(v: core::slice::View<u8>, s: str, n: i32) -> bool { return ext::http::equal_name(v,literal(s,n)); }
fn transient(e: core::io::Error) -> bool { return match(e) { core::io::Error::Interrupted -> true, core::io::Error::WouldBlock -> true, _ -> false }; }
struct Budget { options: Options, deadline: core::time::Deadline, last: core::time::Instant, stats: Stats }
impl Budget { fn borrow(&self) -> &Budget { return self; } }
fn initial_failure(cause: Cause, stats: Stats, attempted: bool, cleanup: core::option::Option<core::io::Error>) -> Failure { return Failure { cause:cause,stage:Stage::Accept,stats:stats,cleanup_attempted:attempted,cleanup:cleanup }; }
fn check_time(last: core::time::Instant, deadline: core::time::Deadline) -> core::result::Result<core::time::Instant,Cause> {
    let got = std::clock::monotonic_now(); if (got.is_err()) { return core::result::Err(Cause::Clock(got.unwrap_err())); }
    let now = got.unwrap(); if (now.compare(last) < 0) { return core::result::Err(Cause::Clock(std::clock::Error::ClockReversed)); }
    if (deadline.is_expired(now)) { return core::result::Err(Cause::Timeout); } return core::result::Ok(now);
}
fn accept_call(b: &Budget) -> core::result::Result<bool,Cause> {
    let now = check_time(b.last,b.deadline); if (now.is_err()) { return core::result::Err(now.unwrap_err()); } b.last = now.unwrap();
    if (b.stats.io_calls == b.options.io_calls) { return core::result::Err(Cause::IoLimit); } b.stats.io_calls += 1; return core::result::Ok(true);
}
fn milliseconds(deadline: core::time::Deadline, now: core::time::Instant) -> i32 { let span = deadline.remaining(now); if (span.seconds > 2147483 as u64) { return 2147483647; } let n: u64 = span.seconds*1000+((span.nanos as u64)+999999)/1000000; if (n > 2147483647 as u64) { return 2147483647; } return n as i32; }
pub fn accept_until(listener: &std::socket::Socket, options: Options, deadline: core::time::Deadline) -> core::result::Result<Connection,Failure> {
    let stats = empty_stats();
    if (!options_valid(options) || deadline.instant.ticks.nanos >= 1000000000 || !listener.is_open() || match(listener.kind()) { std::socket::Kind::Udp -> true, _ -> false }) { return core::result::Err(initial_failure(Cause::InvalidOptions,stats,false,core::option::None())); }
    let scan_allowance: u64 = (options.request_bytes as u64)*2;
    if (scan_allowance > options.work) { return core::result::Err(initial_failure(Cause::WorkLimit,stats,false,core::option::None())); } stats.work = scan_allowance;
    let first = std::clock::monotonic_now(); if (first.is_err()) { return core::result::Err(initial_failure(Cause::Clock(first.unwrap_err()),stats,false,core::option::None())); }
    let b = Budget { options:options,deadline:deadline,last:first.unwrap(),stats:stats };
    let permit = accept_call(b.borrow()); if (permit.is_err()) { return core::result::Err(initial_failure(permit.unwrap_err(),b.stats,false,core::option::None())); }
    let flag = listener.is_nonblocking(); let after = check_time(b.last,deadline);
    if (flag.is_err()) { return core::result::Err(initial_failure(Cause::Io(flag.unwrap_err()),b.stats,false,core::option::None())); }
    if (after.is_err()) { return core::result::Err(initial_failure(after.unwrap_err(),b.stats,false,core::option::None())); } b.last = after.unwrap(); if (!flag.unwrap()) { return core::result::Err(initial_failure(Cause::InvalidOptions,b.stats,false,core::option::None())); }
    while (true) {
        let permit = accept_call(b.borrow()); if (permit.is_err()) { return core::result::Err(initial_failure(permit.unwrap_err(),b.stats,false,core::option::None())); }
        let got = listener.accept(true);
        if (got.is_ok()) {
            let accepted = got.unwrap(); let observed = check_time(b.last,deadline);
            if (observed.is_err()) { b.stats.cleanup_calls += 1; let closed = accepted.socket.close(); b.stats.closed = true; if (closed.is_err()) { b.stats.cleanup_errors += 1; } let cleanup: core::option::Option<core::io::Error> = core::option::None(); if (closed.is_err()) { cleanup = core::option::Some(closed.unwrap_err()); } return core::result::Err(initial_failure(observed.unwrap_err(),b.stats,true,cleanup)); }
            let framing = ext::http::cursor(ext::http::CursorMode::Request,options.request,options.request_bytes,scan_allowance);
            return core::result::Ok(Connection { socket:accepted.socket,remote:accepted.peer,options:options,deadline:deadline,last:observed.unwrap(),stage:Stage::Head,phase:0,progress:b.stats,
                head_wire:alloc::vec::new(),wire:alloc::vec::new(),decoded:alloc::vec::new(),response_wire:alloc::vec::new(),cursor:framing.unwrap(),header:core::option::None(),request:core::option::None(),input_eof:false,final_staged:false,continue_staged:false,terminal:core::option::None() });
        }
        let failure: std::socket::AcceptFailure = got.unwrap_err();
        if (failure.cleanup_attempted) { b.stats.cleanup_calls += 1; b.stats.closed = true; } if (failure.cleanup_error.is_some()) { b.stats.cleanup_errors += 1; }
        let observed = check_time(b.last,deadline);
        if (!transient(failure.cause) || failure.cleanup_attempted) { return core::result::Err(initial_failure(Cause::Io(failure.cause),b.stats,failure.cleanup_attempted,failure.cleanup_error)); }
        if (observed.is_err()) { return core::result::Err(initial_failure(observed.unwrap_err(),b.stats,failure.cleanup_attempted,failure.cleanup_error)); } b.last = observed.unwrap();
        let permit = accept_call(b.borrow()); if (permit.is_err()) { return core::result::Err(initial_failure(permit.unwrap_err(),b.stats,false,core::option::None())); }
        let waited = listener.wait_ms(true,false,milliseconds(deadline,b.last)); let observed = check_time(b.last,deadline);
        if (observed.is_err()) { return core::result::Err(initial_failure(observed.unwrap_err(),b.stats,false,core::option::None())); } b.last = observed.unwrap();
        if (waited.is_err() && !transient(waited.unwrap_err())) { return core::result::Err(initial_failure(Cause::Io(waited.unwrap_err()),b.stats,false,core::option::None())); }
    }
    return core::result::Err(initial_failure(Cause::InvalidState,b.stats,false,core::option::None()));
}
pub impl Connection {
    pub fn borrow(&self) -> &Connection { return self; }
    pub fn peer(&self) -> core::net::SocketAddr { return self.remote; }
    pub fn stats(&self) -> Stats { return self.progress; }
    fn failure(&self, cause: Cause) -> Failure { return Failure { cause:cause,stage:self.stage,stats:self.progress,cleanup_attempted:false,cleanup:core::option::None() }; }
    pub fn close(&self) -> core::result::Result<Stats,Failure> {
        self.stage = Stage::Close; let attempted: bool = self.socket.is_open(); if (attempted) { self.progress.cleanup_calls += 1; }
        let closed = self.socket.close(); self.progress.closed = true; self.phase = 7;
        if (closed.is_err()) { self.progress.cleanup_errors += 1; let failure = self.failure(Cause::Io(closed.unwrap_err())); failure.cleanup_attempted = attempted; return core::result::Err(failure); } return core::result::Ok(self.progress);
    }
    pub fn destroy(&self) -> core::result::Result<i32,core::io::Error> {
        let closed = self.close(); self.response_wire.destroy(); self.decoded.destroy(); self.wire.destroy(); self.head_wire.destroy(); self.phase = 9;
        if (closed.is_err()) { return core::result::Err(match(closed.unwrap_err().cause) { Cause::Io(e) -> e, _ -> core::io::Error::InvalidInput }); } return core::result::Ok(0);
    }
}

fn head_target(h: ext::http::Head) -> core::result::Result<Target,Cause> {
    let authority: core::option::Option<core::slice::View<u8>> = core::option::None(); let host = h.lookup(literal("Host",4)); if (host.is_some()) { authority = core::option::Some(host.unwrap().value); }
    let no_scheme: core::option::Option<core::slice::View<u8>> = core::option::None(); let no_query: core::option::Option<core::slice::View<u8>> = core::option::None(); let empty = literal("",0);
    if (eq(h.method,"CONNECT",7)) { return core::result::Ok(Target { form:TargetForm::Authority,scheme:no_scheme,authority:core::option::Some(h.target),path:empty,query:no_query }); }
    if (eq(h.target,"*",1)) { return core::result::Ok(Target { form:TargetForm::Asterisk,scheme:no_scheme,authority:authority,path:h.target,query:no_query }); }
    if (h.target.get(0).unwrap() == 47) {
        let at: i32 = 0; while (at < h.target.len() && h.target.get(at).unwrap() != 63) { at += 1; } let query = no_query; if (at < h.target.len()) { query = core::option::Some(h.target.subview(at+1,h.target.len()).unwrap()); }
        return core::result::Ok(Target { form:TargetForm::Origin,scheme:no_scheme,authority:authority,path:h.target.subview(0,at).unwrap(),query:query });
    }
    let parsed = ext::uri::parse_with_limit(h.target,h.target.len()); if (parsed.is_err()) { return core::result::Err(Cause::Http(ext::http::Error::Malformed(0))); }
    let uri = parsed.unwrap(); let path = uri.path; if (path.is_empty()) { path = literal("/",1); }
    return core::result::Ok(Target { form:TargetForm::Absolute,scheme:uri.scheme,authority:core::option::Some(uri.authority.unwrap().raw),path:path,query:uri.query });
}
fn expectation(h: ext::http::Head) -> Expectation {
    let cursor = h.headers(); let count: i32 = 0; let supported: bool = true;
    while (true) { let next = cursor.next(); if (next.is_none()) { break; } let f = next.unwrap(); if (named(f.name,"Expect",6)) { count += 1; if (!named(f.value,"100-continue",12)) { supported = false; } } }
    if (count == 0) { return Expectation::None; }
    // HTTP/1.0 ignores only the recognized 100-continue expectation.
    if (h.version == 10 && supported) { return Expectation::None; }
    if (count != 1 || !supported) { return Expectation::Unsupported; }
    let body: bool = match(h.kind) { ext::http::BodyKind::Chunked -> true, ext::http::BodyKind::Fixed -> h.content_length > 0, _ -> false };
    if (!body) { return Expectation::None; } return Expectation::Continue;
}
pub impl Connection {
    fn active(&self) -> core::result::Result<bool,Cause> { let read = check_time(self.last,self.deadline); if (read.is_err()) { return core::result::Err(read.unwrap_err()); } self.last = read.unwrap(); return core::result::Ok(true); }
    fn pay(&self, units: u64) -> core::result::Result<bool,Cause> { if (units > self.options.work-self.progress.work) { return core::result::Err(Cause::WorkLimit); } self.progress.work += units; return core::result::Ok(true); }
    fn call(&self) -> core::result::Result<bool,Cause> { let before = self.active(); if (before.is_err()) { return before; } if (self.progress.io_calls == self.options.io_calls) { return core::result::Err(Cause::IoLimit); } self.progress.io_calls += 1; return core::result::Ok(true); }
    fn wait(&self, readable: bool, writable: bool) -> core::result::Result<bool,Cause> {
        while (true) { let allowed = self.call(); if (allowed.is_err()) { return allowed; } let waited = self.socket.wait_ms(readable,writable,milliseconds(self.deadline,self.last)); let after = self.active();
            if (waited.is_err() && !transient(waited.unwrap_err())) { return core::result::Err(Cause::Io(waited.unwrap_err())); } if (after.is_err()) { return after; } if (waited.is_ok() && !waited.unwrap().timed_out) { return core::result::Ok(true); } }
        return core::result::Err(Cause::InvalidState);
    }
    // Rejection status only. Inspect through the failed scan, never a later
    // SP/CRLF already present in an unfragmented prefix. 0=not first line,
    // 1=other overlong first line, 2=the failure lies inside its target span.
    fn request_line_limit(&self, offset: i32) -> core::result::Result<i32,Cause> {
        if (offset <= self.options.request.line_bytes || self.options.request.line_bytes == 2147483647) { return core::result::Ok(0); }
        let n: i32 = self.options.request.line_bytes+1; if (n > self.wire.len()) { return core::result::Ok(0); }
        let paid = self.pay(n as u64); if (paid.is_err()) { return core::result::Err(paid.unwrap_err()); }
        let spaces: i32 = 0; let first: i32 = -1; let i: i32 = 0;
        while (i < n) { let c: u8 = self.wire.as_view().get(i).unwrap(); if (c == 13 || c == 10) { return core::result::Ok(0); } if (c == 32) { spaces += 1; if (first < 0) { first = i; } } i += 1; }
        if (spaces == 1 && first > 0 && first < n-1) { return core::result::Ok(2); } return core::result::Ok(1);
    }
    fn scan(&self) -> core::result::Result<ext::http::Scan,Cause> {
        let before = self.active(); if (before.is_err()) { return core::result::Err(before.unwrap_err()); }
        let got = self.cursor.advance(self.wire.as_view(),literal("",0),self.input_eof); self.progress.scan_work = self.cursor.work();
        if (got.is_err()) {
            let error = got.unwrap_err(); let at: core::option::Option<i32> = match(error) { ext::http::Error::Limit(n) -> core::option::Some(n), _ -> core::option::None() };
            if (at.is_some()) { let classified = self.request_line_limit(at.unwrap()); if (classified.is_err()) { return core::result::Err(classified.unwrap_err()); } if (classified.unwrap() == 2) { return core::result::Err(Cause::RequestTargetLimit); } if (classified.unwrap() == 1) { return core::result::Err(Cause::RequestLineLimit); } }
            return core::result::Err(Cause::Http(error));
        } let after = self.active(); if (after.is_err()) { return core::result::Err(after.unwrap_err()); } return core::result::Ok(got.unwrap());
    }
    fn receive_wire(&self) -> core::result::Result<bool,Cause> {
        let remaining: i32 = self.options.request_bytes-self.wire.len(); if (remaining <= 0) { return core::result::Err(Cause::RequestLimit); }
        let count: i32 = remaining; if (count > 1024) { count = 1024; }
        let storage: [i32;256] = [0;256]; let scratch: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(storage),1024);
        while (true) {
            let allowed = self.call(); if (allowed.is_err()) { return allowed; } let got = self.socket.receive(core::slice::view(scratch,count).unwrap());
            if (got.is_ok()) { self.progress.received += got.unwrap() as u64; if (got.unwrap() == 0) { self.input_eof = true; self.progress.peer_eof = true; } }
            let after = self.active();
            if (got.is_err() && !transient(got.unwrap_err())) { return core::result::Err(Cause::Io(got.unwrap_err())); } if (after.is_err()) { return after; }
            if (got.is_ok()) {
                let n: i32 = got.unwrap(); let paid = self.pay(n as u64); if (paid.is_err()) { return paid; }
                if (self.wire.try_extend(core::slice::view(scratch,n).unwrap()).is_err()) { return core::result::Err(Cause::AllocationFailed); } self.progress.retained = self.wire.len(); return core::result::Ok(n > 0);
            }
