// One checked HTTP/1 exchange over an explicit numeric endpoint.
module ext::http_client;
import alloc::vec;
import core::clone;
import core::io;
import core::mem;
import core::net;
import core::option;
import core::result;
import core::slice;
import core::time;
import ext::http;
import std::clock;
import std::socket;

pub struct Request { method: core::slice::View<u8>, target: core::slice::View<u8>, authority: core::slice::View<u8>, headers: core::slice::View<ext::http::Field>, body: core::slice::View<u8> }
pub enum Trailing { Discard, Reject }
pub struct Options { trailing: Trailing, wire: ext::http::Limits, request_bytes: i32, response_bytes: i32, interim_count: i32, interim_bytes: i32, io_calls: u64, work: u64 }
pub enum Stage { Prepare, Open, Connect, Send, Receive, Shutdown, Validate, Decode, Close, Publish }
pub enum Cause { InvalidOptions, UnsupportedRequest, UnsupportedHeader(i32), UnsupportedUpgrade, AllocationFailed, Timeout, Clock(std::clock::Error), Io(core::io::Error), Http(ext::http::Error), RequestLimit, ResponseLimit, BodyLimit, InterimLimit, IoLimit, WorkLimit, BoundaryMismatch, Inactive }
pub struct Stats { request_bytes: i32, request_sent: i32, response_received: u64, interim_count: i32, discarded_bytes: i32, io_calls: u64, work: u64, upload_stopped: bool, write_shutdown: bool }
pub struct Failure { cause: Cause, stage: Stage, message_offset: i32, stats: Stats, cleanup: core::option::Option<core::io::Error> }
// Failure contains only diagnostic metadata; it owns no allocation or native handle.
pub impl core::clone::Destroy<Failure> for Failure {
    pub fn destroy_value(owned: Failure) {}
}
pub struct Readiness { readable: bool, writable: bool, hangup: bool, error: bool }
pub struct Interest { readable: bool, writable: bool, immediate: bool }
pub enum Status { Active, Complete, Failed, Aborted }
pub struct Prepared { owner: Owners, state: State, track: Track, active: bool }
pub enum Need { Local, Transfer, StopUpload, FinishTransport, Complete(Response) }
pub struct Protocol { owner: Owners, state: State, track: Track, phase: ProtocolPhase, status: Status, failure: core::option::Option<Failure>, owned: bool, sending: i32 }
pub struct Exchange { protocol: Protocol, socket: std::socket::Socket, endpoint: core::net::SocketAddr, phase: Phase, status: Status, read_blocked: bool, write_blocked: bool, send_turn: bool, failure: core::option::Option<Failure> }
enum ProtocolPhase { Scan, Transfer, StopUpload, Decode, FinishTransport, Publish }
enum Phase { ConnectStart, WaitConnect, ConnectError, ConnectPeer, Protocol, Receive, Send, Shutdown, Close }
pub struct Response { wire: alloc::vec::Vec<u8>, method: alloc::vec::Vec<u8>, decoded: alloc::vec::Vec<u8>, interim: alloc::vec::Vec<ext::http::Head>, validated: ext::http::Message, final_offset: i32, stats: Stats }
struct Span { offset: i32, length: i32 }
struct Owners { request: alloc::vec::Vec<u8>, method: alloc::vec::Vec<u8>, wire: alloc::vec::Vec<u8>, decoded: alloc::vec::Vec<u8>, spans: alloc::vec::Vec<Span>, heads: alloc::vec::Vec<ext::http::Head> }
impl Owners {
    fn borrow(&self) -> &Owners { return self; }
    fn destroy(&self) { self.request.destroy(); self.method.destroy(); self.wire.destroy(); self.decoded.destroy(); self.spans.destroy(); self.heads.destroy(); }
}
struct State { options: Options, deadline: core::time::Deadline, last: core::time::Instant, stage: Stage, message_offset: i32, stats: Stats }
impl State { fn borrow(&self) -> &State { return self; } }
pub fn default_options() -> Options { return Options { trailing:Trailing::Discard,wire:ext::http::default_limits(),request_bytes:17825792,response_bytes:18874368,interim_count:8,interim_bytes:65536,io_calls:1048576,work:268435456 }; }
pub impl Response {
    pub fn as_view(&self) -> core::slice::View<u8> { return self.wire.as_view().subview(self.final_offset,self.final_offset+self.validated.consumed).unwrap(); }
    pub fn message(&self) -> ext::http::Message { return self.validated; }
    pub fn body(&self) -> core::slice::View<u8> { return self.decoded.as_view(); }
    pub fn informational(&self) -> core::slice::View<ext::http::Head> { return self.interim.as_view(); }
    pub fn destroy(&self) { self.interim.destroy(); self.decoded.destroy(); self.wire.destroy(); self.method.destroy(); }
}
fn literal(value: str, count: i32) -> core::slice::View<u8> { let bytes: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::string_data_ptr(value),count); return core::slice::view(bytes,count).unwrap(); }
fn valid<T>(v: core::slice::View<T>) -> bool { return v.start >= 0 && v.length >= 0 && v.start <= 2147483647-v.length; }
fn eq(v: core::slice::View<u8>, value: str, count: i32) -> bool { let other: core::slice::View<u8> = literal(value,count); if (v.len() != count) { return false; } let i: i32 = 0; while (i < count) { if (v.get(i).unwrap() != other.get(i).unwrap()) { return false; } i += 1; } return true; }
fn named(v: core::slice::View<u8>, value: str, count: i32) -> bool { return ext::http::equal_name(v,literal(value,count)); }
fn field(name: core::slice::View<u8>, value: core::slice::View<u8>) -> ext::http::Field { return ext::http::Field { raw:literal("",0),name:name,value:value,offset:0 }; }
fn family(endpoint: core::net::SocketAddr) -> std::socket::Family { return match(endpoint) { core::net::SocketAddr::V4(v) -> std::socket::Family::Ipv4, core::net::SocketAddr::V6(v) -> std::socket::Family::Ipv6 }; }
fn checked(o: Options) -> bool { let l: ext::http::Limits = o.wire; return o.request_bytes >= 0 && o.response_bytes >= 0 && o.interim_count >= 0 && o.interim_bytes >= 0 && o.io_calls > 0 && l.head_bytes >= 0 && l.line_bytes >= 0 && l.headers >= 0 && l.body_bytes >= 0 && l.trailer_bytes >= 0 && l.trailers >= 0 && l.chunks >= 0; }
fn charge(s: &State, amount: u64) -> core::result::Result<bool,Cause> { if (amount > s.options.work-s.stats.work) { return core::result::Err(Cause::WorkLimit); } s.stats.work += amount; return core::result::Ok(true); }
fn active(s: &State) -> core::result::Result<bool,Cause> {
    let read: core::result::Result<core::time::Instant,std::clock::Error> = std::clock::monotonic_now(); if (read.is_err()) { return core::result::Err(Cause::Clock(read.unwrap_err())); }
    let value: core::time::Instant = read.unwrap(); if (value.compare(s.last) < 0) { return core::result::Err(Cause::Clock(std::clock::Error::ClockReversed)); } s.last = value;
    if (s.deadline.is_expired(value)) { return core::result::Err(Cause::Timeout); } return core::result::Ok(true);
}
fn call(s: &State) -> core::result::Result<bool,Cause> { let before = active(s); if (before.is_err()) { return before; } if (s.stats.io_calls == s.options.io_calls) { return core::result::Err(Cause::IoLimit); } s.stats.io_calls += 1; return core::result::Ok(true); }
fn fail(s: &State, cause: Cause, cleanup: core::option::Option<core::io::Error>) -> Failure { return Failure { cause:cause,stage:s.stage,message_offset:s.message_offset,stats:s.stats,cleanup:cleanup }; }
fn digits(value: i32) -> i32 { let n: i32 = value; let count: i32 = 1; while (n >= 10) { n /= 10; count += 1; } return count; }
fn prepare(s: &State, q: Request, owner: &Owners) -> core::result::Result<bool,Cause> {
    let before = active(s); if (before.is_err()) { return before; }
    if (!valid(q.method) || !valid(q.target) || !valid(q.authority) || !valid(q.headers) || !valid(q.body)) { return core::result::Err(Cause::Http(ext::http::Error::Bounds)); }
    if (q.method.is_empty() || q.target.is_empty() || eq(q.method,"CONNECT",7) || (q.target.get(0).unwrap() != 47 && !(eq(q.method,"OPTIONS",7) && eq(q.target,"*",1))) || (eq(q.method,"TRACE",5) && !q.body.is_empty())) { return core::result::Err(Cause::UnsupportedRequest); }
    let start_size: u64 = (q.method.len() as u64)+(q.target.len() as u64)+10;
    let head_size: u64 = start_size+49+(q.authority.len() as u64)+(digits(q.body.len()) as u64);
    if (start_size > s.options.wire.line_bytes as u64 || head_size > s.options.wire.head_bytes as u64 || q.headers.len() > s.options.wire.headers-3 || q.body.len() > s.options.wire.body_bytes || head_size+(q.body.len() as u64) > s.options.request_bytes as u64) { return core::result::Err(Cause::RequestLimit); }
    let header_work = charge(s,q.headers.len() as u64); if (header_work.is_err()) { return header_work; }
    let i: i32 = 0;
    while (i < q.headers.len()) {
        let observed = active(s); if (observed.is_err()) { return observed; }
        let item: ext::http::Field = q.headers.get(i).unwrap(); if (!valid(item.name) || !valid(item.value)) { return core::result::Err(Cause::Http(ext::http::Error::Bounds)); }
        if (named(item.name,"host",4) || named(item.name,"connection",10) || named(item.name,"content-length",14) || named(item.name,"transfer-encoding",17) || named(item.name,"expect",6) || named(item.name,"upgrade",7) || named(item.name,"te",2) || named(item.name,"trailer",7) || (item.name.len() >= 6 && named(item.name.subview(0,6).unwrap(),"proxy-",6))) { return core::result::Err(Cause::UnsupportedHeader(i)); }
        head_size += (item.name.len() as u64)+(item.value.len() as u64)+4; if (head_size > s.options.wire.head_bytes as u64 || head_size+(q.body.len() as u64) > s.options.request_bytes as u64) { return core::result::Err(Cause::RequestLimit); } i += 1;
    }
    if (start_size > s.options.wire.line_bytes as u64 || head_size > s.options.wire.head_bytes as u64 || q.headers.len() > s.options.wire.headers-3 || q.body.len() > s.options.wire.body_bytes || head_size+(q.body.len() as u64) > s.options.request_bytes as u64) { return core::result::Err(Cause::RequestLimit); }
    let paid = charge(s,4*(head_size+(q.body.len() as u64))+(q.method.len() as u64)); if (paid.is_err()) { return paid; }
    let copied = alloc::vec::from_view(q.method); if (copied.is_err()) { return core::result::Err(Cause::AllocationFailed); } owner.method = copied.unwrap();
    let line: alloc::vec::Vec<u8> = alloc::vec::new();
    if (line.try_extend(q.method).is_err() || line.try_extend(literal(" ",1)).is_err() || line.try_extend(q.target).is_err() || line.try_extend(literal(" HTTP/1.1",9)).is_err()) { line.destroy(); return core::result::Err(Cause::AllocationFailed); }
    let fields: alloc::vec::Vec<ext::http::Field> = alloc::vec::new();
    if (fields.try_extend(q.headers).is_err() || fields.try_push(field(literal("Host",4),q.authority)).is_err() || fields.try_push(field(literal("Connection",10),literal("close",5))).is_err()) { line.destroy(); fields.destroy(); return core::result::Err(Cause::AllocationFailed); }
    let encoded = ext::http::encode_request(line.as_view(),fields.as_view(),q.body,s.options.wire); line.destroy(); fields.destroy();
    if (encoded.is_err()) { return core::result::Err(Cause::Http(encoded.unwrap_err())); }
    owner.request = encoded.unwrap(); s.stats.request_bytes = owner.request.len();
    return active(s);
}
fn canonical(s: &State, bytes: core::slice::View<u8>, method: core::slice::View<u8>, decoded: i32, final: bool, eof: bool) -> core::result::Result<ext::http::Message,Cause> {
    s.stage = Stage::Validate;
    let allowance: u64 = 4*(bytes.len() as u64); if (final) { allowance += 4*(s.options.wire.head_bytes as u64)*((s.options.wire.trailers as u64)+1); }
    let paid = charge(s,allowance); if (paid.is_err()) { return core::result::Err(paid.unwrap_err()); }
    let parsed = ext::http::parse_response(bytes,method,eof,s.options.wire); if (parsed.is_err()) { return core::result::Err(Cause::Http(parsed.unwrap_err())); }
    let message: ext::http::Message = parsed.unwrap(); if (message.consumed != bytes.len() || message.decoded_length != decoded) { return core::result::Err(Cause::BoundaryMismatch); }
    let after = active(s); if (after.is_err()) { return core::result::Err(after.unwrap_err()); } return core::result::Ok(message);
}
struct Track { cursor: ext::http::Cursor, charged: u64, close: bool, eof: bool, status: i32, head_end: i32, validated: core::option::Option<ext::http::Message> }
impl Track { fn borrow(&self) -> &Track { return self; } }
// One cursor event. A boundary is canonically validated before it is accepted.
// Only spans survive interim scanning; retained Head views are built after freeze.
fn scan_once(s: &State, owner: &Owners, track: &Track) -> core::result::Result<i32,Cause> {
    s.stage = Stage::Receive; let before = active(s); if (before.is_err()) { return core::result::Err(before.unwrap_err()); }
    let bytes: core::slice::View<u8> = owner.wire.as_view().subview(s.message_offset,owner.wire.len()).unwrap();
    let got = track.cursor.advance(bytes,owner.method.as_view(),track.eof);
    let spent: u64 = track.cursor.work(); let paid = charge(s,spent-track.charged); track.charged = spent;
    if (paid.is_err()) { return core::result::Err(paid.unwrap_err()); } if (got.is_err()) { return core::result::Err(Cause::Http(got.unwrap_err())); }
    let after = active(s); if (after.is_err()) { return core::result::Err(after.unwrap_err()); }
    let event: ext::http::Scan = got.unwrap();
    let pending: bool = match(event) { ext::http::Scan::NeedMore -> true, _ -> false }; if (pending) { return core::result::Ok(0); }
    let ready: bool = match(event) { ext::http::Scan::HeadReady(v) -> true, _ -> false };
    if (ready) {
        let info: ext::http::HeadInfo = match(event) { ext::http::Scan::HeadReady(v) -> v, _ -> ext::http::HeadInfo { status:0,version:0,kind:ext::http::BodyKind::Empty,content_length:0,head_end:0 } };
        track.status = info.status; track.head_end = info.head_end;
        if (info.status == 101) { return core::result::Err(Cause::UnsupportedUpgrade); }
        if (info.status >= 200) {
            track.close = match(info.kind) { ext::http::BodyKind::Close -> true, _ -> false };
            if (s.stats.request_sent < s.stats.request_bytes) { s.stats.upload_stopped = true; return core::result::Ok(2); }
        }
        return core::result::Ok(1);
    }
    let boundary: ext::http::FrameBoundary = match(event) { ext::http::Scan::Boundary(v) -> v, _ -> ext::http::FrameBoundary { consumed:0,decoded_length:0 } };
    if (boundary.consumed < 0 || boundary.consumed > bytes.len()) { return core::result::Err(Cause::BoundaryMismatch); }
    let end: i32 = s.message_offset+boundary.consumed;
    let selected: core::slice::View<u8> = owner.wire.as_view().subview(s.message_offset,end).unwrap();
    if (track.status < 200) {
        if (s.stats.interim_count == s.options.interim_count || end > s.options.interim_bytes) { return core::result::Err(Cause::InterimLimit); }
        let parsed = canonical(s,selected,owner.method.as_view(),boundary.decoded_length,false,track.eof); if (parsed.is_err()) { return core::result::Err(parsed.unwrap_err()); }
        if (owner.spans.try_push(Span { offset:s.message_offset,length:boundary.consumed }).is_err()) { return core::result::Err(Cause::AllocationFailed); }
        s.stats.interim_count += 1; s.message_offset = end;
        let next = ext::http::cursor(ext::http::CursorMode::Response,s.options.wire,s.options.response_bytes-end,s.options.work-s.stats.work);
        if (next.is_err()) { return core::result::Err(Cause::Http(next.unwrap_err())); }
        track.cursor = next.unwrap(); track.charged = 0; track.close = false; track.status = 0; track.head_end = 0;
        return core::result::Ok(1);
    }
    let extra: i32 = owner.wire.len()-end;
    let reject: bool = match(s.options.trailing) { Trailing::Reject -> true, _ -> false };
    if (extra > 0 && reject) { return core::result::Err(Cause::Http(ext::http::Error::Malformed(boundary.consumed))); }
    s.stats.discarded_bytes = extra; owner.wire.try_resize(end,0 as u8).unwrap();
    let exact: core::slice::View<u8> = owner.wire.as_view().subview(s.message_offset,end).unwrap();
    let parsed = canonical(s,exact,owner.method.as_view(),boundary.decoded_length,true,track.eof);
    if (parsed.is_err()) { return core::result::Err(parsed.unwrap_err()); }
    track.validated = core::option::Some(parsed.unwrap()); return core::result::Ok(3);
}
fn decode(s: &State, owner: &Owners, message: ext::http::Message) -> core::result::Result<bool,Cause> {
    s.stage = Stage::Decode; let paid = charge(s,2*(message.decoded_length as u64)); if (paid.is_err()) { return paid; }
    if (owner.decoded.try_resize(message.decoded_length,0 as u8).is_err()) { return core::result::Err(Cause::AllocationFailed); }
    let decoded = ext::http::decode_into(message,owner.decoded.as_view()); if (decoded.is_err()) { return core::result::Err(Cause::Http(decoded.unwrap_err())); }
    if (decoded.unwrap() != message.decoded_length) { return core::result::Err(Cause::BoundaryMismatch); }
    let i: i32 = 0; while (i < owner.spans.len()) {
        let span: Span = owner.spans.get(i).unwrap(); let paid = charge(s,4*(span.length as u64)); if (paid.is_err()) { return paid; }
        let raw: core::slice::View<u8> = owner.wire.as_view().subview(span.offset,span.offset+span.length).unwrap();
        let head = ext::http::parse_response_head(raw,owner.method.as_view(),s.options.wire); if (head.is_err()) { return core::result::Err(Cause::Http(head.unwrap_err())); }
        if (owner.heads.try_push(head.unwrap()).is_err()) { return core::result::Err(Cause::AllocationFailed); } i += 1;
    }
    return active(s);
}
fn empty_owners() -> Owners { return Owners { request:alloc::vec::new(),method:alloc::vec::new(),wire:alloc::vec::new(),decoded:alloc::vec::new(),spans:alloc::vec::new(),heads:alloc::vec::new() }; }
fn running(status: Status) -> bool { return match(status) { Status::Active -> true, _ -> false }; }
fn empty_readiness() -> Readiness { return Readiness { readable:false,writable:false,hangup:false,error:false }; }
fn inactive(s: &State) -> Failure { return fail(s,Cause::Inactive,core::option::None()); }
fn protocol_guard(p: &Protocol) -> core::result::Result<bool,Failure> {
    let failed: bool = match(p.status) { Status::Failed -> true, _ -> false };
    if (failed) { return core::result::Err(p.failure.unwrap()); }
    if (!running(p.status)) { return core::result::Err(inactive(p.state.borrow())); }
    return core::result::Ok(true);
}
pub fn prepare_until(request: Request, options: Options, deadline: core::time::Deadline) -> core::result::Result<Prepared,Failure> {
    let state: State = State { options:options,deadline:deadline,last:core::time::instant(core::time::zero()),stage:Stage::Prepare,message_offset:0,stats:Stats { request_bytes:0,request_sent:0,response_received:0,interim_count:0,discarded_bytes:0,io_calls:0,work:0,upload_stopped:false,write_shutdown:false } };
    if (!checked(options)) { return core::result::Err(fail(state.borrow(),Cause::InvalidOptions,core::option::None())); }
    let owner: Owners = empty_owners();
    let prepared = prepare(state.borrow(),request,owner.borrow()); if (prepared.is_err()) { owner.destroy(); return core::result::Err(fail(state.borrow(),prepared.unwrap_err(),core::option::None())); }
    let made = ext::http::cursor(ext::http::CursorMode::Response,options.wire,options.response_bytes,options.work-state.stats.work);
    if (made.is_err()) { owner.destroy(); return core::result::Err(fail(state.borrow(),Cause::Http(made.unwrap_err()),core::option::None())); }
    let track: Track = Track { cursor:made.unwrap(),charged:0,close:false,eof:false,status:0,head_end:0,validated:core::option::None() };
    return core::result::Ok(Prepared { owner:owner,state:state,track:track,active:true });
}
pub impl Prepared {
    pub fn borrow(&self) -> &Prepared { return self; }
    pub fn stats(&self) -> Stats { return self.state.stats; }
    pub fn is_active(&self) -> bool { return self.active; }
    pub fn destroy(&self) -> bool { if (!self.active) { return false; } self.active = false; self.owner.destroy(); return true; }
    // Transfer actual HTTP ownership before any fallible driver work.
    pub fn into_protocol(&self) -> core::result::Result<Protocol,Failure> {
        if (!self.active) { return core::result::Err(inactive(self.state.borrow())); }
        let owner: Owners = self.owner; let state: State = self.state; let track: Track = self.track;
        self.active = false; self.owner = empty_owners(); self.track.validated = core::option::None();
        return core::result::Ok(Protocol { owner:owner,state:state,track:track,phase:ProtocolPhase::Scan,status:Status::Active,failure:core::option::None(),owned:true,sending:0 });
    }
    pub fn begin(&self, endpoint: core::net::SocketAddr) -> core::result::Result<Exchange,Failure> {
        let moved = self.into_protocol(); if (moved.is_err()) { return core::result::Err(moved.unwrap_err()); }
        let protocol: Protocol = moved.unwrap(); let before = protocol.before_io(Stage::Open);
        if (before.is_err()) { protocol.abort(); return core::result::Err(before.unwrap_err()); }
        let opened = std::socket::create(family(endpoint),std::socket::Kind::Tcp,true);
        if (opened.is_err()) { let failure: Failure = protocol.failure(Cause::Io(opened.unwrap_err())); protocol.abort(); return core::result::Err(failure); }
        let socket: std::socket::Socket = opened.unwrap(); let after = protocol.check();
        if (after.is_err()) {
            let failure: Failure = after.unwrap_err(); let closed = socket.close(); if (closed.is_err()) { failure.cleanup = core::option::Some(closed.unwrap_err()); }
            protocol.abort(); return core::result::Err(failure);
        }
        return core::result::Ok(Exchange { protocol:protocol,socket:socket,endpoint:endpoint,phase:Phase::ConnectStart,status:Status::Active,read_blocked:false,write_blocked:false,send_turn:false,failure:core::option::None() });
    }
}
pub impl Protocol {
    pub fn borrow(&self) -> &Protocol { return self; }
    pub fn stats(&self) -> Stats { return self.state.stats; }
    // Snapshot after successful check/before_wait; no new clock or allowance.
    pub fn remaining(&self) -> core::time::Duration { return self.state.deadline.remaining(self.state.last); }
    pub fn status(&self) -> Status { return self.status; }
    pub fn last_failure(&self) -> core::option::Option<Failure> { return self.failure; }
    pub fn pending_send_bytes(&self) -> i32 { return self.sending; }
    // Sticky diagnostics do not relinquish HTTP ownership. The driver closes
    // its transport, then aborts this owner even under an exhausted budget.
    pub fn failure(&self, cause: Cause) -> Failure {
        let failed: bool = match(self.status) { Status::Failed -> true, _ -> false };
        if (failed) { return self.failure.unwrap(); }
        if (!running(self.status)) { return inactive(self.state.borrow()); }
        let error: Failure = fail(self.state.borrow(),cause,core::option::None()); self.failure = core::option::Some(error); self.status = Status::Failed; return error;
    }
    pub fn check(&self) -> core::result::Result<bool,Failure> {
        let guard = protocol_guard(self); if (guard.is_err()) { return guard; }
        let observed = active(self.state.borrow()); if (observed.is_err()) { return core::result::Err(self.failure(observed.unwrap_err())); }
        return core::result::Ok(true);
    }
    pub fn before_io(&self, stage: Stage) -> core::result::Result<bool,Failure> {
        let guard = protocol_guard(self); if (guard.is_err()) { return guard; }
        self.state.stage = stage; let paid = call(self.state.borrow()); if (paid.is_err()) { return core::result::Err(self.failure(paid.unwrap_err())); }
        return core::result::Ok(true);
    }
    // Always charges. The owning driver checks its actual interest first.
    pub fn before_wait(&self) -> core::result::Result<bool,Failure> {
        let guard = protocol_guard(self); if (guard.is_err()) { return guard; }
        let paid = call(self.state.borrow()); if (paid.is_err()) { return core::result::Err(self.failure(paid.unwrap_err())); }
        return core::result::Ok(true);
    }
    pub fn advance(&self) -> core::result::Result<Need,Failure> {
        let checked = self.check(); if (checked.is_err()) { return core::result::Err(checked.unwrap_err()); }
        let scanning: bool = match(self.phase) { ProtocolPhase::Scan -> true, _ -> false };
        if (scanning) {
            let scanned = scan_once(self.state.borrow(),self.owner.borrow(),self.track.borrow()); if (scanned.is_err()) { return core::result::Err(self.failure(scanned.unwrap_err())); }
            let event: i32 = scanned.unwrap();
            if (event == 0) { self.phase = ProtocolPhase::Transfer; return core::result::Ok(Need::Transfer); }
            if (event == 2) { self.phase = ProtocolPhase::StopUpload; return core::result::Ok(Need::StopUpload); }
            if (event == 3) { self.phase = ProtocolPhase::Decode; }
            return core::result::Ok(Need::Local);
        }
        let decoding: bool = match(self.phase) { ProtocolPhase::Decode -> true, _ -> false };
        if (decoding) {
            let decoded = decode(self.state.borrow(),self.owner.borrow(),self.track.validated.unwrap()); if (decoded.is_err()) { return core::result::Err(self.failure(decoded.unwrap_err())); }
            self.phase = ProtocolPhase::FinishTransport; self.state.stage = Stage::Close; return core::result::Ok(Need::FinishTransport);
        }
        let publishing: bool = match(self.phase) { ProtocolPhase::Publish -> true, _ -> false };
        if (publishing) {
            self.owner.request.destroy(); self.owner.spans.destroy(); self.state.stage = Stage::Publish;
            let checked = self.check(); if (checked.is_err()) { return core::result::Err(checked.unwrap_err()); }
            let response: Response = Response { wire:self.owner.wire,method:self.owner.method,decoded:self.owner.decoded,interim:self.owner.heads,validated:self.track.validated.unwrap(),final_offset:self.state.message_offset,stats:self.state.stats };
            self.owner = empty_owners(); self.track.validated = core::option::None(); self.owned = false; self.status = Status::Complete;
            return core::result::Ok(Need::Complete(response));
        }
        return match(self.phase) { ProtocolPhase::Transfer -> core::result::Ok(Need::Transfer), ProtocolPhase::StopUpload -> core::result::Ok(Need::StopUpload), ProtocolPhase::FinishTransport -> core::result::Ok(Need::FinishTransport), _ -> core::result::Ok(Need::Local) };
    }
    pub fn receive_limit(&self) -> core::result::Result<i32,Failure> {
        let guard = protocol_guard(self); if (guard.is_err()) { return core::result::Err(guard.unwrap_err()); }
        let transfer: bool = match(self.phase) { ProtocolPhase::Transfer -> true, _ -> false };
        if (!transfer || self.track.eof) { return core::result::Err(self.failure(Cause::BoundaryMismatch)); }
        let raw: i32 = self.state.options.response_bytes-self.owner.wire.len(); let capacity: i32 = raw;
        if (self.track.close) { let body: i32 = self.state.options.wire.body_bytes-(self.owner.wire.len()-self.state.message_offset-self.track.head_end); if (body < capacity) { capacity = body; } }
        if (capacity < 0 || (capacity == 0 && !self.track.close)) { return core::result::Err(self.failure(Cause::ResponseLimit)); }
        if (capacity == 0) { return core::result::Ok(1); }
        if (capacity > 1024) { capacity = 1024; } return core::result::Ok(capacity);
    }
    pub fn feed(&self, bytes: core::slice::View<u8>) -> core::result::Result<bool,Failure> {
        let limit = self.receive_limit(); if (limit.is_err()) { return core::result::Err(limit.unwrap_err()); }
        if (!valid(bytes) || bytes.len() <= 0 || bytes.len() > limit.unwrap()) { return core::result::Err(self.failure(Cause::Io(core::io::Error::InvalidCount))); }
        // Confirm native progress before observing a late deadline/clock error.
        self.state.stats.response_received += bytes.len() as u64;
        let checked = self.check(); if (checked.is_err()) { return checked; }
        let raw: i32 = self.state.options.response_bytes-self.owner.wire.len();
        if (raw == 0) { return core::result::Err(self.failure(Cause::ResponseLimit)); }
        if (self.track.close && self.state.options.wire.body_bytes == self.owner.wire.len()-self.state.message_offset-self.track.head_end) { return core::result::Err(self.failure(Cause::BodyLimit)); }
        if (self.owner.wire.try_extend(bytes).is_err()) { return core::result::Err(self.failure(Cause::AllocationFailed)); }
        self.phase = ProtocolPhase::Scan; return core::result::Ok(true);
    }
    pub fn feed_eof(&self) -> core::result::Result<bool,Failure> {
        let limit = self.receive_limit(); if (limit.is_err()) { return core::result::Err(limit.unwrap_err()); }
        let checked = self.check(); if (checked.is_err()) { return checked; }
        self.track.eof = true; self.phase = ProtocolPhase::Scan; return core::result::Ok(true);
    }
    pub fn start_send(&self) -> core::result::Result<core::option::Option<core::slice::View<u8>>,Failure> {
        let guard = protocol_guard(self); if (guard.is_err()) { return core::result::Err(guard.unwrap_err()); }
        let transfer: bool = match(self.phase) { ProtocolPhase::Transfer -> true, _ -> false };
        if (!transfer || self.sending != 0) { return core::result::Err(self.failure(Cause::BoundaryMismatch)); }
        if (self.state.stats.upload_stopped || self.state.stats.request_sent == self.state.stats.request_bytes) { return core::result::Ok(core::option::None()); }
        let count: i32 = self.state.stats.request_bytes-self.state.stats.request_sent; if (count > 1024) { count = 1024; }
        self.sending = count;
        return core::result::Ok(core::option::Some(self.owner.request.as_view().subview(self.state.stats.request_sent,self.state.stats.request_sent+count).unwrap()));
    }
    pub fn commit_send(&self, count: i32) -> core::result::Result<bool,Failure> {
        let guard = protocol_guard(self); if (guard.is_err()) { return guard; }
        if (self.sending <= 0 || count <= 0 || count > self.sending) { return core::result::Err(self.failure(Cause::Io(core::io::Error::WriteZero))); }
        self.state.stats.request_sent += count; self.sending = 0;
        return self.check();
    }
    // Caller proves no native request remains in flight (plain EAGAIN/EINTR,
    // or an explicitly cancelled/destroyed transport). WANT alone is no proof.
    pub fn cancel_send(&self) -> core::result::Result<bool,Failure> {
        let guard = protocol_guard(self); if (guard.is_err()) { return guard; }
        let pending: bool = self.sending != 0; self.sending = 0; return core::result::Ok(pending);
    }
    pub fn acknowledge_stop(&self) -> core::result::Result<bool,Failure> {
        let guard = protocol_guard(self); if (guard.is_err()) { return guard; }
        let stopping: bool = match(self.phase) { ProtocolPhase::StopUpload -> true, _ -> false };
        if (!stopping) { return core::result::Err(self.failure(Cause::BoundaryMismatch)); }
        self.phase = ProtocolPhase::Scan; return core::result::Ok(true);
    }
    pub fn record_write_shutdown(&self) -> core::result::Result<bool,Failure> {
        let guard = protocol_guard(self); if (guard.is_err()) { return guard; }
        self.state.stats.write_shutdown = true; return self.check();
    }
    // Driver acknowledges completed transport cleanup, never merely HTTP EOF.
    pub fn transport_finished(&self) -> core::result::Result<bool,Failure> {
        let guard = protocol_guard(self); if (guard.is_err()) { return guard; }
        let finishing: bool = match(self.phase) { ProtocolPhase::FinishTransport -> true, _ -> false };
        if (!finishing || self.sending != 0) { return core::result::Err(self.failure(Cause::BoundaryMismatch)); }
        self.state.stage = Stage::Close; let checked = self.check(); if (checked.is_err()) { return checked; }
        self.phase = ProtocolPhase::Publish; return core::result::Ok(true);
    }
    pub fn abort(&self) -> bool {
        if (!self.owned) { return false; } self.owned = false; self.owner.destroy(); self.track.validated = core::option::None(); self.sending = 0;
        if (running(self.status)) { self.status = Status::Aborted; } return true;
    }
}
pub fn begin_until(endpoint: core::net::SocketAddr, request: Request, options: Options, deadline: core::time::Deadline) -> core::result::Result<Exchange,Failure> {
    let made = prepare_until(request,options,deadline); if (made.is_err()) { return core::result::Err(made.unwrap_err()); }
    let prepared: Prepared = made.unwrap(); return prepared.begin(endpoint);
}
fn upload(x: &Exchange) -> bool { let stats: Stats = x.protocol.stats(); return !stats.upload_stopped && stats.request_sent < stats.request_bytes; }
fn retire(x: &Exchange, failure: Failure, closed: core::result::Result<i32,core::io::Error>) -> Failure {
    let error: Failure = failure; if (closed.is_err()) { error.cleanup = core::option::Some(closed.unwrap_err()); }
    x.protocol.abort(); x.failure = core::option::Some(error); x.status = Status::Failed; return error;
}
fn stop(x: &Exchange, failure: Failure) -> Failure { let closed = x.socket.close(); return retire(x,failure,closed); }
// One transport action, with at most one active network leaf.
fn advance(x: &Exchange, ready: Readiness) -> core::result::Result<bool,Failure> {
    let is_connect_start: bool = match(x.phase) { Phase::ConnectStart -> true, _ -> false };
    if (is_connect_start) {
        let before = x.protocol.before_io(Stage::Connect); if (before.is_err()) { return before; }
        let started = x.socket.connect(x.endpoint); let after = x.protocol.check(); if (after.is_err()) { return after; }
        if (started.is_err()) { return core::result::Err(x.protocol.failure(Cause::Io(started.unwrap_err()))); }
        let connected: bool = match(started.unwrap()) { std::socket::Connection::Connected -> true, _ -> false };
        x.phase = Phase::WaitConnect; if (connected) { x.phase = Phase::Protocol; } return core::result::Ok(true);
    }
    let is_wait_connect: bool = match(x.phase) { Phase::WaitConnect -> true, _ -> false };
    if (is_wait_connect) { if (ready.writable || ready.error || ready.hangup) { x.phase = Phase::ConnectError; } return core::result::Ok(true); }
    let is_connect_error: bool = match(x.phase) { Phase::ConnectError -> true, _ -> false };
    if (is_connect_error) {
        let before = x.protocol.before_io(Stage::Connect); if (before.is_err()) { return before; }
        let error = x.socket.take_error(); let after = x.protocol.check(); if (after.is_err()) { return after; }
        if (error.is_err()) { return core::result::Err(x.protocol.failure(Cause::Io(error.unwrap_err()))); }
        if (error.unwrap().is_some()) { return core::result::Err(x.protocol.failure(Cause::Io(core::io::Error::Host(error.unwrap().unwrap())))); }
        x.phase = Phase::ConnectPeer; return core::result::Ok(true);
    }
    let is_connect_peer: bool = match(x.phase) { Phase::ConnectPeer -> true, _ -> false };
    if (is_connect_peer) {
        let before = x.protocol.before_io(Stage::Connect); if (before.is_err()) { return before; }
        let peer = x.socket.peer_addr(); let after = x.protocol.check(); if (after.is_err()) { return after; }
        if (peer.is_err()) { let pending: bool = match(peer.unwrap_err()) { core::io::Error::Host(code) -> code == 107, _ -> false }; if (!pending) { return core::result::Err(x.protocol.failure(Cause::Io(peer.unwrap_err()))); } x.phase = Phase::WaitConnect; }
        else { x.phase = Phase::Protocol; } return core::result::Ok(true);
    }
    let is_receive: bool = match(x.phase) { Phase::Receive -> true, _ -> false };
    if (is_receive) {
        if (x.read_blocked) { if (upload(x) && !x.write_blocked) { x.phase = Phase::Send; } return core::result::Ok(true); }
        let limit = x.protocol.receive_limit(); if (limit.is_err()) { return core::result::Err(limit.unwrap_err()); }
        let count: i32 = limit.unwrap(); let storage: [i32;256] = [0;256]; let scratch: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::i32_array_data_ptr(storage),1024);
        let before = x.protocol.before_io(Stage::Receive); if (before.is_err()) { return before; }
        let result = x.socket.receive(core::slice::view(scratch,count).unwrap());
        if (result.is_ok()) {
            let got: i32 = result.unwrap(); if (got < 0 || got > count) { return core::result::Err(x.protocol.failure(Cause::Io(core::io::Error::InvalidCount))); }
            let fed: core::result::Result<bool,Failure> = core::result::Ok(true);
            if (got == 0) { fed = x.protocol.feed_eof(); } else { fed = x.protocol.feed(core::slice::view(scratch,got).unwrap()); }
            if (fed.is_err()) { return fed; }
            x.send_turn = true; x.write_blocked = false; x.phase = Phase::Protocol; return core::result::Ok(true);
        }
        let after = x.protocol.check(); if (after.is_err()) { return after; }
        let error: core::io::Error = result.unwrap_err(); if (core::io::is_interrupted(error)) { return core::result::Ok(true); }
        let blocked: bool = match(error) { core::io::Error::WouldBlock -> true, _ -> false }; if (!blocked) { return core::result::Err(x.protocol.failure(Cause::Io(error))); }
        x.read_blocked = true; x.phase = Phase::Send; return core::result::Ok(true);
    }
    let is_send: bool = match(x.phase) { Phase::Send -> true, _ -> false };
    if (is_send) {
        if (!upload(x) || x.write_blocked) { x.phase = Phase::Receive; return core::result::Ok(true); }
        let staged = x.protocol.start_send(); if (staged.is_err()) { return core::result::Err(staged.unwrap_err()); }
        if (staged.unwrap().is_none()) { x.phase = Phase::Receive; return core::result::Ok(true); }
        let bytes: core::slice::View<u8> = staged.unwrap().unwrap(); let before = x.protocol.before_io(Stage::Send); if (before.is_err()) { return before; }
        let sent = x.socket.send(bytes);
        if (sent.is_ok()) { let committed = x.protocol.commit_send(sent.unwrap()); if (committed.is_err()) { return committed; } x.read_blocked = false; }
        else {
            let cancelled = x.protocol.cancel_send(); if (cancelled.is_err()) { return cancelled; } let after = x.protocol.check(); if (after.is_err()) { return after; }
            let error: core::io::Error = sent.unwrap_err(); if (core::io::is_interrupted(error)) { return core::result::Ok(true); }
            let blocked: bool = match(error) { core::io::Error::WouldBlock -> true, _ -> false }; if (!blocked) { return core::result::Err(x.protocol.failure(Cause::Io(error))); } x.write_blocked = true;
        }
        x.send_turn = false; x.phase = Phase::Receive; return core::result::Ok(true);
    }
    let is_shutdown: bool = match(x.phase) { Phase::Shutdown -> true, _ -> false };
    if (is_shutdown) {
        let before = x.protocol.before_io(Stage::Shutdown); if (before.is_err()) { return before; }
        let stopped = x.socket.shutdown(std::socket::Shutdown::Write);
        if (stopped.is_err()) { let after = x.protocol.check(); if (after.is_err()) { return after; } return core::result::Err(x.protocol.failure(Cause::Io(stopped.unwrap_err()))); }
        let recorded = x.protocol.record_write_shutdown(); if (recorded.is_err()) { return recorded; }
        let acknowledged = x.protocol.acknowledge_stop(); if (acknowledged.is_err()) { return acknowledged; }
        x.phase = Phase::Protocol; return core::result::Ok(true);
    }
    return core::result::Ok(true);
}
pub impl Exchange {
    pub fn borrow(&self) -> &Exchange { return self; }
    pub fn stats(&self) -> Stats { return self.protocol.stats(); }
    pub fn status(&self) -> Status { return self.status; }
    pub fn last_failure(&self) -> core::option::Option<Failure> { return self.failure; }
    pub fn raw_handle(&self) -> core::option::Option<i32> { if (!running(self.status)) { return core::option::None(); } return self.socket.raw_handle(); }
    pub fn interest(&self) -> Interest {
        if (!running(self.status)) { return Interest { readable:false,writable:false,immediate:false }; }
        return match(self.phase) {
            Phase::WaitConnect -> Interest { readable:false,writable:true,immediate:false },
            Phase::Receive -> Interest { readable:true,writable:upload(self),immediate:!self.read_blocked || (upload(self) && !self.write_blocked) },
            Phase::Send -> Interest { readable:true,writable:upload(self),immediate:!self.read_blocked || (upload(self) && !self.write_blocked) },
            _ -> Interest { readable:false,writable:false,immediate:true }
        };
    }
    pub fn before_wait(&self) -> core::result::Result<bool,Failure> {
        let failed: bool = match(self.status) { Status::Failed -> true, _ -> false }; if (failed) { return core::result::Err(self.failure.unwrap()); }
        if (!running(self.status)) { return core::result::Err(inactive(self.protocol.state.borrow())); }
        let observed = self.protocol.check(); if (observed.is_err()) { return core::result::Err(stop(self,observed.unwrap_err())); }
        if (self.interest().immediate) { return core::result::Ok(false); }
        let paid = self.protocol.before_wait(); if (paid.is_err()) { return core::result::Err(stop(self,paid.unwrap_err())); } return core::result::Ok(true);
    }
    pub fn step(&self, ready: Readiness) -> core::result::Result<core::option::Option<Response>,Failure> {
        let failed: bool = match(self.status) { Status::Failed -> true, _ -> false }; if (failed) { return core::result::Err(self.failure.unwrap()); }
        if (!running(self.status)) { return core::result::Err(inactive(self.protocol.state.borrow())); }
        let observed = self.protocol.check(); if (observed.is_err()) { return core::result::Err(stop(self,observed.unwrap_err())); }
        if (ready.readable || ready.hangup || ready.error) { self.read_blocked = false; let sending: bool = match(self.phase) { Phase::Send -> true, _ -> false }; if (sending) { self.phase = Phase::Receive; } }
        if (ready.writable || ready.hangup || ready.error) { self.write_blocked = false; }
        let closing: bool = match(self.phase) { Phase::Close -> true, _ -> false };
        if (closing) {
            let checked = self.protocol.check(); let closed = self.socket.close();
            if (checked.is_err()) { return core::result::Err(retire(self,checked.unwrap_err(),closed)); }
            if (closed.is_err()) { let failure: Failure = self.protocol.failure(Cause::Io(closed.unwrap_err())); return core::result::Err(retire(self,failure,core::result::Ok(0))); }
            let finished = self.protocol.transport_finished(); if (finished.is_err()) { return core::result::Err(retire(self,finished.unwrap_err(),core::result::Ok(0))); }
            self.phase = Phase::Protocol; return core::result::Ok(core::option::None());
        }
        let local: bool = match(self.phase) { Phase::Protocol -> true, _ -> false };
        if (local) {
            let advanced = self.protocol.advance(); if (advanced.is_err()) { return core::result::Err(stop(self,advanced.unwrap_err())); }
            let need: Need = advanced.unwrap();
            let complete: core::option::Option<Response> = match(need) { Need::Complete(response) -> core::option::Some(response), _ -> core::option::None() };
            if (complete.is_some()) { self.status = Status::Complete; return core::result::Ok(complete); }
            let transfer: bool = match(need) { Need::Transfer -> true, _ -> false };
            if (transfer) { self.phase = Phase::Receive; if (self.send_turn && upload(self)) { self.phase = Phase::Send; } }
            let stopping: bool = match(need) { Need::StopUpload -> true, _ -> false }; if (stopping) { self.phase = Phase::Shutdown; }
            let finishing: bool = match(need) { Need::FinishTransport -> true, _ -> false }; if (finishing) { self.phase = Phase::Close; }
            return core::result::Ok(core::option::None());
        }
        let progressed = advance(self,ready); if (progressed.is_err()) { return core::result::Err(stop(self,progressed.unwrap_err())); } return core::result::Ok(core::option::None());
    }
    pub fn abort(&self) -> core::result::Result<bool,Failure> {
        if (!running(self.status)) { return core::result::Ok(false); }
        self.protocol.state.stage = Stage::Close; let closed = self.socket.close();
        let failure: core::option::Option<Failure> = core::option::None(); if (closed.is_err()) { failure = core::option::Some(self.protocol.failure(Cause::Io(closed.unwrap_err()))); }
        self.protocol.abort(); self.status = Status::Aborted;
        if (failure.is_some()) { self.failure = failure; return core::result::Err(failure.unwrap()); } return core::result::Ok(true);
    }
}
pub fn exchange_until(endpoint: core::net::SocketAddr, request: Request, options: Options, deadline: core::time::Deadline) -> core::result::Result<Response,Failure> {
    let made = begin_until(endpoint,request,options,deadline); if (made.is_err()) { return core::result::Err(made.unwrap_err()); }
    let exchange: Exchange = made.unwrap(); let ready: Readiness = empty_readiness();
    while (true) {
        let result = exchange.step(ready); ready = empty_readiness();
        if (result.is_err()) { return core::result::Err(result.unwrap_err()); }
        if (result.unwrap().is_some()) { return core::result::Ok(result.unwrap().unwrap()); }
        let interest: Interest = exchange.interest(); if (interest.immediate) { continue; }
        let charged = exchange.before_wait(); if (charged.is_err()) { return core::result::Err(charged.unwrap_err()); } if (!charged.unwrap()) { continue; }
        let remaining: core::time::Duration = exchange.protocol.remaining(); let milliseconds: i32 = 2147483647;
        if (remaining.seconds <= 2147483 as u64) { let rounded: u64 = remaining.seconds*1000+((remaining.nanos as u64)+999999)/1000000; if (rounded < 2147483647 as u64) { milliseconds = rounded as i32; } }
        let waited = exchange.socket.wait_ms(interest.readable,interest.writable,milliseconds);
        if (waited.is_err()) { if (!core::io::is_interrupted(waited.unwrap_err())) { let failure: Failure = exchange.protocol.failure(Cause::Io(waited.unwrap_err())); return core::result::Err(stop(exchange.borrow(),failure)); } }
        else { let observed: std::socket::Ready = waited.unwrap(); ready = Readiness { readable:observed.readable,writable:observed.writable,hangup:observed.hangup,error:observed.error }; }
    }
    return core::result::Err(inactive(exchange.protocol.state.borrow()));
}
