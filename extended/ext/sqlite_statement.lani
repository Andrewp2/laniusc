// Prepared-statement lifecycle. The compiler checks every state/event pair.
// Native result events follow an admitted Step or Column operation.
module ext::sqlite_statement;

pub enum Event {
    Bind,
    ClearBindings,
    // sqlite3_step is about to run; the next event is its result.
    Step,
    StepRow,
    StepDone,
    // a native error, or a column count over the limit
    StepFailed,
    Column,
    // a column conversion ran out of memory
    ColumnFailed,
    Reset,
    Finalize,
}

pub machine Statement on Event -> bool {
    start Ready;

    state Ready {
        Event::Bind -> stay with true,
        Event::ClearBindings -> stay with true,
        Event::Step -> stay with true,
        Event::StepRow -> goto Row with true,
        Event::StepDone -> goto Done with true,
        Event::StepFailed -> goto Failed with true,
        Event::Column -> stay with false,
        Event::ColumnFailed -> stay with false,
        Event::Reset -> stay with true,
        Event::Finalize -> goto Finalized with true,
    }

    state Row {
        Event::Bind -> stay with false,
        Event::ClearBindings -> stay with false,
        Event::Step -> stay with true,
        Event::StepRow -> stay with true,
        Event::StepDone -> goto Done with true,
        Event::StepFailed -> goto Failed with true,
        Event::Column -> stay with true,
        Event::ColumnFailed -> goto Failed with true,
        Event::Reset -> goto Ready with true,
        Event::Finalize -> goto Finalized with true,
    }

    state Done {
        Event::Bind -> stay with false,
        Event::ClearBindings -> stay with false,
        Event::Step -> stay with false,
        Event::StepRow -> stay with false,
        Event::StepDone -> stay with false,
        Event::StepFailed -> stay with false,
        Event::Column -> stay with false,
        Event::ColumnFailed -> stay with false,
        Event::Reset -> goto Ready with true,
        Event::Finalize -> goto Finalized with true,
    }

    state Failed {
        Event::Bind -> stay with false,
        Event::ClearBindings -> stay with false,
        Event::Step -> stay with false,
        Event::StepRow -> stay with false,
        Event::StepDone -> stay with false,
        Event::StepFailed -> stay with false,
        Event::Column -> stay with false,
        Event::ColumnFailed -> stay with false,
        Event::Reset -> goto Ready with true,
        Event::Finalize -> goto Finalized with true,
    }

    final state Finalized {
        Event::Bind -> stay with false,
        Event::ClearBindings -> stay with false,
        Event::Step -> stay with false,
        Event::StepRow -> stay with false,
        Event::StepDone -> stay with false,
        Event::StepFailed -> stay with false,
        Event::Column -> stay with false,
        Event::ColumnFailed -> stay with false,
        Event::Reset -> stay with false,
        Event::Finalize -> stay with true,
    }
}
