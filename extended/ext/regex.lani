    pub fn longest_prefix(&self, text: core::text::Text) -> Result<Option<Match>,Error> { return self.longest_prefix_from(text,0); }
    pub fn find(&self, text: core::text::Text) -> Result<Option<Match>,Error> { return self.find_from(text,0); }
