        current: alloc::vec::new(), next: alloc::vec::new(),
        current_caps: alloc::vec::new(), next_caps: alloc::vec::new(),
        stack: alloc::vec::new(), stack_caps: alloc::vec::new(),
        seen: alloc::vec::new(), temporary: alloc::vec::new(), candidate: alloc::vec::new(),
        states_reserved: states, groups_reserved: groups, bytes_reserved: elements * width,
        active_states: 0, slots: 0, result_groups: 0, matched: false,
        work: 0, max_work: 0, failed: false
