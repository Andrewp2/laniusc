}
pub impl Match {
    pub fn group_count(&self) -> i32 { return self.captures.len() / 2; }
    pub fn span(&self, group: i32) -> Option<Span> {
        if (group < 0 || group >= self.group_count()) { return None(); }
        let caps = self.captures.as_slice();
        if (caps[group * 2] < 0 || caps[group * 2 + 1] < 0) { return None(); }
        return Some(Span { start: caps[group * 2], end: caps[group * 2 + 1] });
    }
    pub fn destroy(&self) { self.captures.destroy(); }
}
pub impl Search {
    pub fn borrow(&self) -> &Search { return self; }
    pub fn span(&self, group: i32) -> Option<Span> { return self.workspace.span(group); }
    pub fn group_count(&self) -> i32 { return self.workspace.group_count(); }
    pub fn work_used(&self) -> i32 { return self.workspace.work_used(); }
    pub fn destroy(&self) { self.done = true; self.workspace.destroy(); }
    pub fn next(&self) -> Result<Option<Span>,Error> {
        // A final empty EOF result remains readable until this next attempt.
        // Releasing it does not execute or charge another VM search.
        if (self.done) { self.workspace.destroy(); return Ok(None()); }
        let result = self.regex.search_with(self.input,self.position,false,self.captures,self.workspace.borrow());
        if (result.is_err()) { let error = result.unwrap_err(); self.destroy(); return Err(error); }
        if (!result.unwrap()) { self.destroy(); return Ok(None()); }
        let span = self.workspace.span(0).unwrap(); self.position = span.end;
        if (span.start == span.end) {
            if (self.position == self.input.text.length) { self.done = true; }
            else { self.position += core::utf8::encoded_len_or(self.input.text.scalar_at_byte(self.position).unwrap(),0) as i32; }
        }
        return Ok(Some(span));
    }
}
pub impl Matches {
    pub fn next(&self) -> Result<Option<Match>,Error> {
        let result = self.search.next();
        if (result.is_err()) { return Err(result.unwrap_err()); }
        if (result.unwrap().is_none()) { return Ok(None()); }
        // Independent capture ownership is the convenience API's only
        // per-result allocation. The canonical Search retains its scratch.
        let count: i32 = self.search.group_count() * 2;
        let captures: alloc::vec::Vec<i32> = alloc::vec::new();
        if (!sized(captures.borrow(),count,-1)) { captures.destroy(); self.destroy(); return Err(Error::AllocationFailed); }
        copy_slots(self.search.workspace.candidate.as_slice(),0,captures.as_slice(),0,count);
        return Ok(Some(Match { captures: captures }));
    }
    pub fn destroy(&self) { self.search.destroy(); }
}
