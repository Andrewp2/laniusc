}
fn copy_slots(source: [i32], source_at: i32, target: [i32], target_at: i32, slots: i32) {
    let i: i32 = 0; while (i < slots) { target[target_at + i] = source[source_at + i]; i += 1; }
}
pub impl Workspace {
