        let temp = self.temporary.as_slice(); let candidate = self.candidate.as_slice(); let i: i32 = 0;
        while (i < self.slots) { temp[i] = -1; candidate[i] = -1; i += 1; }
    }
    fn tick(&self) -> bool { if (self.work >= self.max_work) { self.failed = true; return false; } self.work += 1; return true; }
    fn clear_seen(&self) { let seen = self.seen.as_slice(); let i: i32 = 0; while (i < self.active_states) { seen[i] = 0; i += 1; } }
