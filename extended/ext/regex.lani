// Ordered Thompson/Pike UTF-8 regular expressions; see docs/extended-regex.md.
module ext::regex;
import alloc::vec;
import core::mem;
import core::option;
import core::option::Option;
import core::option::Some;
import core::option::None;
import core::result;
import core::result::Result;
import core::result::Ok;
import core::result::Err;
import core::text;
import core::unicode;
import core::utf8;

pub enum Error { Syntax(i32), Unsupported(i32), Limit(i32), AllocationFailed, Bounds, InvalidUtf8(i32), WorkLimit, WorkspaceTooSmall }
pub struct Options { multiline: bool, dot_matches_newline: bool, max_pattern_bytes: i32, max_states: i32, max_depth: i32, max_captures: i32, max_repeat: i32, max_work: i32 }
pub struct Span { start: i32, end: i32 }
pub struct Match { captures: alloc::vec::Vec<i32> }
// Validated borrowed text. Keep backing alive and unchanged; do not forge fields.
pub struct Input { text: core::text::Text }
// Internal storage is public only because the language has no opaque fields.
// Do not forge/mutate these records. Copies alias a single explicit owner.
// names holds (group, offset, length) triples into name_bytes, a private copy
// of every group name, in group order.
pub struct Regex { code: alloc::vec::Vec<Inst>, terms: alloc::vec::Vec<Term>, entry: i32, groups: i32, config: Options, names: alloc::vec::Vec<i32>, name_bytes: alloc::vec::Vec<u8> }
// Search and Matches each have one active manual owner. Copies cannot fork
// cursor positions or workspace cleanup authority.
pub struct Search { regex: Regex, input: Input, workspace: Workspace, position: i32, captures: bool, done: bool }
pub struct Matches { search: Search }
pub struct Inst { op: i32, x: i32, y: i32, a: i32, b: i32, flag: bool }
pub struct Term { low: u32, high: u32, property: i32, negated: bool }
struct Node { op: i32, left: i32, right: i32, a: i32, b: i32, flag: bool }
struct Parser { text: core::text::Text, position: i32, nodes: alloc::vec::Vec<Node>, terms: alloc::vec::Vec<Term>, config: Options, groups: i32, depth: i32, failed: bool, error: Error, names: alloc::vec::Vec<i32>, name_bytes: alloc::vec::Vec<u8>, behind: i32 }
// Leaf ops: 0 empty, 1 scalar, 2 class, 3 dot, 4 ^, 5 $, 6 \A,
// 7 \z, 8 \b, 9 \B. AST: 10 concat,11 alternate,12 repeat,13 group.
// VM: 10 jump,11 split,12 save,13 accept.
pub fn options() -> Options {
    return Options { multiline: false, dot_matches_newline: false, max_pattern_bytes: 65536, max_states: 4096, max_depth: 64, max_captures: 16, max_repeat: 1000, max_work: 10000000 };
}
fn valid_options(value: Options) -> bool {
    return value.max_pattern_bytes >= 0 && value.max_pattern_bytes <= 65536 && value.max_states >= 4 && value.max_states <= 65536 &&
        value.max_depth >= 1 && value.max_depth <= 256 && value.max_captures >= 0 && value.max_captures <= 128 &&
        value.max_repeat >= 0 && value.max_repeat <= 1000000 && value.max_work > 0;
}
fn validate(text: core::text::Text) -> core::result::Result<core::text::Text, Error> {
    let result: core::result::Result<core::text::Text, core::text::Error> = core::text::from_utf8_range(text.bytes, text.start, text.length);
    return match (result) { core::result::Ok(value) -> core::result::Ok(value), core::result::Err(error) -> match (error) {
        core::text::Error::InvalidUtf8(at) -> core::result::Err(Error::InvalidUtf8(at)), _ -> core::result::Err(Error::Bounds)
    } };
}
pub fn input(text: core::text::Text) -> core::result::Result<Input, Error> {
    let checked = validate(text);
    if (checked.is_err()) { return core::result::Err(checked.unwrap_err()); }
    return core::result::Ok(Input { text: checked.unwrap() });
}
fn literal_node(value: u32) -> Node { return Node { op: 1, left: 0, right: 0, a: value as i32, b: 0, flag: false }; }
fn simple_node(op: i32) -> Node { return Node { op: op, left: 0, right: 0, a: 0, b: 0, flag: false }; }
fn ascii_word(value: u32) -> bool { return (value >= 48 && value <= 57) || (value >= 65 && value <= 90) || (value >= 97 && value <= 122) || value == 95; }
fn hex(value: u32) -> i32 {
    if (value >= 48 && value <= 57) { return (value - 48) as i32; }
    if (value >= 65 && value <= 70) { return (value - 55) as i32; }
    if (value >= 97 && value <= 102) { return (value - 87) as i32; }
    return -1;
}
// Property IDs 1..30 are exact general categories (gc+1), 101..107
// aggregates L M N P S Z C; 201..204 binary properties; 301..303 ASCII.
fn property_name(name: core::text::Text) -> i32 {
    if (name.length == 1) {
        let c: u8 = core::option::unwrap(name.byte_at(0));
        if (c == 76) { return 101; } if (c == 77) { return 102; } if (c == 78) { return 103; }
        if (c == 80) { return 104; } if (c == 83) { return 105; } if (c == 90) { return 106; } if (c == 67) { return 107; }
    }
    // Compare ASCII property identifiers without allocating a string.
    let names: str = "CnLuLlLtLmLoMnMcMeNdNlNoPcPdPsPePiPfPoSmScSkSoZsZlZpCcCfCsCo";
    let name_bytes: [u8] = core::mem::typed_slice_from_raw_parts<u8>(core::mem::string_data_ptr(names), 60);
    let i: i32 = 0;
    if (name.length == 2) {
        while (i < 30) {
            if (core::option::unwrap(name.byte_at(0)) == name_bytes[i * 2] && core::option::unwrap(name.byte_at(1)) == name_bytes[i * 2 + 1]) { return i + 1; }
            i += 1;
        }
    }
    if (name_equal(name, "Alphabetic", 10)) { return 201; }
    if (name_equal(name, "White_Space", 11)) { return 202; }
    if (name_equal(name, "XID_Start", 9)) { return 203; }
    if (name_equal(name, "XID_Continue", 12)) { return 204; }
    return 0;
}
fn name_equal(value: core::text::Text, name: str, count: i32) -> bool {
    if (value.length != count) { return false; }
    let bytes: [u8] = core::mem::typed_slice_from_raw_parts<u8>(core::mem::string_data_ptr(name), count);
    let index: i32 = 0;
    while (index < count) { if (core::option::unwrap(value.byte_at(index)) != bytes[index]) { return false; } index += 1; }
    return true;
}
fn property_matches(property: i32, value: u32) -> bool {
    if (property == 201) { return core::unicode::is_alphabetic(value); }
    if (property == 202) { return core::unicode::is_white_space(value); }
    if (property == 203) { return core::unicode::is_xid_start(value); }
    if (property == 204) { return core::unicode::is_xid_continue(value); }
    if (property == 301) { return value >= 48 && value <= 57; }
    if (property == 302) { return value == 9 || value == 10 || value == 12 || value == 13 || value == 32; }
    if (property == 303) { return ascii_word(value); }
    let gc: i32 = core::unicode::general_category(value) as i32;
    if (property >= 1 && property <= 30) { return gc == property - 1; }
    if (property == 101) { return gc >= 1 && gc <= 5; }
    if (property == 102) { return gc >= 6 && gc <= 8; }
    if (property == 103) { return gc >= 9 && gc <= 11; }
    if (property == 104) { return gc >= 12 && gc <= 18; }
    if (property == 105) { return gc >= 19 && gc <= 22; }
    if (property == 106) { return gc >= 23 && gc <= 25; }
    return gc == 0 || (gc >= 26 && gc <= 29);
}
pub impl Parser {
    fn fail(&self, error: Error) { if (!self.failed) { self.failed = true; self.error = error; } }
    fn peek(&self) -> u32 { return core::option::unwrap_or(self.text.scalar_at_byte(self.position), 4294967295); }
    fn take(&self) -> u32 { let value: u32 = self.peek(); if (value != 4294967295) { self.position += core::utf8::encoded_len_or(value, 0) as i32; } return value; }
    fn add(&self, node: Node) -> i32 {
        if (self.failed) { return 0; }
        if (self.nodes.len() >= self.config.max_states) { self.fail(Error::Limit(self.position)); return 0; }
        let index: i32 = self.nodes.len();
        if (core::result::is_err(self.nodes.try_push(node))) { self.fail(Error::AllocationFailed); }
        return index;
    }
    fn term(&self, term: Term) {
        if (self.terms.len() >= self.config.max_pattern_bytes) { self.fail(Error::Limit(self.position)); return; }
        if (core::result::is_err(self.terms.try_push(term))) { self.fail(Error::AllocationFailed); }
    }
    fn escaped(&self, in_class: bool) -> Node {
        let offset: i32 = self.position - 1;
        let value: u32 = self.take();
        if (value == 4294967295) { self.fail(Error::Syntax(offset)); return simple_node(0); }
        if (value == 100 || value == 68 || value == 115 || value == 83 || value == 119 || value == 87 || value == 112 || value == 80) {
            let property: i32 = 301;
            if (value == 115 || value == 83) { property = 302; }
            if (value == 119 || value == 87) { property = 303; }
            if (value == 112 || value == 80) {
                let start: i32 = self.position;
                let end: i32 = start;
                if (self.peek() == 123) {
                    self.take(); start = self.position;
                    while (self.peek() != 125 && self.peek() != 4294967295) { self.take(); }
                    end = self.position;
                    if (self.take() != 125 || end == start) { self.fail(Error::Syntax(offset)); }
                } else { self.take(); end = self.position; }
                property = property_name(core::result::unwrap(self.text.slice(start, end)));
                if (property == 0) { self.fail(Error::Unsupported(offset)); }
            }
            let index: i32 = self.terms.len();
            self.term(Term { low: 0, high: 0, property: property, negated: value == 68 || value == 83 || value == 87 || value == 80 });
            return Node { op: 2, left: 0, right: 0, a: index, b: index + 1, flag: false };
        }
        if (!in_class) {
            if (value == 65) { return simple_node(6); } if (value == 122) { return simple_node(7); }
            if (value == 98) { return simple_node(8); } if (value == 66) { return simple_node(9); }
        }
        if (value == 110) { return literal_node(10); } if (value == 114) { return literal_node(13); }
        if (value == 116) { return literal_node(9); } if (value == 102) { return literal_node(12); }
        if (value == 118) { return literal_node(11); } if (value == 97) { return literal_node(7); }
        if (value == 120) {
            let scalar: u32 = 0; let count: i32 = 0; let braced: bool = self.peek() == 123;
            if (braced) { self.take(); }
            while ((braced && self.peek() != 125 && self.peek() != 4294967295) || (!braced && count < 2)) {
                let digit: i32 = hex(self.take());
                if (digit < 0 || count >= 6) { self.fail(Error::Syntax(offset)); return simple_node(0); }
                scalar = scalar * 16 + digit as u32; count += 1;
            }
            if ((braced && self.take() != 125) || count == 0 || !core::unicode::is_scalar(scalar)) { self.fail(Error::Syntax(offset)); }
            return literal_node(scalar);
        }
        if (value >= 48 && value <= 57) { self.fail(Error::Unsupported(offset)); return simple_node(0); }
        if ((value >= 65 && value <= 90) || (value >= 97 && value <= 122) || value > 127) { self.fail(Error::Unsupported(offset)); return simple_node(0); }
        return literal_node(value);
    }
    fn class_atom(&self) -> Node {
        if (self.peek() == 92) { self.take(); return self.escaped(true); }
        if (self.peek() == 91) { self.fail(Error::Unsupported(self.position)); }
        return literal_node(self.take());
    }
    fn character_class(&self) -> Node {
        let offset: i32 = self.position - 1; let negative: bool = false;
        if (self.peek() == 94) { self.take(); negative = true; }
        let start: i32 = self.terms.len(); let count: i32 = 0;
        while (self.peek() != 93 && self.peek() != 4294967295 && !self.failed) {
            let atom: Node = self.class_atom();
            if (atom.op == 1) {
                let high: u32 = atom.a as u32;
                if (self.peek() == 45) {
                    self.take();
                    if (self.peek() == 93) { self.term(Term { low: high, high: high, property: 0, negated: false }); high = 45; }
                    else {
                        let last: Node = self.class_atom();
                        if (last.op != 1 || last.a < atom.a) { self.fail(Error::Syntax(self.position)); }
                        high = last.a as u32;
                    }
                }
                if (high == 45 && atom.a != 45) { self.term(Term { low: 45, high: 45, property: 0, negated: false }); }
                else { self.term(Term { low: atom.a as u32, high: high, property: 0, negated: false }); }
            }
            count += 1;
        }
        if (self.take() != 93 || count == 0) { self.fail(Error::Syntax(offset)); }
        return Node { op: 2, left: 0, right: 0, a: start, b: self.terms.len(), flag: negative };
    }
    // Read `name>` after a named-group opener: [A-Za-z_][A-Za-z0-9_]*, unique.
    fn group_name(&self, group: i32) -> bool {
        let start: i32 = self.position; let value: u32 = self.take();
        if (!((value >= 65 && value <= 90) || (value >= 97 && value <= 122) || value == 95)) { self.fail(Error::Syntax(start)); return false; }
        while (ascii_word(self.peek())) { self.take(); }
        let end: i32 = self.position;
        if (self.take() != 62) { self.fail(Error::Syntax(self.position - 1)); return false; }
        let length: i32 = end - start; let names: [i32] = self.names.as_slice(); let bytes: [u8] = self.name_bytes.as_slice(); let i: i32 = 0;
        while (i < self.names.len()) {
            if (names[i + 2] == length) {
                let same: bool = true; let j: i32 = 0;
                while (same && j < length) { if (bytes[names[i + 1] + j] != self.text.bytes[self.text.start + start + j]) { same = false; } j += 1; }
                if (same) { self.fail(Error::Syntax(start)); return false; }
            }
            i += 3;
        }
        let offset: i32 = self.name_bytes.len(); let j: i32 = 0;
        if (self.names.try_push(group).is_err() || self.names.try_push(offset).is_err() || self.names.try_push(length).is_err()) { self.fail(Error::AllocationFailed); return false; }
        while (j < length) { if (self.name_bytes.try_push(self.text.bytes[self.text.start + start + j]).is_err()) { self.fail(Error::AllocationFailed); return false; } j += 1; }
        return true;
    }
    fn atom(&self) -> i32 {
        let at: i32 = self.position; let value: u32 = self.take();
        if (value == 40) {
            self.depth += 1;
            if (self.depth > self.config.max_depth) { self.fail(Error::Limit(at)); return 0; }
            let group: i32 = 0;
            if (self.peek() == 63) {
                self.take();
                let kind: u32 = self.take();
                // (?P<name>x) and (?<name>x) are named captures; (?<=x) and (?<!x) are
                // fixed-width lookbehind.
                let named: bool = false;
                if (kind == 80 && self.peek() == 60) { self.take(); named = true; }
                if (kind == 60 && (self.peek() == 61 || self.peek() == 33)) { return self.lookbehind(at); }
                if (kind == 60) { named = true; }
                if (named) {
                    if (self.behind > 0) { self.fail(Error::Unsupported(at)); return 0; }
                    if (self.groups >= self.config.max_captures) { self.fail(Error::Limit(at)); return 0; }
                    self.groups += 1; group = self.groups;
                    if (!self.group_name(group)) { return 0; }
                } else { if (kind != 58) { self.fail(Error::Unsupported(at)); return 0; } }
            } else {
                if (self.behind > 0) { self.fail(Error::Unsupported(at)); return 0; }
                if (self.groups >= self.config.max_captures) { self.fail(Error::Limit(at)); return 0; }
                self.groups += 1; group = self.groups;
            }
            let inside: i32 = self.expression();
            if (self.take() != 41) { self.fail(Error::Syntax(at)); }
            self.depth -= 1;
            if (group == 0) { return inside; }
            return self.add(Node { op: 13, left: inside, right: 0, a: group, b: 0, flag: false });
        }
        if (value == 91) { return self.add(self.character_class()); }
        if (value == 92) { return self.add(self.escaped(false)); }
        if (value == 46) { return self.add(simple_node(3)); }
        if (value == 94) { return self.add(simple_node(4)); }
        if (value == 36) { return self.add(simple_node(5)); }
        if (value == 42 || value == 43 || value == 63 || value == 123 || value == 125 || value == 93 || value == 4294967295) { self.fail(Error::Syntax(at)); return 0; }
        return self.add(literal_node(value));
    }
    // After `(?<`: `=x)` or `!x)`. The body may not capture, and every path
    // through it must consume the same number of scalars (Python's rule).
    // depth was already incremented by atom.
    fn lookbehind(&self, at: i32) -> i32 {
        let negated: bool = self.take() == 33; let first: i32 = self.nodes.len();
        self.behind += 1; let inside: i32 = self.expression(); self.behind -= 1;
        if (self.take() != 41) { self.fail(Error::Syntax(at)); }
        self.depth -= 1;
        if (self.failed) { return 0; }
        let width: i32 = self.fixed_width(first, inside);
        if (width == -2) { self.fail(Error::AllocationFailed); return 0; }
        if (width < 0) { self.fail(Error::Syntax(at)); return 0; }
        return self.add(Node { op: 14, left: inside, right: 0, a: width, b: 0, flag: negated });
    }
    // Width of nodes[root] in scalars when every path has the same width;
    // -1 when it varies or is unbounded, -2 on allocation failure. Children
    // precede parents, and every node of the body is in [first, root].
    fn fixed_width(&self, first: i32, root: i32) -> i32 {
        let unbounded: i64 = 1000000000; let count: i32 = root - first + 1;
        let widths: alloc::vec::Vec<i64> = alloc::vec::new();
        if (widths.try_resize(count * 2, 0).is_err()) { widths.destroy(); return -2; }
        let w: [i64] = widths.as_slice(); let nodes: [Node] = self.nodes.as_slice(); let i: i32 = 0;
        while (i < count) {
            let n: Node = nodes[first + i]; let lo: i64 = 0; let hi: i64 = 0;
            if (n.op >= 1 && n.op <= 3) { lo = 1; hi = 1; }
            if (n.op == 10 || n.op == 11) {
                let l: i32 = (n.left - first) * 2; let r: i32 = (n.right - first) * 2;
                if (n.op == 10) { lo = w[l] + w[r]; hi = w[l + 1] + w[r + 1]; }
                else { lo = w[l]; if (w[r] < lo) { lo = w[r]; } hi = w[l + 1]; if (w[r + 1] > hi) { hi = w[r + 1]; } }
            }
            if (n.op == 12) {
                let l: i32 = (n.left - first) * 2;
                lo = w[l] * n.a as i64;
                if (n.b < 0) { if (w[l + 1] == 0) { hi = 0; } else { hi = unbounded; } } else { hi = w[l + 1] * n.b as i64; }
            }
            if (lo > unbounded) { lo = unbounded; } if (hi > unbounded) { hi = unbounded; }
            w[i * 2] = lo; w[i * 2 + 1] = hi; i += 1;
        }
        let lo: i64 = w[(count - 1) * 2]; let hi: i64 = w[(count - 1) * 2 + 1]; widths.destroy();
        if (lo != hi || hi >= unbounded) { return -1; }
        return hi as i32;
    }
    fn number(&self) -> i32 {
        let count: i32 = 0; let digits: i32 = 0;
        while (self.peek() >= 48 && self.peek() <= 57 && !self.failed) {
            let digit: i32 = self.take() as i32 - 48;
            if (count > (self.config.max_repeat - digit) / 10 || digit > self.config.max_repeat) { self.fail(Error::Limit(self.position - 1)); return 0; }
            count = count * 10 + digit; digits += 1;
        }
        if (digits == 0) { self.fail(Error::Syntax(self.position)); }
        return count;
    }
    fn piece(&self) -> i32 {
        let node: i32 = self.atom(); let value: u32 = self.peek();
        if (self.failed || (value != 42 && value != 43 && value != 63 && value != 123)) { return node; }
        let at: i32 = self.position; self.take(); let min: i32 = 0; let max: i32 = -1;
        if (value == 43) { min = 1; } if (value == 63) { max = 1; }
        if (value == 123) {
            min = self.number(); max = min;
            if (self.peek() == 44) { self.take(); max = -1; if (self.peek() != 125) { max = self.number(); } }
            if (self.take() != 125 || (max >= 0 && max < min)) { self.fail(Error::Syntax(at)); }
        }
        let lazy: bool = false;
        if (self.peek() == 63) { self.take(); lazy = true; }
        if (self.peek() == 43) { self.fail(Error::Unsupported(self.position)); }
        if (self.peek() == 42 || self.peek() == 63 || self.peek() == 123) { self.fail(Error::Syntax(self.position)); }
        return self.add(Node { op: 12, left: node, right: 0, a: min, b: max, flag: lazy });
    }
    fn concatenation(&self) -> i32 {
        let node: i32 = -1;
        while (self.peek() != 41 && self.peek() != 124 && self.peek() != 4294967295 && !self.failed) {
            let right: i32 = self.piece();
            if (node < 0) { node = right; } else { node = self.add(Node { op: 10, left: node, right: right, a: 0, b: 0, flag: false }); }
        }
        if (node < 0) { node = self.add(simple_node(0)); }
        return node;
    }
    fn expression(&self) -> i32 {
        let node: i32 = self.concatenation();
        while (self.peek() == 124 && !self.failed) {
            self.take(); let right: i32 = self.concatenation();
            node = self.add(Node { op: 11, left: node, right: right, a: 0, b: 0, flag: false });
        }
        return node;
    }
}
// Explicit compilation frames avoid recursion proportional to concatenation or
// repeat expansion. Only parser group nesting uses the bounded native stack.
struct Frame { node: i32, next: i32, phase: i32, saved: i32, remaining: i32 }
struct Builder { nodes: alloc::vec::Vec<Node>, code: alloc::vec::Vec<Inst>, frames: alloc::vec::Vec<Frame>, nullable: alloc::vec::Vec<i32>, limit: i32, failed: bool, error: Error }
fn instruction(op: i32, x: i32, y: i32, a: i32, b: i32, flag: bool) -> Inst { return Inst { op: op, x: x, y: y, a: a, b: b, flag: flag }; }
fn frame(node: i32, next: i32) -> Frame { return Frame { node: node, next: next, phase: 0, saved: 0, remaining: 0 }; }
pub impl Builder {
    fn emit(&self, inst: Inst) -> i32 {
        if (self.failed) { return 0; }
        if (self.code.len() >= self.limit) { self.failed = true; self.error = Error::Limit(0); return 0; }
        let index: i32 = self.code.len();
        if (core::result::is_err(self.code.try_push(inst))) { self.failed = true; self.error = Error::AllocationFailed; }
        return index;
    }
    fn push(&self, value: Frame) {
        if (self.frames.len() >= self.limit) { self.failed = true; self.error = Error::Limit(0); return; }
        if (core::result::is_err(self.frames.try_push(value))) { self.failed = true; self.error = Error::AllocationFailed; }
    }
    fn build(&self, root: i32, next: i32) -> i32 {
        self.push(frame(root, next)); let result: i32 = next; let steps: i32 = 0;
        while (!self.frames.is_empty() && !self.failed) {
            if (steps >= self.limit * 32) { self.failed = true; self.error = Error::Limit(0); break; }
            steps += 1;
            let f: Frame = core::option::unwrap(self.frames.pop());
            let nodes: [Node] = self.nodes.as_slice(); let n: Node = nodes[f.node];
            if (n.op < 10) {
                result = f.next;
                if (n.op != 0) { result = self.emit(instruction(n.op, f.next, 0, n.a, n.b, n.flag)); }
            } else {
                if (n.op == 10) {
                    if (f.phase == 0) { f.phase = 1; self.push(f); self.push(frame(n.right, f.next)); }
