    pub fn owned_bytes(&self) -> u64 { return self.bytes_reserved; }
    pub fn group_count(&self) -> i32 { if (!self.matched) { return 0; } return self.result_groups; }
    // Last attempted search's existing VM counter; not total CPU work.
