    let parser: Parser = Parser { text: core::result::unwrap(checked), position: 0, nodes: nodes, terms: terms, config: config, groups: 0, depth: 0, failed: false, error: Error::Bounds, names: alloc::vec::new(), name_bytes: alloc::vec::new(), behind: 0 };
    let root: i32 = parser.expression();
    if (parser.position != pattern.length) { parser.fail(Error::Syntax(parser.position)); }
    if (parser.failed) { parser.nodes.destroy(); parser.terms.destroy(); parser.names.destroy(); parser.name_bytes.destroy(); return core::result::Err(parser.error); }
    let code: alloc::vec::Vec<Inst> = alloc::vec::new(); let frames: alloc::vec::Vec<Frame> = alloc::vec::new();
    // Children precede parents in the flat AST, allowing one bounded pass.
    let nullable: alloc::vec::Vec<i32> = alloc::vec::new();
    let all_nodes: [Node] = parser.nodes.as_slice(); let ni: i32 = 0; let allocation_failed: bool = false;
    while (ni < parser.nodes.len() && !allocation_failed) {
        let n: Node = all_nodes[ni]; let prior: [i32] = nullable.as_slice();
        let yes: bool = n.op == 0 || (n.op >= 4 && n.op <= 9) || n.op == 14;
        if (n.op == 10) { yes = prior[n.left] != 0 && prior[n.right] != 0; }
        if (n.op == 11) { yes = prior[n.left] != 0 || prior[n.right] != 0; }
        if (n.op == 12) { yes = n.a == 0 || prior[n.left] != 0; }
        if (n.op == 13) { yes = prior[n.left] != 0; }
        let bit: i32 = 0; if (yes) { bit = 1; }
        if (core::result::is_err(nullable.try_push(bit))) { allocation_failed = true; }
        ni += 1;
    }
    if (allocation_failed) { nullable.destroy(); parser.nodes.destroy(); parser.terms.destroy(); parser.names.destroy(); parser.name_bytes.destroy(); return core::result::Err(Error::AllocationFailed); }
    let builder: Builder = Builder { nodes: parser.nodes, code: code, frames: frames, nullable: nullable, limit: config.max_states, failed: false, error: Error::Bounds };
    let accept: i32 = builder.emit(instruction(13, 0, 0, 0, 0, false));
    let finish: i32 = builder.emit(instruction(12, accept, 0, 1, 0, false));
    let entry: i32 = builder.build(root, finish);
    entry = builder.emit(instruction(12, entry, 0, 0, 0, false));
    builder.frames.destroy(); builder.nullable.destroy(); parser.nodes.destroy();
    if (builder.failed) { builder.code.destroy(); parser.terms.destroy(); parser.names.destroy(); parser.name_bytes.destroy(); return core::result::Err(builder.error); }
    return core::result::Ok(Regex { code: builder.code, terms: parser.terms, entry: entry, groups: parser.groups + 1, config: config, names: parser.names, name_bytes: parser.name_bytes });
}
// Fixed-capacity storage for one active search at a time. Public fields are
// internal descriptors, not a forgeable or stable storage format. Capacity is
// independent of a particular program/input and never grows during search.
pub struct Workspace {
    current: alloc::vec::Vec<i32>, next: alloc::vec::Vec<i32>,
    current_caps: alloc::vec::Vec<i32>, next_caps: alloc::vec::Vec<i32>,
    stack: alloc::vec::Vec<i32>, stack_caps: alloc::vec::Vec<i32>,
    seen: alloc::vec::Vec<i32>, temporary: alloc::vec::Vec<i32>, candidate: alloc::vec::Vec<i32>,
    states_reserved: i32, groups_reserved: i32, bytes_reserved: u64,
    active_states: i32, slots: i32, result_groups: i32, matched: bool,
    work: i32, max_work: i32, failed: bool
}
fn sized(value: &alloc::vec::Vec<i32>, count: i32, fill: i32) -> bool { return value.try_resize(count,fill).is_ok(); }
// Groups include group zero. Reserve exactly the requested nine Vec owners;
// invalid dimensions/byte arithmetic fail before the first allocation.
pub fn workspace(states: i32, groups: i32) -> Result<Workspace,Error> {
    if (states < 1 || states > 65536 || groups < 1 || groups > 129) { return Err(Error::Limit(0)); }
    if (groups > 2147483647 / 2) { return Err(Error::Limit(0)); }
    let slots: i32 = groups * 2;
    if (states > 2147483647 / slots) { return Err(Error::Limit(0)); }
    let matrix: i32 = states * slots;
    let elements: u64 = 4 * (states as u64) + 3 * (matrix as u64) + 2 * (slots as u64);
    let width: u64 = core::mem::size_of<i32>() as u64;
    if (width > 0 && (elements > 18446744073709551615 / width || (matrix as u64) > 2147483647 / width)) { return Err(Error::Limit(0)); }
