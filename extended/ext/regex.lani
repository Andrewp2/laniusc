    pub fn longest_prefix_in(&self, input: Input, start: i32) -> Result<Option<Match>,Error> { return self.owned_search(input,start,true); }
    pub fn longest_prefix_from(&self, text: core::text::Text, start: i32) -> Result<Option<Match>,Error> {
        let checked = input(text);
        if (checked.is_err()) { return Err(checked.unwrap_err()); }
        return self.longest_prefix_in(checked.unwrap(),start);
