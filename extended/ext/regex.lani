fn previous_scalar(text: core::text::Text, position: i32) -> u32 {
    if (position <= 0) { return 4294967295; }
    let at: i32 = position - 1;
    while (!text.is_char_boundary(at)) { at -= 1; }
    return core::option::unwrap(text.scalar_at_byte(at));
}
fn assertion(op: i32, text: core::text::Text, position: i32, multiline: bool) -> bool {
    if (op == 6) { return position == 0; } if (op == 7) { return position == text.length; }
    if (op == 4) { return position == 0 || (multiline && previous_scalar(text, position) == 10); }
    if (op == 5) { return position == text.length || (multiline && core::option::unwrap_or(text.scalar_at_byte(position), 4294967295) == 10); }
    let left: bool = ascii_word(previous_scalar(text, position));
    let right: bool = ascii_word(core::option::unwrap_or(text.scalar_at_byte(position), 4294967295));
    if (op == 8) { return left != right; }
    return left == right;
}
