    pub fn search_work_limit(&self) -> i32 { return self.config.max_work; }
    pub fn destroy(&self) { self.code.destroy(); self.terms.destroy(); }
    // Expand epsilon instructions in DFS priority order, retaining only the
    // first thread at each PC. Pending branches use explicit bounded storage.
    fn closure(&self, scratch: &Workspace, pc: i32, caps: [i32], caps_at: i32, output: [i32], output_caps: [i32], count: i32, text: core::text::Text, position: i32) -> i32 {
        let code: [Inst] = self.code.as_slice(); let seen: [i32] = scratch.seen.as_slice();
        let stack: [i32] = scratch.stack.as_slice(); let stack_caps: [i32] = scratch.stack_caps.as_slice(); let temp: [i32] = scratch.temporary.as_slice();
        copy_slots(caps, caps_at, temp, 0, scratch.slots);
        let pending: i32 = 0; let cursor: i32 = pc; let total: i32 = count;
        while (!scratch.failed) {
            if (seen[cursor] == 0) {
                seen[cursor] = 1;
                if (!scratch.tick()) { break; }
                let inst: Inst = code[cursor];
                if (inst.op == 10) { cursor = inst.x; continue; }
                if (inst.op == 11) {
                    stack[pending] = inst.y; copy_slots(temp, 0, stack_caps, pending * scratch.slots, scratch.slots); pending += 1;
                    cursor = inst.x; continue;
