}
// Keep the last dict_size bytes before pos; rebase window, heads and chains.
fn slide(e: &Encoder) {
    let shift: i32 = e.pos-e.dict_size; if (shift <= 0) { return; }
    let w: core::slice::View<u8> = e.window; let count: i32 = e.fill-shift; let index: i32 = 0;
    while (index < count) { w.values[w.start+index] = w.values[w.start+shift+index]; index += 1; }
    // Positions never hashed (skipped by long rep matches) are dropped too.
    if (e.hashed < shift) { e.hashed = shift; }
    let c: core::slice::View<i32> = e.chain; index = 0;
    while (index < e.hashed-shift) { let link: i32 = c.values[c.start+shift+index]; if (link < shift) { link = -1; } else { link -= shift; } c.values[c.start+index] = link; index += 1; }
    let h: core::slice::View<i32> = e.heads; index = 0;
    while (index < HEADS) { let link: i32 = h.values[h.start+index]; if (link < shift) { link = -1; } else { link -= shift; } h.values[h.start+index] = link; index += 1; }
    e.fill = count; e.pos -= shift; e.hashed -= shift; e.base += shift as u64;
}
pub impl Encoder {
    pub fn borrow(&self) -> &Encoder { return self; }
    pub fn total_read(&self) -> u64 { return self.read_total; }
    pub fn total_written(&self) -> u64 { return self.written_total; }
    pub fn is_done(&self) -> bool { return self.ended && self.stage_pos == self.stage_len; }
    // Consume input and produce xz output; final_input says no input follows
    // this call's span. Status::Done once the footer has been written.
    pub fn step(&self, input: core::slice::View<u8>, output: core::slice::View<u8>, final_input: bool) -> core::result::Result<Step,Error> {
        if (!valid(input) || !valid(output)) { return core::result::Err(Error::Bounds); }
        if (self.failed) { return core::result::Err(Error::Failed); }
        let ip: i32 = 0; let op: i32 = 0;
        while (true) {
            if (self.stage_pos < self.stage_len) {
                let count: i32 = self.stage_len-self.stage_pos; if (count > output.length-op) { count = output.length-op; }
                let index: i32 = 0; while (index < count) { put(output,op+index,byte(self.stage,self.stage_pos+index)); index += 1; }
                op += count; self.stage_pos += count; self.written_total += count as u64;
                if (self.stage_pos < self.stage_len) { return done(ip,op,Status::NeedOutput); }
                continue;
            }
            if (self.ended) { return done(ip,op,Status::Done); }
            if (!self.started) { self.stage_len = stream_start(self.stage,self.dict_code); self.stage_pos = 0; self.started = true; continue; }
            if (ip < input.length && self.fill < self.window.length) {
                let count: i32 = input.length-ip; if (count > self.window.length-self.fill) { count = self.window.length-self.fill; }
                let w: core::slice::View<u8> = self.window; let index: i32 = 0;
                while (index < count) { w.values[w.start+self.fill+index] = input.values[input.start+ip+index]; index += 1; }
                self.crc64 = crc64_update(table64(self.probs),self.crc64,input,ip,ip+count);
                ip += count; self.fill += count; self.unpacked += count as u64; self.read_total += count as u64;
            }
            let last: bool = final_input && ip == input.length;
            let full: bool = self.fill == self.window.length;
            if (self.pos < self.fill && ((full && self.fill-self.pos > MAX_LEN) || last)) { encode_chunk(self,last); continue; }
            if (full && !last) { slide(self); continue; }
            if (last && self.pos == self.fill) { self.stage_len = stream_end(self.stage,self.packed,self.unpacked,self.crc64); self.stage_pos = 0; self.ended = true; continue; }
            return done(ip,op,Status::NeedInput);
        } return done(ip,op,Status::NeedInput);
    }
}
