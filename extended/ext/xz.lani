fn rep_value(e: &Encoder, which: i32) -> i32 { if (which == 0) { return e.rep0; } if (which == 1) { return e.rep1; } if (which == 2) { return e.rep2; } return e.rep3; }
fn encode_symbol(e: &Encoder) {
    let limit: i32 = e.fill-e.pos; if (limit > MAX_LEN) { limit = MAX_LEN; }
    let seen: u64 = e.base+(e.pos as u64);
    let rep_len: i32 = 0; let rep_which: i32 = 0; let which: i32 = 0;
    if (limit >= 2) {
        while (which < 4) {
            let r: i32 = rep_value(e,which);
            if ((r as u64) < seen && e.window.values[e.window.start+e.pos-r-1] == e.window.values[e.window.start+e.pos] && e.window.values[e.window.start+e.pos-r] == e.window.values[e.window.start+e.pos+1]) {
                let length: i32 = match_len(e,e.pos-r-1,e.pos,limit);
                if (length > rep_len) { rep_len = length; rep_which = which; }
            }
            which += 1;
        }
    }
    if (rep_len >= 2 && rep_len >= e.nice) { erep(e,rep_which,rep_len); return; }
    find(e,e.pos,limit); let main_len: i32 = e.found_len; let main_dist: i32 = e.found_dist;
    if (rep_len >= 2 && (rep_len+1 >= main_len || (rep_len+2 >= main_len && main_dist >= 512) || (rep_len+3 >= main_len && main_dist >= 32768))) { erep(e,rep_which,rep_len); return; }
    if (main_len >= 3) {
        if (e.lazy && main_len < e.nice && limit > main_len) {
            find(e,e.pos+1,limit-1);
            if (e.found_len > main_len+1 || (e.found_len == main_len+1 && e.found_dist <= main_dist*4) || (e.found_len == main_len && e.found_dist < main_dist/128)) {
