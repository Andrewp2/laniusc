        e.range = e.range >> 1; if (((value >> index) & 1) != 0) { e.low += e.range as u64; }
        while (e.range < 16777216) { e.range = e.range << 8; shift_low(e); }
        index -= 1;
    }
}
fn elength(e: &Encoder, base: i32, length: i32, pos_state: i32) {
    let l: i32 = length-2;
    if (l < 8) { ebit(e,base,0); etree(e,base+2+(pos_state << 3),3,l); return; }
    ebit(e,base,1);
    if (l < 16) { ebit(e,base+1,0); etree(e,base+130+(pos_state << 3),3,l-8); return; }
    ebit(e,base+1,1); etree(e,base+258,8,l-16);
}
fn edistance(e: &Encoder, distance: i32, length: i32) {
    let state: i32 = length-2; if (state > 3) { state = 3; }
    let slot: i32 = distance;
    if (distance >= 4) { let top: i32 = 31; while (((distance >> top) & 1) == 0) { top -= 1; } slot = (top << 1) | ((distance >> (top-1)) & 1); }
    etree(e,POS_SLOT+(state << 6),6,slot);
    if (slot < 4) { return; }
    let bits: i32 = (slot >> 1)-1; let base: i32 = (2 | (slot & 1)) << bits; let reduced: i32 = distance-base;
    if (slot < 14) { ereverse(e,SPEC_POS+base-slot-1,bits,reduced); return; }
    edirect(e,reduced >> 4,bits-4); ereverse(e,ALIGN,4,reduced & 15);
}
fn pos_state(e: &Encoder) -> i32 { return ((e.base+(e.pos as u64)) & 3) as i32; }
fn eliteral(e: &Encoder) {
    let ps: i32 = pos_state(e); ebit(e,IS_MATCH+(e.state << 4)+ps,0);
    let previous: i32 = 0; if (e.base+(e.pos as u64) > 0) { previous = ewin(e,e.pos-1); }
    let base: i32 = LITERAL+768*(previous >> 5); let value: i32 = ewin(e,e.pos); let symbol: i32 = 1; let index: i32 = 7;
    if (e.state >= 7) {
        let matched: i32 = ewin(e,e.pos-e.rep0-1); let same: bool = true;
        while (index >= 0) {
            let b: i32 = (value >> index) & 1;
            if (same) { let m: i32 = (matched >> index) & 1; ebit(e,base+((1+m) << 8)+symbol,b); same = m == b; } else { ebit(e,base+symbol,b); }
            symbol = (symbol << 1) | b; index -= 1;
        }
    } else {
        // Plain literal: the eight bit codings inlined over locals.
        let probs: core::slice::View<i32> = e.probs; let range: u32 = e.range; let low: u64 = e.low;
        while (index >= 0) {
            let b: i32 = (value >> index) & 1; let slot: i32 = probs.start+base+symbol; let p: u32 = probs.values[slot] as u32; let bound: u32 = (range >> 11) * p;
            if (b == 0) { range = bound; probs.values[slot] = (p+((2048-p) >> 5)) as i32; } else { low += bound as u64; range = range-bound; probs.values[slot] = (p-(p >> 5)) as i32; }
            if (range < 16777216) { e.low = low; range = range << 8; shift_low(e); low = e.low; }
            symbol = (symbol << 1) | b; index -= 1;
        }
        e.range = range; e.low = low;
    }
    if (e.state < 4) { e.state = 0; } else { if (e.state < 10) { e.state -= 3; } else { e.state -= 6; } }
    e.pos += 1;
}
fn ematch(e: &Encoder, length: i32, distance: i32) {
    let ps: i32 = pos_state(e); ebit(e,IS_MATCH+(e.state << 4)+ps,1); ebit(e,IS_REP+e.state,0);
    elength(e,LEN_CODER,length,ps); edistance(e,distance,length);
    e.rep3 = e.rep2; e.rep2 = e.rep1; e.rep1 = e.rep0; e.rep0 = distance;
    if (e.state < 7) { e.state = 7; } else { e.state = 10; }
    e.pos += length;
}
fn erep(e: &Encoder, which: i32, length: i32) {
    let ps: i32 = pos_state(e); ebit(e,IS_MATCH+(e.state << 4)+ps,1); ebit(e,IS_REP+e.state,1);
    if (which == 0) {
        ebit(e,IS_REP_G0+e.state,0);
        if (length == 1) { ebit(e,IS_REP0_LONG+(e.state << 4)+ps,0); if (e.state < 7) { e.state = 9; } else { e.state = 11; } e.pos += 1; return; }
        ebit(e,IS_REP0_LONG+(e.state << 4)+ps,1);
    } else {
        ebit(e,IS_REP_G0+e.state,1); let chosen: i32 = e.rep1;
        if (which == 1) { ebit(e,IS_REP_G1+e.state,0); }
        else {
            ebit(e,IS_REP_G1+e.state,1);
            if (which == 2) { ebit(e,IS_REP_G2+e.state,0); chosen = e.rep2; } else { ebit(e,IS_REP_G2+e.state,1); chosen = e.rep3; e.rep3 = e.rep2; }
            e.rep2 = e.rep1;
        }
        e.rep1 = e.rep0; e.rep0 = chosen;
    }
    elength(e,REP_LEN_CODER,length,ps);
    if (e.state < 7) { e.state = 8; } else { e.state = 11; }
    e.pos += length;
}
fn hash(e: &Encoder, at: i32) -> i32 {
    return (e.probs.values[e.probs.start+TABLE32+ewin(e,at)] ^ ewin(e,at+1) ^ (ewin(e,at+2) << 8)) & 65535;
}
fn insert_upto(e: &Encoder, limit: i32) {
    let at: i32 = e.hashed; let end: i32 = limit; if (end > e.fill-2) { end = e.fill-2; }
    if (at >= end) { return; }
    let w: core::slice::View<u8> = e.window; let t: core::slice::View<i32> = e.probs; let heads: core::slice::View<i32> = e.heads; let chain: core::slice::View<i32> = e.chain;
    while (at < end) {
        let h: i32 = (t.values[t.start+TABLE32+(w.values[w.start+at] as i32)] ^ (w.values[w.start+at+1] as i32) ^ ((w.values[w.start+at+2] as i32) << 8)) & 65535;
        chain.values[chain.start+at] = heads.values[heads.start+h]; heads.values[heads.start+h] = at; at += 1;
    }
    e.hashed = at;
}
fn match_len(e: &Encoder, older: i32, at: i32, limit: i32) -> i32 {
    let w: core::slice::View<u8> = e.window; let length: i32 = 0;
    while (length < limit && w.values[w.start+older+length] == w.values[w.start+at+length]) { length += 1; }
    return length;
}
// Longest hash-chain match at `at` within `limit` bytes: e.found_len/found_dist.
fn find(e: &Encoder, at: i32, limit: i32) {
    e.found_len = 0; e.found_dist = 0; insert_upto(e,at);
    if (limit < 3 || at+2 >= e.fill) { return; }
    let w: core::slice::View<u8> = e.window; let oldest: i32 = at-e.dict_size;
    let candidate: i32 = e.heads.values[e.heads.start+hash(e,at)]; let count: i32 = 0; let best: i32 = 2;
    while (count < e.depth && candidate >= 0 && candidate >= oldest) {
        if (w.values[w.start+candidate+best] == w.values[w.start+at+best] && w.values[w.start+candidate] == w.values[w.start+at]) {
            let length: i32 = match_len(e,candidate,at,limit);
            if (length > best || (length == best && e.found_len == 0)) {
                best = length; e.found_len = length; e.found_dist = at-candidate-1;
                if (length >= e.nice || length >= limit) { break; }
            }
        }
        candidate = e.chain.values[e.chain.start+candidate]; count += 1;
    }
    if (e.found_len < 3 || (e.found_len == 3 && e.found_dist >= 4096)) { e.found_len = 0; }
