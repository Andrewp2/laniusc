fn reset_encoder_state(e: &Encoder) {
    let index: i32 = 0; let count: i32 = LITERAL+(768 << 3);
    while (index < count) { e.probs.values[e.probs.start+index] = 1024; index += 1; }
    e.state = 0; e.rep0 = 0; e.rep1 = 0; e.rep2 = 0; e.rep3 = 0;
}
// Encode one LZMA2 chunk (or its stored fallback) into the stage.
fn encode_chunk(e: &Encoder, last: bool) {
    let limit: i32 = e.fill; if (!last) { limit = e.fill-MAX_LEN; }
    let control: i32 = 128; let header: i32 = 5;
    if (e.first) { control = 224; header = 6; } else { if (e.state_reset) { control = 160; if (e.props_needed) { control = 192; header = 6; } } }
    if (control >= 160) { reset_encoder_state(e); }
    e.low = 0; e.range = ALL32; e.cache = 0; e.cache_size = 1; e.out = 6;
    let start: i32 = e.pos;
    while (e.pos < limit && e.pos-start < CHUNK_UNPACKED-MAX_LEN && (e.out-6)+e.cache_size+4+64 <= CHUNK_PACKED) { encode_symbol(e); }
    let flush: i32 = 0; while (flush < 5) { shift_low(e); flush += 1; }
    let packed: i32 = e.out-6; let unpacked: i32 = e.pos-start; let s: core::slice::View<u8> = e.stage;
    if (packed > unpacked) {
        let stored: i32 = 2; if (e.first) { stored = 1; e.props_needed = true; }
        put(s,0,stored as u8); put(s,1,(((unpacked-1) >> 8) & 255) as u8); put(s,2,((unpacked-1) & 255) as u8);
        let index: i32 = 0; while (index < unpacked) { put(s,3+index,e.window.values[e.window.start+start+index]); index += 1; }
        e.stage_pos = 0; e.stage_len = 3+unpacked; e.state_reset = true;
    } else {
        let at: i32 = 6-header; let size: i32 = unpacked-1;
        put(s,at,(control | (size >> 16)) as u8); put(s,at+1,((size >> 8) & 255) as u8); put(s,at+2,(size & 255) as u8);
        put(s,at+3,(((packed-1) >> 8) & 255) as u8); put(s,at+4,((packed-1) & 255) as u8);
        if (header == 6) { put(s,at+5,93); }
