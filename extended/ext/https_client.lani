        let result: core::result::Result<ext::openssl_tls::Session,ext::openssl_tls::Error> = context.session(exchange.socket.raw_handle().unwrap(),identity);
        if (result.is_err()) { return core::result::Err(Cause::Tls(result.unwrap_err())); }
        exchange.session = core::option::Some(result.unwrap()); release_context(exchange); exchange.identity.destroy();
        exchange.phase = Phase::Handshake; let after = checked(exchange); if (after.is_err()) { return core::result::Err(after.unwrap_err()); } return core::result::Ok(core::option::None());
    }
    if (match(exchange.phase) { Phase::Handshake -> true, _ -> false }) {
        exchange.stage = Stage::Handshake;
        if (exchange.tls.calls == exchange.options.tls_calls) { return core::result::Err(Cause::TlsLimit); }
        if (exchange.wait_blocked) { return core::result::Ok(core::option::None()); }
        let before = before_tls(exchange,ext::http_client::Stage::Connect,1); if (before.is_err()) { return core::result::Err(before.unwrap_err()); }
        let session: ext::openssl_tls::Session = take_session(exchange);
        let result: core::result::Result<ext::openssl_tls::Handshake,ext::openssl_tls::Error> = session.handshake(); exchange.session = core::option::Some(session);
        if (result.is_err()) { return core::result::Err(Cause::Tls(result.unwrap_err())); }
        let done: bool = match(result.unwrap()) { ext::openssl_tls::Handshake::Complete -> true, _ -> false };
        if (done) { exchange.version = session.negotiated_version(); exchange.phase = Phase::Protocol; exchange.wait_need = ext::openssl_tls::Need::None; exchange.wait_blocked = false; }
        else { exchange.wait_need = ext::openssl_tls::Need::Write; if (match(result.unwrap()) { ext::openssl_tls::Handshake::WantRead -> true, _ -> false }) { exchange.wait_need = ext::openssl_tls::Need::Read; } exchange.wait_blocked = true; }
        let after = checked(exchange); if (after.is_err()) { return core::result::Err(after.unwrap_err()); } return core::result::Ok(core::option::None());
    }
    if (match(exchange.phase) { Phase::Notify -> true, _ -> false }) {
        exchange.stage = Stage::Shutdown;
        if (exchange.tls.calls == exchange.options.tls_calls) { return core::result::Err(Cause::TlsLimit); }
