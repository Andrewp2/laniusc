    if (complete.is_some()) { exchange.current = ext::http_client::Status::Complete; exchange.stage = Stage::Publish; return core::result::Ok(complete); }
    if (match(event) { ext::http_client::Need::Local -> true, _ -> false }) { exchange.action = Action::Local; return core::result::Ok(core::option::None()); }
    if (match(event) { ext::http_client::Need::StopUpload -> true, _ -> false }) {
        exchange.stopped_upload = true; let accepted: core::result::Result<bool,ext::http_client::Failure> = exchange.protocol.acknowledge_stop(); if (accepted.is_err()) { return core::result::Err(Cause::Http(accepted.unwrap_err())); }
