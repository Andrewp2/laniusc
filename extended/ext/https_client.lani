        let result: core::result::Result<core::option::Option<i32>,core::io::Error> = exchange.socket.take_error();
        if (result.is_err()) { return core::result::Err(Cause::Io(result.unwrap_err())); }
        if (result.unwrap().is_some()) { return core::result::Err(Cause::Io(core::io::Error::Host(result.unwrap().unwrap()))); }
        exchange.phase = Phase::ConnectPeer; let after = checked(exchange); if (after.is_err()) { return core::result::Err(after.unwrap_err()); } return core::result::Ok(core::option::None());
    }
    if (match(exchange.phase) { Phase::ConnectPeer -> true, _ -> false }) {
        exchange.stage = Stage::Connect; let before = before_io(exchange,ext::http_client::Stage::Connect); if (before.is_err()) { return core::result::Err(before.unwrap_err()); }
        let result: core::result::Result<core::net::SocketAddr,core::io::Error> = exchange.socket.peer_addr();
        if (result.is_err()) { let error: core::io::Error = result.unwrap_err(); let unconnected: bool = match(error) { core::io::Error::Host(code) -> code == 107, _ -> false }; if (!unconnected) { return core::result::Err(Cause::Io(error)); } exchange.phase = Phase::WaitConnect; }
        else { exchange.phase = Phase::Attach; }
        let after = checked(exchange); if (after.is_err()) { return core::result::Err(after.unwrap_err()); } return core::result::Ok(core::option::None());
    }
