            let recorded: core::result::Result<bool,ext::http_client::Failure> = exchange.protocol.record_write_shutdown(); if (recorded.is_err()) { return core::result::Err(Cause::Http(recorded.unwrap_err())); }
            if (match(exchange.action) { Action::Finish -> true, _ -> false }) { exchange.phase = Phase::Close; }
            else {
                exchange.phase = Phase::Protocol; exchange.read_blocked = false;
                if (match(result.unwrap()) { ext::openssl_tls::Shutdown::Complete -> true, _ -> false }) {
                    exchange.peer_closed = true; let eof: core::result::Result<bool,ext::http_client::Failure> = exchange.protocol.feed_eof(); if (eof.is_err()) { return core::result::Err(Cause::Http(eof.unwrap_err())); } exchange.action = Action::Local;
                }
            }
        } else {
            exchange.wait_need = ext::openssl_tls::Need::Write; if (match(result.unwrap()) { ext::openssl_tls::Shutdown::WantRead -> true, _ -> false }) { exchange.wait_need = ext::openssl_tls::Need::Read; } exchange.wait_blocked = true;
        }
        let after = checked(exchange); if (after.is_err()) { return core::result::Err(after.unwrap_err()); } return core::result::Ok(core::option::None());
    }
    if (match(exchange.phase) { Phase::Close -> true, _ -> false }) {
