    }
    if (match(event) { ext::http_client::Need::FinishTransport -> true, _ -> false }) {
        exchange.action = Action::Finish;
        if (pending_write(exchange) != 0) { if (exchange.tls.calls == exchange.options.tls_calls) { return core::result::Err(Cause::TlsLimit); } if (!exchange.write_blocked) { let sent = tls_write(exchange); if (sent.is_err()) { return core::result::Err(sent.unwrap_err()); } } return core::result::Ok(core::option::None()); }
        if (exchange.notified) { exchange.phase = Phase::Close; return core::result::Ok(core::option::None()); }
        let notified = begin_notify(exchange); if (notified.is_err()) { return core::result::Err(notified.unwrap_err()); } return core::result::Ok(core::option::None());
    }
    exchange.action = Action::Transfer;
    let transferred = transfer(exchange); if (transferred.is_err()) { return core::result::Err(transferred.unwrap_err()); } return core::result::Ok(core::option::None());
}
fn driver_interest(exchange: &Exchange) -> ext::http_client::Interest {
    let result: ext::http_client::Interest = ext::http_client::Interest { readable: false, writable: false, immediate: false };
    if (!running(exchange.current)) { return result; }
    if (match(exchange.phase) { Phase::WaitConnect -> true, _ -> false }) { result.writable = true; return result; }
    if (match(exchange.phase) { Phase::Handshake -> true, Phase::Notify -> true, _ -> false }) {
        result.immediate = !exchange.wait_blocked || exchange.tls.calls == exchange.options.tls_calls;
        result.writable = writes(exchange.wait_need); result.readable = !result.writable; return result;
    }
    let protocol: bool = match(exchange.phase) { Phase::Protocol -> true, _ -> false };
    if (!protocol) { result.immediate = true; return result; }
    if (match(exchange.action) { Action::Local -> true, _ -> false }) { result.immediate = true; return result; }
    if (exchange.tls.calls == exchange.options.tls_calls) { result.immediate = true; return result; }
    if (match(exchange.action) { Action::Finish -> true, _ -> false }) {
        if (pending_write(exchange) == 0) { result.immediate = true; return result; }
        result.immediate = !exchange.write_blocked; result.readable = reads(write_need(exchange)); result.writable = !result.readable; return result;
    }
    if (pending_write(exchange) != 0 && writes(write_need(exchange))) { result.writable = true; result.immediate = !exchange.write_blocked; return result; }
    if (early_notify(exchange)) { result.immediate = true; return result; }
    if (!exchange.peer_closed) {
        if (writes(read_need(exchange))) { result.writable = true; } else { result.readable = true; }
        if (!exchange.read_blocked) { result.immediate = true; }
    }
    if (pending_write(exchange) != 0 || upload(exchange)) {
        if (pending_write(exchange) != 0 && reads(write_need(exchange))) { result.readable = true; } else { result.writable = true; }
        if (!exchange.write_blocked) { result.immediate = true; }
    }
    return result;
}
fn driver_wait(exchange: &Exchange) -> core::result::Result<bool,Failure> {
    let failed: bool = match(exchange.current) { ext::http_client::Status::Failed -> true, _ -> false };
    if (failed) { return core::result::Err(exchange.failure.unwrap()); }
    if (!running(exchange.current)) { return core::result::Err(metadata(Cause::Inactive,exchange.stage,exchange.protocol.stats(),exchange.tls)); }
    let observed = checked(exchange); if (observed.is_err()) { return core::result::Err(stop(exchange,observed.unwrap_err())); }
    if (driver_interest(exchange).immediate) { return core::result::Ok(false); }
    let charged: core::result::Result<bool,ext::http_client::Failure> = exchange.protocol.before_wait();
    if (charged.is_err()) { return core::result::Err(stop(exchange,Cause::Http(charged.unwrap_err()))); } return core::result::Ok(charged.unwrap());
}
fn driver_step(exchange: &Exchange, ready: ext::http_client::Readiness) -> core::result::Result<core::option::Option<ext::http_client::Response>,Failure> {
    let failed: bool = match(exchange.current) { ext::http_client::Status::Failed -> true, _ -> false };
    if (failed) { return core::result::Err(exchange.failure.unwrap()); }
    if (!running(exchange.current)) { return core::result::Err(metadata(Cause::Inactive,exchange.stage,exchange.protocol.stats(),exchange.tls)); }
    let observed = checked(exchange); if (observed.is_err()) { return core::result::Err(stop(exchange,observed.unwrap_err())); }
    wake(exchange,ready);
    let result: core::result::Result<core::option::Option<ext::http_client::Response>,Cause> = advance(exchange,ready);
    if (result.is_err()) { return core::result::Err(stop(exchange,result.unwrap_err())); } return core::result::Ok(result.unwrap());
}
fn driver_abort(exchange: &Exchange) -> core::result::Result<bool,Failure> {
    if (!running(exchange.current)) { return core::result::Ok(false); }
    exchange.stage = Stage::Close; release_session(exchange); release_context(exchange); exchange.identity.destroy();
    let closed: core::result::Result<i32,core::io::Error> = exchange.socket.close(); exchange.protocol.abort(); exchange.current = ext::http_client::Status::Aborted;
    if (closed.is_err()) { let error: Failure = metadata(Cause::Io(closed.unwrap_err()),Stage::Close,exchange.protocol.stats(),exchange.tls); exchange.failure = core::option::Some(error); return core::result::Err(error); } return core::result::Ok(true);
}
pub impl Exchange {
    pub fn borrow(&self) -> &Exchange { return self; }
    pub fn stats(&self) -> ext::http_client::Stats { return self.protocol.stats(); }
    pub fn tls_stats(&self) -> TlsStats { return self.tls; }
    pub fn status(&self) -> ext::http_client::Status { return self.current; }
    pub fn last_failure(&self) -> core::option::Option<Failure> { return self.failure; }
    pub fn negotiated_version(&self) -> i32 { return self.version; }
    pub fn raw_handle(&self) -> core::option::Option<i32> { if (!running(self.current)) { return core::option::None(); } return self.socket.raw_handle(); }
    pub fn interest(&self) -> ext::http_client::Interest { return driver_interest(self); }
    pub fn before_wait(&self) -> core::result::Result<bool,Failure> { return driver_wait(self); }
    pub fn step(&self, ready: ext::http_client::Readiness) -> core::result::Result<core::option::Option<ext::http_client::Response>,Failure> { return driver_step(self,ready); }
    // Resume the same driver and stored deadline, preserving terminal guards.
    pub fn run(&self) -> core::result::Result<ext::http_client::Response,Failure> {
        let ready: ext::http_client::Readiness = empty_ready();
        while (true) {
            let progress = driver_step(self,ready); ready = empty_ready();
            if (progress.is_err()) { return core::result::Err(progress.unwrap_err()); }
            if (progress.unwrap().is_some()) { return core::result::Ok(progress.unwrap().unwrap()); }
            let interest: ext::http_client::Interest = driver_interest(self); if (interest.immediate) { continue; }
            let charged = driver_wait(self); if (charged.is_err()) { return core::result::Err(charged.unwrap_err()); } if (!charged.unwrap()) { continue; }
            let remaining: core::time::Duration = self.protocol.remaining(); let milliseconds: i32 = 2147483647;
            if (remaining.seconds <= 2147483 as u64) { let rounded: u64 = remaining.seconds*1000+((remaining.nanos as u64)+999999)/1000000; if (rounded < 2147483647 as u64) { milliseconds = rounded as i32; } }
            let waited: core::result::Result<std::socket::Ready,core::io::Error> = self.socket.wait_ms(interest.readable,interest.writable,milliseconds);
            if (waited.is_err()) { if (!core::io::is_interrupted(waited.unwrap_err())) { return core::result::Err(stop(self,Cause::Io(waited.unwrap_err()))); } }
            else { let event: std::socket::Ready = waited.unwrap(); ready = ext::http_client::Readiness { readable: event.readable, writable: event.writable, hangup: event.hangup, error: event.error }; }
        }
        return core::result::Err(metadata(Cause::Inactive,self.stage,self.protocol.stats(),self.tls));
    }
    pub fn abort(&self) -> core::result::Result<bool,Failure> { return driver_abort(self); }
}
// Explicit synchronous facade: one preparation and the same resumable owner.
// The facade polls; step/before_wait themselves never poll or retry a TLS call.
pub fn exchange_until(endpoint: core::net::SocketAddr, context: &ext::openssl_tls::Context, identity: ext::openssl_tls::Identity, request: ext::http_client::Request, http_options: ext::http_client::Options, tls_options: Options, deadline: core::time::Deadline) -> core::result::Result<ext::http_client::Response,Failure> {
    let made: core::result::Result<ext::http_client::Prepared,ext::http_client::Failure> = ext::http_client::prepare_until(request,http_options,deadline);
    if (made.is_err()) { let error: ext::http_client::Failure = made.unwrap_err(); return core::result::Err(metadata(Cause::Http(error),Stage::Prepare,error.stats,zero_tls())); }
    let prepared: ext::http_client::Prepared = made.unwrap(); let begun = begin_with_context_until(prepared.borrow(),endpoint,context,identity,tls_options);
    if (begun.is_err()) { return core::result::Err(begun.unwrap_err()); } let owner: Exchange = begun.unwrap(); return owner.run();
}
