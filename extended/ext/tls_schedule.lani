// RFC8446 sections4.4.4,7.1,7.2,7.5. SHA256 schedule, no allocation.
module ext::tls_schedule;
import core::result;
import core::sha256;
import core::slice;
import ext::hkdf_sha256;
import ext::hmac_sha256;
pub enum Error { Bounds, InvalidSecretLength, InvalidHashLength, InvalidLabelLength, ContextLimit, OutputLimit, InvalidVerifyLength, Derivation }
pub enum Side { Client, Server }
pub enum BinderKind { External, Resumption }
pub struct Secret { bytes: [u8; 32] }
pub struct Early { secret: Secret }
pub struct Handshake { secret: Secret }
pub struct Master { secret: Secret }
pub struct EarlyExporter { secret: Secret }
pub struct Exporter { secret: Secret }
pub struct Resumption { secret: Secret }
fn valid(value: core::slice::View<u8>) -> bool { return value.start >= 0 && value.length >= 0 && value.start <= 2147483647-value.length; }
pub impl Secret { pub fn view(&self) -> core::slice::View<u8> { return core::slice::View { values: self.bytes, start: 0, length: 32 }; } }
// Output must be physically backed, writable and disjoint from every input.
// Every returned error precedes all output writes.
pub fn expand_label(base: core::slice::View<u8>, label: core::slice::View<u8>, context: core::slice::View<u8>, output: core::slice::View<u8>) -> core::result::Result<i32, Error> {
    if (!valid(base) || !valid(label) || !valid(context) || !valid(output)) { return core::result::Err(Error::Bounds); }
    if (base.length != 32) { return core::result::Err(Error::InvalidSecretLength); }
    if (label.length < 1 || label.length > 249) { return core::result::Err(Error::InvalidLabelLength); }
    if (context.length > 255) { return core::result::Err(Error::ContextLimit); }
    if (output.length > 8160) { return core::result::Err(Error::OutputLimit); }
    let info: [u8; 514] = [0; 514]; info[0] = (output.length >> 8) as u8; info[1] = (output.length & 255) as u8; info[2] = (label.length+6) as u8;
    info[3] = 116; info[4] = 108; info[5] = 115; info[6] = 49; info[7] = 51; info[8] = 32;
    let index: i32 = 0; while (index < label.length) { info[9+index] = label.values[label.start+index]; index += 1; }
    let end: i32 = 9+label.length; info[end] = context.length as u8; index = 0;
    while (index < context.length) { info[end+1+index] = context.values[context.start+index]; index += 1; }
    let expanded: core::result::Result<i32, ext::hkdf_sha256::Error> = ext::hkdf_sha256::expand(base, core::slice::View { values: info, start: 0, length: end+1+context.length }, output);
    if (core::result::is_err(expanded)) { return core::result::Err(Error::Derivation); } return core::result::Ok(core::result::unwrap(expanded));
}
pub fn derive_secret(base: Secret, label: core::slice::View<u8>, transcript_hash: core::slice::View<u8>) -> core::result::Result<Secret, Error> {
    if (!valid(label) || !valid(transcript_hash)) { return core::result::Err(Error::Bounds); }
    if (transcript_hash.length != 32) { return core::result::Err(Error::InvalidHashLength); }
    let output: Secret = Secret { bytes: [0; 32] };
    let result: core::result::Result<i32, Error> = expand_label(base.view(), label, transcript_hash, output.view());
    if (core::result::is_err(result)) { return core::result::Err(core::result::unwrap_err(result)); } return core::result::Ok(output);
}
fn empty_hash() -> Secret { let empty: [u8; 1] = [0]; let digest: core::sha256::Digest = core::result::unwrap(core::sha256::digest(core::slice::View { values: empty, start: 0, length: 0 })); return Secret { bytes: digest.bytes }; }
fn extract(salt: Secret, ikm: core::slice::View<u8>) -> Secret { let digest: core::sha256::Digest = core::result::unwrap(ext::hkdf_sha256::extract(salt.view(), ikm)); return Secret { bytes: digest.bytes }; }
fn named(base: Secret, which: i32, hash: core::slice::View<u8>) -> core::result::Result<Secret, Error> {
    let label: [u8; 12] = [0; 12]; let length: i32 = 0;
    if (which == 0) { label = [100, 101, 114, 105, 118, 101, 100, 0, 0, 0, 0, 0]; length = 7; }
    if (which == 1) { label = [101, 120, 116, 32, 98, 105, 110, 100, 101, 114, 0, 0]; length = 10; }
    if (which == 2) { label = [114, 101, 115, 32, 98, 105, 110, 100, 101, 114, 0, 0]; length = 10; }
    if (which == 3) { label = [99, 32, 101, 32, 116, 114, 97, 102, 102, 105, 99, 0]; length = 11; }
    if (which == 4) { label = [101, 32, 101, 120, 112, 32, 109, 97, 115, 116, 101, 114]; length = 12; }
    if (which == 5) { label = [99, 32, 104, 115, 32, 116, 114, 97, 102, 102, 105, 99]; length = 12; }
    if (which == 6) { label = [115, 32, 104, 115, 32, 116, 114, 97, 102, 102, 105, 99]; length = 12; }
    if (which == 7) { label = [99, 32, 97, 112, 32, 116, 114, 97, 102, 102, 105, 99]; length = 12; }
    if (which == 8) { label = [115, 32, 97, 112, 32, 116, 114, 97, 102, 102, 105, 99]; length = 12; }
    if (which == 9) { label = [101, 120, 112, 32, 109, 97, 115, 116, 101, 114, 0, 0]; length = 10; }
    if (which == 10) { label = [114, 101, 115, 32, 109, 97, 115, 116, 101, 114, 0, 0]; length = 10; }
    return derive_secret(base, core::slice::View { values: label, start: 0, length: length }, hash);
}
pub fn early(psk: core::slice::View<u8>) -> core::result::Result<Early, Error> {
    if (!valid(psk)) { return core::result::Err(Error::Bounds); }
    let zero: Secret = Secret { bytes: [0; 32] }; return core::result::Ok(Early { secret: extract(zero, psk) });
}
pub fn no_psk() -> Early { let zero: Secret = Secret { bytes: [0; 32] }; return core::result::unwrap(early(zero.view())); }
pub impl Early {
    pub fn binder(&self, kind: BinderKind) -> Secret {
        let which: i32 = 1; if (match (kind) { BinderKind::External -> false, BinderKind::Resumption -> true }) { which = 2; }
        let empty: Secret = empty_hash(); return core::result::unwrap(named(self.secret, which, empty.view()));
    }
    pub fn traffic(&self, client_hello_hash: core::slice::View<u8>) -> core::result::Result<Secret, Error> { return named(self.secret, 3, client_hello_hash); }
    pub fn exporter(&self, client_hello_hash: core::slice::View<u8>) -> core::result::Result<EarlyExporter, Error> {
        let value: core::result::Result<Secret, Error> = named(self.secret, 4, client_hello_hash);
        if (core::result::is_err(value)) { return core::result::Err(core::result::unwrap_err(value)); } return core::result::Ok(EarlyExporter { secret: core::result::unwrap(value) });
    }
    pub fn handshake(&self, shared: core::slice::View<u8>) -> core::result::Result<Handshake, Error> {
        if (!valid(shared)) { return core::result::Err(Error::Bounds); }
        let empty: Secret = empty_hash(); let derived: Secret = core::result::unwrap(named(self.secret, 0, empty.view()));
        return core::result::Ok(Handshake { secret: extract(derived, shared) });
    }
    pub fn handshake_no_dhe(&self) -> Handshake { let zero: Secret = Secret { bytes: [0; 32] }; return core::result::unwrap(self.handshake(zero.view())); }
}
pub impl Handshake {
    pub fn traffic(&self, side: Side, server_hello_hash: core::slice::View<u8>) -> core::result::Result<Secret, Error> {
        let which: i32 = 5; if (match (side) { Side::Client -> false, Side::Server -> true }) { which = 6; } return named(self.secret, which, server_hello_hash);
    }
    pub fn master(&self) -> Master {
        let empty: Secret = empty_hash(); let derived: Secret = core::result::unwrap(named(self.secret, 0, empty.view())); let zero: Secret = Secret { bytes: [0; 32] };
        return Master { secret: extract(derived, zero.view()) };
    }
}
pub impl Master {
    pub fn traffic(&self, side: Side, server_finished_hash: core::slice::View<u8>) -> core::result::Result<Secret, Error> {
        let which: i32 = 7; if (match (side) { Side::Client -> false, Side::Server -> true }) { which = 8; } return named(self.secret, which, server_finished_hash);
    }
    pub fn exporter(&self, server_finished_hash: core::slice::View<u8>) -> core::result::Result<Exporter, Error> {
        let value: core::result::Result<Secret, Error> = named(self.secret, 9, server_finished_hash);
        if (core::result::is_err(value)) { return core::result::Err(core::result::unwrap_err(value)); } return core::result::Ok(Exporter { secret: core::result::unwrap(value) });
    }
    pub fn resumption(&self, client_finished_hash: core::slice::View<u8>) -> core::result::Result<Resumption, Error> {
        let value: core::result::Result<Secret, Error> = named(self.secret, 10, client_finished_hash);
        if (core::result::is_err(value)) { return core::result::Err(core::result::unwrap_err(value)); } return core::result::Ok(Resumption { secret: core::result::unwrap(value) });
    }
}
fn exporting(secret: Secret, label: core::slice::View<u8>, context: core::slice::View<u8>, output: core::slice::View<u8>) -> core::result::Result<i32, Error> {
    if (!valid(label) || !valid(context) || !valid(output)) { return core::result::Err(Error::Bounds); }
    if (label.length < 1 || label.length > 249) { return core::result::Err(Error::InvalidLabelLength); }
    if (output.length > 8160) { return core::result::Err(Error::OutputLimit); }
    let empty: Secret = empty_hash(); let derived: Secret = core::result::unwrap(derive_secret(secret, label, empty.view()));
    let hashed: core::sha256::Digest = core::result::unwrap(core::sha256::digest(context)); let purpose: [u8; 8] = [101,120,112,111,114,116,101,114];
    return expand_label(derived.view(), core::slice::View { values: purpose, start: 0, length: 8 }, core::slice::View { values: hashed.bytes, start: 0, length: 32 }, output);
}
pub impl EarlyExporter { pub fn export(&self, label: core::slice::View<u8>, context: core::slice::View<u8>, output: core::slice::View<u8>) -> core::result::Result<i32, Error> { return exporting(self.secret, label, context, output); } }
pub impl Exporter { pub fn export(&self, label: core::slice::View<u8>, context: core::slice::View<u8>, output: core::slice::View<u8>) -> core::result::Result<i32, Error> { return exporting(self.secret, label, context, output); } }
pub impl Resumption {
    pub fn ticket(&self, nonce: core::slice::View<u8>) -> core::result::Result<Secret, Error> {
        let output: Secret = Secret { bytes: [0; 32] }; let label: [u8; 10] = [114,101,115,117,109,112,116,105,111,110];
        let result: core::result::Result<i32, Error> = expand_label(self.secret.view(), core::slice::View { values: label, start: 0, length: 10 }, nonce, output.view());
        if (core::result::is_err(result)) { return core::result::Err(core::result::unwrap_err(result)); } return core::result::Ok(output);
    }
}
pub fn update_traffic(base: core::slice::View<u8>) -> core::result::Result<Secret, Error> {
    let output: Secret = Secret { bytes: [0; 32] }; let label: [u8; 11] = [116,114,97,102,102,105,99,32,117,112,100]; let empty: [u8; 1] = [0];
    let result: core::result::Result<i32, Error> = expand_label(base, core::slice::View { values: label, start: 0, length: 11 }, core::slice::View { values: empty, start: 0, length: 0 }, output.view());
    if (core::result::is_err(result)) { return core::result::Err(core::result::unwrap_err(result)); } return core::result::Ok(output);
}
pub fn finished(base: core::slice::View<u8>, transcript_hash: core::slice::View<u8>) -> core::result::Result<Secret, Error> {
    if (!valid(base) || !valid(transcript_hash)) { return core::result::Err(Error::Bounds); }
    if (base.length != 32) { return core::result::Err(Error::InvalidSecretLength); }
    if (transcript_hash.length != 32) { return core::result::Err(Error::InvalidHashLength); }
    let key: Secret = Secret { bytes: [0; 32] }; let label: [u8; 8] = [102,105,110,105,115,104,101,100]; let empty: [u8; 1] = [0];
    core::result::unwrap(expand_label(base, core::slice::View { values: label, start: 0, length: 8 }, core::slice::View { values: empty, start: 0, length: 0 }, key.view()));
    let tag: core::sha256::Digest = core::result::unwrap(ext::hmac_sha256::authenticate(key.view(), transcript_hash)); return core::result::Ok(Secret { bytes: tag.bytes });
}
pub fn verify_finished(base: core::slice::View<u8>, transcript_hash: core::slice::View<u8>, received: core::slice::View<u8>) -> core::result::Result<bool, Error> {
    if (!valid(base) || !valid(transcript_hash) || !valid(received)) { return core::result::Err(Error::Bounds); }
    if (base.length != 32) { return core::result::Err(Error::InvalidSecretLength); }
    if (transcript_hash.length != 32) { return core::result::Err(Error::InvalidHashLength); }
    if (received.length != 32) { return core::result::Err(Error::InvalidVerifyLength); }
    let expected: Secret = core::result::unwrap(finished(base, transcript_hash)); let difference: u32 = 0; let index: i32 = 0;
    while (index < 32) { difference |= (expected.bytes[index] ^ received.values[received.start+index]) as u32; index += 1; }
    return core::result::Ok(difference == 0);
}
