// RFC8446 sections4.4.4,7.1,7.2,7.5. Selected SHA256/SHA384, no allocation.
// Stable owned Secret/Digest locals back borrowed views; see the module guide.
module ext::tls_schedule;
import core::result;
import core::sha256;
import core::sha512;
import ext::tls_hash;
import core::slice;
import ext::hkdf_sha256;
import ext::hmac_sha256;
import ext::hkdf_sha384;
import ext::hmac_sha384;
pub enum Error { Bounds, InvalidSecretLength, HashMismatch, InvalidLabelLength, ContextLimit, OutputLimit, InvalidVerifyLength, Derivation }
pub enum Side { Client, Server }
pub enum BinderKind { External, Resumption }
pub struct Secret { algorithm: ext::tls_hash::Algorithm, bytes: [u8; 48] }
pub struct Early { secret: Secret }
pub struct Handshake { secret: Secret }
pub struct Master { secret: Secret }
pub struct EarlyExporter { secret: Secret }
pub struct Exporter { secret: Secret }
pub struct Resumption { secret: Secret }
fn valid(value: core::slice::View<u8>) -> bool { return value.start >= 0 && value.length >= 0 && value.start <= 2147483647-value.length; }
pub impl Secret {
    // self must be stable, live and unchanged for every use of the view.
    // Bind returned values to owned locals before borrowing their bytes.
    pub fn view(&self) -> core::slice::View<u8> { return core::slice::View { values: self.bytes, start: 0, length: ext::tls_hash::hash_length(self.algorithm) }; }
}
pub fn max_output(algorithm: ext::tls_hash::Algorithm) -> i32 { if (ext::tls_hash::hash_length(algorithm) == 32) { return 8160; } return 12240; }
fn same_hash(left: ext::tls_hash::Algorithm, right: ext::tls_hash::Algorithm) -> bool { return ext::tls_hash::hash_length(left) == ext::tls_hash::hash_length(right); }
fn zero(algorithm: ext::tls_hash::Algorithm) -> Secret { return Secret { algorithm: algorithm, bytes: [0; 48] }; }
pub fn secret_from_view(algorithm: ext::tls_hash::Algorithm, input: core::slice::View<u8>) -> core::result::Result<Secret, Error> {
    if (!valid(input)) { return core::result::Err(Error::Bounds); }
    let length: i32 = ext::tls_hash::hash_length(algorithm);
    if (input.length != length) { return core::result::Err(Error::InvalidSecretLength); }
    let output: Secret = zero(algorithm); let index: i32 = 0;
    while (index < length) { output.bytes[index] = input.values[input.start+index]; index += 1; }
    return core::result::Ok(output);
}
// Output must be physically backed, writable and disjoint from every input.
// Every returned error precedes all output writes.
pub fn expand_label(base: Secret, label: core::slice::View<u8>, context: core::slice::View<u8>, output: core::slice::View<u8>) -> core::result::Result<i32, Error> {
    if (!valid(label) || !valid(context) || !valid(output)) { return core::result::Err(Error::Bounds); }
    if (label.length < 1 || label.length > 249) { return core::result::Err(Error::InvalidLabelLength); }
    if (context.length > 255) { return core::result::Err(Error::ContextLimit); }
    if (output.length > max_output(base.algorithm)) { return core::result::Err(Error::OutputLimit); }
    let info: [u8; 514] = [0; 514]; info[0] = (output.length >> 8) as u8; info[1] = (output.length & 255) as u8; info[2] = (label.length+6) as u8;
    info[3] = 116; info[4] = 108; info[5] = 115; info[6] = 49; info[7] = 51; info[8] = 32;
    let index: i32 = 0; while (index < label.length) { info[9+index] = label.values[label.start+index]; index += 1; }
    let end: i32 = 9+label.length; info[end] = context.length as u8; index = 0;
    while (index < context.length) { info[end+1+index] = context.values[context.start+index]; index += 1; }
    let encoded: core::slice::View<u8> = core::slice::View { values: info, start: 0, length: end+1+context.length };
    if (ext::tls_hash::hash_length(base.algorithm) == 32) {
        let expanded: core::result::Result<i32, ext::hkdf_sha256::Error> = ext::hkdf_sha256::expand(base.view(),encoded,output);
        if (expanded.is_err()) { return core::result::Err(Error::Derivation); } return core::result::Ok(expanded.unwrap());
    }
    let expanded: core::result::Result<i32, ext::hkdf_sha384::Error> = ext::hkdf_sha384::expand(base.view(),encoded,output);
    if (expanded.is_err()) { return core::result::Err(Error::Derivation); } return core::result::Ok(expanded.unwrap());
}
pub fn derive_secret(base: Secret, label: core::slice::View<u8>, transcript_hash: ext::tls_hash::Digest) -> core::result::Result<Secret, Error> {
    if (!valid(label)) { return core::result::Err(Error::Bounds); }
    if (!same_hash(base.algorithm,transcript_hash.algorithm)) { return core::result::Err(Error::HashMismatch); }
    let output: Secret = zero(base.algorithm);
    let result: core::result::Result<i32, Error> = expand_label(base,label,transcript_hash.view(),output.view());
    if (core::result::is_err(result)) { return core::result::Err(core::result::unwrap_err(result)); } return core::result::Ok(output);
}
fn empty_hash(algorithm: ext::tls_hash::Algorithm) -> ext::tls_hash::Digest {
    let empty: [u8;1] = [0]; return ext::tls_hash::digest(algorithm,core::slice::View { values: empty,start: 0,length: 0 }).unwrap();
}
fn extract(salt: Secret, ikm: core::slice::View<u8>) -> Secret {
    if (ext::tls_hash::hash_length(salt.algorithm) == 32) {
        let digest: core::sha256::Digest = ext::hkdf_sha256::extract(salt.view(),ikm).unwrap();
        return secret_from_view(salt.algorithm,core::slice::View { values: digest.bytes,start: 0,length: 32 }).unwrap();
    }
    let digest: core::sha512::Digest = ext::hkdf_sha384::extract(salt.view(),ikm).unwrap();
    return secret_from_view(salt.algorithm,core::slice::View { values: digest.bytes,start: 0,length: 48 }).unwrap();
}
fn authenticate(key: Secret, message: core::slice::View<u8>) -> Secret {
    if (ext::tls_hash::hash_length(key.algorithm) == 32) {
        let digest: core::sha256::Digest = ext::hmac_sha256::authenticate(key.view(),message).unwrap();
        return secret_from_view(key.algorithm,core::slice::View { values: digest.bytes,start: 0,length: 32 }).unwrap();
    }
    let digest: core::sha512::Digest = ext::hmac_sha384::authenticate(key.view(),message).unwrap();
    return secret_from_view(key.algorithm,core::slice::View { values: digest.bytes,start: 0,length: 48 }).unwrap();
}
fn named(base: Secret, which: i32, hash: ext::tls_hash::Digest) -> core::result::Result<Secret, Error> {
    let label: [u8; 12] = [0; 12]; let length: i32 = 0;
    if (which == 0) { label = [100, 101, 114, 105, 118, 101, 100, 0, 0, 0, 0, 0]; length = 7; }
    if (which == 1) { label = [101, 120, 116, 32, 98, 105, 110, 100, 101, 114, 0, 0]; length = 10; }
    if (which == 2) { label = [114, 101, 115, 32, 98, 105, 110, 100, 101, 114, 0, 0]; length = 10; }
    if (which == 3) { label = [99, 32, 101, 32, 116, 114, 97, 102, 102, 105, 99, 0]; length = 11; }
    if (which == 4) { label = [101, 32, 101, 120, 112, 32, 109, 97, 115, 116, 101, 114]; length = 12; }
    if (which == 5) { label = [99, 32, 104, 115, 32, 116, 114, 97, 102, 102, 105, 99]; length = 12; }
    if (which == 6) { label = [115, 32, 104, 115, 32, 116, 114, 97, 102, 102, 105, 99]; length = 12; }
    if (which == 7) { label = [99, 32, 97, 112, 32, 116, 114, 97, 102, 102, 105, 99]; length = 12; }
    if (which == 8) { label = [115, 32, 97, 112, 32, 116, 114, 97, 102, 102, 105, 99]; length = 12; }
    if (which == 9) { label = [101, 120, 112, 32, 109, 97, 115, 116, 101, 114, 0, 0]; length = 10; }
    if (which == 10) { label = [114, 101, 115, 32, 109, 97, 115, 116, 101, 114, 0, 0]; length = 10; }
    return derive_secret(base, core::slice::View { values: label, start: 0, length: length }, hash);
}
pub fn early(algorithm: ext::tls_hash::Algorithm, psk: core::slice::View<u8>) -> core::result::Result<Early, Error> {
    if (!valid(psk)) { return core::result::Err(Error::Bounds); }
    let zero: Secret = zero(algorithm); return core::result::Ok(Early { secret: extract(zero, psk) });
}
pub fn no_psk(algorithm: ext::tls_hash::Algorithm) -> Early { let zero: Secret = zero(algorithm); return early(algorithm,zero.view()).unwrap(); }
pub impl Early {
    pub fn binder(&self, kind: BinderKind) -> Secret {
        let which: i32 = 1; if (match (kind) { BinderKind::External -> false, BinderKind::Resumption -> true }) { which = 2; }
        let empty: ext::tls_hash::Digest = empty_hash(self.secret.algorithm); return core::result::unwrap(named(self.secret, which, empty));
    }
    pub fn traffic(&self, client_hello_hash: ext::tls_hash::Digest) -> core::result::Result<Secret, Error> { return named(self.secret, 3, client_hello_hash); }
    pub fn exporter(&self, client_hello_hash: ext::tls_hash::Digest) -> core::result::Result<EarlyExporter, Error> {
        let value: core::result::Result<Secret, Error> = named(self.secret, 4, client_hello_hash);
        if (core::result::is_err(value)) { return core::result::Err(core::result::unwrap_err(value)); } return core::result::Ok(EarlyExporter { secret: core::result::unwrap(value) });
    }
    pub fn handshake(&self, shared: core::slice::View<u8>) -> core::result::Result<Handshake, Error> {
        if (!valid(shared)) { return core::result::Err(Error::Bounds); }
        let empty: ext::tls_hash::Digest = empty_hash(self.secret.algorithm); let derived: Secret = core::result::unwrap(named(self.secret, 0, empty));
        return core::result::Ok(Handshake { secret: extract(derived, shared) });
    }
    pub fn handshake_no_dhe(&self) -> Handshake { let zero: Secret = zero(self.secret.algorithm); return core::result::unwrap(self.handshake(zero.view())); }
}
pub impl Handshake {
    pub fn traffic(&self, side: Side, server_hello_hash: ext::tls_hash::Digest) -> core::result::Result<Secret, Error> {
        let which: i32 = 5; if (match (side) { Side::Client -> false, Side::Server -> true }) { which = 6; } return named(self.secret, which, server_hello_hash);
    }
    pub fn master(&self) -> Master {
        let empty: ext::tls_hash::Digest = empty_hash(self.secret.algorithm); let derived: Secret = core::result::unwrap(named(self.secret, 0, empty)); let zero: Secret = zero(self.secret.algorithm);
        return Master { secret: extract(derived, zero.view()) };
    }
}
pub impl Master {
    pub fn traffic(&self, side: Side, server_finished_hash: ext::tls_hash::Digest) -> core::result::Result<Secret, Error> {
        let which: i32 = 7; if (match (side) { Side::Client -> false, Side::Server -> true }) { which = 8; } return named(self.secret, which, server_finished_hash);
    }
    pub fn exporter(&self, server_finished_hash: ext::tls_hash::Digest) -> core::result::Result<Exporter, Error> {
        let value: core::result::Result<Secret, Error> = named(self.secret, 9, server_finished_hash);
        if (core::result::is_err(value)) { return core::result::Err(core::result::unwrap_err(value)); } return core::result::Ok(Exporter { secret: core::result::unwrap(value) });
    }
    pub fn resumption(&self, client_finished_hash: ext::tls_hash::Digest) -> core::result::Result<Resumption, Error> {
        let value: core::result::Result<Secret, Error> = named(self.secret, 10, client_finished_hash);
        if (core::result::is_err(value)) { return core::result::Err(core::result::unwrap_err(value)); } return core::result::Ok(Resumption { secret: core::result::unwrap(value) });
    }
}
fn exporting(secret: Secret, label: core::slice::View<u8>, context: core::slice::View<u8>, output: core::slice::View<u8>) -> core::result::Result<i32, Error> {
    if (!valid(label) || !valid(context) || !valid(output)) { return core::result::Err(Error::Bounds); }
    if (label.length < 1 || label.length > 249) { return core::result::Err(Error::InvalidLabelLength); }
    if (output.length > max_output(secret.algorithm)) { return core::result::Err(Error::OutputLimit); }
    let empty: ext::tls_hash::Digest = empty_hash(secret.algorithm); let derived: Secret = derive_secret(secret,label,empty).unwrap();
    let hashed: ext::tls_hash::Digest = ext::tls_hash::digest(secret.algorithm,context).unwrap(); let purpose: [u8; 8] = [101,120,112,111,114,116,101,114];
    return expand_label(derived,core::slice::View { values: purpose,start: 0,length: 8 },hashed.view(),output);
}
pub impl EarlyExporter { pub fn export(&self, label: core::slice::View<u8>, context: core::slice::View<u8>, output: core::slice::View<u8>) -> core::result::Result<i32, Error> { return exporting(self.secret, label, context, output); } }
pub impl Exporter { pub fn export(&self, label: core::slice::View<u8>, context: core::slice::View<u8>, output: core::slice::View<u8>) -> core::result::Result<i32, Error> { return exporting(self.secret, label, context, output); } }
pub impl Resumption {
    pub fn ticket(&self, nonce: core::slice::View<u8>) -> core::result::Result<Secret, Error> {
        let output: Secret = zero(self.secret.algorithm); let label: [u8; 10] = [114,101,115,117,109,112,116,105,111,110];
        let result: core::result::Result<i32, Error> = expand_label(self.secret, core::slice::View { values: label, start: 0, length: 10 }, nonce, output.view());
        if (core::result::is_err(result)) { return core::result::Err(core::result::unwrap_err(result)); } return core::result::Ok(output);
    }
}
pub fn update_traffic(base: Secret) -> core::result::Result<Secret, Error> {
    let output: Secret = zero(base.algorithm); let label: [u8; 11] = [116,114,97,102,102,105,99,32,117,112,100]; let empty: [u8; 1] = [0];
    let result: core::result::Result<i32, Error> = expand_label(base, core::slice::View { values: label, start: 0, length: 11 }, core::slice::View { values: empty, start: 0, length: 0 }, output.view());
    if (core::result::is_err(result)) { return core::result::Err(core::result::unwrap_err(result)); } return core::result::Ok(output);
}
pub fn finished(base: Secret, transcript_hash: ext::tls_hash::Digest) -> core::result::Result<Secret, Error> {
    if (!same_hash(base.algorithm,transcript_hash.algorithm)) { return core::result::Err(Error::HashMismatch); }
    let key: Secret = zero(base.algorithm); let label: [u8; 8] = [102,105,110,105,115,104,101,100]; let empty: [u8; 1] = [0];
    core::result::unwrap(expand_label(base, core::slice::View { values: label, start: 0, length: 8 }, core::slice::View { values: empty, start: 0, length: 0 }, key.view()));
    return core::result::Ok(authenticate(key,transcript_hash.view()));
}
pub fn verify_finished(base: Secret, transcript_hash: ext::tls_hash::Digest, received: core::slice::View<u8>) -> core::result::Result<bool, Error> {
    if (!valid(received)) { return core::result::Err(Error::Bounds); }
    if (!same_hash(base.algorithm,transcript_hash.algorithm)) { return core::result::Err(Error::HashMismatch); }
    if (received.length != ext::tls_hash::hash_length(base.algorithm)) { return core::result::Err(Error::InvalidVerifyLength); }
    let expected: Secret = core::result::unwrap(finished(base, transcript_hash)); let difference: u32 = 0; let index: i32 = 0;
    while (index < ext::tls_hash::hash_length(base.algorithm)) { difference |= (expected.bytes[index] ^ received.values[received.start+index]) as u32; index += 1; }
    return core::result::Ok(difference == 0);
}
