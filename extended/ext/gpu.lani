        gpu_barrier(c.command); ext::gpu_native::vkCmdBindPipeline(c.command,1,pipeline.handle); bind_group(c.command,1,pipeline.layout,group.set); ext::gpu_native::vkCmdDispatch(c.command,x as u32,y as u32,z as u32); return core::result::Ok(0);
    }
}
fn idle_for_close(owner:ptr) -> core::result::Result<i32,Failure> {
    let status=ext::gpu_native::vkDeviceWaitIdle(control(owner)[0].device); if(status== -4) { control(owner)[0].lost=true; return core::result::Ok(0); } return result(owner,status,Stage::Close);
}
pub impl Surface {
    pub fn render_bound(&self,pipeline:&Pipeline,group:&BindGroup,vertices:i32) -> core::result::Result<Frame,Failure> {
        if(self.storage==0) { return core::result::Err(error(Cause::Closed,Stage::Draw)); }
        let owner=display(self.storage)[0].owner; check(owner,Stage::Draw)?; group_check(owner,pipeline.bindings,group,nil())?;
        return draw(self.storage,pipeline,vertices,0,0,group.set,group.layout_life);
    }
    pub fn render_bound_readback(&self,pipeline:&Pipeline,group:&BindGroup,vertices:i32,target:&Buffer) -> core::result::Result<Frame,Failure> {
        if(self.storage==0) { return core::result::Err(error(Cause::Closed,Stage::Draw)); }
        let owner=display(self.storage)[0].owner; check(owner,Stage::Draw)?; group_check(owner,pipeline.bindings,group,nil())?;
        if(target.owner!=owner) { return core::result::Err(error(Cause::DifferentDevice,Stage::Draw)); }
        return draw(self.storage,pipeline,vertices,target.handle,target.length,group.set,group.layout_life);
    }
}

pub enum FrameSubmission { Submitted(Submission), Retry, Suspended }
fn submission_fences(p:ptr,out:ptr) -> i32 {
    let c=commands(p)[0]; q(out,0,c.fence); let count:i32=1;
    if(c.surface!=0) { let s=display(c.surface)[0]; if(s.pending_acquire) { q(out,(count as usize)*8,s.acquired); count+=1; } if(s.pending_present) { q(out,(count as usize)*8,s.presented); count+=1; } } return count;
}
pub impl Submission {
    // After completion: reports presentation success/retry/error separately from
    // submission acceptance. Presentation errors never discard a pending owner.
    pub fn frame(&self) -> core::result::Result<Frame,Failure> {
        if(!self.poll()?) { return core::result::Err(error(Cause::Busy,Stage::Draw)); }
        let c=commands(self.storage)[0]; if(!c.frame) { return core::result::Err(error(Cause::Unsupported,Stage::Draw)); }
        if(c.frame_status==ext::gpu_native::VK_ERROR_OUT_OF_DATE_KHR) { return core::result::Ok(Frame::Retry); }
        if(c.frame_status!=0 && c.frame_status!=ext::gpu_native::VK_SUBOPTIMAL_KHR) { result(c.owner,c.frame_status,Stage::Draw)?; }
        return core::result::Ok(Frame::Presented(ext::window::Size {width:c.width,height:c.height}));
    }
}
fn submit_frame(storage:ptr,pipeline:&Pipeline,group:&BindGroup,vertices:i32,target:u64,length:i32,target_life:ptr) -> core::result::Result<FrameSubmission,Failure> {
    if(storage==0) { return core::result::Err(error(Cause::Closed,Stage::Draw)); }
    let s=display(storage); let owner=s[0].owner; check(owner,Stage::Draw)?;
    if(s[0].inflight!=0) { return core::result::Err(error(Cause::Busy,Stage::Draw)); }
    if(s[0].broken) { return core::result::Err(error(Cause::Poisoned,Stage::Draw)); }
    if(pipeline.owner!=owner) { return core::result::Err(error(Cause::DifferentDevice,Stage::Draw)); }
    group_check(owner,pipeline.bindings,group,nil())?;
    if(format_code(pipeline.format)!=format_code(s[0].format) || vertices<1 || vertices>1048576) { return core::result::Err(error(Cause::Bounds,Stage::Draw)); }
    if(!ensure_chain(storage)?) { return core::result::Ok(FrameSubmission::Suspended); }
    if(target!=0 && length<s[0].width*s[0].height*4) { return core::result::Err(error(Cause::Bounds,Stage::Draw)); }
    let d=Device {storage:owner}; let encoder=d.create_encoder()?;
    let retained=retain_group(encoder.storage,pipeline.life,group,target_life);
    if(retained.is_err()) { encoder.close(); return core::result::Err(retained.unwrap_err()); }
    let made=submit_acquired(storage,pipeline,group,vertices,target,encoder.borrow());
    if(encoder.storage!=0) { let closed=encoder.close(); if(closed.is_err()) { s[0].abandoned=encoder.storage; encoder.storage=nil(); } } return made;
}
fn submit_acquired(storage:ptr,pipeline:&Pipeline,group:&BindGroup,vertices:i32,target:u64,encoder:&CommandEncoder) -> core::result::Result<FrameSubmission,Failure> {
    let s=display(storage); let owner=s[0].owner; let c=control(owner)[0]; let out:[i32;2]=[0;2]; let o=address(out); q(o,0,s[0].acquired);
    result(owner,ext::gpu_native::vkResetFences(c.device,1,o),Stage::Draw)?;
    let status=ext::gpu_native::vkAcquireNextImageKHR(c.device,s[0].chain,0,s[0].available,s[0].acquired,o);
    if(status==1 || status==2) { return core::result::Ok(FrameSubmission::Retry); }
    if(status==ext::gpu_native::VK_ERROR_OUT_OF_DATE_KHR) { s[0].dirty=true; return core::result::Ok(FrameSubmission::Retry); }
    if(status!=0 && status!=ext::gpu_native::VK_SUBOPTIMAL_KHR) { result(owner,status,Stage::Draw)?; }
    s[0].pending_acquire=true; s[0].broken=true; if(status==ext::gpu_native::VK_SUBOPTIMAL_KHR) { s[0].dirty=true; }
    let index=r(o,0); if(index<0 || index>=s[0].count) { return core::result::Err(error(Cause::Unsupported,Stage::Draw)); }
    let cmd=commands(encoder.storage); cmd[0].wait_sem=s[0].available; cmd[0].signal_sem=s[0].finished;
    record_surface(storage,pipeline,vertices,index,target,group.set,cmd[0].command);
    let ticket=encoder.submit()?;
    // From here all failure paths return the ticket. The caller can wait/close it.
    let queued=queue_present(storage,index); let presentation:i32=0;
    if(queued.is_err()) { let failure=queued.unwrap_err(); presentation=match(failure.cause) { Cause::Vulkan(code) -> code, Cause::DeviceLost -> -4, _ -> -1 }; } else { presentation=queued.unwrap(); }
    if(presentation== -4) { control(owner)[0].lost=true; }
    if(presentation==ext::gpu_native::VK_SUBOPTIMAL_KHR || presentation==ext::gpu_native::VK_ERROR_OUT_OF_DATE_KHR) { s[0].dirty=true; }
    commands(ticket.storage)[0].surface=storage; commands(ticket.storage)[0].frame=true; commands(ticket.storage)[0].frame_status=presentation; commands(ticket.storage)[0].width=s[0].width; commands(ticket.storage)[0].height=s[0].height; s[0].inflight=ticket.storage;
    return core::result::Ok(FrameSubmission::Submitted(ticket));
}
fn empty_group(owner:ptr) -> BindGroup { return BindGroup {owner:owner,life:nil(),layout_life:nil(),pool:0,set:0,resources:nil(),count:0}; }
pub impl Surface {
    pub fn submit(&self,pipeline:&Pipeline,vertices:i32) -> core::result::Result<FrameSubmission,Failure> {
        let group=empty_group(pipeline.owner); return submit_frame(self.storage,pipeline,group.borrow(),vertices,0,0,nil());
    }
    pub fn submit_readback(&self,pipeline:&Pipeline,vertices:i32,target:&Buffer) -> core::result::Result<FrameSubmission,Failure> {
        if(target.owner!=pipeline.owner || target.owner==0) { return core::result::Err(error(Cause::DifferentDevice,Stage::Draw)); }
        let group=empty_group(pipeline.owner); return submit_frame(self.storage,pipeline,group.borrow(),vertices,target.handle,target.length,target.life);
    }
    pub fn submit_bound(&self,pipeline:&Pipeline,group:&BindGroup,vertices:i32) -> core::result::Result<FrameSubmission,Failure> { return submit_frame(self.storage,pipeline,group,vertices,0,0,nil()); }
    pub fn submit_bound_readback(&self,pipeline:&Pipeline,group:&BindGroup,vertices:i32,target:&Buffer) -> core::result::Result<FrameSubmission,Failure> {
        if(target.owner!=pipeline.owner || target.owner==0) { return core::result::Err(error(Cause::DifferentDevice,Stage::Draw)); }
        return submit_frame(self.storage,pipeline,group,vertices,target.handle,target.length,target.life);
    }
}
