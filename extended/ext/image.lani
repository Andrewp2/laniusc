// Packed straight-alpha RGBA8 images. Copies alias ownership; destroy one owner.
module ext::image;
import alloc::vec;
import core::i32;
import core::option;
import core::result;
import core::slice;

pub struct Rgba { r: u8, g: u8, b: u8, a: u8 }
pub struct Image { w: i32, h: i32, storage: alloc::vec::Vec<u8> }
pub struct View { bytes: core::slice::View<u8>, width: i32, height: i32, stride: i32 }
pub enum Error { Dimensions, SizeOverflow, Bounds, AllocationFailed }
pub enum Filter { Nearest, Bilinear, Area }

pub fn byte_len(width: i32, height: i32) -> core::result::Result<i32,Error> {
    if (width <= 0 || height <= 0) { return core::result::Err(Error::Dimensions); }
    if (width > 536870911 || height > 536870911 / width) { return core::result::Err(Error::SizeOverflow); }
    return core::result::Ok(width * height * 4);
}
pub fn valid(view: View) -> bool {
    let n: core::result::Result<i32,Error> = byte_len(view.width,view.height);
    if (core::result::is_err(n)) { return false; }
    if (view.bytes.start < 0 || view.bytes.length < 0 || view.bytes.start > 2147483647-view.bytes.length) { return false; }
    let row: i32 = view.width*4;
    if (view.stride < row || view.bytes.length < row) { return false; }
    return view.height-1 <= (view.bytes.length-row)/view.stride;
}
pub fn view(bytes: core::slice::View<u8>, width: i32, height: i32, stride: i32) -> core::result::Result<View,Error> {
    let result: View = View { bytes: bytes, width: width, height: height, stride: stride };
    if (!valid(result)) { return core::result::Err(Error::Bounds); }
    return core::result::Ok(result);
}
fn offset(source: View, x: i32, y: i32) -> i32 { return source.bytes.start+y*source.stride+x*4; }
fn read(source: View, x: i32, y: i32) -> Rgba {
    let i: i32 = offset(source,x,y);
    return Rgba { r: source.bytes.values[i], g: source.bytes.values[i+1], b: source.bytes.values[i+2], a: source.bytes.values[i+3] };
}
fn write(target: View, x: i32, y: i32, pixel: Rgba) {
    let i: i32 = offset(target,x,y);
    target.bytes.values[i] = pixel.r; target.bytes.values[i+1] = pixel.g;
    target.bytes.values[i+2] = pixel.b; target.bytes.values[i+3] = pixel.a;
}
pub fn get(source: View, x: i32, y: i32) -> core::option::Option<Rgba> {
    if (!valid(source) || x < 0 || y < 0 || x >= source.width || y >= source.height) { return core::option::None(); }
    return core::option::Some(read(source,x,y));
}
pub fn set(target: View, x: i32, y: i32, pixel: Rgba) -> bool {
    if (!valid(target) || x < 0 || y < 0 || x >= target.width || y >= target.height) { return false; }
    write(target,x,y,pixel); return true;
}
pub fn fill(target: View, pixel: Rgba) -> core::result::Result<i32,Error> {
    if (!valid(target)) { return core::result::Err(Error::Bounds); }
    let y: i32 = 0; while (y < target.height) { let x: i32 = 0; while (x < target.width) { write(target,x,y,pixel); x += 1; } y += 1; }
    return core::result::Ok(target.width*target.height);
}
pub fn new(width: i32, height: i32, pixel: Rgba) -> core::result::Result<Image,Error> {
    let size: core::result::Result<i32,Error> = byte_len(width,height);
    if (core::result::is_err(size)) { return core::result::Err(core::result::unwrap_err(size)); }
    let storage: alloc::vec::Vec<u8> = alloc::vec::new();
    let resized: core::result::Result<i32,alloc::vec::Error> = storage.try_resize(core::result::unwrap(size),0);
    if (core::result::is_err(resized)) { storage.destroy(); return core::result::Err(Error::AllocationFailed); }
    let result: Image = Image { w: width, h: height, storage: storage };
    fill(result.view(),pixel); return core::result::Ok(result);
}
pub fn from_rgba(width: i32, height: i32, bytes: core::slice::View<u8>) -> core::result::Result<Image,Error> {
    let size: core::result::Result<i32,Error> = byte_len(width,height);
    if (core::result::is_err(size)) { return core::result::Err(core::result::unwrap_err(size)); }
    if (bytes.length != core::result::unwrap(size)) { return core::result::Err(Error::Bounds); }
    let source: core::result::Result<View,Error> = view(bytes,width,height,width*4);
    if (core::result::is_err(source)) { return core::result::Err(Error::Bounds); }
    return crop(core::result::unwrap(source),0,0,width,height);
}
pub impl Image {
    pub fn borrow(&self) -> &Image { return self; }
    pub fn width(&self) -> i32 { return self.w; }
    pub fn height(&self) -> i32 { return self.h; }
    pub fn rgba(&self) -> core::slice::View<u8> { return self.storage.as_view(); }
    pub fn view(&self) -> View { return View { bytes: self.storage.as_view(), width: self.w, height: self.h, stride: self.w*4 }; }
    pub fn try_clone(&self) -> core::result::Result<Image,Error> { return crop(self.view(),0,0,self.w,self.h); }
    pub fn destroy(&self) { self.storage.destroy(); self.w = 0; self.h = 0; }
}
fn region(source: View, x: i32, y: i32, width: i32, height: i32) -> bool {
    return valid(source) && x >= 0 && y >= 0 && width > 0 && height > 0 && x <= source.width && y <= source.height && width <= source.width-x && height <= source.height-y;
}
pub fn subview(source: View, x: i32, y: i32, width: i32, height: i32) -> core::result::Result<View,Error> {
    if (!region(source,x,y,width,height)) { return core::result::Err(Error::Bounds); }
    let start: i32 = y*source.stride+x*4; let count: i32 = (height-1)*source.stride+width*4;
    let selected: core::slice::View<u8> = core::result::unwrap(source.bytes.subview(start,start+count));
    return core::result::Ok(View { bytes: selected, width: width, height: height, stride: source.stride });
}
pub fn crop(source: View, x: i32, y: i32, width: i32, height: i32) -> core::result::Result<Image,Error> {
    if (!region(source,x,y,width,height)) { return core::result::Err(Error::Bounds); }
    let made: core::result::Result<Image,Error> = new(width,height,Rgba { r: 0, g: 0, b: 0, a: 0 });
    if (core::result::is_err(made)) { return made; }
    let result: Image = core::result::unwrap(made); let target: View = result.view();
    let row: i32 = 0; while (row < height) { let col: i32 = 0; while (col < width) { write(target,col,row,read(source,x+col,y+row)); col += 1; } row += 1; }
    return core::result::Ok(result);
}
pub fn flip_horizontal(target: View) -> core::result::Result<i32,Error> {
    if (!valid(target)) { return core::result::Err(Error::Bounds); }
    let y: i32 = 0; while (y < target.height) { let x: i32 = 0; while (x < target.width/2) {
        let held: Rgba = read(target,x,y); write(target,x,y,read(target,target.width-1-x,y)); write(target,target.width-1-x,y,held); x += 1;
    } y += 1; } return core::result::Ok(target.width*target.height);
}
pub fn flip_vertical(target: View) -> core::result::Result<i32,Error> {
    if (!valid(target)) { return core::result::Err(Error::Bounds); }
    let y: i32 = 0; while (y < target.height/2) { let x: i32 = 0; while (x < target.width) {
        let held: Rgba = read(target,x,y); write(target,x,y,read(target,x,target.height-1-y)); write(target,x,target.height-1-y,held); x += 1;
    } y += 1; } return core::result::Ok(target.width*target.height);
}
pub fn rotate90(source: View) -> core::result::Result<Image,Error> {
    if (!valid(source)) { return core::result::Err(Error::Bounds); }
    let made: core::result::Result<Image,Error> = new(source.height,source.width,Rgba { r: 0, g: 0, b: 0, a: 0 });
    if (core::result::is_err(made)) { return made; }
    let result: Image = core::result::unwrap(made); let target: View = result.view();
    let y: i32 = 0; while (y < source.height) { let x: i32 = 0; while (x < source.width) { write(target,source.height-1-y,x,read(source,x,y)); x += 1; } y += 1; }
    return core::result::Ok(result);
}
fn blend_channel(src: u8, dst: u8, sa: i32, da: i32, alpha: i32) -> u8 {
    return (((src as i32)*sa*255+(dst as i32)*da*(255-sa)+alpha/2)/alpha) as u8;
}
pub fn over(src: Rgba, dst: Rgba) -> Rgba {
    let sa: i32 = src.a as i32; let da: i32 = dst.a as i32; let alpha: i32 = sa*255+da*(255-sa);
    if (alpha == 0) { return Rgba { r: 0, g: 0, b: 0, a: 0 }; }
    return Rgba { r: blend_channel(src.r,dst.r,sa,da,alpha), g: blend_channel(src.g,dst.g,sa,da,alpha), b: blend_channel(src.b,dst.b,sa,da,alpha), a: ((alpha+127)/255) as u8 };
}
// Snapshot source before any write, including aliases. Failure is atomic.
fn copy(target: View, x: i32, y: i32, source: View, composite: bool) -> core::result::Result<i32,Error> {
    if (!valid(source) || !region(target,x,y,source.width,source.height)) { return core::result::Err(Error::Bounds); }
    let cloned: core::result::Result<Image,Error> = crop(source,0,0,source.width,source.height);
    if (core::result::is_err(cloned)) { return core::result::Err(core::result::unwrap_err(cloned)); }
    let snapshot: Image = core::result::unwrap(cloned); let input: View = snapshot.view();
    let row: i32 = 0; while (row < source.height) { let col: i32 = 0; while (col < source.width) {
        let pixel: Rgba = read(input,col,row); if (composite) { pixel = over(pixel,read(target,x+col,y+row)); } write(target,x+col,y+row,pixel); col += 1;
    } row += 1; } snapshot.destroy(); return core::result::Ok(source.width*source.height);
}
pub fn blit(target: View, x: i32, y: i32, source: View) -> core::result::Result<i32,Error> { return copy(target,x,y,source,false); }
pub fn source_over(target: View, x: i32, y: i32, source: View) -> core::result::Result<i32,Error> { return copy(target,x,y,source,true); }

// Unrounded alpha and color-times-alpha sums, never stored RGBA8 samples.
struct ResizeSum { r: u64, g: u64, b: u64, a: u64 }
struct LinearAxis { low: i32, high: i32, low_weight: u64, high_weight: u64 }
struct AreaShape { source_inner: i32, source_outer: i32, target_inner: i32, target_outer: i32, vertical: bool }

fn resize_zero() -> ResizeSum { return ResizeSum { r: 0, g: 0, b: 0, a: 0 }; }
fn resize_sample(pixel: Rgba) -> ResizeSum {
    let alpha: u64 = pixel.a as u64;
    return ResizeSum { r: (pixel.r as u64)*alpha, g: (pixel.g as u64)*alpha, b: (pixel.b as u64)*alpha, a: alpha };
}
fn resize_add(total: ResizeSum, value: ResizeSum, weight: u64) -> ResizeSum {
    return ResizeSum { r: total.r+value.r*weight, g: total.g+value.g*weight, b: total.b+value.b*weight, a: total.a+value.a*weight };
}
fn resize_pixel(total: ResizeSum, weight: u64) -> Rgba {
    if (total.a == 0) { return Rgba { r: 0, g: 0, b: 0, a: 0 }; }
    // Divide color by exact alpha, including when the emitted alpha rounds to 0.
    let half: u64 = total.a/2;
    return Rgba { r: ((total.r+half)/total.a) as u8, g: ((total.g+half)/total.a) as u8,
        b: ((total.b+half)/total.a) as u8, a: ((total.a+weight/2)/weight) as u8 };
}
fn resize_nearest(source: View, target: View) {
    let y: i32 = 0;
    while (y < target.height) {
        let sy: i32 = (((2*(y as u64)+1)*(source.height as u64))/(2*(target.height as u64))) as i32;
        let x: i32 = 0;
        while (x < target.width) {
            let sx: i32 = (((2*(x as u64)+1)*(source.width as u64))/(2*(target.width as u64))) as i32;
            write(target,x,y,read(source,sx,sy)); x += 1;
        }
        y += 1;
    }
}
fn resize_linear_axis(position: i32, source: i32, target: i32) -> LinearAxis {
    let denominator: u64 = 2*(target as u64);
    let center: u64 = (2*(position as u64)+1)*(source as u64);
    // Clamp before subtraction/division, so negative half-pixel coordinates
    // never rely on truncation toward zero. Every product fits below 2^59.
    if (center <= (target as u64)) { return LinearAxis { low: 0, high: 0, low_weight: denominator, high_weight: 0 }; }
    let shifted: u64 = center-(target as u64);
    let last: i32 = source-1;
    if (shifted >= (last as u64)*denominator) { return LinearAxis { low: last, high: last, low_weight: denominator, high_weight: 0 }; }
    let low: i32 = (shifted/denominator) as i32;
    let remainder: u64 = shifted%denominator;
    return LinearAxis { low: low, high: low+1, low_weight: denominator-remainder, high_weight: remainder };
}
fn resize_bilinear(source: View, target: View) {
    // The image byte bound makes this total weight less than 2^31; even
    // color*alpha*weight sums therefore fit well inside u64.
    let weight: u64 = 4*(target.width as u64)*(target.height as u64);
    let y: i32 = 0;
    while (y < target.height) {
        let rows: LinearAxis = resize_linear_axis(y,source.height,target.height);
        let x: i32 = 0;
        while (x < target.width) {
            let columns: LinearAxis = resize_linear_axis(x,source.width,target.width);
            let total: ResizeSum = resize_zero();
            total = resize_add(total,resize_sample(read(source,columns.low,rows.low)),columns.low_weight*rows.low_weight);
            total = resize_add(total,resize_sample(read(source,columns.high,rows.low)),columns.high_weight*rows.low_weight);
            total = resize_add(total,resize_sample(read(source,columns.low,rows.high)),columns.low_weight*rows.high_weight);
            total = resize_add(total,resize_sample(read(source,columns.high,rows.high)),columns.high_weight*rows.high_weight);
            write(target,x,y,resize_pixel(total,weight)); x += 1;
        }
        y += 1;
    }
}
fn resize_area_shape(source: View, width: i32, height: i32) -> AreaShape {
    let ix: u64 = (source.width as u64)+(width as u64)-(core::i32::gcd(source.width,width) as u64);
    let iy: u64 = (source.height as u64)+(height as u64)-(core::i32::gcd(source.height,height) as u64);
    let horizontal: u64 = (source.height as u64)*ix+(width as u64)*iy;
    let vertical: u64 = (source.width as u64)*iy+(height as u64)*ix;
    if (vertical < horizontal || (vertical == horizontal && height < width)) {
        return AreaShape { source_inner: source.height, source_outer: source.width, target_inner: height, target_outer: width, vertical: true };
    }
    return AreaShape { source_inner: source.width, source_outer: source.height, target_inner: width, target_outer: height, vertical: false };
}
fn resize_oriented_read(source: View, inner: i32, outer: i32, vertical: bool) -> Rgba {
    if (vertical) { return read(source,outer,inner); }
    return read(source,inner,outer);
}
fn resize_oriented_write(target: View, inner: i32, outer: i32, vertical: bool, pixel: Rgba) {
    if (vertical) { write(target,outer,inner,pixel); }
    else { write(target,inner,outer,pixel); }
}
fn resize_overlap(left: u64, right: u64, pixel: i32, scale: i32) -> u64 {
    let begin: u64 = (pixel as u64)*(scale as u64);
    let end: u64 = ((pixel as u64)+1)*(scale as u64);
    if (begin < left) { begin = left; }
    if (end > right) { end = right; }
    return end-begin;
}
fn resize_area_project(source: View, shape: AreaShape, outer: i32, begin: i32, count: i32, rows: [ResizeSum]) {
    let local: i32 = 0;
    while (local < count) {
        let position: i32 = begin+local;
        let left: u64 = (position as u64)*(shape.source_inner as u64);
        let right: u64 = ((position as u64)+1)*(shape.source_inner as u64);
        let first: i32 = (left/(shape.target_inner as u64)) as i32;
        let past: i32 = ((right-1)/(shape.target_inner as u64)+1) as i32;
        let total: ResizeSum = resize_zero(); let pixel: i32 = first;
        // Visit only this output interval's positive-overlap source pixels,
        // not the entire source row for every tile.
        while (pixel < past) {
            let weight: u64 = resize_overlap(left,right,pixel,shape.target_inner);
            total = resize_add(total,resize_sample(resize_oriented_read(source,pixel,outer,shape.vertical)),weight);
            pixel += 1;
        }
        rows[local] = total; local += 1;
    }
}
fn resize_area(source: View, target: View, shape: AreaShape, rows: [ResizeSum], tile: i32) {
    let weight: u64 = (source.width as u64)*(source.height as u64);
    let begin: i32 = 0;
    while (begin < shape.target_inner) {
        let count: i32 = shape.target_inner-begin; if (count > tile) { count = tile; }
        let cached: i32 = -1; let outer: i32 = 0;
        while (outer < shape.target_outer) {
            let local: i32 = 0;
            while (local < count) { rows[tile+local] = resize_zero(); local += 1; }
            let left: u64 = (outer as u64)*(shape.source_outer as u64);
            let right: u64 = ((outer as u64)+1)*(shape.source_outer as u64);
            let first: i32 = (left/(shape.target_outer as u64)) as i32;
            let past: i32 = ((right-1)/(shape.target_outer as u64)+1) as i32;
            let pixel: i32 = first;
            while (pixel < past) {
                // Adjacent output footprints share at most their boundary
                // source row. Cache it; each row is projected once per tile.
                if (pixel != cached) {
                    resize_area_project(source,shape,pixel,begin,count,rows);
                    cached = pixel;
                }
                let overlap: u64 = resize_overlap(left,right,pixel,shape.target_outer);
                local = 0;
                while (local < count) {
                    rows[tile+local] = resize_add(rows[tile+local],rows[local],overlap); local += 1;
                }
                pixel += 1;
            }
            local = 0;
            while (local < count) {
                resize_oriented_write(target,begin+local,outer,shape.vertical,resize_pixel(rows[tile+local],weight)); local += 1;
            }
            outer += 1;
        }
        begin += count;
    }
}
// Independent owner; all allocations finish before source pixels are sampled.
pub fn resize(source: View, width: i32, height: i32, filter: Filter) -> core::result::Result<Image,Error> {
    if (!valid(source)) { return core::result::Err(Error::Bounds); }
    let size: core::result::Result<i32,Error> = byte_len(width,height);
    if (core::result::is_err(size)) { return core::result::Err(core::result::unwrap_err(size)); }
    // Identity is byte-preserving even for hidden RGB beneath zero alpha.
    if (width == source.width && height == source.height) { return crop(source,0,0,width,height); }
    let kind: i32 = match (filter) { Filter::Nearest -> 0, Filter::Bilinear -> 1, Filter::Area -> 2 };
    let shape: AreaShape = resize_area_shape(source,width,height);
    let tile: i32 = shape.target_inner; if (tile > 256) { tile = 256; }
    let made: core::result::Result<Image,Error> = new(width,height,Rgba { r: 0, g: 0, b: 0, a: 0 });
    if (core::result::is_err(made)) { return made; }
    let result: Image = core::result::unwrap(made);
    if (kind == 0) { resize_nearest(source,result.view()); }
    else {
        if (kind == 1) { resize_bilinear(source,result.view()); }
        else {
            let scratch: alloc::vec::Vec<ResizeSum> = alloc::vec::new();
            let reserved: core::result::Result<i32,alloc::vec::Error> = scratch.try_resize(2*tile,resize_zero());
            if (core::result::is_err(reserved)) { scratch.destroy(); result.destroy(); return core::result::Err(Error::AllocationFailed); }
            resize_area(source,result.view(),shape,scratch.as_slice(),tile); scratch.destroy();
        }
    }
    return core::result::Ok(result);
}
