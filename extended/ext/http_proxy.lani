// Reverse proxy for ext::http_service's family: one std::event (epoll)
// loop accepts HTTP/1.1 and prior-knowledge h2c clients and forwards each
// request to an HTTP/1.1 upstream chosen by path prefix. Upstream
// connections are kept in per-upstream keep-alive pools. Headers are
// rewritten by ext::http_rewrite (hop-by-hop fields dropped,
// X-Forwarded-For and Via added); bodies stream both ways through
// fixed-size buffers with ext::http_body, never held whole, with
// backpressure: a side stops reading while the other side's output is
// full. Connect, response, inactivity, head and idle timeouts apply.
module ext::http_proxy;
import alloc::vec;
import core::io;
import core::mem;
import core::net;
import core::option;
import core::result;
import core::slice;
import core::time;
import ext::hpack;
import ext::http;
import ext::http2;
import ext::http2_frame;
import ext::http2_server;
import ext::http_body;
import ext::http_rewrite;
import std::clock;
import std::event;
import std::linux;
import std::socket;

pub enum Error { Io(core::io::Error), Event(std::event::Error), Clock, AllocationFailed, InvalidState }
// limits: request and response head limits (body_bytes only bounds a
// single Content-Length). buffer_bytes: each connection's input buffer and
// the output backlog at which the other side stops reading.
// connect_timeout_ms: upstream connect; response_timeout_ms: from the
// request head being sent to the response head; io_timeout_ms: a body
// making no progress either way; head_timeout_ms/idle_timeout_ms: client
// heads and keep-alive; pool_idle_ms/max_idle: idle upstream connections
// kept per upstream; upstream_connections: open connections per upstream
// (further requests queue for one); max_requests: per client connection; via: this
// proxy's Via pseudonym; h2: accept h2c clients; h2_streams and
// h2_stream_window: their concurrent streams and per-stream window.
pub struct Options { limits: ext::http::Limits, buffer_bytes: i32, connect_timeout_ms: i32, response_timeout_ms: i32, io_timeout_ms: i32, head_timeout_ms: i32, idle_timeout_ms: i32, pool_idle_ms: i32, max_idle: i32, upstream_connections: i32, max_requests: i32, via: core::slice::View<u8>, h2: bool, h2_streams: i32, h2_stream_window: i32 }
pub struct Stats { clients: i32, h2_clients: i32, requests: i32, h2_requests: i32, responses: i32, upstream_connects: i32, reused: i32, retries: i32, bad_gateway: i32, gateway_timeout: i32, rejected: i32, aborted: i32, peak_clients: i32 }

struct Client { socket: std::socket::Socket, peer: core::net::SocketAddr, closed: bool, h2: bool, phase: i32, input: alloc::vec::Vec<u8>, filled: i32, output: alloc::vec::Vec<u8>, sent: i32, deadline: core::time::Deadline, keep_alive: bool, requests: i32, exchange: i32, address: alloc::vec::Vec<u8>, streams: alloc::vec::Vec<i32>, interest: u32, eof: bool, shut: bool, live_at: i32 }
struct Link { socket: std::socket::Socket, upstream: i32, state: i32, input: alloc::vec::Vec<u8>, filled: i32, output: alloc::vec::Vec<u8>, sent: i32, deadline: core::time::Deadline, exchange: i32, reused: bool, got: bool, interest: u32, eof: bool }
struct Exchange { active: bool, client: i32, stream: i32, link: i32, upstream: i32, method: alloc::vec::Vec<u8>, head: alloc::vec::Vec<u8>, request: ext::http_body::Framer, req_done: bool, chunk_out: bool, started: bool, response: ext::http_body::Framer, resp_done: bool, reusable: bool, replayable: bool, retried: bool, deadline: core::time::Deadline, waiting: bool, queued: bool }
struct Route { prefix: alloc::vec::Vec<u8>, upstream: i32 }
pub struct Proxy { events: std::event::Loop, listener: std::socket::Socket, listening: bool, options: Options, upstreams: alloc::vec::Vec<core::net::SocketAddr>, routes: alloc::vec::Vec<Route>, clients: alloc::vec::Vec<Client>, engines: alloc::vec::Vec<core::option::Option<ext::http2_server::Connection>>, links: alloc::vec::Vec<Link>, exchanges: alloc::vec::Vec<Exchange>, free_exchanges: alloc::vec::Vec<i32>, idle: alloc::vec::Vec<i32>, queue: alloc::vec::Vec<i32>, live: alloc::vec::Vec<i32>, active: i32, stats: Stats, now: core::time::Instant, sweep_at: core::time::Deadline, scratch_fields: alloc::vec::Vec<ext::hpack::Header>, scratch: alloc::vec::Vec<u8>, closed: bool }

// Client phases.
const C_FREE: i32 = 0;
const C_IDLE: i32 = 1;
const C_HEAD: i32 = 2;
const C_BUSY: i32 = 3;
const C_CLOSING: i32 = 4;
const C_H2: i32 = 5;
// Link states.
const L_FREE: i32 = 0;
const L_CONNECTING: i32 = 1;
const L_BUSY: i32 = 2;
const L_IDLE: i32 = 3;
const LINK_BASE: u64 = 1048576;
const LISTENER: u64 = 4294967295;
const READ: u32 = 1;
const WRITE: u32 = 4;

fn literal(s: str, n: i32) -> core::slice::View<u8> { let raw: [u8] = core::mem::typed_slice_from_raw_parts<u8>(core::mem::string_data_ptr(s), n); return core::slice::View { values: raw, start: 0, length: n }; }
fn view(v: alloc::vec::Vec<u8>, start: i32, end: i32) -> core::slice::View<u8> { return core::slice::View { values: v.as_slice(), start: start, length: end - start }; }
fn same(a: core::slice::View<u8>, b: core::slice::View<u8>) -> bool { if (a.len() != b.len()) { return false; } let i: i32 = 0; while (i < a.len()) { if (a.values[a.start + i] != b.values[b.start + i]) { return false; } i += 1; } return true; }

pub fn default_options() -> Options {
    let limits: ext::http::Limits = ext::http::Limits { head_bytes: 16384, line_bytes: 8192, headers: 100, body_bytes: 2147483647, trailer_bytes: 16384, trailers: 100, chunks: 2147483647 };
    return Options { limits: limits, buffer_bytes: 65536, connect_timeout_ms: 2000, response_timeout_ms: 10000, io_timeout_ms: 10000, head_timeout_ms: 5000, idle_timeout_ms: 5000, pool_idle_ms: 4000, max_idle: 64, upstream_connections: 128, max_requests: 1000, via: literal("lanius", 6), h2: true, h2_streams: 100, h2_stream_window: 65535 };
}
fn options_valid(o: Options) -> bool {
    return o.limits.head_bytes > 0 && o.buffer_bytes >= o.limits.head_bytes && o.buffer_bytes <= 16777216 && o.connect_timeout_ms >= 0 && o.response_timeout_ms >= 0
        && o.io_timeout_ms >= 0 && o.head_timeout_ms >= 0 && o.idle_timeout_ms >= 0 && o.pool_idle_ms >= 0 && o.max_idle >= 0 && o.upstream_connections > 0 && o.max_requests > 0 && o.via.len() > 0
        && o.h2_streams > 0 && o.h2_stream_window >= 65535;
}
fn now_instant() -> core::result::Result<core::time::Instant,Error> {
    let now: core::result::Result<core::time::Instant,std::clock::Error> = std::clock::monotonic_now(); if (now.is_err()) { return core::result::Err(Error::Clock); } return core::result::Ok(now.unwrap());
}
fn after(now: core::time::Instant, ms: i32) -> core::time::Deadline {
    let d: core::result::Result<core::time::Deadline,core::time::Error> = core::time::deadline_after(now, core::time::from_millis(ms as u64));
    if (d.is_err()) { return core::time::Deadline { instant: now }; } return d.unwrap();
}
fn earlier(a: core::time::Deadline, b: core::time::Deadline) -> core::time::Deadline { if (a.instant.compare(b.instant) <= 0) { return a; } return b; }
fn would_block(error: core::io::Error) -> bool { return match(error) { core::io::Error::WouldBlock -> true, core::io::Error::Interrupted -> true, _ -> false }; }

// Direct sendto/recvfrom on a Vec's storage (std::socket stages each call
// through a 1 KiB copy).
fn host_io(result: core::result::Result<i64,std::linux::Error>, limit: i32) -> core::result::Result<i32,core::io::Error> {
    if (result.is_err()) { return core::result::Err(match(result.unwrap_err()) { std::linux::Error::System(n) -> match(n) { 11 -> core::io::Error::WouldBlock, 4 -> core::io::Error::Interrupted, _ -> core::io::Error::Host(n) }, _ -> core::io::Error::InvalidInput }); }
    let n: i64 = result.unwrap(); if (n < 0 || n > limit as i64) { return core::result::Err(core::io::Error::InvalidCount); } return core::result::Ok(n as i32);
}
fn vec_send(socket: std::socket::Socket, buffer: alloc::vec::Vec<u8>, start: i32, count: i32) -> core::result::Result<i32,core::io::Error> {
    if (socket.handle < 0) { return core::result::Err(core::io::Error::Host(9)); }
    if (start < 0 || count <= 0 || start > buffer.len() - count) { return core::result::Err(core::io::Error::InvalidInput); }
    let args: [std::linux::Argument;6] = [std::linux::Argument::Word(socket.handle as i64),std::linux::Argument::Address(buffer.storage + start),std::linux::Argument::Word(count as i64),std::linux::Argument::Word(16448),std::linux::Argument::Word(0),std::linux::Argument::Word(0)];
    return host_io(std::linux::call(44,core::slice::view(args,6).unwrap()),count);
}
fn vec_receive(socket: std::socket::Socket, buffer: alloc::vec::Vec<u8>, start: i32, count: i32) -> core::result::Result<i32,core::io::Error> {
    if (socket.handle < 0) { return core::result::Err(core::io::Error::Host(9)); }
    if (start < 0 || count <= 0 || start > buffer.len() - count) { return core::result::Err(core::io::Error::InvalidInput); }
    let args: [std::linux::Argument;6] = [std::linux::Argument::Word(socket.handle as i64),std::linux::Argument::Address(buffer.storage + start),std::linux::Argument::Word(count as i64),std::linux::Argument::Word(64),std::linux::Argument::Word(0),std::linux::Argument::Word(0)];
    return host_io(std::linux::call(45,core::slice::view(args,6).unwrap()),count);
}
// Drop the first count bytes of a buffer whose live bytes end at filled.
fn shift(v: alloc::vec::Vec<u8>, count: i32, filled: i32) -> i32 {
    if (count <= 0) { return filled; }
    if (count < filled) { core::slice::copy_within(v.as_slice(), v.len(), count, filled, 0); }
    return filled - count;
}
fn closed_client(o: Options) -> Client {
    let placeholder: core::net::SocketAddr = core::net::SocketAddr::V4(core::net::SocketAddrV4 { address: core::net::ipv4(0,0,0,0), port: 0 });
    let now: core::time::Instant = core::time::Instant { ticks: core::time::Duration { seconds: 0, nanos: 0 } };
    return Client { socket: std::socket::Socket { handle: -1, domain: 2, datagram: false }, peer: placeholder, closed: true, h2: false, phase: C_FREE, input: alloc::vec::new<u8>(), filled: 0, output: alloc::vec::new<u8>(), sent: 0, deadline: core::time::Deadline { instant: now }, keep_alive: false, requests: 0, exchange: -1, address: alloc::vec::new<u8>(), streams: alloc::vec::new<i32>(), interest: 0, eof: false, shut: false, live_at: -1 };
}

// The listener is borrowed (its descriptor stays the caller's); it must be
// a nonblocking listening TCP socket. Add upstreams before serving.
pub fn proxy(listener: &std::socket::Socket, options: Options, max_clients: i32) -> core::result::Result<Proxy,Error> {
    if (!options_valid(options) || max_clients < 1 || max_clients > 4096) { return core::result::Err(Error::InvalidState); }
    let fd: core::option::Option<i32> = listener.raw_handle(); if (fd.is_none()) { return core::result::Err(Error::InvalidState); }
    let now: core::result::Result<core::time::Instant,Error> = now_instant(); if (now.is_err()) { return core::result::Err(now.unwrap_err()); }
    let created: core::result::Result<std::event::Loop,std::event::Error> = std::event::create(); if (created.is_err()) { return core::result::Err(Error::Event(created.unwrap_err())); }
    let events: std::event::Loop = created.unwrap();
    if (events.add(fd.unwrap(), std::event::readable(), LISTENER).is_err()) { events.force_close(); return core::result::Err(Error::InvalidState); }
    let stats: Stats = Stats { clients: 0, h2_clients: 0, requests: 0, h2_requests: 0, responses: 0, upstream_connects: 0, reused: 0, retries: 0, bad_gateway: 0, gateway_timeout: 0, rejected: 0, aborted: 0, peak_clients: 0 };
    let p: Proxy = Proxy { events: events, listener: std::socket::Socket { handle: fd.unwrap(), domain: listener.domain, datagram: false }, listening: true, options: options,
        upstreams: alloc::vec::new<core::net::SocketAddr>(), routes: alloc::vec::new<Route>(), clients: alloc::vec::new<Client>(), engines: alloc::vec::new<core::option::Option<ext::http2_server::Connection>>(),
        links: alloc::vec::new<Link>(), exchanges: alloc::vec::new<Exchange>(), free_exchanges: alloc::vec::new<i32>(), idle: alloc::vec::new<i32>(), queue: alloc::vec::new<i32>(), live: alloc::vec::new<i32>(), active: 0, stats: stats, now: now.unwrap(), sweep_at: after(now.unwrap(), 0),
        scratch_fields: alloc::vec::new<ext::hpack::Header>(), scratch: alloc::vec::new<u8>(), closed: false };
    let i: i32 = 0;
    while (i < max_clients) {
        if (p.clients.try_push(closed_client(options)).is_err() || p.engines.try_push(core::option::None()).is_err()) { p.close(); return core::result::Err(Error::AllocationFailed); }
        i += 1;
    }
    return core::result::Ok(p);
}

pub impl Proxy {
    pub fn borrow(&self) -> &Proxy { return self; }
    pub fn stats(&self) -> Stats { return self.stats; }
    // Open client connections.
    pub fn active(&self) -> i32 { return self.active; }
    // Upstream connections, idle ones included.
    pub fn upstream_connections(&self) -> i32 { let n: i32 = 0; let i: i32 = 0; while (i < self.links.len()) { if (self.links.at(i).state != L_FREE) { n += 1; } i += 1; } return n; }
    pub fn idle_connections(&self) -> i32 { return self.idle.len(); }
    // Register an upstream; returns its id. Upstream 0 serves every path no
    // route claims.
    pub fn add_upstream(&self, address: core::net::SocketAddr) -> core::result::Result<i32,Error> {
        if (self.upstreams.try_push(address).is_err()) { return core::result::Err(Error::AllocationFailed); } return core::result::Ok(self.upstreams.len() - 1);
    }
    // Requests whose path starts with prefix go to upstream (the longest
    // matching prefix wins).
    pub fn route(&self, prefix: core::slice::View<u8>, upstream: i32) -> core::result::Result<i32,Error> {
        if (upstream < 0 || upstream >= self.upstreams.len()) { return core::result::Err(Error::InvalidState); }
        let copy: alloc::vec::Vec<u8> = alloc::vec::new<u8>(); if (copy.try_extend(prefix).is_err()) { copy.destroy(); return core::result::Err(Error::AllocationFailed); }
        if (self.routes.try_push(Route { prefix: copy, upstream: upstream }).is_err()) { copy.destroy(); return core::result::Err(Error::AllocationFailed); }
        return core::result::Ok(self.routes.len() - 1);
    }
    fn pick(&self, target: core::slice::View<u8>) -> i32 {
        let best: i32 = 0; let length: i32 = -1; let i: i32 = 0;
        while (i < self.routes.len()) {
            let r: Route = self.routes.at(i); i += 1;
            let p: core::slice::View<u8> = r.prefix.as_view();
            if (p.len() > length && p.len() <= target.len() && same(core::slice::View { values: target.values, start: target.start, length: p.len() }, p)) { best = r.upstream; length = p.len(); }
        }
        return best;
    }
    // Close everything: clients, upstream connections and the loop. The
    // listener stays open.
    pub fn close(&self) -> core::result::Result<i32,Error> {
        if (self.closed) { return core::result::Ok(0); }
        self.closed = true;
        let i: i32 = 0; while (i < self.clients.len()) { self.drop_client(i); let c: Client = self.clients.at(i); c.input.destroy(); c.output.destroy(); c.address.destroy(); c.streams.destroy(); i += 1; }
        i = 0; while (i < self.links.len()) { self.drop_link(i); i += 1; }
        i = 0; while (i < self.exchanges.len()) { let x: Exchange = self.exchanges.at(i); x.method.destroy(); x.head.destroy(); i += 1; }
        i = 0; while (i < self.routes.len()) { let r: Route = self.routes.at(i); r.prefix.destroy(); i += 1; }
        if (self.listening) { let lf: i32 = self.listener.raw_handle().unwrap(); self.events.remove(lf); self.listening = false; }
        self.clients.destroy(); self.engines.destroy(); self.links.destroy(); self.exchanges.destroy(); self.free_exchanges.destroy(); self.idle.destroy(); self.queue.destroy(); self.live.destroy(); self.routes.destroy(); self.upstreams.destroy();
        self.scratch_fields.destroy(); self.scratch.destroy();
        let closed: core::result::Result<i32,std::event::Error> = self.events.close(); if (closed.is_err()) { return core::result::Err(Error::Event(closed.unwrap_err())); }
        return core::result::Ok(0);
    }
}

// ---- Connections: readiness, buffers, the upstream pool ----
impl Proxy {
    fn watch(&self, fd: i32, token: u64, old: u32, bits: u32) -> u32 {
        if (old == bits) { return old; }
        if (self.events.modify(fd, std::event::Interest { bits: bits }, token).is_ok()) { return bits; }
        return old;
    }
    fn backlog(&self, xi: i32) -> i32 {
        let x: Exchange = self.exchanges.at(xi);
        if (x.stream == 0) { let c: Client = self.clients.at(x.client); return c.output.len() - c.sent; }
        let engine: core::option::Option<ext::http2_server::Connection> = self.engines.at(x.client); if (engine.is_none()) { return 0; }
        let e: ext::http2_server::Connection = engine.unwrap(); let c: Client = self.clients.at(x.client);
        return e.output().len() + e.unsent(x.stream) + c.output.len() - c.sent;
    }
    fn free_links(&self) -> i32 { let n: i32 = 0; let i: i32 = 0; while (i < self.links.len()) { if (self.links.at(i).state == L_FREE) { n += 1; } i += 1; } return n; }
    fn link_backlog(&self, li: i32) -> i32 { let l: Link = self.links.at(li); return l.output.len() - l.sent; }
    // Pick each descriptor's readiness from what its buffers can take.
    fn refresh(&self) {
        let k: i32 = 0;
        while (k < self.live.len()) {
            let i: i32 = self.live.at(k); k += 1;
            let c: Client = self.clients.at(i);
            if (!c.closed) {
                let bits: u32 = 0;
                if (c.sent < c.output.len()) { bits = bits | WRITE; }
                if (c.h2) {
                    let engine: core::option::Option<ext::http2_server::Connection> = self.engines.at(i);
                    if (engine.is_some() && engine.unwrap().output().len() > 0) { bits = bits | WRITE; }
                    if (!c.eof && c.output.len() - c.sent < self.options.buffer_bytes) { bits = bits | READ; }
                } else {
                    if (!c.eof && (c.phase == C_IDLE || c.phase == C_HEAD) && c.filled < c.input.len()) { bits = bits | READ; }
                    if (!c.eof && c.phase == C_CLOSING && c.shut) { bits = bits | READ; }
                    if (!c.eof && c.phase == C_BUSY && c.exchange >= 0 && c.filled < c.input.len()) {
                        let x: Exchange = self.exchanges.at(c.exchange);
                        if (!x.req_done && (x.link < 0 || self.link_backlog(x.link) < self.options.buffer_bytes)) { bits = bits | READ; }
                    }
                }
                if (bits != c.interest) { c.interest = self.watch(c.socket.handle, i as u64, c.interest, bits); self.clients.set(i, c); }
            }
        }
        let i: i32 = 0;
        while (i < self.links.len()) {
            let l: Link = self.links.at(i);
            if (l.state != L_FREE) {
                let bits: u32 = 0;
                if (l.state == L_CONNECTING || l.sent < l.output.len()) { bits = bits | WRITE; }
                if (l.state == L_IDLE) { bits = bits | READ; }
                if (l.state == L_BUSY && !l.eof && l.exchange >= 0 && l.filled < l.input.len()) {
                    let x: Exchange = self.exchanges.at(l.exchange);
                    if (!x.resp_done && (!x.started || self.backlog(l.exchange) < self.options.buffer_bytes)) { bits = bits | READ; }
                }
                if (bits != l.interest) { l.interest = self.watch(l.socket.handle, LINK_BASE + (i as u64), l.interest, bits); self.links.set(i, l); }
            }
            i += 1;
        }
    }
    fn new_exchange(&self) -> i32 {
        if (self.free_exchanges.len() > 0) { return self.free_exchanges.pop().unwrap(); }
        let now: core::time::Instant = self.now;
        let x: Exchange = Exchange { active: false, client: -1, stream: 0, link: -1, upstream: 0, method: alloc::vec::new<u8>(), head: alloc::vec::new<u8>(), request: ext::http_body::empty(), req_done: true, chunk_out: false, started: false, response: ext::http_body::empty(), resp_done: false, reusable: false, replayable: false, retried: false, deadline: core::time::Deadline { instant: now }, waiting: false, queued: false };
        if (self.exchanges.try_push(x).is_err()) { return -1; }
        return self.exchanges.len() - 1;
    }
    fn free_exchange(&self, xi: i32) {
        let x: Exchange = self.exchanges.at(xi); if (!x.active) { return; }
        x.active = false; x.link = -1; x.client = -1; x.queued = false; x.method.clear(); x.head.clear();
        self.exchanges.set(xi, x); self.free_exchanges.try_push(xi);
    }
    // Forget an exchange whose client is going away: its upstream
    // connection is closed (the response may be half read).
    fn abandon(&self, xi: i32) {
        let x: Exchange = self.exchanges.at(xi); if (!x.active) { return; }
        if (x.link >= 0) { self.drop_link(x.link); }
        self.free_exchange(xi);
    }
    fn drop_link(&self, li: i32) {
        let l: Link = self.links.at(li); if (l.state == L_FREE) { return; }
        if (l.state == L_IDLE) { let k: i32 = self.idle.index_of(li); if (k >= 0) { self.idle.remove(k); } }
        if (l.socket.handle >= 0) { self.events.remove(l.socket.handle); l.socket.close(); }
        l.input.destroy(); l.output.destroy(); l.input = alloc::vec::new<u8>(); l.output = alloc::vec::new<u8>();
        l.state = L_FREE; l.exchange = -1; l.filled = 0; l.sent = 0; l.interest = 0; l.eof = false;
        self.links.set(li, l);
    }
    fn drop_client(&self, slot: i32) {
        let c: Client = self.clients.at(slot); if (c.closed) { return; }
        if (c.exchange >= 0) { self.abandon(c.exchange); }
        let k: i32 = 0; while (k < c.streams.len()) { self.abandon(c.streams.at(k)); k += 1; }
        let engine: core::option::Option<ext::http2_server::Connection> = self.engines.at(slot);
        if (engine.is_some()) { let e: ext::http2_server::Connection = engine.unwrap(); e.destroy(); self.engines.set(slot, core::option::None()); }
        c = self.clients.at(slot);
        if (c.socket.handle >= 0) { self.events.remove(c.socket.handle); c.socket.close(); }
        c.input.destroy(); c.output.destroy(); c.address.destroy(); c.streams.destroy();
        c.input = alloc::vec::new<u8>(); c.output = alloc::vec::new<u8>(); c.address = alloc::vec::new<u8>(); c.streams = alloc::vec::new<i32>();
        c.closed = true; c.phase = C_FREE; c.exchange = -1; c.filled = 0; c.sent = 0; c.interest = 0; c.h2 = false; c.eof = false; c.shut = false;
        let at: i32 = c.live_at; c.live_at = -1; self.clients.set(slot, c); self.active -= 1;
        if (at >= 0 && at < self.live.len()) {
            self.live.swap_remove(at);
            if (at < self.live.len()) { let moved: i32 = self.live.at(at); let m: Client = self.clients.at(moved); m.live_at = at; self.clients.set(moved, m); }
        }
        if (!self.listening && !self.closed) { let lf: i32 = self.listener.raw_handle().unwrap(); if (self.events.add(lf, std::event::readable(), LISTENER).is_ok()) { self.listening = true; } }
    }
    // A pooled connection to upstream, or a new one (-1 when connect fails
    // at once).
    fn take_link(&self, upstream: i32) -> i32 {
        let k: i32 = self.idle.len() - 1;
        while (k >= 0) {
            let li: i32 = self.idle.at(k); let l: Link = self.links.at(li);
            if (l.upstream == upstream && l.state == L_IDLE) {
                self.idle.remove(k); l.state = L_BUSY; l.reused = true; l.got = false; l.exchange = -1; self.links.set(li, l); self.stats.reused += 1; return li;
            }
            k -= 1;
        }
        return self.connect(upstream);
    }
    fn connect(&self, upstream: i32) -> i32 {
        let address: core::net::SocketAddr = self.upstreams.at(upstream);
        let family: std::socket::Family = match (address) { core::net::SocketAddr::V6(a) -> std::socket::Family::Ipv6, _ -> std::socket::Family::Ipv4 };
        let made: core::result::Result<std::socket::Socket,core::io::Error> = std::socket::create(family, std::socket::Kind::Tcp, true); if (made.is_err()) { return -1; }
        let s: std::socket::Socket = made.unwrap(); s.set_option(std::socket::Setting::NoDelay, 1);
        let started: core::result::Result<std::socket::Connection,core::io::Error> = s.connect(address); if (started.is_err()) { s.close(); return -1; }
        let pending: bool = match (started.unwrap()) { std::socket::Connection::InProgress -> true, _ -> false };
        let input: alloc::vec::Vec<u8> = alloc::vec::new<u8>(); if (input.try_resize(self.options.buffer_bytes, 0).is_err()) { s.close(); return -1; }
        let li: i32 = 0; while (li < self.links.len() && self.links.at(li).state != L_FREE) { li += 1; }
        let state: i32 = L_BUSY; if (pending) { state = L_CONNECTING; }
        let l: Link = Link { socket: s, upstream: upstream, state: state, input: input, filled: 0, output: alloc::vec::new<u8>(), sent: 0, deadline: after(self.now, self.options.connect_timeout_ms), exchange: -1, reused: false, got: false, interest: WRITE, eof: false };
        if (li == self.links.len()) { if (self.links.try_push(l).is_err()) { input.destroy(); s.close(); return -1; } } else { self.links.set(li, l); }
        if (self.events.add(s.handle, std::event::Interest { bits: WRITE }, LINK_BASE + (li as u64)).is_err()) { self.drop_link(li); return -1; }
        self.stats.upstream_connects += 1;
        return li;
    }
    // After a response: keep the connection for the next request when it
    // is reusable and the pool has room; otherwise close it.
    fn release_link(&self, li: i32, reusable: bool) {
        let l: Link = self.links.at(li);
        let pooled: i32 = 0; let k: i32 = 0; while (k < self.idle.len()) { if (self.links.at(self.idle.at(k)).upstream == l.upstream) { pooled += 1; } k += 1; }
        if (!reusable || l.eof || l.filled > 0 || l.sent < l.output.len() || pooled >= self.options.max_idle) { self.drop_link(li); return; }
        l.state = L_IDLE; l.exchange = -1; l.output.clear(); l.sent = 0; l.deadline = after(self.now, self.options.pool_idle_ms);
        self.links.set(li, l); self.idle.try_push(li);
    }
    // Send buffered output until the socket would block. False on a send
    // error. An h2 client's engine output is moved into its buffer first.
    fn flush_client(&self, slot: i32) -> bool {
        let c: Client = self.clients.at(slot); if (c.closed) { return true; }
        if (c.h2) {
            let engine: core::option::Option<ext::http2_server::Connection> = self.engines.at(slot);
            if (engine.is_some()) {
                let e: ext::http2_server::Connection = engine.unwrap(); let out: core::slice::View<u8> = e.output();
                if (out.len() > 0 && c.output.len() - c.sent < self.options.buffer_bytes) {
                    if (c.output.try_extend(out).is_err()) { return false; }
                    e.sent(out.len()); self.engines.set(slot, core::option::Some(e));
                }
            }
        }
        let ok: bool = true; let calls: i32 = 64;
        while (c.sent < c.output.len() && calls > 0) {
            calls -= 1;
            let got: core::result::Result<i32,core::io::Error> = vec_send(c.socket, c.output, c.sent, c.output.len() - c.sent);
            if (got.is_err()) { ok = would_block(got.unwrap_err()); break; }
            c.sent += got.unwrap();
        }
        if (c.sent == c.output.len()) { c.output.clear(); c.sent = 0; }
        if (c.sent > 65536 && c.sent * 2 > c.output.len()) { let left: i32 = shift(c.output, c.sent, c.output.len()); c.output.truncate(left); c.sent = 0; }
        self.clients.set(slot, c); return ok;
    }
    fn flush_link(&self, li: i32) -> bool {
        let l: Link = self.links.at(li); if (l.state == L_FREE || l.state == L_CONNECTING) { return true; }
        let ok: bool = true; let calls: i32 = 64;
        while (l.sent < l.output.len() && calls > 0) {
            calls -= 1;
            let got: core::result::Result<i32,core::io::Error> = vec_send(l.socket, l.output, l.sent, l.output.len() - l.sent);
            if (got.is_err()) { ok = would_block(got.unwrap_err()); break; }
            l.sent += got.unwrap();
        }
        if (l.sent == l.output.len()) { l.output.clear(); l.sent = 0; }
        if (l.sent > 65536 && l.sent * 2 > l.output.len()) { let left: i32 = shift(l.output, l.sent, l.output.len()); l.output.truncate(left); l.sent = 0; }
        self.links.set(li, l); return ok;
    }
    // Read what fits into the input buffer. Returns bytes read, or -1 on a
    // receive error (EOF sets eof).
    fn read_client(&self, slot: i32) -> i32 {
        let c: Client = self.clients.at(slot); let total: i32 = 0; let calls: i32 = 16;
        while (!c.eof && c.filled < c.input.len() && calls > 0) {
            calls -= 1;
            let got: core::result::Result<i32,core::io::Error> = vec_receive(c.socket, c.input, c.filled, c.input.len() - c.filled);
            if (got.is_err()) { if (would_block(got.unwrap_err())) { break; } self.clients.set(slot, c); return -1; }
            let n: i32 = got.unwrap(); if (n == 0) { c.eof = true; break; }
            c.filled += n; total += n;
        }
        self.clients.set(slot, c); return total;
    }
    fn read_link(&self, li: i32) -> i32 {
        let l: Link = self.links.at(li); let total: i32 = 0; let calls: i32 = 16;
        while (!l.eof && l.filled < l.input.len() && calls > 0) {
            calls -= 1;
            let got: core::result::Result<i32,core::io::Error> = vec_receive(l.socket, l.input, l.filled, l.input.len() - l.filled);
            if (got.is_err()) { if (would_block(got.unwrap_err())) { break; } self.links.set(li, l); return -1; }
            let n: i32 = got.unwrap(); if (n == 0) { l.eof = true; break; }
            l.filled += n; total += n; l.got = true;
        }
        self.links.set(li, l); return total;
    }
}

// ---- Exchanges: one proxied request and its response ----
fn status_text(status: i32) -> core::slice::View<u8> {
    if (status == 400) { return literal("400 Bad Request", 15); }
    if (status == 408) { return literal("408 Request Timeout", 19); }
    if (status == 431) { return literal("431 Request Header Fields Too Large", 35); }
    if (status == 501) { return literal("501 Not Implemented", 19); }
    if (status == 504) { return literal("504 Gateway Timeout", 19); }
    if (status == 505) { return literal("505 HTTP Version Not Supported", 30); }
    return literal("502 Bad Gateway", 15);
}
fn put_number(out: &alloc::vec::Vec<u8>, value: i32) { if (value >= 10) { put_number(out, value / 10); } out.try_push((48 + value % 10) as u8); }
// A complete small HTTP/1.1 error response.
fn error_response(out: &alloc::vec::Vec<u8>, status: i32, keep_alive: bool, via: core::slice::View<u8>) -> bool {
    let text: core::slice::View<u8> = status_text(status);
    out.try_extend(literal("HTTP/1.1 ", 9)); out.try_extend(text); out.try_extend(literal("\r\nContent-Type: text/plain\r\nContent-Length: ", 44));
    put_number(out, text.len() + 1); out.try_extend(literal("\r\nVia: 1.1 ", 11)); out.try_extend(via);
    if (keep_alive) { out.try_extend(literal("\r\nConnection: keep-alive\r\n\r\n", 28)); } else { out.try_extend(literal("\r\nConnection: close\r\n\r\n", 23)); }
    out.try_extend(text); return out.try_push(10).is_ok();
}
fn framer_for(kind: ext::http::BodyKind, length: i32, limits: ext::http::Limits) -> ext::http_body::Framer {
    return match (kind) {
        ext::http::BodyKind::Fixed -> ext::http_body::fixed(length as u64),
        ext::http::BodyKind::Chunked -> ext::http_body::chunked(limits.line_bytes, limits.trailer_bytes),
        ext::http::BodyKind::Close -> ext::http_body::until_close(),
        _ -> ext::http_body::empty()
    };
}
fn connection_lists(head: ext::http::Head, token: core::slice::View<u8>) -> bool {
    let cursor: ext::http::Fields = head.headers();
    while (true) {
        let next: core::option::Option<ext::http::Field> = cursor.next(); if (next.is_none()) { return false; }
        let f: ext::http::Field = next.unwrap();
        if (ext::http::equal_name(f.name, literal("connection", 10)) && ext::http_rewrite::lists(f.value, token)) { return true; }
    }
    return false;
}

impl Proxy {
    fn forward(&self, slot: i32) -> ext::http_rewrite::Forward {
        let c: Client = self.clients.at(slot);
        return ext::http_rewrite::Forward { client: c.address.as_view(), via: self.options.via, proto: literal("http", 4) };
    }
    fn has_idle(&self, upstream: i32) -> bool { let k: i32 = 0; while (k < self.idle.len()) { if (self.links.at(self.idle.at(k)).upstream == upstream) { return true; } k += 1; } return false; }
    fn busy(&self, upstream: i32) -> i32 { let n: i32 = 0; let i: i32 = 0; while (i < self.links.len()) { let l: Link = self.links.at(i); if (l.upstream == upstream && (l.state == L_BUSY || l.state == L_CONNECTING)) { n += 1; } i += 1; } return n; }
    // Bind exchange xi to an upstream connection and queue its head; with
    // upstream_connections in use and none idle, wait in the queue (the
    // response timeout runs meanwhile).
    fn dispatch(&self, xi: i32) -> bool {
        let x: Exchange = self.exchanges.at(xi);
        if (!self.has_idle(x.upstream) && self.busy(x.upstream) >= self.options.upstream_connections) {
            if (!x.queued) { if (self.queue.try_push(xi).is_err()) { return false; } }
            x.queued = true; x.waiting = true; x.deadline = after(self.now, self.options.response_timeout_ms); self.exchanges.set(xi, x);
            return true;
        }
        x.queued = false; self.exchanges.set(xi, x);
        let li: i32 = self.take_link(x.upstream); if (li < 0) { return false; }
        let l: Link = self.links.at(li); l.exchange = xi;
        if (l.output.try_extend(x.head.as_view()).is_err()) { self.links.set(li, l); self.drop_link(li); return false; }
        self.links.set(li, l);
        x.link = li; x.waiting = true; x.deadline = after(self.now, self.options.response_timeout_ms); self.exchanges.set(xi, x);
        return true;
    }
    // An upstream connection failed: retry a replayable request once on a
    // fresh connection when a pooled one turned out stale, else answer 502.
    fn link_failed(&self, li: i32) {
        let l: Link = self.links.at(li); let xi: i32 = l.exchange;
        let stale: bool = l.reused && !l.got;
        self.drop_link(li);
        if (xi < 0) { return; }
        let x: Exchange = self.exchanges.at(xi); x.link = -1; self.exchanges.set(xi, x);
        if (stale && x.replayable && !x.retried && !x.started) {
            x.retried = true; self.exchanges.set(xi, x); self.stats.retries += 1;
            if (self.dispatch(xi)) { return; }
        }
        self.fail(xi, 502);
    }
    // End an exchange early. Before any response byte the client gets
    // status (502 or 504); after, an HTTP/1.1 client is closed and an
    // HTTP/2 stream is reset.
    fn fail(&self, xi: i32, status: i32) {
        let x: Exchange = self.exchanges.at(xi); if (!x.active) { return; }
        if (x.link >= 0) { self.drop_link(x.link); x.link = -1; self.exchanges.set(xi, x); }
        if (status == 502) { self.stats.bad_gateway += 1; }
        if (status == 504) { self.stats.gateway_timeout += 1; }
        if (x.started || status == 0) { self.stats.aborted += 1; }
        if (x.stream == 0) {
            let c: Client = self.clients.at(x.client);
            c.exchange = -1;
            if (!x.started && status > 0) {
                if (!x.req_done) { c.keep_alive = false; }
                error_response(c.output.borrow(), status, c.keep_alive, self.options.via);
            } else { c.keep_alive = false; }
            c.phase = C_CLOSING; if (c.keep_alive) { c.phase = C_IDLE; c.deadline = after(self.now, self.options.idle_timeout_ms); } else { c.deadline = after(self.now, self.options.io_timeout_ms); }
            self.clients.set(x.client, c);
        } else {
            let e: ext::http2_server::Connection = self.engines.at(x.client).unwrap();
            if (!x.started && status > 0) {
                let text: core::slice::View<u8> = status_text(status);
                let digits: [u8;8] = [0;8]; let n: i32 = 0; let v: i32 = text.len() + 1; let rev: [u8;8] = [0;8];
                while (v > 0) { let d: u8 = (48 + v % 10) as u8; rev[n] = d; n += 1; v = v / 10; }
                let k: i32 = 0; while (k < n) { let d: u8 = rev[n - 1 - k]; digits[k] = d; k += 1; }
                let blank: ext::hpack::Header = ext::hpack::Header { name: literal("", 0), value: literal("", 0), never_indexed: false };
                let fields: [ext::hpack::Header;2] = [blank;2];
                let h0: ext::hpack::Header = ext::hpack::Header { name: literal("content-type", 12), value: literal("text/plain", 10), never_indexed: false }; fields[0] = h0;
                let h1: ext::hpack::Header = ext::hpack::Header { name: literal("content-length", 14), value: core::slice::View { values: digits, start: 0, length: n }, never_indexed: false }; fields[1] = h1;
                let body: alloc::vec::Vec<u8> = alloc::vec::new<u8>(); body.try_extend(text); body.try_push(10);
                let r = e.respond(x.stream, status, core::slice::View { values: fields, start: 0, length: 2 }, false);
                if (r.is_ok()) { e.send_data(x.stream, body.as_view(), true); } else { e.cancel(x.stream); }
                body.destroy();
            } else { e.cancel(x.stream); }
            self.engines.set(x.client, core::option::Some(e));
            let c: Client = self.clients.at(x.client); let k: i32 = c.streams.index_of(xi); if (k >= 0) { c.streams.swap_remove(k); } self.clients.set(x.client, c);
        }
        self.free_exchange(xi);
    }
    fn finish(&self, xi: i32) {
        let x: Exchange = self.exchanges.at(xi);
        let l: Link = self.links.at(x.link);
        self.release_link(x.link, x.reusable && x.req_done && l.filled == 0);
        if (x.stream == 0) {
            let c: Client = self.clients.at(x.client); c.exchange = -1;
            if (!x.req_done || c.requests >= self.options.max_requests) { c.keep_alive = false; }
            if (c.keep_alive) { c.phase = C_IDLE; c.deadline = after(self.now, self.options.idle_timeout_ms); } else { c.phase = C_CLOSING; c.deadline = after(self.now, self.options.io_timeout_ms); }
            self.clients.set(x.client, c);
        } else {
            let c: Client = self.clients.at(x.client); let k: i32 = c.streams.index_of(xi); if (k >= 0) { c.streams.swap_remove(k); } self.clients.set(x.client, c);
        }
        self.free_exchange(xi);
    }
    // Move request body bytes toward the upstream; true on progress.
    fn pump_request(&self, xi: i32) -> bool {
        let x: Exchange = self.exchanges.at(xi);
        let room: i32 = self.options.buffer_bytes - self.link_backlog(x.link); if (room <= 16) { return false; }
        let l: Link = self.links.at(x.link);
        if (x.stream == 0) {
            let c: Client = self.clients.at(x.client);
            if (c.filled == 0) { if (c.eof) { self.fail(xi, 0); return false; } return false; }
            let n: i32 = c.filled; if (n > room) { n = room; }
            let framer: ext::http_body::Framer = x.request;
            let advanced: core::result::Result<ext::http_body::Step,ext::http_body::Error> = framer.advance(view(c.input, 0, n));
            if (advanced.is_err()) { self.fail(xi, 0); return false; }
            let st: ext::http_body::Step = advanced.unwrap();
            if (l.output.try_extend(view(c.input, 0, st.consumed)).is_err()) { self.fail(xi, 0); return false; }
            c.filled = shift(c.input, st.consumed, c.filled);
            x.request = framer; if (st.done) { x.req_done = true; }
            x.deadline = after(self.now, self.options.io_timeout_ms); if (x.waiting) { x.deadline = after(self.now, self.options.response_timeout_ms); }
            self.clients.set(x.client, c); self.links.set(x.link, l); self.exchanges.set(xi, x);
            return st.consumed > 0 || st.done;
        }
        let e: ext::http2_server::Connection = self.engines.at(x.client).unwrap();
        let st: ext::http2::State = e.state(x.stream);
        let failed: bool = match (st) { ext::http2::State::Failed -> true, _ -> false };
        if (failed) { self.fail(xi, 0); return false; }
        let body: core::slice::View<u8> = e.body(x.stream); let moved: bool = false;
        if (body.len() > 0) {
            let n: i32 = body.len(); if (n > room - 16) { n = room - 16; }
            let chunk: core::slice::View<u8> = core::slice::View { values: body.values, start: body.start, length: n };
            let ok: bool = true;
            if (x.chunk_out) { ok = ext::http_body::chunk_head(l.output.borrow(), n) && l.output.try_extend(chunk).is_ok() && ext::http_body::chunk_end(l.output.borrow()); }
            else { ok = l.output.try_extend(chunk).is_ok(); }
            if (!ok) { self.links.set(x.link, l); self.fail(xi, 0); return false; }
            e.consume(x.stream, n); moved = true;
        }
        if (e.body_finished(x.stream) && e.body(x.stream).len() == 0) {
            if (x.chunk_out) { ext::http_body::last_chunk(l.output.borrow()); }
            x.req_done = true; moved = true;
        }
        if (moved && !x.waiting) { x.deadline = after(self.now, self.options.io_timeout_ms); }
        self.engines.set(x.client, core::option::Some(e)); self.links.set(x.link, l); self.exchanges.set(xi, x);
        return moved;
    }
}

impl Proxy {
    // Parse the upstream response head and pass it on.
    fn response_head(&self, xi: i32) -> bool {
        let x: Exchange = self.exchanges.at(xi); let l: Link = self.links.at(x.link);
        if (l.filled == 0) { return false; }
        let parsed: core::result::Result<ext::http::Head,ext::http::Error> = ext::http::parse_response_head(view(l.input, 0, l.filled), x.method.as_view(), self.options.limits);
        if (parsed.is_err()) {
            let incomplete: bool = match (parsed.unwrap_err()) { ext::http::Error::Incomplete(n) -> true, _ -> false };
            if (incomplete && l.filled < self.options.limits.head_bytes && l.filled < l.input.len()) { return false; }
            self.fail(xi, 502); return false;
        }
        let head: ext::http::Head = parsed.unwrap(); let used: i32 = head.raw.len();
        // Interim responses (100 Continue, 103) are not passed on.
        if (head.status < 200) {
            if (head.status == 101) { self.fail(xi, 502); return false; }
            l.filled = shift(l.input, used, l.filled); self.links.set(x.link, l); return true;
        }
        let tunnel: bool = match (head.kind) { ext::http::BodyKind::Tunnel -> true, _ -> false };
        if (tunnel) { self.fail(xi, 502); return false; }
        let close_delimited: bool = match (head.kind) { ext::http::BodyKind::Close -> true, _ -> false };
        x.response = framer_for(head.kind, head.content_length, self.options.limits);
        x.reusable = head.version == 11 && !close_delimited && !connection_lists(head, literal("close", 5));
        let forward: ext::http_rewrite::Forward = self.forward(x.client);
        if (x.stream == 0) {
            let c: Client = self.clients.at(x.client);
            if (close_delimited) { c.keep_alive = false; }
            let ok: bool = ext::http_rewrite::response_head(c.output.borrow(), head, c.keep_alive, forward);
            self.clients.set(x.client, c);
            if (!ok) { self.fail(xi, 502); return false; }
        } else {
            let fields: alloc::vec::Vec<ext::hpack::Header> = self.scratch_fields; let scratch: alloc::vec::Vec<u8> = self.scratch;
            let ok: bool = ext::http_rewrite::h2_response_fields(head, fields.borrow(), scratch.borrow(), forward);
            self.scratch_fields = fields; self.scratch = scratch;
            if (!ok) { self.fail(xi, 502); return false; }
            let e: ext::http2_server::Connection = self.engines.at(x.client).unwrap();
            let r: core::result::Result<i32,ext::http2::Error> = e.respond(x.stream, head.status, fields.as_view(), x.response.is_done());
            self.engines.set(x.client, core::option::Some(e));
            if (r.is_err()) { self.fail(xi, 0); return false; }
        }
        l.filled = shift(l.input, used, l.filled); self.links.set(x.link, l);
        x.started = true; x.waiting = false; x.deadline = after(self.now, self.options.io_timeout_ms);
        if (x.response.is_done()) { x.resp_done = true; }
        self.exchanges.set(xi, x); self.stats.responses += 1;
        return true;
    }
    // Move response body bytes toward the client; true on progress.
    fn pump_response(&self, xi: i32) -> bool {
        let x: Exchange = self.exchanges.at(xi);
        if (!x.started) { return self.response_head(xi); }
        let l: Link = self.links.at(x.link); if (l.filled == 0) { return false; }
        let room: i32 = self.options.buffer_bytes - self.backlog(xi); if (room <= 0) { return false; }
        let n: i32 = l.filled; if (n > room) { n = room; }
        let framer: ext::http_body::Framer = x.response;
        let advanced: core::result::Result<ext::http_body::Step,ext::http_body::Error> = framer.advance(view(l.input, 0, n));
        if (advanced.is_err()) { self.fail(xi, 0); return false; }
        let st: ext::http_body::Step = advanced.unwrap();
        if (x.stream == 0) {
            let c: Client = self.clients.at(x.client);
            let ok: bool = c.output.try_extend(view(l.input, 0, st.consumed)).is_ok(); self.clients.set(x.client, c);
            if (!ok) { self.fail(xi, 0); return false; }
        } else {
            if (st.data_length > 0 || st.done) {
                let e: ext::http2_server::Connection = self.engines.at(x.client).unwrap();
                let sent: core::result::Result<i32,ext::http2::Error> = e.send_data(x.stream, view(l.input, st.data_start, st.data_start + st.data_length), st.done);
                self.engines.set(x.client, core::option::Some(e));
                if (sent.is_err()) { self.fail(xi, 0); return false; }
            }
        }
        l.filled = shift(l.input, st.consumed, l.filled); self.links.set(x.link, l);
        x.response = framer; if (st.done) { x.resp_done = true; }
        x.deadline = after(self.now, self.options.io_timeout_ms); self.exchanges.set(xi, x);
        return st.consumed > 0 || st.done;
    }
    // A close-delimited response ends at upstream EOF; any other EOF
    // before the response is complete fails the exchange.
    fn link_eof(&self, xi: i32) {
        let x: Exchange = self.exchanges.at(xi); if (!x.active || x.link < 0) { return; }
        let l: Link = self.links.at(x.link); if (!l.eof || l.filled > 0) { return; }
        if (x.started && !x.resp_done) {
            let framer: ext::http_body::Framer = x.response;
            if (framer.finish().is_err()) { self.fail(xi, 0); return; }
            x.response = framer; x.resp_done = true; x.reusable = false;
            if (x.stream != 0) {
                let e: ext::http2_server::Connection = self.engines.at(x.client).unwrap();
                let sent: core::result::Result<i32,ext::http2::Error> = e.send_data(x.stream, literal("", 0), true);
                self.engines.set(x.client, core::option::Some(e));
            }
            self.exchanges.set(xi, x); return;
        }
        if (!x.started) { self.link_failed(x.link); }
    }
    // Move bytes both ways until nothing changes, then finish the exchange
    // once its response (and, to keep the connections, its request) ended.
    fn drive(&self, xi: i32) {
        let rounds: i32 = 64; let progress: bool = true;
        while (progress && rounds > 0) {
            rounds -= 1; progress = false;
            let x: Exchange = self.exchanges.at(xi); if (!x.active) { return; }
            if (x.link < 0) { return; }
            let l: Link = self.links.at(x.link);
            if (!x.req_done && l.state != L_CONNECTING) { if (self.pump_request(xi)) { progress = true; } }
            x = self.exchanges.at(xi); if (!x.active) { return; }
            if (!x.resp_done) { if (self.pump_response(xi)) { progress = true; } }
            x = self.exchanges.at(xi); if (!x.active) { return; }
            let sent_before: i32 = self.link_backlog(x.link);
            if (!self.flush_link(x.link)) { self.link_failed(x.link); return; }
            if (self.link_backlog(x.link) < sent_before) { progress = true; }
            if (x.stream == 0) {
                let c: Client = self.clients.at(x.client); let before: i32 = c.output.len() - c.sent;
                if (!self.flush_client(x.client)) { self.fail(xi, 0); return; }
                c = self.clients.at(x.client); if (c.output.len() - c.sent < before) { progress = true; }
            }
            if (!x.resp_done) { self.link_eof(xi); x = self.exchanges.at(xi); if (!x.active) { return; } }
            if (x.resp_done) {
                // A response that beat its request body ends an HTTP/1.1
                // client connection, and the engine resets an HTTP/2 stream
                // (finish sees req_done false and closes the upstream too).
                self.finish(xi); return;
            }
        }
    }
}

// ---- Clients ----
fn far(now: core::time::Instant) -> core::time::Deadline { return after(now, 86400000); }
fn is_method(v: core::slice::View<u8>, s: str, n: i32) -> bool { return same(v, literal(s, n)); }
impl Proxy {
    fn reject(&self, slot: i32, status: i32) {
        let c: Client = self.clients.at(slot); c.keep_alive = false;
        error_response(c.output.borrow(), status, false, self.options.via);
        c.phase = C_CLOSING; c.deadline = after(self.now, self.options.io_timeout_ms); self.clients.set(slot, c); self.stats.rejected += 1;
    }
    fn start_h1(&self, slot: i32, head: ext::http::Head) {
        let xi: i32 = self.new_exchange(); if (xi < 0) { self.reject(slot, 502); return; }
        let x: Exchange = self.exchanges.at(xi);
        x.active = true; x.client = slot; x.stream = 0; x.link = -1; x.method.clear(); x.head.clear();
        x.method.try_extend(head.method);
        let ok: bool = ext::http_rewrite::request_head(x.head.borrow(), head, self.forward(slot));
        x.request = framer_for(head.kind, head.content_length, self.options.limits);
        x.req_done = x.request.is_done(); x.replayable = x.req_done; x.chunk_out = false; x.started = false; x.resp_done = false; x.retried = false; x.reusable = false; x.waiting = false;
        x.upstream = self.pick(head.target); x.deadline = after(self.now, self.options.response_timeout_ms);
        self.exchanges.set(xi, x);
        if (!ok) { self.free_exchange(xi); self.reject(slot, 502); return; }
        let c: Client = self.clients.at(slot);
        c.keep_alive = (head.version == 11 && !connection_lists(head, literal("close", 5))) || (head.version == 10 && connection_lists(head, literal("keep-alive", 10)));
        let expect: core::option::Option<ext::http::Field> = head.lookup(literal("expect", 6));
        if (head.version == 11 && !x.req_done && expect.is_some() && ext::http_rewrite::lists(expect.unwrap().value, literal("100-continue", 12))) { c.output.try_extend(literal("HTTP/1.1 100 Continue\r\n\r\n", 25)); }
        c.requests += 1; self.stats.requests += 1;
        c.filled = shift(c.input, head.raw.len(), c.filled);
        c.phase = C_BUSY; c.exchange = xi; c.deadline = far(self.now);
        self.clients.set(slot, c);
        if (!self.dispatch(xi)) { self.fail(xi, 502); }
    }
    // Advance an HTTP/1.1 client: parse the next head, drive its exchange,
    // or finish closing.
    fn client_step(&self, slot: i32) {
        let rounds: i32 = 64;
        while (rounds > 0) {
            rounds -= 1;
            let c: Client = self.clients.at(slot); if (c.closed || c.h2) { return; }
            if (c.phase == C_CLOSING) {
                if (!self.flush_client(slot)) { self.drop_client(slot); return; }
                c = self.clients.at(slot); if (c.sent < c.output.len()) { return; }
                // Half-close, then discard input until EOF so the client
                // reads the response instead of a reset.
                if (!c.shut) { c.socket.shutdown(std::socket::Shutdown::Write); c.shut = true; }
                c.filled = 0; self.clients.set(slot, c);
                if (c.eof) { self.drop_client(slot); }
                return;
            }
            if (c.phase == C_BUSY) {
                self.drive(c.exchange);
                c = self.clients.at(slot); if (c.closed || c.phase == C_BUSY) { return; }
                continue;
            }
            if (c.filled == 0) { if (c.eof) { self.drop_client(slot); } return; }
            if (c.phase == C_IDLE) { c.phase = C_HEAD; c.deadline = after(self.now, self.options.head_timeout_ms); self.clients.set(slot, c); }
            if (self.options.h2 && c.requests == 0) {
                let preface: core::slice::View<u8> = ext::http2_frame::preface(); let have: i32 = c.filled; if (have > preface.len()) { have = preface.len(); }
                if (same(view(c.input, 0, have), core::slice::View { values: preface.values, start: preface.start, length: have })) {
                    if (have == preface.len()) { self.h2_start(slot); return; }
                    if (c.eof) { self.drop_client(slot); } return;
                }
            }
            let parsed: core::result::Result<ext::http::Head,ext::http::Error> = ext::http::parse_request_head(view(c.input, 0, c.filled), self.options.limits);
            if (parsed.is_err()) {
                let e: ext::http::Error = parsed.unwrap_err();
                let incomplete: bool = match (e) { ext::http::Error::Incomplete(n) -> true, _ -> false };
                if (incomplete) {
                    if (c.filled >= self.options.limits.head_bytes || c.filled >= c.input.len()) { self.reject(slot, 431); continue; }
                    if (c.eof) { self.drop_client(slot); } return;
                }
                let status: i32 = match (e) { ext::http::Error::Unsupported(n) -> 501, ext::http::Error::Limit(n) -> 431, _ -> 400 };
                self.reject(slot, status); continue;
            }
            self.start_h1(slot, parsed.unwrap());
        }
    }
    fn on_client(&self, slot: i32, event: std::event::Event) {
        let c: Client = self.clients.at(slot); if (c.closed) { return; }
        if (c.h2) { self.h2_event(slot); return; }
        if (event.writable() || event.error()) { if (!self.flush_client(slot)) { self.drop_client(slot); return; } }
        if (event.readable() || event.hangup() || event.error()) {
            if (self.read_client(slot) < 0) { self.drop_client(slot); return; }
            c = self.clients.at(slot);
            if (c.phase == C_CLOSING && c.shut) { c.filled = 0; self.clients.set(slot, c); }
        }
        self.client_step(slot);
        c = self.clients.at(slot); if (c.closed) { return; }
        if (!self.flush_client(slot)) { self.drop_client(slot); }
    }
    // ---- h2c clients ----
    fn h2_start(&self, slot: i32) {
        let o: ext::http2_server::Options = ext::http2_server::default_options();
        let h: ext::hpack::Limits = o.hpack; h.list_bytes = self.options.limits.head_bytes; o.hpack = h;
        o.stream_bodies = true; o.max_streams = self.options.h2_streams; o.stream_window = self.options.h2_stream_window; o.max_requests = self.options.max_requests;
        let made: core::result::Result<ext::http2_server::Connection,ext::http2::Error> = ext::http2_server::server(o);
        if (made.is_err()) { self.drop_client(slot); return; }
        let e: ext::http2_server::Connection = made.unwrap();
        let c: Client = self.clients.at(slot);
        e.feed(view(c.input, 0, c.filled));
        c.filled = 0; c.h2 = true; c.phase = C_H2; c.deadline = after(self.now, self.options.idle_timeout_ms);
        self.clients.set(slot, c); self.engines.set(slot, core::option::Some(e)); self.stats.h2_clients += 1;
        self.h2_pump(slot);
    }
    fn start_h2(&self, slot: i32, id: i32) {
        let e: ext::http2_server::Connection = self.engines.at(slot).unwrap();
        let method: core::slice::View<u8> = e.method(id); let path: core::slice::View<u8> = e.path(id);
        let fields: alloc::vec::Vec<ext::hpack::Header> = self.scratch_fields; fields.clear();
        let n: i32 = e.field_count(id); let i: i32 = 0; while (i < n) { fields.try_push(e.field(id, i)); i += 1; }
        self.scratch_fields = fields;
        let length: i64 = ext::http_rewrite::CHUNKED;
        let declared: core::option::Option<core::slice::View<u8>> = e.header(id, literal("content-length", 14));
        if (declared.is_some()) { let v: core::slice::View<u8> = declared.unwrap(); length = 0; let k: i32 = 0; while (k < v.len()) { length = length * 10 + (v.values[v.start + k] - 48) as i64; k += 1; } }
        if (declared.is_none() && e.body_finished(id) && e.body(id).len() == 0) {
            length = ext::http_rewrite::NO_BODY;
            if (is_method(method, "POST", 4) || is_method(method, "PUT", 3) || is_method(method, "PATCH", 5)) { length = 0; }
        }
        let xi: i32 = self.new_exchange(); if (xi < 0) { e.cancel(id); self.engines.set(slot, core::option::Some(e)); return; }
        let x: Exchange = self.exchanges.at(xi);
        x.active = true; x.client = slot; x.stream = id; x.link = -1; x.method.clear(); x.head.clear(); x.method.try_extend(method);
        let ok: bool = ext::http_rewrite::h2_request_head(x.head.borrow(), method, path, e.authority(id), fields.as_view(), length, self.forward(slot));
        x.request = ext::http_body::empty(); x.chunk_out = length == ext::http_rewrite::CHUNKED;
        x.req_done = (length == ext::http_rewrite::NO_BODY || length == 0) && e.body_finished(id);
        x.replayable = x.req_done; x.started = false; x.resp_done = false; x.retried = false; x.reusable = false; x.waiting = false;
        x.upstream = self.pick(path); x.deadline = after(self.now, self.options.response_timeout_ms);
        self.exchanges.set(xi, x); self.engines.set(slot, core::option::Some(e));
        let c: Client = self.clients.at(slot); c.streams.try_push(xi); self.clients.set(slot, c);
        self.stats.requests += 1; self.stats.h2_requests += 1;
        if (!ok) { self.fail(xi, 502); return; }
        if (is_method(method, "CONNECT", 7)) { self.fail(xi, 501); return; }
        if (!self.dispatch(xi)) { self.fail(xi, 502); }
    }
    // Start new streams, drive every stream's exchange, send what the
    // engine has, and close the connection once it is finished.
    fn h2_pump(&self, slot: i32) {
        while (true) {
            let e: ext::http2_server::Connection = self.engines.at(slot).unwrap();
            let next: core::option::Option<i32> = e.next_request(); self.engines.set(slot, core::option::Some(e));
            if (next.is_none()) { break; }
            self.start_h2(slot, next.unwrap());
        }
        let c: Client = self.clients.at(slot); let k: i32 = c.streams.len() - 1;
        while (k >= 0) {
            c = self.clients.at(slot); if (k < c.streams.len()) { self.drive(c.streams.at(k)); }
            k -= 1;
        }
        self.h2_flush(slot);
    }
    fn h2_flush(&self, slot: i32) {
        let c: Client = self.clients.at(slot); if (c.closed || !c.h2) { return; }
        let e: ext::http2_server::Connection = self.engines.at(slot).unwrap(); e.collect(); self.engines.set(slot, core::option::Some(e));
        if (!self.flush_client(slot)) { self.drop_client(slot); return; }
        c = self.clients.at(slot); e = self.engines.at(slot).unwrap();
        if ((!e.is_open() || e.finished()) && e.output().len() == 0 && c.sent >= c.output.len()) { self.drop_client(slot); return; }
        if (c.streams.len() > 0) { c.deadline = far(self.now); self.clients.set(slot, c); }
    }
    fn h2_event(&self, slot: i32) {
        let rounds: i32 = 16;
        while (rounds > 0) {
            rounds -= 1;
            let got: i32 = self.read_client(slot); if (got < 0) { self.drop_client(slot); return; }
            let c: Client = self.clients.at(slot);
            if (c.filled > 0) {
                let e: ext::http2_server::Connection = self.engines.at(slot).unwrap();
                e.feed(view(c.input, 0, c.filled)); self.engines.set(slot, core::option::Some(e));
                c.filled = 0; if (c.streams.len() == 0) { c.deadline = after(self.now, self.options.idle_timeout_ms); } self.clients.set(slot, c);
            }
            if (c.eof) { self.drop_client(slot); return; }
            if (got == 0) { break; }
        }
        self.h2_pump(slot);
    }
}

// ---- The loop ----
impl Proxy {
    fn after_exchange(&self, slot: i32) {
        if (slot < 0) { return; }
        let c: Client = self.clients.at(slot); if (c.closed) { return; }
        if (c.h2) { self.h2_flush(slot); return; }
        self.client_step(slot);
        c = self.clients.at(slot); if (c.closed) { return; }
        if (!self.flush_client(slot)) { self.drop_client(slot); }
    }
    fn on_link(&self, li: i32, event: std::event::Event) {
        let l: Link = self.links.at(li); if (l.state == L_FREE) { return; }
        // An idle pooled connection that turns readable was closed (or
        // misbehaved) upstream.
        if (l.state == L_IDLE) { self.drop_link(li); return; }
        let xi: i32 = l.exchange; let slot: i32 = -1;
        if (xi >= 0) { slot = self.exchanges.at(xi).client; }
        if (l.state == L_CONNECTING) {
            if (!event.writable() && !event.error() && !event.hangup()) { return; }
            let pending: core::result::Result<core::option::Option<i32>,core::io::Error> = l.socket.take_error();
            if (pending.is_err() || pending.unwrap().is_some()) { self.link_failed(li); self.after_exchange(slot); return; }
            l.state = L_BUSY; l.deadline = far(self.now); self.links.set(li, l);
        }
        if (event.writable() || event.error()) { if (!self.flush_link(li)) { self.link_failed(li); self.after_exchange(slot); return; } }
        if (event.readable() || event.hangup() || event.error()) { if (self.read_link(li) < 0) { self.link_failed(li); self.after_exchange(slot); return; } }
        if (xi >= 0) { self.drive(xi); }
        self.after_exchange(slot);
    }
    fn accept_ready(&self) {
        while (self.active < self.clients.len()) {
            let got: core::result::Result<std::socket::Accepted,std::socket::AcceptFailure> = self.listener.accept(true);
            if (got.is_err()) { return; }
            let a: std::socket::Accepted = got.unwrap(); a.socket.set_option(std::socket::Setting::NoDelay, 1);
            let slot: i32 = 0; while (!self.clients.at(slot).closed) { slot += 1; }
            let c: Client = self.clients.at(slot);
            if (c.input.try_resize(self.options.buffer_bytes, 0).is_err()) { a.socket.close(); continue; }
            let text: [u8;64] = [0;64]; let n: core::result::Result<i32,core::net::Error> = a.peer.address().format_into(core::slice::View { values: text, start: 0, length: 64 });
            c.address.clear(); if (n.is_ok()) { c.address.try_extend(core::slice::View { values: text, start: 0, length: n.unwrap() }); }
            c.socket = a.socket; c.peer = a.peer; c.closed = false; c.h2 = false; c.phase = C_IDLE; c.filled = 0; c.output.clear(); c.sent = 0;
            c.deadline = after(self.now, self.options.idle_timeout_ms); c.keep_alive = true; c.requests = 0; c.exchange = -1; c.streams.clear(); c.interest = READ; c.eof = false; c.shut = false;
            if (self.events.add(a.socket.handle, std::event::readable(), slot as u64).is_err()) { a.socket.close(); c.socket.handle = -1; c.closed = true; self.clients.set(slot, c); continue; }
            c.live_at = self.live.len(); if (self.live.try_push(slot).is_err()) { self.events.remove(a.socket.handle); a.socket.close(); c.socket.handle = -1; c.closed = true; self.clients.set(slot, c); continue; }
            self.clients.set(slot, c); self.active += 1; self.stats.clients += 1;
            if (self.active > self.stats.peak_clients) { self.stats.peak_clients = self.active; }
        }
        // Full: stop watching the listener so level-triggered readiness cannot spin.
        if (self.listening) { let lf: i32 = self.listener.raw_handle().unwrap(); if (self.events.remove(lf).is_ok()) { self.listening = false; } }
    }
    fn expire(&self) {
        let now: core::time::Instant = self.now; let i: i32 = 0;
        while (i < self.exchanges.len()) {
            let x: Exchange = self.exchanges.at(i);
            if (x.active && x.deadline.is_expired(now)) {
                let slot: i32 = x.client;
                if (x.link >= 0 && self.links.at(x.link).state == L_CONNECTING) { i += 1; continue; }
                if (x.waiting) { self.fail(i, 504); } else { self.fail(i, 0); }
                self.after_exchange(slot);
            }
            i += 1;
        }
        i = 0;
        while (i < self.links.len()) {
            let l: Link = self.links.at(i);
            if (l.state == L_IDLE && l.deadline.is_expired(now)) { self.drop_link(i); }
            if (l.state == L_CONNECTING && l.deadline.is_expired(now)) {
                let xi: i32 = l.exchange; self.drop_link(i);
                if (xi >= 0) { let x: Exchange = self.exchanges.at(xi); x.link = -1; self.exchanges.set(xi, x); let slot: i32 = x.client; self.fail(xi, 504); self.after_exchange(slot); }
            }
            i += 1;
        }
        let k: i32 = self.live.len() - 1;
        while (k >= 0) {
            if (k >= self.live.len()) { k = self.live.len() - 1; continue; }
            let i: i32 = self.live.at(k); k -= 1;
            let c: Client = self.clients.at(i);
            if (!c.closed && c.deadline.is_expired(now)) {
                if (c.phase == C_IDLE || c.phase == C_CLOSING) { self.drop_client(i); }
                if (c.phase == C_HEAD) { self.reject(i, 408); self.client_step(i); }
                if (c.phase == C_H2 && c.streams.len() == 0) {
                    let e: ext::http2_server::Connection = self.engines.at(i).unwrap(); e.goaway(ext::http2_frame::NO_ERROR); self.engines.set(i, core::option::Some(e));
                    self.flush_client(i); self.drop_client(i);
                }
            }
        }
    }
    // Start queued exchanges, oldest first, as connections free up.
    fn serve_queue(&self) {
        // Upstreams found full this round (the first 64 ids are remembered).
        let full: [bool;64] = [false;64]; let k: i32 = 0;
        while (k < self.queue.len()) {
            let xi: i32 = self.queue.at(k); let x: Exchange = self.exchanges.at(xi);
            if (!x.active || !x.queued) { self.queue.remove(k); continue; }
            if (x.upstream < 64 && full[x.upstream]) { k += 1; continue; }
            if (!self.has_idle(x.upstream) && self.busy(x.upstream) >= self.options.upstream_connections) { if (x.upstream < 64) { full[x.upstream] = true; } k += 1; continue; }
            self.queue.remove(k); let slot: i32 = x.client;
            if (!self.dispatch(xi)) { self.fail(xi, 502); } else { self.drive(xi); }
            self.after_exchange(slot);
        }
    }
    // Run one round of the loop: wait for readiness until deadline (or an
    // earlier internal timeout), handle it, and apply timeouts. Returns the
    // number of readiness events handled.
    pub fn poll(&self, deadline: core::time::Deadline) -> core::result::Result<i32,Error> {
        if (self.closed) { return core::result::Err(Error::InvalidState); }
        self.refresh();
        // Timeouts are swept every 25 ms while anything is open (they fire
        // up to that late) rather than scanned on every round.
        let wake: core::time::Deadline = deadline;
        let busy: bool = self.active > 0 || self.queue.len() > 0 || self.links.len() > self.free_links();
        if (busy) { wake = earlier(wake, self.sweep_at); }
        let storage: [std::event::Event;64] = [std::event::empty_event();64];
        let events: core::slice::View<std::event::Event> = core::slice::View { values: storage, start: 0, length: 64 };
        let got: core::result::Result<i32,std::event::Error> = self.events.wait_until(events, wake);
        if (got.is_err()) { let e: std::event::Error = got.unwrap_err(); let eintr: bool = match (e) { std::event::Error::Host(n) -> n == 4, _ -> false }; if (eintr) { return core::result::Ok(0); } return core::result::Err(Error::Event(e)); }
        let now: core::result::Result<core::time::Instant,Error> = now_instant(); if (now.is_err()) { return core::result::Err(now.unwrap_err()); }
        self.now = now.unwrap();
        let n: i32 = got.unwrap(); let i: i32 = 0;
        while (i < n) {
            let event: std::event::Event = storage[i]; i += 1;
            if (event.token == LISTENER) { self.accept_ready(); continue; }
            if (event.token >= LINK_BASE) { self.on_link((event.token - LINK_BASE) as i32, event); continue; }
            self.on_client(event.token as i32, event);
        }
        if (self.sweep_at.is_expired(self.now) || !busy) { self.expire(); self.sweep_at = after(self.now, 25); }
        if (self.queue.len() > 0) { self.serve_queue(); }
        return core::result::Ok(n);
    }
}
