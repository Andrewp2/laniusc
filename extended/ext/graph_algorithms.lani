// Unweighted paths, dependency ordering and canonical strong components.
// Validate once before operation admission/allocation; never mutate input.
// Result owners copy shallowly: keep one cleanup authority and end borrows
// before destroy. Work estimates bound local phases, not elapsed time.
module ext::graph_algorithms;
import alloc::binary_heap;
import alloc::deque;
import alloc::vec;
import core::i32;
import core::mem;
import core::option;
import core::result;
import core::slice;
import ext::graph;

pub struct BfsPaths {
    distances: alloc::vec::Vec<i32>,
    parents: alloc::vec::Vec<i32>,
    selected_source: i32,
    active: bool,
}

fn error(kind: ext::graph::ErrorKind, node: i32) -> ext::graph::Error {
    return ext::graph::Error { kind: kind, node: node, edge: -1 };
}

fn integer(values: core::slice::View<i32>, index: i32) -> i32 {
    return values.values[values.start + index];
}

fn absent_or(value: i32) -> core::option::Option<i32> {
    if (value < 0) { return core::option::None(); }
    return core::option::Some(value);
}

pub impl BfsPaths {
    pub fn borrow(&self) -> &BfsPaths { return self; }
    pub fn is_open(&self) -> bool { return self.active; }
    pub fn node_count(&self) -> i32 {
        if (!self.active) { return 0; }
        return self.distances.len();
    }
    pub fn source(&self) -> core::option::Option<i32> {
        if (!self.active) { return core::option::None(); }
        return core::option::Some(self.selected_source);
    }
    pub fn distance(&self, node: i32) -> core::result::Result<core::option::Option<i32>, ext::graph::Error> {
        if (!self.active) { return core::result::Err(error(ext::graph::ErrorKind::Closed, -1)); }
        if (node < 0 || node >= self.distances.len()) {
            return core::result::Err(error(ext::graph::ErrorKind::Bounds, node));
        }
        let value: core::option::Option<i32> = absent_or(self.distances.at(node));
        return core::result::Ok(value);
    }
    pub fn predecessor(&self, node: i32) -> core::result::Result<core::option::Option<i32>, ext::graph::Error> {
        if (!self.active) { return core::result::Err(error(ext::graph::ErrorKind::Closed, -1)); }
        if (node < 0 || node >= self.distances.len()) {
            return core::result::Err(error(ext::graph::ErrorKind::Bounds, node));
        }
        let value: core::option::Option<i32> = absent_or(self.parents.at(node));
        return core::result::Ok(value);
    }
    pub fn destroy(&self) -> bool {
        if (!self.active) { return false; }
        self.distances.destroy(); self.parents.destroy();
        self.selected_source = -1; self.active = false;
        return true;
    }
}

// FIFO first discovery is permanent. Ascending canonical neighbors fix ties;
// they do not promise the numerically smallest predecessor at every depth.
pub fn bfs(graph: ext::graph::View, source: i32, limits: ext::graph::Limits)
    -> core::result::Result<BfsPaths, ext::graph::Error> {
    ext::graph::validate(graph, limits)?;
    if (source < 0 || source >= graph.nodes) {
        return core::result::Err(error(ext::graph::ErrorKind::Bounds, source));
    }
    let n: u64 = graph.nodes as u64;
    let m: u64 = graph.targets.length as u64;
    let required: u64 = (n + 1 + m) + 4 * n + 2 * m + 1;
    if (required > limits.max_work) {
        return core::result::Err(error(ext::graph::ErrorKind::WorkLimit, -1));
    }

    let out: BfsPaths = BfsPaths {
        distances: alloc::vec::new(), parents: alloc::vec::new(),
        selected_source: source, active: true,
    };
    let distances: core::result::Result<alloc::vec::Vec<i32>, alloc::vec::Error> = alloc::vec::with_capacity<i32>(graph.nodes);
    if (distances.is_err()) {
        out.destroy();
        return core::result::Err(error(ext::graph::ErrorKind::AllocationFailed, -1));
    }
    out.distances = distances.unwrap();
    let parents: core::result::Result<alloc::vec::Vec<i32>, alloc::vec::Error> = alloc::vec::with_capacity<i32>(graph.nodes);
    if (parents.is_err()) {
        out.destroy();
        return core::result::Err(error(ext::graph::ErrorKind::AllocationFailed, -1));
    }
    out.parents = parents.unwrap();
    let allocated_queue: core::result::Result<alloc::deque::Deque<i32>, alloc::deque::Error> = alloc::deque::with_capacity<i32>(graph.nodes);
    if (allocated_queue.is_err()) {
        out.destroy();
        return core::result::Err(error(ext::graph::ErrorKind::AllocationFailed, -1));
    }
    let queue: alloc::deque::Deque<i32> = allocated_queue.unwrap();

    // Shared validation admits the native i32 capacity ceiling. These resizes
    // and every later push fit the reservations and cannot allocate or fail.
    out.distances.try_resize(graph.nodes, -1).unwrap();
    out.parents.try_resize(graph.nodes, -1).unwrap();
    let hops: [i32] = out.distances.as_slice();
    let previous: [i32] = out.parents.as_slice();
    hops[source] = 0;
    queue.try_push_back(source).unwrap();
    while (!queue.is_empty()) {
        let node: i32 = queue.pop_front().unwrap();
        let edge: i32 = integer(graph.offsets, node);
        let end: i32 = integer(graph.offsets, node + 1);
        while (edge < end) {
            let target: i32 = integer(graph.targets, edge);
            if (hops[target] < 0) {
                hops[target] = hops[node] + 1;
                previous[target] = node;
                queue.try_push_back(target).unwrap();
            }
            edge += 1;
        }
    }
    queue.destroy();
    return core::result::Ok(out);
}

// Kahn's incoming-count traversal uses the existing Min heap as its ready
// bag. Taking the smallest ready ID fixes the lexicographically smallest DAG
// order. Cycle failure releases the incomplete output and every workspace.
pub fn topological_order(graph: ext::graph::View, limits: ext::graph::Limits)
    -> core::result::Result<alloc::vec::Vec<i32>, ext::graph::Error> {
    ext::graph::validate(graph, limits)?;
    let n: u64 = graph.nodes as u64;
    let m: u64 = graph.targets.length as u64;
    let height: u64 = 0;
    let span: u64 = 1;
    while (span < n) { span *= 2; height += 1; }
    // Profile ceilings keep every widened product and sum inside u64.
    let required: u64 = (n + 1 + m) + 4 * n + 2 * m + 4 * n * (1 + height);
    if (required > limits.max_work) {
        return core::result::Err(error(ext::graph::ErrorKind::WorkLimit, -1));
    }

    let allocated_output: core::result::Result<alloc::vec::Vec<i32>, alloc::vec::Error> = alloc::vec::with_capacity<i32>(graph.nodes);
    if (allocated_output.is_err()) {
        return core::result::Err(error(ext::graph::ErrorKind::AllocationFailed, -1));
    }
    let out: alloc::vec::Vec<i32> = allocated_output.unwrap();
    let allocated_counts: core::result::Result<alloc::vec::Vec<i32>, alloc::vec::Error> = alloc::vec::with_capacity<i32>(graph.nodes);
    if (allocated_counts.is_err()) {
        out.destroy();
        return core::result::Err(error(ext::graph::ErrorKind::AllocationFailed, -1));
    }
    let counts: alloc::vec::Vec<i32> = allocated_counts.unwrap();
    let allocated_ready: core::result::Result<alloc::binary_heap::BinaryHeap<i32>, alloc::binary_heap::Error> = alloc::binary_heap::with_capacity<i32>(graph.nodes, alloc::binary_heap::Order::Min);
    if (allocated_ready.is_err()) {
        counts.destroy(); out.destroy();
        return core::result::Err(error(ext::graph::ErrorKind::AllocationFailed, -1));
    }
    let ready: alloc::binary_heap::BinaryHeap<i32> = allocated_ready.unwrap();

    // Each vertex enters ready and output at most once. Counts never exceed
    // the admitted edge count; all reserved pushes/resizes are infallible.
    counts.try_resize(graph.nodes, 0).unwrap();
    let incoming: [i32] = counts.as_slice();
    let edge: i32 = 0;
    while (edge < graph.targets.length) {
        let target: i32 = integer(graph.targets, edge);
        incoming[target] += 1;
        edge += 1;
    }
    let node: i32 = 0;
    while (node < graph.nodes) {
        if (incoming[node] == 0) { ready.try_push(node).unwrap(); }
        node += 1;
    }
    while (!ready.is_empty()) {
        node = ready.pop().unwrap();
        out.try_push(node).unwrap();
        edge = integer(graph.offsets, node);
        let end: i32 = integer(graph.offsets, node + 1);
        while (edge < end) {
            let target: i32 = integer(graph.targets, edge);
            incoming[target] -= 1;
            if (incoming[target] == 0) { ready.try_push(target).unwrap(); }
            edge += 1;
        }
    }
    ready.destroy(); counts.destroy();
    if (out.len() != graph.nodes) {
        out.destroy();
        return core::result::Err(error(ext::graph::ErrorKind::Cycle, -1));
    }
    return core::result::Ok(out);
}

// Component IDs increase with each component's smallest original node.
// They have no topological-order meaning. Copies retain one cleanup authority.
pub struct StrongComponents {
    labels: alloc::vec::Vec<i32>, count: i32, active: bool,
}

pub struct Condensation {
    components: StrongComponents, graph: ext::graph::Graph, active: bool,
}

pub impl StrongComponents {
    pub fn borrow(&self) -> &StrongComponents { return self; }
    pub fn is_open(&self) -> bool { return self.active; }
    pub fn node_count(&self) -> i32 {
        if (!self.active) { return 0; }
        return self.labels.len();
    }
    pub fn component_count(&self) -> i32 {
        if (!self.active) { return 0; }
        return self.count;
    }
    pub fn component(&self, node: i32) -> core::result::Result<i32, ext::graph::Error> {
        if (!self.active) { return core::result::Err(error(ext::graph::ErrorKind::Closed, -1)); }
        if (node < 0 || node >= self.labels.len()) {
            return core::result::Err(error(ext::graph::ErrorKind::Bounds, node));
        }
        return core::result::Ok(self.labels.at(node));
    }
    pub fn same_component(&self, left: i32, right: i32) -> core::result::Result<bool, ext::graph::Error> {
        let first: i32 = self.component(left)?;
        let second: i32 = self.component(right)?;
        return core::result::Ok(first == second);
    }
    pub fn destroy(&self) -> bool {
        if (!self.active) { return false; }
        self.labels.destroy(); self.count = 0; self.active = false;
        return true;
    }
}

pub impl Condensation {
    pub fn borrow(&self) -> &Condensation { return self; }
    pub fn is_open(&self) -> bool { return self.active; }
    pub fn node_count(&self) -> i32 {
        if (!self.active) { return 0; }
        return self.components.node_count();
    }
    pub fn component_count(&self) -> i32 {
        if (!self.active) { return 0; }
        return self.components.component_count();
    }
    pub fn component(&self, node: i32) -> core::result::Result<i32, ext::graph::Error> {
        if (!self.active) { return core::result::Err(error(ext::graph::ErrorKind::Closed, -1)); }
        return self.components.component(node);
    }
    pub fn same_component(&self, left: i32, right: i32) -> core::result::Result<bool, ext::graph::Error> {
        if (!self.active) { return core::result::Err(error(ext::graph::ErrorKind::Closed, -1)); }
        return self.components.same_component(left, right);
    }
    // Read-only borrow of an independently owned graph, valid until destroy.
    pub fn view(&self) -> core::option::Option<ext::graph::View> {
        if (!self.active) { return core::option::None(); }
        return self.graph.view();
    }
    pub fn destroy(&self) -> bool {
        if (!self.active) { return false; }
        self.graph.destroy(); self.components.destroy(); self.active = false;
        return true;
    }
}

struct ComponentWorkspace {
    discovered: alloc::vec::Vec<i32>, lowlinks: alloc::vec::Vec<i32>,
    active_nodes: alloc::vec::Vec<i32>, frames: alloc::vec::Vec<i32>,
    cursors: alloc::vec::Vec<i32>,
}

impl ComponentWorkspace {
    fn borrow(&self) -> &ComponentWorkspace { return self; }
    fn destroy(&self) {
        self.cursors.destroy(); self.frames.destroy(); self.active_nodes.destroy();
        self.lowlinks.destroy(); self.discovered.destroy();
    }
}

fn reserve_components(out: &StrongComponents, workspace: &ComponentWorkspace, nodes: i32)
    -> core::result::Result<i32, alloc::vec::Error> {
    out.labels.try_reserve(nodes)?;
    workspace.discovered.try_reserve(nodes)?;
    workspace.lowlinks.try_reserve(nodes)?;
    workspace.active_nodes.try_reserve(nodes)?;
    workspace.frames.try_reserve(nodes)?;
    return workspace.cursors.try_reserve(nodes);
}

// Caller validated the graph and admitted all work/capacities. This shared
// engine never validates again and retains no source backing in the result.
fn components_admitted(graph: ext::graph::View)
    -> core::result::Result<StrongComponents, ext::graph::Error> {
    let out: StrongComponents = StrongComponents {
        labels: alloc::vec::new(), count: 0, active: true,
    };
    let workspace: ComponentWorkspace = ComponentWorkspace {
        discovered: alloc::vec::new(), lowlinks: alloc::vec::new(),
        active_nodes: alloc::vec::new(), frames: alloc::vec::new(),
        cursors: alloc::vec::new(),
    };
    let reserved: core::result::Result<i32, alloc::vec::Error> =
        reserve_components(out.borrow(), workspace.borrow(), graph.nodes);
    if (reserved.is_err()) {
        workspace.destroy(); out.destroy();
        return core::result::Err(error(ext::graph::ErrorKind::AllocationFailed, -1));
    }
    // The validated i32 profile admits all six capacities. Each stack holds
    // each vertex at most once at a time, so subsequent operations cannot grow.
    out.labels.try_resize(graph.nodes, -1).unwrap();
    workspace.discovered.try_resize(graph.nodes, -1).unwrap();
    workspace.lowlinks.try_resize(graph.nodes, -1).unwrap();
    let labels: [i32] = out.labels.as_slice();
    let discovered: [i32] = workspace.discovered.as_slice();
    let low: [i32] = workspace.lowlinks.as_slice();
    let next_discovery: i32 = 0;
    let raw_count: i32 = 0;
    let root: i32 = 0;
    while (root < graph.nodes) {
        if (discovered[root] < 0) {
            discovered[root] = next_discovery; low[root] = next_discovery;
            next_discovery += 1;
            workspace.active_nodes.try_push(root).unwrap();
            workspace.frames.try_push(root).unwrap();
            workspace.cursors.try_push(integer(graph.offsets, root)).unwrap();
            while (!workspace.frames.is_empty()) {
                let depth: i32 = workspace.frames.len() - 1;
                let node: i32 = workspace.frames.at(depth);
                let edge: i32 = workspace.cursors.at(depth);
                let end: i32 = integer(graph.offsets, node + 1);
                if (edge < end) {
                    // Advance the parent before descending; each edge is read
                    // once, including edges into already completed components.
                    workspace.cursors.set(depth, edge + 1).unwrap();
                    let target: i32 = integer(graph.targets, edge);
                    if (discovered[target] < 0) {
                        discovered[target] = next_discovery; low[target] = next_discovery;
                        next_discovery += 1;
                        workspace.active_nodes.try_push(target).unwrap();
                        workspace.frames.try_push(target).unwrap();
                        workspace.cursors.try_push(integer(graph.offsets, target)).unwrap();
                    } else {
                        // Discovered but unassigned means still on the active
                        // component stack. Non-tree edges use discovery index.
                        if (labels[target] < 0 && discovered[target] < low[node]) {
                            low[node] = discovered[target];
                        }
                    }
                } else {
                    workspace.frames.pop().unwrap(); workspace.cursors.pop().unwrap();
                    if (low[node] == discovered[node]) {
                        while (true) {
                            let member: i32 = workspace.active_nodes.pop().unwrap();
                            labels[member] = raw_count;
                            if (member == node) { break; }
                        }
                        raw_count += 1;
                    }
                    if (!workspace.frames.is_empty()) {
                        let parent: i32 = workspace.frames.last().unwrap();
                        // A tree-child return contributes its lowlink. A child
                        // already popped as a component cannot lower its parent.
                        if (low[node] < low[parent]) { low[parent] = low[node]; }
                    }
                }
            }
        }
        root += 1;
    }

    // Reuse lowlinks as raw-ID -> public-ID storage. The first node seen in
    // each component is its minimum, independent of discovery/pop order.
    let node: i32 = 0;
    while (node < graph.nodes) { low[node] = -1; node += 1; }
    node = 0;
    while (node < graph.nodes) {
        let raw: i32 = labels[node];
        if (low[raw] < 0) { low[raw] = out.count; out.count += 1; }
        labels[node] = low[raw];
        node += 1;
    }
    workspace.destroy();
    return core::result::Ok(out);
}

pub fn strong_components(graph: ext::graph::View, limits: ext::graph::Limits)
    -> core::result::Result<StrongComponents, ext::graph::Error> {
    ext::graph::validate(graph, limits)?;
    let n: u64 = graph.nodes as u64;
    let m: u64 = graph.targets.length as u64;
    let required: u64 = (n + 1 + m) + 16 * n + 4 * m + 1;
    if (required > limits.max_work) {
        return core::result::Err(error(ext::graph::ErrorKind::WorkLimit, -1));
    }
    return components_admitted(graph);
}

pub fn condensation(graph: ext::graph::View, limits: ext::graph::Limits)
    -> core::result::Result<Condensation, ext::graph::Error> {
    ext::graph::validate(graph, limits)?;
    let capacity: i32 = (2147483647 / core::mem::size_of<ext::graph::Edge>()) as i32;
    if (graph.targets.length > capacity) {
        return core::result::Err(error(ext::graph::ErrorKind::EdgeLimit, -1));
    }
    let n: u64 = graph.nodes as u64;
    let m: u64 = graph.targets.length as u64;
    let height: u64 = 0;
    let span: u64 = 1;
    while (span < m) { span *= 2; height += 1; }
    let construction: u64 = n + 1 + 6 * m + 4 * m * (1 + height);
    let required: u64 = (n + 1 + m) + 16 * n + 6 * m + 1 + construction;
    if (required > limits.max_work) {
        return core::result::Err(error(ext::graph::ErrorKind::WorkLimit, -1));
    }
    let components: StrongComponents = components_admitted(graph)?;
    // All SCC workspaces have retired. Reserve the conservative original edge
    // count before mapping, even if most edges will remain within components.
    let reserved: core::result::Result<alloc::vec::Vec<ext::graph::Edge>, alloc::vec::Error> =
        alloc::vec::with_capacity<ext::graph::Edge>(graph.targets.length);
    if (reserved.is_err()) {
        components.destroy();
        return core::result::Err(error(ext::graph::ErrorKind::AllocationFailed, -1));
    }
    let edges: alloc::vec::Vec<ext::graph::Edge> = reserved.unwrap();
    let node: i32 = 0;
    while (node < graph.nodes) {
        let source: i32 = components.labels.at(node);
        let edge: i32 = integer(graph.offsets, node);
        let end: i32 = integer(graph.offsets, node + 1);
        while (edge < end) {
            let target: i32 = components.labels.at(integer(graph.targets, edge));
            if (source != target) {
                edges.try_push(ext::graph::Edge { source: source, target: target }).unwrap();
            }
            edge += 1;
        }
        node += 1;
    }
    // Actual component/pair counts are bounded by n/m, so this constructor's
    // capacities and admission estimate are covered by the outer preflight.
    let made: core::result::Result<ext::graph::Graph, ext::graph::Error> =
        ext::graph::from_edges(components.count, edges.as_view(), limits);
    edges.destroy();
    if (made.is_err()) {
        components.destroy();
        return core::result::Err(made.unwrap_err());
    }
    return core::result::Ok(Condensation {
        components: components, graph: made.unwrap(), active: true,
    });
}
