// Portable TLS1.3 SHA256/Ed25519 server authentication flight, RFC8446 4.4.
// Caller has checked CH/SH negotiation and supplies authenticated record content.
module ext::tls_authentication;
import core::iter;
import core::option;
import core::result;
import core::sha256;
import core::slice;
import ext::ed25519;
import ext::service_identity;
import ext::tls_handshake;
import ext::tls_schedule;
import ext::tls_transcript;
import ext::x509_path;

pub const MAX_CERTIFICATES: i32 = 8;
pub enum Phase { EncryptedExtensions, Certificate, CertificateVerify, Finished, Authenticated, Failed }
pub enum Error {
    Bounds, InvalidLimit, InvalidSecretLength, InvalidTranscript, EmptyAnchors,
    AnchorLimit, SignatureScheme, FrameLimit, WorkLimit, SignatureLimit,
    ScratchTooSmall, UnexpectedMessage, Handshake(ext::tls_handshake::Error),
    CertificateContext, EmptyCertificate, CertificateLimit, CertificateExtensions,
    Path(ext::x509_path::Error), CertificateVerify, Finished, Transcript
}
pub struct Config {
    anchors: core::slice::View<core::slice::View<u8>>,
    reference: ext::service_identity::Reference,
    unix_time: i64,
    max_frame: i32
}
// Use server()/methods. Fields are not a trusted resume or serialization format.
// Copies own independent inline progress/key/hash, and borrow the same anchors.
pub struct State {
    hash: ext::tls_transcript::State, secret: [u8;32],
    anchors: core::slice::View<core::slice::View<u8>>,
    reference: ext::service_identity::Reference, unix_time: i64, max_frame: i32,
    step: i32, failed: bool, issue: Error, leaf: ext::ed25519::Key32
}
fn valid<T>(value: core::slice::View<T>) -> bool { return value.start>=0 && value.length>=0 && value.start<=2147483647-value.length; }

pub fn server(transcript: ext::tls_transcript::State, server_handshake_secret: core::slice::View<u8>, offered_signature_schemes: core::slice::View<u16>, config: Config) -> core::result::Result<State,Error> {
    if (!valid(server_handshake_secret) || !valid(offered_signature_schemes) || !valid(config.anchors)) { return core::result::Err(Error::Bounds); }
    if (config.anchors.length == 0) { return core::result::Err(Error::EmptyAnchors); }
    if (config.anchors.length > 8) { return core::result::Err(Error::AnchorLimit); }
    let index: i32=0;
    while (index < config.anchors.length) { if (!valid(config.anchors.values[config.anchors.start+index])) { return core::result::Err(Error::Bounds); } index+=1; }
    if (config.max_frame < 4 || config.max_frame > 16777219) { return core::result::Err(Error::InvalidLimit); }
    if (server_handshake_secret.length != 32) { return core::result::Err(Error::InvalidSecretLength); }
    if (offered_signature_schemes.length < 1 || offered_signature_schemes.length > 32767) { return core::result::Err(Error::SignatureScheme); }
    let offered: bool=false; index=0;
    while (index < offered_signature_schemes.length) { if (offered_signature_schemes.values[offered_signature_schemes.start+index] == 2055) { offered=true; } index+=1; }
    if (!offered) { return core::result::Err(Error::SignatureScheme); }
    // A shape check, not proof of CH/SH negotiation or transcript provenance.
    let count: u64=transcript.messages(); let hrr: bool=transcript.used_hrr();
    if ((!hrr && count != 2) || (hrr && count != 4)) { return core::result::Err(Error::InvalidTranscript); }
    let secret: [u8;32]=[0;32]; index=0;
    while (index < 32) { secret[index]=server_handshake_secret.values[server_handshake_secret.start+index]; index+=1; }
    return core::result::Ok(State { hash: transcript, secret: secret, anchors: config.anchors, reference: config.reference, unix_time: config.unix_time, max_frame: config.max_frame, step: 0, failed: false, issue: Error::UnexpectedMessage, leaf: ext::ed25519::Key32 { bytes: [0;32] } });
}
impl State {
    fn latch(&self, issue: Error) -> Error {
        if (!self.failed) { self.failed=true; self.issue=issue; }
        return self.issue;
    }
    fn poison(&self, issue: Error) -> core::result::Result<Phase,Error> { return core::result::Err(self.latch(issue)); }
    fn append(&self, frame: core::slice::View<u8>) -> bool {
        let result: core::result::Result<i32,ext::tls_transcript::Error> = self.hash.update(frame);
        return result.is_ok();
    }
    fn certificate(&self, body: core::slice::View<u8>, scratch: core::slice::View<ext::x509_path::Slot>, budget: &ext::x509_path::Budget) -> core::result::Result<ext::ed25519::Key32,Error> {
        let parsed: core::result::Result<ext::tls_handshake::Certificate,ext::tls_handshake::Error> = ext::tls_handshake::parse_certificate(body);
        if (parsed.is_err()) { return core::result::Err(self.latch(Error::Handshake(parsed.unwrap_err()))); }
        let certificate: ext::tls_handshake::Certificate=parsed.unwrap();
        if (certificate.context.length != 0) { return core::result::Err(self.latch(Error::CertificateContext)); }
        if (certificate.entries.length == 0) { return core::result::Err(self.latch(Error::EmptyCertificate)); }
        let made: core::result::Result<ext::tls_handshake::CertificateCursor,ext::tls_handshake::Error> = ext::tls_handshake::certificate_entries(certificate.entries);
        if (made.is_err()) { return core::result::Err(self.latch(Error::Handshake(made.unwrap_err()))); }
        let cursor: ext::tls_handshake::CertificateCursor=made.unwrap();
        let empty: core::slice::View<u8> = core::slice::View { values: body.values, start: body.start, length: 0 };
        // Descriptor-only list. Parsed Certificate records live in caller scratch.
        let entries: [core::slice::View<u8>;8]=[empty;8]; let count: i32=0; let done: bool=false;
        while (!done) {
            let next: core::option::Option<ext::tls_handshake::CertificateEntry> = cursor.next();
            if (next.is_none()) { done=true; }
            else {
                let entry: ext::tls_handshake::CertificateEntry=next.unwrap();
                if (count == 8) { return core::result::Err(self.latch(Error::CertificateLimit)); }
                // No negotiated OCSP/SCT/other CertificateEntry extension support.
                if (entry.extensions.length != 0) { return core::result::Err(self.latch(Error::CertificateExtensions)); }
                entries[count]=entry.data; count+=1;
            }
        }
        if (scratch.length < count+self.anchors.length) { return core::result::Err(Error::ScratchTooSmall); }
        let chain: core::slice::View<core::slice::View<u8>> = core::slice::View { values: entries, start: 0, length: count };
        let validated: core::result::Result<ext::x509_path::ValidatedServer,ext::x509_path::Error> = ext::x509_path::validate_server(chain,self.anchors,self.reference,self.unix_time,scratch,budget);
        if (validated.is_err()) { return core::result::Err(self.latch(Error::Path(validated.unwrap_err()))); }
        return core::result::Ok(validated.unwrap().public_key);
    }
    fn verify(&self, body: core::slice::View<u8>, budget: &ext::x509_path::Budget) -> core::result::Result<Phase,Error> {
        let parsed: core::result::Result<ext::tls_handshake::CertificateVerify,ext::tls_handshake::Error> = ext::tls_handshake::parse_certificate_verify(body);
        if (parsed.is_err()) { return self.poison(Error::Handshake(parsed.unwrap_err())); }
        let proof: ext::tls_handshake::CertificateVerify=parsed.unwrap();
        if (proof.algorithm != 2055 || proof.signature.length != 64) { return self.poison(Error::SignatureScheme); }
        if (budget.signatures_left == 0) { return self.poison(Error::SignatureLimit); }
        budget.signatures_left-=1;
        let digest: core::sha256::Digest=self.hash.snapshot(); let signed: [u8;130]=[0;130];
        let context: [u8;33]=[84,76,83,32,49,46,51,44,32,115,101,114,118,101,114,32,67,101,114,116,105,102,105,99,97,116,101,86,101,114,105,102,121];
        let index: i32=0; while (index < 64) { signed[index]=32; index+=1; }
        index=0; while (index < 33) { signed[64+index]=context[index]; index+=1; }
        index=0; while (index < 32) { signed[98+index]=digest.bytes[index]; index+=1; }
        let checked: core::result::Result<bool,ext::ed25519::Error> = ext::ed25519::verify(core::slice::View { values: self.leaf.bytes, start: 0, length: 32 },core::slice::View { values: signed, start: 0, length: 130 },proof.signature);
        if (checked.is_err()) { return self.poison(Error::CertificateVerify); }
        if (!checked.unwrap()) { return self.poison(Error::CertificateVerify); }
        return core::result::Ok(Phase::Finished);
    }
    fn finished(&self, body: core::slice::View<u8>) -> core::result::Result<Phase,Error> {
        let parsed: core::result::Result<ext::tls_handshake::Finished,ext::tls_handshake::Error> = ext::tls_handshake::parse_finished(body,32);
        if (parsed.is_err()) { return self.poison(Error::Handshake(parsed.unwrap_err())); }
        let digest: core::sha256::Digest=self.hash.snapshot(); let proof: ext::tls_handshake::Finished=parsed.unwrap();
        let checked: core::result::Result<bool,ext::tls_schedule::Error> = ext::tls_schedule::verify_finished(core::slice::View { values: self.secret, start: 0, length: 32 },core::slice::View { values: digest.bytes, start: 0, length: 32 },proof.verify_data);
        if (checked.is_err()) { return self.poison(Error::Finished); }
        if (!checked.unwrap()) { return self.poison(Error::Finished); }
        return core::result::Ok(Phase::Authenticated);
    }
}
pub impl State {
    pub fn borrow(&self) -> &State { return self; }
    pub fn phase(&self) -> Phase {
        if (self.failed) { return Phase::Failed; }
        if (self.step == 0) { return Phase::EncryptedExtensions; }
        if (self.step == 1) { return Phase::Certificate; }
        if (self.step == 2) { return Phase::CertificateVerify; }
        if (self.step == 3) { return Phase::Finished; }
        return Phase::Authenticated;
    }
    pub fn is_poisoned(&self) -> bool { return self.failed; }
    pub fn authenticated(&self) -> bool { return !self.failed && self.step == 4; }
    pub fn failure(&self) -> core::option::Option<Error> { if (self.failed) { return core::option::Some(self.issue); } return core::option::None(); }
    // Returned key/hash state own inline bytes; no input/config/scratch borrow.
    pub fn peer_key(&self) -> core::option::Option<ext::ed25519::Key32> { if (!self.authenticated()) { return core::option::None(); } return core::option::Some(self.leaf); }
    pub fn transcript(&self) -> core::option::Option<ext::tls_transcript::State> { if (!self.authenticated()) { return core::option::None(); } return core::option::Some(self.hash); }
    // Frame and scratch need physical backing, disjoint from State, Budget and
    // anchors. Scratch is used/validated only in Certificate, never retained.
    pub fn feed(&self, frame: core::slice::View<u8>, certificate_scratch: core::slice::View<ext::x509_path::Slot>, budget: &ext::x509_path::Budget) -> core::result::Result<Phase,Error> {
        if (!valid(frame)) { return core::result::Err(Error::Bounds); }
        if (self.failed) { return core::result::Err(self.issue); }
        if (self.step == 1 && !valid(certificate_scratch)) { return core::result::Err(Error::Bounds); }
        if (self.step == 4) { return self.poison(Error::UnexpectedMessage); }
        if (frame.length > self.max_frame || (frame.length as u64) > budget.limits.max_input) { return self.poison(Error::FrameLimit); }
        // Conservative syntax/copy tariff: covers all possible nested extension
        // bitmap clears before eager Certificate parsing traverses the list.
        let cost: u64=4096+256*(frame.length as u64);
        if (cost > budget.work_left) { return self.poison(Error::WorkLimit); }
        budget.work_left-=cost;
        let parsed: core::result::Result<ext::tls_handshake::Frame,ext::tls_handshake::Error> = ext::tls_handshake::parse_frame(frame);
        if (parsed.is_err()) { return self.poison(Error::Handshake(parsed.unwrap_err())); }
        let message: ext::tls_handshake::Frame=parsed.unwrap();
        let expected: u8=8; if (self.step == 1) { expected=11; } if (self.step == 2) { expected=15; } if (self.step == 3) { expected=20; }
        if (message.kind != expected) { return self.poison(Error::UnexpectedMessage); }
        let next: core::result::Result<Phase,Error> = core::result::Ok(Phase::Certificate);
        let selected: ext::ed25519::Key32=self.leaf;
        if (self.step == 0) {
            let checked: core::result::Result<ext::tls_handshake::EncryptedExtensions,ext::tls_handshake::Error> = ext::tls_handshake::parse_encrypted_extensions(message.body);
            if (checked.is_err()) { return self.poison(Error::Handshake(checked.unwrap_err())); }
            // Extension negotiation/meaning must be checked by the caller.
        }
        if (self.step == 1) {
            let checked: core::result::Result<ext::ed25519::Key32,Error> = self.certificate(message.body,certificate_scratch,budget);
            if (checked.is_err()) { return core::result::Err(checked.unwrap_err()); }
            selected=checked.unwrap();
        }
        if (self.step == 2) { next=self.verify(message.body,budget); }
        if (self.step == 3) { next=self.finished(message.body); }
        if (next.is_err()) { return next; }
        if (!self.append(frame)) { return self.poison(Error::Transcript); }
        if (self.step == 1) { self.leaf=selected; }
        self.step+=1;
        return core::result::Ok(self.phase());
    }
}
