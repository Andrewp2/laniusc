// Original radix-2^16 arithmetic and RFC 7748 section 5 Montgomery ladder.
// No allocation. See docs/extended-x25519.md for bounds and verification scope.
module ext::x25519;
import core::result;
import core::slice;
import core::u64;

pub enum Error { Bounds, InvalidScalarLength, InvalidPointLength, LowOrder }
pub struct Key { bytes: [u8; 32] }
struct Field { limbs: [u64; 16] }
struct Pair { first: Field, second: Field }
fn valid(value: core::slice::View<u8>) -> bool {
    return value.start >= 0 && value.length >= 0 && value.start <= 2147483647 - value.length;
}
fn prime(index: i32) -> u64 {
    if (index == 0) { return 65517; } if (index == 15) { return 32767; } return 65535;
}
fn small(value: u64) -> Field {
    let limbs: [u64; 16] = [0; 16]; limbs[0] = value & 65535; limbs[1] = value >> 16;
    return Field { limbs: limbs };
}
// Input coefficients are nonnegative, lower limbs <2^42 and top <2^37.
// After the first pass low limb <2^28, other limbs radix-sized. The second
// can carry at most one out of the top; a third resolves that possible wrap.
fn reduce(value: Field) -> Field {
    let result: Field = value; let pass: i32 = 0;
    while (pass < 3) {
        let index: i32 = 0;
        while (index < 15) {
            result.limbs[index + 1] += result.limbs[index] >> 16;
            result.limbs[index] &= 65535; index += 1;
        }
        let carry: u64 = result.limbs[15] >> 15;
        result.limbs[15] &= 32767; result.limbs[0] += carry * 19; pass += 1;
    }
    // Radix subtraction with borrow in {0,1}; the added radix keeps every
    // temporary nonnegative. Select r-p exactly when its final borrow is zero.
    let difference: [u64; 16] = [0; 16]; let borrow: u64 = 0; let index: i32 = 0;
    while (index < 16) {
        let next: u64 = result.limbs[index] + 65536 - prime(index) - borrow;
        difference[index] = next & 65535; borrow = 1 - (next >> 16); index += 1;
    }
    let mask: u64 = core::u64::wrapping_sub(0, 1 - borrow); index = 0;
    while (index < 16) {
        result.limbs[index] = (result.limbs[index] & (mask ^ 18446744073709551615)) | (difference[index] & mask); index += 1;
    }
    return result;
}
fn add(left: Field, right: Field) -> Field {
    let limbs: [u64; 16] = [0; 16]; let index: i32 = 0;
    while (index < 16) { limbs[index] = left.limbs[index] + right.limbs[index]; index += 1; }
    return reduce(Field { limbs: limbs });
}
fn subtract(left: Field, right: Field) -> Field {
    let limbs: [u64; 16] = [0; 16]; let index: i32 = 0;
    while (index < 16) { limbs[index] = left.limbs[index] + 2 * prime(index) - right.limbs[index]; index += 1; }
    return reduce(Field { limbs: limbs });
}
fn multiply(left: Field, right: Field) -> Field {
    let product: [u64; 32] = [0; 32]; let first: i32 = 0;
    while (first < 16) {
        let second: i32 = 0;
        while (second < 16) { product[first + second] += left.limbs[first] * right.limbs[second]; second += 1; }
        first += 1;
    }
    // Each unfurled coefficient <16*2^32=2^36. Folding the upper half
    // through 2^256 == 38 (mod p) stays below 2^42, with carry headroom.
    let limbs: [u64; 16] = [0; 16]; first = 0;
    while (first < 16) { limbs[first] = product[first] + 38 * product[first + 16]; first += 1; }
    return reduce(Field { limbs: limbs });
}
fn square(value: Field) -> Field { return multiply(value, value); }
fn multiply_small(value: Field, factor: u64) -> Field {
    let limbs: [u64; 16] = [0; 16]; let index: i32 = 0;
    while (index < 16) { limbs[index] = value.limbs[index] * factor; index += 1; }
    return reduce(Field { limbs: limbs });
}
fn swap(left: Field, right: Field, selected: u64) -> Pair {
    let first: Field = left; let second: Field = right;
    let mask: u64 = core::u64::wrapping_sub(0, selected); let index: i32 = 0;
    while (index < 16) {
        let changed: u64 = mask & (first.limbs[index] ^ second.limbs[index]);
        first.limbs[index] ^= changed; second.limbs[index] ^= changed; index += 1;
    }
    return Pair { first: first, second: second };
}
fn inverse(value: Field) -> Field {
    // p-2 = 2^255-21: bits 254..0 are one except bits 4 and 2. These
    // branches depend only on the fixed exponent position, never field data.
    let result: Field = small(1); let bit: i32 = 254;
    while (bit >= 0) {
        result = square(result); if (bit != 4 && bit != 2) { result = multiply(result, value); } bit -= 1;
    }
    return result;
}
fn calculate(scalar: core::slice::View<u8>, point: core::slice::View<u8>) -> Key {
    let secret: [u8; 32] = [0; 32]; let index: i32 = 0;
    while (index < 32) { secret[index] = scalar.values[scalar.start + index]; index += 1; }
    secret[0] &= 248; secret[31] = (secret[31] & 127) | 64;
    let limbs: [u64; 16] = [0; 16]; index = 0;
    while (index < 16) {
        limbs[index] = (point.values[point.start + 2 * index] as u64) | ((point.values[point.start + 2 * index + 1] as u64) << 8); index += 1;
    }
    limbs[15] &= 32767; let x1: Field = reduce(Field { limbs: limbs });
    let x2: Field = small(1); let z2: Field = small(0); let x3: Field = x1; let z3: Field = small(1);
    let previous: u64 = 0; let bit: i32 = 254;
    while (bit >= 0) {
        let selected: u64 = ((secret[bit / 8] >> (bit % 8)) & 1) as u64;
        let xs: Pair = swap(x2, x3, previous ^ selected); let zs: Pair = swap(z2, z3, previous ^ selected);
        x2 = xs.first; x3 = xs.second; z2 = zs.first; z3 = zs.second; previous = selected;
        let a: Field = add(x2, z2); let aa: Field = square(a); let b: Field = subtract(x2, z2); let bb: Field = square(b);
        let e: Field = subtract(aa, bb); let c: Field = add(x3, z3); let d: Field = subtract(x3, z3);
        let da: Field = multiply(d, a); let cb: Field = multiply(c, b);
        x3 = square(add(da, cb)); z3 = multiply(x1, square(subtract(da, cb)));
        x2 = multiply(aa, bb); z2 = multiply(e, add(aa, multiply_small(e, 121665))); bit -= 1;
    }
    let xs: Pair = swap(x2, x3, previous); let zs: Pair = swap(z2, z3, previous);
    let result: Field = multiply(xs.first, inverse(zs.first)); let bytes: [u8; 32] = [0; 32]; index = 0;
    while (index < 16) { bytes[2 * index] = (result.limbs[index] & 255) as u8; bytes[2 * index + 1] = (result.limbs[index] >> 8) as u8; index += 1; }
    return Key { bytes: bytes };
}
pub fn shared_secret(scalar: core::slice::View<u8>, point: core::slice::View<u8>) -> core::result::Result<Key, Error> {
    if (!valid(scalar) || !valid(point)) { return core::result::Err(Error::Bounds); }
    if (scalar.length != 32) { return core::result::Err(Error::InvalidScalarLength); }
    if (point.length != 32) { return core::result::Err(Error::InvalidPointLength); }
    let key: Key = calculate(scalar, point); let aggregate: u8 = 0; let index: i32 = 0;
    while (index < 32) { aggregate |= key.bytes[index]; index += 1; }
    if (aggregate == 0) { return core::result::Err(Error::LowOrder); } return core::result::Ok(key);
}
pub fn public_key(scalar: core::slice::View<u8>) -> core::result::Result<Key, Error> {
    if (!valid(scalar)) { return core::result::Err(Error::Bounds); }
    if (scalar.length != 32) { return core::result::Err(Error::InvalidScalarLength); }
    let base: [u8; 32] = [0; 32]; base[0] = 9;
    return shared_secret(scalar, core::slice::View { values: base, start: 0, length: 32 });
}
