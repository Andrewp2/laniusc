// Streaming RFC 8949 codec over ext::cbor events. The Decoder accepts input in
// arbitrary chunks and yields events as soon as each head (and string payload)
// is buffered; the Writer encodes one call per item into a buffer that can be
// flushed to core::io::Write. Both have an optional core deterministic mode
// (RFC 8949 section 4.2.1): preferred heads, definite lengths, shortest exact
// floats, and map keys unique and sorted by bytewise order of their encodings.
// Errors carry u64 byte offsets. See docs/extended-cbor.md.
module ext::cbor_stream;
import core::parse_state;
import core::lifecycle;
import core::stream_state;
import core::iter_state;
import alloc::vec;
import core::io;
import core::mem;
import core::option;
import core::result;
import core::slice;
import core::text;
import ext::cbor;

fn pair_bit(pair: core::parse_state::PairPhase) -> u8 { if (pair.needs_value()) { return 1; } return 0; }


pub enum ErrorKind {
    InvalidOptions, AllocationFailed, Bounds, Finished, InputLimit, OutputLimit,
    DepthLimit, ItemLimit, StringLimit, UnexpectedEnd, InvalidHead, InvalidSimple,
    InvalidUtf8, UnexpectedBreak, ChunkType, OddMap, TrailingData, NotPreferred,
    Indefinite, FloatNotShortest, UnsortedKeys, DuplicateKey, InvalidPlacement,
    CountMismatch, InvalidValue,
}
pub struct Error { kind: ErrorKind, offset: u64 }
pub struct Options { max_depth: i32, max_items: u64, max_string_bytes: i32, max_input: u64, deterministic: bool, sequence: bool }
pub struct WriterOptions { max_depth: i32, max_output_bytes: i32, deterministic: bool, sequence: bool }

pub fn default_options() -> Options {
    return Options { max_depth: 128, max_items: 1000000, max_string_bytes: 16777216, max_input: 67108864, deterministic: false, sequence: false };
}
pub fn default_writer_options() -> WriterOptions {
    return WriterOptions { max_depth: 128, max_output_bytes: 67108864, deterministic: false, sequence: false };
}
fn error(kind: ErrorKind, offset: u64) -> Error { return Error { kind: kind, offset: offset }; }
fn lit(value: str, count: i32) -> core::text::Text {
    let bytes: [u8] = core::mem::typed_slice_from_raw_parts<u8>(core::mem::string_data_ptr(value), count);
    return core::text::from_utf8_unchecked(bytes, 0, count);
}

// Stable names for diagnostics and tests.
pub fn kind_name(kind: ErrorKind) -> core::text::Text {
    let name: core::text::Text = match (kind) {
        ErrorKind::InvalidOptions -> lit("InvalidOptions", 14),
        ErrorKind::AllocationFailed -> lit("AllocationFailed", 16),
        ErrorKind::Bounds -> lit("Bounds", 6),
        ErrorKind::Finished -> lit("Finished", 8),
        ErrorKind::InputLimit -> lit("InputLimit", 10),
        ErrorKind::OutputLimit -> lit("OutputLimit", 11),
        ErrorKind::DepthLimit -> lit("DepthLimit", 10),
        ErrorKind::ItemLimit -> lit("ItemLimit", 9),
        ErrorKind::StringLimit -> lit("StringLimit", 11),
        ErrorKind::UnexpectedEnd -> lit("UnexpectedEnd", 13),
        ErrorKind::InvalidHead -> lit("InvalidHead", 11),
        ErrorKind::InvalidSimple -> lit("InvalidSimple", 13),
        ErrorKind::InvalidUtf8 -> lit("InvalidUtf8", 11),
        ErrorKind::UnexpectedBreak -> lit("UnexpectedBreak", 15),
        ErrorKind::ChunkType -> lit("ChunkType", 9),
        ErrorKind::OddMap -> lit("OddMap", 6),
        ErrorKind::TrailingData -> lit("TrailingData", 12),
        ErrorKind::NotPreferred -> lit("NotPreferred", 12),
        ErrorKind::Indefinite -> lit("Indefinite", 10),
        ErrorKind::FloatNotShortest -> lit("FloatNotShortest", 16),
        ErrorKind::UnsortedKeys -> lit("UnsortedKeys", 12),
        ErrorKind::DuplicateKey -> lit("DuplicateKey", 12),
        ErrorKind::InvalidPlacement -> lit("InvalidPlacement", 16),
        ErrorKind::CountMismatch -> lit("CountMismatch", 13),
        ErrorKind::InvalidValue -> lit("InvalidValue", 12),
    };
    return name;
}

// Exact narrowing between IEEE binary formats given exponent and fraction
// widths. Returns the narrower bits, or -1 when the value (or NaN payload)
// cannot be represented exactly.
fn narrow(bits: u64, source_exponent: i32, source_fraction: i32, target_exponent: i32, target_fraction: i32) -> i64 {
    let sign: u64 = (bits >> (source_exponent + source_fraction)) & 1;
    let exponent: i64 = ((bits >> source_fraction) & ((1 << source_exponent) - 1)) as i64;
    let fraction: u64 = bits & ((1 << source_fraction) - 1);
    let drop: i32 = source_fraction - target_fraction;
    let dropped: u64 = (1 << drop) - 1;
    let signed: u64 = sign << (target_exponent + target_fraction);
    let source_max: i64 = (1 << source_exponent) - 1;
    let target_max: u64 = (1 << target_exponent) - 1;
    if (exponent == source_max) {
        if ((fraction & dropped) != 0) { return -1; }
        return (signed | (target_max << target_fraction) | (fraction >> drop)) as i64;
    }
    if (exponent == 0) { if (fraction == 0) { return signed as i64; } return -1; }
    let source_bias: i64 = (1 << (source_exponent - 1)) - 1;
    let target_bias: i64 = (1 << (target_exponent - 1)) - 1;
    let unbiased: i64 = exponent - source_bias;
    if (unbiased > target_bias) { return -1; }
    if (unbiased >= 1 - target_bias) {
        if ((fraction & dropped) != 0) { return -1; }
        return (signed | (((unbiased + target_bias) as u64) << target_fraction) | (fraction >> drop)) as i64;
    }
    let shift: i64 = (drop as i64) + (1 - target_bias - unbiased);
    if (shift > (source_fraction as i64)) { return -1; }
    let significand: u64 = fraction | (1 << source_fraction);
    if ((significand & ((1 << shift) - 1)) != 0) { return -1; }
    return (signed | (significand >> shift)) as i64;
}
// Shortest exact float width for float64 bits: 2, 4 or 8 bytes, with the bits.
pub fn narrow_f64_to_f32(bits: u64) -> i64 { return narrow(bits, 11, 52, 8, 23); }
pub fn narrow_f32_to_f16(bits: u32) -> i64 { return narrow(bits as u64, 8, 23, 5, 10); }
// Exact widening of half and single bits to double bits.
pub fn widen_f16(bits: u32) -> u64 { return widen(bits as u64, 5, 10); }
pub fn widen_f32(bits: u32) -> u64 { return widen(bits as u64, 8, 23); }
fn widen(bits: u64, exponent_bits: i32, fraction_bits: i32) -> u64 {
    let sign: u64 = (bits >> (exponent_bits + fraction_bits)) & 1;
    let exponent: i64 = ((bits >> fraction_bits) & ((1 << exponent_bits) - 1)) as i64;
    let fraction: u64 = bits & ((1 << fraction_bits) - 1);
    let top: u64 = sign << 63;
    let shift: i32 = 52 - fraction_bits;
    if (exponent == (1 << exponent_bits) - 1) { return top | (2047 << 52) | (fraction << shift); }
    let bias: i64 = (1 << (exponent_bits - 1)) - 1;
    if (exponent == 0) {
        if (fraction == 0) { return top; }
        let scale: i64 = 1 - bias;
        while ((fraction & (1 << fraction_bits)) == 0) { fraction = fraction << 1; scale -= 1; }
        fraction = fraction & ((1 << fraction_bits) - 1);
        return top | (((scale + 1023) as u64) << 52) | (fraction << shift);
    }
    return top | (((exponent - bias + 1023) as u64) << 52) | (fraction << shift);
}

fn preferred(additional: i32, argument: u64) -> bool {
    if (additional == 24) { return argument >= 24; }
    if (additional == 25) { return argument > 255; }
    if (additional == 26) { return argument > 65535; }
    if (additional == 27) { return argument > 4294967295; }
    return true;
}
// Bytewise lexicographic order; a proper prefix sorts first.
fn compare(left: [u8], left_start: i32, left_length: i32, right: [u8], right_start: i32, right_length: i32) -> i32 {
    let index: i32 = 0;
    while (index < left_length && index < right_length) {
        let a: u8 = left[left_start + index]; let b: u8 = right[right_start + index];
        if (a < b) { return -1; } if (a > b) { return 1; }
        index += 1;
    }
    if (left_length < right_length) { return -1; } if (left_length > right_length) { return 1; }
    return 0;
}
fn valid_utf8(bytes: [u8], start: i32, length: i32) -> bool { return core::result::is_ok(core::text::from_utf8_range(bytes, start, length)); }

const NO_KEY: u64 = 18446744073709551615;
// Words per saved frame in Decoder.stack.
const FRAME: i32 = 6;

// Frame kinds follow ext::cbor: 4 definite array, 5 definite map, 6 tag,
// 11..14 indefinite bytes, text, array, map; 0 at the root. The innermost
// frame lives in scalar fields so the per-event path touches no vector:
// `left` counts the items (map pairs) still due and is NO_KEY for frames
// without a count, `pair` awaits a value after a map key, `chunked` sums indefinite
// string chunks, and key_at/key_from/key_len track the deterministic key
// order. Enclosing frames are saved FRAME words each in `stack`, a cached
// view of `frames`. `data` and `end` cache buf.as_slice() and buf.len().
pub struct Decoder {
    options: Options, buf: alloc::vec::Vec<u8>, data: [u8], begin: i32, end: i32, base: u64,
    depth: i32, kind: u8, left: u64, pair: core::parse_state::PairPhase, chunked: u64, key_at: u64, key_from: i32, key_len: i32,
    frames: alloc::vec::Vec<u64>, stack: [u64], keys: alloc::vec::Vec<u8>,
    items: u64, roots: u64, root: core::iter_state::Completion,   failure: Error,
    current: ext::cbor::Event, current_at: u64, delivery: core::stream_state::Delivery,
}

pub fn decoder(options: Options) -> core::result::Result<Decoder, Error> {
    if (options.max_depth < 0 || options.max_string_bytes < 0) { return core::result::Err(error(ErrorKind::InvalidOptions, 0)); }
    let buf: alloc::vec::Vec<u8> = alloc::vec::new(); let frames: alloc::vec::Vec<u64> = alloc::vec::new();
    return core::result::Ok(Decoder { options: options, buf: buf, data: buf.as_slice(), begin: 0, end: 0, base: 0,
        depth: 0, kind: 0, left: NO_KEY, pair: core::parse_state::pair_phase_start(), chunked: 0, key_at: NO_KEY, key_from: 0, key_len: -1,
        frames: frames, stack: frames.as_slice(), keys: alloc::vec::new(),
        items: 0, roots: 0, root: core::iter_state::completion_start(),   failure: error(ErrorKind::InvalidOptions, 0),
        current: ext::cbor::Event::End, current_at: 0, delivery: core::stream_state::delivery_start() });
}

pub impl Decoder {
    pub fn borrow(&self) -> &Decoder { return self; }
    pub fn depth(&self) -> i32 { return self.depth; }
    // Bytes consumed by returned events.
    pub fn byte_offset(&self) -> u64 { return self.base + (self.begin as u64); }
    pub fn bytes_received(&self) -> u64 { return self.base + (self.end as u64); }
    pub fn items_read(&self) -> u64 { return self.items; }
    pub fn roots_read(&self) -> u64 { return self.roots; }
    pub fn has_event(&self) -> bool { return self.delivery.ready(); }
    // The ready event. Byte and text payloads borrow the decoder buffer and
    // stay valid until the next feed or reset.
    pub fn event(&self) -> ext::cbor::Event { return self.current; }
    pub fn event_offset(&self) -> u64 { return self.current_at; }
    pub fn is_complete(&self) -> bool {
        return self.delivery.finished() && !self.delivery.failed() && self.begin == self.end && self.depth == 0 && (self.root.is_done() || self.options.sequence);
    }
    fn stop(&self, kind: ErrorKind, at: u64) { self.failure = error(kind, at); self.delivery.fail(); self.delivery.taken(); }
    fn refresh(&self) { self.data = self.buf.as_slice(); self.end = self.buf.len(); }
    fn compact(&self) {
        let keep: i32 = self.begin;
        if (self.depth > 0 && self.key_at != NO_KEY) { let relative: i32 = (self.key_at - self.base) as i32; if (relative < keep) { keep = relative; } }
        let saved: [u64] = self.stack; let index: i32 = 1;
        while (index < self.depth) {
            let start: u64 = saved[(index - 1) * FRAME + 3];
            if (start != NO_KEY) { let relative: i32 = (start - self.base) as i32; if (relative < keep) { keep = relative; } }
            index += 1;
        }
        let length: i32 = self.end;
        if (keep <= 0 || (keep < 4096 && keep * 2 < length)) { return; }
        let data: [u8] = self.data; let at: i32 = keep;
        while (at < length) { data[at - keep] = data[at]; at += 1; }
        core::result::unwrap(self.buf.truncate(length - keep));
        self.begin -= keep; self.base += keep as u64;
        self.refresh();
    }
    // Buffers count bytes of source from start. Earlier event payload views
    // become invalid.
    pub fn feed(&self, source: [u8], start: i32, count: i32) -> core::result::Result<i32, Error> {
        if (self.delivery.failed()) { return core::result::Err(self.failure); }
        if (self.delivery.finished()) { return core::result::Err(error(ErrorKind::Finished, self.bytes_received())); }
        if (!core::io::valid_range(start, count)) { return core::result::Err(error(ErrorKind::Bounds, self.bytes_received())); }
        if (count == 0) { return core::result::Ok(0); }
        if ((count as u64) > self.options.max_input - self.bytes_received() || self.bytes_received() > self.options.max_input) {
            self.failure = error(ErrorKind::InputLimit, self.options.max_input); self.delivery.fail();
            return core::result::Err(self.failure);
        }
        self.compact();
        let view: core::slice::View<u8> = core::slice::View { values: source, start: start, length: count };
        let added = self.buf.try_extend(view);
        self.refresh();
        if (added.is_err()) { return core::result::Err(error(ErrorKind::AllocationFailed, self.bytes_received())); }
        return core::result::Ok(count);
    }
    // Marks end of input. Later next() calls report incomplete items.
    pub fn finish(&self) { self.delivery.finish(); }
    pub fn reset(&self) {
        self.buf.clear(); self.refresh(); self.begin = 0; self.base = 0;
        self.depth = 0; self.kind = 0; self.left = NO_KEY; self.pair = core::parse_state::pair_phase_start(); self.chunked = 0; self.key_at = NO_KEY; self.key_from = 0; self.key_len = -1;
        self.keys.clear();
        self.items = 0; self.roots = 0; self.root = core::iter_state::completion_start(); self.delivery.reset(); self.delivery.reset();
        self.current = ext::cbor::Event::End; self.current_at = 0; self.delivery.taken();
    }
    pub fn destroy(&self) {
        self.buf.destroy(); self.frames.destroy(); self.keys.destroy();
        self.buf = alloc::vec::new(); self.frames = alloc::vec::new(); self.stack = self.frames.as_slice(); self.keys = alloc::vec::new();
        self.reset();
    }
    // Save the innermost frame (if any) and open a new one.
    fn push_frame(&self, kind: u8, remaining: u64, at: u64) -> bool {
        if (self.depth > 0) {
            let word: i32 = (self.depth - 1) * FRAME;
            if (word + FRAME > self.frames.len()) {
                if (self.frames.try_resize((word + FRAME) * 2, 0).is_err()) { self.stop(ErrorKind::AllocationFailed, at); return false; }
                self.stack = self.frames.as_slice();
            }
            let saved: [u64] = self.stack;
            saved[word] = (self.kind as u64) | ((pair_bit(self.pair) as u64) << 8); saved[word + 1] = self.left; saved[word + 2] = self.chunked;
            saved[word + 3] = self.key_at; saved[word + 4] = self.key_from as u64; saved[word + 5] = (self.key_len + 1) as u64;
        }
        self.depth += 1; self.kind = kind; self.left = remaining; self.pair = core::parse_state::pair_phase_start(); self.chunked = 0;
        self.key_at = NO_KEY; self.key_from = self.keys.len(); self.key_len = -1;
        return true;
    }
    fn pop_frame(&self) {
        core::result::unwrap(self.keys.truncate(self.key_from));
        self.depth -= 1;
        if (self.depth == 0) { self.kind = 0; self.left = NO_KEY; self.pair = core::parse_state::pair_phase_start(); return; }
        let saved: [u64] = self.stack; let word: i32 = (self.depth - 1) * FRAME;
        let packed: u64 = saved[word];
        self.kind = (packed & 255) as u8; self.pair = core::parse_state::pair_phase((packed >> 8) != 0); self.left = saved[word + 1]; self.chunked = saved[word + 2];
        self.key_at = saved[word + 3]; self.key_from = saved[word + 4] as i32; self.key_len = (saved[word + 5] as i32) - 1;
    }
    fn check_key(&self) -> bool {
        let start: u64 = self.key_at;
        let relative: i32 = (start - self.base) as i32;
        let length: i32 = self.begin - relative;
        let previous: i32 = self.key_len;
        if (previous >= 0) {
            let order: i32 = compare(self.keys.as_slice(), self.key_from, previous, self.data, relative, length);
            if (order == 0) { self.stop(ErrorKind::DuplicateKey, start); return false; }
            if (order > 0) { self.stop(ErrorKind::UnsortedKeys, start); return false; }
        }
        core::result::unwrap(self.keys.truncate(self.key_from));
        let view: core::slice::View<u8> = core::slice::View { values: self.data, start: relative, length: length };
        if (self.keys.try_extend(view).is_err()) { self.stop(ErrorKind::AllocationFailed, start); return false; }
        self.key_len = length; self.key_at = NO_KEY;
        return true;
    }
    // One item finished at the current depth. False after a failure.
    fn complete(&self) -> bool {
        let kind: u8 = self.kind;
        if (kind == 5) {
            if (self.pair.needs_value()) { self.pair = core::parse_state::pair_phase_start(); self.left -= 1; return true; }
            self.pair.advance();
            if (self.options.deterministic) { return self.check_key(); }
            return true;
        }
        if (kind == 4 || kind == 6) { self.left -= 1; return true; }
        if (kind == 0) { self.root.finish(); self.roots += 1; return true; }
        if (kind == 14) { self.pair.advance(); }
        return true;
    }
    fn note_start(&self, at: u64) {
        if (self.options.deterministic && self.kind == 5 && !self.pair.needs_value()) { self.key_at = at; }
    }
    fn close(&self, at: u64) -> i32 {
        self.pop_frame();
        if (!self.complete()) { return -1; }
        self.current = ext::cbor::Event::End; self.current_at = at; self.delivery.produced();
        return 1;
    }
    // Ok(true): event() holds the next event. Ok(false): more input is needed,
    // or, after finish(), the input is complete. Errors are sticky.
    pub fn next(&self) -> core::result::Result<bool, Error> {
        let step: i32 = self.advance();
        if (step < 0) { return core::result::Err(self.failure); }
        return core::result::Ok(step > 0);
    }
    // The error of a failed decoder (the one next() returns); only
    // meaningful after a failure.
    pub fn last_error(&self) -> Error { return self.failure; }
    // next() without the Result: 1 event ready, 0 more input needed or input
    // complete, -1 failed (see last_error()). Checks run in a fixed order per
    // head; the branches below repeat that order for each major type.
    pub fn advance(&self) -> i32 {
        if (self.delivery.failed()) { return -1; }
        self.delivery.taken();
        let begin: i32 = self.begin;
        let at: u64 = self.base + (begin as u64);
        if (self.left == 0 && !self.pair.needs_value()) { return self.close(at); }
        let available: i32 = self.end - begin;
        if (self.root.is_done()) {
            if (available == 0) { return 0; }
            if (!self.options.sequence) { self.stop(ErrorKind::TrailingData, at); return -1; }
            self.root = core::iter_state::completion_start();
        }
        if (available == 0) {
            if (self.delivery.finished() && !(self.options.sequence && self.depth == 0)) { self.stop(ErrorKind::UnexpectedEnd, at); return -1; }
            return 0;
        }
        let data: [u8] = self.data;
        let first: i32 = data[begin] as i32;
        let major: i32 = first >> 5; let additional: i32 = first & 31;
        let argument: u64 = additional as u64;
        let width: i32 = 0;
        if (additional >= 24) {
            if (additional >= 28 && additional <= 30) { self.stop(ErrorKind::InvalidHead, at); return -1; }
            if (additional <= 27) {
                width = 1 << (additional - 24);
                if (available < 1 + width) { if (self.delivery.finished()) { self.stop(ErrorKind::UnexpectedEnd, at); return -1; } return 0; }
                argument = data[begin + 1] as u64;
                if (width >= 2) { argument = (argument << 8) | (data[begin + 2] as u64); }
                if (width >= 4) {
                    argument = (argument << 16) | ((data[begin + 3] as u64) << 8) | (data[begin + 4] as u64);
                    if (width == 8) {
                        argument = (argument << 32) | ((data[begin + 5] as u64) << 24) | ((data[begin + 6] as u64) << 16) |
                            ((data[begin + 7] as u64) << 8) | (data[begin + 8] as u64);
                    }
                }
            }
        }
        let parent: u8 = self.kind;
        let chunks: bool = parent == 11 || parent == 12;
        if (additional == 31) {
            if (major == 0 || major == 1 || major == 6) { self.stop(ErrorKind::InvalidHead, at); return -1; }
            if (major == 7) {
                if (self.depth == 0) { self.stop(ErrorKind::UnexpectedBreak, at); return -1; }
                if (parent == 14 && self.pair.needs_value()) { self.stop(ErrorKind::OddMap, at); return -1; }
                if (parent < 11) { self.stop(ErrorKind::UnexpectedBreak, at); return -1; }
                self.begin = begin + 1;
                return self.close(at);
            }
            if (self.options.deterministic) { self.stop(ErrorKind::Indefinite, at); return -1; }
            if (chunks) { self.stop(ErrorKind::ChunkType, at); return -1; }
            if (self.items >= self.options.max_items) { self.stop(ErrorKind::ItemLimit, at); return -1; }
            if (self.depth >= self.options.max_depth) { self.stop(ErrorKind::DepthLimit, at); return -1; }
            if (self.options.deterministic) { self.note_start(at); }
            if (!self.push_frame((major + 9) as u8, NO_KEY, at)) { return -1; }
            self.items += 1; self.begin = begin + 1;
            let opened: ext::cbor::Event = ext::cbor::Event::BeginMap;
            if (major == 2) { opened = ext::cbor::Event::BeginBytes; }
            if (major == 3) { opened = ext::cbor::Event::BeginText; }
            if (major == 4) { opened = ext::cbor::Event::BeginArray; }
            self.current = opened; self.current_at = at; self.delivery.produced();
            return 1;
        }
        let data_start: i32 = begin + 1 + width;
        let event: ext::cbor::Event = ext::cbor::Event::End;
        if (major == 7) {
            if (additional == 24 && argument < 32) { self.stop(ErrorKind::InvalidSimple, at); return -1; }
            if (self.options.deterministic) {
                if (additional == 26 && narrow_f32_to_f16(argument as u32) >= 0) { self.stop(ErrorKind::FloatNotShortest, at); return -1; }
                if (additional == 27 && narrow_f64_to_f32(argument) >= 0) { self.stop(ErrorKind::FloatNotShortest, at); return -1; }
            }
            if (chunks) { self.stop(ErrorKind::ChunkType, at); return -1; }
            if (self.items >= self.options.max_items) { self.stop(ErrorKind::ItemLimit, at); return -1; }
            if (additional == 27) { event = ext::cbor::Event::Float64(argument); }
            else {
                if (additional == 26) { event = ext::cbor::Event::Float32(argument as u32); }
                else { if (additional == 25) { event = ext::cbor::Event::Float16(argument as u32); } else { event = ext::cbor::Event::Simple(argument as u8); } }
            }
            self.begin = data_start;
        } else {
            if (self.options.deterministic && !preferred(additional, argument)) { self.stop(ErrorKind::NotPreferred, at); return -1; }
            if (major <= 1) {
                if (chunks) { self.stop(ErrorKind::ChunkType, at); return -1; }
                if (self.items >= self.options.max_items) { self.stop(ErrorKind::ItemLimit, at); return -1; }
                if (major == 0) { event = ext::cbor::Event::Unsigned(argument); } else { event = ext::cbor::Event::Negative(argument); }
                self.begin = data_start;
            } else {
                if (major >= 4) {
                    if (chunks) { self.stop(ErrorKind::ChunkType, at); return -1; }
                    if (self.items >= self.options.max_items) { self.stop(ErrorKind::ItemLimit, at); return -1; }
                    if (self.depth >= self.options.max_depth) { self.stop(ErrorKind::DepthLimit, at); return -1; }
                    self.items += 1;
                    if (self.options.deterministic) { self.note_start(at); }
                    self.begin = data_start;
                    let count: u64 = argument; if (major == 6) { count = 1; }
                    if (!self.push_frame(major as u8, count, at)) { return -1; }
                    let opened: ext::cbor::Event = ext::cbor::Event::Array(argument);
                    if (major == 5) { opened = ext::cbor::Event::Map(argument); }
                    if (major == 6) { opened = ext::cbor::Event::Tag(argument); }
                    self.current = opened; self.current_at = at; self.delivery.produced();
                    return 1;
                }
                if ((parent == 11 && major != 2) || (parent == 12 && major != 3)) { self.stop(ErrorKind::ChunkType, at); return -1; }
                let limit: u64 = self.options.max_string_bytes as u64;
                if (argument > limit) { self.stop(ErrorKind::StringLimit, at); return -1; }
                if (chunks && argument > limit - self.chunked) { self.stop(ErrorKind::StringLimit, at); return -1; }
                if (((available - 1 - width) as u64) < argument) {
                    if (self.delivery.finished()) { self.stop(ErrorKind::UnexpectedEnd, at); return -1; }
                    return 0;
                }
                if (self.items >= self.options.max_items) { self.stop(ErrorKind::ItemLimit, at); return -1; }
                let payload: i32 = argument as i32;
                let stop: i32 = data_start + payload;
                if (major == 3) {
                    // ASCII prefix inline; the general check from the first other byte.
                    let index: i32 = data_start;
                    while (index < stop && data[index] < 128) { index += 1; }
                    if (index < stop && !valid_utf8(data, index, stop - index)) { self.stop(ErrorKind::InvalidUtf8, at); return -1; }
                    event = ext::cbor::Event::Text(core::slice::View { values: data, start: data_start, length: payload });
                } else {
                    event = ext::cbor::Event::Bytes(core::slice::View { values: data, start: data_start, length: payload });
                }
                if (chunks) { self.chunked += argument; }
                self.begin = stop;
            }
        }
        self.items += 1;
        if (self.options.deterministic) { self.note_start(at); }
        if (!self.complete()) { return -1; }
        self.current = event; self.current_at = at; self.delivery.produced();
        return 1;
    }
}

pub enum StreamError { Cbor(Error), Io(core::io::Error) }
// Pull events from a core::io::Read source through caller scratch. Borrows
// the reader, decoder and scratch; keep them alive and unshared while driving.
pub struct EventReader<R> { reader: &R, decoder: &Decoder, scratch: core::slice::View<u8>, eof_completion: core::iter_state::Completion, reads: u64, failure: StreamError }
pub fn event_reader<R>(reader: &R, decoder: &Decoder, scratch: core::slice::View<u8>)
    -> core::result::Result<EventReader<R>, Error> where R: core::io::Read {
    if (scratch.length <= 0 || !core::io::valid_range(scratch.start, scratch.length)) { return core::result::Err(error(ErrorKind::Bounds, 0)); }
    let value: EventReader<R> = EventReader { reader: reader, decoder: decoder, scratch: scratch, eof_completion: core::iter_state::completion_start(), reads: 0, failure: StreamError::Io(core::io::Error::InvalidCount) };
    return core::result::Ok(value);
}
pub impl<R> EventReader<R> {
    pub fn borrow(&self) -> &EventReader<R> { return self; }
    pub fn read_calls(&self) -> u64 { return self.reads; }
    // Ok(true): the decoder holds an event. Ok(false): EOF and the input is
    // complete. Interrupted reads are retried; other read errors return Io.
    pub fn next(&self) -> core::result::Result<bool, StreamError> where R: core::io::Read {
        let step: i32 = self.advance();
        if (step < 0) { return core::result::Err(self.failure); }
        return core::result::Ok(step > 0);
    }
    // The error of the last advance() that returned -1.
    pub fn last_error(&self) -> StreamError { return self.failure; }
    // next() without the Result: 1 event ready, 0 EOF and complete, -1 failed
    // (see last_error()).
    pub fn advance(&self) -> i32 where R: core::io::Read {
        while (true) {
            let step: i32 = self.decoder.advance();
            if (step > 0) { return 1; }
            if (step < 0) { self.failure = StreamError::Cbor(self.decoder.last_error()); return -1; }
            if (self.eof_completion.is_done()) { return 0; }
            let received: core::result::Result<i32, core::io::Error> = self.reader.read(self.scratch.values, self.scratch.start, self.scratch.length);
            if (received.is_err()) {
                let cause: core::io::Error = received.unwrap_err();
                if (core::io::is_interrupted(cause)) { continue; }
                self.failure = StreamError::Io(cause); return -1;
            }
            let count: i32 = received.unwrap();
            if (count < 0 || count > self.scratch.length) { self.failure = StreamError::Io(core::io::Error::InvalidCount); return -1; }
            self.reads += 1;
            if (count == 0) { self.eof_completion.finish(); self.decoder.finish(); continue; }
            let fed: core::result::Result<i32, Error> = self.decoder.feed(self.scratch.values, self.scratch.start, count);
            if (fed.is_err()) { self.failure = StreamError::Cbor(fed.unwrap_err()); return -1; }
        }
        return 0;
    }
}

// Writer frame kinds: 1 array, 2 map, 3 tag, 4 chunked bytes, 5 chunked text;
// 0 at the root. The innermost frame lives in scalar fields (kind, known,
// declared, count, begin, base) so the per-item path touches no vector;
// enclosing frames are saved WFRAME words each in `stack`, a cached view of
// `frames`. Output bytes live in `data`, a cached view of `out` with `cap`
// bytes of which `used` are written. Deterministic map item offsets live in
// `spots`, a cached view of `marks`, with `mark_count` in use.
pub struct Writer {
    options: WriterOptions, out: alloc::vec::Vec<u8>, data: [u8], used: i32, cap: i32,
    depth: i32, kind: u8, known: bool, declared: u64, count: u64, begin: i32, base: i32,
    frames: alloc::vec::Vec<u64>, stack: [u64], stack_cap: i32,
    marks: alloc::vec::Vec<i32>, spots: [i32], mark_count: i32, mark_cap: i32,
    order: alloc::vec::Vec<i32>, spare: alloc::vec::Vec<i32>, swap: alloc::vec::Vec<u8>,
    roots: u64, flushed: u64, pending: i32, health: core::lifecycle::Health, failure: Error,
}
// Words per saved frame in Writer.stack.
const WFRAME: i32 = 5;
pub fn writer(options: WriterOptions) -> core::result::Result<Writer, Error> {
    if (options.max_depth < 0 || options.max_output_bytes < 0) { return core::result::Err(error(ErrorKind::InvalidOptions, 0)); }
    let out: alloc::vec::Vec<u8> = alloc::vec::new(); let frames: alloc::vec::Vec<u64> = alloc::vec::new();
    let marks: alloc::vec::Vec<i32> = alloc::vec::new();
    return core::result::Ok(Writer { options: options, out: out, data: out.as_slice(), used: 0, cap: 0,
        depth: 0, kind: 0, known: false, declared: 0, count: 0, begin: 0, base: 0,
        frames: frames, stack: frames.as_slice(), stack_cap: 0,
        marks: marks, spots: marks.as_slice(), mark_count: 0, mark_cap: 0,
        order: alloc::vec::new(), spare: alloc::vec::new(), swap: alloc::vec::new(),
        roots: 0, flushed: 0, pending: 0, health: core::lifecycle::health_start(), failure: error(ErrorKind::InvalidOptions, 0) });
}
// Encoded head width for an argument: 1, 2, 3, 5 or 9 bytes.
fn head_width(argument: u64) -> i32 {
    if (argument < 24) { return 1; }
    if (argument <= 255) { return 2; }
    if (argument <= 65535) { return 3; }
    if (argument <= 4294967295) { return 5; }
    return 9;
}
// Writes a head of the given width at target[at].
fn head_at(target: [u8], at: i32, major: i32, argument: u64, width: i32) {
    if (width == 1) { target[at] = (major * 32 + (argument as i32)) as u8; return; }
    let additional: i32 = 24; if (width == 3) { additional = 25; } if (width == 5) { additional = 26; } if (width == 9) { additional = 27; }
    target[at] = (major * 32 + additional) as u8;
    let index: i32 = 1; let shift: i32 = (width - 2) * 8;
    while (index < width) { target[at + index] = ((argument >> shift) & 255) as u8; index += 1; shift -= 8; }
}

pub impl Writer {
    pub fn borrow(&self) -> &Writer { return self; }
    pub fn len(&self) -> i32 { return self.used; }
    pub fn depth(&self) -> i32 { return self.depth; }
    pub fn roots_written(&self) -> u64 { return self.roots; }
    pub fn is_complete(&self) -> bool { return self.depth == 0 && self.roots > 0 && !self.health.is_failed(); }
    // Buffered output; valid until the next writer mutation.
    pub fn output(&self) -> core::slice::View<u8> { return core::slice::View { values: self.data, start: 0, length: self.used }; }
    fn offset(&self) -> u64 { return self.flushed + (self.used as u64); }
    fn reject(&self, kind: ErrorKind) -> core::result::Result<i32, Error> { return core::result::Err(error(kind, self.offset())); }
    fn fail(&self, kind: ErrorKind, at: u64) { self.failure = error(kind, at); self.health.fail(); }
    fn poison(&self, kind: ErrorKind, at: u64) -> core::result::Result<i32, Error> {
        self.fail(kind, at); return core::result::Err(self.failure);
    }
    fn room(&self, count: i32) -> bool { return count <= self.options.max_output_bytes - self.used; }
    // Room for need output bytes in total; grows geometrically, at least 64.
    fn reserve(&self, need: i32) -> bool {
        if (need <= self.cap) { return true; }
        let target: i32 = need;
        if (self.cap <= 1073741823 && self.cap * 2 > target) { target = self.cap * 2; }
        if (target < 64) { target = 64; }
        if (self.out.try_resize(target, 0).is_err()) { return false; }
        self.data = self.out.as_slice(); self.cap = target;
        return true;
    }
    // True when check(string_major) would succeed; clears pending like it.
    fn placed(&self, string_major: i32) -> bool {
        if (self.health.is_failed()) { return false; }
        self.pending = 0;
        let kind: u8 = self.kind;
        if (kind == 0) { return self.roots == 0 || self.options.sequence; }
        if (kind == 4) { return string_major == 2; }
        if (kind == 5) { return string_major == 3; }
        if (!self.known) { return true; }
        if (kind == 1) { return self.count != self.declared; }
        if (kind == 2) { return self.count / 2 != self.declared || self.count % 2 != 0; }
        return true;
    }
    // Validates placement of one item; string_major is 2 or 3 for strings.
    fn check(&self, string_major: i32) -> core::result::Result<i32, Error> {
        if (self.health.is_failed()) { return core::result::Err(self.failure); }
        self.pending = 0;
        let kind: u8 = self.kind;
        if (kind == 0) {
            if (self.roots > 0 && !self.options.sequence) { return self.reject(ErrorKind::InvalidPlacement); }
            return core::result::Ok(0);
        }
        if ((kind == 4 && string_major != 2) || (kind == 5 && string_major != 3)) { return self.reject(ErrorKind::ChunkType); }
        if (self.known) {
            let used: u64 = self.count; let limit: u64 = self.declared;
            if (kind == 1 && used == limit) { return self.reject(ErrorKind::CountMismatch); }
            if (kind == 2 && used / 2 == limit && used % 2 == 0) { return self.reject(ErrorKind::CountMismatch); }
        }
        return core::result::Ok(0);
    }
    fn mark(&self, at: i32) -> bool {
        if (self.kind != 2 || !self.options.deterministic) { return true; }
        let next: i32 = self.mark_count;
        if (next == self.mark_cap) {
            let target: i32 = 64; if (self.mark_cap >= 32) { target = self.mark_cap * 2; }
            if (self.mark_cap > 536870911 || self.marks.try_resize(target, 0).is_err()) { return false; }
            self.spots = self.marks.as_slice(); self.mark_cap = target;
        }
        self.spots[next] = at; self.mark_count = next + 1;
        return true;
    }
    // One item finished; closes tags whose child is complete.
    fn done(&self) {
        while (true) {
            if (self.depth == 0) { self.roots += 1; return; }
            self.count += 1;
            if (self.kind != 3) { return; }
            self.pop_frame(); self.pending += 1;
        }
    }
    // Save the innermost frame (if any) and open a new one.
    fn push_frame(&self, kind: u8, known: bool, declared: u64) -> bool {
        if (self.depth > 0) {
            let word: i32 = (self.depth - 1) * WFRAME;
            if (word + WFRAME > self.stack_cap) {
                let target: i32 = (word + WFRAME) * 2; if (target < 40) { target = 40; }
                if (word > 536870911 || self.frames.try_resize(target, 0).is_err()) { return false; }
                self.stack = self.frames.as_slice(); self.stack_cap = target;
            }
            let saved: [u64] = self.stack;
            let flag: u64 = 0; if (self.known) { flag = 256; }
            saved[word] = (self.kind as u64) | flag; saved[word + 1] = self.declared; saved[word + 2] = self.count;
            saved[word + 3] = self.begin as u64; saved[word + 4] = self.base as u64;
        }
        self.kind = kind; self.known = known; self.declared = declared; self.count = 0;
        self.begin = self.used; self.base = self.mark_count; self.depth += 1;
        return true;
    }
    fn pop_frame(&self) {
        self.mark_count = self.base;
        let depth: i32 = self.depth - 1; self.depth = depth;
        if (depth == 0) { self.kind = 0; self.known = false; self.declared = 0; self.count = 0; self.begin = 0; self.base = 0; return; }
        let word: i32 = (depth - 1) * WFRAME; let saved: [u64] = self.stack;
        let first: u64 = saved[word];
        self.kind = (first & 255) as u8; self.known = first >= 256; self.declared = saved[word + 1]; self.count = saved[word + 2];
        self.begin = saved[word + 3] as i32; self.base = saved[word + 4] as i32;
    }
    fn scalar(&self, major: i32, argument: u64) -> core::result::Result<i32, Error> {
        if (!self.placed(0)) { return self.check(0); }
        let at: i32 = self.used; let width: i32 = head_width(argument);
        if (!self.room(width)) { return self.reject(ErrorKind::OutputLimit); }
        if (at + width > self.cap && !self.reserve(at + width)) { return self.reject(ErrorKind::AllocationFailed); }
        head_at(self.data, at, major, argument, width); self.used = at + width;
        if (!self.mark(at)) { self.used = at; return self.reject(ErrorKind::AllocationFailed); }
        self.done();
        return core::result::Ok(width);
    }
    pub fn unsigned(&self, value: u64) -> core::result::Result<i32, Error> { return self.scalar(0, value); }
    // Encodes -1 - value.
    pub fn negative(&self, value: u64) -> core::result::Result<i32, Error> { return self.scalar(1, value); }
    pub fn integer(&self, value: i64) -> core::result::Result<i32, Error> {
        if (value >= 0) { return self.scalar(0, value as u64); }
        return self.scalar(1, (-(value + 1)) as u64);
    }
    pub fn simple(&self, value: u8) -> core::result::Result<i32, Error> {
        if (value >= 24 && value <= 31) { return self.reject(ErrorKind::InvalidSimple); }
        return self.scalar(7, value as u64);
    }
    pub fn boolean(&self, value: bool) -> core::result::Result<i32, Error> { if (value) { return self.scalar(7, 21); } return self.scalar(7, 20); }
    pub fn null(&self) -> core::result::Result<i32, Error> { return self.scalar(7, 22); }
    pub fn undefined(&self) -> core::result::Result<i32, Error> { return self.scalar(7, 23); }
    fn float_bits(&self, width: i32, bits: u64) -> core::result::Result<i32, Error> {
        if (!self.placed(0)) { return self.check(0); }
        let at: i32 = self.used;
        if (!self.room(1 + width)) { return self.reject(ErrorKind::OutputLimit); }
        if (at + 1 + width > self.cap && !self.reserve(at + 1 + width)) { return self.reject(ErrorKind::AllocationFailed); }
        let data: [u8] = self.data;
        data[at] = 249; if (width == 4) { data[at] = 250; } if (width == 8) { data[at] = 251; }
        let index: i32 = 1; let shift: i32 = (width - 1) * 8;
        while (index <= width) { data[at + index] = ((bits >> shift) & 255) as u8; index += 1; shift -= 8; }
        self.used = at + 1 + width;
        if (!self.mark(at)) { self.used = at; return self.reject(ErrorKind::AllocationFailed); }
        self.done();
        return core::result::Ok(1 + width);
    }
    pub fn float16(&self, bits: u32) -> core::result::Result<i32, Error> {
        if (bits > 65535) { return self.reject(ErrorKind::InvalidValue); }
        return self.float_bits(2, bits as u64);
    }
    // In deterministic mode float32 and float64 use the shortest exact width.
    pub fn float32(&self, bits: u32) -> core::result::Result<i32, Error> {
        if (self.options.deterministic) { let half: i64 = narrow_f32_to_f16(bits); if (half >= 0) { return self.float_bits(2, half as u64); } }
        return self.float_bits(4, bits as u64);
    }
    pub fn float64(&self, bits: u64) -> core::result::Result<i32, Error> {
        if (self.options.deterministic) {
            let single: i64 = narrow_f64_to_f32(bits);
            if (single >= 0) { return self.float32(single as u32); }
        }
        return self.float_bits(8, bits);
    }
    fn string(&self, major: i32, source: [u8], start: i32, length: i32) -> core::result::Result<i32, Error> {
        if (!self.placed(major)) { return self.check(major); }
        if (!core::io::valid_range(start, length)) { return self.reject(ErrorKind::Bounds); }
        if (major == 3 && !valid_utf8(source, start, length)) { return self.reject(ErrorKind::InvalidUtf8); }
        let at: i32 = self.used;
        let need: i32 = 0; if (self.kind < 4 || !self.options.deterministic) { need = head_width(length as u64); }
        if (length > self.options.max_output_bytes - need || !self.room(need + length)) { return self.reject(ErrorKind::OutputLimit); }
        let stop: i32 = at + need + length;
        if (stop > self.cap && !self.reserve(stop)) { return self.reject(ErrorKind::AllocationFailed); }
        let data: [u8] = self.data;
        if (need > 0) { head_at(data, at, major, length as u64, need); }
        let to: i32 = at + need; let from: i32 = start; let last: i32 = start + length;
        while (from + 4 <= last) {
            data[to] = source[from]; data[to + 1] = source[from + 1]; data[to + 2] = source[from + 2]; data[to + 3] = source[from + 3];
            to += 4; from += 4;
        }
        while (from < last) { data[to] = source[from]; to += 1; from += 1; }
        self.used = stop;
        if (!self.mark(at)) { self.used = at; return self.reject(ErrorKind::AllocationFailed); }
        self.done();
        return core::result::Ok(stop - at);
    }
    pub fn bytes(&self, value: core::slice::View<u8>) -> core::result::Result<i32, Error> { return self.string(2, value.values, value.start, value.length); }
    // Text must be valid UTF-8; it is checked.
    pub fn text(&self, value: core::text::Text) -> core::result::Result<i32, Error> { return self.string(3, value.bytes, value.start, value.length); }
    pub fn text_bytes(&self, value: core::slice::View<u8>) -> core::result::Result<i32, Error> { return self.string(3, value.values, value.start, value.length); }
    fn open(&self, kind: u8, known: bool, declared: u64, argument: u64) -> core::result::Result<i32, Error> {
        if (!self.placed(0)) { return self.check(0); }
        if (self.depth >= self.options.max_depth) { return self.reject(ErrorKind::DepthLimit); }
        let at: i32 = self.used;
        let major: i32 = 4; if (kind == 2) { major = 5; } if (kind == 3) { major = 6; } if (kind == 4) { major = 2; } if (kind == 5) { major = 3; }
        let ok: bool = true;
        if (known) {
            let width: i32 = head_width(argument);
            if (!self.room(width)) { return self.reject(ErrorKind::OutputLimit); }
            ok = at + width <= self.cap || self.reserve(at + width);
            if (ok) { head_at(self.data, at, major, argument, width); self.used = at + width; }
        } else {
            if (!self.options.deterministic) {
                if (!self.room(1)) { return self.reject(ErrorKind::OutputLimit); }
                ok = at < self.cap || self.reserve(at + 1);
                if (ok) { self.data[at] = (major * 32 + 31) as u8; self.used = at + 1; }
            }
        }
        if (ok) { ok = self.mark(at); }
        if (ok) { ok = self.push_frame(kind, known, declared); }
        if (!ok) { return self.poison(ErrorKind::AllocationFailed, (at as u64) + self.flushed); }
        return core::result::Ok(self.used - at);
    }
    pub fn begin_array(&self) -> core::result::Result<i32, Error> { return self.open(1, false, 0, 0); }
    pub fn begin_array_len(&self, count: u64) -> core::result::Result<i32, Error> { return self.open(1, true, count, count); }
    pub fn begin_map(&self) -> core::result::Result<i32, Error> { return self.open(2, false, 0, 0); }
    // count is the number of key/value pairs.
    pub fn begin_map_len(&self, count: u64) -> core::result::Result<i32, Error> { return self.open(2, true, count, count); }
    pub fn begin_bytes(&self) -> core::result::Result<i32, Error> { return self.open(4, false, 0, 0); }
    pub fn begin_text(&self) -> core::result::Result<i32, Error> { return self.open(5, false, 0, 0); }
    // The tag applies to the next item and closes after it.
    pub fn tag(&self, number: u64) -> core::result::Result<i32, Error> { return self.open(3, true, 1, number); }
    fn key_order(&self, left: i32, right: i32, base: i32) -> i32 {
        let spots: [i32] = self.spots;
        let a: i32 = spots[base + 2 * left]; let b: i32 = spots[base + 2 * right];
        return compare(self.data, a, spots[base + 2 * left + 1] - a, self.data, b, spots[base + 2 * right + 1] - b);
    }
    // Sorts the pairs of the innermost map by encoded key; rejects duplicates.
    fn sort_map(&self) -> bool {
        let base: i32 = self.base; let spots: [i32] = self.spots;
        let pairs: i32 = (self.mark_count - base) / 2;
        if (pairs < 2) { return true; }
        let sorted: bool = true; let index: i32 = 1;
        while (index < pairs) {
            let order: i32 = self.key_order(index - 1, index, base);
            if (order == 0) { self.fail(ErrorKind::DuplicateKey, self.flushed + (spots[base + 2 * index] as u64)); return false; }
            if (order > 0) { sorted = false; }
            index += 1;
        }
        if (sorted) { return true; }
        if (self.order.try_resize(pairs, 0).is_err() || self.spare.try_resize(pairs, 0).is_err()) { self.fail(ErrorKind::AllocationFailed, self.offset()); return false; }
        let order: [i32] = self.order.as_slice(); let spare: [i32] = self.spare.as_slice();
        index = 0; while (index < pairs) { order[index] = index; index += 1; }
        let width: i32 = 1;
        while (width < pairs) {
            let low: i32 = 0;
            while (low < pairs) {
                let middle: i32 = low + width; if (middle > pairs) { middle = pairs; }
                let high: i32 = low + 2 * width; if (high > pairs) { high = pairs; }
                let i: i32 = low; let j: i32 = middle; let k: i32 = low;
                while (k < high) {
                    let take_left: bool = j >= high || (i < middle && self.key_order(order[i], order[j], base) <= 0);
                    if (take_left) { spare[k] = order[i]; i += 1; } else { spare[k] = order[j]; j += 1; }
                    k += 1;
                }
                low = high;
            }
            index = 0;
            while (index < pairs) { order[index] = spare[index]; index += 1; }
            width = width * 2;
        }
        index = 1;
        while (index < pairs) {
            if (self.key_order(order[index - 1], order[index], base) == 0) {
                let later: i32 = order[index]; if (order[index - 1] > later) { later = order[index - 1]; }
                self.fail(ErrorKind::DuplicateKey, self.flushed + (spots[base + 2 * later] as u64)); return false;
            }
            index += 1;
        }
        let end: i32 = self.used;
        let region: i32 = spots[base];
        if (self.swap.try_resize(end - region, 0).is_err()) { self.fail(ErrorKind::AllocationFailed, self.offset()); return false; }
        let data: [u8] = self.data; let copy: [u8] = self.swap.as_slice(); let to: i32 = 0; index = 0;
        while (index < pairs) {
            let pair: i32 = order[index];
            let from: i32 = spots[base + 2 * pair];
            let last: i32 = end; if (pair + 1 < pairs) { last = spots[base + 2 * pair + 2]; }
            while (from < last) { copy[to] = data[from]; to += 1; from += 1; }
            index += 1;
        }
        index = 0;
        while (index < end - region) { data[region + index] = copy[index]; index += 1; }
        return true;
    }
    // Inserts a head of the given width at position at, shifting the following bytes.
    fn insert_head(&self, at: i32, major: i32, argument: u64, width: i32) -> bool {
        let length: i32 = self.used;
        if (!self.reserve(length + width)) { return false; }
        let data: [u8] = self.data; let index: i32 = length;
        while (index > at) { index -= 1; data[index + width] = data[index]; }
        head_at(data, at, major, argument, width); self.used = length + width;
        return true;
    }
    // Closes the innermost array, map or chunked string.
    pub fn end(&self) -> core::result::Result<i32, Error> {
        if (self.health.is_failed()) { return core::result::Err(self.failure); }
        self.pending = 0;
        if (self.depth == 0) { return self.reject(ErrorKind::InvalidPlacement); }
        let kind: u8 = self.kind; let used: u64 = self.count;
        if (kind == 3) { return self.reject(ErrorKind::InvalidPlacement); }
        if (kind == 2 && used % 2 == 1) { return self.reject(ErrorKind::OddMap); }
        let known: bool = self.known;
        if (known) {
            let wanted: u64 = self.declared;
            if ((kind == 1 && used != wanted) || (kind == 2 && used / 2 != wanted)) { return self.reject(ErrorKind::CountMismatch); }
        }
        let at: i32 = self.used;
        if (self.options.deterministic) {
            if (kind == 2 && !self.sort_map()) { return core::result::Err(self.failure); }
            if (!known) {
                let start: i32 = self.begin;
                let major: i32 = 4; let argument: u64 = used;
                if (kind == 2) { major = 5; argument = used / 2; }
                if (kind == 4 || kind == 5) { major = (kind as i32) - 2; argument = (self.used - start) as u64; }
                let width: i32 = head_width(argument);
                if (!self.room(width)) { return self.poison(ErrorKind::OutputLimit, self.offset()); }
                if (!self.insert_head(start, major, argument, width)) { return self.poison(ErrorKind::AllocationFailed, self.offset()); }
            }
        } else {
            if (!known) {
                if (!self.room(1)) { return self.reject(ErrorKind::OutputLimit); }
                if (at == self.cap && !self.reserve(at + 1)) { return self.reject(ErrorKind::AllocationFailed); }
                self.data[at] = 255; self.used = at + 1;
            }
        }
        self.pop_frame(); self.done();
        return core::result::Ok(self.used - at);
    }
    // Writes one decoder event. End events that close tags are absorbed,
    // because writer tags close after their child.
    pub fn event(&self, value: ext::cbor::Event) -> core::result::Result<i32, Error> {
        let result: core::result::Result<i32, Error> = match (value) {
            ext::cbor::Event::Unsigned(n) -> self.unsigned(n),
            ext::cbor::Event::Negative(n) -> self.negative(n),
            ext::cbor::Event::Bytes(data) -> self.bytes(data),
            ext::cbor::Event::Text(data) -> self.text_bytes(data),
            ext::cbor::Event::Array(n) -> self.begin_array_len(n),
            ext::cbor::Event::Map(n) -> self.begin_map_len(n),
            ext::cbor::Event::Tag(n) -> self.tag(n),
            ext::cbor::Event::Simple(n) -> self.simple(n),
            ext::cbor::Event::Float16(bits) -> self.float16(bits),
            ext::cbor::Event::Float32(bits) -> self.float32(bits),
            ext::cbor::Event::Float64(bits) -> self.float64(bits),
            ext::cbor::Event::BeginBytes -> self.begin_bytes(),
            ext::cbor::Event::BeginText -> self.begin_text(),
            ext::cbor::Event::BeginArray -> self.begin_array(),
            ext::cbor::Event::BeginMap -> self.begin_map(),
            ext::cbor::Event::End -> self.end_event(),
        };
        return result;
    }
    fn end_event(&self) -> core::result::Result<i32, Error> {
        if (self.pending > 0) { self.pending -= 1; return core::result::Ok(0); }
        return self.end();
    }
    // Retains capacity; forgets output and structure.
    pub fn clear(&self) {
        self.used = 0; self.depth = 0; self.kind = 0; self.known = false; self.declared = 0; self.count = 0; self.begin = 0; self.base = 0;
        self.mark_count = 0; self.roots = 0; self.flushed = 0; self.pending = 0; self.health.reset();
    }
    pub fn destroy(&self) {
        self.out.destroy(); self.frames.destroy(); self.marks.destroy(); self.order.destroy(); self.spare.destroy(); self.swap.destroy();
        self.out = alloc::vec::new(); self.frames = alloc::vec::new(); self.marks = alloc::vec::new();
        self.order = alloc::vec::new(); self.spare = alloc::vec::new(); self.swap = alloc::vec::new();
        self.data = self.out.as_slice(); self.cap = 0; self.stack = self.frames.as_slice(); self.stack_cap = 0;
        self.spots = self.marks.as_slice(); self.mark_cap = 0;
        self.clear();
    }
    // Whether frame index (0 outermost) pins its bytes: maps sort and unknown
    // lengths insert a head. The innermost frame is in scalars.
    fn frame_pins(&self, index: i32) -> bool {
        if (index == self.depth - 1) { return self.kind == 2 || !self.known; }
        let first: u64 = self.stack[index * WFRAME];
        return (first & 255) == 2 || first < 256;
    }
    fn frame_begin(&self, index: i32) -> i32 {
        if (index == self.depth - 1) { return self.begin; }
        return self.stack[index * WFRAME + 3] as i32;
    }
    // Bytes that no later sort or head insertion can change.
    pub fn stable_len(&self) -> i32 {
        if (!self.options.deterministic) { return self.used; }
        let index: i32 = 0;
        while (index < self.depth) {
            if (self.frame_pins(index)) { return self.frame_begin(index); }
            index += 1;
        }
        return self.used;
    }
}

// Copies the stable buffered prefix to a core::io::Write sink and drops it.
// On failure the unwritten bytes stay buffered; Failure.completed counts the
// bytes this call delivered.
pub impl Writer {
    pub fn flush_to<W>(&self, sink: &W) -> core::result::Result<i32, core::io::Failure> where W: core::io::Write {
        let count: i32 = self.stable_len();
        if (count == 0) { return core::result::Ok(0); }
        let sent: core::result::Result<i32, core::io::Failure> = core::io::write_all<W>(sink, self.data, 0, count);
        let done: i32 = count;
        if (sent.is_err()) { done = sent.unwrap_err().completed; if (done < 0 || done > count) { done = 0; } }
        if (done > 0) {
            let bytes: [u8] = self.data; let length: i32 = self.used; let i: i32 = done;
            while (i < length) { bytes[i - done] = bytes[i]; i += 1; }
            self.used = length - done;
            if (self.depth > 0) { self.begin -= done; }
            let saved: [u64] = self.stack;
            i = 0; while (i + 1 < self.depth) { let slot: i32 = i * WFRAME + 3; saved[slot] = ((saved[slot] as i32) - done) as u64; i += 1; }
            let spots: [i32] = self.spots;
            i = 0; while (i < self.mark_count) { spots[i] = spots[i] - done; i += 1; }
            self.flushed += done as u64;
        }
        if (sent.is_err()) { return core::result::Err(sent.unwrap_err()); }
        return core::result::Ok(count);
    }
}
