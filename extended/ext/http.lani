    let i: i32 = 0;
    if (byte(value,0) == 91) {
        i = 1; while (i < value.len() && byte(value,i) != 93) { i += 1; }
        if (i == value.len()) { return false; }
        if (core::result::is_err(core::net::parse_ipv6(part(value,1,i)))) {
            if (i < 4 || lower(byte(value,1)) != 118) { return false; } let p: i32 = 2; while (p < i && hex(byte(value,p)) >= 0) { p += 1; } if (p == 2 || p == i || byte(value,p) != 46) { return false; } p += 1; if (p == i) { return false; }
            while (p < i) { let c: u8 = byte(value,p); if ((!token(c) && c != 126 && c != 40 && c != 41 && c != 44 && c != 59 && c != 61 && c != 58) || c == 35 || c == 37 || c == 94 || c == 96 || c == 124) { return false; } p += 1; }
        } i += 1;
    } else {
