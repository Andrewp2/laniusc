    }
    let parsed: core::result::Result<ext::uri::Reference,ext::uri::Error> = ext::uri::parse_with_limit(target,2147483647);
    if (core::result::is_err(parsed)) { return false; }
    let uri: ext::uri::Reference = core::result::unwrap(parsed);
    if (core::option::is_some(uri.fragment)) { return false; }
