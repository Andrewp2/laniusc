pub fn parse_request_head(bytes: core::slice::View<u8>, limits: Limits) -> core::result::Result<Head,Error> { return head(bytes,true,literal("",0),limits); }
pub fn parse_response_head(bytes: core::slice::View<u8>, request_method: core::slice::View<u8>, limits: Limits) -> core::result::Result<Head,Error> { return head(bytes,false,request_method,limits); }
// RFC 9110 6.5.1: keep unknown end-to-end metadata separate, reject fields
