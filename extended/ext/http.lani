            let c: u8 = byte(value,i);
            if (c == 37) { if (value.len()-i < 3 || hex(byte(value,i+1)) < 0 || hex(byte(value,i+2)) < 0) { return false; } i += 3; }
            else { if (!token(c) && c != 126 && c != 40 && c != 41 && c != 44 && c != 59 && c != 61) { return false; } if (c == 35 || c == 94 || c == 96 || c == 124) { return false; } i += 1; }
        }
        if (i == 0) { return false; }
    }
    if (i == value.len()) { return !require_port; }
    if (byte(value,i) != 58) { return false; } i += 1;
    if (i == value.len()) { return !require_port; }
    while (i < value.len()) { if (!digit(byte(value,i))) { return false; } i += 1; } return true;
}
fn target_valid(method: core::slice::View<u8>, target: core::slice::View<u8>) -> bool {
    if (target.is_empty()) { return false; }
    if (exact(method,literal("CONNECT",7))) { return authority(target,true); }
    if (exact(target,literal("*",1))) { return exact(method,literal("OPTIONS",7)); }
    if (byte(target,0) == 47) {
        let query: bool = false; let i: i32 = 0;
        while (i < target.len()) { let c: u8 = byte(target,i); if (c == 37) { if (target.len()-i < 3 || hex(byte(target,i+1)) < 0 || hex(byte(target,i+2)) < 0) { return false; } i += 3; }
            else { if (c == 63) { query = true; } if (!token(c) && c != 126 && c != 40 && c != 41 && c != 44 && c != 59 && c != 61 && c != 58 && c != 64 && c != 47 && !(query && c == 63)) { return false; } if (c == 35 || c == 94 || c == 96 || c == 124) { return false; } i += 1; }
