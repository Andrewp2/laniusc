                if (core::result::is_ok(reference)) { let uri: ext::uri::Reference = core::result::unwrap(reference); if (core::option::is_some(uri.scheme)) { let scheme: core::slice::View<u8> = core::option::unwrap(uri.scheme); if (!named(scheme,"http",4) && !named(scheme,"https",5)) { return core::result::Err(Error::Unsupported(start)); } } }
