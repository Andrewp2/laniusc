        let c: u8 = byte(bytes,i);
        if (c == 10) { return core::result::Err(Error::Malformed(i)); }
        if (c == 13) { if (bytes.len()-i < 2) { return core::result::Err(Error::Incomplete(bytes.len())); } if (byte(bytes,i+1) != 10) { return core::result::Err(Error::Malformed(i+1)); } if (section_end-i < 2) { return core::result::Err(Error::Limit(i)); } return core::result::Ok(i); }
        if (c == 0 || (c < 32 && c != 9) || c == 127) { return core::result::Err(Error::Malformed(i)); }
        i += 1;
    }
    if (i-start > maximum || i >= section_end) { return core::result::Err(Error::Limit(i)); }
    return core::result::Err(Error::Incomplete(i));
}
fn field(bytes: core::slice::View<u8>, start: i32, end: i32) -> core::result::Result<Field, Error> {
    let i: i32 = start;
    while (i < end && token(byte(bytes,i))) { i += 1; }
