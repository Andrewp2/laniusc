    }
    let tunnel: bool = !request && exact(method,literal("CONNECT",7)) && status >= 200 && status < 300;
    let pos: i32 = end+2; let fields_start: i32 = pos; let count: i32 = 0; let hosts: i32 = 0; let length: i32 = -1; let transfer: bool = false;
    while (true) {
