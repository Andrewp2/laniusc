    let scheme: core::slice::View<u8> = core::option::unwrap(uri.scheme); let auth: ext::uri::Authority = core::option::unwrap(uri.authority);
    return (named(scheme,"http",4) || named(scheme,"https",5)) && core::option::is_none(auth.userinfo) && authority(auth.raw,false);
}
fn head(bytes: core::slice::View<u8>, request: bool, request_method: core::slice::View<u8>, limits: Limits) -> core::result::Result<Head, Error> {
