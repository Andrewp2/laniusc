pub enum Error { Bounds, Incomplete(i32), Malformed(i32), Limit(i32), Unsupported(i32), Capacity, AllocationFailed }
pub enum BodyKind { Empty, Fixed, Chunked, Close, Tunnel }
pub struct Limits { head_bytes: i32, line_bytes: i32, headers: i32, body_bytes: i32, trailer_bytes: i32, trailers: i32, chunks: i32 }
pub struct Field { raw: core::slice::View<u8>, name: core::slice::View<u8>, value: core::slice::View<u8>, offset: i32 }
pub struct Fields { raw: core::slice::View<u8>, position: i32, offset: i32 }
pub struct Head { raw: core::slice::View<u8>, fields: core::slice::View<u8>, field_count: i32, request: bool, method: core::slice::View<u8>, target: core::slice::View<u8>, version: i32, status: i32, reason: core::slice::View<u8>, kind: BodyKind, content_length: i32 }
pub struct Message { head: Head, encoded_body: core::slice::View<u8>, trailers: core::slice::View<u8>, trailer_count: i32, consumed: i32, decoded_length: i32 }

pub fn default_limits() -> Limits { return Limits { head_bytes: 65536, line_bytes: 8192, headers: 100, body_bytes: 16777216, trailer_bytes: 16384, trailers: 100, chunks: 65536 }; }
fn valid(view: core::slice::View<u8>) -> bool { return view.start >= 0 && view.length >= 0 && view.start <= 2147483647-view.length; }
fn limits_valid(limits: Limits) -> bool { return limits.head_bytes >= 0 && limits.line_bytes >= 0 && limits.headers >= 0 && limits.body_bytes >= 0 && limits.trailer_bytes >= 0 && limits.trailers >= 0 && limits.chunks >= 0; }
fn byte(view: core::slice::View<u8>, at: i32) -> u8 { return core::option::unwrap(view.get(at)); }
fn part(view: core::slice::View<u8>, start: i32, end: i32) -> core::slice::View<u8> { return core::result::unwrap(view.subview(start,end)); }
fn literal(value: str, count: i32) -> core::slice::View<u8> { let raw: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::string_data_ptr(value),count); return core::result::unwrap(core::slice::view(raw,count)); }
fn lower(value: u8) -> u8 { if (value >= 65 && value <= 90) { return value+32; } return value; }
pub fn equal_name(left: core::slice::View<u8>, right: core::slice::View<u8>) -> bool { if (!valid(left) || !valid(right) || left.len() != right.len()) { return false; } let i: i32 = 0; while (i < left.len()) { if (lower(byte(left,i)) != lower(byte(right,i))) { return false; } i += 1; } return true; }
fn exact(left: core::slice::View<u8>, right: core::slice::View<u8>) -> bool { if (left.len() != right.len()) { return false; } let i: i32 = 0; while (i < left.len()) { if (byte(left,i) != byte(right,i)) { return false; } i += 1; } return true; }
fn named(value: core::slice::View<u8>, name: str, count: i32) -> bool { return equal_name(value,literal(name,count)); }
fn digit(value: u8) -> bool { return value >= 48 && value <= 57; }
fn token(value: u8) -> bool { return (value >= 65 && value <= 90) || (value >= 97 && value <= 122) || digit(value) || value == 33 || value == 35 || value == 36 || value == 37 || value == 38 || value == 39 || value == 42 || value == 43 || value == 45 || value == 46 || value == 94 || value == 95 || value == 96 || value == 124 || value == 126; }
fn ows(value: u8) -> bool { return value == 32 || value == 9; }
fn hex(value: u8) -> i32 { if (digit(value)) { return (value-48) as i32; } if (lower(value) >= 97 && lower(value) <= 102) { return (lower(value)-87) as i32; } return -1; }
// Return CR offset. All offsets are relative to the selected input view.
fn line(bytes: core::slice::View<u8>, start: i32, maximum: i32, section_end: i32) -> core::result::Result<i32, Error> {
    let i: i32 = start;
    while (i < bytes.len()) {
