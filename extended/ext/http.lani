    let value_end: i32 = end; while (value_end > i && ows(byte(bytes,value_end-1))) { value_end -= 1; }
    return core::result::Ok(Field { raw: part(bytes,start,end+2), name: part(bytes,start,name_end), value: part(bytes,i,value_end), offset: start });
}
pub fn fields(raw: core::slice::View<u8>, offset: i32) -> Fields { return Fields { raw: raw, position: 0, offset: offset }; }
pub impl Fields {
    // Construct using validated Head.fields / Message.trailers only.
    pub fn next(&self) -> core::option::Option<Field> {
        if (self.position >= self.raw.len()) { return core::option::None(); }
        let start: i32 = self.position; let end: i32 = start;
        while (byte(self.raw,end) != 13) { end += 1; }
        let item: Field = core::result::unwrap(field(self.raw,start,end)); item.offset += self.offset; self.position = end+2; return core::option::Some(item);
    }
}
pub impl Head {
    pub fn headers(&self) -> Fields { return fields(self.fields,self.fields.start-self.raw.start); }
    pub fn lookup(&self, name: core::slice::View<u8>) -> core::option::Option<Field> { let cursor: Fields = self.headers(); while (true) { let next: core::option::Option<Field> = cursor.next(); if (core::option::is_none(next)) { return core::option::None(); } let item: Field = core::option::unwrap(next); if (equal_name(item.name,name)) { return core::option::Some(item); } } return core::option::None(); }
}
fn version(value: core::slice::View<u8>, offset: i32) -> core::result::Result<i32, Error> { if (exact(value,literal("HTTP/1.1",8))) { return core::result::Ok(11); } if (exact(value,literal("HTTP/1.0",8))) { return core::result::Ok(10); } if (value.len() == 8 && exact(part(value,0,5),literal("HTTP/",5)) && digit(byte(value,5)) && byte(value,6) == 46 && digit(byte(value,7))) { return core::result::Err(Error::Unsupported(offset)); } return core::result::Err(Error::Malformed(offset)); }
fn authority(value: core::slice::View<u8>, require_port: bool) -> bool {
