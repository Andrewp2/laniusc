        let checked: core::result::Result<i32,Error> = version(part(bytes,0,8),0); if (core::result::is_err(checked)) { return core::result::Err(core::result::unwrap_err(checked)); } ver = core::result::unwrap(checked);
        status = ((byte(bytes,9)-48) as i32)*100+((byte(bytes,10)-48) as i32)*10+(byte(bytes,11)-48) as i32;
