    let end: i32 = core::result::unwrap(first); let empty: core::slice::View<u8> = part(bytes,0,0);
    let method: core::slice::View<u8> = empty; let target: core::slice::View<u8> = empty; let reason: core::slice::View<u8> = empty; let status: i32 = 0; let ver: i32 = 0;
