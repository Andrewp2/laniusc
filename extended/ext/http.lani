            if (trailer_count == limits.trailers) { return core::result::Err(Error::Limit(pos)); } trailer_count += 1;
            let parsed_field: core::result::Result<Field,Error> = field(bytes,pos,end); if (core::result::is_err(parsed_field)) { return core::result::Err(core::result::unwrap_err(parsed_field)); } let item: Field = core::result::unwrap(parsed_field);
            if (forbidden(item.name) || connection_field(h,item.name)) { return core::result::Err(Error::Malformed(pos)); } pos = end+2;
        }
    }
    return core::result::Ok(Message { head: h, encoded_body: part(bytes,start,pos), trailers: part(bytes,trailer_start,trailer_end), trailer_count: trailer_count, consumed: pos, decoded_length: length });
}
pub fn parse_request(bytes: core::slice::View<u8>, eof: bool, limits: Limits) -> core::result::Result<Message,Error> { return message(bytes,parse_request_head(bytes,limits),eof,limits); }
pub fn parse_response(bytes: core::slice::View<u8>, method: core::slice::View<u8>, eof: bool, limits: Limits) -> core::result::Result<Message,Error> { return message(bytes,parse_response_head(bytes,method,limits),eof,limits); }

// Incremental framing candidate, not a validated Message. See
// docs/extended-http-cursor.md. No borrowed source views or owners are retained.
pub enum CursorMode { Request, Response }
pub struct HeadInfo { status: i32, version: i32, kind: BodyKind, content_length: i32, head_end: i32 }
pub struct FrameBoundary { consumed: i32, decoded_length: i32 }
pub enum Scan { NeedMore, HeadReady(HeadInfo), Boundary(FrameBoundary) }
// Library-maintained fields: construct with cursor(), never forge or mutate.
pub struct Cursor {
    mode: CursorMode, limits: Limits, rawcap: i32, maximum_work: u64, work_used: u64,
    phase: i32, pos: i32, line_start: i32, pending_cr: bool, first_line: bool,
    head_fields: i32, previous_length: i32, ended: bool, head_end: i32,
    decoded: i32, remaining: i32, chunks: i32, trailer_start: i32, trailer_count: i32,
    failure: Error
}
pub fn cursor(mode: CursorMode, limits: Limits, rawcap: i32, maximum_work: u64) -> core::result::Result<Cursor,Error> {
    if (!limits_valid(limits) || rawcap < 0) { return core::result::Err(Error::Bounds); }
    return core::result::Ok(Cursor { mode: mode, limits: limits, rawcap: rawcap, maximum_work: maximum_work, work_used: 0,
        phase: 0, pos: 0, line_start: 0, pending_cr: false, first_line: true, head_fields: 0, previous_length: 0, ended: false,
        head_end: 0, decoded: 0, remaining: 0, chunks: 0, trailer_start: 0, trailer_count: 0, failure: Error::Bounds });
}
pub impl Cursor {
    pub fn borrow(&self) -> &Cursor { return self; }
    pub fn work(&self) -> u64 { return self.work_used; }
    fn charge(&self, amount: u64) -> bool {
        if (amount > self.maximum_work-self.work_used) { return false; }
        self.work_used += amount; return true;
    }
    fn failed(&self, failure: Error) -> core::result::Result<Scan,Error> { self.failure = failure; self.phase = 10; return core::result::Err(failure); }
    fn boundary(&self) -> core::result::Result<Scan,Error> { self.phase = 9; return core::result::Ok(Scan::Boundary(FrameBoundary { consumed: self.pos, decoded_length: self.decoded })); }
    fn need(&self, available: i32) -> core::result::Result<Scan,Error> {
        // Close can finish at EOF without another byte. Other phases cannot.
        if (available == self.rawcap && self.phase != 3) { return self.failed(Error::Limit(available)); }
        if (self.ended) { return self.failed(Error::Incomplete(available)); }
        return core::result::Ok(Scan::NeedMore);
    }
    // A saved CR is consumed once, including across a relocated input prefix.
    // Only line mechanics live here; complete section grammar uses head(),
    // chunk_size() and field(), the same authorities as the full parser.
    fn scan_line(&self, bytes: core::slice::View<u8>, section_end: i32) -> core::result::Result<i32,Error> {
        while (self.pos < bytes.len()) {
            if (self.pending_cr) {
                if (!self.charge(1)) { return core::result::Err(Error::Limit(self.pos)); }
                if (byte(bytes,self.pos) != 10) { return core::result::Err(Error::Malformed(self.pos)); }
                if (self.pos >= section_end) { return core::result::Err(Error::Limit(self.pos-1)); }
                let end: i32 = self.pos-1; self.pos += 1; self.pending_cr = false; return core::result::Ok(end);
            }
            if (self.pos-self.line_start > self.limits.line_bytes || self.pos >= section_end) { return core::result::Err(Error::Limit(self.pos)); }
            if (!self.charge(1)) { return core::result::Err(Error::Limit(self.pos)); }
            let c: u8 = byte(bytes,self.pos);
            if (c == 10 || c == 0 || (c < 32 && c != 9 && c != 13) || c == 127) { return core::result::Err(Error::Malformed(self.pos)); }
            self.pos += 1; if (c == 13) { self.pending_cr = true; }
        }
        if (!self.pending_cr && (self.pos-self.line_start > self.limits.line_bytes || self.pos >= section_end)) { return core::result::Err(Error::Limit(self.pos)); }
        return core::result::Ok(-1);
    }
    // bytes is a cumulative, immutable logical prefix. It may move or use a
    // different physical stride. method must be the same original method on
    // every response call. EOF is sticky; no appended bytes after EOF.
    pub fn advance(&self, bytes: core::slice::View<u8>, method: core::slice::View<u8>, eof: bool) -> core::result::Result<Scan,Error> {
        if (self.phase == 10) { return core::result::Err(self.failure); }
        if (self.phase == 9) { return core::result::Ok(Scan::Boundary(FrameBoundary { consumed: self.pos, decoded_length: self.decoded })); }
        if (!valid(bytes) || !valid(method) || bytes.len() < self.previous_length || (self.ended && bytes.len() != self.previous_length)) { return self.failed(Error::Bounds); }
        self.previous_length = bytes.len(); self.ended = self.ended || eof;
        let available: i32 = bytes.len(); if (available > self.rawcap) { available = self.rawcap; }
        let input: core::slice::View<u8> = part(bytes,0,available);
        while (true) {
            if (self.phase == 0 || self.phase == 4 || self.phase == 8) {
                let bound: i32 = 2147483647;
                if (self.phase == 0) { bound = self.limits.head_bytes; }
                if (self.phase == 8 && self.limits.trailer_bytes <= 2147483647-self.trailer_start) { bound = self.trailer_start+self.limits.trailer_bytes; }
                let found: core::result::Result<i32,Error> = self.scan_line(input,bound);
                if (core::result::is_err(found)) { return self.failed(core::result::unwrap_err(found)); }
                let end: i32 = core::result::unwrap(found);
                if (end < 0) { return self.need(available); }
                let start: i32 = self.line_start;
                self.line_start = self.pos;
                if (self.phase == 0) {
                    if (self.first_line) { self.first_line = false; }
                    else {
                        if (end != start) { if (self.head_fields == self.limits.headers) { return self.failed(Error::Limit(start)); } self.head_fields += 1; }
                        else {
                            let request: bool = match (self.mode) { CursorMode::Request -> true, CursorMode::Response -> false };
                            let original: core::slice::View<u8> = literal("",0); if (!request) { original = method; }
                            if (!self.charge((self.pos as u64)+(original.len() as u64))) { return self.failed(Error::Limit(self.pos)); }
                            let parsed: core::result::Result<Head,Error> = head(part(input,0,self.pos),request,original,self.limits);
                            if (core::result::is_err(parsed)) { return self.failed(core::result::unwrap_err(parsed)); }
                            let h: Head = core::result::unwrap(parsed); self.head_end = self.pos;
                            self.phase = match (h.kind) { BodyKind::Empty -> 1, BodyKind::Tunnel -> 1, BodyKind::Fixed -> 2, BodyKind::Close -> 3, BodyKind::Chunked -> 4 };
                            self.remaining = h.content_length;
                            return core::result::Ok(Scan::HeadReady(HeadInfo { status: h.status, version: h.version, kind: h.kind, content_length: h.content_length, head_end: self.pos }));
                        }
                    }
                } else {
                    if (self.phase == 4) {
                        if (!self.charge((end-start) as u64)) { return self.failed(Error::Limit(start)); }
                        let sized: core::result::Result<i32,Error> = chunk_size(input,start,end);
                        if (core::result::is_err(sized)) { return self.failed(core::result::unwrap_err(sized)); }
                        let amount: i32 = core::result::unwrap(sized);
                        if (amount == 0) { self.phase = 8; self.trailer_start = self.pos; }
                        else {
                            if (self.chunks == self.limits.chunks || amount > self.limits.body_bytes-self.decoded) { return self.failed(Error::Limit(self.pos)); }
                            self.chunks += 1; self.remaining = amount; self.phase = 5;
                        }
                    } else {
                        if (end == start) { return self.boundary(); }
                        if (self.trailer_count == self.limits.trailers) { return self.failed(Error::Limit(start)); }
                        self.trailer_count += 1;
                        if (!self.charge((end-start) as u64)) { return self.failed(Error::Limit(start)); }
                        let parsed: core::result::Result<Field,Error> = field(input,start,end);
                        if (core::result::is_err(parsed)) { return self.failed(core::result::unwrap_err(parsed)); }
                        if (forbidden(core::result::unwrap(parsed).name)) { return self.failed(Error::Malformed(start)); }
                        // Connection-nominated trailer fields are checked by the
                        // final canonical parser, not this framing candidate.
                    }
                }
            } else {
                if (self.phase == 1) { return self.boundary(); }
                if (self.phase == 2 || self.phase == 5) {
                    if (self.phase == 2 && self.remaining > self.limits.body_bytes) { return self.failed(Error::Limit(self.head_end)); }
                    let amount: i32 = self.remaining; if (amount > available-self.pos) { amount = available-self.pos; }
                    if (!self.charge(amount as u64)) { return self.failed(Error::Limit(self.pos)); }
                    self.pos += amount; self.decoded += amount; self.remaining -= amount;
                    if (self.remaining != 0) { return self.need(available); }
                    if (self.phase == 2) { return self.boundary(); } self.phase = 6;
                } else {
                    if (self.phase == 3) {
                        if (bytes.len() > self.rawcap || bytes.len()-self.head_end > self.limits.body_bytes) { return self.failed(Error::Limit(self.head_end)); }
                        let amount: i32 = available-self.pos;
                        if (!self.charge(amount as u64)) { return self.failed(Error::Limit(self.pos)); }
                        self.pos = available; self.decoded += amount;
                        if (self.ended) { return self.boundary(); } return self.need(available);
                    }
                    // Separate CR / LF phases avoid rescanning a split delimiter.
                    if (self.pos == available) { return self.need(available); }
                    if (!self.charge(1)) { return self.failed(Error::Limit(self.pos)); }
                    let expected: u8 = 13; if (self.phase == 7) { expected = 10; }
                    if (byte(input,self.pos) != expected) { return self.failed(Error::Malformed(self.pos)); }
                    self.pos += 1;
                    if (self.phase == 6) { self.phase = 7; } else { self.phase = 4; self.line_start = self.pos; }
                }
            }
        }
        return self.failed(Error::Bounds);
    }
}

// Message must come from parse_* and source must remain unchanged. Destination
// must not overlap source. No mutation occurs for bounds/capacity errors.
pub fn decode_into(value: Message, destination: core::slice::View<u8>) -> core::result::Result<i32,Error> {
    if (!valid(destination)) { return core::result::Err(Error::Bounds); } if (destination.len() < value.decoded_length) { return core::result::Err(Error::Capacity); }
    let chunked: bool = match (value.head.kind) { BodyKind::Chunked -> true, _ -> false }; let out: i32 = 0; let input: core::slice::View<u8> = value.encoded_body;
    if (!chunked) { while (out < value.decoded_length) { core::result::unwrap(destination.try_set(out,byte(input,out))); out += 1; } }
    else { let pos: i32 = 0; while (out < value.decoded_length) { let end: i32 = pos; while (byte(input,end) != 13) { end += 1; } let size: i32 = core::result::unwrap(chunk_size(input,pos,end)); pos = end+2; let i: i32 = 0; while (i < size) { core::result::unwrap(destination.try_set(out,byte(input,pos+i))); out += 1; i += 1; } pos += size+2; } }
    return core::result::Ok(out);
}
// Validates the complete supplied raw head and copies only that head. This is
// useful for replay, with framing edits provided by encode_* below.
pub fn write_head_into(value: Head, destination: core::slice::View<u8>, limits: Limits) -> core::result::Result<i32,Error> {
    let checked: core::result::Result<Head,Error> = head(value.raw,value.request,value.method,limits); if (core::result::is_err(checked)) { return core::result::Err(core::result::unwrap_err(checked)); }
    let validated: Head = core::result::unwrap(checked); let tunnel: bool = match (validated.kind) { BodyKind::Tunnel -> true, _ -> false };
    if (tunnel) { let content: core::option::Option<Field> = validated.lookup(literal("content-length",14)); if (core::option::is_some(content)) { return core::result::Err(Error::Malformed(core::option::unwrap(content).offset)); } let transfer: core::option::Option<Field> = validated.lookup(literal("transfer-encoding",17)); if (core::option::is_some(transfer)) { return core::result::Err(Error::Malformed(core::option::unwrap(transfer).offset)); } }
    if (core::result::unwrap(checked).raw.len() != value.raw.len()) { return core::result::Err(Error::Malformed(core::result::unwrap(checked).raw.len())); }
    if (!valid(destination)) { return core::result::Err(Error::Bounds); } if (destination.len() < value.raw.len()) { return core::result::Err(Error::Capacity); }
    let i: i32 = 0; while (i < value.raw.len()) { core::result::unwrap(destination.try_set(i,byte(value.raw,i))); i += 1; } return core::result::Ok(i);
}
fn append(output: &alloc::vec::Vec<u8>, value: core::slice::View<u8>) -> bool { return core::result::is_ok(output.try_extend(value)); }
fn decimal(output: &alloc::vec::Vec<u8>, value: i32) -> bool { let digits: [u8;10] = [0;10]; let i: i32 = 10; let n: i32 = value; while (true) { i -= 1; digits[i] = ((n%10)+48) as u8; n /= 10; if (n == 0) { break; } } return append(output,core::result::unwrap(core::slice::view_range(digits,i,10-i))); }
fn decimal_digits(value: i32) -> i32 { let digits: i32 = 1; let n: i32 = value; while (n >= 10) { n /= 10; digits += 1; } return digits; }
fn encode(start_line: core::slice::View<u8>, request: bool, method: core::slice::View<u8>, fields: core::slice::View<Field>, body: core::slice::View<u8>, limits: Limits) -> core::result::Result<alloc::vec::Vec<u8>,Error> {
    if (!valid(start_line) || !valid(method) || !valid(body) || fields.start < 0 || fields.length < 0 || fields.start > 2147483647-fields.length || !limits_valid(limits)) { return core::result::Err(Error::Bounds); }
    let status: i32 = 0; if (!request && start_line.len() >= 12 && digit(byte(start_line,9)) && digit(byte(start_line,10)) && digit(byte(start_line,11))) { status = ((byte(start_line,9)-48) as i32)*100+((byte(start_line,10)-48) as i32)*10+(byte(start_line,11)-48) as i32; }
    if (!request && status == 205 && !body.is_empty()) { return core::result::Err(Error::Malformed(0)); }
    let omit_length: bool = !request && (status < 200 || status == 204 || status == 304 || exact(method,literal("HEAD",4)) || (exact(method,literal("CONNECT",7)) && status >= 200 && status < 300));
    let extra: i32 = 1; if (omit_length) { extra = 0; if (!body.is_empty()) { return core::result::Err(Error::Malformed(0)); } }
    if (body.len() > limits.body_bytes || extra > limits.headers || fields.len() > limits.headers-extra || start_line.len() > limits.line_bytes) { return core::result::Err(Error::Limit(0)); }
    let at: i32 = 0; while (at < start_line.len()) { let c: u8 = byte(start_line,at); if (c < 32 || c == 127) { return core::result::Err(Error::Malformed(at)); } at += 1; }
    // Preflight serialized size before allocating or copying output. Head
    // accounting includes both start-line CRLF and the final empty-line CRLF.
    if (start_line.len() > limits.head_bytes || limits.head_bytes-start_line.len() < 4) { return core::result::Err(Error::Limit(0)); }
    let head_bytes: i32 = start_line.len()+4; let i: i32 = 0;
    while (i < fields.len()) { let item: Field = core::option::unwrap(fields.get(i)); if (!valid(item.name) || !valid(item.value)) { return core::result::Err(Error::Bounds); }
        if (item.name.is_empty()) { return core::result::Err(Error::Malformed(i)); }
        if (limits.line_bytes < 2 || item.name.len() > limits.line_bytes-2 || item.value.len() > limits.line_bytes-2-item.name.len()) { return core::result::Err(Error::Limit(i)); }
        let remaining: i32 = limits.head_bytes-head_bytes;
        if (item.name.len() > remaining) { return core::result::Err(Error::Limit(0)); }
        remaining -= item.name.len();
        if (remaining < 4 || item.value.len() > remaining-4) { return core::result::Err(Error::Limit(0)); }
        if (named(item.name,"content-length",14) || named(item.name,"transfer-encoding",17)) { return core::result::Err(Error::Malformed(i)); }
        let j: i32 = 0; while (j < item.name.len()) { if (!token(byte(item.name,j))) { return core::result::Err(Error::Malformed(i)); } j += 1; }
        j = 0; while (j < item.value.len()) { let c: u8 = byte(item.value,j); if (c == 127 || (c < 32 && c != 9)) { return core::result::Err(Error::Malformed(i)); } j += 1; }
        head_bytes += item.name.len()+item.value.len()+4; i += 1;
    }
    if (!omit_length) {
        let line_bytes: i32 = 16+decimal_digits(body.len());
        if (line_bytes+2 > limits.head_bytes-head_bytes) { return core::result::Err(Error::Limit(0)); }
        if (line_bytes > limits.line_bytes) { return core::result::Err(Error::Limit(head_bytes-2+limits.line_bytes+1)); }
        head_bytes += line_bytes+2;
    }
    if (body.len() > 2147483647-head_bytes) { return core::result::Err(Error::Limit(0)); }
    let allocated: core::result::Result<alloc::vec::Vec<u8>,alloc::vec::Error> = alloc::vec::with_capacity(head_bytes+body.len());
    if (core::result::is_err(allocated)) { return core::result::Err(Error::AllocationFailed); }
    let out: alloc::vec::Vec<u8> = core::result::unwrap(allocated);
    let ok: bool = append(out.borrow(),start_line) && append(out.borrow(),literal("\r\n",2)); i = 0;
    while (i < fields.len() && ok) { let item: Field = core::option::unwrap(fields.get(i));
        ok = append(out.borrow(),item.name) && append(out.borrow(),literal(": ",2)) && append(out.borrow(),item.value) && append(out.borrow(),literal("\r\n",2)); i += 1;
    }
    if (ok && !omit_length) { ok = append(out.borrow(),literal("Content-Length: ",16)) && decimal(out.borrow(),body.len()) && append(out.borrow(),literal("\r\n",2)); }
    if (ok) { ok = append(out.borrow(),literal("\r\n",2)); }
    if (!ok) { out.destroy(); return core::result::Err(Error::AllocationFailed); }
    let parsed: core::result::Result<Head,Error> = head(out.as_view(),request,method,limits); if (core::result::is_err(parsed)) { let failure: Error = core::result::unwrap_err(parsed); out.destroy(); return core::result::Err(failure); }
    let h: Head = core::result::unwrap(parsed); if (h.raw.len() != out.len()) { out.destroy(); return core::result::Err(Error::Malformed(0)); } let no_body: bool = match (h.kind) { BodyKind::Empty -> true, BodyKind::Tunnel -> true, _ -> false };
    if (no_body && !body.is_empty()) { out.destroy(); return core::result::Err(Error::Malformed(0)); }
    if (!append(out.borrow(),body)) { out.destroy(); return core::result::Err(Error::AllocationFailed); } return core::result::Ok(out);
}
// Start line is explicit (without CRLF); checked against request/response ABNF.
// Caller fields exclude Content-Length and Transfer-Encoding. Result has one
// owner; destroy it. On errors all temporary allocations are released.
pub fn encode_request(start_line: core::slice::View<u8>, fields: core::slice::View<Field>, body: core::slice::View<u8>, limits: Limits) -> core::result::Result<alloc::vec::Vec<u8>,Error> { return encode(start_line,true,literal("",0),fields,body,limits); }
pub fn encode_response(start_line: core::slice::View<u8>, method: core::slice::View<u8>, fields: core::slice::View<Field>, body: core::slice::View<u8>, limits: Limits) -> core::result::Result<alloc::vec::Vec<u8>,Error> { return encode(start_line,false,method,fields,body,limits); }
