    if(head.version!=11 || !exact(head.method,literal("GET",3)) || head.content_length>0 || core::option::is_some(head.lookup(literal("Transfer-Encoding",17)))) { return core::result::Err(Error::Handshake); }
    if(!contains_header_token(head,"upgrade",7,"websocket",9,true) || !contains_header_token(head,"connection",10,"upgrade",7,false)) { return core::result::Err(Error::Handshake); }
    let key=required(head,"sec-websocket-key",17); let version=required(head,"sec-websocket-version",21); if(core::result::is_err(key) || core::result::is_err(version)) { return core::result::Err(Error::Handshake); }
    if(!valid_key(core::result::unwrap(key)) || !exact(core::result::unwrap(version),literal("13",2)) || field_count(head,"origin",6)>1 || field_count(head,"sec-websocket-accept",20)>0) { return core::result::Err(Error::Handshake); }
    let count=protocol_count(head,limits.protocols); if(core::result::is_err(count)) { return core::result::Err(core::result::unwrap_err(count)); }
