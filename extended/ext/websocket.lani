    return core::result::Ok(Request { head:head,key:core::result::unwrap(key),protocol_count:core::result::unwrap(count) });
}
fn reserved(name:core::slice::View<u8>) -> bool { return named(name,"upgrade",7) || named(name,"connection",10) || named(name,"sec-websocket-key",17) || named(name,"sec-websocket-version",21) || named(name,"sec-websocket-accept",20) || named(name,"sec-websocket-protocol",22) || named(name,"sec-websocket-extensions",24) || named(name,"content-length",14) || named(name,"transfer-encoding",17); }
fn add_field(fields:&alloc::vec::Vec<ext::http::Field>, name:core::slice::View<u8>, value:core::slice::View<u8>) -> bool { let item:ext::http::Field=ext::http::Field { raw:part(name,0,0),name:name,value:value,offset:0 }; return core::result::is_ok(fields.try_push(item)); }
fn caller_fields(input:core::slice::View<ext::http::Field>, output:&alloc::vec::Vec<ext::http::Field>, limits:Limits) -> core::result::Result<i32,Error> {
    if(input.start<0 || input.length<0 || input.start>2147483647-input.length) { return core::result::Err(Error::Bounds); } let i:i32=0; while(i<input.len()) { let item:ext::http::Field=core::option::unwrap(input.get(i)); if(!valid(item.name) || !valid(item.value)) { return core::result::Err(Error::Bounds); } if(reserved(item.name)) { return core::result::Err(Error::Handshake); } if(item.name.len()>limits.http.line_bytes-2 || item.value.len()>limits.http.line_bytes-2-item.name.len()) { return core::result::Err(Error::Limit(i)); } if(core::result::is_err(output.try_push(item))) { return core::result::Err(Error::AllocationFailed); } i+=1; } return core::result::Ok(i);
