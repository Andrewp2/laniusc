// Native f64 matrices. Owned records copy handles: keep one active owner and
// destroy once. All fallible operations preserve input owners and borrowed data.
module ext::linalg;
import alloc::vec;
import core::f64;
import core::result;

pub enum Error { Shape, Bounds, InvalidStride, Overflow, InvalidLimits, ElementLimit, WorkLimit, NonFinite, NumericalFailure, InvalidTolerance, Singular, RankDeficient, NotSquare, UnderDetermined, AllocationFailed }
pub struct Limits { max_elements: i32, max_work: u64 }
pub struct MatrixView { values: [f64], count: i32, offset: i32, rows: i32, cols: i32, row_stride: i32, col_stride: i32 }
pub struct Matrix { data: alloc::vec::Vec<f64>, rows: i32, cols: i32 }
pub struct Lu { factors: Matrix, pivots: alloc::vec::Vec<i32>, parity: i32, scale: f64, tolerance: f64 }
pub struct Qr { factors: Matrix, tau: alloc::vec::Vec<f64>, scale: f64, tolerance: f64 }

pub fn default_limits() -> Limits { return Limits { max_elements: 1048576, max_work: 100000000 }; }
pub fn default_tolerance() -> f64 { return 0.000000000001; }
fn valid_limits(limits: Limits) -> bool { return limits.max_elements >= 0; }
fn size(rows: i32, cols: i32) -> core::result::Result<i32, Error> {
    if (rows < 0 || cols < 0) { return core::result::Err(Error::Shape); }
    let count: i64 = (rows as i64)*(cols as i64);
    if (count > 268435455) { return core::result::Err(Error::Overflow); }
    return core::result::Ok(count as i32);
}
fn allowed(rows: i32, cols: i32, limits: Limits) -> core::result::Result<i32, Error> {
    if (!valid_limits(limits)) { return core::result::Err(Error::InvalidLimits); }
    let n: core::result::Result<i32, Error> = size(rows,cols); if (n.is_err()) { return n; }
    if (n.unwrap() > limits.max_elements) { return core::result::Err(Error::ElementLimit); }
    return n;
}
// Check products by division before multiplying, including enormous empty shapes.
fn work(a: u64, b: u64, c: u64, limits: Limits) -> bool {
    if (a == 0 || b == 0 || c == 0) { return true; }
    if (a > limits.max_work/b) { return false; }
    return a*b <= limits.max_work/c;
}
fn tolerance_ok(value: f64) -> bool { return core::f64::is_finite(value) && value >= 0.0; }
fn small(value: f64, scale: f64, tolerance: f64) -> bool {
    if (value == 0.0) { return true; }
    if (scale == 0.0) { return true; }
    if (tolerance == 0.0) { return false; }
    let magnitude: f64 = core::f64::abs(value);
    if (magnitude > scale) { if (tolerance <= 1.0) { return false; } return magnitude/tolerance <= scale; }
    return magnitude/scale <= tolerance;
}
pub fn validate(view: MatrixView) -> core::result::Result<i32, Error> {
    let n: core::result::Result<i32, Error> = size(view.rows,view.cols); if (n.is_err()) { return n; }
    if (view.count < 0 || view.offset < 0 || view.offset > view.count) { return core::result::Err(Error::Bounds); }
    if (view.row_stride < 0 || view.col_stride < 0 || (view.rows > 1 && view.cols > 0 && view.row_stride == 0) || (view.cols > 1 && view.rows > 0 && view.col_stride == 0)) { return core::result::Err(Error::InvalidStride); }
    if (n.unwrap() > 0) {
        let last: i64 = (view.offset as i64) + ((view.rows-1) as i64)*(view.row_stride as i64) + ((view.cols-1) as i64)*(view.col_stride as i64);
        if (last >= (view.count as i64)) { return core::result::Err(Error::Bounds); }
    }
    return n;
}
pub fn strided(values: [f64], count: i32, offset: i32, rows: i32, cols: i32, row_stride: i32, col_stride: i32) -> core::result::Result<MatrixView, Error> {
    let view: MatrixView = MatrixView { values: values, count: count, offset: offset, rows: rows, cols: cols, row_stride: row_stride, col_stride: col_stride };
    let checked: core::result::Result<i32, Error> = validate(view); if (checked.is_err()) { return core::result::Err(checked.unwrap_err()); }
    return core::result::Ok(view);
}
pub fn row_major(values: [f64], count: i32, rows: i32, cols: i32) -> core::result::Result<MatrixView, Error> { return strided(values,count,0,rows,cols,cols,1); }
pub fn transpose(view: MatrixView) -> core::result::Result<MatrixView, Error> { return strided(view.values,view.count,view.offset,view.cols,view.rows,view.col_stride,view.row_stride); }
fn read(view: MatrixView, row: i32, col: i32) -> f64 { return view.values[view.offset + row*view.row_stride + col*view.col_stride]; }
pub impl MatrixView {
    pub fn get(&self, row: i32, col: i32) -> core::result::Result<f64, Error> {
        let view: MatrixView = MatrixView { values: self.values, count: self.count, offset: self.offset, rows: self.rows, cols: self.cols, row_stride: self.row_stride, col_stride: self.col_stride };
        let checked: core::result::Result<i32, Error> = validate(view); if (checked.is_err()) { return core::result::Err(checked.unwrap_err()); }
        if (row < 0 || col < 0 || row >= self.rows || col >= self.cols) { return core::result::Err(Error::Bounds); }
        return core::result::Ok(read(view,row,col));
    }
}
fn checked(view: MatrixView, limits: Limits) -> core::result::Result<f64, Error> {
    let n: core::result::Result<i32, Error> = allowed(view.rows,view.cols,limits); if (n.is_err()) { return core::result::Err(n.unwrap_err()); }
    let v: core::result::Result<i32, Error> = validate(view); if (v.is_err()) { return core::result::Err(v.unwrap_err()); }
    if (!work(n.unwrap() as u64,1,1,limits)) { return core::result::Err(Error::WorkLimit); }
    let maximum: f64 = 0.0; let i: i32 = 0;
    while (i < n.unwrap()) { let value: f64 = read(view,i/view.cols,i%view.cols); if (!core::f64::is_finite(value)) { return core::result::Err(Error::NonFinite); } maximum = core::f64::max(maximum,core::f64::abs(value)); i += 1; }
    return core::result::Ok(maximum);
}
pub fn zeros(rows: i32, cols: i32, limits: Limits) -> core::result::Result<Matrix, Error> {
    let n: core::result::Result<i32, Error> = allowed(rows,cols,limits); if (n.is_err()) { return core::result::Err(n.unwrap_err()); }
    if (!work(n.unwrap() as u64,1,1,limits)) { return core::result::Err(Error::WorkLimit); }
    let reserved: core::result::Result<alloc::vec::Vec<f64>,alloc::vec::Error> = alloc::vec::with_capacity<f64>(n.unwrap());
    if (reserved.is_err()) { return core::result::Err(Error::AllocationFailed); }
    let data: alloc::vec::Vec<f64> = reserved.unwrap(); let i: i32 = 0;
    while (i < n.unwrap()) { let added: core::result::Result<i32,alloc::vec::Error> = data.try_push(0.0); if (added.is_err()) { data.destroy(); return core::result::Err(Error::AllocationFailed); } i += 1; }
    return core::result::Ok(Matrix { data: data, rows: rows, cols: cols });
}
pub fn from_view(view: MatrixView, limits: Limits) -> core::result::Result<Matrix, Error> {
    let v: core::result::Result<f64,Error> = checked(view,limits); if (v.is_err()) { return core::result::Err(v.unwrap_err()); }
    let made: core::result::Result<Matrix,Error> = zeros(view.rows,view.cols,limits); if (made.is_err()) { return made; }
    let result: Matrix = made.unwrap(); let target: [f64] = result.data.as_slice(); let i: i32 = 0; let n: i32 = result.data.len();
    while (i < n) { target[i] = read(view,i/view.cols,i%view.cols); i += 1; }
    return core::result::Ok(result);
}
pub impl Matrix {
    pub fn borrow(&self) -> &Matrix { return self; }
    pub fn view(&self) -> MatrixView { return MatrixView { values: self.data.as_slice(), count: self.data.len(), offset: 0, rows: self.rows, cols: self.cols, row_stride: self.cols, col_stride: 1 }; }
    pub fn destroy(&self) { self.data.destroy(); self.rows = 0; self.cols = 0; }
    pub fn get(&self, row: i32, col: i32) -> core::result::Result<f64,Error> { let view: MatrixView = self.view(); return view.get(row,col); }
    pub fn set(&self, row: i32, col: i32, value: f64) -> core::result::Result<i32,Error> {
        if (row < 0 || col < 0 || row >= self.rows || col >= self.cols) { return core::result::Err(Error::Bounds); }
        if (!core::f64::is_finite(value)) { return core::result::Err(Error::NonFinite); }
        let target: [f64] = self.data.as_slice(); target[row*self.cols+col] = value; return core::result::Ok(0);
    }
    pub fn try_clone(&self, limits: Limits) -> core::result::Result<Matrix,Error> { return from_view(self.view(),limits); }
    pub fn transpose(&self, limits: Limits) -> core::result::Result<Matrix,Error> { let view: MatrixView = core::result::unwrap(transpose(self.view())); return from_view(view,limits); }
}
fn elementwise(a: MatrixView, b: MatrixView, factor: f64, mode: i32, limits: Limits) -> core::result::Result<Matrix,Error> {
    if (mode != 2 && (a.rows != b.rows || a.cols != b.cols)) { return core::result::Err(Error::Shape); }
    if (!core::f64::is_finite(factor)) { return core::result::Err(Error::NonFinite); }
    let av: core::result::Result<f64,Error> = checked(a,limits); if (av.is_err()) { return core::result::Err(av.unwrap_err()); }
    if (mode != 2) { let bv: core::result::Result<f64,Error> = checked(b,limits); if (bv.is_err()) { return core::result::Err(bv.unwrap_err()); } }
    let made: core::result::Result<Matrix,Error> = zeros(a.rows,a.cols,limits); if (made.is_err()) { return made; }
    let result: Matrix = made.unwrap(); let target: [f64] = result.data.as_slice(); let i: i32 = 0; let n: i32 = result.data.len();
    while (i < n) { let value: f64 = read(a,i/a.cols,i%a.cols)*factor; if (mode != 2) { value = read(a,i/a.cols,i%a.cols) + factor*read(b,i/a.cols,i%a.cols); } if (!core::f64::is_finite(value)) { result.destroy(); return core::result::Err(Error::NumericalFailure); } target[i] = value; i += 1; }
    return core::result::Ok(result);
}
pub fn add(a: MatrixView,b: MatrixView,limits: Limits) -> core::result::Result<Matrix,Error> { return elementwise(a,b,1.0,0,limits); }
pub fn sub(a: MatrixView,b: MatrixView,limits: Limits) -> core::result::Result<Matrix,Error> { return elementwise(a,b,-1.0,1,limits); }
pub fn scale(a: MatrixView,factor: f64,limits: Limits) -> core::result::Result<Matrix,Error> { return elementwise(a,a,factor,2,limits); }
pub fn matmul(a: MatrixView,b: MatrixView,limits: Limits) -> core::result::Result<Matrix,Error> {
    if (a.cols != b.rows) { return core::result::Err(Error::Shape); }
    let av: core::result::Result<f64,Error> = checked(a,limits); if (av.is_err()) { return core::result::Err(av.unwrap_err()); }
    let bv: core::result::Result<f64,Error> = checked(b,limits); if (bv.is_err()) { return core::result::Err(bv.unwrap_err()); }
    if (!work(a.rows as u64,b.cols as u64,(a.cols as u64)+1,limits)) { return core::result::Err(Error::WorkLimit); }
    let made: core::result::Result<Matrix,Error> = zeros(a.rows,b.cols,limits); if (made.is_err()) { return made; }
    let result: Matrix = made.unwrap(); let target: [f64] = result.data.as_slice(); let i: i32 = 0; let count: i32 = result.data.len();
    while (i < count) { let sum: f64 = 0.0; let k: i32 = 0; while (k < a.cols) { let product: f64 = read(a,i/b.cols,k)*read(b,k,i%b.cols); if (!core::f64::is_finite(product)) { result.destroy(); return core::result::Err(Error::NumericalFailure); } sum += product; if (!core::f64::is_finite(sum)) { result.destroy(); return core::result::Err(Error::NumericalFailure); } k += 1; } target[i] = sum; i += 1; }
    return core::result::Ok(result);
}
// Scaled sum of squares: never square the original large or tiny values.
pub fn norm(view: MatrixView, limits: Limits) -> core::result::Result<f64,Error> {
    let v: core::result::Result<f64,Error> = checked(view,limits); if (v.is_err()) { return v; }
    let maximum: f64 = v.unwrap(); if (maximum == 0.0) { return core::result::Ok(0.0); }
    let sum: f64 = 0.0; let i: i32 = 0; let n: i32 = view.rows*view.cols;
    while (i < n) { let ratio: f64 = read(view,i/view.cols,i%view.cols)/maximum; sum += ratio*ratio; i += 1; }
    let value: f64 = maximum*core::f64::sqrt(sum); if (!core::f64::is_finite(value)) { return core::result::Err(Error::NumericalFailure); } return core::result::Ok(value);
}

// Unblocked DGETF2 phases: pivot, swap whole rows, divide, trailing update.
pub fn lu(view: MatrixView, tolerance: f64, limits: Limits) -> core::result::Result<Lu,Error> {
    if (!tolerance_ok(tolerance)) { return core::result::Err(Error::InvalidTolerance); }
    let v: core::result::Result<f64,Error> = checked(view,limits); if (v.is_err()) { return core::result::Err(v.unwrap_err()); }
    let steps: i32 = view.rows; if (view.cols < steps) { steps = view.cols; }
    if (!work(view.rows as u64,view.cols as u64,(steps as u64)+2,limits)) { return core::result::Err(Error::WorkLimit); }
    let made: core::result::Result<Matrix,Error> = from_view(view,limits); if (made.is_err()) { return core::result::Err(made.unwrap_err()); }
    let a: Matrix = made.unwrap(); let p: core::result::Result<alloc::vec::Vec<i32>,alloc::vec::Error> = alloc::vec::with_capacity<i32>(steps);
    if (p.is_err()) { a.destroy(); return core::result::Err(Error::AllocationFailed); }
    let pivots: alloc::vec::Vec<i32> = p.unwrap(); let values: [f64] = a.data.as_slice(); let parity: i32 = 1; let k: i32 = 0;
    while (k < steps) {
        let pivot: i32 = k; let r: i32 = k+1;
        while (r < view.rows) { if (core::f64::abs(values[r*view.cols+k]) > core::f64::abs(values[pivot*view.cols+k])) { pivot = r; } r += 1; }
        if (small(values[pivot*view.cols+k],v.unwrap(),tolerance)) { pivots.destroy(); a.destroy(); return core::result::Err(Error::Singular); }
        let pushed: core::result::Result<i32,alloc::vec::Error> = pivots.try_push(pivot); if (pushed.is_err()) { pivots.destroy(); a.destroy(); return core::result::Err(Error::AllocationFailed); }
        if (pivot != k) { let c: i32 = 0; while (c < view.cols) { let old: f64 = values[k*view.cols+c]; values[k*view.cols+c] = values[pivot*view.cols+c]; values[pivot*view.cols+c] = old; c += 1; } parity = -parity; }
        r = k+1; while (r < view.rows) {
            let numerator: f64 = values[r*view.cols+k]; let multiplier: f64 = numerator/values[k*view.cols+k];
            if (!core::f64::is_finite(multiplier) || (numerator != 0.0 && multiplier == 0.0)) { pivots.destroy(); a.destroy(); return core::result::Err(Error::NumericalFailure); }
            values[r*view.cols+k] = multiplier; let c: i32 = k+1;
            while (c < view.cols) { let product: f64 = multiplier*values[k*view.cols+c]; let value: f64 = values[r*view.cols+c]-product; if (!core::f64::is_finite(product) || !core::f64::is_finite(value)) { pivots.destroy(); a.destroy(); return core::result::Err(Error::NumericalFailure); } values[r*view.cols+c] = value; c += 1; } r += 1;
        } k += 1;
    }
    return core::result::Ok(Lu { factors: a, pivots: pivots, parity: parity, scale: v.unwrap(), tolerance: tolerance });
}
fn upper_solve(a: MatrixView, values: [f64], rhs_cols: i32, n: i32) -> core::result::Result<i32,Error> {
    let r: i32 = n-1;
    while (r >= 0) { let c: i32 = 0; while (c < rhs_cols) { let value: f64 = values[r*rhs_cols+c]; let k: i32 = r+1; while (k < n) { let product: f64 = read(a,r,k)*values[k*rhs_cols+c]; value -= product; if (!core::f64::is_finite(product) || !core::f64::is_finite(value)) { return core::result::Err(Error::NumericalFailure); } k += 1; } let quotient: f64 = value/read(a,r,r); if (!core::f64::is_finite(quotient) || (value != 0.0 && quotient == 0.0)) { return core::result::Err(Error::NumericalFailure); } values[r*rhs_cols+c] = quotient; c += 1; } r -= 1; }
    return core::result::Ok(0);
}
pub impl Lu {
    pub fn borrow(&self) -> &Lu { return self; }
    pub fn destroy(&self) { self.factors.destroy(); self.pivots.destroy(); }
    pub fn packed(&self) -> MatrixView { return self.factors.view(); }
    pub fn pivot(&self, step: i32) -> core::result::Result<i32,Error> { if (step < 0 || step >= self.pivots.len()) { return core::result::Err(Error::Bounds); } let values: [i32] = self.pivots.as_slice(); return core::result::Ok(values[step]); }
    pub fn determinant(&self) -> core::result::Result<f64,Error> {
        let a: MatrixView = self.factors.view(); if (a.rows != a.cols) { return core::result::Err(Error::NotSquare); }
        let value: f64 = self.parity as f64; let k: i32 = 0;
        while (k < a.rows) { value *= read(a,k,k); if (!core::f64::is_finite(value) || value == 0.0) { return core::result::Err(Error::NumericalFailure); } k += 1; } return core::result::Ok(value);
    }
    pub fn solve(&self,b: MatrixView,limits: Limits) -> core::result::Result<Matrix,Error> {
        let a: MatrixView = self.factors.view(); let bounds: core::result::Result<i32,Error> = allowed(a.rows,a.cols,limits); if (bounds.is_err()) { return core::result::Err(bounds.unwrap_err()); } if (a.rows != a.cols) { return core::result::Err(Error::NotSquare); } if (b.rows != a.rows) { return core::result::Err(Error::Shape); }
        if (!work(a.rows as u64,(a.rows as u64)+3,b.cols as u64,limits)) { return core::result::Err(Error::WorkLimit); }
        let made: core::result::Result<Matrix,Error> = from_view(b,limits); if (made.is_err()) { return made; } let result: Matrix = made.unwrap(); let values: [f64] = result.data.as_slice(); let pivots: [i32] = self.pivots.as_slice(); let k: i32 = 0;
        while (k < a.rows) { let c: i32 = 0; while (c < b.cols) { let old: f64 = values[k*b.cols+c]; values[k*b.cols+c] = values[pivots[k]*b.cols+c]; values[pivots[k]*b.cols+c] = old; c += 1; } k += 1; }
        let r: i32 = 0; while (r < a.rows) { let c: i32 = 0; while (c < b.cols) { let value: f64 = values[r*b.cols+c]; k = 0; while (k < r) { let product: f64 = read(a,r,k)*values[k*b.cols+c]; value -= product; if (!core::f64::is_finite(product) || !core::f64::is_finite(value)) { result.destroy(); return core::result::Err(Error::NumericalFailure); } k += 1; } values[r*b.cols+c] = value; c += 1; } r += 1; }
        let solved: core::result::Result<i32,Error> = upper_solve(a,values,b.cols,a.rows); if (solved.is_err()) { result.destroy(); return core::result::Err(solved.unwrap_err()); } return core::result::Ok(result);
    }
    pub fn inverse(&self,limits: Limits) -> core::result::Result<Matrix,Error> {
        let a: MatrixView = self.factors.view(); if (a.rows != a.cols) { return core::result::Err(Error::NotSquare); }
        let made: core::result::Result<Matrix,Error> = identity(a.rows,limits); if (made.is_err()) { return made; } let unit: Matrix = made.unwrap(); let result: core::result::Result<Matrix,Error> = self.solve(unit.view(),limits); unit.destroy(); return result;
    }
}
pub fn identity(n: i32,limits: Limits) -> core::result::Result<Matrix,Error> { let made: core::result::Result<Matrix,Error> = zeros(n,n,limits); if (made.is_err()) { return made; } let a: Matrix = made.unwrap(); let values: [f64] = a.data.as_slice(); let k: i32 = 0; while (k < n) { values[k*n+k] = 1.0; k += 1; } return core::result::Ok(a); }
pub fn solve(a: MatrixView,b: MatrixView,tolerance: f64,limits: Limits) -> core::result::Result<Matrix,Error> { if (a.rows != a.cols) { return core::result::Err(Error::NotSquare); } let made: core::result::Result<Lu,Error> = lu(a,tolerance,limits); if (made.is_err()) { return core::result::Err(made.unwrap_err()); } let factor: Lu = made.unwrap(); let result: core::result::Result<Matrix,Error> = factor.solve(b,limits); factor.destroy(); return result; }
pub fn inverse(a: MatrixView,tolerance: f64,limits: Limits) -> core::result::Result<Matrix,Error> { if (a.rows != a.cols) { return core::result::Err(Error::NotSquare); } let made: core::result::Result<Lu,Error> = lu(a,tolerance,limits); if (made.is_err()) { return core::result::Err(made.unwrap_err()); } let factor: Lu = made.unwrap(); let result: core::result::Result<Matrix,Error> = factor.inverse(limits); factor.destroy(); return result; }
pub fn determinant(a: MatrixView,tolerance: f64,limits: Limits) -> core::result::Result<f64,Error> { if (a.rows != a.cols) { return core::result::Err(Error::NotSquare); } let made: core::result::Result<Lu,Error> = lu(a,tolerance,limits); if (made.is_err()) { return core::result::Err(made.unwrap_err()); } let factor: Lu = made.unwrap(); let result: core::result::Result<f64,Error> = factor.determinant(); factor.destroy(); return result; }

// Householder QR for m>=n. Reflector ratios are computed after normalizing
// each column by its maximum; this also handles uniformly subnormal columns.
pub fn qr(view: MatrixView,tolerance: f64,limits: Limits) -> core::result::Result<Qr,Error> {
    if (!tolerance_ok(tolerance)) { return core::result::Err(Error::InvalidTolerance); } if (view.rows < view.cols) { return core::result::Err(Error::UnderDetermined); }
    let v: core::result::Result<f64,Error> = checked(view,limits); if (v.is_err()) { return core::result::Err(v.unwrap_err()); }
    if (!work(8*(view.rows as u64),(view.cols as u64)+1,(view.cols as u64)+1,limits)) { return core::result::Err(Error::WorkLimit); }
    let made: core::result::Result<Matrix,Error> = from_view(view,limits); if (made.is_err()) { return core::result::Err(made.unwrap_err()); } let a: Matrix = made.unwrap();
    let made_tau: core::result::Result<alloc::vec::Vec<f64>,alloc::vec::Error> = alloc::vec::with_capacity<f64>(view.cols); if (made_tau.is_err()) { a.destroy(); return core::result::Err(Error::AllocationFailed); } let tau: alloc::vec::Vec<f64> = made_tau.unwrap(); let values: [f64] = a.data.as_slice(); let k: i32 = 0;
    while (k < view.cols) {
        let maximum: f64 = 0.0; let r: i32 = k; while (r < view.rows) { maximum = core::f64::max(maximum,core::f64::abs(values[r*view.cols+k])); r += 1; }
        if (maximum == 0.0) { tau.destroy(); a.destroy(); return core::result::Err(Error::RankDeficient); }
        let sum: f64 = 0.0; r = k; while (r < view.rows) { let ratio: f64 = values[r*view.cols+k]/maximum; sum += ratio*ratio; r += 1; }
        let normalized_norm: f64 = core::f64::sqrt(sum); let beta_scaled: f64 = -core::f64::copy_sign(normalized_norm,values[k*view.cols+k]); let beta: f64 = maximum*beta_scaled;
        if (!core::f64::is_finite(beta) || beta == 0.0) { tau.destroy(); a.destroy(); return core::result::Err(Error::NumericalFailure); }
        if (small(beta,v.unwrap(),tolerance)) { tau.destroy(); a.destroy(); return core::result::Err(Error::RankDeficient); }
        let alpha_scaled: f64 = values[k*view.cols+k]/maximum; let t: f64 = 1.0-alpha_scaled/beta_scaled; let denominator: f64 = alpha_scaled-beta_scaled;
        r = k+1; while (r < view.rows) { let old: f64 = values[r*view.cols+k]; let coefficient: f64 = (old/maximum)/denominator; if (!core::f64::is_finite(coefficient) || (old != 0.0 && coefficient == 0.0)) { tau.destroy(); a.destroy(); return core::result::Err(Error::NumericalFailure); } values[r*view.cols+k] = coefficient; r += 1; }
        values[k*view.cols+k] = beta; let added: core::result::Result<i32,alloc::vec::Error> = tau.try_push(t); if (added.is_err()) { tau.destroy(); a.destroy(); return core::result::Err(Error::AllocationFailed); }
        let c: i32 = k+1; while (c < view.cols) {
            // Normalize each target column before applying H to avoid an
            // unnecessary overflow in tau*(v^T column).
            let magnitude: f64 = 0.0; r = k; while (r < view.rows) { if (r == k || values[r*view.cols+k] != 0.0) { magnitude = core::f64::max(magnitude,core::f64::abs(values[r*view.cols+c])); } r += 1; }
            if (magnitude > 0.0) { let dot: f64 = values[k*view.cols+c]/magnitude; if (values[k*view.cols+c] != 0.0 && dot == 0.0) { tau.destroy(); a.destroy(); return core::result::Err(Error::NumericalFailure); } r = k+1; while (r < view.rows) { if (values[r*view.cols+k] != 0.0) { let ratio: f64 = values[r*view.cols+c]/magnitude; if (values[r*view.cols+c] != 0.0 && ratio == 0.0) { tau.destroy(); a.destroy(); return core::result::Err(Error::NumericalFailure); } let term: f64 = values[r*view.cols+k]*ratio; if (ratio != 0.0 && term == 0.0) { tau.destroy(); a.destroy(); return core::result::Err(Error::NumericalFailure); } dot += term; } r += 1; } dot *= t;
                r = k; while (r < view.rows) { let coefficient: f64 = 1.0; if (r > k) { coefficient = values[r*view.cols+k]; } if (coefficient != 0.0) { let correction: f64 = coefficient*dot; if (dot != 0.0 && correction == 0.0) { tau.destroy(); a.destroy(); return core::result::Err(Error::NumericalFailure); } let next_scaled: f64 = values[r*view.cols+c]/magnitude-correction; let next: f64 = next_scaled*magnitude; if (!core::f64::is_finite(next) || (next_scaled != 0.0 && next == 0.0)) { tau.destroy(); a.destroy(); return core::result::Err(Error::NumericalFailure); } values[r*view.cols+c] = next; } r += 1; }
            } c += 1;
        } k += 1;
    }
    return core::result::Ok(Qr { factors: a, tau: tau, scale: v.unwrap(), tolerance: tolerance });
}
// Apply Q or Q^T to a preserved RHS; H reflectors themselves are symmetric.
fn apply(factor: &Qr,b: MatrixView,transposed: bool,limits: Limits) -> core::result::Result<Matrix,Error> {
    let a: MatrixView = factor.factors.view(); let bounds: core::result::Result<i32,Error> = allowed(a.rows,a.cols,limits); if (bounds.is_err()) { return core::result::Err(bounds.unwrap_err()); } if (b.rows != a.rows) { return core::result::Err(Error::Shape); }
    if (!work(8*(a.rows as u64),(a.cols as u64)+1,(b.cols as u64)+1,limits)) { return core::result::Err(Error::WorkLimit); }
    let made: core::result::Result<Matrix,Error> = from_view(b,limits); if (made.is_err()) { return made; } let result: Matrix = made.unwrap(); let values: [f64] = result.data.as_slice(); let tau: [f64] = factor.tau.as_slice(); let step: i32 = 0;
    while (step < a.cols) { let k: i32 = step; if (!transposed) { k = a.cols-1-step; } let c: i32 = 0; while (c < b.cols) {
        let magnitude: f64 = 0.0; let r: i32 = k; while (r < b.rows) { if (r == k || read(a,r,k) != 0.0) { magnitude = core::f64::max(magnitude,core::f64::abs(values[r*b.cols+c])); } r += 1; }
        if (magnitude > 0.0) { let dot: f64 = values[k*b.cols+c]/magnitude; if (values[k*b.cols+c] != 0.0 && dot == 0.0) { result.destroy(); return core::result::Err(Error::NumericalFailure); } r = k+1; while (r < b.rows) { if (read(a,r,k) != 0.0) { let ratio: f64 = values[r*b.cols+c]/magnitude; if (values[r*b.cols+c] != 0.0 && ratio == 0.0) { result.destroy(); return core::result::Err(Error::NumericalFailure); } let term: f64 = read(a,r,k)*ratio; if (ratio != 0.0 && term == 0.0) { result.destroy(); return core::result::Err(Error::NumericalFailure); } dot += term; } r += 1; } dot *= tau[k];
            r = k; while (r < b.rows) { let coefficient: f64 = 1.0; if (r > k) { coefficient = read(a,r,k); } if (coefficient != 0.0) { let correction: f64 = coefficient*dot; if (dot != 0.0 && correction == 0.0) { result.destroy(); return core::result::Err(Error::NumericalFailure); } let next_scaled: f64 = values[r*b.cols+c]/magnitude-correction; let next: f64 = next_scaled*magnitude; if (!core::f64::is_finite(next) || (next_scaled != 0.0 && next == 0.0)) { result.destroy(); return core::result::Err(Error::NumericalFailure); } values[r*b.cols+c] = next; } r += 1; }
        } c += 1;
    } step += 1; } return core::result::Ok(result);
}
pub impl Qr {
    pub fn borrow(&self) -> &Qr { return self; }
    pub fn destroy(&self) { self.factors.destroy(); self.tau.destroy(); }
    pub fn packed(&self) -> MatrixView { return self.factors.view(); }
    pub fn apply_q(&self,b: MatrixView,limits: Limits) -> core::result::Result<Matrix,Error> { return apply(self,b,false,limits); }
    pub fn apply_q_transpose(&self,b: MatrixView,limits: Limits) -> core::result::Result<Matrix,Error> { return apply(self,b,true,limits); }
    pub fn least_squares(&self,b: MatrixView,limits: Limits) -> core::result::Result<Matrix,Error> {
        let a: MatrixView = self.factors.view(); if (b.rows != a.rows) { return core::result::Err(Error::Shape); }
        if (!work(8*(a.rows as u64),(a.cols as u64)+1,(b.cols as u64)+1,limits)) { return core::result::Err(Error::WorkLimit); }
        let made: core::result::Result<Matrix,Error> = apply(self,b,true,limits); if (made.is_err()) { return made; } let transformed: Matrix = made.unwrap(); let values: [f64] = transformed.data.as_slice();
        let solved: core::result::Result<i32,Error> = upper_solve(a,values,b.cols,a.cols); if (solved.is_err()) { transformed.destroy(); return core::result::Err(solved.unwrap_err()); }
        let top: MatrixView = transformed.view(); top.rows = a.cols; let result: core::result::Result<Matrix,Error> = from_view(top,limits); transformed.destroy(); return result;
    }
}
pub fn least_squares(a: MatrixView,b: MatrixView,tolerance: f64,limits: Limits) -> core::result::Result<Matrix,Error> {
    if (a.rows != b.rows) { return core::result::Err(Error::Shape); }
    // Upper bound includes QR, application, back substitution and copies.
    let columns: u64 = (a.cols as u64)+(b.cols as u64)+1;
    if (a.rows >= 0 && a.cols >= 0 && b.cols >= 0 && !work(8*(a.rows as u64),columns,(a.cols as u64)+1,limits)) { return core::result::Err(Error::WorkLimit); }
    let made: core::result::Result<Qr,Error> = qr(a,tolerance,limits); if (made.is_err()) { return core::result::Err(made.unwrap_err()); } let factor: Qr = made.unwrap(); let result: core::result::Result<Matrix,Error> = factor.least_squares(b,limits); factor.destroy(); return result;
}
