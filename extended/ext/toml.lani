    fn digits(&self, base: i32) -> bool {
        let start: i32 = self.position; let previous: bool = false;
        while (self.position < self.input.byte_len()) { let b: u8 = self.byte(); let d: i32 = hex(b);
            if (d >= 0 && d < base) { previous = true; if (!self.advance()) { return false; } }
            else { if (b == 95) { if (!previous) { return self.fail(ErrorKind::InvalidNumber,self.position); } previous = false; if (!self.advance()) { return false; } } else { break; } }
        }
        if (self.position == start || !previous) { return self.fail(ErrorKind::InvalidNumber,self.position); } return true;
    }
    fn number(&self) -> core::result::Result<Node,Error> {
        let start: i32 = self.position; let negative: bool = false; let signed: bool = false; let base: i32 = 10; let is_float: bool = false;
        if (self.byte() == 43 || self.byte() == 45) { signed = true; negative = self.byte() == 45; if (!self.advance()) { return core::result::Err(self.failure); } }
        let first_digit: i32 = self.position; let bytes: [u8] = self.input.as_bytes(); let length: i32 = self.input.byte_len();
        if (self.position+2 < length && ((bytes[self.position] == 105 && bytes[self.position+1] == 110 && bytes[self.position+2] == 102) || (bytes[self.position] == 110 && bytes[self.position+1] == 97 && bytes[self.position+2] == 110))) {
