fn hex_digit(v: u32) -> u32 { if (v < 10) { return 48+v; } return 87+v; }
pub fn measure(document: Document) -> core::result::Result<i32,Error> {
    let encoder: Encoder = Encoder { output: alloc::string::new(), count: 0, maximum: document.options.max_output_bytes, work: document.options.max_work, measuring: true, failure: error(ErrorKind::AllocationFailed,-1) };
    if (!encoder.run(document)) { return core::result::Err(encoder.failure); } return core::result::Ok(encoder.count);
}
pub fn encode(document: Document) -> core::result::Result<alloc::string::String,Error> {
    let encoder: Encoder = Encoder { output: alloc::string::new(), count: 0, maximum: document.options.max_output_bytes, work: document.options.max_work, measuring: false, failure: error(ErrorKind::AllocationFailed,-1) };
    if (!encoder.run(document)) { encoder.output.destroy(); return core::result::Err(encoder.failure); } return core::result::Ok(encoder.output);
}
// Every error precedes the first write, including allocation failure.
pub fn encode_into(document: Document, output: core::slice::View<u8>) -> core::result::Result<i32,Error> {
    if (output.start < 0 || output.length < 0 || output.start > 2147483647-output.length) { return core::result::Err(error(ErrorKind::Bounds,-1)); }
    let probe: Encoder = Encoder { output: alloc::string::new(), count: 0, maximum: document.options.max_output_bytes, work: document.options.max_work, measuring: true, failure: error(ErrorKind::AllocationFailed,-1) };
    if (!probe.run(document)) { return core::result::Err(probe.failure); } let size: i32 = probe.count;
