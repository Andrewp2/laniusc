                if (multiline && (horizontal(self.byte()) || self.byte() == 10 || self.byte() == 13)) {
                    if (!self.hspace() || !self.newline()) { break; } let ok: bool = true;
                    while (self.position < length) { if (horizontal(self.byte())) { if (!self.advance()) { ok = false; break; } } else { if (self.byte() == 10 || self.byte() == 13) { if (!self.newline()) { ok = false; break; } } else { break; } } }
                    if (!ok) { break; } continue;
                }
                let escaped: u8 = self.byte(); if (!self.advance()) { break; } scalar = 4294967295;
                if (escaped == 34 || escaped == 92) { scalar = escaped as u32; } if (escaped == 98) { scalar = 8; } if (escaped == 116) { scalar = 9; } if (escaped == 110) { scalar = 10; } if (escaped == 102) { scalar = 12; } if (escaped == 114) { scalar = 13; } if (escaped == 101) { scalar = 27; }
                let count: i32 = 0; if (escaped == 120) { count = 2; } if (escaped == 117) { count = 4; } if (escaped == 85) { count = 8; }
                if (count > 0) { scalar = 0; let i: i32 = 0; while (i < count) { if (self.position >= length) { self.fail(ErrorKind::UnexpectedEnd,self.position); break; } let d: i32 = hex(self.byte()); if (d < 0) { self.fail(ErrorKind::InvalidEscape,self.position); break; } scalar = scalar*16+(d as u32); if (!self.advance()) { break; } i += 1; } if (i != count) { break; } }
                if (scalar == 4294967295 || !core::utf8::is_scalar(scalar)) { self.fail(ErrorKind::InvalidEscape,self.position); break; }
            } else { scalar = core::option::unwrap_or(self.input.scalar_at_byte(self.position),4294967295); let width: i32 = core::utf8::encoded_len_or(scalar,0) as i32; if (width == 0) { self.fail(ErrorKind::InvalidUtf8,self.position); break; } if (!self.pay(width as u64)) { break; } self.position += width; }
