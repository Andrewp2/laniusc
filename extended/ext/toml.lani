fn temporal_parts(text: core::text::Text) -> Temporal {
    let date: core::option::Option<core::calendar::Date> = core::option::None();
    let time: core::option::Option<core::calendar::TimeOfDay> = core::option::None();
    let offset: core::option::Option<core::calendar::UtcOffset> = core::option::None();
