    let copied: core::result::Result<alloc::string::String,alloc::string::Error> = alloc::string::from_text(core::result::unwrap(validated));
    if (core::result::is_err(copied)) { let e: ErrorKind = match (core::result::unwrap_err(copied)) { alloc::string::Error::InvalidUtf8(at) -> ErrorKind::InvalidUtf8, _ -> ErrorKind::AllocationFailed }; return core::result::Err(error(e,0)); }
    let nodes: alloc::vec::Vec<Node> = alloc::vec::new(); let frames: alloc::vec::Vec<Frame> = alloc::vec::new(); let document: Document = Document { nodes: nodes, options: options };
    let parser: Parser = Parser { input: core::result::unwrap(copied), document: document, frames: frames, position: 0, failure: error(ErrorKind::UnexpectedEnd,0), work: options.max_work-(input.byte_len() as u64) };
    let success: bool = parser.run(); parser.frames.destroy(); parser.input.destroy(); if (!success) { parser.document.destroy(); return core::result::Err(parser.failure); } return core::result::Ok(parser.document);
}
pub fn parse(input: alloc::string::String, options: Options) -> core::result::Result<Document,Error> { return parse_text(input.as_text(),options); }

