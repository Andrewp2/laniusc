// TOML 1.1.0 owned documents. See docs/extended-toml.md.
module ext::toml;
import alloc::string;
import alloc::vec;
import core::result;
import core::option;
import core::text;
import core::utf8;
import core::slice;
import core::f64;
import core::float_decimal;
import core::calendar;
import core::mem;

pub type NodeId = i32;
pub enum Kind { Table, Array, String, Integer, Float, Boolean, OffsetDateTime, LocalDateTime, LocalDate, LocalTime }
pub enum ErrorKind {
    UnexpectedEnd, UnexpectedByte, InvalidUtf8, InvalidEscape, InvalidNumber,
    InvalidDateTime, NumberOutOfRange, DuplicateKey, TableRedefinition,
    InputLimit, NodeLimit, DepthLimit, StringLimit, NumberLimit, OutputLimit,
    WorkLimit, AllocationFailed, InvalidOptions, Bounds, WrongKind,
}
pub struct Error { kind: ErrorKind, offset: i32 }
pub struct Options {
    max_input_bytes: i32, max_nodes: i32, max_depth: i32, max_string_bytes: i32,
    max_number_bytes: i32, max_output_bytes: i32, max_work: u64,
}
pub fn default_options() -> Options {
    return Options { max_input_bytes: 16777216, max_nodes: 1000000, max_depth: 128,
        max_string_bytes: 16777216, max_number_bytes: 1024, max_output_bytes: 67108864, max_work: 1000000000 };
}
fn error(kind: ErrorKind, offset: i32) -> Error { return Error { kind: kind, offset: offset }; }
fn literal(value: str, count: i32) -> core::text::Text { let bytes: [u8] = core::mem::typed_slice_from_raw_parts<u8>(core::mem::string_data_ptr(value),count); return core::text::from_utf8_unchecked(bytes,0,count); }
pub fn error_kind_text(value: ErrorKind) -> core::text::Text { return match (value) {
    UnexpectedEnd -> literal("unexpected end",14),
    UnexpectedByte -> literal("unexpected byte",15),
    InvalidUtf8 -> literal("invalid utf-8",13),
    InvalidEscape -> literal("invalid escape",14),
    InvalidNumber -> literal("invalid number",14),
    InvalidDateTime -> literal("invalid date/time",17),
    NumberOutOfRange -> literal("number out of range",19),
    DuplicateKey -> literal("duplicate key",13),
    TableRedefinition -> literal("table redefinition",18),
    InputLimit -> literal("input limit",11),
    NodeLimit -> literal("node limit",10),
    DepthLimit -> literal("depth limit",11),
    StringLimit -> literal("string limit",12),
    NumberLimit -> literal("number limit",12),
    OutputLimit -> literal("output limit",12),
    WorkLimit -> literal("work limit",10),
    AllocationFailed -> literal("allocation failed",17),
    InvalidOptions -> literal("invalid options",15),
    Bounds -> literal("bounds",6),
    WrongKind -> literal("wrong kind",10),
}; }
fn tag(kind: Kind) -> i32 { return match (kind) { Table -> 0, Array -> 1, String -> 2, Integer -> 3, Float -> 4, Boolean -> 5, OffsetDateTime -> 6, LocalDateTime -> 7, LocalDate -> 8, LocalTime -> 9 }; }
fn valid_options(o: Options) -> bool { return o.max_input_bytes >= 0 && o.max_nodes >= 0 && o.max_depth >= 0 && o.max_string_bytes >= 0 && o.max_number_bytes >= 0 && o.max_output_bytes >= 0; }
struct Node {
    kind: Kind, key: alloc::string::String, text: alloc::string::String,
    integer: i64, floating: f64, flag: bool, parent: NodeId, first: NodeId,
    last: NodeId, next: NodeId, count: i32, depth: i32, state: i32, context: NodeId,
}
pub struct Temporal {
    date: core::option::Option<core::calendar::Date>,
    time: core::option::Option<core::calendar::TimeOfDay>,
    offset: core::option::Option<core::calendar::UtcOffset>,
    fraction: core::text::Text,
}
pub struct Document { nodes: alloc::vec::Vec<Node>, options: Options }
pub impl Document {
    pub fn borrow(&self) -> &Document { return self; }
    fn valid(&self, id: NodeId) -> bool { return id >= 0 && id < self.nodes.len(); }
    fn node(&self, id: NodeId) -> Node { let values: [Node] = self.nodes.as_slice(); return values[id]; }
    fn put(&self, id: NodeId, node: Node) { let values: [Node] = self.nodes.as_slice(); values[id] = node; }
    pub fn node_count(&self) -> i32 { return self.nodes.len(); }
    pub fn root(&self) -> core::option::Option<NodeId> { if (self.nodes.is_empty()) { return core::option::None(); } return core::option::Some(0); }
    pub fn kind(&self, id: NodeId) -> core::result::Result<Kind,Error> { if (!self.valid(id)) { return core::result::Err(error(ErrorKind::Bounds,-1)); } return core::result::Ok(self.node(id).kind); }
    pub fn child_count(&self, id: NodeId) -> core::result::Result<i32,Error> { if (!self.valid(id)) { return core::result::Err(error(ErrorKind::Bounds,-1)); } let n: Node = self.node(id); if (tag(n.kind) > 1) { return core::result::Err(error(ErrorKind::WrongKind,-1)); } return core::result::Ok(n.count); }
    pub fn first_child(&self, id: NodeId) -> core::result::Result<core::option::Option<NodeId>,Error> {
        let checked: core::result::Result<i32,Error> = self.child_count(id); if (core::result::is_err(checked)) { return core::result::Err(core::result::unwrap_err(checked)); }
        let n: Node = self.node(id); if (n.first < 0) { return core::result::Ok(core::option::None()); } return core::result::Ok(core::option::Some(n.first));
    }
    pub fn next_sibling(&self, id: NodeId) -> core::result::Result<core::option::Option<NodeId>,Error> { if (!self.valid(id)) { return core::result::Err(error(ErrorKind::Bounds,-1)); } let n: Node = self.node(id); if (n.next < 0) { return core::result::Ok(core::option::None()); } return core::result::Ok(core::option::Some(n.next)); }
    pub fn element(&self, id: NodeId, index: i32) -> core::result::Result<core::option::Option<NodeId>,Error> {
        if (!self.valid(id) || index < 0) { return core::result::Err(error(ErrorKind::Bounds,-1)); } let n: Node = self.node(id); if (tag(n.kind) != 1) { return core::result::Err(error(ErrorKind::WrongKind,-1)); }
        let child: NodeId = n.first; let i: i32 = 0; while (i < index && child >= 0) { child = self.node(child).next; i += 1; } if (child < 0) { return core::result::Ok(core::option::None()); } return core::result::Ok(core::option::Some(child));
    }
    pub fn member(&self, id: NodeId, key: alloc::string::String) -> core::result::Result<core::option::Option<NodeId>,Error> { return self.member_text(id,key.as_text()); }
    pub fn member_text(&self, id: NodeId, key: core::text::Text) -> core::result::Result<core::option::Option<NodeId>,Error> {
        if (key.start < 0 || key.length < 0 || key.start > 2147483647-key.length) { return core::result::Err(error(ErrorKind::Bounds,-1)); }
        if (!self.valid(id)) { return core::result::Err(error(ErrorKind::Bounds,-1)); } let n: Node = self.node(id); if (tag(n.kind) != 0) { return core::result::Err(error(ErrorKind::WrongKind,-1)); }
        let child: NodeId = n.first; while (child >= 0) { let c: Node = self.node(child); let name: core::text::Text = c.key.as_text(); if (name.equals(key)) { return core::result::Ok(core::option::Some(child)); } child = c.next; } return core::result::Ok(core::option::None());
    }
    pub fn key_view(&self, id: NodeId) -> core::result::Result<core::text::Text,Error> {
        if (!self.valid(id)) { return core::result::Err(error(ErrorKind::Bounds,-1)); } let n: Node = self.node(id); if (n.parent < 0 || tag(self.node(n.parent).kind) != 0) { return core::result::Err(error(ErrorKind::WrongKind,-1)); } return core::result::Ok(n.key.as_text());
    }
    fn view(&self, id: NodeId, mode: i32) -> core::result::Result<core::text::Text,Error> {
        if (!self.valid(id)) { return core::result::Err(error(ErrorKind::Bounds,-1)); } let n: Node = self.node(id); let k: i32 = tag(n.kind);
        if ((mode == 0 && k != 2) || (mode == 1 && k != 3 && k != 4) || (mode == 2 && k < 6)) { return core::result::Err(error(ErrorKind::WrongKind,-1)); } return core::result::Ok(n.text.as_text());
    }
    pub fn string_view(&self, id: NodeId) -> core::result::Result<core::text::Text,Error> { return self.view(id,0); }
    pub fn number_view(&self, id: NodeId) -> core::result::Result<core::text::Text,Error> { return self.view(id,1); }
    pub fn temporal_view(&self, id: NodeId) -> core::result::Result<core::text::Text,Error> { return self.view(id,2); }
    // Calendar nanoseconds truncate after nine digits; fraction retains every digit.
    pub fn temporal(&self, id: NodeId) -> core::result::Result<Temporal,Error> {
        let viewed: core::result::Result<core::text::Text,Error> = self.temporal_view(id); if (core::result::is_err(viewed)) { return core::result::Err(core::result::unwrap_err(viewed)); }
        return core::result::Ok(temporal_parts(core::result::unwrap(viewed)));
    }
    pub fn integer_i64(&self, id: NodeId) -> core::result::Result<i64,Error> { if (!self.valid(id)) { return core::result::Err(error(ErrorKind::Bounds,-1)); } let n: Node = self.node(id); if (tag(n.kind) != 3) { return core::result::Err(error(ErrorKind::WrongKind,-1)); } return core::result::Ok(n.integer); }
    pub fn float64(&self, id: NodeId) -> core::result::Result<f64,Error> { if (!self.valid(id)) { return core::result::Err(error(ErrorKind::Bounds,-1)); } let n: Node = self.node(id); if (tag(n.kind) != 4) { return core::result::Err(error(ErrorKind::WrongKind,-1)); } return core::result::Ok(n.floating); }
    pub fn boolean(&self, id: NodeId) -> core::result::Result<bool,Error> { if (!self.valid(id)) { return core::result::Err(error(ErrorKind::Bounds,-1)); } let n: Node = self.node(id); if (tag(n.kind) != 5) { return core::result::Err(error(ErrorKind::WrongKind,-1)); } return core::result::Ok(n.flag); }
    fn copied(&self, id: NodeId, mode: i32) -> core::result::Result<alloc::string::String,Error> {
        let viewed: core::result::Result<core::text::Text,Error> = self.view(id,mode); if (core::result::is_err(viewed)) { return core::result::Err(core::result::unwrap_err(viewed)); }
        let made: core::result::Result<alloc::string::String,alloc::string::Error> = alloc::string::from_text(core::result::unwrap(viewed)); if (core::result::is_err(made)) { return core::result::Err(error(ErrorKind::AllocationFailed,-1)); } return core::result::Ok(core::result::unwrap(made));
    }
    pub fn copy_string(&self, id: NodeId) -> core::result::Result<alloc::string::String,Error> { return self.copied(id,0); }
    pub fn copy_number(&self, id: NodeId) -> core::result::Result<alloc::string::String,Error> { return self.copied(id,1); }
    pub fn copy_temporal(&self, id: NodeId) -> core::result::Result<alloc::string::String,Error> { return self.copied(id,2); }
    pub fn copy_key(&self, id: NodeId) -> core::result::Result<alloc::string::String,Error> {
        let viewed: core::result::Result<core::text::Text,Error> = self.key_view(id); if (core::result::is_err(viewed)) { return core::result::Err(core::result::unwrap_err(viewed)); }
        let made: core::result::Result<alloc::string::String,alloc::string::Error> = alloc::string::from_text(core::result::unwrap(viewed)); if (core::result::is_err(made)) { return core::result::Err(error(ErrorKind::AllocationFailed,-1)); } return core::result::Ok(core::result::unwrap(made));
    }
    pub fn destroy(&self) { let i: i32 = 0; while (i < self.nodes.len()) { let n: Node = self.node(i); n.key.destroy(); n.text.destroy(); i += 1; } self.nodes.destroy(); self.nodes = alloc::vec::new(); }
}

fn digit(b: u8) -> bool { return b >= 48 && b <= 57; }
fn bare(b: u8) -> bool { return digit(b) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 45 || b == 95; }
fn hex(b: u8) -> i32 { if (digit(b)) { return (b-48) as i32; } if (b >= 65 && b <= 70) { return (b-55) as i32; } if (b >= 97 && b <= 102) { return (b-87) as i32; } return -1; }
fn horizontal(b: u8) -> bool { return b == 32 || b == 9; }
fn delim(b: u8) -> bool { return horizontal(b) || b == 10 || b == 13 || b == 35 || b == 44 || b == 93 || b == 125; }
struct Buffer { value: alloc::string::String }
impl Buffer { fn borrow(&self) -> &Buffer { return self; } }
struct Frame { node: NodeId, phase: i32 }
struct Target { parent: NodeId, key: alloc::string::String }
struct Parser { input: alloc::string::String, document: Document, frames: alloc::vec::Vec<Frame>, position: i32, failure: Error, work: u64 }
impl Parser {
    fn fail(&self, kind: ErrorKind, offset: i32) -> bool { self.failure = error(kind,offset); return false; }
    fn pay(&self, amount: u64) -> bool { if (amount > self.work) { return self.fail(ErrorKind::WorkLimit,self.position); } self.work -= amount; return true; }
    fn byte(&self) -> u8 { if (self.position >= self.input.byte_len()) { return 0; } let b: [u8] = self.input.as_bytes(); return b[self.position]; }
    fn advance(&self) -> bool { if (!self.pay(1)) { return false; } self.position += 1; return true; }
    fn hspace(&self) -> bool { while (self.position < self.input.byte_len() && horizontal(self.byte())) { if (!self.advance()) { return false; } } return true; }
    fn newline(&self) -> bool {
        if (self.byte() == 13) { if (!self.advance()) { return false; } if (self.position >= self.input.byte_len() || self.byte() != 10) { return self.fail(ErrorKind::UnexpectedByte,self.position); } }
        if (self.position >= self.input.byte_len() || self.byte() != 10) { return self.fail(ErrorKind::UnexpectedByte,self.position); } return self.advance();
    }
    fn comment(&self) -> bool {
        while (self.position < self.input.byte_len() && self.byte() != 10 && self.byte() != 13) { let b: u8 = self.byte(); if ((b < 32 && b != 9) || b == 127) { return self.fail(ErrorKind::UnexpectedByte,self.position); } if (!self.advance()) { return false; } } return true;
    }
    fn trivia(&self) -> bool {
        while (self.position < self.input.byte_len()) { if (!self.hspace()) { return false; } if (self.position >= self.input.byte_len()) { break; } if (self.byte() == 35) { if (!self.comment()) { return false; } } if (self.position < self.input.byte_len() && (self.byte() == 10 || self.byte() == 13)) { if (!self.newline()) { return false; } } else { break; } } return true;
    }
    fn push_scalar(&self, text: &Buffer, scalar: u32) -> bool {
        let width: i32 = core::utf8::encoded_len_or(scalar,0) as i32; if (width == 0) { return self.fail(ErrorKind::InvalidEscape,self.position); }
        if (width > self.document.options.max_string_bytes-text.value.byte_len()) { return self.fail(ErrorKind::StringLimit,self.position); }
        if (core::result::is_err(text.value.try_push_scalar(scalar))) { return self.fail(ErrorKind::AllocationFailed,self.position); } return true;
    }
    fn quoted(&self, key: bool) -> core::result::Result<alloc::string::String,Error> {
        self.failure = error(ErrorKind::UnexpectedEnd,self.input.byte_len());
        let text: Buffer = Buffer { value: alloc::string::new() }; let quote: u8 = self.byte(); let bytes: [u8] = self.input.as_bytes(); let length: i32 = self.input.byte_len(); let multiline: bool = false;
        if (!self.advance()) { return core::result::Err(self.failure); }
        if (self.position+1 < length && bytes[self.position] == quote && bytes[self.position+1] == quote) { multiline = true; if (key) { self.fail(ErrorKind::UnexpectedByte,self.position); return core::result::Err(self.failure); } if (!self.pay(2)) { return core::result::Err(self.failure); } self.position += 2; if (self.position < length && (self.byte() == 10 || self.byte() == 13)) { if (!self.newline()) { return core::result::Err(self.failure); } } }
        let success: bool = false;
        while (self.position < length) {
            let b: u8 = self.byte();
            if (b == quote) {
                let count: i32 = 1; while (self.position+count < length && bytes[self.position+count] == quote && count < 6) { count += 1; }
                if (!multiline) { self.advance(); success = true; break; }
                if (count >= 3) { if (count > 5) { self.fail(ErrorKind::UnexpectedByte,self.position); break; } let i: i32 = 3; while (i < count) { if (!self.push_scalar(text.borrow(),quote as u32)) { break; } i += 1; } if (i != count || !self.pay(count as u64)) { break; } self.position += count; success = true; break; }
            }
            if (b == 10 || b == 13) { if (!multiline) { self.fail(ErrorKind::UnexpectedByte,self.position); break; } if (!self.newline() || !self.push_scalar(text.borrow(),10)) { break; } continue; }
