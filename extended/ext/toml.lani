            if (!self.advance() || !self.hspace()) { key.destroy(); return core::result::Err(self.failure); }
            let found: NodeId = self.find(parent,key); if (found == -2) { key.destroy(); return core::result::Err(self.failure); }
            if (found < 0) { let state: i32 = 2; if (header) { state = 0; } parent = self.insert(parent,key,Kind::Table,alloc::string::new(),state,base); if (parent < 0) { return core::result::Err(self.failure); } }
            else { key.destroy(); let n: Node = self.document.node(found);
