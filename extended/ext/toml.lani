    if (spent > probe.work || (size as u64) > probe.work-spent) { return core::result::Err(error(ErrorKind::WorkLimit,-1)); }
    let made: core::result::Result<alloc::string::String,Error> = encode(document); if (core::result::is_err(made)) { return core::result::Err(core::result::unwrap_err(made)); } let text: alloc::string::String = core::result::unwrap(made); let bytes: [u8] = text.as_bytes(); let i: i32 = 0; while (i < size) { output.values[output.start+i] = bytes[i]; i += 1; } text.destroy(); return core::result::Ok(size);
}
