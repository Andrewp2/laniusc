        if (self.byte() == 34 || self.byte() == 39) { return self.quoted(true); } let start: i32 = self.position;
        while (self.position < self.input.byte_len() && bare(self.byte())) { if (!self.advance()) { return core::result::Err(self.failure); } }
        if (start == self.position) { return core::result::Err(error(ErrorKind::UnexpectedByte,start)); } if (self.position-start > self.document.options.max_string_bytes) { return core::result::Err(error(ErrorKind::StringLimit,start)); }
        let made: core::result::Result<alloc::string::String,alloc::string::Error> = self.input.try_substring(start,self.position); if (core::result::is_err(made)) { return core::result::Err(error(ErrorKind::AllocationFailed,start)); } return core::result::Ok(core::result::unwrap(made));
    }
    // Consumes key/text, including on failure.
    fn insert(&self, parent: NodeId, key: alloc::string::String, kind: Kind, text: alloc::string::String, state: i32, context: NodeId) -> NodeId {
        if (!self.pay(1)) { key.destroy(); text.destroy(); return -1; } let depth: i32 = 0; if (parent >= 0) { depth = self.document.node(parent).depth+1; }
        if (depth > self.document.options.max_depth) { key.destroy(); text.destroy(); self.fail(ErrorKind::DepthLimit,self.position); return -1; }
        if (self.document.nodes.len() >= self.document.options.max_nodes) { key.destroy(); text.destroy(); self.fail(ErrorKind::NodeLimit,self.position); return -1; }
        let node: Node = Node { kind: kind, key: key, text: text, integer: 0, floating: 0.0, flag: false, parent: parent, first: -1, last: -1, next: -1, count: 0, depth: depth, state: state, context: context };
        let id: NodeId = self.document.nodes.len(); if (core::result::is_err(self.document.nodes.try_push(node))) { key.destroy(); text.destroy(); self.fail(ErrorKind::AllocationFailed,self.position); return -1; }
        if (parent >= 0) { let p: Node = self.document.node(parent); if (p.last < 0) { p.first = id; } else { let last: Node = self.document.node(p.last); last.next = id; self.document.put(p.last,last); } p.last = id; p.count += 1; self.document.put(parent,p); } return id;
    }
    fn find(&self, parent: NodeId, key: alloc::string::String) -> NodeId {
        let child: NodeId = self.document.node(parent).first; while (child >= 0) { let n: Node = self.document.node(child); if (!self.pay((n.key.byte_len() as u64)+1)) { return -2; } let name: core::text::Text = n.key.as_text(); if (name.equals(key.as_text())) { return child; } child = n.next; } return -1;
    }
    fn target(&self, base: NodeId, header: bool) -> core::result::Result<Target,Error> {
        let parent: NodeId = base;
        while (true) {
            let made: core::result::Result<alloc::string::String,Error> = self.simple_key(); if (core::result::is_err(made)) { return core::result::Err(core::result::unwrap_err(made)); } let key: alloc::string::String = core::result::unwrap(made);
            if (!self.hspace()) { key.destroy(); return core::result::Err(self.failure); }
