pub fn parse_text(input: core::text::Text, options: Options) -> core::result::Result<Document,Error> {
    if (!valid_options(options)) { return core::result::Err(error(ErrorKind::InvalidOptions,-1)); }
    if (input.start < 0 || input.length < 0 || input.start > 2147483647-input.length) { return core::result::Err(error(ErrorKind::Bounds,-1)); }
    if (input.byte_len() > options.max_input_bytes) { return core::result::Err(error(ErrorKind::InputLimit,0)); }
    if ((input.byte_len() as u64) > options.max_work) { return core::result::Err(error(ErrorKind::WorkLimit,0)); }
    let validated: core::result::Result<core::text::Text,core::text::Error> = core::text::from_utf8_range(input.bytes,input.start,input.length);
