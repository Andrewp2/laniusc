// TLS front end for ext::http_proxy: clients connect with TLS and ALPN
// picks the protocol ("h2" runs HTTP/2, anything else HTTP/1.1); upstreams
// stay plain HTTP/1.1. The proxy runs with wrapped clients and
// ext::tls_clients is their transport, on the proxy's nonblocking loop.
// Programs using it link OpenSSL (--native-link --native-library ssl
// --native-library crypto).
module ext::http_proxy_tls;
import core::net;
import core::option;
import core::result;
import core::slice;
import core::time;
import ext::client_transport;
import ext::http_proxy;
import ext::openssl_tls;
import ext::tls_clients;
import std::socket;

pub enum Error { Proxy(ext::http_proxy::Error), AllocationFailed, InvalidState }
pub struct TlsProxy { proxy: ext::http_proxy::Proxy, tls: ext::tls_clients::TlsClients, closed: bool }

// Like ext::http_proxy::proxy, with clients served over TLS by context,
// which the caller keeps (and destroys after close). Give it an ALPN list
// first (ext::tls_clients::alpn_protocols) for HTTP/2.
pub fn proxy(listener: &std::socket::Socket, options: ext::http_proxy::Options, max_clients: i32, context: ext::openssl_tls::ServerContext) -> core::result::Result<TlsProxy,Error> {
    if (!context.is_open()) { return core::result::Err(Error::InvalidState); }
    let made: core::result::Result<ext::http_proxy::Proxy,ext::http_proxy::Error> = ext::http_proxy::proxy(listener, options, max_clients);
    if (made.is_err()) { return core::result::Err(Error::Proxy(made.unwrap_err())); }
    let p: ext::http_proxy::Proxy = made.unwrap(); p.wrap_clients(true);
    let tls: core::option::Option<ext::tls_clients::TlsClients> = ext::tls_clients::clients(context, max_clients);
    if (tls.is_none()) { p.close(); return core::result::Err(Error::AllocationFailed); }
    return core::result::Ok(TlsProxy { proxy: p, tls: tls.unwrap(), closed: false });
}

pub impl TlsProxy {
    pub fn borrow(&self) -> &TlsProxy { return self; }
    pub fn stats(&self) -> ext::http_proxy::Stats { return self.proxy.stats(); }
    pub fn tls_stats(&self) -> ext::tls_clients::Stats { return self.tls.stats(); }
    pub fn active(&self) -> i32 { return self.proxy.active(); }
    pub fn add_upstream(&self, address: core::net::SocketAddr) -> core::result::Result<i32,ext::http_proxy::Error> { return self.proxy.add_upstream(address); }
    pub fn route(&self, prefix: core::slice::View<u8>, upstream: i32) -> core::result::Result<i32,ext::http_proxy::Error> { return self.proxy.route(prefix, upstream); }
    // One round of the proxy's loop, then the TLS work it reported.
    pub fn poll(&self, deadline: core::time::Deadline) -> core::result::Result<i32,Error> {
        if (self.closed) { return core::result::Err(Error::InvalidState); }
        let wake: core::time::Deadline = self.tls.wake(self.proxy.borrow(), deadline);
        let got: core::result::Result<i32,ext::http_proxy::Error> = self.proxy.poll(wake);
        if (got.is_err()) { return core::result::Err(Error::Proxy(got.unwrap_err())); }
        self.tls.serve(self.proxy.borrow());
        return core::result::Ok(got.unwrap());
    }
    // Free the sessions, then close the proxy (and with it the sockets).
    pub fn close(&self) -> core::result::Result<i32,Error> {
        if (self.closed) { return core::result::Ok(0); }
        self.closed = true; self.tls.close();
        let closed: core::result::Result<i32,ext::http_proxy::Error> = self.proxy.close();
        if (closed.is_err()) { return core::result::Err(Error::Proxy(closed.unwrap_err())); }
        return core::result::Ok(0);
    }
}
