// One resumable verified server Session over the shared HTTP Protocol.
// Manual owners, fresh readiness and explicit process SIGPIPE policy.
module ext::https_server;
import core::clone;
import core::io;
import core::mem;
import core::net;
import core::option;
import core::result;
import core::slice;
import core::time;
import ext::http_client;
import ext::http_server;
import ext::openssl_tls;
import std::socket;

pub struct Options { tls_calls: u64 }
pub struct TlsStats { calls: u64, handshakes: u64, reads: u64, writes: u64, shutdowns: u64 }
pub enum Stage { Configure, Attach, Handshake, Protocol, Read, Send, Shutdown, Drain, Close, Publish }
pub enum Cause { Http(ext::http_server::Failure), Tls(ext::openssl_tls::Error), Io(core::io::Error), InvalidOptions, TlsLimit, Inactive, InvalidEngine, PeerClosed }
pub struct Failure {
    cause: Cause, stage: Stage, stats: ext::http_server::Stats, tls: TlsStats,
    rejection: core::option::Option<ext::http_server::Rejection>,
    cleanup_attempted: bool, cleanup: core::option::Option<core::io::Error>
}
// Diagnostic values contain no live native handles or allocated owners.
pub impl core::clone::Destroy<Failure> for Failure { pub fn destroy_value(owned: Failure) {} }
enum Phase { Handshake, Protocol, Notify, Close }
pub struct Exchange {
    protocol: ext::http_server::Protocol, socket: std::socket::Socket,
    session: core::option::Option<ext::openssl_tls::Session>, remote: core::net::SocketAddr,
    options: Options, tls: TlsStats, stage: Stage, phase: Phase, current: ext::http_server::Status,
    maximum_io: i32, version: i32, read_amount: i32, write_amount: i32,
    read_blocked: bool, write_blocked: bool, send_turn: bool,
    wait_blocked: bool, wait_need: ext::openssl_tls::Need,
    notified: bool, peer_closed: bool, transport_closed: bool,
    close_attempted: bool, close_error: core::option::Option<core::io::Error>,
    published: u64, failure: core::option::Option<Failure>
}
pub fn default_options() -> Options { return Options { tls_calls: 1048576 }; }
fn zero_tls() -> TlsStats { return TlsStats { calls:0,handshakes:0,reads:0,writes:0,shutdowns:0 }; }
fn running(status: ext::http_server::Status) -> bool { return match(status) { ext::http_server::Status::Active -> true, _ -> false }; }
fn reads(need: ext::openssl_tls::Need) -> bool { return match(need) { ext::openssl_tls::Need::Read -> true, _ -> false }; }
fn writes(need: ext::openssl_tls::Need) -> bool { return match(need) { ext::openssl_tls::Need::Write -> true, _ -> false }; }
fn handshaking(exchange: &Exchange) -> bool { return match(exchange.phase) { Phase::Handshake -> true, _ -> false }; }
fn pending_read(exchange: &Exchange) -> i32 { if (exchange.session.is_none()) { return 0; } return exchange.session.unwrap().pending_read_bytes(); }
fn pending_write(exchange: &Exchange) -> i32 { if (exchange.session.is_none()) { return 0; } return exchange.session.unwrap().pending_write_bytes(); }
fn read_need(exchange: &Exchange) -> ext::openssl_tls::Need { if (exchange.session.is_none()) { return ext::openssl_tls::Need::None; } return exchange.session.unwrap().read_need(); }
fn write_need(exchange: &Exchange) -> ext::openssl_tls::Need { if (exchange.session.is_none()) { return ext::openssl_tls::Need::None; } return exchange.session.unwrap().write_need(); }
fn take_session(exchange: &Exchange) -> ext::openssl_tls::Session { let held: ext::openssl_tls::Session = exchange.session.unwrap(); exchange.session = core::option::None(); return held; }
fn release_session(exchange: &Exchange) {
    let held: core::option::Option<ext::openssl_tls::Session> = exchange.session; exchange.session = core::option::None();
    if (held.is_some()) { let owner: ext::openssl_tls::Session = held.unwrap(); owner.destroy(); }
}
fn metadata(exchange: &Exchange, cause: Cause) -> Failure {
    let cleanup: core::option::Option<core::io::Error> = match(cause) { Cause::Http(error) -> error.cleanup, _ -> exchange.close_error };
    return Failure { cause:cause,stage:exchange.stage,stats:exchange.protocol.stats(),tls:exchange.tls,
        rejection:exchange.protocol.rejection(),cleanup_attempted:exchange.close_attempted,cleanup:cleanup };
}
fn local_state(exchange: &Exchange) -> Failure {
    let error: ext::http_server::Failure = ext::http_server::Failure {
        cause:ext::http_server::Cause::InvalidState,stage:exchange.protocol.stage(),stats:exchange.protocol.stats(),
        cleanup_attempted:false,cleanup:core::option::None(),rejection:exchange.protocol.rejection()
    };
    return metadata(exchange,Cause::Http(error));
}
// Exactly one close/record pair per transport, including failed/aborted owners.
fn close_transport(exchange: &Exchange) -> core::result::Result<bool,Cause> {
    if (exchange.transport_closed) { return core::result::Ok(false); }
    let had_terminal: bool = exchange.protocol.last_terminal_failure().is_some();
    exchange.transport_closed = true; release_session(exchange);
    exchange.close_attempted = exchange.socket.is_open();
    let closed: core::result::Result<i32,core::io::Error> = exchange.socket.close();
    if (closed.is_err()) { exchange.close_error = core::option::Some(closed.unwrap_err()); }
    let recorded: core::result::Result<bool,ext::http_server::Failure> = exchange.protocol.record_close(exchange.close_attempted,exchange.close_error);
    // A cached fatal is refreshed by record_close, not a second cleanup error.
    // A new actual close error stays distinct from that earlier primary.
    if (recorded.is_err() && !had_terminal) { return core::result::Err(Cause::Http(recorded.unwrap_err())); }
    if (closed.is_err()) { return core::result::Err(Cause::Io(closed.unwrap_err())); }
    return core::result::Ok(true);
}
fn stop(exchange: &Exchange, cause: Cause) -> Failure {
    if (exchange.failure.is_some()) { return exchange.failure.unwrap(); }
    let had_terminal: bool = exchange.protocol.last_terminal_failure().is_some();
    exchange.protocol.abort(); close_transport(exchange);
    let actual: Cause = cause;
    let http: core::option::Option<ext::http_server::Failure> = match(cause) { Cause::Http(error) -> core::option::Some(error), _ -> core::option::None() };
    if (http.is_some()) {
        let error: ext::http_server::Failure = http.unwrap();
        if (had_terminal && exchange.protocol.last_terminal_failure().is_some()) { error = exchange.protocol.last_terminal_failure().unwrap(); }
        else { error.stats = exchange.protocol.stats(); error.cleanup_attempted = exchange.close_attempted; error.cleanup = exchange.close_error; }
        actual = Cause::Http(error);
    }
    let error: Failure = metadata(exchange,actual);
    exchange.current = ext::http_server::Status::Failed; exchange.failure = core::option::Some(error); return error;
}
fn checked(exchange: &Exchange) -> core::result::Result<bool,Cause> {
    let result: core::result::Result<bool,ext::http_server::Failure> = exchange.protocol.check();
    if (result.is_err()) { return core::result::Err(Cause::Http(result.unwrap_err())); } return core::result::Ok(true);
}
fn before_tls(exchange: &Exchange, stage: ext::http_server::Stage, operation: i32) -> core::result::Result<bool,Cause> {
    if (exchange.tls.calls == exchange.options.tls_calls) { return core::result::Err(Cause::TlsLimit); }
    let before: core::result::Result<bool,ext::http_server::Failure> = exchange.protocol.before_io(stage);
    if (before.is_err()) { return core::result::Err(Cause::Http(before.unwrap_err())); }
    exchange.tls.calls += 1;
    if (operation == 1) { exchange.tls.handshakes += 1; }
    if (operation == 2) { exchange.tls.reads += 1; }
    if (operation == 3) { exchange.tls.writes += 1; }
    if (operation == 4) { exchange.tls.shutdowns += 1; } return core::result::Ok(true);
}
fn failed_protocol_construction(socket: &std::socket::Socket, error: ext::http_server::Failure) -> Failure {
    let attempted: bool = socket.is_open(); let closed: core::result::Result<i32,core::io::Error> = socket.close();
    if (attempted) { error.stats.cleanup_calls += 1; } error.stats.closed = true; error.cleanup_attempted = attempted;
    if (closed.is_err()) { error.stats.cleanup_errors += 1; error.cleanup = core::option::Some(closed.unwrap_err()); }
    return Failure { cause:Cause::Http(error),stage:Stage::Configure,stats:error.stats,tls:zero_tls(),
        rejection:error.rejection,cleanup_attempted:attempted,cleanup:error.cleanup };
}
// Consumes socket even on Err. Context is borrowed only through eager attach.
// Caller supplied descriptor must be connected TCP and process SIGPIPE configured.
pub fn begin_connected(socket: std::socket::Socket, peer: core::net::SocketAddr, context: &ext::openssl_tls::ServerContext, http_options: ext::http_server::Options, tls_options: Options, deadline: core::time::Deadline) -> core::result::Result<Exchange,Failure> {
    let made: core::result::Result<ext::http_server::Protocol,ext::http_server::Failure> = ext::http_server::protocol(http_options,deadline);
    if (made.is_err()) { return core::result::Err(failed_protocol_construction(socket.borrow(),made.unwrap_err())); }
    let owner: Exchange = Exchange { protocol:made.unwrap(),socket:socket,session:core::option::None(),remote:peer,options:tls_options,tls:zero_tls(),stage:Stage::Configure,phase:Phase::Handshake,current:ext::http_server::Status::Active,
        maximum_io:context.io_bytes(),version:0,read_amount:0,write_amount:0,read_blocked:false,write_blocked:false,send_turn:true,
        wait_blocked:false,wait_need:ext::openssl_tls::Need::None,notified:false,peer_closed:false,transport_closed:false,
        close_attempted:false,close_error:core::option::None(),published:0,failure:core::option::None() };
    if (tls_options.tls_calls == 0 || !owner.socket.is_open() || match(owner.socket.kind()) { std::socket::Kind::Udp -> true, _ -> false }) {
        let error: Failure = stop(owner.borrow(),Cause::InvalidOptions); owner.protocol.destroy(); return core::result::Err(error);
    }
    let charged: core::result::Result<bool,ext::http_server::Failure> = owner.protocol.before_io(ext::http_server::Stage::Accept);
    if (charged.is_err()) { let error: Failure = stop(owner.borrow(),Cause::Http(charged.unwrap_err())); owner.protocol.destroy(); return core::result::Err(error); }
    let flag: core::result::Result<bool,core::io::Error> = owner.socket.is_nonblocking();
    if (flag.is_err()) { let error: Failure = stop(owner.borrow(),Cause::Io(flag.unwrap_err())); owner.protocol.destroy(); return core::result::Err(error); }
    let observed = checked(owner.borrow());
    if (observed.is_err()) { let error: Failure = stop(owner.borrow(),observed.unwrap_err()); owner.protocol.destroy(); return core::result::Err(error); }
    if (!flag.unwrap()) { let error: Failure = stop(owner.borrow(),Cause::InvalidOptions); owner.protocol.destroy(); return core::result::Err(error); }
    owner.stage = Stage::Attach;
    let attached: core::result::Result<ext::openssl_tls::Session,ext::openssl_tls::Error> = context.session(owner.socket.raw_handle().unwrap());
    if (attached.is_err()) { let error: Failure = stop(owner.borrow(),Cause::Tls(attached.unwrap_err())); owner.protocol.destroy(); return core::result::Err(error); }
    owner.session = core::option::Some(attached.unwrap());
    let after = checked(owner.borrow()); if (after.is_err()) { let error: Failure = stop(owner.borrow(),after.unwrap_err()); owner.protocol.destroy(); return core::result::Err(error); }
    return core::result::Ok(owner);
}
fn wake(exchange: &Exchange, ready: ext::http_client::Readiness) {
    let all: bool = ready.error || ready.hangup;
    if (all || (ready.readable && !writes(exchange.wait_need)) || (ready.writable && writes(exchange.wait_need))) { exchange.wait_blocked = false; }
    if (all || (ready.readable && !writes(read_need(exchange))) || (ready.writable && writes(read_need(exchange)))) { exchange.read_blocked = false; }
    let pending: bool = pending_write(exchange) != 0;
    if (all || (ready.readable && pending && reads(write_need(exchange))) || (ready.writable && (!pending || writes(write_need(exchange))))) { exchange.write_blocked = false; }
}
// Select input vs discard before the native read. A WANT retains its size.
fn tls_read(exchange: &Exchange, discard: bool) -> core::result::Result<bool,Cause> {
    exchange.stage = Stage::Read; let stage: ext::http_server::Stage = ext::http_server::Stage::Head;
    if (discard) { exchange.stage = Stage::Drain; stage = ext::http_server::Stage::Drain; }
    else { stage = exchange.protocol.stage(); }
    let amount: i32 = exchange.read_amount;
    if (amount == 0) {
        let allowed: core::result::Result<i32,ext::http_server::Failure> = core::result::Ok(0);
        if (discard) { allowed = exchange.protocol.drain_limit(); } else { allowed = exchange.protocol.receive_limit(); }
        if (allowed.is_err()) { return core::result::Err(Cause::Http(allowed.unwrap_err())); }
        amount = allowed.unwrap(); if (amount > exchange.maximum_io) { amount = exchange.maximum_io; } exchange.read_amount = amount;
    }
    let before = before_tls(exchange,stage,2); if (before.is_err()) { return before; }
    let storage: [i32;256] = [0;256]; let scratch: [u8] = core::mem::typed_slice_from_raw_parts<u8>(core::mem::i32_array_data_ptr(storage),1024);
    let session: ext::openssl_tls::Session = take_session(exchange);
    let read: core::result::Result<ext::openssl_tls::Read,ext::openssl_tls::Error> = session.read_into(core::slice::view<u8>(scratch,amount).unwrap()); exchange.session = core::option::Some(session);
    if (read.is_err()) { return core::result::Err(Cause::Tls(read.unwrap_err())); }
    let event: ext::openssl_tls::Read = read.unwrap();
    let count: i32 = match(event) { ext::openssl_tls::Read::Data(value) -> value, ext::openssl_tls::Read::Closed -> 0, _ -> -1 };
    if (count >= 0) {
        exchange.read_amount = 0;
        if (count > amount || (count == 0 && match(event) { ext::openssl_tls::Read::Data(value) -> true, _ -> false })) { return core::result::Err(Cause::InvalidEngine); }
        let fed: core::result::Result<bool,ext::http_server::Failure> = core::result::Ok(true);
        if (discard) { fed = exchange.protocol.discard(count); }
        else { if (count == 0) { fed = exchange.protocol.feed_eof(); } else { fed = exchange.protocol.feed(core::slice::view<u8>(scratch,count).unwrap()); } }
        if (count == 0) { exchange.peer_closed = true; }
        if (fed.is_err()) { return core::result::Err(Cause::Http(fed.unwrap_err())); }
        if (count == 0 && pending_write(exchange) != 0) { return core::result::Err(Cause::PeerClosed); }
        exchange.read_blocked = false; exchange.write_blocked = false; exchange.send_turn = true; return core::result::Ok(true);
    }
    exchange.read_blocked = true; exchange.send_turn = true; return checked(exchange);
}
fn native_write(session: &ext::openssl_tls::Session, input: core::option::Option<core::slice::View<u8>>, retry: bool) -> core::result::Result<ext::openssl_tls::Write,ext::openssl_tls::Error> {
    if (retry) { return session.retry_write(); } return session.write(input.unwrap());
}
fn tls_write(exchange: &Exchange) -> core::result::Result<bool,Cause> {
    exchange.stage = Stage::Send;
    let retry: bool = pending_write(exchange) != 0; let input: core::option::Option<core::slice::View<u8>> = core::option::None();
    if (!retry) {
        let staged: core::result::Result<core::option::Option<core::slice::View<u8>>,ext::http_server::Failure> = exchange.protocol.start_send();
        if (staged.is_err()) { return core::result::Err(Cause::Http(staged.unwrap_err())); }
        if (staged.unwrap().is_none()) { return core::result::Err(Cause::InvalidEngine); }
        let part: core::slice::View<u8> = staged.unwrap().unwrap(); let amount: i32 = part.length; if (amount > exchange.maximum_io) { amount = exchange.maximum_io; }
        input = core::option::Some(part.subview(0,amount).unwrap()); exchange.write_amount = amount;
    }
    let stage: ext::http_server::Stage = ext::http_server::Stage::Send;
    let interim: bool = match(exchange.protocol.need()) { ext::http_server::Need::Output(kind) -> match(kind) { ext::http_server::SendKind::Continue -> true, _ -> false }, _ -> false };
    if (interim) { stage = ext::http_server::Stage::Continue; }
    let before = before_tls(exchange,stage,3); if (before.is_err()) { return before; }
    let session: ext::openssl_tls::Session = take_session(exchange);
    let written: core::result::Result<ext::openssl_tls::Write,ext::openssl_tls::Error> = native_write(session.borrow(),input,retry);
    exchange.session = core::option::Some(session);
    if (written.is_err()) { return core::result::Err(Cause::Tls(written.unwrap_err())); }
    let count: i32 = match(written.unwrap()) { ext::openssl_tls::Write::Complete(value) -> value, _ -> -1 };
    if (count >= 0) {
        if (count == 0 || count > exchange.write_amount) { return core::result::Err(Cause::InvalidEngine); }
        exchange.write_amount = 0;
        let committed: core::result::Result<bool,ext::http_server::Failure> = exchange.protocol.commit_send(count);
        if (committed.is_err()) { return core::result::Err(Cause::Http(committed.unwrap_err())); }
        exchange.write_blocked = false; exchange.read_blocked = false; exchange.send_turn = false; return core::result::Ok(true);
    }
    exchange.write_blocked = true; exchange.send_turn = false;
    if (reads(write_need(exchange))) { exchange.read_blocked = false; } return checked(exchange);
}
fn output(exchange: &Exchange, final: bool) -> core::result::Result<bool,Cause> {
    if (pending_write(exchange) != 0 && writes(write_need(exchange))) {
        if (exchange.write_blocked) { return core::result::Ok(true); } return tls_write(exchange);
    }
    let can_write: bool = !exchange.write_blocked;
    let can_read: bool = final && !exchange.peer_closed && !exchange.read_blocked;
    if (can_read && (!can_write || !exchange.send_turn)) { return tls_read(exchange,true); }
    if (can_write) { return tls_write(exchange); }
    if (can_read) { return tls_read(exchange,true); } return core::result::Ok(true);
}
fn begin_notify(exchange: &Exchange) -> core::result::Result<bool,Cause> {
    if (pending_write(exchange) != 0) { return core::result::Err(Cause::InvalidEngine); }
    // Complete protocol output belonging to a pending read before shutdown.
    // The shared Protocol permits this bounded discard in Shutdown as well.
    if (pending_read(exchange) != 0 && writes(read_need(exchange))) {
        if (exchange.read_blocked) { return core::result::Ok(false); } return tls_read(exchange,true);
    }
    let session: ext::openssl_tls::Session = take_session(exchange);
    let quiet: core::result::Result<bool,ext::openssl_tls::Error> = session.quiesce_read(); exchange.session = core::option::Some(session);
    if (quiet.is_err()) { return core::result::Err(Cause::Tls(quiet.unwrap_err())); }
    exchange.read_amount = 0; exchange.wait_need = ext::openssl_tls::Need::None; exchange.wait_blocked = false; exchange.phase = Phase::Notify;
    return core::result::Ok(true);
}
fn handshake(exchange: &Exchange) -> core::result::Result<bool,Cause> {
    exchange.stage = Stage::Handshake;
    if (exchange.tls.calls == exchange.options.tls_calls) { return core::result::Err(Cause::TlsLimit); }
    if (exchange.wait_blocked) { return core::result::Ok(false); }
    let before = before_tls(exchange,ext::http_server::Stage::Head,1); if (before.is_err()) { return before; }
    let session: ext::openssl_tls::Session = take_session(exchange);
    let result: core::result::Result<ext::openssl_tls::Handshake,ext::openssl_tls::Error> = session.handshake(); exchange.session = core::option::Some(session);
    if (result.is_err()) { return core::result::Err(Cause::Tls(result.unwrap_err())); }
    if (match(result.unwrap()) { ext::openssl_tls::Handshake::Complete -> true, _ -> false }) {
        exchange.version = session.negotiated_version(); exchange.phase = Phase::Protocol;
        exchange.wait_need = ext::openssl_tls::Need::None; exchange.wait_blocked = false;
    } else {
        exchange.wait_need = ext::openssl_tls::Need::Write;
        if (match(result.unwrap()) { ext::openssl_tls::Handshake::WantRead -> true, _ -> false }) { exchange.wait_need = ext::openssl_tls::Need::Read; }
        exchange.wait_blocked = true;
    }
    return checked(exchange);
}
fn notify(exchange: &Exchange) -> core::result::Result<bool,Cause> {
    exchange.stage = Stage::Shutdown;
    if (exchange.tls.calls == exchange.options.tls_calls) { return core::result::Err(Cause::TlsLimit); }
    if (exchange.wait_blocked) { return core::result::Ok(false); }
    let before = before_tls(exchange,ext::http_server::Stage::Shutdown,4); if (before.is_err()) { return before; }
    let session: ext::openssl_tls::Session = take_session(exchange);
    let result: core::result::Result<ext::openssl_tls::Shutdown,ext::openssl_tls::Error> = session.shutdown_write(); exchange.session = core::option::Some(session);
    if (result.is_err()) { return core::result::Err(Cause::Tls(result.unwrap_err())); }
    let complete: bool = match(result.unwrap()) { ext::openssl_tls::Shutdown::Complete -> true, _ -> false };
    let sent: bool = complete || match(result.unwrap()) { ext::openssl_tls::Shutdown::Sent -> true, _ -> false };
    if (sent) {
        exchange.notified = true; if (complete) { exchange.peer_closed = true; }
        exchange.wait_need = ext::openssl_tls::Need::None; exchange.wait_blocked = false; exchange.read_blocked = false;
        // Complete proves two effects; record both before one clock observation.
        let recorded: core::result::Result<bool,ext::http_server::Failure> = exchange.protocol.record_write_shutdown(complete);
        if (recorded.is_err()) { return core::result::Err(Cause::Http(recorded.unwrap_err())); }
        exchange.phase = Phase::Protocol; return core::result::Ok(true);
    }
    exchange.wait_need = ext::openssl_tls::Need::Write;
    if (match(result.unwrap()) { ext::openssl_tls::Shutdown::WantRead -> true, _ -> false }) { exchange.wait_need = ext::openssl_tls::Need::Read; }
    exchange.wait_blocked = true; return checked(exchange);
}
fn advance(exchange: &Exchange) -> core::result::Result<bool,Cause> {
    if (handshaking(exchange)) { return handshake(exchange); }
    if (match(exchange.phase) { Phase::Notify -> true, _ -> false }) { return notify(exchange); }
    if (match(exchange.phase) { Phase::Close -> true, _ -> false }) {
        exchange.stage = Stage::Close; let closed = close_transport(exchange);
        if (closed.is_err()) {
            if (exchange.protocol.last_terminal_failure().is_some()) { return core::result::Err(Cause::Http(exchange.protocol.last_terminal_failure().unwrap())); }
            return closed;
        }
        let finished: core::result::Result<bool,ext::http_server::Failure> = exchange.protocol.transport_finished();
        if (finished.is_err()) { return core::result::Err(Cause::Http(finished.unwrap_err())); }
        exchange.stage = Stage::Publish; return core::result::Ok(true);
    }
    let need: ext::http_server::Need = exchange.protocol.need();
    if (match(need) { ext::http_server::Need::Local -> true, _ -> false }) {
        exchange.stage = Stage::Protocol;
        let progressed: core::result::Result<ext::http_server::Need,ext::http_server::Failure> = exchange.protocol.advance();
        if (progressed.is_err()) { return core::result::Err(Cause::Http(progressed.unwrap_err())); } return core::result::Ok(true);
    }
    if (match(need) { ext::http_server::Need::Decision -> true, _ -> false }) { return core::result::Ok(false); }
    if (match(need) { ext::http_server::Need::Input(amount) -> true, _ -> false }) {
        if (exchange.tls.calls == exchange.options.tls_calls) { return core::result::Err(Cause::TlsLimit); }
        if (exchange.peer_closed) { return core::result::Err(Cause::InvalidEngine); }
        if (exchange.read_blocked) { return core::result::Ok(false); } return tls_read(exchange,false);
    }
    if (match(need) { ext::http_server::Need::Output(kind) -> true, _ -> false }) {
        if (exchange.tls.calls == exchange.options.tls_calls) { return core::result::Err(Cause::TlsLimit); }
        let final: bool = match(need) { ext::http_server::Need::Output(kind) -> match(kind) { ext::http_server::SendKind::Final -> true, _ -> false }, _ -> false };
        return output(exchange,final);
    }
    if (match(need) { ext::http_server::Need::Shutdown -> true, _ -> false }) {
        if (exchange.tls.calls == exchange.options.tls_calls) { return core::result::Err(Cause::TlsLimit); } return begin_notify(exchange);
    }
    if (match(need) { ext::http_server::Need::Drain(amount) -> true, _ -> false }) {
        if (exchange.tls.calls == exchange.options.tls_calls) { return core::result::Err(Cause::TlsLimit); }
        if (exchange.peer_closed) { return core::result::Err(Cause::InvalidEngine); }
        if (exchange.read_blocked) { return core::result::Ok(false); } return tls_read(exchange,true);
    }
    if (!exchange.notified) { return begin_notify(exchange); }
    exchange.phase = Phase::Close; return core::result::Ok(true);
}
fn read_interest(exchange: &Exchange, interest: ext::http_client::Interest) -> ext::http_client::Interest {
    if (writes(read_need(exchange))) { interest.writable = true; } else { interest.readable = true; }
    if (!exchange.read_blocked) { interest.immediate = true; } return interest;
}
fn write_interest(exchange: &Exchange, interest: ext::http_client::Interest) -> ext::http_client::Interest {
    if (pending_write(exchange) != 0 && reads(write_need(exchange))) { interest.readable = true; } else { interest.writable = true; }
    if (!exchange.write_blocked) { interest.immediate = true; } return interest;
}
fn driver_interest(exchange: &Exchange) -> ext::http_client::Interest {
    let interest: ext::http_client::Interest = ext::http_client::Interest { readable:false,writable:false,immediate:false };
    if (!running(exchange.current)) { return interest; }
    if (match(exchange.phase) { Phase::Handshake -> true, Phase::Notify -> true, _ -> false }) {
        interest.immediate = !exchange.wait_blocked || exchange.tls.calls == exchange.options.tls_calls;
        interest.writable = writes(exchange.wait_need); interest.readable = !interest.writable; return interest;
    }
    if (match(exchange.phase) { Phase::Close -> true, _ -> false }) { interest.immediate = true; return interest; }
    let need: ext::http_server::Need = exchange.protocol.need();
    if (match(need) { ext::http_server::Need::Decision -> true, _ -> false }) { return interest; }
    if (match(need) { ext::http_server::Need::Local -> true, ext::http_server::Need::FinishTransport -> true, _ -> false }) { interest.immediate = true; return interest; }
    if (exchange.tls.calls == exchange.options.tls_calls) { interest.immediate = true; return interest; }
    if (match(need) { ext::http_server::Need::Shutdown -> true, _ -> false }) {
        if (pending_read(exchange) != 0 && writes(read_need(exchange))) { interest = read_interest(exchange,interest); }
        else { interest.immediate = true; } return interest;
    }
    if (match(need) { ext::http_server::Need::Input(amount) -> true, ext::http_server::Need::Drain(amount) -> true, _ -> false }) {
        if (exchange.peer_closed) { interest.immediate = true; } else { interest = read_interest(exchange,interest); } return interest;
    }
    if (pending_write(exchange) != 0 && writes(write_need(exchange))) { return write_interest(exchange,interest); }
    interest = write_interest(exchange,interest);
    let final: bool = match(need) { ext::http_server::Need::Output(kind) -> match(kind) { ext::http_server::SendKind::Final -> true, _ -> false }, _ -> false };
    if (final && !exchange.peer_closed) { interest = read_interest(exchange,interest); } return interest;
}
fn publish(exchange: &Exchange) -> core::option::Option<ext::http_server::Event> {
    let revision: u64 = exchange.protocol.event_revision();
    if (revision == 0 || revision == exchange.published) { return core::option::None(); }
    let event: core::option::Option<ext::http_server::Event> = exchange.protocol.event();
    if (event.is_none()) { return core::option::None(); }
    exchange.published = revision;
    let terminal: bool = match(event.unwrap()) { ext::http_server::Event::Empty -> true, ext::http_server::Event::Complete(stats) -> true, _ -> false };
    if (terminal) { exchange.current = ext::http_server::Status::Complete; exchange.stage = Stage::Publish; }
    return event;
}
fn driver_wait(exchange: &Exchange) -> core::result::Result<bool,Failure> {
    if (match(exchange.current) { ext::http_server::Status::Failed -> true, _ -> false }) { return core::result::Err(exchange.failure.unwrap()); }
    if (!running(exchange.current)) { return core::result::Ok(false); }
    let observed = checked(exchange); if (observed.is_err()) { return core::result::Err(stop(exchange,observed.unwrap_err())); }
    if (driver_interest(exchange).immediate || (!handshaking(exchange) && match(exchange.protocol.need()) { ext::http_server::Need::Decision -> true, _ -> false })) { return core::result::Ok(false); }
    let charged: core::result::Result<bool,ext::http_server::Failure> = exchange.protocol.before_wait();
    if (charged.is_err()) { return core::result::Err(stop(exchange,Cause::Http(charged.unwrap_err()))); } return core::result::Ok(charged.unwrap());
}
fn driver_abort(exchange: &Exchange) -> core::result::Result<bool,Failure> {
    if (!running(exchange.current)) { return core::result::Ok(false); }
    let had_terminal: bool = exchange.protocol.last_terminal_failure().is_some();
    let original_stage: Stage = exchange.stage;
    exchange.stage = Stage::Close; exchange.protocol.abort();
    let closed = close_transport(exchange); exchange.current = ext::http_server::Status::Aborted;
    if (had_terminal && exchange.protocol.last_terminal_failure().is_some()) {
        let primary: Failure = metadata(exchange,Cause::Http(exchange.protocol.last_terminal_failure().unwrap())); primary.stage = original_stage;
        exchange.failure = core::option::Some(primary);
    }
    if (closed.is_err()) {
        let error: Failure = metadata(exchange,closed.unwrap_err());
        // This Err describes the new cleanup cause itself, not another copy of
        // the earlier Protocol primary or a duplicate secondary close field.
        if (exchange.close_error.is_some()) { error.cleanup = core::option::None(); }
        if (!had_terminal) { exchange.failure = core::option::Some(error); } return core::result::Err(error);
    }
    return core::result::Ok(true);
}
fn command(exchange: &Exchange, result: core::result::Result<bool,ext::http_server::Failure>) -> core::result::Result<bool,Failure> {
    if (result.is_ok()) { return core::result::Ok(result.unwrap()); }
    let error: ext::http_server::Failure = result.unwrap_err();
    if (match(exchange.protocol.status()) { ext::http_server::Status::Failed -> true, _ -> false }) { return core::result::Err(stop(exchange,Cause::Http(error))); }
    return core::result::Err(metadata(exchange,Cause::Http(error)));
}
pub impl Exchange {
    pub fn borrow(&self) -> &Exchange { return self; }
    pub fn protocol(&self) -> &ext::http_server::Protocol { return self.protocol.borrow(); }
    pub fn peer(&self) -> core::net::SocketAddr { return self.remote; }
    pub fn stats(&self) -> ext::http_server::Stats { return self.protocol.stats(); }
    pub fn logical_bytes(&self) -> u64 { return self.protocol.logical_bytes(); }
    pub fn tls_stats(&self) -> TlsStats { return self.tls; }
    pub fn status(&self) -> ext::http_server::Status { return self.current; }
    pub fn rejection(&self) -> core::option::Option<ext::http_server::Rejection> { return self.protocol.rejection(); }
    pub fn last_terminal_failure(&self) -> core::option::Option<Failure> { return self.failure; }
    pub fn negotiated_version(&self) -> i32 { return self.version; }
    pub fn remaining(&self) -> core::time::Duration { return self.protocol.remaining(); }
    pub fn raw_handle(&self) -> core::option::Option<i32> { if (!running(self.current)) { return core::option::None(); } return self.socket.raw_handle(); }
    pub fn interest(&self) -> ext::http_client::Interest { return driver_interest(self); }
    pub fn before_wait(&self) -> core::result::Result<bool,Failure> { return driver_wait(self); }
    pub fn step(&self, ready: ext::http_client::Readiness) -> core::result::Result<core::option::Option<ext::http_server::Event>,Failure> {
        if (match(self.current) { ext::http_server::Status::Failed -> true, _ -> false }) { return core::result::Err(self.failure.unwrap()); }
        if (!running(self.current)) { return core::result::Ok(core::option::None()); }
        let observed = checked(self); if (observed.is_err()) { return core::result::Err(stop(self,observed.unwrap_err())); }
        wake(self,ready); let result = advance(self);
        if (result.is_err()) { return core::result::Err(stop(self,result.unwrap_err())); }
        if (handshaking(self)) { return core::result::Ok(core::option::None()); }
        return core::result::Ok(publish(self));
    }
    pub fn read_body(&self, decision: ext::http_server::BodyDecision) -> core::result::Result<bool,Failure> {
        if (match(self.current) { ext::http_server::Status::Failed -> true, _ -> false }) { return core::result::Err(self.failure.unwrap()); }
        if (!running(self.current)) { return core::result::Err(metadata(self,Cause::Inactive)); }
        if (handshaking(self)) { return core::result::Err(local_state(self)); }
        self.stage = Stage::Protocol; return command(self,self.protocol.read_body(decision));
    }
    pub fn respond(&self, response: ext::http_server::Response) -> core::result::Result<bool,Failure> {
        if (match(self.current) { ext::http_server::Status::Failed -> true, _ -> false }) { return core::result::Err(self.failure.unwrap()); }
        if (!running(self.current)) { return core::result::Err(metadata(self,Cause::Inactive)); }
        if (handshaking(self)) { return core::result::Err(local_state(self)); }
        self.stage = Stage::Protocol; return command(self,self.protocol.respond(response));
    }
    pub fn abort(&self) -> core::result::Result<bool,Failure> { return driver_abort(self); }
    pub fn destroy(&self) -> core::result::Result<bool,Failure> {
        let aborted: core::result::Result<bool,Failure> = driver_abort(self); let released: bool = self.protocol.destroy();
        if (aborted.is_err()) { return core::result::Err(aborted.unwrap_err()); } return core::result::Ok(aborted.unwrap() || released);
    }
}
