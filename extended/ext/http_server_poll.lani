// Plain HTTP connections supplied to the shared server scheduler.
module ext::http_server_poll;
import core::clone;
import core::option;
import core::result;
import core::time;
import ext::http_client;
import ext::http_server;
import ext::server_poll;
import std::socket;

// Keep this factory, the listener and the handler alive and unchanged through
// the caller-driven Server's destruction. The synchronous helper borrows its
// local factory only until all connections have retired and the report moves.
pub struct Factory { options: ext::http_server::Options }
pub struct Driver { owner: ext::http_server::Exchange }
pub fn factory(options: ext::http_server::Options) -> Factory { return Factory { options: options }; }
pub impl Factory { pub fn borrow(&self) -> &Factory { return self; } }

pub impl ext::server_poll::Driver<ext::http_server::Failure> for Driver {
    pub fn protocol(&self) -> &ext::http_server::Protocol { return self.owner.protocol(); }
    pub fn stats(&self) -> ext::http_server::Stats { return self.owner.stats(); }
    pub fn rejection(&self) -> core::option::Option<ext::http_server::Rejection> { return self.owner.rejection(); }
    pub fn transport_calls(&self) -> core::option::Option<u64> { return core::option::None(); }
    pub fn interest(&self) -> ext::http_client::Interest { return self.owner.interest(); }
    pub fn raw_handle(&self) -> core::option::Option<i32> { return self.owner.raw_handle(); }
    pub fn before_wait(&self) -> core::result::Result<bool,ext::http_server::Failure> { return self.owner.before_wait(); }
    pub fn step(&self, ready: ext::http_client::Readiness) -> core::result::Result<core::option::Option<ext::http_server::Event>,ext::http_server::Failure> { return self.owner.step(ready); }
    pub fn read_body(&self, decision: ext::http_server::BodyDecision) -> core::result::Result<bool,ext::http_server::Failure> { return self.owner.read_body(decision); }
    pub fn abort(&self) -> core::result::Result<bool,ext::http_server::Failure> { return self.owner.abort(); }
    pub fn destroy(&self) {
        // The scheduler calls this only after native transport retirement.
        // Protocol backing remains valid until this explicit release.
        assert(!match(self.owner.status()) { ext::http_server::Status::Active -> true, _ -> false });
        let released: core::result::Result<bool,ext::http_server::Failure> = self.owner.destroy(); assert(released.is_ok());
    }
}
pub impl ext::server_poll::Factory<Driver,ext::http_server::Failure> for Factory {
    pub fn reservation(&self) -> core::result::Result<ext::server_poll::Reservation,ext::server_poll::Cause> {
        let bytes: core::result::Result<u64,ext::http_server::Cause> = ext::http_server::reservation_bytes(self.options);
        if (bytes.is_err()) { return core::result::Err(ext::server_poll::Cause::Protocol(bytes.unwrap_err())); }
        return core::result::Ok(ext::server_poll::Reservation { work: self.options.work, bytes: bytes.unwrap() });
    }
    pub fn begin(&self, accepted: std::socket::Accepted, deadline: core::time::Deadline) -> core::result::Result<Driver,ext::http_server::Failure> {
        let made: core::result::Result<ext::http_server::Exchange,ext::http_server::Failure> = ext::http_server::begin_connected(accepted.socket,accepted.peer,self.options,deadline);
        if (made.is_err()) { return core::result::Err(made.unwrap_err()); }
        return core::result::Ok(Driver { owner: made.unwrap() });
    }
    pub fn failure_stats(&self, error: ext::http_server::Failure) -> ext::http_server::Stats { return error.stats; }
    pub fn failure_transport_calls(&self, error: ext::http_server::Failure) -> core::option::Option<u64> { return core::option::None(); }
    pub fn shared_failure(&self, error: ext::http_server::Failure) -> core::option::Option<ext::server_poll::Cause> {
        return match(error.cause) { ext::http_server::Cause::Clock(value) -> core::option::Some(ext::server_poll::Cause::Clock(value)), _ -> core::option::None() };
    }
}

// The persistent owner borrows the caller's Factory; no constructor-local
// factory or handler reference escapes into the returned Server.
pub fn new<H,A>(listener: &std::socket::Socket, factory: &Factory, handler: &H, limits: ext::server_poll::ServerLimits, deadline: core::time::Deadline)
    -> core::result::Result<ext::server_poll::Server<Driver,ext::http_server::Failure,Factory,H,A>,ext::server_poll::Cause> where H: ext::server_poll::Handler<A> {
    return ext::server_poll::new<Driver,ext::http_server::Failure,Factory,H,A>(listener,factory,handler,limits,deadline);
}

// Convenience loop over the same caller-driven scheduler. All connection
// owners retire before return; the result owns only outcomes and diagnostics.
pub fn serve_until<H,A>(listener: &std::socket::Socket, handler: &H, options: ext::http_server::Options, limits: ext::server_poll::ServerLimits, deadline: core::time::Deadline)
    -> core::result::Result<ext::server_poll::Report<ext::http_server::Failure,A>,ext::server_poll::ServiceFailure<ext::http_server::Failure,A>> where H: ext::server_poll::Handler<A>, A: core::clone::Destroy<A> {
    let adapter: Factory = factory(options);
    return ext::server_poll::serve_until<Driver,ext::http_server::Failure,Factory,H,A>(listener,adapter.borrow(),handler,limits,deadline);
}
