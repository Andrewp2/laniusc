// AES-GCM, NIST SP 800-38D sections 5-7; full 128-bit detached tags.
// https://doi.org/10.6028/NIST.SP.800-38D
module ext::aes_gcm;
import core::aes;
import core::result;
import core::slice;

pub const MAX_PLAINTEXT_BYTES: u64 = 68719476704;
pub enum Error { Bounds, InvalidKeyLength, InvalidNonceLength, InvalidTagLength, BufferTooSmall, InputTooLong, AuthenticationFailed }
// Immutable inline key schedule and hash subkey. Copies retain no source borrow
// and grant no fresh nonce authority. Use new; do not fabricate/mutate fields.
pub struct Key { schedule: core::aes::Schedule, hash_key: [u8; 16] }
fn valid(value: core::slice::View<u8>) -> bool {
    return value.start >= 0 && value.length >= 0 && value.start <= 2147483647-value.length;
}
pub fn new(key: core::slice::View<u8>) -> core::result::Result<Key, Error> {
    if (!valid(key)) { return core::result::Err(Error::Bounds); }
    if (key.length != 16 && key.length != 24 && key.length != 32) { return core::result::Err(Error::InvalidKeyLength); }
    let schedule: core::aes::Schedule = core::result::unwrap(core::aes::new(key));
    let zero: [u8; 16] = [0; 16]; let h: [u8; 16] = [0; 16];
    core::result::unwrap(schedule.encrypt_into(core::slice::View { values: zero, start: 0, length: 16 }, core::slice::View { values: h, start: 0, length: 16 }));
    return core::result::Ok(Key { schedule: schedule, hash_key: h });
}
// Multiply in the SP800-38D bit convention. Fixed 128x16 byte operations,
// masked selections, no secret-indexed tables or secret-dependent branches.
fn multiply(value: [u8], hash_key: [u8]) {
    let product: [u8; 16] = [0; 16]; let factor: [u8; 16] = [0; 16]; let index: i32 = 0;
    while (index < 16) { factor[index] = hash_key[index]; index += 1; }
    let bit: i32 = 0;
    while (bit < 128) {
        let mask: u8 = (255*((value[bit/8] >> (7-bit%8)) & 1)) as u8;
        index = 0; while (index < 16) { product[index] ^= factor[index] & mask; index += 1; }
        let reduction: u8 = (225*(factor[15] & 1)) as u8; let carry: u8 = 0;
        index = 0;
        while (index < 16) {
            let next: u8 = ((factor[index] & 1) << 7) as u8;
            factor[index] = (factor[index] >> 1) | carry; carry = next; index += 1;
        }
        factor[0] ^= reduction; bit += 1;
    }
    index = 0; while (index < 16) { value[index] = product[index]; index += 1; }
}
// Fold complete blocks and a zero-padded final partial block. Separate calls
// deliberately create separate padding boundaries (AAD, ciphertext, or IV).
fn fold(value: [u8], hash_key: [u8], input: core::slice::View<u8>) {
    let at: i32 = 0;
    while (at < input.length) {
        let count: i32 = input.length-at; if (count > 16) { count = 16; }
        let index: i32 = 0;
        while (index < count) { value[index] ^= input.values[input.start+at+index]; index += 1; }
        multiply(value, hash_key); at += count;
    }
}
fn lengths(value: [u8], hash_key: [u8], first: u64, second: u64) {
    let index: i32 = 0;
    while (index < 8) {
        value[index] ^= ((first >> (56-index*8)) & 255) as u8;
        value[8+index] ^= ((second >> (56-index*8)) & 255) as u8; index += 1;
    }
    multiply(value, hash_key);
}
// inc32 is modulo 2^32, including for general-IV J0. It is not saturation.
fn increment(counter: [u8]) {
    let carry: u32 = 1; let index: i32 = 15;
    while (index >= 12) {
        let sum: u32 = (counter[index] as u32)+carry;
        counter[index] = (sum & 255) as u8; carry = sum >> 8; index -= 1;
    }
}
fn preflight(nonce: core::slice::View<u8>, aad: core::slice::View<u8>, input: core::slice::View<u8>, output: core::slice::View<u8>, tag: core::slice::View<u8>) -> core::result::Result<i32, Error> {
    if (!valid(nonce) || !valid(aad) || !valid(input) || !valid(output) || !valid(tag)) { return core::result::Err(Error::Bounds); }
    if (nonce.length == 0) { return core::result::Err(Error::InvalidNonceLength); }
    if (tag.length != 16) { return core::result::Err(Error::InvalidTagLength); }
    if (output.length < input.length) { return core::result::Err(Error::BufferTooSmall); }
    if ((input.length as u64) > MAX_PLAINTEXT_BYTES) { return core::result::Err(Error::InputTooLong); }
    // Every i32 AAD/IV length times eight fits the NIST u64 length fields.
    return core::result::Ok(0);
}
pub impl Key {
    pub fn borrow(&self) -> &Key { return self; }
    fn initial(&self, nonce: core::slice::View<u8>, counter: [u8]) {
        if (nonce.length == 12) {
            let index: i32 = 0; while (index < 12) { counter[index] = nonce.values[nonce.start+index]; index += 1; }
            counter[15] = 1;
        } else {
            fold(counter, self.hash_key, nonce); lengths(counter, self.hash_key, 0, (nonce.length as u64)*8);
        }
    }
    fn tag_for(&self, counter: [u8], aad: core::slice::View<u8>, ciphertext: core::slice::View<u8>, tag: [u8]) {
        let value: [u8; 16] = [0; 16];
        fold(value, self.hash_key, aad); fold(value, self.hash_key, ciphertext);
        lengths(value, self.hash_key, (aad.length as u64)*8, (ciphertext.length as u64)*8);
        core::result::unwrap(self.schedule.encrypt_into(core::slice::View { values: counter, start: 0, length: 16 }, core::slice::View { values: tag, start: 0, length: 16 }));
        let index: i32 = 0; while (index < 16) { tag[index] ^= value[index]; index += 1; }
    }
    fn crypt(&self, initial: [u8], input: core::slice::View<u8>, output: core::slice::View<u8>) {
        let counter: [u8; 16] = [0; 16]; let index: i32 = 0;
        while (index < 16) { counter[index] = initial[index]; index += 1; }
        let block: [u8; 16] = [0; 16]; let at: i32 = 0;
        while (at < input.length) {
            increment(counter);
            core::result::unwrap(self.schedule.encrypt_into(core::slice::View { values: counter, start: 0, length: 16 }, core::slice::View { values: block, start: 0, length: 16 }));
            let count: i32 = input.length-at; if (count > 16) { count = 16; }
            index = 0; while (index < count) { output.values[output.start+at+index] = input.values[input.start+at+index] ^ block[index]; index += 1; }
            at += count;
        }
    }
    // All views physically backed, input immutable except exact payload alias.
    // Written payload cells may be exactly in-place or disjoint; no partial
    // overlap. Output/tag disjoint from self, nonce, AAD and each other; seal
    // tag also disjoint from input. Caller maintains nonce uniqueness per key.
    pub fn seal_into(&self, nonce: core::slice::View<u8>, aad: core::slice::View<u8>, input: core::slice::View<u8>, output: core::slice::View<u8>, tag_output: core::slice::View<u8>) -> core::result::Result<i32, Error> {
        let checked: core::result::Result<i32, Error> = preflight(nonce, aad, input, output, tag_output);
        if (core::result::is_err(checked)) { return checked; }
        let counter: [u8; 16] = [0; 16]; self.initial(nonce, counter); self.crypt(counter, input, output);
        let ciphertext: core::slice::View<u8> = core::slice::View { values: output.values, start: output.start, length: input.length };
        let tag: [u8; 16] = [0; 16]; self.tag_for(counter, aad, ciphertext, tag); let index: i32 = 0;
        while (index < 16) { tag_output.values[tag_output.start+index] = tag[index]; index += 1; }
        return core::result::Ok(input.length);
    }
    // Authentication compares all tag bytes before any plaintext write. On
    // every error the entire destination remains unchanged. Output is also
    // disjoint from supplied tag. No compiled constant-time guarantee.
    pub fn open_into(&self, nonce: core::slice::View<u8>, aad: core::slice::View<u8>, ciphertext: core::slice::View<u8>, tag: core::slice::View<u8>, output: core::slice::View<u8>) -> core::result::Result<i32, Error> {
        let checked: core::result::Result<i32, Error> = preflight(nonce, aad, ciphertext, output, tag);
        if (core::result::is_err(checked)) { return checked; }
        let counter: [u8; 16] = [0; 16]; self.initial(nonce, counter);
        let expected: [u8; 16] = [0; 16]; self.tag_for(counter, aad, ciphertext, expected);
        let difference: u8 = 0; let index: i32 = 0;
        while (index < 16) { difference |= expected[index] ^ tag.values[tag.start+index]; index += 1; }
        if (difference != 0) { return core::result::Err(Error::AuthenticationFailed); }
        self.crypt(counter, ciphertext, output); return core::result::Ok(ciphertext.length);
    }
}
// Raw-key convenience calls check every logical view before any fixed length
// or capacity. Output/tag must also be disjoint from raw key storage.
pub fn seal_into(key: core::slice::View<u8>, nonce: core::slice::View<u8>, aad: core::slice::View<u8>, input: core::slice::View<u8>, output: core::slice::View<u8>, tag_output: core::slice::View<u8>) -> core::result::Result<i32, Error> {
    if (!valid(key) || !valid(nonce) || !valid(aad) || !valid(input) || !valid(output) || !valid(tag_output)) { return core::result::Err(Error::Bounds); }
    if (key.length != 16 && key.length != 24 && key.length != 32) { return core::result::Err(Error::InvalidKeyLength); }
    let checked: core::result::Result<i32, Error> = preflight(nonce, aad, input, output, tag_output);
    if (core::result::is_err(checked)) { return checked; }
    let state: Key = core::result::unwrap(new(key)); return state.seal_into(nonce, aad, input, output, tag_output);
}
pub fn open_into(key: core::slice::View<u8>, nonce: core::slice::View<u8>, aad: core::slice::View<u8>, ciphertext: core::slice::View<u8>, tag: core::slice::View<u8>, output: core::slice::View<u8>) -> core::result::Result<i32, Error> {
    if (!valid(key) || !valid(nonce) || !valid(aad) || !valid(ciphertext) || !valid(tag) || !valid(output)) { return core::result::Err(Error::Bounds); }
    if (key.length != 16 && key.length != 24 && key.length != 32) { return core::result::Err(Error::InvalidKeyLength); }
    let checked: core::result::Result<i32, Error> = preflight(nonce, aad, ciphertext, output, tag);
    if (core::result::is_err(checked)) { return checked; }
    let state: Key = core::result::unwrap(new(key)); return state.open_into(nonce, aad, ciphertext, tag, output);
}
