// TLS transport for event servers that wrap their clients
// (ext::client_transport::Clients: ext::http_proxy, ext::http_service's
// Server). It owns one ext::openssl_tls session per client: handshakes,
// decrypts into the server's client buffers, encrypts what the server
// queues and sends close_notify, all nonblocking on the server's loop.
// ALPN "h2" (offered with the context's set_alpn) starts HTTP/2; any other
// outcome is HTTP/1.1. Programs using it link OpenSSL (--native-link
// --native-library ssl --native-library crypto).
module ext::tls_clients;
import alloc::vec;
import core::option;
import core::result;
import core::slice;
import core::time;
import ext::client_transport;
import ext::openssl_tls;
import std::clock;
import std::socket;

// handshakes: completed; h2: of them, ALPN "h2"; failures: handshakes or
// records that failed; truncated: clients that closed without close_notify.
pub struct Stats { handshakes: i32, h2: i32, failures: i32, truncated: i32 }
pub struct TlsClients { context: ext::openssl_tls::ServerContext, sessions: alloc::vec::Vec<core::option::Option<ext::openssl_tls::Session>>, phases: alloc::vec::Vec<i32>, more: alloc::vec::Vec<i32>, stats: Stats, closed: bool }

const T_NONE: i32 = 0;
const T_HANDSHAKE: i32 = 1;
const T_OPEN: i32 = 2;
const READ: u32 = 1;
const WRITE: u32 = 4;

// The ALPN list (RFC 7301 wire form) for ServerContext.set_alpn: "h2" then
// "http/1.1", or only "http/1.1".
pub fn alpn_protocols(out: &alloc::vec::Vec<u8>, h2: bool) -> bool {
    out.clear();
    if (h2) { if (out.try_push(2).is_err() || out.try_push(104).is_err() || out.try_push(50).is_err()) { return false; } }
    if (out.try_push(8).is_err()) { return false; }
    let name: [u8;8] = [104, 116, 116, 112, 47, 49, 46, 49];
    let i: i32 = 0; while (i < 8) { if (out.try_push(name[i]).is_err()) { return false; } i += 1; }
    return true;
}

// Sessions for up to max_clients slots over context, which the caller
// keeps (and destroys after close).
pub fn clients(context: ext::openssl_tls::ServerContext, max_clients: i32) -> core::option::Option<TlsClients> {
    if (!context.is_open() || max_clients < 1) { return core::option::None(); }
    let t: TlsClients = TlsClients { context: context, sessions: alloc::vec::new<core::option::Option<ext::openssl_tls::Session>>(), phases: alloc::vec::new<i32>(), more: alloc::vec::new<i32>(), stats: Stats { handshakes: 0, h2: 0, failures: 0, truncated: 0 }, closed: false };
    let i: i32 = 0;
    while (i < max_clients) {
        if (t.sessions.try_push(core::option::None()).is_err() || t.phases.try_push(T_NONE).is_err()) { t.close(); return core::option::None(); }
        i += 1;
    }
    return core::option::Some(t);
}

fn socket_of(fd: i32) -> std::socket::Socket { return std::socket::Socket { handle: fd, domain: 2, datagram: false }; }

pub impl TlsClients {
    pub fn borrow(&self) -> &TlsClients { return self; }
    pub fn stats(&self) -> Stats { return self.stats; }
    // The deadline for the server's next poll: now while a session holds
    // decrypted input the server would take (no readiness event will
    // report it), else deadline.
    pub fn wake<P>(&self, p: &P, deadline: core::time::Deadline) -> core::time::Deadline where P: ext::client_transport::Clients {
        let k: i32 = 0;
        while (k < self.more.len()) {
            let slot: i32 = self.more.at(k); k += 1;
            if (p.client_wants_read(slot)) { let now = std::clock::monotonic_now(); if (now.is_ok()) { return core::time::Deadline { instant: now.unwrap() }; } }
        }
        return deadline;
    }
    // After each server poll: handle its notices and buffered input.
    pub fn serve<P>(&self, p: &P) where P: ext::client_transport::Clients {
        if (self.closed) { return; }
        self.serve_notices(p);
        let rounds: i32 = self.more.len(); let k: i32 = 0;
        while (rounds > 0 && k < self.more.len()) {
            rounds -= 1;
            let slot: i32 = self.more.at(k);
            if (self.phases.at(slot) != T_OPEN) { self.more.swap_remove(k); continue; }
            if (p.client_wants_read(slot)) { self.more.swap_remove(k); self.pump(p, slot, true, false); continue; }
            k += 1;
        }
        self.serve_notices(p);
    }
    // Free every session without close_notify (before the server closes
    // the sockets).
    pub fn close(&self) {
        if (self.closed) { return; }
        self.closed = true;
        let i: i32 = 0;
        while (i < self.sessions.len()) {
            let s: core::option::Option<ext::openssl_tls::Session> = self.sessions.at(i);
            if (s.is_some()) { let ts: ext::openssl_tls::Session = s.unwrap(); ts.destroy(); }
            i += 1;
        }
        self.sessions.destroy(); self.phases.destroy(); self.more.destroy();
    }
}

impl TlsClients {
    fn remember(&self, slot: i32) { let k: i32 = 0; while (k < self.more.len()) { if (self.more.at(k) == slot) { return; } k += 1; } self.more.try_push(slot); }
    fn serve_notices<P>(&self, p: &P) where P: ext::client_transport::Clients {
        let k: i32 = 0;
        while (k < p.notice_count()) {
            let n: ext::client_transport::Notice = p.notice(k); k += 1;
            if (n.kind == ext::client_transport::ACCEPTED) { self.accepted(p, n.slot, n.fd); }
            if (n.kind == ext::client_transport::READY) { self.pump(p, n.slot, (n.bits & (READ | 8 | 16)) != 0, (n.bits & (WRITE | 8)) != 0); }
            if (n.kind == ext::client_transport::SHUTDOWN) { self.shutdown(n.slot, n.fd); }
            if (n.kind == ext::client_transport::DROPPED) { self.dropped(n.slot, n.fd); }
        }
        p.clear_notices();
    }
    fn accepted<P>(&self, p: &P, slot: i32, fd: i32) where P: ext::client_transport::Clients {
        let made: core::result::Result<ext::openssl_tls::Session,ext::openssl_tls::Error> = self.context.session(fd);
        if (made.is_err()) { self.stats.failures += 1; p.client_drop(slot); return; }
        self.sessions.set(slot, core::option::Some(made.unwrap())); self.phases.set(slot, T_HANDSHAKE);
        p.client_hold(slot, READ);
    }
    // close_notify (best effort), then the write side of the socket.
    fn shutdown(&self, slot: i32, fd: i32) {
        let s: core::option::Option<ext::openssl_tls::Session> = self.sessions.at(slot);
        if (s.is_some()) { let ts: ext::openssl_tls::Session = s.unwrap(); ts.quiesce_read(); ts.shutdown_write(); self.sessions.set(slot, core::option::Some(ts)); }
        let socket: std::socket::Socket = socket_of(fd); socket.shutdown(std::socket::Shutdown::Write);
    }
    fn dropped(&self, slot: i32, fd: i32) {
        let s: core::option::Option<ext::openssl_tls::Session> = self.sessions.at(slot);
        if (s.is_some()) {
            let ts: ext::openssl_tls::Session = s.unwrap();
            let open: bool = match (ts.state()) { ext::openssl_tls::State::Open -> true, _ -> false };
            if (open) { ts.quiesce_read(); ts.shutdown(); }
            ts.destroy(); self.sessions.set(slot, core::option::None());
        }
        self.phases.set(slot, T_NONE);
        let socket: std::socket::Socket = socket_of(fd); socket.close();
    }
    // Readiness the session waits for: a read or write that wants the
    // other direction (TLS records can need both).
    fn update_hold<P>(&self, p: &P, slot: i32) where P: ext::client_transport::Clients {
        if (!p.client_open(slot) || self.sessions.at(slot).is_none()) { return; }
        let ts: ext::openssl_tls::Session = self.sessions.at(slot).unwrap(); let bits: u32 = 0;
        let rw: bool = match (ts.read_need()) { ext::openssl_tls::Need::Write -> true, _ -> false };
        let ww: bool = match (ts.write_need()) { ext::openssl_tls::Need::Write -> true, _ -> false };
        let wr: bool = match (ts.write_need()) { ext::openssl_tls::Need::Read -> true, _ -> false };
        if (rw || ww) { bits = bits | WRITE; }
        if (wr) { bits = bits | READ; }
        p.client_hold(slot, bits);
    }
    fn fail<P>(&self, p: &P, slot: i32) where P: ext::client_transport::Clients { self.stats.failures += 1; p.client_drop(slot); }
    // Handshake, then move bytes: socket records into the server's input,
    // the server's output into records.
    fn pump<P>(&self, p: &P, slot: i32, readable: bool, writable: bool) where P: ext::client_transport::Clients {
        if (!p.client_open(slot) || self.sessions.at(slot).is_none()) { return; }
        let r: bool = readable;
        if (self.phases.at(slot) == T_HANDSHAKE) {
            let ts: ext::openssl_tls::Session = self.sessions.at(slot).unwrap();
            let got: core::result::Result<ext::openssl_tls::Handshake,ext::openssl_tls::Error> = ts.handshake();
            self.sessions.set(slot, core::option::Some(ts));
            if (got.is_err()) { self.fail(p, slot); return; }
            let step: i32 = match (got.unwrap()) { ext::openssl_tls::Handshake::Complete -> 0, ext::openssl_tls::Handshake::WantRead -> 1, ext::openssl_tls::Handshake::WantWrite -> 2 };
            if (step == 1) { p.client_hold(slot, READ); return; }
            if (step == 2) { p.client_hold(slot, READ | WRITE); return; }
            self.phases.set(slot, T_OPEN); self.stats.handshakes += 1; p.client_hold(slot, 0);
            let name: [u8;16] = [0;16]; let n: i32 = ts.selected_protocol(core::slice::View { values: name, start: 0, length: 16 });
            if (n == 2 && name[0] == 104 && name[1] == 50) { self.stats.h2 += 1; p.client_start_h2(slot); }
            r = true;
        }
        let rw: bool = match (self.sessions.at(slot).unwrap().read_need()) { ext::openssl_tls::Need::Write -> true, _ -> false };
        if (writable && rw) { r = true; }
        if (writable && !self.send(p, slot)) { self.fail(p, slot); return; }
        let rounds: i32 = 4;
        while (rounds > 0) {
            rounds -= 1;
            let more: bool = false;
            if (r) {
                let got: i32 = self.receive(p, slot);
                if (got == -2) { self.stats.truncated += 1; p.client_drop(slot); return; }
                if (got < 0) { self.fail(p, slot); return; }
                more = got == 1;
            }
            p.client_ready(slot, r, writable);
            if (!p.client_open(slot)) { return; }
            if (!self.send(p, slot)) { self.fail(p, slot); return; }
            if (!more) { break; }
            if (!p.client_wants_read(slot)) { self.remember(slot); break; }
            if (rounds == 0) { self.remember(slot); }
        }
        self.update_hold(p, slot);
    }
    // Decrypt into the server's input until the socket has nothing more.
    // 0: drained (or EOF), 1: the session may hold more, -1: failed,
    // -2: the peer closed without close_notify.
    fn receive<P>(&self, p: &P, slot: i32) -> i32 where P: ext::client_transport::Clients {
        let ts: ext::openssl_tls::Session = self.sessions.at(slot).unwrap(); let calls: i32 = 16; let result: i32 = 1;
        while (calls > 0) {
            calls -= 1;
            let space: core::slice::View<u8> = p.client_input(slot);
            if (space.len() == 0) { break; }
            let got: core::result::Result<ext::openssl_tls::Read,ext::openssl_tls::Error> = ts.read_into(space);
            if (got.is_err()) {
                let cut: bool = match (got.unwrap_err().cause) { ext::openssl_tls::Cause::Truncated -> true, _ -> false };
                result = -1; if (cut) { result = -2; } break;
            }
            let n: i32 = match (got.unwrap()) { ext::openssl_tls::Read::Data(c) -> c, ext::openssl_tls::Read::Closed -> 0, ext::openssl_tls::Read::WantRead -> -1, ext::openssl_tls::Read::WantWrite -> -2 };
            if (n == 0) { p.client_eof(slot); result = 0; break; }
            if (n < 0) { result = 0; break; }
            p.client_received(slot, n);
        }
        self.sessions.set(slot, core::option::Some(ts));
        return result;
    }
    // Encrypt the server's output. A record that must wait keeps its bytes
    // in the session (retry_write); client_sent follows completed records.
    fn send<P>(&self, p: &P, slot: i32) -> bool where P: ext::client_transport::Clients {
        if (self.phases.at(slot) != T_OPEN || !p.client_open(slot)) { return true; }
        let ts: ext::openssl_tls::Session = self.sessions.at(slot).unwrap(); let most: i32 = self.context.io_bytes();
        let ok: bool = true; let calls: i32 = 64;
        while (calls > 0 && p.client_open(slot)) {
            calls -= 1;
            let pending: bool = ts.pending_write_bytes() > 0;
            let out: core::slice::View<u8> = p.client_output(slot);
            if (!pending && out.len() == 0) { break; }
            let n: i32 = out.len(); if (n > most) { n = most; }
            let got: core::result::Result<ext::openssl_tls::Write,ext::openssl_tls::Error> = ts.retry_write();
            if (!pending) { got = ts.write(core::slice::View { values: out.values, start: out.start, length: n }); }
            if (got.is_err()) { ok = false; break; }
            let done: i32 = match (got.unwrap()) { ext::openssl_tls::Write::Complete(c) -> c, ext::openssl_tls::Write::WantRead -> -1, ext::openssl_tls::Write::WantWrite -> -2 };
            if (done < 0) { break; }
            self.sessions.set(slot, core::option::Some(ts));
            p.client_sent(slot, done);
        }
        if (p.client_open(slot)) { self.sessions.set(slot, core::option::Some(ts)); }
        return ok;
    }
}
