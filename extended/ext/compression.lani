// Resumable raw DEFLATE, zlib and gzip framing with borrowed fixed workspace.
// Owned decode destroys all private storage on error; success owns one Vec.
module ext::compression;
import alloc::vec;
import core::adler32;
import core::crc32;
import core::result;
import core::slice;
import ext::deflate;
import ext::inflate;

pub enum Format { RawDeflate, Zlib, Gzip }
pub struct Limits { max_input: i32, max_output: i32, max_members: i32 }
pub enum Error { Bounds, InputLimit, OutputLimit, MemberLimit, AllocationFailed, CapacityOverflow, Truncated, Header, UnsupportedMethod, UnsupportedWindow, UnsupportedDictionary, Checksum, SizeMismatch, TrailingData, Deflate(ext::inflate::Error), Encode(ext::deflate::Error) }
pub const DEFAULT_MAX_INPUT: i32 = 16777216;
pub const DEFAULT_MAX_OUTPUT: i32 = 67108864;
pub const DEFAULT_MAX_MEMBERS: i32 = 1024;
pub fn default_limits() -> Limits { return Limits { max_input: DEFAULT_MAX_INPUT, max_output: DEFAULT_MAX_OUTPUT, max_members: DEFAULT_MAX_MEMBERS }; }

fn valid(view: core::slice::View<u8>) -> bool { return view.start >= 0 && view.length >= 0 && view.start <= 2147483647-view.length; }
fn byte(view: core::slice::View<u8>, index: i32) -> u8 { return view.values[view.start+index]; }
fn part(view: core::slice::View<u8>, start: i32, end: i32) -> core::slice::View<u8> { return core::result::unwrap(view.subview(start,end)); }
fn vector_error(error: alloc::vec::Error) -> Error {
    let mapped: Error = match (error) { alloc::vec::Error::AllocationFailed -> Error::AllocationFailed, alloc::vec::Error::CapacityOverflow -> Error::CapacityOverflow, _ -> Error::Bounds }; return mapped;
}
fn resize(output: &alloc::vec::Vec<u8>, length: i32) -> core::result::Result<i32,Error> {
    let result: core::result::Result<i32,alloc::vec::Error> = output.try_resize(length,0);
    if (core::result::is_err(result)) { return core::result::Err(vector_error(core::result::unwrap_err(result))); } return core::result::Ok(length);
}
fn crc(view: core::slice::View<u8>) -> u32 {
    let state: u32 = core::crc32::INITIAL; let index: i32 = 0;
    while (index < view.length) { state = core::crc32::update_byte(state,byte(view,index)); index += 1; } return core::crc32::finish(state);
}
fn put_little32(view: core::slice::View<u8>, start: i32, value: u32) {
    view.values[view.start+start] = (value & 255) as u8; view.values[view.start+start+1] = ((value >> 8) & 255) as u8;
    view.values[view.start+start+2] = ((value >> 16) & 255) as u8; view.values[view.start+start+3] = ((value >> 24) & 255) as u8;
}
fn put_big32(view: core::slice::View<u8>, start: i32, value: u32) {
    view.values[view.start+start] = ((value >> 24) & 255) as u8; view.values[view.start+start+1] = ((value >> 16) & 255) as u8;
    view.values[view.start+start+2] = ((value >> 8) & 255) as u8; view.values[view.start+start+3] = (value & 255) as u8;
}

// Fixed strategy; output has no timestamps, names, comments or OS dependency.
pub fn encode(input: core::slice::View<u8>, format: Format, max_output: i32) -> core::result::Result<alloc::vec::Vec<u8>,Error> {
    if (!valid(input) || max_output < 0) { return core::result::Err(Error::Bounds); }
    let prefix: i32 = match (format) { Format::RawDeflate -> 0, Format::Zlib -> 2, Format::Gzip -> 10 };
    let trailer: i32 = match (format) { Format::RawDeflate -> 0, Format::Zlib -> 4, Format::Gzip -> 8 };
    if (max_output < prefix+trailer) { return core::result::Err(Error::OutputLimit); }
    let scratch: alloc::vec::Vec<i32> = alloc::vec::new();
    let grown: core::result::Result<i32,alloc::vec::Error> = scratch.try_resize(ext::deflate::scratch_len(),0);
    if (core::result::is_err(grown)) { scratch.destroy(); return core::result::Err(vector_error(core::result::unwrap_err(grown))); }
    let measured: core::result::Result<i32,ext::deflate::Error> = ext::deflate::encoded_len(input,scratch.as_view());
    if (core::result::is_err(measured)) { scratch.destroy(); return core::result::Err(Error::Encode(core::result::unwrap_err(measured))); }
    let body_length: i32 = core::result::unwrap(measured);
    if (body_length > max_output-prefix-trailer) { scratch.destroy(); return core::result::Err(Error::OutputLimit); }
    let output: alloc::vec::Vec<u8> = alloc::vec::new();
    let allocated: core::result::Result<i32,Error> = resize(output.borrow(),prefix+body_length+trailer);
    if (core::result::is_err(allocated)) { scratch.destroy(); output.destroy(); return core::result::Err(core::result::unwrap_err(allocated)); }
    let bytes: core::slice::View<u8> = output.as_view();
    let encoded: core::result::Result<i32,ext::deflate::Error> = ext::deflate::encode_into(input,part(bytes,prefix,prefix+body_length),scratch.as_view());
    scratch.destroy();
    if (core::result::is_err(encoded)) { output.destroy(); return core::result::Err(Error::Encode(core::result::unwrap_err(encoded))); }
    if (core::result::unwrap(encoded) != body_length) { output.destroy(); return core::result::Err(Error::CapacityOverflow); }
    if (prefix == 2) {
        bytes.values[bytes.start] = 120; bytes.values[bytes.start+1] = 1;
        put_big32(bytes,prefix+body_length,core::result::unwrap(core::adler32::checksum(input)));
    }
    if (prefix == 10) {
        bytes.values[bytes.start] = 31; bytes.values[bytes.start+1] = 139; bytes.values[bytes.start+2] = 8;
        bytes.values[bytes.start+9] = 255;
        put_little32(bytes,prefix+body_length,crc(input)); put_little32(bytes,prefix+body_length+4,input.length as u32);
    }
    return core::result::Ok(output);
}

// Streaming encoding retains fixed caller workspace and scalar framing state.
// Workspaces, this object and each call's input/output must be disjoint and
// remain live; copies are inactive aliases, not independent encoders.
pub struct EncodeLimits { max_input: u64, max_output: u64 }
pub struct EncodeFailure { error: Error, read: i32, written: i32 }
pub fn default_encode_limits() -> EncodeLimits {
    return EncodeLimits { max_input: DEFAULT_MAX_INPUT as u64, max_output: DEFAULT_MAX_OUTPUT as u64 };
}
const ENCODE_HEADER: i32 = 0;
const ENCODE_BODY: i32 = 1;
const ENCODE_TRAILER: i32 = 2;
const ENCODE_FINISHED: i32 = 3;
const ENCODE_FAILED: i32 = 4;
pub struct Encoder {
    raw: ext::deflate::Encoder, kind: i32, limits: EncodeLimits,
    phase: i32, failure: Error, read_total: u64, written_total: u64,
    checksum: u32, member_size: u32, field_count: i32
}
fn encode_initial_checksum(kind: i32) -> u32 {
    if (kind == 1) { return core::adler32::INITIAL; }
    return core::crc32::INITIAL;
}
// Raw construction validates all workspace metadata before capacities and
// neither reads nor initializes backing. Limits need no signed validation.
pub fn encoder(block: core::slice::View<u8>, pending: core::slice::View<u8>, scratch: core::slice::View<i32>, format: Format, limits: EncodeLimits) -> core::result::Result<Encoder,Error> {
    let made: core::result::Result<ext::deflate::Encoder,ext::deflate::Error> = ext::deflate::encoder(block,pending,scratch);
    if (core::result::is_err(made)) {
        let error: ext::deflate::Error = core::result::unwrap_err(made);
        return core::result::Err(match (error) { ext::deflate::Error::Bounds -> Error::Bounds, _ -> Error::Encode(error) });
    }
    let kind: i32 = format_kind(format);
    return core::result::Ok(Encoder {
        raw: core::result::unwrap(made), kind: kind, limits: limits,
        phase: ENCODE_HEADER, failure: Error::Bounds, read_total: 0, written_total: 0,
        checksum: encode_initial_checksum(kind), member_size: 0, field_count: 0
    });
}
fn encode_progress(call: &Call, status: ext::deflate::Status) -> core::result::Result<ext::deflate::Step,EncodeFailure> {
    return core::result::Ok(ext::deflate::Step { read: call.read, written: call.written, status: status });
}
fn encode_fail(state: &Encoder, call: &Call, error: Error) -> core::result::Result<ext::deflate::Step,EncodeFailure> {
    state.phase = ENCODE_FAILED; state.failure = error;
    return core::result::Err(EncodeFailure { error: error, read: call.read, written: call.written });
}
fn encode_header_byte(kind: i32, index: i32) -> u8 {
    if (kind == 1) { if (index == 0) { return 120; } return 1; }
    if (index == 0) { return 31; }
    if (index == 1) { return 139; }
    if (index == 2) { return 8; }
    if (index == 9) { return 255; }
    return 0;
}
fn encode_trailer_byte(state: &Encoder) -> u8 {
    if (state.kind == 1) { return ((state.checksum >> ((3-state.field_count)*8)) & 255) as u8; }
    if (state.field_count < 4) { return ((core::crc32::finish(state.checksum) >> (state.field_count*8)) & 255) as u8; }
    return ((state.member_size >> ((state.field_count-4)*8)) & 255) as u8;
}
fn encode_put(state: &Encoder, call: &Call, value: u8) {
    call.output.values[call.output.start+call.written] = value;
    call.written += 1; state.written_total += 1; state.field_count += 1;
}
fn encode_account_body(state: &Encoder, call: &Call, read: i32, written: i32) {
    // Only the prefix actually copied by the raw encoder affects checksums.
    if (state.kind == 1) {
        state.checksum = core::result::unwrap(core::adler32::update(state.checksum,part(call.input,call.read,call.read+read)));
    }
    if (state.kind == 2) {
        let index: i32 = 0;
        while (index < read) { state.checksum = core::crc32::update_byte(state.checksum,byte(call.input,call.read+index)); index += 1; }
    }
    call.read += read; state.read_total += read as u64;
    call.written += written; state.written_total += written as u64;
    state.member_size = (((state.member_size as u64)+(read as u64)) & 4294967295) as u32;
}
fn encode_run(state: &Encoder, input: core::slice::View<u8>, output: core::slice::View<u8>, final_input: bool) -> core::result::Result<ext::deflate::Step,EncodeFailure> {
    // Bad descriptors remain recoverable even after a sticky error or Done.
    if (!valid(input) || !valid(output)) { return core::result::Err(EncodeFailure { error: Error::Bounds, read: 0, written: 0 }); }
    let call: Call = Call { input: input, output: output, read: 0, written: 0 };
    if (state.phase == ENCODE_FINISHED) { return encode_progress(call.borrow(),ext::deflate::Status::Done); }
    if (state.phase == ENCODE_FAILED) { return core::result::Err(EncodeFailure { error: state.failure, read: 0, written: 0 }); }
    // Admission covers the whole offer, including bytes a pending header or
    // body may prevent this call from consuming. Failure precedes all effects.
    if ((input.length as u64) > state.limits.max_input-state.read_total) { return encode_fail(state,call.borrow(),Error::InputLimit); }
    while (true) {
        if (state.phase == ENCODE_HEADER) {
            let length: i32 = 0; if (state.kind == 1) { length = 2; } if (state.kind == 2) { length = 10; }
            while (state.field_count < length) {
                if (state.written_total == state.limits.max_output) { return encode_fail(state,call.borrow(),Error::OutputLimit); }
                if (call.written == output.length) { return encode_progress(call.borrow(),ext::deflate::Status::NeedOutput); }
                encode_put(state,call.borrow(),encode_header_byte(state.kind,state.field_count));
            }
            state.field_count = 0; state.phase = ENCODE_BODY;
        }
        if (state.phase == ENCODE_BODY) {
            let count: i32 = output.length-call.written;
            let remaining: u64 = state.limits.max_output-state.written_total;
            if ((count as u64) > remaining) { count = remaining as i32; }
            // A zero-length raw output still admits input or observes Done.
            // Only confirmed pending bytes justify an OutputLimit failure.
            let result: core::result::Result<ext::deflate::Step,ext::deflate::Failure> = state.raw.step(part(input,call.read,input.length),part(output,call.written,call.written+count),final_input);
            if (core::result::is_err(result)) {
                let failure: ext::deflate::Failure = core::result::unwrap_err(result);
                encode_account_body(state,call.borrow(),failure.read,failure.written);
                return encode_fail(state,call.borrow(),Error::Encode(failure.error));
            }
            let progress: ext::deflate::Step = core::result::unwrap(result);
            encode_account_body(state,call.borrow(),progress.read,progress.written);
            let need_input: bool = match (progress.status) { ext::deflate::Status::NeedInput -> true, _ -> false };
            if (need_input) { return encode_progress(call.borrow(),ext::deflate::Status::NeedInput); }
            let need_output: bool = match (progress.status) { ext::deflate::Status::NeedOutput -> true, _ -> false };
            if (need_output) {
                if (state.written_total == state.limits.max_output) { return encode_fail(state,call.borrow(),Error::OutputLimit); }
                return encode_progress(call.borrow(),ext::deflate::Status::NeedOutput);
            }
            state.field_count = 0; state.phase = ENCODE_TRAILER;
        }
        if (state.phase == ENCODE_TRAILER) {
            let length: i32 = 0; if (state.kind == 1) { length = 4; } if (state.kind == 2) { length = 8; }
            while (state.field_count < length) {
                if (state.written_total == state.limits.max_output) { return encode_fail(state,call.borrow(),Error::OutputLimit); }
                if (call.written == output.length) { return encode_progress(call.borrow(),ext::deflate::Status::NeedOutput); }
                encode_put(state,call.borrow(),encode_trailer_byte(state));
            }
            state.phase = ENCODE_FINISHED;
            return encode_progress(call.borrow(),ext::deflate::Status::Done);
        }
    }
    return encode_progress(call.borrow(),ext::deflate::Status::Done);
}
pub impl Encoder {
    pub fn borrow(&self) -> &Encoder { return self; }
    pub fn step(&self, input: core::slice::View<u8>, output: core::slice::View<u8>, final_input: bool) -> core::result::Result<ext::deflate::Step,EncodeFailure> { return encode_run(self,input,output,final_input); }
    pub fn total_read(&self) -> u64 { return self.read_total; }
    pub fn total_written(&self) -> u64 { return self.written_total; }
    pub fn is_done(&self) -> bool { return self.phase == ENCODE_FINISHED; }
    pub fn is_failed(&self) -> bool { return self.phase == ENCODE_FAILED; }
    // Reset discards pending output without clearing or reading workspace.
    pub fn reset(&self, format: Format, limits: EncodeLimits) {
        self.raw.reset(); self.kind = format_kind(format); self.limits = limits;
        self.phase = ENCODE_HEADER; self.failure = Error::Bounds;
        self.read_total = 0; self.written_total = 0;
        self.checksum = encode_initial_checksum(self.kind); self.member_size = 0; self.field_count = 0;
    }
}

// Framing retains only scalar progress and the raw decoder's caller borrows.
// Input/output views belong to one call and may be recycled after it returns.
pub struct DecodeFailure { error: Error, read: i32, written: i32 }
const RAW_START: i32 = 0;
const ZLIB_HEADER: i32 = 1;
const ZLIB_DICTIONARY: i32 = 2;
const GZIP_START: i32 = 3;
const GZIP_PREFIX: i32 = 4;
const GZIP_HEADER: i32 = 5;
const GZIP_EXTRA_LENGTH: i32 = 6;
const GZIP_EXTRA: i32 = 7;
const GZIP_NAME: i32 = 8;
const GZIP_COMMENT: i32 = 9;
const GZIP_HEADER_CRC: i32 = 10;
const BODY: i32 = 11;
const ZLIB_TRAILER: i32 = 12;
const GZIP_TRAILER: i32 = 13;
const AWAIT_END: i32 = 14;
const BETWEEN_MEMBERS: i32 = 15;
const FINISHED: i32 = 16;
const FAILED: i32 = 17;

pub struct Decoder {
    raw: ext::inflate::Decoder, kind: i32, limits: Limits, phase: i32, failure: Error,
    read_total: u64, written_total: u64, completed_members: i32,
    checksum: u32, member_size: u32, header_crc: u32,
    field: u64, field_count: i32, flags: i32, remaining: i32
}
struct Call { input: core::slice::View<u8>, output: core::slice::View<u8>, read: i32, written: i32 }
impl Call { fn borrow(&self) -> &Call { return self; } }
fn valid_limits(limits: Limits) -> bool { return limits.max_input >= 0 && limits.max_output >= 0 && limits.max_members >= 0; }
fn format_kind(format: Format) -> i32 { return match (format) { Format::RawDeflate -> 0, Format::Zlib -> 1, Format::Gzip -> 2 }; }
fn initial_phase(kind: i32) -> i32 { if (kind == 0) { return RAW_START; } if (kind == 1) { return ZLIB_HEADER; } return GZIP_START; }

// Construction is inert: no backing is read or initialized. The caller keeps
// history/workspace live, disjoint and exclusively writable until retirement.
pub fn decoder(history: core::slice::View<u8>, workspace: core::slice::View<i32>, format: Format, limits: Limits) -> core::result::Result<Decoder,Error> {
    if (!valid_limits(limits)) { return core::result::Err(Error::Bounds); }
    let made: core::result::Result<ext::inflate::Decoder,ext::inflate::Error> = ext::inflate::decoder(history,workspace,32768);
    if (core::result::is_err(made)) { return core::result::Err(Error::Bounds); }
    let kind: i32 = format_kind(format);
    return core::result::Ok(Decoder {
        raw: core::result::unwrap(made), kind: kind, limits: limits, phase: initial_phase(kind), failure: Error::Bounds,
        read_total: 0, written_total: 0, completed_members: 0,
        checksum: 0, member_size: 0, header_crc: core::crc32::INITIAL,
        field: 0, field_count: 0, flags: 0, remaining: 0
    });
}
fn progress(call: &Call, status: ext::inflate::Status) -> core::result::Result<ext::inflate::Step,DecodeFailure> {
    return core::result::Ok(ext::inflate::Step { read: call.read, written: call.written, status: status });
}
fn fail(state: &Decoder, call: &Call, error: Error) -> core::result::Result<ext::inflate::Step,DecodeFailure> {
    state.phase = FAILED; state.failure = error;
    return core::result::Err(DecodeFailure { error: error, read: call.read, written: call.written });
}
fn missing_input(state: &Decoder, call: &Call, final_input: bool) -> core::result::Result<ext::inflate::Step,DecodeFailure> {
    if (final_input) { return fail(state,call,Error::Truncated); }
    return progress(call,ext::inflate::Status::NeedInput);
}
fn take_byte(state: &Decoder, call: &Call) -> u8 {
    let value: u8 = byte(call.input,call.read); call.read += 1; state.read_total += 1; return value;
}
fn clear_field(state: &Decoder, phase: i32) { state.field = 0; state.field_count = 0; state.phase = phase; }
fn begin_body(state: &Decoder, window: i32) {
    // Admitted immutable descriptors and windows make this reset infallible.
    core::result::unwrap(state.raw.reset(window));
    state.checksum = core::crc32::INITIAL;
    if (state.kind == 1) { state.checksum = core::adler32::INITIAL; }
    state.member_size = 0; state.phase = BODY;
}
fn after_comment(state: &Decoder) {
    if ((state.flags & 2) != 0) { clear_field(state,GZIP_HEADER_CRC); }
    else { begin_body(state,32768); }
}
fn after_name(state: &Decoder) {
    if ((state.flags & 16) != 0) { state.phase = GZIP_COMMENT; }
    else { after_comment(state); }
}
fn after_extra(state: &Decoder) {
    if ((state.flags & 8) != 0) { state.phase = GZIP_NAME; }
    else { after_name(state); }
}
fn account_body(state: &Decoder, call: &Call, read: i32, written: i32) {
    call.read += read; state.read_total += read as u64;
    if (state.kind == 1) {
        state.checksum = core::result::unwrap(core::adler32::update(state.checksum,part(call.output,call.written,call.written+written)));
    }
    if (state.kind == 2) {
        let index: i32 = 0;
        while (index < written) { state.checksum = core::crc32::update_byte(state.checksum,byte(call.output,call.written+index)); index += 1; }
    }
    call.written += written; state.written_total += written as u64;
    state.member_size = (((state.member_size as u64)+(written as u64)) & 4294967295) as u32;
}

fn run(state: &Decoder, input: core::slice::View<u8>, output: core::slice::View<u8>, final_input: bool) -> core::result::Result<ext::inflate::Step,DecodeFailure> {
    // Bounds is recoverable and wins even over a previous terminal state.
    if (!valid(input) || !valid(output)) { return core::result::Err(DecodeFailure { error: Error::Bounds, read: 0, written: 0 }); }
    let call: Call = Call { input: input, output: output, read: 0, written: 0 };
    if (state.phase == FINISHED) { return progress(call.borrow(),ext::inflate::Status::Done); }
    if (state.phase == FAILED) { return core::result::Err(DecodeFailure { error: state.failure, read: 0, written: 0 }); }
    if ((input.length as u64) > (state.limits.max_input as u64)-state.read_total) { return fail(state,call.borrow(),Error::InputLimit); }
    while (true) {
        if (state.phase == RAW_START) {
            if (state.limits.max_members == 0) { return fail(state,call.borrow(),Error::MemberLimit); }
            begin_body(state,32768);
        }
        if (state.phase == ZLIB_HEADER) {
            while (state.field_count < 2) {
                if (call.read == input.length) { return missing_input(state,call.borrow(),final_input); }
                state.field = state.field | ((take_byte(state,call.borrow()) as u64) << (state.field_count*8)); state.field_count += 1;
            }
            let cmf: i32 = (state.field & 255) as i32; let flags: i32 = ((state.field >> 8) & 255) as i32;
            if ((cmf & 15) != 8) { return fail(state,call.borrow(),Error::UnsupportedMethod); }
            if ((cmf >> 4) > 7) { return fail(state,call.borrow(),Error::UnsupportedWindow); }
            if (((cmf << 8) | flags) % 31 != 0) { return fail(state,call.borrow(),Error::Header); }
            if ((flags & 32) != 0) { clear_field(state,ZLIB_DICTIONARY); }
            else {
                if (state.limits.max_members == 0) { return fail(state,call.borrow(),Error::MemberLimit); }
                begin_body(state,1 << ((cmf >> 4)+8));
            }
        }
        if (state.phase == ZLIB_DICTIONARY) {
            while (state.field_count < 4) {
                if (call.read == input.length) { return missing_input(state,call.borrow(),final_input); }
                take_byte(state,call.borrow()); state.field_count += 1;
            }
            return fail(state,call.borrow(),Error::UnsupportedDictionary);
        }
        if (state.phase == GZIP_START) {
            if (call.read == input.length) { return missing_input(state,call.borrow(),final_input); }
            if (state.limits.max_members == 0) { return fail(state,call.borrow(),Error::MemberLimit); }
            state.header_crc = core::crc32::INITIAL; clear_field(state,GZIP_HEADER);
        }
        if (state.phase == GZIP_PREFIX) {
            if (call.read == input.length) {
                if (final_input && state.completed_members == state.limits.max_members) { return fail(state,call.borrow(),Error::MemberLimit); }
                return missing_input(state,call.borrow(),final_input);
            }
            // Classify trailing bytes before the next-member allowance, even
            // when the two magic bytes arrive in separate calls.
            if (byte(input,call.read) != 139) { return fail(state,call.borrow(),Error::TrailingData); }
            let value: u8 = take_byte(state,call.borrow());
            state.header_crc = core::crc32::update_byte(state.header_crc,value);
            state.field = state.field | ((value as u64) << 8); state.field_count = 2;
            if (state.completed_members == state.limits.max_members) { return fail(state,call.borrow(),Error::MemberLimit); }
            state.phase = GZIP_HEADER;
        }
        if (state.phase == GZIP_HEADER) {
            while (state.field_count < 10) {
                if (call.read == input.length) { return missing_input(state,call.borrow(),final_input); }
                let value: u8 = take_byte(state,call.borrow());
                state.header_crc = core::crc32::update_byte(state.header_crc,value);
                if (state.field_count < 4) { state.field = state.field | ((value as u64) << (state.field_count*8)); }
                state.field_count += 1;
            }
            if ((state.field & 65535) != 35615) { return fail(state,call.borrow(),Error::Header); }
            if (((state.field >> 16) & 255) != 8) { return fail(state,call.borrow(),Error::UnsupportedMethod); }
            state.flags = ((state.field >> 24) & 255) as i32;
            if ((state.flags & 224) != 0) { return fail(state,call.borrow(),Error::Header); }
            if ((state.flags & 4) != 0) { clear_field(state,GZIP_EXTRA_LENGTH); }
            else { after_extra(state); }
        }
        if (state.phase == GZIP_EXTRA_LENGTH) {
            while (state.field_count < 2) {
                if (call.read == input.length) { return missing_input(state,call.borrow(),final_input); }
                let value: u8 = take_byte(state,call.borrow()); state.header_crc = core::crc32::update_byte(state.header_crc,value);
                state.field = state.field | ((value as u64) << (state.field_count*8)); state.field_count += 1;
            }
            state.remaining = state.field as i32; state.phase = GZIP_EXTRA;
        }
        if (state.phase == GZIP_EXTRA) {
            while (state.remaining > 0) {
                if (call.read == input.length) { return missing_input(state,call.borrow(),final_input); }
                state.header_crc = core::crc32::update_byte(state.header_crc,take_byte(state,call.borrow())); state.remaining -= 1;
            }
            after_extra(state);
        }
        if (state.phase == GZIP_NAME || state.phase == GZIP_COMMENT) {
            let finished: bool = false;
            while (!finished) {
                if (call.read == input.length) { return missing_input(state,call.borrow(),final_input); }
                let value: u8 = take_byte(state,call.borrow()); state.header_crc = core::crc32::update_byte(state.header_crc,value);
                finished = value == 0;
            }
            if (state.phase == GZIP_NAME) { after_name(state); } else { after_comment(state); }
        }
        if (state.phase == GZIP_HEADER_CRC) {
            while (state.field_count < 2) {
                if (call.read == input.length) { return missing_input(state,call.borrow(),final_input); }
                state.field = state.field | ((take_byte(state,call.borrow()) as u64) << (state.field_count*8)); state.field_count += 1;
            }
            if (state.field != (core::crc32::finish(state.header_crc) & 65535) as u64) { return fail(state,call.borrow(),Error::Checksum); }
            begin_body(state,32768);
        }
        if (state.phase == BODY) {
            let space: i32 = output.length-call.written;
            let allowance: u64 = (state.limits.max_output as u64)-state.written_total;
            if ((space as u64) > allowance) { space = allowance as i32; }
            let decoded: core::result::Result<ext::inflate::Step,ext::inflate::Failure> = state.raw.step(part(input,call.read,input.length),part(output,call.written,call.written+space),final_input);
            if (core::result::is_err(decoded)) {
                let failure: ext::inflate::Failure = core::result::unwrap_err(decoded);
                account_body(state,call.borrow(),failure.read,failure.written);
                let truncated: bool = match (failure.error) { ext::inflate::Error::UnexpectedEof -> true, _ -> false };
                if (truncated) { return fail(state,call.borrow(),Error::Truncated); }
                return fail(state,call.borrow(),Error::Deflate(failure.error));
            }
            let step: ext::inflate::Step = core::result::unwrap(decoded);
            account_body(state,call.borrow(),step.read,step.written);
            let need_input: bool = match (step.status) { ext::inflate::Status::NeedInput -> true, _ -> false };
            if (need_input) { return progress(call.borrow(),ext::inflate::Status::NeedInput); }
            let need_output: bool = match (step.status) { ext::inflate::Status::NeedOutput -> true, _ -> false };
            if (need_output) {
                if (state.written_total == state.limits.max_output as u64) { return fail(state,call.borrow(),Error::OutputLimit); }
                return progress(call.borrow(),ext::inflate::Status::NeedOutput);
            }
            if (state.kind == 0) { state.completed_members += 1; state.phase = AWAIT_END; }
            if (state.kind == 1) { clear_field(state,ZLIB_TRAILER); }
            if (state.kind == 2) { clear_field(state,GZIP_TRAILER); }
        }
        if (state.phase == ZLIB_TRAILER) {
            while (state.field_count < 4) {
                if (call.read == input.length) { return missing_input(state,call.borrow(),final_input); }
                state.field = (state.field << 8) | (take_byte(state,call.borrow()) as u64); state.field_count += 1;
            }
            if (state.field != state.checksum as u64) { return fail(state,call.borrow(),Error::Checksum); }
            state.completed_members += 1; state.phase = AWAIT_END;
        }
        if (state.phase == GZIP_TRAILER) {
            while (state.field_count < 8) {
                if (call.read == input.length) { return missing_input(state,call.borrow(),final_input); }
                state.field = state.field | ((take_byte(state,call.borrow()) as u64) << (state.field_count*8)); state.field_count += 1;
            }
            if ((state.field & 4294967295) != core::crc32::finish(state.checksum) as u64) { return fail(state,call.borrow(),Error::Checksum); }
            if ((state.field >> 32) != state.member_size as u64) { return fail(state,call.borrow(),Error::SizeMismatch); }
            state.completed_members += 1; state.phase = BETWEEN_MEMBERS;
        }
        if (state.phase == AWAIT_END) {
            if (call.read < input.length) { return fail(state,call.borrow(),Error::TrailingData); }
            if (final_input) { state.phase = FINISHED; return progress(call.borrow(),ext::inflate::Status::Done); }
            return progress(call.borrow(),ext::inflate::Status::NeedInput);
        }
        if (state.phase == BETWEEN_MEMBERS) {
            if (call.read == input.length) {
                if (final_input) { state.phase = FINISHED; return progress(call.borrow(),ext::inflate::Status::Done); }
                return progress(call.borrow(),ext::inflate::Status::NeedInput);
            }
            if (byte(input,call.read) != 31) { return fail(state,call.borrow(),Error::TrailingData); }
            let value: u8 = take_byte(state,call.borrow());
            state.header_crc = core::crc32::update_byte(core::crc32::INITIAL,value);
            state.field = value as u64; state.field_count = 1; state.phase = GZIP_PREFIX;
        }
    }
    return progress(call.borrow(),ext::inflate::Status::Done);
}

pub impl Decoder {
    pub fn borrow(&self) -> &Decoder { return self; }
    pub fn step(&self, input: core::slice::View<u8>, output: core::slice::View<u8>, final_input: bool) -> core::result::Result<ext::inflate::Step,DecodeFailure> { return run(self,input,output,final_input); }
    pub fn total_read(&self) -> u64 { return self.read_total; }
    pub fn total_written(&self) -> u64 { return self.written_total; }
    pub fn members(&self) -> i32 { return self.completed_members; }
    pub fn is_done(&self) -> bool { return self.phase == FINISHED; }
    pub fn is_failed(&self) -> bool { return self.phase == FAILED; }
    pub fn reset(&self, format: Format, limits: Limits) -> core::result::Result<bool,Error> {
        if (!valid_limits(limits)) { return core::result::Err(Error::Bounds); }
        let reset: core::result::Result<bool,ext::inflate::Error> = self.raw.reset(32768);
        if (core::result::is_err(reset)) { return core::result::Err(Error::Bounds); }
        self.kind = format_kind(format); self.limits = limits; self.phase = initial_phase(self.kind); self.failure = Error::Bounds;
        self.read_total = 0; self.written_total = 0; self.completed_members = 0;
        self.checksum = 0; self.member_size = 0; self.header_crc = core::crc32::INITIAL;
        self.field = 0; self.field_count = 0; self.flags = 0; self.remaining = 0;
        return core::result::Ok(true);
    }
}

// Private owners are fixed history, fixed tables and geometric output. The
// decoder survives output growth and no transient output view crosses resize.
// Metadata/input admission precedes allocation; workspace allocation can fail
// before later format validation. Every exit releases both private workspaces.
pub fn decode(input: core::slice::View<u8>, format: Format, limits: Limits) -> core::result::Result<alloc::vec::Vec<u8>,Error> {
    if (!valid(input) || !valid_limits(limits)) { return core::result::Err(Error::Bounds); }
    if (input.length > limits.max_input) { return core::result::Err(Error::InputLimit); }
    let history: alloc::vec::Vec<u8> = alloc::vec::new();
    let history_ready: core::result::Result<i32,Error> = resize(history.borrow(),32768);
    if (core::result::is_err(history_ready)) { history.destroy(); return core::result::Err(core::result::unwrap_err(history_ready)); }
    let workspace: alloc::vec::Vec<i32> = alloc::vec::new();
    let workspace_ready: core::result::Result<i32,alloc::vec::Error> = workspace.try_resize(ext::inflate::workspace_len(),0);
    if (core::result::is_err(workspace_ready)) { workspace.destroy(); history.destroy(); return core::result::Err(vector_error(core::result::unwrap_err(workspace_ready))); }
    let state: Decoder = core::result::unwrap(decoder(history.as_view(),workspace.as_view(),format,limits));
    let output: alloc::vec::Vec<u8> = alloc::vec::new();
    let read: i32 = 0; let written: i32 = 0;
    while (true) {
        let decoded: core::result::Result<ext::inflate::Step,DecodeFailure> = state.step(part(input,read,input.length),part(output.as_view(),written,output.len()),true);
        if (core::result::is_err(decoded)) {
            let error: Error = core::result::unwrap_err(decoded).error;
            output.destroy(); workspace.destroy(); history.destroy(); return core::result::Err(error);
        }
        let step: ext::inflate::Step = core::result::unwrap(decoded); read += step.read; written += step.written;
        let done: bool = match (step.status) { ext::inflate::Status::Done -> true, _ -> false };
        if (done) { output.truncate(written); workspace.destroy(); history.destroy(); return core::result::Ok(output); }
        let need_input: bool = match (step.status) { ext::inflate::Status::NeedInput -> true, _ -> false };
        if (need_input) { output.destroy(); workspace.destroy(); history.destroy(); return core::result::Err(Error::Truncated); }
        let capacity: i32 = output.len();
        if (capacity == 0) { capacity = 256; if (capacity > limits.max_output) { capacity = limits.max_output; } }
        else { if (capacity > limits.max_output/2) { capacity = limits.max_output; } else { capacity *= 2; } }
        if (capacity <= output.len()) { output.destroy(); workspace.destroy(); history.destroy(); return core::result::Err(Error::OutputLimit); }
        let grown: core::result::Result<i32,Error> = resize(output.borrow(),capacity);
        if (core::result::is_err(grown)) { output.destroy(); workspace.destroy(); history.destroy(); return core::result::Err(core::result::unwrap_err(grown)); }
    }
    return core::result::Err(Error::Truncated);
}
