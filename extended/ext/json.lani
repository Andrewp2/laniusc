// Owned JSON documents. RFC 8259 grammar with Unicode-scalar strings.
// One owner frees the entire document; NodeId values borrow that owner.
module ext::json;
import alloc::io;
import alloc::string;
import core::decimal;
import core::io;
import core::option;
import core::result;
import core::text;
import core::utf8;
import alloc::vec;

pub type NodeId = i32;
pub enum Kind { Null, Boolean, Number, Text, Array, Object }
pub enum ErrorKind {
    UnexpectedEnd, UnexpectedByte, InvalidEscape, InvalidSurrogate,
    InvalidNumber, TrailingInput, DepthLimit, NodeLimit, StringLimit,
    NumberLimit, OutputLimit, DuplicateKey, AllocationFailed, Bounds,
    WrongKind, InvalidPlacement, InvalidOptions, NoRoot, NotInteger, NumberOutOfRange,
}
pub struct Error { kind: ErrorKind, offset: i32 }
pub struct Options {
    max_depth: i32, max_nodes: i32, max_string_bytes: i32,
    max_number_bytes: i32, max_output_bytes: i32, reject_duplicate_keys: bool,
}
pub enum At { Root, Element(NodeId), Member(NodeId, alloc::string::String) }

pub fn default_options() -> Options {
    return Options {
        max_depth: 128, max_nodes: 1000000, max_string_bytes: 16777216,
        max_number_bytes: 1048576, max_output_bytes: 67108864, reject_duplicate_keys: false,
    };
}

fn error(kind: ErrorKind, offset: i32) -> Error { return Error { kind: kind, offset: offset }; }
fn tag(kind: Kind) -> i32 {
    let value: i32 = match (kind) { Null -> 0, Boolean -> 1, Number -> 2, Text -> 3, Array -> 4, Object -> 5 };
    return value;
}
fn valid_options(options: Options) -> bool {
    return options.max_depth >= 0 && options.max_nodes >= 0 && options.max_string_bytes >= 0 &&
        options.max_number_bytes >= 0 && options.max_output_bytes >= 0;
}

// Exact conversion of an already validated JSON number. Normalize its decimal
// scale and trailing zeros before accumulating at most twenty significant
// digits. No floating-point rounding, exponent-sized loop or allocation.
fn integer_magnitude(text: core::text::Text, limit: u64) -> core::result::Result<u64, Error> {
    let start: i32 = 0; if (core::option::unwrap(text.byte_at(0)) == 45) { start = 1; }
    let end: i32 = start; let digits: i32 = 0; let fraction: i32 = 0; let fractional: bool = false;
    let first: i32 = -1; let last: i32 = -1; let first_byte: i32 = -1; let last_byte: i32 = -1;
    while (end < text.byte_len()) {
        let byte: u8 = core::option::unwrap(text.byte_at(end)); if (byte == 101 || byte == 69) { break; }
        if (byte == 46) { fractional = true; }
        else {
            if (byte != 48) { if (first < 0) { first = digits; first_byte = end; } last = digits; last_byte = end; }
            digits += 1; if (fractional) { fraction += 1; }
        }
        end += 1;
    }
    if (first < 0) { return core::result::Ok(0); }
    let exponent: i64 = 0; let negative_exponent: bool = false; let index: i32 = end;
    if (index < text.byte_len()) { index += 1; }
    if (index < text.byte_len()) {
        let sign: u8 = core::option::unwrap(text.byte_at(index));
        if (sign == 43 || sign == 45) { negative_exponent = sign == 45; index += 1; }
    }
    // This cap exceeds every possible i32 digit count by more than 20, so
    // saturating a larger exponent cannot change integral/range classification.
    let cap: i64 = 4294967296;
    while (index < text.byte_len()) {
        if (exponent < cap) { exponent = exponent * 10 + ((core::option::unwrap(text.byte_at(index)) - 48) as i64); if (exponent > cap) { exponent = cap; } }
        index += 1;
    }
    if (negative_exponent) { exponent = 0 - exponent; }
    let scale: i64 = exponent - (fraction as i64) + ((digits - last - 1) as i64);
    if (scale < 0) { return core::result::Err(error(ErrorKind::NotInteger, -1)); }
    if (((last - first + 1) as i64) + scale > 20) { return core::result::Err(error(ErrorKind::NumberOutOfRange, -1)); }
    let result: u64 = 0; index = first_byte;
    while (index <= last_byte) {
        let byte: u8 = core::option::unwrap(text.byte_at(index));
        if (byte != 46) {
            let digit: u64 = (byte - 48) as u64;
            if (result > limit / 10 || (result == limit / 10 && digit > limit % 10)) { return core::result::Err(error(ErrorKind::NumberOutOfRange, -1)); }
            result = result * 10 + digit;
        }
        index += 1;
    }
    while (scale > 0) { if (result > limit / 10) { return core::result::Err(error(ErrorKind::NumberOutOfRange, -1)); } result *= 10; scale -= 1; }
    return core::result::Ok(result);
}

struct Node {
    kind: Kind, flag: bool, text: alloc::string::String, key: alloc::string::String,
    parent: NodeId, first: NodeId, last: NodeId, next: NodeId, count: i32, depth: i32,
}
pub struct Document { nodes: alloc::vec::Vec<Node>, options: Options }

pub fn new() -> Document {
    let nodes: alloc::vec::Vec<Node> = alloc::vec::new();
    return Document { nodes: nodes, options: default_options() };
}
pub fn with_options(options: Options) -> core::result::Result<Document, Error> {
    if (!valid_options(options)) { return core::result::Err(error(ErrorKind::InvalidOptions, -1)); }
    let nodes: alloc::vec::Vec<Node> = alloc::vec::new();
    return core::result::Ok(Document { nodes: nodes, options: options });
}

struct Destination { parent: NodeId, root: bool, member: bool, key: alloc::string::String }
fn destination(at: At) -> Destination {
    let empty: alloc::string::String = alloc::string::new();
    let result: Destination = match (at) {
        Root -> Destination { parent: -1, root: true, member: false, key: empty },
        Element(parent) -> Destination { parent: parent, root: false, member: false, key: empty },
        Member(parent, key) -> Destination { parent: parent, root: false, member: true, key: key },
    };
    return result;
}

pub impl Document {
    // Pass the actual owner to a helper that may add nodes and grow storage.
    pub fn borrow(&self) -> &Document { return self; }
    pub fn node_count(&self) -> i32 { return self.nodes.len(); }
    pub fn root(&self) -> core::option::Option<NodeId> {
        if (self.nodes.is_empty()) { return core::option::None(); }
        return core::option::Some(0);
    }
    fn valid(&self, id: NodeId) -> bool { return id >= 0 && id < self.nodes.len(); }
    pub fn kind(&self, id: NodeId) -> core::result::Result<Kind, Error> {
        if (!self.valid(id)) { return core::result::Err(error(ErrorKind::Bounds, -1)); }
        let node: Node = self.nodes.at(id);
        return core::result::Ok(node.kind);
    }
    pub fn child_count(&self, id: NodeId) -> core::result::Result<i32, Error> {
        if (!self.valid(id)) { return core::result::Err(error(ErrorKind::Bounds, -1)); }
        let node: Node = self.nodes.at(id);
        if (tag(node.kind) < 4) { return core::result::Err(error(ErrorKind::WrongKind, -1)); }
        return core::result::Ok(node.count);
    }
    pub fn first_child(&self, id: NodeId) -> core::result::Result<core::option::Option<NodeId>, Error> {
        if (!self.valid(id)) { return core::result::Err(error(ErrorKind::Bounds, -1)); }
        let node: Node = self.nodes.at(id);
        if (tag(node.kind) < 4) { return core::result::Err(error(ErrorKind::WrongKind, -1)); }
        if (node.first < 0) { return core::result::Ok(core::option::None()); }
        return core::result::Ok(core::option::Some(node.first));
    }
    pub fn next_sibling(&self, id: NodeId) -> core::result::Result<core::option::Option<NodeId>, Error> {
        if (!self.valid(id)) { return core::result::Err(error(ErrorKind::Bounds, -1)); }
        let node: Node = self.nodes.at(id);
        if (node.next < 0) { return core::result::Ok(core::option::None()); }
        return core::result::Ok(core::option::Some(node.next));
    }
    pub fn element(&self, id: NodeId, index: i32) -> core::result::Result<core::option::Option<NodeId>, Error> {
        if (!self.valid(id) || index < 0) { return core::result::Err(error(ErrorKind::Bounds, -1)); }
        let node: Node = self.nodes.at(id);
        if (tag(node.kind) != 4) { return core::result::Err(error(ErrorKind::WrongKind, -1)); }
        if (index >= node.count) { return core::result::Ok(core::option::None()); }
        let child: NodeId = node.first;
        let ordinal: i32 = 0;
        while (ordinal < index) { let current: Node = self.nodes.at(child); child = current.next; ordinal += 1; }
        return core::result::Ok(core::option::Some(child));
    }
    // Last matching member wins for lookup; ordered traversal retains all keys.
    pub fn member(&self, id: NodeId, key: alloc::string::String) -> core::result::Result<core::option::Option<NodeId>, Error> {
        return self.member_text(id, key.as_text());
    }
    pub fn member_text(&self, id: NodeId, key: core::text::Text) -> core::result::Result<core::option::Option<NodeId>, Error> {
        if (!self.valid(id)) { return core::result::Err(error(ErrorKind::Bounds, -1)); }
        let node: Node = self.nodes.at(id);
        if (tag(node.kind) != 5) { return core::result::Err(error(ErrorKind::WrongKind, -1)); }
        let found: NodeId = -1;
        let child: NodeId = node.first;
        while (child >= 0) {
            let current: Node = self.nodes.at(child);
            let name: core::text::Text = current.key.as_text();
            if (name.equals(key)) { found = child; }
            child = current.next;
        }
        if (found < 0) { return core::result::Ok(core::option::None()); }
        return core::result::Ok(core::option::Some(found));
    }
    pub fn boolean(&self, id: NodeId) -> core::result::Result<bool, Error> {
        if (!self.valid(id)) { return core::result::Err(error(ErrorKind::Bounds, -1)); }
        let node: Node = self.nodes.at(id);
        if (tag(node.kind) != 1) { return core::result::Err(error(ErrorKind::WrongKind, -1)); }
        return core::result::Ok(node.flag);
    }
    // Borrowed text remains valid across document appends, until destruction.
    // Do not mutate its backing storage through the currently writable view.
    fn borrowed_text(&self, id: NodeId, wanted: i32) -> core::result::Result<core::text::Text, Error> {
        if (!self.valid(id)) { return core::result::Err(error(ErrorKind::Bounds, -1)); }
        let node: Node = self.nodes.at(id);
        if (tag(node.kind) != wanted) { return core::result::Err(error(ErrorKind::WrongKind, -1)); }
        return core::result::Ok(node.text.as_text());
    }
    pub fn string_view(&self, id: NodeId) -> core::result::Result<core::text::Text, Error> { return self.borrowed_text(id, 3); }
    pub fn number_view(&self, id: NodeId) -> core::result::Result<core::text::Text, Error> { return self.borrowed_text(id, 2); }
    pub fn key_view(&self, id: NodeId) -> core::result::Result<core::text::Text, Error> {
        if (!self.valid(id)) { return core::result::Err(error(ErrorKind::Bounds, -1)); }
        let node: Node = self.nodes.at(id);
        if (node.parent < 0) { return core::result::Err(error(ErrorKind::WrongKind, -1)); }
        let parent: Node = self.nodes.at(node.parent);
        if (tag(parent.kind) != 5) { return core::result::Err(error(ErrorKind::WrongKind, -1)); }
        return core::result::Ok(node.key.as_text());
    }
    pub fn integer_u64(&self, id: NodeId) -> core::result::Result<u64, Error> {
        let viewed: core::result::Result<core::text::Text, Error> = self.number_view(id);
        if (core::result::is_err(viewed)) { return core::result::Err(core::result::unwrap_err(viewed)); }
        let text: core::text::Text = core::result::unwrap(viewed); let limit: u64 = 18446744073709551615;
        let converted: core::result::Result<u64, Error> = integer_magnitude(text, limit);
        if (core::result::is_err(converted)) { return converted; }
        let value: u64 = core::result::unwrap(converted);
        if (value != 0 && core::option::unwrap(text.byte_at(0)) == 45) { return core::result::Err(error(ErrorKind::NumberOutOfRange, -1)); }
        return core::result::Ok(value);
    }
    pub fn integer_i64(&self, id: NodeId) -> core::result::Result<i64, Error> {
        let viewed: core::result::Result<core::text::Text, Error> = self.number_view(id);
        if (core::result::is_err(viewed)) { return core::result::Err(core::result::unwrap_err(viewed)); }
        let text: core::text::Text = core::result::unwrap(viewed); let negative: bool = core::option::unwrap(text.byte_at(0)) == 45;
        let limit: u64 = 9223372036854775807; if (negative) { limit += 1; }
        let converted: core::result::Result<u64, Error> = integer_magnitude(text, limit);
        if (core::result::is_err(converted)) { return core::result::Err(core::result::unwrap_err(converted)); }
        let value: u64 = core::result::unwrap(converted);
        if (negative) { if (value == limit) { let minimum: i64 = -9223372036854775808; return core::result::Ok(minimum); } return core::result::Ok(0 - (value as i64)); }
        return core::result::Ok(value as i64);
    }
    fn copied_text(&self, id: NodeId, wanted: i32) -> core::result::Result<alloc::string::String, Error> {
        if (!self.valid(id)) { return core::result::Err(error(ErrorKind::Bounds, -1)); }
        let node: Node = self.nodes.at(id);
        if (tag(node.kind) != wanted) { return core::result::Err(error(ErrorKind::WrongKind, -1)); }
        let cloned: core::result::Result<alloc::string::String, alloc::string::Error> = node.text.try_clone();
        if (core::result::is_err(cloned)) { return core::result::Err(error(ErrorKind::AllocationFailed, -1)); }
        return core::result::Ok(core::result::unwrap(cloned));
    }
    pub fn copy_string(&self, id: NodeId) -> core::result::Result<alloc::string::String, Error> { return self.copied_text(id, 3); }
    pub fn copy_number(&self, id: NodeId) -> core::result::Result<alloc::string::String, Error> { return self.copied_text(id, 2); }
    pub fn copy_key(&self, id: NodeId) -> core::result::Result<alloc::string::String, Error> {
        if (!self.valid(id)) { return core::result::Err(error(ErrorKind::Bounds, -1)); }
        let node: Node = self.nodes.at(id);
        if (node.parent < 0) { return core::result::Err(error(ErrorKind::WrongKind, -1)); }
        let parent: Node = self.nodes.at(node.parent);
        if (tag(parent.kind) != 5) { return core::result::Err(error(ErrorKind::WrongKind, -1)); }
        let cloned: core::result::Result<alloc::string::String, alloc::string::Error> = node.key.try_clone();
        if (core::result::is_err(cloned)) { return core::result::Err(error(ErrorKind::AllocationFailed, -1)); }
        return core::result::Ok(core::result::unwrap(cloned));
    }

    fn validate_destination(&self, at: Destination, kind: Kind, offset: i32) -> core::result::Result<i32, Error> {
        let depth: i32 = 0;
        if (at.root) {
            if (at.member || !self.nodes.is_empty()) { return core::result::Err(error(ErrorKind::InvalidPlacement, offset)); }
        } else {
            if (!self.valid(at.parent)) { return core::result::Err(error(ErrorKind::Bounds, offset)); }
            let parent: Node = self.nodes.at(at.parent);
            if (at.member) {
                if (tag(parent.kind) != 5) { return core::result::Err(error(ErrorKind::InvalidPlacement, offset)); }
                if (at.key.byte_len() > self.options.max_string_bytes) { return core::result::Err(error(ErrorKind::StringLimit, offset)); }
                if (self.options.reject_duplicate_keys) {
                    let found: core::result::Result<core::option::Option<NodeId>, Error> = self.member(at.parent, at.key);
                    if (core::option::is_some(core::result::unwrap(found))) { return core::result::Err(error(ErrorKind::DuplicateKey, offset)); }
                }
            } else {
                if (tag(parent.kind) != 4) { return core::result::Err(error(ErrorKind::InvalidPlacement, offset)); }
            }
            depth = parent.depth;
        }
        if (tag(kind) >= 4) {
            if (depth >= self.options.max_depth) { return core::result::Err(error(ErrorKind::DepthLimit, offset)); }
            depth += 1;
        }
        if (self.nodes.len() >= self.options.max_nodes) { return core::result::Err(error(ErrorKind::NodeLimit, offset)); }
        return core::result::Ok(depth);
    }

    // Consumes key/text on both success and failure. Existing nodes survive.
    fn insert_owned(&self, at: Destination, kind: Kind, flag: bool, text: alloc::string::String, offset: i32)
        -> core::result::Result<NodeId, Error> {
        let checked: core::result::Result<i32, Error> = self.validate_destination(at, kind, offset);
        if (core::result::is_err(checked)) {
            at.key.destroy(); text.destroy();
            return core::result::Err(core::result::unwrap_err(checked));
        }
        let id: NodeId = self.nodes.len();
        let node: Node = Node {
            kind: kind, flag: flag, text: text, key: at.key, parent: at.parent,
            first: -1, last: -1, next: -1, count: 0, depth: core::result::unwrap(checked),
        };
        if (core::result::is_err(self.nodes.try_push(node))) {
            at.key.destroy(); text.destroy();
            return core::result::Err(error(ErrorKind::AllocationFailed, offset));
        }
        if (at.parent >= 0) {
            let parent: Node = self.nodes.at(at.parent);
            if (parent.last >= 0) {
                let last: Node = self.nodes.at(parent.last);
                last.next = id;
                core::result::unwrap(self.nodes.set(parent.last, last));
            } else { parent.first = id; }
            parent.last = id;
            parent.count += 1;
            core::result::unwrap(self.nodes.set(at.parent, parent));
        }
        return core::result::Ok(id);
    }

    fn insert_copy(&self, placement: At, kind: Kind, flag: bool, text: alloc::string::String)
        -> core::result::Result<NodeId, Error> {
        let at: Destination = destination(placement);
        let checked: core::result::Result<i32, Error> = self.validate_destination(at, kind, -1);
        if (core::result::is_err(checked)) { return core::result::Err(core::result::unwrap_err(checked)); }
        let key: core::result::Result<alloc::string::String, alloc::string::Error> = at.key.try_clone();
        if (core::result::is_err(key)) { return core::result::Err(error(ErrorKind::AllocationFailed, -1)); }
        let key_copy: alloc::string::String = core::result::unwrap(key);
        let value: core::result::Result<alloc::string::String, alloc::string::Error> = text.try_clone();
        if (core::result::is_err(value)) { key_copy.destroy(); return core::result::Err(error(ErrorKind::AllocationFailed, -1)); }
        let owned: Destination = Destination { parent: at.parent, root: at.root, member: at.member, key: key_copy };
        return self.insert_owned(owned, kind, flag, core::result::unwrap(value), -1);
    }
    pub fn add_null(&self, at: At) -> core::result::Result<NodeId, Error> { return self.insert_copy(at, Kind::Null, false, alloc::string::new()); }
    pub fn add_bool(&self, at: At, value: bool) -> core::result::Result<NodeId, Error> { return self.insert_copy(at, Kind::Boolean, value, alloc::string::new()); }
    pub fn add_array(&self, at: At) -> core::result::Result<NodeId, Error> { return self.insert_copy(at, Kind::Array, false, alloc::string::new()); }
    pub fn add_object(&self, at: At) -> core::result::Result<NodeId, Error> { return self.insert_copy(at, Kind::Object, false, alloc::string::new()); }
    pub fn add_string(&self, at: At, value: alloc::string::String) -> core::result::Result<NodeId, Error> {
        if (value.byte_len() > self.options.max_string_bytes) { return core::result::Err(error(ErrorKind::StringLimit, -1)); }
        return self.insert_copy(at, Kind::Text, false, value);
    }
    pub fn add_number(&self, at: At, value: alloc::string::String) -> core::result::Result<NodeId, Error> {
        if (value.byte_len() > self.options.max_number_bytes) { return core::result::Err(error(ErrorKind::NumberLimit, -1)); }
        if (value.byte_len() == 0 || number_end(value.as_bytes(), value.byte_len(), 0) != value.byte_len()) {
            return core::result::Err(error(ErrorKind::InvalidNumber, -1));
        }
        return self.insert_copy(at, Kind::Number, false, value);
    }
    pub fn add_i32(&self, at: At, value: i32) -> core::result::Result<NodeId, Error> {
        let text: alloc::string::String = alloc::string::new();
        let length: u32 = core::decimal::len_i32(value);
        let index: u32 = 0;
        while (index < length) {
            let byte: u8 = core::decimal::byte_at_or_i32(value, index, 0);
            if (core::result::is_err(text.try_push_scalar(byte as u32))) { text.destroy(); return core::result::Err(error(ErrorKind::AllocationFailed, -1)); }
            index += 1;
        }
        let added: core::result::Result<NodeId, Error> = self.add_number(at, text);
        text.destroy();
        return added;
    }
    pub fn destroy(&self) {
        let index: i32 = 0;
        while (index < self.nodes.len()) {
            let node: Node = self.nodes.at(index);
            node.key.destroy(); node.text.destroy(); index += 1;
        }
        self.nodes.destroy();
        self.nodes = alloc::vec::new();
    }
}

fn digit(byte: u8) -> bool { return byte >= 48 && byte <= 57; }
fn space(byte: u8) -> bool { return byte == 32 || byte == 9 || byte == 10 || byte == 13; }
fn delimiter(byte: u8) -> bool { return space(byte) || byte == 44 || byte == 93 || byte == 125; }
// Returns token end or -1. Does not accept leading/trailing whitespace.
fn number_end(bytes: [u8], length: i32, start: i32) -> i32 {
    let index: i32 = start;
    if (index >= length) { return -1; }
    if (bytes[index] == 45) { index += 1; }
    if (index >= length) { return -1; }
    if (bytes[index] == 48) {
        index += 1;
        if (index < length && digit(bytes[index])) { return -1; }
    } else {
        if (bytes[index] < 49 || bytes[index] > 57) { return -1; }
        while (index < length && digit(bytes[index])) { index += 1; }
    }
    if (index < length && bytes[index] == 46) {
        index += 1;
        let first: i32 = index;
        while (index < length && digit(bytes[index])) { index += 1; }
        if (index == first) { return -1; }
    }
    if (index < length && (bytes[index] == 101 || bytes[index] == 69)) {
        index += 1;
        if (index < length && (bytes[index] == 43 || bytes[index] == 45)) { index += 1; }
        let first: i32 = index;
        while (index < length && digit(bytes[index])) { index += 1; }
        if (index == first) { return -1; }
    }
    if (index < length && !delimiter(bytes[index])) { return -1; }
    return index;
}

struct Frame { node: NodeId, phase: i32 }
struct Parser {
    input: alloc::string::String, document: Document, frames: alloc::vec::Vec<Frame>,
    position: i32, failure: Error,
}

fn failed_string(text: alloc::string::String, kind: ErrorKind, offset: i32)
    -> core::result::Result<alloc::string::String, Error> {
    text.destroy();
    return core::result::Err(error(kind, offset));
}
fn hex(byte: u8) -> i32 {
    if (byte >= 48 && byte <= 57) { return (byte as i32) - 48; }
    if (byte >= 65 && byte <= 70) { return (byte as i32) - 55; }
    if (byte >= 97 && byte <= 102) { return (byte as i32) - 87; }
    return -1;
}

impl Parser {
    fn fail(&self, kind: ErrorKind, offset: i32) -> bool { self.failure = error(kind, offset); return false; }
    fn whitespace(&self) {
        let bytes: [u8] = self.input.as_bytes();
        while (self.position < self.input.byte_len() && space(bytes[self.position])) { self.position += 1; }
    }
    fn four_hex(&self) -> i32 {
        let bytes: [u8] = self.input.as_bytes();
        let value: i32 = 0;
        let index: i32 = 0;
        while (index < 4) {
            if (self.position >= self.input.byte_len()) { self.fail(ErrorKind::UnexpectedEnd, self.position); return -1; }
            let digit: i32 = hex(bytes[self.position]);
            if (digit < 0) { self.fail(ErrorKind::InvalidEscape, self.position); return -1; }
            value = value * 16 + digit;
            self.position += 1;
            index += 1;
        }
        return value;
    }
    // Called at an opening quote. Decodes escapes into an owned scalar string.
    fn quoted(&self) -> core::result::Result<alloc::string::String, Error> {
        let bytes: [u8] = self.input.as_bytes();
        let length: i32 = self.input.byte_len();
        let text: alloc::string::String = alloc::string::new();
        self.position += 1;
        while (self.position < length) {
            let start: i32 = self.position;
            let byte: u8 = bytes[start];
            if (byte == 34) { self.position += 1; return core::result::Ok(text); }
            if (byte < 32) { return failed_string(text, ErrorKind::UnexpectedByte, start); }
            let scalar: u32 = 0;
            if (byte == 92) {
                self.position += 1;
                if (self.position >= length) { return failed_string(text, ErrorKind::UnexpectedEnd, length); }
                let escaped: u8 = bytes[self.position];
                self.position += 1;
                if (escaped == 117) {
                    let first: i32 = self.four_hex();
                    if (first < 0) { text.destroy(); return core::result::Err(self.failure); }
                    scalar = first as u32;
                    if (first >= 55296 && first <= 56319) {
                        if (length - self.position < 6 || bytes[self.position] != 92 || bytes[self.position + 1] != 117) {
                            return failed_string(text, ErrorKind::InvalidSurrogate, start);
                        }
                        self.position += 2;
                        let second: i32 = self.four_hex();
                        if (second < 0) { text.destroy(); return core::result::Err(self.failure); }
                        if (second < 56320 || second > 57343) { return failed_string(text, ErrorKind::InvalidSurrogate, start); }
                        scalar = (65536 + (first - 55296) * 1024 + second - 56320) as u32;
                    } else {
                        if (first >= 56320 && first <= 57343) { return failed_string(text, ErrorKind::InvalidSurrogate, start); }
                    }
                } else {
                    scalar = 4294967295;
                    if (escaped == 34 || escaped == 92 || escaped == 47) { scalar = escaped as u32; }
                    if (escaped == 98) { scalar = 8; }
                    if (escaped == 102) { scalar = 12; }
                    if (escaped == 110) { scalar = 10; }
                    if (escaped == 114) { scalar = 13; }
                    if (escaped == 116) { scalar = 9; }
                    if (scalar == 4294967295) { return failed_string(text, ErrorKind::InvalidEscape, self.position - 1); }
                }
            } else {
                scalar = core::option::unwrap_or(self.input.scalar_at_byte(self.position), 4294967295);
                if (scalar == 4294967295) { return failed_string(text, ErrorKind::UnexpectedByte, self.position); }
                self.position += core::utf8::encoded_len_or(scalar, 0) as i32;
            }
            let width: i32 = core::utf8::encoded_len_or(scalar, 0) as i32;
            if (width > self.document.options.max_string_bytes - text.byte_len()) {
                return failed_string(text, ErrorKind::StringLimit, start);
            }
            if (core::result::is_err(text.try_push_scalar(scalar))) { return failed_string(text, ErrorKind::AllocationFailed, start); }
        }
        return failed_string(text, ErrorKind::UnexpectedEnd, length);
    }
    fn literal(&self, expected: [u8], count: i32) -> bool {
        let bytes: [u8] = self.input.as_bytes();
        let index: i32 = 0;
        while (index < count) {
            if (self.position >= self.input.byte_len()) { return self.fail(ErrorKind::UnexpectedEnd, self.position); }
            if (bytes[self.position] != expected[index]) { return self.fail(ErrorKind::UnexpectedByte, self.position); }
            self.position += 1;
            index += 1;
        }
        return true;
    }
    // Consumes the pending key on every path. Containers push a frame;
    // neither parsing nor later destruction uses native call-stack recursion.
    fn value(&self, parent: NodeId, member: bool, key: alloc::string::String) -> bool {
        let start: i32 = self.position;
        if (start >= self.input.byte_len()) { key.destroy(); return self.fail(ErrorKind::UnexpectedEnd, start); }
        let bytes: [u8] = self.input.as_bytes();
        let first: u8 = bytes[start];
        let kind: Kind = Kind::Null;
        let flag: bool = false;
        let text: alloc::string::String = alloc::string::new();
        if (first == 34) {
            kind = Kind::Text;
            let decoded: core::result::Result<alloc::string::String, Error> = self.quoted();
            if (core::result::is_err(decoded)) { key.destroy(); self.failure = core::result::unwrap_err(decoded); return false; }
            text = core::result::unwrap(decoded);
        } else {
            if (first == 91 || first == 123) {
                kind = Kind::Array;
                if (first == 123) { kind = Kind::Object; }
                self.position += 1;
            } else {
                if (first == 110) {
                    let word: [u8; 4] = [110, 117, 108, 108];
                    if (!self.literal(word, 4)) { key.destroy(); return false; }
                } else {
                    if (first == 116 || first == 102) {
                        kind = Kind::Boolean;
                        flag = first == 116;
                        if (flag) {
                            let word: [u8; 4] = [116, 114, 117, 101];
                            if (!self.literal(word, 4)) { key.destroy(); return false; }
                        } else {
                            let word: [u8; 5] = [102, 97, 108, 115, 101];
                            if (!self.literal(word, 5)) { key.destroy(); return false; }
                        }
                    } else {
                        if (first != 45 && !digit(first)) { key.destroy(); return self.fail(ErrorKind::UnexpectedByte, start); }
                        let end: i32 = number_end(bytes, self.input.byte_len(), start);
                        if (end < 0) { key.destroy(); return self.fail(ErrorKind::InvalidNumber, start); }
                        if (end - start > self.document.options.max_number_bytes) { key.destroy(); return self.fail(ErrorKind::NumberLimit, start); }
                        let copied: core::result::Result<alloc::string::String, alloc::string::Error> = self.input.try_substring(start, end);
                        if (core::result::is_err(copied)) { key.destroy(); return self.fail(ErrorKind::AllocationFailed, start); }
                        text = core::result::unwrap(copied);
                        kind = Kind::Number;
                        self.position = end;
                    }
                }
            }
        }
        let at: Destination = Destination { parent: parent, root: parent == -1, member: member, key: key };
        let added: core::result::Result<NodeId, Error> = self.document.insert_owned(at, kind, flag, text, start);
        if (core::result::is_err(added)) { self.failure = core::result::unwrap_err(added); return false; }
        if (tag(kind) >= 4) {
            let frame: Frame = Frame { node: core::result::unwrap(added), phase: 0 };
            if (core::result::is_err(self.frames.try_push(frame))) { return self.fail(ErrorKind::AllocationFailed, start); }
        }
        return true;
    }
    fn run(&self) -> bool {
        self.whitespace();
        if (!self.value(-1, false, alloc::string::new())) { return false; }
        let bytes: [u8] = self.input.as_bytes();
        while (!self.frames.is_empty()) {
            self.whitespace();
            if (self.position >= self.input.byte_len()) { return self.fail(ErrorKind::UnexpectedEnd, self.position); }
            let top: i32 = self.frames.len() - 1;
            let frame: Frame = self.frames.at(top);
            let node: Node = self.document.nodes.at(frame.node);
            let object: bool = tag(node.kind) == 5;
            let closing: u8 = 93;
            if (object) { closing = 125; }
            let byte: u8 = bytes[self.position];
            if (byte == closing) {
                if (frame.phase == 2) { return self.fail(ErrorKind::UnexpectedByte, self.position); }
                self.frames.pop();
                self.position += 1;
                continue;
            }
            if (frame.phase == 1) {
                if (byte != 44) { return self.fail(ErrorKind::UnexpectedByte, self.position); }
                frame.phase = 2;
                core::result::unwrap(self.frames.set(top, frame));
                self.position += 1;
                continue;
            }
            let key: alloc::string::String = alloc::string::new();
            if (object) {
                if (byte != 34) { return self.fail(ErrorKind::UnexpectedByte, self.position); }
                let quoted: core::result::Result<alloc::string::String, Error> = self.quoted();
                if (core::result::is_err(quoted)) { self.failure = core::result::unwrap_err(quoted); return false; }
                key = core::result::unwrap(quoted);
                self.whitespace();
                if (self.position >= self.input.byte_len()) { key.destroy(); return self.fail(ErrorKind::UnexpectedEnd, self.position); }
                if (bytes[self.position] != 58) { key.destroy(); return self.fail(ErrorKind::UnexpectedByte, self.position); }
                self.position += 1;
                self.whitespace();
            }
            frame.phase = 1;
            core::result::unwrap(self.frames.set(top, frame));
            if (!self.value(frame.node, object, key)) { return false; }
        }
        self.whitespace();
        if (self.position != self.input.byte_len()) { return self.fail(ErrorKind::TrailingInput, self.position); }
        return true;
    }
}

pub fn parse(input: alloc::string::String, options: Options) -> core::result::Result<Document, Error> {
    let document: core::result::Result<Document, Error> = with_options(options);
    if (core::result::is_err(document)) { return core::result::Err(core::result::unwrap_err(document)); }
    let frames: alloc::vec::Vec<Frame> = alloc::vec::new();
    let parser: Parser = Parser {
        input: input, document: core::result::unwrap(document), frames: frames,
        position: 0, failure: error(ErrorKind::UnexpectedEnd, 0),
    };
    let complete: bool = parser.run();
    parser.frames.destroy();
    if (!complete) { parser.document.destroy(); return core::result::Err(parser.failure); }
    return core::result::Ok(parser.document);
}

// The same byte machine serves preflight and emission. Links supply the
// traversal stack: each first/next/parent edge is followed only a constant
// number of times. A byte or escape advances once; no prefix is rescanned.
const ENCODE_NODE: i32 = 0;
const ENCODE_KEY: i32 = 1;
const ENCODE_COLON: i32 = 2;
const ENCODE_VALUE: i32 = 3;
const ENCODE_TEXT: i32 = 4;
const ENCODE_NUMBER: i32 = 5;
const ENCODE_LITERAL: i32 = 6;
const ENCODE_CHILDREN: i32 = 7;
const ENCODE_AFTER: i32 = 8;
struct EncodingMachine {
    document: &Document, current: NodeId, phase: i32, offset: i32,
    escaped: u8, escape_offset: i32, escape_length: i32,
}
fn encoding_machine(document: &Document) -> EncodingMachine {
    return EncodingMachine {
        document: document, current: 0, phase: ENCODE_NODE, offset: 0,
        escaped: 0, escape_offset: 0, escape_length: 0,
    };
}
fn hex_digit(value: u8) -> u8 { if (value < 10) { return 48 + value; } return 87 + value; }
fn closing(kind: Kind) -> u8 { if (tag(kind) == 4) { return 93; } return 125; }
fn literal_byte(kind: Kind, flag: bool, offset: i32) -> u8 {
    if (tag(kind) == 0) { let word: [u8;4] = [110,117,108,108]; return word[offset]; }
    if (flag) { let word: [u8;4] = [116,114,117,101]; return word[offset]; }
    let word: [u8;5] = [102,97,108,115,101]; return word[offset];
}
impl EncodingMachine {
    // Only valid, immutable Documents enter this machine. It never acquires
    // cleanup authority over shallow Node/String descriptors read below.
    fn pull(&self) -> core::option::Option<u8> {
        while (self.current >= 0) {
            let node: Node = self.document.nodes.at(self.current);
            if (self.phase == ENCODE_NODE) {
                self.phase = ENCODE_VALUE;
                if (node.parent >= 0) {
                    let parent: Node = self.document.nodes.at(node.parent);
                    if (tag(parent.kind) == 5) {
                        self.phase = ENCODE_KEY; self.offset = 0;
                        self.escape_offset = 0; self.escape_length = 0;
                        return core::option::Some(34);
                    }
                }
                continue;
            }
            if (self.phase == ENCODE_KEY || self.phase == ENCODE_TEXT) {
                if (self.escape_offset < self.escape_length) {
                    let byte: u8 = self.escaped;
                    if (self.escape_length == 6) {
                        byte = 48;
                        if (self.escape_offset == 1) { byte = 117; }
                        if (self.escape_offset == 4) { byte = hex_digit(self.escaped / 16); }
                        if (self.escape_offset == 5) { byte = hex_digit(self.escaped % 16); }
                    }
                    self.escape_offset += 1;
                    return core::option::Some(byte);
                }
                let text: core::text::Text = node.text.as_text();
                if (self.phase == ENCODE_KEY) { text = node.key.as_text(); }
                if (self.offset == text.length) {
                    if (self.phase == ENCODE_KEY) { self.phase = ENCODE_COLON; }
                    else { self.phase = ENCODE_AFTER; }
                    return core::option::Some(34);
                }
                let byte: u8 = text.bytes[text.start + self.offset];
                self.offset += 1;
                if (byte == 34 || byte == 92 || byte < 32) {
                    self.escaped = byte; self.escape_offset = 1;
                    self.escape_length = 2;
                    if (byte < 32) { self.escape_length = 6; }
                    return core::option::Some(92);
                }
                // Valid UTF-8 can be copied bytewise; non-ASCII bytes cannot
                // equal any ASCII byte requiring JSON escaping.
                return core::option::Some(byte);
            }
            if (self.phase == ENCODE_COLON) {
                self.phase = ENCODE_VALUE; return core::option::Some(58);
            }
            if (self.phase == ENCODE_VALUE) {
                let kind: i32 = tag(node.kind);
                self.offset = 0;
                if (kind <= 1) { self.phase = ENCODE_LITERAL; continue; }
                if (kind == 2) { self.phase = ENCODE_NUMBER; continue; }
                if (kind == 3) {
                    self.phase = ENCODE_TEXT;
                    self.escape_offset = 0; self.escape_length = 0;
                    return core::option::Some(34);
                }
                self.phase = ENCODE_CHILDREN;
                if (kind == 4) { return core::option::Some(91); }
                return core::option::Some(123);
            }
            if (self.phase == ENCODE_NUMBER) {
                let text: core::text::Text = node.text.as_text();
                let byte: u8 = text.bytes[text.start + self.offset];
                self.offset += 1;
                if (self.offset == text.length) { self.phase = ENCODE_AFTER; }
                return core::option::Some(byte);
            }
            if (self.phase == ENCODE_LITERAL) {
                let length: i32 = 4;
                if (tag(node.kind) == 1 && !node.flag) { length = 5; }
                let byte: u8 = literal_byte(node.kind,node.flag,self.offset);
                self.offset += 1;
                if (self.offset == length) { self.phase = ENCODE_AFTER; }
                return core::option::Some(byte);
            }
            if (self.phase == ENCODE_CHILDREN) {
                if (node.first >= 0) {
                    self.current = node.first; self.phase = ENCODE_NODE; continue;
                }
                self.phase = ENCODE_AFTER;
                return core::option::Some(closing(node.kind));
            }
            // A completed child either advances to its next sibling or emits
            // one parent close. Deep unwinding never needs native recursion.
            if (node.next >= 0) {
                self.current = node.next; self.phase = ENCODE_NODE;
                return core::option::Some(44);
            }
            if (node.parent < 0) { self.current = -1; return core::option::None(); }
            self.current = node.parent;
            let parent: Node = self.document.nodes.at(self.current);
            self.phase = ENCODE_AFTER;
            return core::option::Some(closing(parent.kind));
        }
        return core::option::None();
    }
}

// A borrowed canonical byte reader. Copies fork position, including a partial
// UTF-8 sequence or escape, but share the same immutable live Document.
// Keep the actual Document owner, nodes, options and all text unchanged and
// stable until every cursor copy ends. This cursor owns and destroys nothing.
pub struct Encoding { machine: EncodingMachine, remaining_bytes: u64 }

pub impl Document {
    // Exact admitted output size. This is a CPU preflight, not a transport
    // call quota. Valid Document/String invariants are preconditions; no
    // physical-backing or forged/cyclic-tree validation is attempted.
    pub fn encoded_len(&self) -> core::result::Result<u64,Error> {
        if (self.nodes.is_empty()) { return core::result::Err(error(ErrorKind::NoRoot,-1)); }
        let machine: EncodingMachine = encoding_machine(self);
        let maximum: u64 = self.options.max_output_bytes as u64;
        let total: u64 = 0;
        while (true) {
            let byte: core::option::Option<u8> = machine.pull();
            if (byte.is_none()) { return core::result::Ok(total); }
            if (total == maximum) { return core::result::Err(error(ErrorKind::OutputLimit,-1)); }
            total += 1;
        }
        return core::result::Ok(total);
    }
    pub fn encoding(&self) -> core::result::Result<Encoding,Error> {
        let length: core::result::Result<u64,Error> = self.encoded_len();
        if (length.is_err()) { return core::result::Err(length.unwrap_err()); }
        return core::result::Ok(Encoding { machine: encoding_machine(self), remaining_bytes: length.unwrap() });
    }
}
pub impl Encoding {
    pub fn borrow(&self) -> &Encoding { return self; }
    pub fn remaining(&self) -> u64 { return self.remaining_bytes; }
}
pub impl core::io::Read for Encoding {
    // Destination must be backed and disjoint from this cursor and Document
    // storage. Logical range rejection and zero requests have no effects.
    pub fn read(&self, destination: [u8], offset: i32, count: i32) -> core::result::Result<i32,core::io::Error> {
        if (!core::io::valid_range(offset,count)) { return core::result::Err(core::io::Error::InvalidInput); }
        if (count == 0) { return core::result::Ok(0); }
        let wanted: i32 = count;
        if (self.remaining_bytes < count as u64) { wanted = self.remaining_bytes as i32; }
        let completed: i32 = 0;
        while (completed < wanted) {
            // Preflight and immutable backing establish an infallible exact
            // byte count. No Err can follow a destination write on this path.
            let byte: core::option::Option<u8> = self.machine.pull();
            destination[offset + completed] = byte.unwrap();
            completed += 1; self.remaining_bytes -= 1;
        }
        return core::result::Ok(completed);
    }
}

// Only allocation failure is reachable here for a valid admitted Encoding.
// Keep precise existing categories for collector errors where representable;
// unexpected internal metadata/I/O errors map to Bounds, never fake success.
fn encoding_collection_error(cause: alloc::io::ReadError) -> Error {
    let kind: ErrorKind = match (cause) {
        alloc::io::ReadError::InvalidLimits -> ErrorKind::InvalidOptions,
        alloc::io::ReadError::CallLimit -> ErrorKind::OutputLimit,
        alloc::io::ReadError::ByteLimit -> ErrorKind::OutputLimit,
        alloc::io::ReadError::Io(detail) -> match (detail) {
            core::io::Error::AllocationFailed -> ErrorKind::AllocationFailed,
            core::io::Error::LimitExceeded -> ErrorKind::OutputLimit,
            _ -> ErrorKind::Bounds
        },
        alloc::io::ReadError::Storage(detail) -> match (detail) {
            alloc::vec::Error::AllocationFailed -> ErrorKind::AllocationFailed,
            alloc::vec::Error::CapacityOverflow -> ErrorKind::OutputLimit,
            _ -> ErrorKind::Bounds
        },
        alloc::io::ReadError::Text(detail) -> match (detail) {
            alloc::string::Error::AllocationFailed -> ErrorKind::AllocationFailed,
            alloc::string::Error::CapacityOverflow -> ErrorKind::OutputLimit,
            alloc::string::Error::InvalidUtf8(at) -> ErrorKind::InvalidSurrogate,
            alloc::string::Error::InvalidScalar -> ErrorKind::InvalidSurrogate,
            _ -> ErrorKind::Bounds
        }
    };
    return error(kind,-1);
}

pub fn encode(document: Document) -> core::result::Result<alloc::string::String, Error> {
    let prepared: core::result::Result<Encoding,Error> = document.encoding();
    if (prepared.is_err()) { return core::result::Err(prepared.unwrap_err()); }
    let cursor: Encoding = prepared.unwrap();
    let length: u64 = cursor.remaining();
    // Exact fills require ceil(length/1024) positive reads and one EOF probe.
    // The configured i32 output cap bounds both this sum and the byte cast.
    let limits: alloc::io::ReadLimits = alloc::io::ReadLimits {
        max_bytes: length as i32, max_calls: (length + 1023) / 1024 + 1,
    };
    let collected: core::result::Result<alloc::string::String,alloc::io::ReadFailure> = alloc::io::read_to_string<Encoding>(cursor.borrow(),limits);
    if (collected.is_err()) {
        let failure: alloc::io::ReadFailure = collected.unwrap_err();
        let cause: Error = encoding_collection_error(failure.cause);
        failure.destroy();
        return core::result::Err(cause);
    }
    return core::result::Ok(collected.unwrap());
}
