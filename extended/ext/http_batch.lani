// Bounded single-thread HTTP scheduling over the canonical resumable client.
module ext::http_batch;
import alloc::vec;
import core::clone;
import core::io;
import core::mem;
import core::net;
import core::option;
import core::result;
import core::slice;
import core::time;
import ext::http_client;
import std::clock;
import std::poll;

pub struct Job { endpoint: core::net::SocketAddr, request: ext::http_client::Request }
// One actual driver owner. Errors from step/before_wait must release its
// protocol/transport owners before return; successful completion transfers one
// Response. abort releases the owner even when its returned E reports failure.
// Statistics remain readable after terminal calls; readiness/interest must
// agree, with before_wait Ok(false) leaving immediate work available to step.
pub trait Driver<E> {
    pub fn stats(&self) -> ext::http_client::Stats;
    pub fn interest(&self) -> ext::http_client::Interest;
    pub fn raw_handle(&self) -> core::option::Option<i32>;
    pub fn before_wait(&self) -> core::result::Result<bool,E>;
    pub fn step(&self, ready: ext::http_client::Readiness) -> core::result::Result<core::option::Option<ext::http_client::Response>,E>;
    pub fn abort(&self) -> core::result::Result<bool,E>;
}
// Jobs and error arguments are borrowed shallow descriptors. begin consumes
// and disarms the actual Prepared on every result; it never prepares a second
// request. Classification/stat queries do not consume or retain error owners.
pub trait Factory<J,D,E> {
    pub fn request(&self, job: J) -> ext::http_client::Request;
    pub fn begin(&self, prepared: &ext::http_client::Prepared, job: J) -> core::result::Result<D,E>;
    pub fn from_http_failure(&self, failure: ext::http_client::Failure) -> E;
    pub fn failure_stats(&self, error: E) -> ext::http_client::Stats;
    pub fn shared_failure(&self, error: E) -> core::option::Option<Cause>;
}
pub struct Limits { max_jobs: i32, concurrency: i32, max_pending_bytes: u64, max_wire_bytes: u64, max_body_bytes: u64, operations: u64, work: u64 }
pub struct Abort<E> { stats: ext::http_client::Stats, cleanup: core::option::Option<E> }
pub enum Outcome<E> { NotStarted, Complete(ext::http_client::Response), Failed(E), Aborted(Abort<E>), Discarded(ext::http_client::Stats), Taken }
pub struct Stats { jobs: i32, started: i32, complete: i32, failed: i32, aborted: i32, discarded: i32, peak_active: i32, operations: u64, polls: u64, io_calls: u64, work: u64, pending_bytes: u64, peak_pending_bytes: u64, wire_bytes: u64, body_bytes: u64 }
// One active owner; get borrows descriptors, take transfers and disarms them.
pub struct Report<E> { outcomes: alloc::vec::Vec<Outcome<E>>, stats: Stats }
pub enum Cause { Bounds, InvalidLimits, AllocationFailed, Timeout, Clock(std::clock::Error), Poll(std::poll::Error), OperationLimit, WorkLimit, WireLimit, BodyLimit, PendingLimit, Preparation, InvalidEngine }
pub struct Failure<E> { cause: Cause, report: Report<E> }
struct Pending { owner: ext::http_client::Prepared, bytes: u64 }
struct Slot<D> { ordinal: i32, owner: core::option::Option<D>, credit: u64, reported_work: u64, reported_io: u64, ready: ext::http_client::Readiness }
struct Run<D,E> { report: Report<E>, pending: alloc::vec::Vec<core::option::Option<Pending>>, slots: alloc::vec::Vec<Slot<D>>, requests: alloc::vec::Vec<std::poll::Request>, poll: std::poll::PollSet, limits: Limits, deadline: core::time::Deadline, last: core::option::Option<core::time::Instant>, next: i32, active: i32, reserved_work: u64, turn: i32 }
impl<D,E> Run<D,E> { fn borrow(&self) -> &Run<D,E> { return self; } }

pub const MAX_JOBS: i32 = 4096;
pub const MAX_CONCURRENCY: i32 = 64;
pub fn default_limits() -> Limits { return Limits { max_jobs: 64, concurrency: 4, max_pending_bytes: 67108864, max_wire_bytes: 67108864, max_body_bytes: 67108864, operations: 1048576, work: 4294967296 }; }
fn statistics(jobs: i32) -> Stats { return Stats { jobs: jobs, started: 0, complete: 0, failed: 0, aborted: 0, discarded: 0, peak_active: 0, operations: 0, polls: 0, io_calls: 0, work: 0, pending_bytes: 0, peak_pending_bytes: 0, wire_bytes: 0, body_bytes: 0 }; }
fn empty_report<E>(jobs: i32) -> Report<E> { return Report { outcomes: alloc::vec::new<Outcome<E>>(), stats: statistics(jobs) }; }
fn no_ready() -> ext::http_client::Readiness { return ext::http_client::Readiness { readable: false, writable: false, hangup: false, error: false }; }
fn empty_slot<D>() -> Slot<D> { return Slot { ordinal: -1, owner: core::option::None(), credit: 0, reported_work: 0, reported_io: 0, ready: no_ready() }; }
fn no_request() -> std::poll::Request { return std::poll::Request { handle: -1, events: 0 }; }
pub impl<E> Report<E> {
    pub fn borrow(&self) -> &Report<E> { return self; }
    pub fn len(&self) -> i32 { return self.outcomes.len(); }
    pub fn get(&self, index: i32) -> core::option::Option<Outcome<E>> { return self.outcomes.get(index); }
    pub fn take(&self, index: i32) -> core::option::Option<Outcome<E>> {
        if (index < 0 || index >= self.outcomes.len()) { return core::option::None(); }
        let value: Outcome<E> = self.outcomes.at(index);
        let taken: bool = match (value) { Outcome::Taken -> true, _ -> false };
        if (taken) { return core::option::None(); }
        let empty: Outcome<E> = Outcome::Taken;
        self.outcomes.set(index,empty).unwrap(); return core::option::Some(value);
    }
    pub fn destroy(&self) where E: core::clone::Destroy<E> {
        let index: i32 = 0;
        while (index < self.outcomes.len()) {
            let value: Outcome<E> = self.outcomes.at(index);
            let owned: core::option::Option<ext::http_client::Response> = match (value) { Outcome::Complete(response) -> core::option::Some(response), _ -> core::option::None() };
            if (owned.is_some()) { let response: ext::http_client::Response = owned.unwrap(); response.destroy(); }
            let error: core::option::Option<E> = match (value) { Outcome::Failed(failure) -> core::option::Some(failure), Outcome::Aborted(abort) -> abort.cleanup, _ -> core::option::None() };
            if (error.is_some()) { E::destroy_value(error.unwrap()); }
            index += 1;
        }
        self.outcomes.destroy();
    }
}
pub impl<E> Failure<E> { pub fn borrow(&self) -> &Failure<E> { return self; } pub fn destroy(&self) where E: core::clone::Destroy<E> { self.report.destroy(); } }
fn valid(limits: Limits) -> bool { return limits.max_jobs > 0 && limits.max_jobs <= MAX_JOBS && limits.concurrency > 0 && limits.concurrency <= MAX_CONCURRENCY && limits.concurrency <= limits.max_jobs; }
fn put<D,E>(run: &Run<D,E>, ordinal: i32, outcome: Outcome<E>) { run.report.outcomes.set(ordinal,outcome).unwrap(); }
fn put_slot<D,E>(run: &Run<D,E>, index: i32, value: Slot<D>) { run.slots.set(index,value).unwrap(); }
fn take_slot<D,E>(run: &Run<D,E>, index: i32) -> Slot<D> { return run.slots.set(index,empty_slot<D>()).unwrap(); }
fn spend<D,E>(run: &Run<D,E>, amount: u64) -> core::result::Result<bool,Cause> {
    if (amount > run.limits.operations - run.report.stats.operations) { return core::result::Err(Cause::OperationLimit); }
    run.report.stats.operations += amount; return core::result::Ok(true);
}
fn observe<D,E>(run: &Run<D,E>) -> core::result::Result<bool,Cause> {
    let paid: core::result::Result<bool,Cause> = spend(run,1); if (paid.is_err()) { return paid; }
    let read: core::result::Result<core::time::Instant,std::clock::Error> = std::clock::monotonic_now();
    if (read.is_err()) { return core::result::Err(Cause::Clock(read.unwrap_err())); }
    let now: core::time::Instant = read.unwrap();
    if (run.last.is_some() && now.compare(run.last.unwrap()) < 0) { return core::result::Err(Cause::Clock(std::clock::Error::ClockReversed)); }
    run.last = core::option::Some(now);
    if (run.deadline.is_expired(now)) { return core::result::Err(Cause::Timeout); }
    return core::result::Ok(true);
}
// Move newly charged work from reserved allowance to cumulative actual work.
// The same State crosses Prepared.begin, so only monotone deltas are counted.
fn account<D,E>(run: &Run<D,E>, slot: &Slot<D>, stats: ext::http_client::Stats) -> core::result::Result<bool,Cause> {
    if (stats.work < slot.reported_work || stats.io_calls < slot.reported_io) { return core::result::Err(Cause::InvalidEngine); }
    let delta: u64 = stats.work - slot.reported_work; let io: u64 = stats.io_calls - slot.reported_io;
    let maximum: u64 = 18446744073709551615;
    if (delta > slot.credit || delta > run.reserved_work || delta > run.limits.work - run.report.stats.work || io > maximum - run.report.stats.io_calls) { return core::result::Err(Cause::InvalidEngine); }
    slot.credit -= delta; run.reserved_work -= delta; run.report.stats.work += delta; run.report.stats.io_calls += io;
    slot.reported_work = stats.work; slot.reported_io = stats.io_calls; return core::result::Ok(true);
}
fn release_credit<D,E>(run: &Run<D,E>, slot: &Slot<D>) { run.reserved_work -= slot.credit; slot.credit = 0; }
fn shared_http_failure(failure: ext::http_client::Failure) -> core::option::Option<Cause> { return match (failure.cause) { ext::http_client::Cause::Timeout -> core::option::Some(Cause::Timeout), ext::http_client::Cause::Clock(error) -> core::option::Some(Cause::Clock(error)), _ -> core::option::None() }; }
// The wrapper distinguishes Driver method dispatch from Exchange's inherent
// methods without importing transport policy into the scheduling engine.
struct PlainFactory {}
struct PlainDriver { owner: ext::http_client::Exchange }
impl PlainFactory { fn borrow(&self) -> &PlainFactory { return self; } }
pub impl Driver<ext::http_client::Failure> for PlainDriver {
    pub fn stats(&self) -> ext::http_client::Stats { return self.owner.stats(); }
    pub fn interest(&self) -> ext::http_client::Interest { return self.owner.interest(); }
    pub fn raw_handle(&self) -> core::option::Option<i32> { return self.owner.raw_handle(); }
    pub fn before_wait(&self) -> core::result::Result<bool,ext::http_client::Failure> { return self.owner.before_wait(); }
    pub fn step(&self, ready: ext::http_client::Readiness) -> core::result::Result<core::option::Option<ext::http_client::Response>,ext::http_client::Failure> { return self.owner.step(ready); }
    pub fn abort(&self) -> core::result::Result<bool,ext::http_client::Failure> { return self.owner.abort(); }
}
pub impl Factory<Job,PlainDriver,ext::http_client::Failure> for PlainFactory {
    pub fn request(&self, job: Job) -> ext::http_client::Request { return job.request; }
    pub fn begin(&self, prepared: &ext::http_client::Prepared, job: Job) -> core::result::Result<PlainDriver,ext::http_client::Failure> {
        let made: core::result::Result<ext::http_client::Exchange,ext::http_client::Failure> = prepared.begin(job.endpoint);
        if (made.is_err()) { return core::result::Err(made.unwrap_err()); }
        return core::result::Ok(PlainDriver { owner: made.unwrap() });
    }
    pub fn from_http_failure(&self, failure: ext::http_client::Failure) -> ext::http_client::Failure { return failure; }
    pub fn failure_stats(&self, error: ext::http_client::Failure) -> ext::http_client::Stats { return error.stats; }
    pub fn shared_failure(&self, error: ext::http_client::Failure) -> core::option::Option<Cause> { return shared_http_failure(error); }
}
// Mandatory cleanup does not spend active operations or protocol work. Attempt
// every owner even after one close fails; completed report owners remain live.
fn cleanup<D,E>(run: &Run<D,E>) where D: Driver<E> {
    let index: i32 = 0;
    while (index < run.pending.len()) {
        let value: core::option::Option<Pending> = run.pending.set(index,core::option::None()).unwrap();
        if (value.is_some()) { let pending: Pending = value.unwrap(); pending.owner.destroy(); }
        index += 1;
    }
    run.report.stats.pending_bytes = 0;
    index = 0;
    while (index < run.slots.len()) {
        let slot: Slot<D> = take_slot(run,index);
        if (slot.owner.is_some()) {
            let owner: D = slot.owner.unwrap();
            let ended: core::result::Result<bool,E> = owner.abort();
            let secondary: core::option::Option<E> = core::option::None(); if (ended.is_err()) { secondary = core::option::Some(ended.unwrap_err()); }
            put(run,slot.ordinal,Outcome::Aborted(Abort { stats: owner.stats(), cleanup: secondary })); run.report.stats.aborted += 1;
        }
        index += 1;
    }
    run.active = 0; run.reserved_work = 0;
    run.pending.destroy(); run.slots.destroy(); run.requests.destroy(); run.poll.destroy();
}
fn failed<D,E>(run: &Run<D,E>, cause: Cause) -> core::result::Result<Report<E>,Failure<E>> where D: Driver<E> { cleanup(run); return core::result::Err(Failure { cause: cause, report: run.report }); }
fn metadata<D,E>(run: &Run<D,E>, count: i32, width: i32) -> core::result::Result<bool,Cause> {
    let paid: core::result::Result<bool,Cause> = spend(run,(count as u64) + 1); if (paid.is_err()) { return paid; }
    if (run.report.outcomes.try_reserve(count).is_err()) { return core::result::Err(Cause::AllocationFailed); }
    let index: i32 = 0; while (index < count) { let initial: Outcome<E> = Outcome::NotStarted; run.report.outcomes.try_push(initial).unwrap(); index += 1; }
    paid = spend(run,(count as u64) + 1); if (paid.is_err()) { return paid; }
    if (run.pending.try_reserve(count).is_err()) { return core::result::Err(Cause::AllocationFailed); }
    index = 0; while (index < count) { run.pending.try_push(core::option::None()).unwrap(); index += 1; }
    paid = spend(run,(width as u64) + 1); if (paid.is_err()) { return paid; }
    if (run.slots.try_reserve(width).is_err()) { return core::result::Err(Cause::AllocationFailed); }
    index = 0; while (index < width) { run.slots.try_push(empty_slot<D>()).unwrap(); index += 1; }
    paid = spend(run,(width as u64) + 1); if (paid.is_err()) { return paid; }
    if (run.requests.try_reserve(width).is_err()) { return core::result::Err(Cause::AllocationFailed); }
    index = 0; while (index < width) { run.requests.try_push(no_request()).unwrap(); index += 1; }
    paid = spend(run,2 * (width as u64) + 1); if (paid.is_err()) { return paid; }
    let made: core::result::Result<std::poll::PollSet,std::poll::Error> = std::poll::new(width);
    if (made.is_err()) { let error: std::poll::Error = made.unwrap_err(); let cause: Cause = match (error) { std::poll::Error::AllocationFailed -> Cause::AllocationFailed, _ -> Cause::Poll(error) }; return core::result::Err(cause); }
    run.poll.destroy(); run.poll = made.unwrap(); return core::result::Ok(true);
}
fn prepare<J,D,E,F>(run: &Run<D,E>, jobs: core::slice::View<J>, factory: &F, options: ext::http_client::Options) -> core::result::Result<bool,Cause> where F: Factory<J,D,E> {
    let index: i32 = 0;
    while (index < jobs.length) {
        let checked: core::result::Result<bool,Cause> = observe(run); if (checked.is_err()) { return checked; }
        if (options.work > run.limits.work - run.report.stats.work) { return core::result::Err(Cause::WorkLimit); }
        let paid: core::result::Result<bool,Cause> = spend(run,1); if (paid.is_err()) { return paid; }
        run.reserved_work = options.work;
        let job: J = jobs.values[jobs.start + index];
        let request: ext::http_client::Request = factory.request(job);
        let made: core::result::Result<ext::http_client::Prepared,ext::http_client::Failure> = ext::http_client::prepare_until(request,options,run.deadline);
        let bill: Slot<D> = empty_slot<D>(); bill.credit = options.work;
        if (made.is_err()) {
            let error: ext::http_client::Failure = made.unwrap_err(); let counted: core::result::Result<bool,Cause> = account(run,bill.borrow(),error.stats); release_credit(run,bill.borrow());
            put(run,index,Outcome::Failed(factory.from_http_failure(error))); run.report.stats.failed += 1;
            if (counted.is_err()) { return counted; } return core::result::Err(Cause::Preparation);
        }
        let owner: ext::http_client::Prepared = made.unwrap(); let stats: ext::http_client::Stats = owner.stats();
        let counted: core::result::Result<bool,Cause> = account(run,bill.borrow(),stats); release_credit(run,bill.borrow());
        if (counted.is_err()) { owner.destroy(); return counted; }
        if (stats.request_bytes < 0 || request.method.length < 0) { owner.destroy(); return core::result::Err(Cause::InvalidEngine); }
        let size: u64 = (stats.request_bytes as u64) + (request.method.length as u64);
        if (size > run.limits.max_pending_bytes - run.report.stats.pending_bytes) { owner.destroy(); return core::result::Err(Cause::PendingLimit); }
        run.pending.set(index,core::option::Some(Pending { owner: owner, bytes: size })).unwrap(); run.report.stats.pending_bytes += size;
        if (run.report.stats.pending_bytes > run.report.stats.peak_pending_bytes) { run.report.stats.peak_pending_bytes = run.report.stats.pending_bytes; }
        index += 1;
    }
    return core::result::Ok(true);
}
impl<D> Slot<D> { fn borrow(&self) -> &Slot<D> { return self; } }
fn admit<J,D,E,F>(run: &Run<D,E>, jobs: core::slice::View<J>, factory: &F, options: ext::http_client::Options) -> core::result::Result<bool,Cause> where D: Driver<E>, F: Factory<J,D,E> {
    let width: i32 = run.slots.len(); let paid: core::result::Result<bool,Cause> = spend(run,width as u64); if (paid.is_err()) { return paid; }
    let visit: i32 = 0;
    while (visit < width && run.next < jobs.length) {
        let index: i32 = (run.turn + visit) % width; visit += 1;
        if (run.slots.at(index).owner.is_none()) {
            let pending: Pending = run.pending.at(run.next).unwrap(); let old: ext::http_client::Stats = pending.owner.stats();
            if (old.work > options.work) { return core::result::Err(Cause::InvalidEngine); }
            let credit: u64 = options.work - old.work;
            if (credit > run.limits.work - run.report.stats.work - run.reserved_work) { if (run.active == 0) { return core::result::Err(Cause::WorkLimit); } return core::result::Ok(true); }
            let charged: core::result::Result<bool,Cause> = spend(run,1); if (charged.is_err()) { return charged; }
            let ordinal: i32 = run.next; run.next += 1; run.pending.set(ordinal,core::option::None()).unwrap(); run.report.stats.pending_bytes -= pending.bytes;
            run.reserved_work += credit; run.report.stats.started += 1;
            let slot: Slot<D> = empty_slot<D>(); slot.ordinal = ordinal; slot.credit = credit; slot.reported_work = old.work; slot.reported_io = old.io_calls;
            let made: core::result::Result<D,E> = factory.begin(pending.owner.borrow(),jobs.values[jobs.start + ordinal]);
            if (made.is_err()) {
                let error: E = made.unwrap_err(); let counted: core::result::Result<bool,Cause> = account(run,slot.borrow(),factory.failure_stats(error)); release_credit(run,slot.borrow());
                put(run,ordinal,Outcome::Failed(error)); run.report.stats.failed += 1;
                if (counted.is_err()) { return counted; } let global: core::option::Option<Cause> = factory.shared_failure(error); if (global.is_some()) { return core::result::Err(global.unwrap()); }
            } else {
                let owner: D = made.unwrap(); let counted: core::result::Result<bool,Cause> = account(run,slot.borrow(),owner.stats());
                slot.owner = core::option::Some(owner); put_slot(run,index,slot); run.active += 1; if (run.active > run.report.stats.peak_active) { run.report.stats.peak_active = run.active; }
                if (counted.is_err()) { return counted; }
            }
        }
    }
    return core::result::Ok(true);
}
fn terminal_error<J,D,E,F>(run: &Run<D,E>, slot: &Slot<D>, error: E, factory: &F) -> core::result::Result<bool,Cause> where F: Factory<J,D,E> {
    put(run,slot.ordinal,Outcome::Failed(error)); run.report.stats.failed += 1; run.active -= 1; release_credit(run,slot);
    let global: core::option::Option<Cause> = factory.shared_failure(error); if (global.is_some()) { return core::result::Err(global.unwrap()); } return core::result::Ok(true);
}
fn advance<J,D,E,F>(run: &Run<D,E>, index: i32, factory: &F) -> core::result::Result<bool,Cause> where D: Driver<E>, F: Factory<J,D,E> {
    let slot: Slot<D> = take_slot(run,index); if (slot.owner.is_none()) { return core::result::Ok(true); }
    let owner: D = slot.owner.unwrap(); slot.owner = core::option::None();
    let interest: ext::http_client::Interest = owner.interest(); let ready: ext::http_client::Readiness = slot.ready; slot.ready = no_ready();
    if (!interest.immediate && !ready.readable && !ready.writable && !ready.hangup && !ready.error) { slot.owner = core::option::Some(owner); put_slot(run,index,slot); return core::result::Ok(true); }
    let paid: core::result::Result<bool,Cause> = spend(run,1); if (paid.is_err()) { slot.owner = core::option::Some(owner); put_slot(run,index,slot); return paid; }
    let result: core::result::Result<core::option::Option<ext::http_client::Response>,E> = owner.step(ready);
    let counted: core::result::Result<bool,Cause> = account(run,slot.borrow(),owner.stats());
    if (counted.is_err()) {
        // A terminal error still transfers E even when its statistics violate
        // the driver contract. Retain that owner before reporting InvalidEngine.
        if (result.is_err()) { let recorded = terminal_error<J,D,E,F>(run,slot.borrow(),result.unwrap_err(),factory); return counted; }
        if (result.unwrap().is_some()) { result.unwrap().unwrap().destroy(); }
        slot.owner = core::option::Some(owner); put_slot(run,index,slot); return counted;
    }
    if (result.is_err()) { return terminal_error<J,D,E,F>(run,slot.borrow(),result.unwrap_err(),factory); }
    if (result.unwrap().is_none()) { slot.owner = core::option::Some(owner); put_slot(run,index,slot); return core::result::Ok(true); }
    let response: ext::http_client::Response = result.unwrap().unwrap(); run.active -= 1; release_credit(run,slot.borrow());
    let wire: u64 = response.wire.len() as u64; let body: u64 = response.decoded.len() as u64;
    if (wire > run.limits.max_wire_bytes - run.report.stats.wire_bytes || body > run.limits.max_body_bytes - run.report.stats.body_bytes) {
        let stats: ext::http_client::Stats = response.stats; response.destroy(); put(run,slot.ordinal,Outcome::Discarded(stats)); run.report.stats.discarded += 1;
        if (wire > run.limits.max_wire_bytes - run.report.stats.wire_bytes) { return core::result::Err(Cause::WireLimit); } return core::result::Err(Cause::BodyLimit);
    }
    run.report.stats.wire_bytes += wire; run.report.stats.body_bytes += body; run.report.stats.complete += 1; put(run,slot.ordinal,Outcome::Complete(response)); return core::result::Ok(true);
}
fn milliseconds(remaining: core::time::Duration) -> i32 { if (remaining.seconds >= 2147484) { return 2147483647; } let value: u64 = remaining.seconds * 1000 + ((remaining.nanos as u64) + 999999) / 1000000; if (value > 2147483647) { return 2147483647; } return value as i32; }
fn interrupted(error: std::poll::Error) -> bool { return match (error) { std::poll::Error::Io(cause) -> core::io::is_interrupted(cause), _ -> false }; }
fn wait<J,D,E,F>(run: &Run<D,E>, factory: &F) -> core::result::Result<bool,Cause> where D: Driver<E>, F: Factory<J,D,E> {
    let width: i32 = run.slots.len(); let paid: core::result::Result<bool,Cause> = spend(run,width as u64); if (paid.is_err()) { return paid; }
    let registered: i32 = 0; let immediate: bool = false; let index: i32 = 0;
    while (index < width) {
        run.requests.set(index,no_request()).unwrap(); let slot: Slot<D> = take_slot(run,index);
        if (slot.owner.is_some()) {
            let owner: D = slot.owner.unwrap(); slot.owner = core::option::None(); let interest: ext::http_client::Interest = owner.interest();
            if (interest.immediate) { immediate = true; slot.owner = core::option::Some(owner); put_slot(run,index,slot); }
            else {
                let charged: core::result::Result<bool,Cause> = spend(run,1); if (charged.is_err()) { slot.owner = core::option::Some(owner); put_slot(run,index,slot); return charged; }
                let gate: core::result::Result<bool,E> = owner.before_wait(); let counted: core::result::Result<bool,Cause> = account(run,slot.borrow(),owner.stats());
                if (counted.is_err()) {
                    if (gate.is_err()) { let recorded = terminal_error<J,D,E,F>(run,slot.borrow(),gate.unwrap_err(),factory); return counted; }
                    slot.owner = core::option::Some(owner); put_slot(run,index,slot); return counted;
                }
                if (gate.is_err()) { let terminal: core::result::Result<bool,Cause> = terminal_error<J,D,E,F>(run,slot.borrow(),gate.unwrap_err(),factory); if (terminal.is_err()) { return terminal; } }
                else {
                    slot.owner = core::option::Some(owner); put_slot(run,index,slot);
                    if (!gate.unwrap()) { immediate = true; }
                    else {
                        let handle: core::option::Option<i32> = owner.raw_handle(); if (handle.is_none() || handle.unwrap() < 0 || (!interest.readable && !interest.writable)) { return core::result::Err(Cause::InvalidEngine); }
                        let events: u32 = 0; if (interest.readable) { events = events | std::poll::READABLE; } if (interest.writable) { events = events | std::poll::WRITABLE; }
                        run.requests.set(index,std::poll::Request { handle: handle.unwrap(), events: events }).unwrap(); registered += 1;
                    }
                }
            }
        }
        index += 1;
    }
    if (registered == 0) { if (run.active > 0 && !immediate) { return core::result::Err(Cause::InvalidEngine); } return core::result::Ok(true); }
    let checked: core::result::Result<bool,Cause> = observe(run); if (checked.is_err()) { return checked; }
    let timeout: i32 = 0; if (!immediate) { timeout = milliseconds(run.deadline.remaining(run.last.unwrap())); }
    let charged: core::result::Result<bool,Cause> = spend(run,1); if (charged.is_err()) { return charged; }
    run.report.stats.polls += 1; let result: core::result::Result<i32,std::poll::Error> = run.poll.poll_ms(run.requests.as_view(),timeout);
    let after: core::result::Result<bool,Cause> = observe(run); if (after.is_err()) { return after; }
    if (result.is_err()) { if (interrupted(result.unwrap_err())) { return core::result::Ok(true); } return core::result::Err(Cause::Poll(result.unwrap_err())); }
    let visited: core::result::Result<bool,Cause> = spend(run,width as u64); if (visited.is_err()) { return visited; }
    index = 0;
    while (index < width) {
        if (run.requests.at(index).handle >= 0) {
            let ready: std::poll::Readiness = run.poll.readiness(index).unwrap(); let slot: Slot<D> = take_slot(run,index);
            if (slot.owner.is_none()) { return core::result::Err(Cause::InvalidEngine); }
            slot.ready = ext::http_client::Readiness { readable: ready.readable() || ready.read_closed(), writable: ready.writable(), hangup: ready.hangup(), error: ready.error() || ready.invalid() }; put_slot(run,index,slot);
        }
        index += 1;
    }
    return core::result::Ok(true);
}

// All views borrow valid unchanged backing through return. All requests are
// canonically prepared before the first socket; a preparation error starts none.
// A failure owns its retained report; no active/pending network owner escapes.
pub fn run_with_until<J,D,E,F>(jobs: core::slice::View<J>, factory: &F, options: ext::http_client::Options, limits: Limits, deadline: core::time::Deadline) -> core::result::Result<Report<E>,Failure<E>> where D: Driver<E>, F: Factory<J,D,E> {
    if (!core::io::valid_range(jobs.start,jobs.length)) { return core::result::Err(Failure { cause: Cause::Bounds, report: empty_report<E>(0) }); }
    if (!valid(limits) || deadline.instant.ticks.nanos >= 1000000000) { return core::result::Err(Failure { cause: Cause::InvalidLimits, report: empty_report<E>(jobs.length) }); }
    if (jobs.length > limits.max_jobs) { return core::result::Err(Failure { cause: Cause::Bounds, report: empty_report<E>(jobs.length) }); }
    if (jobs.length == 0) { return core::result::Ok(empty_report<E>(0)); }
    let run: Run<D,E> = Run { report: empty_report<E>(jobs.length), pending: alloc::vec::new<core::option::Option<Pending>>(), slots: alloc::vec::new<Slot<D>>(), requests: alloc::vec::new<std::poll::Request>(), poll: std::poll::new(0).unwrap(), limits: limits, deadline: deadline, last: core::option::None(), next: 0, active: 0, reserved_work: 0, turn: 0 };
    let observed: core::result::Result<bool,Cause> = observe(run.borrow()); if (observed.is_err()) { return failed(run.borrow(),observed.unwrap_err()); }
    let width: i32 = limits.concurrency; if (width > jobs.length) { width = jobs.length; }
    let allocated: core::result::Result<bool,Cause> = metadata(run.borrow(),jobs.length,width); if (allocated.is_err()) { return failed(run.borrow(),allocated.unwrap_err()); }
    let prepared: core::result::Result<bool,Cause> = prepare<J,D,E,F>(run.borrow(),jobs,factory,options); if (prepared.is_err()) { return failed(run.borrow(),prepared.unwrap_err()); }
    while (true) {
        if (run.active == 0 && run.next == jobs.length) { cleanup(run.borrow()); return core::result::Ok(run.report); }
        let checked: core::result::Result<bool,Cause> = observe(run.borrow()); if (checked.is_err()) { return failed(run.borrow(),checked.unwrap_err()); }
        let admitted: core::result::Result<bool,Cause> = admit<J,D,E,F>(run.borrow(),jobs,factory,options); if (admitted.is_err()) { return failed(run.borrow(),admitted.unwrap_err()); }
        let paid: core::result::Result<bool,Cause> = spend(run.borrow(),width as u64); if (paid.is_err()) { return failed(run.borrow(),paid.unwrap_err()); }
        let visit: i32 = 0;
        while (visit < width) { let index: i32 = (run.turn + visit) % width; let progressed: core::result::Result<bool,Cause> = advance<J,D,E,F>(run.borrow(),index,factory); if (progressed.is_err()) { return failed(run.borrow(),progressed.unwrap_err()); } visit += 1; }
        run.turn += 1; if (run.turn == width) { run.turn = 0; }
        // A completed step can free a slot. Refill before a blocking poll on
        // remaining peers; admit retains the same order and work-credit guard.
        while (run.next < jobs.length && run.active < width) {
            let before: i32 = run.next;
            let refilled: core::result::Result<bool,Cause> = admit<J,D,E,F>(run.borrow(),jobs,factory,options);
            if (refilled.is_err()) { return failed(run.borrow(),refilled.unwrap_err()); }
            // Failed begins still consume input. Stop only when admission
            // made no progress (for example, active work holds the credit).
            if (run.next == before) { break; }
        }
        if (run.active > 0) { let waited: core::result::Result<bool,Cause> = wait<J,D,E,F>(run.borrow(),factory); if (waited.is_err()) { return failed(run.borrow(),waited.unwrap_err()); } }
    }
    return failed(run.borrow(),Cause::InvalidEngine);
}

pub fn run_until(jobs: core::slice::View<Job>, options: ext::http_client::Options, limits: Limits, deadline: core::time::Deadline) -> core::result::Result<Report<ext::http_client::Failure>,Failure<ext::http_client::Failure>> {
    let factory: PlainFactory = PlainFactory {};
    return run_with_until<Job,PlainDriver,ext::http_client::Failure,PlainFactory>(jobs,factory.borrow(),options,limits,deadline);
}
