// Incremental HTTP/1.1 body framing for relays (RFC 9112 6 and 7.1). A
// Framer walks a message body as its bytes arrive, keeping only scalar
// state, so a proxy can forward a body of any size through a fixed buffer:
// each advance reports how many bytes it consumed and the one content span
// among them. Chunked framing is strict: CRLF line ends, hex sizes, bounded
// size lines and trailer sections. No allocation, no I/O.
module ext::http_body;
import alloc::vec;
import core::result;
import core::slice;

pub enum Error { Malformed, Limit, Truncated }
// consumed: bytes taken from the input; [data_start, data_start+data_length)
// within them is content (the rest is chunk framing); done: the body ended
// exactly at consumed.
pub struct Step { consumed: i32, data_start: i32, data_length: i32, done: bool }
pub enum Kind { Empty, Fixed, Chunked, Close }
pub enum FramingEvent { Begin, Byte(u8), Content(i32), Eof }
const LARGEST_CHUNK: u64 = 1099511627776;

// Byte validation and phase changes live together. The driver groups content
// bytes into spans; only this machine advances framing or terminal states.
pub machine Framer on FramingEvent -> core::result::Result<bool,Error> {
    kind: Kind,
    left: u64,
    size: u64,
    digits: i32,
    line: i32,
    trailer: i32,
    line_limit: i32,
    trailer_limit: i32,
    content: u64,
    start Initial;

    state Initial {
        FramingEvent::Begin -> { let empty: bool = match (self.kind) { Kind::Empty -> true, Kind::Fixed -> self.left == 0, _ -> false };
            if (empty) { goto Done with core::result::Ok(true); }
            if (match (self.kind) { Kind::Fixed -> true, _ -> false }) { goto Fixed with core::result::Ok(false); }
            if (match (self.kind) { Kind::Close -> true, _ -> false }) { goto Close with core::result::Ok(false); }
            goto Size with core::result::Ok(false); },
        FramingEvent::Byte(_) -> { goto Failed with core::result::Err(Error::Malformed); },
        FramingEvent::Content(_) -> { goto Failed with core::result::Err(Error::Malformed); },
        FramingEvent::Eof -> { goto Failed with core::result::Err(Error::Truncated); },
    }

    state Fixed {
        FramingEvent::Begin -> { goto Failed with core::result::Err(Error::Malformed); },
        FramingEvent::Byte(_) -> { goto Failed with core::result::Err(Error::Malformed); },
        FramingEvent::Content(count) -> { self.left -= count as u64; self.content += count as u64; if (self.left == 0) { goto Done with core::result::Ok(true); } stay with core::result::Ok(false); },
        FramingEvent::Eof -> { goto Failed with core::result::Err(Error::Truncated); },
    }

    state Close {
        FramingEvent::Begin -> { goto Failed with core::result::Err(Error::Malformed); },
        FramingEvent::Byte(_) -> { goto Failed with core::result::Err(Error::Malformed); },
        FramingEvent::Content(count) -> { self.content += count as u64; stay with core::result::Ok(false); },
        FramingEvent::Eof -> { goto Done with core::result::Ok(true); },
    }

    state Size {
        FramingEvent::Begin -> { goto Failed with core::result::Err(Error::Malformed); },
        FramingEvent::Byte(c) -> { self.line += 1; if (self.line > self.line_limit) { goto Failed with core::result::Err(Error::Limit); }
            let v: i32 = hex(c);
            if (v >= 0) {
                self.size = self.size * 16 + (v as u64); self.digits += 1;
                if (self.size > LARGEST_CHUNK) { goto Failed with core::result::Err(Error::Limit); }
                stay with core::result::Ok(false);
            }
            if (self.digits == 0) { goto Failed with core::result::Err(Error::Malformed); }
            if (c == 13) { goto SizeLf with core::result::Ok(false); }
            if (c == 10 || c == 0 || c == 127 || (c < 32 && c != 9)) { goto Failed with core::result::Err(Error::Malformed); }
            goto Extension with core::result::Ok(false); },
        FramingEvent::Content(_) -> { goto Failed with core::result::Err(Error::Malformed); },
        FramingEvent::Eof -> { goto Failed with core::result::Err(Error::Truncated); },
    }

    state Extension {
        FramingEvent::Begin -> { goto Failed with core::result::Err(Error::Malformed); },
        FramingEvent::Byte(c) -> { self.line += 1; if (self.line > self.line_limit) { goto Failed with core::result::Err(Error::Limit); }
            if (c == 13) { goto SizeLf with core::result::Ok(false); }
            if (c == 10 || c == 0 || c == 127 || (c < 32 && c != 9)) { goto Failed with core::result::Err(Error::Malformed); }
            stay with core::result::Ok(false); },
        FramingEvent::Content(_) -> { goto Failed with core::result::Err(Error::Malformed); },
        FramingEvent::Eof -> { goto Failed with core::result::Err(Error::Truncated); },
    }

    state SizeLf {
        FramingEvent::Begin -> { goto Failed with core::result::Err(Error::Malformed); },
        FramingEvent::Byte(c) -> { if (c != 10) { goto Failed with core::result::Err(Error::Malformed); }
            self.line = 0; self.digits = 0;
            self.left = self.size; self.size = 0;
            if (self.left == 0) { goto Trailer with core::result::Ok(false); }
            goto Data with core::result::Ok(false); },
        FramingEvent::Content(_) -> { goto Failed with core::result::Err(Error::Malformed); },
        FramingEvent::Eof -> { goto Failed with core::result::Err(Error::Truncated); },
    }

    state Data {
        FramingEvent::Begin -> { goto Failed with core::result::Err(Error::Malformed); },
        FramingEvent::Byte(_) -> { goto Failed with core::result::Err(Error::Malformed); },
        FramingEvent::Content(count) -> { self.left -= count as u64; self.content += count as u64; if (self.left == 0) { goto DataCr with core::result::Ok(false); } stay with core::result::Ok(false); },
        FramingEvent::Eof -> { goto Failed with core::result::Err(Error::Truncated); },
    }

    state DataCr {
        FramingEvent::Begin -> { goto Failed with core::result::Err(Error::Malformed); },
        FramingEvent::Byte(c) -> { if (c != 13) { goto Failed with core::result::Err(Error::Malformed); } goto DataLf with core::result::Ok(false); },
        FramingEvent::Content(_) -> { goto Failed with core::result::Err(Error::Malformed); },
        FramingEvent::Eof -> { goto Failed with core::result::Err(Error::Truncated); },
    }

    state DataLf {
        FramingEvent::Begin -> { goto Failed with core::result::Err(Error::Malformed); },
        FramingEvent::Byte(c) -> { if (c != 10) { goto Failed with core::result::Err(Error::Malformed); } goto Size with core::result::Ok(false); },
        FramingEvent::Content(_) -> { goto Failed with core::result::Err(Error::Malformed); },
        FramingEvent::Eof -> { goto Failed with core::result::Err(Error::Truncated); },
    }

    state Trailer {
        FramingEvent::Begin -> { goto Failed with core::result::Err(Error::Malformed); },
        FramingEvent::Byte(c) -> { if (c == 13) { goto TrailerLf with core::result::Ok(false); }
            if (c == 10 || c == 0) { goto Failed with core::result::Err(Error::Malformed); }
            self.line += 1; self.trailer += 1; if (self.trailer > self.trailer_limit) { goto Failed with core::result::Err(Error::Limit); }
            stay with core::result::Ok(false); },
        FramingEvent::Content(_) -> { goto Failed with core::result::Err(Error::Malformed); },
        FramingEvent::Eof -> { goto Failed with core::result::Err(Error::Truncated); },
    }

    state TrailerLf {
        FramingEvent::Begin -> { goto Failed with core::result::Err(Error::Malformed); },
        FramingEvent::Byte(c) -> { if (c != 10) { goto Failed with core::result::Err(Error::Malformed); } if (self.line == 0) { goto Done with core::result::Ok(true); } self.line = 0; goto Trailer with core::result::Ok(false); },
        FramingEvent::Content(_) -> { goto Failed with core::result::Err(Error::Malformed); },
        FramingEvent::Eof -> { goto Failed with core::result::Err(Error::Truncated); },
    }

    final state Done {
        FramingEvent::Begin -> { stay with core::result::Ok(true); },
        FramingEvent::Byte(_) -> { stay with core::result::Ok(true); },
        FramingEvent::Content(_) -> { stay with core::result::Ok(true); },
        FramingEvent::Eof -> { stay with core::result::Ok(true); },
    }

    final state Failed {
        FramingEvent::Begin -> { stay with core::result::Err(Error::Malformed); },
        FramingEvent::Byte(_) -> { stay with core::result::Err(Error::Malformed); },
        FramingEvent::Content(_) -> { stay with core::result::Err(Error::Malformed); },
        FramingEvent::Eof -> { stay with core::result::Err(Error::Truncated); },
    }
}

fn framer(kind: Kind, left: u64) -> Framer {
    let value = framer_start(kind,left,0,0,0,0,4096,16384,0);
    value.step(FramingEvent::Begin);
    return value;
}
// No body (HEAD responses, 1xx/204/304, requests without framing fields).
pub fn empty() -> Framer { return framer(Kind::Empty, 0); }
// Content-Length: length bytes.
pub fn fixed(length: u64) -> Framer { return framer(Kind::Fixed, length); }
// Transfer-Encoding: chunked, with size lines up to line_bytes and a
// trailer section up to trailer_bytes.
pub fn chunked(line_bytes: i32, trailer_bytes: i32) -> Framer { let f: Framer = framer(Kind::Chunked, 0); f.line_limit = line_bytes; f.trailer_limit = trailer_bytes; return f; }
// A response delimited by the connection closing.
pub fn until_close() -> Framer { return framer(Kind::Close, 0); }

fn hex(c: u8) -> i32 {
    if (c >= 48 && c <= 57) { return (c - 48) as i32; }
    if (c >= 97 && c <= 102) { return (c - 87) as i32; }
    if (c >= 65 && c <= 70) { return (c - 55) as i32; }
    return -1;
}
fn step(consumed: i32, start: i32, length: i32, done: bool) -> Step { return Step { consumed: consumed, data_start: start, data_length: length, done: done }; }

pub impl Framer {
    pub fn borrow(&self) -> &Framer { return self; }
    pub fn is_done(&self) -> bool { return match (self.state()) { FramerState::Done -> true, _ -> false }; }
    pub fn is_chunked(&self) -> bool { return match (self.kind) { Kind::Chunked -> true, _ -> false }; }
    pub fn is_close_delimited(&self) -> bool { return match (self.kind) { Kind::Close -> true, _ -> false }; }
    pub fn content(&self) -> u64 { return self.content; }
    pub fn remaining(&self) -> u64 { return self.left; }
    pub fn advance(&self, input: core::slice::View<u8>) -> core::result::Result<Step,Error> {
        if (match (self.state()) { FramerState::Failed -> true, _ -> false }) { return core::result::Err(Error::Malformed); }
        if (self.is_done()) { return core::result::Ok(step(0,0,0,true)); }
        let n: i32 = input.len();
        let i: i32 = 0;
        // A zero-length content span is valid for fixed and close bodies.
        if (match (self.state()) { FramerState::Fixed -> true, FramerState::Close -> true, _ -> false }) {
            let take: i32 = n;
            if (!self.is_close_delimited() && (take as u64) > self.left) { take = self.left as i32; }
            let result = self.step(FramingEvent::Content(take));
            if (result.is_err()) { return core::result::Err(result.unwrap_err()); }
            return core::result::Ok(step(take,0,take,result.unwrap()));
        }
        while (i < n) {
            if (match (self.state()) { FramerState::Data -> true, _ -> false }) {
                let take: i32 = n-i; if ((take as u64) > self.left) { take = self.left as i32; }
                let result = self.step(FramingEvent::Content(take));
                if (result.is_err()) { return core::result::Err(result.unwrap_err()); }
                return core::result::Ok(step(i+take,i,take,false));
            }
            let result = self.step(FramingEvent::Byte(input.values[input.start+i]));
            if (result.is_err()) { return core::result::Err(result.unwrap_err()); }
            i += 1;
            if (result.unwrap()) { return core::result::Ok(step(i,0,0,true)); }
        }
        return core::result::Ok(step(n,0,0,false));
    }
    pub fn finish(&self) -> core::result::Result<i32,Error> {
        let result = self.step(FramingEvent::Eof);
        if (result.is_err()) { return core::result::Err(result.unwrap_err()); }
        return core::result::Ok(0);
    }
}

// Append one chunk's size line ("hex CRLF"); the caller appends the data
// and then chunk_end.
pub fn chunk_head(out: &alloc::vec::Vec<u8>, length: i32) -> bool {
    if (length <= 0) { return false; }
    let digits: [u8;8] = [0;8]; let n: i32 = 0; let v: i32 = length;
    while (v > 0) { let d: i32 = v & 15; let c: u8 = (48 + d) as u8; if (d >= 10) { c = (87 + d) as u8; } digits[n] = c; n += 1; v = v >> 4; }
    while (n > 0) { n -= 1; if (out.try_push(digits[n]).is_err()) { return false; } }
    return chunk_end(out);
}
pub fn chunk_end(out: &alloc::vec::Vec<u8>) -> bool { return out.try_push(13).is_ok() && out.try_push(10).is_ok(); }
// The last chunk and an empty trailer section.
pub fn last_chunk(out: &alloc::vec::Vec<u8>) -> bool { return out.try_push(48).is_ok() && out.try_push(13).is_ok() && out.try_push(10).is_ok() && out.try_push(13).is_ok() && out.try_push(10).is_ok(); }
