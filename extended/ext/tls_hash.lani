// TLS handshake hashes. One active owned state, bounded common byte domain.
// RFC8446 sections4.4.1/7. Stable borrowed views require live unchanged owners.
module ext::tls_hash;
import core::result;
import core::sha256;
import core::sha512;
import core::slice;

pub enum Algorithm { Sha256, Sha384 }
pub enum Error { Bounds, InvalidLength, LengthOverflow }
pub struct Digest { algorithm:Algorithm, bytes:[u8;48] }
enum Storage { Sha256(core::sha256::State), Sha384(core::sha512::State) }
// Implementation fields are not an arbitrary state restoration format.
// Count equals the active core state's byte count; that state is unfinished.
pub struct State { inner:Storage, count:u64 }
pub const MAX_BYTES:u64=2305843009213693951;

fn valid(input:core::slice::View<u8>)->bool { return input.start>=0 && input.length>=0 && input.start<=2147483647-input.length; }
pub fn hash_length(algorithm:Algorithm)->i32 { return match(algorithm) { Algorithm::Sha256->32, Algorithm::Sha384->48 }; }
pub impl Digest {
    // Borrow only a stable owned local; the view cannot outlive or move it.
    pub fn view(&self)->core::slice::View<u8> { return core::slice::View { values:self.bytes,start:0,length:hash_length(self.algorithm) }; }
}
pub fn digest_from_view(algorithm:Algorithm,input:core::slice::View<u8>)->core::result::Result<Digest,Error> {
    if(!valid(input)) { return core::result::Err(Error::Bounds); }
    let length:i32=hash_length(algorithm);
    if(input.length!=length) { return core::result::Err(Error::InvalidLength); }
    let bytes:[u8;48]=[0;48]; let i:i32=0;
    while(i<length) { bytes[i]=input.values[input.start+i]; i+=1; }
    return core::result::Ok(Digest { algorithm:algorithm,bytes:bytes });
}
pub fn new(algorithm:Algorithm)->State {
    if(hash_length(algorithm)==32) { return State { inner:Storage::Sha256(core::sha256::new()),count:0 }; }
    return State { inner:Storage::Sha384(core::sha512::new384()),count:0 };
}
fn snapshot256(value:core::sha256::State)->Digest {
    let copy:core::sha256::State=value; let result:core::sha256::Digest=copy.finish(); let bytes:[u8;48]=[0;48]; let i:i32=0;
    while(i<32) { bytes[i]=result.bytes[i]; i+=1; }
    return Digest { algorithm:Algorithm::Sha256,bytes:bytes };
}
fn snapshot384(value:core::sha512::State)->Digest {
    let copy:core::sha512::State=value; let result:core::sha512::Digest=copy.finish(); let bytes:[u8;48]=[0;48]; let i:i32=0;
    while(i<48) { bytes[i]=result.bytes[i]; i+=1; }
    return Digest { algorithm:Algorithm::Sha384,bytes:bytes };
}
pub impl State {
    pub fn borrow(&self)->&State { return self; }
    pub fn algorithm(&self)->Algorithm { return match(self.inner) { Storage::Sha256(value)->Algorithm::Sha256, Storage::Sha384(value)->Algorithm::Sha384 }; }
    // A snapshot finishes a copy and returns independent owned bytes.
    pub fn snapshot(&self)->Digest { return match(self.inner) { Storage::Sha256(value)->snapshot256(value), Storage::Sha384(value)->snapshot384(value) }; }
    fn update256(&self,value:core::sha256::State,input:core::slice::View<u8>)->core::result::Result<i32,Error> {
        let next:core::sha256::State=value; let accepted:core::result::Result<i32,core::sha256::Error> = next.update(input);
        if(accepted.is_err()) { return core::result::Err(Error::LengthOverflow); }
        self.inner=Storage::Sha256(next); self.count+=input.length as u64;
        return core::result::Ok(accepted.unwrap());
    }
    fn update384(&self,value:core::sha512::State,input:core::slice::View<u8>)->core::result::Result<i32,Error> {
        let next:core::sha512::State=value; let accepted:core::result::Result<i32,core::sha512::Error> = next.update(input);
        if(accepted.is_err()) { return core::result::Err(Error::LengthOverflow); }
        self.inner=Storage::Sha384(next); self.count+=input.length as u64;
        return core::result::Ok(accepted.unwrap());
    }
    // Metadata and the shared SHA256/SHA384 domain precede any mutation.
    // Input remains immutable and physically backed, disjoint from this state.
    pub fn update(&self,input:core::slice::View<u8>)->core::result::Result<i32,Error> {
        if(!valid(input)) { return core::result::Err(Error::Bounds); }
        if(self.count>MAX_BYTES || (input.length as u64)>MAX_BYTES-self.count) { return core::result::Err(Error::LengthOverflow); }
        return match(self.inner) { Storage::Sha256(value)->self.update256(value,input), Storage::Sha384(value)->self.update384(value,input) };
    }
}
pub fn digest(algorithm:Algorithm,input:core::slice::View<u8>)->core::result::Result<Digest,Error> {
    if(!valid(input)) { return core::result::Err(Error::Bounds); }
    let state:State=new(algorithm); let accepted:core::result::Result<i32,Error> = state.update(input);
    if(accepted.is_err()) { return core::result::Err(accepted.unwrap_err()); }
    return core::result::Ok(state.snapshot());
}
