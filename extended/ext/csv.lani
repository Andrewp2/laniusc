// Incremental UTF-8 CSV with reusable packed records. The table API collects
// records from this same decoder. See docs/extended-csv.md for the dialect,
// ownership, chunk/EOF behavior, limits and failure contracts.
module ext::csv;
import core::utf8_state;
import core::stream_state;
import alloc::string;
import core::io;
import core::mem;
import core::option;
import core::result;
import core::slice;
import core::utf8;
import core::text;
import alloc::vec;

pub struct Options {
    allow_lf: bool,
    require_same_width: bool,
    max_records: i32,
    max_fields: i32,
    max_field_bytes: i32,
    max_record_bytes: i32,
}
pub fn default_options() -> Options {
    return Options { allow_lf: true, require_same_width: true,
        max_records: 2147483647, max_fields: 2147483647,
        max_field_bytes: 2147483647, max_record_bytes: 2147483647 };
}
pub enum Error {
    InvalidOptions,
    UnexpectedQuote(u64), UnclosedQuote(u64), TrailingText(u64),
    InvalidLineEnding(u64), InvalidCharacter(u64), InvalidUtf8(u64),
    UnequalFields(i32), LimitExceeded(u64),
    AllocationFailed, CapacityOverflow, OffsetOverflow,
    Bounds, NoRecord, Finished,
}
struct Span { start: i32, length: i32 }
pub struct Record { bytes: alloc::vec::Vec<u8>, fields: alloc::vec::Vec<Span> }
// Borrowed canonical bytes; never destroy row through this inactive descriptor.
// Keep the Record live and unchanged until this cursor and its copies end.
// row may be a Table's packed storage: spans base..base+fields are its fields.
pub enum EncodingEvent { NextField, QuoteWritten, QuoteFound, FieldEnded, FieldClosed, RecordEnded, LineEnded }
pub machine EncodingPhase on EncodingEvent {
    start Start;

    state Start {
        EncodingEvent::NextField -> stay,
        EncodingEvent::QuoteWritten -> goto Field,
        EncodingEvent::QuoteFound -> stay,
        EncodingEvent::FieldEnded -> stay,
        EncodingEvent::FieldClosed -> stay,
        EncodingEvent::RecordEnded -> stay,
        EncodingEvent::LineEnded -> stay,
    }

    state Field {
        EncodingEvent::NextField -> stay,
        EncodingEvent::QuoteWritten -> stay,
        EncodingEvent::QuoteFound -> goto Escape,
        EncodingEvent::FieldEnded -> goto EndQuote,
        EncodingEvent::FieldClosed -> stay,
        EncodingEvent::RecordEnded -> stay,
        EncodingEvent::LineEnded -> stay,
    }

    state Escape {
        EncodingEvent::NextField -> stay,
        EncodingEvent::QuoteWritten -> goto Field,
        EncodingEvent::QuoteFound -> stay,
        EncodingEvent::FieldEnded -> stay,
        EncodingEvent::FieldClosed -> stay,
        EncodingEvent::RecordEnded -> stay,
        EncodingEvent::LineEnded -> stay,
    }

    state EndQuote {
        EncodingEvent::NextField -> stay,
        EncodingEvent::QuoteWritten -> stay,
        EncodingEvent::QuoteFound -> stay,
        EncodingEvent::FieldEnded -> stay,
        EncodingEvent::FieldClosed -> goto Separator,
        EncodingEvent::RecordEnded -> stay,
        EncodingEvent::LineEnded -> stay,
    }

    state Separator {
        EncodingEvent::NextField -> goto Start,
        EncodingEvent::QuoteWritten -> stay,
        EncodingEvent::QuoteFound -> stay,
        EncodingEvent::FieldEnded -> stay,
        EncodingEvent::FieldClosed -> stay,
        EncodingEvent::RecordEnded -> goto LineFeed,
        EncodingEvent::LineEnded -> stay,
    }

    state LineFeed {
        EncodingEvent::NextField -> stay,
        EncodingEvent::QuoteWritten -> stay,
        EncodingEvent::QuoteFound -> stay,
        EncodingEvent::FieldEnded -> stay,
        EncodingEvent::FieldClosed -> stay,
        EncodingEvent::RecordEnded -> stay,
        EncodingEvent::LineEnded -> goto Done,
    }

    final state Done {
        EncodingEvent::NextField -> stay,
        EncodingEvent::QuoteWritten -> stay,
        EncodingEvent::QuoteFound -> stay,
        EncodingEvent::FieldEnded -> stay,
        EncodingEvent::FieldClosed -> stay,
        EncodingEvent::RecordEnded -> stay,
        EncodingEvent::LineEnded -> stay,
    }
}

pub enum FieldEvent { Reset, Text, Quote, CloseQuote, CarriageReturn }
pub machine FieldPhase on FieldEvent {
    start Start;

    state Start {
        FieldEvent::Reset -> goto Start,
        FieldEvent::Text -> goto Unquoted,
        FieldEvent::Quote -> goto Quoted,
        FieldEvent::CloseQuote -> stay,
        FieldEvent::CarriageReturn -> goto AfterCr,
    }

    state Unquoted {
        FieldEvent::Reset -> goto Start,
        FieldEvent::Text -> stay,
        FieldEvent::Quote -> stay,
        FieldEvent::CloseQuote -> stay,
        FieldEvent::CarriageReturn -> goto AfterCr,
    }

    state Quoted {
        FieldEvent::Reset -> goto Start,
        FieldEvent::Text -> stay,
        FieldEvent::Quote -> stay,
        FieldEvent::CloseQuote -> goto AfterQuote,
        FieldEvent::CarriageReturn -> stay,
    }

    state AfterQuote {
        FieldEvent::Reset -> goto Start,
        FieldEvent::Text -> stay,
        FieldEvent::Quote -> goto Quoted,
        FieldEvent::CloseQuote -> stay,
        FieldEvent::CarriageReturn -> goto AfterCr,
    }

    state AfterCr {
        FieldEvent::Reset -> goto Start,
        FieldEvent::Text -> stay,
        FieldEvent::Quote -> stay,
        FieldEvent::CloseQuote -> stay,
        FieldEvent::CarriageReturn -> goto AfterCr,
    }
}

pub enum RecordEvent { Started, Ended }
pub machine RecordProgress on RecordEvent {
    start Empty;

    state Empty {
        RecordEvent::Started -> goto Partial,
        RecordEvent::Ended -> stay,
    }

    state Partial {
        RecordEvent::Started -> stay,
        RecordEvent::Ended -> goto Empty,
    }
}

pub struct Encoding { row: Record, base: i32, fields: i32, column: i32, offset: i32, phase: EncodingPhase, remaining_bytes: u64 }
// Rows are packed: bytes holds every field's bytes, spans their absolute
// ranges, and each TableRow its first span and field count.
struct TableRow { first: i32, count: i32 }
pub struct Table { bytes: alloc::vec::Vec<u8>, spans: alloc::vec::Vec<Span>, rows: alloc::vec::Vec<TableRow> }
pub struct Progress { consumed: i32, record: bool }
pub struct Decoder {
    current: Record, options: Options, failure: core::option::Option<Error>,
    offset: u64, records: i32, width: i32,
    mode: FieldPhase, quote_start: u64, field_start: i32, record_progress: RecordProgress,
     cr_start: u64, delivery: core::stream_state::Delivery,
    utf8_sequence: core::utf8_state::Sequence, utf8_start: u64,
}
fn empty_record() -> Record {
    let bytes: alloc::vec::Vec<u8> = alloc::vec::new();
    let fields: alloc::vec::Vec<Span> = alloc::vec::new();
    return Record { bytes: bytes, fields: fields };
}
pub fn new() -> Record { return empty_record(); }
fn vec_error(error: alloc::vec::Error) -> Error {
    return match (error) { alloc::vec::Error::AllocationFailed -> Error::AllocationFailed, alloc::vec::Error::CapacityOverflow -> Error::CapacityOverflow, _ -> Error::Bounds };
}
// Validate hostile logical Text metadata before indexing. Character offsets
// are relative to the supplied Text for append, or packed bytes for preflight.
fn checked_field(text: core::text::Text, base: u64) -> core::result::Result<i32,Error> {
    let checked = core::text::from_utf8_range(text.bytes,text.start,text.length);
    if (checked.is_err()) {
        let error: Error = match (checked.unwrap_err()) { core::text::Error::InvalidUtf8(at) -> Error::InvalidUtf8(base + (at as u64)), _ -> Error::Bounds };
        return core::result::Err(error);
    }
    let index: i32 = 0;
    while (index < text.length) {
        let byte: u8 = text.bytes[text.start + index];
        if ((byte < 32 && byte != 13 && byte != 10) || byte == 127) { return core::result::Err(Error::InvalidCharacter(base + (index as u64))); }
        index += 1;
    }
    return core::result::Ok(text.length);
}
fn growth(capacity: i32, needed: i32, maximum: i32) -> i32 {
    let target: i32 = maximum;
    if (capacity <= maximum / 2) { target = capacity * 2; }
    if (target < 4 && maximum >= 4) { target = 4; }
    if (target < needed) { target = needed; }
    return target;
}
fn string_error(error: alloc::string::Error) -> Error {
    let converted: Error = match (error) {
        alloc::string::Error::AllocationFailed -> Error::AllocationFailed,
        alloc::string::Error::CapacityOverflow -> Error::CapacityOverflow,
        alloc::string::Error::InvalidUtf8(at) -> Error::InvalidUtf8(at as u64),
        alloc::string::Error::InvalidScalar -> Error::InvalidCharacter(0),
        _ -> Error::Bounds,
    };
    return converted;
}
pub impl Record {
    pub fn borrow(&self) -> &Record { return self; }
    fn valid_storage(&self) -> bool {
        let maximum_fields: i32 = (2147483647 / core::mem::size_of<Span>()) as i32;
        return self.bytes.len() >= 0 && self.bytes.capacity() >= 0 && self.bytes.len() <= self.bytes.capacity() && self.fields.len() >= 0 && self.fields.capacity() >= 0 && self.fields.len() <= self.fields.capacity() && self.fields.capacity() <= maximum_fields;
    }
    // Strong failure guarantee: contents, lengths, capacities and existing
    // views all survive Err. Stage both growths before changing either owner.
    // A Text borrowed from an existing field is valid through this append.
    pub fn try_push_field(&self, text: core::text::Text) -> core::result::Result<i32,Error> {
        if (!self.valid_storage()) { return core::result::Err(Error::Bounds); }
        let checked = checked_field(text,0);
        if (checked.is_err()) { return core::result::Err(checked.unwrap_err()); }
        let before: i32 = self.bytes.len(); let count: i32 = self.fields.len();
        let maximum_fields: i32 = (2147483647 / core::mem::size_of<Span>()) as i32;
        if (text.length > 2147483647 - before || count >= maximum_fields) { return core::result::Err(Error::CapacityOverflow); }
        let bytes: alloc::vec::Vec<u8> = alloc::vec::new();
        let fields: alloc::vec::Vec<Span> = alloc::vec::new();
        let grow_bytes: bool = before + text.length > self.bytes.capacity();
        let grow_fields: bool = count + 1 > self.fields.capacity();
        if (grow_bytes) {
            let allocated = alloc::vec::with_capacity<u8>(growth(self.bytes.capacity(),before + text.length,2147483647));
            if (allocated.is_err()) { return core::result::Err(vec_error(allocated.unwrap_err())); }
            bytes = allocated.unwrap();
            core::result::unwrap(bytes.try_extend(self.bytes.as_view()));
        }
        if (grow_fields) {
            let allocated = alloc::vec::with_capacity<Span>(growth(self.fields.capacity(),count + 1,maximum_fields));
            if (allocated.is_err()) { bytes.destroy(); return core::result::Err(vec_error(allocated.unwrap_err())); }
            fields = allocated.unwrap();
            core::result::unwrap(fields.try_extend(self.fields.as_view()));
        }
        // Reserved appends cannot allocate. Old bytes remain live while the
        // incoming Text is copied, including an alias of those same bytes.
        let source: core::slice::View<u8> = core::slice::View { values: text.bytes, start: text.start, length: text.length };
        if (grow_bytes) { core::result::unwrap(bytes.try_extend(source)); }
        else { core::result::unwrap(self.bytes.try_extend(source)); }
        let span: Span = Span { start: before, length: text.length };
        if (grow_fields) { core::result::unwrap(fields.try_push(span)); }
        else { core::result::unwrap(self.fields.try_push(span)); }
        if (grow_bytes) { self.bytes.destroy(); self.bytes = bytes; }
        if (grow_fields) { self.fields.destroy(); self.fields = fields; }
        return core::result::Ok(count + 1);
    }
    // Validate the complete packed layout and field dialect before emission.
    // No allocation. A zero-field Record is no record and has zero output.
    pub fn encoded_len(&self) -> core::result::Result<u64,Error> {
        if (!self.valid_storage()) { return core::result::Err(Error::Bounds); }
        let total: u64 = 0; let column: i32 = 0; let offset: i32 = 0;
        while (column < self.fields.len()) {
            let span: Span = self.fields.at(column);
            if (span.start != offset || span.length < 0 || span.length > self.bytes.len() - offset) { return core::result::Err(Error::Bounds); }
            let field: core::text::Text = core::text::Text { bytes: self.bytes.as_slice(), start: span.start, length: span.length };
            // One pass for printable ASCII (plus CR and LF), counting quotes;
            // anything else takes the full check, which reports the error.
            let data: [u8] = field.bytes; let at: i32 = span.start; let stop: i32 = span.start + span.length; let quotes: u64 = 0;
            while (at < stop) {
                let byte: u8 = data[at];
                if (byte >= 127 || (byte < 32 && byte != 13 && byte != 10)) { break; }
                if (byte == 34) { quotes += 1; }
                at += 1;
            }
            if (at < stop) {
                let checked = checked_field(field,offset as u64);
                if (checked.is_err()) { return core::result::Err(checked.unwrap_err()); }
                at = span.start; quotes = 0;
                while (at < stop) { if (data[at] == 34) { quotes += 1; } at += 1; }
            }
            let addition: u64 = 2 + (span.length as u64) + quotes;
            if (column > 0) { addition += 1; }
            if (total > 18446744073709551615 - addition) { return core::result::Err(Error::CapacityOverflow); }
            total += addition; offset += span.length; column += 1;
        }
        if (offset != self.bytes.len()) { return core::result::Err(Error::Bounds); }
        if (column > 0) { if (total > 18446744073709551613) { return core::result::Err(Error::CapacityOverflow); } total += 2; }
        return core::result::Ok(total);
    }
    pub fn encoding(&self) -> core::result::Result<Encoding,Error> {
        let length = self.encoded_len();
        if (length.is_err()) { return core::result::Err(length.unwrap_err()); }
        let borrowed: Record = Record { bytes: self.bytes, fields: self.fields };
        return core::result::Ok(Encoding { row: borrowed, base: 0, fields: self.fields.len(), column: 0, offset: 0, phase: encoding_phase_start(), remaining_bytes: length.unwrap() });
    }
    pub fn field_count(&self) -> i32 { return self.fields.len(); }
    pub fn byte_len(&self) -> i32 { return self.bytes.len(); }
    pub fn byte_capacity(&self) -> i32 { return self.bytes.capacity(); }
    pub fn field_capacity(&self) -> i32 { return self.fields.capacity(); }
    pub fn field(&self, index: i32) -> core::result::Result<core::text::Text, Error> {
        if (index < 0 || index >= self.fields.len()) { return core::result::Err(Error::Bounds); }
        let span: Span = self.fields.at(index);
        return core::result::Ok(core::text::from_utf8_unchecked(self.bytes.as_slice(), span.start, span.length));
    }
    pub fn try_field(&self, index: i32) -> core::result::Result<alloc::string::String, Error> {
        let view: core::result::Result<core::text::Text, Error> = self.field(index);
        if (core::result::is_err(view)) { return core::result::Err(core::result::unwrap_err(view)); }
        let copied: core::result::Result<alloc::string::String, alloc::string::Error> = alloc::string::from_text(core::result::unwrap(view));
        if (core::result::is_err(copied)) { return core::result::Err(string_error(core::result::unwrap_err(copied))); }
        return core::result::Ok(core::result::unwrap(copied));
    }
    pub fn clear(&self) {
        self.bytes.clear();
        self.fields.clear();
    }
    pub fn destroy(&self) {
        self.bytes.destroy(); self.fields.destroy();
        self.bytes = alloc::vec::new(); self.fields = alloc::vec::new();
    }
}

pub impl Encoding {
    pub fn borrow(&self) -> &Encoding { return self; }
    pub fn remaining(&self) -> u64 { return self.remaining_bytes; }
    // Byte cursor shared by materialized and streaming encoding. Exhaustion
    // is fused; cursor copies have independent positions and borrow one row.
    pub fn next(&self) -> core::option::Option<u8> {
        let one: [u8; 1] = [0];
        if (self.fill(one, 0, 1) == 0) { return core::option::None(); }
        return core::option::Some(one[0]);
    }
    // Writes the next min(limit, remaining()) bytes to target[at...] and
    // returns that count: the same bytes and final cursor as that many
    // next() calls. Field bytes are copied in runs.
    pub fn fill(&self, target: [u8], at: i32, limit: i32) -> i32 {
        let want: i32 = limit;
        if (want <= 0 || self.remaining_bytes == 0) { return 0; }
        if ((want as u64) > self.remaining_bytes) { want = self.remaining_bytes as i32; }
        let bytes: [u8] = self.row.bytes.as_slice(); let fields: i32 = self.fields; let base: i32 = self.base;
        let phase: EncodingPhase = self.phase; let column: i32 = self.column; let offset: i32 = self.offset;
        let first: i32 = 0; let length: i32 = 0;
        if (column < fields) { let span: Span = self.row.fields.at(base + column); first = span.start; length = span.length; }
        let to: i32 = at; let stop: i32 = at + want;
        while (to < stop) {
            if (match (phase.state()) { EncodingPhaseState::Field -> true, _ -> false }) {
                if (offset < length) {
                    let from: i32 = first + offset; let end: i32 = first + length;
                    while (to < stop && from < end) {
                        let byte: u8 = bytes[from]; target[to] = byte; to += 1; from += 1;
                        if (byte == 34) { phase.step(EncodingEvent::QuoteFound); break; }
                    }
                    offset = from - first;
                } else { phase.step(EncodingEvent::FieldEnded); }
                continue;
            }
            if (match (phase.state()) { EncodingPhaseState::Start -> true, _ -> false }) { target[to] = 34; phase.step(EncodingEvent::QuoteWritten); }
            else { if (match (phase.state()) { EncodingPhaseState::Escape -> true, _ -> false }) { target[to] = 34; phase.step(EncodingEvent::QuoteWritten); }
            else { if (match (phase.state()) { EncodingPhaseState::EndQuote -> true, _ -> false }) { target[to] = 34; phase.step(EncodingEvent::FieldClosed); }
            else { if (match (phase.state()) { EncodingPhaseState::Separator -> true, _ -> false }) {
                column += 1; offset = 0;
                if (column < fields) {
                    let span: Span = self.row.fields.at(base + column); first = span.start; length = span.length;
                    target[to] = 44; phase.step(EncodingEvent::NextField);
                } else { target[to] = 13; phase.step(EncodingEvent::RecordEnded); }
            }
            else { target[to] = 10; phase.step(EncodingEvent::LineEnded); } } } }
            to += 1;
        }
        self.phase = phase; self.column = column; self.offset = offset;
        self.remaining_bytes -= want as u64;
        return want;
    }
}

pub fn decoder(options: Options) -> core::result::Result<Decoder, Error> {
    if (options.max_records < 0 || options.max_fields < 1 || options.max_field_bytes < 0 || options.max_record_bytes < 0) {
        return core::result::Err(Error::InvalidOptions);
    }
    return core::result::Ok(Decoder { current: empty_record(), options: options,
        failure: core::option::None(), offset: 0, records: 0, width: 0,
        mode: field_phase_start(), quote_start: 0, field_start: 0, record_progress: record_progress_start(),
         cr_start: 0, delivery: core::stream_state::delivery_start(),
        utf8_sequence: core::utf8_state::sequence_start(false), utf8_start: 0 });
}

pub impl Decoder {
    pub fn borrow(&self) -> &Decoder { return self; }
    pub fn byte_offset(&self) -> u64 { return self.offset; }
    pub fn records_read(&self) -> i32 { return self.records; }
    pub fn has_record(&self) -> bool { return self.delivery.ready(); }
    pub fn byte_capacity(&self) -> i32 { return self.current.byte_capacity(); }
    pub fn field_capacity(&self) -> i32 { return self.current.field_capacity(); }
    pub fn field_count(&self) -> core::option::Option<i32> {
        if (!self.delivery.ready()) { return core::option::None(); }
        return core::option::Some(self.current.field_count());
    }
    pub fn field(&self, index: i32) -> core::result::Result<core::text::Text, Error> {
        if (!self.delivery.ready()) { return core::result::Err(Error::NoRecord); }
        return self.current.field(index);
    }
    // Transfer ownership, leaving this decoder with empty buffers. Ordinary
    // streaming callers should use field() to retain and reuse the buffers.
    pub fn take_record(&self) -> core::option::Option<Record> {
        if (!self.delivery.ready()) { return core::option::None(); }
        let record: Record = self.current;
        self.current = empty_record(); self.delivery.taken();
        return core::option::Some(record);
    }
    fn fail(&self, error: Error) -> bool {
        self.failure = core::option::Some(error); self.delivery.fail();
        return false;
    }
    fn push_byte(&self, byte: u8) -> bool {
        let before: i32 = self.current.bytes.len();
        if (before - self.field_start >= self.options.max_field_bytes || before >= self.options.max_record_bytes) {
            return self.fail(Error::LimitExceeded(self.offset));
        }
        if (core::result::is_err(self.current.bytes.try_push(byte))) { return self.fail(Error::AllocationFailed); }
        return true;
    }
    fn finish_field(&self, at: u64) -> bool {
        let before: i32 = self.current.fields.len();
        if (before >= self.options.max_fields) { return self.fail(Error::LimitExceeded(at)); }
        let end: i32 = self.current.bytes.len();
        let span: Span = Span { start: self.field_start, length: end - self.field_start };
        if (core::result::is_err(self.current.fields.try_push(span))) { return self.fail(Error::AllocationFailed); }
        self.field_start = end;
        return true;
    }
    fn finish_row(&self, at: u64) -> bool {
        let count: i32 = self.current.fields.len();
        if (self.records >= self.options.max_records) { return self.fail(Error::LimitExceeded(at)); }
        if (self.records > 0 && self.options.require_same_width && count != self.width) {
            return self.fail(Error::UnequalFields(self.records));
        }
        self.width = count; self.records += 1;
        self.mode.step(FieldEvent::Reset); self.record_progress.step(RecordEvent::Ended); self.delivery.produced(); self.field_start = 0;
        return true;
    }
    // Validate input across arbitrary chunk boundaries before interpreting CSV
    // punctuation. A record can only become visible at a complete UTF-8 boundary.
    fn accept_utf8(&self, byte: u8) -> bool {
        if (self.utf8_sequence.complete()) { self.utf8_start = self.offset; }
        if (!self.utf8_sequence.step(byte)) { return self.fail(Error::InvalidUtf8(self.utf8_start)); }
        return true;
    }
    // Field bytes from source[from, from + available) that step() would push
    // one at a time in mode 1 or 2 without failing: printable ASCII other
    // than the quote (and comma when unquoted), CR and LF inside quotes, and
    // complete valid UTF-8 sequences. They are appended in one step, within
    // the field, record and offset limits; returns how many (0 leaves
    // everything to step(), -1 after a failed reservation).
    fn plain_run(&self, source: [u8], from: i32, available: i32) -> i32 {
        let length: i32 = self.current.bytes.len();
        let room: i32 = self.options.max_field_bytes - (length - self.field_start);
        if (self.options.max_record_bytes - length < room) { room = self.options.max_record_bytes - length; }
        let limit: i32 = available; if (limit > room) { limit = room; }
        if (limit <= 0) { return 0; }
        let left: u64 = 18446744073709551615 - self.offset;
        if ((limit as u64) > left) { limit = left as i32; }
        let quoted: bool = (match (self.mode.state()) { FieldPhaseState::Quoted -> true, _ -> false });
        let index: i32 = from; let stop: i32 = from + limit;
        while (index < stop) {
            let byte: u8 = source[index];
            if (byte >= 32 && byte < 127) {
                if (byte == 34 || (byte == 44 && !quoted)) { break; }
                index += 1; continue;
            }
            if (byte < 128) {
                if (quoted && (byte == 13 || byte == 10)) { index += 1; continue; }
                break;
            }
            let width: i32 = core::utf8::sequence_len_or(byte, 0) as i32;
            if (width < 2 || width > stop - index) { break; }
            let second: u8 = source[index + 1]; let third: u8 = 0; let fourth: u8 = 0;
            if (width > 2) { third = source[index + 2]; }
            if (width > 3) { fourth = source[index + 3]; }
            if (core::utf8::decode_or(byte, second, third, fourth, width as u32, 4294967295) == 4294967295) { break; }
            index += width;
        }
        let run: i32 = index - from;
        if (run == 0) { return 0; }
        // Grow as run single-byte pushes would, in one reservation.
        let capacity: i32 = self.current.bytes.capacity(); let needed: i32 = length + run;
        if (needed > capacity) {
            let target: i32 = capacity;
            while (target < needed) {
                if (target > 1073741823) { target = 2147483647; } else { target = target * 2; if (target < 4) { target = 4; } }
            }
            // A failed reservation is AllocationFailed, as for a single push:
            // allocation errors are sticky and never retried in smaller steps.
            if (core::result::is_err(self.current.bytes.try_reserve(target - length))) { self.fail(Error::AllocationFailed); return -1; }
        }
        core::result::unwrap(self.current.bytes.try_extend(core::slice::View { values: source, start: from, length: run }));
        return run;
    }
    // Modes: 0 field start, 1 unquoted, 2 quoted, 3 after closing quote.
    fn step(&self, byte: u8) -> bool {
        if ((match (self.mode.state()) { FieldPhaseState::AfterCr -> true, _ -> false })) {
            if (byte != 10) { return self.fail(Error::InvalidLineEnding(self.cr_start)); }
            self.mode.step(FieldEvent::Reset);
            return self.finish_field(self.cr_start) && self.finish_row(self.cr_start);
        }
        if (!self.accept_utf8(byte)) { return false; }
        if ((match (self.mode.state()) { FieldPhaseState::Quoted -> true, _ -> false })) {
            if (byte == 34) { self.mode.step(FieldEvent::CloseQuote); return true; }
            if ((byte < 32 && byte != 13 && byte != 10) || byte == 127) { return self.fail(Error::InvalidCharacter(self.offset)); }
            return self.push_byte(byte);
        }
        if ((match (self.mode.state()) { FieldPhaseState::AfterQuote -> true, _ -> false }) && byte == 34) {
            if (!self.push_byte(byte)) { return false; }
            self.mode.step(FieldEvent::Quote); return true;
        }
        if (byte == 44) {
            if (!self.finish_field(self.offset)) { return false; }
            self.mode.step(FieldEvent::Reset); self.record_progress.step(RecordEvent::Started); return true;
        }
        if (byte == 13) { self.mode.step(FieldEvent::CarriageReturn); self.cr_start = self.offset; return true; }
        if (byte == 10) {
            if (!self.options.allow_lf) { return self.fail(Error::InvalidLineEnding(self.offset)); }
            return self.finish_field(self.offset) && self.finish_row(self.offset);
        }
        if ((match (self.mode.state()) { FieldPhaseState::AfterQuote -> true, _ -> false })) { return self.fail(Error::TrailingText(self.offset)); }
        if (byte == 34) {
            if ((!(match (self.mode.state()) { FieldPhaseState::Start -> true, _ -> false }))) { return self.fail(Error::UnexpectedQuote(self.offset)); }
            self.mode.step(FieldEvent::Quote); self.quote_start = self.offset; self.record_progress.step(RecordEvent::Started); return true;
        }
        if (byte < 32 || byte == 127) { return self.fail(Error::InvalidCharacter(self.offset)); }
        if (!self.push_byte(byte)) { return false; }
        self.mode.step(FieldEvent::Text); self.record_progress.step(RecordEvent::Started); return true;
    }
    // Empty input is not EOF and preserves the current record. A valid
    // nonempty attempt on an unfinished decoder invalidates the previous
    // record and stops after at most one new record. On failure byte_offset reports the accepted prefix; the error
    // is sticky until reset. Invalid integer ranges preserve all decoder state.
    pub fn feed(&self, source: [u8], start: i32, count: i32) -> core::result::Result<Progress, Error> {
        if (core::option::is_some(self.failure)) { return core::result::Err(core::option::unwrap(self.failure)); }
        if (!core::io::valid_range(start, count)) { return core::result::Err(Error::Bounds); }
        if (count == 0) { return core::result::Ok(Progress { consumed: 0, record: false }); }
        if (self.delivery.finished()) { return core::result::Err(Error::Finished); }
        if (self.delivery.ready()) { self.current.clear(); self.delivery.taken(); }
        let consumed: i32 = 0;
        while (consumed < count) {
            if (self.offset == 18446744073709551615) {
                self.fail(Error::OffsetOverflow);
                return core::result::Err(Error::OffsetOverflow);
            }
            if (self.records >= self.options.max_records) {
                self.fail(Error::LimitExceeded(self.offset));
                return core::result::Err(core::option::unwrap(self.failure));
            }
            if (((match (self.mode.state()) { FieldPhaseState::Unquoted -> true, _ -> false }) || (match (self.mode.state()) { FieldPhaseState::Quoted -> true, _ -> false })) && !(match (self.mode.state()) { FieldPhaseState::AfterCr -> true, _ -> false }) && self.utf8_sequence.complete()) {
                let run: i32 = self.plain_run(source, start + consumed, count - consumed);
                if (run < 0) { return core::result::Err(core::option::unwrap(self.failure)); }
                if (run > 0) { consumed += run; self.offset += run as u64; continue; }
            }
            if (!self.step(source[start + consumed])) { return core::result::Err(core::option::unwrap(self.failure)); }
            consumed += 1; self.offset += 1;
            if (self.delivery.ready()) { return core::result::Ok(Progress { consumed: consumed, record: true }); }
        }
        return core::result::Ok(Progress { consumed: consumed, record: false });
    }
    // Explicit EOF. Returns true only when EOF completes a new final record.
    // Repeated EOF is harmless, preserves the last record and returns false.
    pub fn finish(&self) -> core::result::Result<bool, Error> {
        if (core::option::is_some(self.failure)) { return core::result::Err(core::option::unwrap(self.failure)); }
        if (self.delivery.finished()) { return core::result::Ok(false); }
        if ((match (self.mode.state()) { FieldPhaseState::AfterCr -> true, _ -> false })) { self.fail(Error::InvalidLineEnding(self.cr_start)); }
        else {
            if (!self.utf8_sequence.complete()) { self.fail(Error::InvalidUtf8(self.utf8_start)); }
            else { if ((match (self.mode.state()) { FieldPhaseState::Quoted -> true, _ -> false })) { self.fail(Error::UnclosedQuote(self.quote_start)); } }
        }
        if (core::option::is_some(self.failure)) { return core::result::Err(core::option::unwrap(self.failure)); }
        if ((match (self.record_progress.state()) { RecordProgressState::Partial -> true, _ -> false })) {
            if (!self.finish_field(self.offset) || !self.finish_row(self.offset)) { return core::result::Err(core::option::unwrap(self.failure)); }
            self.delivery.finish(); return core::result::Ok(true);
        }
        self.delivery.finish(); return core::result::Ok(false);
    }
    // Retain capacities; clear counters, error, EOF and all borrowed records.
    pub fn reset(&self) {
        self.current.clear(); self.failure = core::option::None();
        self.offset = 0; self.records = 0; self.width = 0;
        self.mode.step(FieldEvent::Reset); self.quote_start = 0; self.field_start = 0; self.record_progress.step(RecordEvent::Ended);
        self.mode.step(FieldEvent::Reset); self.cr_start = 0; self.delivery.taken(); self.delivery.reset();
        self.utf8_sequence = core::utf8_state::sequence_start(false); self.utf8_start = 0;

    }
    pub fn destroy(&self) { self.current.destroy(); self.reset(); }
}

pub impl Table {
    pub fn row_count(&self) -> i32 { return self.rows.len(); }
    pub fn field_count(&self, index: i32) -> core::option::Option<i32> {
        if (index < 0 || index >= self.rows.len()) { return core::option::None(); }
        let row: TableRow = self.rows.at(index);
        return core::option::Some(row.count);
    }
    pub fn field(&self, row_index: i32, field_index: i32) -> core::result::Result<core::text::Text, Error> {
        if (row_index < 0 || row_index >= self.rows.len()) { return core::result::Err(Error::Bounds); }
        let row: TableRow = self.rows.at(row_index);
        if (field_index < 0 || field_index >= row.count) { return core::result::Err(Error::Bounds); }
        let span: Span = self.spans.at(row.first + field_index);
        return core::result::Ok(core::text::from_utf8_unchecked(self.bytes.as_slice(), span.start, span.length));
    }
    pub fn try_field(&self, row_index: i32, field_index: i32) -> core::result::Result<alloc::string::String, Error> {
        let view: core::result::Result<core::text::Text, Error> = self.field(row_index, field_index);
        if (core::result::is_err(view)) { return core::result::Err(core::result::unwrap_err(view)); }
        let copied: core::result::Result<alloc::string::String, alloc::string::Error> = alloc::string::from_text(core::result::unwrap(view));
        if (core::result::is_err(copied)) { return core::result::Err(string_error(core::result::unwrap_err(copied))); }
        return core::result::Ok(core::result::unwrap(copied));
    }
    // Copies a decoded record into the packed storage. All three vectors
    // grow geometrically before any is changed, so false leaves the table
    // unchanged.
    fn collect(&self, record: &Record) -> bool {
        let length: i32 = record.bytes.len(); let count: i32 = record.fields.len();
        let base: i32 = self.bytes.len(); let first: i32 = self.spans.len();
        if (!reserve_bytes(self.bytes.borrow(), length) || !reserve_spans(self.spans.borrow(), count) || !reserve_rows(self.rows.borrow(), 1)) { return false; }
        core::result::unwrap(self.bytes.try_extend(record.bytes.as_view()));
        let index: i32 = 0;
        while (index < count) {
            let span: Span = record.fields.at(index);
            core::result::unwrap(self.spans.try_push(Span { start: base + span.start, length: span.length }));
            index += 1;
        }
        core::result::unwrap(self.rows.try_push(TableRow { first: first, count: count }));
        return true;
    }
    // A cursor over one row, borrowing the packed storage.
    fn row_encoding(&self, index: i32) -> Encoding {
        let row: TableRow = self.rows.at(index); let data: [u8] = self.bytes.as_slice();
        let total: u64 = 0; let column: i32 = 0;
        while (column < row.count) {
            let span: Span = self.spans.at(row.first + column);
            total += 3 + (span.length as u64);
            let at: i32 = span.start; let stop: i32 = span.start + span.length;
            while (at < stop) { if (data[at] == 34) { total += 1; } at += 1; }
            column += 1;
        }
        if (row.count > 0) { total += 1; }
        let borrowed: Record = Record { bytes: self.bytes, fields: self.spans };
        return Encoding { row: borrowed, base: row.first, fields: row.count, column: 0, offset: 0, phase: encoding_phase_start(), remaining_bytes: total };
    }
    pub fn destroy(&self) {
        self.bytes.destroy(); self.spans.destroy(); self.rows.destroy();
        self.bytes = alloc::vec::new(); self.spans = alloc::vec::new(); self.rows = alloc::vec::new();
    }
}
// Room for additional more entries, doubling (at least 64) when it grows.
fn reserve_bytes(values: &alloc::vec::Vec<u8>, additional: i32) -> bool {
    let length: i32 = values.len();
    if (additional > 2147483647 - length) { return false; }
    let target: i32 = grown_capacity(values.capacity(), length + additional);
    if (target <= values.capacity()) { return true; }
    return core::result::is_ok(values.try_reserve(target - length));
}
fn reserve_spans(values: &alloc::vec::Vec<Span>, additional: i32) -> bool {
    let length: i32 = values.len();
    let maximum: i32 = (2147483647 / core::mem::size_of<Span>()) as i32;
    if (additional > maximum - length) { return false; }
    let target: i32 = grown_capacity(values.capacity(), length + additional);
    if (target > maximum) { target = maximum; }
    if (target <= values.capacity()) { return true; }
    return core::result::is_ok(values.try_reserve(target - length));
}
fn reserve_rows(values: &alloc::vec::Vec<TableRow>, additional: i32) -> bool {
    let length: i32 = values.len();
    let maximum: i32 = (2147483647 / core::mem::size_of<TableRow>()) as i32;
    if (additional > maximum - length) { return false; }
    let target: i32 = grown_capacity(values.capacity(), length + additional);
    if (target > maximum) { target = maximum; }
    if (target <= values.capacity()) { return true; }
    return core::result::is_ok(values.try_reserve(target - length));
}
fn grown_capacity(capacity: i32, needed: i32) -> i32 {
    if (needed <= capacity) { return capacity; }
    let target: i32 = needed;
    if (capacity <= 1073741823 && capacity * 2 > target) { target = capacity * 2; }
    if (target < 64) { target = 64; }
    return target;
}
fn parse_failed(table: Table, decoder: Decoder, error: Error) -> core::result::Result<Table, Error> {
    table.destroy(); decoder.destroy(); return core::result::Err(error);
}
// Decode a complete byte range using the incremental parser. Error offsets
// start at zero for the selected input range, independent of its source offset.
pub fn parse_bytes(source: [u8], offset: i32, count: i32, options: Options) -> core::result::Result<Table, Error> {
    if (!core::io::valid_range(offset, count)) { return core::result::Err(Error::Bounds); }
    let made: core::result::Result<Decoder, Error> = decoder(options);
    if (core::result::is_err(made)) { return core::result::Err(core::result::unwrap_err(made)); }
    let parser: Decoder = core::result::unwrap(made);
    let table: Table = Table { bytes: alloc::vec::new(), spans: alloc::vec::new(), rows: alloc::vec::new() };
    let index: i32 = 0;
    while (index < count) {
        let step: core::result::Result<Progress, Error> = parser.feed(source, offset + index, count - index);
        if (core::result::is_err(step)) { return parse_failed(table, parser, core::result::unwrap_err(step)); }
        let progress: Progress = core::result::unwrap(step);
        index += progress.consumed;
        if (progress.record && !table.collect(parser.current.borrow())) { return parse_failed(table, parser, Error::AllocationFailed); }
    }
    let ended: core::result::Result<bool, Error> = parser.finish();
    if (core::result::is_err(ended)) { return parse_failed(table, parser, core::result::unwrap_err(ended)); }
    if (core::result::unwrap(ended) && !table.collect(parser.current.borrow())) { return parse_failed(table, parser, Error::AllocationFailed); }
    parser.destroy(); return core::result::Ok(table);
}
pub fn parse(input: alloc::string::String, options: Options) -> core::result::Result<Table, Error> {
    return parse_bytes(input.as_bytes(), 0, input.byte_len(), options);
}

struct Encoder { output: alloc::string::String, error: Error }
// Length of the longest prefix of block[0, count) that ends on a UTF-8
// sequence boundary.
fn complete_prefix(block: [u8], count: i32) -> i32 {
    let lead: i32 = count - 1; let back: i32 = 0;
    while (lead > 0 && back < 3 && (block[lead] & 192) == 128) { lead -= 1; back += 1; }
    if (lead < 0) { return count; }
    let width: i32 = core::utf8::sequence_len_or(block[lead], 1) as i32;
    if (lead + width > count) { return lead; }
    return count;
}
impl Encoder {
    fn record(&self, row: Record) -> bool {
        let made = row.encoding();
        if (made.is_err()) { self.error = made.unwrap_err(); return false; }
        return self.cursor(made.unwrap());
    }
    fn cursor(&self, cursor: Encoding) -> bool {
        let used: i32 = self.output.byte_len();
        if (cursor.remaining() > (2147483647 - used) as u64) { self.error = Error::CapacityOverflow; return false; }
        let needed: i32 = used + (cursor.remaining() as i32);
        let capacity: i32 = self.output.capacity();
        if (needed > capacity) {
            let target: i32 = needed;
            if (capacity <= 1073741823 && capacity * 2 > target) { target = capacity * 2; }
            let reserved: core::result::Result<i32, alloc::string::Error> = self.output.try_reserve(target);
            if (core::result::is_err(reserved)) { self.error = string_error(core::result::unwrap_err(reserved)); return false; }
        }
        // Encoded blocks are appended whole UTF-8 sequences at a time.
        let block: [u8; 1024] = [0; 1024]; let kept: i32 = 0;
        while (cursor.remaining() > 0) {
            let count: i32 = kept + cursor.fill(block, kept, 1024 - kept);
            let cut: i32 = count;
            if (cursor.remaining() > 0) { cut = complete_prefix(block, count); }
            let pushed: core::result::Result<i32, alloc::string::Error> = self.output.try_append_text(core::text::from_utf8_unchecked(block, 0, cut));
            if (core::result::is_err(pushed)) { self.error = string_error(core::result::unwrap_err(pushed)); return false; }
            kept = count - cut;
            let index: i32 = 0;
            while (index < kept) { let moved: u8 = block[cut + index]; block[index] = moved; index += 1; }
        }
        return true;
    }
}
pub fn encode_record(record: Record) -> core::result::Result<alloc::string::String, Error> {
    let writer: Encoder = Encoder { output: alloc::string::new(), error: Error::AllocationFailed };
    if (!writer.record(record)) { writer.output.destroy(); return core::result::Err(writer.error); }
    return core::result::Ok(writer.output);
}
pub fn encode(table: Table) -> core::result::Result<alloc::string::String, Error> {
    let writer: Encoder = Encoder { output: alloc::string::new(), error: Error::AllocationFailed };
    let index: i32 = 0;
    while (index < table.rows.len()) {
        if (!writer.cursor(table.row_encoding(index))) { writer.output.destroy(); return core::result::Err(writer.error); }
        index += 1;
    }
    return core::result::Ok(writer.output);
}
