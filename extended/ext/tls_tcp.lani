pub enum Error { Bounds, Allocation, NotTcp, Blocking, NotConnected, Closed, Deadline, CallLimit, Remaining, Clock(std::clock::Error), Io(core::io::Error), Poll(std::poll::Error), Entropy(std::entropy::Error), Engine(ext::tls_connection::Error) }
pub struct HostBudget { remaining_calls: u64, last: core::option::Option<core::time::Instant> }
pub fn host_budget(calls: u64) -> HostBudget { return HostBudget { remaining_calls: calls, last: core::option::None() }; }
pub impl HostBudget {
    pub fn borrow(&self) -> &HostBudget { return self; }
    pub fn remaining(&self) -> u64 { return self.remaining_calls; }
    // Reserve worst-case acquisition/cleanup calls before ownership changes.
    // Unused prepaid credits are not refunded. Never replenish during a task.
    pub fn reserve(&self, calls: u64) -> core::result::Result<i32, Error> {
        if (calls > self.remaining_calls) { return core::result::Err(Error::CallLimit); }
        self.remaining_calls -= calls; return core::result::Ok(0);
    }
    pub fn permit(&self) -> core::result::Result<i32, Error> { return self.reserve(1); }
    pub fn now(&self) -> core::result::Result<core::time::Instant, Error> {
