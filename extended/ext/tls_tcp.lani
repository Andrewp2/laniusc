}
pub struct Progress { sent: i32, received: i32, consumed: i32, pending_wire: i32, pending_input: i32, pending_plaintext: i32, established: bool, peer_closed: bool, local_closed: bool }
pub struct CloseReport { primary: core::option::Option<Error>, close_error: core::option::Option<core::io::Error>, release_attempts: i32, cleanup_calls: u64 }
pub struct Failure { cause: Error, progress: Progress, cleanup: core::option::Option<CloseReport> }
fn empty_progress() -> Progress { return Progress { sent: 0, received: 0, consumed: 0, pending_wire: 0, pending_input: 0, pending_plaintext: 0, established: false, peer_closed: false, local_closed: false }; }
fn failure(e: Error) -> Failure { return Failure { cause: e, progress: empty_progress(), cleanup: core::option::None() }; }
fn valid(v: core::slice::View<u8>) -> bool { return v.start >= 0 && v.length >= 0 && v.start <= 2147483647 - v.length; }
fn valid_deadline(deadline: core::time::Deadline) -> bool { return deadline.instant.ticks.nanos < 1000000000; }
fn part(v: core::slice::View<u8>, at: i32, n: i32) -> core::slice::View<u8> { return core::slice::View { values: v.values, start: v.start + at, length: n }; }
fn host(e: std::linux::Error) -> Error {
    return match(e) { std::linux::Error::System(n) -> Error::Io(core::io::Error::Host(n)), _ -> Error::Io(core::io::Error::InvalidCount) };
}
// One checked getsockopt attempt. Neither metadata nor caller assertions about
// Socket.kind are substituted for the kernel's type/protocol/domain values.
fn socket_option(socket: &std::socket::Socket, option: i32, deadline: core::time::Deadline, budget: &HostBudget) -> core::result::Result<i32, Error> {
    let before: core::result::Result<core::time::Instant, Error> = budget.check(deadline); if (before.is_err()) { return core::result::Err(before.unwrap_err()); }
    let paid: core::result::Result<i32, Error> = budget.permit(); if (paid.is_err()) { return core::result::Err(paid.unwrap_err()); }
    let output: [i32;1] = [0;1]; let length: [i32;1] = [4;1];
    let args: [std::linux::Argument;5] = [std::linux::Argument::Word(socket.handle as i64),std::linux::Argument::Word(1),std::linux::Argument::Word(option as i64),std::linux::Argument::Address(core::mem::i32_array_data_ptr(output)),std::linux::Argument::Address(core::mem::i32_array_data_ptr(length))];
    let result: core::result::Result<i64, std::linux::Error> = std::linux::call(55,core::slice::View { values: args, start: 0, length: 5 });
    let after: core::result::Result<core::time::Instant, Error> = budget.check(deadline);
    if (result.is_err()) { return core::result::Err(host(result.unwrap_err())); }
    if (result.unwrap() != 0 || length[0] != 4) { return core::result::Err(Error::Io(core::io::Error::InvalidCount)); }
    if (after.is_err()) { return core::result::Err(after.unwrap_err()); } return core::result::Ok(output[0]);
