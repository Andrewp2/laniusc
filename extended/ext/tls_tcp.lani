    let paid: core::result::Result<i32, Error> = budget.permit(); if (paid.is_err()) { return paid; }
    let nonblocking: core::result::Result<bool, core::io::Error> = socket.is_nonblocking(); let after: core::result::Result<core::time::Instant, Error> = budget.check(deadline);
    if (nonblocking.is_err()) { return core::result::Err(Error::Io(nonblocking.unwrap_err())); } if (!nonblocking.unwrap()) { return core::result::Err(Error::Blocking); } if (after.is_err()) { return core::result::Err(after.unwrap_err()); }
    let checked: core::result::Result<core::time::Instant, Error> = budget.check(deadline); if (checked.is_err()) { return core::result::Err(checked.unwrap_err()); }
    let charge: core::result::Result<i32, Error> = budget.permit(); if (charge.is_err()) { return charge; }
    let connected: core::result::Result<core::net::SocketAddr, core::io::Error> = socket.peer_addr(); let end: core::result::Result<core::time::Instant, Error> = budget.check(deadline);
    if (connected.is_err()) { return core::result::Err(Error::Io(connected.unwrap_err())); } if (end.is_err()) { return core::result::Err(end.unwrap_err()); } return core::result::Ok(0);
}
// Exactly 64 fresh OS bytes; no seeded generator, fallback or caller entropy.
fn fresh_entropy(bytes: [u8], deadline: core::time::Deadline, budget: &HostBudget) -> core::result::Result<i32, Error> {
    let filled: i32 = 0; let issue: core::option::Option<Error> = core::option::None();
    while (filled < 64) {
        let checked: core::result::Result<core::time::Instant, Error> = budget.check(deadline); if (checked.is_err()) { issue = core::option::Some(checked.unwrap_err()); break; }
        let paid: core::result::Result<i32, Error> = budget.permit(); if (paid.is_err()) { issue = core::option::Some(paid.unwrap_err()); break; }
        let single: std::entropy::Budget = std::entropy::budget(1); let got: core::result::Result<i32, std::entropy::Error> = std::entropy::read_some(single.borrow(), bytes, filled, 64 - filled);
        let after: core::result::Result<core::time::Instant, Error> = budget.check(deadline);
        if (got.is_ok()) { filled += got.unwrap(); }
        if (after.is_err()) { issue = core::option::Some(after.unwrap_err()); break; }
        if (got.is_err()) { let e: std::entropy::Error = got.unwrap_err(); let interrupted: bool = match(e) { std::entropy::Error::Host(n) -> n == 4, _ -> false };
            if (!interrupted) { issue = core::option::Some(Error::Entropy(e)); break; }
        }
    }
    if (issue.is_some()) { let i: i32 = 0; while (i < 64) { bytes[i] = 0; i += 1; } return core::result::Err(issue.unwrap()); } return core::result::Ok(64);
}
// Seven packed byte allocations (six engine regions plus retained raw input)
// and one typed path workspace. None grows after attachment.
struct Storage { bytes: [alloc::vec::Vec<i32>;7], path: alloc::vec::Vec<ext::x509_path::Slot>, sizes: ext::tls_connection::BufferSizes }
fn storage(sizes: ext::tls_connection::BufferSizes) -> Storage { return Storage { bytes: [alloc::vec::new<i32>();7], path: alloc::vec::new<ext::x509_path::Slot>(), sizes: sizes }; }
impl Storage {
    fn borrow(&self) -> &Storage { return self; }
