    let sizes: core::result::Result<ext::tls_connection::BufferSizes, ext::tls_connection::Error> = ext::tls_connection::required_buffers(limits); if (sizes.is_err()) { return core::result::Err(failure(Error::Engine(sizes.unwrap_err()))); }
