            let checked: core::result::Result<core::time::Instant, Error> = self.checkpoint(deadline, budget);
            if (checked.is_ok()) { let paid: core::result::Result<i32, Error> = budget.permit(); if (paid.is_ok()) {
                let sent: core::result::Result<i32, core::io::Error> = self.socket.send(self.engine.outgoing());
                if (sent.is_ok() && sent.unwrap() > 0) { p.sent += sent.unwrap(); let acknowledged: core::result::Result<i32, ext::tls_connection::Error> = self.engine.acknowledge_written(sent.unwrap()); }
                let observed: core::result::Result<core::time::Instant, Error> = self.checkpoint(deadline, budget);
            } }
        } return self.failed(cause, p, true);
    }
    pub fn try_finish(&self) -> core::result::Result<CloseReport, Error> {
        if (self.report.is_some()) { return core::result::Ok(self.report.unwrap()); }
        let p: Progress = self.progress(); if (!p.established || !p.peer_closed || !p.local_closed || p.pending_wire != 0 || p.pending_input != 0 || p.pending_plaintext != 0 || self.pending_eof || self.pending_error.is_some()) { return core::result::Err(Error::Remaining); }
        return core::result::Ok(self.destroy());
    }
    pub fn read_plaintext(&self, output: core::slice::View<u8>, deadline: core::time::Deadline, budget: &HostBudget) -> core::result::Result<ext::tls_connection::Read, Failure> {
        if (!valid(output) || !valid_deadline(deadline)) { return core::result::Err(failure(Error::Bounds)); } if (!self.is_open()) { return core::result::Err(failure(Error::Closed)); }
        let checked: core::result::Result<core::time::Instant, Error> = self.checkpoint(deadline, budget); if (checked.is_err()) { return core::result::Err(self.stopped(checked.unwrap_err(), self.progress())); }
        if (!self.handshake_success) { return core::result::Err(self.failed(Error::Engine(ext::tls_connection::Error::NotEstablished), self.progress(), false)); }
        // The final clock check precedes publication. No later clock failure
        // can turn an already-mutated destination into an atomic timeout.
        let got: core::result::Result<ext::tls_connection::Read, ext::tls_connection::Error> = self.engine.read_plaintext(output); if (got.is_err()) { if (self.engine.failure().is_some()) { return core::result::Err(self.fatal(Error::Engine(got.unwrap_err()), self.progress(), deadline, budget)); } return core::result::Err(self.failed(Error::Engine(got.unwrap_err()), self.progress(), false)); } return core::result::Ok(got.unwrap());
    }
    pub fn queue_plaintext(&self, input: core::slice::View<u8>, deadline: core::time::Deadline, budget: &HostBudget) -> core::result::Result<i32, Failure> {
        if (!valid(input) || !valid_deadline(deadline)) { return core::result::Err(failure(Error::Bounds)); } if (!self.is_open()) { return core::result::Err(failure(Error::Closed)); }
        let checked: core::result::Result<core::time::Instant, Error> = self.checkpoint(deadline, budget); if (checked.is_err()) { return core::result::Err(self.stopped(checked.unwrap_err(), self.progress())); }
        if (!self.handshake_success) { return core::result::Err(self.failed(Error::Engine(ext::tls_connection::Error::NotEstablished), self.progress(), false)); }
        let queued: core::result::Result<i32, ext::tls_connection::Error> = self.engine.queue_plaintext(input); if (queued.is_err()) { if (self.engine.failure().is_some()) { return core::result::Err(self.fatal(Error::Engine(queued.unwrap_err()), self.progress(), deadline, budget)); } return core::result::Err(self.failed(Error::Engine(queued.unwrap_err()), self.progress(), false)); } return core::result::Ok(queued.unwrap());
    }
    pub fn begin_close(&self) -> core::result::Result<i32, Error> { if (!self.is_open()) { return core::result::Err(Error::Closed); } let got: core::result::Result<i32, ext::tls_connection::Error> = self.engine.begin_close(); if (got.is_err()) { return core::result::Err(Error::Engine(got.unwrap_err())); } return core::result::Ok(got.unwrap()); }
    pub fn request_key_update(&self, request_peer: bool) -> core::result::Result<i32, Error> { if (!self.established()) { return core::result::Err(Error::Closed); } let got: core::result::Result<i32, ext::tls_connection::Error> = self.engine.request_key_update(request_peer); if (got.is_err()) { return core::result::Err(Error::Engine(got.unwrap_err())); } return core::result::Ok(got.unwrap()); }
    pub fn negotiated(&self) -> core::option::Option<ext::tls_connection::Negotiated> { if (!self.established()) { return core::option::None(); } return self.engine.negotiated(); }
    pub fn export(&self, label: core::slice::View<u8>, context: core::slice::View<u8>, output: core::slice::View<u8>, deadline: core::time::Deadline, budget: &HostBudget) -> core::result::Result<i32, Failure> {
        if (!valid(label) || !valid(context) || !valid(output) || !valid_deadline(deadline)) { return core::result::Err(failure(Error::Bounds)); } if (!self.is_open()) { return core::result::Err(failure(Error::Closed)); }
        let checked: core::result::Result<core::time::Instant, Error> = self.checkpoint(deadline, budget); if (checked.is_err()) { return core::result::Err(self.stopped(checked.unwrap_err(), self.progress())); }
        if (!self.handshake_success) { return core::result::Err(self.failed(Error::Engine(ext::tls_connection::Error::NotEstablished), self.progress(), false)); }
        let got: core::result::Result<i32, ext::tls_connection::Error> = self.engine.export(label, context, output); if (got.is_err()) { if (self.engine.failure().is_some()) { return core::result::Err(self.fatal(Error::Engine(got.unwrap_err()), self.progress(), deadline, budget)); } return core::result::Err(self.failed(Error::Engine(got.unwrap_err()), self.progress(), false)); } return core::result::Ok(got.unwrap());
    }
    fn snapshot(&self, p: &Progress) -> Progress { let result: Progress = self.progress(); result.sent = p.sent; result.received = p.received; result.consumed = p.consumed; return result; }
    fn process_pending(&self, deadline: core::time::Deadline, budget: &HostBudget, p: &Progress) -> core::result::Result<bool, Failure> {
        if (self.pending_error.is_some()) { return core::result::Err(self.failed(Error::Io(self.pending_error.unwrap()), self.snapshot(p), true)); }
        if (self.raw_at < self.raw_length) {
            let pending: i32 = self.raw_length - self.raw_at; let feed: core::result::Result<i32, ext::tls_connection::FeedFailure> = self.engine.feed_wire(part(self.storage.view(6), self.raw_at, pending));
            let consumed: i32 = 0; if (feed.is_ok()) { consumed = feed.unwrap(); } else { consumed = feed.unwrap_err().consumed; }
            if (consumed < 0 || consumed > pending) { return core::result::Err(self.failed(Error::Io(core::io::Error::InvalidCount), self.snapshot(p), true)); }
            self.raw_at += consumed; p.consumed += consumed; if (self.raw_at == self.raw_length) { self.raw_at = 0; self.raw_length = 0; }
            if (feed.is_err() && !backpressure(feed.unwrap_err().cause)) { return core::result::Err(self.fatal(Error::Engine(feed.unwrap_err().cause), self.snapshot(p), deadline, budget)); }
            let checked: core::result::Result<core::time::Instant, Error> = self.checkpoint(deadline, budget); if (checked.is_err()) { return core::result::Err(self.stopped(checked.unwrap_err(), self.snapshot(p))); }
            if (feed.is_err() || self.raw_at < self.raw_length) { return core::result::Ok(false); }
        }
        if (self.pending_eof) {
            self.pending_eof = false; let ended: core::result::Result<i32, ext::tls_connection::Error> = self.engine.input_eof();
            if (ended.is_err()) { return core::result::Err(self.fatal(Error::Engine(ended.unwrap_err()), self.snapshot(p), deadline, budget)); }
            let checked: core::result::Result<core::time::Instant, Error> = self.checkpoint(deadline, budget); if (checked.is_err()) { return core::result::Err(self.stopped(checked.unwrap_err(), self.snapshot(p))); }
        } return core::result::Ok(true);
    }
    // One ordinary send/receive/poll/write-shutdown maximum per turn. A fatal
    // engine error may add one best-effort alert send before terminal cleanup.
    pub fn step(&self, deadline: core::time::Deadline, budget: &HostBudget) -> core::result::Result<Progress, Failure> {
        if (!valid_deadline(deadline)) { return core::result::Err(failure(Error::Bounds)); }
        if (!self.is_open()) { return core::result::Err(Failure { cause: core::option::unwrap_or(self.primary, Error::Closed), progress: self.progress(), cleanup: self.report }); }
        let p: Progress = self.progress(); let before: core::result::Result<core::time::Instant, Error> = self.checkpoint(deadline, budget); if (before.is_err()) { return core::result::Err(self.stopped(before.unwrap_err(), p)); }
        let pending: core::result::Result<bool, Failure> = self.process_pending(deadline, budget, p.borrow()); if (pending.is_err()) { return core::result::Err(pending.unwrap_err()); }
        let pumped: core::result::Result<bool, ext::tls_connection::Error> = self.engine.pump(); if (pumped.is_err() && !backpressure(pumped.unwrap_err())) { return core::result::Err(self.fatal(Error::Engine(pumped.unwrap_err()), p, deadline, budget)); }
        let after_pump: core::result::Result<core::time::Instant, Error> = self.checkpoint(deadline, budget); if (after_pump.is_err()) { return core::result::Err(self.stopped(after_pump.unwrap_err(), p)); }
        let output: core::slice::View<u8> = self.engine.outgoing(); let write_wait: bool = false; let read_wait: bool = false;
        if (output.length > 0) {
            let checked: core::result::Result<core::time::Instant, Error> = self.checkpoint(deadline, budget); if (checked.is_err()) { return core::result::Err(self.stopped(checked.unwrap_err(), p)); }
            let paid: core::result::Result<i32, Error> = budget.permit(); if (paid.is_err()) { return core::result::Err(self.stopped(paid.unwrap_err(), p)); }
            let sent: core::result::Result<i32, core::io::Error> = self.socket.send(output);
            let ack_error: core::option::Option<ext::tls_connection::Error> = core::option::None();
            // Confirm physical prefix progress before any fallible post-clock
            // observation. A late completion never replays or reseals it.
            if (sent.is_ok() && sent.unwrap() > 0) {
                p.sent += sent.unwrap(); let ack: core::result::Result<i32, ext::tls_connection::Error> = self.engine.acknowledge_written(sent.unwrap());
                if (ack.is_err()) { ack_error = core::option::Some(ack.unwrap_err()); }
            } else { if (sent.is_ok()) { self.pending_error = core::option::Some(core::io::Error::WriteZero); } else { if (!transient(sent.unwrap_err())) { self.pending_error = core::option::Some(sent.unwrap_err()); } else { write_wait = true; } } }
            let after: core::result::Result<core::time::Instant, Error> = self.checkpoint(deadline, budget);
            if (ack_error.is_some()) { return core::result::Err(self.failed(Error::Engine(ack_error.unwrap()), p, true)); }
            if (self.pending_error.is_some()) { return core::result::Err(self.failed(Error::Io(self.pending_error.unwrap()), p, true)); }
            if (after.is_err()) { return core::result::Err(self.stopped(after.unwrap_err(), p)); }
        }
        // Only read when the fixed raw slot is free and the engine can release
        // its held application record. Output progress still happens above.
        if (pending.unwrap() && self.raw_length == 0 && self.engine.pending_plaintext() == 0 && !self.engine.peer_closed()) {
            let checked: core::result::Result<core::time::Instant, Error> = self.checkpoint(deadline, budget); if (checked.is_err()) { return core::result::Err(self.stopped(checked.unwrap_err(), p)); }
            let paid: core::result::Result<i32, Error> = budget.permit(); if (paid.is_err()) { return core::result::Err(self.stopped(paid.unwrap_err(), p)); }
            let got: core::result::Result<i32, core::io::Error> = self.socket.receive(self.storage.view(6));
            // Store the native event before checking time. Late bytes/EOF are
            // not fed into TLS; an Established caller can resume them exactly.
            if (got.is_ok()) { if (got.unwrap() > 0) { self.raw_length = got.unwrap(); self.raw_at = 0; p.received += got.unwrap(); } else { self.pending_eof = true; } }
            else { if (!transient(got.unwrap_err())) { self.pending_error = core::option::Some(got.unwrap_err()); } else { read_wait = true; } }
            let after: core::result::Result<core::time::Instant, Error> = self.checkpoint(deadline, budget);
            if (self.pending_error.is_some()) { return core::result::Err(self.failed(Error::Io(self.pending_error.unwrap()), p, true)); }
            if (after.is_err()) { return core::result::Err(self.stopped(after.unwrap_err(), p)); }
            let handled: core::result::Result<bool, Failure> = self.process_pending(deadline, budget, p.borrow()); if (handled.is_err()) { return core::result::Err(handled.unwrap_err()); }
        }
        if (self.engine.local_closed() && !self.write_shutdown) {
            let checked: core::result::Result<core::time::Instant, Error> = self.checkpoint(deadline, budget); if (checked.is_err()) { return core::result::Err(self.stopped(checked.unwrap_err(), p)); }
            let paid: core::result::Result<i32, Error> = budget.permit(); if (paid.is_err()) { return core::result::Err(self.stopped(paid.unwrap_err(), p)); }
            let ended: core::result::Result<i32, core::io::Error> = self.socket.shutdown(std::socket::Shutdown::Write); if (ended.is_ok()) { self.write_shutdown = true; }
            let after: core::result::Result<core::time::Instant, Error> = self.checkpoint(deadline, budget);
            if (ended.is_err()) { return core::result::Err(self.failed(Error::Io(ended.unwrap_err()), p, true)); } if (after.is_err()) { return core::result::Err(self.stopped(after.unwrap_err(), p)); }
        }
        if (p.sent == 0 && p.received == 0 && p.consumed == 0 && self.engine.pending_plaintext() == 0 && (read_wait || write_wait)) {
            let checked: core::result::Result<core::time::Instant, Error> = self.checkpoint(deadline, budget); if (checked.is_err()) { return core::result::Err(self.stopped(checked.unwrap_err(), p)); }
            let events: u32 = std::poll::READABLE; if (self.engine.outgoing().length > 0) { events |= std::poll::WRITABLE; }
            let request: [std::poll::Request;1] = [std::poll::Request { handle: self.socket.handle, events: events }]; let paid: core::result::Result<i32, Error> = budget.permit(); if (paid.is_err()) { return core::result::Err(self.stopped(paid.unwrap_err(), p)); }
            let waited: core::result::Result<i32, std::poll::Error> = self.poll.poll_ms(core::slice::View { values: request, start: 0, length: 1 }, timeout_ms(self.deadline(deadline).remaining(checked.unwrap())));
            let after: core::result::Result<core::time::Instant, Error> = self.checkpoint(deadline, budget);
            if (waited.is_err()) { let e: std::poll::Error = waited.unwrap_err(); let interrupted: bool = match(e) { std::poll::Error::Io(inner) -> transient(inner), _ -> false }; if (!interrupted) { return core::result::Err(self.failed(Error::Poll(e), p, true)); } }
            if (after.is_err()) { return core::result::Err(self.stopped(after.unwrap_err(), p)); }
            if (waited.is_ok() && self.poll.readiness(0).unwrap().invalid()) { return core::result::Err(self.failed(Error::Io(core::io::Error::Host(9)), p, true)); }
            // HUP/ERR/read_closed are advisory; the next single receive/send
            // observes EOF or the actual error rather than inventing TLS EOF.
        } return core::result::Ok(self.snapshot(p.borrow()));
    }
}
pub impl Progress { pub fn borrow(&self) -> &Progress { return self; } }
