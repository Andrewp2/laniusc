    let packed: core::result::Result<alloc::vec::Vec<i32>, alloc::vec::Error> = alloc::vec::with_capacity(2); if (packed.is_err()) { return core::result::Err(acquired_failure(Error::Poll(std::poll::Error::AllocationFailed), owned.borrow(), core::option::None(), core::option::None())); }
    let poll: std::poll::PollSet = std::poll::PollSet { scratch: packed.unwrap(), results: alloc::vec::new<std::poll::Readiness>(), published: 0 };
    let initialized: core::result::Result<i32, alloc::vec::Error> = poll.scratch.try_resize(2, 0); if (initialized.is_err()) { return core::result::Err(acquired_failure(Error::Poll(std::poll::Error::AllocationFailed), owned.borrow(), core::option::Some(poll), core::option::None())); }
    let between_poll: core::result::Result<core::time::Instant, Error> = budget.check(deadline); if (between_poll.is_err()) { return core::result::Err(acquired_failure(between_poll.unwrap_err(), owned.borrow(), core::option::Some(poll), core::option::None())); }
    let results: core::result::Result<alloc::vec::Vec<std::poll::Readiness>, alloc::vec::Error> = alloc::vec::with_capacity(1); if (results.is_err()) { return core::result::Err(acquired_failure(Error::Poll(std::poll::Error::AllocationFailed), owned.borrow(), core::option::Some(poll), core::option::None())); } poll.results = results.unwrap();
    let filled: core::result::Result<i32, alloc::vec::Error> = poll.results.try_resize(1, std::poll::Readiness { bits: 0 }); if (filled.is_err()) { return core::result::Err(acquired_failure(Error::Poll(std::poll::Error::AllocationFailed), owned.borrow(), core::option::Some(poll), core::option::None())); }
    let checked_after_allocation: core::result::Result<core::time::Instant, Error> = budget.check(deadline); if (checked_after_allocation.is_err()) { return core::result::Err(acquired_failure(checked_after_allocation.unwrap_err(), owned.borrow(), core::option::Some(poll), core::option::None())); }
    let entropy: [u8;64] = [0;64]; let random: core::result::Result<i32, Error> = fresh_entropy(entropy, deadline, budget); if (random.is_err()) { return core::result::Err(acquired_failure(random.unwrap_err(), owned.borrow(), core::option::Some(poll), core::option::None())); }
    let random_view: core::slice::View<u8> = core::slice::View { values: entropy, start: 0, length: 64 };
    let made: core::result::Result<ext::tls_connection::Engine, ext::tls_connection::Error> = core::result::Err(ext::tls_connection::Error::InvalidConfig);
    if (client.is_some()) { made = ext::tls_connection::client(client.unwrap(), owned.buffers(), random_view); } else { made = ext::tls_connection::server(server.unwrap(), owned.buffers(), random_view); }
    let i: i32 = 0; while (i < 64) { entropy[i] = 0; i += 1; }
    let after: core::result::Result<core::time::Instant, Error> = budget.check(deadline);
    if (made.is_err()) { return core::result::Err(acquired_failure(Error::Engine(made.unwrap_err()), owned.borrow(), core::option::Some(poll), core::option::None())); }
    if (after.is_err()) { return core::result::Err(acquired_failure(after.unwrap_err(), owned.borrow(), core::option::Some(poll), core::option::Some(made.unwrap()))); }
    let taken: core::option::Option<i32> = socket.take_handle(); if (taken.is_none()) { return core::result::Err(acquired_failure(Error::Closed, owned.borrow(), core::option::Some(poll), core::option::Some(made.unwrap()))); }
    return core::result::Ok(Connection { socket: std::socket::Socket { handle: taken.unwrap(), domain: socket.domain, datagram: false }, poll: poll, storage: owned, engine: made.unwrap(), active: true, handshake_deadline: deadline, handshake_success: false, last: budget.last, raw_at: 0, raw_length: 0, pending_eof: false, pending_error: core::option::None(), write_shutdown: false, primary: core::option::None(), report: core::option::None() });
}
pub fn attach_client(socket: &std::socket::Socket, config: ext::tls_connection::ClientConfig, deadline: core::time::Deadline, budget: &HostBudget) -> core::result::Result<Connection, Failure> { return attach(socket, core::option::Some(config), core::option::None(), deadline, budget); }
pub fn attach_server(socket: &std::socket::Socket, config: ext::tls_connection::ServerConfig, deadline: core::time::Deadline, budget: &HostBudget) -> core::result::Result<Connection, Failure> { return attach(socket, core::option::None(), core::option::Some(config), deadline, budget); }
fn backpressure(e: ext::tls_connection::Error) -> bool { return match(e) { ext::tls_connection::Error::WantInput -> true, ext::tls_connection::Error::WantOutput -> true, ext::tls_connection::Error::WantRead -> true, _ -> false }; }
fn transient(e: core::io::Error) -> bool { return match(e) { core::io::Error::Interrupted -> true, core::io::Error::WouldBlock -> true, _ -> false }; }
fn timeout_ms(span: core::time::Duration) -> i32 { if (span.seconds > 2147483) { return 2147483647; } let n: u64 = span.seconds * 1000 + ((span.nanos as u64) + 999999) / 1000000; if (n > 2147483647) { return 2147483647; } return n as i32; }
