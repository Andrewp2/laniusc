    let reserved: core::result::Result<i32, Error> = budget.reserve(21); if (reserved.is_err()) { return core::result::Err(failure(reserved.unwrap_err())); }
    let owned: Storage = storage(sizes.unwrap()); let allocated: core::result::Result<i32, Error> = owned.allocate(deadline, budget); if (allocated.is_err()) { return core::result::Err(acquired_failure(allocated.unwrap_err(), owned.borrow(), core::option::None(), core::option::None())); }
