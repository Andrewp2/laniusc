    fn allocate(&self, deadline: core::time::Deadline, budget: &HostBudget) -> core::result::Result<i32, Error> {
        let i: i32 = 0; while (i < 7) { let checked: core::result::Result<core::time::Instant, Error> = budget.check(deadline); if (checked.is_err()) { return core::result::Err(checked.unwrap_err()); } let n: i32 = self.length(i); if (n <= 0 || n > 2147483644) { return core::result::Err(Error::Bounds); }
            let made: core::result::Result<alloc::vec::Vec<i32>, alloc::vec::Error> = alloc::vec::with_capacity((n + 3) / 4); if (made.is_err()) { return core::result::Err(Error::Allocation); } self.bytes[i] = made.unwrap();
            let filled: core::result::Result<i32, alloc::vec::Error> = self.bytes[i].try_resize((n + 3) / 4, 0); if (filled.is_err()) { return core::result::Err(Error::Allocation); } i += 1;
        }
        let checked: core::result::Result<core::time::Instant, Error> = budget.check(deadline); if (checked.is_err()) { return core::result::Err(checked.unwrap_err()); }
        let allocated: core::result::Result<alloc::vec::Vec<ext::x509_path::Slot>, alloc::vec::Error> = alloc::vec::with_capacity(self.sizes.path); if (allocated.is_err()) { return core::result::Err(Error::Allocation); } self.path = allocated.unwrap();
        let initialized: core::result::Result<i32, alloc::vec::Error> = self.path.try_resize(self.sizes.path, ext::x509_path::empty_slot()); if (initialized.is_err()) { return core::result::Err(Error::Allocation); } return core::result::Ok(0);
    }
    fn view(&self, i: i32) -> core::slice::View<u8> { return core::slice::View { values: core::mem::typed_slice_from_raw_parts(core::mem::i32_slice_data_ptr(self.bytes[i].as_slice()), self.length(i)), start: 0, length: self.length(i) }; }
    fn buffers(&self) -> ext::tls_connection::Buffers { return ext::tls_connection::Buffers { record: self.view(0), decrypt: self.view(1), handshake: self.view(2), hello: self.view(3), pending_wire: self.view(4), application: self.view(5), path: self.path.as_view() }; }
    fn release(&self) -> i32 { let n: i32 = 0; let i: i32 = 0; while (i < 7) { if (self.bytes[i].capacity() > 0) { n += 1; } self.bytes[i].destroy(); i += 1; } if (self.path.capacity() > 0) { n += 1; } self.path.destroy(); return n; }
}
pub struct Connection {
    socket: std::socket::Socket, poll: std::poll::PollSet, storage: Storage,
    engine: ext::tls_connection::Engine, active: bool,
    handshake_deadline: core::time::Deadline, handshake_success: bool,
    last: core::option::Option<core::time::Instant>, raw_at: i32, raw_length: i32,
    pending_eof: bool, pending_error: core::option::Option<core::io::Error>,
    write_shutdown: bool, primary: core::option::Option<Error>, report: core::option::Option<CloseReport>
}
fn acquired_failure(e: Error, owned: &Storage, poll: core::option::Option<std::poll::PollSet>, engine: core::option::Option<ext::tls_connection::Engine>) -> Failure {
