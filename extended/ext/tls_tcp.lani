    pub fn check(&self, deadline: core::time::Deadline) -> core::result::Result<core::time::Instant, Error> {
        if (deadline.instant.ticks.nanos >= 1000000000) { return core::result::Err(Error::Bounds); }
        let read: core::result::Result<core::time::Instant, Error> = self.now(); if (read.is_err()) { return read; }
