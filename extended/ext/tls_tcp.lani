    return Failure { cause: e, progress: empty_progress(), cleanup: core::option::Some(CloseReport { primary: core::option::Some(e), close_error: core::option::None(), release_attempts: released, cleanup_calls: released as u64 }) };
}
fn attach(socket: &std::socket::Socket, client: core::option::Option<ext::tls_connection::ClientConfig>, server: core::option::Option<ext::tls_connection::ServerConfig>, deadline: core::time::Deadline, budget: &HostBudget) -> core::result::Result<Connection, Failure> {
