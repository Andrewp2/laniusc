        let read: core::result::Result<core::time::Instant, std::clock::Error> = std::clock::monotonic_now();
        if (read.is_err()) { return core::result::Err(Error::Clock(read.unwrap_err())); } let now: core::time::Instant = read.unwrap();
        if (self.last.is_some() && now.compare(self.last.unwrap()) < 0) { return core::result::Err(Error::Clock(std::clock::Error::ClockReversed)); }
        self.last = core::option::Some(now); return core::result::Ok(now);
