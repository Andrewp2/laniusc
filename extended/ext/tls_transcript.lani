// RFC8446 section4.4.1, explicit SHA256/SHA384. Complete handshake frames.
// Selected-hash transcripts; owned snapshots retain no input backing.
module ext::tls_transcript;
import core::result;
import ext::tls_hash;
import core::slice;
pub enum Error { Bounds, InvalidFrame, SyntheticMessage, InvalidHrrState, LengthOverflow, Hash }
pub struct State { hash: ext::tls_hash::State, count: u64, first: u8, hrr: bool }
fn valid(value: core::slice::View<u8>) -> bool { return value.start >= 0 && value.length >= 0 && value.start <= 2147483647-value.length; }
fn framed(value: core::slice::View<u8>) -> bool {
    if (value.length < 4) { return false; }
    let at: i32 = value.start;
    let length: i32 = ((value.values[at+1] as i32) << 16) | ((value.values[at+2] as i32) << 8) | (value.values[at+3] as i32);
    return value.length == length+4;
}
pub fn new(algorithm: ext::tls_hash::Algorithm) -> State { return State { hash: ext::tls_hash::new(algorithm), count: 0, first: 0, hrr: false }; }
pub impl State {
    pub fn borrow(&self) -> &State { return self; }
    pub fn algorithm(&self) -> ext::tls_hash::Algorithm { return self.hash.algorithm(); }
    pub fn messages(&self) -> u64 { return self.count; }
    pub fn used_hrr(&self) -> bool { return self.hrr; }
    // Snapshot owns independent digest bytes and never finishes this state.
    pub fn snapshot(&self) -> ext::tls_hash::Digest { return self.hash.snapshot(); }
    // Exactly one complete type/u24-length/body frame. No semantic sequencing.
    // Input must be physically backed, immutable and disjoint from self.
    pub fn update(&self, message: core::slice::View<u8>) -> core::result::Result<i32, Error> {
        if (!valid(message)) { return core::result::Err(Error::Bounds); }
        if (!framed(message)) { return core::result::Err(Error::InvalidFrame); }
        if (message.values[message.start] == 254) { return core::result::Err(Error::SyntheticMessage); }
        if (self.count == 18446744073709551615) { return core::result::Err(Error::LengthOverflow); }
        let next: ext::tls_hash::State = self.hash;
        let updated: core::result::Result<i32, ext::tls_hash::Error> = next.update(message);
        if (core::result::is_err(updated)) { return core::result::Err(Error::LengthOverflow); }
        self.hash = next; if (self.count == 0) { self.first = message.values[message.start]; }
        self.count += 1; return core::result::Ok(message.length);
    }
    // Validates the HRR magic random; the handshake codec/state machine must
    // validate the remaining ServerHello schema, extensions and sequencing.
    // Hash(CH1) is replaced by synthetic message_hash, then HRR is appended.
    pub fn rewrite_for_hrr(&self, hrr: core::slice::View<u8>) -> core::result::Result<i32, Error> {
        if (!valid(hrr)) { return core::result::Err(Error::Bounds); }
        if (!framed(hrr) || hrr.length < 38 || hrr.values[hrr.start] != 2) { return core::result::Err(Error::InvalidFrame); }
        let magic: [u8; 32] = [207,33,173,116,229,154,97,17,190,29,140,2,30,101,184,145,194,162,17,22,122,187,140,94,7,158,9,226,200,168,51,156];
        let checked: i32 = 0; while (checked < 32) { if (hrr.values[hrr.start+6+checked] != magic[checked]) { return core::result::Err(Error::InvalidFrame); } checked += 1; }
        if (self.hrr || self.count != 1 || self.first != 1) { return core::result::Err(Error::InvalidHrrState); }
        let previous: ext::tls_hash::Digest = self.snapshot(); let length: i32 = ext::tls_hash::hash_length(previous.algorithm); let synthetic: [u8; 52] = [0; 52]; synthetic[0] = 254; synthetic[3] = length as u8;
        let index: i32 = 0; while (index < length) { synthetic[4+index] = previous.bytes[index]; index += 1; }
        let replacement: ext::tls_hash::State = ext::tls_hash::new(self.algorithm());
        let first: core::result::Result<i32, ext::tls_hash::Error> = replacement.update(core::slice::View { values: synthetic, start: 0, length: 4+length });
        if (core::result::is_err(first)) { return core::result::Err(Error::Hash); }
        let second: core::result::Result<i32, ext::tls_hash::Error> = replacement.update(hrr);
        if (core::result::is_err(second)) { return core::result::Err(Error::LengthOverflow); }
        self.hash = replacement; self.count = 2; self.hrr = true; return core::result::Ok(hrr.length);
    }
}
