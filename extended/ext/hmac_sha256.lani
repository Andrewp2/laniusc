// RFC 2104 section 2 with SHA-256 only. Full 32-byte tags; no allocation.
// This module does not provide tag verification or secure memory erasure.
module ext::hmac_sha256;
import core::option;
import core::result;
import core::sha256;
import core::slice;

pub enum Error { Bounds, LengthOverflow, Finished }
pub struct State {
    inner: core::sha256::State,
    inner_seed: core::sha256::State,
    outer_seed: core::sha256::State,
    finished: bool,
    result: core::sha256::Digest
}
fn valid(input: core::slice::View<u8>) -> bool {
    return input.start >= 0 && input.length >= 0 && input.start <= 2147483647 - input.length;
}
fn hash_error(error: core::sha256::Error) -> Error {
    return match (error) {
        core::sha256::Error::Bounds -> Error::Bounds,
        core::sha256::Error::LengthOverflow -> Error::LengthOverflow,
        core::sha256::Error::Finished -> Error::Finished
    };
}
pub fn new(key: core::slice::View<u8>) -> core::result::Result<State, Error> {
    if (!valid(key)) { return core::result::Err(Error::Bounds); }
    let block: [u8; 64] = [0; 64];
    let index: i32 = 0;
    if (key.len() > 64) {
        let hashed: core::result::Result<core::sha256::Digest, core::sha256::Error> = core::sha256::digest(key);
        if (core::result::is_err(hashed)) { return core::result::Err(hash_error(core::result::unwrap_err(hashed))); }
        let shortened: core::sha256::Digest = core::result::unwrap(hashed);
        while (index < 32) { block[index] = shortened.bytes[index]; index += 1; }
    } else {
        while (index < key.len()) { block[index] = core::option::unwrap(key.get(index)); index += 1; }
    }
    let inner_pad: [u8; 64] = [0; 64]; let outer_pad: [u8; 64] = [0; 64]; index = 0;
    while (index < 64) { inner_pad[index] = block[index] ^ 54; outer_pad[index] = block[index] ^ 92; index += 1; }
    let inner: core::sha256::State = core::sha256::new(); let outer: core::sha256::State = core::sha256::new();
    // Both fresh contexts accept these fixed, physically backed 64-byte views.
    core::result::unwrap(inner.update(core::slice::View { values: inner_pad, start: 0, length: 64 }));
    core::result::unwrap(outer.update(core::slice::View { values: outer_pad, start: 0, length: 64 }));
    let zero: [u8; 32] = [0; 32]; let result: core::sha256::Digest = core::sha256::Digest { bytes: zero, length: 32 };
    return core::result::Ok(State { inner: inner, inner_seed: inner, outer_seed: outer, finished: false, result: result });
}
pub impl State {
    pub fn borrow(&self) -> &State { return self; }
    // Logical bounds precede Finished. SHA-256 checks its complete accumulated
    // length, including the inner pad, before accepting any message bytes.
    pub fn update(&self, input: core::slice::View<u8>) -> core::result::Result<i32, Error> {
        if (!valid(input)) { return core::result::Err(Error::Bounds); }
        if (self.finished) { return core::result::Err(Error::Finished); }
        let updated: core::result::Result<i32, core::sha256::Error> = self.inner.update(input);
        if (core::result::is_err(updated)) { return core::result::Err(hash_error(core::result::unwrap_err(updated))); }
        return core::result::Ok(core::result::unwrap(updated));
    }
    // Return an independent digest value. Finishing again returns the same tag.
    pub fn finish(&self) -> core::sha256::Digest {
        if (!self.finished) {
            let middle: core::sha256::Digest = self.inner.finish();
            let outer: core::sha256::State = self.outer_seed;
            core::result::unwrap(outer.update(core::slice::View { values: middle.bytes, start: 0, length: 32 }));
            self.result = outer.finish(); self.finished = true;
        }
        return self.result;
    }
    // Restore the keyed seed, with no retained borrow of the original key.
    pub fn reset(&self) { self.inner = self.inner_seed; self.finished = false; }
}
pub fn authenticate(key: core::slice::View<u8>, message: core::slice::View<u8>) -> core::result::Result<core::sha256::Digest, Error> {
    if (!valid(key) || !valid(message)) { return core::result::Err(Error::Bounds); }
    let made: core::result::Result<State, Error> = new(key);
    if (core::result::is_err(made)) { return core::result::Err(core::result::unwrap_err(made)); }
    let state: State = core::result::unwrap(made);
    let updated: core::result::Result<i32, Error> = state.update(message);
    if (core::result::is_err(updated)) { return core::result::Err(core::result::unwrap_err(updated)); }
    return core::result::Ok(state.finish());
}
