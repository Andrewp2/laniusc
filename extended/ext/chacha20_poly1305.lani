// RFC 8439 sections 2.6/2.8: IETF ChaCha20-Poly1305, full 16-byte tag.
// https://www.rfc-editor.org/rfc/rfc8439.html
module ext::chacha20_poly1305;
import core::chacha20;
import core::poly1305;
import core::result;
import core::slice;

pub enum Error { Bounds, InvalidKeyLength, InvalidNonceLength, InvalidTagLength, BufferTooSmall, AuthenticationFailed }
fn valid(value: core::slice::View<u8>) -> bool {
    return value.start >= 0 && value.length >= 0 && value.start <= 2147483647-value.length;
}
// Call only after complete public preflight. All local views are physically
// backed. An i32 payload starting at counter 1 cannot exhaust ChaCha20.
fn tag_for(key: core::slice::View<u8>, nonce: core::slice::View<u8>, aad: core::slice::View<u8>, ciphertext: core::slice::View<u8>) -> core::poly1305::Tag {
    let block: [u8; 64] = [0; 64];
    core::result::unwrap(core::chacha20::block(key, nonce, 0, core::slice::View { values: block, start: 0, length: 64 }));
    let state: core::poly1305::State = core::result::unwrap(core::poly1305::new(core::slice::View { values: block, start: 0, length: 32 }));
    let zero: [u8; 16] = [0; 16];
    core::result::unwrap(state.update(aad));
    let padding: i32 = (16-aad.length%16)%16;
    core::result::unwrap(state.update(core::slice::View { values: zero, start: 0, length: padding }));
    core::result::unwrap(state.update(ciphertext));
    padding = (16-ciphertext.length%16)%16;
    core::result::unwrap(state.update(core::slice::View { values: zero, start: 0, length: padding }));
    let lengths: [u8; 16] = [0; 16]; let index: i32 = 0;
    while (index < 8) {
        lengths[index] = (((aad.length as u64) >> (index*8)) & 255) as u8;
        lengths[8+index] = (((ciphertext.length as u64) >> (index*8)) & 255) as u8;
        index += 1;
    }
    core::result::unwrap(state.update(core::slice::View { values: lengths, start: 0, length: 16 }));
    return state.finish();
}
// All logical views are validated before fixed lengths and output capacity.
// Callers supply physical backing and a fresh nonce for each seal under a key.
// Payload input/output may name exactly the same logical cells or be disjoint;
// partial overlap is unsupported. Output/tag must be disjoint from key, nonce,
// AAD and each other; tag_output must also be disjoint from plaintext input.
// Views do not establish ownership or detect aliases.
pub fn seal_into(key: core::slice::View<u8>, nonce: core::slice::View<u8>, aad: core::slice::View<u8>, input: core::slice::View<u8>, output: core::slice::View<u8>, tag_output: core::slice::View<u8>) -> core::result::Result<i32, Error> {
    if (!valid(key) || !valid(nonce) || !valid(aad) || !valid(input) || !valid(output) || !valid(tag_output)) { return core::result::Err(Error::Bounds); }
    if (key.length != 32) { return core::result::Err(Error::InvalidKeyLength); }
    if (nonce.length != 12) { return core::result::Err(Error::InvalidNonceLength); }
    if (tag_output.length != 16) { return core::result::Err(Error::InvalidTagLength); }
    if (output.length < input.length) { return core::result::Err(Error::BufferTooSmall); }
    core::result::unwrap(core::chacha20::xor_into(key, nonce, 1, input, output));
    let ciphertext: core::slice::View<u8> = core::slice::View { values: output.values, start: output.start, length: input.length };
    let tag: core::poly1305::Tag = tag_for(key, nonce, aad, ciphertext); let index: i32 = 0;
    while (index < 16) { tag_output.values[tag_output.start+index] = tag.bytes[index]; index += 1; }
    return core::result::Ok(input.length);
}
// Authentication reads all 16 tag bytes before any destination write. The XOR/
// OR comparison has no mismatch exit; this is not a compiler timing guarantee.
// The same backing/overlap requirements as seal_into apply; output must also
// be disjoint from the supplied tag. Every error preserves the destination.
pub fn open_into(key: core::slice::View<u8>, nonce: core::slice::View<u8>, aad: core::slice::View<u8>, ciphertext: core::slice::View<u8>, tag: core::slice::View<u8>, output: core::slice::View<u8>) -> core::result::Result<i32, Error> {
    if (!valid(key) || !valid(nonce) || !valid(aad) || !valid(ciphertext) || !valid(tag) || !valid(output)) { return core::result::Err(Error::Bounds); }
    if (key.length != 32) { return core::result::Err(Error::InvalidKeyLength); }
    if (nonce.length != 12) { return core::result::Err(Error::InvalidNonceLength); }
    if (tag.length != 16) { return core::result::Err(Error::InvalidTagLength); }
    if (output.length < ciphertext.length) { return core::result::Err(Error::BufferTooSmall); }
    let expected: core::poly1305::Tag = tag_for(key, nonce, aad, ciphertext);
    let difference: u8 = 0; let index: i32 = 0;
    while (index < 16) { difference |= expected.bytes[index] ^ tag.values[tag.start+index]; index += 1; }
    if (difference != 0) { return core::result::Err(Error::AuthenticationFailed); }
    core::result::unwrap(core::chacha20::xor_into(key, nonce, 1, ciphertext, output));
    return core::result::Ok(ciphertext.length);
}
