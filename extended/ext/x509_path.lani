// Bounded ordered Ed25519 TLS-server paths with explicit configured anchors.
// No path building, revocation, normalized DN matching or general PKIX policy.
module ext::x509_path;
import core::calendar;
import core::option;
import core::result;
import core::slice;
import core::time;
import ext::der;
import ext::ed25519;
import ext::service_identity;
import ext::x509;

pub enum ErrorKind {
    Bounds, EmptyChain, EmptyAnchors, ChainLimit, AnchorLimit, InputLimit,
    ScratchTooSmall, InvalidTime, Parse, ItemLimit, WorkLimit, SignatureLimit,
    Duplicate, UnsupportedAlgorithm, IssuerMismatch, Untrusted, InvalidSignature,
    Validity, CaRequired, KeyUsage, ExtendedKeyUsage, PathLength, UnknownCritical,
    UnsupportedConstraint, UnsupportedCritical, Identity
}
// certificate is a peer index, anchor a configured-anchor index, or -1 when
// inapplicable. offset is logical within that certificate, never an address.
pub struct Error { kind: ErrorKind, certificate: i32, anchor: i32, offset: i32 }
pub struct Limits { max_chain: i32, max_anchors: i32, max_input: u64, max_signatures: u64, max_work: u64, parsing: ext::x509::Limits }
pub struct Budget { parsing: ext::x509::Budget, signatures_left: u64, work_left: u64, limits: Limits }
pub struct Slot { certificate: core::option::Option<ext::x509::Certificate> }
pub struct ValidatedServer { public_key: ext::ed25519::Key32, anchor_index: i32, chain_length: i32 }
pub fn empty_slot() -> Slot { return Slot { certificate: core::option::None() }; }
pub fn default_limits() -> Limits {
    return Limits { max_chain: 8, max_anchors: 8, max_input: 1048576, max_signatures: 64, max_work: 16777216, parsing: ext::x509::default_limits() };
}
fn error(kind: ErrorKind, certificate: i32, anchor: i32, offset: i32) -> Error { return Error { kind: kind, certificate: certificate, anchor: anchor, offset: offset }; }
pub fn budget(limits: Limits) -> core::result::Result<Budget, Error> {
    if (limits.max_chain < 0 || limits.max_anchors < 0 || limits.max_chain > 2147483647 - limits.max_anchors || limits.parsing.max_input < 0) { return core::result::Err(error(ErrorKind::Bounds, -1, -1, 0)); }
    return core::result::Ok(Budget { parsing: ext::x509::budget(limits.parsing).unwrap(), signatures_left: limits.max_signatures, work_left: limits.max_work, limits: limits });
}
pub impl Budget { pub fn borrow(&self) -> &Budget { return self; } }
fn valid(v: core::slice::View<u8>) -> bool { return v.start >= 0 && v.length >= 0 && v.start <= 2147483647 - v.length; }
fn byte(v: core::slice::View<u8>, i: i32) -> u8 { return v.values[v.start + i]; }
struct Context { budget: &Budget, ci: i32, ai: i32, failed: bool, issue: Error }
fn context(b: &Budget, ci: i32, ai: i32) -> Context { return Context { budget: b, ci: ci, ai: ai, failed: false, issue: error(ErrorKind::Parse, ci, ai, 0) }; }
impl Context {
    fn borrow(&self) -> &Context { return self; }
    fn fail(&self, kind: ErrorKind, at: i32) { if (!self.failed) { self.failed = true; self.issue = error(kind, self.ci, self.ai, at); } }
    fn work(&self, n: u64, at: i32) -> bool {
        if (self.failed) { return false; }
        if (n > self.budget.work_left) { self.fail(ErrorKind::WorkLimit, at); return false; }
        self.budget.work_left -= n; return true;
    }
    fn parsed(&self, e: ext::x509::Error) {
        let kind: ErrorKind = match (e.kind) { ext::x509::ErrorKind::Bounds -> ErrorKind::Bounds, ext::x509::ErrorKind::InputLimit -> ErrorKind::InputLimit, ext::x509::ErrorKind::ItemLimit -> ErrorKind::ItemLimit, ext::x509::ErrorKind::WorkLimit -> ErrorKind::WorkLimit, _ -> ErrorKind::Parse };
        self.fail(kind, e.offset);
    }
    fn same(&self, a: core::slice::View<u8>, b: core::slice::View<u8>) -> bool {
        if (!self.work((a.length as u64) + (b.length as u64) + 1, 0)) { return false; }
        if (a.length != b.length) { return false; }
        let i: i32 = 0; while (i < a.length) { if (byte(a, i) != byte(b, i)) { return false; } i += 1; } return true;
    }
}
fn resource(kind: ErrorKind) -> bool { return match (kind) { ErrorKind::InputLimit -> true, ErrorKind::ItemLimit -> true, ErrorKind::WorkLimit -> true, ErrorKind::SignatureLimit -> true, _ -> false }; }
// These fixed OID predicates only operate on parser-produced immutable records.
fn ed(oid: ext::der::Oid) -> bool { let b: core::slice::View<u8> = oid.bytes; return b.length == 3 && byte(b, 0) == 43 && byte(b, 1) == 101 && byte(b, 2) == 112; }
fn extension_number(oid: ext::der::Oid) -> i32 { let b: core::slice::View<u8> = oid.bytes; if (b.length == 3 && byte(b, 0) == 85 && byte(b, 1) == 29) { return byte(b, 2) as i32; } return -1; }
fn access_info(oid: ext::der::Oid) -> bool { let b: core::slice::View<u8> = oid.bytes; return b.length == 8 && byte(b, 0) == 43 && byte(b, 1) == 6 && byte(b, 2) == 1 && byte(b, 3) == 5 && byte(b, 4) == 5 && byte(b, 5) == 7 && byte(b, 6) == 1 && byte(b, 7) == 1; }
fn server_purpose(oid: ext::der::Oid) -> bool {
    let b: core::slice::View<u8> = oid.bytes;
    if (b.length == 4 && byte(b, 0) == 85 && byte(b, 1) == 29 && byte(b, 2) == 37 && byte(b, 3) == 0) { return true; }
    return b.length == 8 && byte(b, 0) == 43 && byte(b, 1) == 6 && byte(b, 2) == 1 && byte(b, 3) == 5 && byte(b, 4) == 5 && byte(b, 5) == 7 && byte(b, 6) == 3 && byte(b, 7) == 1;
}
fn civil(t: ext::der::X509Time) -> core::calendar::LocalDateTime {
    return core::calendar::LocalDateTime { date: core::calendar::Date { year: t.year, month: t.month, day: t.day }, time: core::calendar::TimeOfDay { hour: t.hour, minute: t.minute, second: t.second, nanos: 0 } };
}
fn lifetime(cert: ext::x509::Certificate, now: core::calendar::LocalDateTime, p: &Context) {
    if (!p.work(19, cert.validity.encoded.start - cert.encoded.start)) { return; }
    let first: core::calendar::LocalDateTime = civil(cert.validity.not_before); let last: core::calendar::LocalDateTime = civil(cert.validity.not_after);
    if (first.compare(last) > 0 || now.compare(first) < 0 || now.compare(last) > 0) { p.fail(ErrorKind::Validity, cert.validity.encoded.start - cert.encoded.start); }
}
fn public_algorithm(cert: ext::x509::Certificate, p: &Context) {
    if (!p.work((cert.spki.algorithm.oid.bytes.length as u64) + 1, cert.spki.encoded.start - cert.encoded.start)) { return; }
    if (!ed(cert.spki.algorithm.oid) || cert.spki.algorithm.parameters.is_some() || cert.spki.key.unused_bits != 0 || cert.spki.key.bytes.length != 32) { p.fail(ErrorKind::UnsupportedAlgorithm, cert.spki.encoded.start - cert.encoded.start); }
}
struct Policy { path_length: core::option::Option<ext::der::Element> }
fn policy(cert: ext::x509::Certificate, ca: bool, now: core::calendar::LocalDateTime, p: &Context) -> Policy {
    let result: Policy = Policy { path_length: core::option::None() }; lifetime(cert, now, p); public_algorithm(cert, p);
    let is_ca: bool = false; let extensions: ext::x509::Extensions = cert.extensions();
    while (!p.failed) {
        let got: core::result::Result<core::option::Option<ext::x509::Extension>, ext::x509::Error> = extensions.next(p.budget.parsing.borrow());
        if (got.is_err()) { p.parsed(got.unwrap_err()); break; }
        let next: core::option::Option<ext::x509::Extension> = got.unwrap(); if (next.is_none()) { break; }
        let e: ext::x509::Extension = next.unwrap(); let at: i32 = e.encoded.start - cert.encoded.start;
        if (!p.work((e.oid.bytes.length as u64) + 1, at)) { break; }
        let n: i32 = extension_number(e.oid);
        if (n == 30 || n == 32 || n == 33 || n == 36 || n == 54) { p.fail(ErrorKind::UnsupportedConstraint, at); }
        else { if (n == 19) {
            let checked: core::result::Result<ext::x509::BasicConstraints, ext::x509::Error> = e.basic_constraints(p.budget.parsing.borrow());
            if (checked.is_err()) { p.parsed(checked.unwrap_err()); } else { is_ca = checked.unwrap().ca; result.path_length = checked.unwrap().path_length; }
        } else { if (n == 15) {
            let checked: core::result::Result<ext::x509::KeyUsage, ext::x509::Error> = e.key_usage(p.budget.parsing.borrow());
            if (checked.is_err()) { p.parsed(checked.unwrap_err()); } else { let mask: u32 = 1; if (ca) { mask = 32; } if ((checked.unwrap().bits & mask) == 0) { p.fail(ErrorKind::KeyUsage, at); } }
        } else { if (n == 37) {
            let checked: core::result::Result<ext::x509::Oids, ext::x509::Error> = e.extended_key_usage(p.budget.parsing.borrow());
            if (checked.is_err()) { p.parsed(checked.unwrap_err()); } else {
                let oids: ext::x509::Oids = checked.unwrap(); let allowed: bool = false;
                while (!p.failed) { let got_oid: core::result::Result<core::option::Option<ext::der::Oid>, ext::x509::Error> = oids.next(p.budget.parsing.borrow());
                    if (got_oid.is_err()) { p.parsed(got_oid.unwrap_err()); break; } let oid: core::option::Option<ext::der::Oid> = got_oid.unwrap(); if (oid.is_none()) { break; }
                    if (!p.work((oid.unwrap().bytes.length as u64) + 1, at)) { break; } if (server_purpose(oid.unwrap())) { allowed = true; }
                } if (!allowed) { p.fail(ErrorKind::ExtendedKeyUsage, at); }
            }
        } else { if (n == 17) {
            let checked: core::result::Result<ext::x509::GeneralNames, ext::x509::Error> = e.subject_alt_names(p.budget.parsing.borrow());
            if (checked.is_err()) { p.parsed(checked.unwrap_err()); } else {
                let names: ext::x509::GeneralNames = checked.unwrap();
                while (!p.failed) { let named: core::result::Result<core::option::Option<ext::x509::GeneralName>, ext::x509::Error> = names.next(p.budget.parsing.borrow());
                    if (named.is_err()) { p.parsed(named.unwrap_err()); break; } let name: core::option::Option<ext::x509::GeneralName> = named.unwrap(); if (name.is_none()) { break; }
                    if (!p.work(1, at)) { break; } let tag: u32 = name.unwrap().element.tag.number;
                    if (e.critical && tag != 2 && tag != 7) { p.fail(ErrorKind::UnsupportedCritical, at); }
                }
            }
        } else {
            if (e.critical) { p.fail(ErrorKind::UnknownCritical, at); }
            else { if (n != 14 && n != 35 && n != 31 && n != 46 && !access_info(e.oid)) { p.fail(ErrorKind::UnsupportedConstraint, at); } }
        } } } } }
    }
    if (ca && !is_ca) { p.fail(ErrorKind::CaRequired, 0); } return result;
}
fn path_length(value: core::option::Option<ext::der::Element>, below: i32, cert: ext::x509::Certificate, p: &Context) {
    if (value.is_none() || p.failed) { return; } let bytes: core::slice::View<u8> = value.unwrap().content;
    if (!p.work((bytes.length as u64) + 1, bytes.start - cert.encoded.start)) { return; }
    // A positive minimal INTEGER wider than four bytes exceeds every permitted
    // i32 chain count. No conversion overflow or artificial profile size cap.
    if (bytes.length > 4) { return; } let count: u64 = 0; let i: i32 = 0;
    while (i < bytes.length) { count = count * 256 + (byte(bytes, i) as u64); i += 1; }
    if ((below as u64) > count) { p.fail(ErrorKind::PathLength, bytes.start - cert.encoded.start); }
}
fn same_authority(a: ext::x509::Certificate, b: ext::x509::Certificate, p: &Context) -> bool { return p.same(a.subject.element.encoded, b.subject.element.encoded) && p.same(a.spki.encoded, b.spki.encoded); }
fn signature(child: ext::x509::Certificate, issuer: ext::x509::Certificate, p: &Context) {
    if (p.failed) { return; }
    if (!p.work((child.signature_algorithm.oid.bytes.length as u64) + 1, 0)) { return; }
    // Executable algorithm boundary: unsupported algorithms fail explicitly;
    // future RSA/ECDSA verifiers can be added here without changing path policy.
    if (!ed(child.signature_algorithm.oid) || child.signature_algorithm.parameters.is_some()) { p.fail(ErrorKind::UnsupportedAlgorithm, 0); return; }
    if (p.budget.signatures_left == 0) { p.fail(ErrorKind::SignatureLimit, 0); return; }
    if (!p.work((child.tbs.length as u64) + 97, child.tbs.start - child.encoded.start)) { return; }
    p.budget.signatures_left -= 1;
    let verified: core::result::Result<bool, ext::ed25519::Error> = ext::ed25519::verify(issuer.spki.key.bytes, child.tbs, child.signature.bytes);
    if (verified.is_err()) { p.fail(ErrorKind::InvalidSignature, child.signature.bytes.start - child.encoded.start); }
    else { if (!verified.unwrap()) { p.fail(ErrorKind::InvalidSignature, child.signature.bytes.start - child.encoded.start); } }
}
fn get(slots: core::slice::View<Slot>, i: i32) -> ext::x509::Certificate { return slots.values[slots.start + i].certificate.unwrap(); }
pub fn validate_server(chain: core::slice::View<core::slice::View<u8>>, anchors: core::slice::View<core::slice::View<u8>>, reference: ext::service_identity::Reference, unix_time: i64, scratch: core::slice::View<Slot>, budget: &Budget) -> core::result::Result<ValidatedServer, Error> {
    if (chain.start < 0 || chain.length < 0 || chain.start > 2147483647 - chain.length || anchors.start < 0 || anchors.length < 0 || anchors.start > 2147483647 - anchors.length || scratch.start < 0 || scratch.length < 0 || scratch.start > 2147483647 - scratch.length) { return core::result::Err(error(ErrorKind::Bounds, -1, -1, 0)); }
    if (chain.length == 0) { return core::result::Err(error(ErrorKind::EmptyChain, -1, -1, 0)); }
    if (anchors.length == 0) { return core::result::Err(error(ErrorKind::EmptyAnchors, -1, -1, 0)); }
    if (chain.length > budget.limits.max_chain) { return core::result::Err(error(ErrorKind::ChainLimit, -1, -1, 0)); }
    if (anchors.length > budget.limits.max_anchors) { return core::result::Err(error(ErrorKind::AnchorLimit, -1, -1, 0)); }
    if (chain.length > 2147483647 - anchors.length || scratch.length < chain.length + anchors.length) { return core::result::Err(error(ErrorKind::ScratchTooSmall, -1, -1, 0)); }
    if (unix_time < -62135596800 || unix_time > 253402300799) { return core::result::Err(error(ErrorKind::InvalidTime, -1, -1, 0)); }
    let p: Context = context(budget, -1, -1); let total: u64 = 0; let i: i32 = 0;
    // All metadata and aggregate limits precede any byte read or Slot mutation.
    while (i < chain.length + anchors.length) {
        let input: core::slice::View<u8> = chain.values[chain.start];
        if (i < chain.length) { input = chain.values[chain.start + i]; } else { input = anchors.values[anchors.start + i - chain.length]; }
        if (!valid(input)) { return core::result::Err(error(ErrorKind::Bounds, -1, -1, 0)); }
        if ((input.length as u64) > budget.limits.max_input - total || input.length > budget.parsing.max_input) { return core::result::Err(error(ErrorKind::InputLimit, -1, -1, 0)); }
        total += input.length as u64; i += 1;
    }
    if (!p.work(((chain.length as u64) + (anchors.length as u64)) + 1, 0)) { return core::result::Err(p.issue); }
    let converted: core::result::Result<core::calendar::OffsetDateTime, core::calendar::Error> = core::calendar::from_system_time(core::time::SystemTime { seconds: unix_time, nanos: 0 }, core::calendar::utc());
    if (converted.is_err()) { return core::result::Err(error(ErrorKind::InvalidTime, -1, -1, 0)); } let now: core::calendar::LocalDateTime = converted.unwrap().local;
    i = 0;
    while (i < chain.length + anchors.length) {
        let input: core::slice::View<u8> = chain.values[chain.start]; p.ci = i; p.ai = -1;
        if (i < chain.length) { input = chain.values[chain.start + i]; } else { input = anchors.values[anchors.start + i - chain.length]; p.ci = -1; p.ai = i - chain.length; }
        let parsed: core::result::Result<ext::x509::Certificate, ext::x509::Error> = ext::x509::parse(input, budget.parsing.borrow());
        if (parsed.is_err()) { p.parsed(parsed.unwrap_err()); return core::result::Err(p.issue); }
        scratch.values[scratch.start + i] = Slot { certificate: core::option::Some(parsed.unwrap()) }; i += 1;
    }
    // Duplicates/cycles within each list are errors. A cross-list exact final
    // peer root is handled per candidate below, never mistaken for a cycle.
    i = 0;
    while (i < chain.length + anchors.length) {
        let begin: i32 = 0; p.ci = i; p.ai = -1; if (i >= chain.length) { begin = chain.length; p.ci = -1; p.ai = i - chain.length; }
        let j: i32 = begin; while (j < i) { if (same_authority(get(scratch, i), get(scratch, j), p.borrow())) { p.fail(ErrorKind::Duplicate, 0); } if (p.failed) { return core::result::Err(p.issue); } j += 1; } i += 1;
    }
    let below: i32 = 0; i = 0;
    while (i < chain.length) {
        p.ci = i; p.ai = -1; let cert: ext::x509::Certificate = get(scratch, i); let checked: Policy = policy(cert, i != 0, now, p.borrow()); path_length(checked.path_length, below, cert, p.borrow());
        if (p.failed) { return core::result::Err(p.issue); }
        if (i > 0 && !p.same(cert.subject.element.encoded, cert.issuer.element.encoded)) { below += 1; }
        if (p.failed) { return core::result::Err(p.issue); }
        if (i + 1 < chain.length) { let issuer: ext::x509::Certificate = get(scratch, i + 1);
            if (!p.same(cert.issuer.element.encoded, issuer.subject.element.encoded)) { p.fail(ErrorKind::IssuerMismatch, 0); }
            // Check the issuer key's algorithm before feeding its bytes into
            // the signature dispatcher (its full policy follows next loop).
            public_algorithm(issuer, p.borrow()); signature(cert, issuer, p.borrow()); if (p.failed) { return core::result::Err(p.issue); }
        } i += 1;
    }
    let leaf: ext::x509::Certificate = get(scratch, 0); p.ci = 0; p.ai = -1;
    let identity: core::result::Result<bool, ext::service_identity::Error> = ext::service_identity::match_certificate(leaf, reference, budget.parsing.borrow());
    if (identity.is_err()) { let e: ext::service_identity::Error = identity.unwrap_err(); match (e) { ext::service_identity::Error::X509(inner) -> p.parsed(inner), _ -> p.fail(ErrorKind::Identity, 0) }; return core::result::Err(p.issue); }
    if (!identity.unwrap()) { return core::result::Err(error(ErrorKind::Identity, 0, -1, 0)); }
    let best: core::option::Option<Error> = core::option::None(); let a: i32 = 0;
    while (a < anchors.length) {
        let candidate: Context = context(budget, chain.length - 1, a); let anchor: ext::x509::Certificate = get(scratch, chain.length + a); let count: i32 = chain.length;
        if (count > 1 && candidate.same(get(scratch, count - 1).encoded, anchor.encoded)) { count -= 1; }
        if (candidate.failed) { return core::result::Err(candidate.issue); }
        let tail: ext::x509::Certificate = get(scratch, count - 1);
        let linked: bool = candidate.same(tail.issuer.element.encoded, anchor.subject.element.encoded);
        if (candidate.failed) { return core::result::Err(candidate.issue); }
        if (linked) {
            candidate.ci = -1; let anchor_policy: Policy = policy(anchor, true, now, candidate.borrow());
            let intermediate_count: i32 = 0; i = 1;
            while (i < count && !candidate.failed) { let cert: ext::x509::Certificate = get(scratch, i); if (!candidate.same(cert.subject.element.encoded, cert.issuer.element.encoded)) { intermediate_count += 1; } i += 1; }
            path_length(anchor_policy.path_length, intermediate_count, anchor, candidate.borrow());
            i = 0; while (i < count && !candidate.failed) { if (same_authority(get(scratch, i), anchor, candidate.borrow())) { candidate.ci = i; candidate.fail(ErrorKind::Duplicate, 0); } i += 1; }
            // The last common edge was already verified against this exact
            // configured certificate when its peer copy was stripped.
            candidate.ci = count - 1; if (count == chain.length) { signature(tail, anchor, candidate.borrow()); }
            if (!candidate.failed) {
                let bytes: [u8;32] = [0;32]; i = 0; while (i < 32) { bytes[i] = byte(leaf.spki.key.bytes, i); i += 1; }
                return core::result::Ok(ValidatedServer { public_key: ext::ed25519::Key32 { bytes: bytes }, anchor_index: a, chain_length: count });
            }
            if (resource(candidate.issue.kind)) { return core::result::Err(candidate.issue); }
            if (best.is_none()) { best = core::option::Some(candidate.issue); }
        } a += 1;
    }
    if (best.is_some()) { return core::result::Err(best.unwrap()); } return core::result::Err(error(ErrorKind::Untrusted, chain.length - 1, -1, 0));
}
