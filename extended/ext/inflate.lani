// Raw RFC 1951 DEFLATE with caller-owned storage and no heap allocation.
// A streaming decoder borrows its history and Huffman workspace; step does
// not retain input/output views. All backing must remain live and disjoint.
module ext::inflate;
import core::iter_state;
import core::mem;
import core::result;
import core::slice;

pub enum Error { Bounds, UnexpectedEof, InvalidBlockType, InvalidStoredLength, InvalidCodeLengths, InvalidSymbol, InvalidDistance, OutputTooSmall }
pub struct Progress { read: i32, written: i32 }
pub struct Failure { error: Error, read: i32, written: i32 }
pub enum Status { NeedInput, NeedOutput, Done }
pub struct Step { read: i32, written: i32, status: Status }

// Workspace layout: lengths[320], literal counts[16]/symbols[288],
// distance counts[16]/symbols[32], code-length counts[16]/symbols[19].
pub fn workspace_len() -> i32 { return 707; }
// A workspace of at least fast_workspace_len() words also holds two-level
// decode tables (10-bit literal/length and 8-bit distance roots plus
// subtables) and enables the table-driven fast loop; see docs. Smaller
// workspaces keep the bit-serial decoder and touch only the first 707 words.
pub fn fast_workspace_len() -> i32 { return FAST_END; }
const FAST_LITERAL: i32 = 707;
const FAST_DISTANCE: i32 = 6339;
const FAST_END: i32 = 8643;
const LITERAL_ROOT: i32 = 10;
const DISTANCE_ROOT: i32 = 8;
const INVALID_ENTRY: i32 = 64;
const LITERAL_COUNTS: i32 = 320;
const LITERAL_SYMBOLS: i32 = 336;
const DISTANCE_COUNTS: i32 = 624;
const DISTANCE_SYMBOLS: i32 = 640;
const CODE_COUNTS: i32 = 672;
const CODE_SYMBOLS: i32 = 688;

pub enum DecodeEvent { Read, Block(i32), Repeat, TreesReady, Literal, Match, End(bool), Fail, Reset }

pub machine Decoding on DecodeEvent {
    start HeaderFinal;

    state HeaderFinal {
        DecodeEvent::Read -> goto HeaderKind,
        DecodeEvent::Block(kind) -> stay,
        DecodeEvent::Repeat -> stay,
        DecodeEvent::TreesReady -> stay,
        DecodeEvent::Literal -> stay,
        DecodeEvent::Match -> stay,
        DecodeEvent::End(last) -> stay,
        DecodeEvent::Fail -> goto Failed,
        DecodeEvent::Reset -> goto HeaderFinal,
    }

    state HeaderKind {
        DecodeEvent::Read -> stay,
        DecodeEvent::Block(kind) -> { if (kind == 0) { goto StoredLength; } if (kind == 1) { goto BuildTrees; } goto DynamicLiteralCount; },
        DecodeEvent::Repeat -> stay,
        DecodeEvent::TreesReady -> stay,
        DecodeEvent::Literal -> stay,
        DecodeEvent::Match -> stay,
        DecodeEvent::End(last) -> stay,
        DecodeEvent::Fail -> goto Failed,
        DecodeEvent::Reset -> goto HeaderFinal,
    }

    state StoredLength {
        DecodeEvent::Read -> goto StoredInverted,
        DecodeEvent::Block(kind) -> stay,
        DecodeEvent::Repeat -> stay,
        DecodeEvent::TreesReady -> stay,
        DecodeEvent::Literal -> stay,
        DecodeEvent::Match -> stay,
        DecodeEvent::End(last) -> stay,
        DecodeEvent::Fail -> goto Failed,
        DecodeEvent::Reset -> goto HeaderFinal,
    }

    state StoredInverted {
        DecodeEvent::Read -> goto StoredCopy,
        DecodeEvent::Block(kind) -> stay,
        DecodeEvent::Repeat -> stay,
        DecodeEvent::TreesReady -> stay,
        DecodeEvent::Literal -> stay,
        DecodeEvent::Match -> stay,
        DecodeEvent::End(last) -> stay,
        DecodeEvent::Fail -> goto Failed,
        DecodeEvent::Reset -> goto HeaderFinal,
    }

    state StoredCopy {
        DecodeEvent::Read -> stay,
        DecodeEvent::Block(kind) -> stay,
        DecodeEvent::Repeat -> stay,
        DecodeEvent::TreesReady -> stay,
        DecodeEvent::Literal -> stay,
        DecodeEvent::Match -> stay,
        DecodeEvent::End(last) -> { if (last) { goto Finished; } goto HeaderFinal; },
        DecodeEvent::Fail -> goto Failed,
        DecodeEvent::Reset -> goto HeaderFinal,
    }

    state DynamicLiteralCount {
        DecodeEvent::Read -> goto DynamicDistanceCount,
        DecodeEvent::Block(kind) -> stay,
        DecodeEvent::Repeat -> stay,
        DecodeEvent::TreesReady -> stay,
        DecodeEvent::Literal -> stay,
        DecodeEvent::Match -> stay,
        DecodeEvent::End(last) -> stay,
        DecodeEvent::Fail -> goto Failed,
        DecodeEvent::Reset -> goto HeaderFinal,
    }

    state DynamicDistanceCount {
        DecodeEvent::Read -> goto DynamicCodeCount,
        DecodeEvent::Block(kind) -> stay,
        DecodeEvent::Repeat -> stay,
        DecodeEvent::TreesReady -> stay,
        DecodeEvent::Literal -> stay,
        DecodeEvent::Match -> stay,
        DecodeEvent::End(last) -> stay,
        DecodeEvent::Fail -> goto Failed,
        DecodeEvent::Reset -> goto HeaderFinal,
    }

    state DynamicCodeCount {
        DecodeEvent::Read -> goto DynamicCodeLengths,
        DecodeEvent::Block(kind) -> stay,
        DecodeEvent::Repeat -> stay,
        DecodeEvent::TreesReady -> stay,
        DecodeEvent::Literal -> stay,
        DecodeEvent::Match -> stay,
        DecodeEvent::End(last) -> stay,
        DecodeEvent::Fail -> goto Failed,
        DecodeEvent::Reset -> goto HeaderFinal,
    }

    state DynamicCodeLengths {
        DecodeEvent::Read -> goto DynamicLengths,
        DecodeEvent::Block(kind) -> stay,
        DecodeEvent::Repeat -> stay,
        DecodeEvent::TreesReady -> stay,
        DecodeEvent::Literal -> stay,
        DecodeEvent::Match -> stay,
        DecodeEvent::End(last) -> stay,
        DecodeEvent::Fail -> goto Failed,
        DecodeEvent::Reset -> goto HeaderFinal,
    }

    state DynamicLengths {
        DecodeEvent::Read -> stay,
        DecodeEvent::Block(kind) -> stay,
        DecodeEvent::Repeat -> goto DynamicRepeat,
        DecodeEvent::TreesReady -> goto BuildTrees,
        DecodeEvent::Literal -> stay,
        DecodeEvent::Match -> stay,
        DecodeEvent::End(last) -> stay,
        DecodeEvent::Fail -> goto Failed,
        DecodeEvent::Reset -> goto HeaderFinal,
    }

    state DynamicRepeat {
        DecodeEvent::Read -> goto DynamicLengths,
        DecodeEvent::Block(kind) -> stay,
        DecodeEvent::Repeat -> stay,
        DecodeEvent::TreesReady -> stay,
        DecodeEvent::Literal -> stay,
        DecodeEvent::Match -> stay,
        DecodeEvent::End(last) -> stay,
        DecodeEvent::Fail -> goto Failed,
        DecodeEvent::Reset -> goto HeaderFinal,
    }

    state BuildTrees {
        DecodeEvent::Read -> goto LiteralSymbol,
        DecodeEvent::Block(kind) -> stay,
        DecodeEvent::Repeat -> stay,
        DecodeEvent::TreesReady -> stay,
        DecodeEvent::Literal -> stay,
        DecodeEvent::Match -> stay,
        DecodeEvent::End(last) -> stay,
        DecodeEvent::Fail -> goto Failed,
        DecodeEvent::Reset -> goto HeaderFinal,
    }

    state LiteralSymbol {
        DecodeEvent::Read -> stay,
        DecodeEvent::Block(kind) -> stay,
        DecodeEvent::Repeat -> stay,
        DecodeEvent::TreesReady -> stay,
        DecodeEvent::Literal -> goto EmitLiteral,
        DecodeEvent::Match -> goto LengthExtra,
        DecodeEvent::End(last) -> { if (last) { goto Finished; } goto HeaderFinal; },
        DecodeEvent::Fail -> goto Failed,
        DecodeEvent::Reset -> goto HeaderFinal,
    }

    state EmitLiteral {
        DecodeEvent::Read -> goto LiteralSymbol,
        DecodeEvent::Block(kind) -> stay,
        DecodeEvent::Repeat -> stay,
        DecodeEvent::TreesReady -> stay,
        DecodeEvent::Literal -> stay,
        DecodeEvent::Match -> stay,
        DecodeEvent::End(last) -> stay,
        DecodeEvent::Fail -> goto Failed,
        DecodeEvent::Reset -> goto HeaderFinal,
    }

    state LengthExtra {
        DecodeEvent::Read -> goto DistanceSymbol,
        DecodeEvent::Block(kind) -> stay,
        DecodeEvent::Repeat -> stay,
        DecodeEvent::TreesReady -> stay,
        DecodeEvent::Literal -> stay,
        DecodeEvent::Match -> stay,
        DecodeEvent::End(last) -> stay,
        DecodeEvent::Fail -> goto Failed,
        DecodeEvent::Reset -> goto HeaderFinal,
    }

    state DistanceSymbol {
        DecodeEvent::Read -> goto DistanceExtra,
        DecodeEvent::Block(kind) -> stay,
        DecodeEvent::Repeat -> stay,
        DecodeEvent::TreesReady -> stay,
        DecodeEvent::Literal -> stay,
        DecodeEvent::Match -> stay,
        DecodeEvent::End(last) -> stay,
        DecodeEvent::Fail -> goto Failed,
        DecodeEvent::Reset -> goto HeaderFinal,
    }

    state DistanceExtra {
        DecodeEvent::Read -> goto MatchCopy,
        DecodeEvent::Block(kind) -> stay,
        DecodeEvent::Repeat -> stay,
        DecodeEvent::TreesReady -> stay,
        DecodeEvent::Literal -> stay,
        DecodeEvent::Match -> stay,
        DecodeEvent::End(last) -> stay,
        DecodeEvent::Fail -> goto Failed,
        DecodeEvent::Reset -> goto HeaderFinal,
    }

    state MatchCopy {
        DecodeEvent::Read -> goto LiteralSymbol,
        DecodeEvent::Block(kind) -> stay,
        DecodeEvent::Repeat -> stay,
        DecodeEvent::TreesReady -> stay,
        DecodeEvent::Literal -> stay,
        DecodeEvent::Match -> stay,
        DecodeEvent::End(last) -> stay,
        DecodeEvent::Fail -> goto Failed,
        DecodeEvent::Reset -> goto HeaderFinal,
    }

    state Finished {
        DecodeEvent::Read -> stay,
        DecodeEvent::Block(kind) -> stay,
        DecodeEvent::Repeat -> stay,
        DecodeEvent::TreesReady -> stay,
        DecodeEvent::Literal -> stay,
        DecodeEvent::Match -> stay,
        DecodeEvent::End(last) -> stay,
        DecodeEvent::Fail -> goto Failed,
        DecodeEvent::Reset -> goto HeaderFinal,
    }

    state Failed {
        DecodeEvent::Read -> stay,
        DecodeEvent::Block(kind) -> stay,
        DecodeEvent::Repeat -> stay,
        DecodeEvent::TreesReady -> stay,
        DecodeEvent::Literal -> stay,
        DecodeEvent::Match -> stay,
        DecodeEvent::End(last) -> stay,
        DecodeEvent::Fail -> goto Failed,
        DecodeEvent::Reset -> goto HeaderFinal,
    }
}

pub struct Decoder {
    history: core::slice::View<u8>, workspace: core::slice::View<i32>,
    max_distance: i32, ring: bool, history_head: i32, history_filled: i32,
    phase: Decoding, failure: Error, buffer: i32, available: i32,
    final_block: i32, kind: i32, remaining: i32, distance: i32,
    literal_count: i32, distance_count: i32, code_count: i32, index: i32,
    literal_maximum: i32, distance_maximum: i32, code_maximum: i32,
    symbol: i32, code: i32, first: i32, offset: i32, size: i32,
    fast: bool, fast_ready_completion: core::iter_state::Completion
}
// Per-call descriptors and progress never escape the engine invocation.
struct Call { input: core::slice::View<u8>, output: core::slice::View<u8>, read: i32, written: i32 }
impl Call { fn borrow(&self) -> &Call { return self; } }

fn valid_bytes(view: core::slice::View<u8>) -> bool {
    return view.start >= 0 && view.length >= 0 && view.start <= 2147483647-view.length;
}
fn valid_workspace(view: core::slice::View<i32>) -> bool {
    return view.start >= 0 && view.length >= 0 && view.start <= 2147483647-view.length;
}
fn valid_window(window: i32) -> bool { return window >= 256 && window <= 32768 && (window & (window-1)) == 0; }
fn byte(view: core::slice::View<u8>, index: i32) -> u8 { return view.values[view.start+index]; }
fn entry(view: core::slice::View<i32>, index: i32) -> i32 { return view.values[view.start+index]; }
fn put_entry(view: core::slice::View<i32>, index: i32, value: i32) { view.values[view.start+index] = value; }

fn initial(history: core::slice::View<u8>, workspace: core::slice::View<i32>, max_distance: i32, ring: bool) -> Decoder {
    return Decoder {
        history: history, workspace: workspace, max_distance: max_distance, ring: ring,
        history_head: 0, history_filled: 0, phase: decoding_start(), failure: Error::Bounds,
        buffer: 0, available: 0, final_block: 0, kind: 0, remaining: 0, distance: 0,
        literal_count: 0, distance_count: 0, code_count: 0, index: 0,
        literal_maximum: 0, distance_maximum: 0, code_maximum: 0,
        symbol: 0, code: 0, first: 0, offset: 0, size: 1,
        fast: workspace.length >= FAST_END, fast_ready_completion: core::iter_state::completion_start()
    };
}

// Construction only stores descriptors and scalars. It neither inspects nor
// initializes backing. Extra history/workspace entries are never touched.
pub fn decoder(history: core::slice::View<u8>, workspace: core::slice::View<i32>, max_distance: i32) -> core::result::Result<Decoder,Error> {
    if (!valid_bytes(history) || !valid_workspace(workspace) || !valid_window(max_distance) || history.length < max_distance || workspace.length < workspace_len()) {
        return core::result::Err(Error::Bounds);
    }
    return core::result::Ok(initial(history,workspace,max_distance,true));
}

fn progress(call: &Call, status: Status) -> core::result::Result<Step,Failure> {
    return core::result::Ok(Step { read: call.read, written: call.written, status: status });
}
fn fail(state: &Decoder, call: &Call, error: Error) -> core::result::Result<Step,Failure> {
    state.phase.step(DecodeEvent::Fail); state.failure = error;
    return core::result::Err(Failure { error: error, read: call.read, written: call.written });
}
fn missing_input(state: &Decoder, call: &Call, final_input: bool) -> core::result::Result<Step,Failure> {
    if (final_input) { return fail(state,call,Error::UnexpectedEof); }
    return progress(call,Status::NeedInput);
}

// Fields are committed only when complete. Partial bytes remain in the bit
// reservoir across calls; load no byte until the current field needs it.
fn bits(state: &Decoder, call: &Call, need: i32) -> i32 {
    while (state.available < need) {
        if (call.read == call.input.length) { return -1; }
        state.buffer = state.buffer | ((byte(call.input,call.read) as i32) << state.available);
        call.read += 1; state.available += 8;
    }
    let value: i32 = state.buffer & ((1 << need)-1);
    state.buffer = state.buffer >> need; state.available -= need; return value;
}

// Canonical counts and symbols sorted by (length,symbol). All lengths are
// admitted by fixed-code construction or the dynamic code-length alphabet.
fn construct(workspace: core::slice::View<i32>, start: i32, count: i32, counts: i32, symbols: i32) -> i32 {
    let index: i32 = 0; while (index < 16) { put_entry(workspace,counts+index,0); index += 1; }
    index = 0;
    while (index < count) {
        let size: i32 = entry(workspace,start+index);
        put_entry(workspace,counts+size,entry(workspace,counts+size)+1); index += 1;
    }
    let left: i32 = 1; index = 1;
    while (index <= 15) { left = left*2-entry(workspace,counts+index); if (left < 0) { return -1; } index += 1; }
    let offsets: [i32;16] = [0;16]; index = 1;
    while (index < 15) { let stored: i32 = offsets[index]+entry(workspace,counts+index); offsets[index+1] = stored; index += 1; }
    index = 0;
    while (index < count) {
        let size: i32 = entry(workspace,start+index);
        if (size != 0) { put_entry(workspace,symbols+offsets[size],index); offsets[size] += 1; }
        index += 1;
    }
    return left;
}
fn maximum(workspace: core::slice::View<i32>, counts: i32) -> i32 {
    let size: i32 = 15; while (size > 0 && entry(workspace,counts+size) == 0) { size -= 1; } return size;
}
fn reset_code(state: &Decoder) { state.code = 0; state.first = 0; state.offset = 0; state.size = 1; }
// -1 means input exhausted, -2 an unused/invalid code. Incomplete traversal
// persists; a completed symbol resets traversal before its next phase.
fn decode_symbol(state: &Decoder, call: &Call, counts: i32, symbols: i32, maximum: i32) -> i32 {
    while (state.size <= maximum) {
        let bit: i32 = bits(state,call,1); if (bit < 0) { return -1; }
        state.code = state.code*2+bit; let count: i32 = entry(state.workspace,counts+state.size);
        if (state.code >= state.first && state.code-state.first < count) {
            let symbol: i32 = entry(state.workspace,symbols+state.offset+state.code-state.first);
            reset_code(state); return symbol;
        }
        state.offset += count; state.first = (state.first+count)*2; state.size += 1;
    }
    return -2;
}
fn length_base(symbol: i32) -> i32 {
    let bases: [i32;29] = [3,4,5,6,7,8,9,10,11,13,15,17,19,23,27,31,35,43,51,59,67,83,99,115,131,163,195,227,258];
    return bases[symbol-257];
}
fn length_extra(symbol: i32) -> i32 { if (symbol <= 264 || symbol == 285) { return 0; } return (symbol-261)/4; }
fn distance_extra(symbol: i32) -> i32 { if (symbol < 4) { return 0; } return symbol/2-1; }
fn distance_base(symbol: i32) -> i32 { if (symbol < 4) { return symbol+1; } let extra: i32 = distance_extra(symbol); return ((2+(symbol & 1)) << extra)+1; }
fn code_order(index: i32) -> i32 {
    let order: [i32;19] = [16,17,18,0,8,7,9,6,10,5,11,4,12,3,13,2,14,1,15]; return order[index];
}
fn end_block(state: &Decoder) { state.fast_ready_completion = core::iter_state::completion_start(); state.phase.step(DecodeEvent::End(state.final_block != 0)); }

// Append before the next distance lookup, so overlapping copies work even
// across output chunks and ring wrap. Logical history never exceeds window.
fn emit(state: &Decoder, call: &Call, value: u8) {
    call.output.values[call.output.start+call.written] = value; call.written += 1;
    if (state.ring) {
        state.history.values[state.history.start+state.history_head] = value;
        state.history_head += 1; if (state.history_head == state.max_distance) { state.history_head = 0; }
    }
    if (state.history_filled < state.max_distance) { state.history_filled += 1; }
}
fn previous(state: &Decoder, call: &Call) -> u8 {
    if (!state.ring) { return byte(call.output,call.written-state.distance); }
    let at: i32 = state.history_head-state.distance; if (at < 0) { at += state.max_distance; }
    return byte(state.history,at);
}

// ---------------------------------------------------------------- fast path
// Table entry: payload << 12 | extra << 8 | tag << 4 | bits. Tags: 0 literal
// (payload byte) or distance (payload base), 1 length (payload base), 2 end
// of block, 3 subtable (payload offset, extra index bits), 4 unused code.
fn leaf(literal_table: bool, symbol: i32, bits: i32) -> i32 {
    if (literal_table) {
        if (symbol < 256) { return (symbol << 12) | bits; }
        if (symbol == 256) { return 32 | bits; }
        if (symbol <= 285) { return (length_base(symbol) << 12) | (length_extra(symbol) << 8) | 16 | bits; }
        return INVALID_ENTRY;
    }
    if (symbol < 30) { return (distance_base(symbol) << 12) | (distance_extra(symbol) << 8) | bits; }
    return INVALID_ENTRY;
}
// Canonical two-level table over lengths[start..start+count). The callers
// have already validated the lengths with construct().
fn build_table(w: core::slice::View<i32>, start: i32, count: i32, table: i32, root: i32, literal_table: bool) {
    let longest: i32 = 0; let index: i32 = 0; let counts: [i32;16] = [0;16];
    while (index < count) { let size: i32 = entry(w,start+index); counts[size] += 1; if (size > longest) { longest = size; } index += 1; }
    let primary: i32 = 1 << root; index = 0;
    while (index < primary) { put_entry(w,table+index,INVALID_ENTRY); index += 1; }
    let next: [i32;16] = [0;16]; let code: i32 = 0; let size: i32 = 1; counts[0] = 0;
    while (size <= 15) { code = (code+counts[size-1]) << 1; next[size] = code; size += 1; }
    let sub: i32 = longest-root; let free: i32 = primary;
    index = 0;
    while (index < count) {
        let length: i32 = entry(w,start+index);
        if (length != 0) {
            let value: i32 = next[length]; next[length] = value+1;
            let reversed: i32 = 0; let bit: i32 = 0;
            while (bit < length) { reversed = (reversed << 1) | ((value >> bit) & 1); bit += 1; }
            if (length <= root) {
                let item: i32 = leaf(literal_table,index,length); let slot: i32 = reversed;
                while (slot < primary) { put_entry(w,table+slot,item); slot += 1 << length; }
            } else {
                let low: i32 = reversed & (primary-1); let pointer: i32 = entry(w,table+low);
                if (((pointer >> 4) & 15) != 3) {
                    let fill: i32 = 0; while (fill < (1 << sub)) { put_entry(w,table+free+fill,INVALID_ENTRY); fill += 1; }
                    pointer = (free << 12) | (sub << 8) | 48 | root; put_entry(w,table+low,pointer); free += 1 << sub;
                }
                let item: i32 = leaf(literal_table,index,length-root); let slot: i32 = reversed >> root; let base: i32 = pointer >> 12;
                while (slot < (1 << sub)) { put_entry(w,table+base+slot,item); slot += 1 << (length-root); }
            }
        }
        index += 1;
    }
}
fn data(view: core::slice::View<u8>) -> ptr { return core::mem::i32_slice_data_ptr(view.values)+(view.start as usize); }
fn packed(view: core::slice::View<u8>) -> bool { return core::mem::slice_stride(view.values) == 1; }
// Raw u64 views run downward: element k of words(base, at, n) is the word
// at byte at+8*(n-1-k). One view per copy is far cheaper than one per word.
fn words(base: ptr, at: i32, n: i32) -> [u64] { return core::mem::slice_from_raw_parts(base+(at as usize)+(((n-1) << 3) as usize),n); }
// Copy count bytes between disjoint buffers, a word at a time; a count of
// 8 or more finishes with one overlapping word instead of a byte tail.
fn copy_disjoint(to: ptr, at: i32, from: ptr, source: i32, count: i32) {
    let n: i32 = count >> 3;
    if (n > 0) {
        let a: [u64] = words(to,at,n); let b: [u64] = words(from,source,n); let k: i32 = 0;
        while (k < n) { a[k] = b[k]; k += 1; }
        if ((count & 7) != 0) { let x: [u64] = words(to,at+count-8,1); let y: [u64] = words(from,source+count-8,1); x[0] = y[0]; }
        return;
    }
    let tail: [u8] = core::mem::typed_slice_from_raw_parts<u8>(to+(at as usize),count); let head: [u8] = core::mem::typed_slice_from_raw_parts<u8>(from+(source as usize),count);
    let index: i32 = 0; while (index < count) { tail[index] = head[index]; index += 1; }
}
// LZ77 copy inside one buffer: ascending words when the distance is 8 or
// more (each word reads only finished bytes), a repeated-byte word for
// distance 1, bytes otherwise.
fn copy_within(base: ptr, at: i32, distance: i32, count: i32) {
    let n: i32 = count >> 3;
    if (distance >= 8 && n > 0) {
        let a: [u64] = words(base,at,n); let b: [u64] = words(base,at-distance,n); let k: i32 = n-1;
        while (k >= 0) { a[k] = b[k]; k -= 1; }
        // The final overlapping word rewrites finished bytes with equal values.
        if ((count & 7) != 0) { let x: [u64] = words(base,at+count-8,1); let y: [u64] = words(base,at+count-8-distance,1); x[0] = y[0]; }
        return;
    }
    let index: i32 = 0;
    let all: [u8] = core::mem::typed_slice_from_raw_parts<u8>(base+((at-distance) as usize),distance+count);
    if (distance == 1 && n > 0) {
        let pattern: u64 = (all[0] as u64)*72340172838076673; let a: [u64] = words(base,at,n); let k: i32 = 0;
        while (k < n) { a[k] = pattern; k += 1; }
        index = n << 3;
    }
    while (index < count) { all[distance+index] = all[index]; index += 1; }
}
fn low_bits(value: u64, count: i32) -> i32 { return (value & ((1 << (count as u64))-1)) as i32; }
// Whole symbols while at least 8 input bytes and 258 output bytes remain.
// Anything unusual (unused code, distance beyond history) rewinds to the
// symbol's start and returns true, so the bit-serial path reports it with
// identical progress. Unconsumed whole bytes are handed back on exit.
fn fast_loop(state: &Decoder, call: &Call) -> bool {
    let input: core::slice::View<u8> = call.input; let output: core::slice::View<u8> = call.output;
    let in_base: ptr = data(input); let out_base: ptr = data(output);
    let w: [i32] = state.workspace.values; let literals: i32 = state.workspace.start+FAST_LITERAL; let distances: i32 = state.workspace.start+FAST_DISTANCE;
    let ip: i32 = call.read; let op: i32 = call.written; let out_start: i32 = op;
    let bits: u64 = state.buffer as u64; let count: i32 = state.available;
    let in_limit: i32 = input.length-8; let out_limit: i32 = output.length-258;
    let window: i32 = state.max_distance; let filled_before: i32 = state.history_filled; let head: i32 = state.history_head;
    let ring: bool = state.ring; let hist_base: ptr = data(state.history);
    let bailed: bool = false;
    while (ip <= in_limit && op <= out_limit) {
        if (count < 48) {
            let word: [u64] = core::mem::slice_from_raw_parts(in_base+(ip as usize),1);
            bits = bits | (word[0] << (count as u64)); let take: i32 = (63-count) >> 3; ip += take; count += take << 3;
        }
        let saved_bits: u64 = bits; let saved_count: i32 = count;
        let item: i32 = w[literals+((bits & 1023) as i32)];
        if (((item >> 4) & 15) == 3) { bits = bits >> 10; count -= 10; item = w[literals+(item >> 12)+low_bits(bits,(item >> 8) & 15)]; }
        let tag: i32 = (item >> 4) & 15;
        if (tag == 4) { bits = saved_bits; count = saved_count; bailed = true; break; }
        bits = bits >> ((item & 15) as u64); count -= item & 15;
        if (tag == 0) {
            output.values[output.start+op] = (item >> 12) as u8; op += 1;
            // Up to two more literals from the same refill.
            item = w[literals+((bits & 1023) as i32)];
            if (count < 10 || ((item >> 4) & 15) != 0) { continue; }
            bits = bits >> ((item & 15) as u64); count -= item & 15; output.values[output.start+op] = (item >> 12) as u8; op += 1;
            item = w[literals+((bits & 1023) as i32)];
            if (count < 10 || ((item >> 4) & 15) != 0) { continue; }
            bits = bits >> ((item & 15) as u64); count -= item & 15; output.values[output.start+op] = (item >> 12) as u8; op += 1;
            continue;
        }
        if (tag == 2) { end_block(state); break; }
        let extra: i32 = (item >> 8) & 15; let length: i32 = (item >> 12)+low_bits(bits,extra); bits = bits >> (extra as u64); count -= extra;
        let near: i32 = w[distances+((bits & 255) as i32)];
        if (((near >> 4) & 15) == 3) { bits = bits >> 8; count -= 8; near = w[distances+(near >> 12)+low_bits(bits,(near >> 8) & 15)]; }
        if (((near >> 4) & 15) == 4) { bits = saved_bits; count = saved_count; bailed = true; break; }
        bits = bits >> ((near & 15) as u64); count -= near & 15;
        extra = (near >> 8) & 15; let distance: i32 = (near >> 12)+low_bits(bits,extra); bits = bits >> (extra as u64); count -= extra;
        let produced: i32 = op-out_start; let filled: i32 = filled_before+produced; if (filled > window) { filled = window; }
        if (distance > filled) { bits = saved_bits; count = saved_count; bailed = true; break; }
        if (!ring || distance <= produced) { copy_within(out_base,op,distance,length); }
        else {
            // Older bytes come from the ring as it stood when this call began.
            let back: i32 = distance-produced; let first: i32 = length; if (first > back) { first = back; }
            let from: i32 = (head-back) & (window-1); let run: i32 = first; if (run > window-from) { run = window-from; }
            copy_disjoint(out_base,op,hist_base,from,run);
            if (first > run) { copy_disjoint(out_base,op+run,hist_base,0,first-run); }
            if (length > first) { copy_within(out_base,op+first,distance,length-first); }
        }
        op += length;
    }
    let back: i32 = count >> 3; ip -= back; count -= back << 3;
    state.buffer = low_bits(bits,count); state.available = count; call.read = ip;
    append_history(state,out_base,op,op-out_start);
    call.written = op; return bailed;
}
// Record the produced bytes ending at out_base[end] as history, in bulk.
fn append_history(state: &Decoder, out_base: ptr, end: i32, produced: i32) {
    let window: i32 = state.max_distance; let head: i32 = state.history_head;
    if (state.ring && produced > 0) {
        let hist_base: ptr = data(state.history);
        let keep: i32 = produced; if (keep > window) { keep = window; }
        let at: i32 = (head+produced-keep) & (window-1); let run: i32 = keep; if (run > window-at) { run = window-at; }
        copy_disjoint(hist_base,at,out_base,end-keep,run);
        if (keep > run) { copy_disjoint(hist_base,0,out_base,end-keep+run,keep-run); }
        state.history_head = (head+produced) & (window-1);
    }
    let total: i32 = state.history_filled+produced; if (total > window) { total = window; } state.history_filled = total;
}

// This is the only DEFLATE parser. The private complete-output mode is used
// for one-shot calls only; public streaming construction always uses a ring.
fn run(state: &Decoder, input: core::slice::View<u8>, output: core::slice::View<u8>, final_input: bool) -> core::result::Result<Step,Failure> {
    if (!valid_bytes(input) || !valid_bytes(output)) { return core::result::Err(Failure { error: Error::Bounds, read: 0, written: 0 }); }
    let call: Call = Call { input: input, output: output, read: 0, written: 0 };
    if (((match (state.phase.state()) { DecodingState::Failed -> true, _ -> false }))) { return core::result::Err(Failure { error: state.failure, read: 0, written: 0 }); }
    let fast: bool = state.fast && packed(input) && packed(output) && packed(state.history);
    while (true) {
        if (((match (state.phase.state()) { DecodingState::Finished -> true, _ -> false }))) { return progress(call.borrow(),Status::Done); }
        if (((match (state.phase.state()) { DecodingState::HeaderFinal -> true, _ -> false }))) {
            let last: i32 = bits(state,call.borrow(),1); if (last < 0) { return missing_input(state,call.borrow(),final_input); }
            state.final_block = last; state.phase.step(DecodeEvent::Read);
        }
        if (((match (state.phase.state()) { DecodingState::HeaderKind -> true, _ -> false }))) {
            let kind: i32 = bits(state,call.borrow(),2); if (kind < 0) { return missing_input(state,call.borrow(),final_input); }
            if (kind == 3) { return fail(state,call.borrow(),Error::InvalidBlockType); }
            state.kind = kind; state.fast_ready_completion = core::iter_state::completion_start();
            if (kind == 0) { state.buffer = 0; state.available = 0; state.phase.step(DecodeEvent::Block(0)); }
            else {
                if (kind == 1) {
                    let index: i32 = 0;
                    while (index < 144) { put_entry(state.workspace,index,8); index += 1; }
                    while (index < 256) { put_entry(state.workspace,index,9); index += 1; }
                    while (index < 280) { put_entry(state.workspace,index,7); index += 1; }
                    while (index < 288) { put_entry(state.workspace,index,8); index += 1; }
                    while (index < 320) { put_entry(state.workspace,index,5); index += 1; }
                    state.literal_count = 288; state.distance_count = 32; state.phase.step(DecodeEvent::Block(1));
                } else { state.phase.step(DecodeEvent::Block(2)); }
            }
        }
        if (((match (state.phase.state()) { DecodingState::StoredLength -> true, _ -> false }))) {
            let length: i32 = bits(state,call.borrow(),16); if (length < 0) { return missing_input(state,call.borrow(),final_input); }
            state.remaining = length; state.phase.step(DecodeEvent::Read);
        }
        if (((match (state.phase.state()) { DecodingState::StoredInverted -> true, _ -> false }))) {
            let inverted: i32 = bits(state,call.borrow(),16); if (inverted < 0) { return missing_input(state,call.borrow(),final_input); }
            if ((state.remaining ^ inverted) != 65535) { return fail(state,call.borrow(),Error::InvalidStoredLength); }
            state.phase.step(DecodeEvent::Read);
        }
        if (((match (state.phase.state()) { DecodingState::StoredCopy -> true, _ -> false }))) {
            if (fast) {
                let run: i32 = state.remaining; let room: i32 = input.length-call.read; if (run > room) { run = room; }
                room = output.length-call.written; if (run > room) { run = room; }
                if (run > 0) {
                    let out_base: ptr = data(output);
                    copy_disjoint(out_base,call.written,data(input),call.read,run);
                    call.read += run; call.written += run; state.remaining -= run;
                    append_history(state,out_base,call.written,run);
                }
            }
            while (state.remaining > 0) {
                // Preserve stored-input truncation before output exhaustion.
                if (call.read == input.length) { return missing_input(state,call.borrow(),final_input); }
                if (call.written == output.length) { return progress(call.borrow(),Status::NeedOutput); }
                emit(state,call.borrow(),byte(input,call.read)); call.read += 1; state.remaining -= 1;
            }
            end_block(state);
        }
        if (((match (state.phase.state()) { DecodingState::DynamicLiteralCount -> true, _ -> false }))) {
            let value: i32 = bits(state,call.borrow(),5); if (value < 0) { return missing_input(state,call.borrow(),final_input); }
            state.literal_count = value+257; state.phase.step(DecodeEvent::Read);
        }
        if (((match (state.phase.state()) { DecodingState::DynamicDistanceCount -> true, _ -> false }))) {
            let value: i32 = bits(state,call.borrow(),5); if (value < 0) { return missing_input(state,call.borrow(),final_input); }
            state.distance_count = value+1; state.phase.step(DecodeEvent::Read);
        }
        if (((match (state.phase.state()) { DecodingState::DynamicCodeCount -> true, _ -> false }))) {
            let value: i32 = bits(state,call.borrow(),4); if (value < 0) { return missing_input(state,call.borrow(),final_input); }
            // All three fields arrive before HLIT validation, as in one-shot.
            if (state.literal_count > 286) { return fail(state,call.borrow(),Error::InvalidCodeLengths); }
            state.code_count = value+4; state.index = 0;
            while (state.index < 19) { put_entry(state.workspace,state.index,0); state.index += 1; }
            state.index = 0; state.phase.step(DecodeEvent::Read);
        }
        if (((match (state.phase.state()) { DecodingState::DynamicCodeLengths -> true, _ -> false }))) {
            while (state.index < state.code_count) {
                let value: i32 = bits(state,call.borrow(),3); if (value < 0) { return missing_input(state,call.borrow(),final_input); }
                put_entry(state.workspace,code_order(state.index),value); state.index += 1;
            }
            if (construct(state.workspace,0,19,CODE_COUNTS,CODE_SYMBOLS) != 0) { return fail(state,call.borrow(),Error::InvalidCodeLengths); }
            state.code_maximum = maximum(state.workspace,CODE_COUNTS); state.index = 0;
            reset_code(state); state.phase.step(DecodeEvent::Read);
        }
        if (((match (state.phase.state()) { DecodingState::DynamicLengths -> true, _ -> false }))) {
            while (state.index < state.literal_count+state.distance_count && ((match (state.phase.state()) { DecodingState::DynamicLengths -> true, _ -> false }))) {
                let symbol: i32 = decode_symbol(state,call.borrow(),CODE_COUNTS,CODE_SYMBOLS,state.code_maximum);
                if (symbol == -1) { return missing_input(state,call.borrow(),final_input); }
                if (symbol < 0) { return fail(state,call.borrow(),Error::InvalidCodeLengths); }
                if (symbol < 16) { put_entry(state.workspace,state.index,symbol); state.index += 1; }
                else {
                    if (symbol == 16 && state.index == 0) { return fail(state,call.borrow(),Error::InvalidCodeLengths); }
                    state.symbol = symbol; state.phase.step(DecodeEvent::Repeat);
                }
            }
            if (state.index == state.literal_count+state.distance_count) {
                if (entry(state.workspace,256) == 0) { return fail(state,call.borrow(),Error::InvalidCodeLengths); }
                state.phase.step(DecodeEvent::TreesReady);
            }
        }
        if (((match (state.phase.state()) { DecodingState::DynamicRepeat -> true, _ -> false }))) {
            let width: i32 = 7; let base: i32 = 11; let value: i32 = 0;
            if (state.symbol == 16) { width = 2; base = 3; value = entry(state.workspace,state.index-1); }
            if (state.symbol == 17) { width = 3; base = 3; }
            let extra: i32 = bits(state,call.borrow(),width); if (extra < 0) { return missing_input(state,call.borrow(),final_input); }
            let repeat: i32 = base+extra;
            if (repeat > state.literal_count+state.distance_count-state.index) { return fail(state,call.borrow(),Error::InvalidCodeLengths); }
            let end: i32 = state.index+repeat;
            while (state.index < end) { put_entry(state.workspace,state.index,value); state.index += 1; }
            state.phase.step(DecodeEvent::Read);
        }
        if (((match (state.phase.state()) { DecodingState::BuildTrees -> true, _ -> false }))) {
            let literal_left: i32 = construct(state.workspace,0,state.literal_count,LITERAL_COUNTS,LITERAL_SYMBOLS);
            if (literal_left < 0 || (state.kind == 2 && literal_left != 0 && state.literal_count-entry(state.workspace,LITERAL_COUNTS) != entry(state.workspace,LITERAL_COUNTS+1))) {
                return fail(state,call.borrow(),Error::InvalidCodeLengths);
            }
            let distance_left: i32 = construct(state.workspace,state.literal_count,state.distance_count,DISTANCE_COUNTS,DISTANCE_SYMBOLS);
            if (distance_left < 0 || (state.kind == 2 && distance_left != 0 && state.distance_count-entry(state.workspace,DISTANCE_COUNTS) != entry(state.workspace,DISTANCE_COUNTS+1))) {
                return fail(state,call.borrow(),Error::InvalidCodeLengths);
            }
            state.literal_maximum = maximum(state.workspace,LITERAL_COUNTS);
            state.distance_maximum = maximum(state.workspace,DISTANCE_COUNTS);
            if (state.fast) {
                build_table(state.workspace,0,state.literal_count,FAST_LITERAL,LITERAL_ROOT,true);
                build_table(state.workspace,state.literal_count,state.distance_count,FAST_DISTANCE,DISTANCE_ROOT,false);
                state.fast_ready_completion.finish();
            }
            reset_code(state); state.phase.step(DecodeEvent::Read);
        }
        if (((match (state.phase.state()) { DecodingState::LiteralSymbol -> true, _ -> false })) && fast && state.fast_ready_completion.is_done() && state.size == 1 && call.read+8 <= input.length && call.written+258 <= output.length) {
            // A rewind leaves the symbol to the bit-serial path, which fails on it.
            if (fast_loop(state,call.borrow())) { fast = false; }
        }
        if (((match (state.phase.state()) { DecodingState::LiteralSymbol -> true, _ -> false }))) {
            let symbol: i32 = decode_symbol(state,call.borrow(),LITERAL_COUNTS,LITERAL_SYMBOLS,state.literal_maximum);
            if (symbol == -1) { return missing_input(state,call.borrow(),final_input); }
            if (symbol < 0 || symbol > 285) { return fail(state,call.borrow(),Error::InvalidSymbol); }
            state.symbol = symbol;
            if (symbol < 256) { state.phase.step(DecodeEvent::Literal); }
            else { if (symbol == 256) { end_block(state); } else { state.phase.step(DecodeEvent::Match); } }
        }
        if (((match (state.phase.state()) { DecodingState::EmitLiteral -> true, _ -> false }))) {
            if (call.written == output.length) { return progress(call.borrow(),Status::NeedOutput); }
            emit(state,call.borrow(),state.symbol as u8); state.phase.step(DecodeEvent::Read);
        }
        if (((match (state.phase.state()) { DecodingState::LengthExtra -> true, _ -> false }))) {
            let extra: i32 = bits(state,call.borrow(),length_extra(state.symbol)); if (extra < 0) { return missing_input(state,call.borrow(),final_input); }
            state.remaining = length_base(state.symbol)+extra; state.phase.step(DecodeEvent::Read);
        }
        if (((match (state.phase.state()) { DecodingState::DistanceSymbol -> true, _ -> false }))) {
            let symbol: i32 = decode_symbol(state,call.borrow(),DISTANCE_COUNTS,DISTANCE_SYMBOLS,state.distance_maximum);
            if (symbol == -1) { return missing_input(state,call.borrow(),final_input); }
            if (symbol < 0 || symbol >= 30) { return fail(state,call.borrow(),Error::InvalidSymbol); }
            state.symbol = symbol; state.phase.step(DecodeEvent::Read);
        }
        if (((match (state.phase.state()) { DecodingState::DistanceExtra -> true, _ -> false }))) {
            let extra: i32 = bits(state,call.borrow(),distance_extra(state.symbol)); if (extra < 0) { return missing_input(state,call.borrow(),final_input); }
            state.distance = distance_base(state.symbol)+extra;
            if (state.distance > state.history_filled || state.distance > state.max_distance) { return fail(state,call.borrow(),Error::InvalidDistance); }
            state.phase.step(DecodeEvent::Read);
        }
        if (((match (state.phase.state()) { DecodingState::MatchCopy -> true, _ -> false }))) {
            while (state.remaining > 0) {
                if (call.written == output.length) { return progress(call.borrow(),Status::NeedOutput); }
                emit(state,call.borrow(),previous(state,call.borrow())); state.remaining -= 1;
            }
            state.phase.step(DecodeEvent::Read);
        }
    }
    return progress(call.borrow(),Status::Done);
}

pub impl Decoder {
    pub fn borrow(&self) -> &Decoder { return self; }
    pub fn step(&self, input: core::slice::View<u8>, output: core::slice::View<u8>, final_input: bool) -> core::result::Result<Step,Failure> {
        return run(self,input,output,final_input);
    }
    pub fn is_done(&self) -> bool { return ((match (self.phase.state()) { DecodingState::Finished -> true, _ -> false })); }
    pub fn is_failed(&self) -> bool { return ((match (self.phase.state()) { DecodingState::Failed -> true, _ -> false })); }
    // A valid reset changes only scalar state; stale table/history bytes are
    // initialized before use. Invalid reset preserves even terminal state.
    pub fn reset(&self, max_distance: i32) -> core::result::Result<bool,Error> {
        if (!valid_bytes(self.history) || !valid_workspace(self.workspace) || !valid_window(max_distance) || self.history.length < max_distance || self.workspace.length < workspace_len()) {
            return core::result::Err(Error::Bounds);
        }
        self.max_distance = max_distance; self.history_head = 0; self.history_filled = 0;
        self.phase.step(DecodeEvent::Reset); self.failure = Error::Bounds; self.buffer = 0; self.available = 0;
        self.final_block = 0; self.kind = 0; self.remaining = 0; self.distance = 0;
        self.literal_count = 0; self.distance_count = 0; self.code_count = 0; self.index = 0;
        self.literal_maximum = 0; self.distance_maximum = 0; self.code_maximum = 0; self.symbol = 0;
        self.fast_ready_completion = core::iter_state::completion_start(); reset_code(self); return core::result::Ok(true);
    }
}

pub fn decode_into(input: core::slice::View<u8>, output: core::slice::View<u8>) -> core::result::Result<Progress,Failure> { return decode_into_window(input,output,32768); }
// Complete caller output serves as history here. No 32 KiB ring is required,
// and the parser/error precedence is identical to the streaming engine.
pub fn decode_into_window(input: core::slice::View<u8>, output: core::slice::View<u8>, max_distance: i32) -> core::result::Result<Progress,Failure> {
    if (!valid_bytes(input) || !valid_bytes(output) || !valid_window(max_distance)) {
        return core::result::Err(Failure { error: Error::Bounds, read: 0, written: 0 });
    }
    let tables: [i32;8643] = [0;8643];
    let workspace: core::slice::View<i32> = core::slice::View { values: tables, start: 0, length: 8643 };
    let state: Decoder = initial(output,workspace,max_distance,false);
    let result: core::result::Result<Step,Failure> = run(state.borrow(),input,output,true);
    if (core::result::is_err(result)) { return core::result::Err(core::result::unwrap_err(result)); }
    let step: Step = core::result::unwrap(result);
    let done: bool = match (step.status) { Status::Done -> true, _ -> false };
    if (done) { return core::result::Ok(Progress { read: step.read, written: step.written }); }
    return core::result::Err(Failure { error: Error::OutputTooSmall, read: step.read, written: step.written });
}
