}

// Delete and/or squeeze (after translating when the plan translates),
// writing the surviving bytes to o. Each word's dropped bytes are found with
// word tests; a word without one is copied whole, and the kept stretches of
// any other word are copied a stretch at a time.
pub fn filter(p: &Plan, st: &State, v: core::slice::View<u8>, o: &ext::text_lines::Out) -> core::result::Result<i32, ext::text_lines::Error> {
    if (p.translate) { let tx: core::result::Result<i32, ext::text_lines::Error> = translate(p, v); if (core::result::is_err(tx)) { return tx; } }
    let made: core::result::Result<ext::text_lines::Words, ext::text_lines::Error> = ext::text_lines::words(v);
    if (core::result::is_err(made)) { return core::result::Err(core::result::unwrap_err(made)); }
    let w: ext::text_lines::Words = core::result::unwrap(made);
    let n: i32 = v.length; let t: [i32] = p.t; let last: i32 = st.last;
    let dr: Runs = tr_flag_runs(p, 256); let sr: Runs = tr_flag_runs(p, 512);
    let del: Slots = tr_slots(dr.borrow(), true, 0, 0); let sq: Slots = tr_slots(sr.borrow(), true, 0, 0);
    dr.destroy(); sr.destroy();
    let deleting: bool = p.delete; let squeezing: bool = p.squeeze;
    let fast: bool = dr.ok && sr.ok && del.ok && sq.ok && ext::text_lines::packed(v);
    let low: u64 = ext::text_lines::LOW7; let high: u64 = ext::text_lines::HIGH; let ones: u64 = ext::text_lines::ONES;
    let da0: u64 = del.a0; let db0: u64 = del.b0; let da1: u64 = del.a1; let db1: u64 = del.b1; let da2: u64 = del.a2; let db2: u64 = del.b2; let dah: u64 = del.ah; let dbh: u64 = del.bh;
    let sa0: u64 = sq.a0; let sb0: u64 = sq.b0; let sa1: u64 = sq.a1; let sb1: u64 = sq.b1; let sa2: u64 = sq.a2; let sb2: u64 = sq.b2; let sah: u64 = sq.ah; let sbh: u64 = sq.bh;
    let ws: [u64] = w.words; let nw: i32 = w.nw; let base: i32 = nw - 1;
    let acc: u64 = o.acc; let fill: i32 = o.fill; let at: i32 = o.at; let cap: i32 = o.cap; let wv: [u64] = o.w;
    let j: i32 = 0;
    let dsmall: bool = tr_one_slot(del); let ssmall: bool = tr_one_slot(sq);
    while (j <= nw) {
        if (fast && j < nw && deleting != squeezing) {
            // Every whole word: copied as is when it keeps every byte,
            // otherwise its gaps are closed in three steps (each kept byte
            // moves down by the count of dropped bytes below it, one bit of
            // that count at a time; no two bytes ever meet).
            let ff: u64 = (fill * 8) as u64; let back: u64 = (64 - ff) & 63; let keep: u64 = 0; if (fill != 0) { keep = ext::text_lines::ALL; }
            while (j + 1 < nw) {
                // Two words at a time while both are whole.
                let x0: u64 = ws[base-j]; let x1: u64 = ws[base-j-1]; let y0: u64 = x0 & low; let y1: u64 = x1 & low; let dm0: u64 = 0; let dm1: u64 = 0;
                if (deleting) {
                    let l0: u64 = (y0 + da0) ^ (y0 + db0); let l1: u64 = (y1 + da0) ^ (y1 + db0); let h0: u64 = 0; let h1: u64 = 0;
                    if (!dsmall) {
                        l0 = l0 | ((y0 + da1) ^ (y0 + db1)) | ((y0 + da2) ^ (y0 + db2)); h0 = ((y0 + dah) ^ (y0 + dbh)) & x0;
                        l1 = l1 | ((y1 + da1) ^ (y1 + db1)) | ((y1 + da2) ^ (y1 + db2)); h1 = ((y1 + dah) ^ (y1 + dbh)) & x1;
                    }
                    dm0 = (((l0 | x0) ^ x0) | h0) & high; dm1 = (((l1 | x1) ^ x1) | h1) & high;
                } else {
                    let prev: u64 = x0 << 8; if (last >= 0) { prev = prev | (last as u64); } else { prev = prev | ((x0 & 255) ^ 255); }
                    let e0: u64 = x0 ^ prev; let e1: u64 = x1 ^ ((x1 << 8) | (x0 >> 56));
                    let same0: u64 = ((((e0 & low) + low) | e0) & high) ^ high; let same1: u64 = ((((e1 & low) + low) | e1) & high) ^ high;
                    if ((same0 | same1) != 0) {
                        let l0: u64 = (y0 + sa0) ^ (y0 + sb0); let l1: u64 = (y1 + sa0) ^ (y1 + sb0); let h0: u64 = 0; let h1: u64 = 0;
                        if (!ssmall) {
                            l0 = l0 | ((y0 + sa1) ^ (y0 + sb1)) | ((y0 + sa2) ^ (y0 + sb2)); h0 = ((y0 + sah) ^ (y0 + sbh)) & x0;
                            l1 = l1 | ((y1 + sa1) ^ (y1 + sb1)) | ((y1 + sa2) ^ (y1 + sb2)); h1 = ((y1 + sah) ^ (y1 + sbh)) & x1;
                        }
                        dm0 = (((l0 | x0) ^ x0) | h0) & same0; dm1 = (((l1 | x1) ^ x1) | h1) & same1;
                    }
                    last = (x1 >> 56) as i32;
                }
                j += 2;
                if ((dm0 | dm1) == 0) {
                    if (at + 1 >= cap) { o.acc = acc; o.fill = 0; o.at = at; ext::text_lines::spill(o); at = o.at; cap = o.cap; wv = o.w; }
                    let w0: u64 = acc | (x0 << ff); let w1: u64 = ((x0 >> back) & keep) | (x1 << ff);
                    wv[cap-1-at] = w0; wv[cap-2-at] = w1; at += 2; acc = (x1 >> back) & keep;
                    continue;
                }
                let a1: u64 = dm0 >> 7; let b1: u64 = dm1 >> 7; let ia: u64 = a1 * ones; let ib: u64 = b1 * ones;
                let ka: u64 = (a1 * 255) ^ ext::text_lines::ALL; let kb: u64 = (b1 * 255) ^ ext::text_lines::ALL;
                let ea: u64 = (ia - a1) & ka; let eb: u64 = (ib - b1) & kb; let xa: u64 = x0 & ka; let xb: u64 = x1 & kb;
                let ma: u64 = (ea & ones) * 255; let mb: u64 = (eb & ones) * 255;
                let ta: u64 = xa & ma; let tb: u64 = xb & mb; xa = (xa ^ ta) | (ta >> 8); xb = (xb ^ tb) | (tb >> 8);
                ta = ea & ma; tb = eb & mb; ea = (ea ^ ta) | (ta >> 8); eb = (eb ^ tb) | (tb >> 8);
                ma = ((ea >> 1) & ones) * 255; mb = ((eb >> 1) & ones) * 255;
                ta = xa & ma; tb = xb & mb; xa = (xa ^ ta) | (ta >> 16); xb = (xb ^ tb) | (tb >> 16);
                ta = ea & ma; tb = eb & mb; ea = (ea ^ ta) | (ta >> 16); eb = (eb ^ tb) | (tb >> 16);
                ma = ((ea >> 2) & ones) * 255; mb = ((eb >> 2) & ones) * 255;
                ta = xa & ma; tb = xb & mb; xa = (xa ^ ta) | (ta >> 32); xb = (xb ^ tb) | (tb >> 32);
                let k0: i32 = 8 - ((ia >> 56) as i32); let kk: i32 = 8 - ((ib >> 56) as i32);
                // Append xa (k0 bytes, 0..8) then xb (kk bytes).
                if (k0 > 0) {
                    acc = acc | (xa << ff); fill += k0;
                    if (fill >= 8) {
                        if (at == cap) { o.acc = acc; o.fill = 0; o.at = at; ext::text_lines::spill(o); at = o.at; cap = o.cap; wv = o.w; }
                        wv[cap-1-at] = acc; at += 1; fill -= 8;
                        if (fill == 0) { acc = 0; } else { acc = xa >> (((k0 - fill) * 8) as u64); }
                    }
                    ff = (fill * 8) as u64;
                }
                if (kk > 0) {
                    acc = acc | (xb << ff); fill += kk;
                    if (fill >= 8) {
                        if (at == cap) { o.acc = acc; o.fill = 0; o.at = at; ext::text_lines::spill(o); at = o.at; cap = o.cap; wv = o.w; }
                        wv[cap-1-at] = acc; at += 1; fill -= 8;
                        if (fill == 0) { acc = 0; } else { acc = xb >> (((kk - fill) * 8) as u64); }
                    }
                    ff = (fill * 8) as u64;
                }
                back = (64 - ff) & 63; keep = 0; if (fill != 0) { keep = ext::text_lines::ALL; }
            }
            while (j < nw) {
                let x: u64 = ws[base-j]; let y: u64 = x & low; let dm: u64 = 0; j += 1;
                if (deleting) {
                    let l: u64 = (y + da0) ^ (y + db0); let h: u64 = 0;
                    if (!dsmall) { l = l | ((y + da1) ^ (y + db1)) | ((y + da2) ^ (y + db2)); h = ((y + dah) ^ (y + dbh)) & x; }
                    dm = (((l | x) ^ x) | h) & high;
                } else {
                    let prev: u64 = x << 8; if (last >= 0) { prev = prev | (last as u64); } else { prev = prev | ((x & 255) ^ 255); }
                    let e: u64 = x ^ prev; let same: u64 = ((((e & low) + low) | e) & high) ^ high;
                    if (same != 0) {
                        let l: u64 = (y + sa0) ^ (y + sb0); let h: u64 = 0;
                        if (!ssmall) { l = l | ((y + sa1) ^ (y + sb1)) | ((y + sa2) ^ (y + sb2)); h = ((y + sah) ^ (y + sbh)) & x; }
                        dm = (((l | x) ^ x) | h) & same;
                    }
                    last = (x >> 56) as i32;
                }
                if (dm == 0) {
                    if (at == cap) { o.acc = acc; o.fill = 0; o.at = at; ext::text_lines::spill(o); at = o.at; cap = o.cap; wv = o.w; }
                    let word: u64 = acc | (x << ff); wv[cap-1-at] = word; at += 1; acc = (x >> back) & keep;
                    continue;
                }
                let d1: u64 = dm >> 7; let incl: u64 = d1 * ones; let km: u64 = (d1 * 255) ^ ext::text_lines::ALL;
                let e: u64 = (incl - d1) & km; let xs: u64 = x & km;
                let m1: u64 = (e & ones) * 255; let xm: u64 = xs & m1; xs = (xs ^ xm) | (xm >> 8); let em: u64 = e & m1; e = (e ^ em) | (em >> 8);
                let m2: u64 = ((e >> 1) & ones) * 255; xm = xs & m2; xs = (xs ^ xm) | (xm >> 16); em = e & m2; e = (e ^ em) | (em >> 16);
                let m4: u64 = ((e >> 2) & ones) * 255; xm = xs & m4; xs = (xs ^ xm) | (xm >> 32);
                let k: i32 = 8 - ((incl >> 56) as i32);
                if (k > 0) {
                    acc = acc | (xs << ff); fill += k;
                    if (fill >= 8) {
                        if (at == cap) { o.acc = acc; o.fill = 0; o.at = at; ext::text_lines::spill(o); at = o.at; cap = o.cap; wv = o.w; }
                        wv[cap-1-at] = acc; at += 1; fill -= 8;
                        if (fill == 0) { acc = 0; } else { acc = xs >> (((k - fill) * 8) as u64); }
                    }
                    ff = (fill * 8) as u64; back = (64 - ff) & 63; keep = 0; if (fill != 0) { keep = ext::text_lines::ALL; }
                }
            }
            if (j == nw && j * 8 == n) { break; }
        }
        let x: u64 = w.tail; let lanes: i32 = n - nw * 8; if (j < nw) { x = ws[base-j]; lanes = 8; }
        j += 1;
        if (lanes == 0) { continue; }
        let slow: bool = !(fast && lanes == 8);
        let dm: u64 = 0;
        if (!slow) {
            let y: u64 = x & low;
            if (deleting) {
                let l: u64 = ((y + da0) ^ (y + db0)) | ((y + da1) ^ (y + db1)) | ((y + da2) ^ (y + db2));
                dm = ((((l | x) ^ x) | (((y + dah) ^ (y + dbh)) & x)) & high);
            }
            if (squeezing) {
                if (dm != 0) { slow = true; }
                else {
                    let prev: u64 = x << 8; if (last >= 0) { prev = prev | (last as u64); } else { prev = prev | ((x & 255) ^ 255); }
                    let e: u64 = x ^ prev; let same: u64 = ((((e & low) + low) | e) & high) ^ high;
                    let l: u64 = ((y + sa0) ^ (y + sb0)) | ((y + sa1) ^ (y + sb1)) | ((y + sa2) ^ (y + sb2));
                    dm = ((((l | x) ^ x) | (((y + sah) ^ (y + sbh)) & x)) & high) & same;
                    last = (x >> 56) as i32;
                }
            }
        }
        if (!slow) {
            // Close the gaps in three steps: each kept byte moves down by
            // the count of dropped bytes below it, one bit of that count at
            // a time (no two bytes ever meet).
            let d1: u64 = dm >> 7; let incl: u64 = d1 * ones; let km: u64 = (d1 * 255) ^ ext::text_lines::ALL;
            let e: u64 = (incl - d1) & km; let xs: u64 = x & km;
            let m1: u64 = (e & ones) * 255; let xm: u64 = xs & m1; xs = (xs ^ xm) | (xm >> 8); let em: u64 = e & m1; e = (e ^ em) | (em >> 8);
            let m2: u64 = ((e >> 1) & ones) * 255; xm = xs & m2; xs = (xs ^ xm) | (xm >> 16); em = e & m2; e = (e ^ em) | (em >> 16);
            let m4: u64 = ((e >> 2) & ones) * 255; xm = xs & m4; xs = (xs ^ xm) | (xm >> 32);
            let k: i32 = 8 - ((incl >> 56) as i32);
            if (k > 0) {
                acc = acc | (xs << ((fill * 8) as u64)); fill += k;
                if (fill >= 8) {
                    if (at == cap) { o.acc = acc; o.fill = 0; o.at = at; ext::text_lines::spill(o); at = o.at; cap = o.cap; wv = o.w; }
                    wv[cap-1-at] = acc; at += 1; fill -= 8;
                    if (fill == 0) { acc = 0; } else { acc = xs >> (((k - fill) * 8) as u64); }
                }
            }
            continue;
        }
        let sh: u64 = 0; let stop: u64 = (lanes * 8) as u64;
        while (sh < stop) {
            let c: i32 = ((x >> sh) & 255) as i32; sh += 8;
            if (deleting && t[256+c] != 0) { continue; }
            if (squeezing && c == last && t[512+c] != 0) { continue; }
            last = c;
            acc = acc | ((c as u64) << ((fill * 8) as u64)); fill += 1;
            if (fill == 8) {
                if (at == cap) { o.acc = acc; o.fill = 0; o.at = at; ext::text_lines::spill(o); at = o.at; cap = o.cap; wv = o.w; }
                wv[cap-1-at] = acc; at += 1; acc = 0; fill = 0;
            }
        }
    }
    o.acc = acc; o.fill = fill; o.at = at;
    st.last = last; w.destroy();
    return core::result::Ok(0);
}

// GNU's message for each error.
fn tr_text(value: str, count: i32) -> core::slice::View<u8> {
    let bytes: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::string_data_ptr(value), count);
    return core::slice::View { values: bytes, start: 0, length: count };
}
pub fn message(e: Error) -> core::slice::View<u8> {
    return match (e) {
        Error::MissingOperand -> tr_text("missing operand", 15),
        Error::ExtraOperand -> tr_text("extra operand", 13),
        Error::MissingClassName -> tr_text("missing character class name '[::]'", 35),
        Error::MissingEquivChar -> tr_text("missing equivalence class character '[==]'", 42),
        Error::InvalidClass -> tr_text("invalid character class", 23),
        Error::EquivNotSingle -> tr_text("equivalence class operand must be a single character", 52),
        Error::InvalidRepeat -> tr_text("invalid repeat count in [c*n] construct", 39),
        Error::ReverseRange -> tr_text("range-endpoints are in reverse collating sequence order", 55),
        Error::RepeatInSet1 -> tr_text("the [c*] repeat construct may not appear in string1", 51),
        Error::TwoRepeats -> tr_text("only one [c*] repeat construct may appear in string2", 52),
        Error::RepeatNotTranslating -> tr_text("the [c*] construct may appear in string2 only when translating", 62),
        Error::EquivInSet2 -> tr_text("[=c=] expressions may not appear in string2 when translating", 60),
        Error::ClassInSet2 -> tr_text("when translating, the only character classes that may appear in string2 are 'upper' and 'lower'", 95),
        Error::Misaligned -> tr_text("misaligned [:upper:] and/or [:lower:] construct", 47),
        Error::EmptySet2 -> tr_text("when not truncating set1, string2 must be non-empty", 51),
        Error::Set2EndsWithClass -> tr_text("when translating with string1 longer than string2, the latter string must not end with a character class", 104),
        Error::ComplementClass -> tr_text("when translating with complemented character classes, string2 must map all characters in the domain to one", 106),
        Error::LimitExceeded -> tr_text("set too large", 13),
        Error::AllocationFailed -> tr_text("allocation failed", 17)
    };
}
