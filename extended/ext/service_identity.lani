// RFC 9525 DNS-ID/IP-ID matching. No trust, path, clock or DNS lookup.
// References own inline bytes; certificates retain their X.509 borrowed backing.
module ext::service_identity;
import core::option;
import core::result;
import core::slice;
import ext::x509;

pub enum Error { Bounds, InvalidDns, InvalidIp, InvalidReference, X509(ext::x509::Error) }
pub enum Kind { Dns, Ip }
pub struct Reference { kind: Kind, bytes: [u8;253], length: i32 }
fn valid(value: core::slice::View<u8>) -> bool { return value.start>=0&&value.length>=0&&value.start<=2147483647-value.length; }
fn byte(value: core::slice::View<u8>,index:i32)->u8{return value.values[value.start+index];}
fn lower(value:u8)->u8{if(value>=65&&value<=90){return value+32;}return value;}
fn alphanumeric(value:u8)->bool{return (value>=65&&value<=90)||(value>=97&&value<=122)||(value>=48&&value<=57);}
// RFC1034 root-dot notation: one optional final dot denotes the same root.
// Wire size is normalized length+2, at most255. No search-list expansion.
fn dns_length(value:core::slice::View<u8>,presented:bool)->core::result::Result<i32,Error>{
    if(!valid(value)){return core::result::Err(Error::Bounds);}
    if(value.length==0||value.length>254){return core::result::Err(Error::InvalidDns);}
    let length:i32=value.length;if(byte(value,length-1)==46){length-=1;}
    if(length==0||length>253){return core::result::Err(Error::InvalidDns);}
    let label:i32=0;let hyphen:bool=false;let i:i32=0;
    while(i<length){let c:u8=byte(value,i);
        if(c==46){if(label==0||hyphen){return core::result::Err(Error::InvalidDns);}label=0;hyphen=false;}
        else{
            let wildcard:bool=presented&&i==0&&c==42&&(length==1||byte(value,1)==46);
            if(!wildcard&&!alphanumeric(c)&&c!=45){return core::result::Err(Error::InvalidDns);}
            if(label==0&&c==45){return core::result::Err(Error::InvalidDns);}
            label+=1;if(label>63){return core::result::Err(Error::InvalidDns);}hyphen=c==45;
        }i+=1;
    }
    if(label==0||hyphen){return core::result::Err(Error::InvalidDns);}return core::result::Ok(length);
}
pub fn validate_dns_reference(value:core::slice::View<u8>)->core::result::Result<i32,Error>{return dns_length(value,false);}
pub fn validate_dns_presented(value:core::slice::View<u8>)->core::result::Result<i32,Error>{return dns_length(value,true);}
pub fn dns_reference(value:core::slice::View<u8>)->core::result::Result<Reference,Error>{
    let checked:core::result::Result<i32,Error> = validate_dns_reference(value);if(checked.is_err()){return core::result::Err(checked.unwrap_err());}
    let length:i32=checked.unwrap();let bytes:[u8;253]=[0;253];let i:i32=0;while(i<length){bytes[i]=lower(byte(value,i));i+=1;}
    return core::result::Ok(Reference{kind:Kind::Dns,bytes:bytes,length:length});
}
pub fn ip_reference(value:core::slice::View<u8>)->core::result::Result<Reference,Error>{
    if(!valid(value)){return core::result::Err(Error::Bounds);}if(value.length!=4&&value.length!=16){return core::result::Err(Error::InvalidIp);}
    let bytes:[u8;253]=[0;253];let i:i32=0;while(i<value.length){bytes[i]=byte(value,i);i+=1;}
    return core::result::Ok(Reference{kind:Kind::Ip,bytes:bytes,length:value.length});
}
fn dns_matches(reference:core::slice::View<u8>,r:i32,presented:core::slice::View<u8>,p:i32)->bool{
    let first:i32=0;let second:i32=0;
    if(byte(presented,0)==42){
        while(first<r&&byte(reference,first)!=46){first+=1;}
        if(p==1){return first==r;}second=1;
    }
    if(r-first!=p-second){return false;}
    while(first<r){if(lower(byte(reference,first))!=lower(byte(presented,second))){return false;}first+=1;second+=1;}return true;
}
pub fn match_dns(reference:core::slice::View<u8>,presented:core::slice::View<u8>)->core::result::Result<bool,Error>{
    if(!valid(reference)||!valid(presented)){return core::result::Err(Error::Bounds);}
    let r:core::result::Result<i32,Error> = validate_dns_reference(reference);if(r.is_err()){return core::result::Err(r.unwrap_err());}
    let p:core::result::Result<i32,Error> = validate_dns_presented(presented);if(p.is_err()){return core::result::Err(p.unwrap_err());}
    return core::result::Ok(dns_matches(reference,r.unwrap(),presented,p.unwrap()));
}
fn ip_matches(reference:core::slice::View<u8>,presented:core::slice::View<u8>)->bool{
    if(reference.length!=presented.length){return false;}let difference:u8=0;let i:i32=0;
    while(i<reference.length){difference|=byte(reference,i)^byte(presented,i);i+=1;}return difference==0;
}
pub fn match_ip(reference:core::slice::View<u8>,presented:core::slice::View<u8>)->core::result::Result<bool,Error>{
    if(!valid(reference)||!valid(presented)){return core::result::Err(Error::Bounds);}
    if((reference.length!=4&&reference.length!=16)||(presented.length!=4&&presented.length!=16)){return core::result::Err(Error::InvalidIp);}
    return core::result::Ok(ip_matches(reference,presented));
}
fn work(budget:&ext::x509::Budget,amount:u64,offset:i32)->core::result::Result<i32,Error>{
    if(amount>budget.work_left){return core::result::Err(Error::X509(ext::x509::Error{kind:ext::x509::ErrorKind::WorkLimit,offset:offset}));}
    budget.work_left-=amount;return core::result::Ok(0);
}
pub fn match_certificate(cert:ext::x509::Certificate,reference:Reference,budget:&ext::x509::Budget)->core::result::Result<bool,Error>{
    // Manual field length is checked before creating/indexing a view of the
    // inline array. Then debit before scanning its contents. No reference escapes.
    let dns:bool=match(reference.kind){Kind::Dns->true,Kind::Ip->false};
    if(reference.length<1||reference.length>253||(!dns&&reference.length!=4&&reference.length!=16)){return core::result::Err(Error::InvalidReference);}
    let charged:core::result::Result<i32,Error> = work(budget,(reference.length as u64)+1,0);if(charged.is_err()){return core::result::Err(charged.unwrap_err());}
    let bytes:[u8]=reference.bytes;let expected:core::slice::View<u8> = core::slice::View{values:bytes,start:0,length:reference.length};
    if(dns){let checked:core::result::Result<i32,Error> = validate_dns_reference(expected);if(checked.is_err()||checked.unwrap()!=reference.length){return core::result::Err(Error::InvalidReference);}}
    let extensions:ext::x509::Extensions=cert.extensions();let found:bool=false;let done:bool=false;
    while(!done){let next:core::result::Result<core::option::Option<ext::x509::Extension>,ext::x509::Error> = extensions.next(budget);
        if(next.is_err()){return core::result::Err(Error::X509(next.unwrap_err()));}let entry:core::option::Option<ext::x509::Extension> = next.unwrap();
        if(entry.is_none()){done=true;}else{let extension:ext::x509::Extension=entry.unwrap();let san:bool=match(extension.kind()){ext::x509::ExtensionKind::SubjectAltName->true,_->false};
            if(san){let parsed:core::result::Result<ext::x509::GeneralNames,ext::x509::Error> = extension.subject_alt_names(budget);if(parsed.is_err()){return core::result::Err(Error::X509(parsed.unwrap_err()));}
                let names:ext::x509::GeneralNames=parsed.unwrap();let end:bool=false;
                while(!end){let named:core::result::Result<core::option::Option<ext::x509::GeneralName>,ext::x509::Error> = names.next(budget);if(named.is_err()){return core::result::Err(Error::X509(named.unwrap_err()));}
                    let option:core::option::Option<ext::x509::GeneralName> = named.unwrap();if(option.is_none()){end=true;}else{
                        let name:ext::x509::GeneralName=option.unwrap();let value:core::slice::View<u8> = name.element.content;let tag:u32=name.element.tag.number;
                        if(tag==2||tag==7){
                            // Covers validation and worst-case two-input scans,
                            // independent of a match or early byte inequality.
                            let cost:u64=4*((value.length as u64)+(reference.length as u64))+1;
                            let debit:core::result::Result<i32,Error> = work(budget,cost,value.start-cert.encoded.start);if(debit.is_err()){return core::result::Err(debit.unwrap_err());}
                            if(tag==2){let length:core::result::Result<i32,Error> = validate_dns_presented(value);if(length.is_ok()&&dns){if(dns_matches(expected,reference.length,value,length.unwrap())){found=true;}}}
                            else{if(!dns&&ip_matches(expected,value)){found=true;}}
                        }
                    }
                }
            }
        }
    }return core::result::Ok(found);
}
