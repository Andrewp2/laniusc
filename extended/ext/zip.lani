    }
    put32(bytes,directory,101010256); put16(bytes,directory+8,entries.length); put16(bytes,directory+10,entries.length); put32(bytes,directory+12,(directory-local_size) as u32); put32(bytes,directory+16,local_size as u32); put16(bytes,directory+20,comment.length); copy(comment,bytes,directory+22);
