    // y: each scalar of the source string becomes the target's scalar at
    // the same index; the first occurrence in the source decides.
    fn transliterate(&self, run: &Run, command: Command, space: &Space) -> bool {
        if (!run.check(space)) { return false; }
        let pool: [u8] = self.pool.as_slice(); run.spare.clear();
        let i: i32 = 0;
