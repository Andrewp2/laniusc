        if (command.negated) { return 1 - result; } return result;
    }
    fn cycle(&self, run: &Run, space: &Space, quiet: bool, output: &alloc::vec::Vec<u8>) -> bool {
        let pc: i32 = 0; let count: i32 = self.commands.len(); let deleted: bool = false;
        while (pc < count) {
            let command: Command = self.commands.at(pc);
            let chosen: i32 = self.selected(run,pc,command,space); if (chosen < 0) { return false; }
            if (chosen == 0) { if (command.name == 123) { pc = command.jump; } else { pc += 1; } continue; }
            let name: i32 = command.name; pc += 1;
