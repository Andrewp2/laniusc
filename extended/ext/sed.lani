            active: alloc::vec::new(), until: alloc::vec::new(), workspace: core::result::unwrap(made),
            space: alloc::vec::new(), spare: alloc::vec::new(), input: self.pool.as_slice(), cursor: 0, limit: 0, health: core::lifecycle::health_start(), error: Error::Limit,
            joins: none.as_view(), join: 0, no_joins: none, probed_completion: core::iter_state::completion_start(), found_start: 0, found_end: -1, whole: false,
            pending_from: 0, pending_to: 0, base: 0, quiet_run: false, hit_from: alloc::vec::new(), hit_at: alloc::vec::new()
