impl Command { fn borrow(&self) -> &Command { return self; } }

fn empty_program() -> Program {
    return Program { commands: alloc::vec::new(), regexes: alloc::vec::new(), parts: alloc::vec::new(), pool: alloc::vec::new(), states: 1, groups: 1, quiet: false,
        dfas: alloc::vec::new(), anchored: alloc::vec::new(), ready: alloc::vec::new(), needles: alloc::vec::new(), needle_at: alloc::vec::new() };
}
// Compiles script, a UTF-8 sed script (several -e expressions joined by
// newlines). extended selects POSIX extended regex syntax (-E).
pub fn compile(script: core::slice::View<u8>, extended: bool) -> core::result::Result<Program, Error> {
    if (script.start < 0 || script.length < 0 || script.start > 2147483647 - script.length) { return core::result::Err(Error::Syntax(0)); }
    let checked: core::result::Result<core::text::Text,core::text::Error> = core::text::from_utf8_range(script.values,script.start,script.length);
    if (core::result::is_err(checked)) { let at: i32 = match (core::result::unwrap_err(checked)) { core::text::Error::InvalidUtf8(offset) -> offset, _ -> 0 }; return core::result::Err(Error::InvalidUtf8(at)); }
    let parser: Parser = Parser { script: script.values, base: script.start, length: script.length, at: 0, extended: extended, health: core::lifecycle::health_start(), error: Error::Limit, program: empty_program(), blocks: alloc::vec::new(), raw: alloc::vec::new(), pattern: alloc::vec::new() };
    // "#n" alone on the first line acts as -n.
    if (parser.peek() == 35 && parser.peek_at(1) == 110 && (parser.peek_at(2) < 0 || parser.peek_at(2) == 10)) { parser.program.quiet = true; }
    parser.commands();
    if (!parser.health.is_failed() && parser.blocks.len() > 0) { parser.fail(Error::Syntax(parser.length)); }
    parser.blocks.destroy(); parser.raw.destroy(); parser.pattern.destroy();
    if (parser.health.is_failed()) { parser.program.destroy(); return core::result::Err(parser.error); }
    return core::result::Ok(parser.program);
}

fn width(values: [u8], at: i32) -> i32 {
    let c: u8 = values[at];
    if (c < 128) { return 1; } if (c >= 240) { return 4; } if (c >= 224) { return 3; } return 2;
}

pub impl Program {
