            while (k < command.part_count) {
                let m: i32 = width(pool,command.parts + k);
                if (m == n) { let j: i32 = 0; while (j < n && pool[command.parts + k + j] == space.values[space.start + i + j]) { j += 1; } if (j == n) { found = index; break; } }
                k += m; index += 1;
