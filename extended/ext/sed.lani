    }
    // s///: POSIX leftmost-longest matches; with g, an empty match right
    // after the previous match is skipped, as in GNU sed.
    fn substitute(&self, run: &Run, command: Command, space: &Space, output: &alloc::vec::Vec<u8>) -> bool {
        let chosen: i32 = self.regex_for(run,command.regex); if (chosen < 0) { return false; }
        if (self.absent(run,chosen,space)) { return true; }
        if (!run.check(space)) { return false; }
        let regex: ext::regex::Regex = self.regexes.at(chosen);
        let input: ext::regex::Input = ext::regex::input_unchecked(core::text::from_utf8_unchecked(space.values,space.start,space.length));
        let scratch: &ext::regex::Workspace = run.workspace.borrow();
        run.spare.clear();
        let length: i32 = space.length; let position: i32 = 0; let previous: i32 = -1; let copied: i32 = 0; let count: i32 = 0; let replaced: bool = false;
        while (position <= length) {
            let start: i32 = self.leftmost(run,chosen,input,position);
            if (start == -2) { return false; } if (start < 0) { break; }
            let end: i32 = run.found_end; run.whole = end >= 0 && !command.captures;
            if (!run.whole) {
                let longest: core::result::Result<bool,ext::regex::Error> = regex.longest_prefix_with(input,start,scratch);
                if (core::result::is_err(longest)) { run.fail(regex_failure(core::result::unwrap_err(longest))); return false; }
                end = core::option::unwrap(scratch.span(0)).end;
            }
            run.found_start = start; run.found_end = end;
            if (end == start && start == previous) {
                if (start >= length) { break; }
                position = start + width(space.values,space.start + start); continue;
            }
            count += 1;
