                if (!extend(run.spare.borrow(),space.values,space.start + copied,start - copied)) { run.fail(Error::AllocationFailed); return false; }
                if (!self.expand(run,command,space)) { return false; }
                copied = end; replaced = true;
                if (!command.global) { break; }
            }
            previous = end;
            if (end == start) { if (start >= length) { break; } position = start + width(space.values,space.start + start); }
            else { position = end; }
        }
        if (!replaced) { return true; }
        if (!extend(run.spare.borrow(),space.values,space.start + copied,length - copied)) { run.fail(Error::AllocationFailed); return false; }
        let held: alloc::vec::Vec<u8> = run.space; run.space = run.spare; run.spare = held;
        space.values = run.space.as_slice(); space.start = 0; space.length = run.space.len(); space.original = false;
        if (command.print && !run.emit(output,space)) { return false; }
        return true;
    }
}
impl Space { fn borrow(&self) -> &Space { return self; } }

pub impl Run {
    pub fn borrow(&self) -> &Run { return self; }
    pub fn line_number(&self) -> u64 { return self.line; }
    pub fn ended(&self) -> bool { return self.quit_completion.is_done(); }
    pub fn exit_status(&self) -> i32 { return self.status; }
    // After execute: the end (relative to input.start) of the last line
    // read, before an added join newline.
    pub fn consumed(&self) -> i32 { return self.consumed; }
    // After execute: whether the run asked if more input followed the
    // last line read (a $ address, n, or starting another cycle). An
    // unreadable file at consumed() is one GNU sed would have opened only
    // then.
    pub fn looked_past(&self) -> bool { return self.probed_completion.is_done(); }
    // Starts a new file of a separate-files run (-s, -i): line numbers
    // restart and no range stays open.
    pub fn restart(&self, program: &Program) {
        self.line = 0;
        let active: [u8] = self.active.as_slice(); let i: i32 = 0;
        while (i < program.commands.len()) {
            let command: Command = program.commands.at(i); active[i] = 0;
            if (command.first.kind == 5) { active[i] = 1; }
            i += 1;
        }
    }
    // Output goes to a new destination: no newline is owed to it.
    pub fn new_output(&self) { self.missing = false; }
    pub fn destroy(&self) { self.hit_from.destroy(); self.hit_at.destroy(); self.no_joins.destroy(); self.active.destroy(); self.until.destroy(); self.workspace.destroy(); self.space.destroy(); self.spare.destroy(); }
    fn fail(&self, error: Error) { self.health.fail(); self.error = error; }
    // Whether no input follows the current line; GNU sed only looks for
    // the next file when it asks this.
    fn at_end(&self) -> bool { self.probed_completion.finish(); return self.cursor >= self.limit; }
    fn mark(&self, base: i32) {
        let end: i32 = self.cursor;
        if (self.join > 0 && self.joins.values[self.joins.start + self.join - 1] == end - 1) { end -= 1; }
        self.consumed = end - base;
    }
    // Reads the next line into space.
    fn next(&self, space: &Space) {
        let start: i32 = self.cursor;
        let end: i32 = core::search::find_byte(self.input,start,self.limit,10);
        space.values = self.input; space.start = start; space.checked_completion = core::iter_state::completion_start(); space.original = true;
        if (end < 0) { space.length = self.limit - start; space.chomped = false; self.cursor = self.limit; }
        else {
            space.length = end - start; space.chomped = true; self.cursor = end + 1;
            if (self.join < self.joins.length && self.joins.values[self.joins.start + self.join] == end) { space.chomped = false; self.join += 1; }
        }
        self.line += 1; self.probed_completion = core::iter_state::completion_start();
    }
    fn check(&self, space: &Space) -> bool {
        if (space.checked_completion.is_done()) { return true; }
        let valid: core::result::Result<core::text::Text,core::text::Error> = core::text::from_utf8_range(space.values,space.start,space.length);
        if (core::result::is_err(valid)) { self.fail(Error::InvalidUtf8(-1)); return false; }
        space.checked_completion.finish(); return true;
    }
    // Copies the pending input lines to output.
    fn drain(&self, output: &alloc::vec::Vec<u8>) -> bool {
        let count: i32 = self.pending_to - self.pending_from;
        if (count > 0) {
            if (!extend(output,self.input,self.pending_from,count)) { self.fail(Error::AllocationFailed); return false; }
            self.pending_from = self.pending_to;
        }
        return true;
    }
    fn owed(&self, output: &alloc::vec::Vec<u8>) -> bool {
        if (!self.drain(output)) { return false; }
        if (self.missing) { if (!push(output,10)) { self.fail(Error::AllocationFailed); return false; } self.missing = false; }
        return true;
    }
    // The pattern space, and its newline when the line had one; a missing
    // final newline is written before any later output.
    // An unchanged line that follows the pending ones joins them.
    fn emit(&self, output: &alloc::vec::Vec<u8>, space: &Space) -> bool {
        if (space.original && space.chomped && !self.missing) {
            if (self.pending_to != space.start) { if (!self.drain(output)) { return false; } self.pending_from = space.start; }
            self.pending_to = space.start + space.length + 1; return true;
        }
        if (!self.owed(output) || !extend(output,space.values,space.start,space.length)) { self.fail(Error::AllocationFailed); return false; }
        if (space.chomped) { if (!push(output,10)) { self.fail(Error::AllocationFailed); return false; } } else { self.missing = true; }
        return true;
    }
    fn number(&self, output: &alloc::vec::Vec<u8>) -> bool {
        if (!self.owed(output)) { return false; }
        let divisor: u64 = 1; while (self.line / divisor >= 10) { divisor *= 10; }
        while (divisor > 0) { if (!push(output,(48 + ((self.line / divisor) % 10)) as i32)) { self.fail(Error::AllocationFailed); return false; } divisor /= 10; }
        if (!push(output,10)) { self.fail(Error::AllocationFailed); return false; }
