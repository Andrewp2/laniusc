// A stream editor in the manner of GNU sed 4.9: a script of addressed
// commands applied to each line of an input stream. Commands: s///, y,
// p, d, n, q, Q, =, { } and !. Addresses: line numbers, $, /re/ and \cREc,
// first~step, ranges a1,a2 (also 0,/re/, a1,+N and a1,~N). Regular
// expressions are POSIX basic syntax, or extended with -E, translated to
// ext::regex; s/// takes the leftmost-longest match as POSIX does.
// See docs/extended-sed.md.
module ext::sed;
import core::iter_state;
import core::lifecycle;
import alloc::vec;
import core::mem;
import core::option;
import core::result;
import core::search;
import core::slice;
import core::text;
import ext::regex;

// Offsets are byte positions in the script.
pub enum Error {
    Syntax(i32), UnknownCommand(i32), Unterminated(i32), Regex(i32), Reference(i32), Unsupported(i32),
    InvalidUtf8(i32), NoPreviousRegex, WorkLimit, Limit, AllocationFailed
}
// kind: 0 none, 1 line number, 2 last line ($), 3 regex, 4 first~step,
// 5 line 0 (only in 0,/re/), 6 +N (second only), 7 ~N (second only).
struct Address { kind: i32, number: u64, step: u64, regex: i32 }
// regex -2 is the empty regex: the last one used. jump: for '{', the index
// of its '}'. parts: replacement parts [parts, parts + part_count).
struct Command { name: i32, first: Address, second: Address, negated: bool, regex: i32, parts: i32, part_count: i32, global: bool, print: bool, nth: i32, code: i32, jump: i32, captures: bool }
// kind 0: pool bytes [a, a + b); kind 1: group a.
struct Part { kind: i32, a: i32, b: i32 }
// Per regex: when ready[i] is 1, an unanchored lazy DFA (dfas) and an
// anchored longest-prefix one (anchored); and the literal every match
// contains, needles[needle_at[2i], + |needle_at[2i + 1]|) (length 0: none),
// negative when the regex is nothing but that literal.
pub struct Program {
    commands: alloc::vec::Vec<Command>, regexes: alloc::vec::Vec<ext::regex::Regex>, parts: alloc::vec::Vec<Part>, pool: alloc::vec::Vec<u8>, states: i32, groups: i32, quiet: bool,
    dfas: alloc::vec::Vec<ext::regex::Dfa>, anchored: alloc::vec::Vec<ext::regex::PrefixSet>, ready: alloc::vec::Vec<u8>, needles: alloc::vec::Vec<u8>, needle_at: alloc::vec::Vec<i32>
}
// One stream's execution state. line counts lines read; consumed is the
// number of bytes of the last executed input read so far. status is the
// exit code of a q or Q that ended the run.
pub struct Run {
    line: u64, quit_completion: core::iter_state::Completion, status: i32, missing: bool, consumed: i32, previous: i32,
    active: alloc::vec::Vec<u8>, until: alloc::vec::Vec<u64>, workspace: ext::regex::Workspace,
    space: alloc::vec::Vec<u8>, spare: alloc::vec::Vec<u8>,
    input: [u8], cursor: i32, limit: i32, health: core::lifecycle::Health, error: Error,
    joins: core::slice::View<i32>, join: i32, no_joins: alloc::vec::Vec<i32>, probed_completion: core::iter_state::Completion,
    // The current s/// match; whole: only group 0 is known (from the DFAs).
    found_start: i32, found_end: i32, whole: bool,
    // Unchanged input lines written so far but not yet copied to output:
    // input[pending_from, pending_to), newlines included. base and quiet
    // belong to the current execution (begin_joined).
    pending_from: i32, pending_to: i32, base: i32, quiet_run: bool,
    // Per regex: the first occurrence of its literal in input[hit_from[i],
    // limit), or -1; hit_from[i] is 2147483647 when nothing is known.
    hit_from: alloc::vec::Vec<i32>, hit_at: alloc::vec::Vec<i32>
}
// The pattern space: values[start, start + length). chomped: the line had
// a newline. checked: known to be valid UTF-8. original: values is the
// input and the space is the line as read.
struct Space { values: [u8], start: i32, length: i32, chomped: bool, checked_completion: core::iter_state::Completion, original: bool }

struct Parser { script: [u8], base: i32, length: i32, at: i32, extended: bool, health: core::lifecycle::Health, error: Error, program: Program, blocks: alloc::vec::Vec<i32>, raw: alloc::vec::Vec<u8>, pattern: alloc::vec::Vec<u8> }

fn none() -> Address { return Address { kind: 0, number: 0, step: 0, regex: -1 }; }
fn digit(c: i32) -> bool { return c >= 48 && c <= 57; }
fn blank(c: i32) -> bool { return c == 32 || c == 9; }
fn ascii_alnum(c: i32) -> bool { return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122); }
fn push(target: &alloc::vec::Vec<u8>, value: i32) -> bool { return core::result::is_ok(target.try_push(value as u8)); }
fn push2(target: &alloc::vec::Vec<u8>, a: i32, b: i32) -> bool { return push(target,a) && push(target,b); }
fn extend(target: &alloc::vec::Vec<u8>, values: [u8], start: i32, count: i32) -> bool {
    if (count <= 0) { return true; }
    return core::result::is_ok(target.try_extend(core::slice::View { values: values, start: start, length: count }));
}
fn regex_failure(error: ext::regex::Error) -> Error {
    return match (error) { ext::regex::Error::WorkLimit -> Error::WorkLimit, ext::regex::Error::AllocationFailed -> Error::AllocationFailed, _ -> Error::Limit };
}
// POSIX class name raw[from, to) as ext::regex class contents (ASCII), or "".
fn class_text(raw: [u8], from: i32, to: i32) -> str {
    let n: i32 = to - from;
    if (n == 5 && raw[from] == 97 && raw[from + 1] == 108 && raw[from + 2] == 112) { return "a-zA-Z"; }
    if (n == 5 && raw[from] == 100) { return "0-9"; }
    if (n == 5 && raw[from] == 97 && raw[from + 1] == 108 && raw[from + 2] == 110) { return "0-9A-Za-z"; }
    if (n == 5 && raw[from] == 117) { return "A-Z"; }
    if (n == 5 && raw[from] == 108) { return "a-z"; }
    if (n == 5 && raw[from] == 115) { return " \\t\\n\\r\\f\\v"; }
    if (n == 5 && raw[from] == 98) { return " \\t"; }
    if (n == 5 && raw[from] == 112 && raw[from + 1] == 117) { return "!-/:-@\\[-`{-~"; }
    if (n == 5 && raw[from] == 112 && raw[from + 1] == 114) { return " -~"; }
    if (n == 5 && raw[from] == 103) { return "!-~"; }
    if (n == 5 && raw[from] == 99) { return "\\x00-\\x1f\\x7f"; }
    if (n == 6 && raw[from] == 120) { return "0-9A-Fa-f"; }
    return "";
}
fn class_length(raw: [u8], from: i32, to: i32) -> i32 {
    let n: i32 = to - from;
    if (n == 5 && raw[from] == 97 && raw[from + 1] == 108 && raw[from + 2] == 112) { return 6; }
    if (n == 5 && raw[from] == 100) { return 3; }
    if (n == 5 && raw[from] == 97 && raw[from + 1] == 108 && raw[from + 2] == 110) { return 9; }
    if (n == 5 && raw[from] == 117) { return 3; }
    if (n == 5 && raw[from] == 108) { return 3; }
    if (n == 5 && raw[from] == 115) { return 11; }
    if (n == 5 && raw[from] == 98) { return 3; }
    if (n == 5 && raw[from] == 112 && raw[from + 1] == 117) { return 13; }
    if (n == 5 && raw[from] == 112 && raw[from + 1] == 114) { return 3; }
    if (n == 5 && raw[from] == 103) { return 3; }
    if (n == 5 && raw[from] == 99) { return 13; }
    if (n == 6 && raw[from] == 120) { return 9; }
    return 0;
}
// Whether raw[from, to) spells one of the class names class_text knows.
fn class_known(raw: [u8], from: i32, to: i32) -> bool {
    let names: str = "alpha digit alnum upper lower space blank punct print graph cntrl xdigit";
    let bytes: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::string_data_ptr(names),72);
    let n: i32 = to - from; let i: i32 = 0;
    while (i < 72) {
        let j: i32 = i; while (j < 72 && bytes[j] != 32) { j += 1; }
        if (j - i == n) { let k: i32 = 0; while (k < n && bytes[i + k] == raw[from + k]) { k += 1; } if (k == n) { return true; } }
        i = j + 1;
    }
    return false;
}

impl Parser {
    fn borrow(&self) -> &Parser { return self; }
    fn peek(&self) -> i32 { if (self.at >= self.length) { return -1; } return self.script[self.base + self.at] as i32; }
    fn peek_at(&self, offset: i32) -> i32 { if (self.at + offset >= self.length) { return -1; } return self.script[self.base + self.at + offset] as i32; }
    fn take(&self) -> i32 { let c: i32 = self.peek(); if (c >= 0) { self.at += 1; } return c; }
    fn fail(&self, error: Error) { if (!self.health.is_failed()) { self.health.fail(); self.error = error; } }
    fn oom(&self) { self.fail(Error::AllocationFailed); }
    fn skip_blanks(&self) { while (blank(self.peek())) { self.at += 1; } }
    fn number(&self) -> u64 {
        let value: u64 = 0;
        while (digit(self.peek())) {
            let d: u64 = (self.take() - 48) as u64;
            if (value > (18446744073709551615 - d) / 10) { self.fail(Error::Limit); return 0; }
            value = value * 10 + d;
        }
        return value;
    }
    fn address(&self, second: bool) -> Address {
        let c: i32 = self.peek(); let result: Address = none();
        if (digit(c)) {
            result.number = self.number(); result.kind = 1;
            if (self.peek() == 126 && !second) {
                self.take(); if (!digit(self.peek())) { self.fail(Error::Syntax(self.at)); return result; }
                result.step = self.number(); result.kind = 4;
                // first~0 is the line number first.
                if (result.step == 0) { result.kind = 1; if (result.number == 0) { result.kind = 5; } }
            } else { if (result.number == 0) { result.kind = 5; } }
            return result;
        }
        if (second && (c == 43 || c == 126)) {
            self.take(); if (!digit(self.peek())) { self.fail(Error::Syntax(self.at)); return result; }
            result.number = self.number(); result.kind = 6; if (c == 126) { result.kind = 7; } return result;
        }
        if (c == 36) { self.take(); result.kind = 2; return result; }
        if (c == 47 || c == 92) {
            self.take(); let delimiter: i32 = 47;
            if (c == 92) { delimiter = self.take(); if (delimiter < 0 || delimiter == 10 || delimiter == 92) { self.fail(Error::Unterminated(self.at)); return result; } }
            result.regex = self.regex(delimiter); result.kind = 3;
            if (self.peek() == 73 || self.peek() == 77) { self.fail(Error::Unsupported(self.at)); }
            return result;
        }
        return result;
    }
    // The regex up to an unescaped delimiter, compiled. -2 for an empty one.
    fn regex(&self, delimiter: i32) -> i32 {
        let start: i32 = self.at; self.raw.clear();
        if (delimiter >= 128) { self.fail(Error::Unsupported(start)); return -1; }
        while (true) {
            let c: i32 = self.peek();
            if (c < 0 || c == 10) { self.fail(Error::Unterminated(start)); return -1; }
            self.take();
            if (c == delimiter) { break; }
            // A bracket expression is copied whole: a delimiter in it is
            // literal, as in GNU sed.
            if (c == 91) { if (!self.copy_bracket(start)) { return -1; } continue; }
            if (c == 92) {
                let d: i32 = self.take();
                if (d < 0) { self.fail(Error::Unterminated(start)); return -1; }
                if (d == delimiter) { if (!push(self.raw.borrow(),d)) { self.oom(); return -1; } continue; }
                if (d == 10) { d = 110; }
                if (!push2(self.raw.borrow(),92,d)) { self.oom(); return -1; }
                continue;
            }
            if (!push(self.raw.borrow(),c)) { self.oom(); return -1; }
        }
        if (self.raw.len() == 0) { return -2; }
        self.pattern.clear();
        if (!self.translate(start)) { return -1; }
        let config: ext::regex::Options = ext::regex::options();
        config.dot_matches_newline = true; config.max_work = 2147483647; config.max_captures = 64; config.max_states = 65536;
        let text: core::text::Text = core::text::from_utf8_unchecked(self.pattern.as_slice(),0,self.pattern.len());
        let compiled: core::result::Result<ext::regex::Regex,ext::regex::Error> = ext::regex::compile(text,config);
        if (core::result::is_err(compiled)) {
            let error: Error = match (core::result::unwrap_err(compiled)) { ext::regex::Error::AllocationFailed -> Error::AllocationFailed, ext::regex::Error::Unsupported(at) -> Error::Unsupported(start), _ -> Error::Regex(start) };
            self.fail(error); return -1;
        }
        let regex: ext::regex::Regex = core::result::unwrap(compiled);
        if (core::result::is_err(self.program.regexes.try_push(regex))) { regex.destroy(); self.oom(); return -1; }
        if (!self.accelerate(regex.borrow())) { return -1; }
        if (regex.state_count() > self.program.states) { self.program.states = regex.state_count(); }
        if (regex.group_count() > self.program.groups) { self.program.groups = regex.group_count(); }
        return self.program.regexes.len() - 1;
    }
    // The DFA and required literal of the regex just added.
    fn accelerate(&self, regex: &ext::regex::Regex) -> bool {
        let built: core::result::Result<ext::regex::Dfa,ext::regex::Error> = ext::regex::dfa(regex);
        let machine: ext::regex::Dfa = ext::regex::Dfa { set: ext::regex::prefix_set(), cost: 0, limit: 0 }; let ready: u8 = 0;
        let anchored: ext::regex::PrefixSet = ext::regex::prefix_set();
        let failure: bool = false;
        if (core::result::is_ok(built)) {
            machine = core::result::unwrap(built); ready = 1;
            let added: core::result::Result<i32,ext::regex::Error> = anchored.add(0,regex);
            if (core::result::is_ok(added)) { added = anchored.finish(); }
            if (core::result::is_err(added)) {
                failure = match (core::result::unwrap_err(added)) { ext::regex::Error::AllocationFailed -> true, _ -> false };
                machine.destroy(); anchored.destroy(); machine = ext::regex::Dfa { set: ext::regex::prefix_set(), cost: 0, limit: 0 }; anchored = ext::regex::prefix_set(); ready = 0;
            }
        }
        else { failure = match (core::result::unwrap_err(built)) { ext::regex::Error::AllocationFailed -> true, _ -> false }; }
        if (failure) { self.oom(); return false; }
        // Pushed together: dfas, anchored and ready have one entry per regex.
        if (core::result::is_err(self.program.dfas.try_reserve(1)) || core::result::is_err(self.program.anchored.try_reserve(1)) || core::result::is_err(self.program.ready.try_reserve(1))) {
            if (ready == 1) { machine.destroy(); anchored.destroy(); } self.oom(); return false;
        }
        core::result::unwrap(self.program.dfas.try_push(machine)); core::result::unwrap(self.program.anchored.try_push(anchored)); core::result::unwrap(self.program.ready.try_push(ready));
        let scratch: alloc::vec::Vec<u8> = alloc::vec::new(); let length: i32 = 0;
        if (core::result::is_err(scratch.try_resize(256,0))) { self.oom(); return false; }
        if (!regex.has_lookbehind()) {
            let found: core::result::Result<i32,ext::regex::Error> = regex.required_literal(scratch.as_slice(),256);
            if (core::result::is_err(found)) { scratch.destroy(); self.oom(); return false; }
            length = core::result::unwrap(found);
        }
        let at: i32 = self.program.needles.len();
        // A regex that is only its literal: needle_at holds -length.
        let stored: i32 = length; if (length > 0 && regex.literal_length() == length) { stored = 0 - length; }
        let ok: bool = extend(self.program.needles.borrow(),scratch.as_slice(),0,length) && core::result::is_ok(self.program.needle_at.try_push(at)) && core::result::is_ok(self.program.needle_at.try_push(stored));
        scratch.destroy(); if (!ok) { self.oom(); return false; }
        return true;
    }
    // The rest of a bracket expression after its '[' into raw.
    fn copy_bracket(&self, start: i32) -> bool {
        if (!push(self.raw.borrow(),91)) { self.oom(); return false; }
        if (self.peek() == 94) { if (!push(self.raw.borrow(),self.take())) { self.oom(); return false; } }
        if (self.peek() == 93) { if (!push(self.raw.borrow(),self.take())) { self.oom(); return false; } }
        while (true) {
            let c: i32 = self.peek();
            if (c < 0 || c == 10) { self.fail(Error::Unterminated(start)); return false; }
            self.take(); if (!push(self.raw.borrow(),c)) { self.oom(); return false; }
            if (c == 93) { return true; }
            let kind: i32 = self.peek();
            if (c == 91 && (kind == 58 || kind == 46 || kind == 61)) {
                self.take(); if (!push(self.raw.borrow(),kind)) { self.oom(); return false; }
                while (true) {
                    let d: i32 = self.peek();
                    if (d < 0 || d == 10) { self.fail(Error::Unterminated(start)); return false; }
                    self.take(); if (!push(self.raw.borrow(),d)) { self.oom(); return false; }
                    if (d == kind && self.peek() == 93) { self.take(); if (!push(self.raw.borrow(),93)) { self.oom(); return false; } break; }
                }
            }
        }
        return false;
    }
    fn emit(&self, c: i32) -> bool { if (!push(self.pattern.borrow(),c)) { self.oom(); return false; } return true; }
    fn emit2(&self, a: i32, b: i32) -> bool { return self.emit(a) && self.emit(b); }
    fn emit_str(&self, value: str, count: i32) -> bool {
        let bytes: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::string_data_ptr(value),count);
        let i: i32 = 0; while (i < count) { if (!self.emit(bytes[i] as i32)) { return false; } i += 1; } return true;
    }
    // raw (a POSIX basic or extended regex with the delimiter unescaped)
    // into pattern, in ext::regex syntax.
    fn translate(&self, start: i32) -> bool {
        let raw: [u8] = self.raw.as_slice(); let n: i32 = self.raw.len(); let i: i32 = 0;
        let leading: bool = true;
        while (i < n) {
            let c: i32 = raw[i] as i32;
            if (c == 91) { i = self.bracket(raw,i,n,start); if (i < 0) { return false; } leading = false; continue; }
            if (c == 92) {
                if (i + 1 >= n) { self.fail(Error::Regex(start)); return false; }
                let d: i32 = raw[i + 1] as i32; i += 2;
                if (!self.extended && (d == 40 || d == 124)) { if (!self.emit(d)) { return false; } leading = true; continue; }
                if (!self.extended && (d == 41 || d == 43 || d == 63)) { if (!self.emit(d)) { return false; } leading = false; continue; }
                if (!self.extended && d == 123) {
                    if (!self.emit(123)) { return false; }
                    while (i < n && !(raw[i] == 92 && i + 1 < n && raw[i + 1] == 125)) { if (!self.emit(raw[i] as i32)) { return false; } i += 1; }
                    if (i >= n) { self.fail(Error::Regex(start)); return false; }
                    if (!self.emit(125)) { return false; } i += 2; leading = false; continue;
                }
                if (!self.extended && d == 125) { self.fail(Error::Regex(start)); return false; }
                leading = false;
                if (d == 110 || d == 116 || d == 119 || d == 87 || d == 115 || d == 83 || d == 98 || d == 66 || d == 97 || d == 102 || d == 118 || d == 114) { if (!self.emit2(92,d)) { return false; } continue; }
                if (d == 96) { if (!self.emit2(92,65)) { return false; } continue; }
                if (d == 39) { if (!self.emit2(92,122)) { return false; } continue; }
                if (d == 60 || d == 62 || (d >= 48 && d <= 57) || d == 99 || d == 100 || d == 111 || d == 120) { self.fail(Error::Unsupported(start)); return false; }
                if (ascii_alnum(d) || d >= 128) { if (!self.emit(d)) { return false; } continue; }
                if (!self.emit2(92,d)) { return false; } continue;
            }
            i += 1;
            if (!self.extended) {
                if (c == 42 && leading) { if (!self.emit2(92,42)) { return false; } leading = false; continue; }
                if (c == 94) { if (leading) { if (!self.emit(94)) { return false; } } else { if (!self.emit2(92,94)) { return false; } } continue; }
                if (c == 36) {
                    let anchor: bool = i >= n || (i + 1 < n && raw[i] == 92 && (raw[i + 1] == 41 || raw[i + 1] == 124));
                    if (anchor) { if (!self.emit(36)) { return false; } } else { if (!self.emit2(92,36)) { return false; } }
                    leading = false; continue;
                }
                if (c == 40 || c == 41 || c == 123 || c == 125 || c == 124 || c == 43 || c == 63) { if (!self.emit2(92,c)) { return false; } leading = false; continue; }
            } else {
                if (c == 40 || c == 124) { if (!self.emit(c)) { return false; } leading = true; continue; }
                if (c == 94) { if (!self.emit(94)) { return false; } continue; }
            }
            if (c == 93) { if (!self.emit2(92,93)) { return false; } leading = false; continue; }
            if (!self.emit(c)) { return false; } leading = false;
        }
        return true;
    }
    // The bracket expression at raw[i]; returns the index after it, or -1.
    fn bracket(&self, raw: [u8], from: i32, n: i32, start: i32) -> i32 {
        let i: i32 = from + 1; if (!self.emit(91)) { return -1; }
        if (i < n && raw[i] == 94) { if (!self.emit(94)) { return -1; } i += 1; }
        if (i < n && raw[i] == 93) { if (!self.emit2(92,93)) { return -1; } i += 1; }
        while (true) {
            if (i >= n) { self.fail(Error::Regex(start)); return -1; }
            let c: i32 = raw[i] as i32;
            if (c == 93) { if (!self.emit(93)) { return -1; } return i + 1; }
            if (c == 91 && i + 1 < n && (raw[i + 1] == 58 || raw[i + 1] == 46 || raw[i + 1] == 61)) {
                let kind: u8 = raw[i + 1]; let j: i32 = i + 2;
                while (j + 1 < n && !(raw[j] == kind && raw[j + 1] == 93)) { j += 1; }
                if (j + 1 >= n) { self.fail(Error::Regex(start)); return -1; }
                if (kind != 58) { self.fail(Error::Unsupported(start)); return -1; }
                if (!class_known(raw,i + 2,j)) { self.fail(Error::Regex(start)); return -1; }
                if (!self.emit_str(class_text(raw,i + 2,j),class_length(raw,i + 2,j))) { return -1; }
                i = j + 2; continue;
            }
            if (c == 92) {
                if (i + 1 < n && raw[i + 1] == 110) { if (!self.emit2(92,110)) { return -1; } i += 2; continue; }
                if (i + 1 < n && raw[i + 1] == 116) { if (!self.emit2(92,116)) { return -1; } i += 2; continue; }
                if (!self.emit2(92,92)) { return -1; } i += 1; continue;
            }
            if (c == 91 || c == 94) { if (!self.emit2(92,c)) { return -1; } i += 1; continue; }
            if (!self.emit(c)) { return -1; } i += 1;
        }
        return -1;
    }
    fn literal(&self, c: i32) -> bool { if (!push(self.program.pool.borrow(),c)) { self.oom(); return false; } return true; }
    fn flush(&self, from: i32) -> bool {
        let count: i32 = self.program.pool.len() - from; if (count == 0) { return true; }
        if (core::result::is_err(self.program.parts.try_push(Part { kind: 0, a: from, b: count }))) { self.oom(); return false; }
        return true;
    }
    fn substitute(&self, command: &Command) {
        let open: i32 = self.at; let delimiter: i32 = self.take();
        if (delimiter < 0 || delimiter == 10 || delimiter == 92) { self.fail(Error::Unterminated(open)); return; }
        command.regex = self.regex(delimiter); if (self.health.is_failed()) { return; }
