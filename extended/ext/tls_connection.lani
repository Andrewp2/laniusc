        let counted:core::result::Result<i32,Error> = self.control(); if(counted.is_err()) { return counted; }
        let charged:core::result::Result<i32,Error> = self.charge_handshake(5); if(charged.is_err()) { return charged; }
        let request:u8=0; if(!self.update_response && self.update_intent && self.update_request) { request=1; }
        // Local five-byte staging does not overwrite an incoming fragmented
        // ticket/handshake. Its bytes are copied into the sole sealed slot.
        let bytes:[u8;5]=[24,0,0,1,0]; bytes[4]=request;
        let sealed:core::result::Result<i32,Error> = self.seal_record(core::slice::View { values:bytes,start:0,length:5 },22,9,true); if(sealed.is_err()) { return sealed; }
        self.updates_left-=1; if(self.update_response) { self.update_response=false; } else { self.update_intent=false; } return sealed;
    }
    fn pump_inner(&self)->core::result::Result<bool,Error> {
        let progress:bool=false;
        if(self.content_active) { let processed:core::result::Result<i32,Error> = self.process_content(); if(processed.is_err()) { return core::result::Err(processed.unwrap_err()); } if(processed.unwrap()!=0) { progress=true; } }
        if(self.pending_length!=0) { return core::result::Ok(progress); }
        if(self.tx_at<self.tx.length) { let queued:core::result::Result<i32,Error> = self.queue_fragment(); if(queued.is_err()) { return core::result::Err(queued.unwrap_err()); } return core::result::Ok(true); }
        // TX builders use the shared handshake backing. Never erase a partial
        // RX frame. Control KeyUpdate uses independent tiny staging below.
        if(self.handshake.buffered()==0) {
            let prepared:core::result::Result<i32,Error> = core::result::Ok(0); let build:bool=true;
            if(self.is_client() && self.step==0) { prepared=self.prepare_client_hello(self.retry.is_some()); }
            else { if(!self.is_client() && self.step==11) { prepared=self.prepare_server_hello(true); }
            else { if(!self.is_client() && self.step==13) { prepared=self.prepare_server_hello(false); }
            else { if(!self.is_client() && self.step==14) { prepared=self.prepare_ee(); }
            else { if(!self.is_client() && self.step==15) { prepared=self.prepare_certificate(); }
            else { if(!self.is_client() && self.step==16) { prepared=self.prepare_cv(); }
            else { if((!self.is_client() && self.step==17) || (self.is_client() && self.step==3 && self.tx_action!=8)) { prepared=self.prepare_finished(); }
            else { build=false; }}}}}}}
            if(prepared.is_err()) { return core::result::Err(prepared.unwrap_err()); }
            if(build) { let queued:core::result::Result<i32,Error> = self.queue_fragment(); if(queued.is_err()) { return core::result::Err(queued.unwrap_err()); } return core::result::Ok(true); }
        }
        if(self.step==4 && !self.close_sent) {
            let due:bool=self.sender.unwrap().key_update_due();
            if(self.update_response || self.update_intent || due) { let queued:core::result::Result<i32,Error> = self.queue_update(); if(queued.is_err()) { return core::result::Err(queued.unwrap_err()); } return core::result::Ok(true); }
            if(self.close_intent) {
                let counted:core::result::Result<i32,Error> = self.control(); if(counted.is_err()) { return core::result::Err(counted.unwrap_err()); }
                let bytes:[u8;2]=[1,0]; let queued:core::result::Result<i32,Error> = self.seal_record(core::slice::View { values:bytes,start:0,length:2 },21,10,true); if(queued.is_err()) { return core::result::Err(queued.unwrap_err()); } return core::result::Ok(true);
            }
        }
        return core::result::Ok(progress);
    }
}

pub impl Engine {
    pub fn borrow(&self)->&Engine { return self; }
    pub fn role(&self)->Role { return self.side; }
    pub fn established(&self)->bool { return !self.failed && !self.abandoned && self.step==4; }
    pub fn peer_closed(&self)->bool { return !self.failed && self.peer_close; }
    pub fn local_closed(&self)->bool { return self.close_sent; }
    pub fn close_requested(&self)->bool { return self.close_intent; }
    pub fn pending_plaintext(&self)->i32 { if(self.failed || self.abandoned) { return 0; } return self.app_length-self.app_at; }
    pub fn fatal_alert_pending(&self)->bool { return self.failed && !self.abandoned && self.pending_fatal && self.pending_length>self.pending_at; }
    pub fn failure(&self)->core::option::Option<Error> { if(self.failed) { return core::option::Some(self.issue); } return core::option::None(); }
    pub fn phase(&self)->Phase {
        if(self.failed || self.abandoned) { return Phase::Failed; } if(self.close_sent && self.peer_close) { return Phase::Closed; }
        if(self.step==4) { return Phase::Established; } if(self.step==0 || self.step==10 || self.step==12) { return Phase::ClientHello; }
        if(self.step==1 || self.step==11 || self.step==13) { return Phase::ServerHello; } if(self.step==3 || self.step==18) { return Phase::ClientFinished; } return Phase::ServerFlight;
    }
    pub fn peer_key(&self)->core::option::Option<ext::ed25519::Key32> { if(self.established() && self.is_client()) { return core::option::Some(self.leaf); } return core::option::None(); }
    pub fn negotiated(&self)->core::option::Option<Negotiated> { if(!self.established()) { return core::option::None(); } return core::option::Some(Negotiated { suite:self.selected.unwrap(),group:self.selected_group,alpn:self.alpn,alpn_length:self.alpn_length }); }
    pub fn stats(&self)->Stats { return Stats { received_records:self.received,sent_records:self.sent,controls:self.controls,handshake_bytes:self.handshake_bytes,send_generation:self.send_generation,receive_generation:self.receive_generation,send_sequence:self.send_sequence,receive_sequence:self.receive_sequence,pending_wire:self.pending_length-self.pending_at,pending_plaintext:self.app_length-self.app_at,handshake_buffered:self.handshake.buffered(),retained_content:self.content.length-self.content_at,records_left:self.records_left,controls_left:self.controls_left,handshake_bytes_left:self.handshake_left,key_updates_left:self.updates_left,work_left:self.work_left,signatures_left:self.path_budget.signatures_left }; }
    // Borrow expires at the next mutating engine call. No call reseals a retry.
    // In Failed, only the optional prepared fatal alert is exposed.
    pub fn outgoing(&self)->core::slice::View<u8> { if(self.abandoned || (self.failed && !self.pending_fatal)) { return region(self.buffers.pending_wire,0,0); } return region(self.buffers.pending_wire,self.pending_at,self.pending_length-self.pending_at); }
    pub fn acknowledge_written(&self,n:i32)->core::result::Result<i32,Error> {
        if(n<=0 || n>self.pending_length-self.pending_at) { return core::result::Err(Error::InvalidAcknowledgement); }
        if(self.abandoned) { return core::result::Err(Error::Aborted); } if(self.failed && !self.pending_fatal) { return core::result::Err(self.issue); }
        self.pending_at+=n;
        if(self.pending_at==self.pending_length) {
            let action:i32=self.pending_action; self.pending_at=0; self.pending_length=0; self.pending_action=0;
            let changed:core::result::Result<i32,Error> = self.after_ack(action); if(changed.is_err()) { return core::result::Err(self.fail(changed.unwrap_err())); }
        }
        return core::result::Ok(n);
    }
    pub fn pump(&self)->core::result::Result<bool,Error> {
        if(self.abandoned) { return core::result::Err(Error::Aborted); } if(self.failed) { return core::result::Err(self.issue); }
        let result:core::result::Result<bool,Error> = self.pump_inner(); if(result.is_err()) { return core::result::Err(self.fail(result.unwrap_err())); } return result;
    }
    // At most one newly completed record per call. Retained decoded content may
    // progress first. Caller retains the unconsumed tail, including on failure.
    // Invalid input metadata has priority and is fully retry atomic.
    pub fn feed_wire(&self,input:core::slice::View<u8>)->core::result::Result<i32,FeedFailure> {
        if(!valid(input)) { return core::result::Err(FeedFailure { cause:Error::Bounds,consumed:0 }); }
        if(self.abandoned) { return core::result::Err(FeedFailure { cause:Error::Aborted,consumed:0 }); }
        if(self.failed) { return core::result::Err(FeedFailure { cause:self.issue,consumed:0 }); }
        if(self.peer_close) { return core::result::Ok(input.length); }
        let prior:core::result::Result<bool,Error> = self.pump_inner(); if(prior.is_err()) { return core::result::Err(FeedFailure { cause:self.fail(prior.unwrap_err()),consumed:0 }); }
        if(self.content_active) { return core::result::Ok(0); }
        if(self.record.ready()) { return core::result::Err(FeedFailure { cause:self.fail(Error::Internal),consumed:0 }); }
        let maximum:i32=16645-self.record.buffered(); if(maximum>input.length) { maximum=input.length; }
        let charged:core::result::Result<i32,Error> = self.work(2*(maximum as u64)); if(charged.is_err()) { return core::result::Err(FeedFailure { cause:self.fail(charged.unwrap_err()),consumed:0 }); }
        let fed:core::result::Result<ext::tls_framing::Progress,ext::tls_framing::FeedFailure> = self.record.feed(input);
        if(fed.is_err()) {
            let e:ext::tls_framing::FeedFailure=fed.unwrap_err();
            // The outer TLSCiphertext wire limit has record_overflow semantics;
            // the independent handshake assembler still reports its own cap.
            let issue:Error=Error::Framing(e.cause);
            if(match(e.cause) { ext::tls_framing::Error::TooLarge -> true, _ -> false }) { issue=Error::Record(ext::tls_record::Error::RecordOverflow); }
            return core::result::Err(FeedFailure { cause:self.fail(issue),consumed:e.consumed });
        }
        let consumed:i32=fed.unwrap().consumed;
        if(self.record.ready()) {
            let opened:core::result::Result<i32,Error> = self.open_record(); if(opened.is_err()) { return core::result::Err(FeedFailure { cause:self.fail(opened.unwrap_err()),consumed:consumed }); }
            let progress:core::result::Result<bool,Error> = self.pump_inner(); if(progress.is_err()) { return core::result::Err(FeedFailure { cause:self.fail(progress.unwrap_err()),consumed:consumed }); }
        }
        return core::result::Ok(consumed);
    }
    // Accept at most one record prefix. This reports accepted plaintext, not
    // transmitted bytes. WantOutput accepts none; use outgoing()/acknowledge.
    pub fn queue_plaintext(&self,input:core::slice::View<u8>)->core::result::Result<i32,Error> {
        if(!valid(input)) { return core::result::Err(Error::Bounds); } if(self.abandoned) { return core::result::Err(Error::Aborted); } if(self.failed) { return core::result::Err(self.issue); }
        if(!self.established()) { return core::result::Err(Error::NotEstablished); } if(self.close_intent || self.close_sent) { return core::result::Err(Error::Closed); }
        if(input.length==0) { return core::result::Ok(0); }
        let progress:core::result::Result<bool,Error> = self.pump_inner(); if(progress.is_err()) { return core::result::Err(self.fail(progress.unwrap_err())); }
        if(self.pending_length!=0) { return core::result::Err(Error::WantOutput); }
        let n:i32=input.length; if(n>16384) { n=16384; }
        let sealed:core::result::Result<i32,Error> = self.seal_record(region(input,0,n),23,0,true); if(sealed.is_err()) { return core::result::Err(self.fail(sealed.unwrap_err())); }
        return core::result::Ok(n);
    }
    pub fn read_plaintext(&self,output:core::slice::View<u8>)->core::result::Result<Read,Error> {
        if(!valid(output)) { return core::result::Err(Error::Bounds); } if(self.abandoned) { return core::result::Err(Error::Aborted); } if(self.failed) { return core::result::Err(self.issue); } if(!self.established()) { return core::result::Err(Error::NotEstablished); }
        let n:i32=self.app_length-self.app_at; if(n>output.length) { n=output.length; }
        if(n==0) { if(self.peer_close || output.length==0) { return core::result::Ok(Read { written:0,eof:self.peer_close && self.app_at==self.app_length }); } return core::result::Err(Error::WantInput); }
        let charged:core::result::Result<i32,Error> = self.work(n as u64); if(charged.is_err()) { return core::result::Err(self.fail(charged.unwrap_err())); }
        copy(region(self.buffers.application,self.app_at,n),output); self.app_at+=n;
        return core::result::Ok(Read { written:n,eof:self.peer_close && self.app_at==self.app_length });
    }
    pub fn request_key_update(&self,request_peer:bool)->core::result::Result<i32,Error> {
        if(self.abandoned) { return core::result::Err(Error::Aborted); } if(self.failed) { return core::result::Err(self.issue); } if(!self.established()) { return core::result::Err(Error::NotEstablished); } if(self.close_intent || self.close_sent) { return core::result::Err(Error::Closed); }
        if(self.update_intent) { return core::result::Err(Error::WantOutput); } self.update_intent=true; self.update_request=request_peer; return core::result::Ok(0);
    }
    pub fn begin_close(&self)->core::result::Result<i32,Error> {
        if(self.abandoned) { return core::result::Err(Error::Aborted); } if(self.failed) { return core::result::Err(self.issue); } if(!self.established()) { return core::result::Err(Error::NotEstablished); }
        self.close_intent=true; return core::result::Ok(0);
    }
    pub fn input_eof(&self)->core::result::Result<i32,Error> {
        if(self.abandoned) { return core::result::Err(Error::Aborted); } if(self.failed) { return core::result::Err(self.issue); }
        if(!self.peer_close || self.record.buffered()!=0 || self.handshake.buffered()!=0 || self.content_active) { return core::result::Err(self.fail(Error::Truncated)); } return core::result::Ok(0);
    }
    pub fn export(&self,label:core::slice::View<u8>,context:core::slice::View<u8>,output:core::slice::View<u8>)->core::result::Result<i32,Error> {
        if(!valid(label) || !valid(context) || !valid(output)) { return core::result::Err(Error::Bounds); } if(self.abandoned) { return core::result::Err(Error::Aborted); } if(self.failed) { return core::result::Err(self.issue); } if(!self.established()) { return core::result::Err(Error::NotEstablished); }
        if(label.length<1 || label.length>249 || output.length>ext::tls_schedule::max_output(ext::tls_suite::hash(self.selected.unwrap()))) { return core::result::Err(Error::InvalidConfig); }
        let charged:core::result::Result<i32,Error> = self.work(32768+128*((context.length as u64)+(output.length as u64))); if(charged.is_err()) { return core::result::Err(self.fail(charged.unwrap_err())); }
        if(self.sha384()) {
            let cost:u64=16384*(1+sha384_blocks(context.length as u64))+8192+8*(context.length as u64)+sha384_expand_work(label.length,48,48)+sha384_expand_work(8,48,output.length);
            let extra:core::result::Result<i32,Error> = self.work(cost); if(extra.is_err()) { return core::result::Err(self.fail(extra.unwrap_err())); }
        }
        let exporter:ext::tls_schedule::Exporter=self.exporter.unwrap(); let exported:core::result::Result<i32,ext::tls_schedule::Error> = exporter.export(label,context,output); if(exported.is_err()) { return core::result::Err(self.fail(Error::Crypto)); } return core::result::Ok(exported.unwrap());
    }
    // Abandon does not free caller backing or roll back any spent nonce/cursor.
    pub fn abort(&self)->i32 { if(!self.failed) { self.failed=true; self.issue=Error::Aborted; } self.abandoned=true; self.pending_fatal=false; self.forget_keys(); return self.pending_length-self.pending_at; }
}
