// Portable bounded TLS1.3 client/server, RFC8446 sections4-6.
// One active owner of caller storage and nonce spaces. See the connection guide.
module ext::tls_connection;
import core::iter;
import core::mem;
import core::option;
import core::result;
import ext::tls_hash;
import ext::tls_suite;
import core::slice;
import ext::ed25519;
import ext::service_identity;
import ext::tls_authentication;
import ext::tls_framing;
import ext::tls_handshake;
import ext::tls_negotiation;
import ext::tls_record;
import ext::tls_schedule;
import ext::tls_transcript;
import ext::x25519;
import ext::p256;
import ext::x509;
import ext::x509_path;

pub enum Role { Client, Server }
pub enum Phase { ClientHello, ServerHello, ServerFlight, ClientFinished, Established, Failed, Closed }
pub enum Error {
    Bounds, InvalidConfig, BufferTooSmall, EntropyLength, InvalidEphemeralScalar, Credential,
    NotEstablished, WantInput, WantOutput, WantRead, InvalidAcknowledgement,
    Closed, Aborted, Limit, Truncated, UnexpectedMessage, InvalidRecord,
    InvalidAlert, PeerAlert(u8), Negotiation(ext::tls_negotiation::Error),
    Authentication(ext::tls_authentication::Error), Certificate(ext::x509::Error),
    Record(ext::tls_record::Error), Framing(ext::tls_framing::Error), Crypto, Internal
}
pub struct Limits {
    max_handshake_body:i32, max_hello_frame:i32, max_application_hold:i32,
    max_records:u64, max_controls:u64, max_handshake_bytes:u64,
    max_key_updates:u64, max_work:u64,
    path:ext::x509_path::Limits, negotiation:ext::tls_negotiation::Limits
}
pub struct BufferSizes { record:i32, decrypt:i32, handshake:i32, hello:i32, pending_wire:i32, application:i32, path:i32 }
pub struct Buffers {
    record:core::slice::View<u8>, decrypt:core::slice::View<u8>,
    handshake:core::slice::View<u8>, hello:core::slice::View<u8>,
    pending_wire:core::slice::View<u8>, application:core::slice::View<u8>,
    path:core::slice::View<ext::x509_path::Slot>
}
pub struct ClientConfig {
    anchors:core::slice::View<core::slice::View<u8>>,
    reference:ext::service_identity::Reference, unix_time:i64,
    server_name:core::slice::View<u8>, alpn:core::slice::View<u8>,
    require_alpn:bool, suites:ext::tls_suite::Policy,
    groups:ext::tls_negotiation::GroupPolicy, initial_share:core::option::Option<ext::tls_negotiation::Group>, limits:Limits
}
pub struct ServerConfig {
    chain:core::slice::View<core::slice::View<u8>>, seed:core::slice::View<u8>,
    alpn:core::slice::View<u8>, require_alpn:bool,
    suites:ext::tls_suite::Policy, groups:ext::tls_negotiation::GroupPolicy, require_cookie:bool, limits:Limits
}
pub struct Read { written:i32, eof:bool }
pub struct FeedFailure { cause:Error, consumed:i32 }
pub struct Negotiated { suite:ext::tls_suite::Suite, group:ext::tls_negotiation::Group, alpn:[u8;255], alpn_length:i32 }
pub struct Stats {
    received_records:u64, sent_records:u64, controls:u64, handshake_bytes:u64,
    send_generation:u64, receive_generation:u64, send_sequence:u64, receive_sequence:u64,
    pending_wire:i32, pending_plaintext:i32, handshake_buffered:i32, retained_content:i32,
    records_left:u64, controls_left:u64, handshake_bytes_left:u64,
    key_updates_left:u64, work_left:u64, signatures_left:u64
}
// Fields are implementation state, not a trusted resume/serialization format.
// A value copy permits sole-owner handoff, never concurrent nonce-space use.
pub struct Engine {
    side:Role, step:i32, buffers:Buffers, limits:Limits,
    client_config:core::option::Option<ClientConfig>, server_config:core::option::Option<ServerConfig>,
    path_budget:ext::x509_path::Budget, negotiation_budget:ext::tls_negotiation::Budget,
    records_left:u64, controls_left:u64, handshake_left:u64, updates_left:u64, work_left:u64,
    received:u64, sent:u64, controls:u64, handshake_bytes:u64,
    failed:bool, issue:Error, abandoned:bool, first_hello:bool, peer_finished:bool,
    peer_close:bool, close_intent:bool, close_sent:bool,
    random:[u8;32], scalar:[u8;32], public:[u8;32], p_scalar:[u8;32], p_public:[u8;65], seed:[u8;32],
    transcript:core::option::Option<ext::tls_transcript::State>, first_hello_length:i32,
    first_offer:core::option::Option<ext::tls_negotiation::Offer>,
    offer:core::option::Option<ext::tls_negotiation::Offer>,
    retry:core::option::Option<ext::tls_negotiation::Retry>,
    selected:core::option::Option<ext::tls_suite::Suite>, selected_group:ext::tls_negotiation::Group, peer_share:core::slice::View<u8>, alpn:[u8;255], alpn_length:i32,
    handshake_client:core::option::Option<ext::tls_schedule::Secret>, handshake_server:core::option::Option<ext::tls_schedule::Secret>,
    master:core::option::Option<ext::tls_schedule::Master>, application_client:core::option::Option<ext::tls_schedule::Secret>,
    application_server:core::option::Option<ext::tls_schedule::Secret>, exporter:core::option::Option<ext::tls_schedule::Exporter>,
    authentication:core::option::Option<ext::tls_authentication::State>, leaf:ext::ed25519::Key32,
    sender:core::option::Option<ext::tls_record::Sealer>, receiver:core::option::Option<ext::tls_record::Opener>,
    send_generation:u64, receive_generation:u64, send_sequence:u64, receive_sequence:u64,
    record:ext::tls_framing::RecordDecoder, handshake:ext::tls_framing::HandshakeDecoder,
    content:core::slice::View<u8>, content_at:i32, content_kind:u8, content_active:bool,
    content_epoch:u64, partial_epoch:u64,
    tx:core::slice::View<u8>, tx_at:i32, tx_action:i32, tx_protected:bool,
    pending_length:i32, pending_at:i32, pending_action:i32, pending_fatal:bool,
    app_length:i32, app_at:i32, update_intent:bool, update_request:bool, update_response:bool
}

fn valid<T>(v:core::slice::View<T>)->bool { return v.start>=0 && v.length>=0 && v.start<=2147483647-v.length; }
fn region(v:core::slice::View<u8>,at:i32,n:i32)->core::slice::View<u8> { return core::slice::View { values:v.values,start:v.start+at,length:n }; }
fn byte(v:core::slice::View<u8>,at:i32)->u8 { return v.values[v.start+at]; }
fn copy(input:core::slice::View<u8>,output:core::slice::View<u8>) { let i:i32=0; while(i<input.length) { output.values[output.start+i]=byte(input,i); i+=1; } }
fn path_resource(e:ext::x509_path::Error)->bool { return match(e.kind) { ext::x509_path::ErrorKind::ChainLimit -> true, ext::x509_path::ErrorKind::AnchorLimit -> true, ext::x509_path::ErrorKind::InputLimit -> true, ext::x509_path::ErrorKind::ScratchTooSmall -> true, ext::x509_path::ErrorKind::ItemLimit -> true, ext::x509_path::ErrorKind::WorkLimit -> true, ext::x509_path::ErrorKind::SignatureLimit -> true, _ -> false }; }
fn auth_resource(e:ext::tls_authentication::Error)->bool { return match(e) { ext::tls_authentication::Error::FrameLimit -> true, ext::tls_authentication::Error::WorkLimit -> true, ext::tls_authentication::Error::SignatureLimit -> true, ext::tls_authentication::Error::ScratchTooSmall -> true, ext::tls_authentication::Error::CertificateLimit -> true, ext::tls_authentication::Error::Path(detail) -> path_resource(detail), _ -> false }; }
fn negotiation_resource(e:ext::tls_negotiation::Error)->bool { return match(e) { ext::tls_negotiation::Error::InputLimit -> true, ext::tls_negotiation::Error::WorkLimit -> true, ext::tls_negotiation::Error::BufferTooSmall -> true, _ -> false }; }
fn certificate_resource(e:ext::x509::Error)->bool { return match(e.kind) { ext::x509::ErrorKind::InputLimit -> true, ext::x509::ErrorKind::ItemLimit -> true, ext::x509::ErrorKind::WorkLimit -> true, _ -> false }; }
fn framing_resource(e:ext::tls_framing::Error)->bool { return match(e) { ext::tls_framing::Error::TooLarge -> true, ext::tls_framing::Error::BufferTooSmall -> true, _ -> false }; }
pub fn is_resource_limit(e:Error)->bool { return match(e) { Error::Limit -> true, Error::BufferTooSmall -> true, Error::Negotiation(detail) -> negotiation_resource(detail), Error::Authentication(detail) -> auth_resource(detail), Error::Certificate(detail) -> certificate_resource(detail), Error::Framing(detail) -> framing_resource(detail), _ -> false }; }
pub fn default_limits()->Limits { return Limits { max_handshake_body:1048576,max_hello_frame:16384,max_application_hold:16384,max_records:100000,max_controls:4096,max_handshake_bytes:4194304,max_key_updates:64,max_work:268435456,path:ext::x509_path::default_limits(),negotiation:ext::tls_negotiation::default_limits() }; }
// Sizes count logical elements. Checked also for packed i32-backed byte owners.
pub fn required_buffers(limits:Limits)->core::result::Result<BufferSizes,Error> {
    if(limits.max_handshake_body<124 || limits.max_handshake_body>16777215 || limits.max_hello_frame<128 || limits.max_hello_frame>limits.max_handshake_body+4 || limits.max_application_hold<1 || limits.max_application_hold>2147483644) { return core::result::Err(Error::InvalidConfig); }
    let cookie:i32=limits.max_hello_frame; if(cookie>65533) { cookie=65533; }
    let hello:u64=2*(limits.max_hello_frame as u64)+(cookie as u64);
    if(hello>2147483644 || core::mem::size_of<ext::x509_path::Slot>()>2147483647/16) { return core::result::Err(Error::InvalidConfig); }
    let path:core::result::Result<ext::x509_path::Budget,ext::x509_path::Error> = ext::x509_path::budget(limits.path);
    let negotiation:core::result::Result<ext::tls_negotiation::Budget,ext::tls_negotiation::Error> = ext::tls_negotiation::budget(limits.negotiation);
    if(path.is_err() || negotiation.is_err() || limits.path.max_chain>8 || limits.path.max_anchors>8) { return core::result::Err(Error::InvalidConfig); }
    return core::result::Ok(BufferSizes { record:16645,decrypt:16624,handshake:limits.max_handshake_body+4,hello:hello as i32,pending_wire:16645,application:limits.max_application_hold,path:16 });
}
fn checked_buffers(buffers:Buffers,limits:Limits)->core::result::Result<Buffers,Error> {
    if(!valid(buffers.record) || !valid(buffers.decrypt) || !valid(buffers.handshake) || !valid(buffers.hello) || !valid(buffers.pending_wire) || !valid(buffers.application) || !valid(buffers.path)) { return core::result::Err(Error::Bounds); }
    let sizes:core::result::Result<BufferSizes,Error> = required_buffers(limits); if(sizes.is_err()) { return core::result::Err(sizes.unwrap_err()); } let n:BufferSizes=sizes.unwrap();
    if(buffers.record.length<n.record || buffers.decrypt.length<n.decrypt || buffers.handshake.length<n.handshake || buffers.hello.length<n.hello || buffers.pending_wire.length<n.pending_wire || buffers.application.length<n.application || buffers.path.length<n.path) { return core::result::Err(Error::BufferTooSmall); }
    return core::result::Ok(Buffers { record:region(buffers.record,0,n.record),decrypt:region(buffers.decrypt,0,n.decrypt),handshake:region(buffers.handshake,0,n.handshake),hello:region(buffers.hello,0,n.hello),pending_wire:region(buffers.pending_wire,0,n.pending_wire),application:region(buffers.application,0,n.application),path:core::slice::View { values:buffers.path.values,start:buffers.path.start,length:16 } });
}
fn descriptors(values:core::slice::View<core::slice::View<u8>>,maximum:i32,limit:u64)->core::result::Result<i32,Error> {
    if(!valid(values)) { return core::result::Err(Error::Bounds); }
    if(values.length<1 || values.length>maximum) { return core::result::Err(Error::InvalidConfig); }
    let sum:u64=0; let i:i32=0; while(i<values.length) { let v:core::slice::View<u8> = values.values[values.start+i]; if(!valid(v)) { return core::result::Err(Error::Bounds); } if(v.length==0) { return core::result::Err(Error::InvalidConfig); } sum+=v.length as u64; if(sum>limit) { return core::result::Err(Error::Limit); } i+=1; }
    return core::result::Ok(0);
}
// Canonical random/X/P slots; policy preference never changes their offsets.
pub struct EntropyLayout { length:i32, x25519_offset:core::option::Option<i32>, p256_offset:core::option::Option<i32> }
pub fn entropy_layout(policy:ext::tls_negotiation::GroupPolicy)->core::result::Result<EntropyLayout,Error> {
    let checked:core::result::Result<i32,ext::tls_negotiation::Error> = ext::tls_negotiation::validate_policy(policy); if(checked.is_err()) { return core::result::Err(Error::InvalidConfig); }
    let x:bool=ext::tls_negotiation::group_id(policy.preferred)==29; let p:bool=!x;
    if(policy.fallback.is_some()) { if(ext::tls_negotiation::group_id(policy.fallback.unwrap())==29) { x=true; } else { p=true; } }
    let length:i32=32; let xo:core::option::Option<i32> = core::option::None(); let po:core::option::Option<i32> = core::option::None();
    if(x) { xo=core::option::Some(length); length+=32; } if(p) { po=core::option::Some(length); length+=32; }
    return core::result::Ok(EntropyLayout { length:length,x25519_offset:xo,p256_offset:po });
}
// Source-counted conservative admission units; see tls-group-integration-plan.
// P-256 shared-secret bound: 8712*6144 + 256*32768 + 65536 < 64 Mi.
const P256_WORK:u64=67108864;
// SHA384 fresh finalization and HKDF expansion. Callers preflight label<=249,
// context<=255/output<=12240; external context is bounded by i32 metadata.
fn sha384_blocks(n:u64)->u64 { return (n+144)/128; }
fn sha384_expand_work(label:i32,context:i32,output:i32)->u64 {
    if(output==0) { return 0; }
    let blocks:u64=((output as u64)+47)/48; let info:u64=10+(label as u64)+(context as u64);
    let compressions:u64=2+sha384_blocks(info+1)+1+(blocks-1)*(sha384_blocks(info+49)+1);
    return 16384*compressions+8192+4096*blocks+8*((output as u64)+info*blocks);
}

fn make(side:Role,buffers:Buffers,limits:Limits,policy:ext::tls_negotiation::GroupPolicy,entropy:core::slice::View<u8>)->core::result::Result<Engine,Error> {
    if(!valid(entropy)) { return core::result::Err(Error::Bounds); }
    let layout:core::result::Result<EntropyLayout,Error> = entropy_layout(policy); if(layout.is_err()) { return core::result::Err(layout.unwrap_err()); } let slots:EntropyLayout=layout.unwrap();
    if(entropy.length!=slots.length) { return core::result::Err(Error::EntropyLength); }
    let storage:core::result::Result<Buffers,Error> = checked_buffers(buffers,limits); if(storage.is_err()) { return core::result::Err(storage.unwrap_err()); }
    let cost:u64=0; if(slots.p256_offset.is_some()) { cost+=P256_WORK; } if(slots.x25519_offset.is_some()) { cost+=1048576; }
    if(limits.max_work<cost) { return core::result::Err(Error::Limit); }
    let b:Buffers=storage.unwrap(); let random:[u8;32]=[0;32]; let scalar:[u8;32]=[0;32]; let p_scalar:[u8;32]=[0;32]; let public:[u8;32]=[0;32]; let p_public:[u8;65]=[0;65]; let i:i32=0;
    while(i<32) { random[i]=byte(entropy,i); if(slots.x25519_offset.is_some()) { scalar[i]=byte(entropy,slots.x25519_offset.unwrap()+i); } if(slots.p256_offset.is_some()) { p_scalar[i]=byte(entropy,slots.p256_offset.unwrap()+i); } i+=1; }
    // Invalid P scalars fail in the primitive's fixed scalar admission, before
    // point multiplication, X derivation, or any caller-buffer writes.
    if(slots.p256_offset.is_some()) {
        let derived:core::result::Result<ext::p256::PublicKey,ext::p256::Error> = ext::p256::public_key(core::slice::View { values:p_scalar,start:0,length:32 });
        if(derived.is_err()) { return core::result::Err(match(derived.unwrap_err()) { ext::p256::Error::InvalidScalar -> Error::InvalidEphemeralScalar, _ -> Error::Crypto }); } p_public=derived.unwrap().bytes;
    }
    if(slots.x25519_offset.is_some()) { let derived:core::result::Result<ext::x25519::Key,ext::x25519::Error> = ext::x25519::public_key(core::slice::View { values:scalar,start:0,length:32 }); if(derived.is_err()) { return core::result::Err(Error::Crypto); } public=derived.unwrap().bytes; }
    let step:i32=0; if(match(side) { Role::Client -> false, Role::Server -> true }) { step=10; }
    let empty:core::slice::View<u8> = region(b.handshake,0,0);
    return core::result::Ok(Engine { side:side,step:step,buffers:b,limits:limits,client_config:core::option::None(),server_config:core::option::None(),path_budget:ext::x509_path::budget(limits.path).unwrap(),negotiation_budget:ext::tls_negotiation::budget(limits.negotiation).unwrap(),records_left:limits.max_records,controls_left:limits.max_controls,handshake_left:limits.max_handshake_bytes,updates_left:limits.max_key_updates,work_left:limits.max_work-cost,received:0,sent:0,controls:0,handshake_bytes:0,failed:false,issue:Error::Internal,abandoned:false,first_hello:false,peer_finished:false,peer_close:false,close_intent:false,close_sent:false,random:random,scalar:scalar,public:public,p_scalar:p_scalar,p_public:p_public,seed:[0;32],transcript:core::option::None(),first_hello_length:0,first_offer:core::option::None(),offer:core::option::None(),retry:core::option::None(),selected:core::option::None(),selected_group:policy.preferred,peer_share:empty,alpn:[0;255],alpn_length:0,handshake_client:core::option::None(),handshake_server:core::option::None(),master:core::option::None(),application_client:core::option::None(),application_server:core::option::None(),exporter:core::option::None(),authentication:core::option::None(),leaf:ext::ed25519::Key32 { bytes:[0;32] },sender:core::option::None(),receiver:core::option::None(),send_generation:0,receive_generation:0,send_sequence:0,receive_sequence:0,record:ext::tls_framing::record_decoder(b.record,16640).unwrap(),handshake:ext::tls_framing::handshake_decoder(b.handshake,limits.max_handshake_body).unwrap(),content:empty,content_at:0,content_kind:0,content_active:false,content_epoch:0,partial_epoch:0,tx:empty,tx_at:0,tx_action:0,tx_protected:false,pending_length:0,pending_at:0,pending_action:0,pending_fatal:false,app_length:0,app_at:0,update_intent:false,update_request:false,update_response:false });
}

// Pure-engine seam: entropy MUST match entropy_layout and contain independent
// fresh OS cryptographic slots. Production callers obtain them via tls_tcp.
pub fn client(config:ClientConfig,buffers:Buffers,entropy:core::slice::View<u8>)->core::result::Result<Engine,Error> {
    if(!valid(config.server_name) || !valid(config.alpn)) { return core::result::Err(Error::Bounds); }
    let anchors:core::result::Result<i32,Error> = descriptors(config.anchors,8,config.limits.path.max_input); if(anchors.is_err()) { return core::result::Err(anchors.unwrap_err()); }
    if(config.reference.length<1 || config.reference.length>253 || config.unix_time < -62135596800 || config.unix_time>253402300799) { return core::result::Err(Error::InvalidConfig); }
    let refbytes:core::slice::View<u8> = core::slice::View { values:config.reference.bytes,start:0,length:config.reference.length };
    let reference:core::result::Result<ext::service_identity::Reference,ext::service_identity::Error> = core::result::Err(ext::service_identity::Error::InvalidReference);
    if(match(config.reference.kind) { ext::service_identity::Kind::Dns -> true, ext::service_identity::Kind::Ip -> false }) { reference=ext::service_identity::dns_reference(refbytes); }
    else { reference=ext::service_identity::ip_reference(refbytes); }
    if(reference.is_err() || config.anchors.length>config.limits.path.max_anchors || (config.require_alpn && config.alpn.length==0)) { return core::result::Err(Error::InvalidConfig); }
    if(config.initial_share.is_some()) { let g:u16=ext::tls_negotiation::group_id(config.initial_share.unwrap()); if(g!=ext::tls_negotiation::group_id(config.groups.preferred) && (config.groups.fallback.is_none() || g!=ext::tls_negotiation::group_id(config.groups.fallback.unwrap()))) { return core::result::Err(Error::InvalidConfig); } }
    if(ext::tls_suite::validate_policy(config.suites).is_err()) { return core::result::Err(Error::InvalidConfig); }
    let made:core::result::Result<Engine,Error> = make(Role::Client,buffers,config.limits,config.groups,entropy); if(made.is_err()) { return made; }
    let engine:Engine=made.unwrap(); engine.client_config=core::option::Some(config);
    let prepared:core::result::Result<i32,Error> = engine.prepare_client_hello(false); if(prepared.is_err()) { return core::result::Err(prepared.unwrap_err()); }
    return core::result::Ok(engine);
}
pub fn server(config:ServerConfig,buffers:Buffers,entropy:core::slice::View<u8>)->core::result::Result<Engine,Error> {
    if(!valid(config.seed) || !valid(config.alpn)) { return core::result::Err(Error::Bounds); }
    let chain:core::result::Result<i32,Error> = descriptors(config.chain,8,config.limits.path.max_input); if(chain.is_err()) { return core::result::Err(chain.unwrap_err()); }
    if(config.seed.length!=32 || config.chain.length>config.limits.path.max_chain || config.alpn.length>255 || (config.require_alpn && config.alpn.length==0)) { return core::result::Err(Error::InvalidConfig); }
    if(ext::tls_suite::validate_policy(config.suites).is_err()) { return core::result::Err(Error::InvalidConfig); }
    let made:core::result::Result<Engine,Error> = make(Role::Server,buffers,config.limits,config.groups,entropy); if(made.is_err()) { return made; }
    let engine:Engine=made.unwrap(); engine.server_config=core::option::Some(config);
    let i:i32=0; while(i<32) { engine.seed[i]=byte(config.seed,i); i+=1; }
    let charged:core::result::Result<i32,Error> = engine.work(1048576); if(charged.is_err()) { return core::result::Err(charged.unwrap_err()); }
    let public:core::result::Result<ext::ed25519::Key32,ext::ed25519::Error> = ext::ed25519::public_key(core::slice::View { values:engine.seed,start:0,length:32 }); if(public.is_err()) { return core::result::Err(Error::Credential); }
    let leaf:core::result::Result<ext::x509::Certificate,ext::x509::Error> = ext::x509::parse(config.chain.values[config.chain.start],engine.path_budget.parsing.borrow()); if(leaf.is_err()) { return core::result::Err(Error::Certificate(leaf.unwrap_err())); }
    let cert:ext::x509::Certificate=leaf.unwrap(); let oid:core::slice::View<u8> = cert.spki.algorithm.oid.bytes;
    if(oid.length!=3 || byte(oid,0)!=43 || byte(oid,1)!=101 || byte(oid,2)!=112 || cert.spki.algorithm.parameters.is_some() || cert.spki.key.unused_bits!=0 || cert.spki.key.bytes.length!=32) { return core::result::Err(Error::Credential); }
    let difference:u8=0; i=0; let expected:ext::ed25519::Key32=public.unwrap(); while(i<32) { difference|=expected.bytes[i]^byte(cert.spki.key.bytes,i); i+=1; }
    if(difference!=0) { return core::result::Err(Error::Credential); }
    // The offered certificate-signature profile is Ed25519 for every sent
    // certificate, independently of the leaf proof-of-possession check above.
    i=0; while(i<config.chain.length) {
        let parsed:core::result::Result<ext::x509::Certificate,ext::x509::Error> = ext::x509::parse(config.chain.values[config.chain.start+i],engine.path_budget.parsing.borrow()); if(parsed.is_err()) { return core::result::Err(Error::Certificate(parsed.unwrap_err())); }
        let certificate:ext::x509::Certificate=parsed.unwrap(); let algorithm:core::slice::View<u8> = certificate.signature_algorithm.oid.bytes;
        if(algorithm.length!=3 || byte(algorithm,0)!=43 || byte(algorithm,1)!=101 || byte(algorithm,2)!=112 || certificate.signature_algorithm.parameters.is_some()) { return core::result::Err(Error::Credential); } i+=1;
    }
    return core::result::Ok(engine);
}

impl Engine {
    fn is_client(&self)->bool { return match(self.side) { Role::Client -> true, Role::Server -> false }; }
    fn work(&self,n:u64)->core::result::Result<i32,Error> { if(n>self.work_left) { return core::result::Err(Error::Limit); } self.work_left-=n; return core::result::Ok(0); }
    fn control(&self)->core::result::Result<i32,Error> { if(self.controls_left==0) { return core::result::Err(Error::Limit); } self.controls_left-=1; self.controls+=1; return core::result::Ok(0); }
