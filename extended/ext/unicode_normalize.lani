// Unicode 17.0.0 normalization, UAX #15 revision 57 and Unicode 17 chapter 3.
// No allocation. Caller scratch may change on failure; output never does.
// All selected storage must be physically backed, alive, and disjoint. Input
// stays immutable for the whole call. See docs/extended-unicode-normalize.md.
module ext::unicode_normalize;
import core::option;
import core::result;
import core::slice;
import core::text;
import core::utf8;
import ext::unicode_normalize_data;
import ext::unicode_quick_check_data;

pub enum Form { Nfc, Nfd, Nfkc, Nfkd }
pub enum QuickCheck { Yes, No, Maybe }
pub enum Error { Bounds, InvalidUtf8(i32), SizeOverflow, ScratchCapacity(i32), OutputCapacity(i32), WorkLimit(u64) }
pub struct Normalized { bytes: i32, scalars: i32, scratch: i32, work: u64 }
struct Budget { used: u64, limit: u64 }
impl Budget {
    fn borrow(&self) -> &Budget { return self; }
    fn charge(&self, amount: u64) -> bool {
        if (amount > self.limit - self.used) { return false; }
        self.used += amount; return true;
    }
}

fn compatibility(form: Form) -> bool {
    return match (form) { Form::Nfkc -> true, Form::Nfkd -> true, _ -> false };
}
fn composed(form: Form) -> bool {
    return match (form) { Form::Nfc -> true, Form::Nfkc -> true, _ -> false };
}
pub fn maximum_decomposition_length(form: Form) -> i32 {
    if (compatibility(form)) { return ext::unicode_normalize_data::MAX_COMPATIBILITY_LENGTH; }
    return ext::unicode_normalize_data::MAX_CANONICAL_LENGTH;
}
pub fn maximum_decomposition_depth(form: Form) -> i32 {
    if (compatibility(form)) { return ext::unicode_normalize_data::MAX_COMPATIBILITY_DEPTH; }
    return ext::unicode_normalize_data::MAX_CANONICAL_DEPTH;
}

fn valid(start: i32, length: i32) -> bool {
    return start >= 0 && length >= 0 && start <= 2147483647 - length;
}
// Two-level Unicode 17 entry: ccc, decomposition and quick-check bits. The
// generator proves every decomposable scalar has its D bit and every
// composition's second scalar is NFC_QC=Maybe, so these filters are exact.
// Every entry below U+00A0 is zero: class 0, no decomposition, quick-check Yes.
fn info(value: u32) -> u32 {
    if (value < 160) { return 0; }
    return ext::unicode_quick_check_data::entry(value);
}
fn class_of(value: u32) -> u32 { return info(value) & 255; }
fn mapping(value: u32, compat: bool) -> ext::unicode_normalize_data::Mapping {
    let bits: u32 = info(value);
    if (compat) {
        if ((bits & 512) == 0) { return ext::unicode_normalize_data::Mapping { offset: 0, length: 0 }; }
        return ext::unicode_normalize_data::compatibility(value);
    }
    if ((bits & 256) == 0) { return ext::unicode_normalize_data::Mapping { offset: 0, length: 0 }; }
    return ext::unicode_normalize_data::canonical(value);
}
fn expansion_length(value: u32, mapped: ext::unicode_normalize_data::Mapping) -> i32 {
    if (value >= 44032 && value < 55204) {
        if ((value - 44032) % 28 == 0) { return 2; }
        return 3;
    }
    if (mapped.length == 0) { return 1; }
    return mapped.length;
}
fn expansion_scalar(value: u32, mapped: ext::unicode_normalize_data::Mapping, compat: bool, index: i32) -> u32 {
    if (value >= 44032 && value < 55204) {
        let offset: u32 = value - 44032;
        if (index == 0) { return 4352 + offset / 588; }
        if (index == 1) { return 4449 + (offset % 588) / 28; }
        return 4519 + offset % 28;
    }
    if (mapped.length == 0) { return value; }
    if (compat) { return ext::unicode_normalize_data::compatibility_scalar(mapped.offset + index); }
    return ext::unicode_normalize_data::canonical_scalar(mapped.offset + index);
}

// Revalidate the Text boundary, including fabricated records. InvalidUtf8 is
// relative to the selected input. The count pass never touches scratch.
fn count_expanded(input: core::text::Text, compat: bool, budget: &Budget) -> core::result::Result<i32, Error> {
    let required: i32 = 0; let index: i32 = 0;
    while (index < input.length) {
        if (!budget.charge(1)) { return core::result::Err(Error::WorkLimit(budget.used)); }
        let at: i32 = input.start + index;
        let first: u8 = input.bytes[at];
        let width: u32 = core::utf8::sequence_len_or(first, 0);
        if (width == 0 || (width as i32) > input.length - index) { return core::result::Err(Error::InvalidUtf8(index)); }
        let second: u8 = 0; let third: u8 = 0; let fourth: u8 = 0;
        if (width > 1) { second = input.bytes[at + 1]; }
        if (width > 2) { third = input.bytes[at + 2]; }
        if (width > 3) { fourth = input.bytes[at + 3]; }
        let value: u32 = core::utf8::decode_or(first, second, third, fourth, width, 4294967295);
        if (value == 4294967295) { return core::result::Err(Error::InvalidUtf8(index)); }
        let count: i32 = expansion_length(value, mapping(value, compat));
        if (required > 2147483647 - count) { return core::result::Err(Error::SizeOverflow); }
        required += count; index += width as i32;
    }
    return core::result::Ok(required);
}

// Exact scalar scratch count for the full decomposition, before composition.
pub fn scratch_len(input: core::text::Text, form: Form, work_limit: u64) -> core::result::Result<i32, Error> {
    if (!valid(input.start, input.length)) { return core::result::Err(Error::Bounds); }
    let budget: Budget = Budget { used: 0, limit: work_limit };
    return count_expanded(input, compatibility(form), budget.borrow());
}

fn primary_composite(left: u32, right: u32) -> u32 {
    if (((info(right) >> 10) & 3) != 2) { return 4294967295; }
    if (left >= 4352 && left < 4371 && right >= 4449 && right < 4470) {
        return 44032 + ((left - 4352) * 21 + right - 4449) * 28;
    }
    if (left >= 44032 && left < 55204 && (left - 44032) % 28 == 0 && right > 4519 && right < 4547) {
        return left + right - 4519;
    }
    return ext::unicode_normalize_data::compose(left, right);
}

// Runs longer than this are ordered by order_long_run.
const ORDER_SHORT: i32 = 32;

fn reverse_range(values: core::slice::View<u32>, low: i32, high: i32) {
    let left: i32 = low; let right: i32 = high - 1;
    while (left < right) {
        let held: u32 = values.values[left];
        values.values[left] = values.values[right]; values.values[right] = held;
        left += 1; right -= 1;
    }
}
// First absolute index in [low, high) whose key has the bit set; the range
// is already partitioned with clear bits first. Keys sit in bits 24 to 31.
fn first_set(values: core::slice::View<u32>, low: i32, high: i32, bit: u32) -> i32 {
    let left: i32 = low; let right: i32 = high;
    while (left < right) {
        let middle: i32 = left + (right - left) / 2;
        if (((values.values[middle] >> bit) & 1) == 0) { left = middle + 1; } else { right = middle; }
    }
    return left;
}
// Stable least-significant-digit radix sort by CCC over absolute indices
// [low, high), in place. Scalars need 21 bits, so each CCC is packed into
// bits 24 to 31 for the sort and stripped afterwards. Each varying CCC bit
// gets a bottom-up stable partition whose merges swap two blocks with three
// reversals: O(n log n) per varying bit, at most eight bits, no extra storage.
// Charges: one unit per run scalar, then, unless the run is already in
// order, one unit per run scalar for each merge level of each varying bit.
fn order_long_run(values: core::slice::View<u32>, low: i32, high: i32, budget: &Budget) -> bool {
    let count: i32 = high - low;
    if (!budget.charge(count as u64)) { return false; }
    let any: u32 = 0; let all: u32 = 255; let ordered: bool = true;
    let previous: u32 = 0; let index: i32 = low;
    while (index < high) {
        let ccc: u32 = class_of(values.values[index]);
        values.values[index] = values.values[index] | (ccc << 24);
        any = any | ccc; all = all & ccc;
        if (ccc < previous) { ordered = false; }
        previous = ccc; index += 1;
    }
    let varying: u32 = any & (255 ^ all);
    let bit: u32 = 0;
    if (ordered) { bit = 8; }
    while (bit < 8) {
        if (((varying >> bit) & 1) != 0) {
            let width: i32 = 1;
            while (width < count) {
                if (!budget.charge(count as u64)) { return false; }
                let block: i32 = low;
                while (high - block > width) {
                    let middle: i32 = block + width;
                    let stop: i32 = high;
                    if (high - middle > width) { stop = middle + width; }
                    let left: i32 = first_set(values, block, middle, bit + 24);
                    let right: i32 = first_set(values, middle, stop, bit + 24);
                    if (left < middle && middle < right) {
                        reverse_range(values, left, middle);
                        reverse_range(values, middle, right);
                        reverse_range(values, left, right);
                    }
                    block = stop;
                }
                if (width > count - width) { width = count; } else { width = width * 2; }
            }
        }
        bit += 1;
    }
    index = low;
    while (index < high) { values.values[index] = values.values[index] & 16777215; index += 1; }
    return true;
}

fn prepare(input: core::text::Text, form: Form, scratch: core::slice::View<u32>, budget: &Budget) -> core::result::Result<Normalized, Error> {
    if (!valid(input.start, input.length) || !valid(scratch.start, scratch.length)) { return core::result::Err(Error::Bounds); }
    let compat: bool = compatibility(form);
    let counted: core::result::Result<i32, Error> = count_expanded(input, compat, budget);
    if (core::result::is_err(counted)) { return core::result::Err(core::result::unwrap_err(counted)); }
    let required: i32 = core::result::unwrap(counted);
    if (scratch.length < required) { return core::result::Err(Error::ScratchCapacity(required)); }
    let byte_index: i32 = 0; let length: i32 = 0;
    while (byte_index < input.length) {
        if (!budget.charge(1)) { return core::result::Err(Error::WorkLimit(budget.used)); }
        let value: u32 = core::option::unwrap(input.scalar_at_byte(byte_index));
        byte_index += core::utf8::encoded_len_or(value, 0) as i32;
        let mapped: ext::unicode_normalize_data::Mapping = mapping(value, compat);
        let count: i32 = expansion_length(value, mapped); let part: i32 = 0;
        while (part < count) {
            if (!budget.charge(1)) { return core::result::Err(Error::WorkLimit(budget.used)); }
            scratch.values[scratch.start + length] = expansion_scalar(value, mapped, compat, part);
            length += 1; part += 1;
        }
    }
    // Canonical ordering sorts each maximal run of nonstarters stably by CCC,
    // which is exactly D109's result: starters never move, and a nonstarter
    // only crosses a strictly greater CCC. Runs of at most ORDER_SHORT
    // scalars use insertion sorting; longer runs use order_long_run.
    let index: i32 = 0;
    while (index < length) {
        if (class_of(scratch.values[scratch.start + index]) == 0) {
            if (index > 0) {
                if (!budget.charge(1)) { return core::result::Err(Error::WorkLimit(budget.used)); }
            }
            index += 1;
        } else {
            let end: i32 = index + 1;
            while (end < length && class_of(scratch.values[scratch.start + end]) != 0) { end += 1; }
            if (end - index > ORDER_SHORT) {
                if (!order_long_run(scratch, scratch.start + index, scratch.start + end, budget)) {
                    return core::result::Err(Error::WorkLimit(budget.used));
                }
                index = end;
            } else {
                while (index < end) {
                    if (index > 0) {
                        if (!budget.charge(1)) { return core::result::Err(Error::WorkLimit(budget.used)); }
                    }
                    let value: u32 = scratch.values[scratch.start + index];
                    let ccc: u32 = class_of(value);
                    let position: i32 = index;
                    while (position > 0) {
                        if (!budget.charge(1)) { return core::result::Err(Error::WorkLimit(budget.used)); }
                        let previous: u32 = scratch.values[scratch.start + position - 1];
                        if (class_of(previous) <= ccc) { break; }
                        scratch.values[scratch.start + position] = previous; position -= 1;
                    }
                    scratch.values[scratch.start + position] = value;
                    index += 1;
                }
            }
        }
    }
    if (composed(form)) {
        let starter: i32 = -1; let previous_ccc: u32 = 0;
        let source: i32 = 0; let target: i32 = 0;
        while (source < length) {
            if (!budget.charge(1)) { return core::result::Err(Error::WorkLimit(budget.used)); }
            let value: u32 = scratch.values[scratch.start + source];
            let ccc: u32 = class_of(value);
            let composite: u32 = 4294967295;
            if (starter >= 0 && (previous_ccc == 0 || previous_ccc < ccc)) {
                composite = primary_composite(scratch.values[scratch.start + starter], value);
            }
            if (composite != 4294967295) { scratch.values[scratch.start + starter] = composite; }
            else {
                scratch.values[scratch.start + target] = value;
                if (ccc == 0) { starter = target; }
                previous_ccc = ccc; target += 1;
            }
            source += 1;
        }
        length = target;
    }
    let bytes: i32 = 0; index = 0;
    while (index < length) {
        let width: i32 = core::utf8::encoded_len_or(scratch.values[scratch.start + index], 0) as i32;
        // Reserve encoding work here, so the output commit cannot fail.
        if (!budget.charge(1 + (width as u64))) { return core::result::Err(Error::WorkLimit(budget.used)); }
        if (bytes > 2147483647 - width) { return core::result::Err(Error::SizeOverflow); }
        bytes += width; index += 1;
    }
    return core::result::Ok(Normalized { bytes: bytes, scalars: length, scratch: required, work: budget.used });
}

// Compute the exact normalized size; the normalized scalars occupy scratch's
// prefix. Both size APIs have independent work budgets for each call.
pub fn measure(input: core::text::Text, form: Form, scratch: core::slice::View<u32>, work_limit: u64) -> core::result::Result<Normalized, Error> {
    let budget: Budget = Budget { used: 0, limit: work_limit };
    return prepare(input, form, scratch, budget.borrow());
}

// Output is committed only after every possible returned error. No NUL byte
// is appended. Bytes past Normalized.bytes and outside the view stay intact.
pub fn normalize_into(input: core::text::Text, form: Form, output: core::slice::View<u8>, scratch: core::slice::View<u32>, work_limit: u64) -> core::result::Result<Normalized, Error> {
    if (!valid(output.start, output.length)) { return core::result::Err(Error::Bounds); }
    let budget: Budget = Budget { used: 0, limit: work_limit };
    let prepared: core::result::Result<Normalized, Error> = prepare(input, form, scratch, budget.borrow());
    if (core::result::is_err(prepared)) { return core::result::Err(core::result::unwrap_err(prepared)); }
    let result: Normalized = core::result::unwrap(prepared);
    if (output.length < result.bytes) { return core::result::Err(Error::OutputCapacity(result.bytes)); }
    let index: i32 = 0; let target: i32 = 0;
    while (index < result.scalars) {
        let value: u32 = scratch.values[scratch.start + index];
        let width: u32 = core::utf8::encoded_len_or(value, 0); let part: u32 = 0;
        while (part < width) {
            output.values[output.start + target] = core::utf8::encoded_byte_or(value, part, 0);
            target += 1; part += 1;
        }
        index += 1;
    }
    return core::result::Ok(result);
}

// Full normalization and exact comparison. Quick_Check=Maybe never implies
// normalized: composition and blocking are resolved by the same engine.
pub fn is_normalized(input: core::text::Text, form: Form, scratch: core::slice::View<u32>, work_limit: u64) -> core::result::Result<bool, Error> {
    let budget: Budget = Budget { used: 0, limit: work_limit };
    let prepared: core::result::Result<Normalized, Error> = prepare(input, form, scratch, budget.borrow());
    if (core::result::is_err(prepared)) { return core::result::Err(core::result::unwrap_err(prepared)); }
    let result: Normalized = core::result::unwrap(prepared);
    if (result.bytes != input.length) { return core::result::Ok(false); }
    let index: i32 = 0; let target: i32 = 0;
    while (index < result.scalars) {
        let value: u32 = scratch.values[scratch.start + index];
        let width: u32 = core::utf8::encoded_len_or(value, 0); let part: u32 = 0;
        while (part < width) {
            if (input.bytes[input.start + target] != core::utf8::encoded_byte_or(value, part, 0)) { return core::result::Ok(false); }
            target += 1; part += 1;
        }
        index += 1;
    }
    return core::result::Ok(true);
}

fn form_check(bits: u32, form: Form) -> u32 {
    return match (form) {
        Form::Nfd -> (bits >> 8) & 1,
        Form::Nfkd -> (bits >> 9) & 1,
        Form::Nfc -> (bits >> 10) & 3,
        Form::Nfkc -> (bits >> 12) & 3
    };
}
// UAX #15 section 9 quick check: 0 Yes, 1 No, 2 Maybe. Validates UTF-8 and
// charges one unit per scalar; needs no scratch.
fn check(input: core::text::Text, form: Form, budget: &Budget) -> core::result::Result<u32, Error> {
    if (!valid(input.start, input.length)) { return core::result::Err(Error::Bounds); }
    let result: u32 = 0; let last: u32 = 0; let index: i32 = 0;
    while (index < input.length) {
        if (!budget.charge(1)) { return core::result::Err(Error::WorkLimit(budget.used)); }
        let at: i32 = input.start + index;
        let first: u8 = input.bytes[at];
        if (first < 128) { last = 0; index += 1; continue; }
        let width: u32 = core::utf8::sequence_len_or(first, 0);
        if (width == 0 || (width as i32) > input.length - index) { return core::result::Err(Error::InvalidUtf8(index)); }
        let second: u8 = input.bytes[at + 1]; let third: u8 = 0; let fourth: u8 = 0;
        if (width > 2) { third = input.bytes[at + 2]; }
        if (width > 3) { fourth = input.bytes[at + 3]; }
        let value: u32 = core::utf8::decode_or(first, second, third, fourth, width, 4294967295);
        if (value == 4294967295) { return core::result::Err(Error::InvalidUtf8(index)); }
        let bits: u32 = info(value); let ccc: u32 = bits & 255;
        if (ccc != 0 && last > ccc) { result = 1; }
        let answer: u32 = form_check(bits, form);
        if (answer == 1) { result = 1; }
        if (answer == 2 && result == 0) { result = 2; }
        last = ccc; index += width as i32;
    }
    return core::result::Ok(result);
}
fn quick(code: u32) -> QuickCheck {
    if (code == 0) { return QuickCheck::Yes; }
    if (code == 1) { return QuickCheck::No; }
    return QuickCheck::Maybe;
}
// Quick_Check over the whole input. Yes means already in the form; No means
// not; Maybe needs the full comparison. The whole input is validated even
// after the answer is known, so malformed UTF-8 is always reported.
pub fn quick_check(input: core::text::Text, form: Form, work_limit: u64) -> core::result::Result<QuickCheck, Error> {
    let budget: Budget = Budget { used: 0, limit: work_limit };
    let code: core::result::Result<u32, Error> = check(input, form, budget.borrow());
    if (core::result::is_err(code)) { return core::result::Err(core::result::unwrap_err(code)); }
    return core::result::Ok(quick(core::result::unwrap(code)));
}
// normalize_into with the quick-check fast path: a Yes input is copied
// verbatim (scratch untouched, Normalized.scratch = 0). Otherwise the full
// engine runs under the same budget. Work: one unit per input scalar for the
// check, plus one per copied byte, or plus the full engine's work.
pub fn normalize_quick_into(input: core::text::Text, form: Form, output: core::slice::View<u8>, scratch: core::slice::View<u32>, work_limit: u64) -> core::result::Result<Normalized, Error> {
    if (!valid(output.start, output.length)) { return core::result::Err(Error::Bounds); }
    let budget: Budget = Budget { used: 0, limit: work_limit };
    let code: core::result::Result<u32, Error> = check(input, form, budget.borrow());
    if (core::result::is_err(code)) { return core::result::Err(core::result::unwrap_err(code)); }
    if (core::result::unwrap(code) == 0) {
        let scalars: i32 = budget.used as i32;
        if (!budget.charge(input.length as u64)) { return core::result::Err(Error::WorkLimit(budget.used)); }
        if (output.length < input.length) { return core::result::Err(Error::OutputCapacity(input.length)); }
        let index: i32 = 0;
        while (index < input.length) { output.values[output.start + index] = input.bytes[input.start + index]; index += 1; }
        return core::result::Ok(Normalized { bytes: input.length, scalars: scalars, scratch: 0, work: budget.used });
    }
    let prepared: core::result::Result<Normalized, Error> = prepare(input, form, scratch, budget.borrow());
    if (core::result::is_err(prepared)) { return core::result::Err(core::result::unwrap_err(prepared)); }
    let result: Normalized = core::result::unwrap(prepared);
    if (output.length < result.bytes) { return core::result::Err(Error::OutputCapacity(result.bytes)); }
    let index: i32 = 0; let target: i32 = 0;
    while (index < result.scalars) {
        let value: u32 = scratch.values[scratch.start + index];
        let width: u32 = core::utf8::encoded_len_or(value, 0); let part: u32 = 0;
        while (part < width) {
            output.values[output.start + target] = core::utf8::encoded_byte_or(value, part, 0);
            target += 1; part += 1;
        }
        index += 1;
    }
    return core::result::Ok(result);
}
// is_normalized decided by quick check when it answers Yes or No; Maybe falls
// through to the exact comparison under the same budget.
pub fn is_normalized_quick(input: core::text::Text, form: Form, scratch: core::slice::View<u32>, work_limit: u64) -> core::result::Result<bool, Error> {
    let budget: Budget = Budget { used: 0, limit: work_limit };
    let code: core::result::Result<u32, Error> = check(input, form, budget.borrow());
    if (core::result::is_err(code)) { return core::result::Err(core::result::unwrap_err(code)); }
    let answer: u32 = core::result::unwrap(code);
    if (answer != 2) { return core::result::Ok(answer == 0); }
    let prepared: core::result::Result<Normalized, Error> = prepare(input, form, scratch, budget.borrow());
    if (core::result::is_err(prepared)) { return core::result::Err(core::result::unwrap_err(prepared)); }
    let result: Normalized = core::result::unwrap(prepared);
    if (result.bytes != input.length) { return core::result::Ok(false); }
    let index: i32 = 0; let target: i32 = 0;
    while (index < result.scalars) {
        let value: u32 = scratch.values[scratch.start + index];
        let width: u32 = core::utf8::encoded_len_or(value, 0); let part: u32 = 0;
        while (part < width) {
            if (input.bytes[input.start + target] != core::utf8::encoded_byte_or(value, part, 0)) { return core::result::Ok(false); }
            target += 1; part += 1;
        }
        index += 1;
    }
    return core::result::Ok(true);
}
