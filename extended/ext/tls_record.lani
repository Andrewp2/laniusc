// TLS 1.3 protected records, TLS_CHACHA20_POLY1305_SHA256 only.
// RFC 8446 sections 5, 7.1-7.3. This is not a TLS handshake or connection.
// See docs/extended-tls-record.md for ownership, failure and target contracts.
module ext::tls_record;
import core::result;
import core::slice;
import ext::chacha20_poly1305;
import ext::hkdf_sha256;

pub const MAX_CONTENT: i32 = 16384;
pub const MAX_INNER: i32 = 16385;
pub const MAX_CIPHERTEXT: i32 = 16640;
pub const MAX_RECORD: i32 = 16406;
pub enum Error {
    Bounds, InvalidSecretLength, InvalidType, InvalidContentLength,
    InvalidPadding, RecordOverflow, BufferTooSmall, Exhausted, Poisoned,
    InvalidRecord, Authentication, InvalidInner, Derivation
}
pub struct Opened { content: core::slice::View<u8>, content_type: u8 }
// Use constructors/methods. Fields are implementation state, not a resumption
// format. A value copy does not grant independent rights to use the nonce space.
struct Traffic { secret: [u8; 32], key: [u8; 32], iv: [u8; 12], next: u64, exhausted: bool, poisoned: bool }
pub struct Sealer { traffic: Traffic }
pub struct Opener { traffic: Traffic }

fn valid(value: core::slice::View<u8>) -> bool {
    return value.start >= 0 && value.length >= 0 && value.start <= 2147483647 - value.length;
}
fn region(value: core::slice::View<u8>, offset: i32, length: i32) -> core::slice::View<u8> {
    return core::slice::View { values: value.values, start: value.start + offset, length: length };
}
fn content_type_valid(value: u8) -> bool { return value == 21 || value == 22 || value == 23; }
fn content_length_valid(kind: u8, length: i32) -> bool {
    if (length > MAX_CONTENT) { return false; }
    if (kind == 21) { return length == 2; }
    if (kind == 22) { return length > 0; }
    return true;
}
fn derive(secret: core::slice::View<u8>) -> core::result::Result<Traffic, Error> {
    let stored: [u8; 32] = [0; 32]; let index: i32 = 0;
    while (index < 32) { stored[index] = secret.values[secret.start + index]; index += 1; }
    let key: [u8; 32] = [0; 32]; let iv: [u8; 12] = [0; 12];
    // HkdfLabel: uint16 length; uint8 label length; "tls13 " + label;
    // uint8 context length (zero). Neither label contains a trailing NUL.
    let key_label: [u8; 13] = [0, 32, 9, 116, 108, 115, 49, 51, 32, 107, 101, 121, 0];
    let iv_label: [u8; 12] = [0, 12, 8, 116, 108, 115, 49, 51, 32, 105, 118, 0];
    let prk: core::slice::View<u8> = core::slice::View { values: stored, start: 0, length: 32 };
    let keyed: core::result::Result<i32, ext::hkdf_sha256::Error> = ext::hkdf_sha256::expand(prk,
        core::slice::View { values: key_label, start: 0, length: 13 }, core::slice::View { values: key, start: 0, length: 32 });
    if (core::result::is_err(keyed)) { return core::result::Err(Error::Derivation); }
    let vectored: core::result::Result<i32, ext::hkdf_sha256::Error> = ext::hkdf_sha256::expand(prk,
        core::slice::View { values: iv_label, start: 0, length: 12 }, core::slice::View { values: iv, start: 0, length: 12 });
    if (core::result::is_err(vectored)) { return core::result::Err(Error::Derivation); }
    return core::result::Ok(Traffic { secret: stored, key: key, iv: iv, next: 0, exhausted: false, poisoned: false });
}
pub fn sealer(secret: core::slice::View<u8>) -> core::result::Result<Sealer, Error> {
    if (!valid(secret)) { return core::result::Err(Error::Bounds); }
    if (secret.length != 32) { return core::result::Err(Error::InvalidSecretLength); }
    let made: core::result::Result<Traffic, Error> = derive(secret);
    if (core::result::is_err(made)) { return core::result::Err(core::result::unwrap_err(made)); }
    return core::result::Ok(Sealer { traffic: core::result::unwrap(made) });
}
pub fn opener(secret: core::slice::View<u8>) -> core::result::Result<Opener, Error> {
    if (!valid(secret)) { return core::result::Err(Error::Bounds); }
    if (secret.length != 32) { return core::result::Err(Error::InvalidSecretLength); }
    let made: core::result::Result<Traffic, Error> = derive(secret);
    if (core::result::is_err(made)) { return core::result::Err(core::result::unwrap_err(made)); }
    return core::result::Ok(Opener { traffic: core::result::unwrap(made) });
}
impl Traffic {
    fn borrow(&self) -> &Traffic { return self; }
    fn nonce(&self) -> [u8; 12] {
        let nonce: [u8; 12] = self.iv; let index: i32 = 0;
        while (index < 8) { nonce[4 + index] ^= ((self.next >> ((7 - index) * 8)) & 255) as u8; index += 1; }
        return nonce;
    }
    fn advance(&self) {
        if (self.next == 18446744073709551615) { self.exhausted = true; }
        else { self.next += 1; }
    }
    fn update(&self) -> core::result::Result<i32, Error> {
        if (self.poisoned) { return core::result::Err(Error::Poisoned); }
        let label: [u8; 21] = [0, 32, 17, 116, 108, 115, 49, 51, 32, 116, 114, 97, 102, 102, 105, 99, 32, 117, 112, 100, 0];
        let next_secret: [u8; 32] = [0; 32];
        let expanded: core::result::Result<i32, ext::hkdf_sha256::Error> = ext::hkdf_sha256::expand(
            core::slice::View { values: self.secret, start: 0, length: 32 },
            core::slice::View { values: label, start: 0, length: 21 },
            core::slice::View { values: next_secret, start: 0, length: 32 });
        if (core::result::is_err(expanded)) { return core::result::Err(Error::Derivation); }
        let made: core::result::Result<Traffic, Error> = derive(core::slice::View { values: next_secret, start: 0, length: 32 });
        if (core::result::is_err(made)) { return core::result::Err(core::result::unwrap_err(made)); }
        // Replacement is atomic with respect to every returned error. This
        // overwrites current fields but is not a secure-erasure guarantee.
        let replacement: Traffic = core::result::unwrap(made);
        self.secret = replacement.secret; self.key = replacement.key; self.iv = replacement.iv;
        self.next = 0; self.exhausted = false; return core::result::Ok(0);
    }
}
pub impl Sealer {
    pub fn borrow(&self) -> &Sealer { return self; }
    pub fn sequence(&self) -> u64 { return self.traffic.next; }
    pub fn exhausted(&self) -> bool { return self.traffic.exhausted; }
    pub fn key_update(&self) -> core::result::Result<i32, Error> { return self.traffic.update(); }
    // Input and destination are disjoint, and both are disjoint from self.
    // Every returned error leaves destination and sequence unchanged.
    pub fn seal(&self, content: core::slice::View<u8>, content_type: u8, padding: i32, destination: core::slice::View<u8>) -> core::result::Result<i32, Error> {
        if (!valid(content) || !valid(destination)) { return core::result::Err(Error::Bounds); }
        if (self.traffic.exhausted) { return core::result::Err(Error::Exhausted); }
        if (!content_type_valid(content_type)) { return core::result::Err(Error::InvalidType); }
        if (!content_length_valid(content_type, content.length)) { return core::result::Err(Error::InvalidContentLength); }
        if (padding < 0 || padding > MAX_CONTENT - content.length) { return core::result::Err(Error::InvalidPadding); }
        let inner_length: i32 = content.length + 1 + padding; let cipher_length: i32 = inner_length + 16; let total: i32 = 5 + cipher_length;
        if (destination.length < total) { return core::result::Err(Error::BufferTooSmall); }
        let at: i32 = destination.start;
        destination.values[at] = 23; destination.values[at + 1] = 3; destination.values[at + 2] = 3;
        destination.values[at + 3] = (cipher_length >> 8) as u8; destination.values[at + 4] = (cipher_length & 255) as u8;
        let index: i32 = 0;
        while (index < content.length) { destination.values[at + 5 + index] = content.values[content.start + index]; index += 1; }
        destination.values[at + 5 + index] = content_type; index += 1;
        while (index < inner_length) { destination.values[at + 5 + index] = 0; index += 1; }
        let nonce: [u8; 12] = self.traffic.nonce(); let body: core::slice::View<u8> = region(destination, 5, inner_length);
        // All AEAD preconditions are established above. Exact in-place body
        // encryption and the disjoint header/tag regions are supported.
        core::result::unwrap(ext::chacha20_poly1305::seal_into(
            core::slice::View { values: self.traffic.key, start: 0, length: 32 },
            core::slice::View { values: nonce, start: 0, length: 12 }, region(destination, 0, 5), body, body, region(destination, 5 + inner_length, 16)));
        self.traffic.advance(); return core::result::Ok(total);
    }
}
pub impl Opener {
    pub fn borrow(&self) -> &Opener { return self; }
    pub fn sequence(&self) -> u64 { return self.traffic.next; }
    pub fn exhausted(&self) -> bool { return self.traffic.exhausted; }
    pub fn is_poisoned(&self) -> bool { return self.traffic.poisoned; }
    pub fn key_update(&self) -> core::result::Result<i32, Error> { return self.traffic.update(); }
    // Bounds and undersized scratch are retryable. Malformed records, failed
    // authentication and invalid authenticated inner messages poison self.
    // Record, scratch and self must be mutually disjoint and physically backed.
    // Authentication errors leave scratch unchanged. Authenticated malformed
    // inner plaintext may remain in scratch on InvalidInner/RecordOverflow.
    // The returned content borrows scratch, valid until that storage changes.
    pub fn open(&self, record: core::slice::View<u8>, scratch: core::slice::View<u8>) -> core::result::Result<Opened, Error> {
        if (!valid(record) || !valid(scratch)) { return core::result::Err(Error::Bounds); }
        if (self.traffic.poisoned) { return core::result::Err(Error::Poisoned); }
        if (self.traffic.exhausted) { return core::result::Err(Error::Exhausted); }
        if (record.length < 5) { self.traffic.poisoned = true; return core::result::Err(Error::InvalidRecord); }
        let at: i32 = record.start;
        let length: i32 = ((record.values[at + 3] as i32) << 8) | (record.values[at + 4] as i32);
        if (length > MAX_CIPHERTEXT) { self.traffic.poisoned = true; return core::result::Err(Error::RecordOverflow); }
        if (record.values[at] != 23 || record.values[at + 1] != 3 || record.values[at + 2] != 3 || length < 17 || record.length != length + 5) {
            self.traffic.poisoned = true; return core::result::Err(Error::InvalidRecord);
        }
        let inner_length: i32 = length - 16;
        if (scratch.length < inner_length) { return core::result::Err(Error::BufferTooSmall); }
        let nonce: [u8; 12] = self.traffic.nonce();
        let opened: core::result::Result<i32, ext::chacha20_poly1305::Error> = ext::chacha20_poly1305::open_into(
            core::slice::View { values: self.traffic.key, start: 0, length: 32 },
            core::slice::View { values: nonce, start: 0, length: 12 }, region(record, 0, 5), region(record, 5, inner_length), region(record, 5 + inner_length, 16), scratch);
        if (core::result::is_err(opened)) { self.traffic.poisoned = true; return core::result::Err(Error::Authentication); }
        if (inner_length > MAX_INNER) { self.traffic.poisoned = true; return core::result::Err(Error::RecordOverflow); }
        let end: i32 = inner_length;
        while (end > 0 && scratch.values[scratch.start + end - 1] == 0) { end -= 1; }
        if (end == 0) { self.traffic.poisoned = true; return core::result::Err(Error::InvalidInner); }
        let kind: u8 = scratch.values[scratch.start + end - 1]; let content_length: i32 = end - 1;
        if (!content_type_valid(kind) || !content_length_valid(kind, content_length)) {
            self.traffic.poisoned = true; return core::result::Err(Error::InvalidInner);
        }
        self.traffic.advance(); return core::result::Ok(Opened { content: region(scratch, 0, content_length), content_type: kind });
    }
}
