// Bounded public RSA verification: RFC8017 sections4,5.2.2,8,9,B.2.1.
// RSAE/SPKI and signature identifiers: RFC3279 2.3.1; RFC4055 1,3,5.
// No private-key operations, allocation, key-generation or trust assurance.
module ext::rsa;
import core::option;
import core::result;
import core::sha256;
import core::slice;
import core::u64;
import ext::der;

pub enum Error { Bounds, InvalidLimits, InputLimit, WorkLimit, InvalidModulusEncoding, UnsupportedModulus, InvalidExponent, InvalidKeyEncoding, UnsupportedAlgorithm, InvalidParameters, InvalidDigestLength, InvalidSignatureLength }
pub enum Scheme { Pkcs1v15Sha256, PssSha256Salt32 }
pub struct Limits { max_message:i32, max_work:u64 }
pub struct Budget { message_limit:i32, work_left:u64 }
// Digits are below2^32, little-endian, with64..128 active limbs. Cache fields
// are implementation state, not serialized validation or trust tokens. Use
// constructors, keep state immutable; value copies own independent arrays.
struct Number { limbs:[u64;128] }
pub struct PublicKey { modulus:Number, r2:Number, one:Number, n0:u64, count:i32, bits:i32, size:i32, public_exponent:u32 }
const BASE:u64=4294967296;
const MASK:u64=4294967295;
pub const MIN_MODULUS_BITS:i32=2048;
pub const MAX_MODULUS_BITS:i32=4096;
pub const MAX_KEY_DER_BYTES:i32=1024;
pub const MAX_ALGORITHM_DER_BYTES:i32=256;
fn valid(v:core::slice::View<u8>)->bool{return v.start>=0&&v.length>=0&&v.start<=2147483647-v.length;}
fn byte(v:core::slice::View<u8>,at:i32)->u8{return v.values[v.start+at];}
fn part(v:core::slice::View<u8>,at:i32,n:i32)->core::slice::View<u8>{return core::slice::View{values:v.values,start:v.start+at,length:n};}
fn view(v:[u8],n:i32)->core::slice::View<u8>{return core::slice::View{values:v,start:0,length:n};}
pub fn default_limits()->Limits{return Limits{max_message:1048576,max_work:16777216};}
pub fn budget(limits:Limits)->core::result::Result<Budget,Error>{
    if(limits.max_message<0){return core::result::Err(Error::InvalidLimits);}
    return core::result::Ok(Budget{message_limit:limits.max_message,work_left:limits.max_work});
}
pub impl Budget{pub fn borrow(&self)->&Budget{return self;}}
fn budget_valid(b:&Budget)->bool{return b.message_limit>=0;}
// Admission credits are reserved before each bounded stage, never refunded
// after expensive failure. A rejected reservation consumes no credits.
fn charge(b:&Budget,cost:u64)->bool{if(cost>b.work_left){return false;}b.work_left-=cost;return true;}
fn zero()->Number{let v:[u64;128]=[0;128];return Number{limbs:v};}
fn less(a:Number,b:Number,n:i32)->bool{
    let borrow:u64=0;let i:i32=0;
    while(i<n){let x:u64=a.limbs[i]+BASE-b.limbs[i]-borrow;borrow=1-(x>>32);i+=1;}return borrow!=0;
}
// Input low+top*R is below2n. Subtract once in n+1 digits, retaining the
// original iff the extended subtraction borrowed. All temporaries<2^33.
fn normalize(low:Number,top:u64,m:Number,n:i32)->Number{
    let difference:Number=zero();let borrow:u64=0;let i:i32=0;
    while(i<n){let x:u64=low.limbs[i]+BASE-m.limbs[i]-borrow;difference.limbs[i]=x&MASK;borrow=1-(x>>32);i+=1;}
    let high:u64=top+BASE-borrow;let use_difference:u64=high>>32;
    let mask:u64=core::u64::wrapping_sub(0,use_difference);let result:Number=low;i=0;
    while(i<n){result.limbs[i]^=mask&(low.limbs[i]^difference.limbs[i]);i+=1;}return result;
}
fn double(a:Number,m:Number,n:i32)->Number{
    let result:Number=zero();let carry:u64=0;let i:i32=0;
    while(i<n){let x:u64=a.limbs[i]*2+carry;result.limbs[i]=x&MASK;carry=x>>32;i+=1;}return normalize(result,carry,m,n);
}
// Schoolbook multiplication and Montgomery REDC, radix2^32. Every inner
// a*b+digit+carry <= (B-1)^2+2(B-1)=u64MAX. Propagation sums<=2B-2.
// a,b<n and R=2^(32*count)>n imply REDC<2n, even for non-full top limbs.
fn multiply(a:Number,b:Number,key:&PublicKey)->Number{
    let n:i32=key.count;let t:[u64;257]=[0;257];let i:i32=0;
    while(i<n){let carry:u64=0;let j:i32=0;
        while(j<n){let x:u64=a.limbs[i]*b.limbs[j]+t[i+j]+carry;t[i+j]=x&MASK;carry=x>>32;j+=1;}
        t[i+n]=carry;i+=1;
    }
    i=0;while(i<n){let q:u64=(t[i]*key.n0)&MASK;let carry:u64=0;let j:i32=0;
        while(j<n){let x:u64=q*key.modulus.limbs[j]+t[i+j]+carry;t[i+j]=x&MASK;carry=x>>32;j+=1;}
        let at:i32=i+n;while(at<2*n+1){let x:u64=t[at]+carry;t[at]=x&MASK;carry=x>>32;at+=1;}i+=1;
    }
    let low:Number=zero();i=0;while(i<n){low.limbs[i]=t[i+n];i+=1;}return normalize(low,t[2*n],key.modulus,n);
}
fn setup_cost(n:i32)->u64{let l:u64=n as u64;return 64*l*(6*l+16)+4096;}
fn product_cost(n:i32)->u64{let l:u64=n as u64;return 3*l*l+12*l+256;}
fn exponent_products(e:u32)->u64{
    let x:u32=e;let cost:u64=2;while(x!=0){cost+=1+(x&1) as u64;x>>=1;}return cost;
}
fn hash_cost(n:u64)->u64{return n+64*((n+72)/64);}
fn verification_cost(key:&PublicKey,pss:bool)->u64{
    let cost:u64=exponent_products(key.public_exponent)*product_cost(key.count)+8*(key.size as u64)+4096;
    if(pss){let em:i32=(key.bits+6)/8;cost+=64*(((em-33+31)/32) as u64)+hash_cost(72);}return cost;
}
fn pss(scheme:Scheme)->bool{return match(scheme){Scheme::Pkcs1v15Sha256->false,Scheme::PssSha256Salt32->true};}
// Canonical unsigned magnitude, exponent3..u32MAX odd. The checks do not
// prove factorization, gcd(e,lambda(n)), key generation, possession or trust.
pub fn from_components(modulus:core::slice::View<u8>,exponent:u32,b:&Budget)->core::result::Result<PublicKey,Error>{
    if(!valid(modulus)){return core::result::Err(Error::Bounds);}
    if(!budget_valid(b)){return core::result::Err(Error::InvalidLimits);}
    if(modulus.length==0){return core::result::Err(Error::InvalidModulusEncoding);}
    if(modulus.length>512){return core::result::Err(Error::UnsupportedModulus);}
    if(exponent<3||(exponent&1)==0){return core::result::Err(Error::InvalidExponent);}
    if(!charge(b,(modulus.length as u64)+128)){return core::result::Err(Error::WorkLimit);}
    if(byte(modulus,0)==0){return core::result::Err(Error::InvalidModulusEncoding);}
    if((byte(modulus,modulus.length-1)&1)==0){return core::result::Err(Error::InvalidModulusEncoding);}
    let top:u8=byte(modulus,0);let high:i32=0;while(top!=0){high+=1;top>>=1;}
    let bits:i32=(modulus.length-1)*8+high;
    if(bits<MIN_MODULUS_BITS||bits>MAX_MODULUS_BITS){return core::result::Err(Error::UnsupportedModulus);}
    let n:i32=(bits+31)/32;
    if(!charge(b,setup_cost(n))){return core::result::Err(Error::WorkLimit);}
    let m:Number=zero();let i:i32=0;while(i<modulus.length){let at:i32=modulus.length-1-i;m.limbs[i/4]|=(byte(modulus,at) as u64)<<((i%4)*8);i+=1;}
    let raw_one:Number=zero();raw_one.limbs[0]=1;let power:Number=raw_one;let mont_one:Number=zero();i=0;
    while(i<64*n){power=double(power,m,n);i+=1;if(i==32*n){mont_one=power;}}
    // Newton iteration finds n^-1 mod2^32, doubling precision five times.
    let inverse:u64=1;i=0;while(i<5){let product:u64=(m.limbs[0]*inverse)&MASK;let factor:u64=(BASE+2-product)&MASK;inverse=(inverse*factor)&MASK;i+=1;}
    let n0:u64=(BASE-inverse)&MASK;
    return core::result::Ok(PublicKey{modulus:m,r2:power,one:mont_one,n0:n0,count:n,bits:bits,size:modulus.length,public_exponent:exponent});
}
fn recover(key:&PublicKey,signature:core::slice::View<u8>)->Number{
    let input:Number=zero();let i:i32=0;while(i<signature.length){let at:i32=signature.length-1-i;input.limbs[i/4]|=(byte(signature,at) as u64)<<((i%4)*8);i+=1;}
    let base:Number=multiply(input,key.r2,key);let value:Number=key.one;let exponent:u32=key.public_exponent;let bit:i32=0;
    while(exponent!=0){bit+=1;exponent>>=1;}bit-=1;
    while(bit>=0){value=multiply(value,value,key);if(((key.public_exponent>>bit)&1)!=0){value=multiply(value,base,key);}bit-=1;}
    let one:Number=zero();one.limbs[0]=1;return multiply(value,one,key);
}
fn pkcs_encoded(encoded:[u8],size:i32,digest:core::slice::View<u8>)->bool{
    // RFC8017 9.2 SHA256 DigestInfo: exact DER, including NULL parameters.
    let prefix:[u8;19]=[48,49,48,13,6,9,96,134,72,1,101,3,4,2,1,5,0,4,32];
    let difference:u8=encoded[0]|(encoded[1]^1);let at:i32=2;
    while(at<size-52){difference|=encoded[at]^255;at+=1;}
    difference|=encoded[size-52];at=0;
    while(at<19){difference|=encoded[size-51+at]^prefix[at];at+=1;}
    at=0;while(at<32){difference|=encoded[size-32+at]^byte(digest,at);at+=1;}return difference==0;
}
fn pss_encoded(encoded:[u8],size:i32,bits:i32,digest:core::slice::View<u8>)->bool{
    let em_bits:i32=bits-1;let em_len:i32=(em_bits+7)/8;let start:i32=size-em_len;let difference:u8=0;let i:i32=0;
    // For modBits==1 mod8, I2OSP(m,emLen) requires the leading k byte zero.
    while(i<start){difference|=encoded[i];i+=1;}
    difference|=encoded[size-1]^188;
    let unused:i32=8*em_len-em_bits;let mask:u8=(255>>unused) as u8;difference|=encoded[start]&((mask as u32)^255) as u8;
    let db_len:i32=em_len-33;let db:[u8;512]=[0;512];let seed:[u8;36]=[0;36];i=0;
    while(i<32){seed[i]=encoded[start+db_len+i];i+=1;}
    let at:i32=0;let counter:u32=0;
    while(at<db_len){i=0;while(i<4){seed[32+i]=((counter>>(24-i*8))&255) as u8;i+=1;}
        let hash:core::sha256::Digest=core::sha256::digest(view(seed,36)).unwrap();let count:i32=db_len-at;if(count>32){count=32;}
        i=0;while(i<count){db[at+i]=encoded[start+at+i]^hash.bytes[i];i+=1;}at+=count;counter+=1;
    }
    db[0]&=mask;i=0;while(i<db_len-33){difference|=db[i];i+=1;}difference|=db[db_len-33]^1;
    let message:[u8;72]=[0;72];i=0;while(i<32){message[8+i]=byte(digest,i);message[40+i]=db[db_len-32+i];i+=1;}
    let expected:core::sha256::Digest=core::sha256::digest(view(message,72)).unwrap();i=0;
    while(i<32){difference|=expected.bytes[i]^seed[i];i+=1;}return difference==0;
}
pub impl PublicKey{
    pub fn borrow(&self)->&PublicKey{return self;}
    pub fn modulus_bits(&self)->i32{return self.bits;}
    pub fn signature_length(&self)->i32{return self.size;}
    pub fn exponent(&self)->u32{return self.public_exponent;}
    fn verify(&self,scheme:Scheme,digest:core::slice::View<u8>,signature:core::slice::View<u8>)->bool{
        let input:Number=zero();let i:i32=0;while(i<signature.length){let at:i32=signature.length-1-i;input.limbs[i/4]|=(byte(signature,at) as u64)<<((i%4)*8);i+=1;}
        if(!less(input,self.modulus,self.count)){return false;}
        let value:Number=recover(self,signature);let encoded:[u8;512]=[0;512];i=0;
        while(i<self.size){encoded[self.size-1-i]=(value.limbs[i/4]>>((i%4)*8)) as u8;i+=1;}
        if(pss(scheme)){return pss_encoded(encoded,self.size,self.bits,digest);}return pkcs_encoded(encoded,self.size,digest);
    }
    // All direct metadata precedes length/content reads. Keys are constructed
    // immutable state, inputs physically backed and disjoint from Budget/key.
    // Only Budget changes, including on cryptographic rejection; no output.
    pub fn verify_digest(&self,scheme:Scheme,digest:core::slice::View<u8>,signature:core::slice::View<u8>,b:&Budget)->core::result::Result<bool,Error>{
        if(!valid(digest)||!valid(signature)){return core::result::Err(Error::Bounds);}if(!budget_valid(b)){return core::result::Err(Error::InvalidLimits);}
        if(digest.length!=32){return core::result::Err(Error::InvalidDigestLength);}if(signature.length!=self.size){return core::result::Err(Error::InvalidSignatureLength);}
        if(!charge(b,verification_cost(self,pss(scheme)))){return core::result::Err(Error::WorkLimit);}return core::result::Ok(self.verify(scheme,digest,signature));
    }
    pub fn verify_sha256(&self,scheme:Scheme,message:core::slice::View<u8>,signature:core::slice::View<u8>,b:&Budget)->core::result::Result<bool,Error>{
        if(!valid(message)||!valid(signature)){return core::result::Err(Error::Bounds);}if(!budget_valid(b)){return core::result::Err(Error::InvalidLimits);}
        if(signature.length!=self.size){return core::result::Err(Error::InvalidSignatureLength);}if(message.length>b.message_limit){return core::result::Err(Error::InputLimit);}
        if(!charge(b,verification_cost(self,pss(scheme))+hash_cost(message.length as u64))){return core::result::Err(Error::WorkLimit);}
        let digest:core::sha256::Digest=core::sha256::digest(message).unwrap();return core::result::Ok(self.verify(scheme,view(digest.bytes,32),signature));
    }
}
fn take(reader:&ext::der::Reader,cause:Error)->core::result::Result<ext::der::Element,Error>{
    let next:core::result::Result<core::option::Option<ext::der::Element>,ext::der::Error> =reader.next();
    if(next.is_err()){return core::result::Err(cause);}let value:core::option::Option<ext::der::Element> =next.unwrap();
    if(value.is_none()){return core::result::Err(cause);}return core::result::Ok(value.unwrap());
}
fn sequence(input:core::slice::View<u8>,cause:Error)->core::result::Result<ext::der::Reader,Error>{
    let parsed:core::result::Result<ext::der::Element,ext::der::Error> =ext::der::parse_one(input);if(parsed.is_err()){return core::result::Err(cause);}
    let children:core::result::Result<ext::der::Reader,ext::der::Error> =parsed.unwrap().as_sequence();if(children.is_err()){return core::result::Err(cause);}return core::result::Ok(children.unwrap());
}
fn rsa_oid(element:ext::der::Element,last:u8)->bool{
    if(!element.tag.matches(ext::der::Class::Universal,false,6)||element.content.length!=9){return false;}
    let expected:[u8;9]=[42,134,72,134,247,13,1,1,0];let difference:u8=0;let i:i32=0;
    while(i<8){difference|=byte(element.content,i)^expected[i];i+=1;}return difference==0&&byte(element.content,8)==last;
}
fn null(element:ext::der::Element)->bool{return element.tag.matches(ext::der::Class::Universal,false,5)&&element.content.length==0;}
fn positive(element:ext::der::Element)->core::result::Result<core::slice::View<u8>,Error>{
    let parsed:core::result::Result<core::slice::View<u8>,ext::der::Error> =element.as_integer();if(parsed.is_err()){return core::result::Err(Error::InvalidKeyEncoding);}
    let value:core::slice::View<u8> =parsed.unwrap();if(byte(value,0)>=128){return core::result::Err(Error::InvalidKeyEncoding);}
    if(value.length>1&&byte(value,0)==0){return core::result::Ok(part(value,1,value.length-1));}return core::result::Ok(value);
}
pub fn parse_pkcs1_public_key(input:core::slice::View<u8>,b:&Budget)->core::result::Result<PublicKey,Error>{
    if(!valid(input)){return core::result::Err(Error::Bounds);}if(!budget_valid(b)){return core::result::Err(Error::InvalidLimits);}
    if(input.length>MAX_KEY_DER_BYTES){return core::result::Err(Error::InputLimit);}if(!charge(b,(input.length as u64)+128)){return core::result::Err(Error::WorkLimit);}
    let opened:core::result::Result<ext::der::Reader,Error> =sequence(input,Error::InvalidKeyEncoding);if(opened.is_err()){return core::result::Err(opened.unwrap_err());}let reader:ext::der::Reader=opened.unwrap();
    let n:core::result::Result<ext::der::Element,Error> =take(reader.borrow(),Error::InvalidKeyEncoding);if(n.is_err()){return core::result::Err(n.unwrap_err());}
    let e:core::result::Result<ext::der::Element,Error> =take(reader.borrow(),Error::InvalidKeyEncoding);if(e.is_err()||reader.remaining()!=0){return core::result::Err(Error::InvalidKeyEncoding);}
    let magnitude:core::result::Result<core::slice::View<u8>,Error> =positive(n.unwrap());if(magnitude.is_err()){return core::result::Err(magnitude.unwrap_err());}
    let exponent:core::result::Result<core::slice::View<u8>,Error> =positive(e.unwrap());if(exponent.is_err()){return core::result::Err(exponent.unwrap_err());}let bytes:core::slice::View<u8> =exponent.unwrap();
    if(bytes.length>4){return core::result::Err(Error::InvalidExponent);}let value:u32=0;let i:i32=0;while(i<bytes.length){value=(value<<8)|(byte(bytes,i) as u32);i+=1;}
    return from_components(magnitude.unwrap(),value,b);
}
pub fn parse_rsae_spki(input:core::slice::View<u8>,b:&Budget)->core::result::Result<PublicKey,Error>{
    if(!valid(input)){return core::result::Err(Error::Bounds);}if(!budget_valid(b)){return core::result::Err(Error::InvalidLimits);}
    if(input.length>MAX_KEY_DER_BYTES){return core::result::Err(Error::InputLimit);}if(!charge(b,(input.length as u64)+128)){return core::result::Err(Error::WorkLimit);}
    let opened:core::result::Result<ext::der::Reader,Error> =sequence(input,Error::InvalidKeyEncoding);if(opened.is_err()){return core::result::Err(opened.unwrap_err());}let reader:ext::der::Reader=opened.unwrap();
    let a:core::result::Result<ext::der::Element,Error> =take(reader.borrow(),Error::InvalidKeyEncoding);if(a.is_err()){return core::result::Err(a.unwrap_err());}
    let k:core::result::Result<ext::der::Element,Error> =take(reader.borrow(),Error::InvalidKeyEncoding);if(k.is_err()||reader.remaining()!=0){return core::result::Err(Error::InvalidKeyEncoding);}
    let alg:core::result::Result<ext::der::Reader,Error> =sequence(a.unwrap().encoded,Error::InvalidKeyEncoding);if(alg.is_err()){return core::result::Err(alg.unwrap_err());}let fields:ext::der::Reader=alg.unwrap();
    let oid:core::result::Result<ext::der::Element,Error> =take(fields.borrow(),Error::InvalidKeyEncoding);if(oid.is_err()){return core::result::Err(oid.unwrap_err());}
    if(!rsa_oid(oid.unwrap(),1)){return core::result::Err(Error::UnsupportedAlgorithm);}
    let params:core::result::Result<ext::der::Element,Error> =take(fields.borrow(),Error::InvalidParameters);if(params.is_err()||fields.remaining()!=0){return core::result::Err(Error::InvalidParameters);}if(!null(params.unwrap())){return core::result::Err(Error::InvalidParameters);}
    let bits:core::result::Result<ext::der::BitString,ext::der::Error> =k.unwrap().as_bit_string();if(bits.is_err()){return core::result::Err(Error::InvalidKeyEncoding);}let content:ext::der::BitString=bits.unwrap();
    if(content.unused_bits!=0){return core::result::Err(Error::InvalidKeyEncoding);}return parse_pkcs1_public_key(content.bytes,b);
}
fn sha256_algorithm(input:core::slice::View<u8>)->bool{
    let opened:core::result::Result<ext::der::Reader,Error> =sequence(input,Error::InvalidParameters);if(opened.is_err()){return false;}let reader:ext::der::Reader=opened.unwrap();
    let id:core::result::Result<ext::der::Element,Error> =take(reader.borrow(),Error::InvalidParameters);if(id.is_err()){return false;}let oid:ext::der::Element=id.unwrap();
    let expected:[u8;9]=[96,134,72,1,101,3,4,2,1];if(!oid.tag.matches(ext::der::Class::Universal,false,6)||oid.content.length!=9){return false;}
    let i:i32=0;while(i<9){if(byte(oid.content,i)!=expected[i]){return false;}i+=1;}
    if(reader.remaining()>0){let p:core::result::Result<ext::der::Element,Error> =take(reader.borrow(),Error::InvalidParameters);if(p.is_err()){return false;}if(!null(p.unwrap())){return false;}}
    return reader.remaining()==0;
}
fn mgf_sha256(input:core::slice::View<u8>)->bool{
    let opened:core::result::Result<ext::der::Reader,Error> =sequence(input,Error::InvalidParameters);if(opened.is_err()){return false;}let reader:ext::der::Reader=opened.unwrap();
    let id:core::result::Result<ext::der::Element,Error> =take(reader.borrow(),Error::InvalidParameters);if(id.is_err()){return false;}if(!rsa_oid(id.unwrap(),8)){return false;}
    let p:core::result::Result<ext::der::Element,Error> =take(reader.borrow(),Error::InvalidParameters);if(p.is_err()||reader.remaining()!=0){return false;}return sha256_algorithm(p.unwrap().encoded);
}
pub fn signature_scheme(input:core::slice::View<u8>,b:&Budget)->core::result::Result<Scheme,Error>{
    if(!valid(input)){return core::result::Err(Error::Bounds);}if(!budget_valid(b)){return core::result::Err(Error::InvalidLimits);}
    if(input.length>MAX_ALGORITHM_DER_BYTES){return core::result::Err(Error::InputLimit);}if(!charge(b,(input.length as u64)+128)){return core::result::Err(Error::WorkLimit);}
    let opened:core::result::Result<ext::der::Reader,Error> =sequence(input,Error::InvalidParameters);if(opened.is_err()){return core::result::Err(opened.unwrap_err());}let reader:ext::der::Reader=opened.unwrap();
    let id:core::result::Result<ext::der::Element,Error> =take(reader.borrow(),Error::InvalidParameters);if(id.is_err()){return core::result::Err(id.unwrap_err());}
    if(rsa_oid(id.unwrap(),11)){
        if(reader.remaining()>0){let p:core::result::Result<ext::der::Element,Error> =take(reader.borrow(),Error::InvalidParameters);if(p.is_err()){return core::result::Err(Error::InvalidParameters);}if(!null(p.unwrap())){return core::result::Err(Error::InvalidParameters);}}
        if(reader.remaining()!=0){return core::result::Err(Error::InvalidParameters);}return core::result::Ok(Scheme::Pkcs1v15Sha256);
    }
    if(!rsa_oid(id.unwrap(),10)){return core::result::Err(Error::UnsupportedAlgorithm);}
    let p:core::result::Result<ext::der::Element,Error> =take(reader.borrow(),Error::InvalidParameters);if(p.is_err()||reader.remaining()!=0){return core::result::Err(Error::InvalidParameters);}
    let params:core::result::Result<ext::der::Reader,Error> =sequence(p.unwrap().encoded,Error::InvalidParameters);if(params.is_err()){return core::result::Err(Error::InvalidParameters);}let fields:ext::der::Reader=params.unwrap();let which:i32=0;
    // SHA256,MGF1-SHA256,salt32 are nondefault and must be present in order.
    // Trailer1 is DEFAULT and DER must omit it. SHA1 defaults are unsupported.
    while(which<3){let next:core::result::Result<ext::der::Element,Error> =take(fields.borrow(),Error::InvalidParameters);if(next.is_err()){return core::result::Err(Error::InvalidParameters);}let field:ext::der::Element=next.unwrap();
        if(!field.tag.matches(ext::der::Class::Context,true,which as u32)){return core::result::Err(Error::InvalidParameters);}
        if(which==0&&!sha256_algorithm(field.content)){return core::result::Err(Error::InvalidParameters);}
        if(which==1&&!mgf_sha256(field.content)){return core::result::Err(Error::InvalidParameters);}
        if(which==2){let value:core::result::Result<ext::der::Element,ext::der::Error> =ext::der::parse_one(field.content);if(value.is_err()){return core::result::Err(Error::InvalidParameters);}let salt:core::result::Result<u64,ext::der::Error> =value.unwrap().as_u64();if(salt.is_err()){return core::result::Err(Error::InvalidParameters);}if(salt.unwrap()!=32){return core::result::Err(Error::InvalidParameters);}}
        which+=1;
    }
    if(fields.remaining()!=0){return core::result::Err(Error::InvalidParameters);}return core::result::Ok(Scheme::PssSha256Salt32);
}
