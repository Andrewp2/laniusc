// TLS1.3 suite identity and owned ordered policy, RFC8446 AppendixB.4.
// This module selects no connection, transcript or authenticated state.
module ext::tls_suite;
import core::result;
import core::slice;
import ext::tls_hash;

pub enum Suite { Aes128GcmSha256, Aes256GcmSha384, ChaCha20Poly1305Sha256 }
pub enum Error { Bounds, Unsupported, InvalidPolicy }
pub struct Policy { order:[Suite;3], length:i32 }

pub fn id(suite:Suite)->u16 { return match(suite) { Suite::Aes128GcmSha256->4865, Suite::Aes256GcmSha384->4866, Suite::ChaCha20Poly1305Sha256->4867 }; }
pub fn hash(suite:Suite)->ext::tls_hash::Algorithm { return match(suite) { Suite::Aes128GcmSha256->ext::tls_hash::Algorithm::Sha256, Suite::Aes256GcmSha384->ext::tls_hash::Algorithm::Sha384, Suite::ChaCha20Poly1305Sha256->ext::tls_hash::Algorithm::Sha256 }; }
pub fn key_length(suite:Suite)->i32 { if(id(suite)==4865) { return 16; } return 32; }
pub fn is_aes(suite:Suite)->bool { return id(suite)!=4867; }
pub fn from_id(value:u16)->core::result::Result<Suite,Error> {
    if(value==4865) { return core::result::Ok(Suite::Aes128GcmSha256); }
    if(value==4866) { return core::result::Ok(Suite::Aes256GcmSha384); }
    if(value==4867) { return core::result::Ok(Suite::ChaCha20Poly1305Sha256); }
    return core::result::Err(Error::Unsupported);
}
pub fn validate_policy(value:Policy)->core::result::Result<i32,Error> {
    if(value.length<1 || value.length>3) { return core::result::Err(Error::InvalidPolicy); }
    let i:i32=0;
    while(i<value.length) { let j:i32=0; while(j<i) { if(id(value.order[i])==id(value.order[j])) { return core::result::Err(Error::InvalidPolicy); } j+=1; } i+=1; }
    return core::result::Ok(value.length);
}
pub fn policy(ordered:core::slice::View<Suite>)->core::result::Result<Policy,Error> {
    if(ordered.start<0 || ordered.length<0 || ordered.start>2147483647-ordered.length) { return core::result::Err(Error::Bounds); }
    if(ordered.length<1 || ordered.length>3) { return core::result::Err(Error::InvalidPolicy); }
    let result:Policy=Policy { order:[Suite::ChaCha20Poly1305Sha256;3],length:ordered.length }; let i:i32=0;
    while(i<ordered.length) { result.order[i]=ordered.values[ordered.start+i]; i+=1; }
    let checked:core::result::Result<i32,Error> = validate_policy(result);
    if(checked.is_err()) { return core::result::Err(checked.unwrap_err()); }
    return core::result::Ok(result);
}
pub fn default_policy()->Policy { return Policy { order:[Suite::ChaCha20Poly1305Sha256,Suite::Aes128GcmSha256,Suite::Aes256GcmSha384],length:3 }; }
