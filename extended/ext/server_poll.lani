fn can_admit<D,E,F,H,A>(s: &Server<D,E,F,H,A>) -> bool {
    return s.accepting && s.report.stats.accepted < s.limits.max_accepted && s.report.stats.active < s.slots.len()
        && s.reservation.work <= s.limits.work-s.report.stats.work-s.report.stats.reserved_work
        && s.reservation.bytes <= s.limits.live_bytes-s.report.stats.reserved_bytes;
}
fn admission_limit<D,E,F,H,A>(s: &Server<D,E,F,H,A>) -> core::option::Option<Cause> {
    if (!s.accepting || s.report.stats.active > 0 || can_admit(s)) { return core::option::None(); }
    if (s.reservation.work > s.limits.work-s.report.stats.work-s.report.stats.reserved_work) { return core::option::Some(Cause::WorkLimit); }
