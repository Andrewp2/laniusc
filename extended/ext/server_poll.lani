                        self.requests.set(index+1,std::poll::Request { handle:handle.unwrap(),events:events }).unwrap(); self.bindings.set(index+1,Binding { id:slot.id,generation:slot.generation,handle:handle.unwrap() }).unwrap(); registered += 1;
