        index = 0;
        while (index < self.bindings.len()) {
            if (self.bindings.at(index).handle >= 0) {
                let flags: std::poll::Readiness = ready.values[ready.start+index];
                if (index == 0) { self.listener_ready = flags.readable() || flags.hangup() || flags.error() || flags.invalid(); }
                else { let slot: Slot<D> = take(self,index-1); slot.ready = ext::http_client::Readiness { readable:flags.readable() || flags.read_closed(),writable:flags.writable(),hangup:flags.hangup(),error:flags.error() || flags.invalid() }; put(self,index-1,slot); }
            }
            index += 1;
        }
        return core::result::Ok(true);
    }
    // Performs zero or one physical poll attempt using the public publication.
    pub fn poll_once(&self) -> core::result::Result<bool,Cause> where D: Driver<E>, F: Factory<D,E> {
        let prepared = self.prepare_wait(); if (prepared.is_err()) { return core::result::Err(prepared.unwrap_err()); }
        let waiting: PollInterest = prepared.unwrap(); if (waiting.complete || waiting.requests.length == 0) { return core::result::Ok(false); }
        let paid = spend(self,1); if (paid.is_err()) { return core::result::Err(fatal(self,paid.unwrap_err())); }
        self.report.stats.polls += 1; let polled = self.poller.poll_ms(waiting.requests,waiting.timeout_ms);
        let after = observe(self); if (after.is_err()) { return core::result::Err(fatal(self,after.unwrap_err())); }
        if (polled.is_err()) {
            invalidate(self); let error: std::poll::Error = polled.unwrap_err();
            if (match(error) { std::poll::Error::Io(value) -> core::io::is_interrupted(value), _ -> false }) { return core::result::Ok(true); }
            return core::result::Err(fatal(self,Cause::Poll(error)));
        }
        let resumed = self.resume(waiting.epoch,self.poller.as_view()); if (resumed.is_err()) { return core::result::Err(resumed.unwrap_err()); } return core::result::Ok(true);
    }
}
// The synchronous convenience runs exactly the same caller-driven owner.
// It transfers the report before releasing scheduler metadata; E/A need no
// Destroy bound until a caller chooses to dispose the resulting error owners.
pub fn serve_until<D,E,F,H,A>(listener: &std::socket::Socket, factory: &F, handler: &H, limits: ServerLimits, deadline: core::time::Deadline) -> core::result::Result<Report<E,A>,ServiceFailure<E,A>> where D: Driver<E>, F: Factory<D,E>, H: Handler<A> {
    let made: core::result::Result<Server<D,E,F,H,A>,Cause> = new<D,E,F,H,A>(listener,factory,handler,limits,deadline);
    if (made.is_err()) { return core::result::Err(ServiceFailure { cause:made.unwrap_err(),report:empty_report<E,A>() }); }
    let server: Server<D,E,F,H,A> = made.unwrap();
    while (!server.is_complete()) {
        let stepped = server.step(); if (stepped.is_err()) { break; }
        if (!server.is_complete()) { let polled = server.poll_once(); if (polled.is_err()) { if (server.last_failure().is_none()) { fatal(server.borrow(),polled.unwrap_err()); } break; } }
    }
    let failure: core::option::Option<Cause> = server.last_failure(); let report: Report<E,A> = server.take_report().unwrap();
    if (failure.is_some()) { return core::result::Err(ServiceFailure { cause:failure.unwrap(),report:report }); } return core::result::Ok(report);
}
