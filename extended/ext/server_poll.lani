    if (counted.is_err() || after.is_err()) { slot.owner = core::option::Some(driver); put(s,index,slot); if (counted.is_err()) { return counted; } return after; }
    if (driver.protocol().logical_bytes() > s.reservation.bytes) { slot.owner = core::option::Some(driver); put(s,index,slot); return core::result::Err(Cause::InvalidDriver); }
