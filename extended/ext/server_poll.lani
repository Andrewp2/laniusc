    return PollInterest { epoch:epoch,requests:s.requests.as_view().subview(0,length).unwrap(),timeout_ms:timeout,immediate:immediate,complete:complete };
}
fn milliseconds(duration: core::time::Duration) -> i32 { if (duration.seconds >= 2147484) { return 2147483647; } let value: u64 = duration.seconds*1000+((duration.nanos as u64)+999999)/1000000; if (value > 2147483647) { return 2147483647; } return value as i32; }
