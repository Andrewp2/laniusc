    pub fn stats(&self) -> Stats { return self.report.stats; }
    pub fn last_failure(&self) -> core::option::Option<Cause> { return self.failure; }
    pub fn is_complete(&self) -> bool { return !self.accepting && self.report.stats.active == 0; }
    pub fn is_accepting(&self) -> bool { return self.alive && self.accepting; }
    pub fn len(&self) -> i32 { return self.report.len(); }
    pub fn get(&self, index: i32) -> core::option::Option<Outcome<E,A>> { return self.report.get(index); }
    pub fn take(&self, index: i32) -> core::option::Option<Outcome<E,A>> {
