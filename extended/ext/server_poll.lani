    return match(error) { core::io::Error::WouldBlock -> true, core::io::Error::Host(code) -> code == 64 || code == 71 || code == 92 || code == 95 || code == 100 || code == 101 || code == 103 || code == 112 || code == 113, _ -> false };
}
fn accepted_info(id: i32, peer: core::option::Option<core::net::SocketAddr>) -> ConnectionInfo { return ConnectionInfo { id:id as u64,peer:peer,stats:blank_stats(),transport_calls:core::option::None(),rejection:core::option::None() }; }
fn count_accepted<D,E,F,H,A>(s: &Server<D,E,F,H,A>) { s.report.stats.accepted += 1; s.report.stats.active += 1; if (s.report.stats.active > s.report.stats.peak_active) { s.report.stats.peak_active = s.report.stats.active; } if (s.report.stats.accepted == s.limits.max_accepted) { s.accepting = false; } }
