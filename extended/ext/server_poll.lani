// Shared bounded server scheduling; HTTP policy belongs to http_server.
module ext::server_poll;
import alloc::vec;
import core::clone;
import core::io;
import core::net;
import core::option;
import core::result;
import core::slice;
import core::time;
import ext::http_client;
import ext::http_server;
import std::clock;
import std::poll;
import std::socket;

// Errors from step/before_wait and terminal events retire native transport.
// abort does so explicitly, retaining backing and readable diagnostic stats.
// destroy is called once on a terminal owner: no I/O, allocation or failure.
// A returned E transfers one cleanup authority, never a second owning cache.
pub trait Driver<E> {
    pub fn protocol(&self) -> &ext::http_server::Protocol;
    pub fn stats(&self) -> ext::http_server::Stats;
    pub fn transport_calls(&self) -> core::option::Option<u64>;
    pub fn rejection(&self) -> core::option::Option<ext::http_server::Rejection>;
    pub fn interest(&self) -> ext::http_client::Interest;
    pub fn raw_handle(&self) -> core::option::Option<i32>;
    pub fn before_wait(&self) -> core::result::Result<bool,E>;
    pub fn step(&self, ready: ext::http_client::Readiness) -> core::result::Result<core::option::Option<ext::http_server::Event>,E>;
    pub fn read_body(&self, decision: ext::http_server::BodyDecision) -> core::result::Result<bool,E>;
    pub fn abort(&self) -> core::result::Result<bool,E>;
    pub fn destroy(&self);
}
pub struct Reservation { work: u64, bytes: u64 }
// begin consumes accepted.socket on EVERY result. All construction errors
// release partial native and byte owners. Queries borrow E, never destroy it.
// reservation includes Protocol's response staging candidate before accepting.
// Connection Timeout is local; shared_failure promotes shared clock failures.
pub trait Factory<D,E> {
    pub fn reservation(&self) -> core::result::Result<Reservation,Cause>;
    pub fn begin(&self, accepted: std::socket::Accepted, deadline: core::time::Deadline) -> core::result::Result<D,E>;
    pub fn failure_stats(&self, error: E) -> ext::http_server::Stats;
    pub fn failure_transport_calls(&self, error: E) -> core::option::Option<u64>;
    pub fn shared_failure(&self, error: E) -> core::option::Option<Cause>;
}
pub enum Decision { Read(ext::http_server::BodyDecision), Responded, Abort }
pub trait Handler<A> {
    pub fn head(&self, id: u64, peer: core::net::SocketAddr, head: ext::http_server::RequestHead, reply: &Reply) -> core::result::Result<Decision,A>;
    pub fn request(&self, id: u64, request: ext::http_server::Request, reply: &Reply) -> core::result::Result<Decision,A>;
    pub fn rejected(&self, id: u64, rejection: ext::http_server::Rejection, reply: &Reply) -> core::result::Result<Decision,A>;
}
// This sink borrows the current Protocol only within its caller's lifetime.
// stage validates/copies handler-local response backing before returning.
pub struct Reply { owner: &ext::http_server::Protocol, staged: bool, failure: core::option::Option<ext::http_server::Failure> }
pub fn reply(protocol: &ext::http_server::Protocol) -> Reply { return Reply { owner: protocol, staged: false, failure: core::option::None() }; }
pub impl Reply {
    pub fn borrow(&self) -> &Reply { return self; }
    pub fn head(&self) -> core::option::Option<ext::http_server::RequestHead> { return self.owner.head(); }
    pub fn is_staged(&self) -> bool { return self.staged; }
    pub fn last_failure(&self) -> core::option::Option<ext::http_server::Failure> { return self.failure; }
    pub fn stage(&self, response: ext::http_server::Response) -> core::result::Result<bool,ext::http_server::Failure> {
        let result: core::result::Result<bool,ext::http_server::Failure> = self.owner.respond(response);
        if (result.is_err()) { self.failure = core::option::Some(result.unwrap_err()); }
        else { if (result.unwrap() && self.owner.final_staged()) { self.staged = true; self.failure = core::option::None(); } }
        return result;
    }
}
pub struct ServerLimits { max_accepted: i32, concurrency: i32, accept_calls: u64, polls: u64, operations: u64, handler_calls: u64, work: u64, live_bytes: u64, connection_timeout: core::time::Duration }
pub const MAX_ACCEPTED: i32 = 4096;
pub const MAX_CONCURRENCY: i32 = 64;
pub fn default_limits() -> ServerLimits { return ServerLimits { max_accepted: 64, concurrency: 4, accept_calls: 1048576, polls: 1048576, operations: 16777216, handler_calls: 192, work: 4294967296, live_bytes: 268435456, connection_timeout: core::time::from_secs(5) }; }
pub enum Cause { InvalidLimits, AllocationFailed, Io(core::io::Error), Clock(std::clock::Error), Timeout, AcceptLimit, PollLimit, OperationLimit, HandlerLimit, WorkLimit, ByteLimit, Poll(std::poll::Error), Protocol(ext::http_server::Cause), Time(core::time::Error), InvalidDriver, InvalidPublication, Inactive }
pub enum DecisionCause { WrongEvent, MissingResponse, UnexpectedResponse, ResponseFailure }
pub struct ConnectionInfo { id: u64, peer: core::option::Option<core::net::SocketAddr>, stats: ext::http_server::Stats, transport_calls: core::option::Option<u64>, rejection: core::option::Option<ext::http_server::Rejection> }
pub struct TransportFailure<E> { info: ConnectionInfo, error: E, cleanup: core::option::Option<E> }
pub struct ApplicationFailure<E,A> { info: ConnectionInfo, error: A, preparation: core::option::Option<ext::http_server::Failure>, cleanup: core::option::Option<E> }
pub struct DecisionFailure<E> { info: ConnectionInfo, cause: DecisionCause, preparation: core::option::Option<ext::http_server::Failure>, cleanup: core::option::Option<E> }
pub struct Abort<E> { info: ConnectionInfo, cleanup: core::option::Option<E> }
pub struct AcceptedFailure { info: ConnectionInfo, error: std::socket::AcceptFailure }
pub enum Outcome<E,A> { Pending(ConnectionInfo), Complete(ConnectionInfo), Empty(ConnectionInfo), Failed(TransportFailure<E>), HandlerFailed(ApplicationFailure<E,A>), InvalidDecision(DecisionFailure<E>), Aborted(Abort<E>), AcceptFailed(AcceptedFailure), Taken }
pub struct Stats { accepted: i32, active: i32, peak_active: i32, complete: i32, empty: i32, failed: i32, handler_failed: i32, invalid_decisions: i32, aborted: i32, accept_failures: i32, accept_calls: u64, waits: u64, polls: u64, operations: u64, handler_calls: u64, work: u64, reserved_work: u64, reserved_bytes: u64, peak_reserved_bytes: u64, io_calls: u64 }
pub fn empty_stats() -> Stats { return Stats { accepted: 0, active: 0, peak_active: 0, complete: 0, empty: 0, failed: 0, handler_failed: 0, invalid_decisions: 0, aborted: 0, accept_failures: 0, accept_calls: 0, waits: 0, polls: 0, operations: 0, handler_calls: 0, work: 0, reserved_work: 0, reserved_bytes: 0, peak_reserved_bytes: 0, io_calls: 0 }; }
// One active report owner. get borrows; take transfers/disarms. Error backing
// must outlive its final use/destruction, including outcomes taken after return.
pub struct Report<E,A> { outcomes: alloc::vec::Vec<Outcome<E,A>>, stats: Stats }
pub struct ServiceFailure<E,A> { cause: Cause, report: Report<E,A> }
pub fn empty_report<E,A>() -> Report<E,A> { return Report { outcomes: alloc::vec::new<Outcome<E,A>>(), stats: empty_stats() }; }
pub fn destroy_outcome<E,A>(owned: Outcome<E,A>) where E: core::clone::Destroy<E>, A: core::clone::Destroy<A> {
    let secondary: core::option::Option<E> = match(owned) { Outcome::Failed(value) -> value.cleanup, Outcome::HandlerFailed(value) -> value.cleanup, Outcome::InvalidDecision(value) -> value.cleanup, Outcome::Aborted(value) -> value.cleanup, _ -> core::option::None() };
    if (secondary.is_some()) { E::destroy_value(secondary.unwrap()); }
    let primary: core::option::Option<E> = match(owned) { Outcome::Failed(value) -> core::option::Some(value.error), _ -> core::option::None() };
    if (primary.is_some()) { E::destroy_value(primary.unwrap()); }
    let application: core::option::Option<A> = match(owned) { Outcome::HandlerFailed(value) -> core::option::Some(value.error), _ -> core::option::None() };
    if (application.is_some()) { A::destroy_value(application.unwrap()); }
}
pub impl<E,A> Report<E,A> {
    pub fn borrow(&self) -> &Report<E,A> { return self; }
    pub fn len(&self) -> i32 { return self.outcomes.len(); }
    pub fn get(&self, index: i32) -> core::option::Option<Outcome<E,A>> { return self.outcomes.get(index); }
    pub fn take(&self, index: i32) -> core::option::Option<Outcome<E,A>> {
        if (index < 0 || index >= self.outcomes.len()) { return core::option::None(); }
        let owned: Outcome<E,A> = self.outcomes.at(index);
        let taken: bool = match(owned) { Outcome::Taken -> true, _ -> false };
        if (taken) { return core::option::None(); }
        let empty: Outcome<E,A> = Outcome::Taken; self.outcomes.set(index,empty).unwrap(); return core::option::Some(owned);
    }
    pub fn destroy(&self) where E: core::clone::Destroy<E>, A: core::clone::Destroy<A> {
        let index: i32 = 0;
        while (index < self.outcomes.len()) { destroy_outcome<E,A>(self.outcomes.at(index)); index += 1; }
        self.outcomes.destroy();
    }
}
pub impl<E,A> ServiceFailure<E,A> { pub fn borrow(&self) -> &ServiceFailure<E,A> { return self; } pub fn destroy(&self) where E: core::clone::Destroy<E>, A: core::clone::Destroy<A> { self.report.destroy(); } }

pub struct PollInterest { epoch: u64, requests: core::slice::View<std::poll::Request>, timeout_ms: i32, immediate: bool, complete: bool }
struct Slot<D> { id: i32, generation: u64, peer: core::option::Option<core::net::SocketAddr>, deadline: core::time::Deadline, owner: core::option::Option<D>, event: core::option::Option<ext::http_server::Event>, credit: u64, reported_work: u64, reported_io: u64, transport: core::option::Option<u64>, counted: bool, ready: ext::http_client::Readiness }
impl<D> Slot<D> { fn borrow(&self) -> &Slot<D> { return self; } }
struct Binding { id: i32, generation: u64, handle: i32 }
pub struct Server<D,E,F,H,A> {
    listener: &std::socket::Socket, listener_handle: i32, factory: &F, handler: &H,
    limits: ServerLimits, reservation: Reservation, deadline: core::time::Deadline, last: core::time::Instant,
    report: Report<E,A>, slots: alloc::vec::Vec<Slot<D>>, requests: alloc::vec::Vec<std::poll::Request>, bindings: alloc::vec::Vec<Binding>, poller: std::poll::PollSet,
    turn: i32, accepting: bool, listener_ready: bool, alive: bool, transferred: bool, failure: core::option::Option<Cause>, epoch: u64, published: bool
}
fn no_ready() -> ext::http_client::Readiness { return ext::http_client::Readiness { readable:false,writable:false,hangup:false,error:false }; }
fn no_request() -> std::poll::Request { return std::poll::Request { handle:-1,events:0 }; }
fn no_binding() -> Binding { return Binding { id:-1,generation:0,handle:-1 }; }
fn blank_stats() -> ext::http_server::Stats { return ext::http_server::Stats { received:0,retained:0,decoded:0,buffered_discarded:0,drain_received:0,response_bytes:0,response_sent:0,continue_sent:0,io_calls:0,work:0,scan_work:0,cleanup_calls:0,cleanup_errors:0,write_shutdown:false,peer_eof:false,final_started:false,closed:false }; }
fn empty_slot<D>(deadline: core::time::Deadline) -> Slot<D> { return Slot { id:-1,generation:0,peer:core::option::None(),deadline:deadline,owner:core::option::None(),event:core::option::None(),credit:0,reported_work:0,reported_io:0,transport:core::option::None(),counted:false,ready:no_ready() }; }
fn invalidate<D,E,F,H,A>(s: &Server<D,E,F,H,A>) { s.published = false; if (s.epoch < 18446744073709551615) { s.epoch += 1; } }
fn spend<D,E,F,H,A>(s: &Server<D,E,F,H,A>, count: u64) -> core::result::Result<bool,Cause> { if (count > s.limits.operations-s.report.stats.operations) { return core::result::Err(Cause::OperationLimit); } s.report.stats.operations += count; return core::result::Ok(true); }
fn observe<D,E,F,H,A>(s: &Server<D,E,F,H,A>) -> core::result::Result<bool,Cause> {
    let paid = spend(s,1); if (paid.is_err()) { return paid; }
    let read = std::clock::monotonic_now(); if (read.is_err()) { return core::result::Err(Cause::Clock(read.unwrap_err())); }
    let now: core::time::Instant = read.unwrap(); if (now.compare(s.last) < 0) { return core::result::Err(Cause::Clock(std::clock::Error::ClockReversed)); }
    s.last = now; if (s.deadline.is_expired(now)) { return core::result::Err(Cause::Timeout); } return core::result::Ok(true);
}
fn put<D,E,F,H,A>(s: &Server<D,E,F,H,A>, index: i32, slot: Slot<D>) { s.slots.set(index,slot).unwrap(); }
fn take<D,E,F,H,A>(s: &Server<D,E,F,H,A>, index: i32) -> Slot<D> { return s.slots.set(index,empty_slot<D>(s.deadline)).unwrap(); }
fn outcome<D,E,F,H,A>(s: &Server<D,E,F,H,A>, id: i32, value: Outcome<E,A>) { s.report.outcomes.set(id,value).unwrap(); }
fn information<D,E>(slot: &Slot<D>, stats: ext::http_server::Stats, transport: core::option::Option<u64>, rejection: core::option::Option<ext::http_server::Rejection>) -> ConnectionInfo { return ConnectionInfo { id:slot.id as u64,peer:slot.peer,stats:stats,transport_calls:transport,rejection:rejection }; }
fn refresh<D,E,F,H,A>(s: &Server<D,E,F,H,A>, slot: &Slot<D>, driver: D) where D: Driver<E> { outcome(s,slot.id,Outcome::Pending(information<D,E>(slot,driver.stats(),driver.transport_calls(),driver.rejection()))); }
fn account<D,E,F,H,A>(s: &Server<D,E,F,H,A>, slot: &Slot<D>, stats: ext::http_server::Stats, transport: core::option::Option<u64>) -> core::result::Result<bool,Cause> {
    if (stats.work < slot.reported_work || stats.io_calls < slot.reported_io) { return core::result::Err(Cause::InvalidDriver); }
    if (slot.counted) {
        if (slot.transport.is_some() != transport.is_some()) { return core::result::Err(Cause::InvalidDriver); }
        if (transport.is_some() && transport.unwrap() < slot.transport.unwrap()) { return core::result::Err(Cause::InvalidDriver); }
    }
    let work: u64 = stats.work-slot.reported_work; let io: u64 = stats.io_calls-slot.reported_io;
    if (work > slot.credit || work > s.report.stats.reserved_work || work > s.limits.work-s.report.stats.work || io > 18446744073709551615-s.report.stats.io_calls) { return core::result::Err(Cause::InvalidDriver); }
    slot.credit -= work; s.report.stats.reserved_work -= work; s.report.stats.work += work; s.report.stats.io_calls += io;
    slot.reported_work = stats.work; slot.reported_io = stats.io_calls; slot.transport = transport; slot.counted = true; return core::result::Ok(true);
}
fn release<D,E,F,H,A>(s: &Server<D,E,F,H,A>, slot: &Slot<D>) { s.report.stats.reserved_work -= slot.credit; slot.credit = 0; s.report.stats.reserved_bytes -= s.reservation.bytes; s.report.stats.active -= 1; }
fn remember<D,E,F,H,A>(s: &Server<D,E,F,H,A>, cause: Cause) { if (s.failure.is_none()) { s.failure = core::option::Some(cause); } }
fn free_storage<D,E,F,H,A>(s: &Server<D,E,F,H,A>) { s.slots.destroy(); s.requests.destroy(); s.bindings.destroy(); s.poller.destroy(); s.alive = false; invalidate(s); }
fn abort_slots<D,E,F,H,A>(s: &Server<D,E,F,H,A>) where D: Driver<E> {
    let index: i32 = 0;
    while (index < s.slots.len()) {
        let slot: Slot<D> = take(s,index);
        if (slot.owner.is_some()) {
            let driver: D = slot.owner.unwrap(); let ended: core::result::Result<bool,E> = driver.abort();
            let counted = account(s,slot.borrow(),driver.stats(),driver.transport_calls()); if (counted.is_err()) { remember(s,counted.unwrap_err()); }
            let info: ConnectionInfo = information<D,E>(slot.borrow(),driver.stats(),driver.transport_calls(),driver.rejection());
            let cleanup: core::option::Option<E> = core::option::None(); if (ended.is_err()) { cleanup = core::option::Some(ended.unwrap_err()); }
            driver.destroy(); release(s,slot.borrow()); outcome(s,slot.id,Outcome::Aborted(Abort { info:info,cleanup:cleanup })); s.report.stats.aborted += 1;
        }
        index += 1;
    }
}
fn fatal<D,E,F,H,A>(s: &Server<D,E,F,H,A>, cause: Cause) -> Cause where D: Driver<E> { remember(s,cause); s.accepting = false; invalidate(s); abort_slots(s); return s.failure.unwrap(); }
fn terminal<D,E,F,H,A>(s: &Server<D,E,F,H,A>, slot: &Slot<D>, driver: D, error: E, cleanup: core::option::Option<E>) -> core::result::Result<bool,Cause> where D: Driver<E>, F: Factory<D,E> {
    let info: ConnectionInfo = information<D,E>(slot,driver.stats(),driver.transport_calls(),driver.rejection());
    driver.destroy(); release(s,slot); outcome(s,slot.id,Outcome::Failed(TransportFailure { info:info,error:error,cleanup:cleanup })); s.report.stats.failed += 1;
    let shared: core::option::Option<Cause> = s.factory.shared_failure(error); if (shared.is_some()) { return core::result::Err(shared.unwrap()); } return core::result::Ok(true);
}
fn preparation_clock(value: core::option::Option<ext::http_server::Failure>) -> core::option::Option<Cause> { if (value.is_none()) { return core::option::None(); } return match(value.unwrap().cause) { ext::http_server::Cause::Clock(error) -> core::option::Some(Cause::Clock(error)), _ -> core::option::None() }; }
fn application<D,E,F,H,A>(s: &Server<D,E,F,H,A>, slot: &Slot<D>, driver: D, event: ext::http_server::Event) -> core::result::Result<bool,Cause> where D: Driver<E>, F: Factory<D,E>, H: Handler<A> {
    // Check the connection deadline while its latched decision is paused.
    let paid = spend(s,1); if (paid.is_err()) { slot.owner = core::option::Some(driver); return paid; }
    let gate: core::result::Result<bool,E> = driver.before_wait(); let counted = account(s,slot,driver.stats(),driver.transport_calls()); let gated = observe(s);
    if (gate.is_err()) { let recorded = terminal(s,slot,driver,gate.unwrap_err(),core::option::None()); if (counted.is_err()) { return counted; } if (gated.is_err()) { return gated; } return recorded; }
    if (counted.is_err()) { slot.owner = core::option::Some(driver); return counted; }
    if (gated.is_err()) { slot.owner = core::option::Some(driver); return gated; }
    if (gate.unwrap()) { slot.owner = core::option::Some(driver); return core::result::Err(Cause::InvalidDriver); }
    if (s.report.stats.handler_calls == s.limits.handler_calls) { slot.owner = core::option::Some(driver); return core::result::Err(Cause::HandlerLimit); }
    let charged = spend(s,1); if (charged.is_err()) { slot.owner = core::option::Some(driver); return charged; } s.report.stats.handler_calls += 1;
    let sink: Reply = reply(driver.protocol());
    let selected: core::result::Result<Decision,A> = match(event) {
        ext::http_server::Event::Head(head) -> s.handler.head(slot.id as u64,slot.peer.unwrap(),head,sink.borrow()),
        ext::http_server::Event::Request(request) -> s.handler.request(slot.id as u64,request,sink.borrow()),
        ext::http_server::Event::Rejected(rejection) -> s.handler.rejected(slot.id as u64,rejection,sink.borrow()),
        _ -> core::result::Ok(Decision::Abort)
    };
    let counted = account(s,slot,driver.stats(),driver.transport_calls());
    let after = observe(s);
    if (selected.is_err()) {
        let error: A = selected.unwrap_err(); let ended = driver.abort(); let bill = account(s,slot,driver.stats(),driver.transport_calls());
        let info = information<D,E>(slot,driver.stats(),driver.transport_calls(),driver.rejection()); let cleanup: core::option::Option<E> = core::option::None(); if (ended.is_err()) { cleanup = core::option::Some(ended.unwrap_err()); }
        driver.destroy(); release(s,slot); outcome(s,slot.id,Outcome::HandlerFailed(ApplicationFailure { info:info,error:error,preparation:sink.last_failure(),cleanup:cleanup })); s.report.stats.handler_failed += 1;
        if (counted.is_err()) { return counted; } if (bill.is_err()) { return bill; } if (after.is_err()) { return after; }
        let shared = preparation_clock(sink.last_failure()); if (shared.is_some()) { return core::result::Err(shared.unwrap()); } return core::result::Ok(true);
    }
    if (counted.is_err()) { slot.owner = core::option::Some(driver); return counted; }
    let decision: Decision = selected.unwrap(); let stop: bool = match(decision) { Decision::Abort -> true, _ -> false };
    if (stop) {
        let ended = driver.abort(); let bill = account(s,slot,driver.stats(),driver.transport_calls()); let info = information<D,E>(slot,driver.stats(),driver.transport_calls(),driver.rejection());
        let cleanup: core::option::Option<E> = core::option::None(); if (ended.is_err()) { cleanup = core::option::Some(ended.unwrap_err()); }
        driver.destroy(); release(s,slot); outcome(s,slot.id,Outcome::Aborted(Abort { info:info,cleanup:cleanup })); s.report.stats.aborted += 1;
        if (bill.is_err()) { return bill; } if (after.is_err()) { return after; } let shared = preparation_clock(sink.last_failure()); if (shared.is_some()) { return core::result::Err(shared.unwrap()); } return core::result::Ok(true);
    }
    let read: core::option::Option<ext::http_server::BodyDecision> = match(decision) { Decision::Read(value) -> core::option::Some(value), _ -> core::option::None() };
    let head: bool = match(event) { ext::http_server::Event::Head(value) -> true, _ -> false };
    let invalid: core::option::Option<DecisionCause> = core::option::None();
    if (read.is_some()) { if (!head) { invalid = core::option::Some(DecisionCause::WrongEvent); } else { if (sink.is_staged() || driver.protocol().final_staged()) { invalid = core::option::Some(DecisionCause::UnexpectedResponse); } } }
    else { if (!sink.is_staged() || !driver.protocol().final_staged()) { invalid = core::option::Some(DecisionCause::MissingResponse); } }
    if (sink.last_failure().is_some() && match(driver.protocol().status()) { ext::http_server::Status::Failed -> true, _ -> false }) { invalid = core::option::Some(DecisionCause::ResponseFailure); }
    if (invalid.is_some()) {
        let ended = driver.abort(); let bill = account(s,slot,driver.stats(),driver.transport_calls()); let info = information<D,E>(slot,driver.stats(),driver.transport_calls(),driver.rejection());
        let cleanup: core::option::Option<E> = core::option::None(); if (ended.is_err()) { cleanup = core::option::Some(ended.unwrap_err()); }
        driver.destroy(); release(s,slot); outcome(s,slot.id,Outcome::InvalidDecision(DecisionFailure { info:info,cause:invalid.unwrap(),preparation:sink.last_failure(),cleanup:cleanup })); s.report.stats.invalid_decisions += 1;
        if (bill.is_err()) { return bill; } if (after.is_err()) { return after; } let shared = preparation_clock(sink.last_failure()); if (shared.is_some()) { return core::result::Err(shared.unwrap()); } return core::result::Ok(true);
    }
    if (after.is_err()) { slot.owner = core::option::Some(driver); return after; }
    if (read.is_some()) {
        let command: core::result::Result<bool,E> = driver.read_body(read.unwrap()); let bill = account(s,slot,driver.stats(),driver.transport_calls()); let commanded = observe(s);
        if (command.is_err()) { let error: E = command.unwrap_err(); let ended = driver.abort(); let cleanup: core::option::Option<E> = core::option::None(); if (ended.is_err()) { cleanup = core::option::Some(ended.unwrap_err()); } let final_bill = account(s,slot,driver.stats(),driver.transport_calls()); let recorded = terminal(s,slot,driver,error,cleanup); if (bill.is_err()) { return bill; } if (final_bill.is_err()) { return final_bill; } if (commanded.is_err()) { return commanded; } return recorded; }
        if (bill.is_err()) { slot.owner = core::option::Some(driver); return bill; }
        if (commanded.is_err()) { slot.owner = core::option::Some(driver); return commanded; }
    }
    slot.event = core::option::None(); refresh(s,slot,driver); slot.owner = core::option::Some(driver); return core::result::Ok(true);
}
fn advance<D,E,F,H,A>(s: &Server<D,E,F,H,A>, index: i32) -> core::result::Result<bool,Cause> where D: Driver<E>, F: Factory<D,E>, H: Handler<A> {
    let slot: Slot<D> = take(s,index); if (slot.owner.is_none()) { return core::result::Ok(false); }
    let driver: D = slot.owner.unwrap(); slot.owner = core::option::None();
    if (slot.event.is_some()) { let progressed = application(s,slot.borrow(),driver,slot.event.unwrap()); if (slot.owner.is_some()) { put(s,index,slot); } return progressed; }
