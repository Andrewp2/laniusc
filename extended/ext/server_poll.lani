    let paid = spend(s,1); if (paid.is_err()) { slot.owner = core::option::Some(driver); put(s,index,slot); return paid; }
    let result: core::result::Result<core::option::Option<ext::http_server::Event>,E> = driver.step(ready);
    let counted = account(s,slot.borrow(),driver.stats(),driver.transport_calls()); let after = observe(s);
