// The mini compiler in Lanius. formal/tools/extract.py turns everything after
// the prelude into the Lean definitions in formal/Lanius/Mini/Compiler.lean,
// which the proofs in formal/Lanius/Mini/ are about.
//
// The code is pure: values are never mutated, recursion replaces loops, and
// lists are the prelude's cons list. Arithmetic on usize goes through
// plus/minus/times, which panic instead of wrapping, so a run that returns
// computed exactly what the Lean definitions compute over Nat.
module mini::compiler;
import alloc::allocator;
import core::mem;
import core::option;
import core::panic;

// extract: prelude begin
// Each prelude item has a fixed Lean meaning (see PRELUDE in extract.py).
// They are the only code that touches memory.

// Box<T> is T.
pub struct Box<T> { storage: ptr }

pub fn boxed<T>(value: T) -> Box<T> {
    let size: usize = core::mem::size_of<T>();
    let storage: ptr = alloc::allocator::alloc(size, 8);
    if (storage == 0) {
        core::panic::panic();
    }
    let slot: [T] = core::mem::typed_slice_from_storage(storage, 1);
    slot[0] = value;
    return Box { storage: storage };
}

pub fn unbox<T>(value: Box<T>) -> T {
    let slot: [T] = core::mem::typed_slice_from_storage(value.storage, 1);
    return slot[0];
}

// List<T> is List T: Nil is [] and Cons(x, rest) is x :: rest.
pub enum List<T> { Nil, Cons(T, Box<List<T>>), }

// Nat a + b
pub fn plus(a: usize, b: usize) -> usize {
    let sum: usize = a + b;
    if (a > sum) {
        core::panic::panic();
    }
    return sum;
}

// Nat a * b
pub fn times(a: usize, b: usize) -> usize {
    if (a == 0) {
        return 0;
    }
    let product: usize = a * b;
    if (product / a != b) {
        core::panic::panic();
    }
    return product;
}

// Nat a - b, used only where a >= b
pub fn minus(a: usize, b: usize) -> usize {
    if (b > a) {
        core::panic::panic();
    }
    return a - b;
}

// max a b
pub fn max_of(a: usize, b: usize) -> usize {
    if (b > a) {
        return b;
    }
    return a;
}
// extract: prelude end

// List operations. Each one is extracted as Lists.<name>, together with a
// theorem that it equals its Lean list function; calls elsewhere are written
// as that function (see SPEC_FNS in extract.py).

// []
pub fn empty<T>() -> List<T> {
    return Nil;
}

// [item]
pub fn single<T>(item: T) -> List<T> {
    return Cons(item, boxed(Nil));
}

// item :: rest
pub fn cons<T>(item: T, rest: List<T>) -> List<T> {
    return Cons(item, boxed(rest));
}

// first ++ second
pub fn concat<T>(first: List<T>, second: List<T>) -> List<T> {
    return match (first) {
        Nil -> second,
        Cons(item, rest) -> Cons(item, boxed(concat(unbox(rest), second))),
    };
}

// items.length
pub fn length<T>(items: List<T>) -> usize {
    return match (items) {
        Nil -> 0,
        Cons(item, rest) -> plus(length(unbox(rest)), 1),
    };
}

// items[index]?
pub fn get<T>(items: List<T>, index: usize) -> core::option::Option<T> {
    if (index == 0) {
        return match (items) {
            Nil -> None,
            Cons(item, rest) -> Some(item),
        };
    }
    return match (items) {
        Nil -> None,
        Cons(item, rest) -> get(unbox(rest), minus(index, 1)),
    };
}

// items.getD index fallback
pub fn get_or<T>(items: List<T>, index: usize, fallback: T) -> T {
    if (index == 0) {
        return match (items) {
            Nil -> fallback,
            Cons(item, rest) -> item,
        };
    }
    return match (items) {
        Nil -> fallback,
        Cons(item, rest) -> get_or(unbox(rest), minus(index, 1), fallback),
    };
}

// Source language: i32 code with comparisons, if, while, and functions with
// parameters and direct calls. Locals are frame indices; a function's
// parameters are its first locals. Comparisons produce 1 or 0, and
// conditions test for nonzero. Calls are statements (target = callee(args)).

pub enum BinOp { Add, Sub, Mul, And, Or, Xor, }

// Signed comparisons.
pub enum CmpOp { Eq, Ne, Lt, Le, Gt, Ge, }

pub enum Expr {
    Lit(i32),
    Var(usize),
    Neg(Box<Expr>),
    Binary(BinOp, Box<Expr>, Box<Expr>),
    Compare(CmpOp, Box<Expr>, Box<Expr>),
}

pub enum Stmt {
    Skip,
    Assign(usize, Expr),
    Seq(Box<Stmt>, Box<Stmt>),
    Ite(Expr, Box<Stmt>, Box<Stmt>),
    // while condition { body }
    Loop(Expr, Box<Stmt>),
    // target = callee(args)
    Call(usize, usize, List<Expr>),
    Ret(Expr),
}

pub struct Func {
    params: usize,
    // All locals, parameters included.
    locals: usize,
    body: Stmt,
}

pub struct Program {
    funcs: List<Func>,
}

// The abstract target: an accumulator (eax), frame slots, and a program
// counter that is a byte offset into the function's code. Each instruction is
// one fixed byte sequence, Instr::size bytes long.
pub enum Instr {
    // mov eax, imm32
    Imm(i32),
    // mov eax, [rbp - 8 * (slot + 1)]
    Load(usize),
    // mov [rbp - 8 * (slot + 1)], eax
    Store(usize),
    // neg eax
    Neg,
    // eax := slot op eax
    Op(BinOp, usize),
    // eax := (slot cmp eax) ? 1 : 0
    Cmp(CmpOp, usize),
    // jmp rel32
    Jmp(usize),
    // test eax, eax; jz rel32
    Jz(usize),
    // Copy the argument slots into the callee's parameter slots, then call rel32.
    Call(usize, List<usize>),
    // frame epilogue and ret, returning eax
    Ret,
}

impl BinOp {
    // imul is one byte longer than the other operators.
    pub fn size(self) -> usize {
        return match (self) {
            Add -> 10,
            Sub -> 10,
            Mul -> 11,
            And -> 10,
            Or -> 10,
            Xor -> 10,
        };
    }
}

impl Instr {
    pub fn size(self) -> usize {
        return match (self) {
            Imm(value) -> 5,
            Load(slot) -> 6,
            Store(slot) -> 6,
            Instr::Neg -> 2,
            Op(operation, slot) -> operation.size(),
            Cmp(operation, slot) -> 16,
            Jmp(target) -> 5,
            Jz(target) -> 8,
            Instr::Call(callee, args) -> plus(times(12, length(args)), 5),
            Instr::Ret -> 5,
        };
    }
}

pub fn code_size(code: List<Instr>) -> usize {
    return match (code) {
        Nil -> 0,
        Cons(i, rest) -> plus(i.size(), code_size(unbox(rest))),
    };
}

// Expressions leave their value in the accumulator. A binary operator's left
// operand waits in temporary slot base + depth, above the base local slots,
// while the right operand is computed one level deeper.
pub fn compile_expr(base: usize, e: Expr, depth: usize) -> List<Instr> {
    return match (e) {
        Lit(value) -> single(Imm(value)),
        Var(index) -> single(Load(index)),
        Expr::Neg(operand) -> concat(compile_expr(base, unbox(operand), depth), single(Instr::Neg)),
        Binary(operation, left, right) -> concat(concat(concat(compile_expr(base, unbox(left), depth), single(Store(plus(base, depth)))), compile_expr(base, unbox(right), plus(depth, 1))), single(Op(operation, plus(base, depth)))),
        Compare(operation, left, right) -> concat(concat(concat(compile_expr(base, unbox(left), depth), single(Store(plus(base, depth)))), compile_expr(base, unbox(right), plus(depth, 1))), single(Cmp(operation, plus(base, depth)))),
    };
}

// Argument k is evaluated into temporary base + k.
pub fn compile_args(base: usize, args: List<Expr>, k: usize) -> List<Instr> {
    return match (args) {
        Nil -> empty(),
        Cons(arg, rest) -> concat(concat(compile_expr(base, arg, plus(k, 1)), single(Store(plus(base, k)))), compile_args(base, unbox(rest), plus(k, 1))),
    };
}

pub fn arg_slots(base: usize, args: List<Expr>, k: usize) -> List<usize> {
    return match (args) {
        Nil -> empty(),
        Cons(arg, rest) -> cons(plus(base, k), arg_slots(base, unbox(rest), plus(k, 1))),
    };
}

// Statement code is placed at offset pos, so jumps are absolute offsets
// within the function.
pub fn compile_stmt(base: usize, pos: usize, s: Stmt) -> List<Instr> {
    return match (s) {
        Skip -> empty(),
        Assign(index, value) -> concat(compile_expr(base, value, 0), single(Store(index))),
        Seq(first, second) -> seq_code(base, pos, compile_stmt(base, pos, unbox(first)), unbox(second)),
        Ite(condition, then_branch, else_branch) -> ite_code(base, pos, compile_expr(base, condition, 0), unbox(then_branch), unbox(else_branch)),
        Loop(condition, body) -> loop_code(base, pos, compile_expr(base, condition, 0), unbox(body)),
        Stmt::Call(target, callee, args) -> concat(compile_args(base, args, 0), cons(Instr::Call(callee, arg_slots(base, args, 0)), single(Store(target)))),
        Stmt::Ret(value) -> concat(compile_expr(base, value, 0), single(Instr::Ret)),
    };
}

// extract: inline
fn seq_code(base: usize, pos: usize, first_code: List<Instr>, second: Stmt) -> List<Instr> {
    return concat(first_code, compile_stmt(base, plus(pos, code_size(first_code)), second));
}

// extract: inline
fn ite_code(base: usize, pos: usize, condition_code: List<Instr>, then_branch: Stmt, else_branch: Stmt) -> List<Instr> {
    let then_start: usize = plus(plus(pos, code_size(condition_code)), 8);
    let then_code: List<Instr> = compile_stmt(base, then_start, then_branch);
    let else_start: usize = plus(plus(then_start, code_size(then_code)), 5);
    let else_code: List<Instr> = compile_stmt(base, else_start, else_branch);
    return concat(concat(concat(concat(condition_code, single(Jz(else_start))), then_code), single(Jmp(plus(else_start, code_size(else_code))))), else_code);
}

// extract: inline
fn loop_code(base: usize, pos: usize, condition_code: List<Instr>, body: Stmt) -> List<Instr> {
    let body_start: usize = plus(plus(pos, code_size(condition_code)), 8);
    let body_code: List<Instr> = compile_stmt(base, body_start, body);
    return concat(concat(concat(condition_code, single(Jz(plus(plus(body_start, code_size(body_code)), 5)))), body_code), single(Jmp(pos)));
}

// Every local an expression reads is below locals.
impl Expr {
    pub fn within(self, locals: usize) -> bool {
        return match (self) {
            Lit(value) -> true,
            Var(index) -> locals > index,
            Expr::Neg(operand) -> unbox(operand).within(locals),
            Binary(operation, left, right) -> unbox(left).within(locals) && unbox(right).within(locals),
            Compare(operation, left, right) -> unbox(left).within(locals) && unbox(right).within(locals),
        };
    }

    // Temporary slots an expression's code uses.
    pub fn temps(self) -> usize {
        return match (self) {
            Lit(value) -> 0,
            Var(index) -> 0,
            Expr::Neg(operand) -> unbox(operand).temps(),
            Binary(operation, left, right) -> max_of(unbox(left).temps(), plus(unbox(right).temps(), 1)),
            Compare(operation, left, right) -> max_of(unbox(left).temps(), plus(unbox(right).temps(), 1)),
        };
    }
}

pub fn all_within(locals: usize, args: List<Expr>) -> bool {
    return match (args) {
        Nil -> true,
        Cons(arg, rest) -> arg.within(locals) && all_within(locals, unbox(rest)),
    };
}

pub fn arity_is(arities: List<usize>, callee: usize, count: usize) -> bool {
    return match (get(arities, callee)) {
        Some(arity) -> arity == count,
        None -> false,
    };
}

// Temporaries used by arguments from position k on.
pub fn args_temps(args: List<Expr>, k: usize) -> usize {
    return match (args) {
        Nil -> 0,
        Cons(arg, rest) -> max_of(plus(plus(k, 1), arg.temps()), args_temps(unbox(rest), plus(k, 1))),
    };
}

impl Stmt {
    // Locals are in range, and each call names a function and passes it as
    // many arguments as it has parameters.
    pub fn within(self, locals: usize, arities: List<usize>) -> bool {
        return match (self) {
            Skip -> true,
            Assign(index, value) -> locals > index && value.within(locals),
            Seq(first, second) -> unbox(first).within(locals, arities) && unbox(second).within(locals, arities),
            Ite(condition, then_branch, else_branch) -> condition.within(locals) && unbox(then_branch).within(locals, arities) && unbox(else_branch).within(locals, arities),
            Loop(condition, body) -> condition.within(locals) && unbox(body).within(locals, arities),
            Stmt::Call(target, callee, args) -> locals > target && arity_is(arities, callee, length(args)) && all_within(locals, args),
            Stmt::Ret(value) -> value.within(locals),
        };
    }

    pub fn temps(self) -> usize {
        return match (self) {
            Skip -> 0,
            Assign(index, value) -> value.temps(),
            Seq(first, second) -> max_of(unbox(first).temps(), unbox(second).temps()),
            Ite(condition, then_branch, else_branch) -> max_of(condition.temps(), max_of(unbox(then_branch).temps(), unbox(else_branch).temps())),
            Loop(condition, body) -> max_of(condition.temps(), unbox(body).temps()),
            Stmt::Call(target, callee, args) -> args_temps(args, 0),
            Stmt::Ret(value) -> value.temps(),
        };
    }
}

// Zero the non-parameter locals first, ..., first + count - 1.
pub fn zero_locals(first: usize, count: usize) -> List<Instr> {
    if (count == 0) {
        return empty();
    }
    return cons(Store(first), zero_locals(plus(first, 1), minus(count, 1)));
}

// Frames are bounded so every slot displacement fits a signed 32-bit field.
pub fn frame_limit() -> usize {
    return 1048576;
}

pub struct Code {
    // Frame slots: the locals, then the deepest statement's temporaries.
    slots: usize,
    instrs: List<Instr>,
}

pub fn compile_func(arities: List<usize>, func: Func) -> core::option::Option<Code> {
    let slots: usize = plus(func.locals, func.body.temps());
    if (func.locals >= func.params && func.body.within(func.locals, arities) && frame_limit() >= slots) {
        let init: List<Instr> = cons(Imm(0), zero_locals(func.params, minus(func.locals, func.params)));
        return Some(Code { slots: slots, instrs: concat(init, compile_stmt(func.locals, code_size(init), func.body)) });
    }
    return None;
}

pub fn arities(funcs: List<Func>) -> List<usize> {
    return match (funcs) {
        Nil -> empty(),
        Cons(func, rest) -> cons(func.params, arities(unbox(rest))),
    };
}

pub fn compile_funcs(arities: List<usize>, funcs: List<Func>) -> core::option::Option<List<Code>> {
    return match (funcs) {
        Nil -> Some(empty()),
        Cons(func, rest) -> match (compile_func(arities, func)) {
            None -> None,
            Some(code) -> match (compile_funcs(arities, unbox(rest))) {
                None -> None,
                Some(codes) -> Some(cons(code, codes)),
            },
        },
    };
}

// Assembly. Jumps are relative to the end of the instruction. A call copies
// its arguments to just below the return address it pushes, which is where
// the callee's prologue puts its parameter slots.

// Little-endian bytes of a 32-bit field.
pub fn le32(value: i32) -> List<u8> {
    let bits: u32 = value as u32;
    return cons(bits as u8, cons((bits >> 8) as u8, cons((bits >> 16) as u8, single((bits >> 24) as u8))));
}

// rbp-relative displacement of a frame slot.
pub fn slot_offset(slot: usize) -> i32 {
    return 0 - (times(plus(slot, 1), 8) as i32);
}

// mov eax, [rbp + disp32]
pub fn slot_load(slot: usize) -> List<u8> {
    return concat(cons(139, single(133)), le32(slot_offset(slot)));
}

// mov [rbp + disp32], eax
pub fn slot_store(slot: usize) -> List<u8> {
    return concat(cons(137, single(133)), le32(slot_offset(slot)));
}

// mov ecx, eax; mov eax, [slot]
pub fn slot_operands(slot: usize) -> List<u8> {
    return concat(cons(137, single(193)), slot_load(slot));
}

impl BinOp {
    // slot_operands, then op eax, ecx
    pub fn bytes(self, slot: usize) -> List<u8> {
        return match (self) {
            Add -> concat(slot_operands(slot), cons(1, single(200))),
            Sub -> concat(slot_operands(slot), cons(41, single(200))),
            Mul -> concat(slot_operands(slot), cons(15, cons(175, single(193)))),
            And -> concat(slot_operands(slot), cons(33, single(200))),
            Or -> concat(slot_operands(slot), cons(9, single(200))),
            Xor -> concat(slot_operands(slot), cons(49, single(200))),
        };
    }
}

impl CmpOp {
    // The setcc opcode byte whose condition holds after cmp left, right
    // exactly when the comparison does.
    pub fn setcc(self) -> u8 {
        return match (self) {
            Eq -> 148,
            Ne -> 149,
            Lt -> 156,
            Le -> 158,
            Gt -> 159,
            Ge -> 157,
        };
    }
}

// slot_operands; cmp eax, ecx; setcc al; movzx eax, al
pub fn slot_compare(operation: CmpOp, slot: usize) -> List<u8> {
    return concat(concat(slot_operands(slot), cons(57, single(200))), cons(15, cons(operation.setcc(), cons(192, cons(15, cons(182, single(192)))))));
}

// mov rsp, rbp; pop rbp; ret
pub fn epilogue() -> List<u8> {
    return cons(72, cons(137, cons(236, cons(93, single(195)))));
}

// Frame bytes below rbp, a multiple of 16.
pub fn frame_size(slots: usize) -> usize {
    return times(plus(slots, 1) / 2, 16);
}

// push rbp; mov rbp, rsp; mov r11d, frame_size; sub rsp, r11
pub fn prologue(slots: usize) -> List<u8> {
    return concat(concat(cons(85, cons(72, cons(137, cons(229, cons(65, single(187)))))), le32(frame_size(slots) as i32)), cons(76, cons(41, single(220))));
}

// The rel32 field of a transfer from the end of an instruction at source to target.
pub fn relative(source: usize, target: usize) -> i32 {
    return (target as i32) - (source as i32);
}

// Where a function's code sits in the program image.
pub struct Place {
    // Image offset of the body's first instruction.
    body: usize,
    // The function's frame slots.
    slots: usize,
    // Image offset of every function's entry.
    entries: List<usize>,
}

// The caller's virtual slot that is the callee's parameter 0: the slot just
// below the return address the call pushes.
pub fn arg_base(slots: usize) -> usize {
    return plus(frame_size(slots) / 8, 2);
}

// Copy argument slots args to virtual slots first + k, first + k + 1, ...
pub fn copy_bytes(first: usize, args: List<usize>, k: usize) -> List<u8> {
    return match (args) {
        Nil -> empty(),
        Cons(slot, rest) -> concat(concat(slot_load(slot), slot_store(plus(first, k))), copy_bytes(first, unbox(rest), plus(k, 1))),
    };
}

impl Instr {
    // The bytes of the instruction at body offset pc.
    pub fn encode(self, place: Place, pc: usize) -> List<u8> {
        return match (self) {
            Imm(value) -> cons(184, le32(value)),
            Load(slot) -> slot_load(slot),
            Store(slot) -> slot_store(slot),
            Instr::Neg -> cons(247, single(216)),
            Op(operation, slot) -> operation.bytes(slot),
            Cmp(operation, slot) -> slot_compare(operation, slot),
            Jmp(target) -> cons(233, le32(relative(plus(pc, 5), target))),
            Jz(target) -> concat(cons(133, cons(192, cons(15, single(132)))), le32(relative(plus(pc, 8), target))),
            Instr::Call(callee, args) -> concat(copy_bytes(arg_base(place.slots), args, 0), cons(232, le32(relative(plus(plus(plus(place.body, pc), times(12, length(args))), 5), get_or(place.entries, callee, 0))))),
            Instr::Ret -> epilogue(),
        };
    }
}

pub fn encode_from(place: Place, pc: usize, code: List<Instr>) -> List<u8> {
    return match (code) {
        Nil -> empty(),
        Cons(i, rest) -> concat(i.encode(place, pc), encode_from(place, plus(pc, i.size()), unbox(rest))),
    };
}

// A program image is its functions back to back, each the frame prologue
// followed by its body.
impl Code {
    pub fn size(self) -> usize {
        return plus(13, code_size(self.instrs));
    }

    pub fn image(self, start: usize, entries: List<usize>) -> List<u8> {
        return concat(prologue(self.slots), encode_from(Place { body: plus(start, 13), slots: self.slots, entries: entries }, 0, self.instrs));
    }
}

// Entry offsets of functions laid out back to back from start.
pub fn layout(start: usize, codes: List<Code>) -> List<usize> {
    return match (codes) {
        Nil -> empty(),
        Cons(code, rest) -> cons(start, layout(plus(start, code.size()), unbox(rest))),
    };
}

pub fn link_from(entries: List<usize>, start: usize, codes: List<Code>) -> List<u8> {
    return match (codes) {
        Nil -> empty(),
        Cons(code, rest) -> concat(code.image(start, entries), link_from(entries, plus(start, code.size()), unbox(rest))),
    };
}

// Machine code of a compiled program.
pub struct Binary {
    codes: List<Code>,
    entries: List<usize>,
    image: List<u8>,
}

// Images are small enough for every rel32 displacement.
pub fn image_limit() -> usize {
    return 1073741824;
}

pub fn compile_program(prog: Program) -> core::option::Option<Binary> {
    return match (compile_funcs(arities(prog.funcs), prog.funcs)) {
        None -> None,
        Some(codes) -> link(codes),
    };
}

// extract: inline
fn link(codes: List<Code>) -> core::option::Option<Binary> {
    let entries: List<usize> = layout(0, codes);
    let image: List<u8> = link_from(entries, 0, codes);
    if (image_limit() >= length(image)) {
        return Some(Binary { codes: codes, entries: entries, image: image });
    }
    return None;
}

// Source programs: the subset of Lanius Core (formal/Lanius/Core.lean) that
// this compiler accepts. Lanius/Mini/Source.lean gives each its Core program,
// and the top-level theorem is about Core's evaluator on that program.
// Locals are Core variable ids; functions are numbered by position. A struct
// type carries its Core type id and its field types; an enum type carries its
// Core type id and each variant's payload types. Fields and payloads are
// scalars.

pub enum FieldTy { FieldI32, FieldBool, }

pub enum SrcType {
    I32,
    Bool,
    Struct(usize, List<FieldTy>),
    Enum(usize, List<List<FieldTy>>),
}

pub enum SrcOp {
    Plus, Minus, Times, BitAnd, BitOr, BitXor,
    Less, LessEq, Greater, GreaterEq, Equal, NotEqual,
    LogicalAnd, LogicalOr,
}

pub enum SrcExpr {
    Int(i32),
    Boolean(bool),
    Local(usize),
    // field of a struct local
    Field(usize, usize),
    Negate(Box<SrcExpr>),
    Not(Box<SrcExpr>),
    Apply(SrcOp, Box<SrcExpr>, Box<SrcExpr>),
}

// A match arm: the binders of its variant's payload, and its value.
pub struct SrcArm {
    binders: List<usize>,
    value: SrcExpr,
}

pub enum SrcStmt {
    Nop,
    // let id: ty = value; then body, with id in scope. A struct value is a
    // struct local.
    Let(usize, SrcType, SrcExpr, Box<SrcStmt>),
    // let id: ty = ty { fields }; then body
    LetStruct(usize, SrcType, List<SrcExpr>, Box<SrcStmt>),
    // let id: ty = callee(args); then body
    LetCall(usize, SrcType, usize, List<SrcExpr>, Box<SrcStmt>),
    // let id: ty = variant(payload) of the enum type ty; then body
    LetEnum(usize, SrcType, usize, List<SrcExpr>, Box<SrcStmt>),
    // let id: ty = match scrutinee { arms }; then body. The scrutinee is a
    // local of the enum type with Core id enum_id, and arm k is variant k.
    LetMatch(usize, SrcType, usize, usize, List<SrcArm>, Box<SrcStmt>),
    Set(usize, SrcExpr),
    // id.field = value
    SetField(usize, usize, SrcExpr),
    // id = callee(args)
    SetCall(usize, usize, List<SrcExpr>),
    Then(Box<SrcStmt>, Box<SrcStmt>),
    If(SrcExpr, Box<SrcStmt>, Box<SrcStmt>),
    While(SrcExpr, Box<SrcStmt>),
    Return(SrcExpr),
}

pub struct SrcParam {
    id: usize,
    ty: SrcType,
}

pub struct SrcFunc {
    params: List<SrcParam>,
    ret: SrcType,
    body: SrcStmt,
}

pub struct SrcProgram {
    funcs: List<SrcFunc>,
}

// Lowering to the language above. It also type-checks: an ill-typed program
// is rejected, so the theorem needs no typing premise (Core would, for
// example, evaluate true && 5 to 5). A Core local becomes a frame slot: a
// function's parameters are slots 0, 1, ..., and each let takes the next slot
// for its body; a struct takes one slot per field. Booleans are 1 and 0.
// Subset expressions neither trap nor have
// effects, so && and || need no short circuit: a && b is a & b on 0 and 1, and
// a || b is (a | b) != 0.

pub struct Binding {
    id: usize,
    slot: usize,
    ty: SrcType,
}

// The innermost binding of id.
pub fn lookup(scope: List<Binding>, id: usize) -> core::option::Option<Binding> {
    return match (scope) {
        Nil -> None,
        Cons(binding, rest) -> lookup_at(binding, unbox(rest), id),
    };
}

// extract: inline
fn lookup_at(binding: Binding, rest: List<Binding>, id: usize) -> core::option::Option<Binding> {
    if (binding.id == id) {
        return Some(binding);
    }
    return lookup(rest, id);
}

pub fn bool_bits(value: bool) -> i32 {
    if (value) {
        return 1;
    }
    return 0;
}

impl FieldTy {
    pub fn ty(self) -> SrcType {
        return match (self) {
            FieldI32 -> I32,
            FieldBool -> Bool,
        };
    }

    pub fn same(self, other: FieldTy) -> bool {
        return match (self) {
            FieldI32 -> match (other) {
                FieldI32 -> true,
                FieldBool -> false,
            },
            FieldBool -> match (other) {
                FieldI32 -> false,
                FieldBool -> true,
            },
        };
    }
}

pub fn fields_same(fields: List<FieldTy>, others: List<FieldTy>) -> bool {
    return match (fields) {
        Nil -> match (others) {
            Nil -> true,
            Cons(other, more) -> false,
        },
        Cons(field, rest) -> match (others) {
            Nil -> false,
            Cons(other, more) -> field.same(other) && fields_same(unbox(rest), unbox(more)),
        },
    };
}

pub fn variants_same(variants: List<List<FieldTy>>, others: List<List<FieldTy>>) -> bool {
    return match (variants) {
        Nil -> match (others) {
            Nil -> true,
            Cons(other, more) -> false,
        },
        Cons(fields, rest) -> match (others) {
            Nil -> false,
            Cons(other, more) -> fields_same(fields, other) && variants_same(unbox(rest), unbox(more)),
        },
    };
}

// The longest payload.
pub fn max_len(variants: List<List<FieldTy>>) -> usize {
    return match (variants) {
        Nil -> 0,
        Cons(fields, rest) -> max_of(length(fields), max_len(unbox(rest))),
    };
}

impl SrcType {
    pub fn is_i32(self) -> bool {
        return match (self) {
            I32 -> true,
            Bool -> false,
            Struct(id, fields) -> false,
            Enum(id, variants) -> false,
        };
    }

    pub fn is_bool(self) -> bool {
        return match (self) {
            I32 -> false,
            Bool -> true,
            Struct(id, fields) -> false,
            Enum(id, variants) -> false,
        };
    }

    pub fn is_scalar(self) -> bool {
        return match (self) {
            I32 -> true,
            Bool -> true,
            Struct(id, fields) -> false,
            Enum(id, variants) -> false,
        };
    }

    pub fn is_struct(self, id: usize, fields: List<FieldTy>) -> bool {
        return match (self) {
            I32 -> false,
            Bool -> false,
            Struct(other_id, other_fields) -> (other_id == id) && fields_same(other_fields, fields),
            Enum(other_id, variants) -> false,
        };
    }

    pub fn is_enum(self, id: usize, variants: List<List<FieldTy>>) -> bool {
        return match (self) {
            I32 -> false,
            Bool -> false,
            Struct(other_id, fields) -> false,
            Enum(other_id, other_variants) -> (other_id == id) && variants_same(other_variants, variants),
        };
    }

    pub fn same(self, other: SrcType) -> bool {
        return match (self) {
            I32 -> other.is_i32(),
            Bool -> other.is_bool(),
            Struct(id, fields) -> other.is_struct(id, fields),
            Enum(id, variants) -> other.is_enum(id, variants),
        };
    }

    // Slots a value of this type takes: an enum's tag, then room for its
    // longest payload.
    pub fn size(self) -> usize {
        return match (self) {
            I32 -> 1,
            Bool -> 1,
            Struct(id, fields) -> length(fields),
            Enum(id, variants) -> plus(1, max_len(variants)),
        };
    }
}

// A lowered expression and its source type.
pub struct Typed {
    expr: Expr,
    ty: SrcType,
}

pub fn arith(operation: BinOp, left: Typed, right: Typed) -> core::option::Option<Typed> {
    if (left.ty.is_i32() && right.ty.is_i32()) {
        return Some(Typed { expr: Binary(operation, boxed(left.expr), boxed(right.expr)), ty: I32 });
    }
    return None;
}

pub fn order(operation: CmpOp, left: Typed, right: Typed) -> core::option::Option<Typed> {
    if (left.ty.is_i32() && right.ty.is_i32()) {
        return Some(Typed { expr: Compare(operation, boxed(left.expr), boxed(right.expr)), ty: Bool });
    }
    return None;
}

pub fn equality(operation: CmpOp, left: Typed, right: Typed) -> core::option::Option<Typed> {
    if (left.ty.same(right.ty)) {
        return Some(Typed { expr: Compare(operation, boxed(left.expr), boxed(right.expr)), ty: Bool });
    }
    return None;
}

pub fn conjunction(left: Typed, right: Typed) -> core::option::Option<Typed> {
    if (left.ty.is_bool() && right.ty.is_bool()) {
        return Some(Typed { expr: Binary(And, boxed(left.expr), boxed(right.expr)), ty: Bool });
    }
    return None;
}

pub fn disjunction(left: Typed, right: Typed) -> core::option::Option<Typed> {
    if (left.ty.is_bool() && right.ty.is_bool()) {
        let either: Expr = Binary(Or, boxed(left.expr), boxed(right.expr));
        return Some(Typed { expr: Compare(Ne, boxed(either), boxed(Lit(0))), ty: Bool });
    }
    return None;
}

impl SrcOp {
    pub fn lower(self, left: Typed, right: Typed) -> core::option::Option<Typed> {
        return match (self) {
            Plus -> arith(Add, left, right),
            Minus -> arith(Sub, left, right),
            Times -> arith(Mul, left, right),
            BitAnd -> arith(And, left, right),
            BitOr -> arith(Or, left, right),
            BitXor -> arith(Xor, left, right),
            Less -> order(Lt, left, right),
            LessEq -> order(Le, left, right),
            Greater -> order(Gt, left, right),
            GreaterEq -> order(Ge, left, right),
            Equal -> equality(Eq, left, right),
            NotEqual -> equality(Ne, left, right),
            LogicalAnd -> conjunction(left, right),
            LogicalOr -> disjunction(left, right),
        };
    }
}

pub fn lower_scalar_local(b: Binding) -> core::option::Option<Typed> {
    if (b.ty.is_scalar()) {
        return Some(Typed { expr: Var(b.slot), ty: b.ty });
    }
    return None;
}

pub fn lower_local(binding: core::option::Option<Binding>) -> core::option::Option<Typed> {
    return match (binding) {
        None -> None,
        Some(b) -> lower_scalar_local(b),
    };
}

pub fn lower_field_at(slot: usize, field: usize, found: core::option::Option<FieldTy>) -> core::option::Option<Typed> {
    return match (found) {
        None -> None,
        Some(f) -> Some(Typed { expr: Var(plus(slot, field)), ty: f.ty() }),
    };
}

pub fn lower_field_of(b: Binding, field: usize) -> core::option::Option<Typed> {
    return match (b.ty) {
        I32 -> None,
        Bool -> None,
        Struct(id, fields) -> lower_field_at(b.slot, field, get(fields, field)),
        Enum(id, variants) -> None,
    };
}

pub fn lower_field(binding: core::option::Option<Binding>, field: usize) -> core::option::Option<Typed> {
    return match (binding) {
        None -> None,
        Some(b) -> lower_field_of(b, field),
    };
}

pub fn lower_negate_typed(operand: Typed) -> core::option::Option<Typed> {
    if (operand.ty.is_i32()) {
        return Some(Typed { expr: Expr::Neg(boxed(operand.expr)), ty: I32 });
    }
    return None;
}

pub fn lower_negate(operand: core::option::Option<Typed>) -> core::option::Option<Typed> {
    return match (operand) {
        None -> None,
        Some(e) -> lower_negate_typed(e),
    };
}

pub fn lower_not_typed(operand: Typed) -> core::option::Option<Typed> {
    if (operand.ty.is_bool()) {
        return Some(Typed { expr: Compare(Eq, boxed(operand.expr), boxed(Lit(0))), ty: Bool });
    }
    return None;
}

pub fn lower_not(operand: core::option::Option<Typed>) -> core::option::Option<Typed> {
    return match (operand) {
        None -> None,
        Some(e) -> lower_not_typed(e),
    };
}

pub fn lower_apply(op: SrcOp, left: core::option::Option<Typed>, right: core::option::Option<Typed>) -> core::option::Option<Typed> {
    return match (left) {
        None -> None,
        Some(l) -> match (right) {
            None -> None,
            Some(r) -> op.lower(l, r),
        },
    };
}

impl SrcExpr {
    pub fn lower(self, scope: List<Binding>) -> core::option::Option<Typed> {
        return match (self) {
            Int(value) -> Some(Typed { expr: Lit(value), ty: I32 }),
            Boolean(value) -> Some(Typed { expr: Lit(bool_bits(value)), ty: Bool }),
            Local(id) -> lower_local(lookup(scope, id)),
            Field(id, index) -> lower_field(lookup(scope, id), index),
            Negate(operand) -> lower_negate(unbox(operand).lower(scope)),
            Not(operand) -> lower_not(unbox(operand).lower(scope)),
            Apply(op, left, right) -> lower_apply(op, unbox(left).lower(scope), unbox(right).lower(scope)),
        };
    }
}

pub fn expect_type(typed: Typed, ty: SrcType) -> core::option::Option<Expr> {
    if (typed.ty.same(ty)) {
        return Some(typed.expr);
    }
    return None;
}

// The expression, if it lowers and has type ty.
pub fn lower_as(scope: List<Binding>, e: SrcExpr, ty: SrcType) -> core::option::Option<Expr> {
    return match (e.lower(scope)) {
        None -> None,
        Some(typed) -> expect_type(typed, ty),
    };
}

pub fn lower_cons(first: core::option::Option<Expr>, rest: core::option::Option<List<Expr>>) -> core::option::Option<List<Expr>> {
    return match (first) {
        None -> None,
        Some(e) -> match (rest) {
            None -> None,
            Some(es) -> Some(cons(e, es)),
        },
    };
}

pub fn lower_append(first: core::option::Option<List<Expr>>, rest: core::option::Option<List<Expr>>) -> core::option::Option<List<Expr>> {
    return match (first) {
        None -> None,
        Some(es) -> match (rest) {
            None -> None,
            Some(more) -> Some(concat(es, more)),
        },
    };
}

// Var(slot), Var(slot + 1), ..., count of them.
pub fn slot_vars(slot: usize, count: usize) -> List<Expr> {
    if (count == 0) {
        return empty();
    }
    return cons(Var(slot), slot_vars(plus(slot, 1), minus(count, 1)));
}

pub fn copy_binding(binding: core::option::Option<Binding>, ty: SrcType) -> core::option::Option<List<Expr>> {
    return match (binding) {
        None -> None,
        Some(b) -> copy_same(b, ty),
    };
}

// extract: inline
fn copy_same(b: Binding, ty: SrcType) -> core::option::Option<List<Expr>> {
    if (b.ty.same(ty)) {
        return Some(slot_vars(b.slot, b.ty.size()));
    }
    return None;
}

// A struct value: a struct local of that type, slot by slot.
pub fn lower_copy(scope: List<Binding>, e: SrcExpr, ty: SrcType) -> core::option::Option<List<Expr>> {
    return match (e) {
        Int(value) -> None,
        Boolean(value) -> None,
        Local(id) -> copy_binding(lookup(scope, id), ty),
        Field(id, index) -> None,
        Negate(operand) -> None,
        Not(operand) -> None,
        Apply(op, left, right) -> None,
    };
}

pub fn lower_single(value: core::option::Option<Expr>) -> core::option::Option<List<Expr>> {
    return match (value) {
        None -> None,
        Some(x) -> Some(single(x)),
    };
}

// A value of type ty, one expression per slot.
pub fn lower_value(scope: List<Binding>, e: SrcExpr, ty: SrcType) -> core::option::Option<List<Expr>> {
    if (ty.is_scalar()) {
        return lower_single(lower_as(scope, e, ty));
    }
    return lower_copy(scope, e, ty);
}

// The arguments, if there is one of each parameter type, slot by slot.
pub fn lower_args(scope: List<Binding>, args: List<SrcExpr>, types: List<SrcType>) -> core::option::Option<List<Expr>> {
    return match (args) {
        Nil -> match (types) {
            Nil -> Some(empty()),
            Cons(ty, more) -> None,
        },
        Cons(arg, rest) -> match (types) {
            Nil -> None,
            Cons(ty, more) -> lower_append(lower_value(scope, arg, ty), lower_args(scope, unbox(rest), unbox(more))),
        },
    };
}

// A struct literal's fields, one of each field type.
pub fn lower_fields(scope: List<Binding>, fields: List<SrcExpr>, types: List<FieldTy>) -> core::option::Option<List<Expr>> {
    return match (fields) {
        Nil -> match (types) {
            Nil -> Some(empty()),
            Cons(ty, more) -> None,
        },
        Cons(field, rest) -> match (types) {
            Nil -> None,
            Cons(ty, more) -> lower_cons(lower_as(scope, field, ty.ty()), lower_fields(scope, unbox(rest), unbox(more))),
        },
    };
}

// Structs have fields, so every binding has its own slots.
pub fn lower_struct_fields(scope: List<Binding>, fields: List<SrcExpr>, types: List<FieldTy>) -> core::option::Option<List<Expr>> {
    if (length(types) == 0) {
        return None;
    }
    return lower_fields(scope, fields, types);
}

pub fn lower_literal(scope: List<Binding>, ty: SrcType, fields: List<SrcExpr>) -> core::option::Option<List<Expr>> {
    return match (ty) {
        I32 -> None,
        Bool -> None,
        Struct(id, types) -> lower_struct_fields(scope, fields, types),
        Enum(id, variants) -> None,
    };
}

pub fn lower_tag(variant: usize, payload: core::option::Option<List<Expr>>) -> core::option::Option<List<Expr>> {
    return match (payload) {
        None -> None,
        Some(es) -> Some(cons(Lit(variant as i32), es)),
    };
}

pub fn lower_variant(scope: List<Binding>, variant: usize, found: core::option::Option<List<FieldTy>>, payload: List<SrcExpr>) -> core::option::Option<List<Expr>> {
    return match (found) {
        None -> None,
        Some(types) -> lower_tag(variant, lower_fields(scope, payload, types)),
    };
}

// Tags are 32-bit, so an enum has fewer than 2^32 variants.
pub fn lower_tagged(scope: List<Binding>, variants: List<List<FieldTy>>, variant: usize, payload: List<SrcExpr>) -> core::option::Option<List<Expr>> {
    if (length(variants) < 4294967296) {
        return lower_variant(scope, variant, get(variants, variant), payload);
    }
    return None;
}

// An enum value: its tag, then the variant's payload. Slots past the payload
// are left as they are.
pub fn lower_enum_value(scope: List<Binding>, ty: SrcType, variant: usize, payload: List<SrcExpr>) -> core::option::Option<List<Expr>> {
    return match (ty) {
        I32 -> None,
        Bool -> None,
        Struct(id, types) -> None,
        Enum(id, variants) -> lower_tagged(scope, variants, variant, payload),
    };
}

// The scope of an arm: binder i names the payload slot slot + i, binding in
// order as Core's bindLocals does.
pub fn arm_scope(binders: List<usize>, types: List<FieldTy>, slot: usize, scope: List<Binding>) -> core::option::Option<List<Binding>> {
    return match (binders) {
        Nil -> match (types) {
            Nil -> Some(scope),
            Cons(ty, more) -> None,
        },
        Cons(binder, rest) -> match (types) {
            Nil -> None,
            Cons(ty, more) -> arm_scope(unbox(rest), unbox(more), plus(slot, 1), cons(Binding { id: binder, slot: slot, ty: ty.ty() }, scope)),
        },
    };
}

pub fn lower_arm_value(scope: core::option::Option<List<Binding>>, value: SrcExpr, ty: SrcType) -> core::option::Option<Expr> {
    return match (scope) {
        None -> None,
        Some(s) -> lower_as(s, value, ty),
    };
}

// Arm k stores value into target; the last arm needs no tag test.
pub fn lower_arm(slot: usize, target: usize, k: usize, value: core::option::Option<Expr>, rest: List<SrcArm>, others: core::option::Option<Stmt>) -> core::option::Option<Stmt> {
    return match (value) {
        None -> None,
        Some(v) -> match (rest) {
            Nil -> Some(Assign(target, v)),
            Cons(arm, more) -> match (others) {
                None -> None,
                Some(o) -> Some(Ite(Compare(Eq, boxed(Var(slot)), boxed(Lit(k as i32))), boxed(Assign(target, v)), boxed(o))),
            },
        },
    };
}

// Arms k, k + 1, ... of a match on the enum at slot, one per variant from k.
pub fn lower_arms(scope: List<Binding>, slot: usize, target: usize, ty: SrcType, k: usize, variants: List<List<FieldTy>>, arms: List<SrcArm>) -> core::option::Option<Stmt> {
    return match (arms) {
        Nil -> None,
        Cons(arm, rest) -> match (variants) {
            Nil -> None,
            Cons(types, more) -> lower_arm(slot, target, k, lower_arm_value(arm_scope(arm.binders, types, plus(slot, 1), scope), arm.value, ty), unbox(rest), lower_arms(scope, slot, target, ty, plus(k, 1), unbox(more), unbox(rest))),
        },
    };
}

// The match is exhaustive, its value scalar, and its tags fit in 32 bits.
pub fn lower_match_arms(scope: List<Binding>, slot: usize, same: bool, variants: List<List<FieldTy>>, arms: List<SrcArm>, ty: SrcType, target: usize) -> core::option::Option<Stmt> {
    if (same && ty.is_scalar() && (length(arms) == length(variants)) && (length(variants) < 4294967296)) {
        return lower_arms(scope, slot, target, ty, 0, variants, arms);
    }
    return None;
}

pub fn lower_match_on(scope: List<Binding>, b: Binding, enum_id: usize, arms: List<SrcArm>, ty: SrcType, target: usize) -> core::option::Option<Stmt> {
    return match (b.ty) {
        I32 -> None,
        Bool -> None,
        Struct(id, types) -> None,
        Enum(id, variants) -> lower_match_arms(scope, b.slot, id == enum_id, variants, arms, ty, target),
    };
}

pub fn lower_match(scope: List<Binding>, binding: core::option::Option<Binding>, enum_id: usize, arms: List<SrcArm>, ty: SrcType, target: usize) -> core::option::Option<Stmt> {
    return match (binding) {
        None -> None,
        Some(b) -> lower_match_on(scope, b, enum_id, arms, ty, target),
    };
}


// A function's parameter types and result type.
pub struct Sig {
    params: List<SrcType>,
    ret: SrcType,
}

pub fn lower_call_sig(scope: List<Binding>, sig: Sig, args: List<SrcExpr>, ty: SrcType) -> core::option::Option<List<Expr>> {
    if (sig.ret.same(ty) && ty.is_scalar()) {
        return lower_args(scope, args, sig.params);
    }
    return None;
}

// The arguments of a call returning ty to callee.
pub fn lower_call(sigs: List<Sig>, scope: List<Binding>, callee: usize, args: List<SrcExpr>, ty: SrcType) -> core::option::Option<List<Expr>> {
    return match (get(sigs, callee)) {
        None -> None,
        Some(sig) -> lower_call_sig(scope, sig, args, ty),
    };
}

// Assign values to slot, slot + 1, ..., then run rest.
pub fn assign_from(slot: usize, values: List<Expr>, rest: Stmt) -> Stmt {
    return match (values) {
        Nil -> rest,
        Cons(value, more) -> Seq(boxed(Assign(slot, value)), boxed(assign_from(plus(slot, 1), unbox(more), rest))),
    };
}

pub fn lower_let(slot: usize, values: core::option::Option<List<Expr>>, body: core::option::Option<Stmt>) -> core::option::Option<Stmt> {
    return match (values) {
        None -> None,
        Some(vs) -> match (body) {
            None -> None,
            Some(b) -> Some(assign_from(slot, vs, b)),
        },
    };
}

pub fn lower_let_call(slot: usize, callee: usize, args: core::option::Option<List<Expr>>, body: core::option::Option<Stmt>) -> core::option::Option<Stmt> {
    return match (args) {
        None -> None,
        Some(a) -> match (body) {
            None -> None,
            Some(b) -> Some(Seq(boxed(Stmt::Call(slot, callee, a)), boxed(b))),
        },
    };
}

pub fn lower_set_values(slot: usize, values: core::option::Option<List<Expr>>) -> core::option::Option<Stmt> {
    return match (values) {
        None -> None,
        Some(vs) -> Some(assign_from(slot, vs, Skip)),
    };
}

pub fn lower_set(binding: core::option::Option<Binding>, scope: List<Binding>, value: SrcExpr) -> core::option::Option<Stmt> {
    return match (binding) {
        None -> None,
        Some(b) -> lower_set_values(b.slot, lower_value(scope, value, b.ty)),
    };
}

pub fn lower_set_value(slot: usize, value: core::option::Option<Expr>) -> core::option::Option<Stmt> {
    return match (value) {
        None -> None,
        Some(v) -> Some(Assign(slot, v)),
    };
}

pub fn lower_set_field_at(slot: usize, field: usize, found: core::option::Option<FieldTy>, scope: List<Binding>, value: SrcExpr) -> core::option::Option<Stmt> {
    return match (found) {
        None -> None,
        Some(f) -> lower_set_value(plus(slot, field), lower_as(scope, value, f.ty())),
    };
}

pub fn lower_set_field_of(b: Binding, field: usize, scope: List<Binding>, value: SrcExpr) -> core::option::Option<Stmt> {
    return match (b.ty) {
        I32 -> None,
        Bool -> None,
        Struct(id, fields) -> lower_set_field_at(b.slot, field, get(fields, field), scope, value),
        Enum(id, variants) -> None,
    };
}

pub fn lower_set_field(binding: core::option::Option<Binding>, field: usize, scope: List<Binding>, value: SrcExpr) -> core::option::Option<Stmt> {
    return match (binding) {
        None -> None,
        Some(b) -> lower_set_field_of(b, field, scope, value),
    };
}

pub fn lower_set_call_args(slot: usize, callee: usize, args: core::option::Option<List<Expr>>) -> core::option::Option<Stmt> {
    return match (args) {
        None -> None,
        Some(a) -> Some(Stmt::Call(slot, callee, a)),
    };
}

pub fn lower_set_call(sigs: List<Sig>, scope: List<Binding>, binding: core::option::Option<Binding>, callee: usize, args: List<SrcExpr>) -> core::option::Option<Stmt> {
    return match (binding) {
        None -> None,
        Some(b) -> lower_set_call_args(b.slot, callee, lower_call(sigs, scope, callee, args, b.ty)),
    };
}

pub fn lower_then(first: core::option::Option<Stmt>, second: core::option::Option<Stmt>) -> core::option::Option<Stmt> {
    return match (first) {
        None -> None,
        Some(a) -> match (second) {
            None -> None,
            Some(b) -> Some(Seq(boxed(a), boxed(b))),
        },
    };
}

pub fn lower_if(condition: core::option::Option<Expr>, then_branch: core::option::Option<Stmt>, else_branch: core::option::Option<Stmt>) -> core::option::Option<Stmt> {
    return match (condition) {
        None -> None,
        Some(c) -> match (then_branch) {
            None -> None,
            Some(t) -> match (else_branch) {
                None -> None,
                Some(e) -> Some(Ite(c, boxed(t), boxed(e))),
            },
        },
    };
}

pub fn lower_while(condition: core::option::Option<Expr>, body: core::option::Option<Stmt>) -> core::option::Option<Stmt> {
    return match (condition) {
        None -> None,
        Some(c) -> match (body) {
            None -> None,
            Some(b) -> Some(Loop(c, boxed(b))),
        },
    };
}

pub fn lower_return(value: core::option::Option<Expr>) -> core::option::Option<Stmt> {
    return match (value) {
        None -> None,
        Some(v) -> Some(Stmt::Ret(v)),
    };
}

// sigs are the program's signatures and ret the function's result type; next
// is the first slot no binding in scope uses.
impl SrcStmt {
    pub fn lower(self, sigs: List<Sig>, ret: SrcType, scope: List<Binding>, next: usize) -> core::option::Option<Stmt> {
        return match (self) {
            Nop -> Some(Skip),
            Let(id, ty, value, body) -> lower_let(next, lower_value(scope, value, ty), unbox(body).lower(sigs, ret, cons(Binding { id: id, slot: next, ty: ty }, scope), plus(next, ty.size()))),
            LetStruct(id, ty, fields, body) -> lower_let(next, lower_literal(scope, ty, fields), unbox(body).lower(sigs, ret, cons(Binding { id: id, slot: next, ty: ty }, scope), plus(next, ty.size()))),
            LetCall(id, ty, callee, args, body) -> lower_let_call(next, callee, lower_call(sigs, scope, callee, args, ty), unbox(body).lower(sigs, ret, cons(Binding { id: id, slot: next, ty: ty }, scope), plus(next, ty.size()))),
            LetEnum(id, ty, variant, payload, body) -> lower_let(next, lower_enum_value(scope, ty, variant, payload), unbox(body).lower(sigs, ret, cons(Binding { id: id, slot: next, ty: ty }, scope), plus(next, ty.size()))),
            LetMatch(id, ty, scrutinee, enum_id, arms, body) -> lower_then(lower_match(scope, lookup(scope, scrutinee), enum_id, arms, ty, next), unbox(body).lower(sigs, ret, cons(Binding { id: id, slot: next, ty: ty }, scope), plus(next, ty.size()))),
            Set(id, value) -> lower_set(lookup(scope, id), scope, value),
            SetField(id, index, value) -> lower_set_field(lookup(scope, id), index, scope, value),
            SetCall(id, callee, args) -> lower_set_call(sigs, scope, lookup(scope, id), callee, args),
            Then(first, second) -> lower_then(unbox(first).lower(sigs, ret, scope, next), unbox(second).lower(sigs, ret, scope, next)),
            If(condition, then_branch, else_branch) -> lower_if(lower_as(scope, condition, Bool), unbox(then_branch).lower(sigs, ret, scope, next), unbox(else_branch).lower(sigs, ret, scope, next)),
            While(condition, body) -> lower_while(lower_as(scope, condition, Bool), unbox(body).lower(sigs, ret, scope, next)),
            Return(value) -> lower_return(lower_as(scope, value, ret)),
        };
    }

    // Slots the statement's lets need beyond the ones in scope.
    pub fn depth(self) -> usize {
        return match (self) {
            Nop -> 0,
            Let(id, ty, value, body) -> plus(unbox(body).depth(), ty.size()),
            LetStruct(id, ty, fields, body) -> plus(unbox(body).depth(), ty.size()),
            LetCall(id, ty, callee, args, body) -> plus(unbox(body).depth(), ty.size()),
            LetEnum(id, ty, variant, payload, body) -> plus(unbox(body).depth(), ty.size()),
            LetMatch(id, ty, scrutinee, enum_id, arms, body) -> plus(unbox(body).depth(), ty.size()),
            Set(id, value) -> 0,
            SetField(id, index, value) -> 0,
            SetCall(id, callee, args) -> 0,
            Then(first, second) -> max_of(unbox(first).depth(), unbox(second).depth()),
            If(condition, then_branch, else_branch) -> max_of(unbox(then_branch).depth(), unbox(else_branch).depth()),
            While(condition, body) -> unbox(body).depth(),
            Return(value) -> 0,
        };
    }
}

// Parameters take slots from 0 in order, a struct one per field; a later
// parameter with the same id shadows an earlier one, as Core's bindLocals
// does.
pub fn param_scope(params: List<SrcParam>, slot: usize, scope: List<Binding>) -> List<Binding> {
    return match (params) {
        Nil -> scope,
        Cons(param, rest) -> param_scope(unbox(rest), plus(slot, param.ty.size()), cons(Binding { id: param.id, slot: slot, ty: param.ty }, scope)),
    };
}

pub fn params_valid(params: List<SrcParam>) -> bool {
    return match (params) {
        Nil -> true,
        Cons(param, rest) -> (param.ty.size() > 0) && params_valid(unbox(rest)),
    };
}

pub fn params_size(params: List<SrcParam>) -> usize {
    return match (params) {
        Nil -> 0,
        Cons(param, rest) -> plus(param.ty.size(), params_size(unbox(rest))),
    };
}

pub fn param_types(params: List<SrcParam>) -> List<SrcType> {
    return match (params) {
        Nil -> empty(),
        Cons(param, rest) -> cons(param.ty, param_types(unbox(rest))),
    };
}

pub fn sigs(funcs: List<SrcFunc>) -> List<Sig> {
    return match (funcs) {
        Nil -> empty(),
        Cons(func, rest) -> cons(Sig { params: param_types(func.params), ret: func.ret }, sigs(unbox(rest))),
    };
}

pub fn lower_body(count: usize, depth: usize, body: core::option::Option<Stmt>) -> core::option::Option<Func> {
    return match (body) {
        None -> None,
        Some(b) -> Some(Func { params: count, locals: plus(count, depth), body: b }),
    };
}

// Functions return scalars, and struct parameters have fields.
pub fn lower_func(sigs: List<Sig>, func: SrcFunc) -> core::option::Option<Func> {
    let count: usize = params_size(func.params);
    if (func.ret.is_scalar() && params_valid(func.params)) {
        return lower_body(count, func.body.depth(), func.body.lower(sigs, func.ret, param_scope(func.params, 0, empty()), count));
    }
    return None;
}

pub fn lower_func_cons(first: core::option::Option<Func>, rest: core::option::Option<List<Func>>) -> core::option::Option<List<Func>> {
    return match (first) {
        None -> None,
        Some(f) -> match (rest) {
            None -> None,
            Some(fs) -> Some(cons(f, fs)),
        },
    };
}

pub fn lower_funcs(sigs: List<Sig>, funcs: List<SrcFunc>) -> core::option::Option<List<Func>> {
    return match (funcs) {
        Nil -> Some(empty()),
        Cons(func, rest) -> lower_func_cons(lower_func(sigs, func), lower_funcs(sigs, unbox(rest))),
    };
}

// Machine code of a source program.
pub fn compile_source(prog: SrcProgram) -> core::option::Option<Binary> {
    return match (lower_funcs(sigs(prog.funcs), prog.funcs)) {
        None -> None,
        Some(funcs) -> compile_program(Program { funcs: funcs }),
    };
}
