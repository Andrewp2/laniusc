// The mini compiler in Lanius. formal/tools/extract.py turns everything after
// the prelude into the Lean definitions in formal/Lanius/Mini/Compiler.lean,
// which the proofs in formal/Lanius/Mini/ are about.
//
// The code is pure: values are never mutated, recursion replaces loops, and
// lists are the prelude's cons list. Arithmetic on usize goes through
// plus/minus/times, which panic instead of wrapping, so a run that returns
// computed exactly what the Lean definitions compute over Nat.
module mini::compiler;
import alloc::allocator;
import core::mem;
import core::option;
import core::panic;

// extract: prelude begin
// Each prelude item has a fixed Lean meaning (see PRELUDE in extract.py).
// They are the only code that touches memory.

// Box<T> is T.
pub struct Box<T> { storage: ptr }

pub fn boxed<T>(value: T) -> Box<T> {
    let size: usize = core::mem::size_of<T>();
    let storage: ptr = alloc::allocator::alloc(size, 8);
    if (storage == 0) {
        core::panic::panic();
    }
    let slot: [T] = core::mem::typed_slice_from_storage(storage, 1);
    slot[0] = value;
    return Box { storage: storage };
}

pub fn unbox<T>(value: Box<T>) -> T {
    let slot: [T] = core::mem::typed_slice_from_storage(value.storage, 1);
    return slot[0];
}

// List<T> is List T: Nil is [] and Cons(x, rest) is x :: rest.
pub enum List<T> { Nil, Cons(T, Box<List<T>>), }

// Nat a + b
pub fn plus(a: usize, b: usize) -> usize {
    let sum: usize = a + b;
    if (a > sum) {
        core::panic::panic();
    }
    return sum;
}

// Nat a * b
pub fn times(a: usize, b: usize) -> usize {
    if (a == 0) {
        return 0;
    }
    let product: usize = a * b;
    if (product / a != b) {
        core::panic::panic();
    }
    return product;
}

// Nat a - b, used only where a >= b
pub fn minus(a: usize, b: usize) -> usize {
    if (b > a) {
        core::panic::panic();
    }
    return a - b;
}

// max a b
pub fn max_of(a: usize, b: usize) -> usize {
    if (b > a) {
        return b;
    }
    return a;
}
// extract: prelude end

// List operations. Each one is extracted as Lists.<name>, together with a
// theorem that it equals its Lean list function; calls elsewhere are written
// as that function (see SPEC_FNS in extract.py).

// []
pub fn empty<T>() -> List<T> {
    return Nil;
}

// [item]
pub fn single<T>(item: T) -> List<T> {
    return Cons(item, boxed(Nil));
}

// item :: rest
pub fn cons<T>(item: T, rest: List<T>) -> List<T> {
    return Cons(item, boxed(rest));
}

// first ++ second
pub fn concat<T>(first: List<T>, second: List<T>) -> List<T> {
    return match (first) {
        Nil -> second,
        Cons(item, rest) -> Cons(item, boxed(concat(unbox(rest), second))),
    };
}

// items.length
pub fn length<T>(items: List<T>) -> usize {
    return match (items) {
        Nil -> 0,
        Cons(item, rest) -> plus(length(unbox(rest)), 1),
    };
}

// items[index]?
pub fn get<T>(items: List<T>, index: usize) -> core::option::Option<T> {
    if (index == 0) {
        return match (items) {
            Nil -> None,
            Cons(item, rest) -> Some(item),
        };
    }
    return match (items) {
        Nil -> None,
        Cons(item, rest) -> get(unbox(rest), minus(index, 1)),
    };
}

// items.getD index fallback
pub fn get_or<T>(items: List<T>, index: usize, fallback: T) -> T {
    if (index == 0) {
        return match (items) {
            Nil -> fallback,
            Cons(item, rest) -> item,
        };
    }
    return match (items) {
        Nil -> fallback,
        Cons(item, rest) -> get_or(unbox(rest), minus(index, 1), fallback),
    };
}

// Source language: code over 64-bit words with comparisons, if, while, and
// functions with parameters and direct calls. Locals are frame indices; a
// function's parameters are its first locals. Comparisons produce 1 or 0, and
// conditions test for nonzero. Calls are statements: a function returns a
// fixed number of values, and a call stores them in consecutive locals.
// There is a heap of bytes below a fixed limit, and a bump allocator whose
// cursor only moves up: addresses are heap offsets.

pub enum BinOp { Add, Sub, Mul, And, Or, Xor, }

pub enum CmpOp { Eq, Ne, Lt, Le, Gt, Ge, }

// How an operation reads its words. An S32 operation acts on the low 32 bits
// and zero-extends its result, as x86's 32-bit instructions do, and its
// comparisons are signed. A U64 operation uses all 64 bits, and its
// comparisons are unsigned.
pub enum Word { S32, U64, }

// A heap word access: 4 or 8 bytes, little-endian. A 4-byte load
// zero-extends; a 4-byte store writes the low 4 bytes.
pub enum MemWidth { M32, M64, }

impl MemWidth {
    // The bytes a load or store covers.
    pub fn bytes(self) -> usize {
        return match (self) {
            M32 -> 4,
            M64 -> 8,
        };
    }

    // The length of the REX.W prefix of the 64-bit move.
    pub fn prefix(self) -> usize {
        return match (self) {
            M32 -> 0,
            M64 -> 1,
        };
    }

    // The REX.W prefix of the 64-bit move.
    pub fn rex(self) -> List<u8> {
        return match (self) {
            M32 -> empty(),
            M64 -> single(72),
        };
    }
}

pub enum Expr {
    Lit(u64),
    Var(usize),
    // S32 negation
    Neg(Box<Expr>),
    Binary(Word, BinOp, Box<Expr>, Box<Expr>),
    Compare(Word, CmpOp, Box<Expr>, Box<Expr>),
}

pub enum Stmt {
    Skip,
    Assign(usize, Expr),
    Seq(Box<Stmt>, Box<Stmt>),
    Ite(Expr, Box<Stmt>, Box<Stmt>),
    // while condition { body }
    Loop(Expr, Box<Stmt>),
    // target, ..., target + count - 1 = callee(args)
    Call(usize, usize, usize, List<Expr>),
    Ret(List<Expr>),
    // target = the cursor rounded up to a multiple of 2^shift; the cursor
    // moves past size bytes from there
    Alloc(usize, usize, Expr),
    // target = the byte at address
    LoadByte(usize, Expr),
    // the byte at address = the low byte of value
    StoreByte(Expr, Expr),
    // target = the word at address
    LoadWord(MemWidth, usize, Expr),
    // the word at address = the low bytes of value
    StoreWord(MemWidth, Expr, Expr),
}

pub struct Func {
    params: usize,
    // Values each return gives.
    results: usize,
    // All locals, parameters included.
    locals: usize,
    body: Stmt,
}

pub struct Program {
    funcs: List<Func>,
}

// The abstract target: an accumulator (rax), frame slots, and a program
// counter that is a byte offset into the function's code. Each instruction is
// one fixed byte sequence, Instr::size bytes long.
pub enum Instr {
    // mov rax, imm64
    Imm(u64),
    // mov rax, [rbp - 8 * (slot + 1)]
    Load(usize),
    // mov [rbp - 8 * (slot + 1)], rax
    Store(usize),
    // neg eax
    Neg,
    // rax := slot op rax
    Op(Word, BinOp, usize),
    // rax := (slot cmp rax) ? 1 : 0
    Cmp(Word, CmpOp, usize),
    // jmp rel32
    Jmp(usize),
    // test rax, rax; jz rel32
    Jz(usize),
    // Copy the argument slots into the callee's parameter slots, call rel32,
    // then copy count results from the callee's first slots to target, ...
    Call(usize, List<usize>, usize, usize),
    // Copy the source slots to the first slots, then the frame epilogue and
    // ret. The results replace the arguments, and rax holds the last one.
    Ret(List<usize>),
    // Allocate rax bytes at the cursor (r13) rounded up to 2^shift, below
    // the limit (r14), and leave the address in rax
    Bump(usize),
    // movzx eax, byte [r12 + rax]: the heap starts at r12
    LoadAt,
    // mov [r12 + slot], al
    StoreAt(usize),
    // mov eax, [r12 + rax], or rax for M64
    LoadWordAt(MemWidth),
    // mov [r12 + slot], eax, or rax for M64
    StoreWordAt(MemWidth, usize),
}

impl BinOp {
    // imul is one byte longer than the other operators.
    pub fn size(self) -> usize {
        return match (self) {
            Add -> 12,
            Sub -> 12,
            Mul -> 13,
            And -> 12,
            Or -> 12,
            Xor -> 12,
        };
    }
}

impl Word {
    // U64 operations take a REX.W prefix byte.
    pub fn prefix(self) -> usize {
        return match (self) {
            S32 -> 0,
            U64 -> 1,
        };
    }
}

impl Instr {
    pub fn size(self) -> usize {
        return match (self) {
            Imm(value) -> 10,
            Load(slot) -> 7,
            Store(slot) -> 7,
            Instr::Neg -> 2,
            Op(word, operation, slot) -> plus(operation.size(), word.prefix()),
            Cmp(word, operation, slot) -> plus(18, word.prefix()),
            Jmp(target) -> 5,
            Jz(target) -> 9,
            Instr::Call(callee, args, target, count) -> plus(plus(times(14, length(args)), 5), times(14, count)),
            Instr::Ret(sources) -> plus(times(14, length(sources)), 5),
            Bump(shift) -> 52,
            LoadAt -> 10,
            StoreAt(slot) -> 16,
            LoadWordAt(width) -> plus(9, width.prefix()),
            StoreWordAt(width, slot) -> plus(16, width.prefix()),
        };
    }
}

pub fn code_size(code: List<Instr>) -> usize {
    return match (code) {
        Nil -> 0,
        Cons(i, rest) -> plus(i.size(), code_size(unbox(rest))),
    };
}

// Expressions leave their value in the accumulator. A binary operator's left
// operand waits in temporary slot base + depth, above the base local slots,
// while the right operand is computed one level deeper.
pub fn compile_expr(base: usize, e: Expr, depth: usize) -> List<Instr> {
    return match (e) {
        Lit(value) -> single(Imm(value)),
        Var(index) -> single(Load(index)),
        Expr::Neg(operand) -> concat(compile_expr(base, unbox(operand), depth), single(Instr::Neg)),
        Binary(word, operation, left, right) -> concat(concat(concat(compile_expr(base, unbox(left), depth), single(Store(plus(base, depth)))), compile_expr(base, unbox(right), plus(depth, 1))), single(Op(word, operation, plus(base, depth)))),
        Compare(word, operation, left, right) -> concat(concat(concat(compile_expr(base, unbox(left), depth), single(Store(plus(base, depth)))), compile_expr(base, unbox(right), plus(depth, 1))), single(Cmp(word, operation, plus(base, depth)))),
    };
}

// Argument k is evaluated into temporary base + k.
pub fn compile_args(base: usize, args: List<Expr>, k: usize) -> List<Instr> {
    return match (args) {
        Nil -> empty(),
        Cons(arg, rest) -> concat(concat(compile_expr(base, arg, plus(k, 1)), single(Store(plus(base, k)))), compile_args(base, unbox(rest), plus(k, 1))),
    };
}

pub fn arg_slots(base: usize, args: List<Expr>, k: usize) -> List<usize> {
    return match (args) {
        Nil -> empty(),
        Cons(arg, rest) -> cons(plus(base, k), arg_slots(base, unbox(rest), plus(k, 1))),
    };
}

// Statement code is placed at offset pos, so jumps are absolute offsets
// within the function.
pub fn compile_stmt(base: usize, pos: usize, s: Stmt) -> List<Instr> {
    return match (s) {
        Skip -> empty(),
        Assign(index, value) -> concat(compile_expr(base, value, 0), single(Store(index))),
        Seq(first, second) -> seq_code(base, pos, compile_stmt(base, pos, unbox(first)), unbox(second)),
        Ite(condition, then_branch, else_branch) -> ite_code(base, pos, compile_expr(base, condition, 0), unbox(then_branch), unbox(else_branch)),
        Loop(condition, body) -> loop_code(base, pos, compile_expr(base, condition, 0), unbox(body)),
        Stmt::Call(target, count, callee, args) -> concat(compile_args(base, args, 0), single(Instr::Call(callee, arg_slots(base, args, 0), target, count))),
        Stmt::Ret(values) -> concat(compile_args(base, values, 0), single(Instr::Ret(arg_slots(base, values, 0)))),
        Alloc(target, shift, size) -> concat(compile_expr(base, size, 0), cons(Bump(shift), single(Store(target)))),
        LoadByte(target, address) -> concat(compile_expr(base, address, 0), cons(LoadAt, single(Store(target)))),
        StoreByte(address, value) -> concat(concat(compile_expr(base, address, 0), single(Store(base))), concat(compile_expr(base, value, 1), single(StoreAt(base)))),
        LoadWord(width, target, address) -> concat(compile_expr(base, address, 0), cons(LoadWordAt(width), single(Store(target)))),
        StoreWord(width, address, value) -> concat(concat(compile_expr(base, address, 0), single(Store(base))), concat(compile_expr(base, value, 1), single(StoreWordAt(width, base)))),
    };
}

// extract: inline
fn seq_code(base: usize, pos: usize, first_code: List<Instr>, second: Stmt) -> List<Instr> {
    return concat(first_code, compile_stmt(base, plus(pos, code_size(first_code)), second));
}

// extract: inline
fn ite_code(base: usize, pos: usize, condition_code: List<Instr>, then_branch: Stmt, else_branch: Stmt) -> List<Instr> {
    let then_start: usize = plus(plus(pos, code_size(condition_code)), 9);
    let then_code: List<Instr> = compile_stmt(base, then_start, then_branch);
    let else_start: usize = plus(plus(then_start, code_size(then_code)), 5);
    let else_code: List<Instr> = compile_stmt(base, else_start, else_branch);
    return concat(concat(concat(concat(condition_code, single(Jz(else_start))), then_code), single(Jmp(plus(else_start, code_size(else_code))))), else_code);
}

// extract: inline
fn loop_code(base: usize, pos: usize, condition_code: List<Instr>, body: Stmt) -> List<Instr> {
    let body_start: usize = plus(plus(pos, code_size(condition_code)), 9);
    let body_code: List<Instr> = compile_stmt(base, body_start, body);
    return concat(concat(concat(condition_code, single(Jz(plus(plus(body_start, code_size(body_code)), 5)))), body_code), single(Jmp(pos)));
}

// Every local an expression reads is below locals.
impl Expr {
    pub fn within(self, locals: usize) -> bool {
        return match (self) {
            Lit(value) -> true,
            Var(index) -> locals > index,
            Expr::Neg(operand) -> unbox(operand).within(locals),
            Binary(word, operation, left, right) -> unbox(left).within(locals) && unbox(right).within(locals),
            Compare(word, operation, left, right) -> unbox(left).within(locals) && unbox(right).within(locals),
        };
    }

    // Temporary slots an expression's code uses.
    pub fn temps(self) -> usize {
        return match (self) {
            Lit(value) -> 0,
            Var(index) -> 0,
            Expr::Neg(operand) -> unbox(operand).temps(),
            Binary(word, operation, left, right) -> max_of(unbox(left).temps(), plus(unbox(right).temps(), 1)),
            Compare(word, operation, left, right) -> max_of(unbox(left).temps(), plus(unbox(right).temps(), 1)),
        };
    }
}

pub fn all_within(locals: usize, args: List<Expr>) -> bool {
    return match (args) {
        Nil -> true,
        Cons(arg, rest) -> arg.within(locals) && all_within(locals, unbox(rest)),
    };
}

// A function's parameter and result counts.
pub struct Arity {
    params: usize,
    results: usize,
}

pub fn arity_is(arities: List<Arity>, callee: usize, count: usize, results: usize) -> bool {
    return match (get(arities, callee)) {
        Some(arity) -> (arity.params == count) && (arity.results == results),
        None -> false,
    };
}

// Temporaries used by arguments from position k on.
pub fn args_temps(args: List<Expr>, k: usize) -> usize {
    return match (args) {
        Nil -> 0,
        Cons(arg, rest) -> max_of(plus(plus(k, 1), arg.temps()), args_temps(unbox(rest), plus(k, 1))),
    };
}

impl Stmt {
    // Locals are in range, each call names a function, passes it as many
    // arguments as it has parameters and stores all its results, and each
    // return gives results values.
    pub fn within(self, locals: usize, arities: List<Arity>, results: usize) -> bool {
        return match (self) {
            Skip -> true,
            Assign(index, value) -> locals > index && value.within(locals),
            Seq(first, second) -> unbox(first).within(locals, arities, results) && unbox(second).within(locals, arities, results),
            Ite(condition, then_branch, else_branch) -> condition.within(locals) && unbox(then_branch).within(locals, arities, results) && unbox(else_branch).within(locals, arities, results),
            Loop(condition, body) -> condition.within(locals) && unbox(body).within(locals, arities, results),
            Stmt::Call(target, count, callee, args) -> locals >= plus(target, count) && count > 0 && arity_is(arities, callee, length(args), count) && all_within(locals, args),
            Stmt::Ret(values) -> (length(values) == results) && all_within(locals, values),
            Alloc(target, shift, size) -> locals > target && 32 > shift && size.within(locals),
            LoadByte(target, address) -> locals > target && address.within(locals),
            StoreByte(address, value) -> address.within(locals) && value.within(locals),
            LoadWord(width, target, address) -> locals > target && address.within(locals),
            StoreWord(width, address, value) -> address.within(locals) && value.within(locals),
        };
    }

    pub fn temps(self) -> usize {
        return match (self) {
            Skip -> 0,
            Assign(index, value) -> value.temps(),
            Seq(first, second) -> max_of(unbox(first).temps(), unbox(second).temps()),
            Ite(condition, then_branch, else_branch) -> max_of(condition.temps(), max_of(unbox(then_branch).temps(), unbox(else_branch).temps())),
            Loop(condition, body) -> max_of(condition.temps(), unbox(body).temps()),
            Stmt::Call(target, count, callee, args) -> args_temps(args, 0),
            Stmt::Ret(values) -> args_temps(values, 0),
            Alloc(target, shift, size) -> size.temps(),
            LoadByte(target, address) -> address.temps(),
            StoreByte(address, value) -> max_of(address.temps(), plus(value.temps(), 1)),
            LoadWord(width, target, address) -> address.temps(),
            StoreWord(width, address, value) -> max_of(address.temps(), plus(value.temps(), 1)),
        };
    }
}

// Zero the non-parameter locals first, ..., first + count - 1.
pub fn zero_locals(first: usize, count: usize) -> List<Instr> {
    if (count == 0) {
        return empty();
    }
    return cons(Store(first), zero_locals(plus(first, 1), minus(count, 1)));
}

// Frames are bounded so every slot displacement fits a signed 32-bit field.
pub fn frame_limit() -> usize {
    return 1048576;
}

pub struct Code {
    // Frame slots: the locals, then the deepest statement's temporaries.
    slots: usize,
    instrs: List<Instr>,
}

// A function returns at least one value, and its results fit in its locals.
pub fn compile_func(arities: List<Arity>, func: Func) -> core::option::Option<Code> {
    let slots: usize = plus(func.locals, func.body.temps());
    if (func.locals >= func.params && func.results > 0 && func.locals >= func.results && func.body.within(func.locals, arities, func.results) && frame_limit() >= slots) {
        let init: List<Instr> = cons(Imm(0), zero_locals(func.params, minus(func.locals, func.params)));
        return Some(Code { slots: slots, instrs: concat(init, compile_stmt(func.locals, code_size(init), func.body)) });
    }
    return None;
}

pub fn arities(funcs: List<Func>) -> List<Arity> {
    return match (funcs) {
        Nil -> empty(),
        Cons(func, rest) -> cons(Arity { params: func.params, results: func.results }, arities(unbox(rest))),
    };
}

pub fn compile_funcs(arities: List<Arity>, funcs: List<Func>) -> core::option::Option<List<Code>> {
    return match (funcs) {
        Nil -> Some(empty()),
        Cons(func, rest) -> match (compile_func(arities, func)) {
            None -> None,
            Some(code) -> match (compile_funcs(arities, unbox(rest))) {
                None -> None,
                Some(codes) -> Some(cons(code, codes)),
            },
        },
    };
}

// Assembly. Jumps are relative to the end of the instruction. A call copies
// its arguments to just below the return address it pushes, which is where
// the callee's prologue puts its parameter slots.

// Little-endian bytes of a 32-bit field.
pub fn le32(value: i32) -> List<u8> {
    let bits: u32 = value as u32;
    return cons(bits as u8, cons((bits >> 8) as u8, cons((bits >> 16) as u8, single((bits >> 24) as u8))));
}

// Little-endian bytes of a 64-bit field.
pub fn le64(value: u64) -> List<u8> {
    return cons(value as u8, cons((value >> 8) as u8, cons((value >> 16) as u8, cons((value >> 24) as u8, cons((value >> 32) as u8, cons((value >> 40) as u8, cons((value >> 48) as u8, single((value >> 56) as u8))))))));
}

// rbp-relative displacement of a frame slot.
pub fn slot_offset(slot: usize) -> i32 {
    return 0 - (times(plus(slot, 1), 8) as i32);
}

// mov rax, [rbp + disp32]
pub fn slot_load(slot: usize) -> List<u8> {
    return concat(cons(72, cons(139, single(133))), le32(slot_offset(slot)));
}

// mov [rbp + disp32], rax
pub fn slot_store(slot: usize) -> List<u8> {
    return concat(cons(72, cons(137, single(133))), le32(slot_offset(slot)));
}

// mov rcx, rax; mov rax, [slot]
pub fn slot_operands(slot: usize) -> List<u8> {
    return concat(cons(72, cons(137, single(193))), slot_load(slot));
}

impl Word {
    // The REX.W prefix of a U64 operation.
    pub fn rex(self) -> List<u8> {
        return match (self) {
            S32 -> empty(),
            U64 -> single(72),
        };
    }
}

impl BinOp {
    // op eax, ecx without its prefix
    pub fn opcode(self) -> List<u8> {
        return match (self) {
            Add -> cons(1, single(200)),
            Sub -> cons(41, single(200)),
            Mul -> cons(15, cons(175, single(193))),
            And -> cons(33, single(200)),
            Or -> cons(9, single(200)),
            Xor -> cons(49, single(200)),
        };
    }

    // slot_operands, then op eax, ecx or op rax, rcx
    pub fn bytes(self, word: Word, slot: usize) -> List<u8> {
        return concat(slot_operands(slot), concat(word.rex(), self.opcode()));
    }
}

impl CmpOp {
    pub fn setcc_signed(self) -> u8 {
        return match (self) {
            Eq -> 148,
            Ne -> 149,
            Lt -> 156,
            Le -> 158,
            Gt -> 159,
            Ge -> 157,
        };
    }

    pub fn setcc_unsigned(self) -> u8 {
        return match (self) {
            Eq -> 148,
            Ne -> 149,
            Lt -> 146,
            Le -> 150,
            Gt -> 151,
            Ge -> 147,
        };
    }

    // The setcc opcode byte whose condition holds after cmp left, right
    // exactly when the comparison does: signed for S32, unsigned for U64.
    // (Two helpers: laniusc does not carry the u8 result type into a nested match.)
    pub fn setcc(self, word: Word) -> u8 {
        return match (word) {
            S32 -> self.setcc_signed(),
            U64 -> self.setcc_unsigned(),
        };
    }
}

// slot_operands; cmp eax, ecx or cmp rax, rcx; setcc al; movzx eax, al
pub fn slot_compare(word: Word, operation: CmpOp, slot: usize) -> List<u8> {
    return concat(concat(slot_operands(slot), concat(word.rex(), cons(57, single(200)))), cons(15, cons(operation.setcc(word), cons(192, cons(15, cons(182, single(192)))))));
}

// 2^shift as a 64-bit word.
pub fn pow2(shift: usize) -> u64 {
    if (shift == 0) {
        return 1;
    }
    let half: u64 = pow2(minus(shift, 1));
    return half + half;
}

// mov rcx, r13; mov r11, 2^shift - 1; add rcx, r11; mov r11, -2^shift;
// and rcx, r11 (rcx is the cursor rounded up); mov r11, rcx; add r11, rax;
// cmp r11, r14; jbe +2; ud2 (past the limit); mov r13, r11; mov rax, rcx
pub fn bump_bytes(shift: usize) -> List<u8> {
    let round: List<u8> = concat(concat(cons(76, cons(137, cons(233, cons(73, single(187))))), le64(pow2(shift) - 1)), cons(76, cons(1, cons(217, cons(73, single(187))))));
    let mask: List<u8> = concat(le64(0 - pow2(shift)), cons(76, cons(33, single(217))));
    let check: List<u8> = cons(73, cons(137, cons(203, cons(73, cons(1, cons(195, cons(77, cons(57, cons(243, cons(15, cons(134, cons(2, cons(0, cons(0, cons(0, cons(15, single(11)))))))))))))))));
    return concat(concat(concat(round, mask), check), cons(77, cons(137, cons(221, cons(72, cons(137, single(200)))))));
}

// add rax, r12; movzx eax, byte [rax + 0]
pub fn load_at_bytes() -> List<u8> {
    return cons(76, cons(1, cons(224, cons(15, cons(182, cons(128, cons(0, cons(0, cons(0, single(0))))))))));
}

// mov rcx, [rbp + disp32]; add rcx, r12; mov [rcx + 0], al
pub fn store_at_bytes(slot: usize) -> List<u8> {
    return concat(concat(cons(72, cons(139, single(141))), le32(slot_offset(slot))), cons(76, cons(1, cons(225, cons(136, cons(129, cons(0, cons(0, cons(0, single(0))))))))));
}

// add rax, r12; mov eax, [rax + 0] (rax with REX.W)
pub fn load_word_bytes(width: MemWidth) -> List<u8> {
    return cons(76, cons(1, cons(224, concat(width.rex(), cons(139, cons(128, cons(0, cons(0, cons(0, single(0))))))))));
}

// mov rcx, [rbp + disp32]; add rcx, r12; mov [rcx + 0], eax (rax with REX.W)
pub fn store_word_bytes(width: MemWidth, slot: usize) -> List<u8> {
    return concat(concat(cons(72, cons(139, single(141))), le32(slot_offset(slot))), cons(76, cons(1, cons(225, concat(width.rex(), cons(137, cons(129, cons(0, cons(0, cons(0, single(0)))))))))));
}

// mov rsp, rbp; pop rbp; ret
pub fn epilogue() -> List<u8> {
    return cons(72, cons(137, cons(236, cons(93, single(195)))));
}

// Frame bytes below rbp, a multiple of 16.
pub fn frame_size(slots: usize) -> usize {
    return times(plus(slots, 1) / 2, 16);
}

// push rbp; mov rbp, rsp; mov r11d, frame_size; sub rsp, r11
pub fn prologue(slots: usize) -> List<u8> {
    return concat(concat(cons(85, cons(72, cons(137, cons(229, cons(65, single(187)))))), le32(frame_size(slots) as i32)), cons(76, cons(41, single(220))));
}

// The rel32 field of a transfer from the end of an instruction at source to target.
pub fn relative(source: usize, target: usize) -> i32 {
    return (target as i32) - (source as i32);
}

// Where a function's code sits in the program image.
pub struct Place {
    // Image offset of the body's first instruction.
    body: usize,
    // The function's frame slots.
    slots: usize,
    // Image offset of every function's entry.
    entries: List<usize>,
}

// The caller's virtual slot that is the callee's parameter 0: the slot just
// below the return address the call pushes.
pub fn arg_base(slots: usize) -> usize {
    return plus(frame_size(slots) / 8, 2);
}

// slot, slot + 1, ..., count of them.
pub fn slot_range(slot: usize, count: usize) -> List<usize> {
    if (count == 0) {
        return empty();
    }
    return cons(slot, slot_range(plus(slot, 1), minus(count, 1)));
}

// Copy argument slots args to virtual slots first + k, first + k + 1, ...
pub fn copy_bytes(first: usize, args: List<usize>, k: usize) -> List<u8> {
    return match (args) {
        Nil -> empty(),
        Cons(slot, rest) -> concat(concat(slot_load(slot), slot_store(plus(first, k))), copy_bytes(first, unbox(rest), plus(k, 1))),
    };
}

impl Instr {
    // The bytes of the instruction at body offset pc.
    pub fn encode(self, place: Place, pc: usize) -> List<u8> {
        return match (self) {
            Imm(value) -> cons(72, cons(184, le64(value))),
            Load(slot) -> slot_load(slot),
            Store(slot) -> slot_store(slot),
            Instr::Neg -> cons(247, single(216)),
            Op(word, operation, slot) -> operation.bytes(word, slot),
            Cmp(word, operation, slot) -> slot_compare(word, operation, slot),
            Jmp(target) -> cons(233, le32(relative(plus(pc, 5), target))),
            Jz(target) -> concat(cons(72, cons(133, cons(192, cons(15, single(132))))), le32(relative(plus(pc, 9), target))),
            Instr::Call(callee, args, target, count) -> concat(concat(copy_bytes(arg_base(place.slots), args, 0), cons(232, le32(relative(plus(plus(plus(place.body, pc), times(14, length(args))), 5), get_or(place.entries, callee, 0))))), copy_bytes(target, slot_range(arg_base(place.slots), count), 0)),
            Instr::Ret(sources) -> concat(copy_bytes(0, sources, 0), epilogue()),
            Bump(shift) -> bump_bytes(shift),
            LoadAt -> load_at_bytes(),
            StoreAt(slot) -> store_at_bytes(slot),
            LoadWordAt(width) -> load_word_bytes(width),
            StoreWordAt(width, slot) -> store_word_bytes(width, slot),
        };
    }
}

pub fn encode_from(place: Place, pc: usize, code: List<Instr>) -> List<u8> {
    return match (code) {
        Nil -> empty(),
        Cons(i, rest) -> concat(i.encode(place, pc), encode_from(place, plus(pc, i.size()), unbox(rest))),
    };
}

// A program image is its functions back to back, each the frame prologue
// followed by its body.
impl Code {
    pub fn size(self) -> usize {
        return plus(13, code_size(self.instrs));
    }

    pub fn image(self, start: usize, entries: List<usize>) -> List<u8> {
        return concat(prologue(self.slots), encode_from(Place { body: plus(start, 13), slots: self.slots, entries: entries }, 0, self.instrs));
    }
}

// Entry offsets of functions laid out back to back from start.
pub fn layout(start: usize, codes: List<Code>) -> List<usize> {
    return match (codes) {
        Nil -> empty(),
        Cons(code, rest) -> cons(start, layout(plus(start, code.size()), unbox(rest))),
    };
}

pub fn link_from(entries: List<usize>, start: usize, codes: List<Code>) -> List<u8> {
    return match (codes) {
        Nil -> empty(),
        Cons(code, rest) -> concat(code.image(start, entries), link_from(entries, plus(start, code.size()), unbox(rest))),
    };
}

// Machine code of a compiled program.
pub struct Binary {
    codes: List<Code>,
    entries: List<usize>,
    image: List<u8>,
}

// Images are small enough for every rel32 displacement.
pub fn image_limit() -> usize {
    return 1073741824;
}

pub fn compile_program(prog: Program) -> core::option::Option<Binary> {
    return match (compile_funcs(arities(prog.funcs), prog.funcs)) {
        None -> None,
        Some(codes) -> link(codes),
    };
}

// extract: inline
fn link(codes: List<Code>) -> core::option::Option<Binary> {
    let entries: List<usize> = layout(0, codes);
    let image: List<u8> = link_from(entries, 0, codes);
    if (image_limit() >= length(image)) {
        return Some(Binary { codes: codes, entries: entries, image: image });
    }
    return None;
}

// Source programs: the subset of Lanius Core (formal/Lanius/Core.lean) that
// this compiler accepts. Lanius/Mini/Source.lean gives each its Core program,
// and the top-level theorem is about Core's evaluator on that program.
// Locals are Core variable ids; functions are numbered by position. A struct
// type carries its Core type id and its field types; an enum type carries its
// Core type id and each variant's payload types. Fields and payloads have
// any of these types.

// An unsigned integer type. A value sits zero-extended in its slot.
pub enum UintTy { Uint8, Uint32, Uint64, Usize, }

impl UintTy {
    // Its index, for comparing types.
    pub fn code(self) -> usize {
        return match (self) {
            Uint8 -> 0,
            Uint32 -> 1,
            Uint64 -> 2,
            Usize -> 3,
        };
    }

    // The largest value, 2^width - 1.
    pub fn mask(self) -> u64 {
        return match (self) {
            Uint8 -> 255,
            Uint32 -> 4294967295,
            Uint64 -> 18446744073709551615,
            Usize -> 18446744073709551615,
        };
    }

    // 64 bits wide, so slot arithmetic wraps the same way.
    pub fn is_wide(self) -> bool {
        return match (self) {
            Uint8 -> false,
            Uint32 -> false,
            Uint64 -> true,
            Usize -> true,
        };
    }
}

pub enum SrcType {
    I32,
    Bool,
    Uint(UintTy),
    Struct(usize, Box<List<SrcType>>),
    Enum(usize, Box<List<List<SrcType>>>),
    // a raw pointer into the heap
    Ptr,
}

pub enum SrcOp {
    Plus, Minus, Times, BitAnd, BitOr, BitXor,
    Less, LessEq, Greater, GreaterEq, Equal, NotEqual,
    LogicalAnd, LogicalOr,
}

pub enum SrcExpr {
    Int(i32),
    Boolean(bool),
    // a literal of an unsigned type
    Unsigned(UintTy, u64),
    Local(usize),
    // field of a struct local
    Field(usize, usize),
    Negate(Box<SrcExpr>),
    Not(Box<SrcExpr>),
    Apply(SrcOp, Box<SrcExpr>, Box<SrcExpr>),
    // between i32 and the unsigned types, wrapping like Core
    Cast(SrcType, Box<SrcExpr>),
}

// A match arm: the binders of its variant's payload, and its value.
pub struct SrcArm {
    binders: List<usize>,
    value: SrcExpr,
}

pub enum SrcStmt {
    Nop,
    // let id: ty = value; then body, with id in scope. A struct value is a
    // struct local.
    Let(usize, SrcType, SrcExpr, Box<SrcStmt>),
    // let id: ty = ty { fields }; then body
    LetStruct(usize, SrcType, List<SrcExpr>, Box<SrcStmt>),
    // let id: ty = callee(args); then body
    LetCall(usize, SrcType, usize, List<SrcExpr>, Box<SrcStmt>),
    // let id: ty = variant(payload) of the enum type ty; then body
    LetEnum(usize, SrcType, usize, List<SrcExpr>, Box<SrcStmt>),
    // let id: ty = match scrutinee { arms }; then body. The scrutinee is a
    // local of the enum type with Core id enum_id, and arm k is variant k.
    LetMatch(usize, SrcType, usize, usize, List<SrcArm>, Box<SrcStmt>),
    Set(usize, SrcExpr),
    // id.field = value
    SetField(usize, usize, SrcExpr),
    // id = callee(args)
    SetCall(usize, usize, List<SrcExpr>),
    Then(Box<SrcStmt>, Box<SrcStmt>),
    If(SrcExpr, Box<SrcStmt>, Box<SrcStmt>),
    While(SrcExpr, Box<SrcStmt>),
    Return(SrcExpr),
    // let id: ptr = alloc(size, 2^shift); then body
    LetAlloc(usize, SrcExpr, usize, Box<SrcStmt>),
    // let id: u8 = load_byte(pointer, offset); then body
    LetLoad(usize, SrcExpr, SrcExpr, Box<SrcStmt>),
    // store_byte(pointer, offset, value)
    SetByte(SrcExpr, SrcExpr, SrcExpr),
    // dealloc(pointer, size, 2^shift)
    Free(SrcExpr, SrcExpr, usize),
}

pub struct SrcParam {
    id: usize,
    ty: SrcType,
}

pub struct SrcFunc {
    params: List<SrcParam>,
    ret: SrcType,
    body: SrcStmt,
}

pub struct SrcProgram {
    funcs: List<SrcFunc>,
}

// Lowering to the language above. It also type-checks: an ill-typed program
// is rejected, so the theorem needs no typing premise (Core would, for
// example, evaluate true && 5 to 5). A Core local becomes a frame slot: a
// function's parameters are slots 0, 1, ..., and each let takes the next slot
// for its body; a struct takes one slot per field. Booleans are 1 and 0.
// Subset expressions neither trap nor have
// effects, so && and || need no short circuit: a && b is a & b on 0 and 1, and
// a || b is (a | b) != 0.

pub struct Binding {
    id: usize,
    slot: usize,
    ty: SrcType,
}

// The innermost binding of id.
pub fn lookup(scope: List<Binding>, id: usize) -> core::option::Option<Binding> {
    return match (scope) {
        Nil -> None,
        Cons(binding, rest) -> lookup_at(binding, unbox(rest), id),
    };
}

// extract: inline
fn lookup_at(binding: Binding, rest: List<Binding>, id: usize) -> core::option::Option<Binding> {
    if (binding.id == id) {
        return Some(binding);
    }
    return lookup(rest, id);
}

pub fn bool_bits(value: bool) -> u64 {
    if (value) {
        return 1;
    }
    return 0;
}

impl SrcType {
    pub fn is_i32(self) -> bool {
        return match (self) {
            I32 -> true,
            Bool -> false,
            Uint(kind) -> false,
            Struct(id, fields) -> false,
            Enum(id, variants) -> false,
            Ptr -> false,
        };
    }

    pub fn is_bool(self) -> bool {
        return match (self) {
            I32 -> false,
            Bool -> true,
            Uint(kind) -> false,
            Struct(id, fields) -> false,
            Enum(id, variants) -> false,
            Ptr -> false,
        };
    }

    pub fn is_scalar(self) -> bool {
        return match (self) {
            I32 -> true,
            Bool -> true,
            Uint(kind) -> true,
            Struct(id, fields) -> false,
            Enum(id, variants) -> false,
            Ptr -> true,
        };
    }

    pub fn is_uint(self, kind: UintTy) -> bool {
        return match (self) {
            I32 -> false,
            Bool -> false,
            Uint(other) -> other.code() == kind.code(),
            Struct(id, fields) -> false,
            Enum(id, variants) -> false,
            Ptr -> false,
        };
    }

    pub fn is_ptr(self) -> bool {
        return match (self) {
            I32 -> false,
            Bool -> false,
            Uint(kind) -> false,
            Struct(id, fields) -> false,
            Enum(id, variants) -> false,
            Ptr -> true,
        };
    }

    // The unsigned type this is, if it is one.
    pub fn uint_kind(self) -> core::option::Option<UintTy> {
        return match (self) {
            I32 -> None,
            Bool -> None,
            Uint(kind) -> Some(kind),
            Struct(id, fields) -> None,
            Enum(id, variants) -> None,
            Ptr -> None,
        };
    }

    // How a comparison of two values of this type reads their slots.
    pub fn word(self) -> Word {
        return match (self) {
            I32 -> S32,
            Bool -> S32,
            Uint(kind) -> U64,
            Struct(id, fields) -> S32,
            Enum(id, variants) -> S32,
            Ptr -> U64,
        };
    }
}

// extract: mutual begin
impl SrcType {
    pub fn same(self, other: SrcType) -> bool {
        return match (self) {
            I32 -> other.is_i32(),
            Bool -> other.is_bool(),
            Uint(kind) -> other.is_uint(kind),
            Struct(id, fields) -> match (other) {
                I32 -> false,
                Bool -> false,
                Uint(other_kind) -> false,
                Struct(other_id, other_fields) -> (id == other_id) && types_same(unbox(fields), unbox(other_fields)),
                Enum(other_id, other_variants) -> false,
                Ptr -> false,
            },
            Enum(id, variants) -> match (other) {
                I32 -> false,
                Bool -> false,
                Uint(other_kind) -> false,
                Struct(other_id, other_fields) -> false,
                Enum(other_id, other_variants) -> (id == other_id) && variants_same(unbox(variants), unbox(other_variants)),
                Ptr -> false,
            },
            Ptr -> other.is_ptr(),
        };
    }
}

pub fn types_same(types: List<SrcType>, others: List<SrcType>) -> bool {
    return match (types) {
        Nil -> match (others) {
            Nil -> true,
            Cons(other, more) -> false,
        },
        Cons(ty, rest) -> match (others) {
            Nil -> false,
            Cons(other, more) -> ty.same(other) && types_same(unbox(rest), unbox(more)),
        },
    };
}

pub fn variants_same(variants: List<List<SrcType>>, others: List<List<SrcType>>) -> bool {
    return match (variants) {
        Nil -> match (others) {
            Nil -> true,
            Cons(other, more) -> false,
        },
        Cons(types, rest) -> match (others) {
            Nil -> false,
            Cons(other, more) -> types_same(types, other) && variants_same(unbox(rest), unbox(more)),
        },
    };
}
// extract: mutual end

// extract: mutual begin
impl SrcType {
    // Slots a value of this type takes: a struct's fields in order; an enum's
    // tag, then room for its largest payload.
    pub fn size(self) -> usize {
        return match (self) {
            I32 -> 1,
            Bool -> 1,
            Uint(kind) -> 1,
            Struct(id, fields) -> sizes(unbox(fields)),
            Enum(id, variants) -> plus(1, max_size(unbox(variants))),
            Ptr -> 1,
        };
    }
}

pub fn sizes(types: List<SrcType>) -> usize {
    return match (types) {
        Nil -> 0,
        Cons(ty, rest) -> plus(ty.size(), sizes(unbox(rest))),
    };
}

// The largest payload.
pub fn max_size(variants: List<List<SrcType>>) -> usize {
    return match (variants) {
        Nil -> 0,
        Cons(types, rest) -> max_of(sizes(types), max_size(unbox(rest))),
    };
}
// extract: mutual end

// The slot of field index, counted from the struct's first slot.
pub fn field_offset(types: List<SrcType>, index: usize) -> usize {
    return match (types) {
        Nil -> 0,
        Cons(ty, rest) -> offset_after(ty, unbox(rest), index),
    };
}

// extract: inline
fn offset_after(ty: SrcType, rest: List<SrcType>, index: usize) -> usize {
    if (index == 0) {
        return 0;
    }
    return plus(ty.size(), field_offset(rest, minus(index, 1)));
}

// A lowered expression and its source type.
pub struct Typed {
    expr: Expr,
    ty: SrcType,
}

// e reduced to the width of kind.
pub fn wrap(kind: UintTy, e: Expr) -> Expr {
    if (kind.is_wide()) {
        return e;
    }
    return Binary(U64, And, boxed(e), boxed(Lit(kind.mask())));
}

pub fn arith_uint(operation: BinOp, left: Typed, right: Typed, kind: core::option::Option<UintTy>) -> core::option::Option<Typed> {
    return match (kind) {
        None -> None,
        Some(k) -> arith_of(operation, left, right, k),
    };
}

// extract: inline
fn arith_of(operation: BinOp, left: Typed, right: Typed, k: UintTy) -> core::option::Option<Typed> {
    if (right.ty.is_uint(k)) {
        return Some(Typed { expr: wrap(k, Binary(U64, operation, boxed(left.expr), boxed(right.expr))), ty: Uint(k) });
    }
    return None;
}

pub fn arith(operation: BinOp, left: Typed, right: Typed) -> core::option::Option<Typed> {
    if (left.ty.is_i32() && right.ty.is_i32()) {
        return Some(Typed { expr: Binary(S32, operation, boxed(left.expr), boxed(right.expr)), ty: I32 });
    }
    return arith_uint(operation, left, right, left.ty.uint_kind());
}

pub fn order_uint(operation: CmpOp, left: Typed, right: Typed, kind: core::option::Option<UintTy>) -> core::option::Option<Typed> {
    return match (kind) {
        None -> None,
        Some(k) -> order_of(operation, left, right, k),
    };
}

// extract: inline
fn order_of(operation: CmpOp, left: Typed, right: Typed, k: UintTy) -> core::option::Option<Typed> {
    if (right.ty.is_uint(k)) {
        return Some(Typed { expr: Compare(U64, operation, boxed(left.expr), boxed(right.expr)), ty: Bool });
    }
    return None;
}

pub fn order(operation: CmpOp, left: Typed, right: Typed) -> core::option::Option<Typed> {
    if (left.ty.is_i32() && right.ty.is_i32()) {
        return Some(Typed { expr: Compare(S32, operation, boxed(left.expr), boxed(right.expr)), ty: Bool });
    }
    return order_uint(operation, left, right, left.ty.uint_kind());
}

pub fn equality(operation: CmpOp, left: Typed, right: Typed) -> core::option::Option<Typed> {
    if (left.ty.same(right.ty)) {
        return Some(Typed { expr: Compare(left.ty.word(), operation, boxed(left.expr), boxed(right.expr)), ty: Bool });
    }
    return None;
}

pub fn conjunction(left: Typed, right: Typed) -> core::option::Option<Typed> {
    if (left.ty.is_bool() && right.ty.is_bool()) {
        return Some(Typed { expr: Binary(S32, And, boxed(left.expr), boxed(right.expr)), ty: Bool });
    }
    return None;
}

pub fn disjunction(left: Typed, right: Typed) -> core::option::Option<Typed> {
    if (left.ty.is_bool() && right.ty.is_bool()) {
        let either: Expr = Binary(S32, Or, boxed(left.expr), boxed(right.expr));
        return Some(Typed { expr: Compare(S32, Ne, boxed(either), boxed(Lit(0))), ty: Bool });
    }
    return None;
}

impl SrcOp {
    pub fn lower(self, left: Typed, right: Typed) -> core::option::Option<Typed> {
        return match (self) {
            Plus -> arith(Add, left, right),
            Minus -> arith(Sub, left, right),
            Times -> arith(Mul, left, right),
            BitAnd -> arith(And, left, right),
            BitOr -> arith(Or, left, right),
            BitXor -> arith(Xor, left, right),
            Less -> order(Lt, left, right),
            LessEq -> order(Le, left, right),
            Greater -> order(Gt, left, right),
            GreaterEq -> order(Ge, left, right),
            Equal -> equality(Eq, left, right),
            NotEqual -> equality(Ne, left, right),
            LogicalAnd -> conjunction(left, right),
            LogicalOr -> disjunction(left, right),
        };
    }
}

pub fn lower_scalar_local(b: Binding) -> core::option::Option<Typed> {
    if (b.ty.is_scalar()) {
        return Some(Typed { expr: Var(b.slot), ty: b.ty });
    }
    return None;
}

pub fn lower_local(binding: core::option::Option<Binding>) -> core::option::Option<Typed> {
    return match (binding) {
        None -> None,
        Some(b) -> lower_scalar_local(b),
    };
}

// A field read is a scalar field's slot.
pub fn lower_field_at(slot: usize, found: core::option::Option<SrcType>) -> core::option::Option<Typed> {
    return match (found) {
        None -> None,
        Some(ty) -> lower_scalar_slot(slot, ty),
    };
}

// extract: inline
fn lower_scalar_slot(slot: usize, ty: SrcType) -> core::option::Option<Typed> {
    if (ty.is_scalar()) {
        return Some(Typed { expr: Var(slot), ty: ty });
    }
    return None;
}

pub fn lower_field_of(b: Binding, field: usize) -> core::option::Option<Typed> {
    return match (b.ty) {
        I32 -> None,
        Bool -> None,
        Uint(kind) -> None,
        Struct(id, fields) -> lower_field_at(plus(b.slot, field_offset(unbox(fields), field)), get(unbox(fields), field)),
        Enum(id, variants) -> None,
        Ptr -> None,
    };
}

pub fn lower_field(binding: core::option::Option<Binding>, field: usize) -> core::option::Option<Typed> {
    return match (binding) {
        None -> None,
        Some(b) -> lower_field_of(b, field),
    };
}

pub fn lower_negate_typed(operand: Typed) -> core::option::Option<Typed> {
    if (operand.ty.is_i32()) {
        return Some(Typed { expr: Expr::Neg(boxed(operand.expr)), ty: I32 });
    }
    return None;
}

pub fn lower_negate(operand: core::option::Option<Typed>) -> core::option::Option<Typed> {
    return match (operand) {
        None -> None,
        Some(e) -> lower_negate_typed(e),
    };
}

pub fn lower_not_typed(operand: Typed) -> core::option::Option<Typed> {
    if (operand.ty.is_bool()) {
        return Some(Typed { expr: Compare(S32, Eq, boxed(operand.expr), boxed(Lit(0))), ty: Bool });
    }
    return None;
}

pub fn lower_not(operand: core::option::Option<Typed>) -> core::option::Option<Typed> {
    return match (operand) {
        None -> None,
        Some(e) -> lower_not_typed(e),
    };
}

pub fn lower_unsigned(kind: UintTy, value: u64) -> core::option::Option<Typed> {
    if (value <= kind.mask()) {
        return Some(Typed { expr: Lit(value), ty: Uint(kind) });
    }
    return None;
}

// An i32's bits as a value of kind: the low bits, or for 64 bits
// sign-extended (minus 2^32 when the sign bit is set).
pub fn from_i32(kind: UintTy, e: Expr) -> Expr {
    if (kind.is_wide()) {
        let negative: Expr = Compare(U64, Ge, boxed(e), boxed(Lit(2147483648)));
        return Binary(U64, Sub, boxed(e), boxed(Binary(U64, Mul, boxed(negative), boxed(Lit(4294967296)))));
    }
    return wrap(kind, e);
}

pub fn cast_to_i32(e: Typed) -> core::option::Option<Typed> {
    return match (e.ty) {
        I32 -> Some(e),
        Bool -> None,
        Uint(kind) -> Some(Typed { expr: wrap(Uint32, e.expr), ty: I32 }),
        Struct(id, fields) -> None,
        Enum(id, variants) -> None,
        Ptr -> None,
    };
}

pub fn cast_to_uint(kind: UintTy, e: Typed) -> core::option::Option<Typed> {
    return match (e.ty) {
        I32 -> Some(Typed { expr: from_i32(kind, e.expr), ty: Uint(kind) }),
        Bool -> None,
        Uint(source) -> Some(Typed { expr: wrap(kind, e.expr), ty: Uint(kind) }),
        Struct(id, fields) -> None,
        Enum(id, variants) -> None,
        Ptr -> None,
    };
}

pub fn cast_to(ty: SrcType, e: Typed) -> core::option::Option<Typed> {
    return match (ty) {
        I32 -> cast_to_i32(e),
        Bool -> None,
        Uint(kind) -> cast_to_uint(kind, e),
        Struct(id, fields) -> None,
        Enum(id, variants) -> None,
        Ptr -> None,
    };
}

pub fn lower_cast(ty: SrcType, operand: core::option::Option<Typed>) -> core::option::Option<Typed> {
    return match (operand) {
        None -> None,
        Some(e) -> cast_to(ty, e),
    };
}

pub fn lower_apply(op: SrcOp, left: core::option::Option<Typed>, right: core::option::Option<Typed>) -> core::option::Option<Typed> {
    return match (left) {
        None -> None,
        Some(l) -> match (right) {
            None -> None,
            Some(r) -> op.lower(l, r),
        },
    };
}

impl SrcExpr {
    pub fn lower(self, scope: List<Binding>) -> core::option::Option<Typed> {
        return match (self) {
            Int(value) -> Some(Typed { expr: Lit((value as u32) as u64), ty: I32 }),
            Boolean(value) -> Some(Typed { expr: Lit(bool_bits(value)), ty: Bool }),
            Unsigned(kind, value) -> lower_unsigned(kind, value),
            Local(id) -> lower_local(lookup(scope, id)),
            Field(id, index) -> lower_field(lookup(scope, id), index),
            Negate(operand) -> lower_negate(unbox(operand).lower(scope)),
            Not(operand) -> lower_not(unbox(operand).lower(scope)),
            Apply(op, left, right) -> lower_apply(op, unbox(left).lower(scope), unbox(right).lower(scope)),
            Cast(ty, operand) -> lower_cast(ty, unbox(operand).lower(scope)),
        };
    }
}

pub fn expect_type(typed: Typed, ty: SrcType) -> core::option::Option<Expr> {
    if (typed.ty.same(ty)) {
        return Some(typed.expr);
    }
    return None;
}

// The expression, if it lowers and has type ty.
pub fn lower_as(scope: List<Binding>, e: SrcExpr, ty: SrcType) -> core::option::Option<Expr> {
    return match (e.lower(scope)) {
        None -> None,
        Some(typed) -> expect_type(typed, ty),
    };
}

pub fn lower_append(first: core::option::Option<List<Expr>>, rest: core::option::Option<List<Expr>>) -> core::option::Option<List<Expr>> {
    return match (first) {
        None -> None,
        Some(es) -> match (rest) {
            None -> None,
            Some(more) -> Some(concat(es, more)),
        },
    };
}

// Var(slot), Var(slot + 1), ..., count of them.
pub fn slot_vars(slot: usize, count: usize) -> List<Expr> {
    if (count == 0) {
        return empty();
    }
    return cons(Var(slot), slot_vars(plus(slot, 1), minus(count, 1)));
}

pub fn copy_binding(binding: core::option::Option<Binding>, ty: SrcType) -> core::option::Option<List<Expr>> {
    return match (binding) {
        None -> None,
        Some(b) -> copy_same(b, ty),
    };
}

// extract: inline
fn copy_same(b: Binding, ty: SrcType) -> core::option::Option<List<Expr>> {
    if (b.ty.same(ty)) {
        return Some(slot_vars(b.slot, b.ty.size()));
    }
    return None;
}

// extract: inline
fn copy_slots(slot: usize, field: SrcType, ty: SrcType) -> core::option::Option<List<Expr>> {
    if (field.same(ty) && (field.size() > 0)) {
        return Some(slot_vars(slot, field.size()));
    }
    return None;
}

pub fn copy_field_at(slot: usize, found: core::option::Option<SrcType>, ty: SrcType) -> core::option::Option<List<Expr>> {
    return match (found) {
        None -> None,
        Some(field) -> copy_slots(slot, field, ty),
    };
}

pub fn copy_field_of(b: Binding, index: usize, ty: SrcType) -> core::option::Option<List<Expr>> {
    return match (b.ty) {
        I32 -> None,
        Bool -> None,
        Uint(kind) -> None,
        Struct(id, fields) -> copy_field_at(plus(b.slot, field_offset(unbox(fields), index)), get(unbox(fields), index), ty),
        Enum(id, variants) -> None,
        Ptr -> None,
    };
}

// A field of type ty of a struct local, slot by slot. It takes slots.
pub fn copy_field(binding: core::option::Option<Binding>, index: usize, ty: SrcType) -> core::option::Option<List<Expr>> {
    return match (binding) {
        None -> None,
        Some(b) -> copy_field_of(b, index, ty),
    };
}

// An aggregate value: a local or a field of that type, slot by slot.
pub fn lower_copy(scope: List<Binding>, e: SrcExpr, ty: SrcType) -> core::option::Option<List<Expr>> {
    return match (e) {
        Int(value) -> None,
        Boolean(value) -> None,
        Unsigned(kind, value) -> None,
        Local(id) -> copy_binding(lookup(scope, id), ty),
        Field(id, index) -> copy_field(lookup(scope, id), index, ty),
        Negate(operand) -> None,
        Not(operand) -> None,
        Apply(op, left, right) -> None,
        Cast(target, operand) -> None,
    };
}

pub fn lower_single(value: core::option::Option<Expr>) -> core::option::Option<List<Expr>> {
    return match (value) {
        None -> None,
        Some(x) -> Some(single(x)),
    };
}

// A value of type ty, one expression per slot.
pub fn lower_value(scope: List<Binding>, e: SrcExpr, ty: SrcType) -> core::option::Option<List<Expr>> {
    if (ty.is_scalar()) {
        return lower_single(lower_as(scope, e, ty));
    }
    return lower_copy(scope, e, ty);
}

// The arguments, if there is one of each parameter type, slot by slot.
pub fn lower_args(scope: List<Binding>, args: List<SrcExpr>, types: List<SrcType>) -> core::option::Option<List<Expr>> {
    return match (args) {
        Nil -> match (types) {
            Nil -> Some(empty()),
            Cons(ty, more) -> None,
        },
        Cons(arg, rest) -> match (types) {
            Nil -> None,
            Cons(ty, more) -> lower_append(lower_value(scope, arg, ty), lower_args(scope, unbox(rest), unbox(more))),
        },
    };
}

// A struct literal's fields are like arguments, one of each field type.
// A struct value takes slots, so every binding has its own.
pub fn lower_struct_fields(scope: List<Binding>, fields: List<SrcExpr>, types: List<SrcType>) -> core::option::Option<List<Expr>> {
    if (sizes(types) == 0) {
        return None;
    }
    return lower_args(scope, fields, types);
}

pub fn lower_literal(scope: List<Binding>, ty: SrcType, fields: List<SrcExpr>) -> core::option::Option<List<Expr>> {
    return match (ty) {
        I32 -> None,
        Bool -> None,
        Uint(kind) -> None,
        Struct(id, types) -> lower_struct_fields(scope, fields, unbox(types)),
        Enum(id, variants) -> None,
        Ptr -> None,
    };
}

pub fn lower_tag(variant: usize, payload: core::option::Option<List<Expr>>) -> core::option::Option<List<Expr>> {
    return match (payload) {
        None -> None,
        Some(es) -> Some(cons(Lit(variant as u64), es)),
    };
}

pub fn lower_variant(scope: List<Binding>, variant: usize, found: core::option::Option<List<SrcType>>, payload: List<SrcExpr>) -> core::option::Option<List<Expr>> {
    return match (found) {
        None -> None,
        Some(types) -> lower_tag(variant, lower_args(scope, payload, types)),
    };
}

// Tags are 32-bit, so an enum has fewer than 2^32 variants.
pub fn lower_tagged(scope: List<Binding>, variants: List<List<SrcType>>, variant: usize, payload: List<SrcExpr>) -> core::option::Option<List<Expr>> {
    if (length(variants) < 4294967296) {
        return lower_variant(scope, variant, get(variants, variant), payload);
    }
    return None;
}

// An enum value: its tag, then the variant's payload. Slots past the payload
// are left as they are.
pub fn lower_enum_value(scope: List<Binding>, ty: SrcType, variant: usize, payload: List<SrcExpr>) -> core::option::Option<List<Expr>> {
    return match (ty) {
        I32 -> None,
        Bool -> None,
        Uint(kind) -> None,
        Struct(id, types) -> None,
        Enum(id, variants) -> lower_tagged(scope, unbox(variants), variant, payload),
        Ptr -> None,
    };
}

// The scope of an arm: each binder names its payload field's slots, binding
// in order as Core's bindLocals does. A binder takes slots, so no two share
// a first slot.
pub fn arm_scope(binders: List<usize>, types: List<SrcType>, slot: usize, scope: List<Binding>) -> core::option::Option<List<Binding>> {
    return match (binders) {
        Nil -> match (types) {
            Nil -> Some(scope),
            Cons(ty, more) -> None,
        },
        Cons(binder, rest) -> match (types) {
            Nil -> None,
            Cons(ty, more) -> arm_bind(binder, ty, unbox(rest), unbox(more), slot, scope),
        },
    };
}

// extract: inline
fn arm_bind(binder: usize, ty: SrcType, rest: List<usize>, more: List<SrcType>, slot: usize, scope: List<Binding>) -> core::option::Option<List<Binding>> {
    if (ty.size() > 0) {
        return arm_scope(rest, more, plus(slot, ty.size()), cons(Binding { id: binder, slot: slot, ty: ty }, scope));
    }
    return None;
}

// Assign values to slot, slot + 1, ..., then run rest.
pub fn assign_from(slot: usize, values: List<Expr>, rest: Stmt) -> Stmt {
    return match (values) {
        Nil -> rest,
        Cons(value, more) -> Seq(boxed(Assign(slot, value)), boxed(assign_from(plus(slot, 1), unbox(more), rest))),
    };
}

pub fn lower_arm_value(scope: core::option::Option<List<Binding>>, value: SrcExpr, ty: SrcType) -> core::option::Option<List<Expr>> {
    return match (scope) {
        None -> None,
        Some(s) -> lower_value(s, value, ty),
    };
}

// Arm k stores its value's slots from target; the last arm needs no tag test.
pub fn lower_arm(slot: usize, target: usize, k: usize, values: core::option::Option<List<Expr>>, rest: List<SrcArm>, others: core::option::Option<Stmt>) -> core::option::Option<Stmt> {
    return match (values) {
        None -> None,
        Some(vs) -> match (rest) {
            Nil -> Some(assign_from(target, vs, Skip)),
            Cons(arm, more) -> match (others) {
                None -> None,
                Some(o) -> Some(Ite(Compare(U64, Eq, boxed(Var(slot)), boxed(Lit(k as u64))), boxed(assign_from(target, vs, Skip)), boxed(o))),
            },
        },
    };
}

// Arms k, k + 1, ... of a match on the enum at slot, one per variant from k.
pub fn lower_arms(scope: List<Binding>, slot: usize, target: usize, ty: SrcType, k: usize, variants: List<List<SrcType>>, arms: List<SrcArm>) -> core::option::Option<Stmt> {
    return match (arms) {
        Nil -> None,
        Cons(arm, rest) -> match (variants) {
            Nil -> None,
            Cons(types, more) -> lower_arm(slot, target, k, lower_arm_value(arm_scope(arm.binders, types, plus(slot, 1), scope), arm.value, ty), unbox(rest), lower_arms(scope, slot, target, ty, plus(k, 1), unbox(more), unbox(rest))),
        },
    };
}

// The match is exhaustive, its value takes slots, and its tags fit in 32 bits.
pub fn lower_match_arms(scope: List<Binding>, slot: usize, same: bool, variants: List<List<SrcType>>, arms: List<SrcArm>, ty: SrcType, target: usize) -> core::option::Option<Stmt> {
    if (same && (ty.size() > 0) && (length(arms) == length(variants)) && (length(variants) < 4294967296)) {
        return lower_arms(scope, slot, target, ty, 0, variants, arms);
    }
    return None;
}

pub fn lower_match_on(scope: List<Binding>, b: Binding, enum_id: usize, arms: List<SrcArm>, ty: SrcType, target: usize) -> core::option::Option<Stmt> {
    return match (b.ty) {
        I32 -> None,
        Bool -> None,
        Uint(kind) -> None,
        Struct(id, types) -> None,
        Enum(id, variants) -> lower_match_arms(scope, b.slot, id == enum_id, unbox(variants), arms, ty, target),
        Ptr -> None,
    };
}

pub fn lower_match(scope: List<Binding>, binding: core::option::Option<Binding>, enum_id: usize, arms: List<SrcArm>, ty: SrcType, target: usize) -> core::option::Option<Stmt> {
    return match (binding) {
        None -> None,
        Some(b) -> lower_match_on(scope, b, enum_id, arms, ty, target),
    };
}


// A function's parameter types and result type.
pub struct Sig {
    params: List<SrcType>,
    ret: SrcType,
}

pub fn lower_call_sig(scope: List<Binding>, sig: Sig, args: List<SrcExpr>, ty: SrcType) -> core::option::Option<List<Expr>> {
    if (sig.ret.same(ty)) {
        return lower_args(scope, args, sig.params);
    }
    return None;
}

// The arguments of a call returning ty to callee.
pub fn lower_call(sigs: List<Sig>, scope: List<Binding>, callee: usize, args: List<SrcExpr>, ty: SrcType) -> core::option::Option<List<Expr>> {
    return match (get(sigs, callee)) {
        None -> None,
        Some(sig) -> lower_call_sig(scope, sig, args, ty),
    };
}

pub fn lower_let(slot: usize, values: core::option::Option<List<Expr>>, body: core::option::Option<Stmt>) -> core::option::Option<Stmt> {
    return match (values) {
        None -> None,
        Some(vs) -> match (body) {
            None -> None,
            Some(b) -> Some(assign_from(slot, vs, b)),
        },
    };
}

pub fn lower_let_call(slot: usize, count: usize, callee: usize, args: core::option::Option<List<Expr>>, body: core::option::Option<Stmt>) -> core::option::Option<Stmt> {
    return match (args) {
        None -> None,
        Some(a) -> match (body) {
            None -> None,
            Some(b) -> Some(Seq(boxed(Stmt::Call(slot, count, callee, a)), boxed(b))),
        },
    };
}

pub fn lower_set_values(slot: usize, values: core::option::Option<List<Expr>>) -> core::option::Option<Stmt> {
    return match (values) {
        None -> None,
        Some(vs) -> Some(assign_from(slot, vs, Skip)),
    };
}

pub fn lower_set(binding: core::option::Option<Binding>, scope: List<Binding>, value: SrcExpr) -> core::option::Option<Stmt> {
    return match (binding) {
        None -> None,
        Some(b) -> lower_set_values(b.slot, lower_value(scope, value, b.ty)),
    };
}

pub fn lower_set_value(slot: usize, value: core::option::Option<Expr>) -> core::option::Option<Stmt> {
    return match (value) {
        None -> None,
        Some(v) -> Some(Assign(slot, v)),
    };
}

// A field write stores a scalar field's slot.
pub fn lower_set_field_at(slot: usize, found: core::option::Option<SrcType>, scope: List<Binding>, value: SrcExpr) -> core::option::Option<Stmt> {
    return match (found) {
        None -> None,
        Some(ty) -> lower_set_scalar(slot, ty, scope, value),
    };
}

// extract: inline
fn lower_set_scalar(slot: usize, ty: SrcType, scope: List<Binding>, value: SrcExpr) -> core::option::Option<Stmt> {
    if (ty.is_scalar()) {
        return lower_set_value(slot, lower_as(scope, value, ty));
    }
    return None;
}

pub fn lower_set_field_of(b: Binding, field: usize, scope: List<Binding>, value: SrcExpr) -> core::option::Option<Stmt> {
    return match (b.ty) {
        I32 -> None,
        Bool -> None,
        Uint(kind) -> None,
        Struct(id, fields) -> lower_set_field_at(plus(b.slot, field_offset(unbox(fields), field)), get(unbox(fields), field), scope, value),
        Enum(id, variants) -> None,
        Ptr -> None,
    };
}

pub fn lower_set_field(binding: core::option::Option<Binding>, field: usize, scope: List<Binding>, value: SrcExpr) -> core::option::Option<Stmt> {
    return match (binding) {
        None -> None,
        Some(b) -> lower_set_field_of(b, field, scope, value),
    };
}

pub fn lower_set_call_args(slot: usize, count: usize, callee: usize, args: core::option::Option<List<Expr>>) -> core::option::Option<Stmt> {
    return match (args) {
        None -> None,
        Some(a) -> Some(Stmt::Call(slot, count, callee, a)),
    };
}

pub fn lower_set_call(sigs: List<Sig>, scope: List<Binding>, binding: core::option::Option<Binding>, callee: usize, args: List<SrcExpr>) -> core::option::Option<Stmt> {
    return match (binding) {
        None -> None,
        Some(b) -> lower_set_call_args(b.slot, b.ty.size(), callee, lower_call(sigs, scope, callee, args, b.ty)),
    };
}

pub fn lower_then(first: core::option::Option<Stmt>, second: core::option::Option<Stmt>) -> core::option::Option<Stmt> {
    return match (first) {
        None -> None,
        Some(a) -> match (second) {
            None -> None,
            Some(b) -> Some(Seq(boxed(a), boxed(b))),
        },
    };
}

pub fn lower_if(condition: core::option::Option<Expr>, then_branch: core::option::Option<Stmt>, else_branch: core::option::Option<Stmt>) -> core::option::Option<Stmt> {
    return match (condition) {
        None -> None,
        Some(c) -> match (then_branch) {
            None -> None,
            Some(t) -> match (else_branch) {
                None -> None,
                Some(e) -> Some(Ite(c, boxed(t), boxed(e))),
            },
        },
    };
}

pub fn lower_while(condition: core::option::Option<Expr>, body: core::option::Option<Stmt>) -> core::option::Option<Stmt> {
    return match (condition) {
        None -> None,
        Some(c) -> match (body) {
            None -> None,
            Some(b) -> Some(Loop(c, boxed(b))),
        },
    };
}

pub fn lower_return(values: core::option::Option<List<Expr>>) -> core::option::Option<Stmt> {
    return match (values) {
        None -> None,
        Some(vs) -> Some(Stmt::Ret(vs)),
    };
}

// The bump allocator's size: Core gives a block of size 0 one byte.
pub fn at_least_one(size: Expr) -> Expr {
    return Binary(U64, Add, boxed(size), boxed(Compare(U64, Eq, boxed(size), boxed(Lit(0)))));
}

pub fn lower_alloc(slot: usize, shift: usize, size: core::option::Option<Expr>, body: core::option::Option<Stmt>) -> core::option::Option<Stmt> {
    if (shift < 32) {
        return match (size) {
            None -> None,
            Some(s) -> match (body) {
                None -> None,
                Some(b) -> Some(Seq(boxed(Alloc(slot, shift, at_least_one(s))), boxed(b))),
            },
        };
    }
    return None;
}

// A pointer and a usize offset as an address.
pub fn lower_address(pointer: core::option::Option<Expr>, offset: core::option::Option<Expr>) -> core::option::Option<Expr> {
    return match (pointer) {
        None -> None,
        Some(p) -> match (offset) {
            None -> None,
            Some(o) -> Some(Binary(U64, Add, boxed(p), boxed(o))),
        },
    };
}

pub fn lower_load(slot: usize, address: core::option::Option<Expr>, body: core::option::Option<Stmt>) -> core::option::Option<Stmt> {
    return match (address) {
        None -> None,
        Some(a) -> match (body) {
            None -> None,
            Some(b) -> Some(Seq(boxed(LoadByte(slot, a)), boxed(b))),
        },
    };
}

pub fn lower_store(address: core::option::Option<Expr>, value: core::option::Option<Expr>) -> core::option::Option<Stmt> {
    return match (address) {
        None -> None,
        Some(a) -> match (value) {
            None -> None,
            Some(v) -> Some(StoreByte(a, v)),
        },
    };
}

// The bump allocator never frees, so a free only checks its operands' types.
pub fn lower_free(shift: usize, pointer: core::option::Option<Expr>, size: core::option::Option<Expr>) -> core::option::Option<Stmt> {
    if (shift < 32) {
        return match (pointer) {
            None -> None,
            Some(p) -> match (size) {
                None -> None,
                Some(s) -> Some(Skip),
            },
        };
    }
    return None;
}

// sigs are the program's signatures and ret the function's result type; next
// is the first slot no binding in scope uses.
impl SrcStmt {
    pub fn lower(self, sigs: List<Sig>, ret: SrcType, scope: List<Binding>, next: usize) -> core::option::Option<Stmt> {
        return match (self) {
            Nop -> Some(Skip),
            Let(id, ty, value, body) -> lower_let(next, lower_value(scope, value, ty), unbox(body).lower(sigs, ret, cons(Binding { id: id, slot: next, ty: ty }, scope), plus(next, ty.size()))),
            LetStruct(id, ty, fields, body) -> lower_let(next, lower_literal(scope, ty, fields), unbox(body).lower(sigs, ret, cons(Binding { id: id, slot: next, ty: ty }, scope), plus(next, ty.size()))),
            LetCall(id, ty, callee, args, body) -> lower_let_call(next, ty.size(), callee, lower_call(sigs, scope, callee, args, ty), unbox(body).lower(sigs, ret, cons(Binding { id: id, slot: next, ty: ty }, scope), plus(next, ty.size()))),
            LetEnum(id, ty, variant, payload, body) -> lower_let(next, lower_enum_value(scope, ty, variant, payload), unbox(body).lower(sigs, ret, cons(Binding { id: id, slot: next, ty: ty }, scope), plus(next, ty.size()))),
            LetMatch(id, ty, scrutinee, enum_id, arms, body) -> lower_then(lower_match(scope, lookup(scope, scrutinee), enum_id, arms, ty, next), unbox(body).lower(sigs, ret, cons(Binding { id: id, slot: next, ty: ty }, scope), plus(next, ty.size()))),
            Set(id, value) -> lower_set(lookup(scope, id), scope, value),
            SetField(id, index, value) -> lower_set_field(lookup(scope, id), index, scope, value),
            SetCall(id, callee, args) -> lower_set_call(sigs, scope, lookup(scope, id), callee, args),
            Then(first, second) -> lower_then(unbox(first).lower(sigs, ret, scope, next), unbox(second).lower(sigs, ret, scope, next)),
            If(condition, then_branch, else_branch) -> lower_if(lower_as(scope, condition, Bool), unbox(then_branch).lower(sigs, ret, scope, next), unbox(else_branch).lower(sigs, ret, scope, next)),
            While(condition, body) -> lower_while(lower_as(scope, condition, Bool), unbox(body).lower(sigs, ret, scope, next)),
            Return(value) -> lower_return(lower_value(scope, value, ret)),
            LetAlloc(id, size, shift, body) -> lower_alloc(next, shift, lower_as(scope, size, Uint(Usize)), unbox(body).lower(sigs, ret, cons(Binding { id: id, slot: next, ty: Ptr }, scope), plus(next, 1))),
            LetLoad(id, pointer, offset, body) -> lower_load(next, lower_address(lower_as(scope, pointer, Ptr), lower_as(scope, offset, Uint(Usize))), unbox(body).lower(sigs, ret, cons(Binding { id: id, slot: next, ty: Uint(Uint8) }, scope), plus(next, 1))),
            SetByte(pointer, offset, value) -> lower_store(lower_address(lower_as(scope, pointer, Ptr), lower_as(scope, offset, Uint(Usize))), lower_as(scope, value, Uint(Uint8))),
            Free(pointer, size, shift) -> lower_free(shift, lower_as(scope, pointer, Ptr), lower_as(scope, size, Uint(Usize))),
        };
    }

    // Slots the statement's lets need beyond the ones in scope.
    pub fn depth(self) -> usize {
        return match (self) {
            Nop -> 0,
            Let(id, ty, value, body) -> plus(unbox(body).depth(), ty.size()),
            LetStruct(id, ty, fields, body) -> plus(unbox(body).depth(), ty.size()),
            LetCall(id, ty, callee, args, body) -> plus(unbox(body).depth(), ty.size()),
            LetEnum(id, ty, variant, payload, body) -> plus(unbox(body).depth(), ty.size()),
            LetMatch(id, ty, scrutinee, enum_id, arms, body) -> plus(unbox(body).depth(), ty.size()),
            Set(id, value) -> 0,
            SetField(id, index, value) -> 0,
            SetCall(id, callee, args) -> 0,
            Then(first, second) -> max_of(unbox(first).depth(), unbox(second).depth()),
            If(condition, then_branch, else_branch) -> max_of(unbox(then_branch).depth(), unbox(else_branch).depth()),
            While(condition, body) -> unbox(body).depth(),
            Return(value) -> 0,
            LetAlloc(id, size, shift, body) -> plus(unbox(body).depth(), 1),
            LetLoad(id, pointer, offset, body) -> plus(unbox(body).depth(), 1),
            SetByte(pointer, offset, value) -> 0,
            Free(pointer, size, shift) -> 0,
        };
    }
}

// Parameters take slots from 0 in order, a struct one per field; a later
// parameter with the same id shadows an earlier one, as Core's bindLocals
// does.
pub fn param_scope(params: List<SrcParam>, slot: usize, scope: List<Binding>) -> List<Binding> {
    return match (params) {
        Nil -> scope,
        Cons(param, rest) -> param_scope(unbox(rest), plus(slot, param.ty.size()), cons(Binding { id: param.id, slot: slot, ty: param.ty }, scope)),
    };
}

pub fn params_valid(params: List<SrcParam>) -> bool {
    return match (params) {
        Nil -> true,
        Cons(param, rest) -> (param.ty.size() > 0) && params_valid(unbox(rest)),
    };
}

pub fn params_size(params: List<SrcParam>) -> usize {
    return match (params) {
        Nil -> 0,
        Cons(param, rest) -> plus(param.ty.size(), params_size(unbox(rest))),
    };
}

pub fn param_types(params: List<SrcParam>) -> List<SrcType> {
    return match (params) {
        Nil -> empty(),
        Cons(param, rest) -> cons(param.ty, param_types(unbox(rest))),
    };
}

pub fn sigs(funcs: List<SrcFunc>) -> List<Sig> {
    return match (funcs) {
        Nil -> empty(),
        Cons(func, rest) -> cons(Sig { params: param_types(func.params), ret: func.ret }, sigs(unbox(rest))),
    };
}

pub fn lower_body(count: usize, results: usize, depth: usize, body: core::option::Option<Stmt>) -> core::option::Option<Func> {
    return match (body) {
        None -> None,
        Some(b) -> Some(Func { params: count, results: results, locals: max_of(plus(count, depth), results), body: b }),
    };
}

// Results and struct parameters have slots; a function returns its result
// type's slots, so it has at least that many locals.
pub fn lower_func(sigs: List<Sig>, func: SrcFunc) -> core::option::Option<Func> {
    let count: usize = params_size(func.params);
    if ((func.ret.size() > 0) && params_valid(func.params)) {
        return lower_body(count, func.ret.size(), func.body.depth(), func.body.lower(sigs, func.ret, param_scope(func.params, 0, empty()), count));
    }
    return None;
}

pub fn lower_func_cons(first: core::option::Option<Func>, rest: core::option::Option<List<Func>>) -> core::option::Option<List<Func>> {
    return match (first) {
        None -> None,
        Some(f) -> match (rest) {
            None -> None,
            Some(fs) -> Some(cons(f, fs)),
        },
    };
}

pub fn lower_funcs(sigs: List<Sig>, funcs: List<SrcFunc>) -> core::option::Option<List<Func>> {
    return match (funcs) {
        Nil -> Some(empty()),
        Cons(func, rest) -> lower_func_cons(lower_func(sigs, func), lower_funcs(sigs, unbox(rest))),
    };
}

// Core's typing needs two things the lowering does not check.
//
// Declarations: Core names a struct or enum type by its id and looks the
// fields or variants up in the program's declarations, while a source type
// carries them inline. The front pass derives one declaration per id from
// the program's types (parameters, results and bindings, and the types
// nested in them), and rejects a program that gives one id two field or
// variant lists. Lanius/Mini/Source.lean puts these declarations in the
// program's Core meaning.
//
// Returns: a function body ends in a return on every path.

// Struct id's field types.
pub struct SrcStructDecl {
    id: usize,
    fields: List<SrcType>,
}

// Enum id's variants, each its payload types.
pub struct SrcEnumDecl {
    id: usize,
    variants: List<List<SrcType>>,
}

pub struct SrcDecls {
    structs: List<SrcStructDecl>,
    enums: List<SrcEnumDecl>,
}

// The fields declared for struct id.
pub fn struct_fields(decls: List<SrcStructDecl>, id: usize) -> core::option::Option<List<SrcType>> {
    return match (decls) {
        Nil -> None,
        Cons(decl, rest) -> struct_fields_at(decl, unbox(rest), id),
    };
}

// extract: inline
fn struct_fields_at(decl: SrcStructDecl, rest: List<SrcStructDecl>, id: usize) -> core::option::Option<List<SrcType>> {
    if (decl.id == id) {
        return Some(decl.fields);
    }
    return struct_fields(rest, id);
}

// The variants declared for enum id.
pub fn enum_variants(decls: List<SrcEnumDecl>, id: usize) -> core::option::Option<List<List<SrcType>>> {
    return match (decls) {
        Nil -> None,
        Cons(decl, rest) -> enum_variants_at(decl, unbox(rest), id),
    };
}

// extract: inline
fn enum_variants_at(decl: SrcEnumDecl, rest: List<SrcEnumDecl>, id: usize) -> core::option::Option<List<List<SrcType>>> {
    if (decl.id == id) {
        return Some(decl.variants);
    }
    return enum_variants(rest, id);
}

// decls, if the declaration already there agrees.
pub fn keep_if(agrees: bool, decls: SrcDecls) -> core::option::Option<SrcDecls> {
    if (agrees) {
        return Some(decls);
    }
    return None;
}

// Struct id with these fields declared, unless id has other fields.
pub fn declare_struct(id: usize, fields: List<SrcType>, after: core::option::Option<SrcDecls>) -> core::option::Option<SrcDecls> {
    return match (after) {
        None -> None,
        Some(decls) -> declare_struct_in(id, fields, decls, struct_fields(decls.structs, id)),
    };
}

// extract: inline
fn declare_struct_in(id: usize, fields: List<SrcType>, decls: SrcDecls, known: core::option::Option<List<SrcType>>) -> core::option::Option<SrcDecls> {
    return match (known) {
        None -> Some(SrcDecls { structs: cons(SrcStructDecl { id: id, fields: fields }, decls.structs), enums: decls.enums }),
        Some(other) -> keep_if(types_same(other, fields), decls),
    };
}

// Enum id with these variants declared, unless id has other variants.
pub fn declare_enum(id: usize, variants: List<List<SrcType>>, after: core::option::Option<SrcDecls>) -> core::option::Option<SrcDecls> {
    return match (after) {
        None -> None,
        Some(decls) -> declare_enum_in(id, variants, decls, enum_variants(decls.enums, id)),
    };
}

// extract: inline
fn declare_enum_in(id: usize, variants: List<List<SrcType>>, decls: SrcDecls, known: core::option::Option<List<List<SrcType>>>) -> core::option::Option<SrcDecls> {
    return match (known) {
        None -> Some(SrcDecls { structs: decls.structs, enums: cons(SrcEnumDecl { id: id, variants: variants }, decls.enums) }),
        Some(other) -> keep_if(variants_same(other, variants), decls),
    };
}

// extract: inline
fn declare_types_after(after: core::option::Option<SrcDecls>, rest: List<SrcType>) -> core::option::Option<SrcDecls> {
    return match (after) {
        None -> None,
        Some(decls) -> declare_types(rest, decls),
    };
}

// extract: inline
fn declare_variants_after(after: core::option::Option<SrcDecls>, rest: List<List<SrcType>>) -> core::option::Option<SrcDecls> {
    return match (after) {
        None -> None,
        Some(decls) -> declare_variants(rest, decls),
    };
}

// extract: mutual begin
impl SrcType {
    // decls with every struct and enum type in this one declared, the nested
    // ones first; None when one is declared with other fields or variants.
    pub fn declare(self, decls: SrcDecls) -> core::option::Option<SrcDecls> {
        return match (self) {
            I32 -> Some(decls),
            Bool -> Some(decls),
            Uint(kind) -> Some(decls),
            Struct(id, fields) -> declare_struct(id, unbox(fields), declare_types(unbox(fields), decls)),
            Enum(id, variants) -> declare_enum(id, unbox(variants), declare_variants(unbox(variants), decls)),
            Ptr -> Some(decls),
        };
    }
}

pub fn declare_types(types: List<SrcType>, decls: SrcDecls) -> core::option::Option<SrcDecls> {
    return match (types) {
        Nil -> Some(decls),
        Cons(ty, rest) -> declare_types_after(ty.declare(decls), unbox(rest)),
    };
}

pub fn declare_variants(variants: List<List<SrcType>>, decls: SrcDecls) -> core::option::Option<SrcDecls> {
    return match (variants) {
        Nil -> Some(decls),
        Cons(types, rest) -> declare_variants_after(declare_types(types, decls), unbox(rest)),
    };
}
// extract: mutual end

// extract: inline
fn declare_in(after: core::option::Option<SrcDecls>, body: SrcStmt) -> core::option::Option<SrcDecls> {
    return match (after) {
        None -> None,
        Some(decls) -> body.declare(decls),
    };
}

impl SrcStmt {
    // decls with the types of the statement's bindings declared.
    pub fn declare(self, decls: SrcDecls) -> core::option::Option<SrcDecls> {
        return match (self) {
            Nop -> Some(decls),
            Let(id, ty, value, body) -> declare_in(ty.declare(decls), unbox(body)),
            LetStruct(id, ty, fields, body) -> declare_in(ty.declare(decls), unbox(body)),
            LetCall(id, ty, callee, args, body) -> declare_in(ty.declare(decls), unbox(body)),
            LetEnum(id, ty, variant, payload, body) -> declare_in(ty.declare(decls), unbox(body)),
            LetMatch(id, ty, scrutinee, enum_id, arms, body) -> declare_in(ty.declare(decls), unbox(body)),
            Set(id, value) -> Some(decls),
            SetField(id, index, value) -> Some(decls),
            SetCall(id, callee, args) -> Some(decls),
            Then(first, second) -> declare_in(unbox(first).declare(decls), unbox(second)),
            If(condition, then_branch, else_branch) -> declare_in(unbox(then_branch).declare(decls), unbox(else_branch)),
            While(condition, body) -> unbox(body).declare(decls),
            Return(value) -> Some(decls),
            LetAlloc(id, size, shift, body) -> unbox(body).declare(decls),
            LetLoad(id, pointer, offset, body) -> unbox(body).declare(decls),
            SetByte(pointer, offset, value) -> Some(decls),
            Free(pointer, size, shift) -> Some(decls),
        };
    }

    // Every path ends in a return, the way Core's DefinitelyReturns counts:
    // a while body never counts.
    pub fn returns(self) -> bool {
        return match (self) {
            Nop -> false,
            Let(id, ty, value, body) -> unbox(body).returns(),
            LetStruct(id, ty, fields, body) -> unbox(body).returns(),
            LetCall(id, ty, callee, args, body) -> unbox(body).returns(),
            LetEnum(id, ty, variant, payload, body) -> unbox(body).returns(),
            LetMatch(id, ty, scrutinee, enum_id, arms, body) -> unbox(body).returns(),
            Set(id, value) -> false,
            SetField(id, index, value) -> false,
            SetCall(id, callee, args) -> false,
            Then(first, second) -> unbox(first).returns() || unbox(second).returns(),
            If(condition, then_branch, else_branch) -> unbox(then_branch).returns() && unbox(else_branch).returns(),
            While(condition, body) -> false,
            Return(value) -> true,
            LetAlloc(id, size, shift, body) -> unbox(body).returns(),
            LetLoad(id, pointer, offset, body) -> unbox(body).returns(),
            SetByte(pointer, offset, value) -> false,
            Free(pointer, size, shift) -> false,
        };
    }
}

pub fn declare_params(params: List<SrcParam>, decls: SrcDecls) -> core::option::Option<SrcDecls> {
    return match (params) {
        Nil -> Some(decls),
        Cons(param, rest) -> declare_params_after(param.ty.declare(decls), unbox(rest)),
    };
}

// extract: inline
fn declare_params_after(after: core::option::Option<SrcDecls>, rest: List<SrcParam>) -> core::option::Option<SrcDecls> {
    return match (after) {
        None -> None,
        Some(decls) -> declare_params(rest, decls),
    };
}

// A function's parameter, result and binding types.
pub fn declare_func(func: SrcFunc, decls: SrcDecls) -> core::option::Option<SrcDecls> {
    return match (declare_params(func.params, decls)) {
        None -> None,
        Some(with_params) -> declare_in(func.ret.declare(with_params), func.body),
    };
}

pub fn declare_funcs(funcs: List<SrcFunc>, decls: SrcDecls) -> core::option::Option<SrcDecls> {
    return match (funcs) {
        Nil -> Some(decls),
        Cons(func, rest) -> declare_funcs_after(declare_func(func, decls), unbox(rest)),
    };
}

// extract: inline
fn declare_funcs_after(after: core::option::Option<SrcDecls>, rest: List<SrcFunc>) -> core::option::Option<SrcDecls> {
    return match (after) {
        None -> None,
        Some(decls) -> declare_funcs(rest, decls),
    };
}

// The program's struct and enum declarations.
pub fn declare_program(prog: SrcProgram) -> core::option::Option<SrcDecls> {
    return declare_funcs(prog.funcs, SrcDecls { structs: empty(), enums: empty() });
}

pub fn funcs_return(funcs: List<SrcFunc>) -> bool {
    return match (funcs) {
        Nil -> true,
        Cons(func, rest) -> func.body.returns() && funcs_return(unbox(rest)),
    };
}

pub fn compile_declared(decls: core::option::Option<SrcDecls>, funcs: core::option::Option<List<Func>>) -> core::option::Option<Binary> {
    return match (decls) {
        None -> None,
        Some(d) -> match (funcs) {
            None -> None,
            Some(fs) -> compile_program(Program { funcs: fs }),
        },
    };
}

// Machine code of a source program.
pub fn compile_source(prog: SrcProgram) -> core::option::Option<Binary> {
    if (funcs_return(prog.funcs)) {
        return compile_declared(declare_program(prog), lower_funcs(sigs(prog.funcs), prog.funcs));
    }
    return None;
}
