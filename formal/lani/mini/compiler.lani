// The mini compiler in Lanius. formal/tools/extract.py turns everything after
// the prelude into the Lean definitions in formal/Lanius/Mini/Compiler.lean,
// which the proofs in formal/Lanius/Mini/ are about.
//
// The code is pure: values are never mutated, recursion replaces loops, and
// lists are the prelude's cons list. Arithmetic on usize goes through
// plus/minus/times, which panic instead of wrapping, so a run that returns
// computed exactly what the Lean definitions compute over Nat.
module mini::compiler;
import alloc::allocator;
import core::mem;
import core::option;
import core::panic;

// extract: prelude begin
// Each prelude item has a fixed Lean meaning (see PRELUDE in extract.py).
// They are the only code that touches memory.

// Box<T> is T.
pub struct Box<T> { storage: ptr }

pub fn boxed<T>(value: T) -> Box<T> {
    let size: usize = core::mem::size_of<T>();
    let storage: ptr = alloc::allocator::alloc(size, 8);
    if (storage == 0) {
        core::panic::panic();
    }
    let slot: [T] = core::mem::typed_slice_from_storage(storage, 1);
    slot[0] = value;
    return Box { storage: storage };
}

pub fn unbox<T>(value: Box<T>) -> T {
    let slot: [T] = core::mem::typed_slice_from_storage(value.storage, 1);
    return slot[0];
}

// List<T> is List T: Nil is [] and Cons(x, rest) is x :: rest.
pub enum List<T> { Nil, Cons(T, Box<List<T>>), }

// Nat a + b
pub fn plus(a: usize, b: usize) -> usize {
    let sum: usize = a + b;
    if (a > sum) {
        core::panic::panic();
    }
    return sum;
}

// Nat a * b
pub fn times(a: usize, b: usize) -> usize {
    if (a == 0) {
        return 0;
    }
    let product: usize = a * b;
    if (product / a != b) {
        core::panic::panic();
    }
    return product;
}

// Nat a - b, used only where a >= b
pub fn minus(a: usize, b: usize) -> usize {
    if (b > a) {
        core::panic::panic();
    }
    return a - b;
}

// max a b
pub fn max_of(a: usize, b: usize) -> usize {
    if (b > a) {
        return b;
    }
    return a;
}
// extract: prelude end

// List operations. Each one is extracted as Lists.<name>, together with a
// theorem that it equals its Lean list function; calls elsewhere are written
// as that function (see SPEC_FNS in extract.py).

// []
pub fn empty<T>() -> List<T> {
    return Nil;
}

// [item]
pub fn single<T>(item: T) -> List<T> {
    return Cons(item, boxed(Nil));
}

// item :: rest
pub fn cons<T>(item: T, rest: List<T>) -> List<T> {
    return Cons(item, boxed(rest));
}

// first ++ second
pub fn concat<T>(first: List<T>, second: List<T>) -> List<T> {
    return match (first) {
        Nil -> second,
        Cons(item, rest) -> Cons(item, boxed(concat(unbox(rest), second))),
    };
}

// items.length
pub fn length<T>(items: List<T>) -> usize {
    return match (items) {
        Nil -> 0,
        Cons(item, rest) -> plus(length(unbox(rest)), 1),
    };
}

// items[index]?
pub fn get<T>(items: List<T>, index: usize) -> core::option::Option<T> {
    if (index == 0) {
        return match (items) {
            Nil -> None,
            Cons(item, rest) -> Some(item),
        };
    }
    return match (items) {
        Nil -> None,
        Cons(item, rest) -> get(unbox(rest), minus(index, 1)),
    };
}

// items.getD index fallback
pub fn get_or<T>(items: List<T>, index: usize, fallback: T) -> T {
    if (index == 0) {
        return match (items) {
            Nil -> fallback,
            Cons(item, rest) -> item,
        };
    }
    return match (items) {
        Nil -> fallback,
        Cons(item, rest) -> get_or(unbox(rest), minus(index, 1), fallback),
    };
}

// Source language: code over 64-bit words with comparisons, if, while, and
// functions with parameters and direct calls. Locals are frame indices; a
// function's parameters are its first locals. Comparisons produce 1 or 0, and
// conditions test for nonzero. Calls are statements: a function returns a
// fixed number of values, and a call stores them in consecutive locals.
// There is a heap of bytes below a fixed limit, and a bump allocator whose
// cursor only moves up: addresses are heap offsets.

// Shl, Shr and Sar shift by the right operand's low 5 bits (S32) or 6 bits
// (U64), as x86's shifts by cl do; Shr fills with zeros, Sar with the sign.
pub enum BinOp { Add, Sub, Mul, And, Or, Xor, Shl, Shr, Sar, }

pub enum CmpOp { Eq, Ne, Lt, Le, Gt, Ge, }

// How an operation reads its words. An S32 operation acts on the low 32 bits
// and zero-extends its result, as x86's 32-bit instructions do, and its
// comparisons are signed. A U64 operation uses all 64 bits, and its
// comparisons are unsigned.
pub enum Word { S32, U64, }

// Division and remainder. The word sets the width: an S32 division divides
// the low 32 bits and zero-extends its result, a U64 one divides all 64 bits.
// A signed quotient is truncated toward zero, and a signed remainder has the
// dividend's sign.
pub enum DivOp { SDiv, SRem, UDiv, URem, }

// A heap word access: 4 or 8 bytes, little-endian. A 4-byte load
// zero-extends; a 4-byte store writes the low 4 bytes.
pub enum MemWidth { M32, M64, }

impl MemWidth {
    // The bytes a load or store covers.
    pub fn bytes(self) -> usize {
        return match (self) {
            M32 -> 4,
            M64 -> 8,
        };
    }

    // The length of the REX.W prefix of the 64-bit move.
    pub fn prefix(self) -> usize {
        return match (self) {
            M32 -> 0,
            M64 -> 1,
        };
    }

    // The REX.W prefix of the 64-bit move.
    pub fn rex(self) -> List<u8> {
        return match (self) {
            M32 -> empty(),
            M64 -> single(72),
        };
    }
}

pub enum Expr {
    Lit(u64),
    Var(usize),
    // S32 negation
    Neg(Box<Expr>),
    Binary(Word, BinOp, Box<Expr>, Box<Expr>),
    Compare(Word, CmpOp, Box<Expr>, Box<Expr>),
}

pub enum Stmt {
    Skip,
    Assign(usize, Expr),
    Seq(Box<Stmt>, Box<Stmt>),
    Ite(Expr, Box<Stmt>, Box<Stmt>),
    // while condition { body }
    Loop(Expr, Box<Stmt>),
    // target, ..., target + count - 1 = callee(args)
    Call(usize, usize, usize, List<Expr>),
    Ret(List<Expr>),
    // target = the cursor rounded up to a multiple of 2^shift; the cursor
    // moves past size bytes from there
    Alloc(usize, usize, Expr),
    // target = the byte at address
    LoadByte(usize, Expr),
    // the byte at address = the low byte of value
    StoreByte(Expr, Expr),
    // target = the word at address
    LoadWord(MemWidth, usize, Expr),
    // the word at address = the low bytes of value
    StoreWord(MemWidth, Expr, Expr),
    // target = left op right; a zero divisor, or a signed division of the
    // least value by -1, has no run
    Divide(Word, DivOp, usize, Expr, Expr),
}

pub struct Func {
    params: usize,
    // Values each return gives.
    results: usize,
    // All locals, parameters included.
    locals: usize,
    body: Stmt,
}

pub struct Program {
    funcs: List<Func>,
}

// The abstract target: an accumulator (rax), frame slots, and a program
// counter that is a byte offset into the function's code. Each instruction is
// one fixed byte sequence, Instr::size bytes long.
pub enum Instr {
    // mov rax, imm64
    Imm(u64),
    // mov rax, [rbp - 8 * (slot + 1)]
    Load(usize),
    // mov [rbp - 8 * (slot + 1)], rax
    Store(usize),
    // neg eax
    Neg,
    // rax := slot op rax
    Op(Word, BinOp, usize),
    // rax := (slot cmp rax) ? 1 : 0
    Cmp(Word, CmpOp, usize),
    // jmp rel32
    Jmp(usize),
    // test rax, rax; jz rel32
    Jz(usize),
    // Copy the argument slots into the callee's parameter slots, call rel32,
    // then copy count results from the callee's first slots to target, ...
    Call(usize, List<usize>, usize, usize),
    // Copy the source slots to the first slots, then the frame epilogue and
    // ret. The results replace the arguments, and rax holds the last one.
    Ret(List<usize>),
    // Allocate rax bytes at the cursor (r13) rounded up to 2^shift, below
    // the limit (r14), and leave the address in rax
    Bump(usize),
    // movzx eax, byte [r12 + rax]: the heap starts at r12
    LoadAt,
    // mov [r12 + slot], al
    StoreAt(usize),
    // mov eax, [r12 + rax], or rax for M64
    LoadWordAt(MemWidth),
    // mov [r12 + slot], eax, or rax for M64
    StoreWordAt(MemWidth, usize),
    // rax := slot op rax
    Div(Word, DivOp, usize),
}

impl BinOp {
    // imul is one byte longer than the other operators.
    pub fn size(self) -> usize {
        return match (self) {
            Add -> 12,
            Sub -> 12,
            Mul -> 13,
            And -> 12,
            Or -> 12,
            Xor -> 12,
            Shl -> 12,
            Shr -> 12,
            Sar -> 12,
        };
    }
}

impl Word {
    // U64 operations take a REX.W prefix byte.
    pub fn prefix(self) -> usize {
        return match (self) {
            S32 -> 0,
            U64 -> 1,
        };
    }
}

impl DivOp {
    // A division is 18 bytes, the divide's REX.W prefix, and these: cdq or
    // cqo (REX.W) for a signed one, xor edx, edx for an unsigned one, and
    // mov rax, rdx for a remainder.
    pub fn size(self, word: Word) -> usize {
        return match (self) {
            SDiv -> plus(1, word.prefix()),
            SRem -> plus(4, word.prefix()),
            UDiv -> 2,
            URem -> 5,
        };
    }
}

impl Instr {
    pub fn size(self) -> usize {
        return match (self) {
            Imm(value) -> 10,
            Load(slot) -> 7,
            Store(slot) -> 7,
            Instr::Neg -> 2,
            Op(word, operation, slot) -> plus(operation.size(), word.prefix()),
            Cmp(word, operation, slot) -> plus(18, word.prefix()),
            Jmp(target) -> 5,
            Jz(target) -> 9,
            Instr::Call(callee, args, target, count) -> plus(plus(times(14, length(args)), 5), times(14, count)),
            Instr::Ret(sources) -> plus(times(14, length(sources)), 5),
            Bump(shift) -> 58,
            LoadAt -> 10,
            StoreAt(slot) -> 16,
            LoadWordAt(width) -> plus(9, width.prefix()),
            StoreWordAt(width, slot) -> plus(16, width.prefix()),
            Div(word, operation, slot) -> plus(plus(18, word.prefix()), operation.size(word)),
        };
    }
}

pub fn code_size(code: List<Instr>) -> usize {
    return match (code) {
        Nil -> 0,
        Cons(i, rest) -> plus(i.size(), code_size(unbox(rest))),
    };
}

// Expressions leave their value in the accumulator. A binary operator's left
// operand waits in temporary slot base + depth, above the base local slots,
// while the right operand is computed one level deeper.
pub fn compile_expr(base: usize, e: Expr, depth: usize) -> List<Instr> {
    return match (e) {
        Lit(value) -> single(Imm(value)),
        Var(index) -> single(Load(index)),
        Expr::Neg(operand) -> concat(compile_expr(base, unbox(operand), depth), single(Instr::Neg)),
        Binary(word, operation, left, right) -> concat(concat(concat(compile_expr(base, unbox(left), depth), single(Store(plus(base, depth)))), compile_expr(base, unbox(right), plus(depth, 1))), single(Op(word, operation, plus(base, depth)))),
        Compare(word, operation, left, right) -> concat(concat(concat(compile_expr(base, unbox(left), depth), single(Store(plus(base, depth)))), compile_expr(base, unbox(right), plus(depth, 1))), single(Cmp(word, operation, plus(base, depth)))),
    };
}

// Argument k is evaluated into temporary base + k.
pub fn compile_args(base: usize, args: List<Expr>, k: usize) -> List<Instr> {
    return match (args) {
        Nil -> empty(),
        Cons(arg, rest) -> concat(concat(compile_expr(base, arg, plus(k, 1)), single(Store(plus(base, k)))), compile_args(base, unbox(rest), plus(k, 1))),
    };
}

pub fn arg_slots(base: usize, args: List<Expr>, k: usize) -> List<usize> {
    return match (args) {
        Nil -> empty(),
        Cons(arg, rest) -> cons(plus(base, k), arg_slots(base, unbox(rest), plus(k, 1))),
    };
}

// Statement code is placed at offset pos, so jumps are absolute offsets
// within the function.
pub fn compile_stmt(base: usize, pos: usize, s: Stmt) -> List<Instr> {
    return match (s) {
        Skip -> empty(),
        Assign(index, value) -> concat(compile_expr(base, value, 0), single(Store(index))),
        Seq(first, second) -> seq_code(base, pos, compile_stmt(base, pos, unbox(first)), unbox(second)),
        Ite(condition, then_branch, else_branch) -> ite_code(base, pos, compile_expr(base, condition, 0), unbox(then_branch), unbox(else_branch)),
        Loop(condition, body) -> loop_code(base, pos, compile_expr(base, condition, 0), unbox(body)),
        Stmt::Call(target, count, callee, args) -> concat(compile_args(base, args, 0), single(Instr::Call(callee, arg_slots(base, args, 0), target, count))),
        Stmt::Ret(values) -> concat(compile_args(base, values, 0), single(Instr::Ret(arg_slots(base, values, 0)))),
        Alloc(target, shift, size) -> concat(compile_expr(base, size, 0), cons(Bump(shift), single(Store(target)))),
        LoadByte(target, address) -> concat(compile_expr(base, address, 0), cons(LoadAt, single(Store(target)))),
        StoreByte(address, value) -> concat(concat(compile_expr(base, address, 0), single(Store(base))), concat(compile_expr(base, value, 1), single(StoreAt(base)))),
        LoadWord(width, target, address) -> concat(compile_expr(base, address, 0), cons(LoadWordAt(width), single(Store(target)))),
        StoreWord(width, address, value) -> concat(concat(compile_expr(base, address, 0), single(Store(base))), concat(compile_expr(base, value, 1), single(StoreWordAt(width, base)))),
        Divide(word, operation, target, left, right) -> concat(concat(concat(compile_expr(base, left, 0), single(Store(base))), compile_expr(base, right, 1)), cons(Div(word, operation, base), single(Store(target)))),
    };
}

// extract: inline
fn seq_code(base: usize, pos: usize, first_code: List<Instr>, second: Stmt) -> List<Instr> {
    return concat(first_code, compile_stmt(base, plus(pos, code_size(first_code)), second));
}

// extract: inline
fn ite_code(base: usize, pos: usize, condition_code: List<Instr>, then_branch: Stmt, else_branch: Stmt) -> List<Instr> {
    let then_start: usize = plus(plus(pos, code_size(condition_code)), 9);
    let then_code: List<Instr> = compile_stmt(base, then_start, then_branch);
    let else_start: usize = plus(plus(then_start, code_size(then_code)), 5);
    let else_code: List<Instr> = compile_stmt(base, else_start, else_branch);
    return concat(concat(concat(concat(condition_code, single(Jz(else_start))), then_code), single(Jmp(plus(else_start, code_size(else_code))))), else_code);
}

// extract: inline
fn loop_code(base: usize, pos: usize, condition_code: List<Instr>, body: Stmt) -> List<Instr> {
    let body_start: usize = plus(plus(pos, code_size(condition_code)), 9);
    let body_code: List<Instr> = compile_stmt(base, body_start, body);
    return concat(concat(concat(condition_code, single(Jz(plus(plus(body_start, code_size(body_code)), 5)))), body_code), single(Jmp(pos)));
}

// Every local an expression reads is below locals.
impl Expr {
    pub fn within(self, locals: usize) -> bool {
        return match (self) {
            Lit(value) -> true,
            Var(index) -> locals > index,
            Expr::Neg(operand) -> unbox(operand).within(locals),
            Binary(word, operation, left, right) -> unbox(left).within(locals) && unbox(right).within(locals),
            Compare(word, operation, left, right) -> unbox(left).within(locals) && unbox(right).within(locals),
        };
    }

    // Temporary slots an expression's code uses.
    pub fn temps(self) -> usize {
        return match (self) {
            Lit(value) -> 0,
            Var(index) -> 0,
            Expr::Neg(operand) -> unbox(operand).temps(),
            Binary(word, operation, left, right) -> max_of(unbox(left).temps(), plus(unbox(right).temps(), 1)),
            Compare(word, operation, left, right) -> max_of(unbox(left).temps(), plus(unbox(right).temps(), 1)),
        };
    }
}

pub fn all_within(locals: usize, args: List<Expr>) -> bool {
    return match (args) {
        Nil -> true,
        Cons(arg, rest) -> arg.within(locals) && all_within(locals, unbox(rest)),
    };
}

// A function's parameter and result counts.
pub struct Arity {
    params: usize,
    results: usize,
}

pub fn arity_is(arities: List<Arity>, callee: usize, count: usize, results: usize) -> bool {
    return match (get(arities, callee)) {
        Some(arity) -> (arity.params == count) && (arity.results == results),
        None -> false,
    };
}

// Temporaries used by arguments from position k on.
pub fn args_temps(args: List<Expr>, k: usize) -> usize {
    return match (args) {
        Nil -> 0,
        Cons(arg, rest) -> max_of(plus(plus(k, 1), arg.temps()), args_temps(unbox(rest), plus(k, 1))),
    };
}

impl Stmt {
    // Locals are in range, each call names a function, passes it as many
    // arguments as it has parameters and stores all its results, and each
    // return gives results values.
    pub fn within(self, locals: usize, arities: List<Arity>, results: usize) -> bool {
        return match (self) {
            Skip -> true,
            Assign(index, value) -> locals > index && value.within(locals),
            Seq(first, second) -> unbox(first).within(locals, arities, results) && unbox(second).within(locals, arities, results),
            Ite(condition, then_branch, else_branch) -> condition.within(locals) && unbox(then_branch).within(locals, arities, results) && unbox(else_branch).within(locals, arities, results),
            Loop(condition, body) -> condition.within(locals) && unbox(body).within(locals, arities, results),
            Stmt::Call(target, count, callee, args) -> locals >= plus(target, count) && count > 0 && arity_is(arities, callee, length(args), count) && all_within(locals, args),
            Stmt::Ret(values) -> (length(values) == results) && all_within(locals, values),
            Alloc(target, shift, size) -> locals > target && 32 > shift && size.within(locals),
            LoadByte(target, address) -> locals > target && address.within(locals),
            StoreByte(address, value) -> address.within(locals) && value.within(locals),
            LoadWord(width, target, address) -> locals > target && address.within(locals),
            StoreWord(width, address, value) -> address.within(locals) && value.within(locals),
            Divide(word, operation, target, left, right) -> locals > target && left.within(locals) && right.within(locals),
        };
    }

    pub fn temps(self) -> usize {
        return match (self) {
            Skip -> 0,
            Assign(index, value) -> value.temps(),
            Seq(first, second) -> max_of(unbox(first).temps(), unbox(second).temps()),
            Ite(condition, then_branch, else_branch) -> max_of(condition.temps(), max_of(unbox(then_branch).temps(), unbox(else_branch).temps())),
            Loop(condition, body) -> max_of(condition.temps(), unbox(body).temps()),
            Stmt::Call(target, count, callee, args) -> args_temps(args, 0),
            Stmt::Ret(values) -> args_temps(values, 0),
            Alloc(target, shift, size) -> size.temps(),
            LoadByte(target, address) -> address.temps(),
            StoreByte(address, value) -> max_of(address.temps(), plus(value.temps(), 1)),
            LoadWord(width, target, address) -> address.temps(),
            StoreWord(width, address, value) -> max_of(address.temps(), plus(value.temps(), 1)),
            Divide(word, operation, target, left, right) -> max_of(left.temps(), plus(right.temps(), 1)),
        };
    }
}

// Zero the non-parameter locals first, ..., first + count - 1.
pub fn zero_locals(first: usize, count: usize) -> List<Instr> {
    if (count == 0) {
        return empty();
    }
    return cons(Store(first), zero_locals(plus(first, 1), minus(count, 1)));
}

// Frames are bounded so every slot displacement fits a signed 32-bit field.
pub fn frame_limit() -> usize {
    return 1048576;
}

pub struct Code {
    // Frame slots: the locals, then the deepest statement's temporaries.
    slots: usize,
    instrs: List<Instr>,
}

// A function returns at least one value, and its results fit in its locals.
pub fn compile_func(arities: List<Arity>, func: Func) -> core::option::Option<Code> {
    let slots: usize = plus(func.locals, func.body.temps());
    if (func.locals >= func.params && func.results > 0 && func.locals >= func.results && func.body.within(func.locals, arities, func.results) && frame_limit() >= slots) {
        let init: List<Instr> = cons(Imm(0), zero_locals(func.params, minus(func.locals, func.params)));
        return Some(Code { slots: slots, instrs: concat(init, compile_stmt(func.locals, code_size(init), func.body)) });
    }
    return None;
}

pub fn arities(funcs: List<Func>) -> List<Arity> {
    return match (funcs) {
        Nil -> empty(),
        Cons(func, rest) -> cons(Arity { params: func.params, results: func.results }, arities(unbox(rest))),
    };
}

pub fn compile_funcs(arities: List<Arity>, funcs: List<Func>) -> core::option::Option<List<Code>> {
    return match (funcs) {
        Nil -> Some(empty()),
        Cons(func, rest) -> match (compile_func(arities, func)) {
            None -> None,
            Some(code) -> match (compile_funcs(arities, unbox(rest))) {
                None -> None,
                Some(codes) -> Some(cons(code, codes)),
            },
        },
    };
}

// Assembly. Jumps are relative to the end of the instruction. A call copies
// its arguments to just below the return address it pushes, which is where
// the callee's prologue puts its parameter slots.

// Little-endian bytes of a 32-bit field.
pub fn le32(value: i32) -> List<u8> {
    let bits: u32 = value as u32;
    return cons(bits as u8, cons((bits >> 8) as u8, cons((bits >> 16) as u8, single((bits >> 24) as u8))));
}

// Little-endian bytes of a 64-bit field.
pub fn le64(value: u64) -> List<u8> {
    return cons(value as u8, cons((value >> 8) as u8, cons((value >> 16) as u8, cons((value >> 24) as u8, cons((value >> 32) as u8, cons((value >> 40) as u8, cons((value >> 48) as u8, single((value >> 56) as u8))))))));
}

// rbp-relative displacement of a frame slot.
pub fn slot_offset(slot: usize) -> i32 {
    return 0 - (times(plus(slot, 1), 8) as i32);
}

// mov rax, [rbp + disp32]
pub fn slot_load(slot: usize) -> List<u8> {
    return concat(cons(72, cons(139, single(133))), le32(slot_offset(slot)));
}

// mov [rbp + disp32], rax
pub fn slot_store(slot: usize) -> List<u8> {
    return concat(cons(72, cons(137, single(133))), le32(slot_offset(slot)));
}

// mov rcx, rax; mov rax, [slot]
pub fn slot_operands(slot: usize) -> List<u8> {
    return concat(cons(72, cons(137, single(193))), slot_load(slot));
}

impl Word {
    // The REX.W prefix of a U64 operation.
    pub fn rex(self) -> List<u8> {
        return match (self) {
            S32 -> empty(),
            U64 -> single(72),
        };
    }
}

impl BinOp {
    // op eax, ecx or shl/shr/sar eax, cl without its prefix
    pub fn opcode(self) -> List<u8> {
        return match (self) {
            Add -> cons(1, single(200)),
            Sub -> cons(41, single(200)),
            Mul -> cons(15, cons(175, single(193))),
            And -> cons(33, single(200)),
            Or -> cons(9, single(200)),
            Xor -> cons(49, single(200)),
            Shl -> cons(211, single(224)),
            Shr -> cons(211, single(232)),
            Sar -> cons(211, single(248)),
        };
    }

    // slot_operands, then op eax, ecx or op rax, rcx
    pub fn bytes(self, word: Word, slot: usize) -> List<u8> {
        return concat(slot_operands(slot), concat(word.rex(), self.opcode()));
    }
}

impl CmpOp {
    pub fn setcc_signed(self) -> u8 {
        return match (self) {
            Eq -> 148,
            Ne -> 149,
            Lt -> 156,
            Le -> 158,
            Gt -> 159,
            Ge -> 157,
        };
    }

    pub fn setcc_unsigned(self) -> u8 {
        return match (self) {
            Eq -> 148,
            Ne -> 149,
            Lt -> 146,
            Le -> 150,
            Gt -> 151,
            Ge -> 147,
        };
    }

    // The setcc opcode byte whose condition holds after cmp left, right
    // exactly when the comparison does: signed for S32, unsigned for U64.
    // (Two helpers: laniusc does not carry the u8 result type into a nested match.)
    pub fn setcc(self, word: Word) -> u8 {
        return match (word) {
            S32 -> self.setcc_signed(),
            U64 -> self.setcc_unsigned(),
        };
    }
}

impl DivOp {
    // The dividend's high half in edx: cdq (cqo with REX.W) sign-extends
    // eax; xor edx, edx zeroes it.
    pub fn extend(self, word: Word) -> List<u8> {
        return match (self) {
            SDiv -> concat(word.rex(), single(153)),
            SRem -> concat(word.rex(), single(153)),
            UDiv -> cons(49, single(210)),
            URem -> cons(49, single(210)),
        };
    }

    // idiv ecx or div ecx without its prefix
    pub fn opcode(self) -> List<u8> {
        return match (self) {
            SDiv -> cons(247, single(249)),
            SRem -> cons(247, single(249)),
            UDiv -> cons(247, single(241)),
            URem -> cons(247, single(241)),
        };
    }

    // mov rax, rdx for a remainder
    pub fn result(self) -> List<u8> {
        return match (self) {
            SDiv -> empty(),
            SRem -> cons(72, cons(137, single(208))),
            UDiv -> empty(),
            URem -> cons(72, cons(137, single(208))),
        };
    }

    // slot_operands; mov r11, rdx; extend; idiv or div ecx (rcx with
    // REX.W); the remainder; mov rdx, r11. rdx is kept for the caller.
    pub fn bytes(self, word: Word, slot: usize) -> List<u8> {
        return concat(concat(slot_operands(slot), cons(73, cons(137, single(211)))), concat(concat(self.extend(word), concat(word.rex(), self.opcode())), concat(self.result(), cons(76, cons(137, single(218))))));
    }
}

// slot_operands; cmp eax, ecx or cmp rax, rcx; setcc al; movzx eax, al
pub fn slot_compare(word: Word, operation: CmpOp, slot: usize) -> List<u8> {
    return concat(concat(slot_operands(slot), concat(word.rex(), cons(57, single(200)))), cons(15, cons(operation.setcc(word), cons(192, cons(15, cons(182, single(192)))))));
}

// 2^shift as a 64-bit word.
pub fn pow2(shift: usize) -> u64 {
    if (shift == 0) {
        return 1;
    }
    let half: u64 = pow2(minus(shift, 1));
    return half + half;
}

// mov rcx, r13; mov r11, 2^shift - 1; add rcx, r11; mov r11, -2^shift;
// and rcx, r11 (rcx is the cursor rounded up); mov r11, rcx; add r11, rax;
// jb +9 (the end wrapped); cmp r11, r14; jbe +2; ud2 (past the limit);
// mov r13, r11; mov rax, rcx
pub fn bump_bytes(shift: usize) -> List<u8> {
    let round: List<u8> = concat(concat(cons(76, cons(137, cons(233, cons(73, single(187))))), le64(pow2(shift) - 1)), cons(76, cons(1, cons(217, cons(73, single(187))))));
    let mask: List<u8> = concat(le64(0 - pow2(shift)), cons(76, cons(33, single(217))));
    let carry: List<u8> = cons(73, cons(137, cons(203, cons(73, cons(1, cons(195, cons(15, cons(130, cons(9, cons(0, cons(0, single(0))))))))))));
    let check: List<u8> = cons(77, cons(57, cons(243, cons(15, cons(134, cons(2, cons(0, cons(0, cons(0, cons(15, single(11)))))))))));
    return concat(concat(concat(round, mask), concat(carry, check)), cons(77, cons(137, cons(221, cons(72, cons(137, single(200)))))));
}

// add rax, r12; movzx eax, byte [rax + 0]
pub fn load_at_bytes() -> List<u8> {
    return cons(76, cons(1, cons(224, cons(15, cons(182, cons(128, cons(0, cons(0, cons(0, single(0))))))))));
}

// mov rcx, [rbp + disp32]; add rcx, r12; mov [rcx + 0], al
pub fn store_at_bytes(slot: usize) -> List<u8> {
    return concat(concat(cons(72, cons(139, single(141))), le32(slot_offset(slot))), cons(76, cons(1, cons(225, cons(136, cons(129, cons(0, cons(0, cons(0, single(0))))))))));
}

// add rax, r12; mov eax, [rax + 0] (rax with REX.W)
pub fn load_word_bytes(width: MemWidth) -> List<u8> {
    return cons(76, cons(1, cons(224, concat(width.rex(), cons(139, cons(128, cons(0, cons(0, cons(0, single(0))))))))));
}

// mov rcx, [rbp + disp32]; add rcx, r12; mov [rcx + 0], eax (rax with REX.W)
pub fn store_word_bytes(width: MemWidth, slot: usize) -> List<u8> {
    return concat(concat(cons(72, cons(139, single(141))), le32(slot_offset(slot))), cons(76, cons(1, cons(225, concat(width.rex(), cons(137, cons(129, cons(0, cons(0, cons(0, single(0)))))))))));
}

// mov rsp, rbp; pop rbp; ret
pub fn epilogue() -> List<u8> {
    return cons(72, cons(137, cons(236, cons(93, single(195)))));
}

// Frame bytes below rbp, a multiple of 16.
pub fn frame_size(slots: usize) -> usize {
    return times(plus(slots, 1) / 2, 16);
}

// cmp r15, rsp; jbe +2; ud2 (past the stack limit in r15)
pub fn stack_check() -> List<u8> {
    return cons(73, cons(57, cons(231, cons(15, cons(134, cons(2, cons(0, cons(0, cons(0, cons(15, single(11)))))))))));
}

// push rbp; mov rbp, rsp; mov r11d, frame_size; sub rsp, r11; the stack check
pub fn prologue(slots: usize) -> List<u8> {
    return concat(concat(concat(cons(85, cons(72, cons(137, cons(229, cons(65, single(187)))))), le32(frame_size(slots) as i32)), cons(76, cons(41, single(220)))), stack_check());
}

// The rel32 field of a transfer from the end of an instruction at source to target.
pub fn relative(source: usize, target: usize) -> i32 {
    return (target as i32) - (source as i32);
}

// Where a function's code sits in the program image.
pub struct Place {
    // Image offset of the body's first instruction.
    body: usize,
    // The function's frame slots.
    slots: usize,
    // Image offset of every function's entry.
    entries: List<usize>,
}

// The caller's virtual slot that is the callee's parameter 0: the slot just
// below the return address the call pushes.
pub fn arg_base(slots: usize) -> usize {
    return plus(frame_size(slots) / 8, 2);
}

// slot, slot + 1, ..., count of them.
pub fn slot_range(slot: usize, count: usize) -> List<usize> {
    if (count == 0) {
        return empty();
    }
    return cons(slot, slot_range(plus(slot, 1), minus(count, 1)));
}

// Copy argument slots args to virtual slots first + k, first + k + 1, ...
pub fn copy_bytes(first: usize, args: List<usize>, k: usize) -> List<u8> {
    return match (args) {
        Nil -> empty(),
        Cons(slot, rest) -> concat(concat(slot_load(slot), slot_store(plus(first, k))), copy_bytes(first, unbox(rest), plus(k, 1))),
    };
}

impl Instr {
    // The bytes of the instruction at body offset pc.
    pub fn encode(self, place: Place, pc: usize) -> List<u8> {
        return match (self) {
            Imm(value) -> cons(72, cons(184, le64(value))),
            Load(slot) -> slot_load(slot),
            Store(slot) -> slot_store(slot),
            Instr::Neg -> cons(247, single(216)),
            Op(word, operation, slot) -> operation.bytes(word, slot),
            Cmp(word, operation, slot) -> slot_compare(word, operation, slot),
            Jmp(target) -> cons(233, le32(relative(plus(pc, 5), target))),
            Jz(target) -> concat(cons(72, cons(133, cons(192, cons(15, single(132))))), le32(relative(plus(pc, 9), target))),
            Instr::Call(callee, args, target, count) -> concat(concat(copy_bytes(arg_base(place.slots), args, 0), cons(232, le32(relative(plus(plus(plus(place.body, pc), times(14, length(args))), 5), get_or(place.entries, callee, 0))))), copy_bytes(target, slot_range(arg_base(place.slots), count), 0)),
            Instr::Ret(sources) -> concat(copy_bytes(0, sources, 0), epilogue()),
            Bump(shift) -> bump_bytes(shift),
            LoadAt -> load_at_bytes(),
            StoreAt(slot) -> store_at_bytes(slot),
            LoadWordAt(width) -> load_word_bytes(width),
            StoreWordAt(width, slot) -> store_word_bytes(width, slot),
            Div(word, operation, slot) -> operation.bytes(word, slot),
        };
    }
}

pub fn encode_from(place: Place, pc: usize, code: List<Instr>) -> List<u8> {
    return match (code) {
        Nil -> empty(),
        Cons(i, rest) -> concat(i.encode(place, pc), encode_from(place, plus(pc, i.size()), unbox(rest))),
    };
}

// A program image is its functions back to back, each the frame prologue
// followed by its body.
impl Code {
    pub fn size(self) -> usize {
        return plus(24, code_size(self.instrs));
    }

    pub fn image(self, start: usize, entries: List<usize>) -> List<u8> {
        return concat(prologue(self.slots), encode_from(Place { body: plus(start, 24), slots: self.slots, entries: entries }, 0, self.instrs));
    }
}

// Entry offsets of functions laid out back to back from start.
pub fn layout(start: usize, codes: List<Code>) -> List<usize> {
    return match (codes) {
        Nil -> empty(),
        Cons(code, rest) -> cons(start, layout(plus(start, code.size()), unbox(rest))),
    };
}

pub fn link_from(entries: List<usize>, start: usize, codes: List<Code>) -> List<u8> {
    return match (codes) {
        Nil -> empty(),
        Cons(code, rest) -> concat(code.image(start, entries), link_from(entries, plus(start, code.size()), unbox(rest))),
    };
}

// Machine code of a compiled program.
pub struct Binary {
    codes: List<Code>,
    entries: List<usize>,
    image: List<u8>,
}

// Images are small enough for every rel32 displacement.
pub fn image_limit() -> usize {
    return 1073741824;
}

pub fn compile_program(prog: Program) -> core::option::Option<Binary> {
    return match (compile_funcs(arities(prog.funcs), prog.funcs)) {
        None -> None,
        Some(codes) -> link(codes),
    };
}

// extract: inline
fn link(codes: List<Code>) -> core::option::Option<Binary> {
    let entries: List<usize> = layout(0, codes);
    let image: List<u8> = link_from(entries, 0, codes);
    if (image_limit() >= length(image)) {
        return Some(Binary { codes: codes, entries: entries, image: image });
    }
    return None;
}

// Separate compilation (roadmap step 9). A module is functions plus the
// functions it imports from other modules. Inside a module a call names
// callee c: below the module's function count own, c is its own function c,
// and own + i is its import i. An import names its owner, the module that
// defines it, by its position in the link order, a function by its position
// in that module, and the arity the importing module compiles its calls
// against.
pub struct Import {
    owner: usize,
    func: usize,
    arity: Arity,
}

pub struct Module {
    funcs: List<Func>,
    imports: List<Import>,
}

// What a list of modules means: one program of all their functions in link
// order, each call renamed to its callee's index there. It exists when every
// import names a function that has the arity the import declares.

// Each module's arities.
pub fn module_exports(ms: List<Module>) -> List<List<Arity>> {
    return match (ms) {
        Nil -> empty(),
        Cons(m, rest) -> cons(arities(m.funcs), module_exports(unbox(rest))),
    };
}

pub fn import_ok(exports: List<List<Arity>>, imp: Import) -> bool {
    return match (get(exports, imp.owner)) {
        None -> false,
        Some(found) -> arity_is(found, imp.func, imp.arity.params, imp.arity.results),
    };
}

pub fn imports_ok(exports: List<List<Arity>>, imports: List<Import>) -> bool {
    return match (imports) {
        Nil -> true,
        Cons(imp, rest) -> import_ok(exports, imp) && imports_ok(exports, unbox(rest)),
    };
}

pub fn modules_ok(exports: List<List<Arity>>, ms: List<Module>) -> bool {
    return match (ms) {
        Nil -> true,
        Cons(m, rest) -> imports_ok(exports, m.imports) && modules_ok(exports, unbox(rest)),
    };
}

// The program index of each module's first function, from first.
pub fn module_firsts(first: usize, ms: List<Module>) -> List<usize> {
    return match (ms) {
        Nil -> empty(),
        Cons(m, rest) -> cons(first, module_firsts(plus(first, length(m.funcs)), unbox(rest))),
    };
}

// The program index of each import's function.
pub fn import_indices(firsts: List<usize>, imports: List<Import>) -> List<usize> {
    return match (imports) {
        Nil -> empty(),
        Cons(imp, rest) -> cons(plus(get_or(firsts, imp.owner, 0), imp.func), import_indices(firsts, unbox(rest))),
    };
}

impl Stmt {
    // Each callee c becomes table[c], or missing past the table's end.
    pub fn rename(self, table: List<usize>, missing: usize) -> Stmt {
        return match (self) {
            Skip -> Stmt::Skip,
            Assign(index, value) -> Stmt::Assign(index, value),
            Seq(first, second) -> Stmt::Seq(boxed(unbox(first).rename(table, missing)), boxed(unbox(second).rename(table, missing))),
            Ite(condition, then_branch, else_branch) -> Stmt::Ite(condition, boxed(unbox(then_branch).rename(table, missing)), boxed(unbox(else_branch).rename(table, missing))),
            Loop(condition, body) -> Stmt::Loop(condition, boxed(unbox(body).rename(table, missing))),
            Stmt::Call(target, count, callee, args) -> Stmt::Call(target, count, get_or(table, callee, missing), args),
            Stmt::Ret(values) -> Stmt::Ret(values),
            Alloc(target, shift, size) -> Stmt::Alloc(target, shift, size),
            LoadByte(target, address) -> Stmt::LoadByte(target, address),
            StoreByte(address, value) -> Stmt::StoreByte(address, value),
            LoadWord(width, target, address) -> Stmt::LoadWord(width, target, address),
            StoreWord(width, address, value) -> Stmt::StoreWord(width, address, value),
            Divide(word, operation, target, left, right) -> Stmt::Divide(word, operation, target, left, right),
        };
    }
}

pub fn rename_funcs(table: List<usize>, missing: usize, funcs: List<Func>) -> List<Func> {
    return match (funcs) {
        Nil -> empty(),
        Cons(func, rest) -> cons(Func { params: func.params, results: func.results, locals: func.locals, body: func.body.rename(table, missing) }, rename_funcs(table, missing, unbox(rest))),
    };
}

// The modules' functions from the one whose first function is first. A
// call to a callee the module does not have becomes a call to missing, the
// program's function count, which no function has.
pub fn resolve_modules(firsts: List<usize>, missing: usize, first: usize, ms: List<Module>) -> List<Func> {
    return match (ms) {
        Nil -> empty(),
        Cons(m, rest) -> concat(rename_funcs(concat(slot_range(first, length(m.funcs)), import_indices(firsts, m.imports)), missing, m.funcs), resolve_modules(firsts, missing, plus(first, length(m.funcs)), unbox(rest))),
    };
}

pub fn func_count(ms: List<Module>) -> usize {
    return match (ms) {
        Nil -> 0,
        Cons(m, rest) -> plus(length(m.funcs), func_count(unbox(rest))),
    };
}

pub fn link_program(ms: List<Module>) -> core::option::Option<Program> {
    if (modules_ok(module_exports(ms), ms)) {
        return Some(Program { funcs: resolve_modules(module_firsts(0, ms), func_count(ms), 0, ms) });
    }
    return None;
}

// Object code: machine code with holes. A piece is literal bytes, or the
// rel32 field of a call to import i, which the linker fills. Calls inside a
// module are already bytes: a module's functions stay together, so the
// distance between two of them is known when it is compiled.
pub enum Piece {
    Bytes(List<u8>),
    Rel(usize),
}

// One function's object code: its prologue and body.
pub struct ObjFunc {
    slots: usize,
    pieces: List<Piece>,
}

// A compiled module: its functions' arities, its imports, and its functions'
// object code, in order.
pub struct Object {
    exports: List<Arity>,
    imports: List<Import>,
    funcs: List<ObjFunc>,
}

// A call to callee from body offset pc. A callee at or past own is an
// import, so its rel32 field is a hole.
pub fn call_pieces(own: usize, place: Place, pc: usize, callee: usize, args: List<usize>, target: usize, count: usize) -> List<Piece> {
    if (callee >= own) {
        return cons(Piece::Bytes(concat(copy_bytes(arg_base(place.slots), args, 0), single(232))), cons(Piece::Rel(minus(callee, own)), single(Piece::Bytes(copy_bytes(target, slot_range(arg_base(place.slots), count), 0)))));
    }
    let call: Instr = Instr::Call(callee, args, target, count);
    return single(Piece::Bytes(call.encode(place, pc)));
}

impl Instr {
    // The object code of the instruction at body offset pc: its bytes, but
    // a call to an import leaves its rel32 field to the linker.
    pub fn pieces(self, own: usize, place: Place, pc: usize) -> List<Piece> {
        return match (self) {
            Imm(value) -> single(Piece::Bytes(self.encode(place, pc))),
            Load(slot) -> single(Piece::Bytes(self.encode(place, pc))),
            Store(slot) -> single(Piece::Bytes(self.encode(place, pc))),
            Instr::Neg -> single(Piece::Bytes(self.encode(place, pc))),
            Op(word, operation, slot) -> single(Piece::Bytes(self.encode(place, pc))),
            Cmp(word, operation, slot) -> single(Piece::Bytes(self.encode(place, pc))),
            Jmp(target) -> single(Piece::Bytes(self.encode(place, pc))),
            Jz(target) -> single(Piece::Bytes(self.encode(place, pc))),
            Instr::Call(callee, args, target, count) -> call_pieces(own, place, pc, callee, args, target, count),
            Instr::Ret(sources) -> single(Piece::Bytes(self.encode(place, pc))),
            Bump(shift) -> single(Piece::Bytes(self.encode(place, pc))),
            LoadAt -> single(Piece::Bytes(self.encode(place, pc))),
            StoreAt(slot) -> single(Piece::Bytes(self.encode(place, pc))),
            LoadWordAt(width) -> single(Piece::Bytes(self.encode(place, pc))),
            StoreWordAt(width, slot) -> single(Piece::Bytes(self.encode(place, pc))),
            Div(word, operation, slot) -> single(Piece::Bytes(self.encode(place, pc))),
        };
    }
}

pub fn pieces_from(own: usize, place: Place, pc: usize, code: List<Instr>) -> List<Piece> {
    return match (code) {
        Nil -> empty(),
        Cons(i, rest) -> concat(i.pieces(own, place, pc), pieces_from(own, place, plus(pc, i.size()), unbox(rest))),
    };
}

// The functions laid out back to back from start inside the module, with
// entries their module offsets.
pub fn object_funcs(own: usize, entries: List<usize>, start: usize, codes: List<Code>) -> List<ObjFunc> {
    return match (codes) {
        Nil -> empty(),
        Cons(code, rest) -> cons(ObjFunc { slots: code.slots, pieces: cons(Piece::Bytes(prologue(code.slots)), pieces_from(own, Place { body: plus(start, 24), slots: code.slots, entries: entries }, 0, code.instrs)) }, object_funcs(own, entries, plus(start, code.size()), unbox(rest))),
    };
}

pub fn import_arities(imports: List<Import>) -> List<Arity> {
    return match (imports) {
        Nil -> empty(),
        Cons(imp, rest) -> cons(imp.arity, import_arities(unbox(rest))),
    };
}

// Compile one module alone: its calls are checked against its own
// functions' arities and its imports' declared ones.
pub fn compile_module(m: Module) -> core::option::Option<Object> {
    return match (compile_funcs(concat(arities(m.funcs), import_arities(m.imports)), m.funcs)) {
        None -> None,
        Some(codes) -> Some(Object { exports: arities(m.funcs), imports: m.imports, funcs: object_funcs(length(m.funcs), layout(0, codes), 0, codes) }),
    };
}

pub fn compile_modules(ms: List<Module>) -> core::option::Option<List<Object>> {
    return match (ms) {
        Nil -> Some(empty()),
        Cons(m, rest) -> match (compile_module(m)) {
            None -> None,
            Some(obj) -> match (compile_modules(unbox(rest))) {
                None -> None,
                Some(objs) -> Some(cons(obj, objs)),
            },
        },
    };
}

// The linker. It checks every import against the objects' exports, lays
// the objects out back to back in order, and fills each hole with the
// distance from the end of its call to the import's entry.
impl Piece {
    pub fn size(self) -> usize {
        return match (self) {
            Bytes(code) -> length(code),
            Rel(index) -> 4,
        };
    }

    // The bytes of the piece at image offset pos; targets are the entries
    // of the object's imports.
    pub fn render(self, targets: List<usize>, pos: usize) -> List<u8> {
        return match (self) {
            Bytes(code) -> code,
            Rel(index) -> le32(relative(plus(pos, 4), get_or(targets, index, 0))),
        };
    }
}

pub fn pieces_size(pieces: List<Piece>) -> usize {
    return match (pieces) {
        Nil -> 0,
        Cons(piece, rest) -> plus(piece.size(), pieces_size(unbox(rest))),
    };
}

pub fn render(targets: List<usize>, pos: usize, pieces: List<Piece>) -> List<u8> {
    return match (pieces) {
        Nil -> empty(),
        Cons(piece, rest) -> concat(piece.render(targets, pos), render(targets, plus(pos, piece.size()), unbox(rest))),
    };
}

pub fn funcs_size(funcs: List<ObjFunc>) -> usize {
    return match (funcs) {
        Nil -> 0,
        Cons(func, rest) -> plus(pieces_size(func.pieces), funcs_size(unbox(rest))),
    };
}

// Entry offsets of an object's functions placed from start.
pub fn object_layout(start: usize, funcs: List<ObjFunc>) -> List<usize> {
    return match (funcs) {
        Nil -> empty(),
        Cons(func, rest) -> cons(start, object_layout(plus(start, pieces_size(func.pieces)), unbox(rest))),
    };
}

// Entry offsets of every function of the objects placed from start.
pub fn objects_layout(start: usize, objs: List<Object>) -> List<usize> {
    return match (objs) {
        Nil -> empty(),
        Cons(obj, rest) -> concat(object_layout(start, obj.funcs), objects_layout(plus(start, funcs_size(obj.funcs)), unbox(rest))),
    };
}

pub fn object_exports(objs: List<Object>) -> List<List<Arity>> {
    return match (objs) {
        Nil -> empty(),
        Cons(obj, rest) -> cons(obj.exports, object_exports(unbox(rest))),
    };
}

pub fn objects_ok(exports: List<List<Arity>>, objs: List<Object>) -> bool {
    return match (objs) {
        Nil -> true,
        Cons(obj, rest) -> imports_ok(exports, obj.imports) && objects_ok(exports, unbox(rest)),
    };
}

// The image index of each object's first function, from first.
pub fn object_firsts(first: usize, objs: List<Object>) -> List<usize> {
    return match (objs) {
        Nil -> empty(),
        Cons(obj, rest) -> cons(first, object_firsts(plus(first, length(obj.funcs)), unbox(rest))),
    };
}

pub fn entries_at(entries: List<usize>, indices: List<usize>) -> List<usize> {
    return match (indices) {
        Nil -> empty(),
        Cons(index, rest) -> cons(get_or(entries, index, 0), entries_at(entries, unbox(rest))),
    };
}

pub fn render_funcs(targets: List<usize>, pos: usize, funcs: List<ObjFunc>) -> List<u8> {
    return match (funcs) {
        Nil -> empty(),
        Cons(func, rest) -> concat(render(targets, pos, func.pieces), render_funcs(targets, plus(pos, pieces_size(func.pieces)), unbox(rest))),
    };
}

pub fn render_objects(firsts: List<usize>, entries: List<usize>, pos: usize, objs: List<Object>) -> List<u8> {
    return match (objs) {
        Nil -> empty(),
        Cons(obj, rest) -> concat(render_funcs(entries_at(entries, import_indices(firsts, obj.imports)), pos, obj.funcs), render_objects(firsts, entries, plus(pos, funcs_size(obj.funcs)), unbox(rest))),
    };
}

pub fn funcs_slots(funcs: List<ObjFunc>) -> List<usize> {
    return match (funcs) {
        Nil -> empty(),
        Cons(func, rest) -> cons(func.slots, funcs_slots(unbox(rest))),
    };
}

pub fn objects_slots(objs: List<Object>) -> List<usize> {
    return match (objs) {
        Nil -> empty(),
        Cons(obj, rest) -> concat(funcs_slots(obj.funcs), objects_slots(unbox(rest))),
    };
}

// A linked program: each function's frame slots, its entry offset, and the
// image.
pub struct Executable {
    slots: List<usize>,
    entries: List<usize>,
    image: List<u8>,
}

pub fn link_objects(objs: List<Object>) -> core::option::Option<Executable> {
    let entries: List<usize> = objects_layout(0, objs);
    let image: List<u8> = render_objects(object_firsts(0, objs), entries, 0, objs);
    if (objects_ok(object_exports(objs), objs) && image_limit() >= length(image)) {
        return Some(Executable { slots: objects_slots(objs), entries: entries, image: image });
    }
    return None;
}

// Source programs: the subset of Lanius Core (formal/Lanius/Core.lean) that
// this compiler accepts. Lanius/Mini/Source.lean gives each its Core program,
// and the top-level theorem is about Core's evaluator on that program.
// Locals are Core variable ids; functions are numbered by position. A struct
// type carries its Core type id and its field types; an enum type carries its
// Core type id and each variant's payload types. Fields and payloads have
// any of these types.

// An unsigned integer type. A value sits zero-extended in its slot.
pub enum UintTy { Uint8, Uint32, Uint64, Usize, Uint16, }

impl UintTy {
    // Its index, for comparing types.
    pub fn code(self) -> usize {
        return match (self) {
            Uint8 -> 0,
            Uint32 -> 1,
            Uint64 -> 2,
            Usize -> 3,
            Uint16 -> 4,
        };
    }

    // The largest value, 2^width - 1.
    pub fn mask(self) -> u64 {
        return match (self) {
            Uint8 -> 255,
            Uint32 -> 4294967295,
            Uint64 -> 18446744073709551615,
            Usize -> 18446744073709551615,
            Uint16 -> 65535,
        };
    }

    // 64 bits wide, so slot arithmetic wraps the same way.
    pub fn is_wide(self) -> bool {
        return match (self) {
            Uint8 -> false,
            Uint32 -> false,
            Uint64 -> true,
            Usize -> true,
            Uint16 -> false,
        };
    }

    // 2^(width - 1), the sign bit of the signed type as wide.
    pub fn half(self) -> u64 {
        return match (self) {
            Uint8 -> 128,
            Uint32 -> 2147483648,
            Uint64 -> 9223372036854775808,
            Usize -> 9223372036854775808,
            Uint16 -> 32768,
        };
    }

    // 32 less the width of a narrow type (none for a wide one).
    pub fn spare(self) -> u64 {
        return match (self) {
            Uint8 -> 24,
            Uint32 -> 0,
            Uint64 -> 0,
            Usize -> 0,
            Uint16 -> 16,
        };
    }

    // The least value of the signed type as wide, as 32-bit two's
    // complement (narrow types only).
    pub fn least_bits(self) -> u64 {
        return match (self) {
            Uint8 -> 4294967168,
            Uint32 -> 2147483648,
            Uint64 -> 0,
            Usize -> 0,
            Uint16 -> 4294934528,
        };
    }

    // How the signed type as wide computes: on 32 bits when narrow.
    pub fn signed_word(self) -> Word {
        if (self.is_wide()) {
            return U64;
        }
        return S32;
    }
}

pub enum SrcType {
    I32,
    Bool,
    Uint(UintTy),
    Struct(usize, Box<List<SrcType>>),
    Enum(usize, Box<List<List<SrcType>>>),
    // a raw pointer into the heap
    Ptr,
    // Core's raw slice of this element type: one slot, its address
    Slice(Box<SrcType>),
    // the unit type: one slot whose bits do not matter
    Unit,
    // a signed 64-bit integer, its two's complement bits in one slot
    Isize,
    // a char, its 32-bit code in one slot
    Char,
    // the signed integer type as wide as kind (i8, i16, i32, i64, isize). A
    // narrow one sits in its slot as an i32 does, its value's 32-bit two's
    // complement zero-extended; a 64-bit one as an isize does.
    Sint(UintTy),
}

pub enum SrcOp {
    Plus, Minus, Times, BitAnd, BitOr, BitXor, ShiftLeft, ShiftRight,
    Less, LessEq, Greater, GreaterEq, Equal, NotEqual,
    LogicalAnd, LogicalOr,
}

pub enum SrcExpr {
    Int(i32),
    Boolean(bool),
    // a literal of an unsigned type
    Unsigned(UintTy, u64),
    Local(usize),
    // field of a struct local
    Field(usize, usize),
    Negate(Box<SrcExpr>),
    Not(Box<SrcExpr>),
    Apply(SrcOp, Box<SrcExpr>, Box<SrcExpr>),
    // between i32 and the unsigned types, wrapping like Core
    Cast(SrcType, Box<SrcExpr>),
    // the null pointer, Core's pointer 0
    Null,
    // a char literal: its code, a Unicode scalar value
    Char(u32),
}

// A match arm: the binders of its variant's payload, and its value.
pub struct SrcArm {
    binders: List<usize>,
    value: SrcExpr,
}

// Division's quotient or remainder, truncating as Core does.
pub enum SrcDivOp { Quotient, Remainder, }

// An expression that may call functions, evaluated in Core's order. The
// ones without calls are SrcExpr, whose proofs go by induction; this type
// nests through List, so its proofs go by Core's fuel instead.
pub enum SrcEff {
    EPure(SrcExpr),
    // callee(args)
    ECall(usize, Box<List<SrcEff>>),
    EApply(SrcOp, Box<SrcEff>, Box<SrcEff>),
    ENeg(Box<SrcEff>),
    ENot(Box<SrcEff>),
    ECast(SrcType, Box<SrcEff>),
    // slice[index] of a slice local
    EIndex(usize, Box<SrcEff>),
    // a struct of type ty
    EStruct(SrcType, Box<List<SrcEff>>),
    // variant(payload) of the enum type ty
    EVariant(SrcType, usize, Box<List<SrcEff>>),
    // match scrutinee { arms } on the enum type ety, with result type ty:
    // arm k's binders and value
    EMatch(Box<SrcEff>, SrcType, SrcType, List<List<usize>>, Box<List<SrcEff>>),
    // left / right or left % right: a statement in the mini IR, so only here
    EDivide(SrcDivOp, Box<SrcEff>, Box<SrcEff>),
    // slice_stride(slice) of a slice local, an isize
    EStride(usize),
}

pub enum SrcStmt {
    Nop,
    // let id: ty = value; then body, with id in scope. A struct value is a
    // struct local.
    Let(usize, SrcType, SrcExpr, Box<SrcStmt>),
    // let id: ty = ty { fields }; then body
    LetStruct(usize, SrcType, List<SrcExpr>, Box<SrcStmt>),
    // let id: ty = callee(args); then body
    LetCall(usize, SrcType, usize, List<SrcExpr>, Box<SrcStmt>),
    // let id: ty = variant(payload) of the enum type ty; then body
    LetEnum(usize, SrcType, usize, List<SrcExpr>, Box<SrcStmt>),
    // let id: ty = match scrutinee { arms }; then body. The scrutinee is a
    // local of the enum type with Core id enum_id, and arm k is variant k.
    LetMatch(usize, SrcType, usize, usize, List<SrcArm>, Box<SrcStmt>),
    Set(usize, SrcExpr),
    // id.field = value
    SetField(usize, usize, SrcExpr),
    // id = callee(args)
    SetCall(usize, usize, List<SrcExpr>),
    Then(Box<SrcStmt>, Box<SrcStmt>),
    If(SrcExpr, Box<SrcStmt>, Box<SrcStmt>),
    While(SrcExpr, Box<SrcStmt>),
    Return(SrcExpr),
    // let id: ptr = alloc(size, 2^shift); then body
    LetAlloc(usize, SrcExpr, usize, Box<SrcStmt>),
    // let id: u8 = load_byte(pointer, offset); then body
    LetLoad(usize, SrcExpr, SrcExpr, Box<SrcStmt>),
    // store_byte(pointer, offset, value)
    SetByte(SrcExpr, SrcExpr, SrcExpr),
    // dealloc(pointer, size, 2^shift)
    Free(SrcExpr, SrcExpr, usize),
    // let id: [element] = slice_from_raw_parts(pointer, length); then body
    LetSlice(usize, SrcType, SrcExpr, SrcExpr, Box<SrcStmt>),
    // let id: ty = slice[index]; then body
    LetIndex(usize, SrcType, usize, SrcExpr, Box<SrcStmt>),
    // slice[index] = value
    SetIndex(usize, SrcExpr, SrcExpr),
    // The forms above with expressions that may call functions.
    LetEval(usize, SrcType, SrcEff, Box<SrcStmt>),
    SetEval(usize, SrcEff),
    IfEval(SrcEff, Box<SrcStmt>, Box<SrcStmt>),
    WhileEval(SrcEff, Box<SrcStmt>),
    ReturnEval(SrcEff),
    // an expression evaluated for its effects
    Discard(SrcEff),
    // slice[index] = value with expressions that may call functions
    SetIndexEval(usize, SrcEff, SrcEff),
    // x.field = value for a scalar field, with a value that may call functions
    SetFieldEval(usize, usize, SrcEff),
    // return; in a unit function
    ReturnUnit,
    // assert(condition): Core traps when it is false
    Assert(SrcEff),
}

pub struct SrcParam {
    id: usize,
    ty: SrcType,
}

pub struct SrcFunc {
    params: List<SrcParam>,
    ret: SrcType,
    body: SrcStmt,
}

pub struct SrcProgram {
    funcs: List<SrcFunc>,
}

// Lowering to the language above. It also type-checks: an ill-typed program
// is rejected, so the theorem needs no typing premise (Core would, for
// example, evaluate true && 5 to 5). A Core local becomes a frame slot: a
// function's parameters are slots 0, 1, ..., and each let takes the next slot
// for its body; a struct takes one slot per field. Booleans are 1 and 0.
// Subset expressions neither trap nor have
// effects, so && and || need no short circuit: a && b is a & b on 0 and 1, and
// a || b is (a | b) != 0.

pub struct Binding {
    id: usize,
    slot: usize,
    ty: SrcType,
}

// The innermost binding of id.
pub fn lookup(scope: List<Binding>, id: usize) -> core::option::Option<Binding> {
    return match (scope) {
        Nil -> None,
        Cons(binding, rest) -> lookup_at(binding, unbox(rest), id),
    };
}

// extract: inline
fn lookup_at(binding: Binding, rest: List<Binding>, id: usize) -> core::option::Option<Binding> {
    if (binding.id == id) {
        return Some(binding);
    }
    return lookup(rest, id);
}

pub fn bool_bits(value: bool) -> u64 {
    if (value) {
        return 1;
    }
    return 0;
}

impl SrcType {
    pub fn is_i32(self) -> bool {
        return match (self) {
            I32 -> true,
            Bool -> false,
            Uint(kind) -> false,
            Struct(id, fields) -> false,
            Enum(id, variants) -> false,
            Ptr -> false,
            Slice(element) -> false,
            Unit -> false,
            Isize -> false,
            SrcType::Char -> false,
            Sint(sk) -> false,
        };
    }

    pub fn is_bool(self) -> bool {
        return match (self) {
            I32 -> false,
            Bool -> true,
            Uint(kind) -> false,
            Struct(id, fields) -> false,
            Enum(id, variants) -> false,
            Ptr -> false,
            Slice(element) -> false,
            Unit -> false,
            Isize -> false,
            SrcType::Char -> false,
            Sint(sk) -> false,
        };
    }

    pub fn is_scalar(self) -> bool {
        return match (self) {
            I32 -> true,
            Bool -> true,
            Uint(kind) -> true,
            Struct(id, fields) -> false,
            Enum(id, variants) -> false,
            Ptr -> true,
            Slice(element) -> false,
            Unit -> false,
            Isize -> true,
            SrcType::Char -> true,
            Sint(kind) -> true,
        };
    }

    pub fn is_uint(self, kind: UintTy) -> bool {
        return match (self) {
            I32 -> false,
            Bool -> false,
            Uint(other) -> other.code() == kind.code(),
            Struct(id, fields) -> false,
            Enum(id, variants) -> false,
            Ptr -> false,
            Slice(element) -> false,
            Unit -> false,
            Isize -> false,
            SrcType::Char -> false,
            Sint(sk) -> false,
        };
    }

    pub fn is_ptr(self) -> bool {
        return match (self) {
            I32 -> false,
            Bool -> false,
            Uint(kind) -> false,
            Struct(id, fields) -> false,
            Enum(id, variants) -> false,
            Ptr -> true,
            Slice(element) -> false,
            Unit -> false,
            Isize -> false,
            SrcType::Char -> false,
            Sint(sk) -> false,
        };
    }

    pub fn is_unit(self) -> bool {
        return match (self) {
            I32 -> false,
            Bool -> false,
            Uint(kind) -> false,
            Struct(id, fields) -> false,
            Enum(id, variants) -> false,
            Ptr -> false,
            Slice(element) -> false,
            Unit -> true,
            Isize -> false,
            SrcType::Char -> false,
            Sint(sk) -> false,
        };
    }

    pub fn is_isize(self) -> bool {
        return match (self) {
            I32 -> false,
            Bool -> false,
            Uint(kind) -> false,
            Struct(id, fields) -> false,
            Enum(id, variants) -> false,
            Ptr -> false,
            Slice(element) -> false,
            Unit -> false,
            Isize -> true,
            SrcType::Char -> false,
            Sint(kind) -> false,
        };
    }

    pub fn is_char(self) -> bool {
        return match (self) {
            I32 -> false,
            Bool -> false,
            Uint(kind) -> false,
            Struct(id, fields) -> false,
            Enum(id, variants) -> false,
            Ptr -> false,
            Slice(element) -> false,
            Unit -> false,
            Isize -> false,
            SrcType::Char -> true,
            Sint(kind) -> false,
        };
    }

    // An integer type: a shift takes an amount of any of them.
    pub fn is_integer(self) -> bool {
        return match (self) {
            I32 -> true,
            Bool -> false,
            Uint(kind) -> true,
            Struct(id, fields) -> false,
            Enum(id, variants) -> false,
            Ptr -> false,
            Slice(element) -> false,
            Unit -> false,
            Isize -> true,
            SrcType::Char -> false,
            Sint(kind) -> true,
        };
    }

    pub fn is_sint_any(self) -> bool {
        return match (self) {
            I32 -> false,
            Bool -> false,
            Uint(kind) -> false,
            Struct(id, fields) -> false,
            Enum(id, variants) -> false,
            Ptr -> false,
            Slice(element) -> false,
            Unit -> false,
            Isize -> false,
            SrcType::Char -> false,
            Sint(kind) -> true,
        };
    }

    pub fn is_sint(self, kind: UintTy) -> bool {
        return match (self) {
            I32 -> false,
            Bool -> false,
            Uint(other) -> false,
            Struct(id, fields) -> false,
            Enum(id, variants) -> false,
            Ptr -> false,
            Slice(element) -> false,
            Unit -> false,
            Isize -> false,
            SrcType::Char -> false,
            Sint(other) -> other.code() == kind.code(),
        };
    }

    // The width of the signed type this is, if it is one of Sint.
    pub fn sint_kind(self) -> core::option::Option<UintTy> {
        return match (self) {
            I32 -> None,
            Bool -> None,
            Uint(kind) -> None,
            Struct(id, fields) -> None,
            Enum(id, variants) -> None,
            Ptr -> None,
            Slice(element) -> None,
            Unit -> None,
            Isize -> None,
            SrcType::Char -> None,
            Sint(kind) -> Some(kind),
        };
    }

    // The unsigned type this is, if it is one.
    pub fn uint_kind(self) -> core::option::Option<UintTy> {
        return match (self) {
            I32 -> None,
            Bool -> None,
            Uint(kind) -> Some(kind),
            Struct(id, fields) -> None,
            Enum(id, variants) -> None,
            Ptr -> None,
            Slice(element) -> None,
            Unit -> None,
            Isize -> None,
            SrcType::Char -> None,
            Sint(sk) -> None,
        };
    }

    // How a comparison of two values of this type reads their slots.
    pub fn word(self) -> Word {
        return match (self) {
            I32 -> S32,
            Bool -> S32,
            Uint(kind) -> U64,
            Struct(id, fields) -> S32,
            Enum(id, variants) -> S32,
            Ptr -> U64,
            Slice(element) -> U64,
            Unit -> S32,
            Isize -> U64,
            SrcType::Char -> U64,
            Sint(kind) -> kind.signed_word(),
        };
    }
}

// extract: mutual begin
impl SrcType {
    pub fn same(self, other: SrcType) -> bool {
        return match (self) {
            I32 -> other.is_i32(),
            Bool -> other.is_bool(),
            Uint(kind) -> other.is_uint(kind),
            Struct(id, fields) -> match (other) {
                I32 -> false,
                Bool -> false,
                Uint(other_kind) -> false,
                Struct(other_id, other_fields) -> (id == other_id) && types_same(unbox(fields), unbox(other_fields)),
                Enum(other_id, other_variants) -> false,
                Ptr -> false,
                Slice(other_element) -> false,
                Unit -> false,
                Isize -> false,
                SrcType::Char -> false,
                Sint(other_sk) -> false,
            },
            Enum(id, variants) -> match (other) {
                I32 -> false,
                Bool -> false,
                Uint(other_kind) -> false,
                Struct(other_id, other_fields) -> false,
                Enum(other_id, other_variants) -> (id == other_id) && variants_same(unbox(variants), unbox(other_variants)),
                Ptr -> false,
                Slice(other_element) -> false,
                Unit -> false,
                Isize -> false,
                SrcType::Char -> false,
                Sint(other_sk) -> false,
            },
            Ptr -> other.is_ptr(),
            Slice(element) -> match (other) {
                I32 -> false,
                Bool -> false,
                Uint(other_kind) -> false,
                Struct(other_id, other_fields) -> false,
                Enum(other_id, other_variants) -> false,
                Ptr -> false,
                Slice(other_element) -> unbox(element).same(unbox(other_element)),
                Unit -> false,
                Isize -> false,
                SrcType::Char -> false,
                Sint(other_sk) -> false,
            },
            Unit -> other.is_unit(),
            Isize -> other.is_isize(),
            SrcType::Char -> other.is_char(),
            Sint(kind) -> other.is_sint(kind),
        };
    }
}

pub fn types_same(types: List<SrcType>, others: List<SrcType>) -> bool {
    return match (types) {
        Nil -> match (others) {
            Nil -> true,
            Cons(other, more) -> false,
        },
        Cons(ty, rest) -> match (others) {
            Nil -> false,
            Cons(other, more) -> ty.same(other) && types_same(unbox(rest), unbox(more)),
        },
    };
}

pub fn variants_same(variants: List<List<SrcType>>, others: List<List<SrcType>>) -> bool {
    return match (variants) {
        Nil -> match (others) {
            Nil -> true,
            Cons(other, more) -> false,
        },
        Cons(types, rest) -> match (others) {
            Nil -> false,
            Cons(other, more) -> types_same(types, other) && variants_same(unbox(rest), unbox(more)),
        },
    };
}
// extract: mutual end

// extract: mutual begin
impl SrcType {
    // Slots a value of this type takes: a struct's fields in order; an enum's
    // tag, then room for its largest payload.
    pub fn size(self) -> usize {
        return match (self) {
            I32 -> 1,
            Bool -> 1,
            Uint(kind) -> 1,
            Struct(id, fields) -> sizes(unbox(fields)),
            Enum(id, variants) -> plus(1, max_size(unbox(variants))),
            Ptr -> 1,
            Slice(element) -> 2,
            Unit -> 1,
            Isize -> 1,
            SrcType::Char -> 1,
            Sint(kind) -> 1,
        };
    }
}

pub fn sizes(types: List<SrcType>) -> usize {
    return match (types) {
        Nil -> 0,
        Cons(ty, rest) -> plus(ty.size(), sizes(unbox(rest))),
    };
}

// The largest payload.
pub fn max_size(variants: List<List<SrcType>>) -> usize {
    return match (variants) {
        Nil -> 0,
        Cons(types, rest) -> max_of(sizes(types), max_size(unbox(rest))),
    };
}
// extract: mutual end

// The slot of field index, counted from the struct's first slot.
pub fn field_offset(types: List<SrcType>, index: usize) -> usize {
    return match (types) {
        Nil -> 0,
        Cons(ty, rest) -> offset_after(ty, unbox(rest), index),
    };
}

// extract: inline
fn offset_after(ty: SrcType, rest: List<SrcType>, index: usize) -> usize {
    if (index == 0) {
        return 0;
    }
    return plus(ty.size(), field_offset(rest, minus(index, 1)));
}

// A lowered expression and its source type.
pub struct Typed {
    expr: Expr,
    ty: SrcType,
}

// e reduced to the width of kind.
pub fn wrap(kind: UintTy, e: Expr) -> Expr {
    if (kind.is_wide()) {
        return e;
    }
    return Binary(U64, And, boxed(e), boxed(Lit(kind.mask())));
}

// The low bits of e as wide as kind, sign-extended to 32 bits: a narrow
// signed value's slot from any bits with the same low bits. The shift left
// drops the bits above the width and the arithmetic shift back copies the
// sign bit down.
pub fn norm(kind: UintTy, e: Expr) -> Expr {
    return Binary(S32, Sar, boxed(Binary(S32, Shl, boxed(e), boxed(Lit(kind.spare())))), boxed(Lit(kind.spare())));
}

pub fn arith_uint(operation: BinOp, left: Typed, right: Typed, kind: core::option::Option<UintTy>) -> core::option::Option<Typed> {
    return match (kind) {
        None -> None,
        Some(k) -> arith_of(operation, left, right, k),
    };
}

// extract: inline
fn arith_of(operation: BinOp, left: Typed, right: Typed, k: UintTy) -> core::option::Option<Typed> {
    if (right.ty.is_uint(k)) {
        return Some(Typed { expr: wrap(k, Binary(U64, operation, boxed(left.expr), boxed(right.expr))), ty: Uint(k) });
    }
    return None;
}

pub fn arith_sint(operation: BinOp, left: Typed, right: Typed, kind: core::option::Option<UintTy>) -> core::option::Option<Typed> {
    return match (kind) {
        None -> None,
        Some(k) -> arith_signed_of(operation, left, right, k),
    };
}

// A narrow signed type computes on 32 bits and keeps the low bits of the
// result, sign-extended; a 64-bit one computes on the bits as isize does.
// extract: inline
fn arith_signed_of(operation: BinOp, left: Typed, right: Typed, k: UintTy) -> core::option::Option<Typed> {
    if (right.ty.is_sint(k) && k.is_wide()) {
        return Some(Typed { expr: Binary(U64, operation, boxed(left.expr), boxed(right.expr)), ty: Sint(k) });
    }
    if (right.ty.is_sint(k)) {
        return Some(Typed { expr: norm(k, Binary(S32, operation, boxed(left.expr), boxed(right.expr))), ty: Sint(k) });
    }
    return None;
}

// isize arithmetic is 64-bit arithmetic on the bits, which wraps as Core's
// two's complement does.
pub fn arith(operation: BinOp, left: Typed, right: Typed) -> core::option::Option<Typed> {
    if (left.ty.is_i32() && right.ty.is_i32()) {
        return Some(Typed { expr: Binary(S32, operation, boxed(left.expr), boxed(right.expr)), ty: I32 });
    }
    if (left.ty.is_isize() && right.ty.is_isize()) {
        return Some(Typed { expr: Binary(U64, operation, boxed(left.expr), boxed(right.expr)), ty: Isize });
    }
    if (left.ty.is_sint_any()) {
        return arith_sint(operation, left, right, left.ty.sint_kind());
    }
    return arith_uint(operation, left, right, left.ty.uint_kind());
}

// A shift's amount may be of any integer type. Core traps unless it is below
// the left operand's width, and then its slot holds the same number as the
// left operand's type would, so it is lowered as that type.
pub fn lower_shift(operation: BinOp, left: Typed, right: Typed) -> core::option::Option<Typed> {
    if (left.ty.is_integer() && right.ty.is_integer()) {
        return arith(operation, left, Typed { expr: right.expr, ty: left.ty });
    }
    return None;
}

// >> is arithmetic on the signed types, logical on the unsigned ones. Core
// traps on an amount outside the type's bits, so the low bits x86 keeps are
// the whole amount.
pub fn arith_shift_right(left: Typed, right: Typed) -> core::option::Option<Typed> {
    if (left.ty.is_i32() || left.ty.is_isize() || left.ty.is_sint_any()) {
        return lower_shift(Sar, left, right);
    }
    return lower_shift(Shr, left, right);
}

// ptr + usize and ptr - usize move the address, wrapping at 2^64 like
// Core's pointerOffset; other operands are arithmetic.
pub fn offset_or_arith(operation: BinOp, left: Typed, right: Typed) -> core::option::Option<Typed> {
    if (left.ty.is_ptr() && right.ty.is_uint(Usize)) {
        return Some(Typed { expr: Binary(U64, operation, boxed(left.expr), boxed(right.expr)), ty: Ptr });
    }
    return arith(operation, left, right);
}

pub fn order_uint(operation: CmpOp, left: Typed, right: Typed, kind: core::option::Option<UintTy>) -> core::option::Option<Typed> {
    return match (kind) {
        None -> None,
        Some(k) -> order_of(operation, left, right, k),
    };
}

// extract: inline
fn order_of(operation: CmpOp, left: Typed, right: Typed, k: UintTy) -> core::option::Option<Typed> {
    if (right.ty.is_uint(k)) {
        return Some(Typed { expr: Compare(U64, operation, boxed(left.expr), boxed(right.expr)), ty: Bool });
    }
    return None;
}

// An isize's bits plus 2^63, which flips the sign bit and so orders isizes
// as unsigned numbers in their signed order.
pub fn sign_key(e: Expr) -> Expr {
    return Binary(U64, Add, boxed(e), boxed(Lit(9223372036854775808)));
}

pub fn order_sint(operation: CmpOp, left: Typed, right: Typed, kind: core::option::Option<UintTy>) -> core::option::Option<Typed> {
    return match (kind) {
        None -> None,
        Some(k) -> order_signed_of(operation, left, right, k),
    };
}

// A narrow signed type compares as i32, a 64-bit one as isize.
// extract: inline
fn order_signed_of(operation: CmpOp, left: Typed, right: Typed, k: UintTy) -> core::option::Option<Typed> {
    if (right.ty.is_sint(k) && k.is_wide()) {
        return Some(Typed { expr: Compare(U64, operation, boxed(sign_key(left.expr)), boxed(sign_key(right.expr))), ty: Bool });
    }
    if (right.ty.is_sint(k)) {
        return Some(Typed { expr: Compare(S32, operation, boxed(left.expr), boxed(right.expr)), ty: Bool });
    }
    return None;
}

pub fn order(operation: CmpOp, left: Typed, right: Typed) -> core::option::Option<Typed> {
    if (left.ty.is_i32() && right.ty.is_i32()) {
        return Some(Typed { expr: Compare(S32, operation, boxed(left.expr), boxed(right.expr)), ty: Bool });
    }
    if (left.ty.is_isize() && right.ty.is_isize()) {
        return Some(Typed { expr: Compare(U64, operation, boxed(sign_key(left.expr)), boxed(sign_key(right.expr))), ty: Bool });
    }
    if (left.ty.is_sint_any()) {
        return order_sint(operation, left, right, left.ty.sint_kind());
    }
    if (left.ty.is_char() && right.ty.is_char()) {
        return Some(Typed { expr: Compare(U64, operation, boxed(left.expr), boxed(right.expr)), ty: Bool });
    }
    return order_uint(operation, left, right, left.ty.uint_kind());
}

pub fn equality(operation: CmpOp, left: Typed, right: Typed) -> core::option::Option<Typed> {
    if (left.ty.same(right.ty)) {
        return Some(Typed { expr: Compare(left.ty.word(), operation, boxed(left.expr), boxed(right.expr)), ty: Bool });
    }
    return None;
}

pub fn conjunction(left: Typed, right: Typed) -> core::option::Option<Typed> {
    if (left.ty.is_bool() && right.ty.is_bool()) {
        return Some(Typed { expr: Binary(S32, And, boxed(left.expr), boxed(right.expr)), ty: Bool });
    }
    return None;
}

pub fn disjunction(left: Typed, right: Typed) -> core::option::Option<Typed> {
    if (left.ty.is_bool() && right.ty.is_bool()) {
        let either: Expr = Binary(S32, Or, boxed(left.expr), boxed(right.expr));
        return Some(Typed { expr: Compare(S32, Ne, boxed(either), boxed(Lit(0))), ty: Bool });
    }
    return None;
}

impl SrcOp {
    pub fn lower(self, left: Typed, right: Typed) -> core::option::Option<Typed> {
        return match (self) {
            Plus -> offset_or_arith(Add, left, right),
            Minus -> offset_or_arith(Sub, left, right),
            Times -> arith(Mul, left, right),
            BitAnd -> arith(And, left, right),
            BitOr -> arith(Or, left, right),
            BitXor -> arith(Xor, left, right),
            ShiftLeft -> lower_shift(Shl, left, right),
            ShiftRight -> arith_shift_right(left, right),
            Less -> order(Lt, left, right),
            LessEq -> order(Le, left, right),
            Greater -> order(Gt, left, right),
            GreaterEq -> order(Ge, left, right),
            Equal -> equality(Eq, left, right),
            NotEqual -> equality(Ne, left, right),
            LogicalAnd -> conjunction(left, right),
            LogicalOr -> disjunction(left, right),
        };
    }
}

pub fn lower_scalar_local(b: Binding) -> core::option::Option<Typed> {
    if (b.ty.is_scalar()) {
        return Some(Typed { expr: Var(b.slot), ty: b.ty });
    }
    return None;
}

pub fn lower_local(binding: core::option::Option<Binding>) -> core::option::Option<Typed> {
    return match (binding) {
        None -> None,
        Some(b) -> lower_scalar_local(b),
    };
}

// A field read is a scalar field's slot.
pub fn lower_field_at(slot: usize, found: core::option::Option<SrcType>) -> core::option::Option<Typed> {
    return match (found) {
        None -> None,
        Some(ty) -> lower_scalar_slot(slot, ty),
    };
}

// extract: inline
fn lower_scalar_slot(slot: usize, ty: SrcType) -> core::option::Option<Typed> {
    if (ty.is_scalar()) {
        return Some(Typed { expr: Var(slot), ty: ty });
    }
    return None;
}

pub fn lower_field_of(b: Binding, field: usize) -> core::option::Option<Typed> {
    return match (b.ty) {
        I32 -> None,
        Bool -> None,
        Uint(kind) -> None,
        Struct(id, fields) -> lower_field_at(plus(b.slot, field_offset(unbox(fields), field)), get(unbox(fields), field)),
        Enum(id, variants) -> None,
        Ptr -> None,
        Slice(element) -> None,
        Unit -> None,
        Isize -> None,
        SrcType::Char -> None,
        Sint(sk) -> None,
    };
}

pub fn lower_field(binding: core::option::Option<Binding>, field: usize) -> core::option::Option<Typed> {
    return match (binding) {
        None -> None,
        Some(b) -> lower_field_of(b, field),
    };
}

// -e for the signed type as wide as kind.
pub fn negate_signed(kind: UintTy, e: Expr) -> Expr {
    if (kind.is_wide()) {
        return Binary(U64, Sub, boxed(Lit(0)), boxed(e));
    }
    return norm(kind, Expr::Neg(boxed(e)));
}

pub fn lower_negate_typed(operand: Typed) -> core::option::Option<Typed> {
    if (operand.ty.is_i32()) {
        return Some(Typed { expr: Expr::Neg(boxed(operand.expr)), ty: I32 });
    }
    if (operand.ty.is_isize()) {
        return Some(Typed { expr: Binary(U64, Sub, boxed(Lit(0)), boxed(operand.expr)), ty: Isize });
    }
    return match (operand.ty.sint_kind()) {
        None -> None,
        Some(k) -> Some(Typed { expr: negate_signed(k, operand.expr), ty: Sint(k) }),
    };
}

pub fn lower_negate(operand: core::option::Option<Typed>) -> core::option::Option<Typed> {
    return match (operand) {
        None -> None,
        Some(e) -> lower_negate_typed(e),
    };
}

pub fn lower_not_typed(operand: Typed) -> core::option::Option<Typed> {
    if (operand.ty.is_bool()) {
        return Some(Typed { expr: Compare(S32, Eq, boxed(operand.expr), boxed(Lit(0))), ty: Bool });
    }
    return None;
}

pub fn lower_not(operand: core::option::Option<Typed>) -> core::option::Option<Typed> {
    return match (operand) {
        None -> None,
        Some(e) -> lower_not_typed(e),
    };
}

pub fn lower_unsigned(kind: UintTy, value: u64) -> core::option::Option<Typed> {
    if (value <= kind.mask()) {
        return Some(Typed { expr: Lit(value), ty: Uint(kind) });
    }
    return None;
}

// An i32's bits as a value of kind: the low bits, or for 64 bits
// sign-extended (minus 2^32 when the sign bit is set).
pub fn from_i32(kind: UintTy, e: Expr) -> Expr {
    if (kind.is_wide()) {
        let negative: Expr = Compare(U64, Ge, boxed(e), boxed(Lit(2147483648)));
        return Binary(U64, Sub, boxed(e), boxed(Binary(U64, Mul, boxed(negative), boxed(Lit(4294967296)))));
    }
    return wrap(kind, e);
}

// The signed type's value from the bits e, as an i32's bits: the low 32
// bits, or e itself when narrow.
pub fn sint_to_i32(kind: UintTy, e: Expr) -> Expr {
    if (kind.is_wide()) {
        return wrap(Uint32, e);
    }
    return e;
}

// The signed type's value from the bits e, as an unsigned value of kind.
pub fn sint_to_uint(source: UintTy, kind: UintTy, e: Expr) -> Expr {
    if (source.is_wide()) {
        return wrap(kind, e);
    }
    return from_i32(kind, e);
}

// The signed type's value from the bits e, as 64-bit two's complement.
pub fn sint_to_wide(kind: UintTy, e: Expr) -> Expr {
    if (kind.is_wide()) {
        return e;
    }
    return from_i32(Uint64, e);
}

pub fn cast_to_i32(e: Typed) -> core::option::Option<Typed> {
    return match (e.ty) {
        I32 -> Some(e),
        Bool -> None,
        Uint(kind) -> Some(Typed { expr: wrap(Uint32, e.expr), ty: I32 }),
        Struct(id, fields) -> None,
        Enum(id, variants) -> None,
        Ptr -> None,
        Slice(element) -> None,
        Unit -> None,
        Isize -> Some(Typed { expr: wrap(Uint32, e.expr), ty: I32 }),
        SrcType::Char -> Some(Typed { expr: wrap(Uint32, e.expr), ty: I32 }),
        Sint(kind) -> Some(Typed { expr: sint_to_i32(kind, e.expr), ty: I32 }),
    };
}

pub fn cast_to_uint(kind: UintTy, e: Typed) -> core::option::Option<Typed> {
    return match (e.ty) {
        I32 -> Some(Typed { expr: from_i32(kind, e.expr), ty: Uint(kind) }),
        Bool -> None,
        Uint(source) -> Some(Typed { expr: wrap(kind, e.expr), ty: Uint(kind) }),
        Struct(id, fields) -> None,
        Enum(id, variants) -> None,
        Ptr -> None,
        Slice(element) -> None,
        Unit -> None,
        Isize -> Some(Typed { expr: wrap(kind, e.expr), ty: Uint(kind) }),
        SrcType::Char -> Some(Typed { expr: wrap(kind, e.expr), ty: Uint(kind) }),
        Sint(source) -> Some(Typed { expr: sint_to_uint(source, kind, e.expr), ty: Uint(kind) }),
    };
}

// To isize: an i32 sign-extends; an unsigned value's bits stay, which is
// Core's wrap at 2^64.
pub fn cast_to_isize(e: Typed) -> core::option::Option<Typed> {
    return match (e.ty) {
        I32 -> Some(Typed { expr: from_i32(Uint64, e.expr), ty: Isize }),
        Bool -> None,
        Uint(kind) -> Some(Typed { expr: e.expr, ty: Isize }),
        Struct(id, fields) -> None,
        Enum(id, variants) -> None,
        Ptr -> None,
        Slice(element) -> None,
        Unit -> None,
        Isize -> Some(e),
        SrcType::Char -> Some(Typed { expr: e.expr, ty: Isize }),
        Sint(source) -> Some(Typed { expr: sint_to_wide(source, e.expr), ty: Isize }),
    };
}

// To a signed type: a narrow one keeps the low bits, sign-extended; a 64-bit
// one sign-extends a narrower signed value and keeps an unsigned value's bits.
pub fn cast_to_sint(kind: UintTy, e: Typed) -> core::option::Option<Typed> {
    if (kind.is_wide()) {
        return match (cast_to_isize(e)) {
            None -> None,
            Some(t) -> Some(Typed { expr: t.expr, ty: Sint(kind) }),
        };
    }
    if (e.ty.is_scalar() && !e.ty.is_bool() && !e.ty.is_ptr()) {
        return Some(Typed { expr: norm(kind, e.expr), ty: Sint(kind) });
    }
    return None;
}

pub fn cast_to(ty: SrcType, e: Typed) -> core::option::Option<Typed> {
    return match (ty) {
        I32 -> cast_to_i32(e),
        Bool -> None,
        Uint(kind) -> cast_to_uint(kind, e),
        Struct(id, fields) -> None,
        Enum(id, variants) -> None,
        Ptr -> None,
        Slice(element) -> None,
        Unit -> None,
        Isize -> cast_to_isize(e),
        SrcType::Char -> None,
        Sint(kind) -> cast_to_sint(kind, e),
    };
}

pub fn lower_cast(ty: SrcType, operand: core::option::Option<Typed>) -> core::option::Option<Typed> {
    return match (operand) {
        None -> None,
        Some(e) -> cast_to(ty, e),
    };
}

pub fn lower_apply(op: SrcOp, left: core::option::Option<Typed>, right: core::option::Option<Typed>) -> core::option::Option<Typed> {
    return match (left) {
        None -> None,
        Some(l) -> match (right) {
            None -> None,
            Some(r) -> op.lower(l, r),
        },
    };
}

impl SrcExpr {
    pub fn lower(self, scope: List<Binding>) -> core::option::Option<Typed> {
        return match (self) {
            Int(value) -> Some(Typed { expr: Lit((value as u32) as u64), ty: I32 }),
            Boolean(value) -> Some(Typed { expr: Lit(bool_bits(value)), ty: Bool }),
            Unsigned(kind, value) -> lower_unsigned(kind, value),
            Local(id) -> lower_local(lookup(scope, id)),
            Field(id, index) -> lower_field(lookup(scope, id), index),
            Negate(operand) -> lower_negate(unbox(operand).lower(scope)),
            Not(operand) -> lower_not(unbox(operand).lower(scope)),
            Apply(op, left, right) -> lower_apply(op, unbox(left).lower(scope), unbox(right).lower(scope)),
            Cast(ty, operand) -> lower_cast(ty, unbox(operand).lower(scope)),
            Null -> Some(Typed { expr: Lit(0), ty: Ptr }),
            SrcExpr::Char(code) -> Some(Typed { expr: Lit(code as u64), ty: SrcType::Char }),
        };
    }
}

// Checked shifts. Core traps on a shift amount outside 0..bits of the
// operand type, where x86 masks the amount, so the code first divides 1 by a
// guard: a word that is 1 when every shift Core evaluates has its amount in
// range, and 0 otherwise. A guard that is Lit(1) emits no check.

// The literal 1.
pub fn is_one(e: Expr) -> bool {
    return match (e) {
        Lit(value) -> value == 1,
        Var(slot) -> false,
        Expr::Neg(operand) -> false,
        Binary(word, operation, left, right) -> false,
        Compare(word, operation, left, right) -> false,
    };
}

// Both guards hold.
pub fn guard_and(a: Expr, b: Expr) -> Expr {
    if (is_one(a)) {
        return b;
    }
    if (is_one(b)) {
        return a;
    }
    return Binary(U64, And, boxed(a), boxed(b));
}

// Either word is nonzero, as 1 or 0.
pub fn guard_or(a: Expr, b: Expr) -> Expr {
    if (is_one(a) || is_one(b)) {
        return Lit(1);
    }
    return Compare(U64, Ne, boxed(Binary(U64, Or, boxed(a), boxed(b))), boxed(Lit(0)));
}

impl UintTy {
    // Its width in bits.
    pub fn bits(self) -> u64 {
        return match (self) {
            Uint8 -> 8,
            Uint32 -> 32,
            Uint64 -> 64,
            Usize -> 64,
            Uint16 -> 16,
        };
    }
}


// The bits of a shift's operand type.
pub fn shift_width(ty: SrcType) -> u64 {
    return match (ty) {
        I32 -> 32,
        Bool -> 64,
        Uint(kind) -> kind.bits(),
        Struct(id, fields) -> 64,
        Enum(id, variants) -> 64,
        Ptr -> 64,
        Slice(element) -> 64,
        Unit -> 64,
        Isize -> 64,
        SrcType::Char -> 32,
        Sint(kind) -> kind.bits(),
    };
}

// A literal amount below width.
pub fn literal_below(amount: Expr, width: u64) -> bool {
    return match (amount) {
        Lit(value) -> value < width,
        Var(slot) -> false,
        Expr::Neg(operand) -> false,
        Binary(word, operation, left, right) -> false,
        Compare(word, operation, left, right) -> false,
    };
}

// amount below width, compared as unsigned words: a negative i32 or isize
// amount is a large word. A literal amount below width needs no check.
pub fn amount_guard(width: u64, amount: Expr) -> Expr {
    if (literal_below(amount, width)) {
        return Lit(1);
    }
    return Compare(U64, Lt, boxed(amount), boxed(Lit(width)));
}

// The guard of a shift of left by right, both lowered.
pub fn shift_guard(left: core::option::Option<Typed>, right: core::option::Option<Typed>) -> Expr {
    return match (left) {
        None -> Lit(1),
        Some(l) -> match (right) {
            None -> Lit(1),
            Some(r) -> amount_guard(shift_width(l.ty), r.expr),
        },
    };
}

// The left operand of && is false, as 1 or 0.
pub fn left_false(left: core::option::Option<Typed>) -> Expr {
    return match (left) {
        None -> Lit(1),
        Some(l) -> Compare(U64, Eq, boxed(l.expr), boxed(Lit(0))),
    };
}

// The left operand of || is true.
pub fn left_true(left: core::option::Option<Typed>) -> Expr {
    return match (left) {
        None -> Lit(1),
        Some(l) -> l.expr,
    };
}

// The guard of op on two operands with guards gl and gr: Core skips the right
// operand of && and || when the left one decides.
pub fn apply_guard(op: SrcOp, left: core::option::Option<Typed>, right: core::option::Option<Typed>, gl: Expr, gr: Expr) -> Expr {
    return match (op) {
        Plus -> guard_and(gl, gr),
        Minus -> guard_and(gl, gr),
        Times -> guard_and(gl, gr),
        BitAnd -> guard_and(gl, gr),
        BitOr -> guard_and(gl, gr),
        BitXor -> guard_and(gl, gr),
        ShiftLeft -> guard_and(guard_and(gl, gr), shift_guard(left, right)),
        ShiftRight -> guard_and(guard_and(gl, gr), shift_guard(left, right)),
        Less -> guard_and(gl, gr),
        LessEq -> guard_and(gl, gr),
        Greater -> guard_and(gl, gr),
        GreaterEq -> guard_and(gl, gr),
        Equal -> guard_and(gl, gr),
        NotEqual -> guard_and(gl, gr),
        LogicalAnd -> guard_and(gl, guard_or(left_false(left), gr)),
        LogicalOr -> guard_and(gl, guard_or(left_true(left), gr)),
    };
}

impl SrcExpr {
    // The expression's guard: 1 when every shift Core evaluates in it has
    // its amount in range.
    pub fn guard(self, scope: List<Binding>) -> Expr {
        return match (self) {
            Int(value) -> Lit(1),
            Boolean(value) -> Lit(1),
            Unsigned(kind, value) -> Lit(1),
            Local(id) -> Lit(1),
            Field(id, index) -> Lit(1),
            Negate(operand) -> unbox(operand).guard(scope),
            Not(operand) -> unbox(operand).guard(scope),
            Apply(op, left, right) -> apply_guard(op, unbox(left).lower(scope), unbox(right).lower(scope), unbox(left).guard(scope), unbox(right).guard(scope)),
            Cast(ty, operand) -> unbox(operand).guard(scope),
            Null -> Lit(1),
            SrcExpr::Char(code) -> Lit(1),
        };
    }
}

// The guards of expressions Core evaluates one after another.
pub fn guard_all(scope: List<Binding>, es: List<SrcExpr>) -> Expr {
    return match (es) {
        Nil -> Lit(1),
        Cons(e, rest) -> guard_and(e.guard(scope), guard_all(scope, unbox(rest))),
    };
}

// 1 / 0 into slot: a division fault.
pub fn trap(slot: usize) -> Stmt {
    return Stmt::Divide(U64, UDiv, slot, Lit(1), Lit(0));
}

// The check of g, then s: s when g is nonzero, else the trap.
pub fn check_then(slot: usize, g: Expr, s: Stmt) -> Stmt {
    if (is_one(g)) {
        return s;
    }
    return Ite(g, boxed(s), boxed(trap(slot)));
}

// s, then the check of g.
pub fn then_check(slot: usize, g: Expr, s: Stmt) -> Stmt {
    if (is_one(g)) {
        return s;
    }
    return Seq(boxed(s), boxed(Ite(g, boxed(Skip), boxed(trap(slot)))));
}

// The index i below the length of the slice local b, which a slice keeps
// in its second slot. An i32 index below 0 is a word of at least 2^31, and a
// length is below 2^31.
pub fn bounds_guard(b: Binding, i: Expr) -> Expr {
    return Compare(U64, Lt, boxed(i), boxed(Var(plus(b.slot, 1))));
}

pub fn guarded(slot: usize, g: Expr, s: core::option::Option<Stmt>) -> core::option::Option<Stmt> {
    return match (s) {
        None -> None,
        Some(b) -> Some(check_then(slot, g, b)),
    };
}

pub fn expect_type(typed: Typed, ty: SrcType) -> core::option::Option<Expr> {
    if (typed.ty.same(ty)) {
        return Some(typed.expr);
    }
    return None;
}

// The expression, if it lowers and has type ty.
pub fn lower_as(scope: List<Binding>, e: SrcExpr, ty: SrcType) -> core::option::Option<Expr> {
    return match (e.lower(scope)) {
        None -> None,
        Some(typed) -> expect_type(typed, ty),
    };
}

pub fn lower_append(first: core::option::Option<List<Expr>>, rest: core::option::Option<List<Expr>>) -> core::option::Option<List<Expr>> {
    return match (first) {
        None -> None,
        Some(es) -> match (rest) {
            None -> None,
            Some(more) -> Some(concat(es, more)),
        },
    };
}

// Var(slot), Var(slot + 1), ..., count of them.
pub fn slot_vars(slot: usize, count: usize) -> List<Expr> {
    if (count == 0) {
        return empty();
    }
    return cons(Var(slot), slot_vars(plus(slot, 1), minus(count, 1)));
}

pub fn copy_binding(binding: core::option::Option<Binding>, ty: SrcType) -> core::option::Option<List<Expr>> {
    return match (binding) {
        None -> None,
        Some(b) -> copy_same(b, ty),
    };
}

// extract: inline
fn copy_same(b: Binding, ty: SrcType) -> core::option::Option<List<Expr>> {
    if (b.ty.same(ty)) {
        return Some(slot_vars(b.slot, b.ty.size()));
    }
    return None;
}

// extract: inline
fn copy_slots(slot: usize, field: SrcType, ty: SrcType) -> core::option::Option<List<Expr>> {
    if (field.same(ty) && (field.size() > 0)) {
        return Some(slot_vars(slot, field.size()));
    }
    return None;
}

pub fn copy_field_at(slot: usize, found: core::option::Option<SrcType>, ty: SrcType) -> core::option::Option<List<Expr>> {
    return match (found) {
        None -> None,
        Some(field) -> copy_slots(slot, field, ty),
    };
}

pub fn copy_field_of(b: Binding, index: usize, ty: SrcType) -> core::option::Option<List<Expr>> {
    return match (b.ty) {
        I32 -> None,
        Bool -> None,
        Uint(kind) -> None,
        Struct(id, fields) -> copy_field_at(plus(b.slot, field_offset(unbox(fields), index)), get(unbox(fields), index), ty),
        Enum(id, variants) -> None,
        Ptr -> None,
        Slice(element) -> None,
        Unit -> None,
        Isize -> None,
        SrcType::Char -> None,
        Sint(sk) -> None,
    };
}

// A field of type ty of a struct local, slot by slot. It takes slots.
pub fn copy_field(binding: core::option::Option<Binding>, index: usize, ty: SrcType) -> core::option::Option<List<Expr>> {
    return match (binding) {
        None -> None,
        Some(b) -> copy_field_of(b, index, ty),
    };
}

// An aggregate value: a local or a field of that type, slot by slot.
pub fn lower_copy(scope: List<Binding>, e: SrcExpr, ty: SrcType) -> core::option::Option<List<Expr>> {
    return match (e) {
        Int(value) -> None,
        Boolean(value) -> None,
        Unsigned(kind, value) -> None,
        Local(id) -> copy_binding(lookup(scope, id), ty),
        Field(id, index) -> copy_field(lookup(scope, id), index, ty),
        Negate(operand) -> None,
        Not(operand) -> None,
        Apply(op, left, right) -> None,
        Cast(target, operand) -> None,
        Null -> None,
        SrcExpr::Char(code) -> None,
    };
}

pub fn lower_single(value: core::option::Option<Expr>) -> core::option::Option<List<Expr>> {
    return match (value) {
        None -> None,
        Some(x) -> Some(single(x)),
    };
}

// A value of type ty, one expression per slot.
pub fn lower_value(scope: List<Binding>, e: SrcExpr, ty: SrcType) -> core::option::Option<List<Expr>> {
    if (ty.is_scalar()) {
        return lower_single(lower_as(scope, e, ty));
    }
    return lower_copy(scope, e, ty);
}

// The arguments, if there is one of each parameter type, slot by slot.
pub fn lower_args(scope: List<Binding>, args: List<SrcExpr>, types: List<SrcType>) -> core::option::Option<List<Expr>> {
    return match (args) {
        Nil -> match (types) {
            Nil -> Some(empty()),
            Cons(ty, more) -> None,
        },
        Cons(arg, rest) -> match (types) {
            Nil -> None,
            Cons(ty, more) -> lower_append(lower_value(scope, arg, ty), lower_args(scope, unbox(rest), unbox(more))),
        },
    };
}

// A struct literal's fields are like arguments, one of each field type.
// A struct value takes slots, so every binding has its own.
pub fn lower_struct_fields(scope: List<Binding>, fields: List<SrcExpr>, types: List<SrcType>) -> core::option::Option<List<Expr>> {
    if (sizes(types) == 0) {
        return None;
    }
    return lower_args(scope, fields, types);
}

pub fn lower_literal(scope: List<Binding>, ty: SrcType, fields: List<SrcExpr>) -> core::option::Option<List<Expr>> {
    return match (ty) {
        I32 -> None,
        Bool -> None,
        Uint(kind) -> None,
        Struct(id, types) -> lower_struct_fields(scope, fields, unbox(types)),
        Enum(id, variants) -> None,
        Ptr -> None,
        Slice(element) -> None,
        Unit -> None,
        Isize -> None,
        SrcType::Char -> None,
        Sint(sk) -> None,
    };
}

pub fn lower_tag(variant: usize, payload: core::option::Option<List<Expr>>) -> core::option::Option<List<Expr>> {
    return match (payload) {
        None -> None,
        Some(es) -> Some(cons(Lit(variant as u64), es)),
    };
}

pub fn lower_variant(scope: List<Binding>, variant: usize, found: core::option::Option<List<SrcType>>, payload: List<SrcExpr>) -> core::option::Option<List<Expr>> {
    return match (found) {
        None -> None,
        Some(types) -> lower_tag(variant, lower_args(scope, payload, types)),
    };
}

// Tags are 32-bit, so an enum has fewer than 2^32 variants.
pub fn lower_tagged(scope: List<Binding>, variants: List<List<SrcType>>, variant: usize, payload: List<SrcExpr>) -> core::option::Option<List<Expr>> {
    if (length(variants) < 4294967296) {
        return lower_variant(scope, variant, get(variants, variant), payload);
    }
    return None;
}

// An enum value: its tag, then the variant's payload. Slots past the payload
// are left as they are.
pub fn lower_enum_value(scope: List<Binding>, ty: SrcType, variant: usize, payload: List<SrcExpr>) -> core::option::Option<List<Expr>> {
    return match (ty) {
        I32 -> None,
        Bool -> None,
        Uint(kind) -> None,
        Struct(id, types) -> None,
        Enum(id, variants) -> lower_tagged(scope, unbox(variants), variant, payload),
        Ptr -> None,
        Slice(element) -> None,
        Unit -> None,
        Isize -> None,
        SrcType::Char -> None,
        Sint(sk) -> None,
    };
}

// The scope of an arm: each binder names its payload field's slots, binding
// in order as Core's bindLocals does. A binder takes slots, so no two share
// a first slot.
pub fn arm_scope(binders: List<usize>, types: List<SrcType>, slot: usize, scope: List<Binding>) -> core::option::Option<List<Binding>> {
    return match (binders) {
        Nil -> match (types) {
            Nil -> Some(scope),
            Cons(ty, more) -> None,
        },
        Cons(binder, rest) -> match (types) {
            Nil -> None,
            Cons(ty, more) -> arm_bind(binder, ty, unbox(rest), unbox(more), slot, scope),
        },
    };
}

// extract: inline
fn arm_bind(binder: usize, ty: SrcType, rest: List<usize>, more: List<SrcType>, slot: usize, scope: List<Binding>) -> core::option::Option<List<Binding>> {
    if (ty.size() > 0) {
        return arm_scope(rest, more, plus(slot, ty.size()), cons(Binding { id: binder, slot: slot, ty: ty }, scope));
    }
    return None;
}

// Assign values to slot, slot + 1, ..., then run rest.
pub fn assign_from(slot: usize, values: List<Expr>, rest: Stmt) -> Stmt {
    return match (values) {
        Nil -> rest,
        Cons(value, more) -> Seq(boxed(Assign(slot, value)), boxed(assign_from(plus(slot, 1), unbox(more), rest))),
    };
}

pub fn lower_arm_value(scope: core::option::Option<List<Binding>>, value: SrcExpr, ty: SrcType) -> core::option::Option<List<Expr>> {
    return match (scope) {
        None -> None,
        Some(s) -> lower_value(s, value, ty),
    };
}

// The guard of an arm's value in the arm's scope.
pub fn arm_guard(scope: core::option::Option<List<Binding>>, value: SrcExpr) -> Expr {
    return match (scope) {
        None -> Lit(1),
        Some(s) -> value.guard(s),
    };
}

// Arm k checks its guard g and stores its value's slots from target; the last
// arm needs no tag test.
pub fn lower_arm(slot: usize, target: usize, k: usize, g: Expr, values: core::option::Option<List<Expr>>, rest: List<SrcArm>, others: core::option::Option<Stmt>) -> core::option::Option<Stmt> {
    return match (values) {
        None -> None,
        Some(vs) -> match (rest) {
            Nil -> Some(check_then(target, g, assign_from(target, vs, Skip))),
            Cons(arm, more) -> match (others) {
                None -> None,
                Some(o) -> Some(Ite(Compare(U64, Eq, boxed(Var(slot)), boxed(Lit(k as u64))), boxed(check_then(target, g, assign_from(target, vs, Skip))), boxed(o))),
            },
        },
    };
}

// Arms k, k + 1, ... of a match on the enum at slot, one per variant from k.
pub fn lower_arms(scope: List<Binding>, slot: usize, target: usize, ty: SrcType, k: usize, variants: List<List<SrcType>>, arms: List<SrcArm>) -> core::option::Option<Stmt> {
    return match (arms) {
        Nil -> None,
        Cons(arm, rest) -> match (variants) {
            Nil -> None,
            Cons(types, more) -> lower_arm(slot, target, k, arm_guard(arm_scope(arm.binders, types, plus(slot, 1), scope), arm.value), lower_arm_value(arm_scope(arm.binders, types, plus(slot, 1), scope), arm.value, ty), unbox(rest), lower_arms(scope, slot, target, ty, plus(k, 1), unbox(more), unbox(rest))),
        },
    };
}

// The match is exhaustive, its value takes slots, and its tags fit in 32 bits.
pub fn lower_match_arms(scope: List<Binding>, slot: usize, same: bool, variants: List<List<SrcType>>, arms: List<SrcArm>, ty: SrcType, target: usize) -> core::option::Option<Stmt> {
    if (same && (ty.size() > 0) && (length(arms) == length(variants)) && (length(variants) < 4294967296)) {
        return lower_arms(scope, slot, target, ty, 0, variants, arms);
    }
    return None;
}

pub fn lower_match_on(scope: List<Binding>, b: Binding, enum_id: usize, arms: List<SrcArm>, ty: SrcType, target: usize) -> core::option::Option<Stmt> {
    return match (b.ty) {
        I32 -> None,
        Bool -> None,
        Uint(kind) -> None,
        Struct(id, types) -> None,
        Enum(id, variants) -> lower_match_arms(scope, b.slot, id == enum_id, unbox(variants), arms, ty, target),
        Ptr -> None,
        Slice(element) -> None,
        Unit -> None,
        Isize -> None,
        SrcType::Char -> None,
        Sint(sk) -> None,
    };
}

pub fn lower_match(scope: List<Binding>, binding: core::option::Option<Binding>, enum_id: usize, arms: List<SrcArm>, ty: SrcType, target: usize) -> core::option::Option<Stmt> {
    return match (binding) {
        None -> None,
        Some(b) -> lower_match_on(scope, b, enum_id, arms, ty, target),
    };
}


// A function's parameter types and result type.
pub struct Sig {
    params: List<SrcType>,
    ret: SrcType,
}

pub fn lower_call_sig(scope: List<Binding>, sig: Sig, args: List<SrcExpr>, ty: SrcType) -> core::option::Option<List<Expr>> {
    if (sig.ret.same(ty)) {
        return lower_args(scope, args, sig.params);
    }
    return None;
}

// The arguments of a call returning ty to callee.
pub fn lower_call(sigs: List<Sig>, scope: List<Binding>, callee: usize, args: List<SrcExpr>, ty: SrcType) -> core::option::Option<List<Expr>> {
    return match (get(sigs, callee)) {
        None -> None,
        Some(sig) -> lower_call_sig(scope, sig, args, ty),
    };
}

// Code that leaves a value of type ty in slots slot, slot + 1, ...; it may
// write any slot from slot on, and no slot below.
pub struct Evaluated {
    stmt: Stmt,
    ty: SrcType,
}

// Arguments evaluated into consecutive slots, and their types.
pub struct EvaluatedArgs {
    stmt: Stmt,
    types: List<SrcType>,
}

pub fn eval_scalar(slot: usize, t: Typed) -> Evaluated {
    return Evaluated { stmt: Assign(slot, t.expr), ty: t.ty };
}

// The value of a pure expression with guard g.
pub fn eval_checked(slot: usize, g: Expr, t: Typed) -> Evaluated {
    return Evaluated { stmt: check_then(slot, g, Assign(slot, t.expr)), ty: t.ty };
}

pub fn eval_typed(slot: usize, t: core::option::Option<Typed>) -> core::option::Option<Evaluated> {
    return match (t) {
        None -> None,
        Some(x) -> Some(eval_scalar(slot, x)),
    };
}

pub fn eval_values(slot: usize, ty: SrcType, values: core::option::Option<List<Expr>>) -> core::option::Option<Evaluated> {
    return match (values) {
        None -> None,
        Some(vs) -> Some(Evaluated { stmt: assign_from(slot, vs, Skip), ty: ty }),
    };
}

// A local of any type, copied slot by slot.
pub fn eval_copy(scope: List<Binding>, e: SrcExpr, slot: usize, binding: core::option::Option<Binding>) -> core::option::Option<Evaluated> {
    return match (binding) {
        None -> None,
        Some(b) -> eval_values(slot, b.ty, lower_value(scope, e, b.ty)),
    };
}

// A field's value, of an aggregate type, copied slot by slot.
pub fn eval_field_type(scope: List<Binding>, e: SrcExpr, slot: usize, found: core::option::Option<SrcType>) -> core::option::Option<Evaluated> {
    return match (found) {
        None -> None,
        Some(ty) -> eval_sized(slot, ty, lower_value(scope, e, ty)),
    };
}

// extract: inline
fn eval_sized(slot: usize, ty: SrcType, values: core::option::Option<List<Expr>>) -> core::option::Option<Evaluated> {
    if (ty.size() > 0) {
        return eval_values(slot, ty, values);
    }
    return None;
}

pub fn eval_field_of(scope: List<Binding>, e: SrcExpr, slot: usize, b: Binding, index: usize) -> core::option::Option<Evaluated> {
    return match (b.ty) {
        I32 -> None,
        Bool -> None,
        Uint(kind) -> None,
        Struct(id, fields) -> eval_field_type(scope, e, slot, get(unbox(fields), index)),
        Enum(id, variants) -> None,
        Ptr -> None,
        Slice(element) -> None,
        Unit -> None,
        Isize -> None,
        SrcType::Char -> None,
        Sint(sk) -> None,
    };
}

// A struct local's field of any type (a scalar field lowers as an
// expression first), copied slot by slot.
pub fn eval_field_copy(scope: List<Binding>, e: SrcExpr, slot: usize, binding: core::option::Option<Binding>, index: usize) -> core::option::Option<Evaluated> {
    return match (binding) {
        None -> None,
        Some(b) -> eval_field_of(scope, e, slot, b, index),
    };
}

pub fn eval_pure(scope: List<Binding>, e: SrcExpr, slot: usize) -> core::option::Option<Evaluated> {
    return match (e.lower(scope)) {
        Some(t) -> Some(eval_checked(slot, e.guard(scope), t)),
        None -> match (e) {
            Int(value) -> None,
            Boolean(value) -> None,
            Unsigned(kind, value) -> None,
            Local(id) -> eval_copy(scope, e, slot, lookup(scope, id)),
            Field(id, index) -> eval_field_copy(scope, e, slot, lookup(scope, id), index),
            Negate(operand) -> None,
            Not(operand) -> None,
            Apply(op, left, right) -> None,
            Cast(ty, operand) -> None,
            Null -> None,
            SrcExpr::Char(code) -> None,
        },
    };
}

pub fn eval_call_sig(sig: Sig, callee: usize, slot: usize, args: EvaluatedArgs) -> core::option::Option<Evaluated> {
    if (types_same(args.types, sig.params) && (sig.ret.size() > 0)) {
        return Some(Evaluated { stmt: Seq(boxed(args.stmt), boxed(Stmt::Call(slot, sig.ret.size(), callee, slot_vars(slot, sizes(sig.params))))), ty: sig.ret });
    }
    return None;
}

pub fn eval_call(sig: core::option::Option<Sig>, callee: usize, slot: usize, args: core::option::Option<EvaluatedArgs>) -> core::option::Option<Evaluated> {
    return match (sig) {
        None -> None,
        Some(s) -> match (args) {
            None -> None,
            Some(a) -> eval_call_sig(s, callee, slot, a),
        },
    };
}

pub fn cons_args(first: Evaluated, rest: core::option::Option<EvaluatedArgs>) -> core::option::Option<EvaluatedArgs> {
    return match (rest) {
        None -> None,
        Some(r) -> Some(EvaluatedArgs { stmt: Seq(boxed(first.stmt), boxed(r.stmt)), types: cons(first.ty, r.types) }),
    };
}

// 1 for &&, 2 for ||, 0 for the operators that evaluate both sides.
pub fn short_circuit(op: SrcOp) -> usize {
    return match (op) {
        Plus -> 0,
        Minus -> 0,
        Times -> 0,
        BitAnd -> 0,
        BitOr -> 0,
        BitXor -> 0,
        ShiftLeft -> 0,
        ShiftRight -> 0,
        Less -> 0,
        LessEq -> 0,
        Greater -> 0,
        GreaterEq -> 0,
        Equal -> 0,
        NotEqual -> 0,
        LogicalAnd -> 1,
        LogicalOr -> 2,
    };
}

// The right operand of && or ||, computed in slot + 1 and moved to slot.
pub fn eval_right(slot: usize, r: Evaluated) -> Stmt {
    return Seq(boxed(r.stmt), boxed(Assign(slot, Var(plus(slot, 1)))));
}

// left in slot, right in slot + 1. && and || run the right side's code
// only when Core evaluates it.
// The guard of op on evaluated operands, the right one at slot: shifts check
// their amount, after the result is in the left operand's slot.
pub fn operand_guard(op: SrcOp, ty: SrcType, slot: usize) -> Expr {
    return match (op) {
        Plus -> Lit(1),
        Minus -> Lit(1),
        Times -> Lit(1),
        BitAnd -> Lit(1),
        BitOr -> Lit(1),
        BitXor -> Lit(1),
        ShiftLeft -> amount_guard(shift_width(ty), Var(slot)),
        ShiftRight -> amount_guard(shift_width(ty), Var(slot)),
        Less -> Lit(1),
        LessEq -> Lit(1),
        Greater -> Lit(1),
        GreaterEq -> Lit(1),
        Equal -> Lit(1),
        NotEqual -> Lit(1),
        LogicalAnd -> Lit(1),
        LogicalOr -> Lit(1),
    };
}

pub fn eval_operands(op: SrcOp, slot: usize, l: Evaluated, r: Evaluated) -> core::option::Option<Evaluated> {
    if (l.ty.is_scalar() && r.ty.is_scalar() && (short_circuit(op) == 0)) {
        return match (op.lower(Typed { expr: Var(slot), ty: l.ty }, Typed { expr: Var(plus(slot, 1)), ty: r.ty })) {
            None -> None,
            Some(t) -> Some(Evaluated { stmt: Seq(boxed(l.stmt), boxed(Seq(boxed(r.stmt), boxed(then_check(plus(slot, 1), operand_guard(op, l.ty, plus(slot, 1)), Assign(slot, t.expr)))))), ty: t.ty }),
        };
    }
    if (l.ty.is_bool() && r.ty.is_bool() && (short_circuit(op) == 1)) {
        return Some(Evaluated { stmt: Seq(boxed(l.stmt), boxed(Ite(Var(slot), boxed(eval_right(slot, r)), boxed(Skip)))), ty: Bool });
    }
    if (l.ty.is_bool() && r.ty.is_bool() && (short_circuit(op) == 2)) {
        return Some(Evaluated { stmt: Seq(boxed(l.stmt), boxed(Ite(Var(slot), boxed(Skip), boxed(eval_right(slot, r))))), ty: Bool });
    }
    return None;
}

pub fn eval_apply(op: SrcOp, slot: usize, left: core::option::Option<Evaluated>, right: core::option::Option<Evaluated>) -> core::option::Option<Evaluated> {
    return match (left) {
        None -> None,
        Some(l) -> match (right) {
            None -> None,
            Some(r) -> eval_operands(op, slot, l, r),
        },
    };
}

// The element type of a slice type.
pub fn element_of(ty: SrcType) -> core::option::Option<SrcType> {
    return match (ty) {
        I32 -> None,
        Bool -> None,
        Uint(kind) -> None,
        Struct(id, fields) -> None,
        Enum(id, variants) -> None,
        Ptr -> None,
        Slice(element) -> Some(unbox(element)),
        Unit -> None,
        Isize -> None,
        SrcType::Char -> None,
        Sint(sk) -> None,
    };
}

// The index in slot, then the element it picks loaded over it.
pub fn eval_load(b: Binding, slot: usize, i: Evaluated) -> core::option::Option<Evaluated> {
    if (i.ty.is_i32() || i.ty.is_uint(Usize)) {
        return Some(Evaluated { stmt: Seq(boxed(i.stmt), boxed(check_then(slot, bounds_guard(b, Var(slot)), LoadWord(M32, slot, Binary(U64, Add, boxed(Var(b.slot)), boxed(Binary(U64, Mul, boxed(Var(slot)), boxed(Lit(4))))))))), ty: I32 });
    }
    return None;
}



// A struct value: its fields, one after another from slot.
pub fn eval_struct_of(ty: SrcType, types: List<SrcType>, args: EvaluatedArgs) -> core::option::Option<Evaluated> {
    if (types_same(args.types, types) && (0 < sizes(types))) {
        return Some(Evaluated { stmt: args.stmt, ty: ty });
    }
    return None;
}

pub fn eval_struct(ty: SrcType, args: core::option::Option<EvaluatedArgs>) -> core::option::Option<Evaluated> {
    return match (args) {
        None -> None,
        Some(a) -> match (ty) {
            I32 -> None,
            Bool -> None,
            Uint(kind) -> None,
            Struct(id, types) -> eval_struct_of(ty, unbox(types), a),
            Enum(id, variants) -> None,
            Ptr -> None,
            Slice(element) -> None,
            Unit -> None,
            Isize -> None,
            SrcType::Char -> None,
            Sint(sk) -> None,
        },
    };
}

// The payload, evaluated from slot + 1, then the tag in slot.
pub fn eval_payload(ty: SrcType, types: List<SrcType>, variant: usize, slot: usize, args: EvaluatedArgs) -> core::option::Option<Evaluated> {
    if (types_same(args.types, types)) {
        return Some(Evaluated { stmt: Seq(boxed(args.stmt), boxed(Assign(slot, Lit(variant as u64)))), ty: ty });
    }
    return None;
}

// Tags are 32-bit, so an enum has fewer than 2^32 variants.
pub fn eval_tagged(ty: SrcType, variants: List<List<SrcType>>, variant: usize, slot: usize, args: EvaluatedArgs) -> core::option::Option<Evaluated> {
    if (length(variants) < 4294967296) {
        return match (get(variants, variant)) {
            None -> None,
            Some(types) -> eval_payload(ty, types, variant, slot, args),
        };
    }
    return None;
}

pub fn eval_variant(ty: SrcType, variant: usize, slot: usize, args: core::option::Option<EvaluatedArgs>) -> core::option::Option<Evaluated> {
    return match (args) {
        None -> None,
        Some(a) -> match (ty) {
            I32 -> None,
            Bool -> None,
            Uint(kind) -> None,
            Struct(id, types) -> None,
            Enum(id, variants) -> eval_tagged(ty, unbox(variants), variant, slot, a),
            Ptr -> None,
            Slice(element) -> None,
            Unit -> None,
            Isize -> None,
            SrcType::Char -> None,
            Sint(sk) -> None,
        },
    };
}

pub fn signed_div(op: SrcDivOp) -> DivOp {
    return match (op) {
        Quotient -> SDiv,
        Remainder -> SRem,
    };
}

pub fn unsigned_div(op: SrcDivOp) -> DivOp {
    return match (op) {
        Quotient -> UDiv,
        Remainder -> URem,
    };
}

pub fn eval_divide_uint(op: SrcDivOp, slot: usize, l: Evaluated, r: Evaluated, k: UintTy) -> core::option::Option<Evaluated> {
    if (r.ty.is_uint(k)) {
        return Some(Evaluated { stmt: Seq(boxed(l.stmt), boxed(Seq(boxed(r.stmt), boxed(Stmt::Divide(U64, unsigned_div(op), slot, Var(slot), Var(plus(slot, 1))))))), ty: Uint(k) });
    }
    return None;
}

// Not the least value of the narrow signed type kind over -1: left in slot,
// right in slot + 1, as i32 bits.
pub fn overflow_guard(kind: UintTy, slot: usize) -> Expr {
    let least: Expr = Compare(S32, Eq, boxed(Var(slot)), boxed(Lit(kind.least_bits())));
    let by_minus_one: Expr = Compare(S32, Eq, boxed(Var(plus(slot, 1))), boxed(Lit(4294967295)));
    return Compare(U64, Eq, boxed(Binary(U64, And, boxed(least), boxed(by_minus_one))), boxed(Lit(0)));
}

// A narrow signed division divides on 32 bits, where the least value over
// -1 does not overflow, so it checks for that first, as Core traps on it; a
// 64-bit one divides the whole word, whose least value over -1 has no result.
pub fn eval_divide_sint(op: SrcDivOp, slot: usize, l: Evaluated, r: Evaluated, k: UintTy) -> core::option::Option<Evaluated> {
    if (r.ty.is_sint(k) && k.is_wide()) {
        return Some(Evaluated { stmt: Seq(boxed(l.stmt), boxed(Seq(boxed(r.stmt), boxed(Stmt::Divide(U64, signed_div(op), slot, Var(slot), Var(plus(slot, 1))))))), ty: Sint(k) });
    }
    if (r.ty.is_sint(k)) {
        let divide: Stmt = Stmt::Divide(S32, signed_div(op), slot, Var(slot), Var(plus(slot, 1)));
        return Some(Evaluated { stmt: Seq(boxed(l.stmt), boxed(Seq(boxed(r.stmt), boxed(check_then(plus(slot, 1), overflow_guard(k, slot), divide))))), ty: Sint(k) });
    }
    return None;
}

// left in slot, right in slot + 1, then the division into slot: on the
// low 32 bits for i32, on the whole word for isize and the unsigned types,
// whose values are below their width.
pub fn eval_divide(op: SrcDivOp, slot: usize, l: Evaluated, r: Evaluated) -> core::option::Option<Evaluated> {
    if (l.ty.is_i32() && r.ty.is_i32()) {
        return Some(Evaluated { stmt: Seq(boxed(l.stmt), boxed(Seq(boxed(r.stmt), boxed(Stmt::Divide(S32, signed_div(op), slot, Var(slot), Var(plus(slot, 1))))))), ty: I32 });
    }
    if (l.ty.is_isize() && r.ty.is_isize()) {
        return Some(Evaluated { stmt: Seq(boxed(l.stmt), boxed(Seq(boxed(r.stmt), boxed(Stmt::Divide(U64, signed_div(op), slot, Var(slot), Var(plus(slot, 1))))))), ty: Isize });
    }
    return match (l.ty.sint_kind()) {
        None -> match (l.ty.uint_kind()) {
            None -> None,
            Some(k) -> eval_divide_uint(op, slot, l, r, k),
        },
        Some(k) -> eval_divide_sint(op, slot, l, r, k),
    };
}

pub fn eval_division(op: SrcDivOp, slot: usize, left: core::option::Option<Evaluated>, right: core::option::Option<Evaluated>) -> core::option::Option<Evaluated> {
    return match (left) {
        None -> None,
        Some(l) -> match (right) {
            None -> None,
            Some(r) -> eval_divide(op, slot, l, r),
        },
    };
}

// The operand in slot, then op applied to it there.
pub fn eval_then(slot: usize, operand: Evaluated, t: core::option::Option<Typed>) -> core::option::Option<Evaluated> {
    return match (t) {
        None -> None,
        Some(x) -> Some(Evaluated { stmt: Seq(boxed(operand.stmt), boxed(Assign(slot, x.expr))), ty: x.ty }),
    };
}

// A cast's operand must be a scalar, which takes one slot.
pub fn scalar_cast(ty: SrcType, operand: Typed) -> core::option::Option<Typed> {
    if (operand.ty.is_scalar()) {
        return cast_to(ty, operand);
    }
    return None;
}

pub fn eval_negate(slot: usize, operand: core::option::Option<Evaluated>) -> core::option::Option<Evaluated> {
    return match (operand) {
        None -> None,
        Some(o) -> eval_then(slot, o, lower_negate_typed(Typed { expr: Var(slot), ty: o.ty })),
    };
}

pub fn eval_not(slot: usize, operand: core::option::Option<Evaluated>) -> core::option::Option<Evaluated> {
    return match (operand) {
        None -> None,
        Some(o) -> eval_then(slot, o, lower_not_typed(Typed { expr: Var(slot), ty: o.ty })),
    };
}

pub fn eval_cast(ty: SrcType, slot: usize, operand: core::option::Option<Evaluated>) -> core::option::Option<Evaluated> {
    return match (operand) {
        None -> None,
        Some(o) -> eval_then(slot, o, scalar_cast(ty, Typed { expr: Var(slot), ty: o.ty })),
    };
}

// Some(stmt) when the value has type ty.
pub fn eval_same(v: Evaluated, ty: SrcType, stmt: Stmt) -> core::option::Option<Stmt> {
    if (v.ty.same(ty)) {
        return Some(stmt);
    }
    return None;
}

// Arm k's code; the last arm needs no tag test.
pub fn eval_arm(slot: usize, k: usize, code: core::option::Option<Stmt>, rest: List<SrcEff>, others: core::option::Option<Stmt>) -> core::option::Option<Stmt> {
    return match (code) {
        None -> None,
        Some(c) -> match (rest) {
            Nil -> Some(c),
            Cons(value, more) -> match (others) {
                None -> None,
                Some(o) -> Some(Ite(Compare(U64, Eq, boxed(Var(slot)), boxed(Lit(k as u64))), boxed(c), boxed(o))),
            },
        },
    };
}

// Arm k's value evaluated from dst, under its payload's binders.
// extract: inline
fn eval_arm_in(sigs: List<Sig>, decls: SrcDecls, bound: core::option::Option<List<Binding>>, slot: usize, dst: usize, ty: SrcType, k: usize, value: SrcEff, rest: List<SrcEff>, later: core::option::Option<Stmt>) -> core::option::Option<Stmt> {
    return match (bound) {
        None -> None,
        Some(s) -> match (value.eval(sigs, decls, s, dst)) {
            None -> None,
            Some(e) -> eval_arm(slot, k, eval_same(e, ty, e.stmt), rest, later),
        },
    };
}

// Where a match's arms leave their values: above the scrutinee and above
// the match's own value, so copying it down to slot reads no slot it writes.
pub fn match_dst(slot: usize, ety: SrcType, ty: SrcType) -> usize {
    return plus(slot, max_of(ety.size(), ty.size()));
}

pub fn match_variants(ty: SrcType) -> List<List<SrcType>> {
    return match (ty) {
        I32 -> empty(),
        Bool -> empty(),
        Uint(kind) -> empty(),
        Struct(id, types) -> empty(),
        Enum(id, variants) -> unbox(variants),
        Ptr -> empty(),
        Slice(element) -> empty(),
        Unit -> empty(),
        Isize -> empty(),
        SrcType::Char -> empty(),
        Sint(sk) -> empty(),
    };
}

// The match is exhaustive, its value takes slots, and its tags fit in 32 bits.
pub fn eval_match_of(slot: usize, ety: SrcType, ty: SrcType, s: Evaluated, arms: Stmt, binders: usize, values: usize) -> core::option::Option<Evaluated> {
    if (s.ty.same(ety) && (0 < ty.size()) && (binders == length(match_variants(ety))) && (values == length(match_variants(ety))) && (length(match_variants(ety)) < 4294967296)) {
        return Some(Evaluated { stmt: Seq(boxed(s.stmt), boxed(Seq(boxed(arms), boxed(assign_from(slot, slot_vars(match_dst(slot, ety, ty), ty.size()), Skip))))), ty: ty });
    }
    return None;
}

// The scrutinee in slot, the arm its tag picks from match_dst, then that
// value copied down to slot.
pub fn eval_match(slot: usize, ety: SrcType, ty: SrcType, scrutinee: core::option::Option<Evaluated>, arms: core::option::Option<Stmt>, binders: usize, values: usize) -> core::option::Option<Evaluated> {
    return match (scrutinee) {
        None -> None,
        Some(s) -> match (arms) {
            None -> None,
            Some(a) -> eval_match_of(slot, ety, ty, s, a, binders, values),
        },
    };
}

// extract: mutual begin
impl SrcEff {
    // The struct and enum types of the literals in this expression, which
    // the program's declarations must give.
    pub fn types(self) -> List<SrcType> {
        return match (self) {
            EPure(e) -> empty(),
            ECall(callee, args) -> effs_types(unbox(args)),
            EApply(op, left, right) -> concat(unbox(left).types(), unbox(right).types()),
            ENeg(operand) -> unbox(operand).types(),
            ENot(operand) -> unbox(operand).types(),
            ECast(ty, operand) -> unbox(operand).types(),
            EIndex(slice, index) -> unbox(index).types(),
            EStruct(ty, fields) -> cons(ty, effs_types(unbox(fields))),
            EVariant(ty, variant, payload) -> cons(ty, effs_types(unbox(payload))),
            EMatch(scrutinee, ety, ty, binders, values) -> cons(ety, concat(unbox(scrutinee).types(), effs_types(unbox(values)))),
            EDivide(op, left, right) -> concat(unbox(left).types(), unbox(right).types()),
            EStride(slice) -> empty(),
        };
    }
}

pub fn effs_types(es: List<SrcEff>) -> List<SrcType> {
    return match (es) {
        Nil -> empty(),
        Cons(e, rest) -> concat(e.types(), effs_types(unbox(rest))),
    };
}
// extract: mutual end


pub fn lower_let_eval(ty: SrcType, value: core::option::Option<Evaluated>, body: core::option::Option<Stmt>) -> core::option::Option<Stmt> {
    return match (value) {
        None -> None,
        Some(v) -> match (body) {
            None -> None,
            Some(b) -> eval_same(v, ty, Seq(boxed(v.stmt), boxed(b))),
        },
    };
}

pub fn lower_set_eval(slot: usize, binding: core::option::Option<Binding>, value: core::option::Option<Evaluated>) -> core::option::Option<Stmt> {
    return match (binding) {
        None -> None,
        Some(b) -> match (value) {
            None -> None,
            Some(v) -> eval_same(v, b.ty, Seq(boxed(v.stmt), boxed(assign_from(b.slot, slot_vars(slot, b.ty.size()), Skip)))),
        },
    };
}

pub fn lower_if_eval(slot: usize, condition: core::option::Option<Evaluated>, then_branch: core::option::Option<Stmt>, else_branch: core::option::Option<Stmt>) -> core::option::Option<Stmt> {
    return match (condition) {
        None -> None,
        Some(c) -> match (then_branch) {
            None -> None,
            Some(t) -> match (else_branch) {
                None -> None,
                Some(e) -> eval_same(c, Bool, Seq(boxed(c.stmt), boxed(Ite(Var(slot), boxed(t), boxed(e))))),
            },
        },
    };
}

// The body may reuse the condition's slots, so the condition is computed
// again after it, before the loop tests it.
pub fn lower_while_eval(slot: usize, condition: core::option::Option<Evaluated>, body: core::option::Option<Stmt>) -> core::option::Option<Stmt> {
    return match (condition) {
        None -> None,
        Some(c) -> match (body) {
            None -> None,
            Some(b) -> eval_same(c, Bool, Seq(boxed(c.stmt), boxed(Loop(Var(slot), boxed(Seq(boxed(b), boxed(c.stmt))))))),
        },
    };
}

pub fn lower_return_eval(slot: usize, ret: SrcType, value: core::option::Option<Evaluated>) -> core::option::Option<Stmt> {
    return match (value) {
        None -> None,
        Some(v) -> eval_same(v, ret, Seq(boxed(v.stmt), boxed(Stmt::Ret(slot_vars(slot, ret.size()))))),
    };
}

pub fn lower_discard(value: core::option::Option<Evaluated>) -> core::option::Option<Stmt> {
    return match (value) {
        None -> None,
        Some(v) -> Some(v.stmt),
    };
}

pub fn lower_let(slot: usize, values: core::option::Option<List<Expr>>, body: core::option::Option<Stmt>) -> core::option::Option<Stmt> {
    return match (values) {
        None -> None,
        Some(vs) -> match (body) {
            None -> None,
            Some(b) -> Some(assign_from(slot, vs, b)),
        },
    };
}

pub fn lower_let_call(slot: usize, count: usize, callee: usize, args: core::option::Option<List<Expr>>, body: core::option::Option<Stmt>) -> core::option::Option<Stmt> {
    return match (args) {
        None -> None,
        Some(a) -> match (body) {
            None -> None,
            Some(b) -> Some(Seq(boxed(Stmt::Call(slot, count, callee, a)), boxed(b))),
        },
    };
}

pub fn lower_set_values(slot: usize, values: core::option::Option<List<Expr>>) -> core::option::Option<Stmt> {
    return match (values) {
        None -> None,
        Some(vs) -> Some(assign_from(slot, vs, Skip)),
    };
}

pub fn lower_set(binding: core::option::Option<Binding>, scope: List<Binding>, value: SrcExpr) -> core::option::Option<Stmt> {
    return match (binding) {
        None -> None,
        Some(b) -> lower_set_values(b.slot, lower_value(scope, value, b.ty)),
    };
}

pub fn lower_set_value(slot: usize, value: core::option::Option<Expr>) -> core::option::Option<Stmt> {
    return match (value) {
        None -> None,
        Some(v) -> Some(Assign(slot, v)),
    };
}

// A field write stores a scalar field's slot.
pub fn lower_set_field_at(slot: usize, found: core::option::Option<SrcType>, scope: List<Binding>, value: SrcExpr) -> core::option::Option<Stmt> {
    return match (found) {
        None -> None,
        Some(ty) -> lower_set_scalar(slot, ty, scope, value),
    };
}

// extract: inline
fn lower_set_scalar(slot: usize, ty: SrcType, scope: List<Binding>, value: SrcExpr) -> core::option::Option<Stmt> {
    if (ty.is_scalar()) {
        return lower_set_value(slot, lower_as(scope, value, ty));
    }
    return None;
}

pub fn lower_set_field_of(b: Binding, field: usize, scope: List<Binding>, value: SrcExpr) -> core::option::Option<Stmt> {
    return match (b.ty) {
        I32 -> None,
        Bool -> None,
        Uint(kind) -> None,
        Struct(id, fields) -> lower_set_field_at(plus(b.slot, field_offset(unbox(fields), field)), get(unbox(fields), field), scope, value),
        Enum(id, variants) -> None,
        Ptr -> None,
        Slice(element) -> None,
        Unit -> None,
        Isize -> None,
        SrcType::Char -> None,
        Sint(sk) -> None,
    };
}

pub fn lower_set_field(binding: core::option::Option<Binding>, field: usize, scope: List<Binding>, value: SrcExpr) -> core::option::Option<Stmt> {
    return match (binding) {
        None -> None,
        Some(b) -> lower_set_field_of(b, field, scope, value),
    };
}

pub fn lower_set_call_args(slot: usize, count: usize, callee: usize, args: core::option::Option<List<Expr>>) -> core::option::Option<Stmt> {
    return match (args) {
        None -> None,
        Some(a) -> Some(Stmt::Call(slot, count, callee, a)),
    };
}

pub fn lower_set_call(sigs: List<Sig>, scope: List<Binding>, binding: core::option::Option<Binding>, callee: usize, args: List<SrcExpr>) -> core::option::Option<Stmt> {
    return match (binding) {
        None -> None,
        Some(b) -> lower_set_call_args(b.slot, b.ty.size(), callee, lower_call(sigs, scope, callee, args, b.ty)),
    };
}

pub fn lower_then(first: core::option::Option<Stmt>, second: core::option::Option<Stmt>) -> core::option::Option<Stmt> {
    return match (first) {
        None -> None,
        Some(a) -> match (second) {
            None -> None,
            Some(b) -> Some(Seq(boxed(a), boxed(b))),
        },
    };
}

pub fn lower_if(condition: core::option::Option<Expr>, then_branch: core::option::Option<Stmt>, else_branch: core::option::Option<Stmt>) -> core::option::Option<Stmt> {
    return match (condition) {
        None -> None,
        Some(c) -> match (then_branch) {
            None -> None,
            Some(t) -> match (else_branch) {
                None -> None,
                Some(e) -> Some(Ite(c, boxed(t), boxed(e))),
            },
        },
    };
}

// The body checks the condition's guard g before Core evaluates it again.
pub fn lower_while(slot: usize, g: Expr, condition: core::option::Option<Expr>, body: core::option::Option<Stmt>) -> core::option::Option<Stmt> {
    return match (condition) {
        None -> None,
        Some(c) -> match (body) {
            None -> None,
            Some(b) -> Some(Loop(c, boxed(then_check(slot, g, b)))),
        },
    };
}

pub fn lower_return(values: core::option::Option<List<Expr>>) -> core::option::Option<Stmt> {
    return match (values) {
        None -> None,
        Some(vs) -> Some(Stmt::Ret(vs)),
    };
}

// The bump allocator's size: Core gives a block of size 0 one byte.
pub fn at_least_one(size: Expr) -> Expr {
    return Binary(U64, Add, boxed(size), boxed(Compare(U64, Eq, boxed(size), boxed(Lit(0)))));
}

pub fn lower_alloc(slot: usize, shift: usize, size: core::option::Option<Expr>, body: core::option::Option<Stmt>) -> core::option::Option<Stmt> {
    if (shift < 32) {
        return match (size) {
            None -> None,
            Some(s) -> match (body) {
                None -> None,
                Some(b) -> Some(Seq(boxed(Alloc(slot, shift, at_least_one(s))), boxed(b))),
            },
        };
    }
    return None;
}

// A pointer and a usize offset as an address.
pub fn lower_address(pointer: core::option::Option<Expr>, offset: core::option::Option<Expr>) -> core::option::Option<Expr> {
    return match (pointer) {
        None -> None,
        Some(p) -> match (offset) {
            None -> None,
            Some(o) -> Some(Binary(U64, Add, boxed(p), boxed(o))),
        },
    };
}

pub fn lower_load(slot: usize, address: core::option::Option<Expr>, body: core::option::Option<Stmt>) -> core::option::Option<Stmt> {
    return match (address) {
        None -> None,
        Some(a) -> match (body) {
            None -> None,
            Some(b) -> Some(Seq(boxed(LoadByte(slot, a)), boxed(b))),
        },
    };
}

pub fn lower_store(address: core::option::Option<Expr>, value: core::option::Option<Expr>) -> core::option::Option<Stmt> {
    return match (address) {
        None -> None,
        Some(a) -> match (value) {
            None -> None,
            Some(v) -> Some(StoreByte(a, v)),
        },
    };
}

// The bump allocator never frees, so a free only checks its operands' types.
pub fn lower_free(shift: usize, pointer: core::option::Option<Expr>, size: core::option::Option<Expr>) -> core::option::Option<Stmt> {
    if (shift < 32) {
        return match (pointer) {
            None -> None,
            Some(p) -> match (size) {
                None -> None,
                Some(s) -> Some(Skip),
            },
        };
    }
    return None;
}

// Struct id's field types.
pub struct SrcStructDecl {
    id: usize,
    fields: List<SrcType>,
}

// Enum id's variants, each its payload types.
pub struct SrcEnumDecl {
    id: usize,
    variants: List<List<SrcType>>,
}

pub struct SrcDecls {
    structs: List<SrcStructDecl>,
    enums: List<SrcEnumDecl>,
}

// The fields declared for struct id.
pub fn struct_fields(decls: List<SrcStructDecl>, id: usize) -> core::option::Option<List<SrcType>> {
    return match (decls) {
        Nil -> None,
        Cons(decl, rest) -> struct_fields_at(decl, unbox(rest), id),
    };
}

// extract: inline
fn struct_fields_at(decl: SrcStructDecl, rest: List<SrcStructDecl>, id: usize) -> core::option::Option<List<SrcType>> {
    if (decl.id == id) {
        return Some(decl.fields);
    }
    return struct_fields(rest, id);
}

// The variants declared for enum id.
pub fn enum_variants(decls: List<SrcEnumDecl>, id: usize) -> core::option::Option<List<List<SrcType>>> {
    return match (decls) {
        Nil -> None,
        Cons(decl, rest) -> enum_variants_at(decl, unbox(rest), id),
    };
}

// extract: inline
fn enum_variants_at(decl: SrcEnumDecl, rest: List<SrcEnumDecl>, id: usize) -> core::option::Option<List<List<SrcType>>> {
    if (decl.id == id) {
        return Some(decl.variants);
    }
    return enum_variants(rest, id);
}

pub fn usize_width(kind: UintTy) -> core::option::Option<MemWidth> {
    return match (kind) {
        Uint8 -> Some(M32),
        Uint32 -> Some(M32),
        Uint64 -> Some(M64),
        Usize -> Some(M64),
        Uint16 -> Some(M32),
    };
}

// The width a scalar of a slice element is loaded and stored with. Each
// takes one native word: 4 bytes are read and written for i32, bool, u8, u16
// and u32, 8 for u64, usize, isize and ptr.
pub fn word_width(ty: SrcType) -> core::option::Option<MemWidth> {
    return match (ty) {
        I32 -> Some(M32),
        Bool -> Some(M32),
        Uint(kind) -> usize_width(kind),
        Struct(id, fields) -> None,
        Enum(id, variants) -> None,
        Ptr -> Some(M64),
        Slice(element) -> None,
        Unit -> None,
        Isize -> Some(M64),
        SrcType::Char -> None,
        Sint(kind) -> usize_width(kind),
    };
}

// The fields declared for a struct match the type's.
pub fn declared_same(declared: core::option::Option<List<SrcType>>, fields: List<SrcType>) -> bool {
    return match (declared) {
        None -> false,
        Some(fs) -> types_same(fs, fields),
    };
}

// The variants declared for an enum match the type's.
pub fn declared_variants(declared: core::option::Option<List<List<SrcType>>>, variants: List<List<SrcType>>) -> bool {
    return match (declared) {
        None -> false,
        Some(vs) -> variants_same(vs, variants),
    };
}

// extract: mutual begin
// A type Core and the mini compiler both lay out a word per slot: a word
// scalar (word_width); a struct, declared with these fields, of such fields
// and at least one word; or an enum, declared with these variants, of at
// least one variant, tags that fit in 32 bits, and payloads of such fields.
// Core puts an enum's tag in its word 0 and its payload after it, padded to
// the longest payload as the slots are, so word k is slot k.
pub fn word_type(decls: SrcDecls, ty: SrcType) -> bool {
    return match (ty) {
        I32 -> true,
        Bool -> true,
        Uint(kind) -> true,
        Struct(id, fields) -> declared_same(struct_fields(decls.structs, id), unbox(fields)) && word_types(decls, unbox(fields)) && sizes(unbox(fields)) > 0,
        Enum(id, variants) -> declared_variants(enum_variants(decls.enums, id), unbox(variants)) && length(unbox(variants)) > 0 && 4294967296 > length(unbox(variants)) && word_variants(decls, unbox(variants)),
        Ptr -> true,
        Slice(element) -> false,
        Unit -> false,
        Isize -> true,
        SrcType::Char -> false,
        Sint(kind) -> true,
    };
}

pub fn word_types(decls: SrcDecls, types: List<SrcType>) -> bool {
    return match (types) {
        Nil -> true,
        Cons(ty, rest) -> word_type(decls, ty) && word_types(decls, unbox(rest)),
    };
}

pub fn word_variants(decls: SrcDecls, variants: List<List<SrcType>>) -> bool {
    return match (variants) {
        Nil -> true,
        Cons(types, rest) -> word_types(decls, types) && word_variants(decls, unbox(rest)),
    };
}
// extract: mutual end

// A raw slice element of words: a struct or an enum of a word type.
pub fn word_element(decls: SrcDecls, element: SrcType) -> bool {
    return match (element) {
        I32 -> false,
        Bool -> false,
        Uint(kind) -> false,
        Struct(id, fields) -> word_type(decls, element),
        Enum(id, variants) -> word_type(decls, element),
        Ptr -> false,
        Slice(inner) -> false,
        Unit -> false,
        Isize -> false,
        SrcType::Char -> false,
        Sint(sk) -> false,
    };
}

// The width a word scalar is loaded and stored with.
pub fn width_of(ty: SrcType) -> MemWidth {
    return match (word_width(ty)) {
        None -> M64,
        Some(w) -> w,
    };
}

// A struct or enum slice's descriptor points at element zero's word 0, its high
// word, and elements of `words` words run downward: element index's word 0
// is index * words words below it. A value's words descend from its word 0.
pub fn element_base(slot: usize, words: usize, index: Expr) -> Expr {
    return Binary(U64, Sub, boxed(Var(slot)), boxed(Binary(U64, Mul, boxed(index), boxed(Lit(times(8, words) as u64)))));
}

// The address offset bytes below base.
pub fn address_below(base: Expr, offset: usize) -> Expr {
    return Binary(U64, Sub, boxed(base), boxed(Lit(offset as u64)));
}

// extract: mutual begin
// Load a value of a word type, its word 0 at base - offset, into the slots
// from target, then run body: a scalar's one load; a struct's fields in
// turn; an enum's tag, then the payload of its variant.
pub fn load_type(ty: SrcType, target: usize, base: Expr, offset: usize, body: Stmt) -> Stmt {
    return match (ty) {
        I32 -> Seq(boxed(LoadWord(width_of(ty), target, address_below(base, offset))), boxed(body)),
        Bool -> Seq(boxed(LoadWord(width_of(ty), target, address_below(base, offset))), boxed(body)),
        Uint(kind) -> Seq(boxed(LoadWord(width_of(ty), target, address_below(base, offset))), boxed(body)),
        Struct(id, fields) -> load_types(unbox(fields), target, base, offset, body),
        Enum(id, variants) -> Seq(boxed(LoadWord(M32, target, address_below(base, offset))), boxed(Seq(boxed(load_cases(target, base, offset, 0, unbox(variants))), boxed(body)))),
        Ptr -> Seq(boxed(LoadWord(width_of(ty), target, address_below(base, offset))), boxed(body)),
        Slice(element) -> Seq(boxed(LoadWord(width_of(ty), target, address_below(base, offset))), boxed(body)),
        Unit -> Seq(boxed(LoadWord(width_of(ty), target, address_below(base, offset))), boxed(body)),
        Isize -> Seq(boxed(LoadWord(width_of(ty), target, address_below(base, offset))), boxed(body)),
        SrcType::Char -> Seq(boxed(LoadWord(width_of(ty), target, address_below(base, offset))), boxed(body)),
        Sint(kind) -> Seq(boxed(LoadWord(width_of(ty), target, address_below(base, offset))), boxed(body)),
    };
}

// Values of these types one after another, the first at target and base - offset.
pub fn load_types(types: List<SrcType>, target: usize, base: Expr, offset: usize, body: Stmt) -> Stmt {
    return match (types) {
        Nil -> body,
        Cons(ty, rest) -> load_type(ty, target, base, offset, load_types(unbox(rest), plus(target, ty.size()), base, plus(offset, times(8, ty.size())), body)),
    };
}

// The payload of the variant whose tag is in slot target, the variants from
// k on, into the slots after it. The last variant needs no tag test.
pub fn load_cases(target: usize, base: Expr, offset: usize, k: usize, variants: List<List<SrcType>>) -> Stmt {
    return match (variants) {
        Nil -> Skip,
        Cons(types, rest) -> match (unbox(rest)) {
            Nil -> load_types(types, plus(target, 1), base, plus(offset, 8), Skip),
            Cons(more, others) -> Ite(Compare(U64, Eq, boxed(Var(target)), boxed(Lit(k as u64))), boxed(load_types(types, plus(target, 1), base, plus(offset, 8), Skip)), boxed(load_cases(target, base, offset, plus(k, 1), unbox(rest)))),
        },
    };
}
// extract: mutual end

pub fn ite_then(condition: Expr, then_branch: core::option::Option<Stmt>, else_branch: core::option::Option<Stmt>) -> core::option::Option<Stmt> {
    return match (then_branch) {
        None -> None,
        Some(t) -> match (else_branch) {
            None -> None,
            Some(e) -> Some(Ite(condition, boxed(t), boxed(e))),
        },
    };
}

pub fn store_one(w: MemWidth, address: Expr, value: core::option::Option<Expr>) -> core::option::Option<Stmt> {
    return match (value) {
        None -> None,
        Some(v) -> Some(StoreWord(w, address, v)),
    };
}

// extract: mutual begin
// Store a value of a word type, its slots the values from first and its
// word 0 at base - offset: a scalar's one store; a struct's fields in turn;
// an enum's tag, then the payload of its variant.
pub fn store_type(ty: SrcType, values: List<Expr>, first: usize, base: Expr, offset: usize) -> core::option::Option<Stmt> {
    return match (ty) {
        I32 -> store_one(width_of(ty), address_below(base, offset), get(values, first)),
        Bool -> store_one(width_of(ty), address_below(base, offset), get(values, first)),
        Uint(kind) -> store_one(width_of(ty), address_below(base, offset), get(values, first)),
        Struct(id, fields) -> store_types(unbox(fields), values, first, base, offset),
        Enum(id, variants) -> match (get(values, first)) {
            None -> None,
            Some(tag) -> lower_then(Some(StoreWord(M32, address_below(base, offset), tag)), store_cases(tag, values, plus(first, 1), base, plus(offset, 8), 0, unbox(variants))),
        },
        Ptr -> store_one(width_of(ty), address_below(base, offset), get(values, first)),
        Slice(element) -> store_one(width_of(ty), address_below(base, offset), get(values, first)),
        Unit -> store_one(width_of(ty), address_below(base, offset), get(values, first)),
        Isize -> store_one(width_of(ty), address_below(base, offset), get(values, first)),
        SrcType::Char -> store_one(width_of(ty), address_below(base, offset), get(values, first)),
        Sint(kind) -> store_one(width_of(ty), address_below(base, offset), get(values, first)),
    };
}

pub fn store_types(types: List<SrcType>, values: List<Expr>, first: usize, base: Expr, offset: usize) -> core::option::Option<Stmt> {
    return match (types) {
        Nil -> Some(Skip),
        Cons(ty, rest) -> lower_then(store_type(ty, values, first, base, offset), store_types(unbox(rest), values, plus(first, ty.size()), base, plus(offset, times(8, ty.size())))),
    };
}

// The payload of the variant whose tag is tag, the variants from k on, its
// slots the values from first, its first word at base - offset.
pub fn store_cases(tag: Expr, values: List<Expr>, first: usize, base: Expr, offset: usize, k: usize, variants: List<List<SrcType>>) -> core::option::Option<Stmt> {
    return match (variants) {
        Nil -> None,
        Cons(types, rest) -> match (unbox(rest)) {
            Nil -> store_types(types, values, first, base, offset),
            Cons(more, others) -> ite_then(Compare(U64, Eq, boxed(tag), boxed(Lit(k as u64))), store_types(types, values, first, base, offset), store_cases(tag, values, first, base, offset, plus(k, 1), unbox(rest))),
        },
    };
}
// extract: mutual end

// extract: mutual begin
// A word type within Core's native layout limits (NativeLayout.words? at
// maxDepth), its top at depth: nested less than 64 deep, each struct at most
// 4096 words and each enum payload under 4096.
pub fn within_layout(depth: usize, ty: SrcType) -> bool {
    if (depth > 63) {
        return false;
    }
    return match (ty) {
        I32 -> true,
        Bool -> true,
        Uint(kind) -> true,
        Struct(id, fields) -> 4097 > sizes(unbox(fields)) && within_layouts(plus(depth, 1), unbox(fields)),
        Enum(id, variants) -> within_payloads(plus(depth, 1), unbox(variants)),
        Ptr -> true,
        Slice(element) -> false,
        Unit -> false,
        Isize -> true,
        SrcType::Char -> false,
        Sint(kind) -> true,
    };
}

pub fn within_layouts(depth: usize, types: List<SrcType>) -> bool {
    return match (types) {
        Nil -> true,
        Cons(ty, rest) -> within_layout(depth, ty) && within_layouts(depth, unbox(rest)),
    };
}

pub fn within_payloads(depth: usize, variants: List<List<SrcType>>) -> bool {
    return match (variants) {
        Nil -> true,
        Cons(types, rest) -> 4096 > sizes(types) && within_layouts(depth, types) && within_payloads(depth, unbox(rest)),
    };
}
// extract: mutual end

// A raw slice's one slot: its address. Elements are i32, word structs or
// word enums within Core's layout limits; Core checks the length when the
// slice is made and each index against it.
pub fn lower_slice(decls: SrcDecls, element: SrcType, pointer: core::option::Option<Expr>, length: core::option::Option<Expr>) -> core::option::Option<List<Expr>> {
    if ((element.is_i32() || word_element(decls, element)) && within_layout(0, element)) {
        return match (pointer) {
            None -> None,
            Some(p) -> match (length) {
                None -> None,
                Some(l) -> Some(Cons(p, boxed(single(l)))),
            },
        };
    }
    return None;
}

// An index is an i32 or a usize.
pub fn index_of(t: Typed) -> core::option::Option<Expr> {
    if (t.ty.is_i32() || t.ty.is_uint(Usize)) {
        return Some(t.expr);
    }
    return None;
}

pub fn lower_index(scope: List<Binding>, index: SrcExpr) -> core::option::Option<Expr> {
    return match (index.lower(scope)) {
        None -> None,
        Some(t) -> index_of(t),
    };
}

// The check of slice[index]: the index below the length.
pub fn index_guard(scope: List<Binding>, slice: usize, index: SrcExpr) -> Expr {
    return match (lookup(scope, slice)) {
        None -> Lit(1),
        Some(b) -> match (lower_index(scope, index)) {
            None -> Lit(1),
            Some(i) -> bounds_guard(b, i),
        },
    };
}

// extract: inline
fn element_at(slot: usize, element: SrcType, index: Expr) -> core::option::Option<Expr> {
    if (element.is_i32()) {
        return Some(Binary(U64, Add, boxed(Var(slot)), boxed(Binary(U64, Mul, boxed(index), boxed(Lit(4))))));
    }
    return None;
}

// The address of element index of the slice local b.
pub fn element_address(b: Binding, index: core::option::Option<Expr>) -> core::option::Option<Expr> {
    return match (element_of(b.ty)) {
        None -> None,
        Some(element) -> match (index) {
            None -> None,
            Some(i) -> element_at(b.slot, element, i),
        },
    };
}

// extract: inline
fn checked_element(b: Binding, ty: SrcType, index: core::option::Option<Expr>) -> core::option::Option<Expr> {
    if (b.ty.same(Slice(boxed(ty)))) {
        return element_address(b, index);
    }
    return None;
}

// slice[index] read as a ty.
pub fn lower_element(binding: core::option::Option<Binding>, ty: SrcType, index: core::option::Option<Expr>) -> core::option::Option<Expr> {
    return match (binding) {
        None -> None,
        Some(b) -> checked_element(b, ty, index),
    };
}

pub fn lower_load_word(slot: usize, address: core::option::Option<Expr>, body: core::option::Option<Stmt>) -> core::option::Option<Stmt> {
    return match (address) {
        None -> None,
        Some(a) -> match (body) {
            None -> None,
            Some(b) -> Some(Seq(boxed(LoadWord(M32, slot, a)), boxed(b))),
        },
    };
}

// extract: inline
fn store_element(b: Binding, element: SrcType, index: core::option::Option<Expr>, scope: List<Binding>, value: SrcExpr) -> core::option::Option<Stmt> {
    return match (element_address(b, index)) {
        None -> None,
        Some(a) -> match (lower_as(scope, value, element)) {
            None -> None,
            Some(v) -> Some(StoreWord(M32, a, v)),
        },
    };
}

// slice[index] = value for a word struct or enum element: a store per word.
pub fn store_word_element(b: Binding, element: SrcType, index: core::option::Option<Expr>, scope: List<Binding>, value: SrcExpr) -> core::option::Option<Stmt> {
    return match (index) {
        None -> None,
        Some(i) -> match (lower_value(scope, value, element)) {
            None -> None,
            Some(vs) -> store_type(element, vs, 0, element_base(b.slot, element.size(), i), 0),
        },
    };
}

pub fn store_any(decls: SrcDecls, b: Binding, element: SrcType, index: core::option::Option<Expr>, scope: List<Binding>, value: SrcExpr) -> core::option::Option<Stmt> {
    if (element.is_i32()) {
        return store_element(b, element, index, scope, value);
    }
    if (word_element(decls, element)) {
        return store_word_element(b, element, index, scope, value);
    }
    return None;
}

pub fn lower_set_index_of(decls: SrcDecls, b: Binding, index: core::option::Option<Expr>, scope: List<Binding>, value: SrcExpr) -> core::option::Option<Stmt> {
    return match (element_of(b.ty)) {
        None -> None,
        Some(element) -> store_any(decls, b, element, index, scope, value),
    };
}

// let x: ty = slice[index] for a word struct or enum ty, loaded into its slots.
pub fn lower_load_type(decls: SrcDecls, next: usize, binding: core::option::Option<Binding>, ty: SrcType, index: core::option::Option<Expr>, body: core::option::Option<Stmt>) -> core::option::Option<Stmt> {
    return match (binding) {
        None -> None,
        Some(b) -> match (index) {
            None -> None,
            Some(i) -> match (body) {
                None -> None,
                Some(s) -> checked_load(decls, b, ty, i, next, s),
            },
        },
    };
}

// extract: inline
fn checked_load(decls: SrcDecls, b: Binding, ty: SrcType, i: Expr, next: usize, s: Stmt) -> core::option::Option<Stmt> {
    if (word_element(decls, ty) && b.ty.same(Slice(boxed(ty)))) {
        return Some(load_type(ty, next, element_base(b.slot, ty.size(), i), 0, s));
    }
    return None;
}

pub fn lower_let_index(decls: SrcDecls, next: usize, binding: core::option::Option<Binding>, ty: SrcType, index: core::option::Option<Expr>, body: core::option::Option<Stmt>) -> core::option::Option<Stmt> {
    if (ty.is_i32()) {
        return lower_load_word(next, lower_element(binding, ty, index), body);
    }
    return lower_load_type(decls, next, binding, ty, index, body);
}

pub fn lower_set_index(decls: SrcDecls, binding: core::option::Option<Binding>, index: core::option::Option<Expr>, scope: List<Binding>, value: SrcExpr) -> core::option::Option<Stmt> {
    return match (binding) {
        None -> None,
        Some(b) -> lower_set_index_of(decls, b, index, scope, value),
    };
}

// sigs are the program's signatures and ret the function's result type; next
// is the first slot no binding in scope uses.
// slice[index] of a raw slice of word structs or enums: the index in slot,
// the value loaded from slot + 1 at Core's native offsets, then copied down.
pub fn eval_word_element(decls: SrcDecls, b: Binding, element: SrcType, slot: usize, i: Evaluated) -> core::option::Option<Evaluated> {
    if (word_element(decls, element) && (i.ty.is_i32() || i.ty.is_uint(Usize))) {
        return Some(Evaluated { stmt: Seq(boxed(i.stmt), boxed(check_then(slot, bounds_guard(b, Var(slot)), load_type(element, plus(slot, 1), element_base(b.slot, element.size(), Var(slot)), 0, assign_from(slot, slot_vars(plus(slot, 1), element.size()), Skip))))), ty: element });
    }
    return None;
}

// slice[index] of a raw slice of i32.
pub fn eval_element(decls: SrcDecls, b: Binding, element: SrcType, slot: usize, index: core::option::Option<Evaluated>) -> core::option::Option<Evaluated> {
    if (element.is_i32()) {
        return match (index) {
            None -> None,
            Some(i) -> eval_load(b, slot, i),
        };
    }
    return match (index) {
        None -> None,
        Some(i) -> eval_word_element(decls, b, element, slot, i),
    };
}

pub fn eval_index(decls: SrcDecls, scope: List<Binding>, slice: usize, slot: usize, index: core::option::Option<Evaluated>) -> core::option::Option<Evaluated> {
    return match (lookup(scope, slice)) {
        None -> None,
        Some(b) -> match (element_of(b.ty)) {
            None -> None,
            Some(element) -> eval_element(decls, b, element, slot, index),
        },
    };
}

// A raw slice's stride as isize bits: element i + 1 of an i32 slice starts 4
// bytes after element i, and of a word struct or enum slice, 8 bytes a word
// before it.
pub fn word_stride(slot: usize, words: usize) -> Evaluated {
    return Evaluated { stmt: Assign(slot, Binary(U64, Sub, boxed(Lit(0)), boxed(Lit(times(8, words) as u64)))), ty: Isize };
}

pub fn eval_word_stride(decls: SrcDecls, element: SrcType, slot: usize) -> core::option::Option<Evaluated> {
    if (word_element(decls, element)) {
        return Some(word_stride(slot, element.size()));
    }
    return None;
}

pub fn eval_stride_of(decls: SrcDecls, element: SrcType, slot: usize) -> core::option::Option<Evaluated> {
    if (element.is_i32()) {
        return Some(Evaluated { stmt: Assign(slot, Lit(4)), ty: Isize });
    }
    return eval_word_stride(decls, element, slot);
}

pub fn eval_stride(decls: SrcDecls, scope: List<Binding>, slice: usize, slot: usize) -> core::option::Option<Evaluated> {
    return match (lookup(scope, slice)) {
        None -> None,
        Some(b) -> match (element_of(b.ty)) {
            None -> None,
            Some(element) -> eval_stride_of(decls, element, slot),
        },
    };
}

// extract: mutual begin
impl SrcEff {
    // The code computing this expression into slot, slot + 1, ..., and its type.
    pub fn eval(self, sigs: List<Sig>, decls: SrcDecls, scope: List<Binding>, slot: usize) -> core::option::Option<Evaluated> {
        return match (self) {
            EPure(e) -> eval_pure(scope, e, slot),
            ECall(callee, args) -> eval_call(get(sigs, callee), callee, slot, eval_args(sigs, decls, scope, unbox(args), slot)),
            EApply(op, left, right) -> eval_apply(op, slot, unbox(left).eval(sigs, decls, scope, slot), unbox(right).eval(sigs, decls, scope, plus(slot, 1))),
            ENeg(operand) -> eval_negate(slot, unbox(operand).eval(sigs, decls, scope, slot)),
            ENot(operand) -> eval_not(slot, unbox(operand).eval(sigs, decls, scope, slot)),
            ECast(ty, operand) -> eval_cast(ty, slot, unbox(operand).eval(sigs, decls, scope, slot)),
            EIndex(slice, index) -> eval_index(decls, scope, slice, slot, unbox(index).eval(sigs, decls, scope, slot)),
            EStruct(ty, fields) -> eval_struct(ty, eval_args(sigs, decls, scope, unbox(fields), slot)),
            EVariant(ty, variant, payload) -> eval_variant(ty, variant, slot, eval_args(sigs, decls, scope, unbox(payload), plus(slot, 1))),
            EMatch(scrutinee, ety, ty, binders, values) -> eval_match(slot, ety, ty, unbox(scrutinee).eval(sigs, decls, scope, slot), eval_arms(sigs, decls, scope, slot, match_dst(slot, ety, ty), ty, 0, match_variants(ety), binders, unbox(values)), length(binders), length(unbox(values))),
            EDivide(op, left, right) -> eval_division(op, slot, unbox(left).eval(sigs, decls, scope, slot), unbox(right).eval(sigs, decls, scope, plus(slot, 1))),
            EStride(slice) -> eval_stride(decls, scope, slice, slot),
        };
    }
}

// The arguments, each in the slots after the one before.
pub fn eval_args(sigs: List<Sig>, decls: SrcDecls, scope: List<Binding>, args: List<SrcEff>, slot: usize) -> core::option::Option<EvaluatedArgs> {
    return match (args) {
        Nil -> Some(EvaluatedArgs { stmt: Skip, types: empty() }),
        Cons(arg, rest) -> match (arg.eval(sigs, decls, scope, slot)) {
            None -> None,
            Some(first) -> cons_args(first, eval_args(sigs, decls, scope, unbox(rest), plus(slot, first.ty.size()))),
        },
    };
}

// Arms k, k + 1, ... of a match on the enum in slot, one per variant from k.
pub fn eval_arms(sigs: List<Sig>, decls: SrcDecls, scope: List<Binding>, slot: usize, dst: usize, ty: SrcType, k: usize, variants: List<List<SrcType>>, binders: List<List<usize>>, values: List<SrcEff>) -> core::option::Option<Stmt> {
    return match (values) {
        Nil -> None,
        Cons(value, rest) -> match (variants) {
            Nil -> None,
            Cons(types, more) -> match (binders) {
                Nil -> None,
                Cons(bs, others) -> eval_arm_in(sigs, decls, arm_scope(bs, types, plus(slot, 1), scope), slot, dst, ty, k, value, unbox(rest), eval_arms(sigs, decls, scope, slot, dst, ty, plus(k, 1), unbox(more), unbox(others), unbox(rest))),
            },
        },
    };
}
// extract: mutual end

// The index in slot and its check g, then the value from slot + 1 and the
// stores of its words.
pub fn store_eval_then(i: Evaluated, v: Evaluated, element: SrcType, slot: usize, g: Expr, store: core::option::Option<Stmt>) -> core::option::Option<Stmt> {
    if ((i.ty.is_i32() || i.ty.is_uint(Usize)) && v.ty.same(element)) {
        return match (store) {
            None -> None,
            Some(s) -> Some(Seq(boxed(i.stmt), boxed(check_then(slot, g, Seq(boxed(v.stmt), boxed(s)))))),
        };
    }
    return None;
}

// slice[index] = value on a raw slice of word structs or word enums.
pub fn store_eval_word(decls: SrcDecls, b: Binding, element: SrcType, slot: usize, i: Evaluated, v: Evaluated) -> core::option::Option<Stmt> {
    if (word_element(decls, element)) {
        return store_eval_then(i, v, element, slot, bounds_guard(b, Var(slot)), store_type(element, slot_vars(plus(slot, 1), element.size()), 0, element_base(b.slot, element.size(), Var(slot)), 0));
    }
    return None;
}

// The index in slot and its bounds check, then the value in slot + 1 and the
// 32-bit store: Core checks the bound before it evaluates the value.
pub fn store_eval(b: Binding, slot: usize, i: Evaluated, v: Evaluated) -> core::option::Option<Stmt> {
    if ((i.ty.is_i32() || i.ty.is_uint(Usize)) && v.ty.is_i32()) {
        return Some(Seq(boxed(i.stmt), boxed(check_then(slot, bounds_guard(b, Var(slot)), Seq(boxed(v.stmt), boxed(StoreWord(M32, Binary(U64, Add, boxed(Var(b.slot)), boxed(Binary(U64, Mul, boxed(Var(slot)), boxed(Lit(4))))), Var(plus(slot, 1)))))))));
    }
    return None;
}

// slice[index] = value on a raw slice.
pub fn store_eval_element(decls: SrcDecls, b: Binding, element: SrcType, slot: usize, index: core::option::Option<Evaluated>, value: core::option::Option<Evaluated>) -> core::option::Option<Stmt> {
    if (element.is_i32()) {
        return match (index) {
            None -> None,
            Some(i) -> match (value) {
                None -> None,
                Some(v) -> store_eval(b, slot, i, v),
            },
        };
    }
    return match (index) {
        None -> None,
        Some(i) -> match (value) {
            None -> None,
            Some(v) -> store_eval_word(decls, b, element, slot, i, v),
        },
    };
}

// x.field = value: the value in slot, then copied to the field's slot.
pub fn set_field_eval_at(target: usize, found: core::option::Option<SrcType>, slot: usize, v: Evaluated) -> core::option::Option<Stmt> {
    return match (found) {
        None -> None,
        Some(ty) -> set_scalar_eval(target, ty, slot, v),
    };
}

// extract: inline
fn set_scalar_eval(target: usize, fty: SrcType, from: usize, value: Evaluated) -> core::option::Option<Stmt> {
    if (fty.is_scalar()) {
        return eval_same(value, fty, Seq(boxed(value.stmt), boxed(Assign(target, Var(from)))));
    }
    return None;
}

pub fn set_field_eval_of(b: Binding, field: usize, slot: usize, v: Evaluated) -> core::option::Option<Stmt> {
    return match (b.ty) {
        I32 -> None,
        Bool -> None,
        Uint(kind) -> None,
        Struct(id, fields) -> set_field_eval_at(plus(b.slot, field_offset(unbox(fields), field)), get(unbox(fields), field), slot, v),
        Enum(id, variants) -> None,
        Ptr -> None,
        Slice(element) -> None,
        Unit -> None,
        Isize -> None,
        SrcType::Char -> None,
        Sint(sk) -> None,
    };
}

pub fn lower_set_field_eval(slot: usize, binding: core::option::Option<Binding>, field: usize, value: core::option::Option<Evaluated>) -> core::option::Option<Stmt> {
    return match (binding) {
        None -> None,
        Some(b) -> match (value) {
            None -> None,
            Some(v) -> set_field_eval_of(b, field, slot, v),
        },
    };
}

// return; in a unit function: its one slot, whose bits do not matter.
pub fn lower_return_unit(ret: SrcType) -> core::option::Option<Stmt> {
    if (ret.is_unit()) {
        return Some(Stmt::Ret(single(Lit(0))));
    }
    return None;
}

// assert(condition): the condition's code, then 1 / condition into the same
// slot, which has no run when the condition is false (on x86 the division
// traps, as Core does), so a failed assert or a panic stops the program.
pub fn lower_assert(condition: core::option::Option<Evaluated>, slot: usize) -> core::option::Option<Stmt> {
    return match (condition) {
        None -> None,
        Some(c) -> eval_same(c, Bool, Seq(boxed(c.stmt), boxed(Stmt::Divide(U64, UDiv, slot, Lit(1), Var(slot))))),
    };
}

pub fn lower_set_index_eval(decls: SrcDecls, slot: usize, binding: core::option::Option<Binding>, index: core::option::Option<Evaluated>, value: core::option::Option<Evaluated>) -> core::option::Option<Stmt> {
    return match (binding) {
        None -> None,
        Some(b) -> match (element_of(b.ty)) {
            None -> None,
            Some(element) -> store_eval_element(decls, b, element, slot, index, value),
        },
    };
}

impl SrcStmt {
    pub fn lower(self, sigs: List<Sig>, decls: SrcDecls, ret: SrcType, scope: List<Binding>, next: usize) -> core::option::Option<Stmt> {
        return match (self) {
            Nop -> Some(Skip),
            Let(id, ty, value, body) -> guarded(next, value.guard(scope), lower_let(next, lower_value(scope, value, ty), unbox(body).lower(sigs, decls, ret, cons(Binding { id: id, slot: next, ty: ty }, scope), plus(next, ty.size())))),
            LetStruct(id, ty, fields, body) -> guarded(next, guard_all(scope, fields), lower_let(next, lower_literal(scope, ty, fields), unbox(body).lower(sigs, decls, ret, cons(Binding { id: id, slot: next, ty: ty }, scope), plus(next, ty.size())))),
            LetCall(id, ty, callee, args, body) -> guarded(next, guard_all(scope, args), lower_let_call(next, ty.size(), callee, lower_call(sigs, scope, callee, args, ty), unbox(body).lower(sigs, decls, ret, cons(Binding { id: id, slot: next, ty: ty }, scope), plus(next, ty.size())))),
            LetEnum(id, ty, variant, payload, body) -> guarded(next, guard_all(scope, payload), lower_let(next, lower_enum_value(scope, ty, variant, payload), unbox(body).lower(sigs, decls, ret, cons(Binding { id: id, slot: next, ty: ty }, scope), plus(next, ty.size())))),
            LetMatch(id, ty, scrutinee, enum_id, arms, body) -> lower_then(lower_match(scope, lookup(scope, scrutinee), enum_id, arms, ty, next), unbox(body).lower(sigs, decls, ret, cons(Binding { id: id, slot: next, ty: ty }, scope), plus(next, ty.size()))),
            Set(id, value) -> guarded(next, value.guard(scope), lower_set(lookup(scope, id), scope, value)),
            SetField(id, index, value) -> guarded(next, value.guard(scope), lower_set_field(lookup(scope, id), index, scope, value)),
            SetCall(id, callee, args) -> guarded(next, guard_all(scope, args), lower_set_call(sigs, scope, lookup(scope, id), callee, args)),
            Then(first, second) -> lower_then(unbox(first).lower(sigs, decls, ret, scope, next), unbox(second).lower(sigs, decls, ret, scope, next)),
            If(condition, then_branch, else_branch) -> guarded(next, condition.guard(scope), lower_if(lower_as(scope, condition, Bool), unbox(then_branch).lower(sigs, decls, ret, scope, next), unbox(else_branch).lower(sigs, decls, ret, scope, next))),
            While(condition, body) -> guarded(next, condition.guard(scope), lower_while(next, condition.guard(scope), lower_as(scope, condition, Bool), unbox(body).lower(sigs, decls, ret, scope, next))),
            Return(value) -> guarded(next, value.guard(scope), lower_return(lower_value(scope, value, ret))),
            LetAlloc(id, size, shift, body) -> guarded(next, size.guard(scope), lower_alloc(next, shift, lower_as(scope, size, Uint(Usize)), unbox(body).lower(sigs, decls, ret, cons(Binding { id: id, slot: next, ty: Ptr }, scope), plus(next, 1)))),
            LetLoad(id, pointer, offset, body) -> guarded(next, guard_and(pointer.guard(scope), offset.guard(scope)), lower_load(next, lower_address(lower_as(scope, pointer, Ptr), lower_as(scope, offset, Uint(Usize))), unbox(body).lower(sigs, decls, ret, cons(Binding { id: id, slot: next, ty: Uint(Uint8) }, scope), plus(next, 1)))),
            SetByte(pointer, offset, value) -> guarded(next, guard_and(pointer.guard(scope), guard_and(offset.guard(scope), value.guard(scope))), lower_store(lower_address(lower_as(scope, pointer, Ptr), lower_as(scope, offset, Uint(Usize))), lower_as(scope, value, Uint(Uint8)))),
            Free(pointer, size, shift) -> guarded(next, guard_and(pointer.guard(scope), size.guard(scope)), lower_free(shift, lower_as(scope, pointer, Ptr), lower_as(scope, size, Uint(Usize)))),
            LetSlice(id, element, pointer, length, body) -> guarded(next, guard_and(pointer.guard(scope), length.guard(scope)), lower_let(next, lower_slice(decls, element, lower_as(scope, pointer, Ptr), lower_as(scope, length, I32)), unbox(body).lower(sigs, decls, ret, cons(Binding { id: id, slot: next, ty: Slice(boxed(element)) }, scope), plus(next, 2)))),
            LetIndex(id, ty, slice, index, body) -> guarded(next, guard_and(index.guard(scope), index_guard(scope, slice, index)), lower_let_index(decls, next, lookup(scope, slice), ty, lower_index(scope, index), unbox(body).lower(sigs, decls, ret, cons(Binding { id: id, slot: next, ty: ty }, scope), plus(next, ty.size())))),
            SetIndex(slice, index, value) -> guarded(next, guard_and(guard_and(index.guard(scope), index_guard(scope, slice, index)), value.guard(scope)), lower_set_index(decls, lookup(scope, slice), lower_index(scope, index), scope, value)),
            LetEval(id, ty, value, body) -> lower_let_eval(ty, value.eval(sigs, decls, scope, next), unbox(body).lower(sigs, decls, ret, cons(Binding { id: id, slot: next, ty: ty }, scope), plus(next, ty.size()))),
            SetEval(id, value) -> lower_set_eval(next, lookup(scope, id), value.eval(sigs, decls, scope, next)),
            IfEval(condition, then_branch, else_branch) -> lower_if_eval(next, condition.eval(sigs, decls, scope, next), unbox(then_branch).lower(sigs, decls, ret, scope, next), unbox(else_branch).lower(sigs, decls, ret, scope, next)),
            WhileEval(condition, body) -> lower_while_eval(next, condition.eval(sigs, decls, scope, next), unbox(body).lower(sigs, decls, ret, scope, next)),
            ReturnEval(value) -> lower_return_eval(next, ret, value.eval(sigs, decls, scope, next)),
            Discard(value) -> lower_discard(value.eval(sigs, decls, scope, next)),
            SetIndexEval(slice, index, value) -> lower_set_index_eval(decls, next, lookup(scope, slice), index.eval(sigs, decls, scope, next), value.eval(sigs, decls, scope, plus(next, 1))),
            SetFieldEval(id, field, value) -> lower_set_field_eval(next, lookup(scope, id), field, value.eval(sigs, decls, scope, next)),
            ReturnUnit -> lower_return_unit(ret),
            Assert(condition) -> lower_assert(condition.eval(sigs, decls, scope, next), next),
        };
    }

    // Slots the statement's lets need beyond the ones in scope.
    pub fn depth(self) -> usize {
        return match (self) {
            Nop -> 0,
            Let(id, ty, value, body) -> plus(unbox(body).depth(), ty.size()),
            LetStruct(id, ty, fields, body) -> plus(unbox(body).depth(), ty.size()),
            LetCall(id, ty, callee, args, body) -> plus(unbox(body).depth(), ty.size()),
            LetEnum(id, ty, variant, payload, body) -> plus(unbox(body).depth(), ty.size()),
            LetMatch(id, ty, scrutinee, enum_id, arms, body) -> plus(unbox(body).depth(), ty.size()),
            Set(id, value) -> 0,
            SetField(id, index, value) -> 0,
            SetCall(id, callee, args) -> 0,
            Then(first, second) -> max_of(unbox(first).depth(), unbox(second).depth()),
            If(condition, then_branch, else_branch) -> max_of(unbox(then_branch).depth(), unbox(else_branch).depth()),
            While(condition, body) -> unbox(body).depth(),
            Return(value) -> 0,
            LetAlloc(id, size, shift, body) -> plus(unbox(body).depth(), 1),
            LetLoad(id, pointer, offset, body) -> plus(unbox(body).depth(), 1),
            SetByte(pointer, offset, value) -> 0,
            Free(pointer, size, shift) -> 0,
            LetSlice(id, element, pointer, length, body) -> plus(unbox(body).depth(), 2),
            LetIndex(id, ty, slice, index, body) -> plus(unbox(body).depth(), ty.size()),
            SetIndex(slice, index, value) -> 0,
            LetEval(id, ty, value, body) -> plus(unbox(body).depth(), ty.size()),
            SetEval(id, value) -> 0,
            IfEval(condition, then_branch, else_branch) -> max_of(unbox(then_branch).depth(), unbox(else_branch).depth()),
            WhileEval(condition, body) -> unbox(body).depth(),
            ReturnEval(value) -> 0,
            Discard(value) -> 0,
            SetIndexEval(slice, index, value) -> 0,
            SetFieldEval(id, field, value) -> 0,
            ReturnUnit -> 0,
            Assert(condition) -> 0,
        };
    }
}

// Parameters take slots from 0 in order, a struct one per field; a later
// parameter with the same id shadows an earlier one, as Core's bindLocals
// does.
pub fn param_scope(params: List<SrcParam>, slot: usize, scope: List<Binding>) -> List<Binding> {
    return match (params) {
        Nil -> scope,
        Cons(param, rest) -> param_scope(unbox(rest), plus(slot, param.ty.size()), cons(Binding { id: param.id, slot: slot, ty: param.ty }, scope)),
    };
}

pub fn params_valid(params: List<SrcParam>) -> bool {
    return match (params) {
        Nil -> true,
        Cons(param, rest) -> (param.ty.size() > 0) && params_valid(unbox(rest)),
    };
}

pub fn params_size(params: List<SrcParam>) -> usize {
    return match (params) {
        Nil -> 0,
        Cons(param, rest) -> plus(param.ty.size(), params_size(unbox(rest))),
    };
}

pub fn param_types(params: List<SrcParam>) -> List<SrcType> {
    return match (params) {
        Nil -> empty(),
        Cons(param, rest) -> cons(param.ty, param_types(unbox(rest))),
    };
}

pub fn sigs(funcs: List<SrcFunc>) -> List<Sig> {
    return match (funcs) {
        Nil -> empty(),
        Cons(func, rest) -> cons(Sig { params: param_types(func.params), ret: func.ret }, sigs(unbox(rest))),
    };
}

// One more than the largest slot an expression reads.
impl Expr {
    pub fn extent(self) -> usize {
        return match (self) {
            Lit(value) -> 0,
            Var(index) -> plus(index, 1),
            Expr::Neg(operand) -> unbox(operand).extent(),
            Binary(word, operation, left, right) -> max_of(unbox(left).extent(), unbox(right).extent()),
            Compare(word, operation, left, right) -> max_of(unbox(left).extent(), unbox(right).extent()),
        };
    }
}

pub fn args_extent(args: List<Expr>) -> usize {
    return match (args) {
        Nil -> 0,
        Cons(arg, rest) -> max_of(arg.extent(), args_extent(unbox(rest))),
    };
}

// One more than the largest slot a statement names, so its frame holds the
// slots an effectful expression computes in.
impl Stmt {
    pub fn extent(self) -> usize {
        return match (self) {
            Skip -> 0,
            Assign(index, value) -> max_of(plus(index, 1), value.extent()),
            Seq(first, second) -> max_of(unbox(first).extent(), unbox(second).extent()),
            Ite(condition, then_branch, else_branch) -> max_of(condition.extent(), max_of(unbox(then_branch).extent(), unbox(else_branch).extent())),
            Loop(condition, body) -> max_of(condition.extent(), unbox(body).extent()),
            Stmt::Call(target, count, callee, args) -> max_of(plus(target, count), args_extent(args)),
            Stmt::Ret(values) -> args_extent(values),
            Alloc(target, shift, size) -> max_of(plus(target, 1), size.extent()),
            LoadByte(target, address) -> max_of(plus(target, 1), address.extent()),
            StoreByte(address, value) -> max_of(address.extent(), value.extent()),
            LoadWord(width, target, address) -> max_of(plus(target, 1), address.extent()),
            StoreWord(width, address, value) -> max_of(address.extent(), value.extent()),
            Stmt::Divide(word, operation, target, left, right) -> max_of(plus(target, 1), max_of(left.extent(), right.extent())),
        };
    }
}

pub fn lower_body(count: usize, results: usize, depth: usize, body: core::option::Option<Stmt>) -> core::option::Option<Func> {
    return match (body) {
        None -> None,
        Some(b) -> Some(Func { params: count, results: results, locals: max_of(max_of(plus(count, depth), results), b.extent()), body: b }),
    };
}

// A unit function may end without a return: one is added after its body.
pub fn unit_tail(ret: SrcType, body: core::option::Option<Stmt>) -> core::option::Option<Stmt> {
    if (ret.is_unit()) {
        return match (body) {
            None -> None,
            Some(b) -> Some(Seq(boxed(b), boxed(Stmt::Ret(single(Lit(0)))))),
        };
    }
    return body;
}

// Results and struct parameters have slots; a function returns its result
// type's slots, so it has at least that many locals.
pub fn lower_func(sigs: List<Sig>, decls: SrcDecls, func: SrcFunc) -> core::option::Option<Func> {
    let count: usize = params_size(func.params);
    if ((func.ret.size() > 0) && params_valid(func.params)) {
        return lower_body(count, func.ret.size(), func.body.depth(), unit_tail(func.ret, func.body.lower(sigs, decls, func.ret, param_scope(func.params, 0, empty()), count)));
    }
    return None;
}

pub fn lower_func_cons(first: core::option::Option<Func>, rest: core::option::Option<List<Func>>) -> core::option::Option<List<Func>> {
    return match (first) {
        None -> None,
        Some(f) -> match (rest) {
            None -> None,
            Some(fs) -> Some(cons(f, fs)),
        },
    };
}

pub fn lower_funcs(sigs: List<Sig>, decls: SrcDecls, funcs: List<SrcFunc>) -> core::option::Option<List<Func>> {
    return match (funcs) {
        Nil -> Some(empty()),
        Cons(func, rest) -> lower_func_cons(lower_func(sigs, decls, func), lower_funcs(sigs, decls, unbox(rest))),
    };
}

// Core's typing needs two things the lowering does not check.
//
// Declarations: Core names a struct or enum type by its id and looks the
// fields or variants up in the program's declarations, while a source type
// carries them inline. The front pass derives one declaration per id from
// the program's types (parameters, results and bindings, and the types
// nested in them), and rejects a program that gives one id two field or
// variant lists. Lanius/Mini/Source.lean puts these declarations in the
// program's Core meaning.
//
// Returns: a function body ends in a return on every path.

// decls, if the declaration already there agrees.
pub fn keep_if(agrees: bool, decls: SrcDecls) -> core::option::Option<SrcDecls> {
    if (agrees) {
        return Some(decls);
    }
    return None;
}

// Struct id with these fields declared, unless id has other fields.
pub fn declare_struct(id: usize, fields: List<SrcType>, after: core::option::Option<SrcDecls>) -> core::option::Option<SrcDecls> {
    return match (after) {
        None -> None,
        Some(decls) -> declare_struct_in(id, fields, decls, struct_fields(decls.structs, id)),
    };
}

// extract: inline
fn declare_struct_in(id: usize, fields: List<SrcType>, decls: SrcDecls, known: core::option::Option<List<SrcType>>) -> core::option::Option<SrcDecls> {
    return match (known) {
        None -> Some(SrcDecls { structs: cons(SrcStructDecl { id: id, fields: fields }, decls.structs), enums: decls.enums }),
        Some(other) -> keep_if(types_same(other, fields), decls),
    };
}

// Enum id with these variants declared, unless id has other variants.
pub fn declare_enum(id: usize, variants: List<List<SrcType>>, after: core::option::Option<SrcDecls>) -> core::option::Option<SrcDecls> {
    return match (after) {
        None -> None,
        Some(decls) -> declare_enum_in(id, variants, decls, enum_variants(decls.enums, id)),
    };
}

// extract: inline
fn declare_enum_in(id: usize, variants: List<List<SrcType>>, decls: SrcDecls, known: core::option::Option<List<List<SrcType>>>) -> core::option::Option<SrcDecls> {
    return match (known) {
        None -> Some(SrcDecls { structs: decls.structs, enums: cons(SrcEnumDecl { id: id, variants: variants }, decls.enums) }),
        Some(other) -> keep_if(variants_same(other, variants), decls),
    };
}

// extract: inline
fn declare_types_after(after: core::option::Option<SrcDecls>, rest: List<SrcType>) -> core::option::Option<SrcDecls> {
    return match (after) {
        None -> None,
        Some(decls) -> declare_types(rest, decls),
    };
}

// extract: inline
fn declare_variants_after(after: core::option::Option<SrcDecls>, rest: List<List<SrcType>>) -> core::option::Option<SrcDecls> {
    return match (after) {
        None -> None,
        Some(decls) -> declare_variants(rest, decls),
    };
}

// extract: mutual begin
impl SrcType {
    // decls with every struct and enum type in this one declared, the nested
    // ones first; None when one is declared with other fields or variants.
    pub fn declare(self, decls: SrcDecls) -> core::option::Option<SrcDecls> {
        return match (self) {
            I32 -> Some(decls),
            Bool -> Some(decls),
            Uint(kind) -> Some(decls),
            Struct(id, fields) -> declare_struct(id, unbox(fields), declare_types(unbox(fields), decls)),
            Enum(id, variants) -> declare_enum(id, unbox(variants), declare_variants(unbox(variants), decls)),
            Ptr -> Some(decls),
            Slice(element) -> unbox(element).declare(decls),
            Unit -> Some(decls),
            Isize -> Some(decls),
            SrcType::Char -> Some(decls),
            Sint(kind) -> Some(decls),
        };
    }
}

pub fn declare_types(types: List<SrcType>, decls: SrcDecls) -> core::option::Option<SrcDecls> {
    return match (types) {
        Nil -> Some(decls),
        Cons(ty, rest) -> declare_types_after(ty.declare(decls), unbox(rest)),
    };
}

pub fn declare_variants(variants: List<List<SrcType>>, decls: SrcDecls) -> core::option::Option<SrcDecls> {
    return match (variants) {
        Nil -> Some(decls),
        Cons(types, rest) -> declare_variants_after(declare_types(types, decls), unbox(rest)),
    };
}
// extract: mutual end

// extract: inline
fn declare_in(after: core::option::Option<SrcDecls>, body: SrcStmt) -> core::option::Option<SrcDecls> {
    return match (after) {
        None -> None,
        Some(decls) -> body.declare(decls),
    };
}

impl SrcStmt {
    // decls with the types of the statement's bindings declared.
    pub fn declare(self, decls: SrcDecls) -> core::option::Option<SrcDecls> {
        return match (self) {
            Nop -> Some(decls),
            Let(id, ty, value, body) -> declare_in(ty.declare(decls), unbox(body)),
            LetStruct(id, ty, fields, body) -> declare_in(ty.declare(decls), unbox(body)),
            LetCall(id, ty, callee, args, body) -> declare_in(ty.declare(decls), unbox(body)),
            LetEnum(id, ty, variant, payload, body) -> declare_in(ty.declare(decls), unbox(body)),
            LetMatch(id, ty, scrutinee, enum_id, arms, body) -> declare_in(ty.declare(decls), unbox(body)),
            Set(id, value) -> Some(decls),
            SetField(id, index, value) -> Some(decls),
            SetCall(id, callee, args) -> Some(decls),
            Then(first, second) -> declare_in(unbox(first).declare(decls), unbox(second)),
            If(condition, then_branch, else_branch) -> declare_in(unbox(then_branch).declare(decls), unbox(else_branch)),
            While(condition, body) -> unbox(body).declare(decls),
            Return(value) -> Some(decls),
            LetAlloc(id, size, shift, body) -> unbox(body).declare(decls),
            LetLoad(id, pointer, offset, body) -> unbox(body).declare(decls),
            SetByte(pointer, offset, value) -> Some(decls),
            Free(pointer, size, shift) -> Some(decls),
            LetSlice(id, element, pointer, length, body) -> declare_in(element.declare(decls), unbox(body)),
            LetIndex(id, ty, slice, index, body) -> declare_in(ty.declare(decls), unbox(body)),
            SetIndex(slice, index, value) -> Some(decls),
            LetEval(id, ty, value, body) -> declare_in(declare_types(cons(ty, value.types()), decls), unbox(body)),
            SetEval(id, value) -> declare_types(value.types(), decls),
            IfEval(condition, then_branch, else_branch) -> declare_in(declare_in(declare_types(condition.types(), decls), unbox(then_branch)), unbox(else_branch)),
            WhileEval(condition, body) -> declare_in(declare_types(condition.types(), decls), unbox(body)),
            ReturnEval(value) -> declare_types(value.types(), decls),
            Discard(value) -> declare_types(value.types(), decls),
            SetIndexEval(slice, index, value) -> declare_types(concat(index.types(), value.types()), decls),
            SetFieldEval(id, field, value) -> declare_types(value.types(), decls),
            ReturnUnit -> Some(decls),
            Assert(condition) -> declare_types(condition.types(), decls),
        };
    }

    // Every path ends in a return, the way Core's DefinitelyReturns counts:
    // a while body never counts.
    pub fn returns(self) -> bool {
        return match (self) {
            Nop -> false,
            Let(id, ty, value, body) -> unbox(body).returns(),
            LetStruct(id, ty, fields, body) -> unbox(body).returns(),
            LetCall(id, ty, callee, args, body) -> unbox(body).returns(),
            LetEnum(id, ty, variant, payload, body) -> unbox(body).returns(),
            LetMatch(id, ty, scrutinee, enum_id, arms, body) -> unbox(body).returns(),
            Set(id, value) -> false,
            SetField(id, index, value) -> false,
            SetCall(id, callee, args) -> false,
            Then(first, second) -> unbox(first).returns() || unbox(second).returns(),
            If(condition, then_branch, else_branch) -> unbox(then_branch).returns() && unbox(else_branch).returns(),
            While(condition, body) -> false,
            Return(value) -> true,
            LetAlloc(id, size, shift, body) -> unbox(body).returns(),
            LetLoad(id, pointer, offset, body) -> unbox(body).returns(),
            SetByte(pointer, offset, value) -> false,
            Free(pointer, size, shift) -> false,
            LetSlice(id, element, pointer, length, body) -> unbox(body).returns(),
            LetIndex(id, ty, slice, index, body) -> unbox(body).returns(),
            SetIndex(slice, index, value) -> false,
            LetEval(id, ty, value, body) -> unbox(body).returns(),
            SetEval(id, value) -> false,
            IfEval(condition, then_branch, else_branch) -> unbox(then_branch).returns() && unbox(else_branch).returns(),
            WhileEval(condition, body) -> false,
            ReturnEval(value) -> true,
            Discard(value) -> false,
            SetIndexEval(slice, index, value) -> false,
            SetFieldEval(id, field, value) -> false,
            ReturnUnit -> true,
            Assert(condition) -> false,
        };
    }
}

pub fn declare_params(params: List<SrcParam>, decls: SrcDecls) -> core::option::Option<SrcDecls> {
    return match (params) {
        Nil -> Some(decls),
        Cons(param, rest) -> declare_params_after(param.ty.declare(decls), unbox(rest)),
    };
}

// extract: inline
fn declare_params_after(after: core::option::Option<SrcDecls>, rest: List<SrcParam>) -> core::option::Option<SrcDecls> {
    return match (after) {
        None -> None,
        Some(decls) -> declare_params(rest, decls),
    };
}

// A function's parameter, result and binding types.
pub fn declare_func(func: SrcFunc, decls: SrcDecls) -> core::option::Option<SrcDecls> {
    return match (declare_params(func.params, decls)) {
        None -> None,
        Some(with_params) -> declare_in(func.ret.declare(with_params), func.body),
    };
}

pub fn declare_funcs(funcs: List<SrcFunc>, decls: SrcDecls) -> core::option::Option<SrcDecls> {
    return match (funcs) {
        Nil -> Some(decls),
        Cons(func, rest) -> declare_funcs_after(declare_func(func, decls), unbox(rest)),
    };
}

// extract: inline
fn declare_funcs_after(after: core::option::Option<SrcDecls>, rest: List<SrcFunc>) -> core::option::Option<SrcDecls> {
    return match (after) {
        None -> None,
        Some(decls) -> declare_funcs(rest, decls),
    };
}

// The program's struct and enum declarations.
pub fn declare_program(prog: SrcProgram) -> core::option::Option<SrcDecls> {
    return declare_funcs(prog.funcs, SrcDecls { structs: empty(), enums: empty() });
}

pub fn funcs_return(funcs: List<SrcFunc>) -> bool {
    return match (funcs) {
        Nil -> true,
        Cons(func, rest) -> (func.ret.is_unit() || func.body.returns()) && funcs_return(unbox(rest)),
    };
}

// Translation validation (roadmap step 13). The optimizer below is not
// proved: no proof mentions it. Its output is checked by validate, which is
// proved in Lanius/Mini/Validate.lean (validate p q = true: every run of p
// that returns has a run of q with the same result and heap), and
// compile_optimized compiles the original program when the check fails.

// The validator. Word arithmetic first, as the mini semantics computes it.

// The low 32 bits of a word, zero-extended.
pub fn low_bits(value: u64) -> u64 {
    return value & 4294967295;
}

// The low 32 bits plus 2^31, mod 2^32: unsigned order on keys is signed
// order on the low halves.
pub fn signed_key(value: u64) -> u64 {
    return low_bits(value + 2147483648);
}

impl BinOp {
    pub fn compute(self, a: u64, b: u64) -> u64 {
        return match (self) {
            Add -> a + b,
            Sub -> a - b,
            Mul -> a * b,
            And -> a & b,
            Or -> a | b,
            Xor -> a ^ b,
            Shl -> 0,
            Shr -> 0,
            Sar -> 0,
        };
    }

    // compute is the operation (shifts are not folded).
    pub fn folds(self) -> bool {
        return match (self) {
            Add -> true,
            Sub -> true,
            Mul -> true,
            And -> true,
            Or -> true,
            Xor -> true,
            Shl -> false,
            Shr -> false,
            Sar -> false,
        };
    }

    // x op unit is x.
    pub fn unit(self) -> u64 {
        return match (self) {
            Add -> 0,
            Sub -> 0,
            Mul -> 1,
            And -> 18446744073709551615,
            Or -> 0,
            Xor -> 0,
            Shl -> 0,
            Shr -> 0,
            Sar -> 0,
        };
    }

    // unit op x is x too.
    pub fn commutes(self) -> bool {
        return match (self) {
            Add -> true,
            Sub -> false,
            Mul -> true,
            And -> true,
            Or -> true,
            Xor -> true,
            Shl -> false,
            Shr -> false,
            Sar -> false,
        };
    }

    // x op 0 and 0 op x are 0.
    pub fn annihilates(self) -> bool {
        return match (self) {
            Add -> false,
            Sub -> false,
            Mul -> true,
            And -> true,
            Or -> false,
            Xor -> false,
            Shl -> false,
            Shr -> false,
            Sar -> false,
        };
    }

    pub fn number(self) -> usize {
        return match (self) {
            Add -> 0,
            Sub -> 1,
            Mul -> 2,
            And -> 3,
            Or -> 4,
            Xor -> 5,
            Shl -> 6,
            Shr -> 7,
            Sar -> 8,
        };
    }
}

impl DivOp {
    pub fn number(self) -> usize {
        return match (self) {
            SDiv -> 0,
            SRem -> 1,
            UDiv -> 2,
            URem -> 3,
        };
    }
}

impl CmpOp {
    // Unsigned comparison.
    pub fn test(self, a: u64, b: u64) -> bool {
        return match (self) {
            Eq -> a == b,
            Ne -> a != b,
            Lt -> b > a,
            Le -> b >= a,
            Gt -> a > b,
            Ge -> a >= b,
        };
    }

    pub fn number(self) -> usize {
        return match (self) {
            Eq -> 0,
            Ne -> 1,
            Lt -> 2,
            Le -> 3,
            Gt -> 4,
            Ge -> 5,
        };
    }
}

impl Word {
    // Word.apply.
    pub fn compute(self, operation: BinOp, a: u64, b: u64) -> u64 {
        return match (self) {
            S32 -> low_bits(operation.compute(a, b)),
            U64 -> operation.compute(a, b),
        };
    }

    // Word.holds.
    pub fn test(self, operation: CmpOp, a: u64, b: u64) -> bool {
        return match (self) {
            S32 -> operation.test(signed_key(a), signed_key(b)),
            U64 -> operation.test(a, b),
        };
    }

    // a and b are the same operand of an operation on this word.
    pub fn same_operand(self, a: u64, b: u64) -> bool {
        return match (self) {
            S32 -> low_bits(a) == low_bits(b),
            U64 -> a == b,
        };
    }

    // Results are zero-extended.
    pub fn narrows(self) -> bool {
        return match (self) {
            S32 -> true,
            U64 -> false,
        };
    }

    pub fn number(self) -> usize {
        return match (self) {
            S32 -> 0,
            U64 -> 1,
        };
    }
}

impl Expr {
    // The value is below 2^32 in every environment.
    pub fn narrow(self) -> bool {
        return match (self) {
            Lit(value) -> 4294967295 >= value,
            Var(index) -> false,
            Expr::Neg(operand) -> true,
            Binary(word, operation, left, right) -> word.narrows(),
            Compare(word, operation, left, right) -> true,
        };
    }
}

impl Word {
    // An operation on this word may pass e through unchanged: an S32 one
    // zero-extends, so e must be narrow.
    pub fn keeps(self, e: Expr) -> bool {
        return match (self) {
            S32 -> e.narrow(),
            U64 -> true,
        };
    }
}

pub fn negate_constant(value: core::option::Option<u64>) -> core::option::Option<u64> {
    return match (value) {
        Some(v) -> Some(low_bits(0 - v)),
        None -> None,
    };
}

pub fn absorbed(operation: BinOp, value: u64) -> core::option::Option<u64> {
    if (operation.annihilates() && value == 0) {
        return Some(0);
    }
    return None;
}

pub fn fold_constant(word: Word, operation: BinOp, a: u64, b: u64) -> core::option::Option<u64> {
    if (operation.folds()) {
        return Some(word.compute(operation, a, b));
    }
    return None;
}

pub fn binary_constant(word: Word, operation: BinOp, left: core::option::Option<u64>, right: core::option::Option<u64>) -> core::option::Option<u64> {
    return match (left) {
        Some(a) -> match (right) {
            Some(b) -> fold_constant(word, operation, a, b),
            None -> absorbed(operation, a),
        },
        None -> match (right) {
            Some(b) -> absorbed(operation, b),
            None -> None,
        },
    };
}

pub fn compare_constant(word: Word, operation: CmpOp, left: core::option::Option<u64>, right: core::option::Option<u64>) -> core::option::Option<u64> {
    return match (left) {
        Some(a) -> match (right) {
            Some(b) -> Some(bool_bits(word.test(operation, a, b))),
            None -> None,
        },
        None -> None,
    };
}

pub fn constant_is(value: core::option::Option<u64>, literal: u64) -> bool {
    return match (value) {
        Some(v) -> v == literal,
        None -> false,
    };
}

impl Expr {
    // Some(v) when the expression is v in every environment.
    pub fn constant(self) -> core::option::Option<u64> {
        return match (self) {
            Lit(value) -> Some(value),
            Var(index) -> None,
            Expr::Neg(operand) -> negate_constant(unbox(operand).constant()),
            Binary(word, operation, left, right) -> binary_constant(word, operation, unbox(left).constant(), unbox(right).constant()),
            Compare(word, operation, left, right) -> compare_constant(word, operation, unbox(left).constant(), unbox(right).constant()),
        };
    }

    // The expression is the literal value.
    pub fn is_constant(self, value: core::option::Option<u64>) -> bool {
        return match (self) {
            Lit(literal) -> constant_is(value, literal),
            Var(index) -> false,
            Expr::Neg(operand) -> false,
            Binary(word, operation, left, right) -> false,
            Compare(word, operation, left, right) -> false,
        };
    }

    pub fn is_var(self, index: usize) -> bool {
        return match (self) {
            Lit(value) -> false,
            Var(other) -> other == index,
            Expr::Neg(operand) -> false,
            Binary(word, operation, left, right) -> false,
            Compare(word, operation, left, right) -> false,
        };
    }

    pub fn is_zero(self) -> bool {
        return constant_is(self.constant(), 0);
    }

    // The expression is a constant c with x op c = x.
    pub fn unit_of(self, word: Word, operation: BinOp) -> bool {
        return match (self.constant()) {
            Some(c) -> word.same_operand(c, operation.unit()),
            None -> false,
        };
    }

    // other has this expression's value in every environment: it is the
    // constant, or it has the same shape with agreeing operands, or it is
    // the operand kept by an identity like x + 0.
    pub fn agrees(self, other: Expr) -> bool {
        if (other.is_constant(self.constant())) {
            return true;
        }
        return match (self) {
            Lit(value) -> false,
            Var(index) -> other.is_var(index),
            Expr::Neg(operand) -> neg_agrees(unbox(operand), other),
            Binary(word, operation, left, right) -> binary_agrees(word, operation, unbox(left), unbox(right), other) || unit_agrees(word, operation, unbox(left), unbox(right), other),
            Compare(word, operation, left, right) -> compare_agrees(word, operation, unbox(left), unbox(right), other),
        };
    }
}

// extract: inline
fn neg_agrees(operand: Expr, other: Expr) -> bool {
    return match (other) {
        Lit(v) -> false,
        Var(i) -> false,
        Expr::Neg(o) -> operand.agrees(unbox(o)),
        Binary(w, op, l, r) -> false,
        Compare(w, op, l, r) -> false,
    };
}

// extract: inline
fn binary_agrees(word: Word, operation: BinOp, left: Expr, right: Expr, other: Expr) -> bool {
    return match (other) {
        Lit(v) -> false,
        Var(i) -> false,
        Expr::Neg(o) -> false,
        Binary(w, op, l, r) -> (word.number() == w.number()) && (operation.number() == op.number()) && left.agrees(unbox(l)) && right.agrees(unbox(r)),
        Compare(w, op, l, r) -> false,
    };
}

// extract: inline
fn unit_agrees(word: Word, operation: BinOp, left: Expr, right: Expr, other: Expr) -> bool {
    return (right.unit_of(word, operation) && word.keeps(other) && left.agrees(other)) || (operation.commutes() && left.unit_of(word, operation) && word.keeps(other) && right.agrees(other));
}

// extract: inline
fn compare_agrees(word: Word, operation: CmpOp, left: Expr, right: Expr, other: Expr) -> bool {
    return match (other) {
        Lit(v) -> false,
        Var(i) -> false,
        Expr::Neg(o) -> false,
        Binary(w, op, l, r) -> false,
        Compare(w, op, l, r) -> (word.number() == w.number()) && (operation.number() == op.number()) && left.agrees(unbox(l)) && right.agrees(unbox(r)),
    };
}

pub fn args_agree(args: List<Expr>, others: List<Expr>) -> bool {
    return match (args) {
        Nil -> match (others) {
            Nil -> true,
            Cons(o, more) -> false,
        },
        Cons(arg, rest) -> match (others) {
            Nil -> false,
            Cons(o, more) -> arg.agrees(o) && args_agree(unbox(rest), unbox(more)),
        },
    };
}

pub fn assign_agrees(index: usize, value: Expr, other: Stmt) -> bool {
    return match (other) {
        Skip -> value.agrees(Var(index)),
        Assign(i, v) -> (index == i) && value.agrees(v),
        Seq(f, s) -> false,
        Ite(c, t, e) -> false,
        Loop(c, b) -> false,
        Stmt::Call(t, n, f, a) -> false,
        Stmt::Ret(v) -> false,
        Alloc(t, sh, sz) -> false,
        LoadByte(t, a) -> false,
        StoreByte(a, v) -> false,
        LoadWord(w, t, a) -> false,
        StoreWord(w, a, v) -> false,
        Divide(w, o, t, l, r) -> false,
    };
}

pub fn call_agrees(target: usize, count: usize, callee: usize, args: List<Expr>, other: Stmt) -> bool {
    return match (other) {
        Skip -> false,
        Assign(i, v) -> false,
        Seq(f, s) -> false,
        Ite(c, t, e) -> false,
        Loop(c, b) -> false,
        Stmt::Call(t, n, f, a) -> (target == t) && (count == n) && (callee == f) && args_agree(args, a),
        Stmt::Ret(v) -> false,
        Alloc(t, sh, sz) -> false,
        LoadByte(t, a) -> false,
        StoreByte(a, v) -> false,
        LoadWord(w, t, a) -> false,
        StoreWord(w, a, v) -> false,
        Divide(w, o, t, l, r) -> false,
    };
}

pub fn ret_agrees(values: List<Expr>, other: Stmt) -> bool {
    return match (other) {
        Skip -> false,
        Assign(i, v) -> false,
        Seq(f, s) -> false,
        Ite(c, t, e) -> false,
        Loop(c, b) -> false,
        Stmt::Call(t, n, f, a) -> false,
        Stmt::Ret(v) -> args_agree(values, v),
        Alloc(t, sh, sz) -> false,
        LoadByte(t, a) -> false,
        StoreByte(a, v) -> false,
        LoadWord(w, t, a) -> false,
        StoreWord(w, a, v) -> false,
        Divide(w, o, t, l, r) -> false,
    };
}

pub fn alloc_agrees(target: usize, shift: usize, size: Expr, other: Stmt) -> bool {
    return match (other) {
        Skip -> false,
        Assign(i, v) -> false,
        Seq(f, s) -> false,
        Ite(c, t, e) -> false,
        Loop(c, b) -> false,
        Stmt::Call(t, n, f, a) -> false,
        Stmt::Ret(v) -> false,
        Alloc(t, sh, sz) -> (target == t) && (shift == sh) && size.agrees(sz),
        LoadByte(t, a) -> false,
        StoreByte(a, v) -> false,
        LoadWord(w, t, a) -> false,
        StoreWord(w, a, v) -> false,
        Divide(w, o, t, l, r) -> false,
    };
}

pub fn load_byte_agrees(target: usize, address: Expr, other: Stmt) -> bool {
    return match (other) {
        Skip -> false,
        Assign(i, v) -> false,
        Seq(f, s) -> false,
        Ite(c, t, e) -> false,
        Loop(c, b) -> false,
        Stmt::Call(t, n, f, a) -> false,
        Stmt::Ret(v) -> false,
        Alloc(t, sh, sz) -> false,
        LoadByte(t, a) -> (target == t) && address.agrees(a),
        StoreByte(a, v) -> false,
        LoadWord(w, t, a) -> false,
        StoreWord(w, a, v) -> false,
        Divide(w, o, t, l, r) -> false,
    };
}

pub fn store_byte_agrees(address: Expr, value: Expr, other: Stmt) -> bool {
    return match (other) {
        Skip -> false,
        Assign(i, v) -> false,
        Seq(f, s) -> false,
        Ite(c, t, e) -> false,
        Loop(c, b) -> false,
        Stmt::Call(t, n, f, a) -> false,
        Stmt::Ret(v) -> false,
        Alloc(t, sh, sz) -> false,
        LoadByte(t, a) -> false,
        StoreByte(a, v) -> address.agrees(a) && value.agrees(v),
        LoadWord(w, t, a) -> false,
        StoreWord(w, a, v) -> false,
        Divide(w, o, t, l, r) -> false,
    };
}

pub fn load_word_agrees(width: MemWidth, target: usize, address: Expr, other: Stmt) -> bool {
    return match (other) {
        Skip -> false,
        Assign(i, v) -> false,
        Seq(f, s) -> false,
        Ite(c, t, e) -> false,
        Loop(c, b) -> false,
        Stmt::Call(t, n, f, a) -> false,
        Stmt::Ret(v) -> false,
        Alloc(t, sh, sz) -> false,
        LoadByte(t, a) -> false,
        StoreByte(a, v) -> false,
        LoadWord(w, t, a) -> (width.bytes() == w.bytes()) && (target == t) && address.agrees(a),
        StoreWord(w, a, v) -> false,
        Divide(w, o, t, l, r) -> false,
    };
}

pub fn store_word_agrees(width: MemWidth, address: Expr, value: Expr, other: Stmt) -> bool {
    return match (other) {
        Skip -> false,
        Assign(i, v) -> false,
        Seq(f, s) -> false,
        Ite(c, t, e) -> false,
        Loop(c, b) -> false,
        Stmt::Call(t, n, f, a) -> false,
        Stmt::Ret(v) -> false,
        Alloc(t, sh, sz) -> false,
        LoadByte(t, a) -> false,
        StoreByte(a, v) -> false,
        LoadWord(w, t, a) -> false,
        StoreWord(w, a, v) -> (width.bytes() == w.bytes()) && address.agrees(a) && value.agrees(v),
        Divide(w, o, t, l, r) -> false,
    };
}

pub fn divide_agrees(word: Word, operation: DivOp, target: usize, left: Expr, right: Expr, other: Stmt) -> bool {
    return match (other) {
        Skip -> false,
        Assign(i, v) -> false,
        Seq(f, s) -> false,
        Ite(c, t, e) -> false,
        Loop(c, b) -> false,
        Stmt::Call(t, n, f, a) -> false,
        Stmt::Ret(v) -> false,
        Alloc(t, sh, sz) -> false,
        LoadByte(t, a) -> false,
        StoreByte(a, v) -> false,
        LoadWord(w, t, a) -> false,
        StoreWord(w, a, v) -> false,
        Divide(w, o, t, l, r) -> (word.number() == w.number()) && (operation.number() == o.number()) && (target == t) && left.agrees(l) && right.agrees(r),
    };
}

// Copy and constant propagation. A fact says that a slot holds a literal or
// another slot's value. The validator reads each expression of the original
// program with the facts known before it substituted, and checks the
// optimized expression against that.
pub struct Fact {
    slot: usize,
    value: Expr,
}

pub fn fact_value(facts: List<Fact>, index: usize) -> Expr {
    return match (facts) {
        Nil -> Var(index),
        Cons(fact, rest) -> fact_or(fact, index, unbox(rest)),
    };
}

// extract: inline
fn fact_or(fact: Fact, index: usize, tail: List<Fact>) -> Expr {
    if (fact.slot == index) {
        return fact.value;
    }
    return fact_value(tail, index);
}

impl Expr {
    // The expression reads slot index.
    pub fn mentions(self, index: usize) -> bool {
        return match (self) {
            Lit(value) -> false,
            Var(other) -> other == index,
            Expr::Neg(operand) -> unbox(operand).mentions(index),
            Binary(word, operation, left, right) -> unbox(left).mentions(index) || unbox(right).mentions(index),
            Compare(word, operation, left, right) -> unbox(left).mentions(index) || unbox(right).mentions(index),
        };
    }

    // Each slot with a fact replaced by the fact's value.
    pub fn subst(self, facts: List<Fact>) -> Expr {
        return match (self) {
            Lit(value) -> Lit(value),
            Var(index) -> fact_value(facts, index),
            Expr::Neg(operand) -> Expr::Neg(boxed(unbox(operand).subst(facts))),
            Binary(word, operation, left, right) -> Binary(word, operation, boxed(unbox(left).subst(facts)), boxed(unbox(right).subst(facts))),
            Compare(word, operation, left, right) -> Compare(word, operation, boxed(unbox(left).subst(facts)), boxed(unbox(right).subst(facts))),
        };
    }

    // A literal or a slot: cheap to copy into each use.
    pub fn is_atom(self) -> bool {
        return match (self) {
            Lit(value) -> true,
            Var(index) -> true,
            Expr::Neg(operand) -> false,
            Binary(word, operation, left, right) -> false,
            Compare(word, operation, left, right) -> false,
        };
    }
}

pub fn subst_all(values: List<Expr>, facts: List<Fact>) -> List<Expr> {
    return match (values) {
        Nil -> empty(),
        Cons(value, rest) -> cons(value.subst(facts), subst_all(unbox(rest), facts)),
    };
}

pub fn mentions_any(values: List<Expr>, index: usize) -> bool {
    return match (values) {
        Nil -> false,
        Cons(value, rest) -> value.mentions(index) || mentions_any(unbox(rest), index),
    };
}

// The facts that still hold after slot index is written.
pub fn kill(facts: List<Fact>, index: usize) -> List<Fact> {
    return match (facts) {
        Nil -> empty(),
        Cons(fact, rest) -> kept(fact, index, kill(unbox(rest), index)),
    };
}

// extract: inline
fn kept(fact: Fact, index: usize, tail: List<Fact>) -> List<Fact> {
    if ((fact.slot != index) && !fact.value.mentions(index)) {
        return cons(fact, tail);
    }
    return tail;
}

// The facts after index = value.
pub fn assigned(facts: List<Fact>, index: usize, value: Expr) -> List<Fact> {
    let known: Expr = value.subst(facts);
    let rest: List<Fact> = kill(facts, index);
    if (known.is_atom() && !known.mentions(index)) {
        return cons(Fact { slot: index, value: known }, rest);
    }
    return rest;
}

impl Stmt {
    pub fn is_skip(self) -> bool {
        return match (self) {
            Skip -> true,
            Assign(i, v) -> false,
            Seq(f, s) -> false,
            Ite(c, t, e) -> false,
            Loop(c, b) -> false,
            Stmt::Call(t, n, f, a) -> false,
            Stmt::Ret(v) -> false,
            Alloc(t, sh, sz) -> false,
            LoadByte(t, a) -> false,
            StoreByte(a, v) -> false,
            LoadWord(w, t, a) -> false,
            StoreWord(w, a, v) -> false,
            Divide(w, o, t, l, r) -> false,
        };
    }

    // The facts that hold after a run of this statement that ends
    // normally, given facts that hold before it. Branches, loops and calls
    // forget them all.
    pub fn facts_after(self, facts: List<Fact>) -> List<Fact> {
        return match (self) {
            Skip -> facts,
            Assign(index, value) -> assigned(facts, index, value),
            Seq(first, second) -> unbox(second).facts_after(unbox(first).facts_after(facts)),
            Ite(c, t, e) -> empty(),
            Loop(c, b) -> empty(),
            Stmt::Call(t, n, f, a) -> empty(),
            Stmt::Ret(v) -> empty(),
            Alloc(target, sh, sz) -> kill(facts, target),
            LoadByte(target, a) -> kill(facts, target),
            StoreByte(a, v) -> facts,
            LoadWord(w, target, a) -> kill(facts, target),
            StoreWord(w, a, v) -> facts,
            Divide(w, o, target, l, r) -> kill(facts, target),
        };
    }

    // No run of this statement reads slot index: runs from two states that
    // differ only at index end in states that differ only at index.
    pub fn ignores(self, index: usize) -> bool {
        return match (self) {
            Skip -> true,
            Assign(i, v) -> !v.mentions(index),
            Seq(f, s) -> unbox(f).ignores(index) && unbox(s).ignores(index),
            Ite(c, t, e) -> !c.mentions(index) && unbox(t).ignores(index) && unbox(e).ignores(index),
            Loop(c, b) -> !c.mentions(index) && unbox(b).ignores(index),
            Stmt::Call(t, n, f, a) -> !mentions_any(a, index),
            Stmt::Ret(v) -> !mentions_any(v, index),
            Alloc(t, sh, sz) -> !sz.mentions(index),
            LoadByte(t, a) -> !a.mentions(index),
            StoreByte(a, v) -> !a.mentions(index) && !v.mentions(index),
            LoadWord(w, t, a) -> !a.mentions(index),
            StoreWord(w, a, v) -> !a.mentions(index) && !v.mentions(index),
            Divide(w, o, t, l, r) -> !l.mentions(index) && !r.mentions(index),
        };
    }

    // Every run of this statement writes slot index before reading it, or
    // returns without reading it: the value index holds on entry is dead.
    pub fn kills(self, index: usize) -> bool {
        return match (self) {
            Skip -> false,
            Assign(i, v) -> (i == index) && !v.mentions(index),
            Seq(f, s) -> unbox(f).kills(index) || (unbox(f).ignores(index) && unbox(s).kills(index)),
            Ite(c, t, e) -> !c.mentions(index) && unbox(t).kills(index) && unbox(e).kills(index),
            Loop(c, b) -> false,
            Stmt::Call(t, n, f, a) -> false,
            Stmt::Ret(v) -> !mentions_any(v, index),
            Alloc(t, sh, sz) -> false,
            LoadByte(t, a) -> false,
            StoreByte(a, v) -> false,
            LoadWord(w, t, a) -> false,
            StoreWord(w, a, v) -> false,
            Divide(w, o, t, l, r) -> false,
        };
    }

    // other ends every run of this statement the same way, when facts hold
    // on entry: the same shape with agreeing expressions (each original one
    // read with the facts substituted), or a statement dropped because it
    // does nothing (skip, x = x, a loop whose condition is 0) or because it
    // stores a slot the rest kills, or a branch chosen because its condition
    // is a constant or both branches agree with other. Against Skip, a Seq's
    // two dropped-statement cases are the same check, and with a constant
    // condition both branches agreeing implies the chosen one does, so those
    // are not tried twice: each would double the time at each level of
    // nesting. The same shape, the usual case, is tried first.
    pub fn agrees(self, facts: List<Fact>, other: Stmt) -> bool {
        return match (self) {
            Skip -> other.is_skip(),
            Assign(index, value) -> assign_agrees(index, value.subst(facts), other),
            Seq(first, second) -> seq_agrees(unbox(first), unbox(second), facts, other) || dead_agrees(unbox(first), unbox(second), facts, other) || (unbox(first).agrees(facts, Skip) && unbox(second).agrees(unbox(first).facts_after(facts), other)) || (!other.is_skip() && unbox(second).agrees(unbox(first).facts_after(facts), Skip) && unbox(first).agrees(facts, other)),
            Ite(condition, then_branch, else_branch) -> ite_agrees(condition.subst(facts), unbox(then_branch), unbox(else_branch), facts, other) || branch_agrees(condition.subst(facts).constant(), unbox(then_branch), unbox(else_branch), facts, other) || (unknown(condition.subst(facts).constant()) && unbox(then_branch).agrees(facts, other) && unbox(else_branch).agrees(facts, other)),
            Loop(condition, body) -> (condition.is_zero() && other.is_skip()) || loop_agrees(condition, unbox(body), other),
            Stmt::Call(target, count, callee, args) -> call_agrees(target, count, callee, subst_all(args, facts), other),
            Stmt::Ret(values) -> ret_agrees(subst_all(values, facts), other),
            Alloc(target, shift, size) -> alloc_agrees(target, shift, size.subst(facts), other),
            LoadByte(target, address) -> load_byte_agrees(target, address.subst(facts), other),
            StoreByte(address, value) -> store_byte_agrees(address.subst(facts), value.subst(facts), other),
            LoadWord(width, target, address) -> load_word_agrees(width, target, address.subst(facts), other),
            StoreWord(width, address, value) -> store_word_agrees(width, address.subst(facts), value.subst(facts), other),
            Divide(word, operation, target, left, right) -> divide_agrees(word, operation, target, left.subst(facts), right.subst(facts), other),
        };
    }
}

// first is index = value, and other, which agrees with second, kills index.
// extract: inline
fn dead_agrees(first: Stmt, second: Stmt, facts: List<Fact>, other: Stmt) -> bool {
    return match (first) {
        Skip -> false,
        Assign(index, value) -> other.kills(index) && second.agrees(assigned(facts, index, value), other),
        Seq(f, s) -> false,
        Ite(c, t, e) -> false,
        Loop(c, b) -> false,
        Stmt::Call(t, n, f, a) -> false,
        Stmt::Ret(v) -> false,
        Alloc(t, sh, sz) -> false,
        LoadByte(t, a) -> false,
        StoreByte(a, v) -> false,
        LoadWord(w, t, a) -> false,
        StoreWord(w, a, v) -> false,
        Divide(w, o, t, l, r) -> false,
    };
}

// extract: inline
fn seq_agrees(first: Stmt, second: Stmt, facts: List<Fact>, other: Stmt) -> bool {
    return match (other) {
        Skip -> false,
        Assign(i, v) -> false,
        Seq(f, s) -> first.agrees(facts, unbox(f)) && second.agrees(first.facts_after(facts), unbox(s)),
        Ite(c, t, e) -> false,
        Loop(c, b) -> false,
        Stmt::Call(t, n, f, a) -> false,
        Stmt::Ret(v) -> false,
        Alloc(t, sh, sz) -> false,
        LoadByte(t, a) -> false,
        StoreByte(a, v) -> false,
        LoadWord(w, t, a) -> false,
        StoreWord(w, a, v) -> false,
        Divide(w, o, t, l, r) -> false,
    };
}

// A condition the facts do not make a constant.
// extract: inline
fn unknown(known: core::option::Option<u64>) -> bool {
    return match (known) {
        Some(v) -> false,
        None -> true,
    };
}

// extract: inline
fn branch_agrees(known: core::option::Option<u64>, then_branch: Stmt, else_branch: Stmt, facts: List<Fact>, other: Stmt) -> bool {
    return match (known) {
        Some(v) -> ((v == 0) && else_branch.agrees(facts, other)) || ((v != 0) && then_branch.agrees(facts, other)),
        None -> false,
    };
}

// extract: inline
fn ite_agrees(test: Expr, then_branch: Stmt, else_branch: Stmt, facts: List<Fact>, other: Stmt) -> bool {
    return match (other) {
        Skip -> false,
        Assign(i, v) -> false,
        Seq(f, s) -> false,
        Ite(c, t, e) -> test.agrees(c) && then_branch.agrees(facts, unbox(t)) && else_branch.agrees(facts, unbox(e)),
        Loop(c, b) -> false,
        Stmt::Call(t, n, f, a) -> false,
        Stmt::Ret(v) -> false,
        Alloc(t, sh, sz) -> false,
        LoadByte(t, a) -> false,
        StoreByte(a, v) -> false,
        LoadWord(w, t, a) -> false,
        StoreWord(w, a, v) -> false,
        Divide(w, o, t, l, r) -> false,
    };
}

// A loop's body runs from states the facts may not describe: no facts.
// extract: inline
fn loop_agrees(condition: Expr, body: Stmt, other: Stmt) -> bool {
    return match (other) {
        Skip -> false,
        Assign(i, v) -> false,
        Seq(f, s) -> false,
        Ite(c, t, e) -> false,
        Loop(c, b) -> condition.agrees(c) && body.agrees(empty(), unbox(b)),
        Stmt::Call(t, n, f, a) -> false,
        Stmt::Ret(v) -> false,
        Alloc(t, sh, sz) -> false,
        LoadByte(t, a) -> false,
        StoreByte(a, v) -> false,
        LoadWord(w, t, a) -> false,
        StoreWord(w, a, v) -> false,
        Divide(w, o, t, l, r) -> false,
    };
}

impl Func {
    pub fn agrees(self, other: Func) -> bool {
        return (self.params == other.params) && (self.results == other.results) && (self.locals == other.locals) && self.body.agrees(empty(), other.body);
    }
}

pub fn funcs_agree(funcs: List<Func>, others: List<Func>) -> bool {
    return match (funcs) {
        Nil -> match (others) {
            Nil -> true,
            Cons(o, more) -> false,
        },
        Cons(func, rest) -> match (others) {
            Nil -> false,
            Cons(o, more) -> func.agrees(o) && funcs_agree(unbox(rest), unbox(more)),
        },
    };
}

// The validator: optimized has the original's functions, in order, each
// agreeing with the original one.
pub fn validate(original: Program, optimized: Program) -> bool {
    return funcs_agree(original.funcs, optimized.funcs);
}

// The optimizer. NOT PROVED, and no proof mentions it: compile_optimized
// keeps its output only when validate accepts it. It folds constant
// subexpressions, applies x + 0, x - 0, x * 1, x & -1, x | 0, x ^ 0 (and the
// commuted forms) and x * 0, x & 0, picks the branch of an if on a constant,
// and drops statements that do nothing: skip, x = x, an if with two empty
// branches, a while whose condition is 0. It leaves divisions in place, so a
// division that traps still traps. Along each sequence it propagates copies
// and constants (x = y or x = 5 makes later reads of x read y or 5, until x
// or y is written; branches, loops and calls forget all of them), and drops
// x = e when the optimized rest of the sequence writes x before reading it.

pub fn fact_dies(fact: Fact, index: usize) -> bool {
    return (fact.slot == index) || fact.value.mentions(index);
}

pub fn extent_after(dies: bool, k: usize, extent: usize) -> usize {
    if (dies) {
        return k;
    }
    return extent;
}

// How many of the facts, counted from the front, reach the last one that
// dies (0 when none does); k facts come before these.
pub fn dying_extent(facts: List<Fact>, index: usize, k: usize, extent: usize) -> usize {
    return match (facts) {
        Nil -> extent,
        Cons(fact, rest) -> dying_extent(unbox(rest), index, plus(k, 1), extent_after(fact_dies(fact, index), plus(k, 1), extent)),
    };
}

pub fn kill_prefix_at(fact: Fact, index: usize, tail: List<Fact>) -> List<Fact> {
    if (fact_dies(fact, index)) {
        return tail;
    }
    return cons(fact, tail);
}

// The first n facts filtered as kill does, followed by the rest unchanged.
pub fn kill_prefix(facts: List<Fact>, index: usize, n: usize) -> List<Fact> {
    if (n == 0) {
        return facts;
    }
    return match (facts) {
        Nil -> empty(),
        Cons(fact, rest) -> kill_prefix_at(fact, index, kill_prefix(unbox(rest), index, minus(n, 1))),
    };
}

// kill(facts, index), sharing the facts after the last one that dies.
pub fn opt_kill(facts: List<Fact>, index: usize) -> List<Fact> {
    return kill_prefix(facts, index, dying_extent(facts, index, 0, 0));
}

pub fn opt_assigned(facts: List<Fact>, index: usize, value: Expr) -> List<Fact> {
    let known: Expr = value.subst(facts);
    let rest: List<Fact> = opt_kill(facts, index);
    if (known.is_atom() && !known.mentions(index)) {
        return cons(Fact { slot: index, value: known }, rest);
    }
    return rest;
}

// The optimizer's copy of the validator's facts_after: the same facts, but a
// write keeps the part of the list after the last fact it kills instead of
// rebuilding it (the self-built compiler's heap is never freed, and the
// validator's kill rebuilds the whole list on every write).
pub fn opt_facts_after(s: Stmt, facts: List<Fact>) -> List<Fact> {
    return match (s) {
        Skip -> facts,
        Assign(index, value) -> opt_assigned(facts, index, value),
        Seq(first, second) -> opt_facts_after(unbox(second), opt_facts_after(unbox(first), facts)),
        Ite(c, t, e) -> empty(),
        Loop(c, b) -> empty(),
        Stmt::Call(t, n, f, a) -> empty(),
        Stmt::Ret(v) -> empty(),
        Alloc(target, sh, sz) -> opt_kill(facts, target),
        LoadByte(target, a) -> opt_kill(facts, target),
        StoreByte(a, v) -> facts,
        LoadWord(w, target, a) -> opt_kill(facts, target),
        StoreWord(w, a, v) -> facts,
        Divide(w, o, target, l, r) -> opt_kill(facts, target),
    };
}

impl Expr {
    pub fn literal(self) -> core::option::Option<u64> {
        return match (self) {
            Lit(value) -> Some(value),
            Var(index) -> None,
            Expr::Neg(operand) -> None,
            Binary(word, operation, left, right) -> None,
            Compare(word, operation, left, right) -> None,
        };
    }
}

pub fn optimize_neg(operand: Expr) -> Expr {
    return match (operand.literal()) {
        Some(v) -> Lit(low_bits(0 - v)),
        None -> Expr::Neg(boxed(operand)),
    };
}

// The left operand is the literal a.
pub fn optimize_left(word: Word, operation: BinOp, a: u64, left: Expr, right: Expr) -> Expr {
    if (operation.annihilates() && a == 0) {
        return Lit(0);
    }
    if (operation.commutes() && word.same_operand(a, operation.unit()) && word.keeps(right)) {
        return right;
    }
    return Binary(word, operation, boxed(left), boxed(right));
}

// The right operand is the literal b.
pub fn optimize_right(word: Word, operation: BinOp, left: Expr, right: Expr, b: u64) -> Expr {
    if (operation.annihilates() && b == 0) {
        return Lit(0);
    }
    if (word.same_operand(b, operation.unit()) && word.keeps(left)) {
        return left;
    }
    return Binary(word, operation, boxed(left), boxed(right));
}

// Both operands are the literals a and b.
pub fn optimize_both(word: Word, operation: BinOp, a: u64, b: u64, left: Expr, right: Expr) -> Expr {
    if (operation.folds()) {
        return Lit(word.compute(operation, a, b));
    }
    return Binary(word, operation, boxed(left), boxed(right));
}

pub fn optimize_binary(word: Word, operation: BinOp, left: Expr, right: Expr) -> Expr {
    return match (left.literal()) {
        Some(a) -> match (right.literal()) {
            Some(b) -> optimize_both(word, operation, a, b, left, right),
            None -> optimize_left(word, operation, a, left, right),
        },
        None -> match (right.literal()) {
            Some(b) -> optimize_right(word, operation, left, right, b),
            None -> Binary(word, operation, boxed(left), boxed(right)),
        },
    };
}

pub fn optimize_compare(word: Word, operation: CmpOp, left: Expr, right: Expr) -> Expr {
    return match (left.literal()) {
        Some(a) -> match (right.literal()) {
            Some(b) -> Lit(bool_bits(word.test(operation, a, b))),
            None -> Compare(word, operation, boxed(left), boxed(right)),
        },
        None -> Compare(word, operation, boxed(left), boxed(right)),
    };
}

impl Expr {
    pub fn optimize(self) -> Expr {
        return match (self) {
            Lit(value) -> Lit(value),
            Var(index) -> Var(index),
            Expr::Neg(operand) -> optimize_neg(unbox(operand).optimize()),
            Binary(word, operation, left, right) -> optimize_binary(word, operation, unbox(left).optimize(), unbox(right).optimize()),
            Compare(word, operation, left, right) -> optimize_compare(word, operation, unbox(left).optimize(), unbox(right).optimize()),
        };
    }
}

pub fn optimize_all(values: List<Expr>) -> List<Expr> {
    return match (values) {
        Nil -> empty(),
        Cons(value, rest) -> cons(value.optimize(), optimize_all(unbox(rest))),
    };
}

pub fn optimize_assign(index: usize, value: Expr) -> Stmt {
    if (value.is_var(index)) {
        return Skip;
    }
    return Assign(index, value);
}

pub fn optimize_seq(first: Stmt, second: Stmt) -> Stmt {
    if (first.is_skip()) {
        return second;
    }
    if (second.is_skip()) {
        return first;
    }
    return Seq(boxed(first), boxed(second));
}

pub fn pick_branch(value: u64, then_branch: Stmt, else_branch: Stmt) -> Stmt {
    if (value == 0) {
        return else_branch;
    }
    return then_branch;
}

pub fn ite_or_skip(condition: Expr, then_branch: Stmt, else_branch: Stmt) -> Stmt {
    if (then_branch.is_skip() && else_branch.is_skip()) {
        return Skip;
    }
    return Ite(condition, boxed(then_branch), boxed(else_branch));
}

pub fn optimize_ite(condition: Expr, then_branch: Stmt, else_branch: Stmt) -> Stmt {
    return match (condition.literal()) {
        Some(v) -> pick_branch(v, then_branch, else_branch),
        None -> ite_or_skip(condition, then_branch, else_branch),
    };
}

pub fn loop_unless_zero(value: u64, condition: Expr, body: Stmt) -> Stmt {
    if (value == 0) {
        return Skip;
    }
    return Loop(condition, boxed(body));
}

pub fn optimize_loop(condition: Expr, body: Stmt) -> Stmt {
    return match (condition.literal()) {
        Some(v) -> loop_unless_zero(v, condition, body),
        None -> Loop(condition, boxed(body)),
    };
}

impl Stmt {
    // first = index = value is dead when rest kills index.
    pub fn dead_before(self, rest: Stmt) -> bool {
        return match (self) {
            Skip -> false,
            Assign(index, value) -> rest.kills(index),
            Seq(f, s) -> false,
            Ite(c, t, e) -> false,
            Loop(c, b) -> false,
            Stmt::Call(t, n, f, a) -> false,
            Stmt::Ret(v) -> false,
            Alloc(t, sh, sz) -> false,
            LoadByte(t, a) -> false,
            StoreByte(a, v) -> false,
            LoadWord(w, t, a) -> false,
            StoreWord(w, a, v) -> false,
            Divide(w, o, t, l, r) -> false,
        };
    }

    // facts hold on entry: each expression is read with them substituted.
    pub fn optimize(self, facts: List<Fact>) -> Stmt {
        return match (self) {
            Skip -> Skip,
            Assign(index, value) -> optimize_assign(index, value.subst(facts).optimize()),
            Seq(first, second) -> optimize_sequence(unbox(first), unbox(second), facts),
            Ite(condition, then_branch, else_branch) -> optimize_ite(condition.subst(facts).optimize(), unbox(then_branch).optimize(facts), unbox(else_branch).optimize(facts)),
            Loop(condition, body) -> optimize_loop(condition.optimize(), unbox(body).optimize(empty())),
            Stmt::Call(target, count, callee, args) -> Stmt::Call(target, count, callee, optimize_all(subst_all(args, facts))),
            Stmt::Ret(values) -> Stmt::Ret(optimize_all(subst_all(values, facts))),
            Alloc(target, shift, size) -> Alloc(target, shift, size.subst(facts).optimize()),
            LoadByte(target, address) -> LoadByte(target, address.subst(facts).optimize()),
            StoreByte(address, value) -> StoreByte(address.subst(facts).optimize(), value.subst(facts).optimize()),
            LoadWord(width, target, address) -> LoadWord(width, target, address.subst(facts).optimize()),
            StoreWord(width, address, value) -> StoreWord(width, address.subst(facts).optimize(), value.subst(facts).optimize()),
            Divide(word, operation, target, left, right) -> Divide(word, operation, target, left.subst(facts).optimize(), right.subst(facts).optimize()),
        };
    }
}

// The second statement is optimized with the facts after the first; a store
// to a slot the optimized rest kills is dropped.
// extract: inline
fn optimize_sequence(first: Stmt, second: Stmt, facts: List<Fact>) -> Stmt {
    let rest: Stmt = second.optimize(opt_facts_after(first, facts));
    if (first.dead_before(rest)) {
        return rest;
    }
    return optimize_seq(first.optimize(facts), rest);
}

pub fn optimize_funcs(funcs: List<Func>) -> List<Func> {
    return match (funcs) {
        Nil -> empty(),
        Cons(func, rest) -> cons(Func { params: func.params, results: func.results, locals: func.locals, body: func.body.optimize(empty()) }, optimize_funcs(unbox(rest))),
    };
}

pub fn optimize_program(prog: Program) -> Program {
    return Program { funcs: optimize_funcs(prog.funcs) };
}

// The pipeline: optimize, keep the result when the validator accepts it and
// it compiles, and otherwise compile the original program.

pub fn compile_or(binary: core::option::Option<Binary>, prog: Program) -> core::option::Option<Binary> {
    return match (binary) {
        Some(b) -> Some(b),
        None -> compile_program(prog),
    };
}

pub fn compile_optimized(prog: Program) -> core::option::Option<Binary> {
    let optimized: Program = optimize_program(prog);
    if (validate(prog, optimized)) {
        return compile_or(compile_program(optimized), prog);
    }
    return compile_program(prog);
}

pub fn compile_lowered(funcs: core::option::Option<List<Func>>) -> core::option::Option<Binary> {
    return match (funcs) {
        None -> None,
        Some(fs) -> compile_optimized(Program { funcs: fs }),
    };
}

// The functions are lowered against the declarations, which the slice
// lowering consults for its element types.
pub fn compile_declared(decls: core::option::Option<SrcDecls>, prog: SrcProgram) -> core::option::Option<Binary> {
    return match (decls) {
        None -> None,
        Some(d) -> compile_lowered(lower_funcs(sigs(prog.funcs), d, prog.funcs)),
    };
}

// Machine code of a source program.
pub fn compile_source(prog: SrcProgram) -> core::option::Option<Binary> {
    if (funcs_return(prog.funcs)) {
        return compile_declared(declare_program(prog), prog);
    }
    return None;
}

// ---------------------------------------------------------------- the driver's output

// The words a driver writes for a program the front end read (or did not):
// the entry count, the entries, the image length and the image's bytes, one
// word each; none when the program is rejected (roadmap V1). `compile_words`
// is the entry.

pub fn usize_words(xs: List<usize>) -> List<i32> {
    return match (xs) {
        Nil -> empty(),
        Cons(x, rest) -> cons(x as i32, usize_words(unbox(rest))),
    };
}

pub fn byte_words(xs: List<u8>) -> List<i32> {
    return match (xs) {
        Nil -> empty(),
        Cons(x, rest) -> cons(x as i32, byte_words(unbox(rest))),
    };
}

pub fn binary_words(binary: core::option::Option<Binary>) -> core::option::Option<List<i32>> {
    return match (binary) {
        None -> None,
        Some(b) -> Some(concat(cons(length(b.entries) as i32, usize_words(b.entries)), cons(length(b.image) as i32, byte_words(b.image)))),
    };
}

pub fn compile_words(program: core::option::Option<SrcProgram>) -> core::option::Option<List<i32>> {
    return match (program) {
        None -> None,
        Some(prog) -> binary_words(compile_source(prog)),
    };
}

// ---------------------------------------------------------------- the process

// The ELF file for a binary (roadmap V6): one loadable segment at 2^32,
// readable, writable and executable, from the file's first byte. The file is
// the ELF header, its one program header, the startup code and the image;
// the segment goes on, zero-filled by Linux, to a page boundary, then `stack`
// bytes of stack and `heap` bytes of heap. The startup code sets rsp to the
// stack's top, r15 to the stack limit (`binary.guard` above its bottom),
// r12, r14 and r13 to the heap's base, its limit and cursor 1, calls function
// `entry`, and exits with its rax: mov rdi, rax; mov eax, 60; syscall. None
// when the sizes do not fit (`elf_fits`).

pub fn elf_base() -> usize {
    return 4294967296;
}

// The bytes before the image: the headers (120) and the startup code (65).
pub fn elf_before_image() -> usize {
    return 185;
}

pub fn larger(a: usize, b: usize) -> usize {
    if (a > b) {
        return a;
    }
    return b;
}

// `frameNeed`: stack bytes one activation uses, the most over the codes.
pub fn frame_need_of(codes: List<Code>) -> usize {
    return match (codes) {
        Nil -> 0,
        Cons(c, rest) -> larger(plus(frame_size(c.slots), 16), frame_need_of(unbox(rest))),
    };
}

// `Binary.guard`
pub fn stack_guard(binary: Binary) -> usize {
    return plus(frame_need_of(binary.codes), 8);
}

// `n` rounded up to a multiple of 4096.
pub fn page_up(n: usize) -> usize {
    return times(plus(n, 4095) / 4096, 4096);
}

pub fn le16(value: usize) -> List<u8> {
    let bits: u64 = value as u64;
    return cons(bits as u8, single((bits >> 8) as u8));
}

pub fn le64n(value: usize) -> List<u8> {
    return le64(value as u64);
}

// Where the stack starts: the first page boundary after the file.
pub fn elf_stack_base(binary: Binary) -> usize {
    return plus(elf_base(), page_up(plus(elf_before_image(), length(binary.image))));
}

// The ELF header: 64-bit, little-endian, an x86-64 executable entered at
// the startup code, with its one program header right after it.
pub fn elf_header(binary: Binary) -> List<u8> {
    let ident: List<u8> = cons(127, cons(69, cons(76, cons(70, cons(2, cons(1, cons(1, cons(0, cons(0, cons(0, cons(0, cons(0, cons(0, cons(0, cons(0, single(0))))))))))))))));
    let kinds: List<u8> = concat(concat(le16(2), le16(62)), le32(1));
    let places: List<u8> = concat(concat(le64n(plus(elf_base(), 120)), le64n(64)), le64n(0));
    let sizes: List<u8> = concat(concat(concat(concat(concat(le32(0), le16(64)), le16(56)), le16(1)), le16(64)), concat(le16(0), le16(0)));
    return concat(concat(concat(ident, kinds), places), sizes);
}

// The program header: a loadable segment, readable, writable and
// executable, from file offset 0 to the segment's start, the file's bytes
// and then zeros up to the end of the heap.
pub fn elf_program_header(binary: Binary, stack: usize, heap: usize) -> List<u8> {
    let file: usize = plus(elf_before_image(), length(binary.image));
    let memory: usize = plus(plus(minus(elf_stack_base(binary), elf_base()), stack), heap);
    let kinds: List<u8> = concat(concat(le32(1), le32(7)), le64n(0));
    let places: List<u8> = concat(le64n(elf_base()), le64n(elf_base()));
    return concat(concat(concat(kinds, places), concat(le64n(file), le64n(memory))), le64n(4096));
}

// mov reg, imm64 for rsp, r15, r12, r14 and r13; call the entry; exit.
pub fn elf_startup(binary: Binary, entry: usize, stack: usize, heap: usize) -> List<u8> {
    let bottom: usize = elf_stack_base(binary);
    let top: usize = plus(bottom, stack);
    let sets: List<u8> = concat(concat(concat(cons(72, cons(188, le64n(top))), cons(73, cons(191, le64n(plus(bottom, stack_guard(binary)))))), concat(cons(73, cons(188, le64n(top))), cons(73, cons(190, le64n(heap))))), cons(73, cons(189, le64n(1))));
    let call: List<u8> = cons(232, le32(plus(get_or(binary.entries, entry, 0), 10) as i32));
    let exit: List<u8> = cons(72, cons(137, cons(199, cons(184, cons(60, cons(0, cons(0, cons(0, cons(15, single(5))))))))));
    return concat(concat(sets, call), exit);
}

// The sizes the startup code and the proofs need: the image and the entry's
// offset below 2^30, the stack at least the guard, the stack below 2^40, and
// the heap at least one byte and below 2^40.
pub fn elf_fits(binary: Binary, entry: usize, stack: usize, heap: usize) -> bool {
    return length(binary.image) < 1073741824 && get_or(binary.entries, entry, 0) < 1073741824 && stack_guard(binary) <= stack && stack < 1099511627776 && 1 <= heap && heap < 1099511627776;
}

pub fn elf_file(binary: Binary, entry: usize, stack: usize, heap: usize) -> core::option::Option<List<u8>> {
    if (elf_fits(binary, entry, stack, heap)) {
        return Some(concat(concat(concat(elf_header(binary), elf_program_header(binary, stack, heap)), elf_startup(binary, entry, stack, heap)), binary.image));
    }
    return None;
}
