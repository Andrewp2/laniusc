// `lexTokens`: the tokens of a file's bytes, if it lexes.
pub fn lex_source(source: List<usize>) -> core::option::Option<List<Token>> {
    return match (lx_raw(lx_symbol_rules(), source, plus(length(source), 1), 0)) {
        None -> None,
        Some(raw) -> Some(lx_tokens(source, source, 0, lx_ranges(lx_filter(lx_keyword_rules(), source, source, 0, raw)))),
    };
}

// ---------------------------------------------------------------- the driver's input

// The front end's input as a driver reads it, one 32-bit word each: the file
// count, then each file's bytes (their count, then each, below 256), its
// productions (their count, then each) and its parents (their count, then
// each; a root's parent is 2^32 - 1). Words are read as unsigned (roadmap
// V1). `front_end_words` is the entry; it lexes each file with `lex_source`.

pub struct NumsRead {
    nums: List<usize>,
    rest: List<i32>,
}

pub struct FileRead {
    file: FileInput,
    rest: List<i32>,
}

pub struct FilesRead {
    files: List<FileInput>,
    rest: List<i32>,
}

pub fn word_num(w: i32) -> usize {
    return (w as u32) as usize;
}

pub fn nums_after(n: usize, read: core::option::Option<NumsRead>) -> core::option::Option<NumsRead> {
    return match (read) {
        None -> None,
        Some(r) -> Some(NumsRead { nums: cons(n, r.nums), rest: r.rest }),
    };
}

// `count` numbers, then the words after them.
pub fn read_nums(words: List<i32>, count: usize) -> core::option::Option<NumsRead> {
    if (count == 0) {
        return Some(NumsRead { nums: empty(), rest: words });
    }
    return match (words) {
        Nil -> None,
        Cons(w, rest) -> nums_after(word_num(w), read_nums(unbox(rest), minus(count, 1))),
    };
}

// A count, then that many numbers.
pub fn read_counted_nums(words: List<i32>) -> core::option::Option<NumsRead> {
    return match (words) {
        Nil -> None,
        Cons(w, rest) -> read_nums(unbox(rest), word_num(w)),
    };
}

pub fn byte_after(b: usize, read: core::option::Option<NumsRead>) -> core::option::Option<NumsRead> {
    if (b > 255) {
        return None;
    }
    return nums_after(b, read);
}

// `count` byte values, then the words after them.
pub fn read_bytes(words: List<i32>, count: usize) -> core::option::Option<NumsRead> {
    if (count == 0) {
        return Some(NumsRead { nums: empty(), rest: words });
    }
    return match (words) {
        Nil -> None,
        Cons(w, rest) -> byte_after(word_num(w), read_bytes(unbox(rest), minus(count, 1))),
    };
}

// A count, then that many byte values.
pub fn read_counted_bytes(words: List<i32>) -> core::option::Option<NumsRead> {
    return match (words) {
        Nil -> None,
        Cons(w, rest) -> read_bytes(unbox(rest), word_num(w)),
    };
}

pub fn file_lexed(tokens: core::option::Option<List<Token>>, prods: List<usize>, parents: NumsRead) -> core::option::Option<FileRead> {
    return match (tokens) {
        None -> None,
        Some(t) -> Some(FileRead { file: FileInput { tokens: t, prods: prods, parents: parents.nums }, rest: parents.rest }),
    };
}

pub fn read_file_end(source: List<usize>, prods: List<usize>, parents: core::option::Option<NumsRead>) -> core::option::Option<FileRead> {
    return match (parents) {
        None -> None,
        Some(q) -> file_lexed(lex_source(source), prods, q),
    };
}

pub fn read_file_parents(source: List<usize>, prods: core::option::Option<NumsRead>) -> core::option::Option<FileRead> {
    return match (prods) {
        None -> None,
        Some(p) -> read_file_end(source, p.nums, read_counted_nums(p.rest)),
    };
}

// A file: its counted bytes, productions and parents; its tokens are
// `lex_source` of the bytes.
pub fn read_file(words: List<i32>) -> core::option::Option<FileRead> {
    return match (read_counted_bytes(words)) {
        None -> None,
        Some(b) -> read_file_parents(b.nums, read_counted_nums(b.rest)),
    };
}

pub fn files_after(file: FileInput, read: core::option::Option<FilesRead>) -> core::option::Option<FilesRead> {
    return match (read) {
        None -> None,
        Some(r) -> Some(FilesRead { files: cons(file, r.files), rest: r.rest }),
    };
}

pub fn read_files(words: List<i32>, count: usize) -> core::option::Option<FilesRead> {
    if (count == 0) {
        return Some(FilesRead { files: empty(), rest: words });
    }
    return match (read_file(words)) {
        None -> None,
        Some(f) -> files_after(f.file, read_files(f.rest, minus(count, 1))),
    };
}

pub fn read_counted_files(words: List<i32>) -> core::option::Option<FilesRead> {
    return match (words) {
        Nil -> None,
        Cons(w, rest) -> read_files(unbox(rest), word_num(w)),
    };
}

// The program, when the words are exactly a counted list of files.
pub fn front_end_read(g: List<Rule>, read: FilesRead) -> core::option::Option<SrcProgram> {
    return match (read.rest) {
        Nil -> front_end_files(g, read.files),
        Cons(w, rest) -> None,
    };
}

pub fn front_end_words(g: List<Rule>, words: List<i32>) -> core::option::Option<SrcProgram> {
    return match (read_counted_files(words)) {
        None -> None,
        Some(read) -> front_end_read(g, read),
    };
}

