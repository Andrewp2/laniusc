// Productions 60 to 79:
// 60 params_none, 61 params_some, 62 param_named, 63 param_self,
// 64 param_self_ref, 65 self_param_typed, 66 self_param_plain, 67 params_more,
// 68 params_end, 69 type_ident, 70 type_array, 71 block, 72 if_block,
