// The verified compiler's front end, by translation validation (roadmap step
// 8). formal/tools/extract.py turns everything after the prelude, except the
// external section, into formal/Lanius/Mini/Frontend.lean.
//
// laniusc's GPU parser produces a parse tree: the productions it applied, in
// preorder (its node_kind array), and each node's parent. This file does not
// parse. It checks that tree against the grammar and against the lexer's
// tokens: `attach` follows the productions, matching each terminal on a
// production's right side with the next token, and builds the concrete tree
// whose leaves are the tokens. A tree that `attach` accepts is a derivation of
// exactly the token sequence (formal/Lanius/Mini/FrontSpec.lean proves it).
// `build` then reads the source program off the concrete tree, for the subset
// of Lanius the front pass compiles, and rejects anything else.
//
// Names. The input is one or more files, each a module named by its `module`
// item (the empty path without one); the first file is the program's own. A
// path `m::x` names x of module m, a bare `x` names x of the current module.
// Generic structs, enums, functions and impl methods are monomorphized: an
// instance is a declaration with its type arguments (written, or inferred by
// matching parameter and result types). The first file's functions without
// type parameters keep their positions as function ids; every other function
// instance is numbered when first called. Type ids are positions in the type
// table: the first file's non-generic types in order, then each instance as
// the functions' types first need it. Constants are replaced by their
// literal values. A local (parameter, let, match binder) is the byte offset
// of its binding occurrence from its function's name (so an edit to one
// function renumbers no other), and a use names the innermost binding of the
// same spelling. A local cannot be spelled like a function, a type, a variant
// or a constant of its module, so every use has one reading.
module mini::frontend;
import alloc::allocator;
import core::mem;
import core::option;
import core::panic;

// extract: prelude begin
// Each prelude item has a fixed Lean meaning (see PRELUDE in extract.py).
// They are the only code that touches memory.

// Box<T> is T.
pub struct Box<T> { storage: ptr }

pub fn boxed<T>(value: T) -> Box<T> {
    let size: usize = core::mem::size_of<T>();
    let storage: ptr = alloc::allocator::alloc(size, 8);
    if (storage == 0) {
        core::panic::panic();
    }
    let slot: [T] = core::mem::typed_slice_from_storage(storage, 1);
    slot[0] = value;
    return Box { storage: storage };
}

pub fn unbox<T>(value: Box<T>) -> T {
    let slot: [T] = core::mem::typed_slice_from_storage(value.storage, 1);
    return slot[0];
}

// List<T> is List T: Nil is [] and Cons(x, rest) is x :: rest.
pub enum List<T> { Nil, Cons(T, Box<List<T>>), }

// Nat a + b
pub fn plus(a: usize, b: usize) -> usize {
    let sum: usize = a + b;
    if (a > sum) {
        core::panic::panic();
    }
    return sum;
}

// Nat a * b
pub fn times(a: usize, b: usize) -> usize {
    if (a == 0) {
        return 0;
    }
    let product: usize = a * b;
    if (product / a != b) {
        core::panic::panic();
    }
    return product;
}

// Nat a - b, used only where a >= b
pub fn minus(a: usize, b: usize) -> usize {
    if (b > a) {
        core::panic::panic();
    }
    return a - b;
}

// max a b
pub fn max_of(a: usize, b: usize) -> usize {
    if (b > a) {
        return b;
    }
    return a;
}
// extract: prelude end

// extract: external begin Lanius.Mini.Compiler from formal/lani/mini/compiler.lani
// The list operations and the source program types of compiler.lani, which
// extract.py checks are the same there.

pub fn empty<T>() -> List<T> {
    return Nil;
}

pub fn single<T>(item: T) -> List<T> {
    return Cons(item, boxed(Nil));
}

pub fn cons<T>(item: T, rest: List<T>) -> List<T> {
    return Cons(item, boxed(rest));
}

pub fn concat<T>(first: List<T>, second: List<T>) -> List<T> {
    return match (first) {
        Nil -> second,
        Cons(item, rest) -> Cons(item, boxed(concat(unbox(rest), second))),
    };
}

pub fn length<T>(items: List<T>) -> usize {
    return match (items) {
        Nil -> 0,
        Cons(item, rest) -> plus(length(unbox(rest)), 1),
    };
}

pub fn get<T>(items: List<T>, index: usize) -> core::option::Option<T> {
    if (index == 0) {
        return match (items) {
            Nil -> None,
            Cons(item, rest) -> Some(item),
        };
    }
    return match (items) {
        Nil -> None,
        Cons(item, rest) -> get(unbox(rest), minus(index, 1)),
    };
}

pub fn get_or<T>(items: List<T>, index: usize, fallback: T) -> T {
    if (index == 0) {
        return match (items) {
            Nil -> fallback,
            Cons(item, rest) -> item,
        };
    }
    return match (items) {
        Nil -> fallback,
        Cons(item, rest) -> get_or(unbox(rest), minus(index, 1), fallback),
    };
}

pub enum UintTy { Uint8, Uint32, Uint64, Usize, Uint16, }

pub enum SrcType {
    I32,
    Bool,
    Uint(UintTy),
    Struct(usize, Box<List<SrcType>>),
    Enum(usize, Box<List<List<SrcType>>>),
    // a raw pointer into the heap
    Ptr,
    // Core's raw slice of this element type: one slot, its address
    Slice(Box<SrcType>),
    // the unit type: one slot whose bits do not matter
    Unit,
    // a signed 64-bit integer, its two's complement bits in one slot
    Isize,
    // a char, its 32-bit code in one slot
    Char,
    // the signed integer type as wide as kind (i8, i16, i32, i64, isize). A
    // narrow one sits in its slot as an i32 does, its value's 32-bit two's
    // complement zero-extended; a 64-bit one as an isize does.
    Sint(UintTy),
}

pub enum SrcOp {
    Plus, Minus, Times, BitAnd, BitOr, BitXor, ShiftLeft, ShiftRight,
    Less, LessEq, Greater, GreaterEq, Equal, NotEqual,
    LogicalAnd, LogicalOr,
}

pub enum SrcExpr {
    Int(i32),
    Boolean(bool),
    // a literal of an unsigned type
    Unsigned(UintTy, u64),
    Local(usize),
    // field of a struct local
    Field(usize, usize),
    Negate(Box<SrcExpr>),
    Not(Box<SrcExpr>),
    Apply(SrcOp, Box<SrcExpr>, Box<SrcExpr>),
    // between i32 and the unsigned types, wrapping like Core
    Cast(SrcType, Box<SrcExpr>),
    // the null pointer, Core's pointer 0
    Null,
    // a char literal: its code, a Unicode scalar value
    Char(u32),
}

pub struct SrcArm {
    binders: List<usize>,
    value: SrcExpr,
}

pub enum SrcDivOp { Quotient, Remainder, }

pub enum SrcEff {
    EPure(SrcExpr),
    ECall(usize, Box<List<SrcEff>>),
    EApply(SrcOp, Box<SrcEff>, Box<SrcEff>),
    ENeg(Box<SrcEff>),
    ENot(Box<SrcEff>),
    ECast(SrcType, Box<SrcEff>),
    EIndex(usize, Box<SrcEff>),
    EStruct(SrcType, Box<List<SrcEff>>),
    EVariant(SrcType, usize, Box<List<SrcEff>>),
    EMatch(Box<SrcEff>, SrcType, SrcType, List<List<usize>>, Box<List<SrcEff>>),
    EDivide(SrcDivOp, Box<SrcEff>, Box<SrcEff>),
    EStride(usize),
}

pub enum SrcStmt {
    Nop,
    Let(usize, SrcType, SrcExpr, Box<SrcStmt>),
    LetStruct(usize, SrcType, List<SrcExpr>, Box<SrcStmt>),
    LetCall(usize, SrcType, usize, List<SrcExpr>, Box<SrcStmt>),
    LetEnum(usize, SrcType, usize, List<SrcExpr>, Box<SrcStmt>),
    LetMatch(usize, SrcType, usize, usize, List<SrcArm>, Box<SrcStmt>),
    Set(usize, SrcExpr),
    SetField(usize, usize, SrcExpr),
    SetCall(usize, usize, List<SrcExpr>),
    Then(Box<SrcStmt>, Box<SrcStmt>),
    If(SrcExpr, Box<SrcStmt>, Box<SrcStmt>),
    While(SrcExpr, Box<SrcStmt>),
    Return(SrcExpr),
    LetAlloc(usize, SrcExpr, usize, Box<SrcStmt>),
    LetLoad(usize, SrcExpr, SrcExpr, Box<SrcStmt>),
    SetByte(SrcExpr, SrcExpr, SrcExpr),
    Free(SrcExpr, SrcExpr, usize),
    LetSlice(usize, SrcType, SrcExpr, SrcExpr, Box<SrcStmt>),
    LetIndex(usize, SrcType, usize, SrcExpr, Box<SrcStmt>),
    SetIndex(usize, SrcExpr, SrcExpr),
    LetEval(usize, SrcType, SrcEff, Box<SrcStmt>),
    SetEval(usize, SrcEff),
    IfEval(SrcEff, Box<SrcStmt>, Box<SrcStmt>),
    WhileEval(SrcEff, Box<SrcStmt>),
    ReturnEval(SrcEff),
    Discard(SrcEff),
    SetIndexEval(usize, SrcEff, SrcEff),
    SetFieldEval(usize, usize, SrcEff),
    ReturnUnit,
    Assert(SrcEff),
    Break,
    Continue,
    MatchArm(usize, usize, usize, bool, usize, SrcType, Box<SrcStmt>, Box<SrcStmt>),
}

pub struct SrcParam {
    id: usize,
    ty: SrcType,
}

pub struct SrcFunc {
    params: List<SrcParam>,
    ret: SrcType,
    body: SrcStmt,
}

pub struct SrcProgram {
    funcs: List<SrcFunc>,
}
// extract: external end

// ---------------------------------------------------------------- tokens and trees

// A lexer token: its kind (laniusc's TokenKind code), the byte offset where it
// starts, and its bytes.
pub struct Token {
    kind: usize,
    start: usize,
    text: List<usize>,
}

// A grammar symbol: a terminal, written as the token kind it matches, or a
// nonterminal.
pub enum Sym {
    Term(usize),
    Nonterm(usize),
}

// A production: lhs -> rhs.
pub struct Rule {
    lhs: usize,
    rhs: List<Sym>,
}

// A concrete parse tree: a token, or a node with its production and one child
// per symbol on the production's right side.
pub enum CTree {
    Leaf(Token),
    Node(usize, Box<List<CTree>>),
}

// What is left of the parse tree's preorder production ids, the matching
// parent indices, and the tokens; index is the preorder index of the next node.
pub struct Cursor {
    prods: List<usize>,
    parents: List<usize>,
    tokens: List<Token>,
    index: usize,
}

// The children attached for a right side, and what is left after them.
pub struct Attached {
    kids: List<CTree>,
    rest: Cursor,
}

// ---------------------------------------------------------------- reading the tree

pub fn no_token() -> Token {
    return Token { kind: 0, start: 0, text: empty() };
}

pub fn kids_of(c: CTree) -> List<CTree> {
    return match (c) {
        Leaf(t) -> empty(),
        Node(p, kids) -> unbox(kids),
    };
}

// Child i (a dummy leaf if there is none).
pub fn kid(c: CTree, i: usize) -> CTree {
    return get_or(kids_of(c), i, Leaf(no_token()));
}

pub fn with_kid(kid: CTree, rest: core::option::Option<Attached>) -> core::option::Option<Attached> {
    return match (rest) {
        None -> None,
        Some(a) -> Some(Attached { kids: cons(kid, a.kids), rest: a.rest }),
    };
}

// ---------------------------------------------------------------- the one reading

// The grammar is ambiguous where `x < y` in an expression could also open the
// type arguments of a generic path `x<y>`: `a < b > (c)` is a comparison chain
// and a generic call. laniusc reads `x<` as type arguments when the matching
// `>` (angles counted outside brackets, a `>>` closing two) comes before any
// bracket closes or `;`, no `||`, `==`, `!=`, `<=` or `>=` comes before it,
// and `(`, `::` or `{` follows it. generic_path_at says that of the tokens
// from the identifier on; the validator accepts a path segment only if they
// agree, and formal/Lanius/Mini/Unique.lean proves that then at most one tree
// reads a file's tokens.
pub fn starts_with_kind(tokens: List<Token>, kind: usize) -> bool {
    return match (tokens) {
        Nil -> false,
        Cons(t, rest) -> t.kind == kind,
    };
}

pub fn generic_tail(tokens: List<Token>) -> bool {
    return match (tokens) {
        Nil -> false,
        Cons(t, rest) -> t.kind == t_lparen() || t.kind == t_lbrace() || (t.kind == t_colon() && starts_with_kind(unbox(rest), t_colon())),
    };
}

// The tokens after a `<`, with angles type argument lists open and nest
// brackets open inside the innermost.
pub fn generic_close(tokens: List<Token>, angles: usize, nest: usize) -> bool {
    return match (tokens) {
        Nil -> false,
        Cons(t, rest) -> generic_close_at(t.kind, unbox(rest), angles, nest),
    };
}

// extract: inline
fn generic_close_at(gk: usize, grest: List<Token>, gangles: usize, gnest: usize) -> bool {
    if (gk == t_oror() || gk == t_eqeq() || gk == t_not_equal() || gk == t_le() || gk == t_ge()) {
        return false;
    }
    if (gk == t_lparen() || gk == t_lbracket() || gk == t_lbrace()) {
        return generic_close(grest, gangles, plus(gnest, 1));
    }
    if (gk == t_rparen() || gk == t_rbracket() || gk == t_rbrace()) {
        if (gnest == 0) {
            return false;
        }
        return generic_close(grest, gangles, minus(gnest, 1));
    }
    if (gnest != 0) {
        return generic_close(grest, gangles, gnest);
    }
    if (gk == t_semicolon()) {
        return false;
    }
    if (gk == t_lt()) {
        return generic_close(grest, plus(gangles, 1), 0);
    }
    if (gk == t_gt()) {
        if (gangles < 2) {
            return generic_tail(grest);
        }
        return generic_close(grest, minus(gangles, 1), 0);
    }
    if (gk == t_shr()) {
        if (gangles == 2) {
            return generic_tail(grest);
        }
        if (gangles < 2) {
            return false;
        }
        return generic_close(grest, minus(gangles, 2), 0);
    }
    return generic_close(grest, gangles, 0);
}

pub fn generic_open(tokens: List<Token>) -> bool {
    return match (tokens) {
        Nil -> false,
        Cons(t, rest) -> t.kind == t_lt() && generic_close(unbox(rest), 1, 0),
    };
}

pub fn generic_path_at(tokens: List<Token>) -> bool {
    return match (tokens) {
        Nil -> false,
        Cons(t, rest) -> generic_open(unbox(rest)),
    };
}

// Whether the tokens begin with `{`.
pub fn opens_block(tokens: List<Token>) -> bool {
    return match (tokens) {
        Nil -> false,
        Cons(t, rest) -> t.kind == t_lbrace(),
    };
}

// Whether the validator accepts production prod for a node whose tokens
// begin with `tokens`: not a method's type arguments (the subset has none,
// and they make the grammar ambiguous, as in `x.f < a > (b)`); a statement
// that begins with `{` is a block statement, never an expression statement
// (as in Rust: `{ a } - b;` is a block, then `-b;`); and a path segment `x`
// or `x<...>` only as generic_path_at says.
pub fn picks(prod: usize, tokens: List<Token>) -> bool {
    if (prod == p_member_type_args_some()) {
        return false;
    }
    if (prod == p_block_stmt()) {
        return opens_block(tokens);
    }
    if (prod == p_expr_stmt()) {
        return !opens_block(tokens);
    }
    if (prod == p_path_ident()) {
        return !generic_path_at(tokens);
    }
    if (prod == p_path_ident_args()) {
        return generic_path_at(tokens);
    }
    return true;
}

// laniusc's parser reads a `>>` that closes two type argument lists (as in
// `Vec<Option<T>>`) as two `>`, so a terminal `>` may take the first half of a
// `>>` token, and the second half is then the next token.
pub fn shr_first(t: Token) -> Token {
    return Token { kind: t_gt(), start: t.start, text: single(62) };
}

pub fn shr_second(t: Token) -> Token {
    return Token { kind: t_gt(), start: plus(t.start, 1), text: single(62) };
}

// extract: inline
fn attach_term(tg: List<Rule>, tfuel: usize, tkind: usize, tmore: List<Sym>, tparent: usize, tcur: Cursor) -> core::option::Option<Attached> {
    return match (tcur.tokens) {
        Nil -> None,
        Cons(tok, toks) -> attach_leaf(tg, tfuel, tkind, tok, unbox(toks), tmore, tparent, tcur),
    };
}

// extract: inline
fn attach_after(dg: List<Rule>, dfuel: usize, dp: usize, inner: core::option::Option<Attached>, dmore: List<Sym>, dparent: usize) -> core::option::Option<Attached> {
    return match (inner) {
        None -> None,
        Some(a) -> with_kid(Node(dp, boxed(a.kids)), attach(dg, dfuel, dmore, dparent, a.rest)),
    };
}

// extract: inline
fn attach_node(cg: List<Rule>, cfuel: usize, cnt: usize, cp: usize, cprod: Rule, cps: List<usize>, cqs: List<usize>, cmore: List<Sym>, cparent: usize, ccur: Cursor) -> core::option::Option<Attached> {
    if (cprod.lhs != cnt) {
        return None;
    }
    return attach_after(cg, cfuel, cp, attach(cg, cfuel, cprod.rhs, ccur.index, Cursor { prods: cps, parents: cqs, tokens: ccur.tokens, index: plus(ccur.index, 1) }), cmore, cparent);
}

// extract: inline
fn attach_prod(bg: List<Rule>, bfuel: usize, bnt: usize, bp: usize, bps: List<usize>, bq: usize, bqs: List<usize>, bmore: List<Sym>, bparent: usize, bcur: Cursor) -> core::option::Option<Attached> {
    if (bq != bparent || !picks(bp, bcur.tokens)) {
        return None;
    }
    return match (get(bg, bp)) {
        None -> None,
        Some(prod) -> attach_node(bg, bfuel, bnt, bp, prod, bps, bqs, bmore, bparent, bcur),
    };
}

// extract: inline
fn attach_parent(ag: List<Rule>, afuel: usize, ant: usize, ap: usize, aps: List<usize>, amore: List<Sym>, aparent: usize, acur: Cursor) -> core::option::Option<Attached> {
    return match (acur.parents) {
        Nil -> None,
        Cons(q, qs) -> attach_prod(ag, afuel, ant, ap, aps, q, unbox(qs), amore, aparent, acur),
    };
}

// extract: inline
fn attach_nonterm(ng: List<Rule>, nfuel: usize, nt: usize, nmore: List<Sym>, nparent: usize, ncur: Cursor) -> core::option::Option<Attached> {
    return match (ncur.prods) {
        Nil -> None,
        Cons(p, ps) -> attach_parent(ng, nfuel, nt, p, unbox(ps), nmore, nparent, ncur),
    };
}

// extract: inline
fn attach_sym(sg: List<Rule>, sfuel: usize, sym: Sym, smore: List<Sym>, sparent: usize, scur: Cursor) -> core::option::Option<Attached> {
    return match (sym) {
        Term(kind) -> attach_term(sg, sfuel, kind, smore, sparent, scur),
        Nonterm(nt) -> attach_nonterm(sg, sfuel, nt, smore, sparent, scur),
    };
}

// ---------------------------------------------------------------- the validator

// Attach the trees for the symbols rhs, children of the node with preorder
// index parent: a terminal takes the next token, which must have its kind; a
// nonterminal takes the next production, which must have it as its left side,
// parent as its recorded parent and `picks` allowing it at the tokens left,
// and then that production's own symbols.
pub fn attach(g: List<Rule>, fuel: usize, rhs: List<Sym>, parent: usize, cur: Cursor) -> core::option::Option<Attached> {
    if (fuel == 0) {
        return None;
    }
    return match (rhs) {
        Nil -> Some(Attached { kids: empty(), rest: cur }),
        Cons(sym, more) -> attach_sym(g, minus(fuel, 1), sym, unbox(more), parent, cur),
    };
}

// extract: inline
fn attach_leaf(lg: List<Rule>, lfuel: usize, lkind: usize, ltok: Token, ltoks: List<Token>, lmore: List<Sym>, lparent: usize, lcur: Cursor) -> core::option::Option<Attached> {
    if (ltok.kind == lkind) {
        return with_kid(Leaf(ltok), attach(lg, lfuel, lmore, lparent, Cursor { prods: lcur.prods, parents: lcur.parents, tokens: ltoks, index: lcur.index }));
    }
    if (ltok.kind == t_shr() && lkind == t_gt()) {
        return with_kid(Leaf(shr_first(ltok)), attach(lg, lfuel, lmore, lparent, Cursor { prods: lcur.prods, parents: lcur.parents, tokens: cons(shr_second(ltok), ltoks), index: lcur.index }));
    }
    return None;
}

pub fn only(root: CTree, more: List<CTree>) -> core::option::Option<CTree> {
    return match (more) {
        Nil -> Some(root),
        Cons(other, rest) -> None,
    };
}

pub fn is_empty_usize(items: List<usize>) -> bool {
    return match (items) {
        Nil -> true,
        Cons(item, rest) -> false,
    };
}

pub fn no_tokens(items: List<Token>) -> bool {
    return match (items) {
        Nil -> true,
        Cons(item, rest) -> false,
    };
}

pub fn used_up(cur: Cursor) -> bool {
    return is_empty_usize(cur.prods) && is_empty_usize(cur.parents) && no_tokens(cur.tokens);
}

pub fn whole(a: Attached) -> core::option::Option<CTree> {
    if (used_up(a.rest)) {
        return match (a.kids) {
            Nil -> None,
            Cons(root, more) -> only(root, unbox(more)),
        };
    }
    return None;
}

// The concrete tree of a whole parse: the root derives nonterminal 0 (file)
// and has no parent, and every production, parent and token is used.
pub fn validate_tree(g: List<Rule>, tokens: List<Token>, prods: List<usize>, parents: List<usize>) -> core::option::Option<CTree> {
    let fuel: usize = plus(times(2, plus(length(prods), length(tokens))), 2);
    return match (attach(g, fuel, single(Nonterm(0)), 4294967295, Cursor { prods: prods, parents: parents, tokens: tokens, index: 0 })) {
        None -> None,
        Some(a) -> whole(a),
    };
}

// The production of a node (none of a leaf).
pub fn node_prod(c: CTree) -> usize {
    return match (c) {
        Leaf(t) -> 4294967295,
        Node(p, kids) -> p,
    };
}

pub fn has_kids(c: CTree) -> bool {
    return match (kids_of(c)) {
        Nil -> false,
        Cons(k, rest) -> true,
    };
}

// The productions that only chain the items of a list: item lists, statement
// lists, parameters, arguments, fields, variants, payloads, arms, patterns,
// type parameters, type arguments and impl methods.
pub fn is_link(p: usize) -> bool {
    return p == p_items_more() || p == p_items_end() || p == p_stmts_more() || p == p_stmts_end()
        || p == p_params_none() || p == p_params_some() || p == p_params_more() || p == p_params_end()
        || p == p_params_after_comma_more() || p == p_params_after_comma_trailing()
        || p == p_args_none() || p == p_args_some() || p == p_args_more() || p == p_args_end()
        || p == p_args_after_comma_more() || p == p_args_after_comma_trailing()
        || p == p_struct_fields_none() || p == p_struct_fields_some() || p == p_struct_fields_more() || p == p_struct_fields_end()
        || p == p_struct_fields_after_comma_more() || p == p_struct_fields_after_comma_trailing()
        || p == p_struct_lit_fields_none() || p == p_struct_lit_fields_some() || p == p_struct_lit_fields_more() || p == p_struct_lit_fields_end()
        || p == p_struct_lit_fields_after_comma_more() || p == p_struct_lit_fields_after_comma_trailing()
        || p == p_enum_variants_none() || p == p_enum_variants_some() || p == p_enum_variants_more() || p == p_enum_variants_end()
        || p == p_enum_variants_after_comma_more() || p == p_enum_variants_after_comma_trailing()
        || p == p_enum_variant_fields_none() || p == p_enum_variant_fields_some() || p == p_enum_variant_fields_more() || p == p_enum_variant_fields_end()
        || p == p_enum_variant_fields_after_comma_more() || p == p_enum_variant_fields_after_comma_trailing()
        || p == p_match_arms_none() || p == p_match_arms_some() || p == p_match_arms_more() || p == p_match_arms_end()
        || p == p_match_arms_after_comma_more() || p == p_match_arms_after_comma_trailing()
        || p == p_patterns_none() || p == p_patterns_some() || p == p_patterns_more() || p == p_patterns_end()
        || p == p_patterns_after_comma_more() || p == p_patterns_after_comma_trailing()
        || p == p_enum_type_params_some() || p == p_enum_type_params_more() || p == p_enum_type_params_after_comma_more()
        || p == p_type_args_some() || p == p_type_args_more() || p == p_type_args_after_comma_more()
        || p == p_path_type_args_more() || p == p_path_type_args_after_comma_more()
        || p == p_impl_methods_some() || p == p_impl_methods_more();
}

pub fn join_second(a: List<CTree>, second: core::option::Option<List<CTree>>) -> core::option::Option<List<CTree>> {
    return match (second) {
        None -> None,
        Some(b) -> Some(concat(a, b)),
    };
}

pub fn join_items(first: core::option::Option<List<CTree>>, second: core::option::Option<List<CTree>>) -> core::option::Option<List<CTree>> {
    return match (first) {
        None -> None,
        Some(a) -> join_second(a, second),
    };
}

// extract: mutual begin
// The items of a list: the children that are not separators or links, in order.
pub fn list_items(fuel: usize, c: CTree) -> core::option::Option<List<CTree>> {
    if (fuel == 0) {
        return None;
    }
    return items_in(minus(fuel, 1), kids_of(c));
}

pub fn items_in(fuel: usize, kids: List<CTree>) -> core::option::Option<List<CTree>> {
    if (fuel == 0) {
        return None;
    }
    return match (kids) {
        Nil -> Some(empty()),
        Cons(k, rest) -> items_cons(minus(fuel, 1), k, unbox(rest)),
    };
}

pub fn items_cons(fuel: usize, k: CTree, rest: List<CTree>) -> core::option::Option<List<CTree>> {
    if (fuel == 0) {
        return None;
    }
    if (is_link(node_prod(k))) {
        return join_items(list_items(minus(fuel, 1), k), items_in(minus(fuel, 1), rest));
    }
    if (has_kids(k)) {
        return join_items(Some(single(k)), items_in(minus(fuel, 1), rest));
    }
    return items_in(minus(fuel, 1), rest);
}
// extract: mutual end

// ---------------------------------------------------------------- names

pub fn leaf_token(c: CTree) -> Token {
    return match (c) {
        Leaf(t) -> t,
        Node(p, kids) -> no_token(),
    };
}

// The token of child i, a leaf.
pub fn kid_token(c: CTree, i: usize) -> Token {
    return leaf_token(kid(c, i));
}

pub fn same_text(a: List<usize>, b: List<usize>) -> bool {
    return match (a) {
        Nil -> match (b) {
            Nil -> true,
            Cons(y, more) -> false,
        },
        Cons(x, rest) -> match (b) {
            Nil -> false,
            Cons(y, more) -> (x == y) && same_text(unbox(rest), unbox(more)),
        },
    };
}

pub fn spelled(a: List<usize>, b: List<usize>) -> bool {
    return same_text(a, b);
}

pub fn text_self() -> List<usize> {
    let t: List<usize> = cons(115, cons(101, cons(108, single(102))));
    return t;
}

pub fn text_alloc() -> List<usize> {
    let t: List<usize> = cons(97, cons(108, cons(108, cons(111, single(99)))));
    return t;
}

pub fn text_allocator() -> List<usize> {
    let t: List<usize> = cons(97, cons(108, cons(108, cons(111, cons(99, cons(97, cons(116, cons(111, single(114)))))))));
    return t;
}

pub fn text_dealloc() -> List<usize> {
    let t: List<usize> = cons(100, cons(101, cons(97, cons(108, cons(108, cons(111, single(99)))))));
    return t;
}

// assert
pub fn text_assert() -> List<usize> {
    let t: List<usize> = cons(97, cons(115, cons(115, cons(101, cons(114, single(116))))));
    return t;
}

// slice_stride
pub fn text_slice_stride() -> List<usize> {
    let t: List<usize> = cons(115, cons(108, cons(105, cons(99, cons(101, cons(95, cons(115, cons(116, cons(114, cons(105, cons(100, single(101))))))))))));
    return t;
}

pub fn text_slice_from_raw_parts() -> List<usize> {
    let t: List<usize> = cons(115, cons(108, cons(105, cons(99, cons(101, cons(95, cons(102, cons(114, cons(111, cons(109, cons(95, cons(114, cons(97, cons(119, cons(95, cons(112, cons(97, cons(114, cons(116, single(115))))))))))))))))))));
    return t;
}

// The text is exactly the given characters (no list is built: the
// self-built compiler's heap is never freed).
pub fn spelled0(name: List<usize>) -> bool {
    return match (name) {
        Nil -> true,
        Cons(x, rest) -> false,
    };
}

pub fn spelled1(name: List<usize>, a: usize) -> bool {
    return match (name) {
        Nil -> false,
        Cons(x, rest) -> (x == a) && spelled0(unbox(rest)),
    };
}

pub fn spelled2(name: List<usize>, a: usize, b: usize) -> bool {
    return match (name) {
        Nil -> false,
        Cons(x, rest) -> (x == a) && spelled1(unbox(rest), b),
    };
}

pub fn spelled3(name: List<usize>, a: usize, b: usize, c: usize) -> bool {
    return match (name) {
        Nil -> false,
        Cons(x, rest) -> (x == a) && spelled2(unbox(rest), b, c),
    };
}

pub fn spelled4(name: List<usize>, a: usize, b: usize, c: usize, d: usize) -> bool {
    return match (name) {
        Nil -> false,
        Cons(x, rest) -> (x == a) && spelled3(unbox(rest), b, c, d),
    };
}

pub fn spelled5(name: List<usize>, a: usize, b: usize, c: usize, d: usize, e: usize) -> bool {
    return match (name) {
        Nil -> false,
        Cons(x, rest) -> (x == a) && spelled4(unbox(rest), b, c, d, e),
    };
}

// i32, bool, u8, u16, u32, u64, usize, ptr, isize, i8, i16, i64, char
pub fn primitive(name: List<usize>) -> core::option::Option<SrcType> {
    if (spelled3(name, 105, 51, 50)) {
        return Some(I32);
    }
    if (spelled4(name, 98, 111, 111, 108)) {
        return Some(Bool);
    }
    if (spelled2(name, 117, 56)) {
        return Some(Uint(Uint8));
    }
    if (spelled3(name, 117, 49, 54)) {
        return Some(Uint(Uint16));
    }
    if (spelled3(name, 117, 51, 50)) {
        return Some(Uint(Uint32));
    }
    if (spelled3(name, 117, 54, 52)) {
        return Some(Uint(Uint64));
    }
    if (spelled5(name, 117, 115, 105, 122, 101)) {
        return Some(Uint(Usize));
    }
    if (spelled3(name, 112, 116, 114)) {
        return Some(Ptr);
    }
    if (spelled5(name, 105, 115, 105, 122, 101)) {
        return Some(Isize);
    }
    if (spelled2(name, 105, 56)) {
        return Some(Sint(Uint8));
    }
    if (spelled3(name, 105, 49, 54)) {
        return Some(Sint(Uint16));
    }
    if (spelled3(name, 105, 54, 52)) {
        return Some(Sint(Uint64));
    }
    if (spelled4(name, 99, 104, 97, 114)) {
        return Some(SrcType::Char);
    }
    return None;
}

pub fn member(names: List<List<usize>>, name: List<usize>) -> bool {
    return match (names) {
        Nil -> false,
        Cons(n, rest) -> same_text(n, name) || member(unbox(rest), name),
    };
}

// No spelling occurs twice.
pub fn distinct(names: List<List<usize>>) -> bool {
    return match (names) {
        Nil -> true,
        Cons(n, rest) -> !member(unbox(rest), n) && distinct(unbox(rest)),
    };
}

// The position of name in names, counting from k.
pub fn position(names: List<List<usize>>, name: List<usize>, k: usize) -> core::option::Option<usize> {
    return match (names) {
        Nil -> None,
        Cons(n, rest) -> position_at(n, unbox(rest), name, k),
    };
}

// extract: inline
fn position_at(pn: List<usize>, prest: List<List<usize>>, pname: List<usize>, pk: usize) -> core::option::Option<usize> {
    if (same_text(pn, pname)) {
        return Some(pk);
    }
    return position(prest, pname, plus(pk, 1));
}

pub fn cons_name_tail(n: List<usize>, tail: core::option::Option<List<List<usize>>>) -> core::option::Option<List<List<usize>>> {
    return match (tail) {
        None -> None,
        Some(ns) -> Some(cons(n, ns)),
    };
}

pub fn cons_name(head: core::option::Option<List<usize>>, tail: core::option::Option<List<List<usize>>>) -> core::option::Option<List<List<usize>>> {
    return match (head) {
        None -> None,
        Some(n) -> cons_name_tail(n, tail),
    };
}

pub fn same_spellings(a: List<List<usize>>, b: List<List<usize>>) -> bool {
    return match (a) {
        Nil -> match (b) {
            Nil -> true,
            Cons(y, more) -> false,
        },
        Cons(x, rest) -> match (b) {
            Nil -> false,
            Cons(y, more) -> same_text(x, y) && same_spellings(unbox(rest), unbox(more)),
        },
    };
}

// A module path occurs in a list of module paths.
pub fn module_member(modules: List<List<List<usize>>>, m: List<List<usize>>) -> bool {
    return match (modules) {
        Nil -> false,
        Cons(x, rest) -> same_spellings(x, m) || module_member(unbox(rest), m),
    };
}

pub fn distinct_modules(modules: List<List<List<usize>>>) -> bool {
    return match (modules) {
        Nil -> true,
        Cons(m, rest) -> !module_member(unbox(rest), m) && distinct_modules(unbox(rest)),
    };
}

// The one spelling of a one-segment path.
pub fn single_name(segments: List<List<usize>>) -> core::option::Option<List<usize>> {
    return match (segments) {
        Nil -> None,
        Cons(n, rest) -> match (unbox(rest)) {
            Nil -> Some(n),
            Cons(m, more) -> None,
        },
    };
}

pub fn no_trees(items: List<CTree>) -> bool {
    return match (items) {
        Nil -> true,
        Cons(t, rest) -> false,
    };
}

// ---------------------------------------------------------------- paths

// The spellings of a path's segments, none with type arguments.
pub fn path_spellings(fuel: usize, segment: CTree, tail: CTree) -> core::option::Option<List<List<usize>>> {
    if (fuel == 0) {
        return None;
    }
    if (node_prod(segment) == p_path_ident() && node_prod(tail) == p_path_end()) {
        return Some(single(kid_token(segment, 0).text));
    }
    if (node_prod(segment) == p_path_ident() && node_prod(tail) == p_path_more()) {
        return cons_name(Some(kid_token(segment, 0).text), path_spellings(minus(fuel, 1), kid(tail, 2), kid(tail, 3)));
    }
    return None;
}

// The spelling of a path with one segment (path -> path_ident path_end).
pub fn path_name(path: CTree) -> core::option::Option<List<usize>> {
    if (node_prod(path) == p_path() && node_prod(kid(path, 0)) == p_path_ident() && node_prod(kid(path, 1)) == p_path_end()) {
        return Some(kid_token(kid(path, 0), 0).text);
    }
    return None;
}

// A path whose last segment may have type arguments (`f<T>`): its
// spellings, and the generic arguments of the last segment.
pub struct PathRef {
    segments: List<List<usize>>,
    targs: List<CTree>,
}

pub fn cons_segment(n: List<usize>, rest: core::option::Option<PathRef>) -> core::option::Option<PathRef> {
    return match (rest) {
        None -> None,
        Some(r) -> Some(PathRef { segments: cons(n, r.segments), targs: r.targs }),
    };
}

pub fn args_segment(n: List<usize>, items: core::option::Option<List<CTree>>) -> core::option::Option<PathRef> {
    return match (items) {
        None -> None,
        Some(gs) -> Some(PathRef { segments: single(n), targs: gs }),
    };
}

pub fn path_ref(fuel: usize, segment: CTree, tail: CTree) -> core::option::Option<PathRef> {
    if (fuel == 0) {
        return None;
    }
    if (node_prod(segment) == p_path_ident() && node_prod(tail) == p_path_end()) {
        return Some(PathRef { segments: single(kid_token(segment, 0).text), targs: empty() });
    }
    if (node_prod(segment) == p_path_ident_args() && node_prod(tail) == p_path_end()) {
        return args_segment(kid_token(segment, 0).text, list_items(fuel, segment));
    }
    if (node_prod(segment) == p_path_ident() && node_prod(tail) == p_path_more()) {
        return cons_segment(kid_token(segment, 0).text, path_ref(minus(fuel, 1), kid(tail, 2), kid(tail, 3)));
    }
    return None;
}

// The spellings of a type path's segments.
pub fn type_path_spellings(fuel: usize, segment: CTree, tail: CTree) -> core::option::Option<List<List<usize>>> {
    if (fuel == 0) {
        return None;
    }
    if (node_prod(segment) == p_type_path_ident() && node_prod(tail) == p_type_path_end()) {
        return Some(single(kid_token(segment, 0).text));
    }
    if (node_prod(segment) == p_type_path_ident() && node_prod(tail) == p_type_path_more()) {
        return cons_name(Some(kid_token(segment, 0).text), type_path_spellings(minus(fuel, 1), kid(tail, 2), kid(tail, 3)));
    }
    return None;
}

// A path as its module (the segments before the last) and its last name.
pub struct Split {
    home: List<List<usize>>,
    name: List<usize>,
}

pub fn split_more(n: List<usize>, rest: core::option::Option<Split>) -> core::option::Option<Split> {
    return match (rest) {
        None -> Some(Split { home: empty(), name: n }),
        Some(s) -> Some(Split { home: cons(n, s.home), name: s.name }),
    };
}

pub fn split_last(segments: List<List<usize>>) -> core::option::Option<Split> {
    return match (segments) {
        Nil -> None,
        Cons(n, rest) -> split_more(n, split_last(unbox(rest))),
    };
}

// A path with no module part names an item of the current module.
pub fn module_or(current: List<List<usize>>, m: List<List<usize>>) -> List<List<usize>> {
    return match (m) {
        Nil -> current,
        Cons(n, rest) -> m,
    };
}

// ---------------------------------------------------------------- declarations

// A type as build reads it: a primitive type, a raw view, or a declared
// struct or enum (its index among all type declarations) at type arguments.
pub enum Ty {
    TyI32,
    TyBool,
    TyUint(UintTy),
    TyPtr,
    TyIsize,
    TyChar,
    TySlice(Box<Ty>),
    TyNamed(usize, Box<List<Ty>>),
    TySint(UintTy),
}

// A declaration at type arguments: a type instance (the declaration is a
// type's index) or a function instance (a function's index).
pub struct Inst {
    decl: usize,
    args: List<Ty>,
}

// A struct or enum declaration: its module, spelling and type parameters,
// a struct's field spellings and types as written, an enum's variant
// spellings and payload types as written.
pub struct TypeDecl {
    home: List<List<usize>>,
    name: List<usize>,
    params: List<List<usize>>,
    is_enum: bool,
    fields: List<List<usize>>,
    field_types: List<CTree>,
    variants: List<List<usize>>,
    payloads: List<List<CTree>>,
}

// A function or an impl method: its module, spelling, the impl's type
// parameters and type as written (a method), its own type parameters, and
// its fn_item or impl_fn_item node.
pub struct FnDecl {
    home: List<List<usize>>,
    name: List<usize>,
    in_impl: bool,
    impl_params: List<List<usize>>,
    self_type: CTree,
    params: List<List<usize>>,
    tree: CTree,
}

// `const name: ty = value;`
pub struct ConstDecl {
    home: List<List<usize>>,
    name: List<usize>,
    ty: CTree,
    value: CTree,
}

// `import target;` in a file of module `module`.
pub struct ImportDecl {
    home: List<List<usize>>,
    target: List<List<usize>>,
}

// `type name<params> = ty;` (no where clause).
pub struct AliasDecl {
    home: List<List<usize>>,
    name: List<usize>,
    params: List<List<usize>>,
    ty: CTree,
}

// The declarations of all the files, in file order.
pub struct Decls {
    types: List<TypeDecl>,
    fns: List<FnDecl>,
    consts: List<ConstDecl>,
    imports: List<ImportDecl>,
    aliases: List<AliasDecl>,
}

pub fn no_decls() -> Decls {
    return Decls { types: empty(), fns: empty(), consts: empty(), imports: empty(), aliases: empty() };
}

pub fn join_decls(a: Decls, b: core::option::Option<Decls>) -> core::option::Option<Decls> {
    return match (b) {
        None -> None,
        Some(d) -> Some(Decls { types: concat(a.types, d.types), fns: concat(a.fns, d.fns), consts: concat(a.consts, d.consts), imports: concat(a.imports, d.imports), aliases: concat(a.aliases, d.aliases) }),
    };
}

pub fn import_decls(home: List<List<usize>>, target: core::option::Option<List<List<usize>>>) -> core::option::Option<Decls> {
    return match (target) {
        None -> None,
        Some(t) -> Some(Decls { types: empty(), fns: empty(), consts: empty(), imports: single(ImportDecl { home: home, target: t }), aliases: empty() }),
    };
}

// The item an item node holds, `pub` or not.
pub fn item_body(item: CTree) -> CTree {
    if (node_prod(item) == p_item_pub()) {
        return kid(kid(item, 1), 0);
    }
    return kid(item, 0);
}

// The path of the file's `module` item; none is the empty path.
pub fn module_path(fuel: usize, items: List<CTree>) -> core::option::Option<List<List<usize>>> {
    return match (items) {
        Nil -> Some(empty()),
        Cons(item, rest) -> module_at(fuel, item_body(item), unbox(rest)),
    };
}

// extract: inline
fn module_at(mfuel: usize, mbody: CTree, mrest: List<CTree>) -> core::option::Option<List<List<usize>>> {
    let mpath: CTree = kid(mbody, 1);
    if (node_prod(mbody) == p_module()) {
        return path_spellings(mfuel, kid(mpath, 0), kid(mpath, 1));
    }
    return module_path(mfuel, mrest);
}

// The spellings of type parameters (enum_type_param, bounds ignored).
pub fn param_spellings(items: List<CTree>) -> core::option::Option<List<List<usize>>> {
    return match (items) {
        Nil -> Some(empty()),
        Cons(p, rest) -> param_spelling_at(p, unbox(rest)),
    };
}

// extract: inline
fn param_spelling_at(pp: CTree, prest: List<CTree>) -> core::option::Option<List<List<usize>>> {
    if (node_prod(pp) == p_enum_type_param()) {
        return cons_name(Some(kid_token(pp, 0).text), param_spellings(prest));
    }
    return None;
}

// The type parameters of an enum_type_params_opt node.
pub fn type_params(fuel: usize, t: CTree) -> core::option::Option<List<List<usize>>> {
    return match (list_items(fuel, t)) {
        None -> None,
        Some(items) -> param_spellings(items),
    };
}

// A struct's fields: spellings and type expressions.
pub struct Fields {
    names: List<List<usize>>,
    types: List<CTree>,
}

pub fn cons_field(f: CTree, rest: Fields) -> Fields {
    return Fields { names: cons(kid_token(f, 0).text, rest.names), types: cons(kid(f, 2), rest.types) };
}

pub fn fields_of(items: List<CTree>) -> Fields {
    return match (items) {
        Nil -> Fields { names: empty(), types: empty() },
        Cons(f, rest) -> cons_field(f, fields_of(unbox(rest))),
    };
}

// An enum's variants: spellings and payload type expressions.
pub struct Variants {
    names: List<List<usize>>,
    payloads: List<List<CTree>>,
}

pub fn cons_variant_tail(name: List<usize>, payload: List<CTree>, rest: core::option::Option<Variants>) -> core::option::Option<Variants> {
    return match (rest) {
        None -> None,
        Some(r) -> Some(Variants { names: cons(name, r.names), payloads: cons(payload, r.payloads) }),
    };
}

pub fn cons_variant(name: List<usize>, payload: core::option::Option<List<CTree>>, rest: core::option::Option<Variants>) -> core::option::Option<Variants> {
    return match (payload) {
        None -> None,
        Some(p) -> cons_variant_tail(name, p, rest),
    };
}

// The payload type expressions of an enum_variant.
pub fn variant_payload(fuel: usize, v: CTree) -> core::option::Option<List<CTree>> {
    let payload: CTree = kid(v, 1);
    if (node_prod(payload) == p_enum_variant_unit()) {
        return Some(empty());
    }
    return list_items(fuel, kid(payload, 1));
}

pub fn variants_of(fuel: usize, items: List<CTree>) -> core::option::Option<Variants> {
    return match (items) {
        Nil -> Some(Variants { names: empty(), payloads: empty() }),
        Cons(v, rest) -> cons_variant(kid_token(v, 0).text, variant_payload(fuel, v), variants_of(fuel, unbox(rest))),
    };
}

pub fn struct_decl_fields(home: List<List<usize>>, name: List<usize>, ps: List<List<usize>>, fs: Fields) -> core::option::Option<TypeDecl> {
    if (distinct(fs.names)) {
        return Some(TypeDecl { home: home, name: name, params: ps, is_enum: false, fields: fs.names, field_types: fs.types, variants: empty(), payloads: empty() });
    }
    return None;
}

pub fn struct_decl_of(home: List<List<usize>>, name: List<usize>, params: core::option::Option<List<List<usize>>>, items: core::option::Option<List<CTree>>) -> core::option::Option<TypeDecl> {
    return match (params) {
        None -> None,
        Some(ps) -> match (items) {
            None -> None,
            Some(fs) -> struct_decl_fields(home, name, ps, fields_of(fs)),
        },
    };
}

pub fn enum_decl_of(home: List<List<usize>>, name: List<usize>, params: core::option::Option<List<List<usize>>>, variants: core::option::Option<Variants>) -> core::option::Option<TypeDecl> {
    return match (params) {
        None -> None,
        Some(ps) -> match (variants) {
            None -> None,
            Some(vs) -> Some(TypeDecl { home: home, name: name, params: ps, is_enum: true, fields: empty(), field_types: empty(), variants: vs.names, payloads: vs.payloads }),
        },
    };
}

// A struct_item or enum_item: no where clause.
pub fn type_decl(fuel: usize, home: List<List<usize>>, s: CTree) -> core::option::Option<TypeDecl> {
    if (node_prod(s) == p_struct() && node_prod(kid(s, 3)) == p_where_none()) {
        return struct_decl_of(home, kid_token(s, 1).text, type_params(fuel, kid(s, 2)), list_items(fuel, kid(s, 5)));
    }
    if (node_prod(s) == p_enum() && node_prod(kid(s, 3)) == p_where_none()) {
        return match (list_items(fuel, kid(s, 5))) {
            None -> None,
            Some(items) -> enum_decl_of(home, kid_token(s, 1).text, type_params(fuel, kid(s, 2)), variants_of(fuel, items)),
        };
    }
    return None;
}

pub fn fn_decl_of(home: List<List<usize>>, f: CTree, in_impl: bool, impl_params: List<List<usize>>, self_type: CTree, params: core::option::Option<List<List<usize>>>) -> core::option::Option<FnDecl> {
    return match (params) {
        None -> None,
        Some(ps) -> Some(FnDecl { home: home, name: kid_token(f, 1).text, in_impl: in_impl, impl_params: impl_params, self_type: self_type, params: ps, tree: f }),
    };
}

pub fn cons_fn_decl(f: core::option::Option<FnDecl>, rest: core::option::Option<List<FnDecl>>) -> core::option::Option<List<FnDecl>> {
    return match (f) {
        None -> None,
        Some(d) -> match (rest) {
            None -> None,
            Some(ds) -> Some(cons(d, ds)),
        },
    };
}

pub fn method_decl(fuel: usize, home: List<List<usize>>, impl_params: List<List<usize>>, self_type: CTree, m: CTree) -> core::option::Option<FnDecl> {
    let f: CTree = kid(m, 0);
    let g: CTree = kid(m, 1);
    if (node_prod(m) == p_impl_method() && node_prod(f) == p_impl_fn()) {
        return fn_decl_of(home, f, true, impl_params, self_type, type_params(fuel, kid(f, 2)));
    }
    if (node_prod(m) == p_impl_method_pub() && node_prod(g) == p_impl_fn()) {
        return fn_decl_of(home, g, true, impl_params, self_type, type_params(fuel, kid(g, 2)));
    }
    return None;
}

// The methods of an impl block: impl_method items holding impl_fn_items.
pub fn methods_of(fuel: usize, home: List<List<usize>>, impl_params: List<List<usize>>, self_type: CTree, items: List<CTree>) -> core::option::Option<List<FnDecl>> {
    return match (items) {
        Nil -> Some(empty()),
        Cons(m, rest) -> cons_fn_decl(method_decl(fuel, home, impl_params, self_type, m), methods_of(fuel, home, impl_params, self_type, unbox(rest))),
    };
}

pub fn fns_decls(fns: core::option::Option<List<FnDecl>>) -> core::option::Option<Decls> {
    return match (fns) {
        None -> None,
        Some(fs) -> Some(Decls { types: empty(), fns: fs, consts: empty(), imports: empty(), aliases: empty() }),
    };
}

pub fn impl_methods(fuel: usize, home: List<List<usize>>, params: core::option::Option<List<List<usize>>>, self_type: CTree, list: CTree) -> core::option::Option<Decls> {
    return match (params) {
        None -> None,
        Some(ps) -> match (list_items(fuel, list)) {
            None -> None,
            Some(items) -> fns_decls(methods_of(fuel, home, ps, self_type, items)),
        },
    };
}

pub fn type_decls(t: core::option::Option<TypeDecl>) -> core::option::Option<Decls> {
    return match (t) {
        None -> None,
        Some(d) -> Some(Decls { types: single(d), fns: empty(), consts: empty(), imports: empty(), aliases: empty() }),
    };
}

pub fn alias_decls(home: List<List<usize>>, name: List<usize>, params: core::option::Option<List<List<usize>>>, ty: CTree) -> core::option::Option<Decls> {
    return match (params) {
        None -> None,
        Some(ps) -> Some(Decls { types: empty(), fns: empty(), consts: empty(), imports: empty(), aliases: single(AliasDecl { home: home, name: name, params: ps, ty: ty }) }),
    };
}

// The declarations an item makes. Imports, extern functions, traits and
// type aliases with a where clause make none; a use of one is rejected when
// it is read.
pub fn item_decls(fuel: usize, home: List<List<usize>>, item: CTree) -> core::option::Option<Decls> {
    let b: CTree = item_body(item);
    let p: usize = node_prod(b);
    if (p == p_struct() || p == p_enum()) {
        return type_decls(type_decl(fuel, home, b));
    }
    if (p == p_fn()) {
        return fns_decls(cons_fn_decl(fn_decl_of(home, b, false, empty(), b, type_params(fuel, kid(b, 2))), Some(empty())));
    }
    if (p == p_const()) {
        return Some(Decls { types: empty(), fns: empty(), consts: single(ConstDecl { home: home, name: kid_token(b, 1).text, ty: kid(b, 3), value: kid(b, 5) }), imports: empty(), aliases: empty() });
    }
    if (p == p_impl_inherent() && node_prod(kid(b, 3)) == p_where_none()) {
        return impl_methods(fuel, home, type_params(fuel, kid(b, 1)), kid(b, 2), kid(b, 5));
    }
    if (p == p_impl_trait() && node_prod(kid(b, 5)) == p_where_none()) {
        return impl_methods(fuel, home, type_params(fuel, kid(b, 1)), kid(b, 4), kid(b, 7));
    }
    if (p == p_import() && node_prod(kid(b, 1)) == p_import_path()) {
        return import_decls(home, path_spellings(fuel, kid(kid(kid(b, 1), 0), 0), kid(kid(kid(b, 1), 0), 1)));
    }
    if (p == p_type_alias() && node_prod(kid(b, 3)) == p_where_none()) {
        // A `distinct` alias (kid 5) runs as its target type.
        return alias_decls(home, kid_token(b, 1).text, type_params(fuel, kid(b, 2)), kid(b, 6));
    }
    if (p == p_module() || p == p_import() || p == p_extern_fn() || p == p_trait() || p == p_type_alias()) {
        return Some(no_decls());
    }
    return None;
}

pub fn collect(fuel: usize, home: List<List<usize>>, items: List<CTree>, acc: Decls) -> core::option::Option<Decls> {
    return match (items) {
        Nil -> Some(acc),
        Cons(item, rest) -> collect_next(fuel, home, join_decls(acc, item_decls(fuel, home, item)), unbox(rest)),
    };
}

// extract: inline
fn collect_next(cfuel: usize, cmodule: List<List<usize>>, cacc: core::option::Option<Decls>, crest: List<CTree>) -> core::option::Option<Decls> {
    return match (cacc) {
        None -> None,
        Some(d) -> collect(cfuel, cmodule, crest, d),
    };
}

// One file's module path and declarations.
pub struct FileDecls {
    home: List<List<usize>>,
    decls: Decls,
}

pub fn file_collected(home: List<List<usize>>, decls: core::option::Option<Decls>) -> core::option::Option<FileDecls> {
    return match (decls) {
        None -> None,
        Some(d) -> Some(FileDecls { home: home, decls: d }),
    };
}

pub fn file_items(fuel: usize, home: core::option::Option<List<List<usize>>>, items: List<CTree>) -> core::option::Option<FileDecls> {
    return match (home) {
        None -> None,
        Some(m) -> file_collected(m, collect(fuel, m, items, no_decls())),
    };
}

pub fn file_decls(fuel: usize, root: CTree) -> core::option::Option<FileDecls> {
    if (node_prod(root) == p_file()) {
        return match (list_items(fuel, kid(root, 0))) {
            None -> None,
            Some(items) -> file_items(fuel, module_path(fuel, items), items),
        };
    }
    return None;
}

// All files' declarations, and their module paths.
pub struct Collected {
    decls: Decls,
    modules: List<List<List<usize>>>,
}

pub fn collected_with(c: Collected, f: FileDecls) -> Collected {
    return Collected { decls: Decls { types: concat(c.decls.types, f.decls.types), fns: concat(c.decls.fns, f.decls.fns), consts: concat(c.decls.consts, f.decls.consts), imports: concat(c.decls.imports, f.decls.imports), aliases: concat(c.decls.aliases, f.decls.aliases) }, modules: concat(c.modules, single(f.home)) };
}

pub fn collect_files(fuel: usize, roots: List<CTree>, acc: Collected) -> core::option::Option<Collected> {
    return match (roots) {
        Nil -> Some(acc),
        Cons(root, rest) -> collect_file_next(fuel, acc, file_decls(fuel, root), unbox(rest)),
    };
}

// extract: inline
fn collect_file_next(ffuel: usize, facc: Collected, ffile: core::option::Option<FileDecls>, frest: List<CTree>) -> core::option::Option<Collected> {
    return match (ffile) {
        None -> None,
        Some(f) -> collect_files(ffuel, frest, collected_with(facc, f)),
    };
}

// The spellings a module gives its items: free functions, types, variants
// and constants. A local cannot be spelled like one, so a use has one
// reading.
pub fn fn_names_in(fns: List<FnDecl>, m: List<List<usize>>) -> List<List<usize>> {
    return match (fns) {
        Nil -> empty(),
        Cons(f, rest) -> fn_name_at(f, unbox(rest), m),
    };
}

// extract: inline
fn fn_name_at(nf: FnDecl, nrest: List<FnDecl>, nm: List<List<usize>>) -> List<List<usize>> {
    if (!nf.in_impl && same_spellings(nf.home, nm)) {
        return cons(nf.name, fn_names_in(nrest, nm));
    }
    return fn_names_in(nrest, nm);
}

pub fn type_names_in(types: List<TypeDecl>, m: List<List<usize>>) -> List<List<usize>> {
    return match (types) {
        Nil -> empty(),
        Cons(t, rest) -> type_name_at(t, unbox(rest), m),
    };
}

// extract: inline
fn type_name_at(tt: TypeDecl, trest: List<TypeDecl>, tm: List<List<usize>>) -> List<List<usize>> {
    if (same_spellings(tt.home, tm)) {
        return cons(tt.name, concat(tt.variants, type_names_in(trest, tm)));
    }
    return type_names_in(trest, tm);
}

pub fn const_names_in(consts: List<ConstDecl>, m: List<List<usize>>) -> List<List<usize>> {
    return match (consts) {
        Nil -> empty(),
        Cons(c, rest) -> const_name_at(c, unbox(rest), m),
    };
}

// extract: inline
fn const_name_at(kc: ConstDecl, krest: List<ConstDecl>, km: List<List<usize>>) -> List<List<usize>> {
    if (same_spellings(kc.home, km)) {
        return cons(kc.name, const_names_in(krest, km));
    }
    return const_names_in(krest, km);
}

pub fn type_only_names_in(types: List<TypeDecl>, m: List<List<usize>>) -> List<List<usize>> {
    return match (types) {
        Nil -> empty(),
        Cons(t, rest) -> type_only_at(t, unbox(rest), m),
    };
}

// extract: inline
fn type_only_at(ot: TypeDecl, orest: List<TypeDecl>, om: List<List<usize>>) -> List<List<usize>> {
    if (same_spellings(ot.home, om)) {
        return cons(ot.name, type_only_names_in(orest, om));
    }
    return type_only_names_in(orest, om);
}

pub fn alias_names_in(aliases: List<AliasDecl>, m: List<List<usize>>) -> List<List<usize>> {
    return match (aliases) {
        Nil -> empty(),
        Cons(a, rest) -> alias_name_at(a, unbox(rest), m),
    };
}

// extract: inline
fn alias_name_at(aa: AliasDecl, arest: List<AliasDecl>, am: List<List<usize>>) -> List<List<usize>> {
    if (same_spellings(aa.home, am)) {
        return cons(aa.name, alias_names_in(arest, am));
    }
    return alias_names_in(arest, am);
}

pub fn none_member(names: List<List<usize>>, others: List<List<usize>>) -> bool {
    return match (names) {
        Nil -> true,
        Cons(n, rest) -> !member(others, n) && none_member(unbox(rest), others),
    };
}

pub fn enum_named_ok(t: TypeDecl, m: List<List<usize>>, values: List<List<usize>>) -> bool {
    if (t.is_enum && same_spellings(t.home, m)) {
        return distinct(t.variants) && none_member(t.variants, values);
    }
    return true;
}

pub fn enums_named_ok(types: List<TypeDecl>, m: List<List<usize>>, values: List<List<usize>>) -> bool {
    return match (types) {
        Nil -> true,
        Cons(t, rest) -> enum_named_ok(t, m, values) && enums_named_ok(unbox(rest), m, values),
    };
}

// A module's functions, types and constants have distinct names. Variants
// are scoped by their enum: an enum's variants are distinct, and no variant
// is spelled like a function or constant of the module (a variant may share
// a name with a type, or with another enum's variant; a bare use of such a
// variant must then be unambiguous, see bare_variant).
pub fn module_names_ok(decls: Decls, m: List<List<usize>>) -> bool {
    return distinct(concat(fn_names_in(decls.fns, m), concat(type_only_names_in(decls.types, m), concat(alias_names_in(decls.aliases, m), const_names_in(decls.consts, m))))) && enums_named_ok(decls.types, m, concat(fn_names_in(decls.fns, m), const_names_in(decls.consts, m)));
}

// The spellings a local may not take: the module's types, type aliases,
// variants and constants. A local may be spelled like a function, since a
// function is only ever named by a call or a path.
pub fn module_globals(decls: Decls, m: List<List<usize>>) -> List<List<usize>> {
    return concat(type_names_in(decls.types, m), concat(alias_names_in(decls.aliases, m), const_names_in(decls.consts, m)));
}

pub fn is_none_type(t: core::option::Option<SrcType>) -> bool {
    return match (t) {
        None -> true,
        Some(x) -> false,
    };
}

// No declared type is spelled like a primitive type.
pub fn no_primitive(types: List<TypeDecl>) -> bool {
    return match (types) {
        Nil -> true,
        Cons(t, rest) -> is_none_type(primitive(t.name)) && no_primitive(unbox(rest)),
    };
}

pub fn no_primitive_alias(aliases: List<AliasDecl>) -> bool {
    return match (aliases) {
        Nil -> true,
        Cons(a, rest) -> is_none_type(primitive(a.name)) && no_primitive_alias(unbox(rest)),
    };
}

pub fn modules_distinct_names(decls: Decls, modules: List<List<List<usize>>>) -> bool {
    return match (modules) {
        Nil -> true,
        Cons(m, rest) -> module_names_ok(decls, m) && modules_distinct_names(decls, unbox(rest)),
    };
}

// The files are distinct modules, and each module's names are distinct.
pub fn well_named(c: Collected) -> bool {
    return distinct_modules(c.modules) && modules_distinct_names(c.decls, c.modules) && no_primitive(c.decls.types) && no_primitive_alias(c.decls.aliases);
}

pub fn no_names(names: List<List<usize>>) -> bool {
    return match (names) {
        Nil -> true,
        Cons(n, rest) -> false,
    };
}

// The functions without type parameters, counting from k: the first file's
// are the program's roots.
pub fn root_insts(fns: List<FnDecl>, k: usize) -> List<Inst> {
    return match (fns) {
        Nil -> empty(),
        Cons(f, rest) -> root_at(f, unbox(rest), k),
    };
}

// extract: inline
fn root_at(rf: FnDecl, rrest: List<FnDecl>, rk: usize) -> List<Inst> {
    if (no_names(rf.impl_params) && no_names(rf.params)) {
        return cons(Inst { decl: rk, args: empty() }, root_insts(rrest, plus(rk, 1)));
    }
    return root_insts(rrest, plus(rk, 1));
}

// The types without type parameters, counting from k: the first file's
// take the first type ids, in declaration order.
pub fn seed_insts(types: List<TypeDecl>, k: usize) -> List<Inst> {
    return match (types) {
        Nil -> empty(),
        Cons(t, rest) -> seed_at(t, unbox(rest), k),
    };
}

// extract: inline
fn seed_at(st: TypeDecl, srest: List<TypeDecl>, sk: usize) -> List<Inst> {
    if (no_names(st.params)) {
        return cons(Inst { decl: sk, args: empty() }, seed_insts(srest, plus(sk, 1)));
    }
    return seed_insts(srest, plus(sk, 1));
}

// ---------------------------------------------------------------- lookups

pub fn find_type(types: List<TypeDecl>, m: List<List<usize>>, name: List<usize>, k: usize) -> core::option::Option<usize> {
    return match (types) {
        Nil -> None,
        Cons(t, rest) -> find_type_at(t, unbox(rest), m, name, k),
    };
}

// extract: inline
fn find_type_at(ft: TypeDecl, frest: List<TypeDecl>, fm: List<List<usize>>, fname: List<usize>, fk: usize) -> core::option::Option<usize> {
    if (same_text(ft.name, fname) && same_spellings(ft.home, fm)) {
        return Some(fk);
    }
    return find_type(frest, fm, fname, plus(fk, 1));
}

// A free function (not a method).
pub fn find_fn(fns: List<FnDecl>, m: List<List<usize>>, name: List<usize>, k: usize) -> core::option::Option<usize> {
    return match (fns) {
        Nil -> None,
        Cons(f, rest) -> find_fn_at(f, unbox(rest), m, name, k),
    };
}

// extract: inline
fn find_fn_at(gf: FnDecl, grest: List<FnDecl>, gm: List<List<usize>>, gname: List<usize>, gk: usize) -> core::option::Option<usize> {
    if (!gf.in_impl && same_text(gf.name, gname) && same_spellings(gf.home, gm)) {
        return Some(gk);
    }
    return find_fn(grest, gm, gname, plus(gk, 1));
}

pub fn find_const(consts: List<ConstDecl>, m: List<List<usize>>, name: List<usize>) -> core::option::Option<ConstDecl> {
    return match (consts) {
        Nil -> None,
        Cons(c, rest) -> find_const_at(c, unbox(rest), m, name),
    };
}

// extract: inline
fn find_const_at(hc: ConstDecl, hrest: List<ConstDecl>, hm: List<List<usize>>, hname: List<usize>) -> core::option::Option<ConstDecl> {
    if (same_text(hc.name, hname) && same_spellings(hc.home, hm)) {
        return Some(hc);
    }
    return find_const(hrest, hm, hname);
}

pub fn find_alias(aliases: List<AliasDecl>, m: List<List<usize>>, name: List<usize>) -> core::option::Option<AliasDecl> {
    return match (aliases) {
        Nil -> None,
        Cons(a, rest) -> find_alias_at(a, unbox(rest), m, name),
    };
}

// extract: inline
fn find_alias_at(fa: AliasDecl, farest: List<AliasDecl>, fam: List<List<usize>>, faname: List<usize>) -> core::option::Option<AliasDecl> {
    if (same_text(fa.name, faname) && same_spellings(fa.home, fam)) {
        return Some(fa);
    }
    return find_alias(farest, fam, faname);
}

// The variant spelled name: its enum's declaration and its index there.
pub struct VariantAt {
    owner: usize,
    index: usize,
}

pub fn find_variant(types: List<TypeDecl>, m: List<List<usize>>, name: List<usize>, k: usize) -> core::option::Option<VariantAt> {
    return match (types) {
        Nil -> None,
        Cons(t, rest) -> find_variant_at(t, unbox(rest), m, name, k),
    };
}

// extract: inline
fn find_variant_at(vt: TypeDecl, vrest: List<TypeDecl>, vm: List<List<usize>>, vname: List<usize>, vk: usize) -> core::option::Option<VariantAt> {
    if (vt.is_enum && same_spellings(vt.home, vm)) {
        return match (position(vt.variants, vname, 0)) {
            None -> find_variant(vrest, vm, vname, plus(vk, 1)),
            Some(j) -> Some(VariantAt { owner: vk, index: j }),
        };
    }
    return find_variant(vrest, vm, vname, plus(vk, 1));
}

// ---------------------------------------------------------------- types

pub fn uint_code(u: UintTy) -> usize {
    return match (u) {
        Uint8 -> 0,
        Uint32 -> 1,
        Uint64 -> 2,
        Usize -> 3,
        Uint16 -> 4,
    };
}

// extract: mutual begin
pub fn same_ty(a: Ty, b: Ty) -> bool {
    return match (a) {
        TyI32 -> match (b) {
            TyI32 -> true,
            TyBool -> false,
            TyUint(v) -> false,
            TyPtr -> false,
            TyIsize -> false,
            TyChar -> false,
            TySlice(f) -> false,
            TyNamed(e, bs) -> false,
            TySint(v) -> false,
        },
        TyBool -> match (b) {
            TyI32 -> false,
            TyBool -> true,
            TyUint(v) -> false,
            TyPtr -> false,
            TyIsize -> false,
            TyChar -> false,
            TySlice(f) -> false,
            TyNamed(e, bs) -> false,
            TySint(v) -> false,
        },
        TyUint(u) -> match (b) {
            TyI32 -> false,
            TyBool -> false,
            TyUint(v) -> uint_code(u) == uint_code(v),
            TyPtr -> false,
            TyIsize -> false,
            TyChar -> false,
            TySlice(f) -> false,
            TyNamed(e, bs) -> false,
            TySint(v) -> false,
        },
        TyPtr -> match (b) {
            TyI32 -> false,
            TyBool -> false,
            TyUint(v) -> false,
            TyPtr -> true,
            TyIsize -> false,
            TyChar -> false,
            TySlice(f) -> false,
            TyNamed(e, bs) -> false,
            TySint(v) -> false,
        },
        TyIsize -> match (b) {
            TyI32 -> false,
            TyBool -> false,
            TyUint(v) -> false,
            TyPtr -> false,
            TyIsize -> true,
            TyChar -> false,
            TySlice(f) -> false,
            TyNamed(e, bs) -> false,
            TySint(v) -> false,
        },
        TyChar -> match (b) {
            TyI32 -> false,
            TyBool -> false,
            TyUint(v) -> false,
            TyPtr -> false,
            TyIsize -> false,
            TyChar -> true,
            TySlice(f) -> false,
            TyNamed(e, bs) -> false,
            TySint(v) -> false,
        },
        TySlice(x) -> match (b) {
            TyI32 -> false,
            TyBool -> false,
            TyUint(v) -> false,
            TyPtr -> false,
            TyIsize -> false,
            TyChar -> false,
            TySlice(f) -> same_ty(unbox(x), unbox(f)),
            TyNamed(e, bs) -> false,
            TySint(v) -> false,
        },
        TyNamed(d, args) -> match (b) {
            TyI32 -> false,
            TyBool -> false,
            TyUint(v) -> false,
            TyPtr -> false,
            TyIsize -> false,
            TyChar -> false,
            TySlice(f) -> false,
            TyNamed(e, bs) -> (d == e) && same_tys(unbox(args), unbox(bs)),
            TySint(v) -> false,
        },
        TySint(u) -> match (b) {
            TyI32 -> false,
            TyBool -> false,
            TyUint(v) -> false,
            TyPtr -> false,
            TyIsize -> false,
            TyChar -> false,
            TySlice(f) -> false,
            TyNamed(e, bs) -> false,
            TySint(v) -> uint_code(u) == uint_code(v),
        },
    };
}

pub fn same_tys(a: List<Ty>, b: List<Ty>) -> bool {
    return match (a) {
        Nil -> match (b) {
            Nil -> true,
            Cons(y, more) -> false,
        },
        Cons(x, rest) -> match (b) {
            Nil -> false,
            Cons(y, more) -> same_ty(x, y) && same_tys(unbox(rest), unbox(more)),
        },
    };
}
// extract: mutual end

pub fn same_inst(a: Inst, b: Inst) -> bool {
    return (a.decl == b.decl) && same_tys(a.args, b.args);
}

pub fn inst_member(table: List<Inst>, x: Inst) -> bool {
    return match (table) {
        Nil -> false,
        Cons(y, rest) -> same_inst(y, x) || inst_member(unbox(rest), x),
    };
}

// The position of an instance in a table, counting from k.
pub fn inst_index(table: List<Inst>, x: Inst, k: usize) -> core::option::Option<usize> {
    return match (table) {
        Nil -> None,
        Cons(y, rest) -> inst_index_at(y, unbox(rest), x, k),
    };
}

// extract: inline
fn inst_index_at(iy: Inst, irest: List<Inst>, ix: Inst, ik: usize) -> core::option::Option<usize> {
    if (same_inst(iy, ix)) {
        return Some(ik);
    }
    return inst_index(irest, ix, plus(ik, 1));
}

pub fn add_inst(table: List<Inst>, x: Inst) -> List<Inst> {
    if (inst_member(table, x)) {
        return table;
    }
    return concat(table, single(x));
}

// The table with the new instances appended in order, each once.
pub fn add_insts(table: List<Inst>, new: List<Inst>) -> List<Inst> {
    return match (new) {
        Nil -> table,
        Cons(x, rest) -> add_insts(add_inst(table, x), unbox(rest)),
    };
}

// Where a type expression is read: the declarations, the module, and the
// type parameters in scope with their types; the spellings a local may
// not take; and, in a function body, its result type and the byte offset of
// its name, which locals are numbered from.
pub struct FrontEnv {
    decls: Decls,
    home: List<List<usize>>,
    names: List<List<usize>>,
    subst: List<Ty>,
    globals: List<List<usize>>,
    ret: core::option::Option<Ty>,
    base: usize,
}

pub fn decl_env(decls: Decls, home: List<List<usize>>, names: List<List<usize>>, subst: List<Ty>) -> FrontEnv {
    return FrontEnv { decls: decls, home: home, names: names, subst: subst, globals: empty(), ret: None, base: 0 };
}

// The variants spelled name among module m's enums (types counted from k).
pub fn variants_named(types: List<TypeDecl>, m: List<List<usize>>, name: List<usize>, k: usize) -> List<VariantAt> {
    return match (types) {
        Nil -> empty(),
        Cons(t, rest) -> variants_named_at(t, unbox(rest), m, name, k),
    };
}

// extract: inline
fn variants_named_at(nt: TypeDecl, nrest: List<TypeDecl>, nm: List<List<usize>>, nname: List<usize>, nk: usize) -> List<VariantAt> {
    if (nt.is_enum && same_spellings(nt.home, nm)) {
        return match (position(nt.variants, nname, 0)) {
            None -> variants_named(nrest, nm, nname, plus(nk, 1)),
            Some(j) -> cons(VariantAt { owner: nk, index: j }, variants_named(nrest, nm, nname, plus(nk, 1))),
        };
    }
    return variants_named(nrest, nm, nname, plus(nk, 1));
}

// The variants spelled name in the modules that module m imports.
pub fn imported_variants(types: List<TypeDecl>, imports: List<ImportDecl>, m: List<List<usize>>, name: List<usize>) -> List<VariantAt> {
    return match (imports) {
        Nil -> empty(),
        Cons(i, rest) -> imported_variants_at(types, i, unbox(rest), m, name),
    };
}

// extract: inline
fn imported_variants_at(it: List<TypeDecl>, ii: ImportDecl, irest: List<ImportDecl>, im: List<List<usize>>, iname: List<usize>) -> List<VariantAt> {
    if (same_spellings(ii.home, im)) {
        return concat(variants_named(it, ii.target, iname, 0), imported_variants(it, irest, im, iname));
    }
    return imported_variants(it, irest, im, iname);
}

pub fn only_variant(vs: List<VariantAt>) -> core::option::Option<VariantAt> {
    return match (vs) {
        Nil -> None,
        Cons(v, rest) -> match (unbox(rest)) {
            Nil -> Some(v),
            Cons(w, more) -> None,
        },
    };
}

// A bare variant name: the one enum of the current module that has it, or
// else the one enum of the imported modules that has it.
pub fn bare_variant(env: FrontEnv, name: List<usize>) -> core::option::Option<VariantAt> {
    return match (variants_named(env.decls.types, env.home, name, 0)) {
        Nil -> only_variant(imported_variants(env.decls.types, env.decls.imports, env.home, name)),
        Cons(v, rest) -> only_variant(cons(v, unbox(rest))),
    };
}

pub fn variant_of_decl(t: TypeDecl, k: usize, name: List<usize>) -> core::option::Option<VariantAt> {
    if (t.is_enum) {
        return match (position(t.variants, name, 0)) {
            None -> None,
            Some(j) -> Some(VariantAt { owner: k, index: j }),
        };
    }
    return None;
}

pub fn variant_in(types: List<TypeDecl>, d: core::option::Option<usize>, name: List<usize>) -> core::option::Option<VariantAt> {
    return match (d) {
        None -> None,
        Some(k) -> match (get(types, k)) {
            None -> None,
            Some(t) -> variant_of_decl(t, k, name),
        },
    };
}

// `E::V` or `m::E::V`: the variant V of the enum E.
pub fn enum_variant(env: FrontEnv, front: List<List<usize>>, name: List<usize>) -> core::option::Option<VariantAt> {
    return match (split_last(front)) {
        None -> None,
        Some(t) -> variant_in(env.decls.types, find_type(env.decls.types, module_or(env.home, t.home), t.name, 0), name),
    };
}

// The variant a value path names: `V` (see bare_variant), `E::V` or
// `m::E::V` when the prefix names an enum, else `m::V`, the one enum of
// module m that has V.
pub fn variant_by_path(env: FrontEnv, s: Split) -> core::option::Option<VariantAt> {
    if (no_names(s.home)) {
        return bare_variant(env, s.name);
    }
    return match (enum_variant(env, s.home, s.name)) {
        Some(v) -> Some(v),
        None -> only_variant(variants_named(env.decls.types, s.home, s.name, 0)),
    };
}

// The primitive types as Ty, and back.
pub fn src_ty(t: SrcType) -> core::option::Option<Ty> {
    return match (t) {
        I32 -> Some(TyI32),
        Bool -> Some(TyBool),
        Uint(k) -> Some(TyUint(k)),
        Struct(id, fields) -> None,
        Enum(id, variants) -> None,
        Ptr -> Some(TyPtr),
        Slice(e) -> None,
        Unit -> None,
        Isize -> Some(TyIsize),
        SrcType::Char -> Some(TyChar),
        Sint(sk) -> Some(TySint(sk)),
    };
}

pub fn scalar_src(t: Ty) -> core::option::Option<SrcType> {
    return match (t) {
        TyI32 -> Some(I32),
        TyBool -> Some(Bool),
        TyUint(k) -> Some(Uint(k)),
        TyPtr -> Some(Ptr),
        TyIsize -> Some(Isize),
        TyChar -> Some(SrcType::Char),
        TySlice(e) -> None,
        TyNamed(d, args) -> None,
        TySint(k) -> Some(Sint(k)),
    };
}

pub fn prim_ty(name: List<usize>) -> core::option::Option<Ty> {
    return match (primitive(name)) {
        None -> None,
        Some(t) -> src_ty(t),
    };
}

// The type a type parameter spelled name stands for.
pub fn param_ty(env: FrontEnv, name: List<usize>) -> core::option::Option<Ty> {
    return match (position(env.names, name, 0)) {
        None -> None,
        Some(i) -> get(env.subst, i),
    };
}

// The declaration a type path names: a path with no module part names a
// type of the current module.
pub fn type_decl_at(env: FrontEnv, segments: List<List<usize>>) -> core::option::Option<usize> {
    return match (split_last(segments)) {
        None -> None,
        Some(s) -> find_type(env.decls.types, module_or(env.home, s.home), s.name, 0),
    };
}

pub fn arity_ok(env: FrontEnv, d: usize, args: List<Ty>) -> bool {
    return match (get(env.decls.types, d)) {
        None -> false,
        Some(t) -> length(t.params) == length(args),
    };
}

pub fn named_checked(ok: bool, d: usize, ts: List<Ty>) -> core::option::Option<Ty> {
    if (ok) {
        return Some(TyNamed(d, boxed(ts)));
    }
    return None;
}

pub fn named_args(env: FrontEnv, d: usize, args: core::option::Option<List<Ty>>) -> core::option::Option<Ty> {
    return match (args) {
        None -> None,
        Some(ts) -> named_checked(arity_ok(env, d, ts), d, ts),
    };
}

pub fn named_of(env: FrontEnv, d: core::option::Option<usize>, args: core::option::Option<List<Ty>>) -> core::option::Option<Ty> {
    return match (d) {
        None -> None,
        Some(x) -> named_args(env, x, args),
    };
}

pub fn prim_or_named(env: FrontEnv, segments: List<List<usize>>, n: List<usize>) -> core::option::Option<Ty> {
    return match (prim_ty(n)) {
        Some(t) -> Some(t),
        None -> named_of(env, type_decl_at(env, segments), Some(empty())),
    };
}

// A type without arguments: a type parameter, a primitive type or a
// declared type.
pub fn bare_ty(env: FrontEnv, segments: List<List<usize>>) -> core::option::Option<Ty> {
    return match (single_name(segments)) {
        None -> named_of(env, type_decl_at(env, segments), Some(empty())),
        Some(n) -> match (param_ty(env, n)) {
            Some(t) -> Some(t),
            None -> prim_or_named(env, segments, n),
        },
    };
}

pub fn bare_of(env: FrontEnv, segments: core::option::Option<List<List<usize>>>) -> core::option::Option<Ty> {
    return match (segments) {
        None -> None,
        Some(ss) -> bare_ty(env, ss),
    };
}

pub fn slice_ty(element: core::option::Option<Ty>) -> core::option::Option<Ty> {
    return match (element) {
        None -> None,
        Some(e) -> Some(TySlice(boxed(e))),
    };
}

pub fn cons_ty_tail(t: Ty, tail: core::option::Option<List<Ty>>) -> core::option::Option<List<Ty>> {
    return match (tail) {
        None -> None,
        Some(ts) -> Some(cons(t, ts)),
    };
}

pub fn cons_ty(head: core::option::Option<Ty>, tail: core::option::Option<List<Ty>>) -> core::option::Option<List<Ty>> {
    return match (head) {
        None -> None,
        Some(t) -> cons_ty_tail(t, tail),
    };
}

// extract: mutual begin
// The type a type expression names: `[T]`, a type parameter, a primitive
// type, or a declared type with its arguments.
pub fn ty_of(fuel: usize, env: FrontEnv, t: CTree) -> core::option::Option<Ty> {
    if (fuel == 0) {
        return None;
    }
    let f: usize = minus(fuel, 1);
    let path: CTree = kid(t, 0);
    if (node_prod(t) == p_type_array() && node_prod(kid(t, 2)) == p_type_slice_tail()) {
        return slice_ty(ty_of(f, env, kid(t, 1)));
    }
    if (node_prod(t) == p_type_ident() && node_prod(kid(t, 1)) == p_type_args_none()) {
        return bare_or_alias(f, env, type_path_spellings(f, kid(path, 0), kid(path, 1)));
    }
    if (node_prod(t) == p_type_ident() && node_prod(kid(t, 1)) == p_type_args_some()) {
        return applied_of(f, env, type_path_spellings(f, kid(path, 0), kid(path, 1)), list_items(f, kid(t, 1)));
    }
    return None;
}

pub fn applied_of(fuel: usize, env: FrontEnv, segments: core::option::Option<List<List<usize>>>, items: core::option::Option<List<CTree>>) -> core::option::Option<Ty> {
    if (fuel == 0) {
        return None;
    }
    return match (segments) {
        None -> None,
        Some(ss) -> match (items) {
            None -> None,
            Some(gs) -> match (type_decl_at(env, ss)) {
                Some(d) -> named_args(env, d, args_tys(minus(fuel, 1), env, gs)),
                None -> alias_ty(minus(fuel, 1), env, ss, args_tys(minus(fuel, 1), env, gs)),
            },
        },
    };
}

// A type path without arguments: a type parameter, a primitive or declared
// type, or else a type alias.
pub fn bare_or_alias(fuel: usize, env: FrontEnv, segments: core::option::Option<List<List<usize>>>) -> core::option::Option<Ty> {
    if (fuel == 0) {
        return None;
    }
    return match (segments) {
        None -> None,
        Some(ss) -> match (bare_ty(env, ss)) {
            Some(t) -> Some(t),
            None -> alias_ty(minus(fuel, 1), env, ss, Some(empty())),
        },
    };
}

// The type alias a path names, at type arguments: its type, read in the
// alias's module with its parameters standing for the arguments.
pub fn alias_ty(fuel: usize, env: FrontEnv, segments: List<List<usize>>, args: core::option::Option<List<Ty>>) -> core::option::Option<Ty> {
    if (fuel == 0) {
        return None;
    }
    return match (split_last(segments)) {
        None -> None,
        Some(s) -> match (find_alias(env.decls.aliases, module_or(env.home, s.home), s.name)) {
            None -> None,
            Some(a) -> match (args) {
                None -> None,
                Some(ts) -> alias_at(minus(fuel, 1), env.decls, a, ts),
            },
        },
    };
}

pub fn alias_at(fuel: usize, decls: Decls, a: AliasDecl, ts: List<Ty>) -> core::option::Option<Ty> {
    if (fuel == 0) {
        return None;
    }
    if (length(a.params) == length(ts)) {
        return ty_of(minus(fuel, 1), decl_env(decls, a.home, a.params, ts), a.ty);
    }
    return None;
}

// The types of generic arguments (generic_argument_type).
pub fn args_tys(fuel: usize, env: FrontEnv, items: List<CTree>) -> core::option::Option<List<Ty>> {
    if (fuel == 0) {
        return None;
    }
    return match (items) {
        Nil -> Some(empty()),
        Cons(g, rest) -> cons_ty(arg_ty(minus(fuel, 1), env, g), args_tys(minus(fuel, 1), env, unbox(rest))),
    };
}

pub fn arg_ty(fuel: usize, env: FrontEnv, g: CTree) -> core::option::Option<Ty> {
    if (fuel == 0) {
        return None;
    }
    if (node_prod(g) == p_generic_argument_type()) {
        return ty_of(minus(fuel, 1), env, kid(g, 0));
    }
    return None;
}

// The types of a list of type expressions.
pub fn ty_list(fuel: usize, env: FrontEnv, ts: List<CTree>) -> core::option::Option<List<Ty>> {
    if (fuel == 0) {
        return None;
    }
    return match (ts) {
        Nil -> Some(empty()),
        Cons(t, rest) -> cons_ty(ty_of(minus(fuel, 1), env, t), ty_list(minus(fuel, 1), env, unbox(rest))),
    };
}
// extract: mutual end

pub fn cons_tys_tail(t: List<Ty>, tail: core::option::Option<List<List<Ty>>>) -> core::option::Option<List<List<Ty>>> {
    return match (tail) {
        None -> None,
        Some(ts) -> Some(cons(t, ts)),
    };
}

pub fn cons_tys(head: core::option::Option<List<Ty>>, tail: core::option::Option<List<List<Ty>>>) -> core::option::Option<List<List<Ty>>> {
    return match (head) {
        None -> None,
        Some(t) -> cons_tys_tail(t, tail),
    };
}

pub fn payload_list(fuel: usize, env: FrontEnv, ps: List<List<CTree>>) -> core::option::Option<List<List<Ty>>> {
    return match (ps) {
        Nil -> Some(empty()),
        Cons(p, rest) -> cons_tys(ty_list(fuel, env, p), payload_list(fuel, env, unbox(rest))),
    };
}

// A struct's field types at type arguments.
pub fn field_tys(fuel: usize, decls: Decls, d: usize, args: List<Ty>) -> core::option::Option<List<Ty>> {
    return match (get(decls.types, d)) {
        None -> None,
        Some(t) -> ty_list(fuel, decl_env(decls, t.home, t.params, args), t.field_types),
    };
}

// An enum's payload types at type arguments.
pub fn payload_tys(fuel: usize, decls: Decls, d: usize, args: List<Ty>) -> core::option::Option<List<List<Ty>>> {
    return match (get(decls.types, d)) {
        None -> None,
        Some(t) -> payload_list(fuel, decl_env(decls, t.home, t.params, args), t.payloads),
    };
}

pub fn flatten_tys(vs: List<List<Ty>>) -> List<Ty> {
    return match (vs) {
        Nil -> empty(),
        Cons(v, rest) -> concat(v, flatten_tys(unbox(rest))),
    };
}

pub fn flat_payloads(vs: core::option::Option<List<List<Ty>>>) -> core::option::Option<List<Ty>> {
    return match (vs) {
        None -> None,
        Some(xs) -> Some(flatten_tys(xs)),
    };
}

pub fn cons_type_tail(t: SrcType, tail: core::option::Option<List<SrcType>>) -> core::option::Option<List<SrcType>> {
    return match (tail) {
        None -> None,
        Some(ts) -> Some(cons(t, ts)),
    };
}

pub fn cons_type(head: core::option::Option<SrcType>, tail: core::option::Option<List<SrcType>>) -> core::option::Option<List<SrcType>> {
    return match (head) {
        None -> None,
        Some(t) -> cons_type_tail(t, tail),
    };
}

pub fn cons_types_tail(t: List<SrcType>, tail: core::option::Option<List<List<SrcType>>>) -> core::option::Option<List<List<SrcType>>> {
    return match (tail) {
        None -> None,
        Some(ts) -> Some(cons(t, ts)),
    };
}

pub fn cons_types(head: core::option::Option<List<SrcType>>, tail: core::option::Option<List<List<SrcType>>>) -> core::option::Option<List<List<SrcType>>> {
    return match (head) {
        None -> None,
        Some(t) -> cons_types_tail(t, tail),
    };
}

pub fn slice_type(element: core::option::Option<SrcType>) -> core::option::Option<SrcType> {
    return match (element) {
        None -> None,
        Some(e) -> Some(Slice(boxed(e))),
    };
}

pub fn struct_src(id: core::option::Option<usize>, fields: core::option::Option<List<SrcType>>) -> core::option::Option<SrcType> {
    return match (id) {
        None -> None,
        Some(k) -> match (fields) {
            None -> None,
            Some(fs) -> Some(Struct(k, boxed(fs))),
        },
    };
}

pub fn enum_src(id: core::option::Option<usize>, variants: core::option::Option<List<List<SrcType>>>) -> core::option::Option<SrcType> {
    return match (id) {
        None -> None,
        Some(k) -> match (variants) {
            None -> None,
            Some(vs) -> Some(Enum(k, boxed(vs))),
        },
    };
}

// extract: mutual begin
// The source type of a type: a declared type at arguments is the struct or
// enum whose id is the instance's position in the type table.
pub fn lower_ty(fuel: usize, decls: Decls, table: List<Inst>, t: Ty) -> core::option::Option<SrcType> {
    if (fuel == 0) {
        return None;
    }
    return match (t) {
        TyI32 -> Some(I32),
        TyBool -> Some(Bool),
        TyUint(k) -> Some(Uint(k)),
        TyPtr -> Some(Ptr),
        TyIsize -> Some(Isize),
        TyChar -> Some(SrcType::Char),
        TySlice(e) -> slice_type(lower_ty(minus(fuel, 1), decls, table, unbox(e))),
        TyNamed(d, args) -> lower_named(minus(fuel, 1), decls, table, d, unbox(args)),
        TySint(k) -> Some(Sint(k)),
    };
}

pub fn lower_named(fuel: usize, decls: Decls, table: List<Inst>, d: usize, args: List<Ty>) -> core::option::Option<SrcType> {
    if (fuel == 0) {
        return None;
    }
    return match (get(decls.types, d)) {
        None -> None,
        Some(t) -> lower_decl(minus(fuel, 1), decls, table, t.is_enum, inst_index(table, Inst { decl: d, args: args }, 0), d, args),
    };
}

pub fn lower_decl(fuel: usize, decls: Decls, table: List<Inst>, is_enum: bool, id: core::option::Option<usize>, d: usize, args: List<Ty>) -> core::option::Option<SrcType> {
    if (fuel == 0) {
        return None;
    }
    if (is_enum) {
        return enum_src(id, lower_variants(minus(fuel, 1), decls, table, payload_tys(fuel, decls, d, args)));
    }
    return struct_src(id, lower_tys(minus(fuel, 1), decls, table, field_tys(fuel, decls, d, args)));
}

pub fn lower_tys(fuel: usize, decls: Decls, table: List<Inst>, ts: core::option::Option<List<Ty>>) -> core::option::Option<List<SrcType>> {
    if (fuel == 0) {
        return None;
    }
    return match (ts) {
        None -> None,
        Some(xs) -> match (xs) {
            Nil -> Some(empty()),
            Cons(t, rest) -> cons_type(lower_ty(minus(fuel, 1), decls, table, t), lower_tys(minus(fuel, 1), decls, table, Some(unbox(rest)))),
        },
    };
}

pub fn lower_variants(fuel: usize, decls: Decls, table: List<Inst>, vs: core::option::Option<List<List<Ty>>>) -> core::option::Option<List<List<SrcType>>> {
    if (fuel == 0) {
        return None;
    }
    return match (vs) {
        None -> None,
        Some(xs) -> match (xs) {
            Nil -> Some(empty()),
            Cons(v, rest) -> cons_types(lower_tys(minus(fuel, 1), decls, table, Some(v)), lower_variants(minus(fuel, 1), decls, table, Some(unbox(rest)))),
        },
    };
}
// extract: mutual end

pub fn join_insts(a: core::option::Option<List<Inst>>, b: core::option::Option<List<Inst>>) -> core::option::Option<List<Inst>> {
    return match (a) {
        None -> None,
        Some(xs) -> match (b) {
            None -> None,
            Some(ys) -> Some(concat(xs, ys)),
        },
    };
}

pub fn cons_inst(x: Inst, rest: core::option::Option<List<Inst>>) -> core::option::Option<List<Inst>> {
    return match (rest) {
        None -> None,
        Some(xs) -> Some(cons(x, xs)),
    };
}

// extract: mutual begin
// The type instances a type's source type has ids for: the type itself,
// then those of its field or payload types, in order.
pub fn ty_insts(fuel: usize, decls: Decls, t: Ty) -> core::option::Option<List<Inst>> {
    if (fuel == 0) {
        return None;
    }
    return match (t) {
        TyI32 -> Some(empty()),
        TyBool -> Some(empty()),
        TyUint(k) -> Some(empty()),
        TyPtr -> Some(empty()),
        TyIsize -> Some(empty()),
        TyChar -> Some(empty()),
        TySlice(e) -> ty_insts(minus(fuel, 1), decls, unbox(e)),
        TyNamed(d, args) -> cons_inst(Inst { decl: d, args: unbox(args) }, named_insts(minus(fuel, 1), decls, d, unbox(args))),
        TySint(k) -> Some(empty()),
    };
}

pub fn named_insts(fuel: usize, decls: Decls, d: usize, args: List<Ty>) -> core::option::Option<List<Inst>> {
    if (fuel == 0) {
        return None;
    }
    return match (get(decls.types, d)) {
        None -> None,
        Some(t) -> decl_insts(minus(fuel, 1), decls, t.is_enum, d, args),
    };
}

pub fn decl_insts(fuel: usize, decls: Decls, is_enum: bool, d: usize, args: List<Ty>) -> core::option::Option<List<Inst>> {
    if (fuel == 0) {
        return None;
    }
    if (is_enum) {
        return tys_insts(minus(fuel, 1), decls, flat_payloads(payload_tys(fuel, decls, d, args)));
    }
    return tys_insts(minus(fuel, 1), decls, field_tys(fuel, decls, d, args));
}

pub fn tys_insts(fuel: usize, decls: Decls, ts: core::option::Option<List<Ty>>) -> core::option::Option<List<Inst>> {
    if (fuel == 0) {
        return None;
    }
    return match (ts) {
        None -> None,
        Some(xs) -> match (xs) {
            Nil -> Some(empty()),
            Cons(t, rest) -> join_insts(ty_insts(minus(fuel, 1), decls, t), tys_insts(minus(fuel, 1), decls, Some(unbox(rest)))),
        },
    };
}
// extract: mutual end

// ---------------------------------------------------------------- expressions

// The binary operator of an operator tail production.
pub fn tail_op(p: usize) -> core::option::Option<SrcOp> {
    if (p == p_or_tail()) {
        return Some(LogicalOr);
    }
    if (p == p_and_tail()) {
        return Some(LogicalAnd);
    }
    if (p == p_bor_tail()) {
        return Some(BitOr);
    }
    if (p == p_xor_tail()) {
        return Some(BitXor);
    }
    if (p == p_band_tail()) {
        return Some(BitAnd);
    }
    if (p == p_eq_tail()) {
        return Some(Equal);
    }
    if (p == p_ne_tail()) {
        return Some(NotEqual);
    }
    if (p == p_lt_tail()) {
        return Some(Less);
    }
    if (p == p_gt_tail()) {
        return Some(Greater);
    }
    if (p == p_le_tail()) {
        return Some(LessEq);
    }
    if (p == p_ge_tail()) {
        return Some(GreaterEq);
    }
    if (p == p_shl_tail()) {
        return Some(ShiftLeft);
    }
    if (p == p_shr_tail()) {
        return Some(ShiftRight);
    }
    if (p == p_add_tail()) {
        return Some(Plus);
    }
    if (p == p_sub_tail()) {
        return Some(Minus);
    }
    if (p == p_mul_tail()) {
        return Some(Times);
    }
    return None;
}

// A level of binary operators: level -> operand level_tail.
pub fn is_level(p: usize) -> bool {
    return p == p_orexpr() || p == p_andexpr() || p == p_bit_or() || p == p_bit_xor() || p == p_bit_and()
        || p == p_equality() || p == p_compare() || p == p_shift() || p == p_add() || p == p_mul();
}

pub fn negated(e: core::option::Option<SrcExpr>) -> core::option::Option<SrcExpr> {
    return match (e) {
        None -> None,
        Some(x) -> Some(Negate(boxed(x))),
    };
}

pub fn notted(e: core::option::Option<SrcExpr>) -> core::option::Option<SrcExpr> {
    return match (e) {
        None -> None,
        Some(x) -> Some(Not(boxed(x))),
    };
}

// The value of a decimal literal below 2^31.
pub fn decimal(text: List<usize>, acc: usize) -> core::option::Option<usize> {
    if (acc > 2147483647) {
        return None;
    }
    return match (text) {
        Nil -> Some(acc),
        Cons(b, rest) -> decimal_digit(b, unbox(rest), acc),
    };
}

// extract: inline
fn decimal_digit(db: usize, drest: List<usize>, dacc: usize) -> core::option::Option<usize> {
    if (db >= 48 && 57 >= db) {
        return decimal(drest, plus(times(dacc, 10), minus(db, 48)));
    }
    return None;
}

// extract: inline
fn int_in_range(iv: usize) -> core::option::Option<SrcExpr> {
    if (2147483647 >= iv) {
        return Some(Int(iv as i32));
    }
    return None;
}

// Decimal digits, below 2^64.
pub fn wide_decimal(text: List<usize>, acc: usize) -> core::option::Option<usize> {
    if (acc > 18446744073709551615) {
        return None;
    }
    return match (text) {
        Nil -> Some(acc),
        Cons(b, rest) -> wide_digit(b, unbox(rest), acc),
    };
}

// extract: inline
fn wide_digit(wb: usize, wrest: List<usize>, wacc: usize) -> core::option::Option<usize> {
    if (wb >= 48 && 57 >= wb) {
        return wide_decimal(wrest, plus(times(wacc, 10), minus(wb, 48)));
    }
    return None;
}

pub fn unit_ty(t: SrcType) -> bool {
    return match (t) {
        I32 -> false,
        Bool -> false,
        Uint(k) -> false,
        Struct(id, fields) -> false,
        Enum(id, variants) -> false,
        Ptr -> false,
        Slice(e) -> false,
        Unit -> true,
        Isize -> false,
        SrcType::Char -> false,
        Sint(sk) -> false,
    };
}

// A literal of 2^31 or more (below 2^64) is read as Cast(Unit, Unsigned(Uint64, n)),
// a form no other source has (no cast names Unit); lit_funcs gives it the
// type its context expects, and build rejects one that gets none.
pub fn wide_marker(v: core::option::Option<usize>) -> core::option::Option<SrcExpr> {
    return match (v) {
        None -> None,
        Some(n) -> Some(Cast(Unit, boxed(Unsigned(Uint64, n as u64)))),
    };
}

pub fn int_literal(text: List<usize>) -> core::option::Option<SrcExpr> {
    return match (decimal(text, 0)) {
        None -> wide_marker(wide_decimal(text, 0)),
        Some(v) -> int_in_range(v),
    };
}

// extract: inline
fn char_end(ecode: usize, eq: usize, emore: List<usize>) -> core::option::Option<SrcExpr> {
    if (eq == 39) {
        return match (emore) {
            Nil -> Some(SrcExpr::Char((ecode as i32) as u32)),
            Cons(b, more) -> None,
        };
    }
    return None;
}

// The closing quote, last.
pub fn char_close(code: usize, rest: List<usize>) -> core::option::Option<SrcExpr> {
    return match (rest) {
        Nil -> None,
        Cons(q, more) -> char_end(code, q, unbox(more)),
    };
}

pub fn char_close_opt(code: core::option::Option<usize>, rest: List<usize>) -> core::option::Option<SrcExpr> {
    return match (code) {
        None -> None,
        Some(c) -> char_close(c, rest),
    };
}

// The byte an escape \e stands for.
pub fn escaped_byte(e: usize) -> core::option::Option<usize> {
    if (e == 110) {
        return Some(10);
    }
    if (e == 114) {
        return Some(13);
    }
    if (e == 116) {
        return Some(9);
    }
    if (e == 48) {
        return Some(0);
    }
    if (e == 39 || e == 34 || e == 92) {
        return Some(e);
    }
    return None;
}

// extract: inline
fn char_escape(etext: List<usize>) -> core::option::Option<SrcExpr> {
    return match (etext) {
        Nil -> None,
        Cons(e, rest) -> char_close_opt(escaped_byte(e), unbox(rest)),
    };
}

// extract: inline
fn char_tail_at(tb: usize, trest: List<usize>, tmore: usize, tcode: usize, tlo: usize, thi: usize) -> core::option::Option<SrcExpr> {
    if (tb >= tlo && thi >= tb) {
        let next: usize = plus(times(tcode, 64), minus(tb, 128));
        if (tmore == 0) {
            return char_close(next, trest);
        }
        return char_tail(trest, minus(tmore, 1), next, 128, 191);
    }
    return None;
}

// The continuation bytes of a UTF-8 encoding: the next in lo..hi, then
// `more` more in 128..191, each adding its low six bits to code.
pub fn char_tail(text: List<usize>, more: usize, code: usize, lo: usize, hi: usize) -> core::option::Option<SrcExpr> {
    return match (text) {
        Nil -> None,
        Cons(b, rest) -> char_tail_at(b, unbox(rest), more, code, lo, hi),
    };
}

// extract: inline
fn char_first(fb: usize, frest: List<usize>) -> core::option::Option<SrcExpr> {
    if (fb == 92) {
        return char_escape(frest);
    }
    if (fb == 39 || fb == 10) {
        return None;
    }
    if (128 > fb) {
        return char_close(fb, frest);
    }
    if (fb >= 194 && 223 >= fb) {
        return char_tail(frest, 0, minus(fb, 192), 128, 191);
    }
    if (fb == 224) {
        return char_tail(frest, 1, 0, 160, 191);
    }
    if (fb == 237) {
        return char_tail(frest, 1, 13, 128, 159);
    }
    if (fb >= 225 && 239 >= fb) {
        return char_tail(frest, 1, minus(fb, 224), 128, 191);
    }
    if (fb == 240) {
        return char_tail(frest, 2, 0, 144, 191);
    }
    if (fb == 244) {
        return char_tail(frest, 2, 4, 128, 143);
    }
    if (fb >= 241 && 243 >= fb) {
        return char_tail(frest, 2, minus(fb, 240), 128, 191);
    }
    return None;
}

pub fn char_body(text: List<usize>) -> core::option::Option<SrcExpr> {
    return match (text) {
        Nil -> None,
        Cons(b, rest) -> char_first(b, unbox(rest)),
    };
}

// extract: inline
fn char_open(oq: usize, orest: List<usize>) -> core::option::Option<SrcExpr> {
    if (oq == 39) {
        return char_body(orest);
    }
    return None;
}

// A char literal's text, its quotes included: one byte below 128 other than
// the quote, the backslash and newline; an escape \n \r \t \0 \' \" \\; or
// the well-formed UTF-8 encoding of one Unicode scalar, two to four bytes.
// laniusc's parse_char_token decodes these the same way (it also takes
// forms this rejects).
pub fn char_literal(text: List<usize>) -> core::option::Option<SrcExpr> {
    return match (text) {
        Nil -> None,
        Cons(q, rest) -> char_open(q, unbox(rest)),
    };
}

// A local in scope: its spelling, its id and its type.
pub struct Local {
    name: List<usize>,
    id: usize,
    ty: Ty,
}

// The innermost local spelled name.
pub fn find_local(scope: List<Local>, name: List<usize>) -> core::option::Option<Local> {
    return match (scope) {
        Nil -> None,
        Cons(l, rest) -> find_local_at(l, unbox(rest), name),
    };
}

// extract: inline
fn find_local_at(fl: Local, frest: List<Local>, fname: List<usize>) -> core::option::Option<Local> {
    if (same_text(fl.name, fname)) {
        return Some(fl);
    }
    return find_local(frest, fname);
}

// The innermost local with this id.
pub fn find_local_id(scope: List<Local>, id: usize) -> core::option::Option<Local> {
    return match (scope) {
        Nil -> None,
        Cons(l, rest) -> find_local_id_at(l, unbox(rest), id),
    };
}

// extract: inline
fn find_local_id_at(il: Local, irest: List<Local>, iid: usize) -> core::option::Option<Local> {
    if (il.id == iid) {
        return Some(il);
    }
    return find_local_id(irest, iid);
}

// A primary `name` (ident -> path ident_plain) or `self`: a local.
pub fn local_of(env: FrontEnv, scope: List<Local>, c: CTree) -> core::option::Option<Local> {
    if (node_prod(c) == p_ident() && node_prod(kid(c, 1)) == p_ident_plain()) {
        return match (path_name(kid(c, 0))) {
            None -> None,
            Some(name) -> find_local(scope, name),
        };
    }
    if (node_prod(c) == p_self_value()) {
        return find_local(scope, text_self());
    }
    return None;
}

// No local in scope has the id: each binding's id is its own, so a local
// found by name and one found by its id are the same.
pub fn fresh_id(scope: List<Local>, id: usize) -> bool {
    return match (scope) {
        Nil -> true,
        Cons(l, rest) -> l.id != id && fresh_id(unbox(rest), id),
    };
}

pub fn local_expr(l: core::option::Option<Local>) -> core::option::Option<SrcExpr> {
    return match (l) {
        None -> None,
        Some(x) -> Some(Local(x.id)),
    };
}

pub fn field_in(entry: core::option::Option<TypeDecl>, name: List<usize>) -> core::option::Option<usize> {
    return match (entry) {
        None -> None,
        Some(e) -> position(e.fields, name, 0),
    };
}

// The field index of member in the struct type t.
pub fn field_index(env: FrontEnv, t: Ty, name: List<usize>) -> core::option::Option<usize> {
    return match (t) {
        TyI32 -> None,
        TyBool -> None,
        TyUint(k) -> None,
        TyPtr -> None,
        TyIsize -> None,
        TyChar -> None,
        TySlice(e) -> None,
        TyNamed(d, args) -> field_in(get(env.decls.types, d), name),
        TySint(k) -> None,
    };
}

pub fn field_expr(id: usize, index: core::option::Option<usize>) -> core::option::Option<SrcExpr> {
    return match (index) {
        None -> None,
        Some(j) -> Some(Field(id, j)),
    };
}

// `primary.member`: a field of a struct local.
pub fn member_of(env: FrontEnv, scope: List<Local>, primary: CTree, tail: CTree) -> core::option::Option<SrcExpr> {
    if (node_prod(kid(tail, 2)) == p_member_type_args_none() && node_prod(kid(tail, 3)) == p_postfix_end()) {
        return match (local_of(env, scope, primary)) {
            None -> None,
            Some(l) -> field_expr(l.id, field_index(env, l.ty, kid_token(tail, 1).text)),
        };
    }
    return None;
}

pub fn scalar_of(t: core::option::Option<Ty>) -> core::option::Option<SrcType> {
    return match (t) {
        None -> None,
        Some(x) -> scalar_src(x),
    };
}

pub fn named_scalar(fuel: usize, env: FrontEnv, name: List<usize>) -> core::option::Option<SrcType> {
    return match (param_ty(env, name)) {
        Some(t) -> scalar_src(t),
        None -> match (prim_ty(name)) {
            None -> scalar_of(alias_ty(fuel, env, single(name), Some(empty()))),
            Some(t) -> scalar_src(t),
        },
    };
}

// The type a cast names (cast_type -> one segment): a primitive type, a
// type parameter standing for one, or a type alias of the module naming one.
pub fn cast_type_of(fuel: usize, env: FrontEnv, t: CTree) -> core::option::Option<SrcType> {
    let path: CTree = kid(t, 0);
    if (node_prod(t) == p_cast_type_name() && node_prod(path) == p_cast_type_path() && node_prod(kid(path, 0)) == p_cast_type_path_ident() && node_prod(kid(path, 1)) == p_cast_type_path_end()) {
        return named_scalar(fuel, env, kid_token(kid(path, 0), 0).text);
    }
    return None;
}

pub fn cast_value(ty: SrcType, e: core::option::Option<SrcExpr>) -> core::option::Option<SrcExpr> {
    return match (e) {
        None -> None,
        Some(x) -> Some(Cast(ty, boxed(x))),
    };
}

pub fn cast_into(t: core::option::Option<SrcType>, e: core::option::Option<SrcExpr>) -> core::option::Option<SrcExpr> {
    return match (t) {
        None -> None,
        Some(ty) -> cast_value(ty, e),
    };
}

// `acc as T as U ...`: casts apply left to right.
pub fn casts(fuel: usize, env: FrontEnv, acc: core::option::Option<SrcExpr>, tail: CTree) -> core::option::Option<SrcExpr> {
    if (fuel == 0) {
        return None;
    }
    if (has_kids(tail)) {
        return casts(minus(fuel, 1), env, cast_into(cast_type_of(fuel, env, kid(tail, 1)), acc), kid(tail, 2));
    }
    return acc;
}

pub fn apply_of(op: SrcOp, left: SrcExpr, right: core::option::Option<SrcExpr>) -> core::option::Option<SrcExpr> {
    return match (right) {
        None -> None,
        Some(r) -> Some(Apply(op, boxed(left), boxed(r))),
    };
}

pub fn uint_mask(u: UintTy) -> u64 {
    return match (u) {
        Uint8 -> 255,
        Uint32 -> 4294967295,
        Uint64 -> 18446744073709551615,
        Usize -> 18446744073709551615,
        Uint16 -> 65535,
    };
}

pub fn uint_in_range(u: UintTy, v: u64) -> core::option::Option<SrcExpr> {
    if (v <= uint_mask(u)) {
        return Some(Unsigned(u, v));
    }
    return None;
}

pub fn negated_int(x: SrcExpr, e: SrcExpr) -> core::option::Option<SrcExpr> {
    return match (x) {
        Int(k) -> Some(e),
        Boolean(b) -> None,
        Unsigned(u, k) -> None,
        Local(id) -> None,
        Field(id, j) -> None,
        Negate(y) -> None,
        Not(y) -> None,
        Apply(op, a, b) -> None,
        Cast(t, y) -> None,
        Null -> None,
        SrcExpr::Char(code) -> None,
    };
}

// A ptr constant's value: `0`, the null pointer.
pub fn null_const(k: i32) -> core::option::Option<SrcExpr> {
    if ((k as u32) == 0) {
        return Some(Null);
    }
    return None;
}

// Whether an i32 value is in the range of the signed type as wide as u:
// its 32 bits at most 2^(w-1) - 1, or at least 2^32 - 2^(w-1).
pub fn sint_fits(u: UintTy, k: i32) -> bool {
    return match (u) {
        Uint8 -> (((k as u32) as usize) <= 127) || (((k as u32) as usize) >= 4294967168),
        Uint32 -> true,
        Uint64 -> true,
        Usize -> true,
        Uint16 -> (((k as u32) as usize) <= 32767) || (((k as u32) as usize) >= 4294934528),
    };
}

// The 64-bit signed types; the others are held as i32.
pub fn sint_wide(u: UintTy) -> bool {
    return match (u) {
        Uint8 -> false,
        Uint32 -> false,
        Uint64 -> true,
        Usize -> true,
        Uint16 -> false,
    };
}

// A signed constant: the cast of the i32 literal k, when the type holds it.
pub fn sint_const(u: UintTy, k: i32) -> core::option::Option<SrcExpr> {
    if (sint_fits(u, k)) {
        return Some(Cast(Sint(u), boxed(Int(k))));
    }
    return None;
}

// `-k` as a signed constant.
pub fn neg_sint_const(u: UintTy, x: SrcExpr) -> core::option::Option<SrcExpr> {
    return match (x) {
        Int(k) -> sint_const(u, 0 - k),
        Boolean(b) -> None,
        Unsigned(v, k) -> None,
        Local(id) -> None,
        Field(id, j) -> None,
        Negate(y) -> None,
        Not(y) -> None,
        Apply(op, a, b) -> None,
        Cast(t, y) -> None,
        Null -> None,
        SrcExpr::Char(code) -> None,
    };
}

// A constant's value: a literal of its type. An integer literal of an
// unsigned type is that type's literal.
pub fn typed_literal(t: Ty, e: SrcExpr) -> core::option::Option<SrcExpr> {
    return match (e) {
        Int(k) -> match (t) {
            TyI32 -> Some(e),
            TyBool -> None,
            TyUint(u) -> uint_in_range(u, (k as u32) as u64),
            TyPtr -> null_const(k),
            TyIsize -> Some(Cast(Isize, boxed(e))),
            TyChar -> None,
            TySlice(x) -> None,
            TyNamed(d, args) -> None,
            TySint(u) -> sint_const(u, k),
        },
        Boolean(b) -> match (t) {
            TyI32 -> None,
            TyBool -> Some(e),
            TyUint(u) -> None,
            TyPtr -> None,
            TyIsize -> None,
            TyChar -> None,
            TySlice(x) -> None,
            TyNamed(d, args) -> None,
            TySint(u) -> None,
        },
        Unsigned(u, k) -> None,
        Local(id) -> None,
        Field(id, j) -> None,
        Negate(x) -> match (t) {
            TyI32 -> negated_int(unbox(x), e),
            TyBool -> None,
            TyUint(u) -> None,
            TyPtr -> None,
            TyIsize -> negated_int(unbox(x), Negate(boxed(Cast(Isize, x)))),
            TyChar -> None,
            TySlice(y) -> None,
            TyNamed(d, args) -> None,
            TySint(u) -> neg_sint_const(u, unbox(x)),
        },
        Not(x) -> None,
        Apply(op, a, b) -> None,
        Cast(s, x) -> None,
        Null -> None,
        SrcExpr::Char(code) -> match (t) {
            TyI32 -> None,
            TyBool -> None,
            TyUint(u) -> None,
            TyPtr -> None,
            TyIsize -> None,
            TyChar -> Some(e),
            TySlice(x) -> None,
            TyNamed(d, args) -> None,
            TySint(u) -> None,
        },
    };
}

pub fn literal_as(t: core::option::Option<Ty>, e: core::option::Option<SrcExpr>) -> core::option::Option<SrcExpr> {
    return match (t) {
        None -> None,
        Some(ty) -> match (e) {
            None -> None,
            Some(x) -> typed_literal(ty, x),
        },
    };
}

// extract: mutual begin
pub fn tree_tokens(t: CTree) -> List<Token> {
    return match (t) {
        Leaf(x) -> single(x),
        Node(p, kids) -> trees_tokens(unbox(kids)),
    };
}

pub fn trees_tokens(ts: List<CTree>) -> List<Token> {
    return match (ts) {
        Nil -> empty(),
        Cons(t, rest) -> concat(tree_tokens(t), trees_tokens(unbox(rest))),
    };
}
// extract: mutual end

pub fn wide_i32(negative: bool, n: usize) -> core::option::Option<SrcExpr> {
    if (negative && n == 2147483648) {
        return Some(Int(n as i32));
    }
    return None;
}

pub fn wide_uint(u: UintTy, negative: bool, n: usize) -> core::option::Option<SrcExpr> {
    if (!negative && n <= 18446744073709551615) {
        return uint_in_range(u, n as u64);
    }
    return None;
}

pub fn wide_isize(negative: bool, n: usize) -> core::option::Option<SrcExpr> {
    if (!negative && n <= 9223372036854775807) {
        return Some(Cast(Isize, boxed(Unsigned(Uint64, n as u64))));
    }
    if (negative && n <= 9223372036854775808) {
        return Some(Cast(Isize, boxed(Unsigned(Uint64, plus(minus(18446744073709551615, n), 1) as u64))));
    }
    return None;
}

// A wide literal of a 64-bit signed type: the cast of the u64 literal of its
// two's complement bits.
pub fn wide_sint(u: UintTy, negative: bool, n: usize) -> core::option::Option<SrcExpr> {
    if (!sint_wide(u)) {
        return None;
    }
    if (!negative && n <= 9223372036854775807) {
        return Some(Cast(Sint(u), boxed(Unsigned(Uint64, n as u64))));
    }
    if (negative && n <= 9223372036854775808) {
        return Some(Cast(Sint(u), boxed(Unsigned(Uint64, plus(minus(18446744073709551615, n), 1) as u64))));
    }
    return None;
}

pub fn wide_of(ty: Ty, negative: bool, n: usize) -> core::option::Option<SrcExpr> {
    return match (ty) {
        TyI32 -> wide_i32(negative, n),
        TyBool -> None,
        TyUint(u) -> wide_uint(u, negative, n),
        TyPtr -> None,
        TyIsize -> wide_isize(negative, n),
        TyChar -> None,
        TySlice(e) -> None,
        TyNamed(d, args) -> None,
        TySint(u) -> wide_sint(u, negative, n),
    };
}

pub fn wide_digits(ty: Ty, negative: bool, v: core::option::Option<usize>) -> core::option::Option<SrcExpr> {
    return match (v) {
        None -> None,
        Some(n) -> wide_of(ty, negative, n),
    };
}

pub fn wide_signed(ty: Ty, minus_sign: bool, v: core::option::Option<usize>) -> core::option::Option<SrcExpr> {
    if (minus_sign) {
        return wide_digits(ty, true, v);
    }
    return None;
}

// The text of `-`.
fn dash_text() -> List<usize> {
    let t: List<usize> = single(45);
    return t;
}

pub fn wide_const(t: core::option::Option<Ty>, toks: List<Token>) -> core::option::Option<SrcExpr> {
    return match (t) {
        None -> None,
        Some(ty) -> match (toks) {
            Nil -> None,
            Cons(a, rest) -> match (unbox(rest)) {
                Nil -> wide_digits(ty, false, wide_decimal(a.text, 0)),
                Cons(b, more) -> match (unbox(more)) {
                    Nil -> wide_signed(ty, same_text(a.text, dash_text()), wide_decimal(b.text, 0)),
                    Cons(c, tail) -> None,
                },
            },
        },
    };
}

// extract: mutual begin
// The expression a node of the expression grammar denotes. Calls, struct
// literals and match are statement forms, so they are not expressions here.
pub fn expr_of(fuel: usize, env: FrontEnv, scope: List<Local>, c: CTree) -> core::option::Option<SrcExpr> {
    if (fuel == 0) {
        return None;
    }
    let f: usize = minus(fuel, 1);
    let p: usize = node_prod(c);
    if (p == p_expr() || p == p_base()) {
        return expr_of(f, env, scope, kid(c, 0));
    }
    if (p == p_assign()) {
        return assign_value(f, env, scope, c);
    }
    if (is_level(p)) {
        return fold(f, env, scope, expr_of(f, env, scope, kid(c, 0)), kid(c, 1));
    }
    if (p == p_cast()) {
        return casts(f, env, expr_of(f, env, scope, kid(c, 0)), kid(c, 1));
    }
    if (p == p_neg()) {
        return negated(expr_of(f, env, scope, kid(c, 1)));
    }
    if (p == p_not()) {
        return notted(expr_of(f, env, scope, kid(c, 1)));
    }
    if (p == p_postfix()) {
        return postfix_value(f, env, scope, kid(c, 0), kid(c, 1));
    }
    if (p == p_group()) {
        return expr_of(f, env, scope, kid(c, 1));
    }
    if (p == p_ident()) {
        return ident_expr(f, env, scope, c);
    }
    if (p == p_self_value()) {
        return local_expr(local_of(env, scope, c));
    }
    if (p == p_int()) {
        return int_literal(kid_token(c, 0).text);
    }
    if (p == p_true()) {
        return Some(Boolean(true));
    }
    if (p == p_false()) {
        return Some(Boolean(false));
    }
    if (p == p_char()) {
        return char_literal(kid_token(c, 0).text);
    }
    return None;
}

// A name: a local, or else a constant, whose literal value it is.
pub fn ident_expr(fuel: usize, env: FrontEnv, scope: List<Local>, c: CTree) -> core::option::Option<SrcExpr> {
    if (fuel == 0) {
        return None;
    }
    let path: CTree = kid(c, 0);
    if (node_prod(kid(c, 1)) == p_ident_plain()) {
        return match (local_of(env, scope, c)) {
            Some(l) -> Some(Local(l.id)),
            None -> const_ref(minus(fuel, 1), env, path_spellings(fuel, kid(path, 0), kid(path, 1))),
        };
    }
    return None;
}

pub fn const_ref(fuel: usize, env: FrontEnv, segments: core::option::Option<List<List<usize>>>) -> core::option::Option<SrcExpr> {
    if (fuel == 0) {
        return None;
    }
    return match (segments) {
        None -> None,
        Some(ss) -> match (split_last(ss)) {
            None -> None,
            Some(s) -> match (find_const(env.decls.consts, module_or(env.home, s.home), s.name)) {
                None -> None,
                Some(k) -> const_value(minus(fuel, 1), env.decls, k),
            },
        },
    };
}

pub fn wide_inner(t: SrcType, x: SrcExpr) -> core::option::Option<u64> {
    if (unit_ty(t)) {
        return match (x) {
            Int(k) -> None,
            Boolean(b) -> None,
            Unsigned(u, k) -> Some(k),
            Local(id) -> None,
            Field(id, j) -> None,
            Negate(y) -> None,
            Not(y) -> None,
            Apply(op, a, b) -> None,
            Cast(s, y) -> None,
            Null -> None,
            SrcExpr::Char(code) -> None,
        };
    }
    return None;
}

// The literal a wide marker holds, if e is one.
pub fn wide_value(e: SrcExpr) -> core::option::Option<u64> {
    return match (e) {
        Int(k) -> None,
        Boolean(b) -> None,
        Unsigned(u, k) -> None,
        Local(id) -> None,
        Field(id, j) -> None,
        Negate(x) -> None,
        Not(x) -> None,
        Apply(op, a, b) -> None,
        Cast(t, x) -> wide_inner(t, unbox(x)),
        Null -> None,
        SrcExpr::Char(code) -> None,
    };
}

pub fn has_wide(v: core::option::Option<u64>) -> bool {
    return match (v) {
        None -> false,
        Some(n) -> true,
    };
}

// Whether e is a wide literal (wide_value) or the negation of one.
pub fn wide_read(e: SrcExpr) -> bool {
    return match (e) {
        Int(k) -> false,
        Boolean(b) -> false,
        Unsigned(u, k) -> false,
        Local(id) -> false,
        Field(id, j) -> false,
        Negate(x) -> has_wide(wide_value(unbox(x))),
        Not(x) -> false,
        Apply(op, a, b) -> false,
        Cast(t, x) -> has_wide(wide_inner(t, unbox(x))),
        Null -> false,
        SrcExpr::Char(code) -> false,
    };
}

pub fn wide_read_of(v: core::option::Option<SrcExpr>) -> bool {
    return match (v) {
        None -> false,
        Some(x) -> wide_read(x),
    };
}

// A constant's value, read in its own module: a literal of its type. A
// value that reads as a wide literal n, or `-` and n (n of 2^31 or more),
// is the declared type's literal of its tokens' value: Int for i32 (only
// -2^31), Unsigned up to the type's largest value, and for isize the cast of
// the u64 literal holding its two's complement bits.
pub fn const_value(fuel: usize, decls: Decls, k: ConstDecl) -> core::option::Option<SrcExpr> {
    if (fuel == 0) {
        return None;
    }
    let cenv: FrontEnv = decl_env(decls, k.home, empty(), empty());
    let v: core::option::Option<SrcExpr> = expr_of(minus(fuel, 1), cenv, empty(), k.value);
    if (wide_read_of(v)) {
        return wide_const(ty_of(minus(fuel, 1), cenv, k.ty), tree_tokens(k.value));
    }
    return literal_as(ty_of(minus(fuel, 1), cenv, k.ty), v);
}

// assign -> orexpr assign_end, as a value.
pub fn assign_value(fuel: usize, env: FrontEnv, scope: List<Local>, c: CTree) -> core::option::Option<SrcExpr> {
    if (fuel == 0) {
        return None;
    }
    if (node_prod(kid(c, 1)) == p_assign_end()) {
        return expr_of(minus(fuel, 1), env, scope, kid(c, 0));
    }
    return None;
}

// postfix -> primary postfix_tail, as a value: the primary, or a field.
pub fn postfix_value(fuel: usize, env: FrontEnv, scope: List<Local>, primary: CTree, tail: CTree) -> core::option::Option<SrcExpr> {
    if (fuel == 0) {
        return None;
    }
    if (node_prod(tail) == p_postfix_end()) {
        return expr_of(minus(fuel, 1), env, scope, primary);
    }
    if (node_prod(tail) == p_postfix_member()) {
        return member_of(env, scope, primary, tail);
    }
    return None;
}

// acc op operand op operand ...: binary operators apply left to right.
pub fn fold(fuel: usize, env: FrontEnv, scope: List<Local>, acc: core::option::Option<SrcExpr>, tail: CTree) -> core::option::Option<SrcExpr> {
    if (fuel == 0) {
        return None;
    }
    if (has_kids(tail)) {
        return fold_op(minus(fuel, 1), env, scope, acc, tail_op(node_prod(tail)), tail);
    }
    return acc;
}

pub fn fold_op(fuel: usize, env: FrontEnv, scope: List<Local>, acc: core::option::Option<SrcExpr>, op: core::option::Option<SrcOp>, tail: CTree) -> core::option::Option<SrcExpr> {
    if (fuel == 0) {
        return None;
    }
    return match (acc) {
        None -> None,
        Some(left) -> fold_left(minus(fuel, 1), env, scope, left, op, tail),
    };
}

pub fn fold_left(fuel: usize, env: FrontEnv, scope: List<Local>, left: SrcExpr, op: core::option::Option<SrcOp>, tail: CTree) -> core::option::Option<SrcExpr> {
    if (fuel == 0) {
        return None;
    }
    return match (op) {
        None -> None,
        Some(o) -> fold(minus(fuel, 1), env, scope, apply_of(o, left, expr_of(minus(fuel, 1), env, scope, kid(tail, 1))), kid(tail, 2)),
    };
}
// extract: mutual end

// The postfix node an expression is, when no operator, cast or assignment
// applies on the way down.
pub fn peel(fuel: usize, c: CTree) -> core::option::Option<CTree> {
    if (fuel == 0) {
        return None;
    }
    let p: usize = node_prod(c);
    if (p == p_expr() || p == p_base()) {
        return peel(minus(fuel, 1), kid(c, 0));
    }
    if ((p == p_assign() || is_level(p) || p == p_cast()) && !has_kids(kid(c, 1))) {
        return peel(minus(fuel, 1), kid(c, 0));
    }
    if (p == p_postfix()) {
        return Some(c);
    }
    return None;
}

// ---------------------------------------------------------------- expression types

// Comparisons and logical operators give bool; the others their operand's
// type (a pointer plus an offset is a pointer).
pub fn gives_bool(op: SrcOp) -> bool {
    return match (op) {
        Plus -> false,
        Minus -> false,
        Times -> false,
        BitAnd -> false,
        BitOr -> false,
        BitXor -> false,
        ShiftLeft -> false,
        ShiftRight -> false,
        Less -> true,
        LessEq -> true,
        Greater -> true,
        GreaterEq -> true,
        Equal -> true,
        NotEqual -> true,
        LogicalAnd -> true,
        LogicalOr -> true,
    };
}

pub fn shift_op(op: SrcOp) -> bool {
    return match (op) {
        Plus -> false,
        Minus -> false,
        Times -> false,
        BitAnd -> false,
        BitOr -> false,
        BitXor -> false,
        ShiftLeft -> true,
        ShiftRight -> true,
        Less -> false,
        LessEq -> false,
        Greater -> false,
        GreaterEq -> false,
        Equal -> false,
        NotEqual -> false,
        LogicalAnd -> false,
        LogicalOr -> false,
    };
}

pub fn apply_ty(op: SrcOp, left: core::option::Option<Ty>) -> core::option::Option<Ty> {
    if (gives_bool(op)) {
        return Some(TyBool);
    }
    return left;
}

pub fn local_ty(l: core::option::Option<Local>) -> core::option::Option<Ty> {
    return match (l) {
        None -> None,
        Some(x) -> Some(x.ty),
    };
}

pub fn struct_field_tys(fuel: usize, decls: Decls, t: Ty) -> core::option::Option<List<Ty>> {
    return match (t) {
        TyI32 -> None,
        TyBool -> None,
        TyUint(k) -> None,
        TyPtr -> None,
        TyIsize -> None,
        TyChar -> None,
        TySlice(e) -> None,
        TyNamed(d, args) -> field_tys(fuel, decls, d, unbox(args)),
        TySint(k) -> None,
    };
}

pub fn field_ty(fuel: usize, decls: Decls, l: core::option::Option<Local>, j: usize) -> core::option::Option<Ty> {
    return match (l) {
        None -> None,
        Some(x) -> match (struct_field_tys(fuel, decls, x.ty)) {
            None -> None,
            Some(ts) -> get(ts, j),
        },
    };
}

// An integer literal, or arithmetic of them: its type comes from its
// context (an isize literal is written bare beside a typed operand), so an
// operator's type is its other operand's.
pub fn bare_int(e: SrcExpr) -> bool {
    return match (e) {
        Int(k) -> true,
        Boolean(b) -> false,
        Unsigned(u, k) -> false,
        Local(id) -> false,
        Field(id, j) -> false,
        Negate(x) -> bare_int(unbox(x)),
        Not(x) -> false,
        Apply(op, a, b) -> !gives_bool(op) && bare_int(unbox(a)) && bare_int(unbox(b)),
        Cast(t, x) -> unit_ty(t),
        Null -> false,
        SrcExpr::Char(code) -> false,
    };
}

pub fn pick_ty(left_bare: bool, a: core::option::Option<Ty>, b: core::option::Option<Ty>) -> core::option::Option<Ty> {
    if (left_bare) {
        return b;
    }
    return a;
}

// The type of an expression, as type arguments are inferred from it.
pub fn expr_ty(fuel: usize, env: FrontEnv, scope: List<Local>, e: SrcExpr) -> core::option::Option<Ty> {
    if (fuel == 0) {
        return None;
    }
    return match (e) {
        Int(k) -> Some(TyI32),
        Boolean(b) -> Some(TyBool),
        Unsigned(u, k) -> Some(TyUint(u)),
        Local(id) -> local_ty(find_local_id(scope, id)),
        Field(id, j) -> field_ty(fuel, env.decls, find_local_id(scope, id), j),
        Negate(x) -> expr_ty(minus(fuel, 1), env, scope, unbox(x)),
        Not(x) -> Some(TyBool),
        Apply(op, a, b) -> apply_ty(op, pick_ty(bare_int(unbox(a)), expr_ty(minus(fuel, 1), env, scope, unbox(a)), expr_ty(minus(fuel, 1), env, scope, unbox(b)))),
        Cast(t, x) -> src_ty(t),
        Null -> Some(TyPtr),
        SrcExpr::Char(code) -> None,
    };
}

pub fn exprs_tys(fuel: usize, env: FrontEnv, scope: List<Local>, es: List<SrcExpr>) -> core::option::Option<List<Ty>> {
    return match (es) {
        Nil -> Some(empty()),
        Cons(e, rest) -> cons_ty(expr_ty(fuel, env, scope, e), exprs_tys(fuel, env, scope, unbox(rest))),
    };
}

// ---------------------------------------------------------------- type arguments

// A type parameter's inferred type.
pub struct Bind {
    name: List<usize>,
    ty: Ty,
}

pub fn find_bind(binds: List<Bind>, name: List<usize>) -> core::option::Option<Ty> {
    return match (binds) {
        Nil -> None,
        Cons(b, rest) -> find_bind_at(b, unbox(rest), name),
    };
}

// extract: inline
fn find_bind_at(bb: Bind, brest: List<Bind>, bname: List<usize>) -> core::option::Option<Ty> {
    if (same_text(bb.name, bname)) {
        return Some(bb.ty);
    }
    return find_bind(brest, bname);
}

pub fn same_or_none(ok: bool, binds: List<Bind>) -> core::option::Option<List<Bind>> {
    if (ok) {
        return Some(binds);
    }
    return None;
}

// The parameter spelled name stands for actual: a new binding, or the same
// type as before.
pub fn bind_ty(binds: List<Bind>, name: List<usize>, actual: Ty) -> core::option::Option<List<Bind>> {
    return match (find_bind(binds, name)) {
        None -> Some(cons(Bind { name: name, ty: actual }, binds)),
        Some(t) -> same_or_none(same_ty(t, actual), binds),
    };
}

pub fn param_named(ok: bool, n: List<usize>) -> core::option::Option<List<usize>> {
    if (ok) {
        return Some(n);
    }
    return None;
}

// A pattern that is one of the type parameters being inferred.
pub fn param_spelling(names: List<List<usize>>, segments: List<List<usize>>, items: List<CTree>) -> core::option::Option<List<usize>> {
    return match (single_name(segments)) {
        None -> None,
        Some(n) -> param_named(member(names, n) && no_trees(items), n),
    };
}

pub fn prim_if(ok: bool, n: List<usize>) -> core::option::Option<Ty> {
    if (ok) {
        return prim_ty(n);
    }
    return None;
}

// A pattern that is a primitive type.
pub fn bare_prim(segments: List<List<usize>>, items: List<CTree>) -> core::option::Option<Ty> {
    return match (single_name(segments)) {
        None -> None,
        Some(n) -> prim_if(no_trees(items), n),
    };
}

pub fn slice_elem(t: Ty) -> core::option::Option<Ty> {
    return match (t) {
        TyI32 -> None,
        TyBool -> None,
        TyUint(k) -> None,
        TyPtr -> None,
        TyIsize -> None,
        TyChar -> None,
        TySlice(e) -> Some(unbox(e)),
        TyNamed(d, args) -> None,
        TySint(k) -> None,
    };
}

pub fn named_parts(t: Ty) -> core::option::Option<Inst> {
    return match (t) {
        TyI32 -> None,
        TyBool -> None,
        TyUint(k) -> None,
        TyPtr -> None,
        TyIsize -> None,
        TyChar -> None,
        TySlice(e) -> None,
        TyNamed(d, args) -> Some(Inst { decl: d, args: unbox(args) }),
        TySint(k) -> None,
    };
}

// extract: mutual begin
// Match a type expression of a declaration, whose type parameters names are
// being inferred, against an actual type, extending binds.
pub fn match_ty(fuel: usize, env: FrontEnv, names: List<List<usize>>, pattern: CTree, actual: Ty, binds: List<Bind>) -> core::option::Option<List<Bind>> {
    if (fuel == 0) {
        return None;
    }
    let f: usize = minus(fuel, 1);
    let path: CTree = kid(pattern, 0);
    if (node_prod(pattern) == p_type_array() && node_prod(kid(pattern, 2)) == p_type_slice_tail()) {
        return match (slice_elem(actual)) {
            None -> None,
            Some(a) -> match_ty(f, env, names, kid(pattern, 1), a, binds),
        };
    }
    if (node_prod(pattern) == p_type_ident()) {
        return match_path(f, env, names, type_path_spellings(f, kid(path, 0), kid(path, 1)), list_items(f, kid(pattern, 1)), actual, binds);
    }
    return None;
}

pub fn match_path(fuel: usize, env: FrontEnv, names: List<List<usize>>, segments: core::option::Option<List<List<usize>>>, items: core::option::Option<List<CTree>>, actual: Ty, binds: List<Bind>) -> core::option::Option<List<Bind>> {
    if (fuel == 0) {
        return None;
    }
    return match (segments) {
        None -> None,
        Some(ss) -> match (items) {
            None -> None,
            Some(gs) -> match_named(minus(fuel, 1), env, names, ss, gs, actual, binds),
        },
    };
}

pub fn match_named(fuel: usize, env: FrontEnv, names: List<List<usize>>, segments: List<List<usize>>, items: List<CTree>, actual: Ty, binds: List<Bind>) -> core::option::Option<List<Bind>> {
    if (fuel == 0) {
        return None;
    }
    return match (param_spelling(names, segments, items)) {
        Some(n) -> bind_ty(binds, n, actual),
        None -> match (bare_prim(segments, items)) {
            Some(t) -> same_or_none(same_ty(t, actual), binds),
            None -> match_decl(minus(fuel, 1), env, names, type_decl_at(env, segments), items, named_parts(actual), binds),
        },
    };
}

pub fn match_decl(fuel: usize, env: FrontEnv, names: List<List<usize>>, d: core::option::Option<usize>, items: List<CTree>, actual: core::option::Option<Inst>, binds: List<Bind>) -> core::option::Option<List<Bind>> {
    if (fuel == 0) {
        return None;
    }
    return match (d) {
        None -> None,
        Some(x) -> match (actual) {
            None -> None,
            Some(a) -> match_same_decl(minus(fuel, 1), env, names, x == a.decl, items, a.args, binds),
        },
    };
}

pub fn match_same_decl(fuel: usize, env: FrontEnv, names: List<List<usize>>, same: bool, items: List<CTree>, args: List<Ty>, binds: List<Bind>) -> core::option::Option<List<Bind>> {
    if (fuel == 0) {
        return None;
    }
    if (same) {
        return match_args(minus(fuel, 1), env, names, items, args, binds);
    }
    return None;
}

// Generic arguments (generic_argument_type) against the actual arguments.
pub fn match_args(fuel: usize, env: FrontEnv, names: List<List<usize>>, items: List<CTree>, actuals: List<Ty>, binds: List<Bind>) -> core::option::Option<List<Bind>> {
    if (fuel == 0) {
        return None;
    }
    return match (items) {
        Nil -> match (actuals) {
            Nil -> Some(binds),
            Cons(a, more) -> None,
        },
        Cons(g, rest) -> match (actuals) {
            Nil -> None,
            Cons(a, more) -> match_args_next(minus(fuel, 1), env, names, unbox(rest), unbox(more), match_arg(minus(fuel, 1), env, names, g, a, binds)),
        },
    };
}

pub fn match_arg(fuel: usize, env: FrontEnv, names: List<List<usize>>, g: CTree, actual: Ty, binds: List<Bind>) -> core::option::Option<List<Bind>> {
    if (fuel == 0) {
        return None;
    }
    if (node_prod(g) == p_generic_argument_type()) {
        return match_ty(minus(fuel, 1), env, names, kid(g, 0), actual, binds);
    }
    return None;
}

pub fn match_args_next(fuel: usize, env: FrontEnv, names: List<List<usize>>, items: List<CTree>, actuals: List<Ty>, got: core::option::Option<List<Bind>>) -> core::option::Option<List<Bind>> {
    if (fuel == 0) {
        return None;
    }
    return match (got) {
        None -> None,
        Some(b) -> match_args(minus(fuel, 1), env, names, items, actuals, b),
    };
}

// Type expressions against actual types, in order.
pub fn match_tys(fuel: usize, env: FrontEnv, names: List<List<usize>>, patterns: List<CTree>, actuals: List<Ty>, binds: List<Bind>) -> core::option::Option<List<Bind>> {
    if (fuel == 0) {
        return None;
    }
    return match (patterns) {
        Nil -> match (actuals) {
            Nil -> Some(binds),
            Cons(a, more) -> None,
        },
        Cons(p, rest) -> match (actuals) {
            Nil -> None,
            Cons(a, more) -> match_tys_next(minus(fuel, 1), env, names, unbox(rest), unbox(more), match_ty(minus(fuel, 1), env, names, p, a, binds)),
        },
    };
}

pub fn match_tys_next(fuel: usize, env: FrontEnv, names: List<List<usize>>, patterns: List<CTree>, actuals: List<Ty>, got: core::option::Option<List<Bind>>) -> core::option::Option<List<Bind>> {
    if (fuel == 0) {
        return None;
    }
    return match (got) {
        None -> None,
        Some(b) -> match_tys(minus(fuel, 1), env, names, patterns, actuals, b),
    };
}
// extract: mutual end

// The inferred arguments, in the order of the parameters.
pub fn bound_args(names: List<List<usize>>, binds: List<Bind>) -> core::option::Option<List<Ty>> {
    return match (names) {
        Nil -> Some(empty()),
        Cons(n, rest) -> cons_ty(find_bind(binds, n), bound_args(unbox(rest), binds)),
    };
}

pub fn cons_tree_tail(t: CTree, rest: core::option::Option<List<CTree>>) -> core::option::Option<List<CTree>> {
    return match (rest) {
        None -> None,
        Some(ts) -> Some(cons(t, ts)),
    };
}

pub fn cons_tree(t: core::option::Option<CTree>, rest: core::option::Option<List<CTree>>) -> core::option::Option<List<CTree>> {
    return match (t) {
        None -> None,
        Some(x) -> cons_tree_tail(x, rest),
    };
}

// The declared type of a parameter: `name: T`, `self` (the impl's type),
// `&self` (the impl's type: a shared reference is read as the value) or
// `self: T`.
pub fn pattern_of(fd: FnDecl, p: CTree) -> core::option::Option<CTree> {
    let tail: CTree = kid(p, 1);
    if (node_prod(p) == p_param_named()) {
        return Some(kid(p, 2));
    }
    if (node_prod(p) == p_param_self() && node_prod(tail) == p_self_param_plain() && fd.in_impl) {
        return Some(fd.self_type);
    }
    if (node_prod(p) == p_param_self_ref() && fd.in_impl) {
        return Some(fd.self_type);
    }
    if (node_prod(p) == p_param_self() && node_prod(tail) == p_self_param_typed()) {
        return Some(kid(tail, 1));
    }
    return None;
}

pub fn patterns_of(fd: FnDecl, items: List<CTree>) -> core::option::Option<List<CTree>> {
    return match (items) {
        Nil -> Some(empty()),
        Cons(p, rest) -> cons_tree(pattern_of(fd, p), patterns_of(fd, unbox(rest))),
    };
}

pub fn param_patterns(fuel: usize, fd: FnDecl) -> core::option::Option<List<CTree>> {
    return match (list_items(fuel, kid(fd.tree, 4))) {
        None -> None,
        Some(items) -> patterns_of(fd, items),
    };
}

pub fn ret_pattern(fd: FnDecl) -> core::option::Option<CTree> {
    let ret: CTree = kid(fd.tree, 6);
    if (node_prod(ret) == p_ret_type()) {
        return Some(kid(ret, 1));
    }
    return None;
}

pub fn callee_env(decls: Decls, fd: FnDecl) -> FrontEnv {
    return decl_env(decls, fd.home, empty(), empty());
}

pub fn inst_from(d: usize, args: core::option::Option<List<Ty>>) -> core::option::Option<Inst> {
    return match (args) {
        None -> None,
        Some(ts) -> Some(Inst { decl: d, args: ts }),
    };
}

pub fn bound_or_none(names: List<List<usize>>, binds: core::option::Option<List<Bind>>) -> core::option::Option<List<Ty>> {
    return match (binds) {
        None -> None,
        Some(b) -> bound_args(names, b),
    };
}

pub fn infer_ret(fuel: usize, decls: Decls, d: usize, fd: FnDecl, names: List<List<usize>>, binds: core::option::Option<List<Bind>>, expected: Ty) -> core::option::Option<Inst> {
    return match (binds) {
        None -> None,
        Some(b) -> match (ret_pattern(fd)) {
            None -> None,
            Some(r) -> inst_from(d, bound_or_none(names, match_ty(fuel, callee_env(decls, fd), names, r, expected, b))),
        },
    };
}

// The instance a call of function d means: its type arguments are inferred
// by matching its parameter types with the argument types and its result
// type with the type the call's value is stored at, starting from start.
pub fn infer_inst(fuel: usize, decls: Decls, d: usize, fd: FnDecl, start: List<Bind>, arg_tys: core::option::Option<List<Ty>>, expected: Ty) -> core::option::Option<Inst> {
    let names: List<List<usize>> = concat(fd.impl_params, fd.params);
    if (no_names(names)) {
        return Some(Inst { decl: d, args: empty() });
    }
    return match (arg_tys) {
        None -> None,
        Some(ts) -> match (param_patterns(fuel, fd)) {
            None -> None,
            Some(ps) -> infer_ret(fuel, decls, d, fd, names, match_tys(fuel, callee_env(decls, fd), names, ps, ts, start), expected),
        },
    };
}

pub fn explicit_checked(ok: bool, d: usize, args: List<Ty>) -> core::option::Option<Inst> {
    if (ok) {
        return Some(Inst { decl: d, args: args });
    }
    return None;
}

// `f<T, ...>(args)`: the type arguments as written (a free function's own).
pub fn explicit_inst(fuel: usize, env: FrontEnv, d: usize, fd: FnDecl, targs: List<CTree>) -> core::option::Option<Inst> {
    return match (args_tys(fuel, env, targs)) {
        None -> None,
        Some(ts) -> explicit_checked(no_names(fd.impl_params) && length(ts) == length(fd.params), d, ts),
    };
}

// Whether a type expression matches an actual type, as match_ty decides
// it, with a mismatch told apart from running out of fuel: a method's impl
// is passed over only when its type does not match.
pub enum Fit {
    Fits(List<Bind>),
    Misfit,
    Spent,
}

pub fn fit_of(b: core::option::Option<List<Bind>>) -> Fit {
    return match (b) {
        None -> Misfit,
        Some(x) -> Fits(x),
    };
}

pub fn fit_if(ok: bool, binds: List<Bind>) -> Fit {
    if (ok) {
        return Fits(binds);
    }
    return Misfit;
}

// extract: mutual begin
pub fn fit_ty(fuel: usize, env: FrontEnv, names: List<List<usize>>, pattern: CTree, actual: Ty, binds: List<Bind>) -> Fit {
    if (fuel == 0) {
        return Spent;
    }
    let f: usize = minus(fuel, 1);
    let path: CTree = kid(pattern, 0);
    if (node_prod(pattern) == p_type_array() && node_prod(kid(pattern, 2)) == p_type_slice_tail()) {
        return match (slice_elem(actual)) {
            None -> Misfit,
            Some(a) -> fit_ty(f, env, names, kid(pattern, 1), a, binds),
        };
    }
    if (node_prod(pattern) == p_type_ident()) {
        return fit_path(f, env, names, type_path_spellings(f, kid(path, 0), kid(path, 1)), list_items(f, kid(pattern, 1)), actual, binds);
    }
    return Misfit;
}

pub fn fit_path(fuel: usize, env: FrontEnv, names: List<List<usize>>, segments: core::option::Option<List<List<usize>>>, items: core::option::Option<List<CTree>>, actual: Ty, binds: List<Bind>) -> Fit {
    if (fuel == 0) {
        return Spent;
    }
    return match (segments) {
        None -> Spent,
        Some(ss) -> match (items) {
            None -> Spent,
            Some(gs) -> fit_named(minus(fuel, 1), env, names, ss, gs, actual, binds),
        },
    };
}

pub fn fit_named(fuel: usize, env: FrontEnv, names: List<List<usize>>, segments: List<List<usize>>, items: List<CTree>, actual: Ty, binds: List<Bind>) -> Fit {
    if (fuel == 0) {
        return Spent;
    }
    return match (param_spelling(names, segments, items)) {
        Some(n) -> fit_of(bind_ty(binds, n, actual)),
        None -> match (bare_prim(segments, items)) {
            Some(t) -> fit_if(same_ty(t, actual), binds),
            None -> fit_decl(minus(fuel, 1), env, names, type_decl_at(env, segments), items, named_parts(actual), binds),
        },
    };
}

pub fn fit_decl(fuel: usize, env: FrontEnv, names: List<List<usize>>, d: core::option::Option<usize>, items: List<CTree>, actual: core::option::Option<Inst>, binds: List<Bind>) -> Fit {
    if (fuel == 0) {
        return Spent;
    }
    return match (d) {
        None -> Misfit,
        Some(x) -> match (actual) {
            None -> Misfit,
            Some(a) -> fit_same_decl(minus(fuel, 1), env, names, x == a.decl, items, a.args, binds),
        },
    };
}

pub fn fit_same_decl(fuel: usize, env: FrontEnv, names: List<List<usize>>, same: bool, items: List<CTree>, args: List<Ty>, binds: List<Bind>) -> Fit {
    if (fuel == 0) {
        return Spent;
    }
    if (same) {
        return fit_args(minus(fuel, 1), env, names, items, args, binds);
    }
    return Misfit;
}

pub fn fit_args(fuel: usize, env: FrontEnv, names: List<List<usize>>, items: List<CTree>, actuals: List<Ty>, binds: List<Bind>) -> Fit {
    if (fuel == 0) {
        return Spent;
    }
    return match (items) {
        Nil -> match (actuals) {
            Nil -> Fits(binds),
            Cons(a, more) -> Misfit,
        },
        Cons(g, rest) -> match (actuals) {
            Nil -> Misfit,
            Cons(a, more) -> fit_args_next(minus(fuel, 1), env, names, unbox(rest), unbox(more), fit_arg(minus(fuel, 1), env, names, g, a, binds)),
        },
    };
}

pub fn fit_arg(fuel: usize, env: FrontEnv, names: List<List<usize>>, g: CTree, actual: Ty, binds: List<Bind>) -> Fit {
    if (fuel == 0) {
        return Spent;
    }
    if (node_prod(g) == p_generic_argument_type()) {
        return fit_ty(minus(fuel, 1), env, names, kid(g, 0), actual, binds);
    }
    return Misfit;
}

pub fn fit_args_next(fuel: usize, env: FrontEnv, names: List<List<usize>>, items: List<CTree>, actuals: List<Ty>, got: Fit) -> Fit {
    if (fuel == 0) {
        return Spent;
    }
    return match (got) {
        Fits(b) -> fit_args(minus(fuel, 1), env, names, items, actuals, b),
        Misfit -> Misfit,
        Spent -> Spent,
    };
}
// extract: mutual end

// A method found for a type: its function and the impl's inferred
// parameters.
pub struct Found {
    decl: usize,
    binds: List<Bind>,
}

pub fn impl_fit(fuel: usize, decls: Decls, fd: FnDecl, s: Ty) -> Fit {
    if (fd.in_impl) {
        return fit_ty(fuel, callee_env(decls, fd), fd.impl_params, fd.self_type, s, empty());
    }
    return Misfit;
}

pub fn is_misfit(f: Fit) -> bool {
    return match (f) {
        Fits(b) -> false,
        Misfit -> true,
        Spent -> false,
    };
}

// No method spelled name has an impl whose type matches s, and no match
// ran out of fuel.
pub fn no_method(fuel: usize, decls: Decls, fns: List<FnDecl>, name: List<usize>, s: Ty) -> bool {
    return match (fns) {
        Nil -> true,
        Cons(fd, rest) -> (!same_text(fd.name, name) || is_misfit(impl_fit(fuel, decls, fd, s))) && no_method(fuel, decls, unbox(rest), name, s),
    };
}

pub fn unique_found(unique: bool, k: usize, b: List<Bind>) -> core::option::Option<Found> {
    if (unique) {
        return Some(Found { decl: k, binds: b });
    }
    return None;
}

// The one method spelled name of an impl whose type matches s.
pub fn find_method(fuel: usize, decls: Decls, fns: List<FnDecl>, k: usize, name: List<usize>, s: Ty) -> core::option::Option<Found> {
    return match (fns) {
        Nil -> None,
        Cons(fd, rest) -> find_method_at(fuel, decls, fd, unbox(rest), k, name, s),
    };
}

// extract: inline
fn find_method_at(mfuel: usize, mdecls: Decls, mfd: FnDecl, mrest: List<FnDecl>, mk: usize, mname: List<usize>, ms: Ty) -> core::option::Option<Found> {
    if (same_text(mfd.name, mname)) {
        return match (impl_fit(mfuel, mdecls, mfd, ms)) {
            Fits(b) -> unique_found(no_method(mfuel, mdecls, mrest, mname, ms), mk, b),
            Misfit -> find_method(mfuel, mdecls, mrest, plus(mk, 1), mname, ms),
            Spent -> None,
        };
    }
    return find_method(mfuel, mdecls, mrest, plus(mk, 1), mname, ms);
}

// ---------------------------------------------------------------- effectful expressions

// An expression as build reads it, when it calls a function, indexes a
// slice, divides, or is a struct literal, a variant or a match: like SrcEff,
// but types are Ty and a call names its function instance.
pub enum MEff {
    XPure(SrcExpr),
    XCall(Inst, Box<List<MEff>>),
    XApply(SrcOp, Box<MEff>, Box<MEff>),
    XNeg(Box<MEff>),
    XNot(Box<MEff>),
    XCast(SrcType, Box<MEff>),
    XIndex(usize, Box<MEff>),
    XStruct(Ty, Box<List<MEff>>),
    XVariant(Ty, usize, Box<List<MEff>>),
    // the scrutinee, its enum type, the result type, each arm's binders and value
    XMatch(Box<MEff>, Ty, Ty, List<List<usize>>, Box<List<MEff>>),
    XDivide(SrcDivOp, Box<MEff>, Box<MEff>),
    // slice_stride(x) of a slice local x
    XStride(usize),
}

// The expression, when it is pure.
pub fn pure_part(x: MEff) -> core::option::Option<SrcExpr> {
    return match (x) {
        XPure(e) -> Some(e),
        XCall(inst, args) -> None,
        XApply(op, l, r) -> None,
        XNeg(a) -> None,
        XNot(a) -> None,
        XCast(t, a) -> None,
        XIndex(s, i) -> None,
        XStruct(t, fs) -> None,
        XVariant(t, k, ps) -> None,
        XMatch(s, ety, t, bs, vs) -> None,
        XDivide(op, l, r) -> None,
        XStride(sl) -> None,
    };
}

// The operators, casts and negations of pure operands are pure.
pub fn apply_eff(op: SrcOp, l: MEff, r: MEff) -> MEff {
    return match (pure_part(l)) {
        None -> XApply(op, boxed(l), boxed(r)),
        Some(a) -> match (pure_part(r)) {
            None -> XApply(op, boxed(l), boxed(r)),
            Some(b) -> XPure(Apply(op, boxed(a), boxed(b))),
        },
    };
}

pub fn x_apply_of(op: SrcOp, l: core::option::Option<MEff>, r: core::option::Option<MEff>) -> core::option::Option<MEff> {
    return match (l) {
        None -> None,
        Some(a) -> match (r) {
            None -> None,
            Some(b) -> Some(apply_eff(op, a, b)),
        },
    };
}

pub fn x_divide_of(op: SrcDivOp, l: core::option::Option<MEff>, r: core::option::Option<MEff>) -> core::option::Option<MEff> {
    return match (l) {
        None -> None,
        Some(a) -> match (r) {
            None -> None,
            Some(b) -> Some(XDivide(op, boxed(a), boxed(b))),
        },
    };
}

pub fn x_neg_of(x: core::option::Option<MEff>) -> core::option::Option<MEff> {
    return match (x) {
        None -> None,
        Some(a) -> match (pure_part(a)) {
            None -> Some(XNeg(boxed(a))),
            Some(e) -> Some(XPure(Negate(boxed(e)))),
        },
    };
}

pub fn x_not_of(x: core::option::Option<MEff>) -> core::option::Option<MEff> {
    return match (x) {
        None -> None,
        Some(a) -> match (pure_part(a)) {
            None -> Some(XNot(boxed(a))),
            Some(e) -> Some(XPure(Not(boxed(e)))),
        },
    };
}

pub fn x_cast_into(t: core::option::Option<SrcType>, x: core::option::Option<MEff>) -> core::option::Option<MEff> {
    return match (t) {
        None -> None,
        Some(ty) -> match (x) {
            None -> None,
            Some(a) -> match (pure_part(a)) {
                None -> Some(XCast(ty, boxed(a))),
                Some(e) -> Some(XPure(Cast(ty, boxed(e)))),
            },
        },
    };
}

pub fn x_index_of(l: core::option::Option<Local>, x: core::option::Option<MEff>) -> core::option::Option<MEff> {
    return match (l) {
        None -> None,
        Some(s) -> match (x) {
            None -> None,
            Some(i) -> Some(XIndex(s.id, boxed(i))),
        },
    };
}

pub fn x_call_of(inst: core::option::Option<Inst>, args: List<MEff>) -> core::option::Option<MEff> {
    return match (inst) {
        None -> None,
        Some(i) -> Some(XCall(i, boxed(args))),
    };
}

pub fn cons_eff(head: core::option::Option<MEff>, tail: core::option::Option<List<MEff>>) -> core::option::Option<List<MEff>> {
    return match (head) {
        None -> None,
        Some(x) -> match (tail) {
            None -> None,
            Some(xs) -> Some(cons(x, xs)),
        },
    };
}

// The result type of a function instance.
// A projection's field type.
pub fn projection_ret(fuel: usize, decls: Decls, inst: Inst) -> core::option::Option<Ty> {
    return match (inst.args) {
        Nil -> None,
        Cons(t, rest) -> match (struct_field_tys(fuel, decls, t)) {
            None -> None,
            Some(ts) -> get(ts, minus(inst.decl, length(decls.fns))),
        },
    };
}

// A function declared `-> !`.
pub fn never_ret(fd: FnDecl) -> bool {
    let r: CTree = kid(fd.tree, 6);
    return node_prod(r) == p_ret_type() && node_prod(kid(r, 1)) == p_type_never();
}

// An instance of a `-> !` function with one type argument more than it has
// type parameters: its call where a value of that last type is expected
// (see diverge_func).
pub fn diverges(fd: FnDecl, inst: Inst) -> bool {
    return never_ret(fd) && length(inst.args) == plus(length(concat(fd.impl_params, fd.params)), 1);
}

pub fn last_ty(ts: List<Ty>) -> core::option::Option<Ty> {
    return match (ts) {
        Nil -> None,
        Cons(t, rest) -> match (unbox(rest)) {
            Nil -> Some(t),
            Cons(u, more) -> last_ty(unbox(rest)),
        },
    };
}

pub fn init_tys(ts: List<Ty>) -> List<Ty> {
    return match (ts) {
        Nil -> empty(),
        Cons(t, rest) -> match (unbox(rest)) {
            Nil -> empty(),
            Cons(u, more) -> cons(t, init_tys(unbox(rest))),
        },
    };
}

pub fn fn_inst_ret(fuel: usize, decls: Decls, fd: FnDecl, inst: Inst) -> core::option::Option<Ty> {
    if (diverges(fd, inst)) {
        return last_ty(inst.args);
    }
    return match (ret_pattern(fd)) {
        None -> None,
        Some(r) -> ty_of(fuel, decl_env(decls, fd.home, concat(fd.impl_params, fd.params), inst.args), r),
    };
}

pub fn inst_ret(fuel: usize, decls: Decls, inst: Inst) -> core::option::Option<Ty> {
    return match (get(decls.fns, inst.decl)) {
        None -> projection_ret(fuel, decls, inst),
        Some(fd) -> fn_inst_ret(fuel, decls, fd, inst),
    };
}

pub fn index_ty(l: core::option::Option<Local>) -> core::option::Option<Ty> {
    return match (l) {
        None -> None,
        Some(x) -> slice_elem(x.ty),
    };
}

// The type of an effectful expression, as type arguments are inferred
// from it.
pub fn bare_eff(x: MEff) -> bool {
    return match (x) {
        XPure(e) -> bare_int(e),
        XCall(inst, args) -> false,
        XApply(op, l, r) -> !gives_bool(op) && bare_eff(unbox(l)) && bare_eff(unbox(r)),
        XNeg(a) -> bare_eff(unbox(a)),
        XNot(a) -> false,
        XCast(t, a) -> false,
        XIndex(s, i) -> false,
        XStruct(t, fs) -> false,
        XVariant(t, k, ps) -> false,
        XMatch(s, ety, t, bs, vs) -> false,
        XDivide(op, l, r) -> bare_eff(unbox(l)) && bare_eff(unbox(r)),
        XStride(sl) -> false,
    };
}

pub fn eff_ty(fuel: usize, env: FrontEnv, scope: List<Local>, x: MEff) -> core::option::Option<Ty> {
    if (fuel == 0) {
        return None;
    }
    return match (x) {
        XPure(e) -> expr_ty(fuel, env, scope, e),
        XCall(inst, args) -> inst_ret(fuel, env.decls, inst),
        XApply(op, l, r) -> apply_ty(op, pick_ty(bare_eff(unbox(l)), eff_ty(minus(fuel, 1), env, scope, unbox(l)), eff_ty(minus(fuel, 1), env, scope, unbox(r)))),
        XNeg(a) -> eff_ty(minus(fuel, 1), env, scope, unbox(a)),
        XNot(a) -> Some(TyBool),
        XCast(t, a) -> src_ty(t),
        XIndex(s, i) -> index_ty(find_local_id(scope, s)),
        XStruct(t, fs) -> Some(t),
        XVariant(t, k, ps) -> Some(t),
        XMatch(s, ety, t, bs, vs) -> Some(t),
        XDivide(op, l, r) -> pick_ty(bare_eff(unbox(l)), eff_ty(minus(fuel, 1), env, scope, unbox(l)), eff_ty(minus(fuel, 1), env, scope, unbox(r))),
        XStride(sl) -> Some(TyIsize),
    };
}

pub fn effs_tys(fuel: usize, env: FrontEnv, scope: List<Local>, xs: List<MEff>) -> core::option::Option<List<Ty>> {
    return match (xs) {
        Nil -> Some(empty()),
        Cons(x, rest) -> cons_ty(eff_ty(fuel, env, scope, x), effs_tys(fuel, env, scope, unbox(rest))),
    };
}

// The first of a list of expected types, and the rest.
pub fn head_ty(expects: core::option::Option<List<Ty>>) -> core::option::Option<Ty> {
    return match (expects) {
        None -> None,
        Some(ts) -> match (ts) {
            Nil -> None,
            Cons(t, rest) -> Some(t),
        },
    };
}

pub fn tail_tys(expects: core::option::Option<List<Ty>>) -> core::option::Option<List<Ty>> {
    return match (expects) {
        None -> None,
        Some(ts) -> match (ts) {
            Nil -> None,
            Cons(t, rest) -> Some(unbox(rest)),
        },
    };
}

// An arm of a match expression: its binders, its value and the value's type.
pub struct EffArm {
    binders: List<usize>,
    value: MEff,
    ty: core::option::Option<Ty>,
}

pub fn arm_binders(arms: List<EffArm>) -> List<List<usize>> {
    return match (arms) {
        Nil -> empty(),
        Cons(a, rest) -> cons(a.binders, arm_binders(unbox(rest))),
    };
}

pub fn arm_values(arms: List<EffArm>) -> List<MEff> {
    return match (arms) {
        Nil -> empty(),
        Cons(a, rest) -> cons(a.value, arm_values(unbox(rest))),
    };
}

// A match's type: the expected one, or else its first arm's.
pub fn result_ty(expected: core::option::Option<Ty>, arms: List<EffArm>) -> core::option::Option<Ty> {
    return match (expected) {
        Some(t) -> Some(t),
        None -> match (arms) {
            Nil -> None,
            Cons(a, rest) -> a.ty,
        },
    };
}

pub fn x_match_of(s: MEff, ety: Ty, expected: core::option::Option<Ty>, arms: core::option::Option<List<EffArm>>) -> core::option::Option<MEff> {
    return match (arms) {
        None -> None,
        Some(a) -> match (result_ty(expected, a)) {
            None -> None,
            Some(t) -> Some(XMatch(boxed(s), ety, t, arm_binders(a), boxed(arm_values(a)))),
        },
    };
}

pub fn cons_eff_arm(head: core::option::Option<EffArm>, tail: core::option::Option<List<EffArm>>) -> core::option::Option<List<EffArm>> {
    return match (head) {
        None -> None,
        Some(a) -> match (tail) {
            None -> None,
            Some(xs) -> Some(cons(a, xs)),
        },
    };
}

// ---------------------------------------------------------------- statements

// A statement as build reads it, before monomorphization's numbering: like
// SrcStmt, but types are Ty and a call names its function instance.
pub enum MStmt {
    MNop,
    MLet(usize, Ty, SrcExpr, Box<MStmt>),
    MLetStruct(usize, Ty, List<SrcExpr>, Box<MStmt>),
    MLetCall(usize, Ty, Inst, List<SrcExpr>, Box<MStmt>),
    MLetEnum(usize, Ty, usize, List<SrcExpr>, Box<MStmt>),
    // the scrutinee local and its type
    MLetMatch(usize, Ty, usize, Ty, List<SrcArm>, Box<MStmt>),
    MSet(usize, SrcExpr),
    MSetField(usize, usize, SrcExpr),
    MSetCall(usize, Inst, List<SrcExpr>),
    MThen(Box<MStmt>, Box<MStmt>),
    MIf(SrcExpr, Box<MStmt>, Box<MStmt>),
    MWhile(SrcExpr, Box<MStmt>),
    MReturn(SrcExpr),
    MLetAlloc(usize, SrcExpr, usize, Box<MStmt>),
    MFree(SrcExpr, SrcExpr, usize),
    // the element type
    MLetSlice(usize, Ty, SrcExpr, SrcExpr, Box<MStmt>),
    MLetIndex(usize, Ty, usize, SrcExpr, Box<MStmt>),
    MSetIndex(usize, SrcExpr, SrcExpr),
    // the effectful forms
    MLetEval(usize, Ty, MEff, Box<MStmt>),
    MSetEval(usize, MEff),
    MIfEval(MEff, Box<MStmt>, Box<MStmt>),
    MWhileEval(MEff, Box<MStmt>),
    MReturnEval(MEff),
    MDiscard(MEff),
    MSetIndexEval(usize, MEff, MEff),
    MSetFieldEval(usize, usize, MEff),
    MReturnUnit,
    MAssert(MEff),
    MBreak,
    MContinue,
}

// A call: the function instance and the arguments.
pub struct Called {
    inst: Inst,
    args: List<SrcExpr>,
}

// What a let binds: a value, a call, a variant, a struct literal, a match,
// an allocation, a raw view, a slice element, or an effectful expression.
pub enum LetHead {
    Plain(SrcExpr),
    CallOf(Called),
    VariantOf(usize, List<SrcExpr>),
    LiteralOf(List<SrcExpr>),
    // the scrutinee local and its type, and the arms
    MatchOf(usize, Ty, List<SrcArm>),
    // alloc(size, 2^shift)
    AllocOf(SrcExpr, usize),
    // slice_from_raw_parts(pointer, length)
    SliceOf(SrcExpr, SrcExpr),
    // slice[index], the slice a local
    IndexOf(usize, SrcExpr),
    EvalOf(MEff),
}

pub fn cons_expr_tail(e: SrcExpr, tail: core::option::Option<List<SrcExpr>>) -> core::option::Option<List<SrcExpr>> {
    return match (tail) {
        None -> None,
        Some(es) -> Some(cons(e, es)),
    };
}

pub fn cons_expr(head: core::option::Option<SrcExpr>, tail: core::option::Option<List<SrcExpr>>) -> core::option::Option<List<SrcExpr>> {
    return match (head) {
        None -> None,
        Some(e) -> cons_expr_tail(e, tail),
    };
}

pub fn exprs_of(fuel: usize, env: FrontEnv, scope: List<Local>, items: List<CTree>) -> core::option::Option<List<SrcExpr>> {
    return match (items) {
        Nil -> Some(empty()),
        Cons(e, rest) -> cons_expr(expr_of(fuel, env, scope, e), exprs_of(fuel, env, scope, unbox(rest))),
    };
}

pub fn args_of(fuel: usize, env: FrontEnv, scope: List<Local>, args: CTree) -> core::option::Option<List<SrcExpr>> {
    return match (list_items(fuel, args)) {
        None -> None,
        Some(items) -> exprs_of(fuel, env, scope, items),
    };
}

// ---------------------------------------------------------------- calls

pub fn is_some_index(k: core::option::Option<usize>) -> bool {
    return match (k) {
        None -> false,
        Some(x) -> true,
    };
}

// A struct's declaration (an enum's path names its variants).
pub fn is_struct_at(env: FrontEnv, k: core::option::Option<usize>) -> bool {
    return match (k) {
        None -> false,
        Some(d) -> match (get(env.decls.types, d)) {
            None -> false,
            Some(t) -> !t.is_enum,
        },
    };
}

// A path's one-segment prefix that names a type: a type parameter, a
// primitive type or a struct of the current module (`T::m`, `i32::hash`,
// `Date::lt`).
pub fn is_type_param(env: FrontEnv, owner: core::option::Option<List<usize>>) -> bool {
    return match (owner) {
        None -> false,
        Some(n) -> member(env.names, n) || !is_none_type(primitive(n)) || is_struct_at(env, type_decl_at(env, single(n))),
    };
}

// A type of the current module stands for itself with no type arguments.
pub fn owner_ty(env: FrontEnv, owner: core::option::Option<List<usize>>) -> core::option::Option<Ty> {
    return match (owner) {
        None -> None,
        Some(n) -> match (param_ty(env, n)) {
            Some(t) -> Some(t),
            None -> prim_or_named(env, single(n), n),
        },
    };
}

// A path naming a function: `T::m` for a type parameter T, or a free
// function of the path's module.
pub fn is_fn_path(env: FrontEnv, s: Split) -> bool {
    return is_type_param(env, single_name(s.home)) || is_some_index(find_fn(env.decls.fns, module_or(env.home, s.home), s.name, 0));
}

// A postfix `recv.m(args)` (recv a local, no further postfix).
pub fn is_method_form(pf: CTree) -> bool {
    let primary: CTree = kid(pf, 0);
    let tail: CTree = kid(pf, 1);
    let call: CTree = kid(tail, 3);
    return (node_prod(primary) == p_self_value() || (node_prod(primary) == p_ident() && node_prod(kid(primary, 1)) == p_ident_plain())) && node_prod(tail) == p_postfix_member() && node_prod(kid(tail, 2)) == p_member_type_args_none() && node_prod(call) == p_postfix_call() && node_prod(kid(call, 3)) == p_postfix_end();
}

// A postfix `path(args)` (no further postfix).
pub fn is_path_call(pf: CTree) -> bool {
    let primary: CTree = kid(pf, 0);
    let tail: CTree = kid(pf, 1);
    return node_prod(primary) == p_ident() && node_prod(kid(primary, 1)) == p_ident_plain() && node_prod(tail) == p_postfix_call() && node_prod(kid(tail, 3)) == p_postfix_end();
}

// ---------------------------------------------------------------- let heads

// The shift of an alignment 2^shift, counting up from 2^s = p.
pub fn shift_of_u64(fuel: usize, k: u64, s: usize, p: usize) -> core::option::Option<usize> {
    if (fuel == 0) {
        return None;
    }
    if ((p as u64) == k) {
        return Some(s);
    }
    return shift_of_u64(minus(fuel, 1), k, plus(s, 1), times(p, 2));
}

pub fn is_usize(t: SrcType) -> bool {
    return match (t) {
        I32 -> false,
        Bool -> false,
        Uint(k) -> match (k) {
            Uint8 -> false,
            Uint32 -> false,
            Uint64 -> false,
            Usize -> true,
            Uint16 -> false,
        },
        Struct(id, fields) -> false,
        Enum(id, variants) -> false,
        Ptr -> false,
        Slice(e) -> false,
        Unit -> false,
        Isize -> false,
        SrcType::Char -> false,
        Sint(sk) -> false,
    };
}

// An integer literal 2^shift with shift below 31.
pub fn literal_shift(e: SrcExpr) -> core::option::Option<usize> {
    return match (e) {
        Int(k) -> shift_of_u64(31, (k as u32) as u64, 0, 1),
        Boolean(b) -> None,
        Unsigned(u, k) -> shift_of_u64(31, k, 0, 1),
        Local(id) -> None,
        Field(id, j) -> None,
        Negate(x) -> None,
        Not(x) -> None,
        Apply(op, a, b) -> None,
        Cast(t, x) -> None,
        Null -> None,
        SrcExpr::Char(code) -> None,
    };
}

pub fn cast_shift(usize_cast: bool, x: SrcExpr) -> core::option::Option<usize> {
    if (usize_cast) {
        return literal_shift(x);
    }
    return None;
}

// The shift of a literal alignment 2^shift: `8`, `(8 as usize)`, or an
// unsigned literal (a constant's value).
pub fn shift_of(e: SrcExpr) -> core::option::Option<usize> {
    return match (e) {
        Int(k) -> literal_shift(e),
        Boolean(b) -> None,
        Unsigned(u, k) -> literal_shift(e),
        Local(id) -> None,
        Field(id, j) -> None,
        Negate(x) -> None,
        Not(x) -> None,
        Apply(op, a, b) -> None,
        Cast(t, x) -> cast_shift(is_usize(t), unbox(x)),
        Null -> None,
        SrcExpr::Char(code) -> None,
    };
}

pub fn alloc_shifted(size: SrcExpr, shift: core::option::Option<usize>, more: List<SrcExpr>) -> core::option::Option<LetHead> {
    return match (shift) {
        None -> None,
        Some(k) -> match (more) {
            Nil -> Some(AllocOf(size, k)),
            Cons(e, others) -> None,
        },
    };
}

// alloc(size, align)
pub fn alloc_head(args: core::option::Option<List<SrcExpr>>) -> core::option::Option<LetHead> {
    return match (args) {
        None -> None,
        Some(es) -> match (es) {
            Nil -> None,
            Cons(size, rest) -> match (unbox(rest)) {
                Nil -> None,
                Cons(align, more) -> alloc_shifted(size, shift_of(align), unbox(more)),
            },
        },
    };
}

// slice_from_raw_parts(pointer, length)
pub fn slice_head(args: core::option::Option<List<SrcExpr>>) -> core::option::Option<LetHead> {
    return match (args) {
        None -> None,
        Some(es) -> match (es) {
            Nil -> None,
            Cons(pointer, rest) -> match (unbox(rest)) {
                Nil -> None,
                Cons(length, more) -> match (unbox(more)) {
                    Nil -> Some(SliceOf(pointer, length)),
                    Cons(e, others) -> None,
                },
            },
        },
    };
}

pub fn is_path(segments: core::option::Option<List<List<usize>>>, wanted: List<List<usize>>) -> bool {
    return match (segments) {
        None -> false,
        Some(ss) -> same_spellings(ss, wanted),
    };
}

// alloc::allocator::alloc, the allocator's alloc
pub fn alloc_path() -> List<List<usize>> {
    return cons(text_alloc(), cons(text_allocator(), single(text_alloc())));
}

// alloc::allocator::dealloc
pub fn dealloc_path() -> List<List<usize>> {
    return cons(text_alloc(), cons(text_allocator(), single(text_dealloc())));
}

// The allocator's calls, raw views, slice strides and `assert` are the
// language's own: no function or variant is read at these paths.
pub fn builtin_path(ss: List<List<usize>>) -> bool {
    return same_spellings(ss, alloc_path()) || same_spellings(ss, dealloc_path()) || same_spellings(ss, single(text_slice_from_raw_parts())) || same_spellings(ss, single(text_slice_stride())) || same_spellings(ss, single(text_assert()));
}

// A path's module and last name, the path not reserved.
pub fn named_split(ss: List<List<usize>>) -> core::option::Option<Split> {
    if (builtin_path(ss)) {
        return None;
    }
    return split_last(ss);
}

// `path(args)` in a let, read by its spelling: the allocator or a raw view.
pub fn call_path_head(fuel: usize, env: FrontEnv, scope: List<Local>, path: CTree, args: CTree) -> core::option::Option<LetHead> {
    let segments: core::option::Option<List<List<usize>>> = path_spellings(fuel, kid(path, 0), kid(path, 1));
    if (is_path(segments, alloc_path())) {
        return alloc_head(args_of(fuel, env, scope, args));
    }
    if (is_path(segments, single(text_slice_from_raw_parts()))) {
        return slice_head(args_of(fuel, env, scope, args));
    }
    return None;
}

pub fn field_values(fs: List<CTree>) -> List<CTree> {
    return match (fs) {
        Nil -> empty(),
        Cons(f, rest) -> cons(kid(f, 2), field_values(unbox(rest))),
    };
}

// The struct literal fields are spelled names, in order.
pub fn same_names(names: List<List<usize>>, fs: List<CTree>) -> bool {
    return match (names) {
        Nil -> match (fs) {
            Nil -> true,
            Cons(f, more) -> false,
        },
        Cons(n, rest) -> match (fs) {
            Nil -> false,
            Cons(f, more) -> same_text(n, kid_token(f, 0).text) && same_names(unbox(rest), unbox(more)),
        },
    };
}

pub fn cons_arm_tail(a: SrcArm, tail: core::option::Option<List<SrcArm>>) -> core::option::Option<List<SrcArm>> {
    return match (tail) {
        None -> None,
        Some(others) -> Some(cons(a, others)),
    };
}

pub fn cons_arm(head: core::option::Option<SrcArm>, tail: core::option::Option<List<SrcArm>>) -> core::option::Option<List<SrcArm>> {
    return match (head) {
        None -> None,
        Some(a) -> cons_arm_tail(a, tail),
    };
}

// Binder ids, and the scope with the binders in it.
pub struct Bound {
    ids: List<usize>,
    scope: List<Local>,
}

pub fn arm_value(ids: List<usize>, value: core::option::Option<SrcExpr>) -> core::option::Option<SrcArm> {
    return match (value) {
        None -> None,
        Some(e) -> Some(SrcArm { binders: ids, value: e }),
    };
}

pub fn arm_bound(fuel: usize, env: FrontEnv, bound: core::option::Option<Bound>, value: CTree) -> core::option::Option<SrcArm> {
    return match (bound) {
        None -> None,
        Some(b) -> arm_value(b.ids, expr_of(fuel, env, b.scope, value)),
    };
}

pub fn is_some_name(name: core::option::Option<List<usize>>) -> bool {
    return match (name) {
        None -> false,
        Some(n) -> true,
    };
}

pub fn cons_binder(id: usize, rest: core::option::Option<Bound>) -> core::option::Option<Bound> {
    return match (rest) {
        None -> None,
        Some(b) -> Some(Bound { ids: cons(id, b.ids), scope: b.scope }),
    };
}

// One plain name pattern per payload type, each a fresh local.
pub fn binders_of(env: FrontEnv, scope: List<Local>, pats: List<CTree>, payload: List<Ty>) -> core::option::Option<Bound> {
    return match (payload) {
        Nil -> match (pats) {
            Nil -> Some(Bound { ids: empty(), scope: scope }),
            Cons(p, more) -> None,
        },
        Cons(t, rest) -> match (pats) {
            Nil -> None,
            Cons(p, more) -> binder_of(env, scope, p, t, unbox(more), unbox(rest)),
        },
    };
}

// extract: inline
fn binder_of(env: FrontEnv, scope: List<Local>, p: CTree, t: Ty, pats: List<CTree>, payload: List<Ty>) -> core::option::Option<Bound> {
    let path: CTree = kid(p, 0);
    let tok: Token = kid_token(kid(path, 0), 0);
    if (node_prod(p) == p_pattern_ident() && node_prod(kid(p, 1)) == p_pattern_plain() && is_some_name(path_name(path)) && !member(env.globals, tok.text) && fresh_id(scope, minus(tok.start, env.base))) {
        return cons_binder(minus(tok.start, env.base), binders_of(env, cons(Local { name: tok.text, id: minus(tok.start, env.base), ty: t }, scope), pats, payload));
    }
    return None;
}

// A variant's spelling and its payload types at the scrutinee's arguments.
pub struct VariantTy {
    name: List<usize>,
    payload: List<Ty>,
}

pub fn zip_variants(names: List<List<usize>>, payloads: List<List<Ty>>) -> List<VariantTy> {
    return match (names) {
        Nil -> empty(),
        Cons(n, rest) -> match (payloads) {
            Nil -> empty(),
            Cons(p, more) -> cons(VariantTy { name: n, payload: p }, zip_variants(unbox(rest), unbox(more))),
        },
    };
}

pub fn arm_prefix(p: List<List<usize>>, owner: TypeDecl) -> bool {
    return no_names(p) || same_spellings(p, owner.home) || same_spellings(p, single(owner.name)) || same_spellings(p, concat(owner.home, single(owner.name)));
}

// An arm's pattern names the variant: `V`, `m::V` with m the enum's module,
// `E::V` with E the enum, or `m::E::V`.
pub fn arm_named(segments: core::option::Option<List<List<usize>>>, owner: TypeDecl, name: List<usize>) -> bool {
    return match (segments) {
        None -> false,
        Some(ss) -> match (split_last(ss)) {
            None -> false,
            Some(s) -> same_text(s.name, name) && arm_prefix(s.home, owner),
        },
    };
}

// `V -> value` or `V(b, ...) -> value` (match_arm -> pattern MatchArrow expr).
pub fn arm_of(fuel: usize, env: FrontEnv, scope: List<Local>, owner: TypeDecl, v: VariantTy, arm: CTree) -> core::option::Option<SrcArm> {
    let pattern: CTree = kid(arm, 0);
    let ptail: CTree = kid(pattern, 1);
    let path: CTree = kid(pattern, 0);
    if (node_prod(pattern) == p_pattern_ident() && arm_named(path_spellings(fuel, kid(path, 0), kid(path, 1)), owner, v.name)) {
        if (node_prod(ptail) == p_pattern_plain()) {
            return arm_bound(fuel, env, Some(Bound { ids: empty(), scope: scope }), kid(arm, 2));
        }
        return match (list_items(fuel, kid(ptail, 1))) {
            None -> None,
            Some(pats) -> arm_bound(fuel, env, binders_of(env, scope, pats, v.payload), kid(arm, 2)),
        };
    }
    return None;
}

// Whether an arm's pattern names the variant spelled name.
pub fn arm_names(fuel: usize, owner: TypeDecl, name: List<usize>, arm: CTree) -> bool {
    let pattern: CTree = kid(arm, 0);
    let path: CTree = kid(pattern, 0);
    return node_prod(pattern) == p_pattern_ident() && arm_named(path_spellings(fuel, kid(path, 0), kid(path, 1)), owner, name);
}

pub fn arms_naming_at(named: bool, a: CTree, rest: List<CTree>) -> List<CTree> {
    if (named) {
        return cons(a, rest);
    }
    return rest;
}

pub fn arms_naming(fuel: usize, owner: TypeDecl, name: List<usize>, arms: List<CTree>) -> List<CTree> {
    return match (arms) {
        Nil -> empty(),
        Cons(a, rest) -> arms_naming_at(arm_names(fuel, owner, name, a), a, arms_naming(fuel, owner, name, unbox(rest))),
    };
}

// For each variant in order, the one arm that names it.
pub fn arms_by_variant(fuel: usize, owner: TypeDecl, variants: List<VariantTy>, arms: List<CTree>) -> core::option::Option<List<CTree>> {
    return match (variants) {
        Nil -> Some(empty()),
        Cons(v, rest) -> match (arms_naming(fuel, owner, v.name, arms)) {
            Nil -> None,
            Cons(a, more) -> match (unbox(more)) {
                Nil -> cons_tree_tail(a, arms_by_variant(fuel, owner, unbox(rest), arms)),
                Cons(b, others) -> None,
            },
        },
    };
}

// The arms in variant order: as many arms as variants, each variant named
// by exactly one. Only one arm runs, so the order they are written in has
// no effect.
pub fn arms_in_order(fuel: usize, owner: TypeDecl, variants: List<VariantTy>, arms: List<CTree>) -> core::option::Option<List<CTree>> {
    if (length(arms) == length(variants)) {
        return arms_by_variant(fuel, owner, variants, arms);
    }
    return None;
}

// Arm k is variant k.
pub fn arms_of(fuel: usize, env: FrontEnv, scope: List<Local>, owner: TypeDecl, variants: List<VariantTy>, arms: List<CTree>) -> core::option::Option<List<SrcArm>> {
    return match (variants) {
        Nil -> match (arms) {
            Nil -> Some(empty()),
            Cons(a, more) -> None,
        },
        Cons(v, rest) -> match (arms) {
            Nil -> None,
            Cons(a, more) -> cons_arm(arm_of(fuel, env, scope, owner, v, a), arms_of(fuel, env, scope, owner, unbox(rest), unbox(more))),
        },
    };
}

pub fn postfix_head(fuel: usize, env: FrontEnv, scope: List<Local>, pf: CTree) -> core::option::Option<LetHead> {
    if (is_path_call(pf)) {
        return call_path_head(fuel, env, scope, kid(kid(pf, 0), 0), kid(kid(pf, 1), 1));
    }
    return None;
}

// The head of `let x: ty = init;` that its spelling decides: an allocation
// or a raw view.
pub fn let_head(fuel: usize, env: FrontEnv, scope: List<Local>, init: CTree) -> core::option::Option<LetHead> {
    return match (peel(fuel, init)) {
        None -> None,
        Some(pf) -> postfix_head(fuel, env, scope, pf),
    };
}

// ---------------------------------------------------------------- effectful expressions, read

pub fn same_decl_args(ok: bool, args: List<Ty>) -> core::option::Option<List<Ty>> {
    if (ok) {
        return Some(args);
    }
    return None;
}

// A hint the builder needs is never silently dropped: where a search that
// must succeed does not (ok is false), the reading fails.
pub fn has_tys(x: core::option::Option<List<Ty>>) -> bool {
    return match (x) {
        None -> false,
        Some(v) -> true,
    };
}

pub fn has_ty(x: core::option::Option<Ty>) -> bool {
    return match (x) {
        None -> false,
        Some(v) -> true,
    };
}

pub fn checked_eff(ok: bool, x: core::option::Option<MEff>) -> core::option::Option<MEff> {
    if (ok) {
        return x;
    }
    return None;
}

pub fn checked_effs(ok: bool, x: core::option::Option<List<MEff>>) -> core::option::Option<List<MEff>> {
    if (ok) {
        return x;
    }
    return None;
}

pub fn checked_bound(ok: bool, x: core::option::Option<ArgsBound>) -> core::option::Option<ArgsBound> {
    if (ok) {
        return x;
    }
    return None;
}

pub fn checked_stmt(ok: bool, x: core::option::Option<MStmt>) -> core::option::Option<MStmt> {
    if (ok) {
        return x;
    }
    return None;
}

pub fn has_local(x: core::option::Option<Local>) -> bool {
    return match (x) {
        None -> false,
        Some(v) -> true,
    };
}

pub fn has_const(x: core::option::Option<ConstDecl>) -> bool {
    return match (x) {
        None -> false,
        Some(v) -> true,
    };
}

// A struct's or enum's type arguments when they are known before its
// fields or payload are read: none, or the expected type's.
pub fn known_args(t: TypeDecl, d: usize, expected: core::option::Option<Ty>) -> core::option::Option<List<Ty>> {
    if (no_names(t.params)) {
        return Some(empty());
    }
    return match (expected) {
        None -> None,
        Some(e) -> match (named_parts(e)) {
            None -> None,
            Some(n) -> same_decl_args(n.decl == d, n.args),
        },
    };
}

pub fn named_inferred(d: usize, args: core::option::Option<List<Ty>>) -> core::option::Option<Ty> {
    return match (args) {
        None -> None,
        Some(ts) -> Some(TyNamed(d, boxed(ts))),
    };
}

// The type of a literal of declaration d: its known arguments, or else
// those inferred by matching the field or payload types as written with
// the values' types.
pub fn decl_inst(fuel: usize, env: FrontEnv, scope: List<Local>, d: usize, t: TypeDecl, known: core::option::Option<List<Ty>>, patterns: core::option::Option<List<CTree>>, values: List<MEff>) -> core::option::Option<Ty> {
    return match (known) {
        Some(args) -> Some(TyNamed(d, boxed(args))),
        None -> match (patterns) {
            None -> None,
            Some(ps) -> match (effs_tys(fuel, env, scope, values)) {
                None -> None,
                Some(ts) -> named_inferred(d, bound_or_none(t.params, match_tys(fuel, decl_env(env.decls, t.home, empty(), empty()), t.params, ps, ts, empty()))),
            },
        },
    };
}

pub fn variant_expects(fuel: usize, decls: Decls, d: usize, index: usize, known: core::option::Option<List<Ty>>) -> core::option::Option<List<Ty>> {
    return match (known) {
        None -> None,
        Some(args) -> match (payload_tys(fuel, decls, d, args)) {
            None -> None,
            Some(vs) -> get(vs, index),
        },
    };
}

pub fn field_expects(fuel: usize, decls: Decls, d: usize, known: core::option::Option<List<Ty>>) -> core::option::Option<List<Ty>> {
    return match (known) {
        None -> None,
        Some(args) -> field_tys(fuel, decls, d, args),
    };
}

pub fn x_variant_of(fuel: usize, env: FrontEnv, scope: List<Local>, d: usize, t: TypeDecl, index: usize, known: core::option::Option<List<Ty>>, payload: core::option::Option<List<MEff>>) -> core::option::Option<MEff> {
    return match (payload) {
        None -> None,
        Some(ps) -> match (decl_inst(fuel, env, scope, d, t, known, get(t.payloads, index), ps)) {
            None -> None,
            Some(ty) -> Some(XVariant(ty, index, boxed(ps))),
        },
    };
}

pub fn x_struct_of(fuel: usize, env: FrontEnv, scope: List<Local>, d: usize, t: TypeDecl, known: core::option::Option<List<Ty>>, values: core::option::Option<List<MEff>>) -> core::option::Option<MEff> {
    return match (values) {
        None -> None,
        Some(vs) -> match (decl_inst(fuel, env, scope, d, t, known, Some(t.field_types), vs)) {
            None -> None,
            Some(ty) -> Some(XStruct(ty, boxed(vs))),
        },
    };
}

// A function's parameter types, when its type arguments are known.
pub fn param_expects(fuel: usize, decls: Decls, fd: FnDecl, args: core::option::Option<List<Ty>>) -> core::option::Option<List<Ty>> {
    return match (args) {
        None -> None,
        Some(a) -> match (param_patterns(fuel, fd)) {
            None -> None,
            Some(ps) -> ty_list(fuel, decl_env(decls, fd.home, concat(fd.impl_params, fd.params), a), ps),
        },
    };
}

// The expected types of the arguments after the receiver, if any.
pub fn skip_expects(expects: core::option::Option<List<Ty>>, pre: List<MEff>) -> core::option::Option<List<Ty>> {
    return match (pre) {
        Nil -> expects,
        Cons(x, rest) -> tail_tys(expects),
    };
}

// The instance a call of d means, inferred from its argument types alone.
pub fn infer_args(fuel: usize, decls: Decls, d: usize, fd: FnDecl, start: List<Bind>, arg_tys: core::option::Option<List<Ty>>) -> core::option::Option<Inst> {
    let names: List<List<usize>> = concat(fd.impl_params, fd.params);
    if (no_names(names)) {
        return Some(Inst { decl: d, args: empty() });
    }
    return match (arg_tys) {
        None -> None,
        Some(ts) -> match (param_patterns(fuel, fd)) {
            None -> None,
            Some(ps) -> inst_from(d, bound_or_none(names, match_tys(fuel, callee_env(decls, fd), names, ps, ts, start))),
        },
    };
}

// The instance a call of d means: from its argument types, and from the
// type its value is stored at when that is known.
pub fn infer_eff(fuel: usize, decls: Decls, d: usize, fd: FnDecl, start: List<Bind>, arg_tys: core::option::Option<List<Ty>>, expected: core::option::Option<Ty>) -> core::option::Option<Inst> {
    return match (expected) {
        Some(t) -> infer_inst(fuel, decls, d, fd, start, arg_tys, t),
        None -> infer_args(fuel, decls, d, fd, start, arg_tys),
    };
}

pub fn eff_called(fuel: usize, env: FrontEnv, scope: List<Local>, expected: core::option::Option<Ty>, d: usize, fd: FnDecl, start: List<Bind>, pre: List<MEff>, args: core::option::Option<List<MEff>>) -> core::option::Option<MEff> {
    return match (args) {
        None -> None,
        Some(xs) -> x_call_of(infer_eff(fuel, env.decls, d, fd, start, effs_tys(fuel, env, scope, concat(pre, xs)), expected), concat(pre, xs)),
    };
}

// An operator tail: a binary operator, `/` or `%`.
pub fn eff_binary(p: usize, acc: core::option::Option<MEff>, right: core::option::Option<MEff>) -> core::option::Option<MEff> {
    if (p == p_div_tail()) {
        return x_divide_of(Quotient, acc, right);
    }
    if (p == p_mod_tail()) {
        return x_divide_of(Remainder, acc, right);
    }
    return match (tail_op(p)) {
        None -> None,
        Some(o) -> x_apply_of(o, acc, right),
    };
}

// `acc as T as U ...`
pub fn eff_casts(fuel: usize, env: FrontEnv, acc: core::option::Option<MEff>, tail: CTree) -> core::option::Option<MEff> {
    if (fuel == 0) {
        return None;
    }
    if (has_kids(tail)) {
        return eff_casts(minus(fuel, 1), env, x_cast_into(cast_type_of(fuel, env, kid(tail, 1)), acc), kid(tail, 2));
    }
    return acc;
}

pub fn arm_eff(fuel: usize, env: FrontEnv, b: Bound, value: core::option::Option<MEff>) -> core::option::Option<EffArm> {
    return match (value) {
        None -> None,
        Some(x) -> Some(EffArm { binders: b.ids, value: x, ty: eff_ty(fuel, env, b.scope, x) }),
    };
}

pub fn pure_list(xs: List<MEff>) -> core::option::Option<List<SrcExpr>> {
    return match (xs) {
        Nil -> Some(empty()),
        Cons(x, rest) -> match (pure_part(x)) {
            None -> None,
            Some(e) -> match (pure_list(unbox(rest))) {
                None -> None,
                Some(es) -> Some(cons(e, es)),
            },
        },
    };
}

// A call whose arguments are all pure.
pub fn call_parts(x: MEff) -> core::option::Option<Called> {
    return match (x) {
        XPure(e) -> None,
        XCall(inst, args) -> match (pure_list(unbox(args))) {
            None -> None,
            Some(es) -> Some(Called { inst: inst, args: es }),
        },
        XApply(op, l, r) -> None,
        XNeg(a) -> None,
        XNot(a) -> None,
        XCast(t, a) -> None,
        XIndex(sl, i) -> None,
        XStruct(t, fs) -> None,
        XVariant(t, k, ps) -> None,
        XMatch(sc, ety, t, bs, vs) -> None,
        XDivide(op, l, r) -> None,
        XStride(sl) -> None,
    };
}

// The local an expression is, if it is one.
pub fn pure_local(e: SrcExpr) -> core::option::Option<usize> {
    return match (e) {
        Int(k) -> None,
        Boolean(b) -> None,
        Unsigned(u, k) -> None,
        Local(id) -> Some(id),
        Field(id, j) -> None,
        Negate(a) -> None,
        Not(a) -> None,
        Apply(op, a, b) -> None,
        Cast(t, a) -> None,
        Null -> None,
        SrcExpr::Char(code) -> None,
    };
}

pub fn eff_local(x: MEff) -> core::option::Option<usize> {
    return match (pure_part(x)) {
        None -> None,
        Some(e) -> pure_local(e),
    };
}

// The projection of field j of type t: a function instance numbered past
// the declared functions, `fn(v: t) -> f { return v.f; }`.
pub fn projection(decls: Decls, t: Ty, j: usize) -> Inst {
    return Inst { decl: plus(length(decls.fns), j), args: single(t) };
}

// Field j of the value x of type t: Field of a local, else the call of the
// projection.
pub fn field_value(decls: Decls, x: MEff, t: Ty, j: usize) -> MEff {
    return match (eff_local(x)) {
        Some(id) -> XPure(Field(id, j)),
        None -> XCall(projection(decls, t, j), boxed(single(x))),
    };
}

pub fn field_of_ty(env: FrontEnv, x: MEff, t: core::option::Option<Ty>, name: List<usize>) -> core::option::Option<MEff> {
    return match (t) {
        None -> None,
        Some(ty) -> match (field_index(env, ty, name)) {
            None -> None,
            Some(j) -> Some(field_value(env.decls, x, ty, j)),
        },
    };
}

pub fn method_of_ty(fuel: usize, env: FrontEnv, t: core::option::Option<Ty>, name: List<usize>) -> core::option::Option<Found> {
    return match (t) {
        None -> None,
        Some(ty) -> find_method(fuel, env.decls, env.decls.fns, 0, name, ty),
    };
}

pub fn eff_slice_local(scope: List<Local>, x: MEff) -> core::option::Option<Local> {
    return match (eff_local(x)) {
        None -> None,
        Some(id) -> find_local_id(scope, id),
    };
}

// The expected type of a step whose tail is next: the chain's, for its last.
pub fn step_expected(expected: core::option::Option<Ty>, next: CTree) -> core::option::Option<Ty> {
    if (node_prod(next) == p_postfix_end()) {
        return expected;
    }
    return None;
}

// Arguments read so far, and the type parameters they bind.
pub struct ArgsBound {
    args: List<MEff>,
    binds: List<Bind>,
}

pub fn cons_bound(x: MEff, r: core::option::Option<ArgsBound>) -> core::option::Option<ArgsBound> {
    return match (r) {
        None -> None,
        Some(a) -> Some(ArgsBound { args: cons(x, a.args), binds: a.binds }),
    };
}

// The bindings from the result type matched with the expected type.
pub fn ret_binds(fuel: usize, decls: Decls, fd: FnDecl, names: List<List<usize>>, start: List<Bind>, expected: core::option::Option<Ty>) -> core::option::Option<List<Bind>> {
    return match (expected) {
        None -> Some(start),
        Some(t) -> match (ret_pattern(fd)) {
            None -> None,
            Some(r) -> match_ty(fuel, callee_env(decls, fd), names, r, t, start),
        },
    };
}

// A parameter's type, once every type parameter is bound.
pub fn arg_expected(fuel: usize, decls: Decls, fd: FnDecl, names: List<List<usize>>, p: CTree, b: List<Bind>) -> core::option::Option<Ty> {
    return match (bound_args(names, b)) {
        None -> None,
        Some(a) -> ty_of(fuel, decl_env(decls, fd.home, names, a), p),
    };
}

// An argument's type matched with its parameter's; an integer literal binds
// nothing (laniusc gives it the parameter's type).
pub fn bind_arg(fuel: usize, env: FrontEnv, scope: List<Local>, fd: FnDecl, names: List<List<usize>>, p: CTree, x: MEff, b: List<Bind>) -> core::option::Option<List<Bind>> {
    if (bare_eff(x)) {
        return Some(b);
    }
    return match (eff_ty(fuel, env, scope, x)) {
        None -> None,
        Some(t) -> match_ty(fuel, callee_env(env.decls, fd), names, p, t, b),
    };
}

pub fn match_tys_or_none(fuel: usize, env: FrontEnv, names: List<List<usize>>, ps: List<CTree>, ts: core::option::Option<List<Ty>>, b: List<Bind>) -> core::option::Option<List<Bind>> {
    return match (ts) {
        None -> None,
        Some(xs) -> match_tys(fuel, env, names, ps, xs, b),
    };
}

// The instance: from the bindings; if a type parameter is still unbound,
// with the integer literal arguments taken as i32.
pub fn inst_bound(fuel: usize, env: FrontEnv, scope: List<Local>, d: usize, fd: FnDecl, names: List<List<usize>>, ps: List<CTree>, a: ArgsBound) -> core::option::Option<Inst> {
    return match (bound_args(names, a.binds)) {
        Some(ts) -> Some(Inst { decl: d, args: ts }),
        None -> inst_from(d, bound_or_none(names, match_tys_or_none(fuel, callee_env(env.decls, fd), names, ps, effs_tys(fuel, env, scope, a.args), a.binds))),
    };
}

pub fn eff_inferred(fuel: usize, env: FrontEnv, scope: List<Local>, d: usize, fd: FnDecl, names: List<List<usize>>, ps: List<CTree>, r: core::option::Option<ArgsBound>) -> core::option::Option<MEff> {
    return match (r) {
        None -> None,
        Some(a) -> x_call_of(inst_bound(fuel, env, scope, d, fd, names, ps, a), a.args),
    };
}

pub fn diverge_checked(ok: bool, t: Ty, inst: Inst, args: Box<List<MEff>>, x: MEff) -> MEff {
    if (ok) {
        return XCall(Inst { decl: inst.decl, args: concat(inst.args, single(t)) }, args);
    }
    return x;
}

// A call of a `-> !` function where a value of type t is expected: the call
// of its instance at t (see diverge_func).
pub fn diverge_call(decls: Decls, t: Ty, inst: Inst, args: Box<List<MEff>>, x: MEff) -> MEff {
    return match (get(decls.fns, inst.decl)) {
        None -> x,
        Some(fd) -> diverge_checked(never_ret(fd) && length(inst.args) == length(concat(fd.impl_params, fd.params)), t, inst, args, x),
    };
}

pub fn diverge_eff(decls: Decls, t: Ty, x: MEff) -> MEff {
    return match (x) {
        XPure(e) -> x,
        XCall(inst, args) -> diverge_call(decls, t, inst, args, x),
        XApply(op, l, r) -> x,
        XNeg(a) -> x,
        XNot(a) -> x,
        XCast(c, a) -> x,
        XIndex(sl, i) -> x,
        XStruct(st, fs) -> x,
        XVariant(vt, k, ps) -> x,
        XMatch(sc, ety, mt, bs, vs) -> x,
        XDivide(op, l, r) -> x,
        XStride(sl) -> x,
    };
}

// A match arm's value: a call of a `-> !` function (`None -> panic()`) is
// its instance at the match's type.
pub fn diverge_arm(decls: Decls, expected: core::option::Option<Ty>, x: core::option::Option<MEff>) -> core::option::Option<MEff> {
    return match (x) {
        None -> None,
        Some(v) -> match (expected) {
            None -> Some(v),
            Some(t) -> Some(diverge_eff(decls, t, v)),
        },
    };
}

// extract: mutual begin
// The effectful expression a node of the expression grammar denotes, its
// value stored at type expected when that is known: the pure expression
// expr_of reads, or else a call, a variant, a struct literal, a match, a
// slice element, a division, or an operator, cast or negation of these.
pub fn eff_of(fuel: usize, env: FrontEnv, scope: List<Local>, expected: core::option::Option<Ty>, c: CTree) -> core::option::Option<MEff> {
    if (fuel == 0) {
        return None;
    }
    return match (expr_of(fuel, env, scope, c)) {
        Some(e) -> Some(XPure(e)),
        None -> eff_node(minus(fuel, 1), env, scope, expected, c),
    };
}

pub fn eff_node(fuel: usize, env: FrontEnv, scope: List<Local>, expected: core::option::Option<Ty>, c: CTree) -> core::option::Option<MEff> {
    if (fuel == 0) {
        return None;
    }
    let f: usize = minus(fuel, 1);
    let p: usize = node_prod(c);
    if (p == p_expr() || p == p_base()) {
        return eff_of(f, env, scope, expected, kid(c, 0));
    }
    if ((p == p_assign() || is_level(p) || p == p_cast()) && !has_kids(kid(c, 1))) {
        return eff_of(f, env, scope, expected, kid(c, 0));
    }
    if (is_level(p)) {
        return eff_fold(f, env, scope, eff_of(f, env, scope, None, kid(c, 0)), kid(c, 1));
    }
    if (p == p_cast()) {
        return eff_casts(f, env, eff_of(f, env, scope, None, kid(c, 0)), kid(c, 1));
    }
    if (p == p_neg()) {
        return x_neg_of(eff_of(f, env, scope, expected, kid(c, 1)));
    }
    if (p == p_not()) {
        return x_not_of(eff_of(f, env, scope, Some(TyBool), kid(c, 1)));
    }
    if (p == p_postfix()) {
        return eff_postfix(f, env, scope, expected, c);
    }
    if (p == p_group()) {
        return eff_of(f, env, scope, expected, kid(c, 1));
    }
    if (p == p_ident()) {
        return eff_ident(f, env, scope, expected, c);
    }
    if (p == p_match_expr()) {
        return eff_match(f, env, scope, expected, c);
    }
    return None;
}

// acc op operand op operand ...
pub fn eff_fold(fuel: usize, env: FrontEnv, scope: List<Local>, acc: core::option::Option<MEff>, tail: CTree) -> core::option::Option<MEff> {
    if (fuel == 0) {
        return None;
    }
    if (has_kids(tail)) {
        return eff_fold(minus(fuel, 1), env, scope, eff_binary(node_prod(tail), acc, eff_of(minus(fuel, 1), env, scope, None, kid(tail, 1))), kid(tail, 2));
    }
    return acc;
}

// A primary with no postfix, `path(args)`, `x.m(args)`, or `v[index]`
// for a slice local v.
pub fn eff_postfix(fuel: usize, env: FrontEnv, scope: List<Local>, expected: core::option::Option<Ty>, pf: CTree) -> core::option::Option<MEff> {
    if (fuel == 0) {
        return None;
    }
    let f: usize = minus(fuel, 1);
    let primary: CTree = kid(pf, 0);
    let tail: CTree = kid(pf, 1);
    if (node_prod(tail) == p_postfix_end()) {
        return eff_node(f, env, scope, expected, primary);
    }
    if (is_path_call(pf)) {
        return eff_path_call(f, env, scope, expected, kid(primary, 0), kid(tail, 1));
    }
    if (is_method_form(pf)) {
        return eff_method(f, env, scope, expected, pf);
    }
    if (node_prod(primary) == p_ident() && node_prod(kid(primary, 1)) == p_ident_plain() && node_prod(tail) == p_postfix_index() && node_prod(kid(tail, 3)) == p_postfix_end()) {
        return x_index_of(local_of(env, scope, primary), eff_of(f, env, scope, None, kid(tail, 1)));
    }
    if (node_prod(primary) == p_ident() && node_prod(kid(primary, 1)) == p_ident_plain() && node_prod(tail) == p_postfix_call()) {
        return eff_chain(f, env, scope, expected, eff_path_call(f, env, scope, None, kid(primary, 0), kid(tail, 1)), kid(tail, 3));
    }
    return eff_chain(f, env, scope, expected, eff_primary(f, env, scope, primary), tail);
}

// The value a postfix starts from: a local, or any other primary.
pub fn eff_primary(fuel: usize, env: FrontEnv, scope: List<Local>, primary: CTree) -> core::option::Option<MEff> {
    return match (local_of(env, scope, primary)) {
        Some(l) -> Some(XPure(Local(l.id))),
        None -> eff_node(fuel, env, scope, None, primary),
    };
}

// The rest of a postfix after the value x: `.f` (Field of a local, else the
// call of the field's projection), `.m(args)` (the method m of x's type,
// with x the receiver), or `[index]` of a slice local, then what follows.
pub fn eff_chain(fuel: usize, env: FrontEnv, scope: List<Local>, expected: core::option::Option<Ty>, x: core::option::Option<MEff>, tail: CTree) -> core::option::Option<MEff> {
    if (fuel == 0) {
        return None;
    }
    if (node_prod(tail) == p_postfix_end()) {
        return x;
    }
    return match (x) {
        None -> None,
        Some(v) -> eff_step(minus(fuel, 1), env, scope, expected, v, tail),
    };
}

pub fn eff_step(fuel: usize, env: FrontEnv, scope: List<Local>, expected: core::option::Option<Ty>, x: MEff, tail: CTree) -> core::option::Option<MEff> {
    if (fuel == 0) {
        return None;
    }
    let f: usize = minus(fuel, 1);
    if (node_prod(tail) == p_postfix_member() && node_prod(kid(tail, 2)) == p_member_type_args_none()) {
        let next: CTree = kid(tail, 3);
        if (node_prod(next) == p_postfix_call()) {
            return match (list_items(f, kid(next, 1))) {
                None -> None,
                Some(items) -> eff_chain(f, env, scope, expected, eff_found(f, env, scope, step_expected(expected, kid(next, 3)), method_of_ty(f, env, eff_ty(f, env, scope, x), kid_token(tail, 1).text), single(x), items), kid(next, 3)),
            };
        }
        return eff_chain(f, env, scope, expected, field_of_ty(env, x, eff_ty(f, env, scope, x), kid_token(tail, 1).text), next);
    }
    if (node_prod(tail) == p_postfix_index()) {
        return eff_chain(f, env, scope, expected, x_index_of(eff_slice_local(scope, x), eff_of(f, env, scope, None, kid(tail, 1))), kid(tail, 3));
    }
    return None;
}

// A name that is not a local or a constant: a unit variant; or a struct
// literal `S { f: e, ... }`, fields in declared order.
pub fn eff_ident(fuel: usize, env: FrontEnv, scope: List<Local>, expected: core::option::Option<Ty>, c: CTree) -> core::option::Option<MEff> {
    if (fuel == 0) {
        return None;
    }
    let path: CTree = kid(c, 0);
    if (node_prod(kid(c, 1)) == p_ident_plain()) {
        return match (path_spellings(fuel, kid(path, 0), kid(path, 1))) {
            None -> None,
            Some(ss) -> match (split_last(ss)) {
                None -> None,
                Some(s) -> checked_eff(!has_local(local_of(env, scope, c)) && !has_const(find_const(env.decls.consts, module_or(env.home, s.home), s.name)), eff_variant(minus(fuel, 1), env, scope, expected, variant_by_path(env, s), empty())),
            },
        };
    }
    if (node_prod(kid(c, 1)) == p_struct_lit()) {
        return match (path_spellings(fuel, kid(path, 0), kid(path, 1))) {
            None -> None,
            Some(ss) -> match (list_items(fuel, kid(kid(c, 1), 1))) {
                None -> None,
                Some(fs) -> match (type_decl_at(env, ss)) {
                    None -> None,
                    Some(d) -> match (get(env.decls.types, d)) {
                        None -> None,
                        Some(t) -> eff_literal(minus(fuel, 1), env, scope, expected, d, t, fs),
                    },
                },
            },
        };
    }
    return None;
}

pub fn eff_literal(fuel: usize, env: FrontEnv, scope: List<Local>, expected: core::option::Option<Ty>, d: usize, t: TypeDecl, fs: List<CTree>) -> core::option::Option<MEff> {
    if (fuel == 0) {
        return None;
    }
    if (!t.is_enum && same_names(t.fields, fs)) {
        let known: core::option::Option<List<Ty>> = known_args(t, d, expected);
        let expects: core::option::Option<List<Ty>> = field_expects(fuel, env.decls, d, known);
        return checked_eff(!has_tys(known) || has_tys(expects), x_struct_of(fuel, env, scope, d, t, known, eff_list(minus(fuel, 1), env, scope, expects, field_values(fs))));
    }
    return None;
}

// A variant with its payload.
pub fn eff_variant(fuel: usize, env: FrontEnv, scope: List<Local>, expected: core::option::Option<Ty>, v: core::option::Option<VariantAt>, items: List<CTree>) -> core::option::Option<MEff> {
    if (fuel == 0) {
        return None;
    }
    return match (v) {
        None -> None,
        Some(x) -> match (get(env.decls.types, x.owner)) {
            None -> None,
            Some(t) -> checked_eff(!has_tys(known_args(t, x.owner, expected)) || has_tys(variant_expects(fuel, env.decls, x.owner, x.index, known_args(t, x.owner, expected))), x_variant_of(fuel, env, scope, x.owner, t, x.index, known_args(t, x.owner, expected), eff_list(minus(fuel, 1), env, scope, variant_expects(fuel, env.decls, x.owner, x.index, known_args(t, x.owner, expected)), items))),
        },
    };
}

// Expressions in order, each stored at its expected type when known.
pub fn eff_list(fuel: usize, env: FrontEnv, scope: List<Local>, expects: core::option::Option<List<Ty>>, items: List<CTree>) -> core::option::Option<List<MEff>> {
    if (fuel == 0) {
        return None;
    }
    return match (items) {
        Nil -> Some(empty()),
        Cons(c, rest) -> cons_eff(eff_of(minus(fuel, 1), env, scope, head_ty(expects), c), eff_list(minus(fuel, 1), env, scope, tail_tys(expects), unbox(rest))),
    };
}

// `path(args)`: a function, `T::m` for a type parameter T, or a variant.
// slice_stride(x): one argument, a slice local.
pub fn stride_arg(fuel: usize, env: FrontEnv, scope: List<Local>, items: List<CTree>) -> core::option::Option<MEff> {
    return match (items) {
        Nil -> None,
        Cons(a, rest) -> match (unbox(rest)) {
            Nil -> stride_of_postfix(env, scope, peel(fuel, a)),
            Cons(b, more) -> None,
        },
    };
}

pub fn stride_of_postfix(env: FrontEnv, scope: List<Local>, pf: core::option::Option<CTree>) -> core::option::Option<MEff> {
    return match (pf) {
        None -> None,
        Some(x) -> stride_of_local(node_prod(kid(x, 1)) == p_postfix_end(), local_of(env, scope, kid(x, 0))),
    };
}

pub fn stride_of_local(plain: bool, l: core::option::Option<Local>) -> core::option::Option<MEff> {
    if (plain) {
        return match (l) {
            None -> None,
            Some(x) -> match (slice_elem(x.ty)) {
                None -> None,
                Some(e) -> Some(XStride(x.id)),
            },
        };
    }
    return None;
}

pub fn eff_path_call(fuel: usize, env: FrontEnv, scope: List<Local>, expected: core::option::Option<Ty>, path: CTree, args: CTree) -> core::option::Option<MEff> {
    if (fuel == 0) {
        return None;
    }
    let segments: core::option::Option<List<List<usize>>> = path_spellings(fuel, kid(path, 0), kid(path, 1));
    if (is_path(segments, alloc_path()) || is_path(segments, dealloc_path()) || is_path(segments, single(text_slice_from_raw_parts()))) {
        return None;
    }
    if (is_path(segments, single(text_slice_stride()))) {
        return match (list_items(fuel, args)) {
            None -> None,
            Some(items) -> stride_arg(fuel, env, scope, items),
        };
    }
    return match (path_ref(fuel, kid(path, 0), kid(path, 1))) {
        None -> None,
        Some(pr) -> match (named_split(pr.segments)) {
            None -> None,
            Some(s) -> match (list_items(fuel, args)) {
                None -> None,
                Some(items) -> eff_named(minus(fuel, 1), env, scope, expected, s, pr.targs, items),
            },
        },
    };
}

pub fn eff_named(fuel: usize, env: FrontEnv, scope: List<Local>, expected: core::option::Option<Ty>, s: Split, targs: List<CTree>, items: List<CTree>) -> core::option::Option<MEff> {
    if (fuel == 0) {
        return None;
    }
    if (is_fn_path(env, s)) {
        return eff_fn_path(minus(fuel, 1), env, scope, expected, s, targs, items);
    }
    if (no_trees(targs)) {
        return eff_variant(minus(fuel, 1), env, scope, expected, variant_by_path(env, s), items);
    }
    return None;
}

pub fn eff_fn_path(fuel: usize, env: FrontEnv, scope: List<Local>, expected: core::option::Option<Ty>, s: Split, targs: List<CTree>, items: List<CTree>) -> core::option::Option<MEff> {
    if (fuel == 0) {
        return None;
    }
    let owner: core::option::Option<List<usize>> = single_name(s.home);
    if (is_type_param(env, owner) && no_trees(targs)) {
        return match (owner_ty(env, owner)) {
            None -> None,
            Some(t) -> eff_found(minus(fuel, 1), env, scope, expected, find_method(fuel, env.decls, env.decls.fns, 0, s.name, t), empty(), items),
        };
    }
    return match (find_fn(env.decls.fns, module_or(env.home, s.home), s.name, 0)) {
        None -> None,
        Some(d) -> match (get(env.decls.fns, d)) {
            None -> None,
            Some(fd) -> eff_free(minus(fuel, 1), env, scope, expected, d, fd, targs, items),
        },
    };
}

// A free function's call, its type arguments written or inferred.
pub fn eff_free(fuel: usize, env: FrontEnv, scope: List<Local>, expected: core::option::Option<Ty>, d: usize, fd: FnDecl, targs: List<CTree>, items: List<CTree>) -> core::option::Option<MEff> {
    if (fuel == 0) {
        return None;
    }
    if (no_trees(targs)) {
        return eff_infer(minus(fuel, 1), env, scope, expected, d, fd, empty(), empty(), items);
    }
    return match (explicit_inst(fuel, env, d, fd, targs)) {
        None -> None,
        Some(i) -> match (checked_effs(has_tys(param_expects(fuel, env.decls, fd, Some(i.args))), eff_list(minus(fuel, 1), env, scope, param_expects(fuel, env.decls, fd, Some(i.args)), items))) {
            None -> None,
            Some(xs) -> Some(XCall(i, boxed(xs))),
        },
    };
}

// A call whose type arguments are inferred, from start: the arguments
// after pre (the receiver, if any).
pub fn eff_infer(fuel: usize, env: FrontEnv, scope: List<Local>, expected: core::option::Option<Ty>, d: usize, fd: FnDecl, start: List<Bind>, pre: List<MEff>, items: List<CTree>) -> core::option::Option<MEff> {
    if (fuel == 0) {
        return None;
    }
    let names: List<List<usize>> = concat(fd.impl_params, fd.params);
    if (no_names(names)) {
        let expects: core::option::Option<List<Ty>> = param_expects(fuel, env.decls, fd, Some(empty()));
        return checked_eff(has_tys(expects), eff_called(fuel, env, scope, expected, d, fd, start, pre, eff_list(minus(fuel, 1), env, scope, skip_expects(expects, pre), items)));
    }
    return match (param_patterns(fuel, fd)) {
        None -> None,
        Some(ps) -> eff_inferred(fuel, env, scope, d, fd, names, ps, eff_args_bound(minus(fuel, 1), env, scope, fd, names, ps, pre, items, ret_binds(fuel, env.decls, fd, names, start, expected))),
    };
}

// The arguments in order, each read at its parameter's type when the
// bindings so far give it one, and the bindings they extend.
pub fn eff_args_bound(fuel: usize, env: FrontEnv, scope: List<Local>, fd: FnDecl, names: List<List<usize>>, ps: List<CTree>, pre: List<MEff>, items: List<CTree>, binds: core::option::Option<List<Bind>>) -> core::option::Option<ArgsBound> {
    if (fuel == 0) {
        return None;
    }
    let f: usize = minus(fuel, 1);
    return match (binds) {
        None -> None,
        Some(b) -> match (ps) {
            Nil -> match (pre) {
                Nil -> match (items) {
                    Nil -> Some(ArgsBound { args: empty(), binds: b }),
                    Cons(c, more) -> None,
                },
                Cons(x, more) -> None,
            },
            Cons(p, rest) -> match (pre) {
                Cons(x, more) -> cons_bound(x, eff_args_bound(f, env, scope, fd, names, unbox(rest), unbox(more), items, bind_arg(f, env, scope, fd, names, p, x, b))),
                Nil -> match (items) {
                    Nil -> None,
                    Cons(c, more) -> checked_bound(!has_tys(bound_args(names, b)) || has_ty(arg_expected(f, env.decls, fd, names, p, b)), eff_arg_next(f, env, scope, fd, names, p, unbox(rest), unbox(more), b, eff_of(f, env, scope, arg_expected(f, env.decls, fd, names, p, b), c))),
                },
            },
        },
    };
}

pub fn eff_arg_next(fuel: usize, env: FrontEnv, scope: List<Local>, fd: FnDecl, names: List<List<usize>>, p: CTree, ps: List<CTree>, items: List<CTree>, b: List<Bind>, x: core::option::Option<MEff>) -> core::option::Option<ArgsBound> {
    if (fuel == 0) {
        return None;
    }
    return match (x) {
        None -> None,
        Some(v) -> cons_bound(v, eff_args_bound(minus(fuel, 1), env, scope, fd, names, ps, empty(), items, bind_arg(minus(fuel, 1), env, scope, fd, names, p, v, b))),
    };
}

pub fn eff_found(fuel: usize, env: FrontEnv, scope: List<Local>, expected: core::option::Option<Ty>, found: core::option::Option<Found>, pre: List<MEff>, items: List<CTree>) -> core::option::Option<MEff> {
    if (fuel == 0) {
        return None;
    }
    return match (found) {
        None -> None,
        Some(x) -> match (get(env.decls.fns, x.decl)) {
            None -> None,
            Some(fd) -> eff_infer(minus(fuel, 1), env, scope, expected, x.decl, fd, x.binds, pre, items),
        },
    };
}

// `x.m(args)`: `T::m(x, args)` for x's type T.
pub fn eff_method(fuel: usize, env: FrontEnv, scope: List<Local>, expected: core::option::Option<Ty>, pf: CTree) -> core::option::Option<MEff> {
    if (fuel == 0) {
        return None;
    }
    let tail: CTree = kid(pf, 1);
    return match (local_of(env, scope, kid(pf, 0))) {
        None -> None,
        Some(x) -> match (list_items(fuel, kid(kid(tail, 3), 1))) {
            None -> None,
            Some(items) -> eff_found(minus(fuel, 1), env, scope, expected, find_method(fuel, env.decls, env.decls.fns, 0, kid_token(tail, 1).text, x.ty), single(XPure(Local(x.id))), items),
        },
    };
}

// `match (scrutinee) { arms }`: the scrutinee of an enum type, one arm per
// variant in order.
pub fn eff_match(fuel: usize, env: FrontEnv, scope: List<Local>, expected: core::option::Option<Ty>, m: CTree) -> core::option::Option<MEff> {
    if (fuel == 0) {
        return None;
    }
    return eff_match_on(minus(fuel, 1), env, scope, expected, eff_of(minus(fuel, 1), env, scope, None, kid(m, 2)), m);
}

pub fn eff_match_on(fuel: usize, env: FrontEnv, scope: List<Local>, expected: core::option::Option<Ty>, s: core::option::Option<MEff>, m: CTree) -> core::option::Option<MEff> {
    if (fuel == 0) {
        return None;
    }
    return match (s) {
        None -> None,
        Some(x) -> match (eff_ty(fuel, env, scope, x)) {
            None -> None,
            Some(ety) -> match (named_parts(ety)) {
                None -> None,
                Some(n) -> match (get(env.decls.types, n.decl)) {
                    None -> None,
                    Some(t) -> eff_match_enum(minus(fuel, 1), env, scope, expected, x, ety, t, payload_tys(fuel, env.decls, n.decl, n.args), m),
                },
            },
        },
    };
}

pub fn eff_match_enum(fuel: usize, env: FrontEnv, scope: List<Local>, expected: core::option::Option<Ty>, x: MEff, ety: Ty, t: TypeDecl, payloads: core::option::Option<List<List<Ty>>>, m: CTree) -> core::option::Option<MEff> {
    if (fuel == 0) {
        return None;
    }
    if (t.is_enum) {
        return match (payloads) {
            None -> None,
            Some(ps) -> match (list_items(fuel, kid(m, 5))) {
                None -> None,
                Some(arms) -> x_match_of(x, ety, expected, eff_arms_ordered(minus(fuel, 1), env, scope, expected, t, zip_variants(t.variants, ps), arms)),
            },
        };
    }
    return None;
}

pub fn eff_arms_ordered(fuel: usize, env: FrontEnv, scope: List<Local>, expected: core::option::Option<Ty>, owner: TypeDecl, variants: List<VariantTy>, arms: List<CTree>) -> core::option::Option<List<EffArm>> {
    if (fuel == 0) {
        return None;
    }
    return match (arms_in_order(fuel, owner, variants, arms)) {
        None -> None,
        Some(os) -> eff_arms(minus(fuel, 1), env, scope, expected, owner, variants, os),
    };
}

// Arm k is variant k.
pub fn eff_arms(fuel: usize, env: FrontEnv, scope: List<Local>, expected: core::option::Option<Ty>, owner: TypeDecl, variants: List<VariantTy>, arms: List<CTree>) -> core::option::Option<List<EffArm>> {
    if (fuel == 0) {
        return None;
    }
    return match (variants) {
        Nil -> match (arms) {
            Nil -> Some(empty()),
            Cons(a, more) -> None,
        },
        Cons(v, rest) -> match (arms) {
            Nil -> None,
            Cons(a, more) -> cons_eff_arm(eff_arm(minus(fuel, 1), env, scope, expected, owner, v, a), eff_arms(minus(fuel, 1), env, scope, expected, owner, unbox(rest), unbox(more))),
        },
    };
}

// `V -> value` or `V(b, ...) -> value`.
pub fn eff_arm(fuel: usize, env: FrontEnv, scope: List<Local>, expected: core::option::Option<Ty>, owner: TypeDecl, v: VariantTy, arm: CTree) -> core::option::Option<EffArm> {
    if (fuel == 0) {
        return None;
    }
    let pattern: CTree = kid(arm, 0);
    let ptail: CTree = kid(pattern, 1);
    let path: CTree = kid(pattern, 0);
    if (node_prod(pattern) == p_pattern_ident() && arm_named(path_spellings(fuel, kid(path, 0), kid(path, 1)), owner, v.name)) {
        if (node_prod(ptail) == p_pattern_plain()) {
            return eff_arm_bound(minus(fuel, 1), env, expected, Some(Bound { ids: empty(), scope: scope }), kid(arm, 2));
        }
        return match (list_items(fuel, kid(ptail, 1))) {
            None -> None,
            Some(pats) -> eff_arm_bound(minus(fuel, 1), env, expected, binders_of(env, scope, pats, v.payload), kid(arm, 2)),
        };
    }
    return None;
}

pub fn eff_arm_bound(fuel: usize, env: FrontEnv, expected: core::option::Option<Ty>, bound: core::option::Option<Bound>, value: CTree) -> core::option::Option<EffArm> {
    if (fuel == 0) {
        return None;
    }
    return match (bound) {
        None -> None,
        Some(b) -> arm_eff(fuel, env, b, diverge_arm(env.decls, expected, eff_of(minus(fuel, 1), env, b.scope, expected, value))),
    };
}
// extract: mutual end

// A statement over an effectful value whose value is pure takes the pure
// statement's form, so a pure value has one reading.
pub fn return_eff(x: MEff) -> MStmt {
    return match (pure_part(x)) {
        Some(v) -> MReturn(v),
        None -> MReturnEval(x),
    };
}

pub fn if_eff(x: MEff, a: MStmt, b: MStmt) -> MStmt {
    return match (pure_part(x)) {
        Some(v) -> MIf(v, boxed(a), boxed(b)),
        None -> MIfEval(x, boxed(a), boxed(b)),
    };
}

pub fn while_eff(x: MEff, body: MStmt) -> MStmt {
    return match (pure_part(x)) {
        Some(v) -> MWhile(v, boxed(body)),
        None -> MWhileEval(x, boxed(body)),
    };
}

pub fn set_eff(id: usize, x: MEff) -> MStmt {
    return match (pure_part(x)) {
        Some(v) -> MSet(id, v),
        None -> MSetEval(id, x),
    };
}

pub fn set_field_eff(id: usize, j: usize, x: MEff) -> MStmt {
    return match (pure_part(x)) {
        Some(v) -> MSetField(id, j, v),
        None -> MSetFieldEval(id, j, x),
    };
}

pub fn set_index_pure(slice: usize, i: MEff, v: MEff, value: core::option::Option<SrcExpr>) -> MStmt {
    return match (pure_part(i)) {
        None -> MSetIndexEval(slice, i, v),
        Some(a) -> match (value) {
            None -> MSetIndexEval(slice, i, v),
            Some(b) -> MSetIndex(slice, a, b),
        },
    };
}

pub fn set_index_eff(slice: usize, i: MEff, v: MEff) -> MStmt {
    return set_index_pure(slice, i, v, pure_part(v));
}

pub fn struct_head(ok: bool, x: MEff, values: core::option::Option<List<SrcExpr>>) -> LetHead {
    if (ok) {
        return match (values) {
            None -> EvalOf(x),
            Some(es) -> LiteralOf(es),
        };
    }
    return EvalOf(x);
}

pub fn variant_let_head(ok: bool, x: MEff, index: usize, payload: core::option::Option<List<SrcExpr>>) -> LetHead {
    if (ok) {
        return match (payload) {
            None -> EvalOf(x),
            Some(es) -> VariantOf(index, es),
        };
    }
    return EvalOf(x);
}

pub fn pure_arms(binders: List<List<usize>>, values: List<MEff>) -> core::option::Option<List<SrcArm>> {
    return match (binders) {
        Nil -> match (values) {
            Nil -> Some(empty()),
            Cons(v, more) -> None,
        },
        Cons(b, rest) -> match (values) {
            Nil -> None,
            Cons(v, more) -> match (pure_part(v)) {
                None -> None,
                Some(e) -> match (pure_arms(unbox(rest), unbox(more))) {
                    None -> None,
                    Some(arms) -> Some(cons(SrcArm { binders: b, value: e }, arms)),
                },
            },
        },
    };
}

pub fn match_let_head(x: MEff, scrutinee: core::option::Option<usize>, ety: Ty, arms: core::option::Option<List<SrcArm>>) -> LetHead {
    return match (scrutinee) {
        None -> EvalOf(x),
        Some(id) -> match (arms) {
            None -> EvalOf(x),
            Some(a) -> MatchOf(id, ety, a),
        },
    };
}

pub fn index_let_head(x: MEff, slice: usize, index: core::option::Option<SrcExpr>) -> LetHead {
    return match (index) {
        None -> EvalOf(x),
        Some(i) -> IndexOf(slice, i),
    };
}

pub fn call_let_head(x: MEff, c: core::option::Option<Called>) -> LetHead {
    return match (c) {
        None -> EvalOf(x),
        Some(called) -> CallOf(called),
    };
}

// What a let of type ty binds when its value reads as x: a pure value, a
// call with pure arguments, a literal or variant of type ty with pure
// fields, an element of a slice local at a pure index, a match of a local
// with pure arm values, or else the effectful expression.
pub fn eval_let_head(ty: Ty, x: MEff) -> LetHead {
    return match (x) {
        XPure(e) -> Plain(e),
        XCall(inst, args) -> call_let_head(x, call_parts(x)),
        XApply(op, l, r) -> EvalOf(x),
        XNeg(a) -> EvalOf(x),
        XNot(a) -> EvalOf(x),
        XCast(t, a) -> EvalOf(x),
        XIndex(sl, i) -> index_let_head(x, sl, pure_part(unbox(i))),
        XStruct(t, vs) -> struct_head(same_ty(t, ty), x, pure_list(unbox(vs))),
        XVariant(t, index, ps) -> variant_let_head(same_ty(t, ty), x, index, pure_list(unbox(ps))),
        XMatch(sc, ety, rt, binders, values) -> match_let_head(x, eff_local(unbox(sc)), ety, pure_arms(binders, unbox(values))),
        XDivide(op, l, r) -> EvalOf(x),
        XStride(sl) -> EvalOf(x),
    };
}

pub fn eval_head(ty: Ty, x: core::option::Option<MEff>) -> core::option::Option<LetHead> {
    return match (x) {
        None -> None,
        Some(e) -> Some(eval_let_head(ty, e)),
    };
}

// The head of `let x: ty = init;`: an allocation or a raw view, or else what
// its value reads as.
pub fn let_head_or_eval(fuel: usize, env: FrontEnv, scope: List<Local>, ty: Ty, init: CTree) -> core::option::Option<LetHead> {
    return match (let_head(fuel, env, scope, init)) {
        Some(h) -> Some(h),
        None -> eval_head(ty, eff_of(fuel, env, scope, Some(ty), init)),
    };
}

pub fn then_rest(h: MStmt, rest: core::option::Option<MStmt>) -> core::option::Option<MStmt> {
    return match (rest) {
        None -> None,
        Some(r) -> Some(MThen(boxed(h), boxed(r))),
    };
}

pub fn then_of(head: core::option::Option<MStmt>, rest: core::option::Option<MStmt>) -> core::option::Option<MStmt> {
    return match (head) {
        None -> None,
        Some(h) -> then_rest(h, rest),
    };
}

pub fn is_ptr_ty(t: Ty) -> bool {
    return match (t) {
        TyI32 -> false,
        TyBool -> false,
        TyUint(k) -> false,
        TyPtr -> true,
        TyIsize -> false,
        TyChar -> false,
        TySlice(e) -> false,
        TyNamed(d, args) -> false,
        TySint(k) -> false,
    };
}

pub fn alloc_let(ok: bool, id: usize, size: SrcExpr, shift: usize, body: MStmt) -> core::option::Option<MStmt> {
    if (ok) {
        return Some(MLetAlloc(id, size, shift, boxed(body)));
    }
    return None;
}

pub fn slice_let(element: core::option::Option<Ty>, id: usize, pointer: SrcExpr, length: SrcExpr, body: MStmt) -> core::option::Option<MStmt> {
    return match (element) {
        None -> None,
        Some(e) -> Some(MLetSlice(id, e, pointer, length, boxed(body))),
    };
}

// An allocation binds a `ptr`, a raw view a `[T]`.
pub fn let_stmt(id: usize, ty: Ty, head: LetHead, body: MStmt) -> core::option::Option<MStmt> {
    return match (head) {
        Plain(e) -> Some(MLet(id, ty, e, boxed(body))),
        CallOf(c) -> Some(MLetCall(id, ty, c.inst, c.args, boxed(body))),
        VariantOf(variant, payload) -> Some(MLetEnum(id, ty, variant, payload, boxed(body))),
        LiteralOf(fields) -> Some(MLetStruct(id, ty, fields, boxed(body))),
        MatchOf(scrutinee, sty, arms) -> Some(MLetMatch(id, ty, scrutinee, sty, arms, boxed(body))),
        AllocOf(size, shift) -> alloc_let(is_ptr_ty(ty), id, size, shift, body),
        SliceOf(pointer, length) -> slice_let(slice_elem(ty), id, pointer, length, body),
        IndexOf(slice, index) -> Some(MLetIndex(id, ty, slice, index, boxed(body))),
        EvalOf(x) -> Some(MLetEval(id, ty, x, boxed(body))),
    };
}

pub fn let_body(id: usize, ty: Ty, h: LetHead, body: core::option::Option<MStmt>) -> core::option::Option<MStmt> {
    return match (body) {
        None -> None,
        Some(b) -> let_stmt(id, ty, h, b),
    };
}

pub fn let_of(id: usize, ty: Ty, head: core::option::Option<LetHead>, body: core::option::Option<MStmt>) -> core::option::Option<MStmt> {
    return match (head) {
        None -> None,
        Some(h) -> let_body(id, ty, h, body),
    };
}

pub fn return_eval_of(x: core::option::Option<MEff>) -> core::option::Option<MStmt> {
    return match (x) {
        None -> None,
        Some(e) -> Some(return_eff(e)),
    };
}

// `return e;`, e pure or else effectful (stored at the result type).
pub fn slice_returned(id: usize, el: Ty, h: core::option::Option<LetHead>) -> core::option::Option<MStmt> {
    return match (h) {
        None -> None,
        Some(head) -> match (head) {
            Plain(x) -> None,
            CallOf(c) -> None,
            VariantOf(variant, payload) -> None,
            LiteralOf(fields) -> None,
            MatchOf(scrutinee, sty, arms) -> None,
            AllocOf(size, shift) -> None,
            SliceOf(pointer, length) -> Some(MLetSlice(id, el, pointer, length, boxed(MReturn(Local(id))))),
            IndexOf(slice, index) -> None,
            EvalOf(x) -> None,
        },
    };
}

// `return slice_from_raw_parts(pointer, length);` in a function whose
// result is a slice: a slice local, then its return. The local's id is the
// offset of the value's first token, which no binding has.
pub fn return_slice(fuel: usize, env: FrontEnv, scope: List<Local>, e: CTree) -> core::option::Option<MStmt> {
    return match (env.ret) {
        None -> None,
        Some(t) -> match (slice_elem(t)) {
            None -> None,
            Some(el) -> match (tree_tokens(e)) {
                Nil -> None,
                Cons(first, rest) -> slice_returned(minus(first.start, env.base), el, let_head(fuel, env, scope, e)),
            },
        },
    };
}

pub fn return_or_eval(fuel: usize, env: FrontEnv, scope: List<Local>, e: CTree) -> core::option::Option<MStmt> {
    return match (return_slice(fuel, env, scope, e)) {
        Some(m) -> Some(m),
        None -> return_eval_of(eff_of(fuel, env, scope, env.ret, e)),
    };
}

pub fn if_eval_of(c: core::option::Option<MEff>, a: core::option::Option<MStmt>, b: core::option::Option<MStmt>) -> core::option::Option<MStmt> {
    return match (c) {
        None -> None,
        Some(x) -> match (a) {
            None -> None,
            Some(s) -> match (b) {
                None -> None,
                Some(t) -> Some(if_eff(x, s, t)),
            },
        },
    };
}

// `if (c) { a } else { b }`, c pure or else effectful.
pub fn if_or_eval(fuel: usize, env: FrontEnv, scope: List<Local>, c: CTree, a: core::option::Option<MStmt>, b: core::option::Option<MStmt>) -> core::option::Option<MStmt> {
    return if_eval_of(eff_of(fuel, env, scope, Some(TyBool), c), a, b);
}

pub fn while_eval_of(c: core::option::Option<MEff>, body: core::option::Option<MStmt>) -> core::option::Option<MStmt> {
    return match (c) {
        None -> None,
        Some(x) -> match (body) {
            None -> None,
            Some(b) -> Some(while_eff(x, b)),
        },
    };
}

// `while (c) { body }`, c pure or else effectful.
pub fn while_or_eval(fuel: usize, env: FrontEnv, scope: List<Local>, c: CTree, body: core::option::Option<MStmt>) -> core::option::Option<MStmt> {
    return while_eval_of(eff_of(fuel, env, scope, Some(TyBool), c), body);
}

pub fn set_eval_of(id: usize, x: core::option::Option<MEff>) -> core::option::Option<MStmt> {
    return match (x) {
        None -> None,
        Some(e) -> match (call_parts(e)) {
            Some(c) -> Some(MSetCall(id, c.inst, c.args)),
            None -> Some(set_eff(id, e)),
        },
    };
}

// `x = value;`: a statement form, or else an effectful expression.
pub fn set_or_eval(fuel: usize, env: FrontEnv, scope: List<Local>, l: Local, value: CTree) -> core::option::Option<MStmt> {
    return set_eval_of(l.id, eff_of(fuel, env, scope, Some(l.ty), value));
}

pub fn set_index_eval_of(slice: usize, index: core::option::Option<MEff>, value: core::option::Option<MEff>) -> core::option::Option<MStmt> {
    return match (index) {
        None -> None,
        Some(i) -> match (value) {
            None -> None,
            Some(v) -> Some(set_index_eff(slice, i, v)),
        },
    };
}

// `v[index] = value;`
pub fn set_index_or_eval(fuel: usize, env: FrontEnv, scope: List<Local>, l: Local, index: CTree, value: CTree) -> core::option::Option<MStmt> {
    return set_index_eval_of(l.id, eff_of(fuel, env, scope, None, index), eff_of(fuel, env, scope, slice_elem(l.ty), value));
}

pub fn field_eval_stmt(id: usize, j: usize, x: core::option::Option<MEff>) -> core::option::Option<MStmt> {
    return match (x) {
        None -> None,
        Some(e) -> Some(set_field_eff(id, j, e)),
    };
}

// Field j's type in a struct type.
pub fn field_ty_at(fuel: usize, decls: Decls, t: Ty, j: usize) -> core::option::Option<Ty> {
    return match (struct_field_tys(fuel, decls, t)) {
        None -> None,
        Some(ts) -> get(ts, j),
    };
}

// `x.f = value;`: value pure, or else effectful (stored at the field's type).
pub fn set_field_or_eval(fuel: usize, env: FrontEnv, scope: List<Local>, l: Local, name: List<usize>, value: CTree) -> core::option::Option<MStmt> {
    return match (field_index(env, l.ty, name)) {
        None -> None,
        Some(j) -> checked_stmt(has_ty(field_ty_at(fuel, env.decls, l.ty, j)), field_eval_stmt(l.id, j, eff_of(fuel, env, scope, field_ty_at(fuel, env.decls, l.ty, j), value))),
    };
}

pub fn assign_target(fuel: usize, env: FrontEnv, scope: List<Local>, target: CTree, value: CTree) -> core::option::Option<MStmt> {
    let tail: CTree = kid(target, 1);
    if (node_prod(tail) == p_postfix_end()) {
        return match (local_of(env, scope, kid(target, 0))) {
            None -> None,
            Some(l) -> set_or_eval(fuel, env, scope, l, value),
        };
    }
    if (node_prod(tail) == p_postfix_member() && node_prod(kid(tail, 2)) == p_member_type_args_none() && node_prod(kid(tail, 3)) == p_postfix_end()) {
        return match (local_of(env, scope, kid(target, 0))) {
            None -> None,
            Some(l) -> set_field_or_eval(fuel, env, scope, l, kid_token(tail, 1).text, value),
        };
    }
    if (node_prod(tail) == p_postfix_index() && node_prod(kid(tail, 3)) == p_postfix_end()) {
        return match (local_of(env, scope, kid(target, 0))) {
            None -> None,
            Some(l) -> set_index_or_eval(fuel, env, scope, l, kid(tail, 1), value),
        };
    }
    return None;
}

pub fn free_shifted(pointer: SrcExpr, size: SrcExpr, shift: core::option::Option<usize>, more: List<SrcExpr>) -> core::option::Option<MStmt> {
    return match (shift) {
        None -> None,
        Some(k) -> match (more) {
            Nil -> Some(MFree(pointer, size, k)),
            Cons(e, others) -> None,
        },
    };
}

// dealloc(pointer, size, align)
pub fn free_of(args: core::option::Option<List<SrcExpr>>) -> core::option::Option<MStmt> {
    return match (args) {
        None -> None,
        Some(es) -> match (es) {
            Nil -> None,
            Cons(pointer, rest) -> match (unbox(rest)) {
                Nil -> None,
                Cons(size, more) -> match (unbox(more)) {
                    Nil -> None,
                    Cons(align, others) -> free_shifted(pointer, size, shift_of(align), unbox(others)),
                },
            },
        },
    };
}

pub fn discard_of(x: core::option::Option<MEff>) -> core::option::Option<MStmt> {
    return match (x) {
        None -> None,
        Some(e) -> Some(MDiscard(e)),
    };
}

pub fn assert_of(x: core::option::Option<MEff>) -> core::option::Option<MStmt> {
    return match (x) {
        None -> None,
        Some(e) -> Some(MAssert(e)),
    };
}

// `assert(c)`: its one argument, a bool.
pub fn assert_arg(fuel: usize, env: FrontEnv, scope: List<Local>, args: core::option::Option<List<CTree>>) -> core::option::Option<MStmt> {
    return match (args) {
        None -> None,
        Some(items) -> match (items) {
            Nil -> None,
            Cons(c, rest) -> match (unbox(rest)) {
                Nil -> assert_of(eff_of(fuel, env, scope, Some(TyBool), c)),
                Cons(d, more) -> None,
            },
        },
    };
}

// A call statement: `alloc::allocator::dealloc(pointer, size, align);`,
// `assert(c);`, or a call whose value (if any) is discarded.
pub fn call_stmt(fuel: usize, env: FrontEnv, scope: List<Local>, pf: CTree) -> core::option::Option<MStmt> {
    let path: CTree = kid(kid(pf, 0), 0);
    if (is_path_call(pf) && is_path(path_spellings(fuel, kid(path, 0), kid(path, 1)), dealloc_path())) {
        return free_of(args_of(fuel, env, scope, kid(kid(pf, 1), 1)));
    }
    if (is_path_call(pf) && is_path(path_spellings(fuel, kid(path, 0), kid(path, 1)), single(text_assert()))) {
        return assert_arg(fuel, env, scope, list_items(fuel, kid(kid(pf, 1), 1)));
    }
    if (is_path_call(pf) || is_method_form(pf)) {
        return discard_of(eff_postfix(fuel, env, scope, None, pf));
    }
    return None;
}

// The operator of a compound assignment `+=`, `-=`, `*=`, `&=`, `|=`, `^=`,
// `<<=`, `>>=`.
pub fn compound_op(p: usize) -> core::option::Option<SrcOp> {
    if (p == p_assign_add()) {
        return Some(Plus);
    }
    if (p == p_assign_sub()) {
        return Some(Minus);
    }
    if (p == p_assign_mul()) {
        return Some(Times);
    }
    if (p == p_assign_band()) {
        return Some(BitAnd);
    }
    if (p == p_assign_bor()) {
        return Some(BitOr);
    }
    if (p == p_assign_xor()) {
        return Some(BitXor);
    }
    if (p == p_assign_shl()) {
        return Some(ShiftLeft);
    }
    if (p == p_assign_shr()) {
        return Some(ShiftRight);
    }
    return None;
}

// `x op= e` as an effectful expression, also for `/=` and `%=`.
pub fn compound_eff(p: usize, left: MEff, right: core::option::Option<MEff>) -> core::option::Option<MEff> {
    if (p == p_assign_div()) {
        return x_divide_of(Quotient, Some(left), right);
    }
    if (p == p_assign_mod()) {
        return x_divide_of(Remainder, Some(left), right);
    }
    return match (compound_op(p)) {
        None -> None,
        Some(o) -> x_apply_of(o, Some(left), right),
    };
}

// `x.f op= e`, when e or op is effectful.
pub fn compound_field_eval(fuel: usize, env: FrontEnv, scope: List<Local>, l: Local, index: core::option::Option<usize>, p: usize, value: CTree) -> core::option::Option<MStmt> {
    return match (index) {
        None -> None,
        Some(j) -> checked_stmt(has_ty(field_ty_at(fuel, env.decls, l.ty, j)), field_eval_stmt(l.id, j, compound_eff(p, XPure(Field(l.id, j)), eff_of(fuel, env, scope, field_ty_at(fuel, env.decls, l.ty, j), value)))),
    };
}

// `x op= e` or `x.f op= e`, when e or op is effectful.
pub fn compound_eval(fuel: usize, env: FrontEnv, scope: List<Local>, target: CTree, p: usize, value: CTree) -> core::option::Option<MStmt> {
    if (node_prod(kid(target, 1)) == p_postfix_end()) {
        return match (local_of(env, scope, kid(target, 0))) {
            None -> None,
            Some(l) -> set_eval_of(l.id, compound_eff(p, XPure(Local(l.id)), eff_of(fuel, env, scope, Some(l.ty), value))),
        };
    }
    let tail: CTree = kid(target, 1);
    if (node_prod(tail) == p_postfix_member() && node_prod(kid(tail, 2)) == p_member_type_args_none() && node_prod(kid(tail, 3)) == p_postfix_end()) {
        return match (local_of(env, scope, kid(target, 0))) {
            None -> None,
            Some(l) -> compound_field_eval(fuel, env, scope, l, field_index(env, l.ty, kid_token(tail, 1).text), p, value),
        };
    }
    return None;
}

pub fn compound_of(fuel: usize, env: FrontEnv, scope: List<Local>, target: core::option::Option<CTree>, p: usize, value: CTree) -> core::option::Option<MStmt> {
    return match (target) {
        None -> None,
        Some(t) -> compound_eval(fuel, env, scope, t, p, value),
    };
}

// `target = value;`: target a local, a field of one or a slice element;
// value a call (to a plain local) or an expression. Also `target op=
// value;`, and the call statement `dealloc(...)`.
pub fn assignment(fuel: usize, env: FrontEnv, scope: List<Local>, e: CTree) -> core::option::Option<MStmt> {
    let a: CTree = kid(e, 0);
    let set: CTree = kid(a, 1);
    if (node_prod(e) == p_expr() && node_prod(a) == p_assign() && node_prod(set) == p_assign_set()) {
        return match (peel(fuel, kid(a, 0))) {
            None -> None,
            Some(target) -> assign_target(fuel, env, scope, target, kid(set, 1)),
        };
    }
    if (node_prod(e) == p_expr() && node_prod(a) == p_assign() && has_kids(set) && node_prod(set) != p_assign_set()) {
        return compound_of(fuel, env, scope, peel(fuel, kid(a, 0)), node_prod(set), kid(set, 1));
    }
    if (node_prod(e) == p_expr() && node_prod(a) == p_assign() && node_prod(set) == p_assign_end()) {
        return match (peel(fuel, kid(a, 0))) {
            None -> None,
            Some(pf) -> call_stmt(fuel, env, scope, pf),
        };
    }
    return None;
}

// The reading of a range loop (for_of): counter c from a, bound e = n,
// the loop variable x.
pub fn for_range(c: usize, e: usize, x: usize, t: Ty, a: SrcExpr, n: usize, body: core::option::Option<MStmt>) -> core::option::Option<MStmt> {
    return match (body) {
        None -> None,
        Some(b) -> Some(MLet(c, t, a, boxed(MLet(e, t, Local(n), boxed(MWhile(Apply(Less, boxed(Local(c)), boxed(Local(e))), boxed(MLet(x, t, Local(c), boxed(MThen(boxed(MSet(c, Apply(Plus, boxed(Local(c)), boxed(Int(1))))), boxed(b))))))))))),
    };
}

// extract: mutual begin
// A statement list: a let scopes over the statements after it.
pub fn block_of(fuel: usize, env: FrontEnv, scope: List<Local>, list: CTree) -> core::option::Option<MStmt> {
    if (fuel == 0) {
        return None;
    }
    return match (list_items(fuel, list)) {
        None -> None,
        Some(items) -> stmts_of(minus(fuel, 1), env, scope, items),
    };
}

pub fn stmts_of(fuel: usize, env: FrontEnv, scope: List<Local>, items: List<CTree>) -> core::option::Option<MStmt> {
    if (fuel == 0) {
        return None;
    }
    return match (items) {
        Nil -> Some(MNop),
        Cons(s, rest) -> stmt_first(minus(fuel, 1), env, scope, s, unbox(rest)),
    };
}

pub fn stmt_first(fuel: usize, env: FrontEnv, scope: List<Local>, s: CTree, rest: List<CTree>) -> core::option::Option<MStmt> {
    if (fuel == 0) {
        return None;
    }
    if (node_prod(s) == p_let_stmt()) {
        return let_first(minus(fuel, 1), env, scope, s, rest);
    }
    return match (rest) {
        Nil -> stmt_of(minus(fuel, 1), env, scope, s),
        Cons(next, more) -> then_of(stmt_of(minus(fuel, 1), env, scope, s), stmts_of(minus(fuel, 1), env, scope, rest)),
    };
}

// `let x: ty = init;` (let_stmt -> Let LetIdent let_type let_init LetSemicolon).
pub fn let_first(fuel: usize, env: FrontEnv, scope: List<Local>, s: CTree, rest: List<CTree>) -> core::option::Option<MStmt> {
    if (fuel == 0) {
        return None;
    }
    let tok: Token = kid_token(s, 1);
    if (node_prod(kid(s, 2)) == p_let_type() && node_prod(kid(s, 3)) == p_let_init() && !member(env.globals, tok.text) && fresh_id(scope, minus(tok.start, env.base))) {
        return match (ty_of(fuel, env, kid(kid(s, 2), 1))) {
            None -> None,
            Some(t) -> let_of(minus(tok.start, env.base), t, let_head_or_eval(minus(fuel, 1), env, scope, t, kid(kid(s, 3), 1)), stmts_of(minus(fuel, 1), env, cons(Local { name: tok.text, id: minus(tok.start, env.base), ty: t }, scope), rest)),
        };
    }
    return None;
}

// return, break, continue, if, while, for, block statements, and assignments.
pub fn stmt_of(fuel: usize, env: FrontEnv, scope: List<Local>, s: CTree) -> core::option::Option<MStmt> {
    if (fuel == 0) {
        return None;
    }
    let f: usize = minus(fuel, 1);
    let p: usize = node_prod(s);
    if (p == p_return_stmt() && node_prod(kid(s, 1)) == p_return_value()) {
        return return_or_eval(f, env, scope, kid(kid(s, 1), 0));
    }
    if (p == p_return_stmt() && node_prod(kid(s, 1)) == p_return_void()) {
        return Some(MReturnUnit);
    }
    if (p == p_break_stmt()) {
        return Some(MBreak);
    }
    if (p == p_continue_stmt()) {
        return Some(MContinue);
    }
    if (p == p_if_stmt() && node_prod(kid(s, 5)) == p_else_stmt()) {
        return if_or_eval(f, env, scope, kid(s, 2), block_of(f, env, scope, kid(kid(s, 4), 1)), block_of(f, env, scope, kid(kid(kid(s, 5), 1), 1)));
    }
    if (p == p_if_stmt() && node_prod(kid(s, 5)) == p_else_none()) {
        return if_or_eval(f, env, scope, kid(s, 2), block_of(f, env, scope, kid(kid(s, 4), 1)), Some(MNop));
    }
    if (p == p_while_stmt()) {
        return while_or_eval(f, env, scope, kid(s, 2), block_of(f, env, scope, kid(kid(s, 4), 1)));
    }
    if (p == p_for_stmt() || p == p_block_stmt()) {
        return nested_of(f, env, scope, s);
    }
    if (p == p_expr_stmt()) {
        return assignment(f, env, scope, kid(s, 0));
    }
    return None;
}

// for and block statements.
pub fn nested_of(fuel: usize, env: FrontEnv, scope: List<Local>, s: CTree) -> core::option::Option<MStmt> {
    if (fuel == 0) {
        return None;
    }
    let f: usize = minus(fuel, 1);
    if (node_prod(s) == p_for_stmt()) {
        return for_of(f, env, scope, s);
    }
    if (node_prod(s) == p_block_stmt()) {
        return block_of(f, env, scope, kid(kid(s, 0), 1));
    }
    return None;
}
// extract: mutual end

// `for x in a..n { body }`, a an integer literal and n a local (for_stmt ->
// For Ident In for_iterable block), read as `let c = a; let e = n; while (c
// < e) { let x = c; c = c + 1; body }`: n is read once, and a `continue` in
// body moves to the next value. The hidden c and e are numbered by the `for`
// token and x's token, and x by the `in` token, so that the locals are
// numbered in the order the desugared text declares them.
// extract: inline
fn for_of(ffuel: usize, fenv: FrontEnv, fscope: List<Local>, fs: CTree) -> core::option::Option<MStmt> {
    let x: Token = kid_token(fs, 1);
    let iter: CTree = kid(fs, 3);
    let bound: CTree = kid(kid(kid(iter, 1), 1), 0);
    if (node_prod(iter) == p_for_iter_range_from_start() && node_prod(kid(iter, 0)) == p_range_start_int() && node_prod(kid(iter, 1)) == p_range_exclusive() && node_prod(kid(kid(iter, 1), 1)) == p_range_bound() && node_prod(bound) == p_range_bound_name() && node_prod(kid(bound, 1)) == p_postfix_end() && !member(fenv.globals, x.text) && fresh_id(fscope, minus(x.start, fenv.base)) && fresh_id(fscope, minus(kid_token(fs, 0).start, fenv.base)) && fresh_id(fscope, minus(kid_token(fs, 2).start, fenv.base))) {
        return match (find_local(fscope, kid_token(kid(bound, 0), 0).text)) {
            None -> None,
            Some(n) -> match (int_literal(kid_token(kid(iter, 0), 0).text)) {
                None -> None,
                Some(a) -> for_range(minus(kid_token(fs, 0).start, fenv.base), minus(x.start, fenv.base), minus(kid_token(fs, 2).start, fenv.base), n.ty, a, n.id, block_of(ffuel, fenv, cons(Local { name: x.text, id: minus(kid_token(fs, 2).start, fenv.base), ty: n.ty }, fscope), kid(kid(fs, 4), 1))),
            },
        };
    }
    return None;
}

// ---------------------------------------------------------------- functions

pub struct MParam {
    id: usize,
    ty: Ty,
}

// A function's result type: a type, or unit (no `-> T`, or `-> !`).
pub enum RetTy {
    RetUnit,
    RetOf(Ty),
}

pub struct MFunc {
    params: List<MParam>,
    ret: RetTy,
    body: MStmt,
}

// Parameters, and the scope they make (the last one innermost).
pub struct MParams {
    params: List<MParam>,
    scope: List<Local>,
}

pub fn cons_param(p: MParam, rest: core::option::Option<MParams>) -> core::option::Option<MParams> {
    return match (rest) {
        None -> None,
        Some(r) -> Some(MParams { params: cons(p, r.params), scope: r.scope }),
    };
}

// A parameter's name token: `self` after the `&` of `&self`.
pub fn param_token(p: CTree) -> Token {
    if (node_prod(p) == p_param_self_ref()) {
        return kid_token(p, 1);
    }
    return kid_token(p, 0);
}

// `name: T`, `self` or `&self` (both by value); each a local named by its
// spelling.
pub fn params_of(fuel: usize, env: FrontEnv, fd: FnDecl, scope: List<Local>, items: List<CTree>) -> core::option::Option<MParams> {
    return match (items) {
        Nil -> Some(MParams { params: empty(), scope: scope }),
        Cons(p, rest) -> param_of(fuel, env, fd, scope, p, unbox(rest)),
    };
}

// extract: inline
fn param_of(pfuel: usize, penv: FrontEnv, pfd: FnDecl, pscope: List<Local>, pp: CTree, prest: List<CTree>) -> core::option::Option<MParams> {
    let tok: Token = param_token(pp);
    if ((node_prod(pp) == p_param_named() || node_prod(pp) == p_param_self() || node_prod(pp) == p_param_self_ref()) && !member(penv.globals, tok.text) && fresh_id(pscope, minus(tok.start, penv.base))) {
        return match (pattern_of(pfd, pp)) {
            None -> None,
            Some(t) -> match (ty_of(pfuel, penv, t)) {
                None -> None,
                Some(x) -> cons_param(MParam { id: minus(tok.start, penv.base), ty: x }, params_of(pfuel, penv, pfd, cons(Local { name: tok.text, id: minus(tok.start, penv.base), ty: x }, pscope), prest)),
            },
        };
    }
    return None;
}

pub fn func_body(ps: MParams, r: RetTy, body: core::option::Option<MStmt>) -> core::option::Option<MFunc> {
    return match (body) {
        None -> None,
        Some(b) -> Some(MFunc { params: ps.params, ret: r, body: b }),
    };
}

pub fn func_ret(fuel: usize, env: FrontEnv, ps: MParams, ret: core::option::Option<RetTy>, body: CTree) -> core::option::Option<MFunc> {
    return match (ret) {
        None -> None,
        Some(r) -> func_body(ps, r, block_of(fuel, env, ps.scope, body)),
    };
}

pub fn func_params(fuel: usize, env: FrontEnv, params: core::option::Option<MParams>, ret: core::option::Option<RetTy>, body: CTree) -> core::option::Option<MFunc> {
    return match (params) {
        None -> None,
        Some(ps) -> func_ret(fuel, env, ps, ret, body),
    };
}

pub fn ret_of_ty(t: core::option::Option<Ty>) -> core::option::Option<RetTy> {
    return match (t) {
        None -> None,
        Some(x) -> Some(RetOf(x)),
    };
}

// The result type a return_type_opt names.
pub fn result_of(fuel: usize, env: FrontEnv, ret: CTree) -> core::option::Option<RetTy> {
    if (node_prod(ret) == p_ret_void()) {
        return Some(RetUnit);
    }
    if (node_prod(ret) == p_ret_type() && node_prod(kid(ret, 1)) == p_type_never()) {
        return Some(RetUnit);
    }
    if (node_prod(ret) == p_ret_type()) {
        return ret_of_ty(ty_of(fuel, env, kid(ret, 1)));
    }
    return None;
}

// The type a `return e;` stores at: none in a unit function.
pub fn ret_expected(r: core::option::Option<RetTy>) -> core::option::Option<Ty> {
    return match (r) {
        None -> None,
        Some(x) -> match (x) {
            RetUnit -> None,
            RetOf(t) -> Some(t),
        },
    };
}

// A function instance's body, read with its type parameters (the impl's,
// then its own) standing for the instance's arguments.
pub fn read_fn(fuel: usize, decls: Decls, fd: FnDecl, args: List<Ty>) -> core::option::Option<MFunc> {
    let names: List<List<usize>> = concat(fd.impl_params, fd.params);
    let f: CTree = fd.tree;
    let tenv: FrontEnv = FrontEnv { decls: decls, home: fd.home, names: names, subst: args, globals: module_globals(decls, fd.home), ret: None, base: kid_token(f, 1).start };
    let rt: core::option::Option<RetTy> = result_of(fuel, tenv, kid(f, 6));
    let env: FrontEnv = FrontEnv { decls: decls, home: fd.home, names: names, subst: args, globals: module_globals(decls, fd.home), ret: ret_expected(rt), base: kid_token(f, 1).start };
    // A `requires` clause would add a run-time check this front end does not
    // model, so only functions without contracts are read.
    if (length(names) == length(args) && node_prod(kid(f, 8)) == p_contracts_none()) {
        return match (list_items(fuel, kid(f, 4))) {
            None -> None,
            Some(items) -> func_params(fuel, env, params_of(fuel, env, fd, empty(), items), rt, kid(kid(f, 9), 1)),
        };
    }
    return None;
}

// A projection: `fn(v: t) -> f { return v.f; }`, its parameter's id 0.
pub fn projection_func(ret: core::option::Option<Ty>, inst: Inst, decls: Decls) -> core::option::Option<MFunc> {
    return match (ret) {
        None -> None,
        Some(r) -> match (inst.args) {
            Nil -> None,
            Cons(t, rest) -> Some(MFunc { params: single(MParam { id: 0, ty: t }), ret: RetOf(r), body: MReturn(Field(0, minus(inst.decl, length(decls.fns)))) }),
        },
    };
}

pub fn param_effs(ps: List<MParam>) -> List<MEff> {
    return match (ps) {
        Nil -> empty(),
        Cons(p, rest) -> cons(XPure(Local(p.id)), param_effs(unbox(rest))),
    };
}

// The instance of a `-> !` function g at a value type t: the parameters
// of g, the result t, and the body `g(params); return self(params);`. The
// call of g does not return (Core traps in it, as `assert(false)` does in
// core::panic::panic), so the recursive return is never reached; it only
// gives the body a value of type t on every path.
pub fn diverge_func(g: core::option::Option<MFunc>, inst: Inst) -> core::option::Option<MFunc> {
    return match (g) {
        None -> None,
        Some(m) -> match (last_ty(inst.args)) {
            None -> None,
            Some(t) -> Some(MFunc { params: m.params, ret: RetOf(t), body: MThen(boxed(MDiscard(XCall(Inst { decl: inst.decl, args: init_tys(inst.args) }, boxed(param_effs(m.params))))), boxed(MReturnEval(XCall(inst, boxed(param_effs(m.params)))))) }),
        },
    };
}

pub fn read_decl_inst(fuel: usize, decls: Decls, fd: FnDecl, inst: Inst) -> core::option::Option<MFunc> {
    if (diverges(fd, inst)) {
        return diverge_func(read_fn(fuel, decls, fd, init_tys(inst.args)), inst);
    }
    return read_fn(fuel, decls, fd, inst.args);
}

pub fn read_inst(fuel: usize, decls: Decls, inst: Inst) -> core::option::Option<MFunc> {
    return match (get(decls.fns, inst.decl)) {
        None -> projection_func(projection_ret(fuel, decls, inst), inst, decls),
        Some(fd) -> read_decl_inst(fuel, decls, fd, inst),
    };
}

// ---------------------------------------------------------------- monomorphization

// extract: mutual begin
// The function instances an expression calls, in order (a callee before
// its arguments').
pub fn eff_calls(x: MEff) -> List<Inst> {
    return match (x) {
        XPure(e) -> empty(),
        XCall(inst, args) -> cons(inst, effs_calls(unbox(args))),
        XApply(op, l, r) -> concat(eff_calls(unbox(l)), eff_calls(unbox(r))),
        XNeg(a) -> eff_calls(unbox(a)),
        XNot(a) -> eff_calls(unbox(a)),
        XCast(t, a) -> eff_calls(unbox(a)),
        XIndex(s, i) -> eff_calls(unbox(i)),
        XStruct(t, fs) -> effs_calls(unbox(fs)),
        XVariant(t, k, ps) -> effs_calls(unbox(ps)),
        XMatch(s, ety, t, bs, vs) -> concat(eff_calls(unbox(s)), effs_calls(unbox(vs))),
        XDivide(op, l, r) -> concat(eff_calls(unbox(l)), eff_calls(unbox(r))),
        XStride(sl) -> empty(),
    };
}

pub fn effs_calls(xs: List<MEff>) -> List<Inst> {
    return match (xs) {
        Nil -> empty(),
        Cons(x, rest) -> concat(eff_calls(x), effs_calls(unbox(rest))),
    };
}
// extract: mutual end

// extract: mutual begin
// The types an expression's literals and matches name, in order (a match's
// enum type, then its result type).
pub fn eff_named_tys(x: MEff) -> List<Ty> {
    return match (x) {
        XPure(e) -> empty(),
        XCall(inst, args) -> effs_named_tys(unbox(args)),
        XApply(op, l, r) -> concat(eff_named_tys(unbox(l)), eff_named_tys(unbox(r))),
        XNeg(a) -> eff_named_tys(unbox(a)),
        XNot(a) -> eff_named_tys(unbox(a)),
        XCast(t, a) -> eff_named_tys(unbox(a)),
        XIndex(s, i) -> eff_named_tys(unbox(i)),
        XStruct(t, fs) -> cons(t, effs_named_tys(unbox(fs))),
        XVariant(t, k, ps) -> cons(t, effs_named_tys(unbox(ps))),
        XMatch(s, ety, t, bs, vs) -> concat(eff_named_tys(unbox(s)), cons(ety, cons(t, effs_named_tys(unbox(vs))))),
        XDivide(op, l, r) -> concat(eff_named_tys(unbox(l)), eff_named_tys(unbox(r))),
        XStride(sl) -> empty(),
    };
}

pub fn effs_named_tys(xs: List<MEff>) -> List<Ty> {
    return match (xs) {
        Nil -> empty(),
        Cons(x, rest) -> concat(eff_named_tys(x), effs_named_tys(unbox(rest))),
    };
}
// extract: mutual end

// The function instances a statement calls, in order.
pub fn stmt_calls(m: MStmt) -> List<Inst> {
    return match (m) {
        MNop -> empty(),
        MLet(id, ty, e, body) -> stmt_calls(unbox(body)),
        MLetStruct(id, ty, es, body) -> stmt_calls(unbox(body)),
        MLetCall(id, ty, inst, args, body) -> cons(inst, stmt_calls(unbox(body))),
        MLetEnum(id, ty, k, es, body) -> stmt_calls(unbox(body)),
        MLetMatch(id, ty, s, sty, arms, body) -> stmt_calls(unbox(body)),
        MSet(id, e) -> empty(),
        MSetField(id, j, e) -> empty(),
        MSetCall(id, inst, args) -> single(inst),
        MThen(a, b) -> concat(stmt_calls(unbox(a)), stmt_calls(unbox(b))),
        MIf(c, a, b) -> concat(stmt_calls(unbox(a)), stmt_calls(unbox(b))),
        MWhile(c, body) -> stmt_calls(unbox(body)),
        MReturn(e) -> empty(),
        MLetAlloc(id, size, shift, body) -> stmt_calls(unbox(body)),
        MFree(p, size, shift) -> empty(),
        MLetSlice(id, e, p, n, body) -> stmt_calls(unbox(body)),
        MLetIndex(id, ty, s, i, body) -> stmt_calls(unbox(body)),
        MSetIndex(s, i, v) -> empty(),
        MLetEval(id, ty, x, body) -> concat(eff_calls(x), stmt_calls(unbox(body))),
        MSetEval(id, x) -> eff_calls(x),
        MIfEval(c, a, b) -> concat(eff_calls(c), concat(stmt_calls(unbox(a)), stmt_calls(unbox(b)))),
        MWhileEval(c, body) -> concat(eff_calls(c), stmt_calls(unbox(body))),
        MReturnEval(x) -> eff_calls(x),
        MDiscard(x) -> eff_calls(x),
        MSetIndexEval(s, i, v) -> concat(eff_calls(i), eff_calls(v)),
        MSetFieldEval(id, j, x) -> eff_calls(x),
        MReturnUnit -> empty(),
        MAssert(x) -> eff_calls(x),
        MBreak -> empty(),
        MContinue -> empty(),
    };
}

// The function instances, numbered in the order they are first requested,
// and their bodies.
pub struct Mono {
    table: List<Inst>,
    funcs: List<MFunc>,
}

// Read instance i of the table, append the instances it calls that are
// new, and go on with i + 1 until the table is done.
pub fn mono_loop(fuel: usize, rfuel: usize, decls: Decls, table: List<Inst>, done: List<MFunc>, i: usize) -> core::option::Option<Mono> {
    if (fuel == 0) {
        return None;
    }
    return match (get(table, i)) {
        None -> Some(Mono { table: table, funcs: done }),
        Some(inst) -> mono_next(minus(fuel, 1), rfuel, decls, table, done, i, read_inst(rfuel, decls, inst)),
    };
}

// extract: inline
fn mono_next(nfuel: usize, nrfuel: usize, ndecls: Decls, ntable: List<Inst>, ndone: List<MFunc>, ni: usize, nf: core::option::Option<MFunc>) -> core::option::Option<Mono> {
    return match (nf) {
        None -> None,
        Some(mf) -> mono_loop(nfuel, nrfuel, ndecls, add_insts(ntable, stmt_calls(mf.body)), concat(ndone, single(mf)), plus(ni, 1)),
    };
}

// The types a statement binds, in order (a match's result, then its
// scrutinee's).
pub fn stmt_tys(m: MStmt) -> List<Ty> {
    return match (m) {
        MNop -> empty(),
        MLet(id, ty, e, body) -> cons(ty, stmt_tys(unbox(body))),
        MLetStruct(id, ty, es, body) -> cons(ty, stmt_tys(unbox(body))),
        MLetCall(id, ty, inst, args, body) -> cons(ty, stmt_tys(unbox(body))),
        MLetEnum(id, ty, k, es, body) -> cons(ty, stmt_tys(unbox(body))),
        MLetMatch(id, ty, s, sty, arms, body) -> cons(ty, cons(sty, stmt_tys(unbox(body)))),
        MSet(id, e) -> empty(),
        MSetField(id, j, e) -> empty(),
        MSetCall(id, inst, args) -> empty(),
        MThen(a, b) -> concat(stmt_tys(unbox(a)), stmt_tys(unbox(b))),
        MIf(c, a, b) -> concat(stmt_tys(unbox(a)), stmt_tys(unbox(b))),
        MWhile(c, body) -> stmt_tys(unbox(body)),
        MReturn(e) -> empty(),
        MLetAlloc(id, size, shift, body) -> stmt_tys(unbox(body)),
        MFree(p, size, shift) -> empty(),
        MLetSlice(id, e, p, n, body) -> cons(e, stmt_tys(unbox(body))),
        MLetIndex(id, ty, s, i, body) -> cons(ty, stmt_tys(unbox(body))),
        MSetIndex(s, i, v) -> empty(),
        MLetEval(id, ty, x, body) -> cons(ty, concat(eff_named_tys(x), stmt_tys(unbox(body)))),
        MSetEval(id, x) -> eff_named_tys(x),
        MIfEval(c, a, b) -> concat(eff_named_tys(c), concat(stmt_tys(unbox(a)), stmt_tys(unbox(b)))),
        MWhileEval(c, body) -> concat(eff_named_tys(c), stmt_tys(unbox(body))),
        MReturnEval(x) -> eff_named_tys(x),
        MDiscard(x) -> eff_named_tys(x),
        MSetIndexEval(s, i, v) -> concat(eff_named_tys(i), eff_named_tys(v)),
        MSetFieldEval(id, j, x) -> eff_named_tys(x),
        MReturnUnit -> empty(),
        MAssert(x) -> eff_named_tys(x),
        MBreak -> empty(),
        MContinue -> empty(),
    };
}

pub fn param_tys(ps: List<MParam>) -> List<Ty> {
    return match (ps) {
        Nil -> empty(),
        Cons(p, rest) -> cons(p.ty, param_tys(unbox(rest))),
    };
}

pub fn ret_tys(r: RetTy) -> List<Ty> {
    return match (r) {
        RetUnit -> empty(),
        RetOf(t) -> single(t),
    };
}

// A function's types: parameters, result, then its body's.
pub fn funcs_tys(fs: List<MFunc>) -> List<Ty> {
    return match (fs) {
        Nil -> empty(),
        Cons(f, rest) -> concat(param_tys(f.params), concat(ret_tys(f.ret), concat(stmt_tys(f.body), funcs_tys(unbox(rest))))),
    };
}

pub fn seed_tys(seeds: List<Inst>) -> List<Ty> {
    return match (seeds) {
        Nil -> empty(),
        Cons(s, rest) -> cons(TyNamed(s.decl, boxed(s.args)), seed_tys(unbox(rest))),
    };
}

// The type instances, from the seeds, in the order the types first need
// them.
pub fn type_table(fuel: usize, decls: Decls, table: List<Inst>, ts: List<Ty>) -> core::option::Option<List<Inst>> {
    return match (ts) {
        Nil -> Some(table),
        Cons(t, rest) -> type_table_next(fuel, decls, table, ty_insts(fuel, decls, t), unbox(rest)),
    };
}

// extract: inline
fn type_table_next(tfuel: usize, tdecls: Decls, ttable: List<Inst>, tnew: core::option::Option<List<Inst>>, trest: List<Ty>) -> core::option::Option<List<Inst>> {
    return match (tnew) {
        None -> None,
        Some(xs) -> type_table(tfuel, tdecls, add_insts(ttable, xs), trest),
    };
}

// The table holds the instance of every named type in t.
pub fn ty_known(table: List<Inst>, t: Ty) -> bool {
    return match (t) {
        TyI32 -> true,
        TyBool -> true,
        TyUint(k) -> true,
        TyPtr -> true,
        TyIsize -> true,
        TyChar -> true,
        TySlice(e) -> ty_known(table, unbox(e)),
        TyNamed(d, args) -> inst_member(table, Inst { decl: d, args: unbox(args) }),
        TySint(k) -> true,
    };
}

// type_table over more types, from a table that holds every instance the
// types of its members need (as type_table's result from the seeds does):
// a type whose instance the table holds adds nothing new, so it is passed
// over without reading its declaration again. The types are every type the
// functions mention, most of them many times over.
pub fn type_table_more(fuel: usize, decls: Decls, table: core::option::Option<List<Inst>>, ts: List<Ty>) -> core::option::Option<List<Inst>> {
    return match (table) {
        None -> None,
        Some(x) -> match (ts) {
            Nil -> Some(x),
            Cons(t, rest) -> type_table_more_at(fuel, decls, x, t, unbox(rest)),
        },
    };
}

// extract: inline
fn type_table_more_at(mfuel: usize, mdecls: Decls, mtable: List<Inst>, mt: Ty, mrest: List<Ty>) -> core::option::Option<List<Inst>> {
    if (ty_known(mtable, mt)) {
        return type_table_more(mfuel, mdecls, Some(mtable), mrest);
    }
    return type_table_more(mfuel, mdecls, type_table(mfuel, mdecls, mtable, single(mt)), mrest);
}

// ---------------------------------------------------------------- the closed program

// The declarations and the function and type instance tables.
pub struct Tables {
    decls: Decls,
    fns: List<Inst>,
    types: List<Inst>,
    // lower_named of each type instance, in order (see close_ty)
    lowered: List<core::option::Option<SrcType>>,
}

pub fn lowered_all(fuel: usize, decls: Decls, types: List<Inst>, insts: List<Inst>) -> List<core::option::Option<SrcType>> {
    return match (insts) {
        Nil -> empty(),
        Cons(x, rest) -> cons(lower_named(minus(fuel, 1), decls, types, x.decl, x.args), lowered_all(fuel, decls, types, unbox(rest))),
    };
}

pub fn close_named(fuel: usize, t: Tables, d: usize, args: List<Ty>, id: core::option::Option<usize>) -> core::option::Option<SrcType> {
    return match (id) {
        None -> lower_named(minus(fuel, 1), t.decls, t.types, d, args),
        Some(i) -> match (get(t.lowered, i)) {
            None -> lower_named(minus(fuel, 1), t.decls, t.types, d, args),
            Some(x) -> x,
        },
    };
}

// lower_ty, reading a type instance's lowering from the table instead of
// lowering its declaration again at every one of its many uses.
pub fn close_ty(fuel: usize, t: Tables, ty: Ty) -> core::option::Option<SrcType> {
    if (fuel == 0) {
        return None;
    }
    return match (ty) {
        TyI32 -> Some(I32),
        TyBool -> Some(Bool),
        TyUint(k) -> Some(Uint(k)),
        TyPtr -> Some(Ptr),
        TyIsize -> Some(Isize),
        TyChar -> Some(SrcType::Char),
        TySlice(e) -> slice_type(close_ty(minus(fuel, 1), t, unbox(e))),
        TyNamed(d, args) -> close_named(fuel, t, d, unbox(args), inst_index(t.types, Inst { decl: d, args: unbox(args) }, 0)),
        TySint(k) -> Some(Sint(k)),
    };
}

pub fn src_enum_id(t: core::option::Option<SrcType>) -> core::option::Option<usize> {
    return match (t) {
        None -> None,
        Some(x) -> match (x) {
            I32 -> None,
            Bool -> None,
            Uint(k) -> None,
            Struct(id, fields) -> None,
            Enum(id, variants) -> Some(id),
            Ptr -> None,
            Slice(e) -> None,
            Unit -> None,
            Isize -> None,
            SrcType::Char -> None,
            Sint(sk) -> None,
        },
    };
}

pub fn let_closed(id: usize, ty: core::option::Option<SrcType>, e: SrcExpr, body: core::option::Option<SrcStmt>) -> core::option::Option<SrcStmt> {
    return match (ty) {
        None -> None,
        Some(t) -> match (body) {
            None -> None,
            Some(b) -> Some(Let(id, t, e, boxed(b))),
        },
    };
}

pub fn let_struct_closed(id: usize, ty: core::option::Option<SrcType>, es: List<SrcExpr>, body: core::option::Option<SrcStmt>) -> core::option::Option<SrcStmt> {
    return match (ty) {
        None -> None,
        Some(t) -> match (body) {
            None -> None,
            Some(b) -> Some(LetStruct(id, t, es, boxed(b))),
        },
    };
}

pub fn let_call_closed(id: usize, ty: core::option::Option<SrcType>, callee: core::option::Option<usize>, args: List<SrcExpr>, body: core::option::Option<SrcStmt>) -> core::option::Option<SrcStmt> {
    return match (ty) {
        None -> None,
        Some(t) -> match (callee) {
            None -> None,
            Some(c) -> match (body) {
                None -> None,
                Some(b) -> Some(LetCall(id, t, c, args, boxed(b))),
            },
        },
    };
}

pub fn let_enum_closed(id: usize, ty: core::option::Option<SrcType>, k: usize, es: List<SrcExpr>, body: core::option::Option<SrcStmt>) -> core::option::Option<SrcStmt> {
    return match (ty) {
        None -> None,
        Some(t) -> match (body) {
            None -> None,
            Some(b) -> Some(LetEnum(id, t, k, es, boxed(b))),
        },
    };
}

pub fn let_match_closed(id: usize, ty: core::option::Option<SrcType>, s: usize, e: core::option::Option<usize>, arms: List<SrcArm>, body: core::option::Option<SrcStmt>) -> core::option::Option<SrcStmt> {
    return match (ty) {
        None -> None,
        Some(t) -> match (e) {
            None -> None,
            Some(x) -> match (body) {
                None -> None,
                Some(b) -> Some(LetMatch(id, t, s, x, arms, boxed(b))),
            },
        },
    };
}

pub fn set_call_closed(id: usize, callee: core::option::Option<usize>, args: List<SrcExpr>) -> core::option::Option<SrcStmt> {
    return match (callee) {
        None -> None,
        Some(c) -> Some(SetCall(id, c, args)),
    };
}

pub fn then_closed(a: core::option::Option<SrcStmt>, b: core::option::Option<SrcStmt>) -> core::option::Option<SrcStmt> {
    return match (a) {
        None -> None,
        Some(x) -> match (b) {
            None -> None,
            Some(y) -> Some(Then(boxed(x), boxed(y))),
        },
    };
}

pub fn if_closed(c: SrcExpr, a: core::option::Option<SrcStmt>, b: core::option::Option<SrcStmt>) -> core::option::Option<SrcStmt> {
    return match (a) {
        None -> None,
        Some(x) -> match (b) {
            None -> None,
            Some(y) -> Some(If(c, boxed(x), boxed(y))),
        },
    };
}

pub fn while_closed(c: SrcExpr, body: core::option::Option<SrcStmt>) -> core::option::Option<SrcStmt> {
    return match (body) {
        None -> None,
        Some(b) -> Some(While(c, boxed(b))),
    };
}

pub fn alloc_closed(id: usize, size: SrcExpr, shift: usize, body: core::option::Option<SrcStmt>) -> core::option::Option<SrcStmt> {
    return match (body) {
        None -> None,
        Some(b) -> Some(LetAlloc(id, size, shift, boxed(b))),
    };
}

pub fn let_slice_closed(id: usize, element: core::option::Option<SrcType>, p: SrcExpr, n: SrcExpr, body: core::option::Option<SrcStmt>) -> core::option::Option<SrcStmt> {
    return match (element) {
        None -> None,
        Some(t) -> match (body) {
            None -> None,
            Some(b) -> Some(LetSlice(id, t, p, n, boxed(b))),
        },
    };
}

pub fn let_index_closed(id: usize, ty: core::option::Option<SrcType>, s: usize, i: SrcExpr, body: core::option::Option<SrcStmt>) -> core::option::Option<SrcStmt> {
    return match (ty) {
        None -> None,
        Some(t) -> match (body) {
            None -> None,
            Some(b) -> Some(LetIndex(id, t, s, i, boxed(b))),
        },
    };
}

pub fn e_call_closed(callee: core::option::Option<usize>, args: core::option::Option<List<SrcEff>>) -> core::option::Option<SrcEff> {
    return match (callee) {
        None -> None,
        Some(c) -> match (args) {
            None -> None,
            Some(xs) -> Some(ECall(c, boxed(xs))),
        },
    };
}

pub fn e_apply_closed(op: SrcOp, l: core::option::Option<SrcEff>, r: core::option::Option<SrcEff>) -> core::option::Option<SrcEff> {
    return match (l) {
        None -> None,
        Some(a) -> match (r) {
            None -> None,
            Some(b) -> Some(EApply(op, boxed(a), boxed(b))),
        },
    };
}

pub fn e_divide_closed(op: SrcDivOp, l: core::option::Option<SrcEff>, r: core::option::Option<SrcEff>) -> core::option::Option<SrcEff> {
    return match (l) {
        None -> None,
        Some(a) -> match (r) {
            None -> None,
            Some(b) -> Some(EDivide(op, boxed(a), boxed(b))),
        },
    };
}

pub fn e_neg_closed(x: core::option::Option<SrcEff>) -> core::option::Option<SrcEff> {
    return match (x) {
        None -> None,
        Some(a) -> Some(ENeg(boxed(a))),
    };
}

pub fn e_not_closed(x: core::option::Option<SrcEff>) -> core::option::Option<SrcEff> {
    return match (x) {
        None -> None,
        Some(a) -> Some(ENot(boxed(a))),
    };
}

pub fn e_cast_closed(t: SrcType, x: core::option::Option<SrcEff>) -> core::option::Option<SrcEff> {
    return match (x) {
        None -> None,
        Some(a) -> Some(ECast(t, boxed(a))),
    };
}

pub fn e_index_closed(s: usize, x: core::option::Option<SrcEff>) -> core::option::Option<SrcEff> {
    return match (x) {
        None -> None,
        Some(a) -> Some(EIndex(s, boxed(a))),
    };
}

pub fn e_struct_closed(t: core::option::Option<SrcType>, fs: core::option::Option<List<SrcEff>>) -> core::option::Option<SrcEff> {
    return match (t) {
        None -> None,
        Some(ty) -> match (fs) {
            None -> None,
            Some(xs) -> Some(EStruct(ty, boxed(xs))),
        },
    };
}

pub fn e_variant_closed(t: core::option::Option<SrcType>, k: usize, ps: core::option::Option<List<SrcEff>>) -> core::option::Option<SrcEff> {
    return match (t) {
        None -> None,
        Some(ty) -> match (ps) {
            None -> None,
            Some(xs) -> Some(EVariant(ty, k, boxed(xs))),
        },
    };
}

pub fn e_match_closed(s: core::option::Option<SrcEff>, ety: core::option::Option<SrcType>, t: core::option::Option<SrcType>, bs: List<List<usize>>, vs: core::option::Option<List<SrcEff>>) -> core::option::Option<SrcEff> {
    return match (s) {
        None -> None,
        Some(x) -> match (ety) {
            None -> None,
            Some(e) -> match (t) {
                None -> None,
                Some(ty) -> match (vs) {
                    None -> None,
                    Some(xs) -> Some(EMatch(boxed(x), e, ty, bs, boxed(xs))),
                },
            },
        },
    };
}

pub fn cons_src_eff(head: core::option::Option<SrcEff>, tail: core::option::Option<List<SrcEff>>) -> core::option::Option<List<SrcEff>> {
    return match (head) {
        None -> None,
        Some(x) -> match (tail) {
            None -> None,
            Some(xs) -> Some(cons(x, xs)),
        },
    };
}

// extract: mutual begin
// The source expression: types become source types and a call names its
// instance's position in the function table.
pub fn close_eff(fuel: usize, t: Tables, x: MEff) -> core::option::Option<SrcEff> {
    return match (x) {
        XPure(e) -> Some(EPure(e)),
        XCall(inst, args) -> e_call_closed(inst_index(t.fns, inst, 0), close_effs(fuel, t, unbox(args))),
        XApply(op, l, r) -> e_apply_closed(op, close_eff(fuel, t, unbox(l)), close_eff(fuel, t, unbox(r))),
        XNeg(a) -> e_neg_closed(close_eff(fuel, t, unbox(a))),
        XNot(a) -> e_not_closed(close_eff(fuel, t, unbox(a))),
        XCast(ty, a) -> e_cast_closed(ty, close_eff(fuel, t, unbox(a))),
        XIndex(s, i) -> e_index_closed(s, close_eff(fuel, t, unbox(i))),
        XStruct(ty, fs) -> e_struct_closed(close_ty(fuel, t, ty), close_effs(fuel, t, unbox(fs))),
        XVariant(ty, k, ps) -> e_variant_closed(close_ty(fuel, t, ty), k, close_effs(fuel, t, unbox(ps))),
        XMatch(s, ety, ty, bs, vs) -> e_match_closed(close_eff(fuel, t, unbox(s)), close_ty(fuel, t, ety), close_ty(fuel, t, ty), bs, close_effs(fuel, t, unbox(vs))),
        XDivide(op, l, r) -> e_divide_closed(op, close_eff(fuel, t, unbox(l)), close_eff(fuel, t, unbox(r))),
        XStride(sl) -> Some(EStride(sl)),
    };
}

pub fn close_effs(fuel: usize, t: Tables, xs: List<MEff>) -> core::option::Option<List<SrcEff>> {
    return match (xs) {
        Nil -> Some(empty()),
        Cons(x, rest) -> cons_src_eff(close_eff(fuel, t, x), close_effs(fuel, t, unbox(rest))),
    };
}
// extract: mutual end

pub fn let_eval_closed(id: usize, ty: core::option::Option<SrcType>, x: core::option::Option<SrcEff>, body: core::option::Option<SrcStmt>) -> core::option::Option<SrcStmt> {
    return match (ty) {
        None -> None,
        Some(t) -> match (x) {
            None -> None,
            Some(e) -> match (body) {
                None -> None,
                Some(b) -> Some(LetEval(id, t, e, boxed(b))),
            },
        },
    };
}

pub fn set_eval_closed(id: usize, x: core::option::Option<SrcEff>) -> core::option::Option<SrcStmt> {
    return match (x) {
        None -> None,
        Some(e) -> Some(SetEval(id, e)),
    };
}

pub fn if_eval_closed(c: core::option::Option<SrcEff>, a: core::option::Option<SrcStmt>, b: core::option::Option<SrcStmt>) -> core::option::Option<SrcStmt> {
    return match (c) {
        None -> None,
        Some(e) -> match (a) {
            None -> None,
            Some(x) -> match (b) {
                None -> None,
                Some(y) -> Some(IfEval(e, boxed(x), boxed(y))),
            },
        },
    };
}

pub fn while_eval_closed(c: core::option::Option<SrcEff>, body: core::option::Option<SrcStmt>) -> core::option::Option<SrcStmt> {
    return match (c) {
        None -> None,
        Some(e) -> match (body) {
            None -> None,
            Some(b) -> Some(WhileEval(e, boxed(b))),
        },
    };
}

pub fn return_eval_closed(x: core::option::Option<SrcEff>) -> core::option::Option<SrcStmt> {
    return match (x) {
        None -> None,
        Some(e) -> Some(ReturnEval(e)),
    };
}

pub fn discard_closed(x: core::option::Option<SrcEff>) -> core::option::Option<SrcStmt> {
    return match (x) {
        None -> None,
        Some(e) -> Some(Discard(e)),
    };
}

pub fn set_index_eval_closed(s: usize, i: core::option::Option<SrcEff>, v: core::option::Option<SrcEff>) -> core::option::Option<SrcStmt> {
    return match (i) {
        None -> None,
        Some(x) -> match (v) {
            None -> None,
            Some(y) -> Some(SetIndexEval(s, x, y)),
        },
    };
}

pub fn assert_closed(x: core::option::Option<SrcEff>) -> core::option::Option<SrcStmt> {
    return match (x) {
        None -> None,
        Some(e) -> Some(Assert(e)),
    };
}

pub fn set_field_eval_closed(id: usize, j: usize, x: core::option::Option<SrcEff>) -> core::option::Option<SrcStmt> {
    return match (x) {
        None -> None,
        Some(e) -> Some(SetFieldEval(id, j, e)),
    };
}

// The source statement: types become source types and a call names its
// instance's position in the function table.
pub fn close_stmt(fuel: usize, t: Tables, m: MStmt) -> core::option::Option<SrcStmt> {
    return match (m) {
        MNop -> Some(Nop),
        MLet(id, ty, e, body) -> let_closed(id, close_ty(fuel, t, ty), e, close_stmt(fuel, t, unbox(body))),
        MLetStruct(id, ty, es, body) -> let_struct_closed(id, close_ty(fuel, t, ty), es, close_stmt(fuel, t, unbox(body))),
        MLetCall(id, ty, inst, args, body) -> let_call_closed(id, close_ty(fuel, t, ty), inst_index(t.fns, inst, 0), args, close_stmt(fuel, t, unbox(body))),
        MLetEnum(id, ty, k, es, body) -> let_enum_closed(id, close_ty(fuel, t, ty), k, es, close_stmt(fuel, t, unbox(body))),
        MLetMatch(id, ty, s, sty, arms, body) -> let_match_closed(id, close_ty(fuel, t, ty), s, src_enum_id(close_ty(fuel, t, sty)), arms, close_stmt(fuel, t, unbox(body))),
        MSet(id, e) -> Some(Set(id, e)),
        MSetField(id, j, e) -> Some(SetField(id, j, e)),
        MSetCall(id, inst, args) -> set_call_closed(id, inst_index(t.fns, inst, 0), args),
        MThen(a, b) -> then_closed(close_stmt(fuel, t, unbox(a)), close_stmt(fuel, t, unbox(b))),
        MIf(c, a, b) -> if_closed(c, close_stmt(fuel, t, unbox(a)), close_stmt(fuel, t, unbox(b))),
        MWhile(c, body) -> while_closed(c, close_stmt(fuel, t, unbox(body))),
        MReturn(e) -> Some(Return(e)),
        MLetAlloc(id, size, shift, body) -> alloc_closed(id, size, shift, close_stmt(fuel, t, unbox(body))),
        MFree(p, size, shift) -> Some(Free(p, size, shift)),
        MLetSlice(id, e, p, n, body) -> let_slice_closed(id, close_ty(fuel, t, e), p, n, close_stmt(fuel, t, unbox(body))),
        MLetIndex(id, ty, s, i, body) -> let_index_closed(id, close_ty(fuel, t, ty), s, i, close_stmt(fuel, t, unbox(body))),
        MSetIndex(s, i, v) -> Some(SetIndex(s, i, v)),
        MLetEval(id, ty, x, body) -> let_eval_closed(id, close_ty(fuel, t, ty), close_eff(fuel, t, x), close_stmt(fuel, t, unbox(body))),
        MSetEval(id, x) -> set_eval_closed(id, close_eff(fuel, t, x)),
        MIfEval(c, a, b) -> if_eval_closed(close_eff(fuel, t, c), close_stmt(fuel, t, unbox(a)), close_stmt(fuel, t, unbox(b))),
        MWhileEval(c, body) -> while_eval_closed(close_eff(fuel, t, c), close_stmt(fuel, t, unbox(body))),
        MReturnEval(x) -> return_eval_closed(close_eff(fuel, t, x)),
        MDiscard(x) -> discard_closed(close_eff(fuel, t, x)),
        MSetIndexEval(s, i, v) -> set_index_eval_closed(s, close_eff(fuel, t, i), close_eff(fuel, t, v)),
        MSetFieldEval(id, j, x) -> set_field_eval_closed(id, j, close_eff(fuel, t, x)),
        MReturnUnit -> Some(ReturnUnit),
        MAssert(x) -> assert_closed(close_eff(fuel, t, x)),
        MBreak -> Some(Break),
        MContinue -> Some(Continue),
    };
}

pub fn cons_src_param(id: usize, ty: core::option::Option<SrcType>, rest: core::option::Option<List<SrcParam>>) -> core::option::Option<List<SrcParam>> {
    return match (ty) {
        None -> None,
        Some(t) -> match (rest) {
            None -> None,
            Some(ps) -> Some(cons(SrcParam { id: id, ty: t }, ps)),
        },
    };
}

pub fn close_params(fuel: usize, t: Tables, ps: List<MParam>) -> core::option::Option<List<SrcParam>> {
    return match (ps) {
        Nil -> Some(empty()),
        Cons(p, rest) -> cons_src_param(p.id, close_ty(fuel, t, p.ty), close_params(fuel, t, unbox(rest))),
    };
}

pub fn src_func(params: core::option::Option<List<SrcParam>>, ret: core::option::Option<SrcType>, body: core::option::Option<SrcStmt>) -> core::option::Option<SrcFunc> {
    return match (params) {
        None -> None,
        Some(ps) -> match (ret) {
            None -> None,
            Some(r) -> match (body) {
                None -> None,
                Some(b) -> Some(SrcFunc { params: ps, ret: r, body: b }),
            },
        },
    };
}

pub fn cons_func_tail(f: SrcFunc, tail: core::option::Option<List<SrcFunc>>) -> core::option::Option<List<SrcFunc>> {
    return match (tail) {
        None -> None,
        Some(fs) -> Some(cons(f, fs)),
    };
}

pub fn cons_func(head: core::option::Option<SrcFunc>, tail: core::option::Option<List<SrcFunc>>) -> core::option::Option<List<SrcFunc>> {
    return match (head) {
        None -> None,
        Some(f) -> cons_func_tail(f, tail),
    };
}

pub fn close_ret(fuel: usize, t: Tables, r: RetTy) -> core::option::Option<SrcType> {
    return match (r) {
        RetUnit -> Some(Unit),
        RetOf(x) -> close_ty(fuel, t, x),
    };
}

pub fn close_funcs(fuel: usize, t: Tables, fs: List<MFunc>) -> core::option::Option<List<SrcFunc>> {
    return match (fs) {
        Nil -> Some(empty()),
        Cons(f, rest) -> cons_func(src_func(close_params(fuel, t, f.params), close_ret(fuel, t, f.ret), close_stmt(fuel, t, f.body)), close_funcs(fuel, t, unbox(rest))),
    };
}

// ---------------------------------------------------------------- isize literals

// laniusc gives an integer literal the type its context expects, and so
// does the reading: after monomorphization, an integer literal Int(n) whose
// expected type is isize becomes Cast(Isize, Int(n)), one expected unsigned
// Unsigned(u, n), and `0` expected ptr Null. A literal of 2^31 or more was
// read as a wide marker (wide_marker) and gets its type here too (wide_at,
// neg_wide_at). The expected
// types: a let's type, a local's or field's when stored to, a parameter's, the
// function's result for return, a field's or payload's in a literal, a slice
// element's in an index store, an arm's result type, Bool for conditions,
// asserts and `!`. An operator's operands expect the type of whichever operand
// has one (a literal has none), or else, for arithmetic, the operator's
// expected type. The operand of `as`, an index and the heap operations'
// operands expect nothing. A literal with no expectation stays Int(n).

pub struct LocalTy {
    id: usize,
    ty: SrcType,
}

pub fn isize_ty(t: SrcType) -> bool {
    return match (t) {
        I32 -> false,
        Bool -> false,
        Uint(k) -> false,
        Struct(id, fields) -> false,
        Enum(id, variants) -> false,
        Ptr -> false,
        Slice(e) -> false,
        Unit -> false,
        Isize -> true,
        SrcType::Char -> false,
        Sint(sk) -> false,
    };
}

// `0` where a ptr is expected is the null pointer.
pub fn null_at(k: i32, e: SrcExpr) -> SrcExpr {
    if ((k as u32) == 0) {
        return Null;
    }
    return e;
}

// A signed type's literal: the cast of the i32 literal, when the type holds it.
pub fn sint_at(u: UintTy, k: i32, e: SrcExpr) -> SrcExpr {
    if (sint_fits(u, k)) {
        return Cast(Sint(u), boxed(e));
    }
    return e;
}

// An integer literal at its expected type: an unsigned type's literal, the
// null pointer for `0` at ptr, or for isize the cast of the i32 literal.
pub fn int_literal_at(t: SrcType, k: i32, e: SrcExpr) -> SrcExpr {
    return match (t) {
        I32 -> e,
        Bool -> e,
        Uint(u) -> Unsigned(u, (k as u32) as u64),
        Struct(id, fields) -> e,
        Enum(id, variants) -> e,
        Ptr -> null_at(k, e),
        Slice(el) -> e,
        Unit -> e,
        Isize -> Cast(Isize, boxed(e)),
        SrcType::Char -> e,
        Sint(sk) -> sint_at(sk, k, e),
    };
}

pub fn int_at(want: core::option::Option<SrcType>, k: i32, e: SrcExpr) -> SrcExpr {
    return match (want) {
        None -> e,
        Some(t) -> int_literal_at(t, k, e),
    };
}

// The innermost local with this id, as a source type.
pub fn ty_local(locals: List<LocalTy>, id: usize) -> core::option::Option<SrcType> {
    return match (locals) {
        Nil -> None,
        Cons(l, rest) -> ty_local_at(l, unbox(rest), id),
    };
}

// extract: inline
fn ty_local_at(tl: LocalTy, trest: List<LocalTy>, tid: usize) -> core::option::Option<SrcType> {
    if (tl.id == tid) {
        return Some(tl.ty);
    }
    return ty_local(trest, tid);
}

pub fn src_fields(t: core::option::Option<SrcType>) -> core::option::Option<List<SrcType>> {
    return match (t) {
        None -> None,
        Some(x) -> match (x) {
            I32 -> None,
            Bool -> None,
            Uint(k) -> None,
            Struct(id, fields) -> Some(unbox(fields)),
            Enum(id, variants) -> None,
            Ptr -> None,
            Slice(e) -> None,
            Unit -> None,
            Isize -> None,
            SrcType::Char -> None,
            Sint(sk) -> None,
        },
    };
}

pub fn src_variants(t: core::option::Option<SrcType>) -> core::option::Option<List<List<SrcType>>> {
    return match (t) {
        None -> None,
        Some(x) -> match (x) {
            I32 -> None,
            Bool -> None,
            Uint(k) -> None,
            Struct(id, fields) -> None,
            Enum(id, variants) -> Some(unbox(variants)),
            Ptr -> None,
            Slice(e) -> None,
            Unit -> None,
            Isize -> None,
            SrcType::Char -> None,
            Sint(sk) -> None,
        },
    };
}

pub fn src_element(t: core::option::Option<SrcType>) -> core::option::Option<SrcType> {
    return match (t) {
        None -> None,
        Some(x) -> match (x) {
            I32 -> None,
            Bool -> None,
            Uint(k) -> None,
            Struct(id, fields) -> None,
            Enum(id, variants) -> None,
            Ptr -> None,
            Slice(e) -> Some(unbox(e)),
            Unit -> None,
            Isize -> None,
            SrcType::Char -> None,
            Sint(sk) -> None,
        },
    };
}

pub fn ty_at(ts: core::option::Option<List<SrcType>>, j: usize) -> core::option::Option<SrcType> {
    return match (ts) {
        None -> None,
        Some(xs) -> get(xs, j),
    };
}

pub fn payload_at(vs: core::option::Option<List<List<SrcType>>>, k: usize) -> core::option::Option<List<SrcType>> {
    return match (vs) {
        None -> None,
        Some(xs) -> get(xs, k),
    };
}

pub fn first_src(ts: core::option::Option<List<SrcType>>) -> core::option::Option<SrcType> {
    return ty_at(ts, 0);
}

pub fn rest_src(ts: core::option::Option<List<SrcType>>) -> core::option::Option<List<SrcType>> {
    return match (ts) {
        None -> None,
        Some(xs) -> match (xs) {
            Nil -> None,
            Cons(x, rest) -> Some(unbox(rest)),
        },
    };
}

pub fn rest_payloads(vs: core::option::Option<List<List<SrcType>>>) -> core::option::Option<List<List<SrcType>>> {
    return match (vs) {
        None -> None,
        Some(xs) -> match (xs) {
            Nil -> None,
            Cons(x, rest) -> Some(unbox(rest)),
        },
    };
}

pub fn first_ids(bs: List<List<usize>>) -> List<usize> {
    return match (bs) {
        Nil -> empty(),
        Cons(b, rest) -> b,
    };
}

pub fn rest_ids(bs: List<List<usize>>) -> List<List<usize>> {
    return match (bs) {
        Nil -> empty(),
        Cons(b, rest) -> unbox(rest),
    };
}

// Binders with the payload types, innermost first.
pub fn bound_tys(ids: List<usize>, tys: core::option::Option<List<SrcType>>, locals: List<LocalTy>) -> List<LocalTy> {
    return match (ids) {
        Nil -> locals,
        Cons(i, rest) -> match (first_src(tys)) {
            None -> locals,
            Some(t) -> cons(LocalTy { id: i, ty: t }, bound_tys(unbox(rest), rest_src(tys), locals)),
        },
    };
}

pub fn either_ty(a: core::option::Option<SrcType>, b: core::option::Option<SrcType>) -> core::option::Option<SrcType> {
    return match (a) {
        None -> b,
        Some(x) -> Some(x),
    };
}

// What an operator's operands expect, from the operands' own types.
pub fn operand_want(op: SrcOp, want: core::option::Option<SrcType>, a: core::option::Option<SrcType>, b: core::option::Option<SrcType>) -> core::option::Option<SrcType> {
    if (gives_bool(op)) {
        return either_ty(a, b);
    }
    if (shift_op(op)) {
        return either_ty(a, want);
    }
    return either_ty(either_ty(a, b), want);
}

// A shift's amount has a type of its own; a bare amount takes the shifted
// value's type.
pub fn amount_want(op: SrcOp, want: core::option::Option<SrcType>, a: core::option::Option<SrcType>, b: core::option::Option<SrcType>) -> core::option::Option<SrcType> {
    if (shift_op(op)) {
        return either_ty(b, either_ty(a, want));
    }
    return operand_want(op, want, a, b);
}

pub fn known_apply(op: SrcOp, a: core::option::Option<SrcType>, b: core::option::Option<SrcType>) -> core::option::Option<SrcType> {
    if (gives_bool(op)) {
        return Some(Bool);
    }
    if (shift_op(op)) {
        return a;
    }
    return either_ty(a, b);
}

// A cast's type; a wide literal (a cast to Unit) has none of its own.
pub fn known_cast(t: SrcType) -> core::option::Option<SrcType> {
    if (unit_ty(t)) {
        return None;
    }
    return Some(t);
}

pub fn wide_uint_at(u: UintTy, n: u64, e: SrcExpr) -> SrcExpr {
    if (n <= uint_mask(u)) {
        return Unsigned(u, n);
    }
    return e;
}

pub fn wide_isize_at(n: u64, e: SrcExpr) -> SrcExpr {
    if (n <= 9223372036854775807) {
        return Cast(Isize, boxed(Unsigned(Uint64, n)));
    }
    return e;
}

pub fn wide_sint_at(u: UintTy, n: u64, e: SrcExpr) -> SrcExpr {
    if (sint_wide(u) && n <= 9223372036854775807) {
        return Cast(Sint(u), boxed(Unsigned(Uint64, n)));
    }
    return e;
}

// A wide literal n at its expected type: an unsigned type's literal when n
// fits it, for isize (n below 2^63) the cast of the u64 literal n; else it
// stays as read, and build rejects it.
pub fn wide_at(want: core::option::Option<SrcType>, n: u64, e: SrcExpr) -> SrcExpr {
    return match (want) {
        None -> e,
        Some(t) -> match (t) {
            I32 -> e,
            Bool -> e,
            Uint(u) -> wide_uint_at(u, n, e),
            Struct(id, fields) -> e,
            Enum(id, variants) -> e,
            Ptr -> e,
            Slice(el) -> e,
            Unit -> e,
            Isize -> wide_isize_at(n, e),
            SrcType::Char -> e,
            Sint(sk) -> wide_sint_at(sk, n, e),
        },
    };
}

pub fn neg_wide_i32(n: u64, e: SrcExpr) -> SrcExpr {
    let low: i32 = 0 - 2147483647;
    if (n == 2147483648) {
        return Int(low - 1);
    }
    return e;
}

pub fn neg_wide_isize(n: u64, e: SrcExpr) -> SrcExpr {
    if (n <= 9223372036854775808) {
        return Cast(Isize, boxed(Unsigned(Uint64, (18446744073709551615 - n) + 1)));
    }
    return e;
}

pub fn neg_wide_sint(u: UintTy, n: u64, e: SrcExpr) -> SrcExpr {
    if (sint_wide(u) && n <= 9223372036854775808) {
        return Cast(Sint(u), boxed(Unsigned(Uint64, (18446744073709551615 - n) + 1)));
    }
    return e;
}

// `-n` for a wide literal n: -2^31 as an i32 literal (expected i32, or
// nothing), the cast of the u64 literal of its two's complement bits for
// isize (n at most 2^63).
pub fn neg_wide_at(want: core::option::Option<SrcType>, n: u64, e: SrcExpr) -> SrcExpr {
    return match (want) {
        None -> neg_wide_i32(n, e),
        Some(t) -> match (t) {
            I32 -> neg_wide_i32(n, e),
            Bool -> e,
            Uint(u) -> e,
            Struct(id, fields) -> e,
            Enum(id, variants) -> e,
            Ptr -> e,
            Slice(el) -> e,
            Unit -> e,
            Isize -> neg_wide_isize(n, e),
            SrcType::Char -> e,
            Sint(sk) -> neg_wide_sint(sk, n, e),
        },
    };
}

pub fn least_cast(u: UintTy, k: i32, d: SrcExpr) -> SrcExpr {
    if (!sint_fits(u, k) && sint_fits(u, 0 - k)) {
        return Cast(Sint(u), boxed(Int(0 - k)));
    }
    return d;
}

pub fn neg_least_at(u: UintTy, x: SrcExpr, d: SrcExpr) -> SrcExpr {
    return match (x) {
        Int(k) -> least_cast(u, k, d),
        Boolean(b) -> d,
        Unsigned(v, k) -> d,
        Local(id) -> d,
        Field(id, j) -> d,
        Negate(y) -> d,
        Not(y) -> d,
        Apply(op, a, b) -> d,
        Cast(t, y) -> d,
        Null -> d,
        SrcExpr::Char(code) -> d,
    };
}

// `-k` at a narrow signed type whose least value is -k, which k alone is not
// in the range of: the cast of the i32 literal -k.
pub fn neg_least(want: core::option::Option<SrcType>, x: SrcExpr, d: SrcExpr) -> SrcExpr {
    return match (want) {
        None -> d,
        Some(t) -> match (t) {
            I32 -> d,
            Bool -> d,
            Uint(u) -> d,
            Struct(id, fields) -> d,
            Enum(id, variants) -> d,
            Ptr -> d,
            Slice(el) -> d,
            Unit -> d,
            Isize -> d,
            SrcType::Char -> d,
            Sint(sk) -> neg_least_at(sk, x, d),
        },
    };
}

// An expression's type when it does not rest on literals.
pub fn known_expr(locals: List<LocalTy>, e: SrcExpr) -> core::option::Option<SrcType> {
    return match (e) {
        Int(k) -> None,
        Boolean(b) -> Some(Bool),
        Unsigned(u, k) -> Some(Uint(u)),
        Local(id) -> ty_local(locals, id),
        Field(id, j) -> ty_at(src_fields(ty_local(locals, id)), j),
        Negate(x) -> known_expr(locals, unbox(x)),
        Not(x) -> Some(Bool),
        Apply(op, a, b) -> known_apply(op, known_expr(locals, unbox(a)), known_expr(locals, unbox(b))),
        Cast(t, x) -> known_cast(t),
        Null -> Some(Ptr),
        SrcExpr::Char(code) -> Some(SrcType::Char),
    };
}

pub fn lit_expr(locals: List<LocalTy>, want: core::option::Option<SrcType>, e: SrcExpr) -> SrcExpr {
    return match (e) {
        Int(k) -> int_at(want, k, e),
        Boolean(b) -> e,
        Unsigned(u, k) -> e,
        Local(id) -> e,
        Field(id, j) -> e,
        Negate(x) -> match (wide_value(unbox(x))) {
            None -> neg_least(want, unbox(x), Negate(boxed(lit_expr(locals, want, unbox(x))))),
            Some(n) -> neg_wide_at(want, n, e),
        },
        Not(x) -> Not(boxed(lit_expr(locals, Some(Bool), unbox(x)))),
        Apply(op, a, b) -> Apply(op, boxed(lit_expr(locals, operand_want(op, want, known_expr(locals, unbox(a)), known_expr(locals, unbox(b))), unbox(a))), boxed(lit_expr(locals, amount_want(op, want, known_expr(locals, unbox(a)), known_expr(locals, unbox(b))), unbox(b)))),
        Cast(t, x) -> match (wide_value(e)) {
            None -> Cast(t, boxed(lit_expr(locals, None, unbox(x)))),
            Some(n) -> wide_at(want, n, e),
        },

        Null -> e,
        SrcExpr::Char(code) -> e,
    };
}

pub fn lit_exprs(locals: List<LocalTy>, wants: core::option::Option<List<SrcType>>, es: List<SrcExpr>) -> List<SrcExpr> {
    return match (es) {
        Nil -> empty(),
        Cons(e, rest) -> cons(lit_expr(locals, first_src(wants), e), lit_exprs(locals, rest_src(wants), unbox(rest))),
    };
}

pub fn lit_src_arms(locals: List<LocalTy>, payloads: core::option::Option<List<List<SrcType>>>, t: SrcType, arms: List<SrcArm>) -> List<SrcArm> {
    return match (arms) {
        Nil -> empty(),
        Cons(a, rest) -> cons(SrcArm { binders: a.binders, value: lit_expr(bound_tys(a.binders, payload_at(payloads, 0), locals), Some(t), a.value) }, lit_src_arms(locals, rest_payloads(payloads), t, unbox(rest))),
    };
}

pub fn src_param_tys(ps: List<SrcParam>) -> List<SrcType> {
    return match (ps) {
        Nil -> empty(),
        Cons(p, rest) -> cons(p.ty, src_param_tys(unbox(rest))),
    };
}

pub fn callee_params(funcs: List<SrcFunc>, f: usize) -> core::option::Option<List<SrcType>> {
    return match (get(funcs, f)) {
        None -> None,
        Some(g) -> Some(src_param_tys(g.params)),
    };
}

pub fn callee_ret(funcs: List<SrcFunc>, f: usize) -> core::option::Option<SrcType> {
    return match (get(funcs, f)) {
        None -> None,
        Some(g) -> Some(g.ret),
    };
}

pub fn known_eff(funcs: List<SrcFunc>, locals: List<LocalTy>, x: SrcEff) -> core::option::Option<SrcType> {
    return match (x) {
        EPure(e) -> known_expr(locals, e),
        ECall(f, args) -> callee_ret(funcs, f),
        EApply(op, a, b) -> known_apply(op, known_eff(funcs, locals, unbox(a)), known_eff(funcs, locals, unbox(b))),
        ENeg(a) -> known_eff(funcs, locals, unbox(a)),
        ENot(a) -> Some(Bool),
        ECast(t, a) -> Some(t),
        EIndex(s, i) -> src_element(ty_local(locals, s)),
        EStruct(t, fs) -> Some(t),
        EVariant(t, k, ps) -> Some(t),
        EMatch(s, ety, t, bs, vs) -> Some(t),
        EDivide(op, a, b) -> either_ty(known_eff(funcs, locals, unbox(a)), known_eff(funcs, locals, unbox(b))),
        EStride(s) -> Some(Isize),
    };
}

// extract: mutual begin
pub fn lit_eff(funcs: List<SrcFunc>, locals: List<LocalTy>, want: core::option::Option<SrcType>, x: SrcEff) -> SrcEff {
    return match (x) {
        EPure(e) -> EPure(lit_expr(locals, want, e)),
        ECall(f, args) -> ECall(f, boxed(lit_effs(funcs, locals, callee_params(funcs, f), unbox(args)))),
        EApply(op, a, b) -> EApply(op, boxed(lit_eff(funcs, locals, operand_want(op, want, known_eff(funcs, locals, unbox(a)), known_eff(funcs, locals, unbox(b))), unbox(a))), boxed(lit_eff(funcs, locals, amount_want(op, want, known_eff(funcs, locals, unbox(a)), known_eff(funcs, locals, unbox(b))), unbox(b)))),
        ENeg(a) -> ENeg(boxed(lit_eff(funcs, locals, want, unbox(a)))),
        ENot(a) -> ENot(boxed(lit_eff(funcs, locals, Some(Bool), unbox(a)))),
        ECast(t, a) -> ECast(t, boxed(lit_eff(funcs, locals, None, unbox(a)))),
        EIndex(s, i) -> EIndex(s, boxed(lit_eff(funcs, locals, None, unbox(i)))),
        EStruct(t, fs) -> EStruct(t, boxed(lit_effs(funcs, locals, src_fields(Some(t)), unbox(fs)))),
        EVariant(t, k, ps) -> EVariant(t, k, boxed(lit_effs(funcs, locals, payload_at(src_variants(Some(t)), k), unbox(ps)))),
        EMatch(s, ety, t, bs, vs) -> EMatch(boxed(lit_eff(funcs, locals, Some(ety), unbox(s))), ety, t, bs, boxed(lit_arm_effs(funcs, locals, src_variants(Some(ety)), t, bs, unbox(vs)))),
        EDivide(op, a, b) -> EDivide(op, boxed(lit_eff(funcs, locals, operand_want(Plus, want, known_eff(funcs, locals, unbox(a)), known_eff(funcs, locals, unbox(b))), unbox(a))), boxed(lit_eff(funcs, locals, operand_want(Plus, want, known_eff(funcs, locals, unbox(a)), known_eff(funcs, locals, unbox(b))), unbox(b)))),
        EStride(s) -> EStride(s),
    };
}

pub fn lit_effs(funcs: List<SrcFunc>, locals: List<LocalTy>, wants: core::option::Option<List<SrcType>>, xs: List<SrcEff>) -> List<SrcEff> {
    return match (xs) {
        Nil -> empty(),
        Cons(x, rest) -> cons(lit_eff(funcs, locals, first_src(wants), x), lit_effs(funcs, locals, rest_src(wants), unbox(rest))),
    };
}

// A match's arm values, each with its binders typed by its variant's payload.
pub fn lit_arm_effs(funcs: List<SrcFunc>, locals: List<LocalTy>, payloads: core::option::Option<List<List<SrcType>>>, t: SrcType, bs: List<List<usize>>, vs: List<SrcEff>) -> List<SrcEff> {
    return match (vs) {
        Nil -> empty(),
        Cons(v, rest) -> cons(lit_eff(funcs, bound_tys(first_ids(bs), payload_at(payloads, 0), locals), Some(t), v), lit_arm_effs(funcs, locals, rest_payloads(payloads), t, rest_ids(bs), unbox(rest))),
    };
}
// extract: mutual end

pub fn with_local(id: usize, ty: SrcType, locals: List<LocalTy>) -> List<LocalTy> {
    return cons(LocalTy { id: id, ty: ty }, locals);
}

pub fn lit_stmt(funcs: List<SrcFunc>, ret: SrcType, locals: List<LocalTy>, s: SrcStmt) -> SrcStmt {
    return match (s) {
        Nop -> Nop,
        Let(id, ty, e, body) -> Let(id, ty, lit_expr(locals, Some(ty), e), boxed(lit_stmt(funcs, ret, with_local(id, ty, locals), unbox(body)))),
        LetStruct(id, ty, es, body) -> LetStruct(id, ty, lit_exprs(locals, src_fields(Some(ty)), es), boxed(lit_stmt(funcs, ret, with_local(id, ty, locals), unbox(body)))),
        LetCall(id, ty, f, args, body) -> LetCall(id, ty, f, lit_exprs(locals, callee_params(funcs, f), args), boxed(lit_stmt(funcs, ret, with_local(id, ty, locals), unbox(body)))),
        LetEnum(id, ty, k, es, body) -> LetEnum(id, ty, k, lit_exprs(locals, payload_at(src_variants(Some(ty)), k), es), boxed(lit_stmt(funcs, ret, with_local(id, ty, locals), unbox(body)))),
        LetMatch(id, ty, sc, eid, arms, body) -> LetMatch(id, ty, sc, eid, lit_src_arms(locals, src_variants(ty_local(locals, sc)), ty, arms), boxed(lit_stmt(funcs, ret, with_local(id, ty, locals), unbox(body)))),
        Set(id, e) -> Set(id, lit_expr(locals, ty_local(locals, id), e)),
        SetField(id, j, e) -> SetField(id, j, lit_expr(locals, ty_at(src_fields(ty_local(locals, id)), j), e)),
        SetCall(id, f, args) -> SetCall(id, f, lit_exprs(locals, callee_params(funcs, f), args)),
        Then(a, b) -> Then(boxed(lit_stmt(funcs, ret, locals, unbox(a))), boxed(lit_stmt(funcs, ret, locals, unbox(b)))),
        If(c, a, b) -> If(lit_expr(locals, Some(Bool), c), boxed(lit_stmt(funcs, ret, locals, unbox(a))), boxed(lit_stmt(funcs, ret, locals, unbox(b)))),
        While(c, body) -> While(lit_expr(locals, Some(Bool), c), boxed(lit_stmt(funcs, ret, locals, unbox(body)))),
        Return(e) -> Return(lit_expr(locals, Some(ret), e)),
        LetAlloc(id, size, shift, body) -> LetAlloc(id, lit_expr(locals, None, size), shift, boxed(lit_stmt(funcs, ret, with_local(id, Ptr, locals), unbox(body)))),
        LetLoad(id, p, o, body) -> LetLoad(id, lit_expr(locals, None, p), lit_expr(locals, None, o), boxed(lit_stmt(funcs, ret, with_local(id, Uint(Uint8), locals), unbox(body)))),
        SetByte(p, o, v) -> SetByte(lit_expr(locals, None, p), lit_expr(locals, None, o), lit_expr(locals, None, v)),
        Free(p, size, shift) -> Free(lit_expr(locals, None, p), lit_expr(locals, None, size), shift),
        LetSlice(id, el, p, n, body) -> LetSlice(id, el, lit_expr(locals, None, p), lit_expr(locals, None, n), boxed(lit_stmt(funcs, ret, with_local(id, Slice(boxed(el)), locals), unbox(body)))),
        LetIndex(id, ty, sl, i, body) -> LetIndex(id, ty, sl, lit_expr(locals, None, i), boxed(lit_stmt(funcs, ret, with_local(id, ty, locals), unbox(body)))),
        SetIndex(sl, i, v) -> SetIndex(sl, lit_expr(locals, None, i), lit_expr(locals, src_element(ty_local(locals, sl)), v)),
        LetEval(id, ty, x, body) -> LetEval(id, ty, lit_eff(funcs, locals, Some(ty), x), boxed(lit_stmt(funcs, ret, with_local(id, ty, locals), unbox(body)))),
        SetEval(id, x) -> SetEval(id, lit_eff(funcs, locals, ty_local(locals, id), x)),
        IfEval(c, a, b) -> IfEval(lit_eff(funcs, locals, Some(Bool), c), boxed(lit_stmt(funcs, ret, locals, unbox(a))), boxed(lit_stmt(funcs, ret, locals, unbox(b)))),
        WhileEval(c, body) -> WhileEval(lit_eff(funcs, locals, Some(Bool), c), boxed(lit_stmt(funcs, ret, locals, unbox(body)))),
        ReturnEval(x) -> ReturnEval(lit_eff(funcs, locals, Some(ret), x)),
        Discard(x) -> Discard(lit_eff(funcs, locals, None, x)),
        SetIndexEval(sl, i, v) -> SetIndexEval(sl, lit_eff(funcs, locals, None, i), lit_eff(funcs, locals, src_element(ty_local(locals, sl)), v)),
        SetFieldEval(id, j, x) -> SetFieldEval(id, j, lit_eff(funcs, locals, ty_at(src_fields(ty_local(locals, id)), j), x)),
        ReturnUnit -> ReturnUnit,
        Assert(x) -> Assert(lit_eff(funcs, locals, Some(Bool), x)),
        Break -> Break,
        Continue -> Continue,
        MatchArm(sc, en, k, bs, x, ty, body, rest) -> MatchArm(sc, en, k, bs, x, ty, boxed(lit_stmt(funcs, ret, with_local(x, ty, locals), unbox(body))), boxed(lit_stmt(funcs, ret, locals, unbox(rest)))),
    };
}

pub fn param_locals(ps: List<SrcParam>) -> List<LocalTy> {
    return match (ps) {
        Nil -> empty(),
        Cons(p, rest) -> cons(LocalTy { id: p.id, ty: p.ty }, param_locals(unbox(rest))),
    };
}

// Every function's literals typed, with all the functions' signatures.
pub fn lit_funcs(all: List<SrcFunc>, fs: List<SrcFunc>) -> List<SrcFunc> {
    return match (fs) {
        Nil -> empty(),
        Cons(g, rest) -> cons(SrcFunc { params: g.params, ret: g.ret, body: lit_stmt(all, g.ret, param_locals(g.params), g.body) }, lit_funcs(all, unbox(rest))),
    };
}

// ---------------------------------------------------------------- wide literals left untyped

// A wide literal that lit_funcs gave no type (see wide_marker) is rejected.
pub fn wide_left(e: SrcExpr) -> bool {
    return match (e) {
        Int(k) -> false,
        Boolean(b) -> false,
        Unsigned(u, k) -> false,
        Local(id) -> false,
        Field(id, j) -> false,
        Negate(x) -> wide_left(unbox(x)),
        Not(x) -> wide_left(unbox(x)),
        Apply(op, a, b) -> wide_left(unbox(a)) || wide_left(unbox(b)),
        Cast(t, x) -> unit_ty(t) || wide_left(unbox(x)),
        Null -> false,
        SrcExpr::Char(code) -> false,
    };
}

pub fn wide_left_exprs(es: List<SrcExpr>) -> bool {
    return match (es) {
        Nil -> false,
        Cons(e, rest) -> wide_left(e) || wide_left_exprs(unbox(rest)),
    };
}

pub fn wide_left_arms(arms: List<SrcArm>) -> bool {
    return match (arms) {
        Nil -> false,
        Cons(a, rest) -> wide_left(a.value) || wide_left_arms(unbox(rest)),
    };
}

// extract: mutual begin
pub fn wide_left_eff(x: SrcEff) -> bool {
    return match (x) {
        EPure(e) -> wide_left(e),
        ECall(f, args) -> wide_left_effs(unbox(args)),
        EApply(op, a, b) -> wide_left_eff(unbox(a)) || wide_left_eff(unbox(b)),
        ENeg(a) -> wide_left_eff(unbox(a)),
        ENot(a) -> wide_left_eff(unbox(a)),
        ECast(t, a) -> wide_left_eff(unbox(a)),
        EIndex(sl, i) -> wide_left_eff(unbox(i)),
        EStruct(t, fs) -> wide_left_effs(unbox(fs)),
        EVariant(t, k, ps) -> wide_left_effs(unbox(ps)),
        EMatch(sc, ety, t, bs, vs) -> wide_left_eff(unbox(sc)) || wide_left_effs(unbox(vs)),
        EDivide(op, a, b) -> wide_left_eff(unbox(a)) || wide_left_eff(unbox(b)),
        EStride(sl) -> false,
    };
}

pub fn wide_left_effs(xs: List<SrcEff>) -> bool {
    return match (xs) {
        Nil -> false,
        Cons(x, rest) -> wide_left_eff(x) || wide_left_effs(unbox(rest)),
    };
}
// extract: mutual end

pub fn wide_left_stmt(s: SrcStmt) -> bool {
    return match (s) {
        Nop -> false,
        Let(id, ty, e, body) -> wide_left(e) || wide_left_stmt(unbox(body)),
        LetStruct(id, ty, es, body) -> wide_left_exprs(es) || wide_left_stmt(unbox(body)),
        LetCall(id, ty, f, args, body) -> wide_left_exprs(args) || wide_left_stmt(unbox(body)),
        LetEnum(id, ty, k, es, body) -> wide_left_exprs(es) || wide_left_stmt(unbox(body)),
        LetMatch(id, ty, sc, eid, arms, body) -> wide_left_arms(arms) || wide_left_stmt(unbox(body)),
        Set(id, e) -> wide_left(e),
        SetField(id, j, e) -> wide_left(e),
        SetCall(id, f, args) -> wide_left_exprs(args),
        Then(a, b) -> wide_left_stmt(unbox(a)) || wide_left_stmt(unbox(b)),
        If(c, a, b) -> wide_left(c) || wide_left_stmt(unbox(a)) || wide_left_stmt(unbox(b)),
        While(c, body) -> wide_left(c) || wide_left_stmt(unbox(body)),
        Return(e) -> wide_left(e),
        LetAlloc(id, size, shift, body) -> wide_left(size) || wide_left_stmt(unbox(body)),
        LetLoad(id, p, o, body) -> wide_left(p) || wide_left(o) || wide_left_stmt(unbox(body)),
        SetByte(p, o, v) -> wide_left(p) || wide_left(o) || wide_left(v),
        Free(p, size, shift) -> wide_left(p) || wide_left(size),
        LetSlice(id, el, p, n, body) -> wide_left(p) || wide_left(n) || wide_left_stmt(unbox(body)),
        LetIndex(id, ty, sl, i, body) -> wide_left(i) || wide_left_stmt(unbox(body)),
        SetIndex(sl, i, v) -> wide_left(i) || wide_left(v),
        LetEval(id, ty, x, body) -> wide_left_eff(x) || wide_left_stmt(unbox(body)),
        SetEval(id, x) -> wide_left_eff(x),
        IfEval(c, a, b) -> wide_left_eff(c) || wide_left_stmt(unbox(a)) || wide_left_stmt(unbox(b)),
        WhileEval(c, body) -> wide_left_eff(c) || wide_left_stmt(unbox(body)),
        ReturnEval(x) -> wide_left_eff(x),
        Discard(x) -> wide_left_eff(x),
        SetIndexEval(sl, i, v) -> wide_left_eff(i) || wide_left_eff(v),
        SetFieldEval(id, j, x) -> wide_left_eff(x),
        ReturnUnit -> false,
        Assert(x) -> wide_left_eff(x),
        Break -> false,
        Continue -> false,
        MatchArm(sc, en, k, bs, x, ty, body, rest) -> wide_left_stmt(unbox(body)) || wide_left_stmt(unbox(rest)),
    };
}

pub fn wide_left_funcs(fs: List<SrcFunc>) -> bool {
    return match (fs) {
        Nil -> false,
        Cons(g, rest) -> wide_left_stmt(g.body) || wide_left_funcs(unbox(rest)),
    };
}

pub fn untyped_rejected(fs: List<SrcFunc>) -> core::option::Option<SrcProgram> {
    if (wide_left_funcs(fs)) {
        return None;
    }
    return Some(SrcProgram { funcs: fs });
}

// ---------------------------------------------------------------- the program

pub fn build_closed(fuel: usize, decls: Decls, fns: List<Inst>, types: core::option::Option<List<Inst>>, funcs: List<MFunc>) -> core::option::Option<SrcProgram> {
    return match (types) {
        None -> None,
        Some(ts) -> match (close_funcs(fuel, Tables { decls: decls, fns: fns, types: ts, lowered: lowered_all(fuel, decls, ts, ts) }, funcs)) {
            None -> None,
            Some(fs) -> untyped_rejected(lit_funcs(fs, fs)),
        },
    };
}

pub fn build_mono(fuel: usize, decls: Decls, seeds: List<Inst>, m: core::option::Option<Mono>) -> core::option::Option<SrcProgram> {
    return match (m) {
        None -> None,
        Some(x) -> build_closed(fuel, decls, x.table, type_table_more(fuel, decls, type_table(fuel, decls, seeds, seed_tys(seeds)), funcs_tys(x.funcs)), x.funcs),
    };
}

// The roots are the first file's functions without type parameters, in
// order; they keep their positions as ids. Every other function instance
// is numbered when it is first called.
pub fn build_checked(fuel: usize, c: Collected, roots: List<Inst>, seeds: List<Inst>) -> core::option::Option<SrcProgram> {
    if (well_named(c)) {
        return build_mono(fuel, c.decls, seeds, mono_loop(fuel, fuel, c.decls, roots, empty(), 0));
    }
    return None;
}

pub fn build_collected(fuel: usize, first: FileDecls, c: core::option::Option<Collected>) -> core::option::Option<SrcProgram> {
    return match (c) {
        None -> None,
        Some(x) -> build_checked(fuel, x, root_insts(first.decls.fns, 0), seed_insts(first.decls.types, 0)),
    };
}

// The source program of the concrete trees of several files, each a
// module; the first is the program's own.
pub fn build_files(fuel: usize, roots: List<CTree>) -> core::option::Option<SrcProgram> {
    return match (roots) {
        Nil -> None,
        Cons(first, rest) -> match (file_decls(fuel, first)) {
            None -> None,
            Some(f) -> build_collected(fuel, f, collect_files(fuel, unbox(rest), Collected { decls: f.decls, modules: single(f.home) })),
        },
    };
}

// The source program of the concrete tree of a file.
pub fn build(fuel: usize, root: CTree) -> core::option::Option<SrcProgram> {
    return build_files(fuel, single(root));
}

// The front end: the source program of a parse, if the parse is a derivation
// of the tokens and the program is in the subset.
pub fn front_end(g: List<Rule>, tokens: List<Token>, prods: List<usize>, parents: List<usize>) -> core::option::Option<SrcProgram> {
    return match (validate_tree(g, tokens, prods, parents)) {
        None -> None,
        Some(root) -> build(plus(times(4, plus(length(prods), length(tokens))), 16), root),
    };
}

// One file: its tokens and laniusc's parse tree.
pub struct FileInput {
    tokens: List<Token>,
    prods: List<usize>,
    parents: List<usize>,
}

pub fn cons_root(root: core::option::Option<CTree>, rest: core::option::Option<List<CTree>>) -> core::option::Option<List<CTree>> {
    return match (root) {
        None -> None,
        Some(r) -> match (rest) {
            None -> None,
            Some(rs) -> Some(cons(r, rs)),
        },
    };
}

pub fn validate_files(g: List<Rule>, files: List<FileInput>) -> core::option::Option<List<CTree>> {
    return match (files) {
        Nil -> Some(empty()),
        Cons(f, rest) -> cons_root(validate_tree(g, f.tokens, f.prods, f.parents), validate_files(g, unbox(rest))),
    };
}

pub fn files_fuel(files: List<FileInput>) -> usize {
    return match (files) {
        Nil -> 16,
        Cons(f, rest) -> plus(times(4, plus(length(f.prods), length(f.tokens))), files_fuel(unbox(rest))),
    };
}

// The front end for several files, the program's own first.
pub fn front_end_files(g: List<Rule>, files: List<FileInput>) -> core::option::Option<SrcProgram> {
    return match (validate_files(g, files)) {
        None -> None,
        Some(roots) -> build_files(files_fuel(files), roots),
    };
}

// ---------------------------------------------------------------- the lexer

// The Lean lexer (`Lanius.Compiler.Lexer.lexCanonical`, with `as` read as the
// cast keyword as in `lexTokens`) written over byte values, with laniusc's
// token kind codes: each function is the Lean one of the same shape, and
// `Lanius/Mini/LexCorrect.lean` proves `lex_source` equal to `lexTokens`.
// Offsets are into `source`, which the stream driver sets to what is left of
// the file.

// A token before canonicalizing: its kind code and its bytes' offsets.
pub struct RawTok {
    kind: usize,
    start: usize,
    finish: usize,
}

// A scan's end: where it stopped, or the offset of the error.
pub enum Scan {
    ScanDone(usize),
    ScanFail(usize),
}

// A number's kind code and end, or the offset of the error.
pub enum NumScan {
    NumDone(usize, usize),
    NumFail(usize),
}

// One token, or the offset of the error.
pub enum OneTok {
    OneDone(RawTok),
    OneFail(usize),
}

// A fixed spelling and its token kind code.
pub struct SymRule {
    spelling: List<usize>,
    kind: usize,
}

pub fn lx_ident_start(b: usize) -> bool {
    return (97 <= b && b <= 122) || (65 <= b && b <= 90) || b == 95;
}

pub fn lx_digit(b: usize) -> bool {
    return 48 <= b && b <= 57;
}

pub fn lx_ident_continue(b: usize) -> bool {
    return lx_ident_start(b) || lx_digit(b);
}

pub fn lx_space(b: usize) -> bool {
    return b == 32 || b == 9 || b == 10 || b == 13;
}

pub fn lx_symbol_start(b: usize) -> bool {
    return b == 40 || b == 41 || b == 43 || b == 42 || b == 61 || b == 45 || b == 47 || b == 33 || b == 91 || b == 93 || b == 123 || b == 125 || b == 60 || b == 62 || b == 38 || b == 124 || b == 37 || b == 94 || b == 126 || b == 44 || b == 59 || b == 58 || b == 63 || b == 46;
}

pub fn lx_drop(items: List<usize>, n: usize) -> List<usize> {
    if (n == 0) {
        return items;
    }
    return match (items) {
        Nil -> empty(),
        Cons(b, more) -> lx_drop(unbox(more), minus(n, 1)),
    };
}

pub fn lx_take(items: List<usize>, n: usize) -> List<usize> {
    if (n == 0) {
        return empty();
    }
    return match (items) {
        Nil -> empty(),
        Cons(b, more) -> cons(b, lx_take(unbox(more), minus(n, 1))),
    };
}

pub fn lx_is_byte(b: core::option::Option<usize>, v: usize) -> bool {
    return match (b) {
        None -> false,
        Some(x) -> x == v,
    };
}

// The number of leading identifier bytes.
pub fn lx_ident_run(rest: List<usize>) -> usize {
    return match (rest) {
        Nil -> 0,
        Cons(b, more) -> lx_ident_run_at(b, unbox(more)),
    };
}

// extract: inline
fn lx_ident_run_at(ib: usize, imore: List<usize>) -> usize {
    if (lx_ident_continue(ib)) {
        return plus(lx_ident_run(imore), 1);
    }
    return 0;
}

// The number of leading whitespace bytes.
pub fn lx_space_run(rest: List<usize>) -> usize {
    return match (rest) {
        Nil -> 0,
        Cons(b, more) -> lx_space_run_at(b, unbox(more)),
    };
}

// extract: inline
fn lx_space_run_at(sb: usize, smore: List<usize>) -> usize {
    if (lx_space(sb)) {
        return plus(lx_space_run(smore), 1);
    }
    return 0;
}

// The number of leading bytes that are not a newline.
pub fn lx_line_run(rest: List<usize>) -> usize {
    return match (rest) {
        Nil -> 0,
        Cons(b, more) -> lx_line_run_at(b, unbox(more)),
    };
}

// extract: inline
fn lx_line_run_at(lb: usize, lmore: List<usize>) -> usize {
    if (lb != 10) {
        return plus(lx_line_run(lmore), 1);
    }
    return 0;
}

pub fn lx_ident_end(source: List<usize>, start: usize) -> usize {
    return plus(plus(start, 1), lx_ident_run(lx_drop(source, plus(start, 1))));
}

pub fn lx_space_end(source: List<usize>, start: usize) -> usize {
    return plus(plus(start, 1), lx_space_run(lx_drop(source, plus(start, 1))));
}

pub fn lx_line_end(source: List<usize>, start: usize) -> usize {
    return plus(plus(start, 2), lx_line_run(lx_drop(source, plus(start, 2))));
}

// `scanQuotedBody`: a string or character literal's body after its opening
// delimiter.
pub fn lx_quoted(delim: usize, escaping: bool, rest: List<usize>, offset: usize) -> Scan {
    return match (rest) {
        Nil -> ScanFail(offset),
        Cons(b, more) -> lx_quoted_at(delim, escaping, b, unbox(more), offset),
    };
}

// extract: inline
fn lx_quoted_at(qdelim: usize, qescaping: bool, qb: usize, qmore: List<usize>, qoffset: usize) -> Scan {
    if (qescaping) {
        return lx_quoted(qdelim, false, qmore, plus(qoffset, 1));
    }
    if (qb == 10) {
        return ScanFail(qoffset);
    }
    if (qb == qdelim) {
        return ScanDone(plus(qoffset, 1));
    }
    if (qb == 92) {
        return lx_quoted(qdelim, true, qmore, plus(qoffset, 1));
    }
    return lx_quoted(qdelim, false, qmore, plus(qoffset, 1));
}

// `scanBlockBody`: a block comment's body after its `/*`.
pub fn lx_block(rest: List<usize>, offset: usize) -> Scan {
    return match (rest) {
        Nil -> ScanFail(offset),
        Cons(b, more) -> lx_block_at(b, unbox(more), offset),
    };
}

// extract: inline
fn lx_block_at(kb: usize, kmore: List<usize>, koffset: usize) -> Scan {
    return match (kmore) {
        Nil -> ScanFail(plus(koffset, 1)),
        Cons(next, tail) -> lx_block_next(kb, next, kmore, koffset),
    };
}

// extract: inline
fn lx_block_next(nb: usize, nnext: usize, nmore: List<usize>, noffset: usize) -> Scan {
    if (nb == 42 && nnext == 47) {
        return ScanDone(plus(noffset, 2));
    }
    return lx_block(nmore, plus(noffset, 1));
}

pub fn lx_block_end(source: List<usize>, start: usize) -> Scan {
    return lx_block(lx_drop(source, plus(start, 2)), plus(start, 2));
}

pub fn lx_base_digit(b: usize, base: usize) -> bool {
    if (48 <= b && b <= 57) {
        return minus(b, 48) < base;
    }
    if (97 <= b && b <= 102) {
        return plus(minus(b, 97), 10) < base;
    }
    if (65 <= b && b <= 70) {
        return plus(minus(b, 65), 10) < base;
    }
    return false;
}

// `scanDigitTail`: digits of the base, each `_` followed by one.
pub fn lx_digit_tail(base: usize, rest: List<usize>, offset: usize) -> Scan {
    return match (rest) {
        Nil -> ScanDone(offset),
        Cons(b, more) -> lx_digit_tail_at(base, b, unbox(more), offset),
    };
}

// extract: inline
fn lx_digit_tail_at(dbase: usize, db: usize, dmore: List<usize>, doffset: usize) -> Scan {
    if (lx_base_digit(db, dbase)) {
        return lx_digit_tail(dbase, dmore, plus(doffset, 1));
    }
    if (db == 95) {
        return match (dmore) {
            Nil -> ScanFail(plus(doffset, 1)),
            Cons(next, after) -> lx_digit_sep(dbase, next, unbox(after), doffset),
        };
    }
    return ScanDone(doffset);
}

// extract: inline
fn lx_digit_sep(ebase: usize, enext: usize, eafter: List<usize>, eoffset: usize) -> Scan {
    if (lx_base_digit(enext, ebase)) {
        return lx_digit_tail(ebase, eafter, plus(eoffset, 2));
    }
    return ScanFail(plus(eoffset, 1));
}

// `scanDigitRun`: a digit of the base, then its tail.
pub fn lx_digit_run(source: List<usize>, start: usize, base: usize) -> Scan {
    return match (lx_drop(source, start)) {
        Nil -> ScanFail(start),
        Cons(first, rest) -> lx_digit_run_at(first, unbox(rest), start, base),
    };
}

// extract: inline
fn lx_digit_run_at(rfirst: usize, rrest: List<usize>, rstart: usize, rbase: usize) -> Scan {
    if (lx_base_digit(rfirst, rbase)) {
        return lx_digit_tail(rbase, rrest, plus(rstart, 1));
    }
    return ScanFail(rstart);
}

pub fn lx_exponent_digits(source: List<usize>, e: usize) -> usize {
    return match (get(source, plus(e, 1))) {
        None -> plus(e, 1),
        Some(b) -> lx_exponent_sign(b, e),
    };
}

// extract: inline
fn lx_exponent_sign(xb: usize, xe: usize) -> usize {
    if (xb == 43 || xb == 45) {
        return plus(plus(xe, 1), 1);
    }
    return plus(xe, 1);
}

pub fn lx_exponent(source: List<usize>, e: usize) -> NumScan {
    return match (lx_digit_run(source, lx_exponent_digits(source, e), 10)) {
        ScanDone(finish) -> NumDone(33, finish),
        ScanFail(error) -> NumFail(error),
    };
}

// After a fraction's digits: an exponent, or the float's end.
pub fn lx_after_fraction(source: List<usize>, fe: usize) -> NumScan {
    return match (get(source, fe)) {
        None -> NumDone(33, fe),
        Some(x) -> lx_after_fraction_at(source, fe, x),
    };
}

// extract: inline
fn lx_after_fraction_at(asource: List<usize>, afe: usize, ax: usize) -> NumScan {
    if (ax == 101 || ax == 69) {
        return lx_exponent(asource, afe);
    }
    return NumDone(33, afe);
}

pub fn lx_fraction_digits(source: List<usize>, run: Scan) -> NumScan {
    return match (run) {
        ScanFail(error) -> NumFail(error),
        ScanDone(fe) -> lx_after_fraction(source, fe),
    };
}

// The fraction after a decimal point at fs - 1.
pub fn lx_fraction(source: List<usize>, fs: usize) -> NumScan {
    return match (get(source, fs)) {
        None -> NumDone(33, fs),
        Some(first) -> lx_fraction_at(source, fs, first),
    };
}

// extract: inline
fn lx_fraction_at(fsource: List<usize>, ffs: usize, ffirst: usize) -> NumScan {
    if (48 <= ffirst && ffirst <= 57) {
        return lx_fraction_digits(fsource, lx_digit_run(fsource, ffs, 10));
    }
    if (ffirst == 101 || ffirst == 69) {
        return lx_exponent(fsource, ffs);
    }
    return NumDone(33, ffs);
}

// `finishDecimal`: what follows a decimal integer's digits.
pub fn lx_finish_decimal(source: List<usize>, ie: usize) -> NumScan {
    return match (get(source, ie)) {
        None -> NumDone(2, ie),
        Some(next) -> lx_decimal_next(source, ie, next),
    };
}

// extract: inline
fn lx_decimal_next(csource: List<usize>, cie: usize, cnext: usize) -> NumScan {
    if (cnext == 101 || cnext == 69) {
        return lx_exponent(csource, cie);
    }
    if (cnext != 46) {
        return NumDone(2, cie);
    }
    if (lx_is_byte(get(csource, plus(cie, 1)), 46)) {
        return NumDone(2, cie);
    }
    return lx_fraction(csource, plus(cie, 1));
}

pub fn lx_base_of(p: usize) -> core::option::Option<usize> {
    if (p == 120 || p == 88) {
        return Some(16);
    }
    if (p == 98 || p == 66) {
        return Some(2);
    }
    if (p == 111 || p == 79) {
        return Some(8);
    }
    return None;
}

// `prefixedBase`: 16, 2 or 8 after `0x`, `0b` or `0o`.
pub fn lx_prefixed_base(source: List<usize>, start: usize) -> core::option::Option<usize> {
    if (!lx_is_byte(get(source, start), 48)) {
        return None;
    }
    return match (get(source, plus(start, 1))) {
        None -> None,
        Some(p) -> lx_base_of(p),
    };
}

// `scanNumber`.
pub fn lx_number(source: List<usize>, start: usize) -> NumScan {
    return match (lx_prefixed_base(source, start)) {
        Some(base) -> match (lx_digit_run(source, plus(start, 2), base)) {
            ScanDone(finish) -> NumDone(2, finish),
            ScanFail(error) -> NumFail(error),
        },
        None -> match (lx_digit_run(source, start, 10)) {
            ScanDone(ie) -> lx_finish_decimal(source, ie),
            ScanFail(error) -> NumFail(error),
        },
    };
}

// `scanLeadingDotNumber`: a float that starts with its point.
pub fn lx_leading_dot(source: List<usize>, start: usize) -> NumScan {
    return lx_fraction_digits(source, lx_digit_run(source, plus(start, 1), 10));
}

pub fn lx_starts_with(expected: List<usize>, actual: List<usize>) -> bool {
    return match (expected) {
        Nil -> true,
        Cons(e, er) -> match (actual) {
            Nil -> false,
            Cons(a, ar) -> (e == a) && lx_starts_with(unbox(er), unbox(ar)),
        },
    };
}

pub fn lx_longer(candidate: SymRule, current: SymRule) -> SymRule {
    if (length(current.spelling) < length(candidate.spelling)) {
        return candidate;
    }
    return current;
}

pub fn lx_best_at(rule: SymRule, tail_best: core::option::Option<SymRule>, input: List<usize>) -> core::option::Option<SymRule> {
    if (lx_starts_with(rule.spelling, input)) {
        return match (tail_best) {
            None -> Some(rule),
            Some(current) -> Some(lx_longer(rule, current)),
        };
    }
    return tail_best;
}

// `bestMatching`: the longest rule whose spelling starts the input, the
// earliest of equal ones.
pub fn lx_best(rules: List<SymRule>, input: List<usize>) -> core::option::Option<SymRule> {
    return match (rules) {
        Nil -> None,
        Cons(rule, more) -> lx_best_at(rule, lx_best(unbox(more), input), input),
    };
}

pub fn lx_delimited(kind: usize, start: usize, scan: Scan) -> OneTok {
    return match (scan) {
        ScanDone(finish) -> OneDone(RawTok { kind: kind, start: start, finish: finish }),
        ScanFail(error) -> OneFail(error),
    };
}

pub fn lx_from_number(start: usize, scan: NumScan) -> OneTok {
    return match (scan) {
        NumDone(kind, finish) -> OneDone(RawTok { kind: kind, start: start, finish: finish }),
        NumFail(error) -> OneFail(error),
    };
}

pub fn lx_fixed_at(source: List<usize>, start: usize, rule: SymRule) -> OneTok {
    if (rule.kind == 10) {
        return OneDone(RawTok { kind: rule.kind, start: start, finish: lx_line_end(source, start) });
    }
    if (rule.kind == 11) {
        return lx_delimited(rule.kind, start, lx_block_end(source, start));
    }
    return OneDone(RawTok { kind: rule.kind, start: start, finish: plus(start, length(rule.spelling)) });
}

// `scanFixedSymbol`.
pub fn lx_fixed(rules: List<SymRule>, source: List<usize>, start: usize) -> OneTok {
    return match (lx_best(rules, lx_take(lx_drop(source, start), 3))) {
        None -> OneFail(start),
        Some(rule) -> lx_fixed_at(source, start, rule),
    };
}

pub fn lx_dot_at(rules: List<SymRule>, source: List<usize>, start: usize, following: usize) -> OneTok {
    if (lx_digit(following)) {
        return lx_from_number(start, lx_leading_dot(source, start));
    }
    return lx_fixed(rules, source, start);
}

pub fn lx_symbol_at(rules: List<SymRule>, source: List<usize>, start: usize, first: usize) -> OneTok {
    if (first == 46) {
        return match (get(source, plus(start, 1))) {
            Some(following) -> lx_dot_at(rules, source, start, following),
            None -> lx_fixed(rules, source, start),
        };
    }
    return lx_fixed(rules, source, start);
}

// `scanSymbol`: a float that starts with its point, or a fixed symbol.
pub fn lx_symbol(rules: List<SymRule>, source: List<usize>, start: usize) -> OneTok {
    return match (get(source, start)) {
        None -> OneFail(start),
        Some(first) -> lx_symbol_at(rules, source, start, first),
    };
}

pub fn lx_one_first(rules: List<SymRule>, source: List<usize>, start: usize, first: usize) -> OneTok {
    if (lx_ident_start(first)) {
        return OneDone(RawTok { kind: 1, start: start, finish: lx_ident_end(source, start) });
    }
    if (lx_digit(first)) {
        return lx_from_number(start, lx_number(source, start));
    }
    if (lx_space(first)) {
        return OneDone(RawTok { kind: 3, start: start, finish: lx_space_end(source, start) });
    }
    if (first == 34) {
        return lx_delimited(32, start, lx_quoted(34, false, lx_drop(source, plus(start, 1)), plus(start, 1)));
    }
    if (first == 39) {
        return lx_delimited(34, start, lx_quoted(39, false, lx_drop(source, plus(start, 1)), plus(start, 1)));
    }
    if (lx_symbol_start(first)) {
        return lx_symbol(rules, source, start);
    }
    return OneFail(start);
}

// `scanOneAt`: the token at start, by its first byte.
pub fn lx_one_at(rules: List<SymRule>, source: List<usize>, start: usize) -> OneTok {
    return match (get(source, start)) {
        None -> OneFail(start),
        Some(first) -> lx_one_first(rules, source, start, first),
    };
}

pub fn lx_shift(offset: usize, t: RawTok) -> RawTok {
    return RawTok { kind: t.kind, start: plus(offset, t.start), finish: plus(offset, t.finish) };
}

pub fn lx_prepend(t: RawTok, rest: core::option::Option<List<RawTok>>) -> core::option::Option<List<RawTok>> {
    return match (rest) {
        None -> None,
        Some(ts) -> Some(cons(t, ts)),
    };
}

// `lexRawFromRest`: the tokens of what is left of the file, rest, which
// starts at offset.
pub fn lx_raw(rules: List<SymRule>, rest: List<usize>, fuel: usize, offset: usize) -> core::option::Option<List<RawTok>> {
    if (fuel == 0) {
        return None;
    }
    return match (rest) {
        Nil -> Some(empty()),
        Cons(b, more) -> match (lx_one_at(rules, rest, 0)) {
            OneFail(error) -> None,
            OneDone(t) -> lx_prepend(lx_shift(offset, t), lx_raw(rules, lx_drop(rest, minus(plus(offset, t.finish), offset)), minus(fuel, 1), plus(offset, t.finish))),
        },
    };
}

pub fn lx_trivia(kind: usize) -> bool {
    return kind == 3 || kind == 10 || kind == 11;
}

// `exactKeywordKind`.
pub fn lx_keyword(spelling: List<usize>, rules: List<SymRule>) -> core::option::Option<usize> {
    return match (rules) {
        Nil -> None,
        Cons(rule, more) -> lx_keyword_at(spelling, rule, unbox(more)),
    };
}

// extract: inline
fn lx_keyword_at(wspelling: List<usize>, wrule: SymRule, wmore: List<SymRule>) -> core::option::Option<usize> {
    if (same_text(wspelling, wrule.spelling)) {
        return Some(wrule.kind);
    }
    return lx_keyword(wspelling, wmore);
}

pub fn lx_drop_to(source: List<usize>, rest: List<usize>, pos: usize, target: usize) -> List<usize> {
    if (pos <= target) {
        return lx_drop(rest, minus(target, pos));
    }
    return lx_drop(source, target);
}

pub fn lx_canonical_kind(keywords: List<SymRule>, here: List<usize>, t: RawTok) -> usize {
    if (t.kind == 1) {
        return match (lx_keyword(lx_take(here, minus(t.finish, t.start)), keywords)) {
            None -> 1,
            Some(k) -> k,
        };
    }
    return t.kind;
}

// `filterRetagFrom`: the tokens without trivia, keywords retagged; rest is
// source from pos.
pub fn lx_filter(keywords: List<SymRule>, source: List<usize>, rest: List<usize>, pos: usize, tokens: List<RawTok>) -> List<RawTok> {
    return match (tokens) {
        Nil -> empty(),
        Cons(t, more) -> lx_filter_at(keywords, source, lx_drop_to(source, rest, pos, t.start), t, unbox(more)),
    };
}

// extract: inline
fn lx_filter_at(fkeywords: List<SymRule>, fsource: List<usize>, fhere: List<usize>, ft: RawTok, fmore: List<RawTok>) -> List<RawTok> {
    if (lx_trivia(ft.kind)) {
        return lx_filter(fkeywords, fsource, fhere, ft.start, fmore);
    }
    return cons(RawTok { kind: lx_canonical_kind(fkeywords, fhere, ft), start: ft.start, finish: ft.finish }, lx_filter(fkeywords, fsource, fhere, ft.start, fmore));
}

pub fn lx_range_pair(current: RawTok, next: RawTok) -> RawTok {
    if (current.kind == 182 && next.kind == 8 && next.start == current.finish) {
        return RawTok { kind: 189, start: current.start, finish: current.finish };
    }
    return current;
}

// `retagInclusiveRanges`: `..` then `=` right after it is `..=`.
pub fn lx_ranges(tokens: List<RawTok>) -> List<RawTok> {
    return match (tokens) {
        Nil -> empty(),
        Cons(t, more) -> lx_ranges_at(t, unbox(more)),
    };
}

// extract: inline
fn lx_ranges_at(gt: RawTok, gmore: List<RawTok>) -> List<RawTok> {
    return match (gmore) {
        Nil -> single(gt),
        Cons(next, rest) -> cons(lx_range_pair(gt, next), lx_ranges(gmore)),
    };
}

// The bytes of `as`.
pub fn lx_as_text() -> List<usize> {
    return cons(97, single(115));
}

pub fn lx_token_text(t: RawTok, text: List<usize>) -> Token {
    if (t.kind == 1 && same_text(text, lx_as_text())) {
        return Token { kind: 195, start: t.start, text: text };
    }
    return Token { kind: t.kind, start: t.start, text: text };
}

// `toTokenAt`: the token with its bytes; the identifier `as` is the cast
// keyword, 195.
pub fn lx_token(here: List<usize>, t: RawTok) -> Token {
    return lx_token_text(t, lx_take(here, minus(t.finish, t.start)));
}

// `toTokensFrom`.
pub fn lx_tokens(source: List<usize>, rest: List<usize>, pos: usize, tokens: List<RawTok>) -> List<Token> {
    return match (tokens) {
        Nil -> empty(),
        Cons(t, more) -> lx_tokens_at(source, lx_drop_to(source, rest, pos, t.start), t, unbox(more)),
    };
}

// extract: inline
fn lx_tokens_at(tsource: List<usize>, there: List<usize>, tt: RawTok, tmore: List<RawTok>) -> List<Token> {
    return cons(lx_token(there, tt), lx_tokens(tsource, there, tt.start, tmore));
}

// `symbolRules`: each fixed symbol's bytes and token code.
pub fn lx_symbol_rules() -> List<SymRule> {
    return
        cons(SymRule { spelling: cons(60, cons(60, single(61))), kind: 52 },
        cons(SymRule { spelling: cons(62, cons(62, single(61))), kind: 53 },
