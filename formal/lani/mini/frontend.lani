// 78 else_stmt, 79 else_none.
pub fn grammar_part_3() -> List<Rule> {
    return cons(Rule { lhs: 34, rhs: empty() },
        cons(Rule { lhs: 34, rhs: cons(Nonterm(35), cons(Nonterm(37), empty())) },
        cons(Rule { lhs: 35, rhs: cons(Term(1), cons(Term(38), cons(Nonterm(38), empty()))) },
        cons(Rule { lhs: 35, rhs: cons(Term(105), cons(Nonterm(36), empty())) },
