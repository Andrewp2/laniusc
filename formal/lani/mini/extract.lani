// text constants end

pub fn ex_same(a: List<usize>, b: List<usize>) -> bool {
    return match (a) {
        Nil -> match (b) {
            Nil -> true,
            Cons(y, more) -> false,
        },
        Cons(x, rest) -> match (b) {
            Nil -> false,
            Cons(y, more) -> (x == y) && ex_same(unbox(rest), unbox(more)),
        },
    };
}

// Whether text begins with prefix.
pub fn ex_starts(pre: List<usize>, text: List<usize>) -> bool {
    return match (pre) {
        Nil -> true,
        Cons(p, prest) -> match (text) {
            Nil -> false,
            Cons(t, trest) -> (p == t) && ex_starts(unbox(prest), unbox(trest)),
        },
    };
}

pub fn ex_drop(n: usize, items: List<usize>) -> List<usize> {
    if (n == 0) {
        return items;
    }
    return match (items) {
        Nil -> empty(),
        Cons(x, rest) -> ex_drop(minus(n, 1), unbox(rest)),
    };
}

pub fn ex_reverse(items: List<usize>, acc: List<usize>) -> List<usize> {
    return match (items) {
        Nil -> acc,
        Cons(x, rest) -> ex_reverse(unbox(rest), cons(x, acc)),
    };
}

pub fn ex_is_space(c: usize) -> bool {
    return c == 32 || c == 9 || c == 10 || c == 13 || c == 11 || c == 12;
}

// extract: inline
fn ex_trim_at(tspace: bool, twhole: List<usize>, trest: List<usize>) -> List<usize> {
    if (tspace) {
        return ex_trim_front(trest);
    }
    return twhole;
}

pub fn ex_trim_front(text: List<usize>) -> List<usize> {
    return match (text) {
        Nil -> empty(),
        Cons(c, rest) -> ex_trim_at(ex_is_space(c), text, unbox(rest)),
    };
}

// Python's str.strip on ASCII whitespace.
pub fn ex_strip(text: List<usize>) -> List<usize> {
    return ex_reverse(ex_trim_front(ex_reverse(ex_trim_front(text), empty())), empty());
}

pub fn ex_rev_texts(items: List<List<usize>>, acc: List<List<usize>>) -> List<List<usize>> {
    return match (items) {
        Nil -> acc,
        Cons(x, rest) -> ex_rev_texts(unbox(rest), cons(x, acc)),
    };
}

// The words of a text separated by single spaces.
pub fn ex_words(text: List<usize>, word: List<usize>, acc: List<List<usize>>) -> List<List<usize>> {
    return match (text) {
        Nil -> ex_rev_texts(cons(ex_reverse(word, empty()), acc), empty()),
        Cons(c, rest) -> ex_word_at(c == 32, c, unbox(rest), word, acc),
    };
}

// extract: inline
fn ex_word_at(wspace: bool, wc: usize, wrest: List<usize>, wword: List<usize>, wacc: List<List<usize>>) -> List<List<usize>> {
    if (wspace) {
        return ex_words(wrest, empty(), cons(ex_reverse(wword, empty()), wacc));
    }
    return ex_words(wrest, cons(wc, wword), wacc);
}


pub fn ex_join_rest(sep: List<usize>, parts: List<List<usize>>) -> List<usize> {
    return match (parts) {
        Nil -> empty(),
        Cons(p, rest) -> concat(sep, concat(p, ex_join_rest(sep, unbox(rest)))),
    };
}

// The texts joined with sep between them.
pub fn ex_join(sep: List<usize>, parts: List<List<usize>>) -> List<usize> {
    return match (parts) {
        Nil -> empty(),
        Cons(p, rest) -> concat(p, ex_join_rest(sep, unbox(rest))),
    };
}


// The texts one after another.
pub fn ex_flat(parts: List<List<usize>>) -> List<usize> {
    return match (parts) {
        Nil -> empty(),
        Cons(p, rest) -> concat(p, ex_flat(unbox(rest))),
    };
}

pub fn ex_has(text: List<usize>, c: usize) -> bool {
    return match (text) {
        Nil -> false,
        Cons(x, rest) -> (x == c) || ex_has(unbox(rest), c),
    };
}

pub fn ex_upper(c: usize) -> usize {
    if (c >= 97 && c <= 122) {
        return minus(c, 32);
    }
    return c;
}

pub fn ex_lower(c: usize) -> usize {
    if (c >= 65 && c <= 90) {
        return plus(c, 32);
    }
    return c;
}

pub fn ex_is_upper(c: usize) -> bool {
    return c >= 65 && c <= 90;
}

// A name with its first character in lower case (Python's lower_first).
pub fn ex_lower_first(name: List<usize>) -> List<usize> {
    return match (name) {
        Nil -> empty(),
        Cons(c, rest) -> cons(ex_lower(c), unbox(rest)),
    };
}

// extract: inline
fn ex_camel_at(cunder: bool, cc: usize, crest: List<usize>) -> List<usize> {
    if (cunder) {
        return ex_camel_upper(crest);
    }
    return cons(cc, ex_camel_rest(crest));
}

// extract: inline
fn ex_camel_upper_at(uunder: bool, uc: usize, urest: List<usize>) -> List<usize> {
    if (uunder) {
        return ex_camel_upper(urest);
    }
    return cons(ex_upper(uc), ex_camel_rest(urest));
}

// extract: mutual begin
// snake_case to camelCase: each `_` dropped and the character after it in
// upper case.
pub fn ex_camel_rest(name: List<usize>) -> List<usize> {
    return match (name) {
        Nil -> empty(),
        Cons(c, rest) -> ex_camel_at(c == 95, c, unbox(rest)),
    };
}


pub fn ex_camel_upper(name: List<usize>) -> List<usize> {
    return match (name) {
        Nil -> empty(),
        Cons(c, rest) -> ex_camel_upper_at(c == 95, c, unbox(rest)),
    };
}
// extract: mutual end


// The decimal digits of n.
pub fn ex_decimal(n: usize) -> List<usize> {
    if (n < 10) {
        return single(plus(48, n));
    }
    return concat(ex_decimal(n / 10), single(plus(48, n % 10)));
}

// ---------------------------------------------------------------- the tree

// extract: mutual begin
// The leaves of a tree in order, before acc.
pub fn ex_leaves(fuel: usize, c: CTree, acc: List<Token>) -> List<Token> {
    if (fuel == 0) {
        return acc;
    }
    return match (c) {
        Leaf(t) -> cons(t, acc),
        Node(p, kids) -> ex_leaves_in(minus(fuel, 1), unbox(kids), acc),
    };
}

pub fn ex_leaves_in(fuel: usize, kids: List<CTree>, acc: List<Token>) -> List<Token> {
    if (fuel == 0) {
        return acc;
    }
    return match (kids) {
        Nil -> acc,
        Cons(k, rest) -> ex_leaves(minus(fuel, 1), k, ex_leaves_in(minus(fuel, 1), unbox(rest), acc)),
    };
}
// extract: mutual end

pub fn ex_first_or(a: core::option::Option<Token>, b: core::option::Option<Token>) -> core::option::Option<Token> {
    return match (a) {
        None -> b,
        Some(t) -> Some(t),
    };
}

// extract: mutual begin
// The first leaf of a tree.
pub fn ex_first_leaf(fuel: usize, c: CTree) -> core::option::Option<Token> {
    if (fuel == 0) {
        return None;
    }
    return match (c) {
        Leaf(t) -> Some(t),
        Node(p, kids) -> ex_first_in(minus(fuel, 1), unbox(kids)),
    };
}

pub fn ex_first_in(fuel: usize, kids: List<CTree>) -> core::option::Option<Token> {
    if (fuel == 0) {
        return None;
    }
    return match (kids) {
        Nil -> None,
        Cons(k, rest) -> ex_first_or(ex_first_leaf(minus(fuel, 1), k), ex_first_in(minus(fuel, 1), unbox(rest))),
    };
}
// extract: mutual end


// Where a tree's first token starts.
pub fn ex_start(fuel: usize, c: CTree) -> usize {
    return match (ex_first_leaf(fuel, c)) {
        None -> 0,
        Some(t) -> t.start,
    };
}

pub fn ex_token_texts(tokens: List<Token>) -> List<usize> {
    return match (tokens) {
        Nil -> empty(),
        Cons(t, rest) -> concat(t.text, ex_token_texts(unbox(rest))),
    };
}

// The texts of a tree's leaves, one after another.
pub fn ex_spelling(fuel: usize, c: CTree) -> List<usize> {
    return ex_token_texts(ex_leaves(fuel, c, empty()));
}

pub fn ex_items(fuel: usize, c: CTree) -> List<CTree> {
    return match (list_items(fuel, c)) {
        None -> empty(),
        Some(items) -> items,
    };
}

// ---------------------------------------------------------------- comments

// The comments and `// extract:` markers between two tokens, read as
// extract.py's lexer reads them: a comment's text is stripped, a blank line
// (two newlines in a row) drops the comments before it, and a token takes the
// comments since the previous token as its doc.
pub struct XScan {
    // 0 between comments, 1 after one `/`, 2 in a comment
    mode: usize,
    // the last byte was a newline outside a comment
    newline: bool,
    // the comment so far, reversed
    body: List<usize>,
    comments: List<List<usize>>,
    markers: List<List<usize>>,
}

pub struct XGap {
    // where the token after the gap starts
    start: usize,
    comments: List<List<usize>>,
    markers: List<List<usize>>,
}

pub struct XGapEnd {
    scan: XScan,
    rest: List<usize>,
}

pub fn ex_scan_start() -> XScan {
    return XScan { mode: 0, newline: false, body: empty(), comments: empty(), markers: empty() };
}

// The scan with its comment ended.
pub fn ex_end_comment(s: XScan) -> XScan {
    let text: List<usize> = ex_strip(ex_reverse(s.body, empty()));
    if (ex_starts(tx_extract(), text)) {
        return XScan { mode: 0, newline: false, body: empty(), comments: s.comments, markers: concat(s.markers, single(ex_strip(ex_drop(8, text)))) };
    }
    return XScan { mode: 0, newline: false, body: empty(), comments: concat(s.comments, single(text)), markers: s.markers };
}

pub fn ex_scan_byte(s: XScan, c: usize) -> XScan {
    if (s.mode == 2) {
        if (c == 10) {
            let ended: XScan = ex_end_comment(s);
            return XScan { mode: 0, newline: true, body: empty(), comments: ended.comments, markers: ended.markers };
        }
        return XScan { mode: 2, newline: false, body: cons(c, s.body), comments: s.comments, markers: s.markers };
    }
    if (s.mode == 1) {
        return XScan { mode: 2, newline: false, body: empty(), comments: s.comments, markers: s.markers };
    }
    if (c == 10) {
        if (s.newline) {
            return XScan { mode: 0, newline: true, body: empty(), comments: empty(), markers: s.markers };
        }
        return XScan { mode: 0, newline: true, body: empty(), comments: s.comments, markers: s.markers };
    }
    if (c == 47) {
        return XScan { mode: 1, newline: false, body: empty(), comments: s.comments, markers: s.markers };
    }
    return XScan { mode: 0, newline: false, body: empty(), comments: s.comments, markers: s.markers };
}

// The scan of n bytes of src, and the bytes after them.
pub fn ex_scan_gap(src: List<usize>, n: usize, s: XScan) -> XGapEnd {
    if (n == 0) {
        return XGapEnd { scan: s, rest: src };
    }
    return match (src) {
        Nil -> XGapEnd { scan: s, rest: empty() },
        Cons(c, rest) -> ex_scan_gap(unbox(rest), minus(n, 1), ex_scan_byte(s, c)),
    };
}

pub fn ex_scan_end(s: XScan) -> XScan {
    if (s.mode == 2) {
        return ex_end_comment(s);
    }
    return s;
}

pub fn ex_keep_gap(g: XGap, acc: List<XGap>) -> List<XGap> {
    if (length(g.comments) == 0 && length(g.markers) == 0) {
        return acc;
    }
    return cons(g, acc);
}

// The gaps with comments or markers before each token, and at the end (at
// the source's length), reversed onto acc.
pub fn ex_gaps(src: List<usize>, pos: usize, tokens: List<Token>, acc: List<XGap>) -> List<XGap> {
    return match (tokens) {
        Nil -> ex_gaps_last(ex_scan_end(ex_scan_gap(src, length(src), ex_scan_start()).scan), plus(pos, length(src)), acc),
        Cons(t, rest) -> ex_gaps_at(ex_scan_gap(src, minus(t.start, pos), ex_scan_start()), t, unbox(rest), acc),
    };
}

// extract: inline
fn ex_gaps_last(lscan: XScan, lat: usize, lacc: List<XGap>) -> List<XGap> {
    return ex_keep_gap(XGap { start: lat, comments: lscan.comments, markers: lscan.markers }, lacc);
}

// extract: inline
fn ex_gaps_at(gend: XGapEnd, gtok: Token, grest: List<Token>, gacc: List<XGap>) -> List<XGap> {
    let gscan: XScan = ex_scan_end(gend.scan);
    return ex_gaps(ex_drop(length(gtok.text), gend.rest), plus(gtok.start, length(gtok.text)), grest,
        ex_keep_gap(XGap { start: gtok.start, comments: gscan.comments, markers: gscan.markers }, gacc));
}

pub fn ex_gap_at(gaps: List<XGap>, here: usize) -> XGap {
    return match (gaps) {
        Nil -> XGap { start: here, comments: empty(), markers: empty() },
        Cons(g, rest) -> ex_gap_or(g.start == here, g, unbox(rest), here),
    };
}

// extract: inline
fn ex_gap_or(ghit: bool, gg: XGap, grest: List<XGap>, gat: usize) -> XGap {
    if (ghit) {
        return gg;
    }
    return ex_gap_at(grest, gat);
}

pub fn ex_rev_gaps(items: List<XGap>, acc: List<XGap>) -> List<XGap> {
    return match (items) {
        Nil -> acc,
        Cons(x, rest) -> ex_rev_gaps(unbox(rest), cons(x, acc)),
    };
}

// ---------------------------------------------------------------- types

// A type as extract.py reads it: a name (a path joined with `::`, Option for
// core::option::Option, `&mut` for a reference) and its arguments, or a type
// outside the subset.
pub enum XTy {
    XT(List<usize>, Box<List<XTy>>),
    XBad(List<usize>),
}

pub fn ex_ty(name: List<usize>) -> XTy {
    return XT(name, boxed(empty()));
}

pub fn ex_ty_name(t: XTy) -> List<usize> {
    return match (t) {
        XT(name, args) -> name,
        XBad(why) -> empty(),
    };
}

pub fn ex_ty_args(t: XTy) -> List<XTy> {
    return match (t) {
        XT(name, args) -> unbox(args),
        XBad(why) -> empty(),
    };
}

pub fn ex_ty_arg(t: XTy) -> XTy {
    return get_or(ex_ty_args(t), 0, XBad(tx_err_type()));
}

pub fn ex_is_named(t: XTy, name: List<usize>) -> bool {
    return ex_same(ex_ty_name(t), name);
}

// T for `&mut T`.
pub fn ex_value(t: XTy) -> XTy {
    if (ex_is_named(t, tx_mut_ref())) {
        return ex_ty_arg(t);
    }
    return t;
}

pub fn ex_strip_box(fuel: usize, t: XTy) -> XTy {
    if (fuel == 0) {
        return t;
    }
    if (ex_is_named(t, tx_box())) {
        return ex_strip_box(minus(fuel, 1), ex_ty_arg(t));
    }
    return t;
}

// extract: mutual begin
pub fn ex_ty_eq(fuel: usize, a: XTy, b: XTy) -> bool {
    if (fuel == 0) {
        return false;
    }
    return match (a) {
        XT(an, aargs) -> match (b) {
            XT(bn, bargs) -> ex_same(an, bn) && ex_tys_eq(minus(fuel, 1), unbox(aargs), unbox(bargs)),
            XBad(bwhy) -> false,
        },
        XBad(awhy) -> false,
    };
}

pub fn ex_tys_eq(fuel: usize, a: List<XTy>, b: List<XTy>) -> bool {
    if (fuel == 0) {
        return false;
    }
    return match (a) {
        Nil -> match (b) {
            Nil -> true,
            Cons(y, more) -> false,
        },
        Cons(x, rest) -> match (b) {
            Nil -> false,
            Cons(y, more) -> ex_ty_eq(minus(fuel, 1), x, y) && ex_tys_eq(minus(fuel, 1), unbox(rest), unbox(more)),
        },
    };
}
// extract: mutual end

// extract: mutual begin
// The Lean type (extract.py's lean_type).
pub fn ex_lean_type(fuel: usize, ty: XTy) -> List<usize> {
    if (fuel == 0) {
        return empty();
    }
    let t: XTy = ex_strip_box(fuel, ex_value(ty));
    let name: List<usize> = ex_ty_name(t);
    if (ex_same(name, tx_usize())) {
        return tx_lean_nat();
    }
    if (ex_same(name, tx_i32()) || ex_same(name, tx_u32())) {
        return tx_lean_bv32();
    }
    if (ex_same(name, tx_u64())) {
        return tx_lean_bv64();
    }
    if (ex_same(name, tx_u8())) {
        return tx_lean_uint8();
    }
    if (ex_same(name, tx_bool())) {
        return tx_lean_bool();
    }
    if (ex_same(name, tx_list())) {
        return concat(tx_lean_list(), ex_atom_type(minus(fuel, 1), ex_ty_arg(t)));
    }
    if (ex_same(name, tx_option())) {
        return concat(tx_lean_option(), ex_atom_type(minus(fuel, 1), ex_ty_arg(t)));
    }
    return name;
}

pub fn ex_atom_type(fuel: usize, t: XTy) -> List<usize> {
    if (fuel == 0) {
        return tx_err_fuel();
    }
    let s: List<usize> = ex_lean_type(minus(fuel, 1), t);
    if (ex_has(s, 32)) {
        return concat(single(40), concat(s, single(41)));
    }
    return s;
}
// extract: mutual end

// extract: mutual begin
pub fn ex_type_path(name: List<usize>) -> List<usize> {
    if (ex_same(name, tx_option_path())) {
        return tx_option();
    }
    return name;
}

// A type_expr node.
pub fn ex_read_ty(fuel: usize, c: CTree) -> XTy {
    if (fuel == 0) {
        return XBad(tx_err_tree());
    }
    let p: usize = node_prod(c);
    if (p == xp_type_ref_mut()) {
        return XT(tx_mut_ref(), boxed(single(ex_read_ty(minus(fuel, 1), kid(c, 2)))));
    }
    if (p == xp_type_ident()) {
        let spelled: List<usize> = ex_spelling(fuel, kid(c, 0));
        let name: List<usize> = ex_type_path(spelled);
        if (ex_has(name, 58)) {
            return XBad(tx_err_type());
        }
        return XT(name, boxed(ex_read_ty_args(minus(fuel, 1), ex_items(fuel, kid(c, 1)))));
    }
    return XBad(tx_err_type());
}

// The generic_argument nodes of a type argument list.
pub fn ex_read_ty_args(fuel: usize, args: List<CTree>) -> List<XTy> {
    if (fuel == 0) {
        return empty();
    }
    return match (args) {
        Nil -> empty(),
        Cons(a, rest) -> cons(ex_read_ty_arg(minus(fuel, 1), a), ex_read_ty_args(minus(fuel, 1), unbox(rest))),
    };
}

pub fn ex_read_ty_arg(fuel: usize, a: CTree) -> XTy {
    if (fuel == 0) {
        return XBad(tx_err_tree());
    }
    if (node_prod(a) == xp_generic_argument_type()) {
        return ex_read_ty(minus(fuel, 1), kid(a, 0));
    }
    return XBad(tx_err_type());
}
// extract: mutual end

pub fn ex_read_tys(fuel: usize, cs: List<CTree>) -> List<XTy> {
    return match (cs) {
        Nil -> empty(),
        Cons(c, rest) -> cons(ex_read_ty(fuel, c), ex_read_tys(fuel, unbox(rest))),
    };
}


// ---------------------------------------------------------------- statements and expressions

// A function body as extract.py reads it: expressions, match arms, blocks and
// statements in one type (extract.py writes no Lean `mutual` types).
pub enum XE {
    EInt(usize),
    EBool(bool),
    EName(List<List<usize>>),
    ECall(List<List<usize>>, Box<List<XE>>),
    // receiver, method, arguments
    EMethod(Box<XE>, List<usize>, Box<List<XE>>),
    EField(Box<XE>, List<usize>),
    // struct, field names, values
    EStruct(List<usize>, List<List<usize>>, Box<List<XE>>),
    EBinary(List<usize>, Box<XE>, Box<XE>),
    ENot(Box<XE>),
    ECast(Box<XE>, XTy),
    // scrutinee, arms
    EMatch(Box<XE>, Box<List<XE>>),
    // constructor path, binders, body (an expression or a block)
    EArm(List<List<usize>>, List<List<usize>>, Box<XE>),
    SBlock(Box<List<XE>>),
    SLet(List<usize>, XTy, Box<XE>),
    SAssign(Box<XE>, Box<XE>),
    SCall(Box<XE>),
    SMatch(Box<XE>),
    // no value or one
    SReturn(Box<List<XE>>),
    // condition, then, else (empty without one), whether there is an else
    SIf(Box<XE>, Box<List<XE>>, Box<List<XE>>, bool),
    EBad(List<usize>),
}

pub struct XParam {
    name: List<usize>,
    ty: XTy,
}

pub struct XFn {
    name: List<usize>,
    tparams: List<List<usize>>,
    params: List<XParam>,
    // the result type, none for a unit function
    ret: List<XTy>,
    body: List<XE>,
    // an impl method's type
    self_type: List<XTy>,
    doc: List<List<usize>>,
    inline: bool,
}

// text err_stmt "statement not in the extracted subset"
// text err_expr "expression not in the extracted subset"
// text err_fn "function form not in the extracted subset"
// text err_impl "impl form not in the extracted subset"
// text err_pattern "pattern not in the extracted subset"
// text op_or "||"
// text op_and "&&"
// text op_bor "|"
// text op_xor "^"
// text op_band "&"
// text op_eq "=="
// text op_ne "!="
// text op_lt "<"
// text op_gt ">"
// text op_le "<="
// text op_ge ">="
// text op_shl "<<"
// text op_shr ">>"
// text op_plus "+"
// text op_minus "-"
// text op_times "*"
// text op_div "/"
// text op_mod "%"
// text self "self"

pub fn ex_digit_value(text: List<usize>, acc: usize) -> core::option::Option<usize> {
    return match (text) {
        Nil -> Some(acc),
        Cons(c, rest) -> ex_digit_at(c >= 48 && c <= 57, c, unbox(rest), acc),
    };
}

// extract: inline
fn ex_digit_at(dok: bool, dc: usize, drest: List<usize>, dacc: usize) -> core::option::Option<usize> {
    if (dok) {
        return ex_digit_value(drest, plus(times(dacc, 10), minus(dc, 48)));
    }
    return None;
}

pub fn ex_path_tail(fuel: usize, c: CTree) -> List<List<usize>> {
    if (fuel == 0) {
        return empty();
    }
    if (node_prod(c) == xp_path_more()) {
        return cons(kid_token(kid(c, 2), 0).text, ex_path_tail(minus(fuel, 1), kid(c, 3)));
    }
    return empty();
}

// The segments of a path node (Ident leaves; a segment with type arguments
// is outside the subset).
pub fn ex_path_names(fuel: usize, c: CTree) -> List<List<usize>> {
    if (fuel == 0) {
        return empty();
    }
    return cons(kid_token(kid(c, 0), 0).text, ex_path_tail(minus(fuel, 1), kid(c, 1)));
}

pub fn ex_path_plain_tail(fuel: usize, c: CTree) -> bool {
    if (fuel == 0) {
        return false;
    }
    if (node_prod(kid(c, 2)) != xp_path_ident()) {
        return false;
    }
    if (node_prod(kid(c, 3)) == xp_path_more()) {
        return ex_path_plain_tail(minus(fuel, 1), kid(c, 3));
    }
    return true;
}

pub fn ex_path_plain(fuel: usize, c: CTree) -> bool {
    if (fuel == 0) {
        return false;
    }
    if (node_prod(kid(c, 0)) != xp_path_ident()) {
        return false;
    }
    if (node_prod(kid(c, 1)) == xp_path_more()) {
        return ex_path_plain_tail(minus(fuel, 1), kid(c, 1));
    }
    return true;
}

// The binary operator of a tail production (empty if it is none).
pub fn ex_tail_op(p: usize) -> List<usize> {
    if (p == xp_or_tail()) {
        return tx_op_or();
    }
    if (p == xp_and_tail()) {
        return tx_op_and();
    }
    if (p == xp_bor_tail()) {
        return tx_op_bor();
    }
    if (p == xp_xor_tail()) {
        return tx_op_xor();
    }
    if (p == xp_band_tail()) {
        return tx_op_band();
    }
    if (p == xp_eq_tail()) {
        return tx_op_eq();
    }
    if (p == xp_ne_tail()) {
        return tx_op_ne();
    }
    if (p == xp_lt_tail()) {
        return tx_op_lt();
    }
    if (p == xp_gt_tail()) {
        return tx_op_gt();
    }
    if (p == xp_le_tail()) {
        return tx_op_le();
    }
    if (p == xp_ge_tail()) {
        return tx_op_ge();
    }
    if (p == xp_shl_tail()) {
        return tx_op_shl();
    }
    if (p == xp_shr_tail()) {
        return tx_op_shr();
    }
    if (p == xp_add_tail()) {
        return tx_op_plus();
    }
    if (p == xp_sub_tail()) {
        return tx_op_minus();
    }
    if (p == xp_mul_tail()) {
        return tx_op_times();
    }
    if (p == xp_div_tail()) {
        return tx_op_div();
    }
    if (p == xp_mod_tail()) {
        return tx_op_mod();
    }
    return empty();
}

// Whether a node is one level of the binary operator chain (orexpr, andexpr,
// ..., mul): an operand and a tail.
pub fn ex_is_level(p: usize) -> bool {
    return p == xp_orexpr() || p == xp_andexpr() || p == xp_bit_or() || p == xp_bit_xor() || p == xp_bit_and()
        || p == xp_equality() || p == xp_compare() || p == xp_shift() || p == xp_add() || p == xp_mul();
}

// A call: of a path (a function or constructor), or of a field (a method).
pub fn ex_applied(e: XE, args: List<XE>) -> XE {
    return match (e) {
        EInt(n) -> EBad(tx_err_expr()),
        EBool(b) -> EBad(tx_err_expr()),
        EName(path) -> ECall(path, boxed(args)),
        ECall(path, a) -> EBad(tx_err_expr()),
        EMethod(recv, name, a) -> EBad(tx_err_expr()),
        EField(recv, name) -> EMethod(recv, name, boxed(args)),
        EStruct(name, names, values) -> EBad(tx_err_expr()),
        EBinary(op, l, r) -> EBad(tx_err_expr()),
        ENot(x) -> EBad(tx_err_expr()),
        ECast(x, t) -> EBad(tx_err_expr()),
        EMatch(x, arms) -> EBad(tx_err_expr()),
        EArm(path, binders, body) -> EBad(tx_err_expr()),
        SBlock(stmts) -> EBad(tx_err_expr()),
        SLet(name, t, v) -> EBad(tx_err_expr()),
        SAssign(place, v) -> EBad(tx_err_expr()),
        SCall(x) -> EBad(tx_err_expr()),
        SMatch(x) -> EBad(tx_err_expr()),
        SReturn(v) -> EBad(tx_err_expr()),
        SIf(c, a, b, has) -> EBad(tx_err_expr()),
        EBad(why) -> e,
    };
}

pub fn ex_expr_stmt(e: XE) -> XE {
    return match (e) {
        EInt(n) -> EBad(tx_err_stmt()),
        EBool(b) -> EBad(tx_err_stmt()),
        EName(path) -> EBad(tx_err_stmt()),
        ECall(path, args) -> SCall(boxed(e)),
        EMethod(recv, name, args) -> SCall(boxed(e)),
        EField(recv, name) -> EBad(tx_err_stmt()),
        EStruct(name, names, values) -> EBad(tx_err_stmt()),
        EBinary(op, l, r) -> EBad(tx_err_stmt()),
        ENot(x) -> EBad(tx_err_stmt()),
        ECast(x, t) -> EBad(tx_err_stmt()),
        EMatch(x, arms) -> SMatch(boxed(e)),
        EArm(path, binders, body) -> EBad(tx_err_stmt()),
        SBlock(stmts) -> EBad(tx_err_stmt()),
        SLet(name, t, v) -> EBad(tx_err_stmt()),
        SAssign(place, v) -> EBad(tx_err_stmt()),
        SCall(x) -> EBad(tx_err_stmt()),
        SMatch(x) -> EBad(tx_err_stmt()),
        SReturn(v) -> EBad(tx_err_stmt()),
        SIf(c, a, b, has) -> EBad(tx_err_stmt()),
        EBad(why) -> e,
    };
}

pub fn ex_lit_names(fields: List<CTree>) -> List<List<usize>> {
    return match (fields) {
        Nil -> empty(),
        Cons(f, rest) -> cons(kid_token(f, 0).text, ex_lit_names(unbox(rest))),
    };
}

pub fn ex_binder_names(fuel: usize, pats: List<CTree>) -> List<List<usize>> {
    return match (pats) {
        Nil -> empty(),
        Cons(b, rest) -> cons(kid_token(kid(kid(b, 0), 0), 0).text, ex_binder_names(fuel, unbox(rest))),
    };
}

pub fn ex_plain_binders(fuel: usize, pats: List<CTree>) -> bool {
    return match (pats) {
        Nil -> true,
        Cons(b, rest) -> node_prod(b) == xp_pattern_ident() && node_prod(kid(b, 1)) == xp_pattern_plain()
            && node_prod(kid(kid(b, 0), 1)) == xp_path_end() && node_prod(kid(kid(b, 0), 0)) == xp_path_ident()
            && ex_plain_binders(fuel, unbox(rest)),
    };
}

// extract: mutual begin
pub fn ex_read_expr(fuel: usize, c: CTree) -> XE {
    if (fuel == 0) {
        return EBad(tx_err_tree());
    }
    let p: usize = node_prod(c);
    if (p == xp_expr()) {
        return ex_read_expr(minus(fuel, 1), kid(c, 0));
    }
    if (p == xp_assign()) {
        if (node_prod(kid(c, 1)) == xp_assign_end()) {
            return ex_read_expr(minus(fuel, 1), kid(c, 0));
        }
        return EBad(tx_err_expr());
    }
    if (ex_is_level(p)) {
        return ex_read_tail(minus(fuel, 1), ex_read_expr(minus(fuel, 1), kid(c, 0)), kid(c, 1));
    }
    if (p == xp_cast()) {
        return ex_read_casts(minus(fuel, 1), ex_read_expr(minus(fuel, 1), kid(c, 0)), kid(c, 1));
    }
    if (p == xp_not()) {
        return ENot(boxed(ex_read_expr(minus(fuel, 1), kid(c, 1))));
    }
    if (p == xp_base()) {
        return ex_read_expr(minus(fuel, 1), kid(c, 0));
    }
    if (p == xp_postfix()) {
        return ex_read_postfix(minus(fuel, 1), ex_read_expr(minus(fuel, 1), kid(c, 0)), kid(c, 1));
    }
    if (p == xp_int()) {
        return match (ex_digit_value(kid_token(c, 0).text, 0)) {
            None -> EBad(tx_err_expr()),
            Some(n) -> EInt(n),
        };
    }
    if (p == xp_true()) {
        return EBool(true);
    }
    if (p == xp_false()) {
        return EBool(false);
    }
    if (p == xp_group()) {
        return ex_read_expr(minus(fuel, 1), kid(c, 1));
    }
    if (p == xp_self_value()) {
        return EName(single(tx_self()));
    }
    if (p == xp_ident()) {
        return ex_read_ident(minus(fuel, 1), kid(c, 0), kid(c, 1));
    }
    if (p == xp_match_expr()) {
        return EMatch(boxed(ex_read_expr(minus(fuel, 1), kid(c, 2))), boxed(ex_read_arms(minus(fuel, 1), ex_items(fuel, kid(c, 5)))));
    }
    if (p == xp_arm_block()) {
        return SBlock(boxed(ex_read_stmts(minus(fuel, 1), ex_items(fuel, kid(c, 0)))));
    }
    return EBad(tx_err_expr());
}

// left, then each operator and operand of a tail, left to right.
pub fn ex_read_tail(fuel: usize, left: XE, tail: CTree) -> XE {
    if (fuel == 0) {
        return EBad(tx_err_tree());
    }
    let op: List<usize> = ex_tail_op(node_prod(tail));
    if (length(op) == 0) {
        return left;
    }
    return ex_read_tail(minus(fuel, 1), EBinary(op, boxed(left), boxed(ex_read_expr(minus(fuel, 1), kid(tail, 1)))), kid(tail, 2));
}

pub fn ex_read_casts(fuel: usize, inner: XE, tail: CTree) -> XE {
    if (fuel == 0) {
        return EBad(tx_err_tree());
    }
    if (node_prod(tail) == xp_cast_tail()) {
        let target: XTy = ex_ty(ex_type_path(ex_spelling(fuel, kid(tail, 1))));
        return ex_read_casts(minus(fuel, 1), ECast(boxed(inner), target), kid(tail, 2));
    }
    return inner;
}

pub fn ex_read_postfix(fuel: usize, e: XE, tail: CTree) -> XE {
    if (fuel == 0) {
        return EBad(tx_err_tree());
    }
    let p: usize = node_prod(tail);
    if (p == xp_postfix_end()) {
        return e;
    }
    if (p == xp_postfix_member() && node_prod(kid(tail, 2)) == xp_member_type_args_none()) {
        return ex_read_postfix(minus(fuel, 1), EField(boxed(e), kid_token(tail, 1).text), kid(tail, 3));
    }
    if (p == xp_postfix_call()) {
        let args: List<XE> = ex_read_exprs(minus(fuel, 1), ex_items(fuel, kid(tail, 1)));
        return ex_read_postfix(minus(fuel, 1), ex_applied(e, args), kid(tail, 3));
    }
    return EBad(tx_err_expr());
}

pub fn ex_read_exprs(fuel: usize, cs: List<CTree>) -> List<XE> {
    if (fuel == 0) {
        return empty();
    }
    return match (cs) {
        Nil -> empty(),
        Cons(c, rest) -> cons(ex_read_expr(minus(fuel, 1), c), ex_read_exprs(minus(fuel, 1), unbox(rest))),
    };
}

pub fn ex_read_ident(fuel: usize, path: CTree, tail: CTree) -> XE {
    if (fuel == 0) {
        return EBad(tx_err_tree());
    }
    if (!ex_path_plain(fuel, path)) {
        return EBad(tx_err_expr());
    }
    let names: List<List<usize>> = ex_path_names(fuel, path);
    if (node_prod(tail) == xp_ident_plain()) {
        return EName(names);
    }
    let first: List<usize> = get_or(names, 0, empty());
    if (node_prod(tail) == xp_struct_lit() && length(names) == 1 && ex_is_upper(get_or(first, 0, 0))) {
        let fields: List<CTree> = ex_items(fuel, kid(tail, 1));
        return EStruct(first, ex_lit_names(fields), boxed(ex_lit_values(minus(fuel, 1), fields)));
    }
    return EBad(tx_err_expr());
}

pub fn ex_lit_values(fuel: usize, fields: List<CTree>) -> List<XE> {
    if (fuel == 0) {
        return empty();
    }
    return match (fields) {
        Nil -> empty(),
        Cons(f, rest) -> cons(ex_read_expr(minus(fuel, 1), kid(f, 2)), ex_lit_values(minus(fuel, 1), unbox(rest))),
    };
}

pub fn ex_read_arms(fuel: usize, arms: List<CTree>) -> List<XE> {
    if (fuel == 0) {
        return empty();
    }
    return match (arms) {
        Nil -> empty(),
        Cons(a, rest) -> cons(ex_read_arm(minus(fuel, 1), a), ex_read_arms(minus(fuel, 1), unbox(rest))),
    };
}

pub fn ex_read_arm(fuel: usize, a: CTree) -> XE {
    if (fuel == 0) {
        return EBad(tx_err_tree());
    }
    let pat: CTree = kid(a, 0);
    if (node_prod(pat) != xp_pattern_ident() || !ex_path_plain(fuel, kid(pat, 0))) {
        return EBad(tx_err_pattern());
    }
    let body: XE = ex_read_expr(minus(fuel, 1), kid(a, 2));
    let tail: CTree = kid(pat, 1);
    if (node_prod(tail) == xp_pattern_plain()) {
        return EArm(ex_path_names(fuel, kid(pat, 0)), empty(), boxed(body));
    }
    let binders: List<CTree> = ex_items(fuel, kid(tail, 1));
    if (!ex_plain_binders(fuel, binders)) {
        return EBad(tx_err_pattern());
    }
    return EArm(ex_path_names(fuel, kid(pat, 0)), ex_binder_names(fuel, binders), boxed(body));
}

pub fn ex_read_stmts(fuel: usize, cs: List<CTree>) -> List<XE> {
    if (fuel == 0) {
        return empty();
    }
    return match (cs) {
        Nil -> empty(),
        Cons(c, rest) -> cons(ex_read_stmt(minus(fuel, 1), c), ex_read_stmts(minus(fuel, 1), unbox(rest))),
    };
}

pub fn ex_read_stmt(fuel: usize, c: CTree) -> XE {
    if (fuel == 0) {
        return EBad(tx_err_tree());
    }
    let p: usize = node_prod(c);
    if (p == xp_let_stmt()) {
        let ty: CTree = kid(c, 2);
        let init: CTree = kid(c, 3);
        if (node_prod(ty) == xp_let_type() && node_prod(init) == xp_let_init()) {
            return SLet(kid_token(c, 1).text, ex_read_ty(fuel, kid(ty, 1)), boxed(ex_read_expr(minus(fuel, 1), kid(init, 1))));
        }
        return EBad(tx_err_stmt());
    }
    if (p == xp_return_stmt()) {
        let value: CTree = kid(c, 1);
        if (node_prod(value) == xp_return_value()) {
            return SReturn(boxed(single(ex_read_expr(minus(fuel, 1), kid(value, 0)))));
        }
        return SReturn(boxed(empty()));
    }
    if (p == xp_if_stmt()) {
        let cond: XE = ex_read_expr(minus(fuel, 1), kid(c, 2));
        let yes: List<XE> = ex_read_stmts(minus(fuel, 1), ex_items(fuel, kid(c, 4)));
        let other: CTree = kid(c, 5);
        if (node_prod(other) == xp_else_stmt()) {
            return SIf(boxed(cond), boxed(yes), boxed(ex_read_stmts(minus(fuel, 1), ex_items(fuel, kid(other, 1)))), true);
        }
        return SIf(boxed(cond), boxed(yes), boxed(empty()), false);
    }
    if (p == xp_expr_stmt()) {
        return ex_read_expr_stmt(minus(fuel, 1), kid(kid(c, 0), 0));
    }
    return EBad(tx_err_stmt());
}

// An expression statement's assign node: `x = e;`, `x += e;`, `x -= e;`, or
// a call or match.
pub fn ex_read_expr_stmt(fuel: usize, c: CTree) -> XE {
    if (fuel == 0) {
        return EBad(tx_err_tree());
    }
    let left: XE = ex_read_expr(minus(fuel, 1), kid(c, 0));
    let tail: CTree = kid(c, 1);
    let tp: usize = node_prod(tail);
    if (tp == xp_assign_set()) {
        return SAssign(boxed(left), boxed(ex_read_expr(minus(fuel, 1), kid(tail, 1))));
    }
    if (tp == xp_assign_add()) {
        return SAssign(boxed(left), boxed(EBinary(tx_op_plus(), boxed(left), boxed(ex_read_expr(minus(fuel, 1), kid(tail, 1))))));
    }
    if (tp == xp_assign_sub()) {
        return SAssign(boxed(left), boxed(EBinary(tx_op_minus(), boxed(left), boxed(ex_read_expr(minus(fuel, 1), kid(tail, 1))))));
    }
    if (tp == xp_assign_end()) {
        return ex_expr_stmt(left);
    }
    return EBad(tx_err_stmt());
}
// extract: mutual end

// ---------------------------------------------------------------- functions

pub fn ex_read_param(fuel: usize, p: CTree, self_type: List<XTy>) -> XParam {
    let pp: usize = node_prod(p);
    if (pp == xp_param_named()) {
        return XParam { name: kid_token(p, 0).text, ty: ex_read_ty(fuel, kid(p, 2)) };
    }
    if (pp == xp_param_self() && node_prod(kid(p, 1)) == xp_self_param_plain() && length(self_type) == 1) {
        return XParam { name: tx_self(), ty: get_or(self_type, 0, XBad(tx_err_fn())) };
    }
    if (pp == xp_param_self_ref_mut() && length(self_type) == 1) {
        return XParam { name: tx_self(), ty: XT(tx_mut_ref(), boxed(self_type)) };
    }
    return XParam { name: tx_self(), ty: XBad(tx_err_fn()) };
}

pub fn ex_read_params(fuel: usize, params: List<CTree>, self_type: List<XTy>) -> List<XParam> {
    return match (params) {
        Nil -> empty(),
        Cons(p, rest) -> cons(ex_read_param(fuel, p, self_type), ex_read_params(fuel, unbox(rest), self_type)),
    };
}

// The parameter names of an enum_type_params_opt node.
pub fn ex_read_tparams(fuel: usize, params: List<CTree>) -> List<List<usize>> {
    return match (params) {
        Nil -> empty(),
        Cons(p, rest) -> cons(kid_token(p, 0).text, ex_read_tparams(fuel, unbox(rest))),
    };
}

pub fn ex_read_ret(fuel: usize, ret: CTree) -> List<XTy> {
    if (node_prod(ret) == xp_ret_type()) {
        return single(ex_read_ty(fuel, kid(ret, 1)));
    }
    return empty();
}

// A fn or impl_fn node; an impl method has its impl's type.
pub fn ex_read_fn(fuel: usize, c: CTree, self_type: List<XTy>, doc: List<List<usize>>, inline: bool) -> XFn {
    let ret: CTree = kid(c, 6);
    let rets: List<XTy> = ex_read_ret(fuel, ret);
    let plain: bool = node_prod(kid(c, 7)) == xp_where_none() && node_prod(kid(c, 8)) == xp_contracts_none();
    let body: List<XE> = ex_read_stmts(fuel, ex_items(fuel, kid(c, 9)));
    if (plain) {
        return XFn { name: kid_token(c, 1).text, tparams: ex_read_tparams(fuel, ex_items(fuel, kid(c, 2))),
            params: ex_read_params(fuel, ex_items(fuel, kid(c, 4)), self_type), ret: rets, body: body, self_type: self_type, doc: doc, inline: inline };
    }
    return XFn { name: kid_token(c, 1).text, tparams: empty(), params: empty(), ret: rets, body: single(EBad(tx_err_fn())), self_type: self_type, doc: doc, inline: inline };
}

pub fn ex_method_fn(m: CTree) -> CTree {
    if (node_prod(m) == xp_impl_method_pub()) {
        return kid(m, 1);
    }
    return kid(m, 0);
}

pub fn ex_read_methods(fuel: usize, gaps: List<XGap>, methods: List<CTree>, self_type: XTy) -> List<XFn> {
    return match (methods) {
        Nil -> empty(),
        Cons(m, rest) -> cons(ex_read_fn(fuel, ex_method_fn(m), single(self_type), ex_gap_at(gaps, ex_start(fuel, m)).comments, false),
            ex_read_methods(fuel, gaps, unbox(rest), self_type)),
    };
}

pub fn ex_read_impl(fuel: usize, gaps: List<XGap>, c: CTree) -> XItem {
    let ty: XTy = ex_read_ty(fuel, kid(c, 2));
    if (node_prod(kid(c, 1)) != xp_enum_type_params_none() || node_prod(kid(c, 3)) != xp_where_none() || length(ex_ty_args(ty)) != 0) {
        return IBad(tx_err_impl());
    }
    return IImpl(ex_ty_name(ty), ex_read_methods(fuel, gaps, ex_items(fuel, kid(c, 5)), ty));
}

// ---------------------------------------------------------------- items

pub struct XField {
    name: List<usize>,
    ty: XTy,
    doc: List<List<usize>>,
}

pub struct XCtor {
    name: List<usize>,
    payload: List<XTy>,
    doc: List<List<usize>>,
}

pub enum XItem {
    // name, type parameters, fields
    IStruct(List<usize>, List<List<usize>>, List<XField>),
    // name, type parameters, constructors
    IEnum(List<usize>, List<List<usize>>, List<XCtor>),
    IFn(XFn),
    // the type's name and its methods
    IImpl(List<usize>, List<XFn>),
    // `// extract: mutual begin` (true) or `end`, and whether the block is
    // `mutual begin fuel`
    IMutual(bool, bool),
    // `// extract: external begin MODULE from PATH`
    IExternal(List<usize>, List<usize>),
    // `// extract: prelude end`
    IPreludeEnd,
    IBad(List<usize>),
}

// An item with its doc comment and the markers in force: inline, in the
// prelude, and the module of the external section it is in (empty if none).
pub struct XAt {
    item: XItem,
    doc: List<List<usize>>,
    inline: bool,
    prelude: bool,
    external: List<usize>,
}

// The markers in force, and the items so far, reversed.
pub struct XMarks {
    inline: bool,
    prelude: bool,
    external: List<usize>,
    acc: List<XAt>,
}

pub fn ex_marker_item(st: XMarks, item: XItem) -> XMarks {
    return XMarks { inline: st.inline, prelude: st.prelude, external: st.external,
        acc: cons(XAt { item: item, doc: empty(), inline: false, prelude: st.prelude, external: st.external }, st.acc) };
}

pub fn ex_marker(st: XMarks, text: List<usize>) -> XMarks {
    let words: List<List<usize>> = ex_words(text, empty(), empty());
    let w0: List<usize> = get_or(words, 0, empty());
    let w1: List<usize> = get_or(words, 1, empty());
    let n: usize = length(words);
    if (n == 5 && ex_same(w0, tx_external()) && ex_same(w1, tx_begin()) && ex_same(get_or(words, 3, empty()), tx_from())) {
        if (st.prelude || length(st.external) != 0) {
            return ex_marker_item(st, IBad(tx_err_nest()));
        }
        let modname: List<usize> = get_or(words, 2, empty());
        let moved: XMarks = ex_marker_item(st, IExternal(modname, get_or(words, 4, empty())));
        return XMarks { inline: moved.inline, prelude: moved.prelude, external: modname, acc: moved.acc };
    }
    if (n == 2 && ex_same(w0, tx_external()) && ex_same(w1, tx_end())) {
        if (length(st.external) == 0) {
            return ex_marker_item(st, IBad(tx_err_ext_end()));
        }
        return XMarks { inline: st.inline, prelude: st.prelude, external: empty(), acc: st.acc };
    }
    if (n == 2 && ex_same(w0, tx_prelude()) && ex_same(w1, tx_begin())) {
        return XMarks { inline: st.inline, prelude: true, external: st.external, acc: st.acc };
    }
    if (n == 2 && ex_same(w0, tx_prelude()) && ex_same(w1, tx_end())) {
        let ended: XMarks = ex_marker_item(st, IPreludeEnd);
        return XMarks { inline: ended.inline, prelude: false, external: ended.external, acc: ended.acc };
    }
    if (n == 1 && ex_same(w0, tx_inline())) {
        return XMarks { inline: true, prelude: st.prelude, external: st.external, acc: st.acc };
    }
    if (n == 2 && ex_same(w0, tx_mutual()) && (ex_same(w1, tx_begin()) || ex_same(w1, tx_end()))) {
        if (st.prelude) {
            return ex_marker_item(st, IBad(tx_err_mutual_prelude()));
        }
        return ex_marker_item(st, IMutual(ex_same(w1, tx_begin()), false));
    }
    if (n == 3 && ex_same(w0, tx_mutual()) && ex_same(w1, tx_begin()) && ex_same(get_or(words, 2, empty()), tx_fuel())) {
        if (st.prelude) {
            return ex_marker_item(st, IBad(tx_err_mutual_prelude()));
        }
        return ex_marker_item(st, IMutual(true, true));
    }
    return ex_marker_item(st, IBad(tx_err_marker()));
}

pub fn ex_markers(st: XMarks, markers: List<List<usize>>) -> XMarks {
    return match (markers) {
        Nil -> st,
        Cons(m, rest) -> ex_markers(ex_marker(st, m), unbox(rest)),
    };
}

// The item node inside an item: fn_item, struct_item, enum_item, impl_item,
// ... (None for module and import lines).
pub fn ex_item_node(c: CTree) -> core::option::Option<CTree> {
    let p: usize = node_prod(c);
    if (p == xp_item_import() || p == xp_item_module()) {
        return None;
    }
    if (p == xp_item_pub()) {
        return Some(kid(kid(c, 1), 0));
    }
    return Some(kid(c, 0));
}

pub fn ex_read_fields(fuel: usize, gaps: List<XGap>, fields: List<CTree>) -> List<XField> {
    return match (fields) {
        Nil -> empty(),
        Cons(f, rest) -> cons(XField { name: kid_token(f, 0).text, ty: ex_read_ty(fuel, kid(f, 2)), doc: ex_gap_at(gaps, kid_token(f, 0).start).comments },
            ex_read_fields(fuel, gaps, unbox(rest))),
    };
}

pub fn ex_read_ctors(fuel: usize, gaps: List<XGap>, ctors: List<CTree>) -> List<XCtor> {
    return match (ctors) {
        Nil -> empty(),
        Cons(v, rest) -> cons(XCtor { name: kid_token(v, 0).text, payload: ex_read_tys(fuel, ex_items(fuel, kid(kid(v, 1), 1))), doc: ex_gap_at(gaps, kid_token(v, 0).start).comments },
            ex_read_ctors(fuel, gaps, unbox(rest))),
    };
}

pub fn ex_read_item(fuel: usize, gaps: List<XGap>, c: CTree, inline: bool, doc: List<List<usize>>) -> XItem {
    let p: usize = node_prod(c);
    if (p == xp_struct() && node_prod(kid(c, 3)) == xp_where_none()) {
        return IStruct(kid_token(c, 1).text, ex_read_tparams(fuel, ex_items(fuel, kid(c, 2))), ex_read_fields(fuel, gaps, ex_items(fuel, kid(c, 5))));
    }
    if (p == xp_enum() && node_prod(kid(c, 3)) == xp_where_none()) {
        return IEnum(kid_token(c, 1).text, ex_read_tparams(fuel, ex_items(fuel, kid(c, 2))), ex_read_ctors(fuel, gaps, ex_items(fuel, kid(c, 5))));
    }
    if (p == xp_fn()) {
        return IFn(ex_read_fn(fuel, c, empty(), doc, inline));
    }
    if (p == xp_impl_inherent()) {
        return ex_read_impl(fuel, gaps, c);
    }
    return IBad(tx_err_item());
}

// The items of a file, with the markers applied, reversed onto st.acc.
pub fn ex_read_items(fuel: usize, gaps: List<XGap>, items: List<CTree>, st: XMarks) -> XMarks {
    return match (items) {
        Nil -> st,
        Cons(c, rest) -> ex_read_items(fuel, gaps, unbox(rest), ex_read_at(fuel, gaps, c, ex_gap_at(gaps, ex_start(fuel, c)), st)),
    };
}

// extract: inline
fn ex_read_at(rfuel: usize, rgaps: List<XGap>, rc: CTree, rgap: XGap, rst: XMarks) -> XMarks {
    let marked: XMarks = ex_markers(rst, rgap.markers);
    return match (ex_item_node(rc)) {
        None -> marked,
        Some(node) -> XMarks { inline: marked.inline && node_prod(node) != xp_fn(), prelude: marked.prelude, external: marked.external,
            acc: cons(XAt { item: ex_read_item(rfuel, rgaps, node, marked.inline && node_prod(node) == xp_fn(), rgap.comments), doc: rgap.comments, inline: marked.inline, prelude: marked.prelude, external: marked.external }, marked.acc) },
    };
}

pub fn ex_rev_ats(items: List<XAt>, acc: List<XAt>) -> List<XAt> {
    return match (items) {
        Nil -> acc,
        Cons(x, rest) -> ex_rev_ats(unbox(rest), cons(x, acc)),
    };
}

// The file's items in order.
pub fn ex_file_items(fuel: usize, source: List<usize>, root: CTree) -> List<XAt> {
    let gaps: List<XGap> = ex_rev_gaps(ex_gaps(source, 0, ex_leaves(fuel, root, empty()), empty()), empty());
    let start: XMarks = XMarks { inline: false, prelude: false, external: empty(), acc: empty() };
    let read: XMarks = ex_read_items(fuel, gaps, ex_items(fuel, root), start);
    let last: XMarks = ex_markers(read, ex_gap_at(gaps, length(source)).markers);
    return ex_rev_ats(last.acc, empty());
}

// ---------------------------------------------------------------- types module

// `/-- the comments -/` after pad, or nothing.
pub fn ex_doc(comments: List<List<usize>>, pad: List<usize>) -> List<List<usize>> {
    if (length(comments) == 0) {
        return empty();
    }
    return single(ex_flat(cons(pad, cons(tx_doc_open(), cons(ex_join(single(32), comments), single(tx_doc_close()))))));
}

// extract: mutual begin
// Whether t names the type name (after Box is dropped), or has an argument that does.
pub fn ex_mentions(fuel: usize, ty: XTy, name: List<usize>) -> bool {
    if (fuel == 0) {
        return false;
    }
    let t: XTy = ex_strip_box(fuel, ty);
    return ex_same(ex_ty_name(t), name) || ex_mentions_in(minus(fuel, 1), ex_ty_args(t), name);
}

pub fn ex_mentions_in(fuel: usize, tys: List<XTy>, name: List<usize>) -> bool {
    if (fuel == 0) {
        return false;
    }
    return match (tys) {
        Nil -> false,
        Cons(t, rest) -> ex_mentions(minus(fuel, 1), t, name) || ex_mentions_in(minus(fuel, 1), unbox(rest), name),
    };
}
// extract: mutual end

pub fn ex_mentions_any(fuel: usize, tys: List<XTy>, names: List<List<usize>>) -> bool {
    return match (names) {
        Nil -> false,
        Cons(n, rest) -> ex_mentions_in(fuel, tys, n) || ex_mentions_any(fuel, tys, unbox(rest)),
    };
}

pub fn ex_has_text(names: List<List<usize>>, name: List<usize>) -> bool {
    return match (names) {
        Nil -> false,
        Cons(n, rest) -> ex_same(n, name) || ex_has_text(unbox(rest), name),
    };
}

pub fn ex_field_tys(fields: List<XField>) -> List<XTy> {
    return match (fields) {
        Nil -> empty(),
        Cons(f, rest) -> cons(f.ty, ex_field_tys(unbox(rest))),
    };
}

pub fn ex_payload_tys(ctors: List<XCtor>) -> List<XTy> {
    return match (ctors) {
        Nil -> empty(),
        Cons(c, rest) -> concat(c.payload, ex_payload_tys(unbox(rest))),
    };
}

// A struct's or enum's name and the types of its fields or payloads.
pub struct XShape {
    name: List<usize>,
    tys: List<XTy>,
    is_enum: bool,
}

pub fn ex_shape_of(a: XAt) -> List<XShape> {
    if (a.prelude) {
        return empty();
    }
    return match (a.item) {
        IStruct(name, tparams, fields) -> single(XShape { name: name, tys: ex_field_tys(fields), is_enum: false }),
        IEnum(name, tparams, ctors) -> single(XShape { name: name, tys: ex_payload_tys(ctors), is_enum: true }),
        IFn(f) -> empty(),
        IImpl(name, fns) -> empty(),
        IMutual(b, f) -> empty(),
        IExternal(m, p) -> empty(),
        IPreludeEnd -> empty(),
        IBad(why) -> empty(),
    };
}

// The structs and enums outside the prelude, in order.
pub fn ex_shapes(ats: List<XAt>) -> List<XShape> {
    return match (ats) {
        Nil -> empty(),
        Cons(a, rest) -> concat(ex_shape_of(a), ex_shapes(unbox(rest))),
    };
}

pub fn ex_nested_any(fuel: usize, tys: List<XTy>, name: List<usize>) -> bool {
    return match (tys) {
        Nil -> false,
        Cons(t, rest) -> ex_mentions_in(fuel, ex_ty_args(ex_strip_box(fuel, t)), name) || ex_nested_any(fuel, unbox(rest), name),
    };
}

pub fn ex_self_nested_one(fuel: usize, s: XShape) -> List<List<usize>> {
    if (s.is_enum && ex_nested_any(fuel, s.tys, s.name)) {
        return single(s.name);
    }
    return empty();
}

// The enums nested in themselves through a type argument.
pub fn ex_self_nested(fuel: usize, shapes: List<XShape>) -> List<List<usize>> {
    return match (shapes) {
        Nil -> empty(),
        Cons(s, rest) -> concat(ex_self_nested_one(fuel, s), ex_self_nested(fuel, unbox(rest))),
    };
}

pub fn ex_bad_add(fuel: usize, s: XShape, bad: List<List<usize>>) -> List<List<usize>> {
    if (!ex_has_text(bad, s.name) && ex_mentions_any(fuel, s.tys, bad)) {
        return concat(bad, single(s.name));
    }
    return bad;
}

// One round: the types not yet bad that mention a bad one.
pub fn ex_bad_round(fuel: usize, shapes: List<XShape>, bad: List<List<usize>>) -> List<List<usize>> {
    return match (shapes) {
        Nil -> bad,
        Cons(s, rest) -> ex_bad_round(fuel, unbox(rest), ex_bad_add(fuel, s, bad)),
    };
}

pub fn ex_bad_close(fuel: usize, rounds: usize, shapes: List<XShape>, bad: List<List<usize>>) -> List<List<usize>> {
    if (rounds == 0) {
        return bad;
    }
    let next: List<List<usize>> = ex_bad_round(fuel, shapes, bad);
    if (length(next) == length(bad)) {
        return bad;
    }
    return ex_bad_close(fuel, minus(rounds, 1), shapes, next);
}

// The types Lean cannot derive DecidableEq for (extract.py's nested_types).
pub fn ex_no_deq(fuel: usize, ats: List<XAt>) -> List<List<usize>> {
    let shapes: List<XShape> = ex_shapes(ats);
    return ex_bad_close(fuel, plus(length(shapes), 1), shapes, ex_self_nested(fuel, shapes));
}

pub fn ex_deriving(no_deq: List<List<usize>>, name: List<usize>) -> List<usize> {
    if (ex_has_text(no_deq, name)) {
        return tx_deriving_repr();
    }
    return tx_deriving_deq();
}

pub fn ex_field_lines(fuel: usize, fields: List<XField>) -> List<List<usize>> {
    return match (fields) {
        Nil -> empty(),
        Cons(f, rest) -> concat(ex_doc(f.doc, cons(32, single(32))),
            cons(ex_flat(cons(cons(32, single(32)), cons(ex_camel_rest(f.name), cons(tx_colon(), single(ex_lean_type(fuel, f.ty)))))),
                ex_field_lines(fuel, unbox(rest)))),
    };
}

pub fn ex_arrows(fuel: usize, payload: List<XTy>) -> List<usize> {
    return match (payload) {
        Nil -> empty(),
        Cons(t, rest) -> concat(ex_atom_type(fuel, t), concat(tx_arrow(), ex_arrows(fuel, unbox(rest)))),
    };
}

pub fn ex_ctor_lines(fuel: usize, ctors: List<XCtor>, name: List<usize>) -> List<List<usize>> {
    return match (ctors) {
        Nil -> empty(),
        Cons(c, rest) -> concat(ex_doc(c.doc, cons(32, single(32))),
            cons(ex_flat(cons(tx_ctor_bar(), cons(ex_lower_first(c.name), cons(tx_colon(), cons(ex_arrows(fuel, c.payload), single(name)))))),
                ex_ctor_lines(fuel, unbox(rest), name))),
    };
}

pub fn ex_emit_struct(fuel: usize, no_deq: List<List<usize>>, a: XAt, name: List<usize>, fields: List<XField>) -> List<usize> {
    let head: List<usize> = concat(tx_structure(), concat(name, tx_where_()));
    let lines: List<List<usize>> = concat(ex_doc(a.doc, empty()), cons(head, concat(ex_field_lines(fuel, fields), single(ex_deriving(no_deq, name)))));
    return concat(ex_join(single(10), lines), single(10));
}

pub fn ex_emit_enum(fuel: usize, no_deq: List<List<usize>>, a: XAt, name: List<usize>, ctors: List<XCtor>) -> List<usize> {
    let head: List<usize> = concat(tx_inductive(), concat(name, tx_where_()));
    let lines: List<List<usize>> = concat(ex_doc(a.doc, empty()), cons(head, concat(ex_ctor_lines(fuel, ctors, name), single(ex_deriving(no_deq, name)))));
    return concat(ex_join(single(10), lines), single(10));
}

pub fn ex_type_text(fuel: usize, no_deq: List<List<usize>>, a: XAt) -> List<List<usize>> {
    if (a.prelude || length(a.external) != 0) {
        return empty();
    }
    return match (a.item) {
        IStruct(name, tparams, fields) -> single(ex_emit_struct(fuel, no_deq, a, name, fields)),
        IEnum(name, tparams, ctors) -> single(ex_emit_enum(fuel, no_deq, a, name, ctors)),
        IFn(f) -> empty(),
        IImpl(name, fns) -> empty(),
        IMutual(b, f) -> empty(),
        IExternal(m, p) -> empty(),
        IPreludeEnd -> empty(),
        IBad(why) -> empty(),
    };
}

// The emitted types, in order.
pub fn ex_type_texts(fuel: usize, no_deq: List<List<usize>>, ats: List<XAt>) -> List<List<usize>> {
    return match (ats) {
        Nil -> empty(),
        Cons(a, rest) -> concat(ex_type_text(fuel, no_deq, a), ex_type_texts(fuel, no_deq, unbox(rest))),
    };
}

pub fn ex_external_of(item: XItem) -> List<List<usize>> {
    return match (item) {
        IStruct(name, tparams, fields) -> empty(),
        IEnum(name, tparams, ctors) -> empty(),
        IFn(f) -> empty(),
        IImpl(name, fns) -> empty(),
        IMutual(b, f) -> empty(),
        IExternal(m, p) -> single(m),
        IPreludeEnd -> empty(),
        IBad(why) -> empty(),
    };
}

// The modules of the external sections, in order.
pub fn ex_externals(ats: List<XAt>) -> List<List<usize>> {
    return match (ats) {
        Nil -> empty(),
        Cons(a, rest) -> concat(ex_external_of(a.item), ex_externals(unbox(rest))),
    };
}

pub fn ex_public_imports(modules: List<List<usize>>) -> List<usize> {
    return match (modules) {
        Nil -> empty(),
        Cons(m, rest) -> concat(tx_public_import(), concat(m, cons(10, ex_public_imports(unbox(rest))))),
    };
}

pub fn ex_part_header(source_name: List<usize>, modname: List<usize>) -> List<usize> {
    return ex_flat(cons(tx_part_head(), cons(source_name, cons(tx_part_of(), cons(modname, single(tx_part_tail()))))));
}

pub fn ex_with_types(modules: List<List<usize>>) -> List<List<usize>> {
    return match (modules) {
        Nil -> empty(),
        Cons(m, rest) -> cons(concat(m, tx_dot_types()), ex_with_types(unbox(rest))),
    };
}

// The text of `module.Types`.
pub fn ex_types_module(fuel: usize, source_name: List<usize>, modname: List<usize>, ats: List<XAt>) -> List<usize> {
    let no_deq: List<List<usize>> = ex_no_deq(fuel, ats);
    return ex_flat(cons(tx_module_head(), cons(ex_public_imports(ex_with_types(ex_externals(ats))), cons(tx_public_section(),
        cons(ex_part_header(source_name, modname), cons(ex_join(single(10), ex_type_texts(fuel, no_deq, ats)), single(tx_end_namespace())))))));
}

// ---------------------------------------------------------------- Lean terms

