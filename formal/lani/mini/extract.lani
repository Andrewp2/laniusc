// text err_return "a block must end with return"
// text err_unreachable "unreachable code"
// text err_mut "&mut is not extracted yet"
// text err_inline "inline call"
// text err_assign "an assignment target is a local or fields of one"
// text err_unit "a function returns nothing"
// text err_list_op "a list operation may call only itself"

// A Lean term (extract.py's (text, precedence) pair), with its type (an
// empty name if unknown) and what was outside the subset.
pub struct XTm {
    text: List<usize>,
    prec: usize,
    ty: XTy,
    errs: List<List<usize>>,
}

pub struct XBind {
    name: List<usize>,
    lname: List<usize>,
    ty: XTy,
}

pub struct XStructD {
    name: List<usize>,
    fields: List<XField>,
}

pub struct XEnumD {
    name: List<usize>,
    ctors: List<XCtor>,
}

// What the extraction of a file knows: its types, functions and methods (by
// the impl's type), and the function being extracted.
pub struct XCx {
    structs: List<XStructD>,
    enums: List<XEnumD>,
    fns: List<XFn>,
    methods: List<XFn>,
    current: XFn,
}

pub fn ex_atom() -> usize {
    return 1024;
}

pub fn ex_app_prec() -> usize {
    return 1000;
}

pub fn ex_none() -> XTy {
    return ex_ty(empty());
}

pub fn ex_is_none(t: XTy) -> bool {
    return match (t) {
        XT(name, args) -> length(name) == 0,
        XBad(why) -> false,
    };
}

pub fn ex_ty1(name: List<usize>, arg: XTy) -> XTy {
    return XT(name, boxed(single(arg)));
}

pub fn ex_fail(why: List<usize>) -> XTm {
    return XTm { text: empty(), prec: 1024, ty: XBad(why), errs: single(why) };
}

pub fn ex_tm(text: List<usize>, prec: usize, ty: XTy) -> XTm {
    return XTm { text: text, prec: prec, ty: ty, errs: empty() };
}

// t with more errors before its own.
pub fn ex_with_errs(errs: List<List<usize>>, t: XTm) -> XTm {
    return XTm { text: t.text, prec: t.prec, ty: t.ty, errs: concat(errs, t.errs) };
}

pub fn ex_retyped(t: XTm, ty: XTy) -> XTm {
    return XTm { text: t.text, prec: t.prec, ty: ty, errs: t.errs };
}

pub fn ex_err_if(bad: bool, why: List<usize>, t: XTm) -> XTm {
    if (bad) {
        return XTm { text: t.text, prec: t.prec, ty: t.ty, errs: concat(t.errs, single(why)) };
    }
    return t;
}

pub fn ex_all_errs(ts: List<XTm>) -> List<List<usize>> {
    return match (ts) {
        Nil -> empty(),
        Cons(t, rest) -> concat(t.errs, ex_all_errs(unbox(rest))),
    };
}

pub fn ex_spaces(n: usize) -> List<usize> {
    if (n == 0) {
        return empty();
    }
    return cons(32, ex_spaces(minus(n, 1)));
}

// Each newline followed by by spaces (extract.py's indent_tail).
pub fn ex_indent(text: List<usize>, pad: List<usize>) -> List<usize> {
    return match (text) {
        Nil -> empty(),
        Cons(c, rest) -> ex_indent_at(c == 10, c, unbox(rest), pad),
    };
}

// extract: inline
fn ex_indent_at(inl: bool, ic: usize, irest: List<usize>, ipad: List<usize>) -> List<usize> {
    if (inl) {
        return cons(10, concat(ipad, ex_indent(irest, ipad)));
    }
    return cons(ic, ex_indent(irest, ipad));
}

pub fn ex_paren(t: XTm, need: usize) -> List<usize> {
    if (t.prec >= need) {
        return t.text;
    }
    return cons(40, concat(ex_indent(t.text, single(32)), single(41)));
}

pub fn ex_parens_atom(ts: List<XTm>) -> List<usize> {
    return match (ts) {
        Nil -> empty(),
        Cons(t, rest) -> cons(32, concat(ex_paren(t, 1024), ex_parens_atom(unbox(rest)))),
    };
}

// head applied to args.
pub fn ex_app(head: List<usize>, args: List<XTm>, ty: XTy) -> XTm {
    if (length(args) == 0) {
        return ex_tm(head, 1024, ty);
    }
    return XTm { text: concat(head, ex_parens_atom(args)), prec: 1000, ty: ty, errs: ex_all_errs(args) };
}

pub fn ex_infix_prec(op: List<usize>) -> usize {
    if (ex_same(op, tx_lean_concat()) || ex_same(op, tx_op_plus()) || ex_same(op, tx_op_minus())) {
        return 65;
    }
    if (ex_same(op, tx_lean_cons())) {
        return 67;
    }
    if (ex_same(op, tx_op_times()) || ex_same(op, tx_op_div()) || ex_same(op, tx_op_mod())) {
        return 70;
    }
    if (ex_same(op, tx_op_and())) {
        return 35;
    }
    if (ex_same(op, tx_op_or())) {
        return 30;
    }
    if (ex_same(op, tx_lean_band()) || ex_same(op, tx_lean_xor())) {
        return 58;
    }
    if (ex_same(op, tx_lean_bor())) {
        return 55;
    }
    if (ex_same(op, tx_lean_shr())) {
        return 75;
    }
    return 50;
}

// 0 left, 1 right, 2 neither.
pub fn ex_infix_assoc(op: List<usize>) -> usize {
    if (ex_same(op, tx_lean_cons())) {
        return 1;
    }
    if (ex_same(op, tx_op_lt()) || ex_same(op, tx_lean_le()) || ex_same(op, tx_lean_eq()) || ex_same(op, tx_lean_ne())) {
        return 2;
    }
    return 0;
}

pub fn ex_bit(b: bool) -> usize {
    if (b) {
        return 1;
    }
    return 0;
}

pub fn ex_lean_infix(op: List<usize>, left: XTm, right: XTm, ty: XTy) -> XTm {
    let prec: usize = ex_infix_prec(op);
    let assoc: usize = ex_infix_assoc(op);
    let lneed: usize = plus(prec, ex_bit(assoc != 0));
    let rneed: usize = plus(prec, ex_bit(assoc != 1));
    let text: List<usize> = ex_flat(cons(ex_paren(left, lneed), cons(single(32), cons(op, cons(single(32), single(ex_paren(right, rneed)))))));
    return XTm { text: text, prec: prec, ty: ty, errs: concat(left.errs, right.errs) };
}

// text lean_keywords "at by do else end fun from have if import in instance let match namespace open show then theorem universe variable where with deriving structure inductive def section matches public private protected mutual partial unsafe noncomputable abbrev example axiom opaque macro syntax notation calc suffices obtain nomatch nofun infix infixl infixr postfix"
pub fn ex_is_keyword(name: List<usize>) -> bool {
    return ex_has_text(ex_words(tx_lean_keywords(), empty(), empty()), name);
}

pub fn ex_camel(name: List<usize>) -> List<usize> {
    return ex_camel_rest(name);
}

// The errors of a camelCase name that is a Lean keyword.
pub fn ex_camel_errs(name: List<usize>) -> List<List<usize>> {
    if (ex_is_keyword(ex_camel(name))) {
        return single(tx_err_keyword());
    }
    return empty();
}

pub fn ex_dot(a: List<usize>, b: List<usize>) -> List<usize> {
    return concat(a, cons(46, b));
}

pub fn ex_last_text(items: List<List<usize>>) -> List<usize> {
    return get_or(items, minus(length(items), 1), empty());
}

// ---------------------------------------------------------------- lookups

pub fn ex_find_bind(env: List<XBind>, name: List<usize>) -> core::option::Option<XBind> {
    return match (env) {
        Nil -> None,
        Cons(b, rest) -> ex_bind_or(ex_same(b.name, name), b, unbox(rest), name),
    };
}

// extract: inline
fn ex_bind_or(bhit: bool, bb: XBind, brest: List<XBind>, bname: List<usize>) -> core::option::Option<XBind> {
    if (bhit) {
        return Some(bb);
    }
    return ex_find_bind(brest, bname);
}

pub fn ex_find_struct(structs: List<XStructD>, name: List<usize>) -> core::option::Option<XStructD> {
    return match (structs) {
        Nil -> None,
        Cons(s, rest) -> ex_struct_or(ex_same(s.name, name), s, unbox(rest), name),
    };
}

// extract: inline
fn ex_struct_or(shit: bool, ss: XStructD, srest: List<XStructD>, sname: List<usize>) -> core::option::Option<XStructD> {
    if (shit) {
        return Some(ss);
    }
    return ex_find_struct(srest, sname);
}

pub fn ex_find_enum(enums: List<XEnumD>, name: List<usize>) -> core::option::Option<XEnumD> {
    return match (enums) {
        Nil -> None,
        Cons(e, rest) -> ex_enum_or(ex_same(e.name, name), e, unbox(rest), name),
    };
}

// extract: inline
fn ex_enum_or(ehit: bool, ee: XEnumD, erest: List<XEnumD>, ename: List<usize>) -> core::option::Option<XEnumD> {
    if (ehit) {
        return Some(ee);
    }
    return ex_find_enum(erest, ename);
}

pub fn ex_find_fn(fns: List<XFn>, name: List<usize>) -> core::option::Option<XFn> {
    return match (fns) {
        Nil -> None,
        Cons(f, rest) -> ex_fn_or(ex_same(f.name, name), f, unbox(rest), name),
    };
}

// extract: inline
fn ex_fn_or(fhit: bool, ff: XFn, frest: List<XFn>, fname: List<usize>) -> core::option::Option<XFn> {
    if (fhit) {
        return Some(ff);
    }
    return ex_find_fn(frest, fname);
}

pub fn ex_self_name(f: XFn) -> List<usize> {
    return ex_ty_name(get_or(f.self_type, 0, ex_none()));
}

pub fn ex_find_method(methods: List<XFn>, owner: List<usize>, name: List<usize>) -> core::option::Option<XFn> {
    return match (methods) {
        Nil -> None,
        Cons(f, rest) -> ex_method_or(ex_same(f.name, name) && ex_same(ex_self_name(f), owner), f, unbox(rest), owner, name),
    };
}

// extract: inline
fn ex_method_or(mhit: bool, mf: XFn, mrest: List<XFn>, mowner: List<usize>, mname: List<usize>) -> core::option::Option<XFn> {
    if (mhit) {
        return Some(mf);
    }
    return ex_find_method(mrest, mowner, mname);
}

pub fn ex_find_field(fields: List<XField>, name: List<usize>) -> core::option::Option<XTy> {
    return match (fields) {
        Nil -> None,
        Cons(f, rest) -> ex_field_or(ex_same(f.name, name), f.ty, unbox(rest), name),
    };
}

// extract: inline
fn ex_field_or(fdhit: bool, fdty: XTy, fdrest: List<XField>, fdname: List<usize>) -> core::option::Option<XTy> {
    if (fdhit) {
        return Some(fdty);
    }
    return ex_find_field(fdrest, fdname);
}

// The type of field name of a struct type.
pub fn ex_field_ty(cx: XCx, owner: XTy, name: List<usize>) -> core::option::Option<XTy> {
    return match (ex_find_struct(cx.structs, ex_ty_name(owner))) {
        None -> None,
        Some(s) -> ex_find_field(s.fields, name),
    };
}

pub fn ex_find_ctor(ctors: List<XCtor>, name: List<usize>) -> core::option::Option<XCtor> {
    return match (ctors) {
        Nil -> None,
        Cons(c, rest) -> ex_ctor_or(ex_same(c.name, name), c, unbox(rest), name),
    };
}

// extract: inline
fn ex_ctor_or(chit: bool, cc: XCtor, crest: List<XCtor>, cname: List<usize>) -> core::option::Option<XCtor> {
    if (chit) {
        return Some(cc);
    }
    return ex_find_ctor(crest, cname);
}

pub fn ex_owner_if(e: XEnumD, name: List<usize>) -> List<XEnumD> {
    return match (ex_find_ctor(e.ctors, name)) {
        None -> empty(),
        Some(c) -> single(e),
    };
}

// The enums with a constructor of this name, in order.
pub fn ex_ctor_owners(enums: List<XEnumD>, name: List<usize>) -> List<XEnumD> {
    return match (enums) {
        Nil -> empty(),
        Cons(e, rest) -> concat(ex_owner_if(e, name), ex_ctor_owners(unbox(rest), name)),
    };
}

// A constructor named by a path: its enum, and the constructor.
pub struct XCtorRef {
    enum_name: List<usize>,
    ctor: XCtor,
    errs: List<List<usize>>,
}

pub fn ex_no_ctor() -> XCtorRef {
    return XCtorRef { enum_name: empty(), ctor: XCtor { name: empty(), payload: empty(), doc: empty() }, errs: single(tx_err_ctor()) };
}

pub fn ex_ctor_in(e: XEnumD, name: List<usize>) -> XCtorRef {
    return match (ex_find_ctor(e.ctors, name)) {
        None -> ex_no_ctor(),
        Some(c) -> XCtorRef { enum_name: e.name, ctor: c, errs: empty() },
    };
}

pub fn ex_ctor_ref(cx: XCx, path: List<List<usize>>) -> XCtorRef {
    if (length(path) == 2) {
        return match (ex_find_enum(cx.enums, get_or(path, 0, empty()))) {
            None -> ex_no_ctor(),
            Some(e) -> ex_ctor_in(e, get_or(path, 1, empty())),
        };
    }
    if (length(path) == 1) {
        let owners: List<XEnumD> = ex_ctor_owners(cx.enums, get_or(path, 0, empty()));
        if (length(owners) == 1) {
            return match (owners) {
                Nil -> ex_no_ctor(),
                Cons(e, rest) -> ex_ctor_in(e, get_or(path, 0, empty())),
            };
        }
        return ex_no_ctor();
    }
    return ex_no_ctor();
}

// The list rules (extract.py's PRELUDE_FNS and SPEC_FNS): 1 the argument
// itself, 2 [], 3 [x], 4 ++, 5 ::, 6 length, 7 get, 8 getD, 9 +, 10 *, 11 -,
// 12 max, 0 none.
pub fn ex_prelude_rule(name: List<usize>) -> usize {
    if (ex_same(name, tx_name_boxed()) || ex_same(name, tx_name_unbox())) {
        return 1;
    }
    if (ex_same(name, tx_name_plus())) {
        return 9;
    }
    if (ex_same(name, tx_name_times())) {
        return 10;
    }
    if (ex_same(name, tx_name_minus())) {
        return 11;
    }
    if (ex_same(name, tx_name_max_of())) {
        return 12;
    }
    return 0;
}

pub fn ex_spec_rule(name: List<usize>) -> usize {
    if (ex_same(name, tx_name_empty())) {
        return 2;
    }
    if (ex_same(name, tx_name_single())) {
        return 3;
    }
    if (ex_same(name, tx_name_concat())) {
        return 4;
    }
    if (ex_same(name, tx_name_cons_fn())) {
        return 5;
    }
    if (ex_same(name, tx_name_length())) {
        return 6;
    }
    if (ex_same(name, tx_name_get())) {
        return 7;
    }
    if (ex_same(name, tx_name_get_or())) {
        return 8;
    }
    return 0;
}

pub fn ex_rule_arity(rule: usize) -> usize {
    if (rule == 2) {
        return 0;
    }
    if (rule == 1 || rule == 3 || rule == 6) {
        return 1;
    }
    if (rule == 8) {
        return 3;
    }
    return 2;
}

pub fn ex_is_comparison(op: List<usize>) -> bool {
    return ex_same(op, tx_op_lt()) || ex_same(op, tx_op_le()) || ex_same(op, tx_op_gt()) || ex_same(op, tx_op_ge())
        || ex_same(op, tx_op_eq()) || ex_same(op, tx_op_ne());
}

// Whether t is the scalar type named name.
pub fn ex_is_scalar(t: XTy, name: List<usize>) -> bool {
    return ex_is_named(t, name) && length(ex_ty_args(t)) == 0;
}

// The literal's bound for its type, 0 if it has none.
pub fn ex_literal_max(t: XTy) -> usize {
    if (ex_is_named(t, tx_usize()) || ex_is_named(t, tx_u64())) {
        return 18446744073709551615;
    }
    if (ex_is_named(t, tx_i32())) {
        return 2147483647;
    }
    if (ex_is_named(t, tx_u32())) {
        return 4294967295;
    }
    if (ex_is_named(t, tx_u8())) {
        return 255;
    }
    return 0;
}

pub fn ex_int(n: usize, expected: XTy) -> XTm {
    let bound: usize = ex_literal_max(expected);
    if (ex_is_none(expected) || bound == 0 || n > bound) {
        return ex_fail(tx_err_literal());
    }
    return ex_tm(ex_decimal(n), 1024, expected);
}

pub fn ex_ident_start(c: usize) -> bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
}

pub fn ex_ident_char(c: usize) -> bool {
    return ex_ident_start(c) || (c >= 48 && c <= 57);
}

pub fn ex_ident_rest(text: List<usize>) -> bool {
    return match (text) {
        Nil -> true,
        Cons(c, rest) -> ex_ident_char(c) && ex_ident_rest(unbox(rest)),
    };
}

pub fn ex_is_ident_text(text: List<usize>) -> bool {
    return match (text) {
        Nil -> false,
        Cons(c, rest) -> ex_ident_start(c) && ex_ident_rest(unbox(rest)),
    };
}

// extract: mutual begin
// The camelCase names an inline body's lets bind (extract.py's walk_lets),
// in its statements and in its ifs' branches.
pub fn ex_let_names(fuel: usize, stmts: List<XE>) -> List<List<usize>> {
    if (fuel == 0) {
        return empty();
    }
    return match (stmts) {
        Nil -> empty(),
        Cons(s, rest) -> concat(ex_let_names_of(minus(fuel, 1), s), ex_let_names(minus(fuel, 1), unbox(rest))),
    };
}

pub fn ex_let_names_of(fuel: usize, s: XE) -> List<List<usize>> {
    if (fuel == 0) {
        return empty();
    }
    return match (s) {
        EInt(n) -> empty(),
        EBool(b) -> empty(),
        EName(path) -> empty(),
        ECall(path, args) -> empty(),
        EMethod(recv, name, args) -> empty(),
        EField(recv, name) -> empty(),
        EStruct(name, names, values) -> empty(),
        EBinary(op, l, r) -> empty(),
        ENot(x) -> empty(),
        ECast(x, t) -> empty(),
        EMatch(x, arms) -> empty(),
        EArm(path, binders, body) -> empty(),
        SBlock(stmts) -> empty(),
        SLet(name, t, v) -> single(ex_camel(name)),
        SAssign(place, v) -> empty(),
        SCall(x) -> empty(),
        SMatch(x) -> empty(),
        SReturn(v) -> empty(),
        SIf(c, a, b, has) -> concat(ex_let_names(minus(fuel, 1), unbox(a)), ex_let_names(minus(fuel, 1), unbox(b))),
        EBad(why) -> empty(),
    };
}
// extract: mutual end

pub fn ex_lnames(env: List<XBind>) -> List<List<usize>> {
    return match (env) {
        Nil -> empty(),
        Cons(b, rest) -> cons(b.lname, ex_lnames(unbox(rest))),
    };
}

pub fn ex_any_in(names: List<List<usize>>, among: List<List<usize>>) -> bool {
    return match (names) {
        Nil -> false,
        Cons(n, rest) -> ex_has_text(among, n) || ex_any_in(unbox(rest), among),
    };
}

pub fn ex_is_block(e: XE) -> bool {
    return match (e) {
        EInt(n) -> false,
        EBool(b) -> false,
        EName(path) -> false,
        ECall(path, args) -> false,
        EMethod(recv, name, args) -> false,
        EField(recv, name) -> false,
        EStruct(name, names, values) -> false,
        EBinary(op, l, r) -> false,
        ENot(x) -> false,
        ECast(x, t) -> false,
        EMatch(x, arms) -> false,
        EArm(path, binders, body) -> false,
        SBlock(stmts) -> true,
        SLet(name, t, v) -> false,
        SAssign(place, v) -> false,
        SCall(x) -> false,
        SMatch(x) -> false,
        SReturn(v) -> false,
        SIf(c, a, b, has) -> false,
        EBad(why) -> false,
    };
}

pub fn ex_is_block_arm(a: XE) -> bool {
    return match (a) {
        EInt(n) -> false,
        EBool(b) -> false,
        EName(path) -> false,
        ECall(path, args) -> false,
        EMethod(recv, name, args) -> false,
        EField(recv, name) -> false,
        EStruct(name, names, values) -> false,
        EBinary(op, l, r) -> false,
        ENot(x) -> false,
        ECast(x, t) -> false,
        EMatch(x, arms) -> false,
        EArm(path, binders, body) -> ex_is_block(unbox(body)),
        SBlock(stmts) -> false,
        SLet(name, t, v) -> false,
        SAssign(place, v) -> false,
        SCall(x) -> false,
        SMatch(x) -> false,
        SReturn(v) -> false,
        SIf(c, a2, b, has) -> false,
        EBad(why) -> false,
    };
}

// Whether e is `return match` with a block arm.
pub fn ex_has_block_arm(arms: List<XE>) -> bool {
    return match (arms) {
        Nil -> false,
        Cons(a, rest) -> ex_is_block_arm(a) || ex_has_block_arm(unbox(rest)),
    };
}

// The statements of an arm: a block's, or `return body;`.
pub fn ex_arm_stmts(body: XE) -> List<XE> {
    return match (body) {
        EInt(n) -> single(SReturn(boxed(single(body)))),
        EBool(b) -> single(SReturn(boxed(single(body)))),
        EName(path) -> single(SReturn(boxed(single(body)))),
        ECall(path, args) -> single(SReturn(boxed(single(body)))),
        EMethod(recv, name, args) -> single(SReturn(boxed(single(body)))),
        EField(recv, name) -> single(SReturn(boxed(single(body)))),
        EStruct(name, names, values) -> single(SReturn(boxed(single(body)))),
        EBinary(op, l, r) -> single(SReturn(boxed(single(body)))),
        ENot(x) -> single(SReturn(boxed(single(body)))),
        ECast(x, t) -> single(SReturn(boxed(single(body)))),
        EMatch(x, arms) -> single(SReturn(boxed(single(body)))),
        EArm(path, binders, b) -> single(SReturn(boxed(single(body)))),
        SBlock(stmts) -> unbox(stmts),
        SLet(name, t, v) -> single(SReturn(boxed(single(body)))),
        SAssign(place, v) -> single(SReturn(boxed(single(body)))),
        SCall(x) -> single(SReturn(boxed(single(body)))),
        SMatch(x) -> single(SReturn(boxed(single(body)))),
        SReturn(v) -> single(SReturn(boxed(single(body)))),
        SIf(c, a, b, has) -> single(SReturn(boxed(single(body)))),
        EBad(why) -> single(body),
    };
}

// A match's scrutinee type kind: 1 List, 2 Option, 3 an enum, 0 none.
pub struct XShapes {
    kind: usize,
    names: List<List<usize>>,
    counts: List<usize>,
    payloads: List<List<XTy>>,
}

pub fn ex_ctor_names(ctors: List<XCtor>) -> List<List<usize>> {
    return match (ctors) {
        Nil -> empty(),
        Cons(c, rest) -> cons(c.name, ex_ctor_names(unbox(rest))),
    };
}

pub fn ex_ctor_counts(ctors: List<XCtor>) -> List<usize> {
    return match (ctors) {
        Nil -> empty(),
        Cons(c, rest) -> cons(length(c.payload), ex_ctor_counts(unbox(rest))),
    };
}

pub fn ex_ctor_payloads(ctors: List<XCtor>) -> List<List<XTy>> {
    return match (ctors) {
        Nil -> empty(),
        Cons(c, rest) -> cons(c.payload, ex_ctor_payloads(unbox(rest))),
    };
}

pub fn ex_shapes_of(cx: XCx, ty: XTy) -> XShapes {
    if (ex_is_named(ty, tx_list())) {
        return XShapes { kind: 1, names: cons(tx_name_nil(), single(tx_name_cons())), counts: cons(0, single(2)),
            payloads: cons(empty(), single(cons(ex_ty_arg(ty), single(ex_ty1(tx_box(), ty))))) };
    }
    if (ex_is_named(ty, tx_option())) {
        return XShapes { kind: 2, names: cons(tx_name_some(), single(tx_name_none())), counts: cons(1, single(0)),
            payloads: cons(single(ex_ty_arg(ty)), single(empty())) };
    }
    return match (ex_find_enum(cx.enums, ex_ty_name(ty))) {
        None -> XShapes { kind: 0, names: empty(), counts: empty(), payloads: empty() },
        Some(e) -> XShapes { kind: 3, names: ex_ctor_names(e.ctors), counts: ex_ctor_counts(e.ctors), payloads: ex_ctor_payloads(e.ctors) },
    };
}

pub fn ex_index_of(names: List<List<usize>>, name: List<usize>, k: usize) -> usize {
    return match (names) {
        Nil -> k,
        Cons(n, rest) -> ex_index_or(ex_same(n, name), unbox(rest), name, k),
    };
}

// extract: inline
fn ex_index_or(xhit: bool, xrest: List<List<usize>>, xname: List<usize>, xk: usize) -> usize {
    if (xhit) {
        return xk;
    }
    return ex_index_of(xrest, xname, plus(xk, 1));
}

pub fn ex_binder_lname(b: List<usize>) -> List<usize> {
    if (ex_same(b, single(95))) {
        return b;
    }
    return ex_camel(b);
}

pub fn ex_binder_lnames(binders: List<List<usize>>) -> List<List<usize>> {
    return match (binders) {
        Nil -> empty(),
        Cons(b, rest) -> cons(ex_binder_lname(b), ex_binder_lnames(unbox(rest))),
    };
}

pub fn ex_bind_one(b: List<usize>, ty: XTy, env: List<XBind>) -> List<XBind> {
    if (ex_same(b, single(95))) {
        return env;
    }
    return cons(XBind { name: b, lname: ex_camel(b), ty: ty }, env);
}

pub fn ex_tail_tys(tys: List<XTy>) -> List<XTy> {
    return match (tys) {
        Nil -> empty(),
        Cons(t, rest) -> unbox(rest),
    };
}

// The env with an arm's binders bound (`_` binds nothing).
pub fn ex_bind_binders(binders: List<List<usize>>, tys: List<XTy>, env: List<XBind>) -> List<XBind> {
    return match (binders) {
        Nil -> env,
        Cons(b, rest) -> ex_bind_binders(unbox(rest), ex_tail_tys(tys), ex_bind_one(b, get_or(tys, 0, ex_none()), env)),
    };
}

// An arm's pattern.
pub fn ex_pattern(kind: usize, ctor: List<usize>, lnames: List<List<usize>>) -> List<usize> {
    if (kind == 1) {
        if (ex_same(ctor, tx_name_nil())) {
            return tx_lean_nil();
        }
        return ex_flat(cons(get_or(lnames, 0, empty()), cons(single(32), cons(tx_lean_cons(), cons(single(32), single(get_or(lnames, 1, empty())))))));
    }
    if (kind == 2) {
        if (ex_same(ctor, tx_name_none())) {
            return tx_lean_none();
        }
        return concat(tx_lean_some(), cons(32, get_or(lnames, 0, empty())));
    }
    return ex_join(single(32), cons(cons(46, ex_lower_first(ctor)), lnames));
}

pub fn ex_arm_line(pattern: List<usize>, text: List<usize>) -> List<usize> {
    if (ex_has(text, 10)) {
        return ex_flat(cons(tx_lean_arm_bar(), cons(pattern, cons(tx_lean_arm_to(), cons(cons(10, cons(32, single(32))), single(ex_indent(text, cons(32, single(32)))))))));
    }
    return ex_flat(cons(tx_lean_arm_bar(), cons(pattern, cons(tx_lean_arm_to(), cons(single(32), single(text))))));
}

// What the arms gave: their lines, the result type, the constructors seen.
pub struct XArms {
    lines: List<List<usize>>,
    ty: XTy,
    seen: List<List<usize>>,
    errs: List<List<usize>>,
}

pub fn ex_all_seen(names: List<List<usize>>, seen: List<List<usize>>) -> bool {
    return match (names) {
        Nil -> true,
        Cons(n, rest) -> ex_has_text(seen, n) && ex_all_seen(unbox(rest), seen),
    };
}

// The place of an assignment: the local and the fields after it.
pub struct XPlace {
    name: List<List<usize>>,
    fields: List<List<usize>>,
}

pub fn ex_place(place: XE, fields: List<List<usize>>) -> XPlace {
    return match (place) {
        EInt(n) -> XPlace { name: empty(), fields: fields },
        EBool(b) -> XPlace { name: empty(), fields: fields },
        EName(path) -> XPlace { name: path, fields: fields },
        ECall(path, args) -> XPlace { name: empty(), fields: fields },
        EMethod(recv, name, args) -> XPlace { name: empty(), fields: fields },
        EField(recv, name) -> ex_place(unbox(recv), cons(name, fields)),
        EStruct(name, names, values) -> XPlace { name: empty(), fields: fields },
        EBinary(op, l, r) -> XPlace { name: empty(), fields: fields },
        ENot(x) -> XPlace { name: empty(), fields: fields },
        ECast(x, t) -> XPlace { name: empty(), fields: fields },
        EMatch(x, arms) -> XPlace { name: empty(), fields: fields },
        EArm(path, binders, body) -> XPlace { name: empty(), fields: fields },
        SBlock(stmts) -> XPlace { name: empty(), fields: fields },
        SLet(name, t, v) -> XPlace { name: empty(), fields: fields },
        SAssign(p, v) -> XPlace { name: empty(), fields: fields },
        SCall(x) -> XPlace { name: empty(), fields: fields },
        SMatch(x) -> XPlace { name: empty(), fields: fields },
        SReturn(v) -> XPlace { name: empty(), fields: fields },
        SIf(c, a, b, has) -> XPlace { name: empty(), fields: fields },
        EBad(why) -> XPlace { name: empty(), fields: fields },
    };
}

pub fn ex_param_tys(params: List<XParam>) -> List<XTy> {
    return match (params) {
        Nil -> empty(),
        Cons(p, rest) -> cons(p.ty, ex_param_tys(unbox(rest))),
    };
}

pub fn ex_ret_ty(f: XFn) -> XTy {
    return get_or(f.ret, 0, ex_none());
}

pub fn ex_is_spec(name: List<usize>) -> bool {
    return ex_spec_rule(name) != 0;
}

// Python's `a or b` on types: a unless it is unknown.
pub fn ex_or_ty(a: XTy, b: XTy) -> XTy {
    if (ex_is_none(a)) {
        return b;
    }
    return a;
}

pub fn ex_unboxed(t: XTy) -> XTy {
    return ex_strip_box(64, t);
}

pub fn ex_ty_same(a: XTy, b: XTy) -> bool {
    return ex_ty_eq(1000000, a, b);
}

pub fn ex_is_cmp_expr(e: XE) -> bool {
    return match (e) {
        EInt(n) -> false,
        EBool(b) -> false,
        EName(path) -> false,
        ECall(path, args) -> false,
        EMethod(recv, name, args) -> false,
        EField(recv, name) -> false,
        EStruct(name, names, values) -> false,
        EBinary(op, l, r) -> ex_is_comparison(op),
        ENot(x) -> false,
        ECast(x, t) -> false,
        EMatch(x, arms) -> false,
        EArm(path, binders, body) -> false,
        SBlock(stmts) -> false,
        SLet(name, t, v) -> false,
        SAssign(place, v) -> false,
        SCall(x) -> false,
        SMatch(x) -> false,
        SReturn(v) -> false,
        SIf(c, a, b, has) -> false,
        EBad(why) -> false,
    };
}

pub fn ex_int_value(e: XE) -> core::option::Option<usize> {
    return match (e) {
        EInt(n) -> Some(n),
        EBool(b) -> None,
        EName(path) -> None,
        ECall(path, args) -> None,
        EMethod(recv, name, args) -> None,
        EField(recv, name) -> None,
        EStruct(name, names, values) -> None,
        EBinary(op, l, r) -> None,
        ENot(x) -> None,
        ECast(x, t) -> None,
        EMatch(x, arms) -> None,
        EArm(path, binders, body) -> None,
        SBlock(stmts) -> None,
        SLet(name, t, v) -> None,
        SAssign(place, v) -> None,
        SCall(x) -> None,
        SMatch(x) -> None,
        SReturn(v) -> None,
        SIf(c, a, b, has) -> None,
        EBad(why) -> None,
    };
}

pub fn ex_some_inner(expected: XTy) -> XTy {
    if (ex_is_named(expected, tx_option())) {
        return ex_ty_arg(expected);
    }
    return ex_none();
}

// expected without Box if it is a List, else unknown.
pub fn ex_list_of(expected: XTy) -> XTy {
    let t: XTy = ex_unboxed(expected);
    if (ex_is_named(t, tx_list())) {
        return t;
    }
    return ex_none();
}

pub fn ex_list_elem(lst: XTy) -> XTy {
    if (ex_is_none(lst)) {
        return lst;
    }
    return ex_ty_arg(lst);
}

pub fn ex_rule_elem(expected: XTy) -> XTy {
    if (ex_is_named(expected, tx_list()) || ex_is_named(expected, tx_box())) {
        return ex_ty_arg(expected);
    }
    return ex_none();
}

pub fn ex_boxed_or_none(expected: XTy) -> XTy {
    if (ex_is_none(expected)) {
        return expected;
    }
    return ex_ty1(tx_box(), expected);
}

// List<arg>, or unknown when expected is.
pub fn ex_list_like(expected: XTy, arg: XTy) -> XTy {
    if (ex_is_none(expected)) {
        return expected;
    }
    return ex_ty1(tx_list(), arg);
}

pub fn ex_rule_op(rule: usize) -> List<usize> {
    if (rule == 9) {
        return tx_op_plus();
    }
    if (rule == 10) {
        return tx_op_times();
    }
    return tx_op_minus();
}

pub fn ex_tail_es(items: List<XE>) -> List<XE> {
    return match (items) {
        Nil -> empty(),
        Cons(x, rest) -> unbox(rest),
    };
}

// An inline call's arguments: the lets, the body's env, the names the lets
// bind.
pub struct XInlineArgs {
    lets: List<List<usize>>,
    env: List<XBind>,
    names: List<List<usize>>,
    errs: List<List<usize>>,
}

pub fn ex_substitutable(text: List<usize>) -> bool {
    return ex_is_ident_text(text) && !ex_same(text, tx_lean_true()) && !ex_same(text, tx_lean_false()) && !ex_same(text, tx_lean_none());
}

pub fn ex_bad_errs(bad: bool, why: List<usize>) -> List<List<usize>> {
    if (bad) {
        return single(why);
    }
    return empty();
}

pub fn ex_inline_arg(p: XParam, t: XTm, acc: XInlineArgs) -> XInlineArgs {
    let errs: List<List<usize>> = concat(acc.errs, concat(t.errs, ex_bad_errs(!ex_ty_same(ex_unboxed(t.ty), ex_unboxed(p.ty)), tx_err_inline())));
    if (ex_substitutable(t.text)) {
        return XInlineArgs { lets: acc.lets, env: cons(XBind { name: p.name, lname: t.text, ty: p.ty }, acc.env), names: acc.names, errs: errs };
    }
    let lname: List<usize> = ex_camel(p.name);
    let line: List<usize> = ex_flat(cons(tx_lean_let(), cons(lname, cons(tx_colon(), cons(ex_lean_type(64, p.ty), cons(tx_lean_assign(), single(ex_paren(t, 1))))))));
    return XInlineArgs { lets: concat(acc.lets, single(line)), env: cons(XBind { name: p.name, lname: lname, ty: p.ty }, acc.env),
        names: concat(acc.names, single(lname)), errs: errs };
}

pub fn ex_field_names(fields: List<XField>) -> List<List<usize>> {
    return match (fields) {
        Nil -> empty(),
        Cons(f, rest) -> cons(f.name, ex_field_names(unbox(rest))),
    };
}

pub fn ex_texts_same(a: List<List<usize>>, b: List<List<usize>>) -> bool {
    return match (a) {
        Nil -> length(b) == 0,
        Cons(x, rest) -> match (b) {
            Nil -> false,
            Cons(y, more) -> ex_same(x, y) && ex_texts_same(unbox(rest), unbox(more)),
        },
    };
}

pub fn ex_struct_part(fd: XField, v: XTm) -> XTm {
    return XTm { text: ex_flat(cons(ex_camel(fd.name), cons(tx_lean_assign(), single(ex_paren(v, 1))))), prec: 0, ty: fd.ty, errs: v.errs };
}

pub fn ex_tm_texts(ts: List<XTm>) -> List<List<usize>> {
    return match (ts) {
        Nil -> empty(),
        Cons(t, rest) -> cons(t.text, ex_tm_texts(unbox(rest))),
    };
}

pub fn ex_struct_with(cx: XCx, s: XStructD, names: List<List<usize>>, parts: List<XTm>, name: List<usize>) -> XTm {
    let text: List<usize> = ex_flat(cons(tx_lean_struct_open(), cons(ex_join(cons(44, single(32)), ex_tm_texts(parts)), cons(tx_lean_struct_close(), cons(name, single(single(41)))))));
    return ex_err_if(!ex_texts_same(names, ex_field_names(s.fields)), tx_err_struct(), XTm { text: text, prec: 1024, ty: ex_ty(name), errs: ex_all_errs(parts) });
}

pub fn ex_shift_width(ty: XTy) -> usize {
    if (ex_is_scalar(ty, tx_u32())) {
        return 32;
    }
    if (ex_is_scalar(ty, tx_u64())) {
        return 64;
    }
    return 0;
}

pub fn ex_word_op(op: List<usize>) -> bool {
    return ex_same(op, tx_op_plus()) || ex_same(op, tx_op_minus()) || ex_same(op, tx_op_times())
        || ex_same(op, tx_op_band()) || ex_same(op, tx_op_bor()) || ex_same(op, tx_op_xor());
}

pub fn ex_lean_word_op(op: List<usize>) -> List<usize> {
    if (ex_same(op, tx_op_band())) {
        return tx_lean_band();
    }
    if (ex_same(op, tx_op_bor())) {
        return tx_lean_bor();
    }
    if (ex_same(op, tx_op_xor())) {
        return tx_lean_xor();
    }
    return op;
}

// A comparison as a proposition: > and >= flip their operands.
pub fn ex_compare(op: List<usize>, a: XTm, b: XTm) -> XTm {
    let bool_ty: XTy = ex_ty(tx_bool());
    if (ex_same(op, tx_op_lt())) {
        return ex_lean_infix(tx_op_lt(), a, b, bool_ty);
    }
    if (ex_same(op, tx_op_le())) {
        return ex_lean_infix(tx_lean_le(), a, b, bool_ty);
    }
    if (ex_same(op, tx_op_gt())) {
        return ex_lean_infix(tx_op_lt(), b, a, bool_ty);
    }
    if (ex_same(op, tx_op_ge())) {
        return ex_lean_infix(tx_lean_le(), b, a, bool_ty);
    }
    if (ex_same(op, tx_op_eq())) {
        return ex_lean_infix(tx_lean_eq(), a, b, bool_ty);
    }
    return ex_lean_infix(tx_lean_ne(), a, b, bool_ty);
}

pub fn ex_to_nat(t: XTm) -> XTm {
    return XTm { text: concat(ex_paren(t, 1024), tx_lean_to_nat()), prec: 1024, ty: ex_ty(tx_usize()), errs: t.errs };
}

pub fn ex_cast_from(t: XTm, source: XTy, target: XTy) -> XTm {
    let usize_src: bool = ex_is_scalar(source, tx_usize());
    let i32_src: bool = ex_is_scalar(source, tx_i32());
    let u32_src: bool = ex_is_scalar(source, tx_u32());
    let u64_src: bool = ex_is_scalar(source, tx_u64());
    if (usize_src && ex_is_scalar(target, tx_i32())) {
        return ex_app(tx_lean_of_nat(), cons(ex_tm(tx_lean_32(), 1024, ex_none()), single(t)), ex_ty(tx_i32()));
    }
    if (usize_src && ex_is_scalar(target, tx_u64())) {
        return ex_app(tx_lean_of_nat(), cons(ex_tm(tx_lean_64(), 1024, ex_none()), single(t)), ex_ty(tx_u64()));
    }
    if (i32_src && ex_is_scalar(target, tx_u32())) {
        return ex_retyped(t, ex_ty(tx_u32()));
    }
    if (u32_src && ex_is_scalar(target, tx_u64())) {
        return ex_app(tx_lean_set_width(), cons(ex_tm(tx_lean_64(), 1024, ex_none()), single(t)), ex_ty(tx_u64()));
    }
    if (u32_src && ex_is_scalar(target, tx_usize())) {
        return ex_to_nat(t);
    }
    if (ex_is_scalar(source, tx_u8()) && ex_is_scalar(target, tx_i32())) {
        return ex_app(tx_lean_of_nat(), cons(ex_tm(tx_lean_32(), 1024, ex_none()), single(ex_to_nat(t))), ex_ty(tx_i32()));
    }
    if ((i32_src || u32_src || u64_src) && ex_is_scalar(target, tx_u8())) {
        return ex_app(tx_lean_uint8_of_nat(), single(ex_to_nat(t)), ex_ty(tx_u8()));
    }
    return ex_with_errs(t.errs, ex_fail(tx_err_cast()));
}

pub fn ex_arm_bad(acc: XArms) -> XArms {
    return XArms { lines: acc.lines, ty: acc.ty, seen: acc.seen, errs: concat(acc.errs, single(tx_err_match())) };
}

// An arm's path without the scrutinee's type in front.
pub fn ex_arm_path(path: List<List<usize>>, ty: XTy) -> List<List<usize>> {
    if (length(path) == 2 && ex_same(get_or(path, 0, empty()), ex_ty_name(ty))) {
        return single(get_or(path, 1, empty()));
    }
    return path;
}

pub fn ex_arm_text(arm: XTm, last: bool) -> List<usize> {
    if (arm.prec > 0 || last) {
        return arm.text;
    }
    return ex_paren(arm, 1);
}

pub fn ex_arm_result(in_block: bool, sofar: XTy, arm: XTy) -> XTy {
    if (in_block || !ex_is_none(sofar)) {
        return sofar;
    }
    return arm;
}

pub fn ex_assigned(lname: List<usize>, update: XTm, body: XTm, bad: bool) -> XTm {
    let text: List<usize> = ex_flat(cons(tx_lean_let(), cons(lname, cons(tx_lean_assign(), cons(ex_paren(update, 1), cons(single(10), single(body.text)))))));
    return ex_err_if(bad, tx_err_assign(), XTm { text: text, prec: 0, ty: ex_none(), errs: concat(update.errs, body.errs) });
}

pub fn ex_field_update(base: List<usize>, name: List<usize>, inner: XTm) -> XTm {
    let text: List<usize> = ex_flat(cons(cons(123, single(32)), cons(base, cons(tx_lean_with(), cons(ex_camel(name), cons(tx_lean_assign(), cons(ex_paren(inner, 1), single(cons(32, single(125))))))))));
    return XTm { text: text, prec: 1024, ty: inner.ty, errs: concat(ex_camel_errs(name), inner.errs) };
}

pub fn ex_else(has: bool, other: List<XE>, rest: List<XE>) -> List<XE> {
    if (has) {
        return other;
    }
    return rest;
}

pub fn ex_is_return_match(value: XE) -> bool {
    return match (value) {
        EInt(n) -> false,
        EBool(b) -> false,
        EName(path) -> false,
        ECall(path, args) -> false,
        EMethod(recv, name, args) -> false,
        EField(recv, name) -> false,
        EStruct(name, names, values) -> false,
        EBinary(op, l, r) -> false,
        ENot(x) -> false,
        ECast(x, t) -> false,
        EMatch(x, arms) -> ex_has_block_arm(unbox(arms)),
        EArm(path, binders, body) -> false,
        SBlock(stmts) -> false,
        SLet(name, t, v) -> false,
        SAssign(place, v) -> false,
        SCall(x) -> false,
        SMatch(x) -> false,
        SReturn(v) -> false,
        SIf(c, a, b, has) -> false,
        EBad(why) -> false,
    };
}

// ---------------------------------------------------------------- the translation

pub fn ex_bool_tm(b: bool) -> XTm {
    if (b) {
        return ex_tm(tx_lean_true(), 1024, ex_ty(tx_bool()));
    }
    return ex_tm(tx_lean_false(), 1024, ex_ty(tx_bool()));
}

pub fn ex_name_global(fuel: usize, cx: XCx, path: List<List<usize>>, first: List<usize>, expected: XTy) -> XTm {
    if (fuel == 0) {
        return ex_fail(tx_err_fuel());
    }
    if (length(path) == 1 && ex_same(first, tx_name_nil())) {
        return ex_err_if(!ex_is_named(ex_unboxed(expected), tx_list()), tx_err_name(), ex_tm(tx_lean_nil(), 1024, ex_unboxed(expected)));
    }
    if (length(path) == 1 && ex_same(first, tx_name_none())) {
        return ex_err_if(!ex_is_named(expected, tx_option()), tx_err_name(), ex_tm(tx_lean_none(), 1024, expected));
    }
    let r: XCtorRef = ex_ctor_ref(cx, path);
    return ex_with_errs(r.errs, ex_err_if(length(r.ctor.payload) != 0, tx_err_args(),
        ex_tm(ex_dot(r.enum_name, ex_lower_first(r.ctor.name)), 1024, ex_ty(r.enum_name))));
}

pub fn ex_name_tm(fuel: usize, cx: XCx, path: List<List<usize>>, env: List<XBind>, expected: XTy) -> XTm {
    if (fuel == 0) {
        return ex_fail(tx_err_fuel());
    }
    let first: List<usize> = get_or(path, 0, empty());
    if (length(path) == 1) {
        let found: core::option::Option<XBind> = ex_find_bind(env, first);
        return match (found) {
            None -> ex_name_global(minus(fuel, 1), cx, path, first, expected),
            Some(b) -> ex_tm(b.lname, 1024, b.ty),
        };
    }
    return ex_name_global(minus(fuel, 1), cx, path, first, expected);
}

// extract: mutual begin fuel
// The term of e and its type (extract.py's infer); expected is the type the
// context wants, or unknown.
pub fn ex_infer(fuel: usize, cx: XCx, e: XE, env: List<XBind>, expected: XTy) -> XTm {
    if (fuel == 0) {
        return ex_fail(tx_err_fuel());
    }
    return match (e) {
        EInt(n) -> ex_int(n, expected),
        EBool(b) -> ex_bool_tm(b),
        EName(path) -> ex_name_tm(minus(fuel, 1), cx, path, env, expected),
        ECall(path, args) -> ex_call(minus(fuel, 1), cx, path, unbox(args), env, expected),
        EMethod(recv, name, args) -> ex_method_tm(minus(fuel, 1), cx, unbox(recv), name, unbox(args), env),
        EField(recv, name) -> ex_field_tm(minus(fuel, 1), cx, unbox(recv), name, env),
        EStruct(name, names, values) -> ex_struct_tm(minus(fuel, 1), cx, name, names, unbox(values), env),
        EBinary(op, l, r) -> ex_binary(minus(fuel, 1), cx, op, unbox(l), unbox(r), env, expected),
        ENot(x) -> ex_not_tm(minus(fuel, 1), cx, unbox(x), env),
        ECast(x, t) -> ex_cast(minus(fuel, 1), cx, unbox(x), t, env),
        EMatch(x, arms) -> ex_match(minus(fuel, 1), cx, unbox(x), unbox(arms), env, expected, false, empty()),
        EArm(path, binders, body) -> ex_fail(tx_err_expr()),
        SBlock(stmts) -> ex_fail(tx_err_expr()),
        SLet(name, t, v) -> ex_fail(tx_err_expr()),
        SAssign(place, v) -> ex_fail(tx_err_expr()),
        SCall(x) -> ex_fail(tx_err_expr()),
        SMatch(x) -> ex_fail(tx_err_expr()),
        SReturn(v) -> ex_fail(tx_err_expr()),
        SIf(c, a, b, has) -> ex_fail(tx_err_expr()),
        EBad(why) -> ex_fail(why),
    };
}

// The term of e, which must have the expected type (extract.py's expr).
pub fn ex_expr(fuel: usize, cx: XCx, e: XE, env: List<XBind>, expected: XTy) -> XTm {
    if (fuel == 0) {
        return ex_fail(tx_err_fuel());
    }
    let t: XTm = ex_infer(minus(fuel, 1), cx, e, env, expected);
    return ex_err_if(!ex_is_none(expected) && !ex_ty_same(ex_unboxed(t.ty), ex_unboxed(expected)), tx_err_mismatch(), t);
}




// The arguments' terms, each of its parameter's type.
pub fn ex_args(fuel: usize, cx: XCx, tys: List<XTy>, args: List<XE>, env: List<XBind>) -> List<XTm> {
    if (fuel == 0) {
        return single(ex_fail(tx_err_fuel()));
    }
    return match (args) {
        Nil -> empty(),
        Cons(a, rest) -> cons(ex_expr(minus(fuel, 1), cx, a, env, get_or(tys, 0, ex_none())), ex_args(minus(fuel, 1), cx, ex_tail_tys(tys), unbox(rest), env)),
    };
}

pub fn ex_args_checked(fuel: usize, cx: XCx, tys: List<XTy>, args: List<XE>, env: List<XBind>) -> List<XTm> {
    if (fuel == 0) {
        return single(ex_fail(tx_err_fuel()));
    }
    if (length(tys) != length(args)) {
        return single(ex_fail(tx_err_args()));
    }
    return ex_args(minus(fuel, 1), cx, tys, args, env);
}

pub fn ex_call(fuel: usize, cx: XCx, path: List<List<usize>>, args: List<XE>, env: List<XBind>, expected: XTy) -> XTm {
    if (fuel == 0) {
        return ex_fail(tx_err_fuel());
    }
    let name: List<usize> = get_or(path, 0, empty());
    if (length(path) != 1) {
        return ex_call_ctor(minus(fuel, 1), cx, path, args, env);
    }
    if (ex_same(name, tx_name_some())) {
        if (length(args) != 1) {
            return ex_fail(tx_err_args());
        }
        let inner: XTy = ex_some_inner(expected);
        let t: XTm = ex_infer(minus(fuel, 1), cx, get_or(args, 0, EBad(tx_err_args())), env, inner);
        return ex_app(tx_lean_some(), single(t), ex_ty1(tx_option(), t.ty));
    }
    if (ex_same(name, tx_name_cons())) {
        if (length(args) != 2) {
            return ex_fail(tx_err_args());
        }
        let lst: XTy = ex_list_of(expected);
        let item: XTm = ex_infer(minus(fuel, 1), cx, get_or(args, 0, EBad(tx_err_args())), env, ex_list_elem(lst));
        let whole: XTy = ex_or_ty(lst, ex_ty1(tx_list(), item.ty));
        let rest: XTm = ex_expr(minus(fuel, 1), cx, get_or(args, 1, EBad(tx_err_args())), env, ex_ty1(tx_box(), whole));
        return ex_lean_infix(tx_lean_cons(), item, rest, whole);
    }
    let prelude: usize = ex_prelude_rule(name);
    if (prelude != 0) {
        return ex_rule_call(minus(fuel, 1), cx, name, prelude, args, env, expected);
    }
    let spec: usize = ex_spec_rule(name);
    if (spec != 0 && ex_is_spec(cx.current.name)) {
        if (!ex_same(name, cx.current.name)) {
            return ex_fail(tx_err_list_op());
        }
        return match (ex_find_fn(cx.fns, name)) {
            None -> ex_fail(tx_err_name()),
            Some(callee) -> ex_app(concat(tx_lean_lists(), ex_camel(name)), ex_args_checked(minus(fuel, 1), cx, ex_param_tys(callee.params), args, env), ex_ret_ty(callee)),
        };
    }
    if (spec != 0) {
        return ex_rule_call(minus(fuel, 1), cx, name, spec, args, env, expected);
    }
    return match (ex_find_fn(cx.fns, name)) {
        None -> ex_call_ctor(minus(fuel, 1), cx, path, args, env),
        Some(callee) -> ex_call_fn(minus(fuel, 1), cx, callee, args, env),
    };
}

pub fn ex_call_fn(fuel: usize, cx: XCx, callee: XFn, args: List<XE>, env: List<XBind>) -> XTm {
    if (fuel == 0) {
        return ex_fail(tx_err_fuel());
    }
    if (callee.inline) {
        return ex_inline(minus(fuel, 1), cx, callee, args, env);
    }
    return ex_app(ex_camel(callee.name), ex_args_checked(minus(fuel, 1), cx, ex_param_tys(callee.params), args, env), ex_ret_ty(callee));
}

pub fn ex_call_ctor(fuel: usize, cx: XCx, path: List<List<usize>>, args: List<XE>, env: List<XBind>) -> XTm {
    if (fuel == 0) {
        return ex_fail(tx_err_fuel());
    }
    let r: XCtorRef = ex_ctor_ref(cx, path);
    return ex_with_errs(r.errs, ex_app(ex_dot(r.enum_name, ex_lower_first(r.ctor.name)), ex_args_checked(minus(fuel, 1), cx, r.ctor.payload, args, env), ex_ty(r.enum_name)));
}

// The list and arithmetic rules (extract.py's rule_call).
pub fn ex_rule_call(fuel: usize, cx: XCx, name: List<usize>, rule: usize, args: List<XE>, env: List<XBind>, expected: XTy) -> XTm {
    if (fuel == 0) {
        return ex_fail(tx_err_fuel());
    }
    if (length(args) != ex_rule_arity(rule)) {
        return ex_fail(tx_err_args());
    }
    let a0: XE = get_or(args, 0, EBad(tx_err_args()));
    let a1: XE = get_or(args, 1, EBad(tx_err_args()));
    let elem: XTy = ex_rule_elem(expected);
    if (rule == 1) {
        if (ex_same(name, tx_name_boxed())) {
            let t: XTm = ex_infer(minus(fuel, 1), cx, a0, env, elem);
            return ex_retyped(t, ex_ty1(tx_box(), t.ty));
        }
        let t: XTm = ex_infer(minus(fuel, 1), cx, a0, env, ex_boxed_or_none(expected));
        return ex_err_if(!ex_is_named(t.ty, tx_box()), tx_err_mismatch(), ex_retyped(t, ex_ty_arg(t.ty)));
    }
    if (rule == 2) {
        return ex_err_if(!ex_is_named(expected, tx_list()), tx_err_mismatch(), ex_tm(tx_lean_nil(), 1024, expected));
    }
    if (rule == 3) {
        let t: XTm = ex_infer(minus(fuel, 1), cx, a0, env, elem);
        return XTm { text: cons(91, concat(ex_paren(t, 1), single(93))), prec: 1024, ty: ex_ty1(tx_list(), t.ty), errs: t.errs };
    }
    if (rule == 4) {
        let left: XTm = ex_infer(minus(fuel, 1), cx, a0, env, expected);
        let right: XTm = ex_expr(minus(fuel, 1), cx, a1, env, left.ty);
        return ex_err_if(!ex_is_named(left.ty, tx_list()), tx_err_mismatch(), ex_lean_infix(tx_lean_concat(), left, right, left.ty));
    }
    if (rule == 5) {
        let rest: XTm = ex_infer(minus(fuel, 1), cx, a1, env, expected);
        let item: XTm = ex_expr(minus(fuel, 1), cx, a0, env, ex_ty_arg(rest.ty));
        return ex_err_if(!ex_is_named(rest.ty, tx_list()), tx_err_mismatch(), ex_lean_infix(tx_lean_cons(), item, rest, rest.ty));
    }
    if (rule == 6) {
        let t: XTm = ex_infer(minus(fuel, 1), cx, a0, env, ex_none());
        return ex_err_if(!ex_is_named(t.ty, tx_list()), tx_err_mismatch(),
            XTm { text: concat(ex_paren(t, 1024), tx_lean_length()), prec: 1024, ty: ex_ty(tx_usize()), errs: t.errs });
    }
    if (rule == 7) {
        let t: XTm = ex_infer(minus(fuel, 1), cx, a0, env, ex_list_like(expected, ex_ty_arg(expected)));
        let index: XTm = ex_expr(minus(fuel, 1), cx, a1, env, ex_ty(tx_usize()));
        return XTm { text: ex_flat(cons(ex_paren(t, 1024), cons(single(91), cons(index.text, single(tx_lean_get_close()))))), prec: 1024,
            ty: ex_ty1(tx_option(), ex_ty_arg(t.ty)), errs: concat(t.errs, index.errs) };
    }
    if (rule == 8) {
        let t: XTm = ex_infer(minus(fuel, 1), cx, a0, env, ex_list_like(expected, expected));
        let index: XTm = ex_expr(minus(fuel, 1), cx, a1, env, ex_ty(tx_usize()));
        let fallback: XTm = ex_expr(minus(fuel, 1), cx, get_or(args, 2, EBad(tx_err_args())), env, ex_ty_arg(t.ty));
        return XTm { text: ex_flat(cons(ex_paren(t, 1024), cons(tx_lean_getd(), cons(ex_paren(index, 1024), cons(single(32), single(ex_paren(fallback, 1024))))))),
            prec: 1000, ty: ex_ty_arg(t.ty), errs: concat(t.errs, concat(index.errs, fallback.errs)) };
    }
    let a: XTm = ex_expr(minus(fuel, 1), cx, a0, env, ex_ty(tx_usize()));
    let b: XTm = ex_expr(minus(fuel, 1), cx, a1, env, ex_ty(tx_usize()));
    if (rule == 12) {
        return ex_app(tx_lean_max(), cons(a, single(b)), ex_ty(tx_usize()));
    }
    return ex_lean_infix(ex_rule_op(rule), a, b, ex_ty(tx_usize()));
}

// An inline function's call: its arguments bound by let (a name is
// substituted), then its body.
pub fn ex_inline(fuel: usize, cx: XCx, callee: XFn, args: List<XE>, env: List<XBind>) -> XTm {
    if (fuel == 0) {
        return ex_fail(tx_err_fuel());
    }
    if (length(args) != length(callee.params)) {
        return ex_fail(tx_err_args());
    }
    let bound: XInlineArgs = ex_inline_args(minus(fuel, 1), cx, callee.params, args, env, XInlineArgs { lets: empty(), env: empty(), names: empty(), errs: empty() });
    let clash: bool = ex_any_in(concat(ex_let_names(fuel, callee.body), bound.names), ex_lnames(env));
    let body: XTm = ex_block(minus(fuel, 1), cx, callee.body, bound.env, callee.ret);
    return ex_err_if(clash, tx_err_inline(), XTm { text: ex_join(single(10), concat(bound.lets, single(body.text))), prec: 0, ty: ex_ret_ty(callee), errs: concat(bound.errs, body.errs) });
}

pub fn ex_inline_args(fuel: usize, cx: XCx, params: List<XParam>, args: List<XE>, env: List<XBind>, acc: XInlineArgs) -> XInlineArgs {
    if (fuel == 0) {
        return acc;
    }
    return match (params) {
        Nil -> acc,
        Cons(p, rest) -> ex_inline_args(minus(fuel, 1), cx, unbox(rest), ex_tail_es(args), env,
            ex_inline_arg(p, ex_infer(minus(fuel, 1), cx, get_or(args, 0, EBad(tx_err_args())), env, p.ty), acc)),
    };
}

pub fn ex_method_tm(fuel: usize, cx: XCx, recv: XE, name: List<usize>, args: List<XE>, env: List<XBind>) -> XTm {
    if (fuel == 0) {
        return ex_fail(tx_err_fuel());
    }
    let r: XTm = ex_infer(minus(fuel, 1), cx, recv, env, ex_none());
    let rt: XTy = ex_unboxed(r.ty);
    return match (ex_find_method(cx.methods, ex_ty_name(rt), name)) {
        None -> ex_with_errs(r.errs, ex_fail(tx_err_method())),
        Some(m) -> ex_app(ex_dot(ex_ty_name(rt), ex_camel(name)), cons(r, ex_args_checked(minus(fuel, 1), cx, ex_tail_tys(ex_param_tys(m.params)), args, env)), ex_ret_ty(m)),
    };
}

pub fn ex_field_tm(fuel: usize, cx: XCx, recv: XE, name: List<usize>, env: List<XBind>) -> XTm {
    if (fuel == 0) {
        return ex_fail(tx_err_fuel());
    }
    let r: XTm = ex_infer(minus(fuel, 1), cx, recv, env, ex_none());
    return match (ex_field_ty(cx, ex_unboxed(r.ty), name)) {
        None -> ex_with_errs(r.errs, ex_fail(tx_err_field())),
        Some(t) -> XTm { text: ex_dot(ex_paren(r, 1024), ex_camel(name)), prec: 1024, ty: t, errs: r.errs },
    };
}

pub fn ex_struct_tm(fuel: usize, cx: XCx, name: List<usize>, names: List<List<usize>>, values: List<XE>, env: List<XBind>) -> XTm {
    if (fuel == 0) {
        return ex_fail(tx_err_fuel());
    }
    return match (ex_find_struct(cx.structs, name)) {
        None -> ex_fail(tx_err_struct()),
        Some(s) -> ex_struct_with(cx, s, names, ex_struct_parts(minus(fuel, 1), cx, s.fields, values, env), name),
    };
}

pub fn ex_struct_parts(fuel: usize, cx: XCx, fields: List<XField>, values: List<XE>, env: List<XBind>) -> List<XTm> {
    if (fuel == 0) {
        return single(ex_fail(tx_err_fuel()));
    }
    return match (fields) {
        Nil -> empty(),
        Cons(fd, rest) -> cons(ex_struct_part(fd, ex_expr(minus(fuel, 1), cx, get_or(values, 0, EBad(tx_err_struct())), env, fd.ty)),
            ex_struct_parts(minus(fuel, 1), cx, unbox(rest), ex_tail_es(values), env)),
    };
}

pub fn ex_binary(fuel: usize, cx: XCx, op: List<usize>, l: XE, r: XE, env: List<XBind>, expected: XTy) -> XTm {
    if (fuel == 0) {
        return ex_fail(tx_err_fuel());
    }
    if (ex_is_comparison(op)) {
        return ex_app(tx_lean_decide(), single(ex_comparison(minus(fuel, 1), cx, op, l, r, env)), ex_ty(tx_bool()));
    }
    if (ex_same(op, tx_op_and()) || ex_same(op, tx_op_or())) {
        return ex_lean_infix(op, ex_expr(minus(fuel, 1), cx, l, env, ex_ty(tx_bool())), ex_expr(minus(fuel, 1), cx, r, env, ex_ty(tx_bool())), ex_ty(tx_bool()));
    }
    let ty: XTy = ex_or_ty(ex_or_ty(ex_operand(minus(fuel, 1), cx, l, env), ex_operand(minus(fuel, 1), cx, r, env)), expected);
    if (ex_is_none(ty)) {
        return ex_fail(tx_err_op());
    }
    if (ex_same(op, tx_op_shr())) {
        let width: usize = ex_shift_width(ty);
        return match (ex_int_value(r)) {
            None -> ex_fail(tx_err_op()),
            Some(k) -> ex_err_if(width == 0 || k >= width, tx_err_op(), ex_lean_infix(tx_lean_shr(), ex_expr(minus(fuel, 1), cx, l, env, ty), ex_tm(ex_decimal(k), 1024, ty), ty)),
        };
    }
    if (ex_is_scalar(ty, tx_usize())) {
        if (ex_same(op, tx_op_div()) || ex_same(op, tx_op_mod())) {
            return ex_lean_infix(op, ex_expr(minus(fuel, 1), cx, l, env, ty), ex_expr(minus(fuel, 1), cx, r, env, ty), ty);
        }
        return ex_fail(tx_err_op());
    }
    if ((ex_is_scalar(ty, tx_i32()) || ex_is_scalar(ty, tx_u32()) || ex_is_scalar(ty, tx_u64())) && ex_word_op(op)) {
        return ex_lean_infix(ex_lean_word_op(op), ex_expr(minus(fuel, 1), cx, l, env, ty), ex_expr(minus(fuel, 1), cx, r, env, ty), ty);
    }
    return ex_fail(tx_err_op());
}

// The type of an operand that is not an integer literal (unknown for one).
pub fn ex_operand(fuel: usize, cx: XCx, e: XE, env: List<XBind>) -> XTy {
    if (fuel == 0) {
        return ex_none();
    }
    return match (ex_int_value(e)) {
        None -> ex_unboxed(ex_infer(minus(fuel, 1), cx, e, env, ex_none()).ty),
        Some(n) -> ex_none(),
    };
}

pub fn ex_comparison(fuel: usize, cx: XCx, op: List<usize>, l: XE, r: XE, env: List<XBind>) -> XTm {
    if (fuel == 0) {
        return ex_fail(tx_err_fuel());
    }
    let ty: XTy = ex_or_ty(ex_operand(minus(fuel, 1), cx, l, env), ex_operand(minus(fuel, 1), cx, r, env));
    if (ex_is_none(ty)) {
        return ex_fail(tx_err_op());
    }
    let a: XTm = ex_expr(minus(fuel, 1), cx, l, env, ty);
    let b: XTm = ex_expr(minus(fuel, 1), cx, r, env, ty);
    let ordered: bool = ex_is_scalar(ty, tx_usize()) || ex_is_scalar(ty, tx_u32()) || ex_is_scalar(ty, tx_u64()) || ex_is_scalar(ty, tx_u8());
    return ex_err_if(!ordered, tx_err_op(), ex_compare(op, a, b));
}

pub fn ex_not_tm(fuel: usize, cx: XCx, x: XE, env: List<XBind>) -> XTm {
    if (fuel == 0) {
        return ex_fail(tx_err_fuel());
    }
    let t: XTm = ex_expr(minus(fuel, 1), cx, x, env, ex_ty(tx_bool()));
    return XTm { text: cons(33, ex_paren(t, 1024)), prec: 1000, ty: ex_ty(tx_bool()), errs: t.errs };
}

pub fn ex_cast(fuel: usize, cx: XCx, x: XE, target: XTy, env: List<XBind>) -> XTm {
    if (fuel == 0) {
        return ex_fail(tx_err_fuel());
    }
    let t: XTm = ex_infer(minus(fuel, 1), cx, x, env, ex_none());
    return ex_cast_from(t, ex_unboxed(t.ty), target);
}

// A match expression, or with in_block a match whose arms return from a
// function with result ret (extract.py's match with ret_block).
pub fn ex_match(fuel: usize, cx: XCx, scrut: XE, arms: List<XE>, env: List<XBind>, expected: XTy, in_block: bool, ret: List<XTy>) -> XTm {
    if (fuel == 0) {
        return ex_fail(tx_err_fuel());
    }
    let t: XTm = ex_infer(minus(fuel, 1), cx, scrut, env, ex_none());
    let ty: XTy = ex_unboxed(t.ty);
    let shapes: XShapes = ex_shapes_of(cx, ty);
    if (shapes.kind == 0) {
        return ex_with_errs(t.errs, ex_fail(tx_err_match()));
    }
    let done: XArms = ex_arms(minus(fuel, 1), cx, arms, 0, length(arms), shapes, ty, env, in_block, ret,
        XArms { lines: empty(), ty: expected, seen: empty(), errs: empty() });
    let text: List<usize> = ex_flat(cons(tx_lean_match(), cons(ex_paren(t, 1), cons(tx_lean_match_with(), single(ex_join(single(10), done.lines))))));
    return ex_err_if(!ex_all_seen(shapes.names, done.seen), tx_err_match(), XTm { text: text, prec: 0, ty: done.ty, errs: concat(t.errs, done.errs) });
}

pub fn ex_arms(fuel: usize, cx: XCx, arms: List<XE>, index: usize, count: usize, shapes: XShapes, ty: XTy, env: List<XBind>, in_block: bool, ret: List<XTy>, acc: XArms) -> XArms {
    if (fuel == 0) {
        return acc;
    }
    return match (arms) {
        Nil -> acc,
        Cons(a, rest) -> ex_arms(minus(fuel, 1), cx, unbox(rest), plus(index, 1), count, shapes, ty, env, in_block, ret,
            ex_arm(minus(fuel, 1), cx, a, plus(index, 1) == count, shapes, ty, env, in_block, ret, acc)),
    };
}

pub fn ex_arm(fuel: usize, cx: XCx, a: XE, last: bool, shapes: XShapes, ty: XTy, env: List<XBind>, in_block: bool, ret: List<XTy>, acc: XArms) -> XArms {
    if (fuel == 0) {
        return acc;
    }
    return match (a) {
        EInt(n) -> ex_arm_bad(acc),
        EBool(b) -> ex_arm_bad(acc),
        EName(path) -> ex_arm_bad(acc),
        ECall(path, args) -> ex_arm_bad(acc),
        EMethod(recv, name, args) -> ex_arm_bad(acc),
        EField(recv, name) -> ex_arm_bad(acc),
        EStruct(name, names, values) -> ex_arm_bad(acc),
        EBinary(op, l, r) -> ex_arm_bad(acc),
        ENot(x) -> ex_arm_bad(acc),
        ECast(x, t) -> ex_arm_bad(acc),
        EMatch(x, arms) -> ex_arm_bad(acc),
        EArm(path, binders, body) -> ex_arm_of(minus(fuel, 1), cx, ex_arm_path(path, ty), binders, unbox(body), last, shapes, env, in_block, ret, acc),
        SBlock(stmts) -> ex_arm_bad(acc),
        SLet(name, t, v) -> ex_arm_bad(acc),
        SAssign(place, v) -> ex_arm_bad(acc),
        SCall(x) -> ex_arm_bad(acc),
        SMatch(x) -> ex_arm_bad(acc),
        SReturn(v) -> ex_arm_bad(acc),
        SIf(c, a2, b, has) -> ex_arm_bad(acc),
        EBad(why) -> ex_arm_bad(acc),
    };
}

pub fn ex_arm_of(fuel: usize, cx: XCx, path: List<List<usize>>, binders: List<List<usize>>, body: XE, last: bool, shapes: XShapes, env: List<XBind>, in_block: bool, ret: List<XTy>, acc: XArms) -> XArms {
    if (fuel == 0) {
        return acc;
    }
    let ctor: List<usize> = ex_last_text(path);
    let k: usize = ex_index_of(shapes.names, ctor, 0);
    let known: bool = length(path) == 1 && k < length(shapes.names);
    let shape_ok: bool = known && !ex_has_text(acc.seen, ctor) && length(binders) == get_or(shapes.counts, k, 0);
    let inner: List<XBind> = ex_bind_binders(binders, get_or(shapes.payloads, k, empty()), env);
    let arm: XTm = ex_arm_term(minus(fuel, 1), cx, body, inner, in_block, ret, acc.ty);
    let fits: bool = in_block || ex_is_none(acc.ty) || ex_ty_same(ex_unboxed(arm.ty), ex_unboxed(acc.ty));
    let text: List<usize> = ex_arm_text(arm, last);
    let line: List<usize> = ex_arm_line(ex_pattern(shapes.kind, ctor, ex_binder_lnames(binders)), text);
    let errs: List<List<usize>> = ex_bad_errs(!(shape_ok && fits), tx_err_match());
    return XArms { lines: concat(acc.lines, single(line)), ty: ex_arm_result(in_block, acc.ty, arm.ty), seen: concat(acc.seen, single(ctor)),
        errs: concat(acc.errs, concat(arm.errs, errs)) };
}

pub fn ex_arm_term(fuel: usize, cx: XCx, body: XE, inner: List<XBind>, in_block: bool, ret: List<XTy>, result: XTy) -> XTm {
    if (fuel == 0) {
        return ex_fail(tx_err_fuel());
    }
    if (in_block) {
        return ex_block(minus(fuel, 1), cx, ex_arm_stmts(body), inner, ret);
    }
    if (ex_is_block(body)) {
        return ex_fail(tx_err_match());
    }
    return ex_infer(minus(fuel, 1), cx, body, inner, result);
}

// The term of a block of statements that returns (extract.py's block).
pub fn ex_block(fuel: usize, cx: XCx, stmts: List<XE>, env: List<XBind>, ret: List<XTy>) -> XTm {
    if (fuel == 0) {
        return ex_fail(tx_err_fuel());
    }
    return match (stmts) {
        Nil -> ex_fail(tx_err_return()),
        Cons(s, rest) -> ex_stmt(minus(fuel, 1), cx, s, unbox(rest), env, ret),
    };
}

pub fn ex_stmt(fuel: usize, cx: XCx, s: XE, rest: List<XE>, env: List<XBind>, ret: List<XTy>) -> XTm {
    if (fuel == 0) {
        return ex_fail(tx_err_fuel());
    }
    let more: bool = length(rest) != 0;
    return match (s) {
        EInt(n) -> ex_fail(tx_err_stmt()),
        EBool(b) -> ex_fail(tx_err_stmt()),
        EName(path) -> ex_fail(tx_err_stmt()),
        ECall(path, args) -> ex_fail(tx_err_stmt()),
        EMethod(recv, name, args) -> ex_fail(tx_err_stmt()),
        EField(recv, name) -> ex_fail(tx_err_stmt()),
        EStruct(name, names, values) -> ex_fail(tx_err_stmt()),
        EBinary(op, l, r) -> ex_fail(tx_err_stmt()),
        ENot(x) -> ex_fail(tx_err_stmt()),
        ECast(x, t) -> ex_fail(tx_err_stmt()),
        EMatch(x, arms) -> ex_fail(tx_err_stmt()),
        EArm(path, binders, body) -> ex_fail(tx_err_stmt()),
        SBlock(stmts) -> ex_fail(tx_err_stmt()),
        SLet(name, t, v) -> ex_let(minus(fuel, 1), cx, name, t, unbox(v), rest, env, ret),
        SAssign(place, v) -> ex_assign(minus(fuel, 1), cx, unbox(place), unbox(v), rest, env, ret),
        SCall(x) -> ex_fail(tx_err_mut()),
        SMatch(x) -> ex_err_if(more, tx_err_unreachable(), ex_match_stmt(minus(fuel, 1), cx, unbox(x), env, ret)),
        SReturn(v) -> ex_err_if(more, tx_err_unreachable(), ex_return(minus(fuel, 1), cx, unbox(v), env, ret)),
        SIf(c, a, b, has) -> ex_err_if(has && more, tx_err_unreachable(), ex_if(minus(fuel, 1), cx, unbox(c), unbox(a), ex_else(has, unbox(b), rest), env, ret)),
        EBad(why) -> ex_fail(why),
    };
}

pub fn ex_let(fuel: usize, cx: XCx, name: List<usize>, ty: XTy, value: XE, rest: List<XE>, env: List<XBind>, ret: List<XTy>) -> XTm {
    if (fuel == 0) {
        return ex_fail(tx_err_fuel());
    }
    let lname: List<usize> = ex_camel(name);
    let v: XTm = ex_expr(minus(fuel, 1), cx, value, env, ty);
    let body: XTm = ex_block(minus(fuel, 1), cx, rest, cons(XBind { name: name, lname: lname, ty: ty }, env), ret);
    let text: List<usize> = ex_flat(cons(tx_lean_let(), cons(lname, cons(tx_colon(), cons(ex_lean_type(64, ty), cons(tx_lean_assign(), cons(ex_paren(v, 1), cons(single(10), single(body.text)))))))));
    return XTm { text: text, prec: 0, ty: ex_none(), errs: concat(ex_camel_errs(name), concat(v.errs, body.errs)) };
}

pub fn ex_assign(fuel: usize, cx: XCx, place: XE, value: XE, rest: List<XE>, env: List<XBind>, ret: List<XTy>) -> XTm {
    if (fuel == 0) {
        return ex_fail(tx_err_fuel());
    }
    let p: XPlace = ex_place(place, empty());
    let target: core::option::Option<XBind> = ex_find_bind(env, get_or(p.name, 0, empty()));
    let body: XTm = ex_block(minus(fuel, 1), cx, rest, env, ret);
    return match (target) {
        None -> ex_with_errs(body.errs, ex_fail(tx_err_assign())),
        Some(b) -> ex_assigned(b.lname, ex_assign_chain(minus(fuel, 1), cx, b.lname, b.ty, p.fields, value, env), body, length(p.name) != 1),
    };
}

// The new value of base after `base.fields = value`.
pub fn ex_assign_chain(fuel: usize, cx: XCx, base: List<usize>, ty: XTy, fields: List<List<usize>>, value: XE, env: List<XBind>) -> XTm {
    if (fuel == 0) {
        return ex_fail(tx_err_fuel());
    }
    return match (fields) {
        Nil -> ex_expr(minus(fuel, 1), cx, value, env, ty),
        Cons(name, rest) -> ex_assign_field(minus(fuel, 1), base, name, ex_field_ty(cx, ex_unboxed(ty), name), cx, unbox(rest), value, env),
    };
}

pub fn ex_assign_field(fuel: usize, base: List<usize>, name: List<usize>, fty: core::option::Option<XTy>, cx: XCx, rest: List<List<usize>>, value: XE, env: List<XBind>) -> XTm {
    if (fuel == 0) {
        return ex_fail(tx_err_fuel());
    }
    return match (fty) {
        None -> ex_fail(tx_err_field()),
        Some(t) -> ex_field_update(base, name, ex_assign_chain(minus(fuel, 1), cx, ex_dot(base, ex_camel(name)), t, rest, value, env)),
    };
}

pub fn ex_match_stmt(fuel: usize, cx: XCx, e: XE, env: List<XBind>, ret: List<XTy>) -> XTm {
    if (fuel == 0) {
        return ex_fail(tx_err_fuel());
    }
    return match (e) {
        EInt(n) -> ex_fail(tx_err_stmt()),
        EBool(b) -> ex_fail(tx_err_stmt()),
        EName(path) -> ex_fail(tx_err_stmt()),
        ECall(path, args) -> ex_fail(tx_err_stmt()),
        EMethod(recv, name, args) -> ex_fail(tx_err_stmt()),
        EField(recv, name) -> ex_fail(tx_err_stmt()),
        EStruct(name, names, values) -> ex_fail(tx_err_stmt()),
        EBinary(op, l, r) -> ex_fail(tx_err_stmt()),
        ENot(x) -> ex_fail(tx_err_stmt()),
        ECast(x, t) -> ex_fail(tx_err_stmt()),
        EMatch(x, arms) -> ex_match(minus(fuel, 1), cx, unbox(x), unbox(arms), env, ex_none(), true, ret),
        EArm(path, binders, body) -> ex_fail(tx_err_stmt()),
        SBlock(stmts) -> ex_fail(tx_err_stmt()),
        SLet(name, t, v) -> ex_fail(tx_err_stmt()),
        SAssign(place, v) -> ex_fail(tx_err_stmt()),
        SCall(x) -> ex_fail(tx_err_stmt()),
        SMatch(x) -> ex_fail(tx_err_stmt()),
        SReturn(v) -> ex_fail(tx_err_stmt()),
        SIf(c, a, b, has) -> ex_fail(tx_err_stmt()),
        EBad(why) -> ex_fail(why),
    };
}

pub fn ex_return(fuel: usize, cx: XCx, values: List<XE>, env: List<XBind>, ret: List<XTy>) -> XTm {
    if (fuel == 0) {
        return ex_fail(tx_err_fuel());
    }
    if (length(values) != length(ret) || length(values) != 1) {
        return ex_fail(tx_err_unit());
    }
    let value: XE = get_or(values, 0, EBad(tx_err_unit()));
    if (ex_is_return_match(value)) {
        return ex_match_stmt(minus(fuel, 1), cx, value, env, ret);
    }
    return ex_expr(minus(fuel, 1), cx, value, env, get_or(ret, 0, ex_none()));
}

pub fn ex_if(fuel: usize, cx: XCx, cond: XE, yes: List<XE>, no: List<XE>, env: List<XBind>, ret: List<XTy>) -> XTm {
    if (fuel == 0) {
        return ex_fail(tx_err_fuel());
    }
    let c: XTm = ex_condition(minus(fuel, 1), cx, cond, env);
    let a: XTm = ex_block(minus(fuel, 1), cx, yes, env, ret);
    let b: XTm = ex_block(minus(fuel, 1), cx, no, env, ret);
    let pad: List<usize> = cons(32, single(32));
    let text: List<usize> = ex_flat(cons(tx_lean_if(), cons(c.text, cons(tx_lean_then(), cons(ex_indent(a.text, pad), cons(tx_lean_else(), single(ex_indent(b.text, pad))))))));
    return XTm { text: text, prec: 0, ty: ex_none(), errs: concat(c.errs, concat(a.errs, b.errs)) };
}

// An if condition: a comparison stays a proposition, another bool is tested.
pub fn ex_condition(fuel: usize, cx: XCx, cond: XE, env: List<XBind>) -> XTm {
    if (fuel == 0) {
        return ex_fail(tx_err_fuel());
    }
    return match (cond) {
        EInt(n) -> ex_expr(minus(fuel, 1), cx, cond, env, ex_ty(tx_bool())),
        EBool(b) -> ex_expr(minus(fuel, 1), cx, cond, env, ex_ty(tx_bool())),
        EName(path) -> ex_expr(minus(fuel, 1), cx, cond, env, ex_ty(tx_bool())),
        ECall(path, args) -> ex_expr(minus(fuel, 1), cx, cond, env, ex_ty(tx_bool())),
        EMethod(recv, name, args) -> ex_expr(minus(fuel, 1), cx, cond, env, ex_ty(tx_bool())),
        EField(recv, name) -> ex_expr(minus(fuel, 1), cx, cond, env, ex_ty(tx_bool())),
        EStruct(name, names, values) -> ex_expr(minus(fuel, 1), cx, cond, env, ex_ty(tx_bool())),
        EBinary(op, l, r) -> ex_condition_binary(minus(fuel, 1), cx, cond, op, unbox(l), unbox(r), env),
        ENot(x) -> ex_expr(minus(fuel, 1), cx, cond, env, ex_ty(tx_bool())),
        ECast(x, t) -> ex_expr(minus(fuel, 1), cx, cond, env, ex_ty(tx_bool())),
        EMatch(x, arms) -> ex_expr(minus(fuel, 1), cx, cond, env, ex_ty(tx_bool())),
        EArm(path, binders, body) -> ex_expr(minus(fuel, 1), cx, cond, env, ex_ty(tx_bool())),
        SBlock(stmts) -> ex_expr(minus(fuel, 1), cx, cond, env, ex_ty(tx_bool())),
        SLet(name, t, v) -> ex_expr(minus(fuel, 1), cx, cond, env, ex_ty(tx_bool())),
        SAssign(place, v) -> ex_expr(minus(fuel, 1), cx, cond, env, ex_ty(tx_bool())),
        SCall(x) -> ex_expr(minus(fuel, 1), cx, cond, env, ex_ty(tx_bool())),
        SMatch(x) -> ex_expr(minus(fuel, 1), cx, cond, env, ex_ty(tx_bool())),
        SReturn(v) -> ex_expr(minus(fuel, 1), cx, cond, env, ex_ty(tx_bool())),
        SIf(c, a, b, has) -> ex_expr(minus(fuel, 1), cx, cond, env, ex_ty(tx_bool())),
        EBad(why) -> ex_fail(why),
    };
}

pub fn ex_condition_binary(fuel: usize, cx: XCx, cond: XE, op: List<usize>, l: XE, r: XE, env: List<XBind>) -> XTm {
    if (fuel == 0) {
        return ex_fail(tx_err_fuel());
    }
    if (ex_is_comparison(op)) {
        return ex_comparison(minus(fuel, 1), cx, op, l, r, env);
    }
    return ex_expr(minus(fuel, 1), cx, cond, env, ex_ty(tx_bool()));
}
// extract: mutual end

// ---------------------------------------------------------------- definitions

// text type_open "{"
// text spec_theorem "\ntheorem "
// text spec_spec "_spec "
// text spec_proves " :=\n  "
// text spec_empty "{T : Type} : (Lists.empty : List T) = []"
// text spec_single "{T : Type} (item : T) : Lists.single item = [item]"
// text spec_cons "{T : Type} (item : T) (rest : List T) : Lists.cons item rest = item :: rest"
// text spec_concat "{T : Type} (first second : List T) : Lists.concat first second = first ++ second"
// text spec_length "{T : Type} (items : List T) : Lists.length items = items.length"
// text spec_get "{T : Type} (items : List T) (index : Nat) : Lists.get items index = items[index]?"
// text spec_get_or "{T : Type} (items : List T) (index : Nat) (fallback : T) :\n    Lists.getOr items index fallback = items.getD index fallback"
// text proof_rfl "rfl"
// text proof_concat "by induction first <;> simp_all [Lists.concat]"
// text proof_length "by induction items <;> simp_all [Lists.length]"
// text proof_get "by induction items generalizing index <;> cases index <;> simp_all [Lists.get]"
// text proof_get_or "by induction items generalizing index <;> cases index <;> simp_all [Lists.getOr]"
// text def_tail " :="
// text mutual_open "mutual\n"
// text mutual_close "end\n"
// text dot_p ".P."
// text expose_mark "@[expose]"
// text import_ "import "
// text header_a "/-! Generated by formal/tools/extract.py from "
// text header_b ". Do not edit.\n\nShallow extraction: each Lanius function is the Lean definition of the same\nname (snake_case becomes camelCase, methods become `Type.method`, list\noperations become `Lists.name` with a spec theorem). `usize` is `Nat`, `i32` is\n`BitVec 32`, `u8` is `UInt8`, `List<T>` is `List T`, `Box<T>` is `T`. The\nprelude's `plus`/`minus`/`times` panic instead of wrapping, so they are\n`+`/`-`/`*` on `Nat` for every run that returns.\n\nThe definitions are in "
// text header_c " parts, `.P0` on, in source order, whose bodies\nare hidden from other modules: a proof that unfolds one imports its part with\n`import all`, so that it is rebuilt only when that part changes. -/\n"
// text end_lanius "end Lanius.Mini\n"
// text err_inline_method "inline methods are not supported"

pub struct XParamsOut {
    env: List<XBind>,
    binders: List<List<usize>>,
    errs: List<List<usize>>,
}

pub fn ex_keyword_errs(check: bool, name: List<usize>) -> List<List<usize>> {
    if (check) {
        return ex_camel_errs(name);
    }
    return empty();
}

pub fn ex_param_lname(keyword: bool, name: List<usize>) -> List<usize> {
    if (keyword) {
        return concat(name, single(95));
    }
    return ex_camel(name);
}

pub fn ex_fn_param(p: XParam, kw: bool, acc: XParamsOut) -> XParamsOut {
    let keyword: bool = kw && ex_is_keyword(p.name);
    let lname: List<usize> = ex_param_lname(keyword, p.name);
    let binder: List<usize> = ex_flat(cons(single(40), cons(lname, cons(tx_colon(), cons(ex_lean_type(64, p.ty), single(single(41)))))));
    let errs: List<List<usize>> = ex_keyword_errs(!keyword, p.name);
    return XParamsOut { env: cons(XBind { name: p.name, lname: lname, ty: ex_value(p.ty) }, acc.env), binders: concat(acc.binders, single(binder)), errs: concat(acc.errs, errs) };
}

pub fn ex_fn_params(params: List<XParam>, kw: bool, acc: XParamsOut) -> XParamsOut {
    return match (params) {
        Nil -> acc,
        Cons(p, rest) -> ex_fn_params(unbox(rest), kw, ex_fn_param(p, kw, acc)),
    };
}

pub fn ex_tparam_binders(tparams: List<List<usize>>) -> List<List<usize>> {
    return match (tparams) {
        Nil -> empty(),
        Cons(t, rest) -> cons(ex_flat(cons(tx_type_open(), cons(t, single(tx_lean_type_binder())))), ex_tparam_binders(unbox(rest))),
    };
}

pub fn ex_doc_lead(docs: List<List<usize>>) -> List<usize> {
    if (length(docs) == 0) {
        return empty();
    }
    return concat(ex_join(single(10), docs), single(10));
}

// The definition of f named lean_name (extract.py's emit_fn); with kw its
// parameters may be Lean keywords.
pub fn ex_emit_fn(fuel: usize, cx: XCx, f: XFn, lean_name: List<usize>, kw: bool) -> XTm {
    let here: XCx = XCx { structs: cx.structs, enums: cx.enums, fns: cx.fns, methods: cx.methods, current: f };
    let ps: XParamsOut = ex_fn_params(f.params, kw, XParamsOut { env: empty(), binders: empty(), errs: empty() });
    let body: XTm = ex_block(fuel, here, f.body, ps.env, f.ret);
    let binders: List<List<usize>> = concat(ex_tparam_binders(f.tparams), ps.binders);
    let head: List<usize> = ex_flat(cons(ex_join(single(32), cons(concat(tx_lean_def(), lean_name), binders)), cons(tx_colon(), cons(ex_lean_type(64, ex_ret_ty(f)), single(tx_def_tail())))));
    let docs: List<List<usize>> = ex_doc(f.doc, empty());
    let lead: List<usize> = ex_doc_lead(docs);
    let text: List<usize> = ex_flat(cons(lead, cons(head, cons(cons(10, cons(32, single(32))), cons(ex_indent(body.text, cons(32, single(32))), single(single(10)))))));
    return XTm { text: text, prec: 0, ty: ex_none(), errs: concat(ex_bad_errs(length(f.ret) == 0, tx_err_unit()), concat(ps.errs, body.errs)) };
}

// text with `@[expose] ` before its first line that starts with `def `.
pub fn ex_expose(text: List<usize>, start: bool) -> List<usize> {
    return match (text) {
        Nil -> empty(),
        Cons(c, rest) -> ex_expose_at(start && ex_starts(tx_lean_def(), text), c, unbox(rest), text),
    };
}

// extract: inline
fn ex_expose_at(ehere: bool, ec: usize, erest: List<usize>, etext: List<usize>) -> List<usize> {
    if (ehere) {
        return concat(tx_lean_expose(), etext);
    }
    return cons(ec, ex_expose(erest, ec == 10));
}

pub fn ex_spec_statement(name: List<usize>) -> List<usize> {
    let rule: usize = ex_spec_rule(name);
    if (rule == 2) {
        return tx_spec_empty();
    }
    if (rule == 3) {
        return tx_spec_single();
    }
    if (rule == 5) {
        return tx_spec_cons();
    }
    if (rule == 4) {
        return tx_spec_concat();
    }
    if (rule == 6) {
        return tx_spec_length();
    }
    if (rule == 7) {
        return tx_spec_get();
    }
    return tx_spec_get_or();
}

pub fn ex_spec_proof(name: List<usize>) -> List<usize> {
    let rule: usize = ex_spec_rule(name);
    if (rule == 4) {
        return tx_proof_concat();
    }
    if (rule == 6) {
        return tx_proof_length();
    }
    if (rule == 7) {
        return tx_proof_get();
    }
    if (rule == 8) {
        return tx_proof_get_or();
    }
    return tx_proof_rfl();
}

// A unit of a part: one definition, or a mutual block.
pub struct XUnit {
    names: List<List<usize>>,
    text: List<usize>,
}

// Walking the items: the units so far, the mutual block being read, errors.
pub struct XWalk {
    units: List<XUnit>,
    in_mutual: bool,
    // whether the block is `mutual begin fuel`
    fuel: bool,
    names: List<List<usize>>,
    texts: List<List<usize>>,
    errs: List<List<usize>>,
}

// text fuel "fuel"
// text termination_fuel "termination_by fuel\n"
// The text when b holds, else nothing.
pub fn ex_text_if(b: bool, text: List<usize>) -> List<usize> {
    if (b) {
        return text;
    }
    return empty();
}

pub fn ex_add_def(w: XWalk, name: List<usize>, t: XTm) -> XWalk {
    if (w.in_mutual) {
        return XWalk { units: w.units, in_mutual: true, fuel: w.fuel, names: concat(w.names, single(name)), texts: concat(w.texts, single(concat(t.text, ex_text_if(w.fuel, tx_termination_fuel())))), errs: concat(w.errs, t.errs) };
    }
    return XWalk { units: concat(w.units, single(XUnit { names: single(name), text: t.text })), in_mutual: false, fuel: false, names: w.names, texts: w.texts, errs: concat(w.errs, t.errs) };
}

pub fn ex_mutual_mark(w: XWalk, begin: bool, fuel: bool) -> XWalk {
    if (begin) {
        return XWalk { units: w.units, in_mutual: true, fuel: fuel, names: empty(), texts: empty(), errs: concat(w.errs, ex_bad_errs(w.in_mutual, tx_err_marker())) };
    }
    let unit: XUnit = XUnit { names: w.names, text: concat(tx_mutual_open(), concat(ex_flat(w.texts), tx_mutual_close())) };
    return XWalk { units: concat(w.units, single(unit)), in_mutual: false, fuel: false, names: empty(), texts: empty(), errs: concat(w.errs, ex_bad_errs(!w.in_mutual, tx_err_marker())) };
}

pub fn ex_walk_fn(fuel: usize, cx: XCx, w: XWalk, f: XFn) -> XWalk {
    if (ex_is_spec(f.name)) {
        let name: List<usize> = concat(tx_lean_lists(), ex_camel(f.name));
        let t: XTm = ex_emit_fn(fuel, cx, f, name, false);
        let text: List<usize> = ex_flat(cons(ex_expose(t.text, true), cons(tx_spec_theorem(), cons(name, cons(tx_spec_spec(), cons(ex_spec_statement(f.name), cons(tx_spec_proves(), cons(ex_spec_proof(f.name), single(single(10))))))))));
        return ex_add_def(w, name, XTm { text: text, prec: 0, ty: t.ty, errs: t.errs });
    }
    if (f.inline) {
        let name: List<usize> = concat(tx_lean_inline(), ex_camel(f.name));
        let t: XTm = ex_emit_fn(fuel, cx, f, name, true);
        return ex_add_def(w, name, XTm { text: ex_expose(t.text, true), prec: 0, ty: t.ty, errs: t.errs });
    }
    return ex_add_def(w, ex_camel(f.name), ex_with_errs(ex_camel_errs(f.name), ex_emit_fn(fuel, cx, f, ex_camel(f.name), false)));
}

pub fn ex_walk_methods(fuel: usize, cx: XCx, w: XWalk, owner: List<usize>, fns: List<XFn>) -> XWalk {
    return match (fns) {
        Nil -> w,
        Cons(f, rest) -> ex_walk_methods(fuel, cx, ex_add_def(w, ex_dot(owner, ex_camel(f.name)),
            ex_err_if(f.inline, tx_err_inline_method(), ex_with_errs(ex_camel_errs(f.name), ex_emit_fn(fuel, cx, f, ex_dot(owner, ex_camel(f.name)), false)))), owner, unbox(rest)),
    };
}

pub fn ex_walk_if(outside: bool, w: XWalk, walked: XWalk) -> XWalk {
    if (outside) {
        return w;
    }
    return walked;
}

pub fn ex_walk_at(fuel: usize, cx: XCx, a: XAt, w: XWalk) -> XWalk {
    if (a.prelude) {
        return w;
    }
    let outside: bool = length(a.external) != 0;
    return match (a.item) {
        IStruct(name, tparams, fields) -> w,
        IEnum(name, tparams, ctors) -> w,
        IFn(f) -> ex_walk_if(outside, w, ex_walk_fn(fuel, cx, w, f)),
        IImpl(name, fns) -> ex_walk_if(outside, w, ex_walk_methods(fuel, cx, w, name, fns)),
        IMutual(begin, fuel) -> ex_mutual_mark(w, begin, fuel),
        IExternal(m, p) -> w,
        IPreludeEnd -> w,
        IBad(why) -> XWalk { units: w.units, in_mutual: w.in_mutual, fuel: w.fuel, names: w.names, texts: w.texts, errs: concat(w.errs, single(why)) },
    };
}

pub fn ex_walk(fuel: usize, cx: XCx, ats: List<XAt>, w: XWalk) -> XWalk {
    return match (ats) {
        Nil -> w,
        Cons(a, rest) -> ex_walk(fuel, cx, unbox(rest), ex_walk_at(fuel, cx, a, w)),
    };
}

pub fn ex_is_inline_unit(u: XUnit) -> bool {
    return ex_starts(tx_lean_inline(), get_or(u.names, 0, empty()));
}

pub fn ex_unit_if(keep: bool, u: XUnit) -> List<XUnit> {
    if (keep) {
        return single(u);
    }
    return empty();
}

// The units with the inline functions last (their bodies name later definitions).
pub fn ex_units_kept(units: List<XUnit>, inline: bool) -> List<XUnit> {
    return match (units) {
        Nil -> empty(),
        Cons(u, rest) -> concat(ex_unit_if((ex_is_inline_unit(u) && inline) || (!ex_is_inline_unit(u) && !inline), u), ex_units_kept(unbox(rest), inline)),
    };
}

// ---------------------------------------------------------------- parts

// zlib's CRC-32 of a text.
pub fn ex_crc_bit(c: u32) -> u32 {
    if ((c & 1) == 1) {
        return (c >> 1) ^ 3988292384;
    }
    return c >> 1;
}

pub fn ex_crc_byte(c: u32, b: usize) -> u32 {
    let x: u32 = c ^ ((b as i32) as u32);
    return ex_crc_bit(ex_crc_bit(ex_crc_bit(ex_crc_bit(ex_crc_bit(ex_crc_bit(ex_crc_bit(ex_crc_bit(x))))))));
}

pub fn ex_crc_run(c: u32, text: List<usize>) -> u32 {
    return match (text) {
        Nil -> c,
        Cons(b, rest) -> ex_crc_run(ex_crc_byte(c, b), unbox(rest)),
    };
}

// Whether a part ends after a definition of this name: its CRC-32 is 0 mod 8,
// so the register before the final inversion is 7 mod 8.
pub fn ex_ends_part(name: List<usize>) -> bool {
    return (ex_crc_run(4294967295, name) & 7) == 7;
}

pub struct XPart {
    name: List<usize>,
    units: List<XUnit>,
}

pub fn ex_sanitized(c: usize) -> usize {
    if (ex_ident_char(c)) {
        return c;
    }
    return 95;
}

pub fn ex_sanitize(text: List<usize>) -> List<usize> {
    return match (text) {
        Nil -> empty(),
        Cons(c, rest) -> cons(ex_sanitized(c), ex_sanitize(unbox(rest))),
    };
}

pub fn ex_part_of(modname: List<usize>, units: List<XUnit>) -> XPart {
    let first: List<usize> = match (units) {
        Nil -> empty(),
        Cons(u, rest) -> get_or(u.names, 0, empty()),
    };
    return XPart { name: concat(modname, concat(tx_dot_p(), ex_sanitize(first))), units: units };
}

pub fn ex_split_end(modname: List<usize>, part: List<XUnit>, acc: List<XPart>) -> List<XPart> {
    if (length(part) == 0) {
        return acc;
    }
    return concat(acc, single(ex_part_of(modname, part)));
}

// The units split into parts: a part ends after a unit whose first name
// ends a part, or at 24 units.
pub fn ex_split(modname: List<usize>, units: List<XUnit>, part: List<XUnit>, acc: List<XPart>) -> List<XPart> {
    return match (units) {
        Nil -> ex_split_end(modname, part, acc),
        Cons(u, rest) -> ex_split_at(modname, unbox(rest), concat(part, single(u)), ex_ends_part(get_or(u.names, 0, empty())), acc),
    };
}

// extract: inline
fn ex_split_at(smodule: List<usize>, srest: List<XUnit>, spart: List<XUnit>, sends: bool, sacc: List<XPart>) -> List<XPart> {
    if (sends || length(spart) >= 24) {
        return ex_split(smodule, srest, empty(), concat(sacc, single(ex_part_of(smodule, spart))));
    }
    return ex_split(smodule, srest, spart, sacc);
}

// A definition and the part that has it; rank is 0 for another module's
// part and k + 1 for this module's part k.
pub struct XWhere {
    name: List<usize>,
    part: List<usize>,
    rank: usize,
}

// A definition of another module's extraction, as the driver read it: the
// module, the definition, its part.
pub struct XKnown {
    modname: List<usize>,
    name: List<usize>,
    part: List<usize>,
}

pub fn ex_unit_wheres(names: List<List<usize>>, part: List<usize>, rank: usize) -> List<XWhere> {
    return match (names) {
        Nil -> empty(),
        Cons(n, rest) -> cons(XWhere { name: n, part: part, rank: rank }, ex_unit_wheres(unbox(rest), part, rank)),
    };
}

pub fn ex_part_wheres(units: List<XUnit>, part: List<usize>, rank: usize) -> List<XWhere> {
    return match (units) {
        Nil -> empty(),
        Cons(u, rest) -> concat(ex_unit_wheres(u.names, part, rank), ex_part_wheres(unbox(rest), part, rank)),
    };
}

pub fn ex_own_wheres(parts: List<XPart>, rank: usize) -> List<XWhere> {
    return match (parts) {
        Nil -> empty(),
        Cons(p, rest) -> concat(ex_part_wheres(p.units, p.name, rank), ex_own_wheres(unbox(rest), plus(rank, 1))),
    };
}

pub fn ex_known_if(k: XKnown, modname: List<usize>) -> List<XWhere> {
    if (ex_same(k.modname, modname)) {
        return single(XWhere { name: k.name, part: k.part, rank: 0 });
    }
    return empty();
}

pub fn ex_known_in(known: List<XKnown>, modname: List<usize>) -> List<XWhere> {
    return match (known) {
        Nil -> empty(),
        Cons(k, rest) -> concat(ex_known_if(k, modname), ex_known_in(unbox(rest), modname)),
    };
}

// The known definitions of the modules imported, later modules first (a
// later module's definition hides an earlier one's).
pub fn ex_known_wheres(known: List<XKnown>, modules: List<List<usize>>) -> List<XWhere> {
    return match (modules) {
        Nil -> empty(),
        Cons(m, rest) -> concat(ex_known_wheres(known, unbox(rest)), ex_known_in(known, m)),
    };
}

// ---------------------------------------------------------------- sorting

// Byte order: whether a comes before b.
pub fn ex_text_less(a: List<usize>, b: List<usize>) -> bool {
    return match (a) {
        Nil -> length(b) != 0,
        Cons(x, rest) -> match (b) {
            Nil -> false,
            Cons(y, more) -> x < y || (x == y && ex_text_less(unbox(rest), unbox(more))),
        },
    };
}

pub fn ex_merge_texts(fuel: usize, a: List<List<usize>>, b: List<List<usize>>) -> List<List<usize>> {
    if (fuel == 0) {
        return concat(a, b);
    }
    return match (a) {
        Nil -> b,
        Cons(x, rest) -> match (b) {
            Nil -> a,
            Cons(y, more) -> ex_merge_pick(fuel, x, unbox(rest), y, unbox(more), a, b),
        },
    };
}

// extract: inline
fn ex_merge_pick(mfuel: usize, mx: List<usize>, mrest: List<List<usize>>, my: List<usize>, mmore: List<List<usize>>, ma: List<List<usize>>, mb: List<List<usize>>) -> List<List<usize>> {
    if (ex_text_less(my, mx)) {
        return cons(my, ex_merge_texts(minus(mfuel, 1), ma, mmore));
    }
    return cons(mx, ex_merge_texts(minus(mfuel, 1), mrest, mb));
}

pub fn ex_take_texts(n: usize, items: List<List<usize>>) -> List<List<usize>> {
    if (n == 0) {
        return empty();
    }
    return match (items) {
        Nil -> empty(),
        Cons(x, rest) -> cons(x, ex_take_texts(minus(n, 1), unbox(rest))),
    };
}

pub fn ex_drop_texts(n: usize, items: List<List<usize>>) -> List<List<usize>> {
    if (n == 0) {
        return items;
    }
    return match (items) {
        Nil -> empty(),
        Cons(x, rest) -> ex_drop_texts(minus(n, 1), unbox(rest)),
    };
}

pub fn ex_sort_texts(fuel: usize, items: List<List<usize>>) -> List<List<usize>> {
    if (fuel == 0) {
        return items;
    }
    if (length(items) < 2) {
        return items;
    }
    let half: usize = length(items) / 2;
    return ex_merge_texts(plus(length(items), 1), ex_sort_texts(minus(fuel, 1), ex_take_texts(half, items)), ex_sort_texts(minus(fuel, 1), ex_drop_texts(half, items)));
}

pub fn ex_dedup_run(prev: List<usize>, items: List<List<usize>>) -> List<List<usize>> {
    return match (items) {
        Nil -> single(prev),
        Cons(y, rest) -> ex_dedup_at(ex_same(prev, y), prev, y, unbox(rest)),
    };
}

// A sorted list without repeats.
pub fn ex_dedup(items: List<List<usize>>) -> List<List<usize>> {
    return match (items) {
        Nil -> empty(),
        Cons(x, rest) -> ex_dedup_run(x, unbox(rest)),
    };
}

// extract: inline
fn ex_dedup_at(dsame: bool, dprev: List<usize>, dy: List<usize>, drest: List<List<usize>>) -> List<List<usize>> {
    if (dsame) {
        return ex_dedup_run(dprev, drest);
    }
    return cons(dprev, ex_dedup_run(dy, drest));
}

pub fn ex_sorted_set(items: List<List<usize>>) -> List<List<usize>> {
    return ex_dedup(ex_sort_texts(64, items));
}

// ---------------------------------------------------------------- imports

// The names a part's text may refer to (extract.py's referenced): the
// maximal runs of letters, digits, `_` and `.` that start with a letter or
// `_` are its names; a name with a dot may be a method of any type, so its
// last segment counts too, as does a name after `).`.
pub struct XRun {
    text: List<usize>,
    after_paren: bool,
}

pub fn ex_is_run_char(c: usize) -> bool {
    return ex_ident_char(c) || c == 46;
}

pub fn ex_flush_run(cur: List<usize>, before: usize, acc: List<XRun>) -> List<XRun> {
    if (length(cur) == 0) {
        return acc;
    }
    return cons(XRun { text: ex_reverse(cur, empty()), after_paren: before == 41 }, acc);
}

// The runs of text, reversed onto acc: cur is the run so far (reversed) and
// before the byte before it.
pub fn ex_runs(text: List<usize>, prev: usize, cur: List<usize>, before: usize, acc: List<XRun>) -> List<XRun> {
    return match (text) {
        Nil -> ex_flush_run(cur, before, acc),
        Cons(c, rest) -> ex_runs_at(ex_is_run_char(c), c, unbox(rest), prev, cur, before, acc),
    };
}

// extract: inline
fn ex_runs_at(rin: bool, rc: usize, rrest: List<usize>, rprev: usize, rcur: List<usize>, rbefore: usize, racc: List<XRun>) -> List<XRun> {
    if (rin && length(rcur) == 0) {
        return ex_runs(rrest, rc, single(rc), rprev, racc);
    }
    if (rin) {
        return ex_runs(rrest, rc, cons(rc, rcur), rbefore, racc);
    }
    return ex_runs(rrest, rc, empty(), 0, ex_flush_run(rcur, rbefore, racc));
}

pub fn ex_take_until(text: List<usize>, stop: usize) -> List<usize> {
    return match (text) {
        Nil -> empty(),
        Cons(c, rest) -> ex_take_until_at(c == stop, c, unbox(rest), stop),
    };
}

pub fn ex_last_segment(text: List<usize>) -> List<usize> {
    return ex_reverse(ex_take_until(ex_reverse(text, empty()), 46), empty());
}

// extract: inline
fn ex_take_until_at(tstop: bool, tc: usize, trest: List<usize>, tby: usize) -> List<usize> {
    if (tstop) {
        return empty();
    }
    return cons(tc, ex_take_until(trest, tby));
}

pub fn ex_ident_prefix(text: List<usize>) -> List<usize> {
    return match (text) {
        Nil -> empty(),
        Cons(c, rest) -> ex_ident_prefix_at(ex_ident_char(c), c, unbox(rest)),
    };
}

// extract: inline
fn ex_ident_prefix_at(iok: bool, ic: usize, irest: List<usize>) -> List<usize> {
    if (iok) {
        return cons(ic, ex_ident_prefix(irest));
    }
    return empty();
}

pub fn ex_run_name(r: XRun) -> List<List<usize>> {
    if (ex_ident_start(get_or(r.text, 0, 0))) {
        return single(r.text);
    }
    return empty();
}

pub fn ex_run_names(runs: List<XRun>) -> List<List<usize>> {
    return match (runs) {
        Nil -> empty(),
        Cons(r, rest) -> concat(ex_run_name(r), ex_run_names(unbox(rest))),
    };
}

pub fn ex_run_last(r: XRun) -> List<List<usize>> {
    let first: usize = get_or(r.text, 0, 0);
    if (ex_ident_start(first) && ex_has(r.text, 46)) {
        return single(ex_last_segment(r.text));
    }
    if (r.after_paren && first == 46 && ex_ident_start(get_or(r.text, 1, 0))) {
        return single(ex_ident_prefix(ex_drop(1, r.text)));
    }
    return empty();
}

// The last segments that count as methods: of names with a dot, and after `).`.
pub fn ex_run_lasts(runs: List<XRun>) -> List<List<usize>> {
    return match (runs) {
        Nil -> empty(),
        Cons(r, rest) -> concat(ex_run_last(r), ex_run_lasts(unbox(rest))),
    };
}

pub fn ex_merge_wheres(fuel: usize, a: List<XWhere>, b: List<XWhere>) -> List<XWhere> {
    if (fuel == 0) {
        return concat(a, b);
    }
    return match (a) {
        Nil -> b,
        Cons(x, rest) -> match (b) {
            Nil -> a,
            Cons(y, more) -> ex_merge_where_pick(fuel, x, unbox(rest), y, unbox(more), a, b),
        },
    };
}

// extract: inline
fn ex_merge_where_pick(wfuel: usize, wx: XWhere, wrest: List<XWhere>, wy: XWhere, wmore: List<XWhere>, wa: List<XWhere>, wb: List<XWhere>) -> List<XWhere> {
    if (ex_text_less(wy.name, wx.name)) {
        return cons(wy, ex_merge_wheres(minus(wfuel, 1), wa, wmore));
    }
    return cons(wx, ex_merge_wheres(minus(wfuel, 1), wrest, wb));
}

pub fn ex_take_wheres(n: usize, items: List<XWhere>) -> List<XWhere> {
    if (n == 0) {
        return empty();
    }
    return match (items) {
        Nil -> empty(),
        Cons(x, rest) -> cons(x, ex_take_wheres(minus(n, 1), unbox(rest))),
    };
}

pub fn ex_drop_wheres(n: usize, items: List<XWhere>) -> List<XWhere> {
    if (n == 0) {
        return items;
    }
    return match (items) {
        Nil -> empty(),
        Cons(x, rest) -> ex_drop_wheres(minus(n, 1), unbox(rest)),
    };
}

pub fn ex_sort_wheres(fuel: usize, items: List<XWhere>) -> List<XWhere> {
    if (fuel == 0) {
        return items;
    }
    if (length(items) < 2) {
        return items;
    }
    let half: usize = length(items) / 2;
    return ex_merge_wheres(plus(length(items), 1), ex_sort_wheres(minus(fuel, 1), ex_take_wheres(half, items)), ex_sort_wheres(minus(fuel, 1), ex_drop_wheres(half, items)));
}

// The entries of wheres (sorted by name) whose name is in names (sorted,
// without repeats).
pub fn ex_join_wheres(fuel: usize, names: List<List<usize>>, wheres: List<XWhere>) -> List<XWhere> {
    if (fuel == 0) {
        return empty();
    }
    return match (names) {
        Nil -> empty(),
        Cons(n, rest) -> match (wheres) {
            Nil -> empty(),
            Cons(w, more) -> ex_join_at(fuel, n, unbox(rest), w, unbox(more), names, wheres),
        },
    };
}

// extract: inline
fn ex_join_at(jfuel: usize, jn: List<usize>, jrest: List<List<usize>>, jw: XWhere, jmore: List<XWhere>, jnames: List<List<usize>>, jwheres: List<XWhere>) -> List<XWhere> {
    if (ex_text_less(jn, jw.name)) {
        return ex_join_wheres(minus(jfuel, 1), jrest, jwheres);
    }
    if (ex_text_less(jw.name, jn)) {
        return ex_join_wheres(minus(jfuel, 1), jnames, jmore);
    }
    return cons(jw, ex_join_wheres(minus(jfuel, 1), jnames, jmore));
}

pub fn ex_join_sorted(names: List<List<usize>>, wheres: List<XWhere>) -> List<XWhere> {
    return ex_join_wheres(plus(plus(length(names), length(wheres)), 1), names, wheres);
}

pub fn ex_by_last_one(w: XWhere) -> List<XWhere> {
    if (ex_has(w.name, 46)) {
        return single(XWhere { name: ex_last_segment(w.name), part: w.part, rank: w.rank });
    }
    return empty();
}

// The entries of dotted names, by their last segment.
pub fn ex_by_last(wheres: List<XWhere>) -> List<XWhere> {
    return match (wheres) {
        Nil -> empty(),
        Cons(w, rest) -> concat(ex_by_last_one(w), ex_by_last(unbox(rest))),
    };
}

pub fn ex_take_texts_n(n: usize, text: List<usize>) -> List<usize> {
    if (n == 0) {
        return empty();
    }
    return match (text) {
        Nil -> empty(),
        Cons(c, rest) -> cons(c, ex_take_texts_n(minus(n, 1), unbox(rest))),
    };
}

pub fn ex_space_of(n: List<usize>) -> List<List<usize>> {
    if (ex_has(n, 46)) {
        let last: List<usize> = ex_last_segment(n);
        return single(ex_take_texts_n(minus(minus(length(n), length(last)), 1), n));
    }
    return empty();
}

// The namespaces of a part's methods: what is before the last dot.
pub fn ex_spaces_of(names: List<List<usize>>) -> List<List<usize>> {
    return match (names) {
        Nil -> empty(),
        Cons(n, rest) -> concat(ex_space_of(n), ex_spaces_of(unbox(rest))),
    };
}

pub fn ex_qualified_one(sp: List<usize>, names: List<List<usize>>) -> List<List<usize>> {
    return match (names) {
        Nil -> empty(),
        Cons(n, rest) -> cons(ex_dot(sp, n), ex_qualified_one(sp, unbox(rest))),
    };
}

// space.name for each space and name.
pub fn ex_qualified(spaces: List<List<usize>>, names: List<List<usize>>) -> List<List<usize>> {
    return match (spaces) {
        Nil -> empty(),
        Cons(sp, rest) -> concat(ex_qualified_one(sp, names), ex_qualified(unbox(rest), names)),
    };
}

pub fn ex_part_if(keep: bool, part: List<usize>) -> List<List<usize>> {
    if (keep) {
        return single(part);
    }
    return empty();
}

// The parts of the matches ranked before rank.
pub fn ex_parts_before(found: List<XWhere>, rank: usize) -> List<List<usize>> {
    return match (found) {
        Nil -> empty(),
        Cons(w, rest) -> concat(ex_part_if(w.rank < rank, w.part), ex_parts_before(unbox(rest), rank)),
    };
}

pub struct XLookup {
    // all definitions, sorted by name
    names: List<XWhere>,
    // the dotted ones by last segment, sorted
    lasts: List<XWhere>,
}

pub fn ex_unit_names(units: List<XUnit>) -> List<List<usize>> {
    return match (units) {
        Nil -> empty(),
        Cons(u, rest) -> concat(u.names, ex_unit_names(unbox(rest))),
    };
}

pub fn ex_unit_texts(units: List<XUnit>) -> List<usize> {
    return match (units) {
        Nil -> empty(),
        Cons(u, rest) -> concat(u.text, ex_unit_texts(unbox(rest))),
    };
}

// The modules (parts of this module before rank, or of other modules) that
// define what the units' text names (extract.py's needs), sorted.
pub fn ex_needs(look: XLookup, units: List<XUnit>, own: List<List<usize>>, rank: usize) -> List<List<usize>> {
    let runs: List<XRun> = ex_runs(ex_unit_texts(units), 0, empty(), 0, empty());
    let names: List<List<usize>> = ex_sorted_set(ex_run_names(runs));
    let exact: List<XWhere> = ex_join_sorted(names, look.names);
    let spaced: List<XWhere> = ex_join_sorted(ex_sorted_set(ex_qualified(ex_sorted_set(ex_spaces_of(own)), names)), look.names);
    let methods: List<XWhere> = ex_join_sorted(ex_sorted_set(ex_run_lasts(runs)), look.lasts);
    return ex_sorted_set(ex_parts_before(concat(exact, concat(spaced, methods)), rank));
}

pub fn ex_contains(text: List<usize>, pat: List<usize>) -> bool {
    return match (text) {
        Nil -> false,
        Cons(c, rest) -> ex_starts(pat, text) || ex_contains(unbox(rest), pat),
    };
}

pub fn ex_exposed(units: List<XUnit>) -> List<XUnit> {
    return match (units) {
        Nil -> empty(),
        Cons(u, rest) -> concat(ex_unit_if(ex_contains(u.text, tx_expose_mark()), u), ex_exposed(unbox(rest))),
    };
}

pub fn ex_minus_texts(a: List<List<usize>>, b: List<List<usize>>) -> List<List<usize>> {
    return match (a) {
        Nil -> empty(),
        Cons(x, rest) -> concat(ex_part_if(!ex_has_text(b, x), x), ex_minus_texts(unbox(rest), b)),
    };
}

pub fn ex_import_lines(modules: List<List<usize>>) -> List<usize> {
    return match (modules) {
        Nil -> empty(),
        Cons(m, rest) -> concat(tx_import_(), concat(m, cons(10, ex_import_lines(unbox(rest))))),
    };
}

pub fn ex_part_texts(units: List<XUnit>) -> List<List<usize>> {
    return match (units) {
        Nil -> empty(),
        Cons(u, rest) -> cons(u.text, ex_part_texts(unbox(rest))),
    };
}

// The text of part k.
pub fn ex_part_module(look: XLookup, source_name: List<usize>, modname: List<usize>, p: XPart, rank: usize) -> XModule {
    let own: List<List<usize>> = ex_unit_names(p.units);
    let shown: List<List<usize>> = ex_needs(look, ex_exposed(p.units), own, rank);
    let hidden: List<List<usize>> = ex_minus_texts(ex_needs(look, p.units, own, rank), shown);
    let head: List<usize> = ex_flat(cons(tx_module_head(), cons(ex_public_imports(cons(concat(modname, tx_dot_types()), shown)), cons(ex_import_lines(hidden),
        cons(tx_public_section(), single(ex_part_header(source_name, modname)))))));
    return XModule { name: p.name, text: ex_join(single(10), cons(head, concat(ex_part_texts(p.units), single(tx_end_lanius())))) };
}

pub fn ex_part_modules(look: XLookup, source_name: List<usize>, modname: List<usize>, parts: List<XPart>, rank: usize) -> List<XModule> {
    return match (parts) {
        Nil -> empty(),
        Cons(p, rest) -> cons(ex_part_module(look, source_name, modname, p, rank), ex_part_modules(look, source_name, modname, unbox(rest), plus(rank, 1))),
    };
}

pub fn ex_module_names(modules: List<XModule>) -> List<List<usize>> {
    return match (modules) {
        Nil -> empty(),
        Cons(m, rest) -> cons(m.name, ex_module_names(unbox(rest))),
    };
}

// ---------------------------------------------------------------- the context

pub fn ex_cx_struct(a: XAt) -> List<XStructD> {
    if (a.prelude) {
        return empty();
    }
    return match (a.item) {
        IStruct(name, tparams, fields) -> single(XStructD { name: name, fields: fields }),
        IEnum(name, tparams, ctors) -> empty(),
        IFn(f) -> empty(),
        IImpl(name, fns) -> empty(),
        IMutual(b, f) -> empty(),
        IExternal(m, p) -> empty(),
        IPreludeEnd -> empty(),
        IBad(why) -> empty(),
    };
}

pub fn ex_cx_structs(ats: List<XAt>) -> List<XStructD> {
    return match (ats) {
        Nil -> empty(),
        Cons(a, rest) -> concat(ex_cx_struct(a), ex_cx_structs(unbox(rest))),
    };
}

pub fn ex_cx_enum(a: XAt) -> List<XEnumD> {
    if (a.prelude) {
        return empty();
    }
    return match (a.item) {
        IStruct(name, tparams, fields) -> empty(),
        IEnum(name, tparams, ctors) -> single(XEnumD { name: name, ctors: ctors }),
        IFn(f) -> empty(),
        IImpl(name, fns) -> empty(),
        IMutual(b, f) -> empty(),
        IExternal(m, p) -> empty(),
        IPreludeEnd -> empty(),
        IBad(why) -> empty(),
    };
}

pub fn ex_cx_enums(ats: List<XAt>) -> List<XEnumD> {
    return match (ats) {
        Nil -> empty(),
        Cons(a, rest) -> concat(ex_cx_enum(a), ex_cx_enums(unbox(rest))),
    };
}

pub fn ex_cx_fn(a: XAt) -> List<XFn> {
    if (a.prelude) {
        return empty();
    }
    return match (a.item) {
        IStruct(name, tparams, fields) -> empty(),
        IEnum(name, tparams, ctors) -> empty(),
        IFn(f) -> single(f),
        IImpl(name, fns) -> empty(),
        IMutual(b, f) -> empty(),
        IExternal(m, p) -> empty(),
        IPreludeEnd -> empty(),
        IBad(why) -> empty(),
    };
}

pub fn ex_cx_fns(ats: List<XAt>) -> List<XFn> {
    return match (ats) {
        Nil -> empty(),
        Cons(a, rest) -> concat(ex_cx_fn(a), ex_cx_fns(unbox(rest))),
    };
}

pub fn ex_cx_method(a: XAt) -> List<XFn> {
    if (a.prelude) {
        return empty();
    }
    return match (a.item) {
        IStruct(name, tparams, fields) -> empty(),
        IEnum(name, tparams, ctors) -> empty(),
        IFn(f) -> empty(),
        IImpl(name, fns) -> fns,
        IMutual(b, f) -> empty(),
        IExternal(m, p) -> empty(),
        IPreludeEnd -> empty(),
        IBad(why) -> empty(),
    };
}

pub fn ex_cx_methods(ats: List<XAt>) -> List<XFn> {
    return match (ats) {
        Nil -> empty(),
        Cons(a, rest) -> concat(ex_cx_method(a), ex_cx_methods(unbox(rest))),
    };
}

pub fn ex_no_fn() -> XFn {
    return XFn { name: empty(), tparams: empty(), params: empty(), ret: empty(), body: empty(), self_type: empty(), doc: empty(), inline: false };
}

pub fn ex_cx(ats: List<XAt>) -> XCx {
    return XCx { structs: ex_cx_structs(ats), enums: ex_cx_enums(ats), fns: ex_cx_fns(ats), methods: ex_cx_methods(ats), current: ex_no_fn() };
}

// ---------------------------------------------------------------- the extraction

pub struct XModule {
    name: List<usize>,
    text: List<usize>,
}

pub struct XOut {
    modules: List<XModule>,
    errs: List<List<usize>>,
}

// The modules of a file's external sections: the driver reads their parts.
pub fn ex_external_modules(fuel: usize, source: List<usize>, root: CTree) -> List<List<usize>> {
    return ex_externals(ex_file_items(fuel, source, root));
}

// The source of an external section, as the driver reads it: the path the
// marker names, the file's bytes and laniusc's tree of them.
pub struct XExtSrc {
    path: List<usize>,
    source: List<usize>,
    root: CTree,
}

pub fn ex_external_path_of(item: XItem) -> List<List<usize>> {
    return match (item) {
        IStruct(name, tparams, fields) -> empty(),
        IEnum(name, tparams, ctors) -> empty(),
        IFn(f) -> empty(),
        IImpl(name, fns) -> empty(),
        IMutual(b, f) -> empty(),
        IExternal(m, p) -> single(p),
        IPreludeEnd -> empty(),
        IBad(why) -> empty(),
    };
}

pub fn ex_external_path_list(ats: List<XAt>) -> List<List<usize>> {
    return match (ats) {
        Nil -> empty(),
        Cons(a, rest) -> concat(ex_external_path_of(a.item), ex_external_path_list(unbox(rest))),
    };
}

// The paths of a file's external sections, in order: the driver reads them.
pub fn ex_external_paths(fuel: usize, source: List<usize>, root: CTree) -> List<List<usize>> {
    return ex_external_path_list(ex_file_items(fuel, source, root));
}

pub fn ex_path_or(here: bool, p: List<usize>, later: List<usize>) -> List<usize> {
    if (here) {
        return p;
    }
    return later;
}

// The path of the external section of module m.
pub fn ex_path_of_module(ats: List<XAt>, m: List<usize>) -> List<usize> {
    return match (ats) {
        Nil -> empty(),
        Cons(a, rest) -> match (a.item) {
            IStruct(name, tparams, fields) -> ex_path_of_module(unbox(rest), m),
            IEnum(name, tparams, ctors) -> ex_path_of_module(unbox(rest), m),
            IFn(f) -> ex_path_of_module(unbox(rest), m),
            IImpl(name, fns) -> ex_path_of_module(unbox(rest), m),
            IMutual(b, f) -> ex_path_of_module(unbox(rest), m),
            IExternal(em, ep) -> ex_path_or(ex_same(em, m), ep, ex_path_of_module(unbox(rest), m)),
            IPreludeEnd -> ex_path_of_module(unbox(rest), m),
            IBad(why) -> ex_path_of_module(unbox(rest), m),
        },
    };
}

pub fn ex_items_if(fuel: usize, here: bool, x: XExtSrc, later: List<XAt>) -> List<XAt> {
    if (here) {
        return ex_file_items(fuel, x.source, x.root);
    }
    return later;
}

// The items of the source at path (none if the driver read no such file).
pub fn ex_items_at(fuel: usize, srcs: List<XExtSrc>, path: List<usize>) -> List<XAt> {
    return match (srcs) {
        Nil -> empty(),
        Cons(x, rest) -> ex_items_if(fuel, ex_same(x.path, path), x, ex_items_at(fuel, unbox(rest), path)),
    };
}

// The name of a struct, enum or function item, else nothing.
pub fn ex_item_name(item: XItem) -> List<List<usize>> {
    return match (item) {
        IStruct(name, tparams, fields) -> single(name),
        IEnum(name, tparams, ctors) -> single(name),
        IFn(f) -> single(f.name),
        IImpl(name, fns) -> empty(),
        IMutual(b, f) -> empty(),
        IExternal(m, p) -> empty(),
        IPreludeEnd -> empty(),
        IBad(why) -> empty(),
    };
}

pub fn ex_named_if(here: bool, item: XItem, found: List<XItem>) -> List<XItem> {
    if (here) {
        return single(item);
    }
    return found;
}

// The last item named name outside the prelude (extract.py's items by name).
pub fn ex_last_named(ats: List<XAt>, name: List<usize>, found: List<XItem>) -> List<XItem> {
    return match (ats) {
        Nil -> found,
        Cons(a, rest) -> ex_last_named(unbox(rest), name, ex_named_if(!a.prelude && ex_has_text(ex_item_name(a.item), name), a.item, found)),
    };
}

pub fn ex_fields_same(fuel: usize, a: List<XField>, b: List<XField>) -> bool {
    return match (a) {
        Nil -> length(b) == 0,
        Cons(x, rest) -> match (b) {
            Nil -> false,
            Cons(y, more) -> ex_same(x.name, y.name) && ex_ty_eq(fuel, x.ty, y.ty) && ex_fields_same(fuel, unbox(rest), unbox(more)),
        },
    };
}

pub fn ex_ctors_same(fuel: usize, a: List<XCtor>, b: List<XCtor>) -> bool {
    return match (a) {
        Nil -> length(b) == 0,
        Cons(x, rest) -> match (b) {
            Nil -> false,
            Cons(y, more) -> ex_same(x.name, y.name) && ex_tys_eq(fuel, x.payload, y.payload) && ex_ctors_same(fuel, unbox(rest), unbox(more)),
        },
    };
}

pub fn ex_params_same(fuel: usize, a: List<XParam>, b: List<XParam>) -> bool {
    return match (a) {
        Nil -> length(b) == 0,
        Cons(x, rest) -> match (b) {
            Nil -> false,
            Cons(y, more) -> ex_same(x.name, y.name) && ex_ty_eq(fuel, x.ty, y.ty) && ex_params_same(fuel, unbox(rest), unbox(more)),
        },
    };
}

// extract.py's shape: a struct's fields, an enum's constructors, a function's signature.
pub fn ex_fn_same(fuel: usize, f: XFn, theirs: XItem) -> bool {
    return match (theirs) {
        IStruct(name, tparams, fields) -> false,
        IEnum(name, tparams, ctors) -> false,
        IFn(g) -> ex_same(f.name, g.name) && ex_texts_same(f.tparams, g.tparams) && ex_params_same(fuel, f.params, g.params) && ex_tys_eq(fuel, f.ret, g.ret),
        IImpl(name, fns) -> false,
        IMutual(b, m) -> false,
        IExternal(m, p) -> false,
        IPreludeEnd -> false,
        IBad(why) -> false,
    };
}

pub fn ex_same_shape(fuel: usize, mine: XItem, theirs: XItem) -> bool {
    return match (mine) {
        IStruct(name, tparams, fields) -> match (theirs) {
            IStruct(n2, t2, f2) -> ex_fields_same(fuel, fields, f2),
            IEnum(n2, t2, c2) -> false,
            IFn(g) -> false,
            IImpl(n2, fns) -> false,
            IMutual(b, m) -> false,
            IExternal(m, p) -> false,
            IPreludeEnd -> false,
            IBad(why) -> false,
        },
        IEnum(name, tparams, ctors) -> match (theirs) {
            IStruct(n2, t2, f2) -> false,
            IEnum(n2, t2, c2) -> ex_ctors_same(fuel, ctors, c2),
            IFn(g) -> false,
            IImpl(n2, fns) -> false,
            IMutual(b, m) -> false,
            IExternal(m, p) -> false,
            IPreludeEnd -> false,
            IBad(why) -> false,
        },
        IFn(f) -> ex_fn_same(fuel, f, theirs),
        IImpl(name, fns) -> false,
        IMutual(b, m) -> false,
        IExternal(m, p) -> false,
        IPreludeEnd -> false,
        IBad(why) -> false,
    };
}

pub fn ex_first_same(fuel: usize, mine: XItem, theirs: List<XItem>) -> bool {
    return match (theirs) {
        Nil -> false,
        Cons(t, rest) -> ex_same_shape(fuel, mine, t),
    };
}

pub fn ex_inline_external(inline: bool, errs: List<List<usize>>) -> List<List<usize>> {
    if (inline) {
        return single(tx_err_inline_external());
    }
    return errs;
}

// text err_inline_external "inline functions cannot be external"
// text err_differs " differs from its definition in "
// text err_impl_external "impl blocks cannot be external"
// The error of an external item that is not its source's item of that name.
pub fn ex_external_err(fuel: usize, mine: XItem, name: List<usize>, path: List<usize>, theirs: List<XItem>) -> List<List<usize>> {
    if (ex_first_same(fuel, mine, theirs)) {
        return empty();
    }
    return single(concat(name, concat(tx_err_differs(), path)));
}

pub fn ex_external_at_errs(fuel: usize, ats: List<XAt>, srcs: List<XExtSrc>, a: XAt) -> List<List<usize>> {
    if (length(a.external) == 0 || a.prelude) {
        return empty();
    }
    let path: List<usize> = ex_path_of_module(ats, a.external);
    return match (a.item) {
        IStruct(name, tparams, fields) -> ex_external_err(fuel, a.item, name, path, ex_last_named(ex_items_at(fuel, srcs, path), name, empty())),
        IEnum(name, tparams, ctors) -> ex_external_err(fuel, a.item, name, path, ex_last_named(ex_items_at(fuel, srcs, path), name, empty())),
        IFn(f) -> ex_inline_external(f.inline, ex_external_err(fuel, a.item, f.name, path, ex_last_named(ex_items_at(fuel, srcs, path), f.name, empty()))),
        IImpl(name, fns) -> single(tx_err_impl_external()),
        IMutual(b, m) -> empty(),
        IExternal(m, p) -> empty(),
        IPreludeEnd -> empty(),
        IBad(why) -> empty(),
    };
}

pub fn ex_external_errs_in(fuel: usize, all: List<XAt>, ats: List<XAt>, srcs: List<XExtSrc>) -> List<List<usize>> {
    return match (ats) {
        Nil -> empty(),
        Cons(a, rest) -> concat(ex_external_at_errs(fuel, all, srcs, a), ex_external_errs_in(fuel, all, unbox(rest), srcs)),
    };
}

// The errors of the external items that differ from their sources' items of
// the same name (extract.py's check_external): srcs are the files of
// ex_external_paths, as the driver read them.
pub fn ex_external_errs(fuel: usize, source: List<usize>, root: CTree, srcs: List<XExtSrc>) -> List<List<usize>> {
    let ats: List<XAt> = ex_file_items(fuel, source, root);
    return ex_external_errs_in(fuel, ats, ats, srcs);
}

pub fn ex_item_err(item: XItem) -> List<List<usize>> {
    return match (item) {
        IStruct(name, tparams, fields) -> empty(),
        IEnum(name, tparams, ctors) -> empty(),
        IFn(f) -> empty(),
        IImpl(name, fns) -> empty(),
        IMutual(b, f) -> empty(),
        IExternal(m, p) -> empty(),
        IPreludeEnd -> empty(),
        IBad(why) -> single(why),
    };
}

pub fn ex_item_errs(ats: List<XAt>) -> List<List<usize>> {
    return match (ats) {
        Nil -> empty(),
        Cons(a, rest) -> concat(ex_item_err(a.item), ex_item_errs(unbox(rest))),
    };
}

// The Lean modules extracted from a file (extract.py's run): its bytes and
// laniusc's tree of them, its path from the repository root, its module, and
// the definitions of the modules its external sections import. The modules
// are `module.Types`, the parts `module.P.<first definition>` and `module`.
pub fn ex_extract(fuel: usize, source: List<usize>, root: CTree, source_name: List<usize>, modname: List<usize>, known: List<XKnown>) -> XOut {
    let ats: List<XAt> = ex_file_items(fuel, source, root);
    let cx: XCx = ex_cx(ats);
    let walked: XWalk = ex_walk(fuel, cx, ats, XWalk { units: empty(), in_mutual: false, fuel: false, names: empty(), texts: empty(), errs: empty() });
    let units: List<XUnit> = concat(ex_units_kept(walked.units, false), ex_units_kept(walked.units, true));
    let parts: List<XPart> = ex_split(modname, units, empty(), empty());
    let wheres: List<XWhere> = concat(ex_own_wheres(parts, 1), ex_known_wheres(known, ex_externals(ats)));
    let look: XLookup = XLookup { names: ex_sort_wheres(64, wheres), lasts: ex_sort_wheres(64, ex_by_last(wheres)) };
    let types: XModule = XModule { name: concat(modname, tx_dot_types()), text: ex_types_module(fuel, source_name, modname, ats) };
    let part_mods: List<XModule> = ex_part_modules(look, source_name, modname, parts, 1);
    let main_text: List<usize> = ex_flat(cons(tx_module_head(), cons(ex_public_imports(cons(types.name, ex_module_names(part_mods))), cons(single(10),
        cons(tx_header_a(), cons(source_name, cons(tx_header_b(), cons(ex_decimal(length(parts)), single(tx_header_c())))))))));
    return XOut { modules: cons(types, concat(part_mods, single(XModule { name: modname, text: main_text }))), errs: concat(ex_item_errs(ats), walked.errs) };
}

