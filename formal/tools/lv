#!/usr/bin/python3 -I
"""lv: the one front door to the verified compiler's tools on this machine.

    lv check FILE.lean..        Lean on single files (`lake env lean`), errors in full
    lv build [TARGET..]         `lake build` (default: LaniusMini Lanius LaniusOpen)
    lv gate [gate.py args]      the difftest gate (default: --tier quick --jobs 2)
    lv regen [regen.py args]    regenerate the generated Lean files
    lv open ARGS                the open-statement graph (status, check, claim, release)
    lv merge COMMIT             coordinator only: fast-forward lang, gate, push
    lv lake ARGS                any other lake command under a Lean slot
    lv slot CMD..               run CMD holding a Lean slot (the old leanslot)
    lv heavy ARGS / lv lcc ARGS the GPU lane and the resident compiler
    lv memwait | prune | status the memory rule, cache pruning, who holds what
    lv cache                    check every Lake output for truncation (a full disk)
                                and quarantine damaged ones (builds check theirs)
    lv install                  deploy this lv to target/claude-work/lv and make
                                the old wrappers aliases of it (lv uninstall undoes it)

Every command runs from the worktree you are in (its formal/), takes the
locks the old wrappers took, and keeps their rules: one worktree lock plus
one of three machine-wide Lean slots for builds (leanslot), one small lane
for single files (lcheck), every scope in work.slice, memwait before heavy
processes (lake's lean goes through target/claude-work/leanroot, whose
bin/lean caps lean processes at six and waits in memwait), a core limit of
exactly 1 byte (never 0: Ubuntu's apport would come back), the 5-minute
limit on each command, and stale Lake cache artifacts pruned now and then.

Failures are loud: a nonzero exit code, the error lines themselves (whole,
not a tail) and the path of the full log. Nothing is killed for memory.
"""
import fcntl
import os
import re
import resource
import shutil
import signal
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.realpath(__file__))
LVD = os.path.join(HERE, 'lv.d')
LAKE = os.path.expanduser('~/.elan/bin/lake')
LEAN_SLOTS = ('lean.lock', 'lean.lock.2', 'lean.lock.3')   # leanslot's three machine-wide slots
# seconds from lv's start, slot waits included: every command ends within 5 minutes (LV_DEADLINE may only shorten it)
TOTAL = min(295, int(os.environ.get('LV_DEADLINE', '295')))
STARTED = time.time()
CHECK_LIMIT = 280      # lcheck's own limit for one file
PRUNE_EVERY = 6 * 3600
DEFAULT_BUILD = ['LaniusMini', 'Lanius', 'LaniusOpen']
CACHE = os.path.expanduser('~/.elan/toolchains/leanprover--lean4---v4.33.1/lake/cache')   # Lake's artifact cache
ALIASES = {   # old wrapper -> lv arguments
    'leanslot': ['slot'], 'lcheck': ['check'], 'heavy': ['heavy'], 'lcc': ['lcc'],
    'merge1': ['merge'], 'cacheprune': ['prune'], 'agentstatus': ['status'],
    'lb': ['build'], 'leanp': ['check'],
}


def die(msg, code=1):
    print(f'lv: {msg}', file=sys.stderr, flush=True)
    sys.exit(code)


def say(msg):
    sys.stdout.flush()
    print(f'lv: {msg}', file=sys.stderr, flush=True)


def git(*args, cwd=None):
    r = subprocess.run(['git', *args], cwd=cwd, capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else None


class Place:
    """Where we are: this worktree (TOP), the main checkout (MAIN, home of the
    shared .git and target/claude-work) and the shared state (SHARED)."""

    def __init__(self):
        self.top = git('rev-parse', '--show-toplevel')
        common = git('rev-parse', '--path-format=absolute', '--git-common-dir')
        self.main = os.path.dirname(common) if common else '/home/andrew-peterson/code/laniusc'
        self.common = common
        self.gitdir = git('rev-parse', '--path-format=absolute', '--git-dir')
        self.shared = os.path.join(self.main, 'target/claude-work')
        self.leanroot = os.path.join(self.shared, 'leanroot')

    def formal(self):
        if not self.top or not os.path.isdir(os.path.join(self.top, 'formal')):
            die('run lv inside a laniusc checkout or worktree (no formal/ here)', 2)
        return os.path.join(self.top, 'formal')

    def ensure_links(self):
        """A worktree reaches the shared tools, cache and compiler the way the
        tools expect (target/claude-work/{bin,cache}, target/release)."""
        if self.top == self.main or not self.top:
            return
        for rel, dest in (('target/claude-work/bin', os.path.join(self.shared, 'bin')),
                          ('target/claude-work/cache', os.path.join(self.shared, 'cache')),
                          ('target/release', os.path.join(self.main, 'target/release'))):
            p = os.path.join(self.top, rel)
            if not os.path.lexists(p):
                os.makedirs(os.path.dirname(p), exist_ok=True)
                os.symlink(dest, p)
                say(f'linked {rel} -> {dest}')


P = Place()


def lean_env(extra=None):
    env = dict(os.environ)
    env['PATH'] = os.path.expanduser('~/.elan/bin') + ':' + env.get('PATH', '')
    env.setdefault('LAKE_OVERRIDE_LEAN', '1')
    env.setdefault('LEAN_SYSROOT', P.leanroot)
    env.pop('LEAN_NUM_THREADS', None)   # lake deadlocks with it; only `lv check` sets it (as lcheck did)
    env.update(extra or {})
    return env


def core_limit():
    # 1 byte: the kernel then skips the core_pattern pipe (apport); 0 does not.
    resource.setrlimit(resource.RLIMIT_CORE, (1, 1))


def memwait():
    subprocess.run([os.path.join(LVD, 'memwait')], check=False)


def lock(path):
    """flock PATH, waiting at most until the command's deadline (exit 75 then)."""
    f = open(path, 'a')
    told = False
    while True:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return f
        except BlockingIOError:
            if not told:
                say(f'waiting for {os.path.basename(path)} (held by another run of this worktree)')
                told = True
            remaining()
            time.sleep(1)


def lean_slot():
    """This worktree's lock, then one of the machine-wide Lean slots (as
    leanslot), waiting at most until the command's deadline (exit 75 then)."""
    if os.environ.get('LEAN_LOCK_HELD') == '1':
        return []
    held = [lock(os.path.join(P.gitdir, 'lean-wt.lock'))]
    told = False
    while True:
        for name in LEAN_SLOTS:
            f = open(os.path.join(P.common, name), 'a')
            try:
                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                f.close()
                continue
            held.append(f)
            return held
        if not told:
            say('waiting for a Lean slot (all three busy: `lv status` shows who has them)')
            told = True
        remaining()
        time.sleep(3)


def prune(force=False):
    """Drop Lake cache artifacts no worktree links to and outputs, both older than 12 h."""
    stamp = os.path.join(P.shared, 'lv', 'prune.stamp')
    if not force and os.path.exists(stamp) and time.time() - os.path.getmtime(stamp) < PRUNE_EVERY:
        return
    cache = CACHE
    gone = 0
    cutoff = time.time() - 12 * 3600
    for sub, links_only in (('artifacts', True), ('outputs', False)):
        for d, _, files in os.walk(os.path.join(cache, sub)):
            for name in files:
                p = os.path.join(d, name)
                try:
                    st = os.lstat(p)
                    if st.st_mtime < cutoff and (not links_only or st.st_nlink == 1):
                        os.unlink(p)
                        gone += 1
                except FileNotFoundError:
                    pass
    os.makedirs(os.path.dirname(stamp), exist_ok=True)
    open(stamp, 'w').write(time.strftime('%F %T\n'))
    du = shutil.disk_usage('/')
    if force or gone:
        say(f'pruned {gone} stale Lake cache files; {du.free / 2**30:.0f} GB free on /')
    return cache_check(quiet=not force)



def damaged(path):
    """Why a Lake output is damaged (truncated or empty, as Lean leaves them when
    the disk fills), or None. An olean (also .ir, .olean.private/.server) is a
    0x60-byte header (magic, version, githash, base address, root pointer) and
    then objects; the root object is the last one, so it ends at the end of
    the file. A header-only part whose root lives in another part is fine."""
    try:
        n = os.path.getsize(path)
        name = os.path.basename(path)
        ext = name.split('.', 1)[1] if '.' in name else ''
        if ext.endswith('hash') or ext == 'trace' or ext == '':
            return None
        if n == 0:
            return 'empty'
        with open(path, 'rb') as f:
            if ext in ('olean', 'olean.private', 'olean.server', 'ir'):
                h = f.read(0x60)
                if len(h) < 0x60 or h[:5] != b'olean':
                    return 'no olean header'
                if n == 0x60:
                    return None
                base, root = int.from_bytes(h[0x50:0x58], 'little'), int.from_bytes(h[0x58:0x60], 'little')
                off = root - base
                if not 0x60 <= off <= n - 8:
                    return f'truncated (root object outside the file\'s {n} bytes)'
                f.seek(off)
                size = int.from_bytes(f.read(8)[4:6], 'little')
                if off + size != n:
                    return f'truncated (root object ends at {off + size}, file has {n} bytes)'
            elif ext in ('ilean', 'c'):
                f.seek(max(0, n - 64))
                tail = f.read().rstrip()
                want = b'}' if ext == 'ilean' else b'#endif'
                if not tail.endswith(want):
                    return f'truncated (does not end with {want.decode()})'
    except FileNotFoundError:
        return None
    return None


def worktree_builds():
    out = git('worktree', 'list', '--porcelain', cwd=P.main)
    for line in out.split('\n'):
        if line.startswith('worktree '):
            d = os.path.join(line[9:], 'formal', '.lake', 'build')
            if os.path.isdir(d):
                yield d


def quarantine(bad):
    """Move damaged cache artifacts (and the output mappings naming them) to
    target/claude-work/lv/badcache, and delete every worktree build file that
    is the same file (hard link) or is itself damaged, with its module's trace,
    so lake rebuilds those modules instead of crashing on import."""
    qdir = os.path.join(P.shared, 'lv', 'badcache', time.strftime('%m%d-%H%M%S'))
    os.makedirs(qdir, exist_ok=True)
    inodes = {}
    for path, why in bad:
        try:
            st = os.stat(path)
            inodes[(st.st_dev, st.st_ino)] = path
        except FileNotFoundError:
            pass
    names = {os.path.basename(p) for p, _ in bad if p.startswith(CACHE)}
    if names:
        for d, _, files in os.walk(os.path.join(CACHE, 'outputs')):
            for f in files:
                m = os.path.join(d, f)
                try:
                    text = open(m, errors='replace').read()
                except OSError:
                    continue
                if any(f'"{x}"' in text for x in names):
                    shutil.move(m, os.path.join(qdir, 'outputs-' + f))
    dropped = []
    badpaths = {p for p, _ in bad}
    for build in worktree_builds():
        for d, _, files in os.walk(build):
            for f in files:
                p = os.path.join(d, f)
                try:
                    st = os.lstat(p)
                except FileNotFoundError:
                    continue
                if (st.st_dev, st.st_ino) in inodes or p in badpaths:
                    mod = os.path.join(d, f.split('.', 1)[0])
                    for x in [p, mod + '.trace', p + '.hash']:
                        if os.path.exists(x):
                            os.unlink(x)
                    dropped.append(p)
    for path, why in bad:
        if path.startswith(CACHE) and os.path.exists(path):
            shutil.move(path, os.path.join(qdir, os.path.basename(path)))
    return qdir, dropped


def cache_check(since=None, quiet=False):
    """Check the Lake outputs written since SINCE (all of them when None) in the
    shared cache and this worktree's build; quarantine damaged ones. Returns the
    number found; says so loudly."""
    roots = [os.path.join(CACHE, 'artifacts')]
    mine = os.path.join(P.top, 'formal', '.lake', 'build')
    if os.path.isdir(mine):
        roots.append(mine)
    bad = []
    for root in roots:
        for d, _, files in os.walk(root):
            for f in files:
                p = os.path.join(d, f)
                try:
                    if since is not None and os.lstat(p).st_mtime < since:
                        continue
                except FileNotFoundError:
                    continue
                why = damaged(p)
                if why and time.time() - os.path.getmtime(p) < 120:
                    time.sleep(3)   # perhaps still being written by another build
                    why = damaged(p)
                if why:
                    bad.append((p, why))
    if not bad:
        if not quiet:
            say('cache: no damaged Lake outputs' + ('' if since is None else ' among the new ones'))
        return 0
    for p, why in bad:
        print(f'  DAMAGED {p}: {why}')
    qdir, dropped = quarantine(bad)
    free = shutil.disk_usage('/').free / 2**30
    say(f'cache: {len(bad)} damaged Lake outputs (truncated or empty: was the disk full? {free:.0f} GB free now); '
        f'moved to {qdir}, {len(dropped)} worktree build files dropped so lake rebuilds them')
    return len(bad)


# -- running a command in a scope, with a time limit and its output kept

def log_path(kind):
    d = os.path.join(P.top or P.main, 'target/claude-work/lv')
    os.makedirs(d, exist_ok=True)
    return os.path.join(d, f'{kind}-{time.strftime("%m%d-%H%M%S")}-{os.getpid()}.log')


def remaining():
    left = TOTAL - (time.time() - STARTED)
    if left < 20:
        die(f'stopped: only {max(left, 0):.0f} s of the {TOTAL} s deadline left (lock waits count; the machine is busy). '
            'Nothing is rerun.', 75)
    return left


REAL_LEAN = os.path.expanduser('~/.elan/toolchains/leanprover--lean4---v4.33.1/bin/lean')


def in_flight(pid, formal):
    """The Lean jobs in PID's scope right now: [(module, seconds running)] for
    lean processes compiling, and the modules still waiting for a lean slot."""
    try:
        cg = open(f'/proc/{pid}/cgroup').read().strip().split('::', 1)[1]
        procs = open(f'/sys/fs/cgroup{cg}/cgroup.procs').read().split()
        uptime = float(open('/proc/uptime').read().split()[0])
        tick = os.sysconf('SC_CLK_TCK')
    except (OSError, IndexError, ValueError):
        return [], []
    running, waiting = [], []
    for q in procs:
        try:
            argv = open(f'/proc/{q}/cmdline', 'rb').read().split(b'\0')
            exe = os.readlink(f'/proc/{q}/exe')
            start = int(open(f'/proc/{q}/stat').read().rsplit(')', 1)[1].split()[19]) / tick
        except (OSError, IndexError, ValueError):
            continue
        argv = [a.decode(errors='replace') for a in argv if a]
        src = [a for a in argv if a.endswith('.lean')]
        if not src or not argv:
            continue
        mod = os.path.relpath(src[0], formal)[:-5].replace('/', '.')
        if exe == os.path.realpath(REAL_LEAN):
            running.append((mod, uptime - start))
        elif len(argv) > 1 and argv[1].endswith('/bin/lean'):    # the leanroot wrapper, waiting
            waiting.append(mod)
    running.sort(key=lambda x: -x[1])
    # a wrapper that has exec'd into lean is the lean process itself, so no double counting
    return running, sorted(set(waiting) - {m for m, _ in running})


def run_scoped(argv, cwd, env, limit, log, live=None, snapshot=None):
    """Run argv in its own work.slice scope; stop the scope at the limit or on
    a signal. Every line goes to log; lines that `live` accepts are echoed.
    Returns (exit code, seconds); 124 when the limit stopped it."""
    limit = min(limit, remaining() - 10)   # before the child starts: dying here must not orphan it;
    # 10 s stay for the report after it, so the whole command ends inside the deadline
    unit = f'lv-{os.getpid()}-{int(time.time() * 1000) % 100000}'
    # RuntimeMaxSec: systemd stops the scope itself if lv dies without stopping it
    cmd = ['systemd-run', '--user', '--scope', '-q', '--slice=work.slice', f'--unit={unit}',
           '-p', 'TimeoutStopSec=10', '-p', f'RuntimeMaxSec={int(limit) + 15}', *argv]
    began = time.time()
    out = open(log, 'w')
    child = subprocess.Popen(cmd, cwd=cwd, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                             stdin=subprocess.DEVNULL, text=True, errors='replace', start_new_session=True)

    def stop(*_):
        subprocess.run(['systemctl', '--user', 'stop', unit + '.scope'], capture_output=True)
        try:
            os.killpg(child.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
    old = {s: signal.signal(s, lambda n, f: (stop(), sys.exit(128 + n))) for s in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP)}
    timer = None
    stopped = []
    import threading

    def expire():
        stopped.append(1)
        if snapshot is not None:
            snapshot.extend(in_flight(child.pid, cwd))
        stop()
    timer = threading.Timer(limit, expire)
    timer.start()
    try:
        for line in child.stdout:
            out.write(line)
            if live is not None and live(line):
                sys.stdout.write(line)
                sys.stdout.flush()
        code = child.wait()
    except BaseException:
        stop()
        raise
    finally:
        timer.cancel()
        out.close()
        for s, h in old.items():
            signal.signal(s, h)
    return (124 if stopped else code), time.time() - began, limit


HEADER = re.compile(r'^(?:(error|warning|info)(?:\([^)]*\))?: |\S+?:\d+:\d+: (error|warning|info)(?:\([^)]*\))?: )')
TOPLINE = re.compile(r'^(?:[✔⚠✖ℹ] |trace: |Some required targets|Build completed|- \S)')


def blocks(lines):
    """Lean's and Lake's messages: (kind, [lines]) for each message, a header
    line and its continuation lines; other top-level lines are ('other', [line])."""
    cur = None
    for line in lines:
        m = HEADER.match(line)
        if m:
            if cur:
                yield cur
            cur = (m.group(1) or m.group(2), [line])
        elif TOPLINE.match(line) or cur is None:
            if cur:
                yield cur
                cur = None
            yield ('other', [line])
        else:
            cur[1].append(line)
    if cur:
        yield cur


def report(log, show_warnings=False, budget=600):
    """Print every error message whole (and the warnings with --all); count the
    rest. A failed job's `info: stderr:` (Lean's own stderr: a crash, a file it
    could not write) counts as an error and is printed with the job's name, and
    so is `Lean exited with code N` when the job printed no error of its own."""
    lines = open(log, errors='replace').read().split('\n')
    errors = warnings = printed = 0
    failed_targets = []
    in_failed = False
    job, job_errors = None, 0

    def show(body):
        nonlocal printed
        if printed < budget:
            print(body, flush=True)
            printed += body.count('\n') + 1

    for kind, text in blocks(lines):
        if kind == 'other':
            line = text[0]
            in_failed = line.startswith('Some required targets') or (in_failed and line.startswith('- '))
            if in_failed and line.startswith('- '):
                failed_targets.append(line[2:].strip())
            if line.startswith(('✖', '✔', '⚠')):
                job, job_errors = (line if line.startswith('✖') else None), 0
            continue
        body = '\n'.join(text).rstrip()
        stderr = kind == 'info' and text[0].startswith('info: stderr:')
        if text[0].startswith('error: build failed'):
            continue
        if text[0].startswith('error: Lean exited with code') and job_errors:
            continue
        if kind == 'error' or stderr:
            errors += 1
            if job and not job_errors and (stderr or text[0].startswith('error: Lean exited')):
                body = job + '\n' + body
            job_errors += 1
            show(body)
        else:
            warnings += 1
            if show_warnings:
                show(body)
    if printed >= budget:
        say(f'more messages than fit here ({printed} lines shown): all of them are in {log}')
    return errors, warnings, failed_targets


# -- commands

def cmd_slot(args):
    """leanslot: hold this worktree's lock and a Lean slot, then exec args
    (a bare lake/lean, after an optional `timeout N`, runs in work.slice)."""
    if not args:
        die('usage: lv slot CMD..', 2)
    core_limit()
    held = lean_slot()
    for f in held:
        os.set_inheritable(f.fileno(), True)
    i = 2 if args[0] == 'timeout' else 0
    if i and args[1].isdigit():    # the slot wait counts against the command's own limit
        args = ['timeout', str(max(1, min(int(args[1]), int(remaining())))), *args[2:]]
    if os.path.basename(args[i]) in ('lake', 'lean'):
        args = args[:i] + ['systemd-run', '--user', '--scope', '-q', '--slice=work.slice'] + args[i:]
    env = lean_env({'LEAN_LOCK_HELD': '1'})
    try:
        os.execvpe(args[0], args, env)
    except FileNotFoundError:
        die(f'{args[0]}: no such command', 127)


def cmd_check(args):
    """lcheck: `lake env lean FILE` in this worktree's formal/, in the small
    lane (one at a time, its own lock), 280 s, work.slice, after memwait."""
    show = '--all' in args
    files = [a for a in args if a != '--all']
    if not files:
        die('usage: lv check [--all] FILE.lean..', 2)
    formal = P.formal()
    core_limit()
    worst = 0
    for f in files:
        path = os.path.realpath(f)
        if not os.path.exists(path):
            die(f'{f}: no such file', 2)
        memwait()
        held = lock(os.path.join(P.common, 'lean-small.lock'))
        log = log_path('check')
        code, secs, lim = run_scoped([LAKE, 'env', 'lean', path], formal, lean_env({'LEAN_NUM_THREADS': '1'}),
                                     CHECK_LIMIT, log)
        held.close()
        errors, warnings, _ = report(log, show_warnings=show)
        rel = os.path.relpath(path)
        rel = path if rel.startswith('..') else rel
        if code == 124:
            say(f'{rel}: STOPPED at the {lim:.0f} s limit (a file that slow needs splitting or a faster proof); log {log}')
        elif code != 0 or errors:
            if not errors:   # lean failed without a message we parse: show its output whole
                print(open(log, errors='replace').read().rstrip())
            say(f'{rel}: FAILED, {errors} errors, {warnings} warnings, exit {code}, {secs:.1f} s; log {log}')
        else:
            say(f'{rel}: ok, {warnings} warnings, {secs:.1f} s')
            os.unlink(log)
        worst = worst or (code if code else (1 if errors else 0))
    return worst


def lake_current(targets, formal):
    return subprocess.run([LAKE, 'build', '--no-build', *targets], cwd=formal, env=lean_env(),
                          capture_output=True).returncode == 0


def cmd_build(args):
    """lake build TARGETS under a Lean slot, 290 s; the errors in full."""
    show = '--all' in args
    targets = [a for a in args if a != '--all'] or DEFAULT_BUILD
    formal = P.formal()
    core_limit()
    prune()
    if lake_current(targets, formal):
        say(f'build: {" ".join(targets)} up to date')
        return 0
    held = lean_slot()
    log = log_path('build')
    flight = []
    code, secs, lim = run_scoped([LAKE, 'build', *targets], formal, lean_env({'LEAN_LOCK_HELD': '1'}), TOTAL, log,
                                 live=lambda line: line.startswith('✖'), snapshot=flight)
    for f in held:
        f.close()
    if cache_check(since=STARTED - 5, quiet=True):
        say(f'build: FAILED: it wrote damaged outputs (above); run lv build again to rebuild them. Log {log}')
        return 1
    if code == 0:
        last = [x for x in open(log, errors='replace').read().split('\n') if x.strip()][-1:]
        say(f'build: ok in {secs:.0f} s ({last[0] if last else ""})')
        return 0
    errors, warnings, failed = report(log, show_warnings=show)
    if code == 124:
        built = len(re.findall(r'^[✔⚠] ', open(log, errors='replace').read(), re.M))
        running, waiting = flight if flight else ([], [])
        print(f'still building when stopped ({len(running)}):' if running else 'nothing was compiling when stopped')
        for mod, t in running:
            print(f'  {mod}  ({t:.0f} s so far)')
        if waiting:
            print(f'waiting for a lean process slot ({len(waiting)}): ' + ', '.join(waiting))
        say(f'build: STOPPED at the {lim:.0f} s deadline ({built} jobs finished, {errors} errors so far); '
            f'not rerun. Lake keeps what finished. Log {log}')
        return 124
    if not errors:
        print(open(log, errors='replace').read().rstrip()[-4000:])
    say(f'build: FAILED (exit {code}) in {secs:.0f} s: {errors} errors' +
        (f' in {", ".join(failed)}' if failed else '') + f'; log {log}')
    return code or 1


def run_tool(script, args, limit=TOTAL, kind='tool'):
    """A formal/tools script under a Lean slot (it waits once, its steps don't),
    with the integration gate's priority in heavy's GPU queue."""
    formal = P.formal()
    P.ensure_links()
    core_limit()
    prune()
    held = lean_slot()
    env = lean_env({'LEAN_LOCK_HELD': '1'})
    env.setdefault('HEAVY_PRIORITY', '1')
    log = log_path(kind)
    code, secs, lim = run_scoped([sys.executable, '-I', os.path.join(formal, 'tools', script), *args], P.top, env, limit,
                                 log, live=lambda line: True)
    for f in held:
        f.close()
    if cache_check(since=STARTED - 5, quiet=True) and code == 0:
        code = 1    # its builds wrote damaged outputs: not a pass, even if the steps passed
    return code, secs, log, lim


def cmd_gate(args):
    args = args or ['--tier', 'quick', '--jobs', '2']
    code, secs, log, lim = run_tool('gate.py', args, kind='gate')
    text = open(log, errors='replace').read()
    bad = re.findall(r'^== (\S+): (?:failed|stopped)', text, re.M)
    for step in bad:
        out = os.path.join(P.top, 'target/claude-work/gate', step, 'output.txt')
        if os.path.exists(out):
            lines = open(out, errors='replace').read().split('\n')
            hits = [x for x in lines if re.search(r'error|Error|FAIL|fail|Traceback|mismatch|differ|assert', x)]
            print(f'--- {step}: {len(hits)} error lines of {len(lines)} ({out})')
            for x in hits[:80]:
                print('   ' + x)
            if len(hits) > 80:
                print(f'   ... {len(hits) - 80} more in {out}')
    summary = re.findall(r'^\d+ steps, (\d+) failed or stopped', text, re.M)
    if code == 124:
        say(f'gate: STOPPED at the {lim:.0f} s limit; the steps that finished are cached. Log {log}')
        return 124
    if code != 0 or not summary or summary[-1] != '0':
        if code == 0:
            code = 1
        say(f'gate: FAILED (exit {code})' + (f': {", ".join(bad)}' if bad else '') + f'; log {log}')
        return code
    say(f'gate: passed in {secs:.0f} s')
    os.unlink(log)
    return 0


def cmd_regen(args):
    code, secs, log, lim = run_tool('regen.py', args, kind='regen')
    if code == 124:
        say(f'regen: STOPPED at the {lim:.0f} s limit; log {log}')
    elif code:
        say(f'regen: FAILED (exit {code}) after {secs:.0f} s; log {log}')
    else:
        say(f'regen: ok in {secs:.0f} s')
        os.unlink(log)
    return code


