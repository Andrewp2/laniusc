def cmd_merge(args):
    """merge1, fast-forward only: in the main checkout on lang, refuse COMMIT
    unless it contains local lang (the agent merged lang into its branch and
    gated there, so this checkout builds the same tree from the Lake cache),
    `git merge --ff-only`, the quick gate, push with a 60 s limit, prune and
    check the cache. A failed push leaves local lang ahead of origin (exit 0)."""
    if len(args) != 1:
        die('usage: lv merge COMMIT', 2)
    if P.top != P.main or git('rev-parse', '--abbrev-ref', 'HEAD') != 'lang':
        die(f'lv merge is the coordinator\'s: run it in {P.main} on branch lang', 2)
    if git('status', '--porcelain', '--untracked-files=no'):
        die('the main checkout has uncommitted changes to tracked files; commit or stash them first', 2)
    c = args[0]
    if subprocess.run(['git', 'rev-parse', '--verify', '-q', c + '^{commit}'], capture_output=True).returncode:
        die(f'no commit {c!r}', 2)
    head = git('rev-parse', '--short', 'HEAD')
    if subprocess.run(['git', 'merge-base', '--is-ancestor', c, 'HEAD']).returncode == 0:
        say(f'{c} is already in lang')
        return 0
    if subprocess.run(['git', 'merge-base', '--is-ancestor', 'HEAD', c]).returncode != 0:
        die(f'NOT A FAST-FORWARD: {c} lacks lang {head}; merge local lang into the branch, gate there, then ask again', 1)
    r = subprocess.run(['git', 'merge', '--ff-only', c], capture_output=True, text=True)
    if r.returncode != 0 or git('diff', '--name-only', '--diff-filter=U'):
        print(r.stdout + r.stderr)
        subprocess.run(['git', 'merge', '--abort'], capture_output=True)
        die('merge FAILED', 1)
    say(f'lang {head} -> ' + git('log', '--oneline', '-1'))
    code = cmd_gate([])
    if code != 0:
        die(f'GATE FAILED: not pushed (lang is fast-forwarded locally; `git reset --hard {head}` undoes it)', code)
    try:
        p = subprocess.run(['git', 'push', '-q', 'origin', 'lang'], capture_output=True, text=True, timeout=60)
        pushed = p.returncode == 0
        if not pushed:
            print((p.stdout + p.stderr).rstrip())
    except subprocess.TimeoutExpired:
        pushed = False
        print('git push took over 60 s; stopped')
    say(('pushed: ' if pushed else 'PUSH FAILED (local lang is ahead of origin; push again later): ')
        + git('log', '--oneline', '-1'))
    return 1 if prune(force=True) else 0


def cmd_install(args):
    """Deploy this lv (and lv.d) to target/claude-work/lv, point
    target/claude-work/bin/lv at it, make the old wrappers aliases (originals
    kept in bin/pre-lv) and leanroot/bin/lean a link to lv.d/lean."""
    bindir = os.path.join(P.shared, 'bin')
    dest = os.path.join(P.shared, 'lv')
    leanroot_bin = os.path.join(P.leanroot, 'bin')
    if '--bin' in args:   # a scratch install, for testing
        root = os.path.abspath(args[args.index('--bin') + 1])
        bindir, dest, leanroot_bin = os.path.join(root, 'bin'), os.path.join(root, 'lv'), os.path.join(root, 'leanroot/bin')
    for d in (bindir, dest, os.path.join(dest, 'lv.d'), leanroot_bin):
        os.makedirs(d, exist_ok=True)
    tmp = os.path.join(dest, '.new')
    shutil.rmtree(tmp, ignore_errors=True)
    os.makedirs(os.path.join(tmp, 'lv.d'))
    shutil.copy2(os.path.realpath(__file__), os.path.join(tmp, 'lv'))
    for name in os.listdir(LVD):
        shutil.copy2(os.path.join(LVD, name), os.path.join(tmp, 'lv.d', name))
    for name in os.listdir(tmp + '/lv.d'):
        os.replace(os.path.join(tmp, 'lv.d', name), os.path.join(dest, 'lv.d', name))
    os.replace(os.path.join(tmp, 'lv'), os.path.join(dest, 'lv'))
    shutil.rmtree(tmp, ignore_errors=True)
    lv = os.path.join(dest, 'lv')
    backup = os.path.join(bindir, 'pre-lv')
    os.makedirs(backup, exist_ok=True)

    def place(path, text=None, link=None, saved=None):
        saved = os.path.join(backup, saved or os.path.basename(path))
        if os.path.lexists(path) and not os.path.exists(saved) \
                and not (os.path.islink(path) or 'formal/tools/lv' in open(path, errors='replace').read()):
            shutil.copy2(path, saved)
        new = path + '.lvnew'
        if os.path.lexists(new):
            os.unlink(new)
        if link:
            os.symlink(link, new)
        else:
            open(new, 'w').write(text)
            os.chmod(new, 0o755)
        os.replace(new, path)
    place(os.path.join(bindir, 'lv'), link=lv)
    for old, sub in ALIASES.items():
        place(os.path.join(bindir, old),
              f'#!/bin/bash\n# Alias kept for running agents; see formal/tools/lv and formal/tools/README.md.\n'
              f'exec {lv} {" ".join(sub)} "$@"\n')
    place(os.path.join(bindir, 'memwait'), link=os.path.join(dest, 'lv.d', 'memwait'))
    place(os.path.join(leanroot_bin, 'lean'), link=os.path.join(dest, 'lv.d', 'lean'), saved='leanroot-lean')
    say(f'installed {lv}; aliases in {bindir} (originals in {backup})')
    return 0


def cmd_uninstall(args):
    bindir = os.path.join(P.shared, 'bin')
    leanroot = P.leanroot
    if '--bin' in args:
        root = os.path.abspath(args[args.index('--bin') + 1])
        bindir, leanroot = os.path.join(root, 'bin'), os.path.join(root, 'leanroot')
    backup = os.path.join(bindir, 'pre-lv')
    if not os.path.isdir(backup):
        die('nothing to restore (no bin/pre-lv)')
    for name in os.listdir(backup):
        target = os.path.join(leanroot, 'bin', 'lean') if name == 'leanroot-lean' else os.path.join(bindir, name)
        new = target + '.lvold'
        shutil.copy2(os.path.join(backup, name), new)
        os.replace(new, target)
    say(f'restored the wrappers from {backup}')
    return 0


def main(argv):
    if not argv or argv[0] in ('-h', '--help', 'help'):
        print(__doc__.strip())
        return 0
    cmd, args = argv[0], argv[1:]
    if cmd == 'heavy':
        os.execv(os.path.join(LVD, 'heavy'), [os.path.join(LVD, 'heavy'), *args])
    if cmd == 'lcc':
        os.execv(os.path.join(LVD, 'lcc'), [os.path.join(LVD, 'lcc'), *args])
    if cmd == 'memwait':
        os.execv(os.path.join(LVD, 'memwait'), [os.path.join(LVD, 'memwait')])
    if cmd == 'status':
        os.execv(os.path.join(LVD, 'agentstatus'), [os.path.join(LVD, 'agentstatus')])
    table = {'check': cmd_check, 'build': cmd_build, 'gate': cmd_gate, 'regen': cmd_regen, 'open': cmd_open,
             'merge': cmd_merge, 'lake': cmd_lake, 'slot': cmd_slot, 'install': cmd_install,
             'uninstall': cmd_uninstall, 'prune': lambda a: 1 if prune(force=True) else 0,
             'cache': lambda a: 1 if cache_check() else 0}
    if cmd not in table:
        die(f'no command {cmd!r}; `lv help` lists them', 2)
    return table[cmd](args)


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
