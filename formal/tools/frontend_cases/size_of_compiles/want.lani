struct W { a: i32, b: bool }

fn top(n: i32) -> i32 {
    let p: ptr = alloc::allocator::alloc((64 as usize), (8 as usize));
    let s: [i32] = slice_from_raw_parts(p, 4);
    let st: isize = slice_stride(s);
    let a: usize = size_of_i();
    let b: usize = size_of_w();
    return (st as i32) + (a as i32) + (b as i32);
}

fn size_of_i() -> usize {
    let nowhere: ptr = 0;
    let probe: [i32] = slice_from_raw_parts(nowhere, 0);
    let stride: isize = slice_stride(probe);
    if (stride < (0 as isize)) {
        return ((0 as isize) - stride) as usize;
    }
    return stride as usize;
}

fn size_of_w() -> usize {
    let nowhere: ptr = 0;
    let probe: [W] = slice_from_raw_parts(nowhere, 0);
    let stride: isize = slice_stride(probe);
    if (stride < (0 as isize)) {
        return ((0 as isize) - stride) as usize;
    }
    return stride as usize;
}
