// for over a slice local: a raw view's elements and a borrowed array's,
// continue and break, a write to an element seen by later steps.
fn total(s: [i32]) -> i32 {
    let t: i32 = 0;
    for x in s {
        if (x == 3) {
            continue;
        }
        if (x > 40) {
            break;
        }
        s[2] = 10;
        t = t + x;
    }
    return t;
}

fn run(n: i32) -> i32 {
    let a: [i32; 5] = [1, 3, 5, 50, 7];
    let p: ptr = alloc::allocator::alloc((16 as usize), (8 as usize));
    let s: [i32] = slice_from_raw_parts(p, 4);
    s[0] = n;
    s[1] = 2;
    s[2] = 3;
    s[3] = 4;
    return total(a) + total(s);
}
