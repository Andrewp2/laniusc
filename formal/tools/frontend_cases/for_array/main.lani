// for over an array local: each element in order, continue and break,
// a write to the array seen by later steps, a write to the copy x.
fn total(a: [i32; 5]) -> i32 {
    let s: i32 = 0;
    for x in a {
        if (x == 3) {
            continue;
        }
        if (x > 40) {
            break;
        }
        s = s + x;
    }
    return s;
}

fn bump(n: i32) -> i32 {
    let a: [i32; 3] = [n, 2, 3];
    let s: i32 = 0;
    for x in a {
        a[2] = 10;
        x = x + 100;
        s = s + x;
    }
    return s;
}

fn run(n: i32) -> i32 {
    let a: [i32; 5] = [1, 3, 5, 50, 7];
    return total(a) + bump(n);
}
