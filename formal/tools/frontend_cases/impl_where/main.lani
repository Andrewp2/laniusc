// An impl with a where clause: its methods are read as without it (bounds
// are not checked yet, F7).
trait Hash<T> {
    fn hash(value: T) -> u32;
}

struct Boxed<T> { v: T }

impl Hash<i32> for i32 {
    fn hash(value: i32) -> u32 {
        return value as u32;
    }
}

impl<T> Hash<Boxed<T>> for Boxed<T>
    where T: Hash<T> {
    fn hash(b: Boxed<T>) -> u32 {
        return T::hash(b.v) + 1;
    }
}

fn hash_of<T>(x: T) -> u32 {
    return T::hash(x);
}

fn top(n: i32) -> u32 {
    let b: Boxed<i32> = Boxed { v: n };
    return hash_of(b);
}
