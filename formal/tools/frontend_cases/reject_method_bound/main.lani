// The method's impl requires T: Show<T>, and bool has no impl of Show:
// its instance at bool is rejected.
trait Show<T> {
    fn show(v: T) -> i32;
}

struct Wrap<T> { v: T }

impl Show<i32> for i32 {
    fn show(v: i32) -> i32 {
        return v;
    }
}

impl<T> Wrap<T> where T: Show<T> {
    fn get(self) -> T {
        let x: T = self.v;
        return x;
    }
}

fn top(b: bool) -> bool {
    let w: Wrap<bool> = Wrap { v: b };
    return w.get();
}
