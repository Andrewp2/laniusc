// A method of an impl for a primitive type, called through the type name.
trait Hash<T> {
    fn hash(value: T) -> u32;
}

impl Hash<i32> for i32 {
    fn hash(value: i32) -> u32 {
        return value as u32;
    }
}

impl Hash<bool> for bool {
    fn hash(value: bool) -> u32 {
        if (value) {
            return 1;
        }
        return 0;
    }
}

fn top(n: i32, b: bool) -> u32 {
    let h: u32 = i32::hash(n);
    return h + bool::hash(b);
}
