// `first` is called at bool, which has no impl of Hash: rejected, although
// the body does not use the bound (laniusc rejects it too).
trait Hash<T> {
    fn hash(value: T) -> u32;
}

impl Hash<i32> for i32 {
    fn hash(value: i32) -> u32 {
        return value as u32;
    }
}

fn first<T: Hash<T> >(x: T, y: T) -> T {
    return x;
}

fn top(b: bool) -> bool {
    return first(b, b);
}
