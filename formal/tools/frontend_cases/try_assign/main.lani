module app::main;

// `?` as an assigned value: on a call and on a local, for Result and Option.
import core::result;
import core::option;

fn half(n: i32) -> core::result::Result<i32, i32> {
    if (n < 0) {
        return Err(n);
    }
    return Ok(n + 1);
}

fn step(n: i32) -> core::result::Result<i32, i32> {
    let a: i32 = 0;
    a = half(n)?;
    let r: core::result::Result<i32, i32> = half(a);
    a = r?;
    return Ok(a);
}

fn first(o: core::option::Option<i32>) -> core::option::Option<i32> {
    let v: i32 = 1;
    v = o?;
    return Some(v + 1);
}

fn top(n: i32) -> i32 {
    let s: core::result::Result<i32, i32> = step(n);
    let a: i32 = match (s) { Ok(v) -> v, Err(e) -> 0 - e };
    let f: core::option::Option<i32> = first(Some(n));
    let b: i32 = match (f) { Some(x) -> x, None -> 2 };
    return a + b;
}
