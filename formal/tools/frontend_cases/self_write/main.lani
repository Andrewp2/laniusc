// A write through `&self` (F5, S5b): self is a reference, so the write
// lands in the caller's value, as in laniusc (top(5) is 12). Nothing lowers
// references yet, so this is read, not compiled.
struct C { n: i32 }

impl C {
    fn bump(&self) -> i32 {
        self.n = self.n + 1;
        return self.n;
    }
}

fn top(k: i32) -> i32 {
    let c: C = C { n: k };
    let a: i32 = c.bump();
    return c.n + a;
}
