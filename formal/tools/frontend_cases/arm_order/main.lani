// The script numbers locals in source order, so the arms with binders keep
// their variant order here; the arms without any move.
enum Shape { Dot, Line(i32), Box(i32, i32) }

fn area(s: Shape) -> i32 {
    return match (s) { Line(k) -> 0, Dot -> 0, Box(w, h) -> w * h };
}

fn run(n: i32) -> i32 {
    let s: Shape = Line(n);
    let a: i32 = match (s) { Line(k) -> k, Box(w, h) -> w + h, Dot -> 1 };
    let b: i32 = area(s) + match (s) { Line(k) -> k + 1, Box(w, h) -> h, Dot -> 2 };
    return a + b;
}
