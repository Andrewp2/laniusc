module app::main;

const MIN: i32 = -2147483648;
const BIG: u64 = 18446744073709551615;
const U: u32 = 4000000000;
const NEG: isize = -9223372036854775808;
const POS: isize = 9223372036854775807;
const SMALL: isize = -12;
const S: usize = 5;
const FLAG: bool = true;

fn top(n: i32) -> i32 {
    let a: i32 = n + MIN;
    let b: u64 = BIG & (n as u64);
    let c: u32 = U;
    let d: isize = NEG + POS + SMALL;
    let e: usize = S + std::vec::byte_limit();
    let k: i32 = std::vec::MAX_CAPACITY - n;
    if (FLAG) {
        a = a + k;
    }
    return a + (b as i32) + (c as i32) + (d as i32) + (e as i32);
}
