type Single = f32;

struct V { x: Single, y: f64 }

fn mix(a: Single, b: f32, c: f64, n: i32) -> f64 {
    let s: f32 = a * b - (n as f32);
    let v: V = V { x: s, y: c };
    if (a < b || a >= b && a != b) {
        v.y = v.y + (s as f64);
    }
    if (c <= c || c > -c) {
        return -c;
    }
    return v.y * ((v.x as f64) - ((v.y as f32) as f64));
}

fn twice(x: f64) -> f64 {
    return mix(1 as f32, 2 as f32, x, 3) + mix(1 as f32, 2 as f32, x, 3);
}

const HALF: f32 = 0.5;
const TINY: f64 = 2.2250738585072014e-308;
const NEG: f64 = -1.5e3;
const BIG: f32 = 3.4028234663852886e38;

fn lits(x: f64, y: f32) -> f64 {
    let a: f32 = 1.0;
    let b: f64 = x * 0.1 + TINY;
    if (x < 3.25e-1 || y > BIG) {
        return NEG;
    }
    if (y == -0.0) {
        return 1e400;
    }
    return b - (HALF as f64) + (a as f64) - 0.0000001;
}
