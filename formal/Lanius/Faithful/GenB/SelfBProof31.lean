    simp only [src_ty_weight, List.length_cons, List.length_nil, if_true] at h ⊢
    rw [Pre_ty_weight.eq_def] at pre
    simp only at pre
    budget
  exact ⟨key.1, key.2, back.out (pcall_of_q key.1) r0 r1 r2⟩

