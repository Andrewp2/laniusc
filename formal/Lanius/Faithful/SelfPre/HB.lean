def hbMEff : Lanius.Mini.MEff → Nat
  | .xPure a0 => hb a0
  | .xCall a0 a1 => max (hb a0) (hbMEff0 a1)
  | .xApply a0 a1 a2 => max (hbMEff a1) (hbMEff a2)
  | .xNeg a0 => hbMEff a0
  | .xNot a0 => hbMEff a0
  | .xCast a0 a1 => max (hb a0) (hbMEff a1)
  | .xIndex a0 a1 => hbMEff a1
  | .xStruct a0 a1 => max (hb a0) (hbMEff0 a1)
  | .xVariant a0 a1 a2 => max (hb a0) (hbMEff0 a2)
  | .xMatch a0 a1 a2 a3 a4 => max (hbMEff a0) (max (hb a1) (max (hb a2) (max (hb a3) (hbMEff0 a4))))
  | .xDivide a0 a1 a2 => max (hbMEff a1) (hbMEff a2)
  | .xStride a0 => 0
  | .xArraySlice a0 a1 => hb a0
  | .xHost a0 a1 => hbMEff0 a1
  | .xIf a0 a1 a2 a3 => max (hbMEff a0) (max (hb a1) (max (hbMEff a2) (hbMEff a3)))
  | .xLet a0 a1 a2 a3 a4 => max (hb a1) (max (hbMEff a2) (max (hb a3) (hbMEff a4)))
  | .xLen a0 => 0
  | .xStr a0 => hb a0
def hbMEff0 : List Lanius.Mini.MEff → Nat
  | [] => 0
  | a :: l => max (hbMEff a) (hbMEff0 l) + 1
end
instance : HB Lanius.Mini.MEff := ⟨hbMEff⟩
theorem hbMEff0_eq : ∀ l : List Lanius.Mini.MEff, hbMEff0 l = HB.hb l
  | [] => rfl
  | a :: l => by
    show max _ _ + 1 = max _ _ + 1
    (rw [hbMEff0_eq l]) <;> rfl
