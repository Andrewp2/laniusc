def hbCTree : Lanius.Mini.CTree → Nat
  | .leaf a0 => hb a0
  | .node a0 a1 => hbCTree0 a1
def hbCTree0 : List Lanius.Mini.CTree → Nat
  | [] => 0
  | a :: l => max (hbCTree a) (hbCTree0 l) + 1
end
instance : HB Lanius.Mini.CTree := ⟨hbCTree⟩
theorem hbCTree0_eq : ∀ l : List Lanius.Mini.CTree, hbCTree0 l = HB.hb l
  | [] => rfl
  | a :: l => by
    show max _ _ + 1 = max _ _ + 1
    (rw [hbCTree0_eq l]) <;> rfl
@[simp, hb_simp] theorem hb_CTree_leaf (a0 : Lanius.Mini.Token) : hb (Lanius.Mini.CTree.leaf a0) = hb a0 := rfl
@[simp, hb_simp] theorem hb_CTree_node (a0 : Nat) (a1 : List Lanius.Mini.CTree) : hb (Lanius.Mini.CTree.node a0 a1) = hb a1 := by show hbCTree _ = _; simp only [hbCTree, hbCTree0_eq] <;> rfl

