def hbMStmt : Lanius.Mini.MStmt → Nat
  | .mNop => 0
  | .mLet a0 a1 a2 a3 => max (hb a1) (max (hb a2) (hbMStmt a3))
  | .mLetStruct a0 a1 a2 a3 => max (hb a1) (max (hb a2) (hbMStmt a3))
  | .mLetCall a0 a1 a2 a3 a4 => max (hb a1) (max (hb a2) (max (hb a3) (hbMStmt a4)))
  | .mLetEnum a0 a1 a2 a3 a4 => max (hb a1) (max (hb a3) (hbMStmt a4))
  | .mLetMatch a0 a1 a2 a3 a4 a5 => max (hb a1) (max (hb a3) (max (hb a4) (hbMStmt a5)))
  | .mSet a0 a1 => hb a1
  | .mSetField a0 a1 a2 => hb a2
  | .mSetCall a0 a1 a2 => max (hb a1) (hb a2)
  | .mThen a0 a1 => max (hbMStmt a0) (hbMStmt a1)
  | .mIf a0 a1 a2 => max (hb a0) (max (hbMStmt a1) (hbMStmt a2))
  | .mWhile a0 a1 => max (hb a0) (hbMStmt a1)
  | .mReturn a0 => hb a0
  | .mLetAlloc a0 a1 a2 a3 => max (hb a1) (hbMStmt a3)
  | .mFree a0 a1 a2 => max (hb a0) (hb a1)
  | .mLetSlice a0 a1 a2 a3 a4 => max (hb a1) (max (hb a2) (max (hb a3) (hbMStmt a4)))
  | .mLetIndex a0 a1 a2 a3 a4 => max (hb a1) (max (hb a3) (hbMStmt a4))
  | .mLetView a0 a1 a2 a3 a4 => max (hb a2) (hbMStmt a4)
  | .mLetStr a0 a1 a2 => max (hb a1) (hbMStmt a2)
  | .mSetIndex a0 a1 a2 => max (hb a1) (hb a2)
  | .mLetEval a0 a1 a2 a3 => max (hb a1) (max (hb a2) (hbMStmt a3))
  | .mSetEval a0 a1 => hb a1
  | .mIfEval a0 a1 a2 => max (hb a0) (max (hbMStmt a1) (hbMStmt a2))
  | .mWhileEval a0 a1 => max (hb a0) (hbMStmt a1)
  | .mReturnEval a0 => hb a0
  | .mDiscard a0 => hb a0
  | .mSetIndexEval a0 a1 a2 => max (hb a1) (hb a2)
  | .mSetFieldEval a0 a1 a2 => hb a2
  | .mReturnUnit => 0
  | .mAssert a0 => hb a0
  | .mBreak => 0
  | .mContinue => 0
  | .mMatchArm a0 a1 a2 a3 a4 a5 a6 a7 => max (hb a1) (max (hb a5) (max (hbMStmt a6) (hbMStmt a7)))
  | .mUnreachable a0 a1 => hb a1
end
