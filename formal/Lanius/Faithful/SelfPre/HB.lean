@[simp, hb_simp] theorem hb_FilesRead_mk (a0 : List Lanius.Mini.FileInput) (a1 : List (BitVec 32)) : hb (Lanius.Mini.FilesRead.mk a0 a1) = max (hb a0) (hb a1) := rfl
theorem hb_le_FilesRead_files (s : Lanius.Mini.FilesRead) : hb s.files ≤ hb s := by
  show _ ≤ max (hb s.files) (hb s.rest)
  omega
theorem hb_le_FilesRead_rest (s : Lanius.Mini.FilesRead) : hb s.rest ≤ hb s := by
  show _ ≤ max (hb s.files) (hb s.rest)
  omega

end Lanius.Faithful.SelfPre
