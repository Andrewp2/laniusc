theorem post_collect_files : ∀ (n : Nat) (x0 : Nat) (x1 : List Lanius.Mini.CTree) (x2 : Lanius.Mini.Collected), ∀ M : Nat, hb x1 ≤ M → hb x2 ≤ M → Cost_collect_files n x0 x1 x2 < 18446744073709551616 → hb (Lanius.Mini.collectFiles x0 x1 x2) ≤ M + Cost_collect_files n x0 x1 x2 :=
  fun n => (post_group_collect_files n).1
theorem post_collect_file_next : ∀ (n : Nat) (x0 : Nat) (x1 : Lanius.Mini.Collected) (x2 : Option Lanius.Mini.FileDecls) (x3 : List Lanius.Mini.CTree), ∀ M : Nat, hb x1 ≤ M → hb x2 ≤ M → hb x3 ≤ M → Cost_collect_file_next n x0 x1 x2 x3 < 18446744073709551616 → hb (Lanius.Mini.Inline.collectFileNext x0 x1 x2 x3) ≤ M + Cost_collect_file_next n x0 x1 x2 x3 :=
  fun n => (post_group_collect_files n).2

theorem post_build_files : ∀ (n : Nat) (x0 : Nat) (x1 : List Lanius.Mini.CTree), ∀ M : Nat, hb x1 ≤ M → Cost_build_files n x0 x1 < 18446744073709551616 → hb (Lanius.Mini.buildFiles x0 x1) ≤ M + Cost_build_files n x0 x1 := by
  intro n x0 x1 M hM0
  rcases n with _ | n
  · intro h; exact absurd h (Nat.lt_irrefl _)
  rw [Cost_build_files.eq_def]; dsimp only
  rw [Lanius.Mini.buildFiles.eq_def x0 x1]
  post_auto n, M

end Lanius.Faithful.SelfPre
