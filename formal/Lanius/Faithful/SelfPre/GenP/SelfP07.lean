    (∀ (x0 : Lanius.Mini.TypeDecl) (x1 : List Lanius.Mini.TypeDecl) (x2 : Nat) (b : Nat), ∀ M : Nat, hb x0 ≤ M → hb x1 ≤ M → M + b ≤ 4611686018427387904 → x2 + hb (x0 :: x1) + b ≤ 4611686018427387904 → Pre_seed_at n x0 x1 x2 b) := by
  intro n
  induction n with
  | zero => exact ⟨fun x0 x1 b M _ _ _ => trivial, fun x0 x1 x2 b M _ _ _ _ => trivial⟩
  | succ n ih => exact ⟨pre_step_seed_insts n ih, pre_step_seed_at n ih⟩
theorem pre_seed_insts : ∀ (n : Nat) (x0 : List Lanius.Mini.TypeDecl) (x1 : Nat) (b : Nat), ∀ M : Nat, hb x0 ≤ M → M + b ≤ 4611686018427387904 → x1 + hb x0 + b ≤ 4611686018427387904 → Pre_seed_insts n x0 x1 b :=
  fun n => (pre_group_seed_insts n).1
theorem pre_seed_at : ∀ (n : Nat) (x0 : Lanius.Mini.TypeDecl) (x1 : List Lanius.Mini.TypeDecl) (x2 : Nat) (b : Nat), ∀ M : Nat, hb x0 ≤ M → hb x1 ≤ M → M + b ≤ 4611686018427387904 → x2 + hb (x0 :: x1) + b ≤ 4611686018427387904 → Pre_seed_at n x0 x1 x2 b :=
  fun n => (pre_group_seed_insts n).2

theorem pre_build_collected : ∀ (n : Nat) (x0 : Nat) (x1 : Lanius.Mini.FileDecls) (x2 : Option Lanius.Mini.Collected) (b : Nat), ∀ M : Nat, hb x1 ≤ M → hb x2 ≤ M → M + b ≤ 4611686018427387904 → Pre_build_collected n x0 x1 x2 b := by
  intro n x0 x1 x2 b M h0 h1 h2
  rcases n with _ | n
  · exact trivial
  rw [Pre_build_collected.eq_def]; dsimp only
  pre_auto n, M

theorem pre_build_files : ∀ (n : Nat) (x0 : Nat) (x1 : List Lanius.Mini.CTree) (b : Nat), ∀ M : Nat, hb x1 ≤ M → M + b ≤ 4611686018427387904 → Pre_build_files n x0 x1 b := by
  intro n x0 x1 b M h0 h1
  rcases n with _ | n
  · exact trivial
  rw [Pre_build_files.eq_def]; dsimp only
  pre_auto n, M

