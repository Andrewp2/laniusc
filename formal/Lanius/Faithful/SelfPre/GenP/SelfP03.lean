theorem post_group_collect_files : ∀ n : Nat,
    (∀ (x0 : Nat) (x1 : List Lanius.Mini.CTree) (x2 : Lanius.Mini.Collected), ∀ M : Nat, hb x1 ≤ M → hb x2 ≤ M → Cost_collect_files n x0 x1 x2 < 18446744073709551616 → hb (Lanius.Mini.collectFiles x0 x1 x2) ≤ M + Cost_collect_files n x0 x1 x2) ∧
