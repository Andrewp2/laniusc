theorem post_trait_of_bound : ∀ (n : Nat) (x0 : Nat) (x1 : Lanius.Mini.FrontEnv) (x2 : Lanius.Mini.CTree), ∀ M : Nat, hb x1 ≤ M → hb x2 ≤ M → Cost_trait_of_bound n x0 x1 x2 < 18446744073709551616 → hb (Lanius.Mini.traitOfBound x0 x1 x2) ≤ M + Cost_trait_of_bound n x0 x1 x2 := by
  intro n x0 x1 x2 M hM0 hM1
  rcases n with _ | n
  · intro h; exact absurd h (Nat.lt_irrefl _)
  rw [Cost_trait_of_bound.eq_def]; dsimp only
  rw [Lanius.Mini.traitOfBound.eq_def x0 x1 x2]
  post_auto n, M

theorem post_step_goals_of (n : Nat) (ih :
    (∀ (x0 : Nat) (x1 : Lanius.Mini.FrontEnv) (x2 : List Nat) (x3 : List Lanius.Mini.CTree), ∀ M : Nat, hb x1 ≤ M → hb x2 ≤ M → hb x3 ≤ M → Cost_goals_of n x0 x1 x2 x3 < 18446744073709551616 → hb (Lanius.Mini.goalsOf x0 x1 x2 x3) ≤ M + Cost_goals_of n x0 x1 x2 x3)) :
    ∀ (x0 : Nat) (x1 : Lanius.Mini.FrontEnv) (x2 : List Nat) (x3 : List Lanius.Mini.CTree), ∀ M : Nat, hb x1 ≤ M → hb x2 ≤ M → hb x3 ≤ M → Cost_goals_of (n + 1) x0 x1 x2 x3 < 18446744073709551616 → hb (Lanius.Mini.goalsOf x0 x1 x2 x3) ≤ M + Cost_goals_of (n + 1) x0 x1 x2 x3 := by
  have post_goals_of := ih
  intro x0 x1 x2 x3 M hM0 hM1 hM2
  rw [Cost_goals_of.eq_def]; dsimp only
  rw [Lanius.Mini.goalsOf.eq_def x0 x1 x2 x3]
  post_auto n, M
theorem post_group_goals_of : ∀ n : Nat,
    (∀ (x0 : Nat) (x1 : Lanius.Mini.FrontEnv) (x2 : List Nat) (x3 : List Lanius.Mini.CTree), ∀ M : Nat, hb x1 ≤ M → hb x2 ≤ M → hb x3 ≤ M → Cost_goals_of n x0 x1 x2 x3 < 18446744073709551616 → hb (Lanius.Mini.goalsOf x0 x1 x2 x3) ≤ M + Cost_goals_of n x0 x1 x2 x3) := by
  intro n
  induction n with
  | zero => exact fun x0 x1 x2 x3 M hM0 hM1 hM2 h => absurd h (Nat.lt_irrefl _)
  | succ n ih => exact post_step_goals_of n ih
theorem post_goals_of : ∀ (n : Nat) (x0 : Nat) (x1 : Lanius.Mini.FrontEnv) (x2 : List Nat) (x3 : List Lanius.Mini.CTree), ∀ M : Nat, hb x1 ≤ M → hb x2 ≤ M → hb x3 ≤ M → Cost_goals_of n x0 x1 x2 x3 < 18446744073709551616 → hb (Lanius.Mini.goalsOf x0 x1 x2 x3) ≤ M + Cost_goals_of n x0 x1 x2 x3 :=
  fun n => (post_group_goals_of n)

