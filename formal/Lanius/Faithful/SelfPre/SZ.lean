def szMEff : Lanius.Mini.MEff → Nat
  | .xPure a0 => sz a0 + 1
  | .xCall a0 a1 => sz a0 + (szMEff0 a1) + 1
  | .xApply a0 a1 a2 => (szMEff a1) + (szMEff a2) + 1
  | .xNeg a0 => (szMEff a0) + 1
  | .xNot a0 => (szMEff a0) + 1
  | .xCast a0 a1 => sz a0 + (szMEff a1) + 1
  | .xIndex a0 a1 => (szMEff a1) + 1
  | .xStruct a0 a1 => sz a0 + (szMEff0 a1) + 1
  | .xVariant a0 a1 a2 => sz a0 + (szMEff0 a2) + 1
  | .xMatch a0 a1 a2 a3 a4 => (szMEff a0) + sz a1 + sz a2 + sz a3 + (szMEff0 a4) + 1
  | .xDivide a0 a1 a2 => (szMEff a1) + (szMEff a2) + 1
  | .xStride a0 => 1
  | .xArraySlice a0 a1 => sz a0 + 1
  | .xHost a0 a1 => (szMEff0 a1) + 1
  | .xIf a0 a1 a2 a3 => (szMEff a0) + sz a1 + (szMEff a2) + (szMEff a3) + 1
  | .xLet a0 a1 a2 a3 a4 => sz a1 + (szMEff a2) + sz a3 + (szMEff a4) + 1
  | .xLen a0 => 1
def szMEff0 : List Lanius.Mini.MEff → Nat
  | [] => 0
  | a :: l => szMEff a + szMEff0 l + 1
end
instance : SZ Lanius.Mini.MEff := ⟨szMEff⟩
theorem szMEff0_eq : ∀ l : List Lanius.Mini.MEff, szMEff0 l = SZ.sz l
  | [] => rfl
  | a :: l => by
    show _ + _ + 1 = _ + _ + 1
    (rw [szMEff0_eq l]) <;> rfl
