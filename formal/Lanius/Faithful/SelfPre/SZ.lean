def szMStmt : Lanius.Mini.MStmt → Nat
  | .mNop => 1
  | .mLet a0 a1 a2 a3 => sz a1 + sz a2 + (szMStmt a3) + 1
  | .mLetStruct a0 a1 a2 a3 => sz a1 + sz a2 + (szMStmt a3) + 1
  | .mLetCall a0 a1 a2 a3 a4 => sz a1 + sz a2 + sz a3 + (szMStmt a4) + 1
  | .mLetEnum a0 a1 a2 a3 a4 => sz a1 + sz a3 + (szMStmt a4) + 1
  | .mLetMatch a0 a1 a2 a3 a4 a5 => sz a1 + sz a3 + sz a4 + (szMStmt a5) + 1
  | .mSet a0 a1 => sz a1 + 1
  | .mSetField a0 a1 a2 => sz a2 + 1
  | .mSetCall a0 a1 a2 => sz a1 + sz a2 + 1
  | .mThen a0 a1 => (szMStmt a0) + (szMStmt a1) + 1
  | .mIf a0 a1 a2 => sz a0 + (szMStmt a1) + (szMStmt a2) + 1
  | .mWhile a0 a1 => sz a0 + (szMStmt a1) + 1
  | .mReturn a0 => sz a0 + 1
  | .mLetAlloc a0 a1 a2 a3 => sz a1 + (szMStmt a3) + 1
  | .mFree a0 a1 a2 => sz a0 + sz a1 + 1
  | .mLetSlice a0 a1 a2 a3 a4 => sz a1 + sz a2 + sz a3 + (szMStmt a4) + 1
  | .mLetIndex a0 a1 a2 a3 a4 => sz a1 + sz a3 + (szMStmt a4) + 1
  | .mLetView a0 a1 a2 a3 a4 => sz a2 + (szMStmt a4) + 1
  | .mLetStr a0 a1 a2 => sz a1 + (szMStmt a2) + 1
  | .mSetIndex a0 a1 a2 => sz a1 + sz a2 + 1
  | .mLetEval a0 a1 a2 a3 => sz a1 + sz a2 + (szMStmt a3) + 1
  | .mSetEval a0 a1 => sz a1 + 1
  | .mIfEval a0 a1 a2 => sz a0 + (szMStmt a1) + (szMStmt a2) + 1
  | .mWhileEval a0 a1 => sz a0 + (szMStmt a1) + 1
  | .mReturnEval a0 => sz a0 + 1
  | .mDiscard a0 => sz a0 + 1
  | .mSetIndexEval a0 a1 a2 => sz a1 + sz a2 + 1
  | .mSetFieldEval a0 a1 a2 => sz a2 + 1
  | .mReturnUnit => 1
  | .mAssert a0 => sz a0 + 1
  | .mBreak => 1
  | .mContinue => 1
  | .mMatchArm a0 a1 a2 a3 a4 a5 a6 a7 => sz a1 + sz a5 + (szMStmt a6) + (szMStmt a7) + 1
  | .mUnreachable a0 a1 => sz a1 + 1
end
