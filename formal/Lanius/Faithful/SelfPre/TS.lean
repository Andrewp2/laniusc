def tsSrcStmt : Lanius.Mini.SrcStmt → Nat
  | .nop => 0
  | .let a0 a1 a2 a3 => max (ts a1) (max (ts a2) (tsSrcStmt a3))
  | .letStruct a0 a1 a2 a3 => max (ts a1) (max (ts a2) (tsSrcStmt a3))
  | .letCall a0 a1 a2 a3 a4 => max (ts a1) (max (ts a3) (tsSrcStmt a4))
  | .letEnum a0 a1 a2 a3 a4 => max (ts a1) (max (ts a3) (tsSrcStmt a4))
  | .letMatch a0 a1 a2 a3 a4 a5 => max (ts a1) (max (ts a4) (tsSrcStmt a5))
  | .set a0 a1 => ts a1
  | .setField a0 a1 a2 => ts a2
  | .setCall a0 a1 a2 => ts a2
  | .then a0 a1 => max (tsSrcStmt a0) (tsSrcStmt a1)
  | .if a0 a1 a2 => max (ts a0) (max (tsSrcStmt a1) (tsSrcStmt a2))
  | .while a0 a1 => max (ts a0) (tsSrcStmt a1)
  | .return a0 => ts a0
  | .letAlloc a0 a1 a2 a3 => max (ts a1) (tsSrcStmt a3)
  | .letLoad a0 a1 a2 a3 => max (ts a1) (max (ts a2) (tsSrcStmt a3))
  | .setByte a0 a1 a2 => max (ts a0) (max (ts a1) (ts a2))
  | .free a0 a1 a2 => max (ts a0) (ts a1)
  | .letSlice a0 a1 a2 a3 a4 => max (ts a1) (max (ts a2) (max (ts a3) (tsSrcStmt a4)))
  | .letIndex a0 a1 a2 a3 a4 => max (ts a1) (max (ts a3) (tsSrcStmt a4))
  | .setIndex a0 a1 a2 => max (ts a1) (ts a2)
  | .letEval a0 a1 a2 a3 => max (ts a1) (max (ts a2) (tsSrcStmt a3))
  | .setEval a0 a1 => ts a1
  | .ifEval a0 a1 a2 => max (ts a0) (max (tsSrcStmt a1) (tsSrcStmt a2))
  | .whileEval a0 a1 => max (ts a0) (tsSrcStmt a1)
  | .returnEval a0 => ts a0
  | .discard a0 => ts a0
  | .setIndexEval a0 a1 a2 => max (ts a1) (ts a2)
  | .setFieldEval a0 a1 a2 => ts a2
  | .returnUnit => 0
  | .assert a0 => ts a0
  | .break => 0
  | .continue => 0
  | .matchArm a0 a1 a2 a3 a4 a5 a6 a7 => max (ts a5) (max (tsSrcStmt a6) (tsSrcStmt a7))
  | .unreachable a0 a1 => ts a1
  | .letView a0 a1 a2 a3 a4 => max (ts a2) (tsSrcStmt a4)
  | .letStr a0 a1 a2 => tsSrcStmt a2
  | .setPlace a0 a1 => max (ts a0) (ts a1)
  | .setPlaceOp a0 a1 a2 => max (ts a1) (ts a2)
end
