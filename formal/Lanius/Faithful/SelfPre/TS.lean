def tsMStmt : Lanius.Mini.MStmt → Nat
  | .mNop => 0
  | .mLet a0 a1 a2 a3 => max (ts a2) (tsMStmt a3)
  | .mLetStruct a0 a1 a2 a3 => max (ts a2) (tsMStmt a3)
  | .mLetCall a0 a1 a2 a3 a4 => max (ts a3) (tsMStmt a4)
  | .mLetEnum a0 a1 a2 a3 a4 => max (ts a3) (tsMStmt a4)
  | .mLetMatch a0 a1 a2 a3 a4 a5 => max (ts a4) (tsMStmt a5)
  | .mSet a0 a1 => ts a1
  | .mSetField a0 a1 a2 => ts a2
  | .mSetCall a0 a1 a2 => ts a2
  | .mThen a0 a1 => max (tsMStmt a0) (tsMStmt a1)
  | .mIf a0 a1 a2 => max (ts a0) (max (tsMStmt a1) (tsMStmt a2))
  | .mWhile a0 a1 => max (ts a0) (tsMStmt a1)
  | .mReturn a0 => ts a0
  | .mLetAlloc a0 a1 a2 a3 => max (ts a1) (tsMStmt a3)
  | .mFree a0 a1 a2 => max (ts a0) (ts a1)
  | .mLetSlice a0 a1 a2 a3 a4 => max (ts a2) (max (ts a3) (tsMStmt a4))
  | .mLetIndex a0 a1 a2 a3 a4 => max (ts a3) (tsMStmt a4)
  | .mLetView a0 a1 a2 a3 a4 => max (ts a2) (tsMStmt a4)
  | .mLetStr a0 a1 a2 => tsMStmt a2
  | .mSetIndex a0 a1 a2 => max (ts a1) (ts a2)
  | .mLetEval a0 a1 a2 a3 => max (ts a2) (tsMStmt a3)
  | .mSetEval a0 a1 => ts a1
  | .mIfEval a0 a1 a2 => max (ts a0) (max (tsMStmt a1) (tsMStmt a2))
  | .mWhileEval a0 a1 => max (ts a0) (tsMStmt a1)
  | .mReturnEval a0 => ts a0
  | .mDiscard a0 => ts a0
  | .mSetIndexEval a0 a1 a2 => max (ts a1) (ts a2)
  | .mSetFieldEval a0 a1 a2 => ts a2
  | .mReturnUnit => 0
  | .mAssert a0 => ts a0
  | .mBreak => 0
  | .mContinue => 0
  | .mMatchArm a0 a1 a2 a3 a4 a5 a6 a7 => max (tsMStmt a6) (tsMStmt a7)
  | .mUnreachable a0 a1 => 0
  | .mSetPlace a0 a1 => max (ts a0) (ts a1)
  | .mSetPlaceOp a0 a1 a2 => max (ts a1) (ts a2)
end
