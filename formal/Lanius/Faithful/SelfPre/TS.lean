def tsMEff : Lanius.Mini.MEff → Nat
  | .xPure a0 => ts a0
  | .xCall a0 a1 => tsMEff0 a1
  | .xApply a0 a1 a2 => max (tsMEff a1) (tsMEff a2)
  | .xNeg a0 => tsMEff a0
  | .xNot a0 => tsMEff a0
  | .xCast a0 a1 => max (ts a0) (tsMEff a1)
  | .xIndex a0 a1 => tsMEff a1
  | .xStruct a0 a1 => tsMEff0 a1
  | .xVariant a0 a1 a2 => tsMEff0 a2
  | .xMatch a0 a1 a2 a3 a4 => max (tsMEff a0) (tsMEff0 a4)
  | .xDivide a0 a1 a2 => max (tsMEff a1) (tsMEff a2)
  | .xStride a0 => 0
  | .xArraySlice a0 a1 => 0
  | .xHost a0 a1 => tsMEff0 a1
  | .xIf a0 a1 a2 a3 => max (tsMEff a0) (max (tsMEff a2) (tsMEff a3))
  | .xLet a0 a1 a2 a3 a4 => max (tsMEff a2) (tsMEff a4)
  | .xLen a0 => 0
  | .xStr a0 => 0
  | .xDeref a0 a1 => tsMEff a1
  | .xPlaceField a0 a1 => tsMEff a0
  | .xPlaceAt a0 a1 => max (tsMEff a0) (tsMEff a1)
def tsMEff0 : List Lanius.Mini.MEff → Nat
  | [] => 0
  | a :: l => max (tsMEff a) (tsMEff0 l)
end
instance : TS Lanius.Mini.MEff := ⟨tsMEff⟩
theorem tsMEff0_eq : ∀ l : List Lanius.Mini.MEff, tsMEff0 l = TS.ts l
  | [] => rfl
  | a :: l => by
    show max _ _ = max _ _
    (rw [tsMEff0_eq l]) <;> rfl
@[simp, ts_simp] theorem ts_MEff_xPure (a0 : Lanius.Mini.SrcExpr) : ts (Lanius.Mini.MEff.xPure a0) = ts a0 := rfl
@[simp, ts_simp] theorem ts_MEff_xCall (a0 : Lanius.Mini.Inst) (a1 : List Lanius.Mini.MEff) : ts (Lanius.Mini.MEff.xCall a0 a1) = ts a1 := by show tsMEff _ = _; simp only [tsMEff, tsMEff0_eq] <;> rfl
