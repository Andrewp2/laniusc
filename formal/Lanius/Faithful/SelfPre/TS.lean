def tsSrcEff : Lanius.Mini.SrcEff → Nat
  | .ePure a0 => ts a0
  | .eCall a0 a1 => tsSrcEff0 a1
  | .eApply a0 a1 a2 => max (tsSrcEff a1) (tsSrcEff a2)
  | .eNeg a0 => tsSrcEff a0
  | .eNot a0 => tsSrcEff a0
  | .eCast a0 a1 => max (ts a0) (tsSrcEff a1)
  | .eIndex a0 a1 => tsSrcEff a1
  | .eStruct a0 a1 => max (ts a0) (tsSrcEff0 a1)
  | .eVariant a0 a1 a2 => max (ts a0) (tsSrcEff0 a2)
  | .eMatch a0 a1 a2 a3 a4 => max (tsSrcEff a0) (max (ts a1) (max (ts a2) (tsSrcEff0 a4)))
  | .eDivide a0 a1 a2 => max (tsSrcEff a1) (tsSrcEff a2)
  | .eStride a0 => 0
  | .arraySlice a0 a1 => ts a0
  | .eIf a0 a1 a2 a3 => max (tsSrcEff a0) (max (ts a1) (max (tsSrcEff a2) (tsSrcEff a3)))
  | .eLet a0 a1 a2 a3 a4 => max (ts a1) (max (tsSrcEff a2) (max (ts a3) (tsSrcEff a4)))
  | .eLen a0 => 0
  | .eStr a0 a1 => 0
  | .eBorrow a0 a1 => max (ts a0) (tsSrcEff a1)
  | .eDeref a0 a1 => max (ts a0) (tsSrcEff a1)
  | .eField a0 a1 => tsSrcEff a0
  | .eAt a0 a1 => max (tsSrcEff a0) (tsSrcEff a1)
def tsSrcEff0 : List Lanius.Mini.SrcEff → Nat
  | [] => 0
  | a :: l => max (tsSrcEff a) (tsSrcEff0 l)
end
instance : TS Lanius.Mini.SrcEff := ⟨tsSrcEff⟩
theorem tsSrcEff0_eq : ∀ l : List Lanius.Mini.SrcEff, tsSrcEff0 l = TS.ts l
  | [] => rfl
  | a :: l => by
    show max _ _ = max _ _
    (rw [tsSrcEff0_eq l]) <;> rfl
