def tsSrcExpr : Lanius.Mini.SrcExpr → Nat
  | .int a0 => 0
  | .boolean a0 => 0
  | .unsigned a0 a1 => 0
  | .local a0 => 0
  | .field a0 a1 => 0
  | .negate a0 => tsSrcExpr a0
  | .not a0 => tsSrcExpr a0
  | .apply a0 a1 a2 => max (tsSrcExpr a1) (tsSrcExpr a2)
  | .cast a0 a1 => max (ts a0) (tsSrcExpr a1)
  | .null => 0
  | .char a0 => 0
  | .float a0 a1 => 0
end
