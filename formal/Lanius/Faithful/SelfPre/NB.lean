  | .letStr a0 a1 a2 => max (nb a0) (max (nb a1) (nbSrcStmt a2))
  | .setPlace a0 a1 => max (nb a0) (nb a1)
  | .setPlaceOp a0 a1 a2 => max (nb a1) (nb a2)
