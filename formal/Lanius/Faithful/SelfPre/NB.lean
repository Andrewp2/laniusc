def nbMEff : Lanius.Mini.MEff → Nat
  | .xPure a0 => nb a0
  | .xCall a0 a1 => max (nb a0) (nbMEff0 a1)
  | .xApply a0 a1 a2 => max (nbMEff a1) (nbMEff a2)
  | .xNeg a0 => nbMEff a0
  | .xNot a0 => nbMEff a0
  | .xCast a0 a1 => max (nb a0) (nbMEff a1)
  | .xIndex a0 a1 => max (nb a0) (nbMEff a1)
  | .xStruct a0 a1 => max (nb a0) (nbMEff0 a1)
  | .xVariant a0 a1 a2 => max (nb a0) (max (nb a1) (nbMEff0 a2))
  | .xMatch a0 a1 a2 a3 a4 => max (nbMEff a0) (max (nb a1) (max (nb a2) (max (nb a3) (nbMEff0 a4))))
  | .xDivide a0 a1 a2 => max (nbMEff a1) (nbMEff a2)
  | .xStride a0 => nb a0
  | .xArraySlice a0 a1 => max (nb a0) (nb a1)
  | .xHost a0 a1 => max (nb a0) (nbMEff0 a1)
  | .xIf a0 a1 a2 a3 => max (nbMEff a0) (max (nb a1) (max (nbMEff a2) (nbMEff a3)))
  | .xLet a0 a1 a2 a3 a4 => max (nb a0) (max (nb a1) (max (nbMEff a2) (max (nb a3) (nbMEff a4))))
  | .xLen a0 => nb a0
  | .xStr a0 => nb a0
  | .xDeref a0 a1 => max (nb a0) (nbMEff a1)
  | .xPlaceField a0 a1 => max (nbMEff a0) (nb a1)
  | .xPlaceAt a0 a1 => max (nbMEff a0) (nbMEff a1)
  | .xBorrow a0 a1 => max (nb a0) (nbMEff a1)
def nbMEff0 : List Lanius.Mini.MEff → Nat
  | [] => 0
  | a :: l => max (nbMEff a) (nbMEff0 l)
end
instance : NB Lanius.Mini.MEff := ⟨nbMEff⟩
theorem nbMEff0_eq : ∀ l : List Lanius.Mini.MEff, nbMEff0 l = NB.nb l
  | [] => rfl
  | a :: l => by
    show max _ _ = max _ _
    (rw [nbMEff0_eq l]) <;> rfl
@[simp, nb_simp] theorem nb_MEff_xPure (a0 : Lanius.Mini.SrcExpr) : nb (Lanius.Mini.MEff.xPure a0) = nb a0 := rfl
