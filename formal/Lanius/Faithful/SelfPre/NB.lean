@[simp, nb_simp] theorem nb_MEff_xStruct (a0 : Lanius.Mini.Ty) (a1 : List Lanius.Mini.MEff) : nb (Lanius.Mini.MEff.xStruct a0 a1) = max (nb a0) (nb a1) := by show nbMEff _ = _; simp only [nbMEff, nbMEff0_eq] <;> rfl
@[simp, nb_simp] theorem nb_MEff_xVariant (a0 : Lanius.Mini.Ty) (a1 : Nat) (a2 : List Lanius.Mini.MEff) : nb (Lanius.Mini.MEff.xVariant a0 a1 a2) = max (nb a0) (max (nb a1) (nb a2)) := by show nbMEff _ = _; simp only [nbMEff, nbMEff0_eq] <;> rfl
