def nbSrcStmt : Lanius.Mini.SrcStmt → Nat
  | .nop => 0
  | .let a0 a1 a2 a3 => max (nb a0) (max (nb a1) (max (nb a2) (nbSrcStmt a3)))
  | .letStruct a0 a1 a2 a3 => max (nb a0) (max (nb a1) (max (nb a2) (nbSrcStmt a3)))
  | .letCall a0 a1 a2 a3 a4 => max (nb a0) (max (nb a1) (max (nb a2) (max (nb a3) (nbSrcStmt a4))))
  | .letEnum a0 a1 a2 a3 a4 => max (nb a0) (max (nb a1) (max (nb a2) (max (nb a3) (nbSrcStmt a4))))
  | .letMatch a0 a1 a2 a3 a4 a5 => max (nb a0) (max (nb a1) (max (nb a2) (max (nb a3) (max (nb a4) (nbSrcStmt a5)))))
  | .set a0 a1 => max (nb a0) (nb a1)
  | .setField a0 a1 a2 => max (nb a0) (max (nb a1) (nb a2))
  | .setCall a0 a1 a2 => max (nb a0) (max (nb a1) (nb a2))
  | .then a0 a1 => max (nbSrcStmt a0) (nbSrcStmt a1)
  | .if a0 a1 a2 => max (nb a0) (max (nbSrcStmt a1) (nbSrcStmt a2))
  | .while a0 a1 => max (nb a0) (nbSrcStmt a1)
  | .return a0 => nb a0
  | .letAlloc a0 a1 a2 a3 => max (nb a0) (max (nb a1) (max (nb a2) (nbSrcStmt a3)))
  | .letLoad a0 a1 a2 a3 => max (nb a0) (max (nb a1) (max (nb a2) (nbSrcStmt a3)))
  | .setByte a0 a1 a2 => max (nb a0) (max (nb a1) (nb a2))
  | .free a0 a1 a2 => max (nb a0) (max (nb a1) (nb a2))
  | .letSlice a0 a1 a2 a3 a4 => max (nb a0) (max (nb a1) (max (nb a2) (max (nb a3) (nbSrcStmt a4))))
  | .letIndex a0 a1 a2 a3 a4 => max (nb a0) (max (nb a1) (max (nb a2) (max (nb a3) (nbSrcStmt a4))))
  | .setIndex a0 a1 a2 => max (nb a0) (max (nb a1) (nb a2))
  | .letEval a0 a1 a2 a3 => max (nb a0) (max (nb a1) (max (nb a2) (nbSrcStmt a3)))
  | .setEval a0 a1 => max (nb a0) (nb a1)
  | .ifEval a0 a1 a2 => max (nb a0) (max (nbSrcStmt a1) (nbSrcStmt a2))
  | .whileEval a0 a1 => max (nb a0) (nbSrcStmt a1)
  | .returnEval a0 => nb a0
  | .discard a0 => nb a0
  | .setIndexEval a0 a1 a2 => max (nb a0) (max (nb a1) (nb a2))
  | .setFieldEval a0 a1 a2 => max (nb a0) (max (nb a1) (nb a2))
