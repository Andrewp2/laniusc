def nbCTree : Lanius.Mini.CTree → Nat
  | .leaf a0 => nb a0
  | .node a0 a1 => max (nb a0) (nbCTree0 a1)
def nbCTree0 : List Lanius.Mini.CTree → Nat
  | [] => 0
  | a :: l => max (nbCTree a) (nbCTree0 l)
end
instance : NB Lanius.Mini.CTree := ⟨nbCTree⟩
theorem nbCTree0_eq : ∀ l : List Lanius.Mini.CTree, nbCTree0 l = NB.nb l
  | [] => rfl
  | a :: l => by
    show max _ _ = max _ _
    (rw [nbCTree0_eq l]) <;> rfl
@[simp, nb_simp] theorem nb_CTree_leaf (a0 : Lanius.Mini.Token) : nb (Lanius.Mini.CTree.leaf a0) = nb a0 := rfl
@[simp, nb_simp] theorem nb_CTree_node (a0 : Nat) (a1 : List Lanius.Mini.CTree) : nb (Lanius.Mini.CTree.node a0 a1) = max (nb a0) (nb a1) := by show nbCTree _ = _; simp only [nbCTree, nbCTree0_eq] <;> rfl

