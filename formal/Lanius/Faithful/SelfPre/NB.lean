def nbMStmt : Lanius.Mini.MStmt → Nat
  | .mNop => 0
  | .mLet a0 a1 a2 a3 => max (nb a0) (max (nb a1) (max (nb a2) (nbMStmt a3)))
  | .mLetStruct a0 a1 a2 a3 => max (nb a0) (max (nb a1) (max (nb a2) (nbMStmt a3)))
  | .mLetCall a0 a1 a2 a3 a4 => max (nb a0) (max (nb a1) (max (nb a2) (max (nb a3) (nbMStmt a4))))
  | .mLetEnum a0 a1 a2 a3 a4 => max (nb a0) (max (nb a1) (max (nb a2) (max (nb a3) (nbMStmt a4))))
  | .mLetMatch a0 a1 a2 a3 a4 a5 => max (nb a0) (max (nb a1) (max (nb a2) (max (nb a3) (max (nb a4) (nbMStmt a5)))))
  | .mSet a0 a1 => max (nb a0) (nb a1)
  | .mSetField a0 a1 a2 => max (nb a0) (max (nb a1) (nb a2))
  | .mSetCall a0 a1 a2 => max (nb a0) (max (nb a1) (nb a2))
  | .mThen a0 a1 => max (nbMStmt a0) (nbMStmt a1)
  | .mIf a0 a1 a2 => max (nb a0) (max (nbMStmt a1) (nbMStmt a2))
  | .mWhile a0 a1 => max (nb a0) (nbMStmt a1)
  | .mReturn a0 => nb a0
  | .mLetAlloc a0 a1 a2 a3 => max (nb a0) (max (nb a1) (max (nb a2) (nbMStmt a3)))
  | .mFree a0 a1 a2 => max (nb a0) (max (nb a1) (nb a2))
  | .mLetSlice a0 a1 a2 a3 a4 => max (nb a0) (max (nb a1) (max (nb a2) (max (nb a3) (nbMStmt a4))))
  | .mLetIndex a0 a1 a2 a3 a4 => max (nb a0) (max (nb a1) (max (nb a2) (max (nb a3) (nbMStmt a4))))
  | .mLetView a0 a1 a2 a3 a4 => max (nb a0) (max (nb a1) (max (nb a2) (max (nb a3) (nbMStmt a4))))
  | .mLetStr a0 a1 a2 => max (nb a0) (max (nb a1) (nbMStmt a2))
  | .mSetIndex a0 a1 a2 => max (nb a0) (max (nb a1) (nb a2))
  | .mLetEval a0 a1 a2 a3 => max (nb a0) (max (nb a1) (max (nb a2) (nbMStmt a3)))
  | .mSetEval a0 a1 => max (nb a0) (nb a1)
  | .mIfEval a0 a1 a2 => max (nb a0) (max (nbMStmt a1) (nbMStmt a2))
  | .mWhileEval a0 a1 => max (nb a0) (nbMStmt a1)
  | .mReturnEval a0 => nb a0
  | .mDiscard a0 => nb a0
  | .mSetIndexEval a0 a1 a2 => max (nb a0) (max (nb a1) (nb a2))
  | .mSetFieldEval a0 a1 a2 => max (nb a0) (max (nb a1) (nb a2))
  | .mReturnUnit => 0
  | .mAssert a0 => nb a0
  | .mBreak => 0
  | .mContinue => 0
  | .mMatchArm a0 a1 a2 a3 a4 a5 a6 a7 => max (nb a0) (max (nb a1) (max (nb a2) (max (nb a4) (max (nb a5) (max (nbMStmt a6) (nbMStmt a7))))))
  | .mUnreachable a0 a1 => max (nb a0) (nb a1)
  | .mSetPlace a0 a1 => max (nb a0) (nb a1)
  | .mSetPlaceOp a0 a1 a2 => max (nb a1) (nb a2)
end
