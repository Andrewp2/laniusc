  | .tyI32 => 0
  | .tyBool => 0
  | .tyUint a0 => 0
  | .tyPtr => 0
  | .tyIsize => 0
  | .tyChar => 0
  | .tyFloat a0 => 0
  | .tySlice a0 => nbTy a0
