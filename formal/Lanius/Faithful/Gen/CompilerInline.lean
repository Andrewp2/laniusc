def Inline.seqCode (base : Nat) (pos : Nat) (firstCode : List Instr) (second : Stmt) : List Instr :=
  firstCode ++ compileStmt base (pos + codeSize firstCode) second

def Inline.iteCode (base : Nat) (pos : Nat) (conditionCode : List Instr) (thenBranch : Stmt) (elseBranch : Stmt) : List Instr :=
  let thenStart : Nat := pos + codeSize conditionCode + 9
  let thenCode : List Instr := compileStmt base thenStart thenBranch
  let elseStart : Nat := thenStart + codeSize thenCode + 5
  let elseCode : List Instr := compileStmt base elseStart elseBranch
  conditionCode ++ [Instr.jz elseStart] ++ thenCode ++ [Instr.jmp (elseStart + codeSize elseCode)] ++ elseCode

def Inline.loopCode (base : Nat) (pos : Nat) (conditionCode : List Instr) (body : Stmt) : List Instr :=
  let bodyStart : Nat := pos + codeSize conditionCode + 9
  let bodyCode : List Instr := compileStmt base bodyStart body
  conditionCode ++ [Instr.jz (bodyStart + codeSize bodyCode + 5)] ++ bodyCode ++ [Instr.jmp pos]

def Inline.link (codes : List Code) : Option Binary :=
  let entries : List Nat := layout 0 codes
  let image : List UInt8 := linkFrom entries 0 codes
  if image.length ≤ imageLimit then
    some ({ codes := codes, entries := entries, image := image } : Binary)
  else
    none

def Inline.lookupAt (binding : Binding) (rest : List Binding) (id : Nat) : Option Binding :=
  if binding.id = id then
    some binding
  else
    lookup rest id

def Inline.offsetAfter (ty : SrcType) (rest : List SrcType) (index : Nat) : Nat :=
  if index = 0 then
    0
  else
    SrcType.size ty + fieldOffset rest (index - 1)

def Inline.arithOf (operation : BinOp) (left : Typed) (right : Typed) (k : UintTy) : Option Typed :=
  if SrcType.isUint right.ty k then
    some ({ expr := wrap k (Expr.binary Word.u64 operation left.expr right.expr), ty := SrcType.uint k } : Typed)
  else
    none

def Inline.orderOf (operation : CmpOp) (left : Typed) (right : Typed) (k : UintTy) : Option Typed :=
  if SrcType.isUint right.ty k then
    some ({ expr := Expr.compare Word.u64 operation left.expr right.expr, ty := SrcType.bool } : Typed)
  else
    none

def Inline.lowerScalarSlot (slot : Nat) (ty : SrcType) : Option Typed :=
  if SrcType.isScalar ty then
    some ({ expr := Expr.var slot, ty := ty } : Typed)
  else
    none

def Inline.copySame (b : Binding) (ty : SrcType) : Option (List Expr) :=
  if SrcType.same b.ty ty then
    some (slotVars b.slot (SrcType.size b.ty))
  else
    none

def Inline.copySlots (slot : Nat) (field : SrcType) (ty : SrcType) : Option (List Expr) :=
  if SrcType.same field ty && decide (0 < SrcType.size field) then
    some (slotVars slot (SrcType.size field))
  else
    none

def Inline.armBind (binder : Nat) (ty : SrcType) (rest : List Nat) (more : List SrcType) (slot : Nat) (scope : List Binding) : Option (List Binding) :=
  if 0 < SrcType.size ty then
    armScope rest more (slot + SrcType.size ty) (({ id := binder, slot := slot, ty := ty } : Binding) :: scope)
  else
    none

def Inline.evalSized (slot : Nat) (ty : SrcType) (values : Option (List Expr)) : Option Evaluated :=
  if 0 < SrcType.size ty then
    evalValues slot ty values
  else
    none

/-- Arm k's value evaluated from dst, under its payload's binders. -/
def Inline.evalArmIn (sigs : List Sig) (decls : SrcDecls) (bound : Option (List Binding)) (slot : Nat) (dst : Nat) (ty : SrcType) (k : Nat) (value : SrcEff) (rest : List SrcEff) (later : Option Stmt) : Option Stmt :=
  match bound with
  | none => none
  | some s =>
    match SrcEff.eval value sigs decls s dst with
    | none => none
    | some e => evalArm slot k (evalSame e ty e.stmt) rest later

def Inline.lowerSetScalar (slot : Nat) (ty : SrcType) (scope : List Binding) (value : SrcExpr) : Option Stmt :=
  if SrcType.isScalar ty then
    lowerSetValue slot (lowerAs scope value ty)
  else
    none

def Inline.structFieldsAt (decl : SrcStructDecl) (rest : List SrcStructDecl) (id : Nat) : Option (List SrcType) :=
  if decl.id = id then
    some decl.fields
  else
    structFields rest id

def Inline.enumVariantsAt (decl : SrcEnumDecl) (rest : List SrcEnumDecl) (id : Nat) : Option (List (List SrcType)) :=
  if decl.id = id then
    some decl.variants
  else
    enumVariants rest id

def Inline.elementAt (slot : Nat) (element : SrcType) (index : Expr) : Option Expr :=
  if SrcType.isI32 element then
    some (Expr.binary Word.u64 BinOp.add (Expr.var slot) (Expr.binary Word.u64 BinOp.mul index (Expr.lit 4)))
  else
    none

def Inline.checkedElement (b : Binding) (ty : SrcType) (index : Option Expr) : Option Expr :=
  if SrcType.same b.ty (SrcType.slice ty) then
    elementAddress b index
  else
    none

def Inline.storeElement (b : Binding) (element : SrcType) (index : Option Expr) (scope : List Binding) (value : SrcExpr) : Option Stmt :=
  match elementAddress b index with
  | none => none
  | some a =>
    match lowerAs scope value element with
    | none => none
    | some v => some (Stmt.storeWord MemWidth.m32 a v)

def Inline.checkedLoad (decls : SrcDecls) (b : Binding) (ty : SrcType) (i : Expr) (next : Nat) (s : Stmt) : Option Stmt :=
  if wordElement decls ty && SrcType.same b.ty (SrcType.slice ty) then
    some (loadType ty next (elementBase b.slot (SrcType.size ty) i) 0 s)
  else
    none

def Inline.setScalarEval (target : Nat) (fty : SrcType) (from_ : Nat) (value : Evaluated) : Option Stmt :=
  if SrcType.isScalar fty then
    evalSame value fty (Stmt.seq value.stmt (Stmt.assign target (Expr.var from_)))
  else
    none

def Inline.declareStructIn (id : Nat) (fields : List SrcType) (decls : SrcDecls) (known : Option (List SrcType)) : Option SrcDecls :=
  match known with
  | none => some ({ structs := ({ id := id, fields := fields } : SrcStructDecl) :: decls.structs, enums := decls.enums } : SrcDecls)
  | some other => keepIf (typesSame other fields) decls

def Inline.declareEnumIn (id : Nat) (variants : List (List SrcType)) (decls : SrcDecls) (known : Option (List (List SrcType))) : Option SrcDecls :=
  match known with
  | none => some ({ structs := decls.structs, enums := ({ id := id, variants := variants } : SrcEnumDecl) :: decls.enums } : SrcDecls)
  | some other => keepIf (variantsSame other variants) decls

def Inline.declareTypesAfter (after : Option SrcDecls) (rest : List SrcType) : Option SrcDecls :=
  match after with
  | none => none
  | some decls => declareTypes rest decls

def Inline.declareVariantsAfter (after : Option SrcDecls) (rest : List (List SrcType)) : Option SrcDecls :=
