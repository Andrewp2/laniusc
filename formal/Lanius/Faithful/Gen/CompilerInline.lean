def Inline.negAgrees (operand : Expr) (other : Expr) : Bool :=
  match other with
  | .lit v => false
  | .var i => false
  | .neg o => Expr.agrees operand o
  | .binary w op l r => false
  | .compare w op l r => false

def Inline.binaryAgrees (word : Word) (operation : BinOp) (left : Expr) (right : Expr) (other : Expr) : Bool :=
  match other with
  | .lit v => false
  | .var i => false
  | .neg o => false
  | .binary w op l r => decide (Word.number word = Word.number w) && decide (BinOp.number operation = BinOp.number op) && Expr.agrees left l && Expr.agrees right r
  | .compare w op l r => false

def Inline.unitAgrees (word : Word) (operation : BinOp) (left : Expr) (right : Expr) (other : Expr) : Bool :=
  Expr.unitOf right word operation && Word.keeps word other && Expr.agrees left other || BinOp.commutes operation && Expr.unitOf left word operation && Word.keeps word other && Expr.agrees right other

def Inline.compareAgrees (word : Word) (operation : CmpOp) (left : Expr) (right : Expr) (other : Expr) : Bool :=
  match other with
  | .lit v => false
  | .var i => false
  | .neg o => false
  | .binary w op l r => false
  | .compare w op l r => decide (Word.number word = Word.number w) && decide (CmpOp.number operation = CmpOp.number op) && Expr.agrees left l && Expr.agrees right r

def Inline.factOr (fact : Fact) (index : Nat) (tail : List Fact) : Expr :=
  if fact.slot = index then
    fact.value
  else
    factValue tail index

def Inline.kept (fact : Fact) (index : Nat) (tail : List Fact) : List Fact :=
  if decide (fact.slot ≠ index) && !(Expr.mentions fact.value index) then
    fact :: tail
  else
    tail

/-- first is index = value, and other, which agrees with second, kills index. -/
def Inline.deadAgrees (first : Stmt) (second : Stmt) (facts : List Fact) (other : Stmt) : Bool :=
  match first with
  | .skip => false
  | .assign index value => Stmt.kills other index && Stmt.agrees second (assigned facts index value) other
  | .seq f s => false
  | .ite c t e => false
  | .loop c b => false
  | .call t n f a => false
  | .ret v => false
  | .alloc t sh sz => false
  | .loadByte t a => false
  | .storeByte a v => false
  | .loadWord w t a => false
  | .storeWord w a v => false
  | .divide w o t l r => false

def Inline.seqAgrees (first : Stmt) (second : Stmt) (facts : List Fact) (other : Stmt) : Bool :=
  match other with
  | .skip => false
  | .assign i v => false
  | .seq f s => Stmt.agrees first facts f && Stmt.agrees second (Stmt.factsAfter first facts) s
  | .ite c t e => false
  | .loop c b => false
  | .call t n f a => false
  | .ret v => false
  | .alloc t sh sz => false
  | .loadByte t a => false
  | .storeByte a v => false
  | .loadWord w t a => false
  | .storeWord w a v => false
  | .divide w o t l r => false

/-- A condition the facts do not make a constant. -/
def Inline.unknown (known : Option (BitVec 64)) : Bool :=
  match known with
  | some v => false
  | none => true

def Inline.branchAgrees (known : Option (BitVec 64)) (thenBranch : Stmt) (elseBranch : Stmt) (facts : List Fact) (other : Stmt) : Bool :=
  match known with
  | some v => decide (v = 0) && Stmt.agrees elseBranch facts other || decide (v ≠ 0) && Stmt.agrees thenBranch facts other
  | none => false

def Inline.iteAgrees (test : Expr) (thenBranch : Stmt) (elseBranch : Stmt) (facts : List Fact) (other : Stmt) : Bool :=
  match other with
  | .skip => false
  | .assign i v => false
  | .seq f s => false
  | .ite c t e => Expr.agrees test c && Stmt.agrees thenBranch facts t && Stmt.agrees elseBranch facts e
  | .loop c b => false
  | .call t n f a => false
  | .ret v => false
  | .alloc t sh sz => false
  | .loadByte t a => false
  | .storeByte a v => false
  | .loadWord w t a => false
  | .storeWord w a v => false
  | .divide w o t l r => false

/-- A loop's body runs from states the facts may not describe: no facts. -/
def Inline.loopAgrees (condition : Expr) (body : Stmt) (other : Stmt) : Bool :=
  match other with
  | .skip => false
  | .assign i v => false
  | .seq f s => false
  | .ite c t e => false
  | .loop c b => Expr.agrees condition c && Stmt.agrees body [] b
  | .call t n f a => false
  | .ret v => false
  | .alloc t sh sz => false
  | .loadByte t a => false
  | .storeByte a v => false
  | .loadWord w t a => false
  | .storeWord w a v => false
  | .divide w o t l r => false

/-- The second statement is optimized with the facts after the first; a store to a slot the optimized rest kills is dropped. -/
def Inline.optimizeSequence (first : Stmt) (second : Stmt) (facts : List Fact) : Stmt :=
  let rest : Stmt := Stmt.optimize second (optFactsAfter first facts)
  if Stmt.deadBefore first rest then
    rest
  else
    optimizeSeq (Stmt.optimize first facts) rest

