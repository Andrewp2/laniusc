theorem proof_p_ret_void {prog : SrcProgram} {prims : Prims} {ix_p_ret_void : Nat} (fn : prog.funcs[ix_p_ret_void]? = some (src_p_ret_void)) (np : prims.isPrim ix_p_ret_void = false) {n : Nat} :
    Stmt_p_ret_void prog prims ix_p_ret_void n := by
  intro w h
  rcases n with _ | n
  · simp [pcall] at h
  rw [pcall_succ np fn] at h
  simp only [src_p_ret_void] at h
  faithful [Lanius.Mini.Inline.pRetVoid]

