public section

/-! Generated by formal/tools/faithful_certs.py: extraction certificates of the
functions of bucket F_checkedFunc, for any program that holds them. Do not edit. -/

set_option maxHeartbeats 10000000
set_option maxRecDepth 100000
set_option linter.unusedVariables false

namespace Lanius.Faithful.SelfCert

open Lanius.Mini
open Lanius.Core (Value)
open Lanius.Faithful
open Lanius.Faithful.Self
open Lanius.Faithful.SelfRep

theorem proof_checked_func {prog : SrcProgram} {prims : Prims} {ix_checked_func : Nat} (fn : prog.funcs[ix_checked_func]? = some (src_checked_func)) (np : prims.isPrim ix_checked_func = false) {n : Nat} :
    Stmt_checked_func prog prims ix_checked_func n := by
  intro x0 x1 v0 v1 w h r0 r1
  rcases n with _ | n
  · simp [pcall] at h
  rw [pcall_succ np fn] at h
  simp only [src_checked_func] at h
  faithful [Lanius.Mini.checkedFunc]

end Lanius.Faithful.SelfCert
