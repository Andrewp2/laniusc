theorem proof_arg_expected {prog : SrcProgram} {prims : Prims} {ix_arg_expected ix_ty_of ix_decl_env ix_bound_args : Nat} (fn : prog.funcs[ix_arg_expected]? = some (src_arg_expected ix_ty_of ix_decl_env ix_bound_args)) (np : prims.isPrim ix_arg_expected = false)
