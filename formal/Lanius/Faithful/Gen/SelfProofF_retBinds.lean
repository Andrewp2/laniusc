    (ext_decl_env : Certified (∀ {n : Nat}, Stmt_decl_env prog prims ix_decl_env n))
    (ext_bound_args : Certified (∀ {n : Nat}, Stmt_bound_args prog prims ix_bound_args n)) {n : Nat} :
    Stmt_arg_expected prog prims ix_arg_expected n := by
  intro x0 x1 x2 x3 x4 x5 v0 v1 v2 v3 v4 v5 w h r0 r1 r2 r3 r4 r5
  rcases n with _ | n
  · simp [pcall] at h
  rw [pcall_succ np fn] at h
  simp only [src_arg_expected] at h
  faithful [Lanius.Mini.argExpected]

