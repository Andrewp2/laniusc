theorem proof_p_ident_plain {prog : SrcProgram} {prims : Prims} {ix_p_ident_plain : Nat} (fn : prog.funcs[ix_p_ident_plain]? = some (src_p_ident_plain)) (np : prims.isPrim ix_p_ident_plain = false) {n : Nat} :
    Stmt_p_ident_plain prog prims ix_p_ident_plain n := by
  intro w h
  rcases n with _ | n
  · simp [pcall] at h
  rw [pcall_succ np fn] at h
  simp only [src_p_ident_plain] at h
  faithful [Lanius.Mini.Inline.pIdentPlain]

