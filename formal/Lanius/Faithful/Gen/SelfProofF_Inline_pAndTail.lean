theorem proof_p_and_tail {prog : SrcProgram} {prims : Prims} {ix_p_and_tail : Nat} (fn : prog.funcs[ix_p_and_tail]? = some (src_p_and_tail)) (np : prims.isPrim ix_p_and_tail = false) {n : Nat} :
    Stmt_p_and_tail prog prims ix_p_and_tail n := by
  intro w h
  rcases n with _ | n
  · simp [pcall] at h
  rw [pcall_succ np fn] at h
  simp only [src_p_and_tail] at h
  faithful [Lanius.Mini.Inline.pAndTail]

