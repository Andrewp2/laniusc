theorem fn667 : prog.funcs[667]? = some src667 := rfl

theorem certs610 : ∀ n, Cert610 n ∧ Cert663 n ∧ Cert667 n := by
  intro n
  induction n with
  | zero =>
    refine ⟨?_, ?_, ?_⟩
    · intro x0 x1 v0 v1 w h r0 r1
      simp [pcall] at h
    · intro x0 x1 v0 v1 w h r0 r1
      simp [pcall] at h
    · intro x0 x1 v0 v1 w h r0 r1
      simp [pcall] at h
  | succ n ih =>
    obtain ⟨ih610, ih663, ih667⟩ := ih
    refine ⟨?_, ?_, ?_⟩
    · intro x0 x1 v0 v1 w h r0 r1
      rw [pcall_succ (c := 610) (f := src610) rfl fn610] at h
      simp only [src610] at h
      faithful [Lanius.Mini.SrcType.same]
    · intro x0 x1 v0 v1 w h r0 r1
      rw [pcall_succ (c := 663) (f := src663) rfl fn663] at h
      simp only [src663] at h
      faithful [Lanius.Mini.typesSame]
    · intro x0 x1 v0 v1 w h r0 r1
      rw [pcall_succ (c := 667) (f := src667) rfl fn667] at h
      simp only [src667] at h
      faithful [Lanius.Mini.variantsSame]

theorem cert610 {n : Nat} : Cert610 n := (certs610 n).1
theorem cert663 {n : Nat} : Cert663 n := (certs610 n).2.1
theorem cert667 {n : Nat} : Cert667 n := (certs610 n).2.2

