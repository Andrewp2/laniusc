theorem proof_nested_or_plain {prog : SrcProgram} {prims : Prims} {ix_nested_or_plain ix_nest_use ix_plain_use : Nat} (fn : prog.funcs[ix_nested_or_plain]? = some (src_nested_or_plain ix_nest_use ix_plain_use)) (np : prims.isPrim ix_nested_or_plain = false)
    (ext_nest_use : Certified (∀ {n : Nat}, Stmt_nest_use prog prims ix_nest_use n))
    (ext_plain_use : Certified (∀ {n : Nat}, Stmt_plain_use prog prims ix_plain_use n)) {n : Nat} :
    Stmt_nested_or_plain prog prims ix_nested_or_plain n := by
  intro x0 x1 x2 x3 x4 x5 x6 x7 v0 v1 v2 v3 v4 v5 v6 v7 w h r0 r1 r2 r3 r4 r5 r6 r7
  rcases n with _ | n
  · simp [pcall] at h
  rw [pcall_succ np fn] at h
  simp only [src_nested_or_plain] at h
  faithful [Lanius.Mini.nestedOrPlain]

