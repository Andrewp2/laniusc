theorem proof_t_rparen {prog : SrcProgram} {prims : Prims} {ix_t_rparen : Nat} (fn : prog.funcs[ix_t_rparen]? = some (src_t_rparen)) (np : prims.isPrim ix_t_rparen = false) {n : Nat} :
    Stmt_t_rparen prog prims ix_t_rparen n := by
