    exact (by intro x0 x1 x2 x3 v0 v1 v2 v3 w h r0 r1 r2 r3; simp [pcall] at h)
  | succ n ih =>
    have ih_names_some : Stmt_names_some prog prims 2578 n := ih
    exact @step_names_some prog prims 2578 2152 2600 fn_names_some np_names_some ⟨@cert_unbox_of_mini_selfhost_List_mini_selfhost_VariantTy⟩ ⟨@cert_arm_names⟩ n ⟨ih_names_some⟩

theorem cert_names_some {n : Nat} :
    Stmt_names_some prog prims 2578 n :=
  (certs_names_some n)

end Lanius.Faithful.SelfCert
