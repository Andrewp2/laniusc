/-! Generated by formal/tools/faithful_certs.py: extraction certificates of the
functions of bucket C_leftTrue, for any program that holds them. Do not edit. -/

set_option maxHeartbeats 10000000
set_option maxRecDepth 100000
set_option linter.unusedVariables false

namespace Lanius.Faithful.SelfCert

open Lanius.Mini
open Lanius.Core (Value)
open Lanius.Faithful
open Lanius.Faithful.Self
open Lanius.Faithful.SelfRep

theorem proof_left_true {prog : SrcProgram} {prims : Prims} {ix_left_true : Nat} (fn : prog.funcs[ix_left_true]? = some (src_left_true)) (np : prims.isPrim ix_left_true = false) {n : Nat} :
    Stmt_left_true prog prims ix_left_true n := by
  intro x0 v0 w h r0
  rcases n with _ | n
  · simp [pcall] at h
  rw [pcall_succ np fn] at h
  simp only [src_left_true] at h
  faithful [Lanius.Mini.leftTrue]

end Lanius.Faithful.SelfCert
