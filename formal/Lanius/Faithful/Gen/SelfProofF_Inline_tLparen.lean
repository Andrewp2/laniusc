theorem proof_t_lparen {prog : SrcProgram} {prims : Prims} {ix_t_lparen : Nat} (fn : prog.funcs[ix_t_lparen]? = some (src_t_lparen)) (np : prims.isPrim ix_t_lparen = false) {n : Nat} :
    Stmt_t_lparen prog prims ix_t_lparen n := by
  intro w h
  rcases n with _ | n
  · simp [pcall] at h
  rw [pcall_succ np fn] at h
  simp only [src_t_lparen] at h
  faithful [Lanius.Mini.Inline.tLparen]

