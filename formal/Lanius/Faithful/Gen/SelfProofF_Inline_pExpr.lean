/-! Generated by formal/tools/faithful_certs.py: extraction certificates of the
functions of bucket F_Inline_pExpr, for any program that holds them. Do not edit. -/

set_option maxHeartbeats 10000000
set_option maxRecDepth 100000
set_option linter.unusedVariables false

namespace Lanius.Faithful.SelfCert

