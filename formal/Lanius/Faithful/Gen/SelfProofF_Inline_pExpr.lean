theorem proof_p_expr {prog : SrcProgram} {prims : Prims} {ix_p_expr : Nat} (fn : prog.funcs[ix_p_expr]? = some (src_p_expr)) (np : prims.isPrim ix_p_expr = false) {n : Nat} :
    Stmt_p_expr prog prims ix_p_expr n := by
  intro w h
  rcases n with _ | n
  · simp [pcall] at h
  rw [pcall_succ np fn] at h
  simp only [src_p_expr] at h
  faithful [Lanius.Mini.Inline.pExpr]

