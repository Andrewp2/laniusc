theorem proof_BinOp_annihilates {prog : SrcProgram} {prims : Prims} {ix_BinOp_annihilates : Nat} (fn : prog.funcs[ix_BinOp_annihilates]? = some (src_BinOp_annihilates)) (np : prims.isPrim ix_BinOp_annihilates = false) {n : Nat} :
    Stmt_BinOp_annihilates prog prims ix_BinOp_annihilates n := by
  intro x0 v0 w h r0
  rcases n with _ | n
  · simp [pcall] at h
  rw [pcall_succ np fn] at h
  simp only [src_BinOp_annihilates] at h
