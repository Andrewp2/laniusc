    (ext_unbox_of_mini_selfhost_List_usize : Certified (∀ {n : Nat}, Stmt_unbox_of_mini_selfhost_List_usize prog prims ix_unbox_of_mini_selfhost_List_usize n)) {n : Nat}
    (ih_same_text : Certified (Stmt_same_text prog prims ix_same_text n)) :
    Stmt_same_text prog prims ix_same_text (n + 1) := by
  intro x0 x1 v0 v1 w h r0 r1
  rw [pcall_succ np fn] at h
  simp only [src_same_text] at h
  faithful [Lanius.Mini.sameText]

end Lanius.Faithful.SelfCert
