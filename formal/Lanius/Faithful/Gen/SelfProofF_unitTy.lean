functions of bucket F_unitTy, for any program that holds them. Do not edit. -/

set_option maxHeartbeats 10000000
set_option maxRecDepth 100000
set_option linter.unusedVariables false

namespace Lanius.Faithful.SelfCert

open Lanius.Mini
open Lanius.Core (Value)
open Lanius.Faithful
open Lanius.Faithful.Self
open Lanius.Faithful.SelfRep

theorem proof_unit_ty {prog : SrcProgram} {prims : Prims} {ix_unit_ty : Nat} (fn : prog.funcs[ix_unit_ty]? = some (src_unit_ty)) (np : prims.isPrim ix_unit_ty = false) {n : Nat} :
    Stmt_unit_ty prog prims ix_unit_ty n := by
  intro x0 v0 w h r0
  rcases n with _ | n
  · simp [pcall] at h
  rw [pcall_succ np fn] at h
  simp only [src_unit_ty] at h
  faithful [Lanius.Mini.unitTy]

end Lanius.Faithful.SelfCert
