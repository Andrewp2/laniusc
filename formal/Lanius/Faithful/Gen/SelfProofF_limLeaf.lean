    (ext_depth_sum : Certified (∀ {n : Nat}, Stmt_depth_sum prog prims ix_depth_sum n)) {n : Nat}
    (ih_lim_stmt : Certified (Stmt_lim_stmt prog prims ix_lim_stmt n)) :
    Stmt_lim_stmt prog prims ix_lim_stmt (n + 1) := by
  intro x0 v0 w h r0
  rw [pcall_succ np fn] at h
  simp only [src_lim_stmt] at h
  faithful [Lanius.Mini.limStmt]

end Lanius.Faithful.SelfCert
