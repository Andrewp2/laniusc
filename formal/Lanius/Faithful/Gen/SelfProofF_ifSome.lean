functions of bucket F_ifSome, for any program that holds them. Do not edit. -/

set_option maxHeartbeats 10000000
set_option maxRecDepth 100000
set_option linter.unusedVariables false

namespace Lanius.Faithful.SelfCert

open Lanius.Mini
open Lanius.Core (Value)
open Lanius.Faithful
open Lanius.Faithful.Self
open Lanius.Faithful.SelfRep

theorem proof_if_some {prog : SrcProgram} {prims : Prims} {ix_if_some : Nat} (fn : prog.funcs[ix_if_some]? = some (src_if_some)) (np : prims.isPrim ix_if_some = false) {n : Nat} :
    Stmt_if_some prog prims ix_if_some n := by
  intro x0 x1 v0 v1 w h r0 r1
  rcases n with _ | n
  · simp [pcall] at h
  rw [pcall_succ np fn] at h
  simp only [src_if_some] at h
  faithful [Lanius.Mini.ifSome]

end Lanius.Faithful.SelfCert
