theorem proof_null_at {prog : SrcProgram} {prims : Prims} {ix_null_at : Nat} (fn : prog.funcs[ix_null_at]? = some (src_null_at)) (np : prims.isPrim ix_null_at = false) {n : Nat} :
    Stmt_null_at prog prims ix_null_at n := by
  intro x0 x1 v0 v1 w h r0 r1
  rcases n with _ | n
  · simp [pcall] at h
  rw [pcall_succ np fn] at h
  simp only [src_null_at] at h
  faithful [Lanius.Mini.nullAt]

