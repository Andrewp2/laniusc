def Cert49 (n : Nat) : Prop :=
  ∀ {x0 : Lanius.Mini.SrcProgram} {v0 w : Value}, pcall prog prims n 49 [v0] = some w → RepSrcProgram x0 v0 →
    (RepOption 85 RepSrcDecls) (Lanius.Mini.declareProgram x0) w

set_option maxRecDepth 100000 in
theorem fn49 : prog.funcs[49]? = some src49 := rfl

theorem cert49 {n : Nat} : Cert49 n := by
  intro x0 v0 w h r0
  rcases n with _ | n
  · simp [pcall] at h
  rw [pcall_succ (c := 49) (f := src49) rfl fn49] at h
  simp only [src49] at h
  faithful [Lanius.Mini.declareProgram]

