module

public import Lanius.Faithful.Auto
public import Lanius.Faithful.Gen.SelfRep
public import Lanius.Faithful.Gen.SelfSrcF_noNames
public import Lanius.Faithful.Gen.SelfStmtF_noNames
import all Lanius.Faithful.Gen.SelfSrcF_noNames
import all Lanius.Mini.Frontend.P.noNames

public section

/-! Generated by formal/tools/faithful_certs.py: extraction certificates of the
functions of bucket F_noNames, for any program that holds them. Do not edit. -/

set_option maxHeartbeats 10000000
set_option maxRecDepth 100000
set_option linter.unusedVariables false

namespace Lanius.Faithful.SelfCert

open Lanius.Mini
open Lanius.Core (Value)
open Lanius.Faithful
open Lanius.Faithful.Self
open Lanius.Faithful.SelfRep

theorem proof_no_names {prog : SrcProgram} {prims : Prims} {ix_no_names : Nat} (fn : prog.funcs[ix_no_names]? = some (src_no_names)) (np : prims.isPrim ix_no_names = false) {n : Nat} :
    Stmt_no_names prog prims ix_no_names n := by
  intro x0 v0 w h r0
  rcases n with _ | n
  · simp [pcall] at h
  rw [pcall_succ np fn] at h
  simp only [src_no_names] at h
  faithful [Lanius.Mini.noNames]

end Lanius.Faithful.SelfCert
