theorem proof_p_while_stmt {prog : SrcProgram} {prims : Prims} {ix_p_while_stmt : Nat} (fn : prog.funcs[ix_p_while_stmt]? = some (src_p_while_stmt)) (np : prims.isPrim ix_p_while_stmt = false) {n : Nat} :
    Stmt_p_while_stmt prog prims ix_p_while_stmt n := by
  intro w h
  rcases n with _ | n
  · simp [pcall] at h
  rw [pcall_succ np fn] at h
  simp only [src_p_while_stmt] at h
  faithful [Lanius.Mini.Inline.pWhileStmt]

