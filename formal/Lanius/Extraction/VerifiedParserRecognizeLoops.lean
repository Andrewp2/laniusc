    positionAdvanceI32 := beforeInvariant.positionAdvanceI32
    persistentSeparate := by
      unfold StateLoopFrameSeparated
      rw [closed.effect.localBindingFrameFootprint_eq
        verifiedParserStateLoopPreservedBindings]
