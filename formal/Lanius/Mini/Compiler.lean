  | .skip => true
  | .assign index value => decide (index < locals) && Expr.within value locals
  | .seq first second => Stmt.within first locals arities results && Stmt.within second locals arities results
  | .ite condition thenBranch elseBranch => Expr.within condition locals && Stmt.within thenBranch locals arities results && Stmt.within elseBranch locals arities results
  | .loop condition body => Expr.within condition locals && Stmt.within body locals arities results
  | .call target count callee args => decide (target + count ≤ locals) && decide (0 < count) && arityIs arities callee args.length count && allWithin locals args
  | .ret values => decide (values.length = results) && allWithin locals values
  | .alloc target shift size => decide (target < locals) && decide (shift < 32) && Expr.within size locals
  | .loadByte target address => decide (target < locals) && Expr.within address locals
  | .storeByte address value => Expr.within address locals && Expr.within value locals
  | .loadWord width target address => decide (target < locals) && Expr.within address locals
  | .storeWord width address value => Expr.within address locals && Expr.within value locals

def Stmt.temps (self : Stmt) : Nat :=
  match self with
  | .skip => 0
  | .assign index value => Expr.temps value
  | .seq first second => max (Stmt.temps first) (Stmt.temps second)
  | .ite condition thenBranch elseBranch => max (Expr.temps condition) (max (Stmt.temps thenBranch) (Stmt.temps elseBranch))
  | .loop condition body => max (Expr.temps condition) (Stmt.temps body)
  | .call target count callee args => argsTemps args 0
  | .ret values => argsTemps values 0
  | .alloc target shift size => Expr.temps size
  | .loadByte target address => Expr.temps address
  | .storeByte address value => max (Expr.temps address) (Expr.temps value + 1)
  | .loadWord width target address => Expr.temps address
  | .storeWord width address value => max (Expr.temps address) (Expr.temps value + 1)

/-- Zero the non-parameter locals first, ..., first + count - 1. -/
def zeroLocals (first : Nat) (count : Nat) : List Instr :=
  if count = 0 then
    []
  else
    Instr.store first :: zeroLocals (first + 1) (count - 1)

/-- Frames are bounded so every slot displacement fits a signed 32-bit field. -/
def frameLimit : Nat :=
  1048576

structure Code where
  /-- Frame slots: the locals, then the deepest statement's temporaries. -/
  slots : Nat
  instrs : List Instr
  deriving DecidableEq, Repr

/-- A function returns at least one value, and its results fit in its locals. -/
def compileFunc (arities : List Arity) (func : Func) : Option Code :=
  let slots : Nat := func.locals + Stmt.temps func.body
  if decide (func.params ≤ func.locals) && decide (0 < func.results) && decide (func.results ≤ func.locals) && Stmt.within func.body func.locals arities func.results && decide (slots ≤ frameLimit) then
    let init : List Instr := Instr.imm 0 :: zeroLocals func.params (func.locals - func.params)
    some ({ slots := slots, instrs := init ++ compileStmt func.locals (codeSize init) func.body } : Code)
  else
    none

def arities (funcs : List Func) : List Arity :=
  match funcs with
  | [] => []
  | func :: rest => ({ params := func.params, results := func.results } : Arity) :: arities rest

def compileFuncs (arities : List Arity) (funcs : List Func) : Option (List Code) :=
  match funcs with
  | [] => some []
  | func :: rest =>
    match compileFunc arities func with
    | none => none
    | some code =>
      match compileFuncs arities rest with
      | none => none
      | some codes => some (code :: codes)

/-- Little-endian bytes of a 32-bit field. -/
def le32 (value : BitVec 32) : List UInt8 :=
  let bits : BitVec 32 := value
  UInt8.ofNat bits.toNat :: UInt8.ofNat (bits >>> 8).toNat :: UInt8.ofNat (bits >>> 16).toNat :: [UInt8.ofNat (bits >>> 24).toNat]

/-- Little-endian bytes of a 64-bit field. -/
def le64 (value : BitVec 64) : List UInt8 :=
  UInt8.ofNat value.toNat :: UInt8.ofNat (value >>> 8).toNat :: UInt8.ofNat (value >>> 16).toNat :: UInt8.ofNat (value >>> 24).toNat :: UInt8.ofNat (value >>> 32).toNat :: UInt8.ofNat (value >>> 40).toNat :: UInt8.ofNat (value >>> 48).toNat :: [UInt8.ofNat (value >>> 56).toNat]

/-- rbp-relative displacement of a frame slot. -/
def slotOffset (slot : Nat) : BitVec 32 :=
  0 - BitVec.ofNat 32 ((slot + 1) * 8)

/-- mov rax, [rbp + disp32] -/
def slotLoad (slot : Nat) : List UInt8 :=
  72 :: 139 :: [133] ++ le32 (slotOffset slot)

/-- mov [rbp + disp32], rax -/
def slotStore (slot : Nat) : List UInt8 :=
  72 :: 137 :: [133] ++ le32 (slotOffset slot)

/-- mov rcx, rax; mov rax, [slot] -/
def slotOperands (slot : Nat) : List UInt8 :=
  72 :: 137 :: [193] ++ slotLoad slot

/-- The REX.W prefix of a U64 operation. -/
def Word.rex (self : Word) : List UInt8 :=
  match self with
  | .s32 => []
  | .u64 => [72]

/-- op eax, ecx without its prefix -/
def BinOp.opcode (self : BinOp) : List UInt8 :=
  match self with
  | .add => 1 :: [200]
  | .sub => 41 :: [200]
  | .mul => 15 :: 175 :: [193]
  | .and => 33 :: [200]
  | .or => 9 :: [200]
  | .xor => 49 :: [200]

/-- slot_operands, then op eax, ecx or op rax, rcx -/
def BinOp.bytes (self : BinOp) (word : Word) (slot : Nat) : List UInt8 :=
  slotOperands slot ++ (Word.rex word ++ BinOp.opcode self)

def CmpOp.setccSigned (self : CmpOp) : UInt8 :=
  match self with
  | .eq => 148
  | .ne => 149
  | .lt => 156
  | .le => 158
  | .gt => 159
  | .ge => 157

def CmpOp.setccUnsigned (self : CmpOp) : UInt8 :=
  match self with
  | .eq => 148
  | .ne => 149
  | .lt => 146
  | .le => 150
  | .gt => 151
  | .ge => 147

/-- The setcc opcode byte whose condition holds after cmp left, right exactly when the comparison does: signed for S32, unsigned for U64. (Two helpers: laniusc does not carry the u8 result type into a nested match.) -/
def CmpOp.setcc (self : CmpOp) (word : Word) : UInt8 :=
  match word with
  | .s32 => CmpOp.setccSigned self
  | .u64 => CmpOp.setccUnsigned self

/-- slot_operands; cmp eax, ecx or cmp rax, rcx; setcc al; movzx eax, al -/
def slotCompare (word : Word) (operation : CmpOp) (slot : Nat) : List UInt8 :=
  slotOperands slot ++ (Word.rex word ++ 57 :: [200]) ++ 15 :: CmpOp.setcc operation word :: 192 :: 15 :: 182 :: [192]

/-- 2^shift as a 64-bit word. -/
def pow2 (shift : Nat) : BitVec 64 :=
  if shift = 0 then
    1
  else
    let half : BitVec 64 := pow2 (shift - 1)
    half + half

/-- mov rcx, r13; mov r11, 2^shift - 1; add rcx, r11; mov r11, -2^shift; and rcx, r11 (rcx is the cursor rounded up); mov r11, rcx; add r11, rax; cmp r11, r14; jbe +2; ud2 (past the limit); mov r13, r11; mov rax, rcx -/
def bumpBytes (shift : Nat) : List UInt8 :=
  let round : List UInt8 := 76 :: 137 :: 233 :: 73 :: [187] ++ le64 (pow2 shift - 1) ++ 76 :: 1 :: 217 :: 73 :: [187]
  let mask : List UInt8 := le64 (0 - pow2 shift) ++ 76 :: 33 :: [217]
  let check : List UInt8 := 73 :: 137 :: 203 :: 73 :: 1 :: 195 :: 77 :: 57 :: 243 :: 15 :: 134 :: 2 :: 0 :: 0 :: 0 :: 15 :: [11]
  round ++ mask ++ check ++ 77 :: 137 :: 221 :: 72 :: 137 :: [200]

/-- add rax, r12; movzx eax, byte [rax + 0] -/
def loadAtBytes : List UInt8 :=
  76 :: 1 :: 224 :: 15 :: 182 :: 128 :: 0 :: 0 :: 0 :: [0]

/-- mov rcx, [rbp + disp32]; add rcx, r12; mov [rcx + 0], al -/
def storeAtBytes (slot : Nat) : List UInt8 :=
  72 :: 139 :: [141] ++ le32 (slotOffset slot) ++ 76 :: 1 :: 225 :: 136 :: 129 :: 0 :: 0 :: 0 :: [0]

/-- add rax, r12; mov eax, [rax + 0] (rax with REX.W) -/
def loadWordBytes (width : MemWidth) : List UInt8 :=
  76 :: 1 :: 224 :: (MemWidth.rex width ++ 139 :: 128 :: 0 :: 0 :: 0 :: [0])

/-- mov rcx, [rbp + disp32]; add rcx, r12; mov [rcx + 0], eax (rax with REX.W) -/
def storeWordBytes (width : MemWidth) (slot : Nat) : List UInt8 :=
  72 :: 139 :: [141] ++ le32 (slotOffset slot) ++ 76 :: 1 :: 225 :: (MemWidth.rex width ++ 137 :: 129 :: 0 :: 0 :: 0 :: [0])

/-- mov rsp, rbp; pop rbp; ret -/
def epilogue : List UInt8 :=
  72 :: 137 :: 236 :: 93 :: [195]

/-- Frame bytes below rbp, a multiple of 16. -/
def frameSize (slots : Nat) : Nat :=
  (slots + 1) / 2 * 16

/-- push rbp; mov rbp, rsp; mov r11d, frame_size; sub rsp, r11 -/
def prologue (slots : Nat) : List UInt8 :=
  85 :: 72 :: 137 :: 229 :: 65 :: [187] ++ le32 (BitVec.ofNat 32 (frameSize slots)) ++ 76 :: 41 :: [220]

/-- The rel32 field of a transfer from the end of an instruction at source to target. -/
def relative (source : Nat) (target : Nat) : BitVec 32 :=
  BitVec.ofNat 32 target - BitVec.ofNat 32 source

/-- Where a function's code sits in the program image. -/
structure Place where
  /-- Image offset of the body's first instruction. -/
  body : Nat
  /-- The function's frame slots. -/
  slots : Nat
  /-- Image offset of every function's entry. -/
  entries : List Nat
  deriving DecidableEq, Repr

/-- The caller's virtual slot that is the callee's parameter 0: the slot just below the return address the call pushes. -/
def argBase (slots : Nat) : Nat :=
  frameSize slots / 8 + 2

/-- slot, slot + 1, ..., count of them. -/
def slotRange (slot : Nat) (count : Nat) : List Nat :=
  if count = 0 then
    []
  else
    slot :: slotRange (slot + 1) (count - 1)

/-- Copy argument slots args to virtual slots first + k, first + k + 1, ... -/
def copyBytes (first : Nat) (args : List Nat) (k : Nat) : List UInt8 :=
  match args with
  | [] => []
  | slot :: rest => slotLoad slot ++ slotStore (first + k) ++ copyBytes first rest (k + 1)

/-- The bytes of the instruction at body offset pc. -/
def Instr.encode (self : Instr) (place : Place) (pc : Nat) : List UInt8 :=
  match self with
  | .imm value => 72 :: 184 :: le64 value
  | .load slot => slotLoad slot
  | .store slot => slotStore slot
  | .neg => 247 :: [216]
  | .op word operation slot => BinOp.bytes operation word slot
  | .cmp word operation slot => slotCompare word operation slot
  | .jmp target => 233 :: le32 (relative (pc + 5) target)
  | .jz target => 72 :: 133 :: 192 :: 15 :: [132] ++ le32 (relative (pc + 9) target)
  | .call callee args target count => copyBytes (argBase place.slots) args 0 ++ 232 :: le32 (relative (place.body + pc + 14 * args.length + 5) (place.entries.getD callee 0)) ++ copyBytes target (slotRange (argBase place.slots) count) 0
  | .ret sources => copyBytes 0 sources 0 ++ epilogue
  | .bump shift => bumpBytes shift
  | .loadAt => loadAtBytes
  | .storeAt slot => storeAtBytes slot
  | .loadWordAt width => loadWordBytes width
  | .storeWordAt width slot => storeWordBytes width slot

def encodeFrom (place : Place) (pc : Nat) (code : List Instr) : List UInt8 :=
  match code with
  | [] => []
  | i :: rest => Instr.encode i place pc ++ encodeFrom place (pc + Instr.size i) rest

def Code.size (self : Code) : Nat :=
  13 + codeSize self.instrs

def Code.image (self : Code) (start : Nat) (entries : List Nat) : List UInt8 :=
  prologue self.slots ++ encodeFrom ({ body := start + 13, slots := self.slots, entries := entries } : Place) 0 self.instrs

/-- Entry offsets of functions laid out back to back from start. -/
def layout (start : Nat) (codes : List Code) : List Nat :=
  match codes with
  | [] => []
  | code :: rest => start :: layout (start + Code.size code) rest

def linkFrom (entries : List Nat) (start : Nat) (codes : List Code) : List UInt8 :=
  match codes with
  | [] => []
  | code :: rest => Code.image code start entries ++ linkFrom entries (start + Code.size code) rest

/-- Machine code of a compiled program. -/
structure Binary where
  codes : List Code
  entries : List Nat
  image : List UInt8
  deriving DecidableEq, Repr

/-- Images are small enough for every rel32 displacement. -/
def imageLimit : Nat :=
  1073741824

def compileProgram (prog : Program) : Option Binary :=
  match compileFuncs (arities prog.funcs) prog.funcs with
  | none => none
  | some codes =>
    let entries : List Nat := layout 0 codes
    let image : List UInt8 := linkFrom entries 0 codes
    if image.length ≤ imageLimit then
      some ({ codes := codes, entries := entries, image := image } : Binary)
    else
      none

/-- Separate compilation (roadmap step 9). A module is functions plus the functions it imports from other modules. Inside a module a call names callee c: below the module's function count own, c is its own function c, and own + i is its import i. An import names its owner, the module that defines it, by its position in the link order, a function by its position in that module, and the arity the importing module compiles its calls against. -/
structure Import where
  owner : Nat
  func : Nat
  arity : Arity
  deriving DecidableEq, Repr

structure Module where
  funcs : List Func
  imports : List Import
  deriving DecidableEq, Repr

/-- Each module's arities. -/
def moduleExports (ms : List Module) : List (List Arity) :=
  match ms with
  | [] => []
  | m :: rest => arities m.funcs :: moduleExports rest

def importOk (exports : List (List Arity)) (imp : Import) : Bool :=
  match exports[imp.owner]? with
  | none => false
  | some found => arityIs found imp.func imp.arity.params imp.arity.results

def importsOk (exports : List (List Arity)) (imports : List Import) : Bool :=
  match imports with
  | [] => true
  | imp :: rest => importOk exports imp && importsOk exports rest

def modulesOk (exports : List (List Arity)) (ms : List Module) : Bool :=
  match ms with
  | [] => true
  | m :: rest => importsOk exports m.imports && modulesOk exports rest

/-- The program index of each module's first function, from first. -/
def moduleFirsts (first : Nat) (ms : List Module) : List Nat :=
  match ms with
  | [] => []
  | m :: rest => first :: moduleFirsts (first + m.funcs.length) rest

/-- The program index of each import's function. -/
def importIndices (firsts : List Nat) (imports : List Import) : List Nat :=
  match imports with
  | [] => []
  | imp :: rest => (firsts.getD imp.owner 0 + imp.func) :: importIndices firsts rest

/-- Each callee c becomes table[c], or missing past the table's end. -/
def Stmt.rename (self : Stmt) (table : List Nat) (missing : Nat) : Stmt :=
  match self with
  | .skip => Stmt.skip
  | .assign index value => Stmt.assign index value
  | .seq first second => Stmt.seq (Stmt.rename first table missing) (Stmt.rename second table missing)
  | .ite condition thenBranch elseBranch => Stmt.ite condition (Stmt.rename thenBranch table missing) (Stmt.rename elseBranch table missing)
  | .loop condition body => Stmt.loop condition (Stmt.rename body table missing)
  | .call target count callee args => Stmt.call target count (table.getD callee missing) args
  | .ret values => Stmt.ret values
  | .alloc target shift size => Stmt.alloc target shift size
  | .loadByte target address => Stmt.loadByte target address
  | .storeByte address value => Stmt.storeByte address value
  | .loadWord width target address => Stmt.loadWord width target address
  | .storeWord width address value => Stmt.storeWord width address value

def renameFuncs (table : List Nat) (missing : Nat) (funcs : List Func) : List Func :=
  match funcs with
  | [] => []
  | func :: rest => ({ params := func.params, results := func.results, locals := func.locals, body := Stmt.rename func.body table missing } : Func) :: renameFuncs table missing rest

/-- The modules' functions from the one whose first function is first. A call to a callee the module does not have becomes a call to missing, the program's function count, which no function has. -/
def resolveModules (firsts : List Nat) (missing : Nat) (first : Nat) (ms : List Module) : List Func :=
  match ms with
  | [] => []
  | m :: rest => renameFuncs (slotRange first m.funcs.length ++ importIndices firsts m.imports) missing m.funcs ++ resolveModules firsts missing (first + m.funcs.length) rest

def funcCount (ms : List Module) : Nat :=
  match ms with
  | [] => 0
  | m :: rest => m.funcs.length + funcCount rest

def linkProgram (ms : List Module) : Option Program :=
  if modulesOk (moduleExports ms) ms then
    some ({ funcs := resolveModules (moduleFirsts 0 ms) (funcCount ms) 0 ms } : Program)
  else
    none

/-- Object code: machine code with holes. A piece is literal bytes, or the rel32 field of a call to import i, which the linker fills. Calls inside a module are already bytes: a module's functions stay together, so the distance between two of them is known when it is compiled. -/
inductive Piece where
  | bytes : (List UInt8) → Piece
  | rel : Nat → Piece
  deriving DecidableEq, Repr

/-- One function's object code: its prologue and body. -/
structure ObjFunc where
  slots : Nat
  pieces : List Piece
  deriving DecidableEq, Repr

/-- A compiled module: its functions' arities, its imports, and its functions' object code, in order. -/
structure Object where
  exports : List Arity
  imports : List Import
  funcs : List ObjFunc
  deriving DecidableEq, Repr

/-- A call to callee from body offset pc. A callee at or past own is an import, so its rel32 field is a hole. -/
def callPieces (own : Nat) (place : Place) (pc : Nat) (callee : Nat) (args : List Nat) (target : Nat) (count : Nat) : List Piece :=
  if own ≤ callee then
    Piece.bytes (copyBytes (argBase place.slots) args 0 ++ [232]) :: Piece.rel (callee - own) :: [Piece.bytes (copyBytes target (slotRange (argBase place.slots) count) 0)]
  else
    let call : Instr := Instr.call callee args target count
    [Piece.bytes (Instr.encode call place pc)]

/-- The object code of the instruction at body offset pc: its bytes, but a call to an import leaves its rel32 field to the linker. -/
def Instr.pieces (self : Instr) (own : Nat) (place : Place) (pc : Nat) : List Piece :=
  match self with
  | .imm value => [Piece.bytes (Instr.encode self place pc)]
  | .load slot => [Piece.bytes (Instr.encode self place pc)]
  | .store slot => [Piece.bytes (Instr.encode self place pc)]
  | .neg => [Piece.bytes (Instr.encode self place pc)]
  | .op word operation slot => [Piece.bytes (Instr.encode self place pc)]
  | .cmp word operation slot => [Piece.bytes (Instr.encode self place pc)]
  | .jmp target => [Piece.bytes (Instr.encode self place pc)]
  | .jz target => [Piece.bytes (Instr.encode self place pc)]
  | .call callee args target count => callPieces own place pc callee args target count
  | .ret sources => [Piece.bytes (Instr.encode self place pc)]
  | .bump shift => [Piece.bytes (Instr.encode self place pc)]
  | .loadAt => [Piece.bytes (Instr.encode self place pc)]
  | .storeAt slot => [Piece.bytes (Instr.encode self place pc)]
  | .loadWordAt width => [Piece.bytes (Instr.encode self place pc)]
  | .storeWordAt width slot => [Piece.bytes (Instr.encode self place pc)]

def piecesFrom (own : Nat) (place : Place) (pc : Nat) (code : List Instr) : List Piece :=
  match code with
  | [] => []
  | i :: rest => Instr.pieces i own place pc ++ piecesFrom own place (pc + Instr.size i) rest

/-- The functions laid out back to back from start inside the module, with entries their module offsets. -/
def objectFuncs (own : Nat) (entries : List Nat) (start : Nat) (codes : List Code) : List ObjFunc :=
  match codes with
  | [] => []
  | code :: rest => ({ slots := code.slots, pieces := Piece.bytes (prologue code.slots) :: piecesFrom own ({ body := start + 13, slots := code.slots, entries := entries } : Place) 0 code.instrs } : ObjFunc) :: objectFuncs own entries (start + Code.size code) rest

def importArities (imports : List Import) : List Arity :=
  match imports with
  | [] => []
  | imp :: rest => imp.arity :: importArities rest

/-- Compile one module alone: its calls are checked against its own functions' arities and its imports' declared ones. -/
def compileModule (m : Module) : Option Object :=
  match compileFuncs (arities m.funcs ++ importArities m.imports) m.funcs with
  | none => none
  | some codes => some ({ exports := arities m.funcs, imports := m.imports, funcs := objectFuncs m.funcs.length (layout 0 codes) 0 codes } : Object)

def compileModules (ms : List Module) : Option (List Object) :=
  match ms with
  | [] => some []
  | m :: rest =>
    match compileModule m with
    | none => none
    | some obj =>
      match compileModules rest with
      | none => none
      | some objs => some (obj :: objs)

def Piece.size (self : Piece) : Nat :=
  match self with
  | .bytes code => code.length
  | .rel index => 4

/-- The bytes of the piece at image offset pos; targets are the entries of the object's imports. -/
def Piece.render (self : Piece) (targets : List Nat) (pos : Nat) : List UInt8 :=
  match self with
  | .bytes code => code
  | .rel index => le32 (relative (pos + 4) (targets.getD index 0))

def piecesSize (pieces : List Piece) : Nat :=
  match pieces with
  | [] => 0
  | piece :: rest => Piece.size piece + piecesSize rest

def render (targets : List Nat) (pos : Nat) (pieces : List Piece) : List UInt8 :=
  match pieces with
  | [] => []
  | piece :: rest => Piece.render piece targets pos ++ render targets (pos + Piece.size piece) rest

def funcsSize (funcs : List ObjFunc) : Nat :=
  match funcs with
  | [] => 0
  | func :: rest => piecesSize func.pieces + funcsSize rest

/-- Entry offsets of an object's functions placed from start. -/
def objectLayout (start : Nat) (funcs : List ObjFunc) : List Nat :=
  match funcs with
  | [] => []
  | func :: rest => start :: objectLayout (start + piecesSize func.pieces) rest

/-- Entry offsets of every function of the objects placed from start. -/
def objectsLayout (start : Nat) (objs : List Object) : List Nat :=
  match objs with
  | [] => []
  | obj :: rest => objectLayout start obj.funcs ++ objectsLayout (start + funcsSize obj.funcs) rest

def objectExports (objs : List Object) : List (List Arity) :=
  match objs with
  | [] => []
  | obj :: rest => obj.exports :: objectExports rest

def objectsOk (exports : List (List Arity)) (objs : List Object) : Bool :=
  match objs with
  | [] => true
  | obj :: rest => importsOk exports obj.imports && objectsOk exports rest

/-- The image index of each object's first function, from first. -/
def objectFirsts (first : Nat) (objs : List Object) : List Nat :=
  match objs with
  | [] => []
  | obj :: rest => first :: objectFirsts (first + obj.funcs.length) rest

def entriesAt (entries : List Nat) (indices : List Nat) : List Nat :=
  match indices with
  | [] => []
  | index :: rest => entries.getD index 0 :: entriesAt entries rest

def renderFuncs (targets : List Nat) (pos : Nat) (funcs : List ObjFunc) : List UInt8 :=
  match funcs with
  | [] => []
  | func :: rest => render targets pos func.pieces ++ renderFuncs targets (pos + piecesSize func.pieces) rest

def renderObjects (firsts : List Nat) (entries : List Nat) (pos : Nat) (objs : List Object) : List UInt8 :=
  match objs with
  | [] => []
  | obj :: rest => renderFuncs (entriesAt entries (importIndices firsts obj.imports)) pos obj.funcs ++ renderObjects firsts entries (pos + funcsSize obj.funcs) rest

def funcsSlots (funcs : List ObjFunc) : List Nat :=
  match funcs with
  | [] => []
  | func :: rest => func.slots :: funcsSlots rest

def objectsSlots (objs : List Object) : List Nat :=
  match objs with
  | [] => []
  | obj :: rest => funcsSlots obj.funcs ++ objectsSlots rest

/-- A linked program: each function's frame slots, its entry offset, and the image. -/
structure Executable where
  slots : List Nat
  entries : List Nat
  image : List UInt8
  deriving DecidableEq, Repr

def linkObjects (objs : List Object) : Option Executable :=
  let entries : List Nat := objectsLayout 0 objs
  let image : List UInt8 := renderObjects (objectFirsts 0 objs) entries 0 objs
  if objectsOk (objectExports objs) objs && decide (image.length ≤ imageLimit) then
    some ({ slots := objectsSlots objs, entries := entries, image := image } : Executable)
  else
    none

/-- An unsigned integer type. A value sits zero-extended in its slot. -/
inductive UintTy where
  | uint8 : UintTy
  | uint32 : UintTy
  | uint64 : UintTy
  | usize : UintTy
  deriving DecidableEq, Repr

/-- Its index, for comparing types. -/
def UintTy.code (self : UintTy) : Nat :=
  match self with
  | .uint8 => 0
  | .uint32 => 1
  | .uint64 => 2
  | .usize => 3

/-- The largest value, 2^width - 1. -/
def UintTy.mask (self : UintTy) : BitVec 64 :=
  match self with
  | .uint8 => 255
  | .uint32 => 4294967295
  | .uint64 => 18446744073709551615
  | .usize => 18446744073709551615

/-- 64 bits wide, so slot arithmetic wraps the same way. -/
def UintTy.isWide (self : UintTy) : Bool :=
  match self with
  | .uint8 => false
  | .uint32 => false
  | .uint64 => true
  | .usize => true

inductive SrcType where
  | i32 : SrcType
  | bool : SrcType
  | uint : UintTy → SrcType
  | struct : Nat → (List SrcType) → SrcType
  | enum : Nat → (List (List SrcType)) → SrcType
  /-- a raw pointer into the heap -/
  | ptr : SrcType
  /-- Core's raw slice of this element type: one slot, its address -/
  | slice : SrcType → SrcType
  deriving Repr

inductive SrcOp where
  | plus : SrcOp
  | minus : SrcOp
  | times : SrcOp
  | bitAnd : SrcOp
  | bitOr : SrcOp
  | bitXor : SrcOp
  | less : SrcOp
  | lessEq : SrcOp
  | greater : SrcOp
  | greaterEq : SrcOp
  | equal : SrcOp
  | notEqual : SrcOp
  | logicalAnd : SrcOp
  | logicalOr : SrcOp
  deriving DecidableEq, Repr

inductive SrcExpr where
  | int : (BitVec 32) → SrcExpr
  | boolean : Bool → SrcExpr
  /-- a literal of an unsigned type -/
  | unsigned : UintTy → (BitVec 64) → SrcExpr
  | local : Nat → SrcExpr
  /-- field of a struct local -/
  | field : Nat → Nat → SrcExpr
  | negate : SrcExpr → SrcExpr
  | not : SrcExpr → SrcExpr
  | apply : SrcOp → SrcExpr → SrcExpr → SrcExpr
  /-- between i32 and the unsigned types, wrapping like Core -/
  | cast : SrcType → SrcExpr → SrcExpr
  deriving Repr

/-- A match arm: the binders of its variant's payload, and its value. -/
structure SrcArm where
  binders : List Nat
  value : SrcExpr
  deriving Repr

inductive SrcStmt where
  | nop : SrcStmt
  /-- let id: ty = value; then body, with id in scope. A struct value is a struct local. -/
  | let : Nat → SrcType → SrcExpr → SrcStmt → SrcStmt
  /-- let id: ty = ty { fields }; then body -/
  | letStruct : Nat → SrcType → (List SrcExpr) → SrcStmt → SrcStmt
  /-- let id: ty = callee(args); then body -/
  | letCall : Nat → SrcType → Nat → (List SrcExpr) → SrcStmt → SrcStmt
  /-- let id: ty = variant(payload) of the enum type ty; then body -/
  | letEnum : Nat → SrcType → Nat → (List SrcExpr) → SrcStmt → SrcStmt
  /-- let id: ty = match scrutinee { arms }; then body. The scrutinee is a local of the enum type with Core id enum_id, and arm k is variant k. -/
  | letMatch : Nat → SrcType → Nat → Nat → (List SrcArm) → SrcStmt → SrcStmt
  | set : Nat → SrcExpr → SrcStmt
  /-- id.field = value -/
  | setField : Nat → Nat → SrcExpr → SrcStmt
  /-- id = callee(args) -/
  | setCall : Nat → Nat → (List SrcExpr) → SrcStmt
  | then : SrcStmt → SrcStmt → SrcStmt
  | if : SrcExpr → SrcStmt → SrcStmt → SrcStmt
  | while : SrcExpr → SrcStmt → SrcStmt
  | return : SrcExpr → SrcStmt
  /-- let id: ptr = alloc(size, 2^shift); then body -/
  | letAlloc : Nat → SrcExpr → Nat → SrcStmt → SrcStmt
  /-- let id: u8 = load_byte(pointer, offset); then body -/
  | letLoad : Nat → SrcExpr → SrcExpr → SrcStmt → SrcStmt
  /-- store_byte(pointer, offset, value) -/
  | setByte : SrcExpr → SrcExpr → SrcExpr → SrcStmt
  /-- dealloc(pointer, size, 2^shift) -/
  | free : SrcExpr → SrcExpr → Nat → SrcStmt
  /-- let id: [element] = slice_from_raw_parts(pointer, length); then body -/
  | letSlice : Nat → SrcType → SrcExpr → SrcExpr → SrcStmt → SrcStmt
  /-- let id: ty = slice[index]; then body -/
  | letIndex : Nat → SrcType → Nat → SrcExpr → SrcStmt → SrcStmt
  /-- slice[index] = value -/
  | setIndex : Nat → SrcExpr → SrcExpr → SrcStmt
  deriving Repr

structure SrcParam where
  id : Nat
  ty : SrcType
  deriving Repr

structure SrcFunc where
  params : List SrcParam
  ret : SrcType
  body : SrcStmt
  deriving Repr

structure SrcProgram where
  funcs : List SrcFunc
  deriving Repr

structure Binding where
  id : Nat
  slot : Nat
  ty : SrcType
  deriving Repr

/-- The innermost binding of id. -/
def lookup (scope : List Binding) (id : Nat) : Option Binding :=
  match scope with
  | [] => none
  | binding :: rest =>
    if binding.id = id then
      some binding
    else
      lookup rest id

def boolBits (value : Bool) : BitVec 64 :=
  if value then
    1
  else
    0

def SrcType.isI32 (self : SrcType) : Bool :=
  match self with
  | .i32 => true
  | .bool => false
  | .uint kind => false
  | .struct id fields => false
  | .enum id variants => false
  | .ptr => false
  | .slice element => false

def SrcType.isBool (self : SrcType) : Bool :=
  match self with
  | .i32 => false
  | .bool => true
  | .uint kind => false
  | .struct id fields => false
  | .enum id variants => false
  | .ptr => false
  | .slice element => false

def SrcType.isScalar (self : SrcType) : Bool :=
  match self with
  | .i32 => true
  | .bool => true
  | .uint kind => true
  | .struct id fields => false
  | .enum id variants => false
  | .ptr => true
  | .slice element => false

def SrcType.isUint (self : SrcType) (kind : UintTy) : Bool :=
  match self with
  | .i32 => false
  | .bool => false
  | .uint other => decide (UintTy.code other = UintTy.code kind)
  | .struct id fields => false
  | .enum id variants => false
  | .ptr => false
  | .slice element => false

def SrcType.isPtr (self : SrcType) : Bool :=
  match self with
  | .i32 => false
  | .bool => false
  | .uint kind => false
  | .struct id fields => false
  | .enum id variants => false
  | .ptr => true
  | .slice element => false

/-- The unsigned type this is, if it is one. -/
def SrcType.uintKind (self : SrcType) : Option UintTy :=
  match self with
  | .i32 => none
  | .bool => none
  | .uint kind => some kind
  | .struct id fields => none
  | .enum id variants => none
  | .ptr => none
  | .slice element => none

/-- How a comparison of two values of this type reads their slots. -/
def SrcType.word (self : SrcType) : Word :=
  match self with
  | .i32 => Word.s32
  | .bool => Word.s32
  | .uint kind => Word.u64
  | .struct id fields => Word.s32
  | .enum id variants => Word.s32
  | .ptr => Word.u64
  | .slice element => Word.u64

mutual

def SrcType.same (self : SrcType) (other : SrcType) : Bool :=
  match self with
  | .i32 => SrcType.isI32 other
  | .bool => SrcType.isBool other
  | .uint kind => SrcType.isUint other kind
  | .struct id fields =>
    (match other with
     | .i32 => false
     | .bool => false
     | .uint otherKind => false
     | .struct otherId otherFields => decide (id = otherId) && typesSame fields otherFields
     | .enum otherId otherVariants => false
     | .ptr => false
     | .slice otherElement => false)
  | .enum id variants =>
    (match other with
     | .i32 => false
     | .bool => false
     | .uint otherKind => false
     | .struct otherId otherFields => false
     | .enum otherId otherVariants => decide (id = otherId) && variantsSame variants otherVariants
     | .ptr => false
     | .slice otherElement => false)
  | .ptr => SrcType.isPtr other
  | .slice element =>
    match other with
    | .i32 => false
    | .bool => false
    | .uint otherKind => false
    | .struct otherId otherFields => false
    | .enum otherId otherVariants => false
    | .ptr => false
    | .slice otherElement => SrcType.same element otherElement

def typesSame (types : List SrcType) (others : List SrcType) : Bool :=
  match types with
  | [] =>
    (match others with
     | [] => true
     | other :: more => false)
  | ty :: rest =>
    match others with
    | [] => false
    | other :: more => SrcType.same ty other && typesSame rest more

def variantsSame (variants : List (List SrcType)) (others : List (List SrcType)) : Bool :=
  match variants with
  | [] =>
    (match others with
     | [] => true
     | other :: more => false)
  | types :: rest =>
    match others with
    | [] => false
    | other :: more => typesSame types other && variantsSame rest more

end

mutual

/-- Slots a value of this type takes: a struct's fields in order; an enum's tag, then room for its largest payload. -/
def SrcType.size (self : SrcType) : Nat :=
  match self with
  | .i32 => 1
  | .bool => 1
  | .uint kind => 1
  | .struct id fields => sizes fields
  | .enum id variants => 1 + maxSize variants
  | .ptr => 1
  | .slice element => 1

def sizes (types : List SrcType) : Nat :=
  match types with
  | [] => 0
  | ty :: rest => SrcType.size ty + sizes rest

/-- The largest payload. -/
def maxSize (variants : List (List SrcType)) : Nat :=
  match variants with
  | [] => 0
  | types :: rest => max (sizes types) (maxSize rest)

end

/-- The slot of field index, counted from the struct's first slot. -/
def fieldOffset (types : List SrcType) (index : Nat) : Nat :=
  match types with
  | [] => 0
  | ty :: rest =>
    if index = 0 then
      0
    else
      SrcType.size ty + fieldOffset rest (index - 1)

/-- A lowered expression and its source type. -/
structure Typed where
  expr : Expr
  ty : SrcType
  deriving Repr

/-- e reduced to the width of kind. -/
def wrap (kind : UintTy) (e : Expr) : Expr :=
  if UintTy.isWide kind then
    e
  else
    Expr.binary Word.u64 BinOp.and e (Expr.lit (UintTy.mask kind))

def arithUint (operation : BinOp) (left : Typed) (right : Typed) (kind : Option UintTy) : Option Typed :=
  match kind with
  | none => none
  | some k =>
    if SrcType.isUint right.ty k then
      some ({ expr := wrap k (Expr.binary Word.u64 operation left.expr right.expr), ty := SrcType.uint k } : Typed)
    else
      none

def arith (operation : BinOp) (left : Typed) (right : Typed) : Option Typed :=
  if SrcType.isI32 left.ty && SrcType.isI32 right.ty then
    some ({ expr := Expr.binary Word.s32 operation left.expr right.expr, ty := SrcType.i32 } : Typed)
  else
    arithUint operation left right (SrcType.uintKind left.ty)

def orderUint (operation : CmpOp) (left : Typed) (right : Typed) (kind : Option UintTy) : Option Typed :=
  match kind with
  | none => none
  | some k =>
    if SrcType.isUint right.ty k then
      some ({ expr := Expr.compare Word.u64 operation left.expr right.expr, ty := SrcType.bool } : Typed)
    else
      none

def order (operation : CmpOp) (left : Typed) (right : Typed) : Option Typed :=
  if SrcType.isI32 left.ty && SrcType.isI32 right.ty then
    some ({ expr := Expr.compare Word.s32 operation left.expr right.expr, ty := SrcType.bool } : Typed)
  else
    orderUint operation left right (SrcType.uintKind left.ty)

def equality (operation : CmpOp) (left : Typed) (right : Typed) : Option Typed :=
  if SrcType.same left.ty right.ty then
    some ({ expr := Expr.compare (SrcType.word left.ty) operation left.expr right.expr, ty := SrcType.bool } : Typed)
  else
    none

def conjunction (left : Typed) (right : Typed) : Option Typed :=
  if SrcType.isBool left.ty && SrcType.isBool right.ty then
    some ({ expr := Expr.binary Word.s32 BinOp.and left.expr right.expr, ty := SrcType.bool } : Typed)
  else
    none

def disjunction (left : Typed) (right : Typed) : Option Typed :=
  if SrcType.isBool left.ty && SrcType.isBool right.ty then
    let either : Expr := Expr.binary Word.s32 BinOp.or left.expr right.expr
    some ({ expr := Expr.compare Word.s32 CmpOp.ne either (Expr.lit 0), ty := SrcType.bool } : Typed)
  else
    none

def SrcOp.lower (self : SrcOp) (left : Typed) (right : Typed) : Option Typed :=
  match self with
  | .plus => arith BinOp.add left right
  | .minus => arith BinOp.sub left right
  | .times => arith BinOp.mul left right
  | .bitAnd => arith BinOp.and left right
  | .bitOr => arith BinOp.or left right
  | .bitXor => arith BinOp.xor left right
  | .less => order CmpOp.lt left right
  | .lessEq => order CmpOp.le left right
  | .greater => order CmpOp.gt left right
  | .greaterEq => order CmpOp.ge left right
  | .equal => equality CmpOp.eq left right
  | .notEqual => equality CmpOp.ne left right
  | .logicalAnd => conjunction left right
  | .logicalOr => disjunction left right

def lowerScalarLocal (b : Binding) : Option Typed :=
  if SrcType.isScalar b.ty then
    some ({ expr := Expr.var b.slot, ty := b.ty } : Typed)
  else
    none

def lowerLocal (binding : Option Binding) : Option Typed :=
  match binding with
  | none => none
  | some b => lowerScalarLocal b

/-- A field read is a scalar field's slot. -/
def lowerFieldAt (slot : Nat) (found : Option SrcType) : Option Typed :=
  match found with
  | none => none
  | some ty =>
    if SrcType.isScalar ty then
      some ({ expr := Expr.var slot, ty := ty } : Typed)
    else
      none

def lowerFieldOf (b : Binding) (field : Nat) : Option Typed :=
  match b.ty with
  | .i32 => none
  | .bool => none
  | .uint kind => none
  | .struct id fields => lowerFieldAt (b.slot + fieldOffset fields field) fields[field]?
  | .enum id variants => none
  | .ptr => none
  | .slice element => none

def lowerField (binding : Option Binding) (field : Nat) : Option Typed :=
  match binding with
  | none => none
  | some b => lowerFieldOf b field

def lowerNegateTyped (operand : Typed) : Option Typed :=
  if SrcType.isI32 operand.ty then
    some ({ expr := Expr.neg operand.expr, ty := SrcType.i32 } : Typed)
  else
    none

def lowerNegate (operand : Option Typed) : Option Typed :=
  match operand with
  | none => none
  | some e => lowerNegateTyped e

def lowerNotTyped (operand : Typed) : Option Typed :=
  if SrcType.isBool operand.ty then
    some ({ expr := Expr.compare Word.s32 CmpOp.eq operand.expr (Expr.lit 0), ty := SrcType.bool } : Typed)
  else
    none

def lowerNot (operand : Option Typed) : Option Typed :=
  match operand with
  | none => none
  | some e => lowerNotTyped e

def lowerUnsigned (kind : UintTy) (value : BitVec 64) : Option Typed :=
  if value ≤ UintTy.mask kind then
    some ({ expr := Expr.lit value, ty := SrcType.uint kind } : Typed)
  else
    none

/-- An i32's bits as a value of kind: the low bits, or for 64 bits sign-extended (minus 2^32 when the sign bit is set). -/
def fromI32 (kind : UintTy) (e : Expr) : Expr :=
  if UintTy.isWide kind then
    let negative : Expr := Expr.compare Word.u64 CmpOp.ge e (Expr.lit 2147483648)
    Expr.binary Word.u64 BinOp.sub e (Expr.binary Word.u64 BinOp.mul negative (Expr.lit 4294967296))
  else
    wrap kind e

def castToI32 (e : Typed) : Option Typed :=
  match e.ty with
  | .i32 => some e
  | .bool => none
  | .uint kind => some ({ expr := wrap UintTy.uint32 e.expr, ty := SrcType.i32 } : Typed)
  | .struct id fields => none
  | .enum id variants => none
  | .ptr => none
  | .slice element => none

def castToUint (kind : UintTy) (e : Typed) : Option Typed :=
  match e.ty with
  | .i32 => some ({ expr := fromI32 kind e.expr, ty := SrcType.uint kind } : Typed)
  | .bool => none
  | .uint source => some ({ expr := wrap kind e.expr, ty := SrcType.uint kind } : Typed)
  | .struct id fields => none
  | .enum id variants => none
  | .ptr => none
  | .slice element => none

def castTo (ty : SrcType) (e : Typed) : Option Typed :=
  match ty with
  | .i32 => castToI32 e
  | .bool => none
  | .uint kind => castToUint kind e
  | .struct id fields => none
  | .enum id variants => none
  | .ptr => none
  | .slice element => none

def lowerCast (ty : SrcType) (operand : Option Typed) : Option Typed :=
  match operand with
  | none => none
  | some e => castTo ty e

def lowerApply (op : SrcOp) (left : Option Typed) (right : Option Typed) : Option Typed :=
  match left with
  | none => none
  | some l =>
    match right with
    | none => none
    | some r => SrcOp.lower op l r

def SrcExpr.lower (self : SrcExpr) (scope : List Binding) : Option Typed :=
  match self with
  | .int value => some ({ expr := Expr.lit (BitVec.setWidth 64 value), ty := SrcType.i32 } : Typed)
  | .boolean value => some ({ expr := Expr.lit (boolBits value), ty := SrcType.bool } : Typed)
  | .unsigned kind value => lowerUnsigned kind value
  | .local id => lowerLocal (lookup scope id)
  | .field id index => lowerField (lookup scope id) index
  | .negate operand => lowerNegate (SrcExpr.lower operand scope)
  | .not operand => lowerNot (SrcExpr.lower operand scope)
  | .apply op left right => lowerApply op (SrcExpr.lower left scope) (SrcExpr.lower right scope)
  | .cast ty operand => lowerCast ty (SrcExpr.lower operand scope)

def expectType (typed : Typed) (ty : SrcType) : Option Expr :=
  if SrcType.same typed.ty ty then
    some typed.expr
  else
    none

/-- The expression, if it lowers and has type ty. -/
def lowerAs (scope : List Binding) (e : SrcExpr) (ty : SrcType) : Option Expr :=
  match SrcExpr.lower e scope with
  | none => none
  | some typed => expectType typed ty

def lowerAppend (first : Option (List Expr)) (rest : Option (List Expr)) : Option (List Expr) :=
  match first with
  | none => none
  | some es =>
    match rest with
    | none => none
    | some more => some (es ++ more)

/-- Var(slot), Var(slot + 1), ..., count of them. -/
def slotVars (slot : Nat) (count : Nat) : List Expr :=
  if count = 0 then
    []
  else
    Expr.var slot :: slotVars (slot + 1) (count - 1)

def copyBinding (binding : Option Binding) (ty : SrcType) : Option (List Expr) :=
  match binding with
  | none => none
  | some b =>
    if SrcType.same b.ty ty then
      some (slotVars b.slot (SrcType.size b.ty))
    else
      none

def copyFieldAt (slot : Nat) (found : Option SrcType) (ty : SrcType) : Option (List Expr) :=
  match found with
  | none => none
  | some field =>
    if SrcType.same field ty && decide (0 < SrcType.size field) then
      some (slotVars slot (SrcType.size field))
    else
      none

def copyFieldOf (b : Binding) (index : Nat) (ty : SrcType) : Option (List Expr) :=
  match b.ty with
  | .i32 => none
  | .bool => none
  | .uint kind => none
  | .struct id fields => copyFieldAt (b.slot + fieldOffset fields index) fields[index]? ty
  | .enum id variants => none
  | .ptr => none
  | .slice element => none

/-- A field of type ty of a struct local, slot by slot. It takes slots. -/
def copyField (binding : Option Binding) (index : Nat) (ty : SrcType) : Option (List Expr) :=
  match binding with
  | none => none
  | some b => copyFieldOf b index ty

/-- An aggregate value: a local or a field of that type, slot by slot. -/
def lowerCopy (scope : List Binding) (e : SrcExpr) (ty : SrcType) : Option (List Expr) :=
  match e with
  | .int value => none
  | .boolean value => none
  | .unsigned kind value => none
  | .local id => copyBinding (lookup scope id) ty
  | .field id index => copyField (lookup scope id) index ty
  | .negate operand => none
  | .not operand => none
  | .apply op left right => none
  | .cast target operand => none

def lowerSingle (value : Option Expr) : Option (List Expr) :=
  match value with
  | none => none
  | some x => some [x]

/-- A value of type ty, one expression per slot. -/
def lowerValue (scope : List Binding) (e : SrcExpr) (ty : SrcType) : Option (List Expr) :=
  if SrcType.isScalar ty then
    lowerSingle (lowerAs scope e ty)
  else
    lowerCopy scope e ty

/-- The arguments, if there is one of each parameter type, slot by slot. -/
def lowerArgs (scope : List Binding) (args : List SrcExpr) (types : List SrcType) : Option (List Expr) :=
  match args with
  | [] =>
    (match types with
     | [] => some []
     | ty :: more => none)
  | arg :: rest =>
    match types with
    | [] => none
    | ty :: more => lowerAppend (lowerValue scope arg ty) (lowerArgs scope rest more)

/-- A struct literal's fields are like arguments, one of each field type. A struct value takes slots, so every binding has its own. -/
def lowerStructFields (scope : List Binding) (fields : List SrcExpr) (types : List SrcType) : Option (List Expr) :=
  if sizes types = 0 then
    none
  else
    lowerArgs scope fields types

def lowerLiteral (scope : List Binding) (ty : SrcType) (fields : List SrcExpr) : Option (List Expr) :=
  match ty with
  | .i32 => none
  | .bool => none
  | .uint kind => none
  | .struct id types => lowerStructFields scope fields types
  | .enum id variants => none
  | .ptr => none
  | .slice element => none

def lowerTag (variant : Nat) (payload : Option (List Expr)) : Option (List Expr) :=
  match payload with
  | none => none
  | some es => some (Expr.lit (BitVec.ofNat 64 variant) :: es)

def lowerVariant (scope : List Binding) (variant : Nat) (found : Option (List SrcType)) (payload : List SrcExpr) : Option (List Expr) :=
  match found with
  | none => none
  | some types => lowerTag variant (lowerArgs scope payload types)

/-- Tags are 32-bit, so an enum has fewer than 2^32 variants. -/
def lowerTagged (scope : List Binding) (variants : List (List SrcType)) (variant : Nat) (payload : List SrcExpr) : Option (List Expr) :=
  if variants.length < 4294967296 then
    lowerVariant scope variant variants[variant]? payload
  else
    none

/-- An enum value: its tag, then the variant's payload. Slots past the payload are left as they are. -/
def lowerEnumValue (scope : List Binding) (ty : SrcType) (variant : Nat) (payload : List SrcExpr) : Option (List Expr) :=
  match ty with
  | .i32 => none
  | .bool => none
  | .uint kind => none
  | .struct id types => none
  | .enum id variants => lowerTagged scope variants variant payload
  | .ptr => none
  | .slice element => none

/-- The scope of an arm: each binder names its payload field's slots, binding in order as Core's bindLocals does. A binder takes slots, so no two share a first slot. -/
def armScope (binders : List Nat) (types : List SrcType) (slot : Nat) (scope : List Binding) : Option (List Binding) :=
  match binders with
  | [] =>
    (match types with
     | [] => some scope
     | ty :: more => none)
  | binder :: rest =>
    match types with
    | [] => none
    | ty :: more =>
      if 0 < SrcType.size ty then
        armScope rest more (slot + SrcType.size ty) (({ id := binder, slot := slot, ty := ty } : Binding) :: scope)
      else
        none

/-- Assign values to slot, slot + 1, ..., then run rest. -/
def assignFrom (slot : Nat) (values : List Expr) (rest : Stmt) : Stmt :=
  match values with
  | [] => rest
  | value :: more => Stmt.seq (Stmt.assign slot value) (assignFrom (slot + 1) more rest)

def lowerArmValue (scope : Option (List Binding)) (value : SrcExpr) (ty : SrcType) : Option (List Expr) :=
  match scope with
  | none => none
  | some s => lowerValue s value ty

/-- Arm k stores its value's slots from target; the last arm needs no tag test. -/
def lowerArm (slot : Nat) (target : Nat) (k : Nat) (values : Option (List Expr)) (rest : List SrcArm) (others : Option Stmt) : Option Stmt :=
  match values with
  | none => none
  | some vs =>
    match rest with
    | [] => some (assignFrom target vs Stmt.skip)
    | arm :: more =>
      match others with
      | none => none
      | some o => some (Stmt.ite (Expr.compare Word.u64 CmpOp.eq (Expr.var slot) (Expr.lit (BitVec.ofNat 64 k))) (assignFrom target vs Stmt.skip) o)

/-- Arms k, k + 1, ... of a match on the enum at slot, one per variant from k. -/
def lowerArms (scope : List Binding) (slot : Nat) (target : Nat) (ty : SrcType) (k : Nat) (variants : List (List SrcType)) (arms : List SrcArm) : Option Stmt :=
  match arms with
  | [] => none
  | arm :: rest =>
    match variants with
    | [] => none
    | types :: more => lowerArm slot target k (lowerArmValue (armScope arm.binders types (slot + 1) scope) arm.value ty) rest (lowerArms scope slot target ty (k + 1) more rest)

/-- The match is exhaustive, its value takes slots, and its tags fit in 32 bits. -/
def lowerMatchArms (scope : List Binding) (slot : Nat) (same : Bool) (variants : List (List SrcType)) (arms : List SrcArm) (ty : SrcType) (target : Nat) : Option Stmt :=
  if same && decide (0 < SrcType.size ty) && decide (arms.length = variants.length) && decide (variants.length < 4294967296) then
    lowerArms scope slot target ty 0 variants arms
  else
    none

def lowerMatchOn (scope : List Binding) (b : Binding) (enumId : Nat) (arms : List SrcArm) (ty : SrcType) (target : Nat) : Option Stmt :=
  match b.ty with
  | .i32 => none
  | .bool => none
  | .uint kind => none
  | .struct id types => none
  | .enum id variants => lowerMatchArms scope b.slot (decide (id = enumId)) variants arms ty target
  | .ptr => none
  | .slice element => none

def lowerMatch (scope : List Binding) (binding : Option Binding) (enumId : Nat) (arms : List SrcArm) (ty : SrcType) (target : Nat) : Option Stmt :=
  match binding with
  | none => none
  | some b => lowerMatchOn scope b enumId arms ty target

/-- A function's parameter types and result type. -/
structure Sig where
  params : List SrcType
  ret : SrcType
  deriving Repr

def lowerCallSig (scope : List Binding) (sig : Sig) (args : List SrcExpr) (ty : SrcType) : Option (List Expr) :=
  if SrcType.same sig.ret ty then
    lowerArgs scope args sig.params
  else
    none

/-- The arguments of a call returning ty to callee. -/
def lowerCall (sigs : List Sig) (scope : List Binding) (callee : Nat) (args : List SrcExpr) (ty : SrcType) : Option (List Expr) :=
  match sigs[callee]? with
  | none => none
  | some sig => lowerCallSig scope sig args ty

def lowerLet (slot : Nat) (values : Option (List Expr)) (body : Option Stmt) : Option Stmt :=
  match values with
  | none => none
  | some vs =>
    match body with
    | none => none
    | some b => some (assignFrom slot vs b)

def lowerLetCall (slot : Nat) (count : Nat) (callee : Nat) (args : Option (List Expr)) (body : Option Stmt) : Option Stmt :=
  match args with
  | none => none
  | some a =>
    match body with
    | none => none
    | some b => some (Stmt.seq (Stmt.call slot count callee a) b)

def lowerSetValues (slot : Nat) (values : Option (List Expr)) : Option Stmt :=
  match values with
  | none => none
  | some vs => some (assignFrom slot vs Stmt.skip)

def lowerSet (binding : Option Binding) (scope : List Binding) (value : SrcExpr) : Option Stmt :=
  match binding with
  | none => none
  | some b => lowerSetValues b.slot (lowerValue scope value b.ty)

def lowerSetValue (slot : Nat) (value : Option Expr) : Option Stmt :=
  match value with
  | none => none
  | some v => some (Stmt.assign slot v)

/-- A field write stores a scalar field's slot. -/
def lowerSetFieldAt (slot : Nat) (found : Option SrcType) (scope : List Binding) (value : SrcExpr) : Option Stmt :=
  match found with
  | none => none
  | some ty =>
    if SrcType.isScalar ty then
      lowerSetValue slot (lowerAs scope value ty)
    else
      none

def lowerSetFieldOf (b : Binding) (field : Nat) (scope : List Binding) (value : SrcExpr) : Option Stmt :=
  match b.ty with
  | .i32 => none
  | .bool => none
  | .uint kind => none
  | .struct id fields => lowerSetFieldAt (b.slot + fieldOffset fields field) fields[field]? scope value
  | .enum id variants => none
  | .ptr => none
  | .slice element => none

def lowerSetField (binding : Option Binding) (field : Nat) (scope : List Binding) (value : SrcExpr) : Option Stmt :=
  match binding with
  | none => none
  | some b => lowerSetFieldOf b field scope value

def lowerSetCallArgs (slot : Nat) (count : Nat) (callee : Nat) (args : Option (List Expr)) : Option Stmt :=
  match args with
  | none => none
  | some a => some (Stmt.call slot count callee a)

def lowerSetCall (sigs : List Sig) (scope : List Binding) (binding : Option Binding) (callee : Nat) (args : List SrcExpr) : Option Stmt :=
  match binding with
  | none => none
  | some b => lowerSetCallArgs b.slot (SrcType.size b.ty) callee (lowerCall sigs scope callee args b.ty)

def lowerThen (first : Option Stmt) (second : Option Stmt) : Option Stmt :=
  match first with
  | none => none
  | some a =>
    match second with
    | none => none
    | some b => some (Stmt.seq a b)

def lowerIf (condition : Option Expr) (thenBranch : Option Stmt) (elseBranch : Option Stmt) : Option Stmt :=
  match condition with
  | none => none
  | some c =>
    match thenBranch with
    | none => none
    | some t =>
      match elseBranch with
      | none => none
      | some e => some (Stmt.ite c t e)

def lowerWhile (condition : Option Expr) (body : Option Stmt) : Option Stmt :=
  match condition with
  | none => none
  | some c =>
    match body with
    | none => none
    | some b => some (Stmt.loop c b)

def lowerReturn (values : Option (List Expr)) : Option Stmt :=
  match values with
  | none => none
  | some vs => some (Stmt.ret vs)

/-- The bump allocator's size: Core gives a block of size 0 one byte. -/
def atLeastOne (size : Expr) : Expr :=
  Expr.binary Word.u64 BinOp.add size (Expr.compare Word.u64 CmpOp.eq size (Expr.lit 0))

def lowerAlloc (slot : Nat) (shift : Nat) (size : Option Expr) (body : Option Stmt) : Option Stmt :=
  if shift < 32 then
    match size with
    | none => none
    | some s =>
      match body with
      | none => none
      | some b => some (Stmt.seq (Stmt.alloc slot shift (atLeastOne s)) b)
  else
    none

/-- A pointer and a usize offset as an address. -/
def lowerAddress (pointer : Option Expr) (offset : Option Expr) : Option Expr :=
  match pointer with
  | none => none
  | some p =>
    match offset with
    | none => none
    | some o => some (Expr.binary Word.u64 BinOp.add p o)

def lowerLoad (slot : Nat) (address : Option Expr) (body : Option Stmt) : Option Stmt :=
  match address with
  | none => none
  | some a =>
    match body with
    | none => none
    | some b => some (Stmt.seq (Stmt.loadByte slot a) b)

def lowerStore (address : Option Expr) (value : Option Expr) : Option Stmt :=
  match address with
  | none => none
  | some a =>
    match value with
    | none => none
    | some v => some (Stmt.storeByte a v)

/-- The bump allocator never frees, so a free only checks its operands' types. -/
def lowerFree (shift : Nat) (pointer : Option Expr) (size : Option Expr) : Option Stmt :=
  if shift < 32 then
    match pointer with
    | none => none
    | some p =>
      match size with
      | none => none
      | some s => some Stmt.skip
  else
    none

/-- Struct id's field types. -/
structure SrcStructDecl where
  id : Nat
  fields : List SrcType
  deriving Repr

/-- Enum id's variants, each its payload types. -/
structure SrcEnumDecl where
  id : Nat
  variants : List (List SrcType)
  deriving Repr

structure SrcDecls where
  structs : List SrcStructDecl
  enums : List SrcEnumDecl
  deriving Repr

/-- The fields declared for struct id. -/
def structFields (decls : List SrcStructDecl) (id : Nat) : Option (List SrcType) :=
  match decls with
  | [] => none
  | decl :: rest =>
    if decl.id = id then
      some decl.fields
    else
      structFields rest id

/-- The variants declared for enum id. -/
def enumVariants (decls : List SrcEnumDecl) (id : Nat) : Option (List (List SrcType)) :=
  match decls with
  | [] => none
  | decl :: rest =>
    if decl.id = id then
      some decl.variants
    else
      enumVariants rest id

def usizeWidth (kind : UintTy) : Option MemWidth :=
  match kind with
  | .uint8 => none
  | .uint32 => none
  | .uint64 => none
  | .usize => some MemWidth.m64

/-- The width a field of a struct element is loaded and stored with. Each field takes one native word: 4 bytes are read for i32 and bool, 8 for usize and ptr. Other field types are not supported in slices yet. -/
def wordWidth (ty : SrcType) : Option MemWidth :=
  match ty with
  | .i32 => some MemWidth.m32
  | .bool => some MemWidth.m32
  | .uint kind => usizeWidth kind
  | .struct id fields => none
  | .enum id variants => none
  | .ptr => some MemWidth.m64
  | .slice element => none

def consWidth (width : Option MemWidth) (rest : Option (List MemWidth)) : Option (List MemWidth) :=
  match width with
  | none => none
  | some w =>
    match rest with
    | none => none
    | some ws => some (w :: ws)

def wordWidths (fields : List SrcType) : Option (List MemWidth) :=
  match fields with
  | [] => some []
  | field :: rest => consWidth (wordWidth field) (wordWidths rest)

def nonemptyWidths (widths : Option (List MemWidth)) : Option (List MemWidth) :=
  match widths with
  | none => none
  | some ws =>
    match ws with
    | [] => none
    | w :: rest => some (w :: rest)

def declaredWidths (declared : Option (List SrcType)) (fields : List SrcType) : Option (List MemWidth) :=
  match declared with
  | none => none
  | some fs =>
    let same : Bool := typesSame fs fields
    if same then
      nonemptyWidths (wordWidths fields)
    else
      none

/-- The field widths of a struct slice element: at least one field, each one native word, so the element takes as many words as it has fields. Core lays the element out by its declaration, which must be these fields. -/
def elementWidths (decls : SrcDecls) (element : SrcType) : Option (List MemWidth) :=
  match element with
  | .i32 => none
  | .bool => none
  | .uint kind => none
  | .struct id fields => declaredWidths (structFields decls.structs id) fields
  | .enum id variants => none
  | .ptr => none
  | .slice inner => none

def isWordStruct (decls : SrcDecls) (element : SrcType) : Bool :=
  match elementWidths decls element with
  | none => false
  | some ws => true

def consWidths (widths : Option (List MemWidth)) (rest : Option (List (List MemWidth))) : Option (List (List MemWidth)) :=
  match widths with
  | none => none
  | some ws =>
    match rest with
    | none => none
    | some wss => some (ws :: wss)

/-- The payload widths of each variant, every payload field one native word. -/
def variantWidths (variants : List (List SrcType)) : Option (List (List MemWidth)) :=
  match variants with
  | [] => some []
  | types :: rest => consWidths (wordWidths types) (variantWidths rest)

def maxLength (widths : List (List MemWidth)) : Nat :=
  match widths with
  | [] => 0
  | ws :: rest => max ws.length (maxLength rest)

def declaredVariantWidths (declared : Option (List (List SrcType))) (variants : List (List SrcType)) : Option (List (List MemWidth)) :=
  match declared with
  | none => none
  | some vs =>
    let same : Bool := variantsSame vs variants
    if same && decide (0 < variants.length) && decide (variants.length < 4294967296) then
      variantWidths variants
    else
      none

/-- The payload widths of an enum slice element: at least one variant, with tags that fit in 32 bits, and payload fields of one native word each. Core lays the element out as its tag word followed by the longest payload's words; it must be the declared enum. -/
def enumWidths (decls : SrcDecls) (element : SrcType) : Option (List (List MemWidth)) :=
  match element with
  | .i32 => none
  | .bool => none
  | .uint kind => none
  | .struct id fields => none
  | .enum id variants => declaredVariantWidths (enumVariants decls.enums id) variants
  | .ptr => none
  | .slice inner => none

def isWordEnum (decls : SrcDecls) (element : SrcType) : Bool :=
  match enumWidths decls element with
  | none => false
  | some wss => true

/-- A struct slice's descriptor points at element zero's high word, and elements of `words` words run downward: element index starts (index * words + words - 1) words below it. -/
def elementBase (slot : Nat) (words : Nat) (index : Expr) : Expr :=
  let stride : Expr := Expr.binary Word.u64 BinOp.mul index (Expr.lit (BitVec.ofNat 64 (8 * words)))
  Expr.binary Word.u64 BinOp.sub (Expr.var slot) (Expr.binary Word.u64 BinOp.add stride (Expr.lit (BitVec.ofNat 64 (8 * (words - 1)))))

/-- Load the fields at base + offset, base + offset + 8, ... into the slots from target, then run body. -/
def loadFields (widths : List MemWidth) (target : Nat) (base : Expr) (offset : Nat) (body : Stmt) : Stmt :=
  match widths with
  | [] => body
  | w :: rest => Stmt.seq (Stmt.loadWord w target (Expr.binary Word.u64 BinOp.add base (Expr.lit (BitVec.ofNat 64 offset)))) (loadFields rest (target + 1) base (offset + 8) body)

def storeThen (w : MemWidth) (address : Expr) (value : Expr) (rest : Option Stmt) : Option Stmt :=
  match rest with
  | none => none
  | some s => some (Stmt.seq (Stmt.storeWord w address value) s)

/-- Store the field values at base + offset, base + offset + 8, ...; values past the widths are not stored. -/
def storeFields (widths : List MemWidth) (values : List Expr) (base : Expr) (offset : Nat) : Option Stmt :=
  match widths with
  | [] => some Stmt.skip
  | w :: rest =>
    match values with
    | [] => none
    | v :: more => storeThen w (Expr.binary Word.u64 BinOp.add base (Expr.lit (BitVec.ofNat 64 offset))) v (storeFields rest more base (offset + 8))

/-- Load the payload of the variant whose tag is in slot target, the variants from k on, into the slots after it. The last variant needs no tag test. -/
def loadVariants (target : Nat) (base : Expr) (k : Nat) (widths : List (List MemWidth)) : Stmt :=
  match widths with
  | [] => Stmt.skip
  | ws :: rest =>
    match rest with
    | [] => loadFields ws (target + 1) base 8 Stmt.skip
    | more :: others => Stmt.ite (Expr.compare Word.u64 CmpOp.eq (Expr.var target) (Expr.lit (BitVec.ofNat 64 k))) (loadFields ws (target + 1) base 8 Stmt.skip) (loadVariants target base (k + 1) rest)

def iteThen (condition : Expr) (thenBranch : Option Stmt) (elseBranch : Option Stmt) : Option Stmt :=
  match thenBranch with
  | none => none
  | some t =>
    match elseBranch with
    | none => none
    | some e => some (Stmt.ite condition t e)

/-- Store the payload of the variant whose tag is tag, the variants from k on. -/
def storeVariants (tag : Expr) (payload : List Expr) (base : Expr) (k : Nat) (widths : List (List MemWidth)) : Option Stmt :=
  match widths with
  | [] => none
  | ws :: rest =>
    match rest with
    | [] => storeFields ws payload base 8
    | more :: others => iteThen (Expr.compare Word.u64 CmpOp.eq tag (Expr.lit (BitVec.ofNat 64 k))) (storeFields ws payload base 8) (storeVariants tag payload base (k + 1) rest)

/-- An enum element's tag word, then its payload. -/
def storeEnumValues (widths : List (List MemWidth)) (values : List Expr) (base : Expr) : Option Stmt :=
  match values with
  | [] => none
  | tag :: payload => lowerThen (storeFields [MemWidth.m32] [tag] base 0) (storeVariants tag payload base 0 widths)

/-- A raw slice's one slot: its address. Elements are i32 or word structs; Core checks the length when the slice is made and each index against it. -/
def lowerSlice (decls : SrcDecls) (element : SrcType) (pointer : Option Expr) (length : Option Expr) : Option (List Expr) :=
  if SrcType.isI32 element || isWordStruct decls element || isWordEnum decls element then
    match pointer with
    | none => none
    | some p =>
      match length with
      | none => none
      | some l => some [p]
  else
    none

/-- An index is an i32 or a usize. -/
def indexOf (t : Typed) : Option Expr :=
  if SrcType.isI32 t.ty || SrcType.isUint t.ty UintTy.usize then
    some t.expr
  else
    none

def lowerIndex (scope : List Binding) (index : SrcExpr) : Option Expr :=
  match SrcExpr.lower index scope with
  | none => none
  | some t => indexOf t

/-- The element type of a slice type. -/
def elementOf (ty : SrcType) : Option SrcType :=
  match ty with
  | .i32 => none
  | .bool => none
  | .uint kind => none
  | .struct id fields => none
  | .enum id variants => none
  | .ptr => none
  | .slice element => some element

/-- The address of element index of the slice local b. -/
def elementAddress (b : Binding) (index : Option Expr) : Option Expr :=
  match elementOf b.ty with
  | none => none
  | some element =>
    match index with
    | none => none
    | some i =>
      let slot : Nat := b.slot
      if SrcType.isI32 element then
        some (Expr.binary Word.u64 BinOp.add (Expr.var slot) (Expr.binary Word.u64 BinOp.mul i (Expr.lit 4)))
      else
        none

/-- slice[index] read as a ty. -/
def lowerElement (binding : Option Binding) (ty : SrcType) (index : Option Expr) : Option Expr :=
  match binding with
  | none => none
  | some b =>
    if SrcType.same b.ty (SrcType.slice ty) then
      elementAddress b index
    else
      none

def lowerLoadWord (slot : Nat) (address : Option Expr) (body : Option Stmt) : Option Stmt :=
  match address with
  | none => none
  | some a =>
    match body with
    | none => none
    | some b => some (Stmt.seq (Stmt.loadWord MemWidth.m32 slot a) b)

/-- slice[index] = value for a word struct element: its fields, one store each. -/
def storeStruct (decls : SrcDecls) (b : Binding) (element : SrcType) (index : Option Expr) (scope : List Binding) (value : SrcExpr) : Option Stmt :=
  match elementWidths decls element with
  | none => none
  | some ws =>
    match index with
    | none => none
    | some i =>
      match lowerValue scope value element with
      | none => none
      | some vs => storeFields ws vs (elementBase b.slot ws.length i) 0

/-- slice[index] = value for a word enum element: the tag, then the payload of the value's variant. -/
def storeEnum (decls : SrcDecls) (b : Binding) (element : SrcType) (index : Option Expr) (scope : List Binding) (value : SrcExpr) : Option Stmt :=
  match enumWidths decls element with
  | none => none
  | some wss =>
    match index with
    | none => none
    | some i =>
      match lowerValue scope value element with
      | none => none
      | some vs => storeEnumValues wss vs (elementBase b.slot (maxLength wss + 1) i)

def storeAny (decls : SrcDecls) (b : Binding) (element : SrcType) (index : Option Expr) (scope : List Binding) (value : SrcExpr) : Option Stmt :=
  if SrcType.isI32 element then
    match elementAddress b index with
    | none => none
    | some a =>
      match lowerAs scope value element with
      | none => none
      | some v => some (Stmt.storeWord MemWidth.m32 a v)
  else
    if isWordStruct decls element then
      storeStruct decls b element index scope value
    else
      storeEnum decls b element index scope value

def lowerSetIndexOf (decls : SrcDecls) (b : Binding) (index : Option Expr) (scope : List Binding) (value : SrcExpr) : Option Stmt :=
  match elementOf b.ty with
  | none => none
  | some element => storeAny decls b element index scope value

/-- let x: ty = slice[index] for a word struct ty: each field loaded into its slot. -/
def lowerLoadFields (decls : SrcDecls) (next : Nat) (binding : Option Binding) (ty : SrcType) (index : Option Expr) (body : Option Stmt) : Option Stmt :=
  match binding with
  | none => none
  | some b =>
    match elementWidths decls ty with
    | none => none
    | some ws =>
      match index with
      | none => none
      | some i =>
        match body with
        | none => none
        | some s =>
          if SrcType.same b.ty (SrcType.slice ty) then
            some (loadFields ws next (elementBase b.slot ws.length i) 0 s)
          else
            none

/-- The tag into slot next, then the payload of its variant after it, then body. -/
def loadEnum (next : Nat) (base : Expr) (widths : List (List MemWidth)) (body : Stmt) : Stmt :=
  loadFields [MemWidth.m32] next base 0 (Stmt.seq (loadVariants next base 0 widths) body)

/-- let x: ty = slice[index] for a word enum ty. -/
def lowerLoadEnum (decls : SrcDecls) (next : Nat) (binding : Option Binding) (ty : SrcType) (index : Option Expr) (body : Option Stmt) : Option Stmt :=
  match binding with
  | none => none
  | some b =>
    match enumWidths decls ty with
    | none => none
    | some wss =>
      match index with
      | none => none
      | some i =>
        match body with
        | none => none
        | some s =>
          if SrcType.same b.ty (SrcType.slice ty) then
            some (loadEnum next (elementBase b.slot (maxLength wss + 1) i) wss s)
          else
            none

def lowerLetIndex (decls : SrcDecls) (next : Nat) (binding : Option Binding) (ty : SrcType) (index : Option Expr) (body : Option Stmt) : Option Stmt :=
  if SrcType.isI32 ty then
    lowerLoadWord next (lowerElement binding ty index) body
  else
    if isWordStruct decls ty then
      lowerLoadFields decls next binding ty index body
    else
      lowerLoadEnum decls next binding ty index body

def lowerSetIndex (decls : SrcDecls) (binding : Option Binding) (index : Option Expr) (scope : List Binding) (value : SrcExpr) : Option Stmt :=
  match binding with
  | none => none
  | some b => lowerSetIndexOf decls b index scope value

def SrcStmt.lower (self : SrcStmt) (sigs : List Sig) (decls : SrcDecls) (ret : SrcType) (scope : List Binding) (next : Nat) : Option Stmt :=
  match self with
  | .nop => some Stmt.skip
  | .let id ty value body => lowerLet next (lowerValue scope value ty) (SrcStmt.lower body sigs decls ret (({ id := id, slot := next, ty := ty } : Binding) :: scope) (next + SrcType.size ty))
  | .letStruct id ty fields body => lowerLet next (lowerLiteral scope ty fields) (SrcStmt.lower body sigs decls ret (({ id := id, slot := next, ty := ty } : Binding) :: scope) (next + SrcType.size ty))
  | .letCall id ty callee args body => lowerLetCall next (SrcType.size ty) callee (lowerCall sigs scope callee args ty) (SrcStmt.lower body sigs decls ret (({ id := id, slot := next, ty := ty } : Binding) :: scope) (next + SrcType.size ty))
  | .letEnum id ty variant payload body => lowerLet next (lowerEnumValue scope ty variant payload) (SrcStmt.lower body sigs decls ret (({ id := id, slot := next, ty := ty } : Binding) :: scope) (next + SrcType.size ty))
  | .letMatch id ty scrutinee enumId arms body => lowerThen (lowerMatch scope (lookup scope scrutinee) enumId arms ty next) (SrcStmt.lower body sigs decls ret (({ id := id, slot := next, ty := ty } : Binding) :: scope) (next + SrcType.size ty))
  | .set id value => lowerSet (lookup scope id) scope value
  | .setField id index value => lowerSetField (lookup scope id) index scope value
  | .setCall id callee args => lowerSetCall sigs scope (lookup scope id) callee args
  | .then first second => lowerThen (SrcStmt.lower first sigs decls ret scope next) (SrcStmt.lower second sigs decls ret scope next)
  | .if condition thenBranch elseBranch => lowerIf (lowerAs scope condition SrcType.bool) (SrcStmt.lower thenBranch sigs decls ret scope next) (SrcStmt.lower elseBranch sigs decls ret scope next)
  | .while condition body => lowerWhile (lowerAs scope condition SrcType.bool) (SrcStmt.lower body sigs decls ret scope next)
  | .return value => lowerReturn (lowerValue scope value ret)
  | .letAlloc id size shift body => lowerAlloc next shift (lowerAs scope size (SrcType.uint UintTy.usize)) (SrcStmt.lower body sigs decls ret (({ id := id, slot := next, ty := SrcType.ptr } : Binding) :: scope) (next + 1))
  | .letLoad id pointer offset body => lowerLoad next (lowerAddress (lowerAs scope pointer SrcType.ptr) (lowerAs scope offset (SrcType.uint UintTy.usize))) (SrcStmt.lower body sigs decls ret (({ id := id, slot := next, ty := SrcType.uint UintTy.uint8 } : Binding) :: scope) (next + 1))
  | .setByte pointer offset value => lowerStore (lowerAddress (lowerAs scope pointer SrcType.ptr) (lowerAs scope offset (SrcType.uint UintTy.usize))) (lowerAs scope value (SrcType.uint UintTy.uint8))
  | .free pointer size shift => lowerFree shift (lowerAs scope pointer SrcType.ptr) (lowerAs scope size (SrcType.uint UintTy.usize))
  | .letSlice id element pointer length body => lowerLet next (lowerSlice decls element (lowerAs scope pointer SrcType.ptr) (lowerAs scope length SrcType.i32)) (SrcStmt.lower body sigs decls ret (({ id := id, slot := next, ty := SrcType.slice element } : Binding) :: scope) (next + 1))
  | .letIndex id ty slice index body => lowerLetIndex decls next (lookup scope slice) ty (lowerIndex scope index) (SrcStmt.lower body sigs decls ret (({ id := id, slot := next, ty := ty } : Binding) :: scope) (next + SrcType.size ty))
  | .setIndex slice index value => lowerSetIndex decls (lookup scope slice) (lowerIndex scope index) scope value

/-- Slots the statement's lets need beyond the ones in scope. -/
def SrcStmt.depth (self : SrcStmt) : Nat :=
  match self with
  | .nop => 0
  | .let id ty value body => SrcStmt.depth body + SrcType.size ty
  | .letStruct id ty fields body => SrcStmt.depth body + SrcType.size ty
  | .letCall id ty callee args body => SrcStmt.depth body + SrcType.size ty
  | .letEnum id ty variant payload body => SrcStmt.depth body + SrcType.size ty
  | .letMatch id ty scrutinee enumId arms body => SrcStmt.depth body + SrcType.size ty
  | .set id value => 0
  | .setField id index value => 0
  | .setCall id callee args => 0
  | .then first second => max (SrcStmt.depth first) (SrcStmt.depth second)
  | .if condition thenBranch elseBranch => max (SrcStmt.depth thenBranch) (SrcStmt.depth elseBranch)
  | .while condition body => SrcStmt.depth body
  | .return value => 0
  | .letAlloc id size shift body => SrcStmt.depth body + 1
  | .letLoad id pointer offset body => SrcStmt.depth body + 1
  | .setByte pointer offset value => 0
  | .free pointer size shift => 0
  | .letSlice id element pointer length body => SrcStmt.depth body + 1
  | .letIndex id ty slice index body => SrcStmt.depth body + SrcType.size ty
  | .setIndex slice index value => 0

/-- Parameters take slots from 0 in order, a struct one per field; a later parameter with the same id shadows an earlier one, as Core's bindLocals does. -/
def paramScope (params : List SrcParam) (slot : Nat) (scope : List Binding) : List Binding :=
  match params with
  | [] => scope
  | param :: rest => paramScope rest (slot + SrcType.size param.ty) (({ id := param.id, slot := slot, ty := param.ty } : Binding) :: scope)

def paramsValid (params : List SrcParam) : Bool :=
  match params with
  | [] => true
  | param :: rest => decide (0 < SrcType.size param.ty) && paramsValid rest

def paramsSize (params : List SrcParam) : Nat :=
  match params with
  | [] => 0
  | param :: rest => SrcType.size param.ty + paramsSize rest

def paramTypes (params : List SrcParam) : List SrcType :=
  match params with
  | [] => []
  | param :: rest => param.ty :: paramTypes rest

def sigs (funcs : List SrcFunc) : List Sig :=
  match funcs with
  | [] => []
  | func :: rest => ({ params := paramTypes func.params, ret := func.ret } : Sig) :: sigs rest

def lowerBody (count : Nat) (results : Nat) (depth : Nat) (body : Option Stmt) : Option Func :=
  match body with
  | none => none
  | some b => some ({ params := count, results := results, locals := max (count + depth) results, body := b } : Func)

/-- Results and struct parameters have slots; a function returns its result type's slots, so it has at least that many locals. -/
def lowerFunc (sigs : List Sig) (decls : SrcDecls) (func : SrcFunc) : Option Func :=
  let count : Nat := paramsSize func.params
  if decide (0 < SrcType.size func.ret) && paramsValid func.params then
    lowerBody count (SrcType.size func.ret) (SrcStmt.depth func.body) (SrcStmt.lower func.body sigs decls func.ret (paramScope func.params 0 []) count)
  else
    none

def lowerFuncCons (first : Option Func) (rest : Option (List Func)) : Option (List Func) :=
  match first with
  | none => none
  | some f =>
    match rest with
    | none => none
    | some fs => some (f :: fs)

def lowerFuncs (sigs : List Sig) (decls : SrcDecls) (funcs : List SrcFunc) : Option (List Func) :=
  match funcs with
  | [] => some []
  | func :: rest => lowerFuncCons (lowerFunc sigs decls func) (lowerFuncs sigs decls rest)

/-- decls, if the declaration already there agrees. -/
def keepIf (agrees : Bool) (decls : SrcDecls) : Option SrcDecls :=
  if agrees then
    some decls
  else
    none

/-- Struct id with these fields declared, unless id has other fields. -/
def declareStruct (id : Nat) (fields : List SrcType) (after : Option SrcDecls) : Option SrcDecls :=
  match after with
  | none => none
  | some decls =>
    let known : Option (List SrcType) := structFields decls.structs id
    match known with
    | none => some ({ structs := ({ id := id, fields := fields } : SrcStructDecl) :: decls.structs, enums := decls.enums } : SrcDecls)
    | some other => keepIf (typesSame other fields) decls

/-- Enum id with these variants declared, unless id has other variants. -/
def declareEnum (id : Nat) (variants : List (List SrcType)) (after : Option SrcDecls) : Option SrcDecls :=
  match after with
  | none => none
  | some decls =>
    let known : Option (List (List SrcType)) := enumVariants decls.enums id
    match known with
    | none => some ({ structs := decls.structs, enums := ({ id := id, variants := variants } : SrcEnumDecl) :: decls.enums } : SrcDecls)
    | some other => keepIf (variantsSame other variants) decls

mutual

/-- decls with every struct and enum type in this one declared, the nested ones first; None when one is declared with other fields or variants. -/
def SrcType.declare (self : SrcType) (decls : SrcDecls) : Option SrcDecls :=
  match self with
  | .i32 => some decls
  | .bool => some decls
  | .uint kind => some decls
  | .struct id fields => declareStruct id fields (declareTypes fields decls)
  | .enum id variants => declareEnum id variants (declareVariants variants decls)
  | .ptr => some decls
  | .slice element => SrcType.declare element decls

def declareTypes (types : List SrcType) (decls : SrcDecls) : Option SrcDecls :=
  match types with
  | [] => some decls
  | ty :: rest =>
    let after : Option SrcDecls := SrcType.declare ty decls
    match after with
    | none => none
    | some decls => declareTypes rest decls

def declareVariants (variants : List (List SrcType)) (decls : SrcDecls) : Option SrcDecls :=
  match variants with
  | [] => some decls
  | types :: rest =>
    let after : Option SrcDecls := declareTypes types decls
    match after with
    | none => none
    | some decls => declareVariants rest decls

end

/-- decls with the types of the statement's bindings declared. -/
def SrcStmt.declare (self : SrcStmt) (decls : SrcDecls) : Option SrcDecls :=
  match self with
  | .nop => some decls
  | .let id ty value body =>
    (let after : Option SrcDecls := SrcType.declare ty decls
     match after with
     | none => none
     | some decls => SrcStmt.declare body decls)
  | .letStruct id ty fields body =>
    (let after : Option SrcDecls := SrcType.declare ty decls
     match after with
     | none => none
     | some decls => SrcStmt.declare body decls)
  | .letCall id ty callee args body =>
    (let after : Option SrcDecls := SrcType.declare ty decls
     match after with
     | none => none
     | some decls => SrcStmt.declare body decls)
  | .letEnum id ty variant payload body =>
    (let after : Option SrcDecls := SrcType.declare ty decls
     match after with
     | none => none
     | some decls => SrcStmt.declare body decls)
  | .letMatch id ty scrutinee enumId arms body =>
    (let after : Option SrcDecls := SrcType.declare ty decls
     match after with
     | none => none
     | some decls => SrcStmt.declare body decls)
  | .set id value => some decls
  | .setField id index value => some decls
  | .setCall id callee args => some decls
  | .then first second =>
    (let after : Option SrcDecls := SrcStmt.declare first decls
     match after with
     | none => none
     | some decls => SrcStmt.declare second decls)
  | .if condition thenBranch elseBranch =>
    (let after : Option SrcDecls := SrcStmt.declare thenBranch decls
     match after with
     | none => none
     | some decls => SrcStmt.declare elseBranch decls)
  | .while condition body => SrcStmt.declare body decls
  | .return value => some decls
  | .letAlloc id size shift body => SrcStmt.declare body decls
  | .letLoad id pointer offset body => SrcStmt.declare body decls
  | .setByte pointer offset value => some decls
  | .free pointer size shift => some decls
  | .letSlice id element pointer length body =>
    (let after : Option SrcDecls := SrcType.declare element decls
     match after with
     | none => none
     | some decls => SrcStmt.declare body decls)
  | .letIndex id ty slice index body =>
    (let after : Option SrcDecls := SrcType.declare ty decls
     match after with
     | none => none
     | some decls => SrcStmt.declare body decls)
  | .setIndex slice index value => some decls

/-- Every path ends in a return, the way Core's DefinitelyReturns counts: a while body never counts. -/
def SrcStmt.returns (self : SrcStmt) : Bool :=
  match self with
  | .nop => false
  | .let id ty value body => SrcStmt.returns body
  | .letStruct id ty fields body => SrcStmt.returns body
  | .letCall id ty callee args body => SrcStmt.returns body
  | .letEnum id ty variant payload body => SrcStmt.returns body
  | .letMatch id ty scrutinee enumId arms body => SrcStmt.returns body
  | .set id value => false
  | .setField id index value => false
  | .setCall id callee args => false
  | .then first second => SrcStmt.returns first || SrcStmt.returns second
  | .if condition thenBranch elseBranch => SrcStmt.returns thenBranch && SrcStmt.returns elseBranch
  | .while condition body => false
  | .return value => true
  | .letAlloc id size shift body => SrcStmt.returns body
  | .letLoad id pointer offset body => SrcStmt.returns body
  | .setByte pointer offset value => false
  | .free pointer size shift => false
  | .letSlice id element pointer length body => SrcStmt.returns body
  | .letIndex id ty slice index body => SrcStmt.returns body
  | .setIndex slice index value => false

def declareParams (params : List SrcParam) (decls : SrcDecls) : Option SrcDecls :=
  match params with
  | [] => some decls
  | param :: rest =>
    let after : Option SrcDecls := SrcType.declare param.ty decls
    match after with
    | none => none
    | some decls => declareParams rest decls

/-- A function's parameter, result and binding types. -/
def declareFunc (func : SrcFunc) (decls : SrcDecls) : Option SrcDecls :=
  match declareParams func.params decls with
  | none => none
  | some withParams =>
    let after : Option SrcDecls := SrcType.declare func.ret withParams
    let body : SrcStmt := func.body
    match after with
    | none => none
    | some decls => SrcStmt.declare body decls

def declareFuncs (funcs : List SrcFunc) (decls : SrcDecls) : Option SrcDecls :=
  match funcs with
  | [] => some decls
  | func :: rest =>
    let after : Option SrcDecls := declareFunc func decls
    match after with
    | none => none
    | some decls => declareFuncs rest decls

/-- The program's struct and enum declarations. -/
def declareProgram (prog : SrcProgram) : Option SrcDecls :=
  declareFuncs prog.funcs ({ structs := [], enums := [] } : SrcDecls)

def funcsReturn (funcs : List SrcFunc) : Bool :=
  match funcs with
  | [] => true
  | func :: rest => SrcStmt.returns func.body && funcsReturn rest

/-- The low 32 bits of a word, zero-extended. -/
def lowBits (value : BitVec 64) : BitVec 64 :=
  value &&& 4294967295

/-- The low 32 bits plus 2^31, mod 2^32: unsigned order on keys is signed order on the low halves. -/
def signedKey (value : BitVec 64) : BitVec 64 :=
  lowBits (value + 2147483648)

def BinOp.compute (self : BinOp) (a : BitVec 64) (b : BitVec 64) : BitVec 64 :=
  match self with
  | .add => a + b
  | .sub => a - b
  | .mul => a * b
  | .and => a &&& b
  | .or => a ||| b
  | .xor => a ^^^ b

/-- x op unit is x. -/
def BinOp.unit (self : BinOp) : BitVec 64 :=
  match self with
  | .add => 0
  | .sub => 0
  | .mul => 1
  | .and => 18446744073709551615
  | .or => 0
  | .xor => 0

/-- unit op x is x too. -/
def BinOp.commutes (self : BinOp) : Bool :=
  match self with
  | .add => true
  | .sub => false
  | .mul => true
  | .and => true
  | .or => true
  | .xor => true

/-- x op 0 and 0 op x are 0. -/
def BinOp.annihilates (self : BinOp) : Bool :=
  match self with
  | .add => false
  | .sub => false
  | .mul => true
  | .and => true
  | .or => false
  | .xor => false

def BinOp.number (self : BinOp) : Nat :=
  match self with
  | .add => 0
  | .sub => 1
  | .mul => 2
  | .and => 3
  | .or => 4
  | .xor => 5

/-- Unsigned comparison. -/
def CmpOp.test (self : CmpOp) (a : BitVec 64) (b : BitVec 64) : Bool :=
  match self with
  | .eq => decide (a = b)
  | .ne => decide (a ≠ b)
  | .lt => decide (a < b)
  | .le => decide (a ≤ b)
  | .gt => decide (b < a)
  | .ge => decide (b ≤ a)

def CmpOp.number (self : CmpOp) : Nat :=
  match self with
  | .eq => 0
  | .ne => 1
  | .lt => 2
  | .le => 3
  | .gt => 4
  | .ge => 5

/-- Word.apply. -/
def Word.compute (self : Word) (operation : BinOp) (a : BitVec 64) (b : BitVec 64) : BitVec 64 :=
  match self with
  | .s32 => lowBits (BinOp.compute operation a b)
  | .u64 => BinOp.compute operation a b

/-- Word.holds. -/
def Word.test (self : Word) (operation : CmpOp) (a : BitVec 64) (b : BitVec 64) : Bool :=
  match self with
  | .s32 => CmpOp.test operation (signedKey a) (signedKey b)
  | .u64 => CmpOp.test operation a b

/-- a and b are the same operand of an operation on this word. -/
def Word.sameOperand (self : Word) (a : BitVec 64) (b : BitVec 64) : Bool :=
  match self with
  | .s32 => decide (lowBits a = lowBits b)
  | .u64 => decide (a = b)

/-- Results are zero-extended. -/
def Word.narrows (self : Word) : Bool :=
  match self with
  | .s32 => true
  | .u64 => false

def Word.number (self : Word) : Nat :=
  match self with
  | .s32 => 0
  | .u64 => 1

/-- The value is below 2^32 in every environment. -/
def Expr.narrow (self : Expr) : Bool :=
  match self with
  | .lit value => decide (value ≤ 4294967295)
  | .var index => false
  | .neg operand => true
  | .binary word operation left right => Word.narrows word
  | .compare word operation left right => true

/-- An operation on this word may pass e through unchanged: an S32 one zero-extends, so e must be narrow. -/
def Word.keeps (self : Word) (e : Expr) : Bool :=
  match self with
  | .s32 => Expr.narrow e
  | .u64 => true

def negateConstant (value : Option (BitVec 64)) : Option (BitVec 64) :=
  match value with
  | some v => some (lowBits (0 - v))
  | none => none

def absorbed (operation : BinOp) (value : BitVec 64) : Option (BitVec 64) :=
  if BinOp.annihilates operation && decide (value = 0) then
    some 0
  else
    none

def binaryConstant (word : Word) (operation : BinOp) (left : Option (BitVec 64)) (right : Option (BitVec 64)) : Option (BitVec 64) :=
  match left with
  | some a =>
    (match right with
     | some b => some (Word.compute word operation a b)
     | none => absorbed operation a)
  | none =>
    match right with
    | some b => absorbed operation b
    | none => none

def compareConstant (word : Word) (operation : CmpOp) (left : Option (BitVec 64)) (right : Option (BitVec 64)) : Option (BitVec 64) :=
  match left with
  | some a =>
    (match right with
     | some b => some (boolBits (Word.test word operation a b))
     | none => none)
  | none => none

def constantIs (value : Option (BitVec 64)) (literal : BitVec 64) : Bool :=
  match value with
  | some v => decide (v = literal)
  | none => false

/-- Some(v) when the expression is v in every environment. -/
def Expr.constant (self : Expr) : Option (BitVec 64) :=
  match self with
  | .lit value => some value
  | .var index => none
  | .neg operand => negateConstant (Expr.constant operand)
  | .binary word operation left right => binaryConstant word operation (Expr.constant left) (Expr.constant right)
  | .compare word operation left right => compareConstant word operation (Expr.constant left) (Expr.constant right)

/-- The expression is the literal value. -/
def Expr.isConstant (self : Expr) (value : Option (BitVec 64)) : Bool :=
  match self with
  | .lit literal => constantIs value literal
  | .var index => false
  | .neg operand => false
  | .binary word operation left right => false
  | .compare word operation left right => false

def Expr.isVar (self : Expr) (index : Nat) : Bool :=
  match self with
  | .lit value => false
  | .var other => decide (other = index)
  | .neg operand => false
  | .binary word operation left right => false
  | .compare word operation left right => false

def Expr.isZero (self : Expr) : Bool :=
  constantIs (Expr.constant self) 0

/-- The expression is a constant c with x op c = x. -/
def Expr.unitOf (self : Expr) (word : Word) (operation : BinOp) : Bool :=
  match Expr.constant self with
  | some c => Word.sameOperand word c (BinOp.unit operation)
  | none => false

/-- other has this expression's value in every environment: it is the constant, or it has the same shape with agreeing operands, or it is the operand kept by an identity like x + 0. -/
def Expr.agrees (self : Expr) (other : Expr) : Bool :=
  if Expr.isConstant other (Expr.constant self) then
    true
  else
    match self with
    | .lit value => false
    | .var index => Expr.isVar other index
    | .neg operand =>
      (match other with
       | .lit v => false
       | .var i => false
       | .neg o => Expr.agrees operand o
       | .binary w op l r => false
       | .compare w op l r => false)
    | .binary word operation left right =>
      (match other with
       | .lit v => false
       | .var i => false
       | .neg o => false
       | .binary w op l r => decide (Word.number word = Word.number w) && decide (BinOp.number operation = BinOp.number op) && Expr.agrees left l && Expr.agrees right r
       | .compare w op l r => false) || (Expr.unitOf right word operation && Word.keeps word other && Expr.agrees left other || BinOp.commutes operation && Expr.unitOf left word operation && Word.keeps word other && Expr.agrees right other)
    | .compare word operation left right =>
      match other with
      | .lit v => false
      | .var i => false
      | .neg o => false
      | .binary w op l r => false
      | .compare w op l r => decide (Word.number word = Word.number w) && decide (CmpOp.number operation = CmpOp.number op) && Expr.agrees left l && Expr.agrees right r

def argsAgree (args : List Expr) (others : List Expr) : Bool :=
  match args with
  | [] =>
    (match others with
     | [] => true
     | o :: more => false)
  | arg :: rest =>
    match others with
    | [] => false
    | o :: more => Expr.agrees arg o && argsAgree rest more

def assignAgrees (index : Nat) (value : Expr) (other : Stmt) : Bool :=
  match other with
  | .skip => Expr.agrees value (Expr.var index)
  | .assign i v => decide (index = i) && Expr.agrees value v
  | .seq f s => false
  | .ite c t e => false
  | .loop c b => false
  | .call t n f a => false
  | .ret v => false
  | .alloc t sh sz => false
  | .loadByte t a => false
  | .storeByte a v => false
  | .loadWord w t a => false
  | .storeWord w a v => false

def callAgrees (target : Nat) (count : Nat) (callee : Nat) (args : List Expr) (other : Stmt) : Bool :=
  match other with
  | .skip => false
  | .assign i v => false
  | .seq f s => false
  | .ite c t e => false
  | .loop c b => false
  | .call t n f a => decide (target = t) && decide (count = n) && decide (callee = f) && argsAgree args a
  | .ret v => false
  | .alloc t sh sz => false
  | .loadByte t a => false
  | .storeByte a v => false
  | .loadWord w t a => false
  | .storeWord w a v => false

def retAgrees (values : List Expr) (other : Stmt) : Bool :=
  match other with
  | .skip => false
  | .assign i v => false
  | .seq f s => false
  | .ite c t e => false
  | .loop c b => false
  | .call t n f a => false
  | .ret v => argsAgree values v
  | .alloc t sh sz => false
  | .loadByte t a => false
  | .storeByte a v => false
  | .loadWord w t a => false
  | .storeWord w a v => false

def allocAgrees (target : Nat) (shift : Nat) (size : Expr) (other : Stmt) : Bool :=
  match other with
  | .skip => false
  | .assign i v => false
  | .seq f s => false
  | .ite c t e => false
  | .loop c b => false
  | .call t n f a => false
  | .ret v => false
  | .alloc t sh sz => decide (target = t) && decide (shift = sh) && Expr.agrees size sz
  | .loadByte t a => false
  | .storeByte a v => false
  | .loadWord w t a => false
  | .storeWord w a v => false

def loadByteAgrees (target : Nat) (address : Expr) (other : Stmt) : Bool :=
  match other with
  | .skip => false
  | .assign i v => false
  | .seq f s => false
  | .ite c t e => false
  | .loop c b => false
  | .call t n f a => false
  | .ret v => false
  | .alloc t sh sz => false
  | .loadByte t a => decide (target = t) && Expr.agrees address a
  | .storeByte a v => false
  | .loadWord w t a => false
  | .storeWord w a v => false

def storeByteAgrees (address : Expr) (value : Expr) (other : Stmt) : Bool :=
  match other with
  | .skip => false
  | .assign i v => false
  | .seq f s => false
  | .ite c t e => false
  | .loop c b => false
  | .call t n f a => false
  | .ret v => false
  | .alloc t sh sz => false
  | .loadByte t a => false
  | .storeByte a v => Expr.agrees address a && Expr.agrees value v
  | .loadWord w t a => false
  | .storeWord w a v => false

def loadWordAgrees (width : MemWidth) (target : Nat) (address : Expr) (other : Stmt) : Bool :=
  match other with
  | .skip => false
  | .assign i v => false
  | .seq f s => false
  | .ite c t e => false
  | .loop c b => false
  | .call t n f a => false
  | .ret v => false
  | .alloc t sh sz => false
  | .loadByte t a => false
  | .storeByte a v => false
  | .loadWord w t a => decide (MemWidth.bytes width = MemWidth.bytes w) && decide (target = t) && Expr.agrees address a
  | .storeWord w a v => false

def storeWordAgrees (width : MemWidth) (address : Expr) (value : Expr) (other : Stmt) : Bool :=
  match other with
  | .skip => false
  | .assign i v => false
  | .seq f s => false
  | .ite c t e => false
  | .loop c b => false
  | .call t n f a => false
  | .ret v => false
  | .alloc t sh sz => false
  | .loadByte t a => false
  | .storeByte a v => false
  | .loadWord w t a => false
  | .storeWord w a v => decide (MemWidth.bytes width = MemWidth.bytes w) && Expr.agrees address a && Expr.agrees value v

def Stmt.isSkip (self : Stmt) : Bool :=
  match self with
  | .skip => true
  | .assign i v => false
  | .seq f s => false
  | .ite c t e => false
  | .loop c b => false
  | .call t n f a => false
  | .ret v => false
  | .alloc t sh sz => false
  | .loadByte t a => false
  | .storeByte a v => false
  | .loadWord w t a => false
  | .storeWord w a v => false

/-- other ends every run of this statement the same way: the same shape with agreeing expressions, or a statement dropped because it does nothing (skip, x = x, a loop whose condition is 0), or a branch chosen because its condition is a constant or both branches agree with other. -/
def Stmt.agrees (self : Stmt) (other : Stmt) : Bool :=
  match self with
  | .skip => Stmt.isSkip other
  | .assign index value => assignAgrees index value other
  | .seq first second =>
    Stmt.agrees first Stmt.skip && Stmt.agrees second other || Stmt.agrees second Stmt.skip && Stmt.agrees first other || (match other with
     | .skip => false
     | .assign i v => false
     | .seq f s => Stmt.agrees first f && Stmt.agrees second s
     | .ite c t e => false
     | .loop c b => false
     | .call t n f a => false
     | .ret v => false
     | .alloc t sh sz => false
     | .loadByte t a => false
     | .storeByte a v => false
     | .loadWord w t a => false
     | .storeWord w a v => false)
  | .ite condition thenBranch elseBranch =>
    Stmt.agrees thenBranch other && Stmt.agrees elseBranch other || (let known : Option (BitVec 64) := Expr.constant condition
     match known with
     | some v => decide (v = 0) && Stmt.agrees elseBranch other || decide (v ≠ 0) && Stmt.agrees thenBranch other
     | none => false) || (match other with
     | .skip => false
     | .assign i v => false
     | .seq f s => false
     | .ite c t e => Expr.agrees condition c && Stmt.agrees thenBranch t && Stmt.agrees elseBranch e
     | .loop c b => false
     | .call t n f a => false
     | .ret v => false
     | .alloc t sh sz => false
     | .loadByte t a => false
     | .storeByte a v => false
     | .loadWord w t a => false
     | .storeWord w a v => false)
  | .loop condition body =>
    Expr.isZero condition && Stmt.isSkip other || (match other with
     | .skip => false
     | .assign i v => false
     | .seq f s => false
     | .ite c t e => false
     | .loop c b => Expr.agrees condition c && Stmt.agrees body b
     | .call t n f a => false
     | .ret v => false
     | .alloc t sh sz => false
     | .loadByte t a => false
     | .storeByte a v => false
     | .loadWord w t a => false
     | .storeWord w a v => false)
  | .call target count callee args => callAgrees target count callee args other
  | .ret values => retAgrees values other
  | .alloc target shift size => allocAgrees target shift size other
  | .loadByte target address => loadByteAgrees target address other
  | .storeByte address value => storeByteAgrees address value other
  | .loadWord width target address => loadWordAgrees width target address other
  | .storeWord width address value => storeWordAgrees width address value other

def Func.agrees (self : Func) (other : Func) : Bool :=
  decide (self.params = other.params) && decide (self.results = other.results) && decide (self.locals = other.locals) && Stmt.agrees self.body other.body

def funcsAgree (funcs : List Func) (others : List Func) : Bool :=
  match funcs with
  | [] =>
    (match others with
     | [] => true
     | o :: more => false)
  | func :: rest =>
    match others with
    | [] => false
    | o :: more => Func.agrees func o && funcsAgree rest more

/-- The validator: optimized has the original's functions, in order, each agreeing with the original one. -/
def validate (original : Program) (optimized : Program) : Bool :=
  funcsAgree original.funcs optimized.funcs

def Expr.literal (self : Expr) : Option (BitVec 64) :=
  match self with
  | .lit value => some value
  | .var index => none
  | .neg operand => none
  | .binary word operation left right => none
  | .compare word operation left right => none

def optimizeNeg (operand : Expr) : Expr :=
  match Expr.literal operand with
  | some v => Expr.lit (lowBits (0 - v))
  | none => Expr.neg operand

/-- The left operand is the literal a. -/
def optimizeLeft (word : Word) (operation : BinOp) (a : BitVec 64) (left : Expr) (right : Expr) : Expr :=
  if BinOp.annihilates operation && decide (a = 0) then
    Expr.lit 0
  else
    if BinOp.commutes operation && Word.sameOperand word a (BinOp.unit operation) && Word.keeps word right then
      right
    else
      Expr.binary word operation left right

/-- The right operand is the literal b. -/
def optimizeRight (word : Word) (operation : BinOp) (left : Expr) (right : Expr) (b : BitVec 64) : Expr :=
  if BinOp.annihilates operation && decide (b = 0) then
    Expr.lit 0
  else
    if Word.sameOperand word b (BinOp.unit operation) && Word.keeps word left then
      left
    else
      Expr.binary word operation left right

def optimizeBinary (word : Word) (operation : BinOp) (left : Expr) (right : Expr) : Expr :=
  match Expr.literal left with
  | some a =>
    (match Expr.literal right with
     | some b => Expr.lit (Word.compute word operation a b)
     | none => optimizeLeft word operation a left right)
  | none =>
    match Expr.literal right with
    | some b => optimizeRight word operation left right b
    | none => Expr.binary word operation left right

def optimizeCompare (word : Word) (operation : CmpOp) (left : Expr) (right : Expr) : Expr :=
  match Expr.literal left with
  | some a =>
    (match Expr.literal right with
     | some b => Expr.lit (boolBits (Word.test word operation a b))
     | none => Expr.compare word operation left right)
  | none => Expr.compare word operation left right

def Expr.optimize (self : Expr) : Expr :=
  match self with
  | .lit value => Expr.lit value
  | .var index => Expr.var index
  | .neg operand => optimizeNeg (Expr.optimize operand)
  | .binary word operation left right => optimizeBinary word operation (Expr.optimize left) (Expr.optimize right)
  | .compare word operation left right => optimizeCompare word operation (Expr.optimize left) (Expr.optimize right)

def optimizeAll (values : List Expr) : List Expr :=
  match values with
  | [] => []
  | value :: rest => Expr.optimize value :: optimizeAll rest

def optimizeAssign (index : Nat) (value : Expr) : Stmt :=
  if Expr.isVar value index then
    Stmt.skip
  else
    Stmt.assign index value

def optimizeSeq (first : Stmt) (second : Stmt) : Stmt :=
  if Stmt.isSkip first then
    second
  else
    if Stmt.isSkip second then
      first
    else
      Stmt.seq first second

def pickBranch (value : BitVec 64) (thenBranch : Stmt) (elseBranch : Stmt) : Stmt :=
  if value = 0 then
    elseBranch
  else
    thenBranch

def iteOrSkip (condition : Expr) (thenBranch : Stmt) (elseBranch : Stmt) : Stmt :=
  if Stmt.isSkip thenBranch && Stmt.isSkip elseBranch then
    Stmt.skip
  else
    Stmt.ite condition thenBranch elseBranch

def optimizeIte (condition : Expr) (thenBranch : Stmt) (elseBranch : Stmt) : Stmt :=
  match Expr.literal condition with
  | some v => pickBranch v thenBranch elseBranch
  | none => iteOrSkip condition thenBranch elseBranch

def loopUnlessZero (value : BitVec 64) (condition : Expr) (body : Stmt) : Stmt :=
  if value = 0 then
    Stmt.skip
  else
    Stmt.loop condition body

def optimizeLoop (condition : Expr) (body : Stmt) : Stmt :=
  match Expr.literal condition with
  | some v => loopUnlessZero v condition body
  | none => Stmt.loop condition body

def Stmt.optimize (self : Stmt) : Stmt :=
  match self with
  | .skip => Stmt.skip
  | .assign index value => optimizeAssign index (Expr.optimize value)
  | .seq first second => optimizeSeq (Stmt.optimize first) (Stmt.optimize second)
  | .ite condition thenBranch elseBranch => optimizeIte (Expr.optimize condition) (Stmt.optimize thenBranch) (Stmt.optimize elseBranch)
  | .loop condition body => optimizeLoop (Expr.optimize condition) (Stmt.optimize body)
  | .call target count callee args => Stmt.call target count callee (optimizeAll args)
  | .ret values => Stmt.ret (optimizeAll values)
  | .alloc target shift size => Stmt.alloc target shift (Expr.optimize size)
  | .loadByte target address => Stmt.loadByte target (Expr.optimize address)
  | .storeByte address value => Stmt.storeByte (Expr.optimize address) (Expr.optimize value)
  | .loadWord width target address => Stmt.loadWord width target (Expr.optimize address)
  | .storeWord width address value => Stmt.storeWord width (Expr.optimize address) (Expr.optimize value)

def optimizeFuncs (funcs : List Func) : List Func :=
  match funcs with
  | [] => []
  | func :: rest => ({ params := func.params, results := func.results, locals := func.locals, body := Stmt.optimize func.body } : Func) :: optimizeFuncs rest

def optimizeProgram (prog : Program) : Program :=
  ({ funcs := optimizeFuncs prog.funcs } : Program)

def compileOr (binary : Option Binary) (prog : Program) : Option Binary :=
  match binary with
  | some b => some b
  | none => compileProgram prog

def compileOptimized (prog : Program) : Option Binary :=
  let optimized : Program := optimizeProgram prog
  if validate prog optimized then
    compileOr (compileProgram optimized) prog
  else
    compileProgram prog

def compileLowered (funcs : Option (List Func)) : Option Binary :=
  match funcs with
  | none => none
  | some fs => compileOptimized ({ funcs := fs } : Program)

/-- The functions are lowered against the declarations, which the slice lowering consults for its element types. -/
def compileDeclared (decls : Option SrcDecls) (prog : SrcProgram) : Option Binary :=
  match decls with
  | none => none
  | some d => compileLowered (lowerFuncs (sigs prog.funcs) d prog.funcs)

/-- Machine code of a source program. -/
def compileSource (prog : SrcProgram) : Option Binary :=
  if funcsReturn prog.funcs then
    compileDeclared (declareProgram prog) prog
  else
    none

end Lanius.Mini
