          ifOf (exprOf f env scope (kid s 2)) (blockOf f env scope (kid (kid s 4) 1)) (some SrcStmt.nop)
        else
          if p = (80) then
            whileOf (exprOf f env scope (kid s 2)) (blockOf f env scope (kid (kid s 4) 1))
          else
            if p = (85) then
