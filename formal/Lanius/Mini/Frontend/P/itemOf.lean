/-- `import p::name;` with p a module path and p::name no module: the item import of name from p. -/
def itemOf (d : Decls) (target : List (List Nat)) (name : List Nat) : Option (List (List Nat)) :=
  match splitLast target with
  | none => none
  | some s => ifItem (sameText s.name name && !(noNames s.home) && !(isModule d target)) s.home

/-- The module that module m imports the item name from (its first such import), if any. -/
def itemImport (d : Decls) (imports : List ImportDecl) (m : List (List Nat)) (name : List Nat) : Option (List (List Nat)) :=
  match imports with
  | [] => none
  | i :: rest =>
    if sameSpellings i.home m then
      match itemOf d i.target name with
      | none => itemImport d rest m name
      | some p => some p
    else
      itemImport d rest m name

/-- The module a path's front names, for the item name: the front itself, or for a bare name the module it is imported from, else the current module. -/
def pathModule (env : FrontEnv) (front : List (List Nat)) (name : List Nat) : List (List Nat) :=
  match front with
  | [] =>
    (match itemImport env.decls env.decls.imports env.home name with
     | none => env.home
     | some p => p)
  | n :: rest => front

/-- The variants spelled name in the modules that module m imports. -/
def importedVariants (types : List TypeDecl) (imports : List ImportDecl) (m : List (List Nat)) (name : List Nat) : List VariantAt :=
  match imports with
  | [] => []
  | i :: rest =>
    if sameSpellings i.home m then
      variantsNamed types i.target name 0 ++ importedVariants types rest m name
    else
      importedVariants types rest m name

def onlyVariant (vs : List VariantAt) : Option VariantAt :=
  match vs with
  | [] => none
  | v :: rest =>
    match rest with
    | [] => some v
    | w :: more => none

/-- A bare variant name: the one enum of the module it is imported from by name, else the one enum of the current module that has it, else the one enum of the imported modules that has it. -/
def bareVariant (env : FrontEnv) (name : List Nat) : Option VariantAt :=
  match itemImport env.decls env.decls.imports env.home name with
  | none =>
    (match variantsNamed env.decls.types env.home name 0 with
     | [] => onlyVariant (importedVariants env.decls.types env.decls.imports env.home name)
     | v :: rest => onlyVariant (v :: rest))
  | some p => onlyVariant (variantsNamed env.decls.types p name 0)

