/-- A literal that rounds to infinity is rejected, as laniusc rejects it (LNC0070): only a finite pattern is read (SEMANTIC_DECISIONS.md, "Float literals in the front end"). The marker's halves are float literals. -/
def floatFinite (x : SrcExpr) (inf : Nat) : Option SrcExpr :=
  match x with
  | .int k => none
  | .boolean b => none
  | .unsigned u k => none
  | .local id => none
  | .field id j => none
  | .negate y => none
  | .not y => none
  | .apply op l r => none
  | .cast s y => none
  | .null => none
  | .char code => none
  | .float g bits =>
    if bits = BitVec.ofNat 64 inf then
      none
    else
      some (SrcExpr.float g bits)

def floatPickOf (ft : FloatTy) (a : SrcExpr) (b : SrcExpr) : Option SrcExpr :=
  match ft with
  | .f32 => floatFinite a (flInf 8 23)
  | .f64 => floatFinite b (flInf 11 52)

/-- A float marker Cast(t, x)'s literal of type ft. -/
def floatPick (ft : FloatTy) (t : SrcType) (x : SrcExpr) : Option SrcExpr :=
  if unitTy t then
    match x with
    | .int k => none
    | .boolean b => none
    | .unsigned u k => none
    | .local id => none
    | .field id j => none
    | .negate y => none
    | .not y => none
    | .apply op a b => floatPickOf ft a b
    | .cast s y => none
    | .null => none
    | .char code => none
    | .float g bits => none
  else
    none

/-- A float marker Cast(t, x) at the expected type want if that is a float type, else as an f32 literal (Core's default, `literalDefaultType`). -/
