/-- Read instance i of the table, append the instances it calls that are new, and go on with i + 1 until the table is done. -/
def monoLoop (fuel : Nat) (rfuel : Nat) (decls : Decls) (table : List Inst) (done : List MFunc) (i : Nat) : Option Mono :=
  if fuel = 0 then
    none
  else
    match table[i]? with
    | none => some ({ table := table, funcs := done } : Mono)
    | some inst =>
      let nfuel : Nat := fuel - 1
      let nf : Option MFunc := readInst rfuel decls inst
      match nf with
      | none => none
      | some mf => monoLoop nfuel rfuel decls (addInsts table (stmtCalls mf.body)) (done ++ [mf]) (i + 1)

/-- The types a statement binds, in order (a match's result, then its scrutinee's). -/
def stmtTys (m : MStmt) : List Ty :=
  match m with
  | .mNop => []
  | .mLet id ty e body => ty :: stmtTys body
  | .mLetStruct id ty es body => ty :: stmtTys body
  | .mLetCall id ty inst args body => ty :: stmtTys body
  | .mLetEnum id ty k es body => ty :: stmtTys body
  | .mLetMatch id ty s sty arms body => ty :: sty :: stmtTys body
  | .mSet id e => []
  | .mSetField id j e => []
  | .mSetCall id inst args => []
  | .mThen a b => stmtTys a ++ stmtTys b
  | .mIf c a b => stmtTys a ++ stmtTys b
  | .mWhile c body => stmtTys body
  | .mReturn e => []
  | .mLetAlloc id size shift body => stmtTys body
  | .mFree p size shift => []
  | .mLetSlice id e p n body => e :: stmtTys body
  | .mLetIndex id ty s i body => ty :: stmtTys body
  | .mSetIndex s i v => []
  | .mLetEval id ty x body => ty :: (effNamedTys x ++ stmtTys body)
  | .mSetEval id x => effNamedTys x
  | .mIfEval c a b => effNamedTys c ++ (stmtTys a ++ stmtTys b)
  | .mWhileEval c body => effNamedTys c ++ stmtTys body
  | .mReturnEval x => effNamedTys x
  | .mDiscard x => effNamedTys x
  | .mSetIndexEval s i v => effNamedTys i ++ effNamedTys v
  | .mSetFieldEval id j x => effNamedTys x
  | .mReturnUnit => []
  | .mAssert x => effNamedTys x
  | .mBreak => []
  | .mContinue => []
  | .mMatchArm sc sty k bs x ty body rest => sty :: ty :: (stmtTys body ++ stmtTys rest)
  | .mUnreachable id ty => [ty]

def paramTys (ps : List MParam) : List Ty :=
  match ps with
  | [] => []
  | p :: rest => p.ty :: paramTys rest

def retTys (r : RetTy) : List Ty :=
  match r with
  | .retUnit => []
  | .retOf t => [t]

/-- A function's types: parameters, result, then its body's. -/
def funcsTys (fs : List MFunc) : List Ty :=
  match fs with
  | [] => []
  | f :: rest => paramTys f.params ++ (retTys f.ret ++ (stmtTys f.body ++ funcsTys rest))

def seedTys (seeds : List Inst) : List Ty :=
  match seeds with
  | [] => []
  | s :: rest => Ty.tyNamed s.decl s.args :: seedTys rest

/-- The type instances, from the seeds, in the order the types first need them. -/
def typeTable (fuel : Nat) (decls : Decls) (table : List Inst) (ts : List Ty) : Option (List Inst) :=
  match ts with
  | [] => some table
  | t :: rest =>
    let tnew : Option (List Inst) := tyInsts fuel decls t
    match tnew with
    | none => none
    | some xs => typeTable fuel decls (addInsts table xs) rest

/-- The table holds the instance of every named type in t. -/
def tyKnown (table : List Inst) (t : Ty) : Bool :=
  match t with
  | .tyI32 => true
  | .tyBool => true
  | .tyUint k => true
  | .tyPtr => true
  | .tyIsize => true
  | .tyChar => true
  | .tySlice e => tyKnown table e
  | .tyNamed d args => instMember table ({ decl := d, args := args } : Inst)
  | .tySint k => true

/-- type_table over more types, from a table that holds every instance the types of its members need (as type_table's result from the seeds does): a type whose instance the table holds adds nothing new, so it is passed over without reading its declaration again. The types are every type the functions mention, most of them many times over. -/
def typeTableMore (fuel : Nat) (decls : Decls) (table : Option (List Inst)) (ts : List Ty) : Option (List Inst) :=
  match table with
  | none => none
  | some x =>
    match ts with
    | [] => some x
    | t :: rest =>
      if tyKnown x t then
        typeTableMore fuel decls (some x) rest
      else
        typeTableMore fuel decls (typeTable fuel decls x [t]) rest

def loweredAll (fuel : Nat) (decls : Decls) (types : List Inst) (insts : List Inst) : List (Option SrcType) :=
  match insts with
  | [] => []
  | x :: rest => lowerNamed (fuel - 1) decls types x.decl x.args :: loweredAll fuel decls types rest

def closeNamed (fuel : Nat) (t : Tables) (d : Nat) (args : List Ty) (id : Option Nat) : Option SrcType :=
