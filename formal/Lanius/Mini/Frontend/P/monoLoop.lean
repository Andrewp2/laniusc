    none
  else
    match ty with
    | .tyI32 => some SrcType.i32
    | .tyBool => some SrcType.bool
    | .tyUint k => some (SrcType.uint k)
    | .tyPtr => some SrcType.ptr
    | .tyIsize => some SrcType.isize
    | .tyChar => some SrcType.char
