/-- The pattern nearest m * 10^e (e = -mag when neg, else mag), IEEE.lean's ofDecimal. -/
def flDecimal (ew : Nat) (f : Nat) (m : List Bool) (neg : Bool) (mag : Nat) : Nat :=
  match flLog2 m with
  | none => 0
  | some lm => flDecimalAt ew f m neg mag lm

def flDigit (b : Nat) : Bool :=
  decide (48 ≤ b) && decide (b ≤ 57)

def flPush (m : List Bool) (b : Nat) : List Bool :=
  flAdd (flMul10 m) (flOfNat (b - 48) 4) false

/-- m * 10^(±x - k), n digits in all (at least one). -/
def flFinish (m : List Bool) (n : Nat) (k : Nat) (neg : Bool) (x : Nat) : Option FlDec :=
  if n = 0 then
    none
  else
    if neg then
      some ({ m := m, neg := true, mag := x + k } : FlDec)
    else
      if k ≤ x then
        some ({ m := m, neg := false, mag := x - k } : FlDec)
      else
        some ({ m := m, neg := true, mag := k - x } : FlDec)

/-- The exponent's digits, x their value so far (at most 99999). -/
def flExpDigits (text : List Nat) (m : List Bool) (n : Nat) (k : Nat) (neg : Bool) (x : Nat) : Option FlDec :=
  if 99999 < x then
    none
  else
    match text with
    | [] => flFinish m n k neg x
    | b :: rest =>
      if flDigit b then
        flExpDigits rest m n k neg (x * 10 + (b - 48))
      else
        none

