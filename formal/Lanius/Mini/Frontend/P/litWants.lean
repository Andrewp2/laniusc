/-- Each arm's value is read at the expected type, when there is one. -/
def litWants (expected : Option Ty) (arms : List CTree) : Option (List Ty) :=
  match expected with
  | none => none
  | some t => some (tyPerArm t arms)

def eqOn (s : SrcExpr) (e : Option SrcExpr) : Option SrcExpr :=
  match e with
  | none => none
