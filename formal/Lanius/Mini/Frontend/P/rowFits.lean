/-- A row's payload patterns pr against the first row's pa, column j matched on. -/
def rowFits (env : FrontEnv) (pa : List CTree) (pr : List CTree) (i : Nat) (j : Nat) (last : Bool) : Bool :=
  match pa with
  | [] =>
    (match pr with
     | [] => true
     | y :: more => false)
  | x :: rest =>
    match pr with
    | [] => false
    | y :: more => colFits env x y (decide (i = j)) last && rowFits env rest more (i + 1) j last

