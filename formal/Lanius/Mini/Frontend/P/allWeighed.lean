def allWeighed (ws : List (Option Nat)) : Bool :=
  match ws with
  | [] => true
  | w :: rest => !(isNoneWeight w) && allWeighed rest

def tableWeighed (ts : List Inst) (fits : Bool) : Option (List Inst) :=
  if fits then
    some ts
  else
    none

/-- The type table when every instance in it is within the weight limit. -/
def typesWeighed (fuel : Nat) (decls : Decls) (types : Option (List Inst)) : Option (List Inst) :=
  match types with
  | none => none
  | some ts => tableWeighed ts (allWeighed (weighRounds ts.length fuel decls ts (unweighed ts)))

def closeNamed (fuel : Nat) (t : Tables) (d : Nat) (args : List Ty) (id : Option Nat) : Option SrcType :=
