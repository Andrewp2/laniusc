/-- Implementation limits on the program (decided 11-03, F14, as the image limit): every type anywhere in it has at most weight_limit() slots (SrcType::size), and a function's lets need at most depth_limit() slots along any scope (SrcStmt::depth). A program past either is rejected; no real program comes near them. So the compiler's slot numbers, offsets and frame sizes stay far below 2^64. -/
def depthLimit : Nat :=
  1099511627776

def depthSum (x : Nat) (y : Nat) : Option Nat :=
  if decide (depthLimit < x) || decide (depthLimit - x < y) then
    none
  else
    some (x + y)

