/-- At least t's slot count, when t and every type inside it are within weight_limit() (a type's weight, with a str's two slots and a view's length counted). -/
def limSlots (t : SrcType) : Option Nat :=
  match t with
  | .i32 => some 1
  | .bool => some 1
  | .uint k => some 1
  | .struct id fields => weightAddTo 1 (limSlotsList fields)
  | .enum id variants => weightAddTo 1 (limSlotsVariants variants)
  | .ptr => some 1
  | .slice element => weightAddTo 1 (limSlots element)
  | .array element length => weightArray length (limSlots element)
  | .unit => some 1
  | .isize => some 1
  | .char => some 1
  | .float ft => some 1
  | .sint sk => some 1
  | .view viewLength => weightSum 1 viewLength
  | .str => some 2
  | .ref referent => weightAddTo 1 (limSlots referent)
def limSlotsList (ts : List SrcType) : Option Nat :=
  match ts with
  | [] => some 0
  | t :: rest => weightAdd (limSlots t) (limSlotsList rest)
def limSlotsVariants (vs : List (List SrcType)) : Option Nat :=
  match vs with
  | [] => some 0
  | v :: rest => weightAdd (limSlotsList v) (limSlotsVariants rest)
end

def limTy (t : SrcType) : Bool :=
  !(isNoneWeight (limSlots t))

def limExpr (e : SrcExpr) : Bool :=
  match e with
  | .int k => true
  | .boolean b => true
  | .unsigned u k => true
  | .local id => true
  | .field id j => true
