namespace Lanius.Mini

/-- Comparisons and logical operators give bool; the others their operand's type (a pointer plus an offset is a pointer). -/
def givesBool (op : SrcOp) : Bool :=
  match op with
  | .plus => false
  | .minus => false
  | .times => false
  | .bitAnd => false
  | .bitOr => false
  | .bitXor => false
  | .shiftLeft => false
  | .shiftRight => false
  | .less => true
  | .lessEq => true
  | .greater => true
  | .greaterEq => true
  | .equal => true
  | .notEqual => true
  | .logicalAnd => true
  | .logicalOr => true

end Lanius.Mini
