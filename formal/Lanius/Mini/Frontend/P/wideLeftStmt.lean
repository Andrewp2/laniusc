def wideLeftStmt (s : SrcStmt) : Bool :=
  match s with
  | .nop => false
  | .let id ty e body => wideLeft e || wideLeftStmt body
  | .letStruct id ty es body => wideLeftExprs es || wideLeftStmt body
  | .letCall id ty f args body => wideLeftExprs args || wideLeftStmt body
