/-- The continuation bytes of a UTF-8 encoding: the next in lo..hi, then `more` more in 128..191, each adding its low six bits to code. -/
def charTail (text : List Nat) (more : Nat) (code : Nat) (lo : Nat) (hi : Nat) : Option SrcExpr :=
