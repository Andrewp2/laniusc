  | .xPure e => pureInferred e
  | .xCall inst args => true
  | .xApply op l r => false
  | .xNeg a => false
  | .xNot a => true
  | .xCast t a => true
  | .xIndex s i => true
  | .xStruct t fs => true
  | .xVariant t k ps => false
  | .xMatch s ety t bs vs => false
  | .xDivide op l r => false
  | .xStride sl => true
  | .xHost id args => true

