/-- `let x: ty = op?; body`: the success arm binds x to the payload. It is the last variant, so what follows it never runs, and is Unreachable (a statement every path of which returns). -/
def tryLet (ok : Bool) (id : Nat) (ty : Ty) (t : Tried) (body : MStmt) : Option MStmt :=
  if ok then
    some (tryRest t (MStmt.mMatchArm t.scrutinee t.sty 0 true id ty body (MStmt.mUnreachable t.binder t.ret)))
  else
    none

def tryStmt (t : Option Tried) : Option MStmt :=
