/-- `let x: ty = op?; body`: the success arm binds x to the payload. It is the last variant, so what follows it never runs, and is Unreachable (a statement every path of which returns). -/
def tryLet (ok : Bool) (id : Nat) (ty : Ty) (t : Tried) (body : MStmt) : Option MStmt :=
  if ok then
    some (tryRest t (MStmt.mMatchArm t.scrutinee t.sty 0 true id ty body (MStmt.mUnreachable t.binder t.ret)))
  else
    none

def tryStmt (t : Option Tried) : Option MStmt :=
  match t with
  | none => none
  | some x => some (tryRest x MStmt.mNop)

/-- An untyped let's value has a type of its own only when no literal decides it: a call (a host call too), a cast, an element, a struct, a `!`, a stride, or a local or field. -/
def pureInferred (e : SrcExpr) : Bool :=
  match e with
  | .int v => false
  | .boolean b => false
  | .unsigned u v => false
  | .local id => true
  | .field id j => true
  | .negate a => false
  | .not a => true
  | .apply op a b => false
  | .cast t a => true
  | .null => false
  | .char c => false
  | .float ft bits => false

def inferred (x : MEff) : Bool :=
