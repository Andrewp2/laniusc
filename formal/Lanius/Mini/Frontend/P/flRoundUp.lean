/-- Whether den * 2^(l - m) <= num * 2^(m - l) (the exponents' differences cut at zero): floorLog2Ratio's test that log2 num - log2 den is not one too many. -/
def flRatioOk (l : Nat) (m : Nat) (num : List Bool) (den : List Bool) : Bool :=
