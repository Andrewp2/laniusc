/-- The function instances a statement calls, in order. -/
def stmtCalls (m : MStmt) : List Inst :=
  match m with
  | .mNop => []
  | .mLet id ty e body => stmtCalls body
  | .mLetStruct id ty es body => stmtCalls body
  | .mLetCall id ty inst args body => inst :: stmtCalls body
  | .mLetEnum id ty k es body => stmtCalls body
  | .mLetMatch id ty s sty arms body => stmtCalls body
  | .mSet id e => []
  | .mSetField id j e => []
  | .mSetCall id inst args => [inst]
  | .mThen a b => stmtCalls a ++ stmtCalls b
  | .mIf c a b => stmtCalls a ++ stmtCalls b
  | .mWhile c body => stmtCalls body
  | .mReturn e => []
  | .mLetAlloc id size shift body => stmtCalls body
  | .mFree p size shift => []
  | .mLetSlice id e p n body => stmtCalls body
  | .mLetIndex id ty s i body => stmtCalls body
  | .mLetView id n es p body => stmtCalls body
  | .mLetStr id cs body => stmtCalls body
  | .mSetIndex s i v => []
  | .mLetEval id ty x body => effCalls x ++ stmtCalls body
  | .mSetEval id x => effCalls x
  | .mIfEval c a b => effCalls c ++ (stmtCalls a ++ stmtCalls b)
  | .mWhileEval c body => effCalls c ++ stmtCalls body
  | .mReturnEval x => effCalls x
  | .mDiscard x => effCalls x
  | .mSetIndexEval s i v => effCalls i ++ effCalls v
  | .mSetFieldEval id j x => effCalls x
  | .mReturnUnit => []
  | .mAssert x => effCalls x
  | .mBreak => []
  | .mContinue => []
  | .mMatchArm sc sty k bs x ty body rest => stmtCalls body ++ stmtCalls rest
  | .mUnreachable id ty => []
  | .mSetPlace pl v => effCalls pl ++ effCalls v
  | .mSetPlaceOp op pl v => effCalls pl ++ effCalls v

