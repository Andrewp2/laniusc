/-- For each variant in order, the one arm that names it, else the wildcard arm w as that variant's arm. -/
def armsOrWild (fuel : Nat) (owner : TypeDecl) (variants : List VariantTy) (arms : List CTree) (w : CTree) : Option (List CTree) :=
  match variants with
  | [] => some []
  | v :: rest =>
    match armsNaming fuel owner v.name arms with
    | [] => consTreeTail (wildArmFor w v) (armsOrWild fuel owner rest arms w)
    | a :: more =>
      match more with
      | [] => consTreeTail a (armsOrWild fuel owner rest arms w)
      | b :: others => none

