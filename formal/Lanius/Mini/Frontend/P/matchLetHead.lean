/-- What a let of type ty binds when its value reads as x: a pure value, a call with pure arguments, a literal or variant of type ty with pure fields, an element of a slice local at a pure index, a match of a local with pure arm values, or else the effectful expression. -/
def evalLetHead (ty : Ty) (x : MEff) : LetHead :=
  match x with
  | .xPure e => LetHead.plain e
  | .xCall inst args => callLetHead x (callParts x)
  | .xApply op l r => LetHead.evalOf x
  | .xNeg a => LetHead.evalOf x
  | .xNot a => LetHead.evalOf x
  | .xCast t a => LetHead.evalOf x
  | .xIndex sl i => indexLetHead x sl (purePart i)
  | .xStruct t vs => structHead (sameTy t ty) x (pureList vs)
  | .xVariant t index ps => variantLetHead (sameTy t ty) x index (pureList ps)
  | .xMatch sc ety rt binders values => matchLetHead x (effLocal sc) ety (pureArms binders values)
  | .xDivide op l r => LetHead.evalOf x
  | .xStride sl => LetHead.evalOf x
