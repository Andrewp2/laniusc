def joinInsts (a : Option (List Inst)) (b : Option (List Inst)) : Option (List Inst) :=
  match a with
  | none => none
  | some xs =>
    match b with
    | none => none
    | some ys => some (xs ++ ys)

def consInst (x : Inst) (rest : Option (List Inst)) : Option (List Inst) :=
