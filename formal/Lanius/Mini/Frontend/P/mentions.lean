/-- Whether a token of the trees is spelled name; None when fuel runs out. -/
def mentions (fuel : Nat) (todo : List CTree) (name : List Nat) : Option Bool :=
  if fuel = 0 then
    none
  else
    match todo with
    | [] => some false
    | t :: rest =>
      match t with
      | .leaf tok => orKnown (some (sameText tok.text name)) (mentions (fuel - 1) rest name)
      | .node q kids => mentions (fuel - 1) (kids ++ rest) name

end Lanius.Mini
