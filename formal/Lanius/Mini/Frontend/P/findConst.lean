def addInst (table : List Inst) (x : Inst) : List Inst :=
  if instMember table x then
    table
  else
    table ++ [x]

/-- The table with the new instances appended in order, each once. -/
def addInsts (table : List Inst) (new : List Inst) : List Inst :=
