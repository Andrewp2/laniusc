/-- Whether every token of the trees spelled name is an allowed use of a reference parameter (see refs_checked); None when fuel runs out. -/
def refUsesOk (fuel : Nat) (todo : List CTree) (name : List Nat) : Option Bool :=
  if fuel = 0 then
    none
  else
    match todo with
    | [] => some true
    | t :: rest =>
      match t with
      | .leaf tok => andKnown (some (!(sameText tok.text name))) (refUsesOk (fuel - 1) rest name)
      | .node q kids => refUsesOk (fuel - 1) (refKids fuel t name ++ rest) name

end Lanius.Mini
