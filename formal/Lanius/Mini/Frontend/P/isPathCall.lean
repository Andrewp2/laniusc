/-- The shift of an alignment 2^shift, counting up from 2^s = p. -/
def shiftOfU64 (fuel : Nat) (k : BitVec 64) (s : Nat) (p : Nat) : Option Nat :=
  if fuel = 0 then
    none
  else
    if BitVec.ofNat 64 p = k then
      some s
    else
      shiftOfU64 (fuel - 1) k (s + 1) (p * 2)

