def wildOrder (fuel : Nat) (owner : TypeDecl) (variants : List VariantTy) (s : WildSplit) : Option (List CTree) :=
  if allNameSome fuel owner variants s.init && usesWild fuel owner variants s.init then
    armsOrWild fuel owner variants s.init s.wild
