  | [] => none
  | fd :: rest =>
    if sameText fd.name name then
      match implBinds fuel decls fd s with
      | none => findMethod fuel decls rest (k + 1) name s
      | some b => uniqueFound (noMethod fuel decls rest name s) k b
    else
      findMethod fuel decls rest (k + 1) name s

