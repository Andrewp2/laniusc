/-- The postfix node an expression is, when no operator, cast or assignment applies on the way down. -/
def peel (fuel : Nat) (c : CTree) : Option CTree :=
  if fuel = 0 then
    none
  else
    let p : Nat := nodeProd c
    if decide (p = (104)) || decide (p = (159)) then
      peel (fuel - 1) (kid c 0)
    else
      if (decide (p = (105)) || isLevel p || decide (p = (307))) && !(hasKids (kid c 1)) then
        peel (fuel - 1) (kid c 0)
      else
        if p = (160) then
          some c
        else
          none

/-- Comparisons and logical operators give bool; the others their operand's type (a pointer plus an offset is a pointer). -/
def givesBool (op : SrcOp) : Bool :=
  match op with
  | .plus => false
  | .minus => false
  | .times => false
  | .bitAnd => false
  | .bitOr => false
  | .bitXor => false
  | .shiftLeft => false
  | .shiftRight => false
  | .less => true
  | .lessEq => true
  | .greater => true
  | .greaterEq => true
  | .equal => true
  | .notEqual => true
  | .logicalAnd => true
  | .logicalOr => true

def applyTy (op : SrcOp) (left : Option Ty) : Option Ty :=
  if givesBool op then
    some Ty.tyBool
  else
    left

def localTy (l : Option Local) : Option Ty :=
  match l with
  | none => none
  | some x => some x.ty

def structFieldTys (fuel : Nat) (decls : Decls) (t : Ty) : Option (List Ty) :=
  match t with
  | .tyI32 => none
  | .tyBool => none
  | .tyUint k => none
  | .tyPtr => none
  | .tyIsize => none
  | .tySlice e => none
  | .tyNamed d args => fieldTys fuel decls d args

def fieldTy (fuel : Nat) (decls : Decls) (l : Option Local) (j : Nat) : Option Ty :=
  match l with
  | none => none
  | some x =>
    match structFieldTys fuel decls x.ty with
    | none => none
    | some ts => ts[j]?

/-- An integer literal, or arithmetic of them: its type comes from its context (an isize literal is written bare beside a typed operand), so an operator's type is its other operand's. -/
def bareInt (e : SrcExpr) : Bool :=
  match e with
  | .int k => true
  | .boolean b => false
  | .unsigned u k => false
  | .local id => false
  | .field id j => false
  | .negate x => bareInt x
  | .not x => false
  | .apply op a b => !(givesBool op) && bareInt a && bareInt b
  | .cast t x => unitTy t
  | .null => false

def pickTy (leftBare : Bool) (a : Option Ty) (b : Option Ty) : Option Ty :=
  if leftBare then
    b
  else
    a

