/-- The list has more than n facts. -/
def longer (facts : List Fact) (n : Nat) : Bool :=
  if n = 0 then
    match facts with
    | [] => false
    | fact :: rest => true
  else
    match facts with
    | [] => false
    | fact :: rest => longer rest (n - 1)

/-- A list past 31 facts is cut to its 15 newest, so a list holds at most 32 facts and finding one or killing some walks at most 32, and the cut copies 15 facts once per 16 or more writes (an unbounded list made the self-built verified compiler allocate gigabytes of facts on its own long functions; roadmap F12). -/
def trimFacts (facts : List Fact) : List Fact :=
  if longer facts 31 then
    firstFacts facts 15
  else
    facts

/-- The facts after index = value. -/
def assigned (facts : List Fact) (index : Nat) (value : Expr) : List Fact :=
  let known : Expr := Expr.subst value facts
  let rest : List Fact := killShared facts index
  if Expr.isAtom known && !(Expr.mentions known index) then
    ({ slot := index, value := known } : Fact) :: trimFacts rest
  else
    rest

