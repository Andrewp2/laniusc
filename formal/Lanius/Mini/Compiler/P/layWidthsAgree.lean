/-- The native widths of a value's slots, in order (for uniform types). -/
def tyWidths (ty : SrcType) : List MemWidth :=
  match ty with
  | .i32 => [widthOf ty]
  | .bool => [widthOf ty]
  | .uint kind => [widthOf ty]
  | .struct id fields => layFieldsWidths fields
  | .enum id variants => MemWidth.m32 :: layVariantsWidths variants
  | .ptr => [widthOf ty]
  | .slice element => MemWidth.m64 :: MemWidth.m64 :: [MemWidth.m64]
  | .array arrayElement arrayLength => repeatWidths arrayLength (tyWidths arrayElement)
  | .unit => [widthOf ty]
  | .isize => [widthOf ty]
  | .char => [widthOf ty]
  | .float ft => [widthOf ty]
  | .sint sk => [widthOf ty]
  | .view viewLength => [widthOf ty]
  | .str => MemWidth.m64 :: [MemWidth.m64]
  | .ref referent => [MemWidth.m64]
def layFieldsWidths (fields : List SrcType) : List MemWidth :=
  match fields with
  | [] => []
  | t :: rest => tyWidths t ++ layFieldsWidths rest
/-- The widths of an enum's payload slots: each variant's where it has the slot. -/
def layVariantsWidths (variants : List (List SrcType)) : List MemWidth :=
