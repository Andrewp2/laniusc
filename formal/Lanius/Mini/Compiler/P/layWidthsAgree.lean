/-- Whether an enum's variants give each payload slot one width. -/
def layVariantsAgree (variants : List (List SrcType)) : Bool :=
  match variants with
  | [] => true
  | fields :: rest => layWidthsAgree (layFieldsWidths fields) (layVariantsWidths rest) && layVariantsAgree rest

def widthAt (ws : List MemWidth) (s : Nat) : MemWidth :=
  match ws[s]? with
  | none => MemWidth.m64
  | some w => w

def enumSlotAt (words : Nat) (variants : List (List SrcType)) (s : Nat) : SlotAt :=
  if s = 0 then
    ({ offset := 8 * (words - 1), access := MemAccess.aWord MemWidth.m32 } : SlotAt)
  else
    ({ offset := 8 * (words - 1 - s), access := MemAccess.aWord (widthAt (layVariantsWidths variants) (s - 1)) } : SlotAt)

