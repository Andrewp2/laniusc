/-- Whether two lists of widths agree where both have one. -/
def layWidthsAgree (a : List MemWidth) (b : List MemWidth) : Bool :=
  match a with
  | [] => true
  | x :: xs =>
    match b with
    | [] => true
    | y :: ys => decide (MemWidth.bytes x = MemWidth.bytes y) && layWidthsAgree xs ys

def repeatWidths (count : Nat) (ws : List MemWidth) : List MemWidth :=
  if count = 0 then
    []
  else
    ws ++ repeatWidths (count - 1) ws

