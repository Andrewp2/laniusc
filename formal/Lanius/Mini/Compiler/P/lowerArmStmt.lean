/-- If the tag at slot is the variant, copy the payload to next and run body; else run rest. Tags are 32-bit. -/
def lowerArmStmt (slot : Nat) (ok : Bool) (variant : Nat) (values : Option (List Expr)) (next : Nat) (body : Option Stmt) (rest : Option Stmt) : Option Stmt :=
