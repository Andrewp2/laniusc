/-- Where slot s of a value of ty lies in native layout (SrcType.slotAt). -/
def slotAt (ty : SrcType) (s : Nat) : SlotAt :=
  match ty with
  | .i32 => ({ offset := 0, access := MemAccess.aWord (widthOf ty) } : SlotAt)
  | .bool => ({ offset := 0, access := MemAccess.aWord (widthOf ty) } : SlotAt)
  | .uint kind => ({ offset := 0, access := MemAccess.aWord (widthOf ty) } : SlotAt)
  | .struct id fields => layFieldsSlotAt (max 1 (layFieldWords fields)) 0 fields s
  | .enum id variants => enumSlotAt (tyWords ty) variants s
  | .ptr => ({ offset := 0, access := MemAccess.aWord (widthOf ty) } : SlotAt)
  | .slice element => ({ offset := 8 * (2 - s), access := MemAccess.aWord MemWidth.m64 } : SlotAt)
  | .array arrayElement arrayLength => arraySlotAt arrayElement arrayLength s (slotAt arrayElement (remOrSelf s (SrcType.size arrayElement)))
  | .unit => ({ offset := 0, access := MemAccess.aWord (widthOf ty) } : SlotAt)
  | .isize => ({ offset := 0, access := MemAccess.aWord (widthOf ty) } : SlotAt)
  | .char => ({ offset := 0, access := MemAccess.aWord (widthOf ty) } : SlotAt)
  | .float ft => ({ offset := 0, access := MemAccess.aWord (widthOf ty) } : SlotAt)
  | .sint sk => ({ offset := 0, access := MemAccess.aWord (widthOf ty) } : SlotAt)
  | .view viewLength => ({ offset := 0, access := MemAccess.aWord (widthOf ty) } : SlotAt)
  | .str => ({ offset := 8 * (1 - s), access := MemAccess.aWord MemWidth.m64 } : SlotAt)
  | .ref referent => ({ offset := 0, access := MemAccess.aWord MemWidth.m64 } : SlotAt)
/-- Slot s of fields whose first one starts above words below the top of a total-word value. -/
def layFieldsSlotAt (total : Nat) (above : Nat) (fields : List SrcType) (s : Nat) : SlotAt :=
  match fields with
  | [] => ({ offset := 0, access := MemAccess.aWord MemWidth.m64 } : SlotAt)
  | t :: rest =>
    let fsiInner : SlotAt := slotAt t s
    if s < SrcType.size t then
      ({ offset := 8 * (total - above - tyWords t) + fsiInner.offset, access := fsiInner.access } : SlotAt)
    else
      layFieldsSlotAt total (above + tyWords t) rest (s - SrcType.size t)
end

