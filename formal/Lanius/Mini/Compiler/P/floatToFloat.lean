/-- f32 to f64 widens exactly, f64 to f32 rounds; Core has no cast of a float to its own type. -/
def floatToFloat (t : FloatTy) (source : FloatTy) (e : Expr) : Option Typed :=
  match source with
  | .f32 =>
    (match t with
     | .f32 => none
     | .f64 => some ({ expr := Expr.fp FOp.widen (Expr.lit 0) e, ty := SrcType.float t } : Typed))
  | .f64 =>
    match t with
    | .f32 => some ({ expr := Expr.fp FOp.narrow (Expr.lit 0) e, ty := SrcType.float t } : Typed)
    | .f64 => none

end Lanius.Mini
