/-- Images are small enough for every rel32 displacement. -/
def imageLimit : Nat :=
  1073741824

/-- The size of functions laid out back to back: the image's length, found without a walk over the image. -/
def linkedSize (codes : List Code) : Nat :=
  match codes with
  | [] => 0
  | code :: rest => Code.size code + linkedSize rest

def compileProgram (prog : Program) : Option Binary :=
  match compileFuncs (arities prog.funcs) prog.funcs with
  | none => none
