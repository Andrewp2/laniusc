/-- One round of needs: each function's block and the largest need, by prev, of a function it calls. -/
def needRound (funcs : List SrcFunc) (prev : List Nat) : List Nat :=
  match funcs with
  | [] => []
  | f :: rest => (frameBlock f + SrcStmt.calleeNeed f.body prev) :: needRound rest prev

def sameNeeds (a : List Nat) (b : List Nat) : Bool :=
  match a with
  | [] =>
    (match b with
     | [] => true
     | y :: ys => false)
  | x :: xs =>
    match b with
    | [] => false
    | y :: ys => decide (x = y) && sameNeeds xs ys

