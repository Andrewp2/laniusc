/-- array[index] = value on an array local. -/
def storeArray (b : Binding) (slot : Nat) (index : Option Evaluated) (value : Option Evaluated) : Option Stmt :=
  match b.ty with
  | .i32 => none
  | .bool => none
  | .uint kind => none
  | .struct id fields => none
  | .enum id variants => none
  | .ptr => none
  | .slice element => none
  | .array arrayElement arrayLength => storeArrayElement b.slot arrayElement arrayLength slot index value
  | .unit => none
  | .isize => none
  | .char => none
  | .float ft => none
  | .sint sk => none

