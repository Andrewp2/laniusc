/-- Whether the expression reads a homed local. -/
def readsHome (scope : List Binding) (e : SrcExpr) : Bool :=
  match e with
  | .int value => false
  | .boolean value => false
  | .unsigned kind value => false
  | .local id => isHomed (lookup scope id)
  | .field id index => isHomed (lookup scope id)
  | .negate operand => readsHome scope operand
  | .not operand => readsHome scope operand
  | .apply op left right => readsHome scope left || readsHome scope right
  | .cast ty operand => readsHome scope operand
  | .null => false
  | .char code => false
  | .float ft bits => false
end

def readsHomes (scope : List Binding) (es : List SrcExpr) : Bool :=
  match es with
  | [] => false
  | e :: rest => readsHome scope e || readsHomes scope rest

