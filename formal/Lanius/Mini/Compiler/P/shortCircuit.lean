/-- 1 for &&, 2 for ||, 0 for the operators that evaluate both sides. -/
def shortCircuit (op : SrcOp) : Nat :=
  match op with
  | .plus => 0
  | .minus => 0
  | .times => 0
  | .bitAnd => 0
  | .bitOr => 0
  | .bitXor => 0
  | .shiftLeft => 0
  | .shiftRight => 0
  | .less => 0
  | .lessEq => 0
  | .greater => 0
  | .greaterEq => 0
  | .equal => 0
  | .notEqual => 0
  | .logicalAnd => 1
  | .logicalOr => 2

end Lanius.Mini
