  else
    if SrcType.isBool l.ty && SrcType.isBool r.ty && decide (shortCircuit op = 1) then
      some ({ stmt := Stmt.seq l.stmt (Stmt.ite (Expr.var slot) (evalRight slot r) Stmt.skip), ty := SrcType.bool } : Evaluated)
    else
