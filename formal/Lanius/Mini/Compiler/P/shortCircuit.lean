  | .minus => Expr.lit 1
  | .times => Expr.lit 1
  | .bitAnd => Expr.lit 1
  | .bitOr => Expr.lit 1
  | .bitXor => Expr.lit 1
  | .shiftLeft => amountGuard (shiftWidth ty) (Expr.var slot)
  | .shiftRight => amountGuard (shiftWidth ty) (Expr.var slot)
  | .less => Expr.lit 1
  | .lessEq => Expr.lit 1
  | .greater => Expr.lit 1
  | .greaterEq => Expr.lit 1
  | .equal => Expr.lit 1
  | .notEqual => Expr.lit 1
