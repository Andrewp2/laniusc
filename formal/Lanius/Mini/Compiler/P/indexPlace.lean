/-- Element index of the array place: its code, the index into t + 1, the check index < length (else the trap), then the element's address. -/
def indexPlace (t : Nat) (base : Option PlaceCode) (index : Option Expr) : Option PlaceCode :=
  match base with
  | none => none
  | some c =>
    match index with
    | none => none
    | some i =>
      match c.ty with
      | .i32 => none
      | .bool => none
      | .uint kind => none
      | .struct id fields => none
      | .enum id variants => none
      | .ptr => none
      | .slice element => none
      | .array arrayElement arrayLength =>
        (let epCode : Stmt := c.stmt
         if arrayLength < 2147483648 then
           some ({ stmt := Stmt.seq epCode (Stmt.seq (Stmt.assign (t + 1) i) (Stmt.ite (Expr.compare Word.u64 CmpOp.lt (Expr.var (t + 1)) (Expr.lit (BitVec.ofNat 64 arrayLength))) (layElementAddr t (t + 1) arrayLength arrayElement) (layRefTrap t))), ty := arrayElement } : PlaceCode)
         else
           none)
      | .unit => none
      | .isize => none
      | .char => none
      | .float ft => none
      | .sint sk => none
      | .view viewLength => none
      | .str => none
      | .ref referent => none

