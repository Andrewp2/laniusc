namespace Lanius.Mini

/-- Whether the local id is an array. -/
def isArrayLocal (binding : Option Binding) : Bool :=
  match binding with
  | none => false
  | some b =>
    match b.ty with
    | .i32 => false
    | .bool => false
    | .uint kind => false
    | .struct id fields => false
    | .enum id variants => false
    | .ptr => false
    | .slice element => false
    | .array arrayElement arrayLength => true
    | .unit => false
    | .isize => false
    | .char => false
    | .float ft => false
    | .sint sk => false
    | .view viewLength => false
    | .str => false
    | .ref referent => false

end Lanius.Mini
