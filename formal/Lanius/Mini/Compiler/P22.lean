def evalPure (scope : List Binding) (e : SrcExpr) (slot : Nat) : Option Evaluated :=
  match SrcExpr.lower e scope with
  | some t => some (evalScalar slot t)
  | none =>
    match e with
    | .int value => none
    | .boolean value => none
    | .unsigned kind value => none
