    let k : Nat := exIndexOf shapes.names ctor 0
    let known : Bool := decide (path.length = 1) && decide (k < shapes.names.length)
    let shapeOk : Bool := known && !(exHasText acc.seen ctor) && decide (binders.length = shapes.counts.getD k 0)
    let inner : List XBind := exBindBinders binders (shapes.payloads.getD k []) env
    let arm : XTm := exArmTerm (fuel - 1) cx body inner inBlock ret acc.ty
    let fits : Bool := inBlock || exIsNone acc.ty || exTySame (exUnboxed arm.ty) (exUnboxed acc.ty)
    let text : List Nat := exArmText arm last
    let line : List Nat := exArmLine (exPattern shapes.kind ctor (exBinderLnames binders)) text
    let errs : List (List Nat) := exBadErrs (!(shapeOk && fits)) txErrMatch
    ({ lines := acc.lines ++ [line], ty := exArmResult inBlock acc.ty arm.ty, seen := acc.seen ++ [ctor], errs := acc.errs ++ (arm.errs ++ errs) } : XArms)
termination_by fuel
def exArmTerm (fuel : Nat) (cx : XCx) (body : XE) (inner : List XBind) (inBlock : Bool) (ret : List XTy) (result : XTy) : XTm :=
  if fuel = 0 then
    exFail txErrFuel
  else
    if inBlock then
      exBlock (fuel - 1) cx (exArmStmts body) inner ret
    else
      if exIsBlock body then
        exFail txErrMatch
      else
        exInfer (fuel - 1) cx body inner result
termination_by fuel
/-- The term of a block of statements that returns (extract.py's block). -/
def exBlock (fuel : Nat) (cx : XCx) (stmts : List XE) (env : List XBind) (ret : List XTy) : XTm :=
  if fuel = 0 then
    exFail txErrFuel
  else
    match stmts with
    | [] => exFail txErrReturn
    | s :: rest => exStmt (fuel - 1) cx s rest env ret
termination_by fuel
def exStmt (fuel : Nat) (cx : XCx) (s : XE) (rest : List XE) (env : List XBind) (ret : List XTy) : XTm :=
  if fuel = 0 then
    exFail txErrFuel
  else
    let more : Bool := decide (rest.length ≠ 0)
    match s with
    | .eInt n => exFail txErrStmt
    | .eBool b => exFail txErrStmt
    | .eName path => exFail txErrStmt
    | .eCall path args => exFail txErrStmt
    | .eMethod recv name args => exFail txErrStmt
    | .eField recv name => exFail txErrStmt
    | .eStruct name names values => exFail txErrStmt
    | .eBinary op l r => exFail txErrStmt
    | .eNot x => exFail txErrStmt
    | .eCast x t => exFail txErrStmt
    | .eMatch x arms => exFail txErrStmt
    | .eArm path binders body => exFail txErrStmt
    | .sBlock stmts => exFail txErrStmt
    | .sLet name t v => exLet (fuel - 1) cx name t v rest env ret
    | .sAssign place v => exAssign (fuel - 1) cx place v rest env ret
    | .sCall x => exFail txErrMut
    | .sMatch x => exErrIf more txErrUnreachable (exMatchStmt (fuel - 1) cx x env ret)
    | .sReturn v => exErrIf more txErrUnreachable (exReturn (fuel - 1) cx v env ret)
    | .sIf c a b has => exErrIf (has && more) txErrUnreachable (exIf (fuel - 1) cx c a (exElse has b rest) env ret)
    | .eBad why => exFail why
termination_by fuel
def exLet (fuel : Nat) (cx : XCx) (name : List Nat) (ty : XTy) (value : XE) (rest : List XE) (env : List XBind) (ret : List XTy) : XTm :=
  if fuel = 0 then
    exFail txErrFuel
  else
    let lname : List Nat := exCamel name
    let v : XTm := exExpr (fuel - 1) cx value env ty
    let body : XTm := exBlock (fuel - 1) cx rest (({ name := name, lname := lname, ty := ty } : XBind) :: env) ret
    let text : List Nat := exFlat (txLeanLet :: lname :: txColon :: exLeanType 64 ty :: txLeanAssign :: exParen v 1 :: [10] :: [body.text])
    ({ text := text, prec := 0, ty := exNone, errs := exCamelErrs name ++ (v.errs ++ body.errs) } : XTm)
termination_by fuel
def exAssign (fuel : Nat) (cx : XCx) (place : XE) (value : XE) (rest : List XE) (env : List XBind) (ret : List XTy) : XTm :=
  if fuel = 0 then
    exFail txErrFuel
  else
    let p : XPlace := exPlace place []
    let target : Option XBind := exFindBind env (p.name.getD 0 [])
    let body : XTm := exBlock (fuel - 1) cx rest env ret
    match target with
    | none => exWithErrs body.errs (exFail txErrAssign)
    | some b => exAssigned b.lname (exAssignChain (fuel - 1) cx b.lname b.ty p.fields value env) body (decide (p.name.length ≠ 1))
termination_by fuel
/-- The new value of base after `base.fields = value`. -/
def exAssignChain (fuel : Nat) (cx : XCx) (base : List Nat) (ty : XTy) (fields : List (List Nat)) (value : XE) (env : List XBind) : XTm :=
  if fuel = 0 then
    exFail txErrFuel
  else
    match fields with
    | [] => exExpr (fuel - 1) cx value env ty
    | name :: rest => exAssignField (fuel - 1) base name (exFieldTy cx (exUnboxed ty) name) cx rest value env
termination_by fuel
def exAssignField (fuel : Nat) (base : List Nat) (name : List Nat) (fty : Option XTy) (cx : XCx) (rest : List (List Nat)) (value : XE) (env : List XBind) : XTm :=
  if fuel = 0 then
    exFail txErrFuel
  else
    match fty with
    | none => exFail txErrField
    | some t => exFieldUpdate base name (exAssignChain (fuel - 1) cx (exDot base (exCamel name)) t rest value env)
termination_by fuel
def exMatchStmt (fuel : Nat) (cx : XCx) (e : XE) (env : List XBind) (ret : List XTy) : XTm :=
  if fuel = 0 then
    exFail txErrFuel
  else
    match e with
    | .eInt n => exFail txErrStmt
    | .eBool b => exFail txErrStmt
    | .eName path => exFail txErrStmt
    | .eCall path args => exFail txErrStmt
    | .eMethod recv name args => exFail txErrStmt
    | .eField recv name => exFail txErrStmt
    | .eStruct name names values => exFail txErrStmt
    | .eBinary op l r => exFail txErrStmt
    | .eNot x => exFail txErrStmt
    | .eCast x t => exFail txErrStmt
    | .eMatch x arms => exMatch (fuel - 1) cx x arms env exNone true ret
    | .eArm path binders body => exFail txErrStmt
    | .sBlock stmts => exFail txErrStmt
    | .sLet name t v => exFail txErrStmt
    | .sAssign place v => exFail txErrStmt
    | .sCall x => exFail txErrStmt
    | .sMatch x => exFail txErrStmt
    | .sReturn v => exFail txErrStmt
    | .sIf c a b has => exFail txErrStmt
    | .eBad why => exFail why
termination_by fuel
def exReturn (fuel : Nat) (cx : XCx) (values : List XE) (env : List XBind) (ret : List XTy) : XTm :=
  if fuel = 0 then
    exFail txErrFuel
  else
    if decide (values.length ≠ ret.length) || decide (values.length ≠ 1) then
      exFail txErrUnit
    else
      let value : XE := values.getD 0 (XE.eBad txErrUnit)
      if exIsReturnMatch value then
        exMatchStmt (fuel - 1) cx value env ret
      else
        exExpr (fuel - 1) cx value env (ret.getD 0 exNone)
termination_by fuel
def exIf (fuel : Nat) (cx : XCx) (cond : XE) (yes : List XE) (no : List XE) (env : List XBind) (ret : List XTy) : XTm :=
  if fuel = 0 then
    exFail txErrFuel
  else
    let c : XTm := exCondition (fuel - 1) cx cond env
    let a : XTm := exBlock (fuel - 1) cx yes env ret
    let b : XTm := exBlock (fuel - 1) cx no env ret
    let pad : List Nat := 32 :: [32]
    let text : List Nat := exFlat (txLeanIf :: c.text :: txLeanThen :: exIndent a.text pad :: txLeanElse :: [exIndent b.text pad])
    ({ text := text, prec := 0, ty := exNone, errs := c.errs ++ (a.errs ++ b.errs) } : XTm)
termination_by fuel
/-- An if condition: a comparison stays a proposition, another bool is tested. -/
def exCondition (fuel : Nat) (cx : XCx) (cond : XE) (env : List XBind) : XTm :=
  if fuel = 0 then
    exFail txErrFuel
  else
    match cond with
    | .eInt n => exExpr (fuel - 1) cx cond env (exTy txBool)
    | .eBool b => exExpr (fuel - 1) cx cond env (exTy txBool)
    | .eName path => exExpr (fuel - 1) cx cond env (exTy txBool)
    | .eCall path args => exExpr (fuel - 1) cx cond env (exTy txBool)
    | .eMethod recv name args => exExpr (fuel - 1) cx cond env (exTy txBool)
    | .eField recv name => exExpr (fuel - 1) cx cond env (exTy txBool)
    | .eStruct name names values => exExpr (fuel - 1) cx cond env (exTy txBool)
    | .eBinary op l r => exConditionBinary (fuel - 1) cx cond op l r env
    | .eNot x => exExpr (fuel - 1) cx cond env (exTy txBool)
    | .eCast x t => exExpr (fuel - 1) cx cond env (exTy txBool)
    | .eMatch x arms => exExpr (fuel - 1) cx cond env (exTy txBool)
    | .eArm path binders body => exExpr (fuel - 1) cx cond env (exTy txBool)
    | .sBlock stmts => exExpr (fuel - 1) cx cond env (exTy txBool)
    | .sLet name t v => exExpr (fuel - 1) cx cond env (exTy txBool)
    | .sAssign place v => exExpr (fuel - 1) cx cond env (exTy txBool)
    | .sCall x => exExpr (fuel - 1) cx cond env (exTy txBool)
    | .sMatch x => exExpr (fuel - 1) cx cond env (exTy txBool)
    | .sReturn v => exExpr (fuel - 1) cx cond env (exTy txBool)
    | .sIf c a b has => exExpr (fuel - 1) cx cond env (exTy txBool)
    | .eBad why => exFail why
termination_by fuel
def exConditionBinary (fuel : Nat) (cx : XCx) (cond : XE) (op : List Nat) (l : XE) (r : XE) (env : List XBind) : XTm :=
  if fuel = 0 then
    exFail txErrFuel
  else
    if exIsComparison op then
      exComparison (fuel - 1) cx op l r env
    else
      exExpr (fuel - 1) cx cond env (exTy txBool)
termination_by fuel
end

end Lanius.Mini
