import Lanius.Cert.Src
import Lanius.Mini.Process

/-! # The certificate checker through the verified compiler

`prog` (`Lanius.Cert.Src`, generated by `formal/cert/mini_build.py --lean`) is
the verified front end's program of `formal/cert/check_mini.lani`, and
`formal/cert/mini_build.py` builds its executable with runAll's `elf` line:
`elfFile binary 0 (2 ^ 20) (2 ^ 29)` of `compileSource prog`. This is
`process_exits` for that program: when Core runs `main()` on standard input
`given.input` to `v`, the executable, loaded with that input, exits with the
last of `v`'s slots (`main`'s `i32` result) and writes what Core wrote. What
the checker's run means for the certificate is the open statement
`Lanius.Open.CertNatSound` (`formal/Lanius/Open/Cert/`).

`compileSource prog = some binary` and `elfFile … = some file` stay
hypotheses: the kernel does not run the compiler (as for `vecClientSrc`);
runAll computes both, and the gate step `cert` checks that `prog` is the
front end's program of check_mini.lani. -/

namespace Lanius.Cert

open Lanius.Mini Lanius.X86.Machine
open Lanius.Core (Value)

/-- `main` is function 0, the executable's entry, and takes no parameters. -/
theorem prog_main : prog.funcs[0]? = some src0 := rfl

theorem src0_params : src0.params = [] := rfl

theorem checkMini_process {binary : Binary} {file : List UInt8}
    (compiled : compileSource prog = some binary) (h : elfFile binary 0 (2 ^ 20) (2 ^ 29) = some file)
    {given : Io} (silent : given.trace = []) {fuel : Nat} {v : Value} {final : Semantics.State}
    (runs : Semantics.evalExpr fuel prog.toCore (startState given) (.call 0 []) = .done v final)
    (fits : final.heap.nextAddress ≤ 2 ^ 29) (frameRoom : prog.need 0 ≤ 2 ^ 20) :
    ∃ depth results, ∃ after : Heap, src0.ret.HoldsAt (elfStatics binary (2 ^ 20)) [] v (Func.entry results) 0 ∧
      results.length = src0.ret.size ∧
      final.world.standardOutput = outputOf 1 after.io.trace ∧ final.world.standardError = outputOf 2 after.io.trace ∧
      ∀ s, Loaded file s → s.io = given →
        (∃ n e, Steps n s e ∧ Det n s e ∧ e.io = after.io ∧
          ∃ code, Exits e code ∧ ∀ w, results.getLast? = some w → code = w) ∨
        (2 ^ 20 - 8 < binary.stackNeed depth ∧ Faults s) :=
  process_exits compiled h prog_main src0_params silent runs fits frameRoom

end Lanius.Cert
