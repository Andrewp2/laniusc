// Allocation-free operations on caller-backed pairs of u32 words. Each
// WideI64 element is stored low word first, high word second. Logical lengths
// count elements, not words, and must not exceed the physical backing divided
// by two. Native indexing exits 101 if a caller overclaims physical storage.
module core::slice_wide_i64;
import core::wide_i64;

pub const MAX_LENGTH: i32 = 1073741823;

fn valid_len(length: i32) -> bool {
    return length >= 0 && length <= MAX_LENGTH;
}

fn load_at(values: [u32], index: i32) -> core::wide_i64::WideI64 {
    let offset: i32 = index * 2;
    return core::wide_i64::from_words(values[offset + 1], values[offset]);
}

fn store_at(values: [u32], index: i32, item: core::wide_i64::WideI64) {
    let offset: i32 = index * 2;
    values[offset] = core::wide_i64::low_word(item);
    values[offset + 1] = core::wide_i64::high_word(item);
}

fn swap_at(values: [u32], left: i32, right: i32) {
    let saved: core::wide_i64::WideI64 = load_at(values, left);
    store_at(values, left, load_at(values, right));
    store_at(values, right, saved);
}

fn reverse_segment(values: [u32], start: i32, end: i32) {
    let left: i32 = start;
    let right: i32 = end - 1;
    while (left < right) {
        swap_at(values, left, right);
        left += 1;
        right -= 1;
    }
}

// Native indexing exits 101 unless at least two backing words exist.
pub fn first(values: [u32]) -> core::wide_i64::WideI64 {
    return load_at(values, 0);
}

// Invalid logical bounds return fallback without touching storage.
pub fn first_or(values: [u32], length: i32,
                fallback: core::wide_i64::WideI64) -> core::wide_i64::WideI64 {
    return get_or(values, length, 0, fallback);
}

pub fn get_or(values: [u32], length: i32, index: i32,
              fallback: core::wide_i64::WideI64) -> core::wide_i64::WideI64 {
    if (!valid_len(length) || index < 0 || index >= length) { return fallback; }
    return load_at(values, index);
}

// Invalid logical bounds write nothing and return false.
pub fn set(values: [u32], length: i32, index: i32,
           item: core::wide_i64::WideI64) -> bool {
    if (!valid_len(length) || index < 0 || index >= length) { return false; }
    store_at(values, index, item);
    return true;
}

pub fn swap(values: [u32], length: i32, left: i32, right: i32) -> bool {
    if (!valid_len(length) || left < 0 || right < 0 ||
        left >= length || right >= length) { return false; }
    swap_at(values, left, right);
    return true;
}

// Return the number of elements written. Invalid lengths write nothing.
pub fn fill(values: [u32], length: i32, item: core::wide_i64::WideI64) -> i32 {
    if (!valid_len(length)) { return 0; }
    let index: i32 = 0;
    while (index < length) {
        store_at(values, index, item);
        index += 1;
    }
    return length;
}

// Copy [start,end) to destination within one view, including overlap.
pub fn copy_within(values: [u32], length: i32, start: i32, end: i32,
                   destination: i32) -> bool {
    if (!valid_len(length) || start < 0 || end < start || end > length ||
        destination < 0) { return false; }
    let count: i32 = end - start;
    if (destination > length - count) { return false; }
    if (destination > start) {
        let remaining: i32 = count;
        while (remaining > 0) {
            remaining -= 1;
            store_at(values, destination + remaining, load_at(values, start + remaining));
        }
    } else {
        let offset: i32 = 0;
        while (offset < count) {
            store_at(values, destination + offset, load_at(values, start + offset));
            offset += 1;
        }
    }
    return true;
}

pub fn index_of_or(values: [u32], length: i32,
                   needle: core::wide_i64::WideI64, fallback: i32) -> i32 {
    if (!valid_len(length)) { return fallback; }
    let index: i32 = 0;
    while (index < length) {
        if (core::wide_i64::eq(load_at(values, index), needle)) { return index; }
        index += 1;
    }
    return fallback;
}

pub fn last_index_of_or(values: [u32], length: i32,
                        needle: core::wide_i64::WideI64, fallback: i32) -> i32 {
    if (!valid_len(length)) { return fallback; }
    let index: i32 = length;
    while (index > 0) {
        index -= 1;
        if (core::wide_i64::eq(load_at(values, index), needle)) { return index; }
    }
    return fallback;
}

pub fn equals(left: [u32], left_len: i32, right: [u32], right_len: i32) -> bool {
    if (!valid_len(left_len) || !valid_len(right_len) || left_len != right_len) {
        return false;
    }
    let index: i32 = 0;
    while (index < left_len) {
        if (!core::wide_i64::eq(load_at(left, index), load_at(right, index))) { return false; }
        index += 1;
    }
    return true;
}

pub fn starts_with(values: [u32], length: i32, prefix: [u32], prefix_len: i32) -> bool {
    if (!valid_len(length) || !valid_len(prefix_len) || prefix_len > length) {
        return false;
    }
    let index: i32 = 0;
    while (index < prefix_len) {
        if (!core::wide_i64::eq(load_at(values, index), load_at(prefix, index))) { return false; }
        index += 1;
    }
    return true;
}

pub fn ends_with(values: [u32], length: i32, suffix: [u32], suffix_len: i32) -> bool {
    if (!valid_len(length) || !valid_len(suffix_len) || suffix_len > length) {
        return false;
    }
    let index: i32 = 0;
    let offset: i32 = length - suffix_len;
    while (index < suffix_len) {
        if (!core::wide_i64::eq(load_at(values, offset + index), load_at(suffix, index))) {
            return false;
        }
        index += 1;
    }
    return true;
}

// Return the number of swaps. Invalid lengths write nothing.
pub fn reverse_in_place(values: [u32], length: i32) -> i32 {
    if (!valid_len(length) || length <= 1) { return 0; }
    reverse_segment(values, 0, length);
    return length / 2;
}

pub fn rotate_left(values: [u32], length: i32, amount: i32) -> bool {
    if (!valid_len(length) || amount < 0 || amount > length) { return false; }
    if (amount == 0 || amount == length) { return true; }
    reverse_segment(values, 0, amount);
    reverse_segment(values, amount, length);
    reverse_segment(values, 0, length);
    return true;
}

pub fn rotate_right(values: [u32], length: i32, amount: i32) -> bool {
    if (!valid_len(length) || amount < 0 || amount > length) { return false; }
    return rotate_left(values, length, length - amount);
}

// Source and destination must not overlap in memory. Invalid logical lengths
// write nothing and return false.
pub fn copy_nonoverlapping_prefix(destination: [u32], destination_len: i32,
                                  source: [u32], source_len: i32) -> bool {
    if (!valid_len(destination_len) || !valid_len(source_len) ||
        source_len > destination_len) { return false; }
    let index: i32 = 0;
    while (index < source_len) {
        store_at(destination, index, load_at(source, index));
        index += 1;
    }
    return true;
}

// Return the new logical length. The tail is unspecified.
pub fn dedup_adjacent(values: [u32], length: i32) -> i32 {
    if (!valid_len(length) || length == 0) { return 0; }
    let write: i32 = 1;
    let read: i32 = 1;
    while (read < length) {
        let current: core::wide_i64::WideI64 = load_at(values, read);
        if (!core::wide_i64::eq(current, load_at(values, write - 1))) {
            store_at(values, write, current);
            write += 1;
        }
        read += 1;
    }
    return write;
}

pub fn retain_not_equal(values: [u32], length: i32,
                        needle: core::wide_i64::WideI64) -> i32 {
    if (!valid_len(length)) { return 0; }
    let read: i32 = 0;
    let write: i32 = 0;
    while (read < length) {
        let current: core::wide_i64::WideI64 = load_at(values, read);
        if (!core::wide_i64::eq(current, needle)) {
            store_at(values, write, current);
            write += 1;
        }
        read += 1;
    }
    return write;
}

// The old final element is outside the new logical length after removal.
pub fn remove_at(values: [u32], length: i32, index: i32) -> bool {
    if (!valid_len(length) || index < 0 || index >= length) { return false; }
    let read: i32 = index + 1;
    while (read < length) {
        store_at(values, read - 1, load_at(values, read));
        read += 1;
    }
    return true;
}

// Capacity also counts elements, not backing words. The caller supplies at
// least twice capacity words. Failed logical bounds leave storage unchanged.
pub fn insert(values: [u32], length: i32, capacity: i32, index: i32,
              item: core::wide_i64::WideI64) -> bool {
    if (!valid_len(length) || !valid_len(capacity) || length >= capacity ||
        index < 0 || index > length) { return false; }
    let cursor: i32 = length;
    while (cursor > index) {
        store_at(values, cursor, load_at(values, cursor - 1));
        cursor -= 1;
    }
    store_at(values, index, item);
    return true;
}

pub fn push(values: [u32], length: i32, capacity: i32,
            item: core::wide_i64::WideI64) -> bool {
    return insert(values, length, capacity, length, item);
}

// Return -1, 0, or 1. Invalid lengths return -2.
pub fn compare_lexicographic(left: [u32], left_len: i32,
                             right: [u32], right_len: i32) -> i32 {
    if (!valid_len(left_len) || !valid_len(right_len)) { return -2; }
    let common: i32 = left_len;
    if (right_len < common) { common = right_len; }
    let index: i32 = 0;
    while (index < common) {
        let comparison: i32 = core::wide_i64::compare(load_at(left, index), load_at(right, index));
        if (comparison != 0) { return comparison; }
        index += 1;
    }
    if (left_len < right_len) { return -1; }
    if (left_len > right_len) { return 1; }
    return 0;
}

// An empty needle matches at zero. Invalid lengths return -1.
pub fn index_of_subslice(values: [u32], length: i32,
                         needle: [u32], needle_len: i32) -> i32 {
    if (!valid_len(length) || !valid_len(needle_len) || needle_len > length) { return -1; }
    let last_start: i32 = length - needle_len;
    let start: i32 = 0;
    while (start <= last_start) {
        let offset: i32 = 0;
        while (offset < needle_len) {
            if (!core::wide_i64::eq(load_at(values, start + offset),
                                    load_at(needle, offset))) { break; }
            offset += 1;
        }
        if (offset == needle_len) { return start; }
        start += 1;
    }
    return -1;
}

// The last match of an empty needle is at length.
pub fn last_index_of_subslice(values: [u32], length: i32,
                              needle: [u32], needle_len: i32) -> i32 {
    if (!valid_len(length) || !valid_len(needle_len) || needle_len > length) { return -1; }
    let start: i32 = length - needle_len;
    while (start >= 0) {
        let offset: i32 = 0;
        while (offset < needle_len) {
            if (!core::wide_i64::eq(load_at(values, start + offset),
                                    load_at(needle, offset))) { break; }
            offset += 1;
        }
        if (offset == needle_len) { return start; }
        start -= 1;
    }
    return -1;
}

pub fn contains(values: [u32], length: i32,
                needle: core::wide_i64::WideI64) -> bool {
    return index_of_or(values, length, needle, -1) != -1;
}

pub fn count(values: [u32], length: i32,
             needle: core::wide_i64::WideI64) -> i32 {
    if (!valid_len(length)) { return 0; }
    let total: i32 = 0;
    let index: i32 = 0;
    while (index < length) {
        if (core::wide_i64::eq(load_at(values, index), needle)) { total += 1; }
        index += 1;
    }
    return total;
}

pub fn min_or(values: [u32], length: i32,
              fallback: core::wide_i64::WideI64) -> core::wide_i64::WideI64 {
    if (!valid_len(length) || length == 0) { return fallback; }
    let result: core::wide_i64::WideI64 = load_at(values, 0);
    let index: i32 = 1;
    while (index < length) {
        let current: core::wide_i64::WideI64 = load_at(values, index);
        if (core::wide_i64::compare(current, result) < 0) { result = current; }
        index += 1;
    }
    return result;
}

pub fn max_or(values: [u32], length: i32,
              fallback: core::wide_i64::WideI64) -> core::wide_i64::WideI64 {
    if (!valid_len(length) || length == 0) { return fallback; }
    let result: core::wide_i64::WideI64 = load_at(values, 0);
    let index: i32 = 1;
    while (index < length) {
        let current: core::wide_i64::WideI64 = load_at(values, index);
        if (core::wide_i64::compare(current, result) > 0) { result = current; }
        index += 1;
    }
    return result;
}

pub fn is_sorted(values: [u32], length: i32) -> bool {
    if (!valid_len(length)) { return false; }
    let index: i32 = 1;
    while (index < length) {
        if (core::wide_i64::compare(load_at(values, index - 1), load_at(values, index)) > 0) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn sift_down_max(values: [u32], heap_len: i32, start: i32) {
    if (heap_len > 1) {
        let root: i32 = start;
        while (root <= (heap_len - 2) / 2) {
            let child: i32 = root * 2 + 1;
            let largest: i32 = root;
            if (core::wide_i64::compare(load_at(values, largest), load_at(values, child)) < 0) {
                largest = child;
            }
            if (child + 1 < heap_len &&
                core::wide_i64::compare(load_at(values, largest), load_at(values, child + 1)) < 0) {
                largest = child + 1;
            }
            if (largest == root) { break; }
            swap_at(values, root, largest);
            root = largest;
        }
    }
}

// In-place ascending heapsort. Return the sorted length, or zero for invalid
// logical lengths. Duplicate values are retained.
pub fn sort(values: [u32], length: i32) -> i32 {
    if (!valid_len(length) || length == 0) { return 0; }
    if (length == 1) { return 1; }
    let start: i32 = (length - 2) / 2;
    while (start >= 0) {
        sift_down_max(values, length, start);
        if (start == 0) { break; }
        start -= 1;
    }
    let remaining: i32 = length;
    while (remaining > 1) {
        remaining -= 1;
        swap_at(values, 0, remaining);
        sift_down_max(values, remaining, 0);
    }
    return length;
}

// Binary search requires nondecreasing input. Invalid lengths act as empty.
pub fn lower_bound(values: [u32], length: i32,
                   needle: core::wide_i64::WideI64) -> i32 {
    if (!valid_len(length)) { return 0; }
    let low: i32 = 0;
    let high: i32 = length;
    while (low < high) {
        let middle: i32 = low + (high - low) / 2;
        if (core::wide_i64::compare(load_at(values, middle), needle) < 0) {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    return low;
}

pub fn upper_bound(values: [u32], length: i32,
                   needle: core::wide_i64::WideI64) -> i32 {
    if (!valid_len(length)) { return 0; }
    let low: i32 = 0;
    let high: i32 = length;
    while (low < high) {
        let middle: i32 = low + (high - low) / 2;
        if (core::wide_i64::compare(load_at(values, middle), needle) <= 0) {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    return low;
}

pub fn binary_search_first_or(values: [u32], length: i32,
                              needle: core::wide_i64::WideI64, fallback: i32) -> i32 {
    if (!valid_len(length)) { return fallback; }
    let index: i32 = lower_bound(values, length, needle);
    if (index < length && core::wide_i64::eq(load_at(values, index), needle)) { return index; }
    return fallback;
}

pub fn binary_search_last_or(values: [u32], length: i32,
                             needle: core::wide_i64::WideI64, fallback: i32) -> i32 {
    if (!valid_len(length)) { return fallback; }
    let after: i32 = upper_bound(values, length, needle);
    if (after > 0 && core::wide_i64::eq(load_at(values, after - 1), needle)) {
        return after - 1;
    }
    return fallback;
}

// Partition below pivot without preserving relative order.
pub fn partition_lt(values: [u32], length: i32,
                    pivot: core::wide_i64::WideI64) -> i32 {
    if (!valid_len(length)) { return 0; }
    let boundary: i32 = 0;
    let index: i32 = 0;
    while (index < length) {
        if (core::wide_i64::compare(load_at(values, index), pivot) < 0) {
            swap_at(values, boundary, index);
            boundary += 1;
        }
        index += 1;
    }
    return boundary;
}

// Add in order with two's-complement wraparound; invalid lengths return zero.
pub fn sum(values: [u32], length: i32) -> core::wide_i64::WideI64 {
    let total: core::wide_i64::WideI64 = core::wide_i64::zero();
    if (!valid_len(length)) { return total; }
    let index: i32 = 0;
    while (index < length) {
        total = core::wide_i64::wrapping_add(total, load_at(values, index));
        index += 1;
    }
    return total;
}
