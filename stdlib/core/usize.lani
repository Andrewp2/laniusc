// Pointer-width usize arithmetic for the verified x86_64 Linux target only.
// This target has 64-bit pointers and native integer values. Each typed boundary
// preserves the canonical core::u64 operation and checked failure behavior.
// These are numeric values, not allocation lengths or pointer validity checks.
module core::usize;
import core::u64;
import core::option;
pub const MIN: usize = 0;
pub const MAX: usize = 18446744073709551615;
pub const BITS: u32 = 64;
pub const BYTES: u32 = 8;
pub fn min(left: usize, right: usize) -> usize { return core::u64::min(left as u64,right as u64) as usize; }
pub fn max(left: usize, right: usize) -> usize { return core::u64::max(left as u64,right as u64) as usize; }
pub fn checked_clamp(value: usize, low: usize, high: usize) -> core::option::Option<usize> { let result: core::option::Option<u64> = core::u64::checked_clamp(value as u64,low as u64,high as u64); if (core::option::is_none(result)) { return core::option::None(); } return core::option::Some(core::option::unwrap(result) as usize); }
pub fn clamp(value: usize, low: usize, high: usize) -> usize { return core::u64::clamp(value as u64,low as u64,high as u64) as usize; }
pub fn clamp_or(value: usize, low: usize, high: usize, fallback: usize) -> usize { return core::u64::clamp_or(value as u64,low as u64,high as u64,fallback as u64) as usize; }
pub fn is_zero(value: usize) -> bool { return core::u64::is_zero(value as u64); }
pub fn is_nonzero(value: usize) -> bool { return core::u64::is_nonzero(value as u64); }
pub fn is_even(value: usize) -> bool { return core::u64::is_even(value as u64); }
pub fn is_odd(value: usize) -> bool { return core::u64::is_odd(value as u64); }
pub fn between_inclusive(value: usize, low: usize, high: usize) -> bool { return core::u64::between_inclusive(value as u64,low as u64,high as u64); }
pub fn between_exclusive(value: usize, low: usize, high: usize) -> bool { return core::u64::between_exclusive(value as u64,low as u64,high as u64); }
pub fn is_multiple_of(value: usize, divisor: usize) -> bool { return core::u64::is_multiple_of(value as u64,divisor as u64); }
pub fn wrapping_add(left: usize, right: usize) -> usize { return core::u64::wrapping_add(left as u64,right as u64) as usize; }
pub fn wrapping_sub(left: usize, right: usize) -> usize { return core::u64::wrapping_sub(left as u64,right as u64) as usize; }
pub fn wrapping_mul(left: usize, right: usize) -> usize { return core::u64::wrapping_mul(left as u64,right as u64) as usize; }
pub fn checked_add(left: usize, right: usize) -> core::option::Option<usize> { let result: core::option::Option<u64> = core::u64::checked_add(left as u64,right as u64); if (core::option::is_none(result)) { return core::option::None(); } return core::option::Some(core::option::unwrap(result) as usize); }
pub fn saturating_add(left: usize, right: usize) -> usize { return core::u64::saturating_add(left as u64,right as u64) as usize; }
pub fn checked_sub(left: usize, right: usize) -> core::option::Option<usize> { let result: core::option::Option<u64> = core::u64::checked_sub(left as u64,right as u64); if (core::option::is_none(result)) { return core::option::None(); } return core::option::Some(core::option::unwrap(result) as usize); }
pub fn saturating_sub(left: usize, right: usize) -> usize { return core::u64::saturating_sub(left as u64,right as u64) as usize; }
pub fn checked_mul(left: usize, right: usize) -> core::option::Option<usize> { let result: core::option::Option<u64> = core::u64::checked_mul(left as u64,right as u64); if (core::option::is_none(result)) { return core::option::None(); } return core::option::Some(core::option::unwrap(result) as usize); }
pub fn saturating_mul(left: usize, right: usize) -> usize { return core::u64::saturating_mul(left as u64,right as u64) as usize; }
pub fn checked_neg(value: usize) -> core::option::Option<usize> { let result: core::option::Option<u64> = core::u64::checked_neg(value as u64); if (core::option::is_none(result)) { return core::option::None(); } return core::option::Some(core::option::unwrap(result) as usize); }
pub fn wrapping_neg(value: usize) -> usize { return core::u64::wrapping_neg(value as u64) as usize; }
pub fn abs_diff(left: usize, right: usize) -> usize { return core::u64::abs_diff(left as u64,right as u64) as usize; }
pub fn checked_div(left: usize, right: usize) -> core::option::Option<usize> { let result: core::option::Option<u64> = core::u64::checked_div(left as u64,right as u64); if (core::option::is_none(result)) { return core::option::None(); } return core::option::Some(core::option::unwrap(result) as usize); }
pub fn div(left: usize, right: usize) -> usize { return core::u64::div(left as u64,right as u64) as usize; }
pub fn wrapping_div(left: usize, right: usize) -> usize { return core::u64::wrapping_div(left as u64,right as u64) as usize; }
pub fn checked_rem(left: usize, right: usize) -> core::option::Option<usize> { let result: core::option::Option<u64> = core::u64::checked_rem(left as u64,right as u64); if (core::option::is_none(result)) { return core::option::None(); } return core::option::Some(core::option::unwrap(result) as usize); }
pub fn rem(left: usize, right: usize) -> usize { return core::u64::rem(left as u64,right as u64) as usize; }
pub fn wrapping_rem(left: usize, right: usize) -> usize { return core::u64::wrapping_rem(left as u64,right as u64) as usize; }
pub fn saturating_div(left: usize, right: usize) -> usize { return core::u64::saturating_div(left as u64,right as u64) as usize; }
