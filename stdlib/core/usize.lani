pub fn checked_div_euclid(left: usize, right: usize) -> core::option::Option<usize> { let result: core::option::Option<u64> = core::u64::checked_div_euclid(left as u64,right as u64); if (core::option::is_none(result)) { return core::option::None(); } return core::option::Some(core::option::unwrap(result) as usize); }
pub fn rem_euclid(left: usize, right: usize) -> usize { return core::u64::rem_euclid(left as u64,right as u64) as usize; }
pub fn checked_rem_euclid(left: usize, right: usize) -> core::option::Option<usize> { let result: core::option::Option<u64> = core::u64::checked_rem_euclid(left as u64,right as u64); if (core::option::is_none(result)) { return core::option::None(); } return core::option::Some(core::option::unwrap(result) as usize); }
pub fn checked_shl(value: usize, amount: u32) -> core::option::Option<usize> { let result: core::option::Option<u64> = core::u64::checked_shl(value as u64,amount); if (core::option::is_none(result)) { return core::option::None(); } return core::option::Some(core::option::unwrap(result) as usize); }
pub fn wrapping_shl(value: usize, amount: u32) -> usize { return core::u64::wrapping_shl(value as u64,amount) as usize; }
pub fn shl(value: usize, amount: u32) -> usize { return core::u64::shl(value as u64,amount) as usize; }
pub fn checked_shr(value: usize, amount: u32) -> core::option::Option<usize> { let result: core::option::Option<u64> = core::u64::checked_shr(value as u64,amount); if (core::option::is_none(result)) { return core::option::None(); } return core::option::Some(core::option::unwrap(result) as usize); }
pub fn wrapping_shr(value: usize, amount: u32) -> usize { return core::u64::wrapping_shr(value as u64,amount) as usize; }
pub fn shr(value: usize, amount: u32) -> usize { return core::u64::shr(value as u64,amount) as usize; }
pub fn checked_pow(base: usize, exponent: u32) -> core::option::Option<usize> { let result: core::option::Option<u64> = core::u64::checked_pow(base as u64,exponent); if (core::option::is_none(result)) { return core::option::None(); } return core::option::Some(core::option::unwrap(result) as usize); }
pub fn wrapping_pow(base: usize, exponent: u32) -> usize { return core::u64::wrapping_pow(base as u64,exponent) as usize; }
pub fn saturating_pow(base: usize, exponent: u32) -> usize { return core::u64::saturating_pow(base as u64,exponent) as usize; }
pub fn count_ones(value: usize) -> u32 { return core::u64::count_ones(value as u64); }
pub fn count_zeros(value: usize) -> u32 { return core::u64::count_zeros(value as u64); }
pub fn leading_zeros(value: usize) -> u32 { return core::u64::leading_zeros(value as u64); }
pub fn trailing_zeros(value: usize) -> u32 { return core::u64::trailing_zeros(value as u64); }
pub fn leading_ones(value: usize) -> u32 { return core::u64::leading_ones(value as u64); }
pub fn trailing_ones(value: usize) -> u32 { return core::u64::trailing_ones(value as u64); }
pub fn rotate_left(value: usize, amount: u32) -> usize { return core::u64::rotate_left(value as u64,amount) as usize; }
pub fn rotate_right(value: usize, amount: u32) -> usize { return core::u64::rotate_right(value as u64,amount) as usize; }
pub fn reverse_bits(value: usize) -> usize { return core::u64::reverse_bits(value as u64) as usize; }
pub fn swap_bytes(value: usize) -> usize { return core::u64::swap_bytes(value as u64) as usize; }
pub fn is_power_of_two(value: usize) -> bool { return core::u64::is_power_of_two(value as u64); }
pub fn checked_next_power_of_two(value: usize) -> core::option::Option<usize> { let result: core::option::Option<u64> = core::u64::checked_next_power_of_two(value as u64); if (core::option::is_none(result)) { return core::option::None(); } return core::option::Some(core::option::unwrap(result) as usize); }
pub fn next_power_of_two(value: usize) -> usize { return core::u64::next_power_of_two(value as u64) as usize; }

// Integer conversions: checked means numeric range, wrapping keeps low bits.
pub fn from_u8(value: u8) -> usize { return value as usize; }
pub fn from_u16(value: u16) -> usize { return value as usize; }
pub fn from_u32(value: u32) -> usize { return value as usize; }
pub fn checked_from_i8(value: i8) -> core::option::Option<usize> { if (value < 0) { return core::option::None(); } return core::option::Some(value as usize); }
pub fn saturating_from_i8(value: i8) -> usize { if (value < 0) { return MIN; } return value as usize; }
pub fn wrapping_from_i8(value: i8) -> usize { return value as usize; }
pub fn checked_from_u8(value: u8) -> core::option::Option<usize> { return core::option::Some(value as usize); }
pub fn saturating_from_u8(value: u8) -> usize { return value as usize; }
pub fn wrapping_from_u8(value: u8) -> usize { return value as usize; }
