// Exact binary32/binary64 decimal conversion with bounded caller scratch.
// Shortest significant decimal inside the exact nearest-even rounding interval.
// No heap allocation or host float parser/formatter. See stdlib-float-decimal.md.
module core::float_decimal;
import core::f32;
import core::f64;
import core::float_tables;
import core::result;
import core::slice;

// Six 128-limb integers and 96 base-10^9 groups. Units are u32 elements.
// The 768-digit input ceiling bounds every intermediate below 4096 bits.
pub const SCRATCH_LEN: i32 = 864;
pub enum Error { Bounds, ScratchTooSmall(i32), InputLimit, DigitLimit, WorkLimit, Invalid(i32), Capacity(i32) }
pub struct Limits { max_input: i32, max_digits: i32, max_work: u64 }
pub fn scratch_len() -> i32 { return SCRATCH_LEN; }
pub fn default_format_work() -> u64 { return 1000000; }
pub fn default_limits() -> Limits { return Limits { max_input: 1024, max_digits: 768, max_work: 1000000 }; }
fn valid(view: core::slice::View<u8>) -> bool { return view.start >= 0 && view.length >= 0 && view.start <= 2147483647-view.length; }
fn storage(scratch: core::slice::View<u32>) -> core::result::Result<i32,Error> {
    if (scratch.start < 0 || scratch.length < 0 || scratch.start > 2147483647-scratch.length) { return core::result::Err(Error::Bounds); }
    if (scratch.length < SCRATCH_LEN) { return core::result::Err(Error::ScratchTooSmall(SCRATCH_LEN)); } return core::result::Ok(0);
}
struct Budget { left: u64, failed: bool }
impl Budget {
    fn borrow(&self) -> &Budget { return self; }
    fn pay(&self, amount: u64) { if (amount > self.left) { self.failed = true; self.left = 0; } else { self.left -= amount; } }
}
struct Big { words: core::slice::View<u32>, length: i32 }
fn big(scratch: core::slice::View<u32>, slot: i32) -> Big { return Big { words: core::result::unwrap(scratch.subview(slot*128,(slot+1)*128)), length: 0 }; }
impl Big {
    fn borrow(&self) -> &Big { return self; }
    fn get(&self, index: i32) -> u32 { return self.words.values[self.words.start+index]; }
    fn put(&self, index: i32, value: u32) { self.words.values[self.words.start+index] = value; }
    fn trim(&self) { while (self.length > 0 && self.get(self.length-1) == 0) { self.length -= 1; } }
    fn set(&self, value: u64, budget: &Budget) {
        budget.pay(2); self.length = 0;
        if (value != 0) { self.put(0,(value & 4294967295) as u32); self.length = 1; let high: u32 = (value >> 32) as u32; if (high != 0) { self.put(1,high); self.length = 2; } }
    }
    fn copy(&self, source: Big, budget: &Budget) { budget.pay(source.length as u64); let i: i32 = 0; while (i < source.length) { self.put(i,source.get(i)); i += 1; } self.length = source.length; }
    fn compare(&self, other: Big, budget: &Budget) -> i32 {
        budget.pay(1); if (self.length < other.length) { return -1; } if (self.length > other.length) { return 1; }
        let i: i32 = self.length; while (i > 0) { i -= 1; budget.pay(1); if (self.get(i) < other.get(i)) { return -1; } if (self.get(i) > other.get(i)) { return 1; } } return 0;
    }
    fn bits(&self, budget: &Budget) -> i32 {
        budget.pay(32); if (self.length == 0) { return 0; } let value: u32 = self.get(self.length-1); let count: i32 = 0;
        while (value > 0) { count += 1; value = value >> 1; } return (self.length-1)*32+count;
    }
    fn multiply_small(&self, factor: u32, budget: &Budget) {
        budget.pay((self.length as u64)+1); let carry: u64 = 0; let i: i32 = 0;
        while (i < self.length) { let value: u64 = (self.get(i) as u64)*(factor as u64)+carry; self.put(i,(value & 4294967295) as u32); carry = value >> 32; i += 1; }
        if (carry != 0) { assert(self.length < 128); self.put(self.length,carry as u32); self.length += 1; } self.trim();
    }
    fn add_small(&self, value: u32, budget: &Budget) {
        let carry: u64 = value as u64; let i: i32 = 0;
        while (carry != 0) { budget.pay(1); if (i == self.length) { assert(i < 128); self.put(i,0); self.length += 1; } let sum: u64 = (self.get(i) as u64)+carry; self.put(i,(sum & 4294967295) as u32); carry = sum >> 32; i += 1; }
    }
    fn add(&self, other: Big, budget: &Budget) {
        let count: i32 = self.length; if (other.length > count) { count = other.length; } budget.pay((count as u64)+1);
        let carry: u64 = 0; let i: i32 = 0;
        while (i < count) { let left: u64 = 0; let right: u64 = 0; if (i < self.length) { left = self.get(i) as u64; } if (i < other.length) { right = other.get(i) as u64; } let sum: u64 = left+right+carry; self.put(i,(sum & 4294967295) as u32); carry = sum >> 32; i += 1; }
        self.length = count; if (carry != 0) { assert(count < 128); self.put(count,carry as u32); self.length += 1; }
    }
    fn subtract(&self, other: Big, budget: &Budget) {
        budget.pay(self.length as u64); let borrow: u64 = 0; let i: i32 = 0;
        while (i < self.length) { let right: u64 = borrow; if (i < other.length) { right += other.get(i) as u64; } let left: u64 = self.get(i) as u64; borrow = 0; if (left < right) { self.put(i,((4294967296+left)-right) as u32); borrow = 1; } else { self.put(i,(left-right) as u32); } i += 1; } assert(borrow == 0); self.trim();
    }
    fn shift(&self, count: i32, budget: &Budget) {
        assert(count >= 0); if (self.length == 0 || count == 0) { return; }
        let words: i32 = count/32; let bits: i32 = count%32; let old: i32 = self.length; assert(old+words+1 <= 128); budget.pay((old+words+1) as u64);
        let i: i32 = old; while (i > 0) { i -= 1; self.put(i+words,self.get(i)); } i = 0; while (i < words) { self.put(i,0); i += 1; } self.length = old+words;
        if (bits != 0) { let carry: u64 = 0; i = words; while (i < self.length) { let value: u64 = ((self.get(i) as u64) << bits) | carry; self.put(i,(value & 4294967295) as u32); carry = value >> 32; i += 1; } if (carry != 0) { self.put(self.length,carry as u32); self.length += 1; } }
    }
    fn product(&self, source: Big, factor: u64, budget: &Budget) {
        assert(source.length+2 <= 128); budget.pay((source.length as u64)*3+4);
        let i: i32 = 0; while (i < source.length+2) { self.put(i,0); i += 1; }
        let part: i32 = 0; while (part < 2) { let word: u64 = (factor >> (part*32)) & 4294967295; let carry: u64 = 0; i = 0;
            while (i < source.length) { let value: u64 = (source.get(i) as u64)*word+(self.get(i+part) as u64)+carry; self.put(i+part,(value & 4294967295) as u32); carry = value >> 32; i += 1; }
            self.put(source.length+part,carry as u32); part += 1;
        } self.length = source.length+2; self.trim();
    }
    fn divide(&self, divisor: u32, budget: &Budget) -> u32 {
        budget.pay(self.length as u64); let carry: u64 = 0; let i: i32 = self.length;
        while (i > 0) { i -= 1; let value: u64 = (carry << 32) | (self.get(i) as u64); self.put(i,(value/(divisor as u64)) as u32); carry = value%(divisor as u64); } self.trim(); return carry as u32;
    }
    fn power(&self, factor: u32, exponent: i32, budget: &Budget) {
        let i: i32 = 0; while (i < exponent && !budget.failed) { self.multiply_small(factor,budget); i += 1; }
    }
}
// The el_* fields are Eisel-Lemire parameters: minimum unbiased exponent,
// infinite biased exponent, decimal exponent range of nonzero/finite fast
// results, and the exponent range where an exact product may need even rounding.
struct Config { fraction_bits: i32, bias: i32, fraction_mask: u64, sign: u64, infinity: u64, nan: u64, max_finite: u64, digits: i32, max_order: i32, min_order: i32,
    el_min_exponent: i32, el_infinite: i32, el_smallest: i32, el_largest: i32, el_round_min: i32, el_round_max: i32 }
fn config(single: bool) -> Config {
    if (single) { return Config { fraction_bits: 23, bias: 127, fraction_mask: 8388607, sign: 2147483648, infinity: 2139095040, nan: 2143289344, max_finite: 2139095039, digits: 9, max_order: 39, min_order: -46,
        el_min_exponent: -127, el_infinite: 255, el_smallest: -65, el_largest: 38, el_round_min: -17, el_round_max: 10 }; }
    return Config { fraction_bits: 52, bias: 1023, fraction_mask: 4503599627370495, sign: 9223372036854775808, infinity: 9218868437227405312, nan: 9221120237041090560, max_finite: 9218868437227405311, digits: 17, max_order: 309, min_order: -325,
        el_min_exponent: -1023, el_infinite: 2047, el_smallest: -342, el_largest: 308, el_round_min: -4, el_round_max: 23 };
}
// Fast paths. Each either returns the exact correctly rounded result or
// reports failure, in which case the exact big-integer algorithm runs.
struct Wide { high: u64, low: u64 }
fn multiply_wide(a: u64, b: u64) -> Wide {
    let mask: u64 = 4294967295;
    let a_low: u64 = a & mask; let a_high: u64 = a >> 32; let b_low: u64 = b & mask; let b_high: u64 = b >> 32;
    let low_low: u64 = a_low*b_low; let high_low: u64 = a_high*b_low; let low_high: u64 = a_low*b_high; let high_high: u64 = a_high*b_high;
    let cross: u64 = (low_low >> 32) + (high_low & mask) + low_high;
    return Wide { high: high_high + (high_low >> 32) + (cross >> 32), low: ((cross & mask) << 32) | (low_low & mask) };
}
// floor(q * log2(10)) + 63 for |q| <= 400, as in Eisel-Lemire.
fn binary_power(q: i32) -> i32 {
    let t: i32 = q*217706; if (t >= 0) { return t/65536 + 63; } return 0-((0-t+65535)/65536) + 63;
}
// Eisel-Lemire: w * 10^q (w nonzero, at most 19 digits) to positive IEEE bits,
// or u64::MAX when the truncated 128-bit product cannot decide the rounding.
fn eisel_lemire(q: i32, digits: u64, cfg: Config) -> u64 {
    let fail: u64 = 18446744073709551615;
    if (digits == 0 || q < cfg.el_smallest) { return 0; }
    if (q > cfg.el_largest) { return cfg.infinity; }
    let w: u64 = digits; let zeros: i32 = 0;
    while ((w >> 63) == 0) { w = w << 1; zeros += 1; }
    let mask: u64 = fail >> (cfg.fraction_bits+3);
    let first: Wide = multiply_wide(w,core::float_tables::pow5_high(q)); let low: u64 = first.low; let high: u64 = first.high;
    if ((high & mask) == mask) {
        let second: Wide = multiply_wide(w,core::float_tables::pow5_low(q));
        if (low > fail-second.high) { low = second.high-(fail-low)-1; high += 1; } else { low += second.high; }
    }
    if (low == fail && (q < -27 || q > 55)) { return fail; }
    let upper: i32 = (high >> 63) as i32; let shift: i32 = upper+64-cfg.fraction_bits-3;
    let mantissa: u64 = high >> shift;
    let power2: i32 = binary_power(q)+upper-zeros-cfg.el_min_exponent;
    if (power2 <= 0) {
        if (1-power2 >= 64) { return 0; }
        mantissa = mantissa >> (1-power2); mantissa += mantissa & 1; mantissa = mantissa >> 1;
        return mantissa;
    }
    let below: u64 = 1; below = (below << shift)-1;
    if (low <= 1 && q >= cfg.el_round_min && q <= cfg.el_round_max && (mantissa & 3) == 1 && (high & below) == 0) { mantissa -= 1; }
    mantissa += mantissa & 1; mantissa = mantissa >> 1;
    let hidden: u64 = 1; hidden = hidden << cfg.fraction_bits;
    if (mantissa >= hidden*2) { mantissa = hidden; power2 += 1; }
    mantissa = mantissa & cfg.fraction_mask;
    if (power2 >= cfg.el_infinite) { return cfg.infinity; }
    return ((power2 as u64) << cfg.fraction_bits) | mantissa;
}
struct DiyFp { f: u64, e: i32 }
fn normalized(f: u64, e: i32) -> DiyFp {
    let value: u64 = f; let exponent: i32 = e;
    while ((value >> 56) == 0) { value = value << 8; exponent -= 8; }
    while ((value >> 63) == 0) { value = value << 1; exponent -= 1; }
    return DiyFp { f: value, e: exponent };
}
// Rounded high 64 bits of the 128-bit product x * y (the DiyFp product's
// significand; its exponent is x.e + y.e + 64).
fn times(x: u64, y: u64) -> u64 {
    let mask: u64 = 4294967295;
    let a: u64 = x >> 32; let b: u64 = x & mask; let c: u64 = y >> 32; let d: u64 = y & mask;
    let ac: u64 = a*c; let bc: u64 = b*c; let ad: u64 = a*d; let bd: u64 = b*d;
    let middle: u64 = (bd >> 32) + (ad & mask) + (bc & mask) + 2147483648;
    return ac + (ad >> 32) + (bc >> 32) + (middle >> 32);
}
struct Shortest { ok: bool, coefficient: u64, exponent: i32 }
fn weed(coefficient: u64, distance_high: u64, unsafe_interval: u64, rest_in: u64, ten_kappa: u64, unit: u64) -> Shortest {
    let rest: u64 = rest_in; let digits: u64 = coefficient;
    let small: u64 = distance_high-unit; let big: u64 = distance_high+unit;
    while (rest < small && unsafe_interval-rest >= ten_kappa && (rest+ten_kappa < small || small-rest >= rest+ten_kappa-small)) { digits -= 1; rest += ten_kappa; }
    let fail: Shortest = Shortest { ok: false, coefficient: 0, exponent: 0 };
    if (rest < big && unsafe_interval-rest >= ten_kappa && (rest+ten_kappa < big || big-rest > rest+ten_kappa-big)) { return fail; }
    if (2*unit <= rest && rest <= unsafe_interval-4*unit) { return Shortest { ok: true, coefficient: digits, exponent: 0 }; }
    return fail;
}
// core::float_tables::cached_exponent(index) without the table scan: the
// binary exponent of the normalized 64-bit significand of 10^(-348 + 8i).
// Equal to the table for every index in [0, CACHED_COUNT).
fn cached_binary(index: i32) -> i32 { return binary_power(-348+8*index)-126; }
// Grisu3 (Loitsch 2010): shortest digits inside a conservatively narrowed
// interval, verified closest; ok is false when the 64-bit error bound cannot
// prove the result, and the exact algorithm decides instead.
// Takes the three Config fields it reads as scalars (cheaper than copying
// the whole Config per call); the dyadic split is inlined.
fn grisu(absolute: u64, fraction_bits: i32, bias: i32, fraction_mask: u64) -> Shortest {
    let fail: Shortest = Shortest { ok: false, coefficient: 0, exponent: 0 };
    let fraction: u64 = absolute & fraction_mask; let biased: i32 = (absolute >> fraction_bits) as i32;
    let mantissa: u64 = fraction; let binary: i32 = 1-bias-fraction_bits;
    if (biased != 0) { let hidden: u64 = 1; hidden = hidden << fraction_bits; mantissa = hidden | fraction; binary = biased-bias-fraction_bits; }
    let w: DiyFp = normalized(mantissa,binary);
    let plus: DiyFp = normalized((mantissa << 1)+1,binary-1);
    let minus: DiyFp = DiyFp { f: (mantissa << 1)-1, e: binary-1 };
    if (fraction == 0 && biased > 1) { minus = DiyFp { f: (mantissa << 2)-1, e: binary-2 }; }
    minus = DiyFp { f: minus.f << (minus.e-plus.e), e: plus.e };
    let lowest: i32 = -60-(w.e+64); let highest: i32 = -32-(w.e+64);
    let index: i32 = ((lowest+1220)*10)/266-1; if (index < 0) { index = 0; }
    while (index < core::float_tables::CACHED_COUNT-1 && cached_binary(index) < lowest) { index += 1; }
    while (index > 0 && cached_binary(index) > highest) { index -= 1; }
    let ten: DiyFp = DiyFp { f: core::float_tables::cached_significand(index), e: cached_binary(index) };
    if (ten.e < lowest || ten.e > highest) { return fail; }
    let scaled_f: u64 = times(w.f,ten.f); let scaled_e: i32 = w.e+ten.e+64; let low_f: u64 = times(minus.f,ten.f); let high_f: u64 = times(plus.f,ten.f);
    let unit: u64 = 1;
    let too_low: u64 = low_f-unit; let too_high: u64 = high_f+unit; let unsafe_interval: u64 = too_high-too_low;
    let shift: i32 = 0-scaled_e; let one: u64 = 1; one = one << shift;
    let integrals: u64 = too_high >> shift; let fractionals: u64 = too_high & (one-1);
    let divisor: u64 = 1; let kappa: i32 = 1;
    if (integrals == 0) { divisor = 0; kappa = 0; } else {
        if (integrals >= 100000) { divisor = 100000; kappa = 6; }
        while (divisor*10 <= integrals) { divisor *= 10; kappa += 1; }
    }
    let coefficient: u64 = 0; let count: i32 = 0; let decimal: i32 = 0-core::float_tables::cached_decimal(index);
    while (kappa > 0) {
        let quotient: u64 = integrals/divisor; coefficient = coefficient*10+quotient; count += 1; integrals = integrals-quotient*divisor; kappa -= 1;
        let rest: u64 = (integrals << shift)+fractionals;
        if (rest < unsafe_interval) {
            let result: Shortest = weed(coefficient,too_high-scaled_f,unsafe_interval,rest,divisor << shift,unit);
            result.exponent = decimal+kappa; return result;
        }
        // divisor <= 10^9 < 2^32, where (n * 3435973837) >> 35 == n / 10.
        divisor = (divisor*3435973837) >> 35;
    }
    while (count < 19) {
        fractionals *= 10; unit *= 10; unsafe_interval *= 10;
        coefficient = coefficient*10+(fractionals >> shift); count += 1; fractionals = fractionals & (one-1); kappa -= 1;
        if (fractionals < unsafe_interval) {
            let result: Shortest = weed(coefficient,(too_high-scaled_f)*unit,unsafe_interval,fractionals,one,unit);
            result.exponent = decimal+kappa; return result;
        }
    }
    return fail;
}
struct Dyadic { mantissa: u64, exponent: i32 }
fn dyadic(bits: u64, cfg: Config) -> Dyadic {
    let fraction: u64 = bits & cfg.fraction_mask; let biased: i32 = (bits >> cfg.fraction_bits) as i32;
    if (biased == 0) { return Dyadic { mantissa: fraction, exponent: 1-cfg.bias-cfg.fraction_bits }; }
    let hidden: u64 = 1; hidden = hidden << cfg.fraction_bits; return Dyadic { mantissa: hidden | fraction, exponent: biased-cfg.bias-cfg.fraction_bits };
}
// Compare N/D with m*2^e exactly. Check bit lengths before constructing shifts;
// temporary descriptors are local copies over disjoint caller scratch slots.
fn compare_dyadic(numerator: Big, denominator: Big, value: Dyadic, temporary: Big, shifted: Big, budget: &Budget) -> i32 {
    temporary.product(denominator,value.mantissa,budget); let left_bits: i32 = numerator.bits(budget); let right_bits: i32 = temporary.bits(budget);
    if (value.exponent >= 0) { right_bits += value.exponent; if (left_bits < right_bits) { return -1; } if (left_bits > right_bits) { return 1; } temporary.shift(value.exponent,budget); return numerator.compare(temporary,budget); }
    left_bits -= value.exponent; if (left_bits < right_bits) { return -1; } if (left_bits > right_bits) { return 1; } shifted.copy(numerator,budget); shifted.shift(0-value.exponent,budget); return shifted.compare(temporary,budget);
}
fn lower_ascii(byte: u8) -> u8 { if (byte >= 65 && byte <= 90) { return byte+32; } return byte; }
fn special(input: core::slice::View<u8>, start: i32) -> i32 {
    let n: i32 = input.length-start;
    if (n == 3 && lower_ascii(input.values[input.start+start]) == 110 && lower_ascii(input.values[input.start+start+1]) == 97 && lower_ascii(input.values[input.start+start+2]) == 110) { return 2; }
    if ((n == 3 || n == 8) && lower_ascii(input.values[input.start+start]) == 105 && lower_ascii(input.values[input.start+start+1]) == 110 && lower_ascii(input.values[input.start+start+2]) == 102) {
        if (n == 3) { return 1; }
        if (lower_ascii(input.values[input.start+start+3]) == 105 && lower_ascii(input.values[input.start+start+4]) == 110 && lower_ascii(input.values[input.start+start+5]) == 105 && lower_ascii(input.values[input.start+start+6]) == 116 && lower_ascii(input.values[input.start+start+7]) == 121) { return 1; }
    } return 0;
}
fn parse_bits(input: core::slice::View<u8>, scratch: core::slice::View<u32>, limits: Limits, cfg: Config) -> core::result::Result<u64,Error> {
    if (!valid(input) || limits.max_input < 0 || limits.max_digits < 0 || limits.max_digits > 768) { return core::result::Err(Error::Bounds); }
    let checked: core::result::Result<i32,Error> = storage(scratch); if (core::result::is_err(checked)) { return core::result::Err(core::result::unwrap_err(checked)); }
    if (input.length > limits.max_input) { return core::result::Err(Error::InputLimit); }
    let budget: Budget = Budget { left: limits.max_work, failed: false }; budget.pay(input.length as u64); if (budget.failed) { return core::result::Err(Error::WorkLimit); }
    let at: i32 = 0; let sign: u64 = 0;
    if (at < input.length && (input.values[input.start+at] == 43 || input.values[input.start+at] == 45)) { if (input.values[input.start+at] == 45) { sign = cfg.sign; } at += 1; }
    let known: i32 = special(input,at); if (known == 1) { return core::result::Ok(sign | cfg.infinity); } if (known == 2) { return core::result::Ok(sign | cfg.nan); }
    let numerator: Big = big(scratch,0); numerator.set(0,budget.borrow()); let denominator: Big = big(scratch,1); let temporary: Big = big(scratch,2); let shifted: Big = big(scratch,3);
    let digits: i32 = 0; let significant: i32 = 0; let fast: u64 = 0; let fraction: i32 = 0; let dot: bool = false; let nonzero: bool = false;
    // First pass: syntax, digit counts and the leading 19 significant digits.
    // The exact numerator is built only if the fast path cannot decide.
    let mantissa_start: i32 = at;
    while (at < input.length) {
        let byte: u8 = input.values[input.start+at];
        if (byte >= 48 && byte <= 57) {
            if (digits == limits.max_digits) { return core::result::Err(Error::DigitLimit); } digits += 1; if (dot) { fraction += 1; }
            if (byte != 48) { nonzero = true; } if (nonzero) { significant += 1; if (significant <= 19) { fast = fast*10+((byte-48) as u64); } }
            at += 1;
        } else { if (byte == 46 && !dot) { dot = true; at += 1; } else { break; } }
    }
    let mantissa_end: i32 = at;
    if (digits == 0) { return core::result::Err(Error::Invalid(at)); }
    let exponent: i32 = 0;
    if (at < input.length && (input.values[input.start+at] == 101 || input.values[input.start+at] == 69)) {
        at += 1; let negative: bool = false;
        if (at < input.length && (input.values[input.start+at] == 43 || input.values[input.start+at] == 45)) { negative = input.values[input.start+at] == 45; at += 1; }
        let start: i32 = at; while (at < input.length && input.values[input.start+at] >= 48 && input.values[input.start+at] <= 57) { if (exponent < 1000000) { exponent = exponent*10+((input.values[input.start+at]-48) as i32); if (exponent > 1000000) { exponent = 1000000; } } at += 1; }
        if (at == start) { return core::result::Err(Error::Invalid(at)); } if (negative) { exponent = 0-exponent; }
    }
    if (at != input.length) { return core::result::Err(Error::Invalid(at)); } if (!nonzero) { return core::result::Ok(sign); }
    exponent -= fraction; let order: i32 = exponent+significant-1;
    if (order > cfg.max_order) { return core::result::Ok(sign | cfg.infinity); } if (order < cfg.min_order) { return core::result::Ok(sign); }
    // Charged like a short exact step, so tiny budgets still report WorkLimit.
    budget.pay(100); if (budget.failed) { return core::result::Err(Error::WorkLimit); }
    if (significant <= 19) {
        // All significant digits fit in fast, so the value is fast * 10^exponent.
        let quick: u64 = eisel_lemire(exponent,fast,cfg);
        if (quick != 18446744073709551615) { return core::result::Ok(sign | quick); }
    } else {
        // The value lies in [fast, fast+1) * 10^q; equal roundings decide it.
        let q: i32 = exponent+(significant-19);
        let below: u64 = eisel_lemire(q,fast,cfg); let above: u64 = eisel_lemire(q,fast+1,cfg);
        if (below != 18446744073709551615 && below == above) { return core::result::Ok(sign | below); }
    }
    let index: i32 = mantissa_start;
    while (index < mantissa_end) {
        let byte: u8 = input.values[input.start+index];
        if (byte != 46) { numerator.multiply_small(10,budget.borrow()); numerator.add_small((byte-48) as u32,budget.borrow()); if (budget.failed) { return core::result::Err(Error::WorkLimit); } }
        index += 1;
    }
    denominator.set(1,budget.borrow()); if (exponent >= 0) { numerator.power(10,exponent,budget.borrow()); } else { denominator.power(10,0-exponent,budget.borrow()); }
    if (budget.failed) { return core::result::Err(Error::WorkLimit); }
    // Positive IEEE encodings are ordered by value. Find the floor, then compare
    // its upper midpoint; adding one also handles the max-finite/inf threshold.
    let low: u64 = 0; let high: u64 = cfg.max_finite;
    while (low < high) {
        let middle: u64 = low+(high-low+1)/2; let comparison: i32 = compare_dyadic(numerator,denominator,dyadic(middle,cfg),temporary,shifted,budget.borrow());
        if (budget.failed) { return core::result::Err(Error::WorkLimit); } if (comparison >= 0) { low = middle; } else { high = middle-1; }
    }
    let value: Dyadic = dyadic(low,cfg); value.mantissa = value.mantissa*4+2; value.exponent -= 2;
    let comparison: i32 = compare_dyadic(numerator,denominator,value,temporary,shifted,budget.borrow()); if (budget.failed) { return core::result::Err(Error::WorkLimit); }
    if (comparison > 0 || (comparison == 0 && (low & 1) != 0)) { low += 1; }
    return core::result::Ok(sign | low);
}
pub fn parse_f32(input: core::slice::View<u8>, scratch: core::slice::View<u32>, limits: Limits) -> core::result::Result<f32,Error> {
    let parsed: core::result::Result<u64,Error> = parse_bits(input,scratch,limits,config(true)); if (core::result::is_err(parsed)) { return core::result::Err(core::result::unwrap_err(parsed)); } return core::result::Ok(core::f32::from_bits(core::result::unwrap(parsed) as u32));
}
pub fn parse_f64(input: core::slice::View<u8>, scratch: core::slice::View<u32>, limits: Limits) -> core::result::Result<f64,Error> {
    let parsed: core::result::Result<u64,Error> = parse_bits(input,scratch,limits,config(false)); if (core::result::is_err(parsed)) { return core::result::Err(core::result::unwrap_err(parsed)); } return core::result::Ok(core::f64::from_bits(core::result::unwrap(parsed)));
}

struct Decimal { coefficient: u64, exponent: i32, negative: bool, special: i32 }
// Decimal digit count; compares against growing powers of ten (no division).
fn digits(value: u64) -> i32 {
    let bound: u64 = 10; let count: i32 = 1;
    // Most shortest doubles have 16 or 17 digits; start there.
    if (value >= 1000000000000000) { bound = 10000000000000000; count = 16; }
    while (count < 20 && value >= bound) { bound *= 10; count += 1; }
    return count;
}
fn power10(exponent: i32) -> u64 { let value: u64 = 1; let i: i32 = 0; while (i < exponent) { value *= 10; i += 1; } return value; }
fn decimal_digit(groups: core::slice::View<u32>, count: i32, first: i32, index: i32) -> u64 {
    let group: i32 = count-1; let position: i32 = index; let width: i32 = first;
    if (index >= first) { group = count-2-(index-first)/9; position = (index-first)%9; width = 9; }
    return ((groups.values[groups.start+group] as u64)/power10(width-position-1))%10;
}
fn inside(value: Big, lower: Big, upper: Big, inclusive: bool, budget: &Budget) -> bool {
    let low: i32 = value.compare(lower,budget); let high: i32 = value.compare(upper,budget); return (low > 0 || (inclusive && low == 0)) && (high < 0 || (inclusive && high == 0));
}
fn prepare(bits: u64, cfg: Config, scratch: core::slice::View<u32>, work: u64) -> core::result::Result<Decimal,Error> {
    let checked: core::result::Result<i32,Error> = storage(scratch); if (core::result::is_err(checked)) { return core::result::Err(core::result::unwrap_err(checked)); }
    let budget: Budget = Budget { left: work, failed: false }; budget.pay(1); if (budget.failed) { return core::result::Err(Error::WorkLimit); }
    let negative: bool = (bits & cfg.sign) != 0; let absolute: u64 = bits & (cfg.sign-1);
    if (absolute >= cfg.infinity) { let kind: i32 = 1; if (absolute > cfg.infinity) { kind = 2; negative = false; } return core::result::Ok(Decimal { coefficient: 0, exponent: 0, negative: negative, special: kind }); }
    if (absolute == 0) { return core::result::Ok(Decimal { coefficient: 0, exponent: 0, negative: negative, special: 0 }); }
    budget.pay(100); if (budget.failed) { return core::result::Err(Error::WorkLimit); }
    let fast: Shortest = grisu(absolute,cfg.fraction_bits,cfg.bias,cfg.fraction_mask);
    if (fast.ok) {
        let coefficient: u64 = fast.coefficient; let decimal_exponent: i32 = fast.exponent;
        while (coefficient%10 == 0) { coefficient /= 10; decimal_exponent += 1; }
        return core::result::Ok(Decimal { coefficient: coefficient, exponent: decimal_exponent, negative: negative, special: 0 });
    }
    // Normal powers of two (except the min-normal transition) have a lower
    // half-width interval. Midpoints belong to this value iff m2 is even.
    let value: Dyadic = dyadic(absolute,cfg); let central: u64 = value.mantissa*4; let mm_shift: u64 = 1;
    if ((absolute & cfg.fraction_mask) == 0 && (absolute >> cfg.fraction_bits) > 1) { mm_shift = 0; }
    let exponent: i32 = value.exponent-2; let scale: i32 = 0;
    let unit: Big = big(scratch,0); let exact: Big = big(scratch,1); let lower: Big = big(scratch,2); let upper: Big = big(scratch,3); let temporary: Big = big(scratch,4); let candidate: Big = big(scratch,5);
    unit.set(1,budget.borrow()); if (exponent < 0) { scale = 0-exponent; unit.power(5,scale,budget.borrow()); } else { unit.shift(exponent,budget.borrow()); }
    if (budget.failed) { return core::result::Err(Error::WorkLimit); }
    exact.product(unit,central,budget.borrow()); lower.product(unit,central-1-mm_shift,budget.borrow()); upper.product(unit,central+2,budget.borrow()); temporary.copy(exact,budget.borrow());
    let groups: core::slice::View<u32> = core::result::unwrap(scratch.subview(768,864)); let count: i32 = 0;
    while (temporary.length > 0) { assert(count < 96); groups.values[groups.start+count] = temporary.divide(1000000000,budget.borrow()); count += 1; if (budget.failed) { return core::result::Err(Error::WorkLimit); } }
    let first: i32 = digits(groups.values[groups.start+count-1] as u64); let total: i32 = (count-1)*9+first;
    unit.set(1,budget.borrow()); unit.power(10,total-1,budget.borrow()); if (budget.failed) { return core::result::Err(Error::WorkLimit); }
    let prefix: u64 = 0; let precision: i32 = 1; let inclusive: bool = (value.mantissa & 1) == 0;
    while (precision <= cfg.digits && precision <= total) {
        prefix = prefix*10+decimal_digit(groups,count,first,precision-1); temporary.product(unit,prefix,budget.borrow()); candidate.copy(temporary,budget.borrow()); candidate.add(unit,budget.borrow());
        // Both neighbors matter: the nearest decimal candidate can lie outside
        // an asymmetric interval while the other remains inside it.
        let floor_ok: bool = inside(temporary,lower,upper,inclusive,budget.borrow()); let ceil_ok: bool = inside(candidate,lower,upper,inclusive,budget.borrow());
        if (budget.failed) { return core::result::Err(Error::WorkLimit); }
        if (floor_ok || ceil_ok) {
            let coefficient: u64 = prefix;
            if (!floor_ok) { coefficient += 1; }
            else { if (ceil_ok) { candidate.copy(exact,budget.borrow()); candidate.subtract(temporary,budget.borrow()); candidate.multiply_small(2,budget.borrow()); let side: i32 = candidate.compare(unit,budget.borrow()); if (side > 0 || (side == 0 && (prefix & 1) != 0)) { coefficient += 1; } } }
            let decimal_exponent: i32 = total-precision-scale; while (coefficient%10 == 0) { coefficient /= 10; decimal_exponent += 1; }
            if (budget.failed) { return core::result::Err(Error::WorkLimit); } return core::result::Ok(Decimal { coefficient: coefficient, exponent: decimal_exponent, negative: negative, special: 0 });
        }
        unit.divide(10,budget.borrow()); precision += 1;
    }
    assert(false); return core::result::Err(Error::Bounds);
}
// Whether a finite nonzero value whose coefficient has count digits is
// shorter in scientific notation.
fn scientific_count(value: Decimal, count: i32) -> bool {
    let exponent: i32 = value.exponent+count-1; let absolute: i32 = exponent; if (absolute < 0) { absolute = 0-absolute; }
    let sci: i32 = count+1+digits(absolute as u64); if (count > 1) { sci += 1; } if (exponent < 0) { sci += 1; }
    let fixed: i32 = count+value.exponent; if (value.exponent < 0) { if (count+value.exponent > 0) { fixed = count+1; } else { fixed = 2-value.exponent; } }
    return sci < fixed;
}
fn length(value: Decimal) -> i32 {
    if (value.special != 0 || value.coefficient == 0) { return sized_length(value,0,false); }
    let count: i32 = digits(value.coefficient);
    return sized_length(value,count,scientific_count(value,count));
}
// length() given the digit count and notation of a finite nonzero value.
fn sized_length(value: Decimal, count: i32, sci: bool) -> i32 {
    let sign: i32 = 0; if (value.negative) { sign = 1; } if (value.special != 0) { return sign+3; } if (value.coefficient == 0) { return sign+1; }
    if (sci) { let exponent: i32 = value.exponent+count-1; let negative: i32 = 0; if (exponent < 0) { negative = 1; exponent = 0-exponent; } let point: i32 = 0; if (count > 1) { point = 1; } return sign+count+point+1+negative+digits(exponent as u64); }
    if (value.exponent >= 0) { return sign+count+value.exponent; } if (count+value.exponent > 0) { return sign+count+1; } return sign+2-value.exponent;
}
fn digit(value: u64, count: i32, index: i32) -> u8 { return (48+(value/power10(count-index-1))%10) as u8; }
// Writes the count decimal digits of value to spelled[0..count].
// Writes the lowest count decimal digits of value into out[end-count, end),
// right to left, and returns value / 10^count. Two digits per division;
// (pair * 205) >> 11 == pair / 10 for pair < 100.
fn spell(value: u64, count: i32, out: [u8], end: i32) -> u64 {
    let rest: u64 = value; let at: i32 = end; let left: i32 = count;
    while (left > 1) {
        let next: u64 = rest/100; let pair: u64 = rest-next*100; let tens: u64 = (pair*205) >> 11;
        out[at-1] = (48+pair-tens*10) as u8; out[at-2] = (48+tens) as u8; at -= 2; left -= 2; rest = next;
    }
    if (left == 1) { let next: u64 = rest/10; out[at-1] = (48+rest-next*10) as u8; rest = next; }
    return rest;
}
// Digits are spelled straight into their final positions.
fn render(value: Decimal, output: core::slice::View<u8>, count: i32, sci: bool) {
    let out: [u8] = output.values;
    let at: i32 = output.start; if (value.negative) { out[at] = 45; at += 1; }
    if (value.special == 1) { out[at] = 105; out[at+1] = 110; out[at+2] = 102; return; }
    if (value.special == 2) { out[at] = 78; out[at+1] = 97; out[at+2] = 78; return; }
    if (value.coefficient == 0) { out[at] = 48; return; }
    if (sci) {
        if (count > 1) { let first: u64 = spell(value.coefficient,count-1,out,at+count+1); out[at] = (48+first) as u8; out[at+1] = 46; at += count+1; }
        else { out[at] = (48+value.coefficient) as u8; at += 1; }
        out[at] = 101; at += 1; let exponent: i32 = value.exponent+count-1; if (exponent < 0) { out[at] = 45; at += 1; exponent = 0-exponent; }
        let width: i32 = digits(exponent as u64); spell(exponent as u64,width,out,at+width); return;
    }
    let point: i32 = count+value.exponent;
    if (point <= 0) {
        out[at] = 48; out[at+1] = 46; at += 2; let zeros: i32 = 0-point; while (zeros > 0) { out[at] = 48; at += 1; zeros -= 1; }
        spell(value.coefficient,count,out,at+count); return;
    }
    if (point < count) { let high: u64 = spell(value.coefficient,count-point,out,at+count+1); out[at+point] = 46; spell(high,point,out,at+point); return; }
    spell(value.coefficient,count,out,at+count); at += count;
    let zeros: i32 = value.exponent; while (zeros > 0) { out[at] = 48; at += 1; zeros -= 1; }
}
fn format_bits_len(bits: u64, cfg: Config, scratch: core::slice::View<u32>, work: u64) -> core::result::Result<i32,Error> {
    let converted: core::result::Result<Decimal,Error> = prepare(bits,cfg,scratch,work); if (core::result::is_err(converted)) { return core::result::Err(core::result::unwrap_err(converted)); } return core::result::Ok(length(core::result::unwrap(converted)));
}
fn format_bits_into(bits: u64, cfg: Config, output: core::slice::View<u8>, scratch: core::slice::View<u32>, work: u64) -> core::result::Result<i32,Error> {
    // Conversion and all fallible checks precede the first output write.
    if (!valid(output)) { return core::result::Err(Error::Bounds); }
    // Shortcut for prepare()'s common case: valid scratch, enough work and a
    // finite nonzero value Grisu proves; the same Decimal without the
    // Result and budget plumbing. special -1 marks "not converted yet".
    let value: Decimal = Decimal { coefficient: 0, exponent: 0, negative: false, special: -1 };
    if (work >= 101 && scratch.start >= 0 && scratch.length >= SCRATCH_LEN && scratch.start <= 2147483647-scratch.length) {
        let absolute: u64 = bits & (cfg.sign-1);
        if (absolute != 0 && absolute < cfg.infinity) {
            let fast: Shortest = grisu(absolute,cfg.fraction_bits,cfg.bias,cfg.fraction_mask);
            if (fast.ok) {
                let coefficient: u64 = fast.coefficient; let decimal_exponent: i32 = fast.exponent;
                while (coefficient%10 == 0) { coefficient /= 10; decimal_exponent += 1; }
                value = Decimal { coefficient: coefficient, exponent: decimal_exponent, negative: (bits & cfg.sign) != 0, special: 0 };
            }
        }
    }
    if (value.special < 0) {
        let converted: core::result::Result<Decimal,Error> = prepare(bits,cfg,scratch,work); if (core::result::is_err(converted)) { return core::result::Err(core::result::unwrap_err(converted)); }
        value = core::result::unwrap(converted);
    }
    return finish(value,output);
}
// Lay out and write a converted value; the capacity check precedes writing.
fn finish(value: Decimal, output: core::slice::View<u8>) -> core::result::Result<i32,Error> {
    let count: i32 = 0; let sci: bool = false;
    if (value.special == 0 && value.coefficient != 0) { count = digits(value.coefficient); sci = scientific_count(value,count); }
    let size: i32 = sized_length(value,count,sci); if (output.length < size) { return core::result::Err(Error::Capacity(size)); } render(value,output,count,sci); return core::result::Ok(size);
}
pub fn format_f32_len(value: f32, scratch: core::slice::View<u32>, max_work: u64) -> core::result::Result<i32,Error> { return format_bits_len(core::f32::to_bits(value) as u64,config(true),scratch,max_work); }
pub fn format_f64_len(value: f64, scratch: core::slice::View<u32>, max_work: u64) -> core::result::Result<i32,Error> { return format_bits_len(core::f64::to_bits(value),config(false),scratch,max_work); }
pub fn format_f32_into(value: f32, output: core::slice::View<u8>, scratch: core::slice::View<u32>, max_work: u64) -> core::result::Result<i32,Error> { return format_bits_into(core::f32::to_bits(value) as u64,config(true),output,scratch,max_work); }
pub fn format_f64_into(value: f64, output: core::slice::View<u8>, scratch: core::slice::View<u32>, max_work: u64) -> core::result::Result<i32,Error> {
    // format_bits_into's Grisu shortcut with the binary64 constants inline
    // (no Config to build and copy); anything else takes the general path.
    let bits: u64 = core::f64::to_bits(value);
    if (valid(output) && max_work >= 101 && scratch.start >= 0 && scratch.length >= SCRATCH_LEN && scratch.start <= 2147483647-scratch.length) {
        let absolute: u64 = bits & 9223372036854775807;
        if (absolute != 0 && absolute < 9218868437227405312) {
            let fast: Shortest = grisu(absolute,52,1023,4503599627370495);
            if (fast.ok) {
                let coefficient: u64 = fast.coefficient; let decimal_exponent: i32 = fast.exponent;
                while (coefficient%10 == 0) { coefficient /= 10; decimal_exponent += 1; }
                return finish(Decimal { coefficient: coefficient, exponent: decimal_exponent, negative: absolute != bits, special: 0 }, output);
            }
        }
    }
    return format_bits_into(bits,config(false),output,scratch,max_work);
}

// Explicit decimal precision uses the exact IEEE value, never shortest text.
pub const MAX_PRECISION: i32 = 768;
pub enum PrecisionStyle { Fixed, Scientific, General }
pub struct PrecisionOptions { style: PrecisionStyle, precision: i32, alternate: bool, uppercase: bool }
struct Precise { values: core::slice::View<u32>, count: i32, order: i32, negative: bool, special: i32, scientific: bool, fraction: i32, point: bool, uppercase: bool }
fn precision_style(style: PrecisionStyle) -> i32 { let code: i32 = match (style) { PrecisionStyle::Fixed -> 0, PrecisionStyle::Scientific -> 1, PrecisionStyle::General -> 2 }; return code; }
fn precise_digit(value: Precise, index: i32) -> u8 {
    if (index < 0 || index >= value.count) { return 48; }
    return (48+value.values.values[value.values.start+index]) as u8;
}
fn precise_len(value: Precise) -> i32 {
    let size: i32 = 0; if (value.negative) { size = 1; } if (value.special != 0) { return size+3; }
    let integral: i32 = value.order+1; if (integral < 1 || value.scientific) { integral = 1; }
    size += integral+value.fraction; if (value.point) { size += 1; }
    if (value.scientific) { let exponent: i32 = value.order; if (exponent < 0) { exponent = 0-exponent; } let width: i32 = digits(exponent as u64); if (width < 2) { width = 2; } size += 2+width; }
    return size;
}
fn prepare_precision(bits: u64, cfg: Config, options: PrecisionOptions, scratch: core::slice::View<u32>, work: u64) -> core::result::Result<Precise,Error> {
    if (options.precision < 0 || options.precision > MAX_PRECISION) { return core::result::Err(Error::Bounds); }
    let checked: core::result::Result<i32,Error> = storage(scratch); if (core::result::is_err(checked)) { return core::result::Err(core::result::unwrap_err(checked)); }
    let budget: Budget = Budget { left: work, failed: false }; budget.pay(1); if (budget.failed) { return core::result::Err(Error::WorkLimit); }
    let output_digits: core::slice::View<u32> = core::result::unwrap(scratch.subview(0,768));
    let negative: bool = (bits & cfg.sign) != 0; let absolute: u64 = bits & (cfg.sign-1); let special_kind: i32 = 0;
    let count: i32 = 1; let order: i32 = 0;
    if (absolute >= cfg.infinity) { special_kind = 1; if (absolute > cfg.infinity) { special_kind = 2; negative = false; } }
    else {
        if (absolute == 0) { output_digits.values[output_digits.start] = 0; }
        else {
            // m*2^e = (m*5^-e)*10^e for e<0. The largest exact
            // binary64 coefficient has 767 digits (<4096 bits).
            let exact: Big = big(scratch,0); let value: Dyadic = dyadic(absolute,cfg); let scale: i32 = 0;
            exact.set(value.mantissa,budget.borrow());
            if (value.exponent < 0) { scale = 0-value.exponent; exact.power(5,scale,budget.borrow()); } else { exact.shift(value.exponent,budget.borrow()); }
            if (budget.failed) { return core::result::Err(Error::WorkLimit); }
            let groups: core::slice::View<u32> = core::result::unwrap(scratch.subview(768,864)); let group_count: i32 = 0;
            while (exact.length > 0) { assert(group_count < 96); groups.values[groups.start+group_count] = exact.divide(1000000000,budget.borrow()); group_count += 1; if (budget.failed) { return core::result::Err(Error::WorkLimit); } }
            let first: i32 = digits(groups.values[groups.start+group_count-1] as u64); count = (group_count-1)*9+first; assert(count <= 768); order = count-scale-1;
            budget.pay(count as u64); if (budget.failed) { return core::result::Err(Error::WorkLimit); }
            // The integer is dead before its storage becomes decimal digits.
            let i: i32 = 0; while (i < count) { output_digits.values[output_digits.start+i] = decimal_digit(groups,group_count,first,i) as u32; i += 1; }
            let style: i32 = precision_style(options.style); let precision: i32 = options.precision; if (style == 2 && precision == 0) { precision = 1; }
            let keep: i32 = precision; if (style == 0) { keep = order+1+precision; } if (style == 1) { keep += 1; }
            if (keep < count) {
                let up: bool = false;
                if (keep >= 0) {
                    let next: u32 = output_digits.values[output_digits.start+keep]; let tail: bool = false; i = keep+1;
                    while (i < count) { budget.pay(1); if (output_digits.values[output_digits.start+i] != 0) { tail = true; } i += 1; }
                    let odd: bool = false; if (keep > 0) { odd = (output_digits.values[output_digits.start+keep-1] & 1) != 0; }
                    up = next > 5 || (next == 5 && (tail || odd));
                }
                if (keep <= 0) {
                    output_digits.values[output_digits.start] = 0; count = 1; order = 0;
                    if (up) { output_digits.values[output_digits.start] = 1; order = 0-options.precision; }
                } else {
                    count = keep;
                    if (up) {
                        i = keep-1;
                        while (i >= 0 && output_digits.values[output_digits.start+i] == 9) { budget.pay(1); output_digits.values[output_digits.start+i] = 0; i -= 1; }
                        if (i < 0) { output_digits.values[output_digits.start] = 1; count = 1; order += 1; }
                        else { output_digits.values[output_digits.start+i] += 1; }
                    }
                }
            }
            while (count > 1 && output_digits.values[output_digits.start+count-1] == 0) { budget.pay(1); count -= 1; }
        }
    }
    let style: i32 = precision_style(options.style); let scientific_form: bool = style == 1; let fraction: i32 = options.precision;
    if (style == 2) {
        let precision: i32 = options.precision; if (precision == 0) { precision = 1; }
        scientific_form = order < -4 || order >= precision; fraction = precision-1; if (!scientific_form) { fraction -= order; }
        if (!options.alternate) { let meaningful: i32 = count-1; if (!scientific_form) { meaningful -= order; } if (meaningful < 0) { meaningful = 0; } if (fraction > meaningful) { fraction = meaningful; } }
    }
    let converted: Precise = Precise { values: output_digits, count: count, order: order, negative: negative, special: special_kind, scientific: scientific_form, fraction: fraction, point: fraction > 0 || options.alternate, uppercase: options.uppercase };
    // Reserve rendering work before any caller output can be written.
    budget.pay(precise_len(converted) as u64); if (budget.failed) { return core::result::Err(Error::WorkLimit); }
    return core::result::Ok(converted);
}
fn render_precision(value: Precise, output: core::slice::View<u8>) {
    let at: i32 = output.start; if (value.negative) { output.values[at] = 45; at += 1; }
    if (value.special != 0) {
        let first: u8 = 105; let second: u8 = 110; let third: u8 = 102;
        if (value.special == 2) { first = 110; second = 97; third = 110; }
        if (value.uppercase) { first -= 32; second -= 32; third -= 32; }
        output.values[at] = first; output.values[at+1] = second; output.values[at+2] = third; return;
    }
    let integral: i32 = value.order+1; if (integral < 1 || value.scientific) { integral = 1; }
    let index: i32 = 0;
    while (index < integral) { let digit_index: i32 = index; if (value.order < 0 && !value.scientific) { digit_index = -1; } output.values[at] = precise_digit(value,digit_index); at += 1; index += 1; }
    if (value.point) { output.values[at] = 46; at += 1; }
    index = 0; while (index < value.fraction) { let digit_index: i32 = value.order+1+index; if (value.scientific) { digit_index = 1+index; } output.values[at] = precise_digit(value,digit_index); at += 1; index += 1; }
    if (value.scientific) {
        let marker: u8 = 101; if (value.uppercase) { marker = 69; } output.values[at] = marker; at += 1;
        let exponent: i32 = value.order; let sign: u8 = 43; if (exponent < 0) { sign = 45; exponent = 0-exponent; } output.values[at] = sign; at += 1;
        let width: i32 = digits(exponent as u64); if (width < 2) { output.values[at] = 48; at += 1; } index = 0;
        while (index < width) { output.values[at] = digit(exponent as u64,width,index); at += 1; index += 1; }
    }
}
fn precision_bits_len(bits: u64, cfg: Config, options: PrecisionOptions, scratch: core::slice::View<u32>, work: u64) -> core::result::Result<i32,Error> {
    let converted: core::result::Result<Precise,Error> = prepare_precision(bits,cfg,options,scratch,work); if (core::result::is_err(converted)) { return core::result::Err(core::result::unwrap_err(converted)); } return core::result::Ok(precise_len(core::result::unwrap(converted)));
}
fn precision_bits_into(bits: u64, cfg: Config, output: core::slice::View<u8>, options: PrecisionOptions, scratch: core::slice::View<u32>, work: u64) -> core::result::Result<i32,Error> {
    if (!valid(output)) { return core::result::Err(Error::Bounds); }
    let converted: core::result::Result<Precise,Error> = prepare_precision(bits,cfg,options,scratch,work); if (core::result::is_err(converted)) { return core::result::Err(core::result::unwrap_err(converted)); }
    let value: Precise = core::result::unwrap(converted); let size: i32 = precise_len(value); if (output.length < size) { return core::result::Err(Error::Capacity(size)); }
    render_precision(value,output); return core::result::Ok(size);
}
pub fn format_f32_precision_len(value: f32, options: PrecisionOptions, scratch: core::slice::View<u32>, max_work: u64) -> core::result::Result<i32,Error> { return precision_bits_len(core::f32::to_bits(value) as u64,config(true),options,scratch,max_work); }
pub fn format_f64_precision_len(value: f64, options: PrecisionOptions, scratch: core::slice::View<u32>, max_work: u64) -> core::result::Result<i32,Error> { return precision_bits_len(core::f64::to_bits(value),config(false),options,scratch,max_work); }
pub fn format_f32_precision_into(value: f32, output: core::slice::View<u8>, options: PrecisionOptions, scratch: core::slice::View<u32>, max_work: u64) -> core::result::Result<i32,Error> { return precision_bits_into(core::f32::to_bits(value) as u64,config(true),output,options,scratch,max_work); }
pub fn format_f64_precision_into(value: f64, output: core::slice::View<u8>, options: PrecisionOptions, scratch: core::slice::View<u32>, max_work: u64) -> core::result::Result<i32,Error> { return precision_bits_into(core::f64::to_bits(value),config(false),output,options,scratch,max_work); }
