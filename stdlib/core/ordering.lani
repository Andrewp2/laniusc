// Ordering values and allocation-free borrowed comparison contexts.

module core::ordering;

import core::cmp;
import core::wide_u64;
import core::wide_i64;

pub enum Ordering {
    Less,
    Equal,
    Greater,
}

// Compare shallow operands. Sorting requires a consistent total order;
// heterogeneous lookup requires Less/Equal/Greater classes in that order.
// Keep operands, source and ordering policy live and unchanged during a call.
// Instrumentation may record calls, but must not retire operands or reenter.
pub trait Comparator<L,R> {
    pub fn compare(&self,left:L,right:R) -> Ordering;
}

pub struct Natural<T> {}
pub impl<T> Natural<T> {
    pub fn borrow(&self) -> &Natural<T> { return self; }
}
pub impl<T> Comparator<T,T> for Natural<T> where T:core::cmp::Ord<T> {
    pub fn compare(&self,left:T,right:T) -> Ordering {
        if(T::lt(left,right)) { return Less; }
        if(T::lt(right,left)) { return Greater; }
        return Equal;
    }
}

pub fn compare_i32(left: i32, right: i32) -> Ordering {
    if (left < right) {
        return Less;
    } else {
        if (left > right) {
            return Greater;
        } else {
            return Equal;
        }
    }
}

pub fn compare_u32(left: u32, right: u32) -> Ordering {
    if (left < right) {
        return Less;
    } else {
        if (left > right) {
            return Greater;
        } else {
            return Equal;
        }
    }
}

pub fn compare_u8(left: u8, right: u8) -> Ordering {
    if (left < right) {
        return Less;
    } else {
        if (left > right) {
            return Greater;
        } else {
            return Equal;
        }
    }
}

pub fn compare_i8(left: i8, right: i8) -> Ordering {
    if (left < right) {
        return Less;
    } else {
        if (left > right) {
            return Greater;
        } else {
            return Equal;
        }
    }
}

pub fn compare_i16(left: i16, right: i16) -> Ordering {
    if (left < right) {
        return Less;
    } else {
        if (left > right) {
            return Greater;
        } else {
            return Equal;
        }
    }
}

pub fn compare_u16(left: u16, right: u16) -> Ordering {
    if (left < right) {
        return Less;
    } else {
        if (left > right) {
            return Greater;
        } else {
            return Equal;
        }
    }
}

pub fn compare_char(left: char, right: char) -> Ordering {
    if (left < right) {
        return Less;
    } else {
        if (left > right) {
            return Greater;
        } else {
            return Equal;
        }
    }
}

// false sorts before true.
pub fn compare_bool(left: bool, right: bool) -> Ordering {
    if (left == right) {
        return Equal;
    } else {
        if (!left) {
            return Less;
        } else {
            return Greater;
        }
    }
}

// NaN has no ordering. Return the supplied fallback when either input is NaN.
pub fn compare_f32_or(left: f32, right: f32, fallback: Ordering) -> Ordering {
    if (left != left || right != right) { return fallback; }
    if (left < right) { return Less; }
    if (left > right) { return Greater; }
    return Equal;
}

pub fn compare_wide_u64(
    left: core::wide_u64::WideU64,
    right: core::wide_u64::WideU64
) -> Ordering {
    let relation: i32 = core::wide_u64::compare(left, right);
    if (relation < 0) { return Less; }
    if (relation > 0) { return Greater; }
    return Equal;
}

pub fn compare_wide_i64(
    left: core::wide_i64::WideI64,
    right: core::wide_i64::WideI64
) -> Ordering {
    let relation: i32 = core::wide_i64::compare(left, right);
    if (relation < 0) { return Less; }
    if (relation > 0) { return Greater; }
    return Equal;
}

pub fn reverse(ordering: Ordering) -> Ordering {
    return match (ordering) {
        Less -> Greater,
        Equal -> Equal,
        Greater -> Less,
    };
}

pub fn then(ordering: Ordering, next: Ordering) -> Ordering {
    if (is_equal(ordering)) {
        return next;
    } else {
        return ordering;
    }
}

pub fn to_i32(ordering: Ordering) -> i32 {
    return match (ordering) {
        Less -> -1,
        Equal -> 0,
        Greater -> 1,
    };
}

pub fn is_less(ordering: Ordering) -> bool {
    return match (ordering) {
        Less -> true,
        Equal -> false,
        Greater -> false,
    };
}

pub fn is_equal(ordering: Ordering) -> bool {
    return match (ordering) {
        Less -> false,
        Equal -> true,
        Greater -> false,
    };
}

pub fn is_greater(ordering: Ordering) -> bool {
    return match (ordering) {
        Less -> false,
        Equal -> false,
        Greater -> true,
    };
}

pub fn is_less_or_equal(ordering: Ordering) -> bool {
    return !is_greater(ordering);
}

pub fn is_greater_or_equal(ordering: Ordering) -> bool {
    return !is_less(ordering);
}

pub fn is_not_equal(ordering: Ordering) -> bool {
    return !is_equal(ordering);
}
