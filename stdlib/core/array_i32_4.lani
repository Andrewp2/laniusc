// Module-form helpers for fixed-size [i32; 4] arrays.
module core::array_i32_4;
import core::i32;
pub fn len() -> i32 {
    return 4;
}
pub fn is_empty() -> bool {
    return false;
}
pub fn first(values:[i32; 4]) -> i32 {
    return values[0];
}
pub fn last(values:[i32; 4]) -> i32 {
    return values[3];
}
// Destination must contain at least four writable elements. A supplied
// length below four returns false without writing; overstating the physical
// view can trap on native indexing.
pub fn copy_into(values:[i32; 4], destination:[i32], destination_len: i32) -> bool {
    if (destination_len<4) {
        return false;
    }
    let first: i32 = values[0];
    let second: i32 = values[1];
    let third: i32 = values[2];
    let fourth: i32 = values[3];
    destination[0] = first;
    destination[1] = second;
    destination[2] = third;
    destination[3] = fourth;
    return true;
}
pub fn fill(value: i32, destination:[i32], destination_len: i32) -> bool {
    if (destination_len<4) {
        return false;
    }
    destination[0] = value;
    destination[1] = value;
    destination[2] = value;
    destination[3] = value;
    return true;
}
// Captures all source values before writing, so source and destination may
// refer to the same backing array.
pub fn reverse_into(values:[i32; 4], destination:[i32], destination_len: i32) -> bool {
    if (destination_len<4) {
        return false;
    }
    let first: i32 = values[3];
    let second: i32 = values[2];
    let third: i32 = values[1];
    let fourth: i32 = values[0];
    destination[0] = first;
    destination[1] = second;
    destination[2] = third;
    destination[3] = fourth;
    return true;
}
pub fn sum(values:[i32; 4]) -> i32 {
    let index: i32 = 0;
    let total: i32 = 0;
    while (index<4) {
        total = core::i32::saturating_add(total, values[index]);
        index += 1;
    }
    return total;
}
pub fn min(values:[i32; 4]) -> i32 {
    let index: i32 = 1;
    let best: i32 = values[0];
    while (index<4) {
        if (values[index]<best) {
            best = values[index];
        }
        index += 1;
    }
    return best;
}
pub fn max(values:[i32; 4]) -> i32 {
    let index: i32 = 1;
    let best: i32 = values[0];
    while (index<4) {
        if (values[index]>best) {
            best = values[index];
        }
        index += 1;
    }
    return best;
}
pub fn get_or(values:[i32; 4], index: i32, fallback: i32) -> i32 {
    if (index == 0) {
        return values[0];
    } else {
        if (index == 1) {
            return values[1];
        } else {
            if (index == 2) {
                return values[2];
            } else {
                if (index == 3) {
                    return values[3];
                } else {
                    return fallback;
                }
            }
        }
    }
}
pub fn contains(values:[i32; 4], needle: i32) -> bool {
    let index: i32 = 0;
    while (index<4) {
        if (values[index] == needle) {
            return true;
        }
        index += 1;
    }
    return false;
}
pub fn count(values:[i32; 4], needle: i32) -> i32 {
    let index: i32 = 0;
    let total: i32 = 0;
    while (index<4) {
        if (values[index] == needle) {
            total += 1;
        }
        index += 1;
    }
    return total;
}
pub fn index_of_or(values:[i32; 4], needle: i32, fallback: i32) -> i32 {
    let index: i32 = 0;
    while (index<4) {
        if (values[index] == needle) {
            return index;
        }
        index += 1;
    }
    return fallback;
}
