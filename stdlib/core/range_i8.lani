// Allocation-free signed 8-bit scalar and concrete aggregate ranges.
module core::range_i8;

// Half-open [start, end). Equal or reversed bounds are empty.
pub fn half_open_is_empty(start: i8, end: i8) -> bool {
    return start >= end;
}

pub fn half_open_contains(start: i8, end: i8, value: i8) -> bool {
    return value >= start && value < end;
}

pub fn half_open_overlaps(left_start: i8, left_end: i8, right_start: i8, right_end: i8) -> bool {
    return left_start < left_end && right_start < right_end &&
        left_start < right_end && right_start < left_end;
}

// Inclusive [start, end]. Equal bounds contain exactly one value.
pub fn inclusive_is_empty(start: i8, end: i8) -> bool {
    return start > end;
}

pub fn inclusive_contains(start: i8, end: i8, value: i8) -> bool {
    return value >= start && value <= end;
}

pub fn inclusive_overlaps(left_start: i8, left_end: i8, right_start: i8, right_end: i8) -> bool {
    return left_start <= left_end && right_start <= right_end &&
        left_start <= right_end && right_start <= left_end;
}

pub fn from_contains(start: i8, value: i8) -> bool {
    return value >= start;
}

pub fn to_contains(end: i8, value: i8) -> bool {
    return value < end;
}

// A full signed 8-bit range contains every i8 value.
pub fn full_contains(value: i8) -> bool {
    return true;
}

// Caller-owned concrete range values for this width. Scalar predicates above
// remain convenient when no aggregate needs to cross a function boundary.
pub struct RangeI8 { start: i8, end: i8, }
pub struct RangeInclusiveI8 { start: i8, end: i8, }
pub struct RangeFromI8 { start: i8, }
pub struct RangeToI8 { end: i8, }

pub fn range(start: i8, end: i8) -> RangeI8 {
    return RangeI8 { start: start, end: end };
}
pub fn start(value: RangeI8) -> i8 { return value.start; }
pub fn end(value: RangeI8) -> i8 { return value.end; }
pub fn is_empty(value: RangeI8) -> bool {
    return half_open_is_empty(value.start, value.end);
}
pub fn contains(value: RangeI8, item: i8) -> bool {
    return half_open_contains(value.start, value.end, item);
}
pub fn overlaps(left: RangeI8, right: RangeI8) -> bool {
    return half_open_overlaps(left.start, left.end, right.start, right.end);
}

pub fn range_inclusive(start: i8, end: i8) -> RangeInclusiveI8 {
    return RangeInclusiveI8 { start: start, end: end };
}
pub fn start_inclusive(value: RangeInclusiveI8) -> i8 { return value.start; }
pub fn end_inclusive(value: RangeInclusiveI8) -> i8 { return value.end; }
pub fn is_empty_inclusive(value: RangeInclusiveI8) -> bool {
    return inclusive_is_empty(value.start, value.end);
}
pub fn contains_inclusive(value: RangeInclusiveI8, item: i8) -> bool {
    return inclusive_contains(value.start, value.end, item);
}
pub fn overlaps_inclusive(left: RangeInclusiveI8, right: RangeInclusiveI8) -> bool {
    return inclusive_overlaps(left.start, left.end, right.start, right.end);
}

pub fn range_from(start: i8) -> RangeFromI8 {
    return RangeFromI8 { start: start };
}
pub fn start_from(value: RangeFromI8) -> i8 { return value.start; }
pub fn contains_from(value: RangeFromI8, item: i8) -> bool {
    return from_contains(value.start, item);
}

pub fn range_to(end: i8) -> RangeToI8 {
    return RangeToI8 { end: end };
}
pub fn end_to(value: RangeToI8) -> i8 { return value.end; }
pub fn contains_to(value: RangeToI8, item: i8) -> bool {
    return to_contains(value.end, item);
}

pub impl RangeI8 {
    pub fn start(&self) -> i8 { return self.start; }
    pub fn end(&self) -> i8 { return self.end; }
    pub fn is_empty(&self) -> bool {
        return half_open_is_empty(self.start, self.end);
    }
    pub fn contains(&self, item: i8) -> bool {
        return half_open_contains(self.start, self.end, item);
    }
    pub fn overlaps(&self, other: RangeI8) -> bool {
        return half_open_overlaps(self.start, self.end, other.start, other.end);
    }
}

pub impl RangeInclusiveI8 {
    pub fn start(&self) -> i8 { return self.start; }
    pub fn end(&self) -> i8 { return self.end; }
    pub fn is_empty(&self) -> bool {
        return inclusive_is_empty(self.start, self.end);
    }
    pub fn contains(&self, item: i8) -> bool {
        return inclusive_contains(self.start, self.end, item);
    }
    pub fn overlaps(&self, other: RangeInclusiveI8) -> bool {
        return inclusive_overlaps(self.start, self.end, other.start, other.end);
    }
}

pub impl RangeFromI8 {
    pub fn start(&self) -> i8 { return self.start; }
    pub fn contains(&self, item: i8) -> bool {
        return from_contains(self.start, item);
    }
}

pub impl RangeToI8 {
    pub fn end(&self) -> i8 { return self.end; }
    pub fn contains(&self, item: i8) -> bool {
        return to_contains(self.end, item);
    }
}
