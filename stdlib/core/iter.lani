// Allocation-free shared iteration. Native x86_64 Linux contracts execute via
// the GPU compiler; see docs/stdlib-iterators.md. The predecessor is retained at
// tests/fixtures/stdlib_foundation/iterator_dependency/prototype/core/iter.lani.
//
// Iterator implementations are fused: after None, every later next is None.
// Items are shallow copies; source APIs can explicitly transfer cleanup
// authority, but the protocol never clones or destroys them automatically.
// Cursors and backing storage must outlive borrowed adapters. Borrowed leaf
// copies fork position; owning cursors require one active handle. Adapter
// copies share upstream references. Discarded transferred owners can leak;
// owning-cursor Destroy helpers cannot recover items no longer in the source.
module core::iter;
import core::clone_values;
import core::cmp;
import core::option;
import core::ordering;
import core::pair;
import core::panic;
import core::range;
import core::result;
import core::slice;

pub trait Iterator<T> {
    pub fn next(&self) -> core::option::Option<T>;
}

// Implement alongside Iterator<T>. Front and back consume the same remaining
// sequence without crossing. None from either end permanently exhausts both.
// Generic users name BOTH bounds explicitly; no implicit supertrait is used.
pub trait DoubleEndedIterator<T> {
    pub fn next_back(&self) -> core::option::Option<T>;
}

// Exact successful yields remaining before fused None, in the valid current
// cursor state. Implement beside Iterator<T>; generic users name both bounds.
// Query only metadata/upstream counts: no pulls, callbacks, item reads, cleanup,
// allocation or host calls. This safe behavioral contract grants no permission
// for unchecked access. External mutation can change the count between calls.
pub trait ExactSizeIterator<T> {
    pub fn remaining_count(&self) -> u64;
}

// A source-defined callback, with ordinary shallow input/output values. The
// caller keeps the mapper and any borrowed mutable context alive. Output
// cleanup authority remains with the application; no Destroy is implied.
pub trait Mapper<T, U> {
    pub fn apply(&self, value: T) -> U;
}

// Retirement transfers one exhausted inner by value. None consumes all its
// backing cleanup authority. Some returns the ACTUAL updated recoverable inner
// and a separately transferred error; no rollback or implicit Destroy occurs.
// Never retain or operate an older shallow copy after handing inner over.
pub struct RetireFailure<J,E> { inner: J, error: E }
pub trait InnerRetirement<J,E> {
    pub fn try_retire(&self, inner: J) -> core::option::Option<RetireFailure<J,E>>;
}

// Left-fold callbacks receive the accumulator first. Replaced accumulators
// and consumed items are shallow values; keep their cleanup authority outside
// the fold when a callback omits them from its returned value.
pub trait Folder<A, T> {
    pub fn apply(&self, accumulator: A, value: T) -> A;
}

// Err stops after the current item, without another source call or rollback.
// The error need not contain the old accumulator; no Destroy is implicit.
pub trait TryFolder<A, T, E> {
    pub fn try_apply(&self, accumulator: A, value: T) -> core::result::Result<A, E>;
}

// Compare shallow values under a consistent total ordering. Reductions pass
// the current winner first and the next source item second.
pub trait Comparator<T> {
    pub fn compare(&self, left: T, right: T) -> core::ordering::Ordering;
}

// A fallible destination for one shallow item. None accepts the item; Some
// rejects it with an error. On rejection the sink must not retain the item or
// publish a partial insertion. Instrumentation may record the failed attempt.
// Acceptance never implies an implicit clone or destruction of nested owners.
pub trait TrySink<T, E> {
    pub fn try_accept(&self, item: T) -> core::option::Option<E>;
}

// A checked replacement destination for one complete shallow item. Err leaves
// incoming cleanup authority with caller and publishes no partial insertion.
// Ok(None) stores a new item; Ok(Some(old)) stores the incoming item and returns
// the complete displaced owner. No clone/Destroy or rollback is implicit.
pub trait TryReplaceSink<T,E> {
    pub fn try_replace_item(&self, item: T) -> core::result::Result<core::option::Option<T>,E>;
}

// Relative to this call only: replaced <= committed. A displaced-delivery
// failure includes its CURRENT committed replacement in both counters.
pub struct ReplacementProgress { committed: u64, replaced: u64 }
pub struct ReplacementTransfer { progress: ReplacementProgress, exhausted: bool }
pub enum ReplacementFailure<T,RE,DE> {
    // Destination rejected this incoming T; no current commit occurred.
    Rejected(ReplacementProgress,T,RE),
    // Replacement committed. This T is the OLD item, rejected by delivery.
    Undelivered(ReplacementProgress,T,DE),
}

// A transfer stops at the quota without probing again. exhausted means an
// actual None was observed, not that a quota-ending source is known nonempty.
pub struct Transfer { accepted: u64, exhausted: bool }

// The source has consumed rejected, but the sink has not retained it. Recover
// or release it before resuming the source; the accepted prefix remains in the
// destination. accepted counts only this call, not the sink's earlier entries.
pub struct TransferError<T, E> { accepted: u64, rejected: T, error: E }

pub struct Empty<T> {}
pub struct Once<T> { value: T, done: bool }
pub struct Repeat<T> { value: T }
// Borrow the actual cursor; no ownership transfer, cache or eager source pull.
// One done flag fuses both directions, including for a faulty unfused source.
pub struct Rev<I,T> { source: &I, done: bool }
pub enum PeekableError { Cached }
// cached Some(None) for an optional item is distinct from an absent cache.
// Keep one active ownership-bearing handle; copies grant no cleanup authority.
pub struct Peekable<I,T> { source: &I, cached: core::option::Option<T>, done: bool }
pub enum StepError { Zero }
pub struct StepBy<I, T> { source: &I, skip: u64, first: bool, done: bool }
pub struct RangeI32 { position: i64, end: i64 }
pub struct Take<I, T> { source: &I, remaining: u64, done: bool }
pub struct Chain<A, B, T> { left: &A, right: &B, left_done: bool, right_done: bool, done: bool }
pub struct Map<I, M, T, U> { source: &I, mapper: &M, done: bool }
// Scan callbacks hold their own state. None stops, unlike FilterMap's skip.
// Keep source/mapper/state alive and do not reenter from a source or callback.
pub struct Scan<I,M,T,U> { source: &I, mapper: &M, done: bool }
pub struct TryScan<I,M,T,U,E> { source: &I, mapper: &M, done: bool }
pub enum NestedFinishError { Active }
// One active manual owner, initially absent; no default J or eager outer pull.
// Copies alias cleanup authority. Recover active before abandoning an adapter.
// Borrowed yielded items must not outlive inner backing retired by later next.
// Source, mapper and retirement callbacks must not reenter the adapter.
struct NestedState<J> { active: core::option::Option<J>, done: bool }
pub struct TryFlatten<I,J,R,T,E> { source: &I, retirement: &R, state: NestedState<J> }
pub struct TryFlatMap<I,M,R,S,J,T,E> { source: &I, mapper: &M, retirement: &R, state: NestedState<J> }
// Ordinary facades require a genuinely infallible retirement policy. They use
// the same state/traversal and manual-owner rules as their Try counterparts.
pub struct Flatten<I,J,R,T> { source: &I, retirement: &R, state: NestedState<J> }
pub struct FlatMap<I,M,R,S,J,T> { source: &I, mapper: &M, retirement: &R, state: NestedState<J> }
struct NestedIdentity<J,E> {}
struct NestedLift<M,S,J> { mapper: &M }
pub struct Zip<A, B, T, U> { left: &A, right: &B, done: bool }
pub struct Enumerate<I, T> { source: &I, next_index: u64, max_used: bool, done: bool }
pub struct Filter<I, P, T> { source: &I, predicate: &P, done: bool }
pub struct FilterMap<I, M, T, U> { source: &I, mapper: &M, done: bool }
pub struct Skip<I, T> { source: &I, remaining: u64, done: bool }
pub struct TakeWhile<I, P, T> { source: &I, predicate: &P, done: bool }
pub struct SkipWhile<I, P, T> { source: &I, predicate: &P, skipping: bool, done: bool }
pub struct Advance { advanced: u64, exhausted: bool }

pub fn empty<T>() -> Empty<T> { return Empty {}; }

// The stored value and every cursor copy are shallow. Copying this leaf forks
// its one-item availability, without creating another cleanup authority.
pub fn once<T>(value: T) -> Once<T> { return Once { value: value, done: false }; }

// Yield the same shallow value forever. Bound consumption with Take. A
// transferred memory owner cannot be repeated safely unless the application
// keeps a separate cleanup authority and treats yielded handles as aliases.
pub fn repeat<T>(value: T) -> Repeat<T> { return Repeat { value: value }; }

// Reverse the remaining sequence. Keep source and its backing alive, and end
// use of this adapter before recovering/freeing its source. Item cleanup stays
// with the caller; abandoning Rev neither drains nor destroys anything.
pub fn rev<I,T>(source: &I) -> Rev<I,T>
    where I: Iterator<T>, I: DoubleEndedIterator<T> {
    return Rev { source: source, done: false };
}

// Lazy construction: no source call and no allocation. The source object and
// its backing must outlive this adapter and all borrowed observations.
pub fn peekable<I,T>(source: &I) -> Peekable<I,T> where I: Iterator<T> {
    return Peekable { source: source, cached: core::option::None(), done: false };
}

// Construction never polls. First next pulls one item; later calls discard
// step-1 successful items before pulling the result. Stop at the first None,
// even for MAX, and never poll the source again through this adapter.
pub fn step_by<I, T>(source: &I, step: u64)
    -> core::result::Result<StepBy<I, T>, StepError> where I: Iterator<T> {
    if (step == 0) { return core::result::Err(StepError::Zero); }
    let selected: StepBy<I, T> = StepBy { source: source, skip: step - 1, first: true, done: false };
    return core::result::Ok(selected);
}

// Check logical metadata only. values must physically back count elements.
pub fn from_slice<T>(values: [T], count: i32)
    -> core::result::Result<core::slice::Iter<T>, core::slice::ViewError> {
    let view: core::slice::View<T> = core::slice::View { values: values, start: 0, length: count };
    return from_view<T>(view);
}

// Public View fields can be forged, so recheck their integer invariants before
// constructing a cursor. This neither reads elements nor proves physical bounds.
pub fn from_view<T>(view: core::slice::View<T>)
    -> core::result::Result<core::slice::Iter<T>, core::slice::ViewError> {
    if (view.start < 0 || view.length < 0 || view.start > 2147483647 - view.length) {
        return core::result::Err(core::slice::ViewError::Bounds);
    }
    let cursor: core::slice::Iter<T> = view.iter();
    return core::result::Ok(cursor);
}

// Capture finite ascending unit-step bounds; reversed bounds are empty.
pub fn range_i32(bounds: core::range::Range<i32>) -> RangeI32 {
    let position: i64 = core::range::start(bounds) as i64;
    let end: i64 = core::range::end(bounds) as i64;
    if (position > end) { position = end; }
    return RangeI32 { position: position, end: end };
}

pub fn range_i32_inclusive(bounds: core::range::RangeInclusive<i32>) -> RangeI32 {
    let position: i64 = core::range::start_inclusive(bounds) as i64;
    let last: i64 = core::range::end_inclusive(bounds) as i64;
    // Widen before adding one: MAX + 1 is a valid i64 sentinel.
    let end: i64 = last + 1;
    if (position > end) { position = end; }
    return RangeI32 { position: position, end: end };
}

pub fn take<I, T>(source: &I, count: u64) -> Take<I, T> where I: Iterator<T> {
    return Take { source: source, remaining: count, done: false };
}

pub fn chain<A, B, T>(left: &A, right: &B) -> Chain<A, B, T>
    where A: Iterator<T>, B: Iterator<T> {
    return Chain { left: left, right: right, left_done: false, right_done: false, done: false };
}

pub fn map<I, M, T, U>(source: &I, mapper: &M) -> Map<I, M, T, U>
    where I: Iterator<T>, M: Mapper<T, U> {
    return Map { source: source, mapper: mapper, done: false };
}

// Lazy construction. Each next pulls at most one item and calls the borrowed
// stateful mapper at most once. A callback None consumes that item and fuses.
// Consumed items/replaced callback state retain application cleanup policy.
pub fn scan<I,M,T,U>(source: &I, mapper: &M) -> Scan<I,M,T,U>
    where I: Iterator<T>, M: Mapper<T,core::option::Option<U>> {
    return Scan { source: source, mapper: mapper, done: false };
}

// An error is one Some(Err), followed only by None. No extra source poll,
// callback invocation, rollback, allocation or automatic error destruction.
pub fn try_scan<I,M,T,U,E>(source: &I, mapper: &M) -> TryScan<I,M,T,U,E>
    where I: Iterator<T>, M: Mapper<T,core::result::Result<core::option::Option<U>,E>> {
    return TryScan { source: source, mapper: mapper, done: false };
}

// Caller keeps the outer and retirement policy alive. One next may cross many
// empty inners; bound the outer itself when that work must be finite. A Take
// downstream does not bound empty-inner acquisition or retirement work.
// Constructors allocate nothing and invoke no source or callback.
pub fn try_flatten<I,J,R,T,E>(source: &I, retirement: &R) -> TryFlatten<I,J,R,T,E>
    where I: Iterator<J>, J: Iterator<T>, R: InnerRetirement<J,E> {
    let state: NestedState<J> = NestedState { active: core::option::None(), done: false };
    return TryFlatten { source: source, retirement: retirement, state: state };
}

// Mapper errors consume their current outer item, yield once and fuse with no
// active inner. Mapper owns cleanup of any partial construction on failure.
// A returned inner cannot borrow mapper call-local backing. Source/mapper/
// policy and all externally borrowed backing must outlive their uses here.
pub fn try_flat_map<I,M,R,S,J,T,E>(source: &I, mapper: &M, retirement: &R) -> TryFlatMap<I,M,R,S,J,T,E>
    where I: Iterator<S>, M: Mapper<S,core::result::Result<J,E>>,
        J: Iterator<T>, R: InnerRetirement<J,E> {
    let state: NestedState<J> = NestedState { active: core::option::None(), done: false };
    return TryFlatMap { source: source, mapper: mapper, retirement: retirement, state: state };
}

// No eager pull/allocation/default J. Infallible is the existing empty enum,
// not an inhabited sentinel. Policies with reportable cleanup errors must use
// try_flatten; an ordinary policy may not silently ignore such a failure.
pub fn flatten<I,J,R,T>(source: &I, retirement: &R) -> Flatten<I,J,R,T>
    where I: Iterator<J>, J: Iterator<T>, R: InnerRetirement<J,core::clone_values::Infallible> {
    let state: NestedState<J> = NestedState { active: core::option::None(), done: false };
    return Flatten { source: source, retirement: retirement, state: state };
}

// Mapper returns J directly; fallible construction belongs to try_flat_map.
// Caller owns mapper/state/backing lifetime. Returned J cannot borrow temporary
// call-local storage. Empty-inner work, nonreentry and yielded-borrow lifetimes
// are identical to try_flatten/try_flat_map, including explicit early recovery.
pub fn flat_map<I,M,R,S,J,T>(source: &I, mapper: &M, retirement: &R) -> FlatMap<I,M,R,S,J,T>
    where I: Iterator<S>, M: Mapper<S,J>, J: Iterator<T>,
        R: InnerRetirement<J,core::clone_values::Infallible> {
    let state: NestedState<J> = NestedState { active: core::option::None(), done: false };
    return FlatMap { source: source, mapper: mapper, retirement: retirement, state: state };
}

// Selection callbacks reuse Mapper: bool selects an original shallow item,
// Option<U> either skips it or yields U. A next call can scan arbitrarily many
// source items; put Take upstream to bound source pulls. Construction is lazy.
pub fn filter<I, P, T>(source: &I, predicate: &P) -> Filter<I, P, T>
    where I: Iterator<T>, P: Mapper<T, bool> {
    return Filter { source: source, predicate: predicate, done: false };
}

pub fn filter_map<I, M, T, U>(source: &I, mapper: &M) -> FilterMap<I, M, T, U>
    where I: Iterator<T>, M: Mapper<T, core::option::Option<U>> {
    return FilterMap { source: source, mapper: mapper, done: false };
}

// Skip exactly count successful items before yielding. No integer narrowing
// or count+1 is needed, even for MAX. A finite short source ends on one None.
pub fn skip<I, T>(source: &I, count: u64) -> Skip<I, T> where I: Iterator<T> {
    return Skip { source: source, remaining: count, done: false };
}

// The first false item is consumed. TakeWhile then latches None permanently.
pub fn take_while<I, P, T>(source: &I, predicate: &P) -> TakeWhile<I, P, T>
    where I: Iterator<T>, P: Mapper<T, bool> {
    return TakeWhile { source: source, predicate: predicate, done: false };
}

// Yield the first false item; after that, never query the predicate again.
pub fn skip_while<I, P, T>(source: &I, predicate: &P) -> SkipWhile<I, P, T>
    where I: Iterator<T>, P: Mapper<T, bool> {
    return SkipWhile { source: source, predicate: predicate, skipping: true, done: false };
}

// Pull left before right. If right ends, the successful left value has already
// been consumed and receives no implicit destruction. Keep an application
// cleanup authority for owner handles that can pass through either source.
pub fn zip<A, B, T, U>(left: &A, right: &B) -> Zip<A, B, T, U>
    where A: Iterator<T>, B: Iterator<U> {
    return Zip { left: left, right: right, done: false };
}

pub fn enumerate<I, T>(source: &I) -> Enumerate<I, T> where I: Iterator<T> {
    return enumerate_from<I, T>(source, 0);
}

// first_index labels the first item; it does not skip source items. MAX is a
// valid last index. A later Some is consumed and then panics; a later None is
// ordinary exhaustion. The extra flag avoids forming MAX + 1.
pub fn enumerate_from<I, T>(source: &I, first_index: u64) -> Enumerate<I, T>
    where I: Iterator<T> {
    return Enumerate { source: source, next_index: first_index, max_used: false, done: false };
}

// Searches consume their matching item and make no extra EOF probe. No match
// requires exhausting the source. Callbacks receive ordinary shallow values.
pub fn find<I, P, T>(source: &I, predicate: &P) -> core::option::Option<T>
    where I: Iterator<T>, P: Mapper<T, bool> {
    while (true) {
        let item: core::option::Option<T> = source.next();
        if (core::option::is_none(item)) { return item; }
        let value: T = core::option::unwrap(item);
        let selected: bool = predicate.apply(value);
        if (selected) { return item; }
    }
    return core::option::None();
}

pub fn find_map<I, M, T, U>(source: &I, mapper: &M) -> core::option::Option<U>
    where I: Iterator<T>, M: Mapper<T, core::option::Option<U>> {
    while (true) {
        let item: core::option::Option<T> = source.next();
        if (core::option::is_none(item)) { return core::option::None(); }
        let value: T = core::option::unwrap(item);
        let mapped: core::option::Option<U> = mapper.apply(value);
        if (core::option::is_some(mapped)) { return mapped; }
    }
    return core::option::None();
}

// The result is relative to this call's remaining source, not its original
// beginning. Consume the match without another poll; skipped owners receive
// no implicit destruction. The predicate/caller retains their cleanup policy.
pub fn position<I,P,T>(source: &I, predicate: &P) -> core::option::Option<u64>
    where I: Iterator<T>, P: Mapper<T,bool> {
    return position_from<I,P,T>(source,predicate,0);
}

// Label the first item without skipping it. MAX is valid; after an unmatched
// MAX, None is ordinary EOF but another Some is consumed then panics before
// its predicate call. Match Enumerate's checked policy without MAX+1/wrapping.
pub fn position_from<I,P,T>(source: &I, predicate: &P, first_index: u64) -> core::option::Option<u64>
    where I: Iterator<T>, P: Mapper<T,bool> {
    let index: u64 = first_index;
    let max_used: bool = false;
    while (true) {
        let item: core::option::Option<T> = source.next();
        if (item.is_none()) { return core::option::None(); }
        if (max_used) { core::panic::panic(); }
        if (predicate.apply(item.unwrap())) { return core::option::Some(index); }
        if (index == 18446744073709551615) { max_used = true; }
        else { index += 1; }
    }
    return core::option::None();
}

// Consume through the first None. Empty is None; min keeps the first tied
// representative and max the last. Values not returned remain ordinary
// shallow values: no implicit clone/destruction of discarded owners occurs.
pub fn min<I,T>(source: &I) -> core::option::Option<T> where I: Iterator<T>, T: core::cmp::Ord<T> {
    let first: core::option::Option<T> = source.next();
    if (first.is_none()) { return first; }
    let winner: T = first.unwrap();
    while (true) {
        let item: core::option::Option<T> = source.next();
        if (item.is_none()) { return core::option::Some(winner); }
        let value: T = item.unwrap();
        if (T::gt(winner,value)) { winner = value; }
    }
    return core::option::Some(winner);
}

pub fn max<I,T>(source: &I) -> core::option::Option<T> where I: Iterator<T>, T: core::cmp::Ord<T> {
    let first: core::option::Option<T> = source.next();
    if (first.is_none()) { return first; }
    let winner: T = first.unwrap();
    while (true) {
        let item: core::option::Option<T> = source.next();
        if (item.is_none()) { return core::option::Some(winner); }
        let value: T = item.unwrap();
        if (T::le(winner,value)) { winner = value; }
    }
    return core::option::Some(winner);
}

// Exactly n-1 callback calls for n nonempty inputs, in (winner,new) order.
// Comparison callbacks borrow their shallow arguments; they must preserve the
// values needed by later calls/result. Source/callback work can be unbounded.
pub fn min_by<I,C,T>(source: &I, comparator: &C) -> core::option::Option<T>
    where I: Iterator<T>, C: Comparator<T> {
    let first: core::option::Option<T> = source.next();
    if (first.is_none()) { return first; }
    let winner: T = first.unwrap();
    while (true) {
        let item: core::option::Option<T> = source.next();
        if (item.is_none()) { return core::option::Some(winner); }
        let value: T = item.unwrap();
        let replace: bool = match (comparator.compare(winner,value)) {
            core::ordering::Ordering::Greater -> true, _ -> false
        };
        if (replace) { winner = value; }
    }
    return core::option::Some(winner);
}

pub fn max_by<I,C,T>(source: &I, comparator: &C) -> core::option::Option<T>
    where I: Iterator<T>, C: Comparator<T> {
    let first: core::option::Option<T> = source.next();
    if (first.is_none()) { return first; }
    let winner: T = first.unwrap();
    while (true) {
        let item: core::option::Option<T> = source.next();
        if (item.is_none()) { return core::option::Some(winner); }
        let value: T = item.unwrap();
        let replace: bool = match (comparator.compare(winner,value)) {
            core::ordering::Ordering::Less -> true, core::ordering::Ordering::Equal -> true, _ -> false
        };
        if (replace) { winner = value; }
    }
    return core::option::Some(winner);
}

// Empty identities are false for any and true for all. A decisive predicate
// result consumes its item and returns immediately, leaving the rest untouched.
pub fn any<I, P, T>(source: &I, predicate: &P) -> bool
    where I: Iterator<T>, P: Mapper<T, bool> {
    while (true) {
        let item: core::option::Option<T> = source.next();
        if (core::option::is_none(item)) { return false; }
        let value: T = core::option::unwrap(item);
        let selected: bool = predicate.apply(value);
        if (selected) { return true; }
    }
    return false;
}

pub fn all<I, P, T>(source: &I, predicate: &P) -> bool
    where I: Iterator<T>, P: Mapper<T, bool> {
    while (true) {
        let item: core::option::Option<T> = source.next();
        if (core::option::is_none(item)) { return true; }
        let value: T = core::option::unwrap(item);
        let selected: bool = predicate.apply(value);
        if (!selected) { return false; }
    }
    return true;
}

// Fold left in source order. Arithmetic and callback errors are callback
// policy; ordinary fold introduces no arithmetic, clones or destruction.
pub fn fold<I, F, T, A>(source: &I, initial: A, folder: &F) -> A
    where I: Iterator<T>, F: Folder<A, T> {
    let accumulator: A = initial;
    while (true) {
        let item: core::option::Option<T> = source.next();
        if (core::option::is_none(item)) { return accumulator; }
        let value: T = core::option::unwrap(item);
        accumulator = folder.apply(accumulator, value);
    }
    return accumulator;
}

pub fn try_fold<I, F, T, A, E>(source: &I, initial: A, folder: &F)
    -> core::result::Result<A, E> where I: Iterator<T>, F: TryFolder<A, T, E> {
    let accumulator: A = initial;
    while (true) {
        let item: core::option::Option<T> = source.next();
        if (core::option::is_none(item)) { return core::result::Ok(accumulator); }
        let value: T = core::option::unwrap(item);
        let step: core::result::Result<A, E> = folder.try_apply(accumulator, value);
        if (core::result::is_err(step)) { return step; }
        accumulator = core::result::unwrap(step);
    }
    return core::result::Ok(accumulator);
}

// At most limit source.next calls, each Some followed by one sink attempt.
// A zero quota touches neither object. An error stops immediately and returns
// the rejected item; successful earlier insertions are not rolled back. The
// source and sink must not invalidate each other's storage or borrowed views.
// A next or callback can do unbounded work internally; quota counts calls only.
pub fn try_transfer_up_to<I, S, T, E>(source: &I, sink: &S, limit: u64)
    -> core::result::Result<Transfer, TransferError<T, E>>
    where I: Iterator<T>, S: TrySink<T, E> {
    let accepted: u64 = 0;
    while (accepted < limit) {
        let item: core::option::Option<T> = source.next();
        if (core::option::is_none(item)) {
            return core::result::Ok(Transfer { accepted: accepted, exhausted: true });
        }
        let value: T = core::option::unwrap(item);
        let failed: core::option::Option<E> = sink.try_accept(value);
        if (core::option::is_some(failed)) {
            let error: E = core::option::unwrap(failed);
            return core::result::Err(TransferError { accepted: accepted, rejected: value, error: error });
        }
        // accepted < limit <= u64::MAX, so this increment cannot overflow.
        accepted += 1;
    }
    return core::result::Ok(Transfer { accepted: accepted, exhausted: false });
}

// At most limit immediate source calls/replacement attempts. Each old item is
// delivered once through the existing TrySink contract before another pull.
// Zero touches no object; a quota stop never probes for EOF. One next/hash/
// callback may do unbounded work internally, outside this immediate-call quota.
//
// Rejected returns the incoming owner: retry/release it before source resume.
// Undelivered returns the OLD owner after the incoming replacement committed:
// retry only its delivery, retain it elsewhere or release it, not replacement.
// Earlier commits/deliveries are never rolled back. Returned errors/items and
// stored inputs keep their shallow cleanup authority; nothing is destroyed.
// Caller also retains an owning source's remainder and exhausted backing.
//
// Keep source/destinations/backing alive and separate. No borrowed source into
// either mutating destination; callbacks must not reenter or mutate peers.
// A delivery error must neither retain old nor publish a partial insertion.
// Partial-output writers cannot claim this rejection contract. This helper
// itself performs no allocation or host work; callbacks own their effects.
pub fn try_replace_up_to<I,R,D,T,RE,DE>(source: &I, replacement: &R, displaced: &D, limit: u64)
    -> core::result::Result<ReplacementTransfer,ReplacementFailure<T,RE,DE>>
    where I: Iterator<T>, R: TryReplaceSink<T,RE>, D: TrySink<T,DE> {
    let committed: u64 = 0;
    let replaced: u64 = 0;
    while (committed < limit) {
        let item: core::option::Option<T> = source.next();
        if (item.is_none()) {
            let progress: ReplacementProgress = ReplacementProgress { committed: committed, replaced: replaced };
            return core::result::Ok(ReplacementTransfer { progress: progress, exhausted: true });
        }
        let value: T = item.unwrap();
        let stored: core::result::Result<core::option::Option<T>,RE> = replacement.try_replace_item(value);
        if (stored.is_err()) {
            let progress: ReplacementProgress = ReplacementProgress { committed: committed, replaced: replaced };
            let failure: ReplacementFailure<T,RE,DE> = ReplacementFailure::Rejected(progress,value,stored.unwrap_err());
            return core::result::Err(failure);
        }
        // committed < limit <= MAX. replaced <= old committed, so either
        // increment remains <= the new committed count without MAX+1.
        committed += 1;
        let previous: core::option::Option<T> = stored.unwrap();
        if (previous.is_some()) {
            replaced += 1;
            let old: T = previous.unwrap();
            let failed: core::option::Option<DE> = displaced.try_accept(old);
            if (failed.is_some()) {
                let progress: ReplacementProgress = ReplacementProgress { committed: committed, replaced: replaced };
                let failure: ReplacementFailure<T,RE,DE> = ReplacementFailure::Undelivered(progress,old,failed.unwrap());
                return core::result::Err(failure);
            }
        }
    }
    let progress: ReplacementProgress = ReplacementProgress { committed: committed, replaced: replaced };
    return core::result::Ok(ReplacementTransfer { progress: progress, exhausted: false });
}

// At most limit next calls; no probe when the quota is reached. exhausted says
// a None was observed, rather than claiming the next item is definitely Some.
// Each successful item is discarded as a shallow value; no Destroy is called.
// An owning source has already transferred that item's cleanup authority;
// retaining or destroying only its remainder cannot recover discarded owners.
pub fn advance_up_to<I, T>(source: &I, limit: u64) -> Advance where I: Iterator<T> {
    let advanced: u64 = 0;
    while (advanced < limit) {
        let item: core::option::Option<T> = source.next();
        if (core::option::is_none(item)) {
            return Advance { advanced: advanced, exhausted: true };
        }
        advanced += 1;
    }
    return Advance { advanced: advanced, exhausted: false };
}

// Forward slice cursor bodies retain native descriptors, stride and bounds.
// Keeping these impls here avoids a core::slice -> core::iter import cycle.
pub impl<T> Iterator<T> for core::slice::Iter<T> {
    pub fn next(&self) -> core::option::Option<T> {
        if (self.front == self.back) { return core::option::None(); }
        let value: T = self.values[self.front]; self.front += 1;
        return core::option::Some(value);
    }
}

// Retain the descriptor/stride and shared front/back bounds. Keeping the
// canonical method here avoids a core::slice -> core::iter import cycle.
pub impl<T> DoubleEndedIterator<T> for core::slice::Iter<T> {
    pub fn next_back(&self) -> core::option::Option<T> {
        if (self.front == self.back) { return core::option::None(); }
        self.back -= 1;
        return core::option::Some(self.values[self.back]);
    }
}

pub impl<T> ExactSizeIterator<T> for core::slice::Iter<T> {
    pub fn remaining_count(&self) -> u64 { return (self.back-self.front) as u64; }
}

pub impl<T> Iterator<core::slice::View<T>> for core::slice::Chunks<T> {
    pub fn next(&self) -> core::option::Option<core::slice::View<T>> {
        if (self.position == self.end) { return core::option::None(); }
        let count: i32 = self.end - self.position;
        if (count > self.width) { count = self.width; }
        let result: core::slice::View<T> = core::slice::View { values: self.values, start: self.position, length: count };
        self.position += count; return core::option::Some(result);
    }
}

pub impl<T> ExactSizeIterator<core::slice::View<T>> for core::slice::Chunks<T> {
    pub fn remaining_count(&self) -> u64 {
        let count: i32 = self.end-self.position;
        let result: u64 = (count/self.width) as u64;
        if (count%self.width != 0) { result += 1; }
        return result;
    }
}

pub impl<T> Iterator<core::slice::View<T>> for core::slice::Windows<T> {
    pub fn next(&self) -> core::option::Option<core::slice::View<T>> {
        if (self.end - self.position < self.width) { return core::option::None(); }
        let result: core::slice::View<T> = core::slice::View { values: self.values, start: self.position, length: self.width };
        self.position += 1; return core::option::Some(result);
    }
}

pub impl<T> ExactSizeIterator<core::slice::View<T>> for core::slice::Windows<T> {
    pub fn remaining_count(&self) -> u64 {
        let count: i32 = self.end-self.position;
        if (count < self.width) { return 0; }
        return ((count-self.width) as u64)+1;
    }
}

pub impl<T> Empty<T> {
    pub fn borrow(&self) -> &Empty<T> { return self; }
}

pub impl<I,T> Peekable<I,T> {
    pub fn borrow(&self) -> &Peekable<I,T> { return self; }
    pub fn has_cached(&self) -> bool { return self.cached.is_some(); }

    // Borrowed shallow observation, never another cleanup authority. End
    // aliases before next/take_cached/cleanup. First peek can poll upstream.
    pub fn peek(&self) -> core::option::Option<T> where I: Iterator<T> {
        if (self.cached.is_some() || self.done) { return self.cached; }
        let source: &I = self.source;
        self.cached = source.next();
        if (self.cached.is_none()) { self.done = true; }
        return self.cached;
    }

    // Transfer only the cached item, without polling or closing this adapter.
    pub fn take_cached(&self) -> core::option::Option<T> {
        let item: core::option::Option<T> = self.cached;
        self.cached = core::option::None();
        return item;
    }

    // Close this adapter without polling/draining/freeing upstream. A cached
    // owner must first be consumed or recovered; rejection preserves it.
    pub fn try_finish(&self) -> core::option::Option<PeekableError> {
        if (self.cached.is_some()) { return core::option::Some(PeekableError::Cached); }
        self.done = true;
        return core::option::None();
    }
}

pub impl<I,T> Iterator<T> for Peekable<I,T> where I: Iterator<T> {
    pub fn next(&self) -> core::option::Option<T> {
        if (self.cached.is_some()) { return self.take_cached(); }
        if (self.done) { return core::option::None(); }
        let source: &I = self.source;
        let item: core::option::Option<T> = source.next();
        if (item.is_none()) { self.done = true; }
        return item;
    }
}

pub impl<I,T> ExactSizeIterator<T> for Peekable<I,T>
    where I: Iterator<T>, I: ExactSizeIterator<T> {
    pub fn remaining_count(&self) -> u64 {
        if (self.done) { return 0; }
        let source: &I = self.source;
        let count: u64 = source.remaining_count();
        if (!self.cached.is_some()) { return count; }
        // A conforming source cannot leave MAX items after yielding its cache.
        // Trap an unrepresentable claimed length instead of wrapping to zero.
        if (count == 18446744073709551615) { core::panic::panic(); }
        return count+1;
    }
}

pub impl<T> Iterator<T> for Empty<T> {
    pub fn next(&self) -> core::option::Option<T> { return core::option::None(); }
}

pub impl<T> DoubleEndedIterator<T> for Empty<T> {
    pub fn next_back(&self) -> core::option::Option<T> { return core::option::None(); }
}

pub impl<T> ExactSizeIterator<T> for Empty<T> {
    pub fn remaining_count(&self) -> u64 { return 0; }
}

pub impl<T> Once<T> {
    pub fn borrow(&self) -> &Once<T> { return self; }
}

pub impl<T> Iterator<T> for Once<T> {
    pub fn next(&self) -> core::option::Option<T> {
        if (self.done) { return core::option::None(); }
        self.done = true;
        return core::option::Some(self.value);
    }
}

pub impl<T> DoubleEndedIterator<T> for Once<T> {
    pub fn next_back(&self) -> core::option::Option<T> {
        if (self.done) { return core::option::None(); }
        self.done = true;
        return core::option::Some(self.value);
    }
}

pub impl<T> ExactSizeIterator<T> for Once<T> {
    pub fn remaining_count(&self) -> u64 {
        if (self.done) { return 0; }
        return 1;
    }
}

pub impl<I,T> Rev<I,T> {
    pub fn borrow(&self) -> &Rev<I,T> { return self; }
}

pub impl<I,T> Iterator<T> for Rev<I,T>
    where I: Iterator<T>, I: DoubleEndedIterator<T> {
    pub fn next(&self) -> core::option::Option<T> {
        if (self.done) { return core::option::None(); }
        let source: &I = self.source;
        let item: core::option::Option<T> = source.next_back();
        if (item.is_none()) { self.done = true; }
        return item;
    }
}

pub impl<I,T> DoubleEndedIterator<T> for Rev<I,T>
    where I: Iterator<T>, I: DoubleEndedIterator<T> {
    pub fn next_back(&self) -> core::option::Option<T> {
        if (self.done) { return core::option::None(); }
        let source: &I = self.source;
        let item: core::option::Option<T> = source.next();
        if (item.is_none()) { self.done = true; }
        return item;
    }
}

pub impl<I,T> ExactSizeIterator<T> for Rev<I,T>
    where I: Iterator<T>, I: DoubleEndedIterator<T>, I: ExactSizeIterator<T> {
    pub fn remaining_count(&self) -> u64 {
        if (self.done) { return 0; }
        let source: &I = self.source; return source.remaining_count();
    }
}

pub impl<T> Repeat<T> {
    pub fn borrow(&self) -> &Repeat<T> { return self; }
}

pub impl<T> Iterator<T> for Repeat<T> {
    pub fn next(&self) -> core::option::Option<T> { return core::option::Some(self.value); }
}

pub impl<I, T> StepBy<I, T> {
    pub fn borrow(&self) -> &StepBy<I, T> { return self; }
}

pub impl<I, T> Iterator<T> for StepBy<I, T> where I: Iterator<T> {
    pub fn next(&self) -> core::option::Option<T> {
        if (self.done) { return core::option::None(); }
        let source: &I = self.source;
        let remaining: u64 = 0;
        if (!self.first) { remaining = self.skip; }
        self.first = false;
        while (remaining > 0) {
            let skipped: core::option::Option<T> = source.next();
            if (core::option::is_none(skipped)) { self.done = true; return skipped; }
            remaining -= 1;
        }
        let item: core::option::Option<T> = source.next();
        if (core::option::is_none(item)) { self.done = true; }
        return item;
    }
}

pub impl<I,T> ExactSizeIterator<T> for StepBy<I,T>
    where I: Iterator<T>, I: ExactSizeIterator<T> {
    pub fn remaining_count(&self) -> u64 {
        if (self.done) { return 0; }
        let source: &I = self.source; let count: u64 = source.remaining_count();
        // Construction establishes skip <= MAX-1. Before the first pull,
        // select positions 0, step, ...; afterward skip precedes every yield.
        let step: u64 = self.skip+1;
        let result: u64 = count/step;
        if (self.first && count%step != 0) { result += 1; }
        return result;
    }
}

pub impl RangeI32 {
    pub fn borrow(&self) -> &RangeI32 { return self; }
    pub fn remaining(&self) -> u64 { return (self.end - self.position) as u64; }
    // O(1). The clamp establishes skipped <= 2^32 before the u64-to-i64 cast.
    pub fn advance(&self, count: u64) -> u64 {
        let available: u64 = self.remaining();
        let skipped: u64 = count;
        if (skipped > available) { skipped = available; }
        self.position += skipped as i64;
        return skipped;
    }
}

pub impl Iterator<i32> for RangeI32 {
    pub fn next(&self) -> core::option::Option<i32> {
        if (self.position == self.end) { return core::option::None(); }
        let item: i32 = self.position as i32;
        self.position += 1;
        return core::option::Some(item);
    }
}

pub impl DoubleEndedIterator<i32> for RangeI32 {
    pub fn next_back(&self) -> core::option::Option<i32> {
        if (self.position == self.end) { return core::option::None(); }
        // end may be MAX + 1; subtract while widened before narrowing.
        self.end -= 1;
        return core::option::Some(self.end as i32);
    }
}

pub impl ExactSizeIterator<i32> for RangeI32 {
    pub fn remaining_count(&self) -> u64 { return (self.end-self.position) as u64; }
}

pub impl<I, T> Take<I, T> {
    pub fn borrow(&self) -> &Take<I, T> { return self; }
    // This is a quota, not an exact upper-source cardinality.
    pub fn remaining_limit(&self) -> u64 { return self.remaining; }
}

pub impl<I, T> Iterator<T> for Take<I, T> where I: Iterator<T> {
    pub fn next(&self) -> core::option::Option<T> {
        if (self.done || self.remaining == 0) { return core::option::None(); }
        let source: &I = self.source;
        let item: core::option::Option<T> = source.next();
        if (core::option::is_none(item)) { self.done = true; return item; }
        self.remaining -= 1;
        return item;
    }
}

pub impl<I,T> ExactSizeIterator<T> for Take<I,T>
    where I: Iterator<T>, I: ExactSizeIterator<T> {
    pub fn remaining_count(&self) -> u64 {
        if (self.done || self.remaining == 0) { return 0; }
        let source: &I = self.source; let count: u64 = source.remaining_count();
        if (count < self.remaining) { return count; }
        return self.remaining;
    }
}

// Chain has no exact-size implementation: two valid u64 counts may sum beyond
// u64. Zip also has none: its sources may legally share upstream progress, so
// min(left_count,right_count) need not equal the number of future pairs.
pub impl<A, B, T> Chain<A, B, T> {
    pub fn borrow(&self) -> &Chain<A, B, T> { return self; }
}

pub impl<A, B, T> Iterator<T> for Chain<A, B, T>
    where A: Iterator<T>, B: Iterator<T> {
    pub fn next(&self) -> core::option::Option<T> {
        if (self.done) { return core::option::None(); }
        if (!self.left_done) {
            let left: &A = self.left;
            let item: core::option::Option<T> = left.next();
            if (core::option::is_some(item)) { return item; }
            self.left_done = true;
        }
        if (self.right_done) { self.done = true; return core::option::None(); }
        let right: &B = self.right;
        let item: core::option::Option<T> = right.next();
        if (core::option::is_none(item)) { self.right_done = true; self.done = true; }
        return item;
    }
}

pub impl<A,B,T> DoubleEndedIterator<T> for Chain<A,B,T>
    where A: Iterator<T>, A: DoubleEndedIterator<T>, B: Iterator<T>, B: DoubleEndedIterator<T> {
    pub fn next_back(&self) -> core::option::Option<T> {
        if (self.done) { return core::option::None(); }
        if (!self.right_done) {
            let right: &B = self.right;
            let item: core::option::Option<T> = right.next_back();
            if (item.is_some()) { return item; }
            self.right_done = true;
        }
        if (self.left_done) { self.done = true; return core::option::None(); }
        let left: &A = self.left;
        let item: core::option::Option<T> = left.next_back();
        if (item.is_none()) { self.left_done = true; self.done = true; }
        return item;
    }
}

pub impl<I, M, T, U> Map<I, M, T, U> {
    pub fn borrow(&self) -> &Map<I, M, T, U> { return self; }
}

pub impl<I, M, T, U> Iterator<U> for Map<I, M, T, U>
    where I: Iterator<T>, M: Mapper<T, U> {
    pub fn next(&self) -> core::option::Option<U> {
        if (self.done) { return core::option::None(); }
        let source: &I = self.source;
        let item: core::option::Option<T> = source.next();
        if (core::option::is_none(item)) { self.done = true; return core::option::None(); }
        let value: T = core::option::unwrap(item);
        let mapper: &M = self.mapper;
        let mapped: U = mapper.apply(value);
        return core::option::Some(mapped);
    }
}

pub impl<I,M,T,U> DoubleEndedIterator<U> for Map<I,M,T,U>
    where I: Iterator<T>, I: DoubleEndedIterator<T>, M: Mapper<T,U> {
    pub fn next_back(&self) -> core::option::Option<U> {
        if (self.done) { return core::option::None(); }
        let source: &I = self.source;
        let item: core::option::Option<T> = source.next_back();
        if (item.is_none()) { self.done = true; return core::option::None(); }
        let mapper: &M = self.mapper;
        let mapped: U = mapper.apply(item.unwrap());
        return core::option::Some(mapped);
    }
}

// Stateful mapper output/logging is allowed. During apply, a mapper must not
// independently advance, retire or mutate any upstream traversal state.
pub impl<I,M,T,U> ExactSizeIterator<U> for Map<I,M,T,U>
    where I: Iterator<T>, I: ExactSizeIterator<T>, M: Mapper<T,U> {
    pub fn remaining_count(&self) -> u64 {
        if (self.done) { return 0; }
        let source: &I = self.source; return source.remaining_count();
    }
}

pub impl<I,M,T,U> Scan<I,M,T,U> {
    pub fn borrow(&self) -> &Scan<I,M,T,U> { return self; }
}

pub impl<I,M,T,U> Iterator<U> for Scan<I,M,T,U>
    where I: Iterator<T>, M: Mapper<T,core::option::Option<U>> {
    pub fn next(&self) -> core::option::Option<U> {
        if (self.done) { return core::option::None(); }
        let source: &I = self.source;
        let item: core::option::Option<T> = source.next();
        if (item.is_none()) { self.done = true; return core::option::None(); }
        let mapper: &M = self.mapper;
        let mapped: core::option::Option<U> = mapper.apply(item.unwrap());
        if (mapped.is_none()) { self.done = true; }
        return mapped;
    }
}

pub impl<I,M,T,U,E> TryScan<I,M,T,U,E> {
    pub fn borrow(&self) -> &TryScan<I,M,T,U,E> { return self; }
}

pub impl<I,M,T,U,E> Iterator<core::result::Result<U,E>> for TryScan<I,M,T,U,E>
    where I: Iterator<T>, M: Mapper<T,core::result::Result<core::option::Option<U>,E>> {
    pub fn next(&self) -> core::option::Option<core::result::Result<U,E>> {
        if (self.done) { return core::option::None(); }
        let source: &I = self.source;
        let item: core::option::Option<T> = source.next();
        if (item.is_none()) { self.done = true; return core::option::None(); }
        let mapper: &M = self.mapper;
        let mapped: core::result::Result<core::option::Option<U>,E> = mapper.apply(item.unwrap());
        if (mapped.is_err()) {
            self.done = true;
            return core::option::Some(core::result::Err(mapped.unwrap_err()));
        }
        let selected: core::option::Option<U> = mapped.unwrap();
        if (selected.is_none()) { self.done = true; return core::option::None(); }
        return core::option::Some(core::result::Ok(selected.unwrap()));
    }
}

impl<J> NestedState<J> {
    fn borrow(&self) -> &NestedState<J> { return self; }
    fn has_active(&self) -> bool { return self.active.is_some(); }
    fn take_active(&self) -> core::option::Option<J> {
        let previous: core::option::Option<J> = self.active;
        self.active = core::option::None(); self.done = true;
        return previous;
    }
    fn try_finish(&self) -> core::option::Option<NestedFinishError> {
        if (self.active.is_some()) { return core::option::Some(NestedFinishError::Active); }
        self.done = true;
        return core::option::None();
    }
}

impl<J,E> NestedIdentity<J,E> {
    fn borrow(&self) -> &NestedIdentity<J,E> { return self; }
}
pub impl<J,E> Mapper<J,core::result::Result<J,E>> for NestedIdentity<J,E> {
    pub fn apply(&self, value: J) -> core::result::Result<J,E> { return core::result::Ok(value); }
}

// Call-scoped bridge only. It borrows the actual caller mapper; neither this
// record nor its reference is ever retained by the nested traversal engine.
impl<M,S,J> NestedLift<M,S,J> {
    fn borrow(&self) -> &NestedLift<M,S,J> { return self; }
}
pub impl<M,S,J> Mapper<S,core::result::Result<J,core::clone_values::Infallible>> for NestedLift<M,S,J>
    where M: Mapper<S,J> {
    pub fn apply(&self, value: S) -> core::result::Result<J,core::clone_values::Infallible> {
        let mapper: &M = self.mapper;
        let inner: J = mapper.apply(value);
        return core::result::Ok(inner);
    }
}

// Only the engine's outer transport Result is removed. If T is itself an
// Option or Result its None/Err remains an ordinary yielded item. No fallible
// error is erased: a lawful value of Infallible cannot be constructed.
fn infallible_nested_item<T>(item: core::option::Option<core::result::Result<T,core::clone_values::Infallible>>)
    -> core::option::Option<T> {
    if (item.is_none()) { return core::option::None(); }
    let value: core::result::Result<T,core::clone_values::Infallible> = item.unwrap();
    return core::option::Some(value.unwrap());
}

// The only nested traversal engine. It borrows these arguments for this call
// and stores only transferred J values. No local mapper/provider escapes.
// Move out and clear BEFORE local next or policy calls. Reinstall a mutated
// local after an item; after failure reinstall ONLY the policy-returned J.
fn nested_next<I,M,R,S,J,T,E>(state: &NestedState<J>, source: &I, mapper: &M, retirement: &R)
    -> core::option::Option<core::result::Result<T,E>>
    where I: Iterator<S>, M: Mapper<S,core::result::Result<J,E>>,
        J: Iterator<T>, R: InnerRetirement<J,E> {
    if (state.done) { return core::option::None(); }
    while (true) {
        if (state.active.is_some()) {
            let inner: J = state.active.unwrap();
            state.active = core::option::None();
            let item: core::option::Option<T> = inner.next();
            if (item.is_some()) {
                state.active = core::option::Some(inner);
                return core::option::Some(core::result::Ok(item.unwrap()));
            }
            let retired: core::option::Option<RetireFailure<J,E>> = retirement.try_retire(inner);
            if (retired.is_some()) {
                let failure: RetireFailure<J,E> = retired.unwrap();
                state.active = core::option::Some(failure.inner);
                state.done = true;
                return core::option::Some(core::result::Err(failure.error));
            }
            // Successful retirement consumed inner; no earlier copy is used.
            // The next loop turn may now acquire the next outer item.
        } else {
            let outer: core::option::Option<S> = source.next();
            if (outer.is_none()) { state.done = true; return core::option::None(); }
            let mapped: core::result::Result<J,E> = mapper.apply(outer.unwrap());
            if (mapped.is_err()) {
                state.done = true;
                return core::option::Some(core::result::Err(mapped.unwrap_err()));
            }
            state.active = core::option::Some(mapped.unwrap());
        }
    }
    return core::option::None();
}

pub impl<I,J,R,T,E> TryFlatten<I,J,R,T,E> {
    pub fn borrow(&self) -> &TryFlatten<I,J,R,T,E> { return self; }
    pub fn has_active(&self) -> bool { return self.state.has_active(); }
    // Close and transfer the actual active inner. Never poll, retire or drain
    // the borrowed outer; its remaining cleanup authority stays with caller.
    pub fn take_active(&self) -> core::option::Option<J> { return self.state.take_active(); }
    // Rejection preserves all state, including an already-fused failed inner.
    pub fn try_finish(&self) -> core::option::Option<NestedFinishError> { return self.state.try_finish(); }
}

pub impl<I,J,R,T,E> Iterator<core::result::Result<T,E>> for TryFlatten<I,J,R,T,E>
    where I: Iterator<J>, J: Iterator<T>, R: InnerRetirement<J,E> {
    pub fn next(&self) -> core::option::Option<core::result::Result<T,E>> {
        let state: &NestedState<J> = self.state.borrow();
        let source: &I = self.source;
        let retirement: &R = self.retirement;
        let identity: NestedIdentity<J,E> = NestedIdentity {};
        return nested_next<I,NestedIdentity<J,E>,R,J,J,T,E>(state,source,identity.borrow(),retirement);
    }
}

pub impl<I,M,R,S,J,T,E> TryFlatMap<I,M,R,S,J,T,E> {
    pub fn borrow(&self) -> &TryFlatMap<I,M,R,S,J,T,E> { return self; }
    pub fn has_active(&self) -> bool { return self.state.has_active(); }
    pub fn take_active(&self) -> core::option::Option<J> { return self.state.take_active(); }
    pub fn try_finish(&self) -> core::option::Option<NestedFinishError> { return self.state.try_finish(); }
}

pub impl<I,M,R,S,J,T,E> Iterator<core::result::Result<T,E>> for TryFlatMap<I,M,R,S,J,T,E>
    where I: Iterator<S>, M: Mapper<S,core::result::Result<J,E>>,
        J: Iterator<T>, R: InnerRetirement<J,E> {
    pub fn next(&self) -> core::option::Option<core::result::Result<T,E>> {
        let state: &NestedState<J> = self.state.borrow();
        let source: &I = self.source;
        let mapper: &M = self.mapper;
        let retirement: &R = self.retirement;
        return nested_next<I,M,R,S,J,T,E>(state,source,mapper,retirement);
    }
}

pub impl<I,J,R,T> Flatten<I,J,R,T> {
    pub fn borrow(&self) -> &Flatten<I,J,R,T> { return self; }
    pub fn has_active(&self) -> bool { return self.state.has_active(); }
    pub fn take_active(&self) -> core::option::Option<J> { return self.state.take_active(); }
    pub fn try_finish(&self) -> core::option::Option<NestedFinishError> { return self.state.try_finish(); }
}

pub impl<I,J,R,T> Iterator<T> for Flatten<I,J,R,T>
    where I: Iterator<J>, J: Iterator<T>, R: InnerRetirement<J,core::clone_values::Infallible> {
    pub fn next(&self) -> core::option::Option<T> {
        let state: &NestedState<J> = self.state.borrow();
        let source: &I = self.source;
        let retirement: &R = self.retirement;
        let identity: NestedIdentity<J,core::clone_values::Infallible> = NestedIdentity {};
        let item: core::option::Option<core::result::Result<T,core::clone_values::Infallible>> =
            nested_next<I,NestedIdentity<J,core::clone_values::Infallible>,R,J,J,T,core::clone_values::Infallible>(state,source,identity.borrow(),retirement);
        return infallible_nested_item<T>(item);
    }
}

pub impl<I,M,R,S,J,T> FlatMap<I,M,R,S,J,T> {
    pub fn borrow(&self) -> &FlatMap<I,M,R,S,J,T> { return self; }
    pub fn has_active(&self) -> bool { return self.state.has_active(); }
    pub fn take_active(&self) -> core::option::Option<J> { return self.state.take_active(); }
    pub fn try_finish(&self) -> core::option::Option<NestedFinishError> { return self.state.try_finish(); }
}

pub impl<I,M,R,S,J,T> Iterator<T> for FlatMap<I,M,R,S,J,T>
    where I: Iterator<S>, M: Mapper<S,J>, J: Iterator<T>,
        R: InnerRetirement<J,core::clone_values::Infallible> {
    pub fn next(&self) -> core::option::Option<T> {
        let state: &NestedState<J> = self.state.borrow();
        let source: &I = self.source;
        let mapper: &M = self.mapper;
        let retirement: &R = self.retirement;
        let lifted: NestedLift<M,S,J> = NestedLift { mapper: mapper };
        let item: core::option::Option<core::result::Result<T,core::clone_values::Infallible>> =
            nested_next<I,NestedLift<M,S,J>,R,S,J,T,core::clone_values::Infallible>(state,source,lifted.borrow(),retirement);
        return infallible_nested_item<T>(item);
    }
}

pub impl<A, B, T, U> Zip<A, B, T, U> {
    pub fn borrow(&self) -> &Zip<A, B, T, U> { return self; }
}

pub impl<A, B, T, U> Iterator<core::pair::Pair<T, U>> for Zip<A, B, T, U>
    where A: Iterator<T>, B: Iterator<U> {
    pub fn next(&self) -> core::option::Option<core::pair::Pair<T, U>> {
        if (self.done) { return core::option::None(); }
        let left: &A = self.left;
        let first: core::option::Option<T> = left.next();
        if (core::option::is_none(first)) { self.done = true; return core::option::None(); }
        let right: &B = self.right;
        let second: core::option::Option<U> = right.next();
        if (core::option::is_none(second)) { self.done = true; return core::option::None(); }
        let a: T = core::option::unwrap(first);
        let b: U = core::option::unwrap(second);
        let item: core::pair::Pair<T, U> = core::pair::Pair { first: a, second: b };
        return core::option::Some(item);
    }
}

pub impl<I, T> Enumerate<I, T> {
    pub fn borrow(&self) -> &Enumerate<I, T> { return self; }
}

pub impl<I, T> Iterator<core::pair::Pair<u64, T>> for Enumerate<I, T>
    where I: Iterator<T> {
    pub fn next(&self) -> core::option::Option<core::pair::Pair<u64, T>> {
        if (self.done) { return core::option::None(); }
        let source: &I = self.source;
        let value: core::option::Option<T> = source.next();
        if (core::option::is_none(value)) { self.done = true; return core::option::None(); }
        if (self.max_used) { core::panic::panic(); }
        let item: T = core::option::unwrap(value);
        let indexed: core::pair::Pair<u64, T> = core::pair::Pair { first: self.next_index, second: item };
        if (self.next_index == 18446744073709551615) { self.max_used = true; }
        else { self.next_index += 1; }
        return core::option::Some(indexed);
    }
}

pub impl<I, P, T> Filter<I, P, T> {
    pub fn borrow(&self) -> &Filter<I, P, T> { return self; }
}

pub impl<I, P, T> Iterator<T> for Filter<I, P, T>
    where I: Iterator<T>, P: Mapper<T, bool> {
    pub fn next(&self) -> core::option::Option<T> {
        if (self.done) { return core::option::None(); }
        let source: &I = self.source;
        let predicate: &P = self.predicate;
        while (true) {
            let item: core::option::Option<T> = source.next();
            if (core::option::is_none(item)) { self.done = true; return item; }
            let value: T = core::option::unwrap(item);
            let selected: bool = predicate.apply(value);
            if (selected) { return item; }
        }
        return core::option::None();
    }
}

pub impl<I, M, T, U> FilterMap<I, M, T, U> {
    pub fn borrow(&self) -> &FilterMap<I, M, T, U> { return self; }
}

// Predicates observe values in actual pull order. Rejected owners still need
// application cleanup, exactly as in forward Filter; no Destroy is implied.
pub impl<I,P,T> DoubleEndedIterator<T> for Filter<I,P,T>
    where I: Iterator<T>, I: DoubleEndedIterator<T>, P: Mapper<T,bool> {
    pub fn next_back(&self) -> core::option::Option<T> {
        if (self.done) { return core::option::None(); }
        let source: &I = self.source;
        let predicate: &P = self.predicate;
        while (true) {
            let item: core::option::Option<T> = source.next_back();
            if (item.is_none()) { self.done = true; return item; }
            if (predicate.apply(item.unwrap())) { return item; }
        }
        return core::option::None();
    }
}

pub impl<I, M, T, U> Iterator<U> for FilterMap<I, M, T, U>
    where I: Iterator<T>, M: Mapper<T, core::option::Option<U>> {
    pub fn next(&self) -> core::option::Option<U> {
        if (self.done) { return core::option::None(); }
        let source: &I = self.source;
        let mapper: &M = self.mapper;
        while (true) {
            let item: core::option::Option<T> = source.next();
            if (core::option::is_none(item)) { self.done = true; return core::option::None(); }
            let value: T = core::option::unwrap(item);
            let mapped: core::option::Option<U> = mapper.apply(value);
            if (core::option::is_some(mapped)) { return mapped; }
        }
        return core::option::None();
    }
}

pub impl<I,M,T,U> DoubleEndedIterator<U> for FilterMap<I,M,T,U>
    where I: Iterator<T>, I: DoubleEndedIterator<T>, M: Mapper<T,core::option::Option<U>> {
    pub fn next_back(&self) -> core::option::Option<U> {
        if (self.done) { return core::option::None(); }
        let source: &I = self.source;
        let mapper: &M = self.mapper;
        while (true) {
            let item: core::option::Option<T> = source.next_back();
            if (item.is_none()) { self.done = true; return core::option::None(); }
            let mapped: core::option::Option<U> = mapper.apply(item.unwrap());
            if (mapped.is_some()) { return mapped; }
        }
        return core::option::None();
    }
}

pub impl<I, T> Skip<I, T> {
    pub fn borrow(&self) -> &Skip<I, T> { return self; }
}

pub impl<I, T> Iterator<T> for Skip<I, T> where I: Iterator<T> {
    pub fn next(&self) -> core::option::Option<T> {
        if (self.done) { return core::option::None(); }
        let source: &I = self.source;
        while (self.remaining > 0) {
            let skipped: core::option::Option<T> = source.next();
            if (core::option::is_none(skipped)) { self.done = true; return skipped; }
            self.remaining -= 1;
        }
        let item: core::option::Option<T> = source.next();
        if (core::option::is_none(item)) { self.done = true; }
        return item;
    }
}

pub impl<I,T> ExactSizeIterator<T> for Skip<I,T>
    where I: Iterator<T>, I: ExactSizeIterator<T> {
    pub fn remaining_count(&self) -> u64 {
        if (self.done) { return 0; }
        let source: &I = self.source; let count: u64 = source.remaining_count();
        if (count <= self.remaining) { return 0; }
        return count-self.remaining;
    }
}

pub impl<I, P, T> TakeWhile<I, P, T> {
    pub fn borrow(&self) -> &TakeWhile<I, P, T> { return self; }
}

pub impl<I, P, T> Iterator<T> for TakeWhile<I, P, T>
    where I: Iterator<T>, P: Mapper<T, bool> {
    pub fn next(&self) -> core::option::Option<T> {
        if (self.done) { return core::option::None(); }
        let source: &I = self.source;
        let item: core::option::Option<T> = source.next();
        if (core::option::is_none(item)) { self.done = true; return item; }
        let value: T = core::option::unwrap(item);
        let predicate: &P = self.predicate;
        let selected: bool = predicate.apply(value);
        if (!selected) { self.done = true; return core::option::None(); }
        return item;
    }
}

pub impl<I, P, T> SkipWhile<I, P, T> {
    pub fn borrow(&self) -> &SkipWhile<I, P, T> { return self; }
}

pub impl<I, P, T> Iterator<T> for SkipWhile<I, P, T>
    where I: Iterator<T>, P: Mapper<T, bool> {
    pub fn next(&self) -> core::option::Option<T> {
        if (self.done) { return core::option::None(); }
        let source: &I = self.source;
        let predicate: &P = self.predicate;
        while (true) {
            let item: core::option::Option<T> = source.next();
            if (core::option::is_none(item)) { self.done = true; return item; }
            if (!self.skipping) { return item; }
            let value: T = core::option::unwrap(item);
            let selected: bool = predicate.apply(value);
            if (!selected) { self.skipping = false; return item; }
        }
        return core::option::None();
    }
}
