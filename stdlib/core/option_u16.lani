// A concrete optional u16 until generic enum values execute natively.
// `value` is zero for None and must be read only when `present` is true.
module core::option_u16;
import core::result_u16;

pub struct OptionU16 {
    present: bool,
    value: u16,
}

pub fn some(value: u16) -> OptionU16 {
    return OptionU16 { present: true, value: value };
}

pub fn none() -> OptionU16 {
    return OptionU16 { present: false, value: 0 };
}

pub fn is_some(value: OptionU16) -> bool {
    return value.present;
}

pub fn is_none(value: OptionU16) -> bool {
    return !value.present;
}

pub fn contains(value: OptionU16, expected: u16) -> bool {
    return value.present && value.value == expected;
}

pub fn unwrap_or(value: OptionU16, fallback: u16) -> u16 {
    if (value.present) { return value.value; }
    return fallback;
}

pub fn or(value: OptionU16, fallback: OptionU16) -> OptionU16 {
    if (value.present) { return value; }
    return fallback;
}

pub fn and(value: OptionU16, next: OptionU16) -> OptionU16 {
    if (value.present) { return next; }
    return value;
}

pub fn xor(left: OptionU16, right: OptionU16) -> OptionU16 {
    if (left.present) {
        if (right.present) { return none(); }
        return left;
    }
    return right;
}

pub fn ok_or(value: OptionU16, error: u16) -> core::result_u16::ResultU16 {
    if (value.present) { return core::result_u16::ok(value.value); }
    return core::result_u16::err(error);
}

pub fn ok(value: core::result_u16::ResultU16) -> OptionU16 {
    if (core::result_u16::is_ok(value)) {
        return some(core::result_u16::unwrap_or(value, 0));
    }
    return none();
}

pub fn err(value: core::result_u16::ResultU16) -> OptionU16 {
    if (core::result_u16::is_err(value)) {
        return some(core::result_u16::unwrap_err_or(value, 0));
    }
    return none();
}
