// Signed two-word ZigZag encoding over canonical unsigned LEB128.
module core::varint_wide_i64;
import core::varint;
import core::varint_wide_u64;
import core::wide_i64;
import core::wide_u64;

pub fn zigzag_encode(value: core::wide_i64::WideI64) -> core::wide_u64::WideU64 {
    let bits: core::wide_u64::WideU64 = core::wide_u64::from_words(
        core::wide_i64::high_word(value), core::wide_i64::low_word(value));
    let shifted: core::wide_u64::WideU64 = core::wide_u64::shift_left(bits, 1);
    if (core::wide_i64::is_negative(value)) { return core::wide_u64::bit_not(shifted); }
    return shifted;
}

pub fn zigzag_decode(value: core::wide_u64::WideU64) -> core::wide_i64::WideI64 {
    let shifted: core::wide_u64::WideU64 = core::wide_u64::shift_right(value, 1);
    if ((core::wide_u64::low_word(value) & 1) != 0) {
        shifted = core::wide_u64::bit_not(shifted);
    }
    return core::wide_i64::from_words(
        core::wide_u64::high_word(shifted), core::wide_u64::low_word(shifted));
}

pub fn len_wide_i64(value: core::wide_i64::WideI64) -> i32 {
    return core::varint_wide_u64::len_wide_u64(zigzag_encode(value));
}

// Return the next offset, or -1 without writing on invalid logical bounds
// or insufficient capacity. A physical backing overclaim may trap.
pub fn write_wide_i64(
    bytes: [u8], len: i32, offset: i32, value: core::wide_i64::WideI64
) -> i32 {
    return core::varint_wide_u64::write_wide_u64(bytes, len, offset, zigzag_encode(value));
}

// The returned unsigned result carries the wire status and next offset.
pub fn read_wide_i64(
    bytes: [u8], len: i32, offset: i32
) -> core::varint_wide_u64::ReadWideU64 {
    return core::varint_wide_u64::read_wide_u64(bytes, len, offset);
}

pub fn value_wide_i64_or(
    result: core::varint_wide_u64::ReadWideU64,
    fallback: core::wide_i64::WideI64
) -> core::wide_i64::WideI64 {
    if (core::varint_wide_u64::status_wide_u64(result) != core::varint::OK) {
        return fallback;
    }
    return zigzag_decode(core::varint_wide_u64::value_wide_u64_or(
        result, core::wide_u64::zero()));
}
