// Allocation-free signed 8-bit arithmetic. Widen before arithmetic so
// overflow decisions do not depend on native i8 wrap behavior.
module core::number_i8;
pub const MIN: i8 = -128;
pub const MAX: i8 = 127;
fn in_range(value: i16) -> bool {
    return value >= -128 && value <= 127;
}
fn saturate(value: i16) -> i8 {
    if (value< - 128) {
        return MIN;
    }
    if (value>127) {
        return MAX;
    }
    let narrowed: i8 = value as i8;
    return narrowed;
}
pub fn min(left: i8, right: i8) -> i8 {
    if (left<right) {
        return left;
    }
    return right;
}
pub fn max(left: i8, right: i8) -> i8 {
    if (left>right) {
        return left;
    }
    return right;
}
// Reversed bounds return fallback unchanged.
pub fn clamp_or(value: i8, low: i8, high: i8, fallback: i8) -> i8 {
    if (low>high) {
        return fallback;
    }
    if (value<low) {
        return low;
    }
    if (value>high) {
        return high;
    }
    return value;
}
pub fn saturating_abs(value: i8) -> i8 {
    if (value == MIN) {
        return MAX;
    }
    if (value<0) {
        return -value;
    }
    return value;
}
// The mathematical GCD of MIN and zero, or MIN and MIN, is 128 and returns
// fallback because it cannot be represented as i8. gcd(0, 0) is zero.
pub fn gcd_or(left: i8, right: i8, fallback: i8) -> i8 {
    let a: i16 = left as i16;
    let b: i16 = right as i16;
    if (a<0) {
        a = -a;
    }
    if (b<0) {
        b = -b;
    }
    while (b != 0) {
        let remainder: i16 = a % b;
        a = b;
        b = remainder;
    }
    if (a>127) {
        return fallback;
    }
    let narrowed: i8 = a as i8;
    return narrowed;
}
// Returns a nonnegative LCM, zero for a zero operand, or fallback above MAX.
pub fn lcm_or(left: i8, right: i8, fallback: i8) -> i8 {
    if (left == 0 || right == 0) {
        return 0;
    }
    let a: i16 = left as i16;
    let b: i16 = right as i16;
    if (a<0) {
        a = -a;
    }
    if (b<0) {
        b = -b;
    }
    let first: i16 = a;
    let second: i16 = b;
    while (second != 0) {
        let remainder: i16 = first % second;
        first = second;
        second = remainder;
    }
    let product: i16 =(a / first) * b;
    if (product>127) {
        return fallback;
    }
    let narrowed: i8 = product as i8;
    return narrowed;
}
pub fn saturating_add(left: i8, right: i8) -> i8 {
    let a: i16 = left as i16;
    let b: i16 = right as i16;
    return saturate(a + b);
}
pub fn saturating_sub(left: i8, right: i8) -> i8 {
    let a: i16 = left as i16;
    let b: i16 = right as i16;
    return saturate(a - b);
}
pub fn saturating_mul(left: i8, right: i8) -> i8 {
    let a: i16 = left as i16;
    let b: i16 = right as i16;
    return saturate(a * b);
}
// Normalize before narrowing: an out-of-range signed cast does not currently
// sign-extend reliably on native targets. Every i8 product fits in i16.
fn wrap(value: i16) -> i8 {
    let reduced: i16 = value % 256;
    if (reduced > 127) {
        reduced -= 256;
    }
    if (reduced < -128) {
        reduced += 256;
    }
    return reduced as i8;
}
pub fn wrapping_add(left: i8, right: i8) -> i8 {
    let a: i16 = left as i16;
    let b: i16 = right as i16;
    let result: i16 = a + b;
    return wrap(result);
}
pub fn wrapping_sub(left: i8, right: i8) -> i8 {
    let a: i16 = left as i16;
    let b: i16 = right as i16;
    let result: i16 = a - b;
    return wrap(result);
}
pub fn wrapping_mul(left: i8, right: i8) -> i8 {
    let a: i16 = left as i16;
    let b: i16 = right as i16;
    let result: i16 = a * b;
    return wrap(result);
}
// Returns fallback when the product is outside the signed 8-bit range.
pub fn mul_or(left: i8, right: i8, fallback: i8) -> i8 {
    let a: i16 = left as i16;
    let b: i16 = right as i16;
    let product: i16 = a * b;
    if (!in_range(product)) {
        return fallback;
    }
    let narrowed: i8 = product as i8;
    return narrowed;
}
// Defines 0^0 as one. An unrepresentable power returns fallback.
pub fn pow_or(base: i8, exponent: u32, fallback: i8) -> i8 {
    let result: i16 = 1;
    let factor: i16 = base as i16;
    let remaining: u32 = exponent;
    while (remaining>0) {
        if (remaining % 2 != 0) {
            let product: i16 = result * factor;
            if (!in_range(product)) {
                return fallback;
            }
            result = product;
        }
        remaining /= 2;
        if (remaining>0) {
            let square: i16 = factor * factor;
            if (!in_range(square)) {
                return fallback;
            }
            factor = square;
        }
    }
    let narrowed: i8 = result as i8;
    return narrowed;
}
pub fn saturating_abs_diff(left: i8, right: i8) -> i8 {
    let a: i16 = left as i16;
    let b: i16 = right as i16;
    if (a >= b) {
        return saturate(a - b);
    }
    return saturate(b - a);
}
pub fn is_even(value: i8) -> bool {
    return value % 2 == 0;
}
pub fn is_odd(value: i8) -> bool {
    return value % 2 != 0;
}
pub fn is_zero(value: i8) -> bool {
    return value == 0;
}
pub fn signum(value: i8) -> i8 {
    if (value<0) {
        return -1;
    }
    if (value>0) {
        return 1;
    }
    return 0;
}
// A zero divisor returns false.
pub fn is_multiple_of(value: i8, divisor: i8) -> bool {
    if (divisor == 0) {
        return false;
    }
    let a: i16 = value as i16;
    let b: i16 = divisor as i16;
    return a % b == 0;
}
// A zero divisor or MIN/-1 returns fallback before division.
pub fn div_or(value: i8, divisor: i8, fallback: i8) -> i8 {
    if (divisor == 0 || value == MIN && divisor == -1) {
        return fallback;
    }
    let a: i16 = value as i16;
    let b: i16 = divisor as i16;
    let quotient: i8 = (a / b) as i8;
    return quotient;
}
pub fn rem_or(value: i8, divisor: i8, fallback: i8) -> i8 {
    if (divisor == 0 || value == MIN && divisor == -1) {
        return fallback;
    }
    let a: i16 = value as i16;
    let b: i16 = divisor as i16;
    let remainder: i8 = (a % b) as i8;
    return remainder;
}
// Euclidean division has a nonnegative remainder. Failure uses fallback.
pub fn div_euclid_or(value: i8, divisor: i8, fallback: i8) -> i8 {
    if (divisor == 0 || value == MIN && divisor == -1) {
        return fallback;
    }
    let a: i16 = value as i16;
    let b: i16 = divisor as i16;
    let quotient: i16 = a / b;
    let remainder: i16 = a % b;
    if (remainder<0) {
        if (b>0) {
            quotient -= 1;
        } else {
            quotient += 1;
        }
    }
    let narrowed: i8 = quotient as i8;
    return narrowed;
}
pub fn rem_euclid_or(value: i8, divisor: i8, fallback: i8) -> i8 {
    if (divisor == 0 || value == MIN && divisor == -1) {
        return fallback;
    }
    let a: i16 = value as i16;
    let b: i16 = divisor as i16;
    let remainder: i16 = a % b;
    if (remainder<0) {
        if (b>0) {
            remainder += b;
        } else {
            remainder -= b;
        }
    }
    let narrowed: i8 = remainder as i8;
    return narrowed;
}
pub fn is_power_of_two(value: i8) -> bool {
    if (value <= 0) {
        return false;
    }
    return(value&(value - 1)) == 0;
}
// Zero means the next positive power cannot fit in i8.
pub fn next_power_of_two(value: i8) -> i8 {
    if (value <= 1) {
        return 1;
    }
    if (value>64) {
        return 0;
    }
    let power: i8 = 1;
    while (power<value) {
        power *= 2;
    }
    return power;
}
