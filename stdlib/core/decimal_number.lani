// Exact borrowed JSON decimal numbers. No floating point or exponent limit.
// Valid Decimal values come from parse; keep their bytes alive and unchanged.
// See docs/stdlib-decimal-number.md for scratch and work contracts.
module core::decimal_number;
import core::decimal;
import core::option;
import core::result;
import core::slice;

pub enum ErrorKind { Bounds, Syntax, ScratchTooSmall, WorkLimit, ZeroDivisor, CapacityOverflow }
pub struct Error { kind: ErrorKind, offset: i32 }
pub struct Decimal {
    raw: core::slice::View<u8>, negative: bool, mantissa_start: i32,
    integer_digits: i32, total_digits: i32, first: i32, last: i32, dot: bool,
    exponent_start: i32, exponent_length: i32, exponent_negative: bool,
}
pub struct Multiple { value: bool, work: u64 }
struct Work { remaining: u64, used: u64, failed: bool }
struct Adjusted {
    source: Decimal, negative: bool, length: i32, small: bool, magnitude: u64,
    prefix_length: i32, original_prefix: i32, carry: i32, pivot: i32, tail: u64,
}
const BASE: i64 = 1000000000000000000;

fn error(kind: ErrorKind, offset: i32) -> Error { return Error { kind: kind, offset: offset }; }
fn valid(view: core::slice::View<u8>) -> bool {
    return view.start >= 0 && view.length >= 0 && view.start <= 2147483647 - view.length;
}
fn byte(view: core::slice::View<u8>, index: i32) -> u8 { return core::option::unwrap(view.get(index)); }
fn digit(value: u8) -> bool { return value >= 48 && value <= 57; }

// Strict RFC 8259 number token, without surrounding whitespace or delimiters.
// Syntax offsets are relative to the selected view; a missing byte uses len().
pub fn parse(raw: core::slice::View<u8>) -> core::result::Result<Decimal, Error> {
    if (!valid(raw)) { return core::result::Err(error(ErrorKind::Bounds,-1)); }
    let count: i32 = raw.len(); let position: i32 = 0; let negative: bool = false;
    if (position < count && byte(raw,position) == 45) { negative = true; position += 1; }
    let start: i32 = position;
    if (position >= count || !digit(byte(raw,position))) { return core::result::Err(error(ErrorKind::Syntax,position)); }
    if (byte(raw,position) == 48) { position += 1; }
    else { while (position < count && digit(byte(raw,position))) { position += 1; } }
    let integer_digits: i32 = position - start; let dot: bool = false; let fractional: i32 = 0;
    if (position < count && byte(raw,position) == 46) {
        dot = true; position += 1; let fraction_start: i32 = position;
        while (position < count && digit(byte(raw,position))) { position += 1; }
        fractional = position - fraction_start;
        if (fractional == 0) { return core::result::Err(error(ErrorKind::Syntax,position)); }
    }
    let exponent_start: i32 = position; let exponent_length: i32 = 0; let exponent_negative: bool = false;
    if (position < count && (byte(raw,position) == 101 || byte(raw,position) == 69)) {
        position += 1;
        if (position < count && (byte(raw,position) == 43 || byte(raw,position) == 45)) {
            exponent_negative = byte(raw,position) == 45; position += 1;
        }
        let first_digit: i32 = position;
        while (position < count && digit(byte(raw,position))) { position += 1; }
        if (position == first_digit) { return core::result::Err(error(ErrorKind::Syntax,position)); }
        exponent_start = first_digit;
        while (exponent_start < position && byte(raw,exponent_start) == 48) { exponent_start += 1; }
        exponent_length = position - exponent_start;
    }
    if (position != count) { return core::result::Err(error(ErrorKind::Syntax,position)); }
    if (exponent_length == 0) { exponent_negative = false; }
    let total: i32 = integer_digits + fractional; let index: i32 = 0; let first: i32 = -1; let last: i32 = -1;
    while (index < total) {
        let offset: i32 = start + index; if (dot && index >= integer_digits) { offset += 1; }
        if (byte(raw,offset) != 48) { if (first < 0) { first = index; } last = index; }
        index += 1;
    }
    return core::result::Ok(Decimal { raw:raw, negative:negative, mantissa_start:start,
        integer_digits:integer_digits, total_digits:total, first:first, last:last, dot:dot,
        exponent_start:exponent_start, exponent_length:exponent_length, exponent_negative:exponent_negative });
}

fn coefficient_length(value: Decimal) -> i32 { return value.last - value.first + 1; }
fn coefficient_digit(value: Decimal, index: i32) -> u8 {
    let ordinal: i32 = value.first + index; let position: i32 = value.mantissa_start + ordinal;
    if (value.dot && ordinal >= value.integer_digits) { position += 1; }
    return byte(value.raw,position) - 48;
}
fn exponent_digit(value: Decimal, index: i32) -> u8 { return byte(value.raw,value.exponent_start + index) - 48; }
fn scale_offset(value: Decimal) -> i64 { return (value.integer_digits as i64) - 1 - (value.last as i64); }
fn order_offset(value: Decimal) -> i64 { return (value.integer_digits as i64) - (value.first as i64); }

impl Work {
    fn borrow(&self) -> &Work { return self; }
    fn step(&self) -> bool {
        if (self.remaining == 0) { self.failed = true; return false; }
        self.remaining -= 1; self.used += 1; return true;
    }
}
fn unlimited() -> Work { return Work { remaining:18446744073709551615,used:0,failed:false }; }
fn small_adjusted(value: Decimal, signed: i64) -> Adjusted {
    let magnitude: u64 = signed as u64; if (signed < 0) { magnitude = (0 - signed) as u64; }
    return Adjusted { source:value, negative:signed < 0, length:core::decimal::len_u64(magnitude) as i32,
        small:true, magnitude:magnitude, prefix_length:0, original_prefix:0, carry:0, pivot:0, tail:0 };
}

// Exponent plus a small signed offset, represented as virtual decimal digits.
// At most 18 low digits are materialized; the arbitrary prefix stays borrowed.
fn adjusted(value: Decimal, offset: i64, work: &Work) -> Adjusted {
    let count: i32 = value.exponent_length; let index: i32 = 0; let tail: i64 = 0;
    let start: i32 = 0; if (count > 18) { start = count - 18; }
    index = start;
    while (index < count) {
        if (!work.step()) { return small_adjusted(value,0); }
        tail = tail * 10 + (exponent_digit(value,index) as i64); index += 1;
    }
    if (count <= 18) {
        if (value.exponent_negative) { tail = 0 - tail; }
        return small_adjusted(value,tail + offset);
    }
    let change: i64 = offset; if (value.exponent_negative) { change = 0 - change; }
    tail += change; let carry: i32 = 0;
    if (tail < 0) { tail += BASE; carry = -1; }
    if (tail >= BASE) { tail -= BASE; carry = 1; }
    let prefix: i32 = count - 18; let length: i32 = prefix; let pivot: i32 = prefix - 1;
    if (carry != 0) {
        let run: u8 = 9; if (carry < 0) { run = 0; }
        while (pivot >= 0) {
            if (!work.step()) { return small_adjusted(value,0); }
            if (exponent_digit(value,pivot) != run) { break; } pivot -= 1;
        }
        if (carry > 0 && pivot < 0) { length += 1; }
        if (carry < 0 && pivot == 0 && exponent_digit(value,0) == 1) { length -= 1; }
    }
    if (length == 0) {
        let signed: i64 = tail; if (value.exponent_negative) { signed = 0 - signed; }
        return small_adjusted(value,signed);
    }
    return Adjusted { source:value, negative:value.exponent_negative, length:length + 18,
        small:false, magnitude:0, prefix_length:length, original_prefix:prefix, carry:carry, pivot:pivot, tail:tail as u64 };
}

fn numeric_digit(value: u64, length: i32, index: i32) -> u8 {
    let power: u64 = 1; let remaining: i32 = length - index - 1;
    while (remaining > 0) { power *= 10; remaining -= 1; }
    return ((value / power) % 10) as u8;
}
fn adjusted_digit(value: Adjusted, index: i32) -> u8 {
    if (value.small) { return numeric_digit(value.magnitude,value.length,index); }
    if (index >= value.prefix_length) { return numeric_digit(value.tail,18,index - value.prefix_length); }
    if (value.carry == 0) { return exponent_digit(value.source,index); }
    if (value.carry > 0 && value.pivot < 0) { if (index == 0) { return 1; } return 0; }
    if (value.prefix_length < value.original_prefix) { return 9; }
    if (index < value.pivot) { return exponent_digit(value.source,index); }
    if (index == value.pivot) { return ((exponent_digit(value.source,index) as i32) + value.carry) as u8; }
    if (value.carry > 0) { return 0; } return 9;
}
fn compare_adjusted(a: Adjusted, b: Adjusted, work: &Work) -> i32 {
    if (a.negative != b.negative) { if (a.negative) { return -1; } return 1; }
    let sign: i32 = 1; if (a.negative) { sign = -1; }
    if (a.length < b.length) { return 0 - sign; } if (a.length > b.length) { return sign; }
    let index: i32 = 0;
    while (index < a.length) {
        if (!work.step()) { return 0; }
        let left: u8 = adjusted_digit(a,index); let right: u8 = adjusted_digit(b,index);
        if (left < right) { return 0 - sign; } if (left > right) { return sign; } index += 1;
    }
    return 0;
}
fn compare_scales(a: Decimal, b: Decimal, additional_b: i64, work: &Work) -> i32 {
    let left: Adjusted = adjusted(a,scale_offset(a),work); if (work.failed) { return 0; }
    let right: Adjusted = adjusted(b,scale_offset(b) + additional_b,work); if (work.failed) { return 0; }
    return compare_adjusted(left,right,work);
}

pub impl Decimal {
    pub fn borrow(&self) -> &Decimal { return self; }
    fn copy(&self) -> Decimal {
        return Decimal { raw:self.raw, negative:self.negative, mantissa_start:self.mantissa_start,
            integer_digits:self.integer_digits, total_digits:self.total_digits, first:self.first, last:self.last, dot:self.dot,
            exponent_start:self.exponent_start, exponent_length:self.exponent_length, exponent_negative:self.exponent_negative };
    }
    pub fn is_zero(&self) -> bool { return self.first < 0; }
    // Lexical sign is retained for -0; compare/equal treat every zero equally.
    pub fn is_negative(&self) -> bool { return self.negative; }
    pub fn is_integer(&self) -> bool {
        if (self.first < 0) { return true; }
        let value: Decimal = self.copy(); let work: Work = unlimited(); let scale: Adjusted = adjusted(value,scale_offset(value),work.borrow());
        return !scale.negative;
    }
    pub fn compare(&self, other: Decimal) -> i32 {
        if (self.first < 0) { if (other.first < 0) { return 0; } if (other.negative) { return 1; } return -1; }
        if (other.first < 0) { if (self.negative) { return -1; } return 1; }
        if (self.negative != other.negative) { if (self.negative) { return -1; } return 1; }
        let sign: i32 = 1; if (self.negative) { sign = -1; }
        let value: Decimal = self.copy(); let work: Work = unlimited(); let left: Adjusted = adjusted(value,order_offset(value),work.borrow());
        let right: Adjusted = adjusted(other,order_offset(other),work.borrow());
        let order: i32 = compare_adjusted(left,right,work.borrow()); if (order != 0) { return sign * order; }
        let left_count: i32 = coefficient_length(value); let right_count: i32 = coefficient_length(other);
        let count: i32 = left_count; if (right_count > count) { count = right_count; }
        let index: i32 = 0;
        while (index < count) {
            let a: u8 = 0; let b: u8 = 0;
            if (index < left_count) { a = coefficient_digit(value,index); }
            if (index < right_count) { b = coefficient_digit(other,index); }
            if (a < b) { return 0 - sign; } if (a > b) { return sign; } index += 1;
        }
        return 0;
    }
    pub fn equal(&self, other: Decimal) -> bool { return self.compare(other) == 0; }
}

pub fn scratch_len(divisor: Decimal) -> core::result::Result<i32, Error> {
    if (divisor.is_zero()) { return core::result::Err(error(ErrorKind::ZeroDivisor,-1)); }
    let count: i32 = coefficient_length(divisor);
    if (count == 2147483647) { return core::result::Err(error(ErrorKind::CapacityOverflow,-1)); }
    return core::result::Ok(count + 1);
}
fn set(scratch: core::slice::View<u8>, index: i32, value: u8) { scratch.values[scratch.start + index] = value; }
fn remainder_zero(scratch: core::slice::View<u8>, width: i32, work: &Work) -> bool {
    let index: i32 = 0;
    while (index < width) { if (!work.step()) { return false; } if (byte(scratch,index) != 0) { return false; } index += 1; }
    return true;
}
fn remainder_compare(scratch: core::slice::View<u8>, width: i32, divisor: Decimal, work: &Work) -> i32 {
    let index: i32 = 0;
    while (index < width) {
        if (!work.step()) { return 0; }
        let a: u8 = byte(scratch,index); let b: u8 = 0; if (index > 0) { b = coefficient_digit(divisor,index - 1); }
        if (a < b) { return -1; } if (a > b) { return 1; } index += 1;
    }
    return 0;
}
// Prior remainder is < divisor, so shift+one digit requires at most 9 subtracts.
fn remainder_step(scratch: core::slice::View<u8>, width: i32, divisor: Decimal, next: u8, work: &Work) -> bool {
    let index: i32 = 0;
    while (index < width - 1) { if (!work.step()) { return false; } set(scratch,index,byte(scratch,index + 1)); index += 1; }
    if (!work.step()) { return false; } set(scratch,width - 1,next);
    while (true) {
        let comparison: i32 = remainder_compare(scratch,width,divisor,work);
        if (work.failed) { return false; } if (comparison < 0) { return true; }
        let borrow: i32 = 0; index = width - 1;
        while (index >= 0) {
            if (!work.step()) { return false; }
            let b: i32 = 0; if (index > 0) { b = coefficient_digit(divisor,index - 1) as i32; }
            let value: i32 = (byte(scratch,index) as i32) - b - borrow; borrow = 0;
            if (value < 0) { value += 10; borrow = 1; }
            set(scratch,index,value as u8); index -= 1;
        }
    }
    return false;
}

// Scratch contains numeric digits and must not alias either immutable input.
// Error can leave scratch changed; Bounds/ScratchTooSmall/ZeroDivisor do not.
pub fn is_multiple_of_counted(dividend: Decimal, divisor: Decimal, scratch: core::slice::View<u8>, max_work: u64)
    -> core::result::Result<Multiple, Error> {
    let needed: core::result::Result<i32,Error> = scratch_len(divisor);
    if (core::result::is_err(needed)) { return core::result::Err(core::result::unwrap_err(needed)); }
    if (!valid(scratch)) { return core::result::Err(error(ErrorKind::Bounds,-1)); }
    let width: i32 = core::result::unwrap(needed);
    if (scratch.len() < width) { return core::result::Err(error(ErrorKind::ScratchTooSmall,-1)); }
    let work: Work = Work { remaining:max_work,used:0,failed:false };
    if (!work.step()) { return core::result::Err(error(ErrorKind::WorkLimit,-1)); }
    if (dividend.is_zero()) { return core::result::Ok(Multiple {value:true,work:work.used}); }
    let order: i32 = compare_scales(dividend,divisor,0,work.borrow());
    if (work.failed) { return core::result::Err(error(ErrorKind::WorkLimit,-1)); }
    if (order < 0) { return core::result::Ok(Multiple {value:false,work:work.used}); }
    let index: i32 = 0;
    while (index < width) {
        if (!work.step()) { return core::result::Err(error(ErrorKind::WorkLimit,-1)); }
        set(scratch,index,0); index += 1;
    }
    let count: i32 = coefficient_length(dividend); index = 0;
    while (index < count) {
        if (!remainder_step(scratch,width,divisor,coefficient_digit(dividend,index),work.borrow())) { return core::result::Err(error(ErrorKind::WorkLimit,-1)); }
        index += 1;
    }
    let zero: bool = remainder_zero(scratch,width,work.borrow());
    if (work.failed) { return core::result::Err(error(ErrorKind::WorkLimit,-1)); }
    if (zero) { return core::result::Ok(Multiple {value:true,work:work.used}); }
    // B < 10^digits. v2(B) < 4*digits and v5(B) < 4*digits; every
    // repairable factor is exhausted by this cap, regardless of exponent size.
    let cap: i64 = (coefficient_length(divisor) as i64) * 4;
    let low: i64 = 0; let high: i64 = cap;
    while (low < high) {
        let middle: i64 = low + (high - low + 1) / 2;
        let comparison: i32 = compare_scales(dividend,divisor,middle,work.borrow());
        if (work.failed) { return core::result::Err(error(ErrorKind::WorkLimit,-1)); }
        if (comparison >= 0) { low = middle; } else { high = middle - 1; }
    }
    let step: i64 = 0;
    while (step < low) {
        if (!remainder_step(scratch,width,divisor,0,work.borrow())) { return core::result::Err(error(ErrorKind::WorkLimit,-1)); }
        zero = remainder_zero(scratch,width,work.borrow());
        if (work.failed) { return core::result::Err(error(ErrorKind::WorkLimit,-1)); }
        if (zero) { return core::result::Ok(Multiple {value:true,work:work.used}); } step += 1;
    }
    return core::result::Ok(Multiple {value:false,work:work.used});
}
pub fn is_multiple_of(dividend: Decimal, divisor: Decimal, scratch: core::slice::View<u8>, max_work: u64)
    -> core::result::Result<bool, Error> {
    let result: core::result::Result<Multiple,Error> = is_multiple_of_counted(dividend,divisor,scratch,max_work);
    if (core::result::is_err(result)) { return core::result::Err(core::result::unwrap_err(result)); }
    let multiple: Multiple = core::result::unwrap(result); return core::result::Ok(multiple.value);
}
