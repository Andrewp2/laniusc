// Allocation-free operations on caller-backed scalar views. The caller must
// keep each logical length within the physical backing view. Native indexing
// traps if the claimed length exceeds the backing and an index reaches it.
// Generic aggregate element types are not yet covered by executable tests.
module core::slice_generic;

// A negative length or out-of-range index returns fallback without indexing.
pub fn get_or<T>(values: [T], len: i32, index: i32, fallback: T) -> T {
    if (len <= 0 || index < 0 || index >= len) {
        return fallback;
    }
    return values[index];
}

// Invalid logical bounds leave the view unchanged.
pub fn set<T>(values: [T], len: i32, index: i32, value: T) -> bool {
    if (len <= 0 || index < 0 || index >= len) {
        return false;
    }
    values[index] = value;
    return true;
}

// A nonpositive length writes nothing and returns zero.
pub fn fill<T>(values: [T], len: i32, value: T) -> i32 {
    let index: i32 = 0;
    while (index < len) {
        values[index] = value;
        index += 1;
    }
    return index;
}
