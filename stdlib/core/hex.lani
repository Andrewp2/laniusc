// Allocation-free hexadecimal byte access and checked digit accumulation.
module core::hex;
import core::u8;

pub fn len_u32(value: u32) -> u32 {
    let remaining: u32 = value;
    let length: u32 = 1;
    while (remaining >= 16) {
        remaining >>= 4;
        length += 1;
    }
    return length;
}

fn nibble_at_u32(value: u32, index: u32, length: u32) -> u8 {
    let shift: u32 = (length - index - 1) * 4;
    let nibble: u32 = (value >> shift) & 15;
    return nibble as u8;
}

// Index zero is the most significant digit. An index outside the shortest
// representation returns fallback unchanged. Zero is represented as "0".
pub fn byte_at_lower_or_u32(value: u32, index: u32, fallback: u8) -> u8 {
    let length: u32 = len_u32(value);
    if (index >= length) {
        return fallback;
    }
    return core::u8::ascii_lower_hex_digit_or(nibble_at_u32(value, index, length), fallback);
}

pub fn byte_at_upper_or_u32(value: u32, index: u32, fallback: u8) -> u8 {
    let length: u32 = len_u32(value);
    if (index >= length) {
        return fallback;
    }
    return core::u8::ascii_upper_hex_digit_or(nibble_at_u32(value, index, length), fallback);
}

pub fn len_u8(value: u8) -> u32 {
    let widened: u32 = value as u32;
    return len_u32(widened);
}

pub fn byte_at_lower_or_u8(value: u8, index: u32, fallback: u8) -> u8 {
    let widened: u32 = value as u32;
    return byte_at_lower_or_u32(widened, index, fallback);
}

pub fn byte_at_upper_or_u8(value: u8, index: u32, fallback: u8) -> u8 {
    let widened: u32 = value as u32;
    return byte_at_upper_or_u32(widened, index, fallback);
}

pub fn len_u16(value: u16) -> u32 {
    let widened: u32 = value as u32;
    return len_u32(widened);
}

pub fn byte_at_lower_or_u16(value: u16, index: u32, fallback: u8) -> u8 {
    let widened: u32 = value as u32;
    return byte_at_lower_or_u32(widened, index, fallback);
}

pub fn byte_at_upper_or_u16(value: u16, index: u32, fallback: u8) -> u8 {
    let widened: u32 = value as u32;
    return byte_at_upper_or_u32(widened, index, fallback);
}

// Check syntax and bound before multiplication by 16. Limit may be below MAX.
pub fn can_append_ascii_digit_u32(current: u32, digit_byte: u8, limit: u32) -> bool {
    if (!core::u8::is_ascii_hexdigit(digit_byte)) {
        return false;
    }
    let digit: u8 = core::u8::ascii_hexdigit_value_or(digit_byte, 0);
    let widened: u32 = digit as u32;
    return current < limit / 16 || current == limit / 16 && widened <= limit % 16;
}

// Invalid input or overflow returns fallback. A successful value may equal
// fallback; call the predicate separately when that distinction matters.
pub fn append_ascii_digit_or_u32(current: u32, digit_byte: u8, limit: u32, fallback: u32) -> u32 {
    if (!can_append_ascii_digit_u32(current, digit_byte, limit)) {
        return fallback;
    }
    let digit: u8 = core::u8::ascii_hexdigit_value_or(digit_byte, 0);
    let widened: u32 = digit as u32;
    return current * 16 + widened;
}

// Parse exactly len ASCII codes from a backed [i32] view. An optional 0x or
// 0X prefix is accepted, but it must be followed by a digit. Whitespace,
// signs, malformed codes, empty input, and values above limit return fallback.
// An overstated physical view length can trap on native indexing.
fn parse_ascii_with_limit_or(values: [i32], len: i32, limit: u32, fallback: u32) -> u32 {
    if (len<=0) {
        return fallback;
    }
    let index: i32 = 0;
    if (len>=2 && values[0] == 48) {
        if (values[1] == 120 || values[1] == 88) {
            index = 2;
        }
    }
    if (index == len) {
        return fallback;
    }
    let result: u32 = 0;
    while (index<len) {
        let code: i32 = values[index];
        if (code<0 || code>255) {
            return fallback;
        }
        let byte: u8 = code as u8;
        if (!can_append_ascii_digit_u32(result, byte, limit)) {
            return fallback;
        }
        result = append_ascii_digit_or_u32(result, byte, limit, fallback);
        index += 1;
    }
    return result;
}

// A valid value may equal fallback; callers needing a separate success
// channel should reserve a fallback outside their accepted application range.
pub fn parse_ascii_u32_or(values: [i32], len: i32, fallback: u32) -> u32 {
    let maximum: u32 = 4294967295;
    return parse_ascii_with_limit_or(values, len, maximum, fallback);
}

pub fn parse_ascii_u16_or(values: [i32], len: i32, fallback: u16) -> u16 {
    let missing: u32 = 65536;
    let parsed: u32 = parse_ascii_with_limit_or(values, len, 65535, missing);
    if (parsed == missing) {
        return fallback;
    }
    return parsed as u16;
}

pub fn parse_ascii_u8_or(values: [i32], len: i32, fallback: u8) -> u8 {
    let missing: u32 = 256;
    let parsed: u32 = parse_ascii_with_limit_or(values, len, 255, missing);
    if (parsed == missing) {
        return fallback;
    }
    return parsed as u8;
}
