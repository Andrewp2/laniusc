// A concrete u16 result with an u16 error code until generic enums execute.
// The inactive payload is zero; inspect `success` before reading a payload.
module core::result_u16;

pub struct ResultU16 {
    success: bool,
    value: u16,
    error: u16,
}

pub fn ok(value: u16) -> ResultU16 {
    return ResultU16 { success: true, value: value, error: 0 };
}

pub fn err(error: u16) -> ResultU16 {
    return ResultU16 { success: false, value: 0, error: error };
}

pub fn is_ok(value: ResultU16) -> bool {
    return value.success;
}

pub fn is_err(value: ResultU16) -> bool {
    return !value.success;
}

pub fn contains(value: ResultU16, expected: u16) -> bool {
    return value.success && value.value == expected;
}

pub fn contains_err(value: ResultU16, expected: u16) -> bool {
    return !value.success && value.error == expected;
}

pub fn unwrap_or(value: ResultU16, fallback: u16) -> u16 {
    if (value.success) { return value.value; }
    return fallback;
}

pub fn unwrap_err_or(value: ResultU16, fallback: u16) -> u16 {
    if (!value.success) { return value.error; }
    return fallback;
}

pub fn or(value: ResultU16, fallback: ResultU16) -> ResultU16 {
    if (value.success) { return value; }
    return fallback;
}

pub fn and(value: ResultU16, next: ResultU16) -> ResultU16 {
    if (value.success) { return next; }
    return value;
}

pub impl ResultU16 {
    pub fn is_ok(&self) -> bool { return self.success; }
    pub fn is_err(&self) -> bool { return !self.success; }
    pub fn contains(&self, expected: u16) -> bool {
        return self.success && self.value == expected;
    }
    pub fn contains_err(&self, expected: u16) -> bool {
        return !self.success && self.error == expected;
    }
    pub fn unwrap_or(&self, fallback: u16) -> u16 {
        if (self.success) { return self.value; }
        return fallback;
    }
    pub fn unwrap_err_or(&self, fallback: u16) -> u16 {
        if (!self.success) { return self.error; }
        return fallback;
    }
    pub fn or(&self, fallback: ResultU16) -> ResultU16 {
        if (self.success) {
            return ResultU16 { success: true, value: self.value, error: 0 };
        }
        return fallback;
    }
    pub fn and(&self, next: ResultU16) -> ResultU16 {
        if (self.success) { return next; }
        return ResultU16 { success: false, value: 0, error: self.error };
    }
}
