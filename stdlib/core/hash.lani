// Scalar hashes and caller-backed FNV-1a hashing.

module core::hash;

import core::number_u32;
import core::wide_u64;
import core::wide_i64;

// Stable, noncryptographic 32-bit FNV-1a hashing for caller-backed byte views.
pub const FNV1A_OFFSET_BASIS: u32 = 2166136261;
pub const FNV1A_PRIME: u32 = 16777619;

pub trait Hash<T> {
    pub fn hash(value: T) -> u32;
}

pub impl Hash<i32> for i32 {
    pub fn hash(value: i32) -> u32 {
        return value as u32;
    }
}

pub impl Hash<u32> for u32 {
    pub fn hash(value: u32) -> u32 { return value; }
}

pub impl Hash<bool> for bool {
    pub fn hash(value: bool) -> u32 {
        if (value) { return 1; } else { return 0; }
    }
}

pub impl Hash<char> for char {
    pub fn hash(value: char) -> u32 { return value as u32; }
}

pub fn hash_i32(value: i32) -> u32 {
    return i32::hash(value);
}

pub fn hash_u32(value: u32) -> u32 { return u32::hash(value); }
pub fn hash_bool(value: bool) -> u32 { return bool::hash(value); }
pub fn hash_char(value: char) -> u32 { return char::hash(value); }

// Narrow integers widen explicitly and return the 32-bit bit pattern.
pub fn hash_i8(value: i8) -> u32 {
    let widened: i32 = value as i32;
    return widened as u32;
}

pub fn hash_i16(value: i16) -> u32 {
    let widened: i32 = value as i32;
    return widened as u32;
}

pub fn hash_u8(value: u8) -> u32 {
    let widened: u32 = value as u32;
    return widened;
}

pub fn hash_u16(value: u16) -> u32 {
    let widened: u32 = value as u32;
    return widened;
}

pub impl Hash<i8> for i8 {
    pub fn hash(value: i8) -> u32 { return hash_i8(value); }
}
pub impl Hash<i16> for i16 {
    pub fn hash(value: i16) -> u32 { return hash_i16(value); }
}
pub impl Hash<u8> for u8 {
    pub fn hash(value: u8) -> u32 { return hash_u8(value); }
}
pub impl Hash<u16> for u16 {
    pub fn hash(value: u16) -> u32 { return hash_u16(value); }
}
pub impl Hash<u64> for u64 {
    pub fn hash(value: u64) -> u32 {
        let state: u32 = fnv1a_word_le(FNV1A_OFFSET_BASIS, value as u32);
        return fnv1a_word_le(state, (value >> 32) as u32);
    }
}
pub impl Hash<i64> for i64 {
    pub fn hash(value: i64) -> u32 { return u64::hash(value as u64); }
}
pub impl Hash<usize> for usize {
    pub fn hash(value: usize) -> u32 { return u64::hash(value as u64); }
}
pub impl Hash<isize> for isize {
    pub fn hash(value: isize) -> u32 { return u64::hash(value as u64); }
}

pub fn fnv1a_step(state: u32, value: u8) -> u32 {
    let byte: u32 = value as u32;
    return core::number_u32::wrapping_mul(state ^ byte, FNV1A_PRIME);
}

fn fnv1a_word_le(state: u32, word: u32) -> u32 {
    let first: u32 = word & 255;
    let second: u32 = (word >> 8) & 255;
    let third: u32 = (word >> 16) & 255;
    let fourth: u32 = (word >> 24) & 255;
    let next: u32 = fnv1a_step(state, first as u8);
    next = fnv1a_step(next, second as u8);
    next = fnv1a_step(next, third as u8);
    return fnv1a_step(next, fourth as u8);
}

// FNV-1a over the low word followed by the high word, each in little-endian
// byte order. Signed values use their two's-complement bit pattern.
pub fn hash_wide_u64(value: core::wide_u64::WideU64) -> u32 {
    let state: u32 = fnv1a_word_le(FNV1A_OFFSET_BASIS, core::wide_u64::low_word(value));
    return fnv1a_word_le(state, core::wide_u64::high_word(value));
}

pub fn hash_wide_i64(value: core::wide_i64::WideI64) -> u32 {
    let state: u32 = fnv1a_word_le(FNV1A_OFFSET_BASIS, core::wide_i64::low_word(value));
    return fnv1a_word_le(state, core::wide_i64::high_word(value));
}

// A negative logical length returns fallback. A length greater than the
// physical view traps when indexing reaches its end.
pub fn fnv1a_bytes_or(values: [u8], len: i32, fallback: u32) -> u32 {
    if (len < 0) {
        return fallback;
    }
    let state: u32 = FNV1A_OFFSET_BASIS;
    let index: i32 = 0;
    while (index < len) {
        state = fnv1a_step(state, values[index]);
        index += 1;
    }
    return state;
}
