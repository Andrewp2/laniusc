// Scalar hashes and caller-backed FNV-1a hashing.

module core::hash;

import core::number_u32;

// Stable, noncryptographic 32-bit FNV-1a hashing for caller-backed byte views.
pub const FNV1A_OFFSET_BASIS: u32 = 2166136261;
pub const FNV1A_PRIME: u32 = 16777619;

pub trait Hash<T> {
    pub fn hash(value: T) -> u32;
}

pub impl Hash<i32> for i32 {
    pub fn hash(value: i32) -> u32 {
        return value;
    }
}

pub impl Hash<u32> for u32 {
    pub fn hash(value: u32) -> u32 { return value; }
}

pub impl Hash<bool> for bool {
    pub fn hash(value: bool) -> u32 {
        if (value) { return 1; } else { return 0; }
    }
}

pub impl Hash<char> for char {
    pub fn hash(value: char) -> u32 { return value as u32; }
}

pub fn hash_i32(value: i32) -> u32 {
    return i32::hash(value);
}

pub fn hash_u32(value: u32) -> u32 { return u32::hash(value); }
pub fn hash_bool(value: bool) -> u32 { return bool::hash(value); }
pub fn hash_char(value: char) -> u32 { return char::hash(value); }

// Narrow integer trait keys collide with the corresponding 32-bit key, so
// these entry points widen explicitly and return the 32-bit bit pattern.
pub fn hash_i8(value: i8) -> u32 {
    let widened: i32 = value;
    return widened as u32;
}

pub fn hash_i16(value: i16) -> u32 {
    let widened: i32 = value;
    return widened as u32;
}

pub fn hash_u8(value: u8) -> u32 {
    let widened: u32 = value;
    return widened;
}

pub fn hash_u16(value: u16) -> u32 {
    let widened: u32 = value;
    return widened;
}

pub fn fnv1a_step(state: u32, value: u8) -> u32 {
    let byte: u32 = value;
    return core::number_u32::wrapping_mul(state ^ byte, FNV1A_PRIME);
}

// A negative logical length returns fallback. A length greater than the
// physical view traps when indexing reaches its end.
pub fn fnv1a_bytes_or(values: [u8], len: i32, fallback: u32) -> u32 {
    if (len < 0) {
        return fallback;
    }
    let state: u32 = FNV1A_OFFSET_BASIS;
    let index: i32 = 0;
    while (index < len) {
        state = fnv1a_step(state, values[index]);
        index += 1;
    }
    return state;
}
