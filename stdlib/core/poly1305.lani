// RFC 8439 section 2.5 Poly1305, with five 26-bit limbs and u64 products.
// One-time key authority is manual: copying State does not authorize another
// message with that key. No reset, allocation, retained view or implicit erase.
module core::poly1305;
import core::result;
import core::slice;

pub enum Error { Bounds, InvalidKeyLength, LengthOverflow, Finished }
pub struct Tag { bytes: [u8;16] }
pub struct State {
    r0:u64, r1:u64, r2:u64, r3:u64, r4:u64, s1:u64, s2:u64, s3:u64, s4:u64,
    h0:u64, h1:u64, h2:u64, h3:u64, h4:u64,
    pad0:u64, pad1:u64, pad2:u64, pad3:u64,
    tag0:u64, tag1:u64, tag2:u64, tag3:u64,
    total:u64, used:i32, block:[u8;16], finished:bool
}
const MASK: u64 = 67108863;
const WORD: u64 = 4294967295;
fn valid(input: core::slice::View<u8>) -> bool { return input.start >= 0 && input.length >= 0 && input.start <= 2147483647-input.length; }
fn load(bytes: [u8], offset: i32) -> u64 { return (bytes[offset] as u64) | ((bytes[offset+1] as u64)<<8) | ((bytes[offset+2] as u64)<<16) | ((bytes[offset+3] as u64)<<24); }

pub fn new(key: core::slice::View<u8>) -> core::result::Result<State,Error> {
    if (!valid(key)) { return core::result::Err(Error::Bounds); }
    if (key.length != 32) { return core::result::Err(Error::InvalidKeyLength); }
    // These overlapping little-endian reads implement the exact RFC clamp:
    // clear key[3,7,11,15]'s top four bits and key[4,8,12]'s bottom two bits.
    let r0:u64=load(key.values,key.start)&0x3ffffff;
    let r1:u64=(load(key.values,key.start+3)>>2)&0x3ffff03;
    let r2:u64=(load(key.values,key.start+6)>>4)&0x3ffc0ff;
    let r3:u64=(load(key.values,key.start+9)>>6)&0x3f03fff;
    let r4:u64=(load(key.values,key.start+12)>>8)&0x00fffff;
    let block:[u8;16]=[0;16];
    return core::result::Ok(State { r0:r0,r1:r1,r2:r2,r3:r3,r4:r4,s1:r1*5,s2:r2*5,s3:r3*5,s4:r4*5,
        h0:0,h1:0,h2:0,h3:0,h4:0,pad0:load(key.values,key.start+16),pad1:load(key.values,key.start+20),pad2:load(key.values,key.start+24),pad3:load(key.values,key.start+28),
        tag0:0,tag1:0,tag2:0,tag3:0,total:0,used:0,block:block,finished:false });
}

pub impl State {
    pub fn borrow(&self) -> &State { return self; }
    // hibit is 2^24 for a full block. A partial block already contains its
    // appended 1 byte and uses hibit=0. This distinction depends only on length.
    fn compress(&self, hibit:u64) {
        let h0:u64=self.h0+(load(self.block,0)&MASK);
        let h1:u64=self.h1+((load(self.block,3)>>2)&MASK);
        let h2:u64=self.h2+((load(self.block,6)>>4)&MASK);
        let h3:u64=self.h3+((load(self.block,9)>>6)&MASK);
        let h4:u64=self.h4+((load(self.block,12)>>8)|hibit);
        // B=2^26. At entry h1<B+2^10 and other stored limbs<B. Adding a
        // block keeps all factors below 3B; r_i<B and 5*r_i<5B. Each sum
        // is <75B^2; with propagated carry it is <76B^2<2^59, inside u64.
        let d0:u64=h0*self.r0+h1*self.s4+h2*self.s3+h3*self.s2+h4*self.s1;
        let d1:u64=h0*self.r1+h1*self.r0+h2*self.s4+h3*self.s3+h4*self.s2;
        let d2:u64=h0*self.r2+h1*self.r1+h2*self.r0+h3*self.s4+h4*self.s3;
        let d3:u64=h0*self.r3+h1*self.r2+h2*self.r1+h3*self.r0+h4*self.s4;
        let d4:u64=h0*self.r4+h1*self.r3+h2*self.r2+h3*self.r1+h4*self.r0;
        let carry:u64=d0>>26; self.h0=d0&MASK; d1+=carry;
        carry=d1>>26; self.h1=d1&MASK; d2+=carry;
        carry=d2>>26; self.h2=d2&MASK; d3+=carry;
        carry=d3>>26; self.h3=d3&MASK; d4+=carry;
        carry=d4>>26; self.h4=d4&MASK;
        // B^5 == 5 modulo p. carry<2^33, so the final carry into h1 is
        // below 641 and h1<B+2^10 is restored. Every other limb is below B.
        self.h0+=carry*5; carry=self.h0>>26; self.h0&=MASK; self.h1+=carry; self.used=0;
    }
    // The caller physically backs the full logical slice and keeps it immutable
    // and disjoint from this State. Error checks precede every state mutation.
    pub fn update(&self, message:core::slice::View<u8>) -> core::result::Result<i32,Error> {
        if (!valid(message)) { return core::result::Err(Error::Bounds); }
        if (self.finished) { return core::result::Err(Error::Finished); }
        if ((message.length as u64) > 18446744073709551615-self.total) { return core::result::Err(Error::LengthOverflow); }
        let i:i32=0;
        while (i < message.length) {
            self.block[self.used]=message.values[message.start+i]; self.used+=1;
            if (self.used == 16) { self.compress(16777216); } i+=1;
        }
        self.total+=message.length as u64; return core::result::Ok(i);
    }
    pub fn finish(&self) -> Tag {
        if (!self.finished) {
            if (self.used > 0) {
                self.block[self.used]=1; let i:i32=self.used+1;
                while (i < 16) { self.block[i]=0; i+=1; } self.compress(0);
            }
            // Fixed carry sweep normalizes all five limbs below B. At most
            // one carry propagates from h1 and folds from h4 into h0.
            let carry:u64=self.h1>>26; self.h1&=MASK; self.h2+=carry;
            carry=self.h2>>26; self.h2&=MASK; self.h3+=carry;
            carry=self.h3>>26; self.h3&=MASK; self.h4+=carry;
            carry=self.h4>>26; self.h4&=MASK; self.h0+=carry*5;
            carry=self.h0>>26; self.h0&=MASK; self.h1+=carry;
            // h is now in [0,2^130). h+5 carries iff h>=p. Select h-p or h
            // with an arithmetic all-ones/all-zero mask, without a secret test.
            let g0:u64=self.h0+5; carry=g0>>26; g0&=MASK;
            let g1:u64=self.h1+carry; carry=g1>>26; g1&=MASK;
            let g2:u64=self.h2+carry; carry=g2>>26; g2&=MASK;
            let g3:u64=self.h3+carry; carry=g3>>26; g3&=MASK;
            let g4:u64=self.h4+carry; let select:u64=0-(g4>>26); g4&=MASK;
            let keep:u64=select^18446744073709551615;
            self.h0=(self.h0&keep)|(g0&select); self.h1=(self.h1&keep)|(g1&select); self.h2=(self.h2&keep)|(g2&select);
            self.h3=(self.h3&keep)|(g3&select); self.h4=(self.h4&keep)|(g4&select);
            // Add the 128-bit pad in four 32-bit columns. Each sum is below
            // 2^33; truncating the last carry implements addition modulo 2^128.
            let f0:u64=((self.h0|(self.h1<<26))&WORD)+self.pad0;
            let f1:u64=(((self.h1>>6)|(self.h2<<20))&WORD)+self.pad1+(f0>>32);
            let f2:u64=(((self.h2>>12)|(self.h3<<14))&WORD)+self.pad2+(f1>>32);
            let f3:u64=(((self.h3>>18)|(self.h4<<8))&WORD)+self.pad3+(f2>>32);
            self.tag0=f0&WORD; self.tag1=f1&WORD; self.tag2=f2&WORD; self.tag3=f3&WORD; self.finished=true;
        }
        let words:[u64;4]=[self.tag0,self.tag1,self.tag2,self.tag3]; let bytes:[u8;16]=[0;16]; let i:i32=0;
        while (i < 16) { bytes[i]=((words[i/4]>>(((i%4)*8) as u32))&255) as u8; i+=1; }
        return Tag { bytes:bytes };
    }
}
pub fn authenticate(key:core::slice::View<u8>, message:core::slice::View<u8>) -> core::result::Result<Tag,Error> {
    if (!valid(key) || !valid(message)) { return core::result::Err(Error::Bounds); }
    let made:core::result::Result<State,Error> = new(key);
    if (made.is_err()) { return core::result::Err(made.unwrap_err()); }
    let state:State=made.unwrap(); let updated:core::result::Result<i32,Error> = state.update(message);
    if (updated.is_err()) { return core::result::Err(updated.unwrap_err()); } return core::result::Ok(state.finish());
}
