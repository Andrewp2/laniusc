// A concrete optional character until generic enum values execute natively.
// The inactive payload is NUL; inspect present before reading it.
module core::option_char;
import core::result_char;

pub struct OptionChar {
    present: bool,
    value: char,
}

pub fn some(value: char) -> OptionChar {
    return OptionChar { present: true, value: value };
}

pub fn none() -> OptionChar {
    return OptionChar { present: false, value: '\0' };
}

pub fn is_some(value: OptionChar) -> bool {
    return value.present;
}

pub fn is_none(value: OptionChar) -> bool {
    return !value.present;
}

pub fn contains(value: OptionChar, expected: char) -> bool {
    return value.present && value.value == expected;
}

pub fn unwrap_or(value: OptionChar, fallback: char) -> char {
    if (value.present) { return value.value; }
    return fallback;
}

pub fn or(value: OptionChar, fallback: OptionChar) -> OptionChar {
    if (value.present) { return value; }
    return fallback;
}

pub fn and(value: OptionChar, next: OptionChar) -> OptionChar {
    if (value.present) { return next; }
    return value;
}

pub fn xor(left: OptionChar, right: OptionChar) -> OptionChar {
    if (left.present) {
        if (right.present) { return none(); }
        return left;
    }
    return right;
}

pub fn ok_or(value: OptionChar, error: char) -> core::result_char::ResultChar {
    if (value.present) { return core::result_char::ok(value.value); }
    return core::result_char::err(error);
}

pub fn ok(value: core::result_char::ResultChar) -> OptionChar {
    if (core::result_char::is_ok(value)) {
        return some(core::result_char::unwrap_or(value, '\0'));
    }
    return none();
}

pub fn err(value: core::result_char::ResultChar) -> OptionChar {
    if (core::result_char::is_err(value)) {
        return some(core::result_char::unwrap_err_or(value, '\0'));
    }
    return none();
}

pub impl OptionChar {
    pub fn is_some(&self) -> bool { return self.present; }
    pub fn is_none(&self) -> bool { return !self.present; }
    pub fn contains(&self, expected: char) -> bool {
        return self.present && self.value == expected;
    }
    pub fn unwrap_or(&self, fallback: char) -> char {
        if (self.present) { return self.value; }
        return fallback;
    }
    pub fn or(&self, fallback: OptionChar) -> OptionChar {
        if (self.present) { return OptionChar { present: true, value: self.value }; }
        return fallback;
    }
    pub fn and(&self, next: OptionChar) -> OptionChar {
        if (self.present) { return next; }
        return none();
    }
    pub fn xor(&self, right: OptionChar) -> OptionChar {
        if (self.present) {
            if (right.present) { return none(); }
            return OptionChar { present: true, value: self.value };
        }
        return right;
    }
    pub fn ok_or(&self, error: char) -> core::result_char::ResultChar {
        if (self.present) { return core::result_char::ok(self.value); }
        return core::result_char::err(error);
    }
}
