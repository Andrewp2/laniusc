// Checked arithmetic for portable two-word signed values. Overflow returns
// None; it never relies on native i64 arithmetic.
module core::wide_i64_checked;
import core::option::Option;
import core::option::Some;
import core::option::None;
import core::option::unwrap_or;
import core::option::is_some;
import core::wide_i64;
import core::wide_u64;

pub fn checked_add(
    left: core::wide_i64::WideI64, right: core::wide_i64::WideI64
) -> Option<core::wide_i64::WideI64> {
    let sum: core::wide_i64::WideI64 = core::wide_i64::wrapping_add(left, right);
    if (core::wide_i64::is_negative(left) == core::wide_i64::is_negative(right) &&
        core::wide_i64::is_negative(sum) != core::wide_i64::is_negative(left)) {
        return None();
    }
    return Some(sum);
}

pub fn checked_sub(
    left: core::wide_i64::WideI64, right: core::wide_i64::WideI64
) -> Option<core::wide_i64::WideI64> {
    let difference: core::wide_i64::WideI64 = core::wide_i64::wrapping_sub(left, right);
    if (core::wide_i64::is_negative(left) != core::wide_i64::is_negative(right) &&
        core::wide_i64::is_negative(difference) != core::wide_i64::is_negative(left)) {
        return None();
    }
    return Some(difference);
}

pub fn checked_neg(value: core::wide_i64::WideI64) -> Option<core::wide_i64::WideI64> {
    if (core::wide_i64::eq(value, core::wide_i64::min_value())) {
        return None();
    }
    return Some(core::wide_i64::wrapping_neg(value));
}

pub fn checked_abs(value: core::wide_i64::WideI64) -> Option<core::wide_i64::WideI64> {
    if (core::wide_i64::is_negative(value)) { return checked_neg(value); }
    return Some(value);
}

fn unsigned_magnitude(value: core::wide_i64::WideI64) -> core::wide_u64::WideU64 {
    let magnitude: core::wide_i64::WideI64 = value;
    if (core::wide_i64::is_negative(value)) {
        magnitude = core::wide_i64::wrapping_neg(value);
    }
    return core::wide_u64::from_words(
        core::wide_i64::high_word(magnitude), core::wide_i64::low_word(magnitude));
}

pub fn checked_mul(
    left: core::wide_i64::WideI64, right: core::wide_i64::WideI64
) -> Option<core::wide_i64::WideI64> {
    if (core::wide_i64::is_zero(left) || core::wide_i64::is_zero(right)) {
        return Some(core::wide_i64::zero());
    }
    let negative: bool =
        core::wide_i64::is_negative(left) != core::wide_i64::is_negative(right);
    let limit: core::wide_u64::WideU64 =
        core::wide_u64::from_words(2147483647, 4294967295);
    if (negative) { limit = core::wide_u64::from_words(2147483648, 0); }
    let left_magnitude: core::wide_u64::WideU64 = unsigned_magnitude(left);
    let right_magnitude: core::wide_u64::WideU64 = unsigned_magnitude(right);
    let bound: core::wide_u64::WideU64 = core::wide_u64::divide_or(
        limit, left_magnitude, core::wide_u64::zero());
    if (core::wide_u64::compare(right_magnitude, bound) > 0) {
        return None();
    }
    return Some(core::wide_i64::wrapping_mul(left, right));
}

pub fn checked_div(
    left: core::wide_i64::WideI64, right: core::wide_i64::WideI64
) -> Option<core::wide_i64::WideI64> {
    if (core::wide_i64::is_zero(right) ||
        (core::wide_i64::eq(left, core::wide_i64::min_value()) &&
         core::wide_i64::eq(right, core::wide_i64::from_i32(-1)))) {
        return None();
    }
    return Some(
        core::wide_i64::divide_or(left, right, core::wide_i64::zero()));
}

pub fn checked_rem(
    left: core::wide_i64::WideI64, right: core::wide_i64::WideI64
) -> Option<core::wide_i64::WideI64> {
    if (core::wide_i64::is_zero(right) ||
        (core::wide_i64::eq(left, core::wide_i64::min_value()) &&
         core::wide_i64::eq(right, core::wide_i64::from_i32(-1)))) {
        return None();
    }
    return Some(
        core::wide_i64::remainder_or(left, right, core::wide_i64::zero()));
}

// Exponentiation by squaring. 0^0 is one; unrepresentable products are None.
pub fn checked_pow(
    base: core::wide_i64::WideI64, exponent: u32
) -> Option<core::wide_i64::WideI64> {
    let result: core::wide_i64::WideI64 = core::wide_i64::from_i32(1);
    let factor: core::wide_i64::WideI64 = base;
    let remaining: u32 = exponent;
    while (remaining > 0) {
        if ((remaining & 1) != 0) {
            result = checked_mul(result, factor)?;
        }
        remaining = remaining >> 1;
        if (remaining > 0) {
            factor = checked_mul(factor, factor)?;
        }
    }
    return Some(result);
}

pub fn saturating_mul(
    left: core::wide_i64::WideI64, right: core::wide_i64::WideI64
) -> core::wide_i64::WideI64 {
    let product: Option<core::wide_i64::WideI64> = checked_mul(left, right);
    if (is_some(product)) {
        return unwrap_or(product, core::wide_i64::zero());
    }
    if (core::wide_i64::is_negative(left) != core::wide_i64::is_negative(right)) {
        return core::wide_i64::min_value();
    }
    return core::wide_i64::max_value();
}

pub fn saturating_neg(value: core::wide_i64::WideI64) -> core::wide_i64::WideI64 {
    return unwrap_or(
        checked_neg(value), core::wide_i64::max_value());
}

pub fn saturating_abs(value: core::wide_i64::WideI64) -> core::wide_i64::WideI64 {
    return unwrap_or(
        checked_abs(value), core::wide_i64::max_value());
}
