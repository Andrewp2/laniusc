// A concrete optional u8 until generic enum values execute natively.
// `value` is zero for None and must be read only when `present` is true.
module core::option_u8;
import core::result_u8;

pub struct OptionU8 {
    present: bool,
    value: u8,
}

pub fn some(value: u8) -> OptionU8 {
    return OptionU8 { present: true, value: value };
}

pub fn none() -> OptionU8 {
    return OptionU8 { present: false, value: 0 };
}

pub fn is_some(value: OptionU8) -> bool {
    return value.present;
}

pub fn is_none(value: OptionU8) -> bool {
    return !value.present;
}

pub fn contains(value: OptionU8, expected: u8) -> bool {
    return value.present && value.value == expected;
}

pub fn unwrap_or(value: OptionU8, fallback: u8) -> u8 {
    if (value.present) { return value.value; }
    return fallback;
}

pub fn or(value: OptionU8, fallback: OptionU8) -> OptionU8 {
    if (value.present) { return value; }
    return fallback;
}

pub fn and(value: OptionU8, next: OptionU8) -> OptionU8 {
    if (value.present) { return next; }
    return value;
}

pub fn xor(left: OptionU8, right: OptionU8) -> OptionU8 {
    if (left.present) {
        if (right.present) { return none(); }
        return left;
    }
    return right;
}

pub fn ok_or(value: OptionU8, error: u8) -> core::result_u8::ResultU8 {
    if (value.present) { return core::result_u8::ok(value.value); }
    return core::result_u8::err(error);
}

pub fn ok(value: core::result_u8::ResultU8) -> OptionU8 {
    if (core::result_u8::is_ok(value)) {
        return some(core::result_u8::unwrap_or(value, 0));
    }
    return none();
}

pub fn err(value: core::result_u8::ResultU8) -> OptionU8 {
    if (core::result_u8::is_err(value)) {
        return some(core::result_u8::unwrap_err_or(value, 0));
    }
    return none();
}

pub impl OptionU8 {
    pub fn is_some(&self) -> bool { return self.present; }
    pub fn is_none(&self) -> bool { return !self.present; }
    pub fn contains(&self, expected: u8) -> bool {
        return self.present && self.value == expected;
    }
    pub fn unwrap_or(&self, fallback: u8) -> u8 {
        if (self.present) { return self.value; }
        return fallback;
    }
    pub fn or(&self, fallback: OptionU8) -> OptionU8 {
        if (self.present) { return OptionU8 { present: true, value: self.value }; }
        return fallback;
    }
    pub fn and(&self, next: OptionU8) -> OptionU8 {
        if (self.present) { return next; }
        return none();
    }
    pub fn xor(&self, right: OptionU8) -> OptionU8 {
        if (self.present) {
            if (right.present) { return none(); }
            return OptionU8 { present: true, value: self.value };
        }
        return right;
    }
    pub fn ok_or(&self, error: u8) -> core::result_u8::ResultU8 {
        if (self.present) { return core::result_u8::ok(self.value); }
        return core::result_u8::err(error);
    }
}
