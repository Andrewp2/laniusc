// A concrete u8 result with an u8 error code until generic enums execute.
// The inactive payload is zero; inspect `success` before reading a payload.
module core::result_u8;

pub struct ResultU8 {
    success: bool,
    value: u8,
    error: u8,
}

pub fn ok(value: u8) -> ResultU8 {
    return ResultU8 { success: true, value: value, error: 0 };
}

pub fn err(error: u8) -> ResultU8 {
    return ResultU8 { success: false, value: 0, error: error };
}

pub fn is_ok(value: ResultU8) -> bool {
    return value.success;
}

pub fn is_err(value: ResultU8) -> bool {
    return !value.success;
}

pub fn contains(value: ResultU8, expected: u8) -> bool {
    return value.success && value.value == expected;
}

pub fn contains_err(value: ResultU8, expected: u8) -> bool {
    return !value.success && value.error == expected;
}

pub fn unwrap_or(value: ResultU8, fallback: u8) -> u8 {
    if (value.success) { return value.value; }
    return fallback;
}

pub fn unwrap_err_or(value: ResultU8, fallback: u8) -> u8 {
    if (!value.success) { return value.error; }
    return fallback;
}

pub fn or(value: ResultU8, fallback: ResultU8) -> ResultU8 {
    if (value.success) { return value; }
    return fallback;
}

pub fn and(value: ResultU8, next: ResultU8) -> ResultU8 {
    if (value.success) { return next; }
    return value;
}

pub impl ResultU8 {
    pub fn is_ok(&self) -> bool { return self.success; }
    pub fn is_err(&self) -> bool { return !self.success; }
    pub fn contains(&self, expected: u8) -> bool {
        return self.success && self.value == expected;
    }
    pub fn contains_err(&self, expected: u8) -> bool {
        return !self.success && self.error == expected;
    }
    pub fn unwrap_or(&self, fallback: u8) -> u8 {
        if (self.success) { return self.value; }
        return fallback;
    }
    pub fn unwrap_err_or(&self, fallback: u8) -> u8 {
        if (!self.success) { return self.error; }
        return fallback;
    }
    pub fn or(&self, fallback: ResultU8) -> ResultU8 {
        if (self.success) {
            return ResultU8 { success: true, value: self.value, error: 0 };
        }
        return fallback;
    }
    pub fn and(&self, next: ResultU8) -> ResultU8 {
        if (self.success) { return next; }
        return ResultU8 { success: false, value: 0, error: self.error };
    }
}
