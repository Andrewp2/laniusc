// Allocation-free signed 16-bit scalar and concrete aggregate ranges.
module core::range_i16;

// Half-open [start, end). Equal or reversed bounds are empty.
pub fn half_open_is_empty(start: i16, end: i16) -> bool {
    return start >= end;
}

pub fn half_open_contains(start: i16, end: i16, value: i16) -> bool {
    return value >= start && value < end;
}

pub fn half_open_overlaps(left_start: i16, left_end: i16, right_start: i16, right_end: i16) -> bool {
    return left_start < left_end && right_start < right_end &&
        left_start < right_end && right_start < left_end;
}

// Inclusive [start, end]. Equal bounds contain exactly one value.
pub fn inclusive_is_empty(start: i16, end: i16) -> bool {
    return start > end;
}

pub fn inclusive_contains(start: i16, end: i16, value: i16) -> bool {
    return value >= start && value <= end;
}

pub fn inclusive_overlaps(left_start: i16, left_end: i16, right_start: i16, right_end: i16) -> bool {
    return left_start <= left_end && right_start <= right_end &&
        left_start <= right_end && right_start <= left_end;
}

pub fn from_contains(start: i16, value: i16) -> bool {
    return value >= start;
}

pub fn to_contains(end: i16, value: i16) -> bool {
    return value < end;
}

// A full signed 16-bit range contains every i16 value.
pub fn full_contains(value: i16) -> bool {
    return true;
}

// Caller-owned concrete range values for this width. Scalar predicates above
// remain convenient when no aggregate needs to cross a function boundary.
pub struct RangeI16 { start: i16, end: i16, }
pub struct RangeInclusiveI16 { start: i16, end: i16, }
pub struct RangeFromI16 { start: i16, }
pub struct RangeToI16 { end: i16, }

pub fn range(start: i16, end: i16) -> RangeI16 {
    return RangeI16 { start: start, end: end };
}
pub fn start(value: RangeI16) -> i16 { return value.start; }
pub fn end(value: RangeI16) -> i16 { return value.end; }
pub fn is_empty(value: RangeI16) -> bool {
    return half_open_is_empty(value.start, value.end);
}
pub fn contains(value: RangeI16, item: i16) -> bool {
    return half_open_contains(value.start, value.end, item);
}
pub fn overlaps(left: RangeI16, right: RangeI16) -> bool {
    return half_open_overlaps(left.start, left.end, right.start, right.end);
}

pub fn range_inclusive(start: i16, end: i16) -> RangeInclusiveI16 {
    return RangeInclusiveI16 { start: start, end: end };
}
pub fn start_inclusive(value: RangeInclusiveI16) -> i16 { return value.start; }
pub fn end_inclusive(value: RangeInclusiveI16) -> i16 { return value.end; }
pub fn is_empty_inclusive(value: RangeInclusiveI16) -> bool {
    return inclusive_is_empty(value.start, value.end);
}
pub fn contains_inclusive(value: RangeInclusiveI16, item: i16) -> bool {
    return inclusive_contains(value.start, value.end, item);
}
pub fn overlaps_inclusive(left: RangeInclusiveI16, right: RangeInclusiveI16) -> bool {
    return inclusive_overlaps(left.start, left.end, right.start, right.end);
}

pub fn range_from(start: i16) -> RangeFromI16 {
    return RangeFromI16 { start: start };
}
pub fn start_from(value: RangeFromI16) -> i16 { return value.start; }
pub fn contains_from(value: RangeFromI16, item: i16) -> bool {
    return from_contains(value.start, item);
}

pub fn range_to(end: i16) -> RangeToI16 {
    return RangeToI16 { end: end };
}
pub fn end_to(value: RangeToI16) -> i16 { return value.end; }
pub fn contains_to(value: RangeToI16, item: i16) -> bool {
    return to_contains(value.end, item);
}

pub impl RangeI16 {
    pub fn start(&self) -> i16 { return self.start; }
    pub fn end(&self) -> i16 { return self.end; }
    pub fn is_empty(&self) -> bool {
        return half_open_is_empty(self.start, self.end);
    }
    pub fn contains(&self, item: i16) -> bool {
        return half_open_contains(self.start, self.end, item);
    }
    pub fn overlaps(&self, other: RangeI16) -> bool {
        return half_open_overlaps(self.start, self.end, other.start, other.end);
    }
}

pub impl RangeInclusiveI16 {
    pub fn start(&self) -> i16 { return self.start; }
    pub fn end(&self) -> i16 { return self.end; }
    pub fn is_empty(&self) -> bool {
        return inclusive_is_empty(self.start, self.end);
    }
    pub fn contains(&self, item: i16) -> bool {
        return inclusive_contains(self.start, self.end, item);
    }
    pub fn overlaps(&self, other: RangeInclusiveI16) -> bool {
        return inclusive_overlaps(self.start, self.end, other.start, other.end);
    }
}

pub impl RangeFromI16 {
    pub fn start(&self) -> i16 { return self.start; }
    pub fn contains(&self, item: i16) -> bool {
        return from_contains(self.start, item);
    }
}

pub impl RangeToI16 {
    pub fn end(&self) -> i16 { return self.end; }
    pub fn contains(&self, item: i16) -> bool {
        return to_contains(self.end, item);
    }
}
