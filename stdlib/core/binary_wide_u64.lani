// Allocation-free binary formatting and parsing for two-word u64 values.
module core::binary_wide_u64;
import core::binary;
import core::wide_u64;
pub fn len(value: core::wide_u64::WideU64) -> u32 {
    let high: u32 = core::wide_u64::high_word(value);
    if (high != 0) {
        return 32 + core::binary::len_u32(high);
    }
    return core::binary::len_u32(core::wide_u64::low_word(value));
}
// Index zero is the most significant digit of the shortest representation.
pub fn byte_at_or(value: core::wide_u64::WideU64, index: u32, fallback: u8) -> u8 {
    let length: u32 = len(value);
    if (index >= length) {
        return fallback;
    }
    let position: u32 = length - index - 1;
    let bit: u32 = 0;
    if (position<32) {
        bit =(core::wide_u64::low_word(value) >> position)&1;
    } else {
        bit =(core::wide_u64::high_word(value) >>(position - 32))&1;
    }
    let ascii: u32 = 48 + bit;
    return ascii as u8;
}
// Test syntax and the caller's limit before shifting left one bit.
pub fn can_append_ascii_digit(current: core::wide_u64::WideU64, digit_byte: u8, limit: core::wide_u64::WideU64) -> bool {
    if (digit_byte != 48 && digit_byte != 49) {
        return false;
    }
    let digit: u32 = 0;
    if (digit_byte == 49) {
        digit = 1;
    }
    let quotient: core::wide_u64::WideU64 = core::wide_u64::shift_right(limit, 1);
    let compared: i32 = core::wide_u64::compare(current, quotient);
    return compared<0 ||(compared == 0 && digit <=(core::wide_u64::low_word(limit)&1));
}
pub fn append_ascii_digit_or(current: core::wide_u64::WideU64, digit_byte: u8, limit: core::wide_u64::WideU64, fallback: core::wide_u64::WideU64) -> core::wide_u64::WideU64 {
    if (!can_append_ascii_digit(current, digit_byte, limit)) {
        return fallback;
    }
    let digit: u32 = 0;
    if (digit_byte == 49) {
        digit = 1;
    }
    let shifted: core::wide_u64::WideU64 = core::wide_u64::shift_left(current, 1);
    return core::wide_u64::bit_or(shifted, core::wide_u64::from_u32(digit));
}
// Parse exactly length ASCII byte codes from a backed [i32] view. An optional
// 0b or 0B prefix is accepted only with following digits. Bad syntax, empty
// input, and overflow are rejected; a backing overclaim can trap.
pub fn can_parse_ascii(values:[i32], length: i32) -> bool {
    if (length <= 0) {
        return false;
    }
    let index: i32 = 0;
    if (length >= 2 && values[0] == 48 &&(values[1] == 98 || values[1] == 66)) {
        index = 2;
    }
    if (index == length) {
        return false;
    }
    let current: core::wide_u64::WideU64 = core::wide_u64::zero();
    let maximum: core::wide_u64::WideU64 = core::wide_u64::max_value();
    while (index<length) {
        let code: i32 = values[index];
        if (code != 48 && code != 49) {
            return false;
        }
        let digit: u8 = code as u8;
        if (!can_append_ascii_digit(current, digit, maximum)) {
            return false;
        }
        current = append_ascii_digit_or(current, digit, maximum, current);
        index += 1;
    }
    return true;
}
// A valid value may equal fallback; call can_parse_ascii to distinguish it.
pub fn parse_ascii_or(values:[i32], length: i32, fallback: core::wide_u64::WideU64) -> core::wide_u64::WideU64 {
    if (!can_parse_ascii(values, length)) {
        return fallback;
    }
    let index: i32 = 0;
    if (length >= 2 && values[0] == 48 &&(values[1] == 98 || values[1] == 66)) {
        index = 2;
    }
    let current: core::wide_u64::WideU64 = core::wide_u64::zero();
    let maximum: core::wide_u64::WideU64 = core::wide_u64::max_value();
    while (index<length) {
        let code: i32 = values[index];
        let digit: u8 = code as u8;
        current = append_ascii_digit_or(current, digit, maximum, fallback);
        index += 1;
    }
    return current;
}
