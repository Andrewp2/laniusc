// A concrete optional bool until generic enum values execute natively.
// `value` is false for None and must be read only when `present` is true.
module core::option_bool;
import core::result_bool;

pub struct OptionBool {
    present: bool,
    value: bool,
}

pub fn some(value: bool) -> OptionBool {
    return OptionBool { present: true, value: value };
}

pub fn none() -> OptionBool {
    return OptionBool { present: false, value: false };
}

pub fn is_some(value: OptionBool) -> bool {
    return value.present;
}

pub fn is_none(value: OptionBool) -> bool {
    return !value.present;
}

pub fn contains(value: OptionBool, expected: bool) -> bool {
    return value.present && value.value == expected;
}

pub fn unwrap_or(value: OptionBool, fallback: bool) -> bool {
    if (value.present) { return value.value; }
    return fallback;
}

pub fn or(value: OptionBool, fallback: OptionBool) -> OptionBool {
    if (value.present) { return value; }
    return fallback;
}

pub fn and(value: OptionBool, next: OptionBool) -> OptionBool {
    if (value.present) { return next; }
    return value;
}

pub fn xor(left: OptionBool, right: OptionBool) -> OptionBool {
    if (left.present) {
        if (right.present) { return none(); }
        return left;
    }
    return right;
}

pub fn ok_or(value: OptionBool, error: bool) -> core::result_bool::ResultBool {
    if (value.present) { return core::result_bool::ok(value.value); }
    return core::result_bool::err(error);
}

pub fn ok(value: core::result_bool::ResultBool) -> OptionBool {
    if (core::result_bool::is_ok(value)) {
        return some(core::result_bool::unwrap_or(value, false));
    }
    return none();
}

pub fn err(value: core::result_bool::ResultBool) -> OptionBool {
    if (core::result_bool::is_err(value)) {
        return some(core::result_bool::unwrap_err_or(value, false));
    }
    return none();
}
