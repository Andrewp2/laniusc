// Allocation-free i32 arithmetic. Overflowing arithmetic uses saturation;
// division, clamp, and power-of-two failures have explicit fallback behavior.
module core::number_i32;
pub const MIN: i32 = -2147483648;
pub const MAX: i32 = 2147483647;
pub fn min(left: i32, right: i32) -> i32 {
    if (left<right) {
        return left;
    }
    return right;
}
pub fn max(left: i32, right: i32) -> i32 {
    if (left>right) {
        return left;
    }
    return right;
}
// If low > high, return fallback unchanged.
pub fn clamp_or(value: i32, low: i32, high: i32, fallback: i32) -> i32 {
    if (low>high) {
        return fallback;
    }
    if (value<low) {
        return low;
    }
    if (value>high) {
        return high;
    }
    return value;
}
pub fn saturating_abs(value: i32) -> i32 {
    if (value == MIN) {
        return MAX;
    }
    if (value<0) {
        return -value;
    }
    return value;
}
// The GCD is nonnegative and gcd(0, 0) is zero. If it is 2,147,483,648,
// which cannot fit in i32, return fallback instead.
pub fn gcd_or(left: i32, right: i32, fallback: i32) -> i32 {
    let a: i32 = left;
    let b: i32 = right;
    if (a == MIN) {
        if (b == 0 || b == MIN) {
            return fallback;
        }
        b = saturating_abs(b);
        a = saturating_abs(a % b);
    } else {
        if (b == MIN) {
            if (a == 0) {
                return fallback;
            }
            a = saturating_abs(a);
            b = saturating_abs(b % a);
        } else {
            a = saturating_abs(a);
            b = saturating_abs(b);
        }
    }
    while (b != 0) {
        let remainder: i32 = a % b;
        a = b;
        b = remainder;
    }
    return a;
}
// The LCM is nonnegative. Zero yields zero; an LCM above i32::MAX returns
// fallback, including a nonzero LCM involving MIN.
pub fn lcm_or(left: i32, right: i32, fallback: i32) -> i32 {
    if (left == 0 || right == 0) {
        return 0;
    }
    if (left == MIN || right == MIN) {
        return fallback;
    }
    let reduced: i32 = saturating_abs(left) / gcd_or(left, right, 0);
    let factor: i32 = saturating_abs(right);
    if (reduced>MAX / factor) {
        return fallback;
    }
    return reduced * factor;
}
pub fn saturating_add(left: i32, right: i32) -> i32 {
    if (right>0 && left>MAX - right) {
        return MAX;
    }
    if (right<0 && left<MIN - right) {
        return MIN;
    }
    return left + right;
}
pub fn saturating_sub(left: i32, right: i32) -> i32 {
    if (right<0 && left>MAX + right) {
        return MAX;
    }
    if (right>0 && left<MIN + right) {
        return MIN;
    }
    return left - right;
}
// Check before multiplying: evaluating an overflowing i32 product is not safe.
fn mul_overflows(left: i32, right: i32) -> bool {
    if (left>0) {
        if (right>0) {
            return left>MAX / right;
        }
        if (right<0) {
            return right<MIN / left;
        }
    }
    if (left<0) {
        if (right>0) {
            return left<MIN / right;
        }
        if (right<0) {
            return left<MAX / right;
        }
    }
    return false;
}
pub fn saturating_mul(left: i32, right: i32) -> i32 {
    if (mul_overflows(left, right)) {
        if ((left<0) ==(right<0)) {
            return MAX;
        }
        return MIN;
    }
    return left * right;
}
// Return fallback when the mathematical product does not fit in i32.
pub fn mul_or(left: i32, right: i32, fallback: i32) -> i32 {
    if (mul_overflows(left, right)) {
        return fallback;
    }
    return left * right;
}
// Zero to the zero power is one; an unrepresentable power returns fallback.
pub fn pow_or(base: i32, exponent: u32, fallback: i32) -> i32 {
    let result: i32 = 1;
    let factor: i32 = base;
    let remaining: u32 = exponent;
    while (remaining>0) {
        if (remaining % 2 != 0) {
            if (mul_overflows(result, factor)) {
                return fallback;
            }
            result *= factor;
        }
        remaining /= 2;
        if (remaining>0) {
            if (mul_overflows(factor, factor)) {
                return fallback;
            }
            factor *= factor;
        }
    }
    return result;
}
pub fn saturating_abs_diff(left: i32, right: i32) -> i32 {
    if (left >= right) {
        return saturating_sub(left, right);
    }
    return saturating_sub(right, left);
}
pub fn is_even(value: i32) -> bool {
    return value % 2 == 0;
}
pub fn is_odd(value: i32) -> bool {
    return value % 2 != 0;
}
pub fn is_zero(value: i32) -> bool {
    return value == 0;
}
pub fn signum(value: i32) -> i32 {
    if (value<0) {
        return -1;
    }
    if (value>0) {
        return 1;
    }
    return 0;
}
// Zero divisor returns false. The MIN/-1 case is divisible without dividing.
pub fn is_multiple_of(value: i32, divisor: i32) -> bool {
    if (divisor == 0) {
        return false;
    }
    if (divisor == -1) {
        return true;
    }
    return value % divisor == 0;
}
// Zero divisor and MIN/-1 return fallback instead of triggering an x86 divide trap.
pub fn div_or(value: i32, divisor: i32, fallback: i32) -> i32 {
    if (divisor == 0 || value == MIN && divisor == -1) {
        return fallback;
    }
    return value / divisor;
}
pub fn rem_or(value: i32, divisor: i32, fallback: i32) -> i32 {
    if (divisor == 0 || value == MIN && divisor == -1) {
        return fallback;
    }
    return value % divisor;
}
// Euclidean division keeps the remainder nonnegative. Zero divisor and
// MIN/-1 return fallback before evaluating a trapping native division.
pub fn div_euclid_or(value: i32, divisor: i32, fallback: i32) -> i32 {
    if (divisor == 0 || value == MIN && divisor == -1) {
        return fallback;
    }
    let quotient: i32 = value / divisor;
    let remainder: i32 = value % divisor;
    if (remainder<0) {
        if (divisor>0) {
            return quotient - 1;
        }
        return quotient + 1;
    }
    return quotient;
}
pub fn rem_euclid_or(value: i32, divisor: i32, fallback: i32) -> i32 {
    if (divisor == 0 || value == MIN && divisor == -1) {
        return fallback;
    }
    let remainder: i32 = value % divisor;
    if (remainder<0) {
        if (divisor>0) {
            return remainder + divisor;
        }
        return remainder - divisor;
    }
    return remainder;
}
pub fn is_power_of_two(value: i32) -> bool {
    if (value <= 0) {
        return false;
    }
    return(value&(value - 1)) == 0;
}
// Zero means the next positive power does not fit in i32.
pub fn next_power_of_two(value: i32) -> i32 {
    if (value <= 1) {
        return 1;
    }
    if (value>1073741824) {
        return 0;
    }
    let power: i32 = 1;
    while (power<value) {
        power *= 2;
    }
    return power;
}
