// Checked and saturating arithmetic for portable two-word unsigned values.
// These operations avoid the incomplete native u64 path.
module core::wide_u64_checked;
import core::option::Option;
import core::option::Some;
import core::option::None;
import core::option::unwrap_or;
import core::wide_u64;

pub fn checked_add(
    left: core::wide_u64::WideU64, right: core::wide_u64::WideU64
) -> Option<core::wide_u64::WideU64> {
    let sum: core::wide_u64::WideU64 = core::wide_u64::wrapping_add(left, right);
    if (core::wide_u64::compare(sum, left) < 0) {
        return None();
    }
    return Some(sum);
}

pub fn checked_sub(
    left: core::wide_u64::WideU64, right: core::wide_u64::WideU64
) -> Option<core::wide_u64::WideU64> {
    if (core::wide_u64::compare(left, right) < 0) {
        return None();
    }
    return Some(core::wide_u64::wrapping_sub(left, right));
}

pub fn checked_mul(
    left: core::wide_u64::WideU64, right: core::wide_u64::WideU64
) -> Option<core::wide_u64::WideU64> {
    if (core::wide_u64::is_zero(left) || core::wide_u64::is_zero(right)) {
        return Some(core::wide_u64::zero());
    }
    let limit: core::wide_u64::WideU64 = core::wide_u64::divide_or(
        core::wide_u64::max_value(), left, core::wide_u64::zero());
    if (core::wide_u64::compare(right, limit) > 0) {
        return None();
    }
    return Some(core::wide_u64::wrapping_mul(left, right));
}

pub fn checked_div(
    left: core::wide_u64::WideU64, right: core::wide_u64::WideU64
) -> Option<core::wide_u64::WideU64> {
    if (core::wide_u64::is_zero(right)) {
        return None();
    }
    return Some(
        core::wide_u64::divide_or(left, right, core::wide_u64::zero()));
}

pub fn checked_rem(
    left: core::wide_u64::WideU64, right: core::wide_u64::WideU64
) -> Option<core::wide_u64::WideU64> {
    if (core::wide_u64::is_zero(right)) {
        return None();
    }
    return Some(
        core::wide_u64::remainder_or(left, right, core::wide_u64::zero()));
}

// Exponentiation by squaring. 0^0 is one; any unrepresentable product is None.
pub fn checked_pow(
    base: core::wide_u64::WideU64, exponent: u32
) -> Option<core::wide_u64::WideU64> {
    let result: core::wide_u64::WideU64 = core::wide_u64::from_u32(1);
    let factor: core::wide_u64::WideU64 = base;
    let remaining: u32 = exponent;
    while (remaining > 0) {
        if ((remaining & 1) != 0) {
            result = checked_mul(result, factor)?;
        }
        remaining = remaining >> 1;
        if (remaining > 0) {
            factor = checked_mul(factor, factor)?;
        }
    }
    return Some(result);
}

pub fn saturating_add(
    left: core::wide_u64::WideU64, right: core::wide_u64::WideU64
) -> core::wide_u64::WideU64 {
    return unwrap_or(
        checked_add(left, right), core::wide_u64::max_value());
}

pub fn saturating_sub(
    left: core::wide_u64::WideU64, right: core::wide_u64::WideU64
) -> core::wide_u64::WideU64 {
    return unwrap_or(
        checked_sub(left, right), core::wide_u64::zero());
}

pub fn saturating_mul(
    left: core::wide_u64::WideU64, right: core::wide_u64::WideU64
) -> core::wide_u64::WideU64 {
    return unwrap_or(
        checked_mul(left, right), core::wide_u64::max_value());
}
