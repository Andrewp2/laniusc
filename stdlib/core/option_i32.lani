// A concrete optional i32 until generic enum values execute natively.
// `value` is zero for None and must be read only when `present` is true.
module core::option_i32;
import core::result_i32;

pub struct OptionI32 {
    present: bool,
    value: i32,
}

pub fn some(value: i32) -> OptionI32 {
    return OptionI32 { present: true, value: value };
}

pub fn none() -> OptionI32 {
    return OptionI32 { present: false, value: 0 };
}

pub fn is_some(value: OptionI32) -> bool {
    return value.present;
}

pub fn is_none(value: OptionI32) -> bool {
    return !value.present;
}

pub fn contains(value: OptionI32, expected: i32) -> bool {
    return value.present && value.value == expected;
}

pub fn unwrap_or(value: OptionI32, fallback: i32) -> i32 {
    if (value.present) { return value.value; }
    return fallback;
}

pub fn or(value: OptionI32, fallback: OptionI32) -> OptionI32 {
    if (value.present) { return value; }
    return fallback;
}

pub fn and(value: OptionI32, next: OptionI32) -> OptionI32 {
    if (value.present) { return next; }
    return value;
}

pub fn xor(left: OptionI32, right: OptionI32) -> OptionI32 {
    if (left.present) {
        if (right.present) { return none(); }
        return left;
    }
    return right;
}

pub fn ok_or(value: OptionI32, error: i32) -> core::result_i32::ResultI32 {
    if (value.present) { return core::result_i32::ok(value.value); }
    return core::result_i32::err(error);
}

pub fn ok(value: core::result_i32::ResultI32) -> OptionI32 {
    if (core::result_i32::is_ok(value)) {
        return some(core::result_i32::unwrap_or(value, 0));
    }
    return none();
}

pub fn err(value: core::result_i32::ResultI32) -> OptionI32 {
    if (core::result_i32::is_err(value)) {
        return some(core::result_i32::unwrap_err_or(value, 0));
    }
    return none();
}

pub impl OptionI32 {
    pub fn is_some(&self) -> bool { return self.present; }
    pub fn is_none(&self) -> bool { return !self.present; }
    pub fn contains(&self, expected: i32) -> bool {
        return self.present && self.value == expected;
    }
    pub fn unwrap_or(&self, fallback: i32) -> i32 {
        if (self.present) { return self.value; }
        return fallback;
    }
    pub fn or(&self, fallback: OptionI32) -> OptionI32 {
        if (self.present) { return OptionI32 { present: true, value: self.value }; }
        return fallback;
    }
    pub fn and(&self, next: OptionI32) -> OptionI32 {
        if (self.present) { return next; }
        return none();
    }
    pub fn xor(&self, right: OptionI32) -> OptionI32 {
        if (self.present) {
            if (right.present) { return none(); }
            return OptionI32 { present: true, value: self.value };
        }
        return right;
    }
    pub fn ok_or(&self, error: i32) -> core::result_i32::ResultI32 {
        if (self.present) { return core::result_i32::ok(self.value); }
        return core::result_i32::err(error);
    }
}
