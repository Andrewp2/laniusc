// Allocation-free byte scalar and concrete aggregate ranges.
module core::range_u8;

// Half-open [start, end). Equal or reversed bounds are empty.
pub fn half_open_is_empty(start: u8, end: u8) -> bool {
    return start >= end;
}

pub fn half_open_contains(start: u8, end: u8, value: u8) -> bool {
    return value >= start && value < end;
}

pub fn half_open_overlaps(left_start: u8, left_end: u8, right_start: u8, right_end: u8) -> bool {
    return left_start < left_end && right_start < right_end &&
        left_start < right_end && right_start < left_end;
}

// Inclusive [start, end]. Equal bounds contain exactly one byte.
pub fn inclusive_is_empty(start: u8, end: u8) -> bool {
    return start > end;
}

pub fn inclusive_contains(start: u8, end: u8, value: u8) -> bool {
    return value >= start && value <= end;
}

pub fn inclusive_overlaps(left_start: u8, left_end: u8, right_start: u8, right_end: u8) -> bool {
    return left_start <= left_end && right_start <= right_end &&
        left_start <= right_end && right_start <= left_end;
}

pub fn from_contains(start: u8, value: u8) -> bool {
    return value >= start;
}

pub fn to_contains(end: u8, value: u8) -> bool {
    return value < end;
}

// A full byte range contains every u8 value.
pub fn full_contains(value: u8) -> bool {
    return true;
}

// Caller-owned concrete range values for this width. Scalar predicates above
// remain convenient when no aggregate needs to cross a function boundary.
pub struct RangeU8 { start: u8, end: u8, }
pub struct RangeInclusiveU8 { start: u8, end: u8, }
pub struct RangeFromU8 { start: u8, }
pub struct RangeToU8 { end: u8, }

pub fn range(start: u8, end: u8) -> RangeU8 {
    return RangeU8 { start: start, end: end };
}
pub fn start(value: RangeU8) -> u8 { return value.start; }
pub fn end(value: RangeU8) -> u8 { return value.end; }
pub fn is_empty(value: RangeU8) -> bool {
    return half_open_is_empty(value.start, value.end);
}
pub fn contains(value: RangeU8, item: u8) -> bool {
    return half_open_contains(value.start, value.end, item);
}
pub fn overlaps(left: RangeU8, right: RangeU8) -> bool {
    return half_open_overlaps(left.start, left.end, right.start, right.end);
}

pub fn range_inclusive(start: u8, end: u8) -> RangeInclusiveU8 {
    return RangeInclusiveU8 { start: start, end: end };
}
pub fn start_inclusive(value: RangeInclusiveU8) -> u8 { return value.start; }
pub fn end_inclusive(value: RangeInclusiveU8) -> u8 { return value.end; }
pub fn is_empty_inclusive(value: RangeInclusiveU8) -> bool {
    return inclusive_is_empty(value.start, value.end);
}
pub fn contains_inclusive(value: RangeInclusiveU8, item: u8) -> bool {
    return inclusive_contains(value.start, value.end, item);
}
pub fn overlaps_inclusive(left: RangeInclusiveU8, right: RangeInclusiveU8) -> bool {
    return inclusive_overlaps(left.start, left.end, right.start, right.end);
}

pub fn range_from(start: u8) -> RangeFromU8 {
    return RangeFromU8 { start: start };
}
pub fn start_from(value: RangeFromU8) -> u8 { return value.start; }
pub fn contains_from(value: RangeFromU8, item: u8) -> bool {
    return from_contains(value.start, item);
}

pub fn range_to(end: u8) -> RangeToU8 {
    return RangeToU8 { end: end };
}
pub fn end_to(value: RangeToU8) -> u8 { return value.end; }
pub fn contains_to(value: RangeToU8, item: u8) -> bool {
    return to_contains(value.end, item);
}

pub impl RangeU8 {
    pub fn start(&self) -> u8 { return self.start; }
    pub fn end(&self) -> u8 { return self.end; }
    pub fn is_empty(&self) -> bool {
        return half_open_is_empty(self.start, self.end);
    }
    pub fn contains(&self, item: u8) -> bool {
        return half_open_contains(self.start, self.end, item);
    }
    pub fn overlaps(&self, other: RangeU8) -> bool {
        return half_open_overlaps(self.start, self.end, other.start, other.end);
    }
}

pub impl RangeInclusiveU8 {
    pub fn start(&self) -> u8 { return self.start; }
    pub fn end(&self) -> u8 { return self.end; }
    pub fn is_empty(&self) -> bool {
        return inclusive_is_empty(self.start, self.end);
    }
    pub fn contains(&self, item: u8) -> bool {
        return inclusive_contains(self.start, self.end, item);
    }
    pub fn overlaps(&self, other: RangeInclusiveU8) -> bool {
        return inclusive_overlaps(self.start, self.end, other.start, other.end);
    }
}

pub impl RangeFromU8 {
    pub fn start(&self) -> u8 { return self.start; }
    pub fn contains(&self, item: u8) -> bool {
        return from_contains(self.start, item);
    }
}

pub impl RangeToU8 {
    pub fn end(&self) -> u8 { return self.end; }
    pub fn contains(&self, item: u8) -> bool {
        return to_contains(self.end, item);
    }
}
