// A concrete optional pointer while generic Option<T> remains unavailable in
// native code. A null pointer can be Some(null); presence has its own flag.
module core::option_ptr;
import core::option_i32;
import core::result_ptr;

pub struct OptionPtr {
    present: bool,
    value: ptr,
}

pub fn some(value: ptr) -> OptionPtr {
    return OptionPtr { present: true, value: value };
}

pub fn none() -> OptionPtr {
    let null: ptr = 0;
    return OptionPtr { present: false, value: null };
}

pub fn is_some(value: OptionPtr) -> bool {
    return value.present;
}

pub fn is_none(value: OptionPtr) -> bool {
    return !value.present;
}

pub fn contains(value: OptionPtr, expected: ptr) -> bool {
    return value.present && value.value == expected;
}

pub fn unwrap_or(value: OptionPtr, fallback: ptr) -> ptr {
    if (value.present) { return value.value; }
    return fallback;
}

pub fn or(value: OptionPtr, fallback: OptionPtr) -> OptionPtr {
    if (value.present) { return value; }
    return fallback;
}

pub fn and(value: OptionPtr, next: OptionPtr) -> OptionPtr {
    if (value.present) { return next; }
    return value;
}

pub fn xor(left: OptionPtr, right: OptionPtr) -> OptionPtr {
    if (left.present) {
        if (right.present) { return none(); }
        return left;
    }
    return right;
}

pub fn ok_or(value: OptionPtr, error: i32) -> core::result_ptr::ResultPtr {
    if (value.present) { return core::result_ptr::ok(value.value); }
    return core::result_ptr::err(error);
}

pub fn ok(value: core::result_ptr::ResultPtr) -> OptionPtr {
    if (core::result_ptr::is_ok(value)) {
        let null: ptr = 0;
        return some(core::result_ptr::unwrap_or(value, null));
    }
    return none();
}

pub fn err(value: core::result_ptr::ResultPtr) -> core::option_i32::OptionI32 {
    if (core::result_ptr::is_err(value)) {
        return core::option_i32::some(core::result_ptr::unwrap_err_or(value, 0));
    }
    return core::option_i32::none();
}
