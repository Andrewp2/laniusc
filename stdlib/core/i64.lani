// Native i64 values on the verified x86_64 Linux target. No allocation.
// checked_* returns None for invalid inputs or an unrepresentable result.
// wrapping_* uses modulo 2^64; saturating_* clamps arithmetic to MIN/MAX.
// Division by zero always traps outside checked_*; abs(MIN), invalid clamp
// bounds and strict shift counts trap. See docs/stdlib-native-integers.md.
module core::i64;
import core::option;
import core::u64;
pub const MIN: i64 = -9223372036854775808;
pub const MAX: i64 = 9223372036854775807;
pub const BITS: u32 = 64;
pub const BYTES: u32 = 8;

pub fn min(left: i64, right: i64) -> i64 { if (left < right) { return left; } return right; }
pub fn max(left: i64, right: i64) -> i64 { if (left > right) { return left; } return right; }
pub fn checked_clamp(value: i64, low: i64, high: i64) -> core::option::Option<i64> { if (low > high) { return core::option::None(); } return core::option::Some(clamp(value,low,high)); }
// Reversed bounds trap even when value lies outside both ends.
pub fn clamp(value: i64, low: i64, high: i64) -> i64 { assert(low <= high); if (value < low) { return low; } if (value > high) { return high; } return value; }
pub fn clamp_or(value: i64, low: i64, high: i64, fallback: i64) -> i64 { if (low > high) { return fallback; } return clamp(value,low,high); }
pub fn is_zero(value: i64) -> bool { return value == 0; }
pub fn is_nonzero(value: i64) -> bool { return value != 0; }
pub fn is_even(value: i64) -> bool { return (value & 1) == 0; }
pub fn is_odd(value: i64) -> bool { return (value & 1) != 0; }
pub fn between_inclusive(value: i64, low: i64, high: i64) -> bool { return value >= low && value <= high; }
pub fn between_exclusive(value: i64, low: i64, high: i64) -> bool { return value > low && value < high; }
// A zero divisor returns false; no division instruction executes.
pub fn is_multiple_of(value: i64, divisor: i64) -> bool { if (divisor == 0) { return false; } if (divisor == -1) { return true; } return value % divisor == 0; }
pub fn wrapping_add(left: i64, right: i64) -> i64 { return left + right; }
pub fn wrapping_sub(left: i64, right: i64) -> i64 { return left - right; }
pub fn wrapping_mul(left: i64, right: i64) -> i64 { return left * right; }
fn add_overflows(left: i64, right: i64) -> bool { return (right > 0 && left > MAX-right) || (right < 0 && left < MIN-right); }
fn sub_overflows(left: i64, right: i64) -> bool { return (right < 0 && left > MAX+right) || (right > 0 && left < MIN+right); }
fn mul_overflows(left: i64, right: i64) -> bool {
    if (left > 0) { if (right > 0) { return left > MAX/right; } if (right < 0) { return right < MIN/left; } }
    if (left < 0) { if (right > 0) { return left < MIN/right; } if (right < 0) { return left < MAX/right; } }
    return false;
}
pub fn checked_add(left: i64, right: i64) -> core::option::Option<i64> { if (add_overflows(left,right)) { return core::option::None(); } return core::option::Some(left + right); }
pub fn saturating_add(left: i64, right: i64) -> i64 { if (add_overflows(left,right)) { if (right < 0) { return MIN; } return MAX; } return left + right; }
pub fn checked_sub(left: i64, right: i64) -> core::option::Option<i64> { if (sub_overflows(left,right)) { return core::option::None(); } return core::option::Some(left - right); }
pub fn saturating_sub(left: i64, right: i64) -> i64 { if (sub_overflows(left,right)) { if (right > 0) { return MIN; } return MAX; } return left - right; }
pub fn checked_mul(left: i64, right: i64) -> core::option::Option<i64> { if (mul_overflows(left,right)) { return core::option::None(); } return core::option::Some(left * right); }
pub fn saturating_mul(left: i64, right: i64) -> i64 { if (mul_overflows(left,right)) { if ((left < 0) != (right < 0)) { return MIN; } return MAX; } return left * right; }
pub fn checked_neg(value: i64) -> core::option::Option<i64> { if (value == MIN) { return core::option::None(); } return core::option::Some(0-value); }
pub fn wrapping_neg(value: i64) -> i64 { return 0-value; }
pub fn saturating_neg(value: i64) -> i64 { if (value == MIN) { return MAX; } return 0-value; }
pub fn checked_abs(value: i64) -> core::option::Option<i64> { if (value == MIN) { return core::option::None(); } return core::option::Some(abs(value)); }
// The mathematical absolute value must fit; MIN traps. Use checked_abs or unsigned_abs when it may not fit.
pub fn abs(value: i64) -> i64 { assert(value != MIN); if (value < 0) { return 0-value; } return value; }
pub fn wrapping_abs(value: i64) -> i64 { if (value < 0) { return 0-value; } return value; }
pub fn saturating_abs(value: i64) -> i64 { if (value == MIN) { return MAX; } return abs(value); }
pub fn unsigned_abs(value: i64) -> u64 { let bits: u64 = value as u64; if (value < 0) { return (0 as u64)-bits; } return bits; }
pub fn abs_diff(left: i64, right: i64) -> u64 { if (left >= right) { return (left as u64)-(right as u64); } return (right as u64)-(left as u64); }
pub fn saturating_abs_diff(left: i64, right: i64) -> i64 { if (left >= right) { return saturating_sub(left,right); } return saturating_sub(right,left); }
pub fn signum(value: i64) -> i64 { if (value < 0) { return -1; } if (value > 0) { return 1; } return 0; }
pub fn is_negative(value: i64) -> bool { return value < 0; }
pub fn is_positive(value: i64) -> bool { return value > 0; }
pub fn checked_div(left: i64, right: i64) -> core::option::Option<i64> { if (right == 0 || (left == MIN && right == -1)) { return core::option::None(); } return core::option::Some(left / right); }
// Traps for zero divisor or signed MIN/-1.
pub fn div(left: i64, right: i64) -> i64 { assert(right != 0 && !(left == MIN && right == -1)); return left / right; }
pub fn wrapping_div(left: i64, right: i64) -> i64 { assert(right != 0); if (left == MIN && right == -1) { return MIN; } return left / right; }
pub fn checked_rem(left: i64, right: i64) -> core::option::Option<i64> { if (right == 0 || (left == MIN && right == -1)) { return core::option::None(); } return core::option::Some(left % right); }
// Traps for zero divisor or signed MIN/-1.
pub fn rem(left: i64, right: i64) -> i64 { assert(right != 0 && !(left == MIN && right == -1)); return left % right; }
pub fn wrapping_rem(left: i64, right: i64) -> i64 { assert(right != 0); if (left == MIN && right == -1) { return 0; } return left % right; }
pub fn saturating_div(left: i64, right: i64) -> i64 { assert(right != 0); if (left == MIN && right == -1) { return MAX; } return left/right; }
pub fn div_euclid(left: i64, right: i64) -> i64 { assert(right != 0 && !(left == MIN && right == -1)); let quotient: i64 = left/right; let remainder: i64 = left%right; if (remainder < 0) { if (right > 0) { quotient -= 1; } else { quotient += 1; } } return quotient; }
pub fn checked_div_euclid(left: i64, right: i64) -> core::option::Option<i64> { if (right == 0 || (left == MIN && right == -1)) { return core::option::None(); } return core::option::Some(div_euclid(left,right)); }
pub fn rem_euclid(left: i64, right: i64) -> i64 { assert(right != 0 && !(left == MIN && right == -1)); let quotient: i64 = left/right; let remainder: i64 = left%right; if (remainder < 0) { if (right > 0) { return remainder+right; } return remainder-right; } return remainder; }
pub fn checked_rem_euclid(left: i64, right: i64) -> core::option::Option<i64> { if (right == 0 || (left == MIN && right == -1)) { return core::option::None(); } return core::option::Some(rem_euclid(left,right)); }
// Checks the count only; shifted-out bits are discarded.
pub fn checked_shl(value: i64, amount: u32) -> core::option::Option<i64> { if (amount >= BITS) { return core::option::None(); } return core::option::Some(value << amount); }
pub fn wrapping_shl(value: i64, amount: u32) -> i64 { return value << (amount % BITS); }
pub fn shl(value: i64, amount: u32) -> i64 { assert(amount < BITS); return value << amount; }
// Checks the count only; shifted-out bits are discarded.
pub fn checked_shr(value: i64, amount: u32) -> core::option::Option<i64> { if (amount >= BITS) { return core::option::None(); } return core::option::Some(value >> amount); }
pub fn wrapping_shr(value: i64, amount: u32) -> i64 { return value >> (amount % BITS); }
pub fn shr(value: i64, amount: u32) -> i64 { assert(amount < BITS); return value >> amount; }
// Exponent zero returns one, including 0^0.
pub fn checked_pow(base: i64, exponent: u32) -> core::option::Option<i64> { let result: i64 = 1; let factor: i64 = base; let left: u32 = exponent; while (left != 0) { if ((left & 1) != 0) { let product: core::option::Option<i64> = checked_mul(result,factor); if (core::option::is_none(product)) { return core::option::None(); } result = core::option::unwrap(product); } left >>= 1; if (left != 0) { let square: core::option::Option<i64> = checked_mul(factor,factor); if (core::option::is_none(square)) { return core::option::None(); } factor = core::option::unwrap(square); } } return core::option::Some(result); }
// Exponent zero returns one, including 0^0.
pub fn wrapping_pow(base: i64, exponent: u32) -> i64 { let result: i64 = 1; let factor: i64 = base; let left: u32 = exponent; while (left != 0) { if ((left & 1) != 0) { result = wrapping_mul(result,factor); } left >>= 1; if (left != 0) { factor = wrapping_mul(factor,factor); } } return result; }
// Exponent zero returns one, including 0^0.
pub fn saturating_pow(base: i64, exponent: u32) -> i64 { let result: i64 = 1; let factor: i64 = base; let left: u32 = exponent; while (left != 0) { if ((left & 1) != 0) { result = saturating_mul(result,factor); } left >>= 1; if (left != 0) { factor = saturating_mul(factor,factor); } } return result; }
pub fn count_ones(value: i64) -> u32 { return core::u64::count_ones(value as u64); }
pub fn count_zeros(value: i64) -> u32 { return core::u64::count_zeros(value as u64); }
pub fn leading_zeros(value: i64) -> u32 { return core::u64::leading_zeros(value as u64); }
pub fn trailing_zeros(value: i64) -> u32 { return core::u64::trailing_zeros(value as u64); }
pub fn leading_ones(value: i64) -> u32 { return core::u64::leading_ones(value as u64); }
pub fn trailing_ones(value: i64) -> u32 { return core::u64::trailing_ones(value as u64); }
pub fn rotate_left(value: i64, amount: u32) -> i64 { return core::u64::rotate_left(value as u64,amount) as i64; }
pub fn rotate_right(value: i64, amount: u32) -> i64 { return core::u64::rotate_right(value as u64,amount) as i64; }
pub fn reverse_bits(value: i64) -> i64 { return core::u64::reverse_bits(value as u64) as i64; }
pub fn swap_bytes(value: i64) -> i64 { return core::u64::swap_bytes(value as u64) as i64; }
pub fn is_power_of_two(value: i64) -> bool { return value > 0 && core::u64::is_power_of_two(value as u64); }
pub fn checked_next_power_of_two(value: i64) -> core::option::Option<i64> { if (value <= 1) { return core::option::Some(1); } if (value > 4611686018427387904) { return core::option::None(); } let power: i64 = 1; while (power < value) { power <<= 1; } return core::option::Some(power); }
// Traps when the next power cannot be represented.
pub fn next_power_of_two(value: i64) -> i64 { return core::option::unwrap(checked_next_power_of_two(value)); }

// Integer conversions: checked means numeric range, wrapping keeps low bits.
pub fn from_i8(value: i8) -> i64 { return value as i64; }
pub fn from_u8(value: u8) -> i64 { return value as i64; }
pub fn from_i16(value: i16) -> i64 { return value as i64; }
pub fn from_u16(value: u16) -> i64 { return value as i64; }
pub fn from_i32(value: i32) -> i64 { return value as i64; }
pub fn from_u32(value: u32) -> i64 { return value as i64; }
pub fn checked_from_i8(value: i8) -> core::option::Option<i64> { return core::option::Some(value as i64); }
pub fn saturating_from_i8(value: i8) -> i64 { return value as i64; }
pub fn wrapping_from_i8(value: i8) -> i64 { return value as i64; }
pub fn checked_from_u8(value: u8) -> core::option::Option<i64> { return core::option::Some(value as i64); }
pub fn saturating_from_u8(value: u8) -> i64 { return value as i64; }
pub fn wrapping_from_u8(value: u8) -> i64 { return value as i64; }
pub fn checked_from_i16(value: i16) -> core::option::Option<i64> { return core::option::Some(value as i64); }
pub fn saturating_from_i16(value: i16) -> i64 { return value as i64; }
pub fn wrapping_from_i16(value: i16) -> i64 { return value as i64; }
pub fn checked_from_u16(value: u16) -> core::option::Option<i64> { return core::option::Some(value as i64); }
pub fn saturating_from_u16(value: u16) -> i64 { return value as i64; }
pub fn wrapping_from_u16(value: u16) -> i64 { return value as i64; }
pub fn checked_from_i32(value: i32) -> core::option::Option<i64> { return core::option::Some(value as i64); }
pub fn saturating_from_i32(value: i32) -> i64 { return value as i64; }
pub fn wrapping_from_i32(value: i32) -> i64 { return value as i64; }
pub fn checked_from_u32(value: u32) -> core::option::Option<i64> { return core::option::Some(value as i64); }
pub fn saturating_from_u32(value: u32) -> i64 { return value as i64; }
pub fn wrapping_from_u32(value: u32) -> i64 { return value as i64; }
pub fn checked_from_i64(value: i64) -> core::option::Option<i64> { return core::option::Some(value as i64); }
pub fn saturating_from_i64(value: i64) -> i64 { return value as i64; }
pub fn wrapping_from_i64(value: i64) -> i64 { return value as i64; }
pub fn checked_from_u64(value: u64) -> core::option::Option<i64> { if (value > 9223372036854775807) { return core::option::None(); } return core::option::Some(value as i64); }
pub fn saturating_from_u64(value: u64) -> i64 { if (value > 9223372036854775807) { return MAX; } return value as i64; }
pub fn wrapping_from_u64(value: u64) -> i64 { return value as i64; }
pub fn checked_from_isize(value: isize) -> core::option::Option<i64> { return core::option::Some(value as i64); }
pub fn saturating_from_isize(value: isize) -> i64 { return value as i64; }
pub fn wrapping_from_isize(value: isize) -> i64 { return value as i64; }
pub fn checked_from_usize(value: usize) -> core::option::Option<i64> { if (value > 9223372036854775807) { return core::option::None(); } return core::option::Some(value as i64); }
pub fn saturating_from_usize(value: usize) -> i64 { if (value > 9223372036854775807) { return MAX; } return value as i64; }
pub fn wrapping_from_usize(value: usize) -> i64 { return value as i64; }
pub fn checked_to_i8(value: i64) -> core::option::Option<i8> { if (value < -128 || value > 127) { return core::option::None(); } return core::option::Some(value as i8); }
pub fn saturating_to_i8(value: i64) -> i8 { if (value < -128) { return -128; } if (value > 127) { return 127; } return value as i8; }
pub fn wrapping_to_i8(value: i64) -> i8 { return value as i8; }
pub fn checked_to_u8(value: i64) -> core::option::Option<u8> { if (value < 0 || value > 255) { return core::option::None(); } return core::option::Some(value as u8); }
pub fn saturating_to_u8(value: i64) -> u8 { if (value < 0) { return 0; } if (value > 255) { return 255; } return value as u8; }
pub fn wrapping_to_u8(value: i64) -> u8 { return value as u8; }
pub fn checked_to_i16(value: i64) -> core::option::Option<i16> { if (value < -32768 || value > 32767) { return core::option::None(); } return core::option::Some(value as i16); }
pub fn saturating_to_i16(value: i64) -> i16 { if (value < -32768) { return -32768; } if (value > 32767) { return 32767; } return value as i16; }
pub fn wrapping_to_i16(value: i64) -> i16 { return value as i16; }
pub fn checked_to_u16(value: i64) -> core::option::Option<u16> { if (value < 0 || value > 65535) { return core::option::None(); } return core::option::Some(value as u16); }
pub fn saturating_to_u16(value: i64) -> u16 { if (value < 0) { return 0; } if (value > 65535) { return 65535; } return value as u16; }
pub fn wrapping_to_u16(value: i64) -> u16 { return value as u16; }
pub fn checked_to_i32(value: i64) -> core::option::Option<i32> { if (value < -2147483648 || value > 2147483647) { return core::option::None(); } return core::option::Some(value as i32); }
pub fn saturating_to_i32(value: i64) -> i32 { if (value < -2147483648) { return -2147483648; } if (value > 2147483647) { return 2147483647; } return value as i32; }
pub fn wrapping_to_i32(value: i64) -> i32 { return value as i32; }
pub fn checked_to_u32(value: i64) -> core::option::Option<u32> { if (value < 0 || value > 4294967295) { return core::option::None(); } return core::option::Some(value as u32); }
pub fn saturating_to_u32(value: i64) -> u32 { if (value < 0) { return 0; } if (value > 4294967295) { return 4294967295; } return value as u32; }
pub fn wrapping_to_u32(value: i64) -> u32 { return value as u32; }
pub fn checked_to_i64(value: i64) -> core::option::Option<i64> { return core::option::Some(value as i64); }
pub fn saturating_to_i64(value: i64) -> i64 { return value as i64; }
pub fn wrapping_to_i64(value: i64) -> i64 { return value as i64; }
pub fn checked_to_u64(value: i64) -> core::option::Option<u64> { if (value < 0) { return core::option::None(); } return core::option::Some(value as u64); }
pub fn saturating_to_u64(value: i64) -> u64 { if (value < 0) { return 0; } return value as u64; }
pub fn wrapping_to_u64(value: i64) -> u64 { return value as u64; }
pub fn checked_to_isize(value: i64) -> core::option::Option<isize> { return core::option::Some(value as isize); }
pub fn saturating_to_isize(value: i64) -> isize { return value as isize; }
pub fn wrapping_to_isize(value: i64) -> isize { return value as isize; }
pub fn checked_to_usize(value: i64) -> core::option::Option<usize> { if (value < 0) { return core::option::None(); } return core::option::Some(value as usize); }
pub fn saturating_to_usize(value: i64) -> usize { if (value < 0) { return 0; } return value as usize; }
pub fn wrapping_to_usize(value: i64) -> usize { return value as usize; }
