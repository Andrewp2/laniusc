fn ordering(value: i32) -> core::cmp::PartialOrdering {
    if (value < 0) { return core::cmp::Less; }if (value > 0) { return core::cmp::Greater; }return core::cmp::Equal;
}
fn hash_word(state: u32, word: u32) -> u32 {
    let result: u32 = state;let rest: u32 = word;let i: i32 = 0;
    while (i < 4) { result = core::hash::fnv1a_step(result,(rest&255) as u8);rest >>= 8;i += 1; }
    return result;
}
fn hash_date(state: u32, value: Date) -> u32 { return hash_word(hash_word(hash_word(state,value.year as u32),value.month as u32),value.day as u32); }
fn hash_time(state: u32, value: TimeOfDay) -> u32 { return hash_word(hash_word(hash_word(hash_word(state,value.hour as u32),value.minute as u32),value.second as u32),value.nanos); }
fn hash_offset(state: u32, value: UtcOffset) -> u32 { return core::hash::fnv1a_step(hash_word(state,value.minutes as u32),value.known as u8); }
