// Operations over caller-backed i32 cells that store u32 bit patterns.
// The backing view must contain at least len cells. Sorting is unsigned and
// in place; an overstated length can trap on native indexing.
module core::u32_cells;

fn stored_less(left: i32, right: i32) -> bool {
    // Flipping the sign bit maps unsigned order to signed i32 order.
    return (left ^ -2147483648) < (right ^ -2147483648);
}

fn sift_down_max(cells: [i32], heap_len: i32, start: i32) {
    let root: i32 = start;
    while (heap_len > 1 && root <= (heap_len - 2) / 2) {
        let child: i32 = root * 2 + 1;
        let largest: i32 = root;
        if (stored_less(cells[largest], cells[child])) {
            largest = child;
        }
        if (child + 1 < heap_len && stored_less(cells[largest], cells[child + 1])) {
            largest = child + 1;
        }
        if (largest == root) {
            break;
        }
        let previous: i32 = cells[root];
        cells[root] = cells[largest];
        cells[largest] = previous;
        root = largest;
    }
}

// In-place unsigned heapsort. Returns len; nonpositive lengths write nothing.
pub fn sort(cells: [i32], len: i32) -> i32 {
    if (len <= 0) {
        return 0;
    }
    if (len == 1) {
        return 1;
    }
    let start: i32 = (len - 2) / 2;
    while (start >= 0) {
        sift_down_max(cells, len, start);
        if (start == 0) {
            break;
        }
        start -= 1;
    }
    let remaining: i32 = len;
    while (remaining > 1) {
        remaining -= 1;
        let previous: i32 = cells[0];
        cells[0] = cells[remaining];
        cells[remaining] = previous;
        sift_down_max(cells, remaining, 0);
    }
    return len;
}

// Reverse the first len cells and return the number of swaps.
pub fn reverse_in_place(cells: [i32], len: i32) -> i32 {
    if (len <= 1) {
        return 0;
    }
    let left: i32 = 0;
    let right: i32 = len - 1;
    let swaps: i32 = 0;
    while (left < right) {
        let previous: i32 = cells[left];
        cells[left] = cells[right];
        cells[right] = previous;
        left += 1;
        right -= 1;
        swaps += 1;
    }
    return swaps;
}

// Require nondecreasing unsigned input. Return insertion indices [0, len].
pub fn lower_bound(cells: [i32], len: i32, needle_bits: i32) -> i32 {
    if (len <= 0) {
        return 0;
    }
    let low: i32 = 0;
    let high: i32 = len;
    while (low < high) {
        let middle: i32 = low + (high - low) / 2;
        if (stored_less(cells[middle], needle_bits)) {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    return low;
}

pub fn upper_bound(cells: [i32], len: i32, needle_bits: i32) -> i32 {
    if (len <= 0) {
        return 0;
    }
    let low: i32 = 0;
    let high: i32 = len;
    while (low < high) {
        let middle: i32 = low + (high - low) / 2;
        if (!stored_less(needle_bits, cells[middle])) {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    return low;
}
