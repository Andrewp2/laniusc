// Recoverable results: Ok carries the value, Err the error. Every operation
// takes the result by value and leaves the caller's copy unchanged. Each one
// exists as a free function and as a method. Membership needs Eq on the
// payload it compares. unwrap and unwrap_err panic on the other variant;
// the *_or forms take an explicit fallback and never panic.

module core::result;

import core::cmp;
import core::panic;

pub enum Result<T, E> {
    Ok(T),
    Err(E),
}

pub fn is_ok<T, E>(value: Result<T, E>) -> bool {
    return match (value) { Ok(_) -> true, Err(_) -> false };
}

pub fn is_err<T, E>(value: Result<T, E>) -> bool {
    return match (value) { Ok(_) -> false, Err(_) -> true };
}

pub fn contains<T, E>(value: Result<T, E>, expected: T) -> bool where T: core::cmp::Eq<T> {
    return match (value) { Ok(inner) -> T::eq(inner, expected), Err(_) -> false };
}

pub fn contains_err<T, E>(value: Result<T, E>, expected: E) -> bool where E: core::cmp::Eq<E> {
    return match (value) { Ok(_) -> false, Err(error) -> E::eq(error, expected) };
}

pub fn unwrap<T, E>(value: Result<T, E>) -> T {
    return match (value) { Ok(inner) -> inner, Err(_) -> core::panic::panic() };
}

pub fn unwrap_err<T, E>(value: Result<T, E>) -> E {
    return match (value) { Ok(_) -> core::panic::panic(), Err(error) -> error };
}

pub fn unwrap_or<T, E>(value: Result<T, E>, fallback: T) -> T {
    return match (value) { Ok(inner) -> inner, Err(_) -> fallback };
}

pub fn unwrap_err_or<T, E>(value: Result<T, E>, fallback: E) -> E {
    return match (value) { Ok(_) -> fallback, Err(error) -> error };
}

// A successful left value wins; two failures give the fallback's error.
pub fn or<T, E>(value: Result<T, E>, fallback: Result<T, E>) -> Result<T, E> {
    if (is_ok(value)) { return value; }
    return fallback;
}

// Success gives `next`; a failed left value keeps its error.
pub fn and<T, E>(value: Result<T, E>, next: Result<T, E>) -> Result<T, E> {
    if (is_ok(value)) { return next; }
    return value;
}

pub impl<T, E> Result<T, E> {
    pub fn is_ok(self) -> bool {
        return match (self) { Ok(_) -> true, Err(_) -> false };
    }

    pub fn is_err(self) -> bool {
        return match (self) { Ok(_) -> false, Err(_) -> true };
    }

    pub fn contains(self, expected: T) -> bool where T: core::cmp::Eq<T> {
        return match (self) { Ok(inner) -> T::eq(inner, expected), Err(_) -> false };
    }

    pub fn contains_err(self, expected: E) -> bool where E: core::cmp::Eq<E> {
        return match (self) { Ok(_) -> false, Err(error) -> E::eq(error, expected) };
    }

    pub fn unwrap(self) -> T {
        return match (self) { Ok(inner) -> inner, Err(_) -> core::panic::panic() };
    }

    pub fn unwrap_err(self) -> E {
        return match (self) { Ok(_) -> core::panic::panic(), Err(error) -> error };
    }

    pub fn unwrap_or(self, fallback: T) -> T {
        return match (self) { Ok(inner) -> inner, Err(_) -> fallback };
    }

    pub fn unwrap_err_or(self, fallback: E) -> E {
        return match (self) { Ok(_) -> fallback, Err(error) -> error };
    }

    pub fn or(self, fallback: Result<T, E>) -> Result<T, E> {
        let successful: bool = match (self) { Ok(_) -> true, Err(_) -> false };
        if (successful) { return self; }
        return fallback;
    }

    pub fn and(self, next: Result<T, E>) -> Result<T, E> {
        let successful: bool = match (self) { Ok(_) -> true, Err(_) -> false };
        if (successful) { return next; }
        return self;
    }
}
