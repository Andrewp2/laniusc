// Recoverable results: Ok carries the value, Err the error. Operations take
// the wrapper by value and do not rewrite the caller's wrapper descriptor.
// Values are shallow: a selected transformation callback may affect referenced
// backing under the application's explicit ownership-transfer policy.
// Each operation exists as a free function and a method. Membership needs
// PartialEq on the payload it compares. unwrap and unwrap_err panic on the
// other variant; unwrap_or and unwrap_err_or select explicit fallback values.

module core::result;

import core::cmp;
import core::function;
import core::panic;

pub enum Result<T, E> {
    Ok(T),
    Err(E),
}

pub fn is_ok<T, E>(value: Result<T, E>) -> bool {
    return match (value) { Ok(_) -> true, Err(_) -> false };
}

pub fn is_err<T, E>(value: Result<T, E>) -> bool {
    return match (value) { Ok(_) -> false, Err(_) -> true };
}

pub fn contains<T, E>(value: Result<T, E>, expected: T) -> bool where T: core::cmp::PartialEq<T> {
    return match (value) { Ok(inner) -> T::partial_eq(inner, expected), Err(_) -> false };
}

pub fn contains_err<T, E>(value: Result<T, E>, expected: E) -> bool where E: core::cmp::PartialEq<E> {
    return match (value) { Ok(_) -> false, Err(error) -> E::partial_eq(error, expected) };
}

pub fn unwrap<T, E>(value: Result<T, E>) -> T {
    return match (value) { Ok(inner) -> inner, Err(_) -> core::panic::panic() };
}

pub fn unwrap_err<T, E>(value: Result<T, E>) -> E {
    return match (value) { Ok(_) -> core::panic::panic(), Err(error) -> error };
}

pub fn unwrap_or<T, E>(value: Result<T, E>, fallback: T) -> T {
    return match (value) { Ok(inner) -> inner, Err(_) -> fallback };
}

pub fn unwrap_err_or<T, E>(value: Result<T, E>, fallback: E) -> E {
    return match (value) { Ok(_) -> fallback, Err(error) -> error };
}

// A successful left value wins; two failures give the fallback's error.
pub fn or<T,E,F>(value: Result<T,E>, fallback: Result<T,F>) -> Result<T,F> {
    return match(value) { Ok(inner)->Ok(inner), Err(_)->fallback };
}

// Success gives `next`; a failed left value keeps its error.
pub fn and<T,E,U>(value: Result<T,E>, next: Result<U,E>) -> Result<U,E> {
    return match(value) { Ok(_)->next, Err(error)->Err(error) };
}

// Selected callbacks run once; skipped callbacks never run. Inputs and
// outputs remain shallow: account for discarded owners and deactivate older
// aliases after any explicit transfer into a transformation callback.
pub fn map<T,E,U,M>(value:Result<T,E>, mapper:&M) -> Result<U,E>
    where M:core::function::Mapper<T,U> {
    if (is_err(value)) { let error:E = unwrap_err(value); return Err(error); }
    let inner:T = unwrap(value); let mapped:U = mapper.apply(inner);
    return Ok(mapped);
}

pub fn map_err<T,E,F,M>(value:Result<T,E>, mapper:&M) -> Result<T,F>
    where M:core::function::Mapper<E,F> {
    if (is_ok(value)) { let inner:T = unwrap(value); return Ok(inner); }
    let error:E = unwrap_err(value); let mapped:F = mapper.apply(error);
    return Err(mapped);
}

// fallback is evaluated before entry even when Ok selects the mapper.
pub fn map_or<T,E,U,M>(value:Result<T,E>, fallback:U, mapper:&M) -> U
    where M:core::function::Mapper<T,U> {
    if (is_err(value)) { return fallback; }
    let inner:T = unwrap(value); return mapper.apply(inner);
}

pub fn map_or_else<T,E,U,D,M>(value:Result<T,E>, fallback:&D, mapper:&M) -> U
    where D:core::function::Mapper<E,U>, M:core::function::Mapper<T,U> {
    if (is_err(value)) { let error:E = unwrap_err(value); return fallback.apply(error); }
    let inner:T = unwrap(value); return mapper.apply(inner);
}

pub fn and_then<T,E,U,M>(value:Result<T,E>, mapper:&M) -> Result<U,E>
    where M:core::function::Mapper<T,Result<U,E>> {
    if (is_err(value)) { let error:E = unwrap_err(value); return Err(error); }
    let inner:T = unwrap(value); return mapper.apply(inner);
}

pub fn or_else<T,E,F,M>(value:Result<T,E>, fallback:&M) -> Result<T,F>
    where M:core::function::Mapper<E,Result<T,F>> {
    if (is_ok(value)) { let inner:T = unwrap(value); return Ok(inner); }
    let error:E = unwrap_err(value); return fallback.apply(error);
}

pub fn unwrap_or_else<T,E,M>(value:Result<T,E>, fallback:&M) -> T
    where M:core::function::Mapper<E,T> {
    if (is_ok(value)) { return unwrap(value); }
    let error:E = unwrap_err(value); return fallback.apply(error);
}

// Both predicates only observe call-scoped borrowed descriptors. They must
// not mutate or retire represented resources, or retain those descriptors
// beyond the callback. Independent scalar observations are allowed.
pub fn is_ok_and<T,E,P>(value:Result<T,E>, predicate:&P) -> bool
    where P:core::function::Mapper<T,bool> {
    if (is_err(value)) { return false; }
    let inner:T = unwrap(value); return predicate.apply(inner);
}

pub fn is_err_and<T,E,P>(value:Result<T,E>, predicate:&P) -> bool
    where P:core::function::Mapper<E,bool> {
    if (is_ok(value)) { return false; }
    let error:E = unwrap_err(value); return predicate.apply(error);
}

pub impl<T, E> Result<T, E> {
    pub fn is_ok(self) -> bool {
        return match (self) { Ok(_) -> true, Err(_) -> false };
    }

    pub fn is_err(self) -> bool {
        return match (self) { Ok(_) -> false, Err(_) -> true };
    }

    pub fn contains(self, expected: T) -> bool where T: core::cmp::PartialEq<T> {
        return match (self) { Ok(inner) -> T::partial_eq(inner, expected), Err(_) -> false };
    }

    pub fn contains_err(self, expected: E) -> bool where E: core::cmp::PartialEq<E> {
        return match (self) { Ok(_) -> false, Err(error) -> E::partial_eq(error, expected) };
    }

    pub fn unwrap(self) -> T {
        return match (self) { Ok(inner) -> inner, Err(_) -> core::panic::panic() };
    }

    pub fn unwrap_err(self) -> E {
        return match (self) { Ok(_) -> core::panic::panic(), Err(error) -> error };
    }

    pub fn unwrap_or(self, fallback: T) -> T {
        return match (self) { Ok(inner) -> inner, Err(_) -> fallback };
    }

    pub fn unwrap_err_or(self, fallback: E) -> E {
        return match (self) { Ok(_) -> fallback, Err(error) -> error };
    }

    pub fn or<F>(self, fallback: Result<T,F>) -> Result<T,F> {
        return match(self) { Ok(inner)->Ok(inner), Err(_)->fallback };
    }

    pub fn and<U>(self, next: Result<U,E>) -> Result<U,E> {
        return match(self) { Ok(_)->next, Err(error)->Err(error) };
    }

    pub fn map<U,M>(self, mapper:&M) -> Result<U,E> where M:core::function::Mapper<T,U> {
        return core::result::map<T,E,U,M>(self,mapper);
    }
    pub fn map_err<F,M>(self, mapper:&M) -> Result<T,F> where M:core::function::Mapper<E,F> {
        return core::result::map_err<T,E,F,M>(self,mapper);
    }
    pub fn map_or<U,M>(self, fallback:U, mapper:&M) -> U where M:core::function::Mapper<T,U> {
        return core::result::map_or<T,E,U,M>(self,fallback,mapper);
    }
    pub fn map_or_else<U,D,M>(self, fallback:&D, mapper:&M) -> U
        where D:core::function::Mapper<E,U>, M:core::function::Mapper<T,U> {
        return core::result::map_or_else<T,E,U,D,M>(self,fallback,mapper);
    }
    pub fn and_then<U,M>(self, mapper:&M) -> Result<U,E>
        where M:core::function::Mapper<T,Result<U,E>> {
        return core::result::and_then<T,E,U,M>(self,mapper);
    }
    pub fn or_else<F,M>(self, fallback:&M) -> Result<T,F>
        where M:core::function::Mapper<E,Result<T,F>> {
        return core::result::or_else<T,E,F,M>(self,fallback);
    }
    pub fn unwrap_or_else<M>(self, fallback:&M) -> T where M:core::function::Mapper<E,T> {
        return core::result::unwrap_or_else<T,E,M>(self,fallback);
    }
    pub fn is_ok_and<P>(self, predicate:&P) -> bool where P:core::function::Mapper<T,bool> {
        return core::result::is_ok_and<T,E,P>(self,predicate);
    }
    pub fn is_err_and<P>(self, predicate:&P) -> bool where P:core::function::Mapper<E,bool> {
        return core::result::is_err_and<T,E,P>(self,predicate);
    }
}

// Outer success selects the inner result; outer failure preserves its error.
// Payloads remain shallow copies: no allocation, clone or cleanup is implied.
pub fn flatten<T,E>(value:Result<Result<T,E>,E>) -> Result<T,E> {
    return match(value) { Ok(inner)->inner, Err(error)->Err(error) };
}
pub impl<T,E> Result<Result<T,E>,E> {
    pub fn flatten(self) -> Result<T,E> { return core::result::flatten<T,E>(self); }
}
