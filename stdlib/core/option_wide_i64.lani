// A concrete optional two-word signed value until generic enums execute.
// None has zeroed words; inspect present before reading the payload.
module core::option_wide_i64;
import core::option_i32;
import core::result_wide_i64;
import core::wide_i64;

pub struct OptionWideI64 {
    present: bool,
    high: u32,
    low: u32,
}

pub fn some(value: core::wide_i64::WideI64) -> OptionWideI64 {
    return OptionWideI64 {
        present: true,
        high: core::wide_i64::high_word(value),
        low: core::wide_i64::low_word(value),
    };
}

pub fn none() -> OptionWideI64 {
    return OptionWideI64 { present: false, high: 0, low: 0 };
}

pub fn is_some(value: OptionWideI64) -> bool {
    return value.present;
}

pub fn is_none(value: OptionWideI64) -> bool {
    return !value.present;
}

pub fn contains(value: OptionWideI64, expected: core::wide_i64::WideI64) -> bool {
    return value.present && value.high == core::wide_i64::high_word(expected) &&
        value.low == core::wide_i64::low_word(expected);
}

pub fn unwrap_or(
    value: OptionWideI64, fallback: core::wide_i64::WideI64
) -> core::wide_i64::WideI64 {
    if (value.present) { return core::wide_i64::from_words(value.high, value.low); }
    return fallback;
}

pub fn or(value: OptionWideI64, fallback: OptionWideI64) -> OptionWideI64 {
    if (value.present) { return value; }
    return fallback;
}

pub fn and(value: OptionWideI64, next: OptionWideI64) -> OptionWideI64 {
    if (value.present) { return next; }
    return value;
}

pub fn xor(left: OptionWideI64, right: OptionWideI64) -> OptionWideI64 {
    if (left.present) {
        if (right.present) { return none(); }
        return left;
    }
    return right;
}

pub fn ok_or(value: OptionWideI64, error: i32) -> core::result_wide_i64::ResultWideI64 {
    if (value.present) {
        return core::result_wide_i64::ok(
            core::wide_i64::from_words(value.high, value.low));
    }
    return core::result_wide_i64::err(error);
}

pub fn ok(value: core::result_wide_i64::ResultWideI64) -> OptionWideI64 {
    if (core::result_wide_i64::is_ok(value)) {
        return some(core::result_wide_i64::unwrap_or(value, core::wide_i64::zero()));
    }
    return none();
}

pub fn err(value: core::result_wide_i64::ResultWideI64) -> core::option_i32::OptionI32 {
    if (core::result_wide_i64::is_err(value)) {
        return core::option_i32::some(core::result_wide_i64::unwrap_err_or(value, 0));
    }
    return core::option_i32::none();
}
