// A concrete u32 result with an u32 error code until generic enums execute.
// The inactive payload is zero; inspect `success` before reading a payload.
module core::result_u32;

pub struct ResultU32 {
    success: bool,
    value: u32,
    error: u32,
}

pub fn ok(value: u32) -> ResultU32 {
    return ResultU32 { success: true, value: value, error: 0 };
}

pub fn err(error: u32) -> ResultU32 {
    return ResultU32 { success: false, value: 0, error: error };
}

pub fn is_ok(value: ResultU32) -> bool {
    return value.success;
}

pub fn is_err(value: ResultU32) -> bool {
    return !value.success;
}

pub fn contains(value: ResultU32, expected: u32) -> bool {
    return value.success && value.value == expected;
}

pub fn contains_err(value: ResultU32, expected: u32) -> bool {
    return !value.success && value.error == expected;
}

pub fn unwrap_or(value: ResultU32, fallback: u32) -> u32 {
    if (value.success) { return value.value; }
    return fallback;
}

pub fn unwrap_err_or(value: ResultU32, fallback: u32) -> u32 {
    if (!value.success) { return value.error; }
    return fallback;
}

pub fn or(value: ResultU32, fallback: ResultU32) -> ResultU32 {
    if (value.success) { return value; }
    return fallback;
}

pub fn and(value: ResultU32, next: ResultU32) -> ResultU32 {
    if (value.success) { return next; }
    return value;
}
