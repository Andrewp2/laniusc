// Allocation-free operations on caller-backed floating-point views. Every
// logical length must fit the physical backing. Native indexing traps if an
// overclaimed length reaches an element outside that backing.
module core::slice_f32;

import core::f32;

// Invalid logical bounds return the caller's fallback without indexing.
pub fn get_or(values: [f32], len: i32, index: i32, fallback: f32) -> f32 {
    if (len <= 0 || index < 0 || index >= len) {
        return fallback;
    }
    return values[index];
}

pub fn first_or(values: [f32], len: i32, fallback: f32) -> f32 {
    return get_or(values, len, 0, fallback);
}

// Invalid logical bounds leave the view unchanged.
pub fn set(values: [f32], len: i32, index: i32, value: f32) -> bool {
    if (len <= 0 || index < 0 || index >= len) {
        return false;
    }
    values[index] = value;
    return true;
}

// A nonpositive length writes nothing and returns zero.
pub fn fill(values: [f32], len: i32, value: f32) -> i32 {
    let index: i32 = 0;
    while (index < len) {
        values[index] = value;
        index += 1;
    }
    return index;
}

// Invalid logical bounds leave the view unchanged.
pub fn swap(values: [f32], len: i32, left: i32, right: i32) -> bool {
    if (len <= 0 || left < 0 || right < 0 || left >= len || right >= len) {
        return false;
    }
    let previous: f32 = values[left];
    values[left] = values[right];
    values[right] = previous;
    return true;
}

// Overlap is supported. Invalid logical bounds write nothing.
pub fn copy_within(values: [f32], len: i32, start: i32, end: i32, destination: i32) -> bool {
    if (len < 0 || start < 0 || end < start || end > len || destination < 0) {
        return false;
    }
    let count: i32 = end - start;
    if (destination > len - count) {
        return false;
    }
    if (destination > start) {
        let remaining: i32 = count;
        while (remaining > 0) {
            remaining -= 1;
            values[destination + remaining] = values[start + remaining];
        }
    } else {
        let offset: i32 = 0;
        while (offset < count) {
            values[destination + offset] = values[start + offset];
            offset += 1;
        }
    }
    return true;
}

// A nonpositive length writes nothing and returns zero.
pub fn reverse(values: [f32], len: i32) -> i32 {
    if (len <= 0) {
        return 0;
    }
    let left: i32 = 0;
    let right: i32 = len - 1;
    while (left < right) {
        let previous: f32 = values[left];
        values[left] = values[right];
        values[right] = previous;
        left += 1;
        right -= 1;
    }
    return len;
}

fn reverse_segment(values: [f32], start: i32, end: i32) {
    let left: i32 = start;
    let right: i32 = end - 1;
    while (left < right) {
        let previous: f32 = values[left];
        values[left] = values[right];
        values[right] = previous;
        left += 1;
        right -= 1;
    }
}

// Amount must be in [0, len]. Invalid bounds leave the view unchanged.
pub fn rotate_left(values: [f32], len: i32, amount: i32) -> bool {
    if (len < 0 || amount < 0 || amount > len) { return false; }
    if (amount == 0 || amount == len) { return true; }
    reverse_segment(values, 0, amount);
    reverse_segment(values, amount, len);
    reverse_segment(values, 0, len);
    return true;
}

pub fn rotate_right(values: [f32], len: i32, amount: i32) -> bool {
    if (len < 0 || amount < 0 || amount > len) { return false; }
    return rotate_left(values, len, len - amount);
}

// Copies the shorter logical prefix between distinct backing views, or two
// views with the same start. Negative lengths return -1 without writing.
// Other overlap is unsupported.
pub fn copy_prefix(
    source: [f32], source_len: i32,
    destination: [f32], destination_len: i32
) -> i32 {
    if (source_len < 0 || destination_len < 0) {
        return -1;
    }
    let count: i32 = source_len;
    if (destination_len < count) {
        count = destination_len;
    }
    let index: i32 = 0;
    while (index < count) {
        destination[index] = source[index];
        index += 1;
    }
    return count;
}

// Copies a checked range between disjoint source and destination backings.
// destination_len is writable capacity. Invalid bounds write nothing.
pub fn copy_nonoverlapping_range(
    destination: [f32], destination_len: i32, destination_start: i32,
    source: [f32], source_len: i32, source_start: i32, count: i32
) -> bool {
    if (destination_len < 0 || source_len < 0 || count < 0 ||
        destination_start < 0 || source_start < 0 ||
        count > destination_len || count > source_len ||
        destination_start > destination_len - count ||
        source_start > source_len - count) { return false; }
    let index: i32 = 0;
    while (index < count) {
        destination[destination_start + index] = source[source_start + index];
        index += 1;
    }
    return true;
}

// Adjacent values compare with IEEE equality: signed zeros coalesce but NaNs
// do not. The tail is unspecified. Negative lengths return -1 unchanged.
pub fn dedup_adjacent(values: [f32], len: i32) -> i32 {
    if (len < 0) { return -1; }
    if (len == 0) { return 0; }
    let write: i32 = 1;
    let read: i32 = 1;
    while (read < len) {
        let current: f32 = values[read];
        if (current != values[write - 1]) {
            values[write] = current;
            write += 1;
        }
        read += 1;
    }
    return write;
}

// Retains order. A NaN target matches nothing under IEEE equality. The tail
// is unspecified; negative lengths return -1 without writing.
pub fn retain_not_equal(values: [f32], len: i32, target: f32) -> i32 {
    if (len < 0) { return -1; }
    let read: i32 = 0;
    let write: i32 = 0;
    while (read < len) {
        let current: f32 = values[read];
        if (current != target) {
            values[write] = current;
            write += 1;
        }
        read += 1;
    }
    return write;
}

// On success the caller reduces its logical length by one.
pub fn remove_at(values: [f32], len: i32, index: i32) -> bool {
    if (len <= 0 || index < 0 || index >= len) { return false; }
    let read: i32 = index + 1;
    while (read < len) {
        values[read - 1] = values[read];
        read += 1;
    }
    return true;
}

// Capacity must fit writable backing. Success grows the logical length by
// one; invalid bounds leave all elements unchanged.
pub fn insert(values: [f32], len: i32, capacity: i32, index: i32, value: f32) -> bool {
    if (len < 0 || capacity <= 0 || len >= capacity || index < 0 || index > len) {
        return false;
    }
    let cursor: i32 = len;
    while (cursor > index) {
        values[cursor] = values[cursor - 1];
        cursor -= 1;
    }
    values[index] = value;
    return true;
}

pub fn push(values: [f32], len: i32, capacity: i32, value: f32) -> bool {
    return insert(values, len, capacity, len, value);
}

// Uses IEEE equality: NaN never matches, while positive and negative zero do.
pub fn contains(values: [f32], len: i32, target: f32) -> bool {
    if (len <= 0) {
        return false;
    }
    let index: i32 = 0;
    while (index < len) {
        if (values[index] == target) {
            return true;
        }
        index += 1;
    }
    return false;
}

// A negative length returns -1. NaN never matches, even itself.
pub fn count(values: [f32], len: i32, target: f32) -> i32 {
    if (len < 0) { return -1; }
    let found: i32 = 0;
    let index: i32 = 0;
    while (index < len) {
        if (values[index] == target) { found += 1; }
        index += 1;
    }
    return found;
}

// Invalid or missing searches return the caller's fallback index. NaN never
// matches under IEEE equality.
pub fn first_index_or(values: [f32], len: i32, target: f32, fallback: i32) -> i32 {
    if (len <= 0) {
        return fallback;
    }
    let index: i32 = 0;
    while (index < len) {
        if (values[index] == target) {
            return index;
        }
        index += 1;
    }
    return fallback;
}

// Invalid or missing searches return the caller's fallback index. NaN never
// matches under IEEE equality.
pub fn last_index_or(values: [f32], len: i32, target: f32, fallback: i32) -> i32 {
    if (len <= 0) {
        return fallback;
    }
    let remaining: i32 = len;
    while (remaining > 0) {
        remaining -= 1;
        if (values[remaining] == target) {
            return remaining;
        }
    }
    return fallback;
}

// Negative or different logical lengths are unequal. IEEE equality applies
// element by element, including NaN and signed zero.
pub fn equal(left: [f32], left_len: i32, right: [f32], right_len: i32) -> bool {
    if (left_len < 0 || right_len < 0 || left_len != right_len) {
        return false;
    }
    let index: i32 = 0;
    while (index < left_len) {
        if (left[index] != right[index]) {
            return false;
        }
        index += 1;
    }
    return true;
}

// IEEE equality applies element by element; an empty pattern matches every
// valid view, while a pattern containing NaN never matches.
pub fn starts_with(values: [f32], len: i32, prefix: [f32], prefix_len: i32) -> bool {
    if (len < 0 || prefix_len < 0 || prefix_len > len) { return false; }
    let index: i32 = 0;
    while (index < prefix_len) {
        if (values[index] != prefix[index]) { return false; }
        index += 1;
    }
    return true;
}

pub fn ends_with(values: [f32], len: i32, suffix: [f32], suffix_len: i32) -> bool {
    if (len < 0 || suffix_len < 0 || suffix_len > len) { return false; }
    let start: i32 = len - suffix_len;
    let index: i32 = 0;
    while (index < suffix_len) {
        if (values[start + index] != suffix[index]) { return false; }
        index += 1;
    }
    return true;
}

// An empty needle matches at zero; invalid or missing searches return fallback.
pub fn index_of_subslice_or(
    values: [f32], len: i32, needle: [f32], needle_len: i32, fallback: i32
) -> i32 {
    if (len < 0 || needle_len < 0 || needle_len > len) { return fallback; }
    let start: i32 = 0;
    while (start <= len - needle_len) {
        let offset: i32 = 0;
        while (offset < needle_len && values[start + offset] == needle[offset]) {
            offset += 1;
        }
        if (offset == needle_len) { return start; }
        start += 1;
    }
    return fallback;
}

// The last match of an empty needle is at len.
pub fn last_index_of_subslice_or(
    values: [f32], len: i32, needle: [f32], needle_len: i32, fallback: i32
) -> i32 {
    if (len < 0 || needle_len < 0 || needle_len > len) { return fallback; }
    let start: i32 = len - needle_len;
    while (start >= 0) {
        let offset: i32 = 0;
        while (offset < needle_len && values[start + offset] == needle[offset]) {
            offset += 1;
        }
        if (offset == needle_len) { return start; }
        start -= 1;
    }
    return fallback;
}

// Folds left to right. Negative lengths return fallback; empty views sum to
// zero. IEEE NaN and infinity propagation follow ordinary f32 addition.
pub fn sum_or(values: [f32], len: i32, fallback: f32) -> f32 {
    if (len < 0) {
        return fallback;
    }
    let total: f32 = 0.0;
    let index: i32 = 0;
    while (index < len) {
        total += values[index];
        index += 1;
    }
    return total;
}

fn all_finite(values: [f32], len: i32) -> bool {
    if (len < 0) { return false; }
    let index: i32 = 0;
    while (index < len) {
        if (!core::f32::is_finite(values[index])) { return false; }
        index += 1;
    }
    return true;
}

// Nonfinite values and negative lengths are invalid. Equal signed zeros are
// accepted because ordinary f32 comparisons do not distinguish them.
pub fn is_sorted_finite(values: [f32], len: i32) -> bool {
    if (!all_finite(values, len)) { return false; }
    let index: i32 = 1;
    while (index < len) {
        if (values[index - 1] > values[index]) { return false; }
        index += 1;
    }
    return true;
}

fn sift_down_max_finite(values: [f32], heap_len: i32, start: i32) {
    if (heap_len > 1) {
        let root: i32 = start;
        while (root <= (heap_len - 2) / 2) {
            let child: i32 = root * 2 + 1;
            let largest: i32 = root;
            if (values[largest] < values[child]) { largest = child; }
            if (child + 1 < heap_len && values[largest] < values[child + 1]) {
                largest = child + 1;
            }
            if (largest == root) { break; }
            let previous: f32 = values[root];
            values[root] = values[largest];
            values[largest] = previous;
            root = largest;
        }
    }
}

// In-place ascending heapsort over finite values. Checks the entire logical
// view before writing, so a negative length, NaN, or infinity returns false
// without mutation. Signed zeros may appear in either order.
pub fn sort_finite(values: [f32], len: i32) -> bool {
    if (!all_finite(values, len)) { return false; }
    if (len <= 1) { return true; }
    let start: i32 = (len - 2) / 2;
    while (start >= 0) {
        sift_down_max_finite(values, len, start);
        if (start == 0) { break; }
        start -= 1;
    }
    let remaining: i32 = len;
    while (remaining > 1) {
        remaining -= 1;
        let previous: f32 = values[0];
        values[0] = values[remaining];
        values[remaining] = previous;
        sift_down_max_finite(values, remaining, 0);
    }
    return true;
}

// Returns the first position whose value is at least needle. Invalid input
// returns fallback: the view must be sorted and all values finite.
pub fn lower_bound_finite_or(values: [f32], len: i32, needle: f32, fallback: i32) -> i32 {
    if (!core::f32::is_finite(needle) || !is_sorted_finite(values, len)) {
        return fallback;
    }
    let low: i32 = 0;
    let high: i32 = len;
    while (low < high) {
        let middle: i32 = low + (high - low) / 2;
        if (values[middle] < needle) { low = middle + 1; }
        else { high = middle; }
    }
    return low;
}

// Returns the first position whose value is greater than needle.
pub fn upper_bound_finite_or(values: [f32], len: i32, needle: f32, fallback: i32) -> i32 {
    if (!core::f32::is_finite(needle) || !is_sorted_finite(values, len)) {
        return fallback;
    }
    let low: i32 = 0;
    let high: i32 = len;
    while (low < high) {
        let middle: i32 = low + (high - low) / 2;
        if (values[middle] <= needle) { low = middle + 1; }
        else { high = middle; }
    }
    return low;
}

// Returns the first equal index or fallback. Invalid views and needles use
// the same fallback; a valid index is never negative.
pub fn binary_search_first_finite_or(values: [f32], len: i32, needle: f32, fallback: i32) -> i32 {
    let index: i32 = lower_bound_finite_or(values, len, needle, -1);
    if (index >= 0 && index < len && values[index] == needle) { return index; }
    return fallback;
}

// Returns the last equal index or fallback.
pub fn binary_search_last_finite_or(values: [f32], len: i32, needle: f32, fallback: i32) -> i32 {
    let after: i32 = upper_bound_finite_or(values, len, needle, -1);
    if (after > 0 && values[after - 1] == needle) { return after - 1; }
    return fallback;
}
