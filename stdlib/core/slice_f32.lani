// Allocation-free operations on caller-backed floating-point views. Every
// logical length must fit the physical backing. Native indexing traps if an
// overclaimed length reaches an element outside that backing.
module core::slice_f32;

// Invalid logical bounds return the caller's fallback without indexing.
pub fn get_or(values: [f32], len: i32, index: i32, fallback: f32) -> f32 {
    if (len <= 0 || index < 0 || index >= len) {
        return fallback;
    }
    return values[index];
}

// Invalid logical bounds leave the view unchanged.
pub fn set(values: [f32], len: i32, index: i32, value: f32) -> bool {
    if (len <= 0 || index < 0 || index >= len) {
        return false;
    }
    values[index] = value;
    return true;
}

// A nonpositive length writes nothing and returns zero.
pub fn fill(values: [f32], len: i32, value: f32) -> i32 {
    let index: i32 = 0;
    while (index < len) {
        values[index] = value;
        index += 1;
    }
    return index;
}

// Invalid logical bounds leave the view unchanged.
pub fn swap(values: [f32], len: i32, left: i32, right: i32) -> bool {
    if (len <= 0 || left < 0 || right < 0 || left >= len || right >= len) {
        return false;
    }
    let previous: f32 = values[left];
    values[left] = values[right];
    values[right] = previous;
    return true;
}

// Overlap is supported. Invalid logical bounds write nothing.
pub fn copy_within(values: [f32], len: i32, start: i32, end: i32, destination: i32) -> bool {
    if (len < 0 || start < 0 || end < start || end > len || destination < 0) {
        return false;
    }
    let count: i32 = end - start;
    if (destination > len - count) {
        return false;
    }
    if (destination > start) {
        let remaining: i32 = count;
        while (remaining > 0) {
            remaining -= 1;
            values[destination + remaining] = values[start + remaining];
        }
    } else {
        let offset: i32 = 0;
        while (offset < count) {
            values[destination + offset] = values[start + offset];
            offset += 1;
        }
    }
    return true;
}

// A nonpositive length writes nothing and returns zero.
pub fn reverse(values: [f32], len: i32) -> i32 {
    if (len <= 0) {
        return 0;
    }
    let left: i32 = 0;
    let right: i32 = len - 1;
    while (left < right) {
        let previous: f32 = values[left];
        values[left] = values[right];
        values[right] = previous;
        left += 1;
        right -= 1;
    }
    return len;
}

// Copies the shorter logical prefix between distinct backing views, or two
// views with the same start. Negative lengths return -1 without writing.
// Other overlap is unsupported.
pub fn copy_prefix(
    source: [f32], source_len: i32,
    destination: [f32], destination_len: i32
) -> i32 {
    if (source_len < 0 || destination_len < 0) {
        return -1;
    }
    let count: i32 = source_len;
    if (destination_len < count) {
        count = destination_len;
    }
    let index: i32 = 0;
    while (index < count) {
        destination[index] = source[index];
        index += 1;
    }
    return count;
}

// Uses IEEE equality: NaN never matches, while positive and negative zero do.
pub fn contains(values: [f32], len: i32, target: f32) -> bool {
    if (len <= 0) {
        return false;
    }
    let index: i32 = 0;
    while (index < len) {
        if (values[index] == target) {
            return true;
        }
        index += 1;
    }
    return false;
}

// Invalid or missing searches return the caller's fallback index. NaN never
// matches under IEEE equality.
pub fn first_index_or(values: [f32], len: i32, target: f32, fallback: i32) -> i32 {
    if (len <= 0) {
        return fallback;
    }
    let index: i32 = 0;
    while (index < len) {
        if (values[index] == target) {
            return index;
        }
        index += 1;
    }
    return fallback;
}

// Invalid or missing searches return the caller's fallback index. NaN never
// matches under IEEE equality.
pub fn last_index_or(values: [f32], len: i32, target: f32, fallback: i32) -> i32 {
    if (len <= 0) {
        return fallback;
    }
    let remaining: i32 = len;
    while (remaining > 0) {
        remaining -= 1;
        if (values[remaining] == target) {
            return remaining;
        }
    }
    return fallback;
}

// Negative or different logical lengths are unequal. IEEE equality applies
// element by element, including NaN and signed zero.
pub fn equal(left: [f32], left_len: i32, right: [f32], right_len: i32) -> bool {
    if (left_len < 0 || right_len < 0 || left_len != right_len) {
        return false;
    }
    let index: i32 = 0;
    while (index < left_len) {
        if (left[index] != right[index]) {
            return false;
        }
        index += 1;
    }
    return true;
}

// Folds left to right. Negative lengths return fallback; empty views sum to
// zero. IEEE NaN and infinity propagation follow ordinary f32 addition.
pub fn sum_or(values: [f32], len: i32, fallback: f32) -> f32 {
    if (len < 0) {
        return fallback;
    }
    let total: f32 = 0.0;
    let index: i32 = 0;
    while (index < len) {
        total += values[index];
        index += 1;
    }
    return total;
}
