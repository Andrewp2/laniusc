// A concrete optional i8 until generic enum values execute natively.
// `value` is zero for None and must be read only when `present` is true.
module core::option_i8;
import core::result_i8;

pub struct OptionI8 {
    present: bool,
    value: i8,
}

pub fn some(value: i8) -> OptionI8 {
    return OptionI8 { present: true, value: value };
}

pub fn none() -> OptionI8 {
    return OptionI8 { present: false, value: 0 };
}

pub fn is_some(value: OptionI8) -> bool {
    return value.present;
}

pub fn is_none(value: OptionI8) -> bool {
    return !value.present;
}

pub fn contains(value: OptionI8, expected: i8) -> bool {
    return value.present && value.value == expected;
}

pub fn unwrap_or(value: OptionI8, fallback: i8) -> i8 {
    if (value.present) { return value.value; }
    return fallback;
}

pub fn or(value: OptionI8, fallback: OptionI8) -> OptionI8 {
    if (value.present) { return value; }
    return fallback;
}

pub fn and(value: OptionI8, next: OptionI8) -> OptionI8 {
    if (value.present) { return next; }
    return value;
}

pub fn xor(left: OptionI8, right: OptionI8) -> OptionI8 {
    if (left.present) {
        if (right.present) { return none(); }
        return left;
    }
    return right;
}

pub fn ok_or(value: OptionI8, error: i8) -> core::result_i8::ResultI8 {
    if (value.present) { return core::result_i8::ok(value.value); }
    return core::result_i8::err(error);
}

pub fn ok(value: core::result_i8::ResultI8) -> OptionI8 {
    if (core::result_i8::is_ok(value)) {
        return some(core::result_i8::unwrap_or(value, 0));
    }
    return none();
}

pub fn err(value: core::result_i8::ResultI8) -> OptionI8 {
    if (core::result_i8::is_err(value)) {
        return some(core::result_i8::unwrap_err_or(value, 0));
    }
    return none();
}
