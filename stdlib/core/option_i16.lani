// A concrete optional i16 until generic enum values execute natively.
// `value` is zero for None and must be read only when `present` is true.
module core::option_i16;
import core::result_i16;

pub struct OptionI16 {
    present: bool,
    value: i16,
}

pub fn some(value: i16) -> OptionI16 {
    return OptionI16 { present: true, value: value };
}

pub fn none() -> OptionI16 {
    return OptionI16 { present: false, value: 0 };
}

pub fn is_some(value: OptionI16) -> bool {
    return value.present;
}

pub fn is_none(value: OptionI16) -> bool {
    return !value.present;
}

pub fn contains(value: OptionI16, expected: i16) -> bool {
    return value.present && value.value == expected;
}

pub fn unwrap_or(value: OptionI16, fallback: i16) -> i16 {
    if (value.present) { return value.value; }
    return fallback;
}

pub fn or(value: OptionI16, fallback: OptionI16) -> OptionI16 {
    if (value.present) { return value; }
    return fallback;
}

pub fn and(value: OptionI16, next: OptionI16) -> OptionI16 {
    if (value.present) { return next; }
    return value;
}

pub fn xor(left: OptionI16, right: OptionI16) -> OptionI16 {
    if (left.present) {
        if (right.present) { return none(); }
        return left;
    }
    return right;
}

pub fn ok_or(value: OptionI16, error: i16) -> core::result_i16::ResultI16 {
    if (value.present) { return core::result_i16::ok(value.value); }
    return core::result_i16::err(error);
}

pub fn ok(value: core::result_i16::ResultI16) -> OptionI16 {
    if (core::result_i16::is_ok(value)) {
        return some(core::result_i16::unwrap_or(value, 0));
    }
    return none();
}

pub fn err(value: core::result_i16::ResultI16) -> OptionI16 {
    if (core::result_i16::is_err(value)) {
        return some(core::result_i16::unwrap_err_or(value, 0));
    }
    return none();
}

pub impl OptionI16 {
    pub fn is_some(&self) -> bool { return self.present; }
    pub fn is_none(&self) -> bool { return !self.present; }
    pub fn contains(&self, expected: i16) -> bool {
        return self.present && self.value == expected;
    }
    pub fn unwrap_or(&self, fallback: i16) -> i16 {
        if (self.present) { return self.value; }
        return fallback;
    }
    pub fn or(&self, fallback: OptionI16) -> OptionI16 {
        if (self.present) { return OptionI16 { present: true, value: self.value }; }
        return fallback;
    }
    pub fn and(&self, next: OptionI16) -> OptionI16 {
        if (self.present) { return next; }
        return none();
    }
    pub fn xor(&self, right: OptionI16) -> OptionI16 {
        if (self.present) {
            if (right.present) { return none(); }
            return OptionI16 { present: true, value: self.value };
        }
        return right;
    }
    pub fn ok_or(&self, error: i16) -> core::result_i16::ResultI16 {
        if (self.present) { return core::result_i16::ok(self.value); }
        return core::result_i16::err(error);
    }
}
