// Optional values. A stored false is Some(false), not None. Operations take
// the wrapper by value and do not rewrite the caller's wrapper descriptor.
// Values are shallow: a selected transformation callback may affect referenced
// backing under the application's explicit ownership-transfer policy.
// contains needs PartialEq on the payload. unwrap panics on None; unwrap_or
// selects an explicit fallback. See docs/stdlib-option.md.
module core::option;

import core::cmp;
import core::function;
import core::panic;
import core::result;

pub enum Option<T> {
    Some(T),
    None,
}

pub fn is_some<T>(value: Option<T>) -> bool {
    return match (value) { Some(_) -> true, None -> false };
}

pub fn is_none<T>(value: Option<T>) -> bool {
    return match (value) { Some(_) -> false, None -> true };
}

pub fn contains<T>(value: Option<T>, expected: T) -> bool where T: core::cmp::PartialEq<T> {
    return match (value) { Some(inner) -> T::partial_eq(inner, expected), None -> false };
}

pub fn unwrap<T>(value: Option<T>) -> T {
    return match (value) { Some(inner) -> inner, None -> core::panic::panic() };
}

pub fn unwrap_or<T>(value: Option<T>, fallback: T) -> T {
    return match (value) { Some(inner) -> inner, None -> fallback };
}

pub fn or<T>(value: Option<T>, fallback: Option<T>) -> Option<T> {
    if (is_some(value)) { return value; }
    return fallback;
}

pub fn and<T,U>(value: Option<T>, next: Option<U>) -> Option<U> {
    if (is_some(value)) { return next; }
    let absent:Option<U> =None();
    return absent;
}

// Exactly one present value survives; two or none give None.
pub fn xor<T>(value: Option<T>, right: Option<T>) -> Option<T> {
    if (is_some(value)) {
        if (is_some(right)) {
            let absent: Option<T> = None();
            return absent;
        }
        return value;
    }
    return right;
}

// Some(Some(v)) gives Some(v); Some(None) and None give None.
pub fn flatten<T>(value: Option<Option<T>>) -> Option<T> {
    let absent: Option<T> = None();
    return match (value) { Some(inner) -> inner, None -> absent };
}

pub fn ok_or<T, E>(value: Option<T>, error: E) -> core::result::Result<T, E> {
    return match (value) {
        Some(inner) -> core::result::Ok(inner),
        None -> core::result::Err(error),
    };
}

// The success value of a result, or None for an error.
pub fn ok<T, E>(value: core::result::Result<T, E>) -> Option<T> {
    let absent: Option<T> = None();
    return match (value) { Ok(inner) -> Some(inner), Err(_) -> absent };
}

// The error of a result, or None for a success.
pub fn err<T, E>(value: core::result::Result<T, E>) -> Option<E> {
    let absent: Option<E> = None();
    return match (value) { Ok(_) -> absent, Err(error) -> Some(error) };
}

// Selected callbacks run once; skipped callbacks never run. Inputs and
// outputs remain shallow: account for discarded owners and deactivate older
// aliases after any explicit transfer into a transformation callback.
pub fn map<T,U,M>(value:Option<T>, mapper:&M) -> Option<U>
    where M:core::function::Mapper<T,U> {
    let absent:Option<U> = None();
    if (is_none(value)) { return absent; }
    let inner:T = unwrap(value); let mapped:U = mapper.apply(inner);
    return Some(mapped);
}

// fallback is evaluated before entry even when Some selects the mapper.
pub fn map_or<T,U,M>(value:Option<T>, fallback:U, mapper:&M) -> U
    where M:core::function::Mapper<T,U> {
    if (is_none(value)) { return fallback; }
    let inner:T = unwrap(value); return mapper.apply(inner);
}

pub fn map_or_else<T,U,D,M>(value:Option<T>, fallback:&D, mapper:&M) -> U
    where D:core::function::Producer<U>, M:core::function::Mapper<T,U> {
    if (is_none(value)) { return fallback.produce(); }
    let inner:T = unwrap(value); return mapper.apply(inner);
}

pub fn and_then<T,U,M>(value:Option<T>, mapper:&M) -> Option<U>
    where M:core::function::Mapper<T,Option<U>> {
    let absent:Option<U> = None();
    if (is_none(value)) { return absent; }
    let inner:T = unwrap(value); return mapper.apply(inner);
}

pub fn or_else<T,P>(value:Option<T>, fallback:&P) -> Option<T>
    where P:core::function::Producer<Option<T>> {
    if (is_some(value)) { return value; }
    return fallback.produce();
}

pub fn unwrap_or_else<T,P>(value:Option<T>, fallback:&P) -> T
    where P:core::function::Producer<T> {
    if (is_none(value)) { return fallback.produce(); }
    return unwrap(value);
}

pub fn ok_or_else<T,E,P>(value:Option<T>, fallback:&P) -> core::result::Result<T,E>
    where P:core::function::Producer<E> {
    if (is_none(value)) {
        let error:E = fallback.produce(); return core::result::Err(error);
    }
    let inner:T = unwrap(value); return core::result::Ok(inner);
}

// Predicates only observe call-scoped borrowed descriptors. They must not
// mutate or retire represented resources, or retain those descriptors beyond
// the callback. Independent scalar observations are allowed. A rejected filter
// value stays the caller's cleanup concern. These rules cover all three below.
pub fn filter<T,P>(value:Option<T>, predicate:&P) -> Option<T>
    where P:core::function::Mapper<T,bool> {
    if (is_some(value)) {
        let inner:T = unwrap(value);
        if (predicate.apply(inner)) { return value; }
    }
    let absent:Option<T> = None(); return absent;
}

pub fn is_some_and<T,P>(value:Option<T>, predicate:&P) -> bool
    where P:core::function::Mapper<T,bool> {
    if (is_none(value)) { return false; }
    let inner:T = unwrap(value); return predicate.apply(inner);
}

pub fn is_none_or<T,P>(value:Option<T>, predicate:&P) -> bool
    where P:core::function::Mapper<T,bool> {
    if (is_none(value)) { return true; }
    let inner:T = unwrap(value); return predicate.apply(inner);
}

pub impl<T> Option<T> {
    pub fn is_some(self) -> bool {
        return match (self) { Some(_) -> true, None -> false };
    }

    pub fn is_none(self) -> bool {
        return match (self) { Some(_) -> false, None -> true };
    }

    pub fn contains(self, expected: T) -> bool where T: core::cmp::PartialEq<T> {
        return match (self) { Some(inner) -> T::partial_eq(inner, expected), None -> false };
    }

    pub fn unwrap(self) -> T {
        return match (self) { Some(inner) -> inner, None -> core::panic::panic() };
    }

    pub fn unwrap_or(self, fallback: T) -> T {
        return match (self) { Some(inner) -> inner, None -> fallback };
    }

    pub fn or(self, fallback: Option<T>) -> Option<T> {
        let present: bool = match (self) { Some(_) -> true, None -> false };
        if (present) { return self; }
        return fallback;
    }

    pub fn and<U>(self, next: Option<U>) -> Option<U> {
        let absent: Option<U> = None();
        return match (self) { Some(_) -> next, None -> absent };
    }

    pub fn xor(self, right: Option<T>) -> Option<T> {
        let absent: Option<T> = None();
        let right_present: bool = match (right) { Some(_) -> true, None -> false };
        if (right_present) {
            let self_present: bool = match (self) { Some(_) -> true, None -> false };
            if (self_present) { return absent; }
            return right;
        }
        return self;
    }

    pub fn ok_or<E>(self, error: E) -> core::result::Result<T, E> {
        return match (self) {
            Some(inner) -> core::result::Ok(inner),
            None -> core::result::Err(error),
        };
    }

    pub fn map<U,M>(self, mapper:&M) -> Option<U> where M:core::function::Mapper<T,U> {
        return core::option::map<T,U,M>(self,mapper);
    }
    pub fn map_or<U,M>(self, fallback:U, mapper:&M) -> U where M:core::function::Mapper<T,U> {
        return core::option::map_or<T,U,M>(self,fallback,mapper);
    }
    pub fn map_or_else<U,D,M>(self, fallback:&D, mapper:&M) -> U
        where D:core::function::Producer<U>, M:core::function::Mapper<T,U> {
        return core::option::map_or_else<T,U,D,M>(self,fallback,mapper);
    }
    pub fn and_then<U,M>(self, mapper:&M) -> Option<U>
        where M:core::function::Mapper<T,Option<U>> {
        return core::option::and_then<T,U,M>(self,mapper);
    }
    pub fn or_else<P>(self, fallback:&P) -> Option<T> where P:core::function::Producer<Option<T>> {
        return core::option::or_else<T,P>(self,fallback);
    }
    pub fn unwrap_or_else<P>(self, fallback:&P) -> T where P:core::function::Producer<T> {
        return core::option::unwrap_or_else<T,P>(self,fallback);
    }
    pub fn ok_or_else<E,P>(self, fallback:&P) -> core::result::Result<T,E>
        where P:core::function::Producer<E> {
        return core::option::ok_or_else<T,E,P>(self,fallback);
    }
    pub fn filter<P>(self, predicate:&P) -> Option<T> where P:core::function::Mapper<T,bool> {
        return core::option::filter<T,P>(self,predicate);
    }
    pub fn is_some_and<P>(self, predicate:&P) -> bool where P:core::function::Mapper<T,bool> {
        return core::option::is_some_and<T,P>(self,predicate);
    }
    pub fn is_none_or<P>(self, predicate:&P) -> bool where P:core::function::Mapper<T,bool> {
        return core::option::is_none_or<T,P>(self,predicate);
    }
}

// Eager shape conversions select shallow payloads without allocation, clone,
// destruction or a second cleanup authority. Callers manage the lifetime and
// cleanup of owners in selected and discarded input copies.
pub fn transpose_to_result<T,E>(value:Option<core::result::Result<T,E>>)
    -> core::result::Result<Option<T>,E> {
    let absent:Option<T> =None();
    return match(value) {
        Some(inner)->transpose_result_inner<T,E>(inner),
        None->core::result::Ok(absent),
    };
}
fn transpose_result_inner<T,E>(value:core::result::Result<T,E>)
    -> core::result::Result<Option<T>,E> {
    return match(value) {
        core::result::Ok(inner)->transpose_result_present<T,E>(inner),
        core::result::Err(error)->core::result::Err(error),
    };
}
fn transpose_result_present<T,E>(value:T) -> core::result::Result<Option<T>,E> {
    let present:Option<T> =Some(value);
    return core::result::Ok(present);
}

pub fn transpose_to_option<T,E>(value:core::result::Result<Option<T>,E>)
    -> Option<core::result::Result<T,E>> {
    return match(value) {
        core::result::Ok(inner)->transpose_option_inner<T,E>(inner),
        core::result::Err(error)->transpose_option_error<T,E>(error),
    };
}
fn transpose_option_inner<T,E>(value:Option<T>) -> Option<core::result::Result<T,E>> {
    let absent:Option<core::result::Result<T,E>> =None();
    return match(value) { Some(inner)->transpose_option_present<T,E>(inner), None->absent };
}
fn transpose_option_present<T,E>(value:T) -> Option<core::result::Result<T,E>> {
    let successful:core::result::Result<T,E> =core::result::Ok(value);
    return Some(successful);
}
fn transpose_option_error<T,E>(error:E) -> Option<core::result::Result<T,E>> {
    let failed:core::result::Result<T,E> =core::result::Err(error);
    return Some(failed);
}

pub impl<T> Option<Option<T>> {
    pub fn flatten(self) -> Option<T> { return core::option::flatten<T>(self); }
}
pub impl<T,E> Option<core::result::Result<T,E>> {
    pub fn transpose(self) -> core::result::Result<Option<T>,E> {
        return core::option::transpose_to_result<T,E>(self);
    }
}
// Keep both conversion receivers here so Result need not import Option and
// create a two-module cycle. Import core::option to include this extension.
pub impl<T,E> core::result::Result<Option<T>,E> {
    pub fn transpose(self) -> Option<core::result::Result<T,E>> {
        return core::option::transpose_to_option<T,E>(self);
    }
}
