// Allocation-free operations on caller-backed word views. Every len must be
// no greater than the physical view length. Native indexing traps if the
// caller overstates it. A negative logical length is rejected or empty as
// described for each operation.
module core::slice_u32;

// Native indexing traps on an empty physical view.
pub fn first(values: [u32]) -> u32 {
    return values[0];
}

pub fn first_or(values: [u32], len: i32, fallback: u32) -> u32 {
    return get_or(values, len, 0, fallback);
}

pub fn get_or(values: [u32], len: i32, index: i32, fallback: u32) -> u32 {
    if (len <= 0 || index < 0 || index >= len) {
        return fallback;
    }
    return values[index];
}

// Invalid logical bounds leave the view unchanged.
pub fn set(values: [u32], len: i32, index: i32, value: u32) -> bool {
    if (len <= 0 || index < 0 || index >= len) {
        return false;
    }
    values[index] = value;
    return true;
}

pub fn swap(values: [u32], len: i32, left: i32, right: i32) -> bool {
    if (left < 0 || right < 0 || left >= len || right >= len) {
        return false;
    }
    let previous: u32 = values[left];
    values[left] = values[right];
    values[right] = previous;
    return true;
}

// A nonpositive length writes nothing and returns zero.
pub fn fill(values: [u32], len: i32, value: u32) -> i32 {
    let index: i32 = 0;
    while (index < len) {
        values[index] = value;
        index += 1;
    }
    return index;
}

// Overlap is supported. Invalid logical bounds write nothing.
pub fn copy_within(values: [u32], len: i32, start: i32, end: i32, destination: i32) -> bool {
    if (len < 0 || start < 0 || end < start || end > len || destination < 0) {
        return false;
    }
    let count: i32 = end - start;
    if (destination > len - count) {
        return false;
    }
    if (destination > start) {
        let remaining: i32 = count;
        while (remaining > 0) {
            remaining -= 1;
            values[destination + remaining] = values[start + remaining];
        }
    } else {
        let offset: i32 = 0;
        while (offset < count) {
            values[destination + offset] = values[start + offset];
            offset += 1;
        }
    }
    return true;
}

// A nonpositive length is empty. Missing values return fallback.
pub fn index_of_or(values: [u32], len: i32, needle: u32, fallback: i32) -> i32 {
    let index: i32 = 0;
    while (index < len) {
        if (values[index] == needle) {
            return index;
        }
        index += 1;
    }
    return fallback;
}

pub fn last_index_of_or(values: [u32], len: i32, needle: u32, fallback: i32) -> i32 {
    let index: i32 = len;
    while (index > 0) {
        index -= 1;
        if (values[index] == needle) {
            return index;
        }
    }
    return fallback;
}

// A negative length is invalid. Two empty views compare equal.
pub fn equals(left: [u32], left_len: i32, right: [u32], right_len: i32) -> bool {
    if (left_len < 0 || right_len < 0 || left_len != right_len) {
        return false;
    }
    let index: i32 = 0;
    while (index < left_len) {
        if (left[index] != right[index]) {
            return false;
        }
        index += 1;
    }
    return true;
}

// A negative length is invalid; an empty prefix matches every valid view.
pub fn starts_with(values: [u32], len: i32, prefix: [u32], prefix_len: i32) -> bool {
    if (len < 0 || prefix_len < 0 || prefix_len > len) {
        return false;
    }
    let index: i32 = 0;
    while (index < prefix_len) {
        if (values[index] != prefix[index]) {
            return false;
        }
        index += 1;
    }
    return true;
}

pub fn ends_with(values: [u32], len: i32, suffix: [u32], suffix_len: i32) -> bool {
    if (len < 0 || suffix_len < 0 || suffix_len > len) {
        return false;
    }
    let index: i32 = 0;
    let offset: i32 = len - suffix_len;
    while (index < suffix_len) {
        if (values[offset + index] != suffix[index]) {
            return false;
        }
        index += 1;
    }
    return true;
}

// Returns the number of swaps. A nonpositive length writes nothing.
pub fn reverse_in_place(values: [u32], len: i32) -> i32 {
    if (len <= 1) {
        return 0;
    }
    let left: i32 = 0;
    let right: i32 = len - 1;
    let swaps: i32 = 0;
    while (left < right) {
        let previous: u32 = values[left];
        values[left] = values[right];
        values[right] = previous;
        left += 1;
        right -= 1;
        swaps += 1;
    }
    return swaps;
}

fn reverse_segment(values: [u32], start: i32, end: i32) {
    let left: i32 = start;
    let right: i32 = end - 1;
    while (left < right) {
        let previous: u32 = values[left];
        values[left] = values[right];
        values[right] = previous;
        left += 1;
        right -= 1;
    }
}

// Amount must be in [0, len]. Invalid bounds write nothing.
pub fn rotate_left(values: [u32], len: i32, amount: i32) -> bool {
    if (len < 0 || amount < 0 || amount > len) {
        return false;
    }
    if (amount == 0 || amount == len) {
        return true;
    }
    reverse_segment(values, 0, amount);
    reverse_segment(values, amount, len);
    reverse_segment(values, 0, len);
    return true;
}

pub fn rotate_right(values: [u32], len: i32, amount: i32) -> bool {
    if (len < 0 || amount < 0 || amount > len) {
        return false;
    }
    return rotate_left(values, len, len - amount);
}

// The source and destination must not overlap in memory.
pub fn copy_nonoverlapping_prefix(destination: [u32], destination_len: i32, source: [u32], source_len: i32) -> bool {
    if (destination_len < 0 || source_len < 0 || source_len > destination_len) {
        return false;
    }
    let index: i32 = 0;
    while (index < source_len) {
        destination[index] = source[index];
        index += 1;
    }
    return true;
}

// Returns the new logical length. The tail is unspecified.
pub fn dedup_adjacent(values: [u32], len: i32) -> i32 {
    if (len <= 0) {
        return 0;
    }
    let write: i32 = 1;
    let read: i32 = 1;
    while (read < len) {
        let current: u32 = values[read];
        if (current != values[write - 1]) {
            values[write] = current;
            write += 1;
        }
        read += 1;
    }
    return write;
}

// Retains order and returns the new length. The tail is unspecified.
pub fn retain_not_equal(values: [u32], len: i32, needle: u32) -> i32 {
    let read: i32 = 0;
    let write: i32 = 0;
    while (read < len) {
        let current: u32 = values[read];
        if (current != needle) {
            values[write] = current;
            write += 1;
        }
        read += 1;
    }
    return write;
}

// Valid removal shifts the suffix left; the old last element leaves the view.
pub fn remove_at(values: [u32], len: i32, index: i32) -> bool {
    if (index < 0 || index >= len) {
        return false;
    }
    let read: i32 = index + 1;
    while (read < len) {
        values[read - 1] = values[read];
        read += 1;
    }
    return true;
}

// Capacity must not exceed the writable physical view. Success grows the
// caller's logical length by one; invalid logical bounds write nothing.
pub fn insert(values: [u32], len: i32, capacity: i32, index: i32, value: u32) -> bool {
    if (len < 0 || capacity <= 0 || len >= capacity || index < 0 || index > len) {
        return false;
    }
    let cursor: i32 = len;
    while (cursor > index) {
        values[cursor] = values[cursor - 1];
        cursor -= 1;
    }
    values[index] = value;
    return true;
}

pub fn push(values: [u32], len: i32, capacity: i32, value: u32) -> bool {
    return insert(values, len, capacity, len, value);
}

// Returns -1, 0, or 1. Negative lengths are invalid and return -2.
pub fn compare_lexicographic(left: [u32], left_len: i32, right: [u32], right_len: i32) -> i32 {
    if (left_len < 0 || right_len < 0) {
        return -2;
    }
    let common: i32 = left_len;
    if (right_len < common) {
        common = right_len;
    }
    let index: i32 = 0;
    while (index < common) {
        if (left[index] < right[index]) { return -1; }
        if (left[index] > right[index]) { return 1; }
        index += 1;
    }
    if (left_len < right_len) { return -1; }
    if (left_len > right_len) { return 1; }
    return 0;
}

// An empty needle matches at zero; negative lengths are invalid.
pub fn index_of_subslice(values: [u32], len: i32, needle: [u32], needle_len: i32) -> i32 {
    if (len < 0 || needle_len < 0 || needle_len > len) {
        return -1;
    }
    let last_start: i32 = len - needle_len;
    let start: i32 = 0;
    while (start <= last_start) {
        let offset: i32 = 0;
        while (offset < needle_len) {
            if (values[start + offset] != needle[offset]) { break; }
            offset += 1;
        }
        if (offset == needle_len) { return start; }
        start += 1;
    }
    return -1;
}

// The last match of an empty needle is at len.
pub fn last_index_of_subslice(values: [u32], len: i32, needle: [u32], needle_len: i32) -> i32 {
    if (len < 0 || needle_len < 0 || needle_len > len) {
        return -1;
    }
    let start: i32 = len - needle_len;
    while (start >= 0) {
        let offset: i32 = 0;
        while (offset < needle_len) {
            if (values[start + offset] != needle[offset]) { break; }
            offset += 1;
        }
        if (offset == needle_len) { return start; }
        start -= 1;
    }
    return -1;
}

pub fn contains(values: [u32], len: i32, needle: u32) -> bool {
    return index_of_or(values, len, needle, -1) != -1;
}

pub fn count(values: [u32], len: i32, needle: u32) -> i32 {
    let total: i32 = 0;
    let index: i32 = 0;
    while (index < len) {
        if (values[index] == needle) { total += 1; }
        index += 1;
    }
    return total;
}

pub fn min_or(values: [u32], len: i32, fallback: u32) -> u32 {
    if (len <= 0) { return fallback; }
    let result: u32 = values[0];
    let index: i32 = 1;
    while (index < len) {
        if (values[index] < result) { result = values[index]; }
        index += 1;
    }
    return result;
}

pub fn max_or(values: [u32], len: i32, fallback: u32) -> u32 {
    if (len <= 0) { return fallback; }
    let result: u32 = values[0];
    let index: i32 = 1;
    while (index < len) {
        if (values[index] > result) { result = values[index]; }
        index += 1;
    }
    return result;
}

pub fn is_sorted(values: [u32], len: i32) -> bool {
    let index: i32 = 1;
    while (index < len) {
        if (values[index - 1] > values[index]) { return false; }
        index += 1;
    }
    return true;
}

fn sift_down_max(values: [u32], heap_len: i32, start: i32) {
    if (heap_len > 1) {
        let root: i32 = start;
        while (root <= (heap_len - 2) / 2) {
            let child: i32 = root * 2 + 1;
            let largest: i32 = root;
            if (values[largest] < values[child]) { largest = child; }
            if (child + 1 < heap_len && values[largest] < values[child + 1]) {
                largest = child + 1;
            }
            if (largest == root) { break; }
            let previous: u32 = values[root];
            values[root] = values[largest];
            values[largest] = previous;
            root = largest;
        }
    }
}

// In-place ascending heapsort. A nonpositive length writes nothing.
pub fn sort(values: [u32], len: i32) -> i32 {
    if (len <= 0) { return 0; }
    if (len == 1) { return 1; }
    let start: i32 = (len - 2) / 2;
    while (start >= 0) {
        sift_down_max(values, len, start);
        if (start == 0) { break; }
        start -= 1;
    }
    let remaining: i32 = len;
    while (remaining > 1) {
        remaining -= 1;
        let previous: u32 = values[0];
        values[0] = values[remaining];
        values[remaining] = previous;
        sift_down_max(values, remaining, 0);
    }
    return len;
}

// Binary search helpers require nondecreasing input.
pub fn lower_bound(values: [u32], len: i32, needle: u32) -> i32 {
    if (len <= 0) { return 0; }
    let low: i32 = 0;
    let high: i32 = len;
    while (low < high) {
        let middle: i32 = low + (high - low) / 2;
        if (values[middle] < needle) { low = middle + 1; }
        else { high = middle; }
    }
    return low;
}

pub fn upper_bound(values: [u32], len: i32, needle: u32) -> i32 {
    if (len <= 0) { return 0; }
    let low: i32 = 0;
    let high: i32 = len;
    while (low < high) {
        let middle: i32 = low + (high - low) / 2;
        if (values[middle] <= needle) { low = middle + 1; }
        else { high = middle; }
    }
    return low;
}

pub fn binary_search_first_or(values: [u32], len: i32, needle: u32, fallback: i32) -> i32 {
    if (len <= 0) { return fallback; }
    let index: i32 = lower_bound(values, len, needle);
    if (index < len && values[index] == needle) { return index; }
    return fallback;
}

pub fn binary_search_last_or(values: [u32], len: i32, needle: u32, fallback: i32) -> i32 {
    if (len <= 0) { return fallback; }
    let after: i32 = upper_bound(values, len, needle);
    if (after > 0 && values[after - 1] == needle) { return after - 1; }
    return fallback;
}

// Partitions the view around pivot without preserving relative order.
pub fn partition_lt(values: [u32], len: i32, pivot: u32) -> i32 {
    let boundary: i32 = 0;
    let index: i32 = 0;
    while (index < len) {
        if (values[index] < pivot) {
            let previous: u32 = values[boundary];
            values[boundary] = values[index];
            values[index] = previous;
            boundary += 1;
        }
        index += 1;
    }
    return boundary;
}

// Saturates at 4294967295 instead of overflowing the word accumulator.
pub fn sum(values: [u32], len: i32) -> u32 {
    let total: u32 = 0;
    let index: i32 = 0;
    while (index < len) {
        let next: u32 = values[index];
        if (total > 4294967295 - next) { return 4294967295; }
        total += next;
        index += 1;
    }
    return total;
}
