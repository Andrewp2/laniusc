// Pointer-width isize arithmetic for the verified x86_64 Linux target only.
// This target has 64-bit pointers and native integer values. Each typed boundary
// preserves the canonical core::i64 operation and checked failure behavior.
// These are numeric values, not allocation lengths or pointer validity checks.
module core::isize;
import core::i64;
import core::option;
pub const MIN: isize = -9223372036854775808;
pub const MAX: isize = 9223372036854775807;
pub const BITS: u32 = 64;
pub const BYTES: u32 = 8;
pub fn min(left: isize, right: isize) -> isize { return core::i64::min(left as i64,right as i64) as isize; }
pub fn max(left: isize, right: isize) -> isize { return core::i64::max(left as i64,right as i64) as isize; }
pub fn checked_clamp(value: isize, low: isize, high: isize) -> core::option::Option<isize> { let result: core::option::Option<i64> = core::i64::checked_clamp(value as i64,low as i64,high as i64); if (core::option::is_none(result)) { return core::option::None(); } return core::option::Some(core::option::unwrap(result) as isize); }
pub fn clamp(value: isize, low: isize, high: isize) -> isize { return core::i64::clamp(value as i64,low as i64,high as i64) as isize; }
pub fn clamp_or(value: isize, low: isize, high: isize, fallback: isize) -> isize { return core::i64::clamp_or(value as i64,low as i64,high as i64,fallback as i64) as isize; }
pub fn is_zero(value: isize) -> bool { return core::i64::is_zero(value as i64); }
pub fn is_nonzero(value: isize) -> bool { return core::i64::is_nonzero(value as i64); }
pub fn is_even(value: isize) -> bool { return core::i64::is_even(value as i64); }
pub fn is_odd(value: isize) -> bool { return core::i64::is_odd(value as i64); }
pub fn between_inclusive(value: isize, low: isize, high: isize) -> bool { return core::i64::between_inclusive(value as i64,low as i64,high as i64); }
pub fn between_exclusive(value: isize, low: isize, high: isize) -> bool { return core::i64::between_exclusive(value as i64,low as i64,high as i64); }
pub fn is_multiple_of(value: isize, divisor: isize) -> bool { return core::i64::is_multiple_of(value as i64,divisor as i64); }
pub fn wrapping_add(left: isize, right: isize) -> isize { return core::i64::wrapping_add(left as i64,right as i64) as isize; }
pub fn wrapping_sub(left: isize, right: isize) -> isize { return core::i64::wrapping_sub(left as i64,right as i64) as isize; }
pub fn wrapping_mul(left: isize, right: isize) -> isize { return core::i64::wrapping_mul(left as i64,right as i64) as isize; }
pub fn checked_add(left: isize, right: isize) -> core::option::Option<isize> { let result: core::option::Option<i64> = core::i64::checked_add(left as i64,right as i64); if (core::option::is_none(result)) { return core::option::None(); } return core::option::Some(core::option::unwrap(result) as isize); }
pub fn saturating_add(left: isize, right: isize) -> isize { return core::i64::saturating_add(left as i64,right as i64) as isize; }
pub fn checked_sub(left: isize, right: isize) -> core::option::Option<isize> { let result: core::option::Option<i64> = core::i64::checked_sub(left as i64,right as i64); if (core::option::is_none(result)) { return core::option::None(); } return core::option::Some(core::option::unwrap(result) as isize); }
pub fn saturating_sub(left: isize, right: isize) -> isize { return core::i64::saturating_sub(left as i64,right as i64) as isize; }
pub fn checked_mul(left: isize, right: isize) -> core::option::Option<isize> { let result: core::option::Option<i64> = core::i64::checked_mul(left as i64,right as i64); if (core::option::is_none(result)) { return core::option::None(); } return core::option::Some(core::option::unwrap(result) as isize); }
pub fn saturating_mul(left: isize, right: isize) -> isize { return core::i64::saturating_mul(left as i64,right as i64) as isize; }
pub fn checked_neg(value: isize) -> core::option::Option<isize> { let result: core::option::Option<i64> = core::i64::checked_neg(value as i64); if (core::option::is_none(result)) { return core::option::None(); } return core::option::Some(core::option::unwrap(result) as isize); }
pub fn wrapping_neg(value: isize) -> isize { return core::i64::wrapping_neg(value as i64) as isize; }
pub fn saturating_neg(value: isize) -> isize { return core::i64::saturating_neg(value as i64) as isize; }
pub fn checked_abs(value: isize) -> core::option::Option<isize> { let result: core::option::Option<i64> = core::i64::checked_abs(value as i64); if (core::option::is_none(result)) { return core::option::None(); } return core::option::Some(core::option::unwrap(result) as isize); }
pub fn abs(value: isize) -> isize { return core::i64::abs(value as i64) as isize; }
pub fn wrapping_abs(value: isize) -> isize { return core::i64::wrapping_abs(value as i64) as isize; }
pub fn saturating_abs(value: isize) -> isize { return core::i64::saturating_abs(value as i64) as isize; }
pub fn unsigned_abs(value: isize) -> usize { return core::i64::unsigned_abs(value as i64) as usize; }
pub fn abs_diff(left: isize, right: isize) -> usize { return core::i64::abs_diff(left as i64,right as i64) as usize; }
pub fn saturating_abs_diff(left: isize, right: isize) -> isize { return core::i64::saturating_abs_diff(left as i64,right as i64) as isize; }
pub fn signum(value: isize) -> isize { return core::i64::signum(value as i64) as isize; }
pub fn is_negative(value: isize) -> bool { return core::i64::is_negative(value as i64); }
pub fn is_positive(value: isize) -> bool { return core::i64::is_positive(value as i64); }
pub fn checked_div(left: isize, right: isize) -> core::option::Option<isize> { let result: core::option::Option<i64> = core::i64::checked_div(left as i64,right as i64); if (core::option::is_none(result)) { return core::option::None(); } return core::option::Some(core::option::unwrap(result) as isize); }
pub fn div(left: isize, right: isize) -> isize { return core::i64::div(left as i64,right as i64) as isize; }
pub fn wrapping_div(left: isize, right: isize) -> isize { return core::i64::wrapping_div(left as i64,right as i64) as isize; }
pub fn checked_rem(left: isize, right: isize) -> core::option::Option<isize> { let result: core::option::Option<i64> = core::i64::checked_rem(left as i64,right as i64); if (core::option::is_none(result)) { return core::option::None(); } return core::option::Some(core::option::unwrap(result) as isize); }
pub fn rem(left: isize, right: isize) -> isize { return core::i64::rem(left as i64,right as i64) as isize; }
pub fn wrapping_rem(left: isize, right: isize) -> isize { return core::i64::wrapping_rem(left as i64,right as i64) as isize; }
pub fn saturating_div(left: isize, right: isize) -> isize { return core::i64::saturating_div(left as i64,right as i64) as isize; }
pub fn div_euclid(left: isize, right: isize) -> isize { return core::i64::div_euclid(left as i64,right as i64) as isize; }
pub fn checked_div_euclid(left: isize, right: isize) -> core::option::Option<isize> { let result: core::option::Option<i64> = core::i64::checked_div_euclid(left as i64,right as i64); if (core::option::is_none(result)) { return core::option::None(); } return core::option::Some(core::option::unwrap(result) as isize); }
pub fn rem_euclid(left: isize, right: isize) -> isize { return core::i64::rem_euclid(left as i64,right as i64) as isize; }
pub fn checked_rem_euclid(left: isize, right: isize) -> core::option::Option<isize> { let result: core::option::Option<i64> = core::i64::checked_rem_euclid(left as i64,right as i64); if (core::option::is_none(result)) { return core::option::None(); } return core::option::Some(core::option::unwrap(result) as isize); }
pub fn checked_shl(value: isize, amount: u32) -> core::option::Option<isize> { let result: core::option::Option<i64> = core::i64::checked_shl(value as i64,amount); if (core::option::is_none(result)) { return core::option::None(); } return core::option::Some(core::option::unwrap(result) as isize); }
pub fn wrapping_shl(value: isize, amount: u32) -> isize { return core::i64::wrapping_shl(value as i64,amount) as isize; }
pub fn shl(value: isize, amount: u32) -> isize { return core::i64::shl(value as i64,amount) as isize; }
pub fn checked_shr(value: isize, amount: u32) -> core::option::Option<isize> { let result: core::option::Option<i64> = core::i64::checked_shr(value as i64,amount); if (core::option::is_none(result)) { return core::option::None(); } return core::option::Some(core::option::unwrap(result) as isize); }
pub fn wrapping_shr(value: isize, amount: u32) -> isize { return core::i64::wrapping_shr(value as i64,amount) as isize; }
pub fn shr(value: isize, amount: u32) -> isize { return core::i64::shr(value as i64,amount) as isize; }
pub fn checked_pow(base: isize, exponent: u32) -> core::option::Option<isize> { let result: core::option::Option<i64> = core::i64::checked_pow(base as i64,exponent); if (core::option::is_none(result)) { return core::option::None(); } return core::option::Some(core::option::unwrap(result) as isize); }
pub fn wrapping_pow(base: isize, exponent: u32) -> isize { return core::i64::wrapping_pow(base as i64,exponent) as isize; }
pub fn saturating_pow(base: isize, exponent: u32) -> isize { return core::i64::saturating_pow(base as i64,exponent) as isize; }
pub fn count_ones(value: isize) -> u32 { return core::i64::count_ones(value as i64); }
pub fn count_zeros(value: isize) -> u32 { return core::i64::count_zeros(value as i64); }
pub fn leading_zeros(value: isize) -> u32 { return core::i64::leading_zeros(value as i64); }
pub fn trailing_zeros(value: isize) -> u32 { return core::i64::trailing_zeros(value as i64); }
pub fn leading_ones(value: isize) -> u32 { return core::i64::leading_ones(value as i64); }
pub fn trailing_ones(value: isize) -> u32 { return core::i64::trailing_ones(value as i64); }
pub fn rotate_left(value: isize, amount: u32) -> isize { return core::i64::rotate_left(value as i64,amount) as isize; }
pub fn rotate_right(value: isize, amount: u32) -> isize { return core::i64::rotate_right(value as i64,amount) as isize; }
pub fn reverse_bits(value: isize) -> isize { return core::i64::reverse_bits(value as i64) as isize; }
pub fn swap_bytes(value: isize) -> isize { return core::i64::swap_bytes(value as i64) as isize; }
pub fn is_power_of_two(value: isize) -> bool { return core::i64::is_power_of_two(value as i64); }
pub fn checked_next_power_of_two(value: isize) -> core::option::Option<isize> { let result: core::option::Option<i64> = core::i64::checked_next_power_of_two(value as i64); if (core::option::is_none(result)) { return core::option::None(); } return core::option::Some(core::option::unwrap(result) as isize); }
pub fn next_power_of_two(value: isize) -> isize { return core::i64::next_power_of_two(value as i64) as isize; }

// Integer conversions: checked means numeric range, wrapping keeps low bits.
pub fn from_i8(value: i8) -> isize { return value as isize; }
pub fn from_u8(value: u8) -> isize { return value as isize; }
pub fn from_i16(value: i16) -> isize { return value as isize; }
pub fn from_u16(value: u16) -> isize { return value as isize; }
pub fn from_i32(value: i32) -> isize { return value as isize; }
pub fn from_u32(value: u32) -> isize { return value as isize; }
pub fn checked_from_i8(value: i8) -> core::option::Option<isize> { return core::option::Some(value as isize); }
pub fn saturating_from_i8(value: i8) -> isize { return value as isize; }
pub fn wrapping_from_i8(value: i8) -> isize { return value as isize; }
pub fn checked_from_u8(value: u8) -> core::option::Option<isize> { return core::option::Some(value as isize); }
pub fn saturating_from_u8(value: u8) -> isize { return value as isize; }
pub fn wrapping_from_u8(value: u8) -> isize { return value as isize; }
pub fn checked_from_i16(value: i16) -> core::option::Option<isize> { return core::option::Some(value as isize); }
pub fn saturating_from_i16(value: i16) -> isize { return value as isize; }
pub fn wrapping_from_i16(value: i16) -> isize { return value as isize; }
pub fn checked_from_u16(value: u16) -> core::option::Option<isize> { return core::option::Some(value as isize); }
pub fn saturating_from_u16(value: u16) -> isize { return value as isize; }
pub fn wrapping_from_u16(value: u16) -> isize { return value as isize; }
pub fn checked_from_i32(value: i32) -> core::option::Option<isize> { return core::option::Some(value as isize); }
pub fn saturating_from_i32(value: i32) -> isize { return value as isize; }
pub fn wrapping_from_i32(value: i32) -> isize { return value as isize; }
pub fn checked_from_u32(value: u32) -> core::option::Option<isize> { return core::option::Some(value as isize); }
pub fn saturating_from_u32(value: u32) -> isize { return value as isize; }
pub fn wrapping_from_u32(value: u32) -> isize { return value as isize; }
pub fn checked_from_i64(value: i64) -> core::option::Option<isize> { return core::option::Some(value as isize); }
pub fn saturating_from_i64(value: i64) -> isize { return value as isize; }
pub fn wrapping_from_i64(value: i64) -> isize { return value as isize; }
pub fn checked_from_u64(value: u64) -> core::option::Option<isize> { if (value > 9223372036854775807) { return core::option::None(); } return core::option::Some(value as isize); }
pub fn saturating_from_u64(value: u64) -> isize { if (value > 9223372036854775807) { return MAX; } return value as isize; }
pub fn wrapping_from_u64(value: u64) -> isize { return value as isize; }
pub fn checked_from_isize(value: isize) -> core::option::Option<isize> { return core::option::Some(value as isize); }
pub fn saturating_from_isize(value: isize) -> isize { return value as isize; }
pub fn wrapping_from_isize(value: isize) -> isize { return value as isize; }
pub fn checked_from_usize(value: usize) -> core::option::Option<isize> { if (value > 9223372036854775807) { return core::option::None(); } return core::option::Some(value as isize); }
pub fn saturating_from_usize(value: usize) -> isize { if (value > 9223372036854775807) { return MAX; } return value as isize; }
pub fn wrapping_from_usize(value: usize) -> isize { return value as isize; }
pub fn checked_to_i8(value: isize) -> core::option::Option<i8> { if (value < -128 || value > 127) { return core::option::None(); } return core::option::Some(value as i8); }
pub fn saturating_to_i8(value: isize) -> i8 { if (value < -128) { return -128; } if (value > 127) { return 127; } return value as i8; }
pub fn wrapping_to_i8(value: isize) -> i8 { return value as i8; }
pub fn checked_to_u8(value: isize) -> core::option::Option<u8> { if (value < 0 || value > 255) { return core::option::None(); } return core::option::Some(value as u8); }
pub fn saturating_to_u8(value: isize) -> u8 { if (value < 0) { return 0; } if (value > 255) { return 255; } return value as u8; }
pub fn wrapping_to_u8(value: isize) -> u8 { return value as u8; }
pub fn checked_to_i16(value: isize) -> core::option::Option<i16> { if (value < -32768 || value > 32767) { return core::option::None(); } return core::option::Some(value as i16); }
pub fn saturating_to_i16(value: isize) -> i16 { if (value < -32768) { return -32768; } if (value > 32767) { return 32767; } return value as i16; }
pub fn wrapping_to_i16(value: isize) -> i16 { return value as i16; }
pub fn checked_to_u16(value: isize) -> core::option::Option<u16> { if (value < 0 || value > 65535) { return core::option::None(); } return core::option::Some(value as u16); }
pub fn saturating_to_u16(value: isize) -> u16 { if (value < 0) { return 0; } if (value > 65535) { return 65535; } return value as u16; }
pub fn wrapping_to_u16(value: isize) -> u16 { return value as u16; }
pub fn checked_to_i32(value: isize) -> core::option::Option<i32> { if (value < -2147483648 || value > 2147483647) { return core::option::None(); } return core::option::Some(value as i32); }
pub fn saturating_to_i32(value: isize) -> i32 { if (value < -2147483648) { return -2147483648; } if (value > 2147483647) { return 2147483647; } return value as i32; }
pub fn wrapping_to_i32(value: isize) -> i32 { return value as i32; }
pub fn checked_to_u32(value: isize) -> core::option::Option<u32> { if (value < 0 || value > 4294967295) { return core::option::None(); } return core::option::Some(value as u32); }
pub fn saturating_to_u32(value: isize) -> u32 { if (value < 0) { return 0; } if (value > 4294967295) { return 4294967295; } return value as u32; }
pub fn wrapping_to_u32(value: isize) -> u32 { return value as u32; }
pub fn checked_to_i64(value: isize) -> core::option::Option<i64> { return core::option::Some(value as i64); }
pub fn saturating_to_i64(value: isize) -> i64 { return value as i64; }
pub fn wrapping_to_i64(value: isize) -> i64 { return value as i64; }
pub fn checked_to_u64(value: isize) -> core::option::Option<u64> { if (value < 0) { return core::option::None(); } return core::option::Some(value as u64); }
pub fn saturating_to_u64(value: isize) -> u64 { if (value < 0) { return 0; } return value as u64; }
pub fn wrapping_to_u64(value: isize) -> u64 { return value as u64; }
pub fn checked_to_isize(value: isize) -> core::option::Option<isize> { return core::option::Some(value as isize); }
pub fn saturating_to_isize(value: isize) -> isize { return value as isize; }
pub fn wrapping_to_isize(value: isize) -> isize { return value as isize; }
pub fn checked_to_usize(value: isize) -> core::option::Option<usize> { if (value < 0) { return core::option::None(); } return core::option::Some(value as usize); }
pub fn saturating_to_usize(value: isize) -> usize { if (value < 0) { return 0; } return value as usize; }
pub fn wrapping_to_usize(value: isize) -> usize { return value as usize; }
