// A concrete optional u32 until generic enum values execute natively.
// `value` is zero for None and must be read only when `present` is true.
module core::option_u32;
import core::result_u32;

pub struct OptionU32 {
    present: bool,
    value: u32,
}

pub fn some(value: u32) -> OptionU32 {
    return OptionU32 { present: true, value: value };
}

pub fn none() -> OptionU32 {
    return OptionU32 { present: false, value: 0 };
}

pub fn is_some(value: OptionU32) -> bool {
    return value.present;
}

pub fn is_none(value: OptionU32) -> bool {
    return !value.present;
}

pub fn contains(value: OptionU32, expected: u32) -> bool {
    return value.present && value.value == expected;
}

pub fn unwrap_or(value: OptionU32, fallback: u32) -> u32 {
    if (value.present) { return value.value; }
    return fallback;
}

pub fn or(value: OptionU32, fallback: OptionU32) -> OptionU32 {
    if (value.present) { return value; }
    return fallback;
}

pub fn and(value: OptionU32, next: OptionU32) -> OptionU32 {
    if (value.present) { return next; }
    return value;
}

pub fn xor(left: OptionU32, right: OptionU32) -> OptionU32 {
    if (left.present) {
        if (right.present) { return none(); }
        return left;
    }
    return right;
}

pub fn ok_or(value: OptionU32, error: u32) -> core::result_u32::ResultU32 {
    if (value.present) { return core::result_u32::ok(value.value); }
    return core::result_u32::err(error);
}

pub fn ok(value: core::result_u32::ResultU32) -> OptionU32 {
    if (core::result_u32::is_ok(value)) {
        return some(core::result_u32::unwrap_or(value, 0));
    }
    return none();
}

pub fn err(value: core::result_u32::ResultU32) -> OptionU32 {
    if (core::result_u32::is_err(value)) {
        return some(core::result_u32::unwrap_err_or(value, 0));
    }
    return none();
}

pub impl OptionU32 {
    pub fn is_some(&self) -> bool { return self.present; }
    pub fn is_none(&self) -> bool { return !self.present; }
    pub fn contains(&self, expected: u32) -> bool {
        return self.present && self.value == expected;
    }
    pub fn unwrap_or(&self, fallback: u32) -> u32 {
        if (self.present) { return self.value; }
        return fallback;
    }
    pub fn or(&self, fallback: OptionU32) -> OptionU32 {
        if (self.present) { return OptionU32 { present: true, value: self.value }; }
        return fallback;
    }
    pub fn and(&self, next: OptionU32) -> OptionU32 {
        if (self.present) { return next; }
        return none();
    }
    pub fn xor(&self, right: OptionU32) -> OptionU32 {
        if (self.present) {
            if (right.present) { return none(); }
            return OptionU32 { present: true, value: self.value };
        }
        return right;
    }
    pub fn ok_or(&self, error: u32) -> core::result_u32::ResultU32 {
        if (self.present) { return core::result_u32::ok(self.value); }
        return core::result_u32::err(error);
    }
}
