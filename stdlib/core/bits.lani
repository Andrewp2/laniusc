// Allocation-free operations on the 32-bit representation of a u32.
module core::bits;
fn widen_byte(value: u8) -> u32 {
    return value as u32;
}
fn narrow_byte(value: u32) -> u8 {
    return value as u8;
}
fn widen_half(value: u16) -> u32 {
    return value as u32;
}
fn narrow_half(value: u32) -> u16 {
    return value as u16;
}
pub fn count_ones_u32(value: u32) -> u32 {
    let remaining: u32 = value;
    let count: u32 = 0;
    while (remaining != 0) {
        count += remaining&1;
        remaining >>= 1;
    }
    return count;
}
pub fn count_zeros_u32(value: u32) -> u32 {
    return 32 - count_ones_u32(value);
}
// Zero has 32 leading zero bits.
pub fn leading_zeros_u32(value: u32) -> u32 {
    let remaining: u32 = value;
    let length: u32 = 0;
    while (remaining != 0) {
        length += 1;
        remaining >>= 1;
    }
    return 32 - length;
}
// Zero has 32 trailing zero bits.
pub fn trailing_zeros_u32(value: u32) -> u32 {
    if (value == 0) {
        return 32;
    }
    let remaining: u32 = value;
    let count: u32 = 0;
    while ((remaining&1) == 0) {
        count += 1;
        remaining >>= 1;
    }
    return count;
}
pub fn has_single_bit_u32(value: u32) -> bool {
    return value != 0 &&(value&(value - 1)) == 0;
}
// The shift amount is reduced modulo 32. The zero case avoids a shift by 32.
pub fn rotate_left_u32(value: u32, amount: u32) -> u32 {
    let shift: u32 = amount % 32;
    if (shift == 0) {
        return value;
    }
    return(value << shift)|(value >>(32 - shift));
}
pub fn rotate_right_u32(value: u32, amount: u32) -> u32 {
    let shift: u32 = amount % 32;
    if (shift == 0) {
        return value;
    }
    return(value >> shift)|(value <<(32 - shift));
}
pub fn reverse_bits_u32(value: u32) -> u32 {
    let remaining: u32 = value;
    let reversed: u32 = 0;
    let count: u32 = 0;
    while (count<32) {
        reversed =(reversed << 1)|(remaining&1);
        remaining >>= 1;
        count += 1;
    }
    return reversed;
}
pub fn swap_bytes_u32(value: u32) -> u32 {
    return((value&255) << 24)|((value&65280) << 8)|((value >> 8)&65280)|((value >> 24)&255);
}
// Pack four bytes with first as the most significant byte.
pub fn from_be_bytes_u32(first: u8, second: u8, third: u8, fourth: u8) -> u32 {
    return(widen_byte(first) << 24)|(widen_byte(second) << 16)|(widen_byte(third) << 8)|widen_byte(fourth);
}
// Pack four bytes with first as the least significant byte.
pub fn from_le_bytes_u32(first: u8, second: u8, third: u8, fourth: u8) -> u32 {
    return widen_byte(first)|(widen_byte(second) << 8)|(widen_byte(third) << 16)|(widen_byte(fourth) << 24);
}
// Indices 0..3 address bytes in network order; other indices return fallback.
pub fn byte_at_be_or_u32(value: u32, index: u32, fallback: u8) -> u8 {
    if (index >= 4) {
        return fallback;
    }
    let shift: u32 =(3 - index) * 8;
    return narrow_byte((value >> shift)&255);
}
// Indices 0..3 address bytes in least-significant-first order.
pub fn byte_at_le_or_u32(value: u32, index: u32, fallback: u8) -> u8 {
    if (index >= 4) {
        return fallback;
    }
    let shift: u32 = index * 8;
    return narrow_byte((value >> shift)&255);
}
// An out-of-range bit position returns the caller's fallback.
pub fn bit_at_or_u32(value: u32, index: u32, fallback: bool) -> bool {
    if (index >= 32) {
        return fallback;
    }
    return((value >> index)&1) != 0;
}

// Byte operations widen before shifting so the intermediate value cannot
// overflow u8. Counts use 8 as the zero-value leading/trailing convention.
pub fn count_ones_u8(value: u8) -> u32 {
    return count_ones_u32(widen_byte(value));
}
pub fn count_zeros_u8(value: u8) -> u32 {
    return 8 - count_ones_u8(value);
}
pub fn leading_zeros_u8(value: u8) -> u32 {
    return leading_zeros_u32(widen_byte(value)) - 24;
}
pub fn trailing_zeros_u8(value: u8) -> u32 {
    if (value == 0) {
        return 8;
    }
    return trailing_zeros_u32(widen_byte(value));
}
pub fn has_single_bit_u8(value: u8) -> bool {
    return has_single_bit_u32(widen_byte(value));
}
// Rotation counts are reduced modulo 8; the zero case avoids a shift by 8.
pub fn rotate_left_u8(value: u8, amount: u32) -> u8 {
    let shift: u32 = amount % 8;
    if (shift == 0) {
        return value;
    }
    let bits: u32 = widen_byte(value);
    return narrow_byte(((bits << shift)|(bits >>(8 - shift)))&255);
}
pub fn rotate_right_u8(value: u8, amount: u32) -> u8 {
    let shift: u32 = amount % 8;
    if (shift == 0) {
        return value;
    }
    let bits: u32 = widen_byte(value);
    return narrow_byte(((bits >> shift)|(bits <<(8 - shift)))&255);
}
pub fn reverse_bits_u8(value: u8) -> u8 {
    let remaining: u32 = widen_byte(value);
    let reversed: u32 = 0;
    let count: u32 = 0;
    while (count<8) {
        reversed =(reversed << 1)|(remaining&1);
        remaining >>= 1;
        count += 1;
    }
    return narrow_byte(reversed);
}
// Out-of-range indices return the caller's fallback unchanged.
pub fn bit_at_or_u8(value: u8, index: u32, fallback: bool) -> bool {
    if (index >= 8) {
        return fallback;
    }
    return((widen_byte(value) >> index)&1) != 0;
}

// Halfword operations use 16 as the zero-value leading/trailing convention.
pub fn count_ones_u16(value: u16) -> u32 {
    return count_ones_u32(widen_half(value));
}
pub fn count_zeros_u16(value: u16) -> u32 {
    return 16 - count_ones_u16(value);
}
pub fn leading_zeros_u16(value: u16) -> u32 {
    return leading_zeros_u32(widen_half(value)) - 16;
}
pub fn trailing_zeros_u16(value: u16) -> u32 {
    if (value == 0) {
        return 16;
    }
    return trailing_zeros_u32(widen_half(value));
}
pub fn has_single_bit_u16(value: u16) -> bool {
    return has_single_bit_u32(widen_half(value));
}
// Rotation counts are reduced modulo 16; the zero case avoids a shift by 16.
pub fn rotate_left_u16(value: u16, amount: u32) -> u16 {
    let shift: u32 = amount % 16;
    if (shift == 0) {
        return value;
    }
    let bits: u32 = widen_half(value);
    return narrow_half(((bits << shift)|(bits >>(16 - shift)))&65535);
}
pub fn rotate_right_u16(value: u16, amount: u32) -> u16 {
    let shift: u32 = amount % 16;
    if (shift == 0) {
        return value;
    }
    let bits: u32 = widen_half(value);
    return narrow_half(((bits >> shift)|(bits <<(16 - shift)))&65535);
}
pub fn reverse_bits_u16(value: u16) -> u16 {
    let remaining: u32 = widen_half(value);
    let reversed: u32 = 0;
    let count: u32 = 0;
    while (count<16) {
        reversed =(reversed << 1)|(remaining&1);
        remaining >>= 1;
        count += 1;
    }
    return narrow_half(reversed);
}
// Out-of-range indices return the caller's fallback unchanged.
pub fn bit_at_or_u16(value: u16, index: u32, fallback: bool) -> bool {
    if (index >= 16) {
        return fallback;
    }
    return((widen_half(value) >> index)&1) != 0;
}
