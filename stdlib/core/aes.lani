// AES-128/192/256, FIPS 197 (2023), sections 4 and 5.
// https://doi.org/10.6028/NIST.FIPS.197-upd1
module core::aes;
import core::result;
import core::slice;

pub enum Error { Bounds, InvalidKeyLength, InvalidBlockLength, BufferTooSmall }
// Inline expanded key, no retained source borrow. Construct with new; field
// mutation/fabricated schedules are outside the contract. Copies are independent.
pub struct Schedule { round_keys: [u8; 240], rounds: i32 }

fn valid(value: core::slice::View<u8>) -> bool {
    return value.start >= 0 && value.length >= 0 && value.start <= 2147483647-value.length;
}
// Fixed eight iterations, no secret-dependent lookup, branch or array index.
fn multiply(left: u8, right: u8) -> u8 {
    let a: u32 = left as u32; let b: u32 = right as u32;
    let product: u32 = 0; let index: i32 = 0;
    while (index < 8) {
        product ^= a & (255*(b & 1));
        a = ((a << 1) & 255) ^ (27*((a >> 7) & 1)); b >>= 1; index += 1;
    }
    return product as u8;
}
fn twice(value: u8) -> u8 {
    let x: u32 = value as u32;
    return (((x << 1) & 255) ^ (27*((x >> 7) & 1))) as u8;
}
// x^254; zero maps to zero as required by the S-box definition. Fixed chain.
fn inverse(value: u8) -> u8 {
    let x2: u8 = multiply(value, value); let x3: u8 = multiply(x2, value);
    let x6: u8 = multiply(x3, x3); let x12: u8 = multiply(x6, x6);
    let x15: u8 = multiply(x12, x3); let x30: u8 = multiply(x15, x15);
    let x60: u8 = multiply(x30, x30); let x120: u8 = multiply(x60, x60);
    let x240: u8 = multiply(x120, x120); let x252: u8 = multiply(x240, x12);
    return multiply(x252, x2);
}
fn rotate(value: u8, amount: i32) -> u8 {
    let x: u32 = value as u32; return (((x << amount) | (x >> (8-amount))) & 255) as u8;
}
fn substitute(value: u8) -> u8 {
    let x: u8 = inverse(value);
    return x ^ rotate(x, 1) ^ rotate(x, 2) ^ rotate(x, 3) ^ rotate(x, 4) ^ 99;
}
fn inverse_substitute(value: u8) -> u8 {
    return inverse(rotate(value, 1) ^ rotate(value, 3) ^ rotate(value, 6) ^ 5);
}
pub fn new(key: core::slice::View<u8>) -> core::result::Result<Schedule, Error> {
    if (!valid(key)) { return core::result::Err(Error::Bounds); }
    if (key.length != 16 && key.length != 24 && key.length != 32) { return core::result::Err(Error::InvalidKeyLength); }
    let expanded: [u8; 240] = [0; 240]; let index: i32 = 0;
    while (index < key.length) { expanded[index] = key.values[key.start+index]; index += 1; }
    let rounds: i32 = key.length/4+6; let rcon: u8 = 1;
    while (index < (rounds+1)*16) {
        let a: u8 = expanded[index-4]; let b: u8 = expanded[index-3];
        let c: u8 = expanded[index-2]; let d: u8 = expanded[index-1];
        if (index%key.length == 0) {
            let first: u8 = a; a = substitute(b) ^ rcon; b = substitute(c);
            c = substitute(d); d = substitute(first); rcon = twice(rcon);
        } else { if (key.length == 32 && index%32 == 16) {
            a = substitute(a); b = substitute(b); c = substitute(c); d = substitute(d);
        } }
        expanded[index] = expanded[index-key.length] ^ a;
        expanded[index+1] = expanded[index+1-key.length] ^ b;
        expanded[index+2] = expanded[index+2-key.length] ^ c;
        expanded[index+3] = expanded[index+3-key.length] ^ d; index += 4;
    }
    return core::result::Ok(Schedule { round_keys: expanded, rounds: rounds });
}
fn add_key(state: [u8], keys: [u8], round: i32) {
    let index: i32 = 0; while (index < 16) { state[index] ^= keys[round*16+index]; index += 1; }
}
fn sub_shift(state: [u8], decrypt: bool) {
    let original: [u8; 16] = [0; 16]; let index: i32 = 0;
    while (index < 16) { original[index] = state[index]; index += 1; }
    let column: i32 = 0;
    while (column < 4) {
        let row: i32 = 0;
        while (row < 4) {
            if (decrypt) { state[column*4+row] = inverse_substitute(original[((column+4-row)%4)*4+row]); }
            else { state[column*4+row] = substitute(original[((column+row)%4)*4+row]); }
            row += 1;
        }
        column += 1;
    }
}
fn mix(state: [u8], decrypt: bool) {
    let column: i32 = 0;
    while (column < 4) {
        let at: i32 = column*4;
        let a: u8 = state[at]; let b: u8 = state[at+1]; let c: u8 = state[at+2]; let d: u8 = state[at+3];
        if (decrypt) {
            let ac: u8 = twice(twice(a ^ c)); let bd: u8 = twice(twice(b ^ d));
            a ^= ac; c ^= ac; b ^= bd; d ^= bd;
        }
        let sum: u8 = a ^ b ^ c ^ d;
        state[at] = a ^ sum ^ twice(a ^ b); state[at+1] = b ^ sum ^ twice(b ^ c);
        state[at+2] = c ^ sum ^ twice(c ^ d); state[at+3] = d ^ sum ^ twice(d ^ a);
        column += 1;
    }
}
pub impl Schedule {
    pub fn borrow(&self) -> &Schedule { return self; }
    fn transform(&self, input: core::slice::View<u8>, output: core::slice::View<u8>, decrypt: bool) -> core::result::Result<i32, Error> {
        if (!valid(input) || !valid(output)) { return core::result::Err(Error::Bounds); }
        if (input.length != 16) { return core::result::Err(Error::InvalidBlockLength); }
        if (output.length < 16) { return core::result::Err(Error::BufferTooSmall); }
        let state: [u8; 16] = [0; 16]; let index: i32 = 0;
        while (index < 16) { state[index] = input.values[input.start+index]; index += 1; }
        if (decrypt) {
            add_key(state, self.round_keys, self.rounds); let round: i32 = self.rounds-1;
            while (round > 0) { sub_shift(state, true); add_key(state, self.round_keys, round); mix(state, true); round -= 1; }
            sub_shift(state, true); add_key(state, self.round_keys, 0);
        } else {
            add_key(state, self.round_keys, 0); let round: i32 = 1;
            while (round < self.rounds) { sub_shift(state, false); mix(state, false); add_key(state, self.round_keys, round); round += 1; }
            sub_shift(state, false); add_key(state, self.round_keys, self.rounds);
        }
        index = 0; while (index < 16) { output.values[output.start+index] = state[index]; index += 1; }
        return core::result::Ok(16);
    }
    // Physically backed views, disjoint from self. All 16 input bytes are
    // staged before writes: exact in-place and partial overlap are supported.
    // All errors preserve output and schedule; larger output suffix is untouched.
    pub fn encrypt_into(&self, input: core::slice::View<u8>, output: core::slice::View<u8>) -> core::result::Result<i32, Error> {
        return self.transform(input, output, false);
    }
    pub fn decrypt_into(&self, input: core::slice::View<u8>, output: core::slice::View<u8>) -> core::result::Result<i32, Error> {
        return self.transform(input, output, true);
    }
}
