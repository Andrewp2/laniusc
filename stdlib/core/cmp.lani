pub impl PartialEq<f32> for f32 {
    pub fn partial_eq(left: f32, right: f32) -> bool { return left == right; }
    pub fn partial_ne(left: f32, right: f32) -> bool { return left != right; }
}

pub impl PartialOrd<f32> for f32 {
    pub fn partial_lt(left: f32, right: f32) -> bool { return left < right; }
    pub fn partial_le(left: f32, right: f32) -> bool { return left <= right; }
    pub fn partial_gt(left: f32, right: f32) -> bool { return left > right; }
    pub fn partial_ge(left: f32, right: f32) -> bool { return left >= right; }
    pub fn partial_cmp(left: f32, right: f32) -> PartialOrdering {
        if (left < right) { return Less; }
        if (left > right) { return Greater; }
        if (left != right) { return Unordered; }
        return Equal;
    }
}

