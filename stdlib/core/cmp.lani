// Core comparison traits and scalar entry points.

module core::cmp;

pub trait Eq<T> {
    pub fn eq(left: T, right: T) -> bool;
    pub fn ne(left: T, right: T) -> bool;
}

pub trait Ord<T> {
    pub fn lt(left: T, right: T) -> bool;
    pub fn le(left: T, right: T) -> bool;
    pub fn gt(left: T, right: T) -> bool;
    pub fn ge(left: T, right: T) -> bool;
}

pub impl Eq<i32> for i32 {
    pub fn eq(left: i32, right: i32) -> bool {
        return left == right;
    }

    pub fn ne(left: i32, right: i32) -> bool {
        return left != right;
    }
}

pub impl Ord<i32> for i32 {
    pub fn lt(left: i32, right: i32) -> bool {
        return left < right;
    }

    pub fn le(left: i32, right: i32) -> bool {
        return left <= right;
    }

    pub fn gt(left: i32, right: i32) -> bool {
        return left > right;
    }

    pub fn ge(left: i32, right: i32) -> bool {
        return left >= right;
    }
}

pub impl Eq<u32> for u32 {
    pub fn eq(left: u32, right: u32) -> bool { return left == right; }
    pub fn ne(left: u32, right: u32) -> bool { return left != right; }
}

pub impl Ord<u32> for u32 {
    pub fn lt(left: u32, right: u32) -> bool { return left < right; }
    pub fn le(left: u32, right: u32) -> bool { return left <= right; }
    pub fn gt(left: u32, right: u32) -> bool { return left > right; }
    pub fn ge(left: u32, right: u32) -> bool { return left >= right; }
}

// Callable scalar entry points while imported trait-qualified dispatch remains
// unavailable. i32 and u32 call their local trait implementations. Narrow
// integer trait impl keys currently collapse to the same signed or unsigned
// type code as 32-bit integers, so their entry points use scalar operators.
pub fn eq_i32(left: i32, right: i32) -> bool { return i32::eq(left, right); }
pub fn ne_i32(left: i32, right: i32) -> bool { return i32::ne(left, right); }
pub fn lt_i32(left: i32, right: i32) -> bool { return i32::lt(left, right); }
pub fn le_i32(left: i32, right: i32) -> bool { return i32::le(left, right); }
pub fn gt_i32(left: i32, right: i32) -> bool { return i32::gt(left, right); }
pub fn ge_i32(left: i32, right: i32) -> bool { return i32::ge(left, right); }

pub fn eq_u32(left: u32, right: u32) -> bool { return u32::eq(left, right); }
pub fn ne_u32(left: u32, right: u32) -> bool { return u32::ne(left, right); }
pub fn lt_u32(left: u32, right: u32) -> bool { return u32::lt(left, right); }
pub fn le_u32(left: u32, right: u32) -> bool { return u32::le(left, right); }
pub fn gt_u32(left: u32, right: u32) -> bool { return u32::gt(left, right); }
pub fn ge_u32(left: u32, right: u32) -> bool { return u32::ge(left, right); }

pub fn eq_i8(left: i8, right: i8) -> bool { return left == right; }
pub fn ne_i8(left: i8, right: i8) -> bool { return left != right; }
pub fn lt_i8(left: i8, right: i8) -> bool { return left < right; }
pub fn le_i8(left: i8, right: i8) -> bool { return left <= right; }
pub fn gt_i8(left: i8, right: i8) -> bool { return left > right; }
pub fn ge_i8(left: i8, right: i8) -> bool { return left >= right; }

pub fn eq_i16(left: i16, right: i16) -> bool { return left == right; }
pub fn ne_i16(left: i16, right: i16) -> bool { return left != right; }
pub fn lt_i16(left: i16, right: i16) -> bool { return left < right; }
pub fn le_i16(left: i16, right: i16) -> bool { return left <= right; }
pub fn gt_i16(left: i16, right: i16) -> bool { return left > right; }
pub fn ge_i16(left: i16, right: i16) -> bool { return left >= right; }

pub fn eq_u8(left: u8, right: u8) -> bool { return left == right; }
pub fn ne_u8(left: u8, right: u8) -> bool { return left != right; }
pub fn lt_u8(left: u8, right: u8) -> bool { return left < right; }
pub fn le_u8(left: u8, right: u8) -> bool { return left <= right; }
pub fn gt_u8(left: u8, right: u8) -> bool { return left > right; }
pub fn ge_u8(left: u8, right: u8) -> bool { return left >= right; }

pub fn eq_u16(left: u16, right: u16) -> bool { return left == right; }
pub fn ne_u16(left: u16, right: u16) -> bool { return left != right; }
pub fn lt_u16(left: u16, right: u16) -> bool { return left < right; }
pub fn le_u16(left: u16, right: u16) -> bool { return left <= right; }
pub fn gt_u16(left: u16, right: u16) -> bool { return left > right; }
pub fn ge_u16(left: u16, right: u16) -> bool { return left >= right; }
