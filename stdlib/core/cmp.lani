// Core comparison traits and portable value entry points.

module core::cmp;


pub trait Eq<T> {
    pub fn eq(left: T, right: T) -> bool;
    pub fn ne(left: T, right: T) -> bool;
}

pub trait Ord<T> {
    pub fn lt(left: T, right: T) -> bool;
    pub fn le(left: T, right: T) -> bool;
    pub fn gt(left: T, right: T) -> bool;
    pub fn ge(left: T, right: T) -> bool;
}

pub impl Eq<i32> for i32 {
    pub fn eq(left: i32, right: i32) -> bool {
        return left == right;
    }

    pub fn ne(left: i32, right: i32) -> bool {
        return left != right;
    }
}

pub impl Ord<i32> for i32 {
    pub fn lt(left: i32, right: i32) -> bool {
        return left < right;
    }

    pub fn le(left: i32, right: i32) -> bool {
        return left <= right;
    }

    pub fn gt(left: i32, right: i32) -> bool {
        return left > right;
    }

    pub fn ge(left: i32, right: i32) -> bool {
        return left >= right;
    }
}

pub impl Eq<u32> for u32 {
    pub fn eq(left: u32, right: u32) -> bool { return left == right; }
    pub fn ne(left: u32, right: u32) -> bool { return left != right; }
}

pub impl Ord<u32> for u32 {
    pub fn lt(left: u32, right: u32) -> bool { return left < right; }
    pub fn le(left: u32, right: u32) -> bool { return left <= right; }
    pub fn gt(left: u32, right: u32) -> bool { return left > right; }
    pub fn ge(left: u32, right: u32) -> bool { return left >= right; }
}

pub impl Eq<bool> for bool {
    pub fn eq(left: bool, right: bool) -> bool { return left == right; }
    pub fn ne(left: bool, right: bool) -> bool { return left != right; }
}

pub impl Ord<bool> for bool {
    pub fn lt(left: bool, right: bool) -> bool { return !left && right; }
    pub fn le(left: bool, right: bool) -> bool { return !left || right; }
    pub fn gt(left: bool, right: bool) -> bool { return left && !right; }
    pub fn ge(left: bool, right: bool) -> bool { return left || !right; }
}

pub impl Eq<char> for char {
    pub fn eq(left: char, right: char) -> bool { return left == right; }
    pub fn ne(left: char, right: char) -> bool { return left != right; }
}

pub impl Ord<char> for char {
    pub fn lt(left: char, right: char) -> bool { return left < right; }
    pub fn le(left: char, right: char) -> bool { return left <= right; }
    pub fn gt(left: char, right: char) -> bool { return left > right; }
    pub fn ge(left: char, right: char) -> bool { return left >= right; }
}

