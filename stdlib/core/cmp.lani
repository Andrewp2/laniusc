// Address equality.
pub impl Eq<ptr> for ptr {
    pub fn eq(left: ptr, right: ptr) -> bool { return left == right; }
    pub fn ne(left: ptr, right: ptr) -> bool { return left != right; }
}

pub impl PartialEq<i32> for i32 {
    pub fn partial_eq(left: i32, right: i32) -> bool { return i32::eq(left, right); }
    pub fn partial_ne(left: i32, right: i32) -> bool { return i32::ne(left, right); }
}

pub impl PartialOrd<i32> for i32 {
    pub fn partial_lt(left: i32, right: i32) -> bool { return i32::lt(left, right); }
    pub fn partial_le(left: i32, right: i32) -> bool { return i32::le(left, right); }
    pub fn partial_gt(left: i32, right: i32) -> bool { return i32::gt(left, right); }
    pub fn partial_ge(left: i32, right: i32) -> bool { return i32::ge(left, right); }
    pub fn partial_cmp(left: i32, right: i32) -> PartialOrdering {
        if (i32::lt(left, right)) { return Less; }
        if (i32::gt(left, right)) { return Greater; }
        return Equal;
    }
}

