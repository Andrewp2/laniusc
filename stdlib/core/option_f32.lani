// A concrete optional f32 until generic enum values execute natively.
// `value` is zero for None and must be read only when `present` is true.
module core::option_f32;
import core::result_f32;

pub struct OptionF32 {
    present: bool,
    value: f32,
}

pub fn some(value: f32) -> OptionF32 {
    return OptionF32 { present: true, value: value };
}

pub fn none() -> OptionF32 {
    return OptionF32 { present: false, value: 0.0 };
}

pub fn is_some(value: OptionF32) -> bool {
    return value.present;
}

pub fn is_none(value: OptionF32) -> bool {
    return !value.present;
}

// IEEE equality makes contains(_, NaN) false even for Some(NaN).
pub fn contains(value: OptionF32, expected: f32) -> bool {
    return value.present && value.value == expected;
}

pub fn unwrap_or(value: OptionF32, fallback: f32) -> f32 {
    if (value.present) { return value.value; }
    return fallback;
}

pub fn or(value: OptionF32, fallback: OptionF32) -> OptionF32 {
    if (value.present) { return value; }
    return fallback;
}

pub fn and(value: OptionF32, next: OptionF32) -> OptionF32 {
    if (value.present) { return next; }
    return value;
}

pub fn xor(left: OptionF32, right: OptionF32) -> OptionF32 {
    if (left.present) {
        if (right.present) { return none(); }
        return left;
    }
    return right;
}

pub fn ok_or(value: OptionF32, error: f32) -> core::result_f32::ResultF32 {
    if (value.present) { return core::result_f32::ok(value.value); }
    return core::result_f32::err(error);
}

pub fn ok(value: core::result_f32::ResultF32) -> OptionF32 {
    if (core::result_f32::is_ok(value)) {
        return some(core::result_f32::unwrap_or(value, 0.0));
    }
    return none();
}

pub fn err(value: core::result_f32::ResultF32) -> OptionF32 {
    if (core::result_f32::is_err(value)) {
        return some(core::result_f32::unwrap_err_or(value, 0.0));
    }
    return none();
}
