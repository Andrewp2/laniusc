// Allocation-free endian reads and writes over caller-backed byte views.
module core::endian;
import core::bits;
import core::f32;
import core::f64;
import core::wide_u64;

fn has_width(len: i32, offset: i32, width: i32) -> bool {
    return len >= width && offset >= 0 && offset <= len - width;
}

// A rejected logical length or offset returns fallback without reading.
// Overstating physical backing can trap when an element is accessed.
pub fn read_u16_be_or(bytes: [u8], len: i32, offset: i32, fallback: u16) -> u16 {
    if (!has_width(len, offset, 2)) {
        return fallback;
    }
    let first: u8 = bytes[offset];
    let second: u8 = bytes[offset + 1];
    let high: u32 = first as u32;
    let low: u32 = second as u32;
    let word: u32 = (high << 8) | low;
    let result: u16 = word as u16;
    return result;
}

pub fn read_u16_le_or(bytes: [u8], len: i32, offset: i32, fallback: u16) -> u16 {
    if (!has_width(len, offset, 2)) {
        return fallback;
    }
    let first: u8 = bytes[offset];
    let second: u8 = bytes[offset + 1];
    let low: u32 = first as u32;
    let high: u32 = second as u32;
    let word: u32 = (high << 8) | low;
    let result: u16 = word as u16;
    return result;
}

pub fn read_u32_be_or(bytes: [u8], len: i32, offset: i32, fallback: u32) -> u32 {
    if (!has_width(len, offset, 4)) {
        return fallback;
    }
    return core::bits::from_be_bytes_u32(
        bytes[offset], bytes[offset + 1], bytes[offset + 2], bytes[offset + 3]);
}

pub fn read_u32_le_or(bytes: [u8], len: i32, offset: i32, fallback: u32) -> u32 {
    if (!has_width(len, offset, 4)) {
        return fallback;
    }
    return core::bits::from_le_bytes_u32(
        bytes[offset], bytes[offset + 1], bytes[offset + 2], bytes[offset + 3]);
}

// Read a full-width value through two portable u32 words. Rejected logical
// bounds return fallback without reading; physical backing overclaims trap.
pub fn read_wide_u64_be_or(
    bytes: [u8], len: i32, offset: i32, fallback: core::wide_u64::WideU64
) -> core::wide_u64::WideU64 {
    if (!has_width(len, offset, 8)) { return fallback; }
    let high: u32 = core::bits::from_be_bytes_u32(
        bytes[offset], bytes[offset + 1], bytes[offset + 2], bytes[offset + 3]);
    let low: u32 = core::bits::from_be_bytes_u32(
        bytes[offset + 4], bytes[offset + 5], bytes[offset + 6], bytes[offset + 7]);
    return core::wide_u64::from_words(high, low);
}

pub fn read_wide_u64_le_or(
    bytes: [u8], len: i32, offset: i32, fallback: core::wide_u64::WideU64
) -> core::wide_u64::WideU64 {
    if (!has_width(len, offset, 8)) { return fallback; }
    let low: u32 = core::bits::from_le_bytes_u32(
        bytes[offset], bytes[offset + 1], bytes[offset + 2], bytes[offset + 3]);
    let high: u32 = core::bits::from_le_bytes_u32(
        bytes[offset + 4], bytes[offset + 5], bytes[offset + 6], bytes[offset + 7]);
    return core::wide_u64::from_words(high, low);
}

// Invalid logical lengths and offsets return false without writing. A true
// result means every byte was written. Overstated physical backing can trap.
pub fn write_u16_be(bytes: [u8], len: i32, offset: i32, value: u16) -> bool {
    if (!has_width(len, offset, 2)) {
        return false;
    }
    let wide: u32 = value as u32;
    let high_word: u32 = (wide >> 8) & 255;
    let low_word: u32 = wide & 255;
    let high: u8 = high_word as u8;
    let low: u8 = low_word as u8;
    bytes[offset] = high;
    bytes[offset + 1] = low;
    return true;
}

pub fn write_u16_le(bytes: [u8], len: i32, offset: i32, value: u16) -> bool {
    if (!has_width(len, offset, 2)) {
        return false;
    }
    let wide: u32 = value as u32;
    let high_word: u32 = (wide >> 8) & 255;
    let low_word: u32 = wide & 255;
    let high: u8 = high_word as u8;
    let low: u8 = low_word as u8;
    bytes[offset] = low;
    bytes[offset + 1] = high;
    return true;
}

pub fn write_u32_be(bytes: [u8], len: i32, offset: i32, value: u32) -> bool {
    if (!has_width(len, offset, 4)) {
        return false;
    }
    bytes[offset] = core::bits::byte_at_be_or_u32(value, 0, 0);
    bytes[offset + 1] = core::bits::byte_at_be_or_u32(value, 1, 0);
    bytes[offset + 2] = core::bits::byte_at_be_or_u32(value, 2, 0);
    bytes[offset + 3] = core::bits::byte_at_be_or_u32(value, 3, 0);
    return true;
}

pub fn write_u32_le(bytes: [u8], len: i32, offset: i32, value: u32) -> bool {
    if (!has_width(len, offset, 4)) {
        return false;
    }
    bytes[offset] = core::bits::byte_at_le_or_u32(value, 0, 0);
    bytes[offset + 1] = core::bits::byte_at_le_or_u32(value, 1, 0);
    bytes[offset + 2] = core::bits::byte_at_le_or_u32(value, 2, 0);
    bytes[offset + 3] = core::bits::byte_at_le_or_u32(value, 3, 0);
    return true;
}

// Rejected logical bounds return false before any write. A true result means
// all eight bytes were stored; physical backing overclaims can trap.
pub fn write_wide_u64_be(
    bytes: [u8], len: i32, offset: i32, value: core::wide_u64::WideU64
) -> bool {
    if (!has_width(len, offset, 8)) { return false; }
    let high: u32 = core::wide_u64::high_word(value);
    let low: u32 = core::wide_u64::low_word(value);
    bytes[offset] = core::bits::byte_at_be_or_u32(high, 0, 0);
    bytes[offset + 1] = core::bits::byte_at_be_or_u32(high, 1, 0);
    bytes[offset + 2] = core::bits::byte_at_be_or_u32(high, 2, 0);
    bytes[offset + 3] = core::bits::byte_at_be_or_u32(high, 3, 0);
    bytes[offset + 4] = core::bits::byte_at_be_or_u32(low, 0, 0);
    bytes[offset + 5] = core::bits::byte_at_be_or_u32(low, 1, 0);
    bytes[offset + 6] = core::bits::byte_at_be_or_u32(low, 2, 0);
    bytes[offset + 7] = core::bits::byte_at_be_or_u32(low, 3, 0);
    return true;
}

pub fn write_wide_u64_le(
    bytes: [u8], len: i32, offset: i32, value: core::wide_u64::WideU64
) -> bool {
    if (!has_width(len, offset, 8)) { return false; }
    let high: u32 = core::wide_u64::high_word(value);
    let low: u32 = core::wide_u64::low_word(value);
    bytes[offset] = core::bits::byte_at_le_or_u32(low, 0, 0);
    bytes[offset + 1] = core::bits::byte_at_le_or_u32(low, 1, 0);
    bytes[offset + 2] = core::bits::byte_at_le_or_u32(low, 2, 0);
    bytes[offset + 3] = core::bits::byte_at_le_or_u32(low, 3, 0);
    bytes[offset + 4] = core::bits::byte_at_le_or_u32(high, 0, 0);
    bytes[offset + 5] = core::bits::byte_at_le_or_u32(high, 1, 0);
    bytes[offset + 6] = core::bits::byte_at_le_or_u32(high, 2, 0);
    bytes[offset + 7] = core::bits::byte_at_le_or_u32(high, 3, 0);
    return true;
}

// Native widths use the same logical admission and actual slice indexing as
// the represented-width family. Admit all eight bytes before either u32 part.
pub fn read_u64_be_or(bytes:[u8],len:i32,offset:i32,fallback:u64) -> u64 {
    if(!has_width(len,offset,8)) { return fallback; }
    let high:u32=read_u32_be_or(bytes,len,offset,0);
    let low:u32=read_u32_be_or(bytes,len,offset+4,0);
    return ((high as u64)<<32)|(low as u64);
}
pub fn read_u64_le_or(bytes:[u8],len:i32,offset:i32,fallback:u64) -> u64 {
    if(!has_width(len,offset,8)) { return fallback; }
    let low:u32=read_u32_le_or(bytes,len,offset,0);
    let high:u32=read_u32_le_or(bytes,len,offset+4,0);
    return ((high as u64)<<32)|(low as u64);
}
pub fn write_u64_be(bytes:[u8],len:i32,offset:i32,value:u64) -> bool {
    if(!has_width(len,offset,8)) { return false; }
    let high:u32=(value>>32) as u32;
    let low:u32=value as u32;
    let first:bool=write_u32_be(bytes,len,offset,high);
    let second:bool=write_u32_be(bytes,len,offset+4,low);
    return first && second;
}
pub fn write_u64_le(bytes:[u8],len:i32,offset:i32,value:u64) -> bool {
    if(!has_width(len,offset,8)) { return false; }
    let low:u32=value as u32;
    let high:u32=(value>>32) as u32;
    let first:bool=write_u32_le(bytes,len,offset,low);
    let second:bool=write_u32_le(bytes,len,offset+4,high);
    return first && second;
}

// Signed conversions preserve the same-width two's-complement bit pattern.
// Rejected reads return the original fallback before any unsigned decoding.
pub fn read_i16_be_or(bytes:[u8],len:i32,offset:i32,fallback:i16) -> i16 {
    if(!has_width(len,offset,2)) { return fallback; }
    return read_u16_be_or(bytes,len,offset,0) as i16;
}
pub fn read_i16_le_or(bytes:[u8],len:i32,offset:i32,fallback:i16) -> i16 {
    if(!has_width(len,offset,2)) { return fallback; }
    return read_u16_le_or(bytes,len,offset,0) as i16;
}
pub fn write_i16_be(bytes:[u8],len:i32,offset:i32,value:i16) -> bool {
    if(!has_width(len,offset,2)) { return false; }
    return write_u16_be(bytes,len,offset,value as u16);
}
pub fn write_i16_le(bytes:[u8],len:i32,offset:i32,value:i16) -> bool {
    if(!has_width(len,offset,2)) { return false; }
    return write_u16_le(bytes,len,offset,value as u16);
}
pub fn read_i32_be_or(bytes:[u8],len:i32,offset:i32,fallback:i32) -> i32 {
    if(!has_width(len,offset,4)) { return fallback; }
    return read_u32_be_or(bytes,len,offset,0) as i32;
}
pub fn read_i32_le_or(bytes:[u8],len:i32,offset:i32,fallback:i32) -> i32 {
    if(!has_width(len,offset,4)) { return fallback; }
    return read_u32_le_or(bytes,len,offset,0) as i32;
}
pub fn write_i32_be(bytes:[u8],len:i32,offset:i32,value:i32) -> bool {
    if(!has_width(len,offset,4)) { return false; }
    return write_u32_be(bytes,len,offset,value as u32);
}
pub fn write_i32_le(bytes:[u8],len:i32,offset:i32,value:i32) -> bool {
    if(!has_width(len,offset,4)) { return false; }
    return write_u32_le(bytes,len,offset,value as u32);
}
pub fn read_i64_be_or(bytes:[u8],len:i32,offset:i32,fallback:i64) -> i64 {
    if(!has_width(len,offset,8)) { return fallback; }
    return read_u64_be_or(bytes,len,offset,0) as i64;
}
pub fn read_i64_le_or(bytes:[u8],len:i32,offset:i32,fallback:i64) -> i64 {
    if(!has_width(len,offset,8)) { return fallback; }
    return read_u64_le_or(bytes,len,offset,0) as i64;
}
pub fn write_i64_be(bytes:[u8],len:i32,offset:i32,value:i64) -> bool {
    if(!has_width(len,offset,8)) { return false; }
    return write_u64_be(bytes,len,offset,value as u64);
}
pub fn write_i64_le(bytes:[u8],len:i32,offset:i32,value:i64) -> bool {
    if(!has_width(len,offset,8)) { return false; }
    return write_u64_le(bytes,len,offset,value as u64);
}

// Float transfers perform no floating arithmetic or numeric integer casts.
// Existing exact-bit helpers carry zero signs and NaN payloads unchanged.
pub fn read_f32_be_or(bytes:[u8],len:i32,offset:i32,fallback:f32) -> f32 {
    if(!has_width(len,offset,4)) { return fallback; }
    let bits:u32=read_u32_be_or(bytes,len,offset,0);
    return core::f32::from_bits(bits);
}
pub fn read_f32_le_or(bytes:[u8],len:i32,offset:i32,fallback:f32) -> f32 {
    if(!has_width(len,offset,4)) { return fallback; }
    let bits:u32=read_u32_le_or(bytes,len,offset,0);
    return core::f32::from_bits(bits);
}
pub fn write_f32_be(bytes:[u8],len:i32,offset:i32,value:f32) -> bool {
    if(!has_width(len,offset,4)) { return false; }
    let bits:u32=core::f32::to_bits(value);
    return write_u32_be(bytes,len,offset,bits);
}
pub fn write_f32_le(bytes:[u8],len:i32,offset:i32,value:f32) -> bool {
    if(!has_width(len,offset,4)) { return false; }
    let bits:u32=core::f32::to_bits(value);
    return write_u32_le(bytes,len,offset,bits);
}
pub fn read_f64_be_or(bytes:[u8],len:i32,offset:i32,fallback:f64) -> f64 {
    if(!has_width(len,offset,8)) { return fallback; }
    let bits:u64=read_u64_be_or(bytes,len,offset,0);
    return core::f64::from_bits(bits);
}
pub fn read_f64_le_or(bytes:[u8],len:i32,offset:i32,fallback:f64) -> f64 {
    if(!has_width(len,offset,8)) { return fallback; }
    let bits:u64=read_u64_le_or(bytes,len,offset,0);
    return core::f64::from_bits(bits);
}
pub fn write_f64_be(bytes:[u8],len:i32,offset:i32,value:f64) -> bool {
    if(!has_width(len,offset,8)) { return false; }
    let bits:u64=core::f64::to_bits(value);
    return write_u64_be(bytes,len,offset,bits);
}
pub fn write_f64_le(bytes:[u8],len:i32,offset:i32,value:f64) -> bool {
    if(!has_width(len,offset,8)) { return false; }
    let bits:u64=core::f64::to_bits(value);
    return write_u64_le(bytes,len,offset,bits);
}
