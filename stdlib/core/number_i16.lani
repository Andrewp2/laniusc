// Allocation-free signed 16-bit arithmetic. Widen before arithmetic so
// overflow decisions do not depend on native i16 wrap behavior.
module core::number_i16;
pub const MIN: i16 = -32768;
pub const MAX: i16 = 32767;
fn in_range(value: i32) -> bool {
    return value >= -32768 && value <= 32767;
}
fn saturate(value: i32) -> i16 {
    if (value< - 32768) {
        return MIN;
    }
    if (value>32767) {
        return MAX;
    }
    let narrowed: i16 = value as i16;
    return narrowed;
}
pub fn min(left: i16, right: i16) -> i16 {
    if (left<right) {
        return left;
    }
    return right;
}
pub fn max(left: i16, right: i16) -> i16 {
    if (left>right) {
        return left;
    }
    return right;
}
// Reversed bounds return fallback unchanged.
pub fn clamp_or(value: i16, low: i16, high: i16, fallback: i16) -> i16 {
    if (low>high) {
        return fallback;
    }
    if (value<low) {
        return low;
    }
    if (value>high) {
        return high;
    }
    return value;
}
pub fn saturating_abs(value: i16) -> i16 {
    if (value == MIN) {
        return MAX;
    }
    if (value<0) {
        return -value;
    }
    return value;
}
// The mathematical GCD of MIN and zero, or MIN and MIN, is 32768 and returns
// fallback because it cannot be represented as i16. gcd(0, 0) is zero.
pub fn gcd_or(left: i16, right: i16, fallback: i16) -> i16 {
    let a: i32 = left as i32;
    let b: i32 = right as i32;
    if (a<0) {
        a = -a;
    }
    if (b<0) {
        b = -b;
    }
    while (b != 0) {
        let remainder: i32 = a % b;
        a = b;
        b = remainder;
    }
    if (a>32767) {
        return fallback;
    }
    let narrowed: i16 = a as i16;
    return narrowed;
}
// Returns a nonnegative LCM, zero for a zero operand, or fallback above MAX.
pub fn lcm_or(left: i16, right: i16, fallback: i16) -> i16 {
    if (left == 0 || right == 0) {
        return 0;
    }
    let a: i32 = left as i32;
    let b: i32 = right as i32;
    if (a<0) {
        a = -a;
    }
    if (b<0) {
        b = -b;
    }
    let first: i32 = a;
    let second: i32 = b;
    while (second != 0) {
        let remainder: i32 = first % second;
        first = second;
        second = remainder;
    }
    let product: i32 =(a / first) * b;
    if (product>32767) {
        return fallback;
    }
    let narrowed: i16 = product as i16;
    return narrowed;
}
pub fn saturating_add(left: i16, right: i16) -> i16 {
    let a: i32 = left as i32;
    let b: i32 = right as i32;
    return saturate(a + b);
}
pub fn saturating_sub(left: i16, right: i16) -> i16 {
    let a: i32 = left as i32;
    let b: i32 = right as i32;
    return saturate(a - b);
}
pub fn saturating_mul(left: i16, right: i16) -> i16 {
    let a: i32 = left as i32;
    let b: i32 = right as i32;
    return saturate(a * b);
}
// Normalize before narrowing: an out-of-range signed cast does not currently
// sign-extend reliably on native targets. Every i16 product fits in i32.
fn wrap(value: i32) -> i16 {
    let reduced: i32 = value % 65536;
    if (reduced > 32767) {
        reduced -= 65536;
    }
    if (reduced < -32768) {
        reduced += 65536;
    }
    return reduced as i16;
}
pub fn wrapping_add(left: i16, right: i16) -> i16 {
    let a: i32 = left as i32;
    let b: i32 = right as i32;
    let result: i32 = a + b;
    return wrap(result);
}
pub fn wrapping_sub(left: i16, right: i16) -> i16 {
    let a: i32 = left as i32;
    let b: i32 = right as i32;
    let result: i32 = a - b;
    return wrap(result);
}
pub fn wrapping_mul(left: i16, right: i16) -> i16 {
    let a: i32 = left as i32;
    let b: i32 = right as i32;
    let result: i32 = a * b;
    return wrap(result);
}
// Returns fallback when the product is outside the signed 16-bit range.
pub fn mul_or(left: i16, right: i16, fallback: i16) -> i16 {
    let a: i32 = left as i32;
    let b: i32 = right as i32;
    let product: i32 = a * b;
    if (!in_range(product)) {
        return fallback;
    }
    let narrowed: i16 = product as i16;
    return narrowed;
}
// Defines 0^0 as one. An unrepresentable power returns fallback.
pub fn pow_or(base: i16, exponent: u32, fallback: i16) -> i16 {
    let result: i32 = 1;
    let factor: i32 = base as i32;
    let remaining: u32 = exponent;
    while (remaining>0) {
        if (remaining % 2 != 0) {
            let product: i32 = result * factor;
            if (!in_range(product)) {
                return fallback;
            }
            result = product;
        }
        remaining /= 2;
        if (remaining>0) {
            let square: i32 = factor * factor;
            if (!in_range(square)) {
                return fallback;
            }
            factor = square;
        }
    }
    let narrowed: i16 = result as i16;
    return narrowed;
}
pub fn saturating_abs_diff(left: i16, right: i16) -> i16 {
    let a: i32 = left as i32;
    let b: i32 = right as i32;
    if (a >= b) {
        return saturate(a - b);
    }
    return saturate(b - a);
}
pub fn is_even(value: i16) -> bool {
    return value % 2 == 0;
}
pub fn is_odd(value: i16) -> bool {
    return value % 2 != 0;
}
pub fn is_zero(value: i16) -> bool {
    return value == 0;
}
pub fn signum(value: i16) -> i16 {
    if (value<0) {
        return -1;
    }
    if (value>0) {
        return 1;
    }
    return 0;
}
// A zero divisor returns false.
pub fn is_multiple_of(value: i16, divisor: i16) -> bool {
    if (divisor == 0) {
        return false;
    }
    let a: i32 = value as i32;
    let b: i32 = divisor as i32;
    return a % b == 0;
}
// A zero divisor or MIN/-1 returns fallback before division.
pub fn div_or(value: i16, divisor: i16, fallback: i16) -> i16 {
    if (divisor == 0 || value == MIN && divisor == -1) {
        return fallback;
    }
    let a: i32 = value as i32;
    let b: i32 = divisor as i32;
    let quotient: i16 = (a / b) as i16;
    return quotient;
}
pub fn rem_or(value: i16, divisor: i16, fallback: i16) -> i16 {
    if (divisor == 0 || value == MIN && divisor == -1) {
        return fallback;
    }
    let a: i32 = value as i32;
    let b: i32 = divisor as i32;
    let remainder: i16 = (a % b) as i16;
    return remainder;
}
// Euclidean division has a nonnegative remainder. Failure uses fallback.
pub fn div_euclid_or(value: i16, divisor: i16, fallback: i16) -> i16 {
    if (divisor == 0 || value == MIN && divisor == -1) {
        return fallback;
    }
    let a: i32 = value as i32;
    let b: i32 = divisor as i32;
    let quotient: i32 = a / b;
    let remainder: i32 = a % b;
    if (remainder<0) {
        if (b>0) {
            quotient -= 1;
        } else {
            quotient += 1;
        }
    }
    let narrowed: i16 = quotient as i16;
    return narrowed;
}
pub fn rem_euclid_or(value: i16, divisor: i16, fallback: i16) -> i16 {
    if (divisor == 0 || value == MIN && divisor == -1) {
        return fallback;
    }
    let a: i32 = value as i32;
    let b: i32 = divisor as i32;
    let remainder: i32 = a % b;
    if (remainder<0) {
        if (b>0) {
            remainder += b;
        } else {
            remainder -= b;
        }
    }
    let narrowed: i16 = remainder as i16;
    return narrowed;
}
pub fn is_power_of_two(value: i16) -> bool {
    if (value <= 0) {
        return false;
    }
    return(value&(value - 1)) == 0;
}
// Zero means the next positive power cannot fit in i16.
pub fn next_power_of_two(value: i16) -> i16 {
    if (value <= 1) {
        return 1;
    }
    if (value>16384) {
        return 0;
    }
    let power: i16 = 1;
    while (power<value) {
        power *= 2;
    }
    return power;
}
