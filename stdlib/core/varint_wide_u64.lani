// Canonical unsigned LEB128 for two-word 64-bit values. No allocation.
module core::varint_wide_u64;
import core::varint;
import core::wide_u64;

pub struct ReadWideU64 {
    // A negative state stores the successful next offset as its negation.
    // Error states are the positive status codes from core::varint.
    state: i32,
    high: u32,
    low: u32,
}

fn failed_wide_u64(status: i32) -> ReadWideU64 {
    return ReadWideU64 {
        state: status, high: 0, low: 0
    };
}

pub fn status_wide_u64(result: ReadWideU64) -> i32 {
    if (result.state < 0) { return core::varint::OK; }
    return result.state;
}
pub fn value_wide_u64_or(
    result: ReadWideU64, fallback: core::wide_u64::WideU64
) -> core::wide_u64::WideU64 {
    if (result.state < 0) {
        return core::wide_u64::from_words(result.high, result.low);
    }
    return fallback;
}
pub fn next_wide_u64_or(result: ReadWideU64, fallback: i32) -> i32 {
    if (result.state < 0) { return -result.state; }
    return fallback;
}

pub fn len_wide_u64(value: core::wide_u64::WideU64) -> i32 {
    let remaining: core::wide_u64::WideU64 = value;
    let count: i32 = 1;
    while (core::wide_u64::compare(remaining, core::wide_u64::from_u32(128)) >= 0) {
        remaining = core::wide_u64::shift_right(remaining, 7);
        count += 1;
    }
    return count;
}

// Return the next offset, or -1 if logical bounds or capacity fail. A -1
// result writes nothing; an overclaimed physical backing may trap mid-write.
pub fn write_wide_u64(
    bytes: [u8], len: i32, offset: i32, value: core::wide_u64::WideU64
) -> i32 {
    if (len < 0 || offset < 0 || offset > len) { return -1; }
    let count: i32 = len_wide_u64(value);
    if (count > len - offset) { return -1; }
    let remaining: core::wide_u64::WideU64 = value;
    let position: i32 = offset;
    while (core::wide_u64::compare(remaining, core::wide_u64::from_u32(128)) >= 0) {
        let encoded_word: u32 = (core::wide_u64::low_word(remaining) & 127) + 128;
        let encoded_byte: u8 = encoded_word as u8;
        bytes[position] = encoded_byte;
        remaining = core::wide_u64::shift_right(remaining, 7);
        position += 1;
    }
    let last_word: u32 = core::wide_u64::low_word(remaining);
    let last_byte: u8 = last_word as u8;
    bytes[position] = last_byte;
    return offset + count;
}

// Status codes come from core::varint. A physical backing overclaim can trap.
pub fn read_wide_u64(bytes: [u8], len: i32, offset: i32) -> ReadWideU64 {
    if (len < 0 || offset < 0 || offset > len) { return failed_wide_u64(core::varint::INVALID_BOUNDS); }
    let value: core::wide_u64::WideU64 = core::wide_u64::zero();
    let index: i32 = 0;
    while (index < 10) {
        if (index >= len - offset) { return failed_wide_u64(core::varint::TRUNCATED); }
        let raw_byte: u8 = bytes[offset + index];
        let byte: u32 = raw_byte as u32;
        let payload: u32 = byte & 127;
        if (index == 9 && payload > 1) { return failed_wide_u64(core::varint::OVERFLOW); }
        let group_value: core::wide_u64::WideU64 = core::wide_u64::shift_left(
            core::wide_u64::from_u32(payload), index * 7);
        value = core::wide_u64::bit_or(value, group_value);
        if ((byte & 128) == 0) {
            if (index > 0 && payload == 0) { return failed_wide_u64(core::varint::NON_CANONICAL); }
            return ReadWideU64 {
                state: -(offset + index + 1),
                high: core::wide_u64::high_word(value),
                low: core::wide_u64::low_word(value)
            };
        }
        index += 1;
    }
    return failed_wide_u64(core::varint::OVERFLOW);
}
