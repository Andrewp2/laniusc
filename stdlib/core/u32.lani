// Module-form u32 helpers for source-level stdlib imports.

module core::u32;

import core::option_u32;
import core::number_u32;

pub const MIN: u32 = 0;
pub const MAX: u32 = 4294967295;
pub const BITS: u32 = 32;
pub const BYTES: u32 = 4;

pub fn min(left: u32, right: u32) -> u32 {
    if (left < right) {
        return left;
    } else {
        return right;
    }
}

pub fn max(left: u32, right: u32) -> u32 {
    if (left > right) {
        return left;
    } else {
        return right;
    }
}

pub fn clamp(value: u32, low: u32, high: u32) -> u32 {
    // An invalid interval leaves the input unchanged.
    if (low > high) {
        return value;
    }
    if (value < low) {
        return low;
    } else {
        if (value > high) {
            return high;
        } else {
            return value;
        }
    }
}

pub fn wrapping_add(left: u32, right: u32) -> u32 {
    return left + right;
}

pub fn wrapping_sub(left: u32, right: u32) -> u32 {
    return left - right;
}

pub fn wrapping_mul(left: u32, right: u32) -> u32 {
    return left * right;
}

pub fn checked_add(left: u32, right: u32) -> core::option_u32::OptionU32 {
    if (left > MAX - right) {
        return core::option_u32::none();
    } else {
        return core::option_u32::some(left + right);
    }
}

pub fn checked_sub(left: u32, right: u32) -> core::option_u32::OptionU32 {
    if (left < right) {
        return core::option_u32::none();
    } else {
        return core::option_u32::some(left - right);
    }
}

pub fn saturating_add(left: u32, right: u32) -> u32 {
    if (left > MAX - right) {
        return MAX;
    } else {
        return left + right;
    }
}

pub fn saturating_sub(left: u32, right: u32) -> u32 {
    if (left < right) {
        return MIN;
    } else {
        return left - right;
    }
}

pub fn saturating_mul(left: u32, right: u32) -> u32 {
    if (right == 0) {
        return 0;
    }
    if (left > MAX / right) {
        return MAX;
    }
    return left * right;
}

pub fn abs_diff(left: u32, right: u32) -> u32 {
    if (left >= right) {
        return left - right;
    } else {
        return right - left;
    }
}

pub fn is_zero(value: u32) -> bool {
    return value == 0;
}

pub fn is_nonzero(value: u32) -> bool {
    return value != 0;
}

pub fn is_even(value: u32) -> bool {
    return value % 2 == 0;
}

pub fn is_odd(value: u32) -> bool {
    return value % 2 != 0;
}

pub fn is_multiple_of(value: u32, divisor: u32) -> bool {
    if (divisor == 0) {
        return false;
    } else {
        return value % divisor == 0;
    }
}

pub fn between_inclusive(value: u32, low: u32, high: u32) -> bool {
    return value >= low && value <= high;
}

pub fn between_exclusive(value: u32, low: u32, high: u32) -> bool {
    return value > low && value < high;
}

pub fn is_power_of_two(value: u32) -> bool {
    if (value <= 0) {
        return false;
    } else {
        if (value > 2147483648) {
            return false;
        }
        let power: u32 = 1;
        while (power < value) {
            power *= 2;
        }
        return power == value;
    }
}

pub fn next_power_of_two(value: u32) -> u32 {
    if (value <= 1) {
        return 1;
    } else {
        // Zero signals that the next power is not representable in u32.
        if (value > 2147483648) {
            return 0;
        }
        let power: u32 = 1;
        while (power < value) {
            power *= 2;
        }
        return power;
    }
}

pub fn checked_next_power_of_two(value: u32) -> core::option_u32::OptionU32 {
    let highest_power_of_two: u32 = 2147483648;
    if (value <= 1) {
        return core::option_u32::some(1);
    } else {
        if (value > highest_power_of_two) {
            return core::option_u32::none();
        } else {
            let power: u32 = 1;
            while (power < value) {
                power *= 2;
            }
            return core::option_u32::some(power);
        }
    }
}

pub fn is_aligned(value: u32, alignment: u32) -> bool {
    return core::number_u32::is_aligned(value, alignment);
}

// Zero alignment or overflow returns zero, the unrepresentable-result sentinel.
pub fn align_up(value: u32, alignment: u32) -> u32 {
    return core::number_u32::align_up_or(value, alignment, 0);
}

// Zero alignment returns zero. A valid nonzero result is aligned.
pub fn align_down(value: u32, alignment: u32) -> u32 {
    return core::number_u32::align_down_or(value, alignment, 0);
}
