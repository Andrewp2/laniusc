// Private static table decoder for Unicode 17.0.0 generated data.
module core::unicode_table;
// All generated bytes are uppercase ASCII hex; callers supply backed bounds.
pub fn hex(bytes: [u8], start: i32, width: i32) -> u32 {
    let result: u32 = 0;
    let index: i32 = 0;
    while (index < width) {
        let byte: u32 = bytes[start + index] as u32;
        let nibble: u32 = byte - 48;
        if (byte >= 65) { nibble = byte - 55; }
        result = result * 16 + nibble;
        index += 1;
    }
    return result;
}
