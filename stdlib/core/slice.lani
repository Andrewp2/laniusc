// Allocation-free algorithms over a view of any element type. The caller
// supplies the view length because the source language cannot read slice
// metadata yet. A length larger than the actual view is invalid; native
// indexing traps if it reaches beyond the view. Functions below specify
// whether a negative length is treated as empty or rejected without mutation.
//
// Searching needs core::cmp::PartialEq. Ordering uses a borrowed Comparator or
// the type's global Ord through Natural. Ordered functions require a lawful
// total order. Native float membership follows IEEE equality; sorting float
// encodings needs core::float_order wrappers or an explicit total comparator.
module core::slice;

import core::cmp;
import core::ops;
import core::option;
import core::ordering;
import core::result;

// Length-bearing borrowed views. Construction checks logical bounds; until
// slice length projection exists, the caller must supply backed elements.
// Copies alias the same elements. No allocation, cloning or destruction occurs.
// See docs/stdlib-slice-views.md for contracts, lifetime rules and evidence.
pub enum ViewError { Bounds, InvalidSize }
pub struct View<T> { values: [T], start: i32, length: i32 }
pub struct Iter<T> { values: [T], front: i32, back: i32 }
pub struct Chunks<T> { values: [T], position: i32, end: i32, width: i32 }
pub struct Windows<T> { values: [T], position: i32, end: i32, width: i32 }

// Forward predicate cursors borrow the original descriptor and callback.
// Copies fork their positions but share backing and predicate context. Keep
// both alive and stable; no clone, allocation or cleanup authority is implied.
// Iterator impls and their Mapper bounds live in core::iter to avoid a cycle.
pub struct Split<T,P> { values: [T], predicate: &P, position: i32, end: i32, done: bool }
pub struct SplitInclusive<T,P> { values: [T], predicate: &P, position: i32, end: i32 }
pub struct ChunkBy<T,P> { values: [T], predicate: &P, position: i32, end: i32 }

// Check integer metadata only, never backing or callbacks. Physical backing,
// lifetime and freedom from interfering aliases remain caller obligations.
fn view_valid<T>(values: View<T>) -> bool {
    if (values.start < 0 || values.length < 0) { return false; }
    return values.start <= 2147483647 - values.length;
}

pub fn view<T>(values: [T], count: i32) -> core::result::Result<View<T>, ViewError> {
    return view_range(values, 0, count);
}

pub fn view_range<T>(values: [T], start: i32, count: i32) -> core::result::Result<View<T>, ViewError> {
    let selected: View<T> = View { values: values, start: start, length: count };
    if (!view_valid<T>(selected)) { return core::result::Err(ViewError::Bounds); }
    return core::result::Ok(selected);
}

// Exclude separators, retaining leading, adjacent and final empty segments.
// Empty input yields one empty View. Construction never invokes the predicate;
// iteration requires P:core::function::Mapper<T,bool> through core::iter.
pub fn split<T,P>(values: View<T>, predicate: &P) -> core::result::Result<Split<T,P>,ViewError> {
    if (!view_valid<T>(values)) { return core::result::Err(ViewError::Bounds); }
    let cursor: Split<T,P> = Split { values: values.values, predicate: predicate, position: values.start, end: values.start + values.length, done: false };
    return core::result::Ok(cursor);
}

// Include each separator in its preceding segment. Empty input and a terminal
// separator add no empty segment. The Mapper bound belongs to iteration.
pub fn split_inclusive<T,P>(values: View<T>, predicate: &P) -> core::result::Result<SplitInclusive<T,P>,ViewError> {
    if (!view_valid<T>(values)) { return core::result::Err(ViewError::Bounds); }
    let cursor: SplitInclusive<T,P> = SplitInclusive { values: values.values, predicate: predicate, position: values.start, end: values.start + values.length };
    return core::result::Ok(cursor);
}

// Join adjacent elements while the predicate returns true; false starts the
// next nonempty run. No equivalence law is needed. Iteration requires
// P:core::function::Mapper<core::pair::Pair<T,T>,bool>; construction invokes none.
pub fn chunk_by<T,P>(values: View<T>, predicate: &P) -> core::result::Result<ChunkBy<T,P>,ViewError> {
    if (!view_valid<T>(values)) { return core::result::Err(ViewError::Bounds); }
    let cursor: ChunkBy<T,P> = ChunkBy { values: values.values, predicate: predicate, position: values.start, end: values.start + values.length };
    return core::result::Ok(cursor);
}

pub impl<T> View<T> {
    pub fn len(&self) -> i32 { return self.length; }
    pub fn is_empty(&self) -> bool { return self.length == 0; }
    pub fn get(&self, index: i32) -> core::option::Option<T> {
        if (index < 0 || index >= self.length) { return core::option::None(); }
        return core::option::Some(self.values[self.start + index]);
    }
    pub fn first(&self) -> core::option::Option<T> { return self.get(0); }
    pub fn last(&self) -> core::option::Option<T> { return self.get(self.length - 1); }
    // Half-open indices relative to this view. Empty subviews are valid.
    pub fn subview(&self, start: i32, end: i32) -> core::result::Result<View<T>, ViewError> {
        if (start < 0 || end < start || end > self.length) { return core::result::Err(ViewError::Bounds); }
        return core::result::Ok(View { values: self.values, start: self.start + start, length: end - start });
    }
    // Return the displaced shallow value. Invalid indices leave storage intact.
    pub fn try_set(&self, index: i32, value: T) -> core::result::Result<T, ViewError> {
        if (index < 0 || index >= self.length) { return core::result::Err(ViewError::Bounds); }
        let previous: T = self.values[self.start + index];
        self.values[self.start + index] = value;
        return core::result::Ok(previous);
    }
    // Copy within this view, including overlap. Return the number copied.
    pub fn copy_within(&self, start: i32, end: i32, destination: i32) -> core::result::Result<i32, ViewError> {
        if (start < 0 || end < start || end > self.length || destination < 0) {
            return core::result::Err(ViewError::Bounds);
        }
        let count: i32 = end - start;
        if (destination > self.length - count) { return core::result::Err(ViewError::Bounds); }
        copy_within(self.values, self.start + self.length, self.start + start, self.start + end, self.start + destination);
        return core::result::Ok(count);
    }
    // Returns the number of swaps. Only this view's elements are modified.
    pub fn reverse(&self) -> i32 { return reverse_segment(self.values, self.start, self.start + self.length); }
    pub fn fill(&self, value: T) -> i32 {
        let index: i32 = 0;
        while (index < self.length) { self.values[self.start + index] = value; index += 1; }
        return self.length;
    }
    pub fn iter(&self) -> Iter<T> { return Iter { values: self.values, front: self.start, back: self.start + self.length }; }
    // Consecutive nonoverlapping chunks; a final short chunk is included.
    pub fn chunks(&self, width: i32) -> core::result::Result<Chunks<T>, ViewError> {
        if (width <= 0) { return core::result::Err(ViewError::InvalidSize); }
        return core::result::Ok(Chunks { values: self.values, position: self.start, end: self.start + self.length, width: width });
    }
    // All overlapping windows of exactly width elements, advancing by one.
    pub fn windows(&self, width: i32) -> core::result::Result<Windows<T>, ViewError> {
        if (width <= 0) { return core::result::Err(ViewError::InvalidSize); }
        return core::result::Ok(Windows { values: self.values, position: self.start, end: self.start + self.length, width: width });
    }
}

// Cursors are fused and can be copied to fork their positions. next and
// next_back implement the shared traits in core::iter; import it to use them.
// next/next_back read current backing values, not a snapshot of the elements.
pub impl<T> Iter<T> {
    pub fn borrow(&self) -> &Iter<T> { return self; }
    pub fn remaining(&self) -> i32 { return self.back - self.front; }
    // Discard up to count elements without reading them; return actual progress.
    // Negative counts fail without changing the cursor.
    pub fn advance(&self, count: i32) -> core::result::Result<i32, ViewError> {
        if (count < 0) { return core::result::Err(ViewError::Bounds); }
        let skipped: i32 = count;
        if (skipped > self.back - self.front) { skipped = self.back - self.front; }
        self.front += skipped; return core::result::Ok(skipped);
    }
    pub fn advance_back(&self, count: i32) -> core::result::Result<i32, ViewError> {
        if (count < 0) { return core::result::Err(ViewError::Bounds); }
        let skipped: i32 = count;
        if (skipped > self.back - self.front) { skipped = self.back - self.front; }
        self.back -= skipped; return core::result::Ok(skipped);
    }
}
pub impl<T> Chunks<T> {
    pub fn borrow(&self) -> &Chunks<T> { return self; }
    pub fn remaining(&self) -> i32 {
        let count: i32 = self.end - self.position;
        let full: i32 = count / self.width;
        if (count % self.width != 0) { full += 1; }
        return full;
    }
}
pub impl<T> Windows<T> {
    pub fn borrow(&self) -> &Windows<T> { return self; }
    pub fn remaining(&self) -> i32 {
        let count: i32 = self.end - self.position;
        if (count < self.width) { return 0; }
        return count - self.width + 1;
    }
}

pub impl<T,P> Split<T,P> {
    pub fn borrow(&self) -> &Split<T,P> { return self; }
}
pub impl<T,P> SplitInclusive<T,P> {
    pub fn borrow(&self) -> &SplitInclusive<T,P> { return self; }
}
pub impl<T,P> ChunkBy<T,P> {
    pub fn borrow(&self) -> &ChunkBy<T,P> { return self; }
}

fn nonnegative_len(len: i32) -> i32 {
    if (len <= 0) {
        return 0;
    }
    return len;
}

pub fn first<T>(values: [T]) -> T {
    // Native indexing traps if values is empty.
    return values[0];
}

pub fn first_or<T>(values: [T], len: i32, fallback: T) -> T {
    if (len <= 0) {
        return fallback;
    }
    return values[0];
}

pub fn last_or<T>(values: [T], len: i32, fallback: T) -> T {
    if (len <= 0) {
        return fallback;
    }
    return values[len - 1];
}

pub fn get_or<T>(values: [T], len: i32, index: i32, fallback: T) -> T {
    if (index < 0 || index >= len) {
        return fallback;
    }
    return values[index];
}

// Returns false and leaves the view unchanged for an out-of-range index.
pub fn set<T>(values: [T], len: i32, index: i32, value: T) -> bool {
    if (index < 0 || index >= len) {
        return false;
    }
    values[index] = value;
    return true;
}

// Returns false and leaves the view unchanged if either index is invalid.
pub fn swap<T>(values: [T], len: i32, left: i32, right: i32) -> bool {
    if (left < 0 || right < 0 || left >= len || right >= len) {
        return false;
    }
    let previous: T = values[left];
    values[left] = values[right];
    values[right] = previous;
    return true;
}

// Returns the number of elements written; nonpositive lengths write nothing.
pub fn fill<T>(values: [T], len: i32, value: T) -> i32 {
    let index: i32 = 0;
    while (index < len) {
        values[index] = value;
        index += 1;
    }
    return index;
}

fn reverse_segment<T>(values: [T], start: i32, end: i32) -> i32 {
    let left: i32 = start;
    let right: i32 = end - 1;
    let swaps: i32 = 0;
    while (left < right) {
        let previous: T = values[left];
        values[left] = values[right];
        values[right] = previous;
        left += 1;
        right -= 1;
        swaps += 1;
    }
    return swaps;
}

// Returns the number of swaps performed.
pub fn reverse_in_place<T>(values: [T], len: i32) -> i32 {
    if (len <= 1) {
        return 0;
    }
    return reverse_segment(values, 0, len);
}

// Rotate the first len elements by amount positions. Amount must be in
// [0, len]; invalid arguments return false without modifying the view.
pub fn rotate_left<T>(values: [T], len: i32, amount: i32) -> bool {
    if (len < 0 || amount < 0 || amount > len) {
        return false;
    }
    if (amount == 0 || amount == len) {
        return true;
    }
    reverse_segment(values, 0, amount);
    reverse_segment(values, amount, len);
    reverse_segment(values, 0, len);
    return true;
}

pub fn rotate_right<T>(values: [T], len: i32, amount: i32) -> bool {
    if (len < 0 || amount < 0 || amount > len) {
        return false;
    }
    return rotate_left(values, len, len - amount);
}

// Copies [source_start, source_end) to destination_start within one view.
// Overlap is supported. Bounds invalid relative to `len` return false without
// writing; the caller must still supply the actual backing view length.
pub fn copy_within<T>(values: [T], len: i32, source_start: i32, source_end: i32,
    destination_start: i32) -> bool {
    if (len < 0 || source_start < 0 || source_end < source_start || source_end > len ||
        destination_start < 0) {
        return false;
    }
    let count: i32 = source_end - source_start;
    if (destination_start > len - count) {
        return false;
    }
    if (destination_start > source_start) {
        let remaining: i32 = count;
        while (remaining > 0) {
            remaining -= 1;
            values[destination_start + remaining] = values[source_start + remaining];
        }
    } else {
        let offset: i32 = 0;
        while (offset < count) {
            values[destination_start + offset] = values[source_start + offset];
            offset += 1;
        }
    }
    return true;
}

// Copies the source prefix into a backed destination view. The copied ranges
// must not overlap in memory; use copy_within for overlap in one view.
// Invalid lengths return false without writing. Caller-supplied lengths must
// not exceed the actual backing view lengths.
pub fn copy_nonoverlapping_prefix<T>(destination: [T], destination_len: i32, source: [T],
    source_len: i32) -> bool {
    if (destination_len < 0 || source_len < 0 || source_len > destination_len) {
        return false;
    }
    let offset: i32 = 0;
    while (offset < source_len) {
        destination[offset] = source[offset];
        offset += 1;
    }
    return true;
}

// Copies `count` elements between distinct backed view ranges. The source
// and destination ranges must not overlap in memory; use copy_within for
// overlap. Invalid logical lengths or ranges return false without writing.
// Claimed lengths must fit the actual backing views or native indexing traps.
pub fn copy_nonoverlapping_range<T>(destination: [T], destination_len: i32,
    destination_start: i32, source: [T], source_len: i32, source_start: i32,
    count: i32) -> bool {
    if (destination_len < 0 || source_len < 0 || destination_start < 0 || source_start < 0 ||
        count < 0) {
        return false;
    }
    if (destination_start > destination_len || source_start > source_len) {
        return false;
    }
    if (count > destination_len - destination_start || count > source_len - source_start) {
        return false;
    }
    let offset: i32 = 0;
    while (offset < count) {
        destination[destination_start + offset] = source[source_start + offset];
        offset += 1;
    }
    return true;
}

// Remove one logical element and shift its successors left. A valid index
// returns true; an invalid index returns false without writing. The previous
// final element is outside the new logical length and is unspecified.
pub fn remove_at<T>(values: [T], len: i32, index: i32) -> bool {
    if (index < 0 || index >= len) {
        return false;
    }
    let read: i32 = index + 1;
    while (read < len) {
        values[read - 1] = values[read];
        read += 1;
    }
    return true;
}

// Insert at an index in [0, len], shifting the suffix right by one. A valid
// call needs 0 <= len < capacity, and the backed view must actually contain
// at least capacity writable elements. Invalid logical bounds return false
// without writing. On success the caller's new logical length is len + 1.
// If capacity overstates the physical view, native indexing can trap.
pub fn insert<T>(values: [T], len: i32, capacity: i32, index: i32, value: T) -> bool {
    if (len < 0 || capacity <= 0 || len >= capacity || index < 0 || index > len) {
        return false;
    }
    let cursor: i32 = len;
    while (cursor > index) {
        values[cursor] = values[cursor - 1];
        cursor -= 1;
    }
    values[index] = value;
    return true;
}

// Append within caller-owned capacity; the caller increments len on success.
// Rejected bounds leave the backing view unchanged. A capacity greater than
// the actual view length can trap when the appended element is indexed.
pub fn push<T>(values: [T], len: i32, capacity: i32, value: T) -> bool {
    return insert(values, len, capacity, len, value);
}

pub fn contains<T>(values: [T], len: i32, needle: T) -> bool where T: core::cmp::PartialEq<T> {
    let index: i32 = 0;
    while (index < len) {
        if (T::partial_eq(values[index], needle)) {
            return true;
        }
        index += 1;
    }
    return false;
}

pub fn count<T>(values: [T], len: i32, needle: T) -> i32 where T: core::cmp::PartialEq<T> {
    let index: i32 = 0;
    let total: i32 = 0;
    while (index < len) {
        if (T::partial_eq(values[index], needle)) {
            total += 1;
        }
        index += 1;
    }
    return total;
}

// Returns the first matching index or the caller's fallback.
pub fn index_of_or<T>(values: [T], len: i32, needle: T, fallback: i32) -> i32
    where T: core::cmp::PartialEq<T> {
    let index: i32 = 0;
    while (index < len) {
        if (T::partial_eq(values[index], needle)) {
            return index;
        }
        index += 1;
    }
    return fallback;
}

// Returns the last matching index or the caller's fallback.
pub fn last_index_of_or<T>(values: [T], len: i32, needle: T, fallback: i32) -> i32
    where T: core::cmp::PartialEq<T> {
    if (len <= 0) {
        return fallback;
    }
    let index: i32 = len - 1;
    while (index >= 0) {
        if (T::partial_eq(values[index], needle)) {
            return index;
        }
        index -= 1;
    }
    return fallback;
}

// Negative lengths count as empty. An empty prefix matches every view.
pub fn starts_with<T>(values: [T], len: i32, prefix: [T], prefix_len: i32) -> bool
    where T: core::cmp::PartialEq<T> {
    let total: i32 = nonnegative_len(len);
    let prefix_total: i32 = nonnegative_len(prefix_len);
    if (prefix_total > total) {
        return false;
    }
    let index: i32 = 0;
    while (index < prefix_total) {
        if (!T::partial_eq(values[index], prefix[index])) {
            return false;
        }
        index += 1;
    }
    return true;
}

// Negative lengths count as empty. An empty suffix matches every view.
pub fn ends_with<T>(values: [T], len: i32, suffix: [T], suffix_len: i32) -> bool
    where T: core::cmp::PartialEq<T> {
    let total: i32 = nonnegative_len(len);
    let suffix_total: i32 = nonnegative_len(suffix_len);
    if (suffix_total > total) {
        return false;
    }
    let offset: i32 = total - suffix_total;
    let index: i32 = 0;
    while (index < suffix_total) {
        if (!T::partial_eq(values[offset + index], suffix[index])) {
            return false;
        }
        index += 1;
    }
    return true;
}

// Negative lengths count as empty; equal-length views compare elementwise.
pub fn equals<T>(left: [T], left_len: i32, right: [T], right_len: i32) -> bool
    where T: core::cmp::PartialEq<T> {
    if (nonnegative_len(left_len) != nonnegative_len(right_len)) {
        return false;
    }
    return starts_with(left, left_len, right, right_len);
}

fn matches_at<T>(values: [T], start: i32, needle: [T], needle_len: i32) -> bool
    where T: core::cmp::PartialEq<T> {
    let offset: i32 = 0;
    while (offset < needle_len) {
        if (!T::partial_eq(values[start + offset], needle[offset])) {
            return false;
        }
        offset += 1;
    }
    return true;
}

// Returns the first start index of a contiguous needle, or -1 if absent.
// Negative lengths count as empty; an empty needle matches at zero.
pub fn index_of_subslice<T>(values: [T], len: i32, needle: [T], needle_len: i32) -> i32
    where T: core::cmp::PartialEq<T> {
    let total: i32 = nonnegative_len(len);
    let needle_total: i32 = nonnegative_len(needle_len);
    let start: i32 = 0;
    while (start <= total - needle_total) {
        if (matches_at(values, start, needle, needle_total)) {
            return start;
        }
        start += 1;
    }
    return -1;
}

// The last match of an empty needle is at the end of the logical view.
// Returns -1 when the needle is absent.
pub fn last_index_of_subslice<T>(values: [T], len: i32, needle: [T], needle_len: i32) -> i32
    where T: core::cmp::PartialEq<T> {
    let total: i32 = nonnegative_len(len);
    let needle_total: i32 = nonnegative_len(needle_len);
    let start: i32 = total - needle_total;
    while (start >= 0) {
        if (matches_at(values, start, needle, needle_total)) {
            return start;
        }
        start -= 1;
    }
    return -1;
}

// Keep the first element of each adjacent run, preserving order. Returns the
// new logical length; elements at or beyond it are unspecified. A nonpositive
// len returns zero without writing.
pub fn dedup_adjacent<T>(values: [T], len: i32) -> i32 where T: core::cmp::PartialEq<T> {
    if (len <= 0) {
        return 0;
    }
    let write: i32 = 1;
    let read: i32 = 1;
    while (read < len) {
        let current: T = values[read];
        if (!T::partial_eq(current, values[write - 1])) {
            values[write] = current;
            write += 1;
        }
        read += 1;
    }
    return write;
}

// Remove every matching value from the logical view while preserving the
// order of retained values. Returns the new length; the tail is unspecified.
// A nonpositive len returns zero without writing.
pub fn retain_not_equal<T>(values: [T], len: i32, needle: T) -> i32
    where T: core::cmp::PartialEq<T> {
    let read: i32 = 0;
    let write: i32 = 0;
    while (read < len) {
        let current: T = values[read];
        if (!T::partial_eq(current, needle)) {
            values[write] = current;
            write += 1;
        }
        read += 1;
    }
    return write;
}

// Returns -1, 0, or 1 for lexicographic order. Negative lengths count as
// empty; the first unequal element decides before the lengths are compared.
// Elements use a total order; native floats need core::float_order wrappers.
pub fn compare_lexicographic<T>(left: [T], left_len: i32, right: [T], right_len: i32) -> i32
    where T: core::cmp::Ord<T> {
    let left_total: i32 = nonnegative_len(left_len);
    let right_total: i32 = nonnegative_len(right_len);
    let common: i32 = left_total;
    if (right_total < common) {
        common = right_total;
    }
    let index: i32 = 0;
    while (index < common) {
        if (T::lt(left[index], right[index])) {
            return -1;
        }
        if (T::lt(right[index], left[index])) {
            return 1;
        }
        index += 1;
    }
    if (left_total < right_total) {
        return -1;
    }
    if (left_total > right_total) {
        return 1;
    }
    return 0;
}

pub fn min_or<T>(values: [T], len: i32, fallback: T) -> T where T: core::cmp::Ord<T> {
    if (len <= 0) {
        return fallback;
    }
    let lowest: T = values[0];
    let index: i32 = 1;
    while (index < len) {
        if (T::lt(values[index], lowest)) {
            lowest = values[index];
        }
        index += 1;
    }
    return lowest;
}

pub fn max_or<T>(values: [T], len: i32, fallback: T) -> T where T: core::cmp::Ord<T> {
    if (len <= 0) {
        return fallback;
    }
    let highest: T = values[0];
    let index: i32 = 1;
    while (index < len) {
        if (T::lt(highest, values[index])) {
            highest = values[index];
        }
        index += 1;
    }
    return highest;
}

// Shared ordering engines take an admitted logical View. Ordinary indexing
// retains its native stride, including negative strides. These functions do
// not establish physical backing, lifetime or freedom from interfering aliases.
fn is_sorted_engine<T,C>(values:View<T>,comparator:&C) -> bool
    where C:core::ordering::Comparator<T,T> {
    let index: i32 = 1;
    while (index < values.length) {
        if (core::ordering::is_less(comparator.compare(values.values[values.start+index],values.values[values.start+index-1]))) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn sift_down_by<T,C>(values:View<T>,heap_len:i32,start:i32,comparator:&C)
    where C:core::ordering::Comparator<T,T> {
    let root: i32 = start;
    // A left child exists before doubling root, so neither child arithmetic
    // nor the admitted view's start+relative-index addition can overflow.
    while (root < heap_len / 2) {
        let child: i32 = root * 2 + 1;
        let largest: i32 = root;
        if (core::ordering::is_less(comparator.compare(values.values[values.start+largest],values.values[values.start+child]))) {
            largest = child;
        }
        if (child + 1 < heap_len && core::ordering::is_less(comparator.compare(values.values[values.start+largest],values.values[values.start+child+1]))) {
            largest = child + 1;
        }
        if (largest == root) {
            return;
        }
        let previous: T = values.values[values.start+root];
        values.values[values.start+root] = values.values[values.start+largest];
        values.values[values.start+largest] = previous;
        root = largest;
    }
}

fn sort_engine<T,C>(values:View<T>,comparator:&C) -> i32
    where C:core::ordering::Comparator<T,T> {
    let start: i32 = values.length / 2;
    while (start > 0) {
        start -= 1;
        sift_down_by<T,C>(values,values.length,start,comparator);
    }
    let remaining: i32 = values.length;
    while (remaining > 1) {
        remaining -= 1;
        let previous: T = values.values[values.start];
        values.values[values.start] = values.values[values.start+remaining];
        values.values[values.start+remaining] = previous;
        sift_down_by<T,C>(values,remaining,0,comparator);
    }
    return values.length;
}

fn selection_swap<T>(values:View<T>,left:i32,right:i32) {
    let previous:T = values.values[values.start+left];
    values.values[values.start+left] = values.values[values.start+right];
    values.values[values.start+right] = previous;
}

// Only groups of at most five are sorted. Each step exchanges whole shallow
// values, retaining one permutation without cloning or retiring any payload.
fn selection_sort_small<T,C>(values:View<T>,low:i32,high:i32,comparator:&C)
    where C:core::ordering::Comparator<T,T> {
    let index:i32 = low+1;
    while(index<high) {
        let position:i32 = index;
        let moving:bool = true;
        while(position>low && moving) {
            if(core::ordering::is_less(comparator.compare(values.values[values.start+position],values.values[values.start+position-1]))) {
                selection_swap<T>(values,position,position-1);
                position-=1;
            } else {
                moving=false;
            }
        }
        index+=1;
    }
}

// Deterministic groups-of-five selection on an admitted nonempty View/rank.
// Phase zero selects its median prefix; phase one partitions around the child
// result. Only median descent pushes a frame; partition descent reuses it.
fn selection_engine<T,C>(values:View<T>,nth:i32,comparator:&C) -> i32
    where C:core::ordering::Comparator<T,T> {
    let lows:[i32;16] = [0;16];
    let highs:[i32;16] = [0;16];
    let targets:[i32;16] = [0;16];
    let phases:[i32;16] = [0;16];
    let depth:i32 = 0;
    highs[0]=values.length; targets[0]=nth;
    let completed:i32 = 0;
    while(depth>=0) {
        let low:i32 = lows[depth];
        let high:i32 = highs[depth];
        let target:i32 = targets[depth];
        if(phases[depth]==0) {
            let length:i32 = high-low;
            if(length<=5) {
                selection_sort_small<T,C>(values,low,high,comparator);
                completed=target;
                depth-=1;
            } else {
                let group:i32 = low;
                let prefix:i32 = low;
                while(group<high) {
                    let group_length:i32 = high-group;
                    if(group_length>5) { group_length=5; }
                    let group_end:i32 = group+group_length;
                    selection_sort_small<T,C>(values,group,group_end,comparator);
                    let middle:i32 = group+group_length/2;
                    selection_swap<T>(values,prefix,middle);
                    prefix+=1;
                    group=group_end;
                }
                // prefix-low is ceil(length/5), computed without length+4.
                // From i32::MAX, median-only descent needs at most fourteen
                // active frames. Check the child slot before incrementing.
                assert(depth<15);
                phases[depth]=1;
                depth+=1;
                lows[depth]=low; highs[depth]=prefix;
                targets[depth]=low+(prefix-low)/2; phases[depth]=0;
            }
        } else {
            // Keep the selected pivot outside every scan/swap range until
            // insertion into the equal band. Do not retain an owning copy.
            let pivot:i32 = high-1;
            selection_swap<T>(values,completed,pivot);
            let less:i32 = low;
            let scan:i32 = low;
            let greater:i32 = pivot;
            while(scan<greater) {
                let relation:core::ordering::Ordering = comparator.compare(values.values[values.start+scan],values.values[values.start+pivot]);
                if(core::ordering::is_less(relation)) {
                    selection_swap<T>(values,less,scan);
                    less+=1; scan+=1;
                } else {
                    if(core::ordering::is_greater(relation)) {
                        greater-=1;
                        selection_swap<T>(values,scan,greater);
                    } else {
                        scan+=1;
                    }
                }
            }
            selection_swap<T>(values,greater,pivot);
            let equal_end:i32 = greater+1;
            // The protected pivot makes this band nonempty even when a
            // returning comparator is inconsistent. A tail range shrinks.
            if(target<less) {
                highs[depth]=less; phases[depth]=0;
            } else {
                if(target>=equal_end) {
                    lows[depth]=equal_end; phases[depth]=0;
                } else {
                    completed=target;
                    depth-=1;
                }
            }
        }
    }
    return completed;
}

fn lower_bound_engine<T,K,C>(values:View<T>,needle:K,comparator:&C) -> i32
    where C:core::ordering::Comparator<T,K> {
    let low: i32 = 0;
    let high: i32 = values.length;
    while (low < high) {
        let middle: i32 = low + (high - low) / 2;
        if (core::ordering::is_less(comparator.compare(values.values[values.start+middle],needle))) {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    return low;
}

fn upper_bound_engine<T,K,C>(values:View<T>,needle:K,comparator:&C) -> i32
    where C:core::ordering::Comparator<T,K> {
    let low: i32 = 0;
    let high: i32 = values.length;
    while (low < high) {
        let middle: i32 = low + (high - low) / 2;
        if (!core::ordering::is_greater(comparator.compare(values.values[values.start+middle],needle))) {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    return low;
}

fn binary_search_first_engine<T,K,C>(values:View<T>,needle:K,comparator:&C) -> core::option::Option<i32>
    where C:core::ordering::Comparator<T,K> {
    let index: i32 = lower_bound_engine<T,K,C>(values,needle,comparator);
    if (index < values.length && core::ordering::is_equal(comparator.compare(values.values[values.start+index],needle))) {
        return core::option::Some(index);
    }
    return core::option::None();
}

fn binary_search_last_engine<T,K,C>(values:View<T>,needle:K,comparator:&C) -> core::option::Option<i32>
    where C:core::ordering::Comparator<T,K> {
    let after: i32 = upper_bound_engine<T,K,C>(values,needle,comparator);
    if (after > 0 && core::ordering::is_equal(comparator.compare(values.values[values.start+after-1],needle))) {
        return core::option::Some(after-1);
    }
    return core::option::None();
}

fn partition_lt_engine<T,K,C>(values:View<T>,pivot:K,comparator:&C) -> i32
    where C:core::ordering::Comparator<T,K> {
    let boundary: i32 = 0;
    let index: i32 = 0;
    while (index < values.length) {
        if (core::ordering::is_less(comparator.compare(values.values[values.start+index],pivot))) {
            let previous: T = values.values[values.start+boundary];
            values.values[values.start+boundary] = values.values[values.start+index];
            values.values[values.start+index] = previous;
            boundary += 1;
        }
        index += 1;
    }
    return boundary;
}

// Checked entry points validate the complete logical range before any read,
// mutation or callback. Indices are relative to the selected View. Backing and
// context must remain live and unchanged through aliases; no clone/Destroy or
// allocation occurs. Sorting is unstable; exact comparison traces are not promised.
pub fn sort_unstable_by<T,C>(values:View<T>,comparator:&C) -> core::result::Result<i32,ViewError>
    where C:core::ordering::Comparator<T,T> {
    if(!view_valid<T>(values)) { return core::result::Err(ViewError::Bounds); }
    return core::result::Ok(sort_engine<T,C>(values,comparator));
}
// Select one zero-based rank and partition its surroundings without sorting
// either side. The returned one-element View aliases its exact stored slot.
// Equivalent values have no stable representative. Physical backing, lifetime
// and noninterference remain caller obligations; no cleanup is transferred.
pub fn select_nth_unstable_by<T,C>(values:View<T>,nth:i32,comparator:&C) -> core::result::Result<View<T>,ViewError>
    where C:core::ordering::Comparator<T,T> {
    if(!view_valid<T>(values) || nth<0 || nth>=values.length) {
        return core::result::Err(ViewError::Bounds);
    }
    let selected_index:i32 = selection_engine<T,C>(values,nth,comparator);
    let selected:View<T> = View { values:values.values,start:values.start+selected_index,length:1 };
    return core::result::Ok(selected);
}
pub fn select_nth_unstable<T>(values:View<T>,nth:i32) -> core::result::Result<View<T>,ViewError>
    where T:core::cmp::Ord<T> {
    if(!view_valid<T>(values) || nth<0 || nth>=values.length) {
        return core::result::Err(ViewError::Bounds);
    }
    let comparator:core::ordering::Natural<T> = core::ordering::Natural {};
    let selected_index:i32 = selection_engine<T,core::ordering::Natural<T>>(values,nth,comparator.borrow());
    let selected:View<T> = View { values:values.values,start:values.start+selected_index,length:1 };
    return core::result::Ok(selected);
}
pub fn is_sorted_by<T,C>(values:View<T>,comparator:&C) -> core::result::Result<bool,ViewError>
    where C:core::ordering::Comparator<T,T> {
    if(!view_valid<T>(values)) { return core::result::Err(ViewError::Bounds); }
    return core::result::Ok(is_sorted_engine<T,C>(values,comparator));
}
// Each query requires all Less, then Equal, then Greater classes. Bounds may
// equal length; no scan is made to validate this ordering precondition.
pub fn lower_bound_by<T,K,C>(values:View<T>,needle:K,comparator:&C) -> core::result::Result<i32,ViewError>
    where C:core::ordering::Comparator<T,K> {
    if(!view_valid<T>(values)) { return core::result::Err(ViewError::Bounds); }
    return core::result::Ok(lower_bound_engine<T,K,C>(values,needle,comparator));
}
pub fn upper_bound_by<T,K,C>(values:View<T>,needle:K,comparator:&C) -> core::result::Result<i32,ViewError>
    where C:core::ordering::Comparator<T,K> {
    if(!view_valid<T>(values)) { return core::result::Err(ViewError::Bounds); }
    return core::result::Ok(upper_bound_engine<T,K,C>(values,needle,comparator));
}
pub fn binary_search_first_by<T,K,C>(values:View<T>,needle:K,comparator:&C) -> core::result::Result<core::option::Option<i32>,ViewError>
    where C:core::ordering::Comparator<T,K> {
    if(!view_valid<T>(values)) { return core::result::Err(ViewError::Bounds); }
    let found:core::option::Option<i32> =binary_search_first_engine<T,K,C>(values,needle,comparator);
    return core::result::Ok(found);
}
pub fn binary_search_last_by<T,K,C>(values:View<T>,needle:K,comparator:&C) -> core::result::Result<core::option::Option<i32>,ViewError>
    where C:core::ordering::Comparator<T,K> {
    if(!view_valid<T>(values)) { return core::result::Err(ViewError::Bounds); }
    let found:core::option::Option<i32> =binary_search_last_engine<T,K,C>(values,needle,comparator);
    return core::result::Ok(found);
}
// Less values precede all others. Only the permutation and boundary are
// promised; no relative ordering, tie layout or rollback on callback traps.
pub fn partition_lt_by<T,K,C>(values:View<T>,pivot:K,comparator:&C) -> core::result::Result<i32,ViewError>
    where C:core::ordering::Comparator<T,K> {
    if(!view_valid<T>(values)) { return core::result::Err(ViewError::Bounds); }
    return core::result::Ok(partition_lt_engine<T,K,C>(values,pivot,comparator));
}

// Raw slice/count Ord entry points preserve nonpositive-as-empty semantics
// and delegate to the same engines. Physical backing remains a precondition.
pub fn is_sorted<T>(values:[T],len:i32) -> bool where T:core::cmp::Ord<T> {
    let selected:View<T> =View { values:values,start:0,length:nonnegative_len(len) };
    let comparator:core::ordering::Natural<T> =core::ordering::Natural {};
    return is_sorted_engine<T,core::ordering::Natural<T>>(selected,comparator.borrow());
}
// In-place ascending heapsort; not stable. Return the number sorted.
pub fn sort<T>(values:[T],len:i32) -> i32 where T:core::cmp::Ord<T> {
    let selected:View<T> =View { values:values,start:0,length:nonnegative_len(len) };
    let comparator:core::ordering::Natural<T> =core::ordering::Natural {};
    return sort_engine<T,core::ordering::Natural<T>>(selected,comparator.borrow());
}
// Nondecreasing input; first not-Less or first Greater, respectively.
pub fn lower_bound<T>(values:[T],len:i32,needle:T) -> i32 where T:core::cmp::Ord<T> {
    let selected:View<T> =View { values:values,start:0,length:nonnegative_len(len) };
    let comparator:core::ordering::Natural<T> =core::ordering::Natural {};
    return lower_bound_engine<T,T,core::ordering::Natural<T>>(selected,needle,comparator.borrow());
}
pub fn upper_bound<T>(values:[T],len:i32,needle:T) -> i32 where T:core::cmp::Ord<T> {
    let selected:View<T> =View { values:values,start:0,length:nonnegative_len(len) };
    let comparator:core::ordering::Natural<T> =core::ordering::Natural {};
    return upper_bound_engine<T,T,core::ordering::Natural<T>>(selected,needle,comparator.borrow());
}
// Nondecreasing input; select the exact first/last match or fallback.
pub fn binary_search_first_or<T>(values:[T],len:i32,needle:T,fallback:i32) -> i32
    where T:core::cmp::Ord<T> {
    let selected:View<T> =View { values:values,start:0,length:nonnegative_len(len) };
    let comparator:core::ordering::Natural<T> =core::ordering::Natural {};
    let found:core::option::Option<i32> =binary_search_first_engine<T,T,core::ordering::Natural<T>>(selected,needle,comparator.borrow());
    return found.unwrap_or(fallback);
}
pub fn binary_search_last_or<T>(values:[T],len:i32,needle:T,fallback:i32) -> i32
    where T:core::cmp::Ord<T> {
    let selected:View<T> =View { values:values,start:0,length:nonnegative_len(len) };
    let comparator:core::ordering::Natural<T> =core::ordering::Natural {};
    let found:core::option::Option<i32> =binary_search_last_engine<T,T,core::ordering::Natural<T>>(selected,needle,comparator.borrow());
    return found.unwrap_or(fallback);
}
// Unstable Less/non-Less partition of the first nonnegative_len(len) values.
pub fn partition_lt<T>(values:[T],len:i32,pivot:T) -> i32 where T:core::cmp::Ord<T> {
    let selected:View<T> =View { values:values,start:0,length:nonnegative_len(len) };
    let comparator:core::ordering::Natural<T> =core::ordering::Natural {};
    return partition_lt_engine<T,T,core::ordering::Natural<T>>(selected,pivot,comparator.borrow());
}

// Adds every element to `initial` with the type's saturating addition, so
// integer totals clamp at the type's limits instead of wrapping. A
// nonpositive len returns `initial`.
pub fn sum<T>(values: [T], len: i32, initial: T) -> T where T: core::ops::SaturatingAdd<T> {
    let total: T = initial;
    let index: i32 = 0;
    while (index < len) {
        total = T::saturating_add(total, values[index]);
        index += 1;
    }
    return total;
}
