// Allocation-free algorithms over a view of any element type. The caller
// supplies the view length because the source language cannot read slice
// metadata yet. A length larger than the actual view is invalid; native
// indexing traps if it reaches beyond the view. Functions below specify
// whether a negative length is treated as empty or rejected without mutation.
//
// Searching needs core::cmp::PartialEq. Ordering uses a borrowed Comparator or
// the type's global Ord through Natural. Ordered functions require a lawful
// total order. Native float membership follows IEEE equality; sorting float
// encodings needs core::float_order wrappers or an explicit total comparator.
module core::slice;
import core::iter_state;

import core::cmp;
import core::mem;
import core::ops;
import core::option;
import core::ordering;
import core::result;

// Length-bearing borrowed views. Construction checks logical bounds; until
// slice length projection exists, the caller must supply backed elements.
// Copies alias the same elements. No allocation, cloning or destruction occurs.
// See docs/stdlib-slice-views.md for contracts, lifetime rules and evidence.
pub enum ViewError { Bounds, InvalidSize }
pub struct View<T> { values: [T], start: i32, length: i32 }
pub struct Iter<T> { values: [T], front: i32, back: i32 }
pub struct Chunks<T> { values: [T], position: i32, end: i32, width: i32 }
pub struct Windows<T> { values: [T], position: i32, end: i32, width: i32 }

// Forward predicate cursors borrow the original descriptor and callback.
// Copies fork their positions but share backing and predicate context. Keep
// both alive and stable; no clone, allocation or cleanup authority is implied.
// Iterator impls and their Mapper bounds live in core::iter to avoid a cycle.
pub struct Split<T,P> { values: [T], predicate: &P, position: i32, end: i32, completion: core::iter_state::Completion }
pub struct SplitInclusive<T,P> { values: [T], predicate: &P, position: i32, end: i32 }
pub struct ChunkBy<T,P> { values: [T], predicate: &P, position: i32, end: i32 }

// Check integer metadata only, never backing or callbacks. Physical backing,
// lifetime and freedom from interfering aliases remain caller obligations.
fn view_valid<T>(values: View<T>) -> bool {
    if (values.start < 0 || values.length < 0) { return false; }
    return values.start <= 2147483647 - values.length;
}

// The element count of a slice, or of an array passed as one, as the i32
// that this library's counts and indexes use.
pub fn length<T>(values: [T]) -> i32 { return slice_len(values) as i32; }

// A View of every element of a slice, or of an array passed as one.
pub fn whole<T>(values: [T]) -> View<T> {
    return View { values: values, start: 0, length: slice_len(values) as i32 };
}

pub fn view<T>(values: [T], count: i32) -> core::result::Result<View<T>, ViewError> {
    return view_range(values, 0, count);
}

pub fn view_range<T>(values: [T], start: i32, count: i32) -> core::result::Result<View<T>, ViewError> {
    let selected: View<T> = View { values: values, start: start, length: count };
    if (!view_valid<T>(selected)) { return core::result::Err(ViewError::Bounds); }
    return core::result::Ok(selected);
}

// Exclude separators, retaining leading, adjacent and final empty segments.
// Empty input yields one empty View. Construction never invokes the predicate;
// iteration requires P:core::function::Mapper<T,bool> through core::iter.
pub fn split<T,P>(values: View<T>, predicate: &P) -> core::result::Result<Split<T,P>,ViewError> {
    if (!view_valid<T>(values)) { return core::result::Err(ViewError::Bounds); }
    let cursor: Split<T,P> = Split { values: values.values, predicate: predicate, position: values.start, end: values.start + values.length, completion: core::iter_state::completion_start() };
    return core::result::Ok(cursor);
}

// Include each separator in its preceding segment. Empty input and a terminal
// separator add no empty segment. The Mapper bound belongs to iteration.
pub fn split_inclusive<T,P>(values: View<T>, predicate: &P) -> core::result::Result<SplitInclusive<T,P>,ViewError> {
    if (!view_valid<T>(values)) { return core::result::Err(ViewError::Bounds); }
    let cursor: SplitInclusive<T,P> = SplitInclusive { values: values.values, predicate: predicate, position: values.start, end: values.start + values.length };
    return core::result::Ok(cursor);
}

// Join adjacent elements while the predicate returns true; false starts the
// next nonempty run. No equivalence law is needed. Iteration requires
// P:core::function::Mapper<core::pair::Pair<T,T>,bool>; construction invokes none.
pub fn chunk_by<T,P>(values: View<T>, predicate: &P) -> core::result::Result<ChunkBy<T,P>,ViewError> {
    if (!view_valid<T>(values)) { return core::result::Err(ViewError::Bounds); }
    let cursor: ChunkBy<T,P> = ChunkBy { values: values.values, predicate: predicate, position: values.start, end: values.start + values.length };
    return core::result::Ok(cursor);
}

pub impl<T> View<T> {
    pub fn len(&self) -> i32 { return self.length; }
    pub fn is_empty(&self) -> bool { return self.length == 0; }
    pub fn get(&self, index: i32) -> core::option::Option<T> {
        if (index < 0 || index >= self.length) { return core::option::None(); }
        return core::option::Some(self.values[self.start + index]);
    }
    pub fn first(&self) -> core::option::Option<T> { return self.get(0); }
    pub fn last(&self) -> core::option::Option<T> { return self.get(self.length - 1); }
    // Half-open indices relative to this view. Empty subviews are valid.
    pub fn subview(&self, start: i32, end: i32) -> core::result::Result<View<T>, ViewError> {
        if (start < 0 || end < start || end > self.length) { return core::result::Err(ViewError::Bounds); }
        return core::result::Ok(View { values: self.values, start: self.start + start, length: end - start });
    }
    // Return the displaced shallow value. Invalid indices leave storage intact.
    pub fn try_set(&self, index: i32, value: T) -> core::result::Result<T, ViewError> {
        if (index < 0 || index >= self.length) { return core::result::Err(ViewError::Bounds); }
        let previous: T = self.values[self.start + index];
        self.values[self.start + index] = value;
        return core::result::Ok(previous);
    }
    // Copy within this view, including overlap. Return the number copied.
    pub fn copy_within(&self, start: i32, end: i32, destination: i32) -> core::result::Result<i32, ViewError> {
        if (start < 0 || end < start || end > self.length || destination < 0) {
            return core::result::Err(ViewError::Bounds);
        }
        let count: i32 = end - start;
        if (destination > self.length - count) { return core::result::Err(ViewError::Bounds); }
        copy_within(self.values, self.start + self.length, self.start + start, self.start + end, self.start + destination);
        return core::result::Ok(count);
    }
    // Returns the number of swaps. Only this view's elements are modified.
    pub fn reverse(&self) -> i32 { return reverse_segment(self.values, self.start, self.start + self.length); }
    pub fn fill(&self, value: T) -> i32 {
        let index: i32 = 0;
        while (index < self.length) { self.values[self.start + index] = value; index += 1; }
        return self.length;
    }
    pub fn iter(&self) -> Iter<T> { return Iter { values: self.values, front: self.start, back: self.start + self.length }; }
    // Consecutive nonoverlapping chunks; a final short chunk is included.
    pub fn chunks(&self, width: i32) -> core::result::Result<Chunks<T>, ViewError> {
        if (width <= 0) { return core::result::Err(ViewError::InvalidSize); }
        return core::result::Ok(Chunks { values: self.values, position: self.start, end: self.start + self.length, width: width });
    }
    // All overlapping windows of exactly width elements, advancing by one.
    pub fn windows(&self, width: i32) -> core::result::Result<Windows<T>, ViewError> {
        if (width <= 0) { return core::result::Err(ViewError::InvalidSize); }
        return core::result::Ok(Windows { values: self.values, position: self.start, end: self.start + self.length, width: width });
    }
}

// Cursors are fused and can be copied to fork their positions. next and
// next_back implement the shared traits in core::iter; import it to use them.
// next/next_back read current backing values, not a snapshot of the elements.
pub impl<T> Iter<T> {
    pub fn borrow(&self) -> &Iter<T> { return self; }
    pub fn remaining(&self) -> i32 { return self.back - self.front; }
    // Discard up to count elements without reading them; return actual progress.
    // Negative counts fail without changing the cursor.
    pub fn advance(&self, count: i32) -> core::result::Result<i32, ViewError> {
        if (count < 0) { return core::result::Err(ViewError::Bounds); }
        let skipped: i32 = count;
        if (skipped > self.back - self.front) { skipped = self.back - self.front; }
        self.front += skipped; return core::result::Ok(skipped);
    }
    pub fn advance_back(&self, count: i32) -> core::result::Result<i32, ViewError> {
        if (count < 0) { return core::result::Err(ViewError::Bounds); }
        let skipped: i32 = count;
        if (skipped > self.back - self.front) { skipped = self.back - self.front; }
        self.back -= skipped; return core::result::Ok(skipped);
    }
}
pub impl<T> Chunks<T> {
    pub fn borrow(&self) -> &Chunks<T> { return self; }
    pub fn remaining(&self) -> i32 {
        let count: i32 = self.end - self.position;
        let full: i32 = count / self.width;
        if (count % self.width != 0) { full += 1; }
        return full;
    }
}
pub impl<T> Windows<T> {
    pub fn borrow(&self) -> &Windows<T> { return self; }
    pub fn remaining(&self) -> i32 {
        let count: i32 = self.end - self.position;
        if (count < self.width) { return 0; }
        return count - self.width + 1;
    }
}

pub impl<T,P> Split<T,P> {
    pub fn borrow(&self) -> &Split<T,P> { return self; }
}
pub impl<T,P> SplitInclusive<T,P> {
    pub fn borrow(&self) -> &SplitInclusive<T,P> { return self; }
}
pub impl<T,P> ChunkBy<T,P> {
    pub fn borrow(&self) -> &ChunkBy<T,P> { return self; }
}

fn nonnegative_len(len: i32) -> i32 {
    if (len <= 0) {
        return 0;
    }
    return len;
}

pub fn first<T>(values: [T]) -> T {
    // Native indexing traps if values is empty.
    return values[0];
}

pub fn first_or<T>(values: [T], len: i32, fallback: T) -> T {
    if (len <= 0) {
        return fallback;
    }
    return values[0];
}

pub fn last_or<T>(values: [T], len: i32, fallback: T) -> T {
    if (len <= 0) {
        return fallback;
    }
    return values[len - 1];
}

pub fn get_or<T>(values: [T], len: i32, index: i32, fallback: T) -> T {
    if (index < 0 || index >= len) {
        return fallback;
    }
    return values[index];
}

// Returns false and leaves the view unchanged for an out-of-range index.
pub fn set<T>(values: [T], len: i32, index: i32, value: T) -> bool {
    if (index < 0 || index >= len) {
        return false;
    }
    values[index] = value;
    return true;
}

// Returns false and leaves the view unchanged if either index is invalid.
pub fn swap<T>(values: [T], len: i32, left: i32, right: i32) -> bool {
    if (left < 0 || right < 0 || left >= len || right >= len) {
        return false;
    }
    let previous: T = values[left];
    values[left] = values[right];
    values[right] = previous;
    return true;
}

// Returns the number of elements written; nonpositive lengths write nothing.
pub fn fill<T>(values: [T], len: i32, value: T) -> i32 {
    if (len <= 0) {
        return 0;
    }
    fill_run(values, 0, len, value);
    return len;
}

fn reverse_segment<T>(values: [T], start: i32, end: i32) -> i32 {
    let left: i32 = start;
    let right: i32 = end - 1;
    let swaps: i32 = 0;
    while (left < right) {
        let previous: T = values[left];
        values[left] = values[right];
        values[right] = previous;
        left += 1;
        right -= 1;
        swaps += 1;
    }
    return swaps;
}

// Returns the number of swaps performed.
pub fn reverse_in_place<T>(values: [T], len: i32) -> i32 {
    if (len <= 1) {
        return 0;
    }
    return reverse_segment(values, 0, len);
}

// Rotate the first len elements by amount positions. Amount must be in
// [0, len]; invalid arguments return false without modifying the view.
pub fn rotate_left<T>(values: [T], len: i32, amount: i32) -> bool {
    if (len < 0 || amount < 0 || amount > len) {
        return false;
    }
    if (amount == 0 || amount == len) {
        return true;
    }
    reverse_segment(values, 0, amount);
    reverse_segment(values, amount, len);
    reverse_segment(values, 0, len);
    return true;
}

pub fn rotate_right<T>(values: [T], len: i32, amount: i32) -> bool {
    if (len < 0 || amount < 0 || amount > len) {
        return false;
    }
    return rotate_left(values, len, len - amount);
}

// Copies [source_start, source_end) to destination_start within one view.
// Overlap is supported. Bounds invalid relative to `len` return false without
// writing; the caller must still supply the actual backing view length.
pub fn copy_within<T>(values: [T], len: i32, source_start: i32, source_end: i32,
    destination_start: i32) -> bool {
    if (len < 0 || source_start < 0 || source_end < source_start || source_end > len ||
        destination_start < 0) {
        return false;
    }
    let count: i32 = source_end - source_start;
    if (destination_start > len - count) {
        return false;
    }
    move_run(values, destination_start, values, source_start, count);
    return true;
}

// Copies the source prefix into a backed destination view. The copied ranges
// must not overlap in memory; use copy_within for overlap in one view.
// Invalid lengths return false without writing. Caller-supplied lengths must
// not exceed the actual backing view lengths.
pub fn copy_nonoverlapping_prefix<T>(destination: [T], destination_len: i32, source: [T],
    source_len: i32) -> bool {
    if (destination_len < 0 || source_len < 0 || source_len > destination_len) {
        return false;
    }
    move_run(destination, 0, source, 0, source_len);
    return true;
}

// Copies `count` elements between distinct backed view ranges. The source
// and destination ranges must not overlap in memory; use copy_within for
// overlap. Invalid logical lengths or ranges return false without writing.
// Claimed lengths must fit the actual backing views or native indexing traps.
pub fn copy_nonoverlapping_range<T>(destination: [T], destination_len: i32,
    destination_start: i32, source: [T], source_len: i32, source_start: i32,
    count: i32) -> bool {
    if (destination_len < 0 || source_len < 0 || destination_start < 0 || source_start < 0 ||
        count < 0) {
        return false;
    }
    if (destination_start > destination_len || source_start > source_len) {
        return false;
    }
    if (count > destination_len - destination_start || count > source_len - source_start) {
        return false;
    }
    move_run(destination, destination_start, source, source_start, count);
    return true;
}

// Bulk moves. Packed views (positive stride: u8 is 1, i32 is 4) hold a run
// of consecutive elements in one ascending byte range from the data pointer.
// When both views are packed with one stride, the run spans at least 64
// bytes, and raw [u64] and [u8] views have strides -8 and +1, bulk operations
// move the run eight bytes at a time through raw [u64] views, then a byte
// tail. Everything else copies elements. That includes word views (negative
// stride: one or more descending eight-byte words per element), where an
// element copy already moves whole words and measured no slower than a raw
// word loop. Before any raw access they index each run's first and last
// element through the caller's view, so an overstated length still traps as
// native indexing does. See docs/stdlib-slice-bulk.md.
fn bulk_layout() -> bool {
    let nowhere: ptr = 0;
    let words: [u64] = slice_from_raw_parts(nowhere, 0);
    let bytes: [u8] = slice_from_raw_parts(nowhere, 0);
    return slice_stride(words) == -8 && slice_stride(bytes) == 1;
}

// The address of element `start` of a packed view.
fn run_low<T>(values: [T], stride: isize, start: i32) -> ptr {
    return core::mem::i32_slice_data_ptr(values) + (stride as usize) * (start as usize);
}

// The words starting at `low`. Raw [u64] views run downward, so the word
// k * 8 bytes above `low` is element words - 1 - k.
fn word_view(low: ptr, words: i32) -> [u64] {
    if (words == 0) { return slice_from_raw_parts(low, 0); }
    return slice_from_raw_parts(low + ((words - 1) as usize) * 8, words);
}

// Copy `bytes` bytes from `from` to `to`. Overlapping ranges need high_first
// exactly when `to` lies above `from`; each step loads before it stores.
fn move_bytes(to: ptr, from: ptr, bytes: usize, high_first: bool) {
    let words: i32 = (bytes >> 3) as i32; let tail: i32 = (bytes & 7) as i32;
    let body: usize = bytes - (bytes & 7);
    let t: [u64] = word_view(to, words); let f: [u64] = word_view(from, words);
    let tt: [u8] = slice_from_raw_parts(to + body, tail); let tf: [u8] = slice_from_raw_parts(from + body, tail);
    if (high_first) {
        let k: i32 = tail - 1;
        while (k >= 0) { tt[k] = tf[k]; k -= 1; }
        let i: i32 = 0;
        while (i < words - 3) { t[i] = f[i]; t[i + 1] = f[i + 1]; t[i + 2] = f[i + 2]; t[i + 3] = f[i + 3]; i += 4; }
        while (i < words) { t[i] = f[i]; i += 1; }
    } else {
        let i: i32 = words - 1;
        while (i >= 3) { t[i] = f[i]; t[i - 1] = f[i - 1]; t[i - 2] = f[i - 2]; t[i - 3] = f[i - 3]; i -= 4; }
        while (i >= 0) { t[i] = f[i]; i -= 1; }
        let k: i32 = 0;
        while (k < tail) { tt[k] = tf[k]; k += 1; }
    }
}

fn fill_words(low: ptr, words: i32, word: u64) {
    let t: [u64] = word_view(low, words); let i: i32 = 0;
    while (i < words - 3) { t[i] = word; t[i + 1] = word; t[i + 2] = word; t[i + 3] = word; i += 4; }
    while (i < words) { t[i] = word; i += 1; }
}

// Exchange two byte ranges that do not overlap.
fn swap_bytes(left: ptr, right: ptr, bytes: usize) {
    let words: i32 = (bytes >> 3) as i32; let tail: i32 = (bytes & 7) as i32;
    let body: usize = bytes - (bytes & 7);
    let a: [u64] = word_view(left, words); let b: [u64] = word_view(right, words);
    let i: i32 = 0;
    while (i < words) { let held: u64 = a[i]; a[i] = b[i]; b[i] = held; i += 1; }
    let ta: [u8] = slice_from_raw_parts(left + body, tail); let tb: [u8] = slice_from_raw_parts(right + body, tail);
    let k: i32 = 0;
    while (k < tail) { let byte: u8 = ta[k]; ta[k] = tb[k]; tb[k] = byte; k += 1; }
}

// A run of `count` elements in two views with these strides moves as words.
// Below 64 bytes the fixed cost (about 100 ns) outweighs the saving.
fn bulk_run(stride: isize, other: isize, count: i32) -> bool {
    return stride == other && stride > 0 && (stride as usize) * (count as usize) >= 64 && bulk_layout();
}

// Copy `count` elements of `from` at from_start to `to` at to_start as if
// through a temporary, so runs in one view may overlap. Callers check the
// logical bounds; native indexing traps if a view does not back its run.
fn move_run<T>(to: [T], to_start: i32, from: [T], from_start: i32, count: i32) {
    if (count <= 0) { return; }
    let stride: isize = slice_stride(from);
    if (bulk_run(stride, slice_stride(to), count)) {
        let edge: T = from[from_start]; edge = from[from_start + count - 1];
        edge = to[to_start]; edge = to[to_start + count - 1];
        // In a packed view a higher index is a higher address.
        let bytes: usize = (stride as usize) * (count as usize);
        move_bytes(run_low(to, stride, to_start), run_low(from, stride, from_start), bytes, to_start > from_start);
        return;
    }
    if (to_start > from_start) {
        let i: i32 = to_start + count; let j: i32 = from_start + count;
        while (i > to_start) { i -= 1; j -= 1; to[i] = from[j]; }
    } else {
        let i: i32 = to_start; let j: i32 = from_start; let end: i32 = to_start + count;
        while (i < end) { to[i] = from[j]; i += 1; j += 1; }
    }
}

// Write `value` to [start, start + count). In a packed view whose stride
// divides 8 (u8, packed i32), write the run's first word through the view,
// then repeat that word and finish the tail through the view.
fn fill_run<T>(values: [T], start: i32, count: i32, value: T) {
    if (count <= 0) { return; }
    let stride: isize = slice_stride(values);
    if (!bulk_run(stride, stride, count) || 8 % (stride as usize) != 0) {
        let index: i32 = start;
        while (index < start + count) { values[index] = value; index += 1; }
        return;
    }
    let size: usize = stride as usize;
    let edge: T = values[start + count - 1];
    let low: ptr = run_low(values, stride, start);
    let index: i32 = start;
    while (index < start + ((8 / size) as i32)) { values[index] = value; index += 1; }
    let first: [u64] = slice_from_raw_parts(low, 1);
    let words: i32 = ((size * (count as usize)) >> 3) as i32;
    fill_words(low, words, first[0]);
    index = start + ((((words as usize) * 8) / size) as i32);
    while (index < start + count) { values[index] = value; index += 1; }
}

fn swap_run<T>(left: [T], left_start: i32, right: [T], right_start: i32, count: i32) {
    if (count <= 0) { return; }
    let stride: isize = slice_stride(left);
    if (bulk_run(stride, slice_stride(right), count)) {
        let edge: T = left[left_start]; edge = left[left_start + count - 1];
        edge = right[right_start]; edge = right[right_start + count - 1];
        let bytes: usize = (stride as usize) * (count as usize);
        swap_bytes(run_low(left, stride, left_start), run_low(right, stride, right_start), bytes);
        return;
    }
    let offset: i32 = 0;
    while (offset < count) {
        let held: T = left[left_start + offset];
        left[left_start + offset] = right[right_start + offset];
        right[right_start + offset] = held;
        offset += 1;
    }
}

// Copies all of `source` over `destination`, eight bytes at a time where the
// layouts allow. Lengths must be equal and the views must not overlap in
// memory (use copy_within inside one view). Negative or unequal lengths
// return false without writing.
pub fn copy_from_slice<T>(destination: [T], destination_len: i32, source: [T], source_len: i32) -> bool {
    if (destination_len < 0 || destination_len != source_len) {
        return false;
    }
    move_run(destination, 0, source, 0, source_len);
    return true;
}

// Exchanges every element of two equal-length views that do not overlap in
// memory. Negative or unequal lengths return false without writing.
pub fn swap_with_slice<T>(left: [T], left_len: i32, right: [T], right_len: i32) -> bool {
    if (left_len < 0 || left_len != right_len) {
        return false;
    }
    swap_run(left, 0, right, 0, left_len);
    return true;
}

// Writes `value` to [start, end). Returns false without writing unless
// 0 <= start <= end <= len.
pub fn fill_range<T>(values: [T], len: i32, start: i32, end: i32, value: T) -> bool {
    if (start < 0 || end < start || end > len) {
        return false;
    }
    fill_run(values, start, end - start, value);
    return true;
}

// Index of the lowest marked byte of a nonzero mask of byte high bits.
fn lowest_marked_byte(mask: u64) -> i32 {
    let low: u64 = mask & ((mask - 1) ^ 18446744073709551615);
    return (((low >> 7) * 283686952306183) >> 56) as i32;
}

// The first index below len that holds `needle`, or -1. Packed byte views
// test eight bytes per step. A nonpositive length returns -1.
pub fn memchr(values: [u8], len: i32, needle: u8) -> i32 {
    return memchr_from(values, 0, len, needle);
}

// The first index in [start, len) that holds `needle`, or -1. A negative
// start or an empty range returns -1.
pub fn memchr_from(values: [u8], start: i32, len: i32, needle: u8) -> i32 {
    if (start < 0 || len <= start) {
        return -1;
    }
    let index: i32 = start;
    if (len - start >= 32 && slice_stride(values) == 1 && bulk_layout()) {
        let edge: u8 = values[start]; edge = values[len - 1];
        let words: i32 = (len - start) >> 3;
        let view: [u64] = word_view(core::mem::i32_slice_data_ptr(values) + (start as usize), words);
        let pattern: u64 = (needle as u64) * 72340172838076673;
        let slot: i32 = words - 1;
        while (slot >= 0) {
            // A borrow can mark a byte above a match, never below one.
            let x: u64 = view[slot] ^ pattern;
            let found: u64 = (x - 72340172838076673) & (x ^ 18446744073709551615) & 9259542123273814144;
            if (found != 0) { return start + ((words - 1 - slot) << 3) + lowest_marked_byte(found); }
            slot -= 1;
        }
        index = start + (words << 3);
    }
    while (index < len) {
        if (values[index] == needle) { return index; }
        index += 1;
    }
    return -1;
}

// The first index in [start, end) whose byte is 128 or above (not ASCII), or
// `end` when the whole range is ASCII; `start` for an empty or negative
// range. Packed byte views test eight bytes per step from 16 bytes up.
pub fn ascii_run_end(values: [u8], start: i32, end: i32) -> i32 {
    if (start < 0 || end <= start) {
        return start;
    }
    let index: i32 = start;
    if (end - start >= 16 && slice_stride(values) == 1 && bulk_layout()) {
        let edge: u8 = values[start]; edge = values[end - 1];
        let words: i32 = (end - start) >> 3;
        let slot: i32 = first_marked_word(word_view(core::mem::i32_slice_data_ptr(values) + (start as usize), words), words);
        index = start + ((words - 1 - slot) << 3);
    }
    while (index < end && values[index] < 128) {
        index += 1;
    }
    return index;
}

// The highest view index (lowest address) holding a byte with its high bit
// set, or -1. Raw [u64] views run downward from the top word.
fn first_marked_word(view: [u64], words: i32) -> i32 {
    let slot: i32 = words - 1;
    while (slot >= 0) {
        if ((view[slot] & 9259542123273814144) != 0) { return slot; }
        slot -= 1;
    }
    return -1;
}

fn first_unequal_word(left: [u64], right: [u64], words: i32) -> i32 {
    let slot: i32 = words - 1;
    while (slot >= 0) {
        if (left[slot] != right[slot]) { return slot; }
        slot -= 1;
    }
    return -1;
}

// Compares the first `count` bytes of two views as unsigned bytes: -1 or 1
// at the first difference, 0 if none. Packed byte views compare eight bytes
// per step. A nonpositive count returns 0.
pub fn memcmp(left: [u8], right: [u8], count: i32) -> i32 {
    return memcmp_range(left, 0, right, 0, count);
}

// memcmp over left[left_start..left_start + count) and the same count of
// right from right_start. Negative starts compare nothing and return 0.
pub fn memcmp_range(left: [u8], left_start: i32, right: [u8], right_start: i32, count: i32) -> i32 {
    if (count <= 0 || left_start < 0 || right_start < 0) {
        return 0;
    }
    let index: i32 = 0; let end: i32 = count;
    if (count >= 32 && slice_stride(left) == 1 && slice_stride(right) == 1 && bulk_layout()) {
        let edge: u8 = left[left_start]; edge = left[left_start + count - 1];
        edge = right[right_start]; edge = right[right_start + count - 1];
        let words: i32 = count >> 3;
        let slot: i32 = first_unequal_word(
            word_view(core::mem::i32_slice_data_ptr(left) + (left_start as usize), words),
            word_view(core::mem::i32_slice_data_ptr(right) + (right_start as usize), words), words);
        if (slot >= 0) { index = (words - 1 - slot) << 3; end = index + 8; }
        else { index = words << 3; }
    }
    while (index < end) {
        let a: u8 = left[left_start + index]; let b: u8 = right[right_start + index];
        if (a != b) {
            if (a < b) { return -1; }
            return 1;
        }
        index += 1;
    }
    return 0;
}

// Remove one logical element and shift its successors left. A valid index
// returns true; an invalid index returns false without writing. The previous
// final element is outside the new logical length and is unspecified.
pub fn remove_at<T>(values: [T], len: i32, index: i32) -> bool {
    if (index < 0 || index >= len) {
        return false;
    }
    move_run(values, index, values, index + 1, len - index - 1);
    return true;
}

// Insert at an index in [0, len], shifting the suffix right by one. A valid
// call needs 0 <= len < capacity, and the backed view must actually contain
// at least capacity writable elements. Invalid logical bounds return false
// without writing. On success the caller's new logical length is len + 1.
// If capacity overstates the physical view, native indexing can trap.
pub fn insert<T>(values: [T], len: i32, capacity: i32, index: i32, value: T) -> bool {
    if (len < 0 || capacity <= 0 || len >= capacity || index < 0 || index > len) {
        return false;
    }
    move_run(values, index + 1, values, index, len - index);
    values[index] = value;
    return true;
}

// Append within caller-owned capacity; the caller increments len on success.
// Rejected bounds leave the backing view unchanged. A capacity greater than
// the actual view length can trap when the appended element is indexed.
pub fn push<T>(values: [T], len: i32, capacity: i32, value: T) -> bool {
    return insert(values, len, capacity, len, value);
}

pub fn contains<T>(values: [T], len: i32, needle: T) -> bool where T: core::cmp::PartialEq<T> {
    let index: i32 = 0;
    while (index < len) {
        if (T::partial_eq(values[index], needle)) {
            return true;
        }
        index += 1;
    }
    return false;
}

pub fn count<T>(values: [T], len: i32, needle: T) -> i32 where T: core::cmp::PartialEq<T> {
    let index: i32 = 0;
    let total: i32 = 0;
    while (index < len) {
        if (T::partial_eq(values[index], needle)) {
            total += 1;
        }
        index += 1;
    }
    return total;
}

// Returns the first matching index or the caller's fallback.
pub fn index_of_or<T>(values: [T], len: i32, needle: T, fallback: i32) -> i32
    where T: core::cmp::PartialEq<T> {
    let index: i32 = 0;
    while (index < len) {
        if (T::partial_eq(values[index], needle)) {
            return index;
        }
        index += 1;
    }
    return fallback;
}

// Returns the last matching index or the caller's fallback.
pub fn last_index_of_or<T>(values: [T], len: i32, needle: T, fallback: i32) -> i32
    where T: core::cmp::PartialEq<T> {
    if (len <= 0) {
        return fallback;
    }
    let index: i32 = len - 1;
    while (index >= 0) {
        if (T::partial_eq(values[index], needle)) {
            return index;
        }
        index -= 1;
    }
    return fallback;
}

// Negative lengths count as empty. An empty prefix matches every view.
pub fn starts_with<T>(values: [T], len: i32, prefix: [T], prefix_len: i32) -> bool
    where T: core::cmp::PartialEq<T> {
    let total: i32 = nonnegative_len(len);
    let prefix_total: i32 = nonnegative_len(prefix_len);
    if (prefix_total > total) {
        return false;
    }
    let index: i32 = 0;
    while (index < prefix_total) {
        if (!T::partial_eq(values[index], prefix[index])) {
            return false;
        }
        index += 1;
    }
    return true;
}

// Negative lengths count as empty. An empty suffix matches every view.
pub fn ends_with<T>(values: [T], len: i32, suffix: [T], suffix_len: i32) -> bool
    where T: core::cmp::PartialEq<T> {
    let total: i32 = nonnegative_len(len);
    let suffix_total: i32 = nonnegative_len(suffix_len);
    if (suffix_total > total) {
        return false;
    }
    let offset: i32 = total - suffix_total;
    let index: i32 = 0;
    while (index < suffix_total) {
        if (!T::partial_eq(values[offset + index], suffix[index])) {
            return false;
        }
        index += 1;
    }
    return true;
}

// Negative lengths count as empty; equal-length views compare elementwise.
pub fn equals<T>(left: [T], left_len: i32, right: [T], right_len: i32) -> bool
    where T: core::cmp::PartialEq<T> {
    if (nonnegative_len(left_len) != nonnegative_len(right_len)) {
        return false;
    }
    return starts_with(left, left_len, right, right_len);
}

fn matches_at<T>(values: [T], start: i32, needle: [T], needle_len: i32) -> bool
    where T: core::cmp::PartialEq<T> {
    let offset: i32 = 0;
    while (offset < needle_len) {
        if (!T::partial_eq(values[start + offset], needle[offset])) {
            return false;
        }
        offset += 1;
    }
    return true;
}

// Returns the first start index of a contiguous needle, or -1 if absent.
// Negative lengths count as empty; an empty needle matches at zero.
pub fn index_of_subslice<T>(values: [T], len: i32, needle: [T], needle_len: i32) -> i32
    where T: core::cmp::PartialEq<T> {
    let total: i32 = nonnegative_len(len);
    let needle_total: i32 = nonnegative_len(needle_len);
    let start: i32 = 0;
    while (start <= total - needle_total) {
        if (matches_at(values, start, needle, needle_total)) {
            return start;
        }
        start += 1;
    }
    return -1;
}

// The last match of an empty needle is at the end of the logical view.
// Returns -1 when the needle is absent.
pub fn last_index_of_subslice<T>(values: [T], len: i32, needle: [T], needle_len: i32) -> i32
    where T: core::cmp::PartialEq<T> {
    let total: i32 = nonnegative_len(len);
    let needle_total: i32 = nonnegative_len(needle_len);
    let start: i32 = total - needle_total;
    while (start >= 0) {
        if (matches_at(values, start, needle, needle_total)) {
            return start;
        }
        start -= 1;
    }
    return -1;
}

// Keep the first element of each adjacent run, preserving order. Returns the
// new logical length; elements at or beyond it are unspecified. A nonpositive
// len returns zero without writing.
pub fn dedup_adjacent<T>(values: [T], len: i32) -> i32 where T: core::cmp::PartialEq<T> {
    if (len <= 0) {
        return 0;
    }
    let write: i32 = 1;
    let read: i32 = 1;
    while (read < len) {
        let current: T = values[read];
        if (!T::partial_eq(current, values[write - 1])) {
            values[write] = current;
            write += 1;
        }
        read += 1;
    }
    return write;
}

// Remove every matching value from the logical view while preserving the
// order of retained values. Returns the new length; the tail is unspecified.
// A nonpositive len returns zero without writing.
pub fn retain_not_equal<T>(values: [T], len: i32, needle: T) -> i32
    where T: core::cmp::PartialEq<T> {
    let read: i32 = 0;
    let write: i32 = 0;
    while (read < len) {
        let current: T = values[read];
        if (!T::partial_eq(current, needle)) {
            values[write] = current;
            write += 1;
        }
        read += 1;
    }
    return write;
}

// Returns -1, 0, or 1 for lexicographic order. Negative lengths count as
// empty; the first unequal element decides before the lengths are compared.
// Elements use a total order; native floats need core::float_order wrappers.
pub fn compare_lexicographic<T>(left: [T], left_len: i32, right: [T], right_len: i32) -> i32
    where T: core::cmp::Ord<T> {
    let left_total: i32 = nonnegative_len(left_len);
    let right_total: i32 = nonnegative_len(right_len);
    let common: i32 = left_total;
    if (right_total < common) {
        common = right_total;
    }
    let index: i32 = 0;
    while (index < common) {
        if (T::lt(left[index], right[index])) {
            return -1;
        }
        if (T::lt(right[index], left[index])) {
            return 1;
        }
        index += 1;
    }
    if (left_total < right_total) {
        return -1;
    }
    if (left_total > right_total) {
        return 1;
    }
    return 0;
}

pub fn min_or<T>(values: [T], len: i32, fallback: T) -> T where T: core::cmp::Ord<T> {
    if (len <= 0) {
        return fallback;
    }
    let lowest: T = values[0];
    let index: i32 = 1;
    while (index < len) {
        if (T::lt(values[index], lowest)) {
            lowest = values[index];
        }
        index += 1;
    }
    return lowest;
}

pub fn max_or<T>(values: [T], len: i32, fallback: T) -> T where T: core::cmp::Ord<T> {
    if (len <= 0) {
        return fallback;
    }
    let highest: T = values[0];
    let index: i32 = 1;
    while (index < len) {
        if (T::lt(highest, values[index])) {
            highest = values[index];
        }
        index += 1;
    }
    return highest;
}

// Shared ordering engines take an admitted logical View. Ordinary indexing
// retains its native stride, including negative strides. These functions do
// not establish physical backing, lifetime or freedom from interfering aliases.
// The sort engines ask only "is left strictly before right". Natural order
// answers with one T::lt call; a caller Comparator is adapted once per sort
// and called once per question, so `_by` comparison counts are unchanged.
// Building and testing an Ordering costs about three times a direct lt.
trait Less<T> { fn less(&self,left:T,right:T) -> bool; }
struct NaturalLess<T> {}
impl<T> NaturalLess<T> { fn borrow(&self) -> &NaturalLess<T> { return self; } }
impl<T> Less<T> for NaturalLess<T> where T:core::cmp::Ord<T> {
    fn less(&self,left:T,right:T) -> bool { return T::lt(left,right); }
}
struct ComparatorLess<T,C> { comparator:&C }
impl<T,C> ComparatorLess<T,C> { fn borrow(&self) -> &ComparatorLess<T,C> { return self; } }
impl<T,C> Less<T> for ComparatorLess<T,C> where C:core::ordering::Comparator<T,T> {
    fn less(&self,left:T,right:T) -> bool { return core::ordering::is_less(self.comparator.compare(left,right)); }
}
fn is_sorted_engine<T,C>(values:View<T>,comparator:&C) -> bool
    where C:Less<T> {
    let index: i32 = 1;
    while (index < values.length) {
        if (comparator.less(values.values[values.start+index],values.values[values.start+index-1])) {
            return false;
        }
        index += 1;
    }
    return true;
}

fn sift_down_by<T,C>(values:View<T>,heap_len:i32,start:i32,comparator:&C)
    where C:Less<T> {
    let root: i32 = start;
    // A left child exists before doubling root, so neither child arithmetic
    // nor the admitted view's start+relative-index addition can overflow.
    while (root < heap_len / 2) {
        let child: i32 = root * 2 + 1;
        let largest: i32 = root;
        if (comparator.less(values.values[values.start+largest],values.values[values.start+child])) {
            largest = child;
        }
        if (child + 1 < heap_len && comparator.less(values.values[values.start+largest],values.values[values.start+child+1])) {
            largest = child + 1;
        }
        if (largest == root) {
            return;
        }
        let previous: T = values.values[values.start+root];
        values.values[values.start+root] = values.values[values.start+largest];
        values.values[values.start+largest] = previous;
        root = largest;
    }
}

fn sort_engine<T,C>(values:View<T>,comparator:&C) -> i32
    where C:Less<T> {
    let start: i32 = values.length / 2;
    while (start > 0) {
        start -= 1;
        sift_down_by<T,C>(values,values.length,start,comparator);
    }
    let remaining: i32 = values.length;
    while (remaining > 1) {
        remaining -= 1;
        let previous: T = values.values[values.start];
        values.values[values.start] = values.values[values.start+remaining];
        values.values[values.start+remaining] = previous;
        sift_down_by<T,C>(values,remaining,0,comparator);
    }
    return values.length;
}

fn selection_swap<T>(values:View<T>,left:i32,right:i32) {
    let previous:T = values.values[values.start+left];
    values.values[values.start+left] = values.values[values.start+right];
    values.values[values.start+right] = previous;
}

// Only groups of at most five are sorted. Each step exchanges whole shallow
// values, retaining one permutation without cloning or retiring any payload.
fn selection_sort_small<T,C>(values:View<T>,low:i32,high:i32,comparator:&C)
    where C:core::ordering::Comparator<T,T> {
    let index:i32 = low+1;
    while(index<high) {
        let position:i32 = index;
        let moving:bool = true;
        while(position>low && moving) {
            if(core::ordering::is_less(comparator.compare(values.values[values.start+position],values.values[values.start+position-1]))) {
                selection_swap<T>(values,position,position-1);
                position-=1;
            } else {
                moving=false;
            }
        }
        index+=1;
    }
}

// Deterministic groups-of-five selection on an admitted nonempty View/rank.
// Phase zero selects its median prefix; phase one partitions around the child
// result. Only median descent pushes a frame; partition descent reuses it.
fn selection_engine<T,C>(values:View<T>,nth:i32,comparator:&C) -> i32
    where C:core::ordering::Comparator<T,T> {
    let lows:[i32;16] = [0;16];
    let highs:[i32;16] = [0;16];
    let targets:[i32;16] = [0;16];
    let phases:[i32;16] = [0;16];
    let depth:i32 = 0;
    highs[0]=values.length; targets[0]=nth;
    let completed:i32 = 0;
    while(depth>=0) {
        let low:i32 = lows[depth];
        let high:i32 = highs[depth];
        let target:i32 = targets[depth];
        if(phases[depth]==0) {
            let length:i32 = high-low;
            if(length<=5) {
                selection_sort_small<T,C>(values,low,high,comparator);
                completed=target;
                depth-=1;
            } else {
                let group:i32 = low;
                let prefix:i32 = low;
                while(group<high) {
                    let group_length:i32 = high-group;
                    if(group_length>5) { group_length=5; }
                    let group_end:i32 = group+group_length;
                    selection_sort_small<T,C>(values,group,group_end,comparator);
                    let middle:i32 = group+group_length/2;
                    selection_swap<T>(values,prefix,middle);
                    prefix+=1;
                    group=group_end;
                }
                // prefix-low is ceil(length/5), computed without length+4.
                // From i32::MAX, median-only descent needs at most fourteen
                // active frames. Check the child slot before incrementing.
                assert(depth<15);
                phases[depth]=1;
                depth+=1;
                lows[depth]=low; highs[depth]=prefix;
                targets[depth]=low+(prefix-low)/2; phases[depth]=0;
            }
        } else {
            // Keep the selected pivot outside every scan/swap range until
            // insertion into the equal band. Do not retain an owning copy.
            let pivot:i32 = high-1;
            selection_swap<T>(values,completed,pivot);
            let less:i32 = low;
            let scan:i32 = low;
            let greater:i32 = pivot;
            while(scan<greater) {
                let relation:core::ordering::Ordering = comparator.compare(values.values[values.start+scan],values.values[values.start+pivot]);
                if(core::ordering::is_less(relation)) {
                    selection_swap<T>(values,less,scan);
                    less+=1; scan+=1;
                } else {
                    if(core::ordering::is_greater(relation)) {
                        greater-=1;
                        selection_swap<T>(values,scan,greater);
                    } else {
                        scan+=1;
                    }
                }
            }
            selection_swap<T>(values,greater,pivot);
            let equal_end:i32 = greater+1;
            // The protected pivot makes this band nonempty even when a
            // returning comparator is inconsistent. A tail range shrinks.
            if(target<less) {
                highs[depth]=less; phases[depth]=0;
            } else {
                if(target>=equal_end) {
                    lows[depth]=equal_end; phases[depth]=0;
                } else {
                    completed=target;
                    depth-=1;
                }
            }
        }
    }
    return completed;
}

fn lower_bound_engine<T,K,C>(values:View<T>,needle:K,comparator:&C) -> i32
    where C:core::ordering::Comparator<T,K> {
    let low: i32 = 0;
    let high: i32 = values.length;
    while (low < high) {
        let middle: i32 = low + (high - low) / 2;
        if (core::ordering::is_less(comparator.compare(values.values[values.start+middle],needle))) {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    return low;
}

fn upper_bound_engine<T,K,C>(values:View<T>,needle:K,comparator:&C) -> i32
    where C:core::ordering::Comparator<T,K> {
    let low: i32 = 0;
    let high: i32 = values.length;
    while (low < high) {
        let middle: i32 = low + (high - low) / 2;
        if (!core::ordering::is_greater(comparator.compare(values.values[values.start+middle],needle))) {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    return low;
}

fn binary_search_first_engine<T,K,C>(values:View<T>,needle:K,comparator:&C) -> core::option::Option<i32>
    where C:core::ordering::Comparator<T,K> {
    let index: i32 = lower_bound_engine<T,K,C>(values,needle,comparator);
    if (index < values.length && core::ordering::is_equal(comparator.compare(values.values[values.start+index],needle))) {
        return core::option::Some(index);
    }
    return core::option::None();
}

fn binary_search_last_engine<T,K,C>(values:View<T>,needle:K,comparator:&C) -> core::option::Option<i32>
    where C:core::ordering::Comparator<T,K> {
    let after: i32 = upper_bound_engine<T,K,C>(values,needle,comparator);
    if (after > 0 && core::ordering::is_equal(comparator.compare(values.values[values.start+after-1],needle))) {
        return core::option::Some(after-1);
    }
    return core::option::None();
}

fn partition_lt_engine<T,K,C>(values:View<T>,pivot:K,comparator:&C) -> i32
    where C:core::ordering::Comparator<T,K> {
    let boundary: i32 = 0;
    let index: i32 = 0;
    while (index < values.length) {
        if (core::ordering::is_less(comparator.compare(values.values[values.start+index],pivot))) {
            let previous: T = values.values[values.start+boundary];
            values.values[values.start+boundary] = values.values[values.start+index];
            values.values[values.start+index] = previous;
            boundary += 1;
        }
        index += 1;
    }
    return boundary;
}

// Checked entry points validate the complete logical range before any read,
// mutation or callback. Indices are relative to the selected View. Backing and
// context must remain live and unchanged through aliases; no clone/Destroy or
// allocation occurs. Sorting is unstable; exact comparison traces are not promised.
pub fn sort_unstable_by<T,C>(values:View<T>,comparator:&C) -> core::result::Result<i32,ViewError>
    where C:core::ordering::Comparator<T,T> {
    if(!view_valid<T>(values)) { return core::result::Err(ViewError::Bounds); }
    let less:ComparatorLess<T,C> = ComparatorLess { comparator:comparator };
    return core::result::Ok(pdq_engine<T,ComparatorLess<T,C>>(values,less.borrow()));
}
// Select one zero-based rank and partition its surroundings without sorting
// either side. The returned one-element View aliases its exact stored slot.
// Equivalent values have no stable representative. Physical backing, lifetime
// and noninterference remain caller obligations; no cleanup is transferred.
pub fn select_nth_unstable_by<T,C>(values:View<T>,nth:i32,comparator:&C) -> core::result::Result<View<T>,ViewError>
    where C:core::ordering::Comparator<T,T> {
    if(!view_valid<T>(values) || nth<0 || nth>=values.length) {
        return core::result::Err(ViewError::Bounds);
    }
    let selected_index:i32 = selection_engine<T,C>(values,nth,comparator);
    let selected:View<T> = View { values:values.values,start:values.start+selected_index,length:1 };
    return core::result::Ok(selected);
}
pub fn select_nth_unstable<T>(values:View<T>,nth:i32) -> core::result::Result<View<T>,ViewError>
    where T:core::cmp::Ord<T> {
    if(!view_valid<T>(values) || nth<0 || nth>=values.length) {
        return core::result::Err(ViewError::Bounds);
    }
    let comparator:core::ordering::Natural<T> = core::ordering::Natural {};
    let selected_index:i32 = selection_engine<T,core::ordering::Natural<T>>(values,nth,comparator.borrow());
    let selected:View<T> = View { values:values.values,start:values.start+selected_index,length:1 };
    return core::result::Ok(selected);
}
pub fn is_sorted_by<T,C>(values:View<T>,comparator:&C) -> core::result::Result<bool,ViewError>
    where C:core::ordering::Comparator<T,T> {
    if(!view_valid<T>(values)) { return core::result::Err(ViewError::Bounds); }
    let less:ComparatorLess<T,C> = ComparatorLess { comparator:comparator };
    return core::result::Ok(is_sorted_engine<T,ComparatorLess<T,C>>(values,less.borrow()));
}
// Each query requires all Less, then Equal, then Greater classes. Bounds may
// equal length; no scan is made to validate this ordering precondition.
pub fn lower_bound_by<T,K,C>(values:View<T>,needle:K,comparator:&C) -> core::result::Result<i32,ViewError>
    where C:core::ordering::Comparator<T,K> {
    if(!view_valid<T>(values)) { return core::result::Err(ViewError::Bounds); }
    return core::result::Ok(lower_bound_engine<T,K,C>(values,needle,comparator));
}
pub fn upper_bound_by<T,K,C>(values:View<T>,needle:K,comparator:&C) -> core::result::Result<i32,ViewError>
    where C:core::ordering::Comparator<T,K> {
    if(!view_valid<T>(values)) { return core::result::Err(ViewError::Bounds); }
    return core::result::Ok(upper_bound_engine<T,K,C>(values,needle,comparator));
}
pub fn binary_search_first_by<T,K,C>(values:View<T>,needle:K,comparator:&C) -> core::result::Result<core::option::Option<i32>,ViewError>
    where C:core::ordering::Comparator<T,K> {
    if(!view_valid<T>(values)) { return core::result::Err(ViewError::Bounds); }
    let found:core::option::Option<i32> =binary_search_first_engine<T,K,C>(values,needle,comparator);
    return core::result::Ok(found);
}
pub fn binary_search_last_by<T,K,C>(values:View<T>,needle:K,comparator:&C) -> core::result::Result<core::option::Option<i32>,ViewError>
    where C:core::ordering::Comparator<T,K> {
    if(!view_valid<T>(values)) { return core::result::Err(ViewError::Bounds); }
    let found:core::option::Option<i32> =binary_search_last_engine<T,K,C>(values,needle,comparator);
    return core::result::Ok(found);
}
// Less values precede all others. Only the permutation and boundary are
// promised; no relative ordering, tie layout or rollback on callback traps.
pub fn partition_lt_by<T,K,C>(values:View<T>,pivot:K,comparator:&C) -> core::result::Result<i32,ViewError>
    where C:core::ordering::Comparator<T,K> {
    if(!view_valid<T>(values)) { return core::result::Err(ViewError::Bounds); }
    return core::result::Ok(partition_lt_engine<T,K,C>(values,pivot,comparator));
}

// Raw slice/count Ord entry points preserve nonpositive-as-empty semantics
// and delegate to the same engines. Physical backing remains a precondition.
pub fn is_sorted<T>(values:[T],len:i32) -> bool where T:core::cmp::Ord<T> {
    let selected:View<T> =View { values:values,start:0,length:nonnegative_len(len) };
    let less:NaturalLess<T> = NaturalLess {};
    return is_sorted_engine<T,NaturalLess<T>>(selected,less.borrow());
}
// In-place ascending pattern-defeating quicksort; not stable. Return count.
pub fn sort<T>(values:[T],len:i32) -> i32 where T:core::cmp::Ord<T> {
    let selected:View<T> =View { values:values,start:0,length:nonnegative_len(len) };
    let less:NaturalLess<T> = NaturalLess {};
    return pdq_engine<T,NaturalLess<T>>(selected,less.borrow());
}
// Nondecreasing input; first not-Less or first Greater, respectively.
pub fn lower_bound<T>(values:[T],len:i32,needle:T) -> i32 where T:core::cmp::Ord<T> {
    let selected:View<T> =View { values:values,start:0,length:nonnegative_len(len) };
    let comparator:core::ordering::Natural<T> =core::ordering::Natural {};
    return lower_bound_engine<T,T,core::ordering::Natural<T>>(selected,needle,comparator.borrow());
}
pub fn upper_bound<T>(values:[T],len:i32,needle:T) -> i32 where T:core::cmp::Ord<T> {
    let selected:View<T> =View { values:values,start:0,length:nonnegative_len(len) };
    let comparator:core::ordering::Natural<T> =core::ordering::Natural {};
    return upper_bound_engine<T,T,core::ordering::Natural<T>>(selected,needle,comparator.borrow());
}
// Nondecreasing input; select the exact first/last match or fallback.
pub fn binary_search_first_or<T>(values:[T],len:i32,needle:T,fallback:i32) -> i32
    where T:core::cmp::Ord<T> {
    let selected:View<T> =View { values:values,start:0,length:nonnegative_len(len) };
    let comparator:core::ordering::Natural<T> =core::ordering::Natural {};
    let found:core::option::Option<i32> =binary_search_first_engine<T,T,core::ordering::Natural<T>>(selected,needle,comparator.borrow());
    return found.unwrap_or(fallback);
}
pub fn binary_search_last_or<T>(values:[T],len:i32,needle:T,fallback:i32) -> i32
    where T:core::cmp::Ord<T> {
    let selected:View<T> =View { values:values,start:0,length:nonnegative_len(len) };
    let comparator:core::ordering::Natural<T> =core::ordering::Natural {};
    let found:core::option::Option<i32> =binary_search_last_engine<T,T,core::ordering::Natural<T>>(selected,needle,comparator.borrow());
    return found.unwrap_or(fallback);
}
// Unstable Less/non-Less partition of the first nonnegative_len(len) values.
pub fn partition_lt<T>(values:[T],len:i32,pivot:T) -> i32 where T:core::cmp::Ord<T> {
    let selected:View<T> =View { values:values,start:0,length:nonnegative_len(len) };
    let comparator:core::ordering::Natural<T> =core::ordering::Natural {};
    return partition_lt_engine<T,T,core::ordering::Natural<T>>(selected,pivot,comparator.borrow());
}

// Adds every element to `initial` with the type's saturating addition, so
// integer totals clamp at the type's limits instead of wrapping. A
// nonpositive len returns `initial`.
pub fn sum<T>(values: [T], len: i32, initial: T) -> T where T: core::ops::SaturatingAdd<T> {
    let total: T = initial;
    let index: i32 = 0;
    while (index < len) {
        total = T::saturating_add(total, values[index]);
        index += 1;
    }
    return total;
}

// ---- Pattern-defeating quicksort (unstable) ----
// Orson Peters' pdqsort: median-of-three or ninther pivots, a partition that
// reports whether it swapped anything, bounded insertion repair of already
// partitioned ranges, an equal-to-predecessor partition for duplicate runs,
// pattern-breaking swaps after unbalanced partitions and a heapsort fallback
// after floor(log2 n) of them. Worst case O(n log n) comparisons; sorted,
// reversed-then-repaired and few-distinct inputs take near-linear work. Every
// scan is index-guarded, so an inconsistent comparator cannot leave the range.
// Stable straight insertion of [low+1,high) into the growing sorted prefix.
fn insertion_range<T,C>(values:View<T>,low:i32,high:i32,comparator:&C) where C:Less<T> {
    let index:i32 = low+1;
    while(index<high) {
        let item:T = values.values[values.start+index];
        if(comparator.less(item,values.values[values.start+index-1])) {
            values.values[values.start+index] = values.values[values.start+index-1];
            let hole:i32 = index-1;
            while(hole>low && comparator.less(item,values.values[values.start+hole-1])) {
                values.values[values.start+hole] = values.values[values.start+hole-1]; hole-=1;
            }
            values.values[values.start+hole] = item;
        }
        index+=1;
    }
}
// Insertion sort that gives up after moving more than eight elements in
// total; the range is a permutation of its input either way.
fn partial_insertion<T,C>(values:View<T>,low:i32,high:i32,comparator:&C) -> bool where C:Less<T> {
    let moved:i32 = 0;
    let index:i32 = low+1;
    while(index<high) {
        let item:T = values.values[values.start+index];
        if(comparator.less(item,values.values[values.start+index-1])) {
            values.values[values.start+index] = values.values[values.start+index-1];
            let hole:i32 = index-1;
            while(hole>low && comparator.less(item,values.values[values.start+hole-1])) {
                values.values[values.start+hole] = values.values[values.start+hole-1]; hole-=1;
            }
            values.values[values.start+hole] = item;
            moved+=index-hole;
            if(moved>8) { return false; }
        }
        index+=1;
    }
    return true;
}
fn sort2_at<T,C>(values:View<T>,first:i32,second:i32,comparator:&C) where C:Less<T> {
    if(comparator.less(values.values[values.start+second],values.values[values.start+first])) { selection_swap<T>(values,first,second); }
}
fn sort3_at<T,C>(values:View<T>,first:i32,second:i32,third:i32,comparator:&C) where C:Less<T> {
    sort2_at<T,C>(values,first,second,comparator);
    sort2_at<T,C>(values,second,third,comparator);
    sort2_at<T,C>(values,first,second,comparator);
}
// Pivot at low. Elements Less than it end left of the returned position, the
// rest right. `swapped` reports whether any exchange was needed.
struct PartitionResult { pivot:i32, swapped:bool }
fn partition_right_at<T,C>(values:View<T>,low:i32,high:i32,comparator:&C) -> PartitionResult where C:Less<T> {
    let pivot:T = values.values[values.start+low];
    // [low+1,first) are Less than the pivot; [last,high) are not.
    let first:i32 = low+1;
    while(first<high && comparator.less(values.values[values.start+first],pivot)) { first+=1; }
    let last:i32 = high;
    while(last>first && !comparator.less(values.values[values.start+last-1],pivot)) { last-=1; }
    let swapped:bool = first<last;
    while(first<last) {
        selection_swap<T>(values,first,last-1);
        first+=1; last-=1;
        while(first<last && comparator.less(values.values[values.start+first],pivot)) { first+=1; }
        while(last>first && !comparator.less(values.values[values.start+last-1],pivot)) { last-=1; }
    }
    let position:i32 = first-1;
    values.values[values.start+low] = values.values[values.start+position];
    values.values[values.start+position] = pivot;
    return PartitionResult { pivot:position, swapped:swapped };
}
// Pivot at low. Elements not Greater than it end at or left of the returned
// position; used when the pivot equals the predecessor of the range, so the
// whole equal run is finished at once.
fn partition_left_at<T,C>(values:View<T>,low:i32,high:i32,comparator:&C) -> i32 where C:Less<T> {
    let pivot:T = values.values[values.start+low];
    // [low+1,first) are not Greater than the pivot; [last,high) are Greater.
    let first:i32 = low+1;
    while(first<high && !comparator.less(pivot,values.values[values.start+first])) { first+=1; }
    let last:i32 = high;
    while(last>first && comparator.less(pivot,values.values[values.start+last-1])) { last-=1; }
    while(first<last) {
        selection_swap<T>(values,first,last-1);
        first+=1; last-=1;
        while(first<last && !comparator.less(pivot,values.values[values.start+first])) { first+=1; }
        while(last>first && comparator.less(pivot,values.values[values.start+last-1])) { last-=1; }
    }
    let position:i32 = first-1;
    values.values[values.start+low] = values.values[values.start+position];
    values.values[values.start+position] = pivot;
    return position;
}
fn heapsort_range<T,C>(values:View<T>,low:i32,high:i32,comparator:&C) where C:Less<T> {
    let part:View<T> = View { values:values.values,start:values.start+low,length:high-low };
    sort_engine<T,C>(part,comparator);
}
fn floor_log2(value:i32) -> i32 { let bits:i32 = 0; let rest:i32 = value; while(rest>1) { rest=rest/2; bits+=1; } return bits; }
// Swap a few elements at fixed fractions of each side to break patterns
// that produced an unbalanced partition.
fn break_patterns<T>(values:View<T>,low:i32,pivot:i32,high:i32) {
    let left:i32 = pivot-low;
    if(left>=24) {
        let quarter:i32 = left/4;
        selection_swap<T>(values,low,low+quarter);
        selection_swap<T>(values,pivot-1,pivot-quarter);
        if(left>128) {
            selection_swap<T>(values,low+1,low+quarter+1);
            selection_swap<T>(values,low+2,low+quarter+2);
            selection_swap<T>(values,pivot-2,pivot-quarter-1);
            selection_swap<T>(values,pivot-3,pivot-quarter-2);
        }
    }
    let right:i32 = high-pivot-1;
    if(right>=24) {
        let quarter:i32 = right/4;
        selection_swap<T>(values,pivot+1,pivot+1+quarter);
        selection_swap<T>(values,high-1,high-quarter);
        if(right>128) {
            selection_swap<T>(values,pivot+2,pivot+2+quarter);
            selection_swap<T>(values,pivot+3,pivot+3+quarter);
            selection_swap<T>(values,high-2,high-quarter-1);
            selection_swap<T>(values,high-3,high-quarter-2);
        }
    }
}
fn pdq_engine<T,C>(values:View<T>,comparator:&C) -> i32 where C:Less<T> {
    let n:i32 = values.length;
    if(n<2) { return n; }
    // Pending ranges: the larger side of each split is pushed and the smaller
    // processed first, so at most 32 entries are ever pending.
    let lows:[i32;40] = [0;40];
    let highs:[i32;40] = [0;40];
    let budgets:[i32;40] = [0;40];
    let lefts:[i32;40] = [0;40];
    let depth:i32 = 0;
    let low:i32 = 0; let high:i32 = n; let budget:i32 = floor_log2(n); let leftmost:bool = true;
    let active:bool = true;
    while(active) {
        let size:i32 = high-low;
        let done:bool = false;
        if(size<24) {
            insertion_range<T,C>(values,low,high,comparator);
            done = true;
        } else {
            let half:i32 = size/2;
            if(size>128) {
                sort3_at<T,C>(values,low,low+half,high-1,comparator);
                sort3_at<T,C>(values,low+1,low+half-1,high-2,comparator);
                sort3_at<T,C>(values,low+2,low+half+1,high-3,comparator);
                sort3_at<T,C>(values,low+half-1,low+half,low+half+1,comparator);
                selection_swap<T>(values,low,low+half);
            } else {
                sort3_at<T,C>(values,low+half,low,high-1,comparator);
            }
            if(!leftmost && !comparator.less(values.values[values.start+low-1],values.values[values.start+low])) {
                // Equal to the predecessor: finish the equal run, keep the rest.
                low = partition_left_at<T,C>(values,low,high,comparator)+1;
            } else {
                let parts:PartitionResult = partition_right_at<T,C>(values,low,high,comparator);
                let pivot:i32 = parts.pivot;
                let left_size:i32 = pivot-low;
                let right_size:i32 = high-pivot-1;
                let unbalanced:bool = left_size<size/8 || right_size<size/8;
                if(unbalanced) {
                    budget-=1;
                    if(budget<=0) {
                        heapsort_range<T,C>(values,low,high,comparator);
                        done = true;
                    } else {
                        break_patterns<T>(values,low,pivot,high);
                    }
                } else {
                    if(!parts.swapped && partial_insertion<T,C>(values,low,pivot,comparator) && partial_insertion<T,C>(values,pivot+1,high,comparator)) {
                        done = true;
                    }
                }
                if(!done) {
                    // Continue with the smaller side; push the larger one.
                    let left_flag:i32 = 0; if(leftmost) { left_flag = 1; }
                    assert(depth<40);
                    if(left_size<right_size) {
                        lows[depth]=pivot+1; highs[depth]=high; budgets[depth]=budget; lefts[depth]=0; depth+=1;
                        high = pivot;
                    } else {
                        lows[depth]=low; highs[depth]=pivot; budgets[depth]=budget; lefts[depth]=left_flag; depth+=1;
                        low = pivot+1; leftmost = false;
                    }
                }
            }
        }
        if(done) {
            if(depth==0) { active = false; }
            else {
                depth-=1;
                low=lows[depth]; high=highs[depth]; budget=budgets[depth]; leftmost=lefts[depth]==1;
            }
        }
    }
    return n;
}
pub fn sort_unstable<T>(values:View<T>) -> core::result::Result<i32,ViewError> where T:core::cmp::Ord<T> {
    if(!view_valid<T>(values)) { return core::result::Err(ViewError::Bounds); }
    let less:NaturalLess<T> = NaturalLess {};
    return core::result::Ok(pdq_engine<T,NaturalLess<T>>(values,less.borrow()));
}

// ---- Stable run-adaptive merge sort ----
// TimSort-style: natural ascending runs are found (strictly descending runs
// are reversed in place), short runs are extended to a minimum run length by
// binary insertion, and a run stack keeps Python's listsort invariants. Each
// merge first gallops (exponential then binary search) to skip the prefix of
// the left run and the suffix of the right run that are already in place,
// then copies the smaller remainder to caller scratch and merges, switching
// to galloping mode after MIN_GALLOP consecutive wins by one side with an
// adaptive threshold, as in CPython's listsort. Equal items
// keep their input order. O(n log n) worst case, O(n) on sorted, reversed or
// few-run inputs. Scratch needs length >= n/2 and must not overlap values.
fn reverse_range<T>(values:View<T>,low:i32,high:i32) {
    let left:i32 = low; let right:i32 = high-1;
    while(left<right) { selection_swap<T>(values,left,right); left+=1; right-=1; }
}
fn count_run<T,C>(values:View<T>,low:i32,high:i32,comparator:&C) -> i32 where C:Less<T> {
    if(low+1>=high) { return high; }
    let end:i32 = low+2;
    if(comparator.less(values.values[values.start+low+1],values.values[values.start+low])) {
        while(end<high && comparator.less(values.values[values.start+end],values.values[values.start+end-1])) { end+=1; }
        reverse_range<T>(values,low,end);
    } else {
        while(end<high && !comparator.less(values.values[values.start+end],values.values[values.start+end-1])) { end+=1; }
    }
    return end;
}
// Insert [sorted_end,high) into the sorted prefix [low,sorted_end), each item
// after every equal item already placed.
fn binary_insertion<T,C>(values:View<T>,low:i32,sorted_end:i32,high:i32,comparator:&C) where C:Less<T> {
    let index:i32 = sorted_end;
    while(index<high) {
        let item:T = values.values[values.start+index];
        let left:i32 = low; let right:i32 = index;
        while(left<right) {
            let middle:i32 = left+(right-left)/2;
            if(comparator.less(item,values.values[values.start+middle])) { right=middle; } else { left=middle+1; }
        }
        let hole:i32 = index;
        while(hole>left) { values.values[values.start+hole] = values.values[values.start+hole-1]; hole-=1; }
        values.values[values.start+left] = item;
        index+=1;
    }
}
// Count of leading elements of [base,base+count) that are not Greater than key.
fn gallop_right<T,C>(values:View<T>,key:T,base:i32,count:i32,comparator:&C) -> i32 where C:Less<T> {
    if(count==0 || comparator.less(key,values.values[values.start+base])) { return 0; }
    let previous:i32 = 0; let offset:i32 = 1;
    while(offset<count && !comparator.less(key,values.values[values.start+base+offset])) {
        previous = offset;
        if(offset>=count/2) { offset = count; } else { offset = offset*2+1; }
    }
    if(offset>count) { offset = count; }
    let left:i32 = previous+1; let right:i32 = offset;
    while(left<right) {
        let middle:i32 = left+(right-left)/2;
        if(comparator.less(key,values.values[values.start+base+middle])) { right=middle; } else { left=middle+1; }
    }
    return left;
}
// Count of leading elements of [base,base+count) that are Less than key.
fn gallop_left<T,C>(values:View<T>,key:T,base:i32,count:i32,comparator:&C) -> i32 where C:Less<T> {
    if(count==0 || !comparator.less(values.values[values.start+base],key)) { return 0; }
    let previous:i32 = 0; let offset:i32 = 1;
    while(offset<count && comparator.less(values.values[values.start+base+offset],key)) {
        previous = offset;
        if(offset>=count/2) { offset = count; } else { offset = offset*2+1; }
    }
    if(offset>count) { offset = count; }
    let left:i32 = previous+1; let right:i32 = offset;
    while(left<right) {
        let middle:i32 = left+(right-left)/2;
        if(comparator.less(values.values[values.start+base+middle],key)) { left=middle+1; } else { right=middle; }
    }
    return left;
}
// Count of trailing elements of [base,base+count) that are Greater than key,
// searched exponentially from the right end.
fn suffix_greater<T,C>(values:View<T>,key:T,base:i32,count:i32,comparator:&C) -> i32 where C:Less<T> {
    if(count==0 || !comparator.less(key,values.values[values.start+base+count-1])) { return 0; }
    let previous:i32 = 0; let offset:i32 = 1;
    while(offset<count && comparator.less(key,values.values[values.start+base+count-1-offset])) {
        previous = offset;
        if(offset>=count/2) { offset = count; } else { offset = offset*2+1; }
    }
    if(offset>count) { offset = count; }
    let left:i32 = previous+1; let right:i32 = offset;
    while(left<right) {
        let middle:i32 = left+(right-left)/2;
        if(comparator.less(key,values.values[values.start+base+count-1-middle])) { left=middle+1; } else { right=middle; }
    }
    return left;
}
// Count of trailing elements of [base,base+count) that are not Less than key.
fn suffix_not_less<T,C>(values:View<T>,key:T,base:i32,count:i32,comparator:&C) -> i32 where C:Less<T> {
    if(count==0 || comparator.less(values.values[values.start+base+count-1],key)) { return 0; }
    let previous:i32 = 0; let offset:i32 = 1;
    while(offset<count && !comparator.less(values.values[values.start+base+count-1-offset],key)) {
        previous = offset;
        if(offset>=count/2) { offset = count; } else { offset = offset*2+1; }
    }
    if(offset>count) { offset = count; }
    let left:i32 = previous+1; let right:i32 = offset;
    while(left<right) {
        let middle:i32 = left+(right-left)/2;
        if(!comparator.less(values.values[values.start+base+count-1-middle],key)) { left=middle+1; } else { right=middle; }
    }
    return left;
}
// Copies as if through a temporary (move_run), so overlap in either direction is safe.
fn copy_range<T>(from:View<T>,from_index:i32,to:View<T>,to_index:i32,count:i32) {
    move_run(to.values, to.start+to_index, from.values, from.start+from_index, count);
}
const MIN_GALLOP: i32 = 7;
// Merge with the left run in scratch, front to back. Requires the first right
// item Less than the first left item and the last left item Greater than
// every right item (merge_runs trims to this). Returns the adapted gallop
// threshold.
fn merge_low<T,C>(values:View<T>,scratch:View<T>,start:i32,middle:i32,end:i32,threshold:i32,comparator:&C) -> i32 where C:Less<T> {
    let left_count:i32 = middle-start; let right_count:i32 = end-middle;
    copy_range<T>(values,start,scratch,0,left_count);
    let gallop:i32 = threshold;
    let output:i32 = start; let left:i32 = 0; let right:i32 = middle;
    values.values[values.start+output] = values.values[values.start+right]; output+=1; right+=1; right_count-=1;
    // finish 1: copy the left remainder; finish 2: one left item remains last.
    let finish:i32 = 0;
    if(right_count==0) { finish = 1; } else { if(left_count==1) { finish = 2; } }
    while(finish==0) {
        let left_wins:i32 = 0; let right_wins:i32 = 0;
        let straight:bool = true;
        while(straight && finish==0) {
            if(comparator.less(values.values[values.start+right],scratch.values[scratch.start+left])) {
                values.values[values.start+output] = values.values[values.start+right]; output+=1; right+=1; right_count-=1;
                right_wins+=1; left_wins=0;
                if(right_count==0) { finish = 1; } else { if(right_wins>=gallop) { straight = false; } }
            } else {
                values.values[values.start+output] = scratch.values[scratch.start+left]; output+=1; left+=1; left_count-=1;
                left_wins+=1; right_wins=0;
                if(left_count==1) { finish = 2; } else { if(left_wins>=gallop) { straight = false; } }
            }
        }
        if(finish==0) {
            gallop+=1;
            let galloping:bool = true;
            while(galloping && finish==0) {
                if(gallop>1) { gallop-=1; }
                let count:i32 = gallop_right<T,C>(scratch,values.values[values.start+right],left,left_count,comparator);
                left_wins = count;
                if(count>0) {
                    copy_range<T>(scratch,left,values,output,count); output+=count; left+=count; left_count-=count;
                    if(left_count==1) { finish = 2; } else { if(left_count==0) { finish = 1; } }
                }
                if(finish==0) {
                    values.values[values.start+output] = values.values[values.start+right]; output+=1; right+=1; right_count-=1;
                    if(right_count==0) { finish = 1; }
                }
                if(finish==0) {
                    count = gallop_left<T,C>(values,scratch.values[scratch.start+left],right,right_count,comparator);
                    right_wins = count;
                    if(count>0) {
                        copy_range<T>(values,right,values,output,count); output+=count; right+=count; right_count-=count;
                        if(right_count==0) { finish = 1; }
                    }
                }
                if(finish==0) {
                    values.values[values.start+output] = scratch.values[scratch.start+left]; output+=1; left+=1; left_count-=1;
                    if(left_count==1) { finish = 2; }
                }
                if(finish==0 && left_wins<MIN_GALLOP && right_wins<MIN_GALLOP) { galloping = false; }
            }
            if(finish==0) { gallop+=1; }
        }
    }
    if(finish==1) { copy_range<T>(scratch,left,values,output,left_count); }
    else {
        copy_range<T>(values,right,values,output,right_count);
        values.values[values.start+output+right_count] = scratch.values[scratch.start+left];
    }
    return gallop;
}
// Mirror of merge_low with the right run in scratch, back to front.
fn merge_high<T,C>(values:View<T>,scratch:View<T>,start:i32,middle:i32,end:i32,threshold:i32,comparator:&C) -> i32 where C:Less<T> {
    let left_count:i32 = middle-start; let right_count:i32 = end-middle;
    copy_range<T>(values,middle,scratch,0,right_count);
    let gallop:i32 = threshold;
    let output:i32 = end-1; let left:i32 = middle-1; let right:i32 = right_count-1;
    values.values[values.start+output] = values.values[values.start+left]; output-=1; left-=1; left_count-=1;
    // finish 1: copy the right remainder; finish 2: one right item remains first.
    let finish:i32 = 0;
    if(left_count==0) { finish = 1; } else { if(right_count==1) { finish = 2; } }
    while(finish==0) {
        let left_wins:i32 = 0; let right_wins:i32 = 0;
        let straight:bool = true;
        while(straight && finish==0) {
            if(comparator.less(scratch.values[scratch.start+right],values.values[values.start+left])) {
                values.values[values.start+output] = values.values[values.start+left]; output-=1; left-=1; left_count-=1;
                left_wins+=1; right_wins=0;
                if(left_count==0) { finish = 1; } else { if(left_wins>=gallop) { straight = false; } }
            } else {
                values.values[values.start+output] = scratch.values[scratch.start+right]; output-=1; right-=1; right_count-=1;
                right_wins+=1; left_wins=0;
                if(right_count==1) { finish = 2; } else { if(right_wins>=gallop) { straight = false; } }
            }
        }
        if(finish==0) {
            gallop+=1;
            let galloping:bool = true;
            while(galloping && finish==0) {
                if(gallop>1) { gallop-=1; }
                let count:i32 = suffix_greater<T,C>(values,scratch.values[scratch.start+right],start,left_count,comparator);
                left_wins = count;
                if(count>0) {
                    copy_range<T>(values,left-count+1,values,output-count+1,count);
                    output-=count; left-=count; left_count-=count;
                    if(left_count==0) { finish = 1; }
                }
                if(finish==0) {
                    values.values[values.start+output] = scratch.values[scratch.start+right]; output-=1; right-=1; right_count-=1;
                    if(right_count==1) { finish = 2; }
                }
                if(finish==0) {
                    count = suffix_not_less<T,C>(scratch,values.values[values.start+left],0,right_count,comparator);
                    right_wins = count;
                    if(count>0) {
                        copy_range<T>(scratch,right-count+1,values,output-count+1,count);
                        output-=count; right-=count; right_count-=count;
                        if(right_count==1) { finish = 2; } else { if(right_count==0) { finish = 1; } }
                    }
                }
                if(finish==0) {
                    values.values[values.start+output] = values.values[values.start+left]; output-=1; left-=1; left_count-=1;
                    if(left_count==0) { finish = 1; }
                }
                if(finish==0 && left_wins<MIN_GALLOP && right_wins<MIN_GALLOP) { galloping = false; }
            }
            if(finish==0) { gallop+=1; }
        }
    }
    if(finish==1) { copy_range<T>(scratch,0,values,output-right_count+1,right_count); }
    else {
        copy_range<T>(values,left-left_count+1,values,output-left_count+1,left_count);
        values.values[values.start+output-left_count] = scratch.values[scratch.start+0];
    }
    return gallop;
}
// Merge adjacent sorted runs [low,middle) and [middle,high). Galloping first
// skips the left prefix and right suffix already in place; the smaller
// remainder goes to scratch.
fn merge_runs<T,C>(values:View<T>,scratch:View<T>,low:i32,middle:i32,high:i32,threshold:i32,comparator:&C) -> i32 where C:Less<T> {
    let start:i32 = low+gallop_right<T,C>(values,values.values[values.start+middle],low,middle-low,comparator);
    if(start==middle) { return threshold; }
    let end:i32 = high-suffix_not_less<T,C>(values,values.values[values.start+middle-1],middle,high-middle,comparator);
    if(end==middle) { return threshold; }
    if(middle-start<=end-middle) { return merge_low<T,C>(values,scratch,start,middle,end,threshold,comparator); }
    return merge_high<T,C>(values,scratch,start,middle,end,threshold,comparator);
}
fn min_run_length(length:i32) -> i32 {
    let rest:i32 = length; let carry:i32 = 0;
    while(rest>=32) { carry = carry | (rest&1); rest = rest/2; }
    return rest+carry;
}
fn stable_engine<T,C>(values:View<T>,scratch:View<T>,comparator:&C) -> i32 where C:Less<T> {
    let n:i32 = values.length;
    if(n<2) { return n; }
    if(n<=20) {
        binary_insertion<T,C>(values,0,count_run<T,C>(values,0,n,comparator),n,comparator);
        return n;
    }
    let minimum:i32 = min_run_length(n);
    // The invariants keep run lengths growing faster than Fibonacci, so 64
    // pending runs cover every i32 length.
    let starts:[i32;64] = [0;64];
    let lengths:[i32;64] = [0;64];
    let top:i32 = 0;
    let gallop:i32 = MIN_GALLOP;
    let low:i32 = 0;
    while(low<n) {
        let end:i32 = count_run<T,C>(values,low,n,comparator);
        if(end-low<minimum) {
            let forced:i32 = n;
            if(n-low>minimum) { forced = low+minimum; }
            binary_insertion<T,C>(values,low,end,forced,comparator);
            end = forced;
        }
        assert(top<64);
        starts[top]=low; lengths[top]=end-low; top+=1;
        let collapsing:bool = true;
        while(collapsing && top>1) {
            let at:i32 = top-2;
            let merge:bool = false;
            if((at>0 && lengths[at-1]<=lengths[at]+lengths[at+1]) || (at>1 && lengths[at-2]<=lengths[at-1]+lengths[at])) {
                if(lengths[at-1]<lengths[at+1]) { at-=1; }
                merge = true;
            } else {
                if(lengths[at]<=lengths[at+1]) { merge = true; }
            }
            if(merge) {
                gallop = merge_runs<T,C>(values,scratch,starts[at],starts[at+1],starts[at+1]+lengths[at+1],gallop,comparator);
                lengths[at]+=lengths[at+1];
                let shift:i32 = at+1;
                while(shift+1<top) { starts[shift]=starts[shift+1]; lengths[shift]=lengths[shift+1]; shift+=1; }
                top-=1;
            } else {
                collapsing = false;
            }
        }
        low = end;
    }
    while(top>1) {
        let at:i32 = top-2;
        if(at>0 && lengths[at-1]<lengths[at+1]) { at-=1; }
        gallop = merge_runs<T,C>(values,scratch,starts[at],starts[at+1],starts[at+1]+lengths[at+1],gallop,comparator);
        lengths[at]+=lengths[at+1];
        let shift:i32 = at+1;
        while(shift+1<top) { starts[shift]=starts[shift+1]; lengths[shift]=lengths[shift+1]; shift+=1; }
        top-=1;
    }
    return n;
}
// Stable sort using caller scratch of at least values.length/2 elements.
// Bounds for an invalid view, InvalidSize for short scratch; both precede any
// read or call. Scratch is overwritten with shallow copies and grants no
// cleanup authority; it must not overlap values.
pub fn sort_stable_by<T,C>(values:View<T>,scratch:View<T>,comparator:&C) -> core::result::Result<i32,ViewError>
    where C:core::ordering::Comparator<T,T> {
    if(!view_valid<T>(values) || !view_valid<T>(scratch)) { return core::result::Err(ViewError::Bounds); }
    if(scratch.length<values.length/2) { return core::result::Err(ViewError::InvalidSize); }
    let less:ComparatorLess<T,C> = ComparatorLess { comparator:comparator };
    return core::result::Ok(stable_engine<T,ComparatorLess<T,C>>(values,scratch,less.borrow()));
}
pub fn sort_stable<T>(values:View<T>,scratch:View<T>) -> core::result::Result<i32,ViewError> where T:core::cmp::Ord<T> {
    if(!view_valid<T>(values) || !view_valid<T>(scratch)) { return core::result::Err(ViewError::Bounds); }
    if(scratch.length<values.length/2) { return core::result::Err(ViewError::InvalidSize); }
    let less:NaturalLess<T> = NaturalLess {};
    return core::result::Ok(stable_engine<T,NaturalLess<T>>(values,scratch,less.borrow()));
}
