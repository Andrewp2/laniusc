// A concrete result for a two-word signed value and an i32 error code.
// The inactive high word is zero. On Err, low stores the error's 32-bit
// pattern; callers must inspect success before reading the value.
module core::result_wide_i64;
import core::wide_i64;

pub struct ResultWideI64 {
    success: bool,
    high: u32,
    low: u32,
}

pub fn ok(value: core::wide_i64::WideI64) -> ResultWideI64 {
    return ResultWideI64 {
        success: true,
        high: core::wide_i64::high_word(value),
        low: core::wide_i64::low_word(value),
    };
}

pub fn err(error: i32) -> ResultWideI64 {
    let bits: u32 = error;
    return ResultWideI64 { success: false, high: 0, low: bits };
}

pub fn is_ok(value: ResultWideI64) -> bool {
    return value.success;
}

pub fn is_err(value: ResultWideI64) -> bool {
    return !value.success;
}

pub fn contains(value: ResultWideI64, expected: core::wide_i64::WideI64) -> bool {
    return value.success && value.high == core::wide_i64::high_word(expected) &&
        value.low == core::wide_i64::low_word(expected);
}

pub fn contains_err(value: ResultWideI64, expected: i32) -> bool {
    let stored: i32 = value.low;
    return !value.success && stored == expected;
}

pub fn unwrap_or(
    value: ResultWideI64, fallback: core::wide_i64::WideI64
) -> core::wide_i64::WideI64 {
    if (value.success) { return core::wide_i64::from_words(value.high, value.low); }
    return fallback;
}

pub fn unwrap_err_or(value: ResultWideI64, fallback: i32) -> i32 {
    if (!value.success) {
        let stored: i32 = value.low;
        return stored;
    }
    return fallback;
}

pub fn or(value: ResultWideI64, fallback: ResultWideI64) -> ResultWideI64 {
    if (value.success) { return value; }
    return fallback;
}

pub fn and(value: ResultWideI64, next: ResultWideI64) -> ResultWideI64 {
    if (value.success) { return next; }
    return value;
}
