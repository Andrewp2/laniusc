// Allocation-free floating ranges using IEEE comparisons. A NaN endpoint
// makes a bounded range empty; NaN never belongs to an ordered range.
module core::range_f32;
import core::f32;

// Half-open [start, end). Equal or reversed bounds are empty.
pub fn half_open_is_empty(start: f32, end: f32) -> bool {
    return core::f32::is_nan(start) || core::f32::is_nan(end) || start >= end;
}

pub fn half_open_contains(start: f32, end: f32, value: f32) -> bool {
    return !half_open_is_empty(start, end) && value >= start && value < end;
}

pub fn half_open_overlaps(left_start: f32, left_end: f32, right_start: f32, right_end: f32) -> bool {
    return !half_open_is_empty(left_start, left_end) &&
        !half_open_is_empty(right_start, right_end) &&
        left_start < right_end && right_start < left_end;
}

// Inclusive [start, end]. Equal bounds contain exactly one ordered value.
pub fn inclusive_is_empty(start: f32, end: f32) -> bool {
    return core::f32::is_nan(start) || core::f32::is_nan(end) || start > end;
}

pub fn inclusive_contains(start: f32, end: f32, value: f32) -> bool {
    return !inclusive_is_empty(start, end) && value >= start && value <= end;
}

pub fn inclusive_overlaps(left_start: f32, left_end: f32, right_start: f32, right_end: f32) -> bool {
    return !inclusive_is_empty(left_start, left_end) &&
        !inclusive_is_empty(right_start, right_end) &&
        left_start <= right_end && right_start <= left_end;
}

pub fn from_contains(start: f32, value: f32) -> bool {
    return value >= start;
}

pub fn to_contains(end: f32, value: f32) -> bool {
    return value < end;
}

// Full contains every f32 value, including NaN.
pub fn full_contains(value: f32) -> bool {
    return true;
}

pub struct RangeF32 { start: f32, end: f32, }
pub struct RangeInclusiveF32 { start: f32, end: f32, }
pub struct RangeFromF32 { start: f32, }
pub struct RangeToF32 { end: f32, }

pub fn range(start: f32, end: f32) -> RangeF32 {
    return RangeF32 { start: start, end: end };
}
pub fn start(value: RangeF32) -> f32 { return value.start; }
pub fn end(value: RangeF32) -> f32 { return value.end; }
pub fn is_empty(value: RangeF32) -> bool {
    return half_open_is_empty(value.start, value.end);
}
pub fn contains(value: RangeF32, item: f32) -> bool {
    return half_open_contains(value.start, value.end, item);
}
pub fn overlaps(left: RangeF32, right: RangeF32) -> bool {
    return half_open_overlaps(left.start, left.end, right.start, right.end);
}

pub fn range_inclusive(start: f32, end: f32) -> RangeInclusiveF32 {
    return RangeInclusiveF32 { start: start, end: end };
}
pub fn start_inclusive(value: RangeInclusiveF32) -> f32 { return value.start; }
pub fn end_inclusive(value: RangeInclusiveF32) -> f32 { return value.end; }
pub fn is_empty_inclusive(value: RangeInclusiveF32) -> bool {
    return inclusive_is_empty(value.start, value.end);
}
pub fn contains_inclusive(value: RangeInclusiveF32, item: f32) -> bool {
    return inclusive_contains(value.start, value.end, item);
}
pub fn overlaps_inclusive(left: RangeInclusiveF32, right: RangeInclusiveF32) -> bool {
    return inclusive_overlaps(left.start, left.end, right.start, right.end);
}

pub fn range_from(start: f32) -> RangeFromF32 {
    return RangeFromF32 { start: start };
}
pub fn start_from(value: RangeFromF32) -> f32 { return value.start; }
pub fn contains_from(value: RangeFromF32, item: f32) -> bool {
    return from_contains(value.start, item);
}

pub fn range_to(end: f32) -> RangeToF32 {
    return RangeToF32 { end: end };
}
pub fn end_to(value: RangeToF32) -> f32 { return value.end; }
pub fn contains_to(value: RangeToF32, item: f32) -> bool {
    return to_contains(value.end, item);
}

pub impl RangeF32 {
    pub fn start(&self) -> f32 { return self.start; }
    pub fn end(&self) -> f32 { return self.end; }
    pub fn is_empty(&self) -> bool {
        return half_open_is_empty(self.start, self.end);
    }
    pub fn contains(&self, item: f32) -> bool {
        return half_open_contains(self.start, self.end, item);
    }
    pub fn overlaps(&self, other: RangeF32) -> bool {
        return half_open_overlaps(self.start, self.end, other.start, other.end);
    }
}

pub impl RangeInclusiveF32 {
    pub fn start(&self) -> f32 { return self.start; }
    pub fn end(&self) -> f32 { return self.end; }
    pub fn is_empty(&self) -> bool {
        return inclusive_is_empty(self.start, self.end);
    }
    pub fn contains(&self, item: f32) -> bool {
        return inclusive_contains(self.start, self.end, item);
    }
    pub fn overlaps(&self, other: RangeInclusiveF32) -> bool {
        return inclusive_overlaps(self.start, self.end, other.start, other.end);
    }
}

pub impl RangeFromF32 {
    pub fn start(&self) -> f32 { return self.start; }
    pub fn contains(&self, item: f32) -> bool {
        return from_contains(self.start, item);
    }
}

pub impl RangeToF32 {
    pub fn end(&self) -> f32 { return self.end; }
    pub fn contains(&self, item: f32) -> bool {
        return to_contains(self.end, item);
    }
}
