// A concrete character result until generic enum values execute natively.
// The inactive payload is NUL; inspect success before reading a payload.
module core::result_char;

pub struct ResultChar {
    success: bool,
    value: char,
    error: char,
}

pub fn ok(value: char) -> ResultChar {
    return ResultChar { success: true, value: value, error: '\0' };
}

pub fn err(error: char) -> ResultChar {
    return ResultChar { success: false, value: '\0', error: error };
}

pub fn is_ok(value: ResultChar) -> bool {
    return value.success;
}

pub fn is_err(value: ResultChar) -> bool {
    return !value.success;
}

pub fn contains(value: ResultChar, expected: char) -> bool {
    return value.success && value.value == expected;
}

pub fn contains_err(value: ResultChar, expected: char) -> bool {
    return !value.success && value.error == expected;
}

pub fn unwrap_or(value: ResultChar, fallback: char) -> char {
    if (value.success) { return value.value; }
    return fallback;
}

pub fn unwrap_err_or(value: ResultChar, fallback: char) -> char {
    if (!value.success) { return value.error; }
    return fallback;
}

pub fn or(value: ResultChar, fallback: ResultChar) -> ResultChar {
    if (value.success) { return value; }
    return fallback;
}

pub fn and(value: ResultChar, next: ResultChar) -> ResultChar {
    if (value.success) { return next; }
    return value;
}
