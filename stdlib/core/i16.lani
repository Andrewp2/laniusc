// Module-form signed halfword helpers. Operations that can overflow either
// saturate, wrap, or return OptionI16 as named.
module core::i16;

import core::number_i16;
import core::option_i16;

pub const MIN: i16 = -32768;
pub const MAX: i16 = 32767;
pub const BITS: u32 = 16;
pub const BYTES: u32 = 2;

// The mathematical absolute value of MIN cannot fit; return MAX there.
pub fn abs(value: i16) -> i16 {
    return core::number_i16::saturating_abs(value);
}

pub fn saturating_abs(value: i16) -> i16 {
    return core::number_i16::saturating_abs(value);
}

pub fn checked_abs(value: i16) -> core::option_i16::OptionI16 {
    if (value == MIN) {
        return core::option_i16::none();
    }
    return core::option_i16::some(abs(value));
}

pub fn min(left: i16, right: i16) -> i16 {
    return core::number_i16::min(left, right);
}

pub fn max(left: i16, right: i16) -> i16 {
    return core::number_i16::max(left, right);
}

// Reversed bounds leave the input unchanged.
pub fn clamp(value: i16, low: i16, high: i16) -> i16 {
    return core::number_i16::clamp_or(value, low, high, value);
}

pub fn signum(value: i16) -> i16 {
    return core::number_i16::signum(value);
}

pub fn is_zero(value: i16) -> bool {
    return core::number_i16::is_zero(value);
}

pub fn is_nonzero(value: i16) -> bool {
    return !core::number_i16::is_zero(value);
}

pub fn is_even(value: i16) -> bool {
    return core::number_i16::is_even(value);
}

pub fn is_odd(value: i16) -> bool {
    return core::number_i16::is_odd(value);
}

pub fn is_negative(value: i16) -> bool {
    return value < 0;
}

pub fn is_positive(value: i16) -> bool {
    return value > 0;
}

pub fn is_nonnegative(value: i16) -> bool {
    return value >= 0;
}

pub fn is_nonpositive(value: i16) -> bool {
    return value <= 0;
}

pub fn between_inclusive(value: i16, low: i16, high: i16) -> bool {
    return value >= low && value <= high;
}

pub fn between_exclusive(value: i16, low: i16, high: i16) -> bool {
    return value > low && value < high;
}

pub fn compare_as_i32(left: i16, right: i16) -> i32 {
    if (left < right) {
        return -1;
    }
    if (left > right) {
        return 1;
    }
    return 0;
}

pub fn wrapping_add(left: i16, right: i16) -> i16 {
    return core::number_i16::wrapping_add(left, right);
}

pub fn wrapping_sub(left: i16, right: i16) -> i16 {
    return core::number_i16::wrapping_sub(left, right);
}

pub fn wrapping_mul(left: i16, right: i16) -> i16 {
    return core::number_i16::wrapping_mul(left, right);
}

pub fn checked_add(left: i16, right: i16) -> core::option_i16::OptionI16 {
    let wide_left: i32 = left as i32;
    let wide_right: i32 = right as i32;
    let sum: i32 = wide_left + wide_right;
    if (sum < -32768 || sum > 32767) {
        return core::option_i16::none();
    }
    let narrowed: i16 = sum as i16;
    return core::option_i16::some(narrowed);
}

pub fn saturating_add(left: i16, right: i16) -> i16 {
    return core::number_i16::saturating_add(left, right);
}

pub fn checked_sub(left: i16, right: i16) -> core::option_i16::OptionI16 {
    let wide_left: i32 = left as i32;
    let wide_right: i32 = right as i32;
    let difference: i32 = wide_left - wide_right;
    if (difference < -32768 || difference > 32767) {
        return core::option_i16::none();
    }
    let narrowed: i16 = difference as i16;
    return core::option_i16::some(narrowed);
}

pub fn saturating_sub(left: i16, right: i16) -> i16 {
    return core::number_i16::saturating_sub(left, right);
}

pub fn saturating_abs_diff(left: i16, right: i16) -> i16 {
    return core::number_i16::saturating_abs_diff(left, right);
}

pub fn is_power_of_two(value: i16) -> bool {
    return core::number_i16::is_power_of_two(value);
}

// Zero signals that the next positive power cannot fit in i16.
pub fn next_power_of_two(value: i16) -> i16 {
    return core::number_i16::next_power_of_two(value);
}
