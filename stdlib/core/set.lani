// Inline insertion-ordered set. Equality is the complete lawful Eq<T>
// relation, never a truncated key. No allocation or nested destruction.
// Operations borrow the owner; by-value copies own independent shallow arrays.
module core::set;
import core::cmp;
import core::option;
import core::panic;
import core::result;
import core::slice;
pub enum Error {
    Full
}
pub struct Set<T, const N: usize> {
    items:[T; N],
    length: i32
}
pub fn from_storage<T, const N: usize>(storage:[T; N]) -> Set<T, N> {
    let count: usize = N;
    if (count>2147483647) {
        core::panic::panic();
    }
    return Set {
        items: storage,
        length: 0
    };
}
pub impl<T, const N: usize>Set<T, N> {
    pub fn borrow(&self) -> &Set<T,
    N> {
        return self;
    }
}
pub fn len<T, const N: usize>(value: &Set<T, N>) -> i32 {
    return value.length;
}
pub fn capacity<T, const N: usize>(value: &Set<T, N>) -> i32 {
    let count: usize = N;
    return count as i32;
}
pub fn is_empty<T, const N: usize>(value: &Set<T, N>) -> bool {
    return value.length == 0;
}
pub fn is_full<T, const N: usize>(value: &Set<T, N>) -> bool {
    return(value.length as usize) == N;
}
pub fn contains<T, const N: usize>(value: &Set<T, N>, item: T) -> bool
where
    T: core::cmp::Eq<T>
{
    return position_or(value, item, -1) >= 0;
}
pub fn position<T, const N: usize>(value: &Set<T, N>, item: T) -> core::option::Option<i32>
where
    T: core::cmp::Eq<T>
{
    let found: i32 = position_or(value, item, -1);
    if (found<0) {
        return core::option::None();
    }
    return core::option::Some(found);
}
pub fn position_or<T, const N: usize>(value: &Set<T, N>, item: T, fallback: i32) -> i32
where
    T: core::cmp::Eq<T>
{
    let index: i32 = 0;
    while (index<value.length) {
        if (T::eq(value.items[index], item)) {
            return index;
        }
        index += 1;
    }
    return fallback;
}
pub fn get<T, const N: usize>(value: &Set<T, N>, ordinal: i32) -> core::option::Option<T> {
    if (ordinal<0 || ordinal >= value.length) {
        return core::option::None();
    }
    return core::option::Some(value.items[ordinal]);
}
pub fn at_or<T, const N: usize>(value: &Set<T, N>, ordinal: i32, fallback: T) -> T {
    if (ordinal<0 || ordinal >= value.length) {
        return fallback;
    }
    return value.items[ordinal];
}
// Ok(true): inserted; Ok(false): present, even when full; Err: no writes.
pub fn try_insert<T, const N: usize>(value: &Set<T, N>, item: T) -> core::result::Result<bool, Error>
where
    T: core::cmp::Eq<T>
{
    if (position_or(value, item, -1) >= 0) {
        return core::result::Ok(false);
    }
    if ((value.length as usize) == N) {
        return core::result::Err(Error::Full);
    }
    value.items[value.length] = item;
    value.length += 1;
    return core::result::Ok(true);
}
// Return the stored representative; absent removal is None without writes.
pub fn remove<T, const N: usize>(value: &Set<T, N>, item: T) -> core::option::Option<T>
where
    T: core::cmp::Eq<T>
{
    let found: i32 = position_or(value, item, -1);
    if (found<0) {
        return core::option::None();
    }
    let removed: T = value.items[found];
    let cursor: i32 = found;
    while (cursor + 1<value.length) {
        value.items[cursor] = value.items[cursor + 1];
        cursor += 1;
    }
    value.length -= 1;
    return core::option::Some(removed);
}
pub fn clear<T, const N: usize>(value: &Set<T, N>) -> i32 {
    let removed: i32 = value.length;
    value.length = 0;
    return removed;
}
// Read through cursor operations; mutating cursor backing violates uniqueness.
pub fn iter<T, const N: usize>(value: &Set<T, N>) -> core::slice::Iter<T> {
    return core::slice::Iter {
        values: value.items,
        front: 0,
        back: value.length
    };
}
pub fn is_subset<T, const N: usize, const M: usize>(value: &Set<T, N>, other: &Set<T, M>) -> bool
where
    T: core::cmp::Eq<T>
{
    let index: i32 = 0;
    while (index<value.length) {
        if (!contains(other, value.items[index])) {
            return false;
        }
        index += 1;
    }
    return true;
}
pub fn is_disjoint<T, const N: usize, const M: usize>(value: &Set<T, N>, other: &Set<T, M>) -> bool
where
    T: core::cmp::Eq<T>
{
    let index: i32 = 0;
    while (index<value.length) {
        if (contains(other, value.items[index])) {
            return false;
        }
        index += 1;
    }
    return true;
}
pub fn equals<T, const N: usize, const M: usize>(value: &Set<T, N>, other: &Set<T, M>) -> bool
where
    T: core::cmp::Eq<T>
{
    return value.length == other.length && is_subset(value, other);
}
