// Allocation-free operations on caller-backed character views. Characters
// compare by Unicode scalar value. Every logical length must fit the physical
// backing; native indexing traps when an overclaim reaches beyond that view.
module core::slice_char;

pub fn get_or(values: [char], len: i32, index: i32, fallback: char) -> char {
    if (len <= 0 || index < 0 || index >= len) { return fallback; }
    return values[index];
}

pub fn first_or(values: [char], len: i32, fallback: char) -> char {
    return get_or(values, len, 0, fallback);
}

// Invalid indices leave the view unchanged.
pub fn set(values: [char], len: i32, index: i32, value: char) -> bool {
    if (len <= 0 || index < 0 || index >= len) { return false; }
    values[index] = value;
    return true;
}

// A nonpositive length writes nothing and returns zero.
pub fn fill(values: [char], len: i32, value: char) -> i32 {
    let index: i32 = 0;
    while (index < len) { values[index] = value; index += 1; }
    return index;
}

pub fn swap(values: [char], len: i32, left: i32, right: i32) -> bool {
    if (len <= 0 || left < 0 || right < 0 || left >= len || right >= len) {
        return false;
    }
    let previous: char = values[left];
    values[left] = values[right];
    values[right] = previous;
    return true;
}

// Copies within one view, including overlapping ranges. Invalid logical
// bounds return false before writing.
pub fn copy_within(values: [char], len: i32, start: i32, end: i32, destination: i32) -> bool {
    if (len < 0 || start < 0 || end < start || end > len || destination < 0) {
        return false;
    }
    let count: i32 = end - start;
    if (destination > len - count) { return false; }
    if (destination > start) {
        let remaining: i32 = count;
        while (remaining > 0) {
            remaining -= 1;
            values[destination + remaining] = values[start + remaining];
        }
    } else {
        let offset: i32 = 0;
        while (offset < count) {
            values[destination + offset] = values[start + offset];
            offset += 1;
        }
    }
    return true;
}

// Returns the number of characters in the reversed logical prefix.
pub fn reverse(values: [char], len: i32) -> i32 {
    if (len <= 0) { return 0; }
    let left: i32 = 0;
    let right: i32 = len - 1;
    while (left < right) {
        let previous: char = values[left];
        values[left] = values[right];
        values[right] = previous;
        left += 1;
        right -= 1;
    }
    return len;
}

fn reverse_segment(values: [char], start: i32, end: i32) {
    let left: i32 = start;
    let right: i32 = end - 1;
    while (left < right) {
        let previous: char = values[left];
        values[left] = values[right];
        values[right] = previous;
        left += 1;
        right -= 1;
    }
}

// Rotates the logical prefix by an amount in [0, len]. Invalid bounds leave
// the view unchanged. Empty views accept a zero rotation.
pub fn rotate_left(values: [char], len: i32, amount: i32) -> bool {
    if (len < 0 || amount < 0 || amount > len) { return false; }
    if (amount == 0 || amount == len) { return true; }
    reverse_segment(values, 0, amount);
    reverse_segment(values, amount, len);
    reverse_segment(values, 0, len);
    return true;
}

pub fn rotate_right(values: [char], len: i32, amount: i32) -> bool {
    if (len < 0 || amount < 0 || amount > len) { return false; }
    return rotate_left(values, len, len - amount);
}

// Copies the shorter prefix. Negative lengths return -1 without writing.
// The ranges must be disjoint or start at the same element; otherwise use
// copy_within for overlap in one view.
pub fn copy_prefix(source: [char], source_len: i32, destination: [char], destination_len: i32) -> i32 {
    if (source_len < 0 || destination_len < 0) { return -1; }
    let count: i32 = source_len;
    if (destination_len < count) { count = destination_len; }
    let index: i32 = 0;
    while (index < count) {
        destination[index] = source[index];
        index += 1;
    }
    return count;
}

// Copies a checked range between disjoint source and destination backings.
// destination_len is writable capacity. Invalid bounds write nothing.
pub fn copy_nonoverlapping_range(
    destination: [char], destination_len: i32, destination_start: i32,
    source: [char], source_len: i32, source_start: i32, count: i32
) -> bool {
    if (destination_len < 0 || source_len < 0 || count < 0 ||
        destination_start < 0 || source_start < 0 ||
        count > destination_len || count > source_len ||
        destination_start > destination_len - count ||
        source_start > source_len - count) { return false; }
    let index: i32 = 0;
    while (index < count) {
        destination[destination_start + index] = source[source_start + index];
        index += 1;
    }
    return true;
}

pub fn contains(values: [char], len: i32, target: char) -> bool {
    return first_index_or(values, len, target, -1) >= 0;
}

// A negative length returns -1; an empty view returns zero.
pub fn count(values: [char], len: i32, target: char) -> i32 {
    if (len < 0) { return -1; }
    let found: i32 = 0;
    let index: i32 = 0;
    while (index < len) {
        if (values[index] == target) { found += 1; }
        index += 1;
    }
    return found;
}

pub fn first_index_or(values: [char], len: i32, target: char, fallback: i32) -> i32 {
    let index: i32 = 0;
    while (index < len) {
        if (values[index] == target) { return index; }
        index += 1;
    }
    return fallback;
}

pub fn last_index_or(values: [char], len: i32, target: char, fallback: i32) -> i32 {
    let remaining: i32 = len;
    while (remaining > 0) {
        remaining -= 1;
        if (values[remaining] == target) { return remaining; }
    }
    return fallback;
}

// Compacts consecutive equal characters and returns the new logical length.
// A negative length returns -1 without writing. The tail is unspecified.
pub fn dedup_adjacent(values: [char], len: i32) -> i32 {
    if (len < 0) { return -1; }
    if (len == 0) { return 0; }
    let write: i32 = 1;
    let read: i32 = 1;
    while (read < len) {
        let current: char = values[read];
        if (current != values[write - 1]) {
            values[write] = current;
            write += 1;
        }
        read += 1;
    }
    return write;
}

// Retains order, returning the new logical length. A negative length returns
// -1 without writing. The tail is unspecified.
pub fn retain_not_equal(values: [char], len: i32, target: char) -> i32 {
    if (len < 0) { return -1; }
    let read: i32 = 0;
    let write: i32 = 0;
    while (read < len) {
        let current: char = values[read];
        if (current != target) {
            values[write] = current;
            write += 1;
        }
        read += 1;
    }
    return write;
}

// Valid removal shifts the suffix left. The caller reduces its logical len
// by one after success; the old last slot is unspecified.
pub fn remove_at(values: [char], len: i32, index: i32) -> bool {
    if (len <= 0 || index < 0 || index >= len) { return false; }
    let read: i32 = index + 1;
    while (read < len) {
        values[read - 1] = values[read];
        read += 1;
    }
    return true;
}

// Capacity must fit writable backing. Successful insertion grows the logical
// length by one; invalid bounds leave all elements unchanged.
pub fn insert(values: [char], len: i32, capacity: i32, index: i32, value: char) -> bool {
    if (len < 0 || capacity <= 0 || len >= capacity || index < 0 || index > len) {
        return false;
    }
    let cursor: i32 = len;
    while (cursor > index) {
        values[cursor] = values[cursor - 1];
        cursor -= 1;
    }
    values[index] = value;
    return true;
}

pub fn push(values: [char], len: i32, capacity: i32, value: char) -> bool {
    return insert(values, len, capacity, len, value);
}

pub fn min_or(values: [char], len: i32, fallback: char) -> char {
    if (len <= 0) { return fallback; }
    let result: char = values[0];
    let index: i32 = 1;
    while (index < len) {
        if (values[index] < result) { result = values[index]; }
        index += 1;
    }
    return result;
}

pub fn max_or(values: [char], len: i32, fallback: char) -> char {
    if (len <= 0) { return fallback; }
    let result: char = values[0];
    let index: i32 = 1;
    while (index < len) {
        if (values[index] > result) { result = values[index]; }
        index += 1;
    }
    return result;
}

// Partitions values less than pivot before all other values. Returns the
// boundary, or -1 for a negative length without writing. Order within each
// partition is unspecified; all original values are preserved.
pub fn partition_lt(values: [char], len: i32, pivot: char) -> i32 {
    if (len < 0) { return -1; }
    let write: i32 = 0;
    let read: i32 = 0;
    while (read < len) {
        if (values[read] < pivot) {
            let previous: char = values[write];
            values[write] = values[read];
            values[read] = previous;
            write += 1;
        }
        read += 1;
    }
    return write;
}

// Negative or unequal lengths are unequal; two empty views are equal.
pub fn equal(left: [char], left_len: i32, right: [char], right_len: i32) -> bool {
    if (left_len < 0 || right_len < 0 || left_len != right_len) { return false; }
    let index: i32 = 0;
    while (index < left_len) {
        if (left[index] != right[index]) { return false; }
        index += 1;
    }
    return true;
}

pub fn starts_with(values: [char], len: i32, prefix: [char], prefix_len: i32) -> bool {
    if (len < 0 || prefix_len < 0 || prefix_len > len) { return false; }
    let index: i32 = 0;
    while (index < prefix_len) {
        if (values[index] != prefix[index]) { return false; }
        index += 1;
    }
    return true;
}

pub fn ends_with(values: [char], len: i32, suffix: [char], suffix_len: i32) -> bool {
    if (len < 0 || suffix_len < 0 || suffix_len > len) { return false; }
    let start: i32 = len - suffix_len;
    let index: i32 = 0;
    while (index < suffix_len) {
        if (values[start + index] != suffix[index]) { return false; }
        index += 1;
    }
    return true;
}

// Returns -1, 0, or 1. Negative lengths return the caller's fallback.
pub fn compare_lexicographic_or(left: [char], left_len: i32, right: [char], right_len: i32, fallback: i32) -> i32 {
    if (left_len < 0 || right_len < 0) { return fallback; }
    let common: i32 = left_len;
    if (right_len < common) { common = right_len; }
    let index: i32 = 0;
    while (index < common) {
        if (left[index] < right[index]) { return -1; }
        if (left[index] > right[index]) { return 1; }
        index += 1;
    }
    if (left_len < right_len) { return -1; }
    if (left_len > right_len) { return 1; }
    return 0;
}

// An empty needle matches at index zero. Invalid lengths or a missing
// sequence return fallback.
pub fn index_of_subslice_or(values: [char], len: i32, needle: [char], needle_len: i32, fallback: i32) -> i32 {
    if (len < 0 || needle_len < 0 || needle_len > len) { return fallback; }
    let start: i32 = 0;
    while (start <= len - needle_len) {
        let offset: i32 = 0;
        while (offset < needle_len && values[start + offset] == needle[offset]) {
            offset += 1;
        }
        if (offset == needle_len) { return start; }
        start += 1;
    }
    return fallback;
}

// An empty needle matches at the end of the logical view.
pub fn last_index_of_subslice_or(values: [char], len: i32, needle: [char], needle_len: i32, fallback: i32) -> i32 {
    if (len < 0 || needle_len < 0 || needle_len > len) { return fallback; }
    let start: i32 = len - needle_len;
    while (start >= 0) {
        let offset: i32 = 0;
        while (offset < needle_len && values[start + offset] == needle[offset]) {
            offset += 1;
        }
        if (offset == needle_len) { return start; }
        start -= 1;
    }
    return fallback;
}

// Returns false for a negative length.
pub fn is_sorted(values: [char], len: i32) -> bool {
    if (len < 0) { return false; }
    let index: i32 = 1;
    while (index < len) {
        if (values[index - 1] > values[index]) { return false; }
        index += 1;
    }
    return true;
}

fn sift_down_max(values: [char], heap_len: i32, start: i32) {
    if (heap_len > 1) {
        let root: i32 = start;
        while (root <= (heap_len - 2) / 2) {
            let child: i32 = root * 2 + 1;
            let largest: i32 = root;
            if (values[largest] < values[child]) { largest = child; }
            if (child + 1 < heap_len && values[largest] < values[child + 1]) {
                largest = child + 1;
            }
            if (largest == root) { break; }
            let previous: char = values[root];
            values[root] = values[largest];
            values[largest] = previous;
            root = largest;
        }
    }
}

// In-place ascending heapsort by Unicode scalar value. Negative lengths
// return false without writing; empty views return true.
pub fn sort(values: [char], len: i32) -> bool {
    if (len < 0) { return false; }
    if (len <= 1) { return true; }
    let start: i32 = (len - 2) / 2;
    while (start >= 0) {
        sift_down_max(values, len, start);
        if (start == 0) { break; }
        start -= 1;
    }
    let remaining: i32 = len;
    while (remaining > 1) {
        remaining -= 1;
        let previous: char = values[0];
        values[0] = values[remaining];
        values[remaining] = previous;
        sift_down_max(values, remaining, 0);
    }
    return true;
}

// Validates sorted input before searching. Invalid lengths or unsorted views
// return fallback; valid insertion indices range from zero to len.
pub fn lower_bound_or(values: [char], len: i32, needle: char, fallback: i32) -> i32 {
    if (!is_sorted(values, len)) { return fallback; }
    let low: i32 = 0;
    let high: i32 = len;
    while (low < high) {
        let middle: i32 = low + (high - low) / 2;
        if (values[middle] < needle) { low = middle + 1; }
        else { high = middle; }
    }
    return low;
}

pub fn upper_bound_or(values: [char], len: i32, needle: char, fallback: i32) -> i32 {
    if (!is_sorted(values, len)) { return fallback; }
    let low: i32 = 0;
    let high: i32 = len;
    while (low < high) {
        let middle: i32 = low + (high - low) / 2;
        if (values[middle] <= needle) { low = middle + 1; }
        else { high = middle; }
    }
    return low;
}

pub fn binary_search_first_or(values: [char], len: i32, needle: char, fallback: i32) -> i32 {
    let index: i32 = lower_bound_or(values, len, needle, -1);
    if (index >= 0 && index < len && values[index] == needle) { return index; }
    return fallback;
}

pub fn binary_search_last_or(values: [char], len: i32, needle: char, fallback: i32) -> i32 {
    let after: i32 = upper_bound_or(values, len, needle, -1);
    if (after > 0 && values[after - 1] == needle) { return after - 1; }
    return fallback;
}
