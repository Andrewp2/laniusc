// In-place operations on caller-backed pairs of i32 cells. Each logical value
// occupies low word then high word. The caller supplies a logical length no
// greater than the physical backing divided by two. An overclaim may trap on
// native indexing. signed_order selects two's-complement high-word ordering;
// low words always compare as unsigned bit patterns.
module core::wide_word_cells;

pub const MAX_LENGTH: i32 = 1073741823;

fn unsigned_less(left: i32, right: i32) -> bool {
    return (left ^ -2147483648) < (right ^ -2147483648);
}

fn compare_word(left: i32, right: i32, signed_order: bool) -> i32 {
    if (signed_order) {
        if (left < right) { return -1; }
        if (left > right) { return 1; }
    } else {
        if (unsigned_less(left, right)) { return -1; }
        if (unsigned_less(right, left)) { return 1; }
    }
    return 0;
}

fn compare_pair(cells: [i32], left: i32, right: i32, signed_order: bool) -> i32 {
    let left_offset: i32 = left * 2;
    let right_offset: i32 = right * 2;
    let high: i32 = compare_word(
        cells[left_offset + 1], cells[right_offset + 1], signed_order);
    if (high != 0) { return high; }
    return compare_word(cells[left_offset], cells[right_offset], false);
}

fn compare_pair_words(cells: [i32], index: i32, high_word: i32,
                      low_word: i32, signed_order: bool) -> i32 {
    let offset: i32 = index * 2;
    let high: i32 = compare_word(cells[offset + 1], high_word, signed_order);
    if (high != 0) { return high; }
    return compare_word(cells[offset], low_word, false);
}

fn swap_pair(cells: [i32], left: i32, right: i32) {
    let left_offset: i32 = left * 2;
    let right_offset: i32 = right * 2;
    let saved_low: i32 = cells[left_offset];
    let saved_high: i32 = cells[left_offset + 1];
    cells[left_offset] = cells[right_offset];
    cells[left_offset + 1] = cells[right_offset + 1];
    cells[right_offset] = saved_low;
    cells[right_offset + 1] = saved_high;
}

fn sift_down_max(cells: [i32], heap_len: i32, start: i32, signed_order: bool) {
    let root: i32 = start;
    while (heap_len > 1 && root <= (heap_len - 2) / 2) {
        let child: i32 = root * 2 + 1;
        let largest: i32 = root;
        if (compare_pair(cells, largest, child, signed_order) < 0) {
            largest = child;
        }
        if (child + 1 < heap_len &&
            compare_pair(cells, largest, child + 1, signed_order) < 0) {
            largest = child + 1;
        }
        if (largest == root) { break; }
        swap_pair(cells, root, largest);
        root = largest;
    }
}

// Heapsort the first length pairs. Return the number sorted; invalid lengths
// write nothing and return zero. No allocation is performed.
pub fn sort(cells: [i32], length: i32, signed_order: bool) -> i32 {
    if (length <= 0 || length > MAX_LENGTH) { return 0; }
    if (length == 1) { return 1; }
    let start: i32 = (length - 2) / 2;
    while (start >= 0) {
        sift_down_max(cells, length, start, signed_order);
        if (start == 0) { break; }
        start -= 1;
    }
    let remaining: i32 = length;
    while (remaining > 1) {
        remaining -= 1;
        swap_pair(cells, 0, remaining);
        sift_down_max(cells, remaining, 0, signed_order);
    }
    return length;
}

// Reverse the first length pairs and return the number of swaps. Invalid
// lengths write nothing and return zero.
pub fn reverse_in_place(cells: [i32], length: i32) -> i32 {
    if (length <= 1 || length > MAX_LENGTH) { return 0; }
    let left: i32 = 0;
    let right: i32 = length - 1;
    let swaps: i32 = 0;
    while (left < right) {
        swap_pair(cells, left, right);
        left += 1;
        right -= 1;
        swaps += 1;
    }
    return swaps;
}

// Require nondecreasing input under the selected ordering. The bounds return
// an index in [0, length]. Invalid logical lengths return zero.
pub fn lower_bound(cells: [i32], length: i32, high_word: i32,
                   low_word: i32, signed_order: bool) -> i32 {
    if (length <= 0 || length > MAX_LENGTH) { return 0; }
    let low: i32 = 0;
    let high: i32 = length;
    while (low < high) {
        let middle: i32 = low + (high - low) / 2;
        if (compare_pair_words(cells, middle, high_word, low_word, signed_order) < 0) {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    return low;
}

pub fn upper_bound(cells: [i32], length: i32, high_word: i32,
                   low_word: i32, signed_order: bool) -> i32 {
    if (length <= 0 || length > MAX_LENGTH) { return 0; }
    let low: i32 = 0;
    let high: i32 = length;
    while (low < high) {
        let middle: i32 = low + (high - low) / 2;
        if (compare_pair_words(cells, middle, high_word, low_word, signed_order) <= 0) {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    return low;
}
