// Allocation-free signed hexadecimal formatting and parsing for two-word i64.
module core::hex_wide_i64;
import core::hex_wide_u64;
import core::wide_i64;
import core::wide_u64;
fn unsigned_magnitude(value: core::wide_i64::WideI64) -> core::wide_u64::WideU64 {
    let magnitude: core::wide_i64::WideI64 = value;
    if (core::wide_i64::is_negative(value)) {
        magnitude = core::wide_i64::wrapping_neg(value);
    }
    return core::wide_u64::from_words(core::wide_i64::high_word(magnitude), core::wide_i64::low_word(magnitude));
}
pub fn len(value: core::wide_i64::WideI64) -> u32 {
    let digits: u32 = core::hex_wide_u64::len(unsigned_magnitude(value));
    if (core::wide_i64::is_negative(value)) {
        return digits + 1;
    }
    return digits;
}
// Negative values start with ASCII minus. Zero is one digit. An out-of-range
// index returns fallback unchanged.
pub fn byte_at_lower_or(value: core::wide_i64::WideI64, index: u32, fallback: u8) -> u8 {
    if (core::wide_i64::is_negative(value)) {
        if (index == 0) {
            return 45;
        }
        return core::hex_wide_u64::byte_at_lower_or(unsigned_magnitude(value), index - 1, fallback);
    }
    return core::hex_wide_u64::byte_at_lower_or(unsigned_magnitude(value), index, fallback);
}
pub fn byte_at_upper_or(value: core::wide_i64::WideI64, index: u32, fallback: u8) -> u8 {
    if (core::wide_i64::is_negative(value)) {
        if (index == 0) {
            return 45;
        }
        return core::hex_wide_u64::byte_at_upper_or(unsigned_magnitude(value), index - 1, fallback);
    }
    return core::hex_wide_u64::byte_at_upper_or(unsigned_magnitude(value), index, fallback);
}
// Parse exactly length ASCII byte codes from a backed [i32] view. An optional
// sign and optional 0x/0X prefix precede at least one hex digit. Whitespace,
// malformed codes, and values outside signed i64 are rejected. A physical
// backing overclaim can trap.
pub fn can_parse_ascii(values:[i32], length: i32) -> bool {
    if (length <= 0) {
        return false;
    }
    let index: i32 = 0;
    let negative: bool = false;
    if (values[0] == 45) {
        negative = true;
        index = 1;
    } else {
        if (values[0] == 43) {
            index = 1;
        }
    }
    if (index == length) {
        return false;
    }
    if (length - index >= 2 && values[index] == 48 &&(values[index + 1] == 120 || values[index + 1] == 88)) {
        index += 2;
    }
    if (index == length) {
        return false;
    }
    let current: core::wide_u64::WideU64 = core::wide_u64::zero();
    let limit: core::wide_u64::WideU64 = core::wide_u64::from_words(2147483647, 4294967295);
    if (negative) {
        limit = core::wide_u64::from_words(2147483648, 0);
    }
    while (index<length) {
        let code: i32 = values[index];
        if (code<0 || code>255) {
            return false;
        }
        let digit: u8 = code as u8;
        if (!core::hex_wide_u64::can_append_ascii_digit(current, digit, limit)) {
            return false;
        }
        current = core::hex_wide_u64::append_ascii_digit_or(current, digit, limit, current);
        index += 1;
    }
    return true;
}
// A valid result may equal fallback; call can_parse_ascii to distinguish it.
pub fn parse_ascii_or(values:[i32], length: i32, fallback: core::wide_i64::WideI64) -> core::wide_i64::WideI64 {
    if (!can_parse_ascii(values, length)) {
        return fallback;
    }
    let index: i32 = 0;
    let negative: bool = false;
    if (values[0] == 45) {
        negative = true;
        index = 1;
    } else {
        if (values[0] == 43) {
            index = 1;
        }
    }
    if (length - index >= 2 && values[index] == 48 &&(values[index + 1] == 120 || values[index + 1] == 88)) {
        index += 2;
    }
    let magnitude: core::wide_u64::WideU64 = core::wide_u64::zero();
    let limit: core::wide_u64::WideU64 = core::wide_u64::from_words(2147483647, 4294967295);
    if (negative) {
        limit = core::wide_u64::from_words(2147483648, 0);
    }
    while (index<length) {
        let code: i32 = values[index];
        let digit: u8 = code as u8;
        magnitude = core::hex_wide_u64::append_ascii_digit_or(magnitude, digit, limit, magnitude);
        index += 1;
    }
    let value: core::wide_i64::WideI64 = core::wide_i64::from_words(core::wide_u64::high_word(magnitude), core::wide_u64::low_word(magnitude));
    if (negative) {
        return core::wide_i64::wrapping_neg(value);
    }
    return value;
}
