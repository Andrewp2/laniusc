// Native 32-bit signed integer operations; x86_64 Linux execution evidence.
// Arithmetic widens before evaluation, then checks, clamps or keeps low bits.
// checked_* returns Option; plain abs/clamp/div/rem/shifts/power/alignment
// conveniences trap for invalid inputs. See docs/stdlib-narrow-integers.md.
module core::i32;
import core::option;
import core::u64;
pub const MIN: i32 = -2147483648;
pub const MAX: i32 = 2147483647;
pub const BITS: u32 = 32;
pub const BYTES: u32 = 4;
fn checked(value: i64) -> core::option::Option<i32> { if (value < -2147483648 || value > 2147483647) { return core::option::None(); } return core::option::Some(value as i32); }
fn saturated(value: i64) -> i32 { if (value < -2147483648) { return MIN; } if (value > 2147483647) { return MAX; } return value as i32; }
pub fn min(left: i32, right: i32) -> i32 { if (left < right) { return left; } return right; }
pub fn max(left: i32, right: i32) -> i32 { if (left > right) { return left; } return right; }
// Reversed bounds always trap. Use checked_clamp or an explicit fallback.
pub fn clamp(value: i32, low: i32, high: i32) -> i32 { assert(low <= high); if (value < low) { return low; } if (value > high) { return high; } return value; }
pub fn checked_clamp(value: i32, low: i32, high: i32) -> core::option::Option<i32> { if (low > high) { return core::option::None(); } return core::option::Some(clamp(value,low,high)); }
pub fn clamp_or(value: i32, low: i32, high: i32, fallback: i32) -> i32 { if (low > high) { return fallback; } return clamp(value,low,high); }
pub fn is_zero(value: i32) -> bool { return value == 0; }
pub fn is_nonzero(value: i32) -> bool { return value != 0; }
pub fn is_even(value: i32) -> bool { return (value & 1) == 0; }
pub fn is_odd(value: i32) -> bool { return (value & 1) != 0; }
pub fn between_inclusive(value: i32, low: i32, high: i32) -> bool { return value >= low && value <= high; }
pub fn between_exclusive(value: i32, low: i32, high: i32) -> bool { return value > low && value < high; }
pub fn is_negative(value: i32) -> bool { return value < 0; }
pub fn is_positive(value: i32) -> bool { return value > 0; }
pub fn is_nonnegative(value: i32) -> bool { return value >= 0; }
pub fn is_nonpositive(value: i32) -> bool { return value <= 0; }
pub fn signum(value: i32) -> i32 { if (value < 0) { return -1; } if (value > 0) { return 1; } return 0; }
pub fn compare_as_i32(left: i32, right: i32) -> i32 { if (left < right) { return -1; } if (left > right) { return 1; } return 0; }
pub fn wrapping_add(left: i32, right: i32) -> i32 { return ((left as i64) + (right as i64)) as i32; }
pub fn checked_add(left: i32, right: i32) -> core::option::Option<i32> { return checked((left as i64) + (right as i64)); }
pub fn saturating_add(left: i32, right: i32) -> i32 { return saturated((left as i64) + (right as i64)); }
pub fn wrapping_sub(left: i32, right: i32) -> i32 { return ((left as i64) - (right as i64)) as i32; }
pub fn checked_sub(left: i32, right: i32) -> core::option::Option<i32> { return checked((left as i64) - (right as i64)); }
pub fn saturating_sub(left: i32, right: i32) -> i32 { return saturated((left as i64) - (right as i64)); }
pub fn wrapping_mul(left: i32, right: i32) -> i32 { return ((left as i64) * (right as i64)) as i32; }
pub fn checked_mul(left: i32, right: i32) -> core::option::Option<i32> { return checked((left as i64) * (right as i64)); }
pub fn saturating_mul(left: i32, right: i32) -> i32 { return saturated((left as i64) * (right as i64)); }
pub fn wrapping_neg(value: i32) -> i32 { return ((0 as i64)-(value as i64)) as i32; }
pub fn checked_neg(value: i32) -> core::option::Option<i32> { if (value == MIN) { return core::option::None(); } return core::option::Some(wrapping_neg(value)); }
pub fn saturating_neg(value: i32) -> i32 { if (value == MIN) { return MAX; } return wrapping_neg(value); }
// MIN has no positive result in this type and always traps.
pub fn abs(value: i32) -> i32 { assert(value != MIN); if (value < 0) { return wrapping_neg(value); } return value; }
pub fn checked_abs(value: i32) -> core::option::Option<i32> { if (value == MIN) { return core::option::None(); } return core::option::Some(abs(value)); }
pub fn wrapping_abs(value: i32) -> i32 { if (value < 0) { return wrapping_neg(value); } return value; }
pub fn saturating_abs(value: i32) -> i32 { if (value == MIN) { return MAX; } return abs(value); }
pub fn unsigned_abs(value: i32) -> u32 { let wide: i64 = value as i64; if (wide < 0) { return (0-wide) as u32; } return wide as u32; }
pub fn abs_diff(left: i32, right: i32) -> u32 { let difference: i64 = (left as i64)-(right as i64); if (difference < 0) { return (0-difference) as u32; } return difference as u32; }
pub fn saturating_abs_diff(left: i32, right: i32) -> i32 { if (left >= right) { return saturating_sub(left,right); } return saturating_sub(right,left); }
pub fn checked_div(left: i32, right: i32) -> core::option::Option<i32> { if (right == 0 || (left == MIN && right == -1)) { return core::option::None(); } return core::option::Some(((left as i64) / (right as i64)) as i32); }
pub fn div(left: i32, right: i32) -> i32 { assert(!(right == 0 || (left == MIN && right == -1))); return ((left as i64) / (right as i64)) as i32; }
pub fn wrapping_div(left: i32, right: i32) -> i32 { assert(right != 0); if (left == MIN && right == -1) { return MIN; } return ((left as i64) / (right as i64)) as i32; }
pub fn checked_rem(left: i32, right: i32) -> core::option::Option<i32> { if (right == 0 || (left == MIN && right == -1)) { return core::option::None(); } return core::option::Some(((left as i64) % (right as i64)) as i32); }
pub fn rem(left: i32, right: i32) -> i32 { assert(!(right == 0 || (left == MIN && right == -1))); return ((left as i64) % (right as i64)) as i32; }
pub fn wrapping_rem(left: i32, right: i32) -> i32 { assert(right != 0); if (left == MIN && right == -1) { return 0; } return ((left as i64) % (right as i64)) as i32; }
pub fn saturating_div(left: i32, right: i32) -> i32 { assert(right != 0); if (left == MIN && right == -1) { return MAX; } return ((left as i64)/(right as i64)) as i32; }
pub fn div_euclid(left: i32, right: i32) -> i32 { assert(!(right == 0 || (left == MIN && right == -1))); let a: i64 = left as i64; let b: i64 = right as i64; let quotient: i64 = a/b; let remainder: i64 = a%b; if (remainder < 0) { if (b > 0) { quotient -= 1; } else { quotient += 1; } } return quotient as i32; }
pub fn checked_div_euclid(left: i32, right: i32) -> core::option::Option<i32> { if (right == 0 || (left == MIN && right == -1)) { return core::option::None(); } return core::option::Some(div_euclid(left,right)); }
pub fn rem_euclid(left: i32, right: i32) -> i32 { assert(!(right == 0 || (left == MIN && right == -1))); let a: i64 = left as i64; let b: i64 = right as i64; let quotient: i64 = a/b; let remainder: i64 = a%b; if (remainder < 0) { if (b > 0) { remainder += b; } else { remainder -= b; } } return remainder as i32; }
pub fn checked_rem_euclid(left: i32, right: i32) -> core::option::Option<i32> { if (right == 0 || (left == MIN && right == -1)) { return core::option::None(); } return core::option::Some(rem_euclid(left,right)); }
pub fn is_multiple_of(value: i32, divisor: i32) -> bool { if (divisor == 0) { return false; } if (divisor == -1) { return true; } return (value as i64) % (divisor as i64) == 0; }
pub fn shl(value: i32, amount: u32) -> i32 { assert(amount < BITS); return ((value as i64) << amount) as i32; }
// Checks the shift count; discarded bits are allowed.
pub fn checked_shl(value: i32, amount: u32) -> core::option::Option<i32> { if (amount >= BITS) { return core::option::None(); } return core::option::Some(((value as i64) << amount) as i32); }
pub fn wrapping_shl(value: i32, amount: u32) -> i32 { return ((value as i64) << (amount % BITS)) as i32; }
pub fn shr(value: i32, amount: u32) -> i32 { assert(amount < BITS); return ((value as i64) >> amount) as i32; }
// Checks the shift count; discarded bits are allowed.
pub fn checked_shr(value: i32, amount: u32) -> core::option::Option<i32> { if (amount >= BITS) { return core::option::None(); } return core::option::Some(((value as i64) >> amount) as i32); }
pub fn wrapping_shr(value: i32, amount: u32) -> i32 { return ((value as i64) >> (amount % BITS)) as i32; }
// Exponent zero returns one, including 0^0.
pub fn checked_pow(base: i32, exponent: u32) -> core::option::Option<i32> { let result: i32 = 1; let factor: i32 = base; let remaining: u32 = exponent; while (remaining != 0) { if ((remaining & 1) != 0) { let product: core::option::Option<i32> = checked_mul(result,factor); if (core::option::is_none(product)) { return core::option::None(); } result = core::option::unwrap(product); } remaining >>= 1; if (remaining != 0) { let square: core::option::Option<i32> = checked_mul(factor,factor); if (core::option::is_none(square)) { return core::option::None(); } factor = core::option::unwrap(square); } } return core::option::Some(result); }
// Exponent zero returns one, including 0^0.
pub fn wrapping_pow(base: i32, exponent: u32) -> i32 { let result: i32 = 1; let factor: i32 = base; let remaining: u32 = exponent; while (remaining != 0) { if ((remaining & 1) != 0) { result = wrapping_mul(result,factor); } remaining >>= 1; if (remaining != 0) { factor = wrapping_mul(factor,factor); } } return result; }
// Exponent zero returns one, including 0^0.
pub fn saturating_pow(base: i32, exponent: u32) -> i32 { let result: i32 = 1; let factor: i32 = base; let remaining: u32 = exponent; while (remaining != 0) { if ((remaining & 1) != 0) { result = saturating_mul(result,factor); } remaining >>= 1; if (remaining != 0) { factor = saturating_mul(factor,factor); } } return result; }
fn bits(value: i32) -> u64 { return (value as u64) & 4294967295; }
pub fn count_ones(value: i32) -> u32 { return core::u64::count_ones(bits(value)); }
pub fn count_zeros(value: i32) -> u32 { return BITS-count_ones(value); }
pub fn leading_zeros(value: i32) -> u32 { return core::u64::leading_zeros(bits(value))-32; }
pub fn trailing_zeros(value: i32) -> u32 { if (value == 0) { return BITS; } return core::u64::trailing_zeros(bits(value)); }
pub fn leading_ones(value: i32) -> u32 { return core::u64::leading_zeros(bits(value) ^ 4294967295)-32; }
pub fn trailing_ones(value: i32) -> u32 { let inverted: u64 = bits(value) ^ 4294967295; if (inverted == 0) { return BITS; } return core::u64::trailing_zeros(inverted); }
pub fn rotate_left(value: i32, amount: u32) -> i32 { let shift: u32 = amount % BITS; if (shift == 0) { return value; } let word: u64 = bits(value); return ((word << shift) | (word >> (BITS-shift))) as i32; }
pub fn rotate_right(value: i32, amount: u32) -> i32 { let shift: u32 = amount % BITS; if (shift == 0) { return value; } let word: u64 = bits(value); return ((word >> shift) | (word << (BITS-shift))) as i32; }
pub fn reverse_bits(value: i32) -> i32 { return (core::u64::reverse_bits(bits(value)) >> 32) as i32; }
pub fn swap_bytes(value: i32) -> i32 { return (core::u64::swap_bytes(bits(value)) >> 32) as i32; }
pub fn is_power_of_two(value: i32) -> bool { if (value <= 0) { return false; } let word: u64 = bits(value); return (word & (word-1)) == 0; }
pub fn checked_next_power_of_two(value: i32) -> core::option::Option<i32> { if (value <= 1) { return core::option::Some(1); } if (value > 1073741824) { return core::option::None(); } let power: u64 = 1; let target: u64 = value as u64; while (power < target) { power <<= 1; } return core::option::Some(power as i32); }
// Traps when no representable positive power can be returned.
pub fn next_power_of_two(value: i32) -> i32 { return core::option::unwrap(checked_next_power_of_two(value)); }
fn gcd_magnitude(left: i32, right: i32) -> u64 { let a: u64 = unsigned_abs(left) as u64; let b: u64 = unsigned_abs(right) as u64; while (b != 0) { let remainder: u64 = a%b; a = b; b = remainder; } return a; }
// Nonnegative magnitude; gcd(0,0)=0. Signed MIN magnitudes fit the unsigned result.
pub fn gcd(left: i32, right: i32) -> u32 { return gcd_magnitude(left,right) as u32; }
pub fn checked_lcm(left: i32, right: i32) -> core::option::Option<i32> { if (left == 0 || right == 0) { return core::option::Some(0); } let divisor: u64 = gcd_magnitude(left,right); let a: u64 = unsigned_abs(left) as u64; let b: u64 = unsigned_abs(right) as u64; let reduced: u64 = a/divisor; if (reduced > (MAX as u64)/b) { return core::option::None(); } return core::option::Some((reduced*b) as i32); }

// Integer conversions: checked means numeric range, wrapping keeps low bits.
pub fn from_i8(value: i8) -> i32 { return value as i32; }
pub fn from_u8(value: u8) -> i32 { return value as i32; }
pub fn from_i16(value: i16) -> i32 { return value as i32; }
pub fn from_u16(value: u16) -> i32 { return value as i32; }
pub fn from_i32(value: i32) -> i32 { return value as i32; }
pub fn checked_from_i8(value: i8) -> core::option::Option<i32> { return core::option::Some(value as i32); }
pub fn saturating_from_i8(value: i8) -> i32 { return value as i32; }
pub fn wrapping_from_i8(value: i8) -> i32 { return value as i32; }
pub fn checked_from_u8(value: u8) -> core::option::Option<i32> { return core::option::Some(value as i32); }
pub fn saturating_from_u8(value: u8) -> i32 { return value as i32; }
pub fn wrapping_from_u8(value: u8) -> i32 { return value as i32; }
pub fn checked_from_i16(value: i16) -> core::option::Option<i32> { return core::option::Some(value as i32); }
pub fn saturating_from_i16(value: i16) -> i32 { return value as i32; }
pub fn wrapping_from_i16(value: i16) -> i32 { return value as i32; }
pub fn checked_from_u16(value: u16) -> core::option::Option<i32> { return core::option::Some(value as i32); }
pub fn saturating_from_u16(value: u16) -> i32 { return value as i32; }
pub fn wrapping_from_u16(value: u16) -> i32 { return value as i32; }
pub fn checked_from_i32(value: i32) -> core::option::Option<i32> { return core::option::Some(value as i32); }
pub fn saturating_from_i32(value: i32) -> i32 { return value as i32; }
pub fn wrapping_from_i32(value: i32) -> i32 { return value as i32; }
pub fn checked_from_u32(value: u32) -> core::option::Option<i32> { if (value > 2147483647) { return core::option::None(); } return core::option::Some(value as i32); }
pub fn saturating_from_u32(value: u32) -> i32 { if (value > 2147483647) { return MAX; } return value as i32; }
pub fn wrapping_from_u32(value: u32) -> i32 { return value as i32; }
pub fn checked_from_i64(value: i64) -> core::option::Option<i32> { if (value < -2147483648 || value > 2147483647) { return core::option::None(); } return core::option::Some(value as i32); }
pub fn saturating_from_i64(value: i64) -> i32 { if (value < -2147483648) { return MIN; } if (value > 2147483647) { return MAX; } return value as i32; }
pub fn wrapping_from_i64(value: i64) -> i32 { return value as i32; }
pub fn checked_from_u64(value: u64) -> core::option::Option<i32> { if (value > 2147483647) { return core::option::None(); } return core::option::Some(value as i32); }
pub fn saturating_from_u64(value: u64) -> i32 { if (value > 2147483647) { return MAX; } return value as i32; }
pub fn wrapping_from_u64(value: u64) -> i32 { return value as i32; }
pub fn checked_from_isize(value: isize) -> core::option::Option<i32> { if (value < -2147483648 || value > 2147483647) { return core::option::None(); } return core::option::Some(value as i32); }
pub fn saturating_from_isize(value: isize) -> i32 { if (value < -2147483648) { return MIN; } if (value > 2147483647) { return MAX; } return value as i32; }
pub fn wrapping_from_isize(value: isize) -> i32 { return value as i32; }
pub fn checked_from_usize(value: usize) -> core::option::Option<i32> { if (value > 2147483647) { return core::option::None(); } return core::option::Some(value as i32); }
pub fn saturating_from_usize(value: usize) -> i32 { if (value > 2147483647) { return MAX; } return value as i32; }
pub fn wrapping_from_usize(value: usize) -> i32 { return value as i32; }
pub fn checked_to_i8(value: i32) -> core::option::Option<i8> { if (value < -128 || value > 127) { return core::option::None(); } return core::option::Some(value as i8); }
pub fn saturating_to_i8(value: i32) -> i8 { if (value < -128) { return -128; } if (value > 127) { return 127; } return value as i8; }
pub fn wrapping_to_i8(value: i32) -> i8 { return value as i8; }
pub fn checked_to_u8(value: i32) -> core::option::Option<u8> { if (value < 0 || value > 255) { return core::option::None(); } return core::option::Some(value as u8); }
pub fn saturating_to_u8(value: i32) -> u8 { if (value < 0) { return 0; } if (value > 255) { return 255; } return value as u8; }
pub fn wrapping_to_u8(value: i32) -> u8 { return value as u8; }
pub fn checked_to_i16(value: i32) -> core::option::Option<i16> { if (value < -32768 || value > 32767) { return core::option::None(); } return core::option::Some(value as i16); }
pub fn saturating_to_i16(value: i32) -> i16 { if (value < -32768) { return -32768; } if (value > 32767) { return 32767; } return value as i16; }
pub fn wrapping_to_i16(value: i32) -> i16 { return value as i16; }
pub fn checked_to_u16(value: i32) -> core::option::Option<u16> { if (value < 0 || value > 65535) { return core::option::None(); } return core::option::Some(value as u16); }
pub fn saturating_to_u16(value: i32) -> u16 { if (value < 0) { return 0; } if (value > 65535) { return 65535; } return value as u16; }
pub fn wrapping_to_u16(value: i32) -> u16 { return value as u16; }
pub fn checked_to_i32(value: i32) -> core::option::Option<i32> { return core::option::Some(value as i32); }
pub fn saturating_to_i32(value: i32) -> i32 { return value as i32; }
pub fn wrapping_to_i32(value: i32) -> i32 { return value as i32; }
pub fn checked_to_u32(value: i32) -> core::option::Option<u32> { if (value < 0) { return core::option::None(); } return core::option::Some(value as u32); }
pub fn saturating_to_u32(value: i32) -> u32 { if (value < 0) { return 0; } return value as u32; }
pub fn wrapping_to_u32(value: i32) -> u32 { return value as u32; }
pub fn checked_to_i64(value: i32) -> core::option::Option<i64> { return core::option::Some(value as i64); }
pub fn saturating_to_i64(value: i32) -> i64 { return value as i64; }
pub fn wrapping_to_i64(value: i32) -> i64 { return value as i64; }
pub fn checked_to_u64(value: i32) -> core::option::Option<u64> { if (value < 0) { return core::option::None(); } return core::option::Some(value as u64); }
pub fn saturating_to_u64(value: i32) -> u64 { if (value < 0) { return 0; } return value as u64; }
pub fn wrapping_to_u64(value: i32) -> u64 { return value as u64; }
pub fn checked_to_isize(value: i32) -> core::option::Option<isize> { return core::option::Some(value as isize); }
pub fn saturating_to_isize(value: i32) -> isize { return value as isize; }
pub fn wrapping_to_isize(value: i32) -> isize { return value as isize; }
pub fn checked_to_usize(value: i32) -> core::option::Option<usize> { if (value < 0) { return core::option::None(); } return core::option::Some(value as usize); }
pub fn saturating_to_usize(value: i32) -> usize { if (value < 0) { return 0; } return value as usize; }
pub fn wrapping_to_usize(value: i32) -> usize { return value as usize; }
