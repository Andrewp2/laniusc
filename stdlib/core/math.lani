pub fn atan2(y: f64, x: f64) -> f64 {
    let tiny: f64 = 1.0e-300;
    let zero: f64 = 0.0;
    let pi_o_4: f64 = 7.8539816339744827900E-01;
    let pi_o_2: f64 = 1.5707963267948965580E+00;
    let pi: f64 = 3.1415926535897931160E+00;
    let pi_lo: f64 = 1.2246467991473531772E-16;

    if (core::f64::is_nan(y)) { return quiet(y); } if (core::f64::is_nan(x)) { return quiet(x); }
    if (x == 1.0) { return atan(y); }
    let hx: i32 = high(x); let hy: i32 = high(y); let ix: i32 = hx & 0x7fffffff; let iy: i32 = hy & 0x7fffffff;
    let m: i32 = ((hy >> 31) & 1) | ((hx >> 30) & 2);
    if (y == 0.0) { if (m < 2) { return y; } return core::f64::copy_sign(pi,y); }
    if (x == 0.0) { return core::f64::copy_sign(pi_o_2,y); }
    if (ix == 0x7ff00000) {
        if (iy == 0x7ff00000) { let answer: f64 = pi_o_4; if (m >= 2) { answer = 3.0*pi_o_4; } return core::f64::copy_sign(answer,y); }
        if (m < 2) { return core::f64::copy_sign(0.0,y); } return core::f64::copy_sign(pi,y);
    }
    if (iy == 0x7ff00000) { return core::f64::copy_sign(pi_o_2,y); }
    let k: i32 = (iy-ix) >> 20; let z: f64 = 0.0;
    if (k > 60) { z = pi_o_2+0.5*pi_lo; m &= 1; }
    else { if (hx < 0 && k < -60) { z = 0.0; } else { z = atan(core::f64::abs(y/x)); } }
    if (m == 0) { return z; } if (m == 1) { return -z; } if (m == 2) { return pi-(z-pi_lo); } return (z-pi_lo)-pi;
}

fn kernel_sin(x: f64, y: f64, tail: bool) -> f64 {
    let half: f64 = 5.00000000000000000000e-01;
    let S1: f64 = -1.66666666666666324348e-01;
    let S2: f64 = 8.33333333332248946124e-03;
    let S3: f64 = -1.98412698298579493134e-04;
    let S4: f64 = 2.75573137070700676789e-06;
    let S5: f64 = -2.50507602534068634195e-08;
    let S6: f64 = 1.58969099521155010221e-10;

    let z: f64 = x*x; let w: f64 = z*z; let r: f64 = S2+z*(S3+z*S4)+z*w*(S5+z*S6); let v: f64 = z*x;
    if (!tail) { return x+v*(S1+z*r); } return x-((z*(half*y-v*r)-y)-v*S1);
}

fn kernel_cos(x: f64, y: f64) -> f64 {
    let one: f64 = 1.00000000000000000000e+00;
    let C1: f64 = 4.16666666666666019037e-02;
    let C2: f64 = -1.38888888888741095749e-03;
    let C3: f64 = 2.48015872894767294178e-05;
    let C4: f64 = -2.75573143513906633035e-07;
    let C5: f64 = 2.08757232129817482790e-09;
    let C6: f64 = -1.13596475577881948265e-11;

    let z: f64 = x*x; let w: f64 = z*z; let r: f64 = z*(C1+z*(C2+z*C3))+w*w*(C4+z*(C5+z*C6)); let hz: f64 = 0.5*z; w = one-hz;
    return w+(((one-w)-hz)+(z*r-x*y));
}

// Payne-Hanek reduction: only the necessary 24-bit product window is formed.
// 66 base-2^24 digits of 2/pi cover every finite binary64 exponent.
fn reduce_large(x: [f64], e0: i32, nx: i32) -> Reduction {
    let ipio2: [i32;66] = [10680707, 7228996, 1387004, 2578385, 16069853, 12639074, 9804092, 4427841, 16666979, 11263675, 12935607, 2387514, 4345298, 14681673, 3074569, 13734428, 16653803, 1880361, 10960616, 8533493, 3062596, 8710556, 7349940, 6258241, 3772886, 3769171, 3798172, 8675211, 12450088, 3874808, 9961438, 366607, 15675153, 9132554, 7151469, 3571407, 2607881, 12013382, 4155038, 6285869, 7677882, 13102053, 15825725, 473591, 9065106, 15363067, 6271263, 9264392, 5636912, 4652155, 7056368, 13614112, 10155062, 1944035, 9527646, 15080200, 6658437, 6231200, 6832269, 16767104, 5075751, 3212806, 1398474, 7579849, 6349435, 12618859];
    let pio2: [f64;8] = [1.57079625129699707031e+00, 7.54978941586159635335e-08, 5.39030252995776476554e-15, 3.28200341580791294123e-22, 1.27065575308067607349e-29, 1.22933308981111328932e-36, 2.73370053816464559624e-44, 2.16741683877804819444e-51];
    let iq: [i32;20] = [0;20]; let f: [f64;20] = [0.0;20]; let fq: [f64;20] = [0.0;20]; let q: [f64;20] = [0.0;20];
    let jk: i32 = 4; let jp: i32 = jk; let jx: i32 = nx-1; let jv: i32 = (e0-3)/24; if (jv < 0) { jv = 0; }
    let q0: i32 = e0-24*(jv+1); let j: i32 = jv-jx; let m: i32 = jx+jk; let i: i32 = 0;
    while (i <= m) { if (j < 0) { f[i] = 0.0; } else { f[i] = ipio2[j] as f64; } i += 1; j += 1; }
    i = 0; while (i <= jk) { j = 0; let fw: f64 = 0.0; while (j <= jx) { fw += x[j]*f[jx+i-j]; j += 1; } q[i] = fw; i += 1; }
    let jz: i32 = jk; let z: f64 = 0.0; let n: i32 = 0; let ih: i32 = 0; let recompute: bool = true;
    while (recompute) {
        recompute = false; i = 0; j = jz; z = q[jz];
        while (j > 0) { let fw: f64 = (0.000000059604644775390625*z) as i32 as f64; iq[i] = (z-16777216.0*fw) as i32; z = q[j-1]+fw; i += 1; j -= 1; }
        z = scalbn(z,q0); z -= 8.0*core::f64::floor(z*0.125); n = z as i32; z -= n as f64; ih = 0;
        if (q0 > 0) { i = iq[jz-1] >> (24-q0); n += i; iq[jz-1] -= i << (24-q0); ih = iq[jz-1] >> (23-q0); }
        else { if (q0 == 0) { ih = iq[jz-1] >> 23; } else { if (z >= 0.5) { ih = 2; } } }
        if (ih > 0) {
            n += 1; let carry: i32 = 0; i = 0;
            while (i < jz) { j = iq[i]; if (carry == 0) { if (j != 0) { carry = 1; iq[i] = 16777216-j; } } else { iq[i] = 16777215-j; } i += 1; }
            if (q0 == 1) { iq[jz-1] &= 8388607; } if (q0 == 2) { iq[jz-1] &= 4194303; }
            if (ih == 2) { z = 1.0-z; if (carry != 0) { z -= scalbn(1.0,q0); } }
        }
        if (z == 0.0) {
            j = 0; i = jz-1; while (i >= jk) { j |= iq[i]; i -= 1; }
            if (j == 0) {
                let k: i32 = 1; while (iq[jk-k] == 0) { k += 1; }
                i = jz+1; while (i <= jz+k) { f[jx+i] = ipio2[jv+i] as f64; j = 0; let fw: f64 = 0.0; while (j <= jx) { fw += x[j]*f[jx+i-j]; j += 1; } q[i] = fw; i += 1; }
                jz += k; recompute = true;
            }
        }
    }
    if (z == 0.0) { jz -= 1; q0 -= 24; while (iq[jz] == 0) { jz -= 1; q0 -= 24; } }
    else {
        z = scalbn(z,-q0);
        if (z >= 16777216.0) { let fw: f64 = (0.000000059604644775390625*z) as i32 as f64; iq[jz] = (z-16777216.0*fw) as i32; jz += 1; q0 += 24; iq[jz] = fw as i32; }
        else { iq[jz] = z as i32; }
    }
    let fw: f64 = scalbn(1.0,q0); i = jz;
    while (i >= 0) { q[i] = fw*(iq[i] as f64); fw *= 0.000000059604644775390625; i -= 1; }
    i = jz; while (i >= 0) { fw = 0.0; let k: i32 = 0; while (k <= jp && k <= jz-i) { fw += pio2[k]*q[i+k]; k += 1; } fq[jz-i] = fw; i -= 1; }
    fw = 0.0; i = jz; while (i >= 0) { fw += fq[i]; i -= 1; } let head: f64 = fw;
    fw = fq[0]-fw; i = 1; while (i <= jz) { fw += fq[i]; i += 1; } let tail: f64 = fw;
    if (ih != 0) { head = -head; tail = -tail; }
    return Reduction { quadrant: n & 7, head: head, tail: tail };
}

fn reduce(x: f64) -> Reduction {
    let zero: f64 = 0.00000000000000000000e+00;
    let two24: f64 = 1.67772160000000000000e+07;
    let invpio2: f64 = 6.36619772367581382433e-01;
    let pio2_1: f64 = 1.57079632673412561417e+00;
    let pio2_1t: f64 = 6.07710050650619224932e-11;
    let pio2_2: f64 = 6.07710050630396597660e-11;
    let pio2_2t: f64 = 2.02226624879595063154e-21;
    let pio2_3: f64 = 2.02226624871116645580e-21;
    let pio2_3t: f64 = 8.47842766036889956997e-32;

    let hx: i32 = high(x); let ix: i32 = hx & 0x7fffffff;
    if (ix < 0x413921fb) {
        let fnn: f64 = core::f64::round_ties_even(x*invpio2); let n: i32 = fnn as i32;
        let r: f64 = x-fnn*pio2_1; let w: f64 = fnn*pio2_1t; let head: f64 = r-w; let j: i32 = ix >> 20;
        let lost: i32 = j-((high(head) >> 20) & 0x7ff);
        if (lost > 16) {
            let t: f64 = r; w = fnn*pio2_2; r = t-w; w = fnn*pio2_2t-((t-r)-w); head = r-w;
            lost = j-((high(head) >> 20) & 0x7ff);
            if (lost > 49) { let t: f64 = r; w = fnn*pio2_3; r = t-w; w = fnn*pio2_3t-((t-r)-w); head = r-w; }
        }
        return Reduction { quadrant: n, head: head, tail: (r-head)-w };
    }
    let e0: i32 = (ix >> 20)-1046; let z: f64 = words((ix & 0x000fffff) | 0x41600000,low(x));
    let tx: [f64;3] = [0.0;3]; let i: i32 = 0;
    while (i < 2) { tx[i] = z as i32 as f64; z = (z-tx[i])*two24; i += 1; } tx[2] = z; let nx: i32 = 3;
    while (tx[nx-1] == 0.0) { nx -= 1; }
    let answer: Reduction = reduce_large(tx,e0,nx);
    if (hx < 0) { answer.quadrant = -answer.quadrant; answer.head = -answer.head; answer.tail = -answer.tail; }
    return answer;
}

pub fn sin_cos(x: f64) -> SinCos {
    if (core::f64::is_nan(x)) { let q: f64 = quiet(x); return SinCos { sin: q, cos: q }; }
    if (core::f64::is_infinite(x)) { let q: f64 = core::f64::nan(); return SinCos { sin: q, cos: q }; }
    let ix: i32 = high(x) & 0x7fffffff;
    if (ix <= 0x3fe921fb) {
        if (ix < 0x3e400000) { return SinCos { sin: x, cos: 1.0 }; }
        return SinCos { sin: kernel_sin(x,0.0,false), cos: kernel_cos(x,0.0) };
    }
    let reduced: Reduction = reduce(x); let s: f64 = kernel_sin(reduced.head,reduced.tail,true); let c: f64 = kernel_cos(reduced.head,reduced.tail); let quadrant: i32 = reduced.quadrant & 3;
    if (quadrant == 0) { return SinCos { sin: s, cos: c }; }
    if (quadrant == 1) { return SinCos { sin: c, cos: -s }; }
    if (quadrant == 2) { return SinCos { sin: -s, cos: -c }; }
    return SinCos { sin: -c, cos: s };
}
pub fn sin(x: f64) -> f64 { let answer: SinCos = sin_cos(x); return answer.sin; }
pub fn cos(x: f64) -> f64 { let answer: SinCos = sin_cos(x); return answer.cos; }

// 0 noninteger, 1 odd integer, 2 even integer; finite binary64 parity is exact.
fn integer_kind(y: f64) -> i32 {
    let a: f64 = core::f64::abs(y); if (a >= 9007199254740992.0) { return 2; }
    if (a < 1.0 || core::f64::trunc(a) != a) { return 0; }
    let bits: u64 = core::f64::to_bits(a); let exponent: i32 = (bits >> 52) as i32-1023;
    let mantissa: u64 = (bits & core::f64::FRACTION_MASK) | 4503599627370496;
    if (((mantissa >> (52-exponent)) & 1) != 0) { return 1; } return 2;
}
pub fn pow(x: f64, y: f64) -> f64 {
    let bp: [f64;2] = [1.0, 1.5];
    let dp_h: [f64;2] = [0.0, 5.84962487220764160156e-01];
    let dp_l: [f64;2] = [0.0, 1.35003920212974897128e-08];
    let zero: f64 = 0.0;
    let one: f64 = 1.0;
    let two: f64 = 2.0;
    let two53: f64 = 9007199254740992.0;
    let huge: f64 = 1.0e300;
    let tiny: f64 = 1.0e-300;
    let L1: f64 = 5.99999999999994648725e-01;
    let L2: f64 = 4.28571428578550184252e-01;
    let L3: f64 = 3.33333329818377432918e-01;
    let L4: f64 = 2.72728123808534006489e-01;
    let L5: f64 = 2.30660745775561754067e-01;
    let L6: f64 = 2.06975017800338417784e-01;
    let P1: f64 = 1.66666666666666019037e-01;
    let P2: f64 = -2.77777777770155933842e-03;
    let P3: f64 = 6.61375632143793436117e-05;
    let P4: f64 = -1.65339022054652515390e-06;
    let P5: f64 = 4.13813679705723846039e-08;
    let lg2: f64 = 6.93147180559945286227e-01;
    let lg2_h: f64 = 6.93147182464599609375e-01;
    let lg2_l: f64 = -1.90465429995776804525e-09;
    let ovt: f64 = 8.0085662595372944372e-0017;
    let cp: f64 = 9.61796693925975554329e-01;
    let cp_h: f64 = 9.61796700954437255859e-01;
    let cp_l: f64 = -7.02846165095275826516e-09;
    let ivln2: f64 = 1.44269504088896338700e+00;
    let ivln2_h: f64 = 1.44269502162933349609e+00;
    let ivln2_l: f64 = 1.92596299112661746887e-08;

    if (y == 0.0 || x == 1.0) { return 1.0; }
    if (core::f64::is_nan(x)) { return quiet(x); } if (core::f64::is_nan(y)) { return quiet(y); }
    let hx: i32 = high(x); let hy: i32 = high(y); let ix: i32 = hx & 0x7fffffff; let iy: i32 = hy & 0x7fffffff;
    let lx: u32 = low(x); let ly: u32 = low(y); let ax: f64 = core::f64::abs(x); let yisint: i32 = 0;
    if (hx < 0) { yisint = integer_kind(y); }
    if (core::f64::is_infinite(y)) { if (ax == 1.0) { return 1.0; } if ((ax > 1.0) == (y > 0.0)) { return core::f64::infinity(); } return 0.0; }
    if (y == 1.0) { return x; } if (y == -1.0) { return 1.0/x; }
    if (y == 2.0) { return x*x; } if (y == 3.0) { return x*x*x; } if (y == 4.0) { let u: f64 = x*x; return u*u; }
    if (y == 0.5 && hx >= 0) { return core::f64::sqrt(x); }
    if (ax == 0.0 || core::f64::is_infinite(ax) || ax == 1.0) {
        let z: f64 = ax; if (y < 0.0) { z = 1.0/z; }
        if (hx < 0) { if (ax == 1.0 && yisint == 0) { return core::f64::nan(); } if (yisint == 1) { z = -z; } } return z;
    }
    if (hx < 0 && yisint == 0) { return core::f64::nan(); }
    let sign: f64 = 1.0; if (hx < 0 && yisint == 1) { sign = -1.0; }
    let t1: f64 = 0.0; let t2: f64 = 0.0;
    if (iy > 0x41e00000) {
        if (iy > 0x43f00000) { if ((ax < 1.0) == (y < 0.0)) { return core::f64::infinity(); } return 0.0; }
        if (ix < 0x3fefffff) { if (y < 0.0) { return core::f64::copy_sign(core::f64::infinity(),sign); } return core::f64::copy_sign(0.0,sign); }
        if (ix > 0x3ff00000) { if (y > 0.0) { return core::f64::copy_sign(core::f64::infinity(),sign); } return core::f64::copy_sign(0.0,sign); }
        let t: f64 = ax-one; let w: f64 = (t*t)*(0.5-t*(0.3333333333333333333333-t*0.25));
        let u: f64 = ivln2_h*t; let v: f64 = t*ivln2_l-w*ivln2; t1 = with_low(u+v,0); t2 = v-(t1-u);
    } else {
        let n: i32 = 0;
        if (ix < 0x00100000) { ax *= two53; n -= 53; ix = high(ax); }
        n += (ix >> 20)-1023; let j: i32 = ix & 0x000fffff; ix = j | 0x3ff00000; let k: i32 = 0;
        if (j > 0x3988e) { if (j < 0xbb67a) { k = 1; } else { n += 1; ix -= 0x00100000; } }
        ax = with_high(ax,ix); let u: f64 = ax-bp[k]; let v: f64 = one/(ax+bp[k]); let ss: f64 = u*v;
        let s_h: f64 = with_low(ss,0); let t_h: f64 = words(((ix >> 1) | 0x20000000)+0x00080000+(k << 18),0);
        let t_l: f64 = ax-(t_h-bp[k]); let s_l: f64 = v*((u-s_h*t_h)-s_h*t_l); let s2: f64 = ss*ss;
        let r: f64 = s2*s2*(L1+s2*(L2+s2*(L3+s2*(L4+s2*(L5+s2*L6))))); r += s_l*(s_h+ss);
        s2 = s_h*s_h; t_h = with_low(3.0+s2+r,0); t_l = r-((t_h-3.0)-s2); u = s_h*t_h; v = s_l*t_h+t_l*ss;
        let p_h: f64 = with_low(u+v,0); let p_l: f64 = v-(p_h-u); let z_h: f64 = cp_h*p_h; let z_l: f64 = cp_l*p_h+p_l*cp+dp_l[k];
        let t: f64 = n as f64; t1 = with_low(((z_h+z_l)+dp_h[k])+t,0); t2 = z_l-(((t1-t)-dp_h[k])-z_h);
    }
    let y1: f64 = with_low(y,0); let p_l: f64 = (y-y1)*t1+y*t2; let p_h: f64 = y1*t1; let z: f64 = p_l+p_h;
    let j: i32 = high(z); let i: i32 = low(z) as i32;
    if (j >= 0x40900000) { if (j != 0x40900000 || i != 0 || p_l+ovt > z-p_h) { return core::f64::copy_sign(core::f64::infinity(),sign); } }
    else { if ((j & 0x7fffffff) >= 0x4090cc00) { if (j != -1064252416 || i != 0 || p_l <= z-p_h) { return core::f64::copy_sign(0.0,sign); } } }
    i = j & 0x7fffffff; let k: i32 = (i >> 20)-1023; let n: i32 = 0;
    if (i > 0x3fe00000) {
        n = j+(0x00100000 >> (k+1)); k = ((n & 0x7fffffff) >> 20)-1023;
        let t: f64 = words(n & ((0x000fffff >> k) ^ -1),0); n = ((n & 0x000fffff) | 0x00100000) >> (20-k); if (j < 0) { n = -n; } p_h -= t;
    }
    let t: f64 = with_low(p_l+p_h,0); let u: f64 = t*lg2_h; let v: f64 = (p_l-(t-p_h))*lg2+t*lg2_l;
    z = u+v; let w: f64 = v-(z-u); t = z*z;
    t1 = z-t*(P1+t*(P2+t*(P3+t*(P4+t*P5)))); let r: f64 = (z*t1)/(t1-two)-(w+z*w); z = one-(r-z);
    j = high(z); j += n << 20; if ((j >> 20) <= 0) { z = scalbn(z,n); } else { z = with_high(z,j); } return sign*z;
}
