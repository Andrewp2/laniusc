        if (hx > 0 || hx <= -1076707644) { k = 0; f = x; hu = 1; }
    }
    if (k != 0) {
        let u: f64 = 0.0;
        if (hx < 0x43400000) { u = 1.0+x; hu = high(u); k = (hu >> 20)-1023; if (k > 0) { c = 1.0-(u-x); } else { c = x-(u-1.0); } c /= u; }
        else { u = x; hu = high(u); k = (hu >> 20)-1023; c = 0.0; }
        hu &= 0x000fffff;
        if (hu < 0x6a09e) { u = with_high(u,hu | 0x3ff00000); }
        else { k += 1; u = with_high(u,hu | 0x3fe00000); hu = (0x00100000-hu) >> 2; }
        f = u-1.0;
    }
    let hfsq: f64 = 0.5*f*f; let dk: f64 = k as f64;
    if (hu == 0) {
        if (f == 0.0) { if (k == 0) { return 0.0; } c += dk*ln2_lo; return dk*ln2_hi+c; }
        let r: f64 = hfsq*(1.0-0.66666666666666666*f); if (k == 0) { return f-r; } return dk*ln2_hi-((r-(dk*ln2_lo+c))-f);
    }
    let s: f64 = f/(2.0+f); let z: f64 = s*s;
    let r: f64 = z*(Lp1+z*(Lp2+z*(Lp3+z*(Lp4+z*(Lp5+z*(Lp6+z*Lp7))))));
    if (k == 0) { return f-(hfsq-s*(hfsq+r)); }
    return dk*ln2_hi-((hfsq-(s*(hfsq+r)+(dk*ln2_lo+c)))-f);
}

pub fn atan(x: f64) -> f64 {
    let atanhi: [f64;4] = [4.63647609000806093515e-01, 7.85398163397448278999e-01, 9.82793723247329054082e-01, 1.57079632679489655800e+00];
    let atanlo: [f64;4] = [2.26987774529616870924e-17, 3.06161699786838301793e-17, 1.39033110312309984516e-17, 6.12323399573676603587e-17];
    let aT: [f64;11] = [3.33333333333329318027e-01, -1.99999999998764832476e-01, 1.42857142725034663711e-01, -1.11111104054623557880e-01, 9.09088713343650656196e-02, -7.69187620504482999495e-02, 6.66107313738753120669e-02, -5.83357013379057348645e-02, 4.97687799461593236017e-02, -3.65315727442169155270e-02, 1.62858201153657823623e-02];
    let one: f64 = 1.0;
    let huge: f64 = 1.0e300;

    if (core::f64::is_nan(x)) { return quiet(x); }
    let hx: i32 = high(x); let ix: i32 = hx & 0x7fffffff; let value: f64 = x; let id: i32 = -1;
    if (ix >= 0x44100000) { return core::f64::copy_sign(atanhi[3]+atanlo[3],x); }
    if (ix < 0x3fdc0000) { if (ix < 0x3e400000) { return x; } }
    else {
        value = core::f64::abs(x);
        if (ix < 0x3ff30000) { if (ix < 0x3fe60000) { id = 0; value = (2.0*value-one)/(2.0+value); } else { id = 1; value = (value-one)/(value+one); } }
        else { if (ix < 0x40038000) { id = 2; value = (value-1.5)/(one+1.5*value); } else { id = 3; value = -1.0/value; } }
    }
    let z: f64 = value*value; let w: f64 = z*z;
    let s1: f64 = z*(aT[0]+w*(aT[2]+w*(aT[4]+w*(aT[6]+w*(aT[8]+w*aT[10])))));
    let s2: f64 = w*(aT[1]+w*(aT[3]+w*(aT[5]+w*(aT[7]+w*aT[9]))));
    if (id < 0) { return value-value*(s1+s2); }
    let answer: f64 = atanhi[id]-((value*(s1+s2)-atanlo[id])-value); if (hx < 0) { return -answer; } return answer;
