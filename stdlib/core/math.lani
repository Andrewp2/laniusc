pub fn log1p(x: f64) -> f64 {
    let ln2_hi: f64 = 6.93147180369123816490e-01;
    let ln2_lo: f64 = 1.90821492927058770002e-10;
    let two54: f64 = 1.80143985094819840000e+16;
    let Lp1: f64 = 6.666666666666735130e-01;
    let Lp2: f64 = 3.999999999940941908e-01;
    let Lp3: f64 = 2.857142874366239149e-01;
    let Lp4: f64 = 2.222219843214978396e-01;
    let Lp5: f64 = 1.818357216161805012e-01;
    let Lp6: f64 = 1.531383769920937332e-01;
    let Lp7: f64 = 1.479819860511658591e-01;
    let zero: f64 = 0.0;

    if (core::f64::is_nan(x)) { return quiet(x); }
    if (x == -1.0) { return core::f64::neg_infinity(); }
    if (x < -1.0) { return core::f64::nan(); }
    if (core::f64::is_infinite(x)) { return x; }
    let hx: i32 = high(x); let ax: i32 = hx & 0x7fffffff; let k: i32 = 1; let hu: i32 = 0; let f: f64 = 0.0; let c: f64 = 0.0;
    if (hx < 0x3fda827a) {
