fn quiet(x: f64) -> f64 { return core::f64::from_bits(core::f64::to_bits(x) | core::f64::QUIET_MASK); }
// Power-of-two scaling; guard arbitrary i32 exponents before addition.
pub fn scalbn(x: f64, n: i32) -> f64 {
    if (core::f64::is_nan(x)) { return quiet(x); }
    if (x == 0.0 || core::f64::is_infinite(x)) { return x; }
    if (n > 50000) { return core::f64::copy_sign(core::f64::infinity(),x); }
    if (n < -50000) { return core::f64::copy_sign(0.0,x); }
    let value: f64 = x; let hx: i32 = high(value); let k: i32 = (hx & 2146435072) >> 20;
    if (k == 0) { value *= 18014398509481984.0; hx = high(value); k = ((hx & 2146435072) >> 20)-54; }
    k += n;
    if (k > 2046) { return core::f64::copy_sign(core::f64::infinity(),x); }
    if (k > 0) { return with_high(value,(hx & -2146435073) | (k << 20)); }
    if (k <= -54) { return core::f64::copy_sign(0.0,x); }
    return with_high(value,(hx & -2146435073) | ((k+54) << 20))*0.000000000000000055511151231257827021181583404541015625;
}

pub fn exp(x: f64) -> f64 {
    let halF: [f64;2] = [0.5, -0.5];
    let ln2HI: [f64;2] = [6.93147180369123816490e-01, -6.93147180369123816490e-01];
    let ln2LO: [f64;2] = [1.90821492927058770002e-10, -1.90821492927058770002e-10];
    let one: f64 = 1.0;
    let huge: f64 = 1.0e+300;
    let o_threshold: f64 = 7.09782712893383973096e+02;
    let u_threshold: f64 = -7.45133219101941108420e+02;
    let invln2: f64 = 1.44269504088896338700e+00;
    let P1: f64 = 1.66666666666666019037e-01;
    let P2: f64 = -2.77777777770155933842e-03;
    let P3: f64 = 6.61375632143793436117e-05;
    let P4: f64 = -1.65339022054652515390e-06;
    let P5: f64 = 4.13813679705723846039e-08;
    let twom1000: f64 = 9.33263618503218878990e-302;

    if (core::f64::is_nan(x)) { return quiet(x); }
    if (x > o_threshold) { return core::f64::infinity(); }
    if (x < u_threshold) { return 0.0; }
    if (x == 1.0) { return 2.718281828459045235360; }
    let value: f64 = x; let hx: i32 = high(x) & 2147483647; let sign: i32 = 0; if (x < 0.0) { sign = 1; }
    let hi: f64 = 0.0; let lo: f64 = 0.0; let k: i32 = 0;
    if (hx > 1071001154) {
        if (hx < 1072734898) { hi = value-ln2HI[sign]; lo = ln2LO[sign]; k = 1-sign-sign; }
        else { k = (invln2*value+halF[sign]) as i32; let t: f64 = k as f64; hi = value-t*ln2HI[0]; lo = t*ln2LO[0]; }
        value = hi-lo;
    } else { if (hx < 1043333120) { return one+value; } }
    let t: f64 = value*value; let c: f64 = value-t*(P1+t*(P2+t*(P3+t*(P4+t*P5))));
    if (k == 0) { return one-((value*c)/(c-2.0)-value); }
    let y: f64 = one-((lo-(value*c)/(2.0-c))-hi);
    if (k >= -1021) { if (k == 1024) { return y*2.0*words(2145386496,0); } return y*words(1072693248+(k << 20),0); }
    return y*words(1072693248+((k+1000) << 20),0)*twom1000;
}

pub fn log(x: f64) -> f64 {
    let ln2_hi: f64 = 6.93147180369123816490e-01;
    let ln2_lo: f64 = 1.90821492927058770002e-10;
    let two54: f64 = 1.80143985094819840000e+16;
    let Lg1: f64 = 6.666666666666735130e-01;
    let Lg2: f64 = 3.999999999940941908e-01;
    let Lg3: f64 = 2.857142874366239149e-01;
    let Lg4: f64 = 2.222219843214978396e-01;
    let Lg5: f64 = 1.818357216161805012e-01;
    let Lg6: f64 = 1.531383769920937332e-01;
    let Lg7: f64 = 1.479819860511658591e-01;
    let zero: f64 = 0.0;

    if (core::f64::is_nan(x)) { return quiet(x); }
    if (x == 0.0) { return core::f64::neg_infinity(); }
    if (x < 0.0) { return core::f64::nan(); }
    if (core::f64::is_infinite(x)) { return x; }
    let value: f64 = x; let hx: i32 = high(value); let k: i32 = 0;
    if (hx < 1048576) { k -= 54; value *= two54; hx = high(value); }
    k += (hx >> 20)-1023; hx &= 1048575; let i: i32 = (hx+614244) & 1048576;
    value = with_high(value,hx | (i ^ 1072693248)); k += i >> 20; let f: f64 = value-1.0;
    if ((1048575 & (2+hx)) < 3) {
        if (f == 0.0) { if (k == 0) { return 0.0; } let dk: f64 = k as f64; return dk*ln2_hi+dk*ln2_lo; }
        let r: f64 = f*f*(0.5-0.33333333333333333*f); if (k == 0) { return f-r; } let dk: f64 = k as f64; return dk*ln2_hi-((r-dk*ln2_lo)-f);
    }
    let s: f64 = f/(2.0+f); let dk: f64 = k as f64; let z: f64 = s*s; let w: f64 = z*z;
    let t1: f64 = w*(Lg2+w*(Lg4+w*Lg6)); let t2: f64 = z*(Lg1+w*(Lg3+w*(Lg5+w*Lg7))); let r: f64 = t2+t1;
    if (((hx-398458) | (440401-hx)) > 0) { let hfsq: f64 = 0.5*f*f; if (k == 0) { return f-(hfsq-s*(hfsq+r)); } return dk*ln2_hi-((hfsq-(s*(hfsq+r)+dk*ln2_lo))-f); }
    if (k == 0) { return f-s*(f-r); } return dk*ln2_hi-((s*(f-r)-dk*ln2_lo)-f);
}

pub fn expm1(x: f64) -> f64 {
    let one: f64 = 1.0;
    let huge: f64 = 1.0e+300;
    let tiny: f64 = 1.0e-300;
    let o_threshold: f64 = 7.09782712893383973096e+02;
    let ln2_hi: f64 = 6.93147180369123816490e-01;
    let ln2_lo: f64 = 1.90821492927058770002e-10;
    let invln2: f64 = 1.44269504088896338700e+00;
    let Q1: f64 = -3.33333333333331316428e-02;
    let Q2: f64 = 1.58730158725481460165e-03;
    let Q3: f64 = -7.93650757867487942473e-05;
    let Q4: f64 = 4.00821782732936239552e-06;
    let Q5: f64 = -2.01099218183624371326e-07;

    if (core::f64::is_nan(x)) { return quiet(x); }
    if (x > o_threshold) { return core::f64::infinity(); }
    let hx: i32 = high(x) & 0x7fffffff; let negative: bool = core::f64::is_sign_negative(x);
    if (negative && hx >= 0x4043687a) { return -1.0; }
