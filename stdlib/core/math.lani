fn high(x: f64) -> i32 { return (core::f64::to_bits(x) >> 32) as i32; }
fn low(x: f64) -> u32 { return core::f64::to_bits(x) as u32; }
fn with_high(x: f64, word: i32) -> f64 { return core::f64::from_bits(((word as u32 as u64) << 32) | (low(x) as u64)); }
