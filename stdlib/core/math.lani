        else { let half: f64 = 0.5; if (negative) { half = -0.5; } k = (invln2*value+half) as i32; let t: f64 = k as f64; hi = value-t*ln2_hi; lo = t*ln2_lo; }
        value = hi-lo; c = (hi-value)-lo;
    }
    let hfx: f64 = 0.5*value; let hxs: f64 = value*hfx;
    let r1: f64 = one+hxs*(Q1+hxs*(Q2+hxs*(Q3+hxs*(Q4+hxs*Q5))));
    let t: f64 = 3.0-r1*hfx; let e: f64 = hxs*((r1-t)/(6.0-value*t));
    if (k == 0) { return value-(value*e-hxs); }
