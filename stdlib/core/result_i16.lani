// A concrete i16 result with an i16 error code until generic enums execute.
// The inactive payload is zero; inspect `success` before reading a payload.
module core::result_i16;

pub struct ResultI16 {
    success: bool,
    value: i16,
    error: i16,
}

pub fn ok(value: i16) -> ResultI16 {
    return ResultI16 { success: true, value: value, error: 0 };
}

pub fn err(error: i16) -> ResultI16 {
    return ResultI16 { success: false, value: 0, error: error };
}

pub fn is_ok(value: ResultI16) -> bool {
    return value.success;
}

pub fn is_err(value: ResultI16) -> bool {
    return !value.success;
}

pub fn contains(value: ResultI16, expected: i16) -> bool {
    return value.success && value.value == expected;
}

pub fn contains_err(value: ResultI16, expected: i16) -> bool {
    return !value.success && value.error == expected;
}

pub fn unwrap_or(value: ResultI16, fallback: i16) -> i16 {
    if (value.success) { return value.value; }
    return fallback;
}

pub fn unwrap_err_or(value: ResultI16, fallback: i16) -> i16 {
    if (!value.success) { return value.error; }
    return fallback;
}

pub fn or(value: ResultI16, fallback: ResultI16) -> ResultI16 {
    if (value.success) { return value; }
    return fallback;
}

pub fn and(value: ResultI16, next: ResultI16) -> ResultI16 {
    if (value.success) { return next; }
    return value;
}
