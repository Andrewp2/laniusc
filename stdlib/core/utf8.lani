// Allocation-free UTF-8 scalar codec and validation of caller-backed [i32]
// byte-code views. Borrowed string storage is not accessed by this module.
module core::utf8;
fn to_byte(value: u32) -> u8 {
    return value as u8;
}
fn from_byte(value: u8) -> u32 {
    return value as u32;
}
pub fn is_scalar(value: u32) -> bool {
    return value <= 1114111 &&(value<55296 || value>57343);
}
pub fn is_continuation_byte(value: u8) -> bool {
    return value >= 128 && value <= 191;
}
// Invalid leading bytes return fallback, including continuation bytes,
// overlong two-byte leads, and values beyond the Unicode maximum.
pub fn sequence_len_or(first: u8, fallback: u32) -> u32 {
    if (first <= 127) {
        return 1;
    }
    if (first >= 194 && first <= 223) {
        return 2;
    }
    if (first >= 224 && first <= 239) {
        return 3;
    }
    if (first >= 240 && first <= 244) {
        return 4;
    }
    return fallback;
}
// An invalid scalar returns fallback.
pub fn encoded_len_or(value: u32, fallback: u32) -> u32 {
    if (!is_scalar(value)) {
        return fallback;
    }
    if (value <= 127) {
        return 1;
    }
    if (value <= 2047) {
        return 2;
    }
    if (value <= 65535) {
        return 3;
    }
    return 4;
}
// Return byte number index from a scalar's UTF-8 encoding. An invalid scalar
// or out-of-range index returns fallback unchanged.
pub fn encoded_byte_or(value: u32, index: u32, fallback: u8) -> u8 {
    let length: u32 = encoded_len_or(value, 0);
    if (length == 0 || index >= length) {
        return fallback;
    }
    if (length == 1) {
        return to_byte(value);
    }
    if (length == 2) {
        if (index == 0) {
            return to_byte(192|(value >> 6));
        }
        return to_byte(128|(value&63));
    }
    if (length == 3) {
        if (index == 0) {
            return to_byte(224|(value >> 12));
        }
        if (index == 1) {
            return to_byte(128|((value >> 6)&63));
        }
        return to_byte(128|(value&63));
    }
    if (index == 0) {
        return to_byte(240|(value >> 18));
    }
    if (index == 1) {
        return to_byte(128|((value >> 12)&63));
    }
    if (index == 2) {
        return to_byte(128|((value >> 6)&63));
    }
    return to_byte(128|(value&63));
}
// Decode exactly length (1..4) byte values. Unused arguments are ignored.
// Malformed, overlong, surrogate, out-of-range, or truncated sequences return
// fallback unchanged.
pub fn decode_or(first: u8, second: u8, third: u8, fourth: u8, length: u32, fallback: u32) -> u32 {
    let expected: u32 = sequence_len_or(first, 0);
    if (expected == 0 || length != expected) {
        return fallback;
    }
    if (length == 1) {
        return from_byte(first);
    }
    if (!is_continuation_byte(second)) {
        return fallback;
    }
    let a: u32 = from_byte(first);
    let b: u32 = from_byte(second);
    if (length == 2) {
        return((a&31) << 6)|(b&63);
    }
    if (!is_continuation_byte(third)) {
        return fallback;
    }
    let c: u32 = from_byte(third);
    if (length == 3) {
        if (first == 224 && second<160 || first == 237 && second>159) {
            return fallback;
        }
        return((a&15) << 12)|((b&63) << 6)|(c&63);
    }
    if (!is_continuation_byte(fourth)) {
        return fallback;
    }
    let d: u32 = from_byte(fourth);
    if (first == 240 && second<144 || first == 244 && second>143) {
        return fallback;
    }
    return((a&7) << 18)|((b&63) << 12)|((c&63) << 6)|(d&63);
}

fn is_byte_code(value: i32) -> bool {
    return value>=0 && value<=255;
}

// A negative length, malformed sequence, or code outside 0..=255 returns -1.
// The backed view must physically contain len elements; an overclaim may trap
// when native indexing reaches it. The empty view has zero scalars.
fn count_scalars_or_negative_one(values: [i32], len: i32) -> i32 {
    if (len<0) {
        return -1;
    }
    let index: i32 = 0;
    let count: i32 = 0;
    while (index<len) {
        let first_code: i32 = values[index];
        if (!is_byte_code(first_code)) {
            return -1;
        }
        let first: u8 = first_code as u8;
        let width: u32 = sequence_len_or(first, 0);
        if (width == 0) {
            return -1;
        }
        let needed: i32 = width as i32;
        if (needed>len - index) {
            return -1;
        }
        let second: u8 = 0;
        let third: u8 = 0;
        let fourth: u8 = 0;
        if (needed>1) {
            let code: i32 = values[index + 1];
            if (!is_byte_code(code)) {
                return -1;
            }
            second = code as u8;
        }
        if (needed>2) {
            let code: i32 = values[index + 2];
            if (!is_byte_code(code)) {
                return -1;
            }
            third = code as u8;
        }
        if (needed>3) {
            let code: i32 = values[index + 3];
            if (!is_byte_code(code)) {
                return -1;
            }
            fourth = code as u8;
        }
        if (decode_or(first, second, third, fourth, width, 4294967295) == 4294967295) {
            return -1;
        }
        index += needed;
        count += 1;
    }
    return count;
}

// Validate a caller-backed [u8] view directly. The view must physically
// contain len bytes; an overclaim may trap when indexing reaches it.
fn count_byte_scalars_or_negative_one(values: [u8], len: i32) -> i32 {
    if (len < 0) {
        return -1;
    }
    let index: i32 = 0;
    let count: i32 = 0;
    while (index < len) {
        let first: u8 = values[index];
        let width: u32 = sequence_len_or(first, 0);
        if (width == 0) {
            return -1;
        }
        let needed: i32 = width as i32;
        if (needed > len - index) {
            return -1;
        }
        let second: u8 = 0;
        let third: u8 = 0;
        let fourth: u8 = 0;
        if (needed > 1) {
            second = values[index + 1];
        }
        if (needed > 2) {
            third = values[index + 2];
        }
        if (needed > 3) {
            fourth = values[index + 3];
        }
        if (decode_or(first, second, third, fourth, width, 4294967295) == 4294967295) {
            return -1;
        }
        index += needed;
        count += 1;
    }
    return count;
}

// A negative length or malformed UTF-8 returns false. Empty input is valid.
pub fn bytes_are_valid(values: [u8], len: i32) -> bool {
    return count_byte_scalars_or_negative_one(values, len) >= 0;
}

// Return the scalar count, or the caller's fallback for invalid UTF-8.
// A valid count may equal fallback; use bytes_are_valid to distinguish it.
pub fn byte_scalar_count_or(values: [u8], len: i32, fallback: i32) -> i32 {
    let count: i32 = count_byte_scalars_or_negative_one(values, len);
    if (count < 0) {
        return fallback;
    }
    return count;
}

// Return the byte offset of a scalar boundary in a complete [u8] view.
// Scalar index equal to the scalar count returns len. Invalid UTF-8 or an
// invalid index returns fallback; an overclaimed physical view may trap.
pub fn byte_view_offset_of_scalar_or(values: [u8], len: i32, scalar_index: i32, fallback: i32) -> i32 {
    let count: i32 = count_byte_scalars_or_negative_one(values, len);
    if (count < 0 || scalar_index < 0 || scalar_index > count) {
        return fallback;
    }
    let offset: i32 = 0;
    let passed: i32 = 0;
    while (passed < scalar_index) {
        let width: u32 = sequence_len_or(values[offset], 0);
        offset += width as i32;
        passed += 1;
    }
    return offset;
}

// Return the scalar index at a byte boundary, including the end of the view.
// A byte inside a multibyte encoding or invalid input returns fallback.
pub fn byte_view_scalar_index_of_byte_or(values: [u8], len: i32, byte_index: i32, fallback: i32) -> i32 {
    let count: i32 = count_byte_scalars_or_negative_one(values, len);
    if (count < 0 || byte_index < 0 || byte_index > len) {
        return fallback;
    }
    let offset: i32 = 0;
    let scalar_index: i32 = 0;
    while (offset < byte_index) {
        let width: u32 = sequence_len_or(values[offset], 0);
        let needed: i32 = width as i32;
        if (needed > byte_index - offset) {
            return fallback;
        }
        offset += needed;
        scalar_index += 1;
    }
    return scalar_index;
}

// Decode a scalar by index after validating the entire [u8] view. Invalid
// UTF-8 or an out-of-range index returns fallback, which may itself be a
// valid scalar. The caller must back len bytes or native indexing may trap.
pub fn byte_view_scalar_at_or(values: [u8], len: i32, scalar_index: i32, fallback: u32) -> u32 {
    let offset: i32 = byte_view_offset_of_scalar_or(values, len, scalar_index, -1);
    if (offset < 0 || offset >= len) {
        return fallback;
    }
    let first: u8 = values[offset];
    let width: u32 = sequence_len_or(first, 0);
    let second: u8 = 0;
    let third: u8 = 0;
    let fourth: u8 = 0;
    if (width > 1) {
        second = values[offset + 1];
    }
    if (width > 2) {
        third = values[offset + 2];
    }
    if (width > 3) {
        fourth = values[offset + 3];
    }
    return decode_or(first, second, third, fourth, width, fallback);
}

// Returns false for a negative length or any malformed byte-code sequence.
pub fn codes_are_valid(values: [i32], len: i32) -> bool {
    return count_scalars_or_negative_one(values, len) >= 0;
}

// Returns the number of Unicode scalars, or fallback for invalid input.
// A valid count may equal fallback; call codes_are_valid when success must be
// distinguishable. The view must have at least len physically backed slots.
pub fn scalar_count_or(values: [i32], len: i32, fallback: i32) -> i32 {
    let count: i32 = count_scalars_or_negative_one(values, len);
    if (count<0) {
        return fallback;
    }
    return count;
}

// Return the byte offset at a Unicode scalar boundary. Scalar index zero is
// the start, and index equal to the scalar count is the end offset len.
// Invalid UTF-8, negative or out-of-range indices return fallback. The
// physical view must contain len elements; an overclaim may trap.
pub fn byte_offset_of_scalar_or(values: [i32], len: i32, scalar_index: i32, fallback: i32) -> i32 {
    let count: i32 = count_scalars_or_negative_one(values, len);
    if (count<0 || scalar_index<0 || scalar_index>count) {
        return fallback;
    }
    let offset: i32 = 0;
    let passed: i32 = 0;
    while (passed<scalar_index) {
        let first_code: i32 = values[offset];
        let first: u8 = first_code as u8;
        let width: u32 = sequence_len_or(first, 0);
        let needed: i32 = width as i32;
        offset += needed;
        passed += 1;
    }
    return offset;
}

// Return the Unicode scalar index at a byte boundary. The end offset len
// maps to the scalar count. A byte inside a multibyte encoding, invalid
// UTF-8, or an out-of-range offset returns fallback.
pub fn scalar_index_of_byte_or(values: [i32], len: i32, byte_index: i32, fallback: i32) -> i32 {
    let count: i32 = count_scalars_or_negative_one(values, len);
    if (count<0 || byte_index<0 || byte_index>len) {
        return fallback;
    }
    let offset: i32 = 0;
    let scalar_index: i32 = 0;
    while (offset<byte_index) {
        let first_code: i32 = values[offset];
        let first: u8 = first_code as u8;
        let width: u32 = sequence_len_or(first, 0);
        let needed: i32 = width as i32;
        if (needed>byte_index - offset) {
            return fallback;
        }
        offset += needed;
        scalar_index += 1;
    }
    return scalar_index;
}

// The caller must have validated the complete byte-code view and byte_index
// must point to the start of a scalar within it.
fn scalar_at_valid(values: [i32], byte_index: i32) -> u32 {
    let first_code: i32 = values[byte_index];
    let first: u8 = first_code as u8;
    let width: u32 = sequence_len_or(first, 0);
    let second: u8 = 0;
    let third: u8 = 0;
    let fourth: u8 = 0;
    if (width>1) {
        let second_code: i32 = values[byte_index + 1];
        second = second_code as u8;
    }
    if (width>2) {
        let third_code: i32 = values[byte_index + 2];
        third = third_code as u8;
    }
    if (width>3) {
        let fourth_code: i32 = values[byte_index + 3];
        fourth = fourth_code as u8;
    }
    return decode_or(first, second, third, fourth, width, 4294967295);
}

// Return the scalar at a zero-based index. The entire view must be valid,
// including bytes after the requested scalar. An invalid view or index
// returns fallback, which may itself be a valid Unicode scalar.
pub fn scalar_at_or(values: [i32], len: i32, scalar_index: i32, fallback: u32) -> u32 {
    let byte_index: i32 = byte_offset_of_scalar_or(values, len, scalar_index, -1);
    if (byte_index<0 || byte_index>=len) {
        return fallback;
    }
    return scalar_at_valid(values, byte_index);
}

// Search a fully valid UTF-8 byte-code view for one Unicode scalar and return
// its first zero-based scalar index. Invalid UTF-8, an invalid needle, a
// negative length, or a missing scalar returns fallback unchanged. A valid
// result can equal fallback; validate separately when that matters.
pub fn index_of_scalar_or(values: [i32], len: i32, needle: u32, fallback: i32) -> i32 {
    let count: i32 = count_scalars_or_negative_one(values, len);
    if (count<0 || !is_scalar(needle)) {
        return fallback;
    }
    let byte_index: i32 = 0;
    let scalar_index: i32 = 0;
    while (scalar_index<count) {
        if (scalar_at_valid(values, byte_index) == needle) {
            return scalar_index;
        }
        let first_code: i32 = values[byte_index];
        let first: u8 = first_code as u8;
        let width: u32 = sequence_len_or(first, 0);
        let needed: i32 = width as i32;
        byte_index += needed;
        scalar_index += 1;
    }
    return fallback;
}

// Search the same validated view for the last occurrence. Failure and
// backing-storage requirements match index_of_scalar_or.
pub fn last_index_of_scalar_or(values: [i32], len: i32, needle: u32, fallback: i32) -> i32 {
    let count: i32 = count_scalars_or_negative_one(values, len);
    if (count<0 || !is_scalar(needle)) {
        return fallback;
    }
    let byte_index: i32 = 0;
    let scalar_index: i32 = 0;
    let found: i32 = fallback;
    while (scalar_index<count) {
        if (scalar_at_valid(values, byte_index) == needle) {
            found = scalar_index;
        }
        let first_code: i32 = values[byte_index];
        let first: u8 = first_code as u8;
        let width: u32 = sequence_len_or(first, 0);
        let needed: i32 = width as i32;
        byte_index += needed;
        scalar_index += 1;
    }
    return found;
}

// Append one Unicode scalar to a valid UTF-8 byte-code prefix in caller-owned
// [i32] storage. Return the new byte length. Invalid UTF-8, an invalid scalar,
// negative or inconsistent lengths, and insufficient capacity return fallback
// without writing. The view must physically contain capacity writable slots;
// overclaiming that backing storage may trap on native indexing. A successful
// new length may equal fallback, so use distinct values when needed.
pub fn append_scalar_or(values: [i32], len: i32, capacity: i32, value: u32, fallback: i32) -> i32 {
    if (len<0 || capacity<len || !is_scalar(value)) {
        return fallback;
    }
    let width_u32: u32 = encoded_len_or(value, 0);
    let width: i32 = width_u32 as i32;
    if (width>capacity - len || !codes_are_valid(values, len)) {
        return fallback;
    }
    let index: i32 = 0;
    while (index<width) {
        let byte_index: u32 = index as u32;
        let byte: u8 = encoded_byte_or(value, byte_index, 0);
        let code: i32 = byte as i32;
        values[len + index] = code;
        index += 1;
    }
    return len + width;
}

// Compare two complete, valid UTF-8 byte-code views. Invalid views are not
// equal, including when their byte lengths differ. Two empty views are equal.
pub fn equal_codes(left: [i32], left_len: i32, right: [i32], right_len: i32) -> bool {
    if (!codes_are_valid(left, left_len) || !codes_are_valid(right, right_len)) {
        return false;
    }
    if (left_len != right_len) { return false; }
    let index: i32 = 0;
    while (index < left_len) {
        if (left[index] != right[index]) { return false; }
        index += 1;
    }
    return true;
}

// A valid empty prefix or suffix matches every valid view. Both complete
// views are validated, so a malformed tail cannot be hidden by a match.
pub fn starts_with_codes(values: [i32], len: i32, prefix: [i32], prefix_len: i32) -> bool {
    if (!codes_are_valid(values, len) || !codes_are_valid(prefix, prefix_len) ||
        prefix_len > len) { return false; }
    let index: i32 = 0;
    while (index < prefix_len) {
        if (values[index] != prefix[index]) { return false; }
        index += 1;
    }
    return true;
}

pub fn ends_with_codes(values: [i32], len: i32, suffix: [i32], suffix_len: i32) -> bool {
    if (!codes_are_valid(values, len) || !codes_are_valid(suffix, suffix_len) ||
        suffix_len > len) { return false; }
    let start: i32 = len - suffix_len;
    let index: i32 = 0;
    while (index < suffix_len) {
        if (values[start + index] != suffix[index]) { return false; }
        index += 1;
    }
    return true;
}

// Compare the canonical UTF-8 byte encodings lexicographically, returning
// -1, 0, or 1. Invalid complete views return the caller's fallback.
pub fn compare_codes_or(
    left: [i32], left_len: i32, right: [i32], right_len: i32, fallback: i32
) -> i32 {
    if (!codes_are_valid(left, left_len) || !codes_are_valid(right, right_len)) {
        return fallback;
    }
    let common: i32 = left_len;
    if (right_len < common) { common = right_len; }
    let index: i32 = 0;
    while (index < common) {
        if (left[index] < right[index]) { return -1; }
        if (left[index] > right[index]) { return 1; }
        index += 1;
    }
    if (left_len < right_len) { return -1; }
    if (left_len > right_len) { return 1; }
    return 0;
}

// Search valid complete views and return a byte offset. A valid empty needle
// matches at zero; malformed input or a missing sequence returns fallback.
pub fn index_of_codes_byte_or(
    values: [i32], len: i32, needle: [i32], needle_len: i32, fallback: i32
) -> i32 {
    if (!codes_are_valid(values, len) || !codes_are_valid(needle, needle_len) ||
        needle_len > len) { return fallback; }
    let start: i32 = 0;
    while (start <= len - needle_len) {
        let offset: i32 = 0;
        while (offset < needle_len && values[start + offset] == needle[offset]) {
            offset += 1;
        }
        if (offset == needle_len) { return start; }
        start += 1;
    }
    return fallback;
}

// The last match of a valid empty needle is at byte offset len.
pub fn last_index_of_codes_byte_or(
    values: [i32], len: i32, needle: [i32], needle_len: i32, fallback: i32
) -> i32 {
    if (!codes_are_valid(values, len) || !codes_are_valid(needle, needle_len) ||
        needle_len > len) { return fallback; }
    let start: i32 = len - needle_len;
    while (start >= 0) {
        let offset: i32 = 0;
        while (offset < needle_len && values[start + offset] == needle[offset]) {
            offset += 1;
        }
        if (offset == needle_len) { return start; }
        start -= 1;
    }
    return fallback;
}
