// Allocation-free UTF-8 scalar codec and validation of caller-backed [i32]
// byte-code views. Borrowed string storage is not accessed by this module.
module core::utf8;
fn to_byte(value: u32) -> u8 {
    return value as u8;
}
fn from_byte(value: u8) -> u32 {
    return value as u32;
}
pub fn is_scalar(value: u32) -> bool {
    return value <= 1114111 &&(value<55296 || value>57343);
}
pub fn is_continuation_byte(value: u8) -> bool {
    return value >= 128 && value <= 191;
}
// Invalid leading bytes return fallback, including continuation bytes,
// overlong two-byte leads, and values beyond the Unicode maximum.
pub fn sequence_len_or(first: u8, fallback: u32) -> u32 {
    if (first <= 127) {
        return 1;
    }
    if (first >= 194 && first <= 223) {
        return 2;
    }
    if (first >= 224 && first <= 239) {
        return 3;
    }
    if (first >= 240 && first <= 244) {
        return 4;
    }
    return fallback;
}
// An invalid scalar returns fallback.
pub fn encoded_len_or(value: u32, fallback: u32) -> u32 {
    if (!is_scalar(value)) {
        return fallback;
    }
    if (value <= 127) {
        return 1;
    }
    if (value <= 2047) {
        return 2;
    }
    if (value <= 65535) {
        return 3;
    }
    return 4;
}
// Return byte number index from a scalar's UTF-8 encoding. An invalid scalar
// or out-of-range index returns fallback unchanged.
pub fn encoded_byte_or(value: u32, index: u32, fallback: u8) -> u8 {
    let length: u32 = encoded_len_or(value, 0);
    if (length == 0 || index >= length) {
        return fallback;
    }
    if (length == 1) {
        return to_byte(value);
    }
    if (length == 2) {
        if (index == 0) {
            return to_byte(192|(value >> 6));
        }
        return to_byte(128|(value&63));
    }
    if (length == 3) {
        if (index == 0) {
            return to_byte(224|(value >> 12));
        }
        if (index == 1) {
            return to_byte(128|((value >> 6)&63));
        }
        return to_byte(128|(value&63));
    }
    if (index == 0) {
        return to_byte(240|(value >> 18));
    }
    if (index == 1) {
        return to_byte(128|((value >> 12)&63));
    }
    if (index == 2) {
        return to_byte(128|((value >> 6)&63));
    }
    return to_byte(128|(value&63));
}
// Decode exactly length (1..4) byte values. Unused arguments are ignored.
// Malformed, overlong, surrogate, out-of-range, or truncated sequences return
// fallback unchanged.
pub fn decode_or(first: u8, second: u8, third: u8, fourth: u8, length: u32, fallback: u32) -> u32 {
    let expected: u32 = sequence_len_or(first, 0);
    if (expected == 0 || length != expected) {
        return fallback;
    }
    if (length == 1) {
        return from_byte(first);
    }
    if (!is_continuation_byte(second)) {
        return fallback;
    }
    let a: u32 = from_byte(first);
    let b: u32 = from_byte(second);
    if (length == 2) {
        return((a&31) << 6)|(b&63);
    }
    if (!is_continuation_byte(third)) {
        return fallback;
    }
    let c: u32 = from_byte(third);
    if (length == 3) {
        if (first == 224 && second<160 || first == 237 && second>159) {
            return fallback;
        }
        return((a&15) << 12)|((b&63) << 6)|(c&63);
    }
    if (!is_continuation_byte(fourth)) {
        return fallback;
    }
    let d: u32 = from_byte(fourth);
    if (first == 240 && second<144 || first == 244 && second>143) {
        return fallback;
    }
    return((a&7) << 18)|((b&63) << 12)|((c&63) << 6)|(d&63);
}

fn is_byte_code(value: i32) -> bool {
    return value>=0 && value<=255;
}

// A negative length, malformed sequence, or code outside 0..=255 returns -1.
// The backed view must physically contain len elements; an overclaim may trap
// when native indexing reaches it. The empty view has zero scalars.
fn count_scalars_or_negative_one(values: [i32], len: i32) -> i32 {
    if (len<0) {
        return -1;
    }
    let index: i32 = 0;
    let count: i32 = 0;
    while (index<len) {
        let first_code: i32 = values[index];
        if (!is_byte_code(first_code)) {
            return -1;
        }
        let first: u8 = first_code as u8;
        let width: u32 = sequence_len_or(first, 0);
        if (width == 0) {
            return -1;
        }
        let needed: i32 = width as i32;
        if (needed>len - index) {
            return -1;
        }
        let second: u8 = 0;
        let third: u8 = 0;
        let fourth: u8 = 0;
        if (needed>1) {
            let code: i32 = values[index + 1];
            if (!is_byte_code(code)) {
                return -1;
            }
            second = code as u8;
        }
        if (needed>2) {
            let code: i32 = values[index + 2];
            if (!is_byte_code(code)) {
                return -1;
            }
            third = code as u8;
        }
        if (needed>3) {
            let code: i32 = values[index + 3];
            if (!is_byte_code(code)) {
                return -1;
            }
            fourth = code as u8;
        }
        if (decode_or(first, second, third, fourth, width, 4294967295) == 4294967295) {
            return -1;
        }
        index += needed;
        count += 1;
    }
    return count;
}

// Returns false for a negative length or any malformed byte-code sequence.
pub fn codes_are_valid(values: [i32], len: i32) -> bool {
    return count_scalars_or_negative_one(values, len) >= 0;
}

// Returns the number of Unicode scalars, or fallback for invalid input.
// A valid count may equal fallback; call codes_are_valid when success must be
// distinguishable. The view must have at least len physically backed slots.
pub fn scalar_count_or(values: [i32], len: i32, fallback: i32) -> i32 {
    let count: i32 = count_scalars_or_negative_one(values, len);
    if (count<0) {
        return fallback;
    }
    return count;
}
