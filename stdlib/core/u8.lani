// Native 8-bit unsigned integer operations; x86_64 Linux execution evidence.
// Arithmetic widens before evaluation, then checks, clamps or keeps low bits.
// checked_* returns Option; plain abs/clamp/div/rem/shifts/power/alignment
// conveniences trap for invalid inputs. See docs/stdlib-narrow-integers.md.
module core::u8;
import core::option;
import core::u64;
pub const MIN: u8 = 0;
pub const MAX: u8 = 255;
pub const BITS: u32 = 8;
pub const BYTES: u32 = 1;
fn checked(value: u64) -> core::option::Option<u8> { if (value > 255) { return core::option::None(); } return core::option::Some(value as u8); }
fn saturated(value: u64) -> u8 { if (value > 255) { return MAX; } return value as u8; }
pub fn min(left: u8, right: u8) -> u8 { if (left < right) { return left; } return right; }
pub fn max(left: u8, right: u8) -> u8 { if (left > right) { return left; } return right; }
// Reversed bounds always trap. Use checked_clamp or an explicit fallback.
pub fn clamp(value: u8, low: u8, high: u8) -> u8 { assert(low <= high); if (value < low) { return low; } if (value > high) { return high; } return value; }
pub fn checked_clamp(value: u8, low: u8, high: u8) -> core::option::Option<u8> { if (low > high) { return core::option::None(); } return core::option::Some(clamp(value,low,high)); }
pub fn clamp_or(value: u8, low: u8, high: u8, fallback: u8) -> u8 { if (low > high) { return fallback; } return clamp(value,low,high); }
pub fn is_zero(value: u8) -> bool { return value == 0; }
pub fn is_nonzero(value: u8) -> bool { return value != 0; }
pub fn is_even(value: u8) -> bool { return (value & 1) == 0; }
pub fn is_odd(value: u8) -> bool { return (value & 1) != 0; }
pub fn between_inclusive(value: u8, low: u8, high: u8) -> bool { return value >= low && value <= high; }
pub fn between_exclusive(value: u8, low: u8, high: u8) -> bool { return value > low && value < high; }
pub fn wrapping_add(left: u8, right: u8) -> u8 { return ((left as u64) + (right as u64)) as u8; }
pub fn checked_add(left: u8, right: u8) -> core::option::Option<u8> { return checked((left as u64) + (right as u64)); }
pub fn saturating_add(left: u8, right: u8) -> u8 { return saturated((left as u64) + (right as u64)); }
pub fn wrapping_sub(left: u8, right: u8) -> u8 { return ((left as u64) - (right as u64)) as u8; }
pub fn checked_sub(left: u8, right: u8) -> core::option::Option<u8> { if (left < right) { return core::option::None(); } return checked((left as u64) - (right as u64)); }
pub fn saturating_sub(left: u8, right: u8) -> u8 { if (left < right) { return MIN; } return saturated((left as u64) - (right as u64)); }
pub fn wrapping_mul(left: u8, right: u8) -> u8 { return ((left as u64) * (right as u64)) as u8; }
pub fn checked_mul(left: u8, right: u8) -> core::option::Option<u8> { return checked((left as u64) * (right as u64)); }
pub fn saturating_mul(left: u8, right: u8) -> u8 { return saturated((left as u64) * (right as u64)); }
pub fn wrapping_neg(value: u8) -> u8 { return ((0 as u64)-(value as u64)) as u8; }
pub fn checked_neg(value: u8) -> core::option::Option<u8> { if (value == 0) { return core::option::Some(0); } return core::option::None(); }
pub fn abs_diff(left: u8, right: u8) -> u8 { if (left >= right) { return left-right; } return right-left; }
pub fn checked_div(left: u8, right: u8) -> core::option::Option<u8> { if (right == 0) { return core::option::None(); } return core::option::Some(((left as u64) / (right as u64)) as u8); }
pub fn div(left: u8, right: u8) -> u8 { assert(!(right == 0)); return ((left as u64) / (right as u64)) as u8; }
pub fn wrapping_div(left: u8, right: u8) -> u8 { assert(right != 0); return ((left as u64) / (right as u64)) as u8; }
pub fn checked_rem(left: u8, right: u8) -> core::option::Option<u8> { if (right == 0) { return core::option::None(); } return core::option::Some(((left as u64) % (right as u64)) as u8); }
pub fn rem(left: u8, right: u8) -> u8 { assert(!(right == 0)); return ((left as u64) % (right as u64)) as u8; }
pub fn wrapping_rem(left: u8, right: u8) -> u8 { assert(right != 0); return ((left as u64) % (right as u64)) as u8; }
pub fn saturating_div(left: u8, right: u8) -> u8 { assert(right != 0); return ((left as u64)/(right as u64)) as u8; }
pub fn div_euclid(left: u8, right: u8) -> u8 { assert(!(right == 0)); let a: u64 = left as u64; let b: u64 = right as u64; let quotient: u64 = a/b; let remainder: u64 = a%b; return quotient as u8; }
pub fn checked_div_euclid(left: u8, right: u8) -> core::option::Option<u8> { if (right == 0) { return core::option::None(); } return core::option::Some(div_euclid(left,right)); }
pub fn rem_euclid(left: u8, right: u8) -> u8 { assert(!(right == 0)); let a: u64 = left as u64; let b: u64 = right as u64; let quotient: u64 = a/b; let remainder: u64 = a%b; return remainder as u8; }
pub fn checked_rem_euclid(left: u8, right: u8) -> core::option::Option<u8> { if (right == 0) { return core::option::None(); } return core::option::Some(rem_euclid(left,right)); }
pub fn is_multiple_of(value: u8, divisor: u8) -> bool { if (divisor == 0) { return false; } return (value as u64) % (divisor as u64) == 0; }
pub fn shl(value: u8, amount: u32) -> u8 { assert(amount < BITS); return ((value as u64) << amount) as u8; }
// Checks the shift count; discarded bits are allowed.
pub fn checked_shl(value: u8, amount: u32) -> core::option::Option<u8> { if (amount >= BITS) { return core::option::None(); } return core::option::Some(((value as u64) << amount) as u8); }
pub fn wrapping_shl(value: u8, amount: u32) -> u8 { return ((value as u64) << (amount % BITS)) as u8; }
pub fn shr(value: u8, amount: u32) -> u8 { assert(amount < BITS); return ((value as u64) >> amount) as u8; }
// Checks the shift count; discarded bits are allowed.
pub fn checked_shr(value: u8, amount: u32) -> core::option::Option<u8> { if (amount >= BITS) { return core::option::None(); } return core::option::Some(((value as u64) >> amount) as u8); }
pub fn wrapping_shr(value: u8, amount: u32) -> u8 { return ((value as u64) >> (amount % BITS)) as u8; }
// Exponent zero returns one, including 0^0.
pub fn checked_pow(base: u8, exponent: u32) -> core::option::Option<u8> { let result: u8 = 1; let factor: u8 = base; let remaining: u32 = exponent; while (remaining != 0) { if ((remaining & 1) != 0) { let product: core::option::Option<u8> = checked_mul(result,factor); if (core::option::is_none(product)) { return core::option::None(); } result = core::option::unwrap(product); } remaining >>= 1; if (remaining != 0) { let square: core::option::Option<u8> = checked_mul(factor,factor); if (core::option::is_none(square)) { return core::option::None(); } factor = core::option::unwrap(square); } } return core::option::Some(result); }
// Exponent zero returns one, including 0^0.
pub fn wrapping_pow(base: u8, exponent: u32) -> u8 { let result: u8 = 1; let factor: u8 = base; let remaining: u32 = exponent; while (remaining != 0) { if ((remaining & 1) != 0) { result = wrapping_mul(result,factor); } remaining >>= 1; if (remaining != 0) { factor = wrapping_mul(factor,factor); } } return result; }
// Exponent zero returns one, including 0^0.
pub fn saturating_pow(base: u8, exponent: u32) -> u8 { let result: u8 = 1; let factor: u8 = base; let remaining: u32 = exponent; while (remaining != 0) { if ((remaining & 1) != 0) { result = saturating_mul(result,factor); } remaining >>= 1; if (remaining != 0) { factor = saturating_mul(factor,factor); } } return result; }
fn bits(value: u8) -> u64 { return (value as u64) & 255; }
pub fn count_ones(value: u8) -> u32 { return core::u64::count_ones(bits(value)); }
pub fn count_zeros(value: u8) -> u32 { return BITS-count_ones(value); }
pub fn leading_zeros(value: u8) -> u32 { return core::u64::leading_zeros(bits(value))-56; }
pub fn trailing_zeros(value: u8) -> u32 { if (value == 0) { return BITS; } return core::u64::trailing_zeros(bits(value)); }
pub fn leading_ones(value: u8) -> u32 { return core::u64::leading_zeros(bits(value) ^ 255)-56; }
pub fn trailing_ones(value: u8) -> u32 { let inverted: u64 = bits(value) ^ 255; if (inverted == 0) { return BITS; } return core::u64::trailing_zeros(inverted); }
pub fn rotate_left(value: u8, amount: u32) -> u8 { let shift: u32 = amount % BITS; if (shift == 0) { return value; } let word: u64 = bits(value); return ((word << shift) | (word >> (BITS-shift))) as u8; }
pub fn rotate_right(value: u8, amount: u32) -> u8 { let shift: u32 = amount % BITS; if (shift == 0) { return value; } let word: u64 = bits(value); return ((word >> shift) | (word << (BITS-shift))) as u8; }
pub fn reverse_bits(value: u8) -> u8 { return (core::u64::reverse_bits(bits(value)) >> 56) as u8; }
pub fn swap_bytes(value: u8) -> u8 { return (core::u64::swap_bytes(bits(value)) >> 56) as u8; }
pub fn is_power_of_two(value: u8) -> bool { if (value == 0) { return false; } let word: u64 = bits(value); return (word & (word-1)) == 0; }
pub fn checked_next_power_of_two(value: u8) -> core::option::Option<u8> { if (value <= 1) { return core::option::Some(1); } if (value > 128) { return core::option::None(); } let power: u64 = 1; let target: u64 = value as u64; while (power < target) { power <<= 1; } return core::option::Some(power as u8); }
// Traps when no representable positive power can be returned.
pub fn next_power_of_two(value: u8) -> u8 { return core::option::unwrap(checked_next_power_of_two(value)); }
fn gcd_magnitude(left: u8, right: u8) -> u64 { let a: u64 = left as u64; let b: u64 = right as u64; while (b != 0) { let remainder: u64 = a%b; a = b; b = remainder; } return a; }
// Nonnegative magnitude; gcd(0,0)=0. Signed MIN magnitudes fit the unsigned result.
pub fn gcd(left: u8, right: u8) -> u8 { return gcd_magnitude(left,right) as u8; }
pub fn checked_lcm(left: u8, right: u8) -> core::option::Option<u8> { if (left == 0 || right == 0) { return core::option::Some(0); } let divisor: u64 = gcd_magnitude(left,right); let a: u64 = left as u64; let b: u64 = right as u64; let reduced: u64 = a/divisor; if (reduced > (MAX as u64)/b) { return core::option::None(); } return core::option::Some((reduced*b) as u8); }
// Every nonzero alignment is accepted, not only powers of two.
pub fn is_aligned(value: u8, alignment: u8) -> bool { return alignment != 0 && value % alignment == 0; }
pub fn checked_align_up(value: u8, alignment: u8) -> core::option::Option<u8> { if (alignment == 0) { return core::option::None(); } let a: u64 = value as u64; let b: u64 = alignment as u64; let remainder: u64 = a%b; if (remainder == 0) { return core::option::Some(value); } return checked(a+b-remainder); }
pub fn checked_align_down(value: u8, alignment: u8) -> core::option::Option<u8> { if (alignment == 0) { return core::option::None(); } return core::option::Some(value-value%alignment); }
// Traps for zero alignment or rounded-result overflow.
pub fn align_up(value: u8, alignment: u8) -> u8 { return core::option::unwrap(checked_align_up(value,alignment)); }
// Traps for zero alignment; a valid result may be zero.
pub fn align_down(value: u8, alignment: u8) -> u8 { return core::option::unwrap(checked_align_down(value,alignment)); }

// Integer conversions: checked means numeric range, wrapping keeps low bits.
pub fn from_u8(value: u8) -> u8 { return value as u8; }
pub fn checked_from_i8(value: i8) -> core::option::Option<u8> { if (value < 0) { return core::option::None(); } return core::option::Some(value as u8); }
pub fn saturating_from_i8(value: i8) -> u8 { if (value < 0) { return MIN; } return value as u8; }
pub fn wrapping_from_i8(value: i8) -> u8 { return value as u8; }
pub fn checked_from_u8(value: u8) -> core::option::Option<u8> { return core::option::Some(value as u8); }
pub fn saturating_from_u8(value: u8) -> u8 { return value as u8; }
pub fn wrapping_from_u8(value: u8) -> u8 { return value as u8; }
pub fn checked_from_i16(value: i16) -> core::option::Option<u8> { if (value < 0 || value > 255) { return core::option::None(); } return core::option::Some(value as u8); }
pub fn saturating_from_i16(value: i16) -> u8 { if (value < 0) { return MIN; } if (value > 255) { return MAX; } return value as u8; }
pub fn wrapping_from_i16(value: i16) -> u8 { return value as u8; }
pub fn checked_from_u16(value: u16) -> core::option::Option<u8> { if (value > 255) { return core::option::None(); } return core::option::Some(value as u8); }
pub fn saturating_from_u16(value: u16) -> u8 { if (value > 255) { return MAX; } return value as u8; }
pub fn wrapping_from_u16(value: u16) -> u8 { return value as u8; }
pub fn checked_from_i32(value: i32) -> core::option::Option<u8> { if (value < 0 || value > 255) { return core::option::None(); } return core::option::Some(value as u8); }
pub fn saturating_from_i32(value: i32) -> u8 { if (value < 0) { return MIN; } if (value > 255) { return MAX; } return value as u8; }
pub fn wrapping_from_i32(value: i32) -> u8 { return value as u8; }
pub fn checked_from_u32(value: u32) -> core::option::Option<u8> { if (value > 255) { return core::option::None(); } return core::option::Some(value as u8); }
pub fn saturating_from_u32(value: u32) -> u8 { if (value > 255) { return MAX; } return value as u8; }
pub fn wrapping_from_u32(value: u32) -> u8 { return value as u8; }
pub fn checked_from_i64(value: i64) -> core::option::Option<u8> { if (value < 0 || value > 255) { return core::option::None(); } return core::option::Some(value as u8); }
pub fn saturating_from_i64(value: i64) -> u8 { if (value < 0) { return MIN; } if (value > 255) { return MAX; } return value as u8; }
pub fn wrapping_from_i64(value: i64) -> u8 { return value as u8; }
pub fn checked_from_u64(value: u64) -> core::option::Option<u8> { if (value > 255) { return core::option::None(); } return core::option::Some(value as u8); }
pub fn saturating_from_u64(value: u64) -> u8 { if (value > 255) { return MAX; } return value as u8; }
pub fn wrapping_from_u64(value: u64) -> u8 { return value as u8; }
pub fn checked_from_isize(value: isize) -> core::option::Option<u8> { if (value < 0 || value > 255) { return core::option::None(); } return core::option::Some(value as u8); }
pub fn saturating_from_isize(value: isize) -> u8 { if (value < 0) { return MIN; } if (value > 255) { return MAX; } return value as u8; }
pub fn wrapping_from_isize(value: isize) -> u8 { return value as u8; }
pub fn checked_from_usize(value: usize) -> core::option::Option<u8> { if (value > 255) { return core::option::None(); } return core::option::Some(value as u8); }
pub fn saturating_from_usize(value: usize) -> u8 { if (value > 255) { return MAX; } return value as u8; }
pub fn wrapping_from_usize(value: usize) -> u8 { return value as u8; }
pub fn checked_to_i8(value: u8) -> core::option::Option<i8> { if (value > 127) { return core::option::None(); } return core::option::Some(value as i8); }
pub fn saturating_to_i8(value: u8) -> i8 { if (value > 127) { return 127; } return value as i8; }
pub fn wrapping_to_i8(value: u8) -> i8 { return value as i8; }
pub fn checked_to_u8(value: u8) -> core::option::Option<u8> { return core::option::Some(value as u8); }
pub fn saturating_to_u8(value: u8) -> u8 { return value as u8; }
pub fn wrapping_to_u8(value: u8) -> u8 { return value as u8; }
pub fn checked_to_i16(value: u8) -> core::option::Option<i16> { return core::option::Some(value as i16); }
pub fn saturating_to_i16(value: u8) -> i16 { return value as i16; }
pub fn wrapping_to_i16(value: u8) -> i16 { return value as i16; }
pub fn checked_to_u16(value: u8) -> core::option::Option<u16> { return core::option::Some(value as u16); }
pub fn saturating_to_u16(value: u8) -> u16 { return value as u16; }
pub fn wrapping_to_u16(value: u8) -> u16 { return value as u16; }
pub fn checked_to_i32(value: u8) -> core::option::Option<i32> { return core::option::Some(value as i32); }
pub fn saturating_to_i32(value: u8) -> i32 { return value as i32; }
pub fn wrapping_to_i32(value: u8) -> i32 { return value as i32; }
pub fn checked_to_u32(value: u8) -> core::option::Option<u32> { return core::option::Some(value as u32); }
pub fn saturating_to_u32(value: u8) -> u32 { return value as u32; }
pub fn wrapping_to_u32(value: u8) -> u32 { return value as u32; }
pub fn checked_to_i64(value: u8) -> core::option::Option<i64> { return core::option::Some(value as i64); }
pub fn saturating_to_i64(value: u8) -> i64 { return value as i64; }
pub fn wrapping_to_i64(value: u8) -> i64 { return value as i64; }
pub fn checked_to_u64(value: u8) -> core::option::Option<u64> { return core::option::Some(value as u64); }
pub fn saturating_to_u64(value: u8) -> u64 { return value as u64; }
pub fn wrapping_to_u64(value: u8) -> u64 { return value as u64; }
pub fn checked_to_isize(value: u8) -> core::option::Option<isize> { return core::option::Some(value as isize); }
pub fn saturating_to_isize(value: u8) -> isize { return value as isize; }
pub fn wrapping_to_isize(value: u8) -> isize { return value as isize; }
pub fn checked_to_usize(value: u8) -> core::option::Option<usize> { return core::option::Some(value as usize); }
pub fn saturating_to_usize(value: u8) -> usize { return value as usize; }
pub fn wrapping_to_usize(value: u8) -> usize { return value as usize; }
pub fn high_nibble(value: u8) -> u8 {
    return value >> 4;
}
pub fn low_nibble(value: u8) -> u8 {
    return value&15;
}
pub fn join_nibbles_or(high: u8, low: u8, fallback: u8) -> u8 {
    if (high>15 || low>15) {
        return fallback;
    }
    return(high << 4)|low;
}
pub fn is_ascii(value: u8) -> bool {
    return value <= 127;
}
pub fn is_ascii_digit(value: u8) -> bool {
    return value >= 48 && value <= 57;
}
pub fn is_ascii_lowercase(value: u8) -> bool {
    return value >= 97 && value <= 122;
}
pub fn is_ascii_uppercase(value: u8) -> bool {
    return value >= 65 && value <= 90;
}
pub fn is_ascii_alphabetic(value: u8) -> bool {
    return is_ascii_lowercase(value) || is_ascii_uppercase(value);
}
pub fn is_ascii_alphanumeric(value: u8) -> bool {
    return is_ascii_alphabetic(value) || is_ascii_digit(value);
}
pub fn is_ascii_word(value: u8) -> bool {
    return is_ascii_alphanumeric(value) || value == 95;
}
pub fn to_ascii_lowercase(value: u8) -> u8 {
    if (is_ascii_uppercase(value)) {
        return value + 32;
    }
    return value;
}
pub fn to_ascii_uppercase(value: u8) -> u8 {
    if (is_ascii_lowercase(value)) {
        return value - 32;
    }
    return value;
}
pub fn eq_ignore_ascii_case(left: u8, right: u8) -> bool {
    return to_ascii_lowercase(left) == to_ascii_lowercase(right);
}
pub fn is_ascii_hexdigit(value: u8) -> bool {
    return is_ascii_digit(value) || value >= 65 && value <= 70 || value >= 97 && value <= 102;
}
pub fn ascii_hexdigit_value_or(value: u8, fallback: u8) -> u8 {
    if (is_ascii_digit(value)) {
        return value - 48;
    }
    if (value >= 65 && value <= 70) {
        return value - 55;
    }
    if (value >= 97 && value <= 102) {
        return value - 87;
    }
    return fallback;
}
pub fn ascii_lower_hex_digit_or(value: u8, fallback: u8) -> u8 {
    if (value <= 9) {
        return value + 48;
    }
    if (value <= 15) {
        return value + 87;
    }
    return fallback;
}
pub fn ascii_upper_hex_digit_or(value: u8, fallback: u8) -> u8 {
    if (value <= 9) {
        return value + 48;
    }
    if (value <= 15) {
        return value + 55;
    }
    return fallback;
}
pub fn is_ascii_whitespace(value: u8) -> bool {
    return value == 32 || value >= 9 && value <= 13;
}
pub fn is_ascii_control(value: u8) -> bool {
    return value <= 31 || value == 127;
}
pub fn is_ascii_graphic(value: u8) -> bool {
    return value >= 33 && value <= 126;
}
pub fn is_ascii_printable(value: u8) -> bool {
    return value >= 32 && value <= 126;
}
pub fn is_ascii_punctuation(value: u8) -> bool {
    return is_ascii_graphic(value) && !is_ascii_alphanumeric(value);
}
