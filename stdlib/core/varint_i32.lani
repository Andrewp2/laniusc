// Signed i32 ZigZag encoding over canonical unsigned LEB128.
module core::varint_i32;
import core::varint;

// Map 0, -1, 1, -2, ... to 0, 1, 2, 3, ... without signed overflow.
pub fn zigzag_encode(value: i32) -> u32 {
    let bits: u32 = value as u32;
    let sign_mask: u32 = 0;
    if (value < 0) { sign_mask = 4294967295; }
    return (bits << 1) ^ sign_mask;
}

pub fn zigzag_decode(value: u32) -> i32 {
    let shifted: u32 = value >> 1;
    if ((value & 1) != 0) {
        let negative_bits: u32 = shifted ^ 4294967295;
        return negative_bits as i32;
    }
    return shifted as i32;
}

pub fn len_i32(value: i32) -> i32 {
    return core::varint::len_u32(zigzag_encode(value));
}

// Return the next offset, or -1 without writing on invalid logical bounds
// or insufficient capacity. A physical backing overclaim may trap.
pub fn write_i32(bytes: [u8], len: i32, offset: i32, value: i32) -> i32 {
    return core::varint::write_u32(bytes, len, offset, zigzag_encode(value));
}

// The returned unsigned result carries the same status and next offset as
// the wire value. Decode only through value_i32_or after checking status.
pub fn read_i32(bytes: [u8], len: i32, offset: i32) -> core::varint::ReadU32 {
    return core::varint::read_u32(bytes, len, offset);
}

pub fn value_i32_or(result: core::varint::ReadU32, fallback: i32) -> i32 {
    if (core::varint::status_u32(result) != core::varint::OK) { return fallback; }
    return zigzag_decode(core::varint::value_u32_or(result, 0));
}
