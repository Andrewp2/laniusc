// Allocation-free decimal parsing and formatting for native integer types.
// See docs/stdlib-decimal.md for grammar, bounds and target contracts.
module core::decimal;
import core::result;

pub fn len_u32(value: u32) -> u32 {
    let remaining: u32 = value;
    let length: u32 = 1;
    while (remaining >= 10) {
        remaining /= 10;
        length += 1;
    }
    return length;
}

// Index zero is the most significant ASCII digit. Invalid indices return the
// caller's fallback; the function never writes through a pointer.
pub fn byte_at_or_u32(value: u32, index: u32, fallback: u8) -> u8 {
    let length: u32 = len_u32(value);
    if (index >= length) {
        return fallback;
    }
    let place: u32 = 1;
    let remaining: u32 = length - index - 1;
    while (remaining > 0) {
        place *= 10;
        remaining -= 1;
    }
    let digit: u32 = (value / place) % 10;
    let ascii: u32 = 48 + digit;
    return ascii as u8;
}

fn magnitude_i32(value: i32) -> u32 {
    if (value == -2147483648) {
        return 2147483648;
    }
    if (value < 0) {
        let positive: i32 = -value;
        return positive as u32;
    }
    return value as u32;
}

pub fn len_i32(value: i32) -> u32 {
    let digits: u32 = len_u32(magnitude_i32(value));
    if (value < 0) {
        return digits + 1;
    }
    return digits;
}

// Negative values include an ASCII minus at index zero. MIN is handled
// without negating it. Invalid indices return fallback unchanged.
pub fn byte_at_or_i32(value: i32, index: u32, fallback: u8) -> u8 {
    if (value < 0) {
        if (index == 0) {
            return 45;
        }
        return byte_at_or_u32(magnitude_i32(value), index - 1, fallback);
    }
    return byte_at_or_u32(magnitude_i32(value), index, fallback);
}

pub fn len_u8(value: u8) -> u32 {
    let widened: u32 = value as u32;
    return len_u32(widened);
}

pub fn byte_at_or_u8(value: u8, index: u32, fallback: u8) -> u8 {
    let widened: u32 = value as u32;
    return byte_at_or_u32(widened, index, fallback);
}

pub fn len_u16(value: u16) -> u32 {
    let widened: u32 = value as u32;
    return len_u32(widened);
}

pub fn byte_at_or_u16(value: u16, index: u32, fallback: u8) -> u8 {
    let widened: u32 = value as u32;
    return byte_at_or_u32(widened, index, fallback);
}

pub fn len_i8(value: i8) -> u32 {
    let widened: i32 = value as i32;
    return len_i32(widened);
}

pub fn byte_at_or_i8(value: i8, index: u32, fallback: u8) -> u8 {
    let widened: i32 = value as i32;
    return byte_at_or_i32(widened, index, fallback);
}

pub fn len_i16(value: i16) -> u32 {
    let widened: i32 = value as i32;
    return len_i32(widened);
}

pub fn byte_at_or_i16(value: i16, index: u32, fallback: u8) -> u8 {
    let widened: i32 = value as i32;
    return byte_at_or_i32(widened, index, fallback);
}

pub fn len_u64(value: u64) -> u32 {
    let remaining: u64 = value;
    let length: u32 = 1;
    while (remaining >= 10) { remaining /= 10; length += 1; }
    return length;
}

pub fn byte_at_or_u64(value: u64, index: u32, fallback: u8) -> u8 {
    let length: u32 = len_u64(value);
    if (index >= length) { return fallback; }
    let place: u64 = 1;
    let remaining: u32 = length - index - 1;
    while (remaining > 0) { place *= 10; remaining -= 1; }
    return (48 + (value / place) % 10) as u8;
}

fn magnitude_i64(value: i64) -> u64 {
    // value + 1 and its negation are representable, including for i64::MIN.
    if (value < 0) {
        let almost: i64 = -(value + 1);
        return (almost as u64) + 1;
    }
    return value as u64;
}

pub fn len_i64(value: i64) -> u32 {
    let digits: u32 = len_u64(magnitude_i64(value));
    if (value < 0) { return digits + 1; }
    return digits;
}

pub fn byte_at_or_i64(value: i64, index: u32, fallback: u8) -> u8 {
    if (value < 0) {
        if (index == 0) { return 45; }
        return byte_at_or_u64(magnitude_i64(value), index - 1, fallback);
    }
    return byte_at_or_u64(magnitude_i64(value), index, fallback);
}

// The current language target defines isize/usize as 64-bit integers.
pub fn len_usize(value: usize) -> u32 { return len_u64(value as u64); }
pub fn len_isize(value: isize) -> u32 { return len_i64(value as i64); }
pub fn byte_at_or_usize(value: usize, index: u32, fallback: u8) -> u8 {
    return byte_at_or_u64(value as u64, index, fallback);
}
pub fn byte_at_or_isize(value: isize, index: u32, fallback: u8) -> u8 {
    return byte_at_or_i64(value as i64, index, fallback);
}

pub enum FormatError { Bounds, BufferTooSmall(i32) }

// Validate the entire logical destination before writing. No terminator or
// padding is emitted. The caller must physically back offset + capacity bytes.
fn format_magnitude(destination: [u8], offset: i32, capacity: i32, magnitude: u64, negative: bool)
    -> core::result::Result<i32, FormatError> {
    if (offset < 0 || capacity < 0 || offset > 2147483647 - capacity) { return core::result::Err(FormatError::Bounds); }
    let sign: i32 = 0;
    if (negative) { sign = 1; }
    let length: i32 = (len_u64(magnitude) as i32) + sign;
    if (capacity < length) { return core::result::Err(FormatError::BufferTooSmall(length)); }
    let remaining: u64 = magnitude;
    let index: i32 = offset + length;
    while (index > offset + sign) {
        index -= 1;
        destination[index] = (48 + remaining % 10) as u8;
        remaining /= 10;
    }
    if (negative) { destination[offset] = 45; }
    return core::result::Ok(length);
}

pub fn format_u64(destination: [u8], offset: i32, capacity: i32, value: u64) -> core::result::Result<i32, FormatError> {
    return format_magnitude(destination, offset, capacity, value, false);
}
pub fn format_i64(destination: [u8], offset: i32, capacity: i32, value: i64) -> core::result::Result<i32, FormatError> {
    return format_magnitude(destination, offset, capacity, magnitude_i64(value), value < 0);
}
pub fn format_u8(destination: [u8], offset: i32, capacity: i32, value: u8) -> core::result::Result<i32, FormatError> {
    return format_u64(destination, offset, capacity, value as u64);
}
pub fn format_u16(destination: [u8], offset: i32, capacity: i32, value: u16) -> core::result::Result<i32, FormatError> {
    return format_u64(destination, offset, capacity, value as u64);
}
pub fn format_u32(destination: [u8], offset: i32, capacity: i32, value: u32) -> core::result::Result<i32, FormatError> {
    return format_u64(destination, offset, capacity, value as u64);
}
pub fn format_usize(destination: [u8], offset: i32, capacity: i32, value: usize) -> core::result::Result<i32, FormatError> {
    return format_u64(destination, offset, capacity, value as u64);
}
pub fn format_i8(destination: [u8], offset: i32, capacity: i32, value: i8) -> core::result::Result<i32, FormatError> {
    return format_i64(destination, offset, capacity, value as i64);
}
pub fn format_i16(destination: [u8], offset: i32, capacity: i32, value: i16) -> core::result::Result<i32, FormatError> {
    return format_i64(destination, offset, capacity, value as i64);
}
pub fn format_i32(destination: [u8], offset: i32, capacity: i32, value: i32) -> core::result::Result<i32, FormatError> {
    return format_i64(destination, offset, capacity, value as i64);
}
pub fn format_isize(destination: [u8], offset: i32, capacity: i32, value: isize) -> core::result::Result<i32, FormatError> {
    return format_i64(destination, offset, capacity, value as i64);
}

// A decimal ASCII byte can extend current without exceeding limit only when
// both the syntax and the arithmetic bound are valid. Limit may be below MAX.
pub fn can_append_ascii_digit_u32(current: u32, byte: u8, limit: u32) -> bool {
    if (byte < 48 || byte > 57) {
        return false;
    }
    let widened: u32 = byte as u32;
    let digit: u32 = widened - 48;
    return current < limit / 10 || current == limit / 10 && digit <= limit % 10;
}

// On malformed input or overflow, return fallback without arithmetic wrap.
// A successful value may equal fallback; use can_append_ascii_digit_u32 when
// the caller needs a separate success result.
pub fn append_ascii_digit_or_u32(current: u32, byte: u8, limit: u32, fallback: u32) -> u32 {
    if (!can_append_ascii_digit_u32(current, byte, limit)) {
        return fallback;
    }
    let widened: u32 = byte as u32;
    let digit: u32 = widened - 48;
    return current * 10 + digit;
}

// Parse exactly len ASCII digit codes from a backed [i32] view. No sign or
// whitespace is accepted. An empty, malformed, or overflowing input returns
// fallback. A valid parsed value may equal fallback; use a distinct fallback
// when the caller needs to distinguish failure. An overstated physical view
// length can trap on native indexing.
pub fn parse_ascii_u32_or(values: [i32], len: i32, fallback: u32) -> u32 {
    if (len<=0) {
        return fallback;
    }
    let maximum: u32 = 4294967295;
    let result: u32 = 0;
    let index: i32 = 0;
    while (index<len) {
        let code: i32 = values[index];
        if (code<48 || code>57) {
            return fallback;
        }
        let byte: u8 = code as u8;
        if (!can_append_ascii_digit_u32(result, byte, maximum)) {
            return fallback;
        }
        result = append_ascii_digit_or_u32(result, byte, maximum, fallback);
        index += 1;
    }
    return result;
}

// Parse an optional leading + or - followed by at least one ASCII digit.
// No whitespace is accepted. MIN is parsed without negating that value.
// Empty, sign-only, malformed, or overflowing input returns fallback. A valid
// parsed value may equal fallback. The physical view must back len elements.
pub fn parse_ascii_i32_or(values: [i32], len: i32, fallback: i32) -> i32 {
    if (len<=0) {
        return fallback;
    }
    let negative: bool = false;
    let index: i32 = 0;
    if (values[0] == 45) {
        negative = true;
        index = 1;
    } else {
        if (values[0] == 43) {
            index = 1;
        }
    }
    if (index == len) {
        return fallback;
    }
    let limit: u32 = 2147483647;
    if (negative) {
        limit = 2147483648;
    }
    let magnitude: u32 = 0;
    while (index<len) {
        let code: i32 = values[index];
        if (code<48 || code>57) {
            return fallback;
        }
        let byte: u8 = code as u8;
        if (!can_append_ascii_digit_u32(magnitude, byte, limit)) {
            return fallback;
        }
        magnitude = append_ascii_digit_or_u32(magnitude, byte, limit, 0);
        index += 1;
    }
    if (negative) {
        if (magnitude == 2147483648) {
            return -2147483648;
        }
        let signed: i32 = magnitude as i32;
        return -signed;
    }
    return magnitude as i32;
}

// Narrow parsers inherit the exact ASCII grammar of the 32-bit parsers and
// reject values outside their target width before narrowing. The internal
// sentinel is outside each target width, so parse failure cannot be mistaken
// for a valid narrow result. A valid narrow result may equal caller fallback.
pub fn parse_ascii_u8_or(values: [i32], len: i32, fallback: u8) -> u8 {
    let parsed: u32 = parse_ascii_u32_or(values, len, 4294967295);
    if (parsed>255) {
        return fallback;
    }
    return parsed as u8;
}

pub fn parse_ascii_u16_or(values: [i32], len: i32, fallback: u16) -> u16 {
    let parsed: u32 = parse_ascii_u32_or(values, len, 4294967295);
    if (parsed>65535) {
        return fallback;
    }
    return parsed as u16;
}

pub fn parse_ascii_i8_or(values: [i32], len: i32, fallback: i8) -> i8 {
    let parsed: i32 = parse_ascii_i32_or(values, len, 2147483647);
    if (parsed< -128 || parsed>127) {
        return fallback;
    }
    return parsed as i8;
}

pub fn parse_ascii_i16_or(values: [i32], len: i32, fallback: i16) -> i16 {
    let parsed: i32 = parse_ascii_i32_or(values, len, 2147483647);
    if (parsed< -32768 || parsed>32767) {
        return fallback;
    }
    return parsed as i16;
}

// Parse packed bytes without a sentinel. The slice must back count elements;
// overclaiming its physical length traps on indexing until length projection
// is available. Signed types accept one leading + or -, unsigned types neither.
// Leading zeroes are accepted; whitespace, separators and non-ASCII digits are
// rejected. Errors identify the first offending byte; a missing digit is EOF.
pub enum ParseErrorKind { Bounds, Empty, MissingDigits, InvalidDigit, Overflow }
pub struct ParseError { kind: ParseErrorKind, offset: i32 }

fn parse_error(kind: ParseErrorKind, offset: i32) -> ParseError {
    return ParseError { kind: kind, offset: offset };
}
fn parse_magnitude(bytes: [u8], offset: i32, count: i32, start: i32, limit: u64) -> core::result::Result<u64, ParseError> {
    if (offset < 0 || count < 0 || count > 2147483647 - offset) { return core::result::Err(parse_error(ParseErrorKind::Bounds, -1)); }
    if (count == 0) { return core::result::Err(parse_error(ParseErrorKind::Empty, 0)); }
    if (start == count) { return core::result::Err(parse_error(ParseErrorKind::MissingDigits, count)); }
    let value: u64 = 0;
    let threshold: u64 = limit / 10;
    let final_digit: u64 = limit % 10;
    let index: i32 = start;
    while (index < count) {
        let byte: u8 = bytes[offset + index];
        if (byte < 48 || byte > 57) { return core::result::Err(parse_error(ParseErrorKind::InvalidDigit, index)); }
        let digit: u64 = (byte as u64) - 48;
        if (value > threshold || value == threshold && digit > final_digit) {
            return core::result::Err(parse_error(ParseErrorKind::Overflow, index));
        }
        value = value * 10 + digit;
        index += 1;
    }
    return core::result::Ok(value);
}
fn parse_signed(bytes: [u8], offset: i32, count: i32, positive_limit: u64, negative_limit: u64)
    -> core::result::Result<i64, ParseError> {
    if (offset < 0 || count < 0 || count > 2147483647 - offset) { return core::result::Err(parse_error(ParseErrorKind::Bounds, -1)); }
    if (count == 0) { return core::result::Err(parse_error(ParseErrorKind::Empty, 0)); }
    let negative: bool = bytes[offset] == 45;
    let start: i32 = 0;
    if (negative || bytes[offset] == 43) { start = 1; }
    let limit: u64 = positive_limit;
    if (negative) { limit = negative_limit; }
    let parsed: core::result::Result<u64, ParseError> = parse_magnitude(bytes, offset, count, start, limit);
    if (core::result::is_err(parsed)) { return core::result::Err(core::result::unwrap_err(parsed)); }
    let magnitude: u64 = core::result::unwrap(parsed);
    if (negative) {
        if (magnitude == 9223372036854775808) {
            let minimum: i64 = -9223372036854775808;
            return core::result::Ok(minimum);
        }
        let signed: i64 = magnitude as i64;
        return core::result::Ok(-signed);
    }
    return core::result::Ok(magnitude as i64);
}

// Range parsers report errors relative to offset. Negative/overflowing
// integer ranges are Bounds before indexing; physical overclaims still trap.
pub fn parse_u8_range(bytes: [u8], offset: i32, count: i32) -> core::result::Result<u8, ParseError> {
    let parsed: core::result::Result<u64, ParseError> = parse_magnitude(bytes, offset, count, 0, 255);
    if (core::result::is_err(parsed)) { return core::result::Err(core::result::unwrap_err(parsed)); }
    return core::result::Ok(core::result::unwrap(parsed) as u8);
}

pub fn parse_u16_range(bytes: [u8], offset: i32, count: i32) -> core::result::Result<u16, ParseError> {
    let parsed: core::result::Result<u64, ParseError> = parse_magnitude(bytes, offset, count, 0, 65535);
    if (core::result::is_err(parsed)) { return core::result::Err(core::result::unwrap_err(parsed)); }
    return core::result::Ok(core::result::unwrap(parsed) as u16);
}

pub fn parse_u32_range(bytes: [u8], offset: i32, count: i32) -> core::result::Result<u32, ParseError> {
    let parsed: core::result::Result<u64, ParseError> = parse_magnitude(bytes, offset, count, 0, 4294967295);
    if (core::result::is_err(parsed)) { return core::result::Err(core::result::unwrap_err(parsed)); }
    return core::result::Ok(core::result::unwrap(parsed) as u32);
}

pub fn parse_i8_range(bytes: [u8], offset: i32, count: i32) -> core::result::Result<i8, ParseError> {
    let parsed: core::result::Result<i64, ParseError> = parse_signed(bytes, offset, count, 127, 128);
    if (core::result::is_err(parsed)) { return core::result::Err(core::result::unwrap_err(parsed)); }
    return core::result::Ok(core::result::unwrap(parsed) as i8);
}

pub fn parse_i16_range(bytes: [u8], offset: i32, count: i32) -> core::result::Result<i16, ParseError> {
    let parsed: core::result::Result<i64, ParseError> = parse_signed(bytes, offset, count, 32767, 32768);
    if (core::result::is_err(parsed)) { return core::result::Err(core::result::unwrap_err(parsed)); }
    return core::result::Ok(core::result::unwrap(parsed) as i16);
}

pub fn parse_i32_range(bytes: [u8], offset: i32, count: i32) -> core::result::Result<i32, ParseError> {
    let parsed: core::result::Result<i64, ParseError> = parse_signed(bytes, offset, count, 2147483647, 2147483648);
    if (core::result::is_err(parsed)) { return core::result::Err(core::result::unwrap_err(parsed)); }
    return core::result::Ok(core::result::unwrap(parsed) as i32);
}

pub fn parse_u8(bytes: [u8], count: i32) -> core::result::Result<u8, ParseError> {
    return parse_u8_range(bytes, 0, count);
}

pub fn parse_u16(bytes: [u8], count: i32) -> core::result::Result<u16, ParseError> {
    return parse_u16_range(bytes, 0, count);
}

pub fn parse_u32(bytes: [u8], count: i32) -> core::result::Result<u32, ParseError> {
    return parse_u32_range(bytes, 0, count);
}

pub fn parse_i8(bytes: [u8], count: i32) -> core::result::Result<i8, ParseError> {
    return parse_i8_range(bytes, 0, count);
}

pub fn parse_i16(bytes: [u8], count: i32) -> core::result::Result<i16, ParseError> {
    return parse_i16_range(bytes, 0, count);
}

pub fn parse_i32(bytes: [u8], count: i32) -> core::result::Result<i32, ParseError> {
    return parse_i32_range(bytes, 0, count);
}

pub fn parse_u64_range(bytes: [u8], offset: i32, count: i32) -> core::result::Result<u64, ParseError> {
    let maximum: u64 = 18446744073709551615;
    return parse_magnitude(bytes, offset, count, 0, maximum);
}
pub fn parse_i64_range(bytes: [u8], offset: i32, count: i32) -> core::result::Result<i64, ParseError> {
    let positive: u64 = 9223372036854775807;
    let negative: u64 = 9223372036854775808;
    return parse_signed(bytes, offset, count, positive, negative);
}
pub fn parse_usize_range(bytes: [u8], offset: i32, count: i32) -> core::result::Result<usize, ParseError> {
    let parsed: core::result::Result<u64, ParseError> = parse_u64_range(bytes, offset, count);
    if (core::result::is_err(parsed)) { return core::result::Err(core::result::unwrap_err(parsed)); }
    return core::result::Ok(core::result::unwrap(parsed) as usize);
}
pub fn parse_isize_range(bytes: [u8], offset: i32, count: i32) -> core::result::Result<isize, ParseError> {
    let parsed: core::result::Result<i64, ParseError> = parse_i64_range(bytes, offset, count);
    if (core::result::is_err(parsed)) { return core::result::Err(core::result::unwrap_err(parsed)); }
    return core::result::Ok(core::result::unwrap(parsed) as isize);
}
pub fn parse_u64(bytes: [u8], count: i32) -> core::result::Result<u64, ParseError> { return parse_u64_range(bytes, 0, count); }
pub fn parse_i64(bytes: [u8], count: i32) -> core::result::Result<i64, ParseError> { return parse_i64_range(bytes, 0, count); }
pub fn parse_usize(bytes: [u8], count: i32) -> core::result::Result<usize, ParseError> { return parse_usize_range(bytes, 0, count); }
pub fn parse_isize(bytes: [u8], count: i32) -> core::result::Result<isize, ParseError> { return parse_isize_range(bytes, 0, count); }
