// A signed-byte set backed by eight caller-owned u32 words. Its ordinals
// follow signed order from -128 through 127. Storage is borrowed; clearing a
// set does not free it. Every operation requires eight addressable words.
// Exact source/destination aliases are supported by set algebra; partially
// overlapping views are not.
module std::set_i8;
import std::set_u8;

fn code(item: i8) -> u8 {
    let signed: i32 = item as i32;
    let shifted: i32 = signed + 128;
    let byte: u8 = shifted as u8;
    return byte;
}

fn item_from_code(byte: u8) -> i8 {
    let widened: i32 = byte as i32;
    let signed: i32 = widened - 128;
    let item: i8 = signed as i8;
    return item;
}

pub fn len(words: [u32]) -> i32 {
    return std::set_u8::len(words);
}

pub fn is_empty(words: [u32]) -> bool {
    return std::set_u8::is_empty(words);
}

pub fn is_full(words: [u32]) -> bool {
    return std::set_u8::is_full(words);
}

pub fn contains(words: [u32], item: i8) -> bool {
    return std::set_u8::contains(words, code(item));
}

// Invalid ordinals return fallback. Check len if a stored byte can equal it.
pub fn at_or(words: [u32], ordinal: i32, fallback: i8) -> i8 {
    if (ordinal < 0 || ordinal >= len(words)) { return fallback; }
    return item_from_code(std::set_u8::at_or(words, ordinal, 0));
}

// Return true only when membership changes.
pub fn insert(words: [u32], item: i8) -> bool {
    return std::set_u8::insert(words, code(item));
}

pub fn remove(words: [u32], item: i8) -> bool {
    return std::set_u8::remove(words, code(item));
}

pub fn fill(words: [u32], present: bool) {
    std::set_u8::fill(words, present);
}

pub fn clear(words: [u32]) {
    std::set_u8::clear(words);
}

pub fn is_subset(left: [u32], right: [u32]) -> bool {
    return std::set_u8::is_subset(left, right);
}

pub fn is_disjoint(left: [u32], right: [u32]) -> bool {
    return std::set_u8::is_disjoint(left, right);
}

pub fn union_into(destination: [u32], left: [u32], right: [u32]) {
    std::set_u8::union_into(destination, left, right);
}

pub fn intersection_into(destination: [u32], left: [u32], right: [u32]) {
    std::set_u8::intersection_into(destination, left, right);
}

pub fn difference_into(destination: [u32], left: [u32], right: [u32]) {
    std::set_u8::difference_into(destination, left, right);
}

pub fn symmetric_difference_into(destination: [u32], left: [u32], right: [u32]) {
    std::set_u8::symmetric_difference_into(destination, left, right);
}
