// x86_64 Linux descriptor adapters for the portable core::io contracts.
// Handles are borrowed: these adapters never close them or change their flags.
module std::stream;
import core::io;
import core::mem;
import core::result;
import std::fs;
import alloc::io;

pub struct Descriptor { handle: i32 }

pub fn stdin() -> Descriptor { return Descriptor { handle: 0 }; }
pub fn stdout() -> Descriptor { return Descriptor { handle: 1 }; }
pub fn stderr() -> Descriptor { return Descriptor { handle: 2 }; }
pub fn from_handle(handle: i32) -> Descriptor { return Descriptor { handle: handle }; }

// Convenience copy with 1024 bytes of packed, stack-owned scratch storage.
// Use core::io::copy to provide your own scratch view and capacity.
pub fn copy<R, W>(reader: &R, writer: &W) -> core::result::Result<u64, core::io::CopyFailure>
    where R: core::io::Read, W: core::io::Write {
    let storage: [i32; 256] = [0; 256];
    let pointer: ptr = core::mem::i32_array_data_ptr(storage);
    let scratch: [u8] = core::mem::typed_slice_from_raw_parts(pointer, 1024);
    return core::io::copy(reader, writer, scratch, 1024);
}

// Read until end of input straight into the buffer's storage: one host read
// per call of up to the buffer's free capacity (at least 64 KiB), with no
// staging copy. Returns the bytes appended. Hitting the buffer limit before
// end of input reports LimitExceeded; bytes already read stay in the buffer.
pub fn read_to_end(reader: &Descriptor, output: &alloc::io::Buffer) -> core::result::Result<u64, core::io::Error> {
    let total: u64 = 0;
    while (true) {
        let room: i32 = output.capacity() - output.len();
        if (room < 65536) { room = 65536; }
        if (room > output.limit() - output.len()) { room = output.limit() - output.len(); }
        if (room == 0) {
            // Probe one byte to tell a full buffer from end of input.
            let probe: [i32; 1] = [0; 1];
            let got: i32 = std::fs::read(reader.handle, core::mem::i32_array_data_ptr(probe), 1);
            if (got == 0) { return core::result::Ok(total); }
            if (got < 0) { if (got == -4) { continue; } return core::result::Err(host_error(got)); }
            return core::result::Err(core::io::Error::LimitExceeded);
        }
        let window: core::result::Result<ptr, core::io::Error> = output.reserve_raw(room);
        if (core::result::is_err(window)) { return core::result::Err(core::result::unwrap_err(window)); }
        let received: i32 = std::fs::read(reader.handle, core::result::unwrap(window), room as usize);
        if (received == 0) { return core::result::Ok(total); }
        if (received < 0) { if (received == -4) { continue; } return core::result::Err(host_error(received)); }
        if (received > room) { return core::result::Err(core::io::Error::InvalidCount); }
        let committed: core::result::Result<i32, core::io::Error> = output.commit_raw(received);
        total += received as u64;
    }
    return core::result::Ok(total);
}

pub impl Descriptor {
    pub fn borrow(&self) -> &Descriptor { return self; }
    pub fn raw_handle(&self) -> i32 { return self.handle; }
}

fn host_error(result: i32) -> core::io::Error {
    if (result == -4) { return core::io::Error::Interrupted; }
    if (result == -11) { return core::io::Error::WouldBlock; }
    return core::io::Error::Host(0 - result);
}

// Each call transfers at most 1024 bytes and allocates no heap memory; the
// per-call cap is part of the observable contract (callers and their traced
// tests see the same request sizes on every layout). A packed (stride +1)
// byte view is contiguous native memory, so the host reads or writes the
// caller's own bytes in place with no staging copy. Other layouts, such as
// native [u8; N] arrays (which are not raw byte arrays), go through a private
// packed staging buffer filled or drained element by element.
fn packed_at(values: [u8], offset: i32) -> ptr {
    if (core::mem::slice_stride(values) != 1) { let nowhere: ptr = 0; return nowhere; }
    return core::mem::i32_slice_data_ptr(values) + (offset as usize);
}

pub impl core::io::Read for Descriptor {
    pub fn read(&self, destination: [u8], offset: i32, count: i32)
        -> core::result::Result<i32, core::io::Error> {
        if (!core::io::valid_range(offset, count)) { return core::result::Err(core::io::Error::InvalidInput); }
        if (count == 0) { return core::result::Ok(0); }
        let direct: ptr = packed_at(destination, offset);
        if (direct != 0) {
            let amount: i32 = count;
            if (amount > 1024) { amount = 1024; }
            // The host touches amount bytes in place: index the last one first
            // so a range past the view's backing traps instead of overrunning.
            let last: u8 = destination[offset + amount - 1];
            let moved: i32 = std::fs::read(self.handle, direct, amount as usize);
            if (moved < 0) { return core::result::Err(host_error(moved)); }
            if (moved > amount) { return core::result::Err(core::io::Error::InvalidCount); }
            return core::result::Ok(moved);
        }
        let amount: i32 = count;
        if (amount > 1024) { amount = 1024; }
        let storage: [i32; 256] = [0; 256];
        let pointer: ptr = core::mem::i32_array_data_ptr(storage);
        let received: i32 = std::fs::read(self.handle, pointer, amount as usize);
        if (received < 0) { return core::result::Err(host_error(received)); }
        if (received > amount) { return core::result::Err(core::io::Error::InvalidCount); }
        let packed: [u8] = core::mem::typed_slice_from_raw_parts(pointer, received);
        let index: i32 = 0;
        while (index < received) {
            destination[offset + index] = packed[index];
            index += 1;
        }
        return core::result::Ok(received);
    }
}

pub impl core::io::Write for Descriptor {
    pub fn write(&self, source: [u8], offset: i32, count: i32)
        -> core::result::Result<i32, core::io::Error> {
        if (!core::io::valid_range(offset, count)) { return core::result::Err(core::io::Error::InvalidInput); }
        if (count == 0) { return core::result::Ok(0); }
        let direct: ptr = packed_at(source, offset);
        if (direct != 0) {
            let amount: i32 = count;
            if (amount > 1024) { amount = 1024; }
            // The host touches amount bytes in place: index the last one first
            // so a range past the view's backing traps instead of overrunning.
            let last: u8 = source[offset + amount - 1];
            let moved: i32 = std::fs::write(self.handle, direct, amount as usize);
            if (moved < 0) { return core::result::Err(host_error(moved)); }
            if (moved > amount) { return core::result::Err(core::io::Error::InvalidCount); }
            return core::result::Ok(moved);
        }
        let amount: i32 = count;
        if (amount > 1024) { amount = 1024; }
        let storage: [i32; 256] = [0; 256];
        let pointer: ptr = core::mem::i32_array_data_ptr(storage);
        let packed: [u8] = core::mem::typed_slice_from_raw_parts(pointer, amount);
        let index: i32 = 0;
        while (index < amount) {
            packed[index] = source[offset + index];
            index += 1;
        }
        let written: i32 = std::fs::write(self.handle, pointer, amount as usize);
        if (written < 0) { return core::result::Err(host_error(written)); }
        if (written > amount) { return core::result::Err(core::io::Error::InvalidCount); }
        return core::result::Ok(written);
    }

    pub fn flush(&self) -> core::result::Result<i32, core::io::Error> {
        // Successful writes have crossed the host boundary already. This
        // adapter has no pending user-space buffer and does not promise fsync.
        return core::result::Ok(0);
    }
}
