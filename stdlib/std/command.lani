    let p = core::mem::i32_array_data_ptr(packet); let done: i32 = 0;
    while (done < 16) { let n: i64 = std::command_raw::pointer(1,fd as i64,p+(done as usize),(16-done) as i64); if (n == -4) { continue; } if (n <= 0 || n > (16-done) as i64) { break; } done += n as i32; }
    std::command_raw::terminate();
}
fn child_exec(prepared: Prepared, fds: [i32], error_fd: i32, sigpipe: ChildSigpipe, group: Group) {
    let new_group: bool = match(group) { Group::New -> true, _ -> false };
    if (new_group) { let grouped: i64 = std::command_raw::set_group(0,0); if (grouped != 0) { let errno: i32 = 5; if (grouped < 0) { errno = (0-grouped) as i32; } child_failure(error_fd,6,errno); } }
    let n: i64 = -4; while (n == -4) { n = std::command_raw::word(436,3,4294967295,4); } if (n < 0) { child_failure(error_fd,1,(0-n) as i32); }
    let i: i32 = 0; while (i < 3) {
        if (fds[i] < 0) { n = std::command_raw::close(i) as i64; if (n < 0 && n != -9) { child_failure(error_fd,2,(0-n) as i32); } }
        else { n = -4; while (n == -4) { n = std::command_raw::word(292,fds[i] as i64,i as i64,0); } if (n < 0) { child_failure(error_fd,2,(0-n) as i32); } } i += 1;
