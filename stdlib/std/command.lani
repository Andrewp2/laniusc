    while (done < 16) { let n: i64 = std::command_raw::pointer(0,channel[0] as i64,p+(done as usize),(16-done) as i64); if (n == -4) { continue; } if (n < 0) { read_error = (0-n) as i32; break; } if (n == 0) { break; } if (n > (16-done) as i64) { read_error = 5; break; } done += n as i32; }
