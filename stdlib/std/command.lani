        // Native Linux x86_64 siginfo_t: 128 bytes, child pid at byte16,
        // status at byte24, si_code at byte8. Initialize the no-event sentinel.
        let info: [i32;32] = [0;32];
        let n: i64 = std::command_raw::observe_exit(self.pid,core::mem::i32_array_data_ptr(info));
        if (n < 0) {
            if (n == -10) { self.pid = 0; self.group_confirmed = false; self.observed = core::option::None(); return core::result::Err(failure(Error::LostChild,Stage::Wait,10)); }
            return core::result::Err(host(Stage::Wait,n));
        }
        if (n != 0) { return core::result::Err(failure(Error::Host,Stage::Wait,5)); }
        if (info[4] == 0) { return core::result::Ok(core::option::None()); }
        if (info[0] != 17 || info[4] != self.pid) { return core::result::Err(failure(Error::Host,Stage::Wait,5)); }
        let raw: i32 = 0;
        if (info[2] == 1) { if (info[6] < 0 || info[6] > 255) { return core::result::Err(failure(Error::Host,Stage::Wait,5)); } raw = info[6] << 8; }
        else {
            if ((info[2] != 2 && info[2] != 3) || info[6] < 1 || info[6] > 64) { return core::result::Err(failure(Error::Host,Stage::Wait,5)); }
            raw = info[6]; if (info[2] == 3) { raw = raw | 128; }
        }
        let code: core::option::Option<i32> = core::option::None(); let signal: core::option::Option<i32> = core::option::None();
        if (info[2] == 1) { code = core::option::Some(info[6]); } else { signal = core::option::Some(info[6]); }
        self.observed = core::option::Some(ExitStatus { raw: raw, code: code, signal: signal, core_dumped: info[2] == 3 });
        return core::result::Ok(self.observed);
    }
    fn record_wait(&self, n: i64, raw: i32) -> core::result::Result<core::option::Option<ExitStatus>,Failure> {
        if (n < 0) { if (n == -10) { self.pid = 0; self.group_confirmed = false; self.observed = core::option::None(); return core::result::Err(failure(Error::LostChild,Stage::Wait,10)); } return core::result::Err(host(Stage::Wait,n)); }
        if (n != self.pid as i64 || (raw & 127) == 127) { return core::result::Err(failure(Error::Host,Stage::Wait,5)); }
        let code: core::option::Option<i32> = core::option::None(); let signal: core::option::Option<i32> = core::option::None(); let dumped: bool = false;
        if ((raw & 127) == 0) { code = core::option::Some((raw >> 8) & 255); } else { signal = core::option::Some(raw & 127); dumped = (raw & 128) != 0; }
        let status: ExitStatus = ExitStatus { raw: raw, code: code, signal: signal, core_dumped: dumped }; self.cached = core::option::Some(status); self.pid = 0; self.group_confirmed = false; self.observed = core::option::None(); return core::result::Ok(self.cached);
    }
    pub fn wait(&self) -> core::result::Result<ExitStatus,Failure> {
        let input = self.take_stdin(); if (core::option::is_some(input)) { core::option::unwrap(input).close(); }
        if (core::option::is_some(self.cached)) { return core::result::Ok(core::option::unwrap(self.cached)); } if (self.pid <= 0) { return core::result::Err(failure(Error::LostChild,Stage::Wait,10)); }
        let status: [i32;1] = [0;1]; let n = std::command_raw::wait(self.pid,core::mem::i32_array_data_ptr(status),false); let result = self.record_wait(n,status[0]); if (result.is_err()) { return core::result::Err(result.unwrap_err()); } return core::result::Ok(core::option::unwrap(result.unwrap()));
    }
    pub fn signal(&self, signal: i32) -> core::result::Result<i32,Failure> {
        if (signal < 0 || signal > 64) { return core::result::Err(failure(Error::InvalidInput,Stage::Signal,0)); } if (self.pid <= 0 || core::option::is_some(self.cached)) { return core::result::Err(failure(Error::AlreadyReaped,Stage::Signal,0)); }
        let n = std::command_raw::word(62,self.pid as i64,signal as i64,0); if (n < 0) { return core::result::Err(host(Stage::Signal,n)); } return core::result::Ok(0);
    }
    // Signal the original confirmed group, never a freshly queried arbitrary
    // group. Success proves delivery to at least one permitted member only.
    pub fn signal_group(&self, signal: i32) -> core::result::Result<i32,Failure> {
        if (signal < 0 || signal > 64) { return core::result::Err(failure(Error::InvalidInput,Stage::Signal,0)); }
        if (self.pid <= 1 || self.cached.is_some()) { return core::result::Err(failure(Error::AlreadyReaped,Stage::Signal,0)); }
        if (self.group_id().is_none()) { return core::result::Err(failure(Error::GroupUnconfirmed,Stage::ProcessGroup,0)); }
        let target: i64 = 0-(self.pid as i64);
        let n: i64 = std::command_raw::word(62,target,signal as i64,0);
        if (n < 0) { return core::result::Err(host(Stage::Signal,n)); }
        if (n != 0) { return core::result::Err(failure(Error::Host,Stage::Signal,5)); }
        return core::result::Ok(0);
    }
    // Attempt every cleanup action, preserving the first error. Any error
    // leaves the unreaped Child owner for retry; only the final wait reaps it.
    // The positive leader fallback also covers a leader that left its group.
    pub fn cancel_group_and_wait(&self) -> core::result::Result<ExitStatus,Failure> {
        if (self.pid <= 1 || self.cached.is_some()) { return core::result::Err(failure(Error::AlreadyReaped,Stage::Signal,0)); }
        if (self.group_id().is_none()) { return core::result::Err(failure(Error::GroupUnconfirmed,Stage::ProcessGroup,0)); }
        let first: core::option::Option<Failure> = core::option::None();
        let closed: core::result::Result<i32,Failure> = self.close_pipes(); if (closed.is_err()) { first = core::option::Some(closed.unwrap_err()); }
        let grouped: core::result::Result<i32,Failure> = self.signal_group(9);
        if (grouped.is_err()) { let cause: Failure = grouped.unwrap_err(); if (cause.errno != 3 && first.is_none()) { first = core::option::Some(cause); } }
        let leader: core::result::Result<i32,Failure> = self.signal(9);
        if (leader.is_err()) { let cause: Failure = leader.unwrap_err(); if (cause.errno != 3 && first.is_none()) { first = core::option::Some(cause); } }
        if (first.is_some()) { return core::result::Err(first.unwrap()); }
        return self.wait();
    }
    pub fn cancel_and_wait(&self) -> core::result::Result<ExitStatus,Failure> {
        self.close_pipes(); if (self.pid > 0) { let n = std::command_raw::word(62,self.pid as i64,9,0); if (n < 0 && n != -3) { return core::result::Err(host(Stage::Signal,n)); } } return self.wait();
    }
}

pub fn request(program: core::slice::View<u8>, arguments: core::slice::View<core::slice::View<u8>>, environment: core::slice::View<core::slice::View<u8>>) -> Request {
    return Request { program: program, arguments: arguments, environment: environment, cwd: core::option::None(), search: Search::Exact, sigpipe: ChildSigpipe::Default, group: Group::Inherit, stdin: Stdio::Inherit, stdout: Stdio::Inherit, stderr: Stdio::Inherit, limits: default_limits() };
}
pub struct Environment { bytes: alloc::vec::Vec<i32>, values: alloc::vec::Vec<core::slice::View<u8>> }
pub impl Environment {
    pub fn as_view(&self) -> core::slice::View<core::slice::View<u8>> { return self.values.as_view(); }
    pub fn destroy(&self) { self.values.destroy(); self.bytes.destroy(); }
}
fn environment_failure() -> Failure { return failure(Error::EnvironmentChanged,Stage::Environment,0); }
fn snapshot_failed(keys: alloc::vec::Vec<i32>, lengths: alloc::vec::Vec<i32>, bytes: alloc::vec::Vec<i32>, values: alloc::vec::Vec<core::slice::View<u8>>, cause: Failure) -> core::result::Result<Environment,Failure> { keys.destroy(); lengths.destroy(); values.destroy(); bytes.destroy(); return core::result::Err(cause); }
// Snapshot the variable map exposed by std::env. No environment mutation is
// permitted during this operation. Explicit Request environments preserve
// supplied entry order/duplicates; the host variable API resolves duplicate
// keys to their first visible value when constructing this convenience map.
pub fn snapshot_environment(limits: Limits) -> core::result::Result<Environment,Failure> {
    if (limits.max_env < 0 || limits.max_bytes < 0 || limits.max_string < 0) { return core::result::Err(failure(Error::Bounds,Stage::Environment,0)); }
    let count: i32 = std::env::var_count(); if (count < 0) { return core::result::Err(environment_failure()); } if (count > limits.max_env || count > 268435455) { return core::result::Err(failure(Error::Limit,Stage::Environment,0)); }
    if (count == 0) { let empty_bytes: alloc::vec::Vec<i32> = alloc::vec::new(); let empty_values: alloc::vec::Vec<core::slice::View<u8>> = alloc::vec::new(); return core::result::Ok(Environment { bytes: empty_bytes, values: empty_values }); }
    let lengths_allocated = alloc::vec::with_capacity<i32>(count*2); if (lengths_allocated.is_err()) { return core::result::Err(failure(Error::AllocationFailed,Stage::Environment,0)); } let lengths = lengths_allocated.unwrap(); lengths.try_resize(count*2,0).unwrap(); let maximum: i32 = 0; let i: i32 = 0;
    while (i < count) { let n: i32 = std::env::var_key_len(i); if (n <= 0) { lengths.destroy(); return core::result::Err(environment_failure()); } if (n > limits.max_string || n > limits.max_bytes) { lengths.destroy(); return core::result::Err(failure(Error::Limit,Stage::Environment,0)); } lengths.set(i*2,n).unwrap(); if (n > maximum) { maximum = n; } i += 1; }
    let key_words: u64 = ((maximum as u64)+3)/4; if (key_words > 536870911) { lengths.destroy(); return core::result::Err(failure(Error::Limit,Stage::Environment,0)); }
    let keys_allocated = alloc::vec::with_capacity<i32>(key_words as i32); if (keys_allocated.is_err()) { lengths.destroy(); return core::result::Err(failure(Error::AllocationFailed,Stage::Environment,0)); } let keys = keys_allocated.unwrap(); keys.try_resize(key_words as i32,0).unwrap(); let key_pointer = core::mem::i32_slice_data_ptr(keys.as_slice());
    let total: u64 = 0; i = 0; while (i < count) { let key_length: i32 = lengths.at(i*2);
        if (std::env::var_key_read(i,key_pointer,key_length as usize) != key_length) { keys.destroy(); lengths.destroy(); return core::result::Err(environment_failure()); }
        let value_length: i32 = std::env::var_len(key_pointer,key_length as usize); if (value_length < 0) { keys.destroy(); lengths.destroy(); return core::result::Err(environment_failure()); }
        let size: u64 = (key_length as u64)+1+(value_length as u64); total += size; if (size > limits.max_string as u64 || total > limits.max_bytes as u64) { keys.destroy(); lengths.destroy(); return core::result::Err(failure(Error::Limit,Stage::Environment,0)); } lengths.set(i*2+1,value_length).unwrap(); i += 1;
    }
    let words: u64 = (total+3)/4; if (words > 536870911) { keys.destroy(); lengths.destroy(); return core::result::Err(failure(Error::Limit,Stage::Environment,0)); }
    let bytes_allocated = alloc::vec::with_capacity<i32>(words as i32); if (bytes_allocated.is_err()) { keys.destroy(); lengths.destroy(); return core::result::Err(failure(Error::AllocationFailed,Stage::Environment,0)); } let bytes = bytes_allocated.unwrap(); bytes.try_resize(words as i32,0).unwrap();
    let values_allocated = alloc::vec::with_capacity<core::slice::View<u8>>(count); if (values_allocated.is_err()) { keys.destroy(); lengths.destroy(); bytes.destroy(); return core::result::Err(failure(Error::AllocationFailed,Stage::Environment,0)); } let values = values_allocated.unwrap(); let base = core::mem::i32_slice_data_ptr(bytes.as_slice()); let raw: [u8] = core::mem::typed_slice_from_raw_parts(base,total as i32); let key_raw: [u8] = core::mem::typed_slice_from_raw_parts(key_pointer,maximum); let offset: i32 = 0; i = 0;
    while (i < count) { let key_length: i32 = lengths.at(i*2); let value_length: i32 = lengths.at(i*2+1); let size: i32 = key_length+1+value_length;
        if (std::env::var_key_len(i) != key_length || std::env::var_key_read(i,key_pointer,key_length as usize) != key_length || std::env::var_len(key_pointer,key_length as usize) != value_length) { return snapshot_failed(keys,lengths,bytes,values,environment_failure()); }
        let j: i32 = 0; while (j < key_length) { if (key_raw[j] == 0 || key_raw[j] == 61) { return snapshot_failed(keys,lengths,bytes,values,environment_failure()); } raw[offset+j] = key_raw[j]; j += 1; } raw[offset+key_length] = 61;
        if (std::env::var_read(key_pointer,key_length as usize,base+((offset+key_length+1) as usize),value_length as usize) != value_length) { return snapshot_failed(keys,lengths,bytes,values,environment_failure()); }
        j = key_length+1; while (j < size) { if (raw[offset+j] == 0) { return snapshot_failed(keys,lengths,bytes,values,environment_failure()); } j += 1; }
        let entry: core::slice::View<u8> = core::slice::view_range(raw,offset,size).unwrap(); values.try_push(entry).unwrap(); offset += size; i += 1;
    }
    keys.destroy(); lengths.destroy(); return core::result::Ok(Environment { bytes: bytes, values: values });
}
