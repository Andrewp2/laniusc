    let base = core::mem::i32_slice_data_ptr(prepared.bytes.as_slice()); let pointers = core::mem::i32_slice_data_ptr(prepared.pointers.as_slice());
    if (prepared.cwd >= 0) { n = std::command_raw::change_dir(base+(prepared.cwd as usize)); if (n < 0) { child_failure(error_fd,3,(0-n) as i32); } }
