        let borrowed: core::option::Option<i32> = match(setting) { Stdio::Borrowed(fd) -> core::option::Some(fd), _ -> core::option::None() };
        if (core::option::is_some(borrowed)) { let fd: i32 = core::option::unwrap(borrowed); let n: i64 = -4; while (n == -4) { n = std::command_raw::word(72,fd as i64,1,0); } if (n < 0) { prepared.destroy(); return core::result::Err(host(Stage::Descriptors,n)); } } i += 1;
    }
