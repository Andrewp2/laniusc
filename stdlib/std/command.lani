fn report_stage(stage: i32) -> Stage { if (stage == 1) { return Stage::CloseRange; } if (stage == 2) { return Stage::Redirect; } if (stage == 3) { return Stage::Directory; } if (stage == 5) { return Stage::Signal; } if (stage == 6) { return Stage::ProcessGroup; } return Stage::Exec; }
// Err is possible only before fork succeeds, after all owned resources close.
// Post-fork unknown outcomes always retain the child in Spawn::Unknown.
pub fn spawn(request: Request) -> core::result::Result<Spawn,Failure> {
