    }
    pub fn take_stdin(&self) -> core::option::Option<std::file::File> { let value = self.input; self.input = core::option::None(); return value; }
    pub fn take_stdout(&self) -> core::option::Option<std::file::File> { let value = self.output; self.output = core::option::None(); return value; }
    pub fn take_stderr(&self) -> core::option::Option<std::file::File> { let value = self.error; self.error = core::option::None(); return value; }
    pub fn close_pipes(&self) -> core::result::Result<i32,Failure> {
        let error: core::option::Option<Failure> = core::option::None(); let i: i32 = 0;
        while (i < 3) { let value: core::option::Option<std::file::File> = core::option::None(); if (i == 0) { value = self.take_stdin(); } if (i == 1) { value = self.take_stdout(); } if (i == 2) { value = self.take_stderr(); }
