fn io_failure(error: core::io::Error) -> Failure { let errno: i32 = match(error) { core::io::Error::Host(n) -> n, core::io::Error::Interrupted -> 4, _ -> 5 }; return failure(Error::Host,Stage::Close,errno); }
pub impl Child {
    pub fn borrow(&self) -> &Child { return self; }
    pub fn id(&self) -> core::option::Option<i32> { if (self.pid <= 0) { return core::option::None(); } return core::option::Some(self.pid); }
    pub fn startup(&self) -> Startup { return self.startup_state; }
    // Requested policy is independent of proven, currently anchored authority.
    pub fn group(&self) -> Group { return self.group_policy; }
    pub fn group_id(&self) -> core::option::Option<i32> {
        if (!self.group_confirmed || self.pid <= 1 || self.cached.is_some()) { return core::option::None(); }
        return core::option::Some(self.pid);
    }
    // Retry uncertain setup with one kernel query. The owned unreaped leader
