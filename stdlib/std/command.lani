            if (made < 0) { close_fds(child_fds); close_fds(parent_fds); prepared.destroy(); return core::result::Err(host(Stage::Descriptors,made as i64)); }
            if (i == 0) { child_fds[i] = pair[0]; parent_fds[i] = pair[1]; } else { child_fds[i] = pair[1]; parent_fds[i] = pair[0]; }
        } else { if (source < 0 && !closed && !(inherited && source == -9)) { close_fds(child_fds); close_fds(parent_fds); prepared.destroy(); return core::result::Err(host(Stage::Descriptors,source as i64)); } if (source >= 0) { child_fds[i] = source; } }
