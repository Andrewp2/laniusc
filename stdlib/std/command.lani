pub enum Error { Bounds, Nul, InvalidInput, MissingPath, Limit, AllocationFailed, Host, StartupUnknown, LostChild, AlreadyReaped, EnvironmentChanged, GroupUnconfirmed }
pub enum Stage { Validate, Allocate, Descriptors, Fork, CloseRange, Redirect, Directory, Exec, StartupRead, StartupProtocol, Wait, Signal, Close, Environment, ProcessGroup }
pub struct Failure { kind: Error, stage: Stage, errno: i32 }
pub struct Limits { max_args: i32, max_env: i32, max_string: i32, max_bytes: i32, max_paths: i32 }
pub enum Search { Exact, EnvironmentPath }
pub enum ChildSigpipe { Default, Inherit }
pub enum Group { Inherit, New }
pub enum Stdio { Inherit, Closed, Null, Pipe, Borrowed(i32) }
pub struct Request { program: core::slice::View<u8>, arguments: core::slice::View<core::slice::View<u8>>, environment: core::slice::View<core::slice::View<u8>>, cwd: core::option::Option<core::slice::View<u8>>, search: Search, sigpipe: ChildSigpipe, group: Group, stdin: Stdio, stdout: Stdio, stderr: Stdio, limits: Limits }
pub enum Startup { Unconfirmed, Unknown }
pub struct ExitStatus { raw: i32, code: core::option::Option<i32>, signal: core::option::Option<i32>, core_dumped: bool }
pub struct Child { pid: i32, input: core::option::Option<std::file::File>, output: core::option::Option<std::file::File>, error: core::option::Option<std::file::File>, startup_state: Startup, cached: core::option::Option<ExitStatus>, group_policy: Group, group_confirmed: bool, observed: core::option::Option<ExitStatus> }
pub struct FailedStart { failure: Failure, status: ExitStatus }
pub struct UnknownStart { child: Child, failure: Failure }
pub enum Spawn { Child(Child), Failed(FailedStart), Unknown(UnknownStart) }
struct Prepared { bytes: alloc::vec::Vec<i32>, pointers: alloc::vec::Vec<i32>, paths: alloc::vec::Vec<i32>, cwd: i32, env_at: i32 }
impl Prepared { fn destroy(&self) { self.bytes.destroy(); self.pointers.destroy(); self.paths.destroy(); } }
pub fn default_limits() -> Limits { return Limits { max_args: 4096, max_env: 4096, max_string: 65536, max_bytes: 1048576, max_paths: 256 }; }
fn failure(kind: Error, stage: Stage, errno: i32) -> Failure { return Failure { kind: kind, stage: stage, errno: errno }; }
fn host(stage: Stage, n: i64) -> Failure { return failure(Error::Host,stage,(0-n) as i32); }
fn valid(start: i32, length: i32) -> bool { return start >= 0 && length >= 0 && start <= 2147483647-length; }
fn at(bytes: core::slice::View<u8>, index: i32) -> u8 { return bytes.values[bytes.start+index]; }
fn checked(bytes: core::slice::View<u8>, limits: Limits) -> core::result::Result<i32,Failure> {
    if (!valid(bytes.start,bytes.length)) { return core::result::Err(failure(Error::Bounds,Stage::Validate,0)); } if (bytes.length > limits.max_string || bytes.length > limits.max_bytes) { return core::result::Err(failure(Error::Limit,Stage::Validate,0)); }
    let i: i32 = 0; while (i < bytes.length) { if (at(bytes,i) == 0) { return core::result::Err(failure(Error::Nul,Stage::Validate,0)); } i += 1; } return core::result::Ok(bytes.length);
}
fn put(raw: [u8], offset: i32, value: core::slice::View<u8>) -> i32 { let i: i32 = 0; while (i < value.length) { raw[offset+i] = at(value,i); i += 1; } raw[offset+i] = 0; return offset+i+1; }
fn prepare(request: Request) -> core::result::Result<Prepared,Failure> {
    let limits: Limits = request.limits; let args = request.arguments; let env = request.environment;
    if (limits.max_args < 0 || limits.max_env < 0 || limits.max_string < 0 || limits.max_bytes < 0 || limits.max_paths < 1 || !valid(args.start,args.length) || !valid(env.start,env.length)) { return core::result::Err(failure(Error::Bounds,Stage::Validate,0)); }
