    if (program.unwrap() == 0) { return core::result::Err(failure(Error::InvalidInput,Stage::Validate,0)); }
    let total: u64 = (program.unwrap() as u64)+1; if (total > limits.max_bytes as u64) { return core::result::Err(failure(Error::Limit,Stage::Validate,0)); } let slash: bool = false; let i: i32 = 0; while (i < request.program.length) { if (at(request.program,i) == 47) { slash = true; } i += 1; }
    i = 0; while (i < args.length) { let value = checked(args.values[args.start+i],limits); if (value.is_err()) { return core::result::Err(value.unwrap_err()); } total += (value.unwrap() as u64)+1; if (total > limits.max_bytes as u64) { return core::result::Err(failure(Error::Limit,Stage::Validate,0)); } i += 1; }
    let path = core::slice::View<u8> { values: request.program.values, start: request.program.start, length: 0 }; let found_path: bool = false;
    i = 0; while (i < env.length) { let value = env.values[env.start+i]; let size = checked(value,limits); if (size.is_err()) { return core::result::Err(size.unwrap_err()); }
        let equal: i32 = 0; while (equal < value.length && at(value,equal) != 61) { equal += 1; } if (equal == 0 || equal == value.length) { return core::result::Err(failure(Error::InvalidInput,Stage::Validate,0)); }
        if (!found_path && equal == 4 && at(value,0) == 80 && at(value,1) == 65 && at(value,2) == 84 && at(value,3) == 72) { path = core::slice::View { values: value.values, start: value.start+5, length: value.length-5 }; found_path = true; }
        total += (size.unwrap() as u64)+1; if (total > limits.max_bytes as u64) { return core::result::Err(failure(Error::Limit,Stage::Validate,0)); } i += 1;
    }
    if (core::option::is_some(request.cwd)) { let value = checked(core::option::unwrap(request.cwd),limits); if (value.is_err()) { return core::result::Err(value.unwrap_err()); } if (value.unwrap() == 0) { return core::result::Err(failure(Error::InvalidInput,Stage::Validate,0)); } total += (value.unwrap() as u64)+1; if (total > limits.max_bytes as u64) { return core::result::Err(failure(Error::Limit,Stage::Validate,0)); } }
    let search: bool = !slash && match(request.search) { Search::EnvironmentPath -> true, _ -> false }; let paths: i32 = 1;
    if (search) { if (!found_path) { return core::result::Err(failure(Error::MissingPath,Stage::Validate,0)); } let start: i32 = 0; i = 0;
        while (i <= path.length) { if (i == path.length || at(path,i) == 58) { if (paths > limits.max_paths) { return core::result::Err(failure(Error::Limit,Stage::Validate,0)); } let size: u64 = (i-start) as u64; if (size != 0) { size += 1; } size += (request.program.length as u64)+1; if (size-1 > limits.max_string as u64) { return core::result::Err(failure(Error::Limit,Stage::Validate,0)); } total += size; if (total > limits.max_bytes as u64) { return core::result::Err(failure(Error::Limit,Stage::Validate,0)); } paths += 1; start = i+1; } i += 1; }
        paths -= 1;
    }
    let pointer_words: u64 = ((args.length as u64)+(env.length as u64)+2)*2; let byte_words: u64 = (total+3)/4;
    if (paths > limits.max_paths || paths > 536870911 || total > limits.max_bytes as u64 || byte_words > 536870911 || pointer_words > 536870911) { return core::result::Err(failure(Error::Limit,Stage::Validate,0)); }
    let bytes_allocated = alloc::vec::with_capacity<i32>(byte_words as i32); if (bytes_allocated.is_err()) { return core::result::Err(failure(Error::AllocationFailed,Stage::Allocate,0)); } let bytes = bytes_allocated.unwrap(); bytes.try_resize(byte_words as i32,0).unwrap();
    let pointers_allocated = alloc::vec::with_capacity<i32>(pointer_words as i32); if (pointers_allocated.is_err()) { bytes.destroy(); return core::result::Err(failure(Error::AllocationFailed,Stage::Allocate,0)); } let pointers = pointers_allocated.unwrap(); pointers.try_resize(pointer_words as i32,0).unwrap();
    let paths_allocated = alloc::vec::with_capacity<i32>(paths); if (paths_allocated.is_err()) { bytes.destroy(); pointers.destroy(); return core::result::Err(failure(Error::AllocationFailed,Stage::Allocate,0)); } let path_offsets = paths_allocated.unwrap();
    let base = core::mem::i32_slice_data_ptr(bytes.as_slice()); let raw: [u8] = core::mem::typed_slice_from_raw_parts(base,total as i32); let table = core::mem::i32_slice_data_ptr(pointers.as_slice()); let offset: i32 = put(raw,0,request.program); let cwd: i32 = -1;
    i = 0; while (i < args.length) { std::command_raw::store_pointer(table+(i as usize)*8,base+(offset as usize)); offset = put(raw,offset,args.values[args.start+i]); i += 1; }
    let env_at: i32 = (args.length+1)*8; i = 0; while (i < env.length) { std::command_raw::store_pointer(table+(env_at as usize)+(i as usize)*8,base+(offset as usize)); offset = put(raw,offset,env.values[env.start+i]); i += 1; }
    if (core::option::is_some(request.cwd)) { cwd = offset; offset = put(raw,offset,core::option::unwrap(request.cwd)); }
    if (search) { let start: i32 = 0; i = 0; while (i <= path.length) { if (i == path.length || at(path,i) == 58) { path_offsets.try_push(offset).unwrap(); let j: i32 = start; while (j < i) { raw[offset] = at(path,j); offset += 1; j += 1; } if (i > start) { raw[offset] = 47; offset += 1; } offset = put(raw,offset,request.program); start = i+1; } i += 1; } }
    else { path_offsets.try_push(0).unwrap(); } assert(offset as u64 == total);
    return core::result::Ok(Prepared { bytes: bytes, pointers: pointers, paths: path_offsets, cwd: cwd, env_at: env_at });
}
fn owned(fd: i32) -> core::option::Option<std::file::File> { if (fd < 0) { return core::option::None(); } return core::option::Some(std::file::from_owned_handle(fd).unwrap()); }
fn make_child(pid: i32, fds: [i32], state: Startup, group: Group) -> Child { return Child { pid: pid, input: owned(fds[0]), output: owned(fds[1]), error: owned(fds[2]), startup_state: state, cached: core::option::None(), group_policy: group, group_confirmed: false, observed: core::option::None() }; }
fn close_fds(fds: [i32]) { let i: i32 = 0; while (i < 3) { std::command_raw::close(fds[i]); fds[i] = -1; i += 1; } }
fn child_failure(fd: i32, stage: i32, errno: i32) {
