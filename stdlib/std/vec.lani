// Associated empty-vector operations execute through normal imports on x86.
// Free new runs with an annotated result, and free len and is_empty infer
// scalar arguments from imported Vec values. No mutation API is offered: the
// former push silently discarded elements. Concrete vectors use the allocator
// service.
module std::vec;
pub struct Vec<T> {
    len: i32,
}
pub fn new<T>() -> Vec<T> {
    return Vec {
        len: 0
    };
}
pub fn len<T>(value: Vec<T>) -> i32 {
    return value.len;
}
pub fn is_empty<T>(value: Vec<T>) -> bool {
    return value.len == 0;
}
impl<T>Vec<T> {
    pub fn new() -> Vec<T> {
        return Vec {
            len: 0
        };
    }
    pub fn len(&self) -> i32 {
        return self.len;
    }
    pub fn is_empty(&self) -> bool {
        return self.len == 0;
    }
}
