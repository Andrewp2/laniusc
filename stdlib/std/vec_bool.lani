// Owned, allocation-backed bool vector for the current native target. Storage
// uses 32-bit cells accessed through the available i32 raw-slice intrinsic;
// false is stored as zero and true as one. This representation uses four
// bytes of storage per element.
// Ownership is linear by convention: keep only the newest returned VecBool,
// do not copy it or use it after destroy. The language cannot enforce moves yet.
// Growth failure returns the original vector unchanged. Compare len after
// try_push, or capacity after try_reserve/try_with_capacity, to detect failure.
module std::vec_bool;
import alloc::allocator;
import core::mem;
import core::slice;

pub struct VecBool {
    storage: ptr,
    length: i32,
    reserved: i32,
}

// i32 indexing and byte-size arithmetic limit capacity to MAX_I32 / 4.
pub const MAX_CAPACITY: i32 = 536870911;

pub fn new() -> VecBool {
    let empty: ptr = 0;
    return VecBool { storage: empty, length: 0, reserved: 0 };
}

pub fn len(value: VecBool) -> i32 {
    return value.length;
}

pub fn capacity(value: VecBool) -> i32 {
    return value.reserved;
}

pub fn is_empty(value: VecBool) -> bool {
    return value.length == 0;
}

// A negative or oversized request leaves the vector unchanged. Allocation
// failure does the same and preserves every existing element.
pub fn try_reserve(value: VecBool, minimum_capacity: i32) -> VecBool {
    if (minimum_capacity < 0 || minimum_capacity > MAX_CAPACITY) {
        return value;
    }
    if (minimum_capacity <= value.reserved) {
        return value;
    }
    let byte_count: i32 = minimum_capacity * 4;
    let new_bytes: usize = byte_count as usize;
    let next: ptr = 0;
    if (value.storage == 0) {
        next = alloc::allocator::alloc(new_bytes, 4);
    } else {
        let old_byte_count: i32 = value.reserved * 4;
        let old_bytes: usize = old_byte_count as usize;
        next = alloc::allocator::realloc(value.storage, old_bytes, new_bytes, 4);
    }
    if (next == 0) {
        return value;
    }
    return VecBool { storage: next, length: value.length, reserved: minimum_capacity };
}

// On invalid capacity or allocation failure, returns an empty zero-capacity
// vector. A nonnegative request succeeded exactly when capacity(result) is
// at least the request.
pub fn try_with_capacity(initial_capacity: i32) -> VecBool {
    return try_reserve(new(), initial_capacity);
}

// Create an independent allocation containing the initialized values.
// The source remains live; destroy it and the successful clone separately.
// An empty source clones without allocation. An invalid raw cell or allocation
// failure returns an empty zero-capacity vector without changing the source. For a
// nonempty source, len(result) == len(value) indicates success.
pub fn try_clone(value: VecBool) -> VecBool {
    let length: i32 = value.length;
    if (length == 0) {
        return new();
    }
    let source: [i32] = core::mem::i32_slice_from_raw_parts(value.storage, length);
    let index: i32 = 0;
    while (index < length) {
        let raw: i32 = source[index];
        if (raw != 0 && raw != 1) {
            return new();
        }
        index += 1;
    }
    let copy: VecBool = try_with_capacity(length);
    if (copy.reserved < length) {
        return new();
    }
    index = 0;
    while (index < length) {
        let raw: i32 = source[index];
        let item: bool = raw != 0;
        copy = try_push(copy, item);
        index += 1;
    }
    return copy;
}

// On failure, returns the original value unchanged. A successful push always
// increments len by one, so callers can check len without a separate status.
pub fn try_push(value: VecBool, item: bool) -> VecBool {
    let grown: VecBool = value;
    if (grown.length == grown.reserved) {
        let target: i32 = 4;
        if (grown.reserved > 0) {
            if (grown.reserved > MAX_CAPACITY / 2) {
                target = MAX_CAPACITY;
            } else {
                target = grown.reserved * 2;
            }
        }
        grown = try_reserve(grown, target);
        if (grown.length == grown.reserved) {
            return value;
        }
    }
    let elements: [i32] = core::mem::i32_slice_from_raw_parts(grown.storage, grown.reserved);
    let raw_item: i32 = 0;
    if (item) { raw_item = 1; }
    elements[grown.length] = raw_item;
    return VecBool { storage: grown.storage, length: grown.length + 1, reserved: grown.reserved };
}

// Append count caller-backed values. Reserve all needed storage before writing
// any item, so negative counts, capacity overflow, and allocation failure leave
// the vector unchanged. A successful call increases len by count. The caller
// must supply at least count readable elements; overclaiming can trap. Input
// storage must not alias this vector because growth may move the allocation.
pub fn try_extend_from_slice(value: VecBool, items: [bool], count: i32) -> VecBool {
    if (count < 0 || count > MAX_CAPACITY - value.length) {
        return value;
    }
    if (count == 0) {
        return value;
    }
    let needed: i32 = value.length + count;
    let grown: VecBool = value;
    if (grown.reserved < needed) {
        let target: i32 = 4;
        if (grown.reserved > 0) {
            if (grown.reserved > MAX_CAPACITY / 2) {
                target = MAX_CAPACITY;
            } else {
                target = grown.reserved * 2;
            }
        }
        if (target < needed) {
            target = needed;
        }
        grown = try_reserve(grown, target);
        if (grown.reserved < needed) {
            return value;
        }
    }
    let index: i32 = 0;
    while (index < count) {
        grown = try_push(grown, items[index]);
        index += 1;
    }
    return grown;
}

// Insert at [0, len]. Invalid indices or allocation failure leave the value
// unchanged. A successful insert increases len by one. This operation may
// move the allocation, so only the returned vector remains owned.
pub fn try_insert(value: VecBool, index: i32, item: bool) -> VecBool {
    let old_len: i32 = value.length;
    if (index < 0 || index > old_len) {
        return value;
    }
    let grown: VecBool = try_push(value, item);
    if (grown.length == old_len) {
        return grown;
    }
    let cells: [i32] = core::mem::i32_slice_from_raw_parts(grown.storage, grown.reserved);
    let inserted: i32 = cells[old_len];
    let cursor: i32 = old_len;
    while (cursor > index) {
        cells[cursor] = cells[cursor - 1];
        cursor -= 1;
    }
    cells[index] = inserted;
    return grown;
}

// Remove one element at [0, len). Invalid indices leave the vector unchanged.
// A successful removal decreases len by one and keeps the allocation for reuse.
// Read the removed element with get_or before calling when it is needed.
pub fn try_remove(value: VecBool, index: i32) -> VecBool {
    if (index < 0 || index >= value.length) {
        return value;
    }
    let cells: [i32] = core::mem::i32_slice_from_raw_parts(value.storage, value.reserved);
    let cursor: i32 = index;
    while (cursor + 1 < value.length) {
        cells[cursor] = cells[cursor + 1];
        cursor += 1;
    }
    return try_pop(value);
}

// Invalid indices return fallback without accessing storage.
pub fn get_or(value: VecBool, index: i32, fallback: bool) -> bool {
    if (index < 0 || index >= value.length) {
        return fallback;
    }
    let elements: [i32] = core::mem::i32_slice_from_raw_parts(value.storage, value.reserved);
    let raw_item: i32 = elements[index];
    return raw_item != 0;
}

// Mutates the owned allocation only for an in-bounds index.
pub fn try_set(value: VecBool, index: i32, item: bool) -> bool {
    if (index < 0 || index >= value.length) {
        return false;
    }
    let elements: [i32] = core::mem::i32_slice_from_raw_parts(value.storage, value.reserved);
    let raw_item: i32 = 0;
    if (item) { raw_item = 1; }
    elements[index] = raw_item;
    return true;
}

// Sort initialized values as false before true. Return len and retain the
// allocation and capacity. Valid backing cells contain only zero or one.
pub fn sort_in_place(value: VecBool) -> i32 {
    if (value.length <= 1) {
        return value.length;
    }
    let cells: [i32] = core::mem::i32_slice_from_raw_parts(value.storage, value.length);
    return core::slice::sort_i32(cells, value.length);
}

// Reverse initialized values and return the number of swaps performed.
pub fn reverse_in_place(value: VecBool) -> i32 {
    if (value.length <= 1) {
        return 0;
    }
    let cells: [i32] = core::mem::i32_slice_from_raw_parts(value.storage, value.length);
    // These cells belong to this allocation-backed vector. Keep reversal
    // concrete here until local generic calls within a source pack specialize.
    let left: i32 = 0;
    let right: i32 = value.length - 1;
    let swaps: i32 = 0;
    while (left < right) {
        let previous: i32 = cells[left];
        cells[left] = cells[right];
        cells[right] = previous;
        left += 1;
        right -= 1;
        swaps += 1;
    }
    return swaps;
}

// Search requires false values before true values. Bounds range from zero
// through len; empty vectors return zero without accessing storage.
pub fn lower_bound(value: VecBool, needle: bool) -> i32 {
    if (value.length == 0) {
        return 0;
    }
    let cells: [i32] = core::mem::i32_slice_from_raw_parts(value.storage, value.length);
    let needle_word: i32 = 0;
    if (needle) { needle_word = 1; }
    return core::slice::lower_bound_i32(cells, value.length, needle_word);
}

pub fn upper_bound(value: VecBool, needle: bool) -> i32 {
    if (value.length == 0) {
        return 0;
    }
    let cells: [i32] = core::mem::i32_slice_from_raw_parts(value.storage, value.length);
    let needle_word: i32 = 0;
    if (needle) { needle_word = 1; }
    return core::slice::upper_bound_i32(cells, value.length, needle_word);
}

// Return first or last matching index, or fallback when absent.
pub fn binary_search_first_or(value: VecBool, needle: bool, fallback: i32) -> i32 {
    let index: i32 = lower_bound(value, needle);
    if (index < value.length && get_or(value, index, false) == needle) {
        return index;
    }
    return fallback;
}

pub fn binary_search_last_or(value: VecBool, needle: bool, fallback: i32) -> i32 {
    let after: i32 = upper_bound(value, needle);
    if (after > 0 && get_or(value, after - 1, false) == needle) {
        return after - 1;
    }
    return fallback;
}

// On an empty vector, returns it unchanged. Read the last element with get_or
// before popping if its value is needed.
pub fn try_pop(value: VecBool) -> VecBool {
    if (value.length == 0) {
        return value;
    }
    return VecBool { storage: value.storage, length: value.length - 1, reserved: value.reserved };
}

// Keep the first new_len elements and retain the allocation for reuse.
// A negative length or one greater than the current length leaves the vector
// unchanged. Truncated elements are no longer in the vector.
pub fn truncate(value: VecBool, new_len: i32) -> VecBool {
    if (new_len < 0 || new_len > value.length) {
        return value;
    }
    return VecBool { storage: value.storage, length: new_len, reserved: value.reserved };
}

// Set the length to new_len. Growing initializes every new element to fill;
// shrinking keeps the prefix and allocation. A negative or oversized length,
// or allocation failure during growth, leaves the original vector unchanged.
// A successful growth has len(result) == new_len.
pub fn try_resize(value: VecBool, new_len: i32, fill: bool) -> VecBool {
    if (new_len < 0 || new_len > MAX_CAPACITY) {
        return value;
    }
    if (new_len <= value.length) {
        return truncate(value, new_len);
    }
    let grown: VecBool = try_reserve(value, new_len);
    if (grown.reserved < new_len) {
        return value;
    }
    while (grown.length < new_len) {
        grown = try_push(grown, fill);
    }
    return grown;
}

// Keeps the allocation for reuse; old elements are no longer in the vector.
pub fn clear(value: VecBool) -> VecBool {
    return VecBool { storage: value.storage, length: 0, reserved: value.reserved };
}

// Reduce capacity to len. An empty vector releases its allocation. Failed
// reallocation returns the original vector with its elements and capacity
// unchanged; compare capacity(result) with len(result) to detect failure.
pub fn try_shrink_to_fit(value: VecBool) -> VecBool {
    if (value.length == value.reserved) {
        return value;
    }
    if (value.length == 0) {
        let byte_count: i32 = value.reserved * 4;
        let bytes: usize = byte_count as usize;
        alloc::allocator::dealloc(value.storage, bytes, 4);
        return new();
    }
    let old_byte_count: i32 = value.reserved * 4;
    let new_byte_count: i32 = value.length * 4;
    let old_bytes: usize = old_byte_count as usize;
    let new_bytes: usize = new_byte_count as usize;
    let next: ptr = alloc::allocator::realloc(value.storage, old_bytes, new_bytes, 4);
    if (next == 0) {
        return value;
    }
    return VecBool { storage: next, length: value.length, reserved: value.length };
}

// Releases the one owned allocation. The caller must never use any copy of
// the vector after this call.
pub fn destroy(value: VecBool) {
    if (value.storage != 0) {
        let byte_count: i32 = value.reserved * 4;
        let bytes: usize = byte_count as usize;
        alloc::allocator::dealloc(value.storage, bytes, 4);
    }
}
