// Work-stealing task queues for std::worker pools. Each worker owns one
// bounded deque in a shared Region: the owner pushes and pops at the bottom
// (LIFO, cache-warm), idle workers steal from other deques' tops (FIFO,
// oldest and usually largest tasks). Each deque has its own futex mutex, so
// contention is per victim, not global. Tasks are plain values copied into
// Region storage (see std::channel for the payload rule).
// Linux x86_64; link with --native-link --native-library atomic.
// See docs/stdlib-concurrency.md#work-stealing-queues.
module std::steal;
import core::mem;
import core::option;
import core::result;
import std::atomic;
import std::sync;

pub const MAX_WORKERS: i32 = 1024;
pub const MAX_CAPACITY: i32 = 1048576;

pub enum Error { InvalidSize, NotWorker, NotPending, Sync(std::sync::Error) }
// A rejected push returns the task, so the caller can run it inline.
pub enum PushError<T> { Full(T), NotWorker(T), Sync(std::sync::Error) }
pub enum Next<T> { Task(T), Finished }
pub struct Stats { executed: u64, stolen: u64 }

// Per worker: lock word, top, bottom, executed, stolen (8 bytes each, one
// 64-byte line per worker). Shared: pending, epoch, sleepers.
pub struct Queues<T> { lines: ptr, shared: ptr, slots: ptr, workers: i32, capacity: i32 }

pub fn queues<T>(region: &std::sync::Region, workers: i32, capacity: i32) -> core::result::Result<Queues<T>, Error> {
    if (workers <= 0 || workers > MAX_WORKERS || capacity <= 0 || capacity > MAX_CAPACITY) { return core::result::Err(Error::InvalidSize); }
    let lines: core::result::Result<ptr, std::sync::Error> = region.allocate((workers as usize) * 64);
    if (lines.is_err()) { return core::result::Err(Error::Sync(lines.unwrap_err())); }
    let shared: core::result::Result<ptr, std::sync::Error> = region.allocate(24);
    if (shared.is_err()) { return core::result::Err(Error::Sync(shared.unwrap_err())); }
    let bytes: usize = (workers as usize) * (capacity as usize) * core::mem::size_of<T>();
    if (bytes == 0) { bytes = 8; }
    let slots: core::result::Result<ptr, std::sync::Error> = region.allocate(bytes);
    if (slots.is_err()) { return core::result::Err(Error::Sync(slots.unwrap_err())); }
    return core::result::Ok(Queues { lines: lines.unwrap(), shared: shared.unwrap(), slots: slots.unwrap(), workers: workers, capacity: capacity });
}

fn word(at: ptr) -> std::atomic::Atomic64 { return std::atomic::at64(at); }
fn get(at: ptr) -> u64 { return word(at).load(std::atomic::Load::Relaxed); }
fn set(at: ptr, value: u64) { word(at).store(value, std::atomic::Store::Relaxed); }

pub impl<T> Queues<T> {
    pub fn borrow(&self) -> &Queues<T> { return self; }
    pub fn workers(&self) -> i32 { return self.workers; }
    pub fn capacity(&self) -> i32 { return self.capacity; }
    fn line(&self, worker: i32) -> ptr { return self.lines + (worker as usize) * 64; }
    fn lock(&self, worker: i32) -> std::sync::Mutex { return std::sync::mutex_at(self.line(worker)); }
    fn pending(&self) -> std::atomic::Atomic64 { return word(self.shared); }
    fn epoch(&self) -> std::atomic::Atomic32 { return std::atomic::at32(self.shared + 8); }
    fn sleepers(&self) -> std::atomic::Atomic64 { return word(self.shared + 16); }
    // One view length for every access, so all agree on element addresses.
    fn ring(&self) -> [T] { return core::mem::typed_slice_from_storage<T>(self.slots, self.workers * self.capacity); }
    fn slot(&self, worker: i32, position: u64) -> i32 { return worker * self.capacity + ((position % (self.capacity as u64)) as i32); }
    // Tasks pushed and not yet marked done. Zero means the pool is finished.
    pub fn pending_count(&self) -> u64 { return self.pending().load(std::atomic::Load::Acquire); }
    pub fn stats(&self, worker: i32) -> Stats {
        if (worker < 0 || worker >= self.workers) { return Stats { executed: 0, stolen: 0 }; }
        return Stats { executed: word(self.line(worker) + 24).load(std::atomic::Load::Acquire), stolen: word(self.line(worker) + 32).load(std::atomic::Load::Acquire) };
    }

    // Push onto worker's own deque (or, before workers start, any deque).
    // The task counts as pending until some worker calls done for it.
    pub fn push(&self, worker: i32, task: T) -> core::result::Result<i32, PushError<T>> {
        if (worker < 0 || worker >= self.workers) { return core::result::Err(PushError::NotWorker(task)); }
        let lock: std::sync::Mutex = self.lock(worker);
        let locked: core::result::Result<i32, std::sync::Error> = lock.lock();
        if (locked.is_err()) { return core::result::Err(PushError::Sync(locked.unwrap_err())); }
        let top: u64 = get(self.line(worker) + 8); let bottom: u64 = get(self.line(worker) + 16);
        if (bottom - top == self.capacity as u64) { lock.unlock(); return core::result::Err(PushError::Full(task)); }
        self.pending().fetch_add(1, std::atomic::Ordering::SeqCst);
        let ring: [T] = self.ring(); ring[self.slot(worker, bottom)] = task;
        set(self.line(worker) + 16, bottom + 1);
        let unlocked: core::result::Result<i32, std::sync::Error> = lock.unlock();
        if (unlocked.is_err()) { return core::result::Err(PushError::Sync(unlocked.unwrap_err())); }
        let woke: core::result::Result<i32, std::sync::Error> = self.signal(false);
        if (woke.is_err()) { return core::result::Err(PushError::Sync(woke.unwrap_err())); }
        return core::result::Ok(0);
    }
    fn signal(&self, all: bool) -> core::result::Result<i32, std::sync::Error> {
        self.epoch().fetch_add(1, std::atomic::Ordering::SeqCst);
        if (self.sleepers().load(std::atomic::Load::SeqCst) == 0) { return core::result::Ok(0); }
        let count: i32 = 1; if (all) { count = 2147483647; }
        return std::sync::futex_wake(self.shared + 8, count);
    }
    // None when victim is empty. own: bottom (LIFO); otherwise top (FIFO).
    fn take(&self, victim: i32, own: bool) -> core::result::Result<core::option::Option<T>, std::sync::Error> {
        let lock: std::sync::Mutex = self.lock(victim);
        let locked: core::result::Result<i32, std::sync::Error> = lock.lock();
        if (locked.is_err()) { return core::result::Err(locked.unwrap_err()); }
        let top: u64 = get(self.line(victim) + 8); let bottom: u64 = get(self.line(victim) + 16);
        if (top == bottom) {
            let unlocked: core::result::Result<i32, std::sync::Error> = lock.unlock();
            if (unlocked.is_err()) { return core::result::Err(unlocked.unwrap_err()); }
            return core::result::Ok(core::option::None());
        }
        let ring: [T] = self.ring();
        let task: T = ring[self.slot(victim, top)];
        if (own) { task = ring[self.slot(victim, bottom - 1)]; set(self.line(victim) + 16, bottom - 1); }
        else { set(self.line(victim) + 8, top + 1); }
        let unlocked: core::result::Result<i32, std::sync::Error> = lock.unlock();
        if (unlocked.is_err()) { return core::result::Err(unlocked.unwrap_err()); }
        return core::result::Ok(core::option::Some(task));
    }
    // The next task for worker: its own newest, else the oldest task of the
    // next nonempty victim after it. Sleeps while other workers still run
    // tasks that may push more. Finished once nothing is pending.
    pub fn next(&self, worker: i32) -> core::result::Result<Next<T>, Error> {
        if (worker < 0 || worker >= self.workers) { return core::result::Err(Error::NotWorker); }
        while (true) {
            // Read the epoch before scanning: a push after this read changes
            // it, so the sleep below cannot miss that push.
            let seen: u32 = self.epoch().load(std::atomic::Load::SeqCst);
            let k: i32 = 0;
            while (k < self.workers) {
                let victim: i32 = (worker + k) % self.workers;
                let got: core::result::Result<core::option::Option<T>, std::sync::Error> = self.take(victim, k == 0);
                if (got.is_err()) { return core::result::Err(Error::Sync(got.unwrap_err())); }
                let found: core::option::Option<T> = got.unwrap();
                if (found.is_some()) {
                    if (k != 0) { word(self.line(worker) + 32).fetch_add(1, std::atomic::Ordering::Relaxed); }
                    return core::result::Ok(Next::Task(found.unwrap()));
                }
                k += 1;
            }
            if (self.pending().load(std::atomic::Load::SeqCst) == 0) { return core::result::Ok(Next::Finished); }
            self.sleepers().fetch_add(1, std::atomic::Ordering::SeqCst);
            let slept: core::result::Result<std::sync::Wait, std::sync::Error> = std::sync::futex_wait(self.shared + 8, seen);
            self.sleepers().fetch_sub(1, std::atomic::Ordering::SeqCst);
            if (slept.is_err()) { return core::result::Err(Error::Sync(slept.unwrap_err())); }
        }
        return core::result::Ok(Next::Finished);
    }
    // Mark one task taken by worker complete; Err(NotPending) if none was. The last completion wakes every
    // sleeper so they observe Finished.
    pub fn done(&self, worker: i32) -> core::result::Result<u64, Error> {
        if (worker < 0 || worker >= self.workers) { return core::result::Err(Error::NotWorker); }
        word(self.line(worker) + 24).fetch_add(1, std::atomic::Ordering::Relaxed);
        let before: u64 = self.pending().fetch_sub(1, std::atomic::Ordering::SeqCst);
        if (before == 0) { self.pending().fetch_add(1, std::atomic::Ordering::SeqCst); return core::result::Err(Error::NotPending); }
        if (before == 1) {
            let woke: core::result::Result<i32, std::sync::Error> = self.signal(true);
            if (woke.is_err()) { return core::result::Err(Error::Sync(woke.unwrap_err())); }
        }
        return core::result::Ok(before - 1);
    }
}
