// Owned ring-buffer deque of any element type. Both ends push and pop in
// O(1) except when growth copies the elements into a larger allocation.
// Values are copied: every operation that changes a deque's length returns
// the new deque. Ownership is linear by convention: keep only the newest
// returned Deque and destroy each independent deque exactly once.
// A try_ operation that fails (allocation failure, an index out of range or
// an empty deque) returns the deque unchanged; compare len or capacity.
// Element positions inside the storage depend on its capacity
// (core::mem::typed_slice_from_storage), so growth copies each element into
// a fresh allocation in logical order, with the front at slot zero.
module std::deque;
import alloc::allocator;
import core::cmp;
import core::mem;

pub struct Deque<T> {
    storage: ptr,
    length: i32,
    reserved: i32,
    head: i32,
}

// i32 ordinals limit the element count; byte sizes must also fit an i32.
pub const MAX_CAPACITY: i32 = 2147483647;
const MAX_BYTES: usize = 2147483647;
const ALIGN: usize = 8;

pub fn new<T>() -> Deque<T> {
    let empty: ptr = 0;
    return Deque { storage: empty, length: 0, reserved: 0, head: 0 };
}

pub fn len<T>(value: Deque<T>) -> i32 {
    return value.length;
}

pub fn capacity<T>(value: Deque<T>) -> i32 {
    return value.reserved;
}

pub fn is_empty<T>(value: Deque<T>) -> bool {
    return value.length == 0;
}

// The largest capacity whose storage fits MAX_BYTES.
fn capacity_limit<T>() -> i32 {
    let size: usize = core::mem::size_of<T>();
    if (size == 0) {
        return MAX_CAPACITY;
    }
    return (MAX_BYTES / size) as i32;
}

// Every slot of the storage, initialized or not.
fn slots<T>(value: Deque<T>) -> [T] {
    return core::mem::typed_slice_from_storage(value.storage, value.reserved);
}

// The slot of a logical ordinal, wrapping past the end of the storage
// without forming head + ordinal, which can overflow i32.
fn physical_index<T>(value: Deque<T>, ordinal: i32) -> i32 {
    let before_end: i32 = value.reserved - value.head;
    if (ordinal >= before_end) {
        return ordinal - before_end;
    }
    return value.head + ordinal;
}

// Copy the elements in logical order into fresh storage of `reserved` slots,
// front at slot zero, and free the old storage. Allocation failure returns
// the deque unchanged.
fn relocate<T>(value: Deque<T>, reserved: i32) -> Deque<T> {
    let size: usize = core::mem::size_of<T>();
    let next: ptr = alloc::allocator::alloc(size * (reserved as usize), ALIGN);
    if (next == 0) {
        return value;
    }
    if (value.reserved > 0) {
        let from: [T] = slots(value);
        let to: [T] = core::mem::typed_slice_from_storage(next, reserved);
        let index: i32 = 0;
        while (index < value.length) {
            to[index] = from[physical_index(value, index)];
            index += 1;
        }
        alloc::allocator::dealloc(value.storage, size * (value.reserved as usize), ALIGN);
    }
    return Deque { storage: next, length: value.length, reserved: reserved, head: 0 };
}

// Grow storage to hold at least minimum_capacity elements. A negative or
// oversized request, or allocation failure, returns the deque unchanged.
pub fn try_reserve<T>(value: Deque<T>, minimum_capacity: i32) -> Deque<T> {
    if (minimum_capacity <= value.reserved || minimum_capacity > capacity_limit<T>()) {
        return value;
    }
    if (core::mem::size_of<T>() == 0) {
        return Deque { storage: value.storage, length: value.length, reserved: MAX_CAPACITY,
            head: 0 };
    }
    return relocate(value, minimum_capacity);
}

// An empty deque; capacity(result) is below the request when allocation
// failed or the request was invalid.
pub fn try_with_capacity<T>(initial_capacity: i32) -> Deque<T> {
    let empty: Deque<T> = new();
    return try_reserve(empty, initial_capacity);
}

// An independent copy in logical order with capacity equal to len. An empty
// source clones without allocating; otherwise len(result) < len(value) means
// allocation failed.
pub fn try_clone<T>(value: Deque<T>) -> Deque<T> {
    let copy: Deque<T> = try_with_capacity(value.length);
    if (copy.reserved < value.length) {
        let empty: Deque<T> = new();
        return empty;
    }
    let from: [T] = slots(value);
    let to: [T] = slots(copy);
    let index: i32 = 0;
    while (index < value.length) {
        to[index] = from[physical_index(value, index)];
        index += 1;
    }
    return Deque { storage: copy.storage, length: value.length, reserved: copy.reserved,
        head: 0 };
}

// Make room for one more element: double, starting at 4. Returns the deque
// unchanged when it is full and cannot grow.
fn grow_for_one<T>(value: Deque<T>) -> Deque<T> {
    if (value.length < value.reserved) {
        return value;
    }
    let limit: i32 = capacity_limit<T>();
    let target: i32 = 4;
    if (value.reserved > 0) {
        if (value.reserved > limit / 2) {
            target = limit;
        } else {
            target = value.reserved * 2;
        }
    }
    return try_reserve(value, target);
}

// Push success increments len; the capacity limit or allocation failure
// returns the deque unchanged. Growth preserves logical order.
pub fn try_push_back<T>(value: Deque<T>, item: T) -> Deque<T> {
    let grown: Deque<T> = grow_for_one(value);
    if (grown.length == grown.reserved) {
        return value;
    }
    let items: [T] = slots(grown);
    items[physical_index(grown, grown.length)] = item;
    return Deque { storage: grown.storage, length: grown.length + 1,
        reserved: grown.reserved, head: grown.head };
}

pub fn try_push_front<T>(value: Deque<T>, item: T) -> Deque<T> {
    let grown: Deque<T> = grow_for_one(value);
    if (grown.length == grown.reserved) {
        return value;
    }
    let next_head: i32 = grown.head - 1;
    if (grown.head == 0) {
        next_head = grown.reserved - 1;
    }
    let items: [T] = slots(grown);
    items[next_head] = item;
    return Deque { storage: grown.storage, length: grown.length + 1,
        reserved: grown.reserved, head: next_head };
}

// The element at a logical ordinal (0 is the front), or the fallback for an
// ordinal outside the deque. A stored value may equal the fallback; use len
// to tell them apart.
pub fn at_or<T>(value: Deque<T>, ordinal: i32, fallback: T) -> T {
    if (ordinal < 0 || ordinal >= value.length) {
        return fallback;
    }
    let items: [T] = slots(value);
    return items[physical_index(value, ordinal)];
}

pub fn front_or<T>(value: Deque<T>, fallback: T) -> T {
    return at_or(value, 0, fallback);
}

pub fn back_or<T>(value: Deque<T>, fallback: T) -> T {
    return at_or(value, value.length - 1, fallback);
}

pub fn contains<T>(value: Deque<T>, item: T) -> bool where T: core::cmp::Eq<T> {
    let items: [T] = slots(value);
    let index: i32 = 0;
    while (index < value.length) {
        if (T::eq(items[physical_index(value, index)], item)) {
            return true;
        }
        index += 1;
    }
    return false;
}

// Overwrite one element in place. An ordinal outside the deque returns false
// without writing.
pub fn try_set<T>(value: Deque<T>, ordinal: i32, item: T) -> bool {
    if (ordinal < 0 || ordinal >= value.length) {
        return false;
    }
    let items: [T] = slots(value);
    items[physical_index(value, ordinal)] = item;
    return true;
}

pub fn try_swap<T>(value: Deque<T>, left: i32, right: i32) -> bool {
    if (left < 0 || right < 0 || left >= value.length || right >= value.length) {
        return false;
    }
    let items: [T] = slots(value);
    let left_slot: i32 = physical_index(value, left);
    let right_slot: i32 = physical_index(value, right);
    let held: T = items[left_slot];
    items[left_slot] = items[right_slot];
    items[right_slot] = held;
    return true;
}

// Popping an empty deque returns it unchanged. Read front_or or back_or first
// if the removed element is needed. The allocation stays for reuse.
pub fn try_pop_front<T>(value: Deque<T>) -> Deque<T> {
    if (value.length == 0) {
        return value;
    }
    let next_head: i32 = value.head + 1;
    if (next_head == value.reserved) {
        next_head = 0;
    }
    return Deque { storage: value.storage, length: value.length - 1,
        reserved: value.reserved, head: next_head };
}

pub fn try_pop_back<T>(value: Deque<T>) -> Deque<T> {
    if (value.length == 0) {
        return value;
    }
    return Deque { storage: value.storage, length: value.length - 1,
        reserved: value.reserved, head: value.head };
}

pub fn clear<T>(value: Deque<T>) -> Deque<T> {
    return Deque { storage: value.storage, length: 0, reserved: value.reserved, head: 0 };
}

// Reduce capacity to len, preserving logical order; an empty deque releases
// its allocation. Allocation failure returns the deque unchanged.
pub fn try_shrink_to_fit<T>(value: Deque<T>) -> Deque<T> {
    if (value.length == value.reserved || core::mem::size_of<T>() == 0) {
        return value;
    }
    if (value.length == 0) {
        destroy(value);
        let empty: Deque<T> = new();
        return empty;
    }
    return relocate(value, value.length);
}

// Release the storage. The deque must not be used afterwards.
pub fn destroy<T>(value: Deque<T>) {
    let size: usize = core::mem::size_of<T>();
    if (value.reserved > 0 && size > 0) {
        alloc::allocator::dealloc(value.storage, size * (value.reserved as usize), ALIGN);
    }
}
