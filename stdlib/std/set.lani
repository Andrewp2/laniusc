// Owned insertion-ordered set of any T with core::cmp::Eq, stored in a
// std::vec::Vec<T> with linear lookup. Values are copied: every operation
// that changes a set returns the new set. Ownership is linear by convention:
// keep only the newest returned Set and destroy each independent set once.
// A try_ operation that fails (a duplicate, a missing item or allocation
// failure) returns the set unchanged; compare len or capacity to detect it.
// Removal keeps the order of the remaining items.
module std::set;
import core::cmp;
import std::vec;

pub struct Set<T> {
    items: std::vec::Vec<T>,
}

pub const MAX_CAPACITY: i32 = 2147483647;

pub fn new<T>() -> Set<T> {
    let items: std::vec::Vec<T> = std::vec::new();
    return Set { items: items };
}

pub fn len<T>(value: Set<T>) -> i32 {
    return std::vec::len(value.items);
}

pub fn capacity<T>(value: Set<T>) -> i32 {
    return std::vec::capacity(value.items);
}

pub fn is_empty<T>(value: Set<T>) -> bool {
    return std::vec::is_empty(value.items);
}

pub fn contains<T>(value: Set<T>, item: T) -> bool where T: core::cmp::Eq<T> {
    return std::vec::contains(value.items, item);
}

// Items keep insertion order. An ordinal outside the set returns fallback;
// use len to tell an absent ordinal from a stored item equal to fallback.
pub fn at_or<T>(value: Set<T>, ordinal: i32, fallback: T) -> T {
    return std::vec::get_or(value.items, ordinal, fallback);
}

// A negative or oversized request, or allocation failure, leaves the set
// unchanged. Compare capacity(result) with the request to detect failure.
pub fn try_reserve<T>(value: Set<T>, minimum_capacity: i32) -> Set<T> {
    return Set { items: std::vec::try_reserve(value.items, minimum_capacity) };
}

// Insert a new item at the end. A duplicate, the capacity limit or allocation
// failure leaves len unchanged.
pub fn try_insert<T>(value: Set<T>, item: T) -> Set<T> where T: core::cmp::Eq<T> {
    if (contains(value, item)) {
        return value;
    }
    return Set { items: std::vec::try_push(value.items, item) };
}

// Remove an item, keeping the order of the rest. A missing item leaves the
// set unchanged; success decrements len.
pub fn try_remove<T>(value: Set<T>, item: T) -> Set<T> where T: core::cmp::Eq<T> {
    let index: i32 = std::vec::index_of(value.items, item);
    if (index < 0) {
        return value;
    }
    return Set { items: std::vec::try_remove(value.items, index) };
}

pub fn clear<T>(value: Set<T>) -> Set<T> {
    return Set { items: std::vec::clear(value.items) };
}

// Release unused storage; an empty set releases its allocation. Allocation
// failure returns the set unchanged.
pub fn try_shrink_to_fit<T>(value: Set<T>) -> Set<T> {
    return Set { items: std::vec::try_shrink_to_fit(value.items) };
}

// An independent copy. An empty source clones without allocating; otherwise
// len(result) < len(value) means allocation failed.
pub fn try_clone<T>(value: Set<T>) -> Set<T> {
    return Set { items: std::vec::try_clone(value.items) };
}

pub fn is_subset<T>(left: Set<T>, right: Set<T>) -> bool where T: core::cmp::Eq<T> {
    let index: i32 = 0;
    while (index < len(left)) {
        if (!contains(right, std::vec::at(left.items, index))) {
            return false;
        }
        index += 1;
    }
    return true;
}

pub fn is_disjoint<T>(left: Set<T>, right: Set<T>) -> bool where T: core::cmp::Eq<T> {
    let index: i32 = 0;
    while (index < len(left)) {
        if (contains(right, std::vec::at(left.items, index))) {
            return false;
        }
        index += 1;
    }
    return true;
}

// Count the items of `from` whose membership in `other` equals `present`.
fn count_where<T>(from: Set<T>, other: Set<T>, present: bool) -> i32
    where T: core::cmp::Eq<T> {
    let count: i32 = 0;
    let index: i32 = 0;
    while (index < len(from)) {
        if (contains(other, std::vec::at(from.items, index)) == present) {
            count += 1;
        }
        index += 1;
    }
    return count;
}

// Append the items of `from` whose membership in `other` equals `present`.
// The caller reserved room for them, so no push can fail.
fn append_where<T>(output: std::vec::Vec<T>, from: Set<T>, other: Set<T>, present: bool)
    -> std::vec::Vec<T> where T: core::cmp::Eq<T> {
    let items: std::vec::Vec<T> = output;
    let index: i32 = 0;
    while (index < len(from)) {
        let item: T = std::vec::at(from.items, index);
        if (contains(other, item) == present) {
            items = std::vec::try_push(items, item);
        }
        index += 1;
    }
    return items;
}

// An empty vector with room for count items; its capacity is below count
// when allocation failed.
fn reserved_for<T>(count: i32) -> std::vec::Vec<T> {
    return std::vec::try_with_capacity(count);
}

// Each set algebra operation returns a new independent owner, in the order
// of left and then right. It reserves the whole result before writing, so
// allocation failure returns an empty set instead of a partial one; when a
// nonempty result is expected, compare len(result) with zero. The sources
// stay live and unchanged.
pub fn try_union<T>(left: Set<T>, right: Set<T>) -> Set<T> where T: core::cmp::Eq<T> {
    let extra: i32 = count_where(right, left, false);
    if (extra > MAX_CAPACITY - len(left)) {
        return new();
    }
    let count: i32 = len(left) + extra;
    let output: std::vec::Vec<T> = reserved_for(count);
    if (std::vec::capacity(output) < count) {
        return new();
    }
    output = std::vec::try_extend_from_slice(output, std::vec::as_slice(left.items), len(left));
    return Set { items: append_where(output, right, left, false) };
}

pub fn try_intersection<T>(left: Set<T>, right: Set<T>) -> Set<T> where T: core::cmp::Eq<T> {
    let count: i32 = count_where(left, right, true);
    let output: std::vec::Vec<T> = reserved_for(count);
    if (std::vec::capacity(output) < count) {
        return new();
    }
    return Set { items: append_where(output, left, right, true) };
}

pub fn try_difference<T>(left: Set<T>, right: Set<T>) -> Set<T> where T: core::cmp::Eq<T> {
    let count: i32 = count_where(left, right, false);
    let output: std::vec::Vec<T> = reserved_for(count);
    if (std::vec::capacity(output) < count) {
        return new();
    }
    return Set { items: append_where(output, left, right, false) };
}

pub fn try_symmetric_difference<T>(left: Set<T>, right: Set<T>) -> Set<T>
    where T: core::cmp::Eq<T> {
    let from_left: i32 = count_where(left, right, false);
    let from_right: i32 = count_where(right, left, false);
    if (from_right > MAX_CAPACITY - from_left) {
        return new();
    }
    let count: i32 = from_left + from_right;
    let output: std::vec::Vec<T> = reserved_for(count);
    if (std::vec::capacity(output) < count) {
        return new();
    }
    output = append_where(output, left, right, false);
    return Set { items: append_where(output, right, left, false) };
}

// Release the storage. The set must not be used afterwards.
pub fn destroy<T>(value: Set<T>) {
    std::vec::destroy(value.items);
}
