    if (result.unwrap() != 0) { return core::result::Err(core::io::Error::InvalidCount); }
    return core::result::Ok(0);
}
fn valid(view: core::slice::View<u8>) -> bool {
    return view.start >= 0 && view.length >= 0 && view.start <= 2147483647-view.length;
}
fn socket_result(result: core::result::Result<i64,core::io::Error>, domain: i32, datagram: bool) -> core::result::Result<Socket,core::io::Error> {
