        if (code == 0) { return core::result::Ok(core::option::None()); }
        return core::result::Ok(core::option::Some(code));
    }
    pub fn is_nonblocking(&self) -> core::result::Result<bool,core::io::Error> {
        if (self.handle < 0) { return core::result::Err(core::io::Error::Host(9)); }
        let args: [std::linux::Argument;6] = [word(self.handle as i64),word(3),word(0),word(0),word(0),word(0)];
        let result: core::result::Result<i64,core::io::Error> = invoke(72,args);
        if (result.is_err()) { return core::result::Err(result.unwrap_err()); }
        if (result.unwrap() < 0 || result.unwrap() > 2147483647) { return core::result::Err(core::io::Error::InvalidCount); }
        return core::result::Ok((result.unwrap() & 2048) != 0);
