    let result: core::result::Result<i64,std::linux::Error> = std::linux::call(number,view);
    if (result.is_ok()) { return core::result::Ok(result.unwrap()); }
    let error: std::linux::Error = result.unwrap_err();
    let mapped: core::io::Error = match (error) {
        std::linux::Error::System(code) -> host_error(code),
        _ -> core::io::Error::InvalidInput,
