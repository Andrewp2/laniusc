        let args: [std::linux::Argument;6] = [word(self.handle as i64),word(level),word(name),address(pointer),address(pointer+4),word(0)];
        let result: core::result::Result<i32,core::io::Error> = status(invoke(55,args));
        if (result.is_err()) { return result; }
