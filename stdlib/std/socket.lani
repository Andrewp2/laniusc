        let words: [i32;2] = [self.handle,events]; let pointer: ptr = core::mem::i32_array_data_ptr(words);
        let args: [std::linux::Argument;6] = [address(pointer),word(1),word(milliseconds as i64),word(0),word(0),word(0)];
        let result: core::result::Result<i64,core::io::Error> = invoke(7,args);
        if (result.is_err()) { return core::result::Err(result.unwrap_err()); }
        let count: i64 = result.unwrap(); if (count < 0 || count > 1) { return core::result::Err(core::io::Error::InvalidCount); }
        let ready: u32 = (words[1] as u32) >> 16;
