pub enum Family { Ipv4, Ipv6 }
pub enum Kind { Tcp, Udp }
pub enum Connection { Connected, InProgress }
pub enum Shutdown { Read, Write, Both }
pub enum Setting { ReuseAddress, KeepAlive, NoDelay, ReceiveBuffer, SendBuffer, Ipv6Only }
pub struct Socket { handle: i32, domain: i32, datagram: bool }
pub struct Accepted { socket: Socket, peer: core::net::SocketAddr }
pub struct Datagram { peer: core::net::SocketAddr, copied: i32, full_length: i32 }
pub struct Ready { readable: bool, writable: bool, hangup: bool, error: bool, timed_out: bool }
pub const MAX_DATAGRAM: i32 = 65507;

