fn address(value: ptr) -> std::linux::Argument { return std::linux::Argument::Address(value); }
fn null() -> ptr { let value: ptr = 0; return value; }
fn host_error(code: i32) -> core::io::Error {
    if (code == 4) { return core::io::Error::Interrupted; }
    if (code == 11) { return core::io::Error::WouldBlock; }
    return core::io::Error::Host(code);
}
fn invoke(number: i64, arguments: [std::linux::Argument]) -> core::result::Result<i64,core::io::Error> {
