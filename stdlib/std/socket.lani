    let handle: i64 = result.unwrap();
    if (handle < 0 || handle > 2147483647) { return core::result::Err(core::io::Error::InvalidCount); }
    return core::result::Ok(Socket { handle: handle as i32, domain: domain, datagram: datagram });
}
pub fn create(family: Family, kind: Kind, nonblocking: bool) -> core::result::Result<Socket,core::io::Error> {
    let domain: i32 = match (family) { Family::Ipv4 -> 2, Family::Ipv6 -> 10 };
    let datagram: bool = match (kind) { Kind::Tcp -> false, Kind::Udp -> true };
    let flags: i64 = 524289;
    if (datagram) { flags = 524290; }
    if (nonblocking) { flags = flags | 2048; }
    let args: [std::linux::Argument;6] = [word(domain as i64),word(flags),word(0),word(0),word(0),word(0)];
    return socket_result(invoke(41,args),domain,datagram);
}
// The caller exclusively owns a live socket descriptor with this family/kind.
// Metadata is a caller precondition; this does not validate an arbitrary FD.
pub fn from_owned_handle(handle: i32, family: Family, kind: Kind) -> core::result::Result<Socket,core::io::Error> {
    if (handle < 0) { return core::result::Err(core::io::Error::InvalidInput); }
    let domain: i32 = match (family) { Family::Ipv4 -> 2, Family::Ipv6 -> 10 };
    let datagram: bool = match (kind) { Kind::Tcp -> false, Kind::Udp -> true };
    return core::result::Ok(Socket { handle: handle, domain: domain, datagram: datagram });
}
fn encode_v4(value: core::net::SocketAddrV4, expected_domain: i32, bytes: [u8]) -> core::result::Result<i32,core::io::Error> {
    if (expected_domain != 2) { return core::result::Err(core::io::Error::InvalidInput); }
    bytes[0] = 2; let index: i32 = 0;
    while (index < 4) { bytes[4+index] = value.address.octet(index).unwrap(); index += 1; }
    return core::result::Ok(16);
}
fn encode_v6(value: core::net::SocketAddrV6, expected_domain: i32, bytes: [u8]) -> core::result::Result<i32,core::io::Error> {
    if (expected_domain != 10) { return core::result::Err(core::io::Error::InvalidInput); }
    bytes[0] = 10; let index: i32 = 0;
    while (index < 16) { let half: u16 = value.address.segment(index/2).unwrap(); let shift: i32 = 8; if (index%2 == 1) { shift = 0; } bytes[8+index] = (half >> shift) as u8; index += 1; }
    index = 0; while (index < 4) { bytes[24+index] = (value.scope >> (index*8)) as u8; index += 1; }
    return core::result::Ok(28);
}
fn encode(endpoint: core::net::SocketAddr, expected_domain: i32, bytes: [u8]) -> core::result::Result<i32,core::io::Error> {
    let index: i32 = 0; while (index < 32) { bytes[index] = 0; index += 1; }
    bytes[2] = (endpoint.port() >> 8) as u8; bytes[3] = endpoint.port() as u8;
    return match (endpoint) {
        core::net::SocketAddr::V4(value) -> encode_v4(value,expected_domain,bytes),
        core::net::SocketAddr::V6(value) -> encode_v6(value,expected_domain,bytes),
    };
}
fn decode(bytes: [u8], count: i32, domain: i32) -> core::result::Result<core::net::SocketAddr,core::io::Error> {
    if (count < 2 || count > 32 || (bytes[0] as i32)+(bytes[1] as i32)*256 != domain) { return core::result::Err(core::io::Error::InvalidCount); }
    let port: u16 = (bytes[2] as u16) << 8 | bytes[3] as u16;
    if (domain == 2 && count == 16) {
        let ip: core::net::Ipv4Addr = core::net::ipv4(bytes[4],bytes[5],bytes[6],bytes[7]);
        return core::result::Ok(core::net::SocketAddr::V4(core::net::SocketAddrV4 { address: ip, port: port }));
    }
    if (domain == 10 && count == 28) {
        let full: core::slice::View<u8> = core::slice::view(bytes,32).unwrap();
        let ip_bytes: core::slice::View<u8> = full.subview(8,24).unwrap();
        let ip: core::net::Ipv6Addr = core::net::ipv6_from_octets(ip_bytes).unwrap();
        let scope: u32 = (bytes[24] as u32) | ((bytes[25] as u32) << 8) | ((bytes[26] as u32) << 16) | ((bytes[27] as u32) << 24);
        return core::result::Ok(core::net::SocketAddr::V6(core::net::SocketAddrV6 { address: ip, port: port, scope: scope }));
    }
    return core::result::Err(core::io::Error::InvalidCount);
}

struct OptionCode { level: i64, name: i64, boolean: bool }
fn option_code(setting: Setting) -> OptionCode {
    return match (setting) {
        Setting::ReuseAddress -> OptionCode { level: 1, name: 2, boolean: true },
        Setting::KeepAlive -> OptionCode { level: 1, name: 9, boolean: true },
        Setting::NoDelay -> OptionCode { level: 6, name: 1, boolean: true },
        Setting::ReceiveBuffer -> OptionCode { level: 1, name: 8, boolean: false },
        Setting::SendBuffer -> OptionCode { level: 1, name: 7, boolean: false },
        Setting::Ipv6Only -> OptionCode { level: 41, name: 26, boolean: true },
    };
}
fn clock_error(error: std::clock::Error) -> core::io::Error {
    let value: core::io::Error = match (error) { std::clock::Error::Host(code) -> host_error(code), _ -> core::io::Error::InvalidCount }; return value;
}
