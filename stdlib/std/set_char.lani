// Owned insertion-ordered char set with linear lookup. Each char occupies one
// native eight-byte slot (slot i at storage + 8 * i), read and written as
// char, so no integer conversion is involved.
// Ownership is linear by convention: use only the newest returned set, and
// destroy it exactly once.
module std::set_char;
import alloc::allocator;
import core::mem;

pub struct SetChar {
    storage: ptr,
    length: i32,
    reserved: i32,
}

// Doubled capacities fit signed i32. Byte counts are computed as usize.
pub const MAX_CAPACITY: i32 = 536870911;

fn slot(storage: ptr, index: i32) -> [char] {
    let offset: usize = (index as usize) * 8;
    return core::mem::typed_slice_from_raw_parts(storage + offset, 1);
}

fn load(storage: ptr, index: i32) -> char {
    let view: [char] = slot(storage, index);
    return view[0];
}

fn store(storage: ptr, index: i32, item: char) {
    let view: [char] = slot(storage, index);
    view[0] = item;
}

fn byte_size(count: i32) -> usize {
    return (count as usize) * 8;
}

pub fn new() -> SetChar {
    let empty: ptr = 0;
    return SetChar { storage: empty, length: 0, reserved: 0 };
}

pub fn len(value: SetChar) -> i32 {
    return value.length;
}

pub fn capacity(value: SetChar) -> i32 {
    return value.reserved;
}

pub fn is_empty(value: SetChar) -> bool {
    return value.length == 0;
}

pub fn contains(value: SetChar, item: char) -> bool {
    if (value.length == 0) {
        return false;
    }
    let index: i32 = 0;
    while (index < value.length) {
        let stored: char = load(value.storage, index);
        if (stored == item) {
            return true;
        }
        index += 1;
    }
    return false;
}

// Elements retain insertion order. Invalid ordinals return fallback; use len
// to distinguish an absent ordinal when a stored item equals the fallback.
pub fn at_or(value: SetChar, ordinal: i32, fallback: char) -> char {
    if (ordinal < 0 || ordinal >= value.length) {
        return fallback;
    }
    return load(value.storage, ordinal);
}

// A negative or oversized request, or allocation failure, leaves the set
// unchanged. Compare capacity(result) against the request to detect failure.
pub fn try_reserve(value: SetChar, minimum_capacity: i32) -> SetChar {
    if (minimum_capacity < 0 || minimum_capacity > MAX_CAPACITY ||
        minimum_capacity <= value.reserved) {
        return value;
    }
    let new_bytes: usize = byte_size(minimum_capacity);
    let next: ptr = 0;
    if (value.storage == 0) {
        next = alloc::allocator::alloc(new_bytes, 8);
    } else {
        next = alloc::allocator::realloc(value.storage, byte_size(value.reserved), new_bytes, 8);
    }
    if (next == 0) {
        return value;
    }
    return SetChar {
        storage: next,
        length: value.length,
        reserved: minimum_capacity,
    };
}

// Insert a new item. A duplicate, capacity limit, or allocation failure
// leaves len unchanged. Compare len(result) to the old length for success.
pub fn try_insert(value: SetChar, item: char) -> SetChar {
    if (contains(value, item) || value.length >= MAX_CAPACITY) {
        return value;
    }
    let grown: SetChar = value;
    if (grown.length == grown.reserved) {
        let target: i32 = 4;
        if (grown.reserved > 0) {
            if (grown.reserved > MAX_CAPACITY / 2) {
                target = MAX_CAPACITY;
            } else {
                target = grown.reserved * 2;
            }
        }
        grown = try_reserve(grown, target);
        if (grown.length == grown.reserved) {
            return value;
        }
    }
    store(grown.storage, grown.length, item);
    return SetChar {
        storage: grown.storage,
        length: grown.length + 1,
        reserved: grown.reserved,
    };
}

// Remove an item while preserving the order of remaining items. Missing
// items leave the set unchanged; successful removal decrements len.
pub fn try_remove(value: SetChar, item: char) -> SetChar {
    if (value.length == 0) {
        return value;
    }
    let index: i32 = 0;
    while (index < value.length) {
        let stored: char = load(value.storage, index);
        if (stored == item) {
            let cursor: i32 = index;
            while (cursor + 1 < value.length) {
                store(value.storage, cursor, load(value.storage, cursor + 1));
                cursor += 1;
            }
            return SetChar {
                storage: value.storage,
                length: value.length - 1,
                reserved: value.reserved,
            };
        }
        index += 1;
    }
    return value;
}

pub fn clear(value: SetChar) -> SetChar {
    return SetChar {
        storage: value.storage,
        length: 0,
        reserved: value.reserved,
    };
}

// Release unused storage. Empty sets release their allocation. Reallocation
// failure returns the original set with its old capacity and elements.
pub fn try_shrink_to_fit(value: SetChar) -> SetChar {
    if (value.length == value.reserved) {
        return value;
    }
    if (value.length == 0) {
        destroy(value);
        return new();
    }
    let next: ptr = alloc::allocator::realloc(
        value.storage, byte_size(value.reserved), byte_size(value.length), 8);
    if (next == 0) {
        return value;
    }
    return SetChar {
        storage: next,
        length: value.length,
        reserved: value.length,
    };
}

// An independent copy of initialized items. Allocation failure returns an
// empty zero-capacity set and leaves the source unchanged. A nonempty source
// cloned successfully when len(result) == len(value).
pub fn try_clone(value: SetChar) -> SetChar {
    if (value.length == 0) {
        return new();
    }
    let copy: SetChar = try_reserve(new(), value.length);
    if (copy.reserved < value.length) {
        return new();
    }
    let index: i32 = 0;
    while (index < value.length) {
        store(copy.storage, index, load(value.storage, index));
        index += 1;
    }
    return SetChar {
        storage: copy.storage,
        length: value.length,
        reserved: copy.reserved,
    };
}

pub fn is_subset(left: SetChar, right: SetChar) -> bool {
    let index: i32 = 0;
    while (index < left.length) {
        if (!contains(right, at_or(left, index, '\0'))) {
            return false;
        }
        index += 1;
    }
    return true;
}

pub fn is_disjoint(left: SetChar, right: SetChar) -> bool {
    let index: i32 = 0;
    while (index < left.length) {
        if (contains(right, at_or(left, index, '\0'))) {
            return false;
        }
        index += 1;
    }
    return true;
}

// Each set algebra operation returns a new independent owner. It reserves the
// complete result before writing, so no allocation failure can leave a
// partial set. An empty result means either the mathematical result is empty
// or allocation/capacity failed; when a nonempty result is expected, compare
// len(result) to zero. Source sets remain live and unchanged.
pub fn try_union(left: SetChar, right: SetChar) -> SetChar {
    let count: i32 = left.length;
    let index: i32 = 0;
    while (index < right.length) {
        if (!contains(left, at_or(right, index, '\0'))) {
            if (count >= MAX_CAPACITY) { return new(); }
            count += 1;
        }
        index += 1;
    }
    if (count == 0) { return new(); }
    let output: SetChar = try_reserve(new(), count);
    if (output.reserved < count) { return new(); }
    index = 0;
    while (index < left.length) {
        let item: char = at_or(left, index, '\0');
        store(output.storage, index, item);
        index += 1;
    }
    let written: i32 = left.length;
    index = 0;
    while (index < right.length) {
        let item: char = at_or(right, index, '\0');
        if (!contains(left, item)) {
            store(output.storage, written, item);
            written += 1;
        }
        index += 1;
    }
    return SetChar { storage: output.storage, length: count, reserved: output.reserved };
}

pub fn try_intersection(left: SetChar, right: SetChar) -> SetChar {
    let count: i32 = 0;
    let index: i32 = 0;
    while (index < left.length) {
        if (contains(right, at_or(left, index, '\0'))) { count += 1; }
        index += 1;
    }
    if (count == 0) { return new(); }
    let output: SetChar = try_reserve(new(), count);
    if (output.reserved < count) { return new(); }
    let written: i32 = 0;
    index = 0;
    while (index < left.length) {
        let item: char = at_or(left, index, '\0');
        if (contains(right, item)) {
            store(output.storage, written, item);
            written += 1;
        }
        index += 1;
    }
    return SetChar { storage: output.storage, length: count, reserved: output.reserved };
}

pub fn try_difference(left: SetChar, right: SetChar) -> SetChar {
    let count: i32 = 0;
    let index: i32 = 0;
    while (index < left.length) {
        if (!contains(right, at_or(left, index, '\0'))) { count += 1; }
        index += 1;
    }
    if (count == 0) { return new(); }
    let output: SetChar = try_reserve(new(), count);
    if (output.reserved < count) { return new(); }
    let written: i32 = 0;
    index = 0;
    while (index < left.length) {
        let item: char = at_or(left, index, '\0');
        if (!contains(right, item)) {
            store(output.storage, written, item);
            written += 1;
        }
        index += 1;
    }
    return SetChar { storage: output.storage, length: count, reserved: output.reserved };
}

pub fn try_symmetric_difference(left: SetChar, right: SetChar) -> SetChar {
    let count: i32 = 0;
    let index: i32 = 0;
    while (index < left.length) {
        if (!contains(right, at_or(left, index, '\0'))) {
            if (count >= MAX_CAPACITY) { return new(); }
            count += 1;
        }
        index += 1;
    }
    index = 0;
    while (index < right.length) {
        if (!contains(left, at_or(right, index, '\0'))) {
            if (count >= MAX_CAPACITY) { return new(); }
            count += 1;
        }
        index += 1;
    }
    if (count == 0) { return new(); }
    let output: SetChar = try_reserve(new(), count);
    if (output.reserved < count) { return new(); }
    let written: i32 = 0;
    index = 0;
    while (index < left.length) {
        let item: char = at_or(left, index, '\0');
        if (!contains(right, item)) {
            store(output.storage, written, item);
            written += 1;
        }
        index += 1;
    }
    index = 0;
    while (index < right.length) {
        let item: char = at_or(right, index, '\0');
        if (!contains(left, item)) {
            store(output.storage, written, item);
            written += 1;
        }
        index += 1;
    }
    return SetChar { storage: output.storage, length: count, reserved: output.reserved };
}

pub fn destroy(value: SetChar) {
    if (value.storage != 0) {
        alloc::allocator::dealloc(value.storage, byte_size(value.reserved), 8);
    }
}
