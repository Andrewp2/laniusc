// An allocation-free Boolean-keyed map. Keys retain insertion order, and
// values preserve all 32 bits. The three-word value can be copied freely.
module std::map_bool_u32;

pub struct MapBoolU32 {
    flags: u32,
    false_value: u32,
    true_value: u32,
}

// flags bit 0: false key; bit 1: true key; bit 2: true was inserted first.
fn has_false(value: MapBoolU32) -> bool { return (value.flags & 1) != 0; }
fn has_true(value: MapBoolU32) -> bool { return (value.flags & 2) != 0; }

pub fn new() -> MapBoolU32 {
    return MapBoolU32 { flags: 0, false_value: 0, true_value: 0 };
}

pub fn len(value: MapBoolU32) -> i32 {
    if (has_false(value) && has_true(value)) { return 2; }
    if (has_false(value) || has_true(value)) { return 1; }
    return 0;
}

pub fn is_empty(value: MapBoolU32) -> bool {
    return (value.flags & 3) == 0;
}

pub fn contains_key(value: MapBoolU32, key: bool) -> bool {
    if (key) { return has_true(value); }
    return has_false(value);
}

// Missing keys return fallback. Use contains_key when a stored value may
// equal fallback.
pub fn get_or(value: MapBoolU32, key: bool, fallback: u32) -> u32 {
    if (key) {
        if (has_true(value)) { return value.true_value; }
    } else {
        if (has_false(value)) { return value.false_value; }
    }
    return fallback;
}

// Entry ordinals follow insertion order. Invalid ordinals return fallback.
pub fn key_at_or(value: MapBoolU32, ordinal: i32, fallback: bool) -> bool {
    if (ordinal == 0) {
        if (has_false(value) && has_true(value)) {
            return (value.flags & 4) != 0;
        }
        if (has_false(value)) { return false; }
        if (has_true(value)) { return true; }
    }
    if (ordinal == 1 && has_false(value) && has_true(value)) {
        return (value.flags & 4) == 0;
    }
    return fallback;
}

pub fn value_at_or(value: MapBoolU32, ordinal: i32, fallback: u32) -> u32 {
    if (ordinal < 0 || ordinal >= len(value)) { return fallback; }
    return get_or(value, key_at_or(value, ordinal, false), fallback);
}

// Insert a missing key or replace an existing value. Replacement keeps its
// original ordinal. This operation cannot fail or allocate.
pub fn put(value: MapBoolU32, key: bool, item: u32) -> MapBoolU32 {
    if (key) {
        let flags: u32 = value.flags | 2;
        if (is_empty(value)) { flags = flags | 4; }
        return MapBoolU32 {
            flags: flags, false_value: value.false_value, true_value: item,
        };
    }
    return MapBoolU32 {
        flags: value.flags | 1, false_value: item,
        true_value: value.true_value,
    };
}

// A missing key leaves the map unchanged. Remaining entries keep their order.
pub fn remove(value: MapBoolU32, key: bool) -> MapBoolU32 {
    if (!contains_key(value, key)) { return value; }
    if (key) {
        return MapBoolU32 {
            flags: value.flags & 1, false_value: value.false_value,
            true_value: 0,
        };
    }
    let flags: u32 = 0;
    if (has_true(value)) { flags = 6; }
    return MapBoolU32 {
        flags: flags, false_value: 0, true_value: value.true_value,
    };
}

pub fn clear(value: MapBoolU32) -> MapBoolU32 {
    return new();
}
