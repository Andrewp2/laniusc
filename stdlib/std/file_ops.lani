// position, so reject it as well as unsupported direct I/O before source reads.
// Short counts remain explicit; the shared cursor is never sought or changed.
pub fn write_at(file:&File,source:View<u8>,position:u64) -> Result<i32,Error> {
    if(!valid(source) || !core::io::valid_position(position,source.length)) {
        return Err(Error::InvalidInput);
    }
    let got:i64=descriptor(file)?;
    if(source.length==0) { return Ok(0); }
    let status:i32=status_flags(file)?;
    if((status&16384)!=0 || (status&1024)!=0) { return Err(Error::InvalidInput); }
    let amount:i32=source.length;
    if(amount>POSITIONAL_CHUNK_BYTES) { amount=POSITIONAL_CHUNK_BYTES; }
    let storage:[i32;256]=[0;256];
    let pointer:ptr=core::mem::i32_array_data_ptr(storage);
    let packed:[u8]=core::mem::typed_slice_from_raw_parts(pointer,amount);
    let index:i32=0;
    while(index<amount) {
        packed[index]=source.values[source.start+index];
        index+=1;
    }
    let args:[std::linux::Argument;4]=[std::linux::Argument::Word(got),std::linux::Argument::Address(pointer),std::linux::Argument::Word(amount as i64),std::linux::Argument::Word(position as i64)];
    let sent:i64=call(18,view(args,4).unwrap())?;
    let amount_wide:i64=amount as i64;
    if(sent<0 || sent>amount_wide) { return Err(Error::InvalidCount); }
    return Ok(sent as i32);
}

// Import std::file_ops to bring these portable trait implementations into the
// compilation. Delegation keeps native and generic validation/error behavior
// identical; no descriptor is allocated, closed, flushed or synchronized.
pub impl core::io::ReadAt for File {
    pub fn read_at(&self,destination:[u8],offset:i32,count:i32,position:u64) -> Result<i32,Error> {
        let selected:View<u8> =View { values:destination,start:offset,length:count };
        return std::file_ops::read_at(self,selected,position);
    }
}
pub impl core::io::WriteAt for File {
    pub fn write_at(&self,source:[u8],offset:i32,count:i32,position:u64) -> Result<i32,Error> {
        let selected:View<u8> =View { values:source,start:offset,length:count };
        return std::file_ops::write_at(self,selected,position);
    }
}

// Portable positioning shares the existing full-width Linux seek engine.
// A live owner is required before Start-domain admission. Duplicates share
// this cursor; a failed seek has no general rollback guarantee. No retry.
pub impl core::io::Seek for File {
    pub fn seek(&self,from:core::io::SeekFrom) -> Result<u64,Error> {
        descriptor(self)?;
        let start:core::option::Option<u64> =match(from) {
            core::io::SeekFrom::Start(target)->core::option::Some(target),
            _->core::option::None()
        };
        if(start.is_some() && start.unwrap()>9223372036854775807) { return Err(Error::InvalidInput); }
        let offset:i64=match(from) {
            core::io::SeekFrom::Start(target)->target as i64,
            core::io::SeekFrom::Current(delta)->delta,
            core::io::SeekFrom::End(delta)->delta
        };
        let origin:Origin=match(from) {
            core::io::SeekFrom::Start(_)->Origin::Start,
            core::io::SeekFrom::Current(_)->Origin::Current,
            core::io::SeekFrom::End(_)->Origin::End
        };
        let position:i64=std::file_ops::seek(self,offset,origin)?;
        let actual:u64=position as u64;
        if(start.is_some() && actual!=start.unwrap()) { return Err(Error::InvalidCount); }
        return Ok(actual);
    }
}

pub enum LockMode { Shared, Exclusive }
pub enum LockWait { Blocking, Nonblocking }

// One whole-file advisory flock attempt. Duplicates share the open file
// description's lock; acquisitions are not counted and conversion has no
// atomicity guarantee. Coordinate aliases' lock/close operations; keep File live.
// Blocking may wait indefinitely; Nonblocking reports contention directly.
pub fn lock(file:&File,mode:LockMode,wait:LockWait) -> Result<i32,Error> {
    let got:i64=descriptor(file)?;
    let operation:i64=match(mode) { LockMode::Shared->1, LockMode::Exclusive->2 };
    let extra:i64=match(wait) { LockWait::Blocking->0, LockWait::Nonblocking->4 };
    let args:[std::linux::Argument;2]=[std::linux::Argument::Word(got),std::linux::Argument::Word(operation|extra)];
    return zero(call(73,view(args,2).unwrap()));
}

// Always ask the host, even if no lock is believed held. Any duplicate may
// release the shared lock state. No retry, flush, synchronization or close.
pub fn unlock(file:&File) -> Result<i32,Error> {
    let got:i64=descriptor(file)?;
    let args:[std::linux::Argument;2]=[std::linux::Argument::Word(got),std::linux::Argument::Word(8)];
    return zero(call(73,view(args,2).unwrap()));
}
