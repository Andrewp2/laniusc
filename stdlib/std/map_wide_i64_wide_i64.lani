// Owned insertion-ordered map of two-word signed keys and values.
// Each entry occupies four 32-bit cells: key low/high, then value low/high.
// Ownership is linear by convention: keep only the newest returned map and
// destroy it exactly once. Native storage requires the allocator binding.
module std::map_wide_i64_wide_i64;
import alloc::allocator;
import core::mem;
import core::wide_i64;

pub struct MapWideI64WideI64 {
    storage: ptr,
    length: i32,
    reserved: i32,
}

// 16 bytes per entry; all byte and cell counts fit signed 32-bit arithmetic.
pub const MAX_ENTRIES: i32 = 134217727;

fn load_at(cells: [i32], offset: i32) -> core::wide_i64::WideI64 {
    let low: u32 = cells[offset];
    let high: u32 = cells[offset + 1];
    return core::wide_i64::from_words(high, low);
}

fn store_at(cells: [i32], offset: i32, item: core::wide_i64::WideI64) {
    let low: u32 = core::wide_i64::low_word(item);
    let high: u32 = core::wide_i64::high_word(item);
    cells[offset] = low as i32;
    cells[offset + 1] = high as i32;
}

pub fn new() -> MapWideI64WideI64 {
    let empty: ptr = 0;
    return MapWideI64WideI64 { storage: empty, length: 0, reserved: 0 };
}

pub fn len(value: MapWideI64WideI64) -> i32 {
    return value.length;
}

pub fn capacity(value: MapWideI64WideI64) -> i32 {
    return value.reserved;
}

pub fn is_empty(value: MapWideI64WideI64) -> bool {
    return value.length == 0;
}

pub fn contains_key(value: MapWideI64WideI64, key: core::wide_i64::WideI64) -> bool {
    if (value.length == 0) { return false; }
    let cells: [i32] = core::mem::i32_slice_from_raw_parts(value.storage, value.reserved * 4);
    let index: i32 = 0;
    while (index < value.length) {
        if (core::wide_i64::eq(load_at(cells, index * 4), key)) { return true; }
        index += 1;
    }
    return false;
}

// An absent key returns fallback. Use contains_key when the stored value may
// equal fallback.
pub fn get_or(value: MapWideI64WideI64, key: core::wide_i64::WideI64,
              fallback: core::wide_i64::WideI64) -> core::wide_i64::WideI64 {
    if (value.length == 0) { return fallback; }
    let cells: [i32] = core::mem::i32_slice_from_raw_parts(value.storage, value.reserved * 4);
    let index: i32 = 0;
    while (index < value.length) {
        let offset: i32 = index * 4;
        if (core::wide_i64::eq(load_at(cells, offset), key)) {
            return load_at(cells, offset + 2);
        }
        index += 1;
    }
    return fallback;
}

// Ordinals follow insertion order; invalid ordinals return fallback.
pub fn key_at_or(value: MapWideI64WideI64, ordinal: i32,
                 fallback: core::wide_i64::WideI64) -> core::wide_i64::WideI64 {
    if (ordinal < 0 || ordinal >= value.length) { return fallback; }
    let cells: [i32] = core::mem::i32_slice_from_raw_parts(value.storage, value.reserved * 4);
    return load_at(cells, ordinal * 4);
}

pub fn value_at_or(value: MapWideI64WideI64, ordinal: i32,
                   fallback: core::wide_i64::WideI64) -> core::wide_i64::WideI64 {
    if (ordinal < 0 || ordinal >= value.length) { return fallback; }
    let cells: [i32] = core::mem::i32_slice_from_raw_parts(value.storage, value.reserved * 4);
    return load_at(cells, ordinal * 4 + 2);
}

// Invalid requests or allocation failure leave the original map unchanged.
// Compare capacity(result) with the requested minimum to detect failure.
pub fn try_reserve(value: MapWideI64WideI64, minimum_entries: i32) -> MapWideI64WideI64 {
    if (minimum_entries < 0 || minimum_entries > MAX_ENTRIES ||
        minimum_entries <= value.reserved) { return value; }
    let new_byte_count: i32 = minimum_entries * 16;
    let new_bytes: usize = new_byte_count as usize;
    let next: ptr = 0;
    if (value.storage == 0) {
        next = alloc::allocator::alloc(new_bytes, 4);
    } else {
        let old_byte_count: i32 = value.reserved * 16;
        let old_bytes: usize = old_byte_count as usize;
        next = alloc::allocator::realloc(value.storage, old_bytes, new_bytes, 4);
    }
    if (next == 0) { return value; }
    return MapWideI64WideI64 {
        storage: next, length: value.length, reserved: minimum_entries,
    };
}

// An existing key is left unchanged. A new key increments len only after
// successful growth and insertion; allocation failure retains the old map.
pub fn try_insert(value: MapWideI64WideI64, key: core::wide_i64::WideI64,
                  item: core::wide_i64::WideI64) -> MapWideI64WideI64 {
    if (contains_key(value, key) || value.length >= MAX_ENTRIES) { return value; }
    let needed: i32 = value.length + 1;
    let grown: MapWideI64WideI64 = value;
    if (grown.reserved < needed) {
        let target: i32 = 4;
        if (grown.reserved > 0) {
            if (grown.reserved > MAX_ENTRIES / 2) {
                target = MAX_ENTRIES;
            } else {
                target = grown.reserved * 2;
            }
        }
        if (target < needed) { target = needed; }
        grown = try_reserve(grown, target);
        if (grown.reserved < needed) { return value; }
    }
    let cells: [i32] = core::mem::i32_slice_from_raw_parts(grown.storage, grown.reserved * 4);
    let offset: i32 = grown.length * 4;
    store_at(cells, offset, key);
    store_at(cells, offset + 2, item);
    return MapWideI64WideI64 {
        storage: grown.storage, length: needed, reserved: grown.reserved,
    };
}

// Replace an existing value in place. Return false without mutation if the
// key is missing.
pub fn try_set(value: MapWideI64WideI64, key: core::wide_i64::WideI64,
               item: core::wide_i64::WideI64) -> bool {
    if (value.length == 0) { return false; }
    let cells: [i32] = core::mem::i32_slice_from_raw_parts(value.storage, value.reserved * 4);
    let index: i32 = 0;
    while (index < value.length) {
        let offset: i32 = index * 4;
        if (core::wide_i64::eq(load_at(cells, offset), key)) {
            store_at(cells, offset + 2, item);
            return true;
        }
        index += 1;
    }
    return false;
}

// Remove the first matching key, preserving the order of later entries.
// A missing key leaves the map unchanged.
pub fn try_remove(value: MapWideI64WideI64,
                  key: core::wide_i64::WideI64) -> MapWideI64WideI64 {
    if (value.length == 0) { return value; }
    let cells: [i32] = core::mem::i32_slice_from_raw_parts(value.storage, value.reserved * 4);
    let index: i32 = 0;
    while (index < value.length) {
        if (core::wide_i64::eq(load_at(cells, index * 4), key)) {
            let cursor: i32 = index;
            while (cursor + 1 < value.length) {
                let destination: i32 = cursor * 4;
                let source: i32 = destination + 4;
                cells[destination] = cells[source];
                cells[destination + 1] = cells[source + 1];
                cells[destination + 2] = cells[source + 2];
                cells[destination + 3] = cells[source + 3];
                cursor += 1;
            }
            return MapWideI64WideI64 {
                storage: value.storage, length: value.length - 1,
                reserved: value.reserved,
            };
        }
        index += 1;
    }
    return value;
}

pub fn clear(value: MapWideI64WideI64) -> MapWideI64WideI64 {
    return MapWideI64WideI64 {
        storage: value.storage, length: 0, reserved: value.reserved,
    };
}

// Empty maps release their allocation. Reallocation failure preserves all
// entries and the old capacity.
pub fn try_shrink_to_fit(value: MapWideI64WideI64) -> MapWideI64WideI64 {
    if (value.length == value.reserved) { return value; }
    if (value.length == 0) {
        destroy(value);
        return new();
    }
    let old_byte_count: i32 = value.reserved * 16;
    let new_byte_count: i32 = value.length * 16;
    let old_bytes: usize = old_byte_count as usize;
    let new_bytes: usize = new_byte_count as usize;
    let next: ptr = alloc::allocator::realloc(value.storage, old_bytes, new_bytes, 4);
    if (next == 0) { return value; }
    return MapWideI64WideI64 {
        storage: next, length: value.length, reserved: value.length,
    };
}

// Return an independent copy. For nonempty input, allocation failure returns
// an empty zero-capacity map while retaining the source intact.
pub fn try_clone(value: MapWideI64WideI64) -> MapWideI64WideI64 {
    if (value.length == 0) { return new(); }
    let copy: MapWideI64WideI64 = try_reserve(new(), value.length);
    if (copy.reserved < value.length) { return new(); }
    let source: [i32] = core::mem::i32_slice_from_raw_parts(value.storage, value.length * 4);
    let destination: [i32] = core::mem::i32_slice_from_raw_parts(copy.storage, copy.reserved * 4);
    let index: i32 = 0;
    let count: i32 = value.length * 4;
    while (index < count) {
        destination[index] = source[index];
        index += 1;
    }
    return MapWideI64WideI64 {
        storage: copy.storage, length: value.length, reserved: copy.reserved,
    };
}

pub fn destroy(value: MapWideI64WideI64) {
    if (value.storage != 0) {
        let byte_count: i32 = value.reserved * 16;
        let bytes: usize = byte_count as usize;
        alloc::allocator::dealloc(value.storage, bytes, 4);
    }
}
