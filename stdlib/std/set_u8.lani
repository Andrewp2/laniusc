// A dense set of all 256 byte values in caller-owned [u32] storage. Eight
// addressable words are required; indexing a missing word traps on x86_64.
// A set has no allocation or destructor. Ordinals are in
// ascending byte order, independent of insertion order. Exact source and
// destination aliases work for set algebra; partial overlap is unsupported.
module std::set_u8;
import core::bits;

fn mask(item: u8) -> u32 {
    let code: i32 = item as i32;
    let one: u32 = 1;
    let shift: u32 = (code % 32) as u32;
    return one << shift;
}

pub fn len(words: [u32]) -> i32 {
    let total: i32 = 0;
    let index: i32 = 0;
    while (index < 8) {
        let count: u32 = core::bits::count_ones_u32(words[index]);
        total += count as i32;
        index += 1;
    }
    return total;
}

pub fn is_empty(words: [u32]) -> bool {
    let index: i32 = 0;
    while (index < 8) {
        if (words[index] != 0) { return false; }
        index += 1;
    }
    return true;
}

pub fn is_full(words: [u32]) -> bool {
    let index: i32 = 0;
    while (index < 8) {
        if (words[index] != 4294967295) { return false; }
        index += 1;
    }
    return true;
}

pub fn contains(words: [u32], item: u8) -> bool {
    let code: i32 = item as i32;
    return (words[code / 32] & mask(item)) != 0;
}

// Invalid ordinals return fallback. Check len if a stored byte can equal it.
pub fn at_or(words: [u32], ordinal: i32, fallback: u8) -> u8 {
    if (ordinal < 0 || ordinal >= len(words)) { return fallback; }
    let code: i32 = 0;
    let seen: i32 = 0;
    while (code < 256) {
        let item: u8 = code as u8;
        if (contains(words, item)) {
            if (seen == ordinal) { return item; }
            seen += 1;
        }
        code += 1;
    }
    return fallback;
}

// Return true only when membership changed. A duplicate is left unchanged.
pub fn insert(words: [u32], item: u8) -> bool {
    let code: i32 = item as i32;
    let index: i32 = code / 32;
    let bit: u32 = mask(item);
    let old: u32 = words[index];
    if ((old & bit) != 0) { return false; }
    words[index] = old | bit;
    return true;
}

// Return true only when a present member was removed.
pub fn remove(words: [u32], item: u8) -> bool {
    let code: i32 = item as i32;
    let index: i32 = code / 32;
    let bit: u32 = mask(item);
    let old: u32 = words[index];
    if ((old & bit) == 0) { return false; }
    words[index] = old & (bit ^ 4294967295);
    return true;
}

pub fn fill(words: [u32], present: bool) {
    let value: u32 = 0;
    if (present) { value = 4294967295; }
    let index: i32 = 0;
    while (index < 8) {
        words[index] = value;
        index += 1;
    }
}

pub fn clear(words: [u32]) {
    fill(words, false);
}

pub fn is_subset(left: [u32], right: [u32]) -> bool {
    let index: i32 = 0;
    while (index < 8) {
        if ((left[index] & right[index]) != left[index]) { return false; }
        index += 1;
    }
    return true;
}

pub fn is_disjoint(left: [u32], right: [u32]) -> bool {
    let index: i32 = 0;
    while (index < 8) {
        if ((left[index] & right[index]) != 0) { return false; }
        index += 1;
    }
    return true;
}

pub fn union_into(destination: [u32], left: [u32], right: [u32]) {
    let index: i32 = 0;
    while (index < 8) {
        destination[index] = left[index] | right[index];
        index += 1;
    }
}

pub fn intersection_into(destination: [u32], left: [u32], right: [u32]) {
    let index: i32 = 0;
    while (index < 8) {
        destination[index] = left[index] & right[index];
        index += 1;
    }
}

pub fn difference_into(destination: [u32], left: [u32], right: [u32]) {
    let index: i32 = 0;
    while (index < 8) {
        destination[index] = left[index] & (right[index] ^ 4294967295);
        index += 1;
    }
}

pub fn symmetric_difference_into(destination: [u32], left: [u32], right: [u32]) {
    let index: i32 = 0;
    while (index < 8) {
        destination[index] = left[index] ^ right[index];
        index += 1;
    }
}
