// Convenience file operations built from the bound filesystem and I/O APIs.
// write_text_once opens or creates `path`, truncates it, makes one write
// attempt, then closes the handle. A nonnegative result is the number of
// bytes actually written; it may be shorter than `text`. A negative result
// reports an open, write, or close failure. Closing is attempted even when
// the write fails.
module std::file;
import core::decimal;
import core::io;
import core::mem;
import core::option;
import core::result;
import core::wide_i64;
import core::wide_u64;
import std::fs;
import std::io;
import std::io_checked;
import std::io_decimal;
import core::path;
import std::stream;

// Explicit, single-owner x86_64 Linux file handles. Copying this record does
// not duplicate the descriptor. There is no automatic destructor: close every
// owner, or transfer its handle with take_handle. See docs/stdlib-files.md.
pub struct File { handle: i32 }
pub enum OpenMode { Read, Create, Append }

fn file_error(result: i32) -> core::io::Error {
    if (result == -4) { return core::io::Error::Interrupted; }
    if (result == -11) { return core::io::Error::WouldBlock; }
    return core::io::Error::Host(0 - result);
}

// Read: existing read-only file. Create: write-only, creates or truncates.
// Append: write-only, creates or appends. New files use 0666 filtered by umask.
// Existing bindings do not set close-on-exec. Open makes one host attempt.
pub fn open(path: core::path::Path, mode: OpenMode) -> core::result::Result<File, core::io::Error> {
    let count: i32 = path.byte_len();
    if (count > 4095) { return core::result::Err(core::io::Error::Host(36)); }
    let storage: [i32; 1024] = [0; 1024];
    let pointer: ptr = core::mem::i32_array_data_ptr(storage);
    let packed: [u8] = core::mem::typed_slice_from_raw_parts(pointer, count);
    let index: i32 = 0;
    while (index < count) {
        let byte: u8 = core::option::unwrap(path.byte_at(index));
        // Recheck at the host boundary even if borrowed storage was mutated.
        if (byte == 0) { return core::result::Err(core::io::Error::InvalidInput); }
        packed[index] = byte;
        index += 1;
    }
    let handle: i32 = match (mode) {
        OpenMode::Read -> std::fs::open_read(pointer, count as usize),
        OpenMode::Create -> std::fs::open_write(pointer, count as usize),
        OpenMode::Append -> std::fs::open_append(pointer, count as usize),
    };
    if (handle < 0) { return core::result::Err(file_error(handle)); }
    return core::result::Ok(File { handle: handle });
}

// Low-level ownership transfer. The caller must exclusively own a live
// descriptor and stop using it independently. Only negative values are checked.
pub fn from_owned_handle(handle: i32) -> core::result::Result<File, core::io::Error> {
    if (handle < 0) { return core::result::Err(core::io::Error::InvalidInput); }
    return core::result::Ok(File { handle: handle });
}

pub impl File {
    pub fn borrow(&self) -> &File { return self; }
    pub fn is_open(&self) -> bool { return self.handle >= 0; }
    // Borrowed identifier; do not close it, retain it past close, or adopt it.
    pub fn raw_handle(&self) -> core::option::Option<i32> {
        if (self.handle < 0) { return core::option::None(); }
        return core::option::Some(self.handle);
    }
    // Caller becomes the sole owner. This File becomes closed without a syscall.
    pub fn take_handle(&self) -> core::option::Option<i32> {
        if (self.handle < 0) { return core::option::None(); }
        let handle: i32 = self.handle;
        self.handle = -1;
        return core::option::Some(handle);
    }
    // Linux releases the descriptor even when close reports EINTR or a delayed
    // I/O error. Invalidate first, attempt once, and never retry that descriptor.
    // A second close is Ok(0). An error still leaves this owner closed.
    pub fn close(&self) -> core::result::Result<i32, core::io::Error> {
        if (self.handle < 0) { return core::result::Ok(0); }
        let handle: i32 = self.handle;
        self.handle = -1;
        let result: i32 = std::fs::close(handle);
        if (result < 0) { return core::result::Err(file_error(result)); }
        return core::result::Ok(0);
    }
}

pub impl core::io::Read for File {
    pub fn read(&self, destination: [u8], offset: i32, count: i32) -> core::result::Result<i32, core::io::Error> {
        let descriptor: std::stream::Descriptor = std::stream::from_handle(self.handle);
        return descriptor.read(destination, offset, count);
    }
}

pub impl core::io::Write for File {
    pub fn write(&self, source: [u8], offset: i32, count: i32) -> core::result::Result<i32, core::io::Error> {
        let descriptor: std::stream::Descriptor = std::stream::from_handle(self.handle);
        return descriptor.write(source, offset, count);
    }
    pub fn flush(&self) -> core::result::Result<i32, core::io::Error> {
        if (self.handle < 0) { return core::result::Err(core::io::Error::Host(9)); }
        // No library buffer remains. This does not promise fsync or durability.
        return core::result::Ok(0);
    }
}

pub fn write_text_once(path: str, text: str) -> i32 {
    let handle: std::fs::FileHandle = std::fs::open_write_path(path);
    if (handle<0) {
        return handle;
    }
    let written: i32 = std::io::write_text(handle, text);
    let closed: i32 = std::fs::close_file(handle);
    if (written<0) {
        return written;
    }
    if (closed<0) {
        return closed;
    }
    return written;
}
// Read once into caller storage. Capacity must be between 1 and i32::MAX and
// buffer must cover that many writable bytes for this call. Returns the bytes
// read (possibly zero or short), or a negative value for invalid arguments,
// open, read, or close failure. Closing is attempted after a read failure.
pub fn read_once_into_buffer(path: str, buffer: ptr, capacity: usize) -> i32 {
    if (buffer == 0 || capacity == 0 || capacity>2147483647) {
        return -1;
    }
    let handle: i32 = std::fs::open_read_path(path);
    if (handle<0) {
        return handle;
    }
    let received: i32 = std::fs::read(handle, buffer, capacity);
    let closed: i32 = std::fs::close_file(handle);
    if (received<0) {
        return received;
    }
    if (closed<0) {
        return closed;
    }
    return received;
}
// Read exactly len bytes from a file into caller storage. A zero length still
// opens and closes the file, but does not access buffer. Invalid arguments,
// missing files, premature EOF, read errors, and close errors return false.
// A failure can leave a prefix in buffer. Extra file bytes are not consumed.
pub fn read_exact_into_buffer(path: str, buffer: ptr, len: usize) -> bool {
    if (len>2147483647 || buffer == 0 && len>0) {
        return false;
    }
    let handle: i32 = std::fs::open_read_path(path);
    if (handle<0) {
        return false;
    }
    let received: usize = 0;
    let complete: bool = true;
    while (received<len) {
        let cursor: ptr = buffer + received;
        let remaining: usize = len - received;
        let count: i32 = std::fs::read(handle, cursor, remaining);
        if (count <= 0) {
            complete = false;
            break;
        }
        let advanced: usize = count as usize;
        if (advanced>remaining) {
            complete = false;
            break;
        }
        received += advanced;
    }
    let closed: i32 = std::fs::close_file(handle);
    return complete && closed >= 0;
}
// Reads until EOF into caller storage. Returns the complete byte count,
// including zero for an empty file. A missing file, invalid buffer/capacity,
// read or close error, or input longer than capacity returns -1. A failure
// after reading may leave a prefix in buffer. Capacity zero with a null buffer
// accepts only an empty file. At a full buffer, a one-byte stack read checks
// for EOF without writing past caller storage. No allocation occurs.
pub fn read_to_end_into_buffer(path: str, buffer: ptr, capacity: usize) -> i32 {
    if (capacity>2147483647 || buffer == 0 && capacity>0) {
        return -1;
    }
    let handle: i32 = std::fs::open_read_path(path);
    if (handle<0) {
        return -1;
    }
    let received: usize = 0;
    let complete: bool = false;
    let valid: bool = true;
    while (received<capacity) {
        let cursor: ptr = buffer + received;
        let remaining: usize = capacity - received;
        let count: i32 = std::fs::read(handle, cursor, remaining);
        if (count<0) {
            valid = false;
            break;
        }
        if (count == 0) {
            complete = true;
            break;
        }
        let advanced: usize = count as usize;
        if (advanced>remaining) {
            valid = false;
            break;
        }
        received += advanced;
    }
    if (valid && !complete) {
        let probe: [i32; 1] = [0];
        let probe_ptr: ptr = core::mem::i32_array_data_ptr(probe);
        complete = std::fs::read(handle, probe_ptr, 1) == 0;
    }
    let closed: i32 = std::fs::close_file(handle);
    if (!valid || !complete || closed<0) {
        return -1;
    }
    let count: i32 = received as i32;
    return count;
}
// Write all len bytes to an open file handle, retrying short writes. A valid
// handle with len zero succeeds without accessing buffer. Invalid handles,
// null nonempty buffers, lengths above i32::MAX, host errors, and zero-progress
// writes return false. A failure can leave an already-written prefix.
pub fn write_all_bytes(handle: i32, buffer: ptr, len: usize) -> bool {
    if (handle<0 || len>2147483647 || buffer == 0 && len>0) {
        return false;
    }
    let sent: usize = 0;
    while (sent<len) {
        let cursor: ptr = buffer + sent;
        let remaining: usize = len - sent;
        let written: i32 = std::fs::write(handle, cursor, remaining);
        if (written <= 0) {
            return false;
        }
        let advanced: usize = written as usize;
        if (advanced>remaining) {
            return false;
        }
        sent += advanced;
    }
    return true;
}
// Creates or truncates path, writes all len bytes from caller storage, and
// closes the handle. Invalid buffer/length arguments fail before opening, so
// they do not truncate an existing file. A write or close error returns false;
// after opening, a failure may leave a truncated file or written prefix.
// A null buffer is allowed only when len is zero, which creates an empty file.
pub fn write_all_bytes_to_path(path: str, buffer: ptr, len: usize) -> bool {
    if (len>2147483647 || buffer == 0 && len>0) {
        return false;
    }
    let handle: i32 = std::fs::open_write_path(path);
    if (handle<0) {
        return false;
    }
    let written: bool = write_all_bytes(handle, buffer, len);
    let closed: i32 = std::fs::close_file(handle);
    return written && closed >= 0;
}
fn copy_open_files(input: i32, output: i32, buffer: ptr, capacity: usize) -> bool {
    while (true) {
        let received: i32 = std::fs::read(input, buffer, capacity);
        if (received<0) {
            return false;
        }
        if (received == 0) {
            return true;
        }
        let count: usize = received as usize;
        if (count>capacity || !write_all_bytes(output, buffer, count)) {
            return false;
        }
    }
    return false;
}
// Copies all bytes from an existing file into a newly truncated file using the
// caller's non-null buffer, which must point to at least `capacity` writable
// bytes for the whole call. The paths must refer to distinct files, including
// through aliases. Capacity must be between 1 and i32::MAX. False means an
// invalid argument, open, read, write, or close failure; the destination may
// contain a prefix after such a failure. Closing both handles is attempted.
pub fn copy_distinct_with_buffer(input_path: str, output_path: str, buffer: ptr, capacity: usize) -> bool {
    if (buffer == 0 || capacity == 0 || capacity>2147483647) {
        return false;
    }
    let input: i32 = std::fs::open_read_path(input_path);
    if (input<0) {
        return false;
    }
    let output: i32 = std::fs::open_write_path(output_path);
    if (output<0) {
        std::fs::close_file(input);
        return false;
    }
    let copied: bool = copy_open_files(input, output, buffer, capacity);
    let output_closed: i32 = std::fs::close_file(output);
    let input_closed: i32 = std::fs::close_file(input);
    return copied && output_closed >= 0 && input_closed >= 0;
}

// Copy an entire file to stdout through caller storage. Invalid buffer or
// capacity returns false before opening the source. Open, read, write, and
// close failures return false; stdout may contain a copied prefix. Capacity
// must be 1..=i32::MAX and buffer must cover that many writable bytes.
pub fn copy_file_to_stdout_with_buffer(path: str, buffer: ptr, capacity: usize) -> bool {
    if (buffer == 0 || capacity == 0 || capacity>2147483647) {
        return false;
    }
    let input: i32 = std::fs::open_read_path(path);
    if (input<0) {
        return false;
    }
    let copied: bool = true;
    while (true) {
        let received: i32 = std::fs::read(input, buffer, capacity);
        if (received<0) {
            copied = false;
            break;
        }
        if (received == 0) {
            break;
        }
        let count: usize = received as usize;
        if (count>capacity || !std::io_checked::write_all_stdout(buffer, count)) {
            copied = false;
            break;
        }
    }
    let closed: i32 = std::fs::close_file(input);
    return copied && closed >= 0;
}

// Create or truncate a file, copy stdin through caller storage, and close
// the file. Invalid storage or capacity returns false before opening, so an
// existing destination is left alone. Read, write, or close failure returns
// false and may leave a truncated file or copied prefix. Stdin stays open.
pub fn copy_stdin_to_file_with_buffer(path: str, buffer: ptr, capacity: usize) -> bool {
    if (buffer == 0 || capacity == 0 || capacity>2147483647) {
        return false;
    }
    let output: i32 = std::fs::open_write_path(path);
    if (output<0) {
        return false;
    }
    let copied: bool = true;
    while (true) {
        let received: i32 = std::io::read_stdin(buffer, capacity);
        if (received<0) {
            copied = false;
            break;
        }
        if (received == 0) {
            break;
        }
        let count: usize = received as usize;
        if (count>capacity || !write_all_bytes(output, buffer, count)) {
            copied = false;
            break;
        }
    }
    let closed: i32 = std::fs::close_file(output);
    return copied && closed >= 0;
}

// Reads an entire ASCII decimal file containing optional leading and trailing
// SP, HT, LF, or CR, an optional sign, and at least one digit. At most
// max_bytes input bytes are accepted. Missing files, invalid syntax, overflow,
// an overlong file, read/close failures, or max_bytes == 0 return fallback.
// The fallback may also be a valid parsed number. This x86 host helper uses a
// stack word as a one-byte read buffer; no allocation or string access occurs.
pub fn read_i32_decimal_or(path: str, max_bytes: u32, fallback: i32) -> i32 {
    if (max_bytes == 0) {
        return fallback;
    }
    let handle: i32 = std::fs::open_read_path(path);
    if (handle < 0) {
        return fallback;
    }
    let cell: [i32; 1] = [0];
    let data: ptr = core::mem::i32_array_data_ptr(cell);
    let consumed: u32 = 0;
    let magnitude: u32 = 0;
    let started: bool = false;
    let digits: bool = false;
    let trailing: bool = false;
    let negative: bool = false;
    let valid: bool = true;
    while (true) {
        cell[0] = 0;
        let received: i32 = std::fs::read(handle, data, 1);
        if (received == 0) {
            break;
        }
        if (received != 1 || consumed >= max_bytes) {
            valid = false;
            break;
        }
        consumed += 1;
        let byte: i32 = cell[0];
        if (byte == 32 || byte == 9 || byte == 10 || byte == 13) {
            if (started && !digits) {
                valid = false;
                break;
            }
            if (digits) {
                trailing = true;
            }
            continue;
        }
        if (byte == 43 || byte == 45) {
            if (started || trailing) {
                valid = false;
                break;
            }
            started = true;
            negative = byte == 45;
            continue;
        }
        if (byte >= 48 && byte <= 57) {
            if (trailing) {
                valid = false;
                break;
            }
            started = true;
            digits = true;
            let ascii: u8 = byte as u8;
            let limit: u32 = 2147483647;
            if (negative) {
                limit = 2147483648;
            }
            if (!core::decimal::can_append_ascii_digit_u32(magnitude, ascii, limit)) {
                valid = false;
                break;
            }
            magnitude = core::decimal::append_ascii_digit_or_u32(magnitude, ascii, limit, magnitude);
            continue;
        }
        valid = false;
        break;
    }
    let closed: i32 = std::fs::close_file(handle);
    if (!valid || !digits || closed < 0) {
        return fallback;
    }
    if (negative) {
        if (magnitude == 2147483648) {
            return -2147483648;
        }
        let positive: i32 = magnitude as i32;
        return -positive;
    }
    let positive: i32 = magnitude as i32;
    return positive;
}

// Reads a complete ASCII unsigned decimal file of at most max_bytes bytes.
// Leading and trailing SP, HT, LF, and CR and one leading plus are accepted;
// a minus, missing digit, embedded space, overflow, or overlong file is not.
// Open, read, and close failures also return fallback, which may itself be a
// valid parsed value. Uses one stack word for byte input and no allocation.
pub fn read_u32_decimal_or(path: str, max_bytes: u32, fallback: u32) -> u32 {
    if (max_bytes == 0) {
        return fallback;
    }
    let handle: i32 = std::fs::open_read_path(path);
    if (handle < 0) {
        return fallback;
    }
    let cell: [i32; 1] = [0];
    let data: ptr = core::mem::i32_array_data_ptr(cell);
    let consumed: u32 = 0;
    let value: u32 = 0;
    let started: bool = false;
    let digits: bool = false;
    let trailing: bool = false;
    let valid: bool = true;
    while (true) {
        cell[0] = 0;
        let received: i32 = std::fs::read(handle, data, 1);
        if (received == 0) {
            break;
        }
        if (received != 1 || consumed >= max_bytes) {
            valid = false;
            break;
        }
        consumed += 1;
        let byte: i32 = cell[0];
        if (byte == 32 || byte == 9 || byte == 10 || byte == 13) {
            if (started && !digits) {
                valid = false;
                break;
            }
            if (digits) {
                trailing = true;
            }
            continue;
        }
        if (byte == 43) {
            if (started || trailing) {
                valid = false;
                break;
            }
            started = true;
            continue;
        }
        if (byte >= 48 && byte <= 57) {
            if (trailing) {
                valid = false;
                break;
            }
            started = true;
            digits = true;
            let ascii: u8 = byte as u8;
            let limit: u32 = 4294967295;
            if (!core::decimal::can_append_ascii_digit_u32(value, ascii, limit)) {
                valid = false;
                break;
            }
            value = core::decimal::append_ascii_digit_or_u32(value, ascii, limit, value);
            continue;
        }
        valid = false;
        break;
    }
    let closed: i32 = std::fs::close_file(handle);
    if (!valid || !digits || closed<0) {
        return fallback;
    }
    return value;
}

fn append_wide_decimal_digit(
    value: core::wide_u64::WideU64, digit: u32
) -> core::wide_u64::WideU64 {
    return core::wide_u64::wrapping_add(
        core::wide_u64::wrapping_mul(value, core::wide_u64::from_u32(10)),
        core::wide_u64::from_u32(digit));
}

// Read an entire unsigned two-word decimal file. Surrounding SP, HT, LF, and
// CR and one leading plus are accepted. All failures return fallback, and an
// opened handle is always closed before returning.
pub fn read_wide_u64_decimal_or(
    path: str, max_bytes: u32, fallback: core::wide_u64::WideU64
) -> core::wide_u64::WideU64 {
    if (max_bytes == 0) { return fallback; }
    let handle: i32 = std::fs::open_read_path(path);
    if (handle < 0) { return fallback; }
    let cell: [i32; 1] = [0];
    let data: ptr = core::mem::i32_array_data_ptr(cell);
    let consumed: u32 = 0;
    let value: core::wide_u64::WideU64 = core::wide_u64::zero();
    let threshold: core::wide_u64::WideU64 =
        core::wide_u64::from_words(429496729, 2576980377); // u64::MAX / 10
    let started: bool = false;
    let digits: bool = false;
    let trailing: bool = false;
    let valid: bool = true;
    while (true) {
        cell[0] = 0;
        let received: i32 = std::fs::read(handle, data, 1);
        if (received == 0) { break; }
        if (received != 1 || consumed >= max_bytes) {
            valid = false;
            break;
        }
        consumed += 1;
        let byte: i32 = cell[0];
        if (byte == 32 || byte == 9 || byte == 10 || byte == 13) {
            if (started && !digits) { valid = false; break; }
            if (digits) { trailing = true; }
            continue;
        }
        if (byte == 43) {
            if (started || trailing) { valid = false; break; }
            started = true;
            continue;
        }
        if (byte >= 48 && byte <= 57) {
            if (trailing) { valid = false; break; }
            started = true;
            digits = true;
            let digit_i32: i32 = byte - 48;
            let digit: u32 = digit_i32 as u32;
            let order: i32 = core::wide_u64::compare(value, threshold);
            if (order > 0 || (order == 0 && digit > 5)) {
                valid = false;
                break;
            }
            value = append_wide_decimal_digit(value, digit);
            continue;
        }
        valid = false;
        break;
    }
    let closed: i32 = std::fs::close_file(handle);
    if (!valid || !digits || closed < 0) { return fallback; }
    return value;
}

// Signed form accepts one leading plus or minus. The negative magnitude may
// reach 2^63; positive input is capped at i64::MAX. Invalid input, a byte
// limit, or any host failure returns fallback after closing an open handle.
pub fn read_wide_i64_decimal_or(
    path: str, max_bytes: u32, fallback: core::wide_i64::WideI64
) -> core::wide_i64::WideI64 {
    if (max_bytes == 0) { return fallback; }
    let handle: i32 = std::fs::open_read_path(path);
    if (handle < 0) { return fallback; }
    let cell: [i32; 1] = [0];
    let data: ptr = core::mem::i32_array_data_ptr(cell);
    let consumed: u32 = 0;
    let magnitude: core::wide_u64::WideU64 = core::wide_u64::zero();
    let threshold: core::wide_u64::WideU64 =
        core::wide_u64::from_words(214748364, 3435973836); // 2^63 / 10
    let started: bool = false;
    let digits: bool = false;
    let trailing: bool = false;
    let negative: bool = false;
    let valid: bool = true;
    while (true) {
        cell[0] = 0;
        let received: i32 = std::fs::read(handle, data, 1);
        if (received == 0) { break; }
        if (received != 1 || consumed >= max_bytes) {
            valid = false;
            break;
        }
        consumed += 1;
        let byte: i32 = cell[0];
        if (byte == 32 || byte == 9 || byte == 10 || byte == 13) {
            if (started && !digits) { valid = false; break; }
            if (digits) { trailing = true; }
            continue;
        }
        if (byte == 43 || byte == 45) {
            if (started || trailing) { valid = false; break; }
            started = true;
            negative = byte == 45;
            continue;
        }
        if (byte >= 48 && byte <= 57) {
            if (trailing) { valid = false; break; }
            started = true;
            digits = true;
            let digit_i32: i32 = byte - 48;
            let digit: u32 = digit_i32 as u32;
            let last_digit: u32 = 7;
            if (negative) { last_digit = 8; }
            let order: i32 = core::wide_u64::compare(magnitude, threshold);
            if (order > 0 || (order == 0 && digit > last_digit)) {
                valid = false;
                break;
            }
            magnitude = append_wide_decimal_digit(magnitude, digit);
            continue;
        }
        valid = false;
        break;
    }
    let closed: i32 = std::fs::close_file(handle);
    if (!valid || !digits || closed < 0) { return fallback; }
    let value: core::wide_i64::WideI64 = core::wide_i64::from_words(
        core::wide_u64::high_word(magnitude), core::wide_u64::low_word(magnitude));
    if (negative) { return core::wide_i64::wrapping_neg(value); }
    return value;
}

// Creates or truncates path and writes the full signed decimal representation
// through single-byte writes. False reports open, write, or close failure; the
// file may already contain a decimal prefix. Closing is attempted after a
// failed write. No allocation or host integer formatter is used.
pub fn write_i32_decimal(path: str, value: i32) -> bool {
    let handle: i32 = std::fs::open_write_path(path);
    if (handle < 0) {
        return false;
    }
    let written: i32 = std::io_decimal::write_i32(handle, value);
    let closed: i32 = std::fs::close_file(handle);
    return written > 0 && closed >= 0;
}

// Creates or truncates path and writes the full unsigned decimal value with
// checked single-byte writes. Open, write, or close failure returns false;
// a failed write can leave a decimal prefix. No allocation occurs.
pub fn write_u32_decimal(path: str, value: u32) -> bool {
    let handle: i32 = std::fs::open_write_path(path);
    if (handle<0) {
        return false;
    }
    let written: i32 = std::io_decimal::write_u32(handle, value);
    let closed: i32 = std::fs::close_file(handle);
    return written > 0 && closed >= 0;
}

// Write a two-word unsigned value, closing even after a failed write. False
// reports open, write, or close failure; a prefix may remain in the file.
pub fn write_wide_u64_decimal(path: str, value: core::wide_u64::WideU64) -> bool {
    let handle: i32 = std::fs::open_write_path(path);
    if (handle < 0) { return false; }
    let written: i32 = std::io_decimal::write_wide_u64(handle, value);
    let closed: i32 = std::fs::close_file(handle);
    return written > 0 && closed >= 0;
}

// Signed form includes a minus for negative values and has the same failure
// and partial-file behavior as the unsigned writer.
pub fn write_wide_i64_decimal(path: str, value: core::wide_i64::WideI64) -> bool {
    let handle: i32 = std::fs::open_write_path(path);
    if (handle < 0) { return false; }
    let written: i32 = std::io_decimal::write_wide_i64(handle, value);
    let closed: i32 = std::fs::close_file(handle);
    return written > 0 && closed >= 0;
}

// Narrow decimal readers retain the 32-bit readers' complete-file syntax,
// byte limit, and open/read/close failure behavior. A value outside the
// destination range returns fallback instead of wrapping during conversion.
pub fn read_u8_decimal_or(path: str, max_bytes: u32, fallback: u8) -> u8 {
    let widened_fallback: u32 = fallback as u32;
    let value: u32 = read_u32_decimal_or(path, max_bytes, widened_fallback);
    if (value > 255) {
        return fallback;
    }
    return value as u8;
}

pub fn read_u16_decimal_or(path: str, max_bytes: u32, fallback: u16) -> u16 {
    let widened_fallback: u32 = fallback as u32;
    let value: u32 = read_u32_decimal_or(path, max_bytes, widened_fallback);
    if (value > 65535) {
        return fallback;
    }
    return value as u16;
}

pub fn read_i8_decimal_or(path: str, max_bytes: u32, fallback: i8) -> i8 {
    let widened_fallback: i32 = fallback as i32;
    let value: i32 = read_i32_decimal_or(path, max_bytes, widened_fallback);
    if (value < -128 || value > 127) {
        return fallback;
    }
    return value as i8;
}

pub fn read_i16_decimal_or(path: str, max_bytes: u32, fallback: i16) -> i16 {
    let widened_fallback: i32 = fallback as i32;
    let value: i32 = read_i32_decimal_or(path, max_bytes, widened_fallback);
    if (value < -32768 || value > 32767) {
        return fallback;
    }
    return value as i16;
}

// Narrow writers preserve the full output and first-failure behavior of the
// corresponding 32-bit file writer. Failure may leave a truncated file or
// decimal prefix after opening the destination.
pub fn write_u8_decimal(path: str, value: u8) -> bool {
    let widened: u32 = value as u32;
    return write_u32_decimal(path, widened);
}

pub fn write_u16_decimal(path: str, value: u16) -> bool {
    let widened: u32 = value as u32;
    return write_u32_decimal(path, widened);
}

pub fn write_i8_decimal(path: str, value: i8) -> bool {
    let widened: i32 = value as i32;
    return write_i32_decimal(path, widened);
}

pub fn write_i16_decimal(path: str, value: i16) -> bool {
    let widened: i32 = value as i32;
    return write_i32_decimal(path, widened);
}
