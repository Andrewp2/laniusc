// Owned UTF-8 text built from std::vec_u8's caller-owned byte cells.
// Each byte occupies one 32-bit allocation cell. The caller keeps only the
// newest returned VecU8 and destroys it once; moves are not enforced yet.
// Read-only functions validate the complete byte sequence before answering.
module std::utf8_vec;
import std::vec_u8;
import core::mem;
import core::utf8;

pub fn new() -> std::vec_u8::VecU8 {
    return std::vec_u8::new();
}

pub fn byte_len(value: std::vec_u8::VecU8) -> i32 {
    return std::vec_u8::len(value);
}

pub fn is_empty(value: std::vec_u8::VecU8) -> bool {
    return std::vec_u8::is_empty(value);
}

pub fn is_valid(value: std::vec_u8::VecU8) -> bool {
    let len: i32 = std::vec_u8::len(value);
    let cells: [i32] = core::mem::i32_slice_from_raw_parts(std::vec_u8::data_ptr(value), len);
    return core::utf8::codes_are_valid(cells, len);
}

// Make an independent owned copy of valid UTF-8 text. The source remains
// live and must be destroyed separately from a successful copy. Malformed
// text or allocation failure returns a new empty vector without changing the
// source. For nonempty text, compare byte_len(result) with byte_len(value) to
// detect success. Empty text clones without allocating.
pub fn try_clone(value: std::vec_u8::VecU8) -> std::vec_u8::VecU8 {
    if (!is_valid(value)) {
        return new();
    }
    return std::vec_u8::try_clone(value);
}

// Invalid UTF-8 returns fallback; the empty text has zero scalars. A caller
// fallback may equal a valid count, so call is_valid when that matters.
pub fn scalar_count_or(value: std::vec_u8::VecU8, fallback: i32) -> i32 {
    let len: i32 = std::vec_u8::len(value);
    let cells: [i32] = core::mem::i32_slice_from_raw_parts(std::vec_u8::data_ptr(value), len);
    return core::utf8::scalar_count_or(cells, len, fallback);
}

// Invalid UTF-8 and out-of-range indices return fallback. A fallback may
// equal a valid scalar value.
pub fn scalar_at_or(value: std::vec_u8::VecU8, index: i32, fallback: u32) -> u32 {
    let len: i32 = std::vec_u8::len(value);
    let cells: [i32] = core::mem::i32_slice_from_raw_parts(std::vec_u8::data_ptr(value), len);
    return core::utf8::scalar_at_or(cells, len, index, fallback);
}

pub fn index_of_scalar_or(value: std::vec_u8::VecU8, needle: u32, fallback: i32) -> i32 {
    let len: i32 = std::vec_u8::len(value);
    let cells: [i32] = core::mem::i32_slice_from_raw_parts(std::vec_u8::data_ptr(value), len);
    return core::utf8::index_of_scalar_or(cells, len, needle, fallback);
}

pub fn last_index_of_scalar_or(value: std::vec_u8::VecU8, needle: u32, fallback: i32) -> i32 {
    let len: i32 = std::vec_u8::len(value);
    let cells: [i32] = core::mem::i32_slice_from_raw_parts(std::vec_u8::data_ptr(value), len);
    return core::utf8::last_index_of_scalar_or(cells, len, needle, fallback);
}

// Append one Unicode scalar atomically. Invalid existing UTF-8, an invalid
// scalar, capacity overflow, or allocation failure leaves the vector and its
// bytes unchanged. A successful append increases byte_len by one to four.
pub fn try_append_scalar(value: std::vec_u8::VecU8, scalar: u32) -> std::vec_u8::VecU8 {
    let width_u32: u32 = core::utf8::encoded_len_or(scalar, 0);
    if (width_u32 == 0 || !is_valid(value)) {
        return value;
    }
    let width: i32 = width_u32 as i32;
    let length: i32 = std::vec_u8::len(value);
    if (length > std::vec_u8::MAX_CAPACITY - width) {
        return value;
    }
    let needed: i32 = length + width;
    let grown: std::vec_u8::VecU8 = value;
    let current_capacity: i32 = std::vec_u8::capacity(grown);
    if (current_capacity < needed) {
        let target: i32 = 4;
        if (current_capacity > 0) {
            if (current_capacity > std::vec_u8::MAX_CAPACITY / 2) {
                target = std::vec_u8::MAX_CAPACITY;
            } else {
                target = current_capacity * 2;
            }
        }
        if (target < needed) {
            target = needed;
        }
        grown = std::vec_u8::try_reserve(grown, target);
        if (std::vec_u8::capacity(grown) < needed) {
            return value;
        }
    }
    let index: u32 = 0;
    while (index < width_u32) {
        let byte: u8 = core::utf8::encoded_byte_or(scalar, index, 0);
        grown = std::vec_u8::try_push(grown, byte);
        index += 1;
    }
    return grown;
}

// Append count Unicode scalars after validating the complete old text and
// every requested scalar. Reserve all bytes before the first write. A negative
// count, invalid scalar, capacity overflow, or allocation failure returns the
// original value unchanged. The caller must back count input scalars; an
// overclaim may trap. Input storage must not alias this vector's allocation,
// since growth can move it.
pub fn try_append_scalars(
    value: std::vec_u8::VecU8, scalars: [u32], count: i32
) -> std::vec_u8::VecU8 {
    if (count < 0 || !is_valid(value)) {
        return value;
    }
    let length: i32 = std::vec_u8::len(value);
    let remaining: i32 = std::vec_u8::MAX_CAPACITY - length;
    let extra: i32 = 0;
    let index: i32 = 0;
    while (index < count) {
        let width_u32: u32 = core::utf8::encoded_len_or(scalars[index], 0);
        if (width_u32 == 0) {
            return value;
        }
        let width: i32 = width_u32 as i32;
        if (width > remaining - extra) {
            return value;
        }
        extra += width;
        index += 1;
    }
    if (extra == 0) {
        return value;
    }
    let needed: i32 = length + extra;
    let grown: std::vec_u8::VecU8 = value;
    let current_capacity: i32 = std::vec_u8::capacity(grown);
    if (current_capacity < needed) {
        let target: i32 = 4;
        if (current_capacity > 0) {
            if (current_capacity > std::vec_u8::MAX_CAPACITY / 2) {
                target = std::vec_u8::MAX_CAPACITY;
            } else {
                target = current_capacity * 2;
            }
        }
        if (target < needed) {
            target = needed;
        }
        grown = std::vec_u8::try_reserve(grown, target);
        if (std::vec_u8::capacity(grown) < needed) {
            return value;
        }
    }
    index = 0;
    while (index < count) {
        let scalar: u32 = scalars[index];
        let width: u32 = core::utf8::encoded_len_or(scalar, 0);
        let byte_index: u32 = 0;
        while (byte_index < width) {
            let byte: u8 = core::utf8::encoded_byte_or(scalar, byte_index, 0);
            grown = std::vec_u8::try_push(grown, byte);
            byte_index += 1;
        }
        index += 1;
    }
    return grown;
}

// Append an existing complete UTF-8 byte-code view. Both the old text and
// source must be valid before reserving and writing; each source element must
// be in 0..=255. Invalid text, negative length, malformed source, capacity
// overflow, or allocation failure leaves the vector unchanged. The source
// must physically back len elements and must not alias this vector's storage,
// since growth can move the allocation. An overclaimed view may trap.
pub fn try_append_codes(
    value: std::vec_u8::VecU8, codes: [i32], len: i32
) -> std::vec_u8::VecU8 {
    if (len < 0 || !is_valid(value) || !core::utf8::codes_are_valid(codes, len)) {
        return value;
    }
    if (len == 0) {
        return value;
    }
    let old_len: i32 = std::vec_u8::len(value);
    if (old_len > std::vec_u8::MAX_CAPACITY - len) {
        return value;
    }
    let needed: i32 = old_len + len;
    let grown: std::vec_u8::VecU8 = value;
    let current_capacity: i32 = std::vec_u8::capacity(grown);
    if (current_capacity < needed) {
        let target: i32 = 4;
        if (current_capacity > 0) {
            if (current_capacity > std::vec_u8::MAX_CAPACITY / 2) {
                target = std::vec_u8::MAX_CAPACITY;
            } else {
                target = current_capacity * 2;
            }
        }
        if (target < needed) {
            target = needed;
        }
        grown = std::vec_u8::try_reserve(grown, target);
        if (std::vec_u8::capacity(grown) < needed) {
            return value;
        }
    }
    let index: i32 = 0;
    while (index < len) {
        let raw_byte: i32 = codes[index];
        let byte: u8 = raw_byte as u8;
        grown = std::vec_u8::try_push(grown, byte);
        index += 1;
    }
    return grown;
}

// Append a complete UTF-8 sequence from ordinary caller-backed byte storage.
// Invalid source or existing text, negative length, capacity overflow, and
// allocation failure leave the vector unchanged. A successful nonempty append
// increases byte_len by len. The source must back len elements and must not
// alias this vector's allocation because growth can move that allocation.
// Overclaimed input may trap while validating it.
pub fn try_append_bytes(
    value: std::vec_u8::VecU8, bytes: [u8], len: i32
) -> std::vec_u8::VecU8 {
    if (!is_valid(value) || !core::utf8::bytes_are_valid(bytes, len)) {
        return value;
    }
    return std::vec_u8::try_extend_from_slice(value, bytes, len);
}

// Insert a scalar before scalar_index, including at the end. Validate the
// complete old text and reserve the entire encoding before changing bytes.
// Invalid text, index, scalar, capacity, or allocation returns the original
// value unchanged. Success increases byte_len by the scalar's encoded width.
pub fn try_insert_scalar(
    value: std::vec_u8::VecU8, scalar_index: i32, scalar: u32
) -> std::vec_u8::VecU8 {
    let width_u32: u32 = core::utf8::encoded_len_or(scalar, 0);
    if (width_u32 == 0) {
        return value;
    }
    let length: i32 = std::vec_u8::len(value);
    let old_cells: [i32] = core::mem::i32_slice_from_raw_parts(std::vec_u8::data_ptr(value), length);
    let offset: i32 = core::utf8::byte_offset_of_scalar_or(old_cells, length, scalar_index, -1);
    if (offset < 0) {
        return value;
    }
    let width: i32 = width_u32 as i32;
    if (length > std::vec_u8::MAX_CAPACITY - width) {
        return value;
    }
    let needed: i32 = length + width;
    let grown: std::vec_u8::VecU8 = std::vec_u8::try_reserve(value, needed);
    if (std::vec_u8::capacity(grown) < needed) {
        return value;
    }
    let index: i32 = 0;
    while (index < width) {
        grown = std::vec_u8::try_push(grown, 0);
        index += 1;
    }
    let cells: [i32] = core::mem::i32_slice_from_raw_parts(std::vec_u8::data_ptr(grown), needed);
    let cursor: i32 = length;
    while (cursor > offset) {
        cursor -= 1;
        cells[cursor + width] = cells[cursor];
    }
    let byte_index: u32 = 0;
    while (byte_index < width_u32) {
        let encoded: u8 = core::utf8::encoded_byte_or(scalar, byte_index, 0);
        let target: i32 = byte_index as i32;
        let code: i32 = encoded as i32;
        cells[offset + target] = code;
        byte_index += 1;
    }
    return grown;
}

// Insert a complete UTF-8 byte-code view before scalar_index, including at
// the end. Validate both full sequences, their bounds, and required capacity
// before moving any bytes. Invalid input or allocation failure leaves value
// unchanged. The source must physically back len cells and must not alias the
// vector allocation; growth can move it, and an overclaimed view may trap.
pub fn try_insert_codes(
    value: std::vec_u8::VecU8, scalar_index: i32, codes: [i32], len: i32
) -> std::vec_u8::VecU8 {
    if (len < 0 || !core::utf8::codes_are_valid(codes, len)) {
        return value;
    }
    let old_len: i32 = std::vec_u8::len(value);
    let old_cells: [i32] = core::mem::i32_slice_from_raw_parts(
        std::vec_u8::data_ptr(value), old_len);
    let offset: i32 = core::utf8::byte_offset_of_scalar_or(
        old_cells, old_len, scalar_index, -1);
    if (offset < 0 || len == 0) {
        return value;
    }
    if (old_len > std::vec_u8::MAX_CAPACITY - len) {
        return value;
    }
    let needed: i32 = old_len + len;
    let grown: std::vec_u8::VecU8 = std::vec_u8::try_reserve(value, needed);
    if (std::vec_u8::capacity(grown) < needed) {
        return value;
    }
    let index: i32 = 0;
    while (index < len) {
        grown = std::vec_u8::try_push(grown, 0);
        index += 1;
    }
    let cells: [i32] = core::mem::i32_slice_from_raw_parts(
        std::vec_u8::data_ptr(grown), needed);
    let cursor: i32 = old_len;
    while (cursor > offset) {
        cursor -= 1;
        cells[cursor + len] = cells[cursor];
    }
    index = 0;
    while (index < len) {
        cells[offset + index] = codes[index];
        index += 1;
    }
    return grown;
}

// Remove one scalar at scalar_index and close the byte gap. Invalid text or
// an out-of-range index returns the original vector unchanged. Removal keeps
// the allocation for reuse, and success decreases byte_len by one to four.
pub fn try_remove_scalar(
    value: std::vec_u8::VecU8, scalar_index: i32
) -> std::vec_u8::VecU8 {
    let length: i32 = std::vec_u8::len(value);
    let cells: [i32] = core::mem::i32_slice_from_raw_parts(std::vec_u8::data_ptr(value), length);
    let start: i32 = core::utf8::byte_offset_of_scalar_or(cells, length, scalar_index, -1);
    if (start < 0 || start >= length) {
        return value;
    }
    let end: i32 = core::utf8::byte_offset_of_scalar_or(cells, length, scalar_index + 1, -1);
    if (end <= start || end > length) {
        return value;
    }
    let read: i32 = end;
    let write: i32 = start;
    while (read < length) {
        cells[write] = cells[read];
        read += 1;
        write += 1;
    }
    let shortened: std::vec_u8::VecU8 = value;
    let width: i32 = end - start;
    let index: i32 = 0;
    while (index < width) {
        shortened = std::vec_u8::try_pop(shortened);
        index += 1;
    }
    return shortened;
}

// Remove count complete Unicode scalars starting at scalar_index. Both ends
// must be valid scalar boundaries in the complete old text. Invalid text,
// negative indices or counts, and out-of-range requests leave value and its
// bytes unchanged. A valid zero-count range is an unchanged success. Removal
// does not allocate and keeps capacity for reuse.
pub fn try_remove_scalar_range(
    value: std::vec_u8::VecU8, scalar_index: i32, count: i32
) -> std::vec_u8::VecU8 {
    let length: i32 = std::vec_u8::len(value);
    let cells: [i32] = core::mem::i32_slice_from_raw_parts(
        std::vec_u8::data_ptr(value), length);
    let scalar_count: i32 = core::utf8::scalar_count_or(cells, length, -1);
    if (scalar_count < 0 || scalar_index < 0 || scalar_index > scalar_count ||
        count < 0 || count > scalar_count - scalar_index) {
        return value;
    }
    if (count == 0) {
        return value;
    }
    let start: i32 = core::utf8::byte_offset_of_scalar_or(
        cells, length, scalar_index, -1);
    let end: i32 = core::utf8::byte_offset_of_scalar_or(
        cells, length, scalar_index + count, -1);
    if (start < 0 || end <= start || end > length) {
        return value;
    }
    let read: i32 = end;
    let write: i32 = start;
    while (read < length) {
        cells[write] = cells[read];
        read += 1;
        write += 1;
    }
    let shortened: std::vec_u8::VecU8 = value;
    let width: i32 = end - start;
    let index: i32 = 0;
    while (index < width) {
        shortened = std::vec_u8::try_pop(shortened);
        index += 1;
    }
    return shortened;
}

// Replace remove_count complete scalars at scalar_index with a complete
// caller-backed UTF-8 byte-code view. A zero count inserts at the boundary;
// zero source length removes the selected range. Validate both sequences,
// bounds, and final capacity before changing bytes. Invalid input or failed
// growth leaves the original vector unchanged. The source must physically
// back codes_len cells and be disjoint from this vector's allocation even
// when no growth is needed; shifting can overwrite aliased source cells.
// A successful same-width replacement keeps byte_len, so callers needing a
// success distinction must inspect the selected text after the call.
pub fn try_splice_codes(
    value: std::vec_u8::VecU8, scalar_index: i32, remove_count: i32,
    codes: [i32], codes_len: i32
) -> std::vec_u8::VecU8 {
    if (codes_len < 0 || codes_len > std::vec_u8::MAX_CAPACITY ||
        !core::utf8::codes_are_valid(codes, codes_len)) {
        return value;
    }
    let old_len: i32 = std::vec_u8::len(value);
    let old_cells: [i32] = core::mem::i32_slice_from_raw_parts(
        std::vec_u8::data_ptr(value), old_len);
    let scalar_count: i32 = core::utf8::scalar_count_or(old_cells, old_len, -1);
    if (scalar_count < 0 || scalar_index < 0 || scalar_index > scalar_count ||
        remove_count < 0 || remove_count > scalar_count - scalar_index) {
        return value;
    }
    if (remove_count == 0 && codes_len == 0) {
        return value;
    }
    let start: i32 = core::utf8::byte_offset_of_scalar_or(
        old_cells, old_len, scalar_index, -1);
    let end: i32 = core::utf8::byte_offset_of_scalar_or(
        old_cells, old_len, scalar_index + remove_count, -1);
    if (start < 0 || end < start || end > old_len) {
        return value;
    }
    let removed_bytes: i32 = end - start;
    let kept_bytes: i32 = old_len - removed_bytes;
    if (kept_bytes > std::vec_u8::MAX_CAPACITY - codes_len) {
        return value;
    }
    let needed: i32 = kept_bytes + codes_len;
    let changed: std::vec_u8::VecU8 = value;
    if (codes_len > removed_bytes) {
        let extra: i32 = codes_len - removed_bytes;
        changed = std::vec_u8::try_reserve(changed, needed);
        if (std::vec_u8::capacity(changed) < needed) {
            return value;
        }
        let index: i32 = 0;
        while (index < extra) {
            changed = std::vec_u8::try_push(changed, 0);
            index += 1;
        }
        let cells: [i32] = core::mem::i32_slice_from_raw_parts(
            std::vec_u8::data_ptr(changed), needed);
        let cursor: i32 = old_len;
        while (cursor > end) {
            cursor -= 1;
            cells[cursor + extra] = cells[cursor];
        }
    } else {
        if (codes_len < removed_bytes) {
            let cells: [i32] = core::mem::i32_slice_from_raw_parts(
                std::vec_u8::data_ptr(changed), old_len);
            let read: i32 = end;
            let write: i32 = start + codes_len;
            while (read < old_len) {
                cells[write] = cells[read];
                read += 1;
                write += 1;
            }
            let excess: i32 = removed_bytes - codes_len;
            let index: i32 = 0;
            while (index < excess) {
                changed = std::vec_u8::try_pop(changed);
                index += 1;
            }
        }
    }
    let current_cells: [i32] = core::mem::i32_slice_from_raw_parts(
        std::vec_u8::data_ptr(changed), needed);
    let index: i32 = 0;
    while (index < codes_len) {
        current_cells[start + index] = codes[index];
        index += 1;
    }
    return changed;
}

// Replace one existing scalar with another, shifting bytes when their UTF-8
// widths differ. Validate the complete old text and the new scalar first.
// Invalid text, index, scalar, capacity, or allocation returns the original
// vector unchanged. Successful equal-width replacement keeps byte_len, so
// read the selected scalar when the caller must distinguish it from failure.
pub fn try_replace_scalar(
    value: std::vec_u8::VecU8, scalar_index: i32, scalar: u32
) -> std::vec_u8::VecU8 {
    let new_width_u32: u32 = core::utf8::encoded_len_or(scalar, 0);
    if (new_width_u32 == 0) {
        return value;
    }
    let length: i32 = std::vec_u8::len(value);
    let old_cells: [i32] = core::mem::i32_slice_from_raw_parts(std::vec_u8::data_ptr(value), length);
    let start: i32 = core::utf8::byte_offset_of_scalar_or(old_cells, length, scalar_index, -1);
    if (start < 0 || start >= length) {
        return value;
    }
    let end: i32 = core::utf8::byte_offset_of_scalar_or(old_cells, length, scalar_index + 1, -1);
    if (end <= start || end > length) {
        return value;
    }
    let new_width: i32 = new_width_u32 as i32;
    let old_width: i32 = end - start;
    let changed: std::vec_u8::VecU8 = value;
    if (new_width > old_width) {
        let extra: i32 = new_width - old_width;
        if (length > std::vec_u8::MAX_CAPACITY - extra) {
            return value;
        }
        let needed: i32 = length + extra;
        changed = std::vec_u8::try_reserve(changed, needed);
        if (std::vec_u8::capacity(changed) < needed) {
            return value;
        }
        let index: i32 = 0;
        while (index < extra) {
            changed = std::vec_u8::try_push(changed, 0);
            index += 1;
        }
        let cells: [i32] = core::mem::i32_slice_from_raw_parts(std::vec_u8::data_ptr(changed), needed);
        let cursor: i32 = length;
        while (cursor > end) {
            cursor -= 1;
            cells[cursor + extra] = cells[cursor];
        }
    } else {
        if (new_width < old_width) {
            let cells: [i32] = core::mem::i32_slice_from_raw_parts(std::vec_u8::data_ptr(changed), length);
            let read: i32 = end;
            let write: i32 = start + new_width;
            while (read < length) {
                cells[write] = cells[read];
                read += 1;
                write += 1;
            }
            let excess: i32 = old_width - new_width;
            let index: i32 = 0;
            while (index < excess) {
                changed = std::vec_u8::try_pop(changed);
                index += 1;
            }
        }
    }
    let current_len: i32 = std::vec_u8::len(changed);
    let current_cells: [i32] = core::mem::i32_slice_from_raw_parts(std::vec_u8::data_ptr(changed), current_len);
    let byte_index: u32 = 0;
    while (byte_index < new_width_u32) {
        let encoded: u8 = core::utf8::encoded_byte_or(scalar, byte_index, 0);
        let target: i32 = byte_index as i32;
        let code: i32 = encoded as i32;
        current_cells[start + target] = code;
        byte_index += 1;
    }
    return changed;
}

// Remove the final Unicode scalar without freeing capacity. Empty or invalid
// UTF-8 leaves the value unchanged.
pub fn try_pop_scalar(value: std::vec_u8::VecU8) -> std::vec_u8::VecU8 {
    let len: i32 = std::vec_u8::len(value);
    let cells: [i32] = core::mem::i32_slice_from_raw_parts(std::vec_u8::data_ptr(value), len);
    let count: i32 = core::utf8::scalar_count_or(cells, len, -1);
    if (count <= 0) {
        return value;
    }
    let start: i32 = core::utf8::byte_offset_of_scalar_or(cells, len, count - 1, -1);
    let shortened: std::vec_u8::VecU8 = value;
    while (std::vec_u8::len(shortened) > start) {
        shortened = std::vec_u8::try_pop(shortened);
    }
    return shortened;
}

// Invalid input makes predicates false, including two identical malformed
// vectors. Empty prefixes and suffixes match every valid vector.
pub fn equal(left: std::vec_u8::VecU8, right: std::vec_u8::VecU8) -> bool {
    let left_len: i32 = std::vec_u8::len(left);
    let right_len: i32 = std::vec_u8::len(right);
    let left_cells: [i32] = core::mem::i32_slice_from_raw_parts(std::vec_u8::data_ptr(left), left_len);
    let right_cells: [i32] = core::mem::i32_slice_from_raw_parts(std::vec_u8::data_ptr(right), right_len);
    return core::utf8::equal_codes(left_cells, left_len, right_cells, right_len);
}

pub fn starts_with(value: std::vec_u8::VecU8, prefix: std::vec_u8::VecU8) -> bool {
    let len: i32 = std::vec_u8::len(value);
    let prefix_len: i32 = std::vec_u8::len(prefix);
    let cells: [i32] = core::mem::i32_slice_from_raw_parts(std::vec_u8::data_ptr(value), len);
    let prefix_cells: [i32] = core::mem::i32_slice_from_raw_parts(std::vec_u8::data_ptr(prefix), prefix_len);
    return core::utf8::starts_with_codes(cells, len, prefix_cells, prefix_len);
}

pub fn ends_with(value: std::vec_u8::VecU8, suffix: std::vec_u8::VecU8) -> bool {
    let len: i32 = std::vec_u8::len(value);
    let suffix_len: i32 = std::vec_u8::len(suffix);
    let cells: [i32] = core::mem::i32_slice_from_raw_parts(std::vec_u8::data_ptr(value), len);
    let suffix_cells: [i32] = core::mem::i32_slice_from_raw_parts(std::vec_u8::data_ptr(suffix), suffix_len);
    return core::utf8::ends_with_codes(cells, len, suffix_cells, suffix_len);
}

// Valid UTF-8 compares lexicographically as -1, 0, or 1. Invalid UTF-8
// returns fallback, which should be outside that result set when needed.
pub fn compare_or(left: std::vec_u8::VecU8, right: std::vec_u8::VecU8, fallback: i32) -> i32 {
    let left_len: i32 = std::vec_u8::len(left);
    let right_len: i32 = std::vec_u8::len(right);
    let left_cells: [i32] = core::mem::i32_slice_from_raw_parts(std::vec_u8::data_ptr(left), left_len);
    let right_cells: [i32] = core::mem::i32_slice_from_raw_parts(std::vec_u8::data_ptr(right), right_len);
    return core::utf8::compare_codes_or(left_cells, left_len, right_cells, right_len, fallback);
}

// First or last byte offset of a valid complete UTF-8 needle. Invalid or
// missing input returns fallback. An empty needle matches at 0 or byte_len.
pub fn index_of_byte_or(value: std::vec_u8::VecU8, needle: std::vec_u8::VecU8, fallback: i32) -> i32 {
    let len: i32 = std::vec_u8::len(value);
    let needle_len: i32 = std::vec_u8::len(needle);
    let cells: [i32] = core::mem::i32_slice_from_raw_parts(std::vec_u8::data_ptr(value), len);
    let needle_cells: [i32] = core::mem::i32_slice_from_raw_parts(std::vec_u8::data_ptr(needle), needle_len);
    return core::utf8::index_of_codes_byte_or(cells, len, needle_cells, needle_len, fallback);
}

pub fn last_index_of_byte_or(value: std::vec_u8::VecU8, needle: std::vec_u8::VecU8, fallback: i32) -> i32 {
    let len: i32 = std::vec_u8::len(value);
    let needle_len: i32 = std::vec_u8::len(needle);
    let cells: [i32] = core::mem::i32_slice_from_raw_parts(std::vec_u8::data_ptr(value), len);
    let needle_cells: [i32] = core::mem::i32_slice_from_raw_parts(std::vec_u8::data_ptr(needle), needle_len);
    return core::utf8::last_index_of_codes_byte_or(cells, len, needle_cells, needle_len, fallback);
}

pub fn clear(value: std::vec_u8::VecU8) -> std::vec_u8::VecU8 {
    return std::vec_u8::clear(value);
}

pub fn destroy(value: std::vec_u8::VecU8) {
    std::vec_u8::destroy(value);
}
