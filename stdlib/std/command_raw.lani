// Internal Linux x86_64 command syscalls. No allocation or host libc calls.
module std::command_raw;
import core::mem;
import core::result;
import core::slice;
import std::linux;
fn syscall_error(error: std::linux::Error) -> i64 { return match(error) { std::linux::Error::System(n) -> 0-(n as i64), _ -> -22 }; }
fn invoke(number: i64, a: std::linux::Argument, b: std::linux::Argument, c: std::linux::Argument, d: std::linux::Argument) -> i64 {
    let args: [std::linux::Argument;4] = [a,b,c,d]; let value: core::result::Result<i64,std::linux::Error> = std::linux::call(number,core::slice::view(args,4).unwrap());
    if (value.is_err()) { return syscall_error(value.unwrap_err()); } return value.unwrap();
}
pub fn word(number: i64, a: i64, b: i64, c: i64) -> i64 { return invoke(number,std::linux::Argument::Word(a),std::linux::Argument::Word(b),std::linux::Argument::Word(c),std::linux::Argument::Word(0)); }
pub fn pointer(number: i64, a: i64, p: ptr, c: i64) -> i64 { return invoke(number,std::linux::Argument::Word(a),std::linux::Argument::Address(p),std::linux::Argument::Word(c),std::linux::Argument::Word(0)); }
pub fn close(fd: i32) -> i32 { if (fd < 0) { return 0; } return word(3,fd as i64,0,0) as i32; }
pub fn duplicate(fd: i32) -> i32 { let n: i64 = -4; while (n == -4) { n = word(72,fd as i64,1030,3); } return n as i32; }
pub fn normalize(fd: i32) -> i32 { if (fd >= 3) { return fd; } let n: i32 = duplicate(fd); close(fd); return n; }
pub fn make_pipe(pair: [i32]) -> i32 {
    let n: i64 = -4;
    while (n == -4) { n = invoke(293,std::linux::Argument::Address(core::mem::i32_slice_data_ptr(pair)),std::linux::Argument::Word(524288),std::linux::Argument::Word(0),std::linux::Argument::Word(0)); }
    if (n < 0) { return n as i32; }
    let first: i32 = normalize(pair[0]); if (first < 0) { close(pair[1]); pair[0] = -1; pair[1] = -1; return first; }
    let second: i32 = normalize(pair[1]); if (second < 0) { close(first); pair[0] = -1; pair[1] = -1; return second; }
    pair[0] = first; pair[1] = second; return 0;
}
pub fn null_fd(write: bool) -> i32 {
    let storage: [i32;3] = [0;3]; let p = core::mem::i32_array_data_ptr(storage); let raw: [u8] = core::mem::typed_slice_from_raw_parts(p,12); let name: [u8] = core::mem::typed_slice_from_raw_parts(core::mem::string_data_ptr("/dev/null"),9); let i: i32 = 0; while (i < 9) { raw[i] = name[i]; i += 1; }
    let flags: i64 = 524288; if (write) { flags += 1; } let n: i64 = -4; while (n == -4) { n = invoke(257,std::linux::Argument::Word(-100),std::linux::Argument::Address(p),std::linux::Argument::Word(flags),std::linux::Argument::Word(0)); }
    if (n < 0) { return n as i32; } return normalize(n as i32);
}
pub fn fork() -> i64 { return word(57,0,0,0); }
pub fn wait(pid: i32, status: ptr, nonblocking: bool) -> i64 { if (nonblocking) { return pointer(61,pid as i64,status,1); } let n: i64 = -4; while (n == -4) { n = pointer(61,pid as i64,status,0); } return n; }
pub fn change_dir(path: ptr) -> i64 { return invoke(80,std::linux::Argument::Address(path),std::linux::Argument::Word(0),std::linux::Argument::Word(0),std::linux::Argument::Word(0)); }
pub fn execute(path: ptr, argv: ptr, env: ptr) -> i64 { return invoke(59,std::linux::Argument::Address(path),std::linux::Argument::Address(argv),std::linux::Argument::Address(env),std::linux::Argument::Word(0)); }
pub fn store_pointer(slot: ptr, value: ptr) { let target: [ptr] = core::mem::typed_slice_from_raw_parts(slot,1); target[0] = value; }
pub fn terminate() { while (true) { word(231,127,0,0); } }
