// Checked secure randomness built on the status-returning host operation.
// No valid u32 bit pattern is reserved as an error value. Call
// fill_secure_exact to distinguish failure from a legitimate random result
// that equals the fallback supplied to secure_u32_or.
module std::random_checked;
import core::mem;
import std::random;
// Fill exactly len bytes of caller storage, retrying short host reads. Zero
// length succeeds without accessing buffer. A null nonempty buffer, length
// above i32::MAX, host error, zero-progress read, or impossible host count
// returns false. A failure after partial progress may leave random bytes in a
// prefix. The caller must keep len writable bytes alive for the full call.
pub fn fill_secure_exact(buffer: ptr, len: usize) -> bool {
    if (len>2147483647 || buffer == 0 && len>0) {
        return false;
    }
    let filled: usize = 0;
    while (filled<len) {
        let cursor: ptr = buffer + filled;
        let remaining: usize = len - filled;
        let received: i32 = std::random::fill_secure_bytes(cursor, remaining);
        if (received <= 0) {
            return false;
        }
        let advanced: usize = received;
        if (advanced>remaining) {
            return false;
        }
        filled += advanced;
    }
    return true;
}
// Return four secure bytes in native u32 order, or fallback on failure.
pub fn secure_u32_or(fallback: u32) -> u32 {
    let word:[i32; 1] =[0];
    let data: ptr = core::mem::i32_array_data_ptr(word);
    if (!fill_secure_exact(data, 4)) {
        return fallback;
    }
    let signed: i32 = word[0];
    let bits: u32 = signed as u32;
    return bits;
}

// Return a uniformly sampled value in [0, bound), or fallback if bound is zero
// or the host fails. Bound one returns zero without reading the host. For
// larger bounds, rejection sampling removes the modulo bias from a 32-bit
// random word. The caller's fallback may itself lie in the valid range.
pub fn secure_u32_below_or(bound: u32, fallback: u32) -> u32 {
    if (bound == 0) {
        return fallback;
    }
    if (bound == 1) {
        return 0;
    }
    let maximum: u32 = 4294967295;
    let threshold: u32 = ((maximum % bound) + 1) % bound;
    let word: [i32; 1] = [0];
    let data: ptr = core::mem::i32_array_data_ptr(word);
    while (true) {
        word[0] = 0;
        if (!fill_secure_exact(data, 4)) {
            return fallback;
        }
        let signed: i32 = word[0];
        let sample: u32 = signed as u32;
        if (sample >= threshold) {
            return sample % bound;
        }
    }
    return fallback;
}

// Draw uniformly from the inclusive interval [low, high]. Reversed bounds
// return fallback without host access; a singleton returns its value without
// host access. The full u32 interval uses a direct checked four-byte draw.
// Host failure returns fallback, which may also be a legitimate sample.
pub fn secure_u32_inclusive_or(low: u32, high: u32, fallback: u32) -> u32 {
    if (low > high) {
        return fallback;
    }
    if (low == high) {
        return low;
    }
    let maximum: u32 = 4294967295;
    if (low == 0 && high == maximum) {
        return secure_u32_or(fallback);
    }
    let span: u32 = high - low + 1;
    let offset: u32 = secure_u32_below_or(span, maximum);
    if (offset == maximum) {
        return fallback;
    }
    return low + offset;
}

// Draw uniformly from the inclusive signed interval. XOR with the sign bit
// maps signed order into unsigned order, including the full i32 interval.
// Reversed bounds and host failure return fallback; a singleton needs no
// host call. A successful sample may equal fallback.
pub fn secure_i32_inclusive_or(low: i32, high: i32, fallback: i32) -> i32 {
    if (low > high) {
        return fallback;
    }
    let bias: u32 = 2147483648;
    let low_bits: u32 = low as u32;
    let high_bits: u32 = high as u32;
    let fallback_bits: u32 = fallback as u32;
    let first: u32 = low_bits ^ bias;
    let last: u32 = high_bits ^ bias;
    let failure: u32 = fallback_bits ^ bias;
    let selected: u32 = secure_u32_inclusive_or(first, last, failure);
    let selected_bits: u32 = selected ^ bias;
    let signed: i32 = selected_bits as i32;
    return signed;
}

// Shuffle the first len elements of a backed i32 view with Fisher-Yates and
// unbiased secure draws. A negative len returns false without touching data;
// zero and one succeed without reading the host. A random-host failure returns
// false and may leave a partially shuffled permutation. The caller must not
// claim more elements than the backing view actually contains: native indexing
// traps if an overclaimed length is reached.
pub fn shuffle_i32(values: [i32], len: i32) -> bool {
    if (len < 0) {
        return false;
    }
    let remaining: i32 = len;
    let failure: u32 = 4294967295;
    while (remaining > 1) {
        let bound: u32 = remaining;
        let selected: u32 = secure_u32_below_or(bound, failure);
        if (selected == failure) {
            return false;
        }
        let slot: i32 = selected;
        let last: i32 = remaining - 1;
        let previous: i32 = values[last];
        values[last] = values[slot];
        values[slot] = previous;
        remaining -= 1;
    }
    return true;
}
