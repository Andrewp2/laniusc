// Owned, allocation-backed char vector for the current native target. Each
// char occupies one native eight-byte slot (slot i at storage + 8 * i), read
// and written as char through typed views, so no integer conversion is
// involved. Sorting and searching use code-point order.
// Ownership is linear by convention: keep only the newest returned VecChar,
// do not copy it or use it after destroy. The language cannot enforce moves yet.
// Growth failure returns the original vector unchanged. Compare len after
// try_push, or capacity after try_reserve/try_with_capacity, to detect failure.
module std::vec_char;
import alloc::allocator;
import core::mem;
import core::slice_char;

pub struct VecChar {
    storage: ptr,
    length: i32,
    reserved: i32,
}

// Doubled capacities fit signed i32. Byte counts are computed as usize.
pub const MAX_CAPACITY: i32 = 536870911;

fn slot(storage: ptr, index: i32) -> [char] {
    let offset: usize = (index as usize) * 8;
    return core::mem::typed_slice_from_raw_parts(storage + offset, 1);
}

fn load(storage: ptr, index: i32) -> char {
    let view: [char] = slot(storage, index);
    return view[0];
}

fn store(storage: ptr, index: i32, item: char) {
    let view: [char] = slot(storage, index);
    view[0] = item;
}

// A typed view runs downward from its first element, so the view over the
// first count items starts at the last one and holds item i at count - 1 - i.
fn reversed_items(storage: ptr, count: i32) -> [char] {
    let offset: usize = ((count - 1) as usize) * 8;
    return core::mem::typed_slice_from_raw_parts(storage + offset, count);
}

fn byte_size(count: i32) -> usize {
    return (count as usize) * 8;
}

pub fn new() -> VecChar {
    let empty: ptr = 0;
    return VecChar { storage: empty, length: 0, reserved: 0 };
}

pub fn len(value: VecChar) -> i32 {
    return value.length;
}

pub fn capacity(value: VecChar) -> i32 {
    return value.reserved;
}

pub fn is_empty(value: VecChar) -> bool {
    return value.length == 0;
}

// A negative or oversized request leaves the vector unchanged. Allocation
// failure does the same and preserves every existing element.
pub fn try_reserve(value: VecChar, minimum_capacity: i32) -> VecChar {
    if (minimum_capacity < 0 || minimum_capacity > MAX_CAPACITY) {
        return value;
    }
    if (minimum_capacity <= value.reserved) {
        return value;
    }
    let new_bytes: usize = byte_size(minimum_capacity);
    let next: ptr = 0;
    if (value.storage == 0) {
        next = alloc::allocator::alloc(new_bytes, 8);
    } else {
        next = alloc::allocator::realloc(value.storage, byte_size(value.reserved), new_bytes, 8);
    }
    if (next == 0) {
        return value;
    }
    return VecChar { storage: next, length: value.length, reserved: minimum_capacity };
}

// On invalid capacity or allocation failure, returns an empty zero-capacity
// vector. A nonnegative request succeeded exactly when capacity(result) is
// at least the request.
pub fn try_with_capacity(initial_capacity: i32) -> VecChar {
    return try_reserve(new(), initial_capacity);
}

// Create an independent allocation containing the initialized values.
// The source remains live; destroy it and the successful clone separately.
// An empty source clones without allocation. Allocation failure returns an
// empty zero-capacity vector without changing the source. For a
// nonempty source, len(result) == len(value) indicates success.
pub fn try_clone(value: VecChar) -> VecChar {
    let length: i32 = value.length;
    if (length == 0) {
        return new();
    }
    let copy: VecChar = try_with_capacity(length);
    if (copy.reserved < length) {
        return new();
    }
    let index: i32 = 0;
    while (index < length) {
        copy = try_push(copy, load(value.storage, index));
        index += 1;
    }
    return copy;
}

// On failure, returns the original value unchanged. A successful push always
// increments len by one, so callers can check len without a separate status.
pub fn try_push(value: VecChar, item: char) -> VecChar {
    let grown: VecChar = value;
    if (grown.length == grown.reserved) {
        let target: i32 = 4;
        if (grown.reserved > 0) {
            if (grown.reserved > MAX_CAPACITY / 2) {
                target = MAX_CAPACITY;
            } else {
                target = grown.reserved * 2;
            }
        }
        grown = try_reserve(grown, target);
        if (grown.length == grown.reserved) {
            return value;
        }
    }
    store(grown.storage, grown.length, item);
    return VecChar { storage: grown.storage, length: grown.length + 1, reserved: grown.reserved };
}

// Append count caller-backed values. Reserve all needed storage before writing
// any item, so negative counts, capacity overflow, and allocation failure leave
// the vector unchanged. A successful call increases len by count. The caller
// must supply at least count readable elements; overclaiming can trap. Input
// storage must not alias this vector because growth may move the allocation.
pub fn try_extend_from_slice(value: VecChar, items: [char], count: i32) -> VecChar {
    if (count < 0 || count > MAX_CAPACITY - value.length) {
        return value;
    }
    if (count == 0) {
        return value;
    }
    let needed: i32 = value.length + count;
    let grown: VecChar = value;
    if (grown.reserved < needed) {
        let target: i32 = 4;
        if (grown.reserved > 0) {
            if (grown.reserved > MAX_CAPACITY / 2) {
                target = MAX_CAPACITY;
            } else {
                target = grown.reserved * 2;
            }
        }
        if (target < needed) {
            target = needed;
        }
        grown = try_reserve(grown, target);
        if (grown.reserved < needed) {
            return value;
        }
    }
    let index: i32 = 0;
    while (index < count) {
        grown = try_push(grown, items[index]);
        index += 1;
    }
    return grown;
}

// Insert at [0, len]. Invalid indices or allocation failure leave the value
// unchanged. A successful insert increases len by one. This operation may
// move the allocation, so only the returned vector remains owned.
pub fn try_insert(value: VecChar, index: i32, item: char) -> VecChar {
    let old_len: i32 = value.length;
    if (index < 0 || index > old_len) {
        return value;
    }
    let grown: VecChar = try_push(value, item);
    if (grown.length == old_len) {
        return grown;
    }
    let cursor: i32 = old_len;
    while (cursor > index) {
        store(grown.storage, cursor, load(grown.storage, cursor - 1));
        cursor -= 1;
    }
    store(grown.storage, index, item);
    return grown;
}

// Remove one element at [0, len). Invalid indices leave the vector unchanged.
// A successful removal decreases len by one and keeps the allocation for reuse.
// Read the removed element with get_or before calling when it is needed.
pub fn try_remove(value: VecChar, index: i32) -> VecChar {
    if (index < 0 || index >= value.length) {
        return value;
    }
    let cursor: i32 = index;
    while (cursor + 1 < value.length) {
        store(value.storage, cursor, load(value.storage, cursor + 1));
        cursor += 1;
    }
    return try_pop(value);
}

// Invalid indices return fallback without accessing storage.
pub fn get_or(value: VecChar, index: i32, fallback: char) -> char {
    if (index < 0 || index >= value.length) {
        return fallback;
    }
    return load(value.storage, index);
}

// Mutates the owned allocation only for an in-bounds index.
pub fn try_set(value: VecChar, index: i32, item: char) -> bool {
    if (index < 0 || index >= value.length) {
        return false;
    }
    store(value.storage, index, item);
    return true;
}

// Sort ascending by code point and return len. The view holds the items in
// reverse, so sorting it ascending and reversing it leaves them ascending.
pub fn sort_in_place(value: VecChar) -> i32 {
    if (value.length <= 1) {
        return value.length;
    }
    let view: [char] = reversed_items(value.storage, value.length);
    let sorted: bool = core::slice_char::sort(view, value.length);
    let reversed: i32 = core::slice_char::reverse(view, value.length);
    return reversed;
}

// Reverse initialized elements and return the number of swaps performed.
pub fn reverse_in_place(value: VecChar) -> i32 {
    if (value.length <= 1) {
        return 0;
    }
    let left: i32 = 0;
    let right: i32 = value.length - 1;
    let swaps: i32 = 0;
    while (left < right) {
        let saved: char = load(value.storage, left);
        store(value.storage, left, load(value.storage, right));
        store(value.storage, right, saved);
        left += 1;
        right -= 1;
        swaps += 1;
    }
    return swaps;
}

// Search requires nondecreasing code-point order. The bounds return an index
// from zero through len; empty vectors return zero without reading storage.
pub fn lower_bound(value: VecChar, needle: char) -> i32 {
    let low: i32 = 0;
    let high: i32 = value.length;
    while (low < high) {
        let middle: i32 = low + (high - low) / 2;
        if (load(value.storage, middle) < needle) {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    return low;
}

pub fn upper_bound(value: VecChar, needle: char) -> i32 {
    let low: i32 = 0;
    let high: i32 = value.length;
    while (low < high) {
        let middle: i32 = low + (high - low) / 2;
        if (load(value.storage, middle) <= needle) {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    return low;
}

// Return first or last matching index, or fallback when the needle is absent.
pub fn binary_search_first_or(value: VecChar, needle: char, fallback: i32) -> i32 {
    let index: i32 = lower_bound(value, needle);
    if (index < value.length && get_or(value, index, '\0') == needle) {
        return index;
    }
    return fallback;
}

pub fn binary_search_last_or(value: VecChar, needle: char, fallback: i32) -> i32 {
    let after: i32 = upper_bound(value, needle);
    if (after > 0 && get_or(value, after - 1, '\0') == needle) {
        return after - 1;
    }
    return fallback;
}

// On an empty vector, returns it unchanged. Read the last element with get_or
// before popping if its value is needed.
pub fn try_pop(value: VecChar) -> VecChar {
    if (value.length == 0) {
        return value;
    }
    return VecChar { storage: value.storage, length: value.length - 1, reserved: value.reserved };
}

// Keep the first new_len elements and retain the allocation for reuse.
// A negative length or one greater than the current length leaves the vector
// unchanged. Truncated elements are no longer in the vector.
pub fn truncate(value: VecChar, new_len: i32) -> VecChar {
    if (new_len < 0 || new_len > value.length) {
        return value;
    }
    return VecChar { storage: value.storage, length: new_len, reserved: value.reserved };
}

// Set the length to new_len. Growing initializes every new element to fill;
// shrinking keeps the prefix and allocation. A negative or oversized length,
// or allocation failure during growth, leaves the original vector unchanged.
// A successful growth has len(result) == new_len.
pub fn try_resize(value: VecChar, new_len: i32, fill: char) -> VecChar {
    if (new_len < 0 || new_len > MAX_CAPACITY) {
        return value;
    }
    if (new_len <= value.length) {
        return truncate(value, new_len);
    }
    let grown: VecChar = try_reserve(value, new_len);
    if (grown.reserved < new_len) {
        return value;
    }
    while (grown.length < new_len) {
        grown = try_push(grown, fill);
    }
    return grown;
}

// Keeps the allocation for reuse; old elements are no longer in the vector.
pub fn clear(value: VecChar) -> VecChar {
    return VecChar { storage: value.storage, length: 0, reserved: value.reserved };
}

// Reduce capacity to len. An empty vector releases its allocation. Failed
// reallocation returns the original vector with its elements and capacity
// unchanged; compare capacity(result) with len(result) to detect failure.
pub fn try_shrink_to_fit(value: VecChar) -> VecChar {
    if (value.length == value.reserved) {
        return value;
    }
    if (value.length == 0) {
        alloc::allocator::dealloc(value.storage, byte_size(value.reserved), 8);
        return new();
    }
    let next: ptr = alloc::allocator::realloc(
        value.storage, byte_size(value.reserved), byte_size(value.length), 8);
    if (next == 0) {
        return value;
    }
    return VecChar { storage: next, length: value.length, reserved: value.length };
}

// Releases the one owned allocation. The caller must never use any copy of
// the vector after this call.
pub fn destroy(value: VecChar) {
    if (value.storage != 0) {
        alloc::allocator::dealloc(value.storage, byte_size(value.reserved), 8);
    }
}
