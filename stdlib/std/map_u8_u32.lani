// Dense byte-keyed map in caller-owned storage. `keys` needs eight u32 words;
// `values` needs 256 u32 words. The two backing views must not overlap. Call
// clear before reading a fresh map. Keys iterate in ascending numeric order.
// No allocation or destructor is needed.
// A view that omits a word may trap when an operation accesses that word.
module std::map_u8_u32;
import std::set_u8;

pub fn len(keys: [u32]) -> i32 {
    return std::set_u8::len(keys);
}

pub fn is_empty(keys: [u32]) -> bool {
    return std::set_u8::is_empty(keys);
}

pub fn is_full(keys: [u32]) -> bool {
    return std::set_u8::is_full(keys);
}

pub fn contains_key(keys: [u32], key: u8) -> bool {
    return std::set_u8::contains(keys, key);
}

// Missing keys return fallback, which may equal a stored value. Check
// contains_key when the distinction matters.
pub fn get_or(keys: [u32], values: [u32], key: u8, fallback: u32) -> u32 {
    if (!contains_key(keys, key)) { return fallback; }
    let index: i32 = key as i32;
    return values[index];
}

// Invalid ordinals return fallback. Keys are ordered by byte value.
pub fn key_at_or(keys: [u32], ordinal: i32, fallback: u8) -> u8 {
    return std::set_u8::at_or(keys, ordinal, fallback);
}

pub fn value_at_or(keys: [u32], values: [u32], ordinal: i32, fallback: u32) -> u32 {
    if (ordinal < 0 || ordinal >= len(keys)) { return fallback; }
    let key: u8 = key_at_or(keys, ordinal, 0);
    return get_or(keys, values, key, fallback);
}

// Insert only a missing key. Return false and preserve its old value for a
// duplicate; true means a new entry was stored.
pub fn insert(keys: [u32], values: [u32], key: u8, value: u32) -> bool {
    if (contains_key(keys, key)) { return false; }
    let index: i32 = key as i32;
    values[index] = value;
    std::set_u8::insert(keys, key);
    return true;
}

// Always store value. Return true for a new key and false when replacing an
// existing entry; both results mean the write succeeded on valid backing.
pub fn put(keys: [u32], values: [u32], key: u8, value: u32) -> bool {
    let fresh: bool = !contains_key(keys, key);
    let index: i32 = key as i32;
    values[index] = value;
    std::set_u8::insert(keys, key);
    return fresh;
}

// Update only a present key. Missing keys return false without writing.
pub fn set(keys: [u32], values: [u32], key: u8, value: u32) -> bool {
    if (!contains_key(keys, key)) { return false; }
    let index: i32 = key as i32;
    values[index] = value;
    return true;
}

// Remove a present entry and zero its old value. A missing key returns false
// without writing.
pub fn remove(keys: [u32], values: [u32], key: u8) -> bool {
    if (!contains_key(keys, key)) { return false; }
    let index: i32 = key as i32;
    values[index] = 0;
    std::set_u8::remove(keys, key);
    return true;
}

// Initialize or reset both backing views. This visits all 264 words, so a
// physically short view traps rather than silently leaving keys or data live.
pub fn clear(keys: [u32], values: [u32]) {
    std::set_u8::clear(keys);
    let index: i32 = 0;
    while (index < 256) {
        values[index] = 0;
        index += 1;
    }
}
