// io_uring through raw Linux syscalls: io_uring_setup (425), mmap of the
// submission ring, completion ring and SQE array, and io_uring_enter (426).
// SQE builders cover nop, read, write, readv, openat, close, accept, recv and
// send; transfer() is a batched copy/cat engine over one ring.
// Linux x86_64 only. Ring head/tail words are shared with the kernel and go
// through std::atomic, so link with --native-link --native-library atomic.
// A Ring belongs to one process and one caller at a time; buffers, paths,
// iovec tables and address slots handed to an operation must stay valid and
// untouched until its completion is consumed. See docs/stdlib-uring.md.
module std::uring;
import core::mem;
import core::option;
import core::result;
import core::slice;
import std::linux;
import std::atomic;

// Host(errno) is a failed syscall (setup, mmap, enter); operation failures
// arrive as negative Completion results instead. Full means the operation
// was not queued: the submission ring has no free entry, or the completions
// already owed would fill the completion ring (backpressure, see push).
// Read(errno) and Write(errno) are transfer's first failed input or output
// operation.
pub enum Error { Host(i32), InvalidEntries, InvalidInput, Full, Busy, Closed, Read(i32), Write(i32) }

pub const OP_NOP: i64 = 0;
pub const OP_READV: i64 = 1;
pub const OP_WRITEV: i64 = 2;
pub const OP_ACCEPT: i64 = 13;
pub const OP_OPENAT: i64 = 18;
pub const OP_CLOSE: i64 = 19;
pub const OP_READ: i64 = 22;
pub const OP_WRITE: i64 = 23;
pub const OP_SEND: i64 = 26;
pub const OP_RECV: i64 = 27;

// IOSQE_IO_LINK: the next SQE starts only after this one succeeds.
pub const LINK: i64 = 4;
// IORING_SETUP_SUBMIT_ALL: keep submitting a batch past a failed SQE.
pub const SETUP_SUBMIT_ALL: u32 = 128;
// IORING_SETUP_SINGLE_ISSUER | IORING_SETUP_DEFER_TASKRUN: completions are
// posted only inside io_uring_enter(GETEVENTS), never asynchronously.
pub const SETUP_DEFER_TASKRUN: u32 = 12288;
pub const MAX_ENTRIES: u32 = 4096;
// The offset that means "the file position", for streams and O_APPEND.
pub const CURRENT: i64 = -1;
pub const AT_FDCWD: i32 = -100;

const MASK32: i64 = 4294967295;
const ENTER_GETEVENTS: i64 = 1;
const OFF_CQ_RING: i64 = 134217728;
const OFF_SQES: i64 = 268435456;
const FEAT_SINGLE_MMAP: i64 = 1;
const EINTR: i32 = 4;
const EAGAIN: i32 = 11;
const EBUSY: i32 = 16;

pub struct Completion { user_data: u64, result: i32, flags: u32 }
pub impl Completion {
    pub fn user_data(&self) -> u64 { return self.user_data; }
    // Bytes, a descriptor or 0 on success; -errno on failure.
    pub fn result(&self) -> i32 { return self.result; }
    pub fn flags(&self) -> u32 { return self.flags; }
    pub fn failed(&self) -> bool { return self.result < 0; }
    pub fn errno(&self) -> i32 { if (self.result < 0) { return 0 - self.result; } return 0; }
}

// Index fields are free-running 32-bit counters kept in i64.
pub struct Ring {
    fd: i32, features: i64, live: bool,
    sq_map: ptr, sq_bytes: i64, cq_map: ptr, cq_bytes: i64, sqes: ptr, sqe_bytes: i64,
    sq_head: ptr, sq_tail: ptr, sq_flags: ptr, sq_dropped: ptr, sq_mask: i64, sq_entries: i64,
    cq_head: ptr, cq_tail: ptr, cq_overflow: ptr, cqes: ptr, cq_mask: i64, cq_entries: i64,
    tail: i64, head: i64, pending: i64, owed: i64, last: ptr, moved: i64, scratch: ptr,
}

fn word(value: i64) -> std::linux::Argument { return std::linux::Argument::Word(value); }
fn host(error: std::linux::Error) -> Error {
    return match (error) { std::linux::Error::System(code) -> Error::Host(code), _ -> Error::Host(22) };
}
fn load32(at: ptr) -> i64 { let view: [i32] = core::mem::typed_slice_from_raw_parts<i32>(at, 1); let value: i64 = view[0] as i64; return value & MASK32; }
fn narrow(value: i64) -> i32 { let low: i64 = value & MASK32; if (low > 2147483647) { return (low - 4294967296) as i32; } return low as i32; }
fn store32(at: ptr, value: i64) { let view: [i32] = core::mem::typed_slice_from_raw_parts<i32>(at, 1); let low: i32 = narrow(value); view[0] = low; }
fn store64(at: ptr, value: i64) { let view: [i64] = core::mem::typed_slice_from_raw_parts<i64>(at, 1); view[0] = value; }
fn store_u64(at: ptr, value: u64) { let view: [u64] = core::mem::typed_slice_from_raw_parts<u64>(at, 1); view[0] = value; }
fn load_u64(at: ptr) -> u64 { let view: [u64] = core::mem::typed_slice_from_raw_parts<u64>(at, 1); return view[0]; }
fn store_ptr(at: ptr, value: ptr) { let view: [ptr] = core::mem::typed_slice_from_raw_parts<ptr>(at, 1); view[0] = value; }
// Transfer completion tags: slot, write bit, chunk start, chunk length.
fn write_tag(slot: i32, start: i64, length: i64) -> u64 { return ((slot as i64) + 256 + start * 512 + length * 68719476736) as u64; }
fn acquire32(at: ptr) -> i64 { let value: u32 = std::atomic::at32(at).load(std::atomic::Load::Acquire); return (value as i64) & MASK32; }
fn release32(at: ptr, value: i64) { let low: u32 = (value & MASK32) as u32; std::atomic::at32(at).store(low, std::atomic::Store::Release); }

fn map(bytes: i64, fd: i64, offset: i64, flags: i64) -> core::result::Result<ptr, Error> {
    let nowhere: ptr = 0;
    let args: [std::linux::Argument; 6] = [std::linux::Argument::Address(nowhere), word(bytes), word(3), word(flags), word(fd), word(offset)];
    let done: core::result::Result<i64, std::linux::Error> = std::linux::call(9, core::slice::view(args, 6).unwrap());
    if (done.is_err()) { return core::result::Err(host(done.unwrap_err())); }
    return core::result::Ok(nowhere + (done.unwrap() as usize));
}
fn unmap(at: ptr, bytes: i64) -> bool {
    let args: [std::linux::Argument; 2] = [std::linux::Argument::Address(at), word(bytes)];
    let done: core::result::Result<i64, std::linux::Error> = std::linux::call(11, core::slice::view(args, 2).unwrap());
    return done.is_ok();
}
fn close_descriptor(fd: i32) -> core::result::Result<i64, std::linux::Error> {
    let args: [std::linux::Argument; 1] = [word(fd as i64)];
    return std::linux::call(3, core::slice::view(args, 1).unwrap());
}

// Private zeroed memory for I/O buffers, iovec tables and path slots.
pub fn map_buffers(bytes: usize) -> core::result::Result<ptr, Error> {
    if (bytes == 0 || bytes > 1073741824) { return core::result::Err(Error::InvalidInput); }
    let rounded: usize = (bytes + 4095) / 4096 * 4096;
    return map(rounded as i64, -1, 0, 34);
}
pub fn unmap_buffers(at: ptr, bytes: usize) -> core::result::Result<i32, Error> {
    let rounded: usize = (bytes + 4095) / 4096 * 4096;
    if (!unmap(at, rounded as i64)) { return core::result::Err(Error::InvalidInput); }
    return core::result::Ok(0);
}
// Copy bytes into a NUL-terminated path slot of capacity bytes (openat
// reads it when the SQE is consumed). Interior NULs are rejected.
pub fn stage_path(bytes: core::slice::View<u8>, slot: ptr, capacity: i32) -> core::result::Result<i32, Error> {
    if (bytes.start < 0 || bytes.length < 0 || bytes.length >= capacity) { return core::result::Err(Error::InvalidInput); }
    let out: [u8] = core::mem::typed_slice_from_raw_parts<u8>(slot, capacity);
    let i: i32 = 0;
    while (i < bytes.length) {
        let value: u8 = bytes.values[bytes.start + i];
        if (value == 0) { return core::result::Err(Error::InvalidInput); }
        out[i] = value; i += 1;
    }
    out[i] = 0;
    return core::result::Ok(i);
}
// Fill entry index of an iovec table: { base, length }.
pub fn iovec(table: ptr, index: i32, base: ptr, length: usize) {
    let at: ptr = table + (index as usize) * 16;
    store_ptr(at, base); store64(at + 8, length as i64);
}
// True when lseek works, so positional reads are meaningful.
pub fn seekable(fd: i32) -> bool {
    let args: [std::linux::Argument; 3] = [word(fd as i64), word(0), word(1)];
    let done: core::result::Result<i64, std::linux::Error> = std::linux::call(8, core::slice::view(args, 3).unwrap());
    return done.is_ok();
}

// The output_at for appending to fd as `cat` does: its file position when fd
// is seekable and not O_APPEND (writes then overlap), else CURRENT (one
// ordered write at a time). After transfer, finish_output moves the file
// position past the bytes written, as sequential writes would have.
pub fn cat_output(fd: i32) -> i64 {
    let probe: [std::linux::Argument; 3] = [word(fd as i64), word(3), word(0)];
    let status: core::result::Result<i64, std::linux::Error> = std::linux::call(72, core::slice::view(probe, 3).unwrap());
    if (status.is_err() || (status.unwrap() & 1024) != 0) { return CURRENT; }
    let args: [std::linux::Argument; 3] = [word(fd as i64), word(0), word(1)];
    let done: core::result::Result<i64, std::linux::Error> = std::linux::call(8, core::slice::view(args, 3).unwrap());
    if (done.is_err()) { return CURRENT; }
    return done.unwrap();
}
pub fn finish_output(fd: i32, output_at: i64, written: i64) -> bool {
    if (output_at < 0) { return true; }
    let args: [std::linux::Argument; 3] = [word(fd as i64), word(output_at + written), word(0)];
    let done: core::result::Result<i64, std::linux::Error> = std::linux::call(8, core::slice::view(args, 3).unwrap());
    return done.is_ok();
}

pub fn setup(entries: u32) -> core::result::Result<Ring, Error> { return setup_with(entries, SETUP_SUBMIT_ALL); }
// entries is rounded up to a power of two by the kernel; the completion ring
// gets twice as many. flags are IORING_SETUP_* bits; SQPOLL, IOPOLL and
// NO_SQARRAY change the protocol and are refused.
pub fn setup_with(entries: u32, flags: u32) -> core::result::Result<Ring, Error> {
    if (entries == 0 || entries > MAX_ENTRIES) { return core::result::Err(Error::InvalidEntries); }
    if ((flags & 65539) != 0) { return core::result::Err(Error::InvalidInput); }
    let params: [i32; 30] = [0; 30];
    let p: ptr = core::mem::i32_array_data_ptr(params);
    store32(p + 8, flags as i64);
    let args: [std::linux::Argument; 2] = [word(entries as i64), std::linux::Argument::Address(p)];
    let made: core::result::Result<i64, std::linux::Error> = std::linux::call(425, core::slice::view(args, 2).unwrap());
    if (made.is_err()) { return core::result::Err(host(made.unwrap_err())); }
    let fd: i32 = made.unwrap() as i32;
    let sq_entries: i64 = load32(p);
    let cq_entries: i64 = load32(p + 4);
    let features: i64 = load32(p + 20);
    let sq_bytes: i64 = load32(p + 64) + sq_entries * 4;
    let cq_bytes: i64 = load32(p + 100) + cq_entries * 16;
    let single: bool = (features & FEAT_SINGLE_MMAP) != 0;
    if (single && cq_bytes > sq_bytes) { sq_bytes = cq_bytes; }
    // MAP_SHARED | MAP_POPULATE
    let sq: core::result::Result<ptr, Error> = map(sq_bytes, fd as i64, 0, 32769);
    if (sq.is_err()) { close_descriptor(fd); return core::result::Err(sq.unwrap_err()); }
    let sq_map: ptr = sq.unwrap();
    let cq_map: ptr = sq_map;
    if (!single) {
        let cq: core::result::Result<ptr, Error> = map(cq_bytes, fd as i64, OFF_CQ_RING, 32769);
        if (cq.is_err()) { unmap(sq_map, sq_bytes); close_descriptor(fd); return core::result::Err(cq.unwrap_err()); }
        cq_map = cq.unwrap();
    }
    let sqe_bytes: i64 = sq_entries * 64;
    let entries_map: core::result::Result<ptr, Error> = map(sqe_bytes, fd as i64, OFF_SQES, 32769);
    if (entries_map.is_err()) {
        unmap(sq_map, sq_bytes);
        if (!single) { unmap(cq_map, cq_bytes); }
        close_descriptor(fd);
        return core::result::Err(entries_map.unwrap_err());
    }
    // One private page for transfer's slot table.
    let scratch: core::result::Result<ptr, Error> = map(4096, -1, 0, 34);
    if (scratch.is_err()) {
        unmap(entries_map.unwrap(), sqe_bytes); unmap(sq_map, sq_bytes);
        if (!single) { unmap(cq_map, cq_bytes); }
        close_descriptor(fd);
        return core::result::Err(scratch.unwrap_err());
    }
    let ring: Ring = Ring {
        fd: fd, features: features, live: true,
        sq_map: sq_map, sq_bytes: sq_bytes, cq_map: cq_map, cq_bytes: cq_bytes, sqes: entries_map.unwrap(), sqe_bytes: sqe_bytes,
        sq_head: sq_map + (load32(p + 40) as usize), sq_tail: sq_map + (load32(p + 44) as usize),
        sq_flags: sq_map + (load32(p + 56) as usize), sq_dropped: sq_map + (load32(p + 60) as usize),
        sq_mask: load32(sq_map + (load32(p + 48) as usize)), sq_entries: sq_entries,
        cq_head: cq_map + (load32(p + 80) as usize), cq_tail: cq_map + (load32(p + 84) as usize),
        cq_overflow: cq_map + (load32(p + 96) as usize), cqes: cq_map + (load32(p + 100) as usize),
        cq_mask: load32(cq_map + (load32(p + 88) as usize)), cq_entries: cq_entries,
        tail: 0, head: 0, pending: 0, owed: 0, last: sq_map, moved: 0, scratch: scratch.unwrap(),
    };
    // Identity SQ index array: slot i always names SQE i.
    let array: ptr = sq_map + (load32(p + 64) as usize);
    let i: i64 = 0;
    while (i < sq_entries) { store32(array + (i as usize) * 4, i); i += 1; }
    ring.tail = load32(ring.sq_tail);
    ring.head = load32(ring.cq_head);
    return core::result::Ok(ring);
}

pub impl Ring {
    pub fn borrow(&self) -> &Ring { return self; }
    pub fn fd(&self) -> i32 { return self.fd; }
    pub fn features(&self) -> u32 { return self.features as u32; }
    pub fn submission_entries(&self) -> i32 { return self.sq_entries as i32; }
    pub fn completion_entries(&self) -> i32 { return self.cq_entries as i32; }
    // Prepared but not yet handed to the kernel.
    pub fn pending(&self) -> i32 { return self.pending as i32; }
    // Prepared or submitted operations whose completion is not yet consumed.
    pub fn owed(&self) -> i32 { return self.owed as i32; }
    // Operations that can be prepared right now without Full.
    pub fn space(&self) -> i32 {
        let used: i64 = (self.tail - acquire32(self.sq_head)) & MASK32;
        let free: i64 = self.sq_entries - used;
        let room: i64 = self.cq_entries - self.owed;
        if (room < free) { free = room; }
        if (free < 0) { free = 0; }
        return free as i32;
    }
    // Kernel counters: invalid SQ indices dropped, completions overflowed.
    pub fn dropped(&self) -> i32 { return load32(self.sq_dropped) as i32; }
    pub fn overflowed(&self) -> i32 { return acquire32(self.cq_overflow) as i32; }
    pub fn is_live(&self) -> bool { return self.live; }
    // Bytes the last transfer wrote, also when it failed.
    pub fn transferred(&self) -> i64 { return self.moved; }

    // Queue one SQE. Full when no SQ entry is free, or when the completions
    // already owed (prepared + in flight, unconsumed) equal the completion
    // ring's size: refusing there keeps the CQ from ever overflowing.
    pub fn push(&self, opcode: i64, fd: i32, offset: i64, address: ptr, length: i64, op_flags: i64, user_data: u64, flags: i64) -> core::result::Result<i32, Error> {
        if (!self.live) { return core::result::Err(Error::Closed); }
        if (self.owed >= self.cq_entries) { return core::result::Err(Error::Full); }
        let used: i64 = (self.tail - acquire32(self.sq_head)) & MASK32;
        if (used >= self.sq_entries) { return core::result::Err(Error::Full); }
        let sqe: ptr = self.sqes + ((self.tail & self.sq_mask) as usize) * 64;
        store64(sqe, opcode | (flags * 256));
        store32(sqe + 4, fd as i64);
        store64(sqe + 8, offset);
        store_ptr(sqe + 16, address);
        store32(sqe + 24, length);
        store32(sqe + 28, op_flags);
        store_u64(sqe + 32, user_data);
        store64(sqe + 40, 0); store64(sqe + 48, 0); store64(sqe + 56, 0);
        self.last = sqe;
        self.tail = (self.tail + 1) & MASK32;
        self.pending += 1; self.owed += 1;
        return core::result::Ok(0);
    }
    // Mark the most recently prepared SQE IOSQE_IO_LINK.
    pub fn link_last(&self) -> core::result::Result<i32, Error> {
        if (self.pending == 0) { return core::result::Err(Error::InvalidInput); }
        let bytes: [u8] = core::mem::typed_slice_from_raw_parts<u8>(self.last, 2);
        let current: u8 = bytes[1];
        bytes[1] = current | 4;
        return core::result::Ok(0);
    }
    pub fn nop(&self, user_data: u64) -> core::result::Result<i32, Error> {
        let none: ptr = 0; return self.push(OP_NOP, -1, 0, none, 0, 0, user_data, 0);
    }
    // offset CURRENT reads at (and advances) the file position.
    pub fn read(&self, fd: i32, buffer: ptr, length: i32, offset: i64, user_data: u64) -> core::result::Result<i32, Error> {
        if (length < 0) { return core::result::Err(Error::InvalidInput); }
        return self.push(OP_READ, fd, offset, buffer, length as i64, 0, user_data, 0);
    }
    pub fn write(&self, fd: i32, buffer: ptr, length: i32, offset: i64, user_data: u64) -> core::result::Result<i32, Error> {
        if (length < 0) { return core::result::Err(Error::InvalidInput); }
        return self.push(OP_WRITE, fd, offset, buffer, length as i64, 0, user_data, 0);
    }
    // iovecs points at count entries filled with iovec().
    pub fn readv(&self, fd: i32, iovecs: ptr, count: i32, offset: i64, user_data: u64) -> core::result::Result<i32, Error> {
        if (count < 0 || count > 1024) { return core::result::Err(Error::InvalidInput); }
        return self.push(OP_READV, fd, offset, iovecs, count as i64, 0, user_data, 0);
    }
    pub fn writev(&self, fd: i32, iovecs: ptr, count: i32, offset: i64, user_data: u64) -> core::result::Result<i32, Error> {
        if (count < 0 || count > 1024) { return core::result::Err(Error::InvalidInput); }
        return self.push(OP_WRITEV, fd, offset, iovecs, count as i64, 0, user_data, 0);
    }
    // path is a NUL-terminated slot (stage_path); the result is the new fd.
    pub fn openat(&self, directory: i32, path: ptr, flags: i32, mode: u32, user_data: u64) -> core::result::Result<i32, Error> {
        return self.push(OP_OPENAT, directory, 0, path, mode as i64, flags as i64, user_data, 0);
    }
    pub fn close(&self, fd: i32, user_data: u64) -> core::result::Result<i32, Error> {
        let none: ptr = 0; return self.push(OP_CLOSE, fd, 0, none, 0, 0, user_data, 0);
    }
    // address/address_length may both be 0; otherwise address_length points
    // at a 4-byte capacity the kernel rewrites. The result is the new fd.
    pub fn accept(&self, fd: i32, address: ptr, address_length: ptr, flags: i32, user_data: u64) -> core::result::Result<i32, Error> {
        let none: ptr = 0;
        let pushed: core::result::Result<i32, Error> = self.push(OP_ACCEPT, fd, 0, address, 0, flags as i64, user_data, 0);
        if (pushed.is_err()) { return pushed; }
        store_ptr(self.last + 8, address_length);
        return pushed;
    }
    pub fn recv(&self, fd: i32, buffer: ptr, length: i32, flags: i32, user_data: u64) -> core::result::Result<i32, Error> {
        if (length < 0) { return core::result::Err(Error::InvalidInput); }
        return self.push(OP_RECV, fd, 0, buffer, length as i64, flags as i64, user_data, 0);
    }
    pub fn send(&self, fd: i32, buffer: ptr, length: i32, flags: i32, user_data: u64) -> core::result::Result<i32, Error> {
        if (length < 0) { return core::result::Err(Error::InvalidInput); }
        return self.push(OP_SEND, fd, 0, buffer, length as i64, flags as i64, user_data, 0);
    }

    fn enter(&self, submit: i64, wait: i64, flags: i64) -> core::result::Result<i64, Error> {
        let none: ptr = 0;
        let args: [std::linux::Argument; 6] = [word(self.fd as i64), word(submit), word(wait), word(flags), std::linux::Argument::Address(none), word(0)];
        while (true) {
            let done: core::result::Result<i64, std::linux::Error> = std::linux::call(426, core::slice::view(args, 6).unwrap());
            if (done.is_ok()) {
                let taken: i64 = done.unwrap();
                self.pending -= taken;
                return core::result::Ok(taken);
            }
            let error: Error = host(done.unwrap_err());
            let again: bool = match (error) { Error::Host(code) -> code == EINTR, _ -> false };
            if (!again) {
                let busy: bool = match (error) { Error::Host(code) -> code == EBUSY || code == EAGAIN, _ -> false };
                if (busy) { return core::result::Err(Error::Busy); }
                return core::result::Err(error);
            }
        }
        return core::result::Err(Error::Host(EINTR));
    }
    // Publish prepared SQEs and hand them to the kernel; returns how many it took.
    pub fn submit(&self) -> core::result::Result<i32, Error> {
        if (!self.live) { return core::result::Err(Error::Closed); }
        release32(self.sq_tail, self.tail);
        if (self.pending == 0) { return core::result::Ok(0); }
        let taken: core::result::Result<i64, Error> = self.enter(self.pending, 0, 0);
        if (taken.is_err()) { return core::result::Err(taken.unwrap_err()); }
        return core::result::Ok(taken.unwrap() as i32);
    }
    // Submit, then block until at least count completions are ready.
    pub fn submit_and_wait(&self, count: i32) -> core::result::Result<i32, Error> {
        if (!self.live) { return core::result::Err(Error::Closed); }
        if (count < 0 || (count as i64) > self.owed) { return core::result::Err(Error::InvalidInput); }
        release32(self.sq_tail, self.tail);
        let taken: core::result::Result<i64, Error> = self.enter(self.pending, count as i64, ENTER_GETEVENTS);
        if (taken.is_err()) { return core::result::Err(taken.unwrap_err()); }
        return core::result::Ok(taken.unwrap() as i32);
    }
    // Completions ready to consume without blocking.
    pub fn ready(&self) -> i32 { return ((acquire32(self.cq_tail) - self.head) & MASK32) as i32; }
    // Consume one completion if one is ready.
    pub fn peek(&self) -> core::option::Option<Completion> {
        if (!self.live) { return core::option::None(); }
        let tail: i64 = acquire32(self.cq_tail);
        if (tail == self.head) { return core::option::None(); }
        let cqe: ptr = self.cqes + ((self.head & self.cq_mask) as usize) * 16;
        let user_data: u64 = load_u64(cqe);
        let result: i32 = narrow(load32(cqe + 8));
        let flags: u32 = load32(cqe + 12) as u32;
        self.head = (self.head + 1) & MASK32;
        release32(self.cq_head, self.head);
        self.owed -= 1;
        return core::option::Some(Completion { user_data: user_data, result: result, flags: flags });
    }
    // Consume one completion, submitting pending SQEs and blocking as needed.
    pub fn wait(&self) -> core::result::Result<Completion, Error> {
        while (true) {
            let next: core::option::Option<Completion> = self.peek();
            if (next.is_some()) { return core::result::Ok(next.unwrap()); }
            if (self.owed == 0) { return core::result::Err(Error::InvalidInput); }
            let waited: core::result::Result<i32, Error> = self.submit_and_wait(1);
            if (waited.is_err()) { return core::result::Err(waited.unwrap_err()); }
        }
        return core::result::Err(Error::InvalidInput);
    }
    // Unmap the rings and close the ring descriptor. Owed operations are
    // cancelled by the kernel; their buffers must stay mapped until then.
    pub fn destroy(&self) -> core::result::Result<i32, Error> {
        if (!self.live) { return core::result::Err(Error::Closed); }
        self.live = false;
        unmap(self.sqes, self.sqe_bytes);
        unmap(self.scratch, 4096);
        if (self.cq_map != self.sq_map) { unmap(self.cq_map, self.cq_bytes); }
        unmap(self.sq_map, self.sq_bytes);
        let closed: core::result::Result<i64, std::linux::Error> = close_descriptor(self.fd);
        if (closed.is_err()) { return core::result::Err(host(closed.unwrap_err())); }
        return core::result::Ok(0);
    }

    // Copy input to output through depth buffers of block bytes at buffers
    // (depth * block bytes; depth <= 64, 2 * depth <= both ring sizes, block
    // <= 64 MiB). The ring must owe nothing. Positional input (stream false)
    // keeps up to depth reads in flight at offsets 0, block, 2*block, ...
    // (one at first, doubling with each full block); stream
    // input (pipes, stdin) keeps one CURRENT-position read in flight.
    // With output_at >= 0 every chunk a read returns is written at once at
    // output_at plus its input offset, so writes overlap reads and each
    // other. With output_at CURRENT (streams, O_APPEND files) blocks are
    // written one at a time, in input order, at the file position. See
    // cat_output for choosing output_at. Short reads and short writes are
    // continued; EINTR/EAGAIN results are retried. Returns the bytes
    // written, or Read(errno)/Write(errno) of the first failed operation
    // once every operation in flight has completed (transferred() then
    // still counts the bytes written).
    pub fn transfer(&self, input: i32, output: i32, buffers: ptr, block: i32, depth: i32, stream: bool, output_at: i64) -> core::result::Result<i64, Error> {
        if (!self.live) { return core::result::Err(Error::Closed); }
        if (self.owed != 0 || block <= 0 || block > 67108864 || depth <= 0 || depth > 64 || (2 * depth as i64) > self.sq_entries || (2 * depth as i64) > self.cq_entries) {
            return core::result::Err(Error::InvalidInput);
        }
        let ordered: bool = output_at < 0;
        self.moved = 0;
        // Eight words per slot in the ring's scratch page: state (0 free,
        // 1 active, 2 read and waiting for its ordered turn, 4 ended empty
        // and waiting for its turn), input origin, bytes filled, bytes
        // written, ordered sequence, read in flight, writes in flight.
        let v: [i64] = core::mem::typed_slice_from_storage<i64>(self.scratch, 512);
        let z: i32 = 0;
        while (z < depth * 8) { v[z] = 0; z += 1; }
        let next_offset: i64 = 0;
        let stream_at: i64 = 0;
        let next_sequence: i64 = 0;
        let turn: i64 = 0;
        let writing: bool = false;
        let reading: i64 = 0;
        // Reads allowed in flight: 1 at first, doubling with each full block,
        // so a small file costs one read instead of depth.
        let window: i64 = 1;
        let ended: bool = false;
        let failure: i32 = 0;
        let output_failed: bool = false;
        let total: i64 = 0;
        let active: i64 = 0;
        let size: usize = block as usize;
        while (true) {
            // Start reads in free slots while input remains.
            let s: i32 = 0;
            while (s < depth) {
                let f: i32 = s * 8;
                let start: bool = v[f] == 0 && !ended && failure == 0;
                if (start && reading >= window) { start = false; }
                if (start) {
                    v[f] = 1; v[f + 1] = next_offset; v[f + 2] = 0; v[f + 3] = 0; v[f + 4] = next_sequence; v[f + 5] = 1; v[f + 6] = 0;
                    let at: i64 = next_offset;
                    if (stream) { at = CURRENT; }
                    next_offset += block as i64; next_sequence += 1;
                    self.read(input, buffers + (s as usize) * size, block, at, s as u64);
                    reading += 1; active += 1;
                }
                s += 1;
            }
            // Ordered output: issue the write whose turn it is.
            if (ordered && !writing) {
                let w: i32 = 0;
                while (w < depth) {
                    let f: i32 = w * 8;
                    let waiting: bool = v[f] == 2 || v[f] == 4;
                    if (waiting && v[f + 4] == turn) {
                        if (v[f] == 4) { v[f] = 0; turn += 1; w = 0; }
                        else {
                            v[f] = 1; v[f + 6] = 1; writing = true; active += 1;
                            let c0: i64 = v[f + 3];
                            let length: i64 = v[f + 2] - c0;
                            self.write(output, buffers + (w as usize) * size + (c0 as usize), length as i32, CURRENT, write_tag(w, c0, length));
                            w = depth;
                        }
                    } else { w += 1; }
                }
            }
            if (active == 0) { break; }
            let got: core::result::Result<Completion, Error> = self.wait();
            if (got.is_err()) { return core::result::Err(got.unwrap_err()); }
            let done: Completion = got.unwrap();
            active -= 1;
            let tag: i64 = done.user_data as i64;
            let slot: i32 = (tag & 255) as i32;
            let f: i32 = slot * 8;
            let res: i32 = done.result;
            let buffer: ptr = buffers + (slot as usize) * size;
            let retry: bool = res == 0 - EINTR || res == 0 - EAGAIN;
            if ((tag & 256) == 0) {
                if (retry) {
                    let at: i64 = v[f + 1] + v[f + 2];
                    if (stream) { at = CURRENT; }
                    self.read(input, buffer + (v[f + 2] as usize), block - (v[f + 2] as i32), at, slot as u64);
                    active += 1;
                } else {
                    if (res < 0 && failure == 0) { failure = 0 - res; }
                    let begin: i64 = v[f + 2];
                    if (res > 0) {
                        v[f + 2] = begin + (res as i64);
                        // A stream block's offset is where its bytes landed.
                        if (stream) { v[f + 1] = stream_at; stream_at += res as i64; }
                        if (!ordered && failure == 0) {
                            v[f + 6] = v[f + 6] + 1; active += 1;
                            self.write(output, buffer + (begin as usize), res, output_at + v[f + 1] + begin, write_tag(slot, begin, res as i64));
                        }
                    }
                    if (!stream && v[f + 2] == (block as i64) && window < (depth as i64)) { window = window * 2; }
                    let more: bool = res > 0 && !stream && v[f + 2] < (block as i64) && failure == 0;
                    if (more) {
                        // Short positional read: continue the block.
                        self.read(input, buffer + (v[f + 2] as usize), block - (v[f + 2] as i32), v[f + 1] + v[f + 2], slot as u64);
                        active += 1;
                    } else {
                        v[f + 5] = 0; reading -= 1;
                        if (res <= 0) { ended = true; }
                        if (ordered) {
                            if (v[f + 2] > 0 && failure == 0) { v[f] = 2; } else { v[f] = 4; }
                        }
                    }
                }
            } else {
                v[f + 6] = v[f + 6] - 1;
                let c0: i64 = (tag / 512) & 134217727;
                let length: i64 = tag / 68719476736;
                if (!retry && res < 0 && failure == 0) { failure = 0 - res; output_failed = true; }
                // A zero-byte write of a nonempty chunk would never finish.
                if (res == 0 && failure == 0) { failure = 5; output_failed = true; }
                let sent: i64 = 0;
                if (res > 0) { sent = res as i64; v[f + 3] = v[f + 3] + sent; total += sent; self.moved = total; }
                if (sent < length && failure == 0) {
                    let at: i64 = CURRENT;
                    if (!ordered) { at = output_at + v[f + 1] + c0 + sent; }
                    v[f + 6] = v[f + 6] + 1; active += 1;
                    self.write(output, buffer + ((c0 + sent) as usize), (length - sent) as i32, at, write_tag(slot, c0 + sent, length - sent));
                } else {
                    if (ordered && v[f + 6] == 0) { writing = false; v[f] = 0; turn += 1; }
                }
            }
            // Positional slots finish when their reads and writes have.
            if (!ordered && v[f] == 1 && v[f + 5] == 0 && v[f + 6] == 0) { v[f] = 0; }
            // After a failure, ordered slots still waiting will never write.
            if (failure != 0 && ordered && !writing) {
                let q: i32 = 0;
                while (q < depth) { if (v[q * 8] == 2 || v[q * 8] == 4) { v[q * 8] = 0; } q += 1; }
            }
        }
        if (failure != 0 && output_failed) { return core::result::Err(Error::Write(failure)); }
        if (failure != 0) { return core::result::Err(Error::Read(failure)); }
        return core::result::Ok(total);
    }
}
