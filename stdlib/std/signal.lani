// Explicit Linux x86_64 process-wide signal dispositions. No custom handlers,
// callbacks or trampolines. See docs/stdlib-signals.md.
module std::signal;
import core::io;
import core::mem;
import core::result;
import core::slice;
import std::linux;

pub enum Signal { Hangup, Interrupt, Quit, User1, User2, BrokenPipe, Alarm, Terminate, Child }
pub enum Disposition { Default, Ignore }
fn number(signal: Signal) -> i64 {
    return match (signal) { Signal::Hangup -> 1, Signal::Interrupt -> 2, Signal::Quit -> 3, Signal::User1 -> 10, Signal::User2 -> 12, Signal::BrokenPipe -> 13, Signal::Alarm -> 14, Signal::Terminate -> 15, Signal::Child -> 17 };
}
// This changes the disposition for every thread in the calling process.
// Success returns zero; kernel errors are preserved as checked I/O errors.
pub fn set_disposition(signal: Signal, disposition: Disposition) -> core::result::Result<i32,core::io::Error> {
    // Kernel sigaction: 64-bit handler, flags, restorer, then 8-byte signal set.
    // SIG_DFL=0 and SIG_IGN=1 need no signal-return trampoline or SA_RESTORER.
    let action: [i32;8] = [0;8];
    action[0] = match (disposition) { Disposition::Default -> 0, Disposition::Ignore -> 1 };
    let empty: ptr = 0;
    let arguments: [std::linux::Argument;6] = [std::linux::Argument::Word(number(signal)),std::linux::Argument::Address(core::mem::i32_array_data_ptr(action)),std::linux::Argument::Address(empty),std::linux::Argument::Word(8),std::linux::Argument::Word(0),std::linux::Argument::Word(0)];
    let result: core::result::Result<i64,std::linux::Error> = std::linux::call(13,core::slice::view(arguments,6).unwrap());
    if (result.is_err()) {
        let error: core::io::Error = match (result.unwrap_err()) { std::linux::Error::System(code) -> system_error(code), _ -> core::io::Error::InvalidInput };
        return core::result::Err(error);
    }
    if (result.unwrap() != 0) { return core::result::Err(core::io::Error::InvalidCount); }
    return core::result::Ok(0);
}
fn system_error(code: i32) -> core::io::Error {
    if (code == 4) { return core::io::Error::Interrupted; }
    if (code == 11) { return core::io::Error::WouldBlock; }
    return core::io::Error::Host(code);
}
