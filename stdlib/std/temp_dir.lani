// Manual named temporary-directory ownership on x86_64 Linux. The namespace
// must be cooperative; an anchored parent does not secure hostile child names.
module std::temp_dir;
import alloc::vec;
import core::io;
import core::option;
import core::path;
import core::result;
import core::slice;
import std::entropy;
import std::file;
import std::file_ops;

pub const NAME_BYTES:i32=37;
pub const MAX_NAME_ATTEMPTS:u32=1024;
pub const MAX_ENTROPY_CALLS:u64=1048576;
pub struct Limits { name_attempts:u32, entropy_calls:u64 }
pub enum State { Inactive, Open, ClosedNamed, Kept, CleanupPending, Released }
pub enum Stage { Validate, Allocate, Duplicate, Metadata, Flags, Entropy, Create, OpenDirectory, CloseDirectory, Remove, CloseParent }
pub enum Error { InvalidState, InvalidLimits, AllocationFailed, UnavailableMetadata, NotDirectory, UnsupportedDescriptor, NameLimit, Io(core::io::Error), Entropy(std::entropy::Failure) }
pub enum Removal { NotOwned, Removed, AlreadyAbsent, Unconfirmed }
pub struct Stats { name_attempts:u32, mkdir_attempts:u32, open_attempts:u32, collisions:u32, entropy_calls:u64 }
pub struct Cleanup {
    directory_close_attempted:bool, directory_close_error:core::option::Option<core::io::Error>,
    remove_attempted:bool, removal:Removal, remove_error:core::option::Option<core::io::Error>,
    parent_close_attempted:bool, parent_close_error:core::option::Option<core::io::Error>,
    retained:bool
}
pub struct Failure { stage:Stage, cause:Error, state:State, stats:Stats, cleanup:Cleanup }
struct Diagnostic { stage:Stage, cause:Error }
pub struct TempDir {
    directory_owner:std::file::File, parent_owner:std::file::File,
    name_bytes:alloc::vec::Vec<u8>, owns_name:bool, kept:bool, current:State,
    counters:Stats, cleanup_record:Cleanup, primary:core::option::Option<Diagnostic>
}

pub fn default_limits() -> Limits { return Limits { name_attempts:32,entropy_calls:128 }; }
fn empty_stats() -> Stats { return Stats { name_attempts:0,mkdir_attempts:0,open_attempts:0,collisions:0,entropy_calls:0 }; }
fn empty_cleanup() -> Cleanup {
    return Cleanup { directory_close_attempted:false,directory_close_error:core::option::None(),remove_attempted:false,removal:Removal::NotOwned,remove_error:core::option::None(),parent_close_attempted:false,parent_close_error:core::option::None(),retained:false };
}
pub fn empty() -> TempDir {
    return TempDir { directory_owner:std::file::File { handle:-1 },parent_owner:std::file::File { handle:-1 },name_bytes:alloc::vec::new(),owns_name:false,kept:false,current:State::Inactive,counters:empty_stats(),cleanup_record:empty_cleanup(),primary:core::option::None() };
}
fn host(error:core::io::Error,code:i32) -> bool { return match(error) { core::io::Error::Host(value)->value==code, _->false }; }
fn digit(value:u8) -> u8 { if(value<10) { return 48+value; } return 87+value; }

pub impl TempDir {
    pub fn borrow(&self) -> &TempDir { return self; }
    pub fn state(&self) -> State { return self.current; }
    pub fn stats(&self) -> Stats { return self.counters; }
    pub fn last_cleanup(&self) -> Cleanup { return self.cleanup_record; }
    pub fn owns_temporary_name(&self) -> bool { return self.owns_name; }
    // Borrowed owners only: do not close/take/replace either File. Child
    // operations must preserve the generated directory's name and identity.
    pub fn parent(&self) -> &std::file::File { return self.parent_owner.borrow(); }
    pub fn directory(&self) -> &std::file::File { return self.directory_owner.borrow(); }
    // Empty before successful mkdir; keep preserves this borrow until cleanup.
    pub fn name(&self) -> core::slice::View<u8> {
        if(self.owns_name || self.kept) { return self.name_bytes.as_view(); }
        return core::slice::View { values:self.name_bytes.as_slice(),start:0,length:0 };
    }
    pub fn last_failure(&self) -> core::option::Option<Failure> {
        if(self.primary.is_none()) { return core::option::None(); }
        let cause:Diagnostic=self.primary.unwrap();
        let receipt:Cleanup=self.cleanup_record; receipt.retained=self.has_resources();
        return core::option::Some(Failure { stage:cause.stage,cause:cause.cause,state:self.current,stats:self.counters,cleanup:receipt });
    }
    fn remember(&self,stage:Stage,cause:Error) {
        if(self.primary.is_none()) { self.primary=core::option::Some(Diagnostic { stage:stage,cause:cause }); }
    }
    fn failed(&self,stage:Stage,cause:Error) -> Failure {
        self.remember(stage,cause); return self.last_failure().unwrap();
    }
    fn has_resources(&self) -> bool {
        return self.directory_owner.is_open() || self.parent_owner.is_open() || self.name_bytes.capacity()!=0 || self.owns_name;
    }
    fn can_create(&self) -> bool { return match(self.current) { State::Inactive->true,State::Released->true,_ ->false }; }

    pub fn create_in(&self,parent:&std::file::File,limits:Limits) -> core::result::Result<bool,Failure> {
        if(!self.can_create() || self.has_resources()) {
            let receipt:Cleanup=self.cleanup_record; receipt.retained=self.has_resources();
            return core::result::Err(Failure { stage:Stage::Validate,cause:Error::InvalidState,state:self.current,stats:self.counters,cleanup:receipt });
        }
        self.counters=empty_stats(); self.cleanup_record=empty_cleanup(); self.primary=core::option::None(); self.kept=false; self.current=State::Inactive;
        if(limits.name_attempts==0 || limits.name_attempts>MAX_NAME_ATTEMPTS || limits.entropy_calls==0 || limits.entropy_calls>MAX_ENTROPY_CALLS) {
            return core::result::Err(self.failed(Stage::Validate,Error::InvalidLimits));
        }
        let made:core::result::Result<alloc::vec::Vec<u8>,alloc::vec::Error> =alloc::vec::with_capacity(NAME_BYTES);
        if(made.is_err()) { return core::result::Err(self.failed(Stage::Allocate,Error::AllocationFailed)); }
        self.name_bytes=made.unwrap(); self.current=State::CleanupPending;
        if(self.name_bytes.try_resize(NAME_BYTES,0).is_err()) { return core::result::Err(self.failed(Stage::Allocate,Error::AllocationFailed)); }
        let copied=std::file_ops::duplicate(parent,0,true);
        if(copied.is_err()) { return core::result::Err(self.failed(Stage::Duplicate,Error::Io(copied.unwrap_err()))); }
        self.parent_owner=copied.unwrap();
        let metadata:std::file_ops::Metadata=std::file_ops::empty_metadata();
        let queried=std::file_ops::metadata_file_into(self.parent_owner.borrow(),metadata.borrow());
        if(queried.is_err()) { return core::result::Err(self.failed(Stage::Metadata,Error::Io(queried.unwrap_err()))); }
        if(!metadata.has(1)) { return core::result::Err(self.failed(Stage::Metadata,Error::UnavailableMetadata)); }
        let directory:bool=match(std::file_ops::kind(metadata.mode)) { std::file_ops::Kind::Directory->true,_ ->false };
        if(!directory) { return core::result::Err(self.failed(Stage::Metadata,Error::NotDirectory)); }
        let flags=std::file_ops::status_flags(self.parent_owner.borrow());
        if(flags.is_err()) { return core::result::Err(self.failed(Stage::Flags,Error::Io(flags.unwrap_err()))); }
        if((flags.unwrap()&2097152)!=0) { return core::result::Err(self.failed(Stage::Flags,Error::UnsupportedDescriptor)); }
        let calls:std::entropy::Budget=std::entropy::budget(limits.entropy_calls);
        let random:[u8;16]=[0;16]; let name:[u8]=self.name_bytes.as_slice();
        let options:std::file_ops::OpenOptions=std::file_ops::options();
        options.directory=true; options.no_follow=true; options.close_on_exec=true;
        while(self.counters.name_attempts<limits.name_attempts) {
            self.counters.name_attempts+=1;
            let filled=std::entropy::fill_bounded(calls.borrow(),random,0,16);
            self.counters.entropy_calls=limits.entropy_calls-calls.remaining();
            if(filled.is_err()) { return core::result::Err(self.failed(Stage::Entropy,Error::Entropy(filled.unwrap_err()))); }
            name[0]=46; name[1]=116; name[2]=109; name[3]=112; name[4]=45;
            let index:i32=0;
            while(index<16) { name[5+index*2]=digit(random[index]>>4); name[6+index*2]=digit(random[index]&15); index+=1; }
            let path:core::path::Path=core::path::from_view(self.name_bytes.as_view()).unwrap();
            self.counters.mkdir_attempts+=1;
            let made_directory=std::file_ops::create_dir_at(self.parent_owner.raw_handle().unwrap(),path,448);
            if(made_directory.is_ok()) {
                // Record removal authority immediately. Every later failure,
                // including open, must retain this name and its parent anchor.
                self.owns_name=true;
                self.counters.open_attempts+=1;
                let opened=std::file_ops::open_at(self.parent_owner.raw_handle().unwrap(),path,options);
                if(opened.is_err()) { return core::result::Err(self.failed(Stage::OpenDirectory,Error::Io(opened.unwrap_err()))); }
                self.directory_owner=opened.unwrap(); self.current=State::Open;
                return core::result::Ok(true);
            }
            let error:core::io::Error=made_directory.unwrap_err();
            if(!host(error,17)) { return core::result::Err(self.failed(Stage::Create,Error::Io(error))); }
            self.counters.collisions+=1;
        }
        return core::result::Err(self.failed(Stage::Create,Error::NameLimit));
    }

    // Retire the child descriptor only, without changing removal authority.
    pub fn close_directory(&self) -> core::result::Result<bool,Failure> {
        if(!self.directory_owner.is_open()) { return core::result::Ok(false); }
        let receipt:Cleanup=empty_cleanup(); receipt.directory_close_attempted=true;
        let closed=self.directory_owner.close();
        if(self.owns_name) { self.current=State::ClosedNamed; }
        if(closed.is_err()) {
            let error:core::io::Error=closed.unwrap_err(); receipt.directory_close_error=core::option::Some(error);
            self.remember(Stage::CloseDirectory,Error::Io(error));
        }
        receipt.retained=self.has_resources(); self.cleanup_record=receipt;
        if(closed.is_err()) { return core::result::Err(self.last_failure().unwrap()); }
        return core::result::Ok(true);
    }

    // Pure disarm on this owner. The caller accepts responsibility for the
    // named directory; copy name() before later cleanup releases its backing.
    pub fn keep(&self) -> core::result::Result<bool,Error> {
        if(self.kept) { return core::result::Ok(false); }
        if(!self.owns_name) { return core::result::Err(Error::InvalidState); }
        self.owns_name=false; self.kept=true; self.current=State::Kept;
        return core::result::Ok(true);
    }

    pub fn cleanup(&self) -> core::result::Result<Cleanup,Failure> {
        let receipt:Cleanup=empty_cleanup();
        if(!self.has_resources()) { self.current=State::Released; self.cleanup_record=receipt; return core::result::Ok(receipt); }
        let failed:bool=false;
        // Keep both descriptors live until empty removal is resolved. A caller
        // can remove its children through directory() after ENOTEMPTY and retry.
        if(self.owns_name) {
            receipt.removal=Removal::Unconfirmed;
            let raw:core::option::Option<i32> =self.parent_owner.raw_handle();
            if(raw.is_none()) {
                receipt.remove_error=core::option::Some(core::io::Error::Host(9)); failed=true;
                self.remember(Stage::Remove,Error::Io(core::io::Error::Host(9)));
            } else {
                receipt.remove_attempted=true;
                let path:core::path::Path=core::path::from_view(self.name_bytes.as_view()).unwrap();
                let removed=std::file_ops::remove_dir_at(raw.unwrap(),path);
                if(removed.is_ok()) { self.owns_name=false; receipt.removal=Removal::Removed; }
                else {
                    let error:core::io::Error=removed.unwrap_err();
                    if(host(error,2)) { self.owns_name=false; receipt.removal=Removal::AlreadyAbsent; }
                    else { receipt.remove_error=core::option::Some(error); failed=true; self.remember(Stage::Remove,Error::Io(error)); }
                }
            }
        }
        if(self.owns_name) { self.current=State::CleanupPending; }
        else {
            if(self.directory_owner.is_open()) {
                receipt.directory_close_attempted=true; let closed=self.directory_owner.close();
                if(closed.is_err()) {
                    let error:core::io::Error=closed.unwrap_err(); receipt.directory_close_error=core::option::Some(error); failed=true;
                    self.remember(Stage::CloseDirectory,Error::Io(error));
                }
            }
            if(self.parent_owner.is_open()) {
                receipt.parent_close_attempted=true; let closed=self.parent_owner.close();
                if(closed.is_err()) {
                    let error:core::io::Error=closed.unwrap_err(); receipt.parent_close_error=core::option::Some(error); failed=true;
                    self.remember(Stage::CloseParent,Error::Io(error));
                }
            }
            self.name_bytes.destroy(); self.kept=false; self.current=State::Released;
        }
        receipt.retained=self.has_resources(); self.cleanup_record=receipt;
        if(failed) { return core::result::Err(self.last_failure().unwrap()); }
        return core::result::Ok(receipt);
    }
    pub fn destroy(&self) -> core::result::Result<Cleanup,Failure> { return self.cleanup(); }
}
