// Dense signed-byte-keyed map in caller-owned storage. `keys` needs eight
// u32 words and `values` needs 256 u32 words; they must not overlap. Call
// clear before reading a fresh map. Keys iterate from -128 through 127.
// No allocation or destructor is needed.
module std::map_i8_u32;
import std::map_u8_u32;
import std::set_i8;

fn code(key: i8) -> u8 {
    let signed: i32 = key as i32;
    let shifted: i32 = signed + 128;
    let byte: u8 = shifted as u8;
    return byte;
}

pub fn len(keys: [u32]) -> i32 {
    return std::map_u8_u32::len(keys);
}

pub fn is_empty(keys: [u32]) -> bool {
    return std::map_u8_u32::is_empty(keys);
}

pub fn is_full(keys: [u32]) -> bool {
    return std::map_u8_u32::is_full(keys);
}

pub fn contains_key(keys: [u32], key: i8) -> bool {
    return std::map_u8_u32::contains_key(keys, code(key));
}

// Missing keys return fallback, which may equal a stored value. Check
// contains_key when the distinction matters.
pub fn get_or(keys: [u32], values: [u32], key: i8, fallback: u32) -> u32 {
    return std::map_u8_u32::get_or(keys, values, code(key), fallback);
}

// Invalid ordinals return fallback. Keys follow signed numeric order.
pub fn key_at_or(keys: [u32], ordinal: i32, fallback: i8) -> i8 {
    return std::set_i8::at_or(keys, ordinal, fallback);
}

pub fn value_at_or(keys: [u32], values: [u32], ordinal: i32, fallback: u32) -> u32 {
    if (ordinal < 0 || ordinal >= len(keys)) { return fallback; }
    let key: i8 = key_at_or(keys, ordinal, 0);
    return get_or(keys, values, key, fallback);
}

// Insert only a missing key; duplicates preserve the old value.
pub fn insert(keys: [u32], values: [u32], key: i8, value: u32) -> bool {
    return std::map_u8_u32::insert(keys, values, code(key), value);
}

// Store value for a key. True means a new key; false means replacement.
pub fn put(keys: [u32], values: [u32], key: i8, value: u32) -> bool {
    return std::map_u8_u32::put(keys, values, code(key), value);
}

// Update only a present key; a missing key leaves storage unchanged.
pub fn set(keys: [u32], values: [u32], key: i8, value: u32) -> bool {
    return std::map_u8_u32::set(keys, values, code(key), value);
}

// Remove a present key and zero its value. A missing key returns false.
pub fn remove(keys: [u32], values: [u32], key: i8) -> bool {
    return std::map_u8_u32::remove(keys, values, code(key));
}

// Initialize or reset all eight key words and 256 value words.
pub fn clear(keys: [u32], values: [u32]) {
    std::map_u8_u32::clear(keys, values);
}
