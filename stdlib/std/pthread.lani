// Native threads: glibc pthread_create/pthread_join with a Lanius function
// as the start routine. A non-generic `fn name(arg: ptr) -> ptr` named as a
// value is a ptr to its C entry (docs/language-ergonomics.md, "C callbacks"),
// which loads R15 with the process vector, so thread bodies can call the
// runtime's services. Native link with --native-link --native-library atomic
// (std::sync's Mutex and Condvar coordinate threads through libatomic and
// futexes). Every thread must be joined before main returns: main's return
// unmaps the process vector. The runtime heap allocator is thread-safe (each
// thread uses its own pool), so thread bodies may allocate; they can still
// work in memory the caller prepared (a std::sync::Region, map_buffers, a Vec)
// to avoid per-thread arenas. See docs/stdlib-threads.md.
//
// std::thread keeps the older unbound service-8 declarations, which the
// compiler's admission diagnostics recognize by path.
module std::pthread;
import core::mem;
import core::result;
import core::slice;
import std::linux;

extern "C" fn pthread_create(thread: ptr, attr: ptr, start: ptr, arg: ptr) -> i32;
extern "C" fn pthread_join(thread: u64, result: ptr) -> i32;
extern "C" fn pthread_attr_init(attr: ptr) -> i32;
extern "C" fn pthread_attr_setstacksize(attr: ptr, size: usize) -> i32;
extern "C" fn pthread_attr_destroy(attr: ptr) -> i32;
extern "C" fn pthread_self() -> u64;

// Host(code) carries pthread's error number (EAGAIN 11 when the process is
// out of threads or memory, EINVAL 22, EDEADLK 35 for joining oneself).
pub enum Error { Host(i32), InvalidInput, Joined }

// glibc's PTHREAD_STACK_MIN on x86_64.
pub const MIN_STACK_BYTES: usize = 16384;

pub struct Thread { id: u64, joined: bool }

// Start entry(arg) on a new thread with glibc's default stack (8 MiB).
pub fn spawn(entry: ptr, arg: ptr) -> core::result::Result<Thread, Error> { return spawn_with_stack(entry, arg, 0); }
// stack_bytes 0 means the default; otherwise at least MIN_STACK_BYTES.
pub fn spawn_with_stack(entry: ptr, arg: ptr, stack_bytes: usize) -> core::result::Result<Thread, Error> {
    let nowhere: ptr = 0;
    if (entry == nowhere) { return core::result::Err(Error::InvalidInput); }
    if (stack_bytes != 0 && stack_bytes < MIN_STACK_BYTES) { return core::result::Err(Error::InvalidInput); }
    let handle: [i32; 2] = [0; 2];
    let slot: ptr = core::mem::i32_array_data_ptr(handle);
    let rc: i32 = 0;
    if (stack_bytes == 0) { rc = pthread_create(slot, nowhere, entry, arg); }
    else {
        // pthread_attr_t is 56 bytes on x86_64 glibc.
        let words: [i32; 16] = [0; 16];
        let attr: ptr = core::mem::i32_array_data_ptr(words);
        rc = pthread_attr_init(attr);
        if (rc == 0) { rc = pthread_attr_setstacksize(attr, stack_bytes); }
        if (rc == 0) { rc = pthread_create(slot, attr, entry, arg); }
        pthread_attr_destroy(attr);
    }
    if (rc != 0) { return core::result::Err(Error::Host(rc)); }
    let id: [u64] = core::mem::typed_slice_from_raw_parts<u64>(slot, 1);
    return core::result::Ok(Thread { id: id[0], joined: false });
}

pub impl Thread {
    pub fn borrow(&self) -> &Thread { return self; }
    pub fn id(&self) -> u64 { return self.id; }
    pub fn is_joined(&self) -> bool { return self.joined; }
    // Wait for the thread to finish; its entry's return value. A thread can
    // be joined once.
    pub fn join(&self) -> core::result::Result<ptr, Error> {
        if (self.joined) { return core::result::Err(Error::Joined); }
        let words: [i32; 2] = [0; 2];
        let slot: ptr = core::mem::i32_array_data_ptr(words);
        let rc: i32 = pthread_join(self.id, slot);
        if (rc != 0) { return core::result::Err(Error::Host(rc)); }
        self.joined = true;
        let result: [ptr] = core::mem::typed_slice_from_raw_parts<ptr>(slot, 1);
        return core::result::Ok(result[0]);
    }
}

// Join a thread by id (Thread::id), for callers that keep ids in shared
// memory instead of Thread values. Each thread must be joined exactly once.
pub fn join_id(id: u64) -> core::result::Result<ptr, Error> {
    let thread: Thread = Thread { id: id, joined: false };
    return thread.join();
}
// The calling thread's pthread id (equal to a Thread::id on that thread).
pub fn current() -> u64 { return pthread_self(); }
pub fn yield_now() {
    let none: [std::linux::Argument; 1] = [std::linux::Argument::Word(0)];
    std::linux::call(24, core::slice::view(none, 0).unwrap());
}
// CPUs this thread may run on (sched_getaffinity), at least 1.
pub fn available_parallelism() -> i32 {
    let words: [i32; 32] = [0; 32];
    let mask: ptr = core::mem::i32_array_data_ptr(words);
    let args: [std::linux::Argument; 3] = [std::linux::Argument::Word(0), std::linux::Argument::Word(128), std::linux::Argument::Address(mask)];
    let done: core::result::Result<i64, std::linux::Error> = std::linux::call(204, core::slice::view(args, 3).unwrap());
    if (done.is_err()) { return 1; }
    let length: i32 = done.unwrap() as i32;
    let bytes: [u8] = core::mem::typed_slice_from_raw_parts<u8>(mask, 128);
    let count: i32 = 0; let i: i32 = 0;
    while (i < length) {
        let b: u8 = bytes[i];
        while (b != 0) { count += (b & 1) as i32; b = b >> 1; }
        i += 1;
    }
    if (count < 1) { return 1; }
    return count;
}
