// Decimal stream input and output built on bound single-byte I/O operations.
// write_u32 emits every digit without allocation. It returns the byte count
// (1..10), the first negative host error, or -1 if a byte write does not
// report exactly one byte. An error can leave a decimal prefix on the handle.
module std::io_decimal;
import core::decimal;
import core::mem;
import core::wide_i64;
import core::wide_u64;
import std::io;
pub fn write_u32(handle: i32, value: u32) -> i32 {
    let length: u32 = core::decimal::len_u32(value);
    let position: u32 = 0;
    while (position<length) {
        let byte: u8 = core::decimal::byte_at_or_u32(value, position, 0);
        let byte_i32: i32 = byte;
        let written: i32 = std::io::write_byte(handle, byte_i32);
        if (written<0) {
            return written;
        }
        if (written != 1) {
            return -1;
        }
        position += 1;
    }
    return length;
}

// Writes a signed decimal value, including the sign for negatives. Returns
// the complete byte count (1..11), the first negative host error, or -1 if a
// byte write does not report exactly one byte. A failure can leave a prefix.
pub fn write_i32(handle: i32, value: i32) -> i32 {
    let length: u32 = core::decimal::len_i32(value);
    let position: u32 = 0;
    while (position<length) {
        let byte: u8 = core::decimal::byte_at_or_i32(value, position, 0);
        let byte_i32: i32 = byte;
        let written: i32 = std::io::write_byte(handle, byte_i32);
        if (written<0) {
            return written;
        }
        if (written != 1) {
            return -1;
        }
        position += 1;
    }
    return length;
}

// Write a full-width two-word unsigned value. Return the byte count (1..20),
// the first negative host error, or -1 for a short write. A failure may leave
// a prefix on the handle.
pub fn write_wide_u64(handle: i32, value: core::wide_u64::WideU64) -> i32 {
    let length: u32 = core::wide_u64::decimal_len(value);
    let position: u32 = 0;
    while (position < length) {
        let byte: u8 = core::wide_u64::decimal_byte_at_or(value, position, 0);
        let code: i32 = byte;
        let written: i32 = std::io::write_byte(handle, code);
        if (written < 0) { return written; }
        if (written != 1) { return -1; }
        position += 1;
    }
    return length;
}

// Signed values include a leading minus byte when negative. Return the
// complete byte count (1..20), a negative host error, or -1 for a short write.
pub fn write_wide_i64(handle: i32, value: core::wide_i64::WideI64) -> i32 {
    let length: u32 = core::wide_i64::decimal_len(value);
    let position: u32 = 0;
    while (position < length) {
        let byte: u8 = core::wide_i64::decimal_byte_at_or(value, position, 0);
        let code: i32 = byte;
        let written: i32 = std::io::write_byte(handle, code);
        if (written < 0) { return written; }
        if (written != 1) { return -1; }
        position += 1;
    }
    return length;
}

// Narrow integer writers widen without changing the value, then inherit the
// 32-bit writers' complete byte count and first-error behavior.
pub fn write_u8(handle: i32, value: u8) -> i32 {
    let widened: u32 = value as u32;
    return write_u32(handle, widened);
}

pub fn write_u16(handle: i32, value: u16) -> i32 {
    let widened: u32 = value as u32;
    return write_u32(handle, widened);
}

pub fn write_i8(handle: i32, value: i8) -> i32 {
    let widened: i32 = value as i32;
    return write_i32(handle, widened);
}

pub fn write_i16(handle: i32, value: i16) -> i32 {
    let widened: i32 = value as i32;
    return write_i32(handle, widened);
}

// Read all of stdin as a bounded unsigned ASCII decimal. Leading and trailing
// SP, HT, LF, and CR and one leading plus are accepted. Invalid syntax,
// overflow, early host failure, or input longer than max_bytes returns
// fallback. A failed call may already have consumed an input prefix.
pub fn read_u32_stdin_or(max_bytes: u32, fallback: u32) -> u32 {
    if (max_bytes == 0) {
        return fallback;
    }
    let cell: [i32; 1] = [0];
    let data: ptr = core::mem::i32_array_data_ptr(cell);
    let consumed: u32 = 0;
    let value: u32 = 0;
    let started: bool = false;
    let digits: bool = false;
    let trailing: bool = false;
    while (true) {
        cell[0] = 0;
        let received: i32 = std::io::read_stdin(data, 1);
        if (received == 0) {
            break;
        }
        if (received != 1 || consumed >= max_bytes) {
            return fallback;
        }
        consumed += 1;
        let byte: i32 = cell[0];
        if (byte == 32 || byte == 9 || byte == 10 || byte == 13) {
            if (started && !digits) {
                return fallback;
            }
            if (digits) {
                trailing = true;
            }
            continue;
        }
        if (byte == 43) {
            if (started || trailing) {
                return fallback;
            }
            started = true;
            continue;
        }
        if (byte >= 48 && byte <= 57) {
            if (trailing) {
                return fallback;
            }
            started = true;
            digits = true;
            let ascii: u8 = byte;
            let limit: u32 = 4294967295;
            if (!core::decimal::can_append_ascii_digit_u32(value, ascii, limit)) {
                return fallback;
            }
            value = core::decimal::append_ascii_digit_or_u32(value, ascii, limit, value);
            continue;
        }
        return fallback;
    }
    if (!digits) {
        return fallback;
    }
    return value;
}

// Signed variant accepts one leading plus or minus and checks each digit
// against the appropriate i32 magnitude. MIN is returned without negation.
pub fn read_i32_stdin_or(max_bytes: u32, fallback: i32) -> i32 {
    if (max_bytes == 0) {
        return fallback;
    }
    let cell: [i32; 1] = [0];
    let data: ptr = core::mem::i32_array_data_ptr(cell);
    let consumed: u32 = 0;
    let magnitude: u32 = 0;
    let started: bool = false;
    let digits: bool = false;
    let trailing: bool = false;
    let negative: bool = false;
    while (true) {
        cell[0] = 0;
        let received: i32 = std::io::read_stdin(data, 1);
        if (received == 0) {
            break;
        }
        if (received != 1 || consumed >= max_bytes) {
            return fallback;
        }
        consumed += 1;
        let byte: i32 = cell[0];
        if (byte == 32 || byte == 9 || byte == 10 || byte == 13) {
            if (started && !digits) {
                return fallback;
            }
            if (digits) {
                trailing = true;
            }
            continue;
        }
        if (byte == 43 || byte == 45) {
            if (started || trailing) {
                return fallback;
            }
            started = true;
            negative = byte == 45;
            continue;
        }
        if (byte >= 48 && byte <= 57) {
            if (trailing) {
                return fallback;
            }
            started = true;
            digits = true;
            let ascii: u8 = byte;
            let limit: u32 = 2147483647;
            if (negative) {
                limit = 2147483648;
            }
            if (!core::decimal::can_append_ascii_digit_u32(magnitude, ascii, limit)) {
                return fallback;
            }
            magnitude = core::decimal::append_ascii_digit_or_u32(magnitude, ascii, limit, magnitude);
            continue;
        }
        return fallback;
    }
    if (!digits) {
        return fallback;
    }
    if (negative) {
        if (magnitude == 2147483648) {
            return -2147483648;
        }
        let positive: i32 = magnitude;
        return -positive;
    }
    let positive: i32 = magnitude;
    return positive;
}

fn append_wide_digit(value: core::wide_u64::WideU64, digit: u32) -> core::wide_u64::WideU64 {
    return core::wide_u64::wrapping_add(
        core::wide_u64::wrapping_mul(value, core::wide_u64::from_u32(10)),
        core::wide_u64::from_u32(digit));
}

// Read a full-width unsigned decimal from all of stdin. Accept surrounding
// SP, HT, LF, and CR, and one leading plus sign. Empty, malformed, overlong,
// overflowing, or failed reads return fallback. Failure may consume a prefix.
pub fn read_wide_u64_stdin_or(
    max_bytes: u32, fallback: core::wide_u64::WideU64
) -> core::wide_u64::WideU64 {
    if (max_bytes == 0) { return fallback; }
    let cell: [i32; 1] = [0];
    let data: ptr = core::mem::i32_array_data_ptr(cell);
    let consumed: u32 = 0;
    let value: core::wide_u64::WideU64 = core::wide_u64::zero();
    let threshold: core::wide_u64::WideU64 =
        core::wide_u64::from_words(429496729, 2576980377); // u64::MAX / 10
    let started: bool = false;
    let digits: bool = false;
    let trailing: bool = false;
    while (true) {
        cell[0] = 0;
        let received: i32 = std::io::read_stdin(data, 1);
        if (received == 0) { break; }
        if (received != 1 || consumed >= max_bytes) { return fallback; }
        consumed += 1;
        let byte: i32 = cell[0];
        if (byte == 32 || byte == 9 || byte == 10 || byte == 13) {
            if (started && !digits) { return fallback; }
            if (digits) { trailing = true; }
            continue;
        }
        if (byte == 43) {
            if (started || trailing) { return fallback; }
            started = true;
            continue;
        }
        if (byte >= 48 && byte <= 57) {
            if (trailing) { return fallback; }
            started = true;
            digits = true;
            let digit_i32: i32 = byte - 48;
            let digit: u32 = digit_i32;
            let order: i32 = core::wide_u64::compare(value, threshold);
            if (order > 0 || (order == 0 && digit > 5)) { return fallback; }
            value = append_wide_digit(value, digit);
            continue;
        }
        return fallback;
    }
    if (!digits) { return fallback; }
    return value;
}

// Signed variant accepts one leading plus or minus and bounds the magnitude
// to i64::MAX or 2^63. Negative zero is returned as zero.
pub fn read_wide_i64_stdin_or(
    max_bytes: u32, fallback: core::wide_i64::WideI64
) -> core::wide_i64::WideI64 {
    if (max_bytes == 0) { return fallback; }
    let cell: [i32; 1] = [0];
    let data: ptr = core::mem::i32_array_data_ptr(cell);
    let consumed: u32 = 0;
    let magnitude: core::wide_u64::WideU64 = core::wide_u64::zero();
    let threshold: core::wide_u64::WideU64 =
        core::wide_u64::from_words(214748364, 3435973836); // 2^63 / 10
    let started: bool = false;
    let digits: bool = false;
    let trailing: bool = false;
    let negative: bool = false;
    while (true) {
        cell[0] = 0;
        let received: i32 = std::io::read_stdin(data, 1);
        if (received == 0) { break; }
        if (received != 1 || consumed >= max_bytes) { return fallback; }
        consumed += 1;
        let byte: i32 = cell[0];
        if (byte == 32 || byte == 9 || byte == 10 || byte == 13) {
            if (started && !digits) { return fallback; }
            if (digits) { trailing = true; }
            continue;
        }
        if (byte == 43 || byte == 45) {
            if (started || trailing) { return fallback; }
            started = true;
            negative = byte == 45;
            continue;
        }
        if (byte >= 48 && byte <= 57) {
            if (trailing) { return fallback; }
            started = true;
            digits = true;
            let digit_i32: i32 = byte - 48;
            let digit: u32 = digit_i32;
            let last_digit: u32 = 7;
            if (negative) { last_digit = 8; }
            let order: i32 = core::wide_u64::compare(magnitude, threshold);
            if (order > 0 || (order == 0 && digit > last_digit)) {
                return fallback;
            }
            magnitude = append_wide_digit(magnitude, digit);
            continue;
        }
        return fallback;
    }
    if (!digits) { return fallback; }
    let value: core::wide_i64::WideI64 = core::wide_i64::from_words(
        core::wide_u64::high_word(magnitude), core::wide_u64::low_word(magnitude));
    if (negative) { return core::wide_i64::wrapping_neg(value); }
    return value;
}

// Narrow readers inherit the full-stream syntax and max_bytes limit from the
// 32-bit readers. A parsed value outside the destination type returns the
// caller's fallback. Invalid input or a host error has the same result.
pub fn read_u8_stdin_or(max_bytes: u32, fallback: u8) -> u8 {
    let widened_fallback: u32 = fallback as u32;
    let value: u32 = read_u32_stdin_or(max_bytes, widened_fallback);
    if (value > 255) {
        return fallback;
    }
    return value as u8;
}

pub fn read_u16_stdin_or(max_bytes: u32, fallback: u16) -> u16 {
    let widened_fallback: u32 = fallback as u32;
    let value: u32 = read_u32_stdin_or(max_bytes, widened_fallback);
    if (value > 65535) {
        return fallback;
    }
    return value as u16;
}

pub fn read_i8_stdin_or(max_bytes: u32, fallback: i8) -> i8 {
    let widened_fallback: i32 = fallback as i32;
    let value: i32 = read_i32_stdin_or(max_bytes, widened_fallback);
    if (value < -128 || value > 127) {
        return fallback;
    }
    return value as i8;
}

pub fn read_i16_stdin_or(max_bytes: u32, fallback: i16) -> i16 {
    let widened_fallback: i32 = fallback as i32;
    let value: i32 = read_i32_stdin_or(max_bytes, widened_fallback);
    if (value < -32768 || value > 32767) {
        return fallback;
    }
    return value as i16;
}
