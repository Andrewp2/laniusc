// Decimal output built on the bound single-byte I/O operation.
// write_u32 emits every digit without allocation. It returns the byte count
// (1..10), the first negative host error, or -1 if a byte write does not
// report exactly one byte. An error can leave a decimal prefix on the handle.
module std::io_decimal;
import core::decimal;
import std::io;
pub fn write_u32(handle: i32, value: u32) -> i32 {
    let length: u32 = core::decimal::len_u32(value);
    let position: u32 = 0;
    while (position<length) {
        let byte: u8 = core::decimal::byte_at_or_u32(value, position, 0);
        let byte_i32: i32 = byte;
        let written: i32 = std::io::write_byte(handle, byte_i32);
        if (written<0) {
            return written;
        }
        if (written != 1) {
            return -1;
        }
        position += 1;
    }
    return length;
}

// Writes a signed decimal value, including the sign for negatives. Returns
// the complete byte count (1..11), the first negative host error, or -1 if a
// byte write does not report exactly one byte. A failure can leave a prefix.
pub fn write_i32(handle: i32, value: i32) -> i32 {
    let length: u32 = core::decimal::len_i32(value);
    let position: u32 = 0;
    while (position<length) {
        let byte: u8 = core::decimal::byte_at_or_i32(value, position, 0);
        let byte_i32: i32 = byte;
        let written: i32 = std::io::write_byte(handle, byte_i32);
        if (written<0) {
            return written;
        }
        if (written != 1) {
            return -1;
        }
        position += 1;
    }
    return length;
}
