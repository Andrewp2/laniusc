// Owned u32-to-u32 map with linear lookup. Keys and values occupy adjacent
// 32-bit cells in one allocation and preserve every unsigned bit pattern.
// Ownership is linear by convention: use only the newest returned map, and
// destroy it exactly once.
module std::map_u32_u32;
import alloc::allocator;
import core::mem;

pub struct MapU32U32 {
    storage: ptr,
    length: i32,
    reserved: i32,
}

// Each entry occupies two i32 cells (eight bytes).
pub const MAX_ENTRIES: i32 = 268435455;

pub fn new() -> MapU32U32 {
    let empty: ptr = 0;
    return MapU32U32 { storage: empty, length: 0, reserved: 0 };
}

pub fn len(value: MapU32U32) -> i32 {
    return value.length;
}

pub fn capacity(value: MapU32U32) -> i32 {
    return value.reserved;
}

pub fn is_empty(value: MapU32U32) -> bool {
    return value.length == 0;
}

pub fn contains_key(value: MapU32U32, key: u32) -> bool {
    if (value.length == 0) {
        return false;
    }
    let cells: [i32] = core::mem::i32_slice_from_raw_parts(
        value.storage, value.reserved * 2);
    let index: i32 = 0;
    while (index < value.length) {
        let raw_key: i32 = cells[index * 2];
        let stored_key: u32 = raw_key as u32;
        if (stored_key == key) {
            return true;
        }
        index += 1;
    }
    return false;
}

// Return fallback when key is absent. Check contains_key separately when a
// stored value can equal fallback.
pub fn get_or(value: MapU32U32, key: u32, fallback: u32) -> u32 {
    if (value.length == 0) {
        return fallback;
    }
    let cells: [i32] = core::mem::i32_slice_from_raw_parts(
        value.storage, value.reserved * 2);
    let index: i32 = 0;
    while (index < value.length) {
        let offset: i32 = index * 2;
        let raw_key: i32 = cells[offset];
        let stored_key: u32 = raw_key as u32;
        if (stored_key == key) {
            let raw_item: i32 = cells[offset + 1];
            return raw_item as u32;
        }
        index += 1;
    }
    return fallback;
}

// Entry order is insertion order until removal; removal preserves the order
// of all remaining entries. Invalid ordinals return fallback.
pub fn key_at_or(value: MapU32U32, ordinal: i32, fallback: u32) -> u32 {
    if (ordinal < 0 || ordinal >= value.length) {
        return fallback;
    }
    let cells: [i32] = core::mem::i32_slice_from_raw_parts(
        value.storage, value.reserved * 2);
    let raw_key: i32 = cells[ordinal * 2];
    return raw_key as u32;
}

pub fn value_at_or(value: MapU32U32, ordinal: i32, fallback: u32) -> u32 {
    if (ordinal < 0 || ordinal >= value.length) {
        return fallback;
    }
    let cells: [i32] = core::mem::i32_slice_from_raw_parts(
        value.storage, value.reserved * 2);
    let raw_item: i32 = cells[ordinal * 2 + 1];
    return raw_item as u32;
}

// Negative or oversized requests and allocation failure return the original
// map unchanged. Compare capacity(result) to the request to detect failure.
pub fn try_reserve(value: MapU32U32, minimum_entries: i32) -> MapU32U32 {
    if (minimum_entries < 0 || minimum_entries > MAX_ENTRIES ||
        minimum_entries <= value.reserved) {
        return value;
    }
    let byte_count: i32 = minimum_entries * 8;
    let new_bytes: usize = byte_count as usize;
    let next: ptr = 0;
    if (value.storage == 0) {
        next = alloc::allocator::alloc(new_bytes, 4);
    } else {
        let old_byte_count: i32 = value.reserved * 8;
        let old_bytes: usize = old_byte_count as usize;
        next = alloc::allocator::realloc(value.storage, old_bytes, new_bytes, 4);
    }
    if (next == 0) {
        return value;
    }
    return MapU32U32 {
        storage: next,
        length: value.length,
        reserved: minimum_entries,
    };
}

// Insert a new key. An existing key, capacity limit, or allocation failure
// leaves the map unchanged; successful insertion increments len. Use try_set
// to replace an existing value.
pub fn try_insert(value: MapU32U32, key: u32, item: u32) -> MapU32U32 {
    if (contains_key(value, key) || value.length >= MAX_ENTRIES) {
        return value;
    }
    let needed: i32 = value.length + 1;
    let grown: MapU32U32 = value;
    if (grown.reserved < needed) {
        let target: i32 = 4;
        if (grown.reserved > 0) {
            if (grown.reserved > MAX_ENTRIES / 2) {
                target = MAX_ENTRIES;
            } else {
                target = grown.reserved * 2;
            }
        }
        if (target < needed) {
            target = needed;
        }
        grown = try_reserve(grown, target);
        if (grown.reserved < needed) {
            return value;
        }
    }
    let cells: [i32] = core::mem::i32_slice_from_raw_parts(
        grown.storage, grown.reserved * 2);
    let offset: i32 = grown.length * 2;
    cells[offset] = key as i32;
    cells[offset + 1] = item as i32;
    return MapU32U32 {
        storage: grown.storage,
        length: needed,
        reserved: grown.reserved,
    };
}

// Replace an existing value in place. Missing keys return false without
// mutating the allocation.
pub fn try_set(value: MapU32U32, key: u32, item: u32) -> bool {
    if (value.length == 0) {
        return false;
    }
    let cells: [i32] = core::mem::i32_slice_from_raw_parts(
        value.storage, value.reserved * 2);
    let index: i32 = 0;
    while (index < value.length) {
        let offset: i32 = index * 2;
        let raw_key: i32 = cells[offset];
        let stored_key: u32 = raw_key as u32;
        if (stored_key == key) {
            cells[offset + 1] = item as i32;
            return true;
        }
        index += 1;
    }
    return false;
}

// Remove a key and value, preserving order and capacity. Missing keys leave
// the map unchanged; successful removal decrements len.
pub fn try_remove(value: MapU32U32, key: u32) -> MapU32U32 {
    if (value.length == 0) {
        return value;
    }
    let cells: [i32] = core::mem::i32_slice_from_raw_parts(
        value.storage, value.reserved * 2);
    let index: i32 = 0;
    while (index < value.length) {
        let raw_key: i32 = cells[index * 2];
        let stored_key: u32 = raw_key as u32;
        if (stored_key == key) {
            let cursor: i32 = index;
            while (cursor + 1 < value.length) {
                let destination: i32 = cursor * 2;
                let source: i32 = destination + 2;
                cells[destination] = cells[source];
                cells[destination + 1] = cells[source + 1];
                cursor += 1;
            }
            return MapU32U32 {
                storage: value.storage,
                length: value.length - 1,
                reserved: value.reserved,
            };
        }
        index += 1;
    }
    return value;
}

pub fn clear(value: MapU32U32) -> MapU32U32 {
    return MapU32U32 {
        storage: value.storage,
        length: 0,
        reserved: value.reserved,
    };
}

// Release unused storage. Empty maps release their allocation. Reallocation
// failure returns the original map with its capacity and entries intact.
pub fn try_shrink_to_fit(value: MapU32U32) -> MapU32U32 {
    if (value.length == value.reserved) {
        return value;
    }
    if (value.length == 0) {
        destroy(value);
        return new();
    }
    let old_byte_count: i32 = value.reserved * 8;
    let new_byte_count: i32 = value.length * 8;
    let old_bytes: usize = old_byte_count as usize;
    let new_bytes: usize = new_byte_count as usize;
    let next: ptr = alloc::allocator::realloc(value.storage, old_bytes, new_bytes, 4);
    if (next == 0) {
        return value;
    }
    return MapU32U32 {
        storage: next,
        length: value.length,
        reserved: value.length,
    };
}

// Return an independently owned copy. Allocation failure returns an empty
// zero-capacity map and leaves the source unchanged. For nonempty input,
// len(result) == len(value) indicates success.
pub fn try_clone(value: MapU32U32) -> MapU32U32 {
    if (value.length == 0) {
        return new();
    }
    let copy: MapU32U32 = try_reserve(new(), value.length);
    if (copy.reserved < value.length) {
        return new();
    }
    let source: [i32] = core::mem::i32_slice_from_raw_parts(
        value.storage, value.length * 2);
    let destination: [i32] = core::mem::i32_slice_from_raw_parts(
        copy.storage, copy.reserved * 2);
    let index: i32 = 0;
    let count: i32 = value.length * 2;
    while (index < count) {
        destination[index] = source[index];
        index += 1;
    }
    return MapU32U32 {
        storage: copy.storage,
        length: value.length,
        reserved: copy.reserved,
    };
}

pub fn destroy(value: MapU32U32) {
    if (value.storage != 0) {
        let byte_count: i32 = value.reserved * 8;
        let bytes: usize = byte_count as usize;
        alloc::allocator::dealloc(value.storage, bytes, 4);
    }
}
