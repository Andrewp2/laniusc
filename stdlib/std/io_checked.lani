// Complete caller-buffer stream I/O using the bound x86 Linux host calls.
// No allocation or implicit buffering occurs.
module std::io_checked;
import core::mem;
import std::io;

// Read exactly len bytes from stdin. Zero length succeeds without touching
// buffer or stdin. Invalid storage or length, EOF, host errors, zero progress,
// and impossible host counts return false. Failure may leave a read prefix.
pub fn read_exact_stdin(buffer: ptr, len: usize) -> bool {
    if (len>2147483647 || buffer == 0 && len>0) {
        return false;
    }
    let received: usize = 0;
    while (received<len) {
        let cursor: ptr = buffer + received;
        let remaining: usize = len - received;
        let count: i32 = std::io::read_stdin(cursor, remaining);
        if (count <= 0) {
            return false;
        }
        let advanced: usize = count;
        if (advanced>remaining) {
            return false;
        }
        received += advanced;
    }
    return true;
}

// Read stdin through EOF into caller storage and return the complete byte
// count, including zero for empty input. Capacity may be zero with a null
// pointer; a one-byte stack probe then distinguishes empty from overfull.
// Invalid arguments, host errors, impossible counts, or input exceeding
// capacity return -1. Failure may leave a prefix in the caller's buffer and
// may consume one byte beyond capacity while checking for EOF.
pub fn read_to_end_stdin_into_buffer(buffer: ptr, capacity: usize) -> i32 {
    if (capacity>2147483647 || buffer == 0 && capacity>0) {
        return -1;
    }
    let received: usize = 0;
    while (received<capacity) {
        let cursor: ptr = buffer + received;
        let remaining: usize = capacity - received;
        let count: i32 = std::io::read_stdin(cursor, remaining);
        if (count<0) {
            return -1;
        }
        if (count == 0) {
            let complete: i32 = received;
            return complete;
        }
        let advanced: usize = count;
        if (advanced>remaining) {
            return -1;
        }
        received += advanced;
    }
    let probe: [i32; 1] = [0];
    let probe_ptr: ptr = core::mem::i32_array_data_ptr(probe);
    if (std::io::read_stdin(probe_ptr, 1) != 0) {
        return -1;
    }
    let complete: i32 = received;
    return complete;
}

fn write_all(buffer: ptr, len: usize, to_stderr: bool) -> bool {
    if (len>2147483647 || buffer == 0 && len>0) {
        return false;
    }
    let sent: usize = 0;
    while (sent<len) {
        let cursor: ptr = buffer + sent;
        let remaining: usize = len - sent;
        let count: i32 = 0;
        if (to_stderr) {
            count = std::io::write_stderr(cursor, remaining);
        } else {
            count = std::io::write_stdout(cursor, remaining);
        }
        if (count <= 0) {
            return false;
        }
        let advanced: usize = count;
        if (advanced>remaining) {
            return false;
        }
        sent += advanced;
    }
    return true;
}

// Write all len bytes to stdout. Zero length succeeds without touching the
// pointer. Invalid arguments, a host error, or zero progress return false;
// failure may leave an already-written prefix on stdout.
pub fn write_all_stdout(buffer: ptr, len: usize) -> bool {
    return write_all(buffer, len, false);
}

// Write all len bytes to stderr, with the same failure behavior as stdout.
pub fn write_all_stderr(buffer: ptr, len: usize) -> bool {
    return write_all(buffer, len, true);
}

// Copy stdin through caller storage to stdout until EOF. Capacity must be
// 1..=i32::MAX and the pointer must name at least capacity writable bytes.
// Read and write failures return false; stdout may contain a copied prefix.
// Neither stream is closed. Empty input succeeds without writing.
pub fn copy_stdin_to_stdout_with_buffer(buffer: ptr, capacity: usize) -> bool {
    if (buffer == 0 || capacity == 0 || capacity>2147483647) {
        return false;
    }
    while (true) {
        let received: i32 = std::io::read_stdin(buffer, capacity);
        if (received<0) {
            return false;
        }
        if (received == 0) {
            return true;
        }
        let count: usize = received;
        if (count>capacity || !write_all_stdout(buffer, count)) {
            return false;
        }
    }
    return false;
}
