// Owned ring-buffer deque for char values. Both ends push and pop in O(1)
// except when growth copies existing elements into a larger allocation.
// Each char occupies one native eight-byte slot (slot i at storage + 8 * i),
// read and written as char, so no integer conversion is involved.
// Ownership is linear by convention: keep only the newest returned DequeChar
// and destroy each independent deque exactly once.
module std::deque_char;
import alloc::allocator;
import core::mem;

pub struct DequeChar {
    storage: ptr,
    length: i32,
    reserved: i32,
    head: i32,
}

// Doubled capacities fit signed i32. Byte counts are computed as usize.
pub const MAX_CAPACITY: i32 = 536870911;

fn slot(storage: ptr, index: i32) -> [char] {
    let offset: usize = (index as usize) * 8;
    return core::mem::typed_slice_from_raw_parts(storage + offset, 1);
}

fn load(storage: ptr, index: i32) -> char {
    let view: [char] = slot(storage, index);
    return view[0];
}

fn store(storage: ptr, index: i32, item: char) {
    let view: [char] = slot(storage, index);
    view[0] = item;
}

fn byte_size(count: i32) -> usize {
    return (count as usize) * 8;
}

fn physical_index(value: DequeChar, ordinal: i32) -> i32 {
    let slot: i32 = value.head + ordinal;
    if (slot >= value.reserved) { slot -= value.reserved; }
    return slot;
}

pub fn new() -> DequeChar {
    let empty: ptr = 0;
    return DequeChar { storage: empty, length: 0, reserved: 0, head: 0 };
}

pub fn len(value: DequeChar) -> i32 {
    return value.length;
}

pub fn capacity(value: DequeChar) -> i32 {
    return value.reserved;
}

pub fn is_empty(value: DequeChar) -> bool {
    return value.length == 0;
}

// Invalid requests or allocation failure return the original owner unchanged.
// Successful reservation reorders physical storage so the first item is at
// slot zero; logical order is retained. Compare capacity with the request.
pub fn try_reserve(value: DequeChar, minimum_capacity: i32) -> DequeChar {
    if (minimum_capacity < 0 || minimum_capacity > MAX_CAPACITY ||
        minimum_capacity <= value.reserved) { return value; }
    let next: ptr = alloc::allocator::alloc(byte_size(minimum_capacity), 8);
    if (next == 0) { return value; }
    let index: i32 = 0;
    while (index < value.length) {
        store(next, index, load(value.storage, physical_index(value, index)));
        index += 1;
    }
    if (value.storage != 0) {
        alloc::allocator::dealloc(value.storage, byte_size(value.reserved), 8);
    }
    return DequeChar {
        storage: next, length: value.length, reserved: minimum_capacity, head: 0,
    };
}

// On invalid capacity or allocation failure return an empty zero-capacity
// deque. Compare capacity(result) with the request to distinguish failure.
pub fn try_with_capacity(initial_capacity: i32) -> DequeChar {
    return try_reserve(new(), initial_capacity);
}

// Return an independent copy in logical order. Allocation failure for a
// nonempty source returns an empty deque; the source stays owned and intact.
pub fn try_clone(value: DequeChar) -> DequeChar {
    if (value.length == 0) { return new(); }
    let copy: DequeChar = try_with_capacity(value.length);
    if (copy.reserved < value.length) { return new(); }
    let index: i32 = 0;
    while (index < value.length) {
        store(copy.storage, index, load(value.storage, physical_index(value, index)));
        index += 1;
    }
    return DequeChar {
        storage: copy.storage, length: value.length, reserved: copy.reserved, head: 0,
    };
}

// Push success increments len; capacity limit or allocation failure returns
// the original deque unchanged. Growth preserves logical order.
pub fn try_push_back(value: DequeChar, item: char) -> DequeChar {
    if (value.length >= MAX_CAPACITY) { return value; }
    let grown: DequeChar = value;
    if (grown.length == grown.reserved) {
        let target: i32 = 4;
        if (grown.reserved > 0) {
            if (grown.reserved > MAX_CAPACITY / 2) { target = MAX_CAPACITY; }
            else { target = grown.reserved * 2; }
        }
        grown = try_reserve(grown, target);
        if (grown.length == grown.reserved) { return value; }
    }
    store(grown.storage, physical_index(grown, grown.length), item);
    return DequeChar {
        storage: grown.storage, length: grown.length + 1,
        reserved: grown.reserved, head: grown.head,
    };
}

pub fn try_push_front(value: DequeChar, item: char) -> DequeChar {
    if (value.length >= MAX_CAPACITY) { return value; }
    let grown: DequeChar = value;
    if (grown.length == grown.reserved) {
        let target: i32 = 4;
        if (grown.reserved > 0) {
            if (grown.reserved > MAX_CAPACITY / 2) { target = MAX_CAPACITY; }
            else { target = grown.reserved * 2; }
        }
        grown = try_reserve(grown, target);
        if (grown.length == grown.reserved) { return value; }
    }
    let next_head: i32 = grown.head - 1;
    if (grown.head == 0) { next_head = grown.reserved - 1; }
    store(grown.storage, next_head, item);
    return DequeChar {
        storage: grown.storage, length: grown.length + 1,
        reserved: grown.reserved, head: next_head,
    };
}

// Fallbacks are returned on empty or out-of-range access. A stored value may
// equal the fallback; use len to distinguish empty or invalid ordinals.
pub fn at_or(value: DequeChar, ordinal: i32, fallback: char) -> char {
    if (ordinal < 0 || ordinal >= value.length) { return fallback; }
    return load(value.storage, physical_index(value, ordinal));
}

pub fn front_or(value: DequeChar, fallback: char) -> char {
    return at_or(value, 0, fallback);
}

pub fn back_or(value: DequeChar, fallback: char) -> char {
    return at_or(value, value.length - 1, fallback);
}

pub fn contains(value: DequeChar, item: char) -> bool {
    let index: i32 = 0;
    while (index < value.length) {
        if (at_or(value, index, '\0') == item) { return true; }
        index += 1;
    }
    return false;
}

// In-place mutation is limited to valid logical ordinals.
pub fn try_set(value: DequeChar, ordinal: i32, item: char) -> bool {
    if (ordinal < 0 || ordinal >= value.length) { return false; }
    store(value.storage, physical_index(value, ordinal), item);
    return true;
}

pub fn try_swap(value: DequeChar, left: i32, right: i32) -> bool {
    if (left < 0 || right < 0 || left >= value.length || right >= value.length) {
        return false;
    }
    let left_slot: i32 = physical_index(value, left);
    let right_slot: i32 = physical_index(value, right);
    let saved: char = load(value.storage, left_slot);
    store(value.storage, left_slot, load(value.storage, right_slot));
    store(value.storage, right_slot, saved);
    return true;
}

// Popping an empty deque returns it unchanged. Read front_or/back_or first if
// the removed item is needed. The allocation remains available for reuse.
pub fn try_pop_front(value: DequeChar) -> DequeChar {
    if (value.length == 0) { return value; }
    let next_head: i32 = value.head + 1;
    if (next_head == value.reserved) { next_head = 0; }
    return DequeChar {
        storage: value.storage, length: value.length - 1,
        reserved: value.reserved, head: next_head,
    };
}

pub fn try_pop_back(value: DequeChar) -> DequeChar {
    if (value.length == 0) { return value; }
    return DequeChar {
        storage: value.storage, length: value.length - 1,
        reserved: value.reserved, head: value.head,
    };
}

pub fn clear(value: DequeChar) -> DequeChar {
    return DequeChar {
        storage: value.storage, length: 0, reserved: value.reserved, head: 0,
    };
}

// Reduce capacity to len, preserving logical order. Empty deques release
// their allocation. A failed allocation leaves the source unchanged.
pub fn try_shrink_to_fit(value: DequeChar) -> DequeChar {
    if (value.length == value.reserved) { return value; }
    if (value.length == 0) {
        destroy(value);
        return new();
    }
    let next: ptr = alloc::allocator::alloc(byte_size(value.length), 8);
    if (next == 0) { return value; }
    let index: i32 = 0;
    while (index < value.length) {
        store(next, index, load(value.storage, physical_index(value, index)));
        index += 1;
    }
    alloc::allocator::dealloc(value.storage, byte_size(value.reserved), 8);
    return DequeChar {
        storage: next, length: value.length, reserved: value.length, head: 0,
    };
}

pub fn destroy(value: DequeChar) {
    if (value.storage != 0) {
        alloc::allocator::dealloc(value.storage, byte_size(value.reserved), 8);
    }
}
