// Owned char-to-u32 map with linear lookup. Entry i occupies two native
// eight-byte slots in one allocation: its char key at storage + 16 * i and its
// u32 value right after it. Both are read and written at their own types, so
// no integer conversion is involved.
// Ownership is linear by convention: use only the newest returned map, and
// destroy it exactly once.
module std::map_char_u32;
import alloc::allocator;
import core::mem;

pub struct MapCharU32 {
    storage: ptr,
    length: i32,
    reserved: i32,
}

// Doubled capacities fit signed i32. Byte counts are computed as usize.
pub const MAX_ENTRIES: i32 = 268435455;

fn key_slot(storage: ptr, index: i32) -> [char] {
    let offset: usize = (index as usize) * 16;
    return core::mem::typed_slice_from_raw_parts(storage + offset, 1);
}

fn value_slot(storage: ptr, index: i32) -> [u32] {
    let offset: usize = (index as usize) * 16 + 8;
    return core::mem::typed_slice_from_raw_parts(storage + offset, 1);
}

fn load_key(storage: ptr, index: i32) -> char {
    let view: [char] = key_slot(storage, index);
    return view[0];
}

fn load_value(storage: ptr, index: i32) -> u32 {
    let view: [u32] = value_slot(storage, index);
    return view[0];
}

fn store_entry(storage: ptr, index: i32, key: char, item: u32) {
    let keys: [char] = key_slot(storage, index);
    keys[0] = key;
    let values: [u32] = value_slot(storage, index);
    values[0] = item;
}

fn store_value(storage: ptr, index: i32, item: u32) {
    let values: [u32] = value_slot(storage, index);
    values[0] = item;
}

fn byte_size(count: i32) -> usize {
    return (count as usize) * 16;
}

pub fn new() -> MapCharU32 {
    let empty: ptr = 0;
    return MapCharU32 { storage: empty, length: 0, reserved: 0 };
}

pub fn len(value: MapCharU32) -> i32 {
    return value.length;
}

pub fn capacity(value: MapCharU32) -> i32 {
    return value.reserved;
}

pub fn is_empty(value: MapCharU32) -> bool {
    return value.length == 0;
}

pub fn contains_key(value: MapCharU32, key: char) -> bool {
    if (value.length == 0) {
        return false;
    }
    let index: i32 = 0;
    while (index < value.length) {
        if (load_key(value.storage, index) == key) {
            return true;
        }
        index += 1;
    }
    return false;
}

// Return fallback when key is absent. Check contains_key separately when a
// stored value can equal fallback.
pub fn get_or(value: MapCharU32, key: char, fallback: u32) -> u32 {
    if (value.length == 0) {
        return fallback;
    }
    let index: i32 = 0;
    while (index < value.length) {
        if (load_key(value.storage, index) == key) {
            return load_value(value.storage, index);
        }
        index += 1;
    }
    return fallback;
}

// Entry order is insertion order until removal; removal preserves the order
// of all remaining entries. Invalid ordinals return fallback.
pub fn key_at_or(value: MapCharU32, ordinal: i32, fallback: char) -> char {
    if (ordinal < 0 || ordinal >= value.length) {
        return fallback;
    }
    return load_key(value.storage, ordinal);
}

pub fn value_at_or(value: MapCharU32, ordinal: i32, fallback: u32) -> u32 {
    if (ordinal < 0 || ordinal >= value.length) {
        return fallback;
    }
    return load_value(value.storage, ordinal);
}

// Negative or oversized requests and allocation failure return the original
// map unchanged. Compare capacity(result) to the request to detect failure.
pub fn try_reserve(value: MapCharU32, minimum_entries: i32) -> MapCharU32 {
    if (minimum_entries < 0 || minimum_entries > MAX_ENTRIES ||
        minimum_entries <= value.reserved) {
        return value;
    }
    let new_bytes: usize = byte_size(minimum_entries);
    let next: ptr = 0;
    if (value.storage == 0) {
        next = alloc::allocator::alloc(new_bytes, 8);
    } else {
        next = alloc::allocator::realloc(value.storage, byte_size(value.reserved), new_bytes, 8);
    }
    if (next == 0) {
        return value;
    }
    return MapCharU32 {
        storage: next,
        length: value.length,
        reserved: minimum_entries,
    };
}

// Insert a new key. An existing key, capacity limit, or allocation failure
// leaves the map unchanged; successful insertion increments len. Use try_set
// to replace an existing value.
pub fn try_insert(value: MapCharU32, key: char, item: u32) -> MapCharU32 {
    if (contains_key(value, key) || value.length >= MAX_ENTRIES) {
        return value;
    }
    let needed: i32 = value.length + 1;
    let grown: MapCharU32 = value;
    if (grown.reserved < needed) {
        let target: i32 = 4;
        if (grown.reserved > 0) {
            if (grown.reserved > MAX_ENTRIES / 2) {
                target = MAX_ENTRIES;
            } else {
                target = grown.reserved * 2;
            }
        }
        if (target < needed) {
            target = needed;
        }
        grown = try_reserve(grown, target);
        if (grown.reserved < needed) {
            return value;
        }
    }
    store_entry(grown.storage, grown.length, key, item);
    return MapCharU32 {
        storage: grown.storage,
        length: needed,
        reserved: grown.reserved,
    };
}

// Replace an existing value in place. Missing keys return false without
// mutating the allocation.
pub fn try_set(value: MapCharU32, key: char, item: u32) -> bool {
    if (value.length == 0) {
        return false;
    }
    let index: i32 = 0;
    while (index < value.length) {
        if (load_key(value.storage, index) == key) {
            store_value(value.storage, index, item);
            return true;
        }
        index += 1;
    }
    return false;
}

// Remove a key and value, preserving order and capacity. Missing keys leave
// the map unchanged; successful removal decrements len.
pub fn try_remove(value: MapCharU32, key: char) -> MapCharU32 {
    if (value.length == 0) {
        return value;
    }
    let index: i32 = 0;
    while (index < value.length) {
        if (load_key(value.storage, index) == key) {
            let cursor: i32 = index;
            while (cursor + 1 < value.length) {
                store_entry(value.storage, cursor, load_key(value.storage, cursor + 1),
                    load_value(value.storage, cursor + 1));
                cursor += 1;
            }
            return MapCharU32 {
                storage: value.storage,
                length: value.length - 1,
                reserved: value.reserved,
            };
        }
        index += 1;
    }
    return value;
}

pub fn clear(value: MapCharU32) -> MapCharU32 {
    return MapCharU32 {
        storage: value.storage,
        length: 0,
        reserved: value.reserved,
    };
}

// Release unused storage. Empty maps release their allocation. Reallocation
// failure returns the original map with its capacity and entries intact.
pub fn try_shrink_to_fit(value: MapCharU32) -> MapCharU32 {
    if (value.length == value.reserved) {
        return value;
    }
    if (value.length == 0) {
        destroy(value);
        return new();
    }
    let next: ptr = alloc::allocator::realloc(
        value.storage, byte_size(value.reserved), byte_size(value.length), 8);
    if (next == 0) {
        return value;
    }
    return MapCharU32 {
        storage: next,
        length: value.length,
        reserved: value.length,
    };
}

// Return an independently owned copy. Allocation failure returns an empty
// zero-capacity map and leaves the source unchanged. For nonempty input,
// len(result) == len(value) indicates success.
pub fn try_clone(value: MapCharU32) -> MapCharU32 {
    if (value.length == 0) {
        return new();
    }
    let copy: MapCharU32 = try_reserve(new(), value.length);
    if (copy.reserved < value.length) {
        return new();
    }
    let index: i32 = 0;
    while (index < value.length) {
        store_entry(copy.storage, index, load_key(value.storage, index),
            load_value(value.storage, index));
        index += 1;
    }
    return MapCharU32 {
        storage: copy.storage,
        length: value.length,
        reserved: copy.reserved,
    };
}

pub fn destroy(value: MapCharU32) {
    if (value.storage != 0) {
        alloc::allocator::dealloc(value.storage, byte_size(value.reserved), 8);
    }
}
