// Ordered map with AVL balancing and reusable indexed node storage.
// Copies borrow nested resources; keep one active owner of the allocation.
module alloc::tree_map;
import core::function;
import alloc::allocator;
import core::cmp;
import core::iter;
import core::mem;
import core::option;
import core::ordering;
import core::pair;
import core::range;
import core::result;
import core::slice;

pub enum Error { InvalidCapacity, CapacityOverflow, AllocationFailed, InvalidOrder, InvalidRange, NotEmpty }
// Sink insertion rejects existing keys instead of replacing their entries.
pub enum SinkError { Duplicate, Storage(Error) }
pub enum IntoIterError { Remaining(i32) }
pub struct Entry<K, V> { key: K, value: V }
// Failed initialization returns its error; later failures return the complete
// uninserted entry with its cleanup authority. No nested owner is destroyed.
pub enum UpdateError<K,V,E> { Initialize(E), KeyMismatch(Entry<K,V>), Storage(Error,Entry<K,V>) }
struct Node<K, V> { item: Entry<K, V>, left: i32, right: i32, parent: i32, height: i32, next_free: i32 }
pub struct TreeMap<K, V> { storage: ptr, reserved: i32, used: i32, length: i32, root: i32, free: i32 }
pub struct Cursor<K, V> { storage: ptr, reserved: i32, front: i32, back: i32 }
// One active owner of a valid current tree and every unconsumed pair.
pub struct IntoIter<K, V> { owner: TreeMap<K, V> }
const ALIGN: usize = 8;

// Preserve the original same-key point lookup's query-first comparison order.
struct NaturalKey<K> {}
impl<K> NaturalKey<K> { fn borrow(&self) -> &NaturalKey<K> { return self; } }
pub impl<K> core::ordering::Comparator<K,K> for NaturalKey<K> where K:core::cmp::Ord<K> {
    pub fn compare(&self, stored:K, query:K) -> core::ordering::Ordering {
        if (K::lt(query,stored)) { return core::ordering::Greater; }
        if (K::lt(stored,query)) { return core::ordering::Less; }
        return core::ordering::Equal;
    }
}

pub fn new<K, V>() -> TreeMap<K, V> {
    let empty: ptr = 0;
    return TreeMap { storage: empty, reserved: 0, used: 0, length: 0, root: -1, free: -1 };
}
pub fn with_capacity<K, V>(capacity: i32) -> core::result::Result<TreeMap<K, V>, Error> {
    let value: TreeMap<K, V> = new();
    let reserved: core::result::Result<i32, Error> = value.try_reserve(capacity);
    if (core::result::is_err(reserved)) { return core::result::Err(core::result::unwrap_err(reserved)); }
    return core::result::Ok(value);
}
fn capacity_limit<K, V>() -> i32 {
    return (2147483647 / core::mem::size_of<Node<K, V>>()) as i32;
}
fn height<K, V>(nodes: [Node<K, V>], index: i32) -> i32 {
    if (index < 0) { return 0; } let node: Node<K, V> = nodes[index]; return node.height;
}
fn bound_value<T>(bound: core::range::Bound<T>) -> core::option::Option<T> {
    return match (bound) {
        core::range::Bound::Included(value) -> core::option::Some(value),
        core::range::Bound::Excluded(value) -> core::option::Some(value),
        core::range::Bound::Unbounded -> core::option::None(),
    };
}
fn endpoint<K, V>(nodes: [Node<K, V>], root: i32, last: bool) -> i32 {
    let index: i32 = root;
    while (index >= 0) {
        let node: Node<K, V> = nodes[index]; let next: i32 = node.left;
        if (last) { next = node.right; }
        if (next < 0) { return index; } index = next;
    }
    return -1;
}
fn adjacent<K, V>(nodes: [Node<K, V>], index: i32, previous: bool) -> i32 {
    let node: Node<K, V> = nodes[index]; let child: i32 = node.right;
    if (previous) { child = node.left; }
    if (child >= 0) { return endpoint(nodes, child, previous); }
    let current: i32 = index; let parent: i32 = node.parent;
    while (parent >= 0) {
        let upper: Node<K, V> = nodes[parent]; let side: i32 = upper.left;
        if (previous) { side = upper.right; }
        if (side == current) { return parent; }
        current = parent; parent = upper.parent;
    }
    return -1;
}

// Strictly increasing input: equivalent or descending adjacent keys are errors.
pub fn from_sorted<K, V>(input: core::slice::View<Entry<K, V>>) -> core::result::Result<TreeMap<K, V>, Error>
    where K: core::cmp::Ord<K> {
    let value: TreeMap<K, V> = new();
    let initialized: core::result::Result<i32, Error> = value.try_init_sorted(input);
    if (initialized.is_err()) { return core::result::Err(initialized.unwrap_err()); }
    return core::result::Ok(value);
}

pub impl<K, V> TreeMap<K, V> {
    pub fn borrow(&self) -> &TreeMap<K, V> { return self; }
    pub fn len(&self) -> i32 { return self.length; }
    pub fn capacity(&self) -> i32 { return self.reserved; }
    pub fn is_empty(&self) -> bool { return self.length == 0; }
    fn take_owner(&self) -> TreeMap<K, V> {
        let owner: TreeMap<K, V> = TreeMap { storage: self.storage, reserved: self.reserved, used: self.used, length: self.length, root: self.root, free: self.free };
        let empty: ptr = 0; self.storage = empty; self.reserved = 0; self.clear();
        return owner;
    }
    // Transfer backing, live pairs and free-list state. End all borrowed views
    // first; shallow aliases cannot become additional cleanup authorities.
    pub fn take_iter(&self) -> IntoIter<K, V> {
        return IntoIter { owner: self.take_owner() };
    }
    // Initialize an empty actual owner from strictly increasing entries.
    // Input must be physically backed and must not alias this map's storage.
    // Shallow copies transfer no nested cleanup automatically. All validation
    // and reservation precedes writes; a pre-reserved count allocates nothing.
    // Err preserves this empty owner, its capacity, and every input entry.
    pub fn try_init_sorted(&self, input: core::slice::View<Entry<K, V>>) -> core::result::Result<i32, Error>
        where K: core::cmp::Ord<K> {
        if (self.length != 0) { return core::result::Err(Error::NotEmpty); }
        if (input.start < 0 || input.length < 0 || input.start > 2147483647-input.length) {
            return core::result::Err(Error::InvalidRange);
        }
        let count: i32 = input.len();
        if (count > capacity_limit<K, V>()) { return core::result::Err(Error::CapacityOverflow); }
        let index: i32 = 1;
        while (index < count) {
            let left: Entry<K, V> = core::option::unwrap(input.get(index - 1));
            let right: Entry<K, V> = core::option::unwrap(input.get(index));
            if (!K::lt(left.key, right.key)) { return core::result::Err(Error::InvalidOrder); }
            index += 1;
        }
        let reserved: core::result::Result<i32, Error> = self.try_reserve(count);
        if (reserved.is_err()) { return core::result::Err(reserved.unwrap_err()); }
        let target: [Node<K, V>] = self.nodes(); index = 0;
        while (index < count) {
            let item: Entry<K, V> = core::option::unwrap(input.get(index));
            target[index] = Node { item: item, left: -1, right: -1, parent: -1, height: 1, next_free: -1 };
            index += 1;
        }
        self.length = count; self.link_sorted(); return core::result::Ok(count);
    }
    // The same view typed_slice_from_storage builds (a node is a record, so
    // its raw view runs down from the top word), without its stride probe.
    fn nodes(&self) -> [Node<K, V>] {
        if (self.reserved == 0) { return slice_from_raw_parts(self.storage, 0); }
        let top: usize = core::mem::size_of<Node<K, V>>() * (self.reserved as usize) - 8;
        return slice_from_raw_parts(self.storage + top, self.reserved);
    }
    // Natural-key descent: query-first lt, then stored-first lt, the same
    // calls in the same order as NaturalKey, without building an Ordering.
    fn find(&self, key: K) -> i32 where K: core::cmp::Ord<K> {
        let nodes: [Node<K, V>] = self.nodes(); let index: i32 = self.root;
        while (index >= 0) {
            let node: Node<K, V> = nodes[index];
            if (K::lt(key, node.item.key)) { index = node.left; }
            else { if (K::lt(node.item.key, key)) { index = node.right; } else { return index; } }
        }
        return -1;
    }
    fn find_by<Q,P>(&self, query:Q, policy:&P) -> i32 where P:core::ordering::Comparator<K,Q> {
        let nodes: [Node<K, V>] = self.nodes(); let index: i32 = self.root;
        while (index >= 0) {
            let node: Node<K, V> = nodes[index];
            let stored:K = node.item.key;
            let order:core::ordering::Ordering = policy.compare(stored,query);
            if (core::ordering::is_greater(order)) { index = node.left; }
            else { if (core::ordering::is_less(order)) { index = node.right; } else { return index; } }
        }
        return -1;
    }
    pub fn contains_key(&self, key: K) -> bool where K: core::cmp::Ord<K> { return self.find(key) >= 0; }
    pub fn get_entry(&self, key: K) -> core::option::Option<Entry<K, V>> where K: core::cmp::Ord<K> {
        return self.entry_at(self.find(key));
    }
    fn entry_at(&self, index:i32) -> core::option::Option<Entry<K,V>> {
        if (index < 0) { return core::option::None(); }
        let nodes: [Node<K, V>] = self.nodes(); let node: Node<K, V> = nodes[index]; return core::option::Some(node.item);
    }
    pub fn get(&self, key: K) -> core::option::Option<V> where K: core::cmp::Ord<K> {
        let index: i32 = self.find(key);
        if (index < 0) { return core::option::None(); }
        let nodes: [Node<K, V>] = self.nodes(); let node: Node<K, V> = nodes[index]; return core::option::Some(node.item.value);
    }
    // Missing keys never call update. A present value is lent exclusively to
    // the mapper, which returns its latest valid descriptor in Pair.first,
    // even when Pair.second is a Result error. No rollback or Destroy occurs.
    // End previous value borrows/cursors first. The callback must not access
    // this map through any alias or change key ordering through shared backing.
    // The query key remains caller-owned; only the stored value is replaced.
    pub fn update_value<M, R>(&self, key: K, update: &M) -> core::option::Option<R>
        where K: core::cmp::Ord<K>, M: core::function::Mapper<V, core::pair::Pair<V, R>> {
        let index: i32 = self.find(key);
        return self.update_at<M,R>(index,update);
    }
    fn update_at<M,R>(&self, index:i32, update:&M) -> core::option::Option<R>
        where M:core::function::Mapper<V,core::pair::Pair<V,R>> {
        if (index < 0) { return core::option::None(); }
        let nodes: [Node<K, V>] = self.nodes();
        let node: Node<K, V> = nodes[index];
        let item: Entry<K, V> = node.item;
        let updated: core::pair::Pair<V, R> = update.apply(item.value);
        node.item = Entry { key: item.key, value: updated.first };
        nodes[index] = node;
        return core::option::Some(updated.second);
    }
    // Hit: update once and return Some(report), preserving the stored key.
    // Miss: initialize once, check its key, insert and return None. The query
    // is only observed; the initializer supplies the actual transferred entry.
    // Initialize/KeyMismatch/Storage failures preserve this map and capacity.
    pub fn try_update_or_insert<F,M,R,E>(&self, query:K, initialize:&F, update:&M)
        -> core::result::Result<core::option::Option<R>,UpdateError<K,V,E>>
        where K:core::cmp::Ord<K>, F:core::function::Producer<core::result::Result<Entry<K,V>,E>>,
              M:core::function::Mapper<V,core::pair::Pair<V,R>> {
        let policy:NaturalKey<K> = NaturalKey {};
        return self.try_update_or_insert_by<K,NaturalKey<K>,F,M,R,E>(query,policy.borrow(),initialize,update);
    }
    // Policies partition the stored order as Less, optional Equal, Greater;
    // each query identifies at most one key identity. Operands are call-scoped
    // observations: no mutation, retirement, reentry or descriptor escape.
    // Keep query backing live and stable through any subsequent value update.
    pub fn contains_key_by<Q,P>(&self, query:Q, policy:&P) -> bool
        where P:core::ordering::Comparator<K,Q> {
        return self.find_by<Q,P>(query,policy) >= 0;
    }
    pub fn get_entry_by<Q,P>(&self, query:Q, policy:&P) -> core::option::Option<Entry<K,V>>
        where P:core::ordering::Comparator<K,Q> {
        return self.entry_at(self.find_by<Q,P>(query,policy));
    }
    pub fn get_by<Q,P>(&self, query:Q, policy:&P) -> core::option::Option<V>
        where P:core::ordering::Comparator<K,Q> {
        let found:core::option::Option<Entry<K,V>> = self.get_entry_by<Q,P>(query,policy);
        return match (found) { Some(item) -> core::option::Some(item.value), None -> core::option::None() };
    }
    pub fn update_value_by<Q,P,M,R>(&self, query:Q, policy:&P, update:&M) -> core::option::Option<R>
        where P:core::ordering::Comparator<K,Q>, M:core::function::Mapper<V,core::pair::Pair<V,R>> {
        let index:i32 = self.find_by<Q,P>(query,policy);
        return self.update_at<M,R>(index,update);
    }
    // One descent, then either the updater or the initializer, never both.
    // All callbacks must keep query/key identity stable and must not access
    // this map through aliases. End old borrows/cursors before calling.
    // For every stored key, comparing it with query must agree with comparing
    // it with the produced key. The Equal check below detects a mismatched
    // candidate, but cannot establish this global ordering law for a policy.
    // Return the latest V from update even when its R reports an error; there
    // is no rollback, implicit Destroy or cleanup after a non-normal return.
    pub fn try_update_or_insert_by<Q,P,F,M,R,E>(&self, query:Q, policy:&P, initialize:&F, update:&M)
        -> core::result::Result<core::option::Option<R>,UpdateError<K,V,E>>
        where K:core::cmp::Ord<K>, P:core::ordering::Comparator<K,Q>,
              F:core::function::Producer<core::result::Result<Entry<K,V>,E>>,
              M:core::function::Mapper<V,core::pair::Pair<V,R>> {
        let nodes:[Node<K,V>] = self.nodes();
        let index:i32 = self.root; let parent:i32 = -1; let left:bool = false;
        while (index >= 0) {
            let node:Node<K,V> = nodes[index]; parent = index;
            let stored:K = node.item.key;
            let order:core::ordering::Ordering = policy.compare(stored,query);
            if (core::ordering::is_greater(order)) { left = true; index = node.left; }
            else { if (core::ordering::is_less(order)) { left = false; index = node.right; }
            else { return core::result::Ok(self.update_at<M,R>(index,update)); } }
        }
        let made:core::result::Result<Entry<K,V>,E> = initialize.produce();
        if (made.is_err()) {
            let failure:UpdateError<K,V,E> = UpdateError::Initialize(made.unwrap_err());
            return core::result::Err(failure);
        }
        let item:Entry<K,V> = made.unwrap();
        let key:K = item.key;
        let order:core::ordering::Ordering = policy.compare(key,query);
        if (!core::ordering::is_equal(order)) {
            let failure:UpdateError<K,V,E> = UpdateError::KeyMismatch(item);
            return core::result::Err(failure);
        }
        let added:core::result::Result<i32,Error> = self.insert_vacant(item,parent,left);
        if (added.is_err()) {
            let failure:UpdateError<K,V,E> = UpdateError::Storage(added.unwrap_err(),item);
            return core::result::Err(failure);
        }
        return core::result::Ok(core::option::None());
    }
    pub fn remove_by<Q,P>(&self, query:Q, policy:&P) -> core::option::Option<Entry<K,V>>
        where P:core::ordering::Comparator<K,Q> {
        return self.remove_at(self.find_by<Q,P>(query,policy));
    }
    pub fn first(&self) -> core::option::Option<Entry<K, V>> {
        let nodes: [Node<K, V>] = self.nodes(); let index: i32 = endpoint(nodes, self.root, false);
        if (index < 0) { return core::option::None(); } let node: Node<K, V> = nodes[index]; return core::option::Some(node.item);
    }
    pub fn last(&self) -> core::option::Option<Entry<K, V>> {
        let nodes: [Node<K, V>] = self.nodes(); let index: i32 = endpoint(nodes, self.root, true);
        if (index < 0) { return core::option::None(); } let node: Node<K, V> = nodes[index]; return core::option::Some(node.item);
    }
    fn bound(&self, key: K, strict: bool) -> i32 where K: core::cmp::Ord<K> {
        let nodes: [Node<K, V>] = self.nodes(); let index: i32 = self.root; let candidate: i32 = -1;
        while (index >= 0) {
            let node: Node<K, V> = nodes[index]; let acceptable: bool = false;
            if (strict) { acceptable = K::lt(key, node.item.key); }
            else { acceptable = !K::lt(node.item.key, key); }
            if (acceptable) { candidate = index; index = node.left; } else { index = node.right; }
        }
        return candidate;
    }
    pub fn lower_bound(&self, key: K) -> core::option::Option<Entry<K, V>> where K: core::cmp::Ord<K> {
        let index: i32 = self.bound(key, false); if (index < 0) { return core::option::None(); }
        let nodes: [Node<K, V>] = self.nodes(); let node: Node<K, V> = nodes[index]; return core::option::Some(node.item);
    }
    pub fn upper_bound(&self, key: K) -> core::option::Option<Entry<K, V>> where K: core::cmp::Ord<K> {
        let index: i32 = self.bound(key, true); if (index < 0) { return core::option::None(); }
        let nodes: [Node<K, V>] = self.nodes(); let node: Node<K, V> = nodes[index]; return core::option::Some(node.item);
    }
    pub fn iter(&self) -> Cursor<K, V> {
        let nodes: [Node<K, V>] = self.nodes();
        return Cursor { storage: self.storage, reserved: self.reserved, front: endpoint(nodes, self.root, false), back: endpoint(nodes, self.root, true) };
    }
    // Half-open key interval [lower, upper); equivalent bounds yield empty.
    pub fn range(&self, lower: K, upper: K) -> core::result::Result<Cursor<K, V>, Error> where K: core::cmp::Ord<K> {
        if (K::lt(upper, lower)) { return core::result::Err(Error::InvalidRange); }
        let nodes: [Node<K, V>] = self.nodes(); let front: i32 = self.bound(lower, false); let back: i32 = -1;
        if (front >= 0) {
            let first: Node<K, V> = nodes[front];
            if (K::lt(first.item.key, upper)) {
                let end: i32 = self.bound(upper, false);
                if (end < 0) { back = endpoint(nodes, self.root, true); } else { back = adjacent(nodes, end, true); }
            } else { front = -1; }
        }
        return core::result::Ok(Cursor { storage: self.storage, reserved: self.reserved, front: front, back: back });
    }
    // Ordered navigation. Modes: 0 first stored >= query, 1 first stored >
    // query, 2 last stored <= query, 3 last stored < query. One policy call per
    // visited node, stored key first; the policy must order the stored keys as
    // Less*, Equal*, Greater* (an Equal run may hold several keys).
    fn navigate_by<Q,P>(&self, query:Q, policy:&P, mode:i32) -> i32 where P:core::ordering::Comparator<K,Q> {
        let nodes: [Node<K, V>] = self.nodes(); let index: i32 = self.root; let candidate: i32 = -1;
        while (index >= 0) {
            let node: Node<K, V> = nodes[index];
            let stored: K = node.item.key;
            let order: core::ordering::Ordering = policy.compare(stored, query);
            let accept: bool = core::ordering::is_less(order);
            if (mode == 0) { accept = !core::ordering::is_less(order); }
            if (mode == 1) { accept = core::ordering::is_greater(order); }
            if (mode == 2) { accept = !core::ordering::is_greater(order); }
            if (mode < 2) {
                if (accept) { candidate = index; index = node.left; } else { index = node.right; }
            } else {
                if (accept) { candidate = index; index = node.right; } else { index = node.left; }
            }
        }
        return candidate;
    }
    fn navigate(&self, key:K, mode:i32) -> i32 where K: core::cmp::Ord<K> {
        let policy:NaturalKey<K> = NaturalKey {};
        return self.navigate_by<K,NaturalKey<K>>(key,policy.borrow(),mode);
    }
    // Greatest entry whose key is at most, or strictly less than, the key.
    pub fn last_at_most(&self, key: K) -> core::option::Option<Entry<K, V>> where K: core::cmp::Ord<K> { return self.entry_at(self.navigate(key, 2)); }
    pub fn last_below(&self, key: K) -> core::option::Option<Entry<K, V>> where K: core::cmp::Ord<K> { return self.entry_at(self.navigate(key, 3)); }
    // Heterogeneous navigation through Comparator<K,Q>; see range_bounds_by.
    pub fn lower_bound_by<Q,P>(&self, query:Q, policy:&P) -> core::option::Option<Entry<K,V>>
        where P:core::ordering::Comparator<K,Q> { return self.entry_at(self.navigate_by<Q,P>(query,policy,0)); }
    pub fn upper_bound_by<Q,P>(&self, query:Q, policy:&P) -> core::option::Option<Entry<K,V>>
        where P:core::ordering::Comparator<K,Q> { return self.entry_at(self.navigate_by<Q,P>(query,policy,1)); }
    pub fn last_at_most_by<Q,P>(&self, query:Q, policy:&P) -> core::option::Option<Entry<K,V>>
        where P:core::ordering::Comparator<K,Q> { return self.entry_at(self.navigate_by<Q,P>(query,policy,2)); }
    pub fn last_below_by<Q,P>(&self, query:Q, policy:&P) -> core::option::Option<Entry<K,V>>
        where P:core::ordering::Comparator<K,Q> { return self.entry_at(self.navigate_by<Q,P>(query,policy,3)); }
    fn front_of<Q,P>(&self, lower:core::range::Bound<Q>, policy:&P) -> i32 where P:core::ordering::Comparator<K,Q> {
        return match (lower) {
            core::range::Bound::Included(query) -> self.navigate_by<Q,P>(query,policy,0),
            core::range::Bound::Excluded(query) -> self.navigate_by<Q,P>(query,policy,1),
            core::range::Bound::Unbounded -> endpoint(self.nodes(), self.root, false),
        };
    }
    // Back end for a found front: -1 when the front key already lies above the
    // upper bound (one policy call), else the upper descent's last entry.
    fn back_after<Q,P>(&self, front:i32, query:Q, policy:&P, mode:i32) -> i32 where P:core::ordering::Comparator<K,Q> {
        let nodes: [Node<K, V>] = self.nodes(); let node: Node<K, V> = nodes[front];
        let stored: K = node.item.key;
        let order: core::ordering::Ordering = policy.compare(stored, query);
        let inside: bool = core::ordering::is_less(order);
        if (mode == 2) { inside = !core::ordering::is_greater(order); }
        if (!inside) { return -1; }
        return self.navigate_by<Q,P>(query,policy,mode);
    }
    fn back_of<Q,P>(&self, front:i32, upper:core::range::Bound<Q>, policy:&P) -> i32 where P:core::ordering::Comparator<K,Q> {
        if (front < 0) { return -1; }
        return match (upper) {
            core::range::Bound::Included(query) -> self.back_after<Q,P>(front,query,policy,2),
            core::range::Bound::Excluded(query) -> self.back_after<Q,P>(front,query,policy,3),
            core::range::Bound::Unbounded -> endpoint(self.nodes(), self.root, true),
        };
    }
    // Cursor over stored keys inside both bounds. Calls: the lower descent
    // (none when Unbounded); then, only if it found an entry and upper is
    // bounded, one check of that entry against upper and, if it passes, the
    // upper descent. Bounds that admit no common key give an empty cursor;
    // reversed heterogeneous bounds are not detected separately.
    pub fn range_bounds_by<Q,P>(&self, lower:core::range::Bound<Q>, upper:core::range::Bound<Q>, policy:&P) -> Cursor<K,V>
        where P:core::ordering::Comparator<K,Q> {
        let front: i32 = self.front_of<Q,P>(lower,policy);
        let back: i32 = self.back_of<Q,P>(front,upper,policy);
        if (back < 0) { front = -1; }
        return Cursor { storage: self.storage, reserved: self.reserved, front: front, back: back };
    }
    // Same-key bounds. InvalidRange when both bounds hold values and upper is
    // strictly less than lower; equal values with any exclusion are empty.
    pub fn range_bounds(&self, lower:core::range::Bound<K>, upper:core::range::Bound<K>) -> core::result::Result<Cursor<K,V>, Error> where K: core::cmp::Ord<K> {
        let low: core::option::Option<K> = bound_value<K>(lower);
        let high: core::option::Option<K> = bound_value<K>(upper);
        if (low.is_some() && high.is_some()) {
            if (K::lt(high.unwrap(), low.unwrap())) { return core::result::Err(Error::InvalidRange); }
        }
        let policy:NaturalKey<K> = NaturalKey {};
        return core::result::Ok(self.range_bounds_by<K,NaturalKey<K>>(lower,upper,policy.borrow()));
    }
    // Range removal and extraction. A span is a range cursor's front/back.
    fn span_count(&self, span: Cursor<K, V>) -> i32 {
        let walk: Cursor<K, V> = span; let count: i32 = 0;
        while (walk.next().is_some()) { count += 1; }
        return count;
    }
    // Remove from the back of the span towards its front. Removing an entry
    // can move only its in-order successor's item, which lies above the span,
    // so each precomputed predecessor index stays valid.
    fn remove_span(&self, span: Cursor<K, V>, count: i32) {
        let current: i32 = span.back; let left: i32 = count;
        while (left > 0) {
            let previous: i32 = -1;
            if (left > 1) { previous = adjacent(self.nodes(), current, true); }
            self.remove_at(current); current = previous; left -= 1;
        }
    }
    // Move every span entry, in order, into a new exact-capacity owner.
    // Allocation precedes any change; Err leaves this map untouched.
    fn extract_span(&self, span: Cursor<K, V>) -> core::result::Result<TreeMap<K, V>, Error> {
        let count: i32 = self.span_count(span);
        let moved: TreeMap<K, V> = new();
        if (count == 0) { return core::result::Ok(moved); }
        let reserved: core::result::Result<i32, Error> = moved.try_reserve(count);
        if (reserved.is_err()) { return core::result::Err(reserved.unwrap_err()); }
        let target: [Node<K, V>] = moved.nodes(); let walk: Cursor<K, V> = span; let index: i32 = 0;
        while (index < count) {
            let item: Entry<K, V> = walk.next().unwrap();
            target[index] = Node { item: item, left: -1, right: -1, parent: -1, height: 1, next_free: -1 }; index += 1;
        }
        moved.length = count; moved.link_sorted();
        self.remove_span(span, count);
        return core::result::Ok(moved);
    }
    // Remove every entry inside both bounds and return how many. Like clear,
    // removed keys and values are discarded shallowly with no destructor; use
    // try_extract_range when they own nested resources. Capacity is retained
    // and nothing allocates. Policy calls are exactly those of range_bounds_by.
    pub fn remove_range_by<Q,P>(&self, lower:core::range::Bound<Q>, upper:core::range::Bound<Q>, policy:&P) -> i32
        where P:core::ordering::Comparator<K,Q> {
        let span: Cursor<K, V> = self.range_bounds_by<Q,P>(lower,upper,policy);
        let count: i32 = self.span_count(span); self.remove_span(span, count); return count;
    }
    pub fn remove_range(&self, lower:core::range::Bound<K>, upper:core::range::Bound<K>) -> core::result::Result<i32, Error> where K: core::cmp::Ord<K> {
        let span: core::result::Result<Cursor<K, V>, Error> = self.range_bounds(lower,upper);
        if (span.is_err()) { return core::result::Err(span.unwrap_err()); }
        let count: i32 = self.span_count(span.unwrap()); self.remove_span(span.unwrap(), count); return core::result::Ok(count);
    }
    // Transfer every entry inside both bounds, with its cleanup authority, to
    // a new owner of exactly that capacity (no allocation when empty). Err
    // (AllocationFailed, CapacityOverflow, or InvalidRange for reversed
    // same-key bounds) leaves this map, its capacity and cursors unchanged.
    pub fn try_extract_range_by<Q,P>(&self, lower:core::range::Bound<Q>, upper:core::range::Bound<Q>, policy:&P) -> core::result::Result<TreeMap<K, V>, Error>
        where P:core::ordering::Comparator<K,Q> {
        return self.extract_span(self.range_bounds_by<Q,P>(lower,upper,policy));
    }
    pub fn try_extract_range(&self, lower:core::range::Bound<K>, upper:core::range::Bound<K>) -> core::result::Result<TreeMap<K, V>, Error> where K: core::cmp::Ord<K> {
        let span: core::result::Result<Cursor<K, V>, Error> = self.range_bounds(lower,upper);
        if (span.is_err()) { return core::result::Err(span.unwrap_err()); }
        return self.extract_span(span.unwrap());
    }
    // Keys at least `at` move to the returned owner; smaller keys stay.
    pub fn try_split_off(&self, at: K) -> core::result::Result<TreeMap<K, V>, Error> where K: core::cmp::Ord<K> {
        let rest: core::range::Bound<K> = core::range::Bound::Unbounded;
        return self.try_extract_range(core::range::Bound::Included(at), rest);
    }
    pub fn try_reserve(&self, additional: i32) -> core::result::Result<i32, Error> {
        if (additional < 0) { return core::result::Err(Error::InvalidCapacity); }
        if (additional > capacity_limit<K, V>() - self.length) { return core::result::Err(Error::CapacityOverflow); }
        let capacity: i32 = self.length + additional;
        if (capacity <= self.reserved) { return core::result::Ok(self.reserved); }
        let size: usize = core::mem::size_of<Node<K, V>>();
        let storage: ptr = alloc::allocator::alloc(size * (capacity as usize), ALIGN);
        if (storage == 0) { return core::result::Err(Error::AllocationFailed); }
        let source: [Node<K, V>] = self.nodes(); let target: [Node<K, V>] = core::mem::typed_slice_from_storage(storage, capacity);
        let index: i32 = 0; while (index < self.used) { target[index] = source[index]; index += 1; }
        if (self.reserved > 0) { alloc::allocator::dealloc(self.storage, size * (self.reserved as usize), ALIGN); }
        self.storage = storage; self.reserved = capacity; return core::result::Ok(capacity);
    }
    fn refresh(&self, index: i32) {
        let nodes: [Node<K, V>] = self.nodes(); let node: Node<K, V> = nodes[index];
        let maximum: i32 = height(nodes, node.left); let right: i32 = height(nodes, node.right);
        if (right > maximum) { maximum = right; } node.height = maximum + 1; nodes[index] = node;
    }
    fn attach(&self, parent: i32, old: i32, replacement: i32) {
        let nodes: [Node<K, V>] = self.nodes();
        if (parent < 0) { self.root = replacement; }
        else {
            let upper: Node<K, V> = nodes[parent];
            if (upper.left == old) { upper.left = replacement; } else { assert(upper.right == old); upper.right = replacement; }
            nodes[parent] = upper;
        }
        if (replacement >= 0) { let child: Node<K, V> = nodes[replacement]; child.parent = parent; nodes[replacement] = child; }
    }
    // Rotate while repairing all changed parent links, then refresh bottom-up.
    fn rotate(&self, index: i32, left: bool) -> i32 {
        let nodes: [Node<K, V>] = self.nodes(); let node: Node<K, V> = nodes[index];
        let pivot_index: i32 = node.left; if (left) { pivot_index = node.right; }
        let pivot: Node<K, V> = nodes[pivot_index]; let middle: i32 = pivot.right;
        if (left) { middle = pivot.left; node.right = middle; pivot.left = index; }
        else { node.left = middle; pivot.right = index; }
        let parent: i32 = node.parent; node.parent = pivot_index; pivot.parent = parent;
        nodes[index] = node; nodes[pivot_index] = pivot;
        if (middle >= 0) { let moved: Node<K, V> = nodes[middle]; moved.parent = index; nodes[middle] = moved; }
        self.attach(parent, index, pivot_index); self.refresh(index); self.refresh(pivot_index); return pivot_index;
    }
    // Walk from the changed node toward the root, stopping once a subtree is
    // balanced with its previous height: nothing above it can have changed.
    // (Only insertion and removal call this, each after one local change.)
    fn rebalance(&self, start: i32) {
        let nodes: [Node<K, V>] = self.nodes(); let index: i32 = start;
        while (index >= 0) {
            let before: Node<K, V> = nodes[index]; let previous: i32 = before.height;
            self.refresh(index); let node: Node<K, V> = nodes[index];
            let balance: i32 = height(nodes, node.left) - height(nodes, node.right); let root: i32 = index;
            if (balance > 1) {
                let child: Node<K, V> = nodes[node.left];
                if (height(nodes, child.right) > height(nodes, child.left)) { self.rotate(node.left, true); }
                root = self.rotate(index, false);
            } else { if (balance < -1) {
                let child: Node<K, V> = nodes[node.right];
                if (height(nodes, child.left) > height(nodes, child.right)) { self.rotate(node.right, false); }
                root = self.rotate(index, true);
            } }
            let top: Node<K, V> = nodes[root];
            if (top.height == previous) { return; }
            index = top.parent;
        }
    }
    // An equivalent key replaces both stored key and value, returning the old
    // pair. Replacements never allocate. Failure retains caller-owned inputs.
    pub fn try_insert(&self, key: K, value: V) -> core::result::Result<core::option::Option<Entry<K, V>>, Error> where K: core::cmp::Ord<K> {
        let nodes: [Node<K, V>] = self.nodes(); let index: i32 = self.root; let parent: i32 = -1; let left: bool = false;
        let item: Entry<K, V> = Entry { key: key, value: value };
        while (index >= 0) {
            let node: Node<K, V> = nodes[index]; parent = index;
            if (K::lt(key, node.item.key)) { left = true; index = node.left; }
            else { if (K::lt(node.item.key, key)) { left = false; index = node.right; }
            else { let old: Entry<K, V> = node.item; node.item = item; nodes[index] = node; return core::result::Ok(core::option::Some(old)); } }
        }
        let added:core::result::Result<i32,Error> = self.insert_vacant(item,parent,left);
        if (added.is_err()) { return core::result::Err(added.unwrap_err()); }
        return core::result::Ok(core::option::None());
    }
    // Insert at a known vacant child. Only stable node indices cross reserve;
    // reacquire the backing view afterward. No key callbacks run during commit.
    fn insert_vacant(&self, item:Entry<K,V>, parent:i32, left:bool) -> core::result::Result<i32,Error> {
        if (self.length == self.reserved) {
            let limit: i32 = capacity_limit<K, V>();
            if (self.length == limit) { return core::result::Err(Error::CapacityOverflow); }
            let target: i32 = limit; if (self.reserved <= limit / 2) { target = self.reserved * 2; }
            if (target < 4 && limit >= 4) { target = 4; }
            if (target <= self.length) { target = self.length + 1; }
            let grown: core::result::Result<i32, Error> = self.try_reserve(target - self.length);
            if (core::result::is_err(grown)) { return core::result::Err(core::result::unwrap_err(grown)); }
        }
        let target: [Node<K, V>] = self.nodes(); let index:i32 = self.free;
        if (index >= 0) { let unused: Node<K, V> = target[index]; self.free = unused.next_free; }
        else { index = self.used; assert(index < self.reserved); self.used += 1; }
        target[index] = Node { item: item, left: -1, right: -1, parent: parent, height: 1, next_free: -1 };
        if (parent < 0) { self.root = index; }
        else { let upper: Node<K, V> = target[parent]; if (left) { upper.left = index; } else { upper.right = index; } target[parent] = upper; }
        self.length += 1; self.rebalance(parent); return core::result::Ok(self.length);
    }
    fn remove_at(&self, index: i32) -> core::option::Option<Entry<K, V>> {
        if (index < 0) { return core::option::None(); }
        let nodes: [Node<K, V>] = self.nodes(); let node: Node<K, V> = nodes[index]; let removed: Entry<K, V> = node.item;
        let discard: i32 = index;
        if (node.left >= 0 && node.right >= 0) {
            discard = endpoint(nodes, node.right, false); let successor: Node<K, V> = nodes[discard];
            node.item = successor.item; nodes[index] = node;
        }
        let old: Node<K, V> = nodes[discard]; let child: i32 = old.left; if (child < 0) { child = old.right; }
        let parent: i32 = old.parent; self.attach(parent, discard, child);
        old.left = -1; old.right = -1; old.parent = -1; old.height = 0; old.next_free = self.free; nodes[discard] = old;
        self.free = discard; self.length -= 1;
        if (self.length == 0) { self.clear(); } else { self.rebalance(parent); }
        return core::option::Some(removed);
    }
    pub fn remove(&self, key: K) -> core::option::Option<Entry<K, V>> where K: core::cmp::Ord<K> { return self.remove_at(self.find(key)); }
    pub fn pop_first(&self) -> core::option::Option<Entry<K, V>> { return self.remove_at(endpoint(self.nodes(), self.root, false)); }
    pub fn pop_last(&self) -> core::option::Option<Entry<K, V>> { return self.remove_at(endpoint(self.nodes(), self.root, true)); }
    pub fn clear(&self) { self.used = 0; self.length = 0; self.root = -1; self.free = -1; }
    // Entries at [0,length) are already sorted. Build midpoint subtrees using
    // a bounded interval stack. A count fits i32, so depth is at most 31.
    fn link_sorted(&self) {
        self.used = self.length; self.free = -1;
        if (self.length == 0) { self.root = -1; return; }
        self.root = self.length / 2;
        let lows: [i32; 32] = [0; 32]; let highs: [i32; 32] = [0; 32]; let parents: [i32; 32] = [0; 32];
        lows[0] = 0; highs[0] = self.length; parents[0] = -1; let pending: i32 = 1;
        let nodes: [Node<K, V>] = self.nodes();
        while (pending > 0) {
            pending -= 1; let low: i32 = lows[pending]; let high: i32 = highs[pending]; let parent: i32 = parents[pending];
            let middle: i32 = low + (high - low) / 2; let node: Node<K, V> = nodes[middle];
            node.left = -1; node.right = -1; node.parent = parent; node.height = 0; node.next_free = -1;
            let width: i32 = high - low; while (width > 0) { node.height += 1; width /= 2; }
            if (low < middle) {
                node.left = low + (middle - low) / 2; assert(pending < 32);
                lows[pending] = low; highs[pending] = middle; parents[pending] = middle; pending += 1;
            }
            if (middle + 1 < high) {
                node.right = middle + 1 + (high - middle - 1) / 2; assert(pending < 32);
                lows[pending] = middle + 1; highs[pending] = high; parents[pending] = middle; pending += 1;
            }
            nodes[middle] = node;
        }
    }
    pub fn try_clone(&self) -> core::result::Result<TreeMap<K, V>, Error> {
        let copy: TreeMap<K, V> = new(); let reserved: core::result::Result<i32, Error> = copy.try_reserve(self.length);
        if (core::result::is_err(reserved)) { return core::result::Err(core::result::unwrap_err(reserved)); }
        let target: [Node<K, V>] = copy.nodes(); let cursor: Cursor<K, V> = self.iter(); let index: i32 = 0;
        while (index < self.length) {
            let item: Entry<K, V> = core::option::unwrap(cursor.next());
            target[index] = Node { item: item, left: -1, right: -1, parent: -1, height: 1, next_free: -1 }; index += 1;
        }
        copy.length = self.length; copy.link_sorted(); return core::result::Ok(copy);
    }
    pub fn try_shrink_to_fit(&self) -> core::result::Result<i32, Error> {
        if (self.length == self.reserved) { return core::result::Ok(self.reserved); }
        if (self.length == 0) { self.destroy(); return core::result::Ok(0); }
        let cloned: core::result::Result<TreeMap<K, V>, Error> = self.try_clone();
        if (core::result::is_err(cloned)) { return core::result::Err(core::result::unwrap_err(cloned)); }
        let compact: TreeMap<K, V> = core::result::unwrap(cloned); self.destroy();
        self.storage = compact.storage; self.reserved = compact.reserved; self.used = compact.used;
        self.length = compact.length; self.root = compact.root; self.free = compact.free; return core::result::Ok(self.reserved);
    }
    pub fn destroy(&self) {
        if (self.reserved > 0) { alloc::allocator::dealloc(self.storage, core::mem::size_of<Node<K, V>>() * (self.reserved as usize), ALIGN); }
        let empty: ptr = 0; self.storage = empty; self.reserved = 0; self.clear();
    }
}

// Reject before allocation or replacement. Ordering must remain lawful and
// stable, without reentrant mutation of this map during either lookup.
pub impl<K, V> core::iter::TrySink<Entry<K, V>, SinkError> for TreeMap<K, V>
    where K: core::cmp::Ord<K> {
    pub fn try_accept(&self, item: Entry<K, V>) -> core::option::Option<SinkError> {
        if (self.contains_key(item.key)) { return core::option::Some(SinkError::Duplicate()); }
        let inserted: core::result::Result<core::option::Option<Entry<K, V>>, Error> = self.try_insert(item.key, item.value);
        if (core::result::is_err(inserted)) { return core::option::Some(SinkError::Storage(core::result::unwrap_err(inserted))); }
        let previous: core::option::Option<Entry<K, V>> = core::result::unwrap(inserted);
        // Stable key behavior keeps the prechecked key absent until insertion.
        assert(core::option::is_none(previous));
        return core::option::None();
    }
}

// Preserve canonical replacement of both key/value and its complete old entry.
// No duplicate precheck or remove/reinsert transaction is introduced.
pub impl<K,V> core::iter::TryReplaceSink<Entry<K,V>,Error> for TreeMap<K,V>
    where K: core::cmp::Ord<K> {
    pub fn try_replace_item(&self, item: Entry<K,V>) -> core::result::Result<core::option::Option<Entry<K,V>>,Error> {
        return self.try_insert(item.key,item.value);
    }
}

pub impl<K, V> Cursor<K, V> {
    pub fn borrow(&self) -> &Cursor<K, V> { return self; }
    pub fn is_empty(&self) -> bool { return self.front < 0; }
}

pub impl<K, V> core::iter::Iterator<Entry<K, V>> for Cursor<K, V> {
    pub fn next(&self) -> core::option::Option<Entry<K, V>> {
        if (self.front < 0) { return core::option::None(); }
        let nodes: [Node<K, V>] = core::mem::typed_slice_from_storage(self.storage, self.reserved);
        let node: Node<K, V> = nodes[self.front];
        if (self.front == self.back) { self.front = -1; self.back = -1; }
        else { self.front = adjacent(nodes, self.front, false); }
        return core::option::Some(node.item);
    }
}

pub impl<K, V> core::iter::DoubleEndedIterator<Entry<K, V>> for Cursor<K, V> {
    pub fn next_back(&self) -> core::option::Option<Entry<K, V>> {
        if (self.back < 0) { return core::option::None(); }
        let nodes: [Node<K, V>] = core::mem::typed_slice_from_storage(self.storage, self.reserved);
        let node: Node<K, V> = nodes[self.back];
        if (self.front == self.back) { self.front = -1; self.back = -1; }
        else { self.back = adjacent(nodes, self.back, true); }
        return core::option::Some(node.item);
    }
}

pub impl<K, V> IntoIter<K, V> {
    pub fn borrow(&self) -> &IntoIter<K, V> { return self; }
    pub fn remaining(&self) -> i32 { return self.owner.len(); }
    pub fn capacity(&self) -> i32 { return self.owner.capacity(); }
    pub fn is_empty(&self) -> bool { return self.owner.is_empty(); }
    // Exhaustion retains backing. Rejecting finish preserves the exact owner;
    // successful finish frees backing and disarms it, repeatably.
    pub fn try_finish(&self) -> core::option::Option<IntoIterError> {
        let count: i32 = self.remaining();
        if (count > 0) { return core::option::Some(IntoIterError::Remaining(count)); }
        self.owner.destroy(); return core::option::None();
    }
    // O(1) handoff of the valid remaining tree, including holes, capacity and
    // its current free list. No compaction, allocation or nested destruction.
    pub fn take_remaining(&self) -> TreeMap<K, V> { return self.owner.take_owner(); }
}
pub impl<K, V> core::iter::Iterator<Entry<K, V>> for IntoIter<K, V> {
    pub fn next(&self) -> core::option::Option<Entry<K, V>> {
        return self.owner.pop_first();
    }
}

pub impl<K, V> core::iter::DoubleEndedIterator<Entry<K, V>> for IntoIter<K, V> {
    // Endpoint removal preserves the canonical AVL tree and transfers a pair
    // without comparison, cloning, release or allocation. O(log n) per pop.
    pub fn next_back(&self) -> core::option::Option<Entry<K, V>> { return self.owner.pop_last(); }
}

pub impl<K, V> core::iter::ExactSizeIterator<Entry<K, V>> for IntoIter<K, V> {
    pub fn remaining_count(&self) -> u64 { return self.remaining() as u64; }
}

// Internal set-storage boundary. One typed facade owns each state; temporary
// typed map/cursor views never escape. Width checks are layout guards, not
// permission to reinterpret a different key schema. The map above remains the
// only storage, allocation, hashing/probing or balancing implementation.
struct KeyUnit {}
pub struct KeyStorage { storage: ptr, reserved: i32, used: i32, length: i32, root: i32, free: i32, key_bytes: usize }
pub struct KeyCursor { storage: ptr, reserved: i32, front: i32, back: i32, key_bytes: usize }
pub impl KeyStorage { pub fn borrow(&self) -> &KeyStorage { return self; } }
pub impl KeyCursor { pub fn borrow(&self) -> &KeyCursor { return self; } }
pub fn key_storage<T>() -> KeyStorage {
    let storage: ptr = 0;
    return KeyStorage { storage: storage, reserved: 0, used: 0, length: 0, root: -1, free: -1, key_bytes: core::mem::size_of<T>() };
}
fn key_view<T>(owner: &KeyStorage) -> TreeMap<T, KeyUnit> {
    assert(owner.key_bytes == core::mem::size_of<T>());
    return TreeMap { storage: owner.storage, reserved: owner.reserved, used: owner.used, length: owner.length, root: owner.root, free: owner.free };
}
fn key_update<T>(owner: &KeyStorage, map: TreeMap<T, KeyUnit>) {
    owner.storage = map.storage; owner.reserved = map.reserved; owner.used = map.used; owner.length = map.length; owner.root = map.root; owner.free = map.free;
}
pub fn key_replace<T>(owner: &KeyStorage, key: T) -> core::result::Result<core::option::Option<T>, Error> where T: core::cmp::Ord<T> {
    let map: TreeMap<T, KeyUnit> = key_view<T>(owner); let unit: KeyUnit = KeyUnit {};
    let result: core::result::Result<core::option::Option<Entry<T, KeyUnit>>, Error> = map.try_insert(key, unit);
    key_update<T>(owner, map);
    if (core::result::is_err(result)) { return core::result::Err(core::result::unwrap_err(result)); }
    let old: core::option::Option<Entry<T, KeyUnit>> = core::result::unwrap(result);
    if (core::option::is_none(old)) { return core::result::Ok(core::option::None()); }
    let entry: Entry<T, KeyUnit> = core::option::unwrap(old); return core::result::Ok(core::option::Some(entry.key));
}
pub fn key_contains<T>(owner: &KeyStorage, key: T) -> bool where T: core::cmp::Ord<T> {
    let map: TreeMap<T, KeyUnit> = key_view<T>(owner); return map.contains_key(key);
}
pub fn key_iter<T>(owner: &KeyStorage) -> KeyCursor {
    let map: TreeMap<T, KeyUnit> = key_view<T>(owner); let cursor: Cursor<T, KeyUnit> = map.iter();
    return KeyCursor { storage: cursor.storage, reserved: cursor.reserved, front: cursor.front, back: cursor.back, key_bytes: owner.key_bytes };
}
pub fn key_next<T>(cursor: &KeyCursor) -> core::option::Option<T> {
    assert(cursor.key_bytes == core::mem::size_of<T>());
    let view: Cursor<T, KeyUnit> = Cursor { storage: cursor.storage, reserved: cursor.reserved, front: cursor.front, back: cursor.back };
    let result: core::option::Option<Entry<T, KeyUnit>> = view.next();
    cursor.storage = view.storage; cursor.reserved = view.reserved; cursor.front = view.front; cursor.back = view.back;
    if (core::option::is_none(result)) { return core::option::None(); }
    let entry: Entry<T, KeyUnit> = core::option::unwrap(result); return core::option::Some(entry.key);
}
pub fn key_destroy<T>(owner: &KeyStorage) {
    let map: TreeMap<T, KeyUnit> = key_view<T>(owner); map.destroy(); key_update<T>(owner, map);
}

pub fn key_get<T>(owner: &KeyStorage, key: T) -> core::option::Option<T> where T: core::cmp::Ord<T> {
    let map: TreeMap<T, KeyUnit> = key_view<T>(owner);
    let result: core::option::Option<Entry<T, KeyUnit>> = map.get_entry(key);
    if (core::option::is_none(result)) { return core::option::None(); }
    let entry: Entry<T, KeyUnit> = core::option::unwrap(result); return core::option::Some(entry.key);
}
pub fn key_remove<T>(owner: &KeyStorage, key: T) -> core::option::Option<T> where T: core::cmp::Ord<T> {
    let map: TreeMap<T, KeyUnit> = key_view<T>(owner);
    let result: core::option::Option<Entry<T, KeyUnit>> = map.remove(key);
    key_update<T>(owner, map);
    if (core::option::is_none(result)) { return core::option::None(); }
    let entry: Entry<T, KeyUnit> = core::option::unwrap(result); return core::option::Some(entry.key);
}
pub fn key_contains_by<T,Q,P>(owner:&KeyStorage, query:Q, policy:&P) -> bool
    where P:core::ordering::Comparator<T,Q> {
    let map:TreeMap<T,KeyUnit> = key_view<T>(owner); return map.contains_key_by<Q,P>(query,policy);
}
pub fn key_get_by<T,Q,P>(owner:&KeyStorage, query:Q, policy:&P) -> core::option::Option<T>
    where P:core::ordering::Comparator<T,Q> {
    let map:TreeMap<T,KeyUnit> = key_view<T>(owner);
    let found:core::option::Option<Entry<T,KeyUnit>> = map.get_entry_by<Q,P>(query,policy);
    if (core::option::is_none(found)) { return core::option::None(); }
    let item:Entry<T,KeyUnit> = core::option::unwrap(found); return core::option::Some(item.key);
}
pub fn key_remove_by<T,Q,P>(owner:&KeyStorage, query:Q, policy:&P) -> core::option::Option<T>
    where P:core::ordering::Comparator<T,Q> {
    let map:TreeMap<T,KeyUnit> = key_view<T>(owner);
    let found:core::option::Option<Entry<T,KeyUnit>> = map.remove_by<Q,P>(query,policy);
    key_update<T>(owner,map);
    if (core::option::is_none(found)) { return core::option::None(); }
    let item:Entry<T,KeyUnit> = core::option::unwrap(found); return core::option::Some(item.key);
}
pub fn key_reserve<T>(owner: &KeyStorage, additional: i32) -> core::result::Result<i32, Error> {
    let map: TreeMap<T, KeyUnit> = key_view<T>(owner);
    let result: core::result::Result<i32, Error> = map.try_reserve(additional);
    key_update<T>(owner, map); return result;
}
pub fn key_shrink<T>(owner: &KeyStorage) -> core::result::Result<i32, Error> {
    let map: TreeMap<T, KeyUnit> = key_view<T>(owner);
    let result: core::result::Result<i32, Error> = map.try_shrink_to_fit();
    key_update<T>(owner, map); return result;
}
pub fn key_clone<T>(owner: &KeyStorage) -> core::result::Result<KeyStorage, Error> {
    let map: TreeMap<T, KeyUnit> = key_view<T>(owner);
    let result: core::result::Result<TreeMap<T, KeyUnit>, Error> = map.try_clone();
    if (core::result::is_err(result)) { return core::result::Err(core::result::unwrap_err(result)); }
    let copy: TreeMap<T, KeyUnit> = core::result::unwrap(result);
    let state: KeyStorage = key_storage<T>(); key_update<T>(state.borrow(), copy); return core::result::Ok(state);
}
pub fn key_clear<T>(owner: &KeyStorage) {
    let map: TreeMap<T, KeyUnit> = key_view<T>(owner); map.clear(); key_update<T>(owner, map);
}
fn key_cursor<T>(cursor: Cursor<T, KeyUnit>) -> KeyCursor {
    return KeyCursor { storage: cursor.storage, reserved: cursor.reserved, front: cursor.front, back: cursor.back, key_bytes: core::mem::size_of<T>() };
}
pub fn key_endpoint<T>(owner: &KeyStorage, last: bool) -> core::option::Option<T> {
    let map: TreeMap<T, KeyUnit> = key_view<T>(owner);
    let result: core::option::Option<Entry<T, KeyUnit>> = map.first(); if (last) { result = map.last(); }
    if (core::option::is_none(result)) { return core::option::None(); }
    let entry: Entry<T, KeyUnit> = core::option::unwrap(result); return core::option::Some(entry.key);
}
pub fn key_pop<T>(owner: &KeyStorage, last: bool) -> core::option::Option<T> {
    let map: TreeMap<T, KeyUnit> = key_view<T>(owner);
    let result: core::option::Option<Entry<T, KeyUnit>> = core::option::None();
    if (last) { result = map.pop_last(); } else { result = map.pop_first(); }
    key_update<T>(owner, map);
    if (core::option::is_none(result)) { return core::option::None(); }
    let entry: Entry<T, KeyUnit> = core::option::unwrap(result); return core::option::Some(entry.key);
}
pub fn key_bound<T>(owner: &KeyStorage, key: T, strict: bool) -> core::option::Option<T> where T: core::cmp::Ord<T> {
    let map: TreeMap<T, KeyUnit> = key_view<T>(owner);
    let result: core::option::Option<Entry<T, KeyUnit>> = map.lower_bound(key); if (strict) { result = map.upper_bound(key); }
    if (core::option::is_none(result)) { return core::option::None(); }
    let entry: Entry<T, KeyUnit> = core::option::unwrap(result); return core::option::Some(entry.key);
}
pub fn key_range<T>(owner: &KeyStorage, lower: T, upper: T) -> core::result::Result<KeyCursor, Error> where T: core::cmp::Ord<T> {
    let map: TreeMap<T, KeyUnit> = key_view<T>(owner);
    let result: core::result::Result<Cursor<T, KeyUnit>, Error> = map.range(lower, upper);
    if (core::result::is_err(result)) { return core::result::Err(core::result::unwrap_err(result)); }
    let cursor: Cursor<T, KeyUnit> = core::result::unwrap(result); return core::result::Ok(key_cursor<T>(cursor));
}
pub fn key_next_back<T>(cursor: &KeyCursor) -> core::option::Option<T> {
    assert(cursor.key_bytes == core::mem::size_of<T>());
    let view: Cursor<T, KeyUnit> = Cursor { storage: cursor.storage, reserved: cursor.reserved, front: cursor.front, back: cursor.back };
    let result: core::option::Option<Entry<T, KeyUnit>> = view.next_back();
    cursor.storage = view.storage; cursor.reserved = view.reserved; cursor.front = view.front; cursor.back = view.back;
    if (core::option::is_none(result)) { return core::option::None(); }
    let entry: Entry<T, KeyUnit> = core::option::unwrap(result); return core::option::Some(entry.key);
}
// Navigation bridges for TreeSet. Modes as in TreeMap.navigate_by:
// 0 first >= query, 1 first >, 2 last <=, 3 last <.
fn key_entry<T>(found: core::option::Option<Entry<T, KeyUnit>>) -> core::option::Option<T> {
    if (core::option::is_none(found)) { return core::option::None(); }
    let entry: Entry<T, KeyUnit> = core::option::unwrap(found); return core::option::Some(entry.key);
}
pub fn key_navigate<T>(owner: &KeyStorage, key: T, mode: i32) -> core::option::Option<T> where T: core::cmp::Ord<T> {
    assert(mode >= 0 && mode <= 3);
    let map: TreeMap<T, KeyUnit> = key_view<T>(owner); return key_entry<T>(map.entry_at(map.navigate(key, mode)));
}
pub fn key_navigate_by<T,Q,P>(owner: &KeyStorage, query: Q, policy: &P, mode: i32) -> core::option::Option<T>
    where P: core::ordering::Comparator<T,Q> {
    assert(mode >= 0 && mode <= 3);
    let map: TreeMap<T, KeyUnit> = key_view<T>(owner); return key_entry<T>(map.entry_at(map.navigate_by<Q,P>(query, policy, mode)));
}
pub fn key_range_bounds<T>(owner: &KeyStorage, lower: core::range::Bound<T>, upper: core::range::Bound<T>) -> core::result::Result<KeyCursor, Error> where T: core::cmp::Ord<T> {
    let map: TreeMap<T, KeyUnit> = key_view<T>(owner);
    let result: core::result::Result<Cursor<T, KeyUnit>, Error> = map.range_bounds(lower, upper);
    if (core::result::is_err(result)) { return core::result::Err(core::result::unwrap_err(result)); }
    let cursor: Cursor<T, KeyUnit> = core::result::unwrap(result); return core::result::Ok(key_cursor<T>(cursor));
}
pub fn key_range_bounds_by<T,Q,P>(owner: &KeyStorage, lower: core::range::Bound<Q>, upper: core::range::Bound<Q>, policy: &P) -> KeyCursor
    where P: core::ordering::Comparator<T,Q> {
    let map: TreeMap<T, KeyUnit> = key_view<T>(owner);
    return key_cursor<T>(map.range_bounds_by<Q,P>(lower, upper, policy));
}
// Range removal/extraction bridges for TreeSet.
fn key_moved<T>(result: core::result::Result<TreeMap<T, KeyUnit>, Error>) -> core::result::Result<KeyStorage, Error> {
    if (core::result::is_err(result)) { return core::result::Err(core::result::unwrap_err(result)); }
    let state: KeyStorage = key_storage<T>(); key_update<T>(state.borrow(), core::result::unwrap(result)); return core::result::Ok(state);
}
pub fn key_remove_range<T>(owner: &KeyStorage, lower: core::range::Bound<T>, upper: core::range::Bound<T>) -> core::result::Result<i32, Error> where T: core::cmp::Ord<T> {
    let map: TreeMap<T, KeyUnit> = key_view<T>(owner);
    let result: core::result::Result<i32, Error> = map.remove_range(lower, upper); key_update<T>(owner, map); return result;
}
pub fn key_remove_range_by<T,Q,P>(owner: &KeyStorage, lower: core::range::Bound<Q>, upper: core::range::Bound<Q>, policy: &P) -> i32
    where P: core::ordering::Comparator<T,Q> {
    let map: TreeMap<T, KeyUnit> = key_view<T>(owner);
    let count: i32 = map.remove_range_by<Q,P>(lower, upper, policy); key_update<T>(owner, map); return count;
}
pub fn key_extract_range<T>(owner: &KeyStorage, lower: core::range::Bound<T>, upper: core::range::Bound<T>) -> core::result::Result<KeyStorage, Error> where T: core::cmp::Ord<T> {
    let map: TreeMap<T, KeyUnit> = key_view<T>(owner);
    let result: core::result::Result<TreeMap<T, KeyUnit>, Error> = map.try_extract_range(lower, upper); key_update<T>(owner, map); return key_moved<T>(result);
}
pub fn key_extract_range_by<T,Q,P>(owner: &KeyStorage, lower: core::range::Bound<Q>, upper: core::range::Bound<Q>, policy: &P) -> core::result::Result<KeyStorage, Error>
    where P: core::ordering::Comparator<T,Q> {
    let map: TreeMap<T, KeyUnit> = key_view<T>(owner);
    let result: core::result::Result<TreeMap<T, KeyUnit>, Error> = map.try_extract_range_by<Q,P>(lower, upper, policy); key_update<T>(owner, map); return key_moved<T>(result);
}
