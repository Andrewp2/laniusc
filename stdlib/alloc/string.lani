// Owned UTF-8 in packed bytes. Copies of String alias one allocation; keep
// one owner and destroy it once. Methods borrow that owner and update it.
// All fallible edits preserve the owner and contents on Err. Successful
// edits may invalidate borrowed byte views. NUL is an ordinary text scalar.
module alloc::string;
import core::byte;
import core::cmp;
import core::decimal;
import core::hash;
import core::option;
import core::result;
import core::slice;
import core::utf8;
import core::text;
import std::vec;

pub enum Error {
    InvalidUtf8(i32),
    InvalidScalar,
    Bounds,
    NotCharBoundary,
    CapacityOverflow,
    AllocationFailed,
}

pub struct String {
    bytes: std::vec::Vec<u8>,
}

pub fn new() -> String {
    let bytes: std::vec::Vec<u8> = std::vec::new();
    return String { bytes: bytes };
}

// Copy count bytes into independent storage. The source slice must back
// count bytes; an overclaimed physical slice traps. Negative count is Bounds.
pub fn from_utf8(bytes: [u8], count: i32) -> core::result::Result<String, Error> {
    let value: String = new();
    let status: core::result::Result<i32, Error> = value.try_append_utf8(bytes, count);
    return match (status) {
        Ok(_) -> core::result::Ok(value),
        Err(error) -> core::result::Err(error),
    };
}

// Copy a borrowed view into independent owned storage.
pub fn from_text(text: core::text::Text) -> core::result::Result<String, Error> {
    let value: String = new();
    let status: core::result::Result<i32, Error> = value.try_append_text(text);
    if (core::result::is_err(status)) { return core::result::Err(core::result::unwrap_err(status)); }
    return core::result::Ok(value);
}

// Independent copies, with all length arithmetic checked before allocation.
// Empty parts produce empty text; separators appear only between parts.
pub fn join(parts: core::slice::View<core::text::Text>, separator: core::text::Text) -> core::result::Result<String, Error> {
    let value: String = new();
    let status: core::result::Result<i32, Error> = value.try_append_joined(parts, separator);
    if (core::result::is_err(status)) { return core::result::Err(core::result::unwrap_err(status)); }
    return core::result::Ok(value);
}

// A negative repetition count is Bounds. Zero repetitions and empty source
// produce an empty String without allocating or reading source bytes.
pub fn repeat(text: core::text::Text, count: i32) -> core::result::Result<String, Error> {
    let value: String = new();
    let status: core::result::Result<i32, Error> = value.try_append_repeated(text, count);
    if (core::result::is_err(status)) { return core::result::Err(core::result::unwrap_err(status)); }
    return core::result::Ok(value);
}

fn joined_length(parts: core::slice::View<core::text::Text>, separator: core::text::Text) -> core::result::Result<i32, Error> {
    let count: i32 = parts.len();
    if (count == 0) { return core::result::Ok(0); }
    let width: i32 = separator.byte_len();
    if (width > 0 && count - 1 > 2147483647 / width) { return core::result::Err(Error::CapacityOverflow); }
    let length: i32 = (count - 1) * width;
    let index: i32 = 0;
    while (index < count) {
        let part: core::text::Text = core::option::unwrap(parts.get(index));
        if (part.byte_len() > 2147483647 - length) { return core::result::Err(Error::CapacityOverflow); }
        length += part.byte_len();
        index += 1;
    }
    return core::result::Ok(length);
}

// Caller reserved sufficient capacity. Text is already valid UTF-8.
fn append_reserved(bytes: std::vec::Vec<u8>, text: core::text::Text) -> std::vec::Vec<u8> {
    let result: std::vec::Vec<u8> = bytes;
    let index: i32 = 0;
    while (index < text.byte_len()) {
        result = std::vec::try_push(result, core::option::unwrap(text.byte_at(index)));
        index += 1;
    }
    return result;
}

// Exact base-ten integers, without padding or a leading plus. Smaller integer
// types can widen to these signed/unsigned entry points without losing values.
pub fn from_i64(number: i64) -> core::result::Result<String, Error> {
    let bytes: [u8; 20] = [0; 20];
    let count: i32 = core::result::unwrap(core::decimal::format_i64(bytes, 0, 20, number));
    return from_utf8(bytes, count);
}
pub fn from_u64(number: u64) -> core::result::Result<String, Error> {
    let bytes: [u8; 20] = [0; 20];
    let count: i32 = core::result::unwrap(core::decimal::format_u64(bytes, 0, 20, number));
    return from_utf8(bytes, count);
}

fn text_error(error: core::text::Error) -> Error {
    let converted: Error = match (error) {
        core::text::Error::Bounds -> Error::Bounds,
        core::text::Error::NotCharBoundary -> Error::NotCharBoundary,
        core::text::Error::InvalidUtf8(offset) -> Error::InvalidUtf8(offset),
    };
    return converted;
}

fn growth_capacity(current: i32, needed: i32) -> i32 {
    let target: i32 = 4;
    if (current > 0) {
        if (current > 1073741823) { target = 2147483647; }
        else { target = current * 2; }
    }
    if (target < needed) { target = needed; }
    return target;
}

pub impl String {
    // If growth is needed, keep the original allocation live until every
    // aliased input has been copied. Only commit_append releases that owner.
    fn prepare_append(&self, count: i32) -> core::result::Result<std::vec::Vec<u8>, Error> {
        let length: i32 = std::vec::len(self.bytes);
        if (count > 2147483647 - length) { return core::result::Err(Error::CapacityOverflow); }
        let needed: i32 = length + count;
        if (needed <= std::vec::capacity(self.bytes)) { return core::result::Ok(self.bytes); }
        let grown: std::vec::Vec<u8> = std::vec::try_with_capacity(growth_capacity(std::vec::capacity(self.bytes), needed));
        if (std::vec::capacity(grown) < needed) { return core::result::Err(Error::AllocationFailed); }
        grown = std::vec::try_extend_from_slice(grown, std::vec::as_slice(self.bytes), length);
        return core::result::Ok(grown);
    }

    fn commit_append(&self, bytes: std::vec::Vec<u8>) -> i32 {
        // prepare_append returns either our existing storage or a strictly
        // larger allocation; appending within that reservation keeps capacity.
        if (std::vec::capacity(bytes) != std::vec::capacity(self.bytes)) { std::vec::destroy(self.bytes); }
        self.bytes = bytes;
        return std::vec::len(bytes);
    }

    pub fn byte_len(&self) -> i32 { return std::vec::len(self.bytes); }
    pub fn capacity(&self) -> i32 { return std::vec::capacity(self.bytes); }
    pub fn is_empty(&self) -> bool { return std::vec::is_empty(self.bytes); }

    // Borrow initialized bytes. Treat this view as read-only: writing it can
    // violate UTF-8 validity. Lanius does not yet enforce immutable views.
    pub fn as_bytes(&self) -> [u8] { return std::vec::as_slice(self.bytes); }

    // O(1) borrowed view: this owner already maintains UTF-8 validity.
    // Mutation or destruction invalidates it, including mutation via as_bytes.
    pub fn as_text(&self) -> core::text::Text {
        return core::text::from_utf8_unchecked(std::vec::as_slice(self.bytes), 0, std::vec::len(self.bytes));
    }

    pub fn byte_at(&self, index: i32) -> core::option::Option<u8> {
        return std::vec::get(self.bytes, index);
    }

    pub fn is_char_boundary(&self, index: i32) -> bool {
        let length: i32 = std::vec::len(self.bytes);
        if (index < 0 || index > length) { return false; }
        if (index == length) { return true; }
        let bytes: [u8] = std::vec::as_slice(self.bytes);
        return !core::utf8::is_continuation_byte(bytes[index]);
    }

    pub fn scalar_count(&self) -> i32 {
        let bytes: [u8] = std::vec::as_slice(self.bytes);
        let length: i32 = std::vec::len(self.bytes);
        let index: i32 = 0;
        let count: i32 = 0;
        while (index < length) {
            index += core::utf8::sequence_len_or(bytes[index], 1) as i32;
            count += 1;
        }
        return count;
    }

    // Decode the scalar starting at byte_index. Out-of-bounds and interior
    // byte positions have no scalar. byte_len() is also past the last scalar.
    pub fn scalar_at_byte(&self, byte_index: i32) -> core::option::Option<u32> {
        let length: i32 = std::vec::len(self.bytes);
        if (byte_index < 0 || byte_index >= length || !self.is_char_boundary(byte_index)) {
            return core::option::None();
        }
        let bytes: [u8] = std::vec::as_slice(self.bytes);
        let first: u8 = bytes[byte_index];
        let width: u32 = core::utf8::sequence_len_or(first, 0);
        let second: u8 = 0;
        let third: u8 = 0;
        let fourth: u8 = 0;
        if (width > 1) { second = bytes[byte_index + 1]; }
        if (width > 2) { third = bytes[byte_index + 2]; }
        if (width > 3) { fourth = bytes[byte_index + 3]; }
        return core::option::Some(core::utf8::decode_or(first, second, third, fourth, width, 4294967295));
    }

    // Reserve at least minimum bytes in total; return the resulting capacity.
    pub fn try_reserve(&self, minimum: i32) -> core::result::Result<i32, Error> {
        if (minimum < 0) { return core::result::Err(Error::Bounds); }
        let grown: std::vec::Vec<u8> = std::vec::try_reserve(self.bytes, minimum);
        if (std::vec::capacity(grown) < minimum) { return core::result::Err(Error::AllocationFailed); }
        self.bytes = grown;
        return core::result::Ok(std::vec::capacity(grown));
    }

    // Append one Unicode scalar; return the new byte length.
    pub fn try_push_scalar(&self, scalar: u32) -> core::result::Result<i32, Error> {
        let width: u32 = core::utf8::encoded_len_or(scalar, 0);
        if (width == 0) { return core::result::Err(Error::InvalidScalar); }
        let length: i32 = std::vec::len(self.bytes);
        let count: i32 = width as i32;
        if (count > 2147483647 - length) { return core::result::Err(Error::CapacityOverflow); }
        let grown: std::vec::Vec<u8> = self.bytes;
        let needed: i32 = length + count;
        if (std::vec::capacity(grown) < needed) {
            let target: i32 = growth_capacity(std::vec::capacity(grown), needed);
            grown = std::vec::try_reserve(grown, target);
            if (std::vec::capacity(grown) < needed) { return core::result::Err(Error::AllocationFailed); }
        }
        let index: u32 = 0;
        while (index < width) {
            grown = std::vec::try_push(grown, core::utf8::encoded_byte_or(scalar, index, 0));
            index += 1;
        }
        self.bytes = grown;
        return core::result::Ok(needed);
    }

    // Append a complete UTF-8 sequence, including a view into this String.
    // Growth retains the old allocation until both copies finish, so a view
    // into this owner remains readable. Source bytes must be initialized.
    pub fn try_append_utf8(&self, source: [u8], count: i32) -> core::result::Result<i32, Error> {
        if (count < 0) { return core::result::Err(Error::Bounds); }
        if (count > 2147483647 - std::vec::len(self.bytes)) { return core::result::Err(Error::CapacityOverflow); }
        let checked: core::result::Result<core::text::Text, core::text::Error> = core::text::from_utf8(source, count);
        if (core::result::is_err(checked)) { return core::result::Err(text_error(core::result::unwrap_err(checked))); }
        return self.try_append_text(core::result::unwrap(checked));
    }

    // Append a valid borrowed view, including a subview of this String.
    // Reserve before editing; retain old storage until an aliased copy finishes.
    pub fn try_append_text(&self, source: core::text::Text) -> core::result::Result<i32, Error> {
        let count: i32 = source.byte_len();
        if (count == 0) { return core::result::Ok(self.byte_len()); }
        let prepared: core::result::Result<std::vec::Vec<u8>, Error> = self.prepare_append(count);
        if (core::result::is_err(prepared)) { return core::result::Err(core::result::unwrap_err(prepared)); }
        let grown: std::vec::Vec<u8> = append_reserved(core::result::unwrap(prepared), source);
        return core::result::Ok(self.commit_append(grown));
    }

    // Append the complete joined sequence atomically. Parts and separator may
    // borrow this String, including during growth. Return the new byte length.
    pub fn try_append_joined(&self, parts: core::slice::View<core::text::Text>, separator: core::text::Text) -> core::result::Result<i32, Error> {
        let total: core::result::Result<i32, Error> = joined_length(parts, separator);
        if (core::result::is_err(total)) { return core::result::Err(core::result::unwrap_err(total)); }
        let count: i32 = core::result::unwrap(total);
        if (count == 0) { return core::result::Ok(self.byte_len()); }
        let prepared: core::result::Result<std::vec::Vec<u8>, Error> = self.prepare_append(count);
        if (core::result::is_err(prepared)) { return core::result::Err(core::result::unwrap_err(prepared)); }
        let grown: std::vec::Vec<u8> = core::result::unwrap(prepared);
        let index: i32 = 0;
        while (index < parts.len()) {
            if (index > 0) { grown = append_reserved(grown, separator); }
            grown = append_reserved(grown, core::option::unwrap(parts.get(index)));
            index += 1;
        }
        return core::result::Ok(self.commit_append(grown));
    }

    // Append count copies atomically. Source may be a subview of this owner.
    pub fn try_append_repeated(&self, source: core::text::Text, count: i32) -> core::result::Result<i32, Error> {
        if (count < 0) { return core::result::Err(Error::Bounds); }
        let width: i32 = source.byte_len();
        if (width == 0 || count == 0) { return core::result::Ok(self.byte_len()); }
        if (count > 2147483647 / width) { return core::result::Err(Error::CapacityOverflow); }
        let prepared: core::result::Result<std::vec::Vec<u8>, Error> = self.prepare_append(count * width);
        if (core::result::is_err(prepared)) { return core::result::Err(core::result::unwrap_err(prepared)); }
        let grown: std::vec::Vec<u8> = core::result::unwrap(prepared);
        let index: i32 = 0;
        while (index < count) { grown = append_reserved(grown, source); index += 1; }
        return core::result::Ok(self.commit_append(grown));
    }

    pub fn try_append(&self, other: String) -> core::result::Result<i32, Error> {
        return self.try_append_text(other.as_text());
    }

    // Return the new byte length; allocation/capacity failure preserves the
    // original string and its borrowed views, as for other fallible edits.
    pub fn try_append_i64(&self, number: i64) -> core::result::Result<i32, Error> {
        let bytes: [u8; 20] = [0; 20];
        let count: i32 = core::result::unwrap(core::decimal::format_i64(bytes, 0, 20, number));
        return self.try_append_utf8(bytes, count);
    }
    pub fn try_append_u64(&self, number: u64) -> core::result::Result<i32, Error> {
        let bytes: [u8; 20] = [0; 20];
        let count: i32 = core::result::unwrap(core::decimal::format_u64(bytes, 0, 20, number));
        return self.try_append_utf8(bytes, count);
    }

    // Truncate at a byte boundary. Requests beyond the length are errors.
    pub fn try_truncate(&self, length: i32) -> core::result::Result<i32, Error> {
        if (length < 0 || length > std::vec::len(self.bytes)) { return core::result::Err(Error::Bounds); }
        if (!self.is_char_boundary(length)) { return core::result::Err(Error::NotCharBoundary); }
        self.bytes = std::vec::truncate(self.bytes, length);
        return core::result::Ok(length);
    }

    pub fn pop_scalar(&self) -> core::option::Option<u32> {
        let length: i32 = std::vec::len(self.bytes);
        if (length == 0) { return core::option::None(); }
        let bytes: [u8] = std::vec::as_slice(self.bytes);
        let start: i32 = length - 1;
        while (start > 0 && core::utf8::is_continuation_byte(bytes[start])) { start -= 1; }
        let scalar: core::option::Option<u32> = self.scalar_at_byte(start);
        self.bytes = std::vec::truncate(self.bytes, start);
        return scalar;
    }

    pub fn clear(&self) { self.bytes = std::vec::clear(self.bytes); }

    pub fn try_clone(&self) -> core::result::Result<String, Error> {
        let copy: std::vec::Vec<u8> = std::vec::try_clone(self.bytes);
        if (std::vec::len(copy) != std::vec::len(self.bytes)) { return core::result::Err(Error::AllocationFailed); }
        return core::result::Ok(String { bytes: copy });
    }

    pub fn equals(&self, other: String) -> bool {
        let length: i32 = std::vec::len(self.bytes);
        if (length != std::vec::len(other.bytes)) { return false; }
        let left: [u8] = std::vec::as_slice(self.bytes);
        let right: [u8] = std::vec::as_slice(other.bytes);
        let index: i32 = 0;
        while (index < length) {
            if (left[index] != right[index]) { return false; }
            index += 1;
        }
        return true;
    }

    // Total lexicographic order of UTF-8 bytes (also Unicode scalar order).
    pub fn compare(&self, other: String) -> i32 {
        let left: [u8] = std::vec::as_slice(self.bytes);
        let right: [u8] = std::vec::as_slice(other.bytes);
        let left_len: i32 = std::vec::len(self.bytes);
        let right_len: i32 = std::vec::len(other.bytes);
        let common: i32 = left_len;
        if (right_len < common) { common = right_len; }
        let index: i32 = 0;
        while (index < common) {
            if (left[index] < right[index]) { return -1; }
            if (left[index] > right[index]) { return 1; }
            index += 1;
        }
        if (left_len < right_len) { return -1; }
        if (left_len > right_len) { return 1; }
        return 0;
    }

    pub fn starts_with(&self, prefix: String) -> bool {
        let count: i32 = std::vec::len(prefix.bytes);
        if (count > std::vec::len(self.bytes)) { return false; }
        let bytes: [u8] = std::vec::as_slice(self.bytes);
        let pattern: [u8] = std::vec::as_slice(prefix.bytes);
        let index: i32 = 0;
        while (index < count) {
            if (bytes[index] != pattern[index]) { return false; }
            index += 1;
        }
        return true;
    }

    pub fn ends_with(&self, suffix: String) -> bool {
        let count: i32 = std::vec::len(suffix.bytes);
        let length: i32 = std::vec::len(self.bytes);
        if (count > length) { return false; }
        let bytes: [u8] = std::vec::as_slice(self.bytes);
        let pattern: [u8] = std::vec::as_slice(suffix.bytes);
        let index: i32 = 0;
        while (index < count) {
            if (bytes[length - count + index] != pattern[index]) { return false; }
            index += 1;
        }
        return true;
    }

    // An independent copy of the half-open byte range. Both endpoints must
    // be scalar boundaries. An empty range produces an unallocated String.
    pub fn try_substring(&self, start: i32, end: i32) -> core::result::Result<String, Error> {
        if (start < 0 || end < start || end > std::vec::len(self.bytes)) {
            return core::result::Err(Error::Bounds);
        }
        if (!self.is_char_boundary(start) || !self.is_char_boundary(end)) {
            return core::result::Err(Error::NotCharBoundary);
        }
        let count: i32 = end - start;
        let copy: std::vec::Vec<u8> = std::vec::try_with_capacity(count);
        if (std::vec::capacity(copy) < count) { return core::result::Err(Error::AllocationFailed); }
        let bytes: [u8] = std::vec::as_slice(self.bytes);
        let index: i32 = start;
        while (index < end) {
            copy = std::vec::try_push(copy, bytes[index]);
            index += 1;
        }
        return core::result::Ok(String { bytes: copy });
    }

    // Replace a half-open byte range. Nonempty replacement builds a fresh
    // buffer before releasing the old one, including when replacement aliases
    // this owner. Empty replacement removes in place without allocating.
    pub fn try_replace_range(&self, start: i32, end: i32, replacement: String) -> core::result::Result<i32, Error> {
        let length: i32 = std::vec::len(self.bytes);
        if (start < 0 || end < start || end > length) { return core::result::Err(Error::Bounds); }
        if (!self.is_char_boundary(start) || !self.is_char_boundary(end)) {
            return core::result::Err(Error::NotCharBoundary);
        }
        let retained: i32 = length - (end - start);
        let count: i32 = std::vec::len(replacement.bytes);
        if (count > 2147483647 - retained) { return core::result::Err(Error::CapacityOverflow); }
        let needed: i32 = retained + count;
        let old: [u8] = std::vec::as_slice(self.bytes);
        if (count == 0) {
            let index: i32 = end;
            while (index < length) {
                old[start + (index - end)] = old[index];
                index += 1;
            }
            self.bytes = std::vec::truncate(self.bytes, needed);
            return core::result::Ok(needed);
        }
        let capacity: i32 = std::vec::capacity(self.bytes);
        if (capacity < needed) { capacity = growth_capacity(capacity, needed); }
        let fresh: std::vec::Vec<u8> = std::vec::try_with_capacity(capacity);
        if (std::vec::capacity(fresh) < needed) { return core::result::Err(Error::AllocationFailed); }
        let index: i32 = 0;
        while (index < start) { fresh = std::vec::try_push(fresh, old[index]); index += 1; }
        let source: [u8] = std::vec::as_slice(replacement.bytes);
        fresh = std::vec::try_extend_from_slice(fresh, source, count);
        index = end;
        while (index < length) { fresh = std::vec::try_push(fresh, old[index]); index += 1; }
        std::vec::destroy(self.bytes);
        self.bytes = fresh;
        return core::result::Ok(needed);
    }

    pub fn try_insert(&self, byte_index: i32, value: String) -> core::result::Result<i32, Error> {
        return self.try_replace_range(byte_index, byte_index, value);
    }

    pub fn try_remove_range(&self, start: i32, end: i32) -> core::result::Result<i32, Error> {
        let empty: String = new();
        return self.try_replace_range(start, end, empty);
    }

    // Remove leading/trailing ASCII whitespace in place, retaining capacity.
    // Unicode whitespace outside ASCII is left untouched.
    pub fn trim_ascii(&self) -> i32 {
        let bytes: [u8] = std::vec::as_slice(self.bytes);
        let end: i32 = std::vec::len(self.bytes);
        let start: i32 = 0;
        while (start < end && core::byte::is_ascii_whitespace(bytes[start])) { start += 1; }
        while (end > start && core::byte::is_ascii_whitespace(bytes[end - 1])) { end -= 1; }
        let count: i32 = end - start;
        let index: i32 = 0;
        while (index < count) { bytes[index] = bytes[start + index]; index += 1; }
        self.bytes = std::vec::truncate(self.bytes, count);
        return count;
    }

    // First matching byte offset. The empty needle matches at zero.
    pub fn find(&self, needle: String) -> core::option::Option<i32> {
        let length: i32 = std::vec::len(self.bytes);
        let count: i32 = std::vec::len(needle.bytes);
        if (count > length) { return core::option::None(); }
        let bytes: [u8] = std::vec::as_slice(self.bytes);
        let pattern: [u8] = std::vec::as_slice(needle.bytes);
        let start: i32 = 0;
        while (start <= length - count) {
            let index: i32 = 0;
            while (index < count && bytes[start + index] == pattern[index]) { index += 1; }
            if (index == count) { return core::option::Some(start); }
            start += 1;
        }
        return core::option::None();
    }

    // Release this owner's storage and reset it to an empty String. Copies
    // of the previous owner and all borrowed views must no longer be used.
    pub fn destroy(&self) {
        std::vec::destroy(self.bytes);
        self.bytes = std::vec::new();
    }
}

pub impl core::cmp::Eq<String> for String {
    pub fn eq(left: String, right: String) -> bool { return left.equals(right); }
    pub fn ne(left: String, right: String) -> bool { return !left.equals(right); }
}

pub impl core::hash::Hash<String> for String {
    pub fn hash(value: String) -> u32 {
        return core::hash::fnv1a_bytes_or(value.as_bytes(), value.byte_len(), 0);
    }
}

pub impl core::cmp::Ord<String> for String {
    pub fn lt(left: String, right: String) -> bool { return left.compare(right) < 0; }
    pub fn le(left: String, right: String) -> bool { return left.compare(right) <= 0; }
    pub fn gt(left: String, right: String) -> bool { return left.compare(right) > 0; }
    pub fn ge(left: String, right: String) -> bool { return left.compare(right) >= 0; }
}
