// Generic open-addressed map. Values are copied, not deeply cloned/destroyed.
// Keep one owner of the backing allocation. See docs/stdlib-hash-collections.md.
module alloc::hash_map;
import core::function;
import alloc::allocator;
import core::cmp;
import core::iter;
import core::hash;
import core::mem;
import core::option;
import core::pair;
import core::result;

pub enum Error { InvalidCapacity, CapacityOverflow, AllocationFailed }
pub enum IntoIterError { Remaining(i32) }
// Sink insertion rejects existing keys instead of replacing their entries.
pub enum SinkError { Duplicate, Storage(Error) }
pub struct Entry<K, V> { key: K, value: V }
// One table allocation holds `buckets` cells, then `buckets` control bytes
// read as buckets / 8 group words. A control byte is empty (255), deleted
// (128) or, for a full cell, seven bits of the spread hash. The cell caches
// the full hash.
// A cell is a record, so its raw view runs down from cell zero's top word;
// `storage` is that word's address (null for no table). Both views start at
// fixed offsets from it, so building them needs no per-type stride probe.
struct Cell<K, V> { hash: u32, item: Entry<K, V> }
pub struct HashMap<K, V> { storage: ptr, buckets: i32, length: i32, occupied: i32 }
pub struct Iter<K, V> { storage: ptr, buckets: i32, position: i32 }
// One owner of table storage and every unconsumed entry's cleanup authority.
// Descriptor copies alias this owner and cannot fork that authority.
pub struct IntoIter<K, V> { storage: ptr, buckets: i32, length: i32, occupied: i32, position: i32 }
const MAX_BYTES: usize = 2147483647;
const MAX_BUCKETS: i32 = 1073741824;
// Control and probe constants are written as literals because this backend
// lowers each use of a named constant to a call:
//   255                  empty control byte; 128 is a deleted one
//   72340172838076673    0x0101010101010101, every byte 1
//   9259542123273814144  0x8080808080808080, every byte's high bit
//   18446744073709551615 every bit, for complements
//   11400714819323198485 2^64 / golden ratio (odd), spreads a key's u32 hash
//   283686952306183      0x0001020304050607: byte k holds 7 - k, so a word
//                        with only byte k set, times this, has k on top

pub fn new<K, V>() -> HashMap<K, V> {
    let storage: ptr = 0;
    return HashMap { storage: storage, buckets: 0, length: 0, occupied: 0 };
}
struct NaturalKey<K> {}
impl<K> NaturalKey<K> { fn borrow(&self) -> &NaturalKey<K> { return self; } }
pub impl<K> core::function::Mapper<core::pair::Pair<K,K>,bool> for NaturalKey<K>
    where K:core::cmp::Eq<K> {
    pub fn apply(&self, values:core::pair::Pair<K,K>) -> bool { return K::eq(values.first,values.second); }
}
fn equivalent<K,V,Q,P>(item:Entry<K,V>, query:Q, policy:&P) -> bool
    where P:core::function::Mapper<core::pair::Pair<K,Q>,bool> {
    let stored:K = item.key;
    let values:core::pair::Pair<K,Q> = core::pair::Pair { first:stored,second:query };
    return policy.apply(values);
}
// Group word g lies at storage + buckets - 8 * g, above cell zero.
fn control_words(storage: ptr, buckets: i32) -> [u64] {
    return slice_from_raw_parts(storage + (buckets as usize), buckets >> 3);
}
fn cells<K, V>(storage: ptr, buckets: i32) -> [Cell<K, V>] {
    return slice_from_raw_parts(storage, buckets);
}
fn table_bytes<K, V>(buckets: i32) -> usize {
    return (buckets as usize) * (core::mem::size_of<Cell<K, V>>() + 1);
}
// The allocation's base address: the bottom of the last cell.
fn table_base<K, V>(storage: ptr, buckets: i32) -> ptr {
    return storage + 8 - core::mem::size_of<Cell<K, V>>() * (buckets as usize);
}
fn release<K, V>(storage: ptr, buckets: i32) {
    if (buckets > 0) { alloc::allocator::dealloc(table_base<K, V>(storage, buckets), table_bytes<K, V>(buckets), 8); }
}
// Group probing. The top seven bits of the spread hash are the control tag;
// bits 32 and up choose the first group. Later groups follow triangular
// offsets, which visit every group of a power-of-two group count once.
fn spread(hash: u32) -> u64 { return (hash as u64) * 11400714819323198485; }
fn first_group(mixed: u64, groups: i32) -> i32 { return ((mixed >> 32) & ((groups - 1) as u64)) as i32; }
// Bytes equal to the tag, with the high bit of each matching byte set. A
// borrow can also mark a full byte just above a match; callers recheck.
fn match_tag(word: u64, pattern: u64) -> u64 {
    let x: u64 = word ^ pattern;
    return (x - 72340172838076673) & (x ^ 18446744073709551615) & 9259542123273814144;
}
fn match_empty(word: u64) -> u64 { return word & (word << 1) & 9259542123273814144; }
fn match_free(word: u64) -> u64 { return word & 9259542123273814144; }
fn match_full(word: u64) -> u64 { return (word & 9259542123273814144) ^ 9259542123273814144; }
// Index of the lowest marked byte of a nonzero match mask.
fn lowest_byte(mask: u64) -> i32 {
    let low: u64 = mask & ((mask - 1) ^ 18446744073709551615);
    return (((low >> 7) * 283686952306183) >> 56) as i32;
}
fn set_control(control: [u64], index: i32, value: u64) {
    let group: i32 = index >> 3;
    let shift: u32 = ((index & 7) * 8) as u32;
    control[group] = (control[group] & ((255 << shift) ^ 18446744073709551615)) | (value << shift);
}
// The first empty or deleted cell on the probe path. The load bound keeps
// an empty byte in the table, so the path always reaches one.
fn free_cell(control: [u64], groups: i32, mixed: u64) -> i32 {
    let mask: i32 = groups - 1;
    let group: i32 = first_group(mixed, groups);
    let stride: i32 = 0;
    while (stride < groups) {
        let free: u64 = match_free(control[group]);
        if (free != 0) { return (group << 3) + lowest_byte(free); }
        stride += 1;
        group = (group + stride) & mask;
    }
    return -1;
}
fn fill_empty(storage: ptr, buckets: i32) {
    let control: [u64] = control_words(storage, buckets);
    let count: i32 = buckets >> 3;
    let index: i32 = 0;
    while (index < count) { control[index] = 18446744073709551615; index += 1; }
}
// Copy every full cell of one table into an empty one with room for them.
fn place_all<K, V>(source_storage: ptr, source_buckets: i32, storage: ptr, buckets: i32) {
    let source_control: [u64] = control_words(source_storage, source_buckets);
    let source: [Cell<K, V>] = cells<K, V>(source_storage, source_buckets);
    let control: [u64] = control_words(storage, buckets);
    let target: [Cell<K, V>] = cells<K, V>(storage, buckets);
    let groups: i32 = buckets >> 3;
    let group: i32 = 0;
    while (group < (source_buckets >> 3)) {
        let full: u64 = match_full(source_control[group]);
        while (full != 0) {
            let from: i32 = (group << 3) + lowest_byte(full);
            let cell: Cell<K, V> = source[from];
            let mixed: u64 = spread(cell.hash);
            let index: i32 = free_cell(control, groups, mixed);
            assert(index >= 0);
            set_control(control, index, mixed >> 57);
            target[index] = cell;
            full = full & (full - 1);
        }
        group += 1;
    }
}
fn required_buckets<K, V>(entries: i32) -> core::result::Result<i32, Error> {
    if (entries < 0) { return core::result::Err(Error::InvalidCapacity); }
    if (entries == 0) { return core::result::Ok(0); }
    if (entries > MAX_BUCKETS / 2) { return core::result::Err(Error::CapacityOverflow); }
    let target: i32 = 8;
    while (target / 2 < entries) { target *= 2; }
    let size: usize = core::mem::size_of<Cell<K, V>>() + 1;
    if ((target as usize) > MAX_BYTES / size) { return core::result::Err(Error::CapacityOverflow); }
    return core::result::Ok(target);
}
pub impl<K, V> HashMap<K, V> {
    pub fn borrow(&self) -> &HashMap<K, V> { return self; }
    pub fn len(&self) -> i32 { return self.length; }
    pub fn is_empty(&self) -> bool { return self.length == 0; }
    // Number of live entries permitted before growth, excluding tombstones.
    pub fn capacity(&self) -> i32 { return self.buckets / 2; }
    // Natural-key lookup: one group word per probe step, then the cached hash
    // and key equality only for cells whose tag matches.
    fn find(&self, key: K, hash: u32) -> i32
        where K: core::hash::Hash<K>, K: core::cmp::Eq<K> {
        if (self.length == 0) { return -1; }
        let storage: ptr = self.storage;
        let buckets: i32 = self.buckets;
        let control: [u64] = slice_from_raw_parts(storage + (buckets as usize), buckets >> 3);
        let slots: [Cell<K, V>] = slice_from_raw_parts(storage, buckets);
        let mask: i32 = (buckets >> 3) - 1;
        let mixed: u64 = (hash as u64) * 11400714819323198485;
        let pattern: u64 = (mixed >> 57) * 72340172838076673;
        let group: i32 = ((mixed >> 32) & (mask as u64)) as i32;
        let stride: i32 = 0;
        while (stride <= mask) {
            let word: u64 = control[group];
            let x: u64 = word ^ pattern;
            let hits: u64 = (x - 72340172838076673) & (x ^ 18446744073709551615) & 9259542123273814144;
            while (hits != 0) {
                let low: u64 = hits & ((hits - 1) ^ 18446744073709551615);
                let index: i32 = (group << 3) + ((((low >> 7) * 283686952306183) >> 56) as i32);
                let cell: Cell<K, V> = slots[index];
                if (cell.hash == hash && K::eq(cell.item.key, key)) { return index; }
                hits = hits ^ low;
            }
            if ((word & (word << 1) & 9259542123273814144) != 0) { return -1; }
            stride += 1;
            group = (group + stride) & mask;
        }
        return -1;
    }
    // Insertion probe: the matching cell's index, or -2 - c where c is the
    // first empty or deleted cell on the key's path (-1 for no table).
    fn find_slot(&self, key: K, hash: u32) -> i32
        where K: core::hash::Hash<K>, K: core::cmp::Eq<K> {
        if (self.buckets == 0) { return -1; }
        let storage: ptr = self.storage;
        let buckets: i32 = self.buckets;
        let control: [u64] = slice_from_raw_parts(storage + (buckets as usize), buckets >> 3);
        let slots: [Cell<K, V>] = slice_from_raw_parts(storage, buckets);
        let mask: i32 = (buckets >> 3) - 1;
        let mixed: u64 = (hash as u64) * 11400714819323198485;
        let pattern: u64 = (mixed >> 57) * 72340172838076673;
        let group: i32 = ((mixed >> 32) & (mask as u64)) as i32;
        let free: i32 = -1;
        let stride: i32 = 0;
        while (stride <= mask) {
            let word: u64 = control[group];
            let x: u64 = word ^ pattern;
            let hits: u64 = (x - 72340172838076673) & (x ^ 18446744073709551615) & 9259542123273814144;
            while (hits != 0) {
                let low: u64 = hits & ((hits - 1) ^ 18446744073709551615);
                let index: i32 = (group << 3) + ((((low >> 7) * 283686952306183) >> 56) as i32);
                let cell: Cell<K, V> = slots[index];
                if (cell.hash == hash && K::eq(cell.item.key, key)) { return index; }
                hits = hits ^ low;
            }
            let open: u64 = word & 9259542123273814144;
            if (free < 0 && open != 0) {
                let first: u64 = open & ((open - 1) ^ 18446744073709551615);
                free = (group << 3) + ((((first >> 7) * 283686952306183) >> 56) as i32);
            }
            if ((word & (word << 1) & 9259542123273814144) != 0) { return -2 - free; }
            stride += 1;
            group = (group + stride) & mask;
        }
        return -2 - free;
    }
    fn find_by<Q,P>(&self, query:Q, hash:u32, policy:&P) -> i32
        where P:core::function::Mapper<core::pair::Pair<K,Q>,bool> {
        if (self.length == 0) { return -1; }
        let control: [u64] = slice_from_raw_parts(self.storage + (self.buckets as usize), self.buckets >> 3);
        let slots: [Cell<K, V>] = slice_from_raw_parts(self.storage, self.buckets);
        let groups: i32 = self.buckets >> 3;
        let mask: i32 = groups - 1;
        let mixed: u64 = spread(hash);
        let pattern: u64 = (mixed >> 57) * 72340172838076673;
        let group: i32 = first_group(mixed, groups);
        let stride: i32 = 0;
        while (stride < groups) {
            let word: u64 = control[group];
            let hits: u64 = match_tag(word, pattern);
            while (hits != 0) {
                let index: i32 = (group << 3) + lowest_byte(hits);
                let cell: Cell<K, V> = slots[index];
                if (cell.hash == hash && equivalent<K,V,Q,P>(cell.item,query,policy)) { return index; }
                hits = hits & (hits - 1);
            }
            if (match_empty(word) != 0) { return -1; }
            stride += 1;
            group = (group + stride) & mask;
        }
        return -1;
    }
    pub fn contains_key(&self, key: K) -> bool where K: core::hash::Hash<K>, K: core::cmp::Eq<K> {
        return self.find(key, K::hash(key)) >= 0;
    }
    // Returned copies borrow any nested resources owned by stored values.
    pub fn get_entry(&self, key: K) -> core::option::Option<Entry<K, V>>
        where K: core::hash::Hash<K>, K: core::cmp::Eq<K> {
        return self.entry_at(self.find(key,K::hash(key)));
    }
    fn entry_at(&self, index:i32) -> core::option::Option<Entry<K,V>> {
        if (index < 0) { return core::option::None(); }
        let slots: [Cell<K, V>] = slice_from_raw_parts(self.storage, self.buckets);
        return core::option::Some(slots[index].item);
    }
    pub fn get(&self, key: K) -> core::option::Option<V>
        where K: core::hash::Hash<K>, K: core::cmp::Eq<K> {
        let index: i32 = self.find(key, K::hash(key));
        if (index < 0) { return core::option::None(); }
        let slots: [Cell<K, V>] = slice_from_raw_parts(self.storage, self.buckets);
        return core::option::Some(slots[index].item.value);
    }
    // Lend the stored value exclusively for one callback; restore its returned
    // descriptor even when R reports failure. End old borrows/cursors first.
    // The callback must not access this map or change key identity through an
    // alias. No implicit destruction, rollback or map allocation occurs.
    pub fn update_value<M, R>(&self, key: K, update: &M) -> core::option::Option<R>
        where K: core::hash::Hash<K>, K: core::cmp::Eq<K>, M: core::function::Mapper<V, core::pair::Pair<V, R>> {
        let hash: u32 = K::hash(key);
        let index: i32 = self.find(key, hash);
        return self.update_at<M,R>(index,update);
    }
    fn update_at<M,R>(&self, index:i32, update:&M) -> core::option::Option<R>
        where M:core::function::Mapper<V,core::pair::Pair<V,R>> {
        if (index < 0) { return core::option::None(); }
        let slots: [Cell<K, V>] = slice_from_raw_parts(self.storage, self.buckets);
        let cell: Cell<K, V> = slots[index];
        let changed: core::pair::Pair<V, R> = update.apply(cell.item.value);
        // Preserve the cached hash and representative without rehashing.
        let item: Entry<K, V> = Entry { key: cell.item.key, value: changed.first };
        slots[index] = Cell { hash: cell.hash, item: item };
        return core::option::Some(changed.second);
    }
    // A query denotes one key identity and hashes exactly like matching keys.
    // Policies observe stored/query descriptors only for the call: no mutation,
    // retirement, reentry or descriptor escape. Query backing stays live even
    // during update. Each operation hashes Q once, including empty maps.
    pub fn contains_key_by<Q,P>(&self, query:Q, policy:&P) -> bool
        where Q:core::hash::Hash<Q>, P:core::function::Mapper<core::pair::Pair<K,Q>,bool> {
        return self.find_by<Q,P>(query,Q::hash(query),policy) >= 0;
    }
    pub fn get_entry_by<Q,P>(&self, query:Q, policy:&P) -> core::option::Option<Entry<K,V>>
        where Q:core::hash::Hash<Q>, P:core::function::Mapper<core::pair::Pair<K,Q>,bool> {
        return self.entry_at(self.find_by<Q,P>(query,Q::hash(query),policy));
    }
    pub fn get_by<Q,P>(&self, query:Q, policy:&P) -> core::option::Option<V>
        where Q:core::hash::Hash<Q>, P:core::function::Mapper<core::pair::Pair<K,Q>,bool> {
        let found:core::option::Option<Entry<K,V>> = self.get_entry_by<Q,P>(query,policy);
        return match (found) { Some(item) -> core::option::Some(item.value), None -> core::option::None() };
    }
    pub fn update_value_by<Q,P,M,R>(&self, query:Q, policy:&P, update:&M) -> core::option::Option<R>
        where Q:core::hash::Hash<Q>, P:core::function::Mapper<core::pair::Pair<K,Q>,bool>,
              M:core::function::Mapper<V,core::pair::Pair<V,R>> {
        let index:i32 = self.find_by<Q,P>(query,Q::hash(query),policy);
        return self.update_at<M,R>(index,update);
    }
    pub fn remove_by<Q,P>(&self, query:Q, policy:&P) -> core::option::Option<Entry<K,V>>
        where Q:core::hash::Hash<Q>, P:core::function::Mapper<core::pair::Pair<K,Q>,bool> {
        return self.remove_at(self.find_by<Q,P>(query,Q::hash(query),policy));
    }
    // Construct a replacement in full before changing or freeing this owner.
    fn rehash(&self, buckets: i32) -> core::result::Result<i32, Error> {
        if (buckets == 0) { self.destroy(); return core::result::Ok(0); }
        let base: ptr = alloc::allocator::alloc(table_bytes<K, V>(buckets), 8);
        if (base == 0) { return core::result::Err(Error::AllocationFailed); }
        let storage: ptr = base + core::mem::size_of<Cell<K, V>>() * (buckets as usize) - 8;
        fill_empty(storage, buckets);
        place_all<K, V>(self.storage, self.buckets, storage, buckets);
        release<K, V>(self.storage, self.buckets);
        self.storage = storage;
        self.buckets = buckets;
        self.occupied = self.length;
        return core::result::Ok(self.capacity());
    }
    // Reserve for this many additional distinct keys, reclaiming tombstones.
    // Failure preserves every entry, capacity and the original allocation.
    pub fn try_reserve(&self, additional: i32) -> core::result::Result<i32, Error> {
        if (additional < 0) { return core::result::Err(Error::InvalidCapacity); }
        if (additional == 0) { return core::result::Ok(self.capacity()); }
        if (additional > 2147483647 - self.length) { return core::result::Err(Error::CapacityOverflow); }
        let needed: i32 = self.length + additional;
        let checked: core::result::Result<i32, Error> = required_buckets<K, V>(needed);
        if (core::result::is_err(checked)) { return core::result::Err(core::result::unwrap_err(checked)); }
        let buckets: i32 = core::result::unwrap(checked);
        if (buckets <= self.buckets) {
            if (additional <= self.capacity() - self.occupied) { return core::result::Ok(self.capacity()); }
            buckets = self.buckets;
        }
        return self.rehash(buckets);
    }
    // On success the map stores the new key/value. A displaced entry is
    // returned intact, including its old key. On Err the caller retains inputs.
    pub fn try_insert(&self, key: K, value: V) -> core::result::Result<core::option::Option<Entry<K, V>>, Error>
        where K: core::hash::Hash<K>, K: core::cmp::Eq<K> {
        let hash: u32 = K::hash(key);
        let slot: i32 = self.find_slot(key, hash);
        let item: Entry<K, V> = Entry { key: key, value: value };
        if (slot >= 0) {
            let slots: [Cell<K, V>] = slice_from_raw_parts(self.storage, self.buckets);
            let previous: Entry<K, V> = slots[slot].item;
            slots[slot] = Cell { hash: hash, item: item };
            return core::result::Ok(core::option::Some(previous));
        }
        let index: i32 = -2 - slot;
        let mixed: u64 = (hash as u64) * 11400714819323198485;
        if (self.occupied >= self.buckets / 2) {
            let reserved: core::result::Result<i32, Error> = self.try_reserve(1);
            if (core::result::is_err(reserved)) { return core::result::Err(core::result::unwrap_err(reserved)); }
            let fresh: [u64] = slice_from_raw_parts(self.storage + (self.buckets as usize), self.buckets >> 3);
            index = free_cell(fresh, self.buckets >> 3, mixed);
        }
        // The load invariant guarantees a free cell after successful reserve.
        assert(index >= 0);
        let control: [u64] = slice_from_raw_parts(self.storage + (self.buckets as usize), self.buckets >> 3);
        let group: i32 = index >> 3;
        let shift: u32 = ((index & 7) * 8) as u32;
        let word: u64 = control[group];
        if (((word >> shift) & 255) == 255) { self.occupied += 1; }
        control[group] = (word & ((255 << shift) ^ 18446744073709551615)) | ((mixed >> 57) << shift);
        let slots: [Cell<K, V>] = slice_from_raw_parts(self.storage, self.buckets);
        slots[index] = Cell { hash: hash, item: item };
        self.length += 1;
        return core::result::Ok(core::option::None());
    }
    pub fn remove(&self, key: K) -> core::option::Option<Entry<K, V>>
        where K: core::hash::Hash<K>, K: core::cmp::Eq<K> {
        return self.remove_at(self.find(key,K::hash(key)));
    }
    // A group that already holds an empty byte ends every probe that reaches
    // it, so no probe path runs through it and the cell can become empty.
    // Otherwise it becomes a tombstone that keeps later paths intact.
    fn remove_at(&self, index:i32) -> core::option::Option<Entry<K,V>> {
        if (index < 0) { return core::option::None(); }
        let control: [u64] = slice_from_raw_parts(self.storage + (self.buckets as usize), self.buckets >> 3);
        let slots: [Cell<K, V>] = slice_from_raw_parts(self.storage, self.buckets);
        let removed: Entry<K, V> = slots[index].item;
        if (match_empty(control[index >> 3]) != 0) {
            set_control(control, index, 255); self.occupied -= 1;
        } else {
            set_control(control, index, 128);
        }
        self.length -= 1;
        // Reset leftover tombstones when the map empties; skip the O(buckets)
        // pass when none are left, so emptying and refilling stays O(1).
        if (self.length == 0 && self.occupied > 0) { self.clear(); }
        return core::option::Some(removed);
    }
    pub fn iter(&self) -> Iter<K, V> {
        return Iter { storage: self.storage, buckets: self.buckets, position: 0 };
    }
    // Transfer the table and entry cleanup authority; reset the actual source.
    // End borrowed entry/cursor use first. Old shallow aliases stay inactive.
    pub fn take_iter(&self) -> IntoIter<K, V> {
        let cursor: IntoIter<K, V> = IntoIter { storage: self.storage, buckets: self.buckets, length: self.length, occupied: self.occupied, position: 0 };
        self.storage = 0; self.buckets = 0; self.length = 0; self.occupied = 0;
        return cursor;
    }
    // Clears entries without destroying resources nested in keys/values.
    pub fn clear(&self) {
        fill_empty(self.storage, self.buckets);
        self.length = 0; self.occupied = 0;
    }
    pub fn try_shrink_to_fit(&self) -> core::result::Result<i32, Error> {
        let checked: core::result::Result<i32, Error> = required_buckets<K, V>(self.length);
        if (core::result::is_err(checked)) { return core::result::Err(core::result::unwrap_err(checked)); }
        let buckets: i32 = core::result::unwrap(checked);
        if (buckets == self.buckets && self.occupied == self.length) { return core::result::Ok(self.capacity()); }
        return self.rehash(buckets);
    }
    // Independent table storage; keys and values are shallow copies.
    pub fn try_clone(&self) -> core::result::Result<HashMap<K, V>, Error> {
        let copy: HashMap<K, V> = new();
        let reserved: core::result::Result<i32, Error> = copy.try_reserve(self.length);
        if (core::result::is_err(reserved)) { return core::result::Err(core::result::unwrap_err(reserved)); }
        place_all<K, V>(self.storage, self.buckets, copy.storage, copy.buckets);
        copy.length = self.length; copy.occupied = self.length;
        return core::result::Ok(copy);
    }
    // Free table storage only, then reset the handle for reuse.
    pub fn destroy(&self) {
        release<K, V>(self.storage, self.buckets);
        self.storage = 0; self.buckets = 0; self.length = 0; self.occupied = 0;
    }
}
// Reject before allocation or replacement. Hash/equality must remain lawful
// and stable, without reentrant mutation of this map during either lookup.
pub impl<K, V> core::iter::TrySink<Entry<K, V>, SinkError> for HashMap<K, V>
    where K: core::hash::Hash<K>, K: core::cmp::Eq<K> {
    pub fn try_accept(&self, item: Entry<K, V>) -> core::option::Option<SinkError> {
        if (self.contains_key(item.key)) { return core::option::Some(SinkError::Duplicate()); }
        let inserted: core::result::Result<core::option::Option<Entry<K, V>>, Error> = self.try_insert(item.key, item.value);
        if (core::result::is_err(inserted)) { return core::option::Some(SinkError::Storage(core::result::unwrap_err(inserted))); }
        let previous: core::option::Option<Entry<K, V>> = core::result::unwrap(inserted);
        // Stable key behavior keeps the prechecked key absent until insertion.
        assert(core::option::is_none(previous));
        return core::option::None();
    }
}

// Unlike TrySink duplicate rejection, store both incoming key/value and return
// the complete old entry. Canonical insertion retains inputs on storage error.
pub impl<K,V> core::iter::TryReplaceSink<Entry<K,V>,Error> for HashMap<K,V>
    where K: core::hash::Hash<K>, K: core::cmp::Eq<K> {
    pub fn try_replace_item(&self, item: Entry<K,V>) -> core::result::Result<core::option::Option<Entry<K,V>>,Error> {
        return self.try_insert(item.key,item.value);
    }
}

// The next full cell at or after `position`, or `buckets` when none remains.
fn next_full(control: [u64], buckets: i32, position: i32) -> i32 {
    let at: i32 = position;
    while (at < buckets) {
        let group: i32 = at >> 3;
        let full: u64 = match_full(control[group]) & (18446744073709551615 << (((at & 7) * 8) as u32));
        if (full != 0) { return (group << 3) + lowest_byte(full); }
        at = (group + 1) << 3;
    }
    return buckets;
}

pub impl<K, V> Iter<K, V> {
    pub fn borrow(&self) -> &Iter<K, V> { return self; }
}

pub impl<K, V> core::iter::Iterator<Entry<K, V>> for Iter<K, V> {
    // Invalidated by any map mutation or destruction. Order is unspecified.
    pub fn next(&self) -> core::option::Option<Entry<K, V>> {
        let index: i32 = next_full(control_words(self.storage, self.buckets), self.buckets, self.position);
        if (index >= self.buckets) { self.position = self.buckets; return core::option::None(); }
        self.position = index + 1;
        let slots: [Cell<K, V>] = slice_from_raw_parts(self.storage, self.buckets);
        return core::option::Some(slots[index].item);
    }
}

pub impl<K, V> IntoIter<K, V> {
    pub fn borrow(&self) -> &IntoIter<K, V> { return self; }
    pub fn remaining(&self) -> i32 { return self.length; }
    pub fn capacity(&self) -> i32 { return self.buckets / 2; }
    pub fn is_empty(&self) -> bool { return self.length == 0; }
    fn disarm(&self) {
        self.storage = 0; self.buckets = 0; self.length = 0; self.occupied = 0; self.position = 0;
    }
    // Rejection preserves the cursor. Exhaustion alone never frees its table.
    pub fn try_finish(&self) -> core::option::Option<IntoIterError> {
        if (self.length > 0) { return core::option::Some(IntoIterError::Remaining(self.length)); }
        release<K, V>(self.storage, self.buckets);
        self.disarm(); return core::option::None();
    }
    // Transfer the same table in O(1), retaining its spare capacity, original
    // tombstones and newly consumed deleted cells. No key comparison/rehash.
    pub fn take_remaining(&self) -> HashMap<K, V> {
        let owner: HashMap<K, V> = HashMap { storage: self.storage, buckets: self.buckets, length: self.length, occupied: self.occupied };
        self.disarm(); return owner;
    }
}

pub impl<K, V> core::iter::ExactSizeIterator<Entry<K, V>> for IntoIter<K, V> {
    pub fn remaining_count(&self) -> u64 { return self.remaining() as u64; }
}

pub impl<K, V> core::iter::Iterator<Entry<K, V>> for IntoIter<K, V> {
    // Each successful pull removes one initialized entry before transferring
    // it. A tombstone preserves probe paths if the remainder is recovered.
    pub fn next(&self) -> core::option::Option<Entry<K, V>> {
        if (self.length == 0) { return core::option::None(); }
        let control: [u64] = slice_from_raw_parts(self.storage + (self.buckets as usize), self.buckets >> 3);
        let index: i32 = next_full(control, self.buckets, self.position);
        assert(index < self.buckets);
        self.position = index + 1;
        let slots: [Cell<K, V>] = slice_from_raw_parts(self.storage, self.buckets);
        set_control(control, index, 128); self.length -= 1;
        return core::option::Some(slots[index].item);
    }
}

// Internal set-storage boundary. One typed facade owns each state; temporary
// typed map/cursor views never escape. Width checks are layout guards, not
// permission to reinterpret a different key schema. The map above remains the
// only storage, allocation, hashing/probing or balancing implementation.
struct KeyUnit {}
pub struct KeyStorage { storage: ptr, buckets: i32, length: i32, occupied: i32, key_bytes: usize }
pub struct KeyCursor { storage: ptr, buckets: i32, position: i32, key_bytes: usize }
pub struct KeyIntoIter { storage: ptr, buckets: i32, length: i32, occupied: i32, position: i32, key_bytes: usize }
pub impl KeyStorage { pub fn borrow(&self) -> &KeyStorage { return self; } }
pub impl KeyCursor { pub fn borrow(&self) -> &KeyCursor { return self; } }
pub impl KeyIntoIter { pub fn borrow(&self) -> &KeyIntoIter { return self; } }
pub fn key_storage<T>() -> KeyStorage {
    let storage: ptr = 0;
    return KeyStorage { storage: storage, buckets: 0, length: 0, occupied: 0, key_bytes: core::mem::size_of<T>() };
}
fn key_view<T>(owner: &KeyStorage) -> HashMap<T, KeyUnit> {
    assert(owner.key_bytes == core::mem::size_of<T>());
    return HashMap { storage: owner.storage, buckets: owner.buckets, length: owner.length, occupied: owner.occupied };
}
fn key_update<T>(owner: &KeyStorage, map: HashMap<T, KeyUnit>) {
    owner.storage = map.storage; owner.buckets = map.buckets; owner.length = map.length; owner.occupied = map.occupied;
}
pub fn key_replace<T>(owner: &KeyStorage, key: T) -> core::result::Result<core::option::Option<T>, Error> where T: core::hash::Hash<T>, T: core::cmp::Eq<T> {
    let map: HashMap<T, KeyUnit> = key_view<T>(owner); let unit: KeyUnit = KeyUnit {};
    let result: core::result::Result<core::option::Option<Entry<T, KeyUnit>>, Error> = map.try_insert(key, unit);
    key_update<T>(owner, map);
    if (core::result::is_err(result)) { return core::result::Err(core::result::unwrap_err(result)); }
    let old: core::option::Option<Entry<T, KeyUnit>> = core::result::unwrap(result);
    if (core::option::is_none(old)) { return core::result::Ok(core::option::None()); }
    let entry: Entry<T, KeyUnit> = core::option::unwrap(old); return core::result::Ok(core::option::Some(entry.key));
}
pub fn key_contains<T>(owner: &KeyStorage, key: T) -> bool where T: core::hash::Hash<T>, T: core::cmp::Eq<T> {
    let map: HashMap<T, KeyUnit> = key_view<T>(owner); return map.contains_key(key);
}
pub fn key_iter<T>(owner: &KeyStorage) -> KeyCursor {
    let map: HashMap<T, KeyUnit> = key_view<T>(owner); let cursor: Iter<T, KeyUnit> = map.iter();
    return KeyCursor { storage: cursor.storage, buckets: cursor.buckets, position: cursor.position, key_bytes: owner.key_bytes };
}
pub fn key_next<T>(cursor: &KeyCursor) -> core::option::Option<T> {
    assert(cursor.key_bytes == core::mem::size_of<T>());
    let view: Iter<T, KeyUnit> = Iter { storage: cursor.storage, buckets: cursor.buckets, position: cursor.position };
    let result: core::option::Option<Entry<T, KeyUnit>> = view.next();
    cursor.storage = view.storage; cursor.buckets = view.buckets; cursor.position = view.position;
    if (core::option::is_none(result)) { return core::option::None(); }
    let entry: Entry<T, KeyUnit> = core::option::unwrap(result); return core::option::Some(entry.key);
}
fn key_into_view<T>(cursor: &KeyIntoIter) -> IntoIter<T, KeyUnit> {
    assert(cursor.key_bytes == core::mem::size_of<T>());
    return IntoIter { storage: cursor.storage, buckets: cursor.buckets, length: cursor.length, occupied: cursor.occupied, position: cursor.position };
}
fn key_into_update<T>(cursor: &KeyIntoIter, view: IntoIter<T, KeyUnit>) {
    cursor.storage = view.storage; cursor.buckets = view.buckets; cursor.length = view.length;
    cursor.occupied = view.occupied; cursor.position = view.position;
}
pub fn key_take_iter<T>(owner: &KeyStorage) -> KeyIntoIter {
    let map: HashMap<T, KeyUnit> = key_view<T>(owner);
    let cursor: IntoIter<T, KeyUnit> = map.take_iter(); key_update<T>(owner,map);
    return KeyIntoIter { storage: cursor.storage, buckets: cursor.buckets, length: cursor.length, occupied: cursor.occupied, position: cursor.position, key_bytes: owner.key_bytes };
}
pub fn key_into_next<T>(cursor: &KeyIntoIter) -> core::option::Option<T> {
    let view: IntoIter<T, KeyUnit> = key_into_view<T>(cursor);
    let next: core::option::Option<Entry<T, KeyUnit>> = view.next(); key_into_update<T>(cursor,view);
    if (next.is_none()) { return core::option::None(); }
    return core::option::Some(next.unwrap().key);
}
pub fn key_into_finish<T>(cursor: &KeyIntoIter) -> core::option::Option<IntoIterError> {
    let view: IntoIter<T, KeyUnit> = key_into_view<T>(cursor);
    let failure: core::option::Option<IntoIterError> = view.try_finish(); key_into_update<T>(cursor,view); return failure;
}
pub fn key_take_remaining<T>(cursor: &KeyIntoIter) -> KeyStorage {
    let view: IntoIter<T, KeyUnit> = key_into_view<T>(cursor);
    let map: HashMap<T, KeyUnit> = view.take_remaining(); key_into_update<T>(cursor,view);
    let owner: KeyStorage = key_storage<T>(); key_update<T>(owner.borrow(),map); return owner;
}
pub fn key_destroy<T>(owner: &KeyStorage) {
    let map: HashMap<T, KeyUnit> = key_view<T>(owner); map.destroy(); key_update<T>(owner, map);
}

pub fn key_get<T>(owner: &KeyStorage, key: T) -> core::option::Option<T> where T: core::hash::Hash<T>, T: core::cmp::Eq<T> {
    let map: HashMap<T, KeyUnit> = key_view<T>(owner);
    let result: core::option::Option<Entry<T, KeyUnit>> = map.get_entry(key);
    if (core::option::is_none(result)) { return core::option::None(); }
    let entry: Entry<T, KeyUnit> = core::option::unwrap(result); return core::option::Some(entry.key);
}
pub fn key_remove<T>(owner: &KeyStorage, key: T) -> core::option::Option<T> where T: core::hash::Hash<T>, T: core::cmp::Eq<T> {
    let map: HashMap<T, KeyUnit> = key_view<T>(owner);
    let result: core::option::Option<Entry<T, KeyUnit>> = map.remove(key);
    key_update<T>(owner, map);
    if (core::option::is_none(result)) { return core::option::None(); }
    let entry: Entry<T, KeyUnit> = core::option::unwrap(result); return core::option::Some(entry.key);
}
pub fn key_contains_by<T,Q,P>(owner:&KeyStorage, query:Q, policy:&P) -> bool
    where Q:core::hash::Hash<Q>, P:core::function::Mapper<core::pair::Pair<T,Q>,bool> {
    let map:HashMap<T,KeyUnit> = key_view<T>(owner); return map.contains_key_by<Q,P>(query,policy);
}
pub fn key_get_by<T,Q,P>(owner:&KeyStorage, query:Q, policy:&P) -> core::option::Option<T>
    where Q:core::hash::Hash<Q>, P:core::function::Mapper<core::pair::Pair<T,Q>,bool> {
    let map:HashMap<T,KeyUnit> = key_view<T>(owner);
    let found:core::option::Option<Entry<T,KeyUnit>> = map.get_entry_by<Q,P>(query,policy);
    if (core::option::is_none(found)) { return core::option::None(); }
    let item:Entry<T,KeyUnit> = core::option::unwrap(found); return core::option::Some(item.key);
}
pub fn key_remove_by<T,Q,P>(owner:&KeyStorage, query:Q, policy:&P) -> core::option::Option<T>
    where Q:core::hash::Hash<Q>, P:core::function::Mapper<core::pair::Pair<T,Q>,bool> {
    let map:HashMap<T,KeyUnit> = key_view<T>(owner);
    let found:core::option::Option<Entry<T,KeyUnit>> = map.remove_by<Q,P>(query,policy);
    key_update<T>(owner,map);
    if (core::option::is_none(found)) { return core::option::None(); }
    let item:Entry<T,KeyUnit> = core::option::unwrap(found); return core::option::Some(item.key);
}
pub fn key_reserve<T>(owner: &KeyStorage, additional: i32) -> core::result::Result<i32, Error> {
    let map: HashMap<T, KeyUnit> = key_view<T>(owner);
    let result: core::result::Result<i32, Error> = map.try_reserve(additional);
    key_update<T>(owner, map); return result;
}
pub fn key_shrink<T>(owner: &KeyStorage) -> core::result::Result<i32, Error> {
    let map: HashMap<T, KeyUnit> = key_view<T>(owner);
    let result: core::result::Result<i32, Error> = map.try_shrink_to_fit();
    key_update<T>(owner, map); return result;
}
pub fn key_clone<T>(owner: &KeyStorage) -> core::result::Result<KeyStorage, Error> {
    let map: HashMap<T, KeyUnit> = key_view<T>(owner);
    let result: core::result::Result<HashMap<T, KeyUnit>, Error> = map.try_clone();
    if (core::result::is_err(result)) { return core::result::Err(core::result::unwrap_err(result)); }
    let copy: HashMap<T, KeyUnit> = core::result::unwrap(result);
    let state: KeyStorage = key_storage<T>(); key_update<T>(state.borrow(), copy); return core::result::Ok(state);
}
pub fn key_clear<T>(owner: &KeyStorage) {
    let map: HashMap<T, KeyUnit> = key_view<T>(owner); map.clear(); key_update<T>(owner, map);
}
