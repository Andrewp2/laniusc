// Fixed-capacity buffered streams with one owned byte allocation.
// I/O state and transitions belong to the canonical core::buffered engine.
// The endpoint stays borrowed; all cleanup and handoff are explicit.
module alloc::buffered;
import alloc::vec;
import core::buffered;
import core::io;
import core::result;
import core::slice;

pub struct Parts<I> {
    inner: &I,
    buffer: alloc::vec::Vec<u8>,
    start: i32,
    length: i32,
    faulted: bool
}
pub struct Reader<R> { buffer:alloc::vec::Vec<u8>,engine:core::buffered::Reader<R> }
pub struct Writer<W> { buffer:alloc::vec::Vec<u8>,engine:core::buffered::Writer<W> }

fn storage(capacity: i32) -> core::result::Result<alloc::vec::Vec<u8>, core::io::Error> {
    if (capacity <= 0) { return core::result::Err(core::io::Error::InvalidInput); }
    let made: core::result::Result<alloc::vec::Vec<u8>, alloc::vec::Error> = alloc::vec::with_capacity(capacity);
    if (core::result::is_err(made)) { return core::result::Err(core::io::Error::AllocationFailed); }
    let bytes: alloc::vec::Vec<u8> = core::result::unwrap(made);
    // The complete byte capacity is initialized once. This cannot allocate
    // again after the successful reserve, and later I/O never changes len.
    let initialized: core::result::Result<i32, alloc::vec::Error> = bytes.try_resize(capacity, 0);
    if (core::result::is_err(initialized)) {
        bytes.destroy();
        return core::result::Err(core::io::Error::AllocationFailed);
    }
    return core::result::Ok(bytes);
}

pub fn reader<R>(inner:&R, capacity:i32) -> core::result::Result<Reader<R>,core::io::Error>
    where R:core::io::Read {
    let made:core::result::Result<alloc::vec::Vec<u8>,core::io::Error> = storage(capacity);
    if (made.is_err()) { return core::result::Err(made.unwrap_err()); }
    let buffer:alloc::vec::Vec<u8> = made.unwrap();
    let admitted:core::result::Result<core::buffered::Reader<R>,core::io::Error> = core::buffered::reader<R>(inner,buffer.as_view());
    if (admitted.is_err()) { buffer.destroy(); return core::result::Err(admitted.unwrap_err()); }
    return core::result::Ok(Reader { buffer:buffer,engine:admitted.unwrap() });
}
pub fn writer<W>(inner:&W, capacity:i32) -> core::result::Result<Writer<W>,core::io::Error>
    where W:core::io::Write {
    let made:core::result::Result<alloc::vec::Vec<u8>,core::io::Error> = storage(capacity);
    if (made.is_err()) { return core::result::Err(made.unwrap_err()); }
    let buffer:alloc::vec::Vec<u8> = made.unwrap();
    let admitted:core::result::Result<core::buffered::Writer<W>,core::io::Error> = core::buffered::writer<W>(inner,buffer.as_view());
    if (admitted.is_err()) { buffer.destroy(); return core::result::Err(admitted.unwrap_err()); }
    return core::result::Ok(Writer { buffer:buffer,engine:admitted.unwrap() });
}
// Parts must retain one valid Vec owner. Canonical metadata admission happens
// before transferring that allocation; rejected restoration leaves Parts intact.
pub fn reader_from_parts<R>(parts:&Parts<R>) -> core::result::Result<Reader<R>,core::io::Error>
    where R:core::io::Read {
    let borrowed:core::buffered::Parts<R> = core::buffered::Parts {
        inner:parts.inner,buffer:parts.buffer.as_view(),start:parts.start,length:parts.length,faulted:parts.faulted
    };
    let admitted:core::result::Result<core::buffered::Reader<R>,core::io::Error> = core::buffered::reader_from_parts<R>(borrowed.borrow());
    if (admitted.is_err()) { return core::result::Err(admitted.unwrap_err()); }
    let buffer:alloc::vec::Vec<u8> = parts.buffer.take();
    parts.start=0; parts.length=0; parts.faulted=false;
    return core::result::Ok(Reader { buffer:buffer,engine:admitted.unwrap() });
}
pub fn writer_from_parts<W>(parts:&Parts<W>) -> core::result::Result<Writer<W>,core::io::Error>
    where W:core::io::Write {
    let borrowed:core::buffered::Parts<W> = core::buffered::Parts {
        inner:parts.inner,buffer:parts.buffer.as_view(),start:parts.start,length:parts.length,faulted:parts.faulted
    };
    let admitted:core::result::Result<core::buffered::Writer<W>,core::io::Error> = core::buffered::writer_from_parts<W>(borrowed.borrow());
    if (admitted.is_err()) { return core::result::Err(admitted.unwrap_err()); }
    let buffer:alloc::vec::Vec<u8> = parts.buffer.take();
    parts.start=0; parts.length=0; parts.faulted=false;
    return core::result::Ok(Writer { buffer:buffer,engine:admitted.unwrap() });
}

pub impl<I> Parts<I> {
    pub fn borrow(&self) -> &Parts<I> { return self; }
    // Read-only borrow of unread / not-yet-acknowledged bytes at this layer.
    // Under a fault, actual provider effects are not recoverable from this span.
    pub fn bytes(&self) -> core::slice::View<u8> {
        return core::slice::View { values:self.buffer.as_slice(),start:self.start,length:self.length };
    }
    pub fn discard(&self) -> i32 {
        let discarded:i32=self.length;
        self.buffer.destroy(); self.start=0; self.length=0; self.faulted=false;
        return discarded;
    }
}

pub impl<R> Reader<R> {
    pub fn borrow(&self) -> &Reader<R> { return self; }
    pub fn is_active(&self) -> bool { return self.engine.is_active(); }
    pub fn is_faulted(&self) -> bool { return self.engine.is_faulted(); }
    pub fn capacity(&self) -> i32 { return self.engine.capacity(); }
    pub fn buffered(&self) -> core::slice::View<u8> { return self.engine.buffered(); }
    pub fn take_parts(&self) -> core::result::Result<Parts<R>,core::io::Error> {
        let detached:core::result::Result<core::buffered::Parts<R>,core::io::Error> = self.engine.take_parts();
        if (detached.is_err()) { return core::result::Err(detached.unwrap_err()); }
        let parts:core::buffered::Parts<R> = detached.unwrap();
        let buffer:alloc::vec::Vec<u8> = self.buffer.take();
        return core::result::Ok(Parts { inner:parts.inner,buffer:buffer,start:parts.start,length:parts.length,faulted:parts.faulted });
    }
    pub fn discard(&self) -> i32 {
        let discarded:i32=self.engine.discard(); self.buffer.destroy(); return discarded;
    }
}
pub impl<R> core::io::Read for Reader<R> where R:core::io::Read {
    pub fn read(&self, destination:[u8], offset:i32, count:i32) -> core::result::Result<i32,core::io::Error> {
        return self.engine.read(destination,offset,count);
    }
}
pub impl<R> core::io::BufRead for Reader<R> where R:core::io::Read {
    pub fn fill_buf(&self) -> core::result::Result<core::slice::View<u8>,core::io::Error> { return self.engine.fill_buf(); }
    pub fn consume(&self, count:i32) -> core::result::Result<i32,core::io::Error> { return self.engine.consume(count); }
}
pub impl<R> core::io::Seek for Reader<R> where R:core::io::Read, R:core::io::Seek {
    pub fn seek(&self, from:core::io::SeekFrom) -> core::result::Result<u64,core::io::Error> { return self.engine.seek(from); }
}

pub impl<W> Writer<W> {
    pub fn borrow(&self) -> &Writer<W> { return self; }
    pub fn is_active(&self) -> bool { return self.engine.is_active(); }
    pub fn is_faulted(&self) -> bool { return self.engine.is_faulted(); }
    pub fn capacity(&self) -> i32 { return self.engine.capacity(); }
    pub fn pending(&self) -> core::slice::View<u8> { return self.engine.pending(); }
    pub fn finish(&self) -> core::result::Result<i32,core::io::Error> where W:core::io::Write {
        let finished:core::result::Result<i32,core::io::Error> = self.engine.finish();
        if (finished.is_err()) { return core::result::Err(finished.unwrap_err()); }
        self.buffer.destroy(); return core::result::Ok(0);
    }
    pub fn take_parts(&self) -> core::result::Result<Parts<W>,core::io::Error> {
        let detached:core::result::Result<core::buffered::Parts<W>,core::io::Error> = self.engine.take_parts();
        if (detached.is_err()) { return core::result::Err(detached.unwrap_err()); }
        let parts:core::buffered::Parts<W> = detached.unwrap();
        let buffer:alloc::vec::Vec<u8> = self.buffer.take();
        return core::result::Ok(Parts { inner:parts.inner,buffer:buffer,start:parts.start,length:parts.length,faulted:parts.faulted });
    }
    pub fn discard(&self) -> i32 {
        let discarded:i32=self.engine.discard(); self.buffer.destroy(); return discarded;
    }
}
pub impl<W> core::io::Write for Writer<W> where W:core::io::Write {
    pub fn write(&self, source:[u8], offset:i32, count:i32) -> core::result::Result<i32,core::io::Error> {
        return self.engine.write(source,offset,count);
    }
    pub fn flush(&self) -> core::result::Result<i32,core::io::Error> { return self.engine.flush(); }
}
pub impl<W> core::io::Seek for Writer<W> where W:core::io::Write, W:core::io::Seek {
    pub fn seek(&self, from:core::io::SeekFrom) -> core::result::Result<u64,core::io::Error> { return self.engine.seek(from); }
}
