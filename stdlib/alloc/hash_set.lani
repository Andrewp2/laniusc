// Generic set over the shared map engine. Storage is owned; key copies borrow
// nested resources. Keep one active owner. See docs/stdlib-owned-sets.md.
module alloc::hash_set;
import alloc::hash_map;
import core::cmp;
import core::hash;
import core::option;
import core::result;

pub struct HashSet<T> { state: alloc::hash_map::KeyStorage }
pub struct Iter<T> { state: alloc::hash_map::KeyCursor }

pub fn new<T>() -> HashSet<T> { return HashSet { state: alloc::hash_map::key_storage<T>() }; }
pub fn with_capacity<T>(capacity: i32) -> core::result::Result<HashSet<T>, alloc::hash_map::Error> {
    let set: HashSet<T> = new();
    let result: core::result::Result<i32, alloc::hash_map::Error> = set.try_reserve(capacity);
    if (core::result::is_err(result)) { return core::result::Err(core::result::unwrap_err(result)); }
    return core::result::Ok(set);
}
pub impl<T> HashSet<T> {
    pub fn borrow(&self) -> &HashSet<T> { return self; }
    pub fn len(&self) -> i32 { return self.state.length; }
    pub fn is_empty(&self) -> bool { return self.state.length == 0; }
    pub fn capacity(&self) -> i32 { return self.state.buckets / 2; }
    pub fn contains(&self, key: T) -> bool where T: core::hash::Hash<T>, T: core::cmp::Eq<T> { return alloc::hash_map::key_contains<T>(self.state.borrow(), key); }
    // Returned copies borrow nested key resources; lookups do not transfer them.
    pub fn get(&self, key: T) -> core::option::Option<T> where T: core::hash::Hash<T>, T: core::cmp::Eq<T> { return alloc::hash_map::key_get<T>(self.state.borrow(), key); }
    // None stores the supplied key. Some(supplied) preserves an existing equal
    // representative and explicitly returns the supplied key. Err retains input.
    pub fn try_insert(&self, key: T) -> core::result::Result<core::option::Option<T>, alloc::hash_map::Error> where T: core::hash::Hash<T>, T: core::cmp::Eq<T> {
        if (self.contains(key)) { return core::result::Ok(core::option::Some(key)); }
        return alloc::hash_map::key_replace<T>(self.state.borrow(), key);
    }
    // Store the supplied representative and return the displaced stored key.
    // None means newly inserted. Err preserves the set and caller-owned input.
    pub fn try_replace(&self, key: T) -> core::result::Result<core::option::Option<T>, alloc::hash_map::Error> where T: core::hash::Hash<T>, T: core::cmp::Eq<T> {
        return alloc::hash_map::key_replace<T>(self.state.borrow(), key);
    }
    // Return the stored representative; callers manage any nested resources.
    pub fn remove(&self, key: T) -> core::option::Option<T> where T: core::hash::Hash<T>, T: core::cmp::Eq<T> { return alloc::hash_map::key_remove<T>(self.state.borrow(), key); }
    // Any mutation/destruction invalidates outstanding cursors and borrowed keys.
    pub fn iter(&self) -> Iter<T> { return Iter { state: alloc::hash_map::key_iter<T>(self.state.borrow()) }; }
    pub fn try_reserve(&self, additional: i32) -> core::result::Result<i32, alloc::hash_map::Error> { return alloc::hash_map::key_reserve<T>(self.state.borrow(), additional); }
    pub fn try_shrink_to_fit(&self) -> core::result::Result<i32, alloc::hash_map::Error> { return alloc::hash_map::key_shrink<T>(self.state.borrow()); }
    // Independent storage with shallow borrowed key copies, as with map clone.
    pub fn try_clone(&self) -> core::result::Result<HashSet<T>, alloc::hash_map::Error> {
        let result: core::result::Result<alloc::hash_map::KeyStorage, alloc::hash_map::Error> = alloc::hash_map::key_clone<T>(self.state.borrow());
        if (core::result::is_err(result)) { return core::result::Err(core::result::unwrap_err(result)); }
        return core::result::Ok(HashSet { state: core::result::unwrap(result) });
    }
    // Neither operation destroys resources nested in keys. Remove/drain owners
    // first when their resources must be reclaimed. destroy resets for reuse.
    pub fn clear(&self) { alloc::hash_map::key_clear<T>(self.state.borrow()); }
    pub fn destroy(&self) { alloc::hash_map::key_destroy<T>(self.state.borrow()); }
    pub fn is_subset(&self, other: &HashSet<T>) -> bool where T: core::hash::Hash<T>, T: core::cmp::Eq<T> {
        if (self.len() > other.len()) { return false; }
        let cursor: Iter<T> = self.iter();
        while (true) {
            let item: core::option::Option<T> = cursor.next();
            if (core::option::is_none(item)) { return true; }
            if (!other.contains(core::option::unwrap(item))) { return false; }
        }
        return true;
    }
    pub fn is_disjoint(&self, other: &HashSet<T>) -> bool where T: core::hash::Hash<T>, T: core::cmp::Eq<T> {
        let cursor: Iter<T> = self.iter();
        while (true) {
            let item: core::option::Option<T> = cursor.next();
            if (core::option::is_none(item)) { return true; }
            if (other.contains(core::option::unwrap(item))) { return false; }
        }
        return true;
    }
    pub fn equals(&self, other: &HashSet<T>) -> bool where T: core::hash::Hash<T>, T: core::cmp::Eq<T> { return self.len() == other.len() && self.is_subset(other); }
    // Read sources only, including self-aliasing. A failed allocation frees all
    // partial destination storage. Left representatives win equivalent keys.
    fn combine(&self, other: &HashSet<T>, mode: i32) -> core::result::Result<HashSet<T>, alloc::hash_map::Error> where T: core::hash::Hash<T>, T: core::cmp::Eq<T> {
        let output: HashSet<T> = new();
        let cursor: Iter<T> = self.iter();
        while (true) {
            let item: core::option::Option<T> = cursor.next();
            if (core::option::is_none(item)) { break; }
            let key: T = core::option::unwrap(item);
            let include: bool = mode == 1;
            if (mode == 2) { include = other.contains(key); }
            if (mode == 3 || mode == 4) { include = !other.contains(key); }
            if (include) {
                let result: core::result::Result<core::option::Option<T>, alloc::hash_map::Error> = output.try_insert(key);
                if (core::result::is_err(result)) { output.destroy(); return core::result::Err(core::result::unwrap_err(result)); }
            }
        }
        if (mode == 1 || mode == 4) {
            cursor = other.iter();
            while (true) {
                let item: core::option::Option<T> = cursor.next();
                if (core::option::is_none(item)) { break; }
                let key: T = core::option::unwrap(item);
                if (mode == 1 || !self.contains(key)) {
                    let result: core::result::Result<core::option::Option<T>, alloc::hash_map::Error> = output.try_insert(key);
                    if (core::result::is_err(result)) { output.destroy(); return core::result::Err(core::result::unwrap_err(result)); }
                }
            }
        }
        return core::result::Ok(output);
    }
    pub fn try_union(&self, other: &HashSet<T>) -> core::result::Result<HashSet<T>, alloc::hash_map::Error> where T: core::hash::Hash<T>, T: core::cmp::Eq<T> { return self.combine(other, 1); }
    pub fn try_intersection(&self, other: &HashSet<T>) -> core::result::Result<HashSet<T>, alloc::hash_map::Error> where T: core::hash::Hash<T>, T: core::cmp::Eq<T> { return self.combine(other, 2); }
    pub fn try_difference(&self, other: &HashSet<T>) -> core::result::Result<HashSet<T>, alloc::hash_map::Error> where T: core::hash::Hash<T>, T: core::cmp::Eq<T> { return self.combine(other, 3); }
    pub fn try_symmetric_difference(&self, other: &HashSet<T>) -> core::result::Result<HashSet<T>, alloc::hash_map::Error> where T: core::hash::Hash<T>, T: core::cmp::Eq<T> { return self.combine(other, 4); }
}
pub impl<T> Iter<T> {
    pub fn next(&self) -> core::option::Option<T> { return alloc::hash_map::key_next<T>(self.state.borrow()); }
}
