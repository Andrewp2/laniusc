// Independent owned nonnegative integers, base 2^32, least significant limb first.
// Keep one active owner per allocation. All operands are borrowed; destroy each
// successful owned result exactly once. Zero has no limbs and needs no allocation.
module alloc::big_uint;
import core::lifecycle;
import alloc::vec;
import core::cmp;
import core::hash;
import core::mem;
import core::result;
import core::slice;

pub enum Error { Bounds, LimbLimit, WorkLimit, OutputLimit, AllocationFailed, InvalidRadix, InvalidDigit, Empty, Underflow, DivisionByZero, Overflow, NegativeExponent, NotInvertible }
pub struct Limits { max_limbs: i32, max_work: u64, max_output: i32 }
pub struct BigUint { limbs: alloc::vec::Vec<u32> }
pub struct DivRem { quotient: BigUint, remainder: BigUint }
const BASE: u64 = 4294967296;
const MASK: u64 = 4294967295;
// Operands with at least this many significant limbs on both sides use Karatsuba.
pub const KARATSUBA_THRESHOLD: i32 = 32;
// Divisors with at least this many limbs, and quotients at least this long, use
// Burnikel-Ziegler recursive division; smaller cases use Knuth algorithm D.
pub const BURNIKEL_ZIEGLER_THRESHOLD: i32 = 1024;
// Values above this many limbs (inputs above this many digits) convert by
// divide and conquer over squared radix powers.
pub const CONVERSION_THRESHOLD: i32 = 1024;
const PARSE_DC_DIGITS: i32 = 8192;
pub fn default_limits() -> Limits { return Limits { max_limbs: 1048576, max_work: 100000000, max_output: 1048576 }; }
pub fn zero() -> BigUint { return BigUint { limbs: alloc::vec::new() }; }
fn valid(limits: Limits) -> bool { return limits.max_limbs >= 0 && limits.max_limbs <= 536870911 && limits.max_output >= 0; }
fn limb_capacity() -> i32 { return (2147483647/core::mem::size_of<u32>()) as i32; }
fn guard(limits: Limits, count: i32, work: u64) -> core::result::Result<i32,Error> {
    if (!valid(limits) || count < 0) { return core::result::Err(Error::Bounds); }
    if (count > limits.max_limbs || count > limb_capacity()) { return core::result::Err(Error::LimbLimit); }
    if (work > limits.max_work) { return core::result::Err(Error::WorkLimit); }
    return core::result::Ok(count);
}
fn fresh(count: i32, limits: Limits) -> core::result::Result<BigUint,Error> {
    let checked: core::result::Result<i32,Error> = guard(limits,count,count as u64);
    if (checked.is_err()) { return core::result::Err(checked.unwrap_err()); }
    let value: BigUint = zero();
    if (value.limbs.try_resize(count,0).is_err()) { return core::result::Err(Error::AllocationFailed); }
    return core::result::Ok(value);
}
pub fn from_u64(value: u64, limits: Limits) -> core::result::Result<BigUint,Error> {
    let count: i32 = 0; if (value != 0) { count = 1; } if (value > MASK) { count = 2; }
    let made: core::result::Result<BigUint,Error> = fresh(count,limits); if (made.is_err()) { return made; }
    let out: BigUint = made.unwrap(); if (count > 0) { out.put(0,value as u32); } if (count == 2) { out.put(1,(value >> 32) as u32); }
    return core::result::Ok(out);
}
impl BigUint {
    fn get(&self, index: i32) -> u32 { return self.limbs.get_or(index,0); }
    fn put(&self, index: i32, value: u32) { core::result::unwrap(self.limbs.set(index,value)); }
    fn normalize(&self) { while (self.limbs.len() > 0 && self.get(self.limbs.len()-1) == 0) { self.limbs.pop(); } }
    fn append(&self, value: u32, limits: Limits) -> core::result::Result<i32,Error> {
        if (self.limbs.len() >= limits.max_limbs || self.limbs.len() >= limb_capacity()) { return core::result::Err(Error::LimbLimit); }
        // Reserve exactly; vector geometric growth must not escape the limb budget.
        if (self.limbs.try_reserve(1).is_err()) { return core::result::Err(Error::AllocationFailed); }
        if (self.limbs.try_push(value).is_err()) { return core::result::Err(Error::AllocationFailed); }
        return core::result::Ok(self.limbs.len());
    }
    fn mul_add_small(&self, radix: u32, digit: u32, limits: Limits) -> core::result::Result<i32,Error> {
        let carry: u64 = digit as u64; let index: i32 = 0; let limbs: [u32] = self.limbs.as_slice(); let count: i32 = self.limbs.len();
        while (index < count) { let wide: u64 = (limbs[index] as u64)*(radix as u64)+carry; limbs[index] = wide as u32; carry = wide >> 32; index += 1; }
        if (carry != 0) { return self.append(carry as u32,limits); } return core::result::Ok(self.limbs.len());
    }
    fn div_small(&self, divisor: u32) -> u32 {
        let rem: u64 = 0; let index: i32 = self.limbs.len(); let limbs: [u32] = self.limbs.as_slice(); let wide_divisor: u64 = divisor as u64;
        while (index > 0) { index -= 1; let wide: u64 = (rem << 32)|(limbs[index] as u64); let q: u64 = wide/wide_divisor; limbs[index] = q as u32; rem = wide-q*wide_divisor; }
        self.normalize(); return rem as u32;
    }
}
pub impl DivRem { pub fn destroy(&self) { self.quotient.destroy(); self.remainder.destroy(); } }
pub impl BigUint {
    pub fn borrow(&self) -> &BigUint { return self; }
    pub fn destroy(&self) { self.limbs.destroy(); }
    pub fn limb_len(&self) -> i32 { return self.limbs.len(); }
    pub fn is_zero(&self) -> bool { return self.limbs.is_empty(); }
    pub fn bit_length(&self) -> u64 {
        if (self.is_zero()) { return 0; } let high: u32 = self.get(self.limbs.len()-1); let bits: u64 = 0;
        while (high != 0) { bits += 1; high = high >> 1; } return ((self.limbs.len()-1) as u64)*32+bits;
    }
    pub fn bit(&self, index: u64) -> bool { if (index/32 >= self.limbs.len() as u64) { return false; } return ((self.get((index/32) as i32) >> ((index%32) as i32)) & 1) != 0; }
    pub fn compare(&self, other: &BigUint) -> i32 {
        if (self.limbs.len() < other.limbs.len()) { return -1; } if (self.limbs.len() > other.limbs.len()) { return 1; }
        let index: i32 = self.limbs.len(); while (index > 0) { index -= 1; if (self.get(index) < other.get(index)) { return -1; } if (self.get(index) > other.get(index)) { return 1; } } return 0;
    }
    pub fn to_u64(&self) -> core::result::Result<u64,Error> { if (self.limbs.len() > 2) { return core::result::Err(Error::Overflow); } return core::result::Ok((self.get(0) as u64)|((self.get(1) as u64) << 32)); }
    pub fn try_clone(&self, limits: Limits) -> core::result::Result<BigUint,Error> {
        let made: core::result::Result<BigUint,Error> = fresh(self.limbs.len(),limits); if (made.is_err()) { return made; } let out: BigUint = made.unwrap(); let index: i32 = 0;
        while (index < self.limbs.len()) { out.put(index,self.get(index)); index += 1; } return core::result::Ok(out);
    }
    pub fn add(&self, other: &BigUint, limits: Limits) -> core::result::Result<BigUint,Error> {
        let count: i32 = self.limbs.len(); if (other.limbs.len() > count) { count = other.limbs.len(); }
        let made: core::result::Result<BigUint,Error> = fresh(count,limits); if (made.is_err()) { return made; } let out: BigUint = made.unwrap(); let carry: u64 = 0; let index: i32 = 0;
        while (index < count) { let wide: u64 = (self.get(index) as u64)+(other.get(index) as u64)+carry; out.put(index,wide as u32); carry = wide >> 32; index += 1; }
        if (carry != 0) { let grown: core::result::Result<i32,Error> = out.append(carry as u32,limits); if (grown.is_err()) { out.destroy(); return core::result::Err(grown.unwrap_err()); } }
        return core::result::Ok(out);
    }
    pub fn sub(&self, other: &BigUint, limits: Limits) -> core::result::Result<BigUint,Error> {
        if (self.compare(other) < 0) { return core::result::Err(Error::Underflow); }
        let made: core::result::Result<BigUint,Error> = fresh(self.limbs.len(),limits); if (made.is_err()) { return made; } let out: BigUint = made.unwrap(); let borrow: u64 = 0; let index: i32 = 0;
        while (index < self.limbs.len()) { let left: u64 = self.get(index) as u64; let right: u64 = (other.get(index) as u64)+borrow; out.put(index,(left+BASE-right) as u32); borrow = 0; if (left < right) { borrow = 1; } index += 1; }
        out.normalize(); return core::result::Ok(out);
    }
    pub fn mul(&self, other: &BigUint, limits: Limits) -> core::result::Result<BigUint,Error> {
        if (!valid(limits)) { return core::result::Err(Error::Bounds); }
        let work: u64 = (self.limbs.len() as u64)*(other.limbs.len() as u64); if (work > limits.max_work) { return core::result::Err(Error::WorkLimit); }
        if (self.is_zero() || other.is_zero()) { return core::result::Ok(zero()); }
        let count: i32 = self.limbs.len()+other.limbs.len(); if (count-1 > limits.max_limbs) { return core::result::Err(Error::LimbLimit); } if (count > limits.max_limbs) { count = limits.max_limbs; }
        let longest: i32 = self.limbs.len(); if (other.limbs.len() > longest) { longest = other.limbs.len(); } let scratch: i64 = workspace_limbs(longest);
        // One Karatsuba workspace of about 8*longest limbs (at most 8*max_limbs+64),
        // bounded by the vector's limb capacity; otherwise schoolbook.
        if (count == self.limbs.len()+other.limbs.len() && self.limbs.len() >= KARATSUBA_THRESHOLD && other.limbs.len() >= KARATSUBA_THRESHOLD && scratch <= 8*(limits.max_limbs as i64)+64 && scratch <= limb_capacity() as i64 && (scratch as u64) <= limits.max_work) {
            let wide: core::result::Result<BigUint,Error> = fresh(count,limits); if (wide.is_err()) { return wide; } let product: BigUint = wide.unwrap();
            let workspace_limits: Limits = limits; workspace_limits.max_limbs = 536870911;
            let space: core::result::Result<BigUint,Error> = fresh(scratch as i32,workspace_limits); if (space.is_err()) { product.destroy(); return space; } let workspace: BigUint = space.unwrap();
            kmul_into(product.borrow(),0,count,self,0,self.limbs.len(),other,0,other.limbs.len(),workspace.borrow(),0);
            workspace.destroy(); product.normalize(); return core::result::Ok(product);
        }
        let made: core::result::Result<BigUint,Error> = fresh(count,limits); if (made.is_err()) { return made; } let out: BigUint = made.unwrap(); let i: i32 = 0;
        while (i < self.limbs.len()) {
            let carry: u64 = 0; let j: i32 = 0;
            // (B-1)^2 + (B-1) + (B-1) = B^2-1, exactly u64::MAX.
            while (j < other.limbs.len()) { let wide: u64 = (self.get(i) as u64)*(other.get(j) as u64)+(out.get(i+j) as u64)+carry; out.put(i+j,wide as u32); carry = wide >> 32; j += 1; }
            if (i+j < count) { out.put(i+j,carry as u32); } else { if (carry != 0) { out.destroy(); return core::result::Err(Error::LimbLimit); } } i += 1;
        }
        out.normalize(); return core::result::Ok(out);
    }
    pub fn shl(&self, bits: u64, limits: Limits) -> core::result::Result<BigUint,Error> {
        if (!valid(limits)) { return core::result::Err(Error::Bounds); } if (self.is_zero()) { return core::result::Ok(zero()); }
        let whole: u64 = bits/32; let shift: i32 = (bits%32) as i32;
        let extra: i32 = 0; if (shift != 0 && ((self.get(self.limbs.len()-1) as u64) >> (32-shift)) != 0) { extra = 1; }
        if (whole > limits.max_limbs as u64 || (self.limbs.len() as u64)+whole+(extra as u64) > limits.max_limbs as u64) { return core::result::Err(Error::LimbLimit); }
        let made: core::result::Result<BigUint,Error> = fresh(self.limbs.len()+(whole as i32)+extra,limits); if (made.is_err()) { return made; } let out: BigUint = made.unwrap(); let carry: u64 = 0; let i: i32 = 0;
        while (i < self.limbs.len()) { let wide: u64 = ((self.get(i) as u64) << shift)|carry; out.put(i+(whole as i32),wide as u32); carry = wide >> 32; i += 1; } if (extra != 0) { out.put(i+(whole as i32),carry as u32); } return core::result::Ok(out);
    }
    pub fn shr(&self, bits: u64, limits: Limits) -> core::result::Result<BigUint,Error> {
        if (!valid(limits)) { return core::result::Err(Error::Bounds); } if (bits/32 >= self.limbs.len() as u64) { return core::result::Ok(zero()); }
        let whole: i32 = (bits/32) as i32; let shift: i32 = (bits%32) as i32; let count: i32 = self.limbs.len()-whole;
        let made: core::result::Result<BigUint,Error> = fresh(count,limits); if (made.is_err()) { return made; } let out: BigUint = made.unwrap(); let i: i32 = 0;
        while (i < count) { let wide: u64 = (self.get(i+whole) as u64)|((self.get(i+whole+1) as u64) << 32); out.put(i,(wide >> shift) as u32); i += 1; } out.normalize(); return core::result::Ok(out);
    }
}
// Karatsuba over limb windows in one caller-owned workspace. kmul_into adds
// x[xf..xf+xc]*y[yf..yf+yc] into out[at..end); that window holds the whole sum,
// so carries never leave it. A balanced node of n limbs (k = ceil(n/2)) keeps
// z0[2k], z2[2k], x0+x1[k+1], y0+y1[k+1] and z1[2k+2] in ws[wf..wf+8k+4] and
// hands the rest to its children, which run one at a time. Unbalanced nodes
// split only the longer operand and need no storage of their own.
fn workspace_limbs(n: i32) -> i64 { let total: i64 = 0; let size: i32 = n; while (size >= KARATSUBA_THRESHOLD) { let k: i32 = (size+1)/2; total += 8*(k as i64)+4; size = k+1; } return total; }
fn used(x: &BigUint, from: i32, count: i32) -> i32 { let n: i32 = count; let xs: [u32] = x.limbs.as_slice(); while (n > 0 && xs[from+n-1] == 0) { n -= 1; } return n; }
fn clear_window(out: &BigUint, at: i32, count: i32) { let os: [u32] = out.limbs.as_slice(); let index: i32 = 0; while (index < count) { os[at+index] = 0; index += 1; } }
fn add_window(out: &BigUint, at: i32, end: i32, src: &BigUint, from: i32, count: i32) {
    let carry: u64 = 0; let index: i32 = 0; let os: [u32] = out.limbs.as_slice(); let ss: [u32] = src.limbs.as_slice();
    while (index < count) { let wide: u64 = (os[at+index] as u64)+(ss[from+index] as u64)+carry; os[at+index] = wide as u32; carry = wide >> 32; index += 1; }
    let position: i32 = at+count;
    while (carry != 0 && position < end) { let wide: u64 = (os[position] as u64)+carry; os[position] = wide as u32; carry = wide >> 32; position += 1; }
}
// out[at..end) -= src[from..from+count), where the window value is >= src.
fn sub_window(out: &BigUint, at: i32, end: i32, src: &BigUint, from: i32, count: i32) {
    let borrow: u64 = 0; let index: i32 = 0; let os: [u32] = out.limbs.as_slice(); let ss: [u32] = src.limbs.as_slice();
    while ((index < count || borrow != 0) && at+index < end) {
        let left: u64 = os[at+index] as u64; let right: u64 = borrow; if (index < count) { right += ss[from+index] as u64; }
        os[at+index] = (left+BASE-right) as u32; borrow = 0; if (left < right) { borrow = 1; } index += 1;
    }
}
fn kmul_into(out: &BigUint, at: i32, end: i32, x: &BigUint, xf: i32, xc: i32, y: &BigUint, yf: i32, yc: i32, ws: &BigUint, wf: i32) {
    let xl: i32 = used(x,xf,xc); let yl: i32 = used(y,yf,yc);
    if (xl == 0 || yl == 0) { return; }
    if (xl < yl) { kmul_into(out,at,end,y,yf,yl,x,xf,xl,ws,wf); return; }
    if (yl < KARATSUBA_THRESHOLD) {
        let i: i32 = 0; let xs: [u32] = x.limbs.as_slice(); let ys: [u32] = y.limbs.as_slice(); let os: [u32] = out.limbs.as_slice();
        while (i < yl) {
            let factor: u64 = ys[yf+i] as u64;
            if (factor != 0) {
                let carry: u64 = 0; let j: i32 = 0; let base: i32 = at+i;
                // factor*x_j + out + carry <= (B-1)^2 + 2(B-1) = B^2-1.
                while (j < xl) { let wide: u64 = factor*(xs[xf+j] as u64)+(os[base+j] as u64)+carry; os[base+j] = wide as u32; carry = wide >> 32; j += 1; }
                let position: i32 = base+xl;
                while (carry != 0 && position < end) { let wide: u64 = (os[position] as u64)+carry; os[position] = wide as u32; carry = wide >> 32; position += 1; }
            }
            i += 1;
        }
        return;
    }
    let k: i32 = (xl+1)/2;
    if (yl <= k) { kmul_into(out,at,end,x,xf,k,y,yf,yl,ws,wf); kmul_into(out,at+k,end,x,xf+k,xl-k,y,yf,yl,ws,wf); return; }
    let z0: i32 = wf; let z2: i32 = wf+2*k; let sx: i32 = wf+4*k; let sy: i32 = wf+5*k+1; let z1: i32 = wf+6*k+2; let child: i32 = wf+8*k+4;
    clear_window(ws,wf,8*k+4);
    kmul_into(ws,z0,z0+2*k,x,xf,k,y,yf,k,ws,child);
    kmul_into(ws,z2,z2+2*k,x,xf+k,xl-k,y,yf+k,yl-k,ws,child);
    add_window(ws,sx,sx+k+1,x,xf,k); add_window(ws,sx,sx+k+1,x,xf+k,xl-k);
    add_window(ws,sy,sy+k+1,y,yf,k); add_window(ws,sy,sy+k+1,y,yf+k,yl-k);
    kmul_into(ws,z1,z1+2*k+2,ws,sx,k+1,ws,sy,k+1,ws,child);
    // (x0+x1)(y0+y1) - x0*y0 - x1*y1 = x0*y1 + x1*y0 >= 0.
    sub_window(ws,z1,z1+2*k+2,ws,z0,2*k); sub_window(ws,z1,z1+2*k+2,ws,z2,2*k);
    add_window(out,at,end,ws,z0,used(ws,z0,2*k));
    add_window(out,at+k,end,ws,z1,used(ws,z1,2*k+2));
    add_window(out,at+2*k,end,ws,z2,used(ws,z2,2*k));
}
// Largest g with radix^g < 2^32.
fn chunk_digits(radix: i32) -> i32 { let g: i32 = 0; let power: u64 = 1; while (power*(radix as u64) <= MASK) { power = power*(radix as u64); g += 1; } return g; }
fn digit(byte: u8) -> i32 { if (byte >= 48 && byte <= 57) { return (byte-48) as i32; } if (byte >= 65 && byte <= 90) { return (byte-65) as i32+10; } if (byte >= 97 && byte <= 122) { return (byte-97) as i32+10; } return 36; }
fn parse_basic(input: core::slice::View<u8>, radix: i32, limits: Limits) -> core::result::Result<BigUint,Error> {
    if (!valid(limits) || input.start < 0 || input.length < 0 || input.start > 2147483647-input.length) { return core::result::Err(Error::Bounds); }
    if (radix < 2 || radix > 36) { return core::result::Err(Error::InvalidRadix); } if (input.length == 0) { return core::result::Err(Error::Empty); }
    if ((input.length as u64) > limits.max_work) { return core::result::Err(Error::WorkLimit); }
    let index: i32 = 0; while (index < input.length) { if (digit(input.values[input.start+index]) >= radix) { return core::result::Err(Error::InvalidDigit); } index += 1; }
    let value: BigUint = zero(); let work: u64 = input.length as u64; index = 0; let group: i32 = chunk_digits(radix);
    // Reserve the bounded final size once: ceil(log2 radix) bits per digit.
    let digit_bits: u64 = 1; while ((1 << digit_bits) < (radix as u64)) { digit_bits += 1; }
    let estimate: u64 = (input.length as u64)*digit_bits/32+1; if (estimate > limits.max_limbs as u64) { estimate = limits.max_limbs as u64; }
    if (value.limbs.try_reserve(estimate as i32).is_err()) { return core::result::Err(Error::AllocationFailed); }
    // Each pass folds up to `group` digits: value = value*radix^g + chunk, radix^g < 2^32.
    while (index < input.length) {
        let cost: u64 = (value.limbs.len() as u64)+1; if (cost > limits.max_work-work) { value.destroy(); return core::result::Err(Error::WorkLimit); } work += cost;
        let scale: u32 = 1; let chunk: u32 = 0; let taken: i32 = 0;
        while (taken < group && index < input.length) { scale = scale*(radix as u32); chunk = chunk*(radix as u32)+(digit(input.values[input.start+index]) as u32); taken += 1; index += 1; }
        let added: core::result::Result<i32,Error> = value.mul_add_small(scale,chunk,limits);
        if (added.is_err()) { value.destroy(); return core::result::Err(added.unwrap_err()); }
    } return core::result::Ok(value);
}
fn bitwise(left: &BigUint, right: &BigUint, kind: i32, limits: Limits) -> core::result::Result<BigUint,Error> {
    let count: i32 = left.limbs.len(); if (kind == 0) { if (right.limbs.len() < count) { count = right.limbs.len(); } } else { if (right.limbs.len() > count) { count = right.limbs.len(); } }
    let made: core::result::Result<BigUint,Error> = fresh(count,limits); if (made.is_err()) { return made; } let out: BigUint = made.unwrap(); let i: i32 = 0;
    while (i < count) { let value: u32 = left.get(i)&right.get(i); if (kind == 1) { value = left.get(i)|right.get(i); } if (kind == 2) { value = left.get(i)^right.get(i); } out.put(i,value); i += 1; } out.normalize(); return core::result::Ok(out);
}
pub impl BigUint {
    pub fn bit_and(&self, other: &BigUint, limits: Limits) -> core::result::Result<BigUint,Error> { return bitwise(self,other,0,limits); }
    pub fn bit_or(&self, other: &BigUint, limits: Limits) -> core::result::Result<BigUint,Error> { return bitwise(self,other,1,limits); }
    pub fn bit_xor(&self, other: &BigUint, limits: Limits) -> core::result::Result<BigUint,Error> { return bitwise(self,other,2,limits); }
}

// Normalized Knuth long division: the top divisor limb is >= B/2. At each
// position the current remainder is < divisor, hence the next quotient is < B.
// A 2/1 estimate is at most two high; the 3/2 test reduces that to at most one.
// Subtraction detects the remaining overestimate, then one addback corrects it.
fn division_work(left: i32, right: i32) -> u64 {
    if (left < right) { return left as u64; }
    return 8*((left as u64)+(right as u64)+1)+4*(((left-right+1) as u64)*(right as u64));
}
fn mul_mod_work(left: &BigUint, right: &BigUint, modulus: &BigUint) -> u64 {
    return (left.limbs.len() as u64)*(right.limbs.len() as u64)+division_work(left.limbs.len()+right.limbs.len(),modulus.limbs.len());
}
fn mul_mod(left: &BigUint, right: &BigUint, modulus: &BigUint, limits: Limits) -> core::result::Result<BigUint,Error> {
    if (mul_mod_work(left,right,modulus) > limits.max_work) { return core::result::Err(Error::WorkLimit); }
    let product: core::result::Result<BigUint,Error> = left.mul(right,limits); if (product.is_err()) { return product; } let value: BigUint = product.unwrap();
    let divided: core::result::Result<DivRem,Error> = value.div_rem(modulus,limits); value.destroy(); if (divided.is_err()) { return core::result::Err(divided.unwrap_err()); }
    let pair: DivRem = divided.unwrap(); pair.quotient.destroy(); return core::result::Ok(pair.remainder);
}
pub impl BigUint {
    fn div_rem_basic(&self, other: &BigUint, limits: Limits) -> core::result::Result<DivRem,Error> {
        if (!valid(limits)) { return core::result::Err(Error::Bounds); } if (other.is_zero()) { return core::result::Err(Error::DivisionByZero); }
        let checked: core::result::Result<i32,Error> = guard(limits,self.limbs.len(),division_work(self.limbs.len(),other.limbs.len())); if (checked.is_err()) { return core::result::Err(checked.unwrap_err()); }
        if (other.limbs.len() > limits.max_limbs) { return core::result::Err(Error::LimbLimit); }
        if (self.compare(other) < 0) { let copy: core::result::Result<BigUint,Error> = self.try_clone(limits); if (copy.is_err()) { return core::result::Err(copy.unwrap_err()); } return core::result::Ok(DivRem { quotient: zero(), remainder: copy.unwrap() }); }
        if (other.limbs.len() == 1) {
            let copy: core::result::Result<BigUint,Error> = self.try_clone(limits); if (copy.is_err()) { return core::result::Err(copy.unwrap_err()); } let quotient: BigUint = copy.unwrap(); let small: u32 = quotient.div_small(other.get(0));
            let rem: core::result::Result<BigUint,Error> = from_u64(small as u64,limits); if (rem.is_err()) { quotient.destroy(); return core::result::Err(rem.unwrap_err()); }
            return core::result::Ok(DivRem { quotient: quotient, remainder: rem.unwrap() });
        }
        let n: i32 = other.limbs.len(); let m: i32 = self.limbs.len()-n;
        let shift: i32 = 0; let high: u32 = other.get(n-1); while (high < 2147483648) { high = high << 1; shift += 1; }
        let vn: core::result::Result<BigUint,Error> = other.shl(shift as u64,limits); if (vn.is_err()) { return core::result::Err(vn.unwrap_err()); } let divisor: BigUint = vn.unwrap();
        // One guard limb is the sole storage allowance beyond max_limbs.
        let scratch_limits: Limits = limits; if (scratch_limits.max_limbs < 536870911) { scratch_limits.max_limbs += 1; }
        let un: core::result::Result<BigUint,Error> = fresh(self.limbs.len()+1,scratch_limits);
        if (un.is_err()) { divisor.destroy(); return core::result::Err(un.unwrap_err()); } let dividend: BigUint = un.unwrap();
        let carry: u64 = 0; let index: i32 = 0;
        while (index < self.limbs.len()) { let wide: u64 = ((self.get(index) as u64) << shift)|carry; dividend.put(index,wide as u32); carry = wide >> 32; index += 1; } dividend.put(index,carry as u32);
        let qn: core::result::Result<BigUint,Error> = fresh(m+1,limits); if (qn.is_err()) { dividend.destroy(); divisor.destroy(); return core::result::Err(qn.unwrap_err()); } let quotient: BigUint = qn.unwrap();
        let j: i32 = m;
        while (j >= 0) {
            let top: u64 = dividend.get(j+n) as u64; let next: u64 = dividend.get(j+n-1) as u64; let vtop: u64 = divisor.get(n-1) as u64;
            let qhat: u64 = MASK; let rhat: u64 = next+vtop;
            // top == vtop would produce B or B+1; cap first to one limb.
            if (top < vtop) { let pair: u64 = (top << 32)|next; qhat = pair/vtop; rhat = pair%vtop; }
            // Only form rhat*B while rhat < B, avoiding u64 overflow.
            while ((rhat < BASE) && qhat*(divisor.get(n-2) as u64) > (rhat << 32)+(dividend.get(j+n-2) as u64)) { qhat -= 1; rhat += vtop; }
            let borrow: u64 = 0; index = 0; let us: [u32] = dividend.limbs.as_slice(); let vs: [u32] = divisor.limbs.as_slice();
            while (index < n) {
                // qhat*v_i + prior borrow <= (B-1)^2+B-1 < B^2.
                let product: u64 = qhat*(vs[index] as u64)+borrow; let low: u64 = product&MASK; let current: u64 = us[j+index] as u64;
                us[j+index] = (current+BASE-low) as u32; borrow = product >> 32; if (current < low) { borrow += 1; } index += 1;
            }
            let current: u64 = dividend.get(j+n) as u64; dividend.put(j+n,(current+BASE-borrow) as u32);
            if (current < borrow) {
                qhat -= 1; carry = 0; index = 0;
                while (index < n) { let wide: u64 = (dividend.get(j+index) as u64)+(divisor.get(index) as u64)+carry; dividend.put(j+index,wide as u32); carry = wide >> 32; index += 1; }
                dividend.put(j+n,((dividend.get(j+n) as u64)+carry) as u32);
            }
            quotient.put(j,qhat as u32); j -= 1;
        }
        quotient.normalize(); core::result::unwrap(dividend.limbs.truncate(n)); dividend.normalize();
        let remainder_result: core::result::Result<BigUint,Error> = dividend.shr(shift as u64,limits); dividend.destroy(); divisor.destroy();
        if (remainder_result.is_err()) { quotient.destroy(); return core::result::Err(remainder_result.unwrap_err()); }
        return core::result::Ok(DivRem { quotient: quotient, remainder: remainder_result.unwrap() });
    }
    fn format_basic(&self, radix: i32, limits: Limits) -> core::result::Result<alloc::vec::Vec<u8>,Error> {
        if (!valid(limits)) { return core::result::Err(Error::Bounds); } if (radix < 2 || radix > 36) { return core::result::Err(Error::InvalidRadix); }
        if (limits.max_output == 0) { return core::result::Err(Error::OutputLimit); }
        let cloned: core::result::Result<BigUint,Error> = self.try_clone(limits); if (cloned.is_err()) { return core::result::Err(cloned.unwrap_err()); } let copy: BigUint = cloned.unwrap(); let output: alloc::vec::Vec<u8> = alloc::vec::new(); let work: u64 = self.limbs.len() as u64;
        let digit_bits: u64 = 0; let radix_power: i32 = radix; while (radix_power > 1) { digit_bits += 1; radix_power = radix_power >> 1; }
        let reserve: u64 = self.bit_length()/digit_bits+1; if (reserve > limits.max_output as u64) { reserve = limits.max_output as u64; }
        if (output.try_reserve(reserve as i32).is_err()) { copy.destroy(); return core::result::Err(Error::AllocationFailed); }
        let group: i32 = chunk_digits(radix); let divisor: u32 = 1; let g: i32 = 0; while (g < group) { divisor = divisor*(radix as u32); g += 1; }
        // Each pass divides by radix^g and emits g digits, least significant first;
        // the most significant chunk stops at its last nonzero digit.
        while (true) {
            let cost: u64 = (copy.limbs.len() as u64)+1; if (cost > limits.max_work-work) { copy.destroy(); output.destroy(); return core::result::Err(Error::WorkLimit); } work += cost;
            let rem: u32 = copy.div_small(divisor); let emitted: i32 = 0;
            while (emitted < group && (!copy.is_zero() || rem != 0 || output.len() == 0)) {
                if (output.len() >= limits.max_output) { copy.destroy(); output.destroy(); return core::result::Err(Error::OutputLimit); }
                let value: u32 = rem%(radix as u32); rem = rem/(radix as u32); let byte: u8 = (value+48) as u8; if (value >= 10) { byte = (value+87) as u8; }
                if (output.try_push(byte).is_err()) { copy.destroy(); output.destroy(); return core::result::Err(Error::AllocationFailed); } emitted += 1;
            }
            if (copy.is_zero()) { break; }
        }
        copy.destroy(); output.reverse(); return core::result::Ok(output);
    }
    pub fn format_into(&self, output: core::slice::View<u8>, radix: i32, limits: Limits) -> core::result::Result<i32,Error> {
        if (output.start < 0 || output.length < 0 || output.start > 2147483647-output.length) { return core::result::Err(Error::Bounds); }
        let formatted: core::result::Result<alloc::vec::Vec<u8>,Error> = self.format_radix(radix,limits); if (formatted.is_err()) { return core::result::Err(formatted.unwrap_err()); } let bytes: alloc::vec::Vec<u8> = formatted.unwrap();
        let count: i32 = bytes.len(); if (count > output.length) { bytes.destroy(); return core::result::Err(Error::OutputLimit); }
        let index: i32 = 0; while (index < count) { output.values[output.start+index] = bytes.at(index); index += 1; } bytes.destroy(); return core::result::Ok(count);
    }
    pub fn pow(&self, exponent: u32, limits: Limits) -> core::result::Result<BigUint,Error> {
        let one: core::result::Result<BigUint,Error> = from_u64(1,limits); if (one.is_err()) { return one; } let out: BigUint = one.unwrap();
        if (exponent == 0) { return core::result::Ok(out); }
        let cloned: core::result::Result<BigUint,Error> = self.try_clone(limits); if (cloned.is_err()) { out.destroy(); return cloned; } let base: BigUint = cloned.unwrap(); let left: u32 = exponent; let budget: Limits = limits;
        while (left != 0) {
            if ((left & 1) != 0) {
                let cost: u64 = (out.limbs.len() as u64)*(base.limbs.len() as u64)+(out.limbs.len() as u64)+(base.limbs.len() as u64);
                if (cost > budget.max_work) { out.destroy(); base.destroy(); return core::result::Err(Error::WorkLimit); }
                let multiplied: core::result::Result<BigUint,Error> = out.mul(base.borrow(),budget); if (multiplied.is_err()) { out.destroy(); base.destroy(); return multiplied; } budget.max_work -= cost; out.destroy(); out = multiplied.unwrap();
            }
            left = left >> 1; if (left != 0) {
                let cost: u64 = (base.limbs.len() as u64)*(base.limbs.len() as u64)+2*(base.limbs.len() as u64);
                if (cost > budget.max_work) { out.destroy(); base.destroy(); return core::result::Err(Error::WorkLimit); }
                let squared: core::result::Result<BigUint,Error> = base.mul(base.borrow(),budget); if (squared.is_err()) { out.destroy(); base.destroy(); return squared; } budget.max_work -= cost; base.destroy(); base = squared.unwrap();
            }
        } base.destroy(); return core::result::Ok(out);
    }
    pub fn gcd(&self, other: &BigUint, limits: Limits) -> core::result::Result<BigUint,Error> {
        let ac: core::result::Result<BigUint,Error> = self.try_clone(limits); if (ac.is_err()) { return ac; } let a: BigUint = ac.unwrap();
        let bc: core::result::Result<BigUint,Error> = other.try_clone(limits); if (bc.is_err()) { a.destroy(); return bc; } let b: BigUint = bc.unwrap(); let budget: Limits = limits;
        while (!b.is_zero()) {
            let cost: u64 = division_work(a.limbs.len(),b.limbs.len());
            let divided: core::result::Result<DivRem,Error> = a.div_rem(b.borrow(),budget); if (divided.is_err()) { a.destroy(); b.destroy(); return core::result::Err(divided.unwrap_err()); } budget.max_work -= cost;
            let pair: DivRem = divided.unwrap(); pair.quotient.destroy(); a.destroy(); a = b; b = pair.remainder;
        } b.destroy(); return core::result::Ok(a);
    }
    // Left-to-right square and multiply, reducing after every product. The
    // remaining work budget covers each product and each Knuth reduction.
    pub fn mod_pow(&self, exponent: &BigUint, modulus: &BigUint, limits: Limits) -> core::result::Result<BigUint,Error> {
        if (!valid(limits)) { return core::result::Err(Error::Bounds); } if (modulus.is_zero()) { return core::result::Err(Error::DivisionByZero); }
        let reduced: core::result::Result<DivRem,Error> = self.div_rem(modulus,limits); if (reduced.is_err()) { return core::result::Err(reduced.unwrap_err()); }
        let pair: DivRem = reduced.unwrap(); pair.quotient.destroy(); let base: BigUint = pair.remainder; let budget: Limits = limits;
        budget.max_work -= division_work(self.limbs.len(),modulus.limbs.len());
        let out: BigUint = zero();
        if (modulus.limbs.len() != 1 || modulus.get(0) != 1) { let one: core::result::Result<BigUint,Error> = from_u64(1,limits); if (one.is_err()) { base.destroy(); return one; } out = one.unwrap(); }
        let bit: u64 = exponent.bit_length();
        while (bit > 0) {
            bit -= 1;
            let cost: u64 = mul_mod_work(out.borrow(),out.borrow(),modulus);
            let squared: core::result::Result<BigUint,Error> = mul_mod(out.borrow(),out.borrow(),modulus,budget); if (squared.is_err()) { out.destroy(); base.destroy(); return squared; }
            budget.max_work -= cost; out.destroy(); out = squared.unwrap();
            if (exponent.bit(bit)) {
                let cost_base: u64 = mul_mod_work(out.borrow(),base.borrow(),modulus);
                let multiplied: core::result::Result<BigUint,Error> = mul_mod(out.borrow(),base.borrow(),modulus,budget); if (multiplied.is_err()) { out.destroy(); base.destroy(); return multiplied; }
                budget.max_work -= cost_base; out.destroy(); out = multiplied.unwrap();
            }
        }
        base.destroy(); return core::result::Ok(out);
    }
    pub fn value_hash(&self) -> u32 {
        let state: u32 = core::hash::FNV1A_OFFSET_BASIS; let index: i32 = 0;
        while (index < self.limbs.len()) { let word: u32 = self.get(index); let byte: i32 = 0; while (byte < 4) { state = core::hash::fnv1a_step(state,((word >> (byte*8)) & 255) as u8); byte += 1; } index += 1; } return state;
    }
}

// Trait arguments are temporary read handles. Their unique owners must stay
// live and frozen for every collection/sort operation retaining these handles.
pub impl core::cmp::Eq<BigUint> for BigUint {
    pub fn eq(left: BigUint, right: BigUint) -> bool { return left.compare(right.borrow()) == 0; }
    pub fn ne(left: BigUint, right: BigUint) -> bool { return left.compare(right.borrow()) != 0; }
}
pub impl core::cmp::Ord<BigUint> for BigUint {
    pub fn lt(left: BigUint, right: BigUint) -> bool { return left.compare(right.borrow()) < 0; }
    pub fn le(left: BigUint, right: BigUint) -> bool { return left.compare(right.borrow()) <= 0; }
    pub fn gt(left: BigUint, right: BigUint) -> bool { return left.compare(right.borrow()) > 0; }
    pub fn ge(left: BigUint, right: BigUint) -> bool { return left.compare(right.borrow()) >= 0; }
}
pub impl core::cmp::PartialEq<BigUint> for BigUint {
    pub fn partial_eq(left: BigUint, right: BigUint) -> bool { return left.compare(right.borrow()) == 0; }
    pub fn partial_ne(left: BigUint, right: BigUint) -> bool { return left.compare(right.borrow()) != 0; }
}
pub impl core::cmp::PartialOrd<BigUint> for BigUint {
    pub fn partial_lt(left: BigUint, right: BigUint) -> bool { return left.compare(right.borrow()) < 0; }
    pub fn partial_le(left: BigUint, right: BigUint) -> bool { return left.compare(right.borrow()) <= 0; }
    pub fn partial_gt(left: BigUint, right: BigUint) -> bool { return left.compare(right.borrow()) > 0; }
    pub fn partial_ge(left: BigUint, right: BigUint) -> bool { return left.compare(right.borrow()) >= 0; }
    pub fn partial_cmp(left: BigUint, right: BigUint) -> core::cmp::PartialOrdering { let order: i32 = left.compare(right.borrow()); if (order < 0) { return core::cmp::Less; } if (order > 0) { return core::cmp::Greater; } return core::cmp::Equal; }
}
pub impl core::hash::Hash<BigUint> for BigUint { pub fn hash(value: BigUint) -> u32 { return value.value_hash(); } }

// ---- Subquadratic division, radix conversion and modular inverse ----
// Internal steps record the first failure in Ctx and return zero owners, so
// each routine stays straight-line; every owner is still destroyed exactly once.
struct Ctx { limits: Limits, health: core::lifecycle::Health, error: Error }
impl Ctx { fn borrow(&self) -> &Ctx { return self; } }
fn context(limits: Limits) -> Ctx { return Ctx { limits: Limits { max_limbs: 536870911, max_work: 18446744073709551615, max_output: limits.max_output }, health: core::lifecycle::health_start(), error: Error::Bounds }; }
fn keep(c: &Ctx, value: core::result::Result<BigUint,Error>) -> BigUint {
    if (value.is_err()) { if (!c.health.is_failed()) { c.health.fail(); c.error = value.unwrap_err(); } return zero(); } return value.unwrap();
}
fn keep_pair(c: &Ctx, value: core::result::Result<DivRem,Error>) -> DivRem {
    if (value.is_err()) { if (!c.health.is_failed()) { c.health.fail(); c.error = value.unwrap_err(); } return DivRem { quotient: zero(), remainder: zero() }; } return value.unwrap();
}
fn flag(c: &Ctx, error: Error) { if (!c.health.is_failed()) { c.health.fail(); c.error = error; } }
fn one(c: &Ctx) -> BigUint { return keep(c,from_u64(1,c.limits)); }
impl BigUint {
    // Limbs [from, from+count) as a new normalized owner.
    fn window(&self, from: i32, count: i32, limits: Limits) -> core::result::Result<BigUint,Error> {
        let end: i32 = from+count; if (end > self.limbs.len()) { end = self.limbs.len(); } let size: i32 = end-from; if (size < 0) { size = 0; }
        let made: core::result::Result<BigUint,Error> = fresh(size,limits); if (made.is_err()) { return made; } let out: BigUint = made.unwrap();
        let os: [u32] = out.limbs.as_slice(); let xs: [u32] = self.limbs.as_slice(); let i: i32 = 0; while (i < size) { os[i] = xs[from+i]; i += 1; }
        out.normalize(); return core::result::Ok(out);
    }
    // self mod 2^bits.
    fn low_bits(&self, bits: u64, limits: Limits) -> core::result::Result<BigUint,Error> {
        let whole: u64 = bits/32; if (whole >= self.limbs.len() as u64) { return self.try_clone(limits); }
        let extra: i32 = 0; if (bits%32 != 0) { extra = 1; }
        let made: core::result::Result<BigUint,Error> = self.window(0,(whole as i32)+extra,limits); if (made.is_err()) { return made; } let out: BigUint = made.unwrap();
        if (extra != 0 && out.limbs.len() > (whole as i32)) { let os: [u32] = out.limbs.as_slice(); os[whole as i32] = os[whole as i32] & ((1 << ((bits%32) as i32))-1) as u32; }
        out.normalize(); return core::result::Ok(out);
    }
}
fn decrement(c: &Ctx, value: BigUint) -> BigUint { let unit: BigUint = one(c); let out: BigUint = keep(c,value.sub(unit.borrow(),c.limits)); unit.destroy(); value.destroy(); return out; }
// Burnikel-Ziegler (as in CPython's _pylong): a < b*2^n and b has exactly n bits.
fn div2n1n(c: &Ctx, a: &BigUint, b: &BigUint, n: u64) -> DivRem {
    if (c.health.is_failed()) { return DivRem { quotient: zero(), remainder: zero() }; }
    let limit: u64 = (BURNIKEL_ZIEGLER_THRESHOLD as u64)*32;
    if (n < limit || a.bit_length() < n+limit) { return keep_pair(c,a.div_rem_basic(b,c.limits)); }
    if ((n & 1) == 0) { return div2n1n_even(c,a,b,n); }
    let aa: BigUint = keep(c,a.shl(1,c.limits)); let bb: BigUint = keep(c,b.shl(1,c.limits));
    let pair: DivRem = div2n1n_even(c,aa.borrow(),bb.borrow(),n+1); aa.destroy(); bb.destroy();
    let rem: BigUint = keep(c,pair.remainder.shr(1,c.limits)); pair.remainder.destroy();
    return DivRem { quotient: pair.quotient, remainder: rem };
}
fn div2n1n_even(c: &Ctx, a: &BigUint, b: &BigUint, n: u64) -> DivRem {
    let half: u64 = n >> 1;
    let b1: BigUint = keep(c,b.shr(half,c.limits)); let b2: BigUint = keep(c,b.low_bits(half,c.limits));
    let a_hi: BigUint = keep(c,a.shr(n,c.limits)); let a_shift: BigUint = keep(c,a.shr(half,c.limits)); let a_mid: BigUint = keep(c,a_shift.low_bits(half,c.limits)); a_shift.destroy();
    let first: DivRem = div3n2n(c,a_hi.borrow(),a_mid.borrow(),b,b1.borrow(),b2.borrow(),half); a_hi.destroy(); a_mid.destroy();
    let a_lo: BigUint = keep(c,a.low_bits(half,c.limits));
    let second: DivRem = div3n2n(c,first.remainder.borrow(),a_lo.borrow(),b,b1.borrow(),b2.borrow(),half); a_lo.destroy(); first.remainder.destroy(); b2.destroy(); b1.destroy();
    let high: BigUint = keep(c,first.quotient.shl(half,c.limits)); first.quotient.destroy();
    let quotient: BigUint = keep(c,high.add(second.quotient.borrow(),c.limits)); high.destroy(); second.quotient.destroy();
    return DivRem { quotient: quotient, remainder: second.remainder };
}
// [a12, a3] / b where b = b1*2^n + b2 and a12 < b*2^n; at most two corrections.
fn div3n2n(c: &Ctx, a12: &BigUint, a3: &BigUint, b: &BigUint, b1: &BigUint, b2: &BigUint, n: u64) -> DivRem {
    let top: BigUint = keep(c,a12.shr(n,c.limits)); let q: BigUint = zero(); let r: BigUint = zero();
    if (top.compare(b1) == 0) {
        let unit: BigUint = one(c); let power: BigUint = keep(c,unit.shl(n,c.limits)); q = keep(c,power.sub(unit.borrow(),c.limits)); power.destroy(); unit.destroy();
        let shifted: BigUint = keep(c,b1.shl(n,c.limits)); let diff: BigUint = keep(c,a12.sub(shifted.borrow(),c.limits)); shifted.destroy(); r = keep(c,diff.add(b1,c.limits)); diff.destroy();
    } else { let pair: DivRem = div2n1n(c,a12,b1,n); q = pair.quotient; r = pair.remainder; }
    top.destroy();
    let shifted_r: BigUint = keep(c,r.shl(n,c.limits)); r.destroy(); let rr: BigUint = keep(c,shifted_r.add(a3,c.limits)); shifted_r.destroy();
    let t: BigUint = keep(c,q.mul(b2,c.limits));
    while (!c.health.is_failed() && rr.compare(t.borrow()) < 0) { q = decrement(c,q); let grown: BigUint = keep(c,rr.add(b,c.limits)); rr.destroy(); rr = grown; }
    let out: BigUint = keep(c,rr.sub(t.borrow(),c.limits)); rr.destroy(); t.destroy();
    return DivRem { quotient: q, remainder: out };
}
// Normalize b to a whole number of limbs, then divide n-bit chunks of a from the top.
fn fast_div(a: &BigUint, b: &BigUint, limits: Limits) -> core::result::Result<DivRem,Error> {
    let state: Ctx = context(limits); let c: &Ctx = state.borrow();
    let shift: u64 = (32-(b.bit_length()%32))%32;
    let bn: BigUint = keep(c,b.shl(shift,c.limits)); let an: BigUint = keep(c,a.shl(shift,c.limits));
    let n: u64 = bn.bit_length(); let width: i32 = (n/32) as i32; let chunks: i32 = (an.limbs.len()+width-1)/width;
    let quotient: BigUint = keep(c,fresh(chunks*width,c.limits)); let r: BigUint = zero(); let index: i32 = chunks-1;
    let top: BigUint = keep(c,an.window(index*width,width,c.limits));
    if (top.compare(bn.borrow()) < 0) { r = top; index -= 1; } else { top.destroy(); }
    while (index >= 0 && !c.health.is_failed()) {
        let digit: BigUint = keep(c,an.window(index*width,width,c.limits));
        let shifted: BigUint = keep(c,r.shl(n,c.limits)); r.destroy(); let combined: BigUint = keep(c,shifted.add(digit.borrow(),c.limits)); shifted.destroy(); digit.destroy();
        let pair: DivRem = div2n1n(c,combined.borrow(),bn.borrow(),n); combined.destroy();
        if (!c.health.is_failed()) { let qs: [u32] = quotient.limbs.as_slice(); let ps: [u32] = pair.quotient.limbs.as_slice(); let i: i32 = 0; while (i < pair.quotient.limbs.len()) { qs[index*width+i] = ps[i]; i += 1; } }
        pair.quotient.destroy(); r = pair.remainder; index -= 1;
    }
    quotient.normalize(); let rem: BigUint = keep(c,r.shr(shift,c.limits)); r.destroy(); an.destroy(); bn.destroy();
    if (!c.health.is_failed() && (quotient.limbs.len() > limits.max_limbs || rem.limbs.len() > limits.max_limbs)) { flag(c,Error::LimbLimit); }
    if (c.health.is_failed()) { quotient.destroy(); rem.destroy(); return core::result::Err(c.error); }
    return core::result::Ok(DivRem { quotient: quotient, remainder: rem });
}
// powers[i] = (radix^g)^(2^i). Stops after `levels` entries, or (levels == 0)
// at the first entry whose square exceeds any value of `cover` limbs.
fn radix_powers(c: &Ctx, radix: i32, levels: i32, cover: i32) -> alloc::vec::Vec<BigUint> {
    let powers: alloc::vec::Vec<BigUint> = alloc::vec::new(); let base: u64 = 1; let g: i32 = 0; while (g < chunk_digits(radix)) { base = base*(radix as u64); g += 1; }
    let current: BigUint = keep(c,from_u64(base,c.limits)); let level: i32 = 0;
    while (true) {
        if (powers.try_push(current).is_err()) { current.destroy(); flag(c,Error::AllocationFailed); return powers; }
        level += 1; if (c.health.is_failed() || (levels > 0 && level >= levels) || (levels == 0 && 2*(current.limbs.len()-1) >= cover)) { break; }
        current = keep(c,current.mul(current.borrow(),c.limits));
    }
    return powers;
}
fn destroy_powers(powers: alloc::vec::Vec<BigUint>) { let i: i32 = 0; while (i < powers.len()) { let p: BigUint = powers.at(i); p.destroy(); i += 1; } powers.destroy(); }
fn push_zeros(c: &Ctx, out: &alloc::vec::Vec<u8>, count: i32) {
    let i: i32 = 0; while (i < count && !c.health.is_failed()) { if (out.len() >= c.limits.max_output) { flag(c,Error::OutputLimit); return; } if (out.try_push(48).is_err()) { flag(c,Error::AllocationFailed); return; } i += 1; }
}
// Appends x in radix; width > 0 left-pads to exactly width digits. Requires
// x < powers[level+1] (or x < radix^g when level is -1).
fn emit(c: &Ctx, out: &alloc::vec::Vec<u8>, x: &BigUint, level: i32, width: i32, radix: i32, powers: &alloc::vec::Vec<BigUint>) {
    if (c.health.is_failed()) { return; }
    if (level < 0 || x.limbs.len() <= CONVERSION_THRESHOLD) {
        if (width > 0 && x.is_zero()) { push_zeros(c,out,width); return; }
        let formatted: core::result::Result<alloc::vec::Vec<u8>,Error> = x.format_basic(radix,c.limits);
        if (formatted.is_err()) { flag(c,formatted.unwrap_err()); return; } let digits: alloc::vec::Vec<u8> = formatted.unwrap();
        if (width > digits.len()) { push_zeros(c,out,width-digits.len()); }
        let i: i32 = 0; while (i < digits.len() && !c.health.is_failed()) { if (out.len() >= c.limits.max_output) { flag(c,Error::OutputLimit); } else { if (out.try_push(digits.at(i)).is_err()) { flag(c,Error::AllocationFailed); } } i += 1; }
        digits.destroy(); return;
    }
    let power: BigUint = powers.at(level); let half: i32 = 0; if (width > 0) { half = width/2; }
    let low_width: i32 = chunk_digits(radix); let k: i32 = 0; while (k < level) { low_width = low_width*2; k += 1; }
    if (x.compare(power.borrow()) < 0) { if (width > 0) { push_zeros(c,out,width-low_width); emit(c,out,x,level-1,low_width,radix,powers); } else { emit(c,out,x,level-1,0,radix,powers); } return; }
    let pair: DivRem = keep_pair(c,x.div_rem(power.borrow(),c.limits));
    if (width > 0) { emit(c,out,pair.quotient.borrow(),level-1,width-low_width,radix,powers); } else { emit(c,out,pair.quotient.borrow(),level-1,0,radix,powers); }
    emit(c,out,pair.remainder.borrow(),level-1,low_width,radix,powers); pair.destroy();
}
// value = hi * radix^(g*2^j) + lo over the digit string.
fn parse_dc(c: &Ctx, input: core::slice::View<u8>, from: i32, count: i32, radix: i32, powers: &alloc::vec::Vec<BigUint>) -> BigUint {
    if (c.health.is_failed()) { return zero(); }
    let part: core::slice::View<u8> = core::slice::View { values: input.values, start: input.start+from, length: count };
    if (count <= PARSE_DC_DIGITS) { return keep(c,parse_basic(part,radix,c.limits)); }
    let low: i32 = chunk_digits(radix); let j: i32 = 0; while (low*2 < count) { low = low*2; j += 1; }
    let high: BigUint = parse_dc(c,input,from,count-low,radix,powers); let rest: BigUint = parse_dc(c,input,from+count-low,low,radix,powers);
    let power: BigUint = powers.at(j); let scaled: BigUint = keep(c,high.mul(power.borrow(),c.limits)); high.destroy();
    let value: BigUint = keep(c,scaled.add(rest.borrow(),c.limits)); scaled.destroy(); rest.destroy(); return value;
}
fn conversion_work(digits: u64, radix: i32, limbs: u64) -> u64 { return (digits/(chunk_digits(radix) as u64)+1)*(limbs+1)+digits; }
// log2(radix) for power-of-two radices, else 0.
fn radix_shift(radix: i32) -> i32 { if (radix == 2) { return 1; } if (radix == 4) { return 2; } if (radix == 8) { return 3; } if (radix == 16) { return 4; } if (radix == 32) { return 5; } return 0; }
// Power-of-two radices pack bits directly: linear time in the digit count.
fn parse_bits(input: core::slice::View<u8>, radix: i32, limits: Limits) -> core::result::Result<BigUint,Error> {
    let shift: i32 = radix_shift(radix); let index: i32 = 0;
    while (index < input.length) { if (digit(input.values[input.start+index]) >= radix) { return core::result::Err(Error::InvalidDigit); } index += 1; }
    let skip: i32 = 0; while (skip < input.length && input.values[input.start+skip] == 48) { skip += 1; }
    let bits: u64 = ((input.length-skip) as u64)*(shift as u64); let count: u64 = (bits+31)/32;
    if (count > limits.max_limbs as u64) { return core::result::Err(Error::LimbLimit); }
    let made: core::result::Result<BigUint,Error> = fresh(count as i32,limits); if (made.is_err()) { return made; } let out: BigUint = made.unwrap();
    let os: [u32] = out.limbs.as_slice(); let position: u64 = 0; index = input.length;
    while (index > skip) {
        index -= 1; let value: u64 = digit(input.values[input.start+index]) as u64; let limb: i32 = (position/32) as i32; let offset: u64 = position%32;
        os[limb] = os[limb] | ((value << offset) as u32); if (offset+(shift as u64) > 32) { os[limb+1] = os[limb+1] | ((value >> (32-offset)) as u32); }
        position += shift as u64;
    }
    out.normalize(); return core::result::Ok(out);
}
pub fn parse(input: core::slice::View<u8>, radix: i32, limits: Limits) -> core::result::Result<BigUint,Error> {
    if (radix_shift(radix) != 0 && input.length > PARSE_DC_DIGITS && valid(limits) && input.start >= 0 && input.start <= 2147483647-input.length) {
        if ((input.length as u64) > limits.max_work) { return core::result::Err(Error::WorkLimit); } return parse_bits(input,radix,limits);
    }
    if (input.length <= PARSE_DC_DIGITS || !valid(limits) || radix < 2 || radix > 36 || input.start < 0 || input.start > 2147483647-input.length) { return parse_basic(input,radix,limits); }
    let index: i32 = 0; while (index < input.length) { if (digit(input.values[input.start+index]) >= radix) { return core::result::Err(Error::InvalidDigit); } index += 1; }
    let digit_bits: u64 = 1; while ((1 << digit_bits) < (radix as u64)) { digit_bits += 1; }
    let estimate: u64 = (input.length as u64)*digit_bits/32+1;
    // Charged as the basecase bound, so a limit admits the same inputs on either path.
    if (conversion_work(input.length as u64,radix,estimate) > limits.max_work) { return core::result::Err(Error::WorkLimit); }
    let levels: i32 = 1; let span: i32 = chunk_digits(radix); while (span*2 < input.length) { span = span*2; levels += 1; }
    let state: Ctx = context(limits); let c: &Ctx = state.borrow();
    let powers: alloc::vec::Vec<BigUint> = radix_powers(c,radix,levels,0);
    let value: BigUint = parse_dc(c,input,0,input.length,radix,powers.borrow()); destroy_powers(powers);
    if (!c.health.is_failed() && value.limbs.len() > limits.max_limbs) { flag(c,Error::LimbLimit); }
    if (c.health.is_failed()) { value.destroy(); return core::result::Err(c.error); } return core::result::Ok(value);
}
pub impl BigUint {
    pub fn div_rem(&self, other: &BigUint, limits: Limits) -> core::result::Result<DivRem,Error> {
        if (valid(limits) && !other.is_zero() && other.limbs.len() >= BURNIKEL_ZIEGLER_THRESHOLD && self.limbs.len() >= other.limbs.len()+BURNIKEL_ZIEGLER_THRESHOLD) {
            let checked: core::result::Result<i32,Error> = guard(limits,self.limbs.len(),division_work(self.limbs.len(),other.limbs.len())); if (checked.is_err()) { return core::result::Err(checked.unwrap_err()); }
            if (other.limbs.len() > limits.max_limbs) { return core::result::Err(Error::LimbLimit); }
            return fast_div(self,other,limits);
        }
        return self.div_rem_basic(other,limits);
    }
    pub fn format_radix(&self, radix: i32, limits: Limits) -> core::result::Result<alloc::vec::Vec<u8>,Error> {
        if (self.limbs.len() <= CONVERSION_THRESHOLD || !valid(limits) || radix < 2 || radix > 36 || limits.max_output == 0) { return self.format_basic(radix,limits); }
        if (radix_shift(radix) != 0) { return self.format_bits(radix,limits); }
        let digit_bits: u64 = 0; let radix_power: i32 = radix; while (radix_power > 1) { digit_bits += 1; radix_power = radix_power >> 1; }
        let digits: u64 = self.bit_length()/digit_bits+1;
        if (conversion_work(digits,radix,self.limbs.len() as u64) > limits.max_work) { return core::result::Err(Error::WorkLimit); }
        let state: Ctx = context(limits); let c: &Ctx = state.borrow();
        // Square until powers[last]^2 exceeds self.
        let powers: alloc::vec::Vec<BigUint> = radix_powers(c,radix,0,self.limbs.len()); let top: i32 = powers.len()-1;
        let output: alloc::vec::Vec<u8> = alloc::vec::new(); let reserve: u64 = digits; if (reserve > limits.max_output as u64) { reserve = limits.max_output as u64; }
        if (output.try_reserve(reserve as i32).is_err()) { flag(c,Error::AllocationFailed); }
        emit(c,output.borrow(),self,top,0,radix,powers.borrow()); destroy_powers(powers);
        if (c.health.is_failed()) { output.destroy(); return core::result::Err(c.error); } return core::result::Ok(output);
    }
    // Power-of-two radix: read digits straight from the bits, most significant first.
    fn format_bits(&self, radix: i32, limits: Limits) -> core::result::Result<alloc::vec::Vec<u8>,Error> {
        let shift: u64 = radix_shift(radix) as u64; let count: u64 = (self.bit_length()+shift-1)/shift;
        if ((self.limbs.len() as u64) > limits.max_work) { return core::result::Err(Error::WorkLimit); }
        if (count > limits.max_output as u64) { return core::result::Err(Error::OutputLimit); }
        let output: alloc::vec::Vec<u8> = alloc::vec::new(); if (output.try_reserve(count as i32).is_err()) { return core::result::Err(Error::AllocationFailed); }
        let xs: [u32] = self.limbs.as_slice(); let length: i32 = self.limbs.len(); let index: u64 = count;
        while (index > 0) {
            index -= 1; let position: u64 = index*shift; let limb: i32 = (position/32) as i32; let offset: u64 = position%32;
            let wide: u64 = (xs[limb] as u64) >> offset; if (offset+shift > 32 && limb+1 < length) { wide = wide | ((xs[limb+1] as u64) << (32-offset)); }
            let value: u32 = (wide & ((1 << shift)-1)) as u32; let byte: u8 = (value+48) as u8; if (value >= 10) { byte = (value+87) as u8; }
            if (output.try_push(byte).is_err()) { output.destroy(); return core::result::Err(Error::AllocationFailed); }
        }
        return core::result::Ok(output);
    }
    // Inverse of self modulo modulus by the extended Euclidean algorithm over
    // magnitudes: r_i is congruent to (-1)^(i+1) * u_i * self.
    pub fn mod_inverse(&self, modulus: &BigUint, limits: Limits) -> core::result::Result<BigUint,Error> {
        if (!valid(limits)) { return core::result::Err(Error::Bounds); } if (modulus.is_zero()) { return core::result::Err(Error::DivisionByZero); }
        if (modulus.limbs.len() == 1 && modulus.get(0) == 1) { return core::result::Ok(zero()); }
        let state: Ctx = Ctx { limits: limits, health: core::lifecycle::health_start(), error: Error::Bounds }; let c: &Ctx = state.borrow();
        let reduced: DivRem = keep_pair(c,self.div_rem(modulus,limits)); reduced.quotient.destroy();
        let r0: BigUint = keep(c,modulus.try_clone(limits)); let r1: BigUint = reduced.remainder; let u0: BigUint = zero(); let u1: BigUint = one(c); let odd: bool = true;
        let budget: u64 = limits.max_work;
        while (!c.health.is_failed() && !r1.is_zero() && !(r1.limbs.len() == 1 && r1.get(0) == 1)) {
            let cost: u64 = division_work(r0.limbs.len(),r1.limbs.len())+(r0.limbs.len() as u64)*(u1.limbs.len() as u64+1);
            if (cost > budget) { flag(c,Error::WorkLimit); break; } budget -= cost;
            let step: DivRem = keep_pair(c,r0.div_rem(r1.borrow(),limits));
            let product: BigUint = keep(c,step.quotient.mul(u1.borrow(),limits)); step.quotient.destroy();
            let u2: BigUint = keep(c,u0.add(product.borrow(),limits)); product.destroy();
            r0.destroy(); r0 = r1; r1 = step.remainder; u0.destroy(); u0 = u1; u1 = u2; odd = !odd;
        }
        if (!c.health.is_failed() && r1.is_zero()) { flag(c,Error::NotInvertible); }
        let result: BigUint = zero();
        if (!c.health.is_failed()) { if (odd) { result = u1; u1 = zero(); } else { result = keep(c,modulus.sub(u1.borrow(),limits)); } }
        r0.destroy(); r1.destroy(); u0.destroy(); u1.destroy();
        if (c.health.is_failed()) { result.destroy(); return core::result::Err(c.error); } return core::result::Ok(result);
    }
}
