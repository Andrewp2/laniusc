// Opt-in ordered-set memory-owner cloning and explicit recursive release.
// Ordinary TreeSet.try_clone/destroy keep their shallow ownership contracts.
module alloc::clone_tree_set;
import alloc::tree_map;
import alloc::tree_set;
import core::clone;
import core::cmp;
import core::iter;
import core::option;
import core::result;

pub enum Error<E> { Storage(alloc::tree_map::Error), Element(i32,E), ChangedKey(i32) }

// Every live key must be one distinct active memory owner. The cursor follows
// integer links without comparing released keys. Destroy must not reenter or
// mutate this set through another alias. Old borrowed keys/cursors expire.
// Reset the actual owner; repeated release of that reset owner is harmless.
pub fn destroy_tree_set<T>(owner: &alloc::tree_set::TreeSet<T>)
    where T: core::clone::Destroy<T> {
    let cursor: alloc::tree_set::Cursor<T> = owner.iter();
    while (true) {
        let next: core::option::Option<T> = cursor.next();
        if (next.is_none()) { break; }
        T::destroy_value(next.unwrap());
    }
    owner.destroy();
}

// Recover and disarm the owning cursor, then release only its unconsumed keys.
// Yielded/rejected keys remain their callers' separate ownership obligation.
pub fn destroy_tree_set_iter<T>(owner: &alloc::tree_set::IntoIter<T>)
    where T: core::clone::Destroy<T> {
    let remaining: alloc::tree_set::TreeSet<T> = owner.take_remaining();
    destroy_tree_set<T>(remaining.borrow());
}

// Reserve final node storage before leaf calls. Visit live keys in sorted
// logical order, excluding holes. Stable lawful Eq/Ord and read-only source
// aliases are required. Each successful clone is an independent key owner.
// Checked insertion reuses reserved nodes: O(n log n) work, no scratch owner.
// E transfers unchanged and cannot borrow a partial destination we release.
pub fn try_clone<T,E>(source: &alloc::tree_set::TreeSet<T>)
    -> core::result::Result<alloc::tree_set::TreeSet<T>,Error<E>>
    where T: core::cmp::Ord<T>, T: core::cmp::Eq<T>,
          T: core::clone::TryClone<T,E>, T: core::clone::Destroy<T> {
    let made: core::result::Result<alloc::tree_set::TreeSet<T>,alloc::tree_map::Error> = alloc::tree_set::with_capacity<T>(source.len());
    if (made.is_err()) { return core::result::Err(Error::Storage(made.unwrap_err())); }
    let output: alloc::tree_set::TreeSet<T> = made.unwrap();
    let cursor: alloc::tree_set::Cursor<T> = source.iter(); let index: i32 = 0;
    while (index < source.len()) {
        let borrowed: T = cursor.next().unwrap();
        let cloned: core::result::Result<T,E> = T::try_clone_value(borrowed);
        if (cloned.is_err()) {
            let error: E = cloned.unwrap_err(); destroy_tree_set<T>(output.borrow());
            return core::result::Err(Error::Element(index,error));
        }
        let key: T = cloned.unwrap();
        if (!T::eq(borrowed,key) || T::lt(borrowed,key) || T::lt(key,borrowed)) {
            T::destroy_value(key); destroy_tree_set<T>(output.borrow());
            return core::result::Err(Error::ChangedKey(index));
        }
        // A lawful clone preserves strict source order. Reject a changed
        // adjacent relation before insertion rather than silently collapsing
        // two independently owned clones into one representative.
        let previous: core::option::Option<T> = output.last();
        if (previous.is_some()) {
            if (!T::lt(previous.unwrap(),key)) {
                T::destroy_value(key); destroy_tree_set<T>(output.borrow());
                return core::result::Err(Error::ChangedKey(index));
            }
        }
        let inserted: core::result::Result<core::option::Option<T>,alloc::tree_map::Error> = output.try_insert(key);
        if (inserted.is_err()) {
            let error: alloc::tree_map::Error = inserted.unwrap_err(); T::destroy_value(key);
            destroy_tree_set<T>(output.borrow()); return core::result::Err(Error::Storage(error));
        }
        let rejected: core::option::Option<T> = inserted.unwrap();
        if (rejected.is_some()) {
            T::destroy_value(rejected.unwrap()); destroy_tree_set<T>(output.borrow());
            return core::result::Err(Error::ChangedKey(index));
        }
        index+=1;
    }
    return core::result::Ok(output);
}

pub impl<T,E> core::clone::TryClone<alloc::tree_set::TreeSet<T>,Error<E>>
    for alloc::tree_set::TreeSet<T>
    where T: core::cmp::Ord<T>, T: core::cmp::Eq<T>,
          T: core::clone::TryClone<T,E>, T: core::clone::Destroy<T> {
    pub fn try_clone_value(source: alloc::tree_set::TreeSet<T>)
        -> core::result::Result<alloc::tree_set::TreeSet<T>,Error<E>> {
        return try_clone<T,E>(source.borrow());
    }
}
pub impl<T> core::clone::Destroy<alloc::tree_set::TreeSet<T>> for alloc::tree_set::TreeSet<T>
    where T: core::clone::Destroy<T> {
    pub fn destroy_value(owned: alloc::tree_set::TreeSet<T>) { destroy_tree_set<T>(owned.borrow()); }
}
