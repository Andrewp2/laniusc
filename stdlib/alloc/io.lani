// An owned byte sink for core::io. Writes append atomically, including views
// into this buffer. Allocation or limit errors preserve the previous bytes.
module alloc::io;
import core::io;
import core::option;
import core::result;
import core::slice;
import alloc::string;
import alloc::vec;

// Bounded whole-input collection borrows the reader and keeps every confirmed
// prefix byte on failure. Copies of returned owners are shallow aliases.
pub struct ReadLimits { max_bytes: i32, max_calls: u64 }
pub enum ReadError {
    InvalidLimits,
    CallLimit,
    ByteLimit,
    Io(core::io::Error),
    Storage(alloc::vec::Error),
    Text(alloc::string::Error),
}
pub struct ReadFailure {
    cause: ReadError,
    bytes: alloc::vec::Vec<u8>,
    calls: u64,
    extra: core::option::Option<u8>,
}

pub fn default_read_limits() -> ReadLimits {
    return ReadLimits { max_bytes: 16777216, max_calls: 65536 };
}

pub impl ReadFailure {
    pub fn borrow(&self) -> &ReadFailure { return self; }
    // Release only the retained allocation. Historical cause/call/probe facts
    // remain inspectable; Vec::destroy leaves the byte owner empty/reusable.
    pub fn destroy(&self) { self.bytes.destroy(); }
}

struct ReadCollected { bytes: alloc::vec::Vec<u8>, calls: u64 }

fn read_failure(cause: ReadError, bytes: alloc::vec::Vec<u8>, calls: u64)
    -> ReadFailure {
    return ReadFailure { cause: cause, bytes: bytes, calls: calls, extra: core::option::None() };
}

// The caller establishes wanted <= maximum - len. Reserve the complete next
// request before input can be consumed, with capped geometric growth.
fn reserve_read(bytes: &alloc::vec::Vec<u8>, wanted: i32, maximum: i32)
    -> core::result::Result<i32, alloc::vec::Error> {
    let needed: i32 = bytes.len() + wanted;
    let capacity: i32 = bytes.capacity();
    if (needed <= capacity) { return core::result::Ok(capacity); }
    let target: i32 = maximum;
    if (capacity <= maximum / 2) { target = capacity * 2; }
    if (target < needed) { target = needed; }
    return bytes.try_reserve(target - bytes.len());
}

fn collect_input<R>(reader: &R, limits: ReadLimits)
    -> core::result::Result<ReadCollected, ReadFailure> where R: core::io::Read {
    let bytes: alloc::vec::Vec<u8> = alloc::vec::new();
    let calls: u64 = 0;
    if (limits.max_bytes < 0) {
        return core::result::Err(read_failure(ReadError::InvalidLimits, bytes, calls));
    }
    let scratch: [u8; 1024] = [0; 1024];
    let probe: [u8; 1] = [0];
    while (true) {
        // Quota rejection precedes reservation and the actual call is charged
        // before delegation, including EOF, Interrupted and the cap probe.
        if (calls >= limits.max_calls) {
            return core::result::Err(read_failure(ReadError::CallLimit, bytes, calls));
        }
        let remaining: i32 = limits.max_bytes - bytes.len();
        let probing: bool = remaining == 0;
        let wanted: i32 = 1;
        if (!probing) {
            wanted = remaining;
            if (wanted > 1024) { wanted = 1024; }
            let reserved: core::result::Result<i32, alloc::vec::Error> = reserve_read(bytes.borrow(), wanted, limits.max_bytes);
            if (core::result::is_err(reserved)) {
                let error: alloc::vec::Error = core::result::unwrap_err(reserved);
                return core::result::Err(read_failure(ReadError::Storage(error), bytes, calls));
            }
        }
        calls += 1;
        let received: core::result::Result<i32, core::io::Error> = core::result::Ok(0);
        if (probing) { received = reader.read(probe, 0, 1); }
        else { received = reader.read(scratch, 0, wanted); }
        if (core::result::is_err(received)) {
            let error: core::io::Error = core::result::unwrap_err(received);
            if (core::io::is_interrupted(error)) { continue; }
            return core::result::Err(read_failure(ReadError::Io(error), bytes, calls));
        }
        let count: i32 = core::result::unwrap(received);
        if (count < 0 || count > wanted) {
            return core::result::Err(read_failure(ReadError::Io(core::io::Error::InvalidCount), bytes, calls));
        }
        if (count == 0) {
            return core::result::Ok(ReadCollected { bytes: bytes, calls: calls });
        }
        if (probing) {
            return core::result::Err(ReadFailure {
                cause: ReadError::ByteLimit, bytes: bytes, calls: calls,
                extra: core::option::Some(probe[0]),
            });
        }
        let index: i32 = 0;
        while (index < count) {
            // The complete request is already reserved, and count is checked.
            // These pushes cannot allocate or fail at the u8 capacity bound.
            core::result::unwrap(bytes.try_push(scratch[index]));
            index += 1;
        }
    }
    return core::result::Ok(ReadCollected { bytes: bytes, calls: calls });
}

pub fn read_to_end<R>(reader: &R, limits: ReadLimits)
    -> core::result::Result<alloc::vec::Vec<u8>, ReadFailure> where R: core::io::Read {
    let result: core::result::Result<ReadCollected, ReadFailure> = collect_input(reader, limits);
    if (core::result::is_err(result)) { return core::result::Err(core::result::unwrap_err(result)); }
    let collected: ReadCollected = core::result::unwrap(result);
    return core::result::Ok(collected.bytes);
}

pub fn read_to_string<R>(reader: &R, limits: ReadLimits)
    -> core::result::Result<alloc::string::String, ReadFailure> where R: core::io::Read {
    let result: core::result::Result<ReadCollected, ReadFailure> = collect_input(reader, limits);
    if (core::result::is_err(result)) { return core::result::Err(core::result::unwrap_err(result)); }
    let collected: ReadCollected = core::result::unwrap(result);
    // EOF was observed before UTF-8 validation. Failure leaves this Vec intact;
    // success transfers its allocation and capacity and empties the Vec.
    let text: core::result::Result<alloc::string::String, alloc::string::Error> = alloc::string::from_utf8_vec(collected.bytes.borrow());
    if (core::result::is_err(text)) {
        let error: alloc::string::Error = core::result::unwrap_err(text);
        return core::result::Err(read_failure(ReadError::Text(error), collected.bytes, collected.calls));
    }
    return core::result::Ok(core::result::unwrap(text));
}

// Owned buffered records include their delimiter and retain exact direct
// fill/consume counts. Endings never imply that a provider caches EOF.
pub enum ReadEnding { Delimiter, Eof }
pub struct ReadBytes {
    bytes: alloc::vec::Vec<u8>, ending: ReadEnding, calls: u64, consumed: u64
}
pub struct ReadLine {
    text: alloc::string::String, ending: ReadEnding, calls: u64, consumed: u64
}
pub struct BufferedReadFailure {
    cause: ReadError, bytes: alloc::vec::Vec<u8>, calls: u64, consumed: u64,
    ending: core::option::Option<ReadEnding>
}

pub impl ReadBytes {
    pub fn borrow(&self) -> &ReadBytes { return self; }
    pub fn destroy(&self) { self.bytes.destroy(); }
}
pub impl ReadLine {
    pub fn borrow(&self) -> &ReadLine { return self; }
    pub fn destroy(&self) { self.text.destroy(); }
}
pub impl BufferedReadFailure {
    pub fn borrow(&self) -> &BufferedReadFailure { return self; }
    // Retained bytes may include a staged suffix not acknowledged by consume.
    // Release only backing; historical cause/ending/progress stay inspectable.
    pub fn destroy(&self) { self.bytes.destroy(); }
}

fn buffered_failure(cause: ReadError, bytes: alloc::vec::Vec<u8>, calls: u64, consumed: u64)
    -> BufferedReadFailure {
    return BufferedReadFailure {
        cause: cause, bytes: bytes, calls: calls, consumed: consumed,
        ending: core::option::None()
    };
}

// One binary engine serves arbitrary delimiters and LF text. The borrowed
// provider remains open; errors neither drain nor roll back its pending data.
fn collect_delimited<B>(reader: &B, delimiter: u8, limits: ReadLimits)
    -> core::result::Result<ReadBytes,BufferedReadFailure> where B: core::io::BufRead {
    let bytes: alloc::vec::Vec<u8> = alloc::vec::new();
    let calls: u64 = 0;
    let consumed: u64 = 0;
    if (limits.max_bytes < 0) {
        return core::result::Err(buffered_failure(ReadError::InvalidLimits,bytes,calls,consumed));
    }
    while (true) {
        if (calls >= limits.max_calls) {
            return core::result::Err(buffered_failure(ReadError::CallLimit,bytes,calls,consumed));
        }
        calls += 1;
        let filled: core::result::Result<core::slice::View<u8>,core::io::Error> = reader.fill_buf();
        if (filled.is_err()) {
            let error: core::io::Error = filled.unwrap_err();
            if (core::io::is_interrupted(error)) { continue; }
            return core::result::Err(buffered_failure(ReadError::Io(error),bytes,calls,consumed));
        }
        let available: core::slice::View<u8> = filled.unwrap();
        // Successful metadata is admitted even for an empty view or when no
        // consume call remains. No payload access precedes these checks.
        if (!core::io::valid_range(available.start,available.length)) {
            return core::result::Err(buffered_failure(ReadError::Io(core::io::Error::InvalidCount),bytes,calls,consumed));
        }
        if (available.length == 0) {
            return core::result::Ok(ReadBytes {
                bytes: bytes, ending: ReadEnding::Eof, calls: calls, consumed: consumed
            });
        }
        let remaining: i32 = limits.max_bytes-bytes.len();
        if (remaining == 0) {
            // A nonempty observation at the cap is not consumed or inspected.
            return core::result::Err(buffered_failure(ReadError::ByteLimit,bytes,calls,consumed));
        }
        if (calls >= limits.max_calls) {
            return core::result::Err(buffered_failure(ReadError::CallLimit,bytes,calls,consumed));
        }
        let amount: i32 = available.length;
        if (amount > remaining) { amount = remaining; }
        let selected: i32 = 0;
        let found: bool = false;
        while (selected < amount && !found) {
            let byte: u8 = available.values[available.start+selected];
            selected += 1;
            if (byte == delimiter) { found = true; }
        }
        let reserved: core::result::Result<i32,alloc::vec::Error> = reserve_read(bytes.borrow(),selected,limits.max_bytes);
        if (reserved.is_err()) {
            let error: alloc::vec::Error = reserved.unwrap_err();
            return core::result::Err(buffered_failure(ReadError::Storage(error),bytes,calls,consumed));
        }
        let index: i32 = 0;
        while (index < selected) {
            // Complete selection is reserved, so these checked pushes cannot
            // allocate or fail. Keep the fill borrow live through this copy.
            bytes.try_push(available.values[available.start+index]).unwrap();
            index += 1;
        }
        // No further use of available or filled: consume may invalidate them.
        calls += 1;
        let acknowledged: core::result::Result<i32,core::io::Error> = reader.consume(selected);
        if (acknowledged.is_err()) {
            let error: core::io::Error = acknowledged.unwrap_err();
            // Even Interrupted is terminal. Staged bytes are retained, without
            // claiming that this rejected request advanced logical input.
            return core::result::Err(buffered_failure(ReadError::Io(error),bytes,calls,consumed));
        }
        if (acknowledged.unwrap() != selected) {
            return core::result::Err(buffered_failure(ReadError::Io(core::io::Error::InvalidCount),bytes,calls,consumed));
        }
        consumed += selected as u64;
        if (found) {
            return core::result::Ok(ReadBytes {
                bytes: bytes, ending: ReadEnding::Delimiter, calls: calls, consumed: consumed
            });
        }
    }
    return core::result::Ok(ReadBytes {
        bytes: bytes, ending: ReadEnding::Eof, calls: calls, consumed: consumed
    });
}

pub fn read_until<B>(reader: &B, delimiter: u8, limits: ReadLimits)
    -> core::result::Result<ReadBytes,BufferedReadFailure> where B: core::io::BufRead {
    return collect_delimited(reader,delimiter,limits);
}

pub fn read_line<B>(reader: &B, limits: ReadLimits)
    -> core::result::Result<ReadLine,BufferedReadFailure> where B: core::io::BufRead {
    let result: core::result::Result<ReadBytes,BufferedReadFailure> = collect_delimited(reader,10,limits);
    if (result.is_err()) { return core::result::Err(result.unwrap_err()); }
    let record: ReadBytes = result.unwrap();
    // Only a terminal delimiter/EOF triggers text validation. Failed adoption
    // preserves every raw byte; success transfers that same backing/capacity.
    let text: core::result::Result<alloc::string::String,alloc::string::Error> = alloc::string::from_utf8_vec(record.bytes.borrow());
    if (text.is_err()) {
        return core::result::Err(BufferedReadFailure {
            cause: ReadError::Text(text.unwrap_err()), bytes: record.bytes,
            calls: record.calls, consumed: record.consumed,
            ending: core::option::Some(record.ending)
        });
    }
    return core::result::Ok(ReadLine {
        text: text.unwrap(), ending: record.ending, calls: record.calls, consumed: record.consumed
    });
}

pub struct Buffer { bytes: alloc::vec::Vec<u8>, maximum: i32 }

pub fn new() -> Buffer {
    let bytes: alloc::vec::Vec<u8> = alloc::vec::new();
    return Buffer { bytes: bytes, maximum: 2147483647 };
}

pub fn with_limit(maximum: i32) -> core::result::Result<Buffer, core::io::Error> {
    if (maximum < 0) { return core::result::Err(core::io::Error::InvalidInput); }
    let bytes: alloc::vec::Vec<u8> = alloc::vec::new();
    return core::result::Ok(Buffer { bytes: bytes, maximum: maximum });
}

pub impl Buffer {
    pub fn borrow(&self) -> &Buffer { return self; }
    pub fn len(&self) -> i32 { return self.bytes.len(); }
    pub fn capacity(&self) -> i32 { return self.bytes.capacity(); }
    pub fn limit(&self) -> i32 { return self.maximum; }
    pub fn as_bytes(&self) -> [u8] { return self.bytes.as_slice(); }

    pub fn try_reserve(&self, capacity: i32) -> core::result::Result<i32, core::io::Error> {
        if (capacity < 0) { return core::result::Err(core::io::Error::InvalidInput); }
        if (capacity > self.maximum) { return core::result::Err(core::io::Error::LimitExceeded); }
        if (capacity <= self.bytes.capacity()) { return core::result::Ok(self.bytes.capacity()); }
        if (core::result::is_err(self.bytes.try_reserve(capacity - self.bytes.len()))) { return core::result::Err(core::io::Error::AllocationFailed); }
        return core::result::Ok(self.bytes.capacity());
    }

    pub fn try_clone(&self) -> core::result::Result<Buffer, core::io::Error> {
        let cloned: core::result::Result<alloc::vec::Vec<u8>, alloc::vec::Error> = self.bytes.try_clone();
        if (core::result::is_err(cloned)) { return core::result::Err(core::io::Error::AllocationFailed); }
        let copy: alloc::vec::Vec<u8> = core::result::unwrap(cloned);
        return core::result::Ok(Buffer { bytes: copy, maximum: self.maximum });
    }

    pub fn clear(&self) { self.bytes.clear(); }

    pub fn destroy(&self) {
        self.bytes.destroy();
        self.bytes = alloc::vec::new();
    }
}

pub impl core::io::Write for Buffer {
    pub fn write(&self, source: [u8], offset: i32, count: i32) -> core::result::Result<i32, core::io::Error> {
        if (!core::io::valid_range(offset, count)) { return core::result::Err(core::io::Error::InvalidInput); }
        let length: i32 = self.bytes.len();
        if (count > self.maximum - length) { return core::result::Err(core::io::Error::LimitExceeded); }
        if (count == 0) { return core::result::Ok(0); }
        let needed: i32 = length + count;
        let capacity: i32 = self.bytes.capacity();
        let grown: alloc::vec::Vec<u8> = self.bytes;
        if (needed > capacity) {
            let target: i32 = self.maximum;
            if (capacity <= self.maximum / 2) { target = capacity * 2; }
            if (target < 4 && self.maximum >= 4) { target = 4; }
            if (target < needed) { target = needed; }
            let allocated: core::result::Result<alloc::vec::Vec<u8>, alloc::vec::Error> = alloc::vec::with_capacity(target);
            if (core::result::is_err(allocated)) { return core::result::Err(core::io::Error::AllocationFailed); }
            grown = core::result::unwrap(allocated);
            let old: [u8] = self.bytes.as_slice();
            let index: i32 = 0;
            while (index < length) { core::result::unwrap(grown.try_push(old[index])); index += 1; }
        }
        let index: i32 = 0;
        while (index < count) {
            core::result::unwrap(grown.try_push(source[offset + index]));
            index += 1;
        }
        // Keep aliased source views alive through the final byte copy.
        if (needed > capacity) { self.bytes.destroy(); }
        self.bytes = grown;
        return core::result::Ok(count);
    }

    pub fn flush(&self) -> core::result::Result<i32, core::io::Error> {
        return core::result::Ok(0);
    }
}
