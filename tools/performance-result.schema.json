{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lanius.invalid/schemas/performance-run-v1.json",
  "title": "Lanius performance run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run", "machine", "workload", "measurements"],
  "properties": {
    "schema": {"const": "lanius.performance-run.v1"},
    "run": {
      "type": "object",
      "required": ["id", "recorded_at", "git_commit", "git_dirty"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "recorded_at": {"type": "string", "format": "date-time"},
        "git_commit": {"type": "string"},
        "git_dirty": {"type": "boolean"}
      }
    },
    "machine": {"type": "object"},
    "workload": {
      "type": "object",
      "required": ["id", "kind", "classification", "generator"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["single_file", "typical_project"]},
        "classification": {"type": "string"},
        "generator": {"type": "string"}
      }
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/measurement"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["files", "bytes", "kilobytes", "megabytes", "physical_lines", "sloc", "sloc_policy"],
      "properties": {
        "files": {"type": "integer", "minimum": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "kilobytes": {"type": "number", "exclusiveMinimum": 0},
        "megabytes": {"type": "number", "exclusiveMinimum": 0},
        "physical_lines": {"type": "integer", "minimum": 1},
        "sloc": {"type": "integer", "minimum": 1},
        "sloc_policy": {"type": "string"}
      }
    },
    "sample": {
      "type": "object",
      "required": ["index", "wall_ms"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "wall_ms": {"type": "number", "minimum": 0},
        "compiler_ms": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "distribution": {
      "type": "object",
      "required": ["samples", "median", "mean", "mad", "minimum", "maximum", "p95", "histogram"],
      "properties": {
        "samples": {"type": "integer", "minimum": 1},
        "median": {"type": "number", "minimum": 0},
        "mean": {"type": "number", "minimum": 0},
        "mad": {"type": "number", "minimum": 0},
        "minimum": {"type": "number", "minimum": 0},
        "maximum": {"type": "number", "minimum": 0},
        "p95": {"type": "number", "minimum": 0},
        "histogram": {"type": "object"}
      }
    },
    "measurement": {
      "type": "object",
      "required": ["id", "compiler", "target", "configuration", "source", "commands", "measurement_semantics", "samples", "summary", "validation"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "compiler": {"type": "object", "required": ["name", "version"]},
        "target": {"type": "string"},
        "configuration": {"type": "string"},
        "source": {"$ref": "#/$defs/source"},
        "commands": {"type": "object"},
        "measurement_semantics": {"type": "object"},
        "samples": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sample"}},
        "summary": {
          "type": "object",
          "required": ["wall_ms", "compiler_ms", "median_bytes_per_second", "median_sloc_per_second"],
          "properties": {
            "wall_ms": {"$ref": "#/$defs/distribution"},
            "compiler_ms": {"anyOf": [{"$ref": "#/$defs/distribution"}, {"type": "null"}]},
            "median_bytes_per_second": {"type": "number", "minimum": 0},
            "median_sloc_per_second": {"type": "number", "minimum": 0}
          }
        },
        "profile": {"type": "object"},
        "validation": {"type": "object"}
      }
    }
  }
}
